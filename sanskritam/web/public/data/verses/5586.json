[{"id": 2214650, "chapter_id": 5586, "verse_number": "१", "content_sanskrit": "महाभारतमाख्यानं क्षितिं गां च सरस्वतीम् ।\nब्राह्मणान् केशवं चैव कीर्तयन्नावसीदति\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2214651, "chapter_id": 5586, "verse_number": "१", "content_sanskrit": "व्यासस्य कृपया लक्षालङ्काराख्यः कृतो मया ।\nग्रन्थोऽयं यः प्रभुः कीटमकरोत्पृथिवीपतिम्\t॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2214652, "chapter_id": 5586, "verse_number": "२", "content_sanskrit": "भारतस्य सुधाम्भोधेः भारतीशादयः सुराः ।\nयथावन्मथने शक्ताः कृतशिक्षा हरेर्मुखात्\t॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2214653, "chapter_id": 5586, "verse_number": "३", "content_sanskrit": "अहं तु मानुषः कुर्यां महाकार्ये कथं मतिम् ।\nअत्रास्ति कारणं किञ्चिद् गुह्यं तच्छ्रूयतां बुधैः\t॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2214654, "chapter_id": 5586, "verse_number": "४", "content_sanskrit": "प्रयागे ब्रह्मणः सन्ध्यामठे जपपरायणः ।\nअहमासं तदा लक्षालङ्कारं कुर्विति प्रभुः\t॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2214655, "chapter_id": 5586, "verse_number": "५", "content_sanskrit": "भारतस्य श्लोकलक्षस्यार्थविस्तरणात्मकम् ।\nकारयामास योगीन्द्रो लक्षालङ्कारमीदृशम्\t॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2214656, "chapter_id": 5586, "verse_number": "६", "content_sanskrit": "व्यास एव यतः कर्ता दासस्य हृदि मे स्थितः ।\nअतो न विस्मयः कार्यः किमकार्यं महाप्रभोः\t॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2214657, "chapter_id": 5586, "verse_number": "७", "content_sanskrit": "सद्वाक्यरत्नमालेयं तद् व्यासस्य गलेऽर्पिता ।\nसदा स्यात् स्वाङ्गकान्त्येमां स एव प्रथयेत्प्रभुः\t॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2214658, "chapter_id": 5586, "verse_number": "८", "content_sanskrit": "नमोऽस्तु वासुदेवाय व्यासदेवाय धीमते ।\nअसुदेवाय देवेभ्यो गुरुभ्यश्च नमो नमः\t॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2214659, "chapter_id": 5586, "verse_number": "९", "content_sanskrit": "श्रीदेव्यै भारतीदेव्यै गौरीदेव्यै नमो नमः ।\nनमः शच्यै च रत्यै च मातृभ्यश्च नमो नमः\t॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2214660, "chapter_id": 5586, "verse_number": "१०", "content_sanskrit": "अक्षरं यत्परिभ्रष्टं मात्राहीनं तु यद्भवेत् ।\nक्षन्तुमर्हन्ति विद्वांसः पिता पुत्रापराधवत् ॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2214661, "chapter_id": 5586, "verse_number": "", "content_sanskrit": "॥ भाविसमीरवादिराजतीर्थपूज्यचरणविरचितलक्षालङ्काराख्यटिप्पणी समाप्ता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2214662, "chapter_id": 5586, "verse_number": "२", "content_sanskrit": "वेदे रामायणे पुण्ये भारते भरतर्षभ ।\nआदौ चान्ते च मध्ये च हरिः सर्वत्र गीयते\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2214663, "chapter_id": 5586, "verse_number": "३", "content_sanskrit": "यत्र विष्णुकथा दिव्याः श्रुतयश्च सनातनाः ।\nतच्छ्रोतव्यं मनुष्येण परं पदमिहेच्छता\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2214664, "chapter_id": 5586, "verse_number": "४", "content_sanskrit": "एतत् पवित्रं परममेतद्धर्मनिदर्शनम् ।\nएतत्सर्वगुणोपेतं श्रोतव्यं भूतिमिच्छता\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2214665, "chapter_id": 5586, "verse_number": "५", "content_sanskrit": "अह्ना यदेनः कुरुते इन्द्रियैर्मनसाऽपि वा ।\nमहाभारतमाख्याय सर्वपापैः प्रमुच्यते\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2214666, "chapter_id": 5586, "verse_number": "६", "content_sanskrit": "यद्रात्रौ कुरुते पापं ब्राह्मणः स्त्रीगणैर्वृतः ।\nमहाभारतमाख्याय पूर्वां सन्ध्यां प्रमुच्यते\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2214667, "chapter_id": 5586, "verse_number": "७", "content_sanskrit": "महत्त्वाद् भारवत्त्वाच्च महाभारतमुच्यते ।\nनिरुक्तमस्य यो वेद सर्वपापैः प्रमुच्यते \t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2214668, "chapter_id": 5586, "verse_number": "८", "content_sanskrit": "अष्टादशपुराणानि धर्मशास्त्राणि सर्वशः ।\nवेदाः साङ्गास्तथैकत्र भारतं चैकतः स्थितम्\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2214669, "chapter_id": 5586, "verse_number": "९", "content_sanskrit": "श्रूयतां सिंहनादोऽयमृषेस्तस्य महात्मनः ।\nअष्टादशपुराणानां कर्तुर्वेदमहोदधेः\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2214670, "chapter_id": 5586, "verse_number": "१०", "content_sanskrit": "त्रिभिर्वर्षैर्महत्पुण्यं कृष्णद्वैपायनः प्रभुः ।\nअखिलं भारतं चेदं चकार भगवान् मुनिः\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2214671, "chapter_id": 5586, "verse_number": "११", "content_sanskrit": "आकर्ण्य भक्त्या सततं जयाख्यं भारतं महत् ।\nश्रीश्च कीर्तिस्तथा विद्या भवन्ति सहिताः सदा\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2214672, "chapter_id": 5586, "verse_number": "१२", "content_sanskrit": "यद्यदिष्टतमं कामं लभते श्रद्धयाऽन्वितः ।\nशृणुयान्मुदितो भूत्वा आस्तिको बुद्धिसंयुतः\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2214673, "chapter_id": 5586, "verse_number": "१३", "content_sanskrit": "वासुदेवं स्मरन् विद्वान् पुण्डरीकायतेक्षणम् ।\nइतिहासमिमं पुण्यं महार्थं वेदसम्मितम्\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2214674, "chapter_id": 5586, "verse_number": "१४", "content_sanskrit": "श्रावयेद्यस्तु वर्णादीन् कृत्वा ब्राह्मणमग्रतः ।\nसर्वपापविशुद्धात्मा शुचिस्तद्गतमानसः\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2214675, "chapter_id": 5586, "verse_number": "१५", "content_sanskrit": "इह कीर्तिं महत्प्राप्य भोगवान् सुखमश्नुते ।\nव्यासप्रसादेन पुनः स्वर्गलोकं स गच्छति\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2214676, "chapter_id": 5586, "verse_number": "१६", "content_sanskrit": "एतद् विदित्वा सर्वं तु सर्ववेदार्थविद् भवेत् ।\nपूजनीयश्च सततं माननीयो भवेद् द्विजः\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2214677, "chapter_id": 5586, "verse_number": "१७", "content_sanskrit": "कायिकं वाचिकं चैव मनसा समुपार्जितम् ।\nतत्सर्वं नाशमायाति तमः सूर्योदये यथा\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2214678, "chapter_id": 5586, "verse_number": "१८", "content_sanskrit": "अष्टादशपुराणानां श्रवणाद्यत् फलं भवेत् ।\nतत्फलं समवाप्नोति वैष्णवो नात्र संशयः\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2214679, "chapter_id": 5586, "verse_number": "१९", "content_sanskrit": "स्त्रियश्च पुरुषाश्चैव वैष्णवं पदमाप्नुयुः ।\nस्त्रीभिश्च पुत्रकामाभिः श्रोतव्यं वैष्णवं यशः\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2214680, "chapter_id": 5586, "verse_number": "२०", "content_sanskrit": "दक्षिणा चात्र देया वै निष्कपञ्चसुवर्णकम् ।\nवाचकाय यथाशक्त्या यथोक्तं फलमिच्छता\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2214681, "chapter_id": 5586, "verse_number": "२१", "content_sanskrit": "स्वर्णशङ्गीं च कपिलां सवत्सां वस्त्रसंयुताम् ।\nवाचकाय च दद्याद्धि आत्मनः श्रेय इच्छता\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2214682, "chapter_id": 5586, "verse_number": "२२", "content_sanskrit": "अलङ्कारं प्रदद्याच्च पाण्योर्वै भरतर्षभ ।\nकर्णस्याभरणं दद्याद्धनं चैव विशेषतः\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2214683, "chapter_id": 5586, "verse_number": "२३", "content_sanskrit": "भूमिदानं समादद्याद् वाचकाय नराधिप ।\nभूमिदानसमं दानं न भूतं भविष्यति\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2214684, "chapter_id": 5586, "verse_number": "२४", "content_sanskrit": "शृणोति श्रावयेद् वाऽपि सततं चैव यो नरः ।\nसर्वपापविनिर्मुक्तो वैष्णवं पदमाप्नुयात्\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2214685, "chapter_id": 5586, "verse_number": "२५", "content_sanskrit": "पितॄनुद्धरते सर्वानेकादशसमुद्भवान् ।\nआत्मानं ससुतं चैव स्त्रियं च भरतर्षभ\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2214686, "chapter_id": 5586, "verse_number": "२६", "content_sanskrit": "दशांशश्चैव होमोपि कर्तव्योत्र नराधिप ।\nइदं मया तवाग्रे च प्रोक्तं सर्वं नरर्षभ\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2214687, "chapter_id": 5586, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् स्वर्गारोहणपर्वणि\nषष्ठोऽध्यायः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2214688, "chapter_id": 5586, "verse_number": "", "content_sanskrit": "॥ समाप्तं स्वर्गारोहणपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2214689, "chapter_id": 5586, "verse_number": "", "content_sanskrit": "॥ समाप्तं महाभारतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2214690, "chapter_id": 5586, "verse_number": "", "content_sanskrit": "॥श्रीरजतपीठपुराधीशमध्वेशार्पणमस्तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]