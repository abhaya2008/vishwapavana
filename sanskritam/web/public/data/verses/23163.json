[{"id": 7003163000, "chapter_id": 23163, "verse_number": "४-९९-१", "content_sanskrit": "अथ नवनवतितमोऽध्यायः ।\nनारायण उवाच ।\nएतस्मिन्नन्तरे गर्गो वसुदेवाश्रमं ययौ ।\nदण्डी छत्री च जटिलो दीप्तश्च ब्रह्मतेजसा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003163001, "chapter_id": 23163, "verse_number": "४-९९-२", "content_sanskrit": "शुक्लयज्ञोपवीती च तपस्वी संयतः सदा ।\nशुक्लदन्तः शुक्लवासा यदोः कुलपुरोहितः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003163002, "chapter_id": 23163, "verse_number": "४-९९-३", "content_sanskrit": "तं दृष्ट्वा सहसोत्थाय देवकी प्रणनाम च ।\nवसुदेवश्च भक्त्या च रत्नसिहासनं ददौ ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003163003, "chapter_id": 23163, "verse_number": "४-९९-४", "content_sanskrit": "मधुपर्कं कामधेनुं वह्निशुद्धांशुकं तथा ।\nदत्त्वा गन्धं पुष्पमाल्यं पूजयामास भक्तितः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003163004, "chapter_id": 23163, "verse_number": "४-९९-५", "content_sanskrit": "मिष्टान्नं परमान्नं च पिण्टकं मधुरं मधु ।\nभोजयामास यत्नेन ताम्बूलं वासितं ददौ ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003163005, "chapter_id": 23163, "verse_number": "४-९९-६", "content_sanskrit": "प्रणम्य कृष्णं मनसा सबलं तं विलोक्य च ।\nउवाच वसुदेवं च देवकीं च पतिव्रताम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003163006, "chapter_id": 23163, "verse_number": "४-९९-७", "content_sanskrit": "गर्ग उवाच ।\nवसुदेव निबोधेनं सवलं पश्य पुत्रकम् ।\nउवनीतोचितं शुद्धं वयमा सांप्रतं वरम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003163007, "chapter_id": 23163, "verse_number": "४-९९-८", "content_sanskrit": "वसुदेव उवाच ।\nशुभक्षणं कुरु गृरो यदूनां पूज्यदैवत ।\nउपनीतोचितं शुद्धं प्रशंस्यं च सतामपि ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003163008, "chapter_id": 23163, "verse_number": "४-९९-९", "content_sanskrit": "गर्ग उवाच ।\nसर्वेम्यो बान्धवेम्योऽपि देह्यामन्त्रणपत्रिकाम् ।\nसंभारं कुरु यत्नेन वसुदेव वसुपम ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003163009, "chapter_id": 23163, "verse_number": "४-९९-१०", "content_sanskrit": "परश्वः सुभमेवास्ति चोपेनतुमिहार्हसि ।\nदिनं सतामपि मतं विशुद्धं चन्द्रतारयोः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003163010, "chapter_id": 23163, "verse_number": "४-९९-११", "content_sanskrit": "गर्गस्य वचनं श्रुत्वा वसुदेवो वसूपमः ।\nप्रस्थापयामास सर्वान्बन्धून्मङ्गलपत्रिकाम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003163011, "chapter_id": 23163, "verse_number": "४-९९-१२", "content_sanskrit": "घृतकुल्यां दुग्धकुल्यां दधिकुल्यां मनोहराम् ।\nमधुकुल्यां गुडकुल्यां प्रचकार समन्वितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003163012, "chapter_id": 23163, "verse_number": "४-९९-१३", "content_sanskrit": "राशिं नानोपहाराणां मणिरत्नं सुवर्णकम् ।\nनानालंकारवस्त्रं च मुक्तामाणिक्यहीरकम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003163013, "chapter_id": 23163, "verse_number": "४-९९-१४", "content_sanskrit": "श्रीकृष्णो देववर्गाश्च मुनीन्द्रसिद्धपुंगवान् ।\nसस्मार मनसा भक्त्या भक्ताश्च भक्तवत्सलः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003163014, "chapter_id": 23163, "verse_number": "४-९९-१५", "content_sanskrit": "शुभे दिने च संप्राप्ते ते च सर्वे समाययुः ।\nमुनीन्द्रा बान्धवा देवा राजानो बहुशस्तथा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003163015, "chapter_id": 23163, "verse_number": "४-९९-१६", "content_sanskrit": "देवकन्या नागकन्या राजकन्याश्च सर्वशः ।\nविद्याधर्यश्च गन्धर्वाश्चाऽऽययुर्वाद्यभाण्डकाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003163016, "chapter_id": 23163, "verse_number": "४-९९-१७", "content_sanskrit": "ब्राह्मणा भिक्षुका भट्टा यतयो ब्रह्मचारिणः ।\nसंन्यासिनश्चावधूता योगिनश्च समाययुः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003163017, "chapter_id": 23163, "verse_number": "४-९९-१८", "content_sanskrit": "स्त्रीबान्धवाः स्वबन्धूनां वर्गा मातामहस्य च ।\nबन्धूनां बान्धवाः सर्वे स्वाययुः शुभकर्मणि ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003163018, "chapter_id": 23163, "verse_number": "४-९९-१९", "content_sanskrit": "भीष्मो द्रोणश्च कर्णश्चाप्यश्वत्थामा कृपो द्विजः ।\nसुपुत्रो धृतराष्ट्रश्च सभार्यश्च समाययौ ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003163019, "chapter_id": 23163, "verse_number": "४-९९-२०", "content_sanskrit": "कुन्ती सपुत्रा विधवा हर्षशोकसमाप्लुता ।\nनानादेशोद्भवा योग्या राजानो राजपुत्रकाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003163020, "chapter_id": 23163, "verse_number": "४-९९-२१", "content_sanskrit": "अत्रिर्वसिष्ठश्च्यवनो भरद्वाजो महातपाः ।\nयाज्ञवल्क्यश्च भीमश्च गार्ग्यो गर्गो महातपाः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003163021, "chapter_id": 23163, "verse_number": "४-९९-२२", "content_sanskrit": "वत्सः सपुत्रश्च धर्मो जैगीषव्यः पराशरः ।\nपुलहश्च पुलस्त्यश्चाप्यगस्त्यश्वापि सौभरिः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003163022, "chapter_id": 23163, "verse_number": "४-९९-२३", "content_sanskrit": "सनकश्च सनन्दश्च तृतीयश्च मनातनः ।\nसनत्कुमारो भगवान्वोढुः पञ्चशिखस्तथा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003163023, "chapter_id": 23163, "verse_number": "४-९९-२४", "content_sanskrit": "तुर्वासाश्चाङ्गिरा व्यासो व्यासपुत्रः शुकस्तथा ।\nकुशिकः कौशिको राम ऋष्यशृङ्गो विभाण्डकः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003163024, "chapter_id": 23163, "verse_number": "४-९९-२५", "content_sanskrit": "शृङ्गी च वामदेवश्च गौतमश्च गुणार्णवः ।\nक्रतुर्यतिश्चाऽऽरुणिश्च शुक्राचार्यो बृहस्पतिः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003163025, "chapter_id": 23163, "verse_number": "४-९९-२६", "content_sanskrit": "अष्टावक्रो वामनश्च वाल्मीकिः पारिभद्रकः ।\nपैलो वैशंपायनश्च प्रचेताः पुरुजित्तथा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003163026, "chapter_id": 23163, "verse_number": "४-९९-२७", "content_sanskrit": "भृगुर्मरीचिर्मधुजित्कश्यपश्च प्रजापतिः ।\nअदितिर्देवमाता च दितिर्दैत्यप्रसूस्तथा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003163027, "chapter_id": 23163, "verse_number": "४-९९-२८", "content_sanskrit": "सुमन्तुश्च सुभानुश्च कण्वः कात्यायनस्तथा ।\nमार्कण्डेयो लोमशश्च कपिलश्च पराशरः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003163028, "chapter_id": 23163, "verse_number": "४-९९-२९", "content_sanskrit": "पाणिनिः पारियात्रश्च पारिभद्रश्च पुंगवः ।\nसंवर्तश्चाप्युतथ्यश्च नरोऽहं चापि नारद ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003163029, "chapter_id": 23163, "verse_number": "४-९९-३०", "content_sanskrit": "विश्वामित्रः शतानन्दो जाबालिस्तैतिलस्तथा ।\nसांदीपनिश्च ब्रह्मांशो योगिनां ज्ञानिनां गुरुः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003163030, "chapter_id": 23163, "verse_number": "४-९९-३१", "content_sanskrit": "उपमन्युर्गौरमुखो मैत्रेयश्च श्रुतश्रवाः ।\nकठः कचश्च करखो भरद्वाजश्च धर्मवित् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003163031, "chapter_id": 23163, "verse_number": "४-९९-३२", "content_sanskrit": "सशिष्या मुनयः सर्वे वसुदेवाश्रमं ययुः ।\nवसुदेवश्च तान्दृष्ट्वा ववन्दे दण्डवद्भुवि ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003163032, "chapter_id": 23163, "verse_number": "४-९९-३३", "content_sanskrit": "अथास्मिन्नन्तरे ब्रह्मा सस्मितो हंसवाहनः ।\nरत्ननिर्माणयानेन पार्वत्या सह शंकरः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003163033, "chapter_id": 23163, "verse_number": "४-९९-३४", "content_sanskrit": "नन्दी स्वयं महाकालो वीरभद्रः सुभद्रकः ।\nमणिभद्रः पारिभद्रः कार्तिकेयो गणेश्वरः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003163034, "chapter_id": 23163, "verse_number": "४-९९-३५", "content_sanskrit": "गजेन्द्रेण महेन्द्रश्च धर्मश्चन्द्रो रविस्तथा ।\nकुबेरो वरुणश्चैव पवनो वह्निरेव च ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003163035, "chapter_id": 23163, "verse_number": "४-९९-३६", "content_sanskrit": "यमः संयमिनीनाथो जयन्तो नलकूबरः ।\nसर्वे ग्रहाश्च वसवो रुद्राश्च सगणस्तथा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003163036, "chapter_id": 23163, "verse_number": "४-९९-३७", "content_sanskrit": "आदित्याश्च तथा शेणो नानादेवाः समाययुः ।\nवसुदेवश्च भक्त्या च ववन्दे शिरसा भुवि ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003163037, "chapter_id": 23163, "verse_number": "४-९९-३८", "content_sanskrit": "तुष्टाव परया भक्त्या देवेन्द्रांश्च तथा सुरान् ।\nभक्तिन म्रात्ममूर्धा च पुलकाञ्चितविग्रहः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003163038, "chapter_id": 23163, "verse_number": "४-९९-३९", "content_sanskrit": "वसुदेव उवाच ।\nपरं ब्रह्म परं धाम परमेशः परात्परः ।\nस्वयं विधाता मद्गेहे जगतां परिपालकः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003163039, "chapter_id": 23163, "verse_number": "४-९९-४०", "content_sanskrit": "वेदानां जनकः स्रष्टा सृष्टिहेतुः सनातनः ।\nसुराणां च मुनीन्द्राणां सिद्धेन्द्राणां गुरोर्गुरुः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003163040, "chapter_id": 23163, "verse_number": "४-९९-४१", "content_sanskrit": "स्वप्ने यत्पादपद्मं च क्षणं द्रष्टुं सुदुर्लभम् ।\nशिवस्मरणमोत्रेण सर्वानिष्टाः पलायिताः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003163041, "chapter_id": 23163, "verse_number": "४-९९-४२", "content_sanskrit": "सर्वसंकटमुत्तीर्य कल्याणं लभते नरः ।\nसर्वाग्रे पूजनं यस्य देवानामग्रणीः परः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003163042, "chapter_id": 23163, "verse_number": "४-९९-४३", "content_sanskrit": "घटेषु मङ्गलं मन्त्रैर्भक्त्या चाऽऽवाहनेन च ।\nस्वयं गणेशो भगवान् साक्षाद्विघ्नविनाशकः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003163043, "chapter_id": 23163, "verse_number": "४-९९-४४", "content_sanskrit": "कार्तिकेयश्च भगवान्देवादीनां च पूजितः ।\nदेवानां प्रवरा पूज्या महालक्ष्मीः परात्परा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003163044, "chapter_id": 23163, "verse_number": "४-९९-४५", "content_sanskrit": "मद्गेहे पार्वती माता जगतामादिरूपिणी ।\nसर्वशक्तिस्वरूपा च मूलप्रकृतिरीश्वरी ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003163045, "chapter_id": 23163, "verse_number": "४-९९-४६", "content_sanskrit": "परापराणां परमा परब्रह्मस्वरूपिणी ।\nयस्याः पादौ समाराध्य वाञ्छितं लभते नरः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003163046, "chapter_id": 23163, "verse_number": "४-९९-४७", "content_sanskrit": "शरत्कारे च भक्त्या च सा साक्षान्मम मन्दिरे ।\nसर्वदेवैश्च सहिता सगणा भक्तवात्सला ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003163047, "chapter_id": 23163, "verse_number": "४-९९-४८", "content_sanskrit": "कृपामयी च कृपया चाऽऽविर्भूता च भारते ।\nधन्योऽहं कृतकृत्योऽहं सफलं जीवनं मम ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003163048, "chapter_id": 23163, "verse_number": "४-९९-४९", "content_sanskrit": "आगताऽसि यतो दुर्गे परमाद्या च मद्गृहे ।\nएवं सर्वांश्च तुष्टाव क्रमेण च परस्परम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003163049, "chapter_id": 23163, "verse_number": "४-९९-५०", "content_sanskrit": "सर्वान्मुनीन्द्रान्विप्रांश्च गले बद्ध्वांऽशुकं मुदा ।\nप्रत्येकं वासयामास रत्नसिहासने वरे ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003163050, "chapter_id": 23163, "verse_number": "४-९९-५१", "content_sanskrit": "पूजयामास विधिवत्क्रमेण च पृथक्पृथक् ।\nप्रत्येकं वरयामास ब्रह्मादींश्च सुरानपि ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003163051, "chapter_id": 23163, "verse_number": "४-९९-५२", "content_sanskrit": "मुनिवर्गान्ब्राह्मणांश्च भक्त्या गर्गं पुरोहितम् ।\nरत्नैः प्रवालैर्मणिभिर्मुवतामाणिक्यहीरकैः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003163052, "chapter_id": 23163, "verse_number": "४-९९-५३", "content_sanskrit": "भूषणैर्वसनैश्चैव माल्यैश्च गन्धचन्दनैः ।\nलत्नसिहासने रम्ये सर्वेषां मध्यदेशतः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003163053, "chapter_id": 23163, "verse_number": "४-९९-५४", "content_sanskrit": "गणेशं वासयामास पूजार्थं शुभकर्मणि ।\nसप्ततीर्थोदकेनैव सुवर्णकलशेन च ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003163054, "chapter_id": 23163, "verse_number": "४-९९-५५", "content_sanskrit": "पुष्पजन्द्रनयुक्तेन शीतेन वासितेन च ।\nस्वर्गगङ्गाजलेनैव पुष्करोदकुण्यतः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003163055, "chapter_id": 23163, "verse_number": "४-९९-५६", "content_sanskrit": "पञ्चामृतेन शुद्धेन पञ्चगव्येन भक्तितः ।\nहेरम्बं स्नापयामास समुद्रोदेन मन्त्रतः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003163056, "chapter_id": 23163, "verse_number": "४-९९-५७", "content_sanskrit": "वरयामास माल्येन पारिजातस्य नारद ।\nरत्नेन्द्रभूषणेनैव वह्निशुद्धेन वाससा ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003163057, "chapter_id": 23163, "verse_number": "४-९९-५८", "content_sanskrit": "गन्धयन्दनपुष्पैश्च रत्नमाल्याङ्गुलीयकम् ।\nतुष्टाव पार्वतीपुत्रं सर्वदेवाधिपं शुभम् ।\nविघ्ननिघ्नकरं शान्तं भगवन्तं सनातनम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]