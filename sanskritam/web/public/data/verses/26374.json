[{"id": 7006374000, "chapter_id": 26374, "verse_number": "२-३०-१", "content_sanskrit": "वैशम्पायन उवाच\nप्रविशन्तं तु वेगेन मारुतावल्गिताम्बरम् ।\nपूर्वजं पुरतः कृत्वा कृष्णं कमललोचनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006374001, "chapter_id": 26374, "verse_number": "२-३०-२", "content_sanskrit": "गजदन्तकृतोल्लेखं सुभुजं देवकीसुतम् ।\nलीलाकृताङ्गदं वीरं मदेन रुधिरेण च ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006374002, "chapter_id": 26374, "verse_number": "२-३०-३", "content_sanskrit": "वल्गमानं यथा सिंहं व्यूहमानं यथा घनम् ।\nबहुशब्दप्रहारेण चालयन्तं वसुंधराम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006374003, "chapter_id": 26374, "verse_number": "२-३०-४", "content_sanskrit": "औग्रसेनिः समालोक्य दन्तिदन्तोद्यतायुधम् ।\nकृष्णं भृशायस्तमुखः सरोषं समुदैक्षत ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006374004, "chapter_id": 26374, "verse_number": "२-३०-५", "content_sanskrit": "भुजासक्तेन शुशुभे गजदन्तेन केशवः ।\nचन्द्रार्धबिम्बसंसक्तो यथैकशिखरो गिरिः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006374005, "chapter_id": 26374, "verse_number": "२-३०-६", "content_sanskrit": "वल्गमाने तु गोविन्दे स कृत्स्नो रङ्गसागरः ।\nजनौघप्रतिनादेन पूर्यमाण इवाबभौ ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006374006, "chapter_id": 26374, "verse_number": "२-३०-७", "content_sanskrit": "ततः क्रोधाभिताम्राक्षः कंसः परमकोपनः ।\nचाणूरमादिशद् युद्धे कृष्णस्य सुमहाबलम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006374007, "chapter_id": 26374, "verse_number": "२-३०-८", "content_sanskrit": "अन्ध्रं मल्लं च निकृतिं मुष्टिकं च महाबलम् ।\nबलदेवाय सक्रोधो दिदेशाद्रिचयोपमम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006374008, "chapter_id": 26374, "verse_number": "२-३०-९", "content_sanskrit": "कंसेनापि समाज्ञप्तश्चाणूरः पूर्वमेव तु ।\nयोद्धव्यं सह कृष्णेन त्वया यत्नवतेति वै ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006374009, "chapter_id": 26374, "verse_number": "२-३०-१०", "content_sanskrit": "स रोषेण तु चाणूरः कषायीकृतलोचनः ।\nअभ्यावर्तत युद्धार्थमपां पूर्णो यथा घनः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006374010, "chapter_id": 26374, "verse_number": "२-३०-११", "content_sanskrit": "अवघुष्टे समाजे, तु निश्शब्दस्तिमिते जने ।\nयादवाः सहितास्तत्र इदं वचनमब्रुवन् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006374011, "chapter_id": 26374, "verse_number": "२-३०-१२", "content_sanskrit": "बाहुयुद्धमिदं रंगे सप्राश्निकमकातरम् ।\nक्रियाबलसमाज्ञातमशस्त्रं निर्मितं पुरा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006374012, "chapter_id": 26374, "verse_number": "२-३०-१३", "content_sanskrit": "अद्भिश्चातिश्रमो नित्यं विनेयः कालदर्शिभिः ।\nकरीषेण च मल्लस्य सततं सत्क्रिया स्मृता ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006374013, "chapter_id": 26374, "verse_number": "२-३०-१४", "content_sanskrit": "स्थितो भूमिगतेनैव यो यथा मार्गतः स्थितः ।\nसंयुज्यतश्च पर्यायः प्राश्निकैः समुदाहृतः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006374014, "chapter_id": 26374, "verse_number": "२-३०-१५", "content_sanskrit": "बालो वा यदि वा वृद्धो मध्यो वापि कृशोऽपि वा ।\nबलस्थो वा स्थितो रंगे ज्ञेयः कक्षान्तरेण वै ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006374015, "chapter_id": 26374, "verse_number": "२-३०-१६", "content_sanskrit": "बलतश्च क्रियाश्च बाहुयुद्धविधिर्युधि ।\nनिपातानन्तरं किंचिन्न कर्तव्यं विजानता ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006374016, "chapter_id": 26374, "verse_number": "२-३०-१७", "content_sanskrit": "तदिदं प्रस्तुतं रंगे युद्धं कृष्णान्ध्रमल्लयोः ।\nबालः कृष्णो महानन्ध्रः कथं न स्याद् विचारणा॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006374017, "chapter_id": 26374, "verse_number": "२-३०-१८", "content_sanskrit": "ततः किलकिलाशब्दः समाजे समवर्तत ।\nप्रावल्गत च गोविन्दो वाक्यं चेदमुवाच ह ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006374018, "chapter_id": 26374, "verse_number": "२-३०-१९", "content_sanskrit": "अहं बालो महानन्ध्रो वपुषा पर्वतोपमः ।\nयुद्धं ममानेन सह रोचते बाहुशालिना ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006374019, "chapter_id": 26374, "verse_number": "२-३०-२०", "content_sanskrit": "युद्धव्यतिक्रमः कश्चिन्न भविष्यति मत्कृतः ।\nन ह्यहं बाहुयोधानां दूषयिष्यामि यन्मतम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006374020, "chapter_id": 26374, "verse_number": "२-३०-२१", "content_sanskrit": "योऽयं करीषधर्मश्च तोयधर्मश्च रंगजः ।\nकषायस्य च संसर्गः समयो ह्येष कल्पितः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006374021, "chapter_id": 26374, "verse_number": "२-३०-२२", "content_sanskrit": "संयमः स्थिरता शौर्यं व्यायामः सत्क्रिया बलम् ।\nरंगे च नियता सिद्धिरेतद् युद्धविदां मतम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006374022, "chapter_id": 26374, "verse_number": "२-३०-२३", "content_sanskrit": "अवैरमेवं यदयं सवैरं कर्तुमुद्यतः ।\nअत्र वै निग्रहः कार्यस्तोषयिष्याम्यहं जगत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006374023, "chapter_id": 26374, "verse_number": "२-३०-२४", "content_sanskrit": "करूषेषु प्रसूतोऽयं चाणूरो नाम नामतः ।\nबाहुयोधी शरीरेण कर्मभिश्चात्र चिन्त्यताम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006374024, "chapter_id": 26374, "verse_number": "२-३०-२५", "content_sanskrit": "एतेन बहवो मल्ला निपातानन्तरं हताः ।\nरङ्गप्रतापकामेन मल्लमार्गश्च दूषितः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006374025, "chapter_id": 26374, "verse_number": "२-३०-२६", "content_sanskrit": "शस्त्रसिद्धिस्तु योधानां संग्रामे शस्त्रयोधिनाम् ।\nरङ्गसिद्धिस्तु मल्लानां प्रतिमल्लनिपातजा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006374026, "chapter_id": 26374, "verse_number": "२-३०-२७", "content_sanskrit": "रणे वि जयमानस्य कीर्तिर्भवति शाश्वती ।\nहतस्यापि रणे शस्त्रैर्नाकपृष्ठं विधीयते ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006374027, "chapter_id": 26374, "verse_number": "२-३०-२८", "content_sanskrit": "रणे उभयतः सिद्धिर्हतस्येह घ्नतोऽपि वा ।\nसा हि प्राणान्तिकीयात्रा महद्भिः साधुपूजिता ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006374028, "chapter_id": 26374, "verse_number": "२-३०-२९", "content_sanskrit": "अयं तु मार्गो बलतः क्रियातश्च विनिःसृतः ।\nमृतस्य रङ्गे क्व स्वर्गो जयते वा कुतो रतिः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006374029, "chapter_id": 26374, "verse_number": "२-३०-३०", "content_sanskrit": "ये तु केचित्  स्वदोषेण राज्ञः पण्डितमानिनः ।\nप्रतापार्थे हता मल्ला मल्लहन्तुर्वधो हि सः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006374030, "chapter_id": 26374, "verse_number": "२-३०-३१", "content_sanskrit": "एवं संजल्पतस्तस्य ताभ्यां युद्धं सुदारुणम् ।\nउभाभ्यामभवद् घोरं वारणाभ्यां यथा वने ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006374031, "chapter_id": 26374, "verse_number": "२-३०-३२", "content_sanskrit": "कृतप्रतिकृतैश्चित्रैर्बाहुभिश्च सकण्टकैः ।\nसन्निपातावधूतैश्च प्रमाथोन्मथनैस्तथा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006374032, "chapter_id": 26374, "verse_number": "२-३०-३३", "content_sanskrit": "तावुभावपि संश्लिष्टौ यथा शैलमयौ तथा ।\nक्षेपणैर्मुष्टिभिश्चैव वराहोद्धूतनिःस्वनैः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006374033, "chapter_id": 26374, "verse_number": "२-३०-३४", "content_sanskrit": "कीलैर्वज्रनिपातैश्च प्रसृष्टाभिस्तथैव च ।\nशलाकानखपातैश्च पादोद्धूतैश्च दारुणैः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006374034, "chapter_id": 26374, "verse_number": "२-३०-३५", "content_sanskrit": "जानुभिश्चाश्मनिर्घोषैः शिरोभ्यां चावघट्टितैः ।\nतद् युद्धमभवद् घोरमशस्त्रं बाहुतेजसा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006374035, "chapter_id": 26374, "verse_number": "२-३०-३६", "content_sanskrit": "बलप्राणेन शूराणां समाजोत्सवसंनिधौ ।\nअरज्यत जनः सर्वः सोत्कृष्टनिनदोत्थितः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006374036, "chapter_id": 26374, "verse_number": "२-३०-३७", "content_sanskrit": "साधुवादांश्च मञ्चेषु घोषयन्त्यपरे जनाः ।\nततः प्रस्विन्नवदनः कृष्णप्रणिहितेक्षणः ।\nन्यवारयत तूर्याणि कंसः सव्येन पाणिना ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006374037, "chapter_id": 26374, "verse_number": "२-३०-३८", "content_sanskrit": "प्रतिषिद्धेषु तूर्येषु मृदङ्गादिषु तेषु वै ।\nखे संगतान्यवाद्यन्त देवतूर्याण्यनेकशः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006374038, "chapter_id": 26374, "verse_number": "२-३०-३९", "content_sanskrit": "युद्ध्यमाने हृषीकेशे पुण्डरीकनिभेक्षणे ।\nस्वयमेव प्रवाद्यन्त तूर्यघोषास्तु सर्वशः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006374039, "chapter_id": 26374, "verse_number": "२-३०-४०", "content_sanskrit": "अन्तर्धानगता देवा विमानैः कामरूपिभिः ।\nचेरुर्विद्याधरैः सार्द्धं कृष्णस्य जयकाङ्क्षिणः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006374040, "chapter_id": 26374, "verse_number": "२-३०-४१", "content_sanskrit": "जयस्व कृष्ण चाणूरं दानवं मल्लरूपिणम् ।\nइति सप्तर्षयः सर्वे ऊचुश्चैव नभोगताः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006374041, "chapter_id": 26374, "verse_number": "२-३०-४२", "content_sanskrit": "चाणूरेण चिरं कालं क्रीडित्वा देवकीसुतः ।\nबलमाहारयामास कंसस्याभावदर्शिवान् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006374042, "chapter_id": 26374, "verse_number": "२-३०-४३", "content_sanskrit": "ततश्चचाल वसुधा मञ्चाश्चैव जुघूर्णिरे ।\nमुकुटाच्चापि कंसस्य पपात मणिरुत्तमः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006374043, "chapter_id": 26374, "verse_number": "२-३०-४४", "content_sanskrit": "दोर्भ्यामानम्य कृष्णस्तु चाणूरं शीर्णजीवितम् ।\nप्राहरन्मुष्टिना मूर्ध्नि वक्षस्याहत्य जानुना ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006374044, "chapter_id": 26374, "verse_number": "२-३०-४५", "content_sanskrit": "निःसृते साश्रुरुधिरे तस्य नेत्रे सबन्धने ।\nतापनीये यथा घण्टे कक्षोपरि विलम्बिते ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006374045, "chapter_id": 26374, "verse_number": "२-३०-४६", "content_sanskrit": "पपात स तु रङ्गस्य मध्ये निःसृतलोचनः ।\nचाणूरो विगतप्राणो जीवितान्ते महीतले ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006374046, "chapter_id": 26374, "verse_number": "२-३०-४७", "content_sanskrit": "देहेन तस्य मल्लस्य चाणूरस्य गतायुषः ।\nसंनिरुद्धो महारङ्गः स शैलेनेव लक्ष्यते ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006374047, "chapter_id": 26374, "verse_number": "२-३०-४८", "content_sanskrit": "रौहिणेयो हते तस्मिंश्चाणूरे बलदर्पिते ।\nजग्राह मुष्टिकं रंगे कृष्णस्तोशलकं पुनः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006374048, "chapter_id": 26374, "verse_number": "२-३०-४९", "content_sanskrit": "सन्निपाते तु तौ मल्लौ प्रथमे क्रोधमूर्च्छितौ ।\nसमेयातां रामकृष्णौ कालस्य वशवर्तिनौ ।\nनिर्घातावनतौ भूत्वा रङ्गमध्ये ववल्गतुः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006374049, "chapter_id": 26374, "verse_number": "२-३०-५०", "content_sanskrit": "कृष्णस्तोशलमुद्यम्य गिरिशृङ्गोपमं बली ।\nभ्रामयित्वा शतगुणं निष्पिपेष महीतले ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006374050, "chapter_id": 26374, "verse_number": "२-३०-५१", "content_sanskrit": "तस्य कृष्णाभिपन्नस्य पीडितस्य बलीयसः ।\nमुखाद् रुधिरमत्यर्थमुज्जगाम मुमूर्षतः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006374051, "chapter_id": 26374, "verse_number": "२-३०-५२", "content_sanskrit": "संकर्षणस्तु सुचिरं योधयित्वा महाबलः ।\nअन्ध्रमल्लं महामल्लो मण्डलानि व्यदर्शयत् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006374052, "chapter_id": 26374, "verse_number": "२-३०-५३", "content_sanskrit": "मुष्टिनैकेन तेजस्वी साशनिस्तनयित्नुना ।\nशिरस्यभ्यहनद् वीरो वज्रेणेव महागिरिम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006374053, "chapter_id": 26374, "verse_number": "२-३०-५४", "content_sanskrit": "स निष्पतितमस्तिष्को विस्रस्तनयनो भुवि ।\nपपात निहतस्तेन ततो नादो महानभूत् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006374054, "chapter_id": 26374, "verse_number": "२-३०-५५", "content_sanskrit": "अन्ध्रतोशलकौ हत्वा कृष्णसंकर्षणावुभौ ।\nक्रोधसंरक्तनयनौ   रंगमध्ये ववल्गतुः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006374055, "chapter_id": 26374, "verse_number": "२-३०-५६", "content_sanskrit": "समाजवाटो निर्मल्लः सोऽभवद् भीमदर्शनः ।\nअन्ध्रे तदा महामल्ले मुष्टिके च निपातिते ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006374056, "chapter_id": 26374, "verse_number": "२-३०-५७", "content_sanskrit": "ये च सम्प्रेक्षका गोपा नन्दगोपपुरोगमाः ।\nभयक्षोभितसर्वाङ्गाः सर्वे तत्रावतस्थिरे ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006374057, "chapter_id": 26374, "verse_number": "२-३०-५८", "content_sanskrit": "हर्षजं वारि नेत्राभ्यां वर्षमाणा प्रवेपती ।\nप्रस्रवोत्पीडिता कृष्णं देवकी समुदैक्षत ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006374058, "chapter_id": 26374, "verse_number": "२-३०-५९", "content_sanskrit": "कृष्णदर्शनजातेन बाष्पेणाकुलितेक्षणः ।\nवसुदेवो जरां त्यक्त्वा स्नेहेन तरुणायते ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006374059, "chapter_id": 26374, "verse_number": "२-३०-६०", "content_sanskrit": "वारमुख्याश्च ताः सर्वाः कृष्णस्य मुखपङ्कजम् ।\nपपुर्हि नेत्रभ्रमरैर्निमेषान्तरगामिभिः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006374060, "chapter_id": 26374, "verse_number": "२-३०-६१", "content_sanskrit": "कंसस्याथ मुखे स्वेदो भ्रूभेदान्तरगोचरः ।\nअभवद् रोषनिर्यासः कृष्णसंदर्शनेरितः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006374061, "chapter_id": 26374, "verse_number": "२-३०-६२", "content_sanskrit": "केशवाय सधूमेन रोषनिश्वासवायुना ।\nदीप्तमन्तर्गतं तस्य हृदयं मानसाग्निना ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006374062, "chapter_id": 26374, "verse_number": "२-३०-६३", "content_sanskrit": "तस्य प्रस्फुरितौष्ठस्य स्विन्नालिकतलस्य वै ।\nकंसवक्त्रस्य रोषेण रक्तसूर्यायते वपुः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006374063, "chapter_id": 26374, "verse_number": "२-३०-६४", "content_sanskrit": "क्रोधरक्तान्मुखात्तस्य निःसृताः स्वेदबिन्दवः ।\nयथा रविकरस्पृष्टा वृक्षावश्यायबिन्दवः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006374064, "chapter_id": 26374, "verse_number": "२-३०-६५", "content_sanskrit": "सोऽज्ञापयत संक्रुद्धः पुरुषान्व्यायतान्बहून् ।\nगोपावेतौ समाजौघान्निष्क्राम्येतां वनेचरौ ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006374065, "chapter_id": 26374, "verse_number": "२-३०-६६", "content_sanskrit": "न चैतौ द्रष्टुमिच्छामि विकृतौ पापदर्शनौ ।\nगोपानामपि मे राज्ये न कश्चित्स्थातुमर्हति ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006374066, "chapter_id": 26374, "verse_number": "२-३०-६७", "content_sanskrit": "नन्दगोपश्च दुर्मेधाः पापेष्वभिरतो मम ।\nआयसैर्निगडाकारैर्लोहपाशैनिगृह्यताम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006374067, "chapter_id": 26374, "verse_number": "२-३०-६८", "content_sanskrit": "वसुदेवश्च दुर्वृत्तो नित्यं द्वेषकरो मम ।\nअवृद्धार्हेण दण्डेन क्षिप्रमद्यैव शास्यताम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006374068, "chapter_id": 26374, "verse_number": "२-३०-६९", "content_sanskrit": "ये चेमे प्राकृता गोपा दामोदरपरायणाः ।\nह्रियन्तां गाव एतेषां यच्चास्ति वसु किंचन ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006374069, "chapter_id": 26374, "verse_number": "२-३०-७०", "content_sanskrit": "एवमाज्ञापयानं तं कंसं परुषभाषिणम् ।\nददर्शायस्तनयनः कृष्णः सत्यपराक्रमः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006374070, "chapter_id": 26374, "verse_number": "२-३०-७१", "content_sanskrit": "क्षिप्ते पितरि चुक्रोध नन्दगोपे च केशवः ।\nज्ञातीनां च व्यथां दृष्ट्वा विसंज्ञां चैव देवकीम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006374071, "chapter_id": 26374, "verse_number": "२-३०-७२", "content_sanskrit": "स सिंह इव वेगेन केशवो जातविक्रमः ।\nआरुरुक्षुर्महाबाहुः कंसनाशार्थमच्पुतः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006374072, "chapter_id": 26374, "verse_number": "२-३०-७३", "content_sanskrit": "रङ्गमध्यादुत्पपात कृष्णः कंसासनान्तिकम् ।\nअसज्जद्वायुनाऽऽक्षिप्तो यथा खस्थो घनाघनः॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006374073, "chapter_id": 26374, "verse_number": "२-३०-७४", "content_sanskrit": "ददृशुर्न हि तं सर्वे रङ्गमध्यादवप्लुतम् ।\nकेवलं कंसपार्श्वस्थं ददृशुः पुरवासिनः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006374074, "chapter_id": 26374, "verse_number": "२-३०-७५", "content_sanskrit": "सोऽपि कंसस्तथाऽऽयस्तः परीतः कालधर्मणा ।\nआकाशादिव गोविन्दं मेने तत्रागतं प्रभुम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006374075, "chapter_id": 26374, "verse_number": "२-३०-७६", "content_sanskrit": "स कृष्णेनायतं कृत्वा बाहुं परिघसंनिभम् ।\nमूर्धजेषु परामृष्टः कंसो वै रङ्गसंसदि ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006374076, "chapter_id": 26374, "verse_number": "२-३०-७७", "content_sanskrit": "मुकुटश्चापतत् तस्य काञ्चनो वज्रभूषितः ।\nशिरसस्तस्य कृष्णेन परामृष्टस्य पाणिना ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006374077, "chapter_id": 26374, "verse_number": "२-३०-७८", "content_sanskrit": "स ग्रहग्रस्तकेशश्च कंसो निर्यत्नतां गतः ।\nतथैव च विसम्मूढो वैकल्यं समपद्यत ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006374078, "chapter_id": 26374, "verse_number": "२-३०-७९", "content_sanskrit": "निगृहीतश्च केशेषु गतासुरिव निःश्वसन् ।\nन शशाक मुखं द्रष्टुं कंसः कृष्णस्य वै तदा ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006374079, "chapter_id": 26374, "verse_number": "२-३०-८०", "content_sanskrit": "विकुण्डलाभ्यां कर्णाभ्यां  छिन्नहारेण वक्षसा ।\nप्रलम्बाभ्यां च बाहुभ्यां गात्रैविसृतभूषणैः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006374080, "chapter_id": 26374, "verse_number": "२-३०-८१", "content_sanskrit": "भ्रंशितेनोत्तरीयेण सहसावलिताननः ।\nचेष्टमानः समाक्षिप्तः कंसः कार्ष्णेन तेजसा ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006374081, "chapter_id": 26374, "verse_number": "२-३०-८२", "content_sanskrit": "चकर्ष च महारङ्गे मञ्चान्निष्क्रम्य केशवः ।\nकेशेषु तं बलाद् गृह्य कंसं क्लेशार्हतां गतम ॥ ८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006374082, "chapter_id": 26374, "verse_number": "२-३०-८३", "content_sanskrit": "कृष्यमाणः स कृष्णेन भोजराजो महाद्युतिः ।\nसमाजवाटे परिखां देहकृष्टां चकार ह ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006374083, "chapter_id": 26374, "verse_number": "२-३०-८४", "content_sanskrit": "समाजवाटे क्रीडित्वा विकृष्य च गतायुषम् ।\nकृष्णो विसर्जयामास कंसदेहमदूरतः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006374084, "chapter_id": 26374, "verse_number": "२-३०-८५", "content_sanskrit": "धरण्यां मृदितः शिश्ये तव देहः सुखोचितः ।\nक्रमेण विपरीतेन पांसुभिः परुषीकृतः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006374085, "chapter_id": 26374, "verse_number": "२-३०-८६", "content_sanskrit": "तस्य तद् वदनं श्यामं सुप्ताक्षं मुकुटं विना ।\nन विभाति विपर्यस्तं विपलाशं यथाम्बुजम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006374086, "chapter_id": 26374, "verse_number": "२-३०-८७", "content_sanskrit": "असंग्रामहतः कंसः स बाणैरपरिक्षतः ।\nकेशग्राहान्निरस्तासुर्वीरमार्गान्निराकृतः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006374087, "chapter_id": 26374, "verse_number": "२-३०-८८", "content_sanskrit": "तस्य देहे प्रकाशन्ते सहसा केशवार्पिताः ।\nमांसच्छेदघनाः सर्वे नखाग्रा जीवितच्छिदः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006374088, "chapter_id": 26374, "verse_number": "२-३०-८९", "content_sanskrit": "तं हत्वा पुण्डरीकाक्षः प्रहर्षाद् द्विगुणप्रभः ।\nववन्दे वसुदेवस्य पादौ  निहतकण्टकः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7006374089, "chapter_id": 26374, "verse_number": "२-३०-९०", "content_sanskrit": "मातुश्च शिरसा पादौ निपीड्य यदुनन्दनः ।\nसासिञ्चत् प्रस्रवोत्पीडैः कृष्णमानन्दनिःसृतैः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7006374090, "chapter_id": 26374, "verse_number": "२-३०-९१", "content_sanskrit": "यादवांश्चैव तान् सर्वान् यथास्थानं यथावयः ।\nपप्रच्छ कुशलं कृष्णो दीप्यमानः स्वतेजसा ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7006374091, "chapter_id": 26374, "verse_number": "२-३०-९२", "content_sanskrit": "बलदेवोऽपि धर्मात्मा कंसभ्रातरमूर्जितम् ।\nबाहुभ्यामेव तरसा सुनामानमपोथयत् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7006374092, "chapter_id": 26374, "verse_number": "२-३०-९३", "content_sanskrit": "तौ जितारी जितक्रोधौ चिरविप्रोषितौ व्रजे ।\nस्थपितुर्भवनं वीरौ जग्मतुर्हृष्टमानसौ ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}]