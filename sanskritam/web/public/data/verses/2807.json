[{"id": 2084997, "chapter_id": 2807, "verse_number": "१२-३१२-०x", "content_sanskrit": "वसिष्ठ उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2084998, "chapter_id": 2807, "verse_number": "१२-३१२-१", "content_sanskrit": "साङ्ख्यदर्शनमेतावदुक्तं ते नृपसत्तम्।\nविद्याविद्ये त्विदानीं मे त्वं निबोधानुपूर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2084999, "chapter_id": 2807, "verse_number": "१२-३१२-२", "content_sanskrit": "अविद्यामाहुरव्यक्तं सर्गप्रलयधर्मिणीम्।\nसर्गप्रलयनिर्मुक्तो विद्यो वै पञ्चविंशकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2085000, "chapter_id": 2807, "verse_number": "१२-३१२-३", "content_sanskrit": "`एकत्वं च बहुत्वं च प्रकृतेरनु तत्त्ववित्।\nपरस्परं तु विद्यां वै त्वं निबोधानुपूर्वशः।\nयथोक्तमृषिभिस्तात साङ्ख्यस्यास्य निदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2085001, "chapter_id": 2807, "verse_number": "१२-३१२-४", "content_sanskrit": "कर्मेन्द्रियाणां सर्वेषां विद्या बुद्धीन्द्रियं स्मृतम्।\nबुद्धीन्द्रियाणां च तथा विशेषा इति नः श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2085002, "chapter_id": 2807, "verse_number": "१२-३१२-५", "content_sanskrit": "विशेषाणां मनस्तेषां विद्यामाहुर्मनीषिणः।\nमनसः पञ्चभूतानि विद्या इत्यभिचक्षते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2085003, "chapter_id": 2807, "verse_number": "१२-३१२-६", "content_sanskrit": "अहंकारस्तु भूतानां पञ्चानां नात्र संशयः।\nअहंकारस्य च तथा बुद्धिर्विद्या नरेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2085004, "chapter_id": 2807, "verse_number": "१२-३१२-७", "content_sanskrit": "बुद्धेः प्रकृतिरव्यक्तं तत्त्वानां परमेश्वरम्।\nविद्या ज्ञेया नरश्रेष्ठ विधिश्च परमः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2085005, "chapter_id": 2807, "verse_number": "१२-३१२-८", "content_sanskrit": "अव्यक्तस्य परं प्राहुर्विद्यां वै पञ्चविंशकम्।\nसर्वस्य सर्वमित्युक्तं ज्ञेयं ज्ञानस्य पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2085006, "chapter_id": 2807, "verse_number": "१२-३१२-९", "content_sanskrit": "ज्ञानमव्यक्तमित्युक्तं ज्ञेयो वै पञ्चविंशकः।\nतथैव ज्ञानमव्यक्तं विज्ञाता पञ्चविंशक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2085007, "chapter_id": 2807, "verse_number": "१२-३१२-१०", "content_sanskrit": "विद्याविद्यार्थितत्त्वेन मयोक्ता ते विशेषतः।\nअक्षरं च क्षरं चैव यदुक्तं तन्निबोध मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2085008, "chapter_id": 2807, "verse_number": "१२-३१२-११", "content_sanskrit": "उभावेतौ क्षरावुक्तावुभावेतौ क्षराक्षरौ।\nकारणं तु प्रवक्ष्यामि यथाख्यातो न जानतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2085009, "chapter_id": 2807, "verse_number": "१२-३१२-१२", "content_sanskrit": "अनादिनिधनावेतावुभावेवेश्वरौ मतौ।\nतत्त्वसंज्ञावुभावेतौ प्रोच्यते ज्ञानचिन्तकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2085010, "chapter_id": 2807, "verse_number": "१२-३१२-१३", "content_sanskrit": "सर्गप्रलयधर्मत्वादव्यक्तं प्राहुरक्षरम्।\nतदेतद्गुणसर्गाय विकुर्वाणं पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2085011, "chapter_id": 2807, "verse_number": "१२-३१२-१४", "content_sanskrit": "गुणानां महदादीनामुत्पद्यन्ते परम्पराः।\nअधिष्ठानं क्षेत्रमाहुरेतत्तत्पञ्चविंशकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2085012, "chapter_id": 2807, "verse_number": "१२-३१२-१५", "content_sanskrit": "यदा तु गुणजालं तदव्यक्तात्मनि संक्षिपेत्।\nतदा सह गुणैस्तैस्तु पञ्चविंशो विलीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2085013, "chapter_id": 2807, "verse_number": "१२-३१२-१६", "content_sanskrit": "गुणा गुणेषु लीयन्ते तदैका प्रकृतिर्भवेत्।\nक्षेत्रज्ञोऽपि यदा तात तत्क्षेत्रे संप्रलीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2085014, "chapter_id": 2807, "verse_number": "१२-३१२-१७", "content_sanskrit": "तदाऽक्षरत्वं प्रकृतिर्गच्छते गुणसंज्ञिता।\nनिर्गुणत्वं च वैदेह गुणेष्वप्रतिवर्तनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2085015, "chapter_id": 2807, "verse_number": "१२-३१२-१८", "content_sanskrit": "एवमेव च क्षेत्रज्ञः क्षेत्रज्ञानपरिक्षयात्।\nप्रकृत्या निर्गुणस्त्वेष इत्येवमनुशुश्रुम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2085016, "chapter_id": 2807, "verse_number": "१२-३१२-१९", "content_sanskrit": "क्षरो भवत्येष यदा तदा गुणवती मिथः।\nप्रकृतिं त्विभजानाति निर्गुणत्वं तथाऽऽत्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2085017, "chapter_id": 2807, "verse_number": "१२-३१२-२०", "content_sanskrit": "तदा विशुद्धो भवति प्रकृतेः परिवर्जनात्।\nअन्योऽहमन्येयमिति यदा बुध्यति बुद्धिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2085018, "chapter_id": 2807, "verse_number": "१२-३१२-२१", "content_sanskrit": "तदैषा त्वन्यतामेति न च मिश्रत्वतां व्रजेत्।\nप्रकृत्या चैव राजेन्द्र मिश्रोऽनन्यश्च दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2085019, "chapter_id": 2807, "verse_number": "१२-३१२-२२", "content_sanskrit": "यदा तु गुणजालं तत्प्राकृतं विजुगुप्सते।\nपश्यते चापरं पश्यं तदा पश्यन्न संस्वजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2085020, "chapter_id": 2807, "verse_number": "१२-३१२-२३", "content_sanskrit": "किमहं कृतवानेवं योहं कालमिमं जनम्।\n`यदा मत्स्योदकं ज्ञानमनुवर्तितवांस्तदा।\nमत्स्यो जालं ह्यविज्ञानादनुवर्तितवानिह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2085021, "chapter_id": 2807, "verse_number": "१२-३१२-२४", "content_sanskrit": "अहमेव हि संमोहादन्यमन्यं जनाज्जनम्।\nमत्स्यो यथोदकज्ञानादनुवर्तितवानहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2085022, "chapter_id": 2807, "verse_number": "१२-३१२-२५", "content_sanskrit": "मत्स्योऽन्यत्वं यथा ज्ञानादुदकान्नाभिमन्यते।\nआत्मानं तद्वदज्ञानादन्यत्वं चैव वेदयहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2085023, "chapter_id": 2807, "verse_number": "१२-३१२-२६", "content_sanskrit": "ममास्तु धिगबुद्धस्य योऽहमज्ञ इमं पुनः।\nअनुवर्तितवान्मोहादन्यमन्यं जनाज्जनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2085024, "chapter_id": 2807, "verse_number": "१२-३१२-२७", "content_sanskrit": "अयमत्र भेवद्बन्धुरनेन सह मे क्षमम्।\nसाम्यमेकत्वतां यास्ये यादृशस्तादृशस्त्वहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2085025, "chapter_id": 2807, "verse_number": "१२-३१२-२८", "content_sanskrit": "तुल्यतामिह पश्यामि सदृशोऽहमनेन वै।\nअयं हि विमलोऽव्यक्तमहमीदृशकस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2085026, "chapter_id": 2807, "verse_number": "१२-३१२-२९", "content_sanskrit": "योऽहमज्ञानसंमोहादज्ञया संप्रवृत्तवान्।\nससङ्गयाऽहं निःसङ्गः स्थितः कालमिमं त्वहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2085027, "chapter_id": 2807, "verse_number": "१२-३१२-३०", "content_sanskrit": "अनयाऽहं वशीभूतः कालमेतं न बुद्धवान्।\nउच्चमध्यमनीचानां तामहं कथमावसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2085028, "chapter_id": 2807, "verse_number": "१२-३१२-३१", "content_sanskrit": "समानया न याचेह सहवासमहं कथम्।\nगच्छाम्यबुद्धभावत्वादेषेदानीं स्थिरो भवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2085029, "chapter_id": 2807, "verse_number": "१२-३१२-३२", "content_sanskrit": "सहवासं न यास्यामि कालमेतद्धि वञ्चनात्।\nवञ्चितोस्म्यनया यद्धि निर्विकारो विकारया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2085030, "chapter_id": 2807, "verse_number": "१२-३१२-३३", "content_sanskrit": "न चायमपराधोऽस्या ह्यपराधो ह्ययं मम।\nयोऽहमत्राभवं सक्तः पराङ्भुखमुपस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2085031, "chapter_id": 2807, "verse_number": "१२-३१२-३४", "content_sanskrit": "ततोस्मि बहुरूपासु स्थितो मूर्तिष्वमूर्तिमान्।\nअमूर्तश्चापि मूर्तात्मा ममत्वेन प्रधर्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2085032, "chapter_id": 2807, "verse_number": "१२-३१२-३५", "content_sanskrit": "प्रकृतेरनयत्वेन तासु तास्विह योनिषु।\nनिर्ममस्य ममत्वेन किं कृतं तासु तासु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2085033, "chapter_id": 2807, "verse_number": "१२-३१२-३६", "content_sanskrit": "योनीषु वर्तमानेन नष्टसंज्ञेन चेतसा।\nन ममात्रानया कार्यमहंकारकृतात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2085034, "chapter_id": 2807, "verse_number": "१२-३१२-३७", "content_sanskrit": "आत्मानं बहुधा कृत्वा येयं भूयो युनक्ति माम्।\nइदानीमेष बुद्धोस्मि निर्ममो निरहंकृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2085035, "chapter_id": 2807, "verse_number": "१२-३१२-३८", "content_sanskrit": "ममत्वमनया नित्यमहंकारकृतात्मकम्।\nअपेत्याहमिमां हित्वा संश्रयिष्ये निरामयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2085036, "chapter_id": 2807, "verse_number": "१२-३१२-३९", "content_sanskrit": "अनेन साम्यं यास्यामि नानयाऽहमचेतसा।\nक्षणं मम सहानेन नैकत्वमनया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2085037, "chapter_id": 2807, "verse_number": "१२-३१२-४०", "content_sanskrit": "एवं परमसंबोधात्पञ्चविंशोऽनुबुद्धवान्।\nअक्षरत्वं नियच्छेत त्यक्त्वा क्षरमनामयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2085038, "chapter_id": 2807, "verse_number": "१२-३१२-४१", "content_sanskrit": "अव्यक्तं व्यक्तकर्माणं सगुणं निर्गुणं तथा।\nनिर्गुणं परमं दृष्ट्वा तादृग्भवति मैथिल॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2085039, "chapter_id": 2807, "verse_number": "१२-३१२-४२", "content_sanskrit": "अक्षरक्षरयोरेतदुक्तं तत्वनिदर्शनम्।\nमयेह ज्ञानसंपन्नं यथाश्रूतिनिदर्शनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2085040, "chapter_id": 2807, "verse_number": "१२-३१२-४३", "content_sanskrit": "निःसंदिग्धं च सूक्ष्मं च विबुद्धं विमलं यथा।\nप्रवक्ष्यामि तुते भूयस्तन्निबोध यथाश्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2085041, "chapter_id": 2807, "verse_number": "१२-३१२-४४", "content_sanskrit": "साङ्ख्ययोगौ मया प्रोक्तौ शास्त्रद्वयनिदर्शनात्।\nयदेव शास्त्रं साङ्ख्योक्तं योगदर्शनमेव तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2085042, "chapter_id": 2807, "verse_number": "१२-३१२-४५", "content_sanskrit": "प्रबोधनकरं ज्ञानं साङ्ख्यानामवनीपते।\nविस्पष्टं प्रोच्यते तत्र शिष्याणां हितकाम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2085043, "chapter_id": 2807, "verse_number": "१२-३१२-४६", "content_sanskrit": "पृथक्चैवमिदं शास्त्रमित्याहुः कुशला जनाः।\nअस्मिंश्च शास्त्रे योगानां पुनर्दधि पुनः शरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2085044, "chapter_id": 2807, "verse_number": "१२-३१२-४७", "content_sanskrit": "पञ्चविंशात्परं तत्त्वं न पश्यति नराधिप।\nसाङ्ख्यानां तु परं तत्त्वं यथावदनुवर्णितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2085045, "chapter_id": 2807, "verse_number": "१२-३१२-४८", "content_sanskrit": "बुद्धमप्रतिबुद्धं च बुध्यमानं च तत्त्वतः।\nबुध्यमानं च बुद्धं च प्राहुर्योगनिदर्शनम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2085046, "chapter_id": 2807, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि द्वादशाधिकत्रिशततमोऽध्यायः॥ ३१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]