[{"id": 2160557, "chapter_id": 4478, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2160558, "chapter_id": 4478, "verse_number": "१", "content_sanskrit": "ततः प्रविष्टे कौन्तेये सिन्धुराजजिघांसया ।\nद्रोणानीकं विनिर्भिद्य भोजानीकं सुदुस्तरम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2160559, "chapter_id": 4478, "verse_number": "२", "content_sanskrit": "काम्बोजस्य च दायादे हते राजन् सुदक्षिणे ।\nश्रुतायुषि च विक्रान्ते निहते सव्यसाचिना\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2160560, "chapter_id": 4478, "verse_number": "३", "content_sanskrit": "विप्रद्रुतेष्वनीकेषु विध्वस्तेषु समन्ततः ।\nप्रभग्नं स्वबलं दृष्ट्वा पुत्रस्ते द्रोणमभ्ययात्\nत्वरन्नेकरथेनैव समेत्य द्रोणमब्रवीत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2160561, "chapter_id": 4478, "verse_number": "४", "content_sanskrit": "गतः स पुरुषव्याघ्रः प्रमथ्येमां महाचमूम् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2160562, "chapter_id": 4478, "verse_number": "५", "content_sanskrit": "तत्र कार्यं समीक्षस्व ब्रह्मन् निश्रेयसं हितम् ।\nअर्जुनस्य विघाताय दारुणेऽस्मिञ्जनक्षये\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2160563, "chapter_id": 4478, "verse_number": "६", "content_sanskrit": "यथा स पुरुषव्याघ्र न हन्येत जयद्रथः ।\nतथा विधत्स्व भद्रं ते त्वं हि नः परमा गतिः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2160564, "chapter_id": 4478, "verse_number": "७", "content_sanskrit": "असौ धनञ्जयाग्निर्हि कोपमारुतचोदितः ।\nसेनाकक्षं दहति नः कक्षमग्निरिवोत्थितः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2160565, "chapter_id": 4478, "verse_number": "८", "content_sanskrit": "अतिक्रान्ते तु कौन्तेये तव सैन्यं परन्तप ।\nजयद्रथस्य गोप्तारः संशयं परमं गताः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2160566, "chapter_id": 4478, "verse_number": "९", "content_sanskrit": "स्थिरा बुद्धिर्नरेन्द्राणामासीद् ब्रह्मविदां वर ।\nनातिक्रमिष्यति द्रोणं जातु जीवन् धनञ्जयः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2160567, "chapter_id": 4478, "verse_number": "१०", "content_sanskrit": "योऽसौ पार्थो ह्यतिक्रान्तो मिषतस्ते महाद्युते ।\nसर्वं ह्यद्यातुरं मन्ये नेदमस्ति बलं मम\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2160568, "chapter_id": 4478, "verse_number": "११", "content_sanskrit": "जानामि त्वां महाभाग पाण्डवानां हिते रतम् ।\nततो मुह्यामि च ब्रह्मन् कार्यवत्तां विचिन्तयन्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2160569, "chapter_id": 4478, "verse_number": "१२", "content_sanskrit": "यथाशक्ति च ते ब्रह्मन् वर्तयन् वृत्तिमुत्तमाम् ।\nप्रीणामि च यथाशक्ति तच्च त्वं नावबुद्ध्यसे\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2160570, "chapter_id": 4478, "verse_number": "१३", "content_sanskrit": "अस्मान्न त्वं सदा भक्तान् नेच्छसे शत्रुकर्शन ।\nपाण्डवान् सततं प्रीणास्यस्माकमहिते रतान्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2160571, "chapter_id": 4478, "verse_number": "१४", "content_sanskrit": "न ह्यहं त्वां विजानामि वचसा ललितं सदा ।\nहृदयेन भृशं तीक्ष्णं मधुदिग्धमिव क्षुरम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2160572, "chapter_id": 4478, "verse_number": "१५", "content_sanskrit": "अस्मानेवोपजीवंस्त्वमस्माकं विप्रिये रतः ।\nनह्यहं त्वां विजानामि सर्पं मण्डूकराविणम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2160573, "chapter_id": 4478, "verse_number": "१६", "content_sanskrit": "नादास्यच्चेद् वरं मह्यं भवान् पाण्डवनिग्रहे ।\nनावारयिष्यं गच्छन्तमहं सिन्धुपतिं गृहान्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2160574, "chapter_id": 4478, "verse_number": "१७", "content_sanskrit": "मया त्वाशंसमानेन त्वत्तस्त्राणमबुद्धिना ।\nआश्वासितः सिन्धुपतिर्मोहाद्दत्तश्च मृत्यवे\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2160575, "chapter_id": 4478, "verse_number": "१८", "content_sanskrit": "यमदंष्ट्रान्तरं प्राप्तो ह्यपि मुच्येत मानवः ।\nनार्जुनस्य वशं प्राप्तो मुच्येत हि जयद्रथः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2160576, "chapter_id": 4478, "verse_number": "१९", "content_sanskrit": "स तथा कुरु शोणाश्व यथा मुच्येत सैन्धवः ।\nमम चार्तप्रलापानां मा क्रुधः पाहि सैन्धवम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2160577, "chapter_id": 4478, "verse_number": "", "content_sanskrit": "द्रोणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2160578, "chapter_id": 4478, "verse_number": "२०", "content_sanskrit": "नाभ्यसूयामि ते वाक्यमश्वत्थाम्नाऽसि मे समः ।\nतथ्यं तु ते प्रवक्ष्यामि तज्जुषस्व विशांपते\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2160579, "chapter_id": 4478, "verse_number": "२१", "content_sanskrit": "सारथिप्रवरः कृष्णः शीघ्राश्चास्य हयोत्तमाः ।\nअल्पं च विवरं कृत्वा तूर्णं याति धनञ्जयः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2160580, "chapter_id": 4478, "verse_number": "२२", "content_sanskrit": "किन्न पश्यसि बाणौघान् क्रोशमात्रे किरीटिनः ।\nपश्चाद् रथस्य पतितान् क्षिप्रान् शीघ्रं हि गच्छतः॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2160581, "chapter_id": 4478, "verse_number": "२३", "content_sanskrit": "न चाहं शीघ्रयानेऽद्य समर्थो वयसान्वितः ।\nसेनामुखे च पार्थानामेतद् बलमुपस्थितम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2160582, "chapter_id": 4478, "verse_number": "२४", "content_sanskrit": "युधिष्ठिरश्च मे ग्राह्यो मिषतां सर्वधन्विनाम् ।\nएवं मया प्रतिज्ञातं क्षत्रमध्ये महाभुज\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2160583, "chapter_id": 4478, "verse_number": "२५", "content_sanskrit": "धनञ्जयेन चोत्सृष्टः प्रमुखे वर्तते मम ।\nतस्माद् व्यूहमुखं हित्वा नाहं यास्यामि फल्गुनम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2160584, "chapter_id": 4478, "verse_number": "२६", "content_sanskrit": "तुल्याभिजनकर्माणं शत्रुमेकं सहायवान् ।\nगत्वा योधय मा भैस्त्वं त्वं ह्यस्य जगतः पतिः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2160585, "chapter_id": 4478, "verse_number": "२७", "content_sanskrit": "राजा शूरः कृती दक्षो वैरमुत्पाद्य पाण्डवैः ।\nवीरः स्वयं प्रयाह्याशु यत्र यातो धनञ्जयः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2160586, "chapter_id": 4478, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2160587, "chapter_id": 4478, "verse_number": "२८", "content_sanskrit": "कथं त्वामप्यतिक्रान्तः सर्वशस्त्रभृतां वरम् ।\nधनञ्जयो मया शक्य आचार्य प्रतिबाधितुम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2160588, "chapter_id": 4478, "verse_number": "२९", "content_sanskrit": "अपि शक्यो रणे जेतुं वज्रहस्तः पुरन्दरः ।\nनार्जुनः समरे शक्यो जेतुं परपुरञ्जयः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2160589, "chapter_id": 4478, "verse_number": "३०", "content_sanskrit": "येन भोजश्च हार्दिक्यो भवांश्च त्रिदशोपमः ।\nशस्त्रप्रतापेन जितौ श्रुतायुश्च निबर्हितः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2160590, "chapter_id": 4478, "verse_number": "३१", "content_sanskrit": "सुदक्षिणश्च निहतः स च राजा श्रुतायुधः ।\nश्रुतायुश्चाश्रुतायुश्च म्लेच्छाश्च बहवो हताः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2160591, "chapter_id": 4478, "verse_number": "३२", "content_sanskrit": "तं कथं पाण्डवं सङ्ख्ये दहन्तमहितान् बहून् ।\nप्रतियोत्स्यामि दुर्धर्षं तन्ममाचक्ष्व सत्तम\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2160592, "chapter_id": 4478, "verse_number": "३३", "content_sanskrit": "क्षमं चेन्मन्यसे युद्धं मम तेनाद्य शाधि माम् ।\nपरवानस्मि भवतः प्रेष्यकृद् रक्ष मे यशः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2160593, "chapter_id": 4478, "verse_number": "", "content_sanskrit": "द्रोणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2160594, "chapter_id": 4478, "verse_number": "३४", "content_sanskrit": "सत्यं वदसि कौरव्य दुराधर्षो धनञ्जयः ।\nअहं तु तत् करिष्यामि यथैनं प्रसहिष्यसि\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2160595, "chapter_id": 4478, "verse_number": "३५", "content_sanskrit": "अद्भुतं चाद्य पश्यन्तु लोके सर्वधनुर्धराः ।\nविषक्तं त्वयि कौन्तेयं वासुदेवस्य पश्यतः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2160596, "chapter_id": 4478, "verse_number": "३६", "content_sanskrit": "एष ते कवचं राजन् तथा बध्नामि काञ्चनम् ।\nयथा न बाणा नास्त्राणि प्रभविष्यन्ति ते रणे\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2160597, "chapter_id": 4478, "verse_number": "३७", "content_sanskrit": "यदि त्वा सासुरगणाः सत्र्यक्षोरगपक्षिणः ।\nयोधयन्ति त्रयो लोकाः सनरा नास्ति ते भयम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2160598, "chapter_id": 4478, "verse_number": "३८", "content_sanskrit": "न कृष्णो न च कौन्तेयो न चान्यः शस्त्रभृद् रणे ।\nशरानर्पयितुं कश्चित् कवचे तव कौरव\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2160599, "chapter_id": 4478, "verse_number": "३९", "content_sanskrit": "स त्वं कवचमास्थाय क्रुद्धमद्य रणेऽर्जुनम् ।\nत्वरमाणः स्वयं याहि न त्वाऽसौ विषहिष्यति\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2160600, "chapter_id": 4478, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2160601, "chapter_id": 4478, "verse_number": "४०", "content_sanskrit": "एवमुक्त्वा त्वरन् द्रोणः स्पृष्ट्वाऽम्भो वर्म भास्वरम् ।\nआबबन्धाद्भुततमं जपन् मन्त्रं यथाविधि\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2160602, "chapter_id": 4478, "verse_number": "४१", "content_sanskrit": "रणाय महते राजन् विजयाय सुतस्य ते ।\nविसिष्मापयिषुर्लोकान् विद्यया ब्रह्मवित्तमः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2160603, "chapter_id": 4478, "verse_number": "", "content_sanskrit": "द्रोणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2160604, "chapter_id": 4478, "verse_number": "४२", "content_sanskrit": "करोतु स्वस्ति ते ब्रह्मा स्वस्ति चापि द्विजातयः ।\nसरीसृपाश्च ये श्रेष्ठाः तेभ्यस्ते स्वस्ति भारत\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2160605, "chapter_id": 4478, "verse_number": "४३", "content_sanskrit": "ययातिर्नहुषश्चैव धुन्धुमारो भगीरथः ।\nतुभ्यं राजर्षयः सर्वे स्वस्ति कुर्वन्तु सर्वतः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2160606, "chapter_id": 4478, "verse_number": "४४", "content_sanskrit": "स्वस्ति तेऽस्त्वेकपादेभ्यो बहुपादेभ्य एव च ।\nस्वस्त्यस्त्वपादकेभ्यश्च नित्यं तव महारणे\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2160607, "chapter_id": 4478, "verse_number": "४५", "content_sanskrit": "स्वाहा स्वधा शची चैव स्वस्ति कुर्वन्तु ते सदा ।\nलक्ष्मीररुन्धती चैव कुर्यातां स्वस्ति तेऽनघ\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2160608, "chapter_id": 4478, "verse_number": "४६", "content_sanskrit": "असितो देवलश्चैव विश्वामित्रस्तथाऽङ्गिराः ।\nवसिष्ठः कश्यपश्चैव स्वस्ति कुर्वन्तु ते नृप\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2160609, "chapter_id": 4478, "verse_number": "४७", "content_sanskrit": "धाता विधाता लोकेश दिशश्च सदिगीश्वराः ।\nस्वस्ति तेऽद्य प्रयच्छन्तु कार्तिकेयश्च षण्मुखः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2160610, "chapter_id": 4478, "verse_number": "४८", "content_sanskrit": "येन देवाः सकृद् भग्नाः सङ्ग्रामे तारकामये ।\nधृताः स चाहतः शूरो ह्यवध्यो देवतागणैः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2160611, "chapter_id": 4478, "verse_number": "४९", "content_sanskrit": "विवस्वान् कुरुतां स्वस्ति तथा वैवस्वतो यमः ।\nपार्षदा वशगा यस्य स्वस्ति तुभ्यं प्रयच्छतु\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2160612, "chapter_id": 4478, "verse_number": "५०", "content_sanskrit": "दिग्गजाश्चापि चत्वारः क्षितिः खं गगनं ग्रहाः ।\nदिशश्च विदिशश्चैव सिद्धा लोकहिते रताः\nस्वस्ति कुर्वन्तु ते सत्यं मन्त्रेणानेन संस्तुताः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2160613, "chapter_id": 4478, "verse_number": "५१", "content_sanskrit": "अधस्ताद् धरणीं योऽसौ सदा धारयते नृप ।\nस शेषः पन्नगश्रेष्ठः स्वस्ति तुभ्यं प्रयच्छतु\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2160614, "chapter_id": 4478, "verse_number": "५२", "content_sanskrit": "गान्धारे युधि विक्रम्य निर्जिताः सुरसत्तमाः ।\nपुरा वृत्रेण दैत्येन भिन्नदेहाः सहस्रशः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2160615, "chapter_id": 4478, "verse_number": "५३", "content_sanskrit": "विह्वला हृतवीर्याश्च सहेन्द्रा विबुधा द्रुतम् ।\nब्रह्माणं शरणं जग्मुः वृत्राद् भीता महासुरात्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2160616, "chapter_id": 4478, "verse_number": "", "content_sanskrit": "देवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2160617, "chapter_id": 4478, "verse_number": "५४", "content_sanskrit": "प्रमर्दितानां वृत्रेण देवानां देवसत्तम ।\nगतिर्भव सुरश्रेष्ठ पाहि नो महतो भयात्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2160618, "chapter_id": 4478, "verse_number": "", "content_sanskrit": "द्रोणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2160619, "chapter_id": 4478, "verse_number": "५५", "content_sanskrit": "अथ पार्श्वे स्थितं विष्णुं शक्रादींश्च सुरोत्तमान् ।\nब्रह्मा पथ्यमिदं वाक्यं जगाद जगतां पतिः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2160620, "chapter_id": 4478, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2160621, "chapter_id": 4478, "verse_number": "५६", "content_sanskrit": "रक्ष्या हि सततं देवाः सहेन्द्राः सद्विजातयः ।\nत्वष्टुः सुदुर्धरं तेजः येन वृत्रो विनिर्मितः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2160622, "chapter_id": 4478, "verse_number": "५७", "content_sanskrit": "त्वष्ट्रा पुरा तपस्तप्त्वा वर्षायुतशतं तदा ।\nवृत्रो विनिर्मितो देवाः प्राप्यानुज्ञां महेश्वरात्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2160623, "chapter_id": 4478, "verse_number": "५८", "content_sanskrit": "शङ्करस्य प्रसादाद् वै हन्याद् देवरिपुर्बली ।\nनागत्वा शङ्करस्थानं भगवान् दृश्यते हरः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2160624, "chapter_id": 4478, "verse_number": "५९", "content_sanskrit": "वृत्रं हनिष्यथ सुराः क्षिप्रं गच्छेम मन्दिरम् ।\nयत्रास्ते तपसां योनिः दक्षयज्ञविनाशनः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2160625, "chapter_id": 4478, "verse_number": "६०", "content_sanskrit": "पिनाकी सर्वभूतेशो भगनेत्रनिपातनः \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2160626, "chapter_id": 4478, "verse_number": "", "content_sanskrit": "द्रोणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2160627, "chapter_id": 4478, "verse_number": "६१", "content_sanskrit": "तं देवाः सहिता गत्वा ब्रह्मणा सह मन्दरम् ।\nअपश्यंस्तपसो राशिं सूर्यकोटिसमप्रभम् \t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2160628, "chapter_id": 4478, "verse_number": "६२", "content_sanskrit": "सोऽब्रवीत् स्वागतं देवा ब्रूत किं करवाण्यहम् ।\nअमोघं दर्शनं मह्यं कामप्राप्तिरतोऽस्तु वः\nएवमुक्तास्तु ते सर्वे प्रत्यूचुस्तं दिवौकसः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2160629, "chapter_id": 4478, "verse_number": "", "content_sanskrit": "देवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2160630, "chapter_id": 4478, "verse_number": "६३", "content_sanskrit": "हृतौजसां नो वृत्रेण गतिर्भव दिवौकसाम् ।\nमूर्तिमीक्षस्व नो देव प्रहारैर्जर्झरीकृताम्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2160631, "chapter_id": 4478, "verse_number": "६४", "content_sanskrit": "शरणं त्वां प्रपन्नाः स्म गतिर्भव महेश्वर \t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2160632, "chapter_id": 4478, "verse_number": "", "content_sanskrit": "ईश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2160633, "chapter_id": 4478, "verse_number": "६५", "content_sanskrit": "विदितं मे यथा देवाः कृत्येयं सुमहाबला ।\nत्वष्टुस्तेजोद्भवा घोरा दुर्निवार्याऽकृतात्मभिः\nअवश्यं तु मया कार्यं साह्यं सर्वदिवौकसाम्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2160634, "chapter_id": 4478, "verse_number": "६६", "content_sanskrit": "ममेदं गात्रजं शक्र कवचं गृह्य भास्वरम् ।\nबधानैनं तु मन्त्रेण मानसेन सुरेश्वर\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2160635, "chapter_id": 4478, "verse_number": "", "content_sanskrit": "द्रोणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2160636, "chapter_id": 4478, "verse_number": "६७", "content_sanskrit": "इत्युक्त्वा वरदः प्रादाद् वर्म तन्मन्त्रमेव च ।\nस तेन वर्मणा गुप्तः प्रायाद् वृत्रचमूं प्रति\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2160637, "chapter_id": 4478, "verse_number": "६८", "content_sanskrit": "नानाविधैस्तु शस्त्रौघैः पात्यमानैः सहस्रशः ।\nन सन्धिः शक्यते भेत्तुं वर्मबन्धस्य तस्य तु\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2160638, "chapter_id": 4478, "verse_number": "६९", "content_sanskrit": "स तेन वर्मणा गुप्तो वृत्रं देवरिपुं तदा ।\nजघान समरेऽभीतः शक्रो देवाग्रणीः स्वयम्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2160639, "chapter_id": 4478, "verse_number": "७०", "content_sanskrit": "स तन्मन्त्रमयं बन्धं वर्म चाङ्गिरसे ददौ \t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2160640, "chapter_id": 4478, "verse_number": "७१", "content_sanskrit": "अङ्गिराः प्राह पुत्राय मन्त्रज्ञाय बृहस्पतेः ।\nबृहस्पतिरथोवाच अग्निवेश्याय धीमते\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2160641, "chapter_id": 4478, "verse_number": "७२", "content_sanskrit": "अग्निवेश्यो मम प्रादात् तेन बध्नामि वर्म ते ।\nतवाद्य देहरक्षार्थं मन्त्रेण नृपसत्तम\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2160642, "chapter_id": 4478, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2160643, "chapter_id": 4478, "verse_number": "७३", "content_sanskrit": "एवमुक्त्वा ततो द्रोणः तव पुत्रं महाद्युतिः ।\nपुनरेव वचः प्राह शनैराचार्यपुङ्गवः\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2160644, "chapter_id": 4478, "verse_number": "", "content_sanskrit": "द्रोणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2160645, "chapter_id": 4478, "verse_number": "७४", "content_sanskrit": "ब्रह्मसूत्रेण बध्नामि कवचं तव पार्थिव ।\nहिरण्यगर्भेण यथा बद्धं विष्णोस्तु वैशसे\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2160646, "chapter_id": 4478, "verse_number": "७५", "content_sanskrit": "यथा च ब्रह्मणा बद्धं सङ्ग्रामे तारकामये ।\nशक्रस्य कवचं दिव्यं तथा बध्नाम्यहं तव\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2160647, "chapter_id": 4478, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2160648, "chapter_id": 4478, "verse_number": "७६", "content_sanskrit": "बद्ध्वा तु कवचं तस्य मन्त्रेण विधिपूर्वकम् ।\nप्रेषयामास राजानं युद्धाय महते द्विजः\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2160649, "chapter_id": 4478, "verse_number": "७७", "content_sanskrit": "स सन्नद्धो महाबाहुराचार्येण महात्मना ।\nप्रस्थितः सहसा राजन् यत्र यातो धनञ्जयः\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2160650, "chapter_id": 4478, "verse_number": "७८", "content_sanskrit": "ततो रथसहस्रेण त्रिगर्तानां प्रहारिणाम् ।\nतथा दन्तिसहस्रेण मत्तानां वीर्यशालिनाम्\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2160651, "chapter_id": 4478, "verse_number": "७९", "content_sanskrit": "अश्वानां नियुतेनैव तथाऽन्यैश्च महारथैः ।\nवृतः प्रायान्महाबाहुरर्जुनस्य रथं प्रति\nद्रुतं प्रयातस्ते पुत्रो भृशं क्रोधसमन्वितः\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2160652, "chapter_id": 4478, "verse_number": "८०", "content_sanskrit": "नानावादित्रघोषेण नानाजनपदायुतः ।\nतव पुत्रः प्रयातस्तु यथा वैरोचनिस्तथा\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2160653, "chapter_id": 4478, "verse_number": "८१", "content_sanskrit": "ततः शब्दो महानासीत् सैन्यानां तव भारत ।\nअगाधं प्रस्थितं दृष्ट्वा समुद्रमिव कौरवम्\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2160654, "chapter_id": 4478, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि त्र्यशीतितमोऽध्यायः ॥ ८३ ॥\nजयद्रथवधपर्वणि सप्तमोऽध्यायः ॥ ७ ॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}]