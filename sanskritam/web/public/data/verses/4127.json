[{"id": 2145216, "chapter_id": 4127, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2145217, "chapter_id": 4127, "verse_number": "१", "content_sanskrit": "अक्षोहिणीः सप्त लब्ध्वा राजभिः सह सञ्जय ।\nकिंस्विदिच्छति कौन्तेयो युद्धप्रेप्सुर्युधिष्ठिरः\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2145218, "chapter_id": 4127, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2145219, "chapter_id": 4127, "verse_number": "२", "content_sanskrit": "अतीव मुदितो राजन् युद्धप्रेप्सुर्युधिष्ठिरः ।\nभीमसेनार्जुनौ चोभौ यमावपि न बिभ्यतः\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2145220, "chapter_id": 4127, "verse_number": "३", "content_sanskrit": "रथं तु दिव्यं कौन्तेयः सर्वा विभ्राजयन् दिशः ।\nमन्त्रं जिज्ञासमानः सन् बीभत्सुः समयोजयत्\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2145221, "chapter_id": 4127, "verse_number": "४", "content_sanskrit": "तमपश्याम सन्नद्धं मेघं विद्युद्युतं यथा\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2145222, "chapter_id": 4127, "verse_number": "५", "content_sanskrit": "समन्तात् समभिध्यायन् हृष्यमाणोऽभ्यभाषत ।\nपूर्वरूपमिदं पश्य वयं जेष्याम सञ्जय\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2145223, "chapter_id": 4127, "verse_number": "६", "content_sanskrit": "बीभत्सुर्मां यथोवाच तथाऽवैम्यहमप्युत\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2145224, "chapter_id": 4127, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2145225, "chapter_id": 4127, "verse_number": "७", "content_sanskrit": "प्रशंसस्यभिनन्दंस्तान् पार्थानक्षपराजितान् ।\nअर्जुनस्य रथे ब्रूहि कथमश्वाः कथं ध्वजाः\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2145226, "chapter_id": 4127, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2145227, "chapter_id": 4127, "verse_number": "८", "content_sanskrit": "भौवनः सह शक्रेण बहुचित्रं विशाम्पते ।\nरूपाणि कल्पयामास त्वष्टा धात्रा विशाम्पते\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2145228, "chapter_id": 4127, "verse_number": "९", "content_sanskrit": "ध्वजे हि तस्मिन् रूपाणि चक्रुस्ते देवमायया ।\nमहाधनानि दिव्यानि महान्ति च लघूनि च\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2145229, "chapter_id": 4127, "verse_number": "१०", "content_sanskrit": "भीमसेनानुरोधाय हनूमान् मारुतात्मजः ।\nआत्मप्रतिकृतिं तस्य ध्वज आरोपयिष्यति\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2145230, "chapter_id": 4127, "verse_number": "११", "content_sanskrit": "सर्वा दिशो योजनमात्रमन्तरं\nस तिर्यगूर्ध्वं च रुरोध वै ध्वजः ।\nन संसज्जेत् तरुभिः संवृतोऽपि\nतथा हि माया विहिता भौवनेन\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2145231, "chapter_id": 4127, "verse_number": "१२", "content_sanskrit": "यथाऽऽकाशे शक्रधनुः प्रकाशते\nन चैकवर्णं न च विद्म किं नु तत् ।\nतथा ध्वजो विहितो भौवनेन\nबह्वाकारं दृश्यते रूपमस्य\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2145232, "chapter_id": 4127, "verse_number": "१३", "content_sanskrit": "यथाऽग्निधूमो दिवमेति रुद्ध्वा\nवर्णान् बिभ्रत् तैजसांश्चित्ररूपान् ।\nतथा ध्वजो विहितो भौवनेन\nन चेद् भारो भविता नोत बाधा\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2145233, "chapter_id": 4127, "verse_number": "१४", "content_sanskrit": "श्वेतास्तस्मिन् वातवेगाः सदश्वा\nदिव्या युक्ताश्चित्ररथेन दत्ताः ।\nभुव्यन्तरिक्षे दिवि वा नरेन्द्र\nयेषां गतिर्हीयते नात्र सर्वा\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2145234, "chapter_id": 4127, "verse_number": "१५", "content_sanskrit": "शतं तत् पूर्यते नित्यकालं\nहतं हतं दत्तवरं पुरस्तात् ।\nतथा राज्ञो दत्तवरा बृहन्तो\nरथे युक्ता भान्ति तद्वीर्यतुल्याः\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2145235, "chapter_id": 4127, "verse_number": "१६", "content_sanskrit": "ऋश्यप्रख्या भीमसेनस्य वाहा\nरथे वायोस्तुल्यवेगा बभूवुः\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2145236, "chapter_id": 4127, "verse_number": "१७", "content_sanskrit": "कल्माषाङ्गास्तित्तिरिचित्रपृष्ठा\nभ्रात्रा दत्ताः प्रीयता फल्गुनेन ।\nभ्रातुर्वीरस्य स्वैस्तुरङ्गैर्विशिष्टा\nमुदा युक्ताः सहदेवं वहन्ति\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2145237, "chapter_id": 4127, "verse_number": "१८", "content_sanskrit": "माद्रीपुत्रं नकुलं त्वाजमीढं\nमहेन्द्रदत्ता हरयो वाजिमुख्याः ।\nसमा वायोर्बलवन्तस्तरस्विनो\nमहाजवाश्चित्ररूपाः सदश्वाः\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2145238, "chapter_id": 4127, "verse_number": "१९", "content_sanskrit": "सौभद्रादीन् द्रौपदेयान् कुमारान्\nवहन्त्यश्वा देवदत्ता बृहन्तः\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2145239, "chapter_id": 4127, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्याम् उद्योगपर्वणि अष्टपञ्चाशोऽध्यायः ॥५८॥\nव्यासाभिगमनपर्वणि एकादशोऽध्यायः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]