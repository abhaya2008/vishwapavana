[{"id": 6000047000, "chapter_id": 10047, "verse_number": null, "content_sanskrit": "अथ सप्तदशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000047001, "chapter_id": 10047, "verse_number": null, "content_sanskrit": "ब्रह्मोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.001.m4a", "display_order": 2}, {"id": 6000047002, "chapter_id": 10047, "verse_number": "३-१७-१", "content_sanskrit": "इति तद् गृणतां तेषां मुनीनां योगधर्मिणाम्।\nप्रतिनन्द्य जगादेदं विकुण्ठनिलयो विभुः॥ ३/१७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.002.m4a", "display_order": 3, "topics": [{"text": "भगवता श्रीनारायणेन सनकादीन्प्रति ब्राह्मणमहिमानुवर्णनपूर्वकं तदीयशापानुमोदनम्", "range": "१–१५"}]}, {"id": 6000047003, "chapter_id": 10047, "verse_number": null, "content_sanskrit": "श्री भगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.003.m4a", "display_order": 4}, {"id": 6000047004, "chapter_id": 10047, "verse_number": "३-१७-२", "content_sanskrit": "एतौ वै पार्षदौ मह्यं जयो विजय एव च।\nकदर्थीकृत्य मां यद् वो बह्वाधत्तामतिक्रमम्॥ ३/१७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.004.m4a", "display_order": 5}, {"id": 6000047005, "chapter_id": 10047, "verse_number": "३-१७-३", "content_sanskrit": "यस्त्वेतयोर्धृतो दण्डो भवद्भिर्मामनुव्रतैः।\nस एवानुमतोऽस्माभिर्मुनयो देवहेलनात्॥ ३/१७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.005.m4a", "display_order": 6}, {"id": 6000047006, "chapter_id": 10047, "verse_number": "३-१७-४", "content_sanskrit": "तद् वः प्रसादयाम्यद्य ब्रह्म दैवं परं हि मे।\nतद्ध्येवात्मकृतं मन्ये यत् स्वपुम्भिरसत्कृताः॥ ३/१७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.006.m4a", "display_order": 7}, {"id": 6000047007, "chapter_id": 10047, "verse_number": "३-१७-५", "content_sanskrit": "यन्नामानि च गृह्णाति लोको भृत्ये कृतागसि।\nसोऽसाधुवादस्तत्कीर्तिं हन्ति त्वचमिवामयः॥ ३/१७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.007.m4a", "display_order": 8}, {"id": 6000047008, "chapter_id": 10047, "verse_number": "३-१७-६", "content_sanskrit": "यस्यामृतामलयशःश्रवणावगाहः सद्यः पुनाति जगदाश्वपचं विकुण्ठः।\nसोऽहं भवद्भ्य उपलब्धसुतीर्थकीर्तिश्छिन्द्यां स्वबाहुमपि वः प्रतिकूलवृत्तिम्॥ ३/१७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.008.m4a", "display_order": 9}, {"id": 6000047009, "chapter_id": 10047, "verse_number": "३-१७-७", "content_sanskrit": "यत् सेवया चरणपद्मपवित्ररेणोः सद्यःक्षताखिलमलं प्रतिलब्धशीलम्।\nन श्रीर्विरक्तमपि मां विजहाति यस्याः प्रेक्षालवार्थमितरन्नियमोऽर्हते मत्॥ ३/१७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.009.m4a", "display_order": 10}, {"id": 6000047010, "chapter_id": 10047, "verse_number": "३-१७-८", "content_sanskrit": "नाहं तथाऽद्मि यजमानहविर्वितानैश्च्योतद्घृतप्लुतमदन् हुतभुङ्मुखेन।\nयद् ब्राह्मणस्य मुखतश्चरतोऽनुघासं तुष्टस्य मय्यवहितैर्निजकर्मपाकैः॥ ३/१७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.010.m4a", "display_order": 11}, {"id": 6000047011, "chapter_id": 10047, "verse_number": "३-१७-९", "content_sanskrit": "येषां बिभर्म्यहमखण्डविकुण्ठयोगमायाविभूतिरमलाङ्घ्रिरजः किरीटैः।\nविप्रांस्तु को न विषहेत यदर्हणाम्भः सद्यः पुनाति सहचन्द्रललामलोकान्॥ ३/१७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.011.m4a", "display_order": 12}, {"id": 6000047012, "chapter_id": 10047, "verse_number": "३-१७-१०", "content_sanskrit": "ये मे तनूर्द्विजवरान् दुद्रुहुर्मदीयान् भूतान्यलब्धशरणानि च भेदबुद्ध्या।\nद्रक्ष्यन्त्यघक्षतदृशो ह्यभिमन्यवस्तान् गृध्रा रुषा मम कृषन्त्यधिदण्डनेतुः॥ ३/१७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.012.m4a", "display_order": 13}, {"id": 6000047013, "chapter_id": 10047, "verse_number": "३-१७-११", "content_sanskrit": "ये ब्राह्मणान् मयि धिया क्षिपतोऽर्चयन्ति तुष्यद्धृदः स्मितसुधोक्षितपद्मवक्त्राः।\nवाण्यानुरागकलयात्मजवद्गृणन्तः सम्बोधयन्त्यहमिवाहमुपाकृतस्तैः॥ ३/१७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.013.m4a", "display_order": 14}, {"id": 6000047014, "chapter_id": 10047, "verse_number": "३-१७-१२", "content_sanskrit": "तन्मे स्वभर्तुरवसायमलक्षमाणौ युष्मद्व्यतिक्रमगतिं प्रतिपद्य सद्यः।\nभूयो ममान्तिकमितां तदनुग्रहो मे यत् कालतोऽप्यविरमो हृतयोर्विवासः॥ ३/१७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.014.m4a", "display_order": 15}, {"id": 6000047015, "chapter_id": 10047, "verse_number": null, "content_sanskrit": "ब्रह्मोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.015.m4a", "display_order": 16}, {"id": 6000047016, "chapter_id": 10047, "verse_number": "३-१७-१३", "content_sanskrit": "अथ तस्योशतीं देवीमृषिकुल्यां सरस्वतीम्।\nआस्वाद्य मन्युदष्टानां तेषामात्माऽप्यतृप्यत॥ ३/१७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.016.m4a", "display_order": 17}, {"id": 6000047017, "chapter_id": 10047, "verse_number": "३-१७-१४", "content_sanskrit": "सतीं व्यादाय शृृण्वन्तो लघ्वीं गुर्वर्थगह्वराम्।\nविगाह्यागाधगम्भीरं न विदुस्तच्चिकीर्षितम्॥ ३/१७/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.017.m4a", "display_order": 18}, {"id": 6000047018, "chapter_id": 10047, "verse_number": "३-१७-१५", "content_sanskrit": "ते योगमाययाऽऽरब्धपारमेष्ठ्यमहोदयम्।\nप्रोचुः प्राञ्जलयो विप्राः प्रहृष्टाः कम्पितत्वचः॥ ३/१७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.018.m4a", "display_order": 19}, {"id": 6000047019, "chapter_id": 10047, "verse_number": null, "content_sanskrit": "ऋषय ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.019.m4a", "display_order": 20}, {"id": 6000047020, "chapter_id": 10047, "verse_number": "३-१७-१६", "content_sanskrit": "न वयं भगवन् विद्मस्तव देव चिकीर्षितम्।\nकृतो मेऽनुग्रहश्चेति यदध्यक्षः प्रभाषसे॥ ३/१७/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.020.m4a", "display_order": 21, "topics": [{"text": "मुनिभिः भगवत्कीर्तनम्, वैकुण्ठात् प्रतिगमनं च", "range": "१६–२८"}]}, {"id": 6000047021, "chapter_id": 10047, "verse_number": "३-१७-१७", "content_sanskrit": "ब्रह्मण्यस्य परं दैवं ब्राह्मणाः किल ते प्रभो।\nविप्राणां देवदेवानां भगवानात्मदैवतम्॥ ३/१७/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.021.m4a", "display_order": 22}, {"id": 6000047022, "chapter_id": 10047, "verse_number": "३-१७-१८", "content_sanskrit": "त्वत्तः सनातनो धर्मो रक्ष्यते तनुभिस्तव।\nधर्मस्य परमो गुह्यो निर्विकारो भवान् मतः॥ ३/१७/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.022.m4a", "display_order": 23}, {"id": 6000047023, "chapter_id": 10047, "verse_number": "३-१७-१९", "content_sanskrit": "तरन्ति ह्यञ्जसा मृत्युं निवृत्ता यदनुग्रहात्।\nयोगिनः स भवान् किंस्विदनुगृह्येत यत् परैः॥ ३/१७/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.023.m4a", "display_order": 24}, {"id": 6000047024, "chapter_id": 10047, "verse_number": "३-१७-२०", "content_sanskrit": "यं वै विभूतिरुपयात्यनुवेलमन्यैरर्थार्थिभिः स्वशिरसा धृतपादरेणुः।\nधन्यार्पिताङ्घ्रितुलसीनवदामधाम्नो लोकं मधुव्रतपतेरिव कामयाना॥ ३/१७/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.024.m4a", "display_order": 25}, {"id": 6000047025, "chapter_id": 10047, "verse_number": "३-१७-२१", "content_sanskrit": "यस्तां विविक्तचरितैरनुवर्तमानां नात्याद्रियन् परमभागवतप्रसङ्गः।\nस त्वं द्विजानुपथपुण्यरजःपुनीतिः श्रीवत्सलक्ष्म किमगा भगभाजनत्वम्॥ ३/१७/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.025.m4a", "display_order": 26}, {"id": 6000047026, "chapter_id": 10047, "verse_number": "३-१७-२२", "content_sanskrit": "धर्मस्य ते भगवतस्‍त्रियुग त्रिभिः स्वैः पद्भिश्चराचरमिदं द्विजदेवतार्थम्।\nनूनं भृतं तदभिघाति रजस्तमश्च सत्त्वेन नो वरदया तनुवा निरस्य॥ ३/१७/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.026.m4a", "display_order": 27}, {"id": 6000047027, "chapter_id": 10047, "verse_number": "३-१७-२३", "content_sanskrit": "न त्वं द्विजोत्तमकुलं यदिहात्मगोपं गोप्ता वृष स्वर्हणेन सुसूनृतेन।\nतर्ह्येव नङ्क्ष्यति शिवस्तव देव पन्था लोकोऽग्रहीष्यदृषभस्य हि यत् प्रमाणम्॥ ३/१७/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.027.m4a", "display_order": 28}, {"id": 6000047028, "chapter_id": 10047, "verse_number": "३-१७-२४", "content_sanskrit": "तत्तेऽनभीष्टमिव सत्त्वनिधेर्विधित्सोः क्षेमं जनाय निजशक्तिभिरुद्धतारेः।\nनैतावता त्र्यधिपतेर्बत विश्वभर्तुस्तेजःक्षतिस्त्ववनतस्य स ते विनोदः॥ ३/१७/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.028.m4a", "display_order": 29}, {"id": 6000047029, "chapter_id": 10047, "verse_number": "३-१७-२५", "content_sanskrit": "यं वाऽनयोर्दममधीश भवान् विचष्टे वृत्तिं च वा तदनुमन्महि निर्व्यलीकम्।\nअस्मासु वा य उचितो ध्रियतां स दण्डो येऽनागसौ वयमयुङ्क्षमहि किल्बिषेण॥ ३/१७/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.029.m4a", "display_order": 30}, {"id": 6000047030, "chapter_id": 10047, "verse_number": null, "content_sanskrit": "भगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.030.m4a", "display_order": 31}, {"id": 6000047031, "chapter_id": 10047, "verse_number": "३-१७-२६", "content_sanskrit": "एतौ सुरेतरगतिं प्रतिपद्य सद्यः संरम्भसम्भृतसमाध्यनुबद्धयोगौ।\nभूयः सकाशमुपयास्यत आशु यो वः शापो मयैव विहितस्तदवैत विप्राः॥ ३/१७/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.031.m4a", "display_order": 32}, {"id": 6000047032, "chapter_id": 10047, "verse_number": null, "content_sanskrit": "ब्रह्मोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.032.m4a", "display_order": 33}, {"id": 6000047033, "chapter_id": 10047, "verse_number": "३-१७-२७", "content_sanskrit": "अथ ते मुनयो दृष्ट्वा नयनानन्दभाजनम्।\nवैकुण्ठं तदधिष्ठानं विकुण्ठं च स्वयम्भुवम्॥ ३/१७/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.033.m4a", "display_order": 34}, {"id": 6000047034, "chapter_id": 10047, "verse_number": "३-१७-२८", "content_sanskrit": "भगवन्तं परिक्रम्य प्रणिपत्यानुमान्य च।\nप्रतिजग्मुः प्रमुदिताः शंसन्तो वैष्णवीं श्रियम्॥ ३/१७/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.034.m4a", "display_order": 35}, {"id": 6000047035, "chapter_id": 10047, "verse_number": "३-१७-२९", "content_sanskrit": "भगवाननुगावाह यातं मा भैष्टमस्तु शम्।\nब्रह्मतेजः समर्थोऽपि हन्तुं नेच्छे मतं तु मे॥ ३/१७/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.035.m4a", "display_order": 36, "topics": [{"text": "भगवता त्वरितमेव स्वसमीपगमनमादिष्टाभ्यां जयविजयाभ्यां वैकुण्ठादधःपतनम्", "range": "२९–३५"}]}, {"id": 6000047036, "chapter_id": 10047, "verse_number": "३-१७-३०", "content_sanskrit": "एतत् पुरैव निर्दिष्टं रमया क्रुद्धया यदा।\nतदाऽपवारिता द्वारि विशन्ती मय्युपारते॥ ३/१७/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.036.m4a", "display_order": 37}, {"id": 6000047037, "chapter_id": 10047, "verse_number": "३-१७-३१", "content_sanskrit": "मयि संरम्भयोगेन निस्तीर्य ब्रह्महेलनम्।\nप्रत्येष्यतं निकाशं मे कालेनाल्पीयसा पुनः॥ ३/१७/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.037.m4a", "display_order": 38}, {"id": 6000047038, "chapter_id": 10047, "verse_number": "३-१७-३२", "content_sanskrit": "द्वाःस्थावादिश्य भगवान् विमानश्रेणिभूषणम्।\nसर्वातिशयया लक्ष्म्या जुष्टं स्वं धिष्ण्यमाविशत्॥ ३/१७/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.038.m4a", "display_order": 39}, {"id": 6000047039, "chapter_id": 10047, "verse_number": "३-१७-३३", "content_sanskrit": "तौ तु गीर्वाणऋषभौ दुस्तराद्धरिलोकतः।\nहतश्रियौ ब्रह्मशापादभूतां विगतस्मयौ॥ ३/१७/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.039.m4a", "display_order": 40}, {"id": 6000047040, "chapter_id": 10047, "verse_number": "३-१७-३४", "content_sanskrit": "तदा विकुण्ठधिषणात् तयोर्निपतमानयोः।\nहाहाकारो महानासीद् विमानाग्रेषु पुत्रकाः॥ ३/१७/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.040.m4a", "display_order": 41}, {"id": 6000047041, "chapter_id": 10047, "verse_number": "३-१७-३५", "content_sanskrit": "तावेव ह्यधुना प्राप्तौ पार्षदावृषभौ हरेः।\nदितेर्जठरमाविष्टं काश्यपं तेज उल्बणम्॥ ३/१७/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.041.m4a", "display_order": 42}, {"id": 6000047042, "chapter_id": 10047, "verse_number": "३-१७-३६", "content_sanskrit": "तयोरसुरयोरद्य तेजसा यमयोर्हि वः।\nआक्षिप्तं तेज एतर्हि भगवांस्तद् विधित्सति॥ ३/१७/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.042.m4a", "display_order": 43, "topics": [{"text": "एवं ब्रह्मणा पुरावृत्तनिवेदनपूर्वकम् इदानीं दितिगर्भं प्रविष्टयोर्जयविजययोः भगवताऽचिरादेव वधो भविष्यतीति देवेभ्यः कथनम्", "range": "३६–३७"}]}, {"id": 6000047043, "chapter_id": 10047, "verse_number": "३-१७-३७", "content_sanskrit": "विश्वस्य यः स्थितिलयोद्भवहेतुराद्यो योगेश्वरैरपि दुरत्यययोगमार्गः।\nक्षेमं विधास्यति स नो भगवांस्‍त्र्यधीशस्‍त्राताऽस्मदीयविमृशेन कियानिहार्थः॥ ३/१७/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_017/BhP_03.017.043.m4a", "display_order": 44}, {"id": 6000047044, "chapter_id": 10047, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां सप्तदशध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]