[{"id": 7000483000, "chapter_id": 20483, "verse_number": "३-३०-१", "content_sanskrit": "नारद उवाच ।\nअत्र ते वर्णयिष्यामि इतिहासं पुरातनम् ।\nपुरा कृतयुगे राजन्निषधे नगरे वरे॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000483001, "chapter_id": 20483, "verse_number": "३-३०-२", "content_sanskrit": "आसीद्वैश्यः कुबेराभो नामतो हेमकुंडलः ।\nकुलीनः सत्क्रियो देवद्विजपावकपूजकः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000483002, "chapter_id": 20483, "verse_number": "३-३०-३", "content_sanskrit": "कृषिवाणिज्यकर्त्तासौ विविधक्रयविक्रयी ।\nगोघोटकमहिष्यादि पशुपोषणतत्परः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000483003, "chapter_id": 20483, "verse_number": "३-३०-४", "content_sanskrit": "पयो दधीनि तक्राणि गोमयानि तृणानि च ।\nकाष्ठानि फलमूलानि लवणाद्रा र्दिपिप्पली॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000483004, "chapter_id": 20483, "verse_number": "३-३०-५", "content_sanskrit": "धान्यानि शाकतैलानि वस्त्राणि विविधानि च ।\nधातूनिक्षुविकारांश्च विक्रीणीते स सर्वदा॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000483005, "chapter_id": 20483, "verse_number": "३-३०-६", "content_sanskrit": "इत्थं नानाविधैर्वैश्य उपायैरपरैस्तथा ।\nउपार्जयामास सदा अष्टौ हाटककोटयः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000483006, "chapter_id": 20483, "verse_number": "३-३०-७", "content_sanskrit": "एवं महाधनः सोथ हाकर्णपलितोभवत् ।\nपश्चाद्विचार्य संसारक्षणिकत्वं स्वचेतसि॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000483007, "chapter_id": 20483, "verse_number": "३-३०-८", "content_sanskrit": "तद्धनस्य षडंशेन धर्मकार्यं चकार सः ।\nविष्णोरायतनं चक्रे गृहं चक्रे शिवस्य च॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000483008, "chapter_id": 20483, "verse_number": "३-३०-९", "content_sanskrit": "तडागं खानयामास विपुलं सागरोपमम् ।\nवाप्यश्च पुष्करिण्यश्च बहुधा तेन कारिताः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000483009, "chapter_id": 20483, "verse_number": "३-३०-१०", "content_sanskrit": "वटाश्वत्थाम्रकंकोल जंबू निंबादि काननम् ।\nस्वसत्वेन तदा चक्रे तथा पुष्पवनं शुभम्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000483010, "chapter_id": 20483, "verse_number": "३-३०-११", "content_sanskrit": "उदयास्तमनं यावदन्नपानं चकार सः ।\nपुराद्बहिश्चतुर्दिक्षु प्रपां चक्रेऽतिशोभनाम्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000483011, "chapter_id": 20483, "verse_number": "३-३०-१२", "content_sanskrit": "पुराणेषु प्रसिद्धानि यानि दानानि भूपते ।\nददौ तानि सधर्म्मात्मा नित्यं दानपरस्तदा॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000483012, "chapter_id": 20483, "verse_number": "३-३०-१३", "content_sanskrit": "यावज्जीवकृते पापे प्रायाश्चित्तमथाकरोत् ।\nदेवपूजापरो नित्यं नित्यं चातिथिपूजकः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000483013, "chapter_id": 20483, "verse_number": "३-३०-१४", "content_sanskrit": "तस्येत्थं वर्त्तमानस्य संजातौ द्वौ सुतौ नृप ।\nतौ सुप्रसिद्ध नामानौ श्रीकुंडल विकुंडलौ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000483014, "chapter_id": 20483, "verse_number": "३-३०-१५", "content_sanskrit": "तयोर्मूर्ध्नि गृहं त्यक्त्वा जगाम तपसे वनम् ।\nतत्राराध्य परं देवं गोविंदं वरदं प्रभुम्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000483015, "chapter_id": 20483, "verse_number": "३-३०-१६", "content_sanskrit": "तपःक्लिष्ट शरीरोऽसौ वासुदेवमनाः सदा ।\nप्राप्तः स वैष्णवं लोकं यत्र गत्वा न शोचति ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000483016, "chapter_id": 20483, "verse_number": "३-३०-१७", "content_sanskrit": "अथ तस्य सुतौ राजन्महामान समन्वितौ ।\nतरुणौ रूपसंपन्नौ धनगर्वेण गर्वितौ ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000483017, "chapter_id": 20483, "verse_number": "३-३०-१८", "content_sanskrit": "दुःशीलौ व्यसनासक्तौ धर्मकर्माद्यदर्शकौ ।\nन वाक्यं चागतौ मातुर्वृद्धानां वचनं तथा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000483018, "chapter_id": 20483, "verse_number": "३-३०-१९", "content_sanskrit": "कुमार्गगौ दुरात्मानौ पितृमित्रनिषेधकौ ।\nअधर्मनिरतौ दुष्टौ परदाराभिगामिनौ ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000483019, "chapter_id": 20483, "verse_number": "३-३०-२०", "content_sanskrit": "गीतवादित्रनिरतौ वीणावेणुविनोदिनौ ।\nवारस्त्रीशतसंयुक्तौ गायंतौ चेरतुस्तदा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000483020, "chapter_id": 20483, "verse_number": "३-३०-२१", "content_sanskrit": "चाटुकारजनैर्युक्तौ बिंबोष्ठीषु विशारदौ ।\nसुवेषौ चारुवसनौ चारुचंदनरूषितौ ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000483021, "chapter_id": 20483, "verse_number": "३-३०-२२", "content_sanskrit": "तथा सुगंधिमालाढ्यौ कस्तूरीलक्ष्मलक्षितौ ।\nनानालंकारशोभाढ्यौ मौक्तिकाहारहारिणौ ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000483022, "chapter_id": 20483, "verse_number": "३-३०-२३", "content_sanskrit": "गजवाजिरथौघेन क्रीडंतौ तावितस्तदा ।\nमधुपानसमायुक्तौ परस्त्रीरतिमोहितौ ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000483023, "chapter_id": 20483, "verse_number": "३-३०-२४", "content_sanskrit": "नाशयंतौ पितृद्रव्यं सहस्रं ददतुः शतम् ।\nतस्थतुः स्वगृहे रम्ये नित्यं भोगपरायणौ ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000483024, "chapter_id": 20483, "verse_number": "३-३०-२५", "content_sanskrit": "इत्थं तु तद्धनं ताभ्यां विनियुक्तमसद्व्ययैः ।\nवारस्त्री विट शैलूष मल्ल चारण बंदिषु ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000483025, "chapter_id": 20483, "verse_number": "३-३०-२६", "content_sanskrit": "अपात्रे तद्धनं दत्तं क्षिप्तं बीजमिवोषरे ।\nन सत्पात्रे च तद्दत्तं न ब्राह्मणमुखे हुतम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000483026, "chapter_id": 20483, "verse_number": "३-३०-२७", "content_sanskrit": "नार्चितो भूतभृद्विष्णुः सर्वपापप्रणाशनः ।\nउभयोरेव तद्द्रव्यमचिरेण क्षयं ययौ ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000483027, "chapter_id": 20483, "verse_number": "३-३०-२८", "content_sanskrit": "ततस्तौ दुःखमापन्नौ कार्पण्यं परमं गतौ ।\nशोचमानौ तु मुह्यंतौ क्षुत्पीडादुःखपीडितौ ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000483028, "chapter_id": 20483, "verse_number": "३-३०-२९", "content_sanskrit": "तयोस्तु तिष्ठतोर्गेहे नास्ति यद्भुज्यते तदा ।\nस्वजनैर्बांधवैस्सर्वैः सेवकैरुपजीविभिः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000483029, "chapter_id": 20483, "verse_number": "३-३०-३०", "content_sanskrit": "द्रव्याभावे परित्यक्तौ चिंत्यमानौ ततः पुरे ।\nपश्चाच्चौर्य्यं समारब्धं ताभ्यां च नगरे नृप ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000483030, "chapter_id": 20483, "verse_number": "३-३०-३१", "content_sanskrit": "राजतो लोकतो भीतौ स्वपुरान्निःसृतौ तदा ।\nचक्रतुर्वनवासं तौ सर्वेषामुपपीडितौ ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000483031, "chapter_id": 20483, "verse_number": "३-३०-३२", "content_sanskrit": "जघ्नतुः सततं मूढौ शितैर्बाणैर्विषार्पितैः ।\nनानापक्षिवराहांश्च हरिणान्रोहितांस्तथा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000483032, "chapter_id": 20483, "verse_number": "३-३०-३३", "content_sanskrit": "शशकाञ्छल्लकान्गोधान्श्वापदांश्चेतरान्बहून् ।\nमहाबलौ भिल्लसंगावाखेटकभुजौ सदा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000483033, "chapter_id": 20483, "verse_number": "३-३०-३४", "content_sanskrit": "एवं मांसमयाहारौ पापाहारौ परंतप ।\nकदाचिद्भूधरं प्राप्तो ह्येकोऽन्यश्च वनं गतः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000483034, "chapter_id": 20483, "verse_number": "३-३०-३५", "content_sanskrit": "शार्दूलेन हतो ज्येष्ठः कनिष्ठः सर्पदंशितः ।\nएकस्मिन्दिवसे राजन्पापिष्ठौ निधनं गतौ ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000483035, "chapter_id": 20483, "verse_number": "३-३०-३६", "content_sanskrit": "यमदूतैस्ततोबद्ध्वा पापैर्नीतौ यमालयम् ।\nगत्वाभिजगदुःसर्वे ते दूताः पापिनावुभौ ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000483036, "chapter_id": 20483, "verse_number": "३-३०-३७", "content_sanskrit": "धर्मराज नरावेतावानीतौ तव शासनात् ।\nआज्ञां देहि स्वभृत्येषु प्रसीद करवाम किम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000483037, "chapter_id": 20483, "verse_number": "३-३०-३८", "content_sanskrit": "आलोच्य चित्रगुप्तेन तदा दूताञ्जगौ यमः ।\nएकस्तु नीयतां वीर निरयं तीव्रवेदनम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000483038, "chapter_id": 20483, "verse_number": "३-३०-३९", "content_sanskrit": "अपरः स्थाप्यतां स्वर्गेयत्र भोगा ह्यनुत्तमाः ।\nकृतांताज्ञां ततः श्रुत्वा दूतैश्च क्षिप्रकारिभिः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000483039, "chapter_id": 20483, "verse_number": "३-३०-४०", "content_sanskrit": "निक्षिप्तो रौरवे घोरे यो ज्येष्ठो हि नराधिप ।\nतेषां दूतवरः कश्चिदुवाच मधुरं वचः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000483040, "chapter_id": 20483, "verse_number": "३-३०-४१", "content_sanskrit": "विकुंडल मया सार्द्धमेहि स्वर्गं ददामि ते ।\nभुंक्ष्व भोगान्सुदिव्यांस्त्वमर्जितान्स्वेन कर्मणा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]