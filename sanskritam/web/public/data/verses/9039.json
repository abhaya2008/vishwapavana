[{"id": 5000039000, "chapter_id": 9039, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे एकोनचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000039001, "chapter_id": 9039, "verse_number": "१-३९-१", "content_sanskrit": "विश्वामित्रवचः श्रुत्वा कथान्ते रघुनन्दनः ।\nउवाच परमप्रीतो मुनिं दीप्तमिवानलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000039002, "chapter_id": 9039, "verse_number": "१-३९-२", "content_sanskrit": "श्रोतुमिच्छामि भद्रं ते विस्तरेण कथामिमाम् ।\nपूर्वजो मे कथं ब्रह्मन् यज्ञं वै समुपाहरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000039003, "chapter_id": 9039, "verse_number": "१-३९-३", "content_sanskrit": "तस्य तद् वचनं श्रुत्वा कौतूहलसमन्वितः ।\nविश्वामित्रस्तु काकुत्स्थमुवाच प्रहसन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000039004, "chapter_id": 9039, "verse_number": "१-३९-४", "content_sanskrit": "श्रूयतां विस्तरो राम सगरस्य महात्मनः ।\nशंकरश्वशुरो नाम्ना हिमवानिति विश्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000039005, "chapter_id": 9039, "verse_number": "१-३९-५", "content_sanskrit": "विन्ध्यपर्वतमासाद्य निरीक्षेते परस्परम् ।\nतयोर्मध्ये समभवद् यज्ञः स पुरुषोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000039006, "chapter_id": 9039, "verse_number": "१-३९-६", "content_sanskrit": "स हि देशो नरव्याघ्र प्रशस्तो यज्ञकर्मणि ।\nतस्याश्वचर्यां काकुत्स्थ दृढधन्वा महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000039007, "chapter_id": 9039, "verse_number": "१-३९-७", "content_sanskrit": "अंशुमानकरोत् तात सगरस्य मते स्थितः ।\nतस्य पर्वणि तं यज्ञं यजमानस्य वासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000039008, "chapter_id": 9039, "verse_number": "१-३९-८", "content_sanskrit": "राक्षसीं तनुमास्थाय यज्ञियाश्वमपाहरत् ।\nह्रियमाणे तु काकुत्स्थ तस्मिन्नश्वे महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000039009, "chapter_id": 9039, "verse_number": "१-३९-९", "content_sanskrit": "उपाध्यायगणाः सर्वे यजमानमथाब्रुवन् ।\nअयं पर्वणि वेगेन यज्ञियाश्वोऽपनीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000039010, "chapter_id": 9039, "verse_number": "१-३९-१०", "content_sanskrit": "हर्तारं जहि काकुत्स्थ हयश्चैवोपनीयताम् ।\nयज्ञच्छिद्रं भवत्येतत् सर्वेषामशिवाय नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000039011, "chapter_id": 9039, "verse_number": "१-३९-११", "content_sanskrit": "तत् तथा क्रियतां राजन् यज्ञोच्छिद्रः कृतो भवेत् ।\nसोपाध्यायवचः श्रुत्वा तस्मिन् सदसि पार्थिवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000039012, "chapter_id": 9039, "verse_number": "१-३९-१२", "content_sanskrit": "षष्टिं पुत्रसहस्राणि वाक्यमेतदुवाच ह ।\nगतिं पुत्रा न पश्यामि रक्षसां पुरुषर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000039013, "chapter_id": 9039, "verse_number": "१-३९-१३", "content_sanskrit": "मन्त्रपूतैर्महाभागैरास्थितो हि महाक्रतुः ।\nतद् गच्छत विचिन्वध्वं पुत्रका भद्रमस्तु वः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000039014, "chapter_id": 9039, "verse_number": "१-३९-१४", "content_sanskrit": "समुद्रमालिनीं सर्वां पृथिवीमनुगच्छथ ।\nएकैकं योजनं पुत्रा विस्तारमभिगच्छत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000039015, "chapter_id": 9039, "verse_number": "१-३९-१५", "content_sanskrit": "यावत् तुरगसंदर्शस्तावत् खनत मेदिनीम् ।\nतमेव हयहर्तारं मार्गमाणा ममाज्ञया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000039016, "chapter_id": 9039, "verse_number": "१-३९-१६", "content_sanskrit": "दीक्षितः पौत्रसहितः सोपाध्यायगणस्त्वहम् ।\nइह स्थास्यामि भद्रं वो यावत् तुरगदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000039017, "chapter_id": 9039, "verse_number": "१-३९-१७", "content_sanskrit": "ते सर्वे हृष्टमनसो राजपुत्रा महाबलाः ।\nजग्मुर्महीतलं राम पितुर्वचनयन्त्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000039018, "chapter_id": 9039, "verse_number": "१-३९-१८", "content_sanskrit": "गत्वा तु पृथिवीं सर्वामदृष्ट्वा तं महाबलाः ।\nयोजनायामविस्तारमेकैको धरणीतलम् ।\nबिभिदुः पुरुषव्याघ्रा वज्रस्पर्शसमैर्भुजैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000039019, "chapter_id": 9039, "verse_number": "१-३९-१९", "content_sanskrit": "शूलैरशनिकल्पैश्च हलैश्चापि सुदारुणैः ।\nभिद्यमाना वसुमती ननाद रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000039020, "chapter_id": 9039, "verse_number": "१-३९-२०", "content_sanskrit": "नागानां वध्यमानानामसुराणां च राघव ।\nराक्षसानां दुराधर्षं सत्त्वानां निनदोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000039021, "chapter_id": 9039, "verse_number": "१-३९-२१", "content_sanskrit": "योजनानां सहस्राणि षष्टिं तु रघुनन्दन ।\nबिभिदुर्धरणीं राम रसातलमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000039022, "chapter_id": 9039, "verse_number": "१-३९-२२", "content_sanskrit": "एवं पर्वतसंबाधं जम्बूद्वीपं नृपात्मजाः ।\nखनन्तो नृपशार्दूल सर्वतः परिचक्रमुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000039023, "chapter_id": 9039, "verse_number": "१-३९-२३", "content_sanskrit": "ततो देवाः सगन्धर्वाः सासुराः सहपन्नगाः ।\nसम्भ्रान्तमनसः सर्वे पितामहमुपागमन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000039024, "chapter_id": 9039, "verse_number": "१-३९-२४", "content_sanskrit": "ते प्रसाद्य महात्मानं विषण्णवदनास्तदा ।\nऊचुः परमसंत्रस्ताः पितामहमिदं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000039025, "chapter_id": 9039, "verse_number": "१-३९-२५", "content_sanskrit": "भगवन् पृथिवी सर्वा खन्यते सगरात्मजैः\nबहवश्च महात्मानो वध्यन्ते जलचारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000039026, "chapter_id": 9039, "verse_number": "१-३९-२६", "content_sanskrit": "अयं यज्ञहरोऽस्माकमनेनाश्वोऽपनीयते ।\nइति ते सर्वभूतानि हिंसन्ति सगरात्मजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000039027, "chapter_id": 9039, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे एकोनचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]