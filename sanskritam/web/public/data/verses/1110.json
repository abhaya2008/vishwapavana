[{"id": 2005660, "chapter_id": 1110, "verse_number": "१-१११-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2005661, "chapter_id": 1110, "verse_number": "१-१११-१", "content_sanskrit": "अम्बायां निर्गतायां तु भीष्मः शान्तनवस्तदा।\nन्यायेन कारयामास राज्ञो वैवाहिकीं क्रियाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2005662, "chapter_id": 1110, "verse_number": "१-१११-२", "content_sanskrit": "अम्बिकाम्बालिके चैव परिणीयाग्निसंनिधौ।\nतयोः पाणी गृहीत्वा तु कौरव्यो रूपदर्पितः।\nविचित्रवीर्यो धर्मात्मा कामात्मा समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2005663, "chapter_id": 1110, "verse_number": "१-१११-३", "content_sanskrit": "ते चापि बृहतीश्यामे नीलकुञ्चितमूर्धजे।\nरक्ततुङ्गनखोपेते पीनश्रोणिपयोधऱे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2005664, "chapter_id": 1110, "verse_number": "१-१११-४", "content_sanskrit": "आत्मनः प्रतिरूपोऽसौ लब्धः पतिरिति स्थिते।\nविचित्रवीर्यं कल्याण्यौ पूजयामासतुः शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2005665, "chapter_id": 1110, "verse_number": "१-१११-५", "content_sanskrit": "अन्योन्यं प्रति सक्ते च एकभावे इव स्थिते।\nस चाश्विरूपसदृशो देवतुल्यपराक्रमः।\nसर्वासामेव नारीणां चित्तप्रमथनो रहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2005666, "chapter_id": 1110, "verse_number": "१-१११-६", "content_sanskrit": "ताभ्यां सह समाः सप्त विहरन्पृथिवीपतिः।\nविचित्रवीर्यस्तरुणो यक्ष्मणा समगृह्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2005667, "chapter_id": 1110, "verse_number": "१-१११-७", "content_sanskrit": "सुहृदां यतमानानामाप्तैः सह चिकित्सकैः।\nजगामास्तमिवादित्यः कौरव्यो यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2005668, "chapter_id": 1110, "verse_number": "१-१११-८", "content_sanskrit": "धर्मात्मा स तु गाङ्गेयः चिन्ताशोकपरायणः।\nप्रेतकार्याणि सर्वाणि तस्य सम्यगकारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2005669, "chapter_id": 1110, "verse_number": "", "content_sanskrit": "राज्ञो विचित्रवीर्यस्य सत्यवत्या मते स्थितः।\nऋत्विग्बिः सहितो भीष्मः सर्वैश्च कुरुपुङ्गवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]