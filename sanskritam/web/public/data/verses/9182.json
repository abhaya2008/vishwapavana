[{"id": 5000182000, "chapter_id": 9182, "verse_number": "२-१०५-१", "content_sanskrit": "तत: पुरुषसिंहानां वृतानां तै: सुहृद्गणै: ।\nशोचतामेव रजनी दु:खेन व्यत्यवर्त्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000182001, "chapter_id": 9182, "verse_number": "२-१०५-२", "content_sanskrit": "रजन्यां सुप्रभातायां भ्रातरस्ते सुहृद्वृता: ।\nमन्दाकिन्यां हुतं जप्यं कृत्वा राममुपागमन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000182002, "chapter_id": 9182, "verse_number": "२-१०५-३", "content_sanskrit": "तूष्णीं ते समुपासीना न कश्चित्किञ्चिदब्रवीत् ।\nभरतस्तु सुहृन्मध्ये रामं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000182003, "chapter_id": 9182, "verse_number": "२-१०५-४", "content_sanskrit": "सान्त्विता मामिका माता दत्तं राज्यमिदं मम ।\nतद्ददामि तवैवाहं भुङ्क्ष्व राज्यमकण्टकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000182004, "chapter_id": 9182, "verse_number": "२-१०५-५", "content_sanskrit": "महतेवाम्बुवेगेन भिन्न: सेतुर्जलागमे ।\nदुरावारं त्वदन्येन राज्यखण्डमिदं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000182005, "chapter_id": 9182, "verse_number": "२-१०५-६", "content_sanskrit": "गतिं खर इवाश्वस्य तार्क्ष्यस्येव पतत्ऺित्रण: ।\nअनुगन्तुं न शक्तिर्मे गतिं तव महीपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000182006, "chapter_id": 9182, "verse_number": "२-१०५-७", "content_sanskrit": "सुजीवं नित्यशस्तस्य य: परैरुपजीव्यते ।\nराम तेन तु दुर्जीवं य: परानुपजीवति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000182007, "chapter_id": 9182, "verse_number": "२-१०५-८", "content_sanskrit": "यथा तु रोपितो वृक्ष: पुरुषेण विवर्द्धित: ।\nह्रस्वकेन दुरारोहो रूढस्कन्धो महाद्रुम: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000182008, "chapter_id": 9182, "verse_number": "२-१०५-९", "content_sanskrit": "स यथा पुष्पितो भूत्वा फलानि न विदर्शयेत् ।\nस तां नानुभवेत्प्रीतिं यस्य हेतो: प्ररोपित: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000182009, "chapter_id": 9182, "verse_number": "२-१०५-१०", "content_sanskrit": "एषोपमा महाबाहो तमर्थं वेत्तुमर्हसि ।\nयदि त्वमस्मान् वृषभो भर्त्ता भृत्यान्न शाधि हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000182010, "chapter_id": 9182, "verse_number": "२-१०५-११", "content_sanskrit": "श्रेणयस्त्वां महाराज पश्यन्त्वग्र्याश्च सर्वश: ।\nप्रतपन्तमिवादित्यं राज्ये स्थितमरिन्दमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000182011, "chapter_id": 9182, "verse_number": "२-१०५-१२", "content_sanskrit": "तवा ऽनुयाने काकुत्स्थ मत्ता नर्दन्तु कुञ्जरा: ।\nअन्त:पुरगता नार्यो नन्दन्तु सुसमाहिता: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000182012, "chapter_id": 9182, "verse_number": "२-१०५-१३", "content_sanskrit": "तस्य साध्वित्यमन्यन्त नागरा विविधा जना: ।\nभरतस्य वच: श्रुत्वा रामं प्रत्यनुयाचत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000182013, "chapter_id": 9182, "verse_number": "२-१०५-१४", "content_sanskrit": "तमेवं दु:खितं प्रेक्ष्य विलपन्तं यशस्विनम् ।\nराम: कृतात्मा भरतं समाश्वासय दात्मवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000182014, "chapter_id": 9182, "verse_number": "२-१०५-१५", "content_sanskrit": "नात्मन: कामकारो ऽस्ति पुरुषो ऽयमनीश्वर: ।\nइतश्चेतरतश्चैनं कृतान्त: परिकर्षति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000182015, "chapter_id": 9182, "verse_number": "२-१०५-१६", "content_sanskrit": "सर्वे क्षयान्ता निचया: पतनान्ता: समुच्छ्रया: ।\nसंयोगा विप्रयोगान्ता मरणान्तं च जीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000182016, "chapter_id": 9182, "verse_number": "२-१०५-१७", "content_sanskrit": "यथा फलानां पक्वानां नान्यत्र पतनाद्भयम् ।\nएवं नरस्य जातस्य नान्यत्र मरणाद्भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000182017, "chapter_id": 9182, "verse_number": "२-१०५-१८", "content_sanskrit": "यथागारं दृढस्थूणं जीर्णं भूत्वा ऽवसीदति ।\nतथैव सीदन्ति नरा जरामृत्युवशङ्गता: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000182018, "chapter_id": 9182, "verse_number": "२-१०५-१९", "content_sanskrit": "अत्येति रजनी या तु सा न प्रतिनिवर्त्तते ।\nयात्येव यमुना पूर्णा समुद्रमुदकाकुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000182019, "chapter_id": 9182, "verse_number": "२-१०५-२०", "content_sanskrit": "अहोरात्राणि गच्छन्ति सर्वेषां प्राणिनामिह ।\nआयूंषि क्षपयन्त्याशु ग्रीष्मे जलमिवांशव: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000182020, "chapter_id": 9182, "verse_number": "२-१०५-२१", "content_sanskrit": "आत्मानमनुशोच त्वं किमन्यमनुशोचसि ।\nआयुस्ते हीयते यस्य स्थितस्य च गतस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000182021, "chapter_id": 9182, "verse_number": "२-१०५-२२", "content_sanskrit": "सहैव मृत्युर्व्रजति सह मृत्युर्निषीदति ।\nगत्वा सुदीर्घमध्वानं सहमृत्युर्निवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000182022, "chapter_id": 9182, "verse_number": "२-१०५-२३", "content_sanskrit": "गात्रेषु वलय: प्राप्ता: श्वेताश्चैव शिरोरुहा: ।\nजरया पुरुषो जीर्ण: किं हि कृत्वा प्रभावयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000182023, "chapter_id": 9182, "verse_number": "२-१०५-२४", "content_sanskrit": "नन्दन्त्युदित आदित्ये नन्दन्त्यस्तमिते रवौ ।\nआत्मनो नावबुध्यन्ते मनुष्या जीवितक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000182024, "chapter_id": 9182, "verse_number": "२-१०५-२५", "content_sanskrit": "हृष्यन्त्यृतुमखं दृष्ट्वा नवं नवमिहागतम् ।\nऋतूनां परिवर्त्तेन प्राणिनां प्राणसंक्षय: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000182025, "chapter_id": 9182, "verse_number": "२-१०५-२६", "content_sanskrit": "यथा काष्ठं च काष्ठं च समेयातां महार्णवे ।\nसमेत्य च व्यपेयातां कालमासाद्य कञ्चन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000182026, "chapter_id": 9182, "verse_number": "२-१०५-२७", "content_sanskrit": "एवं भार्याश्च पुत्राश्च ज्ञातयश्च घनानि च ।\nसमेत्य व्यवधावन्ति ध्रुवो ह्येषां विनाभव: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000182027, "chapter_id": 9182, "verse_number": "२-१०५-२८", "content_sanskrit": "नात्र कश्चिद्यथाभावं प्राणी समभिवर्त्तते ।\nतेन तस्मिन्न सामर्थ्यं प्रेतस्यास्त्यनुशोचत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000182028, "chapter_id": 9182, "verse_number": "२-१०५-२९", "content_sanskrit": "यथा हि सार्थं गच्छन्तं ब्रूयात् कश्चित् पथि स्थित: ।\nअहमप्यागमिष्यामि पृष्ठतो भवतामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000182029, "chapter_id": 9182, "verse_number": "२-१०५-३०", "content_sanskrit": "एवं पूर्वैर्गतो मार्ग: पितृपैतामहो ध्रुव: ।\nतमापन्न: कथं शोचेद्यस्ऺय नास्ति व्यतिक्रम: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000182030, "chapter_id": 9182, "verse_number": "२-१०५-३१", "content_sanskrit": "वयस: पतमानस्य स्रोतसो वा ऽनिवर्तिन: ।\nआत्मा सुखे नियोक्तव्य: सुखभाज: प्रजा: स्मृता: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000182031, "chapter_id": 9182, "verse_number": "२-१०५-३२", "content_sanskrit": "धर्मात्मा स शुभै: कृत्स्नै: क्रतुभिश्चाप्तदक्षिणैः ।\nधूतपापो गत: स्वर्गं पिता न: पृथिवीपति: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000182032, "chapter_id": 9182, "verse_number": "२-१०५-३३", "content_sanskrit": "भृत्यानां भरणात् सम्यक् प्रजानां परिपालनात् ।\nअर्थादानाच्च धर्मेण पिता नस्त्रिदिवं गत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000182033, "chapter_id": 9182, "verse_number": "२-१०५-३४", "content_sanskrit": "कर्मभिस्तु शुभैरिष्टै: क्रतुभिश्चाप्तदक्षिणै: ।\nस्वर्गं दशरथ: प्राप्त: पिता न: पृथिवीपति: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000182034, "chapter_id": 9182, "verse_number": "२-१०५-३५", "content_sanskrit": "इष्ट्वा बहुविधैर्यज्ञैर्भोगांश्चावाप्य पुष्कलान् ।\nउत्तमं चायुरासाद्य स्वर्गत: पृथिवीपति: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000182035, "chapter_id": 9182, "verse_number": "२-१०५-३६", "content_sanskrit": "आयुरुत्तममासाद्य भोगानपि च राघव: ।\nस न शोच्य: पिता तात: स्वर्गत: सत्कृत: सताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000182036, "chapter_id": 9182, "verse_number": "२-१०५-३७", "content_sanskrit": "स जीर्णं मानुषं देहं परित्यज्य पिता हि न: ।\nदैवीमृद्धिमनुप्राप्तो ब्रह्मलोकविहारिणीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000182037, "chapter_id": 9182, "verse_number": "२-१०५-३८", "content_sanskrit": "तं तु नैवंविध: कश्चित् प्राज्ञ: शोचितुमर्हति ।\nतद्विधो यद्विधश्चापि श्रुतवान् बुद्धिमत्तर: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000182038, "chapter_id": 9182, "verse_number": "२-१०५-३९", "content_sanskrit": "एते बहुविधा: शोका विलापरुदिते तथा ।\nवर्जनीया हि धीरेण सर्वावस्थासु धीमता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000182039, "chapter_id": 9182, "verse_number": "२-१०५-४०", "content_sanskrit": "स स्वस्थो भव माशोचीर्यात्वा चावस तां पुरीम् ।\nतथा पित्रा नियुक्तो ऽसि वशिना वदतां वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000182040, "chapter_id": 9182, "verse_number": "२-१०५-४१", "content_sanskrit": "यत्राहमपि तेनैव नियुक्त: पुण्यकर्मणा ।\nतत्रैवाहं करिष्यामि पितुरार्य्यस्य शासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000182041, "chapter_id": 9182, "verse_number": "२-१०५-४२", "content_sanskrit": "न मया शासनं तस्य त्यक्तुं न्याय्यमरिन्दम ।\nतत् त्वयापि सदा मान्यं स वै बन्धु: स न: पिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000182042, "chapter_id": 9182, "verse_number": "२-१०५-४३", "content_sanskrit": "तद्वच: पितुरेवाहं सम्मतं धर्मचारिण: ।\nकर्मणा पालयिष्यामि वनवासेन राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000182043, "chapter_id": 9182, "verse_number": "२-१०५-४४", "content_sanskrit": "धीर्मिकेणानृशंसेन नरेण गुरुवर्त्तिना ।\nभवितव्यं नरव्याघ्र परलोकं जिगीषता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000182044, "chapter_id": 9182, "verse_number": "२-१०५-४५", "content_sanskrit": "आत्मानमनुतिष्ठ त्वं स्वभावेन नरर्षभ ।\nनिशाम्य तु शुभं वृत्तं पितुर्दशरथस्य न: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000182045, "chapter_id": 9182, "verse_number": "२-१०५-४६", "content_sanskrit": "इत्येवमुक्त्वा वचनं महात्मा पितुर्निदेशप्रतिपालनार्थम् ।\nयवीयसं भ्रातरमर्थवच्च प्रभुर्मुहूर्ताद्विरराम राम: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000182046, "chapter_id": 9182, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदयोध्याकाण्डे पञ्चोत्तरशततम: सर्ग: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]