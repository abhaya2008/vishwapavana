[{"id": 5000291000, "chapter_id": 9291, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे एकोनविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000291001, "chapter_id": 9291, "verse_number": "४-१९-१", "content_sanskrit": "स वानरमहाराजः शयानः शरपीडितः।\nप्रत्युक्तो हेतुमद्वाक्यैर्नोत्तरं प्रत्यपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000291002, "chapter_id": 9291, "verse_number": "४-१९-२", "content_sanskrit": "अश्मभिः परिभिन्नाङ्गः पादपैराहतो भृशम्।\nरामबाणेन चाक्रान्तो जीवितान्ते मुमोह सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000291003, "chapter_id": 9291, "verse_number": "४-१९-३", "content_sanskrit": "तं भार्या बाणमोक्षेण रामदत्तेन संयुगे।\nहतं प्लवगशार्दूलं तारा शुश्राव वालिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000291004, "chapter_id": 9291, "verse_number": "४-१९-४", "content_sanskrit": "सा सपुत्राप्रियं श्रुत्वा वधं भर्तुः सुदारुणम्।\nनिष्पपात भृशं तस्मादुद्विग्ना गिरिकन्दरात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000291005, "chapter_id": 9291, "verse_number": "४-१९-५", "content_sanskrit": "ये त्वङ्गदपरीवारा वानरा हि महाबलाः।\nते सकार्मुकमालोक्य रामं त्रस्ताः प्रदुद्रुवुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000291006, "chapter_id": 9291, "verse_number": "४-१९-६", "content_sanskrit": "सा ददर्श ततस्त्रस्तान् हरीनापततो द्रुतम्।\nयूथादेव परिभ्रष्टान् मृगान् निहतयूथपान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000291007, "chapter_id": 9291, "verse_number": "४-१९-७", "content_sanskrit": "तानुवाच समासाद्य दुःखितान् दुःखिता सती।\nरामवित्रासितान् सर्वाननुबद्धानिवेषुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000291008, "chapter_id": 9291, "verse_number": "४-१९-८", "content_sanskrit": "वानरा राजसिंहस्य यस्य यूयं पुरःसराः।\nतं विहाय सुवित्रस्ताः कस्माद् द्रवत दुर्गताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000291009, "chapter_id": 9291, "verse_number": "४-१९-९", "content_sanskrit": "राज्यहेतोः स चेद् भ्राता भ्रात्रा क्रूरेण पातितः।\nरामेण प्रहितैर्दूरान्मार्गणैर्दूरपातिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000291010, "chapter_id": 9291, "verse_number": "४-१९-१०", "content_sanskrit": "कपिपत्न्या वचः श्रुत्वा कपयः कामरूपिणः।\nप्राप्तकालमविश्लिष्टमूचुर्वचनमङ्गनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000291011, "chapter_id": 9291, "verse_number": "४-१९-११", "content_sanskrit": "जीवपुत्रे निवर्तस्व पुत्रं रक्षस्व चाङ्गदम्।\nअन्तको रामरूपेण हत्वा नयति वालिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000291012, "chapter_id": 9291, "verse_number": "४-१९-१२", "content_sanskrit": "क्षिप्तान् वृक्षान् समाविध्य विपुलाश्च तथा शिलाः।\nवाली वज्रसमैर्बाणैर्वज्रेणेव निपातितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000291013, "chapter_id": 9291, "verse_number": "४-१९-१३", "content_sanskrit": "अभिभूतमिदं सर्वं विद्रुतं वानरं बलम्।\nअस्मिन् प्लवगशार्दूले हते शक्रसमप्रभे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000291014, "chapter_id": 9291, "verse_number": "४-१९-१४", "content_sanskrit": "रक्ष्यतां नगरी शूरैरङ्गदश्चाभिषिच्यताम्।\nपदस्थं वालिनः पुत्रं भजिष्यन्ति प्लवंगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000291015, "chapter_id": 9291, "verse_number": "४-१९-१५", "content_sanskrit": "अथवारुचितं स्थानमिह ते रुचिरानने।\nआविशन्ति च दुर्गाणि क्षिप्रमद्यैव वानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000291016, "chapter_id": 9291, "verse_number": "४-१९-१६", "content_sanskrit": "अभार्याः सहभार्याश्च सन्त्यत्र वनचारिणः।\nलुब्धेभ्यो विप्रलब्धेभ्यस्तेभ्यो नः सुमहद्भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000291017, "chapter_id": 9291, "verse_number": "४-१९-१७", "content_sanskrit": "अल्पान्तरगतानां तु श्रुत्वा वचनमङ्गना।\nआत्मनः प्रतिरूपं सा बभाषे चारुहासिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000291018, "chapter_id": 9291, "verse_number": "४-१९-१८", "content_sanskrit": "पुत्रेण मम किं कार्यं राज्येनापि किमात्मना।\nकपिसिंहे महाभागे तस्मिन् भर्तरि नश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000291019, "chapter_id": 9291, "verse_number": "४-१९-१९", "content_sanskrit": "पादमूलं गमिष्यामि तस्यैवाहं महात्मनः।\nयोऽसौ रामप्रयुक्तेन शरेण विनिपातितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000291020, "chapter_id": 9291, "verse_number": "४-१९-२०", "content_sanskrit": "एवमुक्त्वा प्रदुद्राव रुदती शोकमूर्च्छिता।\nशिरश्चोरश्च बाहुभ्यां दुःखेन समभिघ्नती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000291021, "chapter_id": 9291, "verse_number": "४-१९-२१", "content_sanskrit": "सा व्रजन्ती ददर्शाथ पतिं निपतितं भुवि।\nहन्तारं दानवेन्द्राणां समरेष्वनिवर्तिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000291022, "chapter_id": 9291, "verse_number": "४-१९-२२", "content_sanskrit": "क्षेप्तारं पर्वतेन्द्राणां वज्राणामिव वासवम्।\nमहावातसमाविष्टं महामेघौघनिःस्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000291023, "chapter_id": 9291, "verse_number": "४-१९-२३", "content_sanskrit": "शक्रतुल्यपराक्रान्तं वृष्ट्वेवोपरतं घनम्।\nनर्दन्तं नर्दतां भीमं शूरं शूरेण पातितम्।\nशार्दूलेनामिषस्यार्थे मृगराजमिवाहतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000291024, "chapter_id": 9291, "verse_number": "४-१९-२४", "content_sanskrit": "अर्चितं सर्वलोकस्य सपताकं सवेदिकम्।\nनागहेतोः सुपर्णेन चैत्यमुन्मथितं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000291025, "chapter_id": 9291, "verse_number": "४-१९-२५", "content_sanskrit": "अवष्टभ्यावतिष्ठन्तं ददर्श धनुरूर्जितम्।\nरामं रामानुजं चैव भर्तुश्चैव तथानुजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000291026, "chapter_id": 9291, "verse_number": "४-१९-२६", "content_sanskrit": "तानतीत्य समासाद्य भर्तारं निहतं रणे।\nसमीक्ष्य व्यथिता भूमौ सम्भ्रान्ता निपपात ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000291027, "chapter_id": 9291, "verse_number": "४-१९-२७", "content_sanskrit": "सुप्तेव पुनरुत्थाय आर्यपुत्रेति वादिनी।\nरुरोद सा पतिं दृष्ट्वा संवीतं मृत्युदामभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000291028, "chapter_id": 9291, "verse_number": "४-१९-२८", "content_sanskrit": "तामवेक्ष्य तु सुग्रीवः क्रोशन्तीं कुररीमिव।\nविषादमगमत् कष्टं दृष्ट्वा चाङ्गदमागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000291029, "chapter_id": 9291, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे एकोनविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]