[{"id": 2021895, "chapter_id": 1454, "verse_number": "३-९२-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2021896, "chapter_id": 1454, "verse_number": "३-९२-१", "content_sanskrit": "न वै निर्गुणमात्मानं मन्ये देवर्षिसत्तम।\nतथाऽस्मि दुःखसंतप्तो यथा नान्यो महीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2021897, "chapter_id": 1454, "verse_number": "३-९२-२", "content_sanskrit": "परांश्च निर्गुणान्मन्ये न च ध्रमगतानपि।\nते च लोमश लोकेऽस्मिन्नृध्यन्ते के न हेतुना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2021898, "chapter_id": 1454, "verse_number": "३-९२-३x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2021899, "chapter_id": 1454, "verse_number": "३-९२-३", "content_sanskrit": "नात्र दुःखं त्वया राजन्कार्यं पार्थ कथंचन।\nयदधर्मेण वर्धेयुरधर्मरुचयो जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2021900, "chapter_id": 1454, "verse_number": "३-९२-४", "content_sanskrit": "वर्धत्यधर्मेण नरस्ततो भद्राणि पश्यति।\nततः सपत्नाञ्जयति समूलस्तु विनश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2021901, "chapter_id": 1454, "verse_number": "३-९२-५", "content_sanskrit": "`यत्र धर्मेण वर्धन्ते राजानो राजसत्तम।\nसर्वान्सपत्नान्वाधन्ते राज्यं चैषां विवर्धते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2021902, "chapter_id": 1454, "verse_number": "३-९२-६", "content_sanskrit": "मया हि दृष्टा दैतेया दानवाश्च महीपते।\nवर्धमाना ह्यधर्मेण क्षयं चोपगताः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2021903, "chapter_id": 1454, "verse_number": "३-९२-७", "content_sanskrit": "पुरा देवयुगे चैव दृष्टं सर्वं मया विभो।\nअरोचयन्सुरा धर्मं धर्मं तत्यजिरेऽसुराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2021904, "chapter_id": 1454, "verse_number": "३-९२-८", "content_sanskrit": "तीर्तानि देवा विविशुर्नाविशन्भारतासुराः।\nतानधर्मकृतो दर्पः पूर्वमेव समाविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2021905, "chapter_id": 1454, "verse_number": "३-९२-९", "content_sanskrit": "दर्पान्मानः समभवन्मानात्क्रोधो व्यजायत।\nक्रोधादहीस्ततोऽलञ्जा वृत्तं तेषां ततोऽनशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2021906, "chapter_id": 1454, "verse_number": "३-९२-१०", "content_sanskrit": "तानलज्जान्गतश्रीकान्हीनवृत्तान्वृथाव्रतान्।\nक्षमा लक्ष्मीः स्वधर्मश्च नचिरात्प्रजहुस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2021907, "chapter_id": 1454, "verse_number": "३-९२-११", "content_sanskrit": "लक्ष्मीस्तु देवानगमदलक्ष्मीरसुरान्नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2021908, "chapter_id": 1454, "verse_number": "३-९२-१२", "content_sanskrit": "तानलक्ष्मीसमाविष्टान्दर्पोपहतचेतसः।\nदैतेयान्दानवांश्चैव कलिरप्याविशत्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2021909, "chapter_id": 1454, "verse_number": "३-९२-१३", "content_sanskrit": "तानलक्ष्मीसमाविष्टान्दानवान्कलिनाहतान्।\nदर्पाभिभूतान्कौन्तेय क्रियाहीनानचेतसः ॥\nमानाभिभूतानचिराद्विनाशः समपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2021910, "chapter_id": 1454, "verse_number": "३-९२-१४", "content_sanskrit": "निर्यशस्कास्तथा दैत्याः कृत्स्नशो विलयं गताः।\n`अधर्मरुचयोराजन्नलक्ष्म्या समधिष्ठिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2021911, "chapter_id": 1454, "verse_number": "३-९२-१५", "content_sanskrit": "देवास्तु सागरांश्चैव सरितश्च सरांसि च।\nअभ्यगच्छन्धर्मशीलाः पुण्यान्यावतनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2021912, "chapter_id": 1454, "verse_number": "३-९२-१६", "content_sanskrit": "तपोभिः क्रतुभिर्दानैराशीर्वादैश्च पाण्डव।\nप्रजहुः सर्वपापानि श्रेयश्च प्रतिपेदिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2021913, "chapter_id": 1454, "verse_number": "३-९२-१७", "content_sanskrit": "एवमादानवन्तश् निरादानाश्च सर्वशः।\nतीर्थान्यगच्छन्विबुधास्तेनापुर्भूतिमुत्तमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2021914, "chapter_id": 1454, "verse_number": "३-९२-१८", "content_sanskrit": "तथा त्वमपि राजेन्द्र स्नात्वा तीर्थेषु सानुजः।\nपुनर्वेत्स्वसि तां लक्ष्मीमेष पन्थाः सनातनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2021915, "chapter_id": 1454, "verse_number": "३-९२-१९", "content_sanskrit": "यथैव हि नृगो राजा शिविरौशीनरो यथा।\nभगीरयो वसुमना गयः पूरुः पुरूरवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2021916, "chapter_id": 1454, "verse_number": "३-९२-२०", "content_sanskrit": "चरमाणास्तपो नित्यंस्पर्शनादम्भसश्च ते।\nतीर्थामिगमनात्पूता दर्शनाच्च महात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2021917, "chapter_id": 1454, "verse_number": "३-९२-२१", "content_sanskrit": "अलभन्त यशः पुण्यं धनानि च विशांपते।\nतथा त्वमपि राजेन्द्र लब्ध्वा सुविपुलां श्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2021918, "chapter_id": 1454, "verse_number": "३-९२-२२", "content_sanskrit": "यथा चेक्ष्वाकुरभवत्सपुत्रजनबान्धवः।\nमुचुकुन्दोऽथ मांधाता मरुत्तश्च महीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2021919, "chapter_id": 1454, "verse_number": "३-९२-२३", "content_sanskrit": "कीर्तिं पुण्यामविन्दन्त यथा देवास्तपोबलात्।\nदेवर्षयश्च कार्त्स्न्येन तथा त्वमपि वेत्स्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2021920, "chapter_id": 1454, "verse_number": "३-९२-२४", "content_sanskrit": "धार्तराष्ट्रास्त्वधर्मेण मोहिन च वशीकृताः।\nनचिराद्वै विनङ्क्ष्यन्ति दैत्या इव न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2021921, "chapter_id": 1454, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि द्विनवतितमोऽध्यायः ॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]