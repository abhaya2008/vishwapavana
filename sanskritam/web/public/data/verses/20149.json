[{"id": 7000149000, "chapter_id": 20149, "verse_number": "१४९-१", "content_sanskrit": "नारसिंहतीर्थवर्णनम् ब्रह्मोवाच नारसिंहमिति ख्यातं गङ्गाया उत्तरे तटे ।\nतस्यानुभावं वक्ष्यामि सर्वरक्षाविधायकम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000149001, "chapter_id": 20149, "verse_number": "१४९-२", "content_sanskrit": "हिरण्यकशिपुः पूर्वमभवद्‌बलिनां वरः ।\nतपसा विक्रमेणापि देवानामपराजितः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000149002, "chapter_id": 20149, "verse_number": "१४९-३", "content_sanskrit": "हरिभक्तात्मजद्वेषकलुषीकृतमानसः ।\nआविर्भूय सभास्तम्भाद्विश्वात्मत्वं प्रदर्शयन् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000149003, "chapter_id": 20149, "verse_number": "१४९-४", "content_sanskrit": "तं हत्वा नरसिंहस्तत्सैन्यमद्रावयत्तदा ।\nसर्वान्हत्वा महादैत्यान्क्रमेणाऽऽजौ महामृगः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000149004, "chapter_id": 20149, "verse_number": "१४९-५", "content_sanskrit": "रसातलस्थाञ्शत्रुंश्च जित्वा स्वर्लोकमीयिवान् ।\nतत्र जित्वा भुवं गत्वा दैत्यान्हत्वा नगस्थितान् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000149005, "chapter_id": 20149, "verse_number": "१४९-६", "content_sanskrit": "समुद्रस्थान्नदीसंस्थान्ग्राममस्थान्वनवासिनः ।\nनानारूपधरान्दैत्यान्निजघान मृगाकृतिः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000149006, "chapter_id": 20149, "verse_number": "१४९-७", "content_sanskrit": "आकाशगान्वायुसंस्थाञ्ज्योतिर्लोकमुपागतान् ।\nवज्रपाताधिकनखः समुद्धूतमहासटः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000149007, "chapter_id": 20149, "verse_number": "१४९-८", "content_sanskrit": "दैत्यगर्भस्राविगर्जी निर्जिताशेषराक्षसः ।\nमहानादैर्वीक्षितैश्च प्रलयानलसंनिभैः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000149008, "chapter_id": 20149, "verse_number": "१४९-९", "content_sanskrit": "चपेटैरङ्गविक्षेपैरसुरान्पर्यचूर्णयत् ।\nएवं हत्वा बहुविधान्गौतमीमगमद्धरिः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000149009, "chapter_id": 20149, "verse_number": "१४९-१०", "content_sanskrit": "स्वपदाम्बुजसंभूतां मनोनयननन्दिनीम् ।\nतत्राम्बर्य इति ख्यातो दण्डकाधिपते रिपुः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000149010, "chapter_id": 20149, "verse_number": "१४९-११", "content_sanskrit": "देवानां दुर्जयो योद्धा बलेन महाताऽऽवृतः ।\nतेनाभवन्महारौद्रं भीषणं लोमहर्षणम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000149011, "chapter_id": 20149, "verse_number": "१४९-१२", "content_sanskrit": "शस्त्रास्त्रवर्षणं युद्धं हरिणा दैत्यसूनुना ।\nनिजघान हरिः श्रीमांस्तं रिपुं ह्यत्तरे तटे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000149012, "chapter_id": 20149, "verse_number": "१४९-१३", "content_sanskrit": "गङ्गायां नारसिंहं तु तीर्थं त्रैलोक्यविश्रुतम् ।\nस्नानदानादिकं तत्र सर्वपापग्रहार्दनम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000149013, "chapter_id": 20149, "verse_number": "१४९-१४", "content_sanskrit": "सर्वरक्षाकरं नित्यं जरामरणवारणम् ।\nयथा सुराणां सर्वेषां न कोऽपि हरिणा समः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000149014, "chapter_id": 20149, "verse_number": "१४९-१५", "content_sanskrit": "तीर्थानामप्यशेषाणां तथा तत्तीर्थमुत्तमम् ।\nतत्र तीर्थे नरः स्नात्वा कुर्यान्नृहरिपूजनम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000149015, "chapter_id": 20149, "verse_number": "१४९-१६", "content_sanskrit": "स्वर्गे मर्त्ये तले वाऽपि तस्य किंचिन्न दुर्लभम् ।\nइत्याद्याष्टौ मुने तत्र महातीर्थानि नारद ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000149016, "chapter_id": 20149, "verse_number": "१४९-१७", "content_sanskrit": "पृथक्पृथक्तीर्थकोटिफलमाहुर्मनीषिणः ।\nअश्रद्धयाऽपि यन्नाम्नि स्मृते सर्वाघसंक्षयः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000149017, "chapter_id": 20149, "verse_number": "१४९-१८", "content_sanskrit": "भवेत्साक्षान्नृसिंहोऽसौ सर्वदा यत्र संस्थितः ।\nतत्तीर्थसेवासंजातं फलं कैरिह वर्ण्यते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000149018, "chapter_id": 20149, "verse_number": "१४९-१९", "content_sanskrit": "यथा न देवो नृहरेरधिकः क्वापि वर्तते ।\nतथा नृसिंहतीर्थेन समं तीर्थं न कुत्रचित् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]