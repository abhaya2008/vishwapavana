[{"id": 33000385, "chapter_id": 7899, "verse_number": "1", "content_sanskrit": "धातोस्तुमर्थादिच्छायां सनि रूपं बुभूषति । शिशिक्षिषत इत्यादि पूर्ववच्चाऽऽत्मनेपदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "avatarnika": ""}, {"id": 33000386, "chapter_id": 7899, "verse_number": "2", "content_sanskrit": "सुपो मान्ताऽव्ययान्यस्मात्क्व चित्काम्यतिकर्मणः । आत्मनस्तु तदिच्छायामर्थे शब्दद्वयं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2, "avatarnika": ""}, {"id": 33000387, "chapter_id": 7899, "verse_number": "3", "content_sanskrit": "पुत्रकाम्यति पुत्रीयत्यृक्काम्यत्यृच्यतीति दिक् । एवं कर्मण आधारादाचारादुपमाऽर्थकात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3, "avatarnika": ""}, {"id": 33000388, "chapter_id": 7899, "verse_number": "4", "content_sanskrit": "क्वचित्पुत्रीयति च्छात्रं मञ्चे सौधीयतीति दिक् । उपमानात्तथा कर्तुराचारार्थे क्यङि क्विपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4, "avatarnika": ""}, {"id": 33000389, "chapter_id": 7899, "verse_number": "5", "content_sanskrit": "द्वे रूपे भवतो यद्वद्गर्दभोऽश्वायतेऽश्वति । क्यङ्योजोऽप्सरसोर्नित्यं पय आदेस्तु वा सलुक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5, "avatarnika": ""}, {"id": 33000390, "chapter_id": 7899, "verse_number": "6", "content_sanskrit": "कन्याऽप्सरायते त्वोजायतेऽहिः कं पयायते । पयस्यते तथाऽन्यस्मात्सलोपाऽदि समूह्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6, "avatarnika": ""}, {"id": 33000391, "chapter_id": 7899, "verse_number": "7", "content_sanskrit": "च्व्यर्थे भृशाऽऽदेर्हल्लोपे क्यङ्यच्व्यन्ताद्भृशायते । सुमनायत इत्यादिरूपाण्यूह्यानि सर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7, "avatarnika": ""}, {"id": 33000392, "chapter_id": 7899, "verse_number": "8", "content_sanskrit": "भृशः शश्वत्तृपद्रेहद्वेहद्वर्चोऽथ दुर्मनाः । सुमना उन्मना ओजोऽभिमनाश्चपलः शुचिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8, "avatarnika": ""}, {"id": 33000393, "chapter_id": 7899, "verse_number": "9", "content_sanskrit": "मन्द रेफन्मन्द्र भद्र पण्डिताऽण्डर कण्डराः। उत्सुको हरितो नीलः फेनः शीघ्रो भृशाऽऽदयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9, "avatarnika": ""}, {"id": 33000394, "chapter_id": 7899, "verse_number": "10", "content_sanskrit": "तत्रैव डाज्लोहितादेः क्यषि वा चाऽऽत्मनेपदम् । दिग्लोहितायतीत्यादि डाचः पटपटायति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10, "avatarnika": ""}, {"id": 33000395, "chapter_id": 7899, "verse_number": "11", "content_sanskrit": "लोहितजिह्मश्यामाः सुखदुःखे धूमचर्मगर्वाश्च । हर्षो मूर्छा निद्रा कृपा च करुणाऽऽदयोऽप्यवृत्करणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11, "avatarnika": ""}, {"id": 33000396, "chapter_id": 7899, "verse_number": "12", "content_sanskrit": "कष्टात्सत्राच्च कक्षाच्च कृछ्राद्गहनतोऽपि च । कष्टायते प्रभृतयः पापार्थं क्रमणे क्यङि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12, "avatarnika": ""}, {"id": 33000397, "chapter_id": 7899, "verse_number": "13", "content_sanskrit": "तं वर्तयति रोमन्थाद्रोमन्थायत इत्यदः । बाष्पोष्म फेनादुद्वान्ताविदं वाष्पायते मुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13, "avatarnika": ""}, {"id": 33000398, "chapter_id": 7899, "verse_number": "14", "content_sanskrit": "सुखादेः स्यादनुभवत्यर्थे दुःखायते मुखाः । सुखदुःखाऽस्र कृपण करुणाऽलीक तृप्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14, "avatarnika": ""}, {"id": 33000399, "chapter_id": 7899, "verse_number": "15", "content_sanskrit": "कृच्छ्रप्रतीपसोढाः स्युरमी दश सुखाऽऽदयः । शब्दाऽऽदिषु कृतौ शब्दायते वैरायते  मुखाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15, "avatarnika": ""}, {"id": 33000400, "chapter_id": 7899, "verse_number": "16", "content_sanskrit": "शब्दाऽऽदयस्तु सूत्रोक्ता वार्तिकोक्ता अटाऽऽदयः । अटाट्टशीकाकोटाश्च सोटापृष्ठौ च दुर्दिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16, "avatarnika": ""}, {"id": 33000401, "chapter_id": 7899, "verse_number": "17", "content_sanskrit": "पोटापृष्वा च सुदिनं नीहारश्चेत्यटादयः । तपस्यतीत्यादिकं तु प्रायः पूर्वं प्रदर्शितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17, "avatarnika": ""}, {"id": 33000402, "chapter_id": 7899, "verse_number": "18", "content_sanskrit": "कण्ड्वादेर्यकि कण्डूयत्यात्मनेऽपि हृणीयते । असूयतीत्यादिकं च प्रायः प्रागेव कीर्तितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18, "avatarnika": ""}, {"id": 33000403, "chapter_id": 7899, "verse_number": "19", "content_sanskrit": "धातोर्हलादेरेकाचः पौनःपुन्ये भृशे यङि । चेक्रीयते प्रभृतयो न भृशार्थे शुभे रुचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19, "avatarnika": ""}, {"id": 33000404, "chapter_id": 7899, "verse_number": "20", "content_sanskrit": "बहुलं लुकि तत्राऽपि बोभोत्यादिकमुह्यताम् । सूचि सूत्र्यूर्णु मूत्र्यत्र्यट्यशिभ्यश्च यङिष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20, "avatarnika": ""}, {"id": 33000405, "chapter_id": 7899, "verse_number": "21", "content_sanskrit": "सोसूच्यतेऽटाट्यतेऽरार्यत इत्यादिकं ततः । गत्यर्थेभ्यस्तु कौटिल्ये लुपादेर्भावगर्हणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21, "avatarnika": ""}, {"id": 33000406, "chapter_id": 7899, "verse_number": "22", "content_sanskrit": "यङि जङ्गम्यते लोलुप्यत इत्यादिकं भवेत् । प्रयोजकस्य व्यापारे  धातु मात्राऽऽकृतेर्णिचि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22, "avatarnika": ""}, {"id": 33000407, "chapter_id": 7899, "verse_number": "23", "content_sanskrit": "भावयत्यादि तत्रोह्यं णिचश्चेत्यात्मनेपदम् । सुबन्ताण्णिचि धात्वर्थे बहुलं भादि चेष्ठवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23, "avatarnika": ""}, {"id": 33000408, "chapter_id": 7899, "verse_number": "24", "content_sanskrit": "तत्करोतीति मुण्डादेः बटुं मुण्डयतीति दिक् । स्थूळादेस्तु  तदाचष्टे स्थवयत्यादिकं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24, "avatarnika": ""}, {"id": 33000409, "chapter_id": 7899, "verse_number": "25", "content_sanskrit": "सत्यार्थवेदादापुक् च स्यात्सत्यापयतीति दिक् । श्वेताऽश्वादश्वतरतो लोपोऽश्वतरयोर्णिचि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25, "avatarnika": ""}, {"id": 33000410, "chapter_id": 7899, "verse_number": "26", "content_sanskrit": "गालोडिताह्वारकयोर्लुप्येते  इतकौ तथा । श्वेतयत्यश्वयति गालोडयत्याह्वरयति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26, "avatarnika": ""}, {"id": 33000411, "chapter_id": 7899, "verse_number": "27", "content_sanskrit": "णिच् कृत त्वच वर्णेभ्यस्तं गृह्णात्यर्थ इष्यते। अत्वं च हलि कल्योः स्यान्निध्याने रूप शब्दतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27, "avatarnika": ""}, {"id": 33000412, "chapter_id": 7899, "verse_number": "28", "content_sanskrit": "विमोके संयमे पाशा त्तूस्ताद्विहनने भवेत् । भोजने तन्निवृत्तौ च व्रत शब्दाण्णिचो विधिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28, "avatarnika": ""}, {"id": 33000413, "chapter_id": 7899, "verse_number": "29", "content_sanskrit": "परिधाने समाच्छादे वस्त्राल्लोम्नोऽनुमार्जने । तेनाऽतिक्रामत्यर्थेऽश्वयति हस्तयतीति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29, "avatarnika": ""}, {"id": 33000414, "chapter_id": 7899, "verse_number": "30", "content_sanskrit": "सेना शब्दात्तृतीयान्तादभियाने तु सः ष च । वीणाया उपगाने स्यात् सन्नाहे वर्मणो भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30, "avatarnika": ""}, {"id": 33000415, "chapter_id": 7899, "verse_number": "31", "content_sanskrit": "चूर्णादवध्वंसनेऽर्थे तूलाण्णिजवकोषणे । श्लोकादुपस्तुतौ  वास्याः परेश्छेदन इष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31, "avatarnika": ""}, {"id": 33000416, "chapter_id": 7899, "verse_number": "32", "content_sanskrit": "णिङङ्गात्तनिरसने दिग्घस्तयत आदिकम् । पुच्छादुदसने णिङ् स्यात्पर्यासे व्यसनेऽपि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32, "avatarnika": ""}, {"id": 33000417, "chapter_id": 7899, "verse_number": "33", "content_sanskrit": "चीवरात्सञ्चये चाऽर्थे परिधाने च णिङ्  भवेत् ।भाण्डात्समाचिनोत्यर्थे णिङ् सम्भाण्डयते हि दिक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33, "avatarnika": ""}, {"id": 33000418, "chapter_id": 7899, "verse_number": "34", "content_sanskrit": "निर्दिष्टार्थे कृतस्तस्मादुपसर्गादितोऽपि च । कंसं घातयतीत्यादि सिद्धयेऽन्यो णिजुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34, "avatarnika": ""}, {"id": 33000419, "chapter_id": 7899, "verse_number": "35", "content_sanskrit": "प्रत्यक्षमिव कंसाऽदेः साधनत्वेन मन्यते । उक्तं हि भर्तृहरिणा महाभाष्याऽनुसारिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35, "avatarnika": ""}, {"id": 33000420, "chapter_id": 7899, "verse_number": "36", "content_sanskrit": "शब्दोपहित रूपांश्च बुद्धर्विषयतां गतान् । प्रत्यक्षमिव कंसाऽदीन् साधनत्वेन मन्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36, "avatarnika": ""}]