[{"id": 7002605000, "chapter_id": 22605, "verse_number": "४-१०-१", "content_sanskrit": "सूत उवाच ।\nवक्ष्ये बिल्वप्रतिष्ठां च पूर्वेद्युरधिवासयेत् ।\nत्र्यंबकं चेति मंत्रेण स्थापयेद्गंधवारिणा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002605001, "chapter_id": 22605, "verse_number": "४-१०-२", "content_sanskrit": "सुनाभेति च मंत्रेण मे गृह्णामीति चाक्षतम् ।\nकयानेति ततो धूपं वस्त्रं माल्यं निवेदयेत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002605002, "chapter_id": 22605, "verse_number": "४-१०-३", "content_sanskrit": "यजेद्रुद्रं ततो देवं मध्ये दुर्गां धनेश्वरम् ।\nततः कल्ये समुत्थाय नित्यं निर्वर्त्य शास्त्रतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002605003, "chapter_id": 22605, "verse_number": "४-१०-४", "content_sanskrit": "स्वगृहे सप्त विप्रांश्च भोजयेद्द्विजदंपती ।\nमूले हस्तद्वयं दत्त्वा वर्तुला वेदिका भवेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002605004, "chapter_id": 22605, "verse_number": "४-१०-५", "content_sanskrit": "तत्र गैरिकयुक्तेन कुसुंभचूर्णकेन वा ।\nनिशारक्तेन वा कुर्यादष्टपत्रं सुशोभनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002605005, "chapter_id": 22605, "verse_number": "४-१०-६", "content_sanskrit": "निवेष्टनं ततः कुर्याद्वृक्षस्य द्विजसत्तमाः ।\nरक्त सूत्रैर्वेष्टयेच्च पंचसप्तनवभिस्तु ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002605006, "chapter_id": 22605, "verse_number": "४-१०-७", "content_sanskrit": "व्रीहींश्च वापयेत्तत्र उत्तराभिमुखस्तथा ।\nशिवं विष्णुं च ब्रह्माणं पूजयेद्भूतिमिच्छता ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002605007, "chapter_id": 22605, "verse_number": "४-१०-८", "content_sanskrit": "शिवं च नायकं कुर्यादादित्यान्पत्रमूलके ।\nशेषं च तरुमूले तु मध्येऽनंतं शतक्रतुम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002605008, "chapter_id": 22605, "verse_number": "४-१०-९", "content_sanskrit": "वनपालं च सोमं च सूर्यं पृध्वीमनुक्रमात् ।\nहोमस्तिलाक्षतैः कार्यो बलिं दद्याद्घृतौदनैः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002605009, "chapter_id": 22605, "verse_number": "४-१०-१०", "content_sanskrit": "यक्षेभ्यो माषभक्तं च वायनानि च द्वादश ।\nग्रहाणां प्रीतये दद्यात्क्षीरेणावेष्ट्य दक्षिणाम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002605010, "chapter_id": 22605, "verse_number": "४-१०-११", "content_sanskrit": "कांचनं कांस्यपात्रं च तांबूलं ताम्रपात्रकम् ।\nयूपारोपं कर्णवेधं सवित्रेऽर्घ्यं निवेदयेत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002605011, "chapter_id": 22605, "verse_number": "४-१०-१२", "content_sanskrit": "अथ रात्रिप्रतिष्ठां च वक्ष्ये शास्त्रानुसारतः ।\nयक्षैकवृक्षसंस्कारे न पुनर्जायते भुवि ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002605012, "chapter_id": 22605, "verse_number": "४-१०-१३", "content_sanskrit": "पूर्वेद्युरुपवाहे तु वृक्षमूले घटं न्यसेत् ।\nविष्णुं शिवं गणेशं च पूजयित्वा तु स्थापयेत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002605013, "chapter_id": 22605, "verse_number": "४-१०-१४", "content_sanskrit": "कलशान्पञ्च वा सप्त गंधतैलैरलंकृतान् ।\nदुग्धेन पंचगव्येन शंखतोयेन यत्नतः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002605014, "chapter_id": 22605, "verse_number": "४-१०-१५", "content_sanskrit": "सूत्रैः संवेष्टनं कृत्वा वस्त्रमाल्यैरनंतरम् ।\nकांडादिति च मंत्रेण दद्याद्दूर्वा क्षतं ततः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002605015, "chapter_id": 22605, "verse_number": "४-१०-१६", "content_sanskrit": "विष्णुसूक्तेन च पुनः सिंदूरांजनचंदनम् ।\nदद्यात्फलं च दीपं च स्वयं तत्र स्वपेत्ततः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002605016, "chapter_id": 22605, "verse_number": "४-१०-१७", "content_sanskrit": "हुनेत्पंचाहुतीस्तत्र यूपं दद्यात्समुत्सृजेत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002605017, "chapter_id": 22605, "verse_number": "४-१०-१८", "content_sanskrit": "बलिं च पायसेनैव प्रकुर्यात्कर्णवेधनम् ।\nवेष्टयेत्क्षीरतोयेन धान्यं धेनुं च दक्षिणाम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002605018, "chapter_id": 22605, "verse_number": "४-१०-१९", "content_sanskrit": "दद्यादर्घ्यं हुनेत्पूर्णं भोजयेद्द्विजदंपती ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]