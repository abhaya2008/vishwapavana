[{"id": 900004220, "chapter_id": 8327, "verse_number": "3.1", "content_sanskrit": "यथार्थं प्रमाणम् ,तद् द्विविधम् ,केवलमनुप्रमाणं च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900004221, "chapter_id": 8327, "verse_number": "3.2", "content_sanskrit": "यथार्थज्ञानं केवलम् , अनवधारणज्ञानं संशयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900004222, "chapter_id": 8327, "verse_number": "3.3", "content_sanskrit": "असमानधर्मविप्रतिपत्त्योरपि समानधर्म एवान्तर्भावयितुं शक्यत्वात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900004223, "chapter_id": 8327, "verse_number": "3.4", "content_sanskrit": "विपरीतनिश्चयो विपर्ययः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900004224, "chapter_id": 8327, "verse_number": "3.5", "content_sanskrit": "तत्साधनमनुप्रमाणम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}]