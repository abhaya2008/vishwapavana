[{"id": 2046079, "chapter_id": 2024, "verse_number": "६-७३-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2046080, "chapter_id": 2024, "verse_number": "६-७३-१", "content_sanskrit": "विराटोऽय त्रिभिर्बाणैर्भीष्ममार्च्छन्महारथम् ।\nविव्याध तुरमांत्रास्य त्रिभिर्बाणैर्महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2046081, "chapter_id": 2024, "verse_number": "६-७३-२", "content_sanskrit": "तं प्रत्यविध्यद्दशभिर्भीष्मः शान्तनवः शरैः।\nरुक्मपुङ्खैर्महेष्वासः कृतहस्तो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2046082, "chapter_id": 2024, "verse_number": "६-७३-३", "content_sanskrit": "द्रौणिर्गाण्डीवधन्वानं भीमधन्वा महारथः ।\nअविध्यदिषुभिः षङ्भिर्दृढहस्तः स्तनान्तरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2046083, "chapter_id": 2024, "verse_number": "६-७३-४", "content_sanskrit": "कार्मुकं तस्य चिच्छेद फल्गुनः परवीरहा ।\nअविध्यच्च भृशं तीक्ष्णैः पत्रिभिः शत्रुकर्शनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2046084, "chapter_id": 2024, "verse_number": "६-७३-५", "content_sanskrit": "सोऽन्यत्कार्मुकमादाय वेगवान्क्रोधमूर्च्छितः।\nअमृष्यमाणः पार्थेन कार्मुकच्छेदमाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2046085, "chapter_id": 2024, "verse_number": "६-७३-६", "content_sanskrit": "अविध्यत्फल्गुनं राजन्नवत्या निशितैः शरैः ।\nवासुदेवं च सप्तत्या विव्याध परमेषुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2046086, "chapter_id": 2024, "verse_number": "६-७३-७", "content_sanskrit": "ततः क्रोधाभिताम्राक्षः कृष्णेन सह फल्गुनः ।\nदीर्घमुष्णं च निःश्वस्य चिन्तयित्वा पुनःपुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2046087, "chapter_id": 2024, "verse_number": "६-७३-८", "content_sanskrit": "धनुः प्रपीड्य वामेन करेणामित्रकर्शनः ।\nगाण्डीवधन्वा संक्रुद्धः शितान्सन्नतपर्वणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2046088, "chapter_id": 2024, "verse_number": "६-७३-९", "content_sanskrit": "जीवितान्तकरान्घोरान्समादत्त शिलीमुखान्।\nतैस्तूर्णं समरेऽविध्यद्रौणिं बलवतां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2046089, "chapter_id": 2024, "verse_number": "६-७३-१०", "content_sanskrit": "तस्य ते कवचं भित्त्वा पपुः शोणितमाहवे।\nन विव्यथे च निर्भिन्नो द्रौणिर्गाण्डीवधन्वना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2046090, "chapter_id": 2024, "verse_number": "६-७३-११", "content_sanskrit": "तथैव च शरान्द्रौणिः प्रविमुञ्चन्नविह्वलः ।\nतस्थौ च समरे राजंस्त्रातुमिच्छन्महाव्रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2046091, "chapter_id": 2024, "verse_number": "६-७३-१२", "content_sanskrit": "तस्य तत्सुमहत्कर्म शशंसुः कुरुसत्तमाः ।\nयत्कृष्णाभ्यां समेताभ्यामभ्यापतत संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2046092, "chapter_id": 2024, "verse_number": "६-७३-१३", "content_sanskrit": "स हि नित्यमनीकेषु युध्यतेऽभयमास्तितः।\nअस्त्रग्रामं ससंहारं द्रोणात्प्राप्य सुदुर्लभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2046093, "chapter_id": 2024, "verse_number": "६-७३-१४", "content_sanskrit": "ममैष आचार्यसुतो द्रोणस्यापि प्रियः सुतः ।\nब्राह्मणश्च विशेषेण माननीयो ममेति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2046094, "chapter_id": 2024, "verse_number": "६-७३-१५", "content_sanskrit": "समास्थआय मतिं वीरो बीभत्सुः सत्रुतापनः ।\nकृपां चक्रे रथश्रेष्ठो भारद्वाजसुतं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2046095, "chapter_id": 2024, "verse_number": "६-७३-१६", "content_sanskrit": "द्रौणिं त्यक्त्वा ततो युद्धे कौन्तेयः श्वेतवाहनः।\nयुयुधे तावकान्निघ्नंस्त्वरमाणः पराक्रमी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2046096, "chapter_id": 2024, "verse_number": "६-७३-१७", "content_sanskrit": "दुर्योधनस्तु दशभिर्गार्ध्रपत्रैः शिलाशितैः ।\nभीमसेनं महेष्वासं रुक्मपुङ्खैः समार्पयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2046097, "chapter_id": 2024, "verse_number": "६-७३-१८", "content_sanskrit": "भीमसेनः सुसंक्रुद्धः परासुकरणं दृढम् ।\nचित्रं कार्मुकमादत्त शरांश्च निशितान्दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2046098, "chapter_id": 2024, "verse_number": "६-७३-१९", "content_sanskrit": "आकर्णप्रहितैस्तीक्ष्णैर्वेगवद्भिरजिह्मगैः।\nअविध्यत्तूर्णमव्यग्रः कुरुराजं महोरसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2046099, "chapter_id": 2024, "verse_number": "६-७३-२०", "content_sanskrit": "तस्य काञ्चनसूत्रस्थः शरैः संछादितो मणिः।\nरराजोरसि खे सूर्यो ग्रहैरिव समावृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2046100, "chapter_id": 2024, "verse_number": "६-७३-२१", "content_sanskrit": "पुत्रस्तु तव तेजस्वी भीमसेनेन ताडित।\nनामृष्यत यथा नागस्तलशब्दं मदोत्कटः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2046101, "chapter_id": 2024, "verse_number": "६-७३-२२", "content_sanskrit": "ततः शरैर्महाराज रुक्मपुङ्खैः शिलाशितैः ।\nभीमं विव्याध संक्रुद्धस्त्रासयानो वरूथिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2046102, "chapter_id": 2024, "verse_number": "६-७३-२३", "content_sanskrit": "तौ युध्यमानौ समरे भृशमन्योन्यविक्षतौ ।\nपुत्रौ ते देवसंकाशौ व्यरोचेतां महाबलौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2046103, "chapter_id": 2024, "verse_number": "६-७३-२४", "content_sanskrit": "चित्रसेनं नरव्याघ्रं सौभद्रः परवीरहा।\nअविध्यद्दशभिर्बाणैः पुरुमित्रं च सप्तभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2046104, "chapter_id": 2024, "verse_number": "६-७३-२५", "content_sanskrit": "सत्यव्रतं च सप्तत्या विद्ध्वा शक्रसमो युधि।\nनृत्यन्निव रणे वीर आर्तिं नः समजीजनत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2046105, "chapter_id": 2024, "verse_number": "६-७३-२६", "content_sanskrit": "तं प्रत्यविध्यद्दशभिश्चित्रसेनः शिलीमुखैः ।\nसत्यव्रतश्च नवभिः पुरुमित्रश्च सप्तभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2046106, "chapter_id": 2024, "verse_number": "६-७३-२७", "content_sanskrit": "स विद्धो विक्षरन्रक्तं शत्रुसंवारणं महत्।\nचिच्छेद चित्रसेनस्य चित्रं कार्मुकमार्जुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2046107, "chapter_id": 2024, "verse_number": "६-७३-२८", "content_sanskrit": "भित्त्वा चास्य तनुत्राणं शरेणोरस्यताडयत् ।\nततस्ते तावका वीरा राजपुत्रा महारथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2046108, "chapter_id": 2024, "verse_number": "६-७३-२९", "content_sanskrit": "समेत्य युधि संरब्धा विव्यधुर्निशितैः शरैः।\nतांश्च सर्वाञ्शरैस्तीक्ष्णैर्जघान परमास्त्रवित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2046109, "chapter_id": 2024, "verse_number": "६-७३-३०", "content_sanskrit": "तस्य दृष्ट्वा तु तत्कर्म परिवव्रुः सुतास्तव।\nदहन्तं समरे सैन्यं वने कक्षं यथोल्बणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2046110, "chapter_id": 2024, "verse_number": "६-७३-३१", "content_sanskrit": "अपेतशिशिरे काले समिद्धमिव पावकम् ।\nअत्यरोचत सौभद्रस्तव सैन्यानि नाशयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2046111, "chapter_id": 2024, "verse_number": "६-७३-३२", "content_sanskrit": "तत्तस्य चरितं दृष्ट्वा पौत्रस्तव विशांपते ।\nलक्ष्मणोऽभ्यपतत्तूर्णं सात्तीपुत्रमाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2046112, "chapter_id": 2024, "verse_number": "६-७३-३३", "content_sanskrit": "अभिमन्युस्तु संक्रुद्धो लक्ष्मणं शुभलक्षणम् ।\nविव्याध निशितैः षङभिः सारथिं च त्रिभिः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2046113, "chapter_id": 2024, "verse_number": "६-७३-३४", "content_sanskrit": "तथैव लक्ष्मणो राजन्सौभद्रं निशितैः शरैः।\nअविध्यत महाराज तदद्भुतमिवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2046114, "chapter_id": 2024, "verse_number": "६-७३-३५", "content_sanskrit": "तस्याश्वांश्चतुरो हत्वा सारथिं च महाबलः ।\nअभ्यद्रवत सौभद्रो लक्ष्मणं निशितैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2046115, "chapter_id": 2024, "verse_number": "६-७३-३६", "content_sanskrit": "हताश्वे तु रथे तिष्ठँल्लक्ष्मणः परवीरहा ।\nशक्तिं चिक्षेप संक्रुद्धः सौभद्रस्य रथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2046116, "chapter_id": 2024, "verse_number": "६-७३-३७", "content_sanskrit": "तामापतन्तीं सहसा घोररूपां दुरासदाम्।\nअभिमन्युः शरैस्तीक्ष्णैश्चिच्छेद भुजगोपमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2046117, "chapter_id": 2024, "verse_number": "६-७३-३८", "content_sanskrit": "ततः स्वरथमारोप्य लक्ष्मणं गौतमस्तदा।\nअपोवाह रथेनाजौ सर्वसैन्यस्य पश्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2046118, "chapter_id": 2024, "verse_number": "६-७३-३९", "content_sanskrit": "ततः समाकुले तस्मिन्वर्तमाने महाभये ।\nअभ्यद्रवञ्जिघांसन्तः परस्परवधैषिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2046119, "chapter_id": 2024, "verse_number": "६-७३-४०", "content_sanskrit": "तावकाश्च महेष्वासाः पाण्डवाश्च महारथाः ।\nजुह्वन्तः समरे प्राणान्निजघ्नुरितरेतरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2046120, "chapter_id": 2024, "verse_number": "६-७३-४१", "content_sanskrit": "मुक्तकेशा विकवचा विरथाश्छिन्नकार्मुकाः ।\nबाहुभइः समयुध्यन्त सृञ्जयाः कुरुभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2046121, "chapter_id": 2024, "verse_number": "६-७३-४२", "content_sanskrit": "ततो भीष्मो महाबाहुः पाण्डवानां महात्मनाम् ।\nसेनां जघान संक्रुद्धो दिव्यैरस्त्रैर्महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2046122, "chapter_id": 2024, "verse_number": "६-७३-४३", "content_sanskrit": "हतेश्वरैर्गजैस्तत्र नरैरश्वैश्च पातितैः ।\nरथिभिः सादिभिश्चैव समास्तीर्यत मेदिनी ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2046123, "chapter_id": 2024, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि पञ्चमदिवसयुद्धे त्रिसप्ततितमोऽध्यायः ॥\nMahabharata - Bhishma Parva - Chapter Footnotes\n६-७३-३२ सात्वतीपुत्रं अभिमन्युम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]