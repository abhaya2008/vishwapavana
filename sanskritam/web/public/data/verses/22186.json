[{"id": 7002186000, "chapter_id": 22186, "verse_number": "२३१-१", "content_sanskrit": "पुष्कर उवाच ।\nतिष्ठतो गमने प्रश्ने पुरुषस्य शुभाशुभं ।\nनिवेदयन्ति शकुना देशस्य नगरस्य च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002186001, "chapter_id": 22186, "verse_number": "२३१-२", "content_sanskrit": "सर्वः पापफलो दीप्तो निर्द्दिष्टो दैवचिन्तकैः ।\nशान्तः शुभफलश्चैव दैवज्ञैः समुदाहृतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002186002, "chapter_id": 22186, "verse_number": "२३१-३", "content_sanskrit": "षट्प्रकारा विनिर्दिष्टाः शकुनानाञ्च दीप्तयः ।\nवेलादिग्देशकरणरुतजातिविभेदतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002186003, "chapter_id": 22186, "verse_number": "२३१-४", "content_sanskrit": "पूर्वा पूर्वा च विज्ञेया सा तेषां बलवत्तरा ।\nदिवाचरो रात्रिचरस्तथा रात्रौ दिवाचरः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002186004, "chapter_id": 22186, "verse_number": "२३१-५", "content_sanskrit": "क्रूरेषु दीप्ता विज्ञेया ऋक्षलग्नग्रहादिषु ।\nधूमिता सा तु विज्ञेया याङ्गमिष्यति भास्करः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002186005, "chapter_id": 22186, "verse_number": "२३१-६", "content_sanskrit": "यस्यां स्थितः सा ज्वलिता मुक्ता चाङ्गारिणी मता ।\nएतास्तिस्रः स्मृता दीप्ताः पञ्च शान्तास्तथापराः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002186006, "chapter_id": 22186, "verse_number": "२३१-७", "content_sanskrit": "दीप्तायान्दिशि दिग्दीप्तं शकुनं परिकीर्त्तितं ।\nग्रामेऽरण्या वने ग्राम्यास्तथा निन्दितपादपः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002186007, "chapter_id": 22186, "verse_number": "२३१-८", "content_sanskrit": "देशे चैवाशुभे ज्ञेयो देशदीप्तो द्विजोत्तमः ।\nक्रियादीप्तो विनिर्द्दिष्टः स्वजात्यनुचितक्रियः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002186008, "chapter_id": 22186, "verse_number": "२३१-९", "content_sanskrit": "रुतदीप्तश्च कथितो भिन्नभैरवनिस्वनः ।\nजातिदीप्तस्तथा ज्ञेयः केवलं मांसभोजनः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002186009, "chapter_id": 22186, "verse_number": "२३१-१०", "content_sanskrit": "दीप्ताच्छान्तो विनिर्दिष्टः सर्वैर्भेदैः प्रयत्नतः ।\nमिश्रैर्मिश्रो विनिर्दिष्टस्तस्य वाच्यं फलाफलं ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002186010, "chapter_id": 22186, "verse_number": "२३१-११", "content_sanskrit": "गोश्वोष्ट्रगर्द्दभश्वानः सारिका गृहगोधिका ।\nचटका भासकूर्माद्याः कथिता ग्रामवासिनः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002186011, "chapter_id": 22186, "verse_number": "२३१-१२", "content_sanskrit": "अजाविशुकनागेन्द्राः कोलो महिषवायसौ ।\nग्राम्यारण्या विनिर्द्दिष्टाः सर्वेऽन्ये वनगोचराः१ ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002186012, "chapter_id": 22186, "verse_number": "२३१-१३", "content_sanskrit": "मार्जारकुक्कुटौ ग्राम्यौ तौ चैव वनगोचरौ ।\nतयोर्भवति विज्ञानं नित्यंक वै रूपभेदतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002186013, "chapter_id": 22186, "verse_number": "२३१-१४", "content_sanskrit": "गोकर्णशिखिचक्राह्वखरहारीतवायसाः ।\nकुलाहकुक्कुभश्येनफेरुखञ्जनवानराः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002186014, "chapter_id": 22186, "verse_number": "२३१-१५", "content_sanskrit": "शतघ्नचटकश्यामचासश्येनकपिञ्जलाः ।\nतित्तिरिः शतपत्रञ्च कपोतश्च तथा त्रयः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002186015, "chapter_id": 22186, "verse_number": "२३१-१६", "content_sanskrit": "खञ्जरीटकदात्यूहशुकराजीवकुक्कुटाः ।\nभारद्वाजश्च सारङ्ग इति ज्ञेया दिवाचराः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002186016, "chapter_id": 22186, "verse_number": "२३१-१७", "content_sanskrit": "वागुर्युलूकशरभक्रौञ्चाः शशककच्छपाः ।\nलोमासिकाः पिङ्गलिकाः कथिता रात्रिगोचराः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002186017, "chapter_id": 22186, "verse_number": "२३१-१८", "content_sanskrit": "हंसाश्च मृगमार्जारनकुलर्क्षभुजङ्गमाः ।\nवृक्कारिसिंहव्याघ्रोष्ट्रग्रामशूकरमानुषाः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002186018, "chapter_id": 22186, "verse_number": "२३१-१९", "content_sanskrit": "श्वाविद्वृषभगोमायुवृककोकिलसारसाः ।\nतुरङ्गकौपीननरा गोधा ह्युभयचारिणः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002186019, "chapter_id": 22186, "verse_number": "२३१-२०", "content_sanskrit": "बलप्रस्थानयोः सर्वे पुरस्तात्सङ्घचारिणः ।\nजथावहा विनिर्दिष्टाः पश्चान्निधनकारिणः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002186020, "chapter_id": 22186, "verse_number": "२३१-२१", "content_sanskrit": "गृहाद्गम्य यदा चासो व्याहरेत् पुरतः स्थितः ।\nनृपावमानं वदति वामः कलहभोजने ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002186021, "chapter_id": 22186, "verse_number": "२३१-२२", "content_sanskrit": "याने तद्दर्शनं शस्तं सव्यमङ्गस्य वाप्यथ ।\nचौरैर्मोषमथाख्याति मयूरो भिन्ननिस्वनः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002186022, "chapter_id": 22186, "verse_number": "२३१-२३", "content_sanskrit": "प्रयातस्याग्रतो राम मृगः प्राणहरो भवेत् ।\nऋक्षाखुजम्बुकव्याघ्रसिंहमार्जारगर्दभाः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002186023, "chapter_id": 22186, "verse_number": "२३१-२४", "content_sanskrit": "प्रतिलोमास्तथा राम खरश्च विकृतस्वनः ।\nवामः कपिञ्जलः श्रेष्ठस्तथा दक्षिणसंस्थितः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002186024, "chapter_id": 22186, "verse_number": "२३१-२५", "content_sanskrit": "पृष्ठतो निन्दितफलस्तित्तिरिस्तु न शस्यते ।\nएणा वराहाः पृषता वामा भूत्वा तु दक्षिणाः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002186025, "chapter_id": 22186, "verse_number": "२३१-२६", "content_sanskrit": "भचवन्त्यर्थकरा नित्यं विपरीता विगर्हिताः ।\nवृषाश्वजम्बुकव्याघ्राः सिंहमार्जारगर्दभाः२ ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002186026, "chapter_id": 22186, "verse_number": "२३१-२७", "content_sanskrit": "वाञ्छितार्थकरा ज्ञेया दक्षैणाद्वामतो गताः ।\nशिवा श्यामाननाच्छूच्छूः पिङ्गला गृहगोधिका ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002186027, "chapter_id": 22186, "verse_number": "२३१-२८", "content_sanskrit": "शूकरी परपुष्टा च पुन्नामानश्च वामतः ।\nस्त्रीसञ्ज्ञा भासकारूषकपिश्रीकर्णच्छित्कराः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002186028, "chapter_id": 22186, "verse_number": "२३१-२९", "content_sanskrit": "कपिश्रीकर्णपिप्यीका३ रुरुश्येनाश्च दक्षिणाः ।\nजातोक्षाहिशशक्रोडगोधानां कीर्त्तनं शुभं ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002186029, "chapter_id": 22186, "verse_number": "२३१-३०", "content_sanskrit": "ततः सन्दर्शनं नेष्टं प्रतीपं वानरर्क्षंयोः ।\nकार्य्यकृद्बली शकुनः प्रस्थितस्य हि योऽन्वहं ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002186030, "chapter_id": 22186, "verse_number": "२३१-३१", "content_sanskrit": "भवेत्तस्य फलं वाच्यं तदेव दिवसं बुधैः ।\nमत्ता भक्ष्यार्थिनो बाला वैरसक्तास्तथैव च ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002186031, "chapter_id": 22186, "verse_number": "२३१-३२", "content_sanskrit": "सीमान्तमभ्यन्तरिता विज्ञेया निष्फला द्विज ।\nएकद्वित्रिचतुर्भिस्तु शिवा धन्या रुतैर्भवेत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002186032, "chapter_id": 22186, "verse_number": "२३१-३३", "content_sanskrit": "पञ्चभिश्च तथा षड्भिरधन्या परिकीर्त्तिता ।\nसप्तभिश्च तथा धन्या निष्फला परतो भवेत् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002186033, "chapter_id": 22186, "verse_number": "२३१-३४", "content_sanskrit": "नृणां रोमाञ्चजननी वाहनानां भयप्रदा ।\nज्वालानला सूर्य्यमुखी विज्ञेया भयवर्द्धनी ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002186034, "chapter_id": 22186, "verse_number": "२३१-३५", "content_sanskrit": "प्रथमं सारङ्गे दृष्टे शुभे देशे शुभं भवेत् ।\nसंवत्सरं मनुष्यस्य अशुभे च शुभं तथा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002186035, "chapter_id": 22186, "verse_number": "२३१-३६", "content_sanskrit": "तथाविधन्नरः पश्येत्सारङ्गं प्रथमेऽहनि ।\nआत्मनश्च तथात्वेन ज्ञातव्यं वत्सरं फलं ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]