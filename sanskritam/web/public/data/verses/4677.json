[{"id": 2172577, "chapter_id": 4677, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2172578, "chapter_id": 4677, "verse_number": "१", "content_sanskrit": "पतितानि च नीडानि ध्वजांश्चैव महात्मनाम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2172579, "chapter_id": 4677, "verse_number": "२", "content_sanskrit": "रणे विनिहतान् नागान् दृष्ट्वा पत्तींश्च मारिष ।\nआयोधनं चातिघोरं रुद्रस्याक्रीडसन्निभम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2172580, "chapter_id": 4677, "verse_number": "३", "content_sanskrit": "अप्रख्यातिं गतानां तु राज्ञां शतसहस्रशः ।\nकृपाविष्टः कृपो दृष्ट्वा वयःशीलसमन्वितः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2172581, "chapter_id": 4677, "verse_number": "४", "content_sanskrit": "अब्रवीत् तत्र तेजस्वी सोऽभिसृत्य जनाधिपम् ।\nदुर्योधनमनुक्रोशाद् वचनं वचनक्षमः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2172582, "chapter_id": 4677, "verse_number": "", "content_sanskrit": "कृपः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2172583, "chapter_id": 4677, "verse_number": "५", "content_sanskrit": "दुर्योधन निबोधेदं यत् त्वा वक्ष्यामि कौरव ।\nश्रुत्वा कुरु महाराज यदि ते रोचतेऽनघ\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2172584, "chapter_id": 4677, "verse_number": "६", "content_sanskrit": "न युद्धधर्माच्छ्रेयान् वै पन्था राजेन्द्र विद्यते ।\nयं समाश्रित्य युध्यन्ते क्षत्रियाः क्षत्रियर्षभ\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2172585, "chapter_id": 4677, "verse_number": "७", "content_sanskrit": "पुत्रो भ्राता पिता चैव स्वस्रीयो मातुलस्तथा ।\nसम्बन्धिबान्धवाश्चैव योद्धव्याः क्षत्रजीविना\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2172586, "chapter_id": 4677, "verse_number": "८", "content_sanskrit": "वधे चैव परो धर्मः तथाऽधर्मः पलायने ।\nते सुघोरां समापन्ना जीविकां जीवितार्थिनः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2172587, "chapter_id": 4677, "verse_number": "९", "content_sanskrit": "तत्र त्वां नृप वक्ष्यामि किञ्चिदेव हितं वचः ।\nहते भीष्मे हते द्रोणे कर्णे चैव महारथे\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2172588, "chapter_id": 4677, "verse_number": "१०", "content_sanskrit": "जयद्रथे च निहते तव भ्रातृषु चानघ ।\nलक्ष्मणे तव पुत्रे च किं शेषं पर्युपास्महे\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2172589, "chapter_id": 4677, "verse_number": "११", "content_sanskrit": "येषु भारं समासज्य राज्ये मतिमकुर्महि ।\nते सन्त्यज्य तनूर्याताः शूरा ब्रह्मविदां गतिम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2172590, "chapter_id": 4677, "verse_number": "१२", "content_sanskrit": "वयं त्विह विनाभूता गुणवद्भिर्महारथैः ।\nकृपणं वर्तयिष्यामः पातयित्वा नृपान् बहून्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2172591, "chapter_id": 4677, "verse_number": "१३", "content_sanskrit": "सर्वैरपि च जीवद्भिः बीभत्सुर्न पराजितः ।\nकृष्णो नेता महाबाहुः देवैरपि दुरासदः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2172592, "chapter_id": 4677, "verse_number": "१४", "content_sanskrit": "इन्द्रकार्मुकवज्राभमिन्द्रकेतुमिवोच्छ्रितम् ।\nवानरं केतुमासाद्य सञ्चचाल महाचमूः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2172593, "chapter_id": 4677, "verse_number": "१५", "content_sanskrit": "सिंहनादेन भीमस्य पाञ्चजन्यस्वनेन च ।\nगाण्डीवस्य च निर्घोषात् सम्मुह्यन्ते मनांसि नः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2172594, "chapter_id": 4677, "verse_number": "१६", "content_sanskrit": "चलन्तीव महाविद्युन्मुष्णन्ती नयनप्रभाम् ।\nअलातमिव चाविद्धं गाण्डीवं समदृश्यत\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2172595, "chapter_id": 4677, "verse_number": "१७", "content_sanskrit": "जाम्बूनदविचित्रं यद्धूयमानं महद्धनुः ।\nदृश्यते दिक्षु सर्वासु विद्युदभ्रगणेष्विव\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2172596, "chapter_id": 4677, "verse_number": "१८", "content_sanskrit": "उह्यमानाश्च कृष्णेन वायुनेव बलाहकाः ।\nजाम्बूनदविचित्राङ्गा वहन्त्येवार्जुनं हयाः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2172597, "chapter_id": 4677, "verse_number": "१९", "content_sanskrit": "तावकं तद्बलं सर्वमर्जुनोऽस्त्रविदां वरः ।\nगहनं शिशिरापाये ददाहाग्निरिवोत्थितः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2172598, "chapter_id": 4677, "verse_number": "२०", "content_sanskrit": "गाहमानामनीकानि महेन्द्रसदृशं प्रभुम् ।\nधनञ्जयमपश्याम चतुर्दन्तमिव द्विपम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2172599, "chapter_id": 4677, "verse_number": "२१", "content_sanskrit": "विक्षोभयन्तं सेनां वै त्रासयन्तं च पार्थिवान् ।\nधनञ्जयमपश्याम नलिनीष्विव कुञ्जरम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2172600, "chapter_id": 4677, "verse_number": "२२", "content_sanskrit": "त्रासयन्तं तथा योधान् रथघोषेण पाण्डवम् ।\nभूय एव हि पश्यामः सिंहं मृगगणा इव\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2172601, "chapter_id": 4677, "verse_number": "२३", "content_sanskrit": "सर्वलोकमहेष्वासौ वृषभौ सर्वधन्विनाम् ।\nआमुक्तकवचौ कृष्णौ लोकमध्ये विरेजतुः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2172602, "chapter_id": 4677, "verse_number": "२४", "content_sanskrit": "अद्य सप्तदशाहानि वर्तमानस्य भारत ।\nसङ्ग्रामस्यातिघोरस्य युध्यतां चापि नो युधि\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2172603, "chapter_id": 4677, "verse_number": "२५", "content_sanskrit": "वायुनेव विधूतानि तवानीकानि गच्छता ।\nशरदम्भोदजालानि व्यशीर्यन्त बलानि नः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2172604, "chapter_id": 4677, "verse_number": "२६", "content_sanskrit": "तां नावमिव पर्यस्तां भ्रान्तवातां महार्णवे ।\nतव सेनां महाराज सव्यसाची व्यकम्पयत्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2172605, "chapter_id": 4677, "verse_number": "२७", "content_sanskrit": "क्व नु ते सूतपुत्रोऽभूत् क्व नु द्रोणः सहात्मजः ।\nअहं क्व नु क्व चात्मा ते हार्दिक्यश्च तथा क्व नु\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2172606, "chapter_id": 4677, "verse_number": "२८", "content_sanskrit": "दुःशासनश्च भ्राता ते भ्रातृभिः सहितः क्व नु\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2172607, "chapter_id": 4677, "verse_number": "२९", "content_sanskrit": "बाणगोचरसम्प्राप्तं प्रेक्ष्य चैव जयद्रथम् ।\nसम्बन्धिनस्ते भ्रातॄंश्च सहायान् मातुलांस्तथा\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2172608, "chapter_id": 4677, "verse_number": "३०", "content_sanskrit": "सर्वक्षत्रस्य मिषतो लोकानाक्रम्य मूर्धनि ।\nजयद्रथो हतो राजन् किं नु शेषमुपास्महे\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2172609, "chapter_id": 4677, "verse_number": "३१", "content_sanskrit": "को वेह स पुमानस्ति यो विजेष्यति पाण्डवम् ।\nतस्य चास्त्राणि दिव्यानि विविधानि महात्मनः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2172610, "chapter_id": 4677, "verse_number": "३२", "content_sanskrit": "गाण्डीवस्य च निर्घोषो वीर्याणि हरते हि नः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2172611, "chapter_id": 4677, "verse_number": "३३", "content_sanskrit": "नष्टचन्द्रा यथा रात्रिः सेनेयं हतनायका ।\nनागनक्रझषाकीर्णा नदी विलुलिता यथा\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2172612, "chapter_id": 4677, "verse_number": "३४", "content_sanskrit": "ध्वनिज्यां हतनेत्रायां यथेष्टं श्वेतवाहनः ।\nचरिष्यति महाराज कक्षेऽग्निरिव स ज्वलन्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2172613, "chapter_id": 4677, "verse_number": "३५", "content_sanskrit": "सात्यकेश्चैव यो वेगो भीमसेनस्य चोभयोः ।\nदारयेत गिरीन् सर्वान् शोषयेतापि सागरान्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2172614, "chapter_id": 4677, "verse_number": "३६", "content_sanskrit": "उवाच वाक्यं यद् भीमः सभामध्ये विशाम्पते ।\nकृतं तत् सफलं सर्वं भूयश्चैव करिष्यति\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2172615, "chapter_id": 4677, "verse_number": "३७", "content_sanskrit": "प्रमुखस्थे तदा कर्णे बलं पाण्डवरक्षितम् ।\nदुरासदं तथा गुप्तं व्यूढं गाण्डीवधन्विना\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2172616, "chapter_id": 4677, "verse_number": "३८", "content_sanskrit": "युष्माभिस्तानि चीर्णानि यान्यसाधूनि साधुषु ।\nअकारणकृतान्येव तेषां वः फलमागतम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2172617, "chapter_id": 4677, "verse_number": "३९", "content_sanskrit": "आत्मनोऽर्थे त्वया लोको यत्नतः सर्व आहृतः ।\nस ते संशयितस्तात आत्मा च भरतर्षभ\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2172618, "chapter_id": 4677, "verse_number": "४०", "content_sanskrit": "रक्ष दुर्योधनात्मानम् आत्मा सर्वस्य भाजनम् ।\nभिन्ने हि भाजने तात दिशो गच्छति तद्गतम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2172619, "chapter_id": 4677, "verse_number": "४१", "content_sanskrit": "हीयमानेन चेत् सन्धिः पर्येष्टव्यः समेन च ।\nविग्रहो वर्धमानेन नीतिरेषा बृहस्पतेः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2172620, "chapter_id": 4677, "verse_number": "४२", "content_sanskrit": "ते वयं पाण्डुपुत्रेभ्यो हीनाः स्म बलशक्तितः ।\nअत्र तैः पाण्डवैः सार्धं सन्धिं मन्ये क्षमं प्रभो\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2172621, "chapter_id": 4677, "verse_number": "४३", "content_sanskrit": "न जानीते हि यः श्रेयः श्रेयसश्चावमन्यते ।\nस क्षिप्रं भ्रश्यते राज्यान्न च श्रेयोऽनुविन्दति\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2172622, "chapter_id": 4677, "verse_number": "४४", "content_sanskrit": "प्रणिपत्य हि राजानं राज्यं यदि लभेमहि ।\nश्रेयः स्यान्न तु मौर्व्येण राजन् गन्तुं पराभवम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2172623, "chapter_id": 4677, "verse_number": "४५", "content_sanskrit": "वैचित्रवीर्यवचनात् कृपाशीलो युधिष्ठिरः ।\nविनियुञ्जीत राज्ये त्वां गोविन्दवचनेन च\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2172624, "chapter_id": 4677, "verse_number": "४६", "content_sanskrit": "अजातशत्रुः कौरव्यो गुरुशुश्रूषणे रतः ।\nधृतराष्ट्रस्य वचनं नावमंस्यति धार्मिकः ।\nकुर्वन्ति भ्रातरश्चास्य वचनं नात्र संशयः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2172625, "chapter_id": 4677, "verse_number": "४७", "content_sanskrit": "यद्यद् ब्रूयाद् हृषीकेशो राजानमपराजितम् ।\nअर्जुनो भीमसेनश्च सर्वे कुर्युरसंशयम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2172626, "chapter_id": 4677, "verse_number": "४८", "content_sanskrit": "नातिक्रामति तत् कृष्णो वचनं कौरवस्य तु ।\nधृतराष्ट्रस्य मन्येऽहं नापि कृष्णस्य पाण्डवः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2172627, "chapter_id": 4677, "verse_number": "४९", "content_sanskrit": "एतत् क्षेममहं मन्ये तव पार्थैरविग्रहम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2172628, "chapter_id": 4677, "verse_number": "५०", "content_sanskrit": "नैतद् ब्रवीमि कार्पण्यान्न प्राणपरिरक्षणात् ।\nपथ्यं राजन् ब्रवीमि त्वां तत् परासुः स्मरिष्यसि\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2172629, "chapter_id": 4677, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2172630, "chapter_id": 4677, "verse_number": "समाप्तिः", "content_sanskrit": "इति वृद्धो विलप्यैतत् कृपः शारद्वतो वचः ।\nदीर्घमुष्णं च निःश्वस्य शुशोच च मुमोह ह\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2172631, "chapter_id": 4677, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशल्यपर्वणि चतुर्थोऽध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2172632, "chapter_id": 4677, "verse_number": "४", "content_sanskrit": "शल्यवधपर्वणि चतुर्थोऽध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]