[{"id": 7003561000, "chapter_id": 23561, "verse_number": "२०१-१", "content_sanskrit": "अथ राक्षसकिंकरयुद्धम् ।\nऋषिपुत्र उवाच ।\nततस्ते सहिताः सर्वे चान्योऽन्याभिरताः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003561001, "chapter_id": 23561, "verse_number": "२०१-२", "content_sanskrit": "नानावेषधरा दूताः कृताञ्जलिपुटास्तदा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003561002, "chapter_id": 23561, "verse_number": "२०१-३", "content_sanskrit": "दूता ऊचुः ।\nवयं श्रान्ताश्च क्षीणाश्च ह्यन्यान् योजितुमर्हसि ।\nवयमन्यत्करिष्यामः स्वामिन्कार्यं सुदुष्करम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003561003, "chapter_id": 23561, "verse_number": "२०१-४", "content_sanskrit": "अन्ये हि तावत्तत्कुर्युर्यथेष्टं तव सुव्रत ।\nभगवन्स्म परिक्लिष्टाः त्राहि नः परमेश्वर ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003561004, "chapter_id": 23561, "verse_number": "२०१-५", "content_sanskrit": "ततो विवृत्तरक्ताक्षस्तेन वाक्येन रोषितः ।\nविनिःश्वस्य यथा नागो ह्यपश्यत्सर्वतो दिशम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003561005, "chapter_id": 23561, "verse_number": "२०१-६", "content_sanskrit": "अदूरे दृष्टवान्कंचित्पुरुषं स ह्यनाकृतिम् ।\nस तु वेगेन सम्प्राप्त इङ्गितज्ञो दुरात्मवान् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003561006, "chapter_id": 23561, "verse_number": "२०१-७", "content_sanskrit": "निःसृतः स च रोषेण चित्रगुप्तेन धीमता ।\nततः स त्वरितं गत्वा मन्देहा नाम राक्षसाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003561007, "chapter_id": 23561, "verse_number": "२०१-८", "content_sanskrit": "नानारूपधरा घोरा नानाभरणभूषिताः ।\nविनाशाय महासत्वो यत्र तिष्ठन्महायशाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003561008, "chapter_id": 23561, "verse_number": "२०१-९", "content_sanskrit": "चित्रगुप्तो महाबाहुः सर्वलोकार्थचिन्तकः ।\nसमः सर्वेषु भूतेषु भूतानां च समादिशत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003561009, "chapter_id": 23561, "verse_number": "२०१-१०", "content_sanskrit": "ततस्ते विविधाकारा राक्षसा पिशिताशनाः ।\nउपरुह्य तथा सर्वे मातंगांश्च हयं तथा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003561010, "chapter_id": 23561, "verse_number": "२०१-११", "content_sanskrit": "बद्धगोधाङ्गुलित्राणा नानायुधधरास्तथा ।\nअग्रतः किंकराः कृत्वा तिष्ठन्पादाभिवन्दनम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003561011, "chapter_id": 23561, "verse_number": "२०१-१२", "content_sanskrit": "ब्रुवन्तश्च पुनर्हृष्टाः शीघ्रमाज्ञापय प्रभो ।\nतव सन्देशकर्त्तारः कस्य कृन्तामजीवितम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003561012, "chapter_id": 23561, "verse_number": "२०१-१३", "content_sanskrit": "तेषां तद्वचनं श्रुत्वा चित्रगुप्तो ह्यभाषत ।\nरोषगद्गदया वाचा निःश्वसन्वै   मुहुर्मुहुः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003561013, "chapter_id": 23561, "verse_number": "२०१-१४", "content_sanskrit": "भो भो मन्देहका वीराः मम चित्तानुपालकाः ।\nएतान्बध्नीत गृह्णीत भूतराक्षसपुंगवाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003561014, "chapter_id": 23561, "verse_number": "२०१-१५", "content_sanskrit": "एवं हत्वा च बद्ध्वा च ह्यागच्छत पुनर्यथा ।\nह्न्तारः सर्वभूतानां कृतज्ञा दृढ विक्रमा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003561015, "chapter_id": 23561, "verse_number": "२०१-१६", "content_sanskrit": "हत्वा वै पापकानेतान्मम विप्रियकारिणः ।\nएतच्छ्रुत्वा वचस्तस्य वचनं चेदमब्रुवन् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003561016, "chapter_id": 23561, "verse_number": "२०१-१७", "content_sanskrit": "राक्षसा ऊचुः ।\nश्रान्ता वा क्षुधिता वापि दुःखिता वा तपोधनाः ।\nअमात्या एव ज्ञातव्या भृत्याः शतसहस्रशः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003561017, "chapter_id": 23561, "verse_number": "२०१-१८", "content_sanskrit": "एते वधार्थं निर्दिष्टास्त्वयैव च महात्मना ।\nन युक्तं विविधाकारा ह्यस्माकं नाशनाय वै ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003561018, "chapter_id": 23561, "verse_number": "२०१-१९", "content_sanskrit": "यथा ह्येते समुत्पन्नाः सर्वधर्मानुचिन्तकाः ।\nतथा वयं समुत्पन्नास्तदर्थं हि भवानपि ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003561019, "chapter_id": 23561, "verse_number": "२०१-२०", "content_sanskrit": "मा च मिथ्या प्रतिज्ञातं धर्मिष्ठस्य भवत्विति ।\nअस्माकं विग्रहे वीर मुच्यन्तां यदि मन्यसे ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003561020, "chapter_id": 23561, "verse_number": "२०१-२१", "content_sanskrit": "परित्रायस्व नो वीर किंकराणां महाबलान् ।\nहन्यमानान्हि रक्षोभिरस्मानद्य रणाजिरे ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003561021, "chapter_id": 23561, "verse_number": "२०१-२२", "content_sanskrit": "एवमुक्त्वा ततो घोरा व्याधयः कामरूपिणः ।\nसन्नद्धास्त्वरितं शूरा भीमरूपा भयानकाः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003561022, "chapter_id": 23561, "verse_number": "२०१-२३", "content_sanskrit": "गजैरन्ये तथा चाश्वै रथैश्चापि महाबलाः ।\nकण्टकैस्तुरगैर्हंसैरन्ये सिंहैस्तथापरे ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003561023, "chapter_id": 23561, "verse_number": "२०१-२४", "content_sanskrit": "मृगैः सृगालैर्महिषैर्व्याघ्रैर्मेषैस्तथापरे।\nगृध्रैः श्येनैर्मयूरैश्च सर्पगर्द्दभकुक्कुटैः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003561024, "chapter_id": 23561, "verse_number": "२०१-२५", "content_sanskrit": "एवं वाहनसंयुक्ता नानाप्रहरणोद्यताः ।\nसमागता महासत्त्वा अन्योन्यमभिकांक्षिणः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003561025, "chapter_id": 23561, "verse_number": "२०१-२६", "content_sanskrit": "तूर्यक्ष्वेडितसंघुष्टैर्बलितास्फोटितैरपि ।\nजयार्थिनो द्रुतं वीराश्चालयन्तश्च मेदिनीम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003561026, "chapter_id": 23561, "verse_number": "२०१-२७", "content_sanskrit": "ततः समभवद्युद्धं तस्मिंस्तमसि सन्तते ।\nमुकुटैरंगदैश्चित्रैः केयूरैः पट्टिशासिकैः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003561027, "chapter_id": 23561, "verse_number": "२०१-२८", "content_sanskrit": "सकुण्डलैः शिरोभिश्च भ्राजते वसुधातलम् ।\nबहुभिश्च सकेयूरैश्छत्रैश्च मणिभूषणैः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003561028, "chapter_id": 23561, "verse_number": "२०१-२९", "content_sanskrit": "शूल शक्तिप्रहारैश्च यष्टितोमरपट्टिशैः ।\nअसिखड्गप्रहारैश्च बलप्राणसमीरितैः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003561029, "chapter_id": 23561, "verse_number": "२०१-३०", "content_sanskrit": "अभवद्दारुणं युद्धं तुमुलं लोमहर्षणम् ।\nनखैर्दन्तैश्च पादैश्च तेऽन्योऽन्यमभिजघ्निरे ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003561030, "chapter_id": 23561, "verse_number": "२०१-३१", "content_sanskrit": "बाहुभिः समनुप्राप्तः केशाकेशि ततः परम् ।\nअयुक्तमतुलं युद्धं तेषां वै समजायत ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003561031, "chapter_id": 23561, "verse_number": "२०१-३२", "content_sanskrit": "ततस्ते राक्षसा भग्ना दूतैर्घोरपराक्रमैः ।\nदेहि देहि वदन्त्येव भिन्धि गृह्णीष्व तिष्ठ च ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003561032, "chapter_id": 23561, "verse_number": "२०१-३३", "content_sanskrit": "वध्यमानाः पिशाचास्ते ये निवृत्ता रणार्दिताः ।\nआहूयन्त प्रतिभयात्क्रोधसंरक्तलोचनाः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003561033, "chapter_id": 23561, "verse_number": "२०१-३४", "content_sanskrit": "तिष्ठ तिष्ठ क्व यासीति न गच्छामि दृढो भव ।\nमया मुक्तमिदं शस्त्रं तव देहविनाशनम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003561034, "chapter_id": 23561, "verse_number": "२०१-३५", "content_sanskrit": "किन्तु मूढ त्वया शस्त्रं न मुक्तं मे रुजाकरम् ।\nमया क्षिप्तास्तु इषवः प्रतीच्छ क्व पलायसे ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003561035, "chapter_id": 23561, "verse_number": "२०१-३६", "content_sanskrit": "किं त्वं वदसि दुर्बुद्धे एषोऽहं पारगो रणे ।\nमम बाहु विमुक्तस्तु यदि जीवस्यतो वद ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003561036, "chapter_id": 23561, "verse_number": "२०१-३७", "content_sanskrit": "तत्र ते सहसा घोरा राक्षसाः पिशिताशनाः ।\nमन्देहा नाम नाम्ना ते वध्यमानाः सहस्रशः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003561037, "chapter_id": 23561, "verse_number": "२०१-३८", "content_sanskrit": "ततो भग्ना यदा ते तु राक्षसाः कामरूपिणः ।\nप्रत्यपद्यन्त ते मायां तामसीं तमसावृताः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003561038, "chapter_id": 23561, "verse_number": "२०१-३९", "content_sanskrit": "अदृश्याश्चैव दृश्याश्च तद्बलं तमसावृताः ।\nततस्ते शरणं जग्मुर्ज्वरं परमभीषणम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003561039, "chapter_id": 23561, "verse_number": "२०१-४०", "content_sanskrit": "शूलपाणिं विरूपाक्षं सर्वप्राणिप्रणाशनम् ।\nमन्देहा नाम नाम्ना वै राक्षसाः पिशिताशनाः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003561040, "chapter_id": 23561, "verse_number": "२०१-४१", "content_sanskrit": "खादन्ति चैव घ्नन्ति स्म चित्रगुप्तेन चोदिताः ।\nव्याधीनां     च सहस्राणि दूतानां च महाबलाः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003561041, "chapter_id": 23561, "verse_number": "२०१-४२", "content_sanskrit": "वयमद्य महाभाग त्रायस्व जगतः पते ।\nततस्तेषां वचः श्रुत्वा दूतानां  कामरूपिणाम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003561042, "chapter_id": 23561, "verse_number": "२०१-४३", "content_sanskrit": "ज्वरः क्रुद्धो महातेजा योधानां तु सहस्रशः ।\nकालो मुण्डः केकराक्षो लोहयष्टिपरिग्रहः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003561043, "chapter_id": 23561, "verse_number": "२०१-४४", "content_sanskrit": "विविधान्सन्दिदेशाऽत्र पुरुषानग्निवर्चसः।\nबद्धाञ्जलिपुटान्सर्वानिदमाह सुरेश्वरः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003561044, "chapter_id": 23561, "verse_number": "२०१-४५", "content_sanskrit": "पच शीघ्रमिमान्पापान्योगेन च बलेन च ।\nततस्ते त्वरितं गत्वा यत्र ते पिशिताशनाः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003561045, "chapter_id": 23561, "verse_number": "२०१-४६", "content_sanskrit": "ज्वराज्ञया च ते सर्वे जीमूतघननिःस्वनाः ।\nबहूंस्ते राक्षसान्घोरान्दर्पोत्सिक्तान् सहस्रशः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003561046, "chapter_id": 23561, "verse_number": "२०१-४७", "content_sanskrit": "बहुशस्त्रप्रहारैश्च शस्त्रैश्च विविधोज्ज्वलैः ।\nतरसा राक्षसा विग्ना रुधिरेण परिप्लुताः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003561047, "chapter_id": 23561, "verse_number": "२०१-४८", "content_sanskrit": "मोचयामास संग्रामं स्वयमेव यमस्ततः ।\nराक्षसान्मोचयित्वाऽथ हन्यमानान्समन्ततः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003561048, "chapter_id": 23561, "verse_number": "२०१-४९", "content_sanskrit": "गत्वा ज्वरं महाभागं विनयात्सान्त्वयन्मुहुः ।\nपूजयन्वै ज्वरं दिव्यं गृह्य हस्ते महायशाः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003561049, "chapter_id": 23561, "verse_number": "२०१-५०", "content_sanskrit": "प्रविवेश गृहं स्वं तु सम्भ्रमेणेदृशेन तु ।\nआननं तु समुत्प्रोश्छ्य संग्रामे स्वेदबिन्दुवत् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003561050, "chapter_id": 23561, "verse_number": "२०१-५१", "content_sanskrit": "धर्मराजोऽथ विश्रान्तं कालभूतं महाज्वरम् ।\nकिंकिं वृत्तमिदं देव व्यापिनस्त्वं महातपाः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003561051, "chapter_id": 23561, "verse_number": "२०१-५२", "content_sanskrit": "रोषायासकरं चैव सर्वलोकनमस्कृतः ।\nअहं त्वं चैव देवेश इमं लोकं चराचरम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003561052, "chapter_id": 23561, "verse_number": "२०१-५३", "content_sanskrit": "शासेमहि यथाकामं यथादृष्टं यथाश्रुतम् ।\nत्वया ग्राह्यो ह्यहं देव मृत्युना च सुसंवृतः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003561053, "chapter_id": 23561, "verse_number": "२०१-५४", "content_sanskrit": "लोकान्सर्वानहं हन्मि सर्वघाती न संशयः ।\nगच्छ गच्छ यथास्थानं युद्धं च त्यजतु स्वयम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003561054, "chapter_id": 23561, "verse_number": "२०१-५५", "content_sanskrit": "राक्षसानां हतास्तत्र षष्टिकोट्यो रणाजिरे।\nअमराश्चाक्षयाश्चैव न हि त्वां प्रापयन्ति वै ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003561055, "chapter_id": 23561, "verse_number": "२०१-५६", "content_sanskrit": "ततो ह्युपरतं युद्धं धर्मराजो यमः स्वयम् ।\nदूतानां चित्रगुप्तेन सख्यमेकमकारयत् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003561056, "chapter_id": 23561, "verse_number": "२०१-५७", "content_sanskrit": "सम्भाषन्ते ततो दूताश्चित्रगुप्तं तथैव च ।\nनियुञ्जस्व मया पूर्वं सर्वकर्माणि जन्तुषु ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003561057, "chapter_id": 23561, "verse_number": "२०१-५८", "content_sanskrit": "स्वकर्मगुणभूतानि ह्यशुभानि शुभानि च।\nरुद्रं दूताः समागम्य चित्रगुप्तस्य पार्श्वतः॥।५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003561058, "chapter_id": 23561, "verse_number": "२०१-५९", "content_sanskrit": "उपस्थानं च कुर्वन्ति कालचिंतकमब्रुवन् ।\nयथा लोका यथा राजा यथा मृत्युः सनातनः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003561059, "chapter_id": 23561, "verse_number": "२०१-६०", "content_sanskrit": "तदैवोत्तिष्ठ तिष्ठेति क्षम्यतां क्षम्यतां प्रभो ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]