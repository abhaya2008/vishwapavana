[{"id": 2102912, "chapter_id": 3231, "verse_number": "१४-८७-१", "content_sanskrit": "वैशम्पायन उवाच।\nसमागतान्वेदविदो राज्ञश्च पृथिवीश्वरान्।\nदृष्ट्वा युधिष्ठिरो राजा भीमसेनमभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2102913, "chapter_id": 3231, "verse_number": "१४-८७-२", "content_sanskrit": "उपयाता नरव्याघ्रा य एते पृथिवीश्वराः।\nएतेषां क्रियतां पूजा पूजार्हा हि नराधिपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2102914, "chapter_id": 3231, "verse_number": "१४-८७-३", "content_sanskrit": "इत्युक्तः स तथा चक्रे नरेन्द्रेण यशस्विना।\nभीमसेनो महातेजा यमाभ्यां सह पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2102915, "chapter_id": 3231, "verse_number": "१४-८७-४", "content_sanskrit": "अथाभ्यगच्छद्गोविन्दो वृष्णिभिः सह धर्मजम्।\nबलदेवं पुरस्कृत्य सर्वप्राणभूतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2102916, "chapter_id": 3231, "verse_number": "१४-८७-५", "content_sanskrit": "युयुधानेन सहितः प्रद्युम्नेन गदेन च।\nनिशठेनाथ सांबेन तथैव कृतवर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2102917, "chapter_id": 3231, "verse_number": "१४-८७-६", "content_sanskrit": "तेषामपि परां पूजां चक्रे भीमो महारथः।\nविविशुस्ते च वेश्मानि रत्नवन्ति च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2102918, "chapter_id": 3231, "verse_number": "१४-८७-७", "content_sanskrit": "युधिष्ठिरसमीपे तु कथान्ते मधुसूदनः।\nअर्जुनं कथयामास बहुसङ्ग्रामकर्शितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2102919, "chapter_id": 3231, "verse_number": "१४-८७-८", "content_sanskrit": "स तं प्रपच्छ कौन्तेयः पुनःपुनररिंदमम्।\nधर्मजः शक्रजं जिष्णुं समाचष्ट जगत्पतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2102920, "chapter_id": 3231, "verse_number": "१४-८७-९", "content_sanskrit": "आगमद्द्वारकावासी समाप्तः पुरुषो नृप।\nयोऽद्राक्षीत्पाण्डवश्रेष्ठ बहुसङ्ग्रामकर्शितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2102921, "chapter_id": 3231, "verse_number": "१४-८७-१०", "content_sanskrit": "समीपे च महाबाहुमाचष्ट च मम प्रभो।\nकुरु कार्याणि कौन्तेय हयमेधार्थसिद्धये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2102922, "chapter_id": 3231, "verse_number": "१४-८७-११", "content_sanskrit": "इत्युक्तः प्रत्युवाचैनं धर्मराजो युधिष्ठिरः।\nदिष्ट्या स कुशली जिष्णुरुपायाति च माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2102923, "chapter_id": 3231, "verse_number": "१४-८७-१२", "content_sanskrit": "यदिदं संदिदेशास्मिन्पाण्डवानां बलाग्रणीः।\nतदाख्यातमिहेच्छामि भवता यदुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2102924, "chapter_id": 3231, "verse_number": "१४-८७-१३", "content_sanskrit": "इत्युक्तो धर्मराजेन वृष्ण्यन्धकपतिस्तदा।\nप्रोवाचेदं वचो वाग्मी धर्मात्मानं युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2102925, "chapter_id": 3231, "verse_number": "१४-८७-१४", "content_sanskrit": "इदमाह महाराज पार्थवाक्यं नरेश्वरः।\nवाच्यो युधिष्ठिरः कृष्ण काले वाक्यमिदं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2102926, "chapter_id": 3231, "verse_number": "१४-८७-१५", "content_sanskrit": "आगमिष्यन्ति राजानः सर्वे वै कौरवर्षभ।\nप्राप्तानां महतां पूजा कार्या ह्येतत्क्षमं हि नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2102927, "chapter_id": 3231, "verse_number": "१४-८७-१६", "content_sanskrit": "इत्येतद्वचनाद्राजा विज्ञाप्यो मम मानद।\nतथा चात्ययिकं न स्याद्यदर्घाहरणेऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2102928, "chapter_id": 3231, "verse_number": "१४-८७-१७", "content_sanskrit": "कर्तुमर्हति तद्राजा भवांश्चाप्यनुमन्यताम्।\nराजद्वेषान्न नश्येयुरिमा राजन्पुनः प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2102929, "chapter_id": 3231, "verse_number": "१४-८७-१८", "content_sanskrit": "इदमन्यच्च कौन्तेय वचः स पुरुषोऽब्रवीत्।\nधनंजयस्य नृपते तन्मे निगदतः शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2102930, "chapter_id": 3231, "verse_number": "१४-८७-१९", "content_sanskrit": "उपयास्यति यज्ञं नो मणलूरपतिर्नृपः।\nपुत्रो मम महातेजा दयितो बभ्रुवाहनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2102931, "chapter_id": 3231, "verse_number": "१४-८७-२०", "content_sanskrit": "तं भवान्मदपेक्षार्थं विधिवत्प्रतिपूजयेत्।\nस तु भक्तोऽनुरक्तश्च मम नित्यमिति प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2102932, "chapter_id": 3231, "verse_number": "१४-८७-२१", "content_sanskrit": "इत्येतद्वचनं श्रुत्वा धर्मराजो युधिष्ठिरः।\nअभिनन्द्यास्य तद्वाक्यमिदं वचनमब्रवीत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2102933, "chapter_id": 3231, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि सप्ताशीतितमोऽध्यायः॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]