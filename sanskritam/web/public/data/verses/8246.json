[{"id": 900001658, "chapter_id": 8246, "verse_number": "3.1", "content_sanskrit": "जनको ह वैदेहो बहुदक्षिणेन यज्ञेनेजे तत्र ह ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900001659, "chapter_id": 8246, "verse_number": "3.2", "content_sanskrit": "अथ हैनं जारत्कारव आर्तभागः पप्रच्छ याज्ञवल्क्येति होवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900001660, "chapter_id": 8246, "verse_number": "3.3", "content_sanskrit": "अथ हैनं भुज्युर्लाह्यायनिः पप्रच्छ याज्ञवल्यक्येति होवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900001661, "chapter_id": 8246, "verse_number": "3.4", "content_sanskrit": "अथ हैनमुषस्तश्चाक्रायणः पप्रच्छ याज्ञवल्क्येति होवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900001662, "chapter_id": 8246, "verse_number": "3.5", "content_sanskrit": "अथ हैनं कहोलः कौषीतकेयः पप्रच्छ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900001663, "chapter_id": 8246, "verse_number": "3.6", "content_sanskrit": "अथ हैनं गार्गी वाचक्नवी प्रपच्छ याज्ञवल्क्येति होवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900001664, "chapter_id": 8246, "verse_number": "3.7", "content_sanskrit": "अथ हैनमुद्दालकः आरुणिः पप्रच्छ याज्ञवल्क्येति होवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900001665, "chapter_id": 8246, "verse_number": "3.8", "content_sanskrit": "अथ ह वाचक्नव्युवाच ब्राह्मणा भगवन्तो..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900001666, "chapter_id": 8246, "verse_number": "3.9", "content_sanskrit": "अथ हैनं विदग्धः शाकल्यः पप्रच्छ कति देवा याज्ञवल्क्येति..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]