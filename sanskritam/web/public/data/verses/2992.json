[{"id": 2093351, "chapter_id": 2992, "verse_number": "१३-१२२-१", "content_sanskrit": "`भीष्म उवाच।\nयास्तु गोमातरस्तस्य कामचारिण्य आगताः।\nसमीपं हि सुमित्रस्य कृतज्ञाः समुपस्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2093352, "chapter_id": 2992, "verse_number": "१३-१२२-२", "content_sanskrit": "अभिप्रशस्य चैवाहुस्तमृषिं पुण्यदर्शनाः।\nगोलोकादागता वेद वृषगोमातरो वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2093353, "chapter_id": 2992, "verse_number": "१३-१२२-३", "content_sanskrit": "सुप्रीताः स्म वरं गृह्ण यमिच्छसि महामुने।\nयद्भि गोषु परां बुद्धिं कृतवानसि नित्यदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2093354, "chapter_id": 2992, "verse_number": "१३-१२२-४x", "content_sanskrit": "सुमित्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2093355, "chapter_id": 2992, "verse_number": "१३-१२२-४", "content_sanskrit": "प्रीतोस्म्यनुगृहीतोस्मि यन्मां गोमातरः शुभाः।\nसुप्रीतमनसः सर्वास्तिष्ठन्ते च वरप्रदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2093356, "chapter_id": 2992, "verse_number": "१३-१२२-५", "content_sanskrit": "भवेद्गोष्वेव मे भक्तिर्यथैवाद्य तथा सदा।\nगोघ्नाश्चैवावसीदन्तु नरा ब्रह्मद्विषश्च ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2093357, "chapter_id": 2992, "verse_number": "१३-१२२-६x", "content_sanskrit": "गोमातर ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2093358, "chapter_id": 2992, "verse_number": "१३-१२२-६", "content_sanskrit": "एवमेतदृषिश्रेष्ठ हितं वदसि नः प्रियम्।\nएहि गच्छ सहाऽस्माभिर्गोलोकमृषिसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2093359, "chapter_id": 2992, "verse_number": "१३-१२२-७x", "content_sanskrit": "सुमित्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2093360, "chapter_id": 2992, "verse_number": "१३-१२२-७", "content_sanskrit": "यूयमिष्टां गतिं यान्तु न ह्यहं गन्तुमुत्सहे।\nइमा गावः समुत्सृज्य तपस्विन्यो मम प्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2093361, "chapter_id": 2992, "verse_number": "१३-१२२-८x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2093362, "chapter_id": 2992, "verse_number": "१३-१२२-८", "content_sanskrit": "तास्तु तस्य वचः श्रुत्वा कपिलानां सुदारुणम्।\nनित्युस्तमृषिमुत्क्षिप्य भार्गवं नभ उद्वहन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2093363, "chapter_id": 2992, "verse_number": "१३-१२२-९", "content_sanskrit": "कलेवरं तु तत्रैव तस्य संन्यस्य मातरः।\nनिष्कृष्य करणं योगादानयन्भार्गवस्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2093364, "chapter_id": 2992, "verse_number": "१३-१२२-१०", "content_sanskrit": "सर्वं चास्य तदाचख्युः कपिलानां विचेष्टितम्।\nयदर्थं हरणं गोभिर्गोलोकं लोकमातरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2093365, "chapter_id": 2992, "verse_number": "१३-१२२-११", "content_sanskrit": "ततस्तु कपिलास्तत्र तस्य दृष्ट्वा कलेवरम्।\nतथाप्रतिज्ञं शृङ्गैश्च खुरैश्चाप्यवचूर्णयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2093366, "chapter_id": 2992, "verse_number": "१३-१२२-१२", "content_sanskrit": "ततः संछिद्य बहुधा भार्गवं नृपसत्तम।\nयुयुर्यत्रेतरा गावस्तच्च सर्वं न्यवेदयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2093367, "chapter_id": 2992, "verse_number": "१३-१२२-१३", "content_sanskrit": "अथ गोमातृभिः शप्तास्ता गावः पृथिवीचराः।\nअमेध्यवदनाः क्षिप्रं भवध्वं ब्रह्मघातकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2093368, "chapter_id": 2992, "verse_number": "१३-१२२-१४", "content_sanskrit": "एवं कृतज्ञा गावो हि यता गोमातरो नृप।\nऋषिश्च प्राप्तवाँल्लोकं गावश्च परिमोक्षिताः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2093369, "chapter_id": 2992, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि द्वाविंशत्यधिकशततमोऽध्यायः॥ १२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]