[{"id": 2040412, "chapter_id": 1895, "verse_number": "५-१४०-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2040413, "chapter_id": 1895, "verse_number": "५-१४०-१", "content_sanskrit": "राजपुत्रैः परिवृतस्तथा भृत्यैश्च सत्तम।\nउपारोप्य रथे कर्णं निर्यातो मधुसूदनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2040414, "chapter_id": 1895, "verse_number": "५-१४०-२", "content_sanskrit": "किमब्रवीद्रथोपस्थे राधेयं परवीरहा ।\nकानि सान्त्वानि गोविन्दः सूतपुत्रे प्रयुक्तवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2040415, "chapter_id": 1895, "verse_number": "५-१४०-३", "content_sanskrit": "उद्यन्मेघस्वनः काले यत्कृष्णः कर्णमब्रवीत्।\nमृदु वा यदि वा तीक्ष्णं तन्ममाचक्ष्व सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2040416, "chapter_id": 1895, "verse_number": "५-१४०-४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2040417, "chapter_id": 1895, "verse_number": "५-१४०-४", "content_sanskrit": "आनुपूर्व्येण वाक्यानि तीक्ष्णानि च मृदूनि च।\nप्रियाणि धर्मयुक्तानि सत्यानि च हितानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2040418, "chapter_id": 1895, "verse_number": "५-१४०-५", "content_sanskrit": "हृदयग्रहणीयानि राधेयं मधुसूदनः ।\nयान्यब्रवीदमेयात्मा तानि मे श्रृणु भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2040419, "chapter_id": 1895, "verse_number": "५-१४०-६x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2040420, "chapter_id": 1895, "verse_number": "५-१४०-६", "content_sanskrit": "उपासितास्ते राधेय ब्राह्मणा वेदपारगाः।\nतत्त्वार्थं परिपृष्टाश्च नियतेनानसूयया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2040421, "chapter_id": 1895, "verse_number": "५-१४०-७", "content_sanskrit": "त्वमेव कर्ण जानासि वेदवादान्सनातनान् ।\nत्वमेव धर्मशास्त्रेषु सूक्ष्मेषु परिनिष्ठितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2040422, "chapter_id": 1895, "verse_number": "५-१४०-८", "content_sanskrit": "कानीनश्च सहोढश्च कन्यायां यश्च जायते ।\nवोढारं पितरं तस्य प्राहुः शास्त्रविदो जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2040423, "chapter_id": 1895, "verse_number": "५-१४०-९", "content_sanskrit": "सोऽसि कर्ण तथाजातः पाण्डोः पुत्रोसि धर्मतः ।\nनिश्चयाद्धर्मशास्त्राणामेहि राजा भविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2040424, "chapter_id": 1895, "verse_number": "५-१४०-१०", "content_sanskrit": "पितृपक्षे च ते पार्था मातृपक्षे च वृष्णयः ।\nद्वौ पक्षावभिजानीहि त्वमेतौ पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2040425, "chapter_id": 1895, "verse_number": "५-१४०-११", "content_sanskrit": "मया सार्धमितो यातमद्य त्वां तात पाण्डवाः ।\nअभिजानन्तु कौन्तेयं पूर्वजातं युधिष्ठिरात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2040426, "chapter_id": 1895, "verse_number": "५-१४०-१२", "content_sanskrit": "पादौ तव ग्रहीष्यन्ति भ्रातरः पञ्च पाण्डवाः।\nद्रौपदेयास्तथा पञ्च सौभद्रश्चापराजितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2040427, "chapter_id": 1895, "verse_number": "५-१४०-१३", "content_sanskrit": "राजानो राजपुत्राश्च पाण्डवार्थे समागताः।\nपादौ तव ग्रहीष्यन्ति सर्वे चान्धकवृष्णयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2040428, "chapter_id": 1895, "verse_number": "५-१४०-१४", "content_sanskrit": "हिरण्मयांश्च ते कुम्भान्राजतान्पार्थिवांस्तथा ।\nओषध्यः सर्वबीजानि सर्वरत्नानि वीरुधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2040429, "chapter_id": 1895, "verse_number": "५-१४०-१५", "content_sanskrit": "राजन्या राजकन्याश्चाप्यानयन्त्वाभिषेचनम् ।\nषष्ठे त्वां च तथा काले द्रौपद्युपगमिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2040430, "chapter_id": 1895, "verse_number": "५-१४०-१६", "content_sanskrit": "अग्निं जुहोतु वै धौम्यः संशितात्मा द्विजोत्तमः ।\nअद्य त्वामभिषिञ्चन्तु चातुर्वैद्या द्विजातयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2040431, "chapter_id": 1895, "verse_number": "५-१४०-१७", "content_sanskrit": "पुरोहितः पाण्डवानां ब्रह्मकर्मण्यवस्थितः।\nतथैव भ्रातरः पञ्च पाण्डवाः पुरुषर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2040432, "chapter_id": 1895, "verse_number": "५-१४०-१८", "content_sanskrit": "द्रौपदेयास्तथा पञ्च पाञ्चालाश्चेदयस्तथा ।\nअहं च त्वाऽभिषेक्ष्यामि राजानं पृथिवीपतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2040433, "chapter_id": 1895, "verse_number": "५-१४०-१९", "content_sanskrit": "युवराजोऽस्तु ते राजा धर्मपुत्रो युधिष्ठिरः।\nगृहीत्वा व्यजनं श्वेतं धर्मात्मा संशितव्रतः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2040434, "chapter_id": 1895, "verse_number": "५-१४०-२०", "content_sanskrit": "उपान्वारोहतु रथं कुन्तीपुत्रो युधिष्ठिरः ।\nछत्रं च ते महाश्वेतं भीमसेनो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2040435, "chapter_id": 1895, "verse_number": "५-१४०-२१", "content_sanskrit": "अभिषिक्तस्य कौन्तेयो धारयिष्यति मूर्धनि ।\nकिङ्किणीशतनिर्घोषं वैयाघ्रपरिवारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2040436, "chapter_id": 1895, "verse_number": "५-१४०-२२", "content_sanskrit": "रथं श्वेतहयैर्युक्तमर्जुनो वाहयिष्यति।\nअभिमन्युश्च ते नित्यं प्रत्यासन्नो भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2040437, "chapter_id": 1895, "verse_number": "५-१४०-२३", "content_sanskrit": "नकुलः सहदेवश्च द्रौपदेयाश्च पञ्च ये।\nपञ्चालाश्चानुयास्यन्ति शिखण्डी च महारथः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2040438, "chapter_id": 1895, "verse_number": "५-१४०-२४", "content_sanskrit": "अहं च त्वाऽनुयास्यामि सर्वे चान्धकवृष्णयः।\nदाशार्हाः परिवारास्ते दाशार्णाश्च विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2040439, "chapter_id": 1895, "verse_number": "५-१४०-२५", "content_sanskrit": "भुङ्क्ष्व राज्यं महाबाहो भ्रातृभिः सह पाण्डवैः ।\nजपैर्होमैश्च संयुक्तो मङ्गलैश्च पृथग्विधैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2040440, "chapter_id": 1895, "verse_number": "५-१४०-२६", "content_sanskrit": "पुरोगमाश्च ते सन्तु द्रविडाः सहकुन्तलैः।\nआन्ध्रास्तालचराश्चैव चूचुपा वेणुपास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2040441, "chapter_id": 1895, "verse_number": "५-१४०-२७", "content_sanskrit": "स्तुवन्तु त्वां च बहुभिः स्तुतिभिः सूतमागधाः ।\nविजयं वसुषेणस्य घोषयन्तु च पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2040442, "chapter_id": 1895, "verse_number": "५-१४०-२८", "content_sanskrit": "स त्वं परिवृतः पार्थैर्नक्षत्रैरिव चन्द्रमाः।\nप्रशाधि राज्यं कौन्तेय कुन्तीं च प्रतिनन्दय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2040443, "chapter_id": 1895, "verse_number": "५-१४०-२९", "content_sanskrit": "मित्राणि ते प्रहृष्यन्तु व्यथन्तु रिपवस्तथा।\nसौभ्रात्रं चैव तेऽद्यास्तु भ्रातृभिः सह पाण्डवैः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2040444, "chapter_id": 1895, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि चत्वारिंशदधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]