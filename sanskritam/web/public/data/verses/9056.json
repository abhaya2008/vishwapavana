[{"id": 5000056000, "chapter_id": 9056, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे षट्पञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000056001, "chapter_id": 9056, "verse_number": "१-५६-१", "content_sanskrit": "एवमुक्तो वसिष्ठेन विश्वामित्रो महाबलः।\nआग्नेयमस्त्रमुद्दिश्य तिष्ठ तिष्ठेति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000056002, "chapter_id": 9056, "verse_number": "१-५६-२", "content_sanskrit": "ब्रह्मदण्डं समुद्यम्य कालदण्डमिवापरम्।\nवसिष्ठो भगवान् क्रोधादिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000056003, "chapter_id": 9056, "verse_number": "१-५६-३", "content_sanskrit": "क्षत्रबन्धो स्थितोऽस्म्येष यद् बलं तद् विदर्शय।\nनाशयाम्यद्य ते दर्पं शस्त्रस्य तव गाधिज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000056004, "chapter_id": 9056, "verse_number": "१-५६-४", "content_sanskrit": "क्व च ते क्षत्रियबलं क्व च ब्रह्मबलं महत्।\nपश्य ब्रह्मबलं दिव्यं मम क्षत्रियपांसन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000056005, "chapter_id": 9056, "verse_number": "१-५६-५", "content_sanskrit": "तस्यास्त्रं गाधिपुत्रस्य घोरमाग्नेयमुत्तमम्।\nब्रह्मदण्डेन तच्छान्तमग्नेर्वेग इवाम्भसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000056006, "chapter_id": 9056, "verse_number": "१-५६-६", "content_sanskrit": "वारुणं चैव रौद्रं च ऐन्द्रं पाशुपतं तथा।\nऐषीकं चापि चिक्षेप कुपितो गाधिनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000056007, "chapter_id": 9056, "verse_number": "१-५६-७", "content_sanskrit": "मानवं मोहनं चैव गान्धर्वं स्वापनं तथा।\nजृम्भणं मादनं चैव संतापनविलापने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000056008, "chapter_id": 9056, "verse_number": "१-५६-८", "content_sanskrit": "शोषणं दारणं चैव वज्रमस्त्रं सुदुर्जयम्।\nब्रह्मपाशं कालपाशं वारुणं पाशमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000056009, "chapter_id": 9056, "verse_number": "१-५६-९", "content_sanskrit": "पिनाकमस्त्रं दयितं शुष्कार्द्रे अशनी तथा।\nदण्डास्त्रमथ पैशाचं क्रौञ्चमस्त्रं तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000056010, "chapter_id": 9056, "verse_number": "१-५६-१०", "content_sanskrit": "धर्मचक्रं कालचक्रं विष्णुचक्रं तथैव च।\nवायव्यं मथनं चैव अस्त्रं हयशिरस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000056011, "chapter_id": 9056, "verse_number": "१-५६-११", "content_sanskrit": "शक्तिद्वयं च चिक्षेप कङ्कालं मुसलं तथा।\nवैद्याधरं महास्त्रं च कालास्त्रमथ दारुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000056012, "chapter_id": 9056, "verse_number": "१-५६-१२", "content_sanskrit": "त्रिशूलमस्त्रं घोरं च कापालमथ कङ्कणम्।\nएतान्यस्त्राणि चिक्षेप सर्वाणि रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000056013, "chapter_id": 9056, "verse_number": "१-५६-१३", "content_sanskrit": "वसिष्ठे जपतां श्रेष्ठे तदद्भुतमिवाभवत्।\nतानि सर्वाणि दण्डेन ग्रसते ब्रह्मणः सुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000056014, "chapter_id": 9056, "verse_number": "१-५६-१४", "content_sanskrit": "तेषु शान्तेषु ब्रह्मास्त्रं क्षिप्तवान् गाधिनन्दनः।\nतदस्त्रमुद्यतं दृष्ट्वा देवाः साग्निपुरोगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000056015, "chapter_id": 9056, "verse_number": "१-५६-१५", "content_sanskrit": "देवर्षयश्च सम्भ्रान्ता गन्धर्वाः समहोरगाः।\nत्रैलोक्यमासीत् संत्रस्तं ब्रह्मास्त्रे समुदीरिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000056016, "chapter_id": 9056, "verse_number": "१-५६-१६", "content_sanskrit": "तदप्यस्त्रं महाघोरं ब्राह्मं ब्राह्मेण तेजसा।\nवसिष्ठो ग्रसते सर्वं ब्रह्मदण्डेन राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000056017, "chapter_id": 9056, "verse_number": "१-५६-१७", "content_sanskrit": "ब्रह्मास्त्रं ग्रसमानस्य वसिष्ठस्य महात्मनः।\nत्रैलोक्यमोहनं रौद्रं रूपमासीत् सुदारुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000056018, "chapter_id": 9056, "verse_number": "१-५६-१८", "content_sanskrit": "रोमकूपेषु सर्वेषु वसिष्ठस्य महात्मनः।\nमरीच्य इव निष्पेतुरग्नेर्धूमाकुलार्चिषः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000056019, "chapter_id": 9056, "verse_number": "१-५६-१९", "content_sanskrit": "प्राज्वलद् ब्रह्मदण्डश्च वसिष्ठस्य करोद्यतः।\nविधूम इव कालाग्नेर्यमदण्ड इवापरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000056020, "chapter_id": 9056, "verse_number": "१-५६-२०", "content_sanskrit": "ततोऽस्तुवन् मुनिगणा वसिष्ठं जपतां वरम्।\nअमोघं ते बलं ब्रह्मंस्तेजो धारय तेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000056021, "chapter_id": 9056, "verse_number": "१-५६-२१", "content_sanskrit": "निगृहीतस्त्वया ब्रह्मन् विश्वामित्रो महाबलः।\nअमोघं ते बलं श्रेष्ठ लोकाः सन्तु गतव्यथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000056022, "chapter_id": 9056, "verse_number": "१-५६-२२", "content_sanskrit": "एवमुक्तो महातेजाः शमं चक्रे महाबलः।\nविश्वामित्रो विनिकृतो विनिःश्वस्येदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000056023, "chapter_id": 9056, "verse_number": "१-५६-२३", "content_sanskrit": "धिग् बलं क्षत्रियबलं ब्रह्मतेजोबलं बलम्।\nएकेन ब्रह्मदण्डेन सर्वास्त्राणि हतानि मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000056024, "chapter_id": 9056, "verse_number": "१-५६-२४", "content_sanskrit": "तदेतत् प्रसमीक्ष्याहं प्रसन्नेन्द्रियमानसः।\nतपो महत् समास्थास्ये यद् वै ब्रह्मत्वकारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000056025, "chapter_id": 9056, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे षट्पञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]