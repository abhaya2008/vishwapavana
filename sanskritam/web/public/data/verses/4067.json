[{"id": 2142301, "chapter_id": 4067, "verse_number": "", "content_sanskrit": "विराटः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2142302, "chapter_id": 4067, "verse_number": "१", "content_sanskrit": "यच्च वक्ष्यामि ते सर्वं मा शङ्केथा युधिष्ठिर\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2142303, "chapter_id": 4067, "verse_number": "२", "content_sanskrit": "इदं सनगरं राष्ट्रं सधनं सवधूजनम् ।\nयुष्मभ्यं सम्प्रदास्यामि भोक्ष्याम्युच्छिष्टमेव च\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2142304, "chapter_id": 4067, "verse_number": "३", "content_sanskrit": "अहं वृद्धश्चिरं राजन् भुक्तभोगश्चिरं सुखम् ।\nराज्यं दत्त्वा तु युष्मभ्यं प्रव्रजिष्यामि काननम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2142305, "chapter_id": 4067, "verse_number": "४", "content_sanskrit": "उत्तरां प्रतिगृह्णातु सव्यसाची धनञ्जयः ।\nअयं हौपयिको भर्ता तस्याः पुरुषसत्तमः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2142306, "chapter_id": 4067, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2142307, "chapter_id": 4067, "verse_number": "५", "content_sanskrit": "एवमुक्तो धर्मराजः पार्थमैक्षद् धनञ्जयम् ।\nईक्षितं चार्जुनो ज्ञात्वा मात्स्यं वचनमब्रवीत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2142308, "chapter_id": 4067, "verse_number": "६", "content_sanskrit": "वयं वनान्तरं प्राप्ता न ते राज्यं गृहामहे ।\nकिन्तु दुर्योधनादीनां राज्ञां राजन् स्पृहामहे\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2142309, "chapter_id": 4067, "verse_number": "७", "content_sanskrit": "प्रतिगृह्णाम्यहं राजन् स्नुषां दुहितरं तव ।\nयुक्तो ह्यावां च सम्बन्धो मात्स्यभारतवंशयोः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2142310, "chapter_id": 4067, "verse_number": "", "content_sanskrit": "विराटः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2142311, "chapter_id": 4067, "verse_number": "८", "content_sanskrit": "किमर्थं पाण्डवश्रेष्ठ भार्यां दुहितरं मम ।\nप्रतिग्रहीतुं नेमां त्वं मया दत्तामिहेच्छसि\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2142312, "chapter_id": 4067, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2142313, "chapter_id": 4067, "verse_number": "९", "content_sanskrit": "अन्तःपुरेऽहमुषितः सदा पश्यन् सुतां तव ।\nरहस्यं च प्रकाशं च विश्वस्ता पितृवन्मयि\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2142314, "chapter_id": 4067, "verse_number": "१०", "content_sanskrit": "प्रियो बहुमतश्चासं नर्तने गीतवादिते ।\nआचार्यवच्च मां नित्यं मन्यते दुहिता तव\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2142315, "chapter_id": 4067, "verse_number": "११", "content_sanskrit": "वयःस्थया तथा राजन् सह संवत्सरोषितः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2142316, "chapter_id": 4067, "verse_number": "१२", "content_sanskrit": "अतिशङ्का ततोऽस्थाने तव लोकस्य च प्रभो ।\nतस्मादामन्त्रये त्वां हि पुत्रार्थं वै विशाम्पते\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2142317, "chapter_id": 4067, "verse_number": "१३", "content_sanskrit": "शुद्धं जितेन्द्रियम्मन्यं तस्याः शुद्धिः कृता मया\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2142318, "chapter_id": 4067, "verse_number": "१४", "content_sanskrit": "स्नुषायां दुहितुर्वाऽपि पुत्रे वाऽऽत्मनि वा पुनः ।\nअतिशङ्कां न पश्यामि तेन शुद्धिर्भविष्यति\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2142319, "chapter_id": 4067, "verse_number": "१५", "content_sanskrit": "अभिषङ्गादहं भीतो मिथ्याचारात् परन्तप ।\nस्नुषार्थमुत्तरां राजन् प्रतिगृह्णामि ते सुताम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2142320, "chapter_id": 4067, "verse_number": "१६", "content_sanskrit": "स्वस्रीयो वासुदेवस्य साक्षाद् देवशिशुर्यथा ।\nदयितश्चक्रहस्तस्य बलवानस्त्रकोविदः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2142321, "chapter_id": 4067, "verse_number": "१७", "content_sanskrit": "अभिमन्युर्महाबाहुः पुत्रो मम विशाम्पते ।\nजामाता तव युक्तो वै भर्ताऽथ दुहितुस्तव\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2142322, "chapter_id": 4067, "verse_number": "", "content_sanskrit": "विराटः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2142323, "chapter_id": 4067, "verse_number": "१८", "content_sanskrit": "उपपन्नं कुरुश्रेष्ठ कुन्तीपुत्रे धनञ्जये ।\nय एवं धर्मनित्यश्च ज्ञातज्ञेयश्च पाण्डवः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2142324, "chapter_id": 4067, "verse_number": "१९", "content_sanskrit": "यत् सत्यं मन्यसे पार्थ क्रियतां तदनन्तरम् ।\nसर्वे कामाः समृद्धा मे सम्बन्धी यस्य मेऽर्जुनः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2142325, "chapter_id": 4067, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2142326, "chapter_id": 4067, "verse_number": "२०", "content_sanskrit": "एवं ब्रुवति राजेन्द्रे कुन्तीपुत्रो युधिष्ठिरः ।\nअन्वमोदत सम्बन्धं समये कृष्णमात्स्ययोः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2142327, "chapter_id": 4067, "verse_number": "२१", "content_sanskrit": "दूतान् मित्रेषु सर्वेषु वासुदेवे च भारत ।\nप्रेषयामास कौन्तेयो विराटश्च महीपतिः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2142328, "chapter_id": 4067, "verse_number": "२२", "content_sanskrit": "प्रतिगृह्य स्नुषार्थं वै दर्शयन् वृत्तमात्मनः ।\nशीलशौचसमाचारं लोकस्यावेद्य फल्गुनः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2142329, "chapter_id": 4067, "verse_number": "२३", "content_sanskrit": "लोके विख्याप्य माहात्म्यं यशसश्च परन्तप ।\nकृतार्थः शुचिरव्यग्रः तुष्टिमानभवत् तदा\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2142330, "chapter_id": 4067, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2142331, "chapter_id": 4067, "verse_number": "२४", "content_sanskrit": "राजन् प्रीतोऽस्मि भद्रं ते सखा मेऽसि परन्तप ।\nसुखमध्युषिताः सर्वे अज्ञातास्त्वयि पार्थिव\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2142332, "chapter_id": 4067, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2142333, "chapter_id": 4067, "verse_number": "२५", "content_sanskrit": "विराटनगरे राजा धर्मात्मा संशितव्रतः ।\nपूजितश्चाभिषिक्तश्च रत्नैश्च शतशश्चितः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2142334, "chapter_id": 4067, "verse_number": "", "content_sanskrit": "तथा ब्रुवन्तं प्रसमीक्ष्य राजा परं प्रहृष्टः स्वजनेन तेन ।\nस्नेहात् परिष्वज्य नृपो भुजाभ्यां ददौ तमर्थं कुरुपाण्डवानाम्\t २६", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2142335, "chapter_id": 4067, "verse_number": "२७", "content_sanskrit": "युद्धात् प्रयाताः कुरवो हि मार्गे समेत्य सर्वे हितमेव तत्र ।\nआचार्यपुत्रः शकुनिश्च राजा दुर्योधनः सूतपुत्रश्च कर्णः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2142336, "chapter_id": 4067, "verse_number": "२८", "content_sanskrit": "समेत्य राजन् सहिताः समर्थं समादिशन् दूतमथो समग्राः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2142337, "chapter_id": 4067, "verse_number": "२९", "content_sanskrit": "युधिष्ठिरश्चापि सुसम्प्रहृष्टो दुर्योधनाद् दूतमपश्यदागतम् ।\nस चाब्रवीद् धर्मराजं समेत्य युधिष्ठिरं पाण्डवमुग्रवीर्यम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2142338, "chapter_id": 4067, "verse_number": "३०", "content_sanskrit": "धनञ्जयेनासि पुनर्वनाय प्रव्राजितः समये तिष्ठ पार्थ ।\nत्रयोदशे ह्येष किरीटमाली संवत्सरे पाण्डवेयोऽद्य दृष्टः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2142339, "chapter_id": 4067, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2142340, "chapter_id": 4067, "verse_number": "३१", "content_sanskrit": "ततोऽब्रवीद् धर्मसुतः प्रहस्य क्षिप्रं गत्वा ब्रूहि सुयोधनं तम् ।\nपितामहः शान्तनवो ब्रवीतु यद्यत्र पूर्णो न त्रयोदशो नः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2142341, "chapter_id": 4067, "verse_number": "", "content_sanskrit": "संवत्सरान्ते तु धनञ्जयेन विष्फारितं गाण्डिवमाजिमध्ये ।\nपूर्णो न पूर्णो न इति ब्रवीतु यदस्य सत्यं मम तत् प्रमाणम्\t॥३२", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2142342, "chapter_id": 4067, "verse_number": "३३", "content_sanskrit": "तेनैवमुक्तः स निवृत्य दूतो दुर्योधनं प्राप्य शशंस सर्वम् ।\nसमेत्य दूतेन स राजपुत्रो दुर्योधनो मन्त्रयामास तत्र\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2142343, "chapter_id": 4067, "verse_number": "३४", "content_sanskrit": "भीष्मेण कर्णेन कृपेण चैव द्रोणेन भूरिश्रवसा च सार्धम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2142344, "chapter_id": 4067, "verse_number": "", "content_sanskrit": "सम्मन्त्र्य रात्रौ बहुभिः सुहृद्भिः \tभीष्मोऽब्रवीद् धार्तराष्ट्रं महात्मा३५", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2142345, "chapter_id": 4067, "verse_number": "३६", "content_sanskrit": "तीर्णप्रतिज्ञेन धनञ्जयेन विष्फारितं गाण्डिवमाजिमध्ये\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2142346, "chapter_id": 4067, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2142347, "chapter_id": 4067, "verse_number": "३७", "content_sanskrit": "ते धार्तराष्ट्राः समयं निशम्य तीर्णप्रतिज्ञस्य धनञ्जयस्य ।\nविचिन्त्य सर्वे सहिताः सुहृद्भिः\nसपार्थिवाः स्वानि गृहाणि जग्मुः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2142348, "chapter_id": 4067, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि पञ्चसप्ततितमोऽध्यायः ॥७५॥ वैवाहिकपर्वणि चतुर्थोऽध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]