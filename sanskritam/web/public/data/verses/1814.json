[{"id": 2037703, "chapter_id": 1814, "verse_number": "५-५९-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2037704, "chapter_id": 1814, "verse_number": "५-५९-१", "content_sanskrit": "ब्रूहि सञ्जय यच्छेषं वासुदेवादनन्तरम्।\nयजर्जुन उवाच त्वां परं कौतूहलं हि मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2037705, "chapter_id": 1814, "verse_number": "५-५९-२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2037706, "chapter_id": 1814, "verse_number": "५-५९-२", "content_sanskrit": "वासुदेववचः श्रुत्वा कुन्तीपुत्रो धनञ्जयः।\nउवाच काले दुर्धर्षो वासुदेवस्य शृण्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2037707, "chapter_id": 1814, "verse_number": "५-५९-३", "content_sanskrit": "पितामहं शान्तनवं धृतराष्ट्रं च सञ्जय ।\nद्रोणं कृपं च शल्यं च महाराजं च बाह्लिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2037708, "chapter_id": 1814, "verse_number": "५-५९-४", "content_sanskrit": "द्रौणिं च सौमदत्तिं च शकुनिं चापि सौबलम् ।\nदुश्शासनं शलं चैव पुरुमित्रं विविंशतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2037709, "chapter_id": 1814, "verse_number": "५-५९-५", "content_sanskrit": "विकर्णं चित्रसेनं च जयत्सेनं च पार्थिवम्।\nविन्दानुविन्दावावन्त्यौ दुर्मुखं चापि पौरवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2037710, "chapter_id": 1814, "verse_number": "५-५९-६", "content_sanskrit": "सैन्धवं दुस्सहं चैव भूरिश्रवसमेव च।\nभगदत्तं च राजानं जलसन्धं च पौरवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2037711, "chapter_id": 1814, "verse_number": "५-५९-७", "content_sanskrit": "ये चाप्यन्ये पार्थिवास्तत्र योद्धुं\nसमागताः कौरवाणां प्रियार्थम्।\nमुमूर्षवः पाण्डवाग्नौ प्रदीप्ते\nसमानीता धार्तराष्ट्रोण सूत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2037712, "chapter_id": 1814, "verse_number": "५-५९-८", "content_sanskrit": "यथान्यायं कुशलं वन्दनं च\nसमागता मद्वचनेन वाच्याः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2037713, "chapter_id": 1814, "verse_number": "५-५९-९", "content_sanskrit": "इदं ब्रूवाः सञ्जय राजमध्ये\nदुर्योधनं पापकृतां प्रधानम्।\nअमर्षणं दुर्मतिं राजपुत्रं\nपापात्मानं धार्तराष्ट्रं सुलुब्धम्।\nसर्वं ममैतद्वचनं समग्रं\nसहामात्यं सञ्जय श्रावयेथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2037714, "chapter_id": 1814, "verse_number": "५-५९-१०", "content_sanskrit": "एवं परिष्वज्य धनञ्जयो मां\nततोऽर्थवद्धर्मवच्चापि वाक्यम्।\nप्रोवाचेदं वासुदेवं समीक्ष्य\nपार्थो धीमाँल्लोहितान्तायताक्षः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2037715, "chapter_id": 1814, "verse_number": "५-५९-११", "content_sanskrit": "यथाश्रुतं ते वदतो महात्मनो\nयदुप्रवीरस्य वचः समाहितम्।\nतथैव वाच्यं भवतापि मद्वचः\nसमागतेषु क्षितिपेषु सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2037716, "chapter_id": 1814, "verse_number": "५-५९-१२", "content_sanskrit": "शराग्निधूमे रथनेमिनादिते\nधनुस्स्त्रुवेणास्त्रबलापहारिणा ।\nयथा न होमः क्रियते महामृधे\nतथा समेत्य प्रयतध्वमादृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2037717, "chapter_id": 1814, "verse_number": "५-५९-१३", "content_sanskrit": "न चेत्प्रयच्छध्वममित्रघातिनो\nयुधिष्ठिरस्यार्धमभीप्सितं स्वकम्।\nनयामि वः साश्वपदातिकुञ्जरा-\nन्दिशं पितॄणामशिवां शितैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2037718, "chapter_id": 1814, "verse_number": "५-५९-१४", "content_sanskrit": "ततोऽहमामन्त्र्य चतुर्भुजं हरिं\nधनञ्जयं चैव नमस्य सत्वरम्।\nजवेन संप्राप्त इहामरद्युते\nतवान्तिकं प्रापयितुं वचो महत् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2037719, "chapter_id": 1814, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि यानसन्धिपर्वणि एकोनषष्टितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]