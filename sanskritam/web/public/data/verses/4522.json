[{"id": 2163164, "chapter_id": 4522, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2163165, "chapter_id": 4522, "verse_number": "१", "content_sanskrit": "तमापतन्तं सम्प्रेक्ष्य सात्वतं युद्धदुर्मदम् ।\nक्रोधाद् भूरिश्रवा राजन् सहसा समुपाद्रवत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2163166, "chapter_id": 4522, "verse_number": "२", "content_sanskrit": "तमब्रवीन्महाबाहुः कौरव्यः शिनिपुङ्गवम् ।\nअद्य प्राप्तोऽसि दिष्ट्या मे चक्षुर्विषयमित्युत\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2163167, "chapter_id": 4522, "verse_number": "३", "content_sanskrit": "चिराभिलषितं काममद्य प्राप्स्यामि संयुगे ।\nन हि मे मोक्ष्यसे जीवन् यदि नोत्सृजसे रणम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2163168, "chapter_id": 4522, "verse_number": "४", "content_sanskrit": "अद्य त्वां समरे हत्वा नित्यं शूराभिमानिनम् ।\nनन्दयिष्यामि दाशार्ह कुरुराजं सुयोधनम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2163169, "chapter_id": 4522, "verse_number": "५", "content_sanskrit": "अद्य मद्बाणनिर्दग्धं पतितं धरणीतळे ।\nद्रक्ष्यतस्त्वां रणे वीरौ सहितौ केशवार्जुनौ\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2163170, "chapter_id": 4522, "verse_number": "६", "content_sanskrit": "अद्य धर्मसुतो राजा श्रुत्वा त्वां निहतं मया ।\nसव्रीडो भविता सद्यो येनासीह प्रवेशितः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2163171, "chapter_id": 4522, "verse_number": "७", "content_sanskrit": "अद्य मे विक्रमं पार्थो विज्ञास्यति धनञ्जयः ।\nत्वयि भूमौ विनिहते शयाने रुधिरोक्षिते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2163172, "chapter_id": 4522, "verse_number": "८", "content_sanskrit": "चिराभिलषितो ह्यद्य त्वया सह समागमः ।\nपुरा देवासुरे युद्धे शक्रस्य बलिना यथा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2163173, "chapter_id": 4522, "verse_number": "९", "content_sanskrit": "अद्य युद्धं महाघोरं तव दास्यामि सात्वत ।\nततो ज्ञास्यसि तत्त्वेन मद्वीर्यबलपौरुषम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2163174, "chapter_id": 4522, "verse_number": "१०", "content_sanskrit": "अद्य संयमनीं याता मया त्वं निहतो रणे ।\nयथा रामानुजेनाजौ रावणिर्लक्ष्मणेन वै\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2163175, "chapter_id": 4522, "verse_number": "११", "content_sanskrit": "अद्य कृष्णश्च पार्थश्च धर्मराजश्च माधव ।\nहते त्वयि निरुत्साहा रणं त्यक्ष्यन्त्यसंशयम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2163176, "chapter_id": 4522, "verse_number": "१२", "content_sanskrit": "अद्य तेऽपचितिं कृत्वा शितैर्माधव सायकैः ।\nतत्स्त्रियो नन्दयिष्यामि ये त्वया निहता रणे\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2163177, "chapter_id": 4522, "verse_number": "१३", "content_sanskrit": "चक्षुर्विषयसम्प्राप्तो न त्वं माधव मोक्ष्यसे ।\nसिंहस्य विषयं प्राप्तो यथा क्षुद्रमृगस्तथा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2163178, "chapter_id": 4522, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2163179, "chapter_id": 4522, "verse_number": "१४", "content_sanskrit": "युयुधानस्तु तं राजन् प्रत्युवाच हसन्निव ।\nकौरवेय न सन्त्रासो विद्यते मम संयुगे\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2163180, "chapter_id": 4522, "verse_number": "१५", "content_sanskrit": "स मां निहन्यात् सङ्ग्रामे यो मां कुर्यान्निरायुधम् ।\nसमास्तु शाश्वतीर्हन्याद् यो मां हन्याद्धि संयुगे\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2163181, "chapter_id": 4522, "verse_number": "१६", "content_sanskrit": "किं मृषोक्तेन बहुना कर्मणा तु समाचर ।\nशारदस्येव मेघस्य गर्जितं निष्फलं हि ते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2163182, "chapter_id": 4522, "verse_number": "१७", "content_sanskrit": "श्रुत्वैतद्गर्जितं वीर हास्यं हि मम जायते ।\nचिरकालेप्सितं लोके युद्धमद्यास्तु कौरव\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2163183, "chapter_id": 4522, "verse_number": "१८", "content_sanskrit": "त्वरते मे मतिस्तात त्वयि युद्धाभिकाङ्क्षिणि ।\nनाहत्वा सन्निवर्तिष्ये त्वामद्य पुरुषाधम\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2163184, "chapter_id": 4522, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2163185, "chapter_id": 4522, "verse_number": "१९", "content_sanskrit": "अन्योन्यं तौ तदा वाग्भिस्तक्षन्तौ नरपुङ्गवौ ।\nजिघांसू परमक्रुद्धावभिजघ्नतुराहवे\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2163186, "chapter_id": 4522, "verse_number": "२०", "content_sanskrit": "समेतौ तौ नरव्याघ्रौ शुष्मिणौ स्पर्धिनौ रणे ।\nद्विरदाविव सङ्क्रुद्धौ वासितार्थे मदोत्कटौ\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2163187, "chapter_id": 4522, "verse_number": "२१", "content_sanskrit": "भूरिश्रवाः सात्यकिश्च ववर्षतुररिन्दमौ ।\nशरवर्षाणि भीमानि मेघाविव परस्परम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2163188, "chapter_id": 4522, "verse_number": "२२", "content_sanskrit": "सौमदत्तिस्तु शैनेयं प्रच्छाद्येषुभिराशुगैः ।\nजिघांसुर्भरतश्रेष्ठ विव्याध निशितैः शरैः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2163189, "chapter_id": 4522, "verse_number": "२३", "content_sanskrit": "दशभिः सात्यकिं विद्ध्वा सौमदत्तिरथापरान् ।\nमुमोच निशितान् बाणाञ्जिघांसुः शिनिपुङ्गवम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2163190, "chapter_id": 4522, "verse_number": "२४", "content_sanskrit": "तानस्य विशिखांस्तीक्ष्णानन्तरिक्षे विशाम्पते ।\nअप्राप्तानस्त्रमायाभिरग्रसत् सात्यकिः प्रभो\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2163191, "chapter_id": 4522, "verse_number": "२५", "content_sanskrit": "तौ पृथक् शरवर्षाभ्यामवर्षेतां परस्परम् ।\nउत्तमाभिजनौ वीरौ कुरुवृष्णियशस्करौ\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2163192, "chapter_id": 4522, "verse_number": "२६", "content_sanskrit": "तौ नखैरिव शार्दूलौ दन्तैरिव महाद्विपौ ।\nरथशक्तिभिरन्योन्यं विशिखैश्चाप्यकृन्तताम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2163193, "chapter_id": 4522, "verse_number": "२७", "content_sanskrit": "निर्भिदन्तौ हि गात्राणि विक्षरन्तौ च शोणितम् ।\nव्यष्टम्भयेतामन्योन्यं प्राणद्यूताभिदेविनौ\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2163194, "chapter_id": 4522, "verse_number": "२८", "content_sanskrit": "एवमुत्तमकर्माणौ कुरुवृष्णियशस्करौ ।\nपरस्परमयुद्ध्येतां वारणाविव यूथपौ\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2163195, "chapter_id": 4522, "verse_number": "२९", "content_sanskrit": "तावदीर्घेण कालेन ब्रह्मलोकपुरस्कृतौ ।\nजिगीषन्तौ परं स्थानमन्योन्यमभिजघ्नतुः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2163196, "chapter_id": 4522, "verse_number": "३०", "content_sanskrit": "सात्यकिः सौमदत्तिश्च शरवृष्ट्या परस्परम् ।\nहृष्टवद् धार्तराष्ट्राणां पश्यतामभ्यवर्षताम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2163197, "chapter_id": 4522, "verse_number": "३१", "content_sanskrit": "सम्प्रैक्षन्त जनास्तत्र युद्ध्यमानौ युधाम्पती ।\nयूथपौ वासिताहेतोः प्रयुद्धाविव कुञ्जरौ\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2163198, "chapter_id": 4522, "verse_number": "३२", "content_sanskrit": "अन्योन्यस्य हयान् हत्वा धनुषी विनिकृत्य च ।\nविरथावसियुद्धाय समेयातां महारणे\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2163199, "chapter_id": 4522, "verse_number": "३३", "content_sanskrit": "आर्षभे चर्मणी चित्रे प्रगृह्य विपुले शुभे ।\nविकोशौ चाप्यसी कृत्वा समरे तौ विचेरतुः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2163200, "chapter_id": 4522, "verse_number": "३४", "content_sanskrit": "चरन्तौ विविधान् मार्गान् मण्डलानि च भागशः ।\nमुहुराजघ्नतुः क्रुद्धावन्योन्यमरिमर्दनौ\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2163201, "chapter_id": 4522, "verse_number": "३५", "content_sanskrit": "सखड्गौ चित्रवर्माणौ सनिष्काङ्गदभूषणौ ।\nरणे रणोत्कटौ राजन्नन्योन्यं पर्यकर्षताम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2163202, "chapter_id": 4522, "verse_number": "३६", "content_sanskrit": "मुहूर्तमिव राजेन्द्र परिकृष्य परस्परम् ।\nपश्यतां सर्वसैन्यानां वीरावाश्वसतां पुनः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2163203, "chapter_id": 4522, "verse_number": "३७", "content_sanskrit": "असिभ्यां चर्मणी शुभ्रे विपुले च शरावरे ।\nनिकृत्य पुरुषव्याघ्रौ बाहुयुद्धं प्रचक्रतुः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2163204, "chapter_id": 4522, "verse_number": "३८", "content_sanskrit": "व्यूढोरस्कौ दीर्घभुजौ नियुद्धकुशलावुभौ ।\nबाहुभिः समसज्जेतामायसैः परिघैरिव\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2163205, "chapter_id": 4522, "verse_number": "३९", "content_sanskrit": "तयोरासन् भुजाघाता निग्रहावग्रहात् तथा ।\nशिक्षाबलसमुद्भूताः सर्वयोधप्रहर्षणाः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2163206, "chapter_id": 4522, "verse_number": "४०", "content_sanskrit": "भुजयोक्त्रावबन्धैश्च शिरोभ्यां चावघातनैः ।\nपादावकर्षसन्दानेस्तोमराङ्कुशलासनैः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2163207, "chapter_id": 4522, "verse_number": "४१", "content_sanskrit": "पादोदरविबन्धैश्च भूमावुद्भ्रमणैस्तथा ।\nगतप्रत्यागताक्षेपैः पातनोत्थानसम्प्लुतैः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2163208, "chapter_id": 4522, "verse_number": "४२", "content_sanskrit": "द्वात्रिंशत्करणानि स्युर्यानि युद्धस्य भारत ।\nतान्यदर्शयतां तत्र युद्ध्यमानौ महाबलौ\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2163209, "chapter_id": 4522, "verse_number": "४३", "content_sanskrit": "तयोर्नृवरयो राजन् समरे युद्ध्यमानयोः ।\nभीमोऽभवन्महाशब्दो वज्रपर्वतयोरिव\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2163210, "chapter_id": 4522, "verse_number": "४४", "content_sanskrit": "द्विपाविव विषाणाग्रैः शृङ्गैरिव महर्षभौ ।\nयुयुधाते महात्मानौ कुरुसात्वतपुङ्गवौ\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2163211, "chapter_id": 4522, "verse_number": "४५", "content_sanskrit": "क्षीणायुधे सात्वते युद्ध्यमाने\nततोऽब्रवीदर्जुनं वासुदेवः ।\nपश्यस्वैनं विरथं युद्ध्यमानं\nरणे केतुं सर्वधनुर्धराणाम्\t॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2163212, "chapter_id": 4522, "verse_number": "४६", "content_sanskrit": "प्रविष्टो भारतीं सेनां तव पाण्डव पृष्ठतः ।\nयोधितश्च महावीर्यैः सर्वैर्भारत भारतैः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2163213, "chapter_id": 4522, "verse_number": "४७", "content_sanskrit": "परिश्रान्तो युधांश्रेष्ठः सम्प्राप्तो भूरिदक्षिणम् ।\nयुद्धकाङ्क्षिणमायान्तं नैतत् सममिवार्जुन\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2163214, "chapter_id": 4522, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2163215, "chapter_id": 4522, "verse_number": "४८", "content_sanskrit": "ततो भूरिश्रवाः क्रुद्धः सात्यकिं युद्धदुर्मदम् ।\nउद्यम्य न्यहनद् राजन् मत्तो मत्तमिव द्विपम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2163216, "chapter_id": 4522, "verse_number": "४९", "content_sanskrit": "रथस्थयोर्द्वयोर्युद्धे क्रुद्धयोर्योधमुख्ययोः ।\nकेशवार्जुनयो राजन् समरे प्रेक्षमाणयोः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2163217, "chapter_id": 4522, "verse_number": "५०", "content_sanskrit": "अथ कृष्णो महाबाहुरर्जुनं प्रत्यभाषत ।\nपश्य वृष्ण्यन्धकव्याघ्रं सौमदत्तिवशं गतम्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2163218, "chapter_id": 4522, "verse_number": "५१", "content_sanskrit": "परिश्रान्तं गतं भूमौ कृत्वा कर्म सुदुष्करम् ।\nतवान्तेवासिनं शूरं पालयार्जुन सात्यकिम्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2163219, "chapter_id": 4522, "verse_number": "५२", "content_sanskrit": "न वशं यज्ञशीलस्य गच्छेदेष वरारिहन् ।\nत्वत्कृते पुरुषव्याघ्र तदाशु क्रियतां विभो\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2163220, "chapter_id": 4522, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2163221, "chapter_id": 4522, "verse_number": "५३", "content_sanskrit": "अथाब्रवीद् हृष्टमना वासुदेवं धनञ्जयः ।\nपश्य वृष्णिप्रवीरेण क्रीडन्तं कुरुपुङ्गवम् ।\nमहाद्विपेनेव वने मत्तेन हरियूथपम्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2163222, "chapter_id": 4522, "verse_number": "५४", "content_sanskrit": "हाहाकारो महानासीत् सैन्यानां भरतर्षभ ।\nयदुद्यम्य महाबाहुः सात्यकिं न्यपतद् भुवि\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2163223, "chapter_id": 4522, "verse_number": "५५", "content_sanskrit": "पतिते त्वथ शैनेये कौन्तेयः कृष्णमब्रवीत् ।\nमामेव हि महाबाहो परियन्ति महारथाः ।\nयथाशक्ति यतन्ते स्म योधयन्तो जनार्दन\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2163224, "chapter_id": 4522, "verse_number": "५६", "content_sanskrit": "ध्रुवं च योधयाम्येतान् छिद्रान्वेषणतत्परान् ।\nरक्षामि सात्यकिं चैव सौमदत्तिवशं गतम्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2163225, "chapter_id": 4522, "verse_number": "५७", "content_sanskrit": "प्राप्तो हि मया कृष्ण हन्तुं भूरिश्रवा रणे ।\nअन्येन तु समासक्तं मनो नोत्सहते मम\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2163226, "chapter_id": 4522, "verse_number": "५८", "content_sanskrit": "अवश्यं हि मया कृष्ण वाॅष्णिवीरस्य रक्षणम् ।\nमदर्थं युद्ध्यमानस्य कार्यं प्राणैरपि प्रभो\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2163227, "chapter_id": 4522, "verse_number": "५९", "content_sanskrit": "अधर्मो वाऽस्तु धर्मो वा मम माधव माधवः ।\nपरेण निहतो मा स्म प्राणान् हासीन्महारथः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2163228, "chapter_id": 4522, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2163229, "chapter_id": 4522, "verse_number": "६०", "content_sanskrit": "एवमुक्त्वाऽर्जुनः कृष्णं परानाशु शितैः शरैः ।\nछादयामास सङ्क्रुद्धः परे चापि धनञ्जयम्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2163230, "chapter_id": 4522, "verse_number": "६१", "content_sanskrit": "एवं स्म युद्ध्यते वीरः सात्यकिं च मुहुर्मुहुः ।\nप्रेक्षते स्म नरव्याघ्रो भूरिश्रवसमेव च\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2163231, "chapter_id": 4522, "verse_number": "६२", "content_sanskrit": "स सिंह इव मातङ्गं विकर्षन् भूरिदक्षिणः ।\nव्यरोचत कुरुश्रेष्ठः सात्वतप्रवरं युधि\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2163232, "chapter_id": 4522, "verse_number": "६३", "content_sanskrit": "अथ कोशाद् विनिष्कृष्य खड्गं भूरिश्रवा रणे ।\nमूर्धजेषु निजग्राह पदा चोरस्यताडयत्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2163233, "chapter_id": 4522, "verse_number": "६४", "content_sanskrit": "तथा तु परिकृष्यन्तं दृष्ट्वा सात्वतमाहवे ।\nवासुदेवस्ततो राजन् भूयोऽर्जुनमभाषत\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2163234, "chapter_id": 4522, "verse_number": "६५", "content_sanskrit": "पश्य वृष्ण्यन्धकव्याघ्रं सौमदत्तिवशं गतम् ।\nतव शिष्यं महाबाहो धनुष्यनवरं त्वया\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2163235, "chapter_id": 4522, "verse_number": "६६", "content_sanskrit": "असत्यो विक्रमः पार्थ यत्र भूरिश्रवा रणे ।\nविशेषयति वार्ष्णेयं सात्यकिं सत्यविक्रमम्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2163236, "chapter_id": 4522, "verse_number": "६७", "content_sanskrit": "एवमुक्तो महाबाहुर्वासुदेवेन पाण्डवः ।\nमनसा पूजयामास भूरिश्रवसमाहवे\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2163237, "chapter_id": 4522, "verse_number": "६८", "content_sanskrit": "विकर्षन् सात्वतश्रेष्ठं क्रीडमान इवाहवे ।\nसंहर्षयति मां भूयः कुरूणां कीर्तिवर्धनः\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2163238, "chapter_id": 4522, "verse_number": "६९", "content_sanskrit": "प्रवरं वृष्णिवीराणां यन्न हन्याद्धि सात्यकिम् ।\nमहाद्विपमिवारण्ये मृगेन्द्र इव कर्षति\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2163239, "chapter_id": 4522, "verse_number": "७०", "content_sanskrit": "एवं तु मनसा राजन् पार्थः सम्पूज्य कौरवम् ।\nवासुदेवं महाबाहुरर्जुनः प्रत्यभाषत\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2163240, "chapter_id": 4522, "verse_number": "७१", "content_sanskrit": "सैन्धवासक्तदृष्टित्वान्नैनं पश्यामि माधव ।\nएष त्वसुकरं कर्म यादवार्थे करोम्यहम्\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2163241, "chapter_id": 4522, "verse_number": "७२", "content_sanskrit": "इत्युक्त्वा वचनं कुर्वन् वासुदेवस्य पाण्डवः ।\nसखड्गं यज्ञशीलस्य पत्रिणा बाहुमच्छिनत्\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2163242, "chapter_id": 4522, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि सप्तविंशत्यधिकशततमोऽध्यायः ॥ १२७ ॥\nजयद्रथवधपर्वणि एकपञ्चाशोऽध्यायः ॥ ५१ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}]