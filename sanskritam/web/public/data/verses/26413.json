[{"id": 7006413000, "chapter_id": 26413, "verse_number": "२-७१-१", "content_sanskrit": "वैशम्पायन उवाच\nमहेन्द्रवचनं श्रुत्वा नारदो वदतां वरः ।\nविविक्ते देवराजानमिदं वचनमब्रवीत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006413001, "chapter_id": 26413, "verse_number": "२-७१-२", "content_sanskrit": "कामं प्रियाणि राजानो वक्तव्या नात्र संशयः ।\nप्राप्तकालं तु वक्तव्यं हितमप्रियमप्युत ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006413002, "chapter_id": 26413, "verse_number": "२-७१-३", "content_sanskrit": "अनियुक्तपुरोभागो न स्यादिति वदन्ति हि ।\nसुलोकगतितत्त्वज्ञो नयविज्ञानकोविदः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006413003, "chapter_id": 26413, "verse_number": "२-७१-४", "content_sanskrit": "कार्याकार्ये समुत्पन्ने परिपृच्छति मां भवान् ।\nयतस्ततः प्रवक्ष्यामि गृह्यतां यदि रोचते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006413004, "chapter_id": 26413, "verse_number": "२-७१-५", "content_sanskrit": "अनुक्तेनापि सुहृदा वक्तव्यं जानता हितम् ।\nन्याय्यं च प्राप्तकालं च पराभवमनिच्छता ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006413005, "chapter_id": 26413, "verse_number": "२-७१-६", "content_sanskrit": "वक्तव्यं सर्वथा सद्भिरप्रियं चापि यद्धितम् ।\nआनृण्यमेतत् स्नेहस्य सद्भिरेवादृतं पुरा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006413006, "chapter_id": 26413, "verse_number": "२-७१-७", "content_sanskrit": "अनृते धर्मभग्ने च न शुश्रूषति चाप्रिये ।\nन प्रियं च हितं वाच्यं सद्भिरेवेति निन्दिताः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006413007, "chapter_id": 26413, "verse_number": "२-७१-८", "content_sanskrit": "सर्वथा देव वक्तव्यं श्रूयतां शृण्वतां वर ।\nश्रुत्वा च कुरु सर्वज्ञ मम श्रेयस्करं वचः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006413008, "chapter_id": 26413, "verse_number": "२-७१-९", "content_sanskrit": "अन्योन्यभेदो भ्रातॄणां सुहृदां वा बलान्तक ।\nभवत्यानन्दकृद् देव द्विषतां नात्र संशयः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006413009, "chapter_id": 26413, "verse_number": "२-७१-१०", "content_sanskrit": "हितानुबन्धसहितं कार्यं ज्ञेयं सुरेश्वर ।\nविपरीतं च तद्बुद्ध्या नित्यं बुद्धिमतां वर ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006413010, "chapter_id": 26413, "verse_number": "२-७१-११", "content_sanskrit": "यत्स्यात्तापकरं पश्चादारब्धं कार्यमीदृशम् ।\nआरभेन्नैव तद् विद्वानेष बुद्धिमतां नयः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006413011, "chapter_id": 26413, "verse_number": "२-७१-१२", "content_sanskrit": "विपाकमस्य कार्यस्य नानुपश्यामि शोभनम् ।\nयदत्र कारणं देव निबोध विबुधाधिप ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006413012, "chapter_id": 26413, "verse_number": "२-७१-१३", "content_sanskrit": "य एको विश्वमध्यास्ते प्रधानं जगतो हरिः ।\nप्रकृत्या यं परं सर्वे क्षेत्रज्ञं वै विदुर्बुधाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006413013, "chapter_id": 26413, "verse_number": "२-७१-१४", "content_sanskrit": "तस्याव्यक्तस्य यो व्यक्तो भागः सर्वभवोद्भवः ।\nतस्यात्मा परमो देवो विष्णुः सर्वस्य धीमतः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006413014, "chapter_id": 26413, "verse_number": "२-७१-१५", "content_sanskrit": "प्रकृत्याः प्रथमो भाग उमा देवी यशस्विनी ।\nव्यक्तः सर्वमयो विश्वः स्त्रीसंज्ञो लोकभावनः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006413015, "chapter_id": 26413, "verse_number": "२-७१-१६", "content_sanskrit": "रुक्मिण्याद्याः स्त्रियस्तस्या व्यक्तत्वं प्रथमो गुणः ।\nअव्यया प्रकृतिर्देवी गुणी देवो महेश्वरः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006413016, "chapter_id": 26413, "verse_number": "२-७१-१७", "content_sanskrit": "न विशेषोऽस्य रुद्रस्य विष्णोश्चामरसत्तम ।\nगुणिनश्चाव्ययः शास्ता सदा च प्रथमोऽगुणः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006413017, "chapter_id": 26413, "verse_number": "२-७१-१८", "content_sanskrit": "नारायणो महातेजाः सर्वकृत्ययेकभावनः ।\nभोक्ता महेश्वरो देवः कर्ता विष्णुरधोक्षजः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006413018, "chapter_id": 26413, "verse_number": "२-७१-१९", "content_sanskrit": "ब्रह्मा देवगणाश्चान्ये पश्चात्सृष्टा महात्मना ।\nमहादेवेन देवेश प्रजापतिगणास्तथा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006413019, "chapter_id": 26413, "verse_number": "२-७१-२०", "content_sanskrit": "एवं पुराणपुरुषो विष्णुर्देवेषु पठ्यते ।\nअचिन्त्यश्चाप्रमेयश्च गुणेभ्यश्च परस्तथा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006413020, "chapter_id": 26413, "verse_number": "२-७१-२१", "content_sanskrit": "अदित्या तपसा विष्णुर्महात्माऽऽराधितः पुरा ।\nवरेण च्छन्दिता तेन परितुष्टेन चादितिः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006413021, "chapter_id": 26413, "verse_number": "२-७१-२२", "content_sanskrit": "तयोक्तस्त्वत्समं पुत्रमिच्छामीति सुरोत्तम ।\nप्रणिपत्य च विज्ञाय नारायणमधोक्षजम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006413022, "chapter_id": 26413, "verse_number": "२-७१-२३", "content_sanskrit": "तेनोक्तं भुवने नास्ति मत्समः पुरुषोऽपरः ।\nअंशेन तु भविष्यामि पुत्रः खल्वहमेव ते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006413023, "chapter_id": 26413, "verse_number": "२-७१-२४", "content_sanskrit": "स जातः सर्वकृद् देवो भ्राता तव सुरेश्वर ।\nनारायणो महातेजा यमुपेन्द्रं प्रचक्षते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006413024, "chapter_id": 26413, "verse_number": "२-७१-२५", "content_sanskrit": "इच्छन्नेव हरिर्देव काश्यपत्वमुपागतः ।\nतैस्तैर्भावैर्विकुरुते भूतभव्यभवाप्ययः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006413025, "chapter_id": 26413, "verse_number": "२-७१-२६", "content_sanskrit": "प्रादुर्भावं गतो देवो जगतो हितकाम्यया ।\nमाथुरं जगतो नाथः कर्ता हर्ता च केशवः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006413026, "chapter_id": 26413, "verse_number": "२-७१-२७", "content_sanskrit": "यथा पललपिण्डः स्याद् व्याप्तः स्नेहेन मानद ।\nतथा जगदिदं व्याप्तं विष्णुना प्रभविष्णुना ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006413027, "chapter_id": 26413, "verse_number": "२-७१-२८", "content_sanskrit": "ब्रह्मण्यदेवः सर्वात्मा तैस्तैर्भावैर्विकुर्वति ।\nजगत्यतिगुणो देवो वैकुण्ठः सर्वभावनः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006413028, "chapter_id": 26413, "verse_number": "२-७१-२९", "content_sanskrit": "अतः समस्तदेवानां पूज्य एव च केशवः ।\nपद्मनाभश्च भगवान् प्रजासर्गकरो विभुः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006413029, "chapter_id": 26413, "verse_number": "२-७१-३०", "content_sanskrit": "अनन्तो धारणार्थं च बिभर्ति च महद्यशः ।\nयज्ञ इत्यपि सद्भिश्च कथ्यते वेदवादिभिः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006413030, "chapter_id": 26413, "verse_number": "२-७१-३१", "content_sanskrit": "श्वेतः कृतयुगे देवो रक्तस्त्रेतायुगे तथा ।\nद्वापरे च तथा पीतः कृष्णः कलियुगे विभुः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006413031, "chapter_id": 26413, "verse_number": "२-७१-३२", "content_sanskrit": "अवधीत्स हिरण्याक्षं दिव्यरूपधरो हरिः ।\nदधाराप्सु निमज्जन्तीमेष देवो वसुन्धराम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006413032, "chapter_id": 26413, "verse_number": "२-७१-३३", "content_sanskrit": "वाराहं वपुराश्रित्य जगतो हितकाम्यया ।\nजघ्ने हिरण्यकशिपुं नारसिंहवपुर्हरिः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006413033, "chapter_id": 26413, "verse_number": "२-७१-३४", "content_sanskrit": "जिगाय जगतीं चैव विष्णुर्वामनरूपधृक् ।\nबबन्ध च बलिं देवः श्रीमान् पन्नगबन्धनैः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006413034, "chapter_id": 26413, "verse_number": "२-७१-३५", "content_sanskrit": "देवदानवसम्भूतानाक्रामयदपि श्रियम् ।\nत्वय्यनन्तः पुरा विष्णुरुदारोऽमितविक्रमः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006413035, "chapter_id": 26413, "verse_number": "२-७१-३६", "content_sanskrit": "सावशेषं तपो यस्य तन्निहन्ति जनार्दनः ।\nअलीकेष्वपि वर्तन्तं व्रतमेतन्महात्मनः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006413036, "chapter_id": 26413, "verse_number": "२-७१-३७", "content_sanskrit": "जघ्ने च दानवान् मुख्यान् देवानां ये च शत्रवः ।\nतव प्रियार्थं गोविन्दो धर्मनित्यः सतां गतिः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006413037, "chapter_id": 26413, "verse_number": "२-७१-३८", "content_sanskrit": "रामत्वमपि चावाप्य जघ्ने रावणमात्मवान् ।\nभूत्वा कामगुणांश्चैव जघान द्विरदं हरिः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006413038, "chapter_id": 26413, "verse_number": "२-७१-३९", "content_sanskrit": "हिताय जगतोऽद्यापि लोके वसति मानुषे ।\nउपेन्द्रो जगतां नाथः सर्वभूतोत्तमोत्तमः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006413039, "chapter_id": 26413, "verse_number": "२-७१-४०", "content_sanskrit": "जटी कृष्णाजिनी दण्डी दृष्टपूर्वो मया हरिः ।\nदैतेयेषु चरन् देवस्तृणेष्वग्निरिवोद्धतः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006413040, "chapter_id": 26413, "verse_number": "२-७१-४१", "content_sanskrit": "अद्राक्षमपि गोविन्दं दानवैकार्णवं जगत् ।\nकुर्वाणं दानवैर्हीनं जगतो हितकाम्यया ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006413041, "chapter_id": 26413, "verse_number": "२-७१-४२", "content_sanskrit": "अवश्यं पारिजातं ते नयिष्यति जनार्दनः ।\nद्वारकाममरश्रेष्ठ नानृतं च ब्रवीम्यहम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006413042, "chapter_id": 26413, "verse_number": "२-७१-४३", "content_sanskrit": "भ्रातृस्नेहाभिभूतस्त्वं न कृष्णे प्रहरिष्यसि ।\nनापि कृष्णस्त्वयि ज्येष्ठे प्रहरिष्यति वासव ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006413043, "chapter_id": 26413, "verse_number": "२-७१-४४", "content_sanskrit": "नैव चेच्छ्रोष्यति प्रोक्तं मया देव कथञ्चन ।\nपृच्छ त्वं नयधर्मज्ञान् ये हितास्तव मन्त्रिणः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006413044, "chapter_id": 26413, "verse_number": "२-७१-४५", "content_sanskrit": "वैशम्पायन उवाच\nनारदेनैवमुक्तस्तु महेन्द्रो जनमेजय ।\nइदमुत्तरमीशोऽथ प्रत्युवाच जगद्गुरुम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006413045, "chapter_id": 26413, "verse_number": "२-७१-४६", "content_sanskrit": "एवंविधप्रभावं त्वं कृष्णं वदसि यद् द्विज ।\nएवमेतत् सुबहुशः श्रुतं खलु मया मुने ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006413046, "chapter_id": 26413, "verse_number": "२-७१-४७", "content_sanskrit": "यतश्चैवंविधः कृष्णस्ततोऽहं तस्य वै तरुम् ।\nन प्रदास्यामि दातव्यं सतां धर्ममनुस्मरन् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006413047, "chapter_id": 26413, "verse_number": "२-७१-४८", "content_sanskrit": "महाप्रभावो नाल्पार्थे रुष्येदिति विचिन्तयन् ।\nव्यवस्थितोऽहं भद्रं ते मुने सर्वगुणादिति ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006413048, "chapter_id": 26413, "verse_number": "२-७१-४९", "content_sanskrit": "महाप्रभावाः सततं भवन्ति हि सहिष्णवः ।\nश्रोतारश्चैव सततं वृद्धानां ज्ञानचक्षुषाम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006413049, "chapter_id": 26413, "verse_number": "२-७१-५०", "content_sanskrit": "महात्मा कारणे नाल्पे कृष्णो धर्मभृतां वरः ।\nभ्रात्रा ज्येष्ठेन सर्वज्ञो विरोधं गन्तुमर्हति ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006413050, "chapter_id": 26413, "verse_number": "२-७१-५१", "content_sanskrit": "यथैवं मम मातुः स वरं प्रादादधोक्षजः ।\nतथैव तस्याः पुत्राणां ज्येष्ठानां सोढुमर्हति ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006413051, "chapter_id": 26413, "verse_number": "२-७१-५२", "content_sanskrit": "यथैवोपेन्द्रतां यातः स्वयमिच्छञ्जनार्दनः ।\nतथैव भ्रातुरिन्द्रस्य सम्मानं कर्तुमर्हति ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006413052, "chapter_id": 26413, "verse_number": "२-७१-५३", "content_sanskrit": "ज्यैष्ठ्यमेतेन देवेन नारब्धं किं पुरातने ।\nअथेदानीमपीच्छेत् स ज्येष्ठोऽस्तु मधुसूदनः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006413053, "chapter_id": 26413, "verse_number": "२-७१-५४", "content_sanskrit": "सुनिश्चितं बलरिपुमीक्ष्य नारदो विसर्जितस्त्रिदशवरेण धर्मभृत् ।\nययौ पुरीं यदुवृषभाभिरक्षितां कुशस्थलीं धृतिमतिमांस्तपोधनः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]