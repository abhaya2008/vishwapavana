[{"id": 5000495000, "chapter_id": 9495, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे अष्टाशीतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000495001, "chapter_id": 9495, "verse_number": "६-८८-१", "content_sanskrit": "विभीषणवचः श्रुत्वा रावणिः क्रोधमूर्च्छितः।\nअब्रवीत् परुषं वाक्यं क्रोधेनाभ्युत्पपात च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000495002, "chapter_id": 9495, "verse_number": "६-८८-२", "content_sanskrit": "उद्यतायुधनिस्त्रिंशो रथे सुसमलंकृते।\nकालाश्वयुक्ते महति स्थितः कालान्तकोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000495003, "chapter_id": 9495, "verse_number": "६-८८-३", "content_sanskrit": "महाप्रमाणमुद्यम्य विपुलं वेगवद् दृढम्।\nधनुर्भीमबलो भीमं शरांश्चामित्रनाशनान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000495004, "chapter_id": 9495, "verse_number": "६-८८-४", "content_sanskrit": "तं ददर्श महेष्वासो रथस्थः समलंकृतः।\nअलंकृतममित्रघ्नो रावणस्यात्मजो बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000495005, "chapter_id": 9495, "verse_number": "६-८८-५", "content_sanskrit": "हनूमत्पृष्ठमारूढमुदयस्थरविप्रभम्।\nउवाचैनं सुसंरब्धः सौमित्रिं सविभीषणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000495006, "chapter_id": 9495, "verse_number": "६-८८-६", "content_sanskrit": "तांश्च वानरशार्दूलान् पश्यध्वं मे पराक्रमम्।\nअद्य मत्कार्मुकोत्सृष्टं शरवर्षं दुरासदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000495007, "chapter_id": 9495, "verse_number": "६-८८-७", "content_sanskrit": "मुक्तवर्षमिवाकाशे धारयिष्यथ संयुगे।\nअद्य वो मामका बाणा महाकार्मुकनिःसृताः।\nविधमिष्यन्ति गात्राणि तूलराशिमिवानलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000495008, "chapter_id": 9495, "verse_number": "६-८८-८", "content_sanskrit": "तीक्ष्णसायकनिर्भिन्नान् शूलशक्त्यृष्टितोमरैः।\nअद्य वो गमयिष्यामि सर्वानेव यमक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000495009, "chapter_id": 9495, "verse_number": "६-८८-९", "content_sanskrit": "सृजतः शरवर्षाणि क्षिप्रहस्तस्य संयुगे।\nजीमूतस्येव नदतः कः स्थास्यति ममाग्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000495010, "chapter_id": 9495, "verse_number": "६-८८-१०", "content_sanskrit": "रात्रियुद्धे तदा पूर्वं वज्राशनिसमैः शरैः।\nशायितौ तौ मया भूयो विसंज्ञौ सपुरःसरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000495011, "chapter_id": 9495, "verse_number": "६-८८-११", "content_sanskrit": "स्मृतिर्न तेऽस्ति वा मन्ये व्यक्तं यातो यमक्षयम्।\nआशीविषसमं क्रुद्धं यन्मां योद्धुमुपस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000495012, "chapter_id": 9495, "verse_number": "६-८८-१२", "content_sanskrit": "तच्छ्रुत्वा राक्षसेन्द्रस्य गर्जितं राघवस्तदा।\nअभीतवदनः क्रुद्धो रावणिं वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000495013, "chapter_id": 9495, "verse_number": "६-८८-१३", "content_sanskrit": "उक्तश्च दुर्गमः पारः कार्याणां राक्षस त्वया।\nकार्याणां कर्मणा पारं यो गच्छति स बुद्धिमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000495014, "chapter_id": 9495, "verse_number": "६-८८-१४", "content_sanskrit": "स त्वमर्थस्य हीनार्थो दुरवापस्य केनचित्।\nवाचा व्याहृत्य जानीषे कृतार्थोऽस्मीति दुर्मते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000495015, "chapter_id": 9495, "verse_number": "६-८८-१५", "content_sanskrit": "अन्तर्धानगतेनाजौ यत्त्वया चरितस्तदा।\nतस्कराचरितो मार्गो नैष वीरनिषेवितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000495016, "chapter_id": 9495, "verse_number": "६-८८-१६", "content_sanskrit": "यथा बाणपथं प्राप्य स्थितोऽस्मि तव राक्षस।\nदर्शयस्वाद्य तत्तेजो वाचा त्वं किं विकत्थसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000495017, "chapter_id": 9495, "verse_number": "६-८८-१७", "content_sanskrit": "एवमुक्तो धनुर्भीमं परामृश्य महाबलः।\nससर्ज निशितान् बाणानिन्द्रजित् समितिंजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000495018, "chapter_id": 9495, "verse_number": "६-८८-१८", "content_sanskrit": "तेन सृष्टा महावेगाः शराः सर्पविषोपमाः।\nसम्प्राप्य लक्ष्मणं पेतुः श्वसन्त इव पन्नगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000495019, "chapter_id": 9495, "verse_number": "६-८८-१९", "content_sanskrit": "शरैरतिमहावेगैर्वेगवान् रावणात्मजः।\nसौमित्रिमिन्द्रजिद् युद्धे विव्याध शुभलक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000495020, "chapter_id": 9495, "verse_number": "६-८८-२०", "content_sanskrit": "स शरैरतिविद्धाङ्गो रुधिरेण समुक्षितः।\nशुशुभे लक्ष्मणः श्रीमान् विधूम इव पावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000495021, "chapter_id": 9495, "verse_number": "६-८८-२१", "content_sanskrit": "इन्द्रजित् त्वात्मनः कर्म प्रसमीक्ष्याभिगम्य च।\nविनद्य सुमहानादमिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000495022, "chapter_id": 9495, "verse_number": "६-८८-२२", "content_sanskrit": "पत्रिणः शितधारास्ते शरा मत्कार्मुकच्युताः।\nआदास्यन्तेऽद्य सौमित्रे जीवितं जीवितान्तकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000495023, "chapter_id": 9495, "verse_number": "६-८८-२३", "content_sanskrit": "अद्य गोमायुसङ्घाश्च श्येनसङ्घाश्च लक्ष्मण।\nगृध्राश्च निपतन्तु त्वां गतासुं निहतं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000495024, "chapter_id": 9495, "verse_number": "६-८८-२४", "content_sanskrit": "क्षत्रबन्धुं सदानार्यं रामः परमदुर्मतिः।\nभक्तं भ्रातरमद्यैव त्वां द्रक्ष्यति हतं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000495025, "chapter_id": 9495, "verse_number": "६-८८-२५", "content_sanskrit": "विस्रस्तकवचं भूमौ व्यपविद्धशरासनम्।\nहृतोत्तमाङ्गं सौमित्रे त्वामद्य निहतं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000495026, "chapter_id": 9495, "verse_number": "६-८८-२६", "content_sanskrit": "इति ब्रुवाणं संक्रुद्धः परुषं रावणात्मजम्।\nहेतुमद् वाक्यमर्थज्ञो लक्ष्मणः प्रत्युवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000495027, "chapter_id": 9495, "verse_number": "६-८८-२७", "content_sanskrit": "वाग्बलं त्यज दुर्बुद्धे क्रूरकर्मन् हि राक्षस।\nअथ कस्माद् वदस्येतत् सम्पादय सुकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000495028, "chapter_id": 9495, "verse_number": "६-८८-२८", "content_sanskrit": "अकृत्वा कत्थसे कर्म किमर्थमिह राक्षस।\nकुरु तत् कर्म येनाहं श्रद्धेयं तव कत्थनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000495029, "chapter_id": 9495, "verse_number": "६-८८-२९", "content_sanskrit": "अनुक्त्वा परुषं वाक्यं किंचिदप्यनवक्षिपन्।\nअविकत्थन् वधिष्यामि त्वां पश्य पुरुषादन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000495030, "chapter_id": 9495, "verse_number": "६-८८-३०", "content_sanskrit": "इत्युक्त्वा पञ्च नाराचानाकर्णापूरितान् शरान्।\nविजघान महावेगाल्लक्ष्मणो राक्षसोरसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000495031, "chapter_id": 9495, "verse_number": "६-८८-३१", "content_sanskrit": "सुपत्रवाजिता बाणा ज्वलिता इव पन्नगाः।\nनैर्ऋतोरस्यभासन्त सवितू रश्मयो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000495032, "chapter_id": 9495, "verse_number": "६-८८-३२", "content_sanskrit": "स शरैराहतस्तेन सरोषो रावणात्मजः।\nसुप्रयुक्तैस्त्रिभिर्बाणैः प्रतिविव्याध लक्ष्मणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000495033, "chapter_id": 9495, "verse_number": "६-८८-३३", "content_sanskrit": "स बभूव महाभीमो नरराक्षससिंहयोः।\nविमर्दस्तुमुलो युद्धे परस्परजयैषिणोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000495034, "chapter_id": 9495, "verse_number": "६-८८-३४", "content_sanskrit": "विक्रान्तौ बलसम्पन्नावुभौ विक्रमशालिनौ।\nउभौ परमदुर्जेयावतुल्यबलतेजसौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000495035, "chapter_id": 9495, "verse_number": "६-८८-३५", "content_sanskrit": "युयुधाते तदा वीरौ ग्रहाविव नभोगतौ।\nबलवृत्राविव हि तौ युधि वै दुष्प्रधर्षणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000495036, "chapter_id": 9495, "verse_number": "६-८८-३६", "content_sanskrit": "युयुधाते महात्मानौ तदा केसरिणाविव।\nबहूनवसृजन्तौ हि मार्गणौघानवस्थितौ।\nनरराक्षसमुख्यौ तौ प्रहृष्टावभ्ययुध्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000495037, "chapter_id": 9495, "verse_number": "६-८८-३७", "content_sanskrit": "ततः शरान् दाशरथिः संधायामित्रकर्षणः।\nससर्ज राक्षसेन्द्राय क्रुद्धः सर्प इव श्वसन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000495038, "chapter_id": 9495, "verse_number": "६-८८-३८", "content_sanskrit": "तस्य ज्यातलनिर्घोषं स श्रुत्वा राक्षसाधिपः।\nविवर्णवदनो भूत्वा लक्ष्मणं समुदैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000495039, "chapter_id": 9495, "verse_number": "६-८८-३९", "content_sanskrit": "विवर्णवदनं दृष्ट्वा राक्षसं रावणात्मजम्।\nसौमित्रिं युद्धसंयुक्तं प्रत्युवाच विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000495040, "chapter_id": 9495, "verse_number": "६-८८-४०", "content_sanskrit": "निमित्तान्युपपश्यामि यान्यस्मिन् रावणात्मजे।\nत्वर तेन महाबाहो भग्न एष न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000495041, "chapter_id": 9495, "verse_number": "६-८८-४१", "content_sanskrit": "ततः संधाय सौमित्रिः शरानाशीविषोपमान्।\nमुमोच विशिखांस्तस्मिन् सर्पानिव विषोल्बणान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000495042, "chapter_id": 9495, "verse_number": "६-८८-४२", "content_sanskrit": "शक्राशनिसमस्पर्शैर्लक्ष्मणेनाहतः शरैः।\nमुहूर्तमभवन्मूढः सर्वसंक्षुभितेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000495043, "chapter_id": 9495, "verse_number": "६-८८-४३", "content_sanskrit": "उपलभ्य मुहूर्तेन संज्ञां प्रत्यागतेन्द्रियः।\nददर्शावस्थितं वीरमाजौ दशरथात्मजम्।\nसोऽभिचक्राम सौमित्रिं रोषात् संरक्तलोचनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000495044, "chapter_id": 9495, "verse_number": "६-८८-४४", "content_sanskrit": "अब्रवीच्चैनमासाद्य पुनः स परुषं वचः।\nकिं न स्मरसि तद् युद्धे प्रथमे मत्पराक्रमम्।\nनिबद्धस्त्वं सह भ्रात्रा यदा युधि विचेष्टसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000495045, "chapter_id": 9495, "verse_number": "६-८८-४५", "content_sanskrit": "युवां खलु महायुद्धे वज्राशनिसमैः शरैः।\nशायितौ प्रथमं भूमौ विसंज्ञौ सपुरःसरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000495046, "chapter_id": 9495, "verse_number": "६-८८-४६", "content_sanskrit": "स्मृतिर्वा नास्ति ते मन्ये व्यक्तं वा यमसादनम्।\nगन्तुमिच्छसि यन्मां त्वमाधर्षयितुमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000495047, "chapter_id": 9495, "verse_number": "६-८८-४७", "content_sanskrit": "यदि ते प्रथमे युद्धे न दृष्टो मत्पराक्रमः।\nअद्य त्वां दर्शयिष्यामि तिष्ठेदानीं व्यवस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000495048, "chapter_id": 9495, "verse_number": "६-८८-४८", "content_sanskrit": "इत्युक्त्वा सप्तभिर्बाणैरभिविव्याध लक्ष्मणम्।\nदशभिस्तु हनूमन्तं तीक्ष्णधारैः शरोत्तमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000495049, "chapter_id": 9495, "verse_number": "६-८८-४९", "content_sanskrit": "ततः शरशतेनैव सुप्रयुक्तेन वीर्यवान्।\nक्रोधाद् द्विगुणसंरब्धो निर्बिभेद विभीषणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000495050, "chapter_id": 9495, "verse_number": "६-८८-५०", "content_sanskrit": "तद् दृष्ट्वेन्द्रजिता कर्म कृतं रामानुजस्तदा।\nअचिन्तयित्वा प्रहसन्नैतत् किंचिदिति ब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000495051, "chapter_id": 9495, "verse_number": "६-८८-५१", "content_sanskrit": "मुमोच च शरान् घोरान् संगृह्य नरपुंगवः।\nअभीतवदनः क्रुद्धो रावणिं लक्ष्मणो युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000495052, "chapter_id": 9495, "verse_number": "६-८८-५२", "content_sanskrit": "नैवं रणगताः शूराः प्रहरन्ति निशाचर।\nलघवश्चाल्पवीर्याश्च शरा हीमे सुखास्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000495053, "chapter_id": 9495, "verse_number": "६-८८-५३", "content_sanskrit": "नैवं शूरास्तु युध्यन्ते समरे युद्धकाङ्क्षिणः।\nइत्येवं तं ब्रुवन् धन्वी शरैरभिववर्ष ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000495054, "chapter_id": 9495, "verse_number": "६-८८-५४", "content_sanskrit": "तस्य बाणैः सुविध्वस्तं कवचं काञ्चनं महत्।\nव्यशीर्यत रथोपस्थे ताराजालमिवाम्बरात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000495055, "chapter_id": 9495, "verse_number": "६-८८-५५", "content_sanskrit": "विधूतवर्मा नाराचैर्बभूव स कृतव्रणः।\nइन्द्रजित् समरे वीरः प्रत्यूषे भानुमानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000495056, "chapter_id": 9495, "verse_number": "६-८८-५६", "content_sanskrit": "ततः शरसहस्रेण संक्रुद्धो रावणात्मजः।\nबिभेद समरे वीरो लक्ष्मणं भीमविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000495057, "chapter_id": 9495, "verse_number": "६-८८-५७", "content_sanskrit": "व्यशीर्यत महद्दिव्यं कवचं लक्ष्मणस्य तु।\nकृतप्रतिकृतान्योन्यं बभूवतुररिंदमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000495058, "chapter_id": 9495, "verse_number": "६-८८-५८", "content_sanskrit": "अभीक्ष्णं निःश्वसन्तौ तौ युध्येतां तुमुलं युधि।\nशरसंकृत्तसर्वाङ्गौ सर्वतो रुधिरोक्षितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000495059, "chapter_id": 9495, "verse_number": "६-८८-५९", "content_sanskrit": "सुदीर्घकालं तौ वीरावन्योन्यं निशितैः शरैः।\nततक्षतुर्महात्मानौ रणकर्मविशारदौ।\nबभूवतुश्चात्मजये यत्तौ भीमपराक्रमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000495060, "chapter_id": 9495, "verse_number": "६-८८-६०", "content_sanskrit": "तौ शरौघैस्तथाकीर्णौ निकृत्तकवचध्वजौ।\nसृजन्तौ रुधिरं चोष्णं जलं प्रस्रवणाविव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000495061, "chapter_id": 9495, "verse_number": "६-८८-६१", "content_sanskrit": "शरवर्षं ततो घोरं मुञ्चतोर्भीमनिःस्वनम्।\nसासारयोरिवाकाशे नीलयोः कालमेघयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000495062, "chapter_id": 9495, "verse_number": "६-८८-६२", "content_sanskrit": "तयोरथ महान् कालो व्यतीयाद् युध्यमानयोः।\nन च तौ युद्धवैमुख्यं क्लमं चाप्युपजग्मतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000495063, "chapter_id": 9495, "verse_number": "६-८८-६३", "content_sanskrit": "अस्त्राण्यस्त्रविदां श्रेष्ठौ दर्शयन्तौ पुनः पुनः।\nशरानुच्चावचाकारानन्तरिक्षे बबन्धतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000495064, "chapter_id": 9495, "verse_number": "६-८८-६४", "content_sanskrit": "व्यपेतदोषमस्यन्तौ लघु चित्रं च सुष्ठु च।\nउभौ तु तुमुलं घोरं चक्रतुर्नरराक्षसौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000495065, "chapter_id": 9495, "verse_number": "६-८८-६५", "content_sanskrit": "तयोः पृथक् पृथग् भीमः शुश्रुवे तलनिस्वनः।\nस कम्पं जनयामास निर्घात इव दारुणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 5000495066, "chapter_id": 9495, "verse_number": "६-८८-६६", "content_sanskrit": "तयोः स भ्राजते शब्दस्तथा समरमत्तयोः।\nसुघोरयोर्निष्टनतोर्गगने मेघयोरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 5000495067, "chapter_id": 9495, "verse_number": "६-८८-६७", "content_sanskrit": "सुवर्णपुंखैर्नाराचैर्बलवन्तौ कृतव्रणौ।\nप्रसुस्रुवाते रुधिरं कीर्तिमन्तौ जये धृतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 5000495068, "chapter_id": 9495, "verse_number": "६-८८-६८", "content_sanskrit": "ते गात्रयोर्निपतिता रुक्मपुंखाः शरा युधि।\nअसृग्दिग्धा विनिष्पेतुर्विविशुर्धरणीतलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 5000495069, "chapter_id": 9495, "verse_number": "६-८८-६९", "content_sanskrit": "अन्ये सुनिशितैः शस्त्रैराकाशे संजघट्टिरे।\nबभञ्जुश्चिच्छिदुश्चैव तयोर्बाणाः सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 5000495070, "chapter_id": 9495, "verse_number": "६-८८-७०", "content_sanskrit": "स बभूव रणो घोरस्तयोर्बाणमयश्चयः।\nअग्निभ्यामिव दीप्ताभ्यां सत्रे कुशमयश्चयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 5000495071, "chapter_id": 9495, "verse_number": "६-८८-७१", "content_sanskrit": "तयोः कृतव्रणौ देहौ शुशुभाते महात्मनोः।\nसुपुष्पाविव निष्पत्रौ वने किंशुकशाल्मली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 5000495072, "chapter_id": 9495, "verse_number": "६-८८-७२", "content_sanskrit": "चक्रतुस्तुमुलं घोरं संनिपातं मुहुर्मुहुः।\nइन्द्रजिल्लक्ष्मणश्चैव परस्परजयैषिणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 5000495073, "chapter_id": 9495, "verse_number": "६-८८-७३", "content_sanskrit": "लक्ष्मणो रावणिं युद्धे रावणिश्चापि लक्ष्मणम्।\nअन्योन्यं तावभिघ्नन्तौ न श्रमं प्रतिपद्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 5000495074, "chapter_id": 9495, "verse_number": "६-८८-७४", "content_sanskrit": "बाणजालैः शरीरस्थैरवगाढैस्तरस्विनौ।\nशुशुभाते महावीर्यौ प्ररूढाविव पर्वतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 5000495075, "chapter_id": 9495, "verse_number": "६-८८-७५", "content_sanskrit": "तयो रुधिरसिक्तानि संवृतानि शरैर्भृशम्।\nबभ्राजुः सर्वगात्राणि ज्वलन्त इव पावकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 5000495076, "chapter_id": 9495, "verse_number": "६-८८-७६", "content_sanskrit": "तयोरथ महान् कालो व्यतीयाद् युध्यमानयोः।\nन च तौ युद्धवैमुख्यं श्रमं चाप्यभिजग्मतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 5000495077, "chapter_id": 9495, "verse_number": "६-८८-७७", "content_sanskrit": "अथ समरपरिश्रमं निहन्तुं\nसमरमुखेष्वजितस्य लक्ष्मणस्य।\nप्रियहितमुपपादयन् महात्मा\nसमरमुपेत्य विभीषणोऽवतस्थे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 5000495078, "chapter_id": 9495, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे अष्टाशीतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}]