[{"id": 7000211000, "chapter_id": 20211, "verse_number": "२११-१", "content_sanskrit": "कृष्णमानुषोत्सर्गकथनम् व्यास उवाच इत्युक्तो दारुकः कृष्णं प्रणिपत्य पुनः पुनः ।\nप्रदक्षिणं च बहुशः कृत्वा प्रायाद्यथोदितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000211001, "chapter_id": 20211, "verse_number": "२११-२", "content_sanskrit": "स च गत्वा तथा चक्रे द्वारकायां तथाऽऽर्जुनम् ।\nआनिनाय महाबुद्धिं वज्रं चक्रे तथा नृपम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000211002, "chapter_id": 20211, "verse_number": "२११-३", "content_sanskrit": "भगवानापि गोविन्दो वासुदेवात्मकं परम् ।\nब्रह्मात्मनि समारोप्य सर्वभूतेष्वधारयत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000211003, "chapter_id": 20211, "verse_number": "२११-४", "content_sanskrit": "स मानयन्द्विजवचो दुर्वासा यदुवाच ह ।\nयोगयुक्तोऽभत्पादं कृत्वा जानुनि सत्तमाः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000211004, "chapter_id": 20211, "verse_number": "२११-५", "content_sanskrit": "संप्राप्तो वै जरा नाम तदा तत्र स लुब्धकः ।\nमुशलशेषलोहस्य सायकं धारयन्परम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000211005, "chapter_id": 20211, "verse_number": "२११-६", "content_sanskrit": "स तत्पादं मृगाकारं समवेक्ष्य व्यवस्थितः ।\nततो विव्याध तेनैव तोमरेण द्विजोत्तमाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000211006, "chapter_id": 20211, "verse_number": "२११-७", "content_sanskrit": "गतश्च ददृशे तत्र चतुर्बाहुधरं नरम् ।\nप्रणिपत्याऽऽह चैवैनं प्रसीदेति पुनः पुनः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000211007, "chapter_id": 20211, "verse_number": "२११-८", "content_sanskrit": "अजानता कृतमिदं मया हरिणशङ्कया ।\nक्षम्यतामात्मपापेन दग्धं मा दग्धुमर्हसि ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000211008, "chapter_id": 20211, "verse_number": "२११-९", "content_sanskrit": "व्यास उवाच ततस्तं भगवानाह नास्ति ते भयमण्वपि ।\nगच्छ त्वं मत्प्रसादेन लुब्ध स्वर्गेश्वरास्पदम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000211009, "chapter_id": 20211, "verse_number": "२११-१०", "content_sanskrit": "व्यास उवाच विमानमागतं सद्यस्तद्वाक्यसमनन्तरम् ।\nआरुह्य प्रययौ स्वर्गं लुब्धकस्तत्प्रसादतः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000211010, "chapter_id": 20211, "verse_number": "२११-११", "content_sanskrit": "गते तस्मिन्स भगवान्संयोज्याऽऽत्मानमात्मनि ।\nब्रह्मभूतेऽव्ययेऽचिन्त्ये वासुदेवमयेऽमले ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000211011, "chapter_id": 20211, "verse_number": "२११-१२", "content_sanskrit": "अजन्मन्यजरेऽनाशिन्यप्रमेयेऽखिलात्मनि ।\nत्यक्त्वा स मानुषं देहमवाप त्रिविधां गतिम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}]