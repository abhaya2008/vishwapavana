[{"id": 5000090000, "chapter_id": 9090, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे त्रयोदशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000090001, "chapter_id": 9090, "verse_number": "२-१३-१", "content_sanskrit": "अतदर्हं महाराजं शयानमतथोचितम्।\nययातिमिव पुण्यान्ते देवलोकात् परिच्युतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000090002, "chapter_id": 9090, "verse_number": "२-१३-२", "content_sanskrit": "अनर्थरूपासिद्धार्था ह्यभीता भयदर्शिनी।\nपुनराकारयामास तमेव वरमङ्गना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000090003, "chapter_id": 9090, "verse_number": "२-१३-३", "content_sanskrit": "त्वं कत्थसे महाराज सत्यवादी दृढव्रतः।\nमम चेदं वरं कस्माद् विधारयितुमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000090004, "chapter_id": 9090, "verse_number": "२-१३-४", "content_sanskrit": "एवमुक्तस्तु कैकेय्या राजा दशरथस्तदा।\nप्रत्युवाच ततः क्रुद्धो मुहूर्तं विह्वलन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000090005, "chapter_id": 9090, "verse_number": "२-१३-५", "content_sanskrit": "मृते मयि गते रामे वनं मनुजपुङ्गवे।\nहन्तानार्ये ममामित्रे सकामा सुखिनी भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000090006, "chapter_id": 9090, "verse_number": "२-१३-६", "content_sanskrit": "स्वर्गेऽपि खलु रामस्य कुशलं दैवतैरहम्।\nप्रत्यादेशादभिहितं धारयिष्ये कथं बत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000090007, "chapter_id": 9090, "verse_number": "२-१३-७", "content_sanskrit": "कैकेय्याः प्रियकामेन रामः प्रव्राजितो वनम्।\nयदि सत्यं ब्रवीम्येतत् तदसत्यं भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000090008, "chapter_id": 9090, "verse_number": "२-१३-८", "content_sanskrit": "अपुत्रेण मया पुत्रः श्रमेण महता महान्।\nरामो लब्धो महातेजाः स कथं त्यज्यते मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000090009, "chapter_id": 9090, "verse_number": "२-१३-९", "content_sanskrit": "शूरश्च कृतविद्यश्च जितक्रोधः क्षमापरः।\nकथं कमलपत्राक्षो मया रामो विवास्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000090010, "chapter_id": 9090, "verse_number": "२-१३-१०", "content_sanskrit": "कथमिन्दीवरश्यामं दीर्घबाहुं महाबलम्।\nअभिराममहं रामं स्थापयिष्यामि दण्डकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000090011, "chapter_id": 9090, "verse_number": "२-१३-११", "content_sanskrit": "सुखानामुचितस्यैव दुःखैरनुचितस्य च।\nदुःखं नामानुपश्येयं कथं रामस्य धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000090012, "chapter_id": 9090, "verse_number": "२-१३-१२", "content_sanskrit": "यदि दुःखमकृत्वा तु मम संक्रमणं भवेत्।\nअदुःखार्हस्य रामस्य ततः सुखमवाप्नुयाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000090013, "chapter_id": 9090, "verse_number": "२-१३-१३", "content_sanskrit": "नृशंसे पापसंकल्पे रामं सत्यपराक्रमम्।\nकिं विप्रियेण कैकेयि प्रियं योजयसे मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000090014, "chapter_id": 9090, "verse_number": "२-१३-१४", "content_sanskrit": "अकीर्तिरतुला लोके ध्रुवं परिभविष्यति।\nतथा विलपतस्तस्य परिभ्रमितचेतसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000090015, "chapter_id": 9090, "verse_number": "२-१३-१५", "content_sanskrit": "अस्तमभ्यागमत् सूर्यो रजनी चाभ्यवर्तत।\nसा त्रियामा तदार्तस्य चन्द्रमण्डलमण्डिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000090016, "chapter_id": 9090, "verse_number": "२-१३-१६", "content_sanskrit": "राज्ञो विलपमानस्य न व्यभासत शर्वरी।\nसदैवोष्णं विनिःश्वस्य वृद्धो दशरथो नृपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000090017, "chapter_id": 9090, "verse_number": "२-१३-१७", "content_sanskrit": "विललापार्तवद् दुःखं गगनासक्तलोचनः।\nन प्रभातं त्वयेच्छामि निशे नक्षत्रभूषिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000090018, "chapter_id": 9090, "verse_number": "२-१३-१८", "content_sanskrit": "क्रियतां मे दया भद्रे मयायं रचितोऽञ्जलिः।\nअथवा गम्यतां शीघ्रं नाहमिच्छामि निर्घृणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000090019, "chapter_id": 9090, "verse_number": "२-१३-१९", "content_sanskrit": "नृशंसां केकयीं द्रष्टुं यत्कृते व्यसनं मम।\nएवमुक्त्वा ततो राजा कैकेयीं संयताञ्जलिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000090020, "chapter_id": 9090, "verse_number": "२-१३-२०", "content_sanskrit": "प्रसादयामास पुनः कैकेयीं राजधर्मवित्।\nसाधुवृत्तस्य दीनस्य त्वद्‍गतस्य गतायुषः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000090021, "chapter_id": 9090, "verse_number": "२-१३-२१", "content_sanskrit": "प्रसादः क्रियतां भद्रे देवि राज्ञो विशेषतः।\nशून्ये न खलु सुश्रोणि मयेदं समुदाहृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000090022, "chapter_id": 9090, "verse_number": "२-१३-२२", "content_sanskrit": "कुरु साधुप्रसादं मे बाले सहृदया ह्यसि।\nप्रसीद देवि रामो मे त्वद्दत्तं राज्यमव्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000090023, "chapter_id": 9090, "verse_number": "२-१३-२३", "content_sanskrit": "लभतामसितापाङ्गे यशः परमवाप्स्यसि।\nमम रामस्य लोकस्य गुरूणां भरतस्य च।\nप्रियमेतद् गुरुश्रोणि कुरु चारुमुखेक्षणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000090024, "chapter_id": 9090, "verse_number": "२-१३-२४", "content_sanskrit": "विशुद्धभावस्य हि दुष्टभावा\nदीनस्य ताम्राश्रुकलस्य राज्ञः।\nश्रुत्वा विचित्रं करुणं विलापं\nभर्तुर्नृशंसा न चकार वाक्यम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000090025, "chapter_id": 9090, "verse_number": "२-१३-२५", "content_sanskrit": "ततः स राजा पुनरेव मूर्च्छितः\nप्रियामतुष्टां प्रतिकूलभाषिणीम्।\nसमीक्ष्य पुत्रस्य विवासनं प्रति\nक्षितौ विसंज्ञो निपपात दुःखितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000090026, "chapter_id": 9090, "verse_number": "२-१३-२६", "content_sanskrit": "इतीव राज्ञो व्यथितस्य सा निशा\nजगाम घोरं श्वसतो मनस्विनः।\nविबोध्यमानः प्रतिबोधनं तदा\nनिवारयामास स राजसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000090027, "chapter_id": 9090, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे त्रयोदशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]