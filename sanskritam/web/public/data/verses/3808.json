[{"id": 2130253, "chapter_id": 3808, "verse_number": "", "content_sanskrit": "हनूमान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2130254, "chapter_id": 3808, "verse_number": "१", "content_sanskrit": "हृतदारः सह भ्रात्रा पत्नीं मार्गन् स राघवः ।\nदृष्टवान् शैलशिखरे सुग्रीवं वानरर्षभम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2130255, "chapter_id": 3808, "verse_number": "२", "content_sanskrit": "तेन तस्याभवत् सख्यं राघवस्य महात्मनः ।\nस हत्वा वालिनं राज्ये सुग्रीवमभिषिक्तवान्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2130256, "chapter_id": 3808, "verse_number": "३", "content_sanskrit": "स राज्यं प्राप्य सुग्रीवः सीतायाः परिमार्गणे ।\nवानरान् प्रेषयामास शतशोऽथ सहस्रशः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2130257, "chapter_id": 3808, "verse_number": "४", "content_sanskrit": "ततो वानरकोटीभिः सहितोऽहं नरर्षभ ।\nसीतां मार्गन् महाबाहो प्रयातो दक्षिणां दिशम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2130258, "chapter_id": 3808, "verse_number": "५", "content_sanskrit": "तत्र प्रवृत्तिः सीताया गृध्रेणैव महात्मना ।\nसम्पातिना समाख्याता रावणस्य निवेशने\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2130259, "chapter_id": 3808, "verse_number": "", "content_sanskrit": "ततोऽहं कार्यसिद्ध्यर्थं रामस्याक्लिष्टकर्मणः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2130260, "chapter_id": 3808, "verse_number": "", "content_sanskrit": "शतयोजनविस्तीर्णमर्णवं सहसाऽऽप्लुतः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2130261, "chapter_id": 3808, "verse_number": "६", "content_sanskrit": "सम्पातिगृध्राधिगतप्रवृत्तिः पाण्डुनन्दन \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2130262, "chapter_id": 3808, "verse_number": "७", "content_sanskrit": "अहं स्ववीर्यादुत्तीर्य सागरं मकरालयम् ।\nसुतां जनकराजस्य सीतां सुरसुतोपमाम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2130263, "chapter_id": 3808, "verse_number": "८", "content_sanskrit": "दृष्टवान् भरतश्रेष्ठ रावणस्य निवेशने\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2130264, "chapter_id": 3808, "verse_number": "९", "content_sanskrit": "समेत्य तामहं देवीं वैदेहीं राघवप्रियाम् ।\nदग्ध्वा लङ्कामशेषेण साट्टप्राकारतोरणाम् ।\nप्रत्यागतः पुनश्चापि नाम तत्र प्रकाश्य वै।\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2130265, "chapter_id": 3808, "verse_number": "१०", "content_sanskrit": "मद्वाक्यं चावधार्याशु रामो राजीवलोचनः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2130266, "chapter_id": 3808, "verse_number": "११", "content_sanskrit": "अबद्धपूर्वमन्यैश्च बद्ध्वा सेतुं महोदधौ ।\nवृतो वानरकोटीभिः समुत्तीर्णो महार्णवम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2130267, "chapter_id": 3808, "verse_number": "१२", "content_sanskrit": "रणे स राक्षसगणं रावणं लोकरावणम् ।\nनिशाचरेन्द्रं हत्वा तु सभ्रातृसुतबान्धवम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2130268, "chapter_id": 3808, "verse_number": "१३", "content_sanskrit": "राज्येऽभिषिच्य लङ्कायां राक्षसेन्द्रं विभीषणम् ।\nधार्मिकं भक्तिमन्तं च भक्तानुगतवत्सलम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2130269, "chapter_id": 3808, "verse_number": "१४", "content_sanskrit": "प्रत्याहृत्य ततः सीतां नष्टां वेदश्रुतीमिव ।\nतयैव सहितः साध्व्या पत्न्या रामो महायशाः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2130270, "chapter_id": 3808, "verse_number": "१५", "content_sanskrit": "गत्वा ततोऽतित्वरितः स्वां पुरीं रघुनन्दनः ।\nअध्यावसत् ततोऽयोध्यामयोध्यां द्विषतां प्रभुः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2130271, "chapter_id": 3808, "verse_number": "१६", "content_sanskrit": "ततः प्रतिष्ठितो राज्ये रामो नृपतिसत्तमः ।\nवरं मया याचितोऽसौ रामो राजीवलोचनः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2130272, "chapter_id": 3808, "verse_number": "१७", "content_sanskrit": "यावद्रामकथेयं ते भवेल्लोकेषु शत्रुहन् ।\nतावज्जीवेयमित्येवं तथास्त्विति च सोऽब्रवीत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2130273, "chapter_id": 3808, "verse_number": "१८", "content_sanskrit": "सीताप्रसादाच्च सदा मामिहस्थमरिन्दम ।\nउपतिष्ठन्ति दिव्या हि भोगा भीम यथेप्सिताः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2130274, "chapter_id": 3808, "verse_number": "१९", "content_sanskrit": "दशवर्षसहस्राणि दशवर्षशतानि च ।\nराज्यं कारितवान् रामस्ततः स्वभवनं गतः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2130275, "chapter_id": 3808, "verse_number": "२०", "content_sanskrit": "तदिहाप्सरसस्तात गन्धर्वाश्च सदानघ ।\nतस्य वीरस्य चरितं गायन्तो रमयन्ति माम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2130276, "chapter_id": 3808, "verse_number": "२१", "content_sanskrit": "अयं च मार्गो मर्त्यानामगम्यः कुरुनन्दन ।\nततोऽहं रुद्धवान् मार्गं तवेमं देवसेवितम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2130277, "chapter_id": 3808, "verse_number": "२२", "content_sanskrit": "त्वामनेन तथा यान्तं यक्षो वा राक्षसोऽपि वा ।\nधर्षयेद् वा शपेद् वापि मा कश्चिदिति भारत\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2130278, "chapter_id": 3808, "verse_number": "२३", "content_sanskrit": "दिव्यो देवपथो ह्येष नात्र गच्छन्ति मानुषाः ।\nयदर्थमागतश्चासि अत एव सरश्च तत्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2130279, "chapter_id": 3808, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2130280, "chapter_id": 3808, "verse_number": "१४५", "content_sanskrit": "पञ्चचत्वारिंशदधिकशततमोऽध्यायः ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2130281, "chapter_id": 3808, "verse_number": "१०१", "content_sanskrit": "॥ इति तीर्थयात्रापर्वणि एकाधिकशततमोऽध्यायः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2130282, "chapter_id": 3808, "verse_number": "", "content_sanskrit": "* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]