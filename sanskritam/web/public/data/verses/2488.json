[{"id": 2070743, "chapter_id": 2488, "verse_number": "११-२०-०x", "content_sanskrit": "गान्धार्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2070744, "chapter_id": 2488, "verse_number": "११-२०-१", "content_sanskrit": "अध्यर्धगुणमाहुर्यं बले शौर्ये च केशव।\nपित्रा त्वया च दाशार्ह दृप्तं सिंहमिवोत्कटम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2070745, "chapter_id": 2488, "verse_number": "११-२०-२", "content_sanskrit": "यो बिभेद चमूमेको मम पुत्रस्य दुर्भिदाम्।\nस भूत्वा मृत्युरन्येषां स्वयं मृत्युवशं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2070746, "chapter_id": 2488, "verse_number": "११-२०-३", "content_sanskrit": "तस्योपलक्षये कृष्ण कार्ष्णेरमिततेजसः।\nअभिमन्योर्हतस्यापि प्रभा नैवोपशाम्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2070747, "chapter_id": 2488, "verse_number": "११-२०-४", "content_sanskrit": "एषा विराटदुहिता स्नुषा गाण्डीवधन्वनः।\nहतं बाला पतिं वीरं दृष्ट्वा शोचत्यनिन्दिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2070748, "chapter_id": 2488, "verse_number": "११-२०-५", "content_sanskrit": "तमेषा हि समागम्य भार्या भर्तारमन्तिके।\nविराटदुहिता कृष्ण पाणिना परिमार्जति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2070749, "chapter_id": 2488, "verse_number": "११-२०-६", "content_sanskrit": "तस्य वक्त्रमुपाघ्राय सौभद्रस्य मनस्विनी।\nविबुद्धकमलाकारं कम्बुवृत्तशिरोधरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2070750, "chapter_id": 2488, "verse_number": "११-२०-७", "content_sanskrit": "कामरूपवती चैषा परिष्वजति भामिनी।\nलज्जमाना पुरा चैनं माध्वीकमदमूर्च्छिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2070751, "chapter_id": 2488, "verse_number": "११-२०-८", "content_sanskrit": "तस्य क्षतजसन्दिग्धं जातरूपपरिष्कृतम्।\nविमुच्य कवचं कृष्ण शीरमभिवीक्षते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2070752, "chapter_id": 2488, "verse_number": "११-२०-९", "content_sanskrit": "अवेक्षमाणा तं बाला कुष्ण त्वामभिभाषते।\nअयं ते पुण्डरीकाक्ष कसदृशाक्षो निपातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2070753, "chapter_id": 2488, "verse_number": "११-२०-१०", "content_sanskrit": "बले वीर्ये च सदृशस्तेजसा चैव तेऽनघ।\nरूपेण च तथाऽत्यर्थं शेते भुवि निपातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2070754, "chapter_id": 2488, "verse_number": "११-२०-११", "content_sanskrit": "अत्यन्तं सुकुमारस्य राङ्कवाजिनशायिनः।\nकच्चिदद्य शरीरं ते भूमौ न परितप्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2070755, "chapter_id": 2488, "verse_number": "११-२०-१२", "content_sanskrit": "मातङ्गभुजवर्ष्णाणौ ज्याक्षेपकठिनत्वचौ।\nकाञ्चनाङ्गदिनौ शेते निक्षिप्य विपुलौ भुजौ।\nव्यायम्य बहुधा नूनं सुखसुप्तः श्रमादिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2070756, "chapter_id": 2488, "verse_number": "११-२०-१३", "content_sanskrit": "एवं विलपतीमार्तां किं मां न प्रतिभाषसे।\nन स्मराम्यपराधं ते किं मां न प्रतिभाषसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2070757, "chapter_id": 2488, "verse_number": "११-२०-१४", "content_sanskrit": "ननु मां त्वं पुरा दूरादभिवीक्ष्याभिभाषसे।\nन स्मराम्यपराधं मे किं मां न प्रतिभाषसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2070758, "chapter_id": 2488, "verse_number": "११-२०-१५", "content_sanskrit": "आर्यामार्य सुभद्रां तवमिमां श्च त्रिदशोपमान्।\nपितॄन्मां चैव दुःखार्तां विहाय क्व गमिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2070759, "chapter_id": 2488, "verse_number": "११-२०-१६", "content_sanskrit": "तस्य शोणितदिग्धान्वै केशानुन्नम्य पाणिना।\nउत्सङ्गे वक्तमाधाय जीवन्तमिव पृच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2070760, "chapter_id": 2488, "verse_number": "११-२०-१७", "content_sanskrit": "स्वस्रीयं वासुदेवस्य पुत्रं गाण्डीवधन्वनः।\nकथं त्वां रणमध्यस्थं जघ्रुरेते महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2070761, "chapter_id": 2488, "verse_number": "११-२०-१८", "content_sanskrit": "धिगस्तु क्रूरकर्तॄंस्तान्कृपकर्णजयद्रथान्।\nद्रोणद्रौणायतनी चोभौ यैरहं विधवा कृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2070762, "chapter_id": 2488, "verse_number": "११-२०-१९", "content_sanskrit": "रथर्षभाणां सर्वेषां कथमासीत्तदा मनः।\nबालं त्वां पिरवार्यैकमनेकेषां च जघ्नताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2070763, "chapter_id": 2488, "verse_number": "११-२०-२०", "content_sanskrit": "कथं नु पाण्डवानां च पाञ्चालानां तु पश्यताम्।\nत्वं वीर निधनं प्राप्तो नाथवान्सन्ननाथवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2070764, "chapter_id": 2488, "verse_number": "११-२०-२१", "content_sanskrit": "दृष्ट्वा बहुभिराक्रन्दे निहतं त्वां पिता तव।\nवीरः पुरुषशार्दूलः कथं जीवति पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2070765, "chapter_id": 2488, "verse_number": "११-२०-२२", "content_sanskrit": "न राज्यलाभो विपुलः शत्रूणां च पराभवः।\nप्रीतिं धास्यति पार्थानां त्वामृते पुष्करेक्षण॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2070766, "chapter_id": 2488, "verse_number": "११-२०-२३", "content_sanskrit": "तव शस्त्रजिताँल्लोकान्धर्मेण च दमेन च।\nक्षिप्रमन्वागमिष्यामि तत्र मां प्रतिपालय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2070767, "chapter_id": 2488, "verse_number": "११-२०-२४", "content_sanskrit": "दुर्मरं पुनरप्राप्ते काले भवति केनचित्।\nयदहं त्वां रणे दृष्ट्वा हतं जीवामि दुर्भगा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2070768, "chapter_id": 2488, "verse_number": "११-२०-२५", "content_sanskrit": "कामिदानीं नरव्याघ्र श्लक्ष्णया स्मितया गिरा।\nपितृलोके समेत्यान्यां मामिवामन्त्रयिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2070769, "chapter_id": 2488, "verse_number": "११-२०-२६", "content_sanskrit": "नूनमप्सरसां स्वर्गे मनांसि प्रमथिष्यसि।\nपरमेण च रूपेण गिरा च स्मितपूर्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2070770, "chapter_id": 2488, "verse_number": "११-२०-२७", "content_sanskrit": "प्राप्य पुण्यकृताँल्लोकानप्सरोभिः समेयिवान्।\nसौभद्र विहन्काले स्मरेथाः सुकृतानि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2070771, "chapter_id": 2488, "verse_number": "११-२०-२८", "content_sanskrit": "एतावानिह संवासो विहितस्ते मया सह।\nषण्मासान्सप्तमे मासि त्वं वीर निधनं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2070772, "chapter_id": 2488, "verse_number": "११-२०-२९", "content_sanskrit": "इत्युक्तवचनामेनामपकर्षन्ति दुःखिताम्।\nउत्तरां मोघसङ्कल्पां मत्स्यराजकुलस्त्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2070773, "chapter_id": 2488, "verse_number": "११-२०-३०", "content_sanskrit": "उत्तरामपकृष्यैनामार्तामार्ततराः स्वयम्।\nविराटं निहतं दृष्ट्वा क्रोशन्ति विलपन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2070774, "chapter_id": 2488, "verse_number": "११-२०-३१", "content_sanskrit": "द्रोणास्त्रशरसङ्कृत्तं शयानं रुधिरोक्षितम्।\nविराटं वितुदन्त्येते गृध्रगोमायुवायसाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2070775, "chapter_id": 2488, "verse_number": "११-२०-३२", "content_sanskrit": "वितुद्यमानं विहगैर्विराटमसितेक्षणाः।\nन शक्नुवन्ति विहगान्निवारयितुमातुराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2070776, "chapter_id": 2488, "verse_number": "११-२०-३३", "content_sanskrit": "आसामातपतप्तानामायासेन च योषिताम्।\nश्रमेण च विवर्णानां वक्त्राणां विप्लुतं वपुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2070777, "chapter_id": 2488, "verse_number": "११-२०-३४", "content_sanskrit": "उत्तरं चाभिमन्युं च काम्भोजं च सुदक्षिणम्।\nकार्ष्णिनाऽभिहतं पश्य लक्ष्मणं प्रियदर्शनम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2070778, "chapter_id": 2488, "verse_number": "११-२०-३५", "content_sanskrit": "आयोधनशिरोमध्ये शयानं पश्य माधव॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2070779, "chapter_id": 2488, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]