[{"id": 2090323, "chapter_id": 2920, "verse_number": "१३-५०-१", "content_sanskrit": "युधिष्ठिर उवाच।\nयदिदं सहधर्मेति प्रोच्यते भरतर्षभ।\nपाणिग्रहणकाले तु स्त्रीणामेतत्कथं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2090324, "chapter_id": 2920, "verse_number": "१३-५०-२", "content_sanskrit": "आर्ष एष भवेद्धर्मः प्राजापत्योऽथवाऽसुरः।\nयदेतत्सहधर्मेति पूर्वमुक्तं महर्षिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2090325, "chapter_id": 2920, "verse_number": "१३-५०-३", "content_sanskrit": "सन्देहः सुमहानेष विरुद्ध इति मे मतिः।\nइह यः सहधर्मो वै प्रेत्यायं विहितः क्वनु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2090326, "chapter_id": 2920, "verse_number": "१३-५०-४", "content_sanskrit": "स्वर्गो मृतानां भवति सहधर्मः पितामह।\nपूर्वमेकस्तु म्रिय********कस्तिष्ठते वद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2090327, "chapter_id": 2920, "verse_number": "१३-५०-५", "content_sanskrit": "नानाधर्मफलोपेता नानाकर्मनिवासिताः।\nनानानिरयनिष्ठान्ता मानुपा बहवो यदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2090328, "chapter_id": 2920, "verse_number": "१३-५०-६", "content_sanskrit": "अनृताः स्त्रिय इत्येवं सूत्रकारो व्यवस्यति।\nयदाऽनृताः स्त्रियस्तात सहधर्मः कुतः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2090329, "chapter_id": 2920, "verse_number": "१३-५०-७", "content_sanskrit": "अनृताः स्त्रिय इत्येवं वेदेष्वपि हि पठ्यते।\nधर्मो यः पूर्विको दृष्ट उपचारः क्रियाविधिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2090330, "chapter_id": 2920, "verse_number": "१३-५०-८", "content_sanskrit": "गहरं प्रतिभात्येतन्मम चिन्तयतोऽनिशम्।\nनिःसन्देहमिदं सर्वं पितामह यथाश्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2090331, "chapter_id": 2920, "verse_number": "१३-५०-९", "content_sanskrit": "यदैतद्यादृशं चैतद्यथा चैतत्प्रवर्तितम्।\nनिखिलेन महाप्राज्ञ भवानेतद्ब्रवीतु मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2090332, "chapter_id": 2920, "verse_number": "१३-५०-१०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2090333, "chapter_id": 2920, "verse_number": "१३-५०-१०", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nअष्टावक्रस्य संवादं दिशया सह भारत॥ i", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2090334, "chapter_id": 2920, "verse_number": "१३-५०-११", "content_sanskrit": "निर्विष्टुकामस्तु पुरा अष्टावक्रो महातपाः।\nऋषेरथ वदान्यस्य वव्रे कन्यां महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2090335, "chapter_id": 2920, "verse_number": "१३-५०-१२", "content_sanskrit": "सुप्रभां नाम वै नाम्ना रूपेणाप्रतिमां भुवि।\nगुणप्रभावशीलेन चारित्रेण च शोभनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2090336, "chapter_id": 2920, "verse_number": "१३-५०-१३", "content_sanskrit": "सा तस्यर्षेर्मनो दृष्टा जहार शुभलोचना।\nवनराजी यथा चित्रा वसन्ते कुसुमाञचिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2090337, "chapter_id": 2920, "verse_number": "१३-५०-१४", "content_sanskrit": "ऋषिस्तमाह देया मे सुता तुभ्यं हि तच्छृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2090338, "chapter_id": 2920, "verse_number": "१३-५०-१५", "content_sanskrit": "`अनन्यस्त्रीजनः प्राज्ञो ह्यप्रवासी प्रियंवदः।\nसुरूपः सम्मतो वीरः शीलवान्भोगभुक्छुचिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2090339, "chapter_id": 2920, "verse_number": "१३-५०-१६", "content_sanskrit": "दारानुमतयज्ञश्च सुनक्षत्रामथोद्वेहेत्।\nसभृत्यः स्वजनोपेत इह प्रेत्य च मोदते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2090340, "chapter_id": 2920, "verse_number": "१३-५०-१७", "content_sanskrit": "गच्छ तावद्दिशं पुण्यामुत्तरां द्रक्ष्यसे ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2090341, "chapter_id": 2920, "verse_number": "१३-५०-१८x", "content_sanskrit": "अष्टावक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2090342, "chapter_id": 2920, "verse_number": "१३-५०-१८", "content_sanskrit": "किं द्रष्टव्यं मया तत्र वक्तुमर्हति मे भवान्।\nतथेदानीं मयो कार्यं यथा वक्ष्यति मां भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2090343, "chapter_id": 2920, "verse_number": "१३-५०-१९x", "content_sanskrit": "वदान्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2090344, "chapter_id": 2920, "verse_number": "१३-५०-१९", "content_sanskrit": "धनदं समतिक्रम्य हिमवन्तं च पर्वतम्।\nरुद्रस्यायतनं दृष्ट्वा सिद्धचारणसेवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2090345, "chapter_id": 2920, "verse_number": "१३-५०-२०", "content_sanskrit": "संहृष्टैः पार्षदैर्जुष्टं नृत्यद्भिर्विविधाननैः।\nदिव्याङ्गरागैः पैशाचैरन्यैर्नानाविधैः प्रभोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2090346, "chapter_id": 2920, "verse_number": "१३-५०-२१", "content_sanskrit": "पाणितालसुतालैश्च शम्पातालैः समैस्तथा।\nसम्प्रहृष्टैः प्रनृत्यद्भिः शर्वस्तत्र निषेव्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2090347, "chapter_id": 2920, "verse_number": "१३-५०-२२", "content_sanskrit": "इष्टं किल गिरौ स्थानं तद्दिव्यमिति शुश्रुम।\nनित्यं सन्निहितो देवस्तथा ते पार्षदाः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2090348, "chapter_id": 2920, "verse_number": "१३-५०-२३", "content_sanskrit": "तत्र देव्या तपस्तप्तं सङ्करार्थं सुदुश्चरम्।\nअतस्तदिष्टं देवस्य तथोमाया इति श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2090349, "chapter_id": 2920, "verse_number": "१३-५०-२४", "content_sanskrit": "पूर्वे तत्र महापार्श्वे देवस्योत्तरतस्तथा॥\nऋतवः कालरात्रिश्च ये दिव्या ये च मानुषाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2090350, "chapter_id": 2920, "verse_number": "१३-५०-२५", "content_sanskrit": "देवं चोपासते सर्वे रूपिणः किल तत्र ह।\nतदतिक्रम्य भवनं त्वया यातव्यमेव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2090351, "chapter_id": 2920, "verse_number": "१३-५०-२६", "content_sanskrit": "ततो नीलं वनोद्देशं द्रक्ष्यसे मेघसन्निभम्।\nरमणीयं मनोग्राहि तत्र वै द्रक्ष्यसे स्त्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2090352, "chapter_id": 2920, "verse_number": "१३-५०-२७", "content_sanskrit": "तपस्विनीं महाभागां वृद्धां दीक्षामनुष्ठिताम्।\nद्रष्टव्या सा त्वया तत्र सम्पूज्या चैव यत्नतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2090353, "chapter_id": 2920, "verse_number": "१३-५०-२८", "content_sanskrit": "तां दृष्ट्वा विनिवृत्तस्त्वं ततः पाणिं ग्रहीष्यसि।\nयद्येष समयः सर्वः साध्यतां तत्र गम्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2090354, "chapter_id": 2920, "verse_number": "१३-५०-२९x", "content_sanskrit": "अष्टावक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2090355, "chapter_id": 2920, "verse_number": "१३-५०-२९", "content_sanskrit": "तथाऽस्तु साधयिष्यामि तत्र यास्याम्यसंशयम्।\nयत्र त्वं वदसे साधो भवान्भवतु सत्यवाक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2090356, "chapter_id": 2920, "verse_number": "१३-५०-३०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2090357, "chapter_id": 2920, "verse_number": "१३-५०-३०", "content_sanskrit": "ततोऽगच्छत्स भगवानुत्तरामुत्तरां दिशम्।\nहिमवन्तं गिरिश्रेष्ठं सिद्धचारणसेवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2090358, "chapter_id": 2920, "verse_number": "१३-५०-३१", "content_sanskrit": "स गत्वा द्विजशार्दूलो हिमवन्तं महागिरिम्।\nअभ्यगच्छन्नदीं पुण्यां बाहुदां पुण्यदायिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2090359, "chapter_id": 2920, "verse_number": "१३-५०-३२", "content_sanskrit": "अशोके विमले तीर्थे स्नात्वा वै तर्प्य देवताः।\nतत्र वासाय शयने कौशे सुखमुवास ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2090360, "chapter_id": 2920, "verse_number": "१३-५०-३३", "content_sanskrit": "ततो रात्र्यां व्यतीतायां प्रातरुत्थाय स द्विजः।\nस्नात्वा प्रादुश्चकाराग्निं हुत्वा चैवं विधानतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2090361, "chapter_id": 2920, "verse_number": "१३-५०-३४", "content_sanskrit": "रुद्राणीकूपमासाद्य ह्रदे तत्र समाश्वसत्।\nविश्रान्तश्च समुत्थाय कैलासमभितो ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2090362, "chapter_id": 2920, "verse_number": "१३-५०-३५", "content_sanskrit": "सोऽपश्यत्काञ्चनद्वारं दीप्यमानमिव श्रिया।\nमन्दाकिनीं च नलिनीं धनदस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2090363, "chapter_id": 2920, "verse_number": "१३-५०-३६", "content_sanskrit": "अथ ते राक्षसाः सर्वे येऽभिरक्षन्ति पद्मिनीम्।\nप्रत्युत्थिता भगवन्तं माणिभद्रपुरोगमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2090364, "chapter_id": 2920, "verse_number": "१३-५०-३७", "content_sanskrit": "स तान्प्रत्यर्चयामास राक्षसान्भीमविक्रमान्।\nनिवेदयत मां क्षिप्रं धनदायेति चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2090365, "chapter_id": 2920, "verse_number": "१३-५०-३८", "content_sanskrit": "ते राक्षसास्तथा राजन्भगवन्तमथाब्रुवन्।\nअसौ वैश्रवणो राजा स्वयमायाति तेऽन्तिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2090366, "chapter_id": 2920, "verse_number": "१३-५०-३९", "content_sanskrit": "विदितो भगवानस्य कार्यमागमनस्य यत्।\nपश्यैनं त्वं महाभागं ज्वलन्तमिव तेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2090367, "chapter_id": 2920, "verse_number": "१३-५०-४०", "content_sanskrit": "ततो वैश्रवणोऽभ्येत्य अष्टावक्रमनिन्दितम्।\nविधिवत्कुशलं पृष्ट्वा ततो ब्रह्मर्षिमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2090368, "chapter_id": 2920, "verse_number": "१३-५०-४१", "content_sanskrit": "सुखं प्राप्तो भवान्कच्चित्किंवा मत्तश्चिकीर्षति।\nब्रूहि सर्वं करिष्यामि यन्मां वक्ष्यसि वै द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2090369, "chapter_id": 2920, "verse_number": "१३-५०-४२", "content_sanskrit": "भवनं प्रविश त्वं मे यथाकामं द्विजोत्तम।\nसत्कृतः कृतकार्यश्च भवान्यास्यत्यविघ्नतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2090370, "chapter_id": 2920, "verse_number": "१३-५०-४३", "content_sanskrit": "प्राविशद्भवनं स्वं वै गृहीत्वा तं द्विजोत्तमम्।\nआसनं स्वं ददौ चैव पाद्यमर्घ्यं तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2090371, "chapter_id": 2920, "verse_number": "१३-५०-४४", "content_sanskrit": "अथोपविष्टयोस्तत्र माणिभद्रपुरोगमाः।\nनिषेदुस्तत्र कौबेरा यक्षगन्धर्वकिन्नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2090372, "chapter_id": 2920, "verse_number": "१३-५०-४५", "content_sanskrit": "ततस्तेषां निषण्णानां धनदो वाक्यमब्रवीत्।\nभवच्छन्दं समाज्ञाय नृत्येरन्नप्सरोगणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2090373, "chapter_id": 2920, "verse_number": "१३-५०-४६", "content_sanskrit": "आतिथ्यं परमं कार्यं शुश्रूषा भवतस्तथा।\nसंवर्ततामित्युवाच मुनिर्मधुरया गिरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2090374, "chapter_id": 2920, "verse_number": "१३-५०-४७", "content_sanskrit": "यथोर्वरा मिश्रकेशी रम्भा चैवोर्वशी तथा।\nअलम्बुसा घृताची च चित्रा चित्राङ्गदारुचिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2090375, "chapter_id": 2920, "verse_number": "१३-५०-४८", "content_sanskrit": "मनोहरा सुकेशी च सुमुखी हासिनी प्रभा।\nविद्युता प्रशमी दान्ता विद्योता रतिरेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2090376, "chapter_id": 2920, "verse_number": "१३-५०-४९", "content_sanskrit": "एताश्चान्याश्च वै बह्व्यः प्रनृत्ताप्सरसः शुभाः।\nअवादयंश्च गन्धर्वा वाद्यानि विविधानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2090377, "chapter_id": 2920, "verse_number": "१३-५०-५०", "content_sanskrit": "अथ प्रवृत्ते गान्धर्वे दिव्ये ऋषिरुपाविशत्।\nदिव्यं संवत्सरं तत्रारमतैष महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2090378, "chapter_id": 2920, "verse_number": "१३-५०-५१", "content_sanskrit": "ततो वैश्रवणो राजा भगवन्तमुवाच ह।\nसाग्रः संवत्सरो यातो विप्रेह तव पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2090379, "chapter_id": 2920, "verse_number": "१३-५०-५२", "content_sanskrit": "हार्योऽयं विषयो ब्रह्मन्गान्धर्वो नाम नामतः।\nछन्दतो वर्ततां विप्र यथा वदति वा भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2090380, "chapter_id": 2920, "verse_number": "१३-५०-५३", "content_sanskrit": "अतिथिः पूजनीयस्त्वमिदं च भवतो गृहम्।\nसर्वमाज्ञाप्यतामाशु परवन्तो वयं त्वयि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2090381, "chapter_id": 2920, "verse_number": "१३-५०-५४", "content_sanskrit": "अथ वैश्रवणं प्रीतो भगवान्प्रत्यभाषत।\nअर्चितोस्मि यथान्यायं गमिष्यामि धनेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2090382, "chapter_id": 2920, "verse_number": "१३-५०-५५", "content_sanskrit": "प्रीतोस्मि सदृशं चैव तव सर्वं धनाधिप।\nतव प्रसादाद्भगवन्महर्षेश्च महात्मनः।\nनियोगादद्य यास्यामि वृद्दिमानृद्धिमान्भव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2090383, "chapter_id": 2920, "verse_number": "१३-५०-५६", "content_sanskrit": "अथ निष्क्रम्य भगवान्प्रययावुत्तरामुखः।\n`कैलासे सङ्करावासमभिवीक्ष्य प्रणम्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2090384, "chapter_id": 2920, "verse_number": "१३-५०-५७", "content_sanskrit": "गौरीशं शङ्करं दान्तं शरणागतवत्सलम्।\nगङ्गाधरं गोपतिनं गणावृतमकल्पषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2090385, "chapter_id": 2920, "verse_number": "१३-५०-५८", "content_sanskrit": "कैलासं मन्दरं हैमं सर्वाननुचचार ह।\nतानतीत्य महाशैलान्कैरातं स्थानमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2090386, "chapter_id": 2920, "verse_number": "१३-५०-५९", "content_sanskrit": "प्रदक्षिणं तथा चक्रे प्रयतः शिरसा नतः।\nधरणीमवतीर्याथ पूतात्माऽसौ तदाऽभकवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2090387, "chapter_id": 2920, "verse_number": "१३-५०-६०", "content_sanskrit": "स तं प्रदक्षिणं कृत्वा निर्यातश्चोत्तरामुखः।\nसमेन भूमिभागेन ययौ प्रीतिपुरस्कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2090388, "chapter_id": 2920, "verse_number": "१३-५०-६१", "content_sanskrit": "ततोऽपरं वनोद्देशं रमणीयमपश्यत।\nसर्वर्तुभिर्मूलफलैः पक्षिभिश्च समन्वितैः।\nरमणीयैर्वनोद्देशैस्तत्रतत्र विभूषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2090389, "chapter_id": 2920, "verse_number": "१३-५०-६२", "content_sanskrit": "तत्राश्रमपदं दिव्यं ददर्श भगवानथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2090390, "chapter_id": 2920, "verse_number": "१३-५०-६३", "content_sanskrit": "शैलांश्च विविधाकारान्काञ्चनान्रत्नभूषितान्।\nमणिभूमौ निविष्टाश्च पुष्करिण्यस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2090391, "chapter_id": 2920, "verse_number": "१३-५०-६४", "content_sanskrit": "अन्यान्यपि सुरम्याणि ददर्श सुबहून्यथ।\nभृशं तस्य मनो रमे महर्षेर्भावितात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2090392, "chapter_id": 2920, "verse_number": "१३-५०-६५", "content_sanskrit": "स तत्र काञ्चनं दिव्यं सर्वरत्नमयं गृहम्।\nददर्शाद्भुतसङ्काशं धनदस्य गृहाद्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2090393, "chapter_id": 2920, "verse_number": "१३-५०-६६", "content_sanskrit": "महान्तो यत्र विविधा मणिकाञ्चनपर्वताः।\nविमानानि च रम्याणि रत्नानि विविधानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2090394, "chapter_id": 2920, "verse_number": "१३-५०-६७", "content_sanskrit": "मन्दारपुष्पैः सङ्कीर्णां तथा मन्दाकिनीं नदीम्।\nस्वयम्प्रभाश्च मणयो वज्रैर्भूमिश्च भूषिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2090395, "chapter_id": 2920, "verse_number": "१३-५०-६८", "content_sanskrit": "नानाविधैश्च भवनैर्विचित्रमणितोरणैः।\nमुक्ताजालविनिक्षिप्तैर्मणिरत्नविभूषितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2090396, "chapter_id": 2920, "verse_number": "१३-५०-६९", "content_sanskrit": "मनोद्दष्टिहरै रम्यैः सर्वतः संवृतं शुभैः।\nऋषिभिश्चावृतं तत्र आश्रमं तं मनोहरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2090397, "chapter_id": 2920, "verse_number": "१३-५०-७०", "content_sanskrit": "ततस्तस्याभवच्चिन्ता कुत्र वासो भवेदिति।\nअथ द्वारं समभितो गत्वा स्थित्वा ततोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2090398, "chapter_id": 2920, "verse_number": "१३-५०-७१", "content_sanskrit": "अतिथिं समनुप्राप्तमभिजानन्तु येऽत्र वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2090399, "chapter_id": 2920, "verse_number": "१३-५०-७२", "content_sanskrit": "अथ कन्याः परिवृता गृहात्तस्माद्विनिर्गताः।\nनानारूपाः सप्त विभो कन्याः सर्वा मनोहराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2090400, "chapter_id": 2920, "verse_number": "१३-५०-७३", "content_sanskrit": "यांयामपश्यत्कन्यां वै सासा तस्य मनोऽहरत्।\nन च शक्तो वारयितुं मनोऽस्याथावसीदति।\nततो धृतिः समुत्पन्ना तस्य विप्रस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2090401, "chapter_id": 2920, "verse_number": "१३-५०-७४", "content_sanskrit": "अथ तं प्रमदाः प्राहुर्भगवान्प्रविशत्विति।\nस च तासां सुरुपेण तस्यैव भवनस्य च।\nकौतूहलं समाविष्टः प्रविवेश गृहं द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2090402, "chapter_id": 2920, "verse_number": "१३-५०-७५", "content_sanskrit": "तत्रापश्यज्जरायुक्तामरजोम्बरधारिणीम्।\nवृद्धां पर्यङ्कमासीनां सर्वाभरणभूषिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2090403, "chapter_id": 2920, "verse_number": "१३-५०-७६", "content_sanskrit": "स्वस्तीति तेन चैवोक्ता सा स्त्री प्रत्यवदत्तदा।\nप्रत्युत्थाय च तं विप्रमास्यतामित्युवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2090404, "chapter_id": 2920, "verse_number": "१३-५०-७७x", "content_sanskrit": "अष्टावक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2090405, "chapter_id": 2920, "verse_number": "१३-५०-७७", "content_sanskrit": "सर्वाः स्वानालयान्यान्तु एका मामुपतिष्ठतु।\nप्रज्ञाता या प्रशान्ता या शेषा गच्छन्तु च्छन्दतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2090406, "chapter_id": 2920, "verse_number": "१३-५०-७८", "content_sanskrit": "ततः प्रदक्षिणीकृत्य कन्यास्तास्तमृषिं तदा।\nनिश्चक्रमुर्गृहात्तस्मात्सा वृद्धाऽथ व्यतिष्ठतः।\nतया सम्पूजितस्तत्र शयने चापि निर्मले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2090407, "chapter_id": 2920, "verse_number": "१३-५०-७९", "content_sanskrit": "अथ तां संविशन्प्राह शयने भास्वरे तदा।\nत्वयाऽपि सुप्यतां भद्रे रजनी ह्यतिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2090408, "chapter_id": 2920, "verse_number": "१३-५०-८०", "content_sanskrit": "संलापात्तेन विप्रेण तथा सा तत्र भाषिता।\nद्वितीये शयने दिव्ये संविवेश महाप्रभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2090409, "chapter_id": 2920, "verse_number": "१३-५०-८१", "content_sanskrit": "अथ सा वेपमानाङ्गी निमित्तं शीतजं तदा।\nव्यपदिश्य महर्षेर्वै शयनं व्यवरोहत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2090410, "chapter_id": 2920, "verse_number": "१३-५०-८२", "content_sanskrit": "स्वागतेनागतां तां तु भगवानभ्यभाषत।\nसा जुगूह भुजाभ्यां तु ऋषिं प्रीत्या नरर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2090411, "chapter_id": 2920, "verse_number": "१३-५०-८३", "content_sanskrit": "निर्विकारमृषिं चापि काष्ठकुड्योपमं तदा।\nदुखिता प्रेक्ष्य सञ्जल्पमकार्षीदृषिणा सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2090412, "chapter_id": 2920, "verse_number": "१३-५०-८४", "content_sanskrit": "ब्रह्मन्नकामकरोस्ति स्त्रीणां पुरुषतो धृतिः।\nकामेन मोहिता चाहं त्वां भजन्तीं भजस्व माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2090413, "chapter_id": 2920, "verse_number": "१३-५०-८५", "content_sanskrit": "प्रहृष्टो भव विप्रर्षे समागच्छ मया सह।\nउपगूह च भां विप्र कामार्ताऽहं भृशं त्वयि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2090414, "chapter_id": 2920, "verse_number": "१३-५०-८६", "content_sanskrit": "एतद्वि तव धर्मात्मंस्तपसः पूज्यते फलम्।\nप्रार्थितं दर्शनादेव भजमानां भजस्व माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2090415, "chapter_id": 2920, "verse_number": "१३-५०-८७", "content_sanskrit": "सद्म चेदं धनं सर्वं यच्चान्यदपि पश्यसि।\nप्रभुस्त्वं भव सर्वत्र मयि चैव न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2090416, "chapter_id": 2920, "verse_number": "१३-५०-८८", "content_sanskrit": "सर्वान्कामान्विधास्यामि रमस्व सहितो मया।\nरमणीये वने विप्र सर्वकामफलप्रदे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2090417, "chapter_id": 2920, "verse_number": "१३-५०-८९", "content_sanskrit": "त्वद्वशाऽहं भविष्यामि रंस्यसे च मया सह।\nसर्वान्कामानुपाश्नीमो ये दिव्या ये च मानुषाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2090418, "chapter_id": 2920, "verse_number": "१३-५०-९०", "content_sanskrit": "नातः परं हि नारीणां विद्यते च कदाचन।\nयथा पुरुषसंसर्गः परमेतद्धि नः फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2090419, "chapter_id": 2920, "verse_number": "१३-५०-९१", "content_sanskrit": "आत्मच्छन्देन वर्तन्ते नार्यो मन्मथचोदिताः।\nन च दह्यन्ति गच्छन्त्यः सुतप्तैरपि पांसुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2090420, "chapter_id": 2920, "verse_number": "१३-५०-९२x", "content_sanskrit": "अष्टावक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2090421, "chapter_id": 2920, "verse_number": "१३-५०-९२", "content_sanskrit": "परदारानहं भद्रे न गच्छेयं कथञ्चन।\nदूषितं धर्मशास्त्रज्ञैः परदाराभिमर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2090422, "chapter_id": 2920, "verse_number": "१३-५०-९३", "content_sanskrit": "`शुद्धक्षेत्रे ब्रह्महत्याप्रायश्चित्तमथोच्यते।\nपुनश्च पातकं दृष्टं विप्रक्षेत्रे विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2090423, "chapter_id": 2920, "verse_number": "१३-५०-९४", "content_sanskrit": "भद्रे निर्वेष्टुकामोऽहं तत्रावकिरणं मम।\n`प्रायश्चित्तं महदतो दारग्रहणपूर्वकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2090424, "chapter_id": 2920, "verse_number": "१३-५०-९५", "content_sanskrit": "बीजं न शुद्ध्यते वोढुरन्यथा कृतनिष्कृतेः।\nमातृतः पितृतः शुद्धो ज्ञेयः पुत्रो यथार्थतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2090425, "chapter_id": 2920, "verse_number": "१३-५०-९६", "content_sanskrit": "विषयेष्वनभिज्ञोऽहं धर्मार्थं किल सन्ततिः।\nएवं लोकान्गमिष्यामि पुत्रैरिति न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2090426, "chapter_id": 2920, "verse_number": "१३-५०-९७", "content_sanskrit": "भद्रे धर्मं विजानीहि ज्ञात्वा चोपरमस्व ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2090427, "chapter_id": 2920, "verse_number": "१३-५०-९८x", "content_sanskrit": "स्त्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2090428, "chapter_id": 2920, "verse_number": "१३-५०-९८", "content_sanskrit": "नानिलोऽग्निर्न वरुणो न चान्ये त्रिदशा द्विज।\nप्रियाः स्त्रीणां यथा कामो रतिशीला हि योषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2090429, "chapter_id": 2920, "verse_number": "१३-५०-९९", "content_sanskrit": "सहस्रे किल नारीणां प्राप्येतैका कदाचन।\nतथा शतसहस्रेषु यदि काचित्पतिव्रता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2090430, "chapter_id": 2920, "verse_number": "१३-५०-१००", "content_sanskrit": "नैता जानन्ति पितरं न कुलं न च मातरम्।\nन भ्रातॄन्न च भर्तारं न च पुत्रान्न देवरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2090431, "chapter_id": 2920, "verse_number": "१३-५०-१०१", "content_sanskrit": "लीलायन्त्यः कुलं घ्नन्ति कूलानीव सरिद्वराः।\nदोषान्सर्वाश्च मत्वाऽऽशु प्रजापतिरभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2090432, "chapter_id": 2920, "verse_number": "१३-५०-१०२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2090433, "chapter_id": 2920, "verse_number": "१३-५०-१०२", "content_sanskrit": "ततः स ऋषिरेकाग्रस्तां स्त्रियं प्रत्यभाषत।\nआस्यतांरुचितश्छन्दः किञ्च कार्यं ब्रवीहि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2090434, "chapter_id": 2920, "verse_number": "१३-५०-१०३", "content_sanskrit": "सा स्त्री प्रोवाच भगवन्द्रक्ष्यसे देशकालतः।\nवस तावन्महाभाग कृतकृत्यो भविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2090435, "chapter_id": 2920, "verse_number": "१३-५०-१०४", "content_sanskrit": "ब्रह्मर्षिस्तामथोवाच स तथेति युधिष्ठिर।\nवत्स्येऽहं यावदुत्साहो भवत्या नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2090436, "chapter_id": 2920, "verse_number": "१३-५०-१०५", "content_sanskrit": "अथर्षिरभिसम्प्रेक्ष्य स्त्रियं तां जरयाऽर्दिताम्।\nचिन्तां परमिकां भेजे सन्तप्त इव चाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2090437, "chapter_id": 2920, "verse_number": "१३-५०-१०६", "content_sanskrit": "यद्यदङ्गं हि सोऽपश्यत्तस्या विप्रर्षभस्तदा।\nनारमत्तत्रतत्रास्य दृष्टी रूपविरागिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2090438, "chapter_id": 2920, "verse_number": "१३-५०-१०७", "content_sanskrit": "देवतेयं गृहस्यास्य शापात्किंनु विरूपिता।\nअस्याश्च कारणं वेत्तुं न युक्तं सहसा भया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2090439, "chapter_id": 2920, "verse_number": "१३-५०-१०८", "content_sanskrit": "इति चिन्ताविषक्तस्य तमर्थं ज्ञातुमिच्छतः।\nव्यगमद्रात्रिशेषः स मनसा व्याकुलेन तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2090440, "chapter_id": 2920, "verse_number": "१३-५०-१०९", "content_sanskrit": "अथ सा स्त्री तथोवाच भगवन्पश्य वै रवेः।\nरूपं सन्ध्याभ्रसंरक्तं किमुपस्थाप्यतां तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2090441, "chapter_id": 2920, "verse_number": "१३-५०-११०", "content_sanskrit": "स उवाच ततस्तां स्त्रीं स्नानोदकमिहानय।\nउपासिष्ये ततः सन्ध्यां वाग्यतो नियतेन्द्रियः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2090442, "chapter_id": 2920, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि पञ्चाशोऽध्यायः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}]