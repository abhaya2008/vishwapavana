[{"id": 900003011, "chapter_id": 8275, "verse_number": "9.1", "content_sanskrit": "इदं तु ते गुह्यतमं प्रवक्ष्याम्यनसूयवे । ज्ञानं विज्ञानसहितं यज्ज्ञात्वा मोक्ष्यसेऽशुभात् ।। १ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900003012, "chapter_id": 8275, "verse_number": "9.2", "content_sanskrit": "राजविद्या राजगुह्यं पवित्रमिदमुत्तमम् । प्रत्यक्षावगमं धर्म्यं सुसुखं कर्तुमव्ययम् ।। २ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900003013, "chapter_id": 8275, "verse_number": "9.3", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900003014, "chapter_id": 8275, "verse_number": "9.4", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900003015, "chapter_id": 8275, "verse_number": "9.5", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900003016, "chapter_id": 8275, "verse_number": "9.6", "content_sanskrit": "अश्रद्दधानाः पुरुषा धर्मस्यास्य परन्तप । अप्राप्य मां निवर्तन्ते मृत्युसंसारवर्त्मनि ।। ३ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900003017, "chapter_id": 8275, "verse_number": "9.7", "content_sanskrit": "मया ततमिदं सर्वं जगदव्यक्तमूर्तिना । मत्स्थानि सर्वभूतानि न चाहं तेष्ववस्थितः ।। ४ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900003018, "chapter_id": 8275, "verse_number": "9.8", "content_sanskrit": "न च मत्स्थानि भूतानि पश्य मे योगमैश्वरम् । भूतभृन्न च भूतस्थो ममाऽत्मा भूतभावनः ।। ५ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900003019, "chapter_id": 8275, "verse_number": "9.9", "content_sanskrit": "यथाऽऽकाशस्थितो नित्यं वायुः सर्वत्रगो महान् । तथा सर्वाणि भूतानि मत्स्थानीत्युपधारय ।। ६ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900003020, "chapter_id": 8275, "verse_number": "9.10", "content_sanskrit": "सर्वभूतानि कौन्तेय प्रकृतिं यान्ति मामिकाम् । कल्पक्षये पुनस्तानि कल्पादौ विसृजाम्यहम् ।। ७ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900003021, "chapter_id": 8275, "verse_number": "9.11", "content_sanskrit": "प्रकृतिं स्वामवष्टभ्य विसृजामि पुनः पुनः । भूतग्राममिमं कृत्स्नमवशं प्रकृतेर्वशात् ।। ८ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900003022, "chapter_id": 8275, "verse_number": "9.12", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900003023, "chapter_id": 8275, "verse_number": "9.13", "content_sanskrit": "नच मां तानि कर्माणि निबध्नन्ति धनञ्जय । उदासीनवदासीनमसक्तं तेषु कर्मसु ।। ९ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900003024, "chapter_id": 8275, "verse_number": "9.14", "content_sanskrit": "मयाऽध्यक्षेण प्रकृतिः सूयते सचराचरम् । हेतुनाऽनेन कौन्तेय जगद्विपरिवर्तते ।। १० ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900003025, "chapter_id": 8275, "verse_number": "9.15", "content_sanskrit": "अवजानन्ति मां मूढा मानुषीं तनुमाश्रितम् । परं भावमजानन्तो मम भूतमहेश्वरम् ।। ११ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900003026, "chapter_id": 8275, "verse_number": "9.16", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900003027, "chapter_id": 8275, "verse_number": "9.17", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900003028, "chapter_id": 8275, "verse_number": "9.18", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900003029, "chapter_id": 8275, "verse_number": "9.19", "content_sanskrit": "मोघाशा मोघकर्माणो मोघज्ञाना विचेतसः । राक्षसीमासुरीं चैव प्रकृतिं मोहिनीं श्रिताः ।। १२ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900003030, "chapter_id": 8275, "verse_number": "9.20", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900003031, "chapter_id": 8275, "verse_number": "9.21", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900003032, "chapter_id": 8275, "verse_number": "9.22", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900003033, "chapter_id": 8275, "verse_number": "9.23", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900003034, "chapter_id": 8275, "verse_number": "9.24", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900003035, "chapter_id": 8275, "verse_number": "9.25", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900003036, "chapter_id": 8275, "verse_number": "9.26", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 900003037, "chapter_id": 8275, "verse_number": "9.27", "content_sanskrit": "महात्मानस्तु मां पार्थ दैवीं प्रकृतिमाश्रिताः । भजन्त्यनन्यमनसो ज्ञात्वा भूतादिमव्ययम् ।। १३ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 900003038, "chapter_id": 8275, "verse_number": "9.28", "content_sanskrit": "सततं कीर्तयन्तो मां यतन्तश्च दृढव्रताः । नमस्यन्तश्च मां भक्त्या नित्ययुक्ता उपासते ।। १४ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 900003039, "chapter_id": 8275, "verse_number": "9.29", "content_sanskrit": "ज्ञानयज्ञेन चाप्यन्ये यजन्तो मामुपासते । एकत्वेन पृथक्त्वेन बहुधा विश्वतोमुखम् ।। १५ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 900003040, "chapter_id": 8275, "verse_number": "9.30", "content_sanskrit": "अहं क्रतुरहं यज्ञः स्वधाऽहम् अहमौषधम् । मन्त्रोऽहम् अहमेवाज्यम् अहमग्निरहं हुतम्।। १६ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 900003041, "chapter_id": 8275, "verse_number": "9.31", "content_sanskrit": "पिताऽहमस्य जगतो माता धाता पितामहः । वेद्यं पवित्रम् ओङ्कार ऋक् साम यजुरेव च ।। १७ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 900003042, "chapter_id": 8275, "verse_number": "9.32", "content_sanskrit": "गतिर्भर्ता प्रभुः साक्षी निवासः शरणं सुहृत् । प्रभवः प्रलयः स्थानं निधानं बीजमव्ययम् ।। १८ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 900003043, "chapter_id": 8275, "verse_number": "9.33", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 900003044, "chapter_id": 8275, "verse_number": "9.34", "content_sanskrit": "तपाम्यहमहं वर्षं निगृह्णाम्युत्सृजामि च । अमृतं चैव मृत्युश्च सदसच्चाहमर्जुन ।। १९", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 900003045, "chapter_id": 8275, "verse_number": "9.35", "content_sanskrit": "त्रैविद्या मां सोमपाः पूतपापा यज्ञैरिष्ट्वा स्वर्गतिं प्रार्थयन्ते । ते पुण्यमासाद्य सुरेन्द्रलोकमश्नन्ति दिव्यान् दिवि देवभोगान् ।। २० ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 900003046, "chapter_id": 8275, "verse_number": "9.36", "content_sanskrit": "ते तं भुक्त्वा स्वर्गलोकं विशालं क्षीणे पुण्ये मर्त्यलोकं विशन्ति । एवं त्रयीधर्ममनुप्रपन्ना गतागतं कामकामा लभन्ते ।। २१ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 900003047, "chapter_id": 8275, "verse_number": "9.37", "content_sanskrit": "अनन्याश्चिन्तयन्तो मां ये जनाः पर्युपासते । तेषां नित्याभियुक्तानां योगक्षेमं वहाम्यहम् ।। २२ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 900003048, "chapter_id": 8275, "verse_number": "9.38", "content_sanskrit": "येऽप्यन्यदेवता भक्ता यजन्ते श्रद्धयाऽन्विताः । तेऽपि मामेव कौन्तेय यजन्त्यविधिपूर्वकम् ।। २३ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 900003049, "chapter_id": 8275, "verse_number": "9.39", "content_sanskrit": "अहं हि सर्वयज्ञानां भोक्ता च प्रभुरेव च । न तु मामभिजानन्ति तत्त्वेनातश्च्यवन्ति ते ।। २४ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 900003050, "chapter_id": 8275, "verse_number": "9.40", "content_sanskrit": "यान्ति देवव्रता देवान् पितॄन् यान्ति पितृव्रताः । भूतानि यान्ति भूतेज्या यान्ति मद्याजिनोऽपि माम् ।।२५।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 900003051, "chapter_id": 8275, "verse_number": "9.41", "content_sanskrit": "पत्रं पुष्पं फलं तोयं यो मे भक्त्या प्रयच्छति । तदहं भक्त्युपहृतमश्नामि प्रयतात्मनः ।। २६ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 900003052, "chapter_id": 8275, "verse_number": "9.42", "content_sanskrit": "यत्करोषि यदश्नासि यज्जुहोषि ददासि यत् । यत् तपस्यसि कौन्तेय तत्कुरुष्व मदर्पणम् ।। २७ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 900003053, "chapter_id": 8275, "verse_number": "9.43", "content_sanskrit": "शुभाशुभफलैरेवं मोक्ष्यसे कर्मबन्धनैः । सन्न्यासयोगयुक्तात्मा विमुक्तो मामुपैष्यसि ।। २८ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 900003054, "chapter_id": 8275, "verse_number": "9.44", "content_sanskrit": "समोऽहं सर्वभूतेषु न मे द्वेष्योऽस्ति न प्रियः । ये भजन्ति तु मां भक्त्या मयि ते तेषु चाप्यहम् ।। २९ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 900003055, "chapter_id": 8275, "verse_number": "9.45", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 900003056, "chapter_id": 8275, "verse_number": "9.46", "content_sanskrit": "अपि चेत् सुदुराचारो भजते मामनन्यभाक् । साधुरेव स मन्तव्यः सम्यग्व्यवसितो हि सः ।। ३० ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 900003057, "chapter_id": 8275, "verse_number": "9.47", "content_sanskrit": "क्षिप्रं भवति धर्मात्मा शश्वच्छान्तिं निगच्छति । कौन्तेय प्रतिजानीहि न मे भक्तः प्रणश्यति ।। ३१ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 900003058, "chapter_id": 8275, "verse_number": "9.48", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 900003059, "chapter_id": 8275, "verse_number": "9.49", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 900003060, "chapter_id": 8275, "verse_number": "9.50", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 900003061, "chapter_id": 8275, "verse_number": "9.51", "content_sanskrit": "मां हि पार्थ व्यपाश्रित्य येऽपि स्युः पापयोनयः । स्त्रियो वैश्यास्तथा शूद्रास्तेऽपि यान्ति परां गतिम् ।। ३२ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 900003062, "chapter_id": 8275, "verse_number": "9.52", "content_sanskrit": "किं पुनर्ब्राह्मणाः पुण्या भक्ता राजर्षयस्तथा । अनित्यमसुखं लोकमिमं प्राप्य भजस्व माम् ।। ३३ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 900003063, "chapter_id": 8275, "verse_number": "9.53", "content_sanskrit": "मन्मना भव मद्भक्तो मद्याजी मां नमस्कुरु । मामेवैष्यसि युक्त्वैवमात्मानं मत्परायणः ।। ३४ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]