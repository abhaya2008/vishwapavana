[{"id": 2134145, "chapter_id": 3897, "verse_number": "१", "content_sanskrit": "लब्धप्रसादा मुदितास्तस्माद् देवान् महात्मनः ।\nततः सङ्कल्प्य पुत्रत्वे स्कन्दं मातृगणोऽगमत् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2134146, "chapter_id": 3897, "verse_number": "२", "content_sanskrit": "काकी च हलिमा चैव भद्रा च वृषळा तथा ।\nआर्या बाला च धात्री च सप्तैताः शिशुमातरः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2134147, "chapter_id": 3897, "verse_number": "३", "content_sanskrit": "एतासां वीर्यसम्पन्नः शिशुर्नामातिदारुणः ।\nस्कन्दप्रसादजः पुत्रो लोहिताक्षो भयङ्करः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2134148, "chapter_id": 3897, "verse_number": "४", "content_sanskrit": "एष वीरोऽष्टकः प्रोक्तः स्कन्दो मातृगणोद्वहः ।\nछागवक्त्रेण सहितो नवमः परिकीर्तितः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2134149, "chapter_id": 3897, "verse_number": "५", "content_sanskrit": "षष्ठं छागमयं वक्त्रं स्कन्दस्यैवेति विद्धि तत् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2134150, "chapter_id": 3897, "verse_number": "६", "content_sanskrit": "षड्भिराभ्यन्तरे राजन् नित्यं मातृगणार्चितम् ।\nषण्णां तु प्रवरं तस्य शीर्षाणामिह शस्यते \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2134151, "chapter_id": 3897, "verse_number": "७", "content_sanskrit": "शक्तिं येनासृजद् दिव्यां भद्रशाखामिति स्म ह ।\nइत्येतद् विविधाकारं वृत्तं शुक्लस्य पञ्चमीम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2134152, "chapter_id": 3897, "verse_number": "८", "content_sanskrit": "तत्र युद्धं महाघोरं वृत्तं षष्ठ्यां जनाधिप ।\nउपविष्टं तु तं स्कन्दं हिरण्यकवचस्रजम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2134153, "chapter_id": 3897, "verse_number": "८", "content_sanskrit": "हिरण्यचूडमुकुटं हिरण्याक्षं महाप्रभम् ।\nलोहिताम्बरसंवीतं तीक्ष्णदंष्ट्रं मनोरमम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2134154, "chapter_id": 3897, "verse_number": "१०", "content_sanskrit": "सर्वलक्षणसम्पन्नं त्रैलोक्यस्यापि सुप्रियम् ।\nततस्तं वरदं शूरं युवानं मृष्टकुण्डलम् ।\nअभजत् पद्महस्ता श्रीः स्वयमेव शरीरिणी \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2134155, "chapter_id": 3897, "verse_number": "११", "content_sanskrit": "श्रिया जुष्टः पृथुयशाः स कुमारवरस्तदा ।\nनिषण्णो दृश्यते भूतैः पौर्णमास्यां यथा शशी \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2134156, "chapter_id": 3897, "verse_number": "१२", "content_sanskrit": "अपूजयन् महात्मानो ब्राह्मणास्तं महाबलम् ।\nइदमाहुस्तदा चैव स्कन्दं तत्र महर्षयः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2134157, "chapter_id": 3897, "verse_number": "१३", "content_sanskrit": "हिरण्यगर्भ भद्रं ते लोकानां शङ्करो भव ।\nत्वया षड्रात्रजातेन सर्वे लोका वशीकृताः\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2134158, "chapter_id": 3897, "verse_number": "१४", "content_sanskrit": "अभयं च परं दत्तं त्वयैवैषां सुरोत्तम ।\nतस्मादिन्द्रो भवानस्तु त्रैलोक्यस्य हिताय वै \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2134159, "chapter_id": 3897, "verse_number": "", "content_sanskrit": "स्कन्दः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2134160, "chapter_id": 3897, "verse_number": "१५", "content_sanskrit": "किमिन्द्रः सर्वलोकानां करोतीह तपोधनाः ।\nकथं देवगणांश्चैव पाति नित्यं सुरेश्वरः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2134161, "chapter_id": 3897, "verse_number": "", "content_sanskrit": "ऋषयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2134162, "chapter_id": 3897, "verse_number": "१६", "content_sanskrit": "इन्द्रो दिशति भूतानां बलं तेजः प्रजाः सुखम् ।\nतुष्टः प्रयच्छति तथा सर्वान् कामान् सुरेश्वरः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2134163, "chapter_id": 3897, "verse_number": "१७", "content_sanskrit": "दुर्वृत्तानां संहरति सुवृत्तानां प्रयच्छति ।\nअनुशास्ति च भूतानि कार्येषु बलसूदनः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2134164, "chapter_id": 3897, "verse_number": "१८", "content_sanskrit": "असूर्ये च भवेत् सूर्यस्तथाऽचन्द्रे च चन्द्रमाः ।\nभवत्यग्निश्च वायुश्च पृथिव्यापश्च कारणैः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2134165, "chapter_id": 3897, "verse_number": "१९", "content_sanskrit": "एतदिन्द्रेण कर्तव्यमिन्द्रे हि विपुलं बलम् ।\nत्वं च वीर बली श्रेष्ठस्तस्मादिन्द्रो भवस्व नः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2134166, "chapter_id": 3897, "verse_number": "", "content_sanskrit": "शक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2134167, "chapter_id": 3897, "verse_number": "२०", "content_sanskrit": "भवस्वेन्द्रो महाबाहो सर्वेषां नः सुखावहः ।\nअभिषिच्यस्व चैवाद्य प्राप्तरूपोऽसि सत्तम \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2134168, "chapter_id": 3897, "verse_number": "", "content_sanskrit": "कार्त्तिकेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2134169, "chapter_id": 3897, "verse_number": "२१", "content_sanskrit": "शाधि त्वमेव त्रैलोक्यमव्यग्रो विजये रतः ।\nअहं ते किङ्करः शक्र न ममेन्द्रत्वमीप्सितम्\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2134170, "chapter_id": 3897, "verse_number": "", "content_sanskrit": "शक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2134171, "chapter_id": 3897, "verse_number": "२२", "content_sanskrit": "बलं तवाद्भुतं वीर त्वं देवानामरीन् जहि ।\nअवज्ञास्यन्ति मां लोका वीर्येण तव विस्मिताः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2134172, "chapter_id": 3897, "verse_number": "२३", "content_sanskrit": "इन्द्रत्वेऽपि स्थितं वीर बलहीनं पराजितम् ।\nत्वत्तेजसाऽवमंस्यन्ति लोका मां सुरसत्तम \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2134173, "chapter_id": 3897, "verse_number": "२४", "content_sanskrit": "आवयोश्च मिथो भेदे प्रयतिष्यन्त्यतन्द्रिताः ।\nभेदिते च त्वयि विभो लोको द्वैधमुपेष्यति \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2134174, "chapter_id": 3897, "verse_number": "२५", "content_sanskrit": "द्वैधीभूतेषु लोकेषु निश्चितेष्वावयोस्तदा ।\nविग्रहः सम्प्रवर्तेत भूतभेदान्महाबल \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2134175, "chapter_id": 3897, "verse_number": "२६", "content_sanskrit": "तत्र त्वं मां रणे तात यथाश्रद्धं विजेष्यसि ।\nतस्मादिन्द्रो भवानेव भविता मा विचारय \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2134176, "chapter_id": 3897, "verse_number": "", "content_sanskrit": "कार्त्तिकेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2134177, "chapter_id": 3897, "verse_number": "२७", "content_sanskrit": "त्वमेव राजा भद्रं ते त्रैलोक्यस्य ममैव च ।\nकरोमि किं च ते शक्र शासनं ब्रूहि तन्मम \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2134178, "chapter_id": 3897, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2134179, "chapter_id": 3897, "verse_number": "२८", "content_sanskrit": "अहमिन्द्रो भविष्यामि तव वाक्यान्महाबल ।\nयदि सत्यमिदं वाक्यं निश्चयाद् भाषितं त्वया \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2134180, "chapter_id": 3897, "verse_number": "२९", "content_sanskrit": "अभिषिच्यस्व देवानां से(सै)नापत्ये महाबल ।\nअहमिन्द्रो भविष्यामि तव वाक्यान्महाबल\t ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2134181, "chapter_id": 3897, "verse_number": "", "content_sanskrit": "कार्त्तिकेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2134182, "chapter_id": 3897, "verse_number": "३०", "content_sanskrit": "दानवानां विनाशाय देवानामर्थसिद्धये ।\nगोब्राह्मणहितार्थाय से(सै)नापत्येऽभिषिञ्च माम् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2134183, "chapter_id": 3897, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2134184, "chapter_id": 3897, "verse_number": "३१", "content_sanskrit": "सोऽभिषिक्तो मघवता सर्वैर्देवगणैः सह ।\nअतीव शुशुभे तत्र पूज्यमानो महर्षिभिः \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2134185, "chapter_id": 3897, "verse_number": "३२", "content_sanskrit": "तस्य तत् काञ्चनं छत्रं ध्रियमाणं व्यरोचत ।\nयथैव सुसमिद्धस्य पावकस्यात्ममण्डलम् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2134186, "chapter_id": 3897, "verse_number": "३३", "content_sanskrit": "विश्वकर्मकृता चास्य दिव्या माला हिरण्मयी ।\nआबद्धा त्रिपुरघ्नेन स्वयमेव यशस्विना \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2134187, "chapter_id": 3897, "verse_number": "३४", "content_sanskrit": "आगम्य मनुजव्याघ्र सह देव्या परन्तपः ।\nअर्चयामास सुप्रीतो भगवान्गोवृषध्वजः \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2134188, "chapter_id": 3897, "verse_number": "३५", "content_sanskrit": "रुद्रमग्निं प्रजाः प्राहु रुद्रसूनुस्ततस्तु सः ।\nकीर्त्यते सुमहातेजाः कुमारोऽद्भुतदर्शनः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2134189, "chapter_id": 3897, "verse_number": "३६", "content_sanskrit": "रुद्रेण शुक्रमुत्सृष्टं तच्छ्वेतः पर्वतोऽभवत् ।\nपावकस्येन्द्रियं श्वेते कृत्तिकाभिर्धृतं नगे \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2134190, "chapter_id": 3897, "verse_number": "३७", "content_sanskrit": "पूज्यमानं तु रुद्रेण दृष्ट्वा सर्वे दिवौकसः ।\nरुद्रसूनुं ततः प्राहुर्गुहं गुणवतां वरम्\t ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2134191, "chapter_id": 3897, "verse_number": "३८", "content_sanskrit": "अनुप्रविश्य रुद्रेण वह्निजातो ह्ययं शिशुः ।\nतत्र जातस्ततः स्कन्दो रुद्रसूनुस्ततोऽभवत् \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2134192, "chapter_id": 3897, "verse_number": "३९", "content_sanskrit": "रुद्रस्य वह्नेः स्वाहायाः षण्णां स्त्रीणां च भारत ।\nजातः स्कन्दः सुरश्रेष्ठो रुद्रसूनुस्ततोऽभवत् \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2134193, "chapter_id": 3897, "verse_number": "४०", "content_sanskrit": "अरजे वाससी रक्ते वसानः पावकात्मजः ।\nभाति दीप्तवपुः श्रीमान् रक्ताभ्राभ्यामिवांशुमान्\t ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2134194, "chapter_id": 3897, "verse_number": "४१", "content_sanskrit": "कुक्कुटश्चाग्निना दत्तस्तस्य केतुरलङ्कृतः ।\nरथे समुच्छ्रितो भाति कालाग्निरिव लोहितः \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2134195, "chapter_id": 3897, "verse_number": "४२", "content_sanskrit": "या चेष्टा सर्वभूतानां प्रजा शान्तिर्बलं तथा ।\nअग्रतस्तस्य सा शक्तिर्देवानां जयवर्धिनी \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2134196, "chapter_id": 3897, "verse_number": "४३", "content_sanskrit": "विवेश कवचं चास्य शरीरे सहजं तथा।\nयुध्यमानस्य देवस्य प्रादुर्भवति तत्सदा \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2134197, "chapter_id": 3897, "verse_number": "४४", "content_sanskrit": "शक्तिर्धर्मो बलं तेजः कान्तत्वं सत्यमुन्नतिः ।\nब्रह्मण्यत्वमसम्मोहो भक्तानां परिरक्षणम् \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2134198, "chapter_id": 3897, "verse_number": "४५", "content_sanskrit": "निकृन्तनं च शत्रूणां लोकानां चाभिरक्षणम् ।\nस्कन्देन सह जातानि सर्वाण्येव जनाधिप \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2134199, "chapter_id": 3897, "verse_number": "४६", "content_sanskrit": "एवं देवगणैः सर्वैः सोऽभिषिक्तः स्वलङ्कृतः ।\nबभौ प्रतीतः सुमनाः परिपूर्णेन्दुमण्डलः \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2134200, "chapter_id": 3897, "verse_number": "४७", "content_sanskrit": "इष्टैः स्वाध्यायघोषैश्च वेणुतूर्यवरैरपि ।\nदेवगन्धर्वगीतैश्च सर्वैरप्सरसां गणैः \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2134201, "chapter_id": 3897, "verse_number": "४८", "content_sanskrit": "एतैश्चान्यैश्च बहुभिस्तुष्टैर्हृष्टैः स्वलङ्कृतैः ।\nक्रीडन् भाति तदा देवैरभिषिक्तश्च पावकिः \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2134202, "chapter_id": 3897, "verse_number": "४९", "content_sanskrit": "अभिषिक्तं महासेनमपश्यन्त दिवौकसः ।\nविनिकृ(ह)त्य तमः सूर्यं यथेहाभ्युदितं तथा \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2134203, "chapter_id": 3897, "verse_number": "५०", "content_sanskrit": "अथैनमभ्ययुः सर्वा देवसेनाः सहस्रशः ।\nअस्माकं त्वं पतिरिति ब्रुवाणाः सर्वतो दिशः\t ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2134204, "chapter_id": 3897, "verse_number": "५१", "content_sanskrit": "ताः समासाद्य भगवान् सर्वभूतगणैर्वृतः ।\nअर्चितस्तु स्तुतश्चैव सान्त्वयामास ता अपि \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2134205, "chapter_id": 3897, "verse_number": "५२", "content_sanskrit": "शतक्रतुश्चाभिषिच्य स्कन्दं सेनापतिं तदा ।\nसस्मार तां देवसेनां या सा तेन विमोक्षिता \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2134206, "chapter_id": 3897, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2134207, "chapter_id": 3897, "verse_number": "५३", "content_sanskrit": "अयं तस्याः पतिर्नूनं विहितो ब्रह्मणा स्वयम् \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2134208, "chapter_id": 3897, "verse_number": "समाप्तिः", "content_sanskrit": "इति चिन्त्यानयामास देवसेनां ह्यलङ्कृताम् ।\nस्कन्दं प्रोवाच बलभिदियं कन्या सुरोत्तम।\nअजाते त्वयि निर्दिष्टा तव पत्नी स्वयम्भुवा \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2134209, "chapter_id": 3897, "verse_number": "५५", "content_sanskrit": "तस्मात् त्वमस्या विधिवत् पाणिं मन्त्रपुरस्कृतम् ।\nगृहाण दक्षिणं देव्याः पाणिना पद्मवर्चसम् \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2134210, "chapter_id": 3897, "verse_number": "५६", "content_sanskrit": "एवमुक्तः स जग्राह तस्याः पाणिं यथाविधि ।\nबृहस्पतिर्मन्त्रविद्धि जजाप च जुहाव च \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2134211, "chapter_id": 3897, "verse_number": "५७", "content_sanskrit": "एवं स्कन्दस्य महिषीं देवसेनां विदुर्जनाः ।\nषष्ठीं यां ब्राह्मणाः प्राहुर्लक्ष्मीमाशां सुखप्रदाम् \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2134212, "chapter_id": 3897, "verse_number": "५८", "content_sanskrit": "सिनीवालीं कुहूं चैव सद्वृत्तिमपराजिताम् ।\nइत्येवमादिभिर्देवी नामभिः परिकीर्त्यते \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2134213, "chapter_id": 3897, "verse_number": "५९", "content_sanskrit": "यदा स्कन्दः पतिर्लब्धः शाश्वतो देवसेनया ।\nतदा तमाश्रयल्लक्ष्मीः स्वयं देवी शरीरिणी \t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2134214, "chapter_id": 3897, "verse_number": "६०", "content_sanskrit": "श्रीजुष्टः पञ्चमीं स्कन्दस्तस्मात् श्रीः पञ्चमी स्मृता ।\nषष्ठ्यां कृतार्थोऽभूद् यस्मात् तस्मात् षष्ठी महातिथिः \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2134215, "chapter_id": 3897, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि अष्टाधिकद्विशततमोऽध्यायः ॥ २१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2134216, "chapter_id": 3897, "verse_number": "", "content_sanskrit": "॥ मार्कण्डेयसमास्यापर्वणि आङ्गिरसे स्कन्दोत्पत्तौ त्रिचत्वारिंशोऽध्यायः ॥४३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]