[{"id": 2082425, "chapter_id": 2754, "verse_number": "१२-२५९-०x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2082426, "chapter_id": 2754, "verse_number": "१२-२५९-१", "content_sanskrit": "शरीराद्विप्रमुक्तं हि सूक्ष्मभूतं शरीरिणम्।\nकर्मभिः परिपश्यन्ति शास्त्रोक्तैः शास्त्रचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2082427, "chapter_id": 2754, "verse_number": "१२-२५९-२", "content_sanskrit": "यथा मरीच्यः सहिताश्चरन्ति\nगच्छन्ति तिष्ठन्ति च दृश्यमानाः।\nदेहैर्विमुक्तानि वरन्ति लोकां\nस्तथैव सत्वान्यतिमानुषाणि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2082428, "chapter_id": 2754, "verse_number": "१२-२५९-३", "content_sanskrit": "प्रतिरूपं यथैवाप्सु तावत्सूर्यस्य लक्ष्यते।\nसत्ववांस्तु तथा सत्वं प्रतिरूपं स पश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2082429, "chapter_id": 2754, "verse_number": "१२-२५९-४", "content_sanskrit": "तानि सूक्ष्माणि सत्वानि विमुक्तानि शरीरतः।\nतेन तत्वेन तत्वज्ञाः पश्यन्ति नियतेन्द्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2082430, "chapter_id": 2754, "verse_number": "१२-२५९-५", "content_sanskrit": "स्वपतां जाग्रतां चैष सर्वेषामात्मचिन्तितम्।\nप्रधानाद्वैधयुक्तानां दह्यते कर्मजं रजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2082431, "chapter_id": 2754, "verse_number": "१२-२५९-६", "content_sanskrit": "यथाऽहनि तथा रात्रौ यथा रात्रौ तथाऽहनि।\nवशे तिष्ठति सत्वात्मा सततं योगयोगिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2082432, "chapter_id": 2754, "verse_number": "१२-२५९-७", "content_sanskrit": "तेषां नित्यं सदा नित्यो भूतात्मा सततं गुणैः।\nसप्तभिस्त्वन्वितः सूक्ष्मैश्चरिष्णुरजरामरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2082433, "chapter_id": 2754, "verse_number": "१२-२५९-८", "content_sanskrit": "मनोवुद्धिपराभूतः स्वदेहपरदेहवित्।\nस्वप्नेष्वपि भवत्येष विज्ञाता सुखदुःखयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2082434, "chapter_id": 2754, "verse_number": "१२-२५९-९", "content_sanskrit": "तत्रापि लभते दुःखं तत्रापि लभते सुखम्।\nकामं क्रोधं च तत्रापि कृत्वा व्यसनमृच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2082435, "chapter_id": 2754, "verse_number": "१२-२५९-१०", "content_sanskrit": "प्रीणितश्चापि भवति महतोऽर्थानवाप्य हि।\nकरोति पुण्यं तत्रापि जाग्रन्निव च पश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2082436, "chapter_id": 2754, "verse_number": "१२-२५९-११", "content_sanskrit": "सदोष्मान्तर्गतश्चापि गर्भत्वं समुपेयिवान्।\nदश मासान्वसन्कुक्षौ नैषोऽन्नमिव जीर्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2082437, "chapter_id": 2754, "verse_number": "१२-२५९-१२", "content_sanskrit": "तमेतमतितेजोंशं भूतात्मानं हृदि स्थितम्।\nतमोरजोभ्यामाविष्टा नानुपश्यन्ति मूर्तिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2082438, "chapter_id": 2754, "verse_number": "१२-२५९-१३", "content_sanskrit": "योगशास्त्रपरा भूत्वा स्वमात्मानं परीप्सवः।\n`तमोरजोभ्यां निर्मुक्तास्तं प्रपश्यन्ति मूर्तिषु।\nअनुच्छ्वासान्यमूर्तानि यानि वज्रोपमान्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2082439, "chapter_id": 2754, "verse_number": "१२-२५९-१४", "content_sanskrit": "पृथग्भूतेषु सृष्टेषु चतुर्ष्वाश्रमकर्मसु।\nसमाधौ योगमेवैतच्छाण्डिल्यः सममब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2082440, "chapter_id": 2754, "verse_number": "१२-२५९-१५", "content_sanskrit": "विदित्वा सप्तसूक्ष्माणि षडङ्गं च महेश्वरम्।\nप्रधानविनियोगज्ञः परं ब्रह्मानुपश्यति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2082441, "chapter_id": 2754, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि एकोनषष्ट्यधिकद्विशततमोऽध्यायः॥ २५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]