[{"id": 7001110000, "chapter_id": 21110, "verse_number": "२-२-१-१", "content_sanskrit": "नारद उवाच ।\nविधे सर्वं विजानासि कृपया शंकरस्य च ।\nत्वयाद्भुता हि कथिताः कथा मे शिवयोश्शुभाः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001110001, "chapter_id": 21110, "verse_number": "२-२-१-२", "content_sanskrit": "त्वन्मुखांभोजसंवृत्तां श्रुत्वा शिवकथां पराम् ।\nअतृप्तो हि पुनस्तां वै श्रोतुमिच्छाम्यहं प्रभो॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001110002, "chapter_id": 21110, "verse_number": "२-२-१-३", "content_sanskrit": "पूर्णांशश्शंकरस्यैव यो रुद्रो वर्णितः पुरा ।\nविधे त्वया महेशानः कैलासनिलयो वशी॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001110003, "chapter_id": 21110, "verse_number": "२-२-१-४", "content_sanskrit": "स योगी सर्वविष्ण्वादिसुरसे व्यस्सतां गतिः ।\nनिर्द्वंद्वः क्रीडति सदा निर्विकारी महाप्रभुः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001110004, "chapter_id": 21110, "verse_number": "२-२-१-५", "content_sanskrit": "सोऽभूत्पुनर्गृहस्थश्च विवाह्य परमां स्त्रियम् ।\nहरिप्रार्थनया प्रीत्या मंगलां स्वतपस्विनीम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001110005, "chapter_id": 21110, "verse_number": "२-२-१-६", "content_sanskrit": "प्रथमं दक्षपुत्री सा पश्चात्सा पर्वतात्मजा ।\nकथमेकशरीरेण द्वयोरप्यात्मजा मता॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001110006, "chapter_id": 21110, "verse_number": "२-२-१-७", "content_sanskrit": "कथं सती पार्वती सा पुनश्शिवमुपागता ।\nएतत्सर्वं तथान्यच्च ब्रह्मन् गदितुमर्हसि॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001110007, "chapter_id": 21110, "verse_number": "२-२-१-८", "content_sanskrit": "सूत उवाच ।\nइति तस्य वचः श्रुत्वा सुरर्षेः शंकरात्मनः ।\nप्रसन्नमानसो भूत्वा ब्रह्मा वचनमब्रवीत्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001110008, "chapter_id": 21110, "verse_number": "२-२-१-९", "content_sanskrit": "ब्रह्मोवाच ।\nशृणु तात मुनिश्रेष्ठ कथयामि कथां शुभाम् ।\nयां श्रुत्वा सफलं जन्म भविष्यति न संशयः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001110009, "chapter_id": 21110, "verse_number": "२-२-१-१०", "content_sanskrit": "पुराहं स्वसुतां दृष्ट्वा संध्याह्वां तनयैस्सह ।\nअभवं विकृतस्तात कामबाणप्रपीडितः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001110010, "chapter_id": 21110, "verse_number": "२-२-१-११", "content_sanskrit": "धर्मः स्मृतस्तदा रुद्रो महायोगी परः प्रभुः ।\nधिक्कृत्य मां सुतैस्तात स्वस्थानं गतवानयम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001110011, "chapter_id": 21110, "verse_number": "२-२-१-१२", "content_sanskrit": "यन्मायामोहितश्चाहं वेदवक्ता च मूढधीः ।\nतेनाकार्षं सहाकार्य परमेशेन शंभुना॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001110012, "chapter_id": 21110, "verse_number": "२-२-१-१३", "content_sanskrit": "तदीर्षयाहमाकार्षं बहूपायान्सुतैः सह ।\nकर्तुं तन्मोहनं मूढः शिवमाया विमोहितः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001110013, "chapter_id": 21110, "verse_number": "२-२-१-१४", "content_sanskrit": "अभवंस्तेऽथ वै सर्वे तस्मिञ् शंभो परप्रभो ।\nउपाया निष्फलास्तेषां मम चापि मुनीश्वर॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001110014, "chapter_id": 21110, "verse_number": "२-२-१-१५", "content_sanskrit": "तदाऽस्मरं रमेशानं व्यथोपायस्तुतैस्सह ।\nअबोधयत्स आगत्य शिवभक्तिरतस्सुधीः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001110015, "chapter_id": 21110, "verse_number": "२-२-१-१६", "content_sanskrit": "प्रबोधितो रमेशेन शिवतत्त्वप्रदर्शिना ।\nतदीर्षामत्यजं सोहं तं हठं न विमोहितः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001110016, "chapter_id": 21110, "verse_number": "२-२-१-१७", "content_sanskrit": "शक्तिं संसेव्य तत्प्रीत्योत्पादयामास तां तदा ।\nदक्षादशिक्न्यां वीरिण्यां स्वपुत्राद्धरमोहने॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001110017, "chapter_id": 21110, "verse_number": "२-२-१-१८", "content_sanskrit": "सोमा भूत्वा दक्षसुता तपः कृत्वा तु दुस्सहम् ।\nरुद्रपत्न्यभवद्भक्त्या स्वभक्तहितकारिणी॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001110018, "chapter_id": 21110, "verse_number": "२-२-१-१९", "content_sanskrit": "सोमो रुद्रो गृही भूत्वाऽकार्षील्लीलां परां प्रभुः ।\nमोहयित्वाथ मां तत्र स्वविवाहेऽविकारधीः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001110019, "chapter_id": 21110, "verse_number": "२-२-१-२०", "content_sanskrit": "विवाह्य तां स आगत्य स्वगिरौ सूतिकृत्तया ।\nरेमे बहुविमोहो हि स्वतंत्रस्स्वात्तविग्रहः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001110020, "chapter_id": 21110, "verse_number": "२-२-१-२१", "content_sanskrit": "तया विहरतस्तस्य व्यातीयाय महान् मुने ।\nकालस्सुखकरश्शभोर्निर्विकारस्य सद्रतेः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001110021, "chapter_id": 21110, "verse_number": "२-२-१-२२", "content_sanskrit": "ततो रुद्रस्य दक्षेण स्पर्द्धा जाता निजेच्छया ।\nमहामूढस्य तन्मायामोहितस्य सुगर्विणः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001110022, "chapter_id": 21110, "verse_number": "२-२-१-२३", "content_sanskrit": "तत्प्रभावाद्धरं दक्षो महागर्वी विमूढधीः ।\nमहाशांतं निर्विकारं निनि द बहुमोहितः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001110023, "chapter_id": 21110, "verse_number": "२-२-१-२४", "content_sanskrit": "ततो दक्षः स्वयं यज्ञं कृतवान्गर्वितोऽहरम् ।\nसर्वानाहूय देवादीन् विष्णुं मां चाखिलाधिपः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001110024, "chapter_id": 21110, "verse_number": "२-२-१-२५", "content_sanskrit": "नाजुहाव तथाभूतो रुद्रं रोषसमाकुलः ।\nतथा तत्र सतीं नाम्ना स्वपुत्रीं विधिमोहितः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001110025, "chapter_id": 21110, "verse_number": "२-२-१-२६", "content_sanskrit": "यदा नाकारिता पित्रा मायामोहित चेतसा ।\nलीलां चकार सुज्ञाना महासाध्वी शिवा तदा॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001110026, "chapter_id": 21110, "verse_number": "२-२-१-२७", "content_sanskrit": "अथागता सती तत्र शिवाज्ञामधिगम्य सा ।\nअनाहूतापि दक्षेण गर्विणा स्वपितुर्गृहम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001110027, "chapter_id": 21110, "verse_number": "२-२-१-२८", "content_sanskrit": "विलोक्य रुद्रभागं नो प्राप्यावज्ञां च ताततः ।\nविनिंद्य तत्र तान्सर्वान्देहत्यागमथाकरोत्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001110028, "chapter_id": 21110, "verse_number": "२-२-१-२९", "content_sanskrit": "तच्छुत्वा देव देवेशः क्रोधं कृत्वा तु दुस्सहम् ।\nजटामुत्कृत्य महतीं वीरभद्रमजीजनत्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001110029, "chapter_id": 21110, "verse_number": "२-२-१-३०", "content_sanskrit": "सगणं तं समुत्पाद्य किं कुर्य्या मिति वादिनम् ।\nसर्वापमानपूर्वं हि यज्ञध्वंसं दिदेश ह॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001110030, "chapter_id": 21110, "verse_number": "२-२-१-३१", "content_sanskrit": "तदाज्ञां प्राप्य स गणाधीशो बहुबलान्वितः ।\nगतोऽरं तत्र सहसा महाबलपराक्रमः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001110031, "chapter_id": 21110, "verse_number": "२-२-१-३२", "content_sanskrit": "महोपद्रवमाचेरुर्गणास्तत्र तदाज्ञया ।\nसर्वान्स दंडयामास न कश्चिदवशेषितः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001110032, "chapter_id": 21110, "verse_number": "२-२-१-३३", "content_sanskrit": "विष्णुं संजित्य यत्नेन सामरं गणसत्तमः ।\nचक्रे दक्षशिरश्छेदं तच्छिरोग्नौ जुहाव च॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001110033, "chapter_id": 21110, "verse_number": "२-२-१-३४", "content_sanskrit": "यज्ञध्वंसं चकाराशु महोपद्रवमाचरन् ।\nततो जगाम स्वगिरिं प्रणनाम प्रभुं शिवम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001110034, "chapter_id": 21110, "verse_number": "२-२-१-३५", "content_sanskrit": "यज्ञध्वंसोऽभवच्चेत्थं देवलोके हि पश्यति ।\nरुद्रस्यानुचरैस्तत्र वीरभद्रादिभिः कृतः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001110035, "chapter_id": 21110, "verse_number": "२-२-१-३६", "content_sanskrit": "मुने नीतिरियं ज्ञेया श्रुतिस्मृतिषु संमता ।\nरुद्रे रुष्टे कथं लोके सुखं भवति सुप्रभो॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001110036, "chapter_id": 21110, "verse_number": "२-२-१-३७", "content_sanskrit": "ततो रुद्रः प्रसन्नोभूत्स्तुतिमाकर्ण्य तां पराम् ।\nविज्ञप्तिं सफलां चक्रे सर्वेषां दीनवत्सलः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001110037, "chapter_id": 21110, "verse_number": "२-२-१-३८", "content_sanskrit": "पूर्ववच्च कृतं तेन कृपालुत्वं महात्मना ।\nशंकरेण महेशेन नानालीलावि हारिणा॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001110038, "chapter_id": 21110, "verse_number": "२-२-१-३९", "content_sanskrit": "जीवितस्तेन दक्षो हि तत्र सर्वे हि सत्कृताः ।\nपुनस्स कारितो यज्ञः शंकरेण कृपालुना॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001110039, "chapter_id": 21110, "verse_number": "२-२-१-४०", "content_sanskrit": "रुद्रश्च पूजितस्तत्र सर्वैर्देवैर्विशेषतः ।\nयज्ञे विश्वादिभिर्भक्त्या सुप्रसन्नात्मभिर्वने॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001110040, "chapter_id": 21110, "verse_number": "२-२-१-४१", "content_sanskrit": "सतीदेहसमुत्पन्ना ज्वाला लोकसुखावहा ।\nपतिता पर्वते तत्र पूजिता सुखदायिनी॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001110041, "chapter_id": 21110, "verse_number": "२-२-१-४२", "content_sanskrit": "ज्वालामुखीति विख्याता सर्वकामफलप्रदा ।\nबभूव परमा देवी दर्शनात्पापहारिणी॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001110042, "chapter_id": 21110, "verse_number": "२-२-१-४३", "content_sanskrit": "इदानीं पूज्यते लोके सर्वकामफलाप्तये ।\nसंविधाभिरनेकाभिर्महोत्सवपरस्परम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001110043, "chapter_id": 21110, "verse_number": "२-२-१-४४", "content_sanskrit": "ततश्च सा सती देवी हिमालयसुता ऽभवत् ।\nतस्याश्च पार्वतीनाम प्रसिद्धमभवत्तदा॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001110044, "chapter_id": 21110, "verse_number": "२-२-१-४५", "content_sanskrit": "सा पुनश्च समाराध्य तपसा कठिनेन वै ।\nतमेव परमेशानं भर्त्तारं समुपाश्रिता॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001110045, "chapter_id": 21110, "verse_number": "२-२-१-४६", "content_sanskrit": "एतत्सर्वं समाख्यातं यत्पृष्टोहं मुनीश्वर ।\nयच्छ्रुत्वा सर्वपापेभ्यो मुच्यते नात्र संशयः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]