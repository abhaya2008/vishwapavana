[{"id": 7005993000, "chapter_id": 25993, "verse_number": "१-१७६-१", "content_sanskrit": "श्रीभगवानुवाच ।\nसप्तरात्रात्प्रजायन्ते खल्वाटस्य कचाः शभाः ।\nदग्धहस्तिदन्तलेपात्साजाक्षीररसाञ्जनात् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005993001, "chapter_id": 25993, "verse_number": "१-१७६-२", "content_sanskrit": "भृङ्गराजरसेनैव चतुर्भागेन साधितम् ।\nकेशवृद्धिकरं तैलं गुञ्जाचूर्णान्वितेन च ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005993002, "chapter_id": 25993, "verse_number": "१-१७६-३", "content_sanskrit": "एलामांसीकुष्ठमुरायुक्तमभ्यङ्गतः शिवम् ।\nगुञ्जाफलं समादेयं लेपनं चन्द्रलुप्तनुत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005993003, "chapter_id": 25993, "verse_number": "१-१७६-४", "content_sanskrit": "आम्रास्थिचूर्णलेपाद्वै केशाः सूक्ष्माभवन्ति च ।\nकरञ्जामलकैलाललाक्षालेपोऽरुणापहः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005993004, "chapter_id": 25993, "verse_number": "१-१७६-५", "content_sanskrit": "आम्रास्थिमज्जामलकलेपात्केशा भवन्ति वै ।\nबद्धमूला घना दीर्घाः स्नग्धाः स्युर्नोत्पतन्ति च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005993005, "chapter_id": 25993, "verse_number": "१-१७६-६", "content_sanskrit": "विडङ्गगन्धपाषाणसाधितं तैलमुत्तमम् ।\nसचतुर्गुणगोमूत्रं मनसः शिलमेव वा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005993006, "chapter_id": 25993, "verse_number": "१-१७६-७", "content_sanskrit": "शिरोऽभ्यङ्गाच्छिराजन्मयूकालिख्याः क्षयं नयत् ।\nनवदग्धं शङ्खचूर्णं घृष्टसीसकलेपितम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005993007, "chapter_id": 25993, "verse_number": "१-१७६-८", "content_sanskrit": "कचाः श्लक्ष्णा महाकृष्णा भवन्ति वृषभध्ज ।\nभृङ्गराजं लोहचूर्णं त्रिफला बीजपूरकम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005993008, "chapter_id": 25993, "verse_number": "१-१७६-९", "content_sanskrit": "नीली च करवीरं च गुडमेतैः समं शृतम् ।\nपलितानीह कृष्णानि कुर्याल्लेपान्महौषधम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005993009, "chapter_id": 25993, "verse_number": "१-१७६-१०", "content_sanskrit": "आम्रास्थिमज्जा त्रिफला नी (ता) ली च भृङ्गरजकम् ।\nजीर्णं पक्वं लोहचूर्णं काञ्जिकं कृष्णकेशकृत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005993010, "chapter_id": 25993, "verse_number": "१-१७६-११", "content_sanskrit": "चक्रमर्दकबीजानि कुष्ठमेरण्डमूलकम् ।\nअत्यम्लकाञ्जिकं पिष्ट्वा लेपान्मस्तकरोगनुत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005993011, "chapter_id": 25993, "verse_number": "१-१७६-१२", "content_sanskrit": "सैन्धवं च वचा हिङ्गु कुष्ठं नागेश्वरं थ ।\nशतपुष्पा देवदारु एभिस्तैलं तु साधितम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005993012, "chapter_id": 25993, "verse_number": "१-१७६-१३", "content_sanskrit": "गोपुरीपरसेनैव चतुर्भागेन संयुतम् ।\nतत्कणभरणादुग्रकर्णशूलं क्षयं नयेत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005993013, "chapter_id": 25993, "verse_number": "१-१७६-१४", "content_sanskrit": "मेषमूत्रसैन्धवाभ्यां कर्णयोर्भरणाच्छिव ।\nकर्णयोः पूतिनाशः स्यात्कृमिस्त्रावादिकस्य च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005993014, "chapter_id": 25993, "verse_number": "१-१७६-१५", "content_sanskrit": "मालतीपुप्पदलयो रसेन भरणात्तथा ।\nगोजलेनैव पूरेण पूयस्त्रावो विनश्यति ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005993015, "chapter_id": 25993, "verse_number": "१-१७६-१६", "content_sanskrit": "कष्ठमाषमरीचानि तगरं मधु पिप्पली ।\nअपामार्गोऽश्वगन्धा च बृहती सितसर्षपाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005993016, "chapter_id": 25993, "verse_number": "१-१७६-१७", "content_sanskrit": "यवास्तिलाः सैन्धवं च पादिकोद्वर्तनं शुभम् ।\nलिङ्गबाहुस्तनानां च कर्णयोर्वृद्धिकृद्वत् ।\nकटुतैलं भल्लातकं बृहती फलदाडिमम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005993017, "chapter_id": 25993, "verse_number": "१-१७६-१८", "content_sanskrit": "वल्कलैः साधितैर्लिप्तं लिङ्गं तेन विवर्धते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]