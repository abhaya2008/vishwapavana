[{"id": 7003137000, "chapter_id": 23137, "verse_number": "४-७३-१", "content_sanskrit": "अथ त्रिसप्ततितमोध्यायः ।\nनारायण उवाच ।\nअथ कृष्णश्च सानन्दं नन्दं तं पितरं बलः ।\nबोधयामास शोकार्तं दिव्यैराध्यात्मिकादिभिः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003137001, "chapter_id": 23137, "verse_number": "४-७३-२", "content_sanskrit": "उच्चै रुदन्तं निश्चेष्टं पुत्रविच्चेदकातरम् ।\nदत्त्वा तस्मै मणिश्रेष्ठमित्युवाच जगत्पतिः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003137002, "chapter_id": 23137, "verse_number": "४-७३-३", "content_sanskrit": "श्रीभगवानुवाच ।\nनिबोध नन्द सानन्दं त्यज शोकं मुदं लभ ।\nज्ञानं गृहाण मद्दत्तं यद्दतं ब्रह्मणे पुरा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003137003, "chapter_id": 23137, "verse_number": "४-७३-४", "content_sanskrit": "यद्यद्दत्तं च शोषाय गणेशायेश्वराय च ।\nदिनेशाय मुनीशाय योगीशाय च पुष्करे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003137004, "chapter_id": 23137, "verse_number": "४-७३-५", "content_sanskrit": "कःकस्य पुत्रः कस्तातः का माता कस्यचित्कुतः ।\nआयान्ति यान्ति संसारं परं स्वकृतकर्मणा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003137005, "chapter_id": 23137, "verse_number": "४-७३-६", "content_sanskrit": "कर्मानुसाराज्जन्तुश्च जायते स्थानभेदतः ।\nकर्मणा कोऽपि जन्तुश्च योगीन्द्राणां नृपस्त्रियाम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003137006, "chapter_id": 23137, "verse_number": "४-७३-७", "content_sanskrit": "द्विजापत्न्यां क्षत्रियाणां वैश्यायां शूद्रयोनिषु ।\nतिर्यग्योनिषु कश्चिच्च कश्चित्पश्वादियोनिषु ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003137007, "chapter_id": 23137, "verse_number": "४-७३-८", "content_sanskrit": "ममैव मायया सर्वे सानन्दा विषयेषु च ।\nदेहत्यामे विषण्णाश्च विच्छेदे बान्धवस्य च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003137008, "chapter_id": 23137, "verse_number": "४-७३-९", "content_sanskrit": "प्रजाभूमिधनादीनां विच्छेदो मरणाधिकः ।\nनित्यं भवति मूढश्च न च विद्वाञ्छुचा युतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003137009, "chapter_id": 23137, "verse_number": "४-७३-१०", "content_sanskrit": "मद्भक्तो भक्तियुक्तश्च मद्याजी विजितेन्द्रियः ।\nमन्मन्त्रोपासकश्चैव मत्सेवानिरतः शुचिः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003137010, "chapter_id": 23137, "verse_number": "४-७३-११", "content_sanskrit": "मद्भयाद्वाति वातोऽयं रविर्भाति च नित्यशः ।\nभाति चन्द्रो महेन्द्रश्च कालभेदे च वर्षति ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003137011, "chapter_id": 23137, "verse_number": "४-७३-१२", "content_sanskrit": "वह्निर्वहति मृत्युश्च चरत्येव हि जन्तुषु ।\nबिभर्ति वृक्षः कालेन पुष्पापि च फलानि च ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003137012, "chapter_id": 23137, "verse_number": "४-७३-१३", "content_sanskrit": "निराधारश्च वायुश्च वाय्वाधारश्च कच्चिपः ।\nशेषश्च कच्छपाधारः शेषाधारश्च पर्वतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003137013, "chapter_id": 23137, "verse_number": "४-७३-१४", "content_sanskrit": "तदाधाराश्च पातालाः सप्त एव हि पङ्क्तितः ।\nनिश्चलं च जलं तस्माज्जलस्था च वसुंधरा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003137014, "chapter_id": 23137, "verse_number": "४-७३-१५", "content_sanskrit": "सप्तस्वर्ग धराधारं ज्योतिश्चकं ग्रहाश्रयम् ।\nनिराधारश्च वैकुण्ठो ब्रह्माण्डेम्यः परो वरः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003137015, "chapter_id": 23137, "verse_number": "४-७३-१६", "content_sanskrit": "तत्परश्चापि गोलोकः पञ्चाशत्को टियोजनात् ।\nऊर्ध्व निराश्रयश्चापि रत्नसारविनिर्मितः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003137016, "chapter_id": 23137, "verse_number": "४-७३-१७", "content_sanskrit": "सप्तद्वारः सप्तसारः परिखासप्तसंयुतः ।\nलक्षप्राकारयुक्तश्च नद्या विरजया युतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003137017, "chapter_id": 23137, "verse_number": "४-७३-१८", "content_sanskrit": "वेष्टितो रत्नशैलेन शतशृङ्गेण चारुणा ।\nयोजनायुतमानं च यस्यैकं शृङ्गमुज्ज्वलम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003137018, "chapter_id": 23137, "verse_number": "४-७३-१९", "content_sanskrit": "शतकोटियोजनश्च शैल उच्छ्रित एव च ।\nदैर्ध्यं तस्य शतगुणं प्रस्थं च लक्षयोजनम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003137019, "chapter_id": 23137, "verse_number": "४-७३-२०", "content_sanskrit": "योजनायुतविस्तीर्णस्तत्रैव रासमण्डलः ।\nअमूल्यरत्ननिर्माणो वर्तुलश्चन्द्रबिम्बवतु ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003137020, "chapter_id": 23137, "verse_number": "४-७३-२१", "content_sanskrit": "पारिजातवनेनैव पुष्पितेन च वेव्टितः ।\nकल्पवृक्षसहस्रेण पुष्पोद्यानशतेन च ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003137021, "chapter_id": 23137, "verse_number": "४-७३-२२", "content_sanskrit": "नानाविधैः पुष्पवृक्षैः पुष्पितेन च चारुणा ।\nत्रिकोटिरत्नभवनो गोपीलक्षैश्च रक्षितः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003137022, "chapter_id": 23137, "verse_number": "४-७३-२३", "content_sanskrit": "रत्नप्रदीपयुक्तश्च रत्नतल्पसमन्वितः ।\nनानाभोगसमायुक्तो सधुवापीशतैर्वृतः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003137023, "chapter_id": 23137, "verse_number": "४-७३-२४", "content_sanskrit": "पीयूषवापीयुक्तश्च कामभोगसमन्वितः ।\nगोलोकगृहसंख्यानवर्णने वा विशारदः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003137024, "chapter_id": 23137, "verse_number": "४-७३-२५", "content_sanskrit": "न कोऽपि वेद विद्वान्वा वेदविद्वान्व्रजेश्वरः ।\nअमूल्यरत्ननिर्माणभवनानां त्रिकोटिभिः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003137025, "chapter_id": 23137, "verse_number": "४-७३-२६", "content_sanskrit": "शोभितं सुन्दरं रम्यं राधाशिविरमुत्तमम् ।\nअमूल्यरत्नकलशैरुज्ज्वलं रत्नदर्पणैः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003137026, "chapter_id": 23137, "verse_number": "४-७३-२७", "content_sanskrit": "असूल्यरत्नस्तमभानां राजिभिश्च विराजितम् ।\nनानाचित्रविचित्रैश्च चित्रितं श्वेतचामरैः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003137027, "chapter_id": 23137, "verse_number": "४-७३-२८", "content_sanskrit": "माणिक्यमुक्तासंसक्तं हीरावारसमन्वितम् ।\nरत्नप्रदीपसंसक्तं रत्नसोपानसुन्दरम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003137028, "chapter_id": 23137, "verse_number": "४-७३-२९", "content_sanskrit": "अमूल्यरत्नपत्रैश्च तल्पराजिविराजितम् ।\nअमूल्यरत्नचित्रैश्च त्रिभिश्चित्रविचित्रितैः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003137029, "chapter_id": 23137, "verse_number": "४-७३-३०", "content_sanskrit": "तिसृभिः परिखाभिश्च त्रिभिर्द्वारैश्च दुर्गमैः ।\nयुक्तं षोडशकक्षाभिः प्रतिद्वारेषु वाऽन्तरम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003137030, "chapter_id": 23137, "verse_number": "४-७३-३१", "content_sanskrit": "गोपीषोडशलक्षैश्च संनियुक्तैरितस्ततः ।\nवह्निशुद्धांशुकाधानै रत्नभूषणभूषितैः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003137031, "chapter_id": 23137, "verse_number": "४-७३-३२", "content_sanskrit": "तप्तकाञ्चनवर्णाभैः शतचन्द्रसमन्वितैः ।\nराधिकारिंकरीवर्गैर्युक्तमभ्यन्तरं वरम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003137032, "chapter_id": 23137, "verse_number": "४-७३-३३", "content_sanskrit": "अमूल्यरत्ननिर्माणप्रङ्गणं सुमनोहरम् ।\nअमूल्यरत्नस्तम्भानां समूरैश्च सुशोभितम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003137033, "chapter_id": 23137, "verse_number": "४-७३-३४", "content_sanskrit": "रत्नमङ्गलकुम्भैश्च फलपल्लवसंयुतैः ।\nसंयुतं रत्नवेदीभिर्मुक्ता युक्ताभिरीप्सितम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003137034, "chapter_id": 23137, "verse_number": "४-७३-३५", "content_sanskrit": "अमूल्यरत्नमुकुरैः शोभितं सुन्दरैरहो ।\nअमूल्यरत्ननिर्माणं भवनानां वरं गृहम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003137035, "chapter_id": 23137, "verse_number": "४-७३-३६", "content_sanskrit": "रत्नसिंहासनस्था च गोपीलक्षैश्च सेविता ।\nकोटिपूर्णेन्दुशोभाढ्या श्वेतचम्पकसंनिभा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003137036, "chapter_id": 23137, "verse_number": "४-७३-३७", "content_sanskrit": "अमूल्यरत्ननिर्माणभूषणैश्च विभूषिता ।\nअमूल्यरत्नवसना बिभ्रती रत्नदर्पणम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003137037, "chapter_id": 23137, "verse_number": "४-७३-३८", "content_sanskrit": "रत्नपद्मं च रुचिरं सव्यदक्षिणहस्ततः ।\nदाडिम्बकुसुमाकारं सिन्दूरं सुमनोहरम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003137038, "chapter_id": 23137, "verse_number": "४-७३-३९", "content_sanskrit": "सुशोभितं सृगमदैरिष्टैश्चन्दनबिन्दुभिः ।\nदधती कबरीभारं मालतीमल्यमण्डितम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003137039, "chapter_id": 23137, "verse_number": "४-७३-४०", "content_sanskrit": "रचितं वामभगेन मुनीन्द्राणां मनोहरम् ।\nएवंभूतं (ता) तत्र राधा गोपीभिः परिसेविता ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003137040, "chapter_id": 23137, "verse_number": "४-७३-४१", "content_sanskrit": "श्वेतचामरहस्ताभिस्तत्तुल्याभिश्च सर्वतः ।\nअमूल्यरत्ननिर्माणैर्भूषिताभिश्च भूषणैः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003137041, "chapter_id": 23137, "verse_number": "४-७३-४२", "content_sanskrit": "मत्प्राणाधिष्ठातृदेवी देवीनां प्रवरा वरा ।\nसुदाम्नः सा च शापेन वृषभानसुताऽधुना ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003137042, "chapter_id": 23137, "verse_number": "४-७३-४३", "content_sanskrit": "शताब्दिको हि विच्छेदो भविष्यति मया सह ।\nतेन भारावतरणं करिष्यसि भुवः पितः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003137043, "chapter_id": 23137, "verse_number": "४-७३-४४", "content_sanskrit": "तदा यास्यामि गोलोकं तया सार्धं सुनिश्चतम् ।\nत्वया यशोदया चाऽपि गोबैर्गोपीभिरेव च ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003137044, "chapter_id": 23137, "verse_number": "४-७३-४५", "content_sanskrit": "वृषभानेन तत्पत्न्या कलावत्या च बान्धवैः ।\nएवं च नन्दं सानन्दं यशोदां कथयिष्यसि ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003137045, "chapter_id": 23137, "verse_number": "४-७३-४६", "content_sanskrit": "त्यज शोक्रं महाभाग व्रजैः सार्धं व्रजं व्रज ।\nअहमात्मा च साक्षी च निर्लिप्तः सर्वजीविषु ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003137046, "chapter_id": 23137, "verse_number": "४-७३-४७", "content_sanskrit": "जीवो मत्प्रतिबिम्बश्च इत्येवं सर्वसंमतम् ।\nप्रकृतिर्मद्विकारा च साऽप्यहं प्रकृतिः स्वयम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003137047, "chapter_id": 23137, "verse_number": "४-७३-४८", "content_sanskrit": "यथा दुग्धे च धावल्यं न तर्योर्भैद एव च ।\nयथा जले तथा शैत्यं यथा वह्नौ च दाहिका ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003137048, "chapter_id": 23137, "verse_number": "४-७३-४९", "content_sanskrit": "यथाऽऽकाशे तथा शब्दो भूमौ गन्धो यथा नृप ।\nयथा शोभा च चन्द्रे च यथा दिनकरे प्रभा ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003137049, "chapter_id": 23137, "verse_number": "४-७३-५०", "content_sanskrit": "यथा दीवस्तथाऽऽत्माहं तथैव राधया सह ।\nत्यज त्वं गोपिकाबुद्धिं राधायां मयि पुत्रताम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003137050, "chapter_id": 23137, "verse_number": "४-७३-५१", "content_sanskrit": "अहं सर्वस्य प्रभावः सा च प्रकृतिनीश्वरी ।\nश्रूयतां नन्द सानन्दं मद्विभूतिं सुखावहाम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003137051, "chapter_id": 23137, "verse_number": "४-७३-५२", "content_sanskrit": "पुरा या कथिता तात ब्रह्मणे व्यक्तजन्मने ।\nकृष्णोऽहं देवतानां च गोलोके द्विभुजः स्वयम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003137052, "chapter_id": 23137, "verse_number": "४-७३-५३", "content_sanskrit": "चतुर्भुजोऽहं वैकुण्ठे शिवलोके शिवः स्वयम् ।\nब्रह्मलोके च ब्रह्माऽहं सूयस्तेजस्विनामहम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003137053, "chapter_id": 23137, "verse_number": "४-७३-५४", "content_sanskrit": "पवित्राणामहं वह्निर्जलमेव द्रवेषु च ।\nइन्द्रियाणां मनश्चास्मि समीरः शीघ्रगामिनाम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003137054, "chapter_id": 23137, "verse_number": "४-७३-५५", "content_sanskrit": "यमोऽहं दण्डकर्त णां कालः कलयतामहम् ।\nअक्षराणामकारोऽस्मि साम्नां च साम एव च ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003137055, "chapter_id": 23137, "verse_number": "४-७३-५६", "content_sanskrit": "इन्द्रश्चतुर्दशेन्द्रेषु कुबेरो धनिनामहम् ।\nईशानोऽहं दिमीशानां व्यापकानां नभस्तथा ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003137056, "chapter_id": 23137, "verse_number": "४-७३-५७", "content_sanskrit": "सर्वान्तरात्मा जीवेषु ब्राह्मणश्चाऽऽश्रमेषु च ।\nधनानां च रत्नमहममूल्यं सर्वदुर्लभम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003137057, "chapter_id": 23137, "verse_number": "४-७३-५८", "content_sanskrit": "तैजसानां सुवर्णोऽहं मणीनां कौस्तुभः स्वयम् ।\nवैष्णवानां कुमारोऽहं योगीन्द्राणां गणेश्वरः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003137058, "chapter_id": 23137, "verse_number": "४-७३-५९", "content_sanskrit": "पुष्पाणां पारिजातोऽहं तीर्थानां पुष्करः स्वयम् ।\nशालग्रामस्तथाऽर्च्यानां पत्राणां तुलसीति च ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003137059, "chapter_id": 23137, "verse_number": "४-७३-६०", "content_sanskrit": "सेनापतीनां स्कन्दोऽहं लक्ष्मणोऽहं धनुष्मताम् ।\nराजेन्द्राणां च रामोऽहं नक्षत्राणामहं शशी ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003137060, "chapter_id": 23137, "verse_number": "४-७३-६१", "content_sanskrit": "मासानां मर्गशीर्षोऽहमृतूनामस्मि माधवः ।\nवारेष्वादित्यवारोऽहं तिथिष्वेकादशीति च ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003137061, "chapter_id": 23137, "verse_number": "४-७३-६२", "content_sanskrit": "सहिष्णूनां च पृथिवी माताऽहं बान्धवेषु च ।\nअमृतं भक्ष्यवस्तूनां गव्येष्वाज्यमहं तथा ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003137062, "chapter_id": 23137, "verse_number": "४-७३-६३", "content_sanskrit": "कल्पवृक्षश्च वृक्षाणां सुरभिः कामधेनुषु ।\nगङ्गाऽहं सरितां मध्ये कृतपापविनाशिनी ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003137063, "chapter_id": 23137, "verse_number": "४-७३-६४", "content_sanskrit": "वाणीति पण्डितानां च मन्त्राणां प्रणवस्तथा ।\nविद्यासु बीजरूपोऽहं सस्यानां धान्यमेव च ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003137064, "chapter_id": 23137, "verse_number": "४-७३-६५", "content_sanskrit": "अश्वत्थः फलिनामेव गुरूणां मन्त्रदः स्वयम् ।\nकश्यपश्च प्रजेशानां गरुडः पक्षिणां तथा ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003137065, "chapter_id": 23137, "verse_number": "४-७३-६६", "content_sanskrit": "अनन्तोऽहं च नागानां नराणां च नराधिपः ।\nब्रह्मर्षीणां भृगुरहं देवर्षीणां च नारदः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003137066, "chapter_id": 23137, "verse_number": "४-७३-६७", "content_sanskrit": "राजर्षीणां च जनको महर्षीणां शुकस्तथा ।\nगन्धर्वाणां चित्ररथः सिद्धानां कपिलो मुनीः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003137067, "chapter_id": 23137, "verse_number": "४-७३-६८", "content_sanskrit": "बृहस्पतिर्बुद्धिमतां कवीनां शुक्र एव च ।\nग्रहाणां च शनिरहं विश्वकर्मा च शिल्पिनाम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003137068, "chapter_id": 23137, "verse_number": "४-७३-६९", "content_sanskrit": "मृगाणां च मृगेन्दोऽहं वृषाणां शिववाहनम् ।\nऐरावतो गजेन्द्राणां गायत्री छन्दसामहम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003137069, "chapter_id": 23137, "verse_number": "४-७३-७०", "content_sanskrit": "वेदाश्च सर्वशास्त्राणां वरुणो यादसामहम् ।\nउर्वश्यप्सरसामेव समुद्राणां जलार्णवः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003137070, "chapter_id": 23137, "verse_number": "४-७३-७१", "content_sanskrit": "सुमेरुः पर्वतानां च रत्नवत्सु हिमालयः ।\nदुर्गा च प्रकृतीनां च देवीनां कमलालया ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003137071, "chapter_id": 23137, "verse_number": "४-७३-७२", "content_sanskrit": "शतरूपा च नारीणां मत्प्रियाणां च राधिका ।\nसाध्वीनामपि सावित्री वेदमाता च निश्चितम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003137072, "chapter_id": 23137, "verse_number": "४-७३-७३", "content_sanskrit": "प्रह्लादश्चापि दैत्यानां बलिष्ठानां बलिः स्वयाम् ।\nनारायणर्षिर्भगवाञ्ज्ञानिनां मध्य एव च ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003137073, "chapter_id": 23137, "verse_number": "४-७३-७४", "content_sanskrit": "हनूमान्वानराणां च पाण्डवानां धनंजयः ।\nमनसा नागकन्यानां वसूनां द्रोण एव च ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003137074, "chapter_id": 23137, "verse_number": "४-७३-७५", "content_sanskrit": "द्रोणो जलधराणां च वर्षाणां भारतं तथा ।\nकामिनां कामदेवोऽहं रम्भा च कामुकीषु च ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003137075, "chapter_id": 23137, "verse_number": "४-७३-७६", "content_sanskrit": "गोलोकश्चास्मि लोकानासुत्तमः सर्वतः परः ।\nमातृकासु शान्तिरहं रतिश्च सुन्दरीषु च ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003137076, "chapter_id": 23137, "verse_number": "४-७३-७७", "content_sanskrit": "धर्मोऽहं साक्षिणां मध्ये संध्या च वासरेषु च ।\nदेवेष्वहं च माहेन्दो राक्षसेषु विभीषणः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003137077, "chapter_id": 23137, "verse_number": "४-७३-७८", "content_sanskrit": "कालाग्निरुद्रो रुद्राणां संहारो भैरवेषु च ।\nशङ्खेषु पाञ्चजन्योऽहमङ्गेष्वपि च मस्तकः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003137078, "chapter_id": 23137, "verse_number": "४-७३-७९", "content_sanskrit": "परं पुराणसूत्रेषु चाहं भागवतं वरम् ।\nभारतं चेतिहासेषु पञ्चरात्रेषु कापिलम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003137079, "chapter_id": 23137, "verse_number": "४-७३-८०", "content_sanskrit": "स्वायंभुवो मनूनां च मुनीनां व्यासदेवकः ।\nस्वधाऽहं पितृपत्नीषु स्वाहा वङ्निप्रियासु च ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003137080, "chapter_id": 23137, "verse_number": "४-७३-८१", "content_sanskrit": "यज्ञानां नाजसूयोऽहं यज्ञपत्नीषु दक्षिणा ।\nशस्त्रास्त्रज्ञेषु रामोऽहं जमदग्निसुतो महान् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003137081, "chapter_id": 23137, "verse_number": "४-७३-८२", "content_sanskrit": "पौराणिकेषु सूतोऽहं नीतिमत्स्वङ्गिरा मुनिः ।\nविष्णुव्रतं व्रतानां च बलानां दैवमेव च ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003137082, "chapter_id": 23137, "verse_number": "४-७३-८३", "content_sanskrit": "ओषधीनामहं दूर्वा तृणानां कुशमेव च ।\nधर्मकर्मसु सत्यं च स्नेहपात्रेषु पुत्रकः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003137083, "chapter_id": 23137, "verse_number": "४-७३-८४", "content_sanskrit": "अहं व्याधिश्च शत्रूणां ज्वरो व्याधिष्वहं तथा ।\nमद्भक्तिष्वपि मद्दास्यं वरेषु च वरः स्मृतः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003137084, "chapter_id": 23137, "verse_number": "४-७३-८५", "content_sanskrit": "आश्रमाणां गृहस्थोऽहं संन्यासी च विवेकिनाम् ।\nसुदर्शनं च शस्त्राणां कुशलं च शुभाशिषाम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003137085, "chapter_id": 23137, "verse_number": "४-७३-८६", "content_sanskrit": "एश्वर्याणां महाज्ञानं वैराग्यं च सुखेष्वहम् ।\nमि (इ) ष्टवाक्यं प्रीतिदेषु दानेषु चाऽऽत्मदानकम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003137086, "chapter_id": 23137, "verse_number": "४-७३-८७", "content_sanskrit": "संचयेषु धर्मकर्म कर्मणां च मदर्चनम् ।\nकठोरेषु तपश्चाहं फलेषु मोक्ष एव च ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003137087, "chapter_id": 23137, "verse_number": "४-७३-८८", "content_sanskrit": "अष्टसिद्धिषु प्राकाम्यमहं काशीपुरीषु च ।\nनगरेषु तथा काञ्ची स देशो यत्र वैष्णवः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003137088, "chapter_id": 23137, "verse_number": "४-७३-८९", "content_sanskrit": "सर्वाधारेषु स्थूलेषु अहमेव महान्विराट् ।\nपरमाणुरहं विश्वे महासूक्ष्मेषु नित्यशः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003137089, "chapter_id": 23137, "verse_number": "४-७३-९०", "content_sanskrit": "वैद्यानामश्विनीपुत्रौ जौषधीषु रसायनम् ।\nधन्वन्तरीर्मन्त्रविदां विषादः क्षयकारिणाम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003137090, "chapter_id": 23137, "verse_number": "४-७३-९१", "content_sanskrit": "रागाणां मेघमल्लारः कामोदस्तत्प्रियासु च ।\nमत्पार्षदेषु श्रीदामा मद्वन्वुष्वहमुद्धवः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003137091, "chapter_id": 23137, "verse_number": "४-७३-९२", "content_sanskrit": "पशुजन्तुषु गौश्चहं चन्दनं काननेषु च ।\nतीर्थपूतश्च पूतेषु निःशङ्केषु च वैष्णवः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003137092, "chapter_id": 23137, "verse_number": "४-७३-९३", "content_sanskrit": "न वैष्णवात्परः प्राणी मन्मन्त्रोपासकश्च यः ।\nवृक्षेष्वङ्कुररूपोऽहमाकारः सर्ववस्तुषु ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003137093, "chapter_id": 23137, "verse_number": "४-७३-९४", "content_sanskrit": "अहं च सर्वभूतेषु मयि सर्वे च संततम् ।\nयथा वृक्षे फलान्येव फलेषु चाङ्कुरस्तरोः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003137094, "chapter_id": 23137, "verse_number": "४-७३-९५", "content_sanskrit": "सर्वकारणरूपोऽहं न च मत्कारणं परम् ।\nसर्वेशीऽहं न मेऽपीशो ह्यहं कारणकारणम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003137095, "chapter_id": 23137, "verse_number": "४-७३-९६", "content_sanskrit": "सर्वेषां सर्वबीजानां प्रवदन्ति मनीषिणः ।\nमन्मायामोहितजना मां न जानन्ति पापिनः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003137096, "chapter_id": 23137, "verse_number": "४-७३-९७", "content_sanskrit": "पापग्रस्तेन दुर्बुद्ध्या विधिना वञ्चितेन च ।\nस्वात्माऽहं सर्वजन्तूनां स्वाम्यहं नादृतः स्वयम् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003137097, "chapter_id": 23137, "verse_number": "४-७३-९८", "content_sanskrit": "यत्राहं शक्तयस्तत्र क्षुत्पिपासादयस्तथा ।\nगते मयि तथा यान्ति नरदेहे (वे) यथाऽनुगाः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003137098, "chapter_id": 23137, "verse_number": "४-७३-९९", "content_sanskrit": "हे व्रजेश नन्द तात ज्ञानं ज्ञात्वा व्रजं व्रज ।\nकथयस्व च तां राधां यशोदां ज्ञानमेव च ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003137099, "chapter_id": 23137, "verse_number": "४-७३-१००", "content_sanskrit": "ज्ञात्वा ज्ञानं व्रजेशश्च जगाम स्वानुगैः सह ।\nगत्वा च कथयामास ते द्वे च योषितां वरे ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003137100, "chapter_id": 23137, "verse_number": "४-७३-१०१", "content_sanskrit": "ते च सर्वे जहः शोकं महाज्ञानेन नारद ।\nकृष्णो यद्यपि निर्लिप्तो मायेशो मायया रतः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003137101, "chapter_id": 23137, "verse_number": "४-७३-१०२", "content_sanskrit": "यशोदया प्रेरितश्च पुनरागत्य माधवम् ।\nतुष्टाव परमानन्दं नन्दश्च नन्दनन्दनम् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003137102, "chapter_id": 23137, "verse_number": "४-७३-१०३", "content_sanskrit": "सामवेदोक्तस्तोत्रेण कृतेन ब्रह्मणा पुरा ।\nपुत्रस्य पुरतः स्थित्वा रुरोद च पुनः पुनः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}]