[
  {
    "id": 20010421,
    "chapter_id": 6674,
    "verse_number": "2.1",
    "content_sanskrit": "अजुगुप्सत पापेभ्यो नाघेऽल्पेप्यतितिक्षत । सोऽचिकित्सदघव्याधीन् प्रजानां दण्डनौषधैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20010422,
    "chapter_id": 6674,
    "verse_number": "2.2",
    "content_sanskrit": "यामेन्तिमे त्रियामाया जाग्रत्पल्यङ्कमास्थितः । अमीमांसत कार्याणि धीमान् बीभत्सुपूर्वजः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20010423,
    "chapter_id": 6674,
    "verse_number": "2.3",
    "content_sanskrit": "तुष्टूषवोथ तं काले सुस्वरास्सूतमागधाः सोमवंशं जगुस्तस्य सोमांशुविशदं यशः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20010424,
    "chapter_id": 6674,
    "verse_number": "2.4",
    "content_sanskrit": "सुयौवतोढान् प्रेमार्द्रांस्तार्तीयीकानिव स्तनान् । स्वर्णोदकुंभानंभस्यन्नथापश्यन्नराधिपः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20010425,
    "chapter_id": 6674,
    "verse_number": "2.5",
    "content_sanskrit": "सुवासाश्शुभ्रदन्स्नातः क्षिप्त्वापः प्राङ्मुखस्थितः । सावित्रीमोदयाद्धानोर्धर्मकाम्यञ्जजाप सः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20010426,
    "chapter_id": 6674,
    "verse_number": "2.6",
    "content_sanskrit": "उपलीयन् सुवर्णानि तृणीयन् धनसञ्चयम् । प्रगेतनं ददौ दानं वल्लभीयंश्च सोर्थिनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20010427,
    "chapter_id": 6674,
    "verse_number": "2.7",
    "content_sanskrit": "निर्वर्तिताग्निकार्यादिश्शुभवेषविभूषणः । अलकीयन् हरिप्रस्थे राजराजो जहौ धनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20010428,
    "chapter_id": 6674,
    "verse_number": "2.8",
    "content_sanskrit": "बाळातपायमानेन रत्नाभरणरोचिषा । शतपत्रायमानानि सुहृद्वक्त्राणि हर्षयन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20010429,
    "chapter_id": 6674,
    "verse_number": "2.9",
    "content_sanskrit": "स सिंहासनमारूढः पूर्वाद्रिशिखरायितम् । वन्द्यमानो जनैः प्रातस्सहस्रकरायत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20010430,
    "chapter_id": 6674,
    "verse_number": "2.10",
    "content_sanskrit": "पयस्यमानया वाचा पयायितमृदुस्मितः । जनमोजायमानोपि धर्मराजोऽसभाजयत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20010431,
    "chapter_id": 6674,
    "verse_number": "2.11",
    "content_sanskrit": "स्त्रियोप्सरायमाणास्तं संक्रन्दनसमद्युतिम् । प्रतिभूषितनिःशेषभूषणाङ्ग्यस्सिषेविरे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20010432,
    "chapter_id": 6674,
    "verse_number": "2.12",
    "content_sanskrit": "भृशायमानाञ्जनतां नुदद्भिर्वेत्रिभिर्वृतः । अन्तर्गृहादथास्थानं प्रातिष्ठत युधिष्ठिरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20010433,
    "chapter_id": 6674,
    "verse_number": "2.13",
    "content_sanskrit": "तमुन्मनायिता भूपाः प्रपद्य चपलायिताः । शीघ्रायितैस्समं भृत्यैरास्थान्यामुपतस्थिरे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20010434,
    "chapter_id": 6674,
    "verse_number": "2.14",
    "content_sanskrit": "चलत्सु जनमेघेषु जनो दुरमनायत । पार्थिवेन्दुमपश्यंस्तं पश्यंस्तु स्वमनायत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20010435,
    "chapter_id": 6674,
    "verse_number": "2.15",
    "content_sanskrit": "नृपोपायनरत्नौघमरीचिनिचयैः क्वचित् । अनीलायत चास्थानं क्वचिच्चालोहितायत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20010436,
    "chapter_id": 6674,
    "verse_number": "2.16",
    "content_sanskrit": "नृपाः खळखळायद्भी रत्नोर्म्या रत्नमौलिभिः । प्रणेमुश्चरणाम्भोजे चक्राङ्के चक्रवर्तिनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20010437,
    "chapter_id": 6674,
    "verse_number": "2.17",
    "content_sanskrit": "राज्ञा कृपायमाणेन सुमुखेनावलोकिताः । कृतसस्मितसल्लापमहर्षायन्त भूभुजः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20010438,
    "chapter_id": 6674,
    "verse_number": "2.18",
    "content_sanskrit": "कष्टायमानानालोच्य पटुमिश्रारलोचनैः । समानाय्य यथाशास्त्रं दण्डयामास पार्थिवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20010439,
    "chapter_id": 6674,
    "verse_number": "2.19",
    "content_sanskrit": "तं रोमन्थायमानैणरम्यादाश्रममण्डलात् । उपजग्मुस्तपस्यन्तो मुनयोऽन्वहमीक्षितुम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20010440,
    "chapter_id": 6674,
    "verse_number": "2.20",
    "content_sanskrit": "बाष्पायमाणस्तान् दृष्ट्वा यथाविधिकृतार्चनः । आसीनौरासने नम्रस्स्माह तैरासितो नृपः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20010441,
    "chapter_id": 6674,
    "verse_number": "2.21",
    "content_sanskrit": "कच्चिदाचम्य वश्शुद्धं दुग्धं दध्यादि वा हविः । ऊष्मायन्तोग्निहोत्राणि सायंप्नातस्तपोधनाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20010442,
    "chapter_id": 6674,
    "verse_number": "2.22",
    "content_sanskrit": "कच्चिद्वेदानधीयानाश्शब्दायध्वे दिवानिशम् । वैरायन्ते न वः कच्चिदाश्रमे दारुणा मृगाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20010443,
    "chapter_id": 6674,
    "verse_number": "2.23",
    "content_sanskrit": "सह कच्चन युष्माभिः कच्चिन्न कलहायते । मेघायते मखै'स्तुष्टः कच्चिद्वो हरिवाहनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20010444,
    "chapter_id": 6674,
    "verse_number": "2.24",
    "content_sanskrit": "युष्माकं हि हविर्नीतमग्निना किं सुरानपि । अभ्रायतेऽभ्रमुक्ताभिर्जनोथाद्भिस्सुखायते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20010445,
    "chapter_id": 6674,
    "verse_number": "2.25",
    "content_sanskrit": "यत्र यूयं कृपायध्वे जातु कृच्छ्रायते न सः । सुखायते च ते नित्यं दासानां नः प्रसीदत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20010446,
    "chapter_id": 6674,
    "verse_number": "2.26",
    "content_sanskrit": "युष्मान् युष्मत्प्रसादेन भगवन्तस्तपोधनाः । दिने दिने नमस्येयं वरिवस्येयमप्यहम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20010447,
    "chapter_id": 6674,
    "verse_number": "2.27",
    "content_sanskrit": "इति भक्तिमतीं वाचं तस्य श्रुत्वा महर्षयः । चित्रीयमाणाः प्रत्यूचुः प्रसादस्निग्धदृष्टयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20010448,
    "chapter_id": 6674,
    "verse_number": "2.28",
    "content_sanskrit": "परिपुच्छ्यमानेन सहवत्सेन गौरियम् । तृणान्यत्तु नृपोत्सृष्टा सुतुष्टाः पूजया वयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20010449,
    "chapter_id": 6674,
    "verse_number": "2.29",
    "content_sanskrit": "दस्युध्वान्तार्कमाश्रित्य त्वां सश्रीवरयामहे । मुण्डयित्वा शिरः क्षीरं व्रतयन्तो यजामहे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20010450,
    "chapter_id": 6674,
    "verse_number": "2.30",
    "content_sanskrit": "इङ्गुदीफलतैलेन पिष्टमामलकीफलम् । मिश्रयित्वा वयं तेन श्लक्ष्णयामो जटाभरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20010451,
    "chapter_id": 6674,
    "verse_number": "2.31",
    "content_sanskrit": "जाज्वल्यमाना हर्षेण हसन्त इव हेतिभिः । लेलिह्यन्तेऽग्नयोस्माकमाज्यसिक्तं जुहूमुखम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20010452,
    "chapter_id": 6674,
    "verse_number": "2.32",
    "content_sanskrit": "श्राद्धा गुरुतरायासजनितब्रह्मबिन्दवः । पापठ्यन्ते त्रयीं विद्यामास्माका ब्रह्मचारिणः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20010453,
    "chapter_id": 6674,
    "verse_number": "2.33",
    "content_sanskrit": "चङ्क्रम्यमाणा निद्रार्थं वटवोऽधीयते निशाः । हेयदर्भसमित्प्रायैर्ज्वलयन्तोऽग्निमिन्धनैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20010454,
    "chapter_id": 6674,
    "verse_number": "2.34",
    "content_sanskrit": "फलेग्रहीणां वृक्षाणां फलान्यारुह्य तस्कराः । चञ्चूर्यमाणास्तद्भीत्या लोलुप्यन्ते न जातु नः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20010455,
    "chapter_id": 6674,
    "verse_number": "2.35",
    "content_sanskrit": "जञ्जप्यते न दंभेन कश्चिद्भारत भारते । दन्दह्यते वा समिधा भुजस्तंभभयेन ते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20010456,
    "chapter_id": 6674,
    "verse_number": "2.36",
    "content_sanskrit": "तपोवनसदेशेषु सासद्यन्ते न नैर्ऋताः । व्याघ्रादयश्च त्वद्नाम्ना जेगील्यन्ते न तापसान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20010457,
    "chapter_id": 6674,
    "verse_number": "2.37",
    "content_sanskrit": "जञ्जभ्यमाना नासाद्य दन्दश्यन्ते कदाचन । शामितास्ते शरैर्वीर मुनीनहिवृकादयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20010458,
    "chapter_id": 6674,
    "verse_number": "2.38",
    "content_sanskrit": "पूर्यते वाक्प्रपञ्चेन राजन्वत्यां त्वया भुवि । चिन्तयत्यपि कः पापं को न धर्माय कल्पते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
