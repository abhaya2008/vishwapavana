[{"id": 40021655, "chapter_id": 9362, "verse_number": "1", "content_sanskrit": "तत्रोपविष्टं राजानमुपासन्ते विचक्षणाः । कथानां बहुरूपाणां हास्यकाराः समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40021656, "chapter_id": 9362, "verse_number": "2", "content_sanskrit": "विजयो मधुमत्तश्च काश्यपो मङ्गलः कुटः । सुराजः कालियो भद्रो दन्तवक्रः सुमागधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40021657, "chapter_id": 9362, "verse_number": "3", "content_sanskrit": "एते कथा बहुविधाः परिहाससमन्विताः । कथयन्ति स्म संहृष्टा राघवस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40021658, "chapter_id": 9362, "verse_number": "4", "content_sanskrit": "ततः कथायां कस्याञ्चिद्राघवः समभाषत । काः कथा नगरे भद्र वर्तन्ते विषयेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40021659, "chapter_id": 9362, "verse_number": "5", "content_sanskrit": "मामाश्रितानि कान्याहुः पौरजानपदा जनाः । किं च सीतां समाश्रित्य भरतं किं च लक्ष्मणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40021660, "chapter_id": 9362, "verse_number": "6", "content_sanskrit": "किं नु शत्रुघ्नमुद्दिश्य कैकयीं किं नु मातरम् । वक्तव्यतां च राजानो वरे राज्ये व्रजन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40021661, "chapter_id": 9362, "verse_number": "7", "content_sanskrit": "एवमुक्ते तु रामेण भद्रः प्राञ्जलिरब्रवीत् । स्थिताः कथा शुभाः राजन्वर्तन्ते पुरवासिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40021662, "chapter_id": 9362, "verse_number": "8", "content_sanskrit": "अमुं तु विजयं सौम्य दशग्रीववधार्जितम् । भूयिष्ठं स्वपुरे पौरैः कथ्यन्ते पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40021663, "chapter_id": 9362, "verse_number": "9", "content_sanskrit": "एवमुक्तस्तु भद्रेण राघवो वाक्यमब्रवीत् । कथयस्व यथातत्त्वं सर्वं निरवशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40021664, "chapter_id": 9362, "verse_number": "10", "content_sanskrit": "शुभाशुभानि वाक्यानि यान्याहुः पुरवासिनः । श्रुत्वेदानीं शुभं कुर्यां नकुर्यामशुभानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40021665, "chapter_id": 9362, "verse_number": "11", "content_sanskrit": "कथयस्व च विस्रब्धो निर्भयं विगतज्वरः । कथयन्ति यथा पौराः पापा जनपदेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40021666, "chapter_id": 9362, "verse_number": "12", "content_sanskrit": "राघवेणैवमुक्तस्तु भद्रः सुरुचिरं वचः । प्रत्युवाच महाबाहुं प्राञ्जलिः सुसमाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40021667, "chapter_id": 9362, "verse_number": "13", "content_sanskrit": "शृणु राजन्यथा पौराः कथयन्ति शुभाशुभम् । चत्वरापणरथ्यासु वनेषूपवनेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40021668, "chapter_id": 9362, "verse_number": "14", "content_sanskrit": "दुष्करं कृतवान्रामः समुद्रे सेतुबन्धनम् । अश्रुतं पूर्वकैः कैश्चिद्देवैरपि सदानवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40021669, "chapter_id": 9362, "verse_number": "15", "content_sanskrit": "रावणश्च दुराधर्षो हतः सबलवाहनः । वानराश्च वशं नीता ऋक्षाश्च सह राक्षसैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40021670, "chapter_id": 9362, "verse_number": "16", "content_sanskrit": "हत्वा च रावणं सङ्ख्ये सीतामाहृत्य राघवः । अमर्षं पृष्ठतः कृत्वा स्ववेश्म पुनरानयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40021671, "chapter_id": 9362, "verse_number": "17", "content_sanskrit": "कीदृशं हृदये तस्य सीतासम्भोगजं सुखम् । अङ्कमारोप्य तु पुरा रावणेन बलाद्धृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40021672, "chapter_id": 9362, "verse_number": "18", "content_sanskrit": "लङ्कामपि पुरा नीतामशोकवनिकां गताम् । रक्षसां वशमापन्नां कथं रामो न कुत्सते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40021673, "chapter_id": 9362, "verse_number": "19", "content_sanskrit": "अस्माकमपि दारेषु सहनीयं भविष्यति । यथा हि कुरुते राजा प्रजा तमनुवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40021674, "chapter_id": 9362, "verse_number": "20", "content_sanskrit": "एवं बहुविधा वाचो वदन्ति पुरवासिनः । नगरेषु च सर्वेषु राजञ्जनपदेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40021675, "chapter_id": 9362, "verse_number": "21", "content_sanskrit": "तस्यैवं भाषितं श्रुत्वा राघवः परमार्तवत् । उवाच सुहृदः सर्वान्कथमेतद्ब्रवीथ माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40021676, "chapter_id": 9362, "verse_number": "22", "content_sanskrit": "सर्वे तु शिरसा भूमावभिवाद्य प्रणम्य च । प्रत्यूचू राघवं दीनमेवमेतन्न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40021677, "chapter_id": 9362, "verse_number": "23", "content_sanskrit": "श्रुत्वा तु वाक्यं काकुत्स्थः सर्वेषां समुदीरितम् । विसर्जयामास तदा वयस्याञ्छत्रुसूदनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]