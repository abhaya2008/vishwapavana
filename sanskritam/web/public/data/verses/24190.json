[{"id": 7004190000, "chapter_id": 24190, "verse_number": "५-१-३९-१", "content_sanskrit": "व्यास उवाच ।\nभगवन्क्षेत्रमाहात्म्यं कथितं च यथातथम् ।\nतीर्थानामुत्तमं तीर्थं पुण्यानां पुण्यवर्धनम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004190001, "chapter_id": 24190, "verse_number": "५-१-३९-२", "content_sanskrit": "कति संत्यत्र तीर्थानि लिंगानि च तथा कति ।\nकथयस्व प्रसादेन पृच्छतो मम सांप्रतम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004190002, "chapter_id": 24190, "verse_number": "५-१-३९-३", "content_sanskrit": "सनत्कुमार उवाच ।\nषष्टिकोटिसहस्राणि षष्टिकोटिशतानि च ।\nमहाकालवने व्यास लिंगसंख्या न विद्यते॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004190003, "chapter_id": 24190, "verse_number": "५-१-३९-४", "content_sanskrit": "अकामो वा सकामो वा जायते योऽत्र मानवः ।\nमहाकालवने रम्ये शिवलोके महीयते॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004190004, "chapter_id": 24190, "verse_number": "५-१-३९-५", "content_sanskrit": "कृतकामानि तीर्थानि प्रासादायतनानि च ।\nतेषु स्नात्वा शुचिर्भूत्वा शिवलोके महीयते॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004190005, "chapter_id": 24190, "verse_number": "५-१-३९-६", "content_sanskrit": "पुण्यानि सर्वतीर्थानि सिद्धिक्षेत्राणि सर्वतः ।\nतेषां मुख्यतमं विद्धि क्षेत्रं तीर्थं तथोत्तमम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004190006, "chapter_id": 24190, "verse_number": "५-१-३९-७", "content_sanskrit": "यः शृणोति महाभक्त्या स याति परमां गतिम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}]