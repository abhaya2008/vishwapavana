[{"id": 2025100, "chapter_id": 1538, "verse_number": "३-१७६-०x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2025101, "chapter_id": 1538, "verse_number": "३-१७६-१", "content_sanskrit": "ततो मामिविश्वस्तं संरूढशरविक्षतम्।\nदेवराजोऽनुगृह्येदं काले वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2025102, "chapter_id": 1538, "verse_number": "३-१७६-२", "content_sanskrit": "दिव्यान्यस्त्राणि सर्वाणि त्वयि तिष्ठन्ति भारत।\nन त्वाऽभिभवितुं शक्तो मानुषो भुवि कश्चन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2025103, "chapter_id": 1538, "verse_number": "३-१७६-३", "content_sanskrit": "भीष्मो द्रोणः कृपः कर्णः शकुनिः सह राजभिः।\nसंग्रामस्थस्य ते पुत्र कलां नार्हन्ति षोडशीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2025104, "chapter_id": 1538, "verse_number": "३-१७६-४", "content_sanskrit": "इदं च मे तनुत्राणं प्रायच्छन्मघवान्प्रभुः।\nअभेद्यं कवचं दिव्यं स्रजं चैव हिरण्मयीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2025105, "chapter_id": 1538, "verse_number": "३-१७६-५", "content_sanskrit": "देवदत्तं च मे शङ्खं देवः प्रादान्महारवम्।\nदिव्यं चेदं किरीटं मे स्वयमिन्द्रो युयोज ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2025106, "chapter_id": 1538, "verse_number": "३-१७६-६", "content_sanskrit": "ततो दिव्यानि वस्त्राणि दिव्यान्याभरणानि च।\nप्रादाच्छक्रो ममैतानि रुचिराणि बृहन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2025107, "chapter_id": 1538, "verse_number": "३-१७६-७", "content_sanskrit": "एवं संपूजितस्तत्रसुखमस्म्युषितो नृप।\nइन्द्रस् भवने पुण्ये गन्धर्वशिशुभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2025108, "chapter_id": 1538, "verse_number": "३-१७६-८", "content_sanskrit": "ततो मामब्रवीच्छक्रः प्रीतिमानमरैः सह।\nसमयोऽर्जुन गन्तुं ते भ्रातरो हि स्मरन्ति ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2025109, "chapter_id": 1538, "verse_number": "३-१७६-९", "content_sanskrit": "एवमिन्द्रस्य भवने पञ्चवर्षाणि भारत।\nउषितानि मया राजन्स्मरता द्यूतजं कलिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2025110, "chapter_id": 1538, "verse_number": "३-१७६-१०", "content_sanskrit": "ततो भवन्तमद्राक्षं भ्रातृभिः परिवारितम्।\nगन्धमादनमासाद्य पर्वतस्यास्य मूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2025111, "chapter_id": 1538, "verse_number": "३-१७६-११x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2025112, "chapter_id": 1538, "verse_number": "३-१७६-११", "content_sanskrit": "दिष्ट्या धनंजयास्त्राणि त्वया प्राप्तानि भारत।\nदिष्ट्या चाराधितो राजा देवानामीश्वरः प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2025113, "chapter_id": 1538, "verse_number": "३-१७६-१२", "content_sanskrit": "दिष्ट्या च भगवन्स्थाणुर्देव्या सह परंतपः।\nसाक्षाद्दृष्टः स्वयुद्धेन तोषितश् त्वयाऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2025114, "chapter_id": 1538, "verse_number": "३-१७६-१३", "content_sanskrit": "दिष्ट्या च लोकपालैस्त्वं समेतो भरतर्षभ।\nदिष्ट्या वर्धामहे पार्थ दिष्ट्याऽसि पुनरागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2025115, "chapter_id": 1538, "verse_number": "३-१७६-१४", "content_sanskrit": "अद्य कृत्स्नामिमां देवीं विजितां पुरमालिनीम्।\n`पश्यामि भूमिं कौन्तेय त्वया मे प्रतिपादिताम्।\nमन्ये च धृतराष्ट्रस्य पुत्रानपि वशीकृतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2025116, "chapter_id": 1538, "verse_number": "३-१७६-१५", "content_sanskrit": "इच्छामि तानि चास्त्राणि द्रष्टुं दिव्यानि भारत।\nयैस्तथा वीर्यवन्तस्ते निवातकवचा हताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2025117, "chapter_id": 1538, "verse_number": "३-१७६-१६x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2025118, "chapter_id": 1538, "verse_number": "३-१७६-१६", "content_sanskrit": "सः प्रभाते भवान्द्रष्टा दिव्यान्यस्त्राणि सर्वशः।\nनिवातकवचा घोरा यैर्मया विनिपातिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2025119, "chapter_id": 1538, "verse_number": "३-१७६-१७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2025120, "chapter_id": 1538, "verse_number": "३-१७६-१७", "content_sanskrit": "एवमागमनं तत्र कथयित्वा धनंजयः।\nभ्रातृभिः सहितः सर्वै रजनीं तामुवास ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2025121, "chapter_id": 1538, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि निवातकवचयुद्धपर्वणि षट्सप्तत्यधिकशततमोऽध्यायः ॥ १७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]