[{"id": 2053901, "chapter_id": 2186, "verse_number": "७-११३-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2053902, "chapter_id": 2186, "verse_number": "७-११३-१", "content_sanskrit": "प्रयाते तव सैन्यं तु युयुधाने युयुत्सया।\nधर्मराजो महाराज स्वेनानीकेन संवृतः।\nप्रायाद्द्रोणरथं प्रेप्सुर्युयुधानस्य पृष्ठतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2053903, "chapter_id": 2186, "verse_number": "७-११३-२", "content_sanskrit": "ततः पाञ्चालराजस्य पुत्रः समरदुर्मदः।\n`प्रयाते माधवे राजन्निदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2053904, "chapter_id": 2186, "verse_number": "७-११३-३", "content_sanskrit": "प्राक्रोशत्पाण्डवानीके वसुदानश्च पार्थिवः।\nआगच्छत प्रहरत द्रुतं विपरिधावत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2053905, "chapter_id": 2186, "verse_number": "७-११३-४", "content_sanskrit": "यथा सुखेन गच्छेत सात्यकिर्युद्धदुर्मदः।\nमहारथा हि बहवो यतिष्यन्तेऽस्य निर्जये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2053906, "chapter_id": 2186, "verse_number": "७-११३-५x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2053907, "chapter_id": 2186, "verse_number": "७-११३-५", "content_sanskrit": "`सेनापतिवचः श्रुत्वा पाण्डवेयाः समन्ततः।\nअभ्युद्ययुर्महाराज तव सैन्यं समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2053908, "chapter_id": 2186, "verse_number": "७-११३-६", "content_sanskrit": "जहि प्रहर गृह्णीहि विध्य विद्रव चाद्रव।\nइति ब्रुवन्तौ वेगेन निपेतुस्ते महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2053909, "chapter_id": 2186, "verse_number": "७-११३-७", "content_sanskrit": "वयं प्रतिजिगीषन्तस्तत्र तान्समभिद्रुताः।\n`बाणशङ्खरवान्कृत्वा विमिश्रान्वाद्यनिस्वनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2053910, "chapter_id": 2186, "verse_number": "७-११३-८", "content_sanskrit": "युयुधानरथं दृष्ट्वा तावका अभिदुद्रुवुः।\nततः शब्दो महानासीद्युयुधानरथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2053911, "chapter_id": 2186, "verse_number": "७-११३-९", "content_sanskrit": "आकीर्यमाणा धावन्ती तव पुत्रस्य वाहिनी।\nसात्वतेन महाराज शतधाऽभिव्यशीर्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2053912, "chapter_id": 2186, "verse_number": "७-११३-१०", "content_sanskrit": "तस्यां विदीर्यमाणायां शिनेः पुत्रो महारथः।\nसप्तवीरान्महेष्वासानग्रानीकेष्वपोथयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2053913, "chapter_id": 2186, "verse_number": "७-११३-११", "content_sanskrit": "अथान्यानपि राजेन्द्र नानाजनपदेश्वरान्।\nशरैरनलसङ्काशैर्निन्ये वीरान्यमक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2053914, "chapter_id": 2186, "verse_number": "७-११३-१२", "content_sanskrit": "शतमेकेन विव्याध शतेनैकं च पत्रिणाम्।\nद्विपारोहान्द्विपांश्चैव हयारोहान्हयांस्तथा।\nरथिनः साश्वसूतांश्च जघानेशः पशूनिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2053915, "chapter_id": 2186, "verse_number": "७-११३-१३", "content_sanskrit": "तं तथाऽद्भुतकर्माणं शरसम्पातवर्षिणम्।\nन केचनाभ्यधावन्वै सात्यकिं तव सैनिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2053916, "chapter_id": 2186, "verse_number": "७-११३-१४", "content_sanskrit": "ते भीता मृद्यमानाश्च प्रमृष्टा दीर्घबाहुना।\nआयोधनं जहुर्वीरा दृष्टा तमतिमानिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2053917, "chapter_id": 2186, "verse_number": "७-११३-१५", "content_sanskrit": "तमेकं बहुधा पश्यन्मोहितास्तस्य तेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2053918, "chapter_id": 2186, "verse_number": "७-११३-१६", "content_sanskrit": "रथैर्विमथितैश्चैव भग्ननीडैश्च मारिष।\nचक्रैर्विमथितैश्छत्रैर्ध्वजैश्च विनिपातितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2053919, "chapter_id": 2186, "verse_number": "७-११३-१७", "content_sanskrit": "अनुकर्षैः पताकाभिः शिरस्त्राणैः सकाञ्चनैः।\nबाहुभिश्चन्दनादिग्धैः साङ्गदैश्च विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2053920, "chapter_id": 2186, "verse_number": "७-११३-१८", "content_sanskrit": "हस्तिहस्तोपमैश्चापि भुजङ्गाभोगसन्निभैः।\nऊरुभिः पृथिवी च्छन्ना मनुजानां नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2053921, "chapter_id": 2186, "verse_number": "७-११३-१९", "content_sanskrit": "शशाङ्कुसन्निभैश्चैव वदनैश्चारुकुण्डलैः।\nपतितैर्ऋषभाक्षाणां बभौ भारत मेदिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2053922, "chapter_id": 2186, "verse_number": "७-११३-२०", "content_sanskrit": "गजैश्च बहुधा छिन्नैः शयानैः पर्वतोपमैः।\nरराजातिभृशं भूमिर्विकीर्णैरिव पर्वतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2053923, "chapter_id": 2186, "verse_number": "७-११३-२१", "content_sanskrit": "तपनीयमयैर्योक्त्रैर्मुक्ताजालविभूषितैः।\nउरश्छदैर्विचित्रैश्च व्यशोभन्त तुरङ्गमाः।\nगतसत्वा महीं प्राप्य प्रमृष्टा दीर्घबाहुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2053924, "chapter_id": 2186, "verse_number": "७-११३-२२", "content_sanskrit": "नानाविधानि सैन्यानि तव हत्वा तु सात्वतः।\nप्रविष्टस्तावकं सैन्यं द्रावयित्वा चमूं भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2053925, "chapter_id": 2186, "verse_number": "७-११३-२३", "content_sanskrit": "ततस्तेनैव मार्गेण येन यातो धनञ्जयः।\nइयेष सात्यकिर्गन्तुं ततो द्रोणेन वारितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2053926, "chapter_id": 2186, "verse_number": "७-११३-२४", "content_sanskrit": "भारद्वाजं समासाद्य युयुधानश्च सात्यकिः।\nन न्यवर्तत सङ्क्रुद्धो वेलामिव जलाशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2053927, "chapter_id": 2186, "verse_number": "७-११३-२५", "content_sanskrit": "निवार्य तु रणे द्रोणो युयुधानं महारथम्।\nविव्याध निशितैर्बाणैः पञ्चभिर्मर्मभेदिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2053928, "chapter_id": 2186, "verse_number": "७-११३-२६", "content_sanskrit": "सात्यकिस्तु रणे द्रोणं राजन्विव्याध सप्तभिः।\nहेमपुङ्घैः शिलाधौतैः कङ्कबर्हिणवाजितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2053929, "chapter_id": 2186, "verse_number": "७-११३-२७", "content_sanskrit": "षं षड्भिः सायकैर्द्रोणः साश्वयन्तारमार्दयत्।\nस तं न ममृषे द्रोणं युयुधानो महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2053930, "chapter_id": 2186, "verse_number": "७-११३-२८", "content_sanskrit": "सिंहनादं ततः कृत्वा द्रोणं विव्याध सात्यकिः।\nदशभिः सायकैश्चान्यैः षड्भिरष्टाभिरेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2053931, "chapter_id": 2186, "verse_number": "७-११३-२९", "content_sanskrit": "युयुधानः पुनर्द्रोणं विव्याध दशभिः शरैः।\nएकेन सारथिं चास्य चतुर्भिश्चतुरो हयान्।\nध्वजमेकेन बाणेन विव्याध युधि मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2053932, "chapter_id": 2186, "verse_number": "७-११३-३०", "content_sanskrit": "तं द्रोणः साश्वयन्तारं सरथध्वजमाशुगैः।\nत्वरन्प्राच्छादयद्बाणैः शलभानामिव व्रजैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2053933, "chapter_id": 2186, "verse_number": "७-११३-३१", "content_sanskrit": "तथैव युयुधानोऽपि द्रोणं बहुभिराशुगैः।\n`प्राच्छादयदसम्भ्रान्तस्त्वरमाणो महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2053934, "chapter_id": 2186, "verse_number": "७-११३-३२", "content_sanskrit": "द्रोणस्तु परमक्रुद्धः सात्यकिं परवीरहा।\nअवाक्रिच्छितैर्बाणैर्वासुदेवपराक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2053935, "chapter_id": 2186, "verse_number": "७-११३-३३", "content_sanskrit": "तं तथा शरजालेन प्रच्छाद्य महता पुनः।\nद्रोणः प्रहस्य शैनेयमिदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2053936, "chapter_id": 2186, "verse_number": "७-११३-३४", "content_sanskrit": "तवाचार्यो रणं हित्वा गतः कापुरुषो यथा।\nयुध्यमानं च मां हित्वा प्रदक्षिणमवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2053937, "chapter_id": 2186, "verse_number": "७-११३-३५", "content_sanskrit": "त्वं हि मे युध्यतो नाद्य जीवन्यास्यसि माधव।\nयदि मां त्वं रणे हित्वा न यास्याचार्यवद्द्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2053938, "chapter_id": 2186, "verse_number": "७-११३-३६x", "content_sanskrit": "सात्यकिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2053939, "chapter_id": 2186, "verse_number": "७-११३-३६", "content_sanskrit": "धनञ्जयस्य पदवीं धर्मराजस्य शासनात्।\nगच्छामि स्वस्ति ते ब्रह्मन्न मे कालात्ययो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2053940, "chapter_id": 2186, "verse_number": "७-११३-३७", "content_sanskrit": "आचार्यानुगतो मार्गः शिष्यैरन्वास्यते सदा।\nतस्मादेव व्रजाम्याशु यथा मे स गुरुर्गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2053941, "chapter_id": 2186, "verse_number": "७-११३-३८x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2053942, "chapter_id": 2186, "verse_number": "७-११३-३८", "content_sanskrit": "एतावदुक्त्वा शैनेय आचार्यं परिवर्जयन्।\nप्रयातः सहसा राजन्सारथिं चेदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2053943, "chapter_id": 2186, "verse_number": "७-११३-३९", "content_sanskrit": "द्रोणः करिष्यते यत्नं सर्वथा मम वारणे।\nयत्तो याहि रणे सूत शृणु चेदं वचः परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2053944, "chapter_id": 2186, "verse_number": "७-११३-४०", "content_sanskrit": "एतदालोक्यते सैन्यमावन्त्यानां महाप्रभम्।\nअस्यानन्तरतस्त्वेतद्दाक्षिणात्यं महद्बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2053945, "chapter_id": 2186, "verse_number": "७-११३-४१", "content_sanskrit": "तदनन्तरमेतच्च बाह्लिकानां महद्बलम्।\nबाह्लिकाभ्याशतो युक्तं कर्णस्य च महद्बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2053946, "chapter_id": 2186, "verse_number": "७-११३-४२", "content_sanskrit": "अन्योन्येन हि सैन्यानि भिन्नान्येतानि सारथे।\nअन्योन्यं समुपाश्रित्य न त्यक्ष्यन्ति रणाजिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2053947, "chapter_id": 2186, "verse_number": "७-११३-४३", "content_sanskrit": "एतदन्तरमासाद्य चोदयाश्वान्प्रहृष्टवत्।\nमध्यमं जवमास्थाय वह मामत्र सारथे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2053948, "chapter_id": 2186, "verse_number": "७-११३-४४", "content_sanskrit": "बाह्लिका यत्र दृश्यन्ते नानाप्रहरणोद्यताः।\nदाक्षिणात्याश्च बहवः सूतपुत्रपुरोगमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2053949, "chapter_id": 2186, "verse_number": "७-११३-४५", "content_sanskrit": "हस्त्यश्वरथसम्बाधं यच्चानीकं विलोक्यते।\nनानादेशसमुत्थैश्च पदातिभिरधिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2053950, "chapter_id": 2186, "verse_number": "७-११३-४६", "content_sanskrit": "`*ततः शक्यो महाव्यूहो भेत्तुं स सहसा रणे।\nतं देशं त्वरिता यामो मृद्ग्रन्तो युधि शात्रवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2053951, "chapter_id": 2186, "verse_number": "७-११३-४७", "content_sanskrit": "तत्रैते सम्प्रहृष्टत्वान्नास्मान्प्रति युयुत्सवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2053952, "chapter_id": 2186, "verse_number": "७-११३-४८", "content_sanskrit": "अयुध्यमानो बहुभिरेकं प्राप्य सुदुर्बलम्।\nबलं प्रमथ्य गच्छामि मिषतां सर्वधन्विनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2053953, "chapter_id": 2186, "verse_number": "७-११३-४९", "content_sanskrit": "मध्यतो याहि यत्रोग्रं कर्णस्य सुमहद्बलम्।\nयत्रैते परमक्रुद्धा दाक्षिणात्या महारथाः।\nएतान्विजित्य सङ्ग्रामे ततो यामो धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2053954, "chapter_id": 2186, "verse_number": "७-११३-५०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2053955, "chapter_id": 2186, "verse_number": "७-११३-५०", "content_sanskrit": "युयुधानवचः श्रुत्वा युयुधानस्य सारथिः।\nयथोक्तमगमद्राजन्वर्जयन्द्रोणमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2053956, "chapter_id": 2186, "verse_number": "७-११३-५१", "content_sanskrit": "तं द्रोणोऽनुययौ क्रुद्धो विकिरन्विशिखान्बहून्।\nयुयुधानं महाभागं गच्छन्तमनिवर्तिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2053957, "chapter_id": 2186, "verse_number": "७-११३-५२", "content_sanskrit": "स च सैन्यं महद्भित्त्वा दाक्षिणात्यबलं च तत्।\nकर्णस्य सैन्यं सुमहदभिहत्य शितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2053958, "chapter_id": 2186, "verse_number": "७-११३-५३", "content_sanskrit": "प्राविशद्भारतीं सेनामपर्यन्तां स सात्यकिः।\nसात्यको हि ततः सैन्यं द्रावयन्स समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2053959, "chapter_id": 2186, "verse_number": "७-११३-५४", "content_sanskrit": "प्रविष्टे युयुधाने तु सैनिकेषु द्रुतेषु च।\nअमर्षी कृतवर्मा तु सात्यकिं पर्यवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2053960, "chapter_id": 2186, "verse_number": "७-११३-५५", "content_sanskrit": "तमापतन्तं विशिखैः षड्भिराहत्य सात्यकिः।\nचतुर्भिश्चतुरोऽस्याश्वानाजघानाशु वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2053961, "chapter_id": 2186, "verse_number": "७-११३-५६", "content_sanskrit": "ततः पुनः षोडशभिर्नतपर्वभिराशुगैः।\nसात्यकिः कृतवर्माणं प्रत्यविध्यत्स्तनान्तरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2053962, "chapter_id": 2186, "verse_number": "७-११३-५७", "content_sanskrit": "स ताड्यमानो विशिखैर्बहुभिस्तिग्मतेजनैः।\nसात्वतेन महाराज कृतवर्मा न चक्षमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2053963, "chapter_id": 2186, "verse_number": "७-११३-५८", "content_sanskrit": "स वत्सन्दतं सन्धाय तिग्मांश्वनलसप्रभम्।\nआकृष्य राजन्नाकर्णाद्विव्याधोरसि सात्यकिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2053964, "chapter_id": 2186, "verse_number": "७-११३-५९", "content_sanskrit": "स तस्य देहावरणं भित्त्वा देहं च सायकः।\nसपुङ्खपत्रः पृथिवीं विवेश रुधिरोक्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2053965, "chapter_id": 2186, "verse_number": "७-११३-६०", "content_sanskrit": "अथास्य बहुभिर्बाणैरच्छिनत्परमास्त्रवित्।\nस मार्गणगणं राजन्कृतवर्मा शरासनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2053966, "chapter_id": 2186, "verse_number": "७-११३-६१", "content_sanskrit": "विव्याध च रणे राजन्सात्यकिं सत्यविक्रमम्।\nदशभिर्विशिखैस्तीक्ष्णैरभिक्रुद्धः स्तनान्तरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2053967, "chapter_id": 2186, "verse_number": "७-११३-६२", "content_sanskrit": "ततः प्रशीर्णे धनुषि शक्त्या शक्तिमतां वरः।\nजघान दक्षिणं बहुं सात्यकिः कृतवर्मणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2053968, "chapter_id": 2186, "verse_number": "७-११३-६३", "content_sanskrit": "ततोऽन्यत्सुदृढं चापं पूर्णमायम्य सात्यकिः।\nव्यसृजद्विशिखांस्तूर्णं शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2053969, "chapter_id": 2186, "verse_number": "७-११३-६४", "content_sanskrit": "सरथं कृतवर्माणं समन्तात्पर्यवारयत्।\nछादयित्वा रणे राजन्हार्दिक्यं स तु सात्यकिः।\nअथास्य भल्लेन शिरः सारथेः समकृन्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2053970, "chapter_id": 2186, "verse_number": "७-११३-६५", "content_sanskrit": "स पपात हतः सूतो हार्दिक्यस्य महारथात्।\nततस्ते यन्तृरहिताः प्राद्रवंस्तुरगा भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2053971, "chapter_id": 2186, "verse_number": "७-११३-६६", "content_sanskrit": "अथ भोजस्तु सम्भ्रान्तो निगृह्य तुरगामन्स्वयम्।\nतस्थौ वीरो धनुष्पाणिस्तत्सैन्यान्यभ्यपूजयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2053972, "chapter_id": 2186, "verse_number": "७-११३-६७", "content_sanskrit": "स मुहूर्तमिवाश्वास्य सदश्वान्समनोदयत्।\nव्यपेत भीरमित्राणामावहत्सुमहद्भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2053973, "chapter_id": 2186, "verse_number": "७-११३-६८", "content_sanskrit": "सात्यकिश्चात्यगात्तस्मात्स तु भीममुपाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2053974, "chapter_id": 2186, "verse_number": "७-११३-६९", "content_sanskrit": "युयुधानोऽपि राजेन्द्र भोजानीकाद्विनिःसृतः।\nप्रययौ त्वरितस्तूर्णं काम्भोजानां महाचमूम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2053975, "chapter_id": 2186, "verse_number": "७-११३-७०", "content_sanskrit": "स तत्र बहुभिः शूरैः सन्निरुद्धो महारथैः।\nन चचाल तदा राजन्सात्यकिः सत्यविक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2053976, "chapter_id": 2186, "verse_number": "७-११३-७१", "content_sanskrit": "सन्धाय च चमूं द्रोणो भोजे भारं निवेश्य च।\nअभ्यधावद्रणे यत्तो युयुधानं युयुत्सया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2053977, "chapter_id": 2186, "verse_number": "७-११३-७२", "content_sanskrit": "तथा तमनुधावन्तं युयुधानस्य पृष्ठतः।\nन्यवारयन्त संहृष्टाः पाण्डुसैन्ये ब्रृहत्तमाः।\nसमासाद्य तु हार्दिक्यं रथानां प्रवरं रथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2053978, "chapter_id": 2186, "verse_number": "७-११३-७३", "content_sanskrit": "पाञ्चाला विगतोत्साहा भीमसेनपुरोगमाः।\nविक्रम्य वारिता राजन्वीरेण कृतवर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2053979, "chapter_id": 2186, "verse_number": "७-११३-७४", "content_sanskrit": "यतमानांश्च तान्सर्वानीषद्विगतचेतसः।\nअभितस्ताञ्शरौघेण क्लान्तवाहानकारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2053980, "chapter_id": 2186, "verse_number": "७-११३-७५", "content_sanskrit": "निगृहीतास्तु भोजेन भोजानीकेप्सवो रणे।\nअतिष्ठन्नार्यवद्वीराः प्रार्थयन्तो महद्यशः।\n`हार्दिक्यं समरे यत्ता न शेकुः प्रतिवीक्षितुम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2053981, "chapter_id": 2186, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि जयद्रथवधपर्वणि चतुर्दशदिवसयुद्धे त्रयोधशाधिकशततमोऽध्यायः॥ २ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-११३-१२ ईशो रुद्रः॥ ५-११३-१९ ऋषोभस्येवाक्षीणि येषाम्॥ ५-११३-३५ त्वंहि त्वमपि॥ ५-११३-४२ भिन्नानि पृथग्भूतानि॥ ५-११३-* एतदादि पञ्चश्लोकानां स्थाने अधो लिखित एकएव श्लोकः झ. पुस्तकेऽस्ति। एतावदुक्त्वा यन्तारं ब्राह्मणं परिवर्जयन्। मध्यतो याहि यच्चोग्रं कर्णस्य च महद्वलम्॥ ५-११३-५८ जिह्मागानिलसन्निभम् इति। झ. पाठः॥ ५-११३-७१ सन्धाय यथास्थानमानीय॥ ५-११३-७५ आर्यवत्कुलीनवत्। कुलीनत्वादितियावत्॥ ५-११३-११३ त्रयोदशाधिकरशथतमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}]