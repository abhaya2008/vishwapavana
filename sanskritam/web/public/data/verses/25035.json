[{"id": 7005035000, "chapter_id": 25035, "verse_number": "७-१-२१८-१", "content_sanskrit": "ईश्वर उवाच ।\nतत्रैव मानवं लिंगं मनुना संप्रतिष्ठितम् ।\nपूर्वं हत्वा सुतं देवि मनुः पापसमन्वितः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005035001, "chapter_id": 25035, "verse_number": "७-१-२१८-२", "content_sanskrit": "क्षेत्रं पापहरं ज्ञात्वा तत्र प्रातिष्ठदीश्वरम् ।\nमुक्तश्चैवाभवत्पापात्तस्मात्पुत्रवधोद्भवात् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005035002, "chapter_id": 25035, "verse_number": "७-१-२१८-३", "content_sanskrit": "पूजयेन्मानवो यस्तु स मुक्तः पातकैर्भवेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005035003, "chapter_id": 25035, "verse_number": "७-१-२१८-४", "content_sanskrit": "इति श्रीस्कान्दे महापुराण एका शीतिसाहस्र्यां संहितायां सप्तमे प्रभासखण्डे प्रथमे प्रभासक्षेत्रमाहात्म्ये मानवेश्वरमाहात्म्यवर्णनंनामाष्टादशोत्तरद्विशततमोऽध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}]