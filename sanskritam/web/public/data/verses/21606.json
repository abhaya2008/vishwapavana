[{"id": 7001606000, "chapter_id": 21606, "verse_number": "२-४२-१", "content_sanskrit": "।।शौनकादिऋषय ऊचुः।\nसूत सूत महाभाग त्वया भगवता सता ।\nव्यासप्रसादाधिगतशास्त्रसम्बोधनेन च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001606001, "chapter_id": 21606, "verse_number": "२-४२-२", "content_sanskrit": "अष्टादशपुराणानि सेतिहासानि चानघ ।\nउपक्रमोपसंहार विधिनोक्तानि कृत्स्नशः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001606002, "chapter_id": 21606, "verse_number": "२-४२-३", "content_sanskrit": "चतुर्दशसहस्रं च मात्स्यं प्रोक्तमतिस्फुटम् ।\nतत्संख्यकं भविष्यञ्च प्रोक्तं पञ्चशताधिकम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001606003, "chapter_id": 21606, "verse_number": "२-४२-४", "content_sanskrit": "मार्कण्डेयं महारम्यं प्रोक्तं नवसहस्रकम् ।\nकथितं ब्रह्मवैवर्त्तमष्टादशसहस्रकम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001606004, "chapter_id": 21606, "verse_number": "२-४२-५", "content_sanskrit": "शतोत्तरञ्च ब्रह्माण्डं सूर्यसंख्यासहस्रकम्  ।\nअथ भागवतं दिव्यमष्टादशसहस्रकम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001606005, "chapter_id": 21606, "verse_number": "२-४२-६", "content_sanskrit": "सहस्राणि दशैवोक्तं पुराणं ब्रह्मनामकम् ।\nअयुतश्लोकघटितं पुराणं वामनाभिधम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001606006, "chapter_id": 21606, "verse_number": "२-४२-७", "content_sanskrit": "तथैवायुत संख्यातं षट्शताधिकमादिकम् ।\nत्रयोविंशतिसाहस्रमनिलं तद्गतं शुभम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001606007, "chapter_id": 21606, "verse_number": "२-४२-८", "content_sanskrit": "त्रयोविंशतिसाहस्रं नारदीयमुदाहृतम्  ।\nएकोनविंशसाहस्रं वैनतेयमुदाहृतम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001606008, "chapter_id": 21606, "verse_number": "२-४२-९", "content_sanskrit": "सहस्रपञ्चपञ्चाशत्प्रोक्तं पाद्मं सुविस्तरम् ।\nसप्तदशसहस्रन्तु कूर्मं प्रोक्तं मनोहरम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001606009, "chapter_id": 21606, "verse_number": "२-४२-१०", "content_sanskrit": "चतुर्विंशति साहस्रं सौकरं परमाद्भुतम् ।\nएकाशीतिसहस्राणि स्कान्दमुक्तं सुविस्तृतम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001606010, "chapter_id": 21606, "verse_number": "२-४२-११", "content_sanskrit": "एवमष्टादशोक्तानि पुराणानि बृहन्ति च ।\nपुराणेष्वेषु बहवो धर्मास्ते विनिरूपिताः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001606011, "chapter_id": 21606, "verse_number": "२-४२-१२", "content_sanskrit": "रागिणाञ्च विरागाणां यतीनां ब्रह्मचारिणाम्।\nगृहस्थानां वनस्थानां स्त्रीशूद्राणां विशेषतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001606012, "chapter_id": 21606, "verse_number": "२-४२-१३", "content_sanskrit": "ब्राह्मणक्षत्रियविशां ये च सङ्करजातयः ।\nगङ्गाद्या या महानद्यो यज्ञव्रततपांसि च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001606013, "chapter_id": 21606, "verse_number": "२-४२-१४", "content_sanskrit": "अनेकविधदानानि यमाश्च नियमैः सह ।\nयोगधर्मा बहुविधाः सांख्या भागवतास्तथा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001606014, "chapter_id": 21606, "verse_number": "२-४२-१५", "content_sanskrit": "भक्तिमार्गा ज्ञानमार्गा वैराग्यानिलनीरजाः ।\nउपासनविधिश्चोक्तः कर्मसंशुद्धिचेतसाम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001606015, "chapter_id": 21606, "verse_number": "२-४२-१६", "content_sanskrit": "ब्राह्मं शैवं वैष्णवं च सौरं शाक्तं तथार्हतम् ।\nषड्दर्शनानि चोक्तानि स्वभावनियतानि च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001606016, "chapter_id": 21606, "verse_number": "२-४२-१७", "content_sanskrit": "एतदन्यच्च विविधं पुराणेषु निरुपितम् ।\nअतः परं किमप्यस्ति न वा बोद्धव्यमुत्तमम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001606017, "chapter_id": 21606, "verse_number": "२-४२-१८", "content_sanskrit": "न ज्ञायेत यदि व्यासो गोपयेदथ वा भवान्  ।\nअत्र नः संशयं छिन्धि पूर्णः पौराणिको यतः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001606018, "chapter_id": 21606, "verse_number": "२-४२-१९", "content_sanskrit": "सूत उवाच।\nश्रृणु शौनक वक्ष्यामि प्रश्रमेनं सुदुर्लभम् ।\nअतिगोप्यतरं दिव्यमनाख्येयं प्रचक्षते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001606019, "chapter_id": 21606, "verse_number": "२-४२-२०", "content_sanskrit": "पराशरसुतो व्यासः कृत्वा पौराणिकीं कथाम् ।\nसर्ववेदार्थघटितां चिन्तयामास चेतसि ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001606020, "chapter_id": 21606, "verse_number": "२-४२-२१", "content_sanskrit": "वर्णाश्रमवतां धर्मो मया सम्यगुदाहृतः ।\nमुक्तिमार्गा बहुविधा उक्ता वेदाविरोधतः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001606021, "chapter_id": 21606, "verse_number": "२-४२-२२", "content_sanskrit": "जीवेश्वरब्रह्मभेदो निरस्तः सूत्रनिर्णये ।\nनिरूपितं परं ब्रह्म श्रुतियुक्तविचारतः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001606022, "chapter_id": 21606, "verse_number": "२-४२-२३", "content_sanskrit": "अक्षरं परमं ब्रह्म परमात्मा परं पदम् ।\nयदर्थं ब्रह्मचर्यादिवानप्रस्थयतिव्रतम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001606023, "chapter_id": 21606, "verse_number": "२-४२-२४", "content_sanskrit": "आचरन्ति महाप्राज्ञा धारणाञ्च पृथग्विधाम् ।\nआसनं प्राणरोधश्च प्रत्याहारश्च धारणा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001606024, "chapter_id": 21606, "verse_number": "२-४२-२५", "content_sanskrit": "ध्यानं समाधिरेतानि यमैश्च नियमैः सह ।\nअष्टाङ्गानि यदर्थञ्च चरन्ति मुनिपुङ्गवाः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001606025, "chapter_id": 21606, "verse_number": "२-४२-२६", "content_sanskrit": "यदर्थं कर्म कुर्वन्ति वेदाज्ञामात्रतत्पराः ।\nपरार्पणधिया सम्यग् निष्कामाः कलिलोज्झिताः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001606026, "chapter_id": 21606, "verse_number": "२-४२-२७", "content_sanskrit": "यज्ज्ञप्तये निराकर्त्तुं पापाचरणमात्मनः ।\nगङ्गादितीर्थचर्याणि निषेवन्ते शुचिव्रताः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001606027, "chapter_id": 21606, "verse_number": "२-४२-२८", "content_sanskrit": "तद्ब्रह्म परमं शुद्धमनाद्यन्तमनामयम् ।\nनित्यं सर्वगतं स्थाणु कूटस्थं कूटविर्जितम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001606028, "chapter_id": 21606, "verse_number": "२-४२-२९", "content_sanskrit": "सर्वेन्द्रियचराभासं प्राकृतेन्द्रियवर्जितम् ।\nदिक्कालाद्यनवच्छिन्नं नित्यं चिन्मात्रमव्ययम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001606029, "chapter_id": 21606, "verse_number": "२-४२-३०", "content_sanskrit": "अध्यास्तं सर्पवद्यत्र विश्वमेतत्प्रकाशते ।\nविश्वस्मिन्नपि चान्वेति निर्विकारश्च रज्जुवत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001606030, "chapter_id": 21606, "verse_number": "२-४२-३१", "content_sanskrit": "सम्यग्विचारितं यद्वत्फेनोर्मिबुद्बुदोदकम् ।\nतथा विचारितं ब्रह्म विश्वस्मान्न पृथग्भवेत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001606031, "chapter_id": 21606, "verse_number": "२-४२-३२", "content_sanskrit": "सर्वं ब्रह्मैव नानात्वं नास्तीति निगमा जगुः ।\nयस्माद्भवन्ति ब्रह्माण्ड कोटयो न भवन्ति च ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001606032, "chapter_id": 21606, "verse_number": "२-४२-३३", "content_sanskrit": "यदुन्मेषनिमेषाभ्यां जगतां प्रलयोदयौ ।\nभवेतां या परा शक्तिर्यदाधारतया स्थिता ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001606033, "chapter_id": 21606, "verse_number": "२-४२-३४", "content_sanskrit": "यस्मिन्निदं यतश्चेदं येनेदं यदिदं स्मृतम् ।\nयदज्ञानाज्जगद्भाति यस्मिन् ज्ञाते जगन्न हि ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001606034, "chapter_id": 21606, "verse_number": "२-४२-३५", "content_sanskrit": "असत्यं यज्जडं दुःखमवस्त्विति निरूपितम् ।\nविपरीतमतो यद्वै सच्चिदानन्दमूर्त्तिकम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001606035, "chapter_id": 21606, "verse_number": "२-४२-३६", "content_sanskrit": "जीवे जाग्रति विश्वाख्यं स्वप्ने यत्तैजसं स्मृतम्  ।\nसुषुप्तौ प्राज्ञसंज्ञं तत्सर्वावस्थासु संस्मृतम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001606036, "chapter_id": 21606, "verse_number": "२-४२-३७", "content_sanskrit": "यच्चक्षुषां चक्षुरथ श्रोत्राणां श्रोत्रमस्ति च ।\nत्वक् त्वचां रसनं तस्य प्राणं प्राणस्य यद्विदुः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001606037, "chapter_id": 21606, "verse_number": "२-४२-३८", "content_sanskrit": "बुद्धिर्ज्ञानेन च प्राणाः क्रियाशक्त्या निरन्तरम् ।\nयन्नेशिरि समभ्येतुं ज्ञातुं च परमार्थतः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001606038, "chapter_id": 21606, "verse_number": "२-४२-३९", "content_sanskrit": "रज्जावहिर्मरौ वारि नीलिमा गगने यथा ।\nअसद्विश्वमिदं भाति यस्मिन्नज्ञानकल्पितम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001606039, "chapter_id": 21606, "verse_number": "२-४२-४०", "content_sanskrit": "घटावच्छिन्न एवायं महाकाशो विभिद्यते ।\nकार्योपाधिपरिच्छिन्नं तद्वद्यज्जीवसंज्ञिकम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001606040, "chapter_id": 21606, "verse_number": "२-४२-४१", "content_sanskrit": "मायया चित्रकारिण्या विचित्रगुणशीलया  ।\nब्रह्माण्डं चित्रमतुलं यस्मिन् भित्ताविवार्पितम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001606041, "chapter_id": 21606, "verse_number": "२-४२-४२", "content_sanskrit": "धावतोऽन्यानतिक्रान्तं वदतो वागगोचरम्  ।\nवेदवेदान्तसिद्धान्तैर्विनिर्णीतं तदक्षरम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001606042, "chapter_id": 21606, "verse_number": "२-४२-४३", "content_sanskrit": "अक्षरान्न परं किञ्चित्सा काष्ठा सा परा गतिः  ।\nइत्येवं श्रूयते वेदे बहुधापि विचारिते ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001606043, "chapter_id": 21606, "verse_number": "२-४२-४४", "content_sanskrit": "अक्षरस्यात्मनश्चापि स्वात्मरूपतया स्थितम् ।\nपरमानन्दसन्दोहरूपमानन्द विग्रहम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001606044, "chapter_id": 21606, "verse_number": "२-४२-४५", "content_sanskrit": "लीलाविलासरसिकं बल्लवीयूथमध्यगम् ।\nशिखिपिच्छकिरीटेन बास्वद्रत्नचितेन च ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001606045, "chapter_id": 21606, "verse_number": "२-४२-४६", "content_sanskrit": "उल्लसद्विद्युदाटोपकुण्डलाभ्यां विराजितम् ।\nकर्णोपान्तचरन्नेत्रखञ्जरीटमनोहरम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001606046, "chapter_id": 21606, "verse_number": "२-४२-४७", "content_sanskrit": "कुञ्जकुञ्जप्रियावृन्दविलासरतिलम्पटम् ।\nपीताम्बरधरं दिव्यं चन्दनालेपमण्डितम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001606047, "chapter_id": 21606, "verse_number": "२-४२-४८", "content_sanskrit": "अधरामृत संसिक्तवेणुनादेन वल्लवीः ।\nमोहयन्तञ्चिदानन्दमनङ्गमदभञ्जनम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001606048, "chapter_id": 21606, "verse_number": "२-४२-४९", "content_sanskrit": "कोटिकामकलापूर्णं कोटिचन्द्रांशुनिर्मलम् ।\nत्रिरेखकम्ठविलसद्रत्नगुञ्जामृगा कुलम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001606049, "chapter_id": 21606, "verse_number": "२-४२-५०", "content_sanskrit": "यमुनापुलिने तुङ्गे तमालवनकानने ।\nकदम्बचम्पकाशोकपारिजातमनोहरे ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001606050, "chapter_id": 21606, "verse_number": "२-४२-५१", "content_sanskrit": "शिखिपारावतशुकपिककोलाहलाकुले ।\nनिरोधार्थं गवामेव धावमानमितस्ततः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001606051, "chapter_id": 21606, "verse_number": "२-४२-५२", "content_sanskrit": "राधाविलासरसिकं कृष्णाख्यं पुरुषं परम् ।\nश्रुतवानस्मि वेदेभ्यो यतस्तद्गोचरोऽभवत् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001606052, "chapter_id": 21606, "verse_number": "२-४२-५३", "content_sanskrit": "एवं ब्रह्मणि चिन्मात्रे निर्गुणे भेदवर्जिते ।\nगोलोकसंज्ञिके कृष्णो दीव्यतीति श्रुतं मया ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001606053, "chapter_id": 21606, "verse_number": "२-४२-५४", "content_sanskrit": "नातः परतरं किञ्चिन्निगमागमयोरपि ।\nतथापि निगमो वक्ति ह्यक्षरात् परतः परः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001606054, "chapter_id": 21606, "verse_number": "२-४२-५५", "content_sanskrit": "गोलोकवासी भगवानक्षरात्पर उच्यते ।\nतस्मादपि परः कोऽसौ गीयते श्रुतिभिः सदा ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001606055, "chapter_id": 21606, "verse_number": "२-४२-५६", "content_sanskrit": "उद्दिष्टो वेद वचनैर्विशेषो ज्ञायते कथम् ।\nश्रुतेर्वार्थोऽन्यथा बोध्यः परतस्त्वक्षरादिति ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001606056, "chapter_id": 21606, "verse_number": "२-४२-५७", "content_sanskrit": "श्रुत्यर्थे संशयापन्नो व्यासः सत्यवतीसुतः ।\nविचारयामास चिरं न प्रपेदे यथातथम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001606057, "chapter_id": 21606, "verse_number": "२-४२-५८", "content_sanskrit": "सूत उवाच।\nविचारयन्नपि मुनिर्नाप वेदार्थनिश्चयम् ।\nवेदो नारायणः साक्षाद्यत्र मुह्यन्ति सूरयः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001606058, "chapter_id": 21606, "verse_number": "२-४२-५९", "content_sanskrit": "तथापि महतीमार्त्तिं सतां हृदयतापिनीम् ।\nपुनर्विचारयामास कं व्रजामि करोमि किम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001606059, "chapter_id": 21606, "verse_number": "२-४२-६०", "content_sanskrit": "पश्यामि न जगत्यस्मिन्सर्वज्ञं सर्वदर्शनम् ।\nअज्ञात्वाऽन्यतमं लोके सन्देहविनिवर्त्तकम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001606060, "chapter_id": 21606, "verse_number": "२-४२-६१", "content_sanskrit": "मेरोः कुहरिणीं गत्वा चचार परमं तपः ।\nयत्र कार्त्तस्वरक्फूर्जज्ज्योत्स्नाजालैर्निरन्तरम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001606061, "chapter_id": 21606, "verse_number": "२-४२-६२", "content_sanskrit": "सदा प्रबाधते विष्वक्तमःस्तोमं दृशन्तुदम् ।\nचकास्ते यत्र परमं कान्तारमतिसुन्दरम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001606062, "chapter_id": 21606, "verse_number": "२-४२-६३", "content_sanskrit": "नानाद्रुमलत ---त्पक्षिनिनादितम् ।\nक्षुत्पिपासाभयक्रोधतापग्लानिविवर्जितम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001606063, "chapter_id": 21606, "verse_number": "२-४२-६४", "content_sanskrit": "जलाशयैर्बहुविधैः पद्मिनीखण्डमण्डितैः  ।\nजातरूपशिलानद्धतटसञ्चारपाक्ष ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001606064, "chapter_id": 21606, "verse_number": "२-४२-६५", "content_sanskrit": "युक्तमम्भोज पवनैः सेव्यमानं समन्ततः ।\nशिवैरध्यासितम्भावैर्हिंस्रैः सत्त्वैः समुज्झितम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001606065, "chapter_id": 21606, "verse_number": "२-४२-६६", "content_sanskrit": "निर्जनं दिव्यलतिकाप्रियखण्डवराजितम् ।\nशूकैः पारावतै र्हृद्यैरुन्मदन्मत्तकोकिलम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001606066, "chapter_id": 21606, "verse_number": "२-४२-६७", "content_sanskrit": "उत्पतत्पद्मरजसां पटलामोददिङ्‌मुखम् ।\nतत्रापि काञ्चिनी दिव्या गुहा परमशोभना ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001606067, "chapter_id": 21606, "verse_number": "२-४२-६८", "content_sanskrit": "तां प्रविश्य जिता हारो जितचित्तो जितासनः ।\nसस्मार वेदांश्चतुरस्तदेकाग्रमना मुनिः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001606068, "chapter_id": 21606, "verse_number": "२-४२-६९", "content_sanskrit": "त्रयी जगाम शरदां शतस्य स्मरतोऽस्य हि  ।\nप्रादुरासंस्ततो वेदाश्चत्वारश्चारुदर्शनाः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001606069, "chapter_id": 21606, "verse_number": "२-४२-७०", "content_sanskrit": "स्फुरत्पद्मपलाशाक्षा जटामुकुटधारिणः ।\nकुशमुष्टिकराम्भोजा मृगत्वङ्मण्डितांसकाः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001606070, "chapter_id": 21606, "verse_number": "२-४२-७१", "content_sanskrit": "स्वरैः षोडशभिः क्लृप्त वदनाः प्रणवान्तराः ।\nकचवर्गोद्भवैर्वर्णैः पञ्चावयवपाणयः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001606071, "chapter_id": 21606, "verse_number": "२-४२-७२", "content_sanskrit": "पवर्गदक्षचरणा वामपादास्तवर्गतः ।\nआतरन्त्यन्तवर्णाश्च येषां कुक्षिद्वयात्मकौ ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001606072, "chapter_id": 21606, "verse_number": "२-४२-७३", "content_sanskrit": "नाभिनिद्राः कान्तपृष्ठा मोदरा यरलवोत्कचाः ।\nअग्निदक्षांशरुचिरा धराग्रीवा भृतासकाः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001606073, "chapter_id": 21606, "verse_number": "२-४२-७४", "content_sanskrit": "अन्तस्थसन्धिसंस्थाना वैखरीवाग्विजृम्भिताः ।\nअपश्यन्मथुरामेषां हृदयाम्भोजकल्पिताम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001606074, "chapter_id": 21606, "verse_number": "२-४२-७५", "content_sanskrit": "हरेर्भगवतः साक्षादाविर्भावस्थली हि सा ।\nकाशीमपश्यद्भ्रूमध्ये मायामाधारसंस्थिताम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001606075, "chapter_id": 21606, "verse_number": "२-४२-७६", "content_sanskrit": "लिङ्गदेशे ततः काञ्चीमवन्तीं नाभिमण्डले  ।\nकण्ठस्थां द्वारकामेषां प्रयागं प्राणगं तथा ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001606076, "chapter_id": 21606, "verse_number": "२-४२-७७", "content_sanskrit": "सव्यापसव्ययोस्तेषां गड्गाऽपि यमुना नदी  ।\nमध्ये सरस्वती साक्षाद्गयाक्षेत्रं तथानने ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001606077, "chapter_id": 21606, "verse_number": "२-४२-७८", "content_sanskrit": "हनुग्रीवामध्यगतं प्रभासक्षेत्रमुत्तमम् ।\nबदर्य्याश्रममेतेषां ब्रह्मरन्ध्रे ददर्श ह ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001606078, "chapter_id": 21606, "verse_number": "२-४२-७९", "content_sanskrit": "पौण्ड्रवर्धननेपालपीठं नयनयोर्युगे ।\nपीठं पूर्णगिरिंनाम ललाटे समदृश्यत ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001606079, "chapter_id": 21606, "verse_number": "२-४२-८०", "content_sanskrit": "कण्ठे च मथुरापीठं काञ्चीपीठं कटिस्थितम् ।\nजालन्धरं तथा पीठं स्तनदेशेष्वदृश्यत ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001606080, "chapter_id": 21606, "verse_number": "२-४२-८१", "content_sanskrit": "भृगुपीठं कर्णदेशे ह्ययोध्यां नासिकापुटे ।\nब्रह्मरन्ध्रे स्थितं ब्राह्यं शैवं सीमन्तसीमनि ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001606081, "chapter_id": 21606, "verse_number": "२-४२-८२", "content_sanskrit": "शाक्तं जिह्वाग्र धिषणं वैष्णवं हृदयाम्बुजे ।\nसौरं चक्षुःप्रदेशस्थं बौद्धञ्छायासु सङ्गतम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001606082, "chapter_id": 21606, "verse_number": "२-४२-८३", "content_sanskrit": "सौत्रामणिं कण्ठदेशे पशुबन्धमथोरसि ।\nवाजपेयं कटितटे ह्यग्निहोत्रं तथानने ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7001606083, "chapter_id": 21606, "verse_number": "२-४२-८४", "content_sanskrit": "अश्वमेधं कटितटे नरमेधमथोदरे ।\nराजसूयं शिरोदेशे आवसथ्यं तथाऽधरे ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7001606084, "chapter_id": 21606, "verse_number": "२-४२-८५", "content_sanskrit": "ऊर्द्ध्वोष्ठे दक्षिणाग्निञ्च गार्हपत्यं मुखान्तरे ।\nहव्यं श्रुतौ मन्त्रभेदांस्तथा रोमस्ववस्थितान् ।\nभृत्यैरिव महाराजं पुराणैर्न्यायमिश्रितैः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7001606085, "chapter_id": 21606, "verse_number": "२-४२-८६", "content_sanskrit": "संहिताभिश्च तन्त्रैश्च पृथक्पृथगुपासितान् ।\nकर्म ज्ञानोपासनाभिर्जनानुग्रहकारकान् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7001606086, "chapter_id": 21606, "verse_number": "२-४२-८७", "content_sanskrit": "दृष्ट्वा सुविस्मितमना मुनिः कृष्णो बभूव तान्  ।\nब्रह्मतेजोमयान्दिव्यांस्तपतोऽर्कानिवच्युतान् ।\nज्लतोऽग्नी निवोदर्कान्कोटीन्दुसमदर्शनान् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7001606087, "chapter_id": 21606, "verse_number": "२-४२-८८", "content_sanskrit": "ववन्दे सहसोत्थाय दण्डवत्पतितो मुनिः ।\nकृतार्थोऽहं कृतार्थोऽहं कृतार्थोऽहमितीरयन् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7001606088, "chapter_id": 21606, "verse_number": "२-४२-८९", "content_sanskrit": "अद्य मे सफलं जन्म अद्य मे सफलं मनः ।\nअद्य मे सफलञ्चायुर्यद्भवन्तोऽक्षिगोचराः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7001606089, "chapter_id": 21606, "verse_number": "२-४२-९०", "content_sanskrit": "अलौकिकंलौकिकञ्च यत् किञ्चिदपि विद्यते ।\nन तद्वोऽविदितं वेद्यं भूत भव्यं भवच्च यत् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7001606090, "chapter_id": 21606, "verse_number": "२-४२-९१", "content_sanskrit": "न प्रवृत्तिफला यूयं दर्शयन्तोऽपि तान्सदा ।\nयदृच्छाकरसङ्कोचविधानायेह रागिणाम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7001606091, "chapter_id": 21606, "verse_number": "२-४२-९२", "content_sanskrit": "प्रपञ्चस्यापि मिथ्यात्वे ब्रह्मत्वे वा निधीतरौ ।\nन मृषारागविषयौ तत्सङ्कोचविधिक्षयौ ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7001606092, "chapter_id": 21606, "verse_number": "२-४२-९३", "content_sanskrit": "अतो लोकहितैर्नूनं परमार्थनिरूपणे ।\nस्वोक्ताः स्वर्गादिविषयाः नश्वरा इति निन्दिताः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7001606093, "chapter_id": 21606, "verse_number": "२-४२-९४", "content_sanskrit": "अधिकारिविभेदेन कर्मज्ञानोपदेशतः ।\nत्रातं सर्वं जगन्नूनं शब्दब्रह्मात्ममूर्त्तिभिः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7001606094, "chapter_id": 21606, "verse_number": "२-४२-९५", "content_sanskrit": "अतोऽहं प्रष्टुमिच्छमि भवन्तश्चेत्कृपालवः  ।\nकर्मणां फलमादिष्टं सर्गः कामैकचेतसाम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7001606095, "chapter_id": 21606, "verse_number": "२-४२-९६", "content_sanskrit": "ईशार्पितधियां पुंसां कृतस्यापि च कर्मणः ।\nचित्तशुद्धिस्ततो ज्ञानं मोक्षश्च तदनन्तरम् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7001606096, "chapter_id": 21606, "verse_number": "२-४२-९७", "content_sanskrit": "मोक्षो ब्रह्मैक्यमित्येवं सच्चिदानन्दमेव यत् ।\nसर्वं समाप्यते तस्मिञ्ज्ञाते यद्धि कृताकृतम् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7001606097, "chapter_id": 21606, "verse_number": "२-४२-९८", "content_sanskrit": "यन्निःसङ्गं चिदाकाशं ज्ञानरूपमसंवृतम् ।\nनिरीहमचलं शुद्धमगुणं व्यापकं स्मृतम् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7001606098, "chapter_id": 21606, "verse_number": "२-४२-९९", "content_sanskrit": "विकारेषु विनश्यत्सु निर्विकारं न नश्यति ।\nयथान्धतमसा व्याप्तलोकस्य रविरोजसा ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7001606099, "chapter_id": 21606, "verse_number": "२-४२-१००", "content_sanskrit": "लोहस्येव मणिस्तद्वदरणिश्चानले यथा ।\nयदाभासेन सा सत्तां प्रतिपद्य विजृम्भते ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7001606100, "chapter_id": 21606, "verse_number": "२-४२-१०१", "content_sanskrit": "जीवेश्वरादिरूपेण विश्वाकारेण चाप्यहो ।\nतस्यामपि प्रलीनायां कूटस्थञ्च यदेकलम् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7001606101, "chapter_id": 21606, "verse_number": "२-४२-१०२", "content_sanskrit": "भवद्भिरेवं निर्णीतं तत्तथैव न संशयः ।\nतथापि मम जिज्ञासा वर्त्तते केवलं हृदि ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7001606102, "chapter_id": 21606, "verse_number": "२-४२-१०३", "content_sanskrit": "अतोऽपि परमं किञ्चिद्वर्त्तते किल वा न वा ।\nतद्वदन्तु महाभागा भवन्तस्तत्त्वदर्शनाः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7001606103, "chapter_id": 21606, "verse_number": "२-४२-१०४", "content_sanskrit": "यच्छ्रवः फलमेवेह जनुषो मे कृतार्थता ।\nएवं ब्रुवन्तमनघं व्यासं सत्यवतीसुतम् ।\nसाधु साध्विति सङ्कीर्त्य प्रत्यूचु र्निगमा वचः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7001606104, "chapter_id": 21606, "verse_number": "२-४२-१०५", "content_sanskrit": "वेदा ऊचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7001606105, "chapter_id": 21606, "verse_number": "२-४२-१०६", "content_sanskrit": "साधु साधु महाप्राज्ञा विष्णुरात्मा शरीरिणाम् ।\nअजोऽपि जन्म सम्पद्य लोकानुग्रहमीहसे ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7001606106, "chapter_id": 21606, "verse_number": "२-४२-१०७", "content_sanskrit": "अन्यथा ते न घटते संसारकर्म्मबन्दनम् ।\nअस्पृष्टो मायया देव्या कदाचिज्ज्ञानगूहया ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7001606107, "chapter_id": 21606, "verse_number": "२-४२-१०८", "content_sanskrit": "बिभर्षि स्वेच्छया रूपं स्वेच्छयैव निगूहसे ।\nअस्मत्सम्मत एवार्थो भवता सम्प्रदर्शितः ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7001606108, "chapter_id": 21606, "verse_number": "२-४२-१०९", "content_sanskrit": "पुराणेष्वितिहासेषु सूत्रेष्वपि च नैकधा ।\nअक्षरं ब्रह्म परमं सर्वकारणकारणम् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7001606109, "chapter_id": 21606, "verse_number": "२-४२-११०", "content_sanskrit": "तस्यात्मनोऽप्यात्म भावतया पुष्पस्य गन्धवत् ।\nरसवद्वा स्थितं रूपमवेहि परमं हि तत् ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7001606110, "chapter_id": 21606, "verse_number": "२-४२-१११", "content_sanskrit": "अनुभूतं तदस्माभिर्जाते प्राकृतिके लये ।\nअक्षरात्परतस्तस्माद्यत्परं केवलो रसः  ।\nन च तत्र वयं शक्ताः शब्दातीते तदात्मकाः ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}]