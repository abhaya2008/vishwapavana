[{"id": 7006010000, "chapter_id": 26010, "verse_number": "१-१९३-१", "content_sanskrit": "हरिरुवाच ।\nपलाण्डुजीरके कुष्ठमश्वगन्धाजमोदकम् ।\nवचा त्रिकटुकञ्चैव लवणं चूर्णमुत्तमम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006010001, "chapter_id": 26010, "verse_number": "१-१९३-२", "content_sanskrit": "ब्राह्मीरसैर्भावितञ्च सर्पिर्मधुसमन्वितम् ।\nसप्ताहं भक्षितं कुर्यान्निर्मलाञ्च मतिं पराम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006010002, "chapter_id": 26010, "verse_number": "१-१९३-३", "content_sanskrit": "सिद्धार्थकं वचा हिङ्गु करञ्जं देवदारु च ।\nमञ्जिष्ठा त्रिफला विश्वं शिरीषो रजनीद्वयम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006010003, "chapter_id": 26010, "verse_number": "१-१९३-४", "content_sanskrit": "प्रियङ्गुनिम्बत्रिक्रटु गोमूत्रेणैव घर्षितम ।\nनसयमालेपनञ्चैव तथा चोद्वर्तनं हितम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006010004, "chapter_id": 26010, "verse_number": "१-१९३-५", "content_sanskrit": "अपस्मारविषोन्मादशोषालक्ष्मीज्वरापहम् ।\nभूतेभ्यश्चभयं हन्ति राजद्वारेषु योजनात् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006010005, "chapter_id": 26010, "verse_number": "१-१९३-६", "content_sanskrit": "निम्बं कुष्ठं हरिद्रे द्वे शिग्रु सर्षपजं था ।\nदेवदारु पटोलञ्च धान्यं तक्रेण घर्षितम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006010006, "chapter_id": 26010, "verse_number": "१-१९३-७", "content_sanskrit": "देहं तैलाक्त गात्रं वै नयेदुद्वर्तनेन च ।\nपामाः कुष्ठानि नश्येयुः कण्डूं हन्ति च निश्चितम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006010007, "chapter_id": 26010, "verse_number": "१-१९३-८", "content_sanskrit": "सामुद्रं सैन्धवं क्षारो राजिका लवणं विडम् ।\nकटुलोहरजश्चैवं त्रिवृत्सूरणकं समम ।\nदधिगोमूत्रपयसा मन्दपावकपाचितम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006010008, "chapter_id": 26010, "verse_number": "१-१९३-९", "content_sanskrit": "बलाग्निवर्धकं चूर्णं पिबेदुष्णेन वारिणा ।\nजीर्णेऽजीर्णे तु भुञ्जति मांस्यादिघृतमुत्तमम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006010009, "chapter_id": 26010, "verse_number": "१-१९३-१०", "content_sanskrit": "नाभिशूलं मूत्रशूलं गुल्मप्लीहभवञ्च यत् ।\nसर्वशूलहरं चूर्णं जठरानलदीपनम् ।\nपरिणामसमुत्थस्य शूलस्य च हितं परम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006010010, "chapter_id": 26010, "verse_number": "१-१९३-११", "content_sanskrit": "अभयामलकं द्राक्षा पिप्पली कण्टकारिका ।\nशृङ्गी पुनर्नवा शुण्ठी जग्धा कासं निहन्ति वै ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006010011, "chapter_id": 26010, "verse_number": "१-१९३-१२", "content_sanskrit": "अभयामलकं द्राक्षा पाठा चैव विभीतकम् ।\nशर्कराया समं चैव जग्धं ज्वरहरं भवेत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006010012, "chapter_id": 26010, "verse_number": "१-१९३-१३", "content_sanskrit": "त्रिफला बदरं द्राक्षा पिप्पली च विरकृत् ।\nहरीतकी सोष्णानीरलवणञ्च विरेककृत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006010013, "chapter_id": 26010, "verse_number": "१-१९३-१४", "content_sanskrit": "कूर्ममत्स्याश्वमहिषगोशृगालाश्च वानरा। ।\nविडालबर्हिकाकाश्च वराहोलूककुक्कुटाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006010014, "chapter_id": 26010, "verse_number": "१-१९३-१५", "content_sanskrit": "हंस एषाञ्च विण्मूत्रं मांसं वा रोम शोणितम् ।\nधूपं दद्याज्ज्वरार्तेभ्य उन्मत्तेभ्यश्च शान्तये ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006010015, "chapter_id": 26010, "verse_number": "१-१९३-१६", "content_sanskrit": "एतान्यौषधजातानि कथितानि उमापते ।\nनिघ्नन्ति ताश्च रोगांश्च वृक्षमिन्द्राशनिर्यथा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006010016, "chapter_id": 26010, "verse_number": "१-१९३-१७", "content_sanskrit": "औषधंभगवान्विष्णुः संस्मृतो रोगनुद्भवेत् ।\nध्यातोऽर्चितः स्तुतो वापि नात्र कार्या विचारणा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]