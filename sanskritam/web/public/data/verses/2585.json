[{"id": 2074980, "chapter_id": 2585, "verse_number": "१२-९०-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2074981, "chapter_id": 2585, "verse_number": "१२-९०-१", "content_sanskrit": "आनङ्गिराः क्षत्रधर्मानुचध्यो ब्रह्मवित्तमः।\nमान्धात्रे यौवनाश्चाय प्रीतिमानभ्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2074982, "chapter_id": 2585, "verse_number": "१२-९०-२", "content_sanskrit": "स यथाऽनुशशासैजमुचध्यो ब्रह्मवित्तमः।\nतत्तेऽहं संप्रवक्ष्यामि निखिलेन युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2074983, "chapter_id": 2585, "verse_number": "१२-९०-३x", "content_sanskrit": "उचथ्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2074984, "chapter_id": 2585, "verse_number": "१२-९०-३", "content_sanskrit": "धर्माम राजा भवति न कामकरणाय तु।\nमान्यातरभिजानीहि राजा लोकस्य रक्षिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2074985, "chapter_id": 2585, "verse_number": "१२-९०-४", "content_sanskrit": "राजा चरति चेद्धर्मं देवत्वायैव कल्पते।\nस चेदधर्मं चरति नरकायैव गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2074986, "chapter_id": 2585, "verse_number": "१२-९०-५", "content_sanskrit": "धर्मे तिष्ठन्ति भूतानि धर्मो राजनि तिष्ठाति।\nतं राजा साधु यः शास्ति स राजा श्रियमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2074987, "chapter_id": 2585, "verse_number": "१२-९०-६", "content_sanskrit": "राजापराधान्मान्धातर्लक्ष्मीवान्पाप उच्यते।\nदेवाश्च गर्हां गच्छन्ति धर्मो नास्तीति चोच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2074988, "chapter_id": 2585, "verse_number": "१२-९०-७", "content_sanskrit": "अधर्मे वर्तमानानामर्थसिद्धिः प्रदृश्यते।\nतदेव मङ्गलं लोकः सर्वः समनुवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2074989, "chapter_id": 2585, "verse_number": "१२-९०-८", "content_sanskrit": "उच्छिद्यते धर्मवृत्तमधर्मो वर्तते महान्।\nभयमाहुर्दिवारात्रं यदा पापा न वार्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2074990, "chapter_id": 2585, "verse_number": "१२-९०-९", "content_sanskrit": "इदं मम इदं नेति साधूनां तात धर्मतः।\nन वै व्यवस्था भवति यदा पापो न वार्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2074991, "chapter_id": 2585, "verse_number": "१२-९०-१०", "content_sanskrit": "नैव भार्या न पशवो न क्षेत्रं न निवेशनम्।\nसंदृश्येत मनुष्याणां यदा पापबलं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2074992, "chapter_id": 2585, "verse_number": "१२-९०-११", "content_sanskrit": "देवाः पूजां न जानन्ति न स्वधां पितरस्तदा।\nन पूज्यन्ते ह्यतिथयो यदा पापो न वार्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2074993, "chapter_id": 2585, "verse_number": "१२-९०-१२", "content_sanskrit": "न वेदानधिगच्छन्ति व्रतवन्तो द्विजातयः।\nन यज्ञांस्तन्वते विप्रा यदा पापो न वार्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2074994, "chapter_id": 2585, "verse_number": "१२-९०-१३", "content_sanskrit": "वध्यानामिव सत्वानां मनो भवति विह्वलम्।\nमनुष्याणां महाराज यदा पापो न वार्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2074995, "chapter_id": 2585, "verse_number": "१२-९०-१४", "content_sanskrit": "उभौ लोकावभिप्रेक्ष्य राजानमसृजंस्तथा।\nमुनयोऽथ महद्भूतमयं धर्मो भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2074996, "chapter_id": 2585, "verse_number": "१२-९०-१५", "content_sanskrit": "यस्मिन्धर्मो विराजेत तं राजानं प्रचक्षते।\nयस्मिन्विलीयते धर्मस्तं देवा वृषलं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2074997, "chapter_id": 2585, "verse_number": "१२-९०-१६", "content_sanskrit": "वृषो हि भगवान्धर्मो यस्तस्य कुरुते लयम्।\nवृषलं तं वीवदुर्देवास्तस्माद्धर्मं न लोपयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2074998, "chapter_id": 2585, "verse_number": "१२-९०-१७", "content_sanskrit": "धर्मे वर्धति वर्धन्ति सर्वभूतानि सर्वदा।\nतस्मिन्ह्रसति हीयन्ते तस्माद्धर्मं विवर्धयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2074999, "chapter_id": 2585, "verse_number": "१२-९०-१८", "content_sanskrit": "धनानि स्पौति धर्मो हि धारणाद्वेति निश्चयः।\nमानवान मनुष्येन्द्र स सीमान्तकरः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2075000, "chapter_id": 2585, "verse_number": "१२-९०-१९", "content_sanskrit": "प्रभवार्थंमहि भूतानां धर्मः सृष्टः स्वयंभुवा।\nतस्मात्प्रवर्धयेद्धर्मं प्रजानुग्रहकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2075001, "chapter_id": 2585, "verse_number": "१२-९०-२०", "content_sanskrit": "तस्माद्धि राजशार्दूल धर्मः श्रेष्ठतरः स्मृतः।\nस राजायः प्रजाः शास्ति साधुकृत्पुरुषर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2075002, "chapter_id": 2585, "verse_number": "१२-९०-२१", "content_sanskrit": "कामक्रोधावनादृत्य धर्ममेवानुपालयेत्।\nधर्मः श्रेयस्करतमो राज्ञां भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2075003, "chapter_id": 2585, "verse_number": "१२-९०-२२", "content_sanskrit": "धर्मस्य ब्राह्मणे योनिस्तस्मात्तान्पूजयेत्सदा।\nब्राह्मणानां च मान्धातः कुर्यात्कामानमत्सरी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2075004, "chapter_id": 2585, "verse_number": "१२-९०-२३", "content_sanskrit": "तेषां ह्यकामकरणाद्राज्ञः संजायते भयम्।\nमित्राणि न च वर्धन्ते तथाऽमित्रीभवन्त्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2075005, "chapter_id": 2585, "verse_number": "१२-९०-२४", "content_sanskrit": "ब्राह्मणानां सदासूयन्बाल्याद्वैरोचनिर्बलिः।\nअथास्माच्छ्रीरपाक्रामद्याऽस्मिन्नासीत्प्रतापिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2075006, "chapter_id": 2585, "verse_number": "१२-९०-२५", "content_sanskrit": "ततस्तस्मादपाक्रम्य साऽगच्छत्पाकशासनम्।\nअथ सोऽन्वतपत्पश्चाच्छ्रियं दृष्ट्वा पुरंदरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2075007, "chapter_id": 2585, "verse_number": "१२-९०-२६", "content_sanskrit": "एतत्फलमसूयाया अभिमानस्य चाभिभो।\nतस्माद्बुध्यस्व मान्धातर्मा त्वां जह्यात्प्रतापिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2075008, "chapter_id": 2585, "verse_number": "१२-९०-२७", "content_sanskrit": "दर्पोनाम श्रियः पुत्रो जज्ञेऽधर्मादिति श्रुतिः।\nतेन देवासुरा राजन्नीताः सुबहवोऽव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2075009, "chapter_id": 2585, "verse_number": "१२-९०-२८", "content_sanskrit": "राजर्षयश्च बहवस्तथा बुध्यस्व पार्थिव।\nराजा भवति तं जित्वा दासस्तेन पराजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2075010, "chapter_id": 2585, "verse_number": "१२-९०-२९", "content_sanskrit": "स यथा दर्पसहितमधर्मं नानुसेवते।\nतथा वर्तस्व मान्धातश्चिरं चेत्स्थातुमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2075011, "chapter_id": 2585, "verse_number": "१२-९०-३०", "content_sanskrit": "मत्तात्प्रमत्तात्पौगण्डादुन्मत्ताच्च विशेषतः।\nनिन्दिताच्चासदाचाराद्दुर्हृदां चापि सेवनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2075012, "chapter_id": 2585, "verse_number": "१२-९०-३१", "content_sanskrit": "निगृहीतादमात्याच्च स्त्रीभ्यश्चैव विशेषतः।\nपर्वताद्विषमाद्दुर्गाद्धस्तिनोऽश्वात्सरीसृपात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2075013, "chapter_id": 2585, "verse_number": "१२-९०-३२", "content_sanskrit": "एतेभ्योऽनित्ययुक्तः स्यान्नक्तं चर्यां च वर्जयेत्।\nअत्याशां चाभिमानं च दम्भं क्रोधं च वर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2075014, "chapter_id": 2585, "verse_number": "१२-९०-३३", "content_sanskrit": "अविज्ञातासु च स्त्रीषु क्लीबासु स्वैरिणीषु च।\nपरभार्यासु कन्यासु नाचरेन्मैथुनं नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2075015, "chapter_id": 2585, "verse_number": "१२-९०-३४", "content_sanskrit": "कुलेषु पापरक्षांसि जायन्ते वर्णसंकरात्।\nअपुमांसोऽङ्गहीनाश्च स्थूलजिह्वा विचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2075016, "chapter_id": 2585, "verse_number": "१२-९०-३५", "content_sanskrit": "एते चान्ये च जायन्ते यदा राजा प्रमाद्यति।\nतस्माद्राज्ञा विशेषेणं वर्तितव्यं प्रजाहिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2075017, "chapter_id": 2585, "verse_number": "१२-९०-३६", "content_sanskrit": "क्षत्रियस्य प्रमत्तस्य दोषः संजायते महान्।\nअधर्माः संप्रवर्धन्ते प्रजासंकरकारकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2075018, "chapter_id": 2585, "verse_number": "१२-९०-३७", "content_sanskrit": "अशीते विद्यते शीतं शीते शीतं न विद्यते।\nअवृष्टिरतिवृष्टिश्च व्याधिश्चाप्याविशेत्प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2075019, "chapter_id": 2585, "verse_number": "१२-९०-३८", "content_sanskrit": "नक्षत्राण्युपतिष्ठन्ति ग्रहा घोरास्तथागते।\nउत्पाताश्चात्र दृश्यन्ते बहवो राजनाशनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2075020, "chapter_id": 2585, "verse_number": "१२-९०-३९", "content_sanskrit": "अरक्षितात्मा यो राजा प्रजाश्चापि न रक्षति।\nप्रजाश्च तस्य क्षीयन्ते ततः सोऽनु विनश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2075021, "chapter_id": 2585, "verse_number": "१२-९०-४०", "content_sanskrit": "द्वावाददाते ह्येकस्य द्वयोः सुबहवोऽपरे।\nकुमार्यः संप्रलुप्यन्ते तदाहुर्नृपदूषणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2075022, "chapter_id": 2585, "verse_number": "१२-९०-४१", "content_sanskrit": "ममैतदिति नैतच्च मनुष्येष्ववतिष्ठति।\nत्यक्त्वा धर्मं यदा राजा प्रमादमनुतिष्ठित॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2075023, "chapter_id": 2585, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि नवतितमोऽध्यायः॥ ९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]