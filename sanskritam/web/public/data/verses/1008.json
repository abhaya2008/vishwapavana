[{"id": 2001053, "chapter_id": 1008, "verse_number": "१-९-०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2001054, "chapter_id": 1008, "verse_number": "१-९-१", "content_sanskrit": "तेषु तत्रोपविष्टेषु ब्राह्मणेषु महात्मसु।\nरुरुश्चुक्रोश गहनं वनं गत्वाऽतिदुःखितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2001055, "chapter_id": 1008, "verse_number": "१-९-२", "content_sanskrit": "शोकेनाभिहतः सोऽथ विलपन्करुणं बहु।\nअब्रवीद्वचनं शोचन्प्रियां स्मृत्वा प्रमद्वराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2001056, "chapter_id": 1008, "verse_number": "१-९-३", "content_sanskrit": "शेते सा भुवि तन्वङ्गी मम शोकविवर्धिनी।\nप्राणानपहरन्तीव पूर्णचन्द्रनिभानना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2001057, "chapter_id": 1008, "verse_number": "१-९-४", "content_sanskrit": "यदि पीनायतश्रोणी पद्मपत्रनिभेक्षणा।\nमुमूर्षुरपि मे प्राणानादायाशु गमिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2001058, "chapter_id": 1008, "verse_number": "१-९-५", "content_sanskrit": "पितृमातृसखीनां च लुप्तपिण्डस्य तस्य मे।\nबान्धवानां च सर्वेषां किं नु दुःखमतःपरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2001059, "chapter_id": 1008, "verse_number": "१-९-६", "content_sanskrit": "यदि दत्तं तपस्तप्तं गुरवो वा मया यदि।\nसम्यगाराधितास्तेन संजीवतु मम प्रिया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2001060, "chapter_id": 1008, "verse_number": "१-९-७", "content_sanskrit": "यथा च जन्मप्रभृति यतात्माऽहं धृतव्रतः।\nप्रमद्वरा तथाद्यैषा समुत्तिष्ठतु भामिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2001061, "chapter_id": 1008, "verse_number": "१-९-८", "content_sanskrit": "[एवं लालप्यतस्तस्य भार्यार्थे दुःखितस्य च।\nदेवदूतस्तदाऽभ्येत्य वाक्यमाह रुरुं वने॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2001062, "chapter_id": 1008, "verse_number": "१-९-९", "content_sanskrit": "कृष्णे विष्णौ हृषीकेशे लोकेशेऽसुरविद्विषि।\nयदि मे निश्चला भक्तिर्मम जीवतु सा प्रिया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2001063, "chapter_id": 1008, "verse_number": "१-९-१०", "content_sanskrit": "विलप्यमाने तु रुरौ सर्वे देवाः कृपान्विताः।\nदूतं प्रस्थापयामासुः संदिश्यास्य हितं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2001064, "chapter_id": 1008, "verse_number": "१-९-११", "content_sanskrit": "स दूतस्त्वरितोऽभ्येत्य देवानां प्रियकृच्छुचिः।\nउवाच देववचनं रुरुमाभाष्य दुःखितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2001065, "chapter_id": 1008, "verse_number": "१-९-१२", "content_sanskrit": "देवैः सर्वैरहं ब्रह्मन्प्रेषितोऽस्मि तवान्तिकम्।\nत्वद्धितं त्वद्धितैरुक्तं शृणु वाक्यं द्विजोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2001066, "chapter_id": 1008, "verse_number": "१-९-१३", "content_sanskrit": "अभिधत्से ह यद्वाचा रुरो दुःखान्न तन्मृषा।\nन तु मर्त्यस्य धर्मात्मन्नायुरस्ति गतायुषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2001067, "chapter_id": 1008, "verse_number": "१-९-१४", "content_sanskrit": "गतायुरेषा कृपणा गन्धर्वाप्सरसोः सुता।\nतस्माच्छोके मनस्तात मा कृथास्त्वं कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2001068, "chapter_id": 1008, "verse_number": "१-९-१५", "content_sanskrit": "उपायश्चात्र विहितः पूर्वं देवैर्महात्मभिः।\nतं यदीच्छसि कर्तुं त्वं प्राप्स्यसीह प्रमद्वराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2001069, "chapter_id": 1008, "verse_number": "१-९-१६x", "content_sanskrit": "रुरुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2001070, "chapter_id": 1008, "verse_number": "१-९-१६", "content_sanskrit": "क उपायः कृतो देवैर्बूहि तत्त्वेन खेचर।\nकरिष्येऽहं तथा श्रुत्वा त्रातुमर्हति मां भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2001071, "chapter_id": 1008, "verse_number": "१-९-१७x", "content_sanskrit": "देवेदूत उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2001072, "chapter_id": 1008, "verse_number": "१-९-१७", "content_sanskrit": "आयुषोऽर्धं प्रयच्छ त्वं कन्यायै भृगुनन्दन।\nएवमुत्थास्यति रुरो तव भार्या प्रयद्वरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2001073, "chapter_id": 1008, "verse_number": "१-९-१८x", "content_sanskrit": "रुरुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2001074, "chapter_id": 1008, "verse_number": "१-९-१८", "content_sanskrit": "आयुषोऽर्धं प्रयच्छामि कन्यायै खेचरोत्तम।\nशृङ्गाररूपाभरणा समुत्तिष्ठतु मे प्रिया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2001075, "chapter_id": 1008, "verse_number": "१-९-१९x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2001076, "chapter_id": 1008, "verse_number": "१-९-१९", "content_sanskrit": "ततो गन्धर्वराजश्च देवदूतश्च सत्तमौ।\nधर्मराजमुपेत्येदं वचनं प्रत्यभाषताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2001077, "chapter_id": 1008, "verse_number": "१-९-२०", "content_sanskrit": "धर्मराजायुषोऽर्धेन रुरोर्भार्या प्रमद्वरा।\nसमुत्तिष्ठतु कल्याणी मृतैवं यदि मन्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2001078, "chapter_id": 1008, "verse_number": "१-९-२१x", "content_sanskrit": "धर्मराज उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2001079, "chapter_id": 1008, "verse_number": "१-९-२१", "content_sanskrit": "प्रमद्वरा रुरोर्भार्या देवदूत यदीच्छसि।\nउत्तिष्ठत्वायुषोऽर्धेन रुरोरेव समन्विता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2001080, "chapter_id": 1008, "verse_number": "१-९-२२x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2001081, "chapter_id": 1008, "verse_number": "१-९-२२", "content_sanskrit": "एवमुक्ते ततः कन्या सोदतिष्ठत्प्रमद्वरा।\nरुरोस्तस्यायुषोऽर्धेन सुप्तेव वरवर्णिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2001082, "chapter_id": 1008, "verse_number": "१-९-२३", "content_sanskrit": "एतद्दृष्टं भविष्ये हि रुरोरुत्तमतेजसः।\nआयुषोऽतिप्रवृद्धस्य भार्यार्थेऽर्धमलुप्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2001083, "chapter_id": 1008, "verse_number": "१-९-२४", "content_sanskrit": "तत इष्टेऽहनि तयोः पितरौ चक्रतुर्मुदा।\nविवाहं तौ च रेमाते परस्परहितैषिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2001084, "chapter_id": 1008, "verse_number": "१-९-२५", "content_sanskrit": "स लब्ध्वा दुर्लभां भार्यां पद्मकिञ्जल्कसुप्रभाम्।\nव्रतं चक्रे विनाशाय जिह्मगानां धृतव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2001085, "chapter_id": 1008, "verse_number": "१-९-२६", "content_sanskrit": "स दृष्ट्वा जिह्मगान्सर्वांस्तीव्रकोपसमन्वितः।\nअभिहन्ति यथासत्त्वं गृह्य प्रहरणं सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2001086, "chapter_id": 1008, "verse_number": "१-९-२७", "content_sanskrit": "स कदाचिद्वनं विप्रो रुरुरभ्यागमन्महत्।\nशयानं तत्र चापश्यड्डुण्डुभं वयसान्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2001087, "chapter_id": 1008, "verse_number": "१-९-२८", "content_sanskrit": "तत उद्यम्य दम्डं स कालदण्डोपमं तदा।\nजिघांसुः कुपितो विप्रस्तमुवाचाथ डुण्डुभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2001088, "chapter_id": 1008, "verse_number": "१-९-२९", "content_sanskrit": "नापराध्यामि ते किंचिदहमद्य तपोधन।\nसंरम्भाच्च किमर्थं मामभिहंसि रुषान्वितः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2001089, "chapter_id": 1008, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वाणि पौलोमपर्वणि नवमोऽध्यायः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]