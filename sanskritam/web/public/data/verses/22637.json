[{"id": 7002637000, "chapter_id": 22637, "verse_number": "६-१५-१", "content_sanskrit": "सूत उवाच ।\nप्रशस्य भूपतिं शुद्धं वेतालो रुद्रकिंकरः ।\nपुनराख्यानकं विप्र वर्णयामास सुन्दरम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002637001, "chapter_id": 22637, "verse_number": "६-१५-२", "content_sanskrit": "कान्यकुज्जे महाराज ब्राह्मणो दानशीलकः ।\nबभूव सत्यसंधश्च देवीपूजनतत्परः ।\nप्रतिग्रहेण यद्द्रव्यं तेन दानमचीकरत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002637002, "chapter_id": 22637, "verse_number": "६-१५-३", "content_sanskrit": "कदाचित्तु शरत्काले नवदुर्गाव्रतं ह्यभूत् ।\nन प्राप्तं दानतो द्रव्यं तदा चिंतातुरोऽभवत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002637003, "chapter_id": 22637, "verse_number": "६-१५-४", "content_sanskrit": "किं कर्तव्यं मया चाद्य येन द्रव्ययुतो ह्यहम् ।\nकन्या निमंत्रिताश्चाद्य कथं तां भोजयाम्यहम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002637004, "chapter_id": 22637, "verse_number": "६-१५-५", "content_sanskrit": "इति शोकसमायुक्तस्तदा देवीप्रसादतः ।\nमुद्राः पञ्च तदा प्राप्तास्ताभिर्व्रतमचीकरत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002637005, "chapter_id": 22637, "verse_number": "६-१५-६", "content_sanskrit": "निराहारव्रतं तेन कृतं तु नवमाह्निकम् ।\nतेन व्रतप्रभावेन मृतो देवत्वमागतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002637006, "chapter_id": 22637, "verse_number": "६-१५-७", "content_sanskrit": "जीमूतकेतुरिति च सोभूद्विद्याधराधिपः ।\nहिमाचलगिरौ रम्ये पुरे विद्याधरे शुभे ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002637007, "chapter_id": 22637, "verse_number": "६-१५-८", "content_sanskrit": "उवास कतिचिद्वर्षान्दिव्य भोगप्रभोगवान् ।\nतत्र कल्पद्रुमं नित्यं पूजयामास भक्तितः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002637008, "chapter_id": 22637, "verse_number": "६-१५-९", "content_sanskrit": "तेन वृक्षप्रभावेन जातः पुत्रो महोत्तमः ।\nसर्वाकलासु निपुणो नाम्ना जीमूतवाहनः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002637009, "chapter_id": 22637, "verse_number": "६-१५-१०", "content_sanskrit": "स वै पूर्वभवे राजन्मध्यदेशे महोत्तमे ।\nक्षत्रियः शूरसेनाख्यो बभूव वसुधाधिपः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002637010, "chapter_id": 22637, "verse_number": "६-१५-११", "content_sanskrit": "एकदा मृगयाकेलिलोलुपः स महीपतिः ।\nप्राप्तवानुत्पलारण्यं यत्र वाल्मीकिसंस्थितिः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002637011, "chapter_id": 22637, "verse_number": "६-१५-१२", "content_sanskrit": "चैत्रशुक्लनवम्यां तु न कृतं जीवघातनम् ।\nउत्सवं रामदिवसे चकार विधिवन्नृपः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002637012, "chapter_id": 22637, "verse_number": "६-१५-१३", "content_sanskrit": "वाल्मीकेश्च कुटीमध्ये रात्रौ जागरणं कृतम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002637013, "chapter_id": 22637, "verse_number": "६-१५-१४", "content_sanskrit": "श्रुता राममयी गाथा तस्य पुण्यप्रभावतः ।\nविद्याधरत्वमापन्नो मुमुदे तत्र शक्रवत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002637014, "chapter_id": 22637, "verse_number": "६-१५-१५", "content_sanskrit": "कल्पवृक्षस्य वै पूजा कृता तेन महात्मना ।\nवर्षांतरे द्रुमः प्राह वरं वरय सत्तम ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002637015, "chapter_id": 22637, "verse_number": "६-१५-१६", "content_sanskrit": "स तमाह महावृक्ष मदीयं नगरं शुभम् ।\nधनधान्यस मायुक्तं यथैव स्यात्तथा कुरु ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002637016, "chapter_id": 22637, "verse_number": "६-१५-१७", "content_sanskrit": "इत्युक्ते सति वृक्षेण नगरं भूपतेः समम् ।\nकृतं तदा न कोऽप्यासीद्यो मन्येत्पार्थिवाश्रयम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002637017, "chapter_id": 22637, "verse_number": "६-१५-१८", "content_sanskrit": "सर्वे ते राजतुल्याश्च कल्पवृक्षप्रसादतः ।\nतदा तौ तु पितापुत्रौ तपसोऽर्थे वनं गतौ ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002637018, "chapter_id": 22637, "verse_number": "६-१५-१९", "content_sanskrit": "मलयाद्रौ महारम्ये तेपतुर्बहुलं तपः ।\nएकस्मिन्दिवसे राजन्मलयध्वजभूपतेः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002637019, "chapter_id": 22637, "verse_number": "६-१५-२०", "content_sanskrit": "कमलाक्षीति विख्याता कन्या च शिवमंदिरे ।\nस्वसख्या सहिता प्राप्ता शिवपूजनतत्परा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002637020, "chapter_id": 22637, "verse_number": "६-१५-२१", "content_sanskrit": "जीमूतवाहनश्चैव पूजार्थे मंदिरं ययौ ।\nबालां ददर्श दिव्यांगीं सर्वभूषासमन्विताम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002637021, "chapter_id": 22637, "verse_number": "६-१५-२२", "content_sanskrit": "तस्या दर्शनमात्रेण कामबाणेन पीडितः ।\nमनसा कामदेवं तं तुष्टाव श्लक्ष्णया गिरा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002637022, "chapter_id": 22637, "verse_number": "६-१५-२३", "content_sanskrit": "जीमूतवाहन उवाच ।\nमदनाय नमस्तुभ्यं कृष्णपुत्राय ते नमः ।\nशंबरप्राणहंत्रे च चतुर्व्यूहाय ते नमः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002637023, "chapter_id": 22637, "verse_number": "६-१५-२४", "content_sanskrit": "पंचबाणाय कामाय प्रद्युम्नाय नमोनमः ।\nमद्योग्यां कुरु सुश्रोणीं कामिनीं कमलाननाम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002637024, "chapter_id": 22637, "verse_number": "६-१५-२५", "content_sanskrit": "तदा प्रसन्नो भगवान्मकरध्वजदेवता ।\nमोहयित्वा च पितरं तद्विवाहमकारयत् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002637025, "chapter_id": 22637, "verse_number": "६-१५-२६", "content_sanskrit": "विश्वावसुरिति ख्यातस्तस्य भूपस्य वै सुतः ।\nभगिनीपतिना सार्द्धं स ययौ गंधमादनम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002637026, "chapter_id": 22637, "verse_number": "६-१५-२७", "content_sanskrit": "नरं नारायणं नत्वा गरुडोत्तुंगमाययौ ।\nतदा नागस्य वै माता शंखचूडस्य भो नृप ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002637027, "chapter_id": 22637, "verse_number": "६-१५-२८", "content_sanskrit": "रुरोद बहुधा तत्र यत्र जीमूतवाहनः ।\nदुःखितः स जगामाशु दयालुर्दीनवत्सलः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002637028, "chapter_id": 22637, "verse_number": "६-१५-२९", "content_sanskrit": "वृद्धामाश्वास्य पप्रच्छ केनेदं दुःखमागतम् ।\nसाह मे तनयो देव गरुडास्ये गमिष्यति ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002637029, "chapter_id": 22637, "verse_number": "६-१५-३०", "content_sanskrit": "तद्वियोगेन दुःखार्ता विलपामि महाकुला ।\nइति ज्ञात्वा स नृपतिर्गरुडोत्तुंगमाययौ ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002637030, "chapter_id": 22637, "verse_number": "६-१५-३१", "content_sanskrit": "गरुडोऽपि गृहीत्वा तं नभोमार्गमुपागमत् ।\nतस्यांगदोऽसृजा लिप्तो न्यधात्तत्तत्र भामिनी ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002637031, "chapter_id": 22637, "verse_number": "६-१५-३२", "content_sanskrit": "कमलाक्षी तु वियति स्थितं गरुडभक्षितम् ।\nविलोक्य चारुदद्गाढं पतिदुःखेन दुःखिता ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002637032, "chapter_id": 22637, "verse_number": "६-१५-३३", "content_sanskrit": "तदा तु गरुडस्त्रस्तस्तत्रागत्य त्वरान्वितः ।\nजीमूतवाहनं प्राह कस्मात्त्वं मम भक्षितः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002637033, "chapter_id": 22637, "verse_number": "६-१५-३४", "content_sanskrit": "स होवाच प्रभो मेद्य वचः शृणु महामते ।\nशंखचूडस्य जननी महादुःखेन दुःखिता ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002637034, "chapter_id": 22637, "verse_number": "६-१५-३५", "content_sanskrit": "तस्याः पुत्रस्य रक्षार्थं संप्राप्तोऽहं तवांतिकम् ।\nइत्युक्ते सति भूपाल शंखचूडश्च पन्नगः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002637035, "chapter_id": 22637, "verse_number": "६-१५-३६", "content_sanskrit": "तद्व्यालस्यैव दुःखेन दुःखितः शत्रुमाप्तवान् ।\nमां प्रभक्ष कृपासिंधो त्वदाहारार्थमागतम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002637036, "chapter_id": 22637, "verse_number": "६-१५-३७", "content_sanskrit": "संत्यज्य मानुषं दिव्यं कुर्वाहारं महामते ।\nतदा प्रसन्नो गरुडो ददौ तस्मै वरत्रयम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002637037, "chapter_id": 22637, "verse_number": "६-१५-३८", "content_sanskrit": "जीमूतवाहनायैव विद्याधरसुताय च ।\nशंखचूडकुलं नाहं भक्षयिष्ये कदा चन ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002637038, "chapter_id": 22637, "verse_number": "६-१५-३९", "content_sanskrit": "त्वं तु विद्याधरपुरे प्राप्य राज्यं महोत्तमम् ।\nसुभोजयित्वा लक्षाब्दं ततो वैकुण्ठमेष्यसि ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002637039, "chapter_id": 22637, "verse_number": "६-१५-४०", "content_sanskrit": "इत्युक्त्वान्तर्दधौ देवः स पित्रा राज्यमाप्तवान् ।\nस्वपत्न्या सह राज्यांगं भुक्त्वा वैकुंठमाययौ ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002637040, "chapter_id": 22637, "verse_number": "६-१५-४१", "content_sanskrit": "इत्युक्त्वा स तु वैतालो नृपतिं प्राह नम्रधीः ।\nतेषां मध्ये महाराज कस्य प्राप्तं महाफलम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002637041, "chapter_id": 22637, "verse_number": "६-१५-४२", "content_sanskrit": "राजोवाच ।\nशंखचूडस्य संप्राप्तं जीवदानमहाफलम् ।\nनृपस्यैवोपकारं च स्वभावो विधिना कृतः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002637042, "chapter_id": 22637, "verse_number": "६-१५-४३", "content_sanskrit": "पतिव्रताप्रभावेन जीवदानेन भूपतेः ।\nसन्तुष्टो गरुडो जातस्तस्य किं तर्हि तत्फलम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002637043, "chapter_id": 22637, "verse_number": "६-१५-४४", "content_sanskrit": "निर्भयः शंखचूडस्तु स्वशत्रुं प्रति चागमत् ।\nशरीरमर्पयित्वा तं ततः प्राप्तं महाफलम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]