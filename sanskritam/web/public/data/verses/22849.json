[{"id": 7002849000, "chapter_id": 22849, "verse_number": "९-१३४-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nरथयात्राविधानं ते कथ यामि युधिष्ठिर ।\nस्थिरो भूत्वा निबोधेदं त्वं हि मूर्तविदां वरः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002849001, "chapter_id": 22849, "verse_number": "९-१३४-२", "content_sanskrit": "चैत्रे त्रिनेत्रसंभूतमलयाख्यमहागिरौ ।\nप्रवहत्पवनध्वानप्रेंखोलितलताचये ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002849002, "chapter_id": 22849, "verse_number": "९-१३४-३", "content_sanskrit": "एतस्मिन्नेव काले तु भ्रममाणो यदृच्छया ।\nनारदः शारदाकांताच्छिवलोके समाययौ ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002849003, "chapter_id": 22849, "verse_number": "९-१३४-४", "content_sanskrit": "दृष्ट्वापूर्वं शिवं शांतं सुरेशैः सर्वतो वृतम् ।\nप्रणम्योपाविशद्विप्रः पुरतः केशवेशयोः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002849004, "chapter_id": 22849, "verse_number": "९-१३४-५", "content_sanskrit": "तमुपासीनमालक्ष्य भगवान्भगनेत्रहा ।\nपप्रच्छाच्छादितमनाः कुतश्चागम्यते पुनः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002849005, "chapter_id": 22849, "verse_number": "९-१३४-६", "content_sanskrit": "श्रीनारद उवाच ।\nशिव कामं च तं विद्धि दग्धं मा विबुधोत्तम ।\nवसंतो नाम कोऽप्येष कामस्य दयितः सखा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002849006, "chapter_id": 22849, "verse_number": "९-१३४-७", "content_sanskrit": "मलयानिलयुक्तेन तेन विश्वं वशीकृतम् ।\nसहकारकरीन्द्रस्थं कृत्वा कोकिलडिंडिमम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002849007, "chapter_id": 22849, "verse_number": "९-१३४-८", "content_sanskrit": "पोषयामास विजयं मन्मथस्य पुरेपुरे ।\nशशांकशेखरः कोऽयं कोयं शंखगदाधरः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002849008, "chapter_id": 22849, "verse_number": "९-१३४-९", "content_sanskrit": "कोयं च डिम्बो वा ब्रह्मा कामस्त्रिजगतां प्रभुः ।\nप्रायः क्रीडारतिर्लोको वसंतवचनात्पुनः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002849009, "chapter_id": 22849, "verse_number": "९-१३४-१०", "content_sanskrit": "ऊर्ध्वबाहुस्तु नर्नर्ति तालदत्तपदक्रमः ।\nव्यवसायं न गच्छंति ये संहृत्य वनांतरम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002849010, "chapter_id": 22849, "verse_number": "९-१३४-११", "content_sanskrit": "गायंतश्च परीहृष्टास्ते चाप्यायांति यांति च ।\nगोप्यसीमांतरगताः क्षेत्रस्थानस्य रक्षिणः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002849011, "chapter_id": 22849, "verse_number": "९-१३४-१२", "content_sanskrit": "तेऽपि गायंति नृत्यंति हसंति स्मरतारकाः ।\nकरस्य ताडनेऽत्यर्थं मुरजो धुर्धरायते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002849012, "chapter_id": 22849, "verse_number": "९-१३४-१३", "content_sanskrit": "विटं पश्यंति कुलटाः प्रारब्धोचितपण्डिताः ।\nसुमनांसि सुसंगीतनृत्यवाद्यसुवादितम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002849013, "chapter_id": 22849, "verse_number": "९-१३४-१४", "content_sanskrit": "एवमेतत्त्रिलोकेऽस्मिन्निति व्यवसितो जनः ।\nललल्लम्बस्तनीं दृष्ट्वा जरा योषापि नृत्यति ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002849014, "chapter_id": 22849, "verse_number": "९-१३४-१५", "content_sanskrit": "वसंतस्य प्रभावोऽयं कोऽप्यपूर्वो विजृंभते ।\nसरांस्यद्भुतपद्मानि प्रफुल्ला पुष्पवाटिकाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002849015, "chapter_id": 22849, "verse_number": "९-१३४-१६", "content_sanskrit": "वृक्षाः पक्षिशताकीर्णा विजिघ्राणमुखाः सुराः ।\nविकंपवसनावालः पवनस्त्रिगुणात्मकः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002849016, "chapter_id": 22849, "verse_number": "९-१३४-१७", "content_sanskrit": "कृतः प्रत्यक्षसुमहान्वसंतो न जगत्त्रये ।\nअवजल्पमुखा बाला वृद्धास्तु विकलद्विजाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002849017, "chapter_id": 22849, "verse_number": "९-१३४-१८", "content_sanskrit": "उभावपि प्रतप्येते पश्येदं कामचेष्टितम् ।\nपक्षिणां पक्षनिक्षेपैर्नद्यस्तुंगतरंगकैः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002849018, "chapter_id": 22849, "verse_number": "९-१३४-१९", "content_sanskrit": "पादपाः पल्लवशतैर्नृत्यंते च प्रहर्षिणः ।\nएतच्छ्रुत्वा तु वचनं नारदस्येन्दुशेखरः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002849019, "chapter_id": 22849, "verse_number": "९-१३४-२०", "content_sanskrit": "कौतुकाकुलितः शीघ्रमारुरोह रथं स्वकम् ।\nरथेन काञ्चनांगेन पतत्रिवरकेतनः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002849020, "chapter_id": 22849, "verse_number": "९-१३४-२१", "content_sanskrit": "प्रययौ पुण्डरीकाक्षः शंखचक्रगदाधरः ।\nपारावतप्रतीकाशं चतुर्वेदमयं रथम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002849021, "chapter_id": 22849, "verse_number": "९-१३४-२२", "content_sanskrit": "आस्थाय प्रययौ हृष्टो ब्रह्मा ब्राह्मणसंस्तुतः ।\nमुनिभिश्चाप्सरोभिश्च यक्षरक्षोमहोरगैः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002849022, "chapter_id": 22849, "verse_number": "९-१३४-२३", "content_sanskrit": "वृतो रथेन प्रययौ भास्करो वारितस्करः ।\nशैलजोरुपताकेन रथेनादित्यवर्चसा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002849023, "chapter_id": 22849, "verse_number": "९-१३४-२४", "content_sanskrit": "कात्यायनी प्रचलिता पञ्चवक्त्रेण केतुना ।\nलंबोदरः करशतगृहीतकनकोत्पलः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002849024, "chapter_id": 22849, "verse_number": "९-१३४-२५", "content_sanskrit": "प्रयातः स्वरथारूढः कृतकर्णकुलाकुलः ।\nएवं देवः परिवृतो भगवान्गोवृषध्वजः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002849025, "chapter_id": 22849, "verse_number": "९-१३४-२६", "content_sanskrit": "रथारूढैरमूढात्मा मर्त्यलोकमवातरत् ।\nयावत्पश्यति देवेशस्तावत्सर्वं तदक्षरम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002849026, "chapter_id": 22849, "verse_number": "९-१३४-२७", "content_sanskrit": "नारदेन यथैवोक्तस्तावत्सर्वं तदक्षरम् ।\nनारदेन यथैवोक्तं जगदानन्दनिर्भरम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002849027, "chapter_id": 22849, "verse_number": "९-१३४-२८", "content_sanskrit": "देवैः सार्द्धं पशुपतिर्यावत्पश्यति विस्मितः ।\nतावत्तस्यैव हि गणाः परब्रह्मसमंजसम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002849028, "chapter_id": 22849, "verse_number": "९-१३४-२९", "content_sanskrit": "गायंति केचित्सोत्कंठं लुठंत्यन्ये प्रहर्षिताः ।\nवादयंत्यपरे तुष्टा जहसुः केचिदुल्बणम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002849029, "chapter_id": 22849, "verse_number": "९-१३४-३०", "content_sanskrit": "वादयंत्यन्यथा वाद्यं गायंत्यन्येन्यथा गणाः ।\nअन्येन्यथा प्रनृत्यंति चित्रं चैत्रस्य चेष्टितम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002849030, "chapter_id": 22849, "verse_number": "९-१३४-३१", "content_sanskrit": "नीलोत्पलाभनयनैर्विलसत्प्रांततारकैः ।\nक्रीडारतिभिरारब्धमालापैश्च सुरैरपि ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002849031, "chapter_id": 22849, "verse_number": "९-१३४-३२", "content_sanskrit": "सुराणां क्षोभमालक्ष्य भगवान्गोवृषध्वजः ।\nचिन्तयामास सुमहान्कार्ययोगो ह्युपस्थितः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002849032, "chapter_id": 22849, "verse_number": "९-१३४-३३", "content_sanskrit": "अनर्थमुत्थितं तद्वत्तद्विघाताय ये जनाः ।\nनयंते येऽतिमूर्खत्वादापदोऽभिभवंति तान् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002849033, "chapter_id": 22849, "verse_number": "९-१३४-३४", "content_sanskrit": "वसंतः स्वामिभक्तत्वान्मान्यपुष्पाकरं यदा ।\nउन्मादाढ्यजनो रक्ष्यः कार्यं कार्यद्वयं मम ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002849034, "chapter_id": 22849, "verse_number": "९-१३४-३५", "content_sanskrit": "संचिंत्यैवं समानाय्य वसंतं प्राह शंकरः ।\nसमानीतो मासमेकं स्थातव्यं भवता त्विह ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002849035, "chapter_id": 22849, "verse_number": "९-१३४-३६", "content_sanskrit": "सितपक्षः सहायोऽयं सर्वभूतसुखप्रदः ।\nभवत्यतिमहानन्दो विशेषेण दिवौकसाम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002849036, "chapter_id": 22849, "verse_number": "९-१३४-३७", "content_sanskrit": "यो यथा रथमारूढः समायातः समीक्षितुम् ।\nवर्षेवर्षे स तेनैव संस्थानेनागमिष्यति ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002849037, "chapter_id": 22849, "verse_number": "९-१३४-३८", "content_sanskrit": "कारयिष्यन्ति ये मर्त्या रथयात्रामहोत्सवम् ।\nते दिव्यभोगभोक्तारो भविष्यन्ति निरामयाः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002849038, "chapter_id": 22849, "verse_number": "९-१३४-३९", "content_sanskrit": "एवमाभाष्य भगवान्वसंतं च ततः सुरैः ।\nसंस्तुतोऽथ नतश्चापि स्वस्थानमगमत्ततः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002849039, "chapter_id": 22849, "verse_number": "९-१३४-४०", "content_sanskrit": "युधिष्ठिर उवाच ।\nरथः किमात्मकः कार्यः कार्या यात्रा कथं भवेत् ।\nआरोपयेत्कथं देवान्रथे वद जगत्पते ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002849040, "chapter_id": 22849, "verse_number": "९-१३४-४१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nसुविचित्रं चित्रतनुं श्रेष्ठकाष्ठमयं रथम् ।\nसुदृढाक्षं दृढाबंधं सुचक्ररथकूबरम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002849041, "chapter_id": 22849, "verse_number": "९-१३४-४२", "content_sanskrit": "अथ वा वंशविहितं नेत्रपट्टपटावृतम् ।\nतारकाशतचित्रांशं पुष्पमालाविभूषितम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002849042, "chapter_id": 22849, "verse_number": "९-१३४-४३", "content_sanskrit": "सितगोयुगसंयुक्तं पञ्चबाणपताकिनम् ।\nछत्रचामरशोभाढ्यं स्थापयेद्भवनाङ्गणे ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002849043, "chapter_id": 22849, "verse_number": "९-१३४-४४", "content_sanskrit": "वैश्वदेवं ततः कुर्याद्ग्रहयज्ञविधानतः ।\nचतुश्चरणकैर्मंत्रैर्विप्र शान्तिकपौष्टिकैः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002849044, "chapter_id": 22849, "verse_number": "९-१३४-४५", "content_sanskrit": "आरोपयेद्रथे देवं मूलमंत्रेण मंत्रवित् ।\nवेदोक्तैरथपौराणैर्गंधधूपाधिवासिते ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002849045, "chapter_id": 22849, "verse_number": "९-१३४-४६", "content_sanskrit": "रथे तिष्ठन्नयति वाजिनः पुरो यत्रयत्र कामयते सुषारथिः ।\nअभीषूणां महिमानं पनायत मनुः पश्चादनुयच्छन्ति रश्मयः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002849046, "chapter_id": 22849, "verse_number": "९-१३४-४७", "content_sanskrit": "शंखदुंदुभिनिर्घोषैः काहलानां च निःस्वनैः ।\nहस्तदीपैः प्रज्वलितैस्तालकोलाहा लेन च ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002849047, "chapter_id": 22849, "verse_number": "९-१३४-४८", "content_sanskrit": "दोषासुखेन रमितं प्रेषणीयपुरःसरम् ।\nमहतोत्सवभारेण भ्रामयेत्परितो रथम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002849048, "chapter_id": 22849, "verse_number": "९-१३४-४९", "content_sanskrit": "तांबूलानि रथे दद्यात्पुष्पमालायुतानि च ।\nरथवोढ्रं प्रदद्यात्तु प्रेक्षकेभ्योऽप्यवारितम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002849049, "chapter_id": 22849, "verse_number": "९-१३४-५०", "content_sanskrit": "यस्ययस्य गृहेभ्येति प्रेरितो रथिना रथः ।\nतस्य तस्य भवेत्पूज्यः पुष्पधूपाक्षतादिभिः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002849050, "chapter_id": 22849, "verse_number": "९-१३४-५१", "content_sanskrit": "इतरोऽपि भवेत्पूज्यः संप्राप्ते गृहिणां गृहे ।\nकिं पुनर्जगतां भर्ता सर्वलोकमहेश्वरः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002849051, "chapter_id": 22849, "verse_number": "९-१३४-५२", "content_sanskrit": "कदाचिदक्षभङ्गः स्याद्ध्वजभंगोऽथ वा भवेत् ।\nभज्येत वा युगमध्ये नहनं त्रुट्यते यदि ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002849052, "chapter_id": 22849, "verse_number": "९-१३४-५३", "content_sanskrit": "ब्राह्मणांस्तत्र संपूज्य होमः कार्यो विजानता ।\nतिलैराज्येन पयसा येन संपद्यते सुखम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002849053, "chapter_id": 22849, "verse_number": "९-१३४-५४", "content_sanskrit": "प्रेरणीप्रेक्षणीयैश्च भ्रामयित्वा रथोत्तमम् ।\nस्थापयेन्नगरस्यांतस्तत्र कुर्यान्महोत्सवम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002849054, "chapter_id": 22849, "verse_number": "९-१३४-५५", "content_sanskrit": "दोलाग्राहैश्चक्रदोलाभ्रमैर्डमरकैस्तथा ।\nविद्याधरीणां चरितमितराभिः प्रकाश्यते ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002849055, "chapter_id": 22849, "verse_number": "९-१३४-५६", "content_sanskrit": "एवं यः कुरुते पार्थ सुखदं तु रथोत्सवम् ।\nतथैव पूजयेत्पार्थ उपवासपरो नरः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002849056, "chapter_id": 22849, "verse_number": "९-१३४-५७", "content_sanskrit": "सर्वव्याधिविहीनश्च सुखी स्याच्छरदां शतम् ।\nयः कारयित्वा सौवर्णं रौप्यं वा रथमुत्तमम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002849057, "chapter_id": 22849, "verse_number": "९-१३४-५८", "content_sanskrit": "वर्णकैश्चित्रितं दिव्यं दारुजं वा सुशोभनम् ।\nस्वहस्तरचितं यश्च भास्कराय निवेदयेत् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002849058, "chapter_id": 22849, "verse_number": "९-१३४-५९", "content_sanskrit": "स मर्त्यलोके सुचिरात्सुखानि च समश्नुते ।\nपूर्वोक्तविधिना भानुं भ्रामयित्वा रथे स्थितम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002849059, "chapter_id": 22849, "verse_number": "९-१३४-६०", "content_sanskrit": "स्थापयेत्सर्वभागे तु गेयं वाद्यपुरःसरम् ।\nदक्षिणे तु दिशो भागे द्वितीयेऽह्नि नयेद्रथम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002849060, "chapter_id": 22849, "verse_number": "९-१३४-६१", "content_sanskrit": "तत्रापि जागरं कुर्याद्वाद्यगीतसुमं गलैः ।\nअपरायां तृतीयेऽह्नि स्थापयेद्रथमुत्तमम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002849061, "chapter_id": 22849, "verse_number": "९-१३४-६२", "content_sanskrit": "प्रेक्षणीयविनोदेन तां रात्रिमतिवाहयेत् ।\nस्थापयेदुत्तरस्यां तु चतुर्थे दिवसे रथम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002849062, "chapter_id": 22849, "verse_number": "९-१३४-६३", "content_sanskrit": "महायात्रां प्रकुर्वीत तत्राप्यद्भुतचेष्टितम् ।\nपंचमे दिवसे प्राप्ते नगरांतस्थितं रविम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002849063, "chapter_id": 22849, "verse_number": "९-१३४-६४", "content_sanskrit": "पूजयित्वा विधानेन षष्ठेऽह्नि भवनं नयेत् ।\nरथयात्राप्रसंगेन कथिता रथसप्तमी ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002849064, "chapter_id": 22849, "verse_number": "९-१३४-६५", "content_sanskrit": "सर्वपापहरा पुण्या किञ्चिदन्यन्निबोध मे ।\nगौरी पूज्या तृतीयायां चतुर्थ्यां विघ्ननायकः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002849065, "chapter_id": 22849, "verse_number": "९-१३४-६६", "content_sanskrit": "पञ्चम्यां पंकजकरां पूजयेद्वा सरस्वतीम् ।\nषष्ठ्यां शक्तिधरं स्कन्दं सप्तम्यां तु दिवाकरम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7002849066, "chapter_id": 22849, "verse_number": "९-१३४-६७", "content_sanskrit": "अष्टम्यां च चतुर्दश्यां सम्पूज्यः शशिशेखरः ।\nनवम्यां पूजयेच्चण्डीं चामुण्डां मुण्डमालिनीम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7002849067, "chapter_id": 22849, "verse_number": "९-१३४-६८", "content_sanskrit": "दशम्यामृषयः शांताः सर्वे व्यासपुरस्सराः ।\nएकादश्यां चक्रपाणिं द्वादश्यां वा समर्चयेत् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7002849068, "chapter_id": 22849, "verse_number": "९-१३४-६९", "content_sanskrit": "त्रयोदश्यां त्रिनेत्रोत्थवह्निना शांतविग्रहम् ।\nसाधारणी तु सर्वेषां पौर्णमासी तिथिः स्मृता ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7002849069, "chapter_id": 22849, "verse_number": "९-१३४-७०", "content_sanskrit": "आंदोलके मदनके रथयात्रासु चैव हि ।\nव्युत्क्रमेणापि कर्तव्या तिथीनां कार्यगौरवात् ।\nयात्रा वासंतिकी चेयं चित्तस्वास्थ्यकरी परा ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7002849070, "chapter_id": 22849, "verse_number": "९-१३४-७१", "content_sanskrit": "सम्यक्सुधाधवलिते भवने सुराणामंतस्सुवस्त्रमणिमौक्तिकदानचित्रे ।\nतांबूलकक्रमुकवारविलासिनीभिर्यात्रां विधाय भवतीह स भारतेशः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]