[{"id": 2099530, "chapter_id": 3129, "verse_number": "१३-२५९-१", "content_sanskrit": "वायुरुवाच।\nइमां भूमिं द्विजातिभ्यो दित्सुर्वै दक्षिणां पुरा।\nअङ्गो नाम नृपो राजंस्ततश्चिन्तां मही ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2099531, "chapter_id": 3129, "verse_number": "१३-२५९-२", "content_sanskrit": "धारिणीं सर्वभूतानामयं प्राप्य वरो नृपः।\nकथमिच्छति मां दातुं द्विजेभ्यो ब्रह्मणः सुताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2099532, "chapter_id": 3129, "verse_number": "१३-२५९-३", "content_sanskrit": "साहं त्यक्त्वा गमिष्यामि भूमित्वं ब्रह्मणः पदम्।\nअयं सराष्ट्रो नृपतिर्मार्भूदिति ततोऽगमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2099533, "chapter_id": 3129, "verse_number": "१३-२५९-४", "content_sanskrit": "ततस्तां कश्यपो दृष्ट्वा व्रजन्तीं पृथिवीं तदा।\nप्रविवेश महीं सद्यो युक्तात्मा सुसमाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2099534, "chapter_id": 3129, "verse_number": "१३-२५९-५", "content_sanskrit": "ऋद्धा सा सर्वतो जज्ञे तृणौषधिसमन्विता।\nधर्मोत्तरा नष्टभया भूमिरासीत्तमतो नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2099535, "chapter_id": 3129, "verse_number": "१३-२५९-६", "content_sanskrit": "एवं वर्षसहस्राणि दिव्यानि विपुलव्रतः।\nत्रिंशतं कश्यपो राजन्भूमिरासीदतन्द्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2099536, "chapter_id": 3129, "verse_number": "१३-२५९-७", "content_sanskrit": "अथागम्य महाराजन्नमस्कृत्यि च कश्यपम्।\nपृथवी काश्यपी जज्ञे सुता तस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2099537, "chapter_id": 3129, "verse_number": "१३-२५९-८", "content_sanskrit": "एष राजन्नीदृशो वै ब्राह्मणः कश्यपोऽभवत्।\nअन्यं प्रब्रूहि वा त्वं च कश्यपात्क्षत्रियं वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2099538, "chapter_id": 3129, "verse_number": "१३-२५९-९", "content_sanskrit": "तूष्णीं बभूव नृपतिः पवनस्त्वब्रवीद्वचः।\nशृणु राजन्नुचक्ष्यस्य जातस्याङ्गिरसे कुले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2099539, "chapter_id": 3129, "verse_number": "१३-२५९-१०", "content_sanskrit": "भद्रा सोमस्य दुहिता रूपेण परमा मता।\nतस्यास्तुल्यं पतिं सोम उचथ्यं समपश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2099540, "chapter_id": 3129, "verse_number": "१३-२५९-११", "content_sanskrit": "सा च तीव्रं तपस्तेपे महाभागा यशस्विनी।\nउचथ्यं तु महाभागं तत्कृते वरयत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2099541, "chapter_id": 3129, "verse_number": "१३-२५९-१२", "content_sanskrit": "तत आहूय चोचथ्यं ददामीति यशस्विनीम्।\nभार्यार्थे स च जग्राह विधिवद्भूरिदक्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2099542, "chapter_id": 3129, "verse_number": "१३-२५९-१३", "content_sanskrit": "तां त्वकामयत श्रीमान्वरुणः पूर्वमेव ह।\nस चागम्य वनप्रस्थं यमुनायां जहार ताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2099543, "chapter_id": 3129, "verse_number": "१३-२५९-१४", "content_sanskrit": "जलेश्वरस्तु हृत्वा तामनयस्त्वं पुरं प्रति।\nपरमाद्भुतसङ्काशं षट्सहस्रशतह्रदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2099544, "chapter_id": 3129, "verse_number": "१३-२५९-१५", "content_sanskrit": "न हि रम्यतरं किञ्चित्तस्मादन्यत्पुरोत्तमम्।\nवासादैरप्सरोभिश्च दिव्यैः कामैश्च शोभितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2099545, "chapter_id": 3129, "verse_number": "१३-२५९-१६", "content_sanskrit": "तत्र देवस्तया सार्धं रेमे राजञ्जलेश्वरः।\nतदाख्यातमुचथ्याय ततः पत्न्यवमर्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2099546, "chapter_id": 3129, "verse_number": "१३-२५९-१७", "content_sanskrit": "तच्छ्रुत्वा नारदात्सर्वमुचथ्यो नारदं तदा।\nप्रोवाच गच्छ ब्रूहि त्वं वरुणं परुषं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2099547, "chapter_id": 3129, "verse_number": "१३-२५९-१८", "content_sanskrit": "मद्वाक्यान्मुञ्च मे भार्यां कस्मात्तां हृतवानसि।\nलोकपालोसि लोकानां न लोकस्य विलोपकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2099548, "chapter_id": 3129, "verse_number": "१३-२५९-१९", "content_sanskrit": "सोमेन दत्ता भार्या मे त्वया चापहृताऽद्य वै।\nइत्युक्तो वचनात्तस्य नारदेन जलेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2099549, "chapter_id": 3129, "verse_number": "१३-२५९-२०", "content_sanskrit": "मुञ्च भार्यामुचथ्यस्य कस्मात्त्वं हृतवानसि।\nइति श्रुत्वा वचस्तस्य सोऽथ तं वरुणोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2099550, "chapter_id": 3129, "verse_number": "१३-२५९-२१", "content_sanskrit": "ममैषा सुप्रिया भार्या नैनामुत्स्रष्टुमुत्सहे।\nइत्युक्तो वरुणेनाथ नारदः प्राप्य तं मुनिम्।\nउचथ्यमब्रवीद्वाक्यं नातिहृष्टमना इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2099551, "chapter_id": 3129, "verse_number": "१३-२५९-२२", "content_sanskrit": "गले गृहीत्वा क्षिप्तोस्मि वरुणेन महामुने।\nन प्रयच्छति ते भार्यां यत्ते कार्यं कुरुष्व तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2099552, "chapter_id": 3129, "verse_number": "१३-२५९-२३", "content_sanskrit": "नारदस्य वचः श्रुत्वा क्रुद्धः प्राज्वलदङ्गिराः।\nअपिबत्तेजसा वारि विष्टभ्य सुमहातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2099553, "chapter_id": 3129, "verse_number": "१३-२५९-२४", "content_sanskrit": "पीयमाने तु सर्वस्मिंस्तोयेऽपि सलिलेश्वरः।\nसुहृद्भिर्भिक्षमाणोऽपि नैवामुञ्चत तां तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2099554, "chapter_id": 3129, "verse_number": "१३-२५९-२५", "content_sanskrit": "ततः क्रुद्धोऽब्रवीद्भूमिमुचथ्यो ब्राह्मणोत्तमः।\nदर्शय स्वस्थलं भद्रे षट्सहस्रशतह्रदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2099555, "chapter_id": 3129, "verse_number": "१३-२५९-२६", "content_sanskrit": "ततस्तदीरणं जातं समुद्रस्यावसर्पतः।\nतस्माद्देशान्नदीं चैव प्रोवाचासौ द्विजोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2099556, "chapter_id": 3129, "verse_number": "१३-२५९-२७", "content_sanskrit": "अदृश्या गच्छ भीरु त्वं सरस्वति मरून्प्रति।\nअणुण्यभूषो भवतु देशस्त्यक्तस्तया शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2099557, "chapter_id": 3129, "verse_number": "१३-२५९-२८", "content_sanskrit": "ततश्चूर्णीकृते देशेक भद्रामादाय वारिपः।\nअददाच्छरणं गत्वा भार्यामाङ्गिरसाय वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2099558, "chapter_id": 3129, "verse_number": "१३-२५९-२९", "content_sanskrit": "प्रतिगृह्य तु तां भार्यामुचथ्यः सुमनाऽभवत्।\nमुमोच च जगद्दुःखान्मरुतश्चैव निर्मलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2099559, "chapter_id": 3129, "verse_number": "१३-२५९-३०", "content_sanskrit": "ततः स लब्ध्वा तां भार्यां वरुणं प्राह धर्मवित्।\nउचथ्यः सुमहातेजा यत्तुच्छृणु नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2099560, "chapter_id": 3129, "verse_number": "१३-२५९-३१", "content_sanskrit": "मयैषा तपसा प्राप्ता क्रोशतस्ते जलाधिप।\nइत्युक्त्वा तामुपादाय स्वमेव भवनं ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2099561, "chapter_id": 3129, "verse_number": "१३-२५९-३२", "content_sanskrit": "एष राजन्नीदृशो वै उचथ्यो ब्राह्मणर्षभः।\nब्रवीमि हान्यं ब्रूहि त्वमुचथ्यात्क्षत्रियं वरम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2099562, "chapter_id": 3129, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकोनषष्ट्यधिकद्विशततमोऽध्यायः॥ २५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]