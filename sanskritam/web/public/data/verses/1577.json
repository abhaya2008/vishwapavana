[{"id": 2026945, "chapter_id": 1577, "verse_number": "३-२१५-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2026946, "chapter_id": 1577, "verse_number": "३-२१५-१", "content_sanskrit": "एवमुक्तः स विप्रस्तु धर्मव्याधेन भारत।\nकथामकथयद्भूयो मनसः प्रीतिवर्धनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2026947, "chapter_id": 1577, "verse_number": "३-२१५-२x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2026948, "chapter_id": 1577, "verse_number": "३-२१५-२", "content_sanskrit": "महाभूतानि यान्याहुः पञ्च धर्मविदांवर।\nएकैकस्य गुणान्सम्यक्पञ्चानामपि मे वद ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2026949, "chapter_id": 1577, "verse_number": "३-२१५-३x", "content_sanskrit": "व्याध उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2026950, "chapter_id": 1577, "verse_number": "३-२१५-३", "content_sanskrit": "भूमिरापस्तथा ज्योतिर्वायुराकाशमेव च।\nगुणोत्तराणइ सर्वाणि तेषां वक्ष्यामि ते गुणान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2026951, "chapter_id": 1577, "verse_number": "३-२१५-४", "content_sanskrit": "भूमिः पञ्चगुणा ब्रह्मननुदकं च चतुर्गुणम्।\nगुणास्त्रयस्तेजसि च त्रयश्चाकाशवातयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2026952, "chapter_id": 1577, "verse_number": "३-२१५-५", "content_sanskrit": "शब्दः स्पर्शश्च रूपं च रसो गन्धश्च पञ्चमः।\nएतेगुणाः पञ्च भूमेः सर्वेभ्यो गुणवत्तराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2026953, "chapter_id": 1577, "verse_number": "३-२१५-६", "content_sanskrit": "शब्दः स्पर्शश्च रूपं च सरश्चापि द्विजोत्तम।\nअपामेते गुणा ब्रह्मन्कीर्तितास्तव सुव्रत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2026954, "chapter_id": 1577, "verse_number": "३-२१५-७", "content_sanskrit": "शब्दः स्पर्शश्च रूपं च तेजसोऽथ गुणास्त्रयः।\nशब्दः स्पर्शश्च वायौ तु शब्दश्चाकाश एव तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2026955, "chapter_id": 1577, "verse_number": "३-२१५-८", "content_sanskrit": "एते पञ्चदश ब्रह्मन्गुणा भूतेषु पञ्चसु।\nवर्तन्ते सर्वभूतेषु येषु लोकाः प्रतिष्ठिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2026956, "chapter_id": 1577, "verse_number": "३-२१५-९", "content_sanskrit": "अन्योन्यं नातिवर्तन्ते सम्यक्व भवति द्विज।\nयदा तु विषमं भावमाचरन्ति चराचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2026957, "chapter_id": 1577, "verse_number": "३-२१५-१०", "content_sanskrit": "तदा देही देहमन्यं व्यतिरोहति कालतः।\nप्रातिलोम्याद्विनश्यन्ति जायन्ते चानुपूर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2026958, "chapter_id": 1577, "verse_number": "३-२१५-११", "content_sanskrit": "तत्र तत्रहि दृश्यन्ते धातवः पाञ्चभौतिकाः।\nयैरावृतमिदं सर्वं जगत्स्थावरजङ्गमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2026959, "chapter_id": 1577, "verse_number": "३-२१५-१२", "content_sanskrit": "इन्द्रियैर्गृह्यते यद्यत्तत्तद्व्यक्तमिति स्मृतम्।\nतदव्यक्तमिति ज्ञेयं लिङ्गग्राह्यमतीन्द्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2026960, "chapter_id": 1577, "verse_number": "३-२१५-१३", "content_sanskrit": "यथास्वं ग्राहकान्येषां शब्दादीनामिमानि तु।\nइन्द्रियाणि तथा देही धारयन्निह तप्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2026961, "chapter_id": 1577, "verse_number": "३-२१५-१४", "content_sanskrit": "लोके विततमात्मानं लोकं चात्मनि पश्यति।\nपरापरज्ञः सक्तः सन्स तु भूतानि पश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2026962, "chapter_id": 1577, "verse_number": "३-२१५-१५", "content_sanskrit": "पश्यतः सर्वभूतानि सर्वावस्थासु सर्वदा।\nब्रह्मभूतस् संयोगो नाशुभेनोपपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2026963, "chapter_id": 1577, "verse_number": "३-२१५-१६", "content_sanskrit": "ज्ञानमूलात्मकं क्लेशमतिवृत्तस्य मोहजम्।\nलोकबुद्धिप्रकाशेन ज्ञेयमार्गेण गम्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2026964, "chapter_id": 1577, "verse_number": "३-२१५-१७", "content_sanskrit": "अनादिनिधनं जन्तुमात्मयोनिं सदाव्ययम्।\nअनौपम्यममूर्तं च भगवानाह बुद्धिमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2026965, "chapter_id": 1577, "verse_number": "३-२१५-१८", "content_sanskrit": "तपोमूलमिदं सर्वं यन्मां विप्रानुपृच्छसि।\n`तपसा हि समाप्नोति यद्यदेवाभिवाञ्छति।\nइन्द्रियाण्येव संयम्य तपो भवति नान्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2026966, "chapter_id": 1577, "verse_number": "३-२१५-१९", "content_sanskrit": "इन्द्रियाण्येव तत्सर्वंयत्स्वर्गनरकावुभौ।\nनिगृहीतविसृष्टानि स्वर्गाय नरकाय च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2026967, "chapter_id": 1577, "verse_number": "३-२१५-२०", "content_sanskrit": "एष योगविधिः कृत्स्नो यावदिन्द्रियधारणम्।\nएतन्मूलं हि तपसः स्वर्गस्य नरकस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2026968, "chapter_id": 1577, "verse_number": "३-२१५-२१", "content_sanskrit": "इन्द्रियाणां प्रसङ्गेन दोमार्च्छत्यसंशयम्।\nसन्नियम्य तु तान्येव ततः सिद्धिं समाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2026969, "chapter_id": 1577, "verse_number": "३-२१५-२२", "content_sanskrit": "षण्णामात्प्रनि योज्यानामैश्वर्यं योऽधितिष्ठति।\nन स पापैः कुतोऽनर्थैर्युज्यते विजितेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2026970, "chapter_id": 1577, "verse_number": "३-२१५-२३", "content_sanskrit": "रथः शरीरं पुरुषस्य दृष्ट-\nमात्मा नियन्तेन्द्रियाण्याहुरश्वान्।\nतैरप्रमत्तः कुशली सदश्वै-\nर्दान्त सुखं याति रथीव धीरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2026971, "chapter_id": 1577, "verse_number": "३-२१५-२४", "content_sanskrit": "षण्णामात्मनियुक्तानामिन्द्रियाणां प्रमाथिनाम्।\nयो धीरो धारयेद्रश्मीन्स स्यात्परमसारथिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2026972, "chapter_id": 1577, "verse_number": "३-२१५-२५", "content_sanskrit": "इन्द्रियाणां प्रसृष्टानां हयानामिव वर्त्मसु।\nधृतिं कुर्वीत सारथ्ये धृत्या तानि जयेद्ध्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2026973, "chapter_id": 1577, "verse_number": "३-२१५-२६", "content_sanskrit": "इन्द्रियाणां विचरतां यन्मनोऽनुविधीयते।\nतदस् हरते बुद्धिं नावं वायुरिवाम्भसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2026974, "chapter_id": 1577, "verse_number": "३-२१५-२७", "content_sanskrit": "येषु विप्रतिपद्यन्ते षट्स्वमोहात्फलागमम्।\nतेष्वध्यवसिताध्यायी विन्दते ध्यानजं फलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2026975, "chapter_id": 1577, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि मार्कण्डेयसमास्यापर्वणि पञ्चदशाधिकद्विशततमोऽध्यायः ॥ २१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]