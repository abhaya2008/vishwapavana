[{"id": 7004070000, "chapter_id": 24070, "verse_number": "४-१९-१", "content_sanskrit": "शिवशर्मोवाच ।\nतिष्ठन्नेकेन पादेन कोयं भ्रमति सत्तमौ ।\nअनेकरशनाव्यग्र हस्ताग्रो व्यग्रलोचनः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004070001, "chapter_id": 24070, "verse_number": "४-१९-२", "content_sanskrit": "त्रिलोकीमंडपस्तंभ सन्निभोभाभिरावृतः ।\nअतुलं ज्योतिषां राशिं तुलया तुलयन्निव ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004070002, "chapter_id": 24070, "verse_number": "४-१९-३", "content_sanskrit": "सूत्रधार इव व्योम व्यायामपरिमापकः ।\nत्रैविक्रमोंघ्रिदंडो वा प्रोद्दंडो गगनांगणे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004070003, "chapter_id": 24070, "verse_number": "४-१९-४", "content_sanskrit": "अथवांबरकासारसारयूपस्वरूपधृक् ।\nकोयं कथय तं देवौ कृपया परया मम ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004070004, "chapter_id": 24070, "verse_number": "४-१९-५", "content_sanskrit": "निशम्येति वचस्तस्य वयस्यस्य विमानगौ ।\nप्रणयादाहतुस्तस्मै ध्रुवां ध्रुवकथां गणौ ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004070005, "chapter_id": 24070, "verse_number": "४-१९-६", "content_sanskrit": "गणावूचतुः ।\nमनोः स्वायंभुवस्यासीदुत्तानचरणः सुतः ।\nतस्य क्षितिपतेर्विप्र द्वौ सुतौ संबभूवतुः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004070006, "chapter_id": 24070, "verse_number": "४-१९-७", "content_sanskrit": "सुरुच्यामुत्तमो ज्येष्ठः सुनीत्यां तु ध्रुवो परः ।\nमध्ये सभं नरपतेरुपविष्टस्य चैकदा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004070007, "chapter_id": 24070, "verse_number": "४-१९-८", "content_sanskrit": "सुनीत्या राजसेवायै नियुक्तोऽलंकृतोर्भकः ।\nध्रुवो धात्रेयिकापुत्रैः समं विनयतत्परः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004070008, "chapter_id": 24070, "verse_number": "४-१९-९", "content_sanskrit": "स गत्वोत्तानचरणं क्षोणीशं प्रणनाम ह ।\nदृष्ट्वोत्तमं तदुत्संगे निविष्टं जनकस्य वै ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004070009, "chapter_id": 24070, "verse_number": "४-१९-१०", "content_sanskrit": "प्रोच्चसिंहासनस्थस्य नृपतेर्बाल्यचापलात् ।\nआरोढुकामस्त्वभवत्सौनीतेयस्तदा ध्रुवः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004070010, "chapter_id": 24070, "verse_number": "४-१९-११", "content_sanskrit": "आरुरुक्षुमवेक्ष्यामुं सुरुचिर्धुवमब्रवीत् ।\nदौर्भगेय किमारोढुमिच्छेरंकं महीपतेः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004070011, "chapter_id": 24070, "verse_number": "४-१९-१२", "content_sanskrit": "बालबालिशबुद्धित्वादभाग्या जठरोद्भव ।\nअस्मिन्सिंहासने स्थातुं न त्वया सुकृतं कृतम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004070012, "chapter_id": 24070, "verse_number": "४-१९-१३", "content_sanskrit": "यदि स्यात्सुकृतं तत्किं दुर्भगोदरगोऽभवः ।\nअनेनैवानुमानेन बुध्यस्व स्वाल्पपुण्यताम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004070013, "chapter_id": 24070, "verse_number": "४-१९-१४", "content_sanskrit": "भूत्वा राजकुमारोपि नालंकुर्या ममोदरम् ।\nसुकुक्षिजममुं पश्य त्वमुत्तममनुत्तमम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004070014, "chapter_id": 24070, "verse_number": "४-१९-१५", "content_sanskrit": "अधिजानुधराजानेर्मानेन परिबृंहितम् ।\nप्रांशोः सिंहासनस्यास्य रुचिश्चेदधिरोहणे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004070015, "chapter_id": 24070, "verse_number": "४-१९-१६", "content_sanskrit": "कुक्षिं हित्वा किमवसः सुरुचेश्च सुरोचिषम् ।\nमध्ये भूपसभं बालस्तयेति परिभर्त्सितः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004070016, "chapter_id": 24070, "verse_number": "४-१९-१७", "content_sanskrit": "पतन्निपीतबाष्पांबुर्धैर्यात्किंचिन्न चोक्तवान् ।\nउचिताऽनुचितं किंचिन्नोचिवान्सोपि पार्थिवः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004070017, "chapter_id": 24070, "verse_number": "४-१९-१८", "content_sanskrit": "नियंत्रितो महिष्याश्च तस्याः सौभाग्यगौरवात् ।\nविमृज्य च सभालोकं शोकं संमृज्य चेष्टितैः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004070018, "chapter_id": 24070, "verse_number": "४-१९-१९", "content_sanskrit": "शैशवैः स शिशुर्नत्वा नृपं स्वसदनं ययौ ।\nसुनीतिर्नीतिनिलयमवलोक्याथ बालकम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004070019, "chapter_id": 24070, "verse_number": "४-१९-२०", "content_sanskrit": "सुखलक्ष्म्यैवचाज्ञासीद्ध्रुवं समवमानितम् ।\nअभिसृत्य च तं बालं मूर्ध्न्युपाघ्राय सा सकृत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004070020, "chapter_id": 24070, "verse_number": "४-१९-२१", "content_sanskrit": "किंचित्परिम्लानमिव ससांत्वं परिषस्वजे ।\nअथ दृष्ट्वा सुनीतिं स रहोंतः पुरवासिनीम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004070021, "chapter_id": 24070, "verse_number": "४-१९-२२", "content_sanskrit": "दीर्घं निःश्वस्य बहुशो मातुरग्रे रुरोद ह ।\nसांत्वयित्वाश्रुनयना वदनं परिमार्ज्य च ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004070022, "chapter_id": 24070, "verse_number": "४-१९-२३", "content_sanskrit": "दुकूलांचल संपर्कैर्मृदुलैर्मृदुपाणिना ।\nपप्रच्छ तनयं माता वद रोदनकारणम् ।\nविद्यमाने नरपतौ शिशो केनापमानितः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004070023, "chapter_id": 24070, "verse_number": "४-१९-२४", "content_sanskrit": "अपोथसमुपस्पृश्य तांबूलं परिगृह्य च ।\nमात्रा पृष्टः सोपरोधं ध्रुवस्तां पर्यभाषत ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004070024, "chapter_id": 24070, "verse_number": "४-१९-२५", "content_sanskrit": "संपृच्छे जननि त्वाहं सम्यक्शंस ममाग्रतः ।\nभार्यात्वेपि च सामान्ये कथं सा सुरुचिः प्रिया ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004070025, "chapter_id": 24070, "verse_number": "४-१९-२६", "content_sanskrit": "कथं न भवती मातः प्रिया क्षितिपतेरसि ।\nकथमुत्तमतां प्राप्त उत्तमः सुरुचेः सुतः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004070026, "chapter_id": 24070, "verse_number": "४-१९-२७", "content_sanskrit": "कुमारत्वेपि सामान्ये कथं त्वहमनुत्तमः ।\nकथं त्वं मंदभाग्यासि सुकुक्षिः सुरुचिः कथम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004070027, "chapter_id": 24070, "verse_number": "४-१९-२८", "content_sanskrit": "कथं नृपासनं योग्यमुत्तमस्य कथं न मे ।\nकथं मे सुकृतं तुच्छमुत्तमस्योत्तमं कथम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004070028, "chapter_id": 24070, "verse_number": "४-१९-२९", "content_sanskrit": "इति श्रुत्वा वचस्तस्य सुनीतिर्नीतिमच्छिशोः ।\nकिंचिदुच्छ्वस्य शनकैः शिशुकोपोपशांतये ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004070029, "chapter_id": 24070, "verse_number": "४-१९-३०", "content_sanskrit": "स्वभावमधुरां वाणीं वक्तुं समुपचक्रमे ।\nसापत्नं प्रतिघं त्यक्त्वा राजनीतिविदांवरा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004070030, "chapter_id": 24070, "verse_number": "४-१९-३१", "content_sanskrit": "सुनीतिरुवाच ।\nअयि तात महाबुद्धे विशुद्धेनांतरात्मना ।\nनिवेदयामि ते सर्वं माऽपमाने मतिं कृथाः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004070031, "chapter_id": 24070, "verse_number": "४-१९-३२", "content_sanskrit": "तया यदुक्तं तत्सर्वं तथ्यमेव न चान्यथा ।\nसापत्युर्महिषीराज्ञो राज्ञीनामति वल्लभा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004070032, "chapter_id": 24070, "verse_number": "४-१९-३३", "content_sanskrit": "तया जन्मांतरे तात यत्पुण्यं समुपार्जितम् ।\nतत्पुण्योपचयाद्राजा सुरुच्यां सुरुचिर्भृशम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004070033, "chapter_id": 24070, "verse_number": "४-१९-३४", "content_sanskrit": "मादृश्यो मंदभाग्यायाः प्रमदासु प्रतिष्ठिताः ।\nकेवलं राजपत्नीत्ववादस्तासु न तद्रुचिः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004070034, "chapter_id": 24070, "verse_number": "४-१९-३५", "content_sanskrit": "महा सुकृतसंभारैरुत्तमश्चोत्तमोदरे ।\nउवास तस्याः पुण्या या नृपसिंहासनोचितः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004070035, "chapter_id": 24070, "verse_number": "४-१९-३६", "content_sanskrit": "आतपत्रं च चंद्राभं शुभे चापि च चामरे ।\nभद्रासनं तथोच्चं च सिंधुराश्च मदोद्धुराः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004070036, "chapter_id": 24070, "verse_number": "४-१९-३७", "content_sanskrit": "तुरंगमाश्च तुरगास्त्वनाधिव्याधिजीवितम् ।\nनिःसपत्नं शुभं राज्यं प्राज्यं हरिहरार्चनम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004070037, "chapter_id": 24070, "verse_number": "४-१९-३८", "content_sanskrit": "विपुलं च कलाज्ञानमधीतमपराजितम् ।\nतथा जयोरिषड्वर्गे स्वभावात्सात्त्विकी मतिः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004070038, "chapter_id": 24070, "verse_number": "४-१९-३९", "content_sanskrit": "दृष्टिः कारुण्यसंपूर्णा वाणी मधुरभाषिणी ।\nअनालस्यं च कार्येषु तथा गुरुजने नतिः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004070039, "chapter_id": 24070, "verse_number": "४-१९-४०", "content_sanskrit": "सर्वत्र शुचिता तात सा परोपकृतिः सदा ।\nऔर्जस्वला मनोवृत्तिः सदैवादीनवादिता ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004070040, "chapter_id": 24070, "verse_number": "४-१९-४१", "content_sanskrit": "सदोजिरे च पांडित्यं प्रागल्भ्यं चरणांगणे ।\nआर्जवं बंधुवर्गेषु काठिन्यं क्रयविक्रये ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004070041, "chapter_id": 24070, "verse_number": "४-१९-४२", "content_sanskrit": "मार्दवं स्त्रीप्रयोगेषु वत्सलत्वं प्रजासु च ।\nब्राह्मणेभ्यो भयं नित्यं वृद्धवृत्त्युपजीवनम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004070042, "chapter_id": 24070, "verse_number": "४-१९-४३", "content_sanskrit": "वासो भागीरथीतीरे तीर्थे वा मरणं रणे ।\nअपराङ्मुखताऽर्थिभ्यः प्रत्यर्थिभ्यो विशेषतः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004070043, "chapter_id": 24070, "verse_number": "४-१९-४४", "content_sanskrit": "भोगः परिजनैः सार्धं दानावंध्यदिनागमः ।\nविद्याव्यसनिता नित्यं नित्यं पित्रोरुपस्थितिः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004070044, "chapter_id": 24070, "verse_number": "४-१९-४५", "content_sanskrit": "यशसः संचयो नित्यं नित्यं धर्मस्य संचयः ।\nस्वर्गापवर्गयोः सिद्धिः सदा शीलस्य मंडनम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004070045, "chapter_id": 24070, "verse_number": "४-१९-४६", "content_sanskrit": "सद्भिश्च संगतिर्नित्यं मैत्री च पितृमित्रकैः ।\nइतिहासपुराणानामुत्कंठा श्रवणे सदा ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004070046, "chapter_id": 24070, "verse_number": "४-१९-४७", "content_sanskrit": "विपद्यपि परं धैर्यं स्थैर्यं संपत्समागमे ।\nगांभीर्यं वाग्विलासेषु औदार्यं पात्रपाणिषु ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004070047, "chapter_id": 24070, "verse_number": "४-१९-४८", "content_sanskrit": "देहे परैका कृशता तपोभिर्नियमैर्यमैः ।\nएतैर्मनोरथफलैः फलत्येव तपोद्रुमाः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004070048, "chapter_id": 24070, "verse_number": "४-१९-४९", "content_sanskrit": "तस्मादल्पतपस्त्वाद्वै त्वं चाहं च महामते ।\nप्राप्यापि राजसांनिध्यं राजलक्ष्म्या न भाजनम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004070049, "chapter_id": 24070, "verse_number": "४-१९-५०", "content_sanskrit": "मानापमानयोस्तस्मात्स्वकृतं कारणं परम् ।\nस्रष्टापि नापमार्ष्टुं तत्परीष्टे स्वकृतां कृतिम् ।\nमा शोचस्त्वमतः पुत्र दिष्टमिष्टं समर्पयेत् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004070050, "chapter_id": 24070, "verse_number": "४-१९-५१", "content_sanskrit": "इत्याकर्ण्य सुनीत्यास्तन्महावाक्यं सुनीतिमत् ।\nसौनीते यो ध्रुवोवाचमाददे वक्तुमुत्तरम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004070051, "chapter_id": 24070, "verse_number": "४-१९-५२", "content_sanskrit": "ध्रुव उवाच ।\nजनयित्रि सुनीते मे शृणु वाक्यमनाकुलम् ।\nमा बाल इति मत्वा मामवमंस्थास्तपस्विनि ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004070052, "chapter_id": 24070, "verse_number": "४-१९-५३", "content_sanskrit": "यद्यहं मानवे वंशे जातोस्म्यत्यंत पावने ।\nउत्तानपादतनयस्त्वदीयोदर संभवः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004070053, "chapter_id": 24070, "verse_number": "४-१९-५४", "content_sanskrit": "तप एव हि चेन्मातः कारणं सर्वसंपदाम् ।\nतत्तदासादितं विद्विपदमन्यैर्दुरासदम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004070054, "chapter_id": 24070, "verse_number": "४-१९-५५", "content_sanskrit": "एकमेव हि साहाय्यं कुरु मातरतंद्रिता ।\nअनुज्ञा दानमात्रं च आशीर्भिरभिनंदय ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004070055, "chapter_id": 24070, "verse_number": "४-१९-५६", "content_sanskrit": "सापि ज्ञात्वा महावीर्यं कुमारं कुक्षिसंभवम् ।\nमहत्योत्साहसं पत्त्या राजमानमुवाच तम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004070056, "chapter_id": 24070, "verse_number": "४-१९-५७", "content_sanskrit": "अनुज्ञातुं न शक्ताऽहं त्वामुत्तानशयांगज ।\nसाष्टैकवर्षदेशीयन्तथापि कथयाम्यहम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004070057, "chapter_id": 24070, "verse_number": "४-१९-५८", "content_sanskrit": "सपत्नीवाक्यभल्लीभिर्भिन्ने महति मे हृदि ।\nतव बाष्पौघवारीणि न तिष्ठंति करोमि किम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004070058, "chapter_id": 24070, "verse_number": "४-१९-५९", "content_sanskrit": "तानि मन्येऽत्र मार्गेण स्रवंत्यविरतं शिशो ।\nस्रवंतीश्च चिकीर्षंति प्रतिकूल जलाः किल ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004070059, "chapter_id": 24070, "verse_number": "४-१९-६०", "content_sanskrit": "त्वदेकतनया तात त्वदाधारैकजीविता ।\nत्वमंगयष्टिरसि मे त्वन्मुखासक्तलोचना ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004070060, "chapter_id": 24070, "verse_number": "४-१९-६१", "content_sanskrit": "लब्धोसि कतिभिः कष्टैरिष्टाः संप्रार्थ्य देवताः ।\nत्वन्मुखेंदूदये तात मन्मनः क्षीरनीरधिः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004070061, "chapter_id": 24070, "verse_number": "४-१९-६२", "content_sanskrit": "आनन्दपयसापूर्य कुचावुद्वेलितो भवेत् ।\nत्वदंगसंगसंभूत सुखसन्दोह शीतला ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004070062, "chapter_id": 24070, "verse_number": "४-१९-६३", "content_sanskrit": "सुखंशये सुशयने प्रावृत्य पुलकांबरम् ।\nअपोऽथ समुपस्पृश्य तांबूलं परिगृह्य च ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004070063, "chapter_id": 24070, "verse_number": "४-१९-६४", "content_sanskrit": "त्वदास्यस्यौष्ठपुटक दुग्धवार्धि विवर्धिताम् ।\nसुधासुधांशुवदनधयत्यपि धिनोमि न ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004070064, "chapter_id": 24070, "verse_number": "४-१९-६५", "content_sanskrit": "त्वदीयः शीतलालापः प्राप श्रुतिपथं यदा ।\nसपत्नीवाक्यदवथुस्तदैवत्यात्स वेपथुः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004070065, "chapter_id": 24070, "verse_number": "४-१९-६६", "content_sanskrit": "यदंग निद्रासिचिरं ध्यायंत्यस्मि तदेत्यहम् ।\nकदा निद्रा दरिद्रोसौ भवितार्कोदयेऽब्जवत् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004070066, "chapter_id": 24070, "verse_number": "४-१९-६७", "content_sanskrit": "यदोपेया गृहान्वत्स खेलित्वा बालखेलनैः ।\nतदानर्घ्यार्घ्यमुत्स्रष्टुं स्तनौस्यातामिवोन्मुखौ ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004070067, "chapter_id": 24070, "verse_number": "४-१९-६८", "content_sanskrit": "यदा सौधाद्विनिर्यायाः पद्मरेखांकितं पदम् ।\nप्राणानां ते यियासूनां तदा तदवलंबनम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004070068, "chapter_id": 24070, "verse_number": "४-१९-६९", "content_sanskrit": "यदायदा बहिर्यासि पुत्र त्रिचतुरं पदम् ।\nतदातदा मम प्राणः कंठप्राघुणिकी भवेत् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004070069, "chapter_id": 24070, "verse_number": "४-१९-७०", "content_sanskrit": "चित्रं पुत्र त्वरयति यातुं मे मानसांडजः ।\nसुधाधाराधर इव बहिश्चिरयति त्वयि ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004070070, "chapter_id": 24070, "verse_number": "४-१९-७१", "content_sanskrit": "अथ तिष्ठंतु कठिनाः प्राणाः कंठाटवीतटे ।\nतपस्यंतोतिसंतप्तास्तपसे त्वयि यास्यति ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004070071, "chapter_id": 24070, "verse_number": "४-१९-७२", "content_sanskrit": "इत्यनुज्ञामनुप्राप्य जननी चरणांबुजौ ।\nक्षणं मौलिजजंबाल जडौ कृत्वा ध्रुवो ययौ ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004070072, "chapter_id": 24070, "verse_number": "४-१९-७३", "content_sanskrit": "तयापि धैर्यसूत्रेण सुनीत्या परिगुंफ्य च ।\nनेत्रेंदीवरजामाला ध्रुवस्योपायनीकृता ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004070073, "chapter_id": 24070, "verse_number": "४-१९-७४", "content_sanskrit": "मात्रातन्मार्गरक्षार्थं तदा तदनुगीकृताः ।\nपरैरवार्यप्रसराः स्वाशीर्वादाः परःशताः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004070074, "chapter_id": 24070, "verse_number": "४-१९-७५", "content_sanskrit": "स्वसौधात्स विनिर्गत्य बालोऽबालपराक्रमः ।\nअनुकूलेन मरुता दर्शिताध्वाऽविशद्वनम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004070075, "chapter_id": 24070, "verse_number": "४-१९-७६", "content_sanskrit": "समरुत्तरुशाखाग्र प्रसारणमिषेण सः ।\nकृताहूतिरिव प्रेम्णा वनेन वनमाविशत् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004070076, "chapter_id": 24070, "verse_number": "४-१९-७७", "content_sanskrit": "समातृदैवतोभिज्ञः केवलं राजवर्त्मनि ।\nन वेद काननाध्वानं क्षणं दध्यौ नृपात्मजः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004070077, "chapter_id": 24070, "verse_number": "४-१९-७८", "content_sanskrit": "यावदुन्मील्य नयने पुरः पश्यति स ध्रुवः ।\nतावद्ददर्श सप्तर्षीनतर्कित गतीन्वने ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004070078, "chapter_id": 24070, "verse_number": "४-१९-७९", "content_sanskrit": "वालिशेष्वसहायेषु भवेद्भाग्यं सहायकृत् ।\nअरण्यान्यां रणे गेहे ततो भाग्यं हि कारणम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004070079, "chapter_id": 24070, "verse_number": "४-१९-८०", "content_sanskrit": "क्व राजतनयो बालो गहनं क्व च तद्वनम् ।\nबलात्स्वसात्प्रत्कुर्वत्यै नमस्ते भवितव्य ते ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004070080, "chapter_id": 24070, "verse_number": "४-१९-८१", "content_sanskrit": "यत्र यस्य हि यद्भाव्यं शुभं वाऽशुभमेव च ।\nआकृष्यभाविनी रज्जुस्तत्र तस्य हि दापयेत ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004070081, "chapter_id": 24070, "verse_number": "४-१९-८२", "content_sanskrit": "अन्यथा विदधात्येष मानवो बुद्धिवैभवात् ।\nभगवत्या भवित्र्याऽसौ विदध्याद्विधिरन्यथा ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004070082, "chapter_id": 24070, "verse_number": "४-१९-८३", "content_sanskrit": "नवयो न च वै चित्र्यं न चित्रं विदधेहितम् ।\nन बलं नोद्यमः पुंसां कारणं प्राक्कृतं कृतम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004070083, "chapter_id": 24070, "verse_number": "४-१९-८४", "content_sanskrit": "अथ दृष्ट्वा स सप्तर्षीन्सप्तसप्त्यतितेजसः ।\nभाग्यसूत्रैरिवाकृष्योपनीतान्प्रमुमोद ह ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004070084, "chapter_id": 24070, "verse_number": "४-१९-८५", "content_sanskrit": "तिलकांकित सद्भालान्कुशोपग्रहितांगुलीन् ।\nकृष्णाजिनोपविष्टांश्च यज्ञसूत्रैरलंकृतान् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004070085, "chapter_id": 24070, "verse_number": "४-१९-८६", "content_sanskrit": "साक्षसूत्रकरान्किंचिद्विनिमीलितलो चनान् ।\nसुधौतसूक्ष्मकाषायवासः प्रावरणान्वितान ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004070086, "chapter_id": 24070, "verse_number": "४-१९-८७", "content_sanskrit": "अकांडेपि महाभागान्मिलितान्सप्तनीरधीन् ।\nचित्रं विपद्विनिर्मग्नानुद्दिधीर्षूनिव प्रजाः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004070087, "chapter_id": 24070, "verse_number": "४-१९-८८", "content_sanskrit": "उपगम्य विनम्रः स प्रबद्धकरसंपुटः ।\nध्रुवो विज्ञापयांचक्रे प्रणम्य ललितं वचः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004070088, "chapter_id": 24070, "verse_number": "४-१९-८९", "content_sanskrit": "ध्रुव उवाच ।\nअवैत मां मुनिवराः सुनीत्युदरसंभवम् ।\nउत्तानपादतनयं ध्रुवं निर्विण्णमानसम् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004070089, "chapter_id": 24070, "verse_number": "४-१९-९०", "content_sanskrit": "इदं वनमनुप्राप्तं सनाथं युष्मदंघ्रिभिः ।\nप्रायोनभिज्ञं सर्वत्र महर्द्ध्युषितमानसम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004070090, "chapter_id": 24070, "verse_number": "४-१९-९१", "content_sanskrit": "ते दृष्ट्वोर्जस्वलं बालं स्वभाव मधुराकृतिम् ।\nअनर्घ्यनयनेपथ्यं मृदुगंभीरभाषिणम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004070091, "chapter_id": 24070, "verse_number": "४-१९-९२", "content_sanskrit": "उपोपवेश्य शिशुकं प्रोचुर्वै विस्मिता भृशम् ।\nअहोबालविशालाक्ष महाराज कुमारक ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004070092, "chapter_id": 24070, "verse_number": "४-१९-९३", "content_sanskrit": "विचार्यापि न जानीमो वद निर्वेदकारणम् ।\nअद्य ते ह्यर्थचिंता नो क्वापमानः प्रसूर्गृहे ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004070093, "chapter_id": 24070, "verse_number": "४-१९-९४", "content_sanskrit": "नीरुक्छरीरसंपत्तिर्निवेदे किं नु कारणम् ।\nअनवाप्ताभिलाषाणां वैराग्यं जायते नृणाम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004070094, "chapter_id": 24070, "verse_number": "४-१९-९५", "content_sanskrit": "सप्तद्वीपपतेराज्ञः कुमारस्त्वं तथा कथम् ।\nस्वभावभिन्नप्रकृतौ लोकेस्मिन्न मनोगतम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004070095, "chapter_id": 24070, "verse_number": "४-१९-९६", "content_sanskrit": "अवगंतुं हि शक्येत यूनो वृद्धस्य वा शिशोः ।\nइति श्रुत्वा वचस्तेषां सहजप्रेमनिर्भरम् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004070096, "chapter_id": 24070, "verse_number": "४-१९-९७", "content_sanskrit": "वाचं जग्राह स तदा शिशुः प्रांशुमनोरथः ।\nध्रुव उवाच ।\nप्रेषितो राजसेवार्थं जनन्याऽहं मुनीश्वराः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004070097, "chapter_id": 24070, "verse_number": "४-१९-९८", "content_sanskrit": "राजांकमारुरुक्षुर्हि सुरुच्या परिभर्त्सितः ।\nउत्तमं चोत्तमीकृत्य मां च मन्मातरं तथा ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004070098, "chapter_id": 24070, "verse_number": "४-१९-९९", "content_sanskrit": "धिक्कृत्य प्रशशंस स्वं निर्वेदे कारणं त्विदम् ।\nनिशम्येति शिशोर्वाक्यं परस्परमवेक्ष्य ते ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004070099, "chapter_id": 24070, "verse_number": "४-१९-१००", "content_sanskrit": "क्षात्रमेव शशंसुस्तदहो बालेपि न क्षमा ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004070100, "chapter_id": 24070, "verse_number": "४-१९-१०१", "content_sanskrit": "ऋषय ऊचुः ।\nकिमस्माभिरहो कार्यं कस्तवास्ति मनोरथः ।\nज्ञातो भवतु तावत्स नः श्रवो गोचरी कुरु ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004070101, "chapter_id": 24070, "verse_number": "४-१९-१०२", "content_sanskrit": "ध्रुव उवाच ।\nमुनयो मम यो बंधुरुत्तमश्चोत्तमोत्तमः ।\nपित्रा दत्तं च सोऽध्यास्तां तद्भद्रासनमुत्तमम् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004070102, "chapter_id": 24070, "verse_number": "४-१९-१०३", "content_sanskrit": "भवत्कृतं हि साहाय्यमेतदिच्छामि सुव्रताः ।\nप्रायो जाने न बालत्वादुपदेशस्तदुच्यताम् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7004070103, "chapter_id": 24070, "verse_number": "४-१९-१०४", "content_sanskrit": "अनन्यनृपभुक्तं यद्यदन्येभ्यः समुच्छ्रितम् ।\nइंद्रादिदुरवापं यत्कथं लभ्यं दुरासदम् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7004070104, "chapter_id": 24070, "verse_number": "४-१९-१०५", "content_sanskrit": "पित्रोत्सृष्टं न कांक्षामि कांक्षामि स्वभुजाजितम् ।\nमनोरथपथातीतं भवेद्यत्पितुरप्यहो ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7004070105, "chapter_id": 24070, "verse_number": "४-१९-१०६", "content_sanskrit": "पितृसंपत्तिभोक्तारः प्रायशो न यशोधनाः ।\nनरोत्तमास्तु ते ज्ञेया ये पित्राधिक्यदर्शिनः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7004070106, "chapter_id": 24070, "verse_number": "४-१९-१०७", "content_sanskrit": "उपार्जितं हि पित्रा ये नाशयंति यशःश्रुतम् ।\nधनं निधनमेवास्तु तेषां दुर्वृत्तचेतसाम् ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7004070107, "chapter_id": 24070, "verse_number": "४-१९-१०८", "content_sanskrit": "इति श्रुत्वा वचस्तस्य मुनयः सुनयोर्जितम् ।\nयथार्थमेव प्रत्यूचुर्मरीच्याद्यास्तथा ध्रुवम् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7004070108, "chapter_id": 24070, "verse_number": "४-१९-१०९", "content_sanskrit": "मरीचिरुवाच ।\nअनर्चिताच्युतपदः पदमापद्यते कथम् ।\nयथातथात्वमात्थांग नातथ्यं कथयाम्यहम् ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7004070109, "chapter_id": 24070, "verse_number": "४-१९-११०", "content_sanskrit": "अत्रिरुवाच ।\nअनास्वादितगोविंदपदांबुजरजोरसः ।\nमनोरथपथातीतं स्फीतं नाकलयेत्पदम् ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7004070110, "chapter_id": 24070, "verse_number": "४-१९-१११", "content_sanskrit": "अंगिरा उवाच ।\nअदवीयः पदं तस्य सर्वासां संपदामिह ।\nकमलाकांतकांतांघ्रि कमले यः सुशीलयेत् ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7004070111, "chapter_id": 24070, "verse_number": "४-१९-११२", "content_sanskrit": "पुलस्त्य उवाच ।\nयस्य स्मरणमात्रेण महापातकसंततिः ।\nपरमांतमवाप्नोति स विष्णुः सर्वदो ध्रुव ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7004070112, "chapter_id": 24070, "verse_number": "४-१९-११३", "content_sanskrit": "पुलह उवाच ।\nयदाहुः परमं ब्रह्म प्रधान पुरुषात्परम् ।\nयन्मायया ततं सर्वं सर्वं दास्यति सोच्युतः ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7004070113, "chapter_id": 24070, "verse_number": "४-१९-११४", "content_sanskrit": "क्रतुरुवाच ।\nयो यज्ञपुरुषो विष्णुर्वेदवेद्यो जनार्दनः ।\nअंतरात्माऽस्य जगतः तुष्टः किं न यच्छति ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7004070114, "chapter_id": 24070, "verse_number": "४-१९-११५", "content_sanskrit": "वसिष्ठ उवाच ।\nयद्भ्रूनर्तनवर्तिन्यः सिद्धयोऽष्टौ नृपात्मज ।\nतमाराध्य हृषीकेशमपवर्गोप्यदूरतः ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7004070115, "chapter_id": 24070, "verse_number": "४-१९-११६", "content_sanskrit": "ध्रुव उवाच ।\nसत्यमुक्तं मुनीशाना विष्णोराराधनं प्रति ।\nकथं वा भगवानीज्यः सविधिश्चोपदिश्यताम् ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7004070116, "chapter_id": 24070, "verse_number": "४-१९-११७", "content_sanskrit": "मुनय ऊचुः ।\nतिष्ठता गच्छता वापि स्वपता जाग्रता तथा ।\nशयानेनोपविष्टेन जप्यो नारायणः सदा ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7004070117, "chapter_id": 24070, "verse_number": "४-१९-११८", "content_sanskrit": "द्वादशाक्षरमंत्रेण वासुदेवात्मकेन च ।\nध्यायंश्चतुर्भुजं विष्णुं जप्त्वा सिद्धिं न को गतः ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7004070118, "chapter_id": 24070, "verse_number": "४-१९-११९", "content_sanskrit": "अतसीपुष्पसंकाशं पीतवाससमच्युतम् ।\nक्षणं सर्वात्मकं पश्यन्को न सिध्यति भूतले ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7004070119, "chapter_id": 24070, "verse_number": "४-१९-१२०", "content_sanskrit": "पुत्रान्कलत्रमित्राणि राज्यं स्वर्गापवर्गकम् ।\nवासुदेवं जपन्मर्त्यः सर्वं प्राप्नोत्यसंशयम् ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7004070120, "chapter_id": 24070, "verse_number": "४-१९-१२१", "content_sanskrit": "वासुदेव जपासक्तानपिपापकृतो जनान् ।\nनोपस्पृशंति वै विघ्ना यमदूताश्च दारुणाः ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7004070121, "chapter_id": 24070, "verse_number": "४-१९-१२२", "content_sanskrit": "पितामहेन तेप्येष महामंत्र उपासितः ।\nमनुना राज्यकामेन वैष्णवेन महर्द्धिना ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7004070122, "chapter_id": 24070, "verse_number": "४-१९-१२३", "content_sanskrit": "त्वमप्येतेन मंत्रेण वासुदेवपरो भव ।\nयथाभिलषितामृद्धिं क्षिप्रमाप्नुहि सत्तम ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7004070123, "chapter_id": 24070, "verse_number": "४-१९-१२४", "content_sanskrit": "इत्युक्त्वांऽतर्हिताः सर्वे महात्मानो मुनीश्वराः ।\nवासुदेवमना भूत्वा ध्रुवोपि तपसे गतः ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}]