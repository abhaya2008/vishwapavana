[{"id": 5000333000, "chapter_id": 9333, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे एकषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000333001, "chapter_id": 9333, "verse_number": "४-६१-१", "content_sanskrit": "ततस्तद् दारुणं कर्म दुष्करं सहसा कृतम्।\nआचचक्षे मुनेः सर्वं सूर्यानुगमनं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000333002, "chapter_id": 9333, "verse_number": "४-६१-२", "content_sanskrit": "भगवन् व्रणयुक्तत्वाल्लज्जया चाकुलेन्द्रियः।\nपरिश्रान्तो न शक्नोमि वचनं परिभाषितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000333003, "chapter_id": 9333, "verse_number": "४-६१-३", "content_sanskrit": "अहं चैव जटायुश्च संघर्षाद् गर्वमोहितौ।\nआकाशं पतितौ दूराज्जिज्ञासन्तौ पराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000333004, "chapter_id": 9333, "verse_number": "४-६१-४", "content_sanskrit": "कैलासशिखरे बद्‍ध्वा मुनीनामग्रतः पणम्।\nरविः स्यादनुयातव्यो यावदस्तं महागिरिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000333005, "chapter_id": 9333, "verse_number": "४-६१-५", "content_sanskrit": "अप्यावां युगपत् प्राप्तावपश्याव महीतले।\nरथचक्रप्रमाणानि नगराणि पृथक् पृथक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000333006, "chapter_id": 9333, "verse_number": "४-६१-६", "content_sanskrit": "क्वचिद् वादित्रघोषश्च क्वचिद् भूषणनिःस्वनः।\nगायन्तीः स्माङ्गना बह्वीः पश्यावो रक्तवाससः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000333007, "chapter_id": 9333, "verse_number": "४-६१-७", "content_sanskrit": "तूर्णमुत्पत्य चाकाशमादित्यपदमास्थितौ।\nआवामालोकयावस्तद् वनं शाद्वलसंस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000333008, "chapter_id": 9333, "verse_number": "४-६१-८", "content_sanskrit": "उपलैरिव संछन्ना दृश्यते भूः शिलोच्चयैः।\nआपगाभिश्च संवीता सूत्रैरिव वसुंधरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000333009, "chapter_id": 9333, "verse_number": "४-६१-९", "content_sanskrit": "हिमवांश्चैव विन्ध्यश्च मेरुश्च सुमहागिरिः।\nभूतले सम्प्रकाशन्ते नागा इव जलाशये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000333010, "chapter_id": 9333, "verse_number": "४-६१-१०", "content_sanskrit": "तीव्रः स्वेदश्च खेदश्च भयं चासीत् तदावयोः।\nसमाविशत मोहश्च ततो मूर्च्छा च दारुणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000333011, "chapter_id": 9333, "verse_number": "४-६१-११", "content_sanskrit": "न च दिग् ज्ञायते याम्या न चाग्नेयी न वारुणी।\nयुगान्ते नियतो लोको हतो दग्ध इवाग्निना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000333012, "chapter_id": 9333, "verse_number": "४-६१-१२", "content_sanskrit": "मनश्च मे हतं भूयश्चक्षुः प्राप्य तु संश्रयम्।\nयत्नेन महता ह्यस्मिन् मनः संधाय चक्षुषी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000333013, "chapter_id": 9333, "verse_number": "४-६१-१३", "content_sanskrit": "यत्नेन महता भूयो भास्करः प्रतिलोकितः।\nतुल्यपृथ्वीप्रमाणेन भास्करः प्रतिभाति नौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000333014, "chapter_id": 9333, "verse_number": "४-६१-१४", "content_sanskrit": "जटायुर्मामनापृच्छ्य निपपात महीं ततः।\nतं दृष्ट्वा तूर्णमाकाशादात्मानं मुक्तवानहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000333015, "chapter_id": 9333, "verse_number": "४-६१-१५", "content_sanskrit": "पक्षाभ्यां च मया गुप्तो जटायुर्न प्रदह्यत।\nप्रमादात् तत्र निर्दग्धः पतन् वायुपथादहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000333016, "chapter_id": 9333, "verse_number": "४-६१-१६", "content_sanskrit": "आशङ्के तं निपतितं जनस्थाने जटायुषम्।\nअहं तु पतितो विन्ध्ये दग्धपक्षो जडीकृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000333017, "chapter_id": 9333, "verse_number": "४-६१-१७", "content_sanskrit": "राज्याच्च हीनो भ्रात्रा च पक्षाभ्यां विक्रमेण च।\nसर्वथा मर्तुमेवेच्छन् पतिष्ये शिखराद् गिरेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000333018, "chapter_id": 9333, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे एकषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]