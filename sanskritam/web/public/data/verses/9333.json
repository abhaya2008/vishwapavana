[{"id": 40020396, "chapter_id": 9333, "verse_number": "1", "content_sanskrit": "ततस्तु सचिवैः सार्धं षड्भिर्नित्यं बलोद्धतैः । महोदरप्रहस्ताभ्यां मारीचशुकसारणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40020397, "chapter_id": 9333, "verse_number": "2", "content_sanskrit": "धूम्राक्षेण च वीरेण नित्यं समरगृध्नुना । वृतः संप्रययौ श्रीमान्क्रोधाल्लोकान्दहन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40020398, "chapter_id": 9333, "verse_number": "3", "content_sanskrit": "पुराणि स नदीः शैलान्वनान्युपवनानि च । अतिक्रम्य मुहूर्तेन कैलासं गिरिमागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40020399, "chapter_id": 9333, "verse_number": "4", "content_sanskrit": "सन्निविष्टं गिरौ तस्मिन्राक्षसेन्द्रं निशम्य तु । युद्धे ऽत्यर्थकृतोत्साहं दुरात्मानं समन्त्रिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40020400, "chapter_id": 9333, "verse_number": "5", "content_sanskrit": "यक्षा न शेकुः संस्थातुं प्रमुखे तस्य रक्षसः । राज्ञो भ्रातेति विज्ञाय गता यत्र धनेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40020401, "chapter_id": 9333, "verse_number": "6", "content_sanskrit": "ते गत्वा सर्वमाचख्युर्भ्रातुस्तस्य चिकीर्षितम् । अनुज्ञाता ययुर्हष्टा युद्धाय धनदेन ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40020402, "chapter_id": 9333, "verse_number": "7", "content_sanskrit": "ततो बलानां सङ्क्षोभो व्यवर्धत महोदधेः । तस्य नैर्ऋतराजस्य शैलं सञ्चालयन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40020403, "chapter_id": 9333, "verse_number": "8", "content_sanskrit": "ततो युद्धं समभवद्यक्षराक्षससङ्कुलम् । व्यथिताश्चाभवंस्तत्र सचिवा राक्षसस्य ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40020404, "chapter_id": 9333, "verse_number": "9", "content_sanskrit": "स दृष्ट्वा तादृशं सैन्यं दशग्रीवो निशाचरः । हर्षनादान्बहून्कृत्वा स क्रोधादभ्यधावत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40020405, "chapter_id": 9333, "verse_number": "10", "content_sanskrit": "ये तु ते राक्षसेन्द्रस्य सचिवा घोरविक्रमाः । तेषां सहस्रमेकैकं यक्षाणां समयोधयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40020406, "chapter_id": 9333, "verse_number": "11", "content_sanskrit": "ततो गदाभिर्मुसलैरसिभिः शक्तितोमरैः । हन्यमानो दशग्रीवस्तत्सैन्यं समगाहत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40020407, "chapter_id": 9333, "verse_number": "12", "content_sanskrit": "स निरुच्छ्वासवत्तत्र वध्यमानो दशाननः । वर्षद्भिरिव जीमूतैर्धाराभिरवरुध्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40020408, "chapter_id": 9333, "verse_number": "13", "content_sanskrit": "न चकार व्यथां चैव यक्षशस्त्रैः समाहतः । महीधर इवाम्भोदैर्धाराशतसमुक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40020409, "chapter_id": 9333, "verse_number": "14", "content_sanskrit": "स दुरात्मा समुद्यम्य कालदण्डोपमां गदाम् । प्रविवेश ततः सैन्यं नयन्यक्षान्यमक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40020410, "chapter_id": 9333, "verse_number": "15", "content_sanskrit": "स कक्षमिव विस्तीर्णं शुष्केन्धनमिवाकुलम् । वातेनाग्निरिवायत्तो यक्षसैन्यं ददाह तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40020411, "chapter_id": 9333, "verse_number": "16", "content_sanskrit": "तैस्तु तत्र महामात्यैर्महोदरशुकादिभिः । अल्पावशेषास्ते यक्षाः कृता वातैरिवाम्बुदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40020412, "chapter_id": 9333, "verse_number": "17", "content_sanskrit": "केचित्समाहता भग्नाः पतिताः समरक्षितौ । ओष्ठांश्च दशनैस्तीक्ष्णैरदशन्कुपिता रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40020413, "chapter_id": 9333, "verse_number": "18", "content_sanskrit": "श्रान्ताश्चान्योन्यमालिङ्ग्य भ्रष्टशस्त्रा रणाजिरे । सीदन्ति च तदा यक्षाः कूला इव जलेन ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40020414, "chapter_id": 9333, "verse_number": "19", "content_sanskrit": "हतानां गच्छतां स्वर्गं युध्यतां पृथिवीतले । प्रेक्षतामृषिसङ्घानां न बभूवान्तरं दिवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40020415, "chapter_id": 9333, "verse_number": "20", "content_sanskrit": "भग्नांस्तु तान्समालक्ष्य यक्षेन्द्रांस्तु महाबलान् । धनाध्यक्षो महाबाहुः प्रेषयामास यक्षकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40020416, "chapter_id": 9333, "verse_number": "21", "content_sanskrit": "एतस्मिन्नन्तरे राम विस्तीर्णबलवाहनः । प्रेषितो न्यपतद्यक्षो नाम्ना संयोधकण्टकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40020417, "chapter_id": 9333, "verse_number": "22", "content_sanskrit": "तेन चक्रेण मारीचो विष्णुनेव रणे हतः । पतितो भूतले शैलात्क्षीणपुण्य इव ग्रहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40020418, "chapter_id": 9333, "verse_number": "23", "content_sanskrit": "ससञ्ज्ञस्तु मुहूर्तेन स विश्रम्य निशाचरः । तं यक्षं योधयामास स च भग्नः प्रदुद्रुवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40020419, "chapter_id": 9333, "verse_number": "24", "content_sanskrit": "ततः काञ्चनचित्राङ्गं वैडूर्यरजसोक्षितम् । मर्यादां प्रतिहाराणां तोरणान्तरमाविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40020420, "chapter_id": 9333, "verse_number": "25", "content_sanskrit": "तं तु राजन्दशग्रीवं प्रविशन्तं निशाचरम् । सूर्यभानुरिति ख्यातो द्वारपालो न्यवारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40020421, "chapter_id": 9333, "verse_number": "26", "content_sanskrit": "स वार्यमाणो यक्षेण प्रविवेश निशाचरः । यदा तु वारितो राम न व्यतिष्ठत्स राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40020422, "chapter_id": 9333, "verse_number": "27", "content_sanskrit": "ततस्तोरणमुत्पाट्य तेन यक्षेण ताडितः । रुधिरं प्रस्रवन्भाति शैलो धातुस्रवैरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40020423, "chapter_id": 9333, "verse_number": "28", "content_sanskrit": "स शैलशिखराभेण तोरणेन समाहतः । जगाम न क्षतिं वीरो वरदानात्स्वयम्भुवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40020424, "chapter_id": 9333, "verse_number": "29", "content_sanskrit": "तेनैव तोरणेनाथ यक्षस्तेनाभिताडितः । नादृश्यत तदा यक्षो भस्मीकृततनुस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40020425, "chapter_id": 9333, "verse_number": "30", "content_sanskrit": "ततः प्रदुद्रुवुः सर्वे दृष्ट्वा रक्षःपराक्रमम् । ततो नदीर्गुहाश्चैव विविशुर्भयपीडिताः । त्यक्तप्रहरणाः श्रान्ता विवर्णवदनास्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]