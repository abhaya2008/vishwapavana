[{"id": 5000511000, "chapter_id": 9511, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे चतुरधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000511001, "chapter_id": 9511, "verse_number": "६-१०४-१", "content_sanskrit": "स तु मोहात् सुसंक्रुद्धः कृतान्तबलचोदितः।\nक्रोधसंरक्तनयनो रावणः सूतमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000511002, "chapter_id": 9511, "verse_number": "६-१०४-२", "content_sanskrit": "हीनवीर्यमिवाशक्तं पौरुषेण विवर्जितम्।\nभीरुं लघुमिवासत्त्वं विहीनमिव तेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000511003, "chapter_id": 9511, "verse_number": "६-१०४-३", "content_sanskrit": "विमुक्तमिव मायाभिरस्त्रैरिव बहिष्कृतम्।\nमामवज्ञाय दुर्बुद्धे स्वया बुद्ध्या विचेष्टसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000511004, "chapter_id": 9511, "verse_number": "६-१०४-४", "content_sanskrit": "किमर्थं मामवज्ञाय मच्छन्दमनवेक्ष्य च।\nत्वया शत्रुसमक्षं मे रथोऽयमपवाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000511005, "chapter_id": 9511, "verse_number": "६-१०४-५", "content_sanskrit": "त्वयाद्य हि ममानार्य चिरकालमुपार्जितम्।\nयशो वीर्यं च तेजश्च प्रत्ययश्च विनाशितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000511006, "chapter_id": 9511, "verse_number": "६-१०४-६", "content_sanskrit": "शत्रोः प्रख्यातवीर्यस्य रञ्जनीयस्य विक्रमैः।\nपश्यतो युद्धलुब्धोऽहं कृतः कापुरुषस्त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000511007, "chapter_id": 9511, "verse_number": "६-१०४-७", "content_sanskrit": "यत् त्वं कथमिदं मोहान्न चेद् वहसि दुर्मते।\nसत्योऽयं प्रतितर्को मे परेण त्वमुपस्कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000511008, "chapter_id": 9511, "verse_number": "६-१०४-८", "content_sanskrit": "नहि तद् विद्यते कर्म सुहृदो हितकांक्षिणः।\nरिपूणां सदृशं त्वेतद् यत् त्वयैतदनुष्ठितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000511009, "chapter_id": 9511, "verse_number": "६-१०४-९", "content_sanskrit": "निवर्तय रथं शीघ्रं यावन्नापैति मे रिपुः।\nयदि वाध्युषितोऽसि त्वं स्मर्यते यदि मे गुणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000511010, "chapter_id": 9511, "verse_number": "६-१०४-१०", "content_sanskrit": "एवं परुषमुक्तस्तु हितबुद्धिरबुद्धिना।\nअब्रवीद् रावणं सूतो हितं सानुनयं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000511011, "chapter_id": 9511, "verse_number": "६-१०४-११", "content_sanskrit": "न भीतोऽस्मि न मूढोऽस्मि नोपजप्तोऽस्मि शत्रुभिः।\nन प्रमत्तो न निःस्नेहो विस्मृता न च सत्क्रिया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000511012, "chapter_id": 9511, "verse_number": "६-१०४-१२", "content_sanskrit": "मया तु हितकामेन यशश्च परिरक्षता।\nस्नेहप्रस्कन्नमनसा हितमित्यप्रियं कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000511013, "chapter_id": 9511, "verse_number": "६-१०४-१३", "content_sanskrit": "नास्मिन्नर्थे महाराज त्वं मां प्रियहिते रतम्।\nकश्चिल्लघुरिवानार्यो दोषतो गन्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000511014, "chapter_id": 9511, "verse_number": "६-१०४-१४", "content_sanskrit": "श्रूयतां प्रति दास्यामि यन्निमित्तं मया रथः।\nनदीवेग इवाम्भोभिः संयुगे विनिवर्तितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000511015, "chapter_id": 9511, "verse_number": "६-१०४-१५", "content_sanskrit": "श्रमं तवावगच्छामि महता रणकर्मणा।\nनहि ते वीर्यसौमुख्यं प्रकर्षं नोपधारये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000511016, "chapter_id": 9511, "verse_number": "६-१०४-१६", "content_sanskrit": "रथोद्वहनखिन्नाश्च भग्ना मे रथवाजिनः।\nदीना घर्मपरिश्रान्ता गावो वर्षहता इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000511017, "chapter_id": 9511, "verse_number": "६-१०४-१७", "content_sanskrit": "निमित्तानि च भूयिष्ठं यानि प्रादुर्भवन्ति नः।\nतेषु तेष्वभिपन्नेषु लक्षयाम्यप्रदक्षिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000511018, "chapter_id": 9511, "verse_number": "६-१०४-१८", "content_sanskrit": "देशकालौ च विज्ञेयौ लक्षणानीङ्गितानि च।\nदैन्यं हर्षश्च खेदश्च रथिनश्च बलाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000511019, "chapter_id": 9511, "verse_number": "६-१०४-१९", "content_sanskrit": "स्थलनिम्नानि भूमेश्च समानि विषमाणि च।\nयुद्धकालश्च विज्ञेयः परस्यान्तरदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000511020, "chapter_id": 9511, "verse_number": "६-१०४-२०", "content_sanskrit": "उपयानापयाने च स्थानं प्रत्यपसर्पणम्।\nसर्वमेतद् रथस्थेन ज्ञेयं रथकुटुम्बिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000511021, "chapter_id": 9511, "verse_number": "६-१०४-२१", "content_sanskrit": "तव विश्रामहेतोस्तु तथैषां रथवाजिनाम्।\nरौद्रं वर्जयता खेदं क्षमं कृतमिदं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000511022, "chapter_id": 9511, "verse_number": "६-१०४-२२", "content_sanskrit": "स्वेच्छया न मया वीर रथोऽयमपवाहितः।\nभर्तुः स्नेहपरीतेन मयेदं यत् कृतं प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000511023, "chapter_id": 9511, "verse_number": "६-१०४-२३", "content_sanskrit": "आज्ञापय यथातत्त्वं वक्ष्यस्यरिनिषूदन।\nतत् करिष्याम्यहं वीर गतानृण्येन चेतसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000511024, "chapter_id": 9511, "verse_number": "६-१०४-२४", "content_sanskrit": "संतुष्टस्तेन वाक्येन रावणस्तस्य सारथेः।\nप्रशस्यैनं बहुविधं युद्धलुब्धोऽब्रवीदिदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000511025, "chapter_id": 9511, "verse_number": "६-१०४-२५", "content_sanskrit": "रथं शीघ्रमिमं सूत राघवाभिमुखं नय।\nनाहत्वा समरे शत्रून् निवर्तिष्यति रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000511026, "chapter_id": 9511, "verse_number": "६-१०४-२६", "content_sanskrit": "एवमुक्त्वा रथस्थस्य रावणो राक्षसेश्वरः।\nददौ तस्य शुभं ह्येकं हस्ताभरणमुत्तमम्।\nश्रुत्वा रावणवाक्यानि सारथिः संन्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000511027, "chapter_id": 9511, "verse_number": "६-१०४-२७", "content_sanskrit": "ततो द्रुतं रावणवाक्यचोदितः\nप्रचोदयामास हयान् स सारथिः।\nस राक्षसेन्द्रस्य ततो महारथः\nक्षणेन रामस्य रणाग्रतोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000511028, "chapter_id": 9511, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे चतुरधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]