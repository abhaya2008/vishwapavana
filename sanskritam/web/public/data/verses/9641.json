[{"id": 5000641000, "chapter_id": 9641, "verse_number": "७-१०६-१", "content_sanskrit": "अवाङ्मुखमथो दीनं दृष्ट्वा सोममिवाप्लुतम् ।\nराघवं लक्ष्मणो वाक्यं हृष्टो मधुरमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000641001, "chapter_id": 9641, "verse_number": "७-१०६-२", "content_sanskrit": "न संतापं महाबाहो मदर्थं कर्तुमर्हसि ।\nपूर्वनिर्माणबद्धा हि कालस्य गतिरीदृशी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000641002, "chapter_id": 9641, "verse_number": "७-१०६-३", "content_sanskrit": "जहि मां सौम्य विस्रब्धं प्रतिज्ञां परिपालय ।\nहीनप्रतिज्ञाः काकुत्स्थ प्रयान्ति नरकं नराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000641003, "chapter_id": 9641, "verse_number": "७-१०६-४", "content_sanskrit": "यदि प्रीतिर्महाराज यद्यनुग्राह्यता मयि ।\nजहि मां निर्विशङ्कस्त्वं धर्मं वर्धय राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000641004, "chapter_id": 9641, "verse_number": "७-१०६-५", "content_sanskrit": "लक्ष्मणेन तथोक्तस्तु रामः प्रचलितेन्द्रियः ।\nमन्त्रिणः समुपानीय तथैव च पुरोधसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000641005, "chapter_id": 9641, "verse_number": "७-१०६-६", "content_sanskrit": "अब्रवीच्च तदा वृत्तं तेषां मध्ये स राघवः ।\nदुर्वासोभिगमं चैव प्रतिज्ञां तापसस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000641006, "chapter_id": 9641, "verse_number": "७-१०६-७", "content_sanskrit": "तच्छ्रुत्वा मन्त्रिणः सर्वे सोपाध्यायाः समासत ।\nवसिष्ठस्तु महातेजा वाक्यमेतदुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000641007, "chapter_id": 9641, "verse_number": "७-१०६-८", "content_sanskrit": "दृष्टमेतन्महाबाहो क्षयं ते रोमहर्षणम् ।\nलक्ष्मणेन वियोगश्च तव राम महायशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000641008, "chapter_id": 9641, "verse_number": "७-१०६-९", "content_sanskrit": "त्यजैनं बलवान्कालो मा प्रतिज्ञां वृथा कृताः ।\nविनष्टायां प्रतिज्ञायां धर्मो ऽपि च लयं व्रजेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000641009, "chapter_id": 9641, "verse_number": "७-१०६-१०", "content_sanskrit": "ततो धर्मे विनष्टे तु त्रैलोक्यं सचराचरम् ।\nसदेवर्षिगणं सर्वं विनश्येत्तु न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000641010, "chapter_id": 9641, "verse_number": "७-१०६-११", "content_sanskrit": "स त्वं पुरुषशार्दूल त्रैलोक्यस्याभिपालनात् ।\nलक्ष्मणेन विना चाद्य जगत्स्वस्थं कुरुष्व ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000641011, "chapter_id": 9641, "verse_number": "७-१०६-१२", "content_sanskrit": "तेषां तत्समवेतानां वाक्यं धर्मार्थसंहितम् ।\nश्रुत्वा परिषदो मध्ये रामो लक्ष्मणमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000641012, "chapter_id": 9641, "verse_number": "७-१०६-१३", "content_sanskrit": "विसर्जये त्वां सौमित्रे मा भूद्धर्मविपर्ययः ।\nत्यागो वधो वा विहितः साधूनां तूभयं समम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000641013, "chapter_id": 9641, "verse_number": "७-१०६-१४", "content_sanskrit": "रामेण भाषिते वाक्ये बाष्पव्याकुलितेन्द्रियः ।\nलक्ष्मणस्त्वरितं प्रायात्स्वगृहं न विवेश ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000641014, "chapter_id": 9641, "verse_number": "७-१०६-१५", "content_sanskrit": "स गत्वा सरयूतीरमुपस्पृश्य कृताञ्जलिः ।\nनिगृह्य सर्वस्रोतांसि निःश्वासं न मुमोच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000641015, "chapter_id": 9641, "verse_number": "७-१०६-१६", "content_sanskrit": "अनिःश्वसन्तं युक्तं तं सशक्राः साप्सरोगणाः ।\nदेवाः सर्षिगणाः सर्वे पुष्पैरभ्यकिरंस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000641016, "chapter_id": 9641, "verse_number": "७-१०६-१७", "content_sanskrit": "अदृश्यं सर्वमनुजैः सशरीरं महाबलम् ।\nप्रगृह्य लक्ष्मणं शक्रस्त्रिदिवं संविवेश ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000641017, "chapter_id": 9641, "verse_number": "७-१०६-१८", "content_sanskrit": "ततो विष्णोश्चतुर्भागमागतं सुरसत्तमाः ।\nदृष्ट्वा प्रमुदिताः सर्वे ऽपूजयन् समहर्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000641018, "chapter_id": 9641, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे षडुत्तरशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]