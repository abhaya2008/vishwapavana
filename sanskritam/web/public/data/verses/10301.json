[{"id": 6000301000, "chapter_id": 10301, "verse_number": null, "content_sanskrit": "अथ पञ्चाधिकशततमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000301001, "chapter_id": 10301, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.001.m4a", "display_order": 2}, {"id": 6000301002, "chapter_id": 10301, "verse_number": "१०-१०५-१", "content_sanskrit": "एवं वेदोदितं धर्ममनुतिष्ठन् सतां गतिः।\nगृहं धर्मार्थकामानां मुहुः सन्दर्शयन् पदम्॥ १०/१०५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.002.m4a", "display_order": 3, "topics": [{"text": "सर्वत आगत्य मुनीनां द्वारकावासः", "range": "१–११"}]}, {"id": 6000301003, "chapter_id": 10301, "verse_number": "१०-१०५-२", "content_sanskrit": "एवं शासति भूचक्रं चक्रपाणौ जनार्दने।\nद्वारका वृष्णिनिलया योजनद्वादशायुता॥ १०/१०५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.003.m4a", "display_order": 4}, {"id": 6000301004, "chapter_id": 10301, "verse_number": "१०-१०५-३", "content_sanskrit": "मुनिभिर्ब्राह्मणैश्चैव क्षत्रियैश्चापि वन्दिभिः।\nआसीत् पूर्णा कुरुश्रेष्ठ सततं समलङ्कृता॥ १०/१०५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.004.m4a", "display_order": 5}, {"id": 6000301005, "chapter_id": 10301, "verse_number": "१०-१०५-४", "content_sanskrit": "पिण्डारकात् कुरुक्षेत्रात् सालग्रामाच्च पुष्करात्।\nवाराणस्याः प्रयागाच्च वेङ्कटाच्छ्रीगिरेरपि॥ १०/१०५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.005.m4a", "display_order": 6}, {"id": 6000301006, "chapter_id": 10301, "verse_number": "१०-१०५-५", "content_sanskrit": "स्यानन्दूराच्च गोकर्णाच्चन्द्रतीर्थाच्च शोभनात्।\nसह्याद्रेश्च भृगुक्षेत्रात् कुमारनिलयादपि॥ १०/१०५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.006.m4a", "display_order": 7}, {"id": 6000301007, "chapter_id": 10301, "verse_number": "१०-१०५-६", "content_sanskrit": "गोदावरीतटात् पुण्यान्नर्मदानिकटादपि।\nशूर्पाकारात् प्रभासाच्च पुण्याद् बदरिकाश्रमात्॥ १०/१०५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.007.m4a", "display_order": 8}, {"id": 6000301008, "chapter_id": 10301, "verse_number": "१०-१०५-७", "content_sanskrit": "पावनान्नैमिषारण्याद् ब्रह्मदुर्गाच्च दुर्गमात्।\nआययुर्मुनयः शान्ता नित्यव्रतपरायणाः॥ १०/१०५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.008.m4a", "display_order": 9}, {"id": 6000301009, "chapter_id": 10301, "verse_number": "१०-१०५-८", "content_sanskrit": "अब्भक्षा वायुभक्षाश्च निराहारा दृढव्रताः।\nवल्कलाजिनसंवीता जटिनश्चापि मुण्डिनः॥ १०/१०५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.009.m4a", "display_order": 10}, {"id": 6000301010, "chapter_id": 10301, "verse_number": "१०-१०५-९", "content_sanskrit": "त्रिकालस्नायिनश्चैव मौनव्रतपरायणाः।\nवेदस्वाध्यायनिरताः स्तुतिस्तोत्रपरायणाः॥ १०/१०५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.010.m4a", "display_order": 11}, {"id": 6000301011, "chapter_id": 10301, "verse_number": "१०-१०५-१०", "content_sanskrit": "ध्यानैकतानमनसः समाधौ कृतनिश्चयाः।\nत्वगस्थिमात्रावयवाः शिराधमनिसन्तताः॥ १०/१०५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.011.m4a", "display_order": 12}, {"id": 6000301012, "chapter_id": 10301, "verse_number": "१०-१०५-११", "content_sanskrit": "आगत्य मुनयो राजन् सर्वतः शान्तचेतसः।\nउपासत महाराज नित्यं तत्त्वैकचिन्तकाः॥ १०/१०५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.012.m4a", "display_order": 13}, {"id": 6000301013, "chapter_id": 10301, "verse_number": "१०-१०५-१२", "content_sanskrit": "क्षत्रियैश्च महावीर्यैर्ब्राह्मणैश्च तपोधनैः।\nसूतैश्च मागधैश्चैव श्लोकस्तुतिपरायणैः॥ १०/१०५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.013.m4a", "display_order": 14, "topics": [{"text": "क्षत्रियादीनां च तत्रागमनम्", "range": "१२–१५"}]}, {"id": 6000301014, "chapter_id": 10301, "verse_number": "१०-१०५-१३", "content_sanskrit": "पूर्णमङ्गलघोषैश्च वादित्राणां च निःस्वनैः।\nनिर्घुष्टा ब्रह्मघोषैश्च द्वारका कुरुनन्दन॥ १०/१०५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.014.m4a", "display_order": 15}, {"id": 6000301015, "chapter_id": 10301, "verse_number": "१०-१०५-१४", "content_sanskrit": "क्षेत्राणामपि सर्वेषां तीर्थानां चाघहारिणाम्।\nदेवदेवस्य सान्निध्यादग्रण्या च बभूव सा॥ १०/१०५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.015.m4a", "display_order": 16}, {"id": 6000301016, "chapter_id": 10301, "verse_number": "१०-१०५-१५", "content_sanskrit": "आस्थितस्य परं धर्मं कृष्णस्य गृहमेधिनः।\nआसन् षोडशसाहस्रमहिष्यस्तु शताधिकाः॥ १०/१०५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.016.m4a", "display_order": 17}, {"id": 6000301017, "chapter_id": 10301, "verse_number": "१०-१०५-१६", "content_sanskrit": "तासां स्‍त्रीरत्नभूतानामष्टौ याः प्रागुदाहृताः।\nरुग्मिणीप्रमुखा राजन् तत्पुत्राश्चानुपूर्वशः॥ १०/१०५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.017.m4a", "display_order": 18, "topics": [{"text": "यदुवंशस्य विस्तृतेः श्रैष्ठ्यस्य च वर्णनम्", "range": "१६–३६"}]}, {"id": 6000301018, "chapter_id": 10301, "verse_number": "१०-१०५-१७", "content_sanskrit": "एकैकस्यां दश दश कृष्णोऽजीजनदात्मजान्।\nयावत्य आत्मनो भार्यास्त्वमोघगतिरीश्वरः॥ १०/१०५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.018.m4a", "display_order": 19}, {"id": 6000301019, "chapter_id": 10301, "verse_number": "१०-१०५-१८", "content_sanskrit": "तेषामुद्दामवीर्याणामष्टादश महारथाः।\nआसन्नुदारयशसस्तेषां नामानि मे शृणु॥ १०/१०५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.019.m4a", "display_order": 20}, {"id": 6000301020, "chapter_id": 10301, "verse_number": "१०-१०५-१९", "content_sanskrit": "प्रद्युम्नश्चारुदेष्णश्च दीप्तिमान् भानुरेव च।\nसाम्बो मित्रबृहद्भानू भानुविन्दो वृकोऽरुणः॥ १०/१०५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.020.m4a", "display_order": 21}, {"id": 6000301021, "chapter_id": 10301, "verse_number": "१०-१०५-२०", "content_sanskrit": "पुष्करो देवभानुश्च श्रुतदेवः सुनन्दनः।\nचित्रभानुर्वरूथश्च कविर्न्यग्रोध एव च॥ १०/१०५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.021.m4a", "display_order": 22}, {"id": 6000301022, "chapter_id": 10301, "verse_number": "१०-१०५-२१", "content_sanskrit": "त्रिवक्राया विशोकश्च पुत्रः कृष्णमनुव्रतः।\nआसीच्छिष्यो नारदस्य ददौ चित्तमखण्डितम्॥ १०/१०५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.022.m4a", "display_order": 23}, {"id": 6000301023, "chapter_id": 10301, "verse_number": "१०-१०५-२२", "content_sanskrit": "येनोक्तं सात्वतं तन्त्रं यज्ज्ञात्वा मूर्तिमान् भवेत्।\nयत्र स्‍त्रीशूद्रदाशानां संस्कारो वैष्णवः स्मृतः॥ १०/१०५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.023.m4a", "display_order": 24}, {"id": 6000301024, "chapter_id": 10301, "verse_number": "१०-१०५-२३", "content_sanskrit": "एतेषामपि राजेन्द्र तनुजानां मधुद्विषः।\nप्रद्युम्न आसीत् प्रथमः पितृवद् रुग्मिणीसुतः॥ १०/१०५/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.024.m4a", "display_order": 25}, {"id": 6000301025, "chapter_id": 10301, "verse_number": "१०-१०५-२४", "content_sanskrit": "स रुग्मिणो दुहितरमुपयेमे महारथः।\nतस्यां ततोऽनिरुद्धोऽभून्नागायुतबलान्वितः॥ १०/१०५/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.025.m4a", "display_order": 26}, {"id": 6000301026, "chapter_id": 10301, "verse_number": "१०-१०५-२५", "content_sanskrit": "स चापि रुग्मिणः पौत्रीं दौहित्रो जगृहे ततः।\nवज्रस्तस्यामभूद् यस्तु मौसलादवशेषितः॥ १०/१०५/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.026.m4a", "display_order": 27}, {"id": 6000301027, "chapter_id": 10301, "verse_number": "१०-१०५-२६", "content_sanskrit": "प्रतिबाहुरभूत् तस्मात् सुबाहुस्तस्य चात्मजः।\nसुबाहोरुग्रसेनोऽभूच्छतसेनस्तु तत्सुतः॥ १०/१०५/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.027.m4a", "display_order": 28}, {"id": 6000301028, "chapter_id": 10301, "verse_number": "१०-१०५-२७", "content_sanskrit": "न ह्येतस्मिन् कुले जाता अधना अबहुप्रजाः।\nअल्पायुषोऽल्पवीर्या वा अब्रह्मण्याश्च जज्ञिरे॥ १०/१०५/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.028.m4a", "display_order": 29}, {"id": 6000301029, "chapter_id": 10301, "verse_number": "१०-१०५-२८", "content_sanskrit": "यदुवंशे प्रसूतानां पुंसां विख्यातकर्मणाम्।\nसङ्ख्या न शक्यते कर्तुमपि वर्षायुतैर्नृप॥ १०/१०५/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.029.m4a", "display_order": 30}, {"id": 6000301030, "chapter_id": 10301, "verse_number": "१०-१०५-२९", "content_sanskrit": "तिस्रः कोट्यः सहस्राणामष्टाशीतिशतानि च।\nआसन् यदुकुमाराणामाचार्या इति नः श्रुतम्॥ १०/१०५/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.030.m4a", "display_order": 31}, {"id": 6000301031, "chapter_id": 10301, "verse_number": "१०-१०५-३०", "content_sanskrit": "सङ्ख्यानं यादवानां कः करिष्यति महात्मनाम्।\nयत्रायुतानामयुतं रक्षन्नास्ते स आहुकः॥ १०/१०५/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.031.m4a", "display_order": 32}, {"id": 6000301032, "chapter_id": 10301, "verse_number": "१०-१०५-३१", "content_sanskrit": "देवासुराहवहता ये दैतेयाः सुदारुणाः।\nते चोत्पन्ना मनुष्येषु प्रजा दृप्ता बबाधिरे॥ १०/१०५/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.032.m4a", "display_order": 33}, {"id": 6000301033, "chapter_id": 10301, "verse_number": "१०-१०५-३२", "content_sanskrit": "तन्निग्रहाय हरिणा प्रोक्ता देवा यदोः कुले।\nअवतीर्णाः कुलशतं येषामेकाधिकं नृप॥ १०/१०५/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.033.m4a", "display_order": 34}, {"id": 6000301034, "chapter_id": 10301, "verse_number": "१०-१०५-३३", "content_sanskrit": "तेषां प्रमाणं भगवान् प्रभुत्वे चाभवद् हरिः।\nये चानुवर्तिनस्तस्य ववृधुः सर्वयादवाः॥ १०/१०५/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.034.m4a", "display_order": 35}, {"id": 6000301035, "chapter_id": 10301, "verse_number": "१०-१०५-३४", "content_sanskrit": "शय्यासनाटनालापक्रीडास्नानाशनादिषु।\nन विदुः सन्तमात्मानं वृष्णयः कृष्णचेतसः॥ १०/१०५/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.035.m4a", "display_order": 36}, {"id": 6000301036, "chapter_id": 10301, "verse_number": "१०-१०५-३५", "content_sanskrit": "ईजे क्रतुभिरात्मानं सर्ववेदार्थसङ्ग्रहम्।\nस्वयोगमायारचितैः कुरुक्षेत्रे द्विषट्समाः॥ १०/१०५/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.036.m4a", "display_order": 37}, {"id": 6000301037, "chapter_id": 10301, "verse_number": "१०-१०५-३६", "content_sanskrit": "कृष्णगाध्यसितावन्तिरामाचार्योद्धवेश्वरः।\nदीक्षितोऽग्रण्यपत्नीभिः पुण्यश्लोकः सहाग्रणीः॥ १०/१०५/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.037.m4a", "display_order": 38}, {"id": 6000301038, "chapter_id": 10301, "verse_number": "१०-१०५-३७", "content_sanskrit": "तीर्थं चक्रे नृणां यो यदजनि यदुषु स्वःसरित् पादशौचं\nषड्भिश्चाप्तं स्वरूपं पर उरसि रमा सर्वदा यस्य चास्ते।\nयच्छास्‍त्रं तत्प्रमाणं यदनु च सदसव्द्यक्तयो यत्र धर्माः\nकृष्णस्यैतन्न चित्रं क्षितिभरहरणं कालचक्रायुधस्य॥ १०/१०५/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.038.m4a", "display_order": 39, "topics": [{"text": "भगवत्स्तुतिपूर्वकं शुकस्य स्कन्धसमापनं च", "range": "३७–४२"}]}, {"id": 6000301039, "chapter_id": 10301, "verse_number": "१०-१०५-३८", "content_sanskrit": "जयति जननिवासो देवकीजन्मवादो नियमकृतपदाब्जैर्दस्युपीडां स्वदोर्भिः।\nमुदमुभयदृशीनां श्रीनिकेतात्ममूर्त्या स्मरवपुरबलानां स्निग्धहासेक्षया च॥ १०/१०५/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.039.m4a", "display_order": 40}, {"id": 6000301040, "chapter_id": 10301, "verse_number": "१०-१०५-३९", "content_sanskrit": "यो ह्यात्मा जगदादिमध्यनिधनो योऽव्यक्तजीवेश्वरो\nयः सृष्ट्वेदमनुप्रविष्ट ऋषिणा चक्रे पुनः संहिताम्।\nयं सम्पद्य जहात्यजामनुशयी सुप्तः कुलायं यथा।\nतं कैवल्यनिरस्तयोनिमभयं ध्यायेदजस्रं हरिम्॥ १०/१०५/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.040.m4a", "display_order": 41}, {"id": 6000301041, "chapter_id": 10301, "verse_number": "१०-१०५-४०", "content_sanskrit": "इत्थं परस्य निजधर्मरिरक्षयाऽत्तलीलातनोस्तदनुरूपविडम्बनानि।\nकर्माणि कर्मकषणानि यदूत्तमस्य गायेदमुष्य पदयोरनुवृत्तिमिच्छन्॥ १०/१०५/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.041.m4a", "display_order": 42}, {"id": 6000301042, "chapter_id": 10301, "verse_number": "१०-१०५-४१", "content_sanskrit": "मर्त्यस्तयाऽनुसवमेधितयाऽनुवृत्त्या श्रीमत्कथाश्रवणकीर्तनचिन्तयैति।\nतद्धाम दुष्करकृतं जनतापवर्गं ग्रामाद् वनं क्षितिभुजोऽपि ययुर्यदर्थे॥ १०/१०५/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.042.m4a", "display_order": 43}, {"id": 6000301043, "chapter_id": 10301, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.043.m4a", "display_order": 44}, {"id": 6000301044, "chapter_id": 10301, "verse_number": "१०-१०५-४२", "content_sanskrit": "य इदमनुशृणोति श्रावयेद्वा मुरारेश्चरितममृतकीर्तेर्वर्णितं व्यासपुत्रैः।\nजगदघभिदलं तद्भक्तकर्णावतंसं भगवति कृतचित्तो याति तत्क्षेमधाम॥ १०/१०५/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_105/BhP_10.105.044.m4a", "display_order": 45}, {"id": 6000301045, "chapter_id": 10301, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धे पञ्चाधिकशततमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 6000301046, "chapter_id": 10301, "verse_number": null, "content_sanskrit": "॥ इति दशमस्कन्धपूर्वार्धः समाप्तः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 6000301047, "chapter_id": 10301, "verse_number": null, "content_sanskrit": "॥समाप्तश्च दशमस्कन्धः॥\n॥श्रीकृष्णार्पणमस्तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]