[{"id": 5000610000, "chapter_id": 9610, "verse_number": "७-७५-१", "content_sanskrit": "नारदस्य तु तद्वाक्यं श्रुत्वा ऽमृतमयं तदा ।\nप्रहर्षमतुलं लेभे लक्ष्मणं चेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000610001, "chapter_id": 9610, "verse_number": "७-७५-२", "content_sanskrit": "गच्छ सौम्य द्विजश्रेष्ठं समाश्वासय सुव्रतम् ।\nबालस्य तु शरीरं तत्तैलद्रोण्यां निधापय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000610002, "chapter_id": 9610, "verse_number": "७-७५-३", "content_sanskrit": "गन्धैश्च परमोदारैस्तैलैश्चापि सुगन्धिभिः ।\nयथा न क्षीयते बालस्तथा सौम्य विधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000610003, "chapter_id": 9610, "verse_number": "७-७५-४", "content_sanskrit": "यथा शरीरो बालस्य गुप्तः सन् शिष्टकर्मणः ।\nविपत्तिः परिभेदो वा न भवेच्च तथा कुरु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000610004, "chapter_id": 9610, "verse_number": "७-७५-५", "content_sanskrit": "एवमादिश्य काकुत्स्थो लक्ष्मणं शुभलक्षणम् ।\nमनसा पुष्पकं दध्यावागच्छेति महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000610005, "chapter_id": 9610, "verse_number": "७-७५-६", "content_sanskrit": "इङ्गितं स तु विज्ञाय पुष्पको हेमभूषितः ।\nआजगाम मुहूर्तेन समीपे राघवस्य वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000610006, "chapter_id": 9610, "verse_number": "७-७५-७", "content_sanskrit": "सो ऽब्रवीत्प्रणतो भूत्वा अयमस्मि नराधिप ।\nवश्यस्तव महाबाहो किङ्करः समुपस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000610007, "chapter_id": 9610, "verse_number": "७-७५-८", "content_sanskrit": "भाषितं रुचिरं श्रुत्वा पुष्पकस्य नराधिपः ।\nअभिवाद्य महर्षींस्तान् विमानं सो ऽध्यरोहत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000610008, "chapter_id": 9610, "verse_number": "७-७५-९", "content_sanskrit": "धनुर्गृहीत्वा तूणी च खड्गं च रुचिरप्रभम् ।\nनिक्षिप्य नगरे वीरौ सौमित्रिभरतावुभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000610009, "chapter_id": 9610, "verse_number": "७-७५-१०", "content_sanskrit": "प्रायात्प्रतीचीं हरितं विचिन्वंश्च ततस्ततः ।\nउत्तरामगमच्छ्रीमान्दिशं हिमवता वृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000610010, "chapter_id": 9610, "verse_number": "७-७५-११", "content_sanskrit": "अपश्यमानस्तत्रापि स्वल्पमप्यथ दुष्कृतम् ।\nपूर्वामपि दिशं सर्वामथो ऽपश्यन्नराधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000610011, "chapter_id": 9610, "verse_number": "७-७५-१२", "content_sanskrit": "प्रविशुद्धसमाचारामादर्शतलनिर्मलाम् ।\nपुष्पकस्थो महाबाहुस्तदापश्यन्नराधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000610012, "chapter_id": 9610, "verse_number": "७-७५-१३", "content_sanskrit": "दक्षिणां दिशमाक्रामत्ततो राजर्षिनन्दनः ।\nशैवलस्योत्तरे पार्श्वे ददर्श सुमहत्सरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000610013, "chapter_id": 9610, "verse_number": "७-७५-१४", "content_sanskrit": "तस्मिन्सरसि तप्यन्तं तापसं सुमहत्तपः ।\nददर्श राघवः श्रीमाँल्लम्बमानमधोमुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000610014, "chapter_id": 9610, "verse_number": "७-७५-१५", "content_sanskrit": "राघवस्तमुपागम्य तप्यन्तं तप उत्तमम् ।\nउवाच स तदा वाक्यं धन्यस्त्वमसि सुव्रत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000610015, "chapter_id": 9610, "verse_number": "७-७५-१६", "content_sanskrit": "कस्यां योन्यां तपोवृद्ध वर्तसे दृढविक्रम ।\nकौतूहलात्त्वां पृच्छामि रामो दाशरथिर्ह्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000610016, "chapter_id": 9610, "verse_number": "७-७५-१७", "content_sanskrit": "को ऽर्थो मनीषितस्तुभ्यं स्वर्गलाभः परो ऽथवा ।\nवराश्रयो यदर्थं त्वं तपस्यसि सुदुष्करम् ।\nयमाश्रित्य तपस्तप्तं श्रोतुमिच्छामि तापस ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000610017, "chapter_id": 9610, "verse_number": "७-७५-१८", "content_sanskrit": "ब्राह्मणो वा ऽसि भद्रं ते क्षत्रियो वा ऽसि दुर्जयः ।\nवैश्यस्तृतीयवर्णो वा शूद्रो वा सत्यवाग्भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000610018, "chapter_id": 9610, "verse_number": "७-७५-१९", "content_sanskrit": "इत्येवमुक्तः स नराधिपेन ह्यवाक्छिरा दाशरथाय तस्मै ।\nउवाच जातिं नृपपुङ्गवाय यत्कारणे चैव तपःप्रयत्नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000610019, "chapter_id": 9610, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे पञ्चसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]