[{"id": 7005533000, "chapter_id": 25533, "verse_number": "६-१", "content_sanskrit": "कश्यपान्वयवर्णनम् ।\nसूत उवाच ।\nकश्यपस्य प्रवक्ष्यामि पत्नीभ्यः पुत्र पौत्रकान् ।\nअदितिर्दितिर्दनुश्चैव अरिष्टा सुरसा तथा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005533001, "chapter_id": 25533, "verse_number": "६-२", "content_sanskrit": "सुरभिर्विनता तद्वत्ताम्रा क्रोधवशा इरा ।\nकद्रूर्विश्वा मुनिस्तद्वत्तासां पुत्रान्निबोधत ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005533002, "chapter_id": 25533, "verse_number": "६-३", "content_sanskrit": "तुषिता नाम ये देवाश्चाक्षुषस्यान्तरे मनोः ।\nवैवस्वतेऽन्तरे चैते आदित्या द्वादशस्मृताः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005533003, "chapter_id": 25533, "verse_number": "६-४", "content_sanskrit": "इन्द्रो धाता भगस्त्वष्टा मित्रोऽथ वरुणो यमः ।\nविवस्वान्‌ सवितापूषा अंशुमान्‌ विष्णुरेव च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005533004, "chapter_id": 25533, "verse_number": "६-५", "content_sanskrit": "एते सहस्रकिरणा आदित्या द्वादश स्मृताः ।\nमारीचात् कश्यपादाप पुत्रानदितिरुत्तमान् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005533005, "chapter_id": 25533, "verse_number": "६-६", "content_sanskrit": "भृशाश्वस्य ऋषेः पुत्रा देवप्रहरणाः स्मृताः ।\nएते देवगणा विप्राः प्रतिमन्वन्तरेषु च ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005533006, "chapter_id": 25533, "verse_number": "६-७", "content_sanskrit": "उत्पद्यन्ते प्रलीयन्ते कल्पेकल्पे तथैव च ।\nदितिः पुत्रद्वयं लेभे कश्यपादिति नः श्रुतम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005533007, "chapter_id": 25533, "verse_number": "६-८", "content_sanskrit": "हिरण्यकशिपुञ्चैव हिरण्याक्षं तथैव च ।\nहिरण्यकशिपोस्तद्वज्जातां पुत्रचतुष्टयम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005533008, "chapter_id": 25533, "verse_number": "६-९", "content_sanskrit": "प्रह्लादश्चानुह्लादश्च संह्लादोह्लाद एव च ।\nप्रह्लादपुत्र आयुष्मान् शिविर्वाष्कल एव च ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005533009, "chapter_id": 25533, "verse_number": "६-१०", "content_sanskrit": "विरोचनश्चतुर्थश्च स बलिं पुत्रमाप्तवान् ।\nबलेः पुत्रशतं त्वासीद् बाणज्येष्ठं ततो द्विजाः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005533010, "chapter_id": 25533, "verse_number": "६-११", "content_sanskrit": "धृतराष्ट्रस्तथा सूर्यश्चन्द्रश्चन्द्रांशुतापनः ।\nनिकुम्भनाभो गुर्वक्षः कुक्षिभीमो विभीषणः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005533011, "chapter_id": 25533, "verse_number": "६-१२", "content_sanskrit": "एवमाद्यास्तु बहवो बाणज्येष्ठा गुणाधिकाः ।\nबाणः सहस्रबाहुश्च सर्वास्त्रगणसंयुतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005533012, "chapter_id": 25533, "verse_number": "६-१३", "content_sanskrit": "तपसा तोषितो यस्य पुरे वसति शूलभृत् ।\nमहाकालत्वमगमत्साम्यं यश्च पिनाकिनः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005533013, "chapter_id": 25533, "verse_number": "६-१४", "content_sanskrit": "हिरण्याक्षस्य पुत्रोऽभूदुलूकः शकुनिस्तथा ।\nभूतसन्तापनश्चैव महानाभस्तथैव च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005533014, "chapter_id": 25533, "verse_number": "६-१५", "content_sanskrit": "एतेभ्यः पुत्रपौत्राणां कोटयः सप्तसप्ततिः ।\nमहाबला महाकाया नानारूपा महौजसः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005533015, "chapter_id": 25533, "verse_number": "६-१६", "content_sanskrit": "दनुः पुत्रशतं लेभे कश्यपाद्‌ बलदर्पितम् ।\nविप्रचित्तिः प्रधानोऽभूद्येषां मध्ये महाबलः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005533016, "chapter_id": 25533, "verse_number": "६-१७", "content_sanskrit": "द्विमूर्द्धा शकुनिश्चैव तथा शङ्कुशिरोधरः ।\nअयोमुखः शम्वरश्च कपिशो नामतस्तथा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005533017, "chapter_id": 25533, "verse_number": "६-१८", "content_sanskrit": "मारीचिर्मेघवांश्चैव इरा गर्भशिरास्तथा ।\nविद्रावणश्च केतुश्च केतुवीर्यः शतह्लदः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005533018, "chapter_id": 25533, "verse_number": "६-१९", "content_sanskrit": "इन्द्रजित् सप्तजिच्चैव वज्रनाभस्तथैव च ।\nएकचक्रो महाबाहुर्वज्राक्षस्तारकस्तथा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005533019, "chapter_id": 25533, "verse_number": "६-२०", "content_sanskrit": "असिलोमा पुलोमा च विन्दुर्वाणो महासुरः ।\nस्वर्भानुर्वृषपर्वा च एवमाद्या दनोः सुताः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005533020, "chapter_id": 25533, "verse_number": "६-२१", "content_sanskrit": "स्वर्भानोस्तु प्रभा कन्या शची चैव पुलोमजा ।\nउपदानवी मयस्यासीत्तथा मन्दोदरी कुहूः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005533021, "chapter_id": 25533, "verse_number": "६-२२", "content_sanskrit": "शर्मिष्ठा सुन्दरी चैव चन्द्रा च वृषपर्वणः ।\nपुलोमा कालका चैव वैश्वानरसुते हि ते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005533022, "chapter_id": 25533, "verse_number": "६-२३", "content_sanskrit": "बह्वपत्ये महासत्वे मारीचस्य परिग्रहे ।\nतयोः षष्टिसहस्रापि दानवानामभूत्पुरा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005533023, "chapter_id": 25533, "verse_number": "६-२४", "content_sanskrit": "पौलोमन् कालकेयांश्च मारीचोऽजनयत्पुरा ।\nअवध्या येऽमराणां वै हिरण्यपुरवासिनः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005533024, "chapter_id": 25533, "verse_number": "६-२५", "content_sanskrit": "चतुर्मुखाल्लब्धवरास्ते हता विजयेन तु ।\nविप्रचित्तिः सैहिकेयान् सिंहिकायामजीजनत् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005533025, "chapter_id": 25533, "verse_number": "६-२६", "content_sanskrit": "हिरण्यकशिपोर्ये वै भागिनेयास्त्रयोदश ।\nव्यंसः कल्पश्च राजेन्द्र! नलो वातापिरेव च ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005533026, "chapter_id": 25533, "verse_number": "६-२७", "content_sanskrit": "इल्वलो नमुचिश्चैव श्वसृपश्चाजनस्तथा ।\nनरकः कालनाभश्च सरमाणस्तथैव च ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005533027, "chapter_id": 25533, "verse_number": "६-२८", "content_sanskrit": "कालवीर्यश्च विख्यातो दनुवंशविवर्धनाः ।\nसंह्लादयस्य तु दैत्यस्य निवातकवचाः स्मृताः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005533028, "chapter_id": 25533, "verse_number": "६-२९", "content_sanskrit": "अबध्याः सर्वदेवानां गन्धर्वोरगरक्षसाम् ।\nये हता भर्गमाश्रित्य त्वर्जुनेन रणाजिरे ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005533029, "chapter_id": 25533, "verse_number": "६-३०", "content_sanskrit": "षट्‌कन्या जनयामास ताम्रा मारीचवीजतः ।\nशुकीश्येनीचभासीच सुग्रीवी गृध्रिका शुचिः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005533030, "chapter_id": 25533, "verse_number": "६-३१", "content_sanskrit": "शुकी शुकानुलूकांश्च जनयामास धर्मतः ।\nश्येनी श्येनांस्तथा भासी कुररानप्यजीजनत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005533031, "chapter_id": 25533, "verse_number": "६-३२", "content_sanskrit": "गृध्री गृध्रान् कपोतांश्च पारावतविहङ्गमान् ।\nहंससारसक्रौञ्चांश्च प्लवान् शुचिरजीजनत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005533032, "chapter_id": 25533, "verse_number": "६-३३", "content_sanskrit": "अजाश्वमेषोष्ट्रखरान् सुग्रीवी चाप्यजीजनत् ।\nएषताम्रान्वयः प्रोक्तो विनतायां निबोधत ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005533033, "chapter_id": 25533, "verse_number": "६-३४", "content_sanskrit": "गरुडः पततां नाथो अरुणश्च पतत्त्रिणाम् ।\nसौदामिनी तथा कन्या येयं नभसि विश्रुता ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005533034, "chapter_id": 25533, "verse_number": "६-३५", "content_sanskrit": "सम्पातिश्च जटायुश्च अरुणस्य तु तावुभौ ।\nसम्पातिपुत्रो बभ्रुश्च शीघ्रगश्चापि विश्रुतः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005533035, "chapter_id": 25533, "verse_number": "६-३६", "content_sanskrit": "जटायुषः कर्णिकारः शतगामी च विश्रुतौ ।\nसारसो रज्जुबालश्च भेरुण्डश्चापि तत्सुताः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005533036, "chapter_id": 25533, "verse_number": "६-३७", "content_sanskrit": "तेषामनन्तमभवत् पक्षिणां पुत्र पौत्रकम् ।\nसुरसायाः सहस्रन्तु सर्पाणामभवत्पुरा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005533037, "chapter_id": 25533, "verse_number": "६-३८", "content_sanskrit": "सहस्रशिरसाङ्कद्रूः सहस्रञ्चापि सुव्रत! ।\nप्रधानास्तेषु विख्याताः षड्‌विंशतिररिन्दम ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005533038, "chapter_id": 25533, "verse_number": "६-३९", "content_sanskrit": "शेषवासुकिकर्कोट शङ्खैरावतकम्बलाः ।\nधनञ्चयमहानील पद्माश्वतरतक्षकाः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005533039, "chapter_id": 25533, "verse_number": "६-४०", "content_sanskrit": "एलापत्रमहापद्मधृतराष्ट्रबलाहकाः ।\nशङ्खपाल—महाशङ्ख–पुष्पदंष्ट्र–शुभाननाः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005533040, "chapter_id": 25533, "verse_number": "६-४१", "content_sanskrit": "शङ्करोमा च बहुलो वामनः पाणिनस्तथा ।\nकपिलोदुर्मुखश्चापि पतञ्जलिरितिस्मृताः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005533041, "chapter_id": 25533, "verse_number": "६-४२", "content_sanskrit": "एषामनन्तमभवत् सर्वेषां पुत्र पौत्रकम् ।\nप्रायशो यत् पुरा दग्धं जनमेजयमन्दिरे ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005533042, "chapter_id": 25533, "verse_number": "६-४३", "content_sanskrit": "रक्षोगणं क्रोधवशा स्वनामानमजीजनत् ।\nदंष्ट्रिणां नियुतं तेषां भीमसेनादगात्‌ क्षयम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005533043, "chapter_id": 25533, "verse_number": "६-४४", "content_sanskrit": "रुद्राणाञ्च गणं तद्वद्‌ गोमहिष्यो वराङ्गनाः ।\nसुरभिर्जनयामास कश्यपात् संयतव्रता ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005533044, "chapter_id": 25533, "verse_number": "६-४५", "content_sanskrit": "मुनिर्मुनीनाञ्च गणं गणमप्सरसां तथा ।\nतथा किन्नरगन्धर्व्वानरिष्टाऽजनयदत् बहून् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005533045, "chapter_id": 25533, "verse_number": "६-४६", "content_sanskrit": "तृण वृक्ष लता गुल्ममिरा सर्वमजीजनत्! ।\nविश्वा तु यक्ष रक्षांसि जनयामास कोटिशः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005533046, "chapter_id": 25533, "verse_number": "६-४७", "content_sanskrit": "तत एकोनपञ्चाशन्मरुतः कश्यपाद्दितिः ।\nजनयामास धर्म्मज्ञान् सर्वानमरवल्लभान् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]