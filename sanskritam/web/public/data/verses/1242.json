[{"id": 2011821, "chapter_id": 1242, "verse_number": "१-२४३-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2011822, "chapter_id": 1242, "verse_number": "१-२४३-१", "content_sanskrit": "वृष्म्यन्धकपुरात्तस्मादपयातुं धनञ्जयः।\nविनिश्चित्य तया सार्धं सुभद्रामिदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2011823, "chapter_id": 1242, "verse_number": "१-२४३-२", "content_sanskrit": "द्विजानां गुणमुख्यानां यथार्हं प्रतिपादय।\nभोज्यैर्भक्ष्यैश्च कामैश्च स्वपुरीं प्रतियास्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2011824, "chapter_id": 1242, "verse_number": "१-२४३-३", "content_sanskrit": "आत्मनश्च समुद्दिश्य महाव्रतसमापनम्।\nगच्छ भद्रे स्वयं तूर्णं महाराजनिवेशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2011825, "chapter_id": 1242, "verse_number": "१-२४३-४", "content_sanskrit": "तेजोबलजवोपेतैः शुक्लैर्हयवरोत्तमैः।\nवाजिभिः शैव्यसुग्रीवमेघपुष्पबलाहकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2011826, "chapter_id": 1242, "verse_number": "१-२४३-५", "content_sanskrit": "युक्तं रथवरं तूर्णमिहानय सुसत्कृतम्।\nव्रतार्थमिति भाषित्वा सखीभिः सुभगे सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2011827, "chapter_id": 1242, "verse_number": "१-२४३-६", "content_sanskrit": "क्षिप्रमादाय पर्येहि सह सर्वायुधेन च।\nअनुकर्षान्तपताकाश्च तूणीरांश्च धनूंषि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2011828, "chapter_id": 1242, "verse_number": "१-२४३-७", "content_sanskrit": "सर्वान्रथवरे स्थाप्य सोत्सेधाश्च महागदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2011829, "chapter_id": 1242, "verse_number": "१-२४३-८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2011830, "chapter_id": 1242, "verse_number": "१-२४३-८", "content_sanskrit": "अर्जुनेनैवमुक्ता सा सुभद्रा भद्रभाषिणी।\nजगाम नृपतेर्वेश्म सखीभिः सहिता तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2011831, "chapter_id": 1242, "verse_number": "१-२४३-९", "content_sanskrit": "व्रतार्थमिति तत्रस्थान्रक्षिणो वाक्यमब्रवीत्।\nरथेनानेन यास्यामि महाव्रतसमापनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2011832, "chapter_id": 1242, "verse_number": "१-२४३-१०", "content_sanskrit": "शैब्यसुग्रीवयुक्तेन सायुधेनैव शार्ङ्गिणः।\nरथेन रमणीयेन प्रयास्यामि व्रतार्थिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2011833, "chapter_id": 1242, "verse_number": "१-२४३-११", "content_sanskrit": "सुभध्रयैवमुक्ते तु जनाः प्राञ्जलयोऽभवन्।\nयोजयित्वा रथवरं कल्याणैरभिभाष्य ताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2011834, "chapter_id": 1242, "verse_number": "१-२४३-१२", "content_sanskrit": "यथोक्तं सर्वमारोप्य आयुधानि च भामिनी।\nक्षिप्रमादाय कल्याणी सुभद्राऽर्जुनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2011835, "chapter_id": 1242, "verse_number": "१-२४३-१३", "content_sanskrit": "रथोऽयं रथिनां श्रेष्ठ आनीतस्तव शासनात्।\nस त्वं याहि यथाकामं कुरून्कौरवनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2011836, "chapter_id": 1242, "verse_number": "१-२४३-१४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2011837, "chapter_id": 1242, "verse_number": "१-२४३-१४", "content_sanskrit": "निवेद्य तु रथं भर्तुः सुभद्रा भद्रसंमता।\nब्राह्मणानां तदा हृष्टा ददौ सा विविधं वसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2011838, "chapter_id": 1242, "verse_number": "१-२४३-१५", "content_sanskrit": "स्नेहवन्ति च भोज्यानि प्रददावीप्सितानि च।\nयथाकामं यथाश्रद्धं वस्त्राणि विविधानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2011839, "chapter_id": 1242, "verse_number": "१-२४३-१६", "content_sanskrit": "तर्पिता विविधैर्भोज्यैस्तान्यवाप्य वसूनि च।\nब्राह्मणाः स्वगृहं जग्मुः प्रयुज्य परमाशिषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2011840, "chapter_id": 1242, "verse_number": "१-२४३-१७", "content_sanskrit": "सुभद्रया तु विज्ञप्तः पूर्वमेव धनञ्जयः।\nअभीशुग्रहणे पार्थ न मेऽस्ति सदृशो भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2011841, "chapter_id": 1242, "verse_number": "१-२४३-१८", "content_sanskrit": "तस्मात्सा पूर्वमारुह्य रश्मीञ्जग्राह माधवी।\nसोदरा वासुदेवस्य कृतस्वस्त्ययना हयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2011842, "chapter_id": 1242, "verse_number": "१-२४३-१९", "content_sanskrit": "व्यत्ययित्वा तु तल्लिङ्गं यतिवेषं धनञ्जयः।\nआमुच्य कवचं वीरः समुच्छ्रितमहद्धनुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2011843, "chapter_id": 1242, "verse_number": "१-२४३-२०", "content_sanskrit": "आरुरोह रथश्रेष्ठं शुक्लवासा धनञ्जयः।\nमहेन्द्रदत्तं मुकुटं तथैवाभरणानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2011844, "chapter_id": 1242, "verse_number": "१-२४३-२१", "content_sanskrit": "अलङ्कृत्य तु कौन्तेयः प्रयातुमुपचक्रमे।\nततः कन्यापुरे घोषस्तुमुलः समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2011845, "chapter_id": 1242, "verse_number": "१-२४३-२२", "content_sanskrit": "दृष्ट्वा नववरं पार्थं बाणखड्गधनुर्धरम्।\nअभीशुहस्तां सुश्रोणीमर्जुनेन रथे स्थिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2011846, "chapter_id": 1242, "verse_number": "१-२४३-२३", "content_sanskrit": "ऊचुः कन्यास्तदा यान्तीं वासुदेवसहोदराम्।\nसर्वकामसमृद्धा त्वं सुभद्रे भद्रभाषिणि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2011847, "chapter_id": 1242, "verse_number": "१-२४३-२४", "content_sanskrit": "वासुदेवप्रियं लब्ध्वा भर्तारं वीरमर्जुनम्।\nसर्वसीमन्तिनीनां त्वां श्रेष्ठां कृष्णसहोदरीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2011848, "chapter_id": 1242, "verse_number": "१-२४३-२५", "content_sanskrit": "मन्यामहे महाभागे सुभद्रे भद्रभाषिणि।\nयस्मात्सर्वमनुष्याणां श्रेष्ठो भर्ता तवार्जुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2011849, "chapter_id": 1242, "verse_number": "१-२४३-२६", "content_sanskrit": "उपपन्नस्त्वया वीरः सर्वलोकमहारथः।\nहे प्रयाहि गृहान्भद्रे सुहृद्भिः संगमोऽस्तु ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2011850, "chapter_id": 1242, "verse_number": "१-२४३-२७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2011851, "chapter_id": 1242, "verse_number": "१-२४३-२७", "content_sanskrit": "एवमुक्ता प्रहृष्टाभिः सखीभिः प्रतिनन्दिता।\nभद्रा भद्रजवोपेतानश्वान्पुनरचोदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2011852, "chapter_id": 1242, "verse_number": "१-२४३-२८", "content_sanskrit": "पार्श्वे चामरहस्ता सा सखी तस्याङ्गनाऽभवत्।\nततः कन्यापुरद्वारात्सघोषादभिनिःसृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2011853, "chapter_id": 1242, "verse_number": "१-२४३-२९", "content_sanskrit": "ददृशुस्तं रथश्रेष्ठं जना जीमूतनिस्वनम्।\nसुभद्रासङ्गृहीतस्य रथस्य महतः स्वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2011854, "chapter_id": 1242, "verse_number": "१-२४३-३०", "content_sanskrit": "मेघस्वनमिवाकाशे शुश्रुवुः पुरवासिनः।\nसुभद्रया तु संपन्ने तिष्ठन्रथवरेऽर्जुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2011855, "chapter_id": 1242, "verse_number": "१-२४३-३१", "content_sanskrit": "प्रबभौ च तयोपेतः कैलास इव गङ्गया।\nपार्थः सुभद्रासहितो विरराज महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2011856, "chapter_id": 1242, "verse_number": "१-२४३-३२", "content_sanskrit": "विराजते यथा शक्रो राजञ्शच्या समन्वितः।\nसुभद्रां प्रेक्ष्य पार्थेन ह्रियमाणां यशस्विनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2011857, "chapter_id": 1242, "verse_number": "१-२४३-३३", "content_sanskrit": "चक्रुः किलकिलाशब्दानासाद्य बहवो जनाः।\nदाशार्हाणां कुलस्य श्रीः सुभद्रा मद्रभाषिणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2011858, "chapter_id": 1242, "verse_number": "१-२४३-३४", "content_sanskrit": "अभिकामा सकामेन पार्थेन सह गच्छति।\nअथापरे तु संक्रुद्धा गृह्णीत घ्नत माचिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2011859, "chapter_id": 1242, "verse_number": "१-२४३-३५", "content_sanskrit": "इति संवार्य शस्त्राणि ववर्षुरभितो दिशम्।\nइति संभाषमाणानां स नादः सुमहानभूत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2011860, "chapter_id": 1242, "verse_number": "१-२४३-३६", "content_sanskrit": "स तेन जनघोषेण वीरो गज इवार्दितः।\nववर्ष शरवर्षाणि न तु कंचन रोषयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2011861, "chapter_id": 1242, "verse_number": "१-२४३-३७", "content_sanskrit": "मुमोच निशितान्बाणान्दीप्यमानान्स्वतेजसा।\nप्रासादवरसङ्घेषु हर्म्येषु भवनेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2011862, "chapter_id": 1242, "verse_number": "१-२४३-३८", "content_sanskrit": "क्षोभयित्वा पुरश्रेष्ठं गरुत्मानिव सागरम्।\nप्रेक्षन्रैवकतद्वारं निर्ययौ भरतर्षभः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2011863, "chapter_id": 1242, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि सुभद्राहरणपर्वणि त्रिचत्वारिंशदधिकद्विशततमोऽध्यायः॥ २४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]