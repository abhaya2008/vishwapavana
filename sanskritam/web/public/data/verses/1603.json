[{"id": 2028002, "chapter_id": 1603, "verse_number": "३-२४१-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2028003, "chapter_id": 1603, "verse_number": "३-२४१-१", "content_sanskrit": "अथ दुर्योधनो राजा तत्रतत्र वने वसन्।\nजगाम घोषानभितस्तत्र चक्रे निवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2028004, "chapter_id": 1603, "verse_number": "३-२४१-२", "content_sanskrit": "रमणीये समाज्ञाते सोदके समहीरुहे।\nदेशे सर्वगुणोपेते चक्रुरावसथान्नराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2028005, "chapter_id": 1603, "verse_number": "३-२४१-३", "content_sanskrit": "तथैव तत्समीपस्थान्पृथगावसथान्बहून्।\nकर्णस्य शकुनेश्चैव भ्रातॄणां चैव सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2028006, "chapter_id": 1603, "verse_number": "३-२४१-४", "content_sanskrit": "पश्यन्तस्ते तदा गावः शतशोऽथ सहस्रशः।\nअङ्कर्लक्षैश्च ताः सर्वा लक्षयामास पार्थिवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2028007, "chapter_id": 1603, "verse_number": "३-२४१-५", "content_sanskrit": "अङ्कयामास वत्सांश्च जज्ञे चोपसृतांस्त्वपि।\nबालवत्साश्च यां गावः कालयामास ता अपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2028008, "chapter_id": 1603, "verse_number": "३-२४१-६", "content_sanskrit": "अथ स स्मारणं कृत्वा लक्षयित्वा त्रिहायनान्।\nवृतो गोपालकैः प्रीतो व्याहरत्कुरुनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2028009, "chapter_id": 1603, "verse_number": "३-२४१-७", "content_sanskrit": "स च पौरजनः सर्वः सर्वः सैनिकाश्च सहस्रशः।\nयथोपजोषं चिक्रीडुर्वने तस्मिन्यथाऽमराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2028010, "chapter_id": 1603, "verse_number": "३-२४१-८", "content_sanskrit": "ततोऽध्वगमनाच्छ्रान्तं कुशला नृत्यवादितैः।\nधार्तराष्ट्रमुपातिष्ठन्कन्याश्चैव स्वलंकृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2028011, "chapter_id": 1603, "verse_number": "३-२४१-९", "content_sanskrit": "स स्त्रीगणवृतो राजा प्रहृष्टः प्रददौ वसु।\nतेभ्यो यथार्हमन्नानि पानानि विविधानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2028012, "chapter_id": 1603, "verse_number": "३-२४१-१०", "content_sanskrit": "ततस्ते सहिताः सर्वे तरक्षून्महिषान्मृगान्।\nगवयर्क्षवराहांश्च समन्तात्पर्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2028013, "chapter_id": 1603, "verse_number": "३-२४१-११", "content_sanskrit": "स ताञ्छरैर्विनिर्भिद्य गजांश्च सुबहून्वने।\nरमणीयेषु देशेषु ग्राहयामास वै मृगान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2028014, "chapter_id": 1603, "verse_number": "३-२४१-१२", "content_sanskrit": "गोरसानुपयुञ्जान उपभोगांशच् भारत।\nपश्यन्स रमणीयानि वनान्युपवनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2028015, "chapter_id": 1603, "verse_number": "३-२४१-१३", "content_sanskrit": "मत्तभ्रमरजुष्टानि बर्हिणाभिरुतानि च।\nअगच्छदानुपूर्व्येण पुण्यं द्वैतवनं सरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2028016, "chapter_id": 1603, "verse_number": "३-२४१-१४", "content_sanskrit": "मत्तभ्रमरसंजुष्टं नीलकण्ठरवाकुलम्।\nसप्तच्छदसमाकीर्णं पुन्नागवकुलैर्युतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2028017, "chapter_id": 1603, "verse_number": "३-२४१-१५", "content_sanskrit": "ऋद्ध्या परमया युक्तो महेन्द्र इव वज्रभृत्।\nयदृच्छया च तत्रस्थो धर्मपुत्रो युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2028018, "chapter_id": 1603, "verse_number": "३-२४१-१६", "content_sanskrit": "ईजे राजर्षियज्ञेन साद्यस्केन विशांपते।\nदिव्येन विधिना चैव वन्येन कुरुसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2028019, "chapter_id": 1603, "verse_number": "३-२४१-१७", "content_sanskrit": "`विद्वद्भिः सहितो धीमान्ब्राह्मणैर्वनवासिभिः।\nकृत्वा निवेशमभितः सरसस्तस्य कौरव।\nद्रौपद्या सहितो धीमान्धर्मपत्न्या नराधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2028020, "chapter_id": 1603, "verse_number": "३-२४१-१८", "content_sanskrit": "ततो दुर्योधनः प्रेष्यानादिदेश सहानुजः।\nआक्रीडावसथाञ्शीघ्रं कुरुध्वं सरसोऽभितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2028021, "chapter_id": 1603, "verse_number": "३-२४१-१९", "content_sanskrit": "ते तथेत्येव कौरव्यमुक्त्वा वचनकारिणः।\nचिकीर्षन्तस्तदाक्रीडाञ्जग्मुर्द्वैतवनं सरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2028022, "chapter_id": 1603, "verse_number": "३-२४१-२०", "content_sanskrit": "सेनाग्र्यं धार्तराष्ट्रस् प्राप्तं द्वैतवनं सरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2028023, "chapter_id": 1603, "verse_number": "३-२४१-२१", "content_sanskrit": "प्रविशन्तं वनद्वारि गन्धर्वाः समवारयन्।\nतत्र गन्धऱ्वराजो वै पूर्वमेव विशांपते।\nकुबेरभवनाद्राजन्नाजगाम गणावृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2028024, "chapter_id": 1603, "verse_number": "३-२४१-२२", "content_sanskrit": "गणैरप्सरसां चैव त्रिदशानां तथाऽऽत्मजैः।\nविहारशीलैः क्रीडार्थं तेन तत्संवृतं सरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2028025, "chapter_id": 1603, "verse_number": "३-२४१-२३", "content_sanskrit": "तेन तत्संवृतं दृष्ट्वा ते राजपरिचारकाः।\nप्रतिजग्मुस्ततो राजन्यत्र दुर्योधनो नृपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2028026, "chapter_id": 1603, "verse_number": "३-२४१-२४", "content_sanskrit": "स तु तेषां वचः श्रुत्वा सैनिकान्युद्धदुर्मदान्।\nप्रेषयामास कौरव्य उत्सारयत तानिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2028027, "chapter_id": 1603, "verse_number": "३-२४१-२५", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा राज्ञः सेनाग्रयायिनः।\nसरो द्वैनवनं गत्वा गन्धर्वानिदमब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2028028, "chapter_id": 1603, "verse_number": "३-२४१-२६", "content_sanskrit": "राजा दुर्योधनो नाम धृतराष्ट्रसुतो बली।\nचिक्रीडिषुरिहायाति तदर्थमपसर्पत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2028029, "chapter_id": 1603, "verse_number": "३-२४१-२७", "content_sanskrit": "एवमुक्तास्तु गन्धर्वाः रप्रहसन्तो विशांमपते।\nप्रत्यब्रुवंस्तान्पुरुषानिदं हि परुषं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2028030, "chapter_id": 1603, "verse_number": "३-२४१-२८", "content_sanskrit": "न चेतयति वो राजा मन्दबुद्धिः सुयोधनः।\nयोऽस्मानाज्ञापयत्येवं वश्यानिव दिवौकसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2028031, "chapter_id": 1603, "verse_number": "३-२४१-२९", "content_sanskrit": "यूयं मुमूर्षवश्चापि मन्दप्रज्ञा न संशयः।\nये तस् वचनादेवमस्मान्ब्रूथ विचेतसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2028032, "chapter_id": 1603, "verse_number": "३-२४१-३०", "content_sanskrit": "गच्छध्वं त्वरिताः सर्वे यत्र राजा स कौरवः।\nन चेदद्यैव गच्छध्वं धर्मराजनिवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2028033, "chapter_id": 1603, "verse_number": "३-२४१-३१", "content_sanskrit": "एवमुक्तास्तु गन्धर्वै राज्ञः सेनाग्रयायिनः।\nसंप्राद्रवन्यतो राजा धृतराष्ट्रसुतोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2028034, "chapter_id": 1603, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि घोषयात्रापर्वणि एकचत्वारिंशदधिकद्विशततमोऽध्यायः ॥ २४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]