[{"id": 2206702, "chapter_id": 5404, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2206703, "chapter_id": 5404, "verse_number": "१", "content_sanskrit": "शरतल्पगते भीष्मे कौरवाणां धुरन्धरे ।\nशयाने वीरशयने पाण्डवैः समुपस्थिते\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2206704, "chapter_id": 5404, "verse_number": "२", "content_sanskrit": "युधिष्ठिरो महाप्राज्ञो मम पूर्वपितामहः ।\nधर्माणामागमं श्रुत्वा विदित्वा धर्मसंशयान्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2206705, "chapter_id": 5404, "verse_number": "३", "content_sanskrit": "दानानां च विधिं श्रुत्वा छिन्नधर्मार्थसंशयः ।\nयदन्यदकरोद् विप्र तन्मे शंसितुमर्हसि\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2206706, "chapter_id": 5404, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2206707, "chapter_id": 5404, "verse_number": "४", "content_sanskrit": "अभून्महूर्तं स्तिमितिं सर्वं तद् राजमण्डलम् ।\nतूष्णीम्भूते तदा भीष्मे पटे चित्रमिवार्पितम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2206708, "chapter_id": 5404, "verse_number": "५", "content_sanskrit": "मुहूर्तमिव च ध्यात्वा व्यासः सत्यवतीसुतः ।\nनृपं शयानं गाङ्गेयमिदमाह वचस्तदा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2206709, "chapter_id": 5404, "verse_number": "६", "content_sanskrit": "राजन् प्रकृतिमापन्नः कुरुराजो युधिष्ठिरः ।\nसहितो भ्रातृभिः सर्वैः पार्थिवैश्चानुयायिभिः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2206710, "chapter_id": 5404, "verse_number": "७", "content_sanskrit": "उपास्ते त्वां नरव्याघ्र सह कृष्णेन धीमता ।\nतमिमं पुरयानाय त्वमनुज्ञातुमर्हसि\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2206711, "chapter_id": 5404, "verse_number": "८", "content_sanskrit": "एवमुक्तो भगवता व्यासेन पृथिवीपतिः ।\nयुधिष्ठिरं सहामात्यमनुजज्ञे नदीसुतः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2206712, "chapter_id": 5404, "verse_number": "९", "content_sanskrit": "उवाच चैनं मधुरं ततः शान्तनवो नृपः ।\nप्रविशस्व पुरं राजन् व्येतु ते मानसो ज्वरः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2206713, "chapter_id": 5404, "verse_number": "१०", "content_sanskrit": "यजस्व विविधैर्यज्ञैर्बह्वन्नैः स्वाप्तदक्षिणैः ।\nययातिरिव राजेन्द्र श्रद्धादमपुरःसरः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2206714, "chapter_id": 5404, "verse_number": "११", "content_sanskrit": "क्षत्रधर्मरतः पार्थ पितॄन् देवांश्च तर्पय ।\nश्रेयसा योक्ष्यसे चैव व्येतु ते मानसो ज्वरः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2206715, "chapter_id": 5404, "verse_number": "१२", "content_sanskrit": "रञ्जयस्व प्रजाः सर्वाः प्रकृतीः परिसान्त्वय ।\nसुहृदः फलसत्कारैरभ्यर्चय यथार्हतः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2206716, "chapter_id": 5404, "verse_number": "१३", "content_sanskrit": "अनु त्वां तात जीवन्तु मित्राणि सुहृदस्तथा ।\nचैत्यस्थाने स्थितं वृक्षं फलवन्तमिव द्विजाः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2206717, "chapter_id": 5404, "verse_number": "१४", "content_sanskrit": "आगन्तव्यं च भवता समये मम पार्थिव ।\nविनिवृत्ते दिनकरे प्रवृत्ते चोत्तरायणे\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2206718, "chapter_id": 5404, "verse_number": "१५", "content_sanskrit": "तथेत्युक्त्वा तु कौन्तेयः सोऽभिवाद्य पितामहम् ।\nप्रययौ सपरीवारो नगरं नागसाह्वयम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2206719, "chapter_id": 5404, "verse_number": "१६", "content_sanskrit": "धृतराष्ट्रं पुरस्कृत्य गान्धारीं च पतिव्रताम् ।\nसह तैर्ऋषिभिः सर्वैर्भ्रातृभिः केशवेन च\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2206720, "chapter_id": 5404, "verse_number": "१७", "content_sanskrit": "पौरजानपदैश्चैव मन्त्रिवृद्धैश्च पार्थिवः ।\nप्रविवेश कुरुश्रेष्ठ पुरं वारणसाह्वयम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2206721, "chapter_id": 5404, "verse_number": "२५५", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे युधिष्ठिरपुरप्रवेशो नाम पञ्चपञ्चाशोत्तरद्विशततमोऽध्यायः ॥२५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2206722, "chapter_id": 5404, "verse_number": "", "content_sanskrit": "॥ समाप्तं दानधर्मपर्व ॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]