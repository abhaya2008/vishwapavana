[{"id": 2020960, "chapter_id": 1440, "verse_number": "३-७८-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2020961, "chapter_id": 1440, "verse_number": "३-७८-१", "content_sanskrit": "भगवान्काम्यकात्पार्थे गते मे प्रपितामहे।\nपाण्डवाः किमकुर्वंस्ते तमृते सव्यसाचिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2020962, "chapter_id": 1440, "verse_number": "३-७८-२", "content_sanskrit": "स हि तेषां महेष्वासो गतिरासीदनीकजित्।\nआदित्यानां यथा विष्णुस्तथैव प्रतिभाति मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2020963, "chapter_id": 1440, "verse_number": "३-७८-३", "content_sanskrit": "तेनेन्द्रसमवीर्येण संग्रामेष्वनिवर्तिना।\nविनाभूता वने वीराः कथमासन्पितामहाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2020964, "chapter_id": 1440, "verse_number": "३-७८-४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2020965, "chapter_id": 1440, "verse_number": "३-७८-४", "content_sanskrit": "गते तु पाण्डवेतात काम्यकात्सव्यसाचिनि।\nबभूवुः कौरवेयास्ते दुःखशोकपरायणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2020966, "chapter_id": 1440, "verse_number": "३-७८-५", "content_sanskrit": "आक्षिप्तसूत्रा मणयश्छिन्नपक्षा इवाण्डजाः।\nअप्रीतमनसः सर्वे बभूवुरथ पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2020967, "chapter_id": 1440, "verse_number": "३-७८-६", "content_sanskrit": "वनं तु तदभूत्तेन हीनमक्लिष्टकर्मणा।\nकुबेरेण यथाहीनं वनं चैत्ररथं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2020968, "chapter_id": 1440, "verse_number": "३-७८-७", "content_sanskrit": "तमृते ते नरव्याघ्राः पाण्डवा जनमेजय।\nमुदमप्राप्नुवन्तो वै काम्यके न्यवसंस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2020969, "chapter_id": 1440, "verse_number": "३-७८-८", "content_sanskrit": "ब्राह्मणार्थे पराक्रान्ताः शुद्धैर्वाणैर्महारथाः।\nनिघ्नन्तो भरतश्रेष्ठ मेध्यान्बहुविधान्मृगान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2020970, "chapter_id": 1440, "verse_number": "३-७८-९", "content_sanskrit": "नित्यंहि पुरुषव्याघ्रा वन्याहारमरिंदमाः।\nप्रविसृत्य समाहृत्य ब्राह्मणेभ्यो न्यवेदयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2020971, "chapter_id": 1440, "verse_number": "३-७८-१०", "content_sanskrit": "एवं ते न्यवसंस्तत्रसोत्कणअठाः पुरुषर्षभाः।\nअहृष्टमनसः सर्वेगते राजन्धनंजये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2020972, "chapter_id": 1440, "verse_number": "३-७८-११", "content_sanskrit": "अथ विप्रोषितं राजन्पाञ्चाली मध्यमं पतिम्।\nस्मरन्ती पाण्डवश्रेष्ठमिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2020973, "chapter_id": 1440, "verse_number": "३-७८-१२", "content_sanskrit": "योऽर्जुनेनार्जुनस्तुल्यो द्विबाहुर्बहुबाहुना।\nतमृते पाण्डवश्रेष्ठं वनं न प्रतिभाति मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2020974, "chapter_id": 1440, "verse_number": "३-७८-१३", "content_sanskrit": "शून्यामिव प्रपश्यामि तत्रतत्र महीमिमाम्।\nबह्वाश्चर्यमिदं चापि वनं कुसुमितद्रुमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2020975, "chapter_id": 1440, "verse_number": "३-७८-१४", "content_sanskrit": "न तथा रमणीयं वै तमृते सव्यसाचिनम्।\nनीलाम्बुदसमप्रख्यं मत्तमातङ्गगामिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2020976, "chapter_id": 1440, "verse_number": "३-७८-१५", "content_sanskrit": "तमृते पुण्डरीकाक्षं काम्यकं नातिभाति मे।\nयस्य वा धनुषो घोषः श्रूयते चाशनिस्वनः।\nन लभे शर्म वै राजन्स्मरन्ती सव्यसाचिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2020977, "chapter_id": 1440, "verse_number": "३-७८-१६", "content_sanskrit": "तथा लालप्यमानां तां निशाम्य परवीरहा।\nभीमसेनो महाराज द्रौपदीमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2020978, "chapter_id": 1440, "verse_number": "३-७८-१७", "content_sanskrit": "मनःप्रीतिकरं भद्रे यद्ब्रवीषि सुमध्यमे।\nतन्म प्रीणाति हृदयममृतप्राशनोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2020979, "chapter_id": 1440, "verse_number": "३-७८-१८", "content_sanskrit": "यस्य दीर्घौ समौ पीनौ भुजौ परिघसन्निभौ।\nमौर्वीकृतकिणौ वृत्तौ खङ्गायुधधनुर्धरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2020980, "chapter_id": 1440, "verse_number": "३-७८-१९", "content_sanskrit": "निष्काङ्गदकृतापीडौ पञ्चशीर्षाविवोरगौ।\nतमृते पुरुषव्याघ्रं नष्टसूर्यमिवाम्बरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2020981, "chapter_id": 1440, "verse_number": "३-७८-२०", "content_sanskrit": "यमाश्रित्य महाबाहुं पाञ्चालाः कुरवस्तथा।\nसुराणामपि यत्तानां पृतनासु न बिभ्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2020982, "chapter_id": 1440, "verse_number": "३-७८-२१", "content_sanskrit": "यस्य बाहू समाश्रित्य वयं सर्वेमहात्मनः।\nमन्यामहे जितानाजौ परान्प्राप्तां च मेदिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2020983, "chapter_id": 1440, "verse_number": "३-७८-२२", "content_sanskrit": "तमृते फल्गुनं वीरं न लभे काम्यके धृतिम्।\nपश्यामि च दिशः सर्वास्तिमिरेणावृता इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2020984, "chapter_id": 1440, "verse_number": "३-७८-२३", "content_sanskrit": "ततोऽब्रवीत्साश्रुकण्ठो नकुलः पाण्डुनन्दनः।\nयस्मिन्दिव्यानि कर्माणि कथयन्ति रणाजिरे।\nदेवा अपि युधांश्रेष्ठं तमृतेका रतिर्वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2020985, "chapter_id": 1440, "verse_number": "३-७८-२४", "content_sanskrit": "उदीचीं चो दिशं गत्वा जित्वा युधि महाबलान्।\nगन्धर्वमुख्याञ्शतशो हर्याँल्लेबे महाद्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2020986, "chapter_id": 1440, "verse_number": "३-७८-२५", "content_sanskrit": "राज्ञे तित्तिरिकल्माषाञ्श्रीमतोऽनिलरंहसः।\nप्रादाद्भात्रे प्रियः प्रेम्णा राजसूये महाक्रतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2020987, "chapter_id": 1440, "verse_number": "३-७८-२६", "content_sanskrit": "तमृतेभीमधन्वानं भीमादवरजं वने।\nकामये काम्यके वासं नेदानीममरोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2020988, "chapter_id": 1440, "verse_number": "३-७८-२७x", "content_sanskrit": "सहदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2020989, "chapter_id": 1440, "verse_number": "३-७८-२७", "content_sanskrit": "यो धनानिन कन्याश्च युधि हित्वा महाबलान्।\n`शतशो घातयित्वाऽरीन्पृतनामध्यगस्तदा।\nआजहार पुरा राज्ञे राजसूये महाक्रतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2020990, "chapter_id": 1440, "verse_number": "३-७८-२८", "content_sanskrit": "यः समेतान्मृधे जित्वायादवानमितद्युतिः।\nसुभद्रामाजहारैको वासुदेवस्य संमते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2020991, "chapter_id": 1440, "verse_number": "३-७८-२९", "content_sanskrit": "`येनार्धराज्यमाच्छिद्य द्रुपदस्य महात्मनः।\nआचार्यदक्षिणा दत्ता रणे द्रोणश्यभारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2020992, "chapter_id": 1440, "verse_number": "३-७८-३०", "content_sanskrit": "तस्य जिष्णोर्बृसीं दृष्ट्वा सून्यत्रेव निवेशने।\nहृदयं मे महाराज न शाम्यात्रकदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2020993, "chapter_id": 1440, "verse_number": "३-७८-३१", "content_sanskrit": "विनादस्माद्विवासं तु रोचयेऽहमरिंदम।\nन हि नस्तमृते वीरं रमणीयमिदं वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2020994, "chapter_id": 1440, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि अष्टसप्ततितमोऽध्यायः ॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]