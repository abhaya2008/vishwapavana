[{"id": 50003263, "chapter_id": 10684, "verse_number": "1", "content_sanskrit": "॥ आचारः, लोकसङ्ग्रहश्च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50003264, "chapter_id": 10684, "verse_number": "2", "content_sanskrit": "कर्मणैव हि संसिद्धिमास्थिता जनकादयः। लोकसङ्ग्रहमेवापि सम्पश्यन् कर्तुमर्हसि॥ ३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50003265, "chapter_id": 10684, "verse_number": "3", "content_sanskrit": "यद्यदाचरति श्रेष्ठस्तत्तदेवेतरो जनः। स यत्प्रमाणं कुरुते लोकस्तदनुवर्तते॥ ३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50003266, "chapter_id": 10684, "verse_number": "4", "content_sanskrit": "॥ प्रयोजनरहितेनापि क्रियमाणत्वादिति कैमुत्यम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50003267, "chapter_id": 10684, "verse_number": "5", "content_sanskrit": "न मे पार्थास्ति कर्तव्यं त्रिषु लोकेषु किञ्चन। नानवाप्तमवाप्तव्यं वर्त एव च कर्मणि॥ ३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50003268, "chapter_id": 10684, "verse_number": "6", "content_sanskrit": "यदि ह्यहं न वर्तेयं जातु कर्मण्यतन्द्रितः। मम वर्त्मानुवर्तन्ते मनुष्याः पार्थ सर्वशः॥ ३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50003269, "chapter_id": 10684, "verse_number": "7", "content_sanskrit": "उत्सीदेयुरिमे लोका न कुर्यां कर्म चेदहम्। सङ्करस्य च कर्ता स्यामुपहन्यामिमाः प्रजाः॥ ३/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50003270, "chapter_id": 10684, "verse_number": "8", "content_sanskrit": "॥ विद्वदविद्वत्कर्मणोर्भेदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50003271, "chapter_id": 10684, "verse_number": "9", "content_sanskrit": "॥ निरूपणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50003272, "chapter_id": 10684, "verse_number": "10", "content_sanskrit": "सक्ताः कर्मण्यविद्वांसो यथा कुर्वन्ति भारत। कुर्याद् विद्वांस्तथाऽसक्तश्चिकीर्षुर्लोकसङ्ग्रहम्॥ ३/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50003273, "chapter_id": 10684, "verse_number": "11", "content_sanskrit": "न बुद्धिभेदं जनयेदज्ञानां कर्मसङ्गिनाम्। जोषयेत् सर्वकर्माणि विद्वान् युक्तः समाचरन्॥ ३/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50003274, "chapter_id": 10684, "verse_number": "12", "content_sanskrit": "॥ प्रपञ्चनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50003275, "chapter_id": 10684, "verse_number": "13", "content_sanskrit": "प्रकृतेः क्रियमाणानि गुणैः कर्माणि सर्वशः। अहङ्कारविमूढात्मा कर्ताऽहमिति मन्यते॥ ३/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50003276, "chapter_id": 10684, "verse_number": "14", "content_sanskrit": "तत्त्ववित् तु महाबाहो गुणकर्मविभागयोः। गुणा गुणेषु वर्तन्त इति मत्वा न सज्जते॥ ३/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50003277, "chapter_id": 10684, "verse_number": "15", "content_sanskrit": "प्रकृतेर्गुणसम्मूढाः सज्जन्ते गुणकर्मसु। तानकृस्नविदो मन्दान् कृत्स्नविन्न विचालयेत्॥ ३/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50003278, "chapter_id": 10684, "verse_number": "16", "content_sanskrit": "॥ ततश्च विदुषां कर्मविधिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50003279, "chapter_id": 10684, "verse_number": "17", "content_sanskrit": "मयि सर्वाणि कर्माणि सन्न्यस्याध्यात्मचेतसा। निराशीर्निर्ममो भूत्वा युद्ध्यस्व विगतज्वरः॥ ३/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50003280, "chapter_id": 10684, "verse_number": "18", "content_sanskrit": "॥ कर्मकरणाकरणयोः फलभेदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50003281, "chapter_id": 10684, "verse_number": "19", "content_sanskrit": "ये मे मतमिदं नित्यमनुतिष्ठन्ति मानवाः। श्रद्धावन्तोऽनसूयन्तो मुच्यन्ते तेऽपि कर्मभिः॥ ३/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50003282, "chapter_id": 10684, "verse_number": "20", "content_sanskrit": "ये त्वेतदभ्यसूयन्तो नानुतिष्ठन्ति मे मतम्। सर्वज्ञानविमूढांस्तान् विद्धि नष्टानचेतसः॥ ३/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50003283, "chapter_id": 10684, "verse_number": "21", "content_sanskrit": "॥ लोकस्य कर्माकरणे हेतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50003284, "chapter_id": 10684, "verse_number": "22", "content_sanskrit": "सदृशं चेष्टते स्वस्याः प्रकृतेर्ज्ञानवानपि। प्रकृतिं यान्ति भूतानि निग्रहः किं करिष्यति॥ ३/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50003285, "chapter_id": 10684, "verse_number": "23", "content_sanskrit": "॥ तदत्ययोपायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50003286, "chapter_id": 10684, "verse_number": "24", "content_sanskrit": "इन्द्रियस्येन्द्रियस्यार्थे रागद्वेषौ व्यवस्थितौ॥ तयोर्न वशमागच्छेत् तौ ह्यस्य परिपन्थिनौ॥ ३/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50003287, "chapter_id": 10684, "verse_number": "25", "content_sanskrit": "॥ द्वितीयप्रश्नस्योत्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50003288, "chapter_id": 10684, "verse_number": "26", "content_sanskrit": "श्रेयान् स्वधर्मो विगुणः परधर्मात् स्वनुष्ठितात्। स्वधर्मे निधनं श्रेयः परधर्मो भयावहः॥ ३/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50003289, "chapter_id": 10684, "verse_number": "27", "content_sanskrit": "॥ कामप्रकरणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]