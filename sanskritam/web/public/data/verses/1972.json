[{"id": 2043421, "chapter_id": 1972, "verse_number": "६-२१-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2043422, "chapter_id": 1972, "verse_number": "६-२१-१", "content_sanskrit": "बृहतीं धार्तराष्ट्रस्य सेनां दृष्ट्वा समुद्यताम्।\nविषादमगमद्राजा कुन्तीपुत्रो युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2043423, "chapter_id": 1972, "verse_number": "६-२१-२", "content_sanskrit": "व्यूहं भीष्मेण चाभेद्यं कल्पितं प्रेक्ष्य पाण्डवः।\nअभेद्यमिव संप्रेक्ष्य विवर्णोऽर्जुनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2043424, "chapter_id": 1972, "verse_number": "६-२१-३", "content_sanskrit": "धनञ्जय कथं शक्यमस्माभिर्योद्धुमाहवे ।\nधार्तराष्ट्रैर्महाबाहो येषां योद्धा पितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2043425, "chapter_id": 1972, "verse_number": "६-२१-४", "content_sanskrit": "अक्षोभ्योऽयमभेद्यश्च भीष्मेणामित्रकर्षिणा ।\nकल्पितः शास्त्रदृष्टेन विधिना भूरिवर्चसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2043426, "chapter_id": 1972, "verse_number": "६-२१-५", "content_sanskrit": "ते वयं संशय्नं प्राप्ताः ससैन्याः शत्रुकर्षण ।\nकथमस्मान्महाव्यूहादुत्थानं नो भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2043427, "chapter_id": 1972, "verse_number": "६-२१-६", "content_sanskrit": "अथार्जुनोऽब्रवीत्पार्थं युधिष्ठिरममित्रहा ।\nविषण्णमिव संप्रेक्ष्य तव राजन्ननीकिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2043428, "chapter_id": 1972, "verse_number": "६-२१-७", "content_sanskrit": "प्रज्ञयाभ्यधिकाञ्शूरान्गुणयुक्तान्बहूनपि ।\nजयन्त्यल्पतरा येन तन्निबोध विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2043429, "chapter_id": 1972, "verse_number": "६-२१-८", "content_sanskrit": "तत्र ते कारणं राजन्प्रवक्ष्याम्यनसूयवे ।\nनारदस्तमृषिर्वेद भीष्मद्रोणौ च पाण्डव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2043430, "chapter_id": 1972, "verse_number": "६-२१-९", "content_sanskrit": "एनमेवार्थमाश्रित्य युद्धे देवासुरेऽब्रवीत्।\nपितामहः किल पुरा महेन्द्रादीन्दिवौकसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2043431, "chapter_id": 1972, "verse_number": "६-२१-१०", "content_sanskrit": "न तथा बलवीर्याभ्यां जयन्ति विजिगीषवः ।\nयथा सत्यानृशंस्याभ्यां धर्मेणैवोद्यमेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2043432, "chapter_id": 1972, "verse_number": "६-२१-११", "content_sanskrit": "त्वक्त्वाऽधर्मं तथा सर्वे धर्मं चोत्तममास्थिताः ।\nयुध्यध्वमतहंकारा यतो धर्मस्ततो जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2043433, "chapter_id": 1972, "verse_number": "६-२१-१२", "content_sanskrit": "एवं राजन्विजानीहि ध्रुवोऽस्माकं रणे जयः।\nयथा तु नारदः प्राह यतः कृष्णस्ततो जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2043434, "chapter_id": 1972, "verse_number": "६-२१-१३", "content_sanskrit": "गुणभूतो जयः कृष्णे पृष्ठतोऽभ्येति माधवम् ।\nतद्यथा विजयश्चास्य सन्नतिश्चापरो गुणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2043435, "chapter_id": 1972, "verse_number": "६-२१-१४", "content_sanskrit": "अनन्ततेजा गोविन्दः शत्रुपूगेषु निर्व्यथः।\nपुरुषः सनातनमयो यतः कृष्णस्ततो जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2043436, "chapter_id": 1972, "verse_number": "६-२१-१५", "content_sanskrit": "पुरा ह्येष हरिर्भूत्वा विकुण्ठोऽकुण्ठसायकः।\nसुरासुरानवस्फूर्जन्नब्रवीत्के जयन्त्विति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2043437, "chapter_id": 1972, "verse_number": "६-२१-१६", "content_sanskrit": "अनु कृष्णं जयेमेति यैरुक्तं तत्र तैर्जितम् ।\nतत्प्रसादाद्धि त्रैलोक्यं प्राप्तं शक्रादिभिः सुरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2043438, "chapter_id": 1972, "verse_number": "६-२१-१७", "content_sanskrit": "तस्य ते न व्यथां कांचिदिह पश्यामि भारत ।\nयस्य ते यजमाशास्ते विश्वभुक् त्रिदिवेश्वरः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2043439, "chapter_id": 1972, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भगवद्गीतापर्वणि एकविंशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]