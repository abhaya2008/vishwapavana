[{"id": 7003764000, "chapter_id": 23764, "verse_number": "२-२-८-१", "content_sanskrit": "जैमिनिरुवाच ।\nइत्युक्तस्तेन विप्रेण शबरश्चिंतयाकुलः ।\nअस्माकमुपजीव्योऽसौ रहस्यस्थो जनार्दनः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003764001, "chapter_id": 23764, "verse_number": "२-२-८-२", "content_sanskrit": "उपस्थितं नो दुर्दैवं येन स्यात्सार्वलौकिकः ।\nन दर्शयामि चेद्विप्रं शापं मेऽसौ प्रदास्यति ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003764002, "chapter_id": 23764, "verse_number": "२-२-८-३", "content_sanskrit": "सर्वेषां ब्राह्मणो मान्यो विशेषादतिथिस्त्वयम् ।\nयस्मिन्विफलकामे तु द्वौ लोकौ विफलौ मम ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003764003, "chapter_id": 23764, "verse_number": "२-२-८-४", "content_sanskrit": "एवं विचारयन्विश्वावसुः शबरपुंगवः ।\nजनप्रवादं सस्मार पुराणं शबरालये ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003764004, "chapter_id": 23764, "verse_number": "२-२-८-५", "content_sanskrit": "अस्मिन्नंतर्हिते देवे भूम्यंतर्लीनमाधवे ।\nइन्द्रद्युम्नो नरपतिः शक्रतुल्यपराक्रमः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003764005, "chapter_id": 23764, "verse_number": "२-२-८-६", "content_sanskrit": "मनुष्यवपुषा यो वै ब्रह्मलोकं व्रजेदपि ।\nसोऽस्मिन्प्रजाभिरागत्य वाजिमेधशतेन च ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003764006, "chapter_id": 23764, "verse_number": "२-२-८-७", "content_sanskrit": "इष्ट्वा दारुमयं विष्णुं चतुर्द्धा स्थापयिष्यति ।\nअस्य चेद्भाग्यमुत्पन्नं ब्राह्मणस्यातिथेर्भृशम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003764007, "chapter_id": 23764, "verse_number": "२-२-८-८", "content_sanskrit": "अंतर्द्धानं भगवतः सन्निधानमथो भवेत् ।\nतदेनं दर्शयिष्यामि नीलेंद्रमणिमच्युतम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003764008, "chapter_id": 23764, "verse_number": "२-२-८-९", "content_sanskrit": "न पौरुषेयं कस्यापि कर्तव्ये देवनिर्मिते ।\nइत्थं विचार्य मनसा शबरश्च पुनःपुनः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003764009, "chapter_id": 23764, "verse_number": "२-२-८-१०", "content_sanskrit": "उवाच विप्रं पुरतो ध्यायंतं विष्णुमव्ययम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003764010, "chapter_id": 23764, "verse_number": "२-२-८-११", "content_sanskrit": "शबर उवाच ।\nअस्माभिः पूर्वतोऽप्येष उदंतः श्रुत एव हि ।\nइंद्रद्युम्नो नरपतिरत्र वासं करिष्यति ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003764011, "chapter_id": 23764, "verse_number": "२-२-८-१२", "content_sanskrit": "ततोऽपि भाग्यवांस्त्वं हि यदग्रे नीलमाधवम् ।\nचक्षुषा पश्यसे ब्रह्मन्नेहि यामो ह्यधित्यकाम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003764012, "chapter_id": 23764, "verse_number": "२-२-८-१३", "content_sanskrit": "इत्युक्त्वा तं करे धृत्वा वर्त्मना गहनं ययौ ।\nउपर्युपर्युपारुह्य शिलाविषमवर्त्मनि ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003764013, "chapter_id": 23764, "verse_number": "२-२-८-१४", "content_sanskrit": "एकैकनरगम्ये च कंटकाचितदुर्गमे ।\nतमःप्राये पथि गतं बोधयन्वचसा द्विजम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003764014, "chapter_id": 23764, "verse_number": "२-२-८-१५", "content_sanskrit": "मुहूर्ताभ्यां रौहिणस्य कुंडस्याविशतां तटे ।\nतं दृष्ट्वा सोऽब्रवीद्विप्रं कुंडमेतद्द्विजोत्तम ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003764015, "chapter_id": 23764, "verse_number": "२-२-८-१६", "content_sanskrit": "रौहिणाख्यं महत्तीर्थं कारणं सर्वपाथसाम् ।\nअत्र स्नात्वा नरो याति वैकुंठभवनं द्विज ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003764016, "chapter_id": 23764, "verse_number": "२-२-८-१७", "content_sanskrit": "एतस्य पूर्वभागेऽसो कल्पच्छायावटो महान् ।\nछायां यस्य समाक्रम्य ब्रह्महत्यां व्यपोहति ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003764017, "chapter_id": 23764, "verse_number": "२-२-८-१८", "content_sanskrit": "एतयोरंतरे ब्रह्मन्निकुंजाभ्यंतरे स्थितम् ।\nपश्य साक्षाजगन्नाथं वेदांतप्रतिपादितम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003764018, "chapter_id": 23764, "verse_number": "२-२-८-१९", "content_sanskrit": "दृष्ट्वा जहीहि सकलं विविधं पापसंचयम् ।\nइत ऊर्ध्वं न शोचस्व पतितो भवसागरे ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003764019, "chapter_id": 23764, "verse_number": "२-२-८-२०", "content_sanskrit": "जैमिनिरुवाच ।\nस तु कुंडे द्विजः स्नात्वा संप्रदृष्टमनाः सुधी ।\nदूरात्प्रणम्य शिरसा मनसा वचसा हरिम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003764020, "chapter_id": 23764, "verse_number": "२-२-८-२१", "content_sanskrit": "तुष्टाव चैकाग्रमना हर्षगद्गदया गिरा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003764021, "chapter_id": 23764, "verse_number": "२-२-८-२२", "content_sanskrit": "विद्यापतिरुवाच ।\nप्रधानपुरुषातीत सर्वव्यापिन्परात्पर ।\nचराचरपरीणाम परमार्थ नमोऽस्तु ते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003764022, "chapter_id": 23764, "verse_number": "२-२-८-२३", "content_sanskrit": "श्रुतिस्मृतिपुराणेतिहास संप्रतिपादितैः ।\nकर्मभिस्त्वं समाराध्य एक एव जगत्पते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003764023, "chapter_id": 23764, "verse_number": "२-२-८-२४", "content_sanskrit": "त्वत्त एतज्जगत्सर्वं सृष्टौ संपद्यते विभो ।\nत्वदाधारमिदं देव त्वयैव परिपाल्यते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003764024, "chapter_id": 23764, "verse_number": "२-२-८-२५", "content_sanskrit": "कल्पांते संहृतं सर्वं त्वत्कुक्षौ सावकाशकम् ।\nसुखं वसति सर्वात्मन्नंतर्यामिन्नमोऽस्तु ते ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003764025, "chapter_id": 23764, "verse_number": "२-२-८-२६", "content_sanskrit": "नमस्ते देवदेवाय त्रयीरूपाय ते नमः ।\nचंद्रसूर्यादिरुपेण जगद्भासयते सदा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003764026, "chapter_id": 23764, "verse_number": "२-२-८-२७", "content_sanskrit": "सर्वतीर्थमयी गंगा यस्य पादाब्जसंगमात् ।\nपुनाति सकलांल्लोकांस्तस्मै पावयते नमः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003764027, "chapter_id": 23764, "verse_number": "२-२-८-२८", "content_sanskrit": "हवींषि मंत्रपूतानि सम्यग्दत्तानि वह्निषु ।\nपरिणामकृते तुभ्यं जगज्जीवयते नमः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003764028, "chapter_id": 23764, "verse_number": "२-२-८-२९", "content_sanskrit": "यदंशमुपजीवंति जगंत्यानंदरूपिणः ।\nसर्वकल्मषहीनाय तस्मै ब्रह्मात्मने नमः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003764029, "chapter_id": 23764, "verse_number": "२-२-८-३०", "content_sanskrit": "निर्मलाय स्वरूपाय शुभरूपाय मायिने ।\nसर्वसंगविहीनाय नमस्ते विश्वसाक्षिणे ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003764030, "chapter_id": 23764, "verse_number": "२-२-८-३१", "content_sanskrit": "बहुपादाक्षिशीर्षास्यबाहवे सर्वजिष्णवे ।\nसर्वजीवस्वरूपाय नमस्ते सर्वरूपिणे ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003764031, "chapter_id": 23764, "verse_number": "२-२-८-३२", "content_sanskrit": "नमस्ते कमलाकांत नमस्ते कमलासन ।\nनमः कमलपत्राक्ष त्राहि मां पुरुषोत्तम ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003764032, "chapter_id": 23764, "verse_number": "२-२-८-३३", "content_sanskrit": "असारसंसारपरिभ्रमेण निपीड्यमानं खलु रोगशोकैः ।\nमामुद्धरास्माद्भवदुःखजातात्पादाब्जयोस्ते शरणं प्रपन्नम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003764033, "chapter_id": 23764, "verse_number": "२-२-८-३४", "content_sanskrit": "जैमिनिरुवाच ।\nइति स्तुत्वा सुरेशानं देवं प्रणवरूपिणम् ।\nप्रणतः प्रणवं मंत्रं जजाप पुरतो हरेः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003764034, "chapter_id": 23764, "verse_number": "२-२-८-३५", "content_sanskrit": "जपांते शांतमनसं कृतांजलिमुपस्थितम् ।\nमन्यमानं कृतार्थं स्वं प्रोवाच शबरो द्विजम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003764035, "chapter_id": 23764, "verse_number": "२-२-८-३६", "content_sanskrit": "विश्वावसुरुवाच ।\nकृतार्थस्त्वं प्रभुं दृष्ट्वा सांप्रतं द्विजपुंगव ।\nदिनांतोऽभूद्गृहं यावः क्षुधितोऽसि श्रमान्वितः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003764036, "chapter_id": 23764, "verse_number": "२-२-८-३७", "content_sanskrit": "वासोऽप्यरण्ये हिंस्राणां नास्माकमुचिता स्थितिः ।\nयावद्भानोर्भाति भासस्तावद्यामो निजालयम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003764037, "chapter_id": 23764, "verse_number": "२-२-८-३८", "content_sanskrit": "इत्युक्त्वा ब्राह्मणं पाणौ गृहीत्वा शबरः पुनः ।\nआजगाम द्विजश्रेष्ठाः स्वाश्रमं त्वरयान्वितः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003764038, "chapter_id": 23764, "verse_number": "२-२-८-३९", "content_sanskrit": "ब्राह्मणोऽपि जगन्नाथं ध्यायन्नानंदसागरम् ।\nक्षुत्तृषाश्रमजातानि दुःखानि बुबुधे न हि ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003764039, "chapter_id": 23764, "verse_number": "२-२-८-४०", "content_sanskrit": "शिलाविषममार्गेऽपि कंटकोत्करदुर्गमे ।\nव्रजन्न दुःखं लेभेऽसौ शरीरानास्थया मुदा ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003764040, "chapter_id": 23764, "verse_number": "२-२-८-४१", "content_sanskrit": "एवं व्रजंतौ तौ विप्र शबरौ शबरालयम् ।\nसायाह्ने तमनुप्राप्तौ वैष्णवाग्र्यौ तु भो द्विजाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003764041, "chapter_id": 23764, "verse_number": "२-२-८-४२", "content_sanskrit": "तत्रातिथिमनुप्राप्तं ब्राह्मणं शबरोत्तमः ।\nभक्ष्यभोज्य विधानैश्च विविधैः समपूजयत् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003764042, "chapter_id": 23764, "verse_number": "२-२-८-४३", "content_sanskrit": "ततोऽभितृप्तस्तद्दत्तैरुपचारैर्नृपोचितैः ।\nविस्मयं परमं लेभे शबरस्य सुदुर्लभैः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003764043, "chapter_id": 23764, "verse_number": "२-२-८-४४", "content_sanskrit": "शबरोऽयं निवसति विषमे काननांतरे ।\nआरण्यकैर्वर्त्तमानः कथमस्य गृहांतरे ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003764044, "chapter_id": 23764, "verse_number": "२-२-८-४५", "content_sanskrit": "राजार्हभक्ष्यभोज्यानि सुलभान्यद्भुतं महत् ।\nइति विस्मयमापन्नं ब्राह्मणं शबरस्तदा ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003764045, "chapter_id": 23764, "verse_number": "२-२-८-४६", "content_sanskrit": "प्रोवाच स्निग्धवचसा विनयावनतो भृशम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003764046, "chapter_id": 23764, "verse_number": "२-२-८-४७", "content_sanskrit": "शबर उवाच ।\nभो विप्र श्रमहीनोऽसि कच्चित्क्षुत्तृड्विवर्जितः ।\nआरण्यकानां भवने नागराणां कुतः सुखम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003764047, "chapter_id": 23764, "verse_number": "२-२-८-४८", "content_sanskrit": "अज्ञाता नागरी वृत्तिः शबरैस्तु विशेषतः ।\nराजोपजीविनां श्रेष्ठौ राजामात्यपुरोहितौ ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003764048, "chapter_id": 23764, "verse_number": "२-२-८-४९", "content_sanskrit": "तयो राजसमः पूज्यः पुरोधाः शास्त्रसंमतः ।\nइन्द्रद्युम्नो नरपतिः सार्वभौमः प्रतापवान् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003764049, "chapter_id": 23764, "verse_number": "२-२-८-५०", "content_sanskrit": "त्वयि तुष्टे स संतुष्टो ध्रुवं विप्र भविष्यति ।\nइत्युक्तवत्यरण्यस्थे स तु प्रीततरो द्विजः ।\nउवाच शबरं प्रीत्या विनयाद्भुतवादिनम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003764050, "chapter_id": 23764, "verse_number": "२-२-८-५१", "content_sanskrit": "विद्यापतिरुवाच ।\nसाधो मदुपचाराय हृतान्येतानि यानि ते ।\nवस्तुन्यमानुषाणीह यान्यदृष्टानि राजभिः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003764051, "chapter_id": 23764, "verse_number": "२-२-८-५२", "content_sanskrit": "चित्रमेतद्दिव्यवस्तुसंचयः शबरालये ।\nएतत्ख्यातुं कौतुकं मे साधो संवर्द्धते महत् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003764052, "chapter_id": 23764, "verse_number": "२-२-८-५३", "content_sanskrit": "शबर उवाच ।\nएतत्प्रकाशितुं विप्र मतिर्नोत्सहते मम ।\nतथापि ते द्विजश्रेष्ठाऽतिथिभक्त्या वदाम्यहम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003764053, "chapter_id": 23764, "verse_number": "२-२-८-५४", "content_sanskrit": "शक्रादयो देवगणाः समायान्त्यन्वहं द्विज ।\nदिव्योपचारानादाय पूजनाय जगत्पतेः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003764054, "chapter_id": 23764, "verse_number": "२-२-८-५५", "content_sanskrit": "पूजयित्वा जगन्नाथं स्तुत्वा नत्वा च भक्तितः ।\nगीतशवादित्रनृत्यैश्च संतोष्य पुरुषोत्तमम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003764055, "chapter_id": 23764, "verse_number": "२-२-८-५६", "content_sanskrit": "पुनः प्रयांति सततं त्रिदिवं सुरसत्तमाः ।\nदिव्यान्येतानि वस्तूनि निर्माल्यानि जगत्पतेः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003764056, "chapter_id": 23764, "verse_number": "२-२-८-५७", "content_sanskrit": "दत्तानि तुभ्यं विदुषे कथं विस्मयते भवान् ।\nविष्णोर्निर्माल्यभोगेन क्षीणरोगजरा वयम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003764057, "chapter_id": 23764, "verse_number": "२-२-८-५८", "content_sanskrit": "सपुत्रबांधवाः सर्वे निवसामोऽयुतायुषः ।\nविष्णुनिर्माल्यभोगेन क्षीयते पापसंहतिः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003764058, "chapter_id": 23764, "verse_number": "२-२-८-५९", "content_sanskrit": "न तच्चित्रं द्विजश्रेष्ठ येन स्यान्मुक्तिभाजनम् ।\nश्रुत्वैतद्दुर्लभं कर्म ब्राह्मणो रोमहर्षणः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003764059, "chapter_id": 23764, "verse_number": "२-२-८-६०", "content_sanskrit": "आनंदाश्रुविलुप्ताक्षः स्वं कृतार्थममन्यत ।\nअहो शबरजन्मासौ पश्यत्यव्ययमीश्वरम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003764060, "chapter_id": 23764, "verse_number": "२-२-८-६१", "content_sanskrit": "तदुच्छिष्टं दिव्यभोगमुपभुंक्ते दिवानिशम् ।\nनान्योऽस्य सदृशो लोके पृथिव्यां सचराचरे ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003764061, "chapter_id": 23764, "verse_number": "२-२-८-६२", "content_sanskrit": "यादृशो विष्णुभक्तोऽयं शबरो नीलपर्वते ।\nकिं गत्वा स्वगृहे मेऽद्य कुटुंबेनाऽसुखात्मना ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003764062, "chapter_id": 23764, "verse_number": "२-२-८-६३", "content_sanskrit": "अनेन सख्यं निष्पाद्य स्थास्याम्यत्र वनांतरे ।\nचिन्तयित्वा चिरं विप्रः श्रीकृष्णासक्तमानसः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003764063, "chapter_id": 23764, "verse_number": "२-२-८-६४", "content_sanskrit": "पुनः प्रोवाच शबरं मयि ते चेदनुग्रहः ।\nसाधो सख्यं त्वया कार्यमिति मे निश्चयो महान् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003764064, "chapter_id": 23764, "verse_number": "२-२-८-६५", "content_sanskrit": "किं गत्वा सेवया राज्ञः परत्रासुखहेतुना ।\nअत्र स्थित्वा त्वया सार्धमुपास्य मधुसूदनम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003764065, "chapter_id": 23764, "verse_number": "२-२-८-६६", "content_sanskrit": "यथा पुनर्देहबंधो यतिष्ये न भवेन्मम ।\nसाधु मित्र त्वया सार्द्धं भाग्यान्मे संगमोऽभवत् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003764066, "chapter_id": 23764, "verse_number": "२-२-८-६७", "content_sanskrit": "दुस्तारं भवसंसारं तरिष्ये त्वत्प्रसादतः ।\nसारमेतत्प्रशंसंति संसारे भवसागरे ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003764067, "chapter_id": 23764, "verse_number": "२-२-८-६८", "content_sanskrit": "यद्वैष्णवेन मित्रत्वं दुःखसंसारपारदम् ।\nमित्रस्य सहवासेन पुनः प्रत्यक्षमेष्यति ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003764068, "chapter_id": 23764, "verse_number": "२-२-८-६९", "content_sanskrit": "भगवान्पुण्डरीकाक्षः शंखचक्रगदाधरः ।\nइंद्रद्युम्नो नरपतिर्मयि प्रत्यागते सखे ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003764069, "chapter_id": 23764, "verse_number": "२-२-८-७०", "content_sanskrit": "भगवंतं समाराद्धुमिहैव स निवत्स्यति ।\nप्रासादं विपुलं चात्र चिकीर्षुर्भगवत्प्रियम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003764070, "chapter_id": 23764, "verse_number": "२-२-८-७१", "content_sanskrit": "सहस्रमुपचाराणां पूजनाय जगत्पतेः ।\nरचयिष्यामीति महत्प्रतिज्ञासीन्महीपतेः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003764071, "chapter_id": 23764, "verse_number": "२-२-८-७२", "content_sanskrit": "प्रतिश्रुतं तत्पुरतः प्रीतस्तन्मेऽनुमन्यताम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003764072, "chapter_id": 23764, "verse_number": "२-२-८-७३", "content_sanskrit": "शबर उवाच ।\nसखे पुरातनी वार्त्ता प्रसिद्धैवात्र तादृशी ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003764073, "chapter_id": 23764, "verse_number": "२-२-८-७४", "content_sanskrit": "त्वया यथैव कथितं इन्द्रद्युम्नसमागमः ।\nकेवलं माधवं तत्र न द्रक्ष्यति महीपतिः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003764074, "chapter_id": 23764, "verse_number": "२-२-८-७५", "content_sanskrit": "अचिरादेव भगवान्स्वर्णवालुकयावृतः ।\nप्रतिजज्ञे यमायैतदन्तर्द्धानं गमिष्यति ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003764075, "chapter_id": 23764, "verse_number": "२-२-८-७६", "content_sanskrit": "महाभाग्यपरीपाकात्प्रत्यक्षोऽयं त्वया कृतः ।\nइन्द्रद्युम्नागमाभ्यासे ध्रुवं स व्यवधास्यति ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003764076, "chapter_id": 23764, "verse_number": "२-२-८-७७", "content_sanskrit": "एषोऽर्थस्तु त्वया मित्र न वक्तव्यो नृपाग्रतः ।\nआगत्य सोऽत्र नृपतिरदृष्ट्वा परमेश्वरम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003764077, "chapter_id": 23764, "verse_number": "२-२-८-७८", "content_sanskrit": "प्रायोपवेशव्रतवान्स्वप्ने दृष्ट्वा गदाधरम् ।\nतदादेशाद्दारुमयं प्रभोर्लिंगचतुष्टयम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003764078, "chapter_id": 23764, "verse_number": "२-२-८-७९", "content_sanskrit": "पूजयिष्यति भक्त्या च प्रतिष्ठाय स्वयंभुवा ।\nस्थितिरत्र हरेर्यावदावयोर्वंशसंस्थितिः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003764079, "chapter_id": 23764, "verse_number": "२-२-८-८०", "content_sanskrit": "अनुग्रहाद्भगवतो नात्र कार्या विचारणा ।\nतदत्रार्थे सखे खेदं मा व्रज क्षिप्रमेव हि ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003764080, "chapter_id": 23764, "verse_number": "२-२-८-८१", "content_sanskrit": "निर्वर्त्स्यतेऽचिरादेव मित्रेदानीं सुखं स्वप ।\nप्रातर्दृष्ट्वा पुनर्देवं नीलेन्द्राश्ममयं विभुम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003764081, "chapter_id": 23764, "verse_number": "२-२-८-८२", "content_sanskrit": "सिंधौ स्नात्वा तस्य तटे निवासाय महीपतेः ।\nद्रक्ष्यामः साधु संस्थानं यथाभिलषितं सखे ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003764082, "chapter_id": 23764, "verse_number": "२-२-८-८३", "content_sanskrit": "इत्यन्याश्च कथाः पुण्याः कृत्वा तौ च परस्परम् ।\nशुभस्थाने चास्वपतां शयने पल्लवास्तृते ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003764083, "chapter_id": 23764, "verse_number": "२-२-८-८४", "content_sanskrit": "प्रभातायां तु शर्वर्यां तीर्थराजोदकेन तौ ।\nस्नानं निर्वर्त्य विधिवन्माधवं प्रणिपत्य च ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003764084, "chapter_id": 23764, "verse_number": "२-२-८-८५", "content_sanskrit": "राजार्हस्थानं निर्णीय निवासाय गतौ पुनः ।\nतत्र मित्रेणाभिमन्त्र्य राज्ञो निर्देशकारणात् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003764085, "chapter_id": 23764, "verse_number": "२-२-८-८६", "content_sanskrit": "रथमारुह्य विप्रः स त्ववंतीपुरमाययौ ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003764086, "chapter_id": 23764, "verse_number": "२-२-८-८७", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां द्वितीये वैष्णवखण्डे पुरुषोत्तमक्षेत्रमाहात्म्ये जैमिनिऋषिसंवादेऽष्टमोऽध्यायः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}]