[{"id": 5000068000, "chapter_id": 9068, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे अष्टषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000068001, "chapter_id": 9068, "verse_number": "१-६८-१", "content_sanskrit": "जनकेन समादिष्टा दूतास्ते क्लान्तवाहनाः।\nत्रिरात्रमुषिता मार्गे तेऽयोध्यां प्राविशन् पुरीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000068002, "chapter_id": 9068, "verse_number": "१-६८-२", "content_sanskrit": "ते राजवचनाद् गत्वा राजवेश्म प्रवेशिताः।\nददृशुर्देवसंकाशं वृद्धं दशरथं नृपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000068003, "chapter_id": 9068, "verse_number": "१-६८-३", "content_sanskrit": "बद्धाञ्जलिपुटाः सर्वे दूता विगतसाध्वसाः।\nराजानं प्रश्रितं वाक्यमब्रुवन् मधुराक्षरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000068004, "chapter_id": 9068, "verse_number": "१-६८-४", "content_sanskrit": "मैथिलो जनको राजा साग्निहोत्रपुरस्कृतः।\nमुहुर्मुहुर्मधुरया स्नेहसंरक्तया गिरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000068005, "chapter_id": 9068, "verse_number": "१-६८-५", "content_sanskrit": "कुशलं चाव्ययं चैव सोपाध्यायपुरोहितम्।\nजनकस्त्वां महाराज पृच्छते सपुरःसरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000068006, "chapter_id": 9068, "verse_number": "१-६८-६", "content_sanskrit": "पृष्ट्वा कुशलमव्यग्रं वैदेहो मिथिलाधिपः।\nकौशिकानुमते वाक्यं भवन्तमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000068007, "chapter_id": 9068, "verse_number": "१-६८-७", "content_sanskrit": "पूर्वं प्रतिज्ञा विदिता वीर्यशुल्का ममात्मजा।\nराजानश्च कृतामर्षा निर्वीर्या विमुखीकृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000068008, "chapter_id": 9068, "verse_number": "१-६८-८", "content_sanskrit": "सेयं मम सुता राजन् विश्वामित्रपुरस्कृतैः।\nयदृच्छयागतै राजन् निर्जिता तव पुत्रकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000068009, "chapter_id": 9068, "verse_number": "१-६८-९", "content_sanskrit": "तच्च रत्नं धनुर्दिव्यं मध्ये भग्नं महात्मना।\nरामेण हि महाबाहो महत्यां जनसंसदि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000068010, "chapter_id": 9068, "verse_number": "१-६८-१०", "content_sanskrit": "अस्मै देया मया सीता वीर्यशुल्का महात्मने।\nप्रतिज्ञां तर्तुमिच्छामि तदनुज्ञातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000068011, "chapter_id": 9068, "verse_number": "१-६८-११", "content_sanskrit": "सोपाध्यायो महाराज पुरोहितपुरस्कृतः।\nशीघ्रमागच्छ भद्रं ते द्रष्टुमर्हसि राघवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000068012, "chapter_id": 9068, "verse_number": "१-६८-१२", "content_sanskrit": "प्रतिज्ञां मम राजेन्द्र निर्वर्तयितुमर्हसि।\nपुत्रयोरुभयोरेव प्रीतिं त्वमुपलप्स्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000068013, "chapter_id": 9068, "verse_number": "१-६८-१३", "content_sanskrit": "एवं विदेहाधिपतिर्मधुरं वाक्यमब्रवीत्।\nविश्वामित्राभ्यनुज्ञातः शतानन्दमते स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000068014, "chapter_id": 9068, "verse_number": "१-६८-१४", "content_sanskrit": "दूतवाक्यं तु तच्छ्रुत्वा राजा परमहर्षितः।\nवसिष्ठं वामदेवं च मन्त्रिणश्चैवमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000068015, "chapter_id": 9068, "verse_number": "१-६८-१५", "content_sanskrit": "गुप्तः कुशिकपुत्रेण कौसल्यानन्दवर्धनः।\nलक्ष्मणेन सह भ्रात्रा विदेहेषु वसत्यसौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000068016, "chapter_id": 9068, "verse_number": "१-६८-१६", "content_sanskrit": "दृष्टवीर्यस्तु काकुत्स्थो जनकेन महात्मना।\nसम्प्रदानं सुतायास्तु राघवे कर्तुमिच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000068017, "chapter_id": 9068, "verse_number": "१-६८-१७", "content_sanskrit": "यदि वो रोचते वृत्तं जनकस्य महात्मनः।\nपुरीं गच्छामहे शीघ्रं मा भूत् कालस्य पर्ययः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000068018, "chapter_id": 9068, "verse_number": "१-६८-१८", "content_sanskrit": "मन्त्रिणो बाढमित्याहुः सह सर्वैर्महर्षिभिः।\nसुप्रीतश्चाब्रवीद् राजा श्वो यात्रेति च मन्त्रिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000068019, "chapter_id": 9068, "verse_number": "१-६८-१९", "content_sanskrit": "मन्त्रिणस्तु नरेन्द्रस्य रात्रिं परमसत्कृताः।\nऊषुः प्रमुदिताः सर्वे गुणैः सर्वैः समन्विताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000068020, "chapter_id": 9068, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे अष्टषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]