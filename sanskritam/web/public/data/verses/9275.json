[{"id": 5000275000, "chapter_id": 9275, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे तृतीयः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000275001, "chapter_id": 9275, "verse_number": "४-३-१", "content_sanskrit": "वचो विज्ञाय हनुमान् सुग्रीवस्य महात्मनः।\nपर्वतादृष्यमूकात् तु पुप्लुवे यत्र राघवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000275002, "chapter_id": 9275, "verse_number": "४-३-२", "content_sanskrit": "कपिरूपं परित्यज्य हनुमान् मारुतात्मजः।\nभिक्षुरूपं ततो भेजे शठबुद्धितया कपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000275003, "chapter_id": 9275, "verse_number": "४-३-३", "content_sanskrit": "ततश्च हनुमान् वाचा श्लक्ष्णया सुमनोज्ञया।\nविनीतवदुपागम्य राघवौ प्रणिपत्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000275004, "chapter_id": 9275, "verse_number": "४-३-४", "content_sanskrit": "आबभाषे च तौ वीरौ यथावत् प्रशशंस च।\nसम्पूज्य विधिवद् वीरौ हनुमान् वानरोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000275005, "chapter_id": 9275, "verse_number": "४-३-५", "content_sanskrit": "उवाच कामतो वाक्यं मृदु सत्यपराक्रमौ।\nराजर्षिदेवप्रतिमौ तापसौ संशितव्रतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000275006, "chapter_id": 9275, "verse_number": "४-३-६", "content_sanskrit": "देशं कथमिमं प्राप्तौ भवन्तौ वरवर्णिनौ।\nत्रासयन्तौ मृगगणानन्यांश्च वनचारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000275007, "chapter_id": 9275, "verse_number": "४-३-७", "content_sanskrit": "पम्पातीररुहान् वृक्षान् वीक्षमाणौ समन्ततः।\nइमां नदीं शुभजलां शोभयन्तौ तरस्विनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000275008, "chapter_id": 9275, "verse_number": "४-३-८", "content_sanskrit": "धैर्यवन्तौ सुवर्णाभौ कौ युवां चीरवाससौ।\nनिःश्वसन्तौ वरभुजौ पीडयन्ताविमाः प्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000275009, "chapter_id": 9275, "verse_number": "४-३-९", "content_sanskrit": "सिंहविप्रेक्षितौ वीरौ महाबलपराक्रमौ।\nशक्रचापनिभे चापे गृहीत्वा शत्रुनाशनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000275010, "chapter_id": 9275, "verse_number": "४-३-१०", "content_sanskrit": "श्रीमन्तौ रूपसम्पन्नौ वृषभश्रेष्ठविक्रमौ।\nहस्तिहस्तोपमभुजौ द्युतिमन्तौ नरर्षभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000275011, "chapter_id": 9275, "verse_number": "४-३-११", "content_sanskrit": "प्रभया पर्वतेन्द्रोऽसौ युवयोरवभासितः।\nराज्यार्हावमरप्रख्यौ कथं देशमिहागतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000275012, "chapter_id": 9275, "verse_number": "४-३-१२", "content_sanskrit": "पद्मपत्रेक्षणौ वीरौ जटामण्डलधारिणौ।\nअन्योन्यसदृशौ वीरौ देवलोकादिहागतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000275013, "chapter_id": 9275, "verse_number": "४-३-१३", "content_sanskrit": "यदृच्छयेव सम्प्राप्तौ चन्द्रसूर्यौ वसुंधराम्।\nविशालवक्षसौ वीरौ मानुषौ देवरूपिणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000275014, "chapter_id": 9275, "verse_number": "४-३-१४", "content_sanskrit": "सिंहस्कन्धौ महोत्साहौ समदाविव गोवृषौ।\nआयताश्च सुवृत्ताश्च बाहवः परिघोपमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000275015, "chapter_id": 9275, "verse_number": "४-३-१५", "content_sanskrit": "सर्वभूषणभूषार्हाः किमर्थं न विभूषिताः।\nउभौ योग्यावहं मन्ये रक्षितुं पृथिवीमिमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000275016, "chapter_id": 9275, "verse_number": "४-३-१६", "content_sanskrit": "ससागरवनां कृत्स्नां विन्ध्यमेरुविभूषिताम्।\nइमे च धनुषी चित्रे श्लक्ष्णे चित्रानुलेपने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000275017, "chapter_id": 9275, "verse_number": "४-३-१७", "content_sanskrit": "प्रकाशेते यथेन्द्रस्य वज्रे हेमविभूषिते।\nसम्पूर्णाश्च शितैर्बाणैस्तूणाश्च शुभदर्शनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000275018, "chapter_id": 9275, "verse_number": "४-३-१८", "content_sanskrit": "जीवितान्तकरैर्घोरैर्ज्वलद्भिरिव पन्नगैः।\nमहाप्रमाणौ विपुलौ तप्तहाटकभूषणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000275019, "chapter_id": 9275, "verse_number": "४-३-१९", "content_sanskrit": "खड्गावेतौ विराजेते निर्मुक्तभुजगाविव।\nएवं मां परिभाषन्तं कस्माद् वै नाभिभाषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000275020, "chapter_id": 9275, "verse_number": "४-३-२०", "content_sanskrit": "सुग्रीवो नाम धर्मात्मा कश्चिद् वानरपुङ्गवः।\nवीरो विनिकृतो भ्रात्रा जगद‍्भ्रमति दुःखितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000275021, "chapter_id": 9275, "verse_number": "४-३-२१", "content_sanskrit": "प्राप्तोऽहं प्रेषितस्तेन सुग्रीवेण महात्मना।\nराज्ञा वानरमुख्यानां हनुमान् नाम वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000275022, "chapter_id": 9275, "verse_number": "४-३-२२", "content_sanskrit": "युवाभ्यां स हि धर्मात्मा सुग्रीवः सख्यमिच्छति।\nतस्य मां सचिवं वित्तं वानरं पवनात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000275023, "chapter_id": 9275, "verse_number": "४-३-२३", "content_sanskrit": "भिक्षुरूपप्रतिच्छन्नं सुग्रीवप्रियकारणात्।\nऋष्यमूकादिह प्राप्तं कामगं कामचारिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000275024, "chapter_id": 9275, "verse_number": "४-३-२४", "content_sanskrit": "एवमुक्त्वा तु हनुमांस्तौ वीरौ रामलक्ष्मणौ।\nवाक्यज्ञो वाक्यकुशलः पुनर्नोवाच किंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000275025, "chapter_id": 9275, "verse_number": "४-३-२५", "content_sanskrit": "एतच्छ्रुत्वा वचस्तस्य रामो लक्ष्मणमब्रवीत्।\nप्रहृष्टवदनः श्रीमान् भ्रातरं पार्श्वतः स्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000275026, "chapter_id": 9275, "verse_number": "४-३-२६", "content_sanskrit": "सचिवोऽयं कपीन्द्रस्य सुग्रीवस्य महात्मनः।\nतमेव कांक्षमाणस्य ममान्तिकमिहागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000275027, "chapter_id": 9275, "verse_number": "४-३-२७", "content_sanskrit": "तमभ्यभाष सौमित्रे सुग्रीवसचिवं कपिम्।\nवाक्यज्ञं मधुरैर्वाक्यैः स्नेहयुक्तमरिंदमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000275028, "chapter_id": 9275, "verse_number": "४-३-२८", "content_sanskrit": "नानृग्वेदविनीतस्य नायजुर्वेदधारिणः।\nनासामवेदविदुषः शक्यमेवं विभाषितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000275029, "chapter_id": 9275, "verse_number": "४-३-२९", "content_sanskrit": "नूनं व्याकरणं कृत्स्नमनेन बहुधा श्रुतम्।\nबहु व्याहरतानेन न किंचिदपशब्दितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000275030, "chapter_id": 9275, "verse_number": "४-३-३०", "content_sanskrit": "न मुखे नेत्रयोश्चापि ललाटे च भ्रुवोस्तथा।\nअन्येष्वपि च सर्वेषु दोषः संविदितः क्वचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000275031, "chapter_id": 9275, "verse_number": "४-३-३१", "content_sanskrit": "अविस्तरमसंदिग्धमविलम्बितमव्यथम्।\nउरःस्थं कण्ठगं वाक्यं वर्तते मध्यमस्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000275032, "chapter_id": 9275, "verse_number": "४-३-३२", "content_sanskrit": "संस्कारक्रमसम्पन्नामद्भुतामविलम्बिताम्।\nउच्चारयति कल्याणीं वाचं हृदयहर्षिणीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000275033, "chapter_id": 9275, "verse_number": "४-३-३३", "content_sanskrit": "अनया चित्रया वाचा त्रिस्थानव्यञ्जनस्थया।\nकस्य नाराध्यते चित्तमुद्यतासेररेरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000275034, "chapter_id": 9275, "verse_number": "४-३-३४", "content_sanskrit": "एवंविधो यस्य दूतो न भवेत् पार्थिवस्य तु।\nसिद्ध्यन्ति हि कथं तस्य कार्याणां गतयोऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000275035, "chapter_id": 9275, "verse_number": "४-३-३५", "content_sanskrit": "एवंगुणगणैर्युक्ता यस्य स्युः कार्यसाधकाः।\nतस्य सिद्ध्यन्ति सर्वेऽर्था दूतवाक्यप्रचोदिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000275036, "chapter_id": 9275, "verse_number": "४-३-३६", "content_sanskrit": "एवमुक्तस्तु सौमित्रिः सुग्रीवसचिवं कपिम्।\nअभ्यभाषत वाक्यज्ञो वाक्यज्ञं पवनात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000275037, "chapter_id": 9275, "verse_number": "४-३-३७", "content_sanskrit": "विदिता नौ गुणा विद्वन् सुग्रीवस्य महात्मनः।\nतमेव चावां मार्गावः सुग्रीवं प्लवगेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000275038, "chapter_id": 9275, "verse_number": "४-३-३८", "content_sanskrit": "यथा ब्रवीषि हनुमन् सुग्रीववचनादिह।\nतत् तथा हि करिष्यावो वचनात् तव सत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000275039, "chapter_id": 9275, "verse_number": "४-३-३९", "content_sanskrit": "तत् तस्य वाक्यं निपुणं निशम्य\nप्रहृष्टरूपः पवनात्मजः कपिः।\nमनः समाधाय जयोपपत्तौ\nसख्यं तदा कर्तुमियेष ताभ्याम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000275040, "chapter_id": 9275, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे तृतीयः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]