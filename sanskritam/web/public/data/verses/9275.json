[{"id": 40017952, "chapter_id": 9275, "verse_number": "1", "content_sanskrit": "एवमुक्त्वातुसौमित्रिंजातहर्षोविभीषणः । धनुष्पाणिंनमादायत्वरमाणोजगामसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40017953, "chapter_id": 9275, "verse_number": "2", "content_sanskrit": "अविदूरंततोगत्वाप्रविश्यतुमहद्वनम् । दर्शमामासतत्कर्मलक्ष्मणातविभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40017954, "chapter_id": 9275, "verse_number": "3", "content_sanskrit": "नीलजीमूतसङ्काशंन्यग्रोधंभीमदर्शनम् । तेजस्वीरावणभ्रातालक्ष्मणायन्यवेदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40017955, "chapter_id": 9275, "verse_number": "4", "content_sanskrit": "इहोपहारंभूतानांबलवान्रावणात्मजः । उपहृत्यततःपश्चात्सङ्ग्राममभिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40017956, "chapter_id": 9275, "verse_number": "5", "content_sanskrit": "अदृश्टस्सर्वभूतानांततोभवतिराक्षसः । निहन्तिसमरेशत्रून् बध्नाति च शरोत्तमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40017957, "chapter_id": 9275, "verse_number": "6", "content_sanskrit": "तमप्रविष्टंन्यग्रोधंबलिनंरावणात्मजम् । विध्वंसयशरैर्दीप्टै: सरथंसाश्वसारथिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40017958, "chapter_id": 9275, "verse_number": "7", "content_sanskrit": "तथेत्युक्त्वामहातेजास्सौमित्रिर्मित्रनन्दनः । बभूवावस्थितस्तत्रचित्रंविस्फारयन्? धनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40017959, "chapter_id": 9275, "verse_number": "8", "content_sanskrit": "स रथेनाग्निवर्णेनबलवान्रावणात्मजः । इन्द्रजित्कवचीखङ्गीसध्वजःप्रत्यदृश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40017960, "chapter_id": 9275, "verse_number": "9", "content_sanskrit": "तमुवाचमहातेजाःपौलस्त्यमपराजितम् । समह्वयेत्वांसमरेसम्यग्युद्धंप्रयच्छमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40017961, "chapter_id": 9275, "verse_number": "10", "content_sanskrit": "एवमुक्तोमहातेजामनस्वीरावणात्मजः । अब्रवीत्परुषंवाक्यंतत्रदृष्टवाविभीषणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40017962, "chapter_id": 9275, "verse_number": "11", "content_sanskrit": "इहत्वंजातसम्वृद्धःसाक्षाद्भ्रातापितुर्मम । कथंद्रुह्यसिपुत्रस्यपितृव्योममराक्षस ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40017963, "chapter_id": 9275, "verse_number": "12", "content_sanskrit": "न ज्ञातित्वं न सौहार्धं न जातिस्तवदुर्मते । प्रमाणं न च सौदर्यं न धर्मोधर्मदूषण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40017964, "chapter_id": 9275, "verse_number": "13", "content_sanskrit": "शोच्यस्त्वमसिदुर्बुद्धेनिन्दनीयश्चसाधुभिः । यस्त्वंस्वजनमुत्सृज्यपरभृत्यत्वमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40017965, "chapter_id": 9275, "verse_number": "14", "content_sanskrit": "नैतछचिथिलयाबुद्ध्यात्वंवेसतिमहदन्तरम् । क्व च स्वजनसम्वासःक्व च नीचपराश्रयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40017966, "chapter_id": 9275, "verse_number": "15", "content_sanskrit": "गुणवान्वापरजनःस्वजनोनिर्गुणोऽपिवा । निर्गुणःस्वजनःश्रेयान् यःपरःपरएवसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40017967, "chapter_id": 9275, "verse_number": "16", "content_sanskrit": "यसस्स्वपक्षंपरित्यज्यपरपक्षंनिषेवते । स स्वपक्षेक्ष्यंप्राप्तेपश्चास्त्तैरेवहन्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40017968, "chapter_id": 9275, "verse_number": "17", "content_sanskrit": "निरनुक्रोशताचेयंयादृशीतेनिशाचर । स्वजनेनत्वयाशक्यंपौरुषंरावणानुज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40017969, "chapter_id": 9275, "verse_number": "18", "content_sanskrit": "इत्युक्तोभ्रातृपुत्रेणप्रत्युवाचविभीषणः । अजानन्निवमछचीलंकिंराक्षसविकत्थसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40017970, "chapter_id": 9275, "verse_number": "19", "content_sanskrit": "राक्षसेन्द्रसुतासाधोपारुष्यंत्यजगौरवात् । कुलेयद्यप्यहंजातोरक्षसांक्रूरकर्मणाम् ॥ गुणोयःप्रथमोनृणंतन्मेशीलमराक्षसम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40017971, "chapter_id": 9275, "verse_number": "20", "content_sanskrit": "न रमेदारुणेनाहं न चाधर्मेणवैरमे ॥ भ्रात्राविषशीलोऽपिकथंभ्रातानिरस्यते ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40017972, "chapter_id": 9275, "verse_number": "21", "content_sanskrit": "धर्मात्प्रच्युतशीलंहिपुरुषंपापनिश्चयम् ॥ त्यक्त्वासुखमवाप्नोतिहस्तादाशीविषंयथा ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40017973, "chapter_id": 9275, "verse_number": "22", "content_sanskrit": "परस्वहरणेयुक्तंपरदाराभिमर्शकम् ॥ त्याज्यमाहुर्दुरात्मानंवेश्मप्रज्वलितंयथा ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40017974, "chapter_id": 9275, "verse_number": "23", "content_sanskrit": "परस्वानां च हरणंपरदाराभिमर्शनम् ॥ सुहृदामतिशङ्का च त्रयोदोषाःक्षयावहाः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40017975, "chapter_id": 9275, "verse_number": "24", "content_sanskrit": "महर्षीणांवधोघोरस्सर्वदेवैश्चविग्रहः ॥ अभिमानश्चदोषश्चवैरित्वंप्रतिकूलता । एतेदोषाममभ्रातुर्जीवितैश्वर्यनाशनाः ॥ गुणान्प्रच्छादयामासुःपर्वतानिवतोयदाः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40017976, "chapter_id": 9275, "verse_number": "25", "content_sanskrit": "महर्षीणांवधोघोरस्सर्वदेवैश्चविग्रहः ॥ अभिमानश्चदोषश्चवैरित्वंप्रतिकूलता । एतेदोषाममभ्रातुर्जीवितैश्वर्यनाशनाः ॥ गुणान्प्रच्छादयामासुःपर्वतानिवतोयदाः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40017977, "chapter_id": 9275, "verse_number": "26", "content_sanskrit": "दोषैरेतैःपरित्यक्तोमयाभ्रातापितातव ॥ नेयमस्तिपुरीलङ्का न च त्वं न च तेपिता ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40017978, "chapter_id": 9275, "verse_number": "27", "content_sanskrit": "अतिमाननी च बालश्चदुर्विनीतश्चराक्षस । बद्धस्त्वंकालपाशेनब्रूहिमांयद्यदिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40017979, "chapter_id": 9275, "verse_number": "28", "content_sanskrit": "अद्यतेव्यसनंप्राप्तंकिंमांत्वामिहवक्ष्यसि । प्रवेष्टुं न त्वयाशक्यंन्यग्रोधंराक्षसाधम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40017980, "chapter_id": 9275, "verse_number": "29", "content_sanskrit": "धर्षयित्वा च काकुत्स्थं न शक्यंजीवितुंत्वया । युध्यस्वनरदेवेनलक्ष्मणेनरणेसह ॥ हतस्त्वंदेवताकार्यंकरिष्यसियमक्षये ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]