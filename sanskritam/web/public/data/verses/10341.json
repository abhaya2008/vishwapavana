[{"id": 6000341000, "chapter_id": 10341, "verse_number": null, "content_sanskrit": "अथ नवमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000341001, "chapter_id": 10341, "verse_number": null, "content_sanskrit": "सूत उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.001.m4a", "display_order": 2}, {"id": 6000341002, "chapter_id": 10341, "verse_number": "१२-९-१", "content_sanskrit": "स एवमनुभूयेदं नारायणविनिर्मितम्।\nवैभवं योगमायायास्तमेव शरणं ययौ॥ १२/९/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.002.m4a", "display_order": 3, "topics": [{"text": "मार्कण्डेयस्य शिवेनापि वरदानम्", "range": "१"}]}, {"id": 6000341003, "chapter_id": 10341, "verse_number": null, "content_sanskrit": "ऋषिरुवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.003.m4a", "display_order": 4}, {"id": 6000341004, "chapter_id": 10341, "verse_number": "१२-९-२", "content_sanskrit": "प्रपन्नोऽस्म्यङ्घ्रिमूलं ते प्रपन्नाभयदं हरे।\nयन्माययाऽपि विबुधा मुह्यन्त्यज्ञानकातराः॥ १२/९/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.004.m4a", "display_order": 5}, {"id": 6000341005, "chapter_id": 10341, "verse_number": null, "content_sanskrit": "सूत उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.005.m4a", "display_order": 6}, {"id": 6000341006, "chapter_id": 10341, "verse_number": "१२-९-३", "content_sanskrit": "तमित्थं निभृतात्मानं वृषेण दिवि पर्यटन्।\nरुद्राण्या भगवान् रुद्रो ददर्श स्वगणैर्वृतः॥ १२/९/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.006.m4a", "display_order": 7}, {"id": 6000341007, "chapter_id": 10341, "verse_number": "१२-९-४", "content_sanskrit": "अथोमा तमृषिं वीक्ष्य गिरिशं समभाषत।\nपश्येमं भगवन् विप्रं निभृतात्मेन्द्रियाशयम्॥ १२/९/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.007.m4a", "display_order": 8}, {"id": 6000341008, "chapter_id": 10341, "verse_number": "१२-९-५", "content_sanskrit": "निभृतो नन्वृषिव्रातस्तपापाये यथाऽर्णवः।\nकुर्वस्य तपसः साक्षात् संसिद्धिं सिद्धिदो भवान्॥ १२/९/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.008.m4a", "display_order": 9}, {"id": 6000341009, "chapter_id": 10341, "verse_number": null, "content_sanskrit": "श्रीमहादेव उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.009.m4a", "display_order": 10}, {"id": 6000341010, "chapter_id": 10341, "verse_number": "१२-९-६", "content_sanskrit": "नैवेच्छत्याशिषः क्‍वापि ब्रह्मर्षिर्मोक्षमप्युत।\nभक्तिं परां भगवति लब्धवान् पुरुषेऽव्यये॥ १२/९/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.010.m4a", "display_order": 11}, {"id": 6000341011, "chapter_id": 10341, "verse_number": "१२-९-७", "content_sanskrit": "अथापि संवदिष्यामो भवान्येतेन साधुना।\nअयं हि परमो लाभो नृणां साधुसमागमः॥ १२/९/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.011.m4a", "display_order": 12}, {"id": 6000341012, "chapter_id": 10341, "verse_number": "१२-९-८", "content_sanskrit": "इत्युक्त्वा समुपेयाय भगवान् स सतां गतिः।\nईशानः सर्वविद्यानामीश्वरः सर्वदेहिनाम्॥ १२/९/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.012.m4a", "display_order": 13}, {"id": 6000341013, "chapter_id": 10341, "verse_number": "१२-९-९", "content_sanskrit": "तयोरागमनं साक्षादीशयोर्जगदात्मनोः।\nन वेद रुद्धधीवृत्तिरात्मानं विश्वमेव च॥ १२/९/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.013.m4a", "display_order": 14}, {"id": 6000341014, "chapter_id": 10341, "verse_number": "१२-९-१०", "content_sanskrit": "भगवांस्तदभिज्ञाय गिरिशो योगमायया।\nआविशत् तद्गुहाकाशं वायुश्छिद्रमिवेश्वरः॥ १२/९/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.014.m4a", "display_order": 15}, {"id": 6000341015, "chapter_id": 10341, "verse_number": "१२-९-११", "content_sanskrit": "आत्मन्यपि शिवं प्राप्तं तडित्पिङ्गजटाधरम्।\nत्र्यक्षमष्टभुजं शम्भुमुद्यन्तमिव भास्करम्॥ १२/९/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.015.m4a", "display_order": 16}, {"id": 6000341016, "chapter_id": 10341, "verse_number": "१२-९-१२", "content_sanskrit": "व्याघ्रचर्माम्बरं शूलधनुरिष्वसिचर्मभिः।\nअक्षमालां डमरुकं कपालं परशुं सह॥ १२/९/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.016.m4a", "display_order": 17}, {"id": 6000341017, "chapter_id": 10341, "verse_number": "१२-९-१३", "content_sanskrit": "बिभ्राणं सहसा भान्तं व्यचष्ट हृदि विस्मितः।\nकिमिदं कुत एवेति समाधेर्विरतो मुनिः॥ १२/९/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.017.m4a", "display_order": 18}, {"id": 6000341018, "chapter_id": 10341, "verse_number": "१२-९-१४", "content_sanskrit": "नेत्रे उन्मील्य ददृशे सगणं सोमयाऽऽगतम्।\nरुद्रं त्रिलोकैकगुरुं ननाम शिरसा मुनिः॥ १२/९/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.018.m4a", "display_order": 19}, {"id": 6000341019, "chapter_id": 10341, "verse_number": "१२-९-१५", "content_sanskrit": "तस्मै सपर्यां व्यदधात् सगणाय सहोमया।\nस्वागतासनपाद्यार्घ्यगन्धस्रग्धूपदीपकैः॥ १२/९/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.019.m4a", "display_order": 20}, {"id": 6000341020, "chapter_id": 10341, "verse_number": "१२-९-१६", "content_sanskrit": "आह चाऽत्मानुभावेन पूर्णकामस्य ते विभो।\nकरवाम किमीशान येनेदं निर्वृतं जगत्॥ १२/९/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.020.m4a", "display_order": 21}, {"id": 6000341021, "chapter_id": 10341, "verse_number": "१२-९-१७", "content_sanskrit": "नमः शिवाय शान्ताय सत्त्वाय प्रमृडाय च।\nरजोजुषेऽप्यघोराय नमस्तुभ्यं तमोजुषे॥ १२/९/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.021.m4a", "display_order": 22}, {"id": 6000341022, "chapter_id": 10341, "verse_number": null, "content_sanskrit": "सूत उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.022.m4a", "display_order": 23}, {"id": 6000341023, "chapter_id": 10341, "verse_number": "१२-९-१८", "content_sanskrit": "एवं स्तुतः स भगवान् महादेवः सतां गतिः।\nपरितुष्टः प्रसन्नात्मा प्रहसंस्तमभाषत॥ १२/९/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.023.m4a", "display_order": 24}, {"id": 6000341024, "chapter_id": 10341, "verse_number": null, "content_sanskrit": "श्रीमहादेव उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.024.m4a", "display_order": 25}, {"id": 6000341025, "chapter_id": 10341, "verse_number": "१२-९-१९", "content_sanskrit": "वरं वृणीष्व नः कामं वरदेशा वयं त्रयः।\nअमोघं दर्शनं येषां मर्त्यो यद् विन्दतेऽमृतम्॥ १२/९/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.025.m4a", "display_order": 26}, {"id": 6000341026, "chapter_id": 10341, "verse_number": "१२-९-२०", "content_sanskrit": "ब्राह्मणाः साधवः शान्ता निस्सङ्गा भूतवत्सलाः।\nएकान्तभक्ता अस्मासु निर्वैराः समदर्शनाः॥ १२/९/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.026.m4a", "display_order": 27}, {"id": 6000341027, "chapter_id": 10341, "verse_number": "१२-९-२१", "content_sanskrit": "सलोका लोकपालास्तान् वन्दन्त्यर्चन्त्युपासते।\nअहं च न पृथग् ब्रह्मा स्वयं तु हरिरीश्वरः॥ १२/९/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.027.m4a", "display_order": 28}, {"id": 6000341028, "chapter_id": 10341, "verse_number": "१२-९-२२", "content_sanskrit": "न ते मय्यच्युतेऽजे च भिदामण्वपि चक्षते।\nनात्मनश्च जनस्यापि तद् युष्मान् वयमीमहि॥ १२/९/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.028.m4a", "display_order": 29}, {"id": 6000341029, "chapter_id": 10341, "verse_number": "१२-९-२३", "content_sanskrit": "न ह्यम्मयानि तीर्थानि न देवा मृच्छिलामयाः।\nते पुनन्त्युरुकालेन यूयं दर्शनमात्रतः॥ १२/९/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.029.m4a", "display_order": 30}, {"id": 6000341030, "chapter_id": 10341, "verse_number": "१२-९-२४", "content_sanskrit": "ब्राह्मणेभ्यो नमस्यामो येऽस्मद्रूपं त्रयीमयम्।\nबिभ्रत्यात्मसमाधानं तपःस्वाध्यायसंयमैः॥ १२/९/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.030.m4a", "display_order": 31}, {"id": 6000341031, "chapter_id": 10341, "verse_number": "१२-९-२५", "content_sanskrit": "श्रवणाद् दर्शनाद् वाऽपि महापातकिनोऽपि वः।\nशुद्ध्येरन्नन्त्यजाश्चापि किमु सम्भाषणादिभिः॥ १२/९/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.031.m4a", "display_order": 32}, {"id": 6000341032, "chapter_id": 10341, "verse_number": null, "content_sanskrit": "सूत उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.032.m4a", "display_order": 33}, {"id": 6000341033, "chapter_id": 10341, "verse_number": "१२-९-२६", "content_sanskrit": "इति चन्द्रललामस्य धर्मगुह्योपबृंहितम्।\nवचोऽमृतायनमृषिर्नातृप्यत् कर्णयोः पिबन्॥ १२/९/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.033.m4a", "display_order": 34}, {"id": 6000341034, "chapter_id": 10341, "verse_number": "१२-९-२७", "content_sanskrit": "स चिरं मायया विष्णोर्भ्रामितः कर्शितो भृशम्।\nशिववागमृतध्वस्तक्लेशपुञ्जस्तमब्रवीत्॥ १२/९/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.034.m4a", "display_order": 35}, {"id": 6000341035, "chapter_id": 10341, "verse_number": null, "content_sanskrit": "ऋषिरुवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.035.m4a", "display_order": 36}, {"id": 6000341036, "chapter_id": 10341, "verse_number": "१२-९-२८", "content_sanskrit": "अहो ईश्वरचर्येयं दुर्विभाव्या शरीरिणाम्।\nयन्नमन्तीशितव्यानि स्तुवन्ति जगदीश्वराः॥ १२/९/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.036.m4a", "display_order": 37}, {"id": 6000341037, "chapter_id": 10341, "verse_number": "१२-९-२९", "content_sanskrit": "धर्मं ग्राहयितुं प्रायः प्रवक्तारश्च देहिनाम्।\nआचरन्त्यनुमोदन्ते क्रियमाणं स्तुवन्ति च॥ १२/९/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.037.m4a", "display_order": 38}, {"id": 6000341038, "chapter_id": 10341, "verse_number": "१२-९-३०", "content_sanskrit": "नैतावता भगवतः स्वमायामयवृत्तिभिः।\nप्रदुष्येतानुभावस्ते मायिनः कुहकैर्यथा॥ १२/९/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.038.m4a", "display_order": 39}, {"id": 6000341039, "chapter_id": 10341, "verse_number": "१२-९-३१", "content_sanskrit": "सृष्ट्वेदं मनसा विश्वं स्वात्मनाऽनुप्रविश्य यः।\nगुणैः कुर्वद्भिराभाति कर्तेव स्वप्नदृग् यथा॥ १२/९/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.039.m4a", "display_order": 40}, {"id": 6000341040, "chapter_id": 10341, "verse_number": "१२-९-३२", "content_sanskrit": "तस्मै नमो भगवते त्रिगुणाय गुणात्मने।\nकेवलायाद्वितीयाय गुरवे ब्रह्ममूर्तये॥ १२/९/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.040.m4a", "display_order": 41}, {"id": 6000341041, "chapter_id": 10341, "verse_number": "१२-९-३३", "content_sanskrit": "कं वृणेऽतः परं भूमन् वरं त्वद् वरदर्शनात्।\nयद्दर्शनात् पूर्णकामः सत्यकामः पुमान् भवेत्॥ १२/९/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.041.m4a", "display_order": 42}, {"id": 6000341042, "chapter_id": 10341, "verse_number": "१२-९-३४", "content_sanskrit": "वरमेतं वृणेऽथापि पूर्णकामाभिवर्षणात्।\nभगवत्यच्युतां भक्तिं तत्परेषु तथा त्वयि॥ १२/९/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.042.m4a", "display_order": 43}, {"id": 6000341043, "chapter_id": 10341, "verse_number": null, "content_sanskrit": "सूच उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.043.m4a", "display_order": 44}, {"id": 6000341044, "chapter_id": 10341, "verse_number": "१२-९-३५", "content_sanskrit": "इत्यर्थितोऽभिष्टुतश्च मुनिना सूक्तया गिरा।\nतमाह भगवान् शर्वः शर्वया चाभिवन्दितः॥ १२/९/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.044.m4a", "display_order": 45}, {"id": 6000341045, "chapter_id": 10341, "verse_number": "१२-९-३६", "content_sanskrit": "कामस्ते महर्षे सत्यो भक्तिमांस्त्वमधोक्षजे।\nआकल्पान्तं यशः पुण्यमजरामरता तथा॥ १२/९/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.045.m4a", "display_order": 46}, {"id": 6000341046, "chapter_id": 10341, "verse_number": "१२-९-३७", "content_sanskrit": "ज्ञानं त्रैकालिकं ब्रह्मन् विज्ञानं च विरक्तिमत्।\nब्रह्मवर्चस्विता भूयात् पुराणाचार्यताऽस्तु ते॥ १२/९/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.046.m4a", "display_order": 47}, {"id": 6000341047, "chapter_id": 10341, "verse_number": null, "content_sanskrit": "सूत उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.047.m4a", "display_order": 48}, {"id": 6000341048, "chapter_id": 10341, "verse_number": "१२-९-३८", "content_sanskrit": "एवं वरान् स मुनये दत्त्वाऽगात् त्र्यक्ष ईश्वरः।\nदेव्यै तत् कर्म कथयन्ननुभूतं पुराऽमुना॥ १२/९/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.048.m4a", "display_order": 49}, {"id": 6000341049, "chapter_id": 10341, "verse_number": "१२-९-३९", "content_sanskrit": "सोऽप्यवाप्तमहायोगमहिमा भार्गवोत्तमः।\nविचरत्यधुनाऽप्यद्धा हरावेकान्ततां गतः॥ १२/९/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.049.m4a", "display_order": 50}, {"id": 6000341050, "chapter_id": 10341, "verse_number": "१२-९-४०", "content_sanskrit": "अनुवर्णितमेतत् ते मार्कण्डेयस्य धीमतः।\nअनुभूतं भगवतो मायावैभवमद्भुतम्॥ १२/९/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.050.m4a", "display_order": 51}, {"id": 6000341051, "chapter_id": 10341, "verse_number": "१२-९-४१", "content_sanskrit": "एतत् केचिदविद्वांसो मायाप्रसृतिमात्मनः।\nअनाद्यावर्तितं नॄणां कादाचित्कं प्रचक्षते॥ १२/९/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.051.m4a", "display_order": 52}, {"id": 6000341052, "chapter_id": 10341, "verse_number": "१२-९-४२", "content_sanskrit": "य एवमेतद् भृगुवर्यवर्णितं रथाङ्गपाणेरनुभावभावितम्।\nसंश्रावयेत् संशृणुयादुतोभयोस्तयोर्न कर्माशयसंसृतिर्भवेत्॥ १२/९/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_009/BhP_12.009.052.m4a", "display_order": 53}, {"id": 6000341053, "chapter_id": 10341, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां द्वादशस्कन्धे नवमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]