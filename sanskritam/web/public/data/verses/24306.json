[{"id": 7004306000, "chapter_id": 24306, "verse_number": "५-२-८४-१", "content_sanskrit": "श्रीमहादेव उवाच ।\nउत्तरेश्वरमाहात्म्यमशेषपापनाशनम् ।\nजन्ममृत्युजराव्याधिस्फोटनं शृणु पार्वति॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004306001, "chapter_id": 24306, "verse_number": "५-२-८४-२", "content_sanskrit": "अयोध्यायामतिख्यातकुलोत्पन्नश्च पार्थिवः ।\nसुधीः परीक्षिन्नामा च मृगयामगमत्स च॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004306002, "chapter_id": 24306, "verse_number": "५-२-८४-३", "content_sanskrit": "मृगमनुससाराथ मृगो दूरमपासरत्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004306003, "chapter_id": 24306, "verse_number": "५-२-८४-४", "content_sanskrit": "तदाध्वनि जातश्रमः क्षुत्तृष्णाभिभूतः कस्मिंश्चिद्वनोद्देशे नीलवनमपश्यच्चाविवेश॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004306004, "chapter_id": 24306, "verse_number": "५-२-८४-५", "content_sanskrit": "तस्य वनखण्डस्य दक्षिणभागे सरो दृष्ट्वा साश्व एव व्यगाहत॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004306005, "chapter_id": 24306, "verse_number": "५-२-८४-६", "content_sanskrit": "अथाश्वस्थः सन्मृणालमश्वस्याग्रतो निक्षिप्य पुष्करिणीं समुपाविशत्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004306006, "chapter_id": 24306, "verse_number": "५-२-८४-७", "content_sanskrit": "शयितस्ततः शयानो गीतमशृणोत्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004306007, "chapter_id": 24306, "verse_number": "५-२-८४-८", "content_sanskrit": "स श्रुत्वाचिंतयन्नेह मनुष्यगतिं प्रपश्यामि॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004306008, "chapter_id": 24306, "verse_number": "५-२-८४-९", "content_sanskrit": "कस्य खल्वयं गीतशब्द इत्यवलोकयामास॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004306009, "chapter_id": 24306, "verse_number": "५-२-८४-१०", "content_sanskrit": "अथापश्यत्कन्यां परमरूपदर्शनीयां पुष्पाणि विचिन्वंतीं चाथ राजा समीपे पर्यक्रामत्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004306010, "chapter_id": 24306, "verse_number": "५-२-८४-११", "content_sanskrit": "तामब्रवीद्राजा कस्यासि त्वं कन्या परमरूपदर्शनीया पुष्पाणि विचिन्वती॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004306011, "chapter_id": 24306, "verse_number": "५-२-८४-१२", "content_sanskrit": "साथ राजसमीपे गत्वेति प्रोवाच कन्यास्मीति॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004306012, "chapter_id": 24306, "verse_number": "५-२-८४-१३", "content_sanskrit": "राजोवाच ।\nअर्थी तवास्मीति॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004306013, "chapter_id": 24306, "verse_number": "५-२-८४-१४", "content_sanskrit": "अथोवाच कन्या ।\nसमयेनाहं त्वया शक्योपालब्धुं नान्यथेति॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004306014, "chapter_id": 24306, "verse_number": "५-२-८४-१५", "content_sanskrit": "तां राजा समपृच्छत्कस्ते समय इति॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004306015, "chapter_id": 24306, "verse_number": "५-२-८४-१६", "content_sanskrit": "ततः कन्या तमुवाच नोदकं दर्शयितव्यमिति॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004306016, "chapter_id": 24306, "verse_number": "५-२-८४-१७", "content_sanskrit": "राजा बाढमित्युक्ता तां समागम्य तया सहास्ते॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004306017, "chapter_id": 24306, "verse_number": "५-२-८४-१८", "content_sanskrit": "तत्रैवासन्ने राजनि सेना त्वागच्छत् तया सहोपविष्टं राजानं परिवार्य चातिष्ठत्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004306018, "chapter_id": 24306, "verse_number": "५-२-८४-१९", "content_sanskrit": "सभाजितश्च राजा तथैव शिबि कया प्रायात् ।\nअथ झटिति तया सह स्वं नगरमनुप्राप्य रहसि तया सह रममाणः सन्नान्यं किंचिदपश्यदथ प्रधानोमात्यस्तस्याभ्याशचरास्ताः स्त्रियोऽभ्यपृच्छत्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004306019, "chapter_id": 24306, "verse_number": "५-२-८४-२०", "content_sanskrit": "किमत्र प्रयोजनं विद्यते इत्यब्रुवंस्ताः स्त्रियो पूर्वमेव पश्यामस्तदुदकं नात्राश्रियत इति॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004306020, "chapter_id": 24306, "verse_number": "५-२-८४-२१", "content_sanskrit": "अथामा त्यश्च निरुदकं कारयित्वा दारुवृक्षं वृद्धपुष्पफलं शरद्युपलभ्य राजानामब्रवीत् ।\nवनमिदमनुदकं साध्वत्र रम्यतामिति॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004306021, "chapter_id": 24306, "verse_number": "५-२-८४-२२", "content_sanskrit": "स तस्य वचनात्त यैव सह देव्या वनं प्राविशत्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004306022, "chapter_id": 24306, "verse_number": "५-२-८४-२३", "content_sanskrit": "सकलत्रस्तस्मिन्वने रम्ये तयैव सह रेमे॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004306023, "chapter_id": 24306, "verse_number": "५-२-८४-२४", "content_sanskrit": "प्रविश्य च राजा सह प्रियया सुधाधवलसलिलपूर्णां वापीमपश्यत्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004306024, "chapter_id": 24306, "verse_number": "५-२-८४-२५", "content_sanskrit": "वापीं दर्दुरैः पूर्णां दृष्ट्वैव च तां तस्या एव तीरे तया देव्यातिष्ठत्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004306025, "chapter_id": 24306, "verse_number": "५-२-८४-२६", "content_sanskrit": "अथ तां देवीं राजाब्रवीत् ।\nशांततरं वापीसलिलमिति॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004306026, "chapter_id": 24306, "verse_number": "५-२-८४-२७", "content_sanskrit": "सा च तद्वचः श्रुत्वा तीर्थवापीं न्यमज्जन्न पुनरुदमज्जत् ।\nतां मृगयमाणो राजा नापश्यत्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004306027, "chapter_id": 24306, "verse_number": "५-२-८४-२८", "content_sanskrit": "वापीं दर्दुरैर् पूर्णां दृष्ट्वा आज्ञापयामास भृत्यान्सर्वदर्दुरवधः क्रियतामिति॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004306028, "chapter_id": 24306, "verse_number": "५-२-८४-२९", "content_sanskrit": "यो ममार्थी स तैर्ददुरैरुपायनैर्मामनुतिष्ठेत्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004306029, "chapter_id": 24306, "verse_number": "५-२-८४-३०", "content_sanskrit": "अथ कश्चिन्महान्दर्दुरो दर्दुरवधे क्रियमाणे सर्वासु दिक्ष्वभ्यगात्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004306030, "chapter_id": 24306, "verse_number": "५-२-८४-३१", "content_sanskrit": "उपेत्य चैनमुवाचेदं ज्ञात्वा क्रोधवशंगतम् ।\nप्रसादं कुरु नार्हसि दर्दुराणामनपराधिनां वधं कर्तुमिति॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004306031, "chapter_id": 24306, "verse_number": "५-२-८४-३२", "content_sanskrit": "श्लोकश्चात्र भवति ।\nमा दुर्दुरान्प्रभिंद्यास्त्वं कोपं संधारयाच्युत ।\nप्रक्षीयते महाधर्मो जनानां परिजानताम्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004306032, "chapter_id": 24306, "verse_number": "५-२-८४-३३", "content_sanskrit": "तमेवं वादिनमिष्टजनवियोगे शाकपरीतात्मानं स राजा प्रोवाच ।\nनहि काममप्येतन्निष्कामेन निबर्हणीया इति॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004306033, "chapter_id": 24306, "verse_number": "५-२-८४-३४", "content_sanskrit": "एतैर्दुरात्मभिर्म स्त्री भक्षिता सर्वथैव त्विम वध्या दर्दुराः ।\nनार्हसि विद्वन्नुपरोद्धुमिति॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004306034, "chapter_id": 24306, "verse_number": "५-२-८४-३५", "content_sanskrit": "स तद्वाक्यमुपश्रुत्य व्यथितेंद्रियमनाः प्रोवाच प्रसीद राजन्नहमायुर्नामभूपालः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004306035, "chapter_id": 24306, "verse_number": "५-२-८४-३६", "content_sanskrit": "प्राप्ता सा मम दुहिता ।\nसा कन्या नागलोकं गता ।\nअत्रास्ते नागचूडो नागराजः ।\nस्मृता आगमिष्यति॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004306036, "chapter_id": 24306, "verse_number": "५-२-८४-३७", "content_sanskrit": "तामब्रवीद्राजा तां स्मृत्वानीय मे दीयतामिति॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004306037, "chapter_id": 24306, "verse_number": "५-२-८४-३८", "content_sanskrit": "अथैनां स्मृत्वा राज्ञे अदात् ।\nअब्रवीच्च॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004306038, "chapter_id": 24306, "verse_number": "५-२-८४-३९", "content_sanskrit": "मयावहसितो गालवो महान्मुनिः तपसा कर्शितांगः ।\nक्षमेश्वरो दर्दुरबाल्यात्प्रकोपितः तेनाहं शप्तः यन्मामनादृत्य दर्दुरबाल्यादवहसितस्तस्माद्दर्दुरो भविष्यसि॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004306039, "chapter_id": 24306, "verse_number": "५-२-८४-४०", "content_sanskrit": "प्रसादितस्तु विप्रः प्रत्युवाच॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004306040, "chapter_id": 24306, "verse_number": "५-२-८४-४१", "content_sanskrit": "अवितथोऽयं मम शापस्तस्मादन्यजन्मनि दर्दुरराजो भूत्वा त्वं हि दुहितरमिक्ष्वाकुकुलोत्पन्नाय सर्वगुणान्विताय दत्त्वा यदा यास्यसि महाकालवने तस्योत्तरदिग्भागे तदा लिंगस्य दर्शनेन मुक्तिमवाप्स्यसि॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004306041, "chapter_id": 24306, "verse_number": "५-२-८४-४२", "content_sanskrit": "दुहिता कियत्पातालं यास्यति स्मृता चागमिष्यति ।\nस्वस्ति तेऽस्तु साधयिष्यामि कार्याणि इत्युक्त्वा दर्दुरो महाकालवनमगच्छत्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004306042, "chapter_id": 24306, "verse_number": "५-२-८४-४३", "content_sanskrit": "तस्योत्तरे लिंगं ददर्श तस्य दर्शनादनेकमा णिक्यरचितं सिद्धगन्धर्वसेवितं विमानवरमारुह्य शक्रलोकं गतः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004306043, "chapter_id": 24306, "verse_number": "५-२-८४-४४", "content_sanskrit": "तस्य माहात्म्यमवलोक्य देवाचार्यो बृहस्पतिर्वाक्यं जगाद॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004306044, "chapter_id": 24306, "verse_number": "५-२-८४-४५", "content_sanskrit": "अहो लिंगस्य माहात्म्यमहो लिंगस्य वैभवम् ।\nसंप्राप्तो वासवं लोकं शापभ्रष्टो हि दर्दुरः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004306045, "chapter_id": 24306, "verse_number": "५-२-८४-४६", "content_sanskrit": "आयुराख्यो हि भूपालो मुक्तो दर्दुरतां गतः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004306046, "chapter_id": 24306, "verse_number": "५-२-८४-४७", "content_sanskrit": "इति तद्वचनं श्रुत्वा देवाचार्यस्य पार्वति ।\nदेवास्ते हष्टमनसो नाम चकुः समाहिताः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004306047, "chapter_id": 24306, "verse_number": "५-२-८४-४८", "content_sanskrit": "यस्माद्दर्दुरभूपालो मुक्तो दर्दुरयोनितः ।\nदर्शनात्तस्य लिंगस्य तस्मात्ख्यातो भविष्यति॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004306048, "chapter_id": 24306, "verse_number": "५-२-८४-४९", "content_sanskrit": "उत्तरेश्वरदेवश्च शापपापप्रणोदकः ।\nइत्युक्त्वा त्रिदशैः सर्वैः पूजितो ह्युत्तरेश्वरः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004306049, "chapter_id": 24306, "verse_number": "५-२-८४-५०", "content_sanskrit": "भुक्तिमुक्तिप्रदो देवि महापातकनाशनः ।\nक्षेत्रस्य रक्षणार्थाय नियुक्तो यो मया गणः ।\nदर्दुरो हि दुराधर्षः स चापीश्वरतां गतः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004306050, "chapter_id": 24306, "verse_number": "५-२-८४-५१", "content_sanskrit": "उत्तराशामथो गत्वा यः पश्येदुत्तरेश्वरम् ।\nस सर्वैश्वर्यसंयुक्तो याति लोकमथोत्तरम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004306051, "chapter_id": 24306, "verse_number": "५-२-८४-५२", "content_sanskrit": "सुभगः सर्वदा दांतः सुरूपः पुत्रवानिति ।\nनीरोगः पुण्यशीलश्च जायते सप्तजन्म च॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004306052, "chapter_id": 24306, "verse_number": "५-२-८४-५३", "content_sanskrit": "या वृद्धिस्तु कुबेरस्य शक्रस्य च यमस्य च ।\nवरुणस्य च या वृद्धिः सा वृद्धिरुत्तरोत्तरा ।\nजायते नात्र सन्देह उत्तरेश्वरदर्शनात॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004306053, "chapter_id": 24306, "verse_number": "५-२-८४-५४", "content_sanskrit": "कृष्णपक्षे चतुर्दश्यां ये पश्यंति यशस्विनि ।\nउत्तरेश्वरसंज्ञं तु ते कृतार्थाः कलौ युगे॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004306054, "chapter_id": 24306, "verse_number": "५-२-८४-५५", "content_sanskrit": "किं दानैः किं तपोभिश्च किं यज्ञैर्बहुदक्षिणैः ।\nदर्शनाल्लभते राज्यं स्वर्गं मोक्षं क्रमेण तु॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004306055, "chapter_id": 24306, "verse_number": "५-२-८४-५६", "content_sanskrit": "आजन्म च कृतं पापं स्वल्पं वा यदि वा बहु ।\nतत्सर्वं नाशमायाति उत्तरेश्वरदर्शनात्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004306056, "chapter_id": 24306, "verse_number": "५-२-८४-५७", "content_sanskrit": "इत्येवं चतुराशीतिः संख्याता ईश्वरास्तव ।\nकथिता ये त्वया पृष्टा महाकालवने मया॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004306057, "chapter_id": 24306, "verse_number": "५-२-८४-५८", "content_sanskrit": "य एतेषां देवि यात्रां प्रतिलोमानुलोमतः ।\nकरिष्यंति नरा भक्त्या ते यास्यंति परं पदम्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004306058, "chapter_id": 24306, "verse_number": "५-२-८४-५९", "content_sanskrit": "यश्चापि पूजयेत्तत्र लिंगं भक्त्या तु मानवः ।\nस कुलं तारयत्येव पैतृकं मातृकं शतम्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004306059, "chapter_id": 24306, "verse_number": "५-२-८४-६०", "content_sanskrit": "एष ते कथितो देवि प्रभावः पाप नाशनः ।\nचतुराशीतिलिंगानां किं भूयः श्रोतुमिच्छसि॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]