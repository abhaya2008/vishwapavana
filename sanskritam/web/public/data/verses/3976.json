[{"id": 2137313, "chapter_id": 3976, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2137314, "chapter_id": 3976, "verse_number": "१", "content_sanskrit": "भगवन्तमहं भक्तो यथा मां वेत्थ गोपते ।\nतथा परमतिग्मांशो नान्यं देवं कथञ्चन \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2137315, "chapter_id": 3976, "verse_number": "२", "content_sanskrit": "न मे दारा न मे पुत्रा न चात्मा सुहृदो न च ।\nतथेष्टा वै सदा भक्त्या यथा त्वं गोपते मम \t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2137316, "chapter_id": 3976, "verse_number": "३", "content_sanskrit": "इष्टानां च महात्मानो भक्तानां च न संशयः ।\nकुर्वन्ति भक्तिमिष्टां च जानीषे त्वं च भास्कर \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2137317, "chapter_id": 3976, "verse_number": "४", "content_sanskrit": "इष्टो भक्तश्च मे कर्णो न चान्यद् दैवतं दिवि ।\nजानीत इति वै कृत्वा भगवानाह मद्धितम् \t ॥ ४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2137318, "chapter_id": 3976, "verse_number": "५", "content_sanskrit": "भूयश्च शिरसा याचे प्रसाद्य च पुनः पुनः ।\nइति ब्रवीमि तिग्मांशो त्वं तु मे क्षन्तुमर्हसि\t॥ ५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2137319, "chapter_id": 3976, "verse_number": "६", "content_sanskrit": "बिभेमि न तथा मृत्योर्यथा बिभ्येऽनृतादहम् ।\nविशेषेण द्विजातीनां सर्वेषां सर्वदा सताम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2137320, "chapter_id": 3976, "verse_number": "७", "content_sanskrit": "प्रदाने जीवितस्यापि न मेऽत्रास्ति विचारणा ।\nयच्च मामात्थ देव त्वं पाण्डवं फल्गुनं प्रति \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2137321, "chapter_id": 3976, "verse_number": "८", "content_sanskrit": "व्येतु सन्तापजं दुःखं तव भास्कर मानसम् ।\nअर्जुनप्रतिमं चैव विजेष्यामि रणेऽर्जुनम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2137322, "chapter_id": 3976, "verse_number": "९", "content_sanskrit": "तवापि विदितं देव ममाप्यस्त्रबलं महत् ।\nजामदग्न्यादुपात्तं यत् तथा द्रोणान्महात्मनः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2137323, "chapter_id": 3976, "verse_number": "१०", "content_sanskrit": "इदं त्वमनुजानीहि सुरश्रेष्ठ व्रतं मम ।\nभिक्षते वज्रिणे दद्यामपि जीवितमात्मनः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2137324, "chapter_id": 3976, "verse_number": "", "content_sanskrit": "सूर्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2137325, "chapter_id": 3976, "verse_number": "११", "content_sanskrit": "यदि तात ददास्येते वज्रिणे कुण्डले शुभे ।\nत्वमप्येनमथो ब्रूया विजयार्थं महाबलम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2137326, "chapter_id": 3976, "verse_number": "१२", "content_sanskrit": "नियमेन प्रदद्यां ते कुण्डले वै शतक्रतो ।\nअवध्यो ह्यसि भूतानां कुण्डलाभ्यां समन्वितः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2137327, "chapter_id": 3976, "verse_number": "१३", "content_sanskrit": "अर्जुनेन विनाशं हि तव दानवसूदनः ।\nप्रार्थयानो रणे वत्स कुण्डले ते जिहीर्षति \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2137328, "chapter_id": 3976, "verse_number": "१४", "content_sanskrit": "स त्वमप्येनमाराध्य सूनृताभिः पुनः पुनः ।\nअभ्यर्थयेथा देवेशममोघार्थं पुरन्दरम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2137329, "chapter_id": 3976, "verse_number": "१५", "content_sanskrit": "अमोघां देहि मे शक्तिममित्रविनिबर्हिणीम् ।\nदास्यामि ते सहस्राक्ष कुण्डले वर्म चोत्तमम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2137330, "chapter_id": 3976, "verse_number": "१६", "content_sanskrit": "इत्येव नियमेन त्वं दद्याः शक्राय कुण्डले ।\nतया त्वं कर्ण सङ्ग्रामे हनिष्यसि रणे रिपून् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2137331, "chapter_id": 3976, "verse_number": "१७", "content_sanskrit": "नाहत्वा हि महाबाहो शत्रूनेति करं पुनः ।\nसा शक्तिर्देवराजस्य शतशोऽथ सहस्रशः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2137332, "chapter_id": 3976, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2137333, "chapter_id": 3976, "verse_number": "१८", "content_sanskrit": "एवमुक्त्वा सहस्रांशुः सहसान्तरधीयत ।\nकर्णस्तु बुबुधे राजन् स्वप्नान्ते प्रवदन्निव \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2137334, "chapter_id": 3976, "verse_number": "१९", "content_sanskrit": "प्रतिबुद्धस्तु राधेयः स्वप्नं सञ्चिन्त्य भारत ।\nचकार निश्चयं राजन् शक्त्यर्थं वदतां वरः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2137335, "chapter_id": 3976, "verse_number": "२०", "content_sanskrit": "यदि मामिन्द्र आयाति कुण्डलार्थं परन्तपः ।\nशक्त्या तस्मै प्रदास्यामि कुण्डले वर्म चैव ह \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2137336, "chapter_id": 3976, "verse_number": "२१", "content_sanskrit": "स कृत्वा प्रातरुत्थाय कार्याणि भरतर्षभ ।\nब्राह्मणान् वाचयित्वाथ यथाकार्यमुपाक्रमम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2137337, "chapter_id": 3976, "verse_number": "२२", "content_sanskrit": "विधिना राजशार्दूल मुहूर्तमजपत् ततः ।\nततः सूर्याय जप्यान्ते कर्णः स्वप्नं न्यवेदयत् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2137338, "chapter_id": 3976, "verse_number": "२३", "content_sanskrit": "यथा दृष्टं यथातत्त्वं यथोक्तमुभयोर्निशि ।\nतत्सर्वमानुपूर्व्येण शशंसास्मै वृषस्तदा \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2137339, "chapter_id": 3976, "verse_number": "२४", "content_sanskrit": "तच्छ्रुत्वा भगवान् देवो भानुः स्वर्भानुसूदनः ।\nउवाच तं तथेत्येव कर्णं सूर्यः स्मयन्निव \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2137340, "chapter_id": 3976, "verse_number": "२५", "content_sanskrit": "ततस्तत्त्वमिति ज्ञात्वा राधेयः परवीरहा ।\nशक्तिमेवाभिकाङ्क्षन् वै वासवं प्रत्यपालयत् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2137341, "chapter_id": 3976, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि एकनवत्यधिकद्विशततमोऽध्यायः ॥२९१॥\nकुण्डलाहरणपर्वणि सूर्यकर्णसंवादे कुण्डलाहरणपर्वणि तृतीयोऽध्यायः ॥३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]