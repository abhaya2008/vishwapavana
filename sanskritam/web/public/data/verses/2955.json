[{"id": 2091885, "chapter_id": 2955, "verse_number": "१३-८५-१", "content_sanskrit": "युधिष्ठिर उवाच।\nदर्शने कीदृशः स्नेहः संवासे च पितामह।\nमहाभाग्यं गवां चैव तन्मे व्याख्यातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2091886, "chapter_id": 2955, "verse_number": "१३-८५-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2091887, "chapter_id": 2955, "verse_number": "१३-८५-२", "content_sanskrit": "हन्त ते कथयिष्यामि पुरावृत्तं महाद्युते।\nनहुषस्य च संवादं महर्षेश्च्यवनस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2091888, "chapter_id": 2955, "verse_number": "१३-८५-३", "content_sanskrit": "पुरा महर्षिश्च्यवनो भार्गवो भरतर्षभ।\nउदवासकृतारम्भो बभूव स महाव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2091889, "chapter_id": 2955, "verse_number": "१३-८५-४", "content_sanskrit": "निहत्य मानं क्रोधं च प्रहर्षं शोकमेव च।\nवर्षाणि द्वादश मुनिर्जलवासे धृतव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2091890, "chapter_id": 2955, "verse_number": "१३-८५-५", "content_sanskrit": "आदधत्सर्वभूतेषु विस्रम्यं परमं शुभम्।\nजलेचरेषु सर्वेषु शीतरश्मिरिव प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2091891, "chapter_id": 2955, "verse_number": "१३-८५-६", "content_sanskrit": "स्थाणुभूतः शुचिर्भूत्वा दैवतेभ्यः प्रणम्य च।\nगङ्गायमुनयोर्मध्ये जलं सम्प्रविवेश ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2091892, "chapter_id": 2955, "verse_number": "१३-८५-७", "content_sanskrit": "गङ्गायमुनयोर्वेगं सुभीमं भीमनिःस्वनम्।\nप्रतिजग्राह शिरसा वातवेगसमं जवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2091893, "chapter_id": 2955, "verse_number": "१३-८५-८", "content_sanskrit": "गङ्गा च यमुना चैव सरितश्च सरांसि च।\nप्रदक्षिणमृषिं चक्रुर्न चैनं पर्यपीडयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2091894, "chapter_id": 2955, "verse_number": "१३-८५-९", "content_sanskrit": "अन्तर्जलेषु सुष्वाप काष्ठभूतो महामुनिः।\nततश्चोर्ध्वस्थितो धीमानभवद्भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2091895, "chapter_id": 2955, "verse_number": "१३-८५-१०", "content_sanskrit": "जलौकसां ससत्वानां बभूव प्रियदर्शनः।\nउपाजिघ्नन्त च तदा मत्स्यास्तं हृष्टमानसाः।\nतत्र तस्यासतः कालः समतीतोऽभवन्महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2091896, "chapter_id": 2955, "verse_number": "१३-८५-११", "content_sanskrit": "ततः कदाचित्समये कस्मिंश्चिन्मत्स्यजीविनः।\nतं देशं समुपाजग्मुर्जालहस्ता महाद्युते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2091897, "chapter_id": 2955, "verse_number": "१३-८५-१२", "content_sanskrit": "निषादा बहवस्तत्र मत्स्योद्धरणनिश्चयाः।\nव्यायता बलिनः शूराः सलिलेष्वनुवर्तिनः।\nअभ्याययुश्च तं देशं निश्चिता जालकर्म्णि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2091898, "chapter_id": 2955, "verse_number": "१३-८५-१३", "content_sanskrit": "जालं ते योजयामासुर्नवसूत्रकृतं दृढम्।\nमत्स्योद्धरणमाकर्षस्तदा भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2091899, "chapter_id": 2955, "verse_number": "१३-८५-१४", "content_sanskrit": "ततस्ते बहुभिर्योगैः कैवर्ता मत्स्यकाङ्क्षिणः।\nगङ्गायमुनयोर्वारि जालेनावकिरन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2091900, "chapter_id": 2955, "verse_number": "१३-८५-१५", "content_sanskrit": "जालं सुविततं तेषां नवसूत्रकृतं तथा।\nविस्तारायामसम्पन्नं यत्तत्र सलिले क्षमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2091901, "chapter_id": 2955, "verse_number": "१३-८५-१६", "content_sanskrit": "ततस्ते सुमहच्चैव बलवच्च सुवर्तितम्।\nअवतीर्य ततः सर्वे जालं चकृषिरे तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2091902, "chapter_id": 2955, "verse_number": "१३-८५-१७", "content_sanskrit": "अभीतरूपाः संहृष्टा अन्योन्यवशवर्तिनः।\nबबन्धुस्तत्र मत्स्यांश्च तथाऽन्याञ्जलचारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2091903, "chapter_id": 2955, "verse_number": "१३-८५-१८", "content_sanskrit": "तथा मत्स्यैः परिवृतं च्यवनं भृगुनन्दनम्।\nआकर्षयन्महाराज जालेनाथ यदृच्छया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2091904, "chapter_id": 2955, "verse_number": "१३-८५-१९", "content_sanskrit": "नदीशैवलदिग्धाङ्गं हरिश्मश्रुजटाधरम्।\nलग्नैः शङ्खनखैर्गात्रे क्रोडैश्चित्रैरिवार्पितम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2091905, "chapter_id": 2955, "verse_number": "१३-८५-२०", "content_sanskrit": "तं जालेनोद्धृतं दृष्ट्वा ते तदा वेदपारगम्।\nसर्वे प्राञ्जलयो दाशाः शिरोभिः प्रापतन्भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2091906, "chapter_id": 2955, "verse_number": "१३-८५-२१", "content_sanskrit": "परिखेदपरित्रासाज्जालस्याकर्षणेन च।\nमत्स्या बभूवुर्व्यापन्नाः स्थलसंस्पर्शनेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2091907, "chapter_id": 2955, "verse_number": "१३-८५-२२", "content_sanskrit": "स मुनिस्तत्तदा दृष्ट्वा मत्स्यानां कदनं कृतम्।\nबभूव कृपयाविष्टो निःश्वसंश्च पुनःपनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2091908, "chapter_id": 2955, "verse_number": "१३-८५-२३x", "content_sanskrit": "निषादा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2091909, "chapter_id": 2955, "verse_number": "१३-८५-२३", "content_sanskrit": "अज्ञानाद्यत्कृतं पापं प्रसादं तत्र नः कुरु।\nकरवाम प्रिय किं ते तन्नो ब्रूहि महामुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2091910, "chapter_id": 2955, "verse_number": "१३-८५-२४", "content_sanskrit": "इत्युक्तो मत्स्यमध्यस्थश्च्यवनो वाक्यमब्रवीत्।\nयो मेऽद्य परमः कामस्तं शृणुध्वं मसाहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2091911, "chapter_id": 2955, "verse_number": "१३-८५-२५", "content_sanskrit": "प्राणोत्सर्गं विसर्गं वा मत्स्यैर्यास्याम्यहं सह।\nसंवासान्नोत्सहे त्यक्तुं सलिलेऽध्युपितानहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2091912, "chapter_id": 2955, "verse_number": "१३-८५-२६", "content_sanskrit": "इत्युक्तास्ते निषादास्तु सुभृशं भयकम्पिताः।\nसर्वे विवर्णवदना नहुषाय न्यवेदयन्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2091913, "chapter_id": 2955, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि पश्चाशीतितमोऽध्यायः॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]