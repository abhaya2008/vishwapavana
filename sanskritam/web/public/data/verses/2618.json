[{"id": 2076364, "chapter_id": 2618, "verse_number": "१२-१२३-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2076365, "chapter_id": 2618, "verse_number": "१२-१२३-१", "content_sanskrit": "तात धर्मार्थकामानां श्रोतुमिच्छामि निश्चयम्।\nलोकयात्रा हि कार्त्स्न्येन त्रिष्वेतेषु प्रतिष्ठिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2076366, "chapter_id": 2618, "verse_number": "१२-१२३-२", "content_sanskrit": "धर्मार्थकामाः किंमूलाः प्रभवः प्रलयश्च कः।\nअन्योन्यं चानुषज्जन्ते वर्तन्ते च पृथक्पृथक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2076367, "chapter_id": 2618, "verse_number": "१२-१२३-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2076368, "chapter_id": 2618, "verse_number": "१२-१२३-३", "content_sanskrit": "य एते स्युः सुमनसो लोकसंस्थार्थनिश्चये।\nकामप्रभवसंस्थासु सज्जन्ते च त्रयस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2076369, "chapter_id": 2618, "verse_number": "१२-१२३-४", "content_sanskrit": "धर्ममूलोऽर्थ इत्युक्तः कामोऽर्थफलमुच्यते।\nसंकल्पमूलास्ते सर्वे संकल्पो विषयात्मकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2076370, "chapter_id": 2618, "verse_number": "१२-१२३-५", "content_sanskrit": "विषयाश्चैव कार्त्स्न्येन सर्व आहारसिद्धये।\nमूलमेतन्त्रिवर्गस्य निवृत्तिर्मोक्ष उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2076371, "chapter_id": 2618, "verse_number": "१२-१२३-६", "content_sanskrit": "धर्मः शरीरसंगुप्तिर्धर्मार्थश्चार्थ इष्यते।\nकामो रतिफलश्चात्र सर्वे रतिफलाः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2076372, "chapter_id": 2618, "verse_number": "१२-१२३-७", "content_sanskrit": "सन्निकृष्टांश्चरेदेतान्न चैतान्मनसा त्यजेत्।\nविमुक्तस्तपसा सर्वान्धर्मादीन्कामनैष्ठिकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2076373, "chapter_id": 2618, "verse_number": "१२-१२३-८", "content_sanskrit": "श्रेष्ठबुद्धिस्त्रिवर्गस्य उदयं प्राप्नुयात्क्षणात्।\n[कर्मणा बुद्धिपूर्वेण भवत्यर्थो न वा पुनः॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2076374, "chapter_id": 2618, "verse_number": "१२-१२३-९", "content_sanskrit": "अर्थार्थमन्यद्भवति विपरीतमथापरम्।\nअनर्थार्थमवाप्यार्थमन्यत्राद्योपकारकम्।]\nबुद्ध्या बुद्ध इहार्थेन तदह्ना तु निकृष्टया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2076375, "chapter_id": 2618, "verse_number": "१२-१२३-१०", "content_sanskrit": "अपध्यानमलो धर्मो मलोऽर्थस्य निगूहनम्।\nसंप्रमोहमलः कामो भूयस्तद्गुणवर्धितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2076376, "chapter_id": 2618, "verse_number": "१२-१२३-११", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nअरिष्टस्य च संवादं कामन्दस्य च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2076377, "chapter_id": 2618, "verse_number": "१२-१२३-१२", "content_sanskrit": "कामन्दमृषिमासीनमभिवाद्य नराधिपः।\nआङ्गोरिष्ठोऽथ पप्रच्छ कृत्वा समयमव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2076378, "chapter_id": 2618, "verse_number": "१२-१२३-१३", "content_sanskrit": "यः पापं कुरुते राजा काममोहबलात्कृतः।\nप्रत्यासन्नस्य तस्यर्षे किं स्यात्पापप्रणाशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2076379, "chapter_id": 2618, "verse_number": "१२-१२३-१४", "content_sanskrit": "अधर्मं धर्म इति च यो मोहादाचरेन्नरः।\nतं चापि प्रथितं लोके कथं राजा निवर्तयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2076380, "chapter_id": 2618, "verse_number": "१२-१२३-१५x", "content_sanskrit": "कामन्द उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2076381, "chapter_id": 2618, "verse_number": "१२-१२३-१५", "content_sanskrit": "यो धर्मार्थौ परित्यज्य काममेवानुवर्तते।\nस धर्मार्थपरित्यागात्प्रज्ञानाशमिहार्च्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2076382, "chapter_id": 2618, "verse_number": "१२-१२३-१६", "content_sanskrit": "प्रज्ञानाशात्मको मोहस्तथा धर्मार्थनाशकः।\nतस्मान्नास्तिकता चैव दुराचारश्च जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2076383, "chapter_id": 2618, "verse_number": "१२-१२३-१७", "content_sanskrit": "दुराचारान्यदा राजा प्रदुष्टान्न नियच्छति।\nतस्मादुद्विजते लोकः सर्पाद्वेश्मगतादिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2076384, "chapter_id": 2618, "verse_number": "१२-१२३-१८", "content_sanskrit": "तं प्रजा नानुरज्यन्ते न विप्रा न च साधवः।\nततः संक्षयमाप्नोति तथा वध्यत्वमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2076385, "chapter_id": 2618, "verse_number": "१२-१२३-१९", "content_sanskrit": "अपध्वस्तस्त्ववमतो दुःखं जीवति जीवितम्।\nजीवते यदपध्वस्तः शुद्धं मरणमेव तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2076386, "chapter_id": 2618, "verse_number": "१२-१२३-२०", "content_sanskrit": "अत्रैतदाहुराचार्याः पापस्य परिवर्तनम्।\nसेवितव्या त्रयी विद्या सत्कारो ब्राह्मणेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2076387, "chapter_id": 2618, "verse_number": "१२-१२३-२१", "content_sanskrit": "महामना भवेद्धर्मे विवहेच्च महाकुले।\nब्राह्मणांश्चापि सेवेत क्षमायुक्तान्मनस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2076388, "chapter_id": 2618, "verse_number": "१२-१२३-२२", "content_sanskrit": "जपेदुदकशीलः स्यात्सुमुखो न च नास्तिकः।\nधर्मान्वितान्संप्रविशेद्बहिः प्लुत्यैव दुष्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2076389, "chapter_id": 2618, "verse_number": "१२-१२३-२३", "content_sanskrit": "प्रसादयेन्मधुरया वाचा वाऽप्यथ कर्मणा।\nइत्यस्तीति वदेन्नित्यं परेषां कीर्तयन्गुणान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2076390, "chapter_id": 2618, "verse_number": "१२-१२३-२४", "content_sanskrit": "अपापो ह्येवमाचारः क्षिप्रं बहुमतो भवेत्।\nपापान्यपि हि कृच्छ्राणि शमयेन्नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2076391, "chapter_id": 2618, "verse_number": "१२-१२३-२५", "content_sanskrit": "गुरवो हि परं धर्मं यं ब्रूयुस्तं तथा कुरु।\nगुरूणां हि प्रसादाद्वै श्रेयः परमवाप्स्यसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2076392, "chapter_id": 2618, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि त्रयोविंशत्यधिकशततमोऽध्यायः॥ १२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]