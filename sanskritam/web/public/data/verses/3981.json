[{"id": 2137473, "chapter_id": 3981, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2137474, "chapter_id": 3981, "verse_number": "१", "content_sanskrit": "सा तु कन्या बहुविधं ब्रुवन्ती मधुरं वचः ।\nअनुनेतुं सहस्रांशुं न शशाक मनस्विनी \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2137475, "chapter_id": 3981, "verse_number": "२", "content_sanskrit": "न शशाक यदा बाला प्रत्याख्यातुं तमोनुदम् ।\nभीता शापात् ततो राजन् दध्यौ दीर्घमथान्तरम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2137476, "chapter_id": 3981, "verse_number": "३", "content_sanskrit": "अनागसः पितुः शापो ब्राह्मणस्य तथैव च ।\nमन्निमित्तः कथं न स्यात् क्रुद्धादस्माद् विभावसोः \t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2137477, "chapter_id": 3981, "verse_number": "४", "content_sanskrit": "बालेनापि सता मोहाद् भृशं पापकृतान्यपि ।\nनाभ्यासादयितव्यानि तेजांसि च तपांसि च \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2137478, "chapter_id": 3981, "verse_number": "५", "content_sanskrit": "साहमद्य भृशं भीता गृहीता च करे भृशम् ।\nकथं त्वकार्यं कुर्यां वै प्रदानं ह्यात्मनः स्वयम् \t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2137479, "chapter_id": 3981, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2137480, "chapter_id": 3981, "verse_number": "६", "content_sanskrit": "सा वै शापपरित्रस्ता बहु चिन्तयती हृदा ।\nमोहेनाभिपरीताङ्गी स्मयमाना पुनः पुनः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2137481, "chapter_id": 3981, "verse_number": "७", "content_sanskrit": "तं देवमब्रवीत् भीता बन्धूनां राजसत्तम ।\nव्रीडाविह्वलया वाचा शापत्रस्ता विशाम्पते \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2137482, "chapter_id": 3981, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2137483, "chapter_id": 3981, "verse_number": "८", "content_sanskrit": "पिता मे ध्रियते देव माता चान्ये च बान्धवाः ।\nन तेषु ध्रियमाणेषु विधिलोपो भवेदयम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2137484, "chapter_id": 3981, "verse_number": "९", "content_sanskrit": "मन्निमित्तं कुलस्यास्य लोके कीर्तिर्नशेत् ततः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2137485, "chapter_id": 3981, "verse_number": "१०", "content_sanskrit": "अथवा धर्ममेतं त्वं मन्यसे तपतां वर ।\nऋते प्रदानाद् बन्धुभ्यस्तव कामं करोम्यहम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2137486, "chapter_id": 3981, "verse_number": "११", "content_sanskrit": "आत्मप्रदानं दुर्धर्षं तव कृत्वा सती त्वहम् ।\nत्वयि धर्मो यशश्चैव कीर्तिरायुश्च देहिनाम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2137487, "chapter_id": 3981, "verse_number": "", "content_sanskrit": "सूर्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2137488, "chapter_id": 3981, "verse_number": "१२", "content_sanskrit": "न ते पिता न ते माता गुरवो वा शुचिस्मिते ।\nप्रभवन्ति वरारोहे भद्रं ते शृणु मे वचः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2137489, "chapter_id": 3981, "verse_number": "१३", "content_sanskrit": "सर्वान् कामयते यस्मात् कमेर्धातोश्च भाविनि ।\nतस्मात् कन्येह सुश्रोणि स्वतन्त्रा वरवर्णिनि \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2137490, "chapter_id": 3981, "verse_number": "१४", "content_sanskrit": "नाधर्मश्चरितः कश्चित् त्वया भवति भाविनि ।\nअधर्मं कुत एवाहं वरेयं लोककाम्यया \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2137491, "chapter_id": 3981, "verse_number": "१५", "content_sanskrit": "अनावृताः स्त्रियः सर्वा नराश्च वरवर्णिनि ।\nस्वभाव एष लोकानां विकारोऽन्य इति स्मृतः\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2137492, "chapter_id": 3981, "verse_number": "१६", "content_sanskrit": "सा मया सह सङ्गम्य पुनः कन्या भविष्यसि ।\nपुत्रश्च ते महाबाहुर्भविष्यति महायशाः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2137493, "chapter_id": 3981, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2137494, "chapter_id": 3981, "verse_number": "१७", "content_sanskrit": "यदि पुत्रो मम भवेत् त्वत्तः सर्वतमोनुद ।\nकुण्डली कवची शूरो महाबाहुर्महाबलः ।\nअस्तु मे सङ्गमो देव यथोक्तं भगवंस्त्वया \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2137495, "chapter_id": 3981, "verse_number": "१८", "content_sanskrit": "तिग्मरश्मे महाबाहो सङ्गमिष्ये दुरासद ।\nअस्ति मे सङ्गमो देव अनेन समयेन ते \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2137496, "chapter_id": 3981, "verse_number": "", "content_sanskrit": "सूर्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2137497, "chapter_id": 3981, "verse_number": "१९", "content_sanskrit": "भविष्यति महाबाहुः कुण्डली दिव्यवर्मभृत् ।\nउभयं चामृतमयं तस्य भद्रे भविष्यति \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2137498, "chapter_id": 3981, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2137499, "chapter_id": 3981, "verse_number": "२०", "content_sanskrit": "यद्येतदमृतादस्ति कुण्डले वर्म चोत्तमम् ।\nमम पुत्रस्य यं वै त्वं मत्त उत्पादयिष्यसि ।\nत्वद्वीर्यरूपसत्त्वौजा धर्मयुक्तो भवेत् स च \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2137500, "chapter_id": 3981, "verse_number": "", "content_sanskrit": "सूर्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2137501, "chapter_id": 3981, "verse_number": "२१", "content_sanskrit": "आदित्ये कुण्डले राज्ञि दत्ते मे मत्तकाशिनि ।\nतेऽस्य दास्यामि वै भीरु वर्म चैवेदमुत्तमम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2137502, "chapter_id": 3981, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2137503, "chapter_id": 3981, "verse_number": "२२", "content_sanskrit": "परमं भगवन्नेवं सङ्गमिष्ये त्वया सह ।\nयदि पुत्रो भवेदेवं यथा वदसि गोपते \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2137504, "chapter_id": 3981, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2137505, "chapter_id": 3981, "verse_number": "२३", "content_sanskrit": "तथेत्युक्त्वा तु तां कुन्तीमाविवेश विहङ्गमः ।\nस्वर्भानुशत्रुर्योगात्मा नाभ्यां पस्पर्श चैव ताम् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2137506, "chapter_id": 3981, "verse_number": "२४", "content_sanskrit": "ततः सा विह्वलेवासीत् कन्या सूर्यस्य तेजसा ।\nपपात चाथ सा देवी शयने मूढचेतना \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2137507, "chapter_id": 3981, "verse_number": "", "content_sanskrit": "सूर्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2137508, "chapter_id": 3981, "verse_number": "२५", "content_sanskrit": "साधयिष्यामि सुश्रोणि पुत्रं वै जनयिष्यसि ।\nसर्वशस्त्रभृतां श्रेष्ठं कन्या चैव भविष्यसि \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2137509, "chapter_id": 3981, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2137510, "chapter_id": 3981, "verse_number": "२६", "content_sanskrit": "ततः सा व्रीडिता बाला तदा सूर्यमथाब्रवीत् ।\nएवमस्त्विति राजेन्द्र प्रस्थितं भूरिवर्चसम् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2137511, "chapter_id": 3981, "verse_number": "समाप्तिः", "content_sanskrit": "इति स्मोक्ता कुन्तिराजात्मजा सा\nविवस्वन्तं याचमाना सलज्जा ।\nतस्मिन् पुण्ये शयनीये पपात\nमोहाविष्टा भज्यमाना लतेव \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2137512, "chapter_id": 3981, "verse_number": "२८", "content_sanskrit": "तिग्मांशुस्तां तेजसा मोहयित्वा\nयोगेनाविश्यात्मसंस्थां चकार ।\nन चैवैनां दूषयामास भानुः\nसञ्ज्ञां लेभे भूय एवाथ बाला \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2137513, "chapter_id": 3981, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि षण्णवत्यधिकद्विशततमोऽध्यायः ॥२९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2137514, "chapter_id": 3981, "verse_number": "", "content_sanskrit": "कुण्डलाहरणपर्वणि सूर्यकुन्तीसमागमे अष्टमोऽध्यायः ॥८॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]