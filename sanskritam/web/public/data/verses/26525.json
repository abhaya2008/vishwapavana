[{"id": 7006525000, "chapter_id": 26525, "verse_number": "३-६४-१", "content_sanskrit": "बलेः इन्द्रेण सार्द्धं युद्धं, इन्द्रस्य रणभूमितः पलायनम् वैशम्पायन उवाच बलिना तु सुराः सर्वे वर्जयित्वा सुराधिपम् ।\nरणे शरशतैर्भिन्नाः ससैन्या वै पराजिताः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006525001, "chapter_id": 26525, "verse_number": "३-६४-२", "content_sanskrit": "विमुखा याति दैत्येन्द्रैर्वध्यमाना महाचमूः ।\nजितास्तु बलिना देवाः शक्रमाहुर्महाबलम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006525002, "chapter_id": 26525, "verse_number": "३-६४-३", "content_sanskrit": "देवा ऊचुः भवानिन्द्रश्च धाता च लोकानां प्रभुरव्ययः ।\nत्वमप्रतिमकर्मा च तथैवानुपमद्युतिः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006525003, "chapter_id": 26525, "verse_number": "३-६४-४", "content_sanskrit": "विद्रुतानीह सैन्यानि सहास्माभिः सुरेश्वर ।\nरथचक्रध्वजाक्षाणि विभिन्नानि महासुरैः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006525004, "chapter_id": 26525, "verse_number": "३-६४-५", "content_sanskrit": "रथहस्त्यश्वयोधाश्च पदाताश्च सहस्रशः ।\nभिन्नच्छिन्नाश्च शतशो गदामुशलपट्टिशैः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006525005, "chapter_id": 26525, "verse_number": "३-६४-६", "content_sanskrit": "महाभैरवरूपं हि दैत्येन्द्रेण कृतं रणे ।\nकिमुपेक्षसि दैत्येन्द्रैर्हन्यमाना महाचमूम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006525006, "chapter_id": 26525, "verse_number": "३-६४-७", "content_sanskrit": "त्रायस्व त्रिदशश्रेष्ठ शरण्यः शरणागतान् ।\nश्रुत्वा तु वचनं तेषां देवानाममराधिपः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006525007, "chapter_id": 26525, "verse_number": "३-६४-८", "content_sanskrit": "संवर्ताग्निसमक्रुद्धः सर्वान् दहति दानवान् ।\nदिवाकरकराकारं किरीटं धारयन् प्रभुः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006525008, "chapter_id": 26525, "verse_number": "३-६४-९", "content_sanskrit": "वैदूर्यवर्णसंकाशो नानारत्नचिताङ्गदः ।\nमयूररोमा रक्ताक्षः शतबाहुः सहस्रदृक् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006525009, "chapter_id": 26525, "verse_number": "३-६४-१०", "content_sanskrit": "हरिरेको हरिश्मश्रुर्नानाकेतुर्महाबलः ।\nवज्रप्रहरणः श्रीमान् योगी शतशिरोधरः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006525010, "chapter_id": 26525, "verse_number": "३-६४-११", "content_sanskrit": "सधनुर्बद्धसन्नाहः शतादित्यसमप्रभः ।\nदेवगन्धर्वयक्षौघैरनुयातः सहस्रशः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006525011, "chapter_id": 26525, "verse_number": "३-६४-१२", "content_sanskrit": "सामगैश्च जयैश्चापि स्तूयमानो महर्षिभिः ।\nशतपर्वं महारौद्रं स्फोटनं सर्वतोमुखम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006525012, "chapter_id": 26525, "verse_number": "३-६४-१३", "content_sanskrit": "प्रगृह्य रुचिरं वज्रं दीप्तं रौद्राट्टहासनम् ।\nदैत्यानयोधयत् सर्वान् महेन्द्रः पाकशासनः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006525013, "chapter_id": 26525, "verse_number": "३-६४-१४", "content_sanskrit": "अधृष्यः सर्वभूतानामदित्या दयितः सुतः ।\nततः प्रवृत्तः संग्रामो बलिवासवयोस्तदा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006525014, "chapter_id": 26525, "verse_number": "३-६४-१५", "content_sanskrit": "उभाभ्यां देवदैत्याभ्यामचिरान्महदद्भुतः ।\nअतिवीर्यबलोदग्रस्तुमुलो लोमहर्षणः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006525015, "chapter_id": 26525, "verse_number": "३-६४-१६", "content_sanskrit": "प्रह्लादेन स्तुतिशतैः कर्मभिर्जयसम्मतैः ।\nप्रबोधितो दैत्यपतिरग्निरिद्ध इवाबभौ ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006525016, "chapter_id": 26525, "verse_number": "३-६४-१७", "content_sanskrit": "सुरासुरेन्द्रयोर्दृष्ट्वा संग्रामं लोमहर्षणम् ।\nदेवानां दानवानां च भूयो युद्धमभूत् तदा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006525017, "chapter_id": 26525, "verse_number": "३-६४-१८", "content_sanskrit": "ततोऽविध्यन्महेन्द्रस्तं बलिमस्त्रैर्महाबलम् ।\nतान्यस्त्राणि महाबाहुश्चिच्छेद शतधा रणे  ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006525018, "chapter_id": 26525, "verse_number": "३-६४-१९", "content_sanskrit": "ततः क्रुद्धः पुनस्तत्र निजघ्ने दानवं महत् ।\nआग्नेयमथ शत्रुघ्नं चिक्षेपेन्द्रो महाबलः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006525019, "chapter_id": 26525, "verse_number": "३-६४-२०", "content_sanskrit": "तद्दृष्ट्वा खे समागच्छत् प्रलयानलसंनिभम् ।\nपातयामास तच्चैन्द्रं वारुणास्त्रेण दानवः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006525020, "chapter_id": 26525, "verse_number": "३-६४-२१", "content_sanskrit": "संक्रुद्धो मघवा वज्रमगृह्णात् पर्वतोपमम् ।\nहन्तुकामो रणश्लाघी बलिं दैत्याधिपं रणे ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006525021, "chapter_id": 26525, "verse_number": "३-६४-२२", "content_sanskrit": "ततः शुश्राव देवेन्द्रः कौशिको हरिवाहनः ।\nअशरीरां शुभां वाणीं तस्मिन् महति वैशसे ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006525022, "chapter_id": 26525, "verse_number": "३-६४-२३", "content_sanskrit": "निवर्तस्व महाबाहो सुराणां नन्दिवर्धन ।\nपुरंदर सुरश्रेष्ठ न जेष्यसि रणे बलिम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006525023, "chapter_id": 26525, "verse_number": "३-६४-२४", "content_sanskrit": "तपसात्युत्तमो दैत्यो वरदानेन चाधिकः ।\nस्वयंभूपरितोषाच्च सत्यधर्माच्च वासव ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006525024, "chapter_id": 26525, "verse_number": "३-६४-२५", "content_sanskrit": "नैष शक्यस्त्वया जेतुं त्रिदशैर्वा सुरेश्वर ।\nयो ह्यस्य जेता भगवांस्तं शृणुष्व समाहितः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006525025, "chapter_id": 26525, "verse_number": "३-६४-२६", "content_sanskrit": "ब्रह्मणः स हि सर्वस्वं देवानां चैव सा गतिः ।\nपरं रहस्यं धर्मस्य परस्य च परा गतिः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006525026, "chapter_id": 26525, "verse_number": "३-६४-२७", "content_sanskrit": "परात्परतरः श्रीमान् परावरगतिः प्रभुः ।\nसहस्रशीर्षा पुरुषः सहस्राक्षः सहस्रपात् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006525027, "chapter_id": 26525, "verse_number": "३-६४-२८", "content_sanskrit": "शङ्खचक्रगदापाणिः पीतवासाः सुरारिहा ।\nजेता जेयो जयः श्रीमान्सोऽस्य जेता भविष्यति ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006525028, "chapter_id": 26525, "verse_number": "३-६४-२९", "content_sanskrit": "श्रुत्वा दिव्यां तु मधुरां वाणीं तामशरीरिणीम् ।\nअपयातो रणाच्छक्रः सार्धं सर्वैः सुरोत्तमैः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006525029, "chapter_id": 26525, "verse_number": "३-६४-३०", "content_sanskrit": "अपयाते तु देवेन्द्रे कौशिके हरिवाहने ।\nसिंहनादो महानासीद् दानवानां महामृधे ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006525030, "chapter_id": 26525, "verse_number": "३-६४-३१", "content_sanskrit": "ततः किलकिलाशब्दः क्ष्वेडितास्फोटितस्वनः ।\nशङ्खानां निनदश्चात्र योधानां वल्गितस्वनः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006525031, "chapter_id": 26525, "verse_number": "३-६४-३२", "content_sanskrit": "वादित्राणां च निर्घोषस्तुमुलश्चाभवत्तदा ।\nजयशब्दरवाश्चैव देवानां तु पराजये ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006525032, "chapter_id": 26525, "verse_number": "३-६४-३३", "content_sanskrit": "ससैन्यो दैत्यराजस्तु स्तूयमानः सुहृद्गणैः ।\nबलीन्द्रो विबभौ दैत्यो हिरण्यकशिपुर्यथा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]