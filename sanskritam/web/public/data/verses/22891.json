[{"id": 7002891000, "chapter_id": 22891, "verse_number": "९-१७६-१", "content_sanskrit": "युधिष्ठिर उवाच ।\nभगवन्सर्वभूतेश सर्वभूतनमस्कृत ।\nअनुग्रहाय लोकानां कथयस्व ममापरम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002891001, "chapter_id": 22891, "verse_number": "९-१७६-२", "content_sanskrit": "त्वत्तुल्यो जायते येन आयुषा यशसा श्रिया ।\nतन्मे कथय देवेश दानं व्रतमथापि वा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002891002, "chapter_id": 22891, "verse_number": "९-१७६-३", "content_sanskrit": "श्रीकृष्ण उवाच ।\nशृणु राजन्प्रवक्ष्यामि तव लोकहितेच्छया ।\nयेनोपायेन जायंते मत्तुल्या मानवा भुवि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002891003, "chapter_id": 22891, "verse_number": "९-१७६-४", "content_sanskrit": "न व्रतैनोपवासैश्च न तीर्थगमनैरपि ।\nमहापथादिमरणैर्न यज्ञैर्न श्रुतेन च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002891004, "chapter_id": 22891, "verse_number": "९-१७६-५", "content_sanskrit": "प्राप्यते मम लोकोऽयं दुष्प्राप्यस्त्रिदशैरपि ।\nपार्थस्नेहान्महाभाग प्रवक्ष्यामि हितं तव ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002891005, "chapter_id": 22891, "verse_number": "९-१७६-६", "content_sanskrit": "गोब्राह्मणार्थे मरणं प्राप्तं येन सुमेधसा ।\nप्रयागेऽनशनं वापि पूजितो वाथ शंकरः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002891006, "chapter_id": 22891, "verse_number": "९-१७६-७", "content_sanskrit": "प्रयाति ब्रह्मसालोक्यं श्रुतिरेषा सनातनी ।\nयेन मत्समतां याति तत्ते वक्ष्याम्यतः परम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002891007, "chapter_id": 22891, "verse_number": "९-१७६-८", "content_sanskrit": "दानं हिरण्यगर्भाख्यं कथ्यमानं निबोध मे ।\nअग्नेरपत्यं प्रथमं सुवर्णमिह पठ्यते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002891008, "chapter_id": 22891, "verse_number": "९-१७६-९", "content_sanskrit": "पवित्रं सर्वभूतानां पावनं परमं महत् ।\nपर्यायनाम तस्योक्तं हिरण्यं सार्वलौकिकम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002891009, "chapter_id": 22891, "verse_number": "९-१७६-१०", "content_sanskrit": "तदपां गर्भमाविश्य पुनर्जातं तु भूतले ।\nयश्च तद्ब्राह्मणे दद्यान्मत्तुल्यो जायते हि सः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002891010, "chapter_id": 22891, "verse_number": "९-१७६-११", "content_sanskrit": "युधिष्ठिर उवाच ।\nविधानं तस्य देवेश कथयस्व सनातन ।\nयत्प्रमाणं यथाचैतद्दातव्यं परमेश्वर ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002891011, "chapter_id": 22891, "verse_number": "९-१७६-१२", "content_sanskrit": "श्रीकृष्ण उवाच ।\nपर्वकाले प्रदातव्यं दानमेतन्महामते ।\nअयने विषुवे चैव ग्रहणे शशिसूर्ययोः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002891012, "chapter_id": 22891, "verse_number": "९-१७६-१३", "content_sanskrit": "व्यतीपातेऽथ कार्तिक्यां जन्मर्क्षे वा नरोत्तम ।\nदुःस्वप्नदर्शने चैव ग्रहपीडासु चैव हि ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002891013, "chapter_id": 22891, "verse_number": "९-१७६-१४", "content_sanskrit": "प्रयागे नैमिषे चैव कुरुक्षेत्रे तथार्बुदे ।\nगंगायां यमुनायां च सिंधुसागरसंगमे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002891014, "chapter_id": 22891, "verse_number": "९-१७६-१५", "content_sanskrit": "पुण्यनद्यश्च दानेस्मिन्प्रशस्ताः स्युर्न संशयः ।\nयत्र वा रोचते राजन्गृहे देवकुलेऽथवा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002891015, "chapter_id": 22891, "verse_number": "९-१७६-१६", "content_sanskrit": "आरामे वा तडागे वा शुचौ देशे विधानतः ।\nतत्र भूशोधनं कुर्यात्प्रागुदक्प्रवणं शुभम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002891016, "chapter_id": 22891, "verse_number": "९-१७६-१७", "content_sanskrit": "हस्ता द्वादश कर्तव्यं मंडपं तु सुशोभनम् ।\nस्तंभैर्मनोहरैर्युक्त्यार्द्रशाखाभिरन्वितम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002891017, "chapter_id": 22891, "verse_number": "९-१७६-१८", "content_sanskrit": "तन्मध्ये वेदिकां कुर्यात्पंचहस्तामलकृताम् ।\nवितानमुपरिष्टाच्च पुष्पमालावलंबितुम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002891018, "chapter_id": 22891, "verse_number": "९-१७६-१९", "content_sanskrit": "हिरण्यगर्भं तन्मध्ये प्रथमेऽहनि कल्पयेत् ।\nतस्य प्रमाणं वक्ष्यामि रूपं वै स्थंडिलोद्भवम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002891019, "chapter_id": 22891, "verse_number": "९-१७६-२०", "content_sanskrit": "शिल्पिनं पूजयेत्पूर्वं वासोभिर्भूषणैस्तथा ।\nब्राह्मणान्वाचयेत्पश्चात्ततः कर्म समारभेत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002891020, "chapter_id": 22891, "verse_number": "९-१७६-२१", "content_sanskrit": "सुवर्णेन संशुद्धेन शक्तितः कारयेद्बुधः ।\nअंगुलानि चतुःषष्टिर्दैर्घ्यं च परिकीर्तितम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002891021, "chapter_id": 22891, "verse_number": "९-१७६-२२", "content_sanskrit": "त्रिभागहीनं वदने मूले तस्यार्द्धविस्तरम् ।\nवर्तुलं कर्णिकाकारं चारुग्रंथिविवर्जितम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002891022, "chapter_id": 22891, "verse_number": "९-१७६-२३", "content_sanskrit": "पिधानमुपरिष्टाच्च कर्तव्यं चांगुलाधिकम् ।\nअस्त्राणि दश कुर्वीत नालं सूर्यं च कांचनम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002891023, "chapter_id": 22891, "verse_number": "९-१७६-२४", "content_sanskrit": "दात्रं सपट्टिकं चैव सर्वोपस्करणान्वितम् ।\nसूचीक्षुरश्च हैमानि तत्सर्वं परिकल्पयेत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002891024, "chapter_id": 22891, "verse_number": "९-१७६-२५", "content_sanskrit": "पार्श्वतः स्थापयेत्तस्य हेमदंडकमंडलू ।\nछत्रिकापादुकायुग्मं वज्रवैडूर्यमंडितम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002891025, "chapter_id": 22891, "verse_number": "९-१७६-२६", "content_sanskrit": "एवं लक्षणसंयुक्तं कृत्वा गर्भं विचक्षणः ।\nब्रह्मघोषेण महता शंखतूर्यरवेण च ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002891026, "chapter_id": 22891, "verse_number": "९-१७६-२७", "content_sanskrit": "हस्तिना शकटेनाथ राजन्ब्रह्मरथेन वा ।\nआनयेन्मंडपं कृत्वा प्रदक्षिणमतंद्रितः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002891027, "chapter_id": 22891, "verse_number": "९-१७६-२८", "content_sanskrit": "तिलद्रोणोपरिगतं वेदीमध्येऽधिवासयेत् ।\nसमालभ्य पुनः सर्वं कुंकुमेन सुगंधिना ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002891028, "chapter_id": 22891, "verse_number": "९-१७६-२९", "content_sanskrit": "कौशेयवाससी शुभ्रे ततस्तं परिधापयेत् ।\nसमंतात्पुष्पमालाभिः पूजयेद्भक्तितः सुधीः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002891029, "chapter_id": 22891, "verse_number": "९-१७६-३०", "content_sanskrit": "धूपैः सुधूपितं कृत्वा मंत्रमेतमुदीरयेत् ।\nभूर्लोकप्रमुखालोकास्तव गर्भे व्यवस्थिताः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002891030, "chapter_id": 22891, "verse_number": "९-१७६-३१", "content_sanskrit": "ब्रह्मादयस्तथा देवा नमस्ते भुवनोद्भव ।\nनमस्ते भुवनाधार नमस्ते भुवनेश्वर ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002891031, "chapter_id": 22891, "verse_number": "९-१७६-३२", "content_sanskrit": "नमो हिरण्यगर्भाय गर्भे यस्य पितामहः ।\nएवं संपूजयित्वा तु तौ रात्रिमधिवासयेत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002891032, "chapter_id": 22891, "verse_number": "९-१७६-३३", "content_sanskrit": "वेद्याश्चतुर्दिशं चैव कुंडानि परिकल्पयेत् ।\nचत्वारि चतुरस्राणि तेषु होमो विधीयते ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002891033, "chapter_id": 22891, "verse_number": "९-१७६-३४", "content_sanskrit": "चतुश्चारणिकास्तत्र ब्राह्मणा मंत्रपारगाः ।\nहोमं कुर्युर्जितात्मानो मौनिनः सर्व एव ते ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002891034, "chapter_id": 22891, "verse_number": "९-१७६-३५", "content_sanskrit": "सर्वाभरणसंपन्नाः सर्वे चाहतवाससः ।\nताम्रपात्रद्वयोपेता गंधपुष्पादिपूजिताः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002891035, "chapter_id": 22891, "verse_number": "९-१७६-३६", "content_sanskrit": "वेद्याः पूर्वोत्तरे भागे ग्रहवेदिं प्रकल्पयेत् ।\nतत्र ग्रहांल्लोकपालान्ब्रह्मविष्णुमहेश्वरान् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002891036, "chapter_id": 22891, "verse_number": "९-१७६-३७", "content_sanskrit": "पूजयेत्स्वर्णघटितान्पुष्पधूपविलेपनैः ।\nपताकाभिरलंकृत्य मंडपं तोरणैस्तथा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002891037, "chapter_id": 22891, "verse_number": "९-१७६-३८", "content_sanskrit": "कुंभद्वयं च द्वारेषु स्थापयेद्रत्नसंयुतम् ।\nतुलापुरुषमंत्रैश्च लोकपालबलिं क्षिपेत् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002891038, "chapter_id": 22891, "verse_number": "९-१७६-३९", "content_sanskrit": "पालाश्यः समिधस्तत्र प्रशस्ता होमकर्मणि ।\nचरुश्चैवेन्द्रदैवत्यस्तिला गव्यं घृतं तथा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002891039, "chapter_id": 22891, "verse_number": "९-१७६-४०", "content_sanskrit": "स्वलिंगैर्होमयेत्पूर्वं मंत्रैर्व्याहृतिभिः पुमान् ।\nअयुते द्वे च होमस्य संख्यामाहुर्मनीषिणः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002891040, "chapter_id": 22891, "verse_number": "९-१७६-४१", "content_sanskrit": "यजमानस्ततः स्नात्वा शुक्लांबरधरः शुचिः ।\nभक्त्या हिरण्यगर्भं च पर्वकाले समर्चयेत् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002891041, "chapter_id": 22891, "verse_number": "९-१७६-४२", "content_sanskrit": "नमो हिरण्यगर्भाय विश्वगर्भाय वै नमः ।\nचराचरस्य जगतो गृहभूताय ते नमः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002891042, "chapter_id": 22891, "verse_number": "९-१७६-४३", "content_sanskrit": "मात्राहं जनितः पूर्व मर्त्यधर्मासुरोत्तम ।\nत्वद्गर्भसंभवादद्य दिव्यदेहो भवाम्यहम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002891043, "chapter_id": 22891, "verse_number": "९-१७६-४४", "content_sanskrit": "इत्युच्चार्य स्वयं भक्त्या कृत्वा चैव प्रदक्षिणाम् ।\nक्षीराज्यदधिसंपूर्णं तद्गर्भं प्रविशेद्बुधः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002891044, "chapter_id": 22891, "verse_number": "९-१७६-४५", "content_sanskrit": "सौवर्णं धर्मराजं तु सव्ये कृत्वा करे ततः ।\nभास्करं दक्षिणे चैव मुष्टिं बद्ध्वा प्रयत्नतः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002891045, "chapter_id": 22891, "verse_number": "९-१७६-४६", "content_sanskrit": "जान्वोरंतरतश्चैव शिरः कृत्वा समाहितः ।\nउच्छ्वासपंचक तिष्ठेच्चेतसा चिंतयञ्छिवम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002891046, "chapter_id": 22891, "verse_number": "९-१७६-४७", "content_sanskrit": "गर्भाधानं पुंसवनं सीमंतोन्नयनं तथा ।\nकुर्युर्हिरण्यगर्भस्य ततस्ते द्विजपुंगवाः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002891047, "chapter_id": 22891, "verse_number": "९-१७६-४८", "content_sanskrit": "जातकर्मादिकाः कुर्युः क्रियाः षोडश चापराः ।\nतत उत्थाय निःसृत्य पुनः कुर्यात्प्रदक्षिणाम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002891048, "chapter_id": 22891, "verse_number": "९-१७६-४९", "content_sanskrit": "तावन्मुखं न पश्येत कस्यचिन्नृपसत्तम ।\nसौवर्णा पृथिवी यावन्न दृष्टा स्पष्टचक्षुषा ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002891049, "chapter_id": 22891, "verse_number": "९-१७६-५०", "content_sanskrit": "ततः स्नानं प्रकुर्वीत ब्रह्मघोषपुरःसरम् ।\nअष्टौ द्विजाः सुवर्णांगा सौवर्णैः कलशैः शुभैः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002891050, "chapter_id": 22891, "verse_number": "९-१७६-५१", "content_sanskrit": "रौप्यैरौदुंबरैर्वापि मृण्मयैर्वा सुशोभनैः ।\nदध्यक्षतविचित्रांगैराम्रपल्लवशोभितैः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002891051, "chapter_id": 22891, "verse_number": "९-१७६-५२", "content_sanskrit": "पुष्पैरावेष्टितग्रीवैरव्रणैः कलशैर्दृढैः ।\nचतुष्कमध्ये संस्थाप्य पीठमव्रणमुत्तमम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002891052, "chapter_id": 22891, "verse_number": "९-१७६-५३", "content_sanskrit": "तत्र स्थाप्य महाभाग यजमानं द्विजोत्तमाः ।\nदेवस्य त्वेति मंत्रेण कुर्युरस्याभिषेचनम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002891053, "chapter_id": 22891, "verse_number": "९-१७६-५४", "content_sanskrit": "अद्य जातस्य तेंऽगानि अभिषेक्ष्यामहे वयम् ।\nदिव्येनानेन वपुषा चिरंजीवमुखी भव ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002891054, "chapter_id": 22891, "verse_number": "९-१७६-५५", "content_sanskrit": "एवं कृताभिषेकस्तु यजमानः समाहितः ।\nदद्याद्धिरण्यगर्भं तं सोदकेनैव पाणिना ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002891055, "chapter_id": 22891, "verse_number": "९-१७६-५६", "content_sanskrit": "तान्संपूज्य च भावेन बहुभ्यो वा तदाज्ञया ।\nयज्ञोपकरणं सर्वं गुरवे विनिवेदयेत् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002891056, "chapter_id": 22891, "verse_number": "९-१७६-५७", "content_sanskrit": "पादुकोपानहौ चैव च्छत्रचामरभाजनम् ।\nअन्येषां चैव विप्राणां ये च तत्र सभासदः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002891057, "chapter_id": 22891, "verse_number": "९-१७६-५८", "content_sanskrit": "तेषां चैव प्रदातव्यं दानं चात्र विशेषतः ।\nदीनांधकृपणानां च दातव्यं सार्वकामिकम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002891058, "chapter_id": 22891, "verse_number": "९-१७६-५९", "content_sanskrit": "अन्नसत्रं च कर्तव्यं यावद्दानपरिग्रहः ।\nअनेन विधिना यस्तु दानमेतत्प्रयच्छति ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002891059, "chapter_id": 22891, "verse_number": "९-१७६-६०", "content_sanskrit": "स कुलं तारयेत्सर्वं देवलोकं स गच्छति ।\nविमानवरमारुह्य पञ्चयोजनविस्तृतम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002891060, "chapter_id": 22891, "verse_number": "९-१७६-६१", "content_sanskrit": "वापीकूपतडागाद्यैर्जलस्थानैरलंकृतम् ।\nउद्यानशतसंस्थानं पद्माकरनिषेवितम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002891061, "chapter_id": 22891, "verse_number": "९-१७६-६२", "content_sanskrit": "प्रासादशतसंकीर्णं वरस्त्रीशतसेवितम् ।\nवीणावेणुमृदंगानां शब्दैरापूरितं महत् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002891062, "chapter_id": 22891, "verse_number": "९-१७६-६३", "content_sanskrit": "भूमयो यत्र राजेन्द्र दिव्या मणिमयाः शुभाः ।\nवेदिकाभिर्विचित्राभिः शोभितं भास्करप्रभम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002891063, "chapter_id": 22891, "verse_number": "९-१७६-६४", "content_sanskrit": "धृतं स्तम्भसहस्रेण सुकृतं विश्वकर्मणा ।\nपताकाभिर्विचित्राभिर्वज्रैश्च समलंकृतम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002891064, "chapter_id": 22891, "verse_number": "९-१७६-६५", "content_sanskrit": "तदारुह्य विमानाग्र्यं विद्याधरगणैर्युतम् ।\nस याति लोकं शक्रस्य शक्रेण सह मोदते ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002891065, "chapter_id": 22891, "verse_number": "९-१७६-६६", "content_sanskrit": "मन्वन्तरशते जाते कर्मभूमौ प्रजायते ।\nजंबूद्वीपमशेषं तु भुंक्ते दिव्यपराक्रमः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7002891066, "chapter_id": 22891, "verse_number": "९-१७६-६७", "content_sanskrit": "धार्मिकः सत्यशीलश्च ब्रह्मण्यो गुरुवत्सलः ।\nदश जन्म्रान्यसौ राजा जायते रोगवर्जितः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7002891067, "chapter_id": 22891, "verse_number": "९-१७६-६८", "content_sanskrit": "यस्त्विदं शृणुयाद्भक्त्या रहस्यं पापनाशनम् ।\nसोऽपि वर्षशतं साग्रं सुरलोके महीयते ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7002891068, "chapter_id": 22891, "verse_number": "९-१७६-६९", "content_sanskrit": "गर्भं हिरण्यरचितं विधिवत्प्रविश्य संस्कारसंस्कृततनुः पुनरेव तस्मात् ।\nनिःसृत्य तद्द्विजवराय निवेद्य भक्त्या मार्तण्डवद्दिवि विराजति दिव्यदेहः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]