[{"id": 7006194000, "chapter_id": 26194, "verse_number": "२-२२-१", "content_sanskrit": "वसिष्ठ उवाच इत्येवमुक्तो भृगुणा तथेत्युक्त्वा प्रणम्य च ।\nरामस्तेनाभ्यनुज्ञातश्चकार गमने मनः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006194001, "chapter_id": 26194, "verse_number": "२-२२-२", "content_sanskrit": "भृगुं ख्यातिं च विधिवत्परिक्रम्य प्रणम्यच ।\nपरिष्वक्तस्तथा ताभ्यामाशीर्भिराभिनन्दितः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006194002, "chapter_id": 26194, "verse_number": "२-२२-३", "content_sanskrit": "मुनींश्च तान्नमस्कृत्य तैः सर्वैरनुमोदितः ।\nनिश्चक्रमाश्रमात्तस्मात्तपसे कृतनिश्चयः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006194003, "chapter_id": 26194, "verse_number": "२-२२-४", "content_sanskrit": "ततो गुरुनियोगेन तदुक्तेनैव वर्त्मना ।\nहिमवन्तं गिरिवरं ययौ रामो महामनाः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006194004, "chapter_id": 26194, "verse_number": "२-२२-५", "content_sanskrit": "सोऽतीत्य विविधान्देशान्पर्वतान्सरितस्तथा ।\nवनानि मुनिमुख्यानामावासांश्चात्यगाच्छनैः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006194005, "chapter_id": 26194, "verse_number": "२-२२-६", "content_sanskrit": "तत्रतत्र निवासेषु मुनीनां निवसन्पथि ।\nतीर्थेषु क्षेत्रमुख्येषु निवसन्वा ययौ शनैः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006194006, "chapter_id": 26194, "verse_number": "२-२२-७", "content_sanskrit": "अतीत्य सुबहून्देशान्पश्यन्नपि मनोरमान् ।\nआससादच लश्रेष्ठं हिमवन्तमनुत्तमम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006194007, "chapter_id": 26194, "verse_number": "२-२२-८", "content_sanskrit": "स गत्वा पर्वतवरं नानाद्रुमलतास्थितम् ।\nददर्श विपुलैः शृङ्गैरुल्लिखन्तमिवांबरम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006194008, "chapter_id": 26194, "verse_number": "२-२२-९", "content_sanskrit": "नानाधातुविचित्रैश्च प्रदेशैरुपशोभितम् ।\nरत्नौषधीभिरभितः स्फुरद्भिरभिशोभितम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006194009, "chapter_id": 26194, "verse_number": "२-२२-१०", "content_sanskrit": "मरुत्संघट्टनाघृष्टनीरसांघ्रिपजन्मना ।\nसानिलेनानलेनोच्छैर्दह्यमानं नवं क्वचित् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006194010, "chapter_id": 26194, "verse_number": "२-२२-११", "content_sanskrit": "क्वचिद्रविकरामर्शज्वलदर्केपलाग्निभिः ।\nद्रवद्धिमाशिलाजातुजलशान्तदवानलम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006194011, "chapter_id": 26194, "verse_number": "२-२२-१२", "content_sanskrit": "स्फटिकाञ्जनदुर्वर्णस्वर्णराशिप्रभाकरैः ।\nस्फुरत्परस्परच्छायाशरैर्द्दीप्तवनं क्वचित् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006194012, "chapter_id": 26194, "verse_number": "२-२२-१३", "content_sanskrit": "उपत्यकशिलापृष्ठवालातपनिषेविभिः ।\nतुषारक्लिन्नसिद्धौघौरुद्भासितवनं क्वचित् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006194013, "chapter_id": 26194, "verse_number": "२-२२-१४", "content_sanskrit": "क्वचिदर्काशुसंभिन्नश्चामीकरशिलाश्रितैः ।\nयक्षौघैर्भासितोपान्तं विशद्भिरिवपावकम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006194014, "chapter_id": 26194, "verse_number": "२-२२-१५", "content_sanskrit": "दरीमुखविनिष्क्रान्ततरक्षूत्पतनाकुलैः ।\nमृगयूथार्त्तसन्नादैरापूरितगुहं क्वचित् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006194015, "chapter_id": 26194, "verse_number": "२-२२-१६", "content_sanskrit": "युद्ध्यद्वराहशार्दूलयूथपैरित स्तेरम् ।\nप्रसभोन्मृष्टकान्तोरुशिलातरुतटं क्वचित् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006194016, "chapter_id": 26194, "verse_number": "२-२२-१७", "content_sanskrit": "कलभोन्मेषणाकृष्टकरिणीभिरनुद्रुतैः ।\nगवयैः खुरसंक्षुण्णशिलाप्रस्थतटङ्क्वचित् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006194017, "chapter_id": 26194, "verse_number": "२-२२-१८", "content_sanskrit": "वासितर्थेऽभिसंवृद्धमदोन्मत्तमतङ्गजैः ।\nयुद्ध्यद्भिश्चूर्णितानेकगण्डशैलवनं क्वचित् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006194018, "chapter_id": 26194, "verse_number": "२-२२-१९", "content_sanskrit": "बृंहितश्रवणामर्षान्मातं गानभिधावताम् ।\nसिंहानां चरणक्षुण्णनखभिन्नोपरं क्वचित् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006194019, "chapter_id": 26194, "verse_number": "२-२२-२०", "content_sanskrit": "सहसा निपतत्सिंहनखनिर्भिन्नमस्तकैः ।\nगजैराक्रन्दनादेन पूर्यमामं वनं क्वचित् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006194020, "chapter_id": 26194, "verse_number": "२-२२-२१", "content_sanskrit": "अष्टपादबलाकृष्टकेसरा दारुणाखैः ।\nभेद्यमानाखिलशिलागंभीरकुहरं क्वचित् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006194021, "chapter_id": 26194, "verse_number": "२-२२-२२", "content_sanskrit": "संरब्धा नेकशबरप्रसक्तैरृयूथपैः ।\nइतरेतरसंमर्दं विप्रभग्नदृषत्क्वचित् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006194022, "chapter_id": 26194, "verse_number": "२-२२-२३", "content_sanskrit": "गिरिकुञ्जेषु संक्रीडत्करिणीमद्विपं क्वचित् ।\nकरेणुमाद्रवन्मत्तगजाकलितकाननम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006194023, "chapter_id": 26194, "verse_number": "२-२२-२४", "content_sanskrit": "स्वपत्सिंहमुखश्वासमरुत्पुर्मदरीशतम् ।\nगहनेषु गुरुत्राससाशङ्कविहरन्मृगम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006194024, "chapter_id": 26194, "verse_number": "२-२२-२५", "content_sanskrit": "कण्टाकश्लिष्टलाङ्गूललोमत्रुटनकातरैः ।\nक्रीडितं चमरीयूथैर्मन्दमन्दविचारिभिः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006194025, "chapter_id": 26194, "verse_number": "२-२२-२६", "content_sanskrit": "गिरिकन्दरसंसक्तकिन्नरीसमुदीरितैः ।\nसतालनादैरुदिनैर्भृताशेषदिशामुखम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006194026, "chapter_id": 26194, "verse_number": "२-२२-२७", "content_sanskrit": "अरण्यदेवतानां च चरेतीनामितस्ततः ।\nअलक्तकरसक्लिन्नचरणाङ्कितभूतलम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006194027, "chapter_id": 26194, "verse_number": "२-२२-२८", "content_sanskrit": "मयूरकेकिरीवृन्दैः संगीत मधुरस्वरैः ।\nप्रवृत्तनृत्तं परितो विततोदग्रबर्हिभिः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006194028, "chapter_id": 26194, "verse_number": "२-२२-२९", "content_sanskrit": "जलस्थलरुहानेककुसुमोत्करवर्षिभिः ।\nगात्राह्लादकरैर्मन्दं वीज्यमानं वनानिलैः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006194029, "chapter_id": 26194, "verse_number": "२-२२-३०", "content_sanskrit": "भूतार्त्तवरसास्वादमाद्यत्पुंस्कोकिलारवैः ।\nआकुलीकृतपर्यन्तसहकारवनान्तरम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006194030, "chapter_id": 26194, "verse_number": "२-२२-३१", "content_sanskrit": "नानापुष्पासवोन्माद्यद्भृङ्गसंगीतनादितम् ।\nअनेकविहगारावबधिरीकृतकाननम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006194031, "chapter_id": 26194, "verse_number": "२-२२-३२", "content_sanskrit": "मधुद्रवार्द्राविरलप्रत्यग्रकुसुमोत्करैः ।\nवनान्तमारुताकीर्णैरलङ्कृतमहीतलम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006194032, "chapter_id": 26194, "verse_number": "२-२२-३३", "content_sanskrit": "उपरिष्टान्निपततां विषमोपलसंकटे ।\nनिर्झराणां महारावैः समन्ताद्बधिरीकृतम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006194033, "chapter_id": 26194, "verse_number": "२-२२-३४", "content_sanskrit": "विततानेकसंसक्तशाखाग्राविरलच्छदैः ।\nपाटलैर्विटपच्छायैरुपशल्यसमुत्थितैः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006194034, "chapter_id": 26194, "verse_number": "२-२२-३५", "content_sanskrit": "कदंबनिंबहिन्तालसर्जबेधूकतिन्दुकैः ।\nकपित्थपनसाशोकसहकारेगुदाशनैः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006194035, "chapter_id": 26194, "verse_number": "२-२२-३६", "content_sanskrit": "नागचंपकपुन्नागकोविदारप्रियङ्गुभिः ।\nप्रियालनीपबकुलबन्धूकाक्षतमालकैः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006194036, "chapter_id": 26194, "verse_number": "२-२२-३७", "content_sanskrit": "द्राक्षामधूकामलकजंबूकङ्कोलजातिभिः ।\nबिल्वार्जुनकरञ्जाम्रबीजपूराङ्घ्रिपैरपि ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006194037, "chapter_id": 26194, "verse_number": "२-२२-३८", "content_sanskrit": "पिचुलांबष्ठकनकवैकङ्कतशमीधवैः ।\nपुत्रजीवाभयारिष्टलोहोदुंबरपिप्पलैः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006194038, "chapter_id": 26194, "verse_number": "२-२२-३९", "content_sanskrit": "अन्यैश्च विविधैर्वृक्षैः समन्तादुपशोभितम् ।\nनिरन्तरतरुच्छायासुदूरविनिवारितैः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006194039, "chapter_id": 26194, "verse_number": "२-२२-४०", "content_sanskrit": "समन्तादर्ककिरणैरनासादितभूतलम् ।\nनानापक्वफलास्वादबलपुष्टैः प्लवेगमैः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006194040, "chapter_id": 26194, "verse_number": "२-२२-४१", "content_sanskrit": "आक्रान्तचकितानेकवनपङ्क्तिशताकुलम् ।\nतत्र तत्रातिरम्यैश्च शिलाकुहरनिर्गतैः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006194041, "chapter_id": 26194, "verse_number": "२-२२-४२", "content_sanskrit": "प्रतापविषमैराजन्ह्रास्यमानं सरिच्छतैः ।\nसारोवरैश्च विपुलैः कुमुदोत्पलमण्डितैः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006194042, "chapter_id": 26194, "verse_number": "२-२२-४३", "content_sanskrit": "नानाविहगसंघुष्टैः समन्तादुपशोभितम् ।\nसमासाद्यथ शैलेन्द्रं तुषारशिशिरं गिरिम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006194043, "chapter_id": 26194, "verse_number": "२-२२-४४", "content_sanskrit": "आरुरोह भगुश्रेष्ठस्तरसा तं मुदान्वितः ।\nतस्य प्रविश्य गहनं वनं रामो महामनाः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006194044, "chapter_id": 26194, "verse_number": "२-२२-४५", "content_sanskrit": "विचचार शनै राजन्नुपशल्यमहीरुहम् ।\nस तत्र विचरन्दिक्षु हरिणीभिः समन्ततः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006194045, "chapter_id": 26194, "verse_number": "२-२२-४६", "content_sanskrit": "विक्ष्यमाणो मुदं लेभे साशङ्कं मुग्धदृष्टिभिः ।\nस तत्र कुसुमामोदगन्धिभिर्वनवायुभिः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006194046, "chapter_id": 26194, "verse_number": "२-२२-४७", "content_sanskrit": "वीज्यमानो जहर्षे स वीक्ष्योदारां वनश्रियम् ।\nविविधाश्च स्थरीः सूक्ष्ममुपरिक्रम्य भार्गवः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006194047, "chapter_id": 26194, "verse_number": "२-२२-४८", "content_sanskrit": "द्वन्द्वांश्च धातून्विविधान्पश्यन्नेवमतर्कयत् ।\nअहोऽयं सर्वशैलानामाधिपत्येऽभिषेचितः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006194048, "chapter_id": 26194, "verse_number": "२-२२-४९", "content_sanskrit": "ब्रह्मणा यज्ञभाक्चैव स्थाने संप्रतिपादितः ।\nअस्य शैलाधिराजत्वं सुव्यक्तमभिलक्ष्यते ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006194049, "chapter_id": 26194, "verse_number": "२-२२-५०", "content_sanskrit": "रवैः कीचकवेणुनां मधुरीकृतकाननः ।\nनितंबस्थलसंसक्ततुषारनिचयैग्यम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006194050, "chapter_id": 26194, "verse_number": "२-२२-५१", "content_sanskrit": "विभातीवाहितस्वच्छपरीतधवलांशुकः ।\nनिबिडश्रितनीहारनिकरेण तथोपरि ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006194051, "chapter_id": 26194, "verse_number": "२-२२-५२", "content_sanskrit": "नानावर्णोत्तरासंगावृत्ताङ्ग इवल्क्ष्यते ।\nचन्दनागुरुकर्पूरकस्तूरीकुङ्कुमादिभिः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006194052, "chapter_id": 26194, "verse_number": "२-२२-५३", "content_sanskrit": "अलङ्कृतागः सुव्यक्तं दृश्यतेऽही विलासिवत् ।\nमृगेन्द्राहतदन्तीन्द्रकुंभस्थलपरिच्युतैः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006194053, "chapter_id": 26194, "verse_number": "२-२२-५४", "content_sanskrit": "स्थूलमुक्तोत्करैरेष विभाति परितो गिरिः ।\nनानावृक्षलतावल्लीपुष्पालङ्कृतमूर्द्धजः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006194054, "chapter_id": 26194, "verse_number": "२-२२-५५", "content_sanskrit": "नीरन्ध्राञ्चितमे घौघवितानसमलङ्कृतः ।\nनानाधातुविचित्राङ्गः सर्वरत्नविभूषितः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006194055, "chapter_id": 26194, "verse_number": "२-२२-५६", "content_sanskrit": "कैलासव्याजविलसत्सितच्छत्रविराजितः ।\nगजाश्वमुखयूथैश्च समन्तात्परिवारितः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006194056, "chapter_id": 26194, "verse_number": "२-२२-५७", "content_sanskrit": "रत्नद्वीपमहाद्वारशिलाकन्दरमन्दिरः ।\nविविक्तगह्वरास्थानमध्यसिंहासनाश्रयः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006194057, "chapter_id": 26194, "verse_number": "२-२२-५८", "content_sanskrit": "समन्तात्प्रतिसंसक्ततरुवेत्रवतां शनैः ।\nदृष्ट्वा जनैरनासाद्यो महाराजाधिराजवत् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006194058, "chapter_id": 26194, "verse_number": "२-२२-५९", "content_sanskrit": "दोधूयमानो विचरच्चमरीचा रुचामरैः ।\nमयूरैरुपनृत्यद्भिर्गायद्भिश्चैव किन्नरैः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006194059, "chapter_id": 26194, "verse_number": "२-२२-६०", "content_sanskrit": "सत्त्वजातैरनेकैश्च सेव्यमानो विराजते ।\nव्यक्तमेवाचलेन्द्राणामधिराज्यपदे स्थितः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006194060, "chapter_id": 26194, "verse_number": "२-२२-६१", "content_sanskrit": "भुनक्त्याक्रम्य वसुधां समग्रां श्रियमोजसा ।\nएवं संचिन्तयानः स हिमाद्रिवनगह्वरे ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006194061, "chapter_id": 26194, "verse_number": "२-२२-६२", "content_sanskrit": "विचचार चिरं रामो मुदा परमया युतः ।\nआससाद वने तस्मिन्विपुले भृगुपुङ्गवः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006194062, "chapter_id": 26194, "verse_number": "२-२२-६३", "content_sanskrit": "सरोवरं महाराज विपुलं विमलोदकम् ।\nकुमुदोत्पलकह्लारनिकरैरुपसोभितम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006194063, "chapter_id": 26194, "verse_number": "२-२२-६४", "content_sanskrit": "पङ्कजैरुत्पलैश्चैव रक्तपीतैः सितासितैः ।\nअन्यैश्च जलचैर्वक्षैः सर्वतः समलङ्कृतम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006194064, "chapter_id": 26194, "verse_number": "२-२२-६५", "content_sanskrit": "हंससारसदात्यूहकारण्डवशतैरपि ।\nजीवजीवकचक्राह्वकुररभ्रमरोत्करैः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006194065, "chapter_id": 26194, "verse_number": "२-२२-६६", "content_sanskrit": "संघुष्यमाणं परितः सेवितं मन्दवायुना ।\nशफरीमत्स्यसंघैश्च विचरद्भिरितस्ततः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006194066, "chapter_id": 26194, "verse_number": "२-२२-६७", "content_sanskrit": "अन्तर्जनितकल्लोलैर्नृत्यमानमिवाभितः ।\nआससाद भृगुश्रेष्ठस्तत्सरोवरमुत्तमम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006194067, "chapter_id": 26194, "verse_number": "२-२२-६८", "content_sanskrit": "नानापतत्र्रिविरुतैर्मधुरीकृतदिक्तटम् ।\nस तस्य तीरे विपुलं कृत्वाश्रमपदं शुभम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006194068, "chapter_id": 26194, "verse_number": "२-२२-६९", "content_sanskrit": "रामो मतिमतां श्रेष्ठस्तपसे च मनो दधे ।\nशाकमूलफलाहारो नियतं नियतेन्द्रियः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006194069, "chapter_id": 26194, "verse_number": "२-२२-७०", "content_sanskrit": "तपश्चचार देवेशं विनिवेश्यात्ममानसे ।\nभृगूपदिष्टमार्गेण भक्त्या परमया युतः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006194070, "chapter_id": 26194, "verse_number": "२-२२-७१", "content_sanskrit": "पूजयामास देवेशमेकाग्रमनसा नृप ।\nअनिकेतः स वर्षासु शिशिरे जलसंश्रयः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006194071, "chapter_id": 26194, "verse_number": "२-२२-७२", "content_sanskrit": "ग्रीष्मे पञ्जाग्निमध्यस्थश्चचारैवं तपश्चिरम् ।\nरिपून्निर्जित्य कामादीनूर्मिषषट्कं विधूय च ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006194072, "chapter_id": 26194, "verse_number": "२-२२-७३", "content_sanskrit": "द्वन्द्वैरनुद्वेजितधीस्तापदोषैरनाकुलः ।\nयमैः सनियमैश्चैव शुद्धदेहः समाहितः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006194073, "chapter_id": 26194, "verse_number": "२-२२-७४", "content_sanskrit": "वशी चकार पवनं प्राणायामेन देहगम् ।\nजितपद्मासनो मौनी स्थिरचित्तो महामुनिः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006194074, "chapter_id": 26194, "verse_number": "२-२२-७५", "content_sanskrit": "वशी चकार चाक्षाणि प्रत्याहारपरायणः ।\nधारणाभिः स्थिरीचक्रे मनश्चञ्चलमात्मवान् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006194075, "chapter_id": 26194, "verse_number": "२-२२-७६", "content_sanskrit": "ध्यानेन देवदेवेशं ददर्श परमेश्वरम् ।\nस्वस्थान्तः करणो मैत्रः सर्वबाधाविवर्जितः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006194076, "chapter_id": 26194, "verse_number": "२-२२-७७", "content_sanskrit": "चिन्तयामास देवेशं ध्याने दृष्ट्वा जगद्गुरुम् ।\nध्येयावस्थि तचित्तात्मा निश्चलेद्रियदेहवान् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006194077, "chapter_id": 26194, "verse_number": "२-२२-७८", "content_sanskrit": "आकालावधि सोऽतिष्ठन्निवातस्थप्रदीपवत् ।\nजपंश्च देवदेवेशं ध्यायंश्च स्वमनीषया ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006194078, "chapter_id": 26194, "verse_number": "२-२२-७९", "content_sanskrit": "आराधयदमेयात्मा सर्वभावस्थमीश्वरम् ।\nततः स निष्फलं रूपमैश्वरं यन्निरञ्जनम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006194079, "chapter_id": 26194, "verse_number": "२-२२-८०", "content_sanskrit": "परं ज्योतिरचिन्त्यं यद्योगिध्येयमनुत्त मम् ।\nनित्यं शुद्धं सदा शान्तमतीन्द्रियमनौपमम् ।\nआनन्दमात्रमचलं व्याप्ताशेषचराचरम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006194080, "chapter_id": 26194, "verse_number": "२-२२-८१", "content_sanskrit": "चिन्तयामास तद्रूपं देवदेवस्य भार्गवः ।\nनित्यं शुद्धं सदा शान्तमतीन्द्रियमनौपमम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}]