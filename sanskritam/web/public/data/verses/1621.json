[{"id": 2028585, "chapter_id": 1621, "verse_number": "३-२५९-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2028586, "chapter_id": 1621, "verse_number": "३-२५९-१", "content_sanskrit": "दुर्योधनं मोक्षयित्वा पाण्डुपुत्रा महाबलाः।\nकिमकार्षुर्वने तस्मिंस्तन्ममाख्यातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2028587, "chapter_id": 1621, "verse_number": "३-२५९-२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2028588, "chapter_id": 1621, "verse_number": "३-२५९-२", "content_sanskrit": "ततः शयानं कौन्तेयं रात्रौ द्वैतवन मृगाः।\nस्वप्नान्ते दर्शयामासुर्बाष्पकण्ठा युधिष्ठिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2028589, "chapter_id": 1621, "verse_number": "३-२५९-३", "content_sanskrit": "तानब्रवीत्स राजेन्द्रो वेपमानान्कृताञ्जलीन्।\nब्रूत यद्वक्तुकामाः स्थ के भवन्तः किमिष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2028590, "chapter_id": 1621, "verse_number": "३-२५९-४", "content_sanskrit": "एवमुक्ताः पाण्डवेन कौन्तेयेन यशस्विना।\nप्रत्यब्रुवन्मृगास्तत्रहतशेषा युधिष्ठिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2028591, "chapter_id": 1621, "verse_number": "३-२५९-५", "content_sanskrit": "वयं मृगा द्वैतवने हतशिष्टास्तु भारत।\nनोत्सीदेम महाराज क्रियतां वासपर्ययः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2028592, "chapter_id": 1621, "verse_number": "३-२५९-६", "content_sanskrit": "भवन्तो भ्रातरः शूराः सर्व एवास्त्रकोविदाः।\nकुलान्यल्पावशिष्टानि कृतवन्तो वनौकसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2028593, "chapter_id": 1621, "verse_number": "३-२५९-७", "content_sanskrit": "बीजभूता वयं केचिदवशिष्टा महामते।\nविवर्धेमहि राजेन्द्र प्रसादात्ते युधिष्ठिर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2028594, "chapter_id": 1621, "verse_number": "३-२५९-८", "content_sanskrit": "तान्वेपमानान्वित्रस्तान्बीजमात्रावशेषितान्।\nमृगान्दृष्ट्वा सुदुःखार्तो धर्मराजो युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2028595, "chapter_id": 1621, "verse_number": "३-२५९-९", "content_sanskrit": "तांस्तथेत्यब्रवीद्राजा सर्वभूतहिते रतः।\nयथा भवन्तो ब्रुवते करिष्यामि च तत्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2028596, "chapter_id": 1621, "verse_number": "३-२५९-१०", "content_sanskrit": "इत्येवं प्रतिबुद्धः स रात्र्यन्ते राजसत्तमः।\nअब्रवीत्सहितान्भ्रातॄन्दयापन्नो मृगान्प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2028597, "chapter_id": 1621, "verse_number": "३-२५९-११", "content_sanskrit": "उक्तो रात्रौ मृगैरस्मि स्वप्नान्ते हतशेषितैः।\nतनुभूताः स्म भद्रं ते दया नः क्रियतामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2028598, "chapter_id": 1621, "verse_number": "३-२५९-१२", "content_sanskrit": "ते सत्यमाहुः कर्तव्या दयाऽस्माभिर्वनौकसाम्।\nसाष्टमासं हि नो वर्षं यदेनानुपयुंक्ष्महे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2028599, "chapter_id": 1621, "verse_number": "३-२५९-१३", "content_sanskrit": "पुनर्वहुमृगं रम्यं काम्यकं काननोत्तमम्।\nतत्रेमां वसतिं शिष्टां विहरन्तो रमेमहि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2028600, "chapter_id": 1621, "verse_number": "३-२५९-१४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2028601, "chapter_id": 1621, "verse_number": "३-२५९-१४", "content_sanskrit": "ततस्ते पाण्डवाः शीघ्रं प्रययुर्धर्मकोविदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2028602, "chapter_id": 1621, "verse_number": "३-२५९-१५", "content_sanskrit": "ब्राह्मणैः सहिता राजन्ये च तत्रसहोषिताः।\nइन्द्रसेनादिभिश्चैव प्रेष्यैरनुगतास्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2028603, "chapter_id": 1621, "verse_number": "३-२५९-१६", "content_sanskrit": "ते यात्वा सुसुखैर्मार्गैः स्वन्नैः शुचिजलान्वितैः।\nददृशुः काम्यकं पुण्यमाश्रमं तापसान्वितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2028604, "chapter_id": 1621, "verse_number": "३-२५९-१७", "content_sanskrit": "विविशुस्ते स्म कौरव्या वृता विप्रर्षभैस्तदा।\nतद्वनं भरतश्रेष्ठाः स्वर्गं सुकृतिनो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2028605, "chapter_id": 1621, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि मृगस्वप्नोद्भवपर्वणि एकोनषष्ट्यधिकद्विशततमोऽध्यायः ॥ २५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]