[{"id": 7000391000, "chapter_id": 20391, "verse_number": "२-६३-१", "content_sanskrit": "सुकर्मोवाच ।\nतयोश्चापि द्विजश्रेष्ठ मातापित्रोश्च स्नातयोः ।\nपुत्रस्यापि हि सर्वांगे पतंत्यंबुकणा यदा॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000391001, "chapter_id": 20391, "verse_number": "२-६३-२", "content_sanskrit": "सर्वतीर्थसमं स्नानं पुत्रस्यापि सुजायते ।\nपतितं विकलं वृद्धमशक्तं सर्वकर्मसु॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000391002, "chapter_id": 20391, "verse_number": "२-६३-३", "content_sanskrit": "व्याधितं कुष्ठिनं तातं मातरं च तथाविधाम् ।\nउपाचरति यः पुत्रस्तस्य पुण्यं वदाम्यहम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000391003, "chapter_id": 20391, "verse_number": "२-६३-४", "content_sanskrit": "विष्णुस्तस्य प्रसन्नात्मा जायते नात्र संशयः ।\nप्रयाति वैष्णवं लोकं यदप्राप्यं हि योगिभिः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000391004, "chapter_id": 20391, "verse_number": "२-६३-५", "content_sanskrit": "पितरौ विकलौ दीनौ वृद्धावेतौ गुरू सुतः ।\nमहागदेन संप्राप्तौ परित्यजति पापधीः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000391005, "chapter_id": 20391, "verse_number": "२-६३-६", "content_sanskrit": "पुत्रो नरकमाप्नोति दारुणं कृमिसंकुलम् ।\nवृद्धाभ्यां च समाहूतो गुरूभ्यामिह सांप्रतम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000391006, "chapter_id": 20391, "verse_number": "२-६३-७", "content_sanskrit": "न प्रयाति सुतो भूत्वा तस्य पापं वदाम्यहम् ।\nविष्ठाशी जायते मूढो ग्रामघ्रोणी न संशयः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000391007, "chapter_id": 20391, "verse_number": "२-६३-८", "content_sanskrit": "यावज्जन्मसहस्रं तु पुनः श्वा चाभिजायते ।\nपुत्रगेहेस्थितौ वृद्धौ माता च जनकस्तथा॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000391008, "chapter_id": 20391, "verse_number": "२-६३-९", "content_sanskrit": "अभोजयित्वा तावन्नं स्वयमत्ति च यः सुतः ।\nमूत्रं विष्ठां स भुंजीत यावज्जन्मसहस्रकम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000391009, "chapter_id": 20391, "verse_number": "२-६३-१०", "content_sanskrit": "कृष्णसर्पो भवेत्पापी यावज्जन्मशतद्वयम् ।\nमातरंपितरं वृद्धमवज्ञाय प्रवर्त्तते॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000391010, "chapter_id": 20391, "verse_number": "२-६३-११", "content_sanskrit": "ग्राहोपि जायते दुष्टो जन्मकोटिशतैरपि ।\nतावेतौ कुत्सते पुत्रः कटुकैर्वचनैरपि॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000391011, "chapter_id": 20391, "verse_number": "२-६३-१२", "content_sanskrit": "स च पापी भवेद्व्याघ्रः पश्चादृक्षः प्रजायते ।\nमातरंपितरं पुत्रो यो न मन्येत दुष्टधीः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000391012, "chapter_id": 20391, "verse_number": "२-६३-१३", "content_sanskrit": "कुंभीपाके वसेत्तावद्यावद्युगसहस्रकम् ।\nनास्ति मातृसमं तीर्थं पुत्राणां च पितुः समम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000391013, "chapter_id": 20391, "verse_number": "२-६३-१४", "content_sanskrit": "तारणाय हितायैव इहैव च परत्र च ।\nतस्मादहं महाप्राज्ञ पितृदेवं प्रपूजये॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000391014, "chapter_id": 20391, "verse_number": "२-६३-१५", "content_sanskrit": "मातृदेवं सर्वदेव योगयोगी तथाभवम् ।\nमातृपितृप्रसादेन संजातं ज्ञानमुत्तमम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000391015, "chapter_id": 20391, "verse_number": "२-६३-१६", "content_sanskrit": "त्रिलोकीयं समस्ता तु संयाता मम वश्यताम् ।\nअर्वाचीनगतिं जाने देवस्यास्य महात्मनः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000391016, "chapter_id": 20391, "verse_number": "२-६३-१७", "content_sanskrit": "वासुदेवस्य तस्यैव पराचीनां महामते ।\nसर्वं ज्ञानं समुद्भूतं पितृमातृप्रसादतः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000391017, "chapter_id": 20391, "verse_number": "२-६३-१८", "content_sanskrit": "को न पूजयते विद्वान्पितरं मातरं तथा ।\nसांगोपांगैरधीतैस्तैः श्रुतिशास्त्रसमन्वितैः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000391018, "chapter_id": 20391, "verse_number": "२-६३-१९", "content_sanskrit": "वेदैरपि च किं विप्रा पिता येन न पूजितः ।\nमाता न पूजिता येन तस्य वेदा निरर्थकाः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000391019, "chapter_id": 20391, "verse_number": "२-६३-२०", "content_sanskrit": "यज्ञैश्च तपसा विप्र किं दानैः किं च पूजनैः ।\nप्रयाति तस्य वैफल्यं न माता येन पूजिता॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000391020, "chapter_id": 20391, "verse_number": "२-६३-२१", "content_sanskrit": "न पिता पूजितो येन जीवमानो गृहे स्थितः ।\nएष पुत्रस्य वै धर्मस्तथा तीर्थं नरेष्विह॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000391021, "chapter_id": 20391, "verse_number": "२-६३-२२", "content_sanskrit": "एष पुत्रस्य वै मोक्षस्तथा जन्मफलं शुभम् ।\nएष पुत्रस्य वै यज्ञो दानमेव न संशयः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000391022, "chapter_id": 20391, "verse_number": "२-६३-२३", "content_sanskrit": "पितरं पूजयेन्नित्यं भक्त्या भावेन तत्परः ।\nतस्य जातं समस्तं तद्यदुक्तं पूर्वमेव हि॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000391023, "chapter_id": 20391, "verse_number": "२-६३-२४", "content_sanskrit": "दानस्यापि फलं तेन तीर्थस्यापि न संशयः ।\nयज्ञस्यापि फलं प्राप्तं माता येनाप्युपासिता॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000391024, "chapter_id": 20391, "verse_number": "२-६३-२५", "content_sanskrit": "पिता येन सुभक्त्या च नित्यमेवाप्युपासितः ।\nतस्य सर्वा सुसंसिद्धा यज्ञाद्याः पुण्यदाः क्रियाः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000391025, "chapter_id": 20391, "verse_number": "२-६३-२६", "content_sanskrit": "एतदर्थं समाज्ञातं धर्मशास्त्रं श्रुतं मया ।\nपितृभक्तिपरो नित्यं भवेत्पुत्रो हि पिप्पल॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000391026, "chapter_id": 20391, "verse_number": "२-६३-२७", "content_sanskrit": "तुष्टे पितरि संप्राप्तं यदुराज्ञा पुरा सुखम् ।\nरुष्टे पितरि च प्राप्तं महत्पापं पुरा शृणु॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000391027, "chapter_id": 20391, "verse_number": "२-६३-२८", "content_sanskrit": "रुरुणा पौरवेणापि पित्रा शप्तेन भूतले ।\nएवं ज्ञानं मया चाप्तं द्वावेतौ यदुपासितौ॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000391028, "chapter_id": 20391, "verse_number": "२-६३-२९", "content_sanskrit": "एतयोश्च प्रसादेन प्राप्तं फलमनुत्तमम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]