[{"id": 2109307, "chapter_id": 3373, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2109308, "chapter_id": 3373, "verse_number": "१", "content_sanskrit": "इदमत्यद्भुतं चान्यदस्तीकस्याथ शुश्रुमः ।\nतथा वरैश्छन्द्यमानो राज्ञा पारीक्षितेन ह \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2109309, "chapter_id": 3373, "verse_number": "२", "content_sanskrit": "इन्द्रहस्ताच्च्युतो नागः स ख एव व्यवस्थितः ।\nततश्चिन्तापरो राजा बभूव जनमेजयः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2109310, "chapter_id": 3373, "verse_number": "३", "content_sanskrit": "हूयमाने भृशं दीप्ते विधिवत् पावके तदा ।\nन सम्प्रापत् तदा वह्नौ तक्षको भयपीडितः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2109311, "chapter_id": 3373, "verse_number": "", "content_sanskrit": "शौनकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2109312, "chapter_id": 3373, "verse_number": "४", "content_sanskrit": "किं सूत तेषां विप्राणां मन्त्रग्रामो महात्मनाम् ।\nन प्रत्यभाद् हुतेऽग्नौ यन्न पपात स तक्षकः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2109313, "chapter_id": 3373, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2109314, "chapter_id": 3373, "verse_number": "५", "content_sanskrit": "तमिन्द्रहस्ताद् विस्रस्तं विपत्स्थं पन्नगोत्तमम् ।\nअस्तीकस्तिष्ठतिष्ठेति वाचस्तिस्रोऽभ्युवाच ह \t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2109315, "chapter_id": 3373, "verse_number": "६", "content_sanskrit": "वितस्थे सोऽन्तरिक्षेऽथ हृदयेन विदूयता ।\nयथा तिष्ठेति वाचोक्तस्तथा तस्थौ नभोऽन्तरे \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2109316, "chapter_id": 3373, "verse_number": "७", "content_sanskrit": "ततो राजाऽब्रवीद् वाक्यं सदस्यैश्चोदितो भृशम् ।\nकाममेवं भवत्वेतद् यथाऽस्तीकस्य भाषितम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2109317, "chapter_id": 3373, "verse_number": "८", "content_sanskrit": "समाप्यतामिदं कर्म पन्नगाः सन्त्वनामयाः ।\nप्रीयतामयमस्तीकः सत्यं मम वचोऽस्तु तत् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2109318, "chapter_id": 3373, "verse_number": "९", "content_sanskrit": "ततो हलहलाशब्दः प्रीतिजः समवर्धत ।\nअस्तीकस्य वरे दत्ते तथैव विरराम च \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2109319, "chapter_id": 3373, "verse_number": "१०", "content_sanskrit": "स यज्ञः पाण्डवेयस्य राज्ञः पारीक्षितस्य ह ।\nप्रीतिमानभवद्राजा भारतो जनमेजयः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2109320, "chapter_id": 3373, "verse_number": "११", "content_sanskrit": "ऋत्विग्भ्यः स सदस्येभ्यो ये तत्रासन् समागताः ।\nतेभ्यश्च प्रददौ वित्तं शतशोऽथ सहस्रशः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2109321, "chapter_id": 3373, "verse_number": "१२", "content_sanskrit": "लोहिताक्षाय सूताय तथा स्थपतये विभुः ।\nयेनोक्तं तत्र सत्राग्रे यज्ञस्य विनिवर्तनम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2109322, "chapter_id": 3373, "verse_number": "१३", "content_sanskrit": "ततश्चकारावभृथं विधिदृष्टेन कर्मणा ।\nअस्तीकं प्रेषयामास गृहानेव सुसत्कृतम् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2109323, "chapter_id": 3373, "verse_number": "१४", "content_sanskrit": "राजा प्रीतमनाः प्रीतं कृतकृत्यं मनीषिणम् ।\nपुनरागमनं कार्यमिति चैनं वचोऽब्रवीत् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2109324, "chapter_id": 3373, "verse_number": "१५", "content_sanskrit": "भविष्यसि सदस्यो मे वाजिमेधे महाक्रतौ ।\nतथेत्युक्त्वा प्रदुद्राव स चास्तीको मुदा युतः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2109325, "chapter_id": 3373, "verse_number": "१६", "content_sanskrit": "कृत्वा स्वकार्थमतुळं तोषयित्वा च पार्थिवम् ।\nस गत्वा परमप्रीतो मातरं मातुलं च तम् ।\nअभिगम्योपसङ्गृह्य यथावृत्तं न्यवेदयत्\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2109326, "chapter_id": 3373, "verse_number": "१७", "content_sanskrit": "एतच्छ्रुत्वा प्रीयमाणाः समेता\nये तत्रासन् पन्नगा वीतमोहाः ।\nत अस्तीके प्रीतिमन्तो बभूवु-\nराहुश्चैनं वरमिष्टं वृणीष्व \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2109327, "chapter_id": 3373, "verse_number": "१८", "content_sanskrit": "भयोभूयः संस्तवैरब्रुवंस्तं\nकिं ते प्रियं करवामाद्य विद्वन् ।\nप्रीता वयं मोक्षिताश्चैव सर्वे\nकामं किं ते करवामाद्य वत्स\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2109328, "chapter_id": 3373, "verse_number": "", "content_sanskrit": "अस्तीकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2109329, "chapter_id": 3373, "verse_number": "१९", "content_sanskrit": "सायं प्रातः पन्नगेन्द्रा नरेन्द्रा\nलोके विप्रेन्द्रा मानवाश्चेतरे वा ।\nधर्माख्यानं ये वदेयुर्ममेदं\nतेषां युष्मन्नैव किञ्चिद् भयं स्यात् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2109330, "chapter_id": 3373, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2109331, "chapter_id": 3373, "verse_number": "२१", "content_sanskrit": "तैश्चाप्युक्तो भागिनेयः प्रसन्नै-\nरेतत् सत्यं वचनं ते चराम ।\nप्रीत्या युक्ता ईप्सितं सर्वतस्ते\nकर्तारः स्म प्रवणा भागिनेय\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2109332, "chapter_id": 3373, "verse_number": "", "content_sanskrit": "अस्तीकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2109333, "chapter_id": 3373, "verse_number": "२२", "content_sanskrit": "जरत्कारोर्जरत्कार्वां समुत्पन्नो महायशाः ।\nअस्तीकः सत्यसन्धो मां पन्नगेभ्योऽभिरक्षतु \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2109334, "chapter_id": 3373, "verse_number": "२३", "content_sanskrit": "अस्तीकं चार्तिमन्तं च सुनीथं चापि यः स्मरेत् ।\nदिवा वा यदि वा रात्रौ नास्ति सर्पभयं क्वचित्\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2109335, "chapter_id": 3373, "verse_number": "२४", "content_sanskrit": "अपसर्पस्व भद्रं ते दूरं गच्छ महायशाः ।\nअस्तीकः सर्पसत्रेवः पन्नगान् योऽभ्यरक्षत\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2109336, "chapter_id": 3373, "verse_number": "२५", "content_sanskrit": "जनमेजयस्य यज्ञान्त आस्तीकवचनं शृणु ।\nआस्तीकवचनं श्रुत्वा यः सर्पो न निवर्तते \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2109337, "chapter_id": 3373, "verse_number": "२६", "content_sanskrit": "शतधा भिद्यते मूर्धा गिरिर्वज्रहतो यथा ।\nइतिस्मरं महानागा नैनं हिंसितुमर्हथ \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2109338, "chapter_id": 3373, "verse_number": "२७", "content_sanskrit": "आस्तीकं यः स्मरेन्नित्यं तमप्याकाशगोचरे ।\nअस्तीकेनोरगैः सार्धं यः पुरा समयः कृतः ।\nयदि सत्यं महानागा नैनं हिंसितुमर्हथ \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2109339, "chapter_id": 3373, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2109340, "chapter_id": 3373, "verse_number": "२८", "content_sanskrit": "मोक्षयित्वा स भगवान् सर्पसत्राद् भुजङ्गमान् ।\nजगाम काले धर्मात्मा दिष्टान्तं पुत्रपौत्रवान् \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2109341, "chapter_id": 3373, "verse_number": "२८", "content_sanskrit": "अत्यास्तीकं मयाऽऽख्यानं यथावत् तव कीर्तितम् ।\nयत् कीर्तयित्वा सर्पेभ्यो न भयं विद्यते क्वचित् \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2109342, "chapter_id": 3373, "verse_number": "२९", "content_sanskrit": "श्रुत्वा धर्मिष्ठमाख्यानमास्तीकं पुण्यवर्धनम् ।\nअस्तीकस्य कवेर्विप्र श्रीमच्चरितमादितः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2109343, "chapter_id": 3373, "verse_number": "३०", "content_sanskrit": "सर्वपापविनिर्मुक्तो दीर्घमायुष्यमाप्नुयात् ।\nगार्हस्थ्यं धर्ममखिलं प्रयायात् पुत्रपौत्रवान् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2109344, "chapter_id": 3373, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायामादिपर्वणि द्विपञ्चाशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2109345, "chapter_id": 3373, "verse_number": "", "content_sanskrit": "॥ आस्तीकपर्वणि चत्वारिंशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2109346, "chapter_id": 3373, "verse_number": "", "content_sanskrit": "॥ समाप्तम् आस्तीकपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]