[{"id": 7006486000, "chapter_id": 26486, "verse_number": "३-२५-१", "content_sanskrit": "नारदादिभिः ब्राह्मणानां ब्रह्मणः च सत्कारं, ब्रह्मणा कश्यपाय यज्ञानुष्ठानस्यादेशं, देवदानवयुद्धं, विष्णुना मधोः पराजयम् वैशम्पायन उवाच ते तु गोब्राह्मणा नागाश्चन्द्रादित्यपुरस्कृताः ।\nब्राह्मणान् पूजयन्देवान् वसुभिर्ब्रह्मसम्भवैः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006486001, "chapter_id": 26486, "verse_number": "३-२५-२", "content_sanskrit": "नारदप्रमुखाश्चैव गन्धर्वा ऋषयो नृप ।\nकुर्वन्ति सततं यज्ञे क्रमप्राप्तं पितामहम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006486002, "chapter_id": 26486, "verse_number": "३-२५-३", "content_sanskrit": "वचोभिर्मधुराभाषैः पञ्चेन्द्रियनिवासिभिः ।\nसर्वभूतप्रियकरैः सर्वभूतहितैषिभिः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006486003, "chapter_id": 26486, "verse_number": "३-२५-४", "content_sanskrit": "स्तूयमानश्च यज्ञान्ते पञ्चेन्द्रिमसमाहितैः ।\nप्रोवाच भगवान्ब्रह्मा दिष्ट्या दिष्ट्येति भारत ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006486004, "chapter_id": 26486, "verse_number": "३-२५-५", "content_sanskrit": "ततः कश्यपमाभाष्य प्रोवाच भगवान् प्रभुः ।\nभवानपि सुतैः सार्धं यक्ष्यते वसुधातले ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006486005, "chapter_id": 26486, "verse_number": "३-२५-६", "content_sanskrit": "क्रतुभिः परमप्राप्तैः सम्पूर्णवरदक्षिणैः ।\nयक्षाः सुराश्च ते सर्वे यथा प्रतिगुणैः प्रभो ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006486006, "chapter_id": 26486, "verse_number": "३-२५-७", "content_sanskrit": "वयं यक्ष्यामहे पूर्वं पूर्वं यक्ष्यामहे वयम् ।\nएवमन्योन्यसंरम्भाद् विद्यन्ते बलदर्पिताः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006486007, "chapter_id": 26486, "verse_number": "३-२५-८", "content_sanskrit": "दैतेयाश्चाप्यदैतेयाः परस्परजयैषिणः ।\nयुद्धायैव प्रतिष्ठन्ति प्रगृह्य विपुलौ भुजौ ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006486008, "chapter_id": 26486, "verse_number": "३-२५-९", "content_sanskrit": "निवार्यमाणा ऋषिभिस्तपसा दग्धकिल्बिषैः ।\nअन्यैश्च विविधैर्विप्रैर्वेदवेदाङ्गपारगैः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006486009, "chapter_id": 26486, "verse_number": "३-२५-१०", "content_sanskrit": "निवार्यमाणा युध्यन्ते वृषभा इव गोकुले ।\nप्रयुद्धा युद्धसंक्रान्ताः सर्वे प्राणजयैषिणः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006486010, "chapter_id": 26486, "verse_number": "३-२५-११", "content_sanskrit": "पश्यतां सर्वभूतानां मृत्योर्विषयमागताः ।\nततः शब्देन महता परं कृत्वा महाबलाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006486011, "chapter_id": 26486, "verse_number": "३-२५-१२", "content_sanskrit": "रुन्धन्ति बाहुभिः क्रुद्धाः सपक्षा इव पक्षिणः ।\nचचाल वसुधा चैव पादाक्रान्ता च रोषिभिः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006486012, "chapter_id": 26486, "verse_number": "३-२५-१३", "content_sanskrit": "नौर्यथा पुरुषाक्रान्ता निषीदति महाजले ।\nपर्वताश्च विशार्यन्ते नर्दमाना गजा इव ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006486013, "chapter_id": 26486, "verse_number": "३-२५-१४", "content_sanskrit": "चुक्षुभुश्च महानद्यस्ताडिता मातरिश्वना ।\nततः समभवद् युद्धं मधोर्विष्णोश्च भारत ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006486014, "chapter_id": 26486, "verse_number": "३-२५-१५", "content_sanskrit": "युगान्तकरणं घोरं सर्वप्राणिभयंकरम् ।\nप्रममाथ मधोविर्ष्णुः समग्रं बलपौरुषम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006486015, "chapter_id": 26486, "verse_number": "३-२५-१६", "content_sanskrit": "वह्नेरिव बलं दीप्तं शमयत्यम्बुना यथा ।\nतथा प्रशमितं तेन प्रभुणा ह्युपकारिणा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]