[{"id": 2184284, "chapter_id": 4911, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2184285, "chapter_id": 4911, "verse_number": "१", "content_sanskrit": "नामृतस्येव पर्याप्तिर्ममास्ति ब्रुवति त्वयि ।\nतस्मात् कथय भूयस्त्वं धर्ममेव पितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2184286, "chapter_id": 4911, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2184287, "chapter_id": 4911, "verse_number": "२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nगौतमस्य च संवादं यमस्य च महात्मनः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2184288, "chapter_id": 4911, "verse_number": "३", "content_sanskrit": "पारियात्रगिरिं प्राप्य गौतमस्याश्रमो महान् ।\nउवास गौतमो यत्र कालं तदपि मे शृणु\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2184289, "chapter_id": 4911, "verse_number": "४", "content_sanskrit": "षष्टिं वर्षसहस्राणि सोऽतप्यद् गौतमस्तपः ।\nतमुग्रतपसं युक्तं तपसा भावितं मुनिम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2184290, "chapter_id": 4911, "verse_number": "५", "content_sanskrit": "उपयातो नरव्याघ्र लोकपालो यमस्तदा ।\nतमपश्यत् सुतपसमृषिं वै गौतमं मुनिम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2184291, "chapter_id": 4911, "verse_number": "६", "content_sanskrit": "स तं विदित्वा ब्रह्मर्षिर्यममागतमोजसा ।\nप्राञ्जलिः प्रयतो भूत्वा उपसृप्तस्तपोधनः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2184292, "chapter_id": 4911, "verse_number": "७", "content_sanskrit": "तं धर्मराजो दृष्ट्वैव नमस्कृत्य नरर्षभम् ।\nन्यमन्त्रयत धर्मेण क्रियतां किमिति ब्रुवन्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2184293, "chapter_id": 4911, "verse_number": "", "content_sanskrit": "गौतमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2184294, "chapter_id": 4911, "verse_number": "८", "content_sanskrit": "मातापितृभ्यामानृण्यं किं कृत्वा समवाप्नुयात् ।\nकथं च लोकानश्नाति पुरुषो दुर्लभान् शुभान्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2184295, "chapter_id": 4911, "verse_number": "", "content_sanskrit": "यमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2184296, "chapter_id": 4911, "verse_number": "९", "content_sanskrit": "तपःशौचवता नित्यं सत्यधर्मरतेन च ।\nमातापित्रोरहरहः पूजनं कार्यमञ्जसा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2184297, "chapter_id": 4911, "verse_number": "१०", "content_sanskrit": "अश्वमेधैश्च यष्टव्यं बहुभिः स्वाप्तदक्षिणैः ।\nतेन लोकानुपाश्नाति पुरुषोऽद्भुतदर्शनान्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2184298, "chapter_id": 4911, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे अष्टविंशाधिकशततमोध्यायः ॥ १२८ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]