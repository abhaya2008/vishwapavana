[{"id": 7001899000, "chapter_id": 21899, "verse_number": "७८-१", "content_sanskrit": "मार्कण्डेय उवाच ।\nततस्तं तुष्टुवुर्देवास्तथा देवर्षयो रविम् ।\nवाग्भिरोड्यमशेषस्य त्रैलोक्यस्य समागताः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001899001, "chapter_id": 21899, "verse_number": "७८-२", "content_sanskrit": "देवा ऊचुः ।\nनमस्ते ऋक्स्वरूपाय सामरूपाय ते नमः ।\nयजुः स्वरूपरूपाय साम्नान्धामवते नमः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001899002, "chapter_id": 21899, "verse_number": "७८-३", "content_sanskrit": "ज्ञानैकधामभूताय निर्धूततमसे नमः ।\nशुद्धज्योतिः स्वरूपाय विशुद्धायामलात्मने ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001899003, "chapter_id": 21899, "verse_number": "७८-४", "content_sanskrit": "वरिष्ठाय वरेण्याय परस्मै परमात्मने ।\nनमोऽखिलजगद्व्यापिस्वरूपायात्ममूर्तये ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001899004, "chapter_id": 21899, "verse_number": "७८-५", "content_sanskrit": "इदं स्तोत्रवरं रम्यं श्रोतव्यं श्रद्धया नरैः ।\nशिष्यो भूत्वा समाधिस्थो दत्त्वा देयं गुरोरपि ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001899005, "chapter_id": 21899, "verse_number": "७८-६", "content_sanskrit": "न शून्यभूतैः श्रोतव्यमेतत्तु सफलं भवेत् ।\nसर्वकारणभूताय निष्ठायै ज्ञानचेतसाम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001899006, "chapter_id": 21899, "verse_number": "७८-७", "content_sanskrit": "नमः सूर्यस्वरूपाय प्रकाशात्मस्वरूपिणे ।\nभास्कराय नमस्तुभ्यं तथा दिनकृते नमः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001899007, "chapter_id": 21899, "verse_number": "७८-८", "content_sanskrit": "शर्वरीहेतवे चैव सन्ध्याज्योत्स्नाकृते नमः ।\nत्वं सर्वमेतद् भगवन् जगदुद्भ्रमता त्वया ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001899008, "chapter_id": 21899, "verse_number": "७८-९", "content_sanskrit": "भ्रमत्याविद्धमखिलं ब्रह्माण्डं सचराचरम् ।\nत्वदंशुभिरिदं स्पृष्टं सर्वं सञ्जायते शुचि ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001899009, "chapter_id": 21899, "verse_number": "७८-१०", "content_sanskrit": "क्रियते त्वत्करैः स्पर्शाज्जलादीनां पवित्रता ।\nहोमदानादिको धर्मो नोपकाराय जायते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001899010, "chapter_id": 21899, "verse_number": "७८-११", "content_sanskrit": "तावद्यावन्न संयोगि जगदेतत् त्वदंशुभिः ।\nऋचस्ते सकला ह्येता यजूंष्येतानि चान्यतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001899011, "chapter_id": 21899, "verse_number": "७८-१२", "content_sanskrit": "सकलानि च सामानि निपतन्ति त्वदड्गतः ।\nऋङ्मयस्त्वं जगन्नाथ ! त्वमेव च यजुर्मयः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001899012, "chapter_id": 21899, "verse_number": "७८-१३", "content_sanskrit": "यतः साममयश्चैव ततो नाथ ! त्रयीमयः ।\nत्वमेव ब्रह्मणो रूपं परञ्चापरमेव च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001899013, "chapter_id": 21899, "verse_number": "७८-१४", "content_sanskrit": "मूर्तामूर्तस्तथा सूक्ष्मः स्थूलरूपस्तथा स्थितः ।\nनिमेषकाष्ठादिमयः कालरूपः क्षयात्मकः ।\nप्रसीद स्वेच्छया रूपं स्वतेजः शमनं कुरु ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001899014, "chapter_id": 21899, "verse_number": "७८-१५", "content_sanskrit": "मार्कण्डेय उवाच ।\nएवं संस्तूयमानस्तु देवैर्देवर्षिभिस्तथा ।\nमुमोच स्वं तदा तेजस्तेजसां राशिरव्ययः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001899015, "chapter_id": 21899, "verse_number": "७८-१६", "content_sanskrit": "यत्तस्य ऋङ्मयं तेजो भविता तेन मेदिनी ।\nयजुर्मयेनापि दिवं स्वर्गः साममयं रवेः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001899016, "chapter_id": 21899, "verse_number": "७८-१७", "content_sanskrit": "शातितास्तेजसो भागा ये त्वष्ट्रा दश पञ्च च ।\nत्वष्ट्रैव तेन शर्वस्य कृतं शूलं महात्मना ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001899017, "chapter_id": 21899, "verse_number": "७८-१८", "content_sanskrit": "चक्रं विष्णोर्वसूनाञ्च शङ्कवोऽथ सुदारुणाः ।\nपावकस्य तथा शक्तिः शिबिका धनदस्य च ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001899018, "chapter_id": 21899, "verse_number": "७८-१९", "content_sanskrit": "अन्येषामसुरारीणामस्त्राण्युग्राणि यानि वै ।\nयक्षविद्याधराणाञ्च तानि चक्रे स विश्वकृत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001899019, "chapter_id": 21899, "verse_number": "७८-२०", "content_sanskrit": "ततश्च षोडशं भागं बिभर्ति भगवान् विभुः ।\nतत्तेजः पञ्चदशधा शातितं विश्वकर्मणा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001899020, "chapter_id": 21899, "verse_number": "७८-२१", "content_sanskrit": "ततोऽश्वरूपधृग्भानुरुत्तरानगमत् कुरून् ।\nतदृशे तत्र संज्ञाञ्च वडवारूपधारिणीम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001899021, "chapter_id": 21899, "verse_number": "७८-२२", "content_sanskrit": "सा च दृष्ट्वा तमायान्तं परपुंसो विशङ्कया ।\nजगाम संमुखं तस्य पृष्ठरक्षणतत्परा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001899022, "chapter_id": 21899, "verse_number": "७८-२३", "content_sanskrit": "ततश्च नासिकायोगं तयोस्तत्र समेतयोः ।\nनासत्यदस्त्रौ तनयावश्वीवक्त्रविनिर्गतौ ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001899023, "chapter_id": 21899, "verse_number": "७८-२४", "content_sanskrit": "रेतसोऽन्ते च रेवन्तः खड्गी चर्मो तनुत्रधृक् ।\nअश्वारूढः समुद्भूतो बाणतूणसमन्वितः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001899024, "chapter_id": 21899, "verse_number": "७८-२५", "content_sanskrit": "ततः स्वरूपमतुलं दर्शयामास भानुमान् ।\nतस्यैषा च समालोक्य स्वरूपं मुदमाददे ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001899025, "chapter_id": 21899, "verse_number": "७८-२६", "content_sanskrit": "स्वरूपधारिणीञ्चैमामानिनाय निजाश्रयम् ।\nसंज्ञां भार्यां प्रीतिमतीं भास्करो वारितस्करः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001899026, "chapter_id": 21899, "verse_number": "७८-२७", "content_sanskrit": "ततः पूर्वसुतो योऽस्याः सोऽभूद्वैवस्वतो मनुः ।\nद्वितीयश्च यमः शापाद्धर्मदृष्टिरभूत् सुतः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001899027, "chapter_id": 21899, "verse_number": "७८-२८", "content_sanskrit": "कृमयो मांसमादाय पादतोऽस्य महीतले ।\nपतिष्यन्तीति शापान्तं तस्य चक्रे पिता स्वयम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001899028, "chapter_id": 21899, "verse_number": "७८-२९", "content_sanskrit": "धर्मदृष्टिर्यतश्चासौ समो मित्रे तथाहिते ।\nततो नियोगं तं याम्ये चकार तिमिरापहः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001899029, "chapter_id": 21899, "verse_number": "७८-३०", "content_sanskrit": "यमुना च नदी जज्ञे कलिन्दान्तरवाहिनी ।\nअश्विनौ देवभिषजौ कृतौ पित्रा महात्मना ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001899030, "chapter_id": 21899, "verse_number": "७८-३१", "content_sanskrit": "गुह्यकाधिपतित्वे च रेवन्तोऽपि नियोजितः ।\nच्छायासंज्ञासुतानाञ्च नियोगः श्रुयतां मम ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001899031, "chapter_id": 21899, "verse_number": "७८-३२", "content_sanskrit": "पूर्वजस्य मनोस्तुल्यश्छायासंज्ञासुतोऽग्रजः ।\nततः सावर्णिकीं संज्ञामवाप तनयो रवेः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001899032, "chapter_id": 21899, "verse_number": "७८-३३", "content_sanskrit": "भविष्यति मनुः सोऽपि बलिरिन्द्रो यदा तदा ।\nशनैश्चरो ग्रहाणाञ्च मध्ये पित्रा नियोजितः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001899033, "chapter_id": 21899, "verse_number": "७८-३४", "content_sanskrit": "तयोस्तृतीया या कन्या तपती नाम सा कुरुम् ।\nनृपात् संवरणात् पुत्रमवाप मनुजेश्वरम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001899034, "chapter_id": 21899, "verse_number": "७८-३५", "content_sanskrit": "तस्य वैवस्वतस्याहं मनोः सप्तममन्तरम् ।\nकथयामि सुतान् भूपानृषीन् देवान् सुराधिपम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]