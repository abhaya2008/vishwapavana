[{"id": 6000153000, "chapter_id": 10153, "verse_number": null, "content_sanskrit": "अथ पञ्चदशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000153001, "chapter_id": 10153, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.001.m4a", "display_order": 2}, {"id": 6000153002, "chapter_id": 10153, "verse_number": "७-१५-१", "content_sanskrit": "कर्मनिष्ठा द्विजाः केचित् तपोनिष्ठा नृपापरे।\nस्वाध्यायेऽन्ये प्रवचने अन्ये च ज्ञानयोगयोः॥ ७/१५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.002.m4a", "display_order": 3, "topics": [{"text": "सर्ववर्णाश्रमसाधारणधर्मकथनम्", "range": "१–८०"}]}, {"id": 6000153003, "chapter_id": 10153, "verse_number": "७-१५-२", "content_sanskrit": "ज्ञाननिष्टाय देयानि कव्यान्यानन्त्यमिच्छता।\nदैवे च तदभावे स्यादितरेभ्यो यथाऽर्हतः॥ ७/१५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.003.m4a", "display_order": 4}, {"id": 6000153004, "chapter_id": 10153, "verse_number": "७-१५-३", "content_sanskrit": "द्वौ दैवे पितृकार्ये त्रीनेकैकमुभयत्र वा।\nभोजयेत् सुसमृद्धोऽपि श्राद्धे कुर्यान्न विस्तरम्॥ ७/१५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.004.m4a", "display_order": 5}, {"id": 6000153005, "chapter_id": 10153, "verse_number": "७-१५-४", "content_sanskrit": "देशकालोचितश्रद्धाद्रव्यपात्रार्हणानि च।\nसम्यग् भवन्ति नैतानि विस्तरात् स्वजनार्पणात्॥ ७/१५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.005.m4a", "display_order": 6}, {"id": 6000153006, "chapter_id": 10153, "verse_number": "७-१५-५", "content_sanskrit": "देशे काले च सम्प्राप्तमुत्पन्नं हरिदैवतम्।\nश्रद्धया विधिवत् पात्रे न्यस्तं कामधुगक्षयम्॥ ७/१५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.006.m4a", "display_order": 7}, {"id": 6000153007, "chapter_id": 10153, "verse_number": "७-१५-६", "content_sanskrit": "देवर्षिपितृभूतेभ्य आत्मने स्वजनाय च।\nअन्नं संविभजन् पश्येत् सर्वतः पुरुषात्मकम्॥ ७/१५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.007.m4a", "display_order": 8}, {"id": 6000153008, "chapter_id": 10153, "verse_number": "७-१५-७", "content_sanskrit": "न दद्यादामिषं श्राद्धे न चाद्याद् धर्मतत्त्ववित्।\nमुनीनां स्यात् परा प्रीतिर्यथा, न पशुहिंसया॥ ७/१५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.008.m4a", "display_order": 9}, {"id": 6000153009, "chapter_id": 10153, "verse_number": "७-१५-८", "content_sanskrit": "नैतादृशः परो धर्मो नृणां सद्धर्ममिच्छताम्।\nन्यासो दण्डस्य भूतेषु मनोवाक्कायजस्य यः॥ ७/१५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.009.m4a", "display_order": 10}, {"id": 6000153010, "chapter_id": 10153, "verse_number": "७-१५-९", "content_sanskrit": "एके कर्ममयान् यज्ञान् ज्ञानिनो यज्ञवित्तमाः।\nआत्मसंयमनेऽनीहा जुह्वति ज्ञानदीपिते॥ ७/१५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.010.m4a", "display_order": 11}, {"id": 6000153011, "chapter_id": 10153, "verse_number": "७-१५-१०", "content_sanskrit": "द्रव्ययज्ञैर्यक्ष्यमाणं दृष्ट्वा भूतानि बिभ्यति।\nएष माकरुणो हन्यादतज्ज्ञो ह्यसुतृब् ध्रुवम्॥ ७/१५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.011.m4a", "display_order": 12}, {"id": 6000153012, "chapter_id": 10153, "verse_number": "७-१५-११", "content_sanskrit": "तस्माद् दैवोपपन्नेन मुन्यन्नेनैव धर्मवित्।\nसन्तुष्टोऽहरहः कुर्यान्नित्यनैमित्तिकाः क्रियाः॥ ७/१५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.012.m4a", "display_order": 13}, {"id": 6000153013, "chapter_id": 10153, "verse_number": "७-१५-१२", "content_sanskrit": "विधर्मः परधर्मश्च आभास उपमा छलः।\nअधर्मशाखाः पञ्चेमा धर्मज्ञोऽधर्मवत् त्यजेत्॥ ७/१५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.013.m4a", "display_order": 14}, {"id": 6000153014, "chapter_id": 10153, "verse_number": "७-१५-१३", "content_sanskrit": "धर्मबाधो विधर्मः स्यात् परधर्मोऽन्यचोदितः।\nउपधर्मस्तु पाखण्डो दम्भो वा धर्मभिच्छलः॥ ७/१५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.014.m4a", "display_order": 15}, {"id": 6000153015, "chapter_id": 10153, "verse_number": "७-१५-१४", "content_sanskrit": "यस्त्विच्छया कृतः पुम्भिराभासो ह्याश्रमः पृथक्।\nस्वभावविहितो धर्मः कल्प्यतेऽस्योपशान्तये॥ ७/१५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.015.m4a", "display_order": 16}, {"id": 6000153016, "chapter_id": 10153, "verse_number": "७-१५-१५", "content_sanskrit": "धर्मार्थमपि नेहेत यात्रार्थं वाऽधनो धनम्।\nअनीहाऽनीहमानस्य महाहेरिव वृत्तिदा॥ ७/१५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.016.m4a", "display_order": 17}, {"id": 6000153017, "chapter_id": 10153, "verse_number": "७-१५-१६", "content_sanskrit": "सन्तुष्टस्य निरीहस्य स्वात्मारामस्य यत् सुखम्।\nकुतस्तत् कामलोभेन धावतोऽर्थेहया दिशः॥ ७/१५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.017.m4a", "display_order": 18}, {"id": 6000153018, "chapter_id": 10153, "verse_number": "७-१५-१७", "content_sanskrit": "सदा सन्तुष्टमनसः सर्वाः सुखमया दिशः।\nशर्कराकण्टकादिभ्यो यथोपानट्पदः शिवम्॥ ७/१५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.018.m4a", "display_order": 19}, {"id": 6000153019, "chapter_id": 10153, "verse_number": "७-१५-१८", "content_sanskrit": "सन्तुष्टः केन वा राजन् न वर्तेतापि वारिणा।\nऔपस्थ्यजैह्व्यकार्पण्याद् गृहपालायते जनः॥ ७/१५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.019.m4a", "display_order": 20}, {"id": 6000153020, "chapter_id": 10153, "verse_number": "७-१५-१९", "content_sanskrit": "असन्तुष्टस्य विप्रस्य तेजो विद्या तपो यशः।\nस्रवतीन्द्रियलौल्येन ज्ञानं चैवावकीर्यते॥ ७/१५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.020.m4a", "display_order": 21}, {"id": 6000153021, "chapter_id": 10153, "verse_number": "७-१५-२०", "content_sanskrit": "कामस्यान्तं हि क्षुत्तृड्भ्यां क्रोधस्यैतत्फलोदयात्।\nजनो याति न लोभस्य जित्वा भुक्त्वा दिशो भुवः॥ ७/१५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.021.m4a", "display_order": 22}, {"id": 6000153022, "chapter_id": 10153, "verse_number": "७-१५-२१", "content_sanskrit": "पण्डिता बहवो राजन् बहुज्ञाः संशयच्छिदः।\nसदसस्पतयोऽप्येके असन्तोषात् पतन्त्यधः॥ ७/१५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.022.m4a", "display_order": 23}, {"id": 6000153023, "chapter_id": 10153, "verse_number": "७-१५-२२", "content_sanskrit": "असङ्कल्पाज्जयेत् कामान् क्रोधं कामविवर्जनात्।\nअर्थानर्थेक्षया लोभं भयं तत्त्वावमर्शनात्॥ ७/१५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.023.m4a", "display_order": 24}, {"id": 6000153024, "chapter_id": 10153, "verse_number": "७-१५-२३", "content_sanskrit": "आन्वीक्षिक्या शोकमोहौ दम्भं महदुपाश्रयात्।\nयोगान्तरायान् मौनेन हिंसां कायाद्यनीहया॥ ७/१५/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.024.m4a", "display_order": 25}, {"id": 6000153025, "chapter_id": 10153, "verse_number": "७-१५-२४", "content_sanskrit": "कृपया भूतजं दुःखं, दैवं जह्यात् समाधिना।\nआत्मजं योगवीर्येण, निद्रां सत्त्वनिषेवया॥ ७/१५/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.025.m4a", "display_order": 26}, {"id": 6000153026, "chapter_id": 10153, "verse_number": "७-१५-२५", "content_sanskrit": "रजस्तमश्च सत्त्वेन, सत्त्वं चोपशमेन च।\nएतत् सर्वं गुरौ भक्त्या पुरुषो मनसा जयेत्॥ ७/१५/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.026.m4a", "display_order": 27}, {"id": 6000153027, "chapter_id": 10153, "verse_number": "७-१५-२६", "content_sanskrit": "यस्य साक्षाद् भगवति ज्ञानदीपप्रदे गुरौ।\nअभिसन्धिः श्रुतं तस्य सर्वं कुञ्जरशौचवत्॥ ७/१५/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.027.m4a", "display_order": 28}, {"id": 6000153028, "chapter_id": 10153, "verse_number": "७-१५-२७", "content_sanskrit": "एष वै भगवान् साक्षात् प्रधानपुरुषेश्वरः।\nयोगेश्वरैर्विमृग्याङ्घ्रिर्लोको यं मन्यते नरम्॥ ७/१५/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.028.m4a", "display_order": 29}, {"id": 6000153029, "chapter_id": 10153, "verse_number": "७-१५-२८", "content_sanskrit": "षड्वर्गसंयमैकान्ताः सर्वा निगमचोदनाः।\nतदन्ता यदि नो योगमावहेयुः श्रमावहाः॥ ७/१५/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.029.m4a", "display_order": 30}, {"id": 6000153030, "chapter_id": 10153, "verse_number": "७-१५-२९", "content_sanskrit": "यथा वार्तादयो विद्याः पुंसः स्वार्थं न बिभ्रति।\nअनर्थाय भवेयुश्च पूर्तमिष्टं तथाऽसतः॥ ७/१५/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.030.m4a", "display_order": 31}, {"id": 6000153031, "chapter_id": 10153, "verse_number": "७-१५-३०", "content_sanskrit": "यश्चित्तविजयेच्छुः स्यान्निःसङ्गो निष्परिग्रहः।\nएको विविक्तशरणो भिक्षुर्भैक्ष्यमिताशनः॥ ७/१५/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.031.m4a", "display_order": 32}, {"id": 6000153032, "chapter_id": 10153, "verse_number": "७-१५-३१", "content_sanskrit": "शुचौ देशे समे राजन्नास्थाप्यासनमात्मनः।\nस्थिरं सुखं समं तस्मिन्नासीतर्ज्वङ्ग ओमिति॥ ७/१५/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.032.m4a", "display_order": 33}, {"id": 6000153033, "chapter_id": 10153, "verse_number": "७-१५-३२", "content_sanskrit": "प्राणापानौ सन्निरुन्ध्यात् पूरकुम्भकरेचकैः।\nयावन्मनस्त्यजेत् कामान् स्वनासाग्रनिरीक्षणः॥ ७/१५/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.033.m4a", "display_order": 34}, {"id": 6000153034, "chapter_id": 10153, "verse_number": "७-१५-३३", "content_sanskrit": "यतो यतो निःसरति मनः कामहतं भ्रमत्।\nततस्तत उपाहृत्य हृदि रुन्ध्याच्छनैर्बुधः॥ ७/१५/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.034.m4a", "display_order": 35}, {"id": 6000153035, "chapter_id": 10153, "verse_number": "७-१५-३४", "content_sanskrit": "एवमभ्यसतश्चित्तं कालेनाल्पीयसा मुनेः।\nअविषण्णं च निर्वाणं यात्यनिन्धनवह्निवत्॥ ७/१५/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.035.m4a", "display_order": 36}, {"id": 6000153036, "chapter_id": 10153, "verse_number": "७-१५-३५", "content_sanskrit": "कामादिभिरनाविद्धं प्रशान्ताखिलवृत्ति यत्।\nचित्तं ब्रह्मसुखस्पृष्टं नैवोत्तिष्ठेत कर्हिचित्॥ ७/१५/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.036.m4a", "display_order": 37}, {"id": 6000153037, "chapter_id": 10153, "verse_number": "७-१५-३६", "content_sanskrit": "यः प्रव्रज्य गृहात् पूर्वं त्रिवर्गावपनात् पुनः।\nयदा सेवेत तान् भिक्षुः स पापो निरपत्रपः॥ ७/१५/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.037.m4a", "display_order": 38}, {"id": 6000153038, "chapter_id": 10153, "verse_number": "७-१५-३७", "content_sanskrit": "यस्य देहः स्मृतोऽनात्मा मर्त्यो विट्क्रिमिभस्मवत्।\nतमेव स्वात्मसात् कृत्वा श्लाघयन्ति ह्यसत्तमाः॥ ७/१५/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.038.m4a", "display_order": 39}, {"id": 6000153039, "chapter_id": 10153, "verse_number": "७-१५-३८", "content_sanskrit": "गृहस्थस्य क्रियात्यागो व्रतत्यागो वटोरपि।\nतपस्विनो ग्रामसेवा भिक्षोरिन्द्रियलौल्यता॥ ७/१५/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.039.m4a", "display_order": 40}, {"id": 6000153040, "chapter_id": 10153, "verse_number": "७-१५-३९", "content_sanskrit": "आश्रमापसदा ह्येते खल्वाश्रमविडम्बिनः।\nदेवमायाविमूढांस्तानुपेक्षेतानुकम्पया॥ ७/१५/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.040.m4a", "display_order": 41}, {"id": 6000153041, "chapter_id": 10153, "verse_number": "७-१५-४०", "content_sanskrit": "आत्मानं चेद् विजानीयादेवं ज्ञानधृताशयः।\nकिमिच्छन् कस्य वा हेतोर्देहं पुष्णाति लम्पटः॥ ७/१५/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.041.m4a", "display_order": 42}, {"id": 6000153042, "chapter_id": 10153, "verse_number": "७-१५-४१", "content_sanskrit": "आहुः शरीरं रथमिन्द्रियाणि हयानभीषुं मन इन्द्रियेशम्।\nवर्त्मानि मात्रा, धिषणां च सूतं सत्त्वं बृहद्बन्धुरमीशधाम॥ ७/१५/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.042.m4a", "display_order": 43}, {"id": 6000153043, "chapter_id": 10153, "verse_number": "७-१५-४२", "content_sanskrit": "अक्षं दशप्राणमधर्मधर्मौ चक्रेऽभिमानं रथिनं च जीवम्।\nधनुर्हि तस्य प्रणवं पठन्ति शरं तु जीवं परमेव लक्ष्यम्॥ ७/१५/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.043.m4a", "display_order": 44}, {"id": 6000153044, "chapter_id": 10153, "verse_number": "७-१५-४३", "content_sanskrit": "रागो द्वेषश्च लोभश्च शोकमोहौ भयं मदः।\nमानोऽभिमानोऽसूया च माया हिंसा च मत्सरः॥ ७/१५/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.044.m4a", "display_order": 45}, {"id": 6000153045, "chapter_id": 10153, "verse_number": "७-१५-४४", "content_sanskrit": "रजः प्रमादः क्षुन्निद्रा शत्रवस्त्वेवमादयः।\nरजस्तमःप्रकृतयः सत्त्वप्रकृतयः क्‍वचित्॥ ७/१५/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.045.m4a", "display_order": 46}, {"id": 6000153046, "chapter_id": 10153, "verse_number": "७-१५-४५", "content_sanskrit": "यावन्नृकायरथमात्मवशोपकल्पं धत्ते गरिष्ठचरणार्चनया निशातम्।\nज्ञानासिमच्युतबलं दधदस्तशत्रुः स्वाराज्यतुष्ट उपशान्त इदं विजह्यात्॥ ७/१५/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.046.m4a", "display_order": 47}, {"id": 6000153047, "chapter_id": 10153, "verse_number": "७-१५-४६", "content_sanskrit": "नो चेत् प्रमत्तमसदिन्द्रियवाजिसूता नीत्वोत्पथं विषयदस्युषु निक्षिपन्ति।\nते दस्यवः सहयसूतममुं तमोऽन्धे संसारकूप उरुमृत्युभये क्षिपन्ति॥ ७/१५/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.047.m4a", "display_order": 48}, {"id": 6000153048, "chapter_id": 10153, "verse_number": "७-१५-४७", "content_sanskrit": "प्रवृत्तं च निवृत्तं च द्विविधं कर्म वैदिकम्।\nआवर्तते प्रवृत्तेन, निवृत्तेनाश्नुतेऽमृतम्॥ ७/१५/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.048.m4a", "display_order": 49}, {"id": 6000153049, "chapter_id": 10153, "verse_number": "७-१५-४८", "content_sanskrit": "हिंस्रं द्रव्यमयं काम्यमग्निहोत्राद्यशान्तिदम्।\nदर्शश्च पूर्णमासश्च चातुर्मास्यः पशुः पुनः॥ ७/१५/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.049.m4a", "display_order": 50}, {"id": 6000153050, "chapter_id": 10153, "verse_number": "७-१५-४९", "content_sanskrit": "एतदिष्टं प्रवृत्ताख्यं हुतं प्रहुतमेव च।\nपूर्तं सुरालयारामकूपाजीव्यादिलक्षणम्॥ ७/१५/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.050.m4a", "display_order": 51}, {"id": 6000153051, "chapter_id": 10153, "verse_number": "७-१५-५०", "content_sanskrit": "द्रव्यमूष्मविपाकश्च धूमो रात्रिरपक्षयः।\nअयनं दक्षिणं सोमो दर्श ओषधिवीरुधः॥ ७/१५/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.051.m4a", "display_order": 52}, {"id": 6000153052, "chapter_id": 10153, "verse_number": "७-१५-५१", "content_sanskrit": "अन्नं रेत इति क्ष्मेश पितृयानं पुनर्भवः।\nएकैकश्येनानुपूर्व्याद् भूत्वा भूत्वेह जायते॥ ७/१५/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.052.m4a", "display_order": 53}, {"id": 6000153053, "chapter_id": 10153, "verse_number": "७-१५-५२", "content_sanskrit": "निषेकादिश्मशानान्तैः संस्कारैः संस्कृतो द्विजः।\nइन्द्रियेषु क्रियायज्ञान् ज्ञानदीपेषु जुह्वति॥ ७/१५/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.053.m4a", "display_order": 54}, {"id": 6000153054, "chapter_id": 10153, "verse_number": null, "content_sanskrit": "इन्द्रियाणि मनस्येवं वाचि वैकारिकं मनः।\nतां तु वर्णसमाम्नाये तमोङ्कारे स्वरे न्यसेत् ।॥ ७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.054.m4a", "display_order": 55}, {"id": 6000153055, "chapter_id": 10153, "verse_number": "७-१५-५३", "content_sanskrit": "ओङ्कारं बिन्दुनादे तु तं तु प्राणे महत्यमुम्॥ ७/१५/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.055.m4a", "display_order": 56}, {"id": 6000153056, "chapter_id": 10153, "verse_number": "७-१५-५४", "content_sanskrit": "अग्निः सूर्यो दिवा वायुः शुक्लो राकोत्तरः स्वराट्॥ ७/१५/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.056.m4a", "display_order": 57}, {"id": 6000153057, "chapter_id": 10153, "verse_number": "७-१५-५५", "content_sanskrit": "विश्वोऽथ तैजसः प्राज्ञस्तुर्य आत्मा समन्वयः। देवयानमिदं प्राहुर्भूत्वा भूत्वाऽनुपूर्वशः।\nआत्मयाज्युपशान्तात्मा ह्यात्मस्थो न निवर्तते॥ ७/१५/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.057.m4a", "display_order": 58}, {"id": 6000153058, "chapter_id": 10153, "verse_number": "७-१५-५६", "content_sanskrit": "य एते पितृदेवानामयने देवनिर्मिते।\nशास्‍त्रेण चक्षुषा वेद जनस्थोऽपि न मुह्यति॥ ७/१५/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.058.m4a", "display_order": 59}, {"id": 6000153059, "chapter_id": 10153, "verse_number": "७-१५-५७", "content_sanskrit": "आदावन्ते जनानाशं बहिरन्तः परावरम्।\nज्ञानं ज्ञेयं वचो वाच्यं तमो ज्योतिश्च तत् स्वयम्॥ ७/१५/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.059.m4a", "display_order": 60}, {"id": 6000153060, "chapter_id": 10153, "verse_number": "७-१५-५८", "content_sanskrit": "अबाधितोऽपि ह्याभासो यथा वस्तुतया स्मृतः।\nदुर्घटत्वादैन्द्रियकं तद्वदर्थविकल्पितम्॥ ७/१५/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.060.m4a", "display_order": 61}, {"id": 6000153061, "chapter_id": 10153, "verse_number": "७-१५-५९", "content_sanskrit": "क्षित्यादीनां इहार्थानां छाया न कतमाऽपि हि।\nन संघातो विकारोऽपि न पृथङ् नान्वितोऽपि वा॥ ७/१५/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.061.m4a", "display_order": 62}, {"id": 6000153062, "chapter_id": 10153, "verse_number": "७-१५-६०", "content_sanskrit": "धातवोऽवयवित्वाच्च तन्मात्रावयवैर्विना।\nन स्युर्ह्यसत्यवयविन्यासन्नावयवा इव॥ ७/१५/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.062.m4a", "display_order": 63}, {"id": 6000153063, "chapter_id": 10153, "verse_number": "७-१५-६१", "content_sanskrit": "स्यात् सादृश्यभ्रमस्तावद् विकल्पे सति वस्तुनः।\nजाग्रत्स्वप्नौ यथा स्वप्ने तथा विधिनिषेधता॥ ७/१५/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.063.m4a", "display_order": 64}, {"id": 6000153064, "chapter_id": 10153, "verse_number": "७-१५-६२", "content_sanskrit": "भावाद्वैतं क्रियाद्वैतं द्रव्याद्वैतं तथाऽऽत्मनः।\nवर्तयन् स्वानुभूत्येह त्रीन् स्वप्नान् धुनुते मुनिः॥ ७/१५/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.064.m4a", "display_order": 65}, {"id": 6000153065, "chapter_id": 10153, "verse_number": "७-१५-६३", "content_sanskrit": "कार्यकारणवस्त्वैक्यदर्शनं पटतन्तुवत्।\nअवस्तुत्वाद् विकल्पस्य भावाद्वैतं तदुच्यते॥ ७/१५/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.065.m4a", "display_order": 66}, {"id": 6000153066, "chapter_id": 10153, "verse_number": "७-१५-६४", "content_sanskrit": "यद् ब्रह्मणि परे साक्षात् सर्वकर्मसमर्पणम्।\nमनोवाक्तनुभिः पार्थ क्रियाद्वैतं तदुच्यते॥ ७/१५/६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.066.m4a", "display_order": 67}, {"id": 6000153067, "chapter_id": 10153, "verse_number": "७-१५-६५", "content_sanskrit": "आत्मजायासुतादीनामन्येषां सर्वदेहिनाम्।\nयच्चार्थकामयोरैक्यं द्रव्याद्वैतं तदुच्यते॥ ७/१५/६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.067.m4a", "display_order": 68}, {"id": 6000153068, "chapter_id": 10153, "verse_number": "७-१५-६६", "content_sanskrit": "यद् यस्य वाऽनिषिद्धं स्याद्येन यत्र यतो नृप।\nस तेनेहेत कर्माणि नरो नान्यैरनापदि॥ ७/१५/६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.068.m4a", "display_order": 69}, {"id": 6000153069, "chapter_id": 10153, "verse_number": "७-१५-६७", "content_sanskrit": "एतैरन्यैश्च वेदोक्तैर्वर्तमानः स्वकर्मभिः।\nगृहेऽप्यस्य गतिं यायाद्राजंस्तद्भक्तिभाङ् नरः॥ ७/१५/६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.069.m4a", "display_order": 70}, {"id": 6000153070, "chapter_id": 10153, "verse_number": "७-१५-६८", "content_sanskrit": "यथा हि यूयं नृपदेवदुस्त्यजादापद्गणादुत्तरिता ननु प्रभो।\nयत्पादपङ्केरुहसेवया भवानहार्षीन्निर्जितदिग्गजः क्रतुम्॥ ७/१५/६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.070.m4a", "display_order": 71}, {"id": 6000153071, "chapter_id": 10153, "verse_number": "७-१५-६९", "content_sanskrit": "अहं पुराऽभवं कश्चिद् गन्धर्व उपबर्हणः।\nनाम्नाऽतीते महाकल्पे गन्धर्वाणां सुसम्मतः॥ ७/१५/६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.071.m4a", "display_order": 72}, {"id": 6000153072, "chapter_id": 10153, "verse_number": "७-१५-७०", "content_sanskrit": "रूपपेशलमाधुर्यसौगन्ध्यप्रियदर्शनः।\nस्‍त्रीणां प्रियतमो नित्यं मत्तस्तत्पुरलम्पटः॥ ७/१५/७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.072.m4a", "display_order": 73}, {"id": 6000153073, "chapter_id": 10153, "verse_number": "७-१५-७१", "content_sanskrit": "एकदा देवसत्रे तु गन्धर्वाप्सरसां गणाः।\nउपहूता विश्वसृग्भिर्हरिगाथोपगायने॥ ७/१५/७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.073.m4a", "display_order": 74}, {"id": 6000153074, "chapter_id": 10153, "verse_number": "७-१५-७२", "content_sanskrit": "अगायं तद् विदित्वाऽहं स्‍त्रीभिः परिवृतो गतः।\nज्ञात्वा विश्वसृजस्तन्मे हेलनं शेपुरोजसा॥ ७/१५/७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.074.m4a", "display_order": 75}, {"id": 6000153075, "chapter_id": 10153, "verse_number": "७-१५-७३", "content_sanskrit": "याहि त्वं शूद्रतामाशु नष्टश्रीः कृतहेलनः। तावद् दास्यामहं जज्ञे तत्रापि ब्रह्मवादिनाम्।\nशुश्रूषयाऽनुषङ्गेण प्राप्तोऽहं ब्रह्मपुत्रताम्॥ ७/१५/७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.075.m4a", "display_order": 76}, {"id": 6000153076, "chapter_id": 10153, "verse_number": "७-१५-७४", "content_sanskrit": "धर्मस्ते गृहमेधीयो वर्णितः पापनाशनः।\nगृहस्थो येन पदवीमञ्जसा न्यासिनामियात्॥ ७/१५/७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.076.m4a", "display_order": 77}, {"id": 6000153077, "chapter_id": 10153, "verse_number": "७-१५-७५", "content_sanskrit": "यूयं नृलोके बत भूरिभागा लोकं पुनाना मुनयोऽभियान्ति।\nयेषां गृहानावसतीति साक्षाद् गूढं परं ब्रह्म मनुष्यलिङ्गम्॥ ७/१५/७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.077.m4a", "display_order": 78}, {"id": 6000153078, "chapter_id": 10153, "verse_number": "७-१५-७६", "content_sanskrit": "स वा अयं ब्रह्म महद् विमृग्यं कैवल्यनिर्वाणसुखानुभूतिः।\nप्रियः सुहृद् वः खलु मातुलेय आत्माऽर्हणीयो विधिकृद्गुरुश्च॥ ७/१५/७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.078.m4a", "display_order": 79}, {"id": 6000153079, "chapter_id": 10153, "verse_number": "७-१५-७७", "content_sanskrit": "न यस्य साक्षाद् भवपद्मजादिभी रूपं धिया वस्तुतयोपवर्णितम्।\nमौनेन भक्त्योपशमेन पूजितः प्रसीदतामेष स सात्वतां पतिः॥ ७/१५/७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.079.m4a", "display_order": 80}, {"id": 6000153080, "chapter_id": 10153, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.080.m4a", "display_order": 81}, {"id": 6000153081, "chapter_id": 10153, "verse_number": "७-१५-७८", "content_sanskrit": "इति देवर्षिणा प्रोक्तं निशम्य भरतर्षभः।\nपूजयासास सुप्रीतः कृष्णं च प्रेमविह्वलः॥ ७/१५/७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.081.m4a", "display_order": 82}, {"id": 6000153082, "chapter_id": 10153, "verse_number": "७-१५-७९", "content_sanskrit": "कृष्णपार्थावुपामन्त्र्य पूजितः प्रययौ मुनिः।\nश्रुत्वा कृष्णं परं ब्रह्म पार्थाः परमविस्मिताः॥ ७/१५/७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.082.m4a", "display_order": 83}, {"id": 6000153083, "chapter_id": 10153, "verse_number": "७-१५-८०", "content_sanskrit": "इति दाक्षायणीनां ते पृथग्वंशाः प्रकीर्तिताः।\nदेवासुरमनुष्याद्या लोका यत्र चराचराः॥ ७/१५/८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_015/BhP_07.015.083.m4a", "display_order": 84}, {"id": 6000153084, "chapter_id": 10153, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां सप्तमस्कन्धे पञ्चदशाध्यायः॥\n॥ इति सप्तमस्कन्धः समाप्तः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}]