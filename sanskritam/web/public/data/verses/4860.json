[{"id": 2182141, "chapter_id": 4860, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2182142, "chapter_id": 4860, "verse_number": "१", "content_sanskrit": "यया वृत्त्या महीपालो विवर्धयति मानवान् ।\nपुण्यांश्च लोकान् जयति तन्मे ब्रूहि पितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2182143, "chapter_id": 4860, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2182144, "chapter_id": 4860, "verse_number": "२", "content_sanskrit": "दानशीलो भवेद् राजा यज्ञशीलश्च भारत ।\nउपवासतपःशीलः प्रजानां पालने रतः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2182145, "chapter_id": 4860, "verse_number": "३", "content_sanskrit": "सर्वाश्चैव प्रजा नित्यं राजा धर्मेण पालयेत् ।\nउत्थानेन प्रदानेन पूजयेच्चैव धार्मिकान्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2182146, "chapter_id": 4860, "verse_number": "४", "content_sanskrit": "राज्ञा हि पूजितो धर्मस्ततः सर्वत्र पूज्यते ।\nयद्यदाचरते राजा तत् प्रजानां हि रोचते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2182147, "chapter_id": 4860, "verse_number": "५", "content_sanskrit": "नित्यमुद्यतदण्डश्च भवेन्मृत्युरिवारिषु ।\nनिहन्यात् सर्वतो दस्यून्न कामात् कस्यचित् क्षमेत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2182148, "chapter_id": 4860, "verse_number": "६", "content_sanskrit": "यं हि धर्मं चरन्तीह प्रजा राज्ञा सुरक्षिताः ।\nचतुर्थं तस्य धर्मस्य राजा भारत विन्दति\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2182149, "chapter_id": 4860, "verse_number": "७", "content_sanskrit": "यदधीते यद् यजते यद् ददाति यदर्चति ।\nराजा चतुर्थभाक् तस्य प्रजा धर्मेण पालयन्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2182150, "chapter_id": 4860, "verse_number": "८", "content_sanskrit": "यद् राष्ट्रेऽकुशलं किञ्चिद् राज्ञोऽरक्षयतः प्रजाः ।\nचतुर्थं तस्य पापस्य राजा भारत विन्दति ।\nअप्याहुः सर्वमेवेति भूयोऽर्धमिति निश्चयः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2182151, "chapter_id": 4860, "verse_number": "९", "content_sanskrit": "कर्मणः पृथिवीपाल नृशंसोऽनृतवागपि ।\nतादृशात् किल्बिषाद् राजा शृणु येन प्रमुच्यते\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2182152, "chapter_id": 4860, "verse_number": "१०", "content_sanskrit": "प्रत्याहर्तुमशक्यं स्याद् धनं चोरैर्हृतं यदि ।\nस्वकोशात् तत् प्रदेयं स्यादशक्तेनोपजीवता\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2182153, "chapter_id": 4860, "verse_number": "११", "content_sanskrit": "सर्ववर्णैः सदा रक्ष्यं ब्रह्मस्वं ब्राह्मणास्तथा ।\nन स्थेयं विषये तेषु योऽपकुर्याद् द्विजातिषु\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2182154, "chapter_id": 4860, "verse_number": "१२", "content_sanskrit": "ब्रह्मस्वे रक्ष्यमाणे हि सर्वं भवति रक्षितम् ।\nतेषां प्रसादे निर्वृत्ते कृतकृत्यो भवेन्नृपः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2182155, "chapter_id": 4860, "verse_number": "१३", "content_sanskrit": "पर्जन्यमिव भूतानि महाद्रुममिव द्विजाः ।\nनरास्तमुपजीवन्ति नृपं सर्वार्थसाधकम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2182156, "chapter_id": 4860, "verse_number": "१४", "content_sanskrit": "नहि कामात्मना राज्ञा सततं शठबुद्धिना ।\nनृशंसेनातिलुब्धेन शक्याः पालयितुं प्रजाः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2182157, "chapter_id": 4860, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2182158, "chapter_id": 4860, "verse_number": "१५", "content_sanskrit": "नाहं शास्तुं सुखान्वेषी राज्यमिच्छाम्यपि क्षणम् ।\nधर्मार्थं रोचये राज्यं धर्मश्चात्र न विद्यते\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2182159, "chapter_id": 4860, "verse_number": "१६", "content_sanskrit": "तदलं मम राज्येन यत्र धर्मो न विद्यते ।\nवनमेव गमिष्यामि तस्माद् धर्मचिकीर्षया\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2182160, "chapter_id": 4860, "verse_number": "१७", "content_sanskrit": "तत्र मेध्येष्वरण्येषु न्यस्तदण्डो जितेन्द्रियः ।\nधर्ममाराधयिष्यामि मुनिर्मूलफलाशनः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2182161, "chapter_id": 4860, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2182162, "chapter_id": 4860, "verse_number": "१८", "content_sanskrit": "वेदाहं तव या बुद्धिरानृशंस्यगुणैव सा ।\nनच शुद्धानृशंस्येन शक्यं महदुपासितुम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2182163, "chapter_id": 4860, "verse_number": "१९", "content_sanskrit": "अपि तु त्वा मृदुं दान्तमन्याय्यमतिधार्मिकम् ।\nक्लीबं धर्मघृणायुक्तं न लोको बहु मन्यते\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2182164, "chapter_id": 4860, "verse_number": "२०", "content_sanskrit": "राजधर्मानवेक्षस्व पितृपैतमहोचितान् ।\nनैतद् राज्ञामथो वृत्तं यथा त्वं स्थातुमिच्छसि\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2182165, "chapter_id": 4860, "verse_number": "२१", "content_sanskrit": "नहि वैक्लव्यसंसृष्टमानृशंस्यमिहास्थितः ।\nप्रजापालनसम्भूतं प्राप्ता धर्मफलं ह्यसि\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2182166, "chapter_id": 4860, "verse_number": "२२", "content_sanskrit": "नह्येतामाशिषं पाण्डुर्नच कुन्त्यन्वयाचत ।\nनचैतां प्राज्ञतां तात यया चरसि मेधया\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2182167, "chapter_id": 4860, "verse_number": "२३", "content_sanskrit": "शौर्यं बलं च सत्त्वं च पिता तव सदाब्रवीत् ।\nमाहात्म्यं बलमौदार्यं तव कुन्त्यन्वयाचत\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2182168, "chapter_id": 4860, "verse_number": "२४", "content_sanskrit": "नित्यं स्वाहा स्वधा नित्यमुभे मानुषदैवते ।\nपुत्रेष्वाशासते नित्यं पितरो दैवतानि च\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2182169, "chapter_id": 4860, "verse_number": "२५", "content_sanskrit": "दानमध्ययनं यज्ञः प्रजानां परिपालनम् ।\nधर्ममेतमधर्मं वा जन्मनैवाभ्यजायथाः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2182170, "chapter_id": 4860, "verse_number": "२६", "content_sanskrit": "काले धुरि नियुक्तानां वहतां भार आहिते ।\nसीदतामपि कौन्तेय न कीर्तिरवसीदति\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2182171, "chapter_id": 4860, "verse_number": "२७", "content_sanskrit": "समन्ततो विनियतो वहत्यस्खलितो हि यः ।\nनिर्दोषकर्मवचनात् सिद्धिः कर्मण एव सा\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2182172, "chapter_id": 4860, "verse_number": "२८", "content_sanskrit": "नैकान्तविनिपातेन विचचारेह कश्चन ।\nधर्मी गृही वा राजा वा ब्रह्मचार्यथ वा पुनः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2182173, "chapter_id": 4860, "verse_number": "२९", "content_sanskrit": "अल्पं तु साधुभूयिष्ठं यत् कर्मोदारमेव तत् ।\nकृतमेवाकृताच्छ्रेयो न पापीयोऽस्त्यकर्मणः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2182174, "chapter_id": 4860, "verse_number": "३०", "content_sanskrit": "यदा कुलीनो धर्मज्ञः प्राप्नोत्यैश्वर्यमुत्तमम् ।\nयोगक्षेमस्तदा राजन् कुशलायैव कल्पते\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2182175, "chapter_id": 4860, "verse_number": "३१", "content_sanskrit": "दानेनान्यं बलेनान्यमन्यं सूनृतया गिरा ।\nसर्वतः परिगृह्णीयाद् राज्यं प्राप्येह धार्मिकः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2182176, "chapter_id": 4860, "verse_number": "३२", "content_sanskrit": "ये हि वैद्याः कुले जाता अवृत्तिभयपीडिताः ।\nप्राप्यतृप्ताः प्रतिष्ठन्ति धर्मः कोऽभ्यधिकस्ततः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2182177, "chapter_id": 4860, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2182178, "chapter_id": 4860, "verse_number": "३३", "content_sanskrit": "किं ततः परमं स्वर्ग्यं का ततः प्रीतिरुत्तमा ।\nकिं ततः परमैश्वर्यं ब्रूहि मे यदि मन्यसे\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2182179, "chapter_id": 4860, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2182180, "chapter_id": 4860, "verse_number": "३४", "content_sanskrit": "यस्मिन् प्रतिष्ठिताः सम्यक् क्षेमं विन्दन्ति तत्क्षणम् ।\nस स्वर्गजित्तमोऽस्माकं सत्यमेतद् ब्रवीमि ते\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2182181, "chapter_id": 4860, "verse_number": "३५", "content_sanskrit": "त्वमेव प्रीतिमांस्तस्मात् कुरूणां कुरुसत्तम ।\nभव राजा जय स्वर्गं सतो रक्षासतो जहि\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2182182, "chapter_id": 4860, "verse_number": "३६", "content_sanskrit": "अनु त्वा तात जीवन्तु सुहृदः साधुभिः सह ।\nपर्जन्यमिव भूतानि स्वादुद्रुममिवाण्डजाः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2182183, "chapter_id": 4860, "verse_number": "३७", "content_sanskrit": "धृष्टं शूरं प्रहर्तारमनृशंसं जितेन्द्रियम् ।\nवत्सलं संविभक्तारमनु जीवन्तु त्वां जनाः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2182184, "chapter_id": 4860, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे सप्तसप्ततितमोऽध्यायः ॥ ७७ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]