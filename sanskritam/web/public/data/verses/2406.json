[{"id": 2066678, "chapter_id": 2406, "verse_number": "९-२४-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2066679, "chapter_id": 2406, "verse_number": "९-२४-१", "content_sanskrit": "युध्यतां यतमानानां शूराणामनिवर्तनाम्।\nसङ्कल्पमकरोन्मोघं गाण्डीवेन धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2066680, "chapter_id": 2406, "verse_number": "९-२४-२", "content_sanskrit": "इन्द्राशनिसमस्पर्शानविषह्यान्महौजसः।\nविसृजन्दृश्यते बाणान्धारा मुञ्चन्निवाम्बुदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2066681, "chapter_id": 2406, "verse_number": "९-२४-३", "content_sanskrit": "तत्सैन्यं भरतश्रेष्ठ वध्यमानं किरीटिना।\nसम्प्रदुद्राव सङ्ग्रामात्तव पुत्रस्य पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2066682, "chapter_id": 2406, "verse_number": "९-२४-४", "content_sanskrit": "पितॄन्भ्रातॄन्परित्यज्य वयस्यानपि चापरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2066683, "chapter_id": 2406, "verse_number": "९-२४-५", "content_sanskrit": "हतधुर्या रथाः केचिद्धतसूतास्तथा परे।\nभग्नाक्षयुगचक्रेषाः केचिदासन्विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2066684, "chapter_id": 2406, "verse_number": "९-२४-६", "content_sanskrit": "अन्येषां सायकाः क्षीणास्तथाऽन्ये बाणपीडिताः।\nअक्षता युगपत्केचित्प्राद्रवन्भयपीडिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2066685, "chapter_id": 2406, "verse_number": "९-२४-७", "content_sanskrit": "केचित्पुत्रानुपादाय हतभूयिष्ठबान्धवाः।\nविचुक्रुशुः पितॄंस्त्वन्ये सहायानपरे पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2066686, "chapter_id": 2406, "verse_number": "९-२४-८", "content_sanskrit": "बान्धवांश्च नरव्याघ्र भ्रातॄन्सम्बन्धिनस्तथा।\nदुद्रुवुः केचिदुत्सृज्य तत्रतत्र विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2066687, "chapter_id": 2406, "verse_number": "९-२४-९", "content_sanskrit": "बहवोऽत्र भृशं विद्धा मुह्यमाना महारथाः।\nनिःश्वसन्ति स्म दृश्यन्ते पार्थबाणहता नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2066688, "chapter_id": 2406, "verse_number": "९-२४-१०", "content_sanskrit": "तानन्ये रथमारोप्य ह्याश्वास्य च मुहूर्तकम्।\nविश्रान्ताश्च वितृष्णाश्च पुनर्युद्धाय जग्मिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2066689, "chapter_id": 2406, "verse_number": "९-२४-११", "content_sanskrit": "तानपास्य गताः केचित्पुनरेव युयुत्सवः।\nकुर्वन्तस्तव पुत्रस्य शासनं युद्धदुर्मदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2066690, "chapter_id": 2406, "verse_number": "९-२४-१२", "content_sanskrit": "पानीयमपरे पीत्वा पर्याश्वास्य च वाहनम्।\nवर्माणि च समारोप्य केचिद्भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2066691, "chapter_id": 2406, "verse_number": "९-२४-१३", "content_sanskrit": "समाश्वास्यापरे भ्रातॄन्निक्षिप्य शिबिरेऽपि च।\nपुत्रानन्ये पितॄनन्ये पुनर्युद्धमरोचयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2066692, "chapter_id": 2406, "verse_number": "९-२४-१४", "content_sanskrit": "सज्जयित्वा रथान्केचिद्यथामुख्यं विशाम्पते।\nआवृत्य पाण्डवानीकं पुनर्युद्धमरोचयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2066693, "chapter_id": 2406, "verse_number": "९-२४-१५", "content_sanskrit": "ते शूराः किङ्किणीजालैः समाच्छन्ना बभासिरे।\nत्रैलोक्यविजये युक्ता यथा दैतेयदानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2066694, "chapter_id": 2406, "verse_number": "९-२४-१६", "content_sanskrit": "आगम्य सहसा केचिद्रथैः स्वर्णविभूषितैः।\nपाण्डवानामनीकेषु धृष्टद्युम्नमयोधयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2066695, "chapter_id": 2406, "verse_number": "९-२४-१७", "content_sanskrit": "धृष्टद्युम्नोऽपि पाञ्चाल्यः शिखण्डी च महारथः।\nनाकुलिस्तु शतानीको रथानीकमयोधयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2066696, "chapter_id": 2406, "verse_number": "९-२४-१८", "content_sanskrit": "पाञ्चाल्यस्तु ततः क्रुद्धः सैन्येन महता वृतः।\nअभ्यद्रवत्सुसङ्क्रुद्धस्तावकान्हन्तुमुद्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2066697, "chapter_id": 2406, "verse_number": "९-२४-१९", "content_sanskrit": "ततस्त्वापततस्तस्य तव पुत्रो जनाधिप।\nबाणसङ्घाननेकान्वै प्रेषयामास भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2066698, "chapter_id": 2406, "verse_number": "९-२४-२०", "content_sanskrit": "धृष्टद्युम्नस्ततो राजंस्तव पुत्रेण धन्विना।\nनाराचैरर्धनाराचैर्बहुभिः क्षिप्रकारिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2066699, "chapter_id": 2406, "verse_number": "९-२४-२१", "content_sanskrit": "वत्सदन्तैश्च बाणैश्च कर्मारपरिमार्जितैः।\nअश्वांश्च चतुरो हत्वा बाह्वोरुरसि चार्पितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2066700, "chapter_id": 2406, "verse_number": "९-२४-२२", "content_sanskrit": "सोऽतिविद्धो महेष्वासस्तोत्रार्दित इव द्विपः।\nतस्याश्वांश्चतुरो बाणैः प्रेषयामास मृत्यवे।\nसारथेश्चास्य भल्लेन शिरः कायादपाहरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2066701, "chapter_id": 2406, "verse_number": "९-२४-२३", "content_sanskrit": "ततो दुर्योधनो राजा पृष्ठमारुह्य वाजिनः।\nअपाक्रामद्वतरथो नातिदूरमरिन्दमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2066702, "chapter_id": 2406, "verse_number": "९-२४-२४", "content_sanskrit": "दृष्टा तु हतविक्रान्तं स्वमनीकं महाबलः।\nतव पुत्रो महाराज प्रययौ यत्र सौबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2066703, "chapter_id": 2406, "verse_number": "९-२४-२५", "content_sanskrit": "ततो रथेषु भग्नेषु त्रिसाहस्रा महाद्विपाः।\nपाण्डवान्रथिनः सर्वान्समन्तात्पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2066704, "chapter_id": 2406, "verse_number": "९-२४-२६", "content_sanskrit": "ते वृताः समरे पञ्च गजानीकेन भारत।\nअशोभन्त महाराज ग्रहास्तारागणैरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2066705, "chapter_id": 2406, "verse_number": "९-२४-२७", "content_sanskrit": "ततोऽर्जुनो महाराज लब्धलक्षौ महाभुजः।\nविनिर्ययौ रथेनैव श्वेताश्वः कृष्णसारथिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2066706, "chapter_id": 2406, "verse_number": "९-२४-२८", "content_sanskrit": "तैः समन्तात्परिवृतः कुञ्जरैः पर्वतोपमैः।\nनाराचैर्विमलैस्तीक्ष्णैर्गजानीकमयोधयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2066707, "chapter_id": 2406, "verse_number": "९-२४-२९", "content_sanskrit": "तत्रैकबाणनिहतानपश्याम महागजान्।\nपतितान्पात्यमानांश्च निर्भिन्नान्सव्यसाचिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2066708, "chapter_id": 2406, "verse_number": "९-२४-३०", "content_sanskrit": "भीमसेनस्तु तान्दृष्ट्वा नागान्मत्तगजोपमः।\nकरेणादाय महतीं गदामभ्यपतद्बली।\nअथाप्लुत्य रथात्तूर्णं दण्डपाणिरिवान्तकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2066709, "chapter_id": 2406, "verse_number": "९-२४-३१", "content_sanskrit": "तमुद्यतगदं दृष्ट्वा पाण्डवानां महारथम्।\nवित्रेसुस्तावकाः सैन्याः शकृन्मूत्रं च सुस्रुवुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2066710, "chapter_id": 2406, "verse_number": "९-२४-३२", "content_sanskrit": "आविग्नं च बलं सर्वं गदाहस्ते वृकोदरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2066711, "chapter_id": 2406, "verse_number": "९-२४-३३", "content_sanskrit": "गदया भीमसेनेन भिन्नकुम्भान्निपातितान्।\nधावमानानपश्याम कुञ्जरान्पर्वतोपमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2066712, "chapter_id": 2406, "verse_number": "९-२४-३४", "content_sanskrit": "प्राद्रवन्कुञ्जरास्ते तु भीमसेनगदाहताः।\nपेतुरार्तस्वरं कृत्वा छिन्नपक्षा इवाद्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2066713, "chapter_id": 2406, "verse_number": "९-२४-३५", "content_sanskrit": "प्रभिन्नकुम्भांस्तु बहून्द्रवमाणानितस्ततः।\nपतमानांश्च सम्प्रेक्ष्य वित्रेसुस्तव सैनिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2066714, "chapter_id": 2406, "verse_number": "९-२४-३६", "content_sanskrit": "युधिष्ठिरोऽपि सङ्क्रुद्धो माद्रीपुत्रौ च पाण्डवौ।\nगार्ध्रपत्रैः शितैर्बाणैर्जघ्नुर्वै गजयोधिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2066715, "chapter_id": 2406, "verse_number": "९-२४-३७", "content_sanskrit": "धृष्टद्युम्नस्तु समरे पारजित्य नराधिपम्।\nअपक्रान्ते तव सुते हयपृष्ठे समाश्रिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2066716, "chapter_id": 2406, "verse_number": "९-२४-३८", "content_sanskrit": "दृष्ट्वा च पाण्डवान्सर्वान्कुञ्चरैः परिवारितान्।\nधृष्टद्युम्नो महाराज सहसा समुपाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2066717, "chapter_id": 2406, "verse_number": "९-२४-३९", "content_sanskrit": "पुत्रः पाञ्चालराजस्य जिघांसुः कुञ्जरान्ययौ।\nअदृष्ट्वा तु रथानीके दुर्योधनमरिन्दमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2066718, "chapter_id": 2406, "verse_number": "९-२४-४०", "content_sanskrit": "अश्वत्थामा कृपश्चैव कृतवर्मा च सात्वतः।\nअपृच्छन्क्षत्रियांस्तत्र क्व नु दुर्योधनो गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2066719, "chapter_id": 2406, "verse_number": "९-२४-४१", "content_sanskrit": "तेऽपश्यमाना राजानं वर्तमाने जनक्षये।\nमन्वाना निहतं तत्र तव पुत्रं महारथाः।\nविवर्णवदना भूत्वा पर्यपृच्छन्त ते सुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2066720, "chapter_id": 2406, "verse_number": "९-२४-४२", "content_sanskrit": "आहुः केचिद्वते सूते प्रयातो यत्र सौबलः।\nहित्वा पाञ्चालराजस्य तदनीकं दुरुत्सहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2066721, "chapter_id": 2406, "verse_number": "९-२४-४३", "content_sanskrit": "अपरे त्वब्रुवंस्तत्र क्षत्रिया भृशविक्षताः।\nदुर्योधनेन किं कार्यं द्रक्ष्यध्वं यदि जीवति।\nयुध्यध्वं सहिताः सर्वे किं वो राजा करिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2066722, "chapter_id": 2406, "verse_number": "९-२४-४४", "content_sanskrit": "ते क्षत्रियाः क्षतैर्गात्रैर्हतभूयिष्ठवाहनाः।\nशरैः सम्पीड्यमानास्तु नातिव्यक्तमथाब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2066723, "chapter_id": 2406, "verse_number": "९-२४-४५", "content_sanskrit": "इदं सर्वं बलं हन्मो येन स्म परिवारिताः।\nएते सर्वे गजान्हत्वा उपयान्ति स्म पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2066724, "chapter_id": 2406, "verse_number": "९-२४-४६", "content_sanskrit": "श्रुत्वा तु वचनं तेषामश्वत्थामा महाबलः।\nभित्त्वा पाञ्चालराजस्य तदनीकं दुरुत्सहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2066725, "chapter_id": 2406, "verse_number": "९-२४-४७", "content_sanskrit": "कृपश्च कृतवर्मा च प्रययौ यत्र सौबलः।\nरथानीकं परित्यज्य शूराः सुदृढधन्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2066726, "chapter_id": 2406, "verse_number": "९-२४-४८", "content_sanskrit": "ततस्तेषु प्रयातेषु धृष्टद्युम्नपुरस्कृताः।\nआययुः पाण्डवा राजन्विनिघ्नन्तः स्म तावकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2066727, "chapter_id": 2406, "verse_number": "९-२४-४९", "content_sanskrit": "दृष्ट्वा तु तानापततः सम्प्रहृष्टान्महारथान्।\nपराक्रान्तास्ततो वीरा निराशा जीविते तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2066728, "chapter_id": 2406, "verse_number": "९-२४-५०", "content_sanskrit": "विवर्णमुखभूयिष्ठमभवत्तावकं बलम्।\nपरिक्षीणायुधान्दृष्ट्वा तानहं परिवारितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2066729, "chapter_id": 2406, "verse_number": "९-२४-५१", "content_sanskrit": "राजन्बलेन त्र्यङ्गेन त्यक्त्वा जीवितमात्मनः।\nआत्मना पञ्चमोऽयुध्यं पाञ्चालस्य बलेन ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2066730, "chapter_id": 2406, "verse_number": "९-२४-५२", "content_sanskrit": "तस्मिन्देशे व्यवस्थाय यत्र शारद्वतः स्थितः।\nसम्प्रद्रुता वयं पञ्च किरीटिशरपीडिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2066731, "chapter_id": 2406, "verse_number": "९-२४-५३", "content_sanskrit": "धृष्टद्युम्नं महारौद्रं तत्र नाभूद्रणो महान्।\nजितास्तेन वयं सर्वे व्यपयाम रणात्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2066732, "chapter_id": 2406, "verse_number": "९-२४-५४", "content_sanskrit": "अथापश्यं सात्यकिं तमुपायातं महारथम्।\nरथैश्चतुः शतैर्वीरो मामभ्यद्रवदाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2066733, "chapter_id": 2406, "verse_number": "९-२४-५५", "content_sanskrit": "धृष्टद्युम्नादहं मुक्तः कञ्छिछ्रान्तवाहनात्।\nपतितो माधवानीकं दुष्कृती नरकं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2066734, "chapter_id": 2406, "verse_number": "९-२४-५६", "content_sanskrit": "तत्र युद्धमभूद्धोरं मुहूर्तमतिदारुणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2066735, "chapter_id": 2406, "verse_number": "९-२४-५७", "content_sanskrit": "सात्यकिस्तु महाबाहुर्मम हत्वा परिच्छदम्।\nजीवग्राहमगृह्णान्मां मूर्च्छितं पतितं भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2066736, "chapter_id": 2406, "verse_number": "९-२४-५८", "content_sanskrit": "ततो मुहूर्तादिव तद्गजानीकमविध्यत।\nगदया भीमसेनेन नाराचैरर्जुनेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2066737, "chapter_id": 2406, "verse_number": "९-२४-५९", "content_sanskrit": "अभिपिष्टैर्महानागैः समन्तात्पर्वतोपमैः।\nनातिप्रसिद्धैव गतिः पाण्डवानामजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2066738, "chapter_id": 2406, "verse_number": "९-२४-६०", "content_sanskrit": "रथमार्गं ततश्चक्रे भीमसेनो महाबलः।\nपाण्डवानां महाराज व्यपाकर्षन्महागजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2066739, "chapter_id": 2406, "verse_number": "९-२४-६१", "content_sanskrit": "अश्वत्थामा कृपश्चैव कृतवर्मा च सात्वतः।\nअपश्यन्तो रथानीके दुर्योधनसमरिन्दमम्।\nराजानं मृगयामासुस्तव पुत्रं महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2066740, "chapter_id": 2406, "verse_number": "९-२४-६२", "content_sanskrit": "परित्यज्य च पाञ्चाल्यं प्रयाता यत्र सौबलः।\nराज्ञोऽदर्शनसंविग्ना वर्तमानो जनक्षये॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2066741, "chapter_id": 2406, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि शल्यवधपर्वणि अष्टादशदिवसयुद्धे चतुर्विंशोऽध्यायः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]