[{"id": 7005244000, "chapter_id": 25244, "verse_number": "७-३-४२-१", "content_sanskrit": "पुलस्त्य उवाच ।\nततो गच्छेन्नृपश्रेष्ठ लिंगं पापहरं परम् ।\nउद्दालकेन मुनिना स्थापितं लोकविश्रुतम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005244001, "chapter_id": 25244, "verse_number": "७-३-४२-२", "content_sanskrit": "तस्मिन्स्पृष्टेऽथ वा दृष्टे पूजिते च विशेषतः ।\nसर्वरोग विनिर्मुक्तो गार्हस्थ्यं प्राप्नुयान्नरः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005244002, "chapter_id": 25244, "verse_number": "७-३-४२-३", "content_sanskrit": "सर्वपापविनिर्मुक्तः शिवलोके महीयते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005244003, "chapter_id": 25244, "verse_number": "७-३-४२-४", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभासखंडे तृतीयेऽर्बुदखण्ड उद्दालकेश्वरमाहात्म्यवर्णनंनाम द्विचत्वारिंशोऽध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}]