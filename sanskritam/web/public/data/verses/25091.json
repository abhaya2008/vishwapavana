[{"id": 7005091000, "chapter_id": 25091, "verse_number": "७-१-२७४-१", "content_sanskrit": "ईश्वर उवाच ।\nततो गच्छेन्महादेवि सूर्यप्राचीं महाप्रभाम् ।\nसर्वपापोपशमनीं सर्वकामफलप्रदाम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005091001, "chapter_id": 25091, "verse_number": "७-१-२७४-२", "content_sanskrit": "तत्र स्नात्वा महादेवि मुच्यते पञ्चपातकैः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005091002, "chapter_id": 25091, "verse_number": "७-१-२७४-३", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभासखण्डे प्रथमे प्रभासक्षेत्रमाहात्म्ये सूर्यप्राचीमाहात्म्यवर्णनंनाम चतुःसप्त त्युत्तरद्विशततमोऽध्यायः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}]