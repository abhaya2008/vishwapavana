[{"id": 2043088, "chapter_id": 1963, "verse_number": "६-१२-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2043089, "chapter_id": 1963, "verse_number": "६-१२-१", "content_sanskrit": "उत्तरेषु च कौरव्य द्वीपेषु श्रूयते कथा।\nएवं तत्र महाराज ब्रुवतश्च निबोध मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2043090, "chapter_id": 1963, "verse_number": "६-१२-२", "content_sanskrit": "घृततोयः समुद्रोऽत्र दधिमण्डोदकोऽपरः ।\nसुरोदः सागरश्चैव तथान्यो जलसागरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2043091, "chapter_id": 1963, "verse_number": "६-१२-३", "content_sanskrit": "परस्परेण द्विगुणाः सर्वे द्वीपा नराधिप ।\nपर्वताश्च महाराज समुद्रैः परिवारिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2043092, "chapter_id": 1963, "verse_number": "६-१२-४", "content_sanskrit": "गौरस्तु मध्यमे द्वीपे गिरिर्मानःशिलो महान् ।\nपर्वतः पश्चिमे कृष्णो नारायणसखो नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2043093, "chapter_id": 1963, "verse_number": "६-१२-५", "content_sanskrit": "तत्र रत्नानि दिव्यानि स्वयं रक्षति केशवः ।\nप्रसन्नश्चाभवत्तत्र प्रजानां व्यदधत्सुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2043094, "chapter_id": 1963, "verse_number": "६-१२-६", "content_sanskrit": "कुशस्तम्बः कुशद्वीपे मध्ये जनपदैः सह ।\nसंपूज्यते शाल्मलिश्च द्वीपे शाल्मलिके नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2043095, "chapter_id": 1963, "verse_number": "६-१२-७", "content_sanskrit": "क्रौञ्चद्वीपे महाक्रौञ्चो गिरी रत्नचयाकरः ।\nसंपूज्यते महाराज चातुर्वर्ण्येन नित्यदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2043096, "chapter_id": 1963, "verse_number": "६-१२-८", "content_sanskrit": "गोमन्तः पर्वतो राजन्सुमहान्सर्वधातुमान् ।\nयत्र नित्यं निवसति श्रीमान्कमललोचनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2043097, "chapter_id": 1963, "verse_number": "६-१२-९", "content_sanskrit": "मोक्षिभिः संस्तुतो नित्यं प्रभुर्नारायणो हरिः ।\nकुशद्वीपे तु राजेन्द्र पर्वतो विद्रुमैश्चितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2043098, "chapter_id": 1963, "verse_number": "६-१२-१०", "content_sanskrit": "सुनामा नाम दुर्धर्षो द्वितीयो हेमपर्वतः ।\nद्युतिमान्नाम कौरव्य तृतीयः कुमुदो गिरिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2043099, "chapter_id": 1963, "verse_number": "६-१२-११", "content_sanskrit": "चतुर्थः पुष्पवान्नाम पञ्चमस्तु कुशेशयः ।\nषष्ठो हरिगिरिर्नाम षडेते पर्वतोत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2043100, "chapter_id": 1963, "verse_number": "६-१२-१२", "content_sanskrit": "तेषामन्तरविष्कम्भो द्विगुणः सर्वभागशः ।\nऔद्भिदं प्रथमं वर्षं द्वितीयं वेणुमण्डलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2043101, "chapter_id": 1963, "verse_number": "६-१२-१३", "content_sanskrit": "तृतीयं सुरथाकारं चतुर्थं कम्बलं स्मृतम् ।\nधृतिमत्पञ्चमं वर्षं षष्ठं प्रभाकरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2043102, "chapter_id": 1963, "verse_number": "६-१२-१४", "content_sanskrit": "सप्तमं कापिलं वर्षं सप्तैते वर्षलम्भकाः ।\nएतेषु देवगन्धर्वाः प्रजाश्च जगतीश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2043103, "chapter_id": 1963, "verse_number": "६-१२-१५", "content_sanskrit": "विहरन्ते रमन्ते च न तेषु म्रियते जनः।\nन तेषु दस्यवः सन्ति म्लेच्छजात्योपि वा नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2043104, "chapter_id": 1963, "verse_number": "६-१२-१६", "content_sanskrit": "गौरप्रायो जनः सर्वः सुकुमारश्च पार्थिव ।\nअवशिष्टेषु सर्वेषु वक्ष्यामि मनुजेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2043105, "chapter_id": 1963, "verse_number": "६-१२-१७", "content_sanskrit": "यथाश्रुतं महाराज तदव्यग्रमनाः श्रृणु ।\nक्रौञ्चद्वीपे महारा क्रौञ्चो नाम महागिरिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2043106, "chapter_id": 1963, "verse_number": "६-१२-१८", "content_sanskrit": "क्रौञ्चात्परो वामनको वामनादन्धकारकः।\nअन्धकारात्परो राजन्मैनाकः पर्वतोत्तमः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2043107, "chapter_id": 1963, "verse_number": "६-१२-१९", "content_sanskrit": "मैनाकात्परतो रादन्गोविन्दो गिरिरुत्तमः ।\nगोविन्दात्परतो राजन्निबिडो नाम पर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2043108, "chapter_id": 1963, "verse_number": "६-१२-२०", "content_sanskrit": "परस्तु द्विगुणस्तेषां विष्कम्भो वंशवर्धन ।\nदेशांस्तत्र प्रवक्ष्यामि तन्मे निगदतः श्रृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2043109, "chapter_id": 1963, "verse_number": "६-१२-२१", "content_sanskrit": "क्रोञ्चस्य कुशलो देशो वामनस्य मनोनुगः।\nमनोनुगात्परश्चोष्णो देशः कुरुकुलोद्वह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2043110, "chapter_id": 1963, "verse_number": "६-१२-२२", "content_sanskrit": "उष्णात्परः प्रावरकः प्रावारादन्धकारकः।\nअन्धकारकदेशात्तु मुनिदेशः परः स्मृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2043111, "chapter_id": 1963, "verse_number": "६-१२-२३", "content_sanskrit": "मुनिदेशात्परश्चैव प्रोच्यते दुन्दुभिस्वनः।\nसिद्धचारणसंकीर्णो गौरप्रायो जनाधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2043112, "chapter_id": 1963, "verse_number": "६-१२-२४", "content_sanskrit": "एते देशा महाराज देवगन्धर्वसेविताः ।\nपुष्करे पुष्करो नाम पर्वतो मणिरत्नवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2043113, "chapter_id": 1963, "verse_number": "६-१२-२५", "content_sanskrit": "तत्र नित्यं प्रभवति स्वयं देवः प्रजापतिः ।\nतं पर्युपासते नित्यं देवाः सर्वे महर्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2043114, "chapter_id": 1963, "verse_number": "६-१२-२६", "content_sanskrit": "वाग्भिर्मनोनुकूलाभिः पूजयन्तो जनाधिप।\nजम्बूद्वीपात्प्रवर्तन्ते रत्नानि विविधान्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2043115, "chapter_id": 1963, "verse_number": "६-१२-२७", "content_sanskrit": "द्वीपेषु तेषु सर्वेषु प्रजानां कुरुसत्तम।\nब्रह्मचर्येण सत्येन प्रजानां हि दमेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2043116, "chapter_id": 1963, "verse_number": "६-१२-२८", "content_sanskrit": "आरोग्यायुःप्रमाणाभ्यां द्विगुणं द्विगुणं ततः।\nएको जनपदो राजन्द्वीपेष्वेतेषु भारत।\nउक्ता जनपदा येषु धर्मश्चैकः प्रदृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2043117, "chapter_id": 1963, "verse_number": "६-१२-२९", "content_sanskrit": "ईश्वरो दण्डमुद्यम्य स्वयमेव प्रजापतिः ।\nद्वीपानेतान्महाराज रक्षंस्तिष्ठति नित्यदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2043118, "chapter_id": 1963, "verse_number": "६-१२-३०", "content_sanskrit": "स राजा स शिवो राजन्स पिता प्रतितामहः ।\nगोपायति नरश्रेष्ठ प्रजाः सजडपण्डिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2043119, "chapter_id": 1963, "verse_number": "६-१२-३१", "content_sanskrit": "भोजनं चात्र कौरव्य प्रजाः स्वयमुपस्थितम् ।\nसिद्धमेव महाबाहो तद्धि भुञ्जन्ति नित्यदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2043120, "chapter_id": 1963, "verse_number": "६-१२-३२", "content_sanskrit": "ततः परं समा नाम दृश्यते लोकसंस्थितिः।\nचतुरश्र महाराज त्रयस्त्रिंशत्तु मण्डलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2043121, "chapter_id": 1963, "verse_number": "६-१२-३३", "content_sanskrit": "तत्र तिष्ठन्ति कौरव्य चत्वारो लोकसंमताः।\nदिग्गजा भरतश्रेष्ठ वामनैरावतादयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2043122, "chapter_id": 1963, "verse_number": "६-१२-३४", "content_sanskrit": "सुप्रतीकस्तदा राजन्प्रभिन्नकरटामुखः।\nतस्याहं परिमाणं तु न संख्यातुमिहोत्सहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2043123, "chapter_id": 1963, "verse_number": "६-१२-३५", "content_sanskrit": "असंख्यातः स नित्यं हि तिर्यगूर्ध्वमधस्तथा ।\nतत्र वै वायवो वान्ति दिग्भ्यः सर्वाभ्य एव हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2043124, "chapter_id": 1963, "verse_number": "६-१२-३६", "content_sanskrit": "असंबद्धा महाराज तान्निगृह्णन्ति ते गजाः ।\nपुष्करैः पद्मसंकाशैर्विकसद्भिर्महाप्रभैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2043125, "chapter_id": 1963, "verse_number": "६-१२-३७", "content_sanskrit": "शतधा पुनरेवाशु ते तान्मुञ्चन्ति नित्यशः ।\nश्वसद्भिर्मुच्यमानास्तु दिग्गजैरिह मारुताः ।\nआगच्छन्ति महाराज ततस्तिष्ठन्ति वै प्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2043126, "chapter_id": 1963, "verse_number": "६-१२-३८x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2043127, "chapter_id": 1963, "verse_number": "६-१२-३८", "content_sanskrit": "परो वै विस्तरोऽत्यर्थं त्वया सञ्जय कीर्तितः।\nदर्शितं द्वीपसंस्थानमुत्तरं ब्रूहि सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2043128, "chapter_id": 1963, "verse_number": "६-१२-३९x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2043129, "chapter_id": 1963, "verse_number": "६-१२-३९", "content_sanskrit": "उक्ता द्वीपा महाराज ग्रहं वै शृणु तत्त्वतः ।\nस्वर्भानोः कौरवश्रेष्ठ यावदेव प्रमाणतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2043130, "chapter_id": 1963, "verse_number": "६-१२-४०", "content_sanskrit": "परिमण्डलो महाराज स्वर्भानुः श्रूयते ग्रहः ।\nयोजनानां सहस्राणि विष्कम्भो द्वादशास्य वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2043131, "chapter_id": 1963, "verse_number": "६-१२-४१", "content_sanskrit": "परिणाहेन षट्त्रिंशद्विपुलत्वेन चानघ ।\nषष्टिमाहुः शतान्यस्य बुधाः पौराणिकास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2043132, "chapter_id": 1963, "verse_number": "६-१२-४२", "content_sanskrit": "चन्द्रमास्तु सहस्राणि राजन्नेकादश स्मृतः ।\nविष्कम्भेण कुरुश्रेष्ठ त्रयस्त्रिंशत्तु मण्डलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2043133, "chapter_id": 1963, "verse_number": "६-१२-४३", "content_sanskrit": "एकोनषष्टिविष्कम्भं शीतरश्मेर्महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2043134, "chapter_id": 1963, "verse_number": "६-१२-४४", "content_sanskrit": "सूर्यस्त्वष्टौ सहस्राणि द्वे चान्ये कुरुनन्दन।\nविष्कम्भेण ततो राजन्मण्डलं त्रिंशता समम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2043135, "chapter_id": 1963, "verse_number": "६-१२-४५", "content_sanskrit": "अष्टपञ्चाशतं राजन्विपुलत्वेन चानघ।\nश्रूयते परमोदारः पतगोऽसौ विभावसुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2043136, "chapter_id": 1963, "verse_number": "६-१२-४६", "content_sanskrit": "एतत्प्रमाणमर्कस्य निर्दिष्टमिह भारत ।\nस राहुश्छादयत्येतौ यथाकालं महात्तया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2043137, "chapter_id": 1963, "verse_number": "६-१२-४७", "content_sanskrit": "चन्द्रादित्यौ महाराज संक्षेपोऽयमुदाहृतः ।\nइत्येतत्ते महाराज पृच्छतः शास्त्रचक्षुषा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2043138, "chapter_id": 1963, "verse_number": "६-१२-४८", "content_sanskrit": "सर्वमुक्तं यथातत्त्वं तस्माच्छममवाप्नुहि ।\nयथोद्दिष्टं मया प्रोक्तं सनिर्माणमिदं जगत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2043139, "chapter_id": 1963, "verse_number": "६-१२-४९", "content_sanskrit": "तस्मादाश्वस कौरव्य पुत्रं दुर्योधनं प्रति।\nश्रुत्वेदं भरतश्रेष्ठ भूमिपर्व मनोनुगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2043140, "chapter_id": 1963, "verse_number": "६-१२-५०", "content_sanskrit": "श्रीमान्भवति राजन्यः सिद्धार्थः साधुसंमतः ।\nआयुर्बलं च कीर्तिश्च तस्य तेजश्च वर्धते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2043141, "chapter_id": 1963, "verse_number": "६-१२-५१", "content_sanskrit": "यः शृणोति महीपाल पर्वणीदं यतव्रतः ।\nप्रीयन्ते पितरस्तस्य तथैव च पितामहाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2043142, "chapter_id": 1963, "verse_number": "६-१२-५२", "content_sanskrit": "इदं तु भारतं वर्षं यत्र वर्तामहे वयम्।\nपूर्वैः प्रवर्तितं पुण्यं तत्सर्वं श्रुतवानसि ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2043143, "chapter_id": 1963, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भूमिपर्वणि द्वादशोऽध्यायः ॥ ॥ समाप्तमिदं भूमिपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]