[{"id": 7002244000, "chapter_id": 22244, "verse_number": "२८९-१", "content_sanskrit": "शालिहोत्र उवाच ।\nअश्वानां लक्षणं वक्ष्ये चिकित्साञ्चैव सुश्रुत् ।\nहीनदन्तो विदन्तश्च कराली कृष्णतालुकः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002244001, "chapter_id": 22244, "verse_number": "२८९-२", "content_sanskrit": "कृष्णजिह्वश्च यमजो जातमुष्कश्च यस्तथा ।\nद्विशफश्च तथा श्रृङ्गी त्रिवर्णो व्याघ्रवर्णकः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002244002, "chapter_id": 22244, "verse_number": "२८९-३", "content_sanskrit": "शरवर्णो भस्मवर्णो जातवर्णश्च काकुदी ।\nश्वित्री च काकसादी च खरसारस्तथैव च ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002244003, "chapter_id": 22244, "verse_number": "२८९-४", "content_sanskrit": "वानराक्षः कृष्णशटः कृष्णगुह्यस्तथैव च ।\nकृष्णप्रोथश्च यश्च तित्तिरिसन्निभः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002244004, "chapter_id": 22244, "verse_number": "२८९-५", "content_sanskrit": "विषमः श्वेतपादश्च ध्रुवावर्त्तविवर्जितः ।\nअशुभावर्त्तसंयुक्तो वर्जनीयस्तुरङ्गमः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002244005, "chapter_id": 22244, "verse_number": "२८९-६", "content_sanskrit": "रन्ध्रोपरन्ध्रयोर्द्वौ द्वौ द्वौ द्वौ मस्तकवक्षसोः ।\nप्रयाणो च ललाटे च कण्ठावर्त्ताः शुभा दश ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002244006, "chapter_id": 22244, "verse_number": "२८९-७", "content_sanskrit": "सृक्कण्याञ्च ललाटे च कर्णमूले निगालके ।\nबाहुमूले गले श्रेष्ठा आवर्त्तास्त्वशुभाः परे ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002244007, "chapter_id": 22244, "verse_number": "२८९-८", "content_sanskrit": "शुकेन्द्रगोपचन्द्राभा ये च वायससन्निभाः ।\nसुवर्णवर्णाः स्निग्धाश्च प्रशस्यास्तु सदैव हि ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002244008, "chapter_id": 22244, "verse_number": "२८९-९", "content_sanskrit": "दीर्घग्रीवाक्षिकूटाश्च ह्रस्वकर्णाश्च शोभनाः ।\nराज्ञान्तुरङ्गमा यत्र विजयं वर्जयेत्ततः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002244009, "chapter_id": 22244, "verse_number": "२८९-१०", "content_sanskrit": "पालितस्तु हयो दन्तो शुभदो दुःखदोऽन्यथा ।\nक्षियः पुत्रास्तु गन्धर्व्वा वाजिनो रत्नमुत्तमम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002244010, "chapter_id": 22244, "verse_number": "२८९-११", "content_sanskrit": "अश्वमेधे तु तुरगः पवित्रत्वात्तु हूयते ।\nवृषो निम्बवृहत्यौ च गुडूची च समाक्षिका ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002244011, "chapter_id": 22244, "verse_number": "२८९-१२", "content_sanskrit": "सिंहा गन्धकरी पिण्डी स्वेदश्च शिरसस्तथा ।\nहिङ्गु पुष्करमूलञ्च नागरं साम्लवेतसं ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002244012, "chapter_id": 22244, "verse_number": "२८९-१३", "content_sanskrit": "पिप्पलीसैन्धवयुतं शूलघ्नं चोष्णवारिणा ।\nनागरातिविषा मुस्ता सानन्ता विल्वमालिका ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002244013, "chapter_id": 22244, "verse_number": "२८९-१४", "content_sanskrit": "क्काथमेषां पिवेद्वाजी सर्व्वातीसारनाशनम् ।\nप्रियङ्गुसारिवाभ्याञ्च युक्तमाजं श्रृतं पयः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002244014, "chapter_id": 22244, "verse_number": "२८९-१५", "content_sanskrit": "पर्य्याप्तशर्करं पीत्वा श्रमाद्वाजी विमुच्यते ।\nद्रोणिकायान्तु दातव्या तैलवस्तिस्तुरङ्गमे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002244015, "chapter_id": 22244, "verse_number": "२८९-१६", "content_sanskrit": "कोष्ठजा च शिरा वेध्या तेन तस्य सुखं भवेत् ।\nदाड़िमं त्रिफला व्योषं गुड़ञ्च समभाविकम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002244016, "chapter_id": 22244, "verse_number": "२८९-१७", "content_sanskrit": "पिण्डमेतत् प्रदातव्यमश्वानां काशनाशनम् ।\nप्रियङ्गुलोध्रमधुभिः पिवेद्वृषरसं हयः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002244017, "chapter_id": 22244, "verse_number": "२८९-१८", "content_sanskrit": "क्षीरं वा पञ्चकोलाद्यं काशनाद्धि प्रमुच्यते ।\nप्रस्कन्धेषु च सर्व्वेषु श्रेय आदौ विशोधनम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002244018, "chapter_id": 22244, "verse_number": "२८९-१९", "content_sanskrit": "अभ्यङ्गोद्वर्त्तनैः स्नेहं नस्यवर्त्तिक्रमः स्मृतः ।\nज्वरितानां तुरङ्गाणां पयसैव क्रियाक्रमः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002244019, "chapter_id": 22244, "verse_number": "२८९-२०", "content_sanskrit": "लोध्रकन्धरयोर्मूलं मातुलाङ्गाग्निनागराः ।\nकुष्ठहिङ्गुवचारास्नालेपोयं शोथनाशनः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002244020, "chapter_id": 22244, "verse_number": "२८९-२१", "content_sanskrit": "मञ्जिष्ठा मधुकं द्राक्षावृहत्यौ रक्तचन्दनम् ।\nत्रपुषीवीजमूलानि श्रृङ्गाटककशेरुकम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002244021, "chapter_id": 22244, "verse_number": "२८९-२२", "content_sanskrit": "अजापयः श्रृतमिदं सुशीतं शर्करान्वितं ।\nपीत्वा नीरशनो वाजी रक्तमेहात् प्रमुच्यते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002244022, "chapter_id": 22244, "verse_number": "२८९-२३", "content_sanskrit": "मन्याहनुनिगालस्थशिराशोथो गलग्रहः ।\nअभ्यङ्गः कटुतैलेन तत्र तेष्वेव शस्यते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002244023, "chapter_id": 22244, "verse_number": "२८९-२४", "content_sanskrit": "गलग्रहगदी शोथः प्रायशो गलदेशके ।\nप्रत्यक्पुष्पी तथा वह्निः सैन्धवं सौरसो रसः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002244024, "chapter_id": 22244, "verse_number": "२८९-२५", "content_sanskrit": "कृष्णाहिङ्गुयुतैरेभिः कृत्वा नस्यं न सीदति ।\nनिशे ज्योतिष्मती पाठा कृष्णा कुष्ठं वचा मधु ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002244025, "chapter_id": 22244, "verse_number": "२८९-२६", "content_sanskrit": "जिह्वास्तम्भे च लोपोऽयं गुड़मूत्रयुतो हितः ।\nतिलैर्यष्ट्या रजन्या च निम्बपत्रैश्च योजिता ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002244026, "chapter_id": 22244, "verse_number": "२८९-२७", "content_sanskrit": "क्षौद्रेण शोधनी पिण्डी सर्पिषा व्रणरोपणी ।\nअभिघातेन खञ्जन्ति ये ह्यश्वास्तीव्रवेदनाः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002244027, "chapter_id": 22244, "verse_number": "२८९-२८", "content_sanskrit": "परिषेकक्रिया तेषां तैलेनाशु रुजापहा ।\nदोषकोपाभिघाताभ्यां पक्कभिन्ने ब्रणक्रमः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002244028, "chapter_id": 22244, "verse_number": "२८९-२९", "content_sanskrit": "अश्वत्थोडुम्बरप्लक्षमधूकवटकल्कनैः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002244029, "chapter_id": 22244, "verse_number": "२८९-३०", "content_sanskrit": "प्रभूतसलिलः क्काथः सुखोष्णो व्रणशोधनः ।\nशताह्वा नागरं रास्ना मञ्जिष्ठाकुष्ठसैन्धवैः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002244030, "chapter_id": 22244, "verse_number": "२८९-३१", "content_sanskrit": "देवदारुवचायुग्मरजनीरक्तवन्दनैः ।\nतैलसिद्धं कषायेण गुडूच्याः पयसा सह ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002244031, "chapter_id": 22244, "verse_number": "२८९-३२", "content_sanskrit": "म्रक्षणे वस्तिनश्ये च योज्यं सर्वत्र लिङ्गिने ।\nरक्तस्रावो जलौकाभिर्न्नेत्रान्ते नेत्ररोगिणः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002244032, "chapter_id": 22244, "verse_number": "२८९-३३", "content_sanskrit": "खादिरोडुम्बराश्वत्थकषायेण च साधनम् ।\nथात्रीदुरालभातिक्ताप्रियङ्गुकुङ्कुमैः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002244033, "chapter_id": 22244, "verse_number": "२८९-३४", "content_sanskrit": "गुडूच्या च कृतः कल्को हितो युक्तावलम्बिने ।\nउत्पाते च शिले श्राव्ये शुष्कशेफे तथैव च ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002244034, "chapter_id": 22244, "verse_number": "२८९-३५", "content_sanskrit": "क्षिप्रकारिणि दोषे च सद्यो विदलमिष्यते ।\nगोशकृन्मञ्जिकाकुष्ठरजनीतिलसर्षपैः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002244035, "chapter_id": 22244, "verse_number": "२८९-३६", "content_sanskrit": "गवां मूत्रेण पिष्टैश्च मर्द्दनं कण्डुनाशनम् ।\nशीतो मधुयुतः क्काथो नाशिकायां सशर्करः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002244036, "chapter_id": 22244, "verse_number": "२८९-३७", "content_sanskrit": "रक्तपित्तहरः पानादश्वकर्णैस्तथैव च ।\nसप्तमे सप्तमे देयमश्वानां लवणं दिने ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002244037, "chapter_id": 22244, "verse_number": "२८९-३८", "content_sanskrit": "तथा भुक्तवतान्देया अतिपाने तु वारुणी ।\nदीवनीयैः समधुरैर्मृद्वीकाशर्करायुतैः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002244038, "chapter_id": 22244, "verse_number": "२८९-३९", "content_sanskrit": "सपिप्पलीकैः शरदि प्रतिपानं सपद्मकैः ।\nविड़ङ्गापिप्पलीधान्यशताह्वालोध्रसैनधवैः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002244039, "chapter_id": 22244, "verse_number": "२८९-४०", "content_sanskrit": "सचित्रकैस्तुरङ्गाणं प्रतिपानं हिमागमे ।\nलोध्रपिरियङ्गुकामुस्तापिप्पलीविश्वभेषजै ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002244040, "chapter_id": 22244, "verse_number": "२८९-४१", "content_sanskrit": "सक्षौद्रैः प्रतिपानं स्याद्वसन्ते कफनाशनम् ।\nप्रियङ्गुपिप्पलीलोध्रयष्ट्याक्षैः समहौषधैः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002244041, "chapter_id": 22244, "verse_number": "२८९-४२", "content_sanskrit": "निदाघे सगुड़ा देया मदिरा प्रतिपानके ।\nलोध्रकाष्ठं सलवणं पिप्पल्यो विश्वभेषजम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002244042, "chapter_id": 22244, "verse_number": "२८९-४३", "content_sanskrit": "प्रावृड्भिन्नपुरीषाश्च पिवेयुर्वाजिनो घृतम् ।\nपिवेयुर्वाजिनस्तैलं कफवाय्वधिकास्तु ये ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002244043, "chapter_id": 22244, "verse_number": "२८९-४४", "content_sanskrit": "प्रावृड्भिन्नपुरीषाश्च पिवेयुर्वाजिनो घृतम् ।\nपिवेयुर्वाजिनस्तैलं कफवाय्वधिकास्तु ये ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002244044, "chapter_id": 22244, "verse_number": "२८९-४५", "content_sanskrit": "स्रेहव्यापद्भ्वो येषां कार्य्यं तेषां विरूक्षणम् ।\nत्र्यहं यवागू रूक्षा स्याद् भोजनं तक्रसंयुतम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002244045, "chapter_id": 22244, "verse_number": "२८९-४६", "content_sanskrit": "शरन्निदाघ्योः सर्पिस्तैलं शीतवसन्तयोः ।\nवर्षासु शिशिरे चैव वस्तौ यमकमिष्यते ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002244046, "chapter_id": 22244, "verse_number": "२८९-४७", "content_sanskrit": "गुर्वभिष्यन्दिभक्तानि व्यायामं स्नानमातपम् ।\nवायुवर्जञ्च वाहस्य स्नेहपीतस्य वर्जितम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002244047, "chapter_id": 22244, "verse_number": "२८९-४८", "content_sanskrit": "स्नानं पानं शकृत्क्रूष्ठमश्वानां सलिलागमे ।\nअत्यर्थं दुर्द्दिने काले पानमेकं प्रशस्यते ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002244048, "chapter_id": 22244, "verse_number": "२८९-४९", "content_sanskrit": "युक्तशीतातपे काले द्विःपानं स्नपनं सकृत् ।\nग्रीष्मे त्रिस्नानपानं स्याच्चिरं तस्यावगाहनम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002244049, "chapter_id": 22244, "verse_number": "२८९-५०", "content_sanskrit": "निस्तुषाणां प्रदातव्या यवानां चतुराढकी ।\nचणकव्रीहिमौद्गानि कलायं वापि दापयेत् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002244050, "chapter_id": 22244, "verse_number": "२८९-५१", "content_sanskrit": "अहोरात्रेण चार्द्धस्य यवसस्य तुला दश ।\nअष्टौ शुष्कस्य दातव्याश्चतस्रोऽथ वुषस्य वा ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002244051, "chapter_id": 22244, "verse_number": "२८९-५२", "content_sanskrit": "दूर्वा पित्तं यवः कासं वुषश्च श्लेष्मसञ्चयम् ।\nनाशयत्यर्जुनः श्वासं तथा मानो बलक्षयम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002244052, "chapter_id": 22244, "verse_number": "२८९-५३", "content_sanskrit": "वातिकाः पैत्तिकाश्चैव श्लेष्मजाः सान्निपातिकाः ।\nन रोगाः पीडयिष्यन्ति दूर्वाहारन्तुरङ्गमम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002244053, "chapter_id": 22244, "verse_number": "२८९-५४", "content_sanskrit": "द्वौ रज्जुबन्धौ दुष्टानां पक्षयोरुभयोरपि ।\nपश्चाद्धनुस्च कर्त्तर्व्यो दूरकीलव्यपाश्रयः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002244054, "chapter_id": 22244, "verse_number": "२८९-५५", "content_sanskrit": "वासेयुस्त्वास्तृते स्थाने कृतधूपनभूमयः ।\nयत्नोपन्यस्तयवसाः सप्रदीपाः सुरक्षिता ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002244055, "chapter_id": 22244, "verse_number": "२८९-५६", "content_sanskrit": "कृकवाक्कजकपयो धार्य्याश्चाश्वगृहे मृगाः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]