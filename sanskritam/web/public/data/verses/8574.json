[{"id": 900007564, "chapter_id": 8574, "verse_number": "155.1", "content_sanskrit": "कामा येऽस्य हृदि श्रिताः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900007565, "chapter_id": 8574, "verse_number": "155.2", "content_sanskrit": "हृद्येव तेषां श्रयणमिति पक्षो न भासते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900007566, "chapter_id": 8574, "verse_number": "155.3", "content_sanskrit": "अतोऽकामहतत्वं तु मुक्तानामेव मुख्यतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900007567, "chapter_id": 8574, "verse_number": "155.4", "content_sanskrit": "मुख्यार्थस्य वृथा त्यागो मायिनामेव भूषणम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900007568, "chapter_id": 8574, "verse_number": "155.5", "content_sanskrit": "अपापत्वमदुःखत्वं चावृजिनत्वमिहोदितम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900007569, "chapter_id": 8574, "verse_number": "155.6", "content_sanskrit": "अपापत्वं च नैवास्ति यावत्संसारमस्य हि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900007570, "chapter_id": 8574, "verse_number": "155.7", "content_sanskrit": "तस्मात्तस्मादकामत्वमिति चाश्रुतकल्पना", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900007571, "chapter_id": 8574, "verse_number": "155.8", "content_sanskrit": "तस्मात्तस्मादकामत्वमिति चाश्रुतकल्पना", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900007572, "chapter_id": 8574, "verse_number": "155.9", "content_sanskrit": "कुत्रचित्कामिनः पुंसः कामाभावात्क्वचित्क्वचित्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900007573, "chapter_id": 8574, "verse_number": "155.10", "content_sanskrit": "तस्मादमुक्तसुखगं तारतम्यं पृथक् पृथक्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900007574, "chapter_id": 8574, "verse_number": "155.11", "content_sanskrit": "राद्धः संसिद्ध इत्येव मुक्त एवावगम्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900007575, "chapter_id": 8574, "verse_number": "155.12", "content_sanskrit": "साधुना विष्णुना युक्तो मुक्तः साधुयुवा मतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900007576, "chapter_id": 8574, "verse_number": "155.13", "content_sanskrit": "तस्येयं पृथिवीत्यादि पूर्वभावव्यपेक्षया", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900007577, "chapter_id": 8574, "verse_number": "155.14", "content_sanskrit": "स एक इति संसारगतमुक्त्वा सुखं पुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900007578, "chapter_id": 8574, "verse_number": "155.15", "content_sanskrit": "संसारगाच्च संसारगतस्यैव शताधिकम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900007579, "chapter_id": 8574, "verse_number": "155.16", "content_sanskrit": "युक्तं स्याच्छत्युक्तमभिवीक्षतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900007580, "chapter_id": 8574, "verse_number": "155.17", "content_sanskrit": "युक्तं च साधनाधिक्या