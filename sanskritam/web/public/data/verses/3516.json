[{"id": 2116854, "chapter_id": 3516, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2116855, "chapter_id": 3516, "verse_number": "१", "content_sanskrit": "ततस्ते पाण्डवाः सर्वे पाञ्चाल्यश्च महारथः ।\nप्रत्युत्थाय महात्मानं कृष्णं दृष्ट्वाऽभ्यपूजयन्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2116856, "chapter_id": 3516, "verse_number": "२", "content_sanskrit": "आसने काञ्चने शुभ्रे निषसाद महामुनिः ।\nअभिनन्द्य च तान् सर्वान् पृष्ट्वा च कुशलं हि सः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2116857, "chapter_id": 3516, "verse_number": "३", "content_sanskrit": "अनुज्ञातास्तु ते सर्वे कृष्णेनामिततेजसा ।\nआसनेषु यथार्हेषु निषेदुर्द्विपदां वराः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2116858, "chapter_id": 3516, "verse_number": "४", "content_sanskrit": "ततो मुहूर्तं मधुरां वाचमुच्चार्य पार्षतः ।\nपप्रच्छ तं महात्मानं द्रौपद्यर्थं महामुनिम् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2116859, "chapter_id": 3516, "verse_number": "५", "content_sanskrit": "कथमेका बहूनां स्यान्न च स्याद् धर्मसङ्करः ।\nएतन्नो भगवान् सर्वं प्रब्रवीतु यथातथम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2116860, "chapter_id": 3516, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2116861, "chapter_id": 3516, "verse_number": "६", "content_sanskrit": "अस्मिन् धर्मे विप्रलव्धे लोकवेदविरोधिते ।\nयस्य यस्य मतं यद्यच्छ्रोतुमिच्छामि तस्य तत् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2116862, "chapter_id": 3516, "verse_number": "", "content_sanskrit": "द्रुपदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2116863, "chapter_id": 3516, "verse_number": "७", "content_sanskrit": "अधर्मोऽयं मम मतो विरुद्धो लोकवेदयोः ।\nन ह्येका विद्यते पत्नी बहूनां द्विजसत्तम \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2116864, "chapter_id": 3516, "verse_number": "८", "content_sanskrit": "न चाप्याचरितः पूर्वैरयं धर्मो महात्मभिः ।\nन च धर्मोऽप्यनेकस्थश्चरितव्यः सनातनः \t॥ ८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2116865, "chapter_id": 3516, "verse_number": "९", "content_sanskrit": "अतो नाहं करोम्येनं व्यवसायं सुतां प्रति ।\nधर्मसन्देहसन्दिग्धं प्रतिभातीह मामिदम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2116866, "chapter_id": 3516, "verse_number": "", "content_sanskrit": "धृष्टद्युम्नः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2116867, "chapter_id": 3516, "verse_number": "१०", "content_sanskrit": "यवीयसः कथं भार्यां ज्येष्ठो भ्राता द्विजर्षभ ।\nब्रह्मन् समभिवर्तेत सद्वृत्तः संस्तपोधन \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2116868, "chapter_id": 3516, "verse_number": "११", "content_sanskrit": "न तु धर्मस्य सूक्ष्मत्वाद् गतिं वेद्मि कथञ्चन ।\nअधर्मो धर्म इति वा व्यवसायो न शक्यते \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2116869, "chapter_id": 3516, "verse_number": "१२", "content_sanskrit": "कर्तुमस्मद्विधैर्ब्रह्मन्नतो न व्यवसाम्यहम् ।\nपञ्चानां महिषी कृष्णा भवत्विति कथञ्चन \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2116870, "chapter_id": 3516, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2116871, "chapter_id": 3516, "verse_number": "१३", "content_sanskrit": "न मे वागनृतं प्राह नाधर्मे धीयते मतिः ।\nवर्तते च मनो मेऽत्र नैषोऽधर्मः कथञ्चन \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2116872, "chapter_id": 3516, "verse_number": "१४", "content_sanskrit": "श्रूयते हि पुराणेषु जटिलो नाम गौतमः ।\nतस्य पुत्री महाप्राज्ञी गौतमस्य यशस्विनी \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2116873, "chapter_id": 3516, "verse_number": "१५", "content_sanskrit": "ऋषीनध्यासितवती सप्त धर्मभृतां वरान् ।\nतथैव मुनिजा वार्क्षी तपोभिर्भावितान् मुनीन्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2116874, "chapter_id": 3516, "verse_number": "१६", "content_sanskrit": "दशाभजदृषीन् भ्रातॄनेकनाम्नः प्रचेतसः ।\nगुरोश्च वचनं प्राहुर्धर्म्यं धर्मभृतां वराः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2116875, "chapter_id": 3516, "verse_number": "१७", "content_sanskrit": "गुरूणां चैव सर्वेषां जनित्री परमो गुरुः ।\nसा चाप्युक्तवती चास्मान् भैक्षवद् भुज्यतामिति ।\nतस्मादेतदहं मन्ये परं धर्मं द्विजोत्तम \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2116876, "chapter_id": 3516, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2116877, "chapter_id": 3516, "verse_number": "१८", "content_sanskrit": "एवमेतद् यथाऽऽहाहं धर्मचारी युधिष्ठिरः ।\nभुज्यतां भ्रातृभिः सार्धमित्यर्जुनमचोदयम् ।\nअनृतान्मे भयं तीव्रं मुच्येऽहमनृतात् कथम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2116878, "chapter_id": 3516, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2116879, "chapter_id": 3516, "verse_number": "१९", "content_sanskrit": "अनृतान्मोक्ष्यसे भद्रे धर्मश्चैष सनातनः ।\nननु वक्ष्यामि सर्वेषां पाञ्चाल शृणु मे वचः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2116880, "chapter_id": 3516, "verse_number": "२०", "content_sanskrit": "यथाऽयं विहितो धर्मो यतश्चायं सनातनः ।\nयथा चाप्याह कौन्तेयस्तथा धर्मो न संशयः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2116881, "chapter_id": 3516, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2116882, "chapter_id": 3516, "verse_number": "२१", "content_sanskrit": "तत उत्थाय भगवान् कृष्णद्वैपायनः प्रभुः ।\nकरे गृहीत्वा राजानं राजवेश्म समाविशत् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2116883, "chapter_id": 3516, "verse_number": "२२", "content_sanskrit": "पाण्डवास्त्वथ कुन्ती च धृष्टद्युम्नश्च पार्षतः ।\nनानाकथाभिस्ते सर्वे प्रतीक्षन्ते स्म तावुभौ \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2116884, "chapter_id": 3516, "verse_number": "२३", "content_sanskrit": "ततो द्वैपायनस्तस्मै नरेन्द्राय विशाम्पते ।\nआचख्यौ तद्यथा धर्मो बहूनामेकपत्निता \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2116885, "chapter_id": 3516, "verse_number": "२४", "content_sanskrit": "यथा देवा ददुश्चैव राजपुत्र्याः पुरा वरम् ।\nधर्माद्यास्तपसा तुष्टाः पञ्चपत्नीत्वमीश्वराः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2116886, "chapter_id": 3516, "verse_number": "१९५", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nपञ्चनवत्यधिकशततमोऽध्यायः ॥१९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2116887, "chapter_id": 3516, "verse_number": "४", "content_sanskrit": "॥ इति वैवाहिकपर्वणि चतुर्थोऽध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2116888, "chapter_id": 3516, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]