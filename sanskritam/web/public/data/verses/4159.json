[{"id": 2146438, "chapter_id": 4159, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2146439, "chapter_id": 4159, "verse_number": "१", "content_sanskrit": "पृथामामन्त्र्य गोविन्दः कृत्वा चापि प्रदक्षिणम् ।\nदुर्योधनगृहं शौरिरभ्यगच्छदरिन्दमः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2146440, "chapter_id": 4159, "verse_number": "२", "content_sanskrit": "लक्ष्म्या परमया युक्तं पुरन्दरगृहोपमम् ।\nविचित्रैरासनैर्युक्तं प्रविवेश जनार्दनः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2146441, "chapter_id": 4159, "verse_number": "३", "content_sanskrit": "तस्य कक्ष्या व्यतिक्रम्य तिस्रो द्वाःस्थैरवारितः ।\nततोऽभ्रघनसङ्काशं गिरिकूटमिवोच्छ्रितम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2146442, "chapter_id": 4159, "verse_number": "४", "content_sanskrit": "श्रिया ज्वलन्तं प्रासादमारुरोह महायशाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2146443, "chapter_id": 4159, "verse_number": "५", "content_sanskrit": "तत्र राजसहस्रैश्च कुरुभिश्चापि संवृतम् ।\nधार्तराष्ट्रं महाबाहुं ददर्शासीनमासने\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2146444, "chapter_id": 4159, "verse_number": "६", "content_sanskrit": "दुःशासनं च कर्णं च शकुनिं चापि सौबलम् ।\nदुर्योधनसमीपे तान् आसनस्थान् ददर्श सः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2146445, "chapter_id": 4159, "verse_number": "७", "content_sanskrit": "अभ्यागच्छति दाशार्हे धार्तराष्ट्रो महामनाः ।\nउदतिष्ठत् सहामात्यः पूजयन् मधुसूदनम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2146446, "chapter_id": 4159, "verse_number": "८", "content_sanskrit": "समेत्य धार्तराष्ट्रेण सामात्येन परन्तपः ।\nराजभिस्तत्र वार्ष्णेयः समागच्छद् यथावयः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2146447, "chapter_id": 4159, "verse_number": "९", "content_sanskrit": "तत्र जाम्बूनदमयं पर्यङ्कं सुपरिष्कृतम् ।\nविविधास्तरणास्तीर्णमाविवेश गदाग्रजः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2146448, "chapter_id": 4159, "verse_number": "१०", "content_sanskrit": "तस्मै गां मधुपर्कं च उदकं च जनार्दने ।\nनिवेदयामास तदा गृहान् राज्यं च कौरवः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2146449, "chapter_id": 4159, "verse_number": "११", "content_sanskrit": "आसनं सर्वतोभद्रं सर्वरत्नविभूषितम् ।\nकृष्णार्थमेव संसिद्धं धार्तराष्ट्रस्य शासनात्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2146450, "chapter_id": 4159, "verse_number": "१२", "content_sanskrit": "तत्र गोविन्दमासीनं प्रसन्नादित्यवर्चसम् ।\nउपासाञ्चक्रिरे सर्वे कुरवो राजभिः सह\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2146451, "chapter_id": 4159, "verse_number": "१३", "content_sanskrit": "ततो दुर्योधनो राजा वार्ष्णेयं जयतां वरम् ।\nन्यमन्त्रयद् भोजनेन नाभ्यनन्दच्च केशवः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2146452, "chapter_id": 4159, "verse_number": "१४", "content_sanskrit": "ततो दुर्योधनः कृष्णमब्रवीत् कुरुसंसदि ।\nमृदुपूर्वं शठोदर्कं कर्णमाभाष्य कौरवः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2146453, "chapter_id": 4159, "verse_number": "१५", "content_sanskrit": "कस्मादन्नानि पानानि वासांसि शयनानि च ।\nत्वदर्थमुपनीतानि नाभुङ्क्थास्त्वं जनार्दन\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2146454, "chapter_id": 4159, "verse_number": "१६", "content_sanskrit": "भीष्मद्रोणावतिक्रम्य मां चैव मधुसूदन ।\nकिमर्थं पुण्डरीकाक्ष भुक्तं वृषलभोजनम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2146455, "chapter_id": 4159, "verse_number": "१७", "content_sanskrit": "उभयोश्च ददत् साह्यमुभयोश्च हिते रतः ।\nसम्बन्धी दयितश्चासि धृतराष्ट्रस्य माधव\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2146456, "chapter_id": 4159, "verse_number": "१८", "content_sanskrit": "त्वं हि गोविन्द धर्मार्थौ वेत्थ तत्त्वेन सर्वशः ।\nतत्र कारणमिच्छामि श्रोतुं तव जनार्दन\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2146457, "chapter_id": 4159, "verse_number": "१९", "content_sanskrit": "स एवमुक्तो गोविन्दः प्रत्युवाच महामनाः ।\nओघमेघस्वनः काले प्रगृह्य विपुलं भुजम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2146458, "chapter_id": 4159, "verse_number": "२०", "content_sanskrit": "अनम्बूकृतमत्रस्तमनिस्तमसकुण्डलः ।\nराजीवनेत्रो राजानं हेतुमद्वाक्यमुत्तमम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2146459, "chapter_id": 4159, "verse_number": "२१", "content_sanskrit": "कृतार्था भुञ्जते दूताः पूजां गृह्णन्ति चैव हि ।\nकृतार्थं मां सहामात्यं समर्चिष्यसि भारत\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2146460, "chapter_id": 4159, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2146461, "chapter_id": 4159, "verse_number": "२२", "content_sanskrit": "एवमुक्तः प्रत्युवाच धार्तराष्ट्रो जनार्दनम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2146462, "chapter_id": 4159, "verse_number": "२३", "content_sanskrit": "न युक्तं भवताऽस्मासु प्रतिवक्तुमसाम्प्रतम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2146463, "chapter_id": 4159, "verse_number": "२४", "content_sanskrit": "कृतार्थं वाऽकृतार्थं वा त्वां वयं मधुसूदन ।\nयतामहे पूजयितुं दाशार्ह न च शक्नुमः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2146464, "chapter_id": 4159, "verse_number": "२५", "content_sanskrit": "न च तत्कारणं विद्मो यस्मान्नो मधुसूदन ।\nपूजां कृतां प्रीयमाणैर्न भुञ्जीथाः परन्तप\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2146465, "chapter_id": 4159, "verse_number": "२६", "content_sanskrit": "वैरं नो नास्ति भवता गोविन्द न च विग्रहः ।\nस भवान् प्रसमीक्ष्यैतन्नेदृशं वक्तुमर्हति\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2146466, "chapter_id": 4159, "verse_number": "२७", "content_sanskrit": "एवमुक्तः प्रत्युवाच धार्तराष्ट्रं जनार्दनः ।\nअभिवीक्ष्य सहामात्यं दाशार्हः प्रहसन्निव\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2146467, "chapter_id": 4159, "verse_number": "२८", "content_sanskrit": "नाहं कामान्न संरम्भान्न द्वेषान्नार्थकारणात् ।\nन हेतुवादाल्लोभाद्वा धर्मं जह्यां कथञ्चन\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2146468, "chapter_id": 4159, "verse_number": "२९", "content_sanskrit": "सम्प्रीतिभोज्यान्यन्नानि आपद्भोज्यानि वा पुनः ।\nन च सम्प्रीयसे राजन् न चैवापद्गता वयम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2146469, "chapter_id": 4159, "verse_number": "३०", "content_sanskrit": "अकस्माद् द्विषसे राजन् जन्मप्रभृति पाण्डवान् ।\nप्रियानुवर्तिनो भ्रातॄन् सर्वैः समुदितान् गुणैः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2146470, "chapter_id": 4159, "verse_number": "३१", "content_sanskrit": "अकस्माच्चैव पार्थानां द्वेषणं नोपपद्यते ।\nधर्मे स्थिताः पाण्डवेयाः कस्तान् किं वक्तुमर्हति\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2146471, "chapter_id": 4159, "verse_number": "३२", "content_sanskrit": "यस्तान् द्वेष्टि स मां द्वेष्टि यस्ताननु स मामनु ।\nऐकात्म्यं मां गतं विद्धि पाण्डवैर्धर्मचारिभिः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2146472, "chapter_id": 4159, "verse_number": "३३", "content_sanskrit": "कामक्रोधानुवर्ती हि यो मोहाद् विरुरुत्सते ।\nगुणवन्तं च यो द्वेष्टि तमाहुः पुरुषाधमम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2146473, "chapter_id": 4159, "verse_number": "३४", "content_sanskrit": "यः कल्याणगुणं राजन् मोहान्नोत दिदृक्षते ।\nसोऽजितात्माऽजितक्रोधो न चिरं तिष्ठते श्रिया\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2146474, "chapter_id": 4159, "verse_number": "३५", "content_sanskrit": "अथ यो गुणसम्पन्नान् हृदयस्याप्रियानपि ।\nप्रियेण कुरुते वश्यान् चिरं यशसि तिष्ठति\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2146475, "chapter_id": 4159, "verse_number": "३६", "content_sanskrit": "द्विषदन्नं न भोक्तव्यं द्विषन्तं नैव भोजयेत् ।\nपाण्डवान् द्विषसे राजन् मम प्राणा हि पाण्डवाः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2146476, "chapter_id": 4159, "verse_number": "३७", "content_sanskrit": "सर्वमेतन्न भोक्तव्यमन्नं दुष्टाभिसंहितम् ।\nक्षत्तुरेकस्य भोक्तव्यमिति मे धीयते मतिः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2146477, "chapter_id": 4159, "verse_number": "३८", "content_sanskrit": "एवमुक्त्वा महाबाहुः दुर्योधनममर्षणम् ।\nनिश्चक्राम ततः शुभ्राद् धार्तराष्ट्रनिवेशनात्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2146478, "chapter_id": 4159, "verse_number": "३९", "content_sanskrit": "निर्याय च महाबाहुः वासुदेवो महामनाः ।\nनिवेशाय ययौ वेश्म विदुरस्य महात्मनः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2146479, "chapter_id": 4159, "verse_number": "४०", "content_sanskrit": "तमभ्यगच्छद् द्रोणश्च कृपो भीष्मोऽथ बाह्लिकः ।\nकुरवश्च महाबाहुं विदुरस्य गृहातिथिम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2146480, "chapter_id": 4159, "verse_number": "४१", "content_sanskrit": "तेऽभिगम्याब्रुवंस्तत्र कुरवो मधुसूदनम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2146481, "chapter_id": 4159, "verse_number": "४२", "content_sanskrit": "निवेदयामो वार्ष्णेय सरत्नांस्ते गृहान् वयम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2146482, "chapter_id": 4159, "verse_number": "४३", "content_sanskrit": "तानुवाच महातेजाः कौरवान् मधुसूदनः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2146483, "chapter_id": 4159, "verse_number": "४४", "content_sanskrit": "सर्वे भवन्तो गच्छन्तु सर्वा मेऽपचितिः कृता\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2146484, "chapter_id": 4159, "verse_number": "४५", "content_sanskrit": "यातेषु कुरुषु क्षत्ता दाशार्हमपराजितम् ।\nअभ्यर्चयामास तदा सर्वकामैरुपस्थितः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2146485, "chapter_id": 4159, "verse_number": "४६", "content_sanskrit": "ततः क्षत्ताऽन्नपानानि शुचीनि गुणवन्ति च ।\nउपाहरदनेकानि केशवाय महात्मने\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2146486, "chapter_id": 4159, "verse_number": "४७", "content_sanskrit": "तैस्तर्पयित्वा प्रथमं ब्राह्मणान् मधुसूदनः ।\nवेदविद्भ्यो ददौ कृष्णः परमद्रविणान्यपि\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2146487, "chapter_id": 4159, "verse_number": "४८", "content_sanskrit": "भुक्तवत्सु द्विजाग्र्येषु निषण्णेषु वरासने ।\nशुचिः सुप्रयतो भूत्वा विदुरोऽन्नमुपाहरत्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2146488, "chapter_id": 4159, "verse_number": "४९", "content_sanskrit": "श्रद्धया परया युक्त इदं वचनमब्रवीत्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2146489, "chapter_id": 4159, "verse_number": "५०", "content_sanskrit": "सम्भ्रमैस्तुष्य गोविन्द एतन्नः परमं धनम् ।\nअन्यथा हि विशेषेण कस्त्वामर्चितुमर्हति\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2146490, "chapter_id": 4159, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2146491, "chapter_id": 4159, "verse_number": "५१", "content_sanskrit": "ततोऽनुयायिभिः सार्धं निषण्णः परमासने ।\nविदुरान्नानि बुभुजे शुचीनि गुणवन्ति च\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2146492, "chapter_id": 4159, "verse_number": "५२", "content_sanskrit": "तं भुक्तवन्तं विविधाः सुशब्दाः सूतमागधाः ।\nअभितुष्टुवुरासीनं दाशार्हमपराजितम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2146493, "chapter_id": 4159, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि नवतितमोऽध्यायः ॥९०॥\nभगवद्यानपर्वणि एकविंशोऽध्यायः ॥२१॥\n–– ० ––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]