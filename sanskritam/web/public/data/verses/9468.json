[{"id": 5000468000, "chapter_id": 9468, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे एकषष्टितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000468001, "chapter_id": 9468, "verse_number": "६-६१-१", "content_sanskrit": "ततो रामो महातेजा धनुरादाय वीर्यवान्।\nकिरीटिनं महाकायं कुम्भकर्णं ददर्श ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000468002, "chapter_id": 9468, "verse_number": "६-६१-२", "content_sanskrit": "तं दृष्ट्वा राक्षसश्रेष्ठं पर्वताकारदर्शनम्।\nक्रममाणमिवाकाशं पुरा नारायणं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000468003, "chapter_id": 9468, "verse_number": "६-६१-३", "content_sanskrit": "सतोयाम्बुदसंकाशं काञ्चनाङ्गदभूषणम्।\nदृष्ट्वा पुनः प्रदुद्राव वानराणां महाचमूः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000468004, "chapter_id": 9468, "verse_number": "६-६१-४", "content_sanskrit": "विद्रुतां वाहिनीं दृष्ट्वा वर्धमानं च राक्षसम्।\nसविस्मितमिदं रामो विभीषणमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000468005, "chapter_id": 9468, "verse_number": "६-६१-५", "content_sanskrit": "कोऽसौ पर्वतसंकाशः किरीटी हरिलोचनः।\nलङ्कायां दृश्यते वीरः सविद्युदिव तोयदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000468006, "chapter_id": 9468, "verse_number": "६-६१-६", "content_sanskrit": "पृथिव्यां केतुभूतोऽसौ महानेकोऽत्र दृश्यते।\nयं दृष्ट्वा वानराः सर्वे विद्रवन्ति ततस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000468007, "chapter_id": 9468, "verse_number": "६-६१-७", "content_sanskrit": "आचक्ष्व सुमहान् कोऽसौ रक्षो वा यदि वासुरः।\nन मयैवंविधं भूतं दृष्टपूर्वं कदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000468008, "chapter_id": 9468, "verse_number": "६-६१-८", "content_sanskrit": "सम्पृष्टो राजपुत्रेण रामेणाक्लिष्टकर्मणा।\nविभीषणो महाप्राज्ञः काकुत्स्थमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000468009, "chapter_id": 9468, "verse_number": "६-६१-९", "content_sanskrit": "येन वैवस्वतो युद्धे वासवश्च पराजितः।\nसैष विश्रवसः पुत्रः कुम्भकर्णः प्रतापवान्।\nअस्य प्रमाणसदृशो राक्षसोऽन्यो न विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000468010, "chapter_id": 9468, "verse_number": "६-६१-१०", "content_sanskrit": "एतेन देवा युधि दानवाश्च\nयक्षा भुजंगाः पिशिताशनाश्च।\nगन्धर्वविद्याधरकिंनराश्च\nसहस्रशो राघव सम्प्रभग्नाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000468011, "chapter_id": 9468, "verse_number": "६-६१-११", "content_sanskrit": "शूलपाणिं विरूपाक्षं कुम्भकर्णं महाबलम्।\nहन्तुं न शेकुस्त्रिदशाः कालोऽयमिति मोहिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000468012, "chapter_id": 9468, "verse_number": "६-६१-१२", "content_sanskrit": "प्रकृत्या ह्येष तेजस्वी कुम्भकर्णो महाबलः।\nअन्येषां राक्षसेन्द्राणां वरदानकृतं बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000468013, "chapter_id": 9468, "verse_number": "६-६१-१३", "content_sanskrit": "बालेन जातमात्रेण क्षुधार्तेन महात्मना।\nभक्षितानि सहस्राणि प्रजानां सुबहून्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000468014, "chapter_id": 9468, "verse_number": "६-६१-१४", "content_sanskrit": "तेषु सम्भक्ष्यमाणेषु प्रजा भयनिपीडिताः।\nयान्त स्म शरणं शक्रं तमप्यर्थं न्यवेदयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000468015, "chapter_id": 9468, "verse_number": "६-६१-१५", "content_sanskrit": "स कुम्भकर्णं कुपितो महेन्द्रो\nजघान वज्रेण शितेन वज्री।\nस शक्रवज्राभिहतो महात्मा\nचचाल कोपाच्च भृशं ननाद ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000468016, "chapter_id": 9468, "verse_number": "६-६१-१६", "content_sanskrit": "तस्य नानद्यमानस्य कुम्भकर्णस्य रक्षसः।\nश्रुत्वा निनादं वित्रस्ताः प्रजा भूयो वितत्रसुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000468017, "chapter_id": 9468, "verse_number": "६-६१-१७", "content_sanskrit": "ततः क्रुद्धो महेन्द्रस्य कुम्भकर्णो महाबलः।\nनिष्कृष्यैरावताद् दन्तं जघानोरसि वासवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000468018, "chapter_id": 9468, "verse_number": "६-६१-१८", "content_sanskrit": "कुम्भकर्णप्रहारार्तो विजज्वाल स वासवः।\nततो विषेदुः सहसा देवा ब्रह्मर्षिदानवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000468019, "chapter_id": 9468, "verse_number": "६-६१-१९", "content_sanskrit": "प्रजाभिः सह शक्रश्च ययौ स्थानं स्वयंभुवः।\nकुम्भकर्णस्य दौरात्म्यं शशंसुस्ते प्रजापतेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000468020, "chapter_id": 9468, "verse_number": "६-६१-२०", "content_sanskrit": "प्रजानां भक्षणं चापि देवानां चापि धर्षणम्।\nआश्रमध्वंसनं चापि परस्त्रीहरणं भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000468021, "chapter_id": 9468, "verse_number": "६-६१-२१", "content_sanskrit": "एवं प्रजा यदि त्वेष भक्षयिष्यति नित्यशः।\nअचिरेणैव कालेन शून्यो लोको भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000468022, "chapter_id": 9468, "verse_number": "६-६१-२२", "content_sanskrit": "वासवस्य वचः श्रुत्वा सर्वलोकपितामहः।\nरक्षांस्यावाहयामास कुम्भकर्णं ददर्श ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000468023, "chapter_id": 9468, "verse_number": "६-६१-२३", "content_sanskrit": "कुम्भकर्णं समीक्ष्यैव वितत्रास प्रजापतिः।\nकुम्भकर्णमथाश्वास्तः स्वयंभूरिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000468024, "chapter_id": 9468, "verse_number": "६-६१-२४", "content_sanskrit": "ध्रुवं लोकविनाशाय पौलस्त्येनासि निर्मितः।\nतस्मात् त्वमद्यप्रभृति मृतकल्पः शयिष्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000468025, "chapter_id": 9468, "verse_number": "६-६१-२५", "content_sanskrit": "ब्रह्मशापाभिभूतोऽथ निपपाताग्रतः प्रभोः।\nततः परमसम्भ्रान्तो रावणो वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000468026, "chapter_id": 9468, "verse_number": "६-६१-२६", "content_sanskrit": "प्रवृद्धः काञ्चनो वृक्षः फलकाले निकृत्यते।\nन नप्तारं स्वकं न्याय्यं शप्तुमेवं प्रजापते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000468027, "chapter_id": 9468, "verse_number": "६-६१-२७", "content_sanskrit": "न मिथ्यावचनश्च त्वं स्वप्स्यत्येव न संशयः।\nकालस्तु क्रियतामस्य शयने जागरे तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000468028, "chapter_id": 9468, "verse_number": "६-६१-२८", "content_sanskrit": "रावणस्य वचः श्रुत्वा स्वयंभूरिदमब्रवीत्।\nशयिता ह्येष षण्मासमेकाहं जागरिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000468029, "chapter_id": 9468, "verse_number": "६-६१-२९", "content_sanskrit": "एकेनाह्ना त्वसौ वीरश्चरन् भूमिं बुभुक्षितः।\nव्यात्तास्यो भक्षयेल्लोकान् संवृद्ध इव पावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000468030, "chapter_id": 9468, "verse_number": "६-६१-३०", "content_sanskrit": "सोऽसौ व्यसनमापन्नः कुम्भकर्णमबोधयत्।\nत्वत्पराक्रमभीतश्च राजा सम्प्रति रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000468031, "chapter_id": 9468, "verse_number": "६-६१-३१", "content_sanskrit": "स एष निर्गतो वीरः शिबिराद् भीमविक्रमः।\nवानरान् भृशसंक्रुद्धो भक्षयन् परिधावति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000468032, "chapter_id": 9468, "verse_number": "६-६१-३२", "content_sanskrit": "कुम्भकर्णं समीक्ष्यैव हरयोऽद्य प्रदुद्रुवुः।\nकथमेनं रणे क्रुद्धं वारयिष्यन्ति वानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000468033, "chapter_id": 9468, "verse_number": "६-६१-३३", "content_sanskrit": "उच्यन्तां वानराः सर्वे यन्त्रमेतत् समुच्छ्रितम्।\nइति विज्ञाय हरयो भविष्यन्तीह निर्भयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000468034, "chapter_id": 9468, "verse_number": "६-६१-३४", "content_sanskrit": "विभीषणवचः श्रुत्वा हेतुमत् सुमुखोद‍्गतम्।\nउवाच राघवो वाक्यं नीलं सेनापतिं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000468035, "chapter_id": 9468, "verse_number": "६-६१-३५", "content_sanskrit": "गच्छ सैन्यानि सर्वाणि व्यूह्य तिष्ठस्व पावके।\nद्वाराण्यादाय लङ्कायाश्चर्याश्चास्याथ संक्रमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000468036, "chapter_id": 9468, "verse_number": "६-६१-३६", "content_sanskrit": "शैलशृङ्गाणि वृक्षांश्च शिलाश्चाप्युपसंहरन्।\nभवन्तः सायुधाः सर्वे वानराः शैलपाणयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000468037, "chapter_id": 9468, "verse_number": "६-६१-३७", "content_sanskrit": "राघवेण समादिष्टो नीलो हरिचमूपतिः।\nशशास वानरानीकं यथावत् कपिकुञ्जरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000468038, "chapter_id": 9468, "verse_number": "६-६१-३८", "content_sanskrit": "ततो गवाक्षः शरभो हनूमानङ्गदस्तथा।\nशैलशृङ्गाणि शैलाभा गृहीत्वा द्वारमभ्ययुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000468039, "chapter_id": 9468, "verse_number": "६-६१-३९", "content_sanskrit": "रामवाक्यमुपश्रुत्य हरयो जितकाशिनः।\nपादपैरर्दयन् वीरा वानराः परवाहिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000468040, "chapter_id": 9468, "verse_number": "६-६१-४०", "content_sanskrit": "ततो हरीणां तदनीकमुग्रं\nरराज शैलोद्यतवृक्षहस्तम्।\nगिरेः समीपानुगतं यथैव\nमहन्महाम्भोधरजालमुग्रम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000468041, "chapter_id": 9468, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमद्युद्धकाण्डे एकषष्टितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]