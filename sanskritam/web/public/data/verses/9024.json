[{"id": 5000024000, "chapter_id": 9024, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे चतुर्विंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000024001, "chapter_id": 9024, "verse_number": "१-२४-१", "content_sanskrit": "ततः प्रभाते विमले कृताह्निकमरिन्दमौ ।\nविश्वामित्रं पुरस्कृत्य नद्यास्तीरमुपागतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000024002, "chapter_id": 9024, "verse_number": "१-२४-२", "content_sanskrit": "ते च सर्वे महात्मानो मुनयः संशितव्रताः ।\nउपस्थाप्य शुभां नावं विश्वामित्रमथाब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000024003, "chapter_id": 9024, "verse_number": "१-२४-३", "content_sanskrit": "आरोहतु भवान् नावं राजपुत्रपुरस्कृतः ।\nअरिष्टं गच्छ पन्थानं मा भूत् कालस्य पर्ययः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000024004, "chapter_id": 9024, "verse_number": "१-२४-४", "content_sanskrit": "विश्वामित्रस्तथेत्युक्त्वा तानृषीन् प्रतिपूज्य च ।\nततार सहितस्ताभ्यां सरितं सागरङ्गमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000024005, "chapter_id": 9024, "verse_number": "१-२४-५", "content_sanskrit": "तत्र शुश्राव वै शब्दं तोयसंरम्भवर्धितम् ।\nमध्यमागम्य तोयस्य तस्य शब्दस्य निश्चयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000024006, "chapter_id": 9024, "verse_number": "१-२४-६", "content_sanskrit": "ज्ञातुकामो महातेजाः सह रामः कनीयसा ।\nअथ रामः सरिन्मध्ये पप्रच्छ मुनिपुङ्गवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000024007, "chapter_id": 9024, "verse_number": "१-२४-७", "content_sanskrit": "वारिणो भिद्यमानस्य किमयं तुमुलो ध्वनिः ।\nराघवस्य वचः श्रुत्वा कौतूहलसमन्वितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000024008, "chapter_id": 9024, "verse_number": "१-२४-८", "content_sanskrit": "कथयामास धर्मात्मा तस्य शब्दस्य निश्चयम् ।\nकैलासपर्वते राम मनसा निर्मितं परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000024009, "chapter_id": 9024, "verse_number": "१-२४-९", "content_sanskrit": "ब्रह्मणा नरशार्दूल तेनेदं मानसं सरः ।\nतस्मात् सुस्राव सरसः सायोध्यामुपगूहते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000024010, "chapter_id": 9024, "verse_number": "१-२४-१०", "content_sanskrit": "सरःप्रवृत्ता सरयूः पुण्या ब्रह्मसरश्च्युता ।\nतस्यायमतुलः शब्दो जाह्नवीमभिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000024011, "chapter_id": 9024, "verse_number": "१-२४-११", "content_sanskrit": "वारिसंक्षोभजो राम प्रणामं नियतः कुरु ।\nताभ्यां तु तावुभौ कृत्वा प्रणाममतिधार्मिकौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000024012, "chapter_id": 9024, "verse_number": "१-२४-१२", "content_sanskrit": "तीरं दक्षिणमासाद्य जग्मतुर्लघुविक्रमौ ।\nस वनं घोरसंकाशं दृष्ट्वा नरवरात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000024013, "chapter_id": 9024, "verse_number": "१-२४-१३", "content_sanskrit": "अविप्रहतमैक्ष्वाकः पप्रच्छ मुनिपुङ्गवम् ।\nअहो वनमिदं दुर्गं झिल्लिकागणसंयुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000024014, "chapter_id": 9024, "verse_number": "१-२४-१४", "content_sanskrit": "भैरवैः श्वापदैः कीर्णं शकुन्तैर्दारुणारवैः ।\nनानाप्रकारैः शकुनैर्वाश्यद्भिर्भैरवस्वनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000024015, "chapter_id": 9024, "verse_number": "१-२४-१५", "content_sanskrit": "सिंहव्याघ्रवराहैश्च वारणैश्चापि शोभितम् ।\nधवाश्वकर्णककुभैर्बिल्वतिन्दुकपाटलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000024016, "chapter_id": 9024, "verse_number": "१-२४-१६", "content_sanskrit": "संकीर्णं बदरीभिश्च किं न्विदं दारुणं वनम् ।\nतमुवाच महातेजा विश्वामित्रो महामुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000024017, "chapter_id": 9024, "verse_number": "१-२४-१७", "content_sanskrit": "श्रूयतां वत्स काकुत्स्थ यस्यैतद् दारुणं वनम् ।\nएतौ जनपदौ स्फीतौ पूर्वमास्तां नरोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000024018, "chapter_id": 9024, "verse_number": "१-२४-१८", "content_sanskrit": "मलदाश्च करूषाश्च देवनिर्माणनिर्मितौ ।\nपुरा वृत्रवधे राम मलेन समभिप्लुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000024019, "chapter_id": 9024, "verse_number": "१-२४-१९", "content_sanskrit": "क्षुधा चैव सहस्राक्षं ब्रह्महत्या समाविशत् ।\nतमिन्द्रं मलिनं देवा ऋषयश्च तपोधनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000024020, "chapter_id": 9024, "verse_number": "१-२४-२०", "content_sanskrit": "कलशैः स्नापयामासुर्मलं चास्य प्रमोचयन् ।\nइह भूम्यां मलं दत्त्वा देवाः कारूषमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000024021, "chapter_id": 9024, "verse_number": "१-२४-२१", "content_sanskrit": "शरीरजं महेन्द्रस्य ततो हर्षं प्रपेदिरे ।\nनिर्मलो निष्करूषश्च शुद्ध इन्द्रो यथाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000024022, "chapter_id": 9024, "verse_number": "१-२४-२२", "content_sanskrit": "ददौ देशस्य सुप्रीतो वरं प्रादातनुत्तमम् ।\nइमौ जनपदौ स्फीतौ ख्यातिं लोके गमिष्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000024023, "chapter_id": 9024, "verse_number": "१-२४-२३", "content_sanskrit": "मलदाश्च करूषाश्च ममाङ्गमलधारिणौ ।\nसाधु साध्विति तं देवाः पाकशासनमब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000024024, "chapter_id": 9024, "verse_number": "१-२४-२४", "content_sanskrit": "देशस्य पूजां तां दृष्ट्वा कृतां शक्रेण धीमता ।\nएतौ जनपदौ स्फीतौ दीर्घकालमरिंदम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000024025, "chapter_id": 9024, "verse_number": "१-२४-२५", "content_sanskrit": "मलदाश्च करूषाश्च मुदिता धनधान्यतः ।\nकस्यचित्त्वथ कालस्य यक्षिणी कामरूपिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000024026, "chapter_id": 9024, "verse_number": "१-२४-२६", "content_sanskrit": "बलं नागसहस्रस्य धारयन्ती तदा ह्यभूत् ।\nताटका नाम भद्रं ते भार्या सुन्दस्य धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000024027, "chapter_id": 9024, "verse_number": "१-२४-२७", "content_sanskrit": "मारीचो राक्षसः पुत्रो यस्याः शक्रपराक्रमः ।\nवृत्तबाहुर्महाशीर्षो विपुलास्यतनुर्महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000024028, "chapter_id": 9024, "verse_number": "१-२४-२८", "content_sanskrit": "राक्षसो भैरवाकारो नित्यं त्रासयते प्रजाः ।\nइमौ जनपदौ नित्यं विनाशयति राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000024029, "chapter_id": 9024, "verse_number": "१-२४-२९", "content_sanskrit": "मलदांश्च करूषांश्च ताटका दुष्टचारिणी ।\nसेयं पन्थानमावृत्य वसत्यत्यर्धयोजने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000024030, "chapter_id": 9024, "verse_number": "१-२४-३०", "content_sanskrit": "अत एव च गन्तव्यं ताटकाया वनं यतः ।\nस्वबाहुबलमाश्रित्य जहीमां दुष्टचारिणीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000024031, "chapter_id": 9024, "verse_number": "१-२४-३१", "content_sanskrit": "मन्नियोगादिमं देशं कुरु निष्कण्टकं पुनः ।\nनहि कश्चिदिमं देशं शक्तो ह्यागन्तुमीदृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000024032, "chapter_id": 9024, "verse_number": "१-२४-३२", "content_sanskrit": "यक्षिण्या घोरया राम उत्सादितमसह्यया ।\nएतत्ते सर्वमाख्यातं यथैतद् दारुणं वनम् ।\nयक्ष्या चोत्सादितं सर्वमद्यापि न निवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000024033, "chapter_id": 9024, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे चतुर्विंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]