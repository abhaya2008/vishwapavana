[{"id": 2005155, "chapter_id": 1101, "verse_number": "१-१०२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2005156, "chapter_id": 1101, "verse_number": "१-१०२-१", "content_sanskrit": "इक्ष्वाकुवंशप्रभो राजासीत्पृथिवीपतिः।\nमहाभिषगिति ख्यातः सत्यवाक्सत्यविक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2005157, "chapter_id": 1101, "verse_number": "१-१०२-२", "content_sanskrit": "सोऽश्वमेधसहस्रेण राजसूयशतेन च।\nतोषयामास देवेशं स्वर्गं लेभे ततः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2005158, "chapter_id": 1101, "verse_number": "१-१०२-३", "content_sanskrit": "ततः कदाचिद्ब्रह्माणमुपासांचक्रिरे सुराः।\nतत्र राजर्षयो ह्यासन्स च राजा महाभिषक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2005159, "chapter_id": 1101, "verse_number": "१-१०२-४", "content_sanskrit": "अथ गङ्गा सरिच्छ्रेष्ठा समुपायात्पितामहम्।\nतस्या वासः समुद्धूतं मारुतेन शशिप्रभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2005160, "chapter_id": 1101, "verse_number": "१-१०२-५", "content_sanskrit": "ततोऽभवन्सुरगणाः सहसाऽवाङ्मुखास्तदा।\nमहाभिषक्तु राजर्षिरशङ्को दृष्टवान्नदीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2005161, "chapter_id": 1101, "verse_number": "१-१०२-६", "content_sanskrit": "सोपध्यातो भगवता ब्रह्मणा तु महाभिषक्।\nउक्तश्च जातो मर्त्येषु पुनर्लोकानवाप्स्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2005162, "chapter_id": 1101, "verse_number": "१-१०२-७", "content_sanskrit": "यया हृतमनाश्चासि गङ्गया त्वं हि दुर्मते।\nसा ते वै मानुषे लोके विप्रियाण्याचरिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2005163, "chapter_id": 1101, "verse_number": "१-१०२-८", "content_sanskrit": "यदा ते भविता मन्युस्तदा शापाद्विमोक्ष्यते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2005164, "chapter_id": 1101, "verse_number": "१-१०२-८x", "content_sanskrit": "वैशम्पायन उवाच।\nस चिन्तयित्वा नृपतिर्नृपानन्यांस्तपोधनान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2005165, "chapter_id": 1101, "verse_number": "१-१०२-९", "content_sanskrit": "प्रतीपं रोचयामास पितरं भूरितेजसम्।\nसा महाभिषजं दृष्ट्वा नदी दैर्याच्च्युतं नृपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2005166, "chapter_id": 1101, "verse_number": "१-१०२-१०", "content_sanskrit": "तमेव मनसा ध्यायन्त्युपावृत्ता सरिद्वरा।\nसा तु विध्वस्तवपुषः कश्मलाभिहतान्नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2005167, "chapter_id": 1101, "verse_number": "१-१०२-११", "content_sanskrit": "ददर्श पथि गच्छन्ती वसून्देवान्दिवौकसः।\nतथारूपांश्च तान्दृष्ट्वा प्रपच्छ सरितां वरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2005168, "chapter_id": 1101, "verse_number": "१-१०२-१२", "content_sanskrit": "किमिदं नष्टरूपाः स्थ कच्चित्क्षेमं दिवौकसाम्।\nतामूचुर्वसवो देवाः शप्ताः स्मो वै महानदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2005169, "chapter_id": 1101, "verse_number": "१-१०२-१३", "content_sanskrit": "अल्पेऽपराधे संरम्भाद्वसिष्ठेन महात्मना।\nविमूढा हि वयं सर्वे प्रच्छन्नमृषिसत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2005170, "chapter_id": 1101, "verse_number": "१-१०२-१४", "content_sanskrit": "सन्ध्यां वसिष्ठमासीनं तमत्यभिसृताः पुरा।\nतेन कोपाद्वयं शप्ता योनौ संभवतेति ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2005171, "chapter_id": 1101, "verse_number": "१-१०२-१५", "content_sanskrit": "न तच्छक्यं निवर्तयितुं यदुक्तं ब्रह्मवादिना।\nत्वमस्मान्मानुषी भूत्वा सूष्व पुत्रान्वसून्भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2005172, "chapter_id": 1101, "verse_number": "१-१०२-१६", "content_sanskrit": "न मानुषीणां जठरं प्रविशेम वयं शुभे।\nइत्युक्ता तैश्च वसुभिस्तथेत्युक्त्वाऽब्रवीदिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2005173, "chapter_id": 1101, "verse_number": "१-१०२-१७x", "content_sanskrit": "गङ्गोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2005174, "chapter_id": 1101, "verse_number": "१-१०२-१७", "content_sanskrit": "मर्त्येषु पुरुषश्रेष्ठः को वः कर्ता भविष्यति।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2005175, "chapter_id": 1101, "verse_number": "१-१०२-१७x", "content_sanskrit": "वसव ऊचुः।\nप्रतीपस्य सुतो राजा शान्तनुर्लोकविश्रुतः।\nभविता मानुषे लोके स नः कर्ता भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2005176, "chapter_id": 1101, "verse_number": "१-१०२-१८x", "content_sanskrit": "गङ्गोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2005177, "chapter_id": 1101, "verse_number": "१-१०२-१८", "content_sanskrit": "ममाप्येवं मतं देवा यथा मां वदथानघाः।\nप्रियं तस्य करिष्यामि युष्माकं चेतदीप्सितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2005178, "chapter_id": 1101, "verse_number": "१-१०२-१९x", "content_sanskrit": "वसव ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2005179, "chapter_id": 1101, "verse_number": "१-१०२-१९", "content_sanskrit": "जातान्कुमारान्स्वानप्सु प्रक्षेप्तुं वै त्वमर्हसि।\nयथा नचिरकालं नो निष्कृतिः स्यात्त्रिलोकगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2005180, "chapter_id": 1101, "verse_number": "१-१०२-२०", "content_sanskrit": "जिघृक्षवो वयं सर्वे सुरभिं मन्दबुद्धयः।\nशप्ता ब्रह्मर्षिणा तेन तांस्त्वं मोचय चाशु नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2005181, "chapter_id": 1101, "verse_number": "१-१०२-२१x", "content_sanskrit": "गङ्गोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2005182, "chapter_id": 1101, "verse_number": "१-१०२-२१", "content_sanskrit": "एवमेतत्करिष्यामि पुत्रस्तस्य विधीयताम्।\nनास्य मोघः सङ्गमः स्यात्पुत्रहेतोर्मया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2005183, "chapter_id": 1101, "verse_number": "१-१०२-२२x", "content_sanskrit": "वसव ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2005184, "chapter_id": 1101, "verse_number": "१-१०२-२२", "content_sanskrit": "तुरीयार्धं प्रदास्यामो वीर्यस्यैकैकशो वयम्।\nतेन वीर्येण पुत्रस्ते भविता तस्य चेप्सितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2005185, "chapter_id": 1101, "verse_number": "१-१०२-२३", "content_sanskrit": "न संपत्स्यति मर्त्येषु पुनस्तस्य तु सन्ततिः।\nतस्मादपुत्रः पुत्रस्ते भविष्यति स वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2005186, "chapter_id": 1101, "verse_number": "१-१०२-२४", "content_sanskrit": "एवं ते समयं कृत्वा गङ्गया वसवः सह।\nजग्मुः संहृष्टमनसो यथासंकल्पमञ्जसा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2005187, "chapter_id": 1101, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिप्रवमि संभवपर्वणि द्व्यधिकशततमोऽध्यायः॥ १०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]