[{"id": 2025853, "chapter_id": 1554, "verse_number": "३-१९२-०x", "content_sanskrit": "देव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2025854, "chapter_id": 1554, "verse_number": "३-१९२-१", "content_sanskrit": "कामं देवाऽपि मां विप्र न हि जानन्ति तत्त्वतः।\nत्वत्प्रीत्या तु प्रवक्ष्यामि यथेदं विमृजाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2025855, "chapter_id": 1554, "verse_number": "३-१९२-२", "content_sanskrit": "पितृभक्तोसि विप्रर्षे मां चैव शरणं गतः।\nततो दृष्टोस्मि ते साक्षाद्ब्रह्यचर्यं च ते महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2025856, "chapter_id": 1554, "verse_number": "३-१९२-३", "content_sanskrit": "आपो नारा इति प्रोक्तास्तासां नाम कृतं मया।\nतेन नारायणप्युक्तो मम तत्त्वयनं सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2025857, "chapter_id": 1554, "verse_number": "३-१९२-४", "content_sanskrit": "अहंनारायणो नाम प्रभवः शाश्वतोऽव्ययः।\nविधाता सर्वभूतानां संहर्ता च द्विजोत्तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2025858, "chapter_id": 1554, "verse_number": "३-१९२-५", "content_sanskrit": "अहं विष्णुरहं ब्रह्मा शक्रश्चाहं सुराधिपः।\nअहं वैश्रवणो राजा यमः प्रेताधिपस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2025859, "chapter_id": 1554, "verse_number": "३-१९२-६", "content_sanskrit": "अहं शिवश्च सोमश्च कश्यपोऽथ प्रजापतिः।\nअहं धाता विधाता च यज्ञश्चाहं द्विजोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2025860, "chapter_id": 1554, "verse_number": "३-१९२-७", "content_sanskrit": "अग्निरास्यं क्षिति पादौ चन्द्रादित्यौ च लोचने।\nद्यौर्मूर्धा मे दिशः श्रोत्रे तथाऽऽपः स्वेदसंभवाः।\nसकलं च नभः कायो वायुर्मनसि मे स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2025861, "chapter_id": 1554, "verse_number": "३-१९२-८", "content_sanskrit": "मया क्रतुशतैरिष्टं बहुभिस्त्वाप्तदक्षिणैः।\nयजन्ते वेदविदुषो मां देवसदने स्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2025862, "chapter_id": 1554, "verse_number": "३-१९२-९", "content_sanskrit": "पृथिव्यां क्षत्रियेन्द्राश् पार्तिवाः स्वर्गकाङ्क्षिणः।\nयजन्ते मां तथा वैश्याः स्वर्गलोकजिगीषया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2025863, "chapter_id": 1554, "verse_number": "३-१९२-१०", "content_sanskrit": "चतुःसमुद्रपर्यन्तां मेरुमन्दरभूषणाम्।\nशेषो भूत्वाऽहमेवैतां धारयामि वसुंधराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2025864, "chapter_id": 1554, "verse_number": "३-१९२-११", "content_sanskrit": "वाराहं रूपमास्थाय मयेयं जगती पुरा।\nमज्जमाना जले विप्र वीर्येणासीत्समुद्धृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2025865, "chapter_id": 1554, "verse_number": "३-१९२-१२", "content_sanskrit": "अग्निश्च बडबावक्रे भूत्वाऽहं द्विजसत्तम।\nपिबाम्यापः सदा विद्वंस्ताश्चैव विसृजाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2025866, "chapter_id": 1554, "verse_number": "३-१९२-१३", "content_sanskrit": "ब्रह्म वक्रं भुजौ क्षत्रमूरू मे संस्थिता विशः।\nपादौ शूद्रा भवन्तीमे विक्रमेण क्रमेण च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2025867, "chapter_id": 1554, "verse_number": "३-१९२-१४", "content_sanskrit": "ऋग्वेदः सामवेदश्च यजुर्वेदोऽप्यथर्वणः।\nमत्तः प्रादुर्भवन्त्येते मामेव प्रविशन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2025868, "chapter_id": 1554, "verse_number": "३-१९२-१५", "content_sanskrit": "यतयः शान्तिपरमा यतात्मानो मुमुक्षवः।\nकामक्रोधद्वेषमुक्ता निःसंज्ञा वीतकल्मषाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2025869, "chapter_id": 1554, "verse_number": "३-१९२-१६", "content_sanskrit": "सत्वस्था निरहंकारा नित्यमध्यात्मकोविदाः।\nमामेव सततं विप्राश्चिन्तयन्त उपासते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2025870, "chapter_id": 1554, "verse_number": "३-१९२-१७", "content_sanskrit": "अहं संवर्तको वह्निरहं संवर्तको यमः।\nअहं संवर्तकः सूर्यस्त्वहं संवर्तकोऽनिलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2025871, "chapter_id": 1554, "verse_number": "३-१९२-१८", "content_sanskrit": "तारारूपाणि दृश्यन्ते यान्येतानि नभस्तले।\nमम रूपाण्यथैतानि विद्धि त्वं द्विजसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2025872, "chapter_id": 1554, "verse_number": "३-१९२-१९", "content_sanskrit": "रत्नाकराः समुद्राश्च सर्व एव चतुर्दिशः।\nवसनं शयनं चैव विलयं चैव विद्धि मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2025873, "chapter_id": 1554, "verse_number": "३-१९२-२०", "content_sanskrit": "मयैव सुविभक्तास्ते देवकार्यार्थसिद्धये।\nकामं क्रोधं च हर्षं च भयं मोहं तथैव च।\nममैव विद्धि रोमाणि सर्वाण्येतानि सत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2025874, "chapter_id": 1554, "verse_number": "३-१९२-२१", "content_sanskrit": "प्राप्नुवन्ति नरा विप्र यत्कृत्वा कर्म शोभनम्।\nसत्यं दानं तपश्चोग्रमहिंसा चैव जन्तुषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2025875, "chapter_id": 1554, "verse_number": "३-१९२-२२", "content_sanskrit": "मद्विधानेन विहिता मम देहविहारिणः।\nमयाऽभिभूतविज्ञाना विचेष्टन्ते न कामतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2025876, "chapter_id": 1554, "verse_number": "३-१९२-२३", "content_sanskrit": "सम्यग्वेदमधीयाना यजन्ते विविधैर्मखैः।\nशान्तात्मानो जितक्रोधाः प्राप्नुवन्ति द्विजातयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2025877, "chapter_id": 1554, "verse_number": "३-१९२-२४", "content_sanskrit": "---न शक्यो यो विद्वन्नरैर्दुष्कृतकर्मभिः।\n---भाभिभूतैः कृपणैरनार्यैरकृतात्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2025878, "chapter_id": 1554, "verse_number": "३-१९२-२५", "content_sanskrit": "तस्मान्महाफलंविद्धि पदं सुकृतकर्मणः।\nसुदुष्प्रापं विमूढानां मार्गं योगैर्निषेवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2025879, "chapter_id": 1554, "verse_number": "३-१९२-२६", "content_sanskrit": "यदा यदा च धर्मस्य ग्लानिर्भवति सत्तम।\nअभ्युत्थानमधर्मस्य तदाऽऽत्मानं सृजाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2025880, "chapter_id": 1554, "verse_number": "३-१९२-२७", "content_sanskrit": "दैत्या हिंसानुरक्ताश्च अवध्याः सुरसत्तमैः।\nराक्षसाश्चापि लोकेऽस्मिन्यदोत्पत्स्यन्ति दारुणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2025881, "chapter_id": 1554, "verse_number": "३-१९२-२८", "content_sanskrit": "तदाऽहंसंप्रसूयामि गृहेषु शुभकर्मणाम्।\nप्रविष्टो मानुषं देहं सर्वं प्रशमयाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2025882, "chapter_id": 1554, "verse_number": "३-१९२-२९", "content_sanskrit": "सृष्ट्वा देवमनुष्यांस्तु गन्धर्वोरगराक्षसान्।\nस्थावराणि च भूतानि संहराम्यात्ममायया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2025883, "chapter_id": 1554, "verse_number": "३-१९२-३०", "content_sanskrit": "कर्मकाले पुनर्देहमनुचिन्त्य सृजाम्यहम्।\nआविश्य मानषं देहं मर्यादाबन्धकारणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2025884, "chapter_id": 1554, "verse_number": "३-१९२-३१", "content_sanskrit": "श्वेतः कृतयुगे वर्णः पीतस्त्रेतायुगे मम।\nश्यामो द्वापरमासाद्य कृष्णः कलियुगे तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2025885, "chapter_id": 1554, "verse_number": "३-१९२-३२", "content_sanskrit": "त्रयो भागा ह्यधर्मस् तस्मिन्काले भवनति च।\n`यदा भवति मे वर्णः कृष्णो वै द्विजसत्तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2025886, "chapter_id": 1554, "verse_number": "३-१९२-३३", "content_sanskrit": "अन्तकाले च संप्राप्ते कालो भूत्वाऽतिदारुणः।\nत्रैलोक्यं नाशयाम्येकः कृत्स्नं स्थावरजङ्गमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2025887, "chapter_id": 1554, "verse_number": "३-१९२-३४", "content_sanskrit": "अहं त्रिवर्त्मा विश्वात्मा सर्वलोकसुखावहः।\nअजितः सर्वगोऽनन्तो हृषीकेश उरुक्रमः।\nकालचक्रं नयाम्येको ब्रह्मन्नहमरूपकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2025888, "chapter_id": 1554, "verse_number": "३-१९२-३५", "content_sanskrit": "शमनं सर्वभूतानां सर्वकालकृतोद्यमम्।\nएवं प्रणिहितः सम्यङ्मायया मुनिसत्तम।\nसर्वभूतेषु विप्रेन्द्र न च मां वेत्ति कश्चन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2025889, "chapter_id": 1554, "verse_number": "३-१९२-३६", "content_sanskrit": "सर्वलोके च मां भक्ताः पूजयन्ति च सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2025890, "chapter_id": 1554, "verse_number": "३-१९२-३७", "content_sanskrit": "यच्च किंचित्त्वया प्राप्तं मयि क्लेशात्मकं द्विज।\nसुखोदयाय तत्सर्वं श्रेयसे च तवानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2025891, "chapter_id": 1554, "verse_number": "३-१९२-३८", "content_sanskrit": "यच्च किंचित्त्वया लोके दृष्टं स्थावरजङ्गमम्।\nविहित सर्वथैवासौ ममात्मा भूतभावनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2025892, "chapter_id": 1554, "verse_number": "३-१९२-३९", "content_sanskrit": "अर्धं मम शरीरस्य सर्वलोकपितामहः।\nअहं नारायणो नाम शङ्खचक्रगदाधरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2025893, "chapter_id": 1554, "verse_number": "३-१९२-४०", "content_sanskrit": "यावद्युगानां विप्रर्षे सहस्रपरिवर्तनम्।\nतावत्स्वपिमि विश्वात्मा सर्वलोकपितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2025894, "chapter_id": 1554, "verse_number": "३-१९२-४१", "content_sanskrit": "एवं सर्वमहं कालमिहासे मुनिसत्तम।\nअशिशुः शिशुरूपेण यावद्ब्रह्मा न बुध्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2025895, "chapter_id": 1554, "verse_number": "३-१९२-४२", "content_sanskrit": "मया च दत्तो विप्राग्र्य वरस्ते ब्रह्मरूपिणा।\nअसकृत्परितष्टेन विप्रर्षिगणपूजित ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2025896, "chapter_id": 1554, "verse_number": "३-१९२-४३", "content_sanskrit": "सर्वमेकार्णवं दृष्ट्वा नष्टं स्थावरजङ्गमम्।\nविक्लबोसि मया ज्ञातस्ततस्ते दर्शितं जगत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2025897, "chapter_id": 1554, "verse_number": "३-१९२-४४", "content_sanskrit": "अभ्यन्तरं शरीरस्य प्रविष्टोसि यदा मम।\nदृष्ट्वा लोकं समस्तं च विस्मितो नावबुध्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2025898, "chapter_id": 1554, "verse_number": "३-१९२-४५", "content_sanskrit": "ततोसि वक्राद्विप्रर्षे द्रुतं निःसारितो मया।\nआख्यातस्ते मया चात्मा दुर्ज्ञे योपि सुरासुरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2025899, "chapter_id": 1554, "verse_number": "३-१९२-४६", "content_sanskrit": "यावत्स भगवान्ब्रह्मा न बुध्येत महातपाः।\nतावत्त्वमिह विप्रर्षे विस्रब्धश्चर वै सुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2025900, "chapter_id": 1554, "verse_number": "३-१९२-४७", "content_sanskrit": "ततो विबुद्धे तस्मिंस्तु सर्वलोकपितामहे।\nएकीभूतः प्रवेक्ष्यामि शरीराणि द्विजोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2025901, "chapter_id": 1554, "verse_number": "३-१९२-४८", "content_sanskrit": "आकाशं पृथिवीं ज्योतिर्वायुं सलिलमेव च।\nलोके यच्च भवेच्छेषमिह स्थावरजङ्गमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2025902, "chapter_id": 1554, "verse_number": "३-१९२-४९x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2025903, "chapter_id": 1554, "verse_number": "३-१९२-४९", "content_sanskrit": "इत्युक्त्वान्तर्हितस्तात स देवः परमाद्भुतः।\nप्रजाश्चेमाः प्रपश्यामि विचित्रा विविधाः कृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2025904, "chapter_id": 1554, "verse_number": "३-१९२-५०", "content_sanskrit": "एवं दृष्टं मया राजंस्तस्मिन्प्राप्ते युगक्षये।\nआश्चर्यं भरतश्रेष्ठ सर्वधर्मभृतांवरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2025905, "chapter_id": 1554, "verse_number": "३-१९२-५१", "content_sanskrit": "यः स देवो मया दृष्टः पुरा पद्मायतेक्षणः।\nस एष पुरुषव्याघ्र संबन्धी ते जनार्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2025906, "chapter_id": 1554, "verse_number": "३-१९२-५२", "content_sanskrit": "अस्यैव वरदानाद्धि स्मृतिर्न प्रजहाति माम्।\nदीर्गमायुश्च कौन्तेय स्वच्छन्दमरणं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2025907, "chapter_id": 1554, "verse_number": "३-१९२-५३", "content_sanskrit": "स एष कृष्णो वार्ष्णेय पुराणपुरुषो विभुः।\nआस्ते हरिरचिन्त्यात्मा क्रीडन्निव महाभुजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2025908, "chapter_id": 1554, "verse_number": "३-१९२-५४", "content_sanskrit": "एष धाता विधाता च संहर्ता चैव शाश्वतः।\nश्रीवत्सवक्षा गोविन्दः प्रजापतिपतिः प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2025909, "chapter_id": 1554, "verse_number": "३-१९२-५५", "content_sanskrit": "दृष्ट्वेमं वृष्णिप्रवरं स्मृतिर्मामियमागता।\nआदिदेवमयं जिष्णुं पुरुषं पीतवाससम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2025910, "chapter_id": 1554, "verse_number": "३-१९२-५६", "content_sanskrit": "सर्वेषामेव भूतानां पिता माता च माधवः।\nगच्छध्वमेनं शरणं शरण्यं कौरवर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2025911, "chapter_id": 1554, "verse_number": "३-१९२-५७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2025912, "chapter_id": 1554, "verse_number": "३-१९२-५७", "content_sanskrit": "एवमुक्तास्च ते पार्ता यमौ च पुरुषर्षभौ।\nद्रौपद्या सहिताः सर्वे नमश्चक्रुर्जनार्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2025913, "chapter_id": 1554, "verse_number": "३-१९२-५८", "content_sanskrit": "स चैतान्पुरुषव्याघ्र साम्ना परमवल्गुना।\nसान्त्वयामास मानार्हो मन्यमानो यथाविधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2025914, "chapter_id": 1554, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि मार्कण्डेयसमास्यापर्वणि द्विनवत्यधिकशततमोऽध्यायः ॥ १९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]