[{"id": 5000455000, "chapter_id": 9455, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे सप्तत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000455001, "chapter_id": 9455, "verse_number": "६-४८-१", "content_sanskrit": "भर्तारं निहतं दृष्ट्वा लक्ष्मणं च महाबलम्।\nविललाप भृशं सीता करुणं शोककर्शिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000455002, "chapter_id": 9455, "verse_number": "६-४८-२", "content_sanskrit": "ऊचुर्लाक्षणिका ये मां पुत्रिण्यविधवेति च।\nतेऽद्य सर्वे हते रामे ज्ञानिनोऽनृतवादिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000455003, "chapter_id": 9455, "verse_number": "६-४८-३", "content_sanskrit": "यज्वनो महिषीं ये मामूचुः पत्नीं च सत्रिणः।\nतेऽद्य सर्वे हते रामे ज्ञानिनोऽनृतवादिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000455004, "chapter_id": 9455, "verse_number": "६-४८-४", "content_sanskrit": "वीरपार्थिवपत्नीनां ये विदुर्भर्तृपूजिताम्।\nतेऽद्य सर्वे हते रामे ज्ञानिनोऽनृतवादिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000455005, "chapter_id": 9455, "verse_number": "६-४८-५", "content_sanskrit": "ऊचुः संश्रवणे ये मां द्विजाः कार्तान्तिकाः शुभाम्।\nतेऽद्य सर्वे हते रामे ज्ञानिनोऽनृतवादिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000455006, "chapter_id": 9455, "verse_number": "६-४८-६", "content_sanskrit": "इमानि खलु पद्मानि पादयोर्वै कुलस्त्रियः।\nआधिराज्येऽभिषिच्यन्ते नरेन्द्रैः पतिभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000455007, "chapter_id": 9455, "verse_number": "६-४८-७", "content_sanskrit": "वैधव्यं यान्ति यैर्नार्योऽलक्षणैर्भाग्यदुर्लभाः।\nनात्मनस्तानि पश्यामि पश्यन्ती हतलक्षणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000455008, "chapter_id": 9455, "verse_number": "६-४८-८", "content_sanskrit": "सत्यनामानि पद्मानि स्त्रीणामुक्तानि लक्षणैः।\nतान्यद्य निहते रामे वितथानि भवन्ति मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000455009, "chapter_id": 9455, "verse_number": "६-४८-९", "content_sanskrit": "केशाः सूक्ष्माः समा नीला भ्रुवौ चासंहते मम।\nवृत्ते चारोमके जङ्घे दन्ताश्चाविरला मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000455010, "chapter_id": 9455, "verse_number": "६-४८-१०", "content_sanskrit": "शङ्खे नेत्रे करौ पादौ गुल्फावूरू समौ चितौ।\nअनुवृत्तनखाः स्निग्धाः समाश्चाङ्गुलयो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000455011, "chapter_id": 9455, "verse_number": "६-४८-११", "content_sanskrit": "स्तनौ चाविरलौ पीनौ मामकौ मग्नचूचुकौ।\nमग्ना चोत्सेधनी नाभिः पार्श्वोरस्कं च मे चितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000455012, "chapter_id": 9455, "verse_number": "६-४८-१२", "content_sanskrit": "मम वर्णो मणिनिभो मृदून्यङ्गरुहाणि च।\nप्रतिष्ठितां द्वादशभिर्मामूचुः शुभलक्षणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000455013, "chapter_id": 9455, "verse_number": "६-४८-१३", "content_sanskrit": "समग्रयवमच्छिद्रं पाणिपादं च वर्णवत्।\nमन्दस्मितेत्येव च मां कन्यालाक्षणिका विदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000455014, "chapter_id": 9455, "verse_number": "६-४८-१४", "content_sanskrit": "आधिराज्येऽभिषेको मे ब्राह्मणैः पतिना सह।\nकृतान्तकुशलैरुक्तं तत् सर्वं वितथीकृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000455015, "chapter_id": 9455, "verse_number": "६-४८-१५", "content_sanskrit": "शोधयित्वा जनस्थानं प्रवृत्तिमुपलभ्य च।\nतीर्त्वा सागरमक्षोभ्यं भ्रातरौ गोष्पदे हतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000455016, "chapter_id": 9455, "verse_number": "६-४८-१६", "content_sanskrit": "ननु वारुणमाग्नेयमैन्द्रं वायव्यमेव च।\nअस्त्रं ब्रह्मशिरश्चैव राघवौ प्रत्यपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000455017, "chapter_id": 9455, "verse_number": "६-४८-१७", "content_sanskrit": "अदृश्यमानेन रणे मायया वासवोपमौ।\nमम नाथावनाथाया निहतौ रामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000455018, "chapter_id": 9455, "verse_number": "६-४८-१८", "content_sanskrit": "नहि दृष्टिपथं प्राप्य राघवस्य रणे रिपुः।\nजीवन् प्रतिनिवर्तेत यद्यपि स्यान्मनोजवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000455019, "chapter_id": 9455, "verse_number": "६-४८-१९", "content_sanskrit": "न कालस्यातिभारोऽस्ति कृतान्तश्च सुदुर्जयः।\nयत्र रामः सह भ्रात्रा शेते युधि निपातितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000455020, "chapter_id": 9455, "verse_number": "६-४८-२०", "content_sanskrit": "न शोचामि तथा रामं लक्ष्मणं च महारथम्।\nनात्मानं जननीं चापि यथा श्वश्रूं तपस्विनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000455021, "chapter_id": 9455, "verse_number": "६-४८-२१", "content_sanskrit": "सा तु चिन्तयते नित्यं समाप्तव्रतमागतम्।\nकदा द्रक्ष्यामि सीतां च लक्ष्मणं च सराघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000455022, "chapter_id": 9455, "verse_number": "६-४८-२२", "content_sanskrit": "परिदेवयमानां तां राक्षसी त्रिजटाब्रवीत्।\nमा विषादं कृथा देवि भर्तायं तव जीवति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000455023, "chapter_id": 9455, "verse_number": "६-४८-२३", "content_sanskrit": "कारणनि च वक्ष्यामि महान्ति सदृशानि च।\nयथेमौ जीवतो देवि भ्रातरौ रामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000455024, "chapter_id": 9455, "verse_number": "६-४८-२४", "content_sanskrit": "नहि कोपपरीतानि हर्षपर्युत्सुकानि च।\nभवन्ति युधि योधानां मुखानि निहते पतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000455025, "chapter_id": 9455, "verse_number": "६-४८-२५", "content_sanskrit": "इदं विमानं वैदेहि पुष्पकं नाम नामतः।\nदिव्यं त्वां धारयेन् नेदं यद्येतौ गतजीवितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000455026, "chapter_id": 9455, "verse_number": "६-४८-२६", "content_sanskrit": "हतवीरप्रधाना हि गतोत्साहा निरुद्यमा।\nसेना भ्रमति संख्येषु हतकर्णेव नौर्जले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000455027, "chapter_id": 9455, "verse_number": "६-४८-२७", "content_sanskrit": "इयं पुनरसम्भ्रान्ता निरुद्विग्ना तपस्विनि।\nसेना रक्षति काकुत्स्थौ मया प्रीत्या निवेदितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000455028, "chapter_id": 9455, "verse_number": "६-४८-२८", "content_sanskrit": "सा त्वं भव सुविस्रब्धा अनुमानैः सुखोदयैः।\nअहतौ पश्य काकुत्स्थौ स्नेहादेतद् ब्रवीमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000455029, "chapter_id": 9455, "verse_number": "६-४८-२९", "content_sanskrit": "अनृतं नोक्तपूर्वं मे न च वक्ष्यामि मैथिलि।\nचारित्रसुखशीलत्वात् प्रविष्टासि मनो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000455030, "chapter_id": 9455, "verse_number": "६-४८-३०", "content_sanskrit": "नेमौ शक्यौ रणे जेतुं सेन्द्रैरपि सुरासुरैः।\nतादृशं दर्शनं दृष्ट्वा मया चोदीरितं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000455031, "chapter_id": 9455, "verse_number": "६-४८-३१", "content_sanskrit": "इदं तु सुमहच्चित्रं शरैः पश्यस्व मैथिलि।\nविसंज्ञौ पतितावेतौ नैव लक्ष्मीर्विमुञ्चति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000455032, "chapter_id": 9455, "verse_number": "६-४८-३२", "content_sanskrit": "प्रायेण गतसत्त्वानां पुरुषाणां गतायुषाम्।\nदृश्यमानेषु वक्त्रेषु परं भवति वैकृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000455033, "chapter_id": 9455, "verse_number": "६-४८-३३", "content_sanskrit": "त्यज शोकं च दुःखं च मोहं च जनकात्मजे।\nरामलक्ष्मणयोरर्थे नाद्य शक्यमजीवितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000455034, "chapter_id": 9455, "verse_number": "६-४८-३४", "content_sanskrit": "श्रुत्वा तु वचनं तस्याः सीता सुरसुतोपमा।\nकृताञ्जलिरुवाचेमामेवमस्त्विति मैथिली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000455035, "chapter_id": 9455, "verse_number": "६-४८-३५", "content_sanskrit": "विमानं पुष्पकं तत्तु संनिवर्त्य मनोजवम्।\nदीना त्रिजटया सीता लङ्कामेव प्रवेशिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000455036, "chapter_id": 9455, "verse_number": "६-४८-३६", "content_sanskrit": "ततस्त्रिजटया सार्धं पुष्पकादवरुह्य सा।\nअशोकवनिकामेव राक्षसीभिः प्रवेशिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000455037, "chapter_id": 9455, "verse_number": "६-४८-३७", "content_sanskrit": "प्रविश्य सीता बहुवृक्षखण्डां\nतां राक्षसेन्द्रस्य विहारभूमिम्।\nसम्प्रेक्ष्य संचिन्त्य च राजपुत्रौ\nपरं विषादं समुपाजगाम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000455038, "chapter_id": 9455, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे अष्टचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]