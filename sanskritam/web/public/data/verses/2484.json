[{"id": 2070593, "chapter_id": 2484, "verse_number": "११-१६-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2070594, "chapter_id": 2484, "verse_number": "११-१६-१", "content_sanskrit": "एवमुक्त्वा तु गान्धारी कुरूणामवकर्तनम्।\nअपश्यत्तत्र तिष्ठन्ती सर्वं तत्र यथास्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2070595, "chapter_id": 2484, "verse_number": "११-१६-२", "content_sanskrit": "पतिव्रता महाभागा समानव्रतचारिणी।\nउग्रेण तपसा युक्ता सततं सत्यवादिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2070596, "chapter_id": 2484, "verse_number": "११-१६-३", "content_sanskrit": "वरदानेन कृष्णस्य महर्षेः पुण्यकर्मणः।\nदिव्यज्ञानबलोपेता विविधं पर्यदेवयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2070597, "chapter_id": 2484, "verse_number": "११-१६-४", "content_sanskrit": "ददर्श सा बुद्धिमती दूरादपि यथाऽन्तिके।\nरणाजिरं तद्वीराणामद्भुतं रोमहर्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2070598, "chapter_id": 2484, "verse_number": "११-१६-५", "content_sanskrit": "अस्थिकेशवसाकीर्णं शोणितौघपरिप्लुतम्।\nशरीरैर्बहुसाहस्रैर्विनिकीर्णं समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2070599, "chapter_id": 2484, "verse_number": "११-१६-६", "content_sanskrit": "गजाश्वरथयोधानामावृतं रुधिराविलैः।\nशरीरैरशिरस्कैश्च विदेहैश्च शिरोगणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2070600, "chapter_id": 2484, "verse_number": "११-१६-७", "content_sanskrit": "गजाश्वनरवीराणां निःसत्वैरभिसंवृतम्।\nसृगालवलगोमायुकङ्ककाकनिषेवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2070601, "chapter_id": 2484, "verse_number": "११-१६-८", "content_sanskrit": "रक्षसां पुरुषादाना मोदनं कुरराकुलम्।\nअशिवाभिः शिवाभिश्च नादितं गृध्रसेवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2070602, "chapter_id": 2484, "verse_number": "११-१६-९", "content_sanskrit": "ततो व्यासाभ्यनुज्ञातो धृतराष्ट्रो महीपतिः।\nपाण्डुपुत्राश्च ते सर्वे युधिष्ठिरपुरोगमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2070603, "chapter_id": 2484, "verse_number": "११-१६-१०", "content_sanskrit": "वासुदेवं पुरस्कृत्य हतबन्धुं च पार्थिवम्।\nकुरुस्त्रियः समादाय जग्मुरायोधनं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2070604, "chapter_id": 2484, "verse_number": "११-१६-११", "content_sanskrit": "समासाद्य कुरुक्षेत्रं ताः स्त्रियो निहतेश्वराः।\nअपश्यन्त हतांस्तत्र पुत्रान्भ्रातॄन्पितॄन्पतीन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2070605, "chapter_id": 2484, "verse_number": "११-१६-१२", "content_sanskrit": "क्रव्यादैर्भक्ष्यमाणांश्च गोमायुवलवायसैः।\nभूतैः पिशाचै रक्षोभिर्विविधैश्च निशाचरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2070606, "chapter_id": 2484, "verse_number": "११-१६-१३", "content_sanskrit": "रुद्राक्रीडनिभं दृष्ट्वा तदा विशसनं स्त्रियः।\nकुरर्य इव शोकार्ता विक्रोशन्त्यो निपेतिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2070607, "chapter_id": 2484, "verse_number": "११-१६-१४", "content_sanskrit": "अदृष्टपूर्वं पशन्त्यो दुःखार्ता भरतस्त्रियः।\nशरीरेषु स्खलन्त्यश्च न्यपतंश्च परासुवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2070608, "chapter_id": 2484, "verse_number": "११-१६-१५", "content_sanskrit": "श्रान्तानां चाप्यनाथानां क्रन्दन्तीनां भृशं तदा।\nपाञ्चालकुरुयोषाणां कृपणं तदभून्महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2070609, "chapter_id": 2484, "verse_number": "११-१६-१६", "content_sanskrit": "दुःखोपहतचित्ताभिः समन्तादनुनादितम्।\nदृष्ट्वाऽऽयोधनमत्युग्रं धर्मज्ञा सुबलात्मजा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2070610, "chapter_id": 2484, "verse_number": "११-१६-१७", "content_sanskrit": "ततः सा पुण्डरीकाक्षमामन्त्र्य पुरुषोत्तमम्।\nकुरूणां वैशमं दृष्ट्वा इदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2070611, "chapter_id": 2484, "verse_number": "११-१६-१८", "content_sanskrit": "पश्यैताः पुण्डरीकाक्ष स्नुषा मे निहतेश्वराः।\nप्रकीर्णकेशाः क्रोशन्तीः कुररीरिव माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2070612, "chapter_id": 2484, "verse_number": "११-१६-१९", "content_sanskrit": "अमूस्त्वभिसमागम्य स्मरन्त्यो भरतर्षभान्।\nपृथगेवानुपद्यन्ते पुत्रान्भ्रातॄन्पितॄन्पतीन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2070613, "chapter_id": 2484, "verse_number": "११-१६-२०", "content_sanskrit": "वीरसूभिर्महाबाहो हतपुत्राभिरावृतम्।\nक्वचिच्च वीरपत्नीभिर्हतवीराभिरावृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2070614, "chapter_id": 2484, "verse_number": "११-१६-२१", "content_sanskrit": "शोभितं पुरुषव्याघ्रैः कर्णभीष्माभिमन्युभिः।\nद्रोणद्रुपदशल्यैश्च ज्वलद्भिरिव पावकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2070615, "chapter_id": 2484, "verse_number": "११-१६-२२", "content_sanskrit": "काञ्चनैः कवचैर्निष्कैर्मणिभिश्च महाधनैः।\nअद्भुतैर्हस्तकेयूरैः स्रग्भिश्च समलंकृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2070616, "chapter_id": 2484, "verse_number": "११-१६-२३", "content_sanskrit": "वीरबाहुविसृष्टाभिः शक्तिभिः परिघैरपि।\nखङ्गैश्च विविधैस्तीक्ष्णैः सशरैश्च शरासनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2070617, "chapter_id": 2484, "verse_number": "११-१६-२४", "content_sanskrit": "क्रव्यादसङ्घैर्मुदितैस्तिष्ठद्भिः सहितैः क्वचित्।\nक्वचिदाक्रीडमानैश्च शयानैश्चापरैः क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2070618, "chapter_id": 2484, "verse_number": "११-१६-२५", "content_sanskrit": "एतदेवंविधं वीर सम्पश्यायोधनं विभो।\n`त्वया तु श्रावितं कर्म पुष्कराक्ष महाद्युते।\nपश्यमाना हि दह्यामि शोकेनाहं जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2070619, "chapter_id": 2484, "verse_number": "११-१६-२६", "content_sanskrit": "पाञ्चालानां कुरूणां च विनाशं मधुसूदन।\nपञ्चानामपि भूतानामहं वधमचिन्तयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2070620, "chapter_id": 2484, "verse_number": "११-१६-२७", "content_sanskrit": "तान्सुपर्णाश्च गृध्राश्च कर्षयन्त्यसृगुक्षितान्।\nविगृह्य चरणैर्गृध्रा भक्षयन्ति सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2070621, "chapter_id": 2484, "verse_number": "११-१६-२८", "content_sanskrit": "जयद्रथस्य कर्णस्य तथैव द्रोमभीष्मयोः।\nअभिमन्योर्विनाशं च कश्चिन्तयितुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2070622, "chapter_id": 2484, "verse_number": "११-१६-२९", "content_sanskrit": "अवध्यकल्पान्निहतान्गतसत्वानचेतसः।\nगृध्रकङ्कवलश्येनश्वसृगालसमावृतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2070623, "chapter_id": 2484, "verse_number": "११-१६-३०", "content_sanskrit": "अमर्षवशमापन्नान्दुर्योधनवशे स्थितान्।\nपश्येमान्पुरुषव्याघ्रान्संशान्तान्पावकानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2070624, "chapter_id": 2484, "verse_number": "११-१६-३१", "content_sanskrit": "शयनान्युचिताः सर्वे मृदूनि विमलानि च।\nविपन्नास्तेऽद्य वसुधां विवृतामधिशेरते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2070625, "chapter_id": 2484, "verse_number": "११-१६-३२", "content_sanskrit": "बन्दिभिः सततं काले स्तुवद्भिरभिनन्दिताः।\nशिवानामशिवा घोराः शृण्वन्ति विविधा गिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2070626, "chapter_id": 2484, "verse_number": "११-१६-३३", "content_sanskrit": "ये पुरा शेरते वीराः शयनेषु यशस्विनः।\nचन्दनागुरुदिग्धाङ्गास्तेऽद्य पांसुषु शेरते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2070627, "chapter_id": 2484, "verse_number": "११-१६-३४", "content_sanskrit": "तेषामाभरणान्येते गृघ्रगोमायुवायसाः।\nआक्षिपन्ति शिवा घोरा विनदन्त्यः पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2070628, "chapter_id": 2484, "verse_number": "११-१६-३५", "content_sanskrit": "बाणान्वनिनिशितान्पीतान्निस्त्रिंशान्विमला गदाः।\nयुद्धाभिमानिनः सर्वे जीवन्त इव बिभ्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2070629, "chapter_id": 2484, "verse_number": "११-१६-३६", "content_sanskrit": "सुरूपवर्णा बहवः क्रव्यादैरवघट्टिताः।\nऋषभप्रतिरूपाक्षाः शेरते च सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2070630, "chapter_id": 2484, "verse_number": "११-१६-३७", "content_sanskrit": "अपरे पुनरालिङ्ग्य गदाः परिघबाहवः।\nशेरतेऽभिमुखाः शूरा दयिता इव योषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2070631, "chapter_id": 2484, "verse_number": "११-१६-३८", "content_sanskrit": "बिभ्रतः कवचान्यन्ये विमलान्यायुधानि च।\nन धर्षयन्ति क्रव्यादा जीवन्तीति जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2070632, "chapter_id": 2484, "verse_number": "११-१६-३९", "content_sanskrit": "क्रव्यादैः कृष्यमाणानामपरेषां महात्मनाम्।\nशातकौम्भ्यः स्रजश्चित्रा विप्रकीर्णाः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2070633, "chapter_id": 2484, "verse_number": "११-१६-४०", "content_sanskrit": "एते गोमायवो भीमा निहतानां यशस्विनाम्।\nकण्ठान्तरगतान्हारानाक्षिपन्ति सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2070634, "chapter_id": 2484, "verse_number": "११-१६-४१", "content_sanskrit": "सर्वेष्वपररात्रेषु यानवन्दन्त बन्दिनः।\nस्तुतिभिश्च परार्ध्याभिरुपचारैश्च शिक्षिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2070635, "chapter_id": 2484, "verse_number": "११-१६-४२", "content_sanskrit": "तानद्य परिदेवन्ति दुःखार्ता परमाङ्गनाः।\nकृपणा वृष्णिशार्दूल दुःखशोकार्दिता भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2070636, "chapter_id": 2484, "verse_number": "११-१६-४३", "content_sanskrit": "रक्तोत्पलवनानीव विभान्ति रुचिराणि च।\nमुखानि परमस्त्रीणां परिशुष्काणि केशव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2070637, "chapter_id": 2484, "verse_number": "११-१६-४४", "content_sanskrit": "रुदित्वा विरता ह्येता ध्यायन्त्यः सपरिक्लमाः।\nकुरुस्त्रियोऽभिगच्छन्ति तेन तेनैव दुःखिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2070638, "chapter_id": 2484, "verse_number": "११-१६-४५", "content_sanskrit": "एतान्यादित्यवर्णानि तपमीयनिभानि च।\nपश्य रोदनताम्राणि वक्त्राणि कुरुयोषिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2070639, "chapter_id": 2484, "verse_number": "११-१६-४६", "content_sanskrit": "श्यामानां वरवर्णानां गौरीणामेकवाससाम्।\nदुर्योधनवरस्त्रीणां पश्य वृन्दानि केशव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2070640, "chapter_id": 2484, "verse_number": "११-१६-४७", "content_sanskrit": "आसामपरिपूर्णार्थं निशम्य परिदेवितम्।\nइतरेरसङ्क्रन्दान्न विजानन्ति योषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2070641, "chapter_id": 2484, "verse_number": "११-१६-४८", "content_sanskrit": "एता दीर्घमिवोच्छ्वस्य विक्रुश्य च विलप्य च।\nविस्पन्दमाना दुःखेन वीरा जहति जीवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2070642, "chapter_id": 2484, "verse_number": "११-१६-४९", "content_sanskrit": "बह्व्यो दृष्ट्व शरीराणि क्रोशन्ति विलपन्ति च।\nपाणिभिश्चापरा घ्नन्ति शिरांसि मृदुपाणयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2070643, "chapter_id": 2484, "verse_number": "११-१६-५०", "content_sanskrit": "शिरोभिः पतितैर्हस्तैः सर्वाङ्गैः खण्डशः कृतैः।\nइतरेतसम्पृक्तैराकीर्णा भाति मेदिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2070644, "chapter_id": 2484, "verse_number": "११-१६-५१", "content_sanskrit": "विशिरस्कानथो कायान्दृष्ट्वा ह्येताननिन्दितान्।\nमुह्यन्त्यनुचिता नार्यो विदेहानि शिरांसि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2070645, "chapter_id": 2484, "verse_number": "११-१६-५२", "content_sanskrit": "शिरः कायेन सन्धाय प्रेक्षमाणा विचेतसः।\nअपश्यन्त्योऽपरं तत्र नेदमस्येऽति दुःखिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2070646, "chapter_id": 2484, "verse_number": "११-१६-५३", "content_sanskrit": "बाहूरुचरणानन्यान्विशिखोन्मथितान्पृथक्।\nसन्दधत्योऽसुखाविष्टा मूर्छन्त्येताः पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2070647, "chapter_id": 2484, "verse_number": "११-१६-५४", "content_sanskrit": "उत्कृत्तशिरसश्चान्यान्विजग्धान्मृगपक्षिभिः।\nदृष्ट्वा काश्चिन्न जानन्ति भर्तॄन्भरतयोषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2070648, "chapter_id": 2484, "verse_number": "११-१६-५५", "content_sanskrit": "पाणिभिश्चापरा घ्नन्ति शिरांसि मधुसूदन।\nप्रेक्ष्य भ्रातॄन्पितॄन्पुत्रान्पतींश्च निहतान्परैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2070649, "chapter_id": 2484, "verse_number": "११-१६-५६", "content_sanskrit": "बाहुभिश्च सखङ्गैश्च शिरोभिश्च सकुण्डलैः।\nअगम्यकल्पा पृथिवी मांसशोणितकर्दमा।\nबभूव भरतश्रेष्ठ प्राणिभिर्गतजीवितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2070650, "chapter_id": 2484, "verse_number": "११-१६-५७", "content_sanskrit": "न दुःखेषूचिताः पूर्वं दुःखं गाहन्त्यनिन्दिताः।\nभ्रातृभिः पतिभिः पुत्रैरुपाकीर्णां वसुन्धराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2070651, "chapter_id": 2484, "verse_number": "११-१६-५८", "content_sanskrit": "यूथानीव किशोरीणां सुकेशीनां जनार्दन।\nस्नुषाणां धृतराष्ट्रस्य पश्य वृन्दान्यनेकशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2070652, "chapter_id": 2484, "verse_number": "११-१६-५९", "content_sanskrit": "इतो दुःखतरं किन्नु केशव प्रतिभाति मे।\nयदिमाः कुर्वते सर्वा रवमुच्चावचं स्त्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2070653, "chapter_id": 2484, "verse_number": "११-१६-६०", "content_sanskrit": "नूनमाचरितं पापं मया पूर्वेषु जन्मसु।\nया पश्यामि हतान्पुत्रान्पौत्रान्भ्रातृंश्च माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2070654, "chapter_id": 2484, "verse_number": "११-१६-६१", "content_sanskrit": "एवमार्ता विलपती समाभाष्य जनार्दनम्।\nगान्धारी पुत्रशोकार्ता द्वदर्श निहतं सुतम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2070655, "chapter_id": 2484, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते स्त्रीपर्वणि स्त्रीविलापपर्वणि षोडशोऽध्यायः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]