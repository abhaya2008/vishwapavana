[{"id": 7003199000, "chapter_id": 23199, "verse_number": "१-२-१", "content_sanskrit": "सूत उवाच  ।\nईशानकल्पवृत्तांतमधिकृत्य महात्मना  ।\nब्रह्मणा कल्पितं पूर्वं पुराणं लौंगमुत्तमम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003199001, "chapter_id": 23199, "verse_number": "१-२-२", "content_sanskrit": "ग्रंथकोटिप्रमाणं तु शतकोटि प्रवीस्तरे  ।\nचतुर्लक्षेण संक्षिप्ते व्यासैः सर्वांतरेषु वै ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003199002, "chapter_id": 23199, "verse_number": "१-२-३", "content_sanskrit": "व्यस्तेष्टादशधा चैव ब्रह्मादौ द्वापरादिषु  ।\nलिंगमेकादशं प्रोक्तं मया व्यासाच्छ्रुतं च तत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003199003, "chapter_id": 23199, "verse_number": "१-२-४", "content_sanskrit": "अस्यैकादशसाहस्रे ग्रंथमानमिह द्विजाः  ।\nतस्मात्संक्षेपतो वक्ष्ये न श्रुतं विस्तरेण यत् ॥४।।॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003199004, "chapter_id": 23199, "verse_number": "१-२-५", "content_sanskrit": "चतुर्लक्षेण संक्षिप्ते कृष्णद्वैपायनेन तु  ।\nअत्रैकादशसाहस्रैः कथितो लिंगसंभवः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003199005, "chapter_id": 23199, "verse_number": "१-२-६", "content_sanskrit": "सर्गः प्राधानिकः पश्चात् प्राकृतो वैकृतानि च  ।\nअंडस्यास्य च संभूतिरंडस्यावरणाष्टकम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003199006, "chapter_id": 23199, "verse_number": "१-२-७", "content_sanskrit": "अंडोद्भवत्वं शर्वस्य रजोगुणसमाश्रयात्  ।\nविष्णुत्वं कालरुद्रत्वं शयनं चाप्सु तस्य च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003199007, "chapter_id": 23199, "verse_number": "१-२-८", "content_sanskrit": "प्रजापतीनां सर्गश्च पृथिव्युद्धरणं तथा  ।\nब्रह्मणश्च दिवारात्रमायुषो गणनं पुनः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003199008, "chapter_id": 23199, "verse_number": "१-२-९", "content_sanskrit": "सवनं ब्रह्मणश्चैव युगकल्पश्च तस्य तु  ।\nदिव्यं च मानुषं वर्षमार्षं वै ध्रौव्यमेव च ॥९।।॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003199009, "chapter_id": 23199, "verse_number": "१-२-१०", "content_sanskrit": "पित्र्यं पितॄणांसंभूतिधर्मश्चाश्रमिणां तथा  ।\nअवृद्धिर्जगतो भूयो देव्याः शक्त्युद्भवस्तथा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003199010, "chapter_id": 23199, "verse_number": "१-२-११", "content_sanskrit": "स्त्रीपुंभावो विरिंचस्य सर्गो मिथुनसंभवः  ।\nआख्याष्टकं हि रुद्रस्य कथितं रोदनांतरे ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003199011, "chapter_id": 23199, "verse_number": "१-२-१२", "content_sanskrit": "ब्रह्मविष्णुविवादश्च पुनर्लिंगस्य संभवः  ।\nशिलादस्य तपश्चैव वृत्रारेर्दर्शनं तथा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003199012, "chapter_id": 23199, "verse_number": "१-२-१३", "content_sanskrit": "प्रार्थनायोनिजस्याथ दुर्लभत्वं सुतस्य तु  ।\nशिलादशक्रसंवादः पद्मयोनित्वमेव च ॥१३।।॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003199013, "chapter_id": 23199, "verse_number": "१-२-१४", "content_sanskrit": "भवस्य दर्शनं चैव तिष्येष्वाचार्यशिष्ययोः  ।\nव्यासावताराश्च तथा कल्पमन्वंतराणि च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003199014, "chapter_id": 23199, "verse_number": "१-२-१५", "content_sanskrit": "कल्पत्वं चैव कल्पानामाख्याभेदेष्वनुक्रमात्  ।\nकल्पेषु कल्पे वाराहे वाराहत्वं हरेस्तथा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003199015, "chapter_id": 23199, "verse_number": "१-२-१६", "content_sanskrit": "मेघवाहनकल्पस्य वृत्तांतं रुद्र गौरवम् ।\nपुनर्लिंगोद्भवश्चैव ऋषिमध्ये पिनाकिनः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003199016, "chapter_id": 23199, "verse_number": "१-२-१७", "content_sanskrit": "लिंगस्याराधनं स्नानविधानं शौचलक्षणम्  ।\nवाराणस्याश्च महात्म्यं क्षेत्रमाहात्म्यवर्णनम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003199017, "chapter_id": 23199, "verse_number": "१-२-१८", "content_sanskrit": "भुवि रुद्रालयानां तु संख्या विष्णोर्गृहस्य च  ।\nअंतरिक्षे तथांडेऽस्मिन् देवायतनवर्णनम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003199018, "chapter_id": 23199, "verse_number": "१-२-१९", "content_sanskrit": "दक्षस्य पतनं भूमौ पुनः स्वारोचिषेऽन्तरे  ।\nदक्षशापश्च दक्षस्य शापमोक्षस्तथैव च ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003199019, "chapter_id": 23199, "verse_number": "१-२-२०", "content_sanskrit": "कैलासवर्णनं चैव योगः पाशुपतस्तथा  ।\nचतुर्युगप्रमाणं च युगधर्मः सुविस्तरः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003199020, "chapter_id": 23199, "verse_number": "१-२-२१", "content_sanskrit": "संध्यांशकप्रमाणं च संध्यावृत्तं भवस्य च  ।\nश्मशाननिलयश्चैव चंद्ररेखासमुद्भवः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003199021, "chapter_id": 23199, "verse_number": "१-२-२२", "content_sanskrit": "उद्वाहः शंकरस्याथ पुत्रोत्पादनमेव च  ।\nमैथुनातिग्रसंगेन विनाशो जगतां भयम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003199022, "chapter_id": 23199, "verse_number": "१-२-२३", "content_sanskrit": "शापः सत्या कृतो देवान्पुरा विष्णुं च पालितम्  ।\nशुक्रोत्सर्गस्तु रुद्रस्य गांगेयोद्भव एव च ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003199023, "chapter_id": 23199, "verse_number": "१-२-२४", "content_sanskrit": "ग्रहणादिषु कालेषु स्नाप्य लिंगं फलं तथा ।\nक्षुब्दधीचविवादश्च दधी चोपेंद्रयोस्तथा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003199024, "chapter_id": 23199, "verse_number": "१-२-२५", "content_sanskrit": "उत्पत्तिर्नंदिनाम्ना तु देवदेवस्य शूलिनः  ।\nपतिव्रतायाश्चाख्यानं पशुपाशविचारणा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003199025, "chapter_id": 23199, "verse_number": "१-२-२६", "content_sanskrit": "प्रवृत्तिलक्षणं ज्ञानं निवृत्त्यधिकृता तथा  ।\nवसिष्ठतनयोत्पत्तिर्वासिष्ठानां महात्मनाम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003199026, "chapter_id": 23199, "verse_number": "१-२-२७", "content_sanskrit": "मुनीनां वंशविस्तारो राज्ञां शक्तेर्विनाशनम्  ।\nदौरात्म्यं कौशिकस्याथ सुरभेर्बंधनं तथा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003199027, "chapter_id": 23199, "verse_number": "१-२-२८", "content_sanskrit": "सुतशोको वसिष्ठस्य अरुंधत्याः प्रलापनम्  ।\nस्नुषायाः प्रेषणं चैव गर्भस्थस्य वचस्तथा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003199028, "chapter_id": 23199, "verse_number": "१-२-२९", "content_sanskrit": "पराशरस्यावतारो व्यासस्य च शुकस्य च  ।\nविनाशो राक्षसानां च कृतो वै शक्तिसूनुना ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003199029, "chapter_id": 23199, "verse_number": "१-२-३०", "content_sanskrit": "देवतापरमार्थं तु विज्ञानं च प्रसादतः  ।\nपुराणकरणं चैव पुलस्त्यस्याज्ञया गुरोः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003199030, "chapter_id": 23199, "verse_number": "१-२-३१", "content_sanskrit": "भुवनानां प्रमाणं च ग्रहाणां ज्योतिषां गतिः  ।\nजीवच्छ्राद्धविधानं च श्राद्धार्हाः श्राद्धमेव च ॥३१।।॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003199031, "chapter_id": 23199, "verse_number": "१-२-३२", "content_sanskrit": "नांदीश्राद्धविधानं च तथाध्ययन लक्षणम्  ।\nपंचयज्ञप्रभावश्च पंचयज्ञविधिस्तथा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003199032, "chapter_id": 23199, "verse_number": "१-२-३३", "content_sanskrit": "रजस्वलानां वृत्तिश्च वृत्त्या पुत्रविशिष्टता  ।\nमैथुनस्य विधिश्चैव प्रतिवर्णमनुक्रमात् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003199033, "chapter_id": 23199, "verse_number": "१-२-३४", "content_sanskrit": "भोज्याभोज्यविधानं च सर्वेषामेव वर्णिनाम्  ।\nप्रायश्चित्तमशेषस्य प्रत्येकं चैव विस्तरात् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003199034, "chapter_id": 23199, "verse_number": "१-२-३५", "content_sanskrit": "नरकाणां स्वरूपं च दंडः कर्मानुरूपतः  ।\nस्वर्गिनारकिणां पुंसां चिह्नं जन्मांतरेषु च ॥३५।।॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003199035, "chapter_id": 23199, "verse_number": "१-२-३६", "content_sanskrit": "नानाविधानि दानानि प्रेतराजपुरं तथा  ।\nकल्पं पंचाक्षरस्याथ रुद्रमाहात्म्यमेव च ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003199036, "chapter_id": 23199, "verse_number": "१-२-३७", "content_sanskrit": "वृत्रेंद्रयोर्महायुद्धं विश्वरूपविमर्दनम्  ।\nश्वेतस्य मृत्योः संवादः श्वेतार्थे कालनाशनम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003199037, "chapter_id": 23199, "verse_number": "१-२-३८", "content_sanskrit": "देवदारुवने शंभोः प्रवेशः शंकरस्य तु  ।\nसुदर्शनस्य चाख्यानं क्रमसंन्यासलक्षणम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003199038, "chapter_id": 23199, "verse_number": "१-२-३९", "content_sanskrit": "श्रद्धासाद्ध्योथ रुद्रस्तु कथितं ब्रह्मणा तदा  ।\nमधुना कैटभेनैव पुरा हृतगतेर्विभोः ॥३९।।॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003199039, "chapter_id": 23199, "verse_number": "१-२-४०", "content_sanskrit": "ब्रह्मणः परमं ज्ञानमादातुं मीनता हरेः  ।\nसर्वावस्थासु विष्णोश्च जननं लीलयैव तु ॥४०।।॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003199040, "chapter_id": 23199, "verse_number": "१-२-४१", "content_sanskrit": "रुद्रप्रसादाद्विष्णोश्च जिष्णोश्चैव तु संभवः  ।\nमंथानधारणार्थाय हरेः कूर्मत्वमेवच ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003199041, "chapter_id": 23199, "verse_number": "१-२-४२", "content_sanskrit": "संकर्षणस्य चोत्पत्तिः कौशिक्याश्च पुनर्भवः  ।\nयद्वनां चैव संभूतिर्यादवत्वं हरेः स्वयम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003199042, "chapter_id": 23199, "verse_number": "१-२-४३", "content_sanskrit": "भोजराजस्य दौरात्म्यं मातुलस्य हरेर्विभोः ।\nबालभावे हरेः क्रीडा पुत्रार्थं शंकरार्चनम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003199043, "chapter_id": 23199, "verse_number": "१-२-४४", "content_sanskrit": "नारस्य च तथोत्पत्तिः कपाले वैष्णवाद्धरात्  ।\nभूभारनिग्रहार्थे तु रुद्रस्याराधनं हरेः ॥४४।।॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003199044, "chapter_id": 23199, "verse_number": "१-२-४५", "content_sanskrit": "वैन्येन पृथुना भूमेः पुरा दोहप्रवर्तनम्  ।\nदेवासुरे पुरा लब्धो भृगुशापश्च विष्णुना ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003199045, "chapter_id": 23199, "verse_number": "१-२-४६", "content_sanskrit": "कृष्णत्वे द्वारकायांतु निलयो माधवस्य तु  ।\nलब्धो हिताय शापस्तु दुर्वासस्याननाद्धरेः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003199046, "chapter_id": 23199, "verse_number": "१-२-४७", "content_sanskrit": "वृष्ण्यंधकविनाशाय शापः पिंडारवासिनाम्  ।\nएरकस्य तथोत्पत्तिस्तोमरस्योद्भवस्तथा ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003199047, "chapter_id": 23199, "verse_number": "१-२-४८", "content_sanskrit": "एरकालाभतोऽन्योन्यं विवादे वृष्णिविग्रहः  ।\nलीलया चैव कृष्णेन स्वकुलस्य च संहृतिः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003199048, "chapter_id": 23199, "verse_number": "१-२-४९", "content_sanskrit": "एरकास्त्रबलेनैव गमनं स्वेच्छयैव तु  ।\nब्रह्मणश्चैव मोक्षस्य विज्ञानं तु सुविस्तरम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003199049, "chapter_id": 23199, "verse_number": "१-२-५०", "content_sanskrit": "पुरांधकाग्निदक्षाणां शक्रेभमृगरूपिणाम्  ।\nमदनस्यादिदेवस्य ब्रह्मणश्चामरारिणाम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003199050, "chapter_id": 23199, "verse_number": "१-२-५१", "content_sanskrit": "हलाहलस्य दैत्यस्य कृतावज्ञा पिनाकिना  ।\nजालंधरवधश्चैव सुदर्शनसमुद्भवः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003199051, "chapter_id": 23199, "verse_number": "१-२-५२", "content_sanskrit": "विष्णोर्वरायुधावाप्तिस्तथा रुद्रस्य चेष्टितम्  ।\nतथान्यानि च रुद्रस्य चरितानि सहस्रशः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003199052, "chapter_id": 23199, "verse_number": "१-२-५३", "content_sanskrit": "हरेः पितामहस्याथ शक्रस्य च महात्मनः  ।\nप्रभावानुभवश्चैव शिवलोकस्य वर्णनम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003199053, "chapter_id": 23199, "verse_number": "१-२-५४", "content_sanskrit": "भूमौ रुद्रस्य लोकं च पाताले हाटकेश्वरम्  ।\nतपसां लक्षणं चैव द्विजानां वैभवं तथा ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003199054, "chapter_id": 23199, "verse_number": "१-२-५५", "content_sanskrit": "आधिक्यं सर्वमूर्तीनां लिंगमूर्तेर्विशेषतः  ।\nलिंगस्मिन्नानुपूर्व्येण विस्तरेणानुकीर्त्यते ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003199055, "chapter_id": 23199, "verse_number": "१-२-५६", "content_sanskrit": "एतज्ज्ञात्वा पुराणस्य संक्षेपं कीर्तयेत्तु यः  ।\nसर्वपापविनिर्मुक्तो ब्रह्मलोकं स गच्छति ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]