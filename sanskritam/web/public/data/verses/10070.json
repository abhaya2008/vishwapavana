[{"id": 6000070000, "chapter_id": 10070, "verse_number": null, "content_sanskrit": "अथ षष्ठाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000070001, "chapter_id": 10070, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_006/BhP_04.006.001.m4a", "display_order": 2}, {"id": 6000070002, "chapter_id": 10070, "verse_number": "४-६-१", "content_sanskrit": "भवो भवान्या निधनं प्रजापतेरसत्कृताया ह्यवगम्य नारदात्।\nस्वपार्षदसैन्यं च तदध्वरेशैर्विद्रावितं क्रोधमपारमादधे॥ ४/६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_006/BhP_04.006.002.m4a", "display_order": 3, "topics": [{"text": "सतीदेहत्यागं श्रुतवता शंकरेण रुषा स्‍वजटातो वीरभद्रस्योत्पादनम्", "range": "१–१२"}]}, {"id": 6000070003, "chapter_id": 10070, "verse_number": "४-६-२", "content_sanskrit": "क्रुद्धः सुदष्टोष्ठपुटः स धूर्जटिर्जटां तटिद्वह्निसटोग्ररोचिषम्।\nउत्कृत्य रौद्रः सहसोत्थितो हसन् गम्भीरनादो विससर्ज तां भुवि॥ ४/६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_006/BhP_04.006.003.m4a", "display_order": 4}, {"id": 6000070004, "chapter_id": 10070, "verse_number": "४-६-३", "content_sanskrit": "ततोऽतिकायस्तनुवा स्पृशन् दिवं सहस्रबाहुर्घनरक्तसूर्यदृक्।\nकरालदंष्ट्रो ज्वलदग्निमूर्धजः कपालमाली विविधोद्यतायुधः॥ ४/६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_006/BhP_04.006.004.m4a", "display_order": 5}, {"id": 6000070005, "chapter_id": 10070, "verse_number": "४-६-४", "content_sanskrit": "तं किं करोमीति गृणन्तमाह बद्धाञ्जलिं भगवान् भूतनाथः।\nदक्षं सयज्ञं जहि मद्भटानां त्वमग्रणी रुद्र जटांशको मे॥ ४/६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_006/BhP_04.006.005.m4a", "display_order": 6}, {"id": 6000070006, "chapter_id": 10070, "verse_number": "४-६-५", "content_sanskrit": "आज्ञप्त एवं कुपितेन मन्युना स देवदेवं परिचक्रमे विभुम्।\nमेने तदाऽऽत्मानमसङ्गरंहसं सहीयसां तात सहः सहिष्णुम्॥ ४/६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_006/BhP_04.006.006.m4a", "display_order": 7}, {"id": 6000070007, "chapter_id": 10070, "verse_number": "४-६-६", "content_sanskrit": "अन्वीयमानः स तु रुद्रपार्षदैर्भृशं नदद्भिर्व्यनदत् सुभैरवम्।\nउद्यम्य शूलं जगदन्तकान्तकं सम्प्राद्रवद् घोषणभूषणाङ्घ्रिः॥ ४/६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_006/BhP_04.006.007.m4a", "display_order": 8}, {"id": 6000070008, "chapter_id": 10070, "verse_number": "४-६-७", "content_sanskrit": "अथर्त्विजो यजमानः सदस्याः ककुभ्युदीच्यां प्रसमीक्ष्य रेणुम्।\nतमः किमेतत् कुत एतद् रजोऽभूदिति द्विजा द्विजपत्न्यश्च दध्युः॥ ४/६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_006/BhP_04.006.008.m4a", "display_order": 9}, {"id": 6000070009, "chapter_id": 10070, "verse_number": "४-६-८", "content_sanskrit": "वाता न वान्ति न हि सन्ति दस्यवः प्राचीनबर्हिर्जीवति होग्रदण्डः।\nगावो न काल्यन्त इदं कुतो रजो लोकोऽधुना किं प्रलयाय कल्पते॥ ४/६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_006/BhP_04.006.009.m4a", "display_order": 10}, {"id": 6000070010, "chapter_id": 10070, "verse_number": "४-६-९", "content_sanskrit": "प्रसूतिमिश्राः स्‍त्रिय उद्विग्नचित्ता ऊचुर्विपाको वृजिनस्यैव तस्य।\nयत्पश्यतीनां दुहितॄणां प्रजेशः सुतां सतीमवदध्यावनागसाम्॥ ४/६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_006/BhP_04.006.010.m4a", "display_order": 11}, {"id": 6000070011, "chapter_id": 10070, "verse_number": "४-६-१०", "content_sanskrit": "यस्त्वन्तकाले व्युप्तजटाकलापः स्वशूलसूच्यर्पितदिग्गजेन्द्रः।\nवितत्य नृत्यत्युदितास्‍त्रदोर्ध्वजो रूक्षाट्टाहासः स्तनयित्नुभिन्नदिक्॥ ४/६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_006/BhP_04.006.011.m4a", "display_order": 12}, {"id": 6000070012, "chapter_id": 10070, "verse_number": "४-६-११", "content_sanskrit": "अमर्षयित्वा तमसह्यतेजसं मन्युप्लुतं दुर्विषहं भ्रकुट्या।\nकरालदंष्ट्राभिरुदस्तभागणं स्यात् स्वस्ति किं कोपयतो विधातुः॥ ४/६/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_006/BhP_04.006.012.m4a", "display_order": 13}, {"id": 6000070013, "chapter_id": 10070, "verse_number": "४-६-१२", "content_sanskrit": "बह्वेवमुद्विग्नदृशोच्यमाने जनेन दक्षस्य मखे महात्मनः।\nउत्पेतुरुत्पाततमाः सहस्रशो भयावहा दिवि भूमौ च पर्यक्॥ ४/६/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_006/BhP_04.006.013.m4a", "display_order": 14}, {"id": 6000070014, "chapter_id": 10070, "verse_number": "४-६-१३", "content_sanskrit": "तावत् स रुद्रानुचरैर्मखो महान् नानाविधैर्वामनकैरुदायुधैः।\nपिङ्गैः पिशङ्गैर्मकरोदराननैः पर्याप्लुवद्भिर्विदुरान्वरुध्यत॥ ४/६/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_006/BhP_04.006.014.m4a", "display_order": 15, "topics": [{"text": "रुदानुचरैः दक्षयज्ञशालानाशनम्", "range": "१३–२१"}]}, {"id": 6000070015, "chapter_id": 10070, "verse_number": "४-६-१४", "content_sanskrit": "केचिद् बभञ्जुः प्राग्वंशं पत्नीशालां तथाऽपरे।\nसद आग्नीध्रशालां च तद्विहारं महानसम्॥ ४/६/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_006/BhP_04.006.015.m4a", "display_order": 16}, {"id": 6000070016, "chapter_id": 10070, "verse_number": "४-६-१५", "content_sanskrit": "रुरुजुर्यज्ञपात्राणि तथैकेऽग्नीननाशयन्।\nकुण्डेष्वमूत्रयन् केचिद् बिभिदुर्वेदिमेखलाः॥ ४/६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_006/BhP_04.006.016.m4a", "display_order": 17}, {"id": 6000070017, "chapter_id": 10070, "verse_number": "४-६-१६", "content_sanskrit": "अबाधन्त मुनीनन्य एके पत्नीरतर्जयन्।\nअपरे जगृहुर्देवान् प्रत्यासन्नान् पलायितान्॥ ४/६/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_006/BhP_04.006.017.m4a", "display_order": 18}, {"id": 6000070018, "chapter_id": 10070, "verse_number": "४-६-१७", "content_sanskrit": "भृगुं बबन्ध मणिमान् वीरभद्रः प्रजापतिम्।\nचण्डीशः पूषणं देवं भगं नन्दीश्वरोऽग्रहीत्॥ ४/६/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_006/BhP_04.006.018.m4a", "display_order": 19}, {"id": 6000070019, "chapter_id": 10070, "verse_number": "४-६-१८", "content_sanskrit": "सर्व एवर्त्विजो दृष्ट्वा सदस्याः सदिवौकसः।\nतैरर्द्यमानाः सुभृशं ग्रावभिर्नैकधाऽद्रवन्॥ ४/६/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_006/BhP_04.006.019.m4a", "display_order": 20}, {"id": 6000070020, "chapter_id": 10070, "verse_number": "४-६-१९", "content_sanskrit": "जुह्वतः स्रुवहस्तस्य श्मश्रूणि भगवान् भवः।\nभृगोर्लुलुञ्चे सदसि योऽहसत् श्मश्रु दर्शयन्॥ ४/६/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_006/BhP_04.006.020.m4a", "display_order": 21}, {"id": 6000070021, "chapter_id": 10070, "verse_number": "४-६-२०", "content_sanskrit": "भगस्य नेत्रे भगवान् पतितस्य रुषा भुवि।\nउज्जहार सदःस्थोऽक्ष्णा यः शपन्तमसूचयत्॥ ४/६/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_006/BhP_04.006.021.m4a", "display_order": 22}, {"id": 6000070022, "chapter_id": 10070, "verse_number": "४-६-२१", "content_sanskrit": "पूष्णश्चापातयद् दन्तान् कलिङ्गस्य यथा बलः।\nशप्यमाने गरिमणि योऽहसद् दर्शयन् दतः॥ ४/६/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_006/BhP_04.006.022.m4a", "display_order": 23}, {"id": 6000070023, "chapter_id": 10070, "verse_number": "४-६-२२", "content_sanskrit": "आक्रम्योरसि दक्षस्य शितधारेण हेतिना।\nछिन्दन्नपि तदुद्धर्तुं नाशक्नोत् त्र्यम्बकस्तदा॥ ४/६/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_006/BhP_04.006.023.m4a", "display_order": 24, "topics": [{"text": "रुद्रेण दक्षशिरोहरणम्", "range": "२२–२६"}]}, {"id": 6000070024, "chapter_id": 10070, "verse_number": "४-६-२३", "content_sanskrit": "शस्‍त्रैरस्‍त्रान्वितैरेनमनिर्भिण्णत्वचं हरः।\nविस्मयं परमापन्नो दध्यौ पशुपतिश्चिरम्॥ ४/६/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_006/BhP_04.006.024.m4a", "display_order": 25}, {"id": 6000070025, "chapter_id": 10070, "verse_number": "४-६-२४", "content_sanskrit": "दृष्ट्वा सञ्ज्ञपने योगं पशूनां स पतिर्मखे।\nयजमानपशोः कस्य कायात् तेनाहरच्छिरः॥ ४/६/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_006/BhP_04.006.025.m4a", "display_order": 26}, {"id": 6000070026, "chapter_id": 10070, "verse_number": "४-६-२५", "content_sanskrit": "साधुवादस्तदा तेषां कर्म तत् तस्य शंसताम्।\nभूतप्रेतपिशाचानामन्येषां तद्विपर्ययः॥ ४/६/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_006/BhP_04.006.026.m4a", "display_order": 27}, {"id": 6000070027, "chapter_id": 10070, "verse_number": "४-६-२६", "content_sanskrit": "जुहावैतच्छिरस्तस्य दक्षिणाग्नावमर्षितः।\nतद् देवयजनं दग्ध्वा प्रातिष्ठद् गुह्यकालयम्॥ ४/६/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_006/BhP_04.006.027.m4a", "display_order": 28}, {"id": 6000070028, "chapter_id": 10070, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां चतुर्थस्कन्धे षष्ठाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]