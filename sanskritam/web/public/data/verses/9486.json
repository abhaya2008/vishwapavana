[{"id": 5000486000, "chapter_id": 9486, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे एकोनाशीतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000486001, "chapter_id": 9486, "verse_number": "६-७९-१", "content_sanskrit": "निर्गतं मकराक्षं ते दृष्ट्वा वानरपुंगवाः।\nआप्लुत्य सहसा सर्वे योद्धुकामा व्यवस्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000486002, "chapter_id": 9486, "verse_number": "६-७९-२", "content_sanskrit": "ततः प्रवृत्तं सुमहत् तद् युद्धं लोमहर्षणम्।\nनिशाचरैः प्लवंगानां देवानां दानवैरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000486003, "chapter_id": 9486, "verse_number": "६-७९-३", "content_sanskrit": "वृक्षशूलनिपातैश्च गदापरिघपातनैः।\nअन्योन्यं मर्दयन्ति स्म तदा कपिनिशाचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000486004, "chapter_id": 9486, "verse_number": "६-७९-४", "content_sanskrit": "शक्तिखड्गगदाकुन्तैस्तोमरैश्च निशाचराः।\nपट्टिशैर्भिन्दिपालैश्च बाणपातैः समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000486005, "chapter_id": 9486, "verse_number": "६-७९-५", "content_sanskrit": "पाशमुद‍्गरदण्डैश्च निर्घातैश्चापरैस्तथा।\nकदनं कपिसिंहानां चक्रुस्ते रजनीचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000486006, "chapter_id": 9486, "verse_number": "६-७९-६", "content_sanskrit": "बाणौघैरर्दिताश्चापि खरपुत्रेण वानराः।\nसम्भ्रान्तमनसः सर्वे दुद्रुवुर्भयपीडिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000486007, "chapter_id": 9486, "verse_number": "६-७९-७", "content_sanskrit": "तान् दृष्ट्वा राक्षसाः सर्वे द्रवमाणान् वनौकसः।\nनेदुस्ते सिंहवद् दृप्ता राक्षसा जितकाशिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000486008, "chapter_id": 9486, "verse_number": "६-७९-८", "content_sanskrit": "विद्रवत्सु तदा तेषु वानरेषु समन्ततः।\nरामस्तान् वारयामास शरवर्षेण राक्षसान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000486009, "chapter_id": 9486, "verse_number": "६-७९-९", "content_sanskrit": "वारितान् राक्षसान् दृष्ट्वा मकराक्षो निशाचरः।\nकोपानलसमाविष्टो वचनं चेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000486010, "chapter_id": 9486, "verse_number": "६-७९-१०", "content_sanskrit": "तिष्ठ राम मया सार्धं द्वन्द्वयुद्धं भविष्यति।\nत्याजयिष्यामि ते प्राणान् धनुर्मुक्तैः शितैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000486011, "chapter_id": 9486, "verse_number": "६-७९-११", "content_sanskrit": "यत् तदा दण्डकारण्ये पितरं हतवान् मम।\nतदग्रतः स्वकर्मस्थं स्मृत्वा रोषोऽभिवर्धते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000486012, "chapter_id": 9486, "verse_number": "६-७९-१२", "content_sanskrit": "दह्यन्ते भृशमङ्गानि दुरात्मन् मम राघव।\nयन्मयासि न दृष्टस्त्वं तस्मिन् काले महावने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000486013, "chapter_id": 9486, "verse_number": "६-७९-१३", "content_sanskrit": "दिष्ट्यासि दर्शनं राम मम त्वं प्राप्तवानिह।\nकांक्षितोऽसि क्षुधार्तस्य सिंहस्येवेतरो मृगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000486014, "chapter_id": 9486, "verse_number": "६-७९-१४", "content_sanskrit": "अद्य मद‍्बाणवेगेन प्रेतराड‍‍्विषयं गतः।\nये त्वया निहताः शूराः सह तैश्च वसिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000486015, "chapter_id": 9486, "verse_number": "६-७९-१५", "content_sanskrit": "बहुनात्र किमुक्तेन शृणु राम वचो मम।\nपश्यन्तु सकला लोकास्त्वां मां चैव रणाजिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000486016, "chapter_id": 9486, "verse_number": "६-७९-१६", "content_sanskrit": "अस्त्रैर्वा गदया वापि बाहुभ्यां वा रणाजिरे।\nअभ्यस्तं येन वा राम वर्ततां तेन वा मृधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000486017, "chapter_id": 9486, "verse_number": "६-७९-१७", "content_sanskrit": "मकराक्षवचः श्रुत्वा रामो दशरथात्मजः।\nअब्रवीत् प्रहसन् वाक्यमुत्तरोत्तरवादिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000486018, "chapter_id": 9486, "verse_number": "६-७९-१८", "content_sanskrit": "कत्थसे किं वृथा रक्षो बहून्यसदृशानि ते।\nन रणे शक्यते जेतुं विना युद्धेन वाग्बलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000486019, "chapter_id": 9486, "verse_number": "६-७९-१९", "content_sanskrit": "चतुर्दश सहस्राणि रक्षसां त्वत्पिता च यः।\nत्रिशिरा दूषणश्चापि दण्डके निहतो मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000486020, "chapter_id": 9486, "verse_number": "६-७९-२०", "content_sanskrit": "स्वाशिताश्चापि मांसेन गृध्रगोमायुवायसाः।\nभविष्यन्त्यद्य वै पाप तीक्ष्णतुण्डनखाङ्कुशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000486021, "chapter_id": 9486, "verse_number": "६-७९-२१", "content_sanskrit": "राघवेणैवमुक्तस्तु मकराक्षो महाबलः।\nबाणौघानमुचत् तस्मै राघवाय रणाजिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000486022, "chapter_id": 9486, "verse_number": "६-७९-२२", "content_sanskrit": "ताञ्छराञ्छरवर्षेण रामश्चिच्छेद नैकधा।\nनिपेतुर्भुवि विच्छिन्ना रुक्मपुङ्खाः सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000486023, "chapter_id": 9486, "verse_number": "६-७९-२३", "content_sanskrit": "तद् युद्धमभवत् तत्र समेत्यान्योन्यमोजसा।\nखरराक्षसपुत्रस्य सूनोर्दशरथस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000486024, "chapter_id": 9486, "verse_number": "६-७९-२४", "content_sanskrit": "जीमूतयोरिवाकाशे शब्दो ज्यातलयोरिव।\nधनुर्मुक्तः स्वनोऽन्योन्यं श्रूयते च रणाजिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000486025, "chapter_id": 9486, "verse_number": "६-७९-२५", "content_sanskrit": "देवदानवगन्धर्वाः किंनराश्च महोरगाः।\nअन्तरिक्षगताः सर्वे द्रष्टुकामास्तदद्भुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000486026, "chapter_id": 9486, "verse_number": "६-७९-२६", "content_sanskrit": "विद्धमन्योन्यगात्रेषु द्विगुणं वर्धते बलम्।\nकृतप्रतिकृतान्योन्यं कुरुतां तौ रणाजिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000486027, "chapter_id": 9486, "verse_number": "६-७९-२७", "content_sanskrit": "राममुक्तांस्तु बाणौघान् राक्षसस्त्वच्छिनद् रणे।\nरक्षोमुक्तांस्तु रामो वै नैकधा प्राच्छिनच्छरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000486028, "chapter_id": 9486, "verse_number": "६-७९-२८", "content_sanskrit": "बाणौघवितताः सर्वा दिशश्च प्रदिशस्तथा।\nसंछन्ना वसुधा चैव समन्तान्न प्रकाशते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000486029, "chapter_id": 9486, "verse_number": "६-७९-२९", "content_sanskrit": "ततः क्रुद्धो महाबाहुर्धनुश्चिच्छेद संयुगे।\nअष्टाभिरथ नाराचैः सूतं विव्याध राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000486030, "chapter_id": 9486, "verse_number": "६-७९-३०", "content_sanskrit": "भित्त्वा रथं शरै रामो हत्वा अश्वानपातयत्।\nविरथो वसुधास्थः स मकराक्षो निशाचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000486031, "chapter_id": 9486, "verse_number": "६-७९-३१", "content_sanskrit": "तत्तिष्ठद् वसुधां रक्षः शूलं जग्राह पाणिना।\nत्रासनं सर्वभूतानां युगान्ताग्निसमप्रभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000486032, "chapter_id": 9486, "verse_number": "६-७९-३२", "content_sanskrit": "दुरवापं महच्छूलं रुद्रदत्तं भयंकरम्।\nजाज्वल्यमानमाकाशे संहारास्त्रमिवापरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000486033, "chapter_id": 9486, "verse_number": "६-७९-३३", "content_sanskrit": "यं दृष्ट्वा देवताः सर्वा भयार्ता विद्रुता दिशः।\nविभ्राम्य च महच्छूलं प्रज्वलन्तं निशाचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000486034, "chapter_id": 9486, "verse_number": "६-७९-३४", "content_sanskrit": "स क्रोधात् प्राहिणोत् तस्मै राघवाय महाहवे।\nतमापतन्तं ज्वलितं खरपुत्रकराच्च्युतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000486035, "chapter_id": 9486, "verse_number": "६-७९-३५", "content_sanskrit": "बाणैश्चतुर्भिराकाशे शूलं चिच्छेद राघवः।\nस भिन्नो नैकधा शूलो दिव्यहाटकमण्डितः।\nव्यशीर्यत महोल्केव रामबाणार्दितो भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000486036, "chapter_id": 9486, "verse_number": "६-७९-३६", "content_sanskrit": "तच्छूलं निहतं दृष्ट्वा रामेणाक्लिष्टकर्मणा।\nसाधु साध्विति भूतानि व्याहरन्ति नभोगताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000486037, "chapter_id": 9486, "verse_number": "६-७९-३७", "content_sanskrit": "तं दृष्ट्वा निहतं शूलं मकराक्षो निशाचरः।\nमुष्टिमुद्यम्य काकुत्स्थं तिष्ठ तिष्ठेति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000486038, "chapter_id": 9486, "verse_number": "६-७९-३८", "content_sanskrit": "स तं दृष्ट्वा पतन्तं तु प्रहस्य रघुनन्दनः।\nपावकास्त्रं ततो रामः संदधे तु शरासने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000486039, "chapter_id": 9486, "verse_number": "६-७९-३९", "content_sanskrit": "तेनास्त्रेण हतं रक्षः काकुत्स्थेन तदा रणे।\nसंछिन्नहृदयं तत्र पपात च ममार च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000486040, "chapter_id": 9486, "verse_number": "६-७९-४०", "content_sanskrit": "दृष्ट्वा ते राक्षसाः सर्वे मकराक्षस्य पातनम्।\nलङ्कामेव प्रधावन्त रामबाणभयार्दिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000486041, "chapter_id": 9486, "verse_number": "६-७९-४१", "content_sanskrit": "दशरथनृपसूनुबाणवेगै\nरजनिचरं निहतं खरात्मजं तम्।\nप्रददृशुरथ देवताः प्रहृष्टा\nगिरिमिव वज्रहतं यथा विकीर्णम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000486042, "chapter_id": 9486, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे एकोनाशीतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]