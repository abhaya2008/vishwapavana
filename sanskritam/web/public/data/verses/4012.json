[{"id": 2139218, "chapter_id": 4012, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2139219, "chapter_id": 4012, "verse_number": "१", "content_sanskrit": "एवं विलपमानायां पाञ्चाल्यां मत्स्यपुङ्गवः ।\nअशक्तः कीचकं तत्र शासितुं वरदर्पितम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2139220, "chapter_id": 4012, "verse_number": "२", "content_sanskrit": "विराटराजः सूतं तु सान्त्वेनैव न्यवारयत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2139221, "chapter_id": 4012, "verse_number": "३", "content_sanskrit": "कीचकं मत्स्यराजेन कृतागसमनिन्दिता ।\nनापराधानुरूपेण दण्डेन प्रतिपादितम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2139222, "chapter_id": 4012, "verse_number": "४", "content_sanskrit": "पाञ्चालराजस्य सुता दृष्ट्वा सुरसुतोपमा ।\nधर्मज्ञा व्यवहाराणां कीचकं कृतकिल्बिषम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2139223, "chapter_id": 4012, "verse_number": "५", "content_sanskrit": "पुनः प्रोवाच राजानं स्मरन्ती धर्ममुत्तमम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2139224, "chapter_id": 4012, "verse_number": "६", "content_sanskrit": "सम्प्रेक्ष्य च वरारोहा सर्वांस्तत्र सभासदः ।\nविराटं चाह पाञ्चाली दुःखेनाविष्टचेतना\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2139225, "chapter_id": 4012, "verse_number": "७", "content_sanskrit": "न राजन् राजवत् किञ्चित् समाचरसि कीचके ।\nदस्यूनामिव ते धर्मे वासः स परिवर्तते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2139226, "chapter_id": 4012, "verse_number": "८", "content_sanskrit": "न कीचकः स्वधर्मस्थो न च मात्स्यः कथञ्चन ।\nसभासदोऽप्यधर्मज्ञा य इदं पर्युपासते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2139227, "chapter_id": 4012, "verse_number": "९", "content_sanskrit": "न धर्मं कीचको वेत्ति राजभृत्यास्तथैव च ।\nन राजा विनयं ब्रूते अमात्याश्च न जानते\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2139228, "chapter_id": 4012, "verse_number": "१०", "content_sanskrit": "नोपालभे त्वां नृपते विराट नृपसंसदि ।\nनाहमेतेन युक्ता वै हन्तुं मात्स्य तवान्तिके\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2139229, "chapter_id": 4012, "verse_number": "११", "content_sanskrit": "सभासदस्तु पश्यन्तु कीचकं धर्मलङ्घकम् ।\nविराटनृपते पश्य मामनाथामनागसीम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2139230, "chapter_id": 4012, "verse_number": "", "content_sanskrit": "विराटः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2139231, "chapter_id": 4012, "verse_number": "१२", "content_sanskrit": "परोक्षं नाभिजानामि विग्रहं युवयोरहम् ।\nअर्थतत्त्वमविज्ञाय किंस्वित् कुशलता मम\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2139232, "chapter_id": 4012, "verse_number": "", "content_sanskrit": "द्रौपदी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2139233, "chapter_id": 4012, "verse_number": "१३", "content_sanskrit": "येषां न वैरी स्वपिति पदा भूमिमुपस्पृशन् ।\nतेषां मां मानिनां भार्यां सूतपुत्रः पदाऽवधीत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2139234, "chapter_id": 4012, "verse_number": "१४", "content_sanskrit": "ये वै दद्युर्न याचेयुर्ब्रह्मण्याः सत्यवादिनः ।\nतेषां मां मानिनीं भार्यां सूतपुत्रः पदाऽवधीत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2139235, "chapter_id": 4012, "verse_number": "१५", "content_sanskrit": "येषां दुन्दुभिर्निर्घोषो ज्याघोषः श्रूयतेऽनिशम् ।\nतेषां मां मानिनीं भार्यां सूतपुत्रः पदाऽवधीत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2139236, "chapter_id": 4012, "verse_number": "१६", "content_sanskrit": "तेजस्विनस्तथा क्षान्ता बलवन्तोऽभिमानिनः ।\nमहेष्वासा रणे शूरा गर्विता मानिताः पुरा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2139237, "chapter_id": 4012, "verse_number": "१७", "content_sanskrit": "तेषां मां दयितां भार्यां सूतपुत्रः पदाऽवधीत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2139238, "chapter_id": 4012, "verse_number": "१८", "content_sanskrit": "सर्वलोकमिमं हन्युर्यदि क्रुद्धा महाबलाः ।\nतेषां मां मानिनीं भार्यां सूतपुत्रः पदाऽवधीत्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2139239, "chapter_id": 4012, "verse_number": "१९", "content_sanskrit": "शरणं ये प्रपन्नानां भवन्ति शरणार्थिनाम् ।\nचरन्ति लोके प्रच्छन्नाः क्व नु तेऽद्य महारथाः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2139240, "chapter_id": 4012, "verse_number": "२०", "content_sanskrit": "कथं ते सूतपुत्रेण वध्यमानां प्रियां सतीम् ।\nमर्षयन्ति यथा क्लीबा बलवन्तोऽतितेजसः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2139241, "chapter_id": 4012, "verse_number": "२१", "content_sanskrit": "क्व नु तेषाममर्षश्च वीर्यं तेजश्च तद्बलम् ।\nन च रक्षन्ति ये भार्यां वध्यमानां दुरात्मना\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2139242, "chapter_id": 4012, "verse_number": "२२", "content_sanskrit": "मयाऽपि शक्यं किं कर्तुं विराटे धर्मदूषणे ।\nमा मर्षयति यः पश्यन् वध्यमानामनागसीम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2139243, "chapter_id": 4012, "verse_number": "२३", "content_sanskrit": "धर्मो विद्धो ह्यधर्मेण सत्यं यत्रानृतेन च ।\nहन्यते प्रेक्षमाणानां हतास्तत्र सभासदः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2139244, "chapter_id": 4012, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2139245, "chapter_id": 4012, "verse_number": "२४", "content_sanskrit": "तस्यास्तत् कृपणं श्रुत्वा सैरन्ध्र्याः परिदेवितम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2139246, "chapter_id": 4012, "verse_number": "२५", "content_sanskrit": "ततः सभ्यास्तु विज्ञाय भूयः कृष्णामपूजयत् ।\nसाधु साध्विति चाप्याहुः कीचकं चाप्यगर्हयन्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2139247, "chapter_id": 4012, "verse_number": "२६", "content_sanskrit": "केचित् कृष्णां प्रशंसन्ति केचिन्निन्दन्ति कीचकम् ।\nकेचिन्निन्दन्ति राजानं केचिद् देवीं च तां नराः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2139248, "chapter_id": 4012, "verse_number": "", "content_sanskrit": "सभ्याः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2139249, "chapter_id": 4012, "verse_number": "२७", "content_sanskrit": "यस्येयं चारुसर्वाङ्गी भार्या स्यादायतेक्षणा ।\nपरो लाभस्तु तस्य स्यान्न स शोचेत् कदाचन\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2139250, "chapter_id": 4012, "verse_number": "२८", "content_sanskrit": "यस्या गात्रं शुभं पीनं मुखं जयति पङ्कजम् ।\nगतिर्हंसं स्मितं कुन्दं सैषा नार्हति पद्वधम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2139251, "chapter_id": 4012, "verse_number": "२९", "content_sanskrit": "द्वात्रिंशद्दशना यस्याः श्वेता मांसनिबन्धनाः ।\nस्निग्धाश्च मृदवः केशाः सैषा नार्हति पद्वधम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2139252, "chapter_id": 4012, "verse_number": "३०", "content_sanskrit": "पद्मं चक्रं ध्वजः शङ्खः प्रासादो मकरस्तथा ।\nयस्याः पाणितळे सन्ति सैषा नार्हति पद्वधम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2139253, "chapter_id": 4012, "verse_number": "३१", "content_sanskrit": "आवर्ताः खलु चत्वारः सर्वे चैव प्रदक्षिणाः ।\nसमं गात्रं शुभं स्निग्धं इयं नार्हति पद्वधम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2139254, "chapter_id": 4012, "verse_number": "३२", "content_sanskrit": "अच्छिद्रहस्तपादा च ह्यच्छिद्रदशना च या ।\nकन्या कमलपत्राक्षी कथमर्हति पद्वधम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2139255, "chapter_id": 4012, "verse_number": "३३", "content_sanskrit": "सर्वलक्षणसम्पूर्णा पूर्णचन्द्रनिभानना ।\nसुरूपिणी सुवदना नेयं योग्या पदा वधम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2139256, "chapter_id": 4012, "verse_number": "३४", "content_sanskrit": "देवदेवीव सुभगा शक्रदेवीव शोभना ।\nअप्सरा इव सारूप्यान्नेयं योग्या पदा वधम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2139257, "chapter_id": 4012, "verse_number": "३५", "content_sanskrit": "न हीदृशी मनुष्येषु सुलभा वरवर्णिनी ।\nनारी सर्वानवद्याङ्गी देवीं मन्यामहे वयम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2139258, "chapter_id": 4012, "verse_number": "समाप्तिः", "content_sanskrit": "इति स्मापूजयंस्तत्र कृष्णां प्रेक्ष्य सभासदः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2139259, "chapter_id": 4012, "verse_number": "३७", "content_sanskrit": "सा विनिःश्वस्य सुश्रोणी भूयोऽतप्यत दुर्मुखी ।\nतूष्णीमासीद् तदा कृष्णा विवक्षन्तं युधिष्ठिरम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2139260, "chapter_id": 4012, "verse_number": "३८", "content_sanskrit": "युधिष्ठिरस्य कोपात् तु ललाटे स्वेद आस्रवत्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2139261, "chapter_id": 4012, "verse_number": "३९", "content_sanskrit": "अब्रवीद् धर्मपुत्रोऽथ सैरन्ध्रीं महिषीं प्रियाम् ।\nकृष्णां तत्र नृपाभ्याशे परिव्राजकरूपधृक्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2139262, "chapter_id": 4012, "verse_number": "४०", "content_sanskrit": "गच्छ सैरन्ध्रि मा भैस्त्वं सुदेष्णाया निवेशनम् ।\nराजा ह्ययं धर्मशीलो विराटः परलोकभीः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2139263, "chapter_id": 4012, "verse_number": "४१", "content_sanskrit": "यतस्त्वां न परित्राति सत्ये धर्मपथे स्थितः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2139264, "chapter_id": 4012, "verse_number": "४२", "content_sanskrit": "भर्तारस्तव पश्यन्ति क्लिश्यन्ते धीरचेतसः ।\nशुश्रूषया क्लिश्यमानाः परलोकं जयन्त्युत\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2139265, "chapter_id": 4012, "verse_number": "४३", "content_sanskrit": "मन्ये न कालः क्रोधस्य पश्यन्ति पतयस्तव ।\nतेन त्वां नाभिधावन्ति गन्धर्वाः सूर्यवर्चसः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2139266, "chapter_id": 4012, "verse_number": "४४", "content_sanskrit": "भर्तुर्भीरु भयादन्या न क्रुध्यन्ति कदाचन ।\nबहुभिश्च परिक्लेशैरवज्ञाताश्च शत्रुभिः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2139267, "chapter_id": 4012, "verse_number": "४५", "content_sanskrit": "श्रूयन्तां ते सुकेशान्ते मोक्षधर्माश्रयाः कथाः ।\nयथा धर्मः कुलस्त्रीणां दृष्टो धर्मानुरोधनात्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2139268, "chapter_id": 4012, "verse_number": "४६", "content_sanskrit": "नास्ति यज्ञः स्त्रियः कश्चित् न श्राद्धं नाप्युपोषणम् ।\nया च भर्तरि शु(शि)श्रूषा सा स्वर्गायाभिजायते\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2139269, "chapter_id": 4012, "verse_number": "४७", "content_sanskrit": "पिता रक्षति कौमारे भर्ता रक्षति यौवने ।\nपुत्रस्तु स्थविरे भावे न स्त्री स्वातन्त्र्यमर्हति\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2139270, "chapter_id": 4012, "verse_number": "४८", "content_sanskrit": "अनुरुध्यमाना भर्तारं दृश्यन्ते वीरपत्नयः ।\nशुश्रूषया क्लिश्यमानाः पतिलोकं जयन्त्युत\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2139271, "chapter_id": 4012, "verse_number": "४९", "content_sanskrit": "अनन्यभावशु(शि)श्रूषाः पुण्यलोकं व्रजन्त्युत\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2139272, "chapter_id": 4012, "verse_number": "५०", "content_sanskrit": "न क्रोधकालं नियतं पश्यन्ति पतयस्तव ।\nन क्रुद्धे प्रतियायाद्वै पतींस्ते वृत्रहा अपि\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2139273, "chapter_id": 4012, "verse_number": "५१", "content_sanskrit": "तेन त्वां नाभिधावन्ति गन्धर्वाः कामरूपिणः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2139274, "chapter_id": 4012, "verse_number": "५२", "content_sanskrit": "यदि ते समयः कश्चित् कृतो ह्यायतलोचने ।\nतं स्मरस्व क्षमाशीले क्षमा धर्मो ह्यनुत्तमः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2139275, "chapter_id": 4012, "verse_number": "५३", "content_sanskrit": "क्षमा सत्यं क्षमा दानं क्षमा धर्मः क्षमा तपः ।\nक्षमावतामयं लोकः परलोकः क्षमावताम्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2139276, "chapter_id": 4012, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2139277, "chapter_id": 4012, "verse_number": "५४", "content_sanskrit": "इत्येवमुक्ते तिष्ठन्तीं पुनरेवाह धर्मराट्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2139278, "chapter_id": 4012, "verse_number": "५५", "content_sanskrit": "दुःखं रोदिषि वै भद्रे दीना त्वं राजसंसदि ।\nतस्मात् त्वमपि सुश्रोणी शैलूषीव विभासि नः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2139279, "chapter_id": 4012, "verse_number": "५६", "content_sanskrit": "एवमुक्ता तु सा भर्त्रा समुद्वीक्ष्याब्रवीदिदम्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2139280, "chapter_id": 4012, "verse_number": "५७", "content_sanskrit": "सत्यमुक्तं त्वया विद्वन् शैलूषं विद्धि मां पुनः ।\nशैलूषकस्य तस्याहं येषां ज्येष्ठोऽक्षकोविदः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2139281, "chapter_id": 4012, "verse_number": "५८", "content_sanskrit": "एवमुक्त्वा वरारोहा परिमृज्याननं शुभम् ।\nकेशान् प्रमुक्तान् संयम्य रुधिरेण समुक्षितान्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2139282, "chapter_id": 4012, "verse_number": "५९", "content_sanskrit": "पांसुकुण्ठितसर्वाङ्गी गजराजवधूरिव ।\nप्रतस्थे नागनासोरू भर्तुराज्ञाय शासनम्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2139283, "chapter_id": 4012, "verse_number": "६०", "content_sanskrit": "विमुक्ता मृगशाबाक्षी निरन्तरपयोधरा ।\nप्रभा नक्षत्रराजस्य कालमेघैरिवावृता\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2139284, "chapter_id": 4012, "verse_number": "६१", "content_sanskrit": "यस्या ह्यर्थे पाण्डवेयाः त्यजेयुरपि जीवितम् ।\nतां ते दृष्ट्वा तथा कृष्णां क्षमिणो धर्मचारिणः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2139285, "chapter_id": 4012, "verse_number": "६२", "content_sanskrit": "समयं नातिवर्तन्ते वेलामिव महोदधिः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2139286, "chapter_id": 4012, "verse_number": "६३", "content_sanskrit": "सा प्रविश्य प्रवेपन्ती सुदेष्णाया निवेशनम् ।\nरुदती चारुतन्वङ्गी तस्यास्तस्थावथाग्रतः\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2139287, "chapter_id": 4012, "verse_number": "६४", "content_sanskrit": "तामुवाच विराटस्य महिषी शाठ्यमास्थिता\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2139288, "chapter_id": 4012, "verse_number": "६५", "content_sanskrit": "किमिदं पद्मसङ्काशं सुदन्तोष्ठाक्षिनासिकम् ।\nरुदन्त्या अवमृष्टास्रं पूर्णेन्दुसमवर्चसम्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2139289, "chapter_id": 4012, "verse_number": "६६", "content_sanskrit": "बिम्बोष्ठं कृष्णताराभ्यामत्यन्तं रुचिरप्रभम् ।\nनयनाभ्यामजिह्माभ्यां मुखं ते मुञ्चते जलम्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2139290, "chapter_id": 4012, "verse_number": "६७", "content_sanskrit": "कस्त्वाऽवधीद् वरारोहे कस्माद् रोदिषि शोभने ।\nको विप्रयुज्यते दारैः सपुत्रपशुबान्धवः\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2139291, "chapter_id": 4012, "verse_number": "६८", "content_sanskrit": "कस्याद्य राजा कुपितो वधमाज्ञापयिष्यति ।\nब्रूहि किं ते प्रियं कार्यं कं त्यजे घातयामि वा\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2139292, "chapter_id": 4012, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2139293, "chapter_id": 4012, "verse_number": "६९", "content_sanskrit": "तां निःश्वस्याब्रवीत् कृष्णाऽजानन्तीव पृच्छसे ।\nभ्रातुस्त्वं मामनुप्रेष्य किमेवं त्वं विकत्थसे\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2139294, "chapter_id": 4012, "verse_number": "७०", "content_sanskrit": "कीचको माऽवधीत् तत्र सुराहारीमितो गताम् ।\nसभायां पश्यतो राज्ञो यथा वै निर्जने वने\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2139295, "chapter_id": 4012, "verse_number": "", "content_sanskrit": "सुदेष्णा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2139296, "chapter_id": 4012, "verse_number": "७१", "content_sanskrit": "घातयामि सुदन्तोष्ठि कीचकं यदि मन्यसे\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2139297, "chapter_id": 4012, "verse_number": "७२", "content_sanskrit": "भ्राता यद्यपि मे व्यक्तं यतस्त्वं धर्मचारिणी ।\nयस्त्वां कामाभिभूतात्मा दुर्लभामवमन्यते\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2139298, "chapter_id": 4012, "verse_number": "", "content_sanskrit": "द्रौपदी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2139299, "chapter_id": 4012, "verse_number": "७३", "content_sanskrit": "अद्यैव तं हनिष्यन्ति विप्रकर्तारमच्युताः ।\nमन्येऽहमद्य वा श्वो वा परलोकं गमिष्यति\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2139300, "chapter_id": 4012, "verse_number": "७४", "content_sanskrit": "भ्रातुः प्रयच्छ त्वरितं जीवश्राद्धं त्वमद्य वै ।\nसुहृष्टं कुरु चैवैनं नासून् मन्ये धरिष्यति\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2139301, "chapter_id": 4012, "verse_number": "७५", "content_sanskrit": "तेषां हि मम भर्तॄणां पञ्चानां धर्मचारिणाम् ।\nएको दुर्धर्षणोऽत्यर्थं बले चाप्रतिमो भुवि\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2139302, "chapter_id": 4012, "verse_number": "७६", "content_sanskrit": "निर्मनुष्यमिमं लोकं कुर्यात् क्रुद्धो निशामिमाम् ।\nस न सङ्क्रुद्ध्यते तावद् गन्धर्वः कामरूपधृक्\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2139303, "chapter_id": 4012, "verse_number": "७७", "content_sanskrit": "नूनं ज्ञास्यति यावद्वै ममैतत् पादघातनम्\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2139304, "chapter_id": 4012, "verse_number": "७८", "content_sanskrit": "तत्क्षणे कीचकः पापः सपुत्रभ्रातृबान्धवः ।\nविनशिष्यति दुष्टात्मा यथा दुष्कृतकर्मकृत्\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2139305, "chapter_id": 4012, "verse_number": "७९", "content_sanskrit": "अपि चैतत् पुरा प्रोक्तं निपुणैर्मनुजोत्तमैः\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2139306, "chapter_id": 4012, "verse_number": "८०", "content_sanskrit": "एकस्तु कुरुते पापं कालपाशवशं गतः ।\nनीचो ह्यात्मापराधेन कुलं तेन विनश्यति\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2139307, "chapter_id": 4012, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां विराटपर्वणि विंशोऽध्यायः ॥२०॥\nकीचकवधपर्वणि पञ्चमोऽध्यायः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2139308, "chapter_id": 4012, "verse_number": "", "content_sanskrit": "* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}]