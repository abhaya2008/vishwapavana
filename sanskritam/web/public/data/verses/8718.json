[{"id": 900008971, "chapter_id": 8718, "verse_number": "8.1", "content_sanskrit": "यच्चेदमुच्यते वेदस्यापौरुषेयत्वे ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900008972, "chapter_id": 8718, "verse_number": "8.2", "content_sanskrit": "ननु– केयमाकाङ्क्षा ?", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900008973, "chapter_id": 8718, "verse_number": "8.3", "content_sanskrit": "यत्तु मणावुक्तम्‘‘अभिधानापर्यवसानमाकाङ्क्षा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900008974, "chapter_id": 8718, "verse_number": "8.4", "content_sanskrit": "न चाननुभावकपदस्थानेऽज्ञापकपदप्रक्षेपेऽव्याप्तिर्नेति युक्तम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900008975, "chapter_id": 8718, "verse_number": "8.5", "content_sanskrit": "अथ प्रागभावः प्रागभावत्वेन नाकाङ्क्षा..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900008976, "chapter_id": 8718, "verse_number": "8.6", "content_sanskrit": "उच्यते– यस्य पदस्य यदन्वयाननुभावकत्वं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900008977, "chapter_id": 8718, "verse_number": "8.7", "content_sanskrit": "तच्च रूपं क्रियाकारकभावान्वये क्रियापदत्वादिकम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900008978, "chapter_id": 8718, "verse_number": "8.8", "content_sanskrit": "अत्र च पदशब्देन शब्दमात्रं विवक्षितम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900008979, "chapter_id": 8718, "verse_number": "8.9", "content_sanskrit": "नन्वेवमितरपदविरहप्रयुक्ताननुभावकताप्रयोजकरूपवत्त्वात्मिका..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900008980, "chapter_id": 8718, "verse_number": "8.10", "content_sanskrit": "नन्वेवं चेदयमेति पुत्रो राज्ञः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900008981, "chapter_id": 8718, "verse_number": "8.11", "content_sanskrit": "नन्वेवमुदयनादिमते त्वदुक्तरूपग्रहविरहप्रयुक्तः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900008982, "chapter_id": 8718, "verse_number": "8.12", "content_sanskrit": "वस्तुतस्तु..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900008983, "chapter_id": 8718, "verse_number": "8.13", "content_sanskrit": "ननु सन्निधानापरपर्यायासत्तिर्न तावन्मण्युक्तरीत्या ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900008984, "chapter_id": 8718, "verse_number": "8.14", "content_sanskrit": "किञ्च नानाविशेषणकैकविशेष्यकबोधस्थे ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900008985, "chapter_id": 8718, "verse_number": "8.15", "content_sanskrit": "नाप्यव्यवहितपदोस्थितिरासत्तिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900008986, "chapter_id": 8718, "verse_number": "8.16", "content_sanskrit": "उच्यते पदोपस्थित्यनुकूलवक्तृव्यापारे ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900008987, "chapter_id": 8718, "verse_number": "8.17", "content_sanskrit": "नाप्यनासन्नोदाहरणेऽतिव्याप्तिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900008988, "chapter_id": 8718, "verse_number": "8.18", "content_sanskrit": "पद्धतौ प्रमाणलक्षणटीकायां..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900008989, "chapter_id": 8718, "verse_number": "8.19", "content_sanskrit": "अथ का योग्यता ? न तावत्सजातीयेऽन्वयदर्शनं योग्यता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900008990, "chapter_id": 8718, "verse_number": "8.20", "content_sanskrit": "नापि मण्युक्तरीत्या ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900008991, "chapter_id": 8718, "verse_number": "8.21", "content_sanskrit": "एकत्वापरत्वयोः पदार्थविशेषणत्वे प्रमेयत्वे प्रमेयत्वमित्यादाव-व्याप्तेः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900008992, "chapter_id": 8718, "verse_number": "8.22", "content_sanskrit": "अत्यन्ताभावस्य प्रतियोगिविरोधित्वेन व्याप्यवृत्तित्वेन वा ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900008993, "chapter_id": 8718, "verse_number": "8.23", "content_sanskrit": "ननु तर्ह्युभयधीरपि प्रत्येकं शाब्दबोधहेतुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900008994, "chapter_id": 8718, "verse_number": "8.24", "content_sanskrit": "इयं हि विषयसत्त्वरूपा योग्यता ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900008995, "chapter_id": 8718, "verse_number": "8.25", "content_sanskrit": "वस्तुतस्तु अयोग्यतानिश्चयविरहोपि न शाब्दधीहेतुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900008996, "chapter_id": 8718, "verse_number": "8.26", "content_sanskrit": "ननु प्रकृतप्रमाणविरोधरूपप्रतियोगिनोऽप्रामाणिकत्वात् ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 900008997, "chapter_id": 8718, "verse_number": "8.27", "content_sanskrit": "यत्तु प्रमाणलक्षणटीकायामन्योन्यान्वययोग्यतावदर्थाभिधायकत्वं योग्यत्वमित्युक्तम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]