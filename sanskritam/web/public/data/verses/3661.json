[{"id": 2124197, "chapter_id": 3661, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2124198, "chapter_id": 3661, "verse_number": "१", "content_sanskrit": "शौनकेनैवमुक्तस्तु कुन्तीपुत्रो युधिष्ठिरः ।\nपुरोहितमुपागम्य भ्रातृभिः सहितोऽब्रवीत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2124199, "chapter_id": 3661, "verse_number": "२", "content_sanskrit": "प्रस्थिताननुयाता नो ब्राह्मणा वेदपारगाः ।\nन चास्मि पालने शक्तो बहुदुःखसमन्वितः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2124200, "chapter_id": 3661, "verse_number": "३", "content_sanskrit": "परित्यक्तं न शक्नोमि दानशक्तिश्च नास्ति मे ।\nकथमत्र मया कार्यं तद् भवान् प्रब्रवीतु मे \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2124201, "chapter_id": 3661, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2124202, "chapter_id": 3661, "verse_number": "४", "content_sanskrit": "मुहूर्तं मनसा ध्यात्वा धर्मज्ञोऽन्वीक्ष्य तां गतिम् ।\nयुधिष्ठिरमुवाचेदं धौम्यो धर्मकृतां वरः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2124203, "chapter_id": 3661, "verse_number": "५", "content_sanskrit": "पुरा सृष्टानि भूतानि पीड्यन्ते क्षुधया भृशम् ।\nततोऽनुकम्पया तेषां सविता स्वपिता इव \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2124204, "chapter_id": 3661, "verse_number": "६", "content_sanskrit": "गत्वोत्तरायणं तेजो लोकादुद्धृत्य रश्मिभिः ।\nदक्षिणायनमावृत्तो महीं वर्षति वारिणा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2124205, "chapter_id": 3661, "verse_number": "७", "content_sanskrit": "दिवस्तेजः समुद्धृत्य सूयते जगतो रविः ।\nओषध्यः षड्रसा मेध्यास्तदन्नं प्राणिनां भुवि\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2124206, "chapter_id": 3661, "verse_number": "८", "content_sanskrit": "एवं भानुमयं ह्यन्नं भूतानां प्राणधारणम् ।\nनाथोऽयं सर्वभूतानां तस्मात् तं शरणं व्रज\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2124207, "chapter_id": 3661, "verse_number": "९", "content_sanskrit": "राजानो हि महात्मानो योनिकर्मविशोधिताः ।\nउद्धरन्ति प्रजाः सर्वाः तप आस्थाय पुष्कलम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2124208, "chapter_id": 3661, "verse_number": "१०", "content_sanskrit": "भौमेन कार्तवीर्येण वैन्येन नहुषेण च ।\nतपोयोगसमाधिस्थैरुद्धृता ह्यापदः प्रजाः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2124209, "chapter_id": 3661, "verse_number": "११", "content_sanskrit": "तथा त्वमपि कौन्तेय कर्मणा च विशोधितः ।\nतप आस्थाय धर्मेण द्विजातीन् भर भारत\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2124210, "chapter_id": 3661, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2124211, "chapter_id": 3661, "verse_number": "१२", "content_sanskrit": "एवमुक्तस्तु धौम्येन तत्कालसदृशं वचः ।\nधर्मराजो विशुद्धात्मा तप आतिष्ठदुत्तमम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2124212, "chapter_id": 3661, "verse_number": "१३", "content_sanskrit": "पुष्पोपहारैर्बहुभिरञ्चयित्वा दिवाकरम् ।\nयोगमास्थाय धर्मात्मा वायुभक्षो जितेन्द्रियः ।\nगाङ्गेयं वार्युपस्पृश्य प्राणायामेन तस्थिवान्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2124213, "chapter_id": 3661, "verse_number": "१४", "content_sanskrit": "ततो दिवाकरः प्रीतो दर्शयामास पाण्डवम् ।\nदीप्यमानः स्ववपुषा ज्वलन्निव हुताशनः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2124214, "chapter_id": 3661, "verse_number": "१५", "content_sanskrit": "यत् तेऽभिलषितं राजन् सर्वमेतदवाप्स्यसि ।\nअहमन्नं प्रदास्यामि नव वर्षाणि त्रीणि च\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2124215, "chapter_id": 3661, "verse_number": "१६", "content_sanskrit": "फलमूलामिषं शाकं संस्कृतं यन्महानसे ।\nगृह्णीष्व पिठरं ताम्रं मया दत्तं नराधिप\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2124216, "chapter_id": 3661, "verse_number": "१७", "content_sanskrit": "यावद् वाञ्छति पाञ्चाली पात्रेणानेन सुव्रता ।\nचतुर्विधं तदन्नाद्यमक्षय्यं ते भविष्यति ।\nधनं च विविधं तुभ्यमित्युक्त्वान्तरधीयत\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2124217, "chapter_id": 3661, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2124218, "chapter_id": 3661, "verse_number": "१८", "content_sanskrit": "लब्ध्वा वरं तु कौन्तेयो जलादुत्तीर्य धर्मवित् ।\nजग्राह पादौ धौम्यस्य भ्रातृभिः स्वजनैः सह \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2124219, "chapter_id": 3661, "verse_number": "१९", "content_sanskrit": "द्रौपद्या सह सङ्गम्य वन्द्यमानो ह्ययात् प्रभुः ।\nमहानसे तदाऽन्नं तु साधयामास पाण्डवः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2124220, "chapter_id": 3661, "verse_number": "२०", "content_sanskrit": "संस्कृतं प्रसवं याति वन्यमन्नं चतुर्विधम् ।\nअक्षय्यं वर्धते चान्नं तेनाभोजयत द्विजान्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2124221, "chapter_id": 3661, "verse_number": "२१", "content_sanskrit": "भुक्तवत्स्वथ विप्रेषु भोजयित्वाऽनुजानपि ।\nशेषं विघससञ्ज्ञं तु पश्चाद् भुङ्क्ते युधिष्ठिरः ।\nयुधिष्ठिरं भोजयित्वा शेषमश्नाति पार्षती\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2124222, "chapter_id": 3661, "verse_number": "२२", "content_sanskrit": "एवं दिवाकरात् प्राप्य दिवाकरसमद्युतिः ।\nकामान् मनोभिलषितान् ब्राह्मणेऽभ्योऽददात् प्रभुः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2124223, "chapter_id": 3661, "verse_number": "२३", "content_sanskrit": "पुरोहितपुरोगाश्च तिथिनक्षत्रपर्वसु ।\nइज्यार्थेषु प्रवर्तन्ते विधिमन्त्रप्रमाणतः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2124224, "chapter_id": 3661, "verse_number": "२४", "content_sanskrit": "ततः कृतस्वस्त्ययना धौम्येन सह पाण्डवाः ।\nद्विजसङ्घैः परिवृताः प्रययुः काम्यकं वनम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2124225, "chapter_id": 3661, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2124226, "chapter_id": 3661, "verse_number": "२५", "content_sanskrit": "कथं कुरूणामृषभः स वै राजा युधिष्ठिरः ।\nविप्रार्थमाराधितवान् सूर्यमद्भुतविक्रमः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2124227, "chapter_id": 3661, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2124228, "chapter_id": 3661, "verse_number": "२६", "content_sanskrit": "शृणुष्वावहितो राजन् शुचिर्भूत्वा समाहितः ।\nक्षणं च कुरु राजेन्द्र सम्प्रवक्ष्याम्यशेषतः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2124229, "chapter_id": 3661, "verse_number": "२७", "content_sanskrit": "धौम्येन तु यथा पूर्वं पार्थाय सुमहात्मने ।\nनामाष्टशतमाख्यातं तच्छृणुष्व महाद्युते\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2124230, "chapter_id": 3661, "verse_number": "२८", "content_sanskrit": "सूर्योर्ऽयमा भगस्त्वष्टा पूषाऽर्कः सविता रविः ।\nगभस्तिमानजः कालो मृत्युर्धाता प्रभाकरः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2124231, "chapter_id": 3661, "verse_number": "२९", "content_sanskrit": "पृथिव्यापश्च तेजश्च खं वायुश्च परायणम् ।\nसोमो बृहस्पतिः शुक्रो बुधोऽङ्गारक एव च\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2124232, "chapter_id": 3661, "verse_number": "३०", "content_sanskrit": "इन्द्रो विवस्वान् दीप्तांशुः शुचिः शौरिः शनैश्चरः ।\nब्रह्मा विष्णुश्च रुद्रश्च स्कन्दो वैश्रवणो यमः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2124233, "chapter_id": 3661, "verse_number": "३१", "content_sanskrit": "वैद्युतो जाठरश्चाग्निरैन्धनस्तेजसां पतिः ।\nधर्मध्वजो वेदकर्ता वेदाङ्गो वेदवाहनः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2124234, "chapter_id": 3661, "verse_number": "३२", "content_sanskrit": "कृतं त्रेता द्वापरश्च कलिः सर्वामराश्रयः ।\nकलाः काष्ठा मुहूर्ताश्च पक्षा मासा ऋतुस्तथा\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2124235, "chapter_id": 3661, "verse_number": "३३", "content_sanskrit": "संवत्सरकरोऽश्वत्थः कालचक्रो विभावसुः ।\nपुरुषः शाश्वतो योगी व्यक्ताव्यक्तः सनातनः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2124236, "chapter_id": 3661, "verse_number": "३४", "content_sanskrit": "लोकाध्यक्षः प्रजाध्यक्षो विश्वकर्मा तमोनुदः ।\nवरुणः सागरोंऽशुश्च जीमूतो जीवनोऽरिहा \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2124237, "chapter_id": 3661, "verse_number": "३५", "content_sanskrit": "भूताश्रयो भूतपतिः सर्वभूतनिषेवितः ।\nमनुः सुवर्णो भूतादिः कामदः सर्वतोमुखः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2124238, "chapter_id": 3661, "verse_number": "३६", "content_sanskrit": "जयो विशालो वरदः शीघ्रगः प्राणधारणः ।\nधन्वन्तरिर्धूमकेतुरादिदेवोऽदितेः सुतः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2124239, "chapter_id": 3661, "verse_number": "३७", "content_sanskrit": "द्वादशात्माऽरविन्दाक्षः पिता माता पितामहः ।\nस्वर्गद्वारं प्रजाद्वारं मोक्षद्वारं त्रिविष्टपम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2124240, "chapter_id": 3661, "verse_number": "३८", "content_sanskrit": "देवकर्ता प्रशान्तात्मा विश्वात्मा विश्वतोमुखः ।\nचराचरात्मा सूक्ष्मात्मा मैत्रेण वपुषाऽन्वितः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2124241, "chapter_id": 3661, "verse_number": "३९", "content_sanskrit": "एतद्वै कीर्तनीयस्य सूर्यस्यामिततेजसः ।\nनाम्नामष्टशतं पुण्यं शक्रेणोक्तं महात्मना\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2124242, "chapter_id": 3661, "verse_number": "४०", "content_sanskrit": "शक्राच्च नारदः प्राप्तो धौम्यस्तु तदनन्तरम् ।\nधौम्यद् युधिष्ठिरः प्राप्य सर्वान् कामानवाप्तवान्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2124243, "chapter_id": 3661, "verse_number": "", "content_sanskrit": "सुरपितृगणयक्षसेवितं असुरनिशाचरसिद्धवन्दितम् ।\nवरकनकहुताशनप्रभं त्वमपि नमस्व हिताय भास्करम् \t ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2124244, "chapter_id": 3661, "verse_number": "४२", "content_sanskrit": "सूर्योदये यः सुसमाहितः पठेत्\nस पुत्रलाभं धनरत्नसञ्चयम् ।\nलभेत जातिस्मरतां सदा नरो\nधृतिं च मेधां च स विन्दते वराम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2124245, "chapter_id": 3661, "verse_number": "४३", "content_sanskrit": "इमं स्तवं देववरस्य यो नरः\nप्रकीर्तयेत् शुद्धमनाः समाहितः ।\nस मुच्यते शोकदवाग्निसागरा-\nल्लभेत कामान् मनसा यथेप्सितान्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2124246, "chapter_id": 3661, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि\nतृतीयोऽध्यायः ॥३॥\n॥ आरण्यकपर्वणि तृतियोऽध्यायः ॥३॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]