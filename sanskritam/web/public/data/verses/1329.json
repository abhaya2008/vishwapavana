[{"id": 2015610, "chapter_id": 1329, "verse_number": "२-७०-१", "content_sanskrit": "वैशम्पायन उवाच॥\nततो विष्फारयन्राजा महच्चैदिपतिर्धनुः।\nअभियास्यन्हृषीकेशमुवाच मधुसूदनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2015611, "chapter_id": 1329, "verse_number": "२-७०-२", "content_sanskrit": "एकस्त्वमसि मे शत्रुस्तत्त्वां हत्वाऽद्य माधव।\nततः सागरपर्यन्तां पालयिष्यामि मेदिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2015612, "chapter_id": 1329, "verse_number": "२-७०-३", "content_sanskrit": "द्वैरथं काङ्क्षितं यद्वै तदिदं पर्युपस्थितम्।\nचिरस्य वत मे दिष्ट्या वासुदेव सह त्वया।\nअद्य त्वां निहनिष्यामि भीष्मं च सह पाण्डवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2015613, "chapter_id": 1329, "verse_number": "२-७०-४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2015614, "chapter_id": 1329, "verse_number": "२-७०-४", "content_sanskrit": "एवमुक्त्वा स तं बाणैर्निशितैरत्ततेजनैः।\nविव्याध युधि तीक्ष्णाग्रैश्चेदिराड्यपुङ्गवम्?", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2015615, "chapter_id": 1329, "verse_number": "२-७०-५", "content_sanskrit": "कङ्कपत्रच्छदा बाणाश्चेदिराजधनुश्च्युताः।\nविविशुस्ते तदा कृष्णं भुजङ्गा इव पर्वतम्?", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2015616, "chapter_id": 1329, "verse_number": "२-७०-६", "content_sanskrit": "नाददानस्य चैद्यस्य शरानत्यस्यतोपि वा।\nदधृशुर्विवरं केचिद्गतिं वायोरिवाम्बरे?", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2015617, "chapter_id": 1329, "verse_number": "२-७०-७", "content_sanskrit": "चेदिराजमहामेधः शरजालाम्बुमांस्तदा।\nअभ्यवर्षद्धृषीकेशं पयोद इव पर्वतम्?", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2015618, "chapter_id": 1329, "verse_number": "२-७०-८", "content_sanskrit": "ततः शार्ङ्गममित्रघ्नः कृत्वा सशरमच्युतः।\nआबभाषे महबाहुः सुनीथं परवीरहा।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2015619, "chapter_id": 1329, "verse_number": "२-७०-९", "content_sanskrit": "अयं त्वं भामकस्तीक्ष्णश्चेदिराज महाशरः।\nभेत्तुमर्हति वेगेन महाशनिरिवाचलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2015620, "chapter_id": 1329, "verse_number": "२-७०-१०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2015621, "chapter_id": 1329, "verse_number": "२-७०-१०", "content_sanskrit": "एवं ब्रुवति गोविन्दे ततश्चेदिपतिः पुनः।\nमुमोच निशितानन्यान्कृष्णं प्रति शरान्बहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2015622, "chapter_id": 1329, "verse_number": "२-७०-११", "content_sanskrit": "अथ बाणार्दितः कृष्णः शार्ङ्गमायम्य दीप्तिमान्।\nमुमोच निशितान्बाणाञ्छतशोथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2015623, "chapter_id": 1329, "verse_number": "२-७०-१२", "content_sanskrit": "ताञ्छरांस्तु स चिच्छेद शरवर्षैस्तु चेदिराट्।\nषड्भिश्चान्यैर्जघानाशु केशवं चेदिपुङ्गवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2015624, "chapter_id": 1329, "verse_number": "२-७०-१३", "content_sanskrit": "ततोऽस्रं सहसा कृष्णः प्रमुमोच जगद्गुरुः।\nअस्त्रेण तन्महाबाहुर्वारयामास चेदिराट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2015625, "chapter_id": 1329, "verse_number": "२-७०-१४", "content_sanskrit": "ततः शतसहस्रेण शराणां नतपर्वणाम्।\nसर्वतः समवाकीर्य शौरिं दामोदरं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2015626, "chapter_id": 1329, "verse_number": "२-७०-१५", "content_sanskrit": "ननाद बलवान्क्रुद्धः शिशुपालः प्रतापवान्।\nइदं चोवाच संरब्धः केशवं परवीरहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2015627, "chapter_id": 1329, "verse_number": "२-७०-१६x", "content_sanskrit": "शिशुपाल उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2015628, "chapter_id": 1329, "verse_number": "२-७०-१६", "content_sanskrit": "अद्याङ्गं मामका बाणा भेत्स्यन्ति तव संयुगे।\nहत्वा त्वां समुतामात्यं पाण्डवांश्च तरस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2015629, "chapter_id": 1329, "verse_number": "२-७०-१७", "content_sanskrit": "अनृण्यमद्यय यास्यामि जरासन्धस्य धीमतः।\nकंसस्य केशिनश्चैव नरकस्य तथैव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2015630, "chapter_id": 1329, "verse_number": "२-७०-१८x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2015631, "chapter_id": 1329, "verse_number": "२-७०-१८", "content_sanskrit": "इत्युक्त्वा क्रोधताम्राक्षः शिशुपालो जनार्दनम्।\nअदृश्यं शरवर्षेण सर्वतः स चकार ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2015632, "chapter_id": 1329, "verse_number": "२-७०-१९", "content_sanskrit": "ततोऽस्त्रेणैव चान्योन्यं निकृत्य च शरान्बहून्।\nशरवर्षैस्तदा चैद्यमन्तर्धातुं प्रचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2015633, "chapter_id": 1329, "verse_number": "२-७०-२०", "content_sanskrit": "अन्तर्धानगतौ वीरौ शुशुभाते महारथौ।\nतौ दृष्ट्वा सर्वभूतानि साधुसाध्वित्यपूजयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2015634, "chapter_id": 1329, "verse_number": "२-७०-२१", "content_sanskrit": "न दृष्टपूर्वमस्माभिर्युद्धमीदृशकं पुरा।\nततः कृष्णं जघानाशु शुशुपालस्त्रिभिः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2015635, "chapter_id": 1329, "verse_number": "२-७०-२२", "content_sanskrit": "कृष्णोऽपि बाणैर्विव्याध सुनीथं पञ्चभिर्युधि।\nततः सुनीथं सप्तत्या नाराचैर्दयद्बली।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2015636, "chapter_id": 1329, "verse_number": "२-७०-२३", "content_sanskrit": "ततोऽतिविद्धः कृष्णेन सुनीथः क्रोधमूर्छितः।\nविव्याध निशितैर्बाणैर्वासुदेवं स्तनान्तरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2015637, "chapter_id": 1329, "verse_number": "२-७०-२४", "content_sanskrit": "पुनः कृष्णं त्रिभिर्विद्ध्वा ननादावसरे नृपः।\nततोऽतिदारुणं युद्धं सहसा चक्रतुस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2015638, "chapter_id": 1329, "verse_number": "२-७०-२५", "content_sanskrit": "नौ नखैरिव शार्दूलौ दन्तैरिव महागजौ।\nदंष्ट्राभिरिव पञ्चास्यौ चरणैरिव कुक्कुटौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2015639, "chapter_id": 1329, "verse_number": "२-७०-२६", "content_sanskrit": "दारयेतां शरैस्तीक्ष्णैरन्योन्यं युधि तावुभौ।\nततो मुमुचतुः क्रुद्धौ शरवर्षमनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2015640, "chapter_id": 1329, "verse_number": "२-७०-२७", "content_sanskrit": "शरैरेव शराञ्छित्वा तावुभौ पुरुषर्षभौ।\nचक्रातेऽस्त्रमयं युद्धं घोरं तदतिमानुषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2015641, "chapter_id": 1329, "verse_number": "२-७०-२८", "content_sanskrit": "आग्नेयमस्त्रं मुमुचे शिशुपालः प्रतापवान्।\nवारुणास्त्रेण तच्छ्रीघ्रं नाशयामास केशवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2015642, "chapter_id": 1329, "verse_number": "२-७०-२९", "content_sanskrit": "कौबेरमस्त्रं सहसा चेदिराट् प्रमुमोच ह। २-७०-२९ कौबेरणैव सहसाऽनाशयत्तं जगत्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2015643, "chapter_id": 1329, "verse_number": "२-७०-३०", "content_sanskrit": "याम्यमस्त्रं ततः क्रुद्धो मुमुचे कालमोहितः।\nयाम्येनैवास्त्रयोगेन याम्यमस्त्रं व्यनाशयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2015644, "chapter_id": 1329, "verse_number": "२-७०-३१", "content_sanskrit": "गान्धर्वेण च गान्धर्वं मानवं मानवेन च।\nवायव्येन च वायव्यं रौद्रं रौद्रेण चाभिभूः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2015645, "chapter_id": 1329, "verse_number": "२-७०-३२", "content_sanskrit": "ऐन्द्रमैन्द्रेण भगवान्वैष्णवेन च वैष्णवम्।\nएवमस्त्राणि कुर्वाणौ युयुधाते महाबलौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2015646, "chapter_id": 1329, "verse_number": "२-७०-३३", "content_sanskrit": "ततो मायां विकुर्वाणो दमगोषसुतो बली।\nगदामुसलसंयुक्ताञ्छक्तितोमरसायकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2015647, "chapter_id": 1329, "verse_number": "२-७०-३४", "content_sanskrit": "परश्वथमुसण्डीश्च ववर्ष युधि केशवम्।\nअमोघास्त्रेण भगवान्नाशयामास केशिहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2015648, "chapter_id": 1329, "verse_number": "२-७०-३५", "content_sanskrit": "शिलावर्षं महाघोरं ववर्ष युधि चेदिराट्।\nवज्रास्त्रेणाभिसङ्क्रुद्धश्चूर्णं तदकरोत्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2015649, "chapter_id": 1329, "verse_number": "२-७०-३६", "content_sanskrit": "जलवर्षं ततो घोरं व्यस़जच्चेदिपुङ्गवः।\nवायव्यास्त्रेण भगवान्व्याक्षिपच्छतशो हि तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2015650, "chapter_id": 1329, "verse_number": "२-७०-३७", "content_sanskrit": "निहत्य सर्वमायां वै सुनीतस्य जनार्दनः।\nस मुहूर्तं चकाराशु द्वन्द्वयुद्धं महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2015651, "chapter_id": 1329, "verse_number": "२-७०-३८", "content_sanskrit": "स बाणयुद्धं कुर्वाणो भर्त्सयामास चेदिराट्।\nदमघोषसुतो धृष्टमुवाच यदुपुङ्गवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2015652, "chapter_id": 1329, "verse_number": "२-७०-३९", "content_sanskrit": "अद्य कृष्णमकृष्णं तु कुर्वन्तु मम सायकाः।\nइत्येवमुक्त्वा दुष्टात्मा शरवर्षं जनार्दने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2015653, "chapter_id": 1329, "verse_number": "२-७०-४०", "content_sanskrit": "मुमोच पुरुषव्याघ्रो घोरं वै चेदिपुङ्गवः।\nशरसंङ्कृत्तगात्रस्तु क्षणेन यदुनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2015654, "chapter_id": 1329, "verse_number": "२-७०-४१", "content_sanskrit": "रुधिरं परिसुस्राव मदं मत्त इव द्विपः।\nन यन्ता न रथो वापि न चाश्वाः पर्वतोपमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2015655, "chapter_id": 1329, "verse_number": "२-७०-४२", "content_sanskrit": "दृश्यन्ते शरसञ्छन्नाः केशवस्य महात्मनः।\nकेशवं तदवस्थं तु दृष्ट्वा भूतानि चक्रुशुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2015656, "chapter_id": 1329, "verse_number": "२-७०-४३", "content_sanskrit": "दारुकस्तु तदा प्राह कृष्णं यादवनन्दनम्।\nनेदृशो दृष्टपूर्वो हि सङ्ग्रामो वै पुरा मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2015657, "chapter_id": 1329, "verse_number": "२-७०-४४", "content_sanskrit": "स्थातव्यमिति तिष्ठामि त्वत्प्रभावेण माधव।\nअन्यथा न च मे प्राणा धरायेयुर्जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2015658, "chapter_id": 1329, "verse_number": "२-७०-४५", "content_sanskrit": "अतः सञ्चिन्त्य गोविन्द क्षिप्रमस्य वधं कुरु।\nएवमुक्तस्तु सूतेन केशवो वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2015659, "chapter_id": 1329, "verse_number": "२-७०-४६", "content_sanskrit": "एष ह्यतिबलो दैत्यो हिरण्यकशिपुः पुरा।\nरिपुः सुराणामभवद्वरदानेन गर्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2015660, "chapter_id": 1329, "verse_number": "२-७०-४७", "content_sanskrit": "तथाऽऽसीद्रावणो नाम राक्षसो ह्यतिवीर्यवान्।\nतेनैव बलवीर्येण बलं नागणयन्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2015661, "chapter_id": 1329, "verse_number": "२-७०-४८", "content_sanskrit": "अहं मृत्युश्च भविता काले काले दुरात्मनः।\nन भेतव्यं तथा सूत नैष कश्चिन्मयि स्थिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2015662, "chapter_id": 1329, "verse_number": "२-७०-४९", "content_sanskrit": "इत्येवमुक्त्वा भगवान्ननर्द गरुडध्वजः।\nपाञ्चजन्यं महाशङ्खं पूरयामास केशवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2015663, "chapter_id": 1329, "verse_number": "२-७०-५०", "content_sanskrit": "संमोहयित्वा भगवांश्चक्रं दिव्यं समाददे।\nचिच्छेद च सुनीथस्य शिरश्चक्रेण संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2015664, "chapter_id": 1329, "verse_number": "२-७०-५१", "content_sanskrit": "स पपात महाबाहुर्वज्राहत इवाचलः।\nततश्चेदिपतेर्देहात्तेजोऽग्र्यं ददृशुर्नृपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2015665, "chapter_id": 1329, "verse_number": "२-७०-५२", "content_sanskrit": "उत्पतन्तं महाराज गगनादिव भास्करम्।\nततः कमलपत्राक्षं कृष्णं लोकनमस्कृतम्।\nववन्दे तत्तदा तेजो विवेश च नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2015666, "chapter_id": 1329, "verse_number": "२-७०-५३", "content_sanskrit": "तदद्भुतममन्यन्त दृष्ट्वा सर्वे महीक्षितः।\nयद्विवेश महाबाहुं तत्तेजः पुरुषोत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2015667, "chapter_id": 1329, "verse_number": "२-७०-५४", "content_sanskrit": "अनभ्रे प्रववर्ष द्यौः पपात ज्वलिताशनिः।\nकृष्णेन निहते चैद्ये चचाल न वसुन्धरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2015668, "chapter_id": 1329, "verse_number": "२-७०-५५", "content_sanskrit": "ततः केचिन्महीपाला नाब्रुवंस्तत्र किञ्चन।\nअतीतवाक्पथे काले प्रेक्षमाणा जनार्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2015669, "chapter_id": 1329, "verse_number": "२-७०-५६", "content_sanskrit": "हस्तैर्हस्ताग्रमपरे प्रत्यपिंषन्नमर्षिताः।\nअपरे दशनैरोष्ठानदशन्क्रोधमूर्छिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2015670, "chapter_id": 1329, "verse_number": "२-७०-५७", "content_sanskrit": "रहश्च केचिद्वार्ष्णेयं प्रशशंसुर्नराधिपाः।\nकेचिदेव सुसंरब्धा मध्यस्थास्त्वपरेऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2015671, "chapter_id": 1329, "verse_number": "२-७०-५८", "content_sanskrit": "प्रहृष्टाः केशवं जग्मुः संस्तुवन्तो महर्षयः।\nब्राह्मणाश्च महात्मानः पार्थिवाश्च महाबलाः।\nशशंसुर्निर्वृताः सर्वे दृष्ट्वा कृष्णस्य विक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2015672, "chapter_id": 1329, "verse_number": "२-७०-५९", "content_sanskrit": "सदेवगन्धर्वगणा राजानो भुवि विश्रुताः।\nप्रणामं हि हृषीकेशे प्राकुर्वत महात्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2015673, "chapter_id": 1329, "verse_number": "२-७०-६०", "content_sanskrit": "ये त्वासुरगणाः पक्षाः सम्भूताः क्षत्रिया इह।\nते निन्दन्ति हृषीकेशं दुरात्मानो गतायुषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2015674, "chapter_id": 1329, "verse_number": "२-७०-६१", "content_sanskrit": "प्रजापतिगणा ये तु मध्यस्थाश्च महात्मनि।\nब्रह्मर्षयश्च सिद्धाश्च गन्धर्वोरगचारणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2015675, "chapter_id": 1329, "verse_number": "२-७०-६२", "content_sanskrit": "ते वै स्तुवन्ति गोविन्दं दिव्यैर्मङ्गलसंयुतैः।\nपरस्परं च नृत्यन्ति गीतेन विविधेन च।\nउपतिष्ठन्ति गोविन्दं प्रीतियुक्ता महात्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2015676, "chapter_id": 1329, "verse_number": "२-७०-६३", "content_sanskrit": "प्रहृष्टाः केशवं जग्मुः संस्तुवन्तो महर्षयः।\nब्राह्मणाश्चापि सुप्रीताः पाण्डवाश्च महाबलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2015677, "chapter_id": 1329, "verse_number": "२-७०-६४", "content_sanskrit": "पाण्डवस्त्वब्रवीद्भातॄन्सत्कारेण महीपतिम्।\nदमघोषात्मजं शूरं संस्कारयत मा चिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2015678, "chapter_id": 1329, "verse_number": "२-७०-६५", "content_sanskrit": "कुरुराजवचः श्रुत्वा भ्रातरस्ते त्वरान्विताः।\nतथा च कृतवन्तस्ते भ्रातुर्वै शासनं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2015679, "chapter_id": 1329, "verse_number": "२-७०-६६", "content_sanskrit": "चेदीनामाधिपत्ये च पुत्रं तस्याज्ञया हरेः।\nअभ्यषिञ्चत तं पार्थः सहितैर्वसुधाधिपैः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2015680, "chapter_id": 1329, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि शिशुपालवधपर्वणि सप्ततितमोऽध्यायः॥ ७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]