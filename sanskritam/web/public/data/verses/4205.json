[{"id": 2148152, "chapter_id": 4205, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2148153, "chapter_id": 4205, "verse_number": "१", "content_sanskrit": "अर्जुनं केशव ब्रूयाः त्वयि जाते स्म सूतके ।\nउपोपविष्टा नारीभिराश्रमे परिवारिता\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2148154, "chapter_id": 4205, "verse_number": "२", "content_sanskrit": "अथान्तरिक्षे वागासीद् दिव्यरूपा मनोरमा\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2148155, "chapter_id": 4205, "verse_number": "३", "content_sanskrit": "सहस्राक्षसमः कुन्ति भविष्यत्येष ते सुतः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2148156, "chapter_id": 4205, "verse_number": "४", "content_sanskrit": "एष जेष्यति सङ्ग्रामे कुरून् सर्वान् समागतान् ।\nभीमसेनद्वितीयश्च लोकमुद्वर्तयिष्यति\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2148157, "chapter_id": 4205, "verse_number": "५", "content_sanskrit": "पुत्रस्ते पृथिवीं जेता यशश्चास्य दिवं स्पृशेत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2148158, "chapter_id": 4205, "verse_number": "६", "content_sanskrit": "हत्वा कुरूंश्च सङ्ग्रामे वासुदेवसहायवान् ।\nपित्र्यमंशं प्रनष्टं च पुनरभ्युद्धरिष्यति\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2148159, "chapter_id": 4205, "verse_number": "७", "content_sanskrit": "भ्रातृभिः सहितः श्रीमांस्त्रीन् मेधानाहरिष्यति\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2148160, "chapter_id": 4205, "verse_number": "८", "content_sanskrit": "तथा चरेस्त्वं श्वेताश्व यथा वागभ्यभाषत ।\nस सत्यसन्धो बीभत्सुः सव्यसाची यथाऽच्युत\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2148161, "chapter_id": 4205, "verse_number": "९", "content_sanskrit": "तथाऽहमेवं जानामि बलवन्तं दुरासदम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2148162, "chapter_id": 4205, "verse_number": "१०", "content_sanskrit": "तथा वदस्व दाशार्ह यथा वागभ्यभाषत\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2148163, "chapter_id": 4205, "verse_number": "११", "content_sanskrit": "धर्मश्चेदस्ति वार्ष्णेय तथा सत्यं भविष्यति ।\nत्वं चापि तत् तथा कृष्ण सर्वं सम्पादयिष्यसि\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2148164, "chapter_id": 4205, "verse_number": "१२", "content_sanskrit": "नमो धर्माय महते धर्मो धारयते प्रजाः ।\nएतद् धनञ्जयो वाच्यो नित्योद्युक्तो वृकोदरः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2148165, "chapter_id": 4205, "verse_number": "१३", "content_sanskrit": "यदर्थं क्षत्रिया सूते तस्य कालोऽयमागतः ।\nन हि वैरं समासाद्य सीदन्ति पुरुषर्षभाः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2148166, "chapter_id": 4205, "verse_number": "१४", "content_sanskrit": "विदिता मे सदा बुद्धिः भीमस्य न हि शाम्यति\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2148167, "chapter_id": 4205, "verse_number": "१५", "content_sanskrit": "यावदन्तं न कुरुते शत्रूणां शत्रुकर्शनः ।\nतावदेव महाबाहुः निशासु न सुखं लभेत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2148168, "chapter_id": 4205, "verse_number": "१६", "content_sanskrit": "सर्वधर्मविशेषज्ञां स्नुषां पाण्डोर्महात्मनः ।\nब्रूया माधव कल्याणीं कृष्ण कृष्णां यशस्विनीम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2148169, "chapter_id": 4205, "verse_number": "१७", "content_sanskrit": "युक्तमेतन्महाभागे कुले जाते यशस्विनि ।\nयन्मे पुत्रेषु सर्वेषु यथावत् त्वमवर्तिथाः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2148170, "chapter_id": 4205, "verse_number": "१८", "content_sanskrit": "माद्रीपुत्रौ च वक्तव्यौ क्षत्रधर्मरतावुभौ ।\nविक्रमेणार्जितान् भोगान् वृणीतं जीवितादपि\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2148171, "chapter_id": 4205, "verse_number": "१९", "content_sanskrit": "विक्रमाधिगता ह्यर्थाः क्षत्रधर्मेण जीवतः ।\nमनो मनुष्यस्य सदा प्रीणन्ति पुरुषोत्तम\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2148172, "chapter_id": 4205, "verse_number": "२०", "content_sanskrit": "यच्च वः प्रेक्षमाणानां सर्वधर्मोपचायिनी ।\nपाञ्चाली परुषाण्युक्ता को नु तत् क्षन्तुमर्हति\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2148173, "chapter_id": 4205, "verse_number": "२१", "content_sanskrit": "न राज्यहरणं दुःखं द्यूते वाऽपि पराजयः ।\nप्रव्राजनं सुतानां वा न मे तद् दुःखकारणम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2148174, "chapter_id": 4205, "verse_number": "२२", "content_sanskrit": "यत्र सा बृहती श्यामा सभायां रुदती तदा ।\nअश्रौषीत् परुषा वाचस्तन्मे दुःखतरं महत्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2148175, "chapter_id": 4205, "verse_number": "२३", "content_sanskrit": "स्त्रीधर्मिणी वरारोहा क्षत्रधर्मरता सदा ।\nनाध्यगच्छत् तदा नाथं कृष्णा नाथवती सती\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2148176, "chapter_id": 4205, "verse_number": "२४", "content_sanskrit": "तं वै ब्रूहि महाबाहो सर्वशस्त्रभृतां वरम् ।\nअर्जुनं पुरुषव्याघ्रं द्रौपद्याः पदवीं चर\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2148177, "chapter_id": 4205, "verse_number": "२५", "content_sanskrit": "विदितौ हि तवात्यन्तं क्रुद्धाविव यथान्तकौ ।\nभीमार्जुनौ नयेतां हि देवानपि पराभवम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2148178, "chapter_id": 4205, "verse_number": "२६", "content_sanskrit": "तयोश्चैतदवज्ञानं यत् सा कृष्णा सभागता ।\nदुःशासनश्च यद् भीमं कटुकान्यभ्यभाषत\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2148179, "chapter_id": 4205, "verse_number": "२७", "content_sanskrit": "पश्यतां कुरुवीराणां तच्च संस्मारयेः पुनः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2148180, "chapter_id": 4205, "verse_number": "२८", "content_sanskrit": "पाण्डवान् कुशलं पृच्छेः सपुत्रान् सह कृष्णया ।\nमां वै कुशलिनीं ब्रूयाः तेषु भूयो जनार्दन\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2148181, "chapter_id": 4205, "verse_number": "२९", "content_sanskrit": "अरिष्टं गच्छ पन्थानं पुत्रान् मे प्रतिपालय\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2148182, "chapter_id": 4205, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2148183, "chapter_id": 4205, "verse_number": "३०", "content_sanskrit": "अभिवाद्याथ तां कृष्णः कृत्वा चापि प्रदक्षिणम् ।\nनिश्चक्राम महाबाहुः सिंहखेलगतिस्ततः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2148184, "chapter_id": 4205, "verse_number": "३१", "content_sanskrit": "ततो विसर्जयामास भीष्मादीन् कुरुपुङ्गवान् ।\nआरोप्याथ रथे कर्णं प्रायात् सात्यकिना सह\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2148185, "chapter_id": 4205, "verse_number": "३२", "content_sanskrit": "ततः प्रयाते दाशार्हे कुरवः सङ्गता मिथः ।\nजजल्पुर्महदाश्चर्यं केशवे परमाद्भुतम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2148186, "chapter_id": 4205, "verse_number": "३३", "content_sanskrit": "प्रमूढा पृथिवी सर्वा मृत्युपाशवशीकृता ।\nदुर्योधनस्य बालिश्यान्नैतदस्तीति चाब्रुवन्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2148187, "chapter_id": 4205, "verse_number": "३४", "content_sanskrit": "ततो निर्याय नगरात् प्रययौ पुरुषोत्तमः ।\nमन्त्रयामास स तदा कर्णेन सुचिरं सह\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2148188, "chapter_id": 4205, "verse_number": "३५", "content_sanskrit": "विसर्जयित्वा राधेयं सर्वयादवनन्दनः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2148189, "chapter_id": 4205, "verse_number": "३६", "content_sanskrit": "अश्वत्थामानमाहूय मन्त्रयित्वा पुनः पुनः ।\nततो जवेन महता तूर्णमश्वानचोदयत्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2148190, "chapter_id": 4205, "verse_number": "३७", "content_sanskrit": "ते पिबन्त इवाकाशं दारुकेण प्रचोदिताः ।\nहया जग्मुर्महावेगा मनोमारुतरंहसः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2148191, "chapter_id": 4205, "verse_number": "३८", "content_sanskrit": "ते व्यतीत्य महाध्वानं क्षिप्रं श्येना इवाशुगाः ।\nउच्चैर्जग्मुरुपप्लाव्यं शार्ङ्गधन्वानमावहन्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2148192, "chapter_id": 4205, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि षट्त्रिंशोत्तरशततमोऽध्यायः ॥१३६॥\nभगवद्यानपर्वणि सप्तषष्टितमोऽध्यायः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]