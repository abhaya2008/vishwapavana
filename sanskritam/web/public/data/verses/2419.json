[{"id": 2067454, "chapter_id": 2419, "verse_number": "९-३७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2067455, "chapter_id": 2419, "verse_number": "९-३७-१", "content_sanskrit": "तस्मान्नदीगतं चापि ह्युदपानं यशस्विनः।\nत्रितस्य च महाराज जगामाथ हलायुधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2067456, "chapter_id": 2419, "verse_number": "९-३७-२", "content_sanskrit": "तत्र दत्त्वा बहुद्रव्यं पूजयित्वा तथा द्विजान्।\nउपस्पृश्य च तत्रैव प्रहृष्टो मुसलायुधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2067457, "chapter_id": 2419, "verse_number": "९-३७-३", "content_sanskrit": "तत्र धर्मपरो ह्यासीत्त्रितः स सुमहातपाः।\nकूपे च वसता तेन सोमः पीतो महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2067458, "chapter_id": 2419, "verse_number": "९-३७-४", "content_sanskrit": "तत्र चैनं समुत्सृज्य भ्रातरौ जग्मतुर्गृहान्।\nततस्तौ वै शशापाथ त्रितो ब्राह्मणसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2067459, "chapter_id": 2419, "verse_number": "९-३७-५x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2067460, "chapter_id": 2419, "verse_number": "९-३७-५", "content_sanskrit": "उदपानं कथं ब्रह्मन्कथं च सुमहातपाः।\nपतितः किं च सन्त्यक्तो भ्रातृभ्यां द्विजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2067461, "chapter_id": 2419, "verse_number": "९-३७-६", "content_sanskrit": "कूपे कथं च हित्वैनं भ्रातरौ जग्मतुर्गृहान्।\nकथं च याजयामास पपौ सोमं च वै कथम्।\nएतदाचक्ष्व मे ब्रह्मन्श्रोतव्यं यदि मन्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2067462, "chapter_id": 2419, "verse_number": "९-३७-७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2067463, "chapter_id": 2419, "verse_number": "९-३७-७", "content_sanskrit": "आसन्पूर्वयुगे राजन्मुनयो भ्रातरस्त्रयः।\nएकतश्च द्वितश्चैव त्रितश्चादित्यसन्निभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2067464, "chapter_id": 2419, "verse_number": "९-३७-८", "content_sanskrit": "सर्वे प्रजापतिसमाः प्रजावन्तस्तथैव च।\nब्रह्मलोकजिताः सर्वे तपसा ब्रह्मवादिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2067465, "chapter_id": 2419, "verse_number": "९-३७-९", "content_sanskrit": "तेषां तु तपसा प्रीतो नियमेन दमेन च।\nअभवद्गौतमो नित्यं पिता धर्मरतः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2067466, "chapter_id": 2419, "verse_number": "९-३७-१०", "content_sanskrit": "स तु दीर्घेण कालेन तेषां प्रीतिमवाप्य च।\nजगाम भगवान्स्थानमनुरूपमिवात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2067467, "chapter_id": 2419, "verse_number": "९-३७-११", "content_sanskrit": "राजानस्तस्य ये ह्यासन्याज्या राजन्महात्मनः।\nते सर्वे स्वर्गते तस्मिंस्तस्य पुत्रानपूजयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2067468, "chapter_id": 2419, "verse_number": "९-३७-१२", "content_sanskrit": "तेषां तु कर्मणा राजंस्तथा चाध्ययनेन च।\nत्रितः स श्रेष्ठतां प्राप यथैवास्य पिता तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2067469, "chapter_id": 2419, "verse_number": "९-३७-१३", "content_sanskrit": "तथा सर्वे महाभागा मुनयः पुण्यलक्षणाः।\nअपूजयन्महाभागं यथास्य पितरं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2067470, "chapter_id": 2419, "verse_number": "९-३७-१४", "content_sanskrit": "कदाचिद्वि ततो राजन्भ्रातरावेकतद्वितौ।\nयज्ञार्थं चक्रतुश्चिन्तां तथा वित्तार्थमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2067471, "chapter_id": 2419, "verse_number": "९-३७-१५", "content_sanskrit": "तयोर्बुद्धिः समभवत्त्रितं गृह्य परन्तप।\nयाज्यान्सर्वानुपादाय प्रतिगृह्य पशूंस्ततः।\nसोमं पास्यामहे हृष्टाः प्राप्य यज्ञं महाफलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2067472, "chapter_id": 2419, "verse_number": "९-३७-१६", "content_sanskrit": "चक्रुश्चैवं तथा राजन्भ्रातरस्त्रय एव च।\nयथा ते तु परिक्रम्य याज्यान्सर्वान्पशून्प्रति।\nयाजयित्वा ततो याज्याँल्लब्ध्वा तु सुबहून्पशून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2067473, "chapter_id": 2419, "verse_number": "९-३७-१७", "content_sanskrit": "याज्येन कर्मणा तेन प्रतिगृह्य विधानतः।\nप्राचीं दिशं महात्मान आजग्मुस्ते महर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2067474, "chapter_id": 2419, "verse_number": "९-३७-१८", "content_sanskrit": "त्रितस्तेषां महाराज पुरस्ताद्याति हृष्टवत्।\nएकतश्च द्वितश्चैव पृष्ठतः कालयन्पशून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2067475, "chapter_id": 2419, "verse_number": "९-३७-१९", "content_sanskrit": "तयोश्चिन्ता समभवदेकतस्य द्वितस्य च।\nकथं च स्युरिमा गाव आवाभ्यां हि विना त्रितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2067476, "chapter_id": 2419, "verse_number": "९-३७-२०", "content_sanskrit": "तावन्योन्यं समाभाष्य एकतश्च द्वितश्च ह।\nयदूचतुर्मिथः पापौ तन्निबोध जनेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2067477, "chapter_id": 2419, "verse_number": "९-३७-२१", "content_sanskrit": "त्रितो यज्ञेषु कुशलस्तथा वेदेषु निष्ठितः।\nततस्त्रितो बहुतरं गावः समुपलप्स्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2067478, "chapter_id": 2419, "verse_number": "९-३७-२२", "content_sanskrit": "तदावां सहितौ भूत्वा गाः प्रकाल्य व्रजावहे।\nत्रितोऽपि गच्छतां काममावाभ्यां वै विनाकृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2067479, "chapter_id": 2419, "verse_number": "९-३७-२३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2067480, "chapter_id": 2419, "verse_number": "९-३७-२३", "content_sanskrit": "तेषामागच्छतां रात्रौ पथिस्थानां वृकोऽभवत्।\nतत्र कूपो विदूरेऽभूत्सरस्वत्यास्तटे महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2067481, "chapter_id": 2419, "verse_number": "९-३७-२४", "content_sanskrit": "अथं त्रितो वृकं दृष्ट्वा पथि तिष्ठन्तमग्रतः।\nतद्भ्यादपसर्पन्वै तस्मिन्कूपे पपात ह।\nअगाधे सुमहाघोरे सर्वभूतभयङ्करे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2067482, "chapter_id": 2419, "verse_number": "९-३७-२५", "content_sanskrit": "त्रितस्ततो महाराज कूपस्थो मुनिसत्तमः।\nआर्तनादं ततश्चक्रे तौ तु शुश्रुवतुर्मुनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2067483, "chapter_id": 2419, "verse_number": "९-३७-२६", "content_sanskrit": "त ज्ञात्वा पतितं कूपे भ्रातरावेकतद्वितौ।\nवृकत्रासाच्च लोभाच्च समुत्सृज्य प्रजग्मतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2067484, "chapter_id": 2419, "verse_number": "९-३७-२७", "content_sanskrit": "भ्रातृभ्यां पशुलुब्धाभ्यामुत्सृष्टः स महातपाः।\nउदपाने तदा राजन्निर्जले पांसुपंवृते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2067485, "chapter_id": 2419, "verse_number": "९-३७-२८", "content_sanskrit": "त्रित आत्मानमालक्ष्य कूपे वीरुत्तृणावृते।\nनिमग्नं भरतश्रेष्ठ नरके दुष्कृती यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2067486, "chapter_id": 2419, "verse_number": "९-३७-२९", "content_sanskrit": "ततो ह्यचिन्तयत्प्राज्ञो मृतभूतो ह्यसोमपः।\nसोमः कथं तु पातव्य इहस्थेन मया भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2067487, "chapter_id": 2419, "verse_number": "९-३७-३०", "content_sanskrit": "स एवमभिसञ्चिन्त्य तस्मिन्कूपे महातपाः।\nददर्श वीरुधं तत्र लम्बमानां यदृच्छया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2067488, "chapter_id": 2419, "verse_number": "९-३७-३१", "content_sanskrit": "पांसुग्रस्ते ततः कूपे न्यखनत्सलिलं मुनिः।\nअग्नीन्सङ्कल्पयामास होतॄनात्मानमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2067489, "chapter_id": 2419, "verse_number": "९-३७-३२", "content_sanskrit": "ततस्तां वीरुधं सोमं सङ्कल्प सुमहातपाः।\nऋचो जयूंषि सामानि मनसा चिन्तयन्मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2067490, "chapter_id": 2419, "verse_number": "९-३७-३३", "content_sanskrit": "ग्रावाणः शर्कराः कृत्वा प्रचक्रेऽभिषवं नृप।\nआज्यं च सलिलं चक्रे भागांश्च त्रिदिवौकसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2067491, "chapter_id": 2419, "verse_number": "९-३७-३४", "content_sanskrit": "सोमस्याभिषवस्याग्रे प्रवृत्तस्तुमुलो ध्वनिः।\nस चाविशद्दिवं राजन्स्वरश्चैव त्रितस्त वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2067492, "chapter_id": 2419, "verse_number": "९-३७-३५", "content_sanskrit": "समवाप च तं यज्ञां यथोक्तं ब्रह्मवादिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2067493, "chapter_id": 2419, "verse_number": "९-३७-३६", "content_sanskrit": "वर्तमाने महायज्ञे त्रितस्य सुमहात्मनः।\nआविग्नं त्रिदिवं सर्वं कारमं च न बुध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2067494, "chapter_id": 2419, "verse_number": "९-३७-३७", "content_sanskrit": "ततः सुतुमुलं शब्दं शुश्रावाथ बृहस्पतिः।\nश्रुत्वा चैवाब्रवीत्सर्वान्देवान्देवपुरोहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2067495, "chapter_id": 2419, "verse_number": "९-३७-३८", "content_sanskrit": "त्रितस्य वर्तते यज्ञस्तत्र गच्छामहे सुराः।\nस हि क्रुद्धः सृजेदन्यान्देवानपि महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2067496, "chapter_id": 2419, "verse_number": "९-३७-३९", "content_sanskrit": "तच्छ्रुत्वा वचनं तस्य सहिताः सर्वदेवताः।\nप्रययुस्तत्र यत्रास्ते त्रितयज्ञश्च वर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2067497, "chapter_id": 2419, "verse_number": "९-३७-४०", "content_sanskrit": "ते तत्र गत्वा विबुधास्तं कूपं यत्र स त्रितः।\nददृशुस्तं महात्मानं दीक्षितं यज्ञकर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2067498, "chapter_id": 2419, "verse_number": "९-३७-४१", "content_sanskrit": "दृष्ट्वा चैनं महात्मानं श्रिया परमया युतम्।\nऊचुश्चैनं महाभागं प्राप्ता भागार्थिनो वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2067499, "chapter_id": 2419, "verse_number": "९-३७-४२", "content_sanskrit": "अथाब्रवीदृषिर्देवान्पश्यध्वं मां दिवौकसः।\nअस्मिन्प्रतिभये कूपे निमग्नं नष्टचेतसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2067500, "chapter_id": 2419, "verse_number": "९-३७-४३", "content_sanskrit": "ततस्त्रितो महाराज भागांस्तेषां यथाविधि।\nमन्त्रयुक्तान्समददात्तेन प्रीतास्तदाऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2067501, "chapter_id": 2419, "verse_number": "९-३७-४४", "content_sanskrit": "ततो यथाविधि प्राप्तान्भागान्प्राप्य दिवौकसः।\nप्रीतात्मानो ददुस्तस्मै वरान्यान्मनसेच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2067502, "chapter_id": 2419, "verse_number": "९-३७-४५", "content_sanskrit": "स तु वव्रे लवरं देवांस्त्रातुमर्हथ मामितः।\nयश्चाम्भोपस्पृशेत्कूपे स सोमपगतिं लभेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2067503, "chapter_id": 2419, "verse_number": "९-३७-४६", "content_sanskrit": "तत्र चोर्मिमती राजन्नुत्पपात सरस्वती।\nतयोत्क्षिप्तस्त्रितस्तस्थौ पूजयंस्त्रिदिवौकसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2067504, "chapter_id": 2419, "verse_number": "९-३७-४७", "content_sanskrit": "तथेति चोक्त्वा विबुधा जग्मू राजन्यथाऽऽगताः।\nत्रितश्चाभ्यागमत्प्रीतः स्वमेव निलयं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2067505, "chapter_id": 2419, "verse_number": "९-३७-४८", "content_sanskrit": "क्रुद्धस्तु स समासाद्य तावृषी भ्रातरौ तदा।\nउवाच परुषं वाक्यं शशाप च महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2067506, "chapter_id": 2419, "verse_number": "९-३७-४९", "content_sanskrit": "पशुलुब्धौ युवां यस्मान्मामुत्सृज्य प्रधावितौ।\nतस्माद्वृकाकृती रौद्रौ दंष्ट्रिणावभितश्चरौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2067507, "chapter_id": 2419, "verse_number": "९-३७-५०", "content_sanskrit": "भवितारौ मया शप्तौ पापेनानेन कर्मणा।\nप्रसवश्चैव युवयोर्गोलाङ्गूलर्क्षवानराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2067508, "chapter_id": 2419, "verse_number": "९-३७-५१", "content_sanskrit": "इत्युक्तेन तदा तेन क्षणादेव विशाम्पते।\nतथाभूतावदृश्येतां वचनात्सत्यवादिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2067509, "chapter_id": 2419, "verse_number": "९-३७-५२", "content_sanskrit": "तत्राप्यमितविक्रान्तः स्पृष्ट्वा तोयं हलायुधः।\nदत्त्वाच विविधान्देयान्पूजयित्वा च वै द्विजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2067510, "chapter_id": 2419, "verse_number": "९-३७-५३", "content_sanskrit": "उदपानं च तं वीक्ष्य प्रशस्य च पुनःपुनः।\nनदीगतमदीनात्मा प्राप्तो विनशनं तदा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2067511, "chapter_id": 2419, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि ह्रदप्रवेशपर्वणि सप्तत्रिंशोऽध्यायः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]