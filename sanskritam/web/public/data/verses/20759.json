[{"id": 7000759000, "chapter_id": 20759, "verse_number": "६-१०२-१", "content_sanskrit": "नारद उवाच ।\nपतितं वीरभद्रं तु दृंष्ट्वा रुद्रगणा भयात् ।\nआगतास्ते रणं हित्वा क्रोशमाना महेश्वरम्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000759001, "chapter_id": 20759, "verse_number": "६-१०२-२", "content_sanskrit": "अथ कोलाहलं श्रुत्वा गणानां चंद्रशेखरः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000759002, "chapter_id": 20759, "verse_number": "६-१०२-३", "content_sanskrit": "अभ्ययाद्वृषमारूढः संग्रामं प्रहसन्निव ।\nरुद्रमायां तमालोक्य सिंहनादैर्गणाः पुनः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000759003, "chapter_id": 20759, "verse_number": "६-१०२-४", "content_sanskrit": "निवृत्ताः संगरे दैत्यान्निजघ्नुः शरवृष्टिभिः ।\nदैत्याश्च भीषणं रुद्रं दृष्ट्वा सर्वे विदुद्रुवुः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000759004, "chapter_id": 20759, "verse_number": "६-१०२-५", "content_sanskrit": "कार्त्तिकव्रतिनं दृष्ट्वा पातकानीव तद्भयात् ।\nअथ जालंधरो दैत्यान्विद्रुतान्प्रेक्ष्य संगरे॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000759005, "chapter_id": 20759, "verse_number": "६-१०२-६", "content_sanskrit": "रोषादधावच्चंडीशं मुंचन्बाणान्सहस्रशः ।\nशुंभो निशुंभोऽश्वमुखः कालनेमिर्बलाहकः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000759006, "chapter_id": 20759, "verse_number": "६-१०२-७", "content_sanskrit": "खड्गरोमा प्रचंडश्च घस्मरश्च शिवं ययुः ।\nबाणांधकारसंच्छन्नं दृष्ट्वा गणबलं शिवः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000759007, "chapter_id": 20759, "verse_number": "६-१०२-८", "content_sanskrit": "तद्बाणजालं विच्छिद्य स्वबाणैरावृणोन्नभः ।\nदैत्यांश्च बाणवात्याभिः पीडितानकरोत्तदा॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000759008, "chapter_id": 20759, "verse_number": "६-१०२-९", "content_sanskrit": "प्रचंडजालबाणौघैरपातयत भूतले ।\nखड्गरोम्णः शिरः कोपात्तथा परशुनाच्छिनत्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000759009, "chapter_id": 20759, "verse_number": "६-१०२-१०", "content_sanskrit": "बलाहकस्य च शिरः खंट्वागेनाकरोद्द्विधा ।\nबद्ध्वा च घस्मरं दैत्यं पाशेनाभ्यहनाद्भुवि॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000759010, "chapter_id": 20759, "verse_number": "६-१०२-११", "content_sanskrit": "वृषभेण हताः केचित्केचिद्बाणैर्निराकृताः ।\nन शेकुरसुराः स्थातुं गजाः सिंहार्दिता यथा॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000759011, "chapter_id": 20759, "verse_number": "६-१०२-१२", "content_sanskrit": "ततः कोपपरीतात्मा वेगाद्रुद्रं जलंधरः ।\nआह्वयामास समरे तीव्राशनिसमस्वनः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000759012, "chapter_id": 20759, "verse_number": "६-१०२-१३", "content_sanskrit": "जलंधर उवाच ।\nयुध्यस्वाद्य मया सार्द्धं किमेभिर्निहितैस्तव ।\nयच्च किंचिद्बलं तेऽस्ति तद्दर्शय जटाधर॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000759013, "chapter_id": 20759, "verse_number": "६-१०२-१४", "content_sanskrit": "नारद उवाच ।\nइत्युक्त्वा बाणसप्तत्या जघान वृषभध्वजम् ।\nतानप्राप्तान्शितैर्बाणैश्चिच्छेद प्रहसन्निव॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000759014, "chapter_id": 20759, "verse_number": "६-१०२-१५", "content_sanskrit": "ततो हयान्ध्वजं छत्रं धनुश्चिच्छेद सप्तभिः ।\nसच्छिन्नधन्वा विरथो गदामादाय वीर्यवान्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000759015, "chapter_id": 20759, "verse_number": "६-१०२-१६", "content_sanskrit": "अभ्यधावच्छिवस्तावद्गदाबाणैर्द्विधाकरोत् ।\nतथापि मुष्टिमुद्यम्य ययौ रुद्रजिघांसया॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000759016, "chapter_id": 20759, "verse_number": "६-१०२-१७", "content_sanskrit": "तावच्छिवेन बाणौघैः क्रोशमात्रमपाकृतः ।\nततो जालंधरो दैत्यो मत्वा रुद्रं बलाधिकम्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000759017, "chapter_id": 20759, "verse_number": "६-१०२-१८", "content_sanskrit": "ससर्ज मायां गांधर्वीमद्भुतां रुद्रमोहिनीम् ।\nततो जगुश्च ननृतुर्गंधर्वाप्सरसांगणाः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000759018, "chapter_id": 20759, "verse_number": "६-१०२-१९", "content_sanskrit": "तालवेणुमृदंगांश्च वादयंतः परस्परम् ।\nतं दृष्ट्वा महदाश्चर्यं रुद्रो नादविमोहितः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000759019, "chapter_id": 20759, "verse_number": "६-१०२-२०", "content_sanskrit": "पतितान्यपि शस्त्राणि करेभ्यो न विवेद सः ।\nएकाग्रभूतमालोक्यरुद्रं दैत्यो जलंधरः॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000759020, "chapter_id": 20759, "verse_number": "६-१०२-२१", "content_sanskrit": "कामार्त्तः सञ्जगामाशु यत्र गौरी स्थिताभवत् ।\nयुद्धे शुंभनिशुंभाख्यौ स्थापयित्वा महाबलौ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000759021, "chapter_id": 20759, "verse_number": "६-१०२-२२", "content_sanskrit": "दशदोर्दंडपंचास्यस्त्रिनेत्रश्च जटाधरः ।\nमहावृषभमारूढः स बभूव जलंधरः॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000759022, "chapter_id": 20759, "verse_number": "६-१०२-२३", "content_sanskrit": "अथ रुद्रं समायांतमालोक्य भववल्लभा ।\nअभ्याययौ सखीमध्यात्तद्दर्शनपथेऽभवत्॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000759023, "chapter_id": 20759, "verse_number": "६-१०२-२४", "content_sanskrit": "यावद्ददर्श चार्वगीं पार्वतीं दनुजेश्वरः ।\nतावत्स वीर्यं मुमुचे जडांगश्चाभवत्तदा॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000759024, "chapter_id": 20759, "verse_number": "६-१०२-२५", "content_sanskrit": "अथ ज्ञात्वा तदा गौरी दानवं भयविह्वला ।\nजगामांतर्हिता तावत्सा तदोत्तरमानसम्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000759025, "chapter_id": 20759, "verse_number": "६-१०२-२६", "content_sanskrit": "तामदृष्ट्वा तदा दैत्यः क्षणाद्विद्युल्लतामिव ।\nजवेनायात्पुनर्युद्धं यत्र देवो वृषध्वजः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000759026, "chapter_id": 20759, "verse_number": "६-१०२-२७", "content_sanskrit": "पार्वत्यपि महाविष्णुं सस्मार मनसा तदा ।\nतावद्ददर्श तं देवी सोपविष्टं समीपगम्॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000759027, "chapter_id": 20759, "verse_number": "६-१०२-२८", "content_sanskrit": "पार्वत्युवाच ।\nविष्णो जलंधरो दैत्यः कृतवान्परमाद्भुतम् ।\nतत्किं न विदितं तेऽस्ति चेष्टितं तस्य दुर्मतेः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000759028, "chapter_id": 20759, "verse_number": "६-१०२-२९", "content_sanskrit": "श्रीभगवानुवाच ।\nतेनैव दर्शितः पंथा वयमप्यन्वयामहे ।\nनान्यथा स भवेद्वध्यः पातिव्रत्यात्सुरक्षितः॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000759029, "chapter_id": 20759, "verse_number": "६-१०२-३०", "content_sanskrit": "नारद उवाच ।\nजगाम विष्णुरित्युक्त्वा पुनर्जालंधरं पुरम् ।\nअथ रुद्रश्च गंधर्वानुगतः संगरे स्थितः॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000759030, "chapter_id": 20759, "verse_number": "६-१०२-३१", "content_sanskrit": "अंतर्द्धानगतां मायां दृष्ट्वा तु बुबुधे तदा ।\nततः शिवो विस्मितमानसः पुनर्जगाम युद्धाय जलंधरं रुषा॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000759031, "chapter_id": 20759, "verse_number": "६-१०२-३२", "content_sanskrit": "स चापि दैत्यः पुनरागतं शिवं दृष्ट्वा शरौघैः समवाकिरद्रणे॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]