[{"id": 2076523, "chapter_id": 2622, "verse_number": "१२-१२७-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2076524, "chapter_id": 2622, "verse_number": "१२-१२७-१", "content_sanskrit": "ततस्तेषां समेतानामृषीणामृषिसत्तमः।\nऋषभो नाम विप्रर्षिर्विस्मयन्निदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2076525, "chapter_id": 2622, "verse_number": "१२-१२७-२", "content_sanskrit": "पुराऽहं राजशार्दूल तीर्थान्यनुचरन्प्रभो।\nसमासादितवान्दिव्यं नरनारायणाश्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2076526, "chapter_id": 2622, "verse_number": "१२-१२७-३", "content_sanskrit": "यत्र सा बदरी रम्या सरो वैहायसं तथा।\nयत्र चाश्वशिरा राजन्वेदान्पठति शाश्वतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2076527, "chapter_id": 2622, "verse_number": "१२-१२७-४", "content_sanskrit": "तस्मिन्सरसि कृत्वाऽहं विधिवत्तर्पणं पुरा।\nपितृणां देवतानां च ततोश्रममियां तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2076528, "chapter_id": 2622, "verse_number": "१२-१२७-५", "content_sanskrit": "रमाते यत्र तौ नित्यं नरनारायणावृषी।\nअदूरादाश्रमात्किंचिद्वासार्थमगमं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2076529, "chapter_id": 2622, "verse_number": "१२-१२७-६", "content_sanskrit": "अत्र चीराजिनधरं कृशमुच्चमतीव च।\nअद्राक्षमृषिमायान्तं तनुं नाम तपोनिधिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2076530, "chapter_id": 2622, "verse_number": "१२-१२७-७", "content_sanskrit": "अन्यैर्नरैर्महाबाहो वपुषाऽप्रतिमं तदा।\nकृशता चापि राजर्षे न दृष्टा तादृशी मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2076531, "chapter_id": 2622, "verse_number": "१२-१२७-८", "content_sanskrit": "शरीरमपि राजेन्द्र तनु कानिष्ठिकासमम्।\nग्रीवा बाहू तथा पादौ केशाश्चाद्भुतदर्शनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2076532, "chapter_id": 2622, "verse_number": "१२-१२७-९", "content_sanskrit": "शिरः कायानुरूपं च कर्णौ नेत्रे तथैव च।\nतस्य वाक्चैव चेष्टा च सामान्ये राजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2076533, "chapter_id": 2622, "verse_number": "१२-१२७-१०", "content_sanskrit": "दृष्ट्वाऽहं तं कृशं विप्रं भीतः परमदुर्मनाः।\nपादौ तस्याभिवाद्याथ स्थितः प्राञ्जलिरग्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2076534, "chapter_id": 2622, "verse_number": "१२-१२७-११", "content_sanskrit": "निवेद्य नामगोत्रे च तथा कार्यं नरर्षभ।\nप्रदिष्टे चासने तेन शनैरहमुपाविशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2076535, "chapter_id": 2622, "verse_number": "१२-१२७-१२", "content_sanskrit": "ततः स कथयामास धर्मार्थसहिताः कथाः।\nऋषिमध्ये महाराज तत्र धर्मभृतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2076536, "chapter_id": 2622, "verse_number": "१२-१२७-१३", "content_sanskrit": "त--स्तु कथयत्येव राजा राजीवलोचनः।\nउपयाज्जवनैरश्वैः सबलः सावरोधनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2076537, "chapter_id": 2622, "verse_number": "१२-१२७-१४", "content_sanskrit": "स्मरम्पुत्रमरण्ये वै नष्टं परमदुर्मनाः।\nभूविद्युम्नपिता श्रीमान्वीरद्युम्नो महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2076538, "chapter_id": 2622, "verse_number": "१२-१२७-१५", "content_sanskrit": "इह द्रक्ष्यामि तं पुत्रं द्रक्ष्यामीहेति भारत।\nएवमाशाकृशो राजा चरन्वनमिदं पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2076539, "chapter_id": 2622, "verse_number": "१२-१२७-१६", "content_sanskrit": "दुर्लभः स मया द्रष्टुं भूय एव च धार्मिक।\nएकः पुत्रो महारण्ये नष्ट इत्यसकृत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2076540, "chapter_id": 2622, "verse_number": "१२-१२७-१७", "content_sanskrit": "न स शक्यो मया द्रष्टुमाशा च महती मम।\nतया परीतगात्रोऽहं मुमूर्षुर्नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2076541, "chapter_id": 2622, "verse_number": "१२-१२७-१८", "content_sanskrit": "एतच्छ्रुत्वा तु भगवांस्तनुर्मुनिवरोत्तमः।\nअवाक्शिरा ध्यानपरो मुहूर्तमिव तस्थिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2076542, "chapter_id": 2622, "verse_number": "१२-१२७-१९", "content_sanskrit": "तमनुध्यान्तमालक्ष्य राजा परमदुर्मनाः।\nउवाच वाक्यं दीनात्मा मन्दमन्दमिवासकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2076543, "chapter_id": 2622, "verse_number": "१२-१२७-२०", "content_sanskrit": "दुर्लभं किंनु देवर्षे आशायाश्चैव किं महत्।\nब्रवीतु भगवानेतद्यदि गुह्यं न चेत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2076544, "chapter_id": 2622, "verse_number": "१२-१२७-२१x", "content_sanskrit": "तनुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2076545, "chapter_id": 2622, "verse_number": "१२-१२७-२१", "content_sanskrit": "महर्षिर्भगवांस्तेन पूर्वमासीद्विमानितः।\nबालिशां बुद्धिमास्थाय मन्दभाग्यतयाऽऽत्मनः।\nअर्थयन्कुशलं राजन्काञ्चनं वल्कलानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2076546, "chapter_id": 2622, "verse_number": "१२-१२७-२२", "content_sanskrit": "[अवज्ञापूर्वकेनापि न संपादितवांस्ततः।]\nनिर्विण्णः स तु विप्रर्षिर्निराशः समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2076547, "chapter_id": 2622, "verse_number": "१२-१२७-२३", "content_sanskrit": "एवमुक्तोऽभिवाद्याथ तमृषिं लोकपूजितम्।\nश्रान्तोऽवसीदद्धर्मात्मा यथा त्वं नरसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2076548, "chapter_id": 2622, "verse_number": "१२-१२७-२४", "content_sanskrit": "अर्ध्यं ततः समानीय पाद्यं चैव महायशाः।\nआरण्येनैव विधिना राज्ञे सर्वं न्यवेदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2076549, "chapter_id": 2622, "verse_number": "१२-१२७-२५", "content_sanskrit": "ततस्तमृषयः सर्वे परिवार्य नरर्षभम्।\nउपाविशन्पुरस्कृत्य सप्तर्षय इव ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2076550, "chapter_id": 2622, "verse_number": "१२-१२७-२६", "content_sanskrit": "अपृच्छंश्चैव तत्रैनं राजानमपराजितम्।\nप्रयोजनमिदं सर्वमाश्रमस्य प्रवेशने॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2076551, "chapter_id": 2622, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि सप्तविंशत्यधिकशततमोऽध्यायः॥ १२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]