[{"id": 6000311000, "chapter_id": 10311, "verse_number": null, "content_sanskrit": "दशमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000311001, "chapter_id": 10311, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.001.m4a", "display_order": 2}, {"id": 6000311002, "chapter_id": 10311, "verse_number": "११-१०-१", "content_sanskrit": "मयोदितेष्ववहितः स्वधर्मेषु मदाश्रयः।\nवर्णाश्रमकुलाचारमकामात्मा समाचरेत्॥ ११/१०/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.002.m4a", "display_order": 3, "topics": [{"text": "श्रीकृष्णेनोद्धवं प्रति जीवस्य संसारप्राप्तिकारणकथनम्", "range": "१–३७"}]}, {"id": 6000311003, "chapter_id": 10311, "verse_number": "११-१०-२", "content_sanskrit": "अन्वीक्षेत विशुद्धात्मा देहिनां विषयात्मनाम्।\nगुणेषु तत्त्वज्ञानेन सर्वारम्भविपर्ययम्॥ ११/१०/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.003.m4a", "display_order": 4}, {"id": 6000311004, "chapter_id": 10311, "verse_number": "११-१०-३", "content_sanskrit": "सुप्तस्य विषयालोको ध्यायतो वा मनोरथः।\nनानात्मकत्वाद् विफलस्तथाऽभेदोऽन्यधीगुणैः॥ ११/१०/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.004.m4a", "display_order": 5}, {"id": 6000311005, "chapter_id": 10311, "verse_number": "११-१०-४", "content_sanskrit": "निवृत्तं कर्म सेवेत प्रवृत्तं मत्परस्त्यजेत्।\nजिज्ञासायां सम्प्रवृत्तो नाद्रियेत् कर्मचोदनाम्॥ ११/१०/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.005.m4a", "display_order": 6}, {"id": 6000311006, "chapter_id": 10311, "verse_number": "११-१०-५", "content_sanskrit": "यमानभीक्ष्णं सेवेत नियमान् मत्परः क्‍वचित्।\nमदभिज्ञं गुरुं शान्तमुपासीत मदात्मकम्॥ ११/१०/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.006.m4a", "display_order": 7}, {"id": 6000311007, "chapter_id": 10311, "verse_number": "११-१०-६", "content_sanskrit": "अमान्यमत्सरो दक्षो निगमे दृढसौहृदः।\nअसत्त्वरोऽर्थजिज्ञासुरनसूयुरमोघवाक्॥ ११/१०/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.007.m4a", "display_order": 8}, {"id": 6000311008, "chapter_id": 10311, "verse_number": "११-१०-७", "content_sanskrit": "जायापत्यगृहक्षेत्रस्वजनद्रविणादिषु।\nउदासीनः समं पश्येत् सर्वेष्वर्थमिवात्मनः॥ ११/१०/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.008.m4a", "display_order": 9}, {"id": 6000311009, "chapter_id": 10311, "verse_number": "११-१०-८", "content_sanskrit": "विलक्षणः स्थूलसूक्ष्माद् देहादात्मेक्षिता पृथक्।\nयथाग्निर्दारुणो दाह्याद् दाहकोऽन्यः प्रकाशकः॥ ११/१०/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.009.m4a", "display_order": 10}, {"id": 6000311010, "chapter_id": 10311, "verse_number": "११-१०-९", "content_sanskrit": "निरोधोत्पत्त्यणुबृहन्नानात्वं तत्कृतान् गुणान्।\nअनुप्रविष्ट आधत्ते एवं देहगुणान् परः॥ ११/१०/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.010.m4a", "display_order": 11}, {"id": 6000311011, "chapter_id": 10311, "verse_number": "११-१०-१०", "content_sanskrit": "योऽसौ गुणैर्विरचितो देहोऽयं पुरुषस्य हि।\nसंसारस्तन्निबन्धोऽयं पुंसोऽविद्यास्थितात्मनः॥ ११/१०/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.011.m4a", "display_order": 12}, {"id": 6000311012, "chapter_id": 10311, "verse_number": "११-१०-११", "content_sanskrit": "तस्माज्जिज्ञासयाऽऽत्मानमात्मस्थं केवलं परम्।\nसङ्गम्य निरसेदेतद्वस्तुबुद्धिं यथाक्रमम्॥ ११/१०/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.012.m4a", "display_order": 13}, {"id": 6000311013, "chapter_id": 10311, "verse_number": "११-१०-१२", "content_sanskrit": "आचार्योऽरणिराद्या स्यादन्तेवास्युत्तरारणिः।\nतत्साधनं प्रवचनं विद्यावह्निः सुखावहः॥ ११/१०/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.013.m4a", "display_order": 14}, {"id": 6000311014, "chapter_id": 10311, "verse_number": "११-१०-१३", "content_sanskrit": "वैशारदी साऽतिविशुद्धबुद्धिर्धुनोति मायां गुणसम्प्रसूतिम्।\nगुणांश्च संदह्य यदात्म्यमेतत् स्वयं च शाम्यत्यसमिद् यथाऽग्निः॥ ११/१०/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.014.m4a", "display_order": 15}, {"id": 6000311015, "chapter_id": 10311, "verse_number": "११-१०-१४", "content_sanskrit": "अथैषां कर्मकर्तॄणां भोक्तॄणां सुखदुःखयोः।\nनानात्वमथ नित्यत्वं लोककालागमात्मनाम्॥ ११/१०/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.015.m4a", "display_order": 16}, {"id": 6000311016, "chapter_id": 10311, "verse_number": "११-१०-१५", "content_sanskrit": "मन्यसे सर्वभावानां संस्था ह्यौत्पत्तिकी तथा।\nतत्तदाकृतिभेदेन जायते भिद्यते च धीः॥ ११/१०/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.016.m4a", "display_order": 17}, {"id": 6000311017, "chapter_id": 10311, "verse_number": "११-१०-१६", "content_sanskrit": "एवमप्यत्र सर्वेषां देहिनां देहयोगतः।\nकालावयवतः सन्ति भावा जन्मादयोऽसकृत्॥ ११/१०/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.017.m4a", "display_order": 18}, {"id": 6000311018, "chapter_id": 10311, "verse_number": "११-१०-१७", "content_sanskrit": "तत्रापि कर्मणां कर्तुरस्वातन्त्र्यं च लक्ष्यते।\nभोक्तुश्च सुखदुःखानां को न्वर्थो विवशं भजेत्॥ ११/१०/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.018.m4a", "display_order": 19}, {"id": 6000311019, "chapter_id": 10311, "verse_number": "११-१०-१८", "content_sanskrit": "न देहिनां सुखं किञ्चिद् विद्यते विदुषामपि।\nतथा च दुःखमूढानां तथाऽहङ्कारिणां परम्॥ ११/१०/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.019.m4a", "display_order": 20}, {"id": 6000311020, "chapter_id": 10311, "verse_number": "११-१०-१९", "content_sanskrit": "यदि प्राप्तिं विघातं च जानन्ति सुखदुःखयोः।\nतेऽप्यद्धा न विदुर्योगं मृत्युर्न प्रभवेद् यथा॥ ११/१०/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.020.m4a", "display_order": 21}, {"id": 6000311021, "chapter_id": 10311, "verse_number": "११-१०-२०", "content_sanskrit": "को न्वर्थः सुखयन्त्येनं कामो वा मृत्युमन्तिके।\nआघातं नीयमानस्य वध्यस्येव पदे पदे॥ ११/१०/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.021.m4a", "display_order": 22}, {"id": 6000311022, "chapter_id": 10311, "verse_number": "११-१०-२१", "content_sanskrit": "श्रुतं च दृष्टवन्नश्येत् स्पर्धासूयात्ययाप्ययैः।\nबह्वन्तरायैर्विहतं कृषिवच्चापि निष्फलम्॥ ११/१०/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.022.m4a", "display_order": 23}, {"id": 6000311023, "chapter_id": 10311, "verse_number": "११-१०-२२", "content_sanskrit": "अन्तरायैरविहतो यदि धर्मः स्वनुष्ठितः।\nतेनापि निर्जितं स्थानं यथा गच्छति तच्छृणु॥ ११/१०/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.023.m4a", "display_order": 24}, {"id": 6000311024, "chapter_id": 10311, "verse_number": "११-१०-२३", "content_sanskrit": "इष्ट्वैव देवता यज्ञैः स्वर्लोकं याति याज्ञिकः।\nभुञ्जीत देववत् तत्र भोगान् दिव्यान् निजार्जितान्॥ ११/१०/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.024.m4a", "display_order": 25}, {"id": 6000311025, "chapter_id": 10311, "verse_number": "११-१०-२४", "content_sanskrit": "स्वपुण्योपचिते शुभ्रे विमान उपगीयते।\nगन्धर्वैर्विहरन् मध्ये देवीनां हृद्यवेषधृक्॥ ११/१०/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.025.m4a", "display_order": 26}, {"id": 6000311026, "chapter_id": 10311, "verse_number": "११-१०-२५", "content_sanskrit": "स्‍त्रीभिः कामगयानेन किङ्किणीजालमालिना।\nक्रीडन् न वेदात्मपातं सुराक्रीडेषु निर्वृतः॥ ११/१०/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.026.m4a", "display_order": 27}, {"id": 6000311027, "chapter_id": 10311, "verse_number": "११-१०-२६", "content_sanskrit": "तावत् प्रमोदते स्वर्गे यावत् पुण्यं समाप्यते।\nक्षीणपुण्यः पतत्यर्वागनिच्छन् कालचालितः॥ ११/१०/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.027.m4a", "display_order": 28}, {"id": 6000311028, "chapter_id": 10311, "verse_number": "११-१०-२७", "content_sanskrit": "यद्यधर्मरतः सङ्गादसतामजितेन्द्रियः।\nकामात्मा कृपणो लुब्धः स्‍त्रैणो भूतविहिंसकः॥ ११/१०/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.028.m4a", "display_order": 29}, {"id": 6000311029, "chapter_id": 10311, "verse_number": "११-१०-२८", "content_sanskrit": "पशूनविधिनाऽऽलभ्य प्रेतभूतगणान् यजन्।\nनरकानवशो जन्तुर्गत्वा यात्युल्बणं तमः॥ ११/१०/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.029.m4a", "display_order": 30}, {"id": 6000311030, "chapter_id": 10311, "verse_number": "११-१०-२९", "content_sanskrit": "कर्माणि दुःखोदर्काणि कुर्वन् देहेन तैः पुमान्।\nदेहमाभजते तत्र किं सुखं मर्त्यधर्मिणः॥ ११/१०/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.030.m4a", "display_order": 31}, {"id": 6000311031, "chapter_id": 10311, "verse_number": "११-१०-३०", "content_sanskrit": "लोकानां लोकपालानां मद्भयं कल्पजीविनाम्।\nब्रह्मणोऽपि भयं मत्तो द्विपरार्धपरायुषः॥ ११/१०/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.031.m4a", "display_order": 32}, {"id": 6000311032, "chapter_id": 10311, "verse_number": "११-१०-३१", "content_sanskrit": "गुणाः सृजन्ति कर्माणि कालो नु सृजते गुणान्।\nजीवस्तु गुणसंयुक्तो भुङ्क्ते कर्मफलान्यसौ॥ ११/१०/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.032.m4a", "display_order": 33}, {"id": 6000311033, "chapter_id": 10311, "verse_number": "११-१०-३२", "content_sanskrit": "यावत् स्याद् गुणवैषम्यं तावन्नानात्वमात्मनः।\nनानात्वमात्मनो यावत् पारतन्त्र्यं तदैव हि॥ ११/१०/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.033.m4a", "display_order": 34}, {"id": 6000311034, "chapter_id": 10311, "verse_number": "११-१०-३३", "content_sanskrit": "यावदस्यास्वतन्त्रत्वं तावदीश्वरतो भयम्।\nय एतत् समुपासीरंस्ते मुह्यन्ति शुचर्पिताः॥ ११/१०/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.034.m4a", "display_order": 35}, {"id": 6000311035, "chapter_id": 10311, "verse_number": "११-१०-३४", "content_sanskrit": "काल आत्माऽऽगमो लोकः स्वभावो धर्म एव च।\nइति मां बहुधा प्राहुर्गुणव्यतिकरेऽसति॥ ११/१०/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.035.m4a", "display_order": 36}, {"id": 6000311036, "chapter_id": 10311, "verse_number": null, "content_sanskrit": "उद्धव उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.036.m4a", "display_order": 37}, {"id": 6000311037, "chapter_id": 10311, "verse_number": "११-१०-३५", "content_sanskrit": "गुणेषु वर्तमानोऽपि देहजेष्वनपावृतः।\nगुणैर्न बध्यतेऽदेही बध्यते वा कथं विभो॥ ११/१०/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.037.m4a", "display_order": 38}, {"id": 6000311038, "chapter_id": 10311, "verse_number": "११-१०-३६", "content_sanskrit": "कथं वर्तेत विहरेत् कैर्वा ज्ञायेत लक्षणैः।\nकिं भुञ्जीतोत विसृजेच्छयीतासीत याति वा॥ ११/१०/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.038.m4a", "display_order": 39}, {"id": 6000311039, "chapter_id": 10311, "verse_number": "११-१०-३७", "content_sanskrit": "एतदच्युत मे ब्रूहि प्रश्नं प्रश्नविदां वर।\nनित्यमुक्तो नित्यबद्ध एक एवेति मे मतिः॥ ११/१०/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_010/BhP_11.010.039.m4a", "display_order": 40}, {"id": 6000311040, "chapter_id": 10311, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायाम् एकादशस्कन्धे दशमाध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]