[{"id": 7004032000, "chapter_id": 24032, "verse_number": "३-३-३-१", "content_sanskrit": "राजोवाच ।\nकिं दृष्टं भवता ब्रह्मन्नाश्चर्यं पथि कुत्र वा ।\nतन्ममाख्याहि येनाहं कृतकृत्यत्वमाप्नुयाम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004032001, "chapter_id": 24032, "verse_number": "३-३-३-२", "content_sanskrit": "गौतम उवाच ।\nगोकर्णादहमागच्छन्क्वापि देशे विशांपते ।\nजाते मध्याह्नसमये लब्ध वान्विमलं सरः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004032002, "chapter_id": 24032, "verse_number": "३-३-३-३", "content_sanskrit": "तत्रोपस्पृश्य सलिलं विनीय च पथिश्रमम् ।\nसुस्निग्धशीतलच्छायं न्यग्रोधं समुपाश्रयम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004032003, "chapter_id": 24032, "verse_number": "३-३-३-४", "content_sanskrit": "अथाविदूरे चांडालीं वृद्धामंधां कृशाकृतिम् ।\nशुष्यन्मुखीं निराहारां बहुरोगनिपीडिताम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004032004, "chapter_id": 24032, "verse_number": "३-३-३-५", "content_sanskrit": "कुष्ठव्रणपरीतांगीमुद्यत्कृमिकुलाकुलाम् ।\nपूयशोणितसंसक्तजरत्पटल सत्कटीम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004032005, "chapter_id": 24032, "verse_number": "३-३-३-६", "content_sanskrit": "महायक्ष्मगलस्थेन कंठसंरोधविह्वलाम् ।\nविनष्टदंतामव्यक्तां विलुठंतीं मुहुर्मुहुः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004032006, "chapter_id": 24032, "verse_number": "३-३-३-७", "content_sanskrit": "चंडार्ककिरणस्पृष्टखरोष्णरजसाप्लुताम् ।\nविण्मूत्रपूयदिग्धांगीमसृग्गंधदुरासदाम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004032007, "chapter_id": 24032, "verse_number": "३-३-३-८", "content_sanskrit": "कफरोगबहुश्वासश्लथन्नाडीबहुव्यथाम् ।\nविध्वस्तकेशावयवामपश्यं मरणोन्मुखीम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004032008, "chapter_id": 24032, "verse_number": "३-३-३-९", "content_sanskrit": "तादृग्व्यथां च तां वीक्ष्य कृपयाहं परिप्लुतः ।\nप्रतीक्षन्मरणं तस्याः क्षणं तत्रैव संस्थितः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004032009, "chapter_id": 24032, "verse_number": "३-३-३-१०", "content_sanskrit": "अथांतरिक्षपदवीं सिंचंतमिव रश्मिभिः ।\nदिव्यं विमानमानीतमद्राक्षं शिवकिंकरैः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004032010, "chapter_id": 24032, "verse_number": "३-३-३-११", "content_sanskrit": "तस्मिन्रवींदुवह्नीनां तेजसामिव पंजरे ।\nविमाने सूर्यसंकाशानपश्यं शिवकिंकरान्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004032011, "chapter_id": 24032, "verse_number": "३-३-३-१२", "content_sanskrit": "ते वै त्रिशूलखट्वांगटंकचर्मासिपाणयः ।\nचंद्रार्धभूषणाः सांद्रचंद्रकुंदोरुवर्चसः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004032012, "chapter_id": 24032, "verse_number": "३-३-३-१३", "content_sanskrit": "किरीटकुंडलभ्राजन्महाहिवलयोज्ज्वलाः ।\nशिवानुगा मया दृष्टा श्चत्वारः शुभलक्षणाः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004032013, "chapter_id": 24032, "verse_number": "३-३-३-१४", "content_sanskrit": "तानापतत आलोक्य विमानस्थान्सुविस्मितः ।\nउपसृत्यांतिके वेगादपृच्छं गगने स्थितान्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004032014, "chapter_id": 24032, "verse_number": "३-३-३-१५", "content_sanskrit": "नमोनमो वस्त्रिदशोत्तमेभ्यस्त्रिलोचनश्रीचरणानुगेभ्यः ।\nत्रिलोकरक्षाविधिमावहद्भ्यस्त्रिशूलचर्मासिगदाधरेभ्यः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004032015, "chapter_id": 24032, "verse_number": "३-३-३-१६", "content_sanskrit": "विदिता हि मया यूयं महेश्वरपदा नुगाः ।\nइयं वो लोकरक्षार्था गतिराहो विनोदजा॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004032016, "chapter_id": 24032, "verse_number": "३-३-३-१७", "content_sanskrit": "उत सर्वजनाघौघविजयाय कृतोद्यमाः ।\nब्रूत कारुण्यतो मह्यं यस्माद्यूयमिहागताः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004032017, "chapter_id": 24032, "verse_number": "३-३-३-१८", "content_sanskrit": "शिवदूता ऊचुः ।\nएषाग्रे दृश्यते वृद्धा चांडाली मरणोन्मुखी ।\nएतामानेतुमायाताः संदिष्टा प्रभुणा वयम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004032018, "chapter_id": 24032, "verse_number": "३-३-३-१९", "content_sanskrit": "इत्युक्ते शिवदूतैस्तैरपृच्छं पुनरप्यहम् ।\nविस्मयाविष्टचित्तस्तान्कृतांजलिरवस्थितः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004032019, "chapter_id": 24032, "verse_number": "३-३-३-२०", "content_sanskrit": "अहो पापीयसी घोरा चांडाली कथमर्हति ।\nदिव्यं विमानमारोढुं शुनीवाध्वरमंडलम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004032020, "chapter_id": 24032, "verse_number": "३-३-३-२१", "content_sanskrit": "आजन्मतोऽशुचिप्राया पापां पापा नुगामिनीम् ।\nकथमेनां दुराचारां शिवलोकं निनीषथ॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004032021, "chapter_id": 24032, "verse_number": "३-३-३-२२", "content_sanskrit": "अस्या नास्ति शिवज्ञानं नास्ति घोरतरं तपः ।\nसत्यं नास्ति दया नास्ति कथमेनां निनीषथ॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004032022, "chapter_id": 24032, "verse_number": "३-३-३-२३", "content_sanskrit": "पशुमांसकृताहारा वारुणीपूरितोदराम् ।\nजीवहिंसारतां नित्यं कथमेनां निनीषथ॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004032023, "chapter_id": 24032, "verse_number": "३-३-३-२४", "content_sanskrit": "न च पंचाक्षरी जप्ता न कृतं शिवपूजनम् ।\nन ध्यातो भगवाञ्छंभुः कथमेनां निनीषथ॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004032024, "chapter_id": 24032, "verse_number": "३-३-३-२५", "content_sanskrit": "नोपोषिता शिवतिथिर्न कृतं शिवपूजनम् ।\nभूतसौहृदं न जानाति न च बिल्वशिवार्पणम् ।\nनेष्टापूर्तादिकं वापि कथमेनां निनीषथ॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004032025, "chapter_id": 24032, "verse_number": "३-३-३-२६", "content_sanskrit": "न च स्नातानि तीर्थानि न दानानि कृतानि च ।\nन च व्रतानि चीर्णानि कथमेनां निनीषथ॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004032026, "chapter_id": 24032, "verse_number": "३-३-३-२७", "content_sanskrit": "ईक्षणे परिहर्त्तव्या किमु संभाषणादिषु ।\nसत्संगरहितां चंडां कथमेनां निनीषथ॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004032027, "chapter_id": 24032, "verse_number": "३-३-३-२८", "content_sanskrit": "जन्मांतरार्जितं किंचिदस्याः सुकृतमस्ति वा ।\nतत्कथं कुष्ठरोगण कृमिभिः परिभूयते॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004032028, "chapter_id": 24032, "verse_number": "३-३-३-२९", "content_sanskrit": "अहो ईश्वरचर्येयं दुर्विभाव्या शरीरिणाम् ।\nपापात्मानोऽपि नीयंते कारुण्यात्परमं पदम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004032029, "chapter_id": 24032, "verse_number": "३-३-३-३०", "content_sanskrit": "इत्युक्तास्ते मया दूता देवदेवस्य शूलिनः ।\nप्रत्यूचुर्मामथ प्रीत्या सर्वसंशयभेदिनः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004032030, "chapter_id": 24032, "verse_number": "३-३-३-३१", "content_sanskrit": "शिवदूता ऊचुः ।\nब्रह्मन्सुमहदाश्चर्यं शृणु कौतूहलं यदि ।\nइमामुद्दिश्य चांडालीं यदुक्तं भवताधुना॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004032031, "chapter_id": 24032, "verse_number": "३-३-३-३२", "content_sanskrit": "आसीदियं पूर्वभवे काचिद्ब्राह्मणकन्यका ।\nसुमित्रानाम संपूर्णसोमबिम्बसमानना॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004032032, "chapter_id": 24032, "verse_number": "३-३-३-३३", "content_sanskrit": "उत्फुल्लमल्लिकादामसुकुमारांगलक्षणा ।\nकैकेयद्विजमुख्यस्य कस्यचित्तनया सती॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004032033, "chapter_id": 24032, "verse_number": "३-३-३-३४", "content_sanskrit": "तां सर्वलक्षणोपेतां रतेर्मूर्तिमिवापराम् ।\nवर्द्धमानां पितुर्गेहे वीक्ष्यासन्विस्मिता जनाः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004032034, "chapter_id": 24032, "verse_number": "३-३-३-३५", "content_sanskrit": "दिनेदिने वर्धमाना बंधुभिर्लालिता भृशम् ।\nसा शनैर्यौवनं भेजे स्मरस्येव महाधनुः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004032035, "chapter_id": 24032, "verse_number": "३-३-३-३६", "content_sanskrit": "अथ सा बंधुवर्गैश्च समेतेन कुमारिका ।\nपित्रा प्रदत्ता कस्मैचिद्विधिना द्विजसूनवे॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004032036, "chapter_id": 24032, "verse_number": "३-३-३-३७", "content_sanskrit": "सा भर्त्तारमनुप्राप्य नवयौवनशालिनी ।\nकंचित्कालं शुभाचारा रेमे बंधुभिरावृता॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004032037, "chapter_id": 24032, "verse_number": "३-३-३-३८", "content_sanskrit": "अथ कालवशात्तस्याः पतिस्तीव्र रुजार्दितः ।\nरूपयौवनकांतोपि पंचत्वमगमन्मुने॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004032038, "chapter_id": 24032, "verse_number": "३-३-३-३९", "content_sanskrit": "मृते भर्त्तरि दुःखेन विदग्धहदया सती ।\nउवास कतिचिन्मासान्सुशीला विजितें द्रिया॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004032039, "chapter_id": 24032, "verse_number": "३-३-३-४०", "content_sanskrit": "अथ यौवनभारेण जृंभमाणेन नित्यशः ।\nबभूव हृदयं तस्याः कंदपर्परिकंपितम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004032040, "chapter_id": 24032, "verse_number": "३-३-३-४१", "content_sanskrit": "सा गुप्ता बन्धुवर्गेण शासितापि महोत्तमैः ।\nन शशाक मनो रोद्धं मदनाकृष्टमंगना॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004032041, "chapter_id": 24032, "verse_number": "३-३-३-४२", "content_sanskrit": "सा तीव्रमन्मथाविष्टा रूपयौवनशालिनी ।\nविधवापि विशेषेण जारमार्गरताभवत्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004032042, "chapter_id": 24032, "verse_number": "३-३-३-४३", "content_sanskrit": "न ज्ञाता केनचिदपि जारिणीति विचक्षणा ।\nजुगूहात्मदुराचारं कंचित्कालमसत्तमा॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004032043, "chapter_id": 24032, "verse_number": "३-३-३-४४", "content_sanskrit": "तां दोहदसमाक्रांतां घननीलमुखस्तनीम् ।\nकालेन बंधुवर्गोपि बुबोध विटदूषिताम्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004032044, "chapter_id": 24032, "verse_number": "३-३-३-४५", "content_sanskrit": "इति भीतो महाक्लेशाच्चिंता लेभे दुरत्ययाम् ।\nस्त्रियः कामेन नश्यंति ब्राह्मणा हीनसेवया॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004032045, "chapter_id": 24032, "verse_number": "३-३-३-४६", "content_sanskrit": "राजानो ब्रह्मदंडेन यतयो भोगसंग्रहात् ।\nलीढं शुना तथैवान्नं सुरया वार्पितं पयः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004032046, "chapter_id": 24032, "verse_number": "३-३-३-४७", "content_sanskrit": "रूपं कुष्ठरुजाविष्टं कुलं नश्यति कुस्त्रिया ।\nइति सर्वे समालोच्य समेताः पतिसोदराः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004032047, "chapter_id": 24032, "verse_number": "३-३-३-४८", "content_sanskrit": "तत्यजुर्गोत्रतो दूरं गृहीत्वा सकचग्रहम् ।\nसघटोत्सर्गमुत्सृष्टा सा नारी सर्वबन्धुभिः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004032048, "chapter_id": 24032, "verse_number": "३-३-३-४९", "content_sanskrit": "विचरंती च शूद्रेण रममाणा रतिप्रिया ।\nसा ययौ स्त्री बहिर्यामा दृष्टा शूद्रेण केनचित्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004032049, "chapter_id": 24032, "verse_number": "३-३-३-५०", "content_sanskrit": "स तां दृष्ट्वा वरारोहां पीनोन्नतपयोधराम् ।\nगृहं निनाय साम्ना च विधवां शूद्रनायकः ।\nसा नारी तस्य महिषी भूत्वा तेन दिवानिशम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004032050, "chapter_id": 24032, "verse_number": "३-३-३-५१", "content_sanskrit": "रममाणा क्वचिद्देशे न्यवसद्गृहवल्लभा ।\nतत्र सा पिशिताहारा नित्यमापीतवारुणी॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004032051, "chapter_id": 24032, "verse_number": "३-३-३-५२", "content_sanskrit": "लेभे सुतं च शूद्रेण रममाणा रतिप्रिया ।\nकदाचिद्भर्त्तरि क्वापि याते पीतसुरा तु सा॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004032052, "chapter_id": 24032, "verse_number": "३-३-३-५३", "content_sanskrit": "इयेष पिशिताहारं मदिरामदविह्वला ।\nअथ मेषेषु बद्धेषु गोभिः सह बहिर्व्रजे॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004032053, "chapter_id": 24032, "verse_number": "३-३-३-५४", "content_sanskrit": "ययौ कृपाणमादाय सा तमींधे निशामुखे ।\nअविमृश्य मदावेशान्मेषबुद्ध्यामिषप्रिया॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004032054, "chapter_id": 24032, "verse_number": "३-३-३-५५", "content_sanskrit": "एकं जघानं गोवत्सं क्रोशंतं निशि दुर्भगा ।\nनिहतं गृहमानीय ज्ञात्वा गोवत्समंगना॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004032055, "chapter_id": 24032, "verse_number": "३-३-३-५६", "content_sanskrit": "भीता शिवशिवेत्याह केनचित्पुण्यकर्मणा ।\nसा मुहूर्तमिति ध्यात्वा पिशितासवलालसा॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004032056, "chapter_id": 24032, "verse_number": "३-३-३-५७", "content_sanskrit": "छित्त्वा तमेव गोवत्सं चकाराहारमीप्सितम् ।\nगोवत्सार्धशरीरेण कृताहाराथ सा पुनः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004032057, "chapter_id": 24032, "verse_number": "३-३-३-५८", "content_sanskrit": "तदर्धदेहं निक्षिप्य बहिश्चुक्रोश कैतवात् ।\nअहो व्याघ्रेण भग्नोऽयं जग्धो गोवत्सको व्रजे॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004032058, "chapter_id": 24032, "verse_number": "३-३-३-५९", "content_sanskrit": "इति तस्याः समाक्रंदः सर्वगेहेषु शुश्रुवे ।\nअथ सर्वे शूद्रजनाः समागम्यांतिके स्थिताः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004032059, "chapter_id": 24032, "verse_number": "३-३-३-६०", "content_sanskrit": "हतं गोवत्समालोक्य व्याघ्रेणेति शुचं ययुः ।\nगतेषु तेषु सर्वेषु व्युष्टायां च ततो निशि॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004032060, "chapter_id": 24032, "verse_number": "३-३-३-६१", "content_sanskrit": "तद्भर्ता गृहमागत्य दृष्टवान्गृहविड्वरम् ।\nएवं बहुतिथे काले गते सा शूद्ववल्लभा॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004032061, "chapter_id": 24032, "verse_number": "३-३-३-६२", "content_sanskrit": "कालस्य वशमापन्ना जगाम यममंदिरम् ।\nयमोपि धर्ममालोक्य तस्याः कर्म च पौर्विकम्॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004032062, "chapter_id": 24032, "verse_number": "३-३-३-६३", "content_sanskrit": "निर्वत्र्य निरयावासाञ्चक्रे चंडालजातिकाम् ।\nसापि भ्रष्टा यमपुराच्चांडालीगर्भमाश्रिता॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004032063, "chapter_id": 24032, "verse_number": "३-३-३-६४", "content_sanskrit": "ततो बभूव जात्यंधा प्रशांतांगारमेचका ।\nतत्पिता कोपि चांडालो देशे कुत्रचिदास्थितः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004032064, "chapter_id": 24032, "verse_number": "३-३-३-६५", "content_sanskrit": "तां तादृशीमपि सुतां कृपया पर्यपोषयत् ।\nअभोज्येन कदन्नेन शुना लीढेन पूतिना॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004032065, "chapter_id": 24032, "verse_number": "३-३-३-६६", "content_sanskrit": "अपेयैश्च रसैर्मात्रा पोषिता सा दिनेदिने ।\nजात्यंधा सापि कालेन बाल्ये कुष्ठरुजार्दिता॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004032066, "chapter_id": 24032, "verse_number": "३-३-३-६७", "content_sanskrit": "ऊढा न केनचिद्वापि चांडालेनातिदुर्भगा ।\nअतीतबाल्ये सा काले विध्वस्तपितृमातृका॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004032067, "chapter_id": 24032, "verse_number": "३-३-३-६८", "content_sanskrit": "दुर्भगेति परित्यक्ता बंधुभिश्च सहोदरैः ।\nततः क्षुधार्दिता दीना शोचन्ती विगतेक्षणा॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004032068, "chapter_id": 24032, "verse_number": "३-३-३-६९", "content_sanskrit": "गृहीतयष्टिः कृच्छ्रेण संचचाल सलोष्टिका ।\nपत्तनेष्वपि सर्वेषु याचमाना दिनेदिने॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004032069, "chapter_id": 24032, "verse_number": "३-३-३-७०", "content_sanskrit": "चांडालोच्छिष्टपिंडेन जठराग्निमतर्पयत् ।\nएवं कृच्छ्रेण महता नीत्वा सुबहुलं वयः॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004032070, "chapter_id": 24032, "verse_number": "३-३-३-७१", "content_sanskrit": "जरया ग्रस्तसर्वांगी दुःखमाप दुरत्ययम् ।\nनिरन्नपानवसना सा कदाचिन्महाजनान्॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004032071, "chapter_id": 24032, "verse_number": "३-३-३-७२", "content_sanskrit": "आयास्यंत्यां शिवतिथौ गच्छतो बुबुधेऽध्वगान् ।\nतस्यां तु देवयात्रायां देशदेशांतयायिनाम्॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004032072, "chapter_id": 24032, "verse_number": "३-३-३-७३", "content_sanskrit": "विप्राणां साग्निहोत्राणां सस्त्रीकाणां महात्मनाम् ।\nराज्ञां च सावरोधानां सहस्तिरथवाजिनाम्॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004032073, "chapter_id": 24032, "verse_number": "३-३-३-७४", "content_sanskrit": "सपरीवारघोषाणां यानच्छत्रादिशोभिनाम् ।\nतथान्येषां च विट्शूद्रसंकीर्णानां सहस्रशः॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004032074, "chapter_id": 24032, "verse_number": "३-३-३-७५", "content_sanskrit": "हसतां गायतां क्वापि नृत्यतामथ धावताम् ।\nजिघ्रतां पिबतां कामाद्गच्छतां प्रतिगर्जताम्॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004032075, "chapter_id": 24032, "verse_number": "३-३-३-७६", "content_sanskrit": "संप्रयाणे मनुष्याणां संभ्रमः सुमहानभूत् ।\nइति सर्वेषु गच्छत्सु गोकर्णं शिवमंदिरम्॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004032076, "chapter_id": 24032, "verse_number": "३-३-३-७७", "content_sanskrit": "पश्यंति दिविजाः सर्वे विमानस्थाः सकौतुकाः ।\nअथेयमपि चांडाली वसनाशनतृष्णया॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004032077, "chapter_id": 24032, "verse_number": "३-३-३-७८", "content_sanskrit": "महाजनान्याचयितुं चचाल च शनैःशनैः ।\nकरावलंबेनान्यस्याः प्राग्जन्मार्जितकर्मणा ।\nदिनैः कतिपयैर्याती गोकर्णं क्षेत्रमाययौ॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004032078, "chapter_id": 24032, "verse_number": "३-३-३-७९", "content_sanskrit": "ततो विदूरे मार्गस्य निषण्णा विवृतांजलिः ।\nयाचमाना मुहुः पांथान्बभाषे कृपणं वचः॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004032079, "chapter_id": 24032, "verse_number": "३-३-३-८०", "content_sanskrit": "प्राग्जन्मार्जितपापौघैः पीडितायाश्चिरं मम ।\nआहारमात्रदानेन दयां कुरुत भो जनाः॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004032080, "chapter_id": 24032, "verse_number": "३-३-३-८१", "content_sanskrit": "त्रातारः परमार्तानां दातारः परमाशिषाम् ।\nकर्तारो बहुपुण्यानां दयां कुरुत भो जनाः॥ र ॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004032081, "chapter_id": 24032, "verse_number": "३-३-३-८२", "content_sanskrit": "वसनाशनहीनायां स्वपितायां महीतले ।\nमहापांसुनिमग्नायां दयां कुरुत भो जनाः॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004032082, "chapter_id": 24032, "verse_number": "३-३-३-८३", "content_sanskrit": "महाशीतातपार्त्तायां पीडितायां महारुजा ।\nअन्धायां मयि वृद्धायां दयां कुरुत भो जनाः॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004032083, "chapter_id": 24032, "verse_number": "३-३-३-८४", "content_sanskrit": "चिरोपवासदीप्तायां जठराग्निविवर्धनैः ।\nसंदह्यमानसर्वांग्यां दयां कुरुत भो जनाः॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004032084, "chapter_id": 24032, "verse_number": "३-३-३-८५", "content_sanskrit": "अनुपार्जितपुण्यायां जन्मांतरशतेष्वपि ।\nपापायां मंदभाग्यायां दयां कुरुत भो जनाः॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004032085, "chapter_id": 24032, "verse_number": "३-३-३-८६", "content_sanskrit": "एवमभ्यर्थयंत्यास्तु चांडाल्याः प्रसृतेंऽजलौ ।\nएकः पुण्यतमः पांथः प्राक्षिपद्बिल्वमंजरीम्॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004032086, "chapter_id": 24032, "verse_number": "३-३-३-८७", "content_sanskrit": "तामंचलौ निपतितां सा विमृश्य पुनः पुनः ।\nअभक्ष्येत्येव मत्वाथ दूरे प्राक्षिपदातुरा॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004032087, "chapter_id": 24032, "verse_number": "३-३-३-८८", "content_sanskrit": "तस्याः करेण निर्मुक्ता रात्रौ सा बिल्वमंजरी ।\nपपात कस्यचिद्दिष्ट्या शिवलिंगस्य मस्तके॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004032088, "chapter_id": 24032, "verse_number": "३-३-३-८९", "content_sanskrit": "सैवं शिवचतुर्दश्यां रात्रौ पांथजनान्मुहुः ।\nयाचमानापि यत्किंचिन्न लेभे दैवयोगतः॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004032089, "chapter_id": 24032, "verse_number": "३-३-३-९०", "content_sanskrit": "तत्रोषितानया रात्रिर्भद्रकाल्यास्तु पृष्ठतः ।\nकिंचिदुत्तरतः स्थानं तदर्धेनातिदूरतः॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004032090, "chapter_id": 24032, "verse_number": "३-३-३-९१", "content_sanskrit": "ततः प्रभाते भ्रष्टाशा शोकेन महताप्लुता ।\nशनैर्निववृते दीना स्वदेशायैव केवला॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004032091, "chapter_id": 24032, "verse_number": "३-३-३-९२", "content_sanskrit": "श्रांता चिरोपवासेन निपतन्ती पदेपदे ।\nक्रंदंती वहुरोगार्ता वेपमाना भृशातुरा॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004032092, "chapter_id": 24032, "verse_number": "३-३-३-९३", "content_sanskrit": "दह्यमानार्कतापेन नग्नदेहा सयष्टिका ।\nअतीत्यैतावतीं भूमिं निपपात विचेतना॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004032093, "chapter_id": 24032, "verse_number": "३-३-३-९४", "content_sanskrit": "अथ विश्वेश्वरः शंभुः करुणामृतवारिधिः ।\nएनामानयतेत्त्यस्मान्युयुजे सविमानकान्॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004032094, "chapter_id": 24032, "verse_number": "३-३-३-९५", "content_sanskrit": "एषा प्रवृत्तिश्चांडाल्यास्तवेह परिकीर्त्तिता ।\nतथा संदर्शिता शंभोः कृपणेषु कृपालुता ।\nकर्मणः परिपाकोत्थां गतिं पश्य महामते ।\nअधमापि परं स्थानमारोहति निरामयम्॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004032095, "chapter_id": 24032, "verse_number": "३-३-३-९६", "content_sanskrit": "यदेतया पूर्वभवे नान्नदानादिकं कृतम् ।\nक्षुत्पिपासादिभिः क्लेशैस्तस्मादिह निपीड्यते॥ ९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004032096, "chapter_id": 24032, "verse_number": "३-३-३-९७", "content_sanskrit": "यदेषा मदवेगांधा चक्रे पापं महोल्बणम् ।\nकर्मणा तेन जात्यंधा बभूवात्रैव जन्मनि॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004032097, "chapter_id": 24032, "verse_number": "३-३-३-९८", "content_sanskrit": "अपि विज्ञाय गोवत्सं यदेषाऽभक्षयत्पुरा ।\nकर्मणा तेन चांडाली बभूवेह विगर्हिता॥ ९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004032098, "chapter_id": 24032, "verse_number": "३-३-३-९९", "content_sanskrit": "यदेषार्यपथं हित्वा जारमार्गरता पुरा ।\nतेन पापेन केनापि दुर्वृत्ता दुर्भगापि वा॥ १०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004032099, "chapter_id": 24032, "verse_number": "३-३-३-१००", "content_sanskrit": "यदाश्लिष्य मदाविष्टा जारेण विधवा पुरा ।\nतेन पापेन महता बहुकुष्ठव्रणान्विता॥ १०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004032100, "chapter_id": 24032, "verse_number": "३-३-३-१०१", "content_sanskrit": "कामार्त्ता यदियं स्वैरं शूद्रेण रमिता पुरा ।\nमहासृक्पूयकृमिभिः पीड्यते तेन पाप्मना॥ १०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004032101, "chapter_id": 24032, "verse_number": "३-३-३-१०२", "content_sanskrit": "सुव्रतानि न चीर्णानि नेष्टापूतार्दिकं कृतम् ।\nसर्वभोगविहीनेयं दूयते तेन पाप्मना॥ १०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004032102, "chapter_id": 24032, "verse_number": "३-३-३-१०३", "content_sanskrit": "यदेतया पूर्वभवे सुरा पीता विमूढया ।\nमहायक्ष्मार्तिहृच्छूलैः पीड्यते तेन पाप्मना॥ १०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7004032103, "chapter_id": 24032, "verse_number": "३-३-३-१०४", "content_sanskrit": "अत्रैव सर्वमर्त्येषु पापचिह्नानि कृत्स्नशः ।\nलक्ष्यते मुनिशार्दूल सविवेकैर्महात्मभिः॥ १०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7004032104, "chapter_id": 24032, "verse_number": "३-३-३-१०५", "content_sanskrit": "अत्र ये बहुरोगार्त्ता ये पुत्रधनवर्जिताः॥ १०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7004032105, "chapter_id": 24032, "verse_number": "३-३-३-१०६", "content_sanskrit": "ये च दुर्लक्षणक्लिष्टा याचका विगतह्रियः ।\nवासोन्नपानशयनभूषणाभ्यंजनादिभिः॥ १०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7004032106, "chapter_id": 24032, "verse_number": "३-३-३-१०७", "content_sanskrit": "हीना विरूपा निर्विद्या विकलांगाः कुभोजनाः ।\nये दुर्भाग्या निंदिताश्च ये चान्ये परसेवकाः॥ १०८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7004032107, "chapter_id": 24032, "verse_number": "३-३-३-१०८", "content_sanskrit": "एते पूर्वभवे सर्वे सुमहत्पापकारिणः ।\nएवं विमृश्य यत्नेन दृष्ट्वा लोकजनस्थितिम्॥ १०९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7004032108, "chapter_id": 24032, "verse_number": "३-३-३-१०९", "content_sanskrit": "बुधो न कुरुते पापं यदि कुर्यात्स आत्महा ।\nदेहोऽयं मानुषो जंतोर्बहुकर्मैकभाजनम्॥ ११० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7004032109, "chapter_id": 24032, "verse_number": "३-३-३-११०", "content_sanskrit": "सदा सत्कर्म सेवेत दुष्कर्म सततं त्यजेत् ।\nपुण्यं सुखार्थी कुर्वीत दुःखार्थी पापमाचरेत्॥ १११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7004032110, "chapter_id": 24032, "verse_number": "३-३-३-१११", "content_sanskrit": "द्वयोरेकतरे लोके गृहीते कुशलो जनः ।\nइमं मानुषमाश्रित्य देहं परमदुर्लभम्॥ ११२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7004032111, "chapter_id": 24032, "verse_number": "३-३-३-११२", "content_sanskrit": "य आत्महितवान्कश्चिद्देवमेकं समाश्रयेत् ।\nअथ पापानि सर्वाणि कुर्वन्नपि सदा नरः॥ ११३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7004032112, "chapter_id": 24032, "verse_number": "३-३-३-११३", "content_sanskrit": "शिवमेकमतिर्ध्यायेत्स संतरति पातकम् ।\nमृता पूर्वभवे त्वेषा यदा प्राप्ता यमालये॥ ११४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7004032113, "chapter_id": 24032, "verse_number": "३-३-३-११४", "content_sanskrit": "तदा वितर्कः सुमहानासीद्यमसभासदाम् ।\nयद्यपि ब्राह्मणी त्वेषा सत्कुलाचारदूषिता॥ ११५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7004032114, "chapter_id": 24032, "verse_number": "३-३-३-११५", "content_sanskrit": "अतोऽस्माभिरिहानीता निरयं यातु वा न वा ।\nअनया साधितो बाल्ये पुण्यलेशोऽस्ति वा न वा॥ ११६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7004032115, "chapter_id": 24032, "verse_number": "३-३-३-११६", "content_sanskrit": "अथापि सुविमृश्यैवं धार्यो दंडोऽत्र नान्यथा ।\nबहुजन्मसहस्रेषु कृतपुण्यविपाकतः॥ ११७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7004032116, "chapter_id": 24032, "verse_number": "३-३-३-११७", "content_sanskrit": "नृणां ब्रह्मकुले जन्म लभ्यते हि कथंचन ।\nअतोस्याः पूर्वपूर्वेषु कृताघं नास्ति जन्मसु॥ ११८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7004032117, "chapter_id": 24032, "verse_number": "३-३-३-११८", "content_sanskrit": "अन्यथा सत्कुले जन्म कथमेषा प्रपद्यते ।\nअत्रैव जन्मन्यनया कृतमंहो दुरत्ययम्॥ ११९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7004032118, "chapter_id": 24032, "verse_number": "३-३-३-११९", "content_sanskrit": "अथापि नरकावासं प्रायशो नेयमर्हति ।\nकिंतु गोवत्सकं हत्वा विमृश्यागतसाध्वसा॥ १२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7004032119, "chapter_id": 24032, "verse_number": "३-३-३-१२०", "content_sanskrit": "एषा शिवशिवेत्याह प्राग्जन्मार्जितकर्मणा ।\nयदेषा पापविच्छित्त्यै सकृदप्युरुमंगलम्॥ १२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7004032120, "chapter_id": 24032, "verse_number": "३-३-३-१२१", "content_sanskrit": "शिवनाम वदेद्भक्त्या तर्हि गच्छेत्परं पदम् ।\nएकजन्मकृतस्यास्य दारुणस्यापि यत्फलम्॥ १२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7004032121, "chapter_id": 24032, "verse_number": "३-३-३-१२२", "content_sanskrit": "क्रमेणानुभवत्वेषा भूत्वा चांडालजातिका ।\nअस्मादन्यतमः को वा नरकोऽस्ति नृणा मिह॥ १२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7004032122, "chapter_id": 24032, "verse_number": "३-३-३-१२३", "content_sanskrit": "अनेकक्लेशसंघातैर्यन्मुहुः परिपीडनम् ।\nदुष्कुले जन्म दारिद्र्यं महाव्याधिर्विमूढता॥ १२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7004032123, "chapter_id": 24032, "verse_number": "३-३-३-१२४", "content_sanskrit": "एकैक एव नरकः सर्वे वा चाथ किं पुनः ।\nप्राग्जन्मपुण्यभारेण यन्नाम विवशाऽब्रवीत्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7004032124, "chapter_id": 24032, "verse_number": "३-३-३-१२५", "content_sanskrit": "तेनैषान्यभवे भूरि पुण्यमंते करिष्यति ।\nतेन पुण्येन महता निस्तीर्याघौघया तनाः॥ १२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7004032125, "chapter_id": 24032, "verse_number": "३-३-३-१२६", "content_sanskrit": "नीता तत्पुरुषैरंते प्रयास्यति परं पदम् ।\nएतादृशानां मर्त्यानां शास्तारो न वयं क्वचित् ।\nविचार्य स्वयमेवेशो यद्युक्तं तत्करोतु सः॥ १२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7004032126, "chapter_id": 24032, "verse_number": "३-३-३-१२७", "content_sanskrit": "एवं वैवस्वतपुरे सर्वैर्यमपुरोगमैः ।\nविमृश्य चित्रगुप्ताद्यैरियं मुक्ताऽपतद्भुवि॥ १२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7004032127, "chapter_id": 24032, "verse_number": "३-३-३-१२८", "content_sanskrit": "आदौ यदेषा शिवनाम नारी प्रमादतो वाप्य सती जगाद ।\nतेनेह भूयः सुकृतेन शंभोर्बिल्वांकुराराधनपुण्यमाप॥ १२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7004032128, "chapter_id": 24032, "verse_number": "३-३-३-१२९", "content_sanskrit": "श्रीगोकर्णे शिवतिथावुपोष्य शिवमस्तके ।\nकृत्वा जागरणं ह्येषा चक्रे बिल्वार्पणं निशि॥ १३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7004032129, "chapter_id": 24032, "verse_number": "३-३-३-१३०", "content_sanskrit": "अकामतः कृतस्यास्य पुण्यस्यैव च यत्फलम् ।\nअद्यैव भोक्ष्यते सेयं पश्यतस्तव नो मृषा॥ १३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7004032130, "chapter_id": 24032, "verse_number": "३-३-३-१३१", "content_sanskrit": "गौतम उवाच ।\nइत्युक्त्वा शिवदूतास्ते तस्याश्चांडालयोनितः ।\nजीवलेशं समाकृष्य युयुजुर्दिव्यतेजसा॥ १३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7004032131, "chapter_id": 24032, "verse_number": "३-३-३-१३२", "content_sanskrit": "तां दिव्यदेहसंक्रांतां तेजोराशिसमुज्ज्वलाम् ।\nविमाने स्थापयामासुः प्रीतास्ते शिवकिंकराः॥ १३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7004032132, "chapter_id": 24032, "verse_number": "३-३-३-१३३", "content_sanskrit": "अथ सा परमोदाररूपलावण्यशालिनी ।\nदिव्यभूषणदीप्तांगी दिव्यांबरविधारिणी॥ १३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7004032133, "chapter_id": 24032, "verse_number": "३-३-३-१३४", "content_sanskrit": "देहेन दिव्यगंधेन दिव्यतेजोविकाशिना ।\nदिव्यमाल्यावतंसेन विरराज विमानगा॥ १३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7004032134, "chapter_id": 24032, "verse_number": "३-३-३-१३५", "content_sanskrit": "रत्नच्छत्रपताकाद्यैर्गीतवादित्रनिस्वनैः ।\nमध्ये सा शिवदूतानां मोदमाना वरानना॥ १३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7004032135, "chapter_id": 24032, "verse_number": "३-३-३-१३६", "content_sanskrit": "अनुभूतानि जन्मानि स्मृत्वास्मृत्वा पुनःपुनः ।\nभीता त्रस्ता दृढा श्चर्यं दृष्ट्वा स्वप्नमिवोत्थिता॥ १३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7004032136, "chapter_id": 24032, "verse_number": "३-३-३-१३७", "content_sanskrit": "काहं केऽमी महासिद्धाः कोयं लोको मनोरमः ।\nक्व गतं मे वपुः कष्टं चंडचांडालगोत्रजम्॥ १३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7004032137, "chapter_id": 24032, "verse_number": "३-३-३-१३८", "content_sanskrit": "अहो सुमहदाश्चर्यं दृष्टं मायाविलासजम् ।\nयन्मे भवसहस्रेषु भ्रातंभ्रांतं पुनःपुनः॥ १३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7004032138, "chapter_id": 24032, "verse_number": "३-३-३-१३९", "content_sanskrit": "अहो ईश्वरपूजाया माहात्म्यं विस्मयावहम् ।\nपत्रमात्रेण संतुष्टो यो ददाति निजं पदम्॥ १४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7004032139, "chapter_id": 24032, "verse_number": "३-३-३-१४०", "content_sanskrit": "इति तां जातनिर्वेदां स्मरन्तीं भगवत्पदम् ।\nदिव्यं विमानमारोप्य ते महेश्वरकिंकराः॥ १४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7004032140, "chapter_id": 24032, "verse_number": "३-३-३-१४१", "content_sanskrit": "आलोकयत्सु सर्वेषु लोकेशेषु सविस्मयम् ।\nआमंत्र्य तामथानिन्युः परमेश्वरसन्निधिम्॥ १४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7004032141, "chapter_id": 24032, "verse_number": "३-३-३-१४२", "content_sanskrit": "राजन्सुमहदाश्चर्यमाख्यातं गिरिजा पतेः ।\nमाहात्म्यं भक्तिलेशस्य सर्वाघौघविनाशनम्॥ १४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 7004032142, "chapter_id": 24032, "verse_number": "३-३-३-१४३", "content_sanskrit": "राजोवाच ।\nभगवन्परमेशस्य कीदृशो लोक उत्तमः ।\nतस्य मे लक्षणं ब्रूहि यद्यस्ति मयि ते दया॥ १४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 7004032143, "chapter_id": 24032, "verse_number": "३-३-३-१४४", "content_sanskrit": "गौतम उवाच ।\nब्रह्मादिसुरनाथानां लोकेष्वपि सुदुर्लभः ।\nय आनंदः सदा यत्र स लोकः पारमेश्वरः॥ १४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 7004032144, "chapter_id": 24032, "verse_number": "३-३-३-१४५", "content_sanskrit": "सर्वातिगमनं यत्र ज्योतिर्यत्र प्रतिष्ठितम् ।\nक्वापि नास्ति तमोयोगः स लोकः पारमेश्वरः॥ १४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 7004032145, "chapter_id": 24032, "verse_number": "३-३-३-१४६", "content_sanskrit": "गुणवृत्ति विनिस्तीर्य संप्राप्ता यत्र योगिनः ।\nन पतेयुः पुनः सर्वे स लोकः पारमेश्वरः॥ १४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 7004032146, "chapter_id": 24032, "verse_number": "३-३-३-१४७", "content_sanskrit": "यत्र वासं न कुर्वंति क्रोधलोभमदादयः ।\nयत्रावस्था न जन्माद्याः स लोकः पारमेश्वरः॥ १४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 7004032147, "chapter_id": 24032, "verse_number": "३-३-३-१४८", "content_sanskrit": "सर्वेषां निगमानां च यदेकं क्षेत्रमुच्यते ।\nयस्मान्नास्ति परं वित्तं तत्पदं पारमेश्वरम्॥ १४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 7004032148, "chapter_id": 24032, "verse_number": "३-३-३-१४९", "content_sanskrit": "प्रत्याहारासन ध्यानप्राणसंयमनादिभिः ।\nयत्र योगपथैः प्राप्तुं यतते योगिनः सदा॥ १५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 7004032149, "chapter_id": 24032, "verse_number": "३-३-३-१५०", "content_sanskrit": "यत्र देवः सदानंदनिर्मलज्ञानरूपया ।\nअस्ति देव्या सह क्रीडञ्स लोकः पारमेश्वरः॥ १५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 7004032150, "chapter_id": 24032, "verse_number": "३-३-३-१५१", "content_sanskrit": "जन्मानेकसहस्रेषु संभृतैः पुण्यराशिभिः ।\nआरूढाः पुरुषा नार्यः क्रीडन्ते यत्र संगताः॥ १५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}, {"id": 7004032151, "chapter_id": 24032, "verse_number": "३-३-३-१५२", "content_sanskrit": "तेजो राशौ समालीना दुर्विभाव्ये मनोरमे ।\nअहोरात्रादिसंस्थानं न विंदंति कदाचन॥ १५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 152}, {"id": 7004032152, "chapter_id": 24032, "verse_number": "३-३-३-१५३", "content_sanskrit": "स लोकः परमेशस्य दुर्लभो हि कुयोगिनः ।\nएतद्भक्ति सुपूर्णा ये तैरेव प्रतिपद्यते॥ १५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 153}, {"id": 7004032153, "chapter_id": 24032, "verse_number": "३-३-३-१५४", "content_sanskrit": "ये तत्कथाश्रवणकीर्तनजातहर्षा ये सर्वभूतसुहृदः प्रशमैकनिष्ठाः ।\nसंसारचक्रमतिवाह्य निरस्तमोहास्ते शांकरं पदमवाप्य सुखं रमन्ते॥ १५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 154}, {"id": 7004032154, "chapter_id": 24032, "verse_number": "३-३-३-१५५", "content_sanskrit": "तथा त्वमपि राजेंद्र गोकर्णं गिरिशालयम् ।\nगत्वा प्रशमिताघौघः कृतकृत्यत्वमाप्नुहि॥ १५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 155}, {"id": 7004032155, "chapter_id": 24032, "verse_number": "३-३-३-१५६", "content_sanskrit": "तत्र सर्वेषु कालेषु स्नात्वाभ्यर्च्य महाबलम् ।\nकृत्वा शिवचतुर्दश्यामुपवासं समाहितः॥ १५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 156}, {"id": 7004032156, "chapter_id": 24032, "verse_number": "३-३-३-१५७", "content_sanskrit": "कृत्वा जागरणं रात्रौ बिल्वैरभ्यर्च्य शंकरम् ।\nसर्वपापविनिर्मुक्तः शिवलोकमवाप्स्यसि॥ १५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 157}, {"id": 7004032157, "chapter_id": 24032, "verse_number": "३-३-३-१५८", "content_sanskrit": "एष ते विमलो राजन्नुपदेशो मया कृतः ।\nस्वस्ति तेऽस्तु गमिष्यामि मिथिलाधिपतेः पुरीम्॥ १५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 158}, {"id": 7004032158, "chapter_id": 24032, "verse_number": "३-३-३-१५९", "content_sanskrit": "इत्यामन्त्र्य मुनिः प्रीत्या गौतमो मिथिलां ययौ ।\nसोऽपि हृष्टमना राजा गोकर्णं प्रत्यपद्यत॥ १६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 159}, {"id": 7004032159, "chapter_id": 24032, "verse_number": "३-३-३-१६०", "content_sanskrit": "तत्र दृष्ट्वा महादेवं स्नात्वाभ्यर्च्य महाबलम् ।\nनिर्धूताशेषपापौघो लेभे शम्भोः परं पदम्॥ १६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 160}, {"id": 7004032160, "chapter_id": 24032, "verse_number": "३-३-३-१६१", "content_sanskrit": "य इमां शृणुयान्नित्यं कथां शैवीं मनोहराम् ।\nश्रावयेद्वा जनो भक्त्या स याति परमां गतिम्॥ १६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 161}, {"id": 7004032161, "chapter_id": 24032, "verse_number": "३-३-३-१६२", "content_sanskrit": "श्रद्दधानः सकृद्वापि य इमां शृणुयात्कथाम् ।\nत्रिःसप्तकुलजैः सार्धं शिवलोकमवाप्नुयात्॥ १६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 162}, {"id": 7004032162, "chapter_id": 24032, "verse_number": "३-३-३-१६३", "content_sanskrit": "इति कथितमशेषं श्रेयसामादिबीजं भवशतदुरितघ्नं ध्वस्तमोहांधकारम् ।\nचरितममरगेयं मन्मथारेरुदारं सततमपि निषेव्यं स्वस्तिमद्भिश्च लोकैः॥ १६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 163}]