[{"id": 2071213, "chapter_id": 2502, "verse_number": "१२-७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2071214, "chapter_id": 2502, "verse_number": "१२-७-१", "content_sanskrit": "युधिष्ठिरस्तु धर्मात्मा शोकव्याकुलचेतनः।\nशुशोच दुःखसंतप्तः स्मृत्वा कर्णं महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2071215, "chapter_id": 2502, "verse_number": "१२-७-२", "content_sanskrit": "आविष्टो दुःखशोकाभ्यां निःश्वसंश्च पुनः पुनः।\nदृष्ट्वार्जुनमुवाचेदं वचनं शोककर्शितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2071216, "chapter_id": 2502, "verse_number": "१२-७-३x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2071217, "chapter_id": 2502, "verse_number": "१२-७-३", "content_sanskrit": "यद्भैक्ष्यमाचरिष्याम वृष्ण्यन्धकपुरे वयम्।\nज्ञातीन्निष्पुरुषान्कृत्वा नेमां प्राप्स्याम दुर्गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2071218, "chapter_id": 2502, "verse_number": "१२-७-४", "content_sanskrit": "अमित्रा नः समृद्धार्था वृत्तार्थाः कुरवः किल।\nआत्मानमात्मना हत्वा किं धर्मफलमाप्नुमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2071219, "chapter_id": 2502, "verse_number": "१२-७-५", "content_sanskrit": "धिगस्तु क्षात्रमाचारं धिगस्तु बलमौरसम्।\nधिगस्तु चार्थं येनेमामापदं गमिता वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2071220, "chapter_id": 2502, "verse_number": "१२-७-६", "content_sanskrit": "साधु क्षमा दमः शौचमविरोधो विमत्सरः।\nअहिंसा सत्यवचनं नित्यानि वनचारिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2071221, "chapter_id": 2502, "verse_number": "१२-७-७", "content_sanskrit": "वयं तु लोभान्मोहाच्च दम्भं मानं च संश्रिताः।\nइमामवस्थां संप्राप्ता राज्यक्लेशबुभुक्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2071222, "chapter_id": 2502, "verse_number": "१२-७-८", "content_sanskrit": "त्रैलोक्यस्यापि राज्येन नास्मान्कश्चित्प्रहर्षयेत्।\nबान्धवान्निहतान्दृष्ट्वा पृथिव्यामामिषैषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2071223, "chapter_id": 2502, "verse_number": "१२-७-९", "content_sanskrit": "ते वयं पृथिवीहेतोरवध्यान्पृथिवीतले।\nसंपरित्यज्य जीवामो हीनार्था हतबान्धवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2071224, "chapter_id": 2502, "verse_number": "१२-७-१०", "content_sanskrit": "आमिषे गृध्यमानानामशुभं वै शुनामिव।\nआमिषं चैव नो नष्टमामिषस्य च भोजिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2071225, "chapter_id": 2502, "verse_number": "१२-७-११", "content_sanskrit": "न पृथिव्या सकलया न सुवर्णस्य राशिभिः।\nन गजाश्वेन सर्वेण ते त्याज्या य इमे हताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2071226, "chapter_id": 2502, "verse_number": "१२-७-१२", "content_sanskrit": "काममन्युपरीतास्ते क्रोधामर्षसमन्विताः।\nमृत्युयानं समारुह्य गता वैवस्वतक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2071227, "chapter_id": 2502, "verse_number": "१२-७-१३", "content_sanskrit": "बहुकल्याणमिच्छन्त ईहन्ते पितरः सुतान्।\nतपसा ब्रह्मचर्येण वन्दनेन तितिक्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2071228, "chapter_id": 2502, "verse_number": "१२-७-१४", "content_sanskrit": "उपवासैस्तथेज्याभिर्व्रतकौतुकमङ्गलैः।\nलभन्ते मातरो गर्भांस्तान्मासान्दश बिभ्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2071229, "chapter_id": 2502, "verse_number": "१२-७-१५", "content_sanskrit": "यदि स्वस्ति प्रजायन्ते जाता जीवन्ति वा यदि।\nसंभाघिता जातबला विदध्युर्यदि नः सुखम्।\nइह चामुत्र चैवेति कृपणाः फलहेतवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2071230, "chapter_id": 2502, "verse_number": "१२-७-१६", "content_sanskrit": "तासामयं समुद्योगो निर्वृत्तः केवलोऽफलः।\nयदासां निहताः पुत्रा युवानो मृष्टकुण्डलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2071231, "chapter_id": 2502, "verse_number": "१२-७-१७", "content_sanskrit": "अभुक्त्वा पार्थिवान्भोगानृणान्यनपहाय च।\nपितृभ्यो देवताभ्यश्च गता वैयस्वतक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2071232, "chapter_id": 2502, "verse_number": "१२-७-१८", "content_sanskrit": "यदैषामम्ब पितरौ जातकर्मकराविह।\nसंजातबालरूपेषु तदैव निहता नृषाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2071233, "chapter_id": 2502, "verse_number": "१२-७-१९", "content_sanskrit": "संयुक्ताः काममन्युभ्यां क्रोधामर्षसमन्विताः।\nन ते जयफलं किंचिद्भोक्तारो जातु कर्हिचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2071234, "chapter_id": 2502, "verse_number": "१२-७-२०", "content_sanskrit": "पाञ्चालानां कुरूणां च हता एव हि ये हताः।\nन सकामा वयं ते च न चास्माभिर्न तैर्जितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2071235, "chapter_id": 2502, "verse_number": "१२-७-२१", "content_sanskrit": "न तैर्भुक्तेयमवनिर्न नार्यो गीतवादितम्।\nनामात्यसुहृदां वाक्यं न च श्रुतवतां श्रुतम्।\nन रत्नानि परार्ध्यानि न भूर्न द्रविणागमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2071236, "chapter_id": 2502, "verse_number": "१२-७-२२", "content_sanskrit": "न च धर्म्यानिमाँल्लोकान्प्रपद्याम स्वकर्मभिः।\nवयमेवास्य लोकस्य विनाशे कारणं स्मृताः।\nधृतराष्ट्रस्य पुत्रेण निकृतिप्रीतिसंयुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2071237, "chapter_id": 2502, "verse_number": "१२-७-२३", "content_sanskrit": "सदैव निकृतिप्रज्ञो द्वेष्टा विद्वेषजीवनः।\nमिथ्यावृत्तश्च सततमस्मास्वनपराधिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2071238, "chapter_id": 2502, "verse_number": "१२-७-२४", "content_sanskrit": "ऋद्धिमस्मासु तां दृष्ट्वा विवर्णो हरिणः कृशः।\nधृतराष्ट्रश्च नृपतिः सौबलेन निवेदितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2071239, "chapter_id": 2502, "verse_number": "१२-७-२५", "content_sanskrit": "तं पिता पुत्रगृध्नुत्वादनुमेनेऽनये स्थितम्।\nअनपेक्ष्यैव पितरं गाङ्गेयं विदुरं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2071240, "chapter_id": 2502, "verse_number": "१२-७-२६", "content_sanskrit": "असंशयं त्वयं राजा यथैवाहं तथा गतः।\nअनियम्याशुचिं लुब्धं पुत्रं कामवशानुगम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2071241, "chapter_id": 2502, "verse_number": "१२-७-२७", "content_sanskrit": "यशसः पतितो दीप्ताद्धातयित्वा सहोदरान्।\nइमौ हि वृद्धौ शोकाग्नौ प्रक्षिप्य स सुयोधनः।\nअस्मत्प्रद्वेषसंतप्तः पापबुद्धिः सदैव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2071242, "chapter_id": 2502, "verse_number": "१२-७-२८", "content_sanskrit": "को हि बन्धुः कुलीनः संस्तथा ब्रूयात्सुहृज्जने।\nयथाऽसाववदद्वाक्यं युयुत्सुः कृष्णसन्निधौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2071243, "chapter_id": 2502, "verse_number": "१२-७-२९", "content_sanskrit": "आत्मनो हि वयं दोषाद्विनष्टाः शाश्वतीः समाः।\nप्रदहन्तो दिशः सर्वा भास्वरा इव तेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2071244, "chapter_id": 2502, "verse_number": "१२-७-३०", "content_sanskrit": "सोऽस्माकं वैरपुरुषो दुर्मतिः प्रग्रहं गतः।\nदुर्योधनकृते ह्येतत्कुलं नो विनिपातितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2071245, "chapter_id": 2502, "verse_number": "१२-७-३१", "content_sanskrit": "अवध्यानां वधं कृत्वा लोके प्राप्ताः स्म वाच्यतां ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2071246, "chapter_id": 2502, "verse_number": "१२-७-३२", "content_sanskrit": "कुलस्यास्यान्तकरणं दुर्मतिं पापपूरुषम्।\nराजा राष्ट्रेश्वरं कृत्वा धृतराष्ट्रोऽद्य शोचति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2071247, "chapter_id": 2502, "verse_number": "१२-७-३३", "content_sanskrit": "हताः शूराः कृतं पापं विषयोऽसौ विनाशितः।\nहत्वा नो विगतो मन्युः शोको मां दारयत्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2071248, "chapter_id": 2502, "verse_number": "१२-७-३४", "content_sanskrit": "धनञ्जय कृतं पापं कल्याणेनोपहन्यते।\n[ख्यापनेनानुतापेन दानेन तपसाऽपि वा।\nनिवृत्त्या तीर्थगमनाच्छुतिस्मृतिजपेन वा॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2071249, "chapter_id": 2502, "verse_number": "१२-७-३५", "content_sanskrit": "त्यागवांश्च पुनः पापं नालं कर्तुमिति श्रुतिः।\nत्यागवाञ्जन्ममरणे नाप्नोतीति श्रुतिर्यतः।\nप्राप्तवर्त्मा कृतमतिर्ब्रह्म संपद्यते तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2071250, "chapter_id": 2502, "verse_number": "१२-७-३६", "content_sanskrit": "स धनञ्जय निर्द्वन्द्वो मुनिर्ज्ञानसमन्वितः।\nवनमामन्त्र्य वः सर्वान्गमिष्यामि परंतप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2071251, "chapter_id": 2502, "verse_number": "१२-७-३७", "content_sanskrit": "न हि कृत्स्नतमो धर्मः शक्यः प्राप्तुमिति श्रुतिः।\nपरिग्रहवता तन्मे प्रत्यक्षमरिसूदन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2071252, "chapter_id": 2502, "verse_number": "१२-७-३८", "content_sanskrit": "मया निसृष्टं पापं हि परिग्रहमभीप्सता।\nजन्मक्षयनिमित्तं च प्राप्तुं शक्यमिति श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2071253, "chapter_id": 2502, "verse_number": "१२-७-३९", "content_sanskrit": "स परिग्रहमुत्सृज्य कृत्स्नं राज्यं सुखानि च।\nगमिष्यामि विनिर्मुक्तो विशोको निर्ममः क्वचित्।\nप्रशासध्वमिमामुर्वी क्षेमां निहतकण्टकाम्।\nन ममार्थोऽस्ति राज्येन भोगैर्वा कुरुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2071254, "chapter_id": 2502, "verse_number": "१२-७-४०", "content_sanskrit": "एतावदुक्त्वा वचनं कुरुराजो युधिष्ठिरः।\nउपारमत्ततः पार्थः कनीयान्प्रत्यभाषत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2071255, "chapter_id": 2502, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि सप्तमोऽध्यायः॥ ७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]