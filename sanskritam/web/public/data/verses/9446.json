[{"id": 5000446000, "chapter_id": 9446, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे एकोनचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000446001, "chapter_id": 9446, "verse_number": "६-३९-१", "content_sanskrit": "तां रात्रिमुषितास्तत्र सुवेले हरियूथपाः।\nलङ्कायां ददृशुर्वीरा वनान्युपवनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000446002, "chapter_id": 9446, "verse_number": "६-३९-२", "content_sanskrit": "समसौम्यानि रम्याणि विशालान्यायतानि च।\nदृष्टिरम्याणि ते दृष्ट्वा बभूवुर्जातविस्मयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000446003, "chapter_id": 9446, "verse_number": "६-३९-३", "content_sanskrit": "चम्पकाशोकबकुलशालतालसमाकुला।\nतमालवनसंछन्ना नागमालासमावृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000446004, "chapter_id": 9446, "verse_number": "६-३९-४", "content_sanskrit": "हिन्तालैरर्जुनैर्नीपैः सप्तपर्णैः सुपुष्पितैः।\nतिलकैः कर्णिकारैश्च पाटलैश्च समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000446005, "chapter_id": 9446, "verse_number": "६-३९-५", "content_sanskrit": "शुशुभे पुष्पिताग्रैश्च लतापरिगतैर्द्रुमैः।\nलङ्का बहुविधैर्दिव्यैर्यथेन्द्रस्यामरावती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000446006, "chapter_id": 9446, "verse_number": "६-३९-६", "content_sanskrit": "विचित्रकुसुमोपेतै रक्तकोमलपल्लवैः।\nशाद्वलैश्च तथा नीलैश्चित्राभिर्वनराजिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000446007, "chapter_id": 9446, "verse_number": "६-३९-७", "content_sanskrit": "गन्धाढ्यान्यतिरम्याणि पुष्पाणि च फलानि च।\nधारयन्त्यगमास्तत्र भूषणानीव मानवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000446008, "chapter_id": 9446, "verse_number": "६-३९-८", "content_sanskrit": "तच्चैत्ररथसंकाशं मनोज्ञं नन्दनोपमम्।\nवनं सर्वर्तुकं रम्यं शुशुभे षट्पदायुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000446009, "chapter_id": 9446, "verse_number": "६-३९-९", "content_sanskrit": "दात्यूहकोयष्टिबकैर्नृत्यमानैश्च बर्हिणैः।\nरुतं परभृतानां च शुश्रुवे वननिर्झरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000446010, "chapter_id": 9446, "verse_number": "६-३९-१०", "content_sanskrit": "नित्यमत्तविहंगानि भ्रमराचरितानि च।\nकोकिलाकुलखण्डानि विहंगाभिरुतानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000446011, "chapter_id": 9446, "verse_number": "६-३९-११", "content_sanskrit": "भृङ्गराजाधिगीतानि कुररस्वनितानि च।\nकोणालकविघुष्टानि सारसाभिरुतानि च।\nविविशुस्ते ततस्तानि वनान्युपवनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000446012, "chapter_id": 9446, "verse_number": "६-३९-१२", "content_sanskrit": "हृष्टाः प्रमुदिता वीरा हरयः कामरूपिणः।\nतेषां प्रविशतां तत्र वानराणां महौजसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000446013, "chapter_id": 9446, "verse_number": "६-३९-१३", "content_sanskrit": "पुष्पसंसर्गसुरभिर्ववौ घ्राणसुखोऽनिलः।\nअन्ये तु हरिवीराणां यूथान्निष्क्रम्य यूथपाः।\nसुग्रीवेणाभ्यनुज्ञाता लङ्कां जग्मुः पताकिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000446014, "chapter_id": 9446, "verse_number": "६-३९-१४", "content_sanskrit": "वित्रासयन्तो विहगान् ग्लापयन्तो मृगद्विपान्।\nकम्पयन्तश्च तां लङ्कां नादैः स्वैर्नदतां वराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000446015, "chapter_id": 9446, "verse_number": "६-३९-१५", "content_sanskrit": "कुर्वन्तस्ते महावेगा महीं चरणपीडिताम्।\nरजश्च सहसैवोर्ध्वं जगाम चरणोत्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000446016, "chapter_id": 9446, "verse_number": "६-३९-१६", "content_sanskrit": "ऋक्षाः सिंहाश्च महिषा वारणाश्च मृगाः खगाः।\nतेन शब्देन वित्रस्ता जग्मुर्भीता दिशो दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000446017, "chapter_id": 9446, "verse_number": "६-३९-१७", "content_sanskrit": "शिखरं तु त्रिकूटस्य प्रांशु चैकं दिविस्पृशम्।\nसमन्तात् पुष्पसंछन्नं महारजतसंनिभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000446018, "chapter_id": 9446, "verse_number": "६-३९-१८", "content_sanskrit": "शतयोजनविस्तीर्णं विमलं चारुदर्शनम्।\nश्लक्ष्णं श्रीमन्महच्चैव दुष्प्रापं शकुनैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000446019, "chapter_id": 9446, "verse_number": "६-३९-१९", "content_sanskrit": "मनसापि दुरारोहं किं पुनः कर्मणा जनैः।\nनिविष्टा तस्य शिखरे लङ्का रावणपालिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000446020, "chapter_id": 9446, "verse_number": "६-३९-२०", "content_sanskrit": "दशयोजनविस्तीर्णा विंशद्योजनमायता।\nसा पुरी गोपुरैरुच्चैः पाण्डुराम्बुदसंनिभैः।\nकाञ्चनेन च शालेन राजतेन च शोभते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000446021, "chapter_id": 9446, "verse_number": "६-३९-२१", "content_sanskrit": "प्रासादैश्च विमानैश्च लङ्का परमभूषिता।\nघनैरिवातपापाये मध्यमं वैष्णवं पदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000446022, "chapter_id": 9446, "verse_number": "६-३९-२२", "content_sanskrit": "यस्यां स्तम्भसहस्रेण प्रासादः समलंकृतः।\nकैलासशिखराकारो दृश्यते खमिवोल्लिखन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000446023, "chapter_id": 9446, "verse_number": "६-३९-२३", "content_sanskrit": "चैत्यः स राक्षसेन्द्रस्य बभूव पुरभूषणम्।\nशतेन रक्षसां नित्यं यः समग्रेण रक्ष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000446024, "chapter_id": 9446, "verse_number": "६-३९-२४", "content_sanskrit": "मनोज्ञां काञ्चनवतीं पर्वतैरुपशोभिताम्।\nनानाधातुविचित्रैश्च उद्यानैरुपशोभिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000446025, "chapter_id": 9446, "verse_number": "६-३९-२५", "content_sanskrit": "नानाविहगसंघुष्टां नानामृगनिषेविताम्।\nनानाकुसुमसम्पन्नां नानाराक्षससेविताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000446026, "chapter_id": 9446, "verse_number": "६-३९-२६", "content_sanskrit": "तां समृद्धां समृद्धार्थां लक्ष्मीवाँल्लक्ष्मणाग्रजः।\nरावणस्य पुरीं रामो ददर्श सह वानरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000446027, "chapter_id": 9446, "verse_number": "६-३९-२७", "content_sanskrit": "तां महागृहसम्बाधां दृष्ट्वा लक्ष्मणपूर्वजः।\nनगरीं त्रिदिवप्रख्यां विस्मयं प्राप वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000446028, "chapter_id": 9446, "verse_number": "६-३९-२८", "content_sanskrit": "तां रत्नपूर्णां बहुसंविधानां\nप्रासादमालाभिरलंकृतां च।\nपुरीं महायन्त्रकवाटमुख्यां\nददर्श रामो महता बलेन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000446029, "chapter_id": 9446, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे एकोनचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]