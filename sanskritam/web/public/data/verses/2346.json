[{"id": 2063221, "chapter_id": 2346, "verse_number": "८-६७-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2063222, "chapter_id": 2346, "verse_number": "८-६७-१", "content_sanskrit": "द्रौणिस्तु रथवंशेन महता परिवारितः।\nअपतत्सहसा राजन्यत्र पार्थो व्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2063223, "chapter_id": 2346, "verse_number": "८-६७-२", "content_sanskrit": "तमापतन्तं सहसा शूरः शौरिसहायवान्।\nदधार समरे पार्थो वेलेव मकरालयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2063224, "chapter_id": 2346, "verse_number": "८-६७-३", "content_sanskrit": "ततः क्रुद्धो महाराज द्रोणपुत्रः प्रतापवान्।\nअर्जुनं वासुदेवं च च्छादयामास सायकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2063225, "chapter_id": 2346, "verse_number": "८-६७-४", "content_sanskrit": "अवच्छन्नौ ततः कृष्णौ दृष्ट्वा तत्र महारथाः।\nविस्मयं परमं गत्वा प्रैक्षन्त कुरवस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2063226, "chapter_id": 2346, "verse_number": "८-६७-५", "content_sanskrit": "अर्जुनस्तु ततो दिव्यमस्त्रं चक्रे हसन्निव।\nतदस्त्रं वारयामास ब्राह्मणो युधि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2063227, "chapter_id": 2346, "verse_number": "८-६७-६", "content_sanskrit": "यद्यद्धि व्याक्षिपद्युद्धे फल्गुनोऽस्त्रं जिघांसया।\nतत्तदस्त्रैर्महेष्वासो द्रोणपुत्रो जघान ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2063228, "chapter_id": 2346, "verse_number": "८-६७-७", "content_sanskrit": "अस्त्रयुद्धे महाराज वर्तमाने महाभये।\nअपश्याम रणे द्रौणिं व्यात्ताननमिवान्तकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2063229, "chapter_id": 2346, "verse_number": "८-६७-८", "content_sanskrit": "स दिशः प्रदिशश्चैव च्छादयित्वा ह्यजिह्मगैः।\nवासुदेवं त्रिभिर्बाणैरविध्यद्दक्षिणे भुजे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2063230, "chapter_id": 2346, "verse_number": "८-६७-९", "content_sanskrit": "ततोऽर्जुनो रथान्सर्वान्हत्वा तस्य पदानुगान्।\nचकार समरे भूमिं शोणितौघपरिप्लुताम्।\n[सर्बलोकवहां रौद्रां परलोकवहां नदीम्]॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2063231, "chapter_id": 2346, "verse_number": "८-६७-१०", "content_sanskrit": "सरथा रथिनः पेतुः पार्थचापच्युतैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2063232, "chapter_id": 2346, "verse_number": "८-६७-११", "content_sanskrit": "[द्रौणेरपहतान्सङ्खे ददृशु स च तां तथा।\nप्रावर्तयन्महाघोरां नदीं परवहां तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2063233, "chapter_id": 2346, "verse_number": "८-६७-१२", "content_sanskrit": "तयोस्तु व्याकुले युद्धे द्रौणेः पार्थस्य दारुणे।\nअमर्यादं योधयन्तः पर्यधावन्त पृष्ठतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2063234, "chapter_id": 2346, "verse_number": "८-६७-१३", "content_sanskrit": "रथैर्हताश्वसूतैश्च हतारोहैश्च वाजिभिः।\nद्विरदैश्च हतारोहैर्महामात्रैर्हतद्विपैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2063235, "chapter_id": 2346, "verse_number": "८-६७-१४", "content_sanskrit": "पार्थेन समरे राजन्कृतो घोरो जनक्षयः।\nनिहता रथिनः पेतुः पार्थचापच्युतैः शरैः॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2063236, "chapter_id": 2346, "verse_number": "८-६७-१५", "content_sanskrit": "हयाश्च पर्यधावन्त मुक्तयोक्त्रास्ततस्ततः।\nतद्दृष्ट्वा कर्म पार्थस्य द्रौणिराहवशोभिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2063237, "chapter_id": 2346, "verse_number": "८-६७-१६", "content_sanskrit": "अर्जुनं जयतां श्रेष्ठं त्वरितोऽभ्येत्य वीर्यवान्।\nविधुन्वानो महच्चापं कार्तस्वरविभूषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2063238, "chapter_id": 2346, "verse_number": "८-६७-१७", "content_sanskrit": "अवाकिरत्ततो द्रौमिः समन्तान्निशितैः शरैः।\nभूयोऽर्जुनं महाराज द्रौणिरायम्य पत्रिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2063239, "chapter_id": 2346, "verse_number": "८-६७-१८", "content_sanskrit": "वक्षोदेशे भृशं पार्थं ताडयामास निर्दयम्।\nसोऽतिविद्धो रणे तेन द्रोणपुत्रेण भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2063240, "chapter_id": 2346, "verse_number": "८-६७-१९", "content_sanskrit": "गाण्डीवधन्वा प्रसभं शरवर्षैरुदारधीः।\nसञ्छाद्य समरे द्रौणिं चिच्छेदास्य च कार्मुकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2063241, "chapter_id": 2346, "verse_number": "८-६७-२०", "content_sanskrit": "स च्छिन्नधन्वा परिधं वज्रस्पर्शसमं युधि।\nआदाय चिक्षेप तदा द्रोणपुत्रः किरीटिने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2063242, "chapter_id": 2346, "verse_number": "८-६७-२१", "content_sanskrit": "तमापन्ततं परिघं जाम्बूनदपरिष्कृतम्।\nचिच्छेद सहसा राजन्प्रहसन्निव पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2063243, "chapter_id": 2346, "verse_number": "८-६७-२२", "content_sanskrit": "स पपात तदा भूमौ निकृत्तः पार्थसायकैः।\nविकीर्णः पर्वतो राजन्यथा वज्रेण ताडितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2063244, "chapter_id": 2346, "verse_number": "८-६७-२३", "content_sanskrit": "ततः क्रुद्धो महाराज द्रोणपुत्रो महारथः।\nऐन्द्रेण चास्त्रवेगेन बीभत्सुं समवाकिरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2063245, "chapter_id": 2346, "verse_number": "८-६७-२४", "content_sanskrit": "तस्येन्द्रजालावततं समीक्ष्य\nपार्थो राजन्गाण्डिवमाददे सः।\nऐन्द्रं जालं प्रत्यहरत्तरस्वी\nवरास्त्रमादाय महेन्द्रसृष्टम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2063246, "chapter_id": 2346, "verse_number": "८-६७-२५", "content_sanskrit": "विदार्य तज्जालमथेन्द्रमुक्तं\nपार्थस्ततो द्रौणिरथं क्षणेन।\nप्रच्छादयामास ततोऽभ्युपेत्य\nद्रौणिस्तदा पार्थशराभिभूतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2063247, "chapter_id": 2346, "verse_number": "८-६७-२६", "content_sanskrit": "विगाह्य तां पाण्डवबाणवृष्टिं\nशरैः परं नाम ततः प्रकाश्य।\nशतेन कृष्णं सहसाभ्यविद्ध्या--\nत्त्रिभिः शतैरर्जुनं क्षुद्रकाणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2063248, "chapter_id": 2346, "verse_number": "८-६७-२७", "content_sanskrit": "ततोऽर्जुनः सायकानां शतेन\nगुरोः सुतं मर्मसु निर्बिभेद।\nअश्वांश्च सूतं च तथा धनुर्ज्या--\nमवाकिरत्पश्यतां तावकानाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2063249, "chapter_id": 2346, "verse_number": "८-६७-२८", "content_sanskrit": "स विद्ध्वा मर्मसु द्रौणिं पाण्डवः परवीरहा।\nसारथिं चास्य भल्लेन रथनीडादपातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2063250, "chapter_id": 2346, "verse_number": "८-६७-२९", "content_sanskrit": "स सङ्गृह्य स्वयं वाहान्कृष्णौ प्राच्छदयच्छरैः।\nतत्राद्भुतमपरश्याम द्रौणेराशु पराक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2063251, "chapter_id": 2346, "verse_number": "८-६७-३०", "content_sanskrit": "संयच्छंस्तुरगान्यच्च फल्गुनं चाप्ययोधयत्।\nतदस्य समरे राजन्सर्वभूतान्यपूजयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2063252, "chapter_id": 2346, "verse_number": "८-६७-३१", "content_sanskrit": "`तेनास्य समरे योधास्तुष्टुवुः सर्व एव ते।\nयदा निजगृहे पार्थो द्रोणपुत्रेण धन्विना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2063253, "chapter_id": 2346, "verse_number": "८-६७-३२", "content_sanskrit": "तदा प्रहस्य बीभस्तुर्द्रोणपुत्रस्य संयुगे।\nक्षिप्रं रश्मीनथाश्वानां क्षुरप्रैश्चिच्छिदे जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2063254, "chapter_id": 2346, "verse_number": "८-६७-३३", "content_sanskrit": "प्राद्रवंस्तुरगास्तस्य शरवेगप्रपीडिताः।\nततोऽभून्निनदो घोरस्तव सैन्यस्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2063255, "chapter_id": 2346, "verse_number": "८-६७-३४", "content_sanskrit": "पाण्डवास्तु जयं लब्ध्वा तव सैन्यं समाद्रवन्।\nसमन्तान्निशितान्बाणान्विमुञ्चन्तो जयैषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2063256, "chapter_id": 2346, "verse_number": "८-६७-३५", "content_sanskrit": "तावकी चतुरङ्गैषा पाण्डवैस्तु महाचमूः।\nपुनःपुनरथो वीरैः प्रभग्ना जितकाशिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2063257, "chapter_id": 2346, "verse_number": "८-६७-३६", "content_sanskrit": "पश्यतां ते महाराज पुत्राणां चित्रयोधिनाम्।\nशकुनेः सौबलेयस्य कर्णस्य च विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2063258, "chapter_id": 2346, "verse_number": "८-६७-३७", "content_sanskrit": "वार्यमाणा महासेना पुत्रैस्तव जनेश्वर।\nन चातिष्ठत सङ्ग्रामे पीड्यमाना समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2063259, "chapter_id": 2346, "verse_number": "८-६७-३८", "content_sanskrit": "ततो योधैर्महाराज पलायद्भिः समन्ततः।\nअभवद्य्वाकुलं भीतं पुत्राणां ते महद्बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2063260, "chapter_id": 2346, "verse_number": "८-६७-३९", "content_sanskrit": "तिष्ठतिष्ठेति सततं सूतपुत्रस्य जल्पतः।\nनावतिष्ठति सा सेना वध्यमाना महात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2063261, "chapter_id": 2346, "verse_number": "८-६७-४०", "content_sanskrit": "अथोत्क्रुष्टं महाराज पाण्डवैर्जितकाशिभिः।\nधार्तराष्ट्रबलं दृष्ट्वा विद्रुतं वै समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2063262, "chapter_id": 2346, "verse_number": "८-६७-४१", "content_sanskrit": "ततो दुर्योधनः कर्णमब्रवीत्प्रणयादिव।\nपश्य कर्ण महासेनां पाण्डवैरर्दितां भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2063263, "chapter_id": 2346, "verse_number": "८-६७-४२", "content_sanskrit": "त्वयि तिष्ठति सन्त्रासात्समन्तात्प्रपलायते।\nएतज्ज्ञत्वा महाबाहो कुरु प्राप्तमरिन्दम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2063264, "chapter_id": 2346, "verse_number": "८-६७-४३", "content_sanskrit": "सहस्राणि च योधानां त्वामेव पुरुषोत्तम।\nक्रोशन्ते समरे वीर द्राव्यमाणानि पाण्डवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2063265, "chapter_id": 2346, "verse_number": "८-६७-४४x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2063266, "chapter_id": 2346, "verse_number": "८-६७-४४", "content_sanskrit": "एतच्छ्रुत्वा तु राधेयो दुर्योधनवचो महत्।\nमद्रराजमिदं वाक्यमब्रवीत्प्रहसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2063267, "chapter_id": 2346, "verse_number": "८-६७-४५", "content_sanskrit": "पश्य मे भुजयोर्वीर्यमस्त्राणां च जनेश्वर।\nअद्य हन्मि रणे सर्वान्पाञ्चालान्पाण्डुभिः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2063268, "chapter_id": 2346, "verse_number": "८-६७-४६", "content_sanskrit": "वाहयाश्वान्नरव्याघ्र मद्राधिप न संशयः।\nएवमुक्त्वा महाराज सूतपुत्रः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2063269, "chapter_id": 2346, "verse_number": "८-६७-४७", "content_sanskrit": "प्रगृह्य विजयं वीरो धनुःश्रेष्ठं पुरातनम्।\nसज्यं कृत्वा महाराज सम्मृज्य च पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2063270, "chapter_id": 2346, "verse_number": "८-६७-४८", "content_sanskrit": "सन्निवार्य च तान्योधान्सत्येन शपथेन च।\nप्रायोजयदमेयात्मा भार्गवास्त्रं महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2063271, "chapter_id": 2346, "verse_number": "८-६७-४९", "content_sanskrit": "तस्माद्राजन्सहस्राणि प्रयुतान्यर्बुदानि च।\nकोटिशश्च शरास्तीक्ष्णा निरगच्छन्महामृधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2063272, "chapter_id": 2346, "verse_number": "८-६७-५०", "content_sanskrit": "ज्वलितैस्तैः शरैर्घोरैः कङ्कबर्हिणवाजितैः।\nसञ्चन्ना पाण्डवी सेना न प्राज्ञायत किञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2063273, "chapter_id": 2346, "verse_number": "८-६७-५१", "content_sanskrit": "हाहाकारो महानासीत्पाण्डवानां विशाम्पते।\nपीडितानां बलवता भार्गवास्त्रेण संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2063274, "chapter_id": 2346, "verse_number": "८-६७-५२", "content_sanskrit": "निपतद्भिर्गजै राजन्नश्वैश्चापि सहस्रशः।\nरथैश्चापि नरव्याघ्र नरैश्चैव समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2063275, "chapter_id": 2346, "verse_number": "८-६७-५३", "content_sanskrit": "प्राकम्पत मही राजन्निहतैस्तैः समन्ततः।\nव्याकुलं सर्वमभवत्पाण्डवानां महद्बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2063276, "chapter_id": 2346, "verse_number": "८-६७-५४", "content_sanskrit": "कर्णस्त्वेको युधां श्रेष्ठो विधूम इव पावकः।\nदहञ्शत्रून्नरव्याघ्रः शुशुभे स परन्तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2063277, "chapter_id": 2346, "verse_number": "८-६७-५५", "content_sanskrit": "ते वध्यमानाः कर्णेन पाञ्चालाश्चेदिभिः सह।\nतत्र तत्र व्यमुह्यन्त वनदाहे यथा द्विपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2063278, "chapter_id": 2346, "verse_number": "८-६७-५६", "content_sanskrit": "चुक्रुशुश्च नरव्याघ्र यथाप्राणं नरोत्तमाः।\nतेषां तु क्रोशतां दीनं भीतानां रणमूर्धनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2063279, "chapter_id": 2346, "verse_number": "८-६७-५७", "content_sanskrit": "धावतां च ततो राजंस्त्रस्तानां च समन्ततः।\nआर्तनादो बभूवात्र भूतानामिव सम्प्लुवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2063280, "chapter_id": 2346, "verse_number": "८-६७-५८", "content_sanskrit": "वध्यमानांस्तु तान्दृष्ट्वा सूतपुत्रेण मारिष॥\nवित्रेसुः सर्वभूतानि तिर्यग्योनिगतान्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2063281, "chapter_id": 2346, "verse_number": "८-६७-५९", "content_sanskrit": "ते वध्यमाताः समरे सूतपुत्रेण सृञ्जयाः।\nअर्जुनं वासुदेवं च क्रोशन्ति च मुहुर्मुहुः।\nप्रेतराजपुरे यद्वत्प्रेतराजं विचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2063282, "chapter_id": 2346, "verse_number": "८-६७-६०", "content_sanskrit": "श्रुत्वा तु निनदं तेषां वध्यतां कर्णसायकैः।\nअथाब्रवीद्वासुदेवं कुन्तीपुत्रो धऩञ्जयः।\nभार्गवास्त्रं महाघोरं दृष्ट्वा तत्र समीरितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2063283, "chapter_id": 2346, "verse_number": "८-६७-६१", "content_sanskrit": "पश्य कृष्ण महाबाहो भार्गवास्त्रस्य विक्रमम्।\nनैतदस्त्रं हि समरे शक्यं हन्तुं कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2063284, "chapter_id": 2346, "verse_number": "८-६७-६२", "content_sanskrit": "सूतपुत्रं च संरब्धं पश्य कृष्ण महारणे।\nअन्तकप्रतिमं वीर्ये कुर्वाणं कर्म दारुणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2063285, "chapter_id": 2346, "verse_number": "८-६७-६३", "content_sanskrit": "अभीक्ष्णं चोदयन्नश्वान्प्रेक्षते मां मुहुर्मुहुः।\nनच शक्ष्यामि कर्णस्य संयुगेऽहं पलायितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2063286, "chapter_id": 2346, "verse_number": "८-६७-६४", "content_sanskrit": "जीवन्प्राप्नोति पुरुषः सङ्ख्ये जयपराजयौ।\nमृतस्य तु हृपीकेश भङ्ग एव कुतो जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2063287, "chapter_id": 2346, "verse_number": "८-६७-६५", "content_sanskrit": "एष कर्णो रणे भाति मध्याह्न इव भास्करः।\nनिवर्तय रथं कृष्ण जीवन्भद्राणि पश्यति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2063288, "chapter_id": 2346, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि सप्तद्वशदिवसयुद्धे सप्तषष्टितमोऽध्यायः॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]