[{"id": 2029731, "chapter_id": 1648, "verse_number": "३-२८६-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2029732, "chapter_id": 1648, "verse_number": "३-२८६-१", "content_sanskrit": "ततो निविशमानांस्तान्सैनिकान्रावणानुगाः।\nअभिजग्मुर्गणाऽनके पिशाचक्षुद्ररक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2029733, "chapter_id": 1648, "verse_number": "३-२८६-२", "content_sanskrit": "पर्वणः पतनो जम्भः खरः क्रोधवशो हरिः।\nप्ररुजश्चारुजश्चैव प्रघसश्चैवमादयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2029734, "chapter_id": 1648, "verse_number": "३-२८६-३", "content_sanskrit": "ततोऽभिपततां तेषामदृश्यानां दुरात्मनाम्।\nअन्तर्धानवधं तज्ज्ञश्चकार स विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2029735, "chapter_id": 1648, "verse_number": "३-२८६-४", "content_sanskrit": "ते दृश्यमाना हरिभिर्बलिभिर्दूरपातिभिः।\nनिहताः सर्वशो राजन्महीं जग्मुर्गतासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2029736, "chapter_id": 1648, "verse_number": "३-२८६-५", "content_sanskrit": "अमृष्यमाणः सबलो रावणो निर्ययावथ।\nराक्षसानां बलैर्घोरैः पिशाचानांच संवृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2029737, "chapter_id": 1648, "verse_number": "३-२८६-६", "content_sanskrit": "युद्धशास्त्रविधानज्ञ उशना इव चापरः।\nव्यूह्यचौशनसं व्यूहं हरीनभ्यवहारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2029738, "chapter_id": 1648, "verse_number": "३-२८६-७", "content_sanskrit": "राघवस्तु विनिर्यान्तं व्यूढानीकं दशाननम्।\nबार्हस्पत्यं विधं कृत्वा प्रतिव्यूह्य ह्यदृश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2029739, "chapter_id": 1648, "verse_number": "३-२८६-८", "content_sanskrit": "समेत्य युयुधे तत्र ततो रामेण रावणः।\nयुयुधे लक्ष्मणश्चापि तथैवेन्द्रजिता सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2029740, "chapter_id": 1648, "verse_number": "३-२८६-९", "content_sanskrit": "विरूपाक्षेण सुग्रीवस्तारेण च निस्वर्वटः।\nपौण्ड्रेण च नलस्तत्र पदुशः पनसेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2029741, "chapter_id": 1648, "verse_number": "३-२८६-१०", "content_sanskrit": "विषह्यं यं हि यो मेने स स तेन समेयिवान्।\nयुयुधे युद्धवेलायां स्वबाहुबलमाश्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2029742, "chapter_id": 1648, "verse_number": "३-२८६-११", "content_sanskrit": "स संप्रहारो ववृधे भीरूणां भयवर्धनः।\nरोमसंहर्षणो घोरः पुरा देवासुरे यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2029743, "chapter_id": 1648, "verse_number": "३-२८६-१२", "content_sanskrit": "रावणो राममानर्च्छच्छक्तिशूलासिवृष्टिभिः।\nनिशितैरायसैस्तीक्ष्णै रावणं चापि राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2029744, "chapter_id": 1648, "verse_number": "३-२८६-१३", "content_sanskrit": "तथैवेन्द्रजितं यत्तं लक्ष्मणो मर्मभेदिभिः।\nइन्द्रजिच्चापि सौमित्रिं बिभेद बहुभिः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2029745, "chapter_id": 1648, "verse_number": "३-२८६-१४", "content_sanskrit": "विभीषणः प्रहस्तं च प्रहस्तश्च विभीषणम्।\nखगपत्रैः शरैस्तीक्ष्णैरभ्यवर्षद्गतव्यथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2029746, "chapter_id": 1648, "verse_number": "३-२८६-१५", "content_sanskrit": "तेषां बलवतामासीन्महास्त्राणां समागमः।\nविव्यथुः सकला येन त्रयो लोकाश्चराचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2029747, "chapter_id": 1648, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि रामोपाख्यानपर्वणि षडशीत्यधिकद्विशततमोऽध्यायः ॥ २८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]