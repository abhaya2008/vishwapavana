[{"id": 40017015, "chapter_id": 9256, "verse_number": "1", "content_sanskrit": "कुम्भकर्णंहतंदृष्टवाराघवेणमहात्मना । राक्षसाराक्षसेन्द्रायरावणायन्यवेदयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40017016, "chapter_id": 9256, "verse_number": "2", "content_sanskrit": "राजन् स कालसङ्काशस्संयुक्तःकालकर्मणा । विद्राव्यवानरींसेनांभक्षयित्वा च वानरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40017017, "chapter_id": 9256, "verse_number": "3", "content_sanskrit": "प्रतपित्वा मुहूर्तंतुप्रशान्तोरामतेजसा । कायेनार्थप्रविष्टेनसमुद्रंभीमदर्शनम् ॥ निकृत्तकण्ठोरुभुजोविक्षरन्रुधिरंबहु । रुद्ध्वाद्वारंशरीरेणलङ्कायाःपर्वतोपमः ॥ कुम्भकर्णस्तवभ्राताकाकुत्स्थशरपीडितः । लगण्डभूतोविकृतोदावदग्धइवद्रुमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40017018, "chapter_id": 9256, "verse_number": "4", "content_sanskrit": "प्रतपित्वा मुहूर्तंतुप्रशान्तोरामतेजसा । कायेनार्थप्रविष्टेनसमुद्रंभीमदर्शनम् ॥ निकृत्तकण्ठोरुभुजोविक्षरन्रुधिरंबहु । रुद्ध्वाद्वारंशरीरेणलङ्कायाःपर्वतोपमः ॥ कुम्भकर्णस्तवभ्राताकाकुत्स्थशरपीडितः । लगण्डभूतोविकृतोदावदग्धइवद्रुमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40017019, "chapter_id": 9256, "verse_number": "5", "content_sanskrit": "प्रतपित्वा मुहूर्तंतुप्रशान्तोरामतेजसा । कायेनार्थप्रविष्टेनसमुद्रंभीमदर्शनम् ॥ निकृत्तकण्ठोरुभुजोविक्षरन्रुधिरंबहु । रुद्ध्वाद्वारंशरीरेणलङ्कायाःपर्वतोपमः ॥ कुम्भकर्णस्तवभ्राताकाकुत्स्थशरपीडितः । लगण्डभूतोविकृतोदावदग्धइवद्रुमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40017020, "chapter_id": 9256, "verse_number": "6", "content_sanskrit": "तंश्रुत्वाविनिहतंसङ्ख्येकुम्भकर्णंमहाबलम् । रावणश्शोकसन्तप्तोमुमोह च पपात च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40017021, "chapter_id": 9256, "verse_number": "7", "content_sanskrit": "पितृव्यंनिहतंश्रुत्वादेवान्तकनरान्तकौ । त्रिशिराश्चातिकायश्चरुरुदुश्शोकपीडिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40017022, "chapter_id": 9256, "verse_number": "8", "content_sanskrit": "भ्रातरंनिहतंश्रुत्वारामेणाक्लिष्टकर्मणा । महोदरमहापार्श्वौशोकाक्रान्तौबभूवतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40017023, "chapter_id": 9256, "verse_number": "9", "content_sanskrit": "ततःकृच्छ्रात्समासाद्यसंज्ञांराक्षसपुङ्गवः । कुम्भकर्णवधाद्दीनोविललापकुलेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40017024, "chapter_id": 9256, "verse_number": "10", "content_sanskrit": "हावीर रिपुदर्पघ्न कुम्भकर्ण महाबल । त्वंमांविहायवैदैवाद्यातोऽसियमसादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40017025, "chapter_id": 9256, "verse_number": "11", "content_sanskrit": "ममशल्यमनुद्धृत्यबान्धवानांमहाबल । शत्रुसैन्यंप्रताप्यैकस्त्वंमांसन्त्यज्यगच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40017026, "chapter_id": 9256, "verse_number": "12", "content_sanskrit": "इदानींखल्वहंनास्मियस्यमेदक्षिणोभुजः । पतितोयंसमाश्रित्य न बिभेमिसुरासुरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40017027, "chapter_id": 9256, "verse_number": "13", "content_sanskrit": "कथमेवंविधोवीरोदेवदानवदर्पहा । कालाग्निरुद्राप्रतिमोरणेराघवेणवैहतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40017028, "chapter_id": 9256, "verse_number": "14", "content_sanskrit": "यस्यतेवज्रनिष्पेषो न कुर्वाद्व्यसनंसदा । स कथंरामबाणार्तंप्रसुप्तोऽसिमहीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40017029, "chapter_id": 9256, "verse_number": "15", "content_sanskrit": "एतेदेवगणास्सार्थमृषिभिर्गगनेस्थिताः । निहतंत्वांरणेदृष्टवानिनदन्तिप्रहर्षिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40017030, "chapter_id": 9256, "verse_number": "16", "content_sanskrit": "ध्रुवमद्यैवसंहृष्टालब्धलक्षाःप्लवङ्गमाः । आरोक्ष्यन्तीहदुर्गाणिलङ्काद्वाराणिसर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40017031, "chapter_id": 9256, "verse_number": "17", "content_sanskrit": "राज्येननास्तिमेकार्यंकिंकरिष्यामिसीतया । कुम्भकर्णविहीनस्यजीवितेनास्तिमेमतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40017032, "chapter_id": 9256, "verse_number": "18", "content_sanskrit": "यद्यहंभ्रातृहन्तारं न हन्मियुधिराघवम् । ननुमेमरणंश्रेयो न चेदंव्यर्थजीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40017033, "chapter_id": 9256, "verse_number": "19", "content_sanskrit": "अद्यैवतंगमिष्यामिदेशंयत्रानुजोमम । न हिभ्रातृ़न् समुत्सृज्यक्षणंजीवितमुत्सहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40017034, "chapter_id": 9256, "verse_number": "20", "content_sanskrit": "देवाहिमांहसिष्यन्तिदृष्टवापूर्वापकारिणम् । कथमिन्द्रंजयिष्यामिकुम्भकर्ण हतेत्वयि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40017035, "chapter_id": 9256, "verse_number": "21", "content_sanskrit": "तदिदंमामनुप्राप्तंविभीषणवचश्शुभम् । यदज्ञानान्मयातस्य न गृहीतंमहात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40017036, "chapter_id": 9256, "verse_number": "22", "content_sanskrit": "विभीषणवचोयावत्कुम्भकर्णप्रहस्तयोः । विनाशोऽयंसमुत्पन्नोमांव्रीडयतिदारुणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40017037, "chapter_id": 9256, "verse_number": "23", "content_sanskrit": "तस्यायंकर्मणःप्राप्तोविपाकोममशोकदः । यन्मयाधार्मिकश्शमान् स निरस्तोविभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]