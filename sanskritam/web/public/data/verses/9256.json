[{"id": 5000256000, "chapter_id": 9256, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे एकोनषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000256001, "chapter_id": 9256, "verse_number": "३-५९-१", "content_sanskrit": "अथाश्रमादुपावृत्तमन्तरा रघुनन्दनः।\nपरिपप्रच्छ सौमित्रिं रामो दुःखादिदं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000256002, "chapter_id": 9256, "verse_number": "३-५९-२", "content_sanskrit": "तमुवाच किमर्थं त्वमागतोऽपास्य मैथिलीम्।\nयदा सा तव विश्वासाद् वने विरहिता मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000256003, "chapter_id": 9256, "verse_number": "३-५९-३", "content_sanskrit": "दृष्ट्वैवाभ्यागतं त्वां मे मैथिलीं त्यज्य लक्ष्मण।\nशङ्कमानं महत् पापं यत्सत्यं व्यथितं मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000256004, "chapter_id": 9256, "verse_number": "३-५९-४", "content_sanskrit": "स्फुरते नयनं सव्यं बाहुश्च हृदयं च मे।\nदृष्ट्वा लक्ष्मण दूरे त्वां सीताविरहितं पथि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000256005, "chapter_id": 9256, "verse_number": "३-५९-५", "content_sanskrit": "एवमुक्तस्तु सौमित्रिर्लक्ष्मणः शुभलक्षणः।\nभूयो दुःखसमाविष्टो दुःखितं राममब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000256006, "chapter_id": 9256, "verse_number": "३-५९-६", "content_sanskrit": "न स्वयं कामकारेण तां त्यक्त्वाहमिहागतः।\nप्रचोदितस्तयैवोग्रैस्त्वत्सकाशमिहागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000256007, "chapter_id": 9256, "verse_number": "३-५९-७", "content_sanskrit": "आर्येणेव परिक्रुष्टं लक्ष्मणेति सुविस्वरम्।\nपरित्राहीति यद्वाक्यं मैथिल्यास्तच्छ्रुतिं गतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000256008, "chapter_id": 9256, "verse_number": "३-५९-८", "content_sanskrit": "सा तमार्तस्वरं श्रुत्वा तव स्नेहेन मैथिली।\nगच्छ गच्छेति मामाशु रुदती भयविक्लवा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000256009, "chapter_id": 9256, "verse_number": "३-५९-९", "content_sanskrit": "प्रचोद्यमानेन मया गच्छेति बहुशस्तया।\nप्रत्युक्ता मैथिली वाक्यमिदं तत् प्रत्ययान्वितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000256010, "chapter_id": 9256, "verse_number": "३-५९-१०", "content_sanskrit": "न तत् पश्याम्यहं रक्षो यदस्य भयमावहेत्।\nनिर्वृता भव नास्त्येतत् केनाप्येतदुदाहृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000256011, "chapter_id": 9256, "verse_number": "३-५९-११", "content_sanskrit": "विगर्हितं च नीचं च कथमार्योऽभिधास्यति।\nत्राहीति वचनं सीते यस्त्रायेत् त्रिदशानपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000256012, "chapter_id": 9256, "verse_number": "३-५९-१२", "content_sanskrit": "किंनिमित्तं तु केनापि भ्रातुरालम्ब्य मे स्वरम्।\nविस्वरं व्याहृतं वाक्यं लक्ष्मण त्राहि मामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000256013, "chapter_id": 9256, "verse_number": "३-५९-१३", "content_sanskrit": "राक्षसेनेरितं वाक्यं त्रासात् त्राहीति शोभने।\nन भवत्या व्यथा कार्या कुनारीजनसेविता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000256014, "chapter_id": 9256, "verse_number": "३-५९-१४", "content_sanskrit": "अलं विक्लवतां गन्तुं स्वस्था भव निरुत्सुका।\nन चास्ति त्रिषु लोकेषु पुमान् यो राघवं रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000256015, "chapter_id": 9256, "verse_number": "३-५९-१५", "content_sanskrit": "जातो वा जायमानो वा संयुगे यः पराजयेत्।\nअजेयो राघवो युद्धे देवैः शक्रपुरोगमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000256016, "chapter_id": 9256, "verse_number": "३-५९-१६", "content_sanskrit": "एवमुक्ता तु वैदेही परिमोहितचेतना।\nउवाचाश्रूणि मुञ्चन्ती दारुणं मामिदं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000256017, "chapter_id": 9256, "verse_number": "३-५९-१७", "content_sanskrit": "भावो मयि तवात्यर्थं पाप एव निवेशितः।\nविनष्टे भ्रातरि प्राप्तुं न च त्वं मामवाप्स्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000256018, "chapter_id": 9256, "verse_number": "३-५९-१८", "content_sanskrit": "संकेताद् भरतेन त्वं रामं समनुगच्छसि।\nक्रोशन्तं हि यथात्यर्थं नैनमभ्यवपद्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000256019, "chapter_id": 9256, "verse_number": "३-५९-१९", "content_sanskrit": "रिपुः प्रच्छन्नचारी त्वं मदर्थमनुगच्छसि।\nराघवस्यान्तरं प्रेप्सुस्तथैनं नाभिपद्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000256020, "chapter_id": 9256, "verse_number": "३-५९-२०", "content_sanskrit": "एवमुक्तस्तु वैदेह्या संरब्धो रक्तलोचनः।\nक्रोधात् प्रस्फुरमाणोष्ठ आश्रमादभिनिर्गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000256021, "chapter_id": 9256, "verse_number": "३-५९-२१", "content_sanskrit": "एवं ब्रुवाणं सौमित्रिं रामः संतापमोहितः।\nअब्रवीद् दुष्कृतं सौम्य तां विना त्वमिहागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000256022, "chapter_id": 9256, "verse_number": "३-५९-२२", "content_sanskrit": "जानन्नपि समर्थं मां रक्षसामपवारणे।\nअनेन क्रोधवाक्येन मैथिल्या निर्गतो भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000256023, "chapter_id": 9256, "verse_number": "३-५९-२३", "content_sanskrit": "नहि ते परितुष्यामि त्यक्त्वा यदसि मैथिलीम्।\nक्रुद्धायाः परुषं श्रुत्वा स्त्रिया यत् त्वमिहागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000256024, "chapter_id": 9256, "verse_number": "३-५९-२४", "content_sanskrit": "सर्वथा त्वपनीतं ते सीतया यत् प्रचोदितः।\nक्रोधस्य वशमागम्य नाकरोः शासनं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000256025, "chapter_id": 9256, "verse_number": "३-५९-२५", "content_sanskrit": "असौ हि राक्षसः शेते शरेणाभिहतो मया।\nमृगरूपेण येनाहमाश्रमादपवाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000256026, "chapter_id": 9256, "verse_number": "३-५९-२६", "content_sanskrit": "विकृष्य चापं परिधाय सायकं\nसलीलबाणेन च ताडितो मया।\nमार्गीं तनुं त्यज्य च विक्लवस्वरो\nबभूव केयूरधरः स राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000256027, "chapter_id": 9256, "verse_number": "३-५९-२७", "content_sanskrit": "शराहतेनैव तदार्तया गिरा\nस्वरं ममालम्ब्य सुदूरसुश्रवम्।\nउदाहृतं तद् वचनं सुदारुणं\nत्वमागतो येन विहाय मैथिलीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000256028, "chapter_id": 9256, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे एकोनषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]