[{"id": 40015792, "chapter_id": 9233, "verse_number": "1", "content_sanskrit": "सतस्यगतिमन्विच्छन्राजपुत्रःप्रतापवान् । दिदेशातिबलोरामोदशवानरयूथपान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40015793, "chapter_id": 9233, "verse_number": "2", "content_sanskrit": "द्वौसुषेणस्यदायादौनीलंचप्लवगर्षपम् । अङ्गदंवालिपुत्रंचशरभंचतरस्विनम् ॥ विनतंजाम्बवन्तंचसानुप्रस्थंमहाबलम् । ऋषभंचर्षभस्कन्थमादिदेशपरन्तपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40015794, "chapter_id": 9233, "verse_number": "3", "content_sanskrit": "द्वौसुषेणस्यदायादौनीलंचप्लवगर्षपम् । अङ्गदंवालिपुत्रंचशरभंचतरस्विनम् ॥ विनतंजाम्बवन्तंचसानुप्रस्थंमहाबलम् । ऋषभंचर्षभस्कन्थमादिदेशपरन्तपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40015795, "chapter_id": 9233, "verse_number": "4", "content_sanskrit": "तेसम्प्रहृष्टाहरयोभीमानुद्यम्यपादपान् । आकाशंविविशुस्सर्वेमार्गमाणादिशोदशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40015796, "chapter_id": 9233, "verse_number": "5", "content_sanskrit": "तेषांवेगवतांवेगमिषुभिर्वेगवत्तरैः । अस्त्रवित्परमास्तैरैस्तुवारयामासरावणिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40015797, "chapter_id": 9233, "verse_number": "6", "content_sanskrit": "तंभीममार्गमाणादिशोदशःवेगाहरयोनाराचैःक्षतविग्रहाः । अन्धकारेनददृशुर्मेघैस्सूर्यमिवावृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40015798, "chapter_id": 9233, "verse_number": "7", "content_sanskrit": "रामलक्ष्मणयोरेवसर्वदेहभिदश्शरान् । भृशमावेशयामासरावणिस्समितिञ्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "",