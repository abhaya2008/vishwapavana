[{"id": 5000233000, "chapter_id": 9233, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे सप्तत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000233001, "chapter_id": 9233, "verse_number": "३-३७-१", "content_sanskrit": "तच्छ्रुत्वा राक्षसेन्द्रस्य वाक्यं वाक्यविशारदः।\nप्रत्युवाच महातेजा मारीचो राक्षसेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000233002, "chapter_id": 9233, "verse_number": "३-३७-२", "content_sanskrit": "सुलभाः पुरुषा राजन् सततं प्रियवादिनः।\nअप्रियस्य च पथ्यस्य वक्ता श्रोता च दुर्लभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000233003, "chapter_id": 9233, "verse_number": "३-३७-३", "content_sanskrit": "न नूनं बुध्यसे रामं महावीर्यगुणोन्नतम्।\nअयुक्तचारश्चपलो महेन्द्रवरुणोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000233004, "chapter_id": 9233, "verse_number": "३-३७-४", "content_sanskrit": "अपि स्वस्ति भवेत् तात सर्वेषामपि रक्षसाम्।\nअपि रामो न संक्रुद्धः कुर्याल्लोकानराक्षसान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000233005, "chapter_id": 9233, "verse_number": "३-३७-५", "content_sanskrit": "अपि ते जीवितान्ताय नोत्पन्ना जनकात्मजा।\nअपि सीतानिमित्तं च न भवेद् व्यसनं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000233006, "chapter_id": 9233, "verse_number": "३-३७-६", "content_sanskrit": "अपि त्वामीश्वरं प्राप्य कामवृत्तं निरङ्कुशम्।\nन विनश्येत् पुरी लङ्का त्वया सह सराक्षसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000233007, "chapter_id": 9233, "verse_number": "३-३७-७", "content_sanskrit": "त्वद्विधः कामवृत्तो हि दुःशीलः पापमन्त्रितः।\nआत्मानं स्वजनं राष्ट्रं स राजा हन्ति दुर्मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000233008, "chapter_id": 9233, "verse_number": "३-३७-८", "content_sanskrit": "न च पित्रा परित्यक्तो नामर्यादः कथंचन।\nन लुब्धो न च दुःशीलो न च क्षत्रियपांसनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000233009, "chapter_id": 9233, "verse_number": "३-३७-९", "content_sanskrit": "न च धर्मगुणैर्हीनः कौसल्यानन्दवर्धनः।\nन च तीक्ष्णो हि भूतानां सर्वभूतहिते रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000233010, "chapter_id": 9233, "verse_number": "३-३७-१०", "content_sanskrit": "वञ्चितं पितरं दृष्ट्वा कैकेय्या सत्यवादिनम्।\nकरिष्यामीति धर्मात्मा ततः प्रव्रजितो वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000233011, "chapter_id": 9233, "verse_number": "३-३७-११", "content_sanskrit": "कैकेय्याः प्रियकामार्थं पितुर्दशरथस्य च।\nहित्वा राज्यं च भोगांश्च प्रविष्टो दण्डकावनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000233012, "chapter_id": 9233, "verse_number": "३-३७-१२", "content_sanskrit": "न रामः कर्कशस्तात नाविद्वान् नाजितेन्द्रियः।\nअनृतं न श्रुतं चैव नैव त्वं वक्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000233013, "chapter_id": 9233, "verse_number": "३-३७-१३", "content_sanskrit": "रामो विग्रहवान् धर्मः साधुः सत्यपराक्रमः।\nराजा सर्वस्य लोकस्य देवानामिव वासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000233014, "chapter_id": 9233, "verse_number": "३-३७-१४", "content_sanskrit": "कथं नु तस्य वैदेहीं रक्षितां स्वेन तेजसा।\nइच्छसे प्रसभं हर्तुं प्रभामिव विवस्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000233015, "chapter_id": 9233, "verse_number": "३-३७-१५", "content_sanskrit": "शरार्चिषमनाधृष्यं चापखड्गेन्धनं रणे।\nरामाग्निं सहसा दीप्तं न प्रवेष्टुं त्वमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000233016, "chapter_id": 9233, "verse_number": "३-३७-१६", "content_sanskrit": "धनुर्व्यादितदीप्तास्यं शरार्चिषममर्षणम्।\nचापबाणधरं तीक्ष्णं शत्रुसेनापहारिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000233017, "chapter_id": 9233, "verse_number": "३-३७-१७", "content_sanskrit": "राज्यं सुखं च संत्यज्य जीवितं चेष्टमात्मनः।\nनात्यासादयितुं तात रामान्तकमिहार्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000233018, "chapter_id": 9233, "verse_number": "३-३७-१८", "content_sanskrit": "अप्रमेयं हि तत्तेजो यस्य सा जनकात्मजा।\nन त्वं समर्थस्तां हर्तुं रामचापाश्रयां वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000233019, "chapter_id": 9233, "verse_number": "३-३७-१९", "content_sanskrit": "तस्य वै नरसिंहस्य सिंहोरस्कस्य भामिनी।\nप्राणेभ्योऽपि प्रियतरा भार्या नित्यमनुव्रता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000233020, "chapter_id": 9233, "verse_number": "३-३७-२०", "content_sanskrit": "न सा धर्षयितुं शक्या मैथिल्योजस्विनः प्रिया।\nदीप्तस्येव हुताशस्य शिखा सीता सुमध्यमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000233021, "chapter_id": 9233, "verse_number": "३-३७-२१", "content_sanskrit": "किमुद्यमं व्यर्थमिमं कृत्वा ते राक्षसाधिप।\nदृष्टश्चेत् त्वं रणे तेन तदन्तमुपजीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000233022, "chapter_id": 9233, "verse_number": "३-३७-२२", "content_sanskrit": "जीवितं च सुखं चैव राज्यं चैव सुदुर्लभम्।\nयदीच्छसि चिरं भोक्तुं मा कृथा रामविप्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000233023, "chapter_id": 9233, "verse_number": "३-३७-२३", "content_sanskrit": "स सर्वैः सचिवैः सार्धं विभीषणपुरस्कृतैः।\nमन्त्रयित्वा स धर्मिष्ठैः कृत्वा निश्चयमात्मनः।\nदोषाणां च गुणानां च सम्प्रधार्य बलाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000233024, "chapter_id": 9233, "verse_number": "३-३७-२४", "content_sanskrit": "आत्मनश्च बलं ज्ञात्वा राघवस्य च तत्त्वतः।\nहितं हि तव निश्चित्य क्षमं त्वं कर्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000233025, "chapter_id": 9233, "verse_number": "३-३७-२५", "content_sanskrit": "अहं तु मन्ये तव न क्षमं रणे\nसमागमं कोसलराजसूनुना।\nइदं हि भूयः शृणु वाक्यमुत्तमं\nक्षमं च युक्तं च निशाचराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000233026, "chapter_id": 9233, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे सप्तत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]