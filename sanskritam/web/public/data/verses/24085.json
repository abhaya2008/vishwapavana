[{"id": 7004085000, "chapter_id": 24085, "verse_number": "४-३४-१", "content_sanskrit": "स्कंद उवाच ।\nपुनर्ददर्श तन्वंगी चित्रपट्यां घटोद्भव ।\nस्वर्गद्वारात्पुरोभागे श्रीमतीं मणिकर्णिकाम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004085001, "chapter_id": 24085, "verse_number": "४-३४-२", "content_sanskrit": "संसारसर्पदष्टानां जंतूनां यत्र शंकरः ।\nअपसव्येन हस्तेन ब्रूते ब्रह्मस्पृशञ्छ्रुतिम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004085002, "chapter_id": 24085, "verse_number": "४-३४-३", "content_sanskrit": "न कापिलेन योगेन न सांख्येन न च व्रतैः ।\nया गतिः प्राप्यते पुंभिस्तां दद्यान्मोक्षभूरियम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004085003, "chapter_id": 24085, "verse_number": "४-३४-४", "content_sanskrit": "वैकुंठे विष्णुभवने विष्णुभक्तिपरायणाः ।\nजपेयुः सततं मुक्त्यै श्रीमतीं मणिकर्णिकाम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004085004, "chapter_id": 24085, "verse_number": "४-३४-५", "content_sanskrit": "हुत्वाग्निहोत्रमपि च यावज्जीवं द्विजोत्तमाः ।\nअंते श्रयंते मुक्त्यै यां सेयं श्रीमणिकर्णिका ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004085005, "chapter_id": 24085, "verse_number": "४-३४-६", "content_sanskrit": "वेदान्पठित्वा विधिवद्ब्रह्मयज्ञरता भुवि ।\nयां श्रयंति द्विजा मुक्त्यै सेयं श्रीमणिकर्णिका ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004085006, "chapter_id": 24085, "verse_number": "४-३४-७", "content_sanskrit": "इष्ट्वा क्रतूनपि नृपा बहून्पर्याप्तदक्षिणान् ।\nश्रयंते श्रेयसे धन्याः प्रांतेऽधिमणिकर्णिकम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004085007, "chapter_id": 24085, "verse_number": "४-३४-८", "content_sanskrit": "सीमंतिन्योपि सततं पतिव्रतपरायणाः ।\nमुक्त्यै पतिमनुव्रज्य श्रयंति मणिकर्णिकाम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004085008, "chapter_id": 24085, "verse_number": "४-३४-९", "content_sanskrit": "वैश्या अपि च सेवंते न्यायोपार्जितसंपदः ।\nधनानि साधुसात्कृत्वा प्रांते श्रीमणिकर्णिकाम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004085009, "chapter_id": 24085, "verse_number": "४-३४-१०", "content_sanskrit": "त्यक्त्वा पुत्रकलत्रादि सच्छूद्रा न्यायमार्गगाः ।\nनिर्वाणप्राप्तये चैनां भजेयुर्मणिकर्णिकाम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004085010, "chapter_id": 24085, "verse_number": "४-३४-११", "content_sanskrit": "यावज्जीवं चरंतोपि ब्रह्मचर्य जितेंद्रियाः ।\nनिःश्रेयसे श्रयंत्येनां श्रीमतीं मणिकार्णकाम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004085011, "chapter_id": 24085, "verse_number": "४-३४-१२", "content_sanskrit": "अतिथीनपि संतर्प्य पंचयज्ञरता अपि ।\nगृहस्थाश्रमिणो नेमां त्यजेयुर्मणिकर्णिकाम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004085012, "chapter_id": 24085, "verse_number": "४-३४-१३", "content_sanskrit": "वानप्रस्थाश्रमयुजो ज्ञात्वा निर्वाणसाधनम् ।\nसन्नियम्येंद्रियग्रामं मणिकर्णीमुपासते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004085013, "chapter_id": 24085, "verse_number": "४-३४-१४", "content_sanskrit": "अनन्यसाधनां मुक्तिं ज्ञात्वा शास्त्रैरनेकधा ।\nमुमुक्षुभिस्त्वेकदंडैः सेव्यते मणिकर्णिका ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004085014, "chapter_id": 24085, "verse_number": "४-३४-१५", "content_sanskrit": "दंडयित्वा मनोवाचं कायं नित्यं त्रिदंडिनः ।\nनैःश्रेयसीं श्रियं प्राप्तुं श्रयंते मणिकर्णिकाम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004085015, "chapter_id": 24085, "verse_number": "४-३४-१६", "content_sanskrit": "संन्यस्ताखिलकर्माणो दंडयित्वा चलं मनः ।\nएकदंडव्रता मुक्त्यै भजेयुर्मणिकर्णिकाम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004085016, "chapter_id": 24085, "verse_number": "४-३४-१७", "content_sanskrit": "शिखी मुंडी जटी वापि कौपीनी वा दिगंबरः ।\nमुमुक्षुः को न सेवेत मुक्तिदां मणिकर्णिकाम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004085017, "chapter_id": 24085, "verse_number": "४-३४-१८", "content_sanskrit": "तपःकर्तुं न शक्ता ये दानं वा दातुमक्षमाः ।\nयोगाभ्यास विहीना ये तेषामेषा विमुक्तिदा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004085018, "chapter_id": 24085, "verse_number": "४-३४-१९", "content_sanskrit": "संत्युपायाः सहस्रं तु मुक्तये न तथा मुने ।\nहेलयैषा यथा दद्यान्निर्वाणं मणिकर्णिका ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004085019, "chapter_id": 24085, "verse_number": "४-३४-२०", "content_sanskrit": "अनशनव्रतभृते त्रिकालाभ्यवहारिणे ।\nप्रांते दद्यात्समां मुक्तिमुभाभ्यां मणिकर्णिका ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004085020, "chapter_id": 24085, "verse_number": "४-३४-२१", "content_sanskrit": "यथोक्तमाचरेदेको निष्ठा पाशुपतंव्रतम् ।\nनिरंतरं स्मरेदेको हृद्येनां मणिकर्णिकाम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004085021, "chapter_id": 24085, "verse_number": "४-३४-२२", "content_sanskrit": "दृष्टात्र वपुषः पाते द्वयोश्च सदृशी गतिः ।\nतस्मात्सर्वविहायाशु सेव्यैषा मणिकर्णिका ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004085022, "chapter_id": 24085, "verse_number": "४-३४-२३", "content_sanskrit": "स्वर्गद्वारे विशेयुर्ये विगाह्य मणिकर्णिकाम् ।\nतेषां विधूतपापानां कापि स्वर्गो न दूरतः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004085023, "chapter_id": 24085, "verse_number": "४-३४-२४", "content_sanskrit": "स्वर्गद्वाः स्वर्गभूरेषा मोक्षभूर्मणिकर्णिका ।\nस्वर्गापवर्गावत्रैव नोपरिष्टान्न चाप्यधः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004085024, "chapter_id": 24085, "verse_number": "४-३४-२५", "content_sanskrit": "दत्त्वा दानान्यनेकानि विगाह्य मणिकर्णिकाम् ।\nस्वर्गद्वारं प्रविष्टा ये न ते निरयगामिनः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004085025, "chapter_id": 24085, "verse_number": "४-३४-२६", "content_sanskrit": "स्वर्गापवर्गयोरर्थः कोविदैश्च निरूपितः ।\nस्वर्गः सुखं समुद्दिष्टमपवर्गो महासुखम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004085026, "chapter_id": 24085, "verse_number": "४-३४-२७", "content_sanskrit": "मणिकर्ण्युपविष्टस्य यत्सुखं जायते सतः ।\nसिंहासनोपविष्टस्य तत्सुखं क्व शतक्रतोः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004085027, "chapter_id": 24085, "verse_number": "४-३४-२८", "content_sanskrit": "महासुखं यदुद्दिष्टं समाधौ विस्मृतात्मनाम् ।\nश्रीमत्यां मणिकर्ण्यां तत्सहजेनैव जायते ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004085028, "chapter_id": 24085, "verse_number": "४-३४-२९", "content_sanskrit": "स्वर्गद्वारात्पुरोभागे देवनद्याश्च पश्चिमे ।\nसौभाग्यभाग्यैकनिधिः काचिदेका महास्थली ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004085029, "chapter_id": 24085, "verse_number": "४-३४-३०", "content_sanskrit": "यावंतो भास्वतः स्पर्शाद्भासंते सैकताः कणाः ।\nतावंतो द्रुहिणा जग्मुर्नैत्येषा मणिकर्णिका ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004085030, "chapter_id": 24085, "verse_number": "४-३४-३१", "content_sanskrit": "संति तीर्थानि तावंति परितो मणिकर्णिकाम् ।\nयावद्भिस्तिलमात्रापि न भूमिर्विरलीकृता ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004085031, "chapter_id": 24085, "verse_number": "४-३४-३२", "content_sanskrit": "यदन्वये कोपि मुक्तः संप्राप्य मणिकर्णिकाम् ।\nतद्वंश्यास्तत्प्रभावेण मान्याः स्वर्गौकसामपि ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004085032, "chapter_id": 24085, "verse_number": "४-३४-३३", "content_sanskrit": "तर्पिताः पितरो येन संप्राप्य मणिकर्णिकाम् ।\nसप्तसप्त तथा सप्त पूर्वजास्तेन तारिताः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004085033, "chapter_id": 24085, "verse_number": "४-३४-३४", "content_sanskrit": "आमध्याद्देवसरित आ हरिश्चंद्रमडपात् ।\nआ गंगा केशवादा च स्वर्द्वारान्मणिकर्णिका ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004085034, "chapter_id": 24085, "verse_number": "४-३४-३५", "content_sanskrit": "एतद्रजःकणतुलां त्रिलोक्यपि न गच्छति ।\nएतत्प्राप्त्यै प्रयतते त्रिलोकस्थोऽखिलो भवी ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004085035, "chapter_id": 24085, "verse_number": "४-३४-३६", "content_sanskrit": "कलावती चित्रपटीं पश्यंतीत्थं मुहुर्मुहुः ।\nज्ञानवापीं ददर्शाथ श्रीविश्वेश्वरदक्षिणे ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004085036, "chapter_id": 24085, "verse_number": "४-३४-३७", "content_sanskrit": "यदंबुसततं रक्षेद्दुर्वृत्ताद्दंडनायकः ।\nसंभ्रमो विभ्रमश्चासौ दत्त्वा भ्रातिं गरीयसीम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004085037, "chapter_id": 24085, "verse_number": "४-३४-३८", "content_sanskrit": "योष्टमूर्तिर्महादेवः पुराणे परिपठ्यते ।\nतस्यैषांबुमयी मूर्तिर्ज्ञानदा ज्ञानवापिका ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004085038, "chapter_id": 24085, "verse_number": "४-३४-३९", "content_sanskrit": "नेत्रयोरतिथीकृत्य ज्ञानवापी कलावती ।\nकदंबकुसुमाकारां बभार क्षणतस्तनुम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004085039, "chapter_id": 24085, "verse_number": "४-३४-४०", "content_sanskrit": "अंगानि वेपथुं प्रापुः स्विन्ना भालस्थली भृशम् ।\nहर्षवाष्पांबुकलिले जाते तस्या विलोचने ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004085040, "chapter_id": 24085, "verse_number": "४-३४-४१", "content_sanskrit": "तस्तंभ गात्रलतिका मुखवैवर्ण्यमाप च ।\nस्वरोथ गद्गदो जातो व्यभ्रंशत्तत्करात्पटी ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004085041, "chapter_id": 24085, "verse_number": "४-३४-४२", "content_sanskrit": "साक्षणं स्वं विसस्मार काहं क्वाहं न वेत्ति च ।\nसौषुप्तायां दशायां च परमात्मेव निश्चला ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004085042, "chapter_id": 24085, "verse_number": "४-३४-४३", "content_sanskrit": "अथ तत्परिचारिण्यस्त्वरमाणा इतस्ततः ।\nकिं किं किमेतदेतत्किं पृच्छंति स्म परस्परम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004085043, "chapter_id": 24085, "verse_number": "४-३४-४४", "content_sanskrit": "तदवस्थां समालोक्य तां ताश्चतुरचेतसः ।\nविज्ञाय सात्त्विकैर्भावैरिदमूचूः परस्परम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004085044, "chapter_id": 24085, "verse_number": "४-३४-४५", "content_sanskrit": "भवांतरे प्रेमपात्रमेतयैक्षितु किंचन ।\nचिरात्तेन च संगत्य सुखमूर्च्छामवाप ह ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004085045, "chapter_id": 24085, "verse_number": "४-३४-४६", "content_sanskrit": "अथनेत्थं कथमियमकांडात्पर्यमूमुहत् ।\nप्रेक्षमाणा रहश्चित्रपटीमति पटीयसीम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004085046, "chapter_id": 24085, "verse_number": "४-३४-४७", "content_sanskrit": "तन्मोहस्य निदानं ताःसम्यगेव विचार्य च ।\nउपचेरुर्महाशांतैरुपचारैरनाकुलम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004085047, "chapter_id": 24085, "verse_number": "४-३४-४८", "content_sanskrit": "काचित्तां वीजयांचक्रे कदलीतालवृंतकैः ।\nबिसिनीवलयैरन्या धन्यां तां पर्यभूषयत् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004085048, "chapter_id": 24085, "verse_number": "४-३४-४९", "content_sanskrit": "अमंदैश्चंदनरसैरभ्यषिंचदमुं परा ।\nअशोकपल्लवैरस्याः काचिच्छोकमनीनशत् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004085049, "chapter_id": 24085, "verse_number": "४-३४-५०", "content_sanskrit": "धारामंडपधारांबुसीकरैस्तत्तनूलताम् ।\nइष्टार्थविरहग्लानां सिंचयामास काचन ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004085050, "chapter_id": 24085, "verse_number": "४-३४-५१", "content_sanskrit": "जलार्द्रवाससा काचिदेतस्यास्तनुमावृणोत् ।\nकर्पूरक्षोदजालेपैरन्यास्तामन्वलेपयन् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004085051, "chapter_id": 24085, "verse_number": "४-३४-५२", "content_sanskrit": "पद्मिनीदलशय्या च काचित्यरचयन्मृदुम् ।\nकाचित्कुलिशनेपथ्यं दूरीकृत्य तदंगतः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004085052, "chapter_id": 24085, "verse_number": "४-३४-५३", "content_sanskrit": "मुक्ताकलापं रचयांचक्रे वक्षोजमंडले ।\nकाचिच्छशिमुखी तां तु चंद्रकांतशिलातले ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004085053, "chapter_id": 24085, "verse_number": "४-३४-५४", "content_sanskrit": "स्वापयामास तन्वंगीं स्रवच्छीतांबुशीतले ।\nदृष्ट्वोपचार्यमाणां तामित्थं बुद्धिशरीरिणी ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004085054, "chapter_id": 24085, "verse_number": "४-३४-५५", "content_sanskrit": "अतितापपरीतांगी ताः सखीः प्रत्यभाषत ।\nएतस्यास्तापशांत्यर्थं जानेहं परमौषधम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004085055, "chapter_id": 24085, "verse_number": "४-३४-५६", "content_sanskrit": "उपचारानिमान्सवार्न्दूरी कुरुत मा चिरम् ।\nअपतापां करोम्येनां सद्यः पश्यत कौतुकम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004085056, "chapter_id": 24085, "verse_number": "४-३४-५७", "content_sanskrit": "दृष्ट्वा चित्रपटीमेषा सद्यो विह्वलतामगात् ।\nअत्रैव काचिदेतस्याः प्रेमभूरस्ति निश्चितम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004085057, "chapter_id": 24085, "verse_number": "४-३४-५८", "content_sanskrit": "अतश्चित्रपटीस्पर्शात्परितापं विहास्यति ।\nवाक्याद्बुद्धिशरीरिण्यास्ततस्तत्परिचारिकाः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004085058, "chapter_id": 24085, "verse_number": "४-३४-५९", "content_sanskrit": "निधाय तत्पुरः प्रोचुः पटीं पश्य कलावति ।\nतवानंदकरी यत्र काचिदस्तीष्टदेवता ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004085059, "chapter_id": 24085, "verse_number": "४-३४-६०", "content_sanskrit": "सापीष्टदेवतानाम्ना तत्पटीदर्शनेन च ।\nसुधासेकमिव प्राप्य मूर्छां हित्वोत्थिता द्रुतम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004085060, "chapter_id": 24085, "verse_number": "४-३४-६१", "content_sanskrit": "अवग्रहपरिम्लाना वर्षासारैरिवौषधीः ।\nपुनरालोकयांचक्रे ज्ञानदां ज्ञानवापिकाम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004085061, "chapter_id": 24085, "verse_number": "४-३४-६२", "content_sanskrit": "स्पृष्ट्वा कलावती तां तु वापीं चित्रगतामपि ।\nलेभे भवांतरज्ञानं यथासीत्पूर्वर्जन्मनि ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004085062, "chapter_id": 24085, "verse_number": "४-३४-६३", "content_sanskrit": "पुनर्विचारयांचक्रे वापी माहात्म्यमुत्तमम् ।\nअहो चित्रगतापीयं संस्पृष्टा ज्ञानवापिका ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004085063, "chapter_id": 24085, "verse_number": "४-३४-६४", "content_sanskrit": "ज्ञानं मे जनयामास भवांतर समुद्भवम् ।\nअथ तासां पुरो हृष्टा कथयामास सुंदरी ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004085064, "chapter_id": 24085, "verse_number": "४-३४-६५", "content_sanskrit": "निजं प्राग्भव वृत्तांतं ज्ञानवापीप्रभावजम् ।\nकलावत्युवाच ।\nएतस्माज्जन्मनः पूर्वमहं ब्राह्मणकन्यका ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004085065, "chapter_id": 24085, "verse_number": "४-३४-६६", "content_sanskrit": "उपविश्वेश्वरं काश्यां ज्ञानवाप्यां रमे मुदा ।\nजनको मे हरिस्वामी जनयित्री प्रियंवदा ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004085066, "chapter_id": 24085, "verse_number": "४-३४-६७", "content_sanskrit": "आख्या मम सुशीलेति मां च विद्याधरोऽहरत् ।\nमध्येमार्गं निशीथेथ तदोप मलयाचलम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004085067, "chapter_id": 24085, "verse_number": "४-३४-६८", "content_sanskrit": "रक्षसा सहतो वीरो राक्षसं स जघानह ।\nरक्षोपि मुक्तं शापात्तु दिव्यवपुरवाप ह ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004085068, "chapter_id": 24085, "verse_number": "४-३४-६९", "content_sanskrit": "अवाप जन्मगंधर्वस्त्वसौ मलयकेतुतः ।\nकर्णाटनृपतेः कन्या बभूवाहं कलावती ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004085069, "chapter_id": 24085, "verse_number": "४-३४-७०", "content_sanskrit": "इति ज्ञानं ममोद्भूतं ज्ञानवापीक्षणात्क्षणात् ।\nइति तस्या वचः श्रुत्वा सापि बुद्धिशरीरिणी ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004085070, "chapter_id": 24085, "verse_number": "४-३४-७१", "content_sanskrit": "ताश्च तत्परिचारिण्यः प्रहृष्टास्यास्तदाऽभवन् ।\nप्रोचुस्तां प्रणिपत्याथ पुण्यशीलां कलावतीम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004085071, "chapter_id": 24085, "verse_number": "४-३४-७२", "content_sanskrit": "अहो कथं हि सा लभ्या यत्प्रभावोयमीदृशः ।\nधिग्जन्म तेषां मर्त्येऽस्मिन्यैर्नैक्षि ज्ञानवापिका ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004085072, "chapter_id": 24085, "verse_number": "४-३४-७३", "content_sanskrit": "कलावति नमस्तुभ्यं कुरुनोपि समीहितम् ।\nजनिं सफलयास्माकं नय नः प्रार्थ्य भूपतिम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004085073, "chapter_id": 24085, "verse_number": "४-३४-७४", "content_sanskrit": "अयं च नियमोस्माकमद्यारभ्य कलावति ।\nनिर्वेक्ष्यामो महाभोगान्दृष्ट्वा तां ज्ञानवापिकाम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004085074, "chapter_id": 24085, "verse_number": "४-३४-७५", "content_sanskrit": "अवश्यं ज्ञानवापी सा नाम्ना भवितुमर्हति ।\nचित्रं चित्रगतापीह या तव ज्ञानदायिनी ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004085075, "chapter_id": 24085, "verse_number": "४-३४-७६", "content_sanskrit": "ओंकृत्य तासां वाक्यं सा स्वाकारं परिगोप्य च ।\nप्रियाणि कृत्वा भूभर्तुः प्रस्तावज्ञा व्यजिज्ञपत् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004085076, "chapter_id": 24085, "verse_number": "४-३४-७७", "content_sanskrit": "कलावत्युवाच ।\nजीवितेश न मे त्वत्तः किंचित्प्रियतरं क्वचित् ।\nत्वामासाद्य पतिं राजन्प्राप्ताः सर्वे मनोरथाः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004085077, "chapter_id": 24085, "verse_number": "४-३४-७८", "content_sanskrit": "एको मनोरथः प्रार्थ्यो ममास्त्यत्रार्यपुत्रक ।\nविचारपथमापन्नस्तवापि स महाहितः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004085078, "chapter_id": 24085, "verse_number": "४-३४-७९", "content_sanskrit": "मम तु त्वदधीनायाः सुदुष्प्रापतरो महान् ।\nतव स्वाधीनवृत्तेस्तु सिद्धप्रायो मनोरथः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004085079, "chapter_id": 24085, "verse_number": "४-३४-८०", "content_sanskrit": "प्राणेश किं बहूक्तेन यदि प्राणैः प्रयोजनम् ।\nतदाभिलषितं देहि प्राणा यास्यंत्यथान्यथा ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004085080, "chapter_id": 24085, "verse_number": "४-३४-८१", "content_sanskrit": "प्राणेभ्योपि गरीयस्यास्तस्या वाक्यं निशम्य सः ।\nउवाच वचनं राजा तस्याः स्वस्यापि च प्रियम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004085081, "chapter_id": 24085, "verse_number": "४-३४-८२", "content_sanskrit": "राजोवाच ।\nनाहं प्रिये तवादेयमिह पश्यामि भामिनि ।\nप्राणा अपि मम क्रीतास्त्वया शीलकलागुणैः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004085082, "chapter_id": 24085, "verse_number": "४-३४-८३", "content_sanskrit": "अविलंबितमाचक्ष्व कृतं विद्धि कलावति ।\nभवद्विधानां साध्वीनामन्येऽप्राप्यं न किंचन ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004085083, "chapter_id": 24085, "verse_number": "४-३४-८४", "content_sanskrit": "कः प्रार्थ्यः प्रार्थनीयं किं को वा प्रार्थयिता प्रिये ।\nन पृथग्जनवत्किंचिद्वर्तनं नौ कलावति ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004085084, "chapter_id": 24085, "verse_number": "४-३४-८५", "content_sanskrit": "देशः कोशो बलं दुर्गं यदन्यदपि भामिनि ।\nतत्त्वदीयं न मे किंचित्स्वाम्यमात्रमिहास्ति मे ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004085085, "chapter_id": 24085, "verse_number": "४-३४-८६", "content_sanskrit": "तच्च स्वाम्यं ममान्यत्र त्वदृते जीवितेश्वरि ।\nराज्यं त्यजेयं त्वद्वाक्यात्तृणीकृत्यापि मानिनि ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004085086, "chapter_id": 24085, "verse_number": "४-३४-८७", "content_sanskrit": "माल्पकेतोर्महीजानेरिति वाक्यं निशम्य सा ।\nप्राह गंभीरया वाचा वचश्चारु कलावती ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004085087, "chapter_id": 24085, "verse_number": "४-३४-८८", "content_sanskrit": "कलावत्युवाच ।\nनाथ प्रजासृजापूर्वं सृष्टा नानाविधाः प्रजाः ।\nप्रजाहिताय संसृष्टं पुरुषार्थचतुष्टयम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004085088, "chapter_id": 24085, "verse_number": "४-३४-८९", "content_sanskrit": "तद्विहीनाजनिरपि जल बुद्बुदवन्मुधा ।\nतस्मादेकोपि संसाध्यः परत्रेह च शर्मणे ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004085089, "chapter_id": 24085, "verse_number": "४-३४-९०", "content_sanskrit": "यत्रानुकूल्यं दंपत्योस्त्रिवर्गस्तत्र वर्धते ।\nयदुच्यते पुराविद्भिरिति तत्तथ्यमीक्षितम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004085090, "chapter_id": 24085, "verse_number": "४-३४-९१", "content_sanskrit": "मद्विधाना तु दासीनां शतं तेऽस्तीह मंदिरे ।\nतथापि नितरां प्रेम स्वामिनो मयि दृश्यते ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004085091, "chapter_id": 24085, "verse_number": "४-३४-९२", "content_sanskrit": "तव दास्यपि भोगाढ्या किमुतांकस्थलीचरी ।\nतत्राप्यनन्यसंपत्तिस्तत्र स्वाधीनभर्तृता ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004085092, "chapter_id": 24085, "verse_number": "४-३४-९३", "content_sanskrit": "विपश्चित्संचयेदर्थानिष्टापूर्ताय कर्मणे ।\nतपोर्थमायुर्निर्विघ्नं दारांश्चापत्यलब्धये ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004085093, "chapter_id": 24085, "verse_number": "४-३४-९४", "content_sanskrit": "तवैतत्सर्वमस्तीह विश्वेशानुग्रहात्प्रिय ।\nपूरणीयोऽभिलाषो मे यदि तद्वचम्यहं शृणु ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004085094, "chapter_id": 24085, "verse_number": "४-३४-९५", "content_sanskrit": "तूर्णं प्रहिणु मां नाथ विश्वनाथपुरीं प्रति ।\nप्राणाः प्रयाता प्रागेव वपुः शेषास्मि केवलम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004085095, "chapter_id": 24085, "verse_number": "४-३४-९६", "content_sanskrit": "माल्यकेतुः कलावत्या इत्याकर्ण्य वचः स्फुटम् ।\nक्षणं विचार्य स्वहृदि राजा प्रोवाच तां प्रियाम् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004085096, "chapter_id": 24085, "verse_number": "४-३४-९७", "content_sanskrit": "प्रिये कलावति यदि तव गंतव्यमेव हि ।\nराज्यलक्ष्म्यानया किं मे चलया त्वद्विहीनया ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004085097, "chapter_id": 24085, "verse_number": "४-३४-९८", "content_sanskrit": "न राज्यं राज्यमित्याहू राज्यश्रीः प्रेयसी ध्रुवम् ।\nसप्तांगमपि तद्राज्यं तया हीनं तृणायते ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004085098, "chapter_id": 24085, "verse_number": "४-३४-९९", "content_sanskrit": "निःसपत्नं कृतं राज्यं भुक्त्वा भोगान्निरंतरम् ।\nहृषीकार्थाः कृतार्थाश्च विधृता आधृतिः प्रिये ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004085099, "chapter_id": 24085, "verse_number": "४-३४-१००", "content_sanskrit": "अपत्यान्यपि जातानि किं कर्तव्यमिहास्ति मे ।\nअवश्यमेव गंतव्याऽवाभ्यां वाराणसी पुरी ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004085100, "chapter_id": 24085, "verse_number": "४-३४-१०१", "content_sanskrit": "माल्यकेतुः प्रियामित्थमाश्वास्य कृतनिश्चयः ।\nसमाहूय च देवज्ञान्प्रकृतीः परिपूज्य च ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004085101, "chapter_id": 24085, "verse_number": "४-३४-१०२", "content_sanskrit": "पुत्रे राज्यं निधायाथ राजा काशीं प्रतस्थिवान् ।\nरत्नजातं कियदपि पुत्रादर्थं प्रगृह्य च ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004085102, "chapter_id": 24085, "verse_number": "४-३४-१०३", "content_sanskrit": "दृष्ट्वा विश्वेश्वरपुरीं हृष्टरोमा नरेश्वरः ।\nमेने कृतार्थमात्मानं संसारांबुधिपारगम् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7004085103, "chapter_id": 24085, "verse_number": "४-३४-१०४", "content_sanskrit": "प्राग्जन्मवासनायोगात्सापि राज्ञी कलावती ।\nग्रामांतरादागतेव पुरीमार्गानवैत्स्वयम ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7004085104, "chapter_id": 24085, "verse_number": "४-३४-१०५", "content_sanskrit": "मणिकर्ण्यामथस्नात्वा भूरि दत्त्वा ततो वसु ।\nविश्वेशमर्चयित्वाथ रत्नजातैरनेकशः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7004085105, "chapter_id": 24085, "verse_number": "४-३४-१०६", "content_sanskrit": "दत्त्वा तत्रापि रत्नानि गजानश्वान्गवां व्रजम् ।\nदुकूलानि विचित्राणि पूजोपकरणानि च ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7004085106, "chapter_id": 24085, "verse_number": "४-३४-१०७", "content_sanskrit": "सुवर्णरूप्यकलशान्दीपी दर्पण चामरान् ।\nध्वजस्तंभ पताकाश्च विचित्रोल्लोचकानि च ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7004085107, "chapter_id": 24085, "verse_number": "४-३४-१०८", "content_sanskrit": "अथ प्रदक्षिणीकृत्य मुक्तिमंडपमाविशत् ।\nतत्र धर्मकथां श्रुत्वा दत्त्वा तत्रापि सद्धनम् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7004085108, "chapter_id": 24085, "verse_number": "४-३४-१०९", "content_sanskrit": "सायंतनीं महापूजां पुनः कृत्वा क्षितीश्वरः ।\nतत्र जागरणं कृत्वा तौर्यत्रिक महोत्सवैः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7004085109, "chapter_id": 24085, "verse_number": "४-३४-११०", "content_sanskrit": "अथ प्रातः समुत्थाय कृत्वा शौचाचमक्रियाम् ।\nराज्ञ्या विनिर्दिष्टपथा ज्ञानवापीं नृपो ययौ ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7004085110, "chapter_id": 24085, "verse_number": "४-३४-१११", "content_sanskrit": "नृपः सार्धं कलावत्या तत्र सस्नौ प्रहृष्टवत् ।\nअथ पिंडान्सनिर्वाप्य संतर्प्य श्रद्धया पितॄन् ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7004085111, "chapter_id": 24085, "verse_number": "४-३४-११२", "content_sanskrit": "तत्र रूप्य सुवर्णादि पात्रेभ्यः प्रतिपाद्य च ।\nदीनांध कृपणानाथान्महार्है रत्नजातकैः ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7004085112, "chapter_id": 24085, "verse_number": "४-३४-११३", "content_sanskrit": "प्रीणयित्वा नरपतिः पारणां कृतवांस्ततः ।\nसंस्कार्य रत्नसोपानैर्ज्ञानवापी कलावती ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7004085113, "chapter_id": 24085, "verse_number": "४-३४-११४", "content_sanskrit": "आबबंध रतिं तत्र सह भर्त्रा तपस्विनी ।\nएकांतरोपवासैश्च कदाचिच्च त्र्यहोव्रतैः ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7004085114, "chapter_id": 24085, "verse_number": "४-३४-११५", "content_sanskrit": "षडहोभोजनैश्चापि पक्षार्धनियमैरथ ।\nपक्षांतरोपवासैश्च मासोपवसनादिभिः ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7004085115, "chapter_id": 24085, "verse_number": "४-३४-११६", "content_sanskrit": "चांद्रायणव्रतैः कृच्छ्रैर्भर्तुः शुश्रूषणैरपि ।\nनिनाय क्षणवत्कालमायुःशेषस्य सानघा ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7004085116, "chapter_id": 24085, "verse_number": "४-३४-११७", "content_sanskrit": "एकदा ज्ञानवाप्यां तु प्रातः स्नात्वोपविष्टयोः ।\nआगत्य जटिलः कश्चिद्विभूतिं दत्तवान्करे ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7004085117, "chapter_id": 24085, "verse_number": "४-३४-११८", "content_sanskrit": "उवाच च प्रसन्नास्य आशीर्भिरभिनद्य च ।\nउत्तिष्ठतं प्रकुरुतं महानेपथ्यमद्य वै ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7004085118, "chapter_id": 24085, "verse_number": "४-३४-११९", "content_sanskrit": "तारकोदय संप्राप्तिर्भवित्री वां क्षणादिह ।\nयावदित्थं समाचष्ट जटिलोऽग्रे तयोर्वचः ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7004085119, "chapter_id": 24085, "verse_number": "४-३४-१२०", "content_sanskrit": "तावद्विमानमापन्नं सक्वणत्किंकिणीगणम् ।\nपश्यतां सर्वलोकानां चन्द्रमौलिरथोरथात् ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7004085120, "chapter_id": 24085, "verse_number": "४-३४-१२१", "content_sanskrit": "उत्तीर्य तच्छ्रुतिपुटे किमपि स्वयमादिशत् ।\nअनाख्यं यत्परंज्योतिरुच्चक्राम च तत्क्षणात् ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7004085121, "chapter_id": 24085, "verse_number": "४-३४-१२२", "content_sanskrit": "उद्योतयन्नभोवर्त्म देवोपि स्वालयं ययौ ।\nस्कन्द उवाच ।\nतदा प्रभृति लोकेऽत्र ज्ञानवापी विशिष्यते ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7004085122, "chapter_id": 24085, "verse_number": "४-३४-१२३", "content_sanskrit": "सर्वेभ्यस्तीर्थर्मुख्येभ्यः प्रत्यक्ष ज्ञानदा मुने ।\nसर्वज्ञानमयी चैषा सर्वलिंगमयी शुभा ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7004085123, "chapter_id": 24085, "verse_number": "४-३४-१२४", "content_sanskrit": "साक्षाच्छिवमयी मूर्तिर्ज्ञानकृज्ज्ञानवापिका ।\nसन्ति तीर्थान्यनेकानि सद्यः शुचिकराण्यपि ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7004085124, "chapter_id": 24085, "verse_number": "४-३४-१२५", "content_sanskrit": "परंतु ज्ञानवाप्या हि कलां नार्हंति षोडशीम् ।\nज्ञानवाप्याः समुत्पत्तिं यः श्रोष्यति समाहितः ।\nन तस्य ज्ञानविभ्रंशो मरणे जायते क्वचित् ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7004085125, "chapter_id": 24085, "verse_number": "४-३४-१२६", "content_sanskrit": "महाख्यानमिदं पुण्यं महापातकनाशनम् ।\nमहादेवस्य गौर्याश्च महाप्रीतिविवर्धनम् ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7004085126, "chapter_id": 24085, "verse_number": "४-३४-१२७", "content_sanskrit": "पठित्वा पाठयित्वा वा श्रुत्वा वा श्रद्धयान्वितः ।\nज्ञानवाप्याः शुभाख्यानं शिवलोके महीयते ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}]