[{"id": 7003983000, "chapter_id": 23983, "verse_number": "३-१-४६-१", "content_sanskrit": "श्रीराम उवाच ।\nपंपारण्ये वयं दीनास्त्वया वानरपुंगव ।\nआश्वासिताः कारयित्वा सख्यमादित्यसूनुना॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003983001, "chapter_id": 23983, "verse_number": "३-१-४६-२", "content_sanskrit": "त्वां दृष्ट्वा पितरं बन्धून्कौसल्यां जननीमपि ।\nन स्मरामो वयं सर्वान्मे त्वयोपकृतं बहु॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003983002, "chapter_id": 23983, "verse_number": "३-१-४६-३", "content_sanskrit": "मदर्थं सागरस्तीर्णो भवता बहु योजनः ।\nतलप्रहाराभिहतो मैनाकोऽपि नगोत्तमः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003983003, "chapter_id": 23983, "verse_number": "३-१-४६-४", "content_sanskrit": "नागमाता च सुरसा मदर्थं भवता जिता ।\nछायाग्रहां महाक्रूराम वधीद्राक्षसीं भवान्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003983004, "chapter_id": 23983, "verse_number": "३-१-४६-५", "content_sanskrit": "सायं सुवेलमासाद्य लंकामाहत्य पाणिना ।\nअयासी रावणगृहं मदर्थं त्वं महाकपे॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003983005, "chapter_id": 23983, "verse_number": "३-१-४६-६", "content_sanskrit": "सीतामन्विष्य लंकायां रात्रौ गतभयो भवान् ।\nअदृष्ट्वा जानकीं पश्चादशोकवनिकां ययौ॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003983006, "chapter_id": 23983, "verse_number": "३-१-४६-७", "content_sanskrit": "नमस्कृत्य च वैदेहीमभिज्ञानं प्रदाय च ।\nचूडामणिं समादाय मदर्थं जानकीकरात्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003983007, "chapter_id": 23983, "verse_number": "३-१-४६-८", "content_sanskrit": "अशोकवनिकावृक्षानभांक्षीस्त्वं महाकपे ।\nततस्त्वशीतिसाहस्रान्किंकरान्नाम राक्षसान्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003983008, "chapter_id": 23983, "verse_number": "३-१-४६-९", "content_sanskrit": "रावणप्रतिमान्युद्धे पत्यश्वेभरथाकुलान् ।\nअवधीस्त्वं मदर्थे वै महाबलपराक्रमान्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003983009, "chapter_id": 23983, "verse_number": "३-१-४६-१०", "content_sanskrit": "ततः प्रहस्ततनयं जंबुमालिनमागतम् ।\nअवधीन्मंत्रितनयान्सप्त सप्तार्चिवर्चसः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003983010, "chapter_id": 23983, "verse_number": "३-१-४६-११", "content_sanskrit": "पंच सेनापतीन्पश्चादनयस्त्वं यमालयम् ।\nकुमारमक्षमवधीस्ततस्त्वं रणमूर्धनि॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003983011, "chapter_id": 23983, "verse_number": "३-१-४६-१२", "content_sanskrit": "तत इन्द्रजिता नीतो राक्षसेंद्र सभां शुभाम् ।\nतत्र लंकेश्वरं वाचा तृणीकृत्यावमन्य च॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003983012, "chapter_id": 23983, "verse_number": "३-१-४६-१३", "content_sanskrit": "अभांक्षीस्त्वं पुरीं लंकां मदर्थं वायुनंदन ।\nपुनः प्रतिनिवृत्तस्त्वमृष्यमूकं महागिरिम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003983013, "chapter_id": 23983, "verse_number": "३-१-४६-१४", "content_sanskrit": "एवमादि महादुःखं मदर्थं प्राप्तवानसि ।\nत्वमत्र भूतले शेषे मम शोकमुदीरयन्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003983014, "chapter_id": 23983, "verse_number": "३-१-४६-१५", "content_sanskrit": "अहं प्राणान्परित्यक्ष्ये मृतोऽसि यदि वायुज ।\nसीतया मम किं कार्यं लक्ष्मणेनानुजेन वा॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003983015, "chapter_id": 23983, "verse_number": "३-१-४६-१६", "content_sanskrit": "भरतेनापि किं कार्यं शत्रुघ्नेन श्रियापि वा ।\nराज्येनापि न मे कार्यं परेतस्त्वं कपे यदि॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003983016, "chapter_id": 23983, "verse_number": "३-१-४६-१७", "content_sanskrit": "उत्तिष्ठ हनुमन्वत्स किं शेषेऽद्य महीतले ।\nशय्यां कुरु महाबाहो निद्रार्थं मम वानर॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003983017, "chapter_id": 23983, "verse_number": "३-१-४६-१८", "content_sanskrit": "कन्दमूलफलानि त्वमाहारार्थं ममाहर ।\nस्नातुमद्य गमिष्यामि शीघ्रं कलशमानय॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003983018, "chapter_id": 23983, "verse_number": "३-१-४६-१९", "content_sanskrit": "अजिनानि च वासांसि दर्भांश्च समुपाहर ।\nब्रह्मास्त्रेणावबद्धोऽहं मोचितश्च त्वया हरे॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003983019, "chapter_id": 23983, "verse_number": "३-१-४६-२०", "content_sanskrit": "लक्ष्मणेन सह भ्रात्रा ह्यौषधानयनेन वै ।\nलक्ष्मणप्राणदाता त्वं पौलस्त्यमदनाशनः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003983020, "chapter_id": 23983, "verse_number": "३-१-४६-२१", "content_sanskrit": "सहायेन त्वया युद्धे राक्षसा न्रावणादिकान् ।\nनिहत्यातिबलान्वीरानवापं मैथिलीमहम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003983021, "chapter_id": 23983, "verse_number": "३-१-४६-२२", "content_sanskrit": "हनूमन्नंजनासूनो सीताशोकविनाशन ।\nकथमेवं परित्यज्य लक्ष्मणं मां च जानकीम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003983022, "chapter_id": 23983, "verse_number": "३-१-४६-२३", "content_sanskrit": "अप्रापयित्वायोध्यां त्वं किमर्थं गतवानसि ।\nक्व गतोसि महावीर महाराक्षसकण्टक॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003983023, "chapter_id": 23983, "verse_number": "३-१-४६-२४", "content_sanskrit": "इति पश्यन्मुखं तस्य निर्वाक्यं रघुनंदनः ।\nप्ररुदन्नश्रुजालेन सेचयामास वायुजम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003983024, "chapter_id": 23983, "verse_number": "३-१-४६-२५", "content_sanskrit": "वायुपुत्रस्ततो मूर्च्छामपहाय शनैर्द्विजाः ।\nपौलस्त्यभयसंत्रस्तलोकरक्षार्थमागतम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003983025, "chapter_id": 23983, "verse_number": "३-१-४६-२६", "content_sanskrit": "आश्रित्य मानुषं भावं नारायणमजं विभुम् ।\nजानकीलक्ष्मणयुतं कपिभिः परिवारितम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003983026, "chapter_id": 23983, "verse_number": "३-१-४६-२७", "content_sanskrit": "कालांभोधरसंकाशं रणधूलिसमुक्षितम् ।\nजटामण्डलशोभाढ्यं पुण्डरीकायतेक्षणम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003983027, "chapter_id": 23983, "verse_number": "३-१-४६-२८", "content_sanskrit": "खिन्नं च बहुशो युद्धे ददर्श रघुनंदनम् ।\nस्तूयमानममित्रघ्नं देवर्षिपितृकिन्नरैः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003983028, "chapter_id": 23983, "verse_number": "३-१-४६-२९", "content_sanskrit": "दृष्ट्वा दाशरथिं रामं कृपाबहुलचेतसम् ।\nरघुनाथकरस्पर्शपूर्णगात्रः स वानरः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003983029, "chapter_id": 23983, "verse_number": "३-१-४६-३०", "content_sanskrit": "पतित्वा दण्डवद्भूमौ कृतांजलिपुटो द्विजाः ।\nअस्तौषीज्जानकीनाथं स्तोत्रैः श्रुतिमनोहरैः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003983030, "chapter_id": 23983, "verse_number": "३-१-४६-३१", "content_sanskrit": "हनूमानुवाच ।\nनमो रामाय हरये विष्णवे प्रभविष्णवे ।\nआदिदेवाय देवाय पुराणाय गदाभृते॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003983031, "chapter_id": 23983, "verse_number": "३-१-४६-३२", "content_sanskrit": "विष्टरे पुष्पकं नित्यं निविष्टाय महात्मने ।\nप्रहृष्टवानरानीकजुष्टपादांबुजाय ते॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003983032, "chapter_id": 23983, "verse_number": "३-१-४६-३३", "content_sanskrit": "निष्पिष्ट राक्षसेंद्राय जगदिष्टविधायिने ।\nनमः सहस्रशिरसे सहस्रचरणाय च॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003983033, "chapter_id": 23983, "verse_number": "३-१-४६-३४", "content_sanskrit": "सहस्राक्षाय शुद्धाय राघवाय च विष्णवे ।\nभक्तार्तिहारिणे तुभ्यं सीतायाः पतये नमः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003983034, "chapter_id": 23983, "verse_number": "३-१-४६-३५", "content_sanskrit": "हरये नारसिंहाय दैत्यराजविदारिणे ।\nनमस्तुभ्यं वराहाय दंष्ट्रोद्धृतवसुन्धर॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003983035, "chapter_id": 23983, "verse_number": "३-१-४६-३६", "content_sanskrit": "त्रिविक्रमाय भवते बलियज्ञ विभेदिने ।\nनमो वामनरूपाय नमो मंदरधारिणे॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003983036, "chapter_id": 23983, "verse_number": "३-१-४६-३७", "content_sanskrit": "नमस्ते मत्स्यरूपाय त्रयीपालनकारिणे ।\nनमः परशुरामाय क्षत्रियांतकराय ते॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003983037, "chapter_id": 23983, "verse_number": "३-१-४६-३८", "content_sanskrit": "नमस्ते राक्षसघ्नाय नमो राघवरूपिणे ।\nमहादेव महाभीम महाकोदण्डभेदिने॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003983038, "chapter_id": 23983, "verse_number": "३-१-४६-३९", "content_sanskrit": "क्षत्रियांतकरक्रूरभार्गवत्रासकारिणे ।\nनमोऽस्त्वहिल्या संतापहारिणे चापहारिणे॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003983039, "chapter_id": 23983, "verse_number": "३-१-४६-४०", "content_sanskrit": "नागायुतवलोपेतताटकादेहहारिणे ।\nशिलाकठिनविस्तारवालिवक्षोविभेदिने॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003983040, "chapter_id": 23983, "verse_number": "३-१-४६-४१", "content_sanskrit": "नमो माया मृगोन्माथकारिणेऽज्ञानहारिणे ।\nदशस्यंदनदुःखाब्धिशोषणागस्त्यरूपिणे॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003983041, "chapter_id": 23983, "verse_number": "३-१-४६-४२", "content_sanskrit": "अनेकोर्मिसमाधूतसमुद्रमदहारिणे ।\nमैथिलीमानसां भोजभानवे लोकसाक्षिणे॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003983042, "chapter_id": 23983, "verse_number": "३-१-४६-४३", "content_sanskrit": "राजेंद्राय नमस्तुभ्यं जानकीपतये हरे ।\nतारकब्रह्मणे तुभ्यं नमो राजीवलोचन॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003983043, "chapter_id": 23983, "verse_number": "३-१-४६-४४", "content_sanskrit": "रामाय रामचन्द्राय वरेण्याय सुखात्मने ।\nविश्वामित्रप्रियायेदं नमः खरविदारिणे॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003983044, "chapter_id": 23983, "verse_number": "३-१-४६-४५", "content_sanskrit": "प्रसीद देवदेवेश भक्तानामभयप्रद ।\nरक्ष मां करु णासिंधो रामचन्द्र नमोऽस्तु ते॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003983045, "chapter_id": 23983, "verse_number": "३-१-४६-४६", "content_sanskrit": "रक्ष मां वेदवचसामप्यगोचर राघव ।\nपाहि मां कृपया राम शरणं त्वामुपैम्यहम्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003983046, "chapter_id": 23983, "verse_number": "३-१-४६-४७", "content_sanskrit": "रघुवीर महामोहमपाकुरु ममाधुना ।\nस्नाने चाचमने भुक्तो जाग्रत्स्वप्नसुषुप्तिषु॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003983047, "chapter_id": 23983, "verse_number": "३-१-४६-४८", "content_sanskrit": "सर्वावस्थासु सर्वत्र पाहि मां रघुनंदन ।\nमहिमानं तव स्तोतुं कः समर्थो जगत्त्रये॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003983048, "chapter_id": 23983, "verse_number": "३-१-४६-४९", "content_sanskrit": "त्वमेव त्वन्महत्त्वं वै जानासि रघुनंदन ।\nइति स्तुत्वा वायुपुत्रो रामचंद्रं घृणानिधिम्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003983049, "chapter_id": 23983, "verse_number": "३-१-४६-५०", "content_sanskrit": "सीतामप्यभितुष्टाव भक्तियुक्तेन चेतसा ।\nजानकि त्वां नमस्यामि सर्वपापप्रणाशिनीम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003983050, "chapter_id": 23983, "verse_number": "३-१-४६-५१", "content_sanskrit": "दारिद्र्यरणसंहर्त्रीं भक्तानामिष्टदायिनीम् ।\nविदेहराजतनयां राघवानंदकारिणीम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003983051, "chapter_id": 23983, "verse_number": "३-१-४६-५२", "content_sanskrit": "भूमेर्दुहितरं विद्यां नमामि प्रकृतिं शिवाम् ।\nपौलस्त्यैश्वर्यसंहर्त्रीं भक्ताभीष्टां सरस्वतीम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003983052, "chapter_id": 23983, "verse_number": "३-१-४६-५३", "content_sanskrit": "पतिव्रताधुरीणां त्वां नमामि जनकात्मजाम् ।\nअनुग्रहपरामृद्धिमनघां हरिवल्लभाम्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003983053, "chapter_id": 23983, "verse_number": "३-१-४६-५४", "content_sanskrit": "आत्मविद्यां त्रयीरूपामुमारूपां नमाम्य हम् ।\nप्रसादाभिमुखीं लक्ष्मीं क्षीराब्धितनयां शुभाम्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003983054, "chapter_id": 23983, "verse_number": "३-१-४६-५५", "content_sanskrit": "नमामि चन्द्रभगिनीं सीतां सर्वांगसुंदरीम् ।\nनमामि धर्मनिलयां करुणां वेदमातरम्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003983055, "chapter_id": 23983, "verse_number": "३-१-४६-५६", "content_sanskrit": "पद्मालयां पद्महस्तां विष्णुवक्षस्थलालयाम् ।\nनमामि चन्द्रनिलयां सीतां चन्द्रनिभाननाम्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003983056, "chapter_id": 23983, "verse_number": "३-१-४६-५७", "content_sanskrit": "आह्लादरूपिणीं सिद्धिं शिवां शिवकरीं सतीम् ।\nनमामि विश्वजननीं रामचन्द्रेष्टवल्लभाम् ।\nसीतां सर्वानवद्यांगीं भजामि सततं हृदा॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003983057, "chapter_id": 23983, "verse_number": "३-१-४६-५८", "content_sanskrit": "श्रीसूत उवाच ।\nस्तुत्वैवं हनुमान्सीतारामचन्द्रौ सभक्तिकम्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003983058, "chapter_id": 23983, "verse_number": "३-१-४६-५९", "content_sanskrit": "आनंदाश्रुपरिक्लिन्नस्तूष्णीमास्ते द्विजोत्तमाः ।\nय इदं वायुपुत्रेण कथितं पापनाशनम्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003983059, "chapter_id": 23983, "verse_number": "३-१-४६-६०", "content_sanskrit": "स्तोत्रं श्रीरामचंद्रस्य सीतायाः पठतेऽन्वहम् ।\nस नरो महदैश्वर्यमश्नुते वांछितं स दा॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003983060, "chapter_id": 23983, "verse_number": "३-१-४६-६१", "content_sanskrit": "अनेकक्षेत्रधान्यानि गाश्च दोग्ध्रीः पयस्विनीः ।\nआयुर्विद्याश्च पुत्रांश्च भार्यामपि मनोरमाम्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003983061, "chapter_id": 23983, "verse_number": "३-१-४६-६२", "content_sanskrit": "एतत्स्तोत्रं सकृ द्विप्राः पठन्नाप्नोत्यसंशयः ।\nएतत्स्तोत्रस्य पाठेन नरकं नैव यास्यति॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003983062, "chapter_id": 23983, "verse_number": "३-१-४६-६३", "content_sanskrit": "ब्रह्महत्यादिपापानि नश्यंति सुमहांत्यपि ।\nसर्वपापविनिर्मुक्तो देहांते मुक्तिमाप्नुयात्॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003983063, "chapter_id": 23983, "verse_number": "३-१-४६-६४", "content_sanskrit": "इति स्तुतो जगन्नाथो वायुपुत्रेण राघवः ।\nसीतया सहितो विप्रा हनूमंतमथाब्रवीत्॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003983064, "chapter_id": 23983, "verse_number": "३-१-४६-६५", "content_sanskrit": "श्रीराम उवाच ।\nअज्ञानाद्वा नरश्रेष्ठ त्वयेदं साहसं कृतम् ।\nब्रह्मणा विष्णुना वापि शक्रादित्रिदशैरपि॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003983065, "chapter_id": 23983, "verse_number": "३-१-४६-६६", "content_sanskrit": "नेदं लिंगं समुद्धर्तुं शक्यते स्थापितं मया ।\nमहादेवापराधेन पतितोऽस्यद्य मूर्च्छितः॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003983066, "chapter_id": 23983, "verse_number": "३-१-४६-६७", "content_sanskrit": "इतः परं मा क्रियतां द्रोहः सांबस्य शूलिनः ।\nअद्यारभ्य त्विदं कुंडं तव नाम्ना जगत्त्रये॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003983067, "chapter_id": 23983, "verse_number": "३-१-४६-६८", "content_sanskrit": "ख्यातिं प्रयातु यत्र त्वं पतितो वानरोत्तम ।\nमहापातकसंघानां नाशः स्यादत्र मज्जनात्॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003983068, "chapter_id": 23983, "verse_number": "३-१-४६-६९", "content_sanskrit": "महादेवजटाजाता गौतमी सरितां वरा ।\nअश्वमेधसहस्रस्य फलदा स्नायिनां नृणाम्॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003983069, "chapter_id": 23983, "verse_number": "३-१-४६-७०", "content_sanskrit": "ततः शतगुणा गंगा यमुना च सरस्वती ।\nएतन्नदीत्रयं यत्र स्थले प्रवहते कपे॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003983070, "chapter_id": 23983, "verse_number": "३-१-४६-७१", "content_sanskrit": "मिलित्वा तत्र तु स्नानं सहस्रगुणितं स्मृतम् ।\nनदीष्वेतासु यत्स्नानात्फलं पुंसां भवेत्कपे॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003983071, "chapter_id": 23983, "verse_number": "३-१-४६-७२", "content_sanskrit": "तत्फलं तव कुंडेऽस्मिन्स्नानात्प्राप्नोत्यसंशयम् ।\nदुर्लभं प्राप्य मानुष्यं हनूमत्कुंडतीरतः॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003983072, "chapter_id": 23983, "verse_number": "३-१-४६-७३", "content_sanskrit": "श्राद्धं न कुरुते यस्तु भक्तियुक्तेन चेतसा ।\nनिराशास्तस्य पितरः प्रयांति कुपिताः कपे॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003983073, "chapter_id": 23983, "verse_number": "३-१-४६-७४", "content_sanskrit": "कुप्यंति मुनयोऽप्यस्मै देवाः सेंद्राः सचारणाः ।\nन दत्तं न हुतं येन हनूमत्कुंडतीरतः॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003983074, "chapter_id": 23983, "verse_number": "३-१-४६-७५", "content_sanskrit": "वृथाजीवित एवासाविहामुत्र च दुःखभाक् ।\nहनूमत्कुंडसविधे येन दत्तं तिलोदकम् ।\nमोदंते पितरस्तस्य घृतकुल्याः पिबंति च॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003983075, "chapter_id": 23983, "verse_number": "३-१-४६-७६", "content_sanskrit": "श्रीसूत उवाच ।\nश्रुत्वैतद्वचनं विप्रा रामेणोक्तं स वायुजः॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003983076, "chapter_id": 23983, "verse_number": "३-१-४६-७७", "content_sanskrit": "उत्तरे रामनाथस्य लिंगं स्वेनाहृतं मुदा ।\nआज्ञया रामचन्द्रस्य स्थापयामास वायुजः॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003983077, "chapter_id": 23983, "verse_number": "३-१-४६-७८", "content_sanskrit": "प्रत्यक्षमेव सर्वेषां कपिलांगूलवेष्टितम् ।\nहरोपि तत्पुच्छजा तं बिभर्ति च वलित्रयम् ।\nतदुत्तरायां ककुभि गौरीं संस्थापयन्मुदा॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003983078, "chapter_id": 23983, "verse_number": "३-१-४६-७९", "content_sanskrit": "श्रीसूत उवाच ।\nएवं वः कथितं विप्रा यदर्थं राघवेण तु॥  ।\nलिंगं प्रतिष्ठितं सेतौ भुक्तिमुक्तिप्रदं नृणाम्॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003983079, "chapter_id": 23983, "verse_number": "३-१-४६-८०", "content_sanskrit": "यः पठेदिममध्यायं शृणुयाद्वा समाहितः ।\nस विधूयेह पापानि शिवलोके महीयते॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}]