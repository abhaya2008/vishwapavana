[{"id": 2040445, "chapter_id": 1896, "verse_number": "५-१४१-०x", "content_sanskrit": "कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2040446, "chapter_id": 1896, "verse_number": "५-१४१-१", "content_sanskrit": "असंशयं सौहृदान्मे प्रणयाच्चाथ केशव।\nसख्येन चैव वार्ष्णेय श्रेयस्कामतयैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2040447, "chapter_id": 1896, "verse_number": "५-१४१-२", "content_sanskrit": "सर्वं चैवाभिजानामि पाण्डोः पुत्रोऽस्मि धर्मतः ।\nनिश्चयाद्धर्मशास्त्राणां यथा त्वं कृष्ण मन्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2040448, "chapter_id": 1896, "verse_number": "५-१४१-३", "content_sanskrit": "कन्या गर्भं समाधत्त भास्करान्मां जनार्दन ।\nआदित्यवचनाच्चैव जातं मां सा व्यसर्जयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2040449, "chapter_id": 1896, "verse_number": "५-१४१-४", "content_sanskrit": "सोस्मि कृष्ण तथाजातः पाण्डोः पुत्रोस्मि धर्मतः ।\nकुन्त्या त्वहमपाकीर्णो यथा न कुशलं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2040450, "chapter_id": 1896, "verse_number": "५-१४१-५", "content_sanskrit": "सूतो हि मामधिरथो दृष्ट्वैवाभ्यानयद्गृहान्।\nराधायाश्चैव मां प्रादात्सौहार्दान्मधुसूदन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2040451, "chapter_id": 1896, "verse_number": "५-१४१-६", "content_sanskrit": "मत्स्नेहाच्चैव राधायां सद्यः क्षीरमवातरत् ।\nसा मे मूत्रं पुरीषं च प्रतिजग्राह माधव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2040452, "chapter_id": 1896, "verse_number": "५-१४१-७", "content_sanskrit": "तस्याः पिण्डव्यपनयं कुर्यादस्मद्विधः कथम् ।\nधर्मविद्धर्मशास्त्राणां श्रवणे सततं रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2040453, "chapter_id": 1896, "verse_number": "५-१४१-८", "content_sanskrit": "तथा मामभिजानाति सूतश्चाधिरथः सुतम् ।\nपितरं चाभिजानामि तमहं सौहृदात्सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2040454, "chapter_id": 1896, "verse_number": "५-१४१-९", "content_sanskrit": "स हि मे जातकर्मादि कारयामास माधव ।\nशास्त्रदृष्टेन विधिना पुत्रप्रीत्या जनार्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2040455, "chapter_id": 1896, "verse_number": "५-१४१-१०", "content_sanskrit": "नाम वै वसुषेणेति कारयामास वै द्विजैः ।\nभार्याश्चोढा मम प्राप्ते यौवने तत्परिग्रहात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2040456, "chapter_id": 1896, "verse_number": "५-१४१-११", "content_sanskrit": "तासु पुत्राश्च पौत्राश्च मम जाता जनार्दन ।\nतासु मे हृदयं कृष्ण संजातं कामबन्धनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2040457, "chapter_id": 1896, "verse_number": "५-१४१-१२", "content_sanskrit": "न पृथिव्या सकलया न सुवर्णस्य राशिभिः।\nहर्षाद्भयाद्वा गोविन्द मिथ्या कर्तुं तदुत्सहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2040458, "chapter_id": 1896, "verse_number": "५-१४१-१३", "content_sanskrit": "धृतराष्ट्रकुले कृष्ण दुर्योधनसमाश्रयात् ।\nमया त्रयोदशसमा भुक्तं राज्यमकण्टकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2040459, "chapter_id": 1896, "verse_number": "५-१४१-१४", "content_sanskrit": "इष्टं च बहुभिर्यज्ञैः सहसूतैर्मयाऽसकृत्।\nआवाहाश्च विवाहाश्च सहसूतैर्मया कृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2040460, "chapter_id": 1896, "verse_number": "५-१४१-१५", "content_sanskrit": "मां च कृष्ण समासाद्य कृतः शस्त्रसमुद्यमः ।\nदुर्योधनेन वार्ष्णेय विग्रहश्चापि पाण्डवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2040461, "chapter_id": 1896, "verse_number": "५-१४१-१६", "content_sanskrit": "तस्माद्रणे द्वैरथे मां प्रत्युद्यातारमच्युत ।\nवृतवान्परमं कृष्ण प्रतीपं सव्यसाचिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2040462, "chapter_id": 1896, "verse_number": "५-१४१-१७", "content_sanskrit": "वधाद्बन्धाद्भयाद्वापि लोभाद्वापि जनार्दन ।\nअनृतं नोत्सहे कर्तुं धार्तराष्ट्रस्य धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2040463, "chapter_id": 1896, "verse_number": "५-१४१-१८", "content_sanskrit": "यदि ह्यद्य न गच्छेयं द्वैरथं सव्यसाचिना ।\nअकीर्तिः स्याद्धृपीकेश मम पार्थस्य चोभयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2040464, "chapter_id": 1896, "verse_number": "५-१४१-१९", "content_sanskrit": "असंशयं हितार्थाय ब्रूयास्त्वं मधुसूदन ।\nसर्वं च पाण्डवाः कुर्युस्त्वद्वशित्वान्न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2040465, "chapter_id": 1896, "verse_number": "५-१४१-२०", "content_sanskrit": "मन्त्रस्य नियमं कुर्यास्त्वमत्र मधुसूदन ।\nएतदत्र हितं मन्ये सर्वं यादवनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2040466, "chapter_id": 1896, "verse_number": "५-१४१-२१", "content_sanskrit": "यदि जानाति मां राजा धर्मात्मा संयतेन्द्रियः ।\nकुन्त्याः प्रथमजं पुत्रं न स राज्यं ग्रहीष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2040467, "chapter_id": 1896, "verse_number": "५-१४१-२२", "content_sanskrit": "प्राप्य चापि महद्राज्यं तदहं मधुसूदन ।\nस्फीतं दुर्योधनायैव संप्रदद्यामरिन्दम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2040468, "chapter_id": 1896, "verse_number": "५-१४१-२३", "content_sanskrit": "स एव राजा धर्मात्मा शाश्वतोऽस्तु युधिष्ठिरः ।\nनेता यस्य हृषीकेसो योद्धा यस्य धनञ्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2040469, "chapter_id": 1896, "verse_number": "५-१४१-२४", "content_sanskrit": "पृथिवी तस्य राष्ट्रं च यस्य भीमो महारथः ।\nनकुलः सहदेवश्च द्रौपदेयाश्च माधव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2040470, "chapter_id": 1896, "verse_number": "५-१४१-२५", "content_sanskrit": "धृष्टद्युन्मश्च पाञ्चल्यः सात्यकिश्च महारथः ।\nउत्तमौजा युधामन्युः सत्यधर्मा च सौमकिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2040471, "chapter_id": 1896, "verse_number": "५-१४१-२६", "content_sanskrit": "चैद्यश्च चेकितानश्च शिखण्डी चापराजितः ।\nइन्द्रगोपकवर्णाश्च केकया भ्रातरस्तथा।\nइन्द्रायुधसवर्णश्च कुन्तिभोजो महामनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2040472, "chapter_id": 1896, "verse_number": "५-१४१-२७", "content_sanskrit": "मातुलो भीमसेनस्य श्येनजिच्च महारथः ।\nशङ्खः पुत्रो विराटस्य निधिस्त्वं च जनार्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2040473, "chapter_id": 1896, "verse_number": "५-१४१-२८", "content_sanskrit": "महानयं कृष्ण कृतः क्षत्रस्य समुदानयः ।\nराज्यं प्राप्तमिदं दीप्तं प्रथितं सर्वराजसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2040474, "chapter_id": 1896, "verse_number": "५-१४१-२९", "content_sanskrit": "धार्तराष्ट्रस्य वार्ष्णेय शस्त्रयज्ञो भविष्यति।\nअस्य यज्ञस्य वेत्ता त्वं भविष्यसि जनार्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2040475, "chapter_id": 1896, "verse_number": "५-१४१-३०", "content_sanskrit": "आध्वर्यवं च ते कृष्ण ऋतावस्मिन्भविष्यति।\nहोता चैवात्र बीभत्सुः सन्नद्धः स कपिध्वजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2040476, "chapter_id": 1896, "verse_number": "५-१४१-३१", "content_sanskrit": "गाण्डीवं स्रुक् तथा चाज्यं वीर्यं पुंसां भविष्यति।\nऐन्द्रं पाशुपतं ब्राह्मं स्थूणाकर्णं च माधव ।\nमन्त्रास्तत्र भविष्यन्ति प्रयुक्ताः सव्यसाचिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2040477, "chapter_id": 1896, "verse_number": "५-१४१-३२", "content_sanskrit": "अनुयातश्च पितरमधिको वा पराक्रमे ।\nगीतं स्तोत्रं स सौभद्रः सम्यक् तत्र भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2040478, "chapter_id": 1896, "verse_number": "५-१४१-३३", "content_sanskrit": "उद्गातात्र पुनर्भीमः प्रस्तोता सुमहाबलः ।\nविनदन्स नरव्याघ्रो नागानीकान्तकृद्रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2040479, "chapter_id": 1896, "verse_number": "५-१४१-३४", "content_sanskrit": "स चैव तत्र धर्मात्मा शश्वद्राजा युधिष्ठिरः ।\nजपैर्होमैश्च संयुक्तो ब्रह्मत्वं कारयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2040480, "chapter_id": 1896, "verse_number": "५-१४१-३५", "content_sanskrit": "शङ्खशब्दाः समुरजा भेर्यश्च मधुसूदन।\nउत्कृष्टः सिंहनादश्च सुब्रह्मण्यो भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2040481, "chapter_id": 1896, "verse_number": "५-१४१-३६", "content_sanskrit": "नकुलः सहदेवश्च माद्रीपुत्रौ यशस्विनौ ।\nशामित्रं तौ महावीर्यौ सम्यक् तत्र भविष्यतः।\n`तौ मैत्रावरुणाग्नीध्रौ महावीर्यौ भविष्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2040482, "chapter_id": 1896, "verse_number": "५-१४१-३७", "content_sanskrit": "कल्माषदण्डा गोविन्द विमला रथपङ्क्तयः।\nयूपाः समुपकल्पन्तामस्मिन्यज्ञे जनार्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2040483, "chapter_id": 1896, "verse_number": "५-१४१-३८", "content_sanskrit": "कर्णिनालीकनाराचा वत्सदन्तोपबृंहणाः ।\nतोमराः सोमकलशाः पवित्राणि धनूंषि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2040484, "chapter_id": 1896, "verse_number": "५-१४१-३९", "content_sanskrit": "असयोऽत्र कपालानि पुरोडाशाः शिरांसि च।\nहविस्तु रुधिरं कृष्ण तस्मिन्यज्ञे भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2040485, "chapter_id": 1896, "verse_number": "५-१४१-४०", "content_sanskrit": "इध्माः परिधयश्चैव शक्तयो विमला गदाः।\nसदस्या द्रोणशिष्याश्च कृपस्य च शरद्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2040486, "chapter_id": 1896, "verse_number": "५-१४१-४१", "content_sanskrit": "इषवोऽत्र परिस्तोमा मुक्ता गाण्डीवधन्वना ।\nमहारथप्रयुक्ताश्च द्रोणद्रौणिप्रचोदिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2040487, "chapter_id": 1896, "verse_number": "५-१४१-४२", "content_sanskrit": "प्रतिप्रास्थानिकं कर्म सात्यकिस्तु करिष्यति।\nदीक्षितो धार्तराष्ट्रोऽत्र पत्नी चास्य महाचमूः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2040488, "chapter_id": 1896, "verse_number": "५-१४१-४३", "content_sanskrit": "घटोत्कचोऽत्र शामित्रं करिष्यति महाबलः ।\nअतिरात्रे महाबाहो वितते यज्ञकर्मणि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2040489, "chapter_id": 1896, "verse_number": "५-१४१-४४", "content_sanskrit": "दक्षिणा त्वस्य यज्ञस्य धृष्टद्युम्नः प्रतापवान् ।\nवैतानिके कर्ममुखे जातो यत्कृष्ण पावकात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2040490, "chapter_id": 1896, "verse_number": "५-१४१-४५", "content_sanskrit": "यदब्रुवमहं कृष्ण कटुकानि स्म पाण्डवान्।\nप्रियार्थं धार्तराष्ट्रस्य तेन तप्ये ह्यकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2040491, "chapter_id": 1896, "verse_number": "५-१४१-४६", "content_sanskrit": "यदा द्रक्ष्यसि मां कृष्ण निहतं सव्यसाचिना ।\nपुनश्चितिस्तदा चास्य यज्ञस्याथ भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2040492, "chapter_id": 1896, "verse_number": "५-१४१-४७", "content_sanskrit": "दुःशासनस्य रुधिरं यदा पास्यति पाण्डवः ।\nआनर्दं नर्दतः सम्यक् तदा सूयं भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2040493, "chapter_id": 1896, "verse_number": "५-१४१-४८", "content_sanskrit": "यदा द्रोणं च भीष्मं च पाञ्चाल्यौ पातयिष्यतः ।\nतदा यज्ञावसानं तद्भविष्यति जनार्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2040494, "chapter_id": 1896, "verse_number": "५-१४१-४९", "content_sanskrit": "दुर्योधनं यदा हन्ता भीमसेनो महाबलः ।\nतदा समाप्स्यते यज्ञो धार्तराष्ट्रस्य माधव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2040495, "chapter_id": 1896, "verse_number": "५-१४१-५०", "content_sanskrit": "स्नुषाश्च प्रस्नुषाश्चैव धृतराष्ट्रस्य सङ्गताः ।\nहतेश्वरा नष्टपुत्रा हतनाथाश्च केशव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2040496, "chapter_id": 1896, "verse_number": "५-१४१-५१", "content_sanskrit": "रुदन्त्यः सहगान्धार्या श्वगृध्रकुरराकुले ।\nस यज्ञेऽस्मिन्नवभृथो भविष्यति जनार्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2040497, "chapter_id": 1896, "verse_number": "५-१४१-५२", "content_sanskrit": "विद्यावृद्धा वयोवृद्धाः क्षत्रियाः क्षत्रियर्षभ ।\nवृथा मृत्युं न कुर्वीरंस्त्वत्कृते मधुसूदन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2040498, "chapter_id": 1896, "verse_number": "५-१४१-५३", "content_sanskrit": "शस्त्रेण निधनं गच्छेत्समृद्धं क्षत्रमण्डलम् ।\nकरुक्षेत्रे पुण्यतमे त्रैलोक्यस्यापि केशव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2040499, "chapter_id": 1896, "verse_number": "५-१४१-५४", "content_sanskrit": "तदत्र पुण्डरीकाक्ष विधत्स्व यदभीप्सितम् ।\nयथा कार्त्स्न्येन वार्ष्णेय क्षत्रं स्वर्गमवाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2040500, "chapter_id": 1896, "verse_number": "५-१४१-५५", "content_sanskrit": "यावत्स्थास्यन्ति गिरयः सरितश्च जनार्दन ।\nतावत्कीर्तिभवः शब्दः शाश्वतोयं भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2040501, "chapter_id": 1896, "verse_number": "५-१४१-५६", "content_sanskrit": "ब्राह्मणाः कथयिष्यन्ति महाभारतमाहवम् ।\nसमागमेषु वार्ष्णेय क्षत्रियाणां यशोधनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2040502, "chapter_id": 1896, "verse_number": "५-१४१-५७", "content_sanskrit": "समुपानय कौन्तेयं युद्धाय मम केशव ।\nमन्त्रसंवरणं कुर्वन्नित्यमेव परन्तप ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2040503, "chapter_id": 1896, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानर्वणि एकचत्वारिंशदधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]