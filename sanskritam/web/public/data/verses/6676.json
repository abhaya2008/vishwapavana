  {
    "id": 20010730,
    "chapter_id": 6676,
    "verse_number": "4.76",
    "content_sanskrit": "सृत्वरेष्टनखस्पर्शभिदुरस्तनमण्डलाः । जित्वरीस्सुरस्त्रीणां छित्वरी रूपसम्पदा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 76,
    "avatarnika": ""
  },
  {
    "id": 20010731,
    "chapter_id": 6676,
    "verse_number": "4.77",
    "content_sanskrit": "जागरूको भवास्मासु त्वद्गत्वरमनस्स्विति । नम्रस्मेरं तमित्युक्त्वा पौरो निववृते जनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 77,
    "avatarnika": ""
  },
  {
    "id": 20010732,
    "chapter_id": 6676,
    "verse_number": "4.78",
    "content_sanskrit": "तं यान्तं दन्दशूकारिञ्जञ्जपूकजनद्विषम् । अनुजग्मुरतिप्रेम्णा यायजूका द्विजातयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 78,
    "avatarnika": ""
  },
  {
    "id": 20010733,
    "chapter_id": 6676,
    "verse_number": "4.79",
    "content_sanskrit": "हिंस्रैःस्मरशरैर्विद्धाः कम्प्रैर्वेपथुना स्तनैः । तमलोकन्त निर्यान्तमजस्रमसितभ्रुवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 79,
    "avatarnika": ""
  },
  {
    "id": 20010734,
    "chapter_id": 6676,
    "verse_number": "4.80",
    "content_sanskrit": "कम्रो निसर्गादाकल्पैर्दीप्रः पुरवधूजनम् । धीरं तस्य तदा चित्तं जिहीर्षुरपि नाहरत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 80,
    "avatarnika": ""
  },
  {
    "id": 20010735,
    "chapter_id": 6676,
    "verse_number": "4.81",
    "content_sanskrit": "आशंसवश्शिवं तस्य सर्वे नगरवासिनः । चक्रुर्मङ्गलकर्माणि कुन्ती कृष्णा च किं पुनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 81,
    "avatarnika": ""
  },
  {
    "id": 20010736,
    "chapter_id": 6676,
    "verse_number": "4.82",
    "content_sanskrit": "तं विन्दुरिति विद्वांसो वदान्य इति भिक्षवः । आसन्नस्वप्नजं वीरमनुत्रजितुमिच्छवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 82,
    "avatarnika": ""
  },
  {
    "id": 20010737,
    "chapter_id": 6676,
    "verse_number": "4.83",
    "content_sanskrit": "तोयं पिबद्भिस्तृष्णद्भिश्शरारुमृगदस्युषु । मार्गेषु मिलितैः पान्थैर्भीरुकैः परिवारितः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 83,
    "avatarnika": ""
  },
  {
    "id": 20010738,
    "chapter_id": 6676,
    "verse_number": "4.84",
    "content_sanskrit": "भीरुं ग्रामोपशल्येषु वन्दारुजनमागतम् । विकस्वरमुखो धिन्वन् बिभ्राणो भास्वरं धनुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 84,
    "avatarnika": ""
  },
  {
    "id": 20010739,
    "chapter_id": 6676,
    "verse_number": "4.85",
    "content_sanskrit": "जङ्गमस्थावरप्राणिशरण्योथ ययौ क्रमात् । पेख्ररानुचरोऽरण्यममरेश्वरनन्दनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 85,
    "avatarnika": ""
  },
  {
    "id": 20010740,
    "chapter_id": 6676,
    "verse_number": "4.86",
    "content_sanskrit": "प्रीतो यायावरैस्सार्धं कथाशौण्डैस्स तापसैः । बिभ्राड्भिस्तपसा गच्छन् मुनिवेषेणभास्वता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 86,
    "avatarnika": ""
  },
  {
    "id": 20010741,
    "chapter_id": 6676,
    "verse_number": "4.87",
    "content_sanskrit": "विद्युत्पिङ्गजटाभारश्रीरवासास्स वल्कली । अग्निभृत्सुकुमारोपि तापसानां धुरं दधौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 87,
    "avatarnika": ""
  },
  {
    "id": 20010742,
    "chapter_id": 6676,
    "verse_number": "4.88",
    "content_sanskrit": "पुलिन्दविभुसुन्दर्यो ददृशुर्नग्नशुं वने । धात्रीफलाभमुक्ताढ्यस्तनकुंभालसद्दृशः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 88,
    "avatarnika": ""
  },
  {
    "id": 20010743,
    "chapter_id": 6676,
    "verse_number": "4.89",
    "content_sanskrit": "दात्रैर्लूत्वा गवाङ्गानि योक्त्रैर्बद्ध्वा च बिभ्रतः । शस्त्रैर्दस्यून्निगृह्णानः स्तोत्रैर्भेजे स तापसैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 89,
    "avatarnika": ""
  },
  {
    "id": 20010744,
    "chapter_id": 6676,
    "verse_number": "4.90",
    "content_sanskrit": "सेक्त्रोद्धृतपयःकुल्या सेकोल्लसितसस्यकाः । लिखिता हलपौत्रैस्स ग्रामभूमी'र्विंर्जयन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 90,
    "avatarnika": ""
  },
  {
    "id": 20010745,
    "chapter_id": 6676,
    "verse_number": "4.91",
    "content_sanskrit": "वराहपोत्रव्रणिता विजगाहे वनस्थलीः । विकसत्कुसुमामोदमरुदाधूतपल्लवाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 91,
    "avatarnika": ""
  },
  {
    "id": 20010746,
    "chapter_id": 6676,
    "verse_number": "4.92",
    "content_sanskrit": "सखनित्रलवित्रान् स वनेऽपश्यद्वनेचरान् । अरित्रैर्नयतो नावस्तोये तोयचरानपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 92,
    "avatarnika": ""
  },
  {
    "id": 20010747,
    "chapter_id": 6676,
    "verse_number": "4.93",
    "content_sanskrit": "पवित्रपाणिभिर्जुष्टान् महामुनिभिराश्रमान् । भेजे धवित्रधृताग्नीन् सोऽन्वहं शीतलद्रुमान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 93,
    "avatarnika": ""
  },
  {
    "id": 20010748,
    "chapter_id": 6676,
    "verse_number": "4.94",
    "content_sanskrit": "पवित्रदेवताप्रज्ञान् पवित्रर्षिविदो मुनीन् । जगत्करुणया खिन्नान् स ववन्दे गतश्रमः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 94,
    "avatarnika": ""
  },
  {
    "id": 20010749,
    "chapter_id": 6676,
    "verse_number": "4.95",
    "content_sanskrit": "आश्रमेषु महर्षीणां मतोऽभूदर्चितश्च सः । खिन्नाङ्गः परिचर्याभिरनुत्सेकोत्तरैर्गुणैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 95,
    "avatarnika": ""
  },
  {
    "id": 20010750,
    "chapter_id": 6676,
    "verse_number": "4.96",
    "content_sanskrit": "तीर्थानि गमिभिस्सार्धं गमी तीर्थानि सोऽव्रजत् । पुण्यरम्यकथाशौण्डैस्सेव्यैर्मुनिगणैर्मुदा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 96,
    "avatarnika": ""
  },
  {
    "id": 20010751,
    "chapter_id": 6676,
    "verse_number": "4.97",
    "content_sanskrit": "श्रोतुं तत्तत्स पप्रच्छ प्रसङ्गेषु महामुनीन् । आचक्षत च ते तस्मै मोदकास्तस्य मानसम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 97,
    "avatarnika": ""
  },
  {
    "id": 20010752,
    "chapter_id": 6676,
    "verse_number": "4.98",
    "content_sanskrit": "अरण्यकुसुमोत्तंसाः कौसुमं बिभ्रती रजः । कुचकुड्मलपर्यन्ते पीवरं पिञ्जरप्रभम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 98,
    "avatarnika": ""
  },
  {
    "id": 20010753,
    "chapter_id": 6676,
    "verse_number": "4.99",
    "content_sanskrit": "गायन्तीर्मृगरोधाय तालच्छूदनकुण्डलाः । मार्गपक्वणग्रामेषु सोऽपश्यच्छालिगोपिकाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 99,
    "avatarnika": ""
  },
  {
    "id": 20010754,
    "chapter_id": 6676,
    "verse_number": "4.100",
    "content_sanskrit": "आश्रमेषु महर्षीणां पूजायै सोन्तिकं ययौ । कुशलावस्समित्काण्डसन्दायश्च ययौ वनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 100,
    "avatarnika": ""
  },
  {
    "id": 20010755,
    "chapter_id": 6676,
    "verse_number": "4.101",
    "content_sanskrit": "होष्यत्सु मुनिमुख्येषु जलादि स्वयमाहरन् । भोक्ष्यमाणेषु च स्वादु फलमूलञ्च फल्गुनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 101,
    "avatarnika": ""
  },
  {
    "id": 20010756,
    "chapter_id": 6676,
    "verse_number": "4.102",
    "content_sanskrit": "निष्पन्दं वलितग्रीवं स्थित्वा स्थित्वा व्रजन्ति सः । ददर्श मृगयूथानि चपलानि महावने ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 102,
    "avatarnika": ""
  },
  {
    "id": 20010757,
    "chapter_id": 6676,
    "verse_number": "4.103",
    "content_sanskrit": "नीलकण्ठानसौ चञ्चच्चूडाचन्द्रकमण्डलान् । दृष्ट्वात्मानं घनश्यामं हृष्टानैक्षिष्ट नृत्यतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 103,
    "avatarnika": ""
  },
  {
    "id": 20010758,
    "chapter_id": 6676,
    "verse_number": "4.104",
    "content_sanskrit": "स्वेदोदबिन्दुभिस्तस्य मुखमार्गश्रमोदितैः । शुशुभे शशिनो बिंबममृतांबुकणैरिव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
