    "display_order": 104,
    "avatarnika": ""
  },
  {
    "id": 20010759,
    "chapter_id": 6676,
    "verse_number": "4.105",
    "content_sanskrit": "कल्हारसौरभोन्मिश्रकलमामोदवान् मृदुः । वायुः स्वेदलवानस्य कुल्यांबुशिशिरोऽहरत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 105,
    "avatarnika": ""
  },
  {
    "id": 20010760,
    "chapter_id": 6676,
    "verse_number": "4.106",
    "content_sanskrit": "अथ जातु कौशिकमुनेस्तपोवनं मुनिमण्डलानुचरचक्रसंवृतः । विरलीभवत्तपनभासि वासरे सुमना विवेश शतमन्युनन्दनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
