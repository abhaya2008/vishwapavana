[
  {
    "id": 20010655,
    "chapter_id": 6676,
    "verse_number": "4.1",
    "content_sanskrit": "क्षमामेवमवतस्तस्य राष्ट्रे जातु द्विजन्मनः । कस्यचित्तस्कराः केचिज्जहुर्विधिवशात् पशून् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20010656,
    "chapter_id": 6676,
    "verse_number": "4.2",
    "content_sanskrit": "दूनोग्निष्टोमयाजी स दध्यौ होमगवीहृतेः । पार्थानां शासतां चोराः कथं नाम विकुर्वते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20010657,
    "chapter_id": 6676,
    "verse_number": "4.3",
    "content_sanskrit": "न साधुघाती गोघाती ब्रह्महा भ्रूणहापि वा । राष्ट्रे युधिष्ठिरस्यास्मिन् वार्त्रघ्न इव दृश्यते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20010658,
    "chapter_id": 6676,
    "verse_number": "4.4",
    "content_sanskrit": "न च दृष्टचराः केचिदुदन्वद्बलयावधौ । भुवि पापकृतोऽमुष्य सर्वपुण्यकृतां गतौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20010659,
    "chapter_id": 6676,
    "verse_number": "4.5",
    "content_sanskrit": "वर्णाश्रमान् कर्मकृतः करोत्येष नृपः सुकृत् । पुरोहितैरमात्यैश्च मन्त्रकृद्भिरुपासितः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20010660,
    "chapter_id": 6676,
    "verse_number": "4.6",
    "content_sanskrit": "भान्ति सोमसुतामग्निचितां श्येनचिदादिभिः । अग्निभिर्भूगयोद्यत्वे रचितैः कुशलैर्द्विजैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20010661,
    "chapter_id": 6676,
    "verse_number": "4.7",
    "content_sanskrit": "घृतविक्रयिणां वित्तैस्तैलविक्रयिणामपि । अन्येषामपि दण्ड्यानां नृपः कोशान् पिपर्त्ययम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20010662,
    "chapter_id": 6676,
    "verse_number": "4.8",
    "content_sanskrit": "उपायदृश्वभी राजयुध्वभी राजकृत्वभिः । वृतोयं सचिवैर्भाति मरुत्वानमरैरिव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20010663,
    "chapter_id": 6676,
    "verse_number": "4.9",
    "content_sanskrit": "सहकृत्त्वभिरुग्रेषु युद्धेषु सहयुध्वभिः । हिमाद्रिजद्रिपेन्द्राभैस्सविक्रमजकीर्तिभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20010664,
    "chapter_id": 6676,
    "verse_number": "4.10",
    "content_sanskrit": "प्रजा नित्यमसौ पाति भीमाद्यैस्स्वानुजैस्सह । सहजस्नेहसम्पन्नैः प्रेमाकृतिमवाप्तवान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20010665,
    "chapter_id": 6676,
    "verse_number": "4.11",
    "content_sanskrit": "शरण्ये सुत्वनामस्मिन् महीमेवमवत्यपि । यज्वनो मे हृता गावश्चौरैर्भाग्यविपर्ययात् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20010666,
    "chapter_id": 6676,
    "verse_number": "4.12",
    "content_sanskrit": "तथापि बोधयाम्यर्थमेतमेतर्हि भूपतिम् । न न ह्यविज्ञापितो रक्ष्यैर्नरै रक्षति पार्थिवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20010667,
    "chapter_id": 6676,
    "verse_number": "4.13",
    "content_sanskrit": "ध्यात्वेत्थं स जरन्नक्तं हरिप्रस्थमुपेयिवान् । अतीत्य क्रोशमध्वानं क्रोशंश्चुक्रोश पाण्डवान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20010668,
    "chapter_id": 6676,
    "verse_number": "4.14",
    "content_sanskrit": "आहारसमयेऽनाश्वाननूचानं धनञ्जयः । तं तस्य शब्दमत्युच्चं शुश्रुवानुपसेदिवान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20010669,
    "chapter_id": 6676,
    "verse_number": "4.15",
    "content_sanskrit": "उपोषिवांसं व्रतिनं चातुर्मास्यपरायणम् । प्रणिपत्य स पप्रच्छ विपदं सोप्यवेदयत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20010670,
    "chapter_id": 6676,
    "verse_number": "4.16",
    "content_sanskrit": "यतमानेषु दुर्वृत्तान् युष्मासु शमयत्स्वपि । चोरा गा मेऽधुनाहार्षुस्तान् निहत्यानयाशु गाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20010671,
    "chapter_id": 6676,
    "verse_number": "4.17",
    "content_sanskrit": "यज्ञसा वर्धमानार्यान् पार्थानार्यवधैरवन् । धावन् दधानः कोदण्डमनुगच्छ मलिम्लुचान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20010672,
    "chapter_id": 6676,
    "verse_number": "4.18",
    "content_sanskrit": "होमधेनुविनाशार्तिं पश्यन् पार्थ ममाधुना । दयमानः प्रतिष्ठस्व रात्रावपि तमस्यपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20010673,
    "chapter_id": 6676,
    "verse_number": "4.19",
    "content_sanskrit": "पवमानान् द्विजान् सोमं यजमानानवन्ति ये । ते भवन्ति सुराजानस्तैश्च राजन्वती मही ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20010674,
    "chapter_id": 6676,
    "verse_number": "4.20",
    "content_sanskrit": "पलितं वहमानं तं जल्पमानं द्विजोत्तमम् । निघ्नानस्तस्करान् पार्थो हर्षयन् प्रत्यभाषत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20010675,
    "chapter_id": 6676,
    "verse_number": "4.21",
    "content_sanskrit": "अधीयंश्चतुरो वेदान् षडङ्गानि च धारयन् । सुन्वन्नर्हन्द्विजेन्द्रार्चां हृत्वाद्य द्विषतस्तव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20010676,
    "chapter_id": 6676,
    "verse_number": "4.22",
    "content_sanskrit": "गास्ते दास्याम्युपानीय त्यज शोकं व्रजालयम् । इत्थमाश्वास्य तं नीत्वा गृहमेवमचिन्तयत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20010677,
    "chapter_id": 6676,
    "verse_number": "4.23",
    "content_sanskrit": "ऐषमः कृष्णया सार्धं वसत्यार्यो युधिष्ठिरः । गोप्तायुधानि सोस्माकं निहितानि निजालये ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20010678,
    "chapter_id": 6676,
    "verse_number": "4.24",
    "content_sanskrit": "नारदस्योपदेशाच्च समयं कृतपूर्विणः । गन्तारो वयमन्योन्यं न कृष्णाशयनालये ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20010679,
    "chapter_id": 6676,
    "verse_number": "4.25",
    "content_sanskrit": "भङ्क्ता च समयं यस्स वस्ता संवत्सरं वने । शय्यागृहं प्रवेष्टाहं कथमेवंस्थिते 'गुरौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20010680,
    "chapter_id": 6676,
    "verse_number": "4.26",
    "content_sanskrit": "अगृहीत्वा च कोदण्डं तत्रत्यं द्विषतो द्विजम् । कथं हन्ता प्रदाता वा गास्तस्मै गृहमेधिने ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20010681,
    "chapter_id": 6676,
    "verse_number": "4.27",
    "content_sanskrit": "अनयोः किं परं कार्यं मम विप्रतिषिद्धयोः । समयस्य च रक्षाया द्विजास्त्रहरणस्य च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20010682,
    "chapter_id": 6676,
    "verse_number": "4.28",
    "content_sanskrit": "अथवा भवितुं नायमर्थस्सांशयिकोऽर्हति । क्षत्रियाणां परं कार्यपालनं हि द्विजन्मनाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20010683,
    "chapter_id": 6676,
    "verse_number": "4.29",
    "content_sanskrit": "समयातिक्रमेणापि ब्राह्मणे गाः प्रदाय तत् । वनं गन्ता भविष्यामि धर्मराजाभ्यनुज्ञया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20010684,
    "chapter_id": 6676,
    "verse_number": "4.30",
    "content_sanskrit": "इत्थं विचार्य निर्णीय गत्वादायायुधानि सः । सन्नद्धो बद्धनिस्त्रिंशशरधिस्सज्यचापभृत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20010685,
    "chapter_id": 6676,
    "verse_number": "4.31",
    "content_sanskrit": "आहूतपुरुषोद्बद्धदीपिकालोकदर्शिताम् । पद्भ्यामधावद्दस्यूनां पदाङ्कां पदवीं निशि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20010686,
    "chapter_id": 6676,
    "verse_number": "4.32",
    "content_sanskrit": "आसाद्य शातभल्लालिच्छिन्नकण्ठान् विधाय तान् । गास्समाहृत्य विप्रस्य गोष्ठं निन्येऽथ स स्वयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20010687,
    "chapter_id": 6676,
    "verse_number": "4.33",
    "content_sanskrit": "गृहं प्रविष्टमभ्यर्चन्नथ विप्रस्स फल्गुनम् । मेने वर्धिष्णुमात्मानं सुकृतैरुत्पचिष्णुभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20010688,
    "chapter_id": 6676,
    "verse_number": "4.34",
    "content_sanskrit": "अपत्रविष्णुमर्चाभिर्वर्तिष्णुं भुवि तं नतम् । आलिङ्ग्यासनमारोप्य द्विजः प्रमुदितोऽब्रवीत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20010689,
    "chapter_id": 6676,
    "verse_number": "4.35",
    "content_sanskrit": "जिष्णो सहिष्णुस्सर्वास्त्वं चरिष्णुर्यशसो रिपून् । प्रजनिष्णुश्चिरं जीव भूष्णुर्विष्णुरिवापरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20010690,
    "chapter_id": 6676,
    "verse_number": "4.36",
    "content_sanskrit": "प्रतापस्थास्नुरग्लास्नुरस्त्वज्जातरिपुश्चिरम् । धृष्णवः क्षमिणोरातीन् भवन्तु भ्रातरस्तव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20010691,
    "chapter_id": 6676,
    "verse_number": "4.37",
    "content_sanskrit": "त्रस्नवस्सन्त्वमित्रास्ते लोकवीर पराक्रमात् । लभन्तामिष्टमिष्टं ते गृध्नवो मित्रबान्धवाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20010692,
    "chapter_id": 6676,
    "verse_number": "4.38",
    "content_sanskrit": "शमिनं दमिनं विप्रं क्षमिणं 'सततक्षमी । अभ्रम्यमादी संपूज्य तमामन्त्र्य गृहं ययौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20010693,
    "chapter_id": 6676,
    "verse_number": "4.39",
    "content_sanskrit": "शयित्वा शयने किञ्चित् प्रभातायां ततो निशि । विवेकी कृतकृत्योऽगात् कृतकृत्यं स पार्थिवम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20010694,
    "chapter_id": 6676,
    "verse_number": "4.40",
    "content_sanskrit": "समयं लंघितं तस्मै वनवासमभीप्सितम् । अनायासिमनाः पार्थश्शशंस गुरवे नतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20010695,
    "chapter_id": 6676,
    "verse_number": "4.41",
    "content_sanskrit": "श्रुत्वा तस्य वचस्तस्मिन्ननुरागी युधिष्ठिरः । प्रवासेनानुरोध्यस्य संज्वारीदमभाषत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20010696,
    "chapter_id": 6676,
    "verse_number": "4.42",
    "content_sanskrit": "नतेऽपचारिता वत्स गुरोश्शय्यागृहे गते । गुरुरेवातिचारी स्यात् जायायोगेऽनुजं गतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20010697,
    "chapter_id": 6676,
    "verse_number": "4.43",
    "content_sanskrit": "तत्सम्पर्की भवास्माभिस्संसर्गी विषयैस्सुखी । मादोषि द्रोहि सत्वेषु परिसारी वनेषु भूः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20010698,
    "chapter_id": 6676,
    "verse_number": "4.44",
    "content_sanskrit": "प्रत्युवाच तमित्युक्तः प्रवासी वासवात्मजः । परिदेविनमुद्वेग स्नेहेन परिमोहिणम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20010699,
    "chapter_id": 6676,
    "verse_number": "4.45",
    "content_sanskrit": "निन्दकस्त्वमसत्यस्य नैवं मा वक्तुमर्हसि । स्नेहस्य हिंसको भूत्वा 'धीरं गमय धीर माम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20010700,
    "chapter_id": 6676,
    "verse_number": "4.46",
    "content_sanskrit": "विनाशकं शुचः श्रुत्वा राजा पार्थस्य तद्वचः । प्रीतोऽवदत् प्रबुद्धस्तं प्रस्त्रावीप्रमदाश्रुणः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20010701,
    "chapter_id": 6676,
    "verse_number": "4.47",
    "content_sanskrit": "वात्सल्यप्रभवं मोहमापन्नः परिदेवकः । आक्रोशकेन दिष्ट्याहमधुना बोधितस्त्वया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20010702,
    "chapter_id": 6676,
    "verse_number": "4.48",
    "content_sanskrit": "प्रमाथिनो रिपून् मथ्नन् अप्रमादी सहर्षिभिः । वस पुण्येष्वरण्येषु पार्थ सामर्थ्यवान् यदि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20010703,
    "chapter_id": 6676,
    "verse_number": "4.49",
    "content_sanskrit": "ब्रह्मचारी सदान्यत्र भव जीवितसंशयात् । स्वस्यान्यस्यास्तरुण्या वा यूनां हि चलनं मनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20010704,
    "chapter_id": 6676,
    "verse_number": "4.50",
    "content_sanskrit": "कूजनैः कोकिलैर्युक्तान् कुसुमैरपि शोभनैः । हित्वा प्रदेशान् दान्तार्यशुश्रूषालषणो भव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20010705,
    "chapter_id": 6676,
    "verse_number": "4.51",
    "content_sanskrit": "भुवि चङ्क्रमणो भूत्वा तीर्थानां सरणसुखी । वत्सरान्ते पुनर्वत्स स्वस्तिमानेहि मन्दिरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20010706,
    "chapter_id": 6676,
    "verse_number": "4.52",
    "content_sanskrit": "इत्युक्तं वन्दितांघ्रिं तं मूर्ध्नुपाघ्राय भूपतिः । परिष्वज्याङ्कमारोप्य 'शोभनः पुनरप्यभूत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20010707,
    "chapter_id": 6676,
    "verse_number": "4.53",
    "content_sanskrit": "मुक्तः कथञ्चित्तेनाथ धृतिमालंब्य फल्गुनः । भ्रातॄनामन्त्र्य कुन्तीं च तथा कृष्णागृहं ययौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20010708,
    "chapter_id": 6676,
    "verse_number": "4.54",
    "content_sanskrit": "सतां विदितवृत्तान्तां विधायेदमभाषत । गाढमालिंग्य बाहुभ्यां पृथुवक्षाः पृथुस्तनीम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20010709,
    "chapter_id": 6676,
    "verse_number": "4.55",
    "content_sanskrit": "संविद्व्यतीतमापन्नं हृषीकार्थेष्वगर्धनम् । आर्ये वनाय गच्छन्तमाशिषानुगृहाण माम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20010710,
    "chapter_id": 6676,
    "verse_number": "4.56",
    "content_sanskrit": "न च मे त्वद्वियोगार्तिर्वर्धना स्यात् प्रिये वने । पश्यतो जवनानेणांस्तृपीन् दीक्षितुरर्चतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20010711,
    "chapter_id": 6676,
    "verse_number": "4.57",
    "content_sanskrit": "अनाधिपतना नित्यं पतिश्वश्रूहिते हिता । ज्वलनाभूषणैर्भद्रे कुरु सम्पादनं गृहम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20010712,
    "chapter_id": 6676,
    "verse_number": "4.58",
    "content_sanskrit": "स्त्रियः पतीन् स्वान् क्षमायित्रीः क्रोधना जातु मा गमः । सूदित्रीर्द्रविणान्यार्यै खादिकास्त्वमसूयिकाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20010713,
    "chapter_id": 6676,
    "verse_number": "4.59",
    "content_sanskrit": "गुणालंकारदीपित्रीस्सेवस्व गृहमण्डनाः । निर्दोषस्सरसाः पुण्याः सूक्तीरिव सदा सतीः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20010714,
    "chapter_id": 6676,
    "verse_number": "4.60",
    "content_sanskrit": "उत्पादुकक्षुत्तृष्णार्तान् पान्थानापातुकान् गृहम् । संतर्प्य विप्रान् भर्तॄंश्च भवान्नान्याभिलाषुकाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20010715,
    "chapter_id": 6676,
    "verse_number": "4.61",
    "content_sanskrit": "प्रभावुकेन भक्तेन भवोपस्थायुकान् द्विजान् । श्रिता हिते प्रदातॄणां वर्षुकास्सर्वसम्पदः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20010716,
    "chapter_id": 6676,
    "verse_number": "4.62",
    "content_sanskrit": "ब्रुवाणमिति पाञ्चाली वनंगामुकमर्जुनम् । अकामुकाब्रवीत् प्राज्ञा पतिभावानुवर्तिनी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20010717,
    "chapter_id": 6676,
    "verse_number": "4.63",
    "content_sanskrit": "गच्छ्याजमीढ पन्थानश्शिवास्सन्तु तवागमात् । रक्षांसि घातुको धन्वीशारुकाणि मुनीन् वने ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20010718,
    "chapter_id": 6676,
    "verse_number": "4.64",
    "content_sanskrit": "जल्पकान् सर्वधर्माणं कुट्टाकानश्मनां मुनीन् । पलाशिफलभिक्षाकानुपतिष्ठस्व कानने ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20010719,
    "chapter_id": 6676,
    "verse_number": "4.65",
    "content_sanskrit": "ग्रामीणानाश्रितान् विप्रान् वराकान्नीप्सितार्थदान् । धावन् प्रजवि चोरासु लुण्टाकैः पाहि पत्रिभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20010720,
    "chapter_id": 6676,
    "verse_number": "4.66",
    "content_sanskrit": "जयी विषयिणां नित्यमव्यथी तेजसो वमी । आदरी मुनिमुख्यानां परिभव्यसतां भव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "avatarnika": ""
  },
  {
    "id": 20010721,
    "chapter_id": 6676,
    "verse_number": "4.67",
    "content_sanskrit": "धनेभ्यः स्पृहयालृभ्यस्तीर्थेष्वर्थचयं त्यज । दयालुग्रहयालृभ्यः पतयालृभ्य ईप्सितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "avatarnika": ""
  },
  {
    "id": 20010722,
    "chapter_id": 6676,
    "verse_number": "4.68",
    "content_sanskrit": "अनिद्रालुरतन्द्रालुश्शयालृस्सदा भव । श्रद्धालुरीहमानो नास्सर्वानर्थान् प्रपद्यते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "avatarnika": ""
  },
  {
    "id": 20010723,
    "chapter_id": 6676,
    "verse_number": "4.69",
    "content_sanskrit": "इति ब्रुवाणामाश्लिष्य प्रियामाश्वास्य चार्जुनः । कटाक्षमालया बद्धश्ललितुं नाशकत् क्षणम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "avatarnika": ""
  },
  {
    "id": 20010724,
    "chapter_id": 6676,
    "verse_number": "4.70",
    "content_sanskrit": "ततस्स निर्ययो धीरो गृहीत्वा हृदयेन ताम् । हृदावलंब्य तं धीरा गृह एव त्वरुद्ध सा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70,
    "avatarnika": ""
  },
  {
    "id": 20010725,
    "chapter_id": 6676,
    "verse_number": "4.71",
    "content_sanskrit": "आमन्त्र्य स्वजनं सर्वं पदातिर्धारयन् धनुः । स प्रतस्थे जनं कर्षन् कान्तिन्धारं विलोचनैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71,
    "avatarnika": ""
  },
  {
    "id": 20010726,
    "chapter_id": 6676,
    "verse_number": "4.72",
    "content_sanskrit": "सद्गुच्चित्तास्तमैक्षन्त गात्रैश्शोकेन शद्रुभिः । सेरुर्मनोगुणैः पौरा दारुमर्थानभीप्सितान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 72,
    "avatarnika": ""
  },
  {
    "id": 20010727,
    "chapter_id": 6676,
    "verse_number": "4.73",
    "content_sanskrit": "निर्यान्तमर्जुनं द्रष्टुं नागराणां प्रधावताम् । चकार धूसरं व्योम सृमरं सरणौ रजः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 73,
    "avatarnika": ""
  },
  {
    "id": 20010728,
    "chapter_id": 6676,
    "verse_number": "4.74",
    "content_sanskrit": "अद्मरो गुडधानानां पृथुकानाञ्च घस्मरः । भासुरक्ष्मासुरप्रष्ठं जनोर्जुनकोन्वगात् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 74,
    "avatarnika": ""
  },
  {
    "id": 20010729,
    "chapter_id": 6676,
    "verse_number": "4.75",
    "content_sanskrit": "मेदुरोरसिजाभोगभङ्गुरोदरवल्लिकाः । स भावविदुरोऽपश्यद्वारनारीरभित्वरीः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
