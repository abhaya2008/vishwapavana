[{"id": 2109281, "chapter_id": 3372, "verse_number": "", "content_sanskrit": "शौनकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2109282, "chapter_id": 3372, "verse_number": "१", "content_sanskrit": "ये सर्पाः सर्पसत्रेऽस्मिन् पतिता हव्यवाहने ।\nतेषां नामानि सर्वेषां श्रोतुमिच्छामि सूतज \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2109283, "chapter_id": 3372, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2109284, "chapter_id": 3372, "verse_number": "२", "content_sanskrit": "सहस्राणि बहून्यस्मिन् प्रयुतान्यर्बुदानि च ।\nन शक्यं परिसङ्ख्यातुं बहुत्वाद् वेदवित्तम\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2109285, "chapter_id": 3372, "verse_number": "३", "content_sanskrit": "यथास्मृति तु नामानि पन्नगानां निबोध मे ।\nनीलरक्तान् सितान् घोरान् महाकायान् विषोद्बणान्\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2109286, "chapter_id": 3372, "verse_number": "४", "content_sanskrit": "कोटिको मनसः पूर्णः सदयालो हलीढकः ।\nपिच्छलः कौणपः शक्रः कोणवेगः प्रकालनः\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2109287, "chapter_id": 3372, "verse_number": "५", "content_sanskrit": "हिरण्यवाहः शरणः कक्षकः कालदन्तकः ।\nएते वासुकिजा नागाः प्रविष्टा हव्यवाहनम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2109288, "chapter_id": 3372, "verse_number": "६", "content_sanskrit": "तक्षकस्य कुलं तद् वै प्रवक्ष्यामि निबोध तान् ।\nपुच्छण्वलो मण्डलिकः पिण्डिभेत्ता रभेणकः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2109289, "chapter_id": 3372, "verse_number": "८", "content_sanskrit": "उच्छिखः सुरसो भृङ्गो वल्लिहोऽथावगेहणः ।\nसीलः सीलहणो मूकः सुकुमारः प्रवेपनः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2109290, "chapter_id": 3372, "verse_number": "९", "content_sanskrit": "मुद्गिरः शररोमा च सुमनो वेगवाहनः ।\nएते तक्षकजा नागाः प्रविष्टा हव्यवाहनम्\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2109291, "chapter_id": 3372, "verse_number": "१०", "content_sanskrit": "पारावतः पारियात्रः पाण्डरो हरिणः कृशः ।\nविहङ्गः शरभो मोदः प्रमोदः संहताङ्गदः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2109292, "chapter_id": 3372, "verse_number": "११", "content_sanskrit": "ऐरावतकुला एते पतिता हव्यवाहनम् ।\nकौरव्यकुलजान् जातान् शृणु नागान् द्विजोत्तम\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2109293, "chapter_id": 3372, "verse_number": "१२", "content_sanskrit": "जटिलः कुण्डलो मुण्डो वेणिग्रन्थः कुमारकः ।\nबाहुकः शृङ्गयष्टिश्च धूर्तकः पोतपीवरौ \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2109294, "chapter_id": 3372, "verse_number": "१३", "content_sanskrit": "एते कौरव्यजा नागाः प्रविष्टा हव्यवाहनम् ।\nधृतराष्ट्रकुले जातान् शृणु नागान् यथायथम्\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2109295, "chapter_id": 3372, "verse_number": "१४", "content_sanskrit": "कीर्त्यमानान् मया ब्रह्मन् वातवेगान् विषोद्बणान् ।\nशङ्कुकर्णः पिङ्गलकः कुठारमुखसेवकौ \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2109296, "chapter_id": 3372, "verse_number": "१५", "content_sanskrit": "पूर्णाङ्गदः पूर्णमुखः प्रहस्तः शकुनिर्भरः ।\nअमावकः कौमुदकः श्वसनो मानवो नटः\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2109297, "chapter_id": 3372, "verse_number": "१६", "content_sanskrit": "भैरवो मण्डली पिण्डः पिङ्गलश्चोडुपारकः ।\nऋषभो वेगवान् नाथः पिण्डारकमहाहनू \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2109298, "chapter_id": 3372, "verse_number": "१७", "content_sanskrit": "रक्ताङ्गः सर्वसारङ्गः समृद्धः पटलाक्षकः ।\nवगाहको वारुणकः सुमित्रश्चित्रवेदिकः\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2109299, "chapter_id": 3372, "verse_number": "१८", "content_sanskrit": "पराशरस्तरुणको मणिस्कन्धस्तथाऽरुणिः ।\nइति नागा मया ब्रह्मन् कीर्तिताः कीर्तिवर्धन\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2109300, "chapter_id": 3372, "verse_number": "१९", "content_sanskrit": "प्राधान्येन बहुत्वात् तु सर्वे न परिकीर्तिताः ।\nएतेषां पुत्रपौत्राश्च प्रसवस्य च सन्ततिः\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2109301, "chapter_id": 3372, "verse_number": "२०", "content_sanskrit": "न शक्याः परिसङ्ख्यातुं ये दीप्तं पावकं गताः ।\nसप्तशीर्षाऽष्टशीर्षाश्च द्विषट्शीर्षास्तथापरे \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2109302, "chapter_id": 3372, "verse_number": "२१", "content_sanskrit": "दशशीर्षाः शतशीर्षास्तथान्ये बहुशीर्षकाः ।\nकालानलविषा घोरा हुताः शतसहस्रशः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2109303, "chapter_id": 3372, "verse_number": "२२", "content_sanskrit": "महाकाया महावीर्याः शैलशृङ्गसमुच्छ्रयाः ।\nयोजनायामविस्तारा द्वियोजनसमायताः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2109304, "chapter_id": 3372, "verse_number": "२३", "content_sanskrit": "कामरूपाः कामबला दीप्तरूपा विषोद्बणाः ।\nदग्धास्तत्र महासत्रे ब्रह्मदण्डनिपीडिताः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2109305, "chapter_id": 3372, "verse_number": "५१", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nएकपञ्चाशोऽध्यायः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2109306, "chapter_id": 3372, "verse_number": "३९", "content_sanskrit": "॥ आस्तीकपर्वणि एकोनचत्वारिंशोऽध्यायः॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]