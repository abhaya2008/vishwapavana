[{"id": 2131130, "chapter_id": 3829, "verse_number": "३२३", "content_sanskrit": "वधं वव्रे स्वशत्रूणामिन्द्रः पार्थात् स्वरूपतः ।\nनिवातकवचाख्यानां येषां ब्रह्मा ददौ वरम् ॥३२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2131131, "chapter_id": 3829, "verse_number": "३२४", "content_sanskrit": "अवध्यत्वं सुरैर्दैत्यैर्गन्धर्वैः पक्षिराक्षसैः ।\nपुनरिन्द्रेणार्थितोऽदाज्जहीमान् नरदेहवान् ॥३२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2131132, "chapter_id": 3829, "verse_number": "समाप्तिः", "content_sanskrit": "इति तेनार्जुनं शक्रः स्वात्मानं नरदेहगम् ।\nजगाद तान् जहीत्येव किरीटं स्वं निबद्ध्य च ॥३२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}]