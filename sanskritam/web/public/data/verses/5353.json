[{"id": 2204228, "chapter_id": 5353, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2204229, "chapter_id": 5353, "verse_number": "१", "content_sanskrit": "भगवन् देवदेवेश मम प्रीतिविवर्धन ।\nजात्यन्धाश्चैव दृश्यन्ते जाता वा नष्टचक्षुषः ।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2204230, "chapter_id": 5353, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2204231, "chapter_id": 5353, "verse_number": "२", "content_sanskrit": "हन्त ते कथयिष्यामि शृणु कल्याणि कारणम्\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2204232, "chapter_id": 5353, "verse_number": "३", "content_sanskrit": "ये पुरा कामकारेण परवेश्मसु लोलुपाः ।\nपरस्त्रियोऽभिवीक्षन्ते दुष्टेनैव स्वचक्षुषा\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2204233, "chapter_id": 5353, "verse_number": "४", "content_sanskrit": "अन्धीकुर्वन्ति यन्मर्त्यान् क्रोधलोभसमन्विताः ।\nलक्षणज्ञाश्च रूपेषु अयथावत् प्रदर्शकाः\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2204234, "chapter_id": 5353, "verse_number": "५", "content_sanskrit": "एवंयुक्तसमाचाराः कालधर्मगतास्तु ते ।\nदण्डिता यमदण्डेन निरयस्थाश्चिरं प्रिये\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2204235, "chapter_id": 5353, "verse_number": "६", "content_sanskrit": "यदि चेन्मानुषं जन्म लभेरन् ते तथापि वा ।\nस्वभावतो वा जाता वा अन्धा एव भवन्ति ते ।\nअक्षिरोगयुता वाऽपि नास्ति तत्र विचारणा\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2204236, "chapter_id": 5353, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2204237, "chapter_id": 5353, "verse_number": "७", "content_sanskrit": "मुखरोगयुताः केचिद् दृश्यन्ते सततं नराः ।\nदन्तकण्ठकपोलस्थैर्व्याधिभिर्बहुपीडिताः\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2204238, "chapter_id": 5353, "verse_number": "८", "content_sanskrit": "आदिप्रभृति मर्त्या वा जाता वाऽप्यथ कारणात् ।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2204239, "chapter_id": 5353, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2204240, "chapter_id": 5353, "verse_number": "९", "content_sanskrit": "हन्त ते कथयिष्यामि शृणु देवि समाहिता\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2204241, "chapter_id": 5353, "verse_number": "१०", "content_sanskrit": "कुवक्तारस्तु ये देवि जिह्वया कटुकं भृशम् ।\nअसत्यं परुषं घोरं गुरून् प्रति परान् प्रति\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2204242, "chapter_id": 5353, "verse_number": "११", "content_sanskrit": "जिह्वाबाधां तदाऽन्येषां कुर्वते कोपकारणात् ।\nप्रायशोऽनृतभूयिष्ठा नराः कार्यवशेन वा ।\nतेषां जिह्वाप्रदेशस्था व्याधयः सम्भवन्ति ते\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2204243, "chapter_id": 5353, "verse_number": "१२", "content_sanskrit": "कुश्रोतारस्तु ये चार्यं परेषां कर्णनाशकाः ।\nकर्णरोगान् बहुविधाँल्लभन्ते ते पुनर्भवे\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2204244, "chapter_id": 5353, "verse_number": "१३", "content_sanskrit": "दन्तरोगशिरोरोगकर्णरोगास्तथैव च ।\nअन्ये दुःखाश्रिता दोषाः सर्वे चात्मकृतं फलम्\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2204245, "chapter_id": 5353, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2204246, "chapter_id": 5353, "verse_number": "१४", "content_sanskrit": "पीड्यन्ते सततं देव मानुषेष्वेव केचन ।\nकुक्षिपक्षाश्रितैर्दोषैर्व्याधिभिश्चोदराश्रितैः\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2204247, "chapter_id": 5353, "verse_number": "१५", "content_sanskrit": "तीक्ष्णशूलैश्च पीड्यन्ते नरा दुःखपरिप्लुताः ।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2204248, "chapter_id": 5353, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2204249, "chapter_id": 5353, "verse_number": "१६", "content_sanskrit": "ये पुरा मनुजा देवि कामक्रोधवशा भृशम् ।\nआत्मार्थमेव चाहारं भुञ्जन्ते निरपेक्षकाः\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2204250, "chapter_id": 5353, "verse_number": "१७", "content_sanskrit": "अभक्ष्याहारदाश्चैव विश्वस्तानां विषप्रदाः ।\nअभक्ष्यभक्षदाश्चैव शौचमङ्गलवर्जिताः\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2204251, "chapter_id": 5353, "verse_number": "१८", "content_sanskrit": "एवंयुक्तसमाचाराः पुनर्जन्मनि शोभने ।\nकथञ्चित् प्राप्य मानुष्यं तत्र ते व्याधिपीडिताः\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2204252, "chapter_id": 5353, "verse_number": "१९", "content_sanskrit": "तैस्तैर्बहुविधाकारैर्व्याधिभिर्दुःखसंश्रिताः ।\nभवन्त्येवं तथा देवि यथा येन कृतं पुरा\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2204253, "chapter_id": 5353, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2204254, "chapter_id": 5353, "verse_number": "२०", "content_sanskrit": "दृश्यन्ते सततं देव व्याधिभिर्मेहनाश्रितैः ।\nपीड्यमानास्तथा मर्त्या अश्मरीशर्करादिभिः ।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2204255, "chapter_id": 5353, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2204256, "chapter_id": 5353, "verse_number": "२१", "content_sanskrit": "ये पुरा मनुजा देवि परदारप्रधर्षकाः ।\nतिर्यग्योनिषु धूर्ता वै मैथुनार्थं चरन्ति च\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2204257, "chapter_id": 5353, "verse_number": "२२", "content_sanskrit": "कामदोषेण ये धूर्ताः कन्यासु विधवासु च ।\nबलात्कारेण गच्छन्ति रूपदर्पसमन्विताः\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2204258, "chapter_id": 5353, "verse_number": "२३", "content_sanskrit": "तादृशा मरणं प्राप्ताः पुनर्जन्मनि शोभने ।\nयदि चेन्मानुषं जन्म लभेरंस्ते तथाविधाः ।\nतत्र मेहनजैर्घोरैः पीड्यन्ते व्यधिभिः प्रिये\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2204259, "chapter_id": 5353, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2204260, "chapter_id": 5353, "verse_number": "२४", "content_sanskrit": "भगवन्मानुषाः केचिद् दृश्यन्ते शोषिणः कृशाः ।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2204261, "chapter_id": 5353, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2204262, "chapter_id": 5353, "verse_number": "२५", "content_sanskrit": "ये पुरा मनुजा देवि मांसलुब्धाः सुलोलुपाः ।\nआत्मार्थे स्वादुगृद्धाश्च परभोगोपतापिनः\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2204263, "chapter_id": 5353, "verse_number": "२६", "content_sanskrit": "अभ्यसूयाश्चोपतापाः परभोगेषु ये नराः ।\nएवंयुक्तसमाचाराः पुनर्जन्मनि शोभने\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2204264, "chapter_id": 5353, "verse_number": "२७", "content_sanskrit": "शोषव्याधियुतास्तत्र नरा धमनिसन्तताः ।\nभवन्त्येव नरा देवि पापकर्मोपभोगिनः\t ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2204265, "chapter_id": 5353, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2204266, "chapter_id": 5353, "verse_number": "२८", "content_sanskrit": "भगवन् मानुषाः केचित् क्लिश्यन्ते कुष्ठरोगिणः ।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि\t ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2204267, "chapter_id": 5353, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2204268, "chapter_id": 5353, "verse_number": "२९", "content_sanskrit": "ये पुरा मनुजा देवि परेषां रूपनाशनाः ।\nआघातवधबन्धैश्च वृथादण्डेन मोहिताः\t ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2204269, "chapter_id": 5353, "verse_number": "३०", "content_sanskrit": "इष्टनाशकरा ये तु अपथ्याहारदा नराः ।\nचिकित्सका वा दुष्टाश्च द्वेषलोभसमन्विताः\t ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2204270, "chapter_id": 5353, "verse_number": "३१", "content_sanskrit": "निर्दयाः प्राणिहिंसायां मलदाश्चित्तनाशनाः ।\nएवंयुक्तसमाचाराः पुनर्जन्मनि शोभने\t ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2204271, "chapter_id": 5353, "verse_number": "३२", "content_sanskrit": "यदि वै मानुषं जन्म लभेरंस्ते सुदुःखिताः ।\nअत्र ते क्लेशसंयुक्ताः कुष्ठरोगसमन्विताः\t ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2204272, "chapter_id": 5353, "verse_number": "३३", "content_sanskrit": "केचित् त्वग्दोषसंयुक्ता व्रणकुष्ठैश्च संयुताः ।\nश्वित्रकुष्ठयुता वाऽपि बहुधा कुष्ठसंयुताः ।\nभवन्त्येव नरा देवि यथा तेन कृतं फलम्\t ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2204273, "chapter_id": 5353, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2204274, "chapter_id": 5353, "verse_number": "३४", "content_sanskrit": "भगवन् मानुषाः केचिदङ्गहीनाश्च पङ्गवः ।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि\t ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2204275, "chapter_id": 5353, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2204276, "chapter_id": 5353, "verse_number": "३५", "content_sanskrit": "ये पुरा मनुजा देवि लोभमोहसमावृताः ।\nप्राणिनां प्राणहिंसार्थमङ्गविघ्नं प्रकुर्वते ।\nशस्त्रेणोत्कृत्य वा देवि प्राणिनां चेष्टनाशकाः\t ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2204277, "chapter_id": 5353, "verse_number": "३६", "content_sanskrit": "एवंयुक्तसमाचाराः पुनर्जन्मनि शोभने ।\nतदङ्गहीना वै प्रेत्य भवन्त्येव न संशयः ।\nस्वभावतो वा जाता वा पङ्गवश्च भवन्ति ते\t ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2204278, "chapter_id": 5353, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2204279, "chapter_id": 5353, "verse_number": "३७", "content_sanskrit": "भगवन् मानुषाः केचिद् ग्रन्थिभिः पिटकैस्तथा ।\nक्लिश्यमानाः प्रदृश्यन्ते तन्मे शंसितुमर्हसि\t ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2204280, "chapter_id": 5353, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2204281, "chapter_id": 5353, "verse_number": "३८", "content_sanskrit": "ये पुरा मनुजा देवि ग्रन्थिभेदकरा नृणाम् ।\nमुष्टिप्रहारपरुषा नृशंसाः पापकारिणः ।\nपाटकास्तोदकाश्चैव शूलतुन्नास्तथैव च\t ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2204282, "chapter_id": 5353, "verse_number": "३९", "content_sanskrit": "एवंयुक्तसमाचाराः पुनर्जन्मनि शोभने ।\nग्रन्थिभिः पिटकैश्चैव क्लिश्यन्ते भृशदुःखिताः\t ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2204283, "chapter_id": 5353, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2204284, "chapter_id": 5353, "verse_number": "४०", "content_sanskrit": "भगवन् मानुषाः केचित् पादरोगसमन्विताः ।\nदृश्यन्ते सततं देव तन्मे शंसितुमर्हसि\t ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2204285, "chapter_id": 5353, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2204286, "chapter_id": 5353, "verse_number": "४१", "content_sanskrit": "ये पुरा मनुजा देवि क्रोधलोभसमन्विताः ।\nमनुजा देवतास्थानं स्वपादैः संस्पृशन्त्युत ।\nजानुभिः पार्ष्णिभिश्चैव प्राणिहिंसां प्रकुर्वते\t ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2204287, "chapter_id": 5353, "verse_number": "४२", "content_sanskrit": "एवंयुक्तसमाचाराः पुनर्जन्मनि शोभने ।\nपादरोगैर्बहुविधैर्बाध्यन्ते श्लीपदादिभिः\t ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2204288, "chapter_id": 5353, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2204289, "chapter_id": 5353, "verse_number": "४३", "content_sanskrit": "भगवन् मानुषाः केचिद् दृश्यन्ते बहवो भुवि ।\nवातजैः पित्थजै रोगैर्युगपत् सान्निपातकैः\t ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2204290, "chapter_id": 5353, "verse_number": "४४", "content_sanskrit": "रोगैर्बहुविधैर्देव क्लिश्यमानाः सुदुःखिताः ।\nअसमस्तैः समस्तैश्च आढ्या वा दुर्गतास्तथा ।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि\t ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2204291, "chapter_id": 5353, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2204292, "chapter_id": 5353, "verse_number": "४५", "content_sanskrit": "तदहं ते प्रवक्ष्यामि शृणु कल्याणि कारणम्\t ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2204293, "chapter_id": 5353, "verse_number": "४६", "content_sanskrit": "ये पुरा मनुजा देवि स्वधर्मनिरताः सदा ।\nस्ववशाः कोपनपरा गुरुविद्वेषिणस्तथा\t ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2204294, "chapter_id": 5353, "verse_number": "४७", "content_sanskrit": "परेषां दुःखजनका मनोवाक्कायकर्मभिः ।\nछिन्दन् भिन्दन् तुदन्नेव नित्यं प्राणिषु निर्दयाः\t ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2204295, "chapter_id": 5353, "verse_number": "४८", "content_sanskrit": "एवंयुक्तसमाचाराः पुनर्जन्मनि शोभने ।\nयदि वै मानुषं जन्म लभेरंस्ते तथाविधाः ।\nतत्र ते बहुभिर्घोरैस्तप्यन्ते व्याधिभिः प्रिये\t ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2204296, "chapter_id": 5353, "verse_number": "४९", "content_sanskrit": "केचिद् द्विपादसंयुक्ताः केचित् काससमन्विताः ।\nज्वरातिसारतृष्णाभिः पीड्यमानास्तथा परे\t ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2204297, "chapter_id": 5353, "verse_number": "५०", "content_sanskrit": "वातगुल्मैश्च बहुभिः श्लेष्मदोषसमन्विताः ।\nपादरोगैश्च विविधैर्व्रणकुष्ठभगन्दरैः ।\nआढ्या वा दुर्गता वाऽपि दृश्यन्ते व्याधिपीडिताः\t ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2204298, "chapter_id": 5353, "verse_number": "५१", "content_sanskrit": "एवमात्मकृतं कर्म भुञ्जन्ते तत्रतत्र वै ।\nगूहितुं न हि शक्यं वै केनचित् स्वकृतं फलम् ।\nइति ते कथितं देवि भूयः श्रोतुं किमिच्छसि\t ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2204299, "chapter_id": 5353, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nअनुशासनपर्वणि दानधर्मे मानुषाणां नाना व्याधिनिमित्तकथनं नाम चतुरधिकद्विशततमोऽध्यायः ॥२०४॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]