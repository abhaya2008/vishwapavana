[{"id": 2206029, "chapter_id": 5387, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2206030, "chapter_id": 5387, "verse_number": "१", "content_sanskrit": "क उपायो वरप्राप्तौ सर्वेषां पापकर्मणाम् ।\nज्ञानस्य च परस्येह तन्मे ब्रूहि पितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2206031, "chapter_id": 5387, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2206032, "chapter_id": 5387, "verse_number": "२", "content_sanskrit": "उपायोऽयं वरप्राप्तौ परमः परिकीर्तितः ।\nनारायणस्य तु ध्यानमर्चनं यजनं स्तुतिः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2206033, "chapter_id": 5387, "verse_number": "३", "content_sanskrit": "श्रवणं तत्कथानां च विद्वत्संरक्षणं तथा ।\nविद्वच्छुश्रूषणप्रीतिरुपदेशानुपालनम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2206034, "chapter_id": 5387, "verse_number": "४", "content_sanskrit": "सन्ध्यानेन जपेनाशु मुच्यते प्राकृतोऽपि च ।\nजपश्चतुर्विधः प्रोक्तो वैदिकस्तान्त्रिकोऽपि च ।\nपौरस्तिकोऽर्थो विद्वद्भिः कथितः स्मार्त एव च\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2206035, "chapter_id": 5387, "verse_number": "५", "content_sanskrit": "द्विजशुश्रूषया ज्ञानं विद्वत्संरक्षणेन वा ।\nनासाध्यं ज्ञानिनां किञ्चित् तस्माद् रक्ष्या द्विजास्त्वया\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2206036, "chapter_id": 5387, "verse_number": "६", "content_sanskrit": "सुव्रता बन्धुहीनैका वने पूर्वं यमेन तु ।\nआसीदाश्वासिता विद्वत्संरक्षणफलात् किल\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2206037, "chapter_id": 5387, "verse_number": "७", "content_sanskrit": "विप्रस्य मरणे हेतुस्तत्पत्नीपितृशोकदा ।\nवैश्या त्वमतिलाभोऽयं विप्रकन्येति साम्प्रतम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2206038, "chapter_id": 5387, "verse_number": "८", "content_sanskrit": "इत्युक्ताश्वासितापृच्छत् केनैवं पापसंयुता ।\nजाता विप्रकुले सम्यक् श्रेयश्चापि ब्रवीहि मे\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2206039, "chapter_id": 5387, "verse_number": "", "content_sanskrit": "यमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2206040, "chapter_id": 5387, "verse_number": "९", "content_sanskrit": "अन्यजन्मनि विद्वांसं प्रहारैरभिपीडितम् ।\nचोरशङ्काविमोक्षेण मोक्षयित्वा सुजन्मिका\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2206041, "chapter_id": 5387, "verse_number": "१०", "content_sanskrit": "इत्युक्ताष्टाक्षरध्यानजपादिश्रेयसा तु सा ।\nयमेनानुगृहीताऽभूत् पुण्यलोकनिवासिनी\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2206042, "chapter_id": 5387, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2206043, "chapter_id": 5387, "verse_number": "११", "content_sanskrit": "तन्नित्यं विदुषां रक्षातत्परो भव भूपते ।\nतेषां संरक्षणात् तुष्टः सर्वपापैः प्रमुच्यते\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2206044, "chapter_id": 5387, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे सुव्रताख्यानं नाम अष्टत्रिंशोत्तरद्विशततमोऽध्यायः ॥२३८॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]