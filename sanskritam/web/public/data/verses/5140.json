[{"id": 2194828, "chapter_id": 5140, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2194829, "chapter_id": 5140, "verse_number": "१", "content_sanskrit": "अतिभारोद्यतस्यैव भारापनयनं महत् ।\nपराश्वासकरं वाक्यमिदं मे भवतः श्रुतम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2194830, "chapter_id": 5140, "verse_number": "२", "content_sanskrit": "अध्वक्लान्तस्य शयनं स्थानक्लान्तस्य चासनम् ।\nतृषितस्य च पानीयं क्षुधार्तस्य च भोजनम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2194831, "chapter_id": 5140, "verse_number": "३", "content_sanskrit": "ईप्सितस्येव सम्प्राप्तिरन्नस्य समयेऽतिथेः ।\nएषितस्यात्मनः काले वृद्धस्येव सुतो यथा\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2194832, "chapter_id": 5140, "verse_number": "४", "content_sanskrit": "मनसा चिन्तितस्येव प्रीतिस्निग्धस्य दर्शनम् ।\nप्रह्रादयति मां वाक्यं भवता यदुदीरितम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2194833, "chapter_id": 5140, "verse_number": "५", "content_sanskrit": "दत्तचक्षुरिवाकाशे पश्यामि विमृशामि च ।\nप्रज्ञानवचनाद्योऽयमुपदेशो हि मे कृतः ।\nबाढमेवं करिष्यामि यथा मां भाषते भवान्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2194834, "chapter_id": 5140, "verse_number": "६", "content_sanskrit": "इहेमां रजनीं साधो निवसस्व मया सह ।\nप्रभाते यास्यति भवान् पर्याश्वस्तः सुखोषितः॥\nअसौ हि भगवान् सूर्यो मन्दरश्मिरवाङ्मुखः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2194835, "chapter_id": 5140, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2194836, "chapter_id": 5140, "verse_number": "७", "content_sanskrit": "ततस्तेन कृतातिथ्यः सोऽतिथिः शत्रुसूदन ।\nउवास किल तां रात्रिं सह तेन द्विजेन वै\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2194837, "chapter_id": 5140, "verse_number": "८", "content_sanskrit": "तत्तच्च धर्मसंयुक्तं तयोः कथयतोस्तदा ।\nव्यतीता सा निशा कृत्स्ना सुखेन दिवसोपमा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2194838, "chapter_id": 5140, "verse_number": "९", "content_sanskrit": "ततः प्रभातसमये सोऽतिथिस्तेन पूजितः ।\nब्राह्मणेन यथाशक्त्या स्वकार्यमभिकाङ्क्षता\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2194839, "chapter_id": 5140, "verse_number": "१०", "content_sanskrit": "ततः स विप्रः कृतधर्मनिश्चयः\nकृताभ्यनुज्ञः स्वजनेन धर्मवित् ।\nयथोपदिष्टं भुजगेन्द्रसंश्रयं\nजगाम काले सुकृतैकनिश्चयः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2194840, "chapter_id": 5140, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे एकोननवत्युत्तरशततमोऽध्यायः ॥१८९॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]