[{"id": 50026104, "chapter_id": 12060, "verse_number": "1", "content_sanskrit": "आदिबीजं स्थिराशेषज्ञानबीजं विमुक्तिदम्। सर्वपापक्षयकरं सर्वव्याधिविनाशनम्॥ ४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50026105, "chapter_id": 12060, "verse_number": "2", "content_sanskrit": "ध्यायेच्छशाङ्कशतकोट्यतिसौख्यकान्तिं संसिच्यमानममृतोरुघटैः सुरेशैः। वर्णाभिमानिभिरजेशमुखैः सहैव पञ्चाशता प्रतिगिरन्तमशेषविद्याः॥ ४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}]