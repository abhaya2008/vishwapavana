[{"id": 2100168, "chapter_id": 3146, "verse_number": "१४-२-१", "content_sanskrit": "वैशम्पायन उवाच।\nएवमुक्तस्तु राजाऽसौ धृतराष्ट्रेण धीमता।\nतूष्णींबभूव मेधावी तमुवाचाथ केशवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2100169, "chapter_id": 3146, "verse_number": "१४-२-२", "content_sanskrit": "अतीव मनसा शोकः क्रियमाणो जनाधिप।\nसन्तपयति चैतस्य पूर्वप्रेतान्पितामहान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2100170, "chapter_id": 3146, "verse_number": "१४-२-३", "content_sanskrit": "यजस्व विविधैर्यज्ञैर्बहुभिः स्वाप्तदक्षिणैः।\nदेवांस्तर्पय सोमेन स्वधया च पितॄनपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2100171, "chapter_id": 3146, "verse_number": "१४-२-४", "content_sanskrit": "अतिथीनन्नपानेन कामैरन्यैरकिञ्चनान्।\n`त्वद्विधस्य महाबुद्धे नैतदद्योपपद्यते।\nविदितं वेदितव्यं ते कर्तव्यमपि ते कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2100172, "chapter_id": 3146, "verse_number": "१४-२-५", "content_sanskrit": "श्रुताश्च राजधर्मास्ते भीष्माद्भागीरथीसुतात्।\nकृष्णद्वैपायनाच्चैव नारदाद्विदुरात्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2100173, "chapter_id": 3146, "verse_number": "१४-२-६", "content_sanskrit": "नेमामर्हसि मूढानां वृत्तिं त्वमनुवर्तितुम्।\nपितृपैतामहं वृत्तमास्थाय धुरमुद्वह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2100174, "chapter_id": 3146, "verse_number": "१४-२-७", "content_sanskrit": "युक्तं हि यशसा क्षात्रं स्वर्गं प्राप्तुमसंशयम्।\nनहि कश्चिद्धि शूरणां निहतोऽत्र पराङ्मुखः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2100175, "chapter_id": 3146, "verse_number": "१४-२-८", "content_sanskrit": "त्यज शोकं महाराज भवितव्यं हि तत्तथा।\nन शक्यास्ते पुनर्द्रष्टुं त्वया येऽस्मिन्रणे हताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2100176, "chapter_id": 3146, "verse_number": "१४-२-९", "content_sanskrit": "एतावदुक्त्वा गोविन्दो धर्मराजं युधिष्ठिरम्।\nविरराम महातेजास्तमुवाच युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2100177, "chapter_id": 3146, "verse_number": "१४-२-१०", "content_sanskrit": "गोविन्द मयि या प्रीतिस्तव सा विदिता मम।\nसौहृदेन तथा प्रेम्णा सदा मय्यनुकम्पसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2100178, "chapter_id": 3146, "verse_number": "१४-२-११", "content_sanskrit": "प्रियं तु मे स्यात्सुमहत्कृतं चक्रगदाधर।\nश्रीमन्प्रीतेन मनसाक सर्वं यादवनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2100179, "chapter_id": 3146, "verse_number": "१४-२-१२", "content_sanskrit": "यदि मामनुजानीयाद्भवान्गन्तुं तपोवनम्।\n`कृतकृत्यो भविष्यामि इति मे निश्चिता मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2100180, "chapter_id": 3146, "verse_number": "१४-२-१३", "content_sanskrit": "न हि शान्तिं प्रपश्यामि पातयित्वा पितामहम्।\n`नृशंसः पुरुषव्याघ्रं गुरुं वीर्यबलान्वितम्।\nकर्णं च पुरुषव्याघ्नं सङ्ग्रामेष्वपलायिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2100181, "chapter_id": 3146, "verse_number": "१४-२-१४", "content_sanskrit": "कर्मणा येन मुच्येयमस्मात्क्रूरादरिंदम।\nकर्मणा तद्विधत्स्वेह येन शुध्यति मे मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2100182, "chapter_id": 3146, "verse_number": "१४-२-१५", "content_sanskrit": "तमेवंवादिनं पार्थं व्यासः प्रोवाच धर्मवित्।\nसान्त्वयन्सुमहातेजाः शुभं वचनमर्थवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2100183, "chapter_id": 3146, "verse_number": "१४-२-१६", "content_sanskrit": "सुकृता ते मतिस्तात पुनर्बाल्येन मुह्यसे।\nकिमाकाशे वयं सर्वे प्रलपामो मुहुर्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2100184, "chapter_id": 3146, "verse_number": "१४-२-१७", "content_sanskrit": "विदिताः क्षत्रधर्मास्ते येषां युद्धेन जीविका।\nतथा प्रवृत्तो नृपतिर्नाधिबन्धेन युज्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2100185, "chapter_id": 3146, "verse_number": "१४-२-१८", "content_sanskrit": "मोक्षधर्माश्च निखिला याथातथ्येन ते श्रुताः।\n`यथा वै कामजां मायां परित्युक्तं त्वमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2100186, "chapter_id": 3146, "verse_number": "१४-२-१९", "content_sanskrit": "असकृच्चापि सन्देहाश्छिन्नास्ते कामजा मया।\nअश्रद्दधानो दुर्मेधा लुप्तस्मृतिरसि ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2100187, "chapter_id": 3146, "verse_number": "१४-२-२०", "content_sanskrit": "मैवं भव न ते युक्तमिदमज्ञानमीदृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2100188, "chapter_id": 3146, "verse_number": "१४-२-२१", "content_sanskrit": "प्रायश्चित्तानि सर्वाणि विदितानि च तेऽनघ।\nराजधर्माश्च ते सर्वे दानधर्माश्च ते श्रुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2100189, "chapter_id": 3146, "verse_number": "१४-२-२२", "content_sanskrit": "स कथं सर्वधर्मज्ञः सर्वागमविशारदः।\nपरिमुह्यसि भूयस्त्वमज्ञानादिव भारत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2100190, "chapter_id": 3146, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अश्वमेधपर्वणि द्वितीयोऽध्यायः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]