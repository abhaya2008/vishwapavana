[{"id": 2088261, "chapter_id": 2878, "verse_number": "१३-८-१", "content_sanskrit": "युधिष्ठिर उवाच।\nश्रुतं मे महदाख्यानमेतत्कुरुकुलोद्वह।\nसुदुष्प्रापं यद्ब्रवीषि ब्राह्मण्यं वदतांवर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2088262, "chapter_id": 2878, "verse_number": "१३-८-२", "content_sanskrit": "विश्वामिइत्रो महाराज राजा ब्राह्मणतां गतः।\nकथितं भवता सर्वं विस्तरेण पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2088263, "chapter_id": 2878, "verse_number": "१३-८-३", "content_sanskrit": "तच्च राजन्मया सर्वं श्रुतं बुद्धिमतांवर।\nआगमो हि परोऽस्माकं त्वत्तः कौरवनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2088264, "chapter_id": 2878, "verse_number": "१३-८-४", "content_sanskrit": "वीतहव्यश्च नृपतिः श्रुतो मे विप्रतां गतः।\nतदेव तावद्गाङ्गेय श्रोतुमिच्छाम्यहं विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2088265, "chapter_id": 2878, "verse_number": "१३-८-५", "content_sanskrit": "स केन कर्मणा प्राप्तो ब्राह्मण्यं राजसत्तमः।\nवरेण तपसा वाऽपि तन्मे व्याख्यातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2088266, "chapter_id": 2878, "verse_number": "१३-८-६x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2088267, "chapter_id": 2878, "verse_number": "१३-८-६", "content_sanskrit": "शृणु राजन्यथा राजा वीतहव्यो महायशाः।\nराजर्षिर्दुर्लभं प्राप्तो ब्राह्मण्यं लोकसत्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2088268, "chapter_id": 2878, "verse_number": "१३-८-७", "content_sanskrit": "मनोर्महात्मनस्तात प्रजा धर्मेण शासतः।\nबभूव पुत्रो धर्मात्मा शर्यातिरिति विश्रुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2088269, "chapter_id": 2878, "verse_number": "१३-८-८", "content_sanskrit": "तस्यान्ववाये द्वौ राजन्राजानौ सम्बभूवतुः।\nहैहयस्तालजङ्घश्च वत्सेषु जयतांवर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2088270, "chapter_id": 2878, "verse_number": "१३-८-९", "content_sanskrit": "हैहयस्य तु राजेन्द्र दशसु स्त्रीषु भारत।\nशतं बभूव पुत्राणां शूराणामनिवर्तिनाम्।\nतुल्यरूपप्रभावानां बलिनां युद्धशालिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2088271, "chapter_id": 2878, "verse_number": "१३-८-१०", "content_sanskrit": "धनुर्वेदे च वेदे च सर्वत्रैव कृतश्रमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2088272, "chapter_id": 2878, "verse_number": "१३-८-११", "content_sanskrit": "काशिष्वपि नृपो राजन्दिवोदासपितामहः।\nहर्यश्व इति विख्यातो बभूव जयतांवरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2088273, "chapter_id": 2878, "verse_number": "१३-८-१२", "content_sanskrit": "स वीतहव्यदायादैरागत्य पुरुषर्षभ।\nगङ्गायमुनयोर्मध्ये सङ्ग्रामे विनिपातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2088274, "chapter_id": 2878, "verse_number": "१३-८-१३", "content_sanskrit": "तं तु हत्वा नरपतिं हैहयास्ते महारथाः।\nप्रतिजग्मुः पुरीं रम्यां वत्सानामकुतोभयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2088275, "chapter_id": 2878, "verse_number": "१३-८-१४", "content_sanskrit": "हर्यश्वस्य च दायादः काशिराजोऽभ्यषिच्यत।\nसुदेवो देवसंकाशः साक्षाद्धर्म इवापरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2088276, "chapter_id": 2878, "verse_number": "१३-८-१५", "content_sanskrit": "स पालयामास महीं धर्मात्मा काशिनन्दनः।\nतैर्वीतहव्यैरागत्य युधि सर्वैर्विनिर्जितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2088277, "chapter_id": 2878, "verse_number": "१३-८-१६", "content_sanskrit": "तमथाजौ विनिर्जित्य प्रतिजग्मुर्यथागतम्।\nसौदेविस्त्वथ काशीशोदिवोदासोऽभ्यषिच्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2088278, "chapter_id": 2878, "verse_number": "१३-८-१७", "content_sanskrit": "दिवोदासस्तु विज्ञाय वीर्य तेषां यतात्मनाम्।\nवाराणसीं महातेजा निर्ममे शक्रशासनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2088279, "chapter_id": 2878, "verse_number": "१३-८-१८", "content_sanskrit": "विप्रक्षत्रियसम्बाधां वैश्यशूद्रसमाकुलाम्।\nनैकद्रव्योच्चयवतीं समृद्धविपणापणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2088280, "chapter_id": 2878, "verse_number": "१३-८-१९", "content_sanskrit": "गङ्गाया उत्तरे कूले वप्रान्ते राजसत्तम्॥\nगोमत्या दक्षिणे कूले शक्रस्येवामरावतीम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2088281, "chapter_id": 2878, "verse_number": "१३-८-२०", "content_sanskrit": "तत्र तं राजशार्दूलं निवसन्तं महीपतिम्।\nआगत्य हैहया भूयः पर्यधावन्त भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2088282, "chapter_id": 2878, "verse_number": "१३-८-२१", "content_sanskrit": "स निष्क्रम्य ददौ युद्धं तेभ्यो राजा महाबलः।\nदेवासुरसमं घोरं दिवोदासो महाद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2088283, "chapter_id": 2878, "verse_number": "१३-८-२२", "content_sanskrit": "स तु युद्धे महाराज दिनानां दशतीर्दश।\nहतवाहनभूयिष्ठस्ततो दैन्यमुपागमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2088284, "chapter_id": 2878, "verse_number": "१३-८-२३", "content_sanskrit": "हतयोधस्ततो राजन्क्षीणकोशश्चक भूमिपः।\nदिवोदासः पुरीं त्यक्त्वा पलायनपरोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2088285, "chapter_id": 2878, "verse_number": "१३-८-२४", "content_sanskrit": "गत्वाऽऽश्रमपदं रम्यं भरद्वाजस्य धीमतः।\nजगाम शरणं राजा कृताञ्जलिररिंदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2088286, "chapter_id": 2878, "verse_number": "१३-८-२५", "content_sanskrit": "तमुवाच भरद्वाजो ज्येष्ठः पुत्रो बृहस्पतेः।\nपुरोधाः शीलसम्पन्नो दिवोदासं महीपतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2088287, "chapter_id": 2878, "verse_number": "१३-८-२६", "content_sanskrit": "किमागमनकृत्यं ते सर्वं प्रबूहि मे नृप।\nयत्ते प्रियं तत्करिष्ये न मेऽत्रास्ति विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2088288, "chapter_id": 2878, "verse_number": "१३-८-२७x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2088289, "chapter_id": 2878, "verse_number": "१३-८-२७", "content_sanskrit": "भगवन्वैतहव्यैर्मे युद्धे वंशः प्रणाशितः।\nअहमेकः परिद्यूनो भवन्तं शरणं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2088290, "chapter_id": 2878, "verse_number": "१३-८-२८", "content_sanskrit": "शिष्यस्नेहेन भगवंस्त्वं मां रक्षितुमर्हसि।\nएकशेषः कृतो वंशो मम तैः पापकर्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2088291, "chapter_id": 2878, "verse_number": "१३-८-२९", "content_sanskrit": "तमुवाच महाभागो भरद्वाजः प्रतापवान्।\nन भेतव्यं न भेतव्यं सौदेव व्येतु ते भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2088292, "chapter_id": 2878, "verse_number": "१३-८-३०", "content_sanskrit": "अहमिष्टिं करिष्यामि पुत्रार्थं ते विशाम्पते।\nवीतहव्यसहस्राणि येन त्वं प्रहरिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2088293, "chapter_id": 2878, "verse_number": "१३-८-३१", "content_sanskrit": "तत इष्टिं चकारर्षिस्तस्य वै पुत्रकामिकीम्।\nअथास्य तनयो जज्ञे दैवोदासः प्रतर्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2088294, "chapter_id": 2878, "verse_number": "१३-८-३२", "content_sanskrit": "स जातमात्रो ववृधे समाः सद्यस्त्रयोदश।\nवेदं चापि जगौ कृत्स्नं धनुर्वेदं च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2088295, "chapter_id": 2878, "verse_number": "१३-८-३३", "content_sanskrit": "योगेन च *****विष्टो भरद्वाजेन धीमता।\nकृत्स्नं हि तेजो यल्लोके तदेतद्देहमाविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2088296, "chapter_id": 2878, "verse_number": "१३-८-३४", "content_sanskrit": "ततः स कवची धन्वी स्तूयमानः सुरर्षिभिः।\nबन्दिभिर्वन्द्यमानश्च बभौ सूर्य इवोदितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2088297, "chapter_id": 2878, "verse_number": "१३-८-३५", "content_sanskrit": "स रथी बद्धनिस्त्रिंशो बभौ दीप्त इवानलः।\nप्रययौ स धनुर्धुन्वन्विवर्षिषुरिवाम्बुदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2088298, "chapter_id": 2878, "verse_number": "१३-८-३६", "content_sanskrit": "तं दृष्ट्वा परमं हर्षं सुदेवतनयो ययौ।\nमेने च मनसा दग्धान्वैतहव्यान्स पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2088299, "chapter_id": 2878, "verse_number": "१३-८-३७", "content_sanskrit": "ततोसौ यौवराज्ये च स्थापयित्वा प्रतर्दनम्।\nकृतकृत्यं तदाऽऽत्मानं स राजा प्रत्यपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2088300, "chapter_id": 2878, "verse_number": "१३-८-३८", "content_sanskrit": "ततस्तु वैतहव्यानां वधाय स महीपतिः।\nपुत्रं प्रस्थापयासास प्रतर्दनमरिंदमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2088301, "chapter_id": 2878, "verse_number": "१३-८-३९", "content_sanskrit": "सरथः स तु संतीर्य गङ्गामाशु पराक्रमी।\nप्रययौ वीतहव्यानां पुरीं परपुरंजयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2088302, "chapter_id": 2878, "verse_number": "१३-८-४०", "content_sanskrit": "वैतहव्यास्तु संश्रुत्य रथघोषं समुद्धतम्।\nनिर्ययुर्नगराकारै रथैः पररथारुजैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2088303, "chapter_id": 2878, "verse_number": "१३-८-४१", "content_sanskrit": "निष्क्रम्य ते नरव्याघ्रा दंशिताश्चित्रयोधिनः।\nप्रतर्दनं समाजग्मुः शरवर्षैरुदायुधाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2088304, "chapter_id": 2878, "verse_number": "१३-८-४२", "content_sanskrit": "शस्त्रैश्च विविधाकारै रथौघैश्च युधिष्ठिर।\nअभ्यवर्षन्त राजानं हिमवन्तमिवाम्बुदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2088305, "chapter_id": 2878, "verse_number": "१३-८-४३", "content_sanskrit": "अस्त्रैरस्त्राणि संवार्य तेषां राजा प्रतर्दनः।\nजघान तान्महातेजा वज्रानलसमैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2088306, "chapter_id": 2878, "verse_number": "१३-८-४४", "content_sanskrit": "कृत्तोत्तमाङ्गास्ते राजन्भल्लैः शतसहस्रशः।\nअपतन्रुधिरार्द्राङ्गा निकृत्ता इव किंशुकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2088307, "chapter_id": 2878, "verse_number": "१३-८-४५", "content_sanskrit": "हतेषु तेषु सर्वेषु वीतहव्यः सुतेष्वथ।\nप्राद्रवन्नगरं हित्वा भृगोराश्रममप्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2088308, "chapter_id": 2878, "verse_number": "१३-८-४६", "content_sanskrit": "ययौ भृगुं च शरणं वीतहव्यो नराधिपः।\nअभयं च ददौ तस्मै वीतहव्याय भार्गवः।\nआसनं शिष्यमध्ये च भृगुरन्यत्समादिशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2088309, "chapter_id": 2878, "verse_number": "१३-८-४७", "content_sanskrit": "अथानुपदमेवाशु तत्रागच्छत्प्रतर्दनः।\nस प्राप्य चाश्रमपदं दिवोदासात्मजोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2088310, "chapter_id": 2878, "verse_number": "१३-८-४८", "content_sanskrit": "भोभो केऽत्राश्रमे सन्ति भृगोः शिष्या महात्मनः।\nद्रष्टुमिच्छे मुनिमहं तस्याचक्षत मामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2088311, "chapter_id": 2878, "verse_number": "१३-८-४९", "content_sanskrit": "स तं विदित्वा तु भृगुर्निश्चक्रामाश्रमात्तदा।\nपूजयामास च ततो विधिना नृपसत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2088312, "chapter_id": 2878, "verse_number": "१३-८-५०", "content_sanskrit": "उवाच चैनं राजेन्द्र किं कार्यं ब्रूहि पार्थिव।\nस चोवाच नृपस्तस्मै यदागमनकारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2088313, "chapter_id": 2878, "verse_number": "१३-८-५१x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2088314, "chapter_id": 2878, "verse_number": "१३-८-५१", "content_sanskrit": "अयं ब्रह्मन्नितो राजा वीतहव्यो विसर्ज्यताम्।\nअस्य पुत्रैर्हि मे कृत्स्नो ब्रह्मन्वंशः प्रणाशितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2088315, "chapter_id": 2878, "verse_number": "१३-८-५२", "content_sanskrit": "उत्सादितश्च विषयः काशीनां रत्नसञ्चयः।\nएतस्य वीर्यदृप्तस्य हतं पुत्रशतं मया।\nअस्येदानीं वधादद्य भविष्याम्यनृणः पितुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2088316, "chapter_id": 2878, "verse_number": "१३-८-५३", "content_sanskrit": "तमुवाच कृपाविष्टो भृगुर्धर्मभृतांवरः।\nनेहास्ति क्षत्रियः कश्चित्सर्वे हीमे द्विजातयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2088317, "chapter_id": 2878, "verse_number": "१३-८-५४", "content_sanskrit": "एतत्तु वचनं श्रुत्वा भृगोस्तथ्यं प्रतर्दनः।\nपादावुपस्पृश्य शनैः प्रहृष्टो वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2088318, "chapter_id": 2878, "verse_number": "१३-८-५५", "content_sanskrit": "एवमप्यस्मि भगवन्कृतकृत्यो न संशयः।\nय एष राजा वीर्येण स्वजातिं त्याजितो मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2088319, "chapter_id": 2878, "verse_number": "१३-८-५६", "content_sanskrit": "अनुजानीहि मां ब्रह्मन्ध्यायस्व च शिवेन माम्।\nत्याजितो हि मया जातिमेव राजा भृगूद्वह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2088320, "chapter_id": 2878, "verse_number": "१३-८-५७", "content_sanskrit": "ततस्तेनाभ्यनुज्ञातो ययौ राजा प्रतर्दनः।\nयथागतं महाराज मुक्त्वा विषमिवोरगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2088321, "chapter_id": 2878, "verse_number": "१३-८-५८", "content_sanskrit": "भृगोर्वचनमात्रेण स च ब्रह्मर्षितां गतः।\nवीतहव्यो महाराज ब्रह्मवादित्वमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2088322, "chapter_id": 2878, "verse_number": "१३-८-५९", "content_sanskrit": "तस्य गृत्समदः पुत्रो रूपेणेन्द्र इवापरः।\nशक्रस्त्वमिति यो दैत्यैर्निगृहीतः किलाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2088323, "chapter_id": 2878, "verse_number": "१३-८-६०", "content_sanskrit": "ऋग्वेदे वर्तते चाग्र्या श्रुतिर्यस्य महात्मनः।\nयत्र गृत्समदो राजन्ब्राह्मणैः स महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2088324, "chapter_id": 2878, "verse_number": "१३-८-६१", "content_sanskrit": "स ब्रह्मचारी विप्रर्षिः श्रीमान्गृत्समदोऽभवत्।\nपुत्रो गृत्समदस्यापि विप्रः सावैनसोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2088325, "chapter_id": 2878, "verse_number": "१३-८-६२", "content_sanskrit": "सावैनसस्य पुत्रो वै वितस्त्यस्तस्य चात्मजः।\nवितस्त्यस्य सुतस्तस्य शिवस्तश्चात्मजोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2088326, "chapter_id": 2878, "verse_number": "१३-८-६३", "content_sanskrit": "श्रवास्तस्य सुतश्चर्षिः श्रवसश्चाभवत्तमः।\nतमसश्च प्रकाशोऽभूत्तनयो द्विजसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2088327, "chapter_id": 2878, "verse_number": "१३-८-६४", "content_sanskrit": "प्रकाशस्य च वागिन्द्रो बभूव जयतांवरः।\nतस्यात्मजश्च प्रमितिर्वेदवेदाङ्गपारगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2088328, "chapter_id": 2878, "verse_number": "१३-८-६५", "content_sanskrit": "घृताच्यां तस्य पुत्रस्तु रुरुर्नामोदपद्यत।\nप्रमद्वरायां तु रुरोः पुत्रः समुदपद्यत।\nशुनको नाम विप्रर्षिर्यस्य पुत्रोऽथ शौनकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2088329, "chapter_id": 2878, "verse_number": "१३-८-६६", "content_sanskrit": "एवं विप्रत्वमगमद्वीतहव्यो नराधिपः।\nभृगोः प्रसादाद्राजेन्द्र क्षत्रियः क्षत्रियर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2088330, "chapter_id": 2878, "verse_number": "१३-८-६७", "content_sanskrit": "एष ते कथितो वंशो राजन्गार्त्समदो मया।\nविस्तरेण महाराज किमन्यदनुपृच्छसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2088331, "chapter_id": 2878, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि अष्टमोऽध्यायः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]