[{"id": 2008758, "chapter_id": 1170, "verse_number": "१-१७१-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2008759, "chapter_id": 1170, "verse_number": "१-१७१-१", "content_sanskrit": "एकचक्रां गतास्ते तु कुन्तीपुत्रा महारथाः।\nअत ऊर्ध्वं द्विजश्रेष्ठ किमकुर्वत पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2008760, "chapter_id": 1170, "verse_number": "१-१७१-२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2008761, "chapter_id": 1170, "verse_number": "१-१७१-२", "content_sanskrit": "एकचक्रां गतास्ते तु कन्तीपुत्रा महारथाः।\nऊषुर्नातिचिरं कालं ब्राह्मणस्य निवेशने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2008762, "chapter_id": 1170, "verse_number": "१-१७१-३", "content_sanskrit": "रमणीयानि पश्यन्तो वनानि विविधानि च।\nपार्थिवानपि चोद्देशान्सरितश्च सरांसि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2008763, "chapter_id": 1170, "verse_number": "१-१७१-४", "content_sanskrit": "चेरुर्भैश्रं तदा ते तु सर्व एव विशांपते।\nयुधिष्ठिरं च कुन्तीं च चिन्तयन्त उपासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2008764, "chapter_id": 1170, "verse_number": "१-१७१-५", "content_sanskrit": "भैक्षं चरन्तस्तु तदा जटिला ब्रह्मचारिणः।\nबभूवुर्नागराणां च गुणैः संप्रियदर्शनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2008765, "chapter_id": 1170, "verse_number": "१-१७१-६x", "content_sanskrit": "नागरा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2008766, "chapter_id": 1170, "verse_number": "१-१७१-६", "content_sanskrit": "दर्शनीया द्विजाः शुभ्रा देवगर्भोपमाः शुभाः।\nभैक्षानर्हाश्च राज्यार्हाः सुकुमारास्तपस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2008767, "chapter_id": 1170, "verse_number": "१-१७१-७", "content_sanskrit": "नैते यथार्थतो विप्राः सुकुमारास्तपस्विनः।\nचरन्ति भूमौ प्रच्छन्नाः कस्माच्चित्कारणादिह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2008768, "chapter_id": 1170, "verse_number": "१-१७१-८", "content_sanskrit": "सर्वलक्षणसंपन्ना भैक्षं नार्हन्ति नित्यशः।\nकार्यार्थिनश्चरन्तीति तर्कयन्त इति ब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2008769, "chapter_id": 1170, "verse_number": "१-१७१-९", "content_sanskrit": "बन्धूनामागमान्नित्यमुपचारैस्तु नागराः।\nभाजनानि च पूर्णानि भक्ष्यभोज्यैरकारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2008770, "chapter_id": 1170, "verse_number": "१-१७१-१०", "content_sanskrit": "मौनव्रतेन संयुक्ता भैश्रं गृह्णन्ति पाण्डवाः।\nमाता चिरगतान्ज्ञात्वा शोचन्ती पाण्डवान्प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2008771, "chapter_id": 1170, "verse_number": "१-१७१-११", "content_sanskrit": "दुःखाश्रुपूर्णनयना लिखन्त्यास्ते महीतलम्।\nभिक्षित्वा द्विजगेहेषु चिन्तयन्तश्च मातरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2008772, "chapter_id": 1170, "verse_number": "१-१७१-१२", "content_sanskrit": "त्वरमाणा निवर्तन्ते मातृगौरवयन्त्रिताः।\nमात्रे निवेदयन्ति स्म कुन्त्यै भैक्षं दिवानिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2008773, "chapter_id": 1170, "verse_number": "१-१७१-१३", "content_sanskrit": "सर्वं संपूर्णभैक्षान्नं मातृदत्तं पृथक्पृथक्।\nविभज्याभुञ्जतेष्टं ते यथाभागं पृथक्पृथक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2008774, "chapter_id": 1170, "verse_number": "१-१७१-१४", "content_sanskrit": "अर्धं स्म भुञ्जते पञ्च सह मात्रा परन्तपाः।\nअर्धं सर्वस्य भैक्षस्य भीमो भुङ्क्ते महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2008775, "chapter_id": 1170, "verse_number": "१-१७१-१५", "content_sanskrit": "स नाशितश्च भवति कल्याणान्नभुजिः पुरा।\nस वैवर्ण्यं च कार्श्यं च जगामातृप्तिकारितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2008776, "chapter_id": 1170, "verse_number": "१-१७१-१६", "content_sanskrit": "आज्यबिन्दुर्यथा वह्नौ महति ज्वलिते भवेत्।\nतथार्धभागं भीमस्य भिक्षान्नस्य नरोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2008777, "chapter_id": 1170, "verse_number": "१-१७१-१७", "content_sanskrit": "तथैव वसतां तत्र तेषां राजन्महात्मनाम्।\nअतिचक्राम सुमहान्कालोऽथ भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2008778, "chapter_id": 1170, "verse_number": "१-१७१-१८", "content_sanskrit": "भीमोऽपि क्रीडयित्वाथ मिथो ब्राह्मणबन्धुषु।\nकुम्भकारेण संबन्धाल्लेभे पात्रं महत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2008779, "chapter_id": 1170, "verse_number": "१-१७१-१९", "content_sanskrit": "कुम्भकारोऽददात्पात्रं महत्कृत्वातिमात्रकम्।\nप्रहसन्भीमसेनाय विस्मितस्तस्य कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2008780, "chapter_id": 1170, "verse_number": "१-१७१-२०", "content_sanskrit": "तस्याद्भुतं कर्म कुर्वन्मृद्भारं महदाददे।\nमृद्भारैः शतसाहस्रैः कुम्भकारमतोषयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2008781, "chapter_id": 1170, "verse_number": "१-१७१-२१", "content_sanskrit": "चक्रे चक्रे च मृद्भाण्डान्सततं भैक्षमाचरन्।\nतदादायागतं दृष्ट्वा हसन्ति प्रहसन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2008782, "chapter_id": 1170, "verse_number": "१-१७१-२२", "content_sanskrit": "भक्ष्यभोज्यानि विविधान्यादाय प्रक्षिपन्ति च।\nएवमेव सदा भुक्त्वा मात्रे वदति वै रहः।\nन चाशितोऽस्मि भवति कल्याणान्नभृतः पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2008783, "chapter_id": 1170, "verse_number": "१-१७१-२३", "content_sanskrit": "ततः कदाचिद्भैक्षाय गतास्ते पुरषर्षभाः।\nसंगत्य भीमसेनस्तु तत्रास्ते पृथया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2008784, "chapter_id": 1170, "verse_number": "१-१७१-२४", "content_sanskrit": "अथार्तिजं महाशब्दं ब्राह्मणस्य निवेशने।\nभृशमुत्पतितं घोरं कुन्ती शुश्राव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2008785, "chapter_id": 1170, "verse_number": "१-१७१-२५", "content_sanskrit": "रोरुयमाणांस्तान्दृष्ट्वा परिदेवयतश्च सा।\nकारुण्यात्साधुभावाच्च कुन्ती राजन्न चक्षमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2008786, "chapter_id": 1170, "verse_number": "१-१७१-२६", "content_sanskrit": "मथ्यमानेव दुःखेन हृदयेन पृथा तदा।\nउवाच भीमं कल्याणी कृपान्वितमिदं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2008787, "chapter_id": 1170, "verse_number": "१-१७१-२७", "content_sanskrit": "वसामः सुसुखं पुत्र ब्राह्मणस्य निवेशने।\nअज्ञाता धार्तराष्ट्रस्य सत्कृतां वीतमन्यवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2008788, "chapter_id": 1170, "verse_number": "१-१७१-२८", "content_sanskrit": "सा चिन्तये सदा पुत्र ब्राह्मणस्यास्य किं न्वहम्॥\nकदा प्रियं करिष्यामि यत्कुर्युरुषिताः सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2008789, "chapter_id": 1170, "verse_number": "१-१७१-२९", "content_sanskrit": "एतावान्पुरुषस्तात कृतं यस्मिन्न नश्यति।\nयावच्च कुर्यादन्योऽस्य कुर्यादभ्यधिकं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2008790, "chapter_id": 1170, "verse_number": "१-१७१-३०", "content_sanskrit": "तदिदं ब्राह्मणस्यास्य दुःखमापतितं ध्रुवम्।\nन तत्र यदि साहाय्यं कुर्याम सुकृतं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2008791, "chapter_id": 1170, "verse_number": "१-१७१-३१x", "content_sanskrit": "भीमसेन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2008792, "chapter_id": 1170, "verse_number": "१-१७१-३१", "content_sanskrit": "ज्ञायतामस्य यद्दुःखं यतश्चैव समुत्थितम्।\nविदित्वा व्यवसिष्यामि यद्यपि स्यात्सुदुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2008793, "chapter_id": 1170, "verse_number": "१-१७१-३२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2008794, "chapter_id": 1170, "verse_number": "१-१७१-३२", "content_sanskrit": "एवं तौ कथयन्तौ च भूयः सुश्रुवतुः स्वनम्।\nआर्तिजं तस्य विप्रस्य सभार्यस्य विशांपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2008795, "chapter_id": 1170, "verse_number": "१-१७१-३३", "content_sanskrit": "अन्तःपुरं ततस्तस्य ब्राह्मणस्य महात्मनः।\nविवेश त्वरिता कुन्ती बद्धवत्सेव सौरभी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2008796, "chapter_id": 1170, "verse_number": "१-१७१-३४", "content_sanskrit": "ततस्तं ब्राह्मणं तत्र भार्यया च सुतेन च।\nदुहित्रा चैव सहितं ददर्श विकृताननम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2008797, "chapter_id": 1170, "verse_number": "१-१७१-३५x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2008798, "chapter_id": 1170, "verse_number": "१-१७१-३५", "content_sanskrit": "धिगिदं जीवितं लोके गतसारमनर्थकम्।\nदुःखमूलं पराधीनं भृशमप्रियभागि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2008799, "chapter_id": 1170, "verse_number": "१-१७१-३६", "content_sanskrit": "जीविते परमं दुःखं जीविते परमो ज्वरः।\nजीविते वर्तमानस्य द्वन्द्वानामागमो ध्रुवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2008800, "chapter_id": 1170, "verse_number": "१-१७१-३७", "content_sanskrit": "आत्मा ह्येको हि धर्मार्थौ कामं चैव निषेवते।\nएतैश्च विप्रयोगोऽपि दुःखं परमनन्तकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2008801, "chapter_id": 1170, "verse_number": "१-१७१-३८", "content_sanskrit": "आहुः केचित्परं मोक्षं स च नास्ति कथंचन।\nअर्थप्राप्तौ तु नरकः कृत्स्न एवोपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2008802, "chapter_id": 1170, "verse_number": "१-१७१-३९", "content_sanskrit": "अर्थेप्सुता परं दुःखमर्थप्राप्तौ ततोऽधिकम्।\nजातस्नेहस्य चार्थेषु विप्रयोगे महत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2008803, "chapter_id": 1170, "verse_number": "१-१७१-४०", "content_sanskrit": "यावन्तो यस्य संयोगा द्रव्यैरिष्टैर्भवन्त्युत।\nतावन्तोऽस्य निख्यन्ते हृदये शोकशङ्कवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2008804, "chapter_id": 1170, "verse_number": "१-१७१-४१", "content_sanskrit": "तदिदं जीवितं प्राप्य अल्पकालं महाभयम्।\nत्यागो हि न मया प्राप्तो भार्यया सहितेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2008805, "chapter_id": 1170, "verse_number": "१-१७१-४२", "content_sanskrit": "न हि योगं प्रपश्यामि येन मुच्येयमापदः।\nपुत्रदारेण वा सार्धं प्राद्रवेयमनामयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2008806, "chapter_id": 1170, "verse_number": "१-१७१-४३", "content_sanskrit": "यतितं वै मया पूर्वं वेत्थ ब्राह्मणि तत्तथा।\nक्षेमं यतस्ततो गन्तुं त्वया तु मम न श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2008807, "chapter_id": 1170, "verse_number": "१-१७१-४४", "content_sanskrit": "इह जाता विवृद्धाऽस्मि पिता माता ममेति वै।\nउक्तवत्यसि दुर्मेधे याच्यमाना मयाऽसकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2008808, "chapter_id": 1170, "verse_number": "१-१७१-४५", "content_sanskrit": "स्वर्गतोऽपि पिता वृद्धस्तथा माता चिरं तव।\nबन्धवा भूतपूर्वाश्च तत्र वासे तु का रतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2008809, "chapter_id": 1170, "verse_number": "१-१७१-४६", "content_sanskrit": "न भोजनं विरुद्धं स्यान्न स्त्रीदेशो निबन्धनः।\nसुदूरमपि तं देशं व्रजेद्गरुडहंसवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2008810, "chapter_id": 1170, "verse_number": "१-१७१-४७", "content_sanskrit": "सोऽयं ते बन्धुकामाया अशृण्वन्त्या वचो मम।\nबन्धुप्रणाशः संप्राप्तो भृशं दुःखकरो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2008811, "chapter_id": 1170, "verse_number": "१-१७१-४८", "content_sanskrit": "अथवा मद्विनाशो यं न हि शक्ष्यामि कंचन।\nपरित्यक्तुमहं बन्धुं स्वयं जीवन्नृशंसवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2008812, "chapter_id": 1170, "verse_number": "१-१७१-४९", "content_sanskrit": "सहधर्मचरीं दान्तां नित्यं मातृसमां मम।\nसखायं विहितां देवैर्नित्यं परमिकां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2008813, "chapter_id": 1170, "verse_number": "१-१७१-५०", "content_sanskrit": "पित्रा मात्रा च विहितां सदा गार्हस्थ्यभागिनीम्।\nवरयित्वा यथान्यायं मन्त्रवत्परिणीय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2008814, "chapter_id": 1170, "verse_number": "१-१७१-५१", "content_sanskrit": "कुलीनां शीलसंपन्नामपत्यजननीमपि।\nत्वामहं जीवितस्यार्थे साध्वीमनपकारिणीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2008815, "chapter_id": 1170, "verse_number": "१-१७१-५२", "content_sanskrit": "परित्यक्तुं न शक्ष्यामि भार्यां नित्यमनुव्रताम्।\nकुत एव परित्यक्तुं सुतां शक्ष्याम्यहं स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2008816, "chapter_id": 1170, "verse_number": "१-१७१-५३", "content_sanskrit": "बालामप्राप्तवयसमजातव्यञ्जनाकृतिम्।\nभर्तुरर्थाय निक्षिप्तां न्यासं धात्रा महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2008817, "chapter_id": 1170, "verse_number": "१-१७१-५४", "content_sanskrit": "यया दौहित्रजाँल्लोकानाशंसे पितृभिः सह।\nस्वयमुत्पाद्य तां बालां कथमुत्स्रष्टुमुत्सहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2008818, "chapter_id": 1170, "verse_number": "१-१७१-५५", "content_sanskrit": "मन्यन्ते केचिदधिकं स्नेहं पुत्रे पितुर्नराः।\nकन्यायां केचिदपरे मम तुल्यावुभौ स्मृतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2008819, "chapter_id": 1170, "verse_number": "१-१७१-५६", "content_sanskrit": "यस्यां लोकाः प्रसूतिश्च स्थिता नित्यमथो सुखम्।\nअपापां तामहं बालां कथमुत्स्रष्टुमुत्सहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2008820, "chapter_id": 1170, "verse_number": "१-१७१-५७", "content_sanskrit": "कुत एव परित्यक्तुं सुतं शक्ष्याम्यहं स्वयम्।\nप्रार्थयेयं परां प्रीतिं यस्मिन्स्वर्गफलानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2008821, "chapter_id": 1170, "verse_number": "१-१७१-५८", "content_sanskrit": "यस्य जातस्य पितरो मुखं दृष्ट्वा दिवं गताः।\nअहं मुक्तः पितृऋणाद्यस्य जातस्य तेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2008822, "chapter_id": 1170, "verse_number": "१-१७१-५९", "content_sanskrit": "दयितं मे कथं बालमहं त्यक्तुमिहोत्सहे।\nतमहं ज्येष्ठपुत्रं मे कुलनिर्हारकं विभुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2008823, "chapter_id": 1170, "verse_number": "१-१७१-६०", "content_sanskrit": "मम पिण्डोदकनिधिं कथं त्यक्ष्यामि पुत्रकम्।\nत्यागोऽयं मम संप्राप्तो ममन्वा मे सुतस्य वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2008824, "chapter_id": 1170, "verse_number": "१-१७१-६१", "content_sanskrit": "तव वा तव पुत्र्या वा अत्र वासस्य तत्फलम्।\nन शृणोषि वचो मह्यं तत्फलं भुङ्क्ष्व भामिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2008825, "chapter_id": 1170, "verse_number": "१-१७१-६२", "content_sanskrit": "अथवाहं न शक्ष्यामि स्वयं मर्तुं सुतं मम।\nएकं त्यक्तुं न शक्नोति भवतीं च सुतामपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2008826, "chapter_id": 1170, "verse_number": "१-१७१-६३", "content_sanskrit": "अथ मद्रक्षणार्थं वा न हि शक्ष्यामि कंचन।\nपरित्यक्तुमहं बन्धुं स्वयं जीवन्नृशंसवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2008827, "chapter_id": 1170, "verse_number": "१-१७१-६४", "content_sanskrit": "आत्मानमपि चोत्सृज्य गते प्रेतवशं मयि।\nत्यक्ता ह्येते मया व्यक्तं नेह शक्ष्यन्ति जीवितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2008828, "chapter_id": 1170, "verse_number": "१-१७१-६५", "content_sanskrit": "एषां चान्यतमत्यागो नृशंसो गर्हितो बुधैः।\nआत्मत्यागे कृते चेमे मरिष्यन्ति मया विना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2008829, "chapter_id": 1170, "verse_number": "१-१७१-६६", "content_sanskrit": "स कृच्छ्रामहमापन्नो न शक्तस्तर्तुमापदम्।\nअहो धिक्कां गतिं त्वद्य गमिष्यामि सबान्धवः।\nसर्वैः सह मृतं श्रेयो न च मे जीवितुं क्षमम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2008830, "chapter_id": 1170, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि बकवचपर्वणि एकसप्तत्यधिकशततमोऽध्यायः॥ १७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}]