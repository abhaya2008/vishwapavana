[{"id": 7003688000, "chapter_id": 23688, "verse_number": "१-३-९-१", "content_sanskrit": "गौतम उवाच ।\nभगवन्नरुणाद्रीश नामधेयानि ते भृशम् ।\nविशेषाच्छ्रोतुमिच्छामि स्थानेऽस्मिन्सुरपूजिते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003688001, "chapter_id": 23688, "verse_number": "१-३-९-२", "content_sanskrit": "महेश्वर उवाच ।\nनामानि शृणु मे ब्रह्मन्मुख्यानि द्विजसत्तम ।\nदुर्लभान्यल्पपुण्यानां कामदानि सदा भुवि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003688002, "chapter_id": 23688, "verse_number": "१-३-९-३", "content_sanskrit": "शोणाद्रीशोऽरुणाद्रीशो देवाधीशो जनप्रियः ।\nप्रपन्नरक्षको धीरः शिवसेवकवर्धकः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003688003, "chapter_id": 23688, "verse_number": "१-३-९-४", "content_sanskrit": "अक्षिपेयामृतेशानः स्त्रीपुंभावप्रदायकः ।\nभक्तविज्ञप्तिसंधाता दीनबंदिविमोचकः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003688004, "chapter_id": 23688, "verse_number": "१-३-९-५", "content_sanskrit": "मुखरांघ्रिपतिः श्रीमान्मृडो मृगमदेश्वरः ।\nभक्तप्रेक्षणकृत्साक्षी भक्तदोषनिवर्त्तकः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003688005, "chapter_id": 23688, "verse_number": "१-३-९-६", "content_sanskrit": "ज्ञानसंबंधनाथश्च श्रीहलाहलसुंदकः ।\nआहवैश्वर्यदाता च स्मर्तृसर्वाघनाशनः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003688006, "chapter_id": 23688, "verse_number": "१-३-९-७", "content_sanskrit": "व्यत्यस्तनृत्यद्धृजधृक्सकांतिर्नटनेश्वरः ।\nसामप्रियः कलिध्वंसी वेदमूर्तिर्निरंजनः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003688007, "chapter_id": 23688, "verse_number": "१-३-९-८", "content_sanskrit": "जगन्नाथो महादेवस्त्रिनेत्रस्त्रिपुरांतकः ।\nभक्तापराधसोढा च योगीशो भोगनायकः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003688008, "chapter_id": 23688, "verse_number": "१-३-९-९", "content_sanskrit": "बालमूर्त्तिः क्षमारूपी धर्मरक्षो वृषध्वजः ।\nहरो गिरीश्वरो भर्गश्चंद्ररेखावतंसकः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003688009, "chapter_id": 23688, "verse_number": "१-३-९-१०", "content_sanskrit": "स्मरांतकोंऽधकरिपुः सिद्धराजो दिगंबरः ।\nआगमप्रिय ईशानो भस्मरुद्राक्षलांछनः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003688010, "chapter_id": 23688, "verse_number": "१-३-९-११", "content_sanskrit": "श्रीपतिः शंकरः स्रष्टा सर्वविद्येश्वरोऽनघः ।\nगंगाधरः क्रतुध्वंसो विमलो नागभूषणः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003688011, "chapter_id": 23688, "verse_number": "१-३-९-१२", "content_sanskrit": "अरुणो बहुरूपश्च विरूपाक्षोऽक्षराकृतिः ।\nअनादिरंतरहितः शिवकामः स्वयंप्रभुः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003688012, "chapter_id": 23688, "verse_number": "१-३-९-१३", "content_sanskrit": "सच्चिदानंदरूपश्च सर्वात्मा जीवधारकः ।\nस्त्रीसंगवामसुभगो विधिर्विहितसुंदरः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003688013, "chapter_id": 23688, "verse_number": "१-३-९-१४", "content_sanskrit": "ज्ञानप्रदो मुक्तिदश्च भक्तवांछितदायकः ।\nआश्चर्यवैभवः कामी निरवद्यो निधिप्रदः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003688014, "chapter_id": 23688, "verse_number": "१-३-९-१५", "content_sanskrit": "शूली पशुपतिः शंभुः स्वयंभुर्गिरिशो मृडः ।\nएतानि मम मुख्यानि नामान्यत्र महामुने ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003688015, "chapter_id": 23688, "verse_number": "१-३-९-१६", "content_sanskrit": "अन्यानि दिव्यनामानि पुराणोक्तानि संस्मर ।\nप्रदक्षिणेन मां नित्यं विशेषात्त्वं समर्चय ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003688016, "chapter_id": 23688, "verse_number": "१-३-९-१७", "content_sanskrit": "प्रदक्षिणप्रियो यस्मादहं शोणाचलाकृतिः ।\nइत्याज्ञप्तो महादेवमर्चयन्नरुणाचलम् ।\nअविमुंचन्निहावासं कृतवानहमद्रिजे ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003688017, "chapter_id": 23688, "verse_number": "१-३-९-१८", "content_sanskrit": "गौर्युवाच ।\nभगवन्सर्वधर्मज्ञ गौतमार्य्य मुनीश्वर ।\nप्रदक्षिणस्य माहात्म्यं ब्रूहि मे शोणभूभृतः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003688018, "chapter_id": 23688, "verse_number": "१-३-९-१९", "content_sanskrit": "कस्मिन्काले कथं कार्यं कैर्वा पूर्वं प्रदक्षिणम् ।\nकृतं शोणाद्रिनाथस्य प्राप्तमिष्टं परं पदम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003688019, "chapter_id": 23688, "verse_number": "१-३-९-२०", "content_sanskrit": "ब्रह्मोवाच ।\nइति पृष्टो मुनिः प्राह गौतमः शैलकन्यकाम् ।\nश्रूयतां देवि माहात्म्यमादिशन्मे महेश्वरः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003688020, "chapter_id": 23688, "verse_number": "१-३-९-२१", "content_sanskrit": "महादेव उवाच ।\nअहं हि शोणशैलात्मा प्रकाशो वसुधातले ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003688021, "chapter_id": 23688, "verse_number": "१-३-९-२२", "content_sanskrit": "परितो मां सुराः सर्वे वर्तंते मुनिभिः सह ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003688022, "chapter_id": 23688, "verse_number": "१-३-९-२३", "content_sanskrit": "यानि कानि च पापानि जन्मांतरकृतानि च ।\nतानि तानि विनश्यंति प्रदक्षिणपदे पदे ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003688023, "chapter_id": 23688, "verse_number": "१-३-९-२४", "content_sanskrit": "अश्वमेधसहस्राणि वाजपेयायुतानि च ।\nसिद्ध्यंति सर्वतीर्थानि प्रदक्षिणपदे पदे ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003688024, "chapter_id": 23688, "verse_number": "१-३-९-२५", "content_sanskrit": "अपि प्रहीणस्य समस्तलक्षणैः क्रियाविहीनस्य निकृष्टजन्मनः ।\nप्रदक्षिणीकृत्य शशांकशेखरं प्रयास्यतः कस्य न सिद्धिरग्रतः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003688025, "chapter_id": 23688, "verse_number": "१-३-९-२६", "content_sanskrit": "समस्त तीर्थाभिगमेषु पुण्यं समस्तयज्ञागमधर्मजातम् ।\nअवाप्यते शोणमहीधरस्य प्रदक्षिणाप्रक्रमणेन सत्यम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003688026, "chapter_id": 23688, "verse_number": "१-३-९-२७", "content_sanskrit": "पदेनैकेन भूलोकं द्वितीयेनांतरिक्षकम् ।\nतृतीयेन दिवं मर्त्यो जयत्यस्य प्रदक्षिणे ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003688027, "chapter_id": 23688, "verse_number": "१-३-९-२८", "content_sanskrit": "एकेन मानसं पापं द्वितीयेन तु वाचिकम् ।\nकायिकं तु तृतीयेन पदेन क्षीयते नृणाम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003688028, "chapter_id": 23688, "verse_number": "१-३-९-२९", "content_sanskrit": "पातकानि च सर्वाणि पदेनैकेन मार्जयेत् ।\nद्वितीयेन तपः सर्वं प्राप्नोत्यस्य प्रदक्षिणात् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003688029, "chapter_id": 23688, "verse_number": "१-३-९-३०", "content_sanskrit": "पर्णशाला महर्षीणां सिद्धानां च सहस्रशः ।\nसुराणां च तथाऽवासा विद्यंतेत्र सहस्रशः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003688030, "chapter_id": 23688, "verse_number": "१-३-९-३१", "content_sanskrit": "अत्र सिद्धः पुनर्नित्यं वसाम्यग्रे सुरार्चितः ।\nममांतरे गुहा दिव्या ध्यातव्या भोगसंयुता ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003688031, "chapter_id": 23688, "verse_number": "१-३-९-३२", "content_sanskrit": "अग्निस्तंभमयं रूपमरुणादिरिति श्रुतम् ।\nध्यायंल्लिंगं मम बृहत्मन्दं कुर्यात्प्रदक्षिणम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003688032, "chapter_id": 23688, "verse_number": "१-३-९-३३", "content_sanskrit": "अष्टमूर्तिमयं लिंगमिदं यैस्तैजसं भृशम् ।\nध्यात्वा प्रदक्षिणं कुर्वन्पातकानि विनिर्दहेत् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003688033, "chapter_id": 23688, "verse_number": "१-३-९-३४", "content_sanskrit": "न पुनः संभवस्तस्य यः करोति प्रदक्षिणाम् ।\nशोणाचलाकृतेर्नित्यं नित्यत्वं ध्रुवमश्नुते ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003688034, "chapter_id": 23688, "verse_number": "१-३-९-३५", "content_sanskrit": "अस्य पादरजःस्पर्शात्पूयते सकला मही ।\nपदमेकं तु धत्ते यः शोणाद्रीशप्रदक्षिणे ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003688035, "chapter_id": 23688, "verse_number": "१-३-९-३६", "content_sanskrit": "नमस्कुर्वन्प्रतिदिशं ध्यायन्स्तौति कृतांजलिः ।\nअसंसृष्टकरः कैश्चिन्मंदं कुर्यात्प्रदक्षिणम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003688036, "chapter_id": 23688, "verse_number": "१-३-९-३७", "content_sanskrit": "आसन्नप्रसवा नारी यथा गच्छेदनाकुलम् ।\nतथा प्रदक्षिणं कुर्यादशृण्वंश्च पदध्वनिम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003688037, "chapter_id": 23688, "verse_number": "१-३-९-३८", "content_sanskrit": "स्नातो विशुद्धवेषः सन्भस्मरुद्राक्षभूषितः ।\nशिवस्मरणसंसृष्टो मंदं दद्यात्पदं बुधः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003688038, "chapter_id": 23688, "verse_number": "१-३-९-३९", "content_sanskrit": "मनूनां चरतामग्रे देवानां च सहस्रशः ।\nअदृश्यानां च सिद्धानां नान्येषां वायुरूपिणाम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003688039, "chapter_id": 23688, "verse_number": "१-३-९-४०", "content_sanskrit": "संघट्टमतिसंमर्दं मार्गरोधं विचिंतयन् ।\nअनुकूलेन भक्तः सञ्छनैर्दद्यात्पदं बुधः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003688040, "chapter_id": 23688, "verse_number": "१-३-९-४१", "content_sanskrit": "अथवा शिवनामानि संकीर्त्य वरगीतिभिः ।\nशिवनृत्यं च रचयन्भक्तैः सार्द्धं परिक्रमेत् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003688041, "chapter_id": 23688, "verse_number": "१-३-९-४२", "content_sanskrit": "माहात्म्यं मम वा शृण्वन्ननन्यमतिरादरात् ।\nशनैः प्रदक्षिणं कुर्यादानन्दरसनिर्भरः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003688042, "chapter_id": 23688, "verse_number": "१-३-९-४३", "content_sanskrit": "दानैश्च विविधैः पुण्यैरुपकारैस्तथार्थिनाम् ।\nयथामति दयापूर्ण आस्तिकः परितो व्रजेत् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003688043, "chapter_id": 23688, "verse_number": "१-३-९-४४", "content_sanskrit": "कृते त्वग्निमयं लिंगं त्रेतायां मणिपर्वतम् ।\nद्वापरे चिंतयेद्धैमं कलौ मरकताचलम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003688044, "chapter_id": 23688, "verse_number": "१-३-९-४५", "content_sanskrit": "अथवा स्फाटिकं रूपमरुणं तु स्वयंप्रभम् ।\nध्यायन्विमुक्तः सकलैः पापैः शिवपुरं व्रजेत् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003688045, "chapter_id": 23688, "verse_number": "१-३-९-४६", "content_sanskrit": "अवाङ्मनसगम्यत्वादप्रमेयतया स्वयम् ।\nअग्नित्वाच्च परं लिंगमनासाद्याचलाभिधम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003688046, "chapter_id": 23688, "verse_number": "१-३-९-४७", "content_sanskrit": "ध्यात्वा प्रदक्षिणं कर्तुरभिगम्योऽहमंजसा ।\nतस्य पादरजो नृणामजरामरकारणाम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003688047, "chapter_id": 23688, "verse_number": "१-३-९-४८", "content_sanskrit": "रूपमेकं तु धत्ते यः शोणाद्रीशप्रदक्षिणे ।\nवाहनानि सुरौघाणां प्रार्थयंते परस्परम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003688048, "chapter_id": 23688, "verse_number": "१-३-९-४९", "content_sanskrit": "कुर्वतां चरणं वोढुमरुणाद्रिप्रदक्षिणाम् ।\nछायाप्रदानं कुर्वंति कल्पकाद्याः सुरद्रुमाः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003688049, "chapter_id": 23688, "verse_number": "१-३-९-५०", "content_sanskrit": "कुर्वतां भुवि मर्त्त्यानामरुणाद्रिप्रदक्षिणाम् ।\nदेवगन्धर्वकाद्यानां सहस्रेण समावृताः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003688050, "chapter_id": 23688, "verse_number": "१-३-९-५१", "content_sanskrit": "सेवंते ते गणाकीर्णा विमानशतकोटयः ।\nमम प्रदक्षिणं भूमौ कुर्वतां पादपांसुभिः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003688051, "chapter_id": 23688, "verse_number": "१-३-९-५२", "content_sanskrit": "पाविता महती वीथी दृष्टा शिवपदप्रदा ।\nअंगप्रदक्षिणं कुर्वन्क्षणात्स्वर्ग्यतनुर्भवेत् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003688052, "chapter_id": 23688, "verse_number": "१-३-९-५३", "content_sanskrit": "प्राप्तो वज्रशरीरत्वं न धृष्येत महीतले ।\nव्योमयानोत्सुका देवाः सिद्धाश्च परमर्षयः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003688053, "chapter_id": 23688, "verse_number": "१-३-९-५४", "content_sanskrit": "अदृश्याः संचरंत्यत्र पश्यंते मम संनिधिम् ।\nविनयं मम भक्तिं च प्रदक्षिणपरिक्रमे ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003688054, "chapter_id": 23688, "verse_number": "१-३-९-५५", "content_sanskrit": "दृष्ट्वा हर्षसमायुक्ता मर्त्त्येभ्यो ददते वरम् ।\nअत्र देवास्त्रयस्त्रिंशत्पुरा कृत्वा प्रदक्षिणाम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003688055, "chapter_id": 23688, "verse_number": "१-३-९-५६", "content_sanskrit": "प्रत्यहं मार्गमासीनाः प्रत्येकं कोटितां गताः ।\nआदित्याद्या ग्रहाः सर्वे पुरा कृत्वा प्रदक्षिणाम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003688056, "chapter_id": 23688, "verse_number": "१-३-९-५७", "content_sanskrit": "संपूर्णजगतीभागे सर्वे ग्रहपतां गताः ।\nयः करोति नरो भूमौ सूर्यवारे प्रदक्षिणाम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003688057, "chapter_id": 23688, "verse_number": "१-३-९-५८", "content_sanskrit": "स सूर्यमडलं भित्त्वा मुक्तः शिवपुरं व्रजेत् ।\nसोमवारे नरः कुर्वन्नरुणाद्रिप्रदक्षिणाम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003688058, "chapter_id": 23688, "verse_number": "१-३-९-५९", "content_sanskrit": "अजरामरतां प्राप्तो नासौम्यो भवति क्षितौ ।\nभौमवारे नरः कुर्वन्नरुणाद्रिप्रदक्षिणाम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003688059, "chapter_id": 23688, "verse_number": "१-३-९-६०", "content_sanskrit": "आनृण्यमखिलं प्राप्य सार्वभौमो भवेद्ध्रुवम् ।\nबुधवारे नरः कुर्वञ्छोणाद्रीशप्रदक्षिणाम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003688060, "chapter_id": 23688, "verse_number": "१-३-९-६१", "content_sanskrit": "सर्वज्ञतामनुप्राप्तः स वाचां पतितामियात् ।\nगुरुवारे नरः कुर्वन्सर्वदेवनमस्कृतः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003688061, "chapter_id": 23688, "verse_number": "१-३-९-६२", "content_sanskrit": "प्रदक्षिणेन शोणाद्रेः स तु लोकगुरुर्भवेत् ।\nभृगुवारे नरः कुर्वन्नरुणाद्रिप्रदक्षिणाम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003688062, "chapter_id": 23688, "verse_number": "१-३-९-६३", "content_sanskrit": "संप्राप्य महतीं लक्ष्मीं लभते वैष्णवं पदम् ।\nमन्दवारे नरः कृत्वा शोणाद्रीशप्रदक्षिणाम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003688063, "chapter_id": 23688, "verse_number": "१-३-९-६४", "content_sanskrit": "विमुक्तो ग्रहपीडाभिः स विश्वविजयी भवेत् ।\nनक्षत्राणि च सर्वाणि पुरा तद्दैवतैः सह ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003688064, "chapter_id": 23688, "verse_number": "१-३-९-६५", "content_sanskrit": "मम प्रदक्षिणां कर्तुः पुण्यानि सहसा व्रजेत् ।\nतिथयः करणानीह योगाश्च मम संमताः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003688065, "chapter_id": 23688, "verse_number": "१-३-९-६६", "content_sanskrit": "अभीष्टफलदा जाताः कुर्वतां मत्प्रदक्षिणाम् ।\nमुहूर्ता विविधा होराः सौम्याश्च सततोदयाः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003688066, "chapter_id": 23688, "verse_number": "१-३-९-६७", "content_sanskrit": "मत्प्रदक्षिणकर्तृणां जायंते सततं शुभाः ।\nप्रच्छिनत्ति प्रकारोऽघं दकारो वांछितप्रदः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003688067, "chapter_id": 23688, "verse_number": "१-३-९-६८", "content_sanskrit": "क्षिकारात्क्षीयते कर्म णकारो मुक्तिदायकः ।\nदुर्बलाः कार्श्यसंयुक्ता आधिव्याधिविजृंभिताः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003688068, "chapter_id": 23688, "verse_number": "१-३-९-६९", "content_sanskrit": "मम प्रदक्षिणं कृत्वा मुच्यंते सर्वदुष्कृतैः ।\nमम प्रदक्षिणं कर्तुर्भक्त्या पादेन संततम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003688069, "chapter_id": 23688, "verse_number": "१-३-९-७०", "content_sanskrit": "क्षणेन साध्वां पश्यामि त्रैलोक्यस्य प्रदक्षिणाम् ।\nलोकेशाश्च दिगीशाश्च ये चान्ये कारणेश्वराः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003688070, "chapter_id": 23688, "verse_number": "१-३-९-७१", "content_sanskrit": "मम प्रदक्षिणां कृत्वा स्थिरा राज्ये पुराऽभवन् ।\nअहं च गणसंयुक्तः सर्वदेवर्षिसंयुतः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003688071, "chapter_id": 23688, "verse_number": "१-३-९-७२", "content_sanskrit": "उत्तरायणसंयोगे करोमि स्वप्रदक्षिणाम् ।\nमद्रूपं तैजसं लिंगमरुणाद्रिरिति श्रुतम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003688072, "chapter_id": 23688, "verse_number": "१-३-९-७३", "content_sanskrit": "त्रैलोक्यस्य हितार्थाय करिष्यामि प्रदक्षिणाम् ।\nआगता च परांते च गौरी तप इहाद्भुतम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003688073, "chapter_id": 23688, "verse_number": "१-३-९-७४", "content_sanskrit": "कर्तुं प्रदक्षिणं कृत्वा मामेष्यत्यनघा पुनः ।\nकार्तिके मासि नक्षत्रे कृत्तिकाख्ये महातपाः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003688074, "chapter_id": 23688, "verse_number": "१-३-९-७५", "content_sanskrit": "मम प्रदक्षिणां गौरी प्रदोषे रचयिष्यति ।\nनराणामल्पपुण्यानां दुर्लभं तत्प्रदक्षिणम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003688075, "chapter_id": 23688, "verse_number": "१-३-९-७६", "content_sanskrit": "ज्योतिर्लिगस्य दृष्टस्य देवी प्रार्थनया तथा ।\nमया समेता देवी सा प्राप्ताऽपीतकुचाभिधा ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003688076, "chapter_id": 23688, "verse_number": "१-३-९-७७", "content_sanskrit": "आश्वास्यति सुरान्सर्वानुत्तरायणसंगमे ।\nदेवगन्धर्वयक्षाणां सिद्धानामपि रक्षसाम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003688077, "chapter_id": 23688, "verse_number": "१-३-९-७८", "content_sanskrit": "सर्वेषां देवयोनीनां भविता तत्र संगमः ।\nये तदा मां समागत्य पूजयंति तपोधिकाः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003688078, "chapter_id": 23688, "verse_number": "१-३-९-७९", "content_sanskrit": "सर्वजन्मकृताघौघ प्रायश्चित्तं व्रजंति ते ।\nदुर्ल्लभं तद्दिनं पुंसामुत्तरायणसंगमे ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003688079, "chapter_id": 23688, "verse_number": "१-३-९-८०", "content_sanskrit": "तदा मद्रूपमभ्यर्च्य कृतार्थाः सन्तु मानवाः ।\nप्रदक्षिणं तु मे दिव्यं कुर्वंति च महीभुजः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003688080, "chapter_id": 23688, "verse_number": "१-३-९-८१", "content_sanskrit": "तेषां पुरोगतः साक्षादहं जेष्यामि विद्विषः ।\nराजा यस्य तु देशस्य यो यो राजा तपोधिकः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003688081, "chapter_id": 23688, "verse_number": "१-३-९-८२", "content_sanskrit": "स कारयेद्विप्रमुख्यैः श्रोत्रियैर्मे प्रदक्षिणाम् ।\nमंडलं मंडलार्द्धं वा संकल्पविधिपूर्वकम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003688082, "chapter_id": 23688, "verse_number": "१-३-९-८३", "content_sanskrit": "तस्य तस्य स्थिरं राज्यं शत्रूणां च पराहतिम् ।\nकरिष्यामि मुने नित्यमहमेव पुरःस्थितः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003688083, "chapter_id": 23688, "verse_number": "१-३-९-८४", "content_sanskrit": "न वाहनेन कुर्वीत मम जातु प्रदक्षिणाम् ।\nधर्मलुब्धमना जानञ्छिवाचारपरिप्लुतिम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003688084, "chapter_id": 23688, "verse_number": "१-३-९-८५", "content_sanskrit": "धर्मकेतुः पुरा राजा यमलोकादुपागतः ।\nमम प्रदक्षिणां कर्त्तुं तुरगेणाभ्यरोचयत् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003688085, "chapter_id": 23688, "verse_number": "१-३-९-८६", "content_sanskrit": "क्षणेन तुरगो जातो गणनाथः सुरार्चितः ।\nप्रतिपेदे पदं शैवं विमुच्य धरणीपतिम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003688086, "chapter_id": 23688, "verse_number": "१-३-९-८७", "content_sanskrit": "वीक्ष्य तं वाहनं भूयो गणनाथवपुर्द्धरम् ।\nपादप्रदक्षिणां कृत्वा स्वयं च गणपोऽभवत् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003688087, "chapter_id": 23688, "verse_number": "१-३-९-८८", "content_sanskrit": "तदाप्रभृति शक्राद्याः सुरा विष्णुसमन्विताः ।\nपादाभ्यामेव कुर्वंति मम सर्वे प्रदक्षिणाम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003688088, "chapter_id": 23688, "verse_number": "१-३-९-८९", "content_sanskrit": "स्वर्गान्निपातितः कोऽपि सिद्धः काले तपःक्षयात् ।\nप्रदक्षिणां ततः कृत्वा पुनर्लब्धपदोऽभवत् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003688089, "chapter_id": 23688, "verse_number": "१-३-९-९०", "content_sanskrit": "स्खलितं पादजं रक्तं मम कर्तुः प्रदक्षिणम् ।\nमार्ज्यते तस्य देवेन्द्र मौलिमंदारकेसरैः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003688090, "chapter_id": 23688, "verse_number": "१-३-९-९१", "content_sanskrit": "प्रदक्षिणमहावीथी शिलाशकलघट्टितम् ।\nपदं संधार्यते पुंसां श्रीपयोधरकुंकुमैः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003688091, "chapter_id": 23688, "verse_number": "१-३-९-९२", "content_sanskrit": "मणिपर्वतशृंगेषु कल्पद्रुमवनांतरे ।\nसंचरंति सदा मर्त्या मम कृत्वा प्रदक्षिणम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003688092, "chapter_id": 23688, "verse_number": "१-३-९-९३", "content_sanskrit": "गौर्युवाच ।\nउपचारप्रवृत्तानां फलं मे शंस सुव्रत ।\nयैर्वै जनः कृतार्थः स्याद्यथाशक्ति कृतादरः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003688093, "chapter_id": 23688, "verse_number": "१-३-९-९४", "content_sanskrit": "मुनिरुवाच ।\nउपचारफलं देवि शृणु वक्ष्याम्यहं तव ।\nयन्मह्यं कृपया पूर्वमुक्तवान्परमेश्वरः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003688094, "chapter_id": 23688, "verse_number": "१-३-९-९५", "content_sanskrit": "लूती तंतुकजालानि संसृज्य क्वचिदेव मे ।\nजातिस्मरो महीध्रेऽस्मिन्सोंऽशुकैर्मां व्यवेष्टयत् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003688095, "chapter_id": 23688, "verse_number": "१-३-९-९६", "content_sanskrit": "गजः कश्चितृषाक्रांतो विमुच्य च मधु क्वचित् ।\nवनपल्लवमुत्कीर्य मुक्तोऽभूद्गणनायकः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003688096, "chapter_id": 23688, "verse_number": "१-३-९-९७", "content_sanskrit": "कृमयो विलुठन्तो मे पार्श्वे दुरितवर्जिताः ।\nसिद्धवेषाः पुनः सर्वे मम लोकं व्रजंति ते ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003688097, "chapter_id": 23688, "verse_number": "१-३-९-९८", "content_sanskrit": "अव्युच्छिन्नप्रदीपार्चिः क्षणमप्यादधाति यः ।\nस्वयंप्रकाशः स भवन्मम सारूप्यमश्नुते ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003688098, "chapter_id": 23688, "verse_number": "१-३-९-९९", "content_sanskrit": "हारीतः कोपि संप्राप्तः शाखानीडो ममांतिके ।\nखद्योतो दीपवन्नक्तं तावन्मुक्तिं समागतः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003688099, "chapter_id": 23688, "verse_number": "१-३-९-१००", "content_sanskrit": "गावः प्रस्रवणैः सिक्ता वत्सस्मरणसंभवैः ।\nमत्पार्श्वे मुक्तिमापुस्ता मम लोकं समाश्रयन् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003688100, "chapter_id": 23688, "verse_number": "१-३-९-१०१", "content_sanskrit": "काकः पक्षजवातेन बलिग्रहणलोलुपः ।\nमार्जयन्मत्पुरोभागं मुक्तिं प्रापद्यत क्षणात् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003688101, "chapter_id": 23688, "verse_number": "१-३-९-१०२", "content_sanskrit": "मूषको मद्गुहाभागं मणिसंघविकर्षणैः ।\nप्रकाशयन्वितिमिरं मम रूपमपद्यत ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003688102, "chapter_id": 23688, "verse_number": "१-३-९-१०३", "content_sanskrit": "छायावृक्षत्वमास्थातुं मुनयस्त्रिदशा अपि ।\nप्रार्थयंत्येव मत्पार्श्वे न पुनःसंभवेच्छया ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003688103, "chapter_id": 23688, "verse_number": "१-३-९-१०४", "content_sanskrit": "गोपुरं शिखरं शालां मण्डपं वापिकामपि ।\nकुर्वतां मत्पुरोभागे सिध्यंतीष्टार्थसंपदः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003688104, "chapter_id": 23688, "verse_number": "१-३-९-१०५", "content_sanskrit": "सदा मर्त्त्यैरनासाद्यमग्निलिंगमिदं मम ।\nअनासाद्याचलेशाख्यं पूज्यतां वसुधातले ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003688105, "chapter_id": 23688, "verse_number": "१-३-९-१०६", "content_sanskrit": "वीक्षणस्पर्शनध्यानैः स्वभूतं निखिलं जगत् ।\nपोषयंती परा शक्तिः पूज्याऽपीतकुचाभिधा ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003688106, "chapter_id": 23688, "verse_number": "१-३-९-१०७", "content_sanskrit": "सर्वलोकैकजननी संप्राप्ता नित्ययौवनम् ।\nयौवनप्रार्थिभिः सेव्या सदाऽपीतकुचाभिधा ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003688107, "chapter_id": 23688, "verse_number": "१-३-९-१०८", "content_sanskrit": "क्षणात्तस्य पुरोभागे वसतां प्राणिनामिह ।\nपरत्र वात्र दुष्प्राप्यमिष्टवस्तु न विद्यते ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003688108, "chapter_id": 23688, "verse_number": "१-३-९-१०९", "content_sanskrit": "अप्रमेयगुणाधारमपेक्षितवरप्रदम् ।\nअशेषभोगनिलयं शोणाद्रीशं समर्चय ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003688109, "chapter_id": 23688, "verse_number": "१-३-९-११०", "content_sanskrit": "लब्धकामा पुनः शम्भुमाश्रयिष्यसि सुव्रते ।\nतपश्चरणमप्येतत्तव लोकहितावहम् ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003688110, "chapter_id": 23688, "verse_number": "१-३-९-१११", "content_sanskrit": "न केवलं तव तपः स्ववांछितफलप्रदम् ।\nतपस्यतामृषीणां च क्षेमायैव भविष्यति ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003688111, "chapter_id": 23688, "verse_number": "१-३-९-११२", "content_sanskrit": "कारणांतरमाशंक्य तपः कुर्वंति देवताः ।\nरहस्यं देवतानां तु फलेनैवानुमीयते ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003688112, "chapter_id": 23688, "verse_number": "१-३-९-११३", "content_sanskrit": "वयं च सहसंवासास्तव व्रतनिरीक्षणात् ।\nकृतार्थाः स्याम देवेशि तपसा नः कृतार्थता ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003688113, "chapter_id": 23688, "verse_number": "१-३-९-११४", "content_sanskrit": "इति तस्य मुनेर्वाक्यमर्थगर्भं निशम्य सा ।\nगौरी कौतुकसंयुक्ता प्रशशंस महामुनिम् ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003688114, "chapter_id": 23688, "verse_number": "१-३-९-११५", "content_sanskrit": "तपः किमन्यत्कर्तव्यं लब्धं तव तु दर्शनम् ।\nअरुणाद्रिरयं दृष्टः श्रुतं माहात्म्यमस्य च ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003688115, "chapter_id": 23688, "verse_number": "१-३-९-११६", "content_sanskrit": "अहो भूमेस्तु वैचित्र्यं यतो दृष्टा दिवोऽधिका ।\nयत्रैव तैजसं लिंगं देवतानां वरप्रदः ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7003688116, "chapter_id": 23688, "verse_number": "१-३-९-११७", "content_sanskrit": "शिवः प्रसादसिद्धो मे दर्शितं स्थानमात्मनः ।\nअत्रैव शिवमाराध्य वशीकुर्यां जगद्गुरुम् ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7003688117, "chapter_id": 23688, "verse_number": "१-३-९-११८", "content_sanskrit": "अविनाभूतमैक्यं मे देवेन भवतात्सदा ।\nत्वया कृतेन साह्येन भवेयं शिवनायिका ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7003688118, "chapter_id": 23688, "verse_number": "१-३-९-११९", "content_sanskrit": "इति गौतमसंनिधौ तदानीं कृतसंवित्तप आदरेण कर्तुम् ।\nअभजद्रुचिरां च पर्णशालां मुनिना चानुमता तथेति भक्त्या ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7003688119, "chapter_id": 23688, "verse_number": "१-३-९-१२०", "content_sanskrit": "सुकुमारतनुः सरोरुहाक्षी घनतुंगस्तनकल्पितोत्तरीया ।\nजटिला हरिनीलरत्नकांतिर्गिरिजा राजति देहवत्तपःश्रीः ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7003688120, "chapter_id": 23688, "verse_number": "१-३-९-१२१", "content_sanskrit": "नियमैर्बहुभिस्तपोविशेषैः क्रतुषु प्राप्तविचित्रयोगबंधैः ।\nनिगमागमदृष्टधर्ममार्गं सकलं सा तु कृतार्थतामनैषीत् ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7003688121, "chapter_id": 23688, "verse_number": "१-३-९-१२२", "content_sanskrit": "तपसा विविधेनतप्यमाना न कदाचित्परिखेदमाप तन्वी ।\nहरिरत्नमयी च कापि वल्ली नितरां दीप्तिमती बभूव बाला ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7003688122, "chapter_id": 23688, "verse_number": "१-३-९-१२३", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां प्रथमे माहेश्वरखण्डेऽरुणाचलमाहात्म्ये पूर्वार्धेऽरुणेश्वरप्रदक्षिणामाहात्म्यवर्णनंनाम नवमोऽध्यायः ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}]