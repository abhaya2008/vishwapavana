[{"id": 2115909, "chapter_id": 3495, "verse_number": "", "content_sanskrit": "तापत्योपाख्यानम् । सूर्येण स्वकन्यां तपतीं संवरणाय दातुं\nनिश्चयः । मृगयार्थं गतेन संवरणेन तपतीदर्शनम् । उत्पन्नकामेन\nतेन तया भाषितुमुद्युक्ते तस्या अन्तर्धानम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2115910, "chapter_id": 3495, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2115911, "chapter_id": 3495, "verse_number": "१", "content_sanskrit": "तापत्य इति यद्वाक्यमुक्तवानसि मामिह ।\nतदहं श्रोतुमिच्छामि तापत्यार्थविनिश्चयम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2115912, "chapter_id": 3495, "verse_number": "२", "content_sanskrit": "तपती नाम का चैषा तापत्या यत्कृते वयम् ।\nकौन्तेया हि वयं साधो यत् तदिच्छामि वेदितुम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2115913, "chapter_id": 3495, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2115914, "chapter_id": 3495, "verse_number": "३", "content_sanskrit": "एवमुक्तः स गन्धर्वः प्रत्युवाच यशस्विनम् ।\nअर्जुनं त्रिषु लोकेषु विश्रुतं श्रुतवद्वचः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2115915, "chapter_id": 3495, "verse_number": "४", "content_sanskrit": "अहं ते कथयिष्यामि कथामतिमनोरमाम् ।\nयथावदखिलां पार्थ धर्म्यां धर्मभृतां वर \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2115916, "chapter_id": 3495, "verse_number": "५", "content_sanskrit": "उक्तवानस्मि पार्थ त्वां तापत्य इति यद्वचः ।\nतत् तेऽहं कथयिष्यामि शृणु चैकमना नृप\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2115917, "chapter_id": 3495, "verse_number": "६", "content_sanskrit": "य एष दिवि तेजस्वी नाकं व्याप्नोति तेजसा ।\nसा तस्य तपती नाम बभूव सदृशी सुता\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2115918, "chapter_id": 3495, "verse_number": "७", "content_sanskrit": "विवस्वतोऽथ कौन्तेय सावित्र्यवरजा विभो ।\nविश्रुता त्रिषु लोकेषु तपती तपसा युता \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2115919, "chapter_id": 3495, "verse_number": "८", "content_sanskrit": "न देवी नासुरी चैव न यक्षी न च किन्नरी ।\nनाप्सरा न च गन्धर्वी तथारूपा न काचन \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2115920, "chapter_id": 3495, "verse_number": "९", "content_sanskrit": "सुविविक्तानवद्याङ्गी सुस्मितायतलोचना ।\nस्वाचारा चैव साध्वी च सुवेषा चैव भामिनी\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2115921, "chapter_id": 3495, "verse_number": "१०", "content_sanskrit": "न तस्याः सदृशं कञ्चित् त्रिषु लोकेषु भारत ।\nभर्तारं सविता मेने रूपशीलगुणश्रुतैः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2115922, "chapter_id": 3495, "verse_number": "११", "content_sanskrit": "सम्प्राप्तयौवनां पश्यन् देवो दुहितरं शुभाम् ।\nद्विरष्टवर्षां तां पश्यन् सविता रूपशालिनीम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2115923, "chapter_id": 3495, "verse_number": "१२", "content_sanskrit": "नोपलेभे ततः शान्तिं सम्प्रदानं विचिन्तयन् ।\nअथर्क्षपुत्रः कौन्तेय कुरूणामृषभो युवा \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2115924, "chapter_id": 3495, "verse_number": "१३", "content_sanskrit": "सूर्यमाराधयामास नृपः संवरणस्तदा ।\nअर्घ्यमाल्योपहारैश्च शश्वत् स नृपतिस्तदा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2115925, "chapter_id": 3495, "verse_number": "१४", "content_sanskrit": "नियमैरुपवासैश्च तपोभिर्विविधैरपि ।\nशुश्रूषुरनहंवादी शश्वत् पौरवनन्दन \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2115926, "chapter_id": 3495, "verse_number": "१५", "content_sanskrit": "अंशुमन्तं समुद्यन्तं पूजयामास भक्तिमान् ।\nकृतज्ञं च सुधर्मज्ञं रूपेणासदृशं भुवि\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2115927, "chapter_id": 3495, "verse_number": "१६", "content_sanskrit": "तपत्याः सदृशं मेने सूर्यः संवरणं पतिम् ।\nदातुमैच्छत् ततः कन्यां तस्मै संवरणाय ताम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2115928, "chapter_id": 3495, "verse_number": "१८", "content_sanskrit": "नृपोत्तमाय कौरव्य विश्रुताभिजनाय च ।\nयथा हि दिवि दीप्तांशुः प्रभासयति तेजसा \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2115929, "chapter_id": 3495, "verse_number": "१९", "content_sanskrit": "तथा भुवि महीपालो दीप्त्या संवरणोऽभवत् ।\nयथाऽर्चयन्ति चादित्यमुद्यन्तं ब्रह्मवादिनः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2115930, "chapter_id": 3495, "verse_number": "२०", "content_sanskrit": "तथा संवरणं पार्थ ब्राह्मणावरजाः प्रजाः ।\nस सोममति कान्तत्वाद् आदित्यमति तेजसा \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2115931, "chapter_id": 3495, "verse_number": "२१", "content_sanskrit": "बभूव नृपतिः श्रीमान् सुहृदां दुर्हृदामपि ।\nएवंगुणाय नृपते तथावृत्ताय नित्यशः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2115932, "chapter_id": 3495, "verse_number": "२२", "content_sanskrit": "तस्मै दातुं मनश्चक्रे तपतीं तपनः स्वयम् ।\nस कदाचिदथो राजा श्रीमानुरुयशा भुजः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2115933, "chapter_id": 3495, "verse_number": "२३", "content_sanskrit": "चचार मृगयां पार्थ पर्वतोपवने किल ।\nचरतो मृगयां तस्य क्षुत्पिपासाश्रमान्वितः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2115934, "chapter_id": 3495, "verse_number": "२४", "content_sanskrit": "ममार राज्ञः कौन्तेय गिरावप्रतिमो हयः ।\nस मृताश्वश्चरन् पार्थ पद्भ्यामेव गिरौ नृपः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2115935, "chapter_id": 3495, "verse_number": "२५", "content_sanskrit": "ददर्शासदृशीं लोके कन्यामायतलोचनाम् ।\nस एक एकामासाद्य कन्यां तामरिमर्दनः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2115936, "chapter_id": 3495, "verse_number": "२६", "content_sanskrit": "तस्थौ नृपतिशार्दूलः पश्यन्नविचलेक्षणः ।\nस हि तां तर्कयामास रूपतो नृपतिः श्रियम् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2115937, "chapter_id": 3495, "verse_number": "२७", "content_sanskrit": "पुनः स कामयामास रवेरिष्टामिव प्रभाम् ।\nगिरिप्रस्थे तु सा यस्मिन् स्थिता त्वसितलोचना \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2115938, "chapter_id": 3495, "verse_number": "२८", "content_sanskrit": "ससवृक्षलतागुल्मो हिरण्मय इवाभवत् ।\nअवमेने स तां दृष्ट्वा सर्वप्राणभृतां स्त्रियः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2115939, "chapter_id": 3495, "verse_number": "२९", "content_sanskrit": "अवाप्तं चात्मनो मेने स राजा चक्षुषः फलम् ।\nजन्मप्रभृति यत्किञ्चिद् दृष्टवान् स महीपतिः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2115940, "chapter_id": 3495, "verse_number": "३०", "content_sanskrit": "रूपं न सदृशं तस्याः तर्कयामास किञ्चन ।\nतस्यां बद्धमनश्चक्षुः पाशैर्गुणमयैस्तदा \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2115941, "chapter_id": 3495, "verse_number": "३१", "content_sanskrit": "नातिचक्राम तं देशं बुबुधे न च किञ्चन ।\nअस्या नूनं विशालाक्ष्याः सदेवासुरमानुषम् \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2115942, "chapter_id": 3495, "verse_number": "३२", "content_sanskrit": "लोकं निर्मथ्य धात्रेदं रूपमाविष्कृतं वरम् ।\nइति तां तर्कयामास रूपद्रविणसम्पदा \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2115943, "chapter_id": 3495, "verse_number": "३३", "content_sanskrit": "कन्यामसदृशीं लोके नृपः संवरणस्तदा ।\nतां च दृष्ट्वैव कल्याणीं कल्याणाभिजनो नृपः \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2115944, "chapter_id": 3495, "verse_number": "३४", "content_sanskrit": "जगाम मनसा चिन्तां काममार्गणपीडितः ।\nतुद्यमानः सुतीव्रेण नृपतिर्मन्मथाग्निना ।\nअप्रगल्भः प्रगल्भां तामुवाचाथ यशस्विनीम् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2115945, "chapter_id": 3495, "verse_number": "", "content_sanskrit": "संवरणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2115946, "chapter_id": 3495, "verse_number": "३५", "content_sanskrit": "काऽसि कस्यासि रम्भोरु किमर्थं चेह तिष्ठसि ।\nकथं च निर्जनेऽरण्ये चरस्येका शुचिस्मिते \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2115947, "chapter_id": 3495, "verse_number": "३६", "content_sanskrit": "त्वं हि सर्वानवद्याङ्गी सर्वाभरणभूषिता ।\nविभूषणमिवैतेषां भूषणानामभीप्सितम् \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2115948, "chapter_id": 3495, "verse_number": "३७", "content_sanskrit": "न देवीं नासुरीं चैव न यक्षीं न च किन्नरीम् ।\nन च भोगवतीं मन्ये न गन्धर्वीं न मानुषीम् \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2115949, "chapter_id": 3495, "verse_number": "३८", "content_sanskrit": "या हि दृष्टा मया काश्चित् श्रुताश्चापि वराङ्गनाः ।\nन तासां सदृशीं मन्ये त्वामहं मत्तगामिनि \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2115950, "chapter_id": 3495, "verse_number": "", "content_sanskrit": "गन्धर्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2115951, "chapter_id": 3495, "verse_number": "३९", "content_sanskrit": "एष तां स महीपालो बभाषे न तु सा तदा ।\nकामार्तं निर्जनेऽरण्ये प्रत्यभाषत किञ्चन \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2115952, "chapter_id": 3495, "verse_number": "४०", "content_sanskrit": "तथा लालप्यमानस्य पार्थिवस्यायतेक्षणा ।\nसौदामिनीव चाभ्रेषु तत्रैवान्तरधीयत\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2115953, "chapter_id": 3495, "verse_number": "४१", "content_sanskrit": "तामन्विच्छन् स नृपतिः परिचक्राम तत् तदा ।\nवनं वनजपत्राक्षीं भ्रमन्नुन्मत्तवत् तदा \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2115954, "chapter_id": 3495, "verse_number": "४२", "content_sanskrit": "अपश्यमानः स तु तां बहु तत्र विलप्य च ।\nनिश्चेष्टः कौरवश्रेष्ठो मुहूर्तं स व्यतिष्ठत \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2115955, "chapter_id": 3495, "verse_number": "७", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nचतुःसप्तत्यधिकशततमोऽध्यायः ॥१७५॥ इति चैत्ररथपर्वणि सप्तमोऽध्यायः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2115956, "chapter_id": 3495, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]