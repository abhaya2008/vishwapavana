[{"id": 50026122, "chapter_id": 12069, "verse_number": "1", "content_sanskrit": "हिरण्यगर्भसूक्तं च भृगुदृष्टं प्रकीर्तितम्। ब्रह्मधातृविरिञ्चाजपाद्मैरङ्गमुदाहृतम्॥ ६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50026123, "chapter_id": 12069, "verse_number": "2", "content_sanskrit": "ध्यायेन्निषण्णमजमच्युतनाभिपद्मे प्रोद्यद्दिवाकरसमूहनिकाशमग्र्यम्। मातृप्रकारकरमुत्तमकान्तिमद्भिर्वक्त्रैः सृजन्तमखिलैः परमार्थविद्याम्॥ ६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}]