[{"id": 2062843, "chapter_id": 2337, "verse_number": "८-५८-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2062844, "chapter_id": 2337, "verse_number": "८-५८-१", "content_sanskrit": "एवमुक्तः प्रत्युवाच धृष्टद्युम्नः प्रतापवान्।\nआशिषं तां प्रवक्तव्यां मामको दास्यते तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2062845, "chapter_id": 2337, "verse_number": "८-५८-२", "content_sanskrit": "येनैव ते पितुर्दत्ता यतमानस्य संयुगे।\nएष ते प्रतिवाक्यं वै असिर्दास्यति मामकः।\nयेन कृत्तं तव पितुर्यतमानस्य तच्छिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2062846, "chapter_id": 2337, "verse_number": "८-५८-३", "content_sanskrit": "यदि तावन्मया द्रोणो निहतो ब्राह्मणब्रुवः।\nत्वामिदानीं कथं युद्धे न हनिष्यामि किल्बिषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2062847, "chapter_id": 2337, "verse_number": "८-५८-४", "content_sanskrit": "एवमुक्त्वा महातेजाः सेनापतिररिन्दमः।\nसुतीक्ष्णेनाथ भल्लेन द्रौणिं विव्याध पार्षतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2062848, "chapter_id": 2337, "verse_number": "८-५८-५", "content_sanskrit": "ततो द्रौणिः सुसङ्क्रुद्धः शरैः सन्नतपर्वभिः।\nआच्छादयद्दिशो राजन्धृष्टद्युम्नस्य संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2062849, "chapter_id": 2337, "verse_number": "८-५८-६", "content_sanskrit": "नैवान्तरिक्षं न दिशो नापि योधाः सहस्रशः।\nदृश्यन्ते वै महाराज शरैश्छन्नाः समन्ततः।\nएकः सन्वारयामास प्रेक्षणीयः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2062850, "chapter_id": 2337, "verse_number": "८-५८-७", "content_sanskrit": "तथैव पार्षतो राजन्द्रौणिमाहवशोभिनम्।\nशरैः सञ्छादयामास सूतपुत्रस्य पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2062851, "chapter_id": 2337, "verse_number": "८-५८-८", "content_sanskrit": "राधेयोऽपि महाराज पाञ्चालान्सह पाण्डवैः।\nद्रौपदेया युधामन्युमुत्तमौजसमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2062852, "chapter_id": 2337, "verse_number": "८-५८-९", "content_sanskrit": "सात्यकिश्च महाराज योधांश्चान्यान्सहस्रशः।\nएकस्तान्वारयामास प्रेक्षणीयः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2062853, "chapter_id": 2337, "verse_number": "८-५८-१०", "content_sanskrit": "धृष्टद्युम्नस्तु समरे द्रौणेश्चिच्छेद कार्मुकम्।\nक्षुरप्रेण सुतीक्ष्णेन पश्यतां सर्वयोधिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2062854, "chapter_id": 2337, "verse_number": "८-५८-११", "content_sanskrit": "तदपास्य धनुश्छिन्नमन्यदादत्त कार्मुकम्।\nवेगवत्समरे घोरं शरांश्चाशीविषोपमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2062855, "chapter_id": 2337, "verse_number": "८-५८-१२", "content_sanskrit": "स पार्षतस्य राजेन्द्र धनुः शक्तिं गदां ध्वजम्।\nहयान्सूतं रथं चैव निमेषाद्व्यधमच्छरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2062856, "chapter_id": 2337, "verse_number": "८-५८-१३", "content_sanskrit": "स च्छिन्नधन्वा विरथो हताश्वो हतसारथिः।\nखङ्गमादत्त विपुलं शतचन्द्रं च भानुमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2062857, "chapter_id": 2337, "verse_number": "८-५८-१४", "content_sanskrit": "द्रौणिस्तदपि राजेन्द्र भल्लैः क्षिप्रं महारथः।\nचिच्छेद समरे वीरः क्षिप्रहस्तो दृढायुधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2062858, "chapter_id": 2337, "verse_number": "८-५८-१५", "content_sanskrit": "रथादनवरूढस्य धन्विनो बाहुशालिनः।\nपश्यतां सर्वसैन्यानां तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2062859, "chapter_id": 2337, "verse_number": "८-५८-१६", "content_sanskrit": "धृष्टद्युम्नं तु विरथं हताश्वरथसारथिम्।\nशस्त्रैश्च बहुधा विद्धमस्त्रैश्च शकलीकृतम्।\nनातरद्भरतश्रेष्ठ यदमानो महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2062860, "chapter_id": 2337, "verse_number": "८-५८-१७", "content_sanskrit": "तस्यान्तमिषुभी राजन्यदा द्रौणिर्न गच्छति।\nअथ त्यक्त्वा रथं वीरः पार्षतं त्वरितोऽन्वगात्।\nप्रगृह्य विपुलं खह्गं जातरूपपरिष्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2062861, "chapter_id": 2337, "verse_number": "८-५८-१८", "content_sanskrit": "तस्य सम्पततो राजन्वपुरासीन्महात्मनः।\nगरुडस्येव ततो जिघृक्षोः पन्नगोत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2062862, "chapter_id": 2337, "verse_number": "८-५८-१९", "content_sanskrit": "एतस्मिन्नेव काले तु केशवः परवीरहा।\nअब्रवीद्भरतश्रेष्ठमर्जुनं जयतां वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2062863, "chapter_id": 2337, "verse_number": "८-५८-२०", "content_sanskrit": "पश्य द्रौणिं पार्षतस्य यतमानं वधं प्रति।\nयत्नं करोति विपुलं हन्याच्चैनं न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2062864, "chapter_id": 2337, "verse_number": "८-५८-२१", "content_sanskrit": "त्रायस्वैनं महाबाहो पार्षतं युद्धदुर्मदम्।\nद्रौणेरास्यगतं वीर मृत्योरास्यगतं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2062865, "chapter_id": 2337, "verse_number": "८-५८-२२", "content_sanskrit": "एवमुक्त्वा महाराज वासुदेवः प्रतापवान्।\nप्रैषयत्तुरगान्यत्र द्रौणिर्वीरो व्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2062866, "chapter_id": 2337, "verse_number": "८-५८-२३", "content_sanskrit": "ते हयाश्चन्द्रसङ्काशाः केशवेन प्रचोदिताः।\nपिबन्त इव चाकाशं जग्मुद्रौणेर्महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2062867, "chapter_id": 2337, "verse_number": "८-५८-२४", "content_sanskrit": "दृष्ट्वा द्रौणिर्महाराज वासुदेवधनंजयौ।\nधृष्टद्युम्नवधे राजंश्चक्रे यत्नं महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2062868, "chapter_id": 2337, "verse_number": "८-५८-२५", "content_sanskrit": "विकृष्यमाणं दृष्ट्वै धृष्टद्युम्नं जनेश्वर।\nशरांश्चिक्षेप वै पार्थो द्रौणिं प्रति महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2062869, "chapter_id": 2337, "verse_number": "८-५८-२६", "content_sanskrit": "ते शरा हेमविकृता गाण्डीवप्रेषिता भृशम्।\nद्रौणिमासाद्य विविशुर्वल्मीकमिव पन्नगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2062870, "chapter_id": 2337, "verse_number": "८-५८-२७", "content_sanskrit": "विद्धस्तु तैः शरैर्घोरैद्रोणपुत्रः प्रतापवान्।\nउत्सृज्य समरे राजन्पाञ्चालममितौजसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2062871, "chapter_id": 2337, "verse_number": "८-५८-२८", "content_sanskrit": "आरुरोह रथं वीरो धनञ्जयशरार्दितः।\nप्रगृह्य च धनुः श्रेष्ठं पार्थं विव्याध सायकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2062872, "chapter_id": 2337, "verse_number": "८-५८-२९", "content_sanskrit": "एतस्मिन्नन्तरे शूरः सहदेवो जनाधिप।\nअपोवाह रथेनाजौ पार्षतं शत्रुतापनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2062873, "chapter_id": 2337, "verse_number": "८-५८-३०", "content_sanskrit": "अर्जुनोऽपि महाराज द्रौणिं विव्याध पत्रिभिः।\nतं द्रोणपुत्रः संरब्धो बाह्वोरुरसि चार्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2062874, "chapter_id": 2337, "verse_number": "८-५८-३१", "content_sanskrit": "क्रोधितस्तु रणे पार्थो नाराचं कालसन्निभम्।\nद्रोणपुत्राय चिक्षेप यमदण्डमिवापरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2062875, "chapter_id": 2337, "verse_number": "८-५८-३२", "content_sanskrit": "स ब्राह्मणस्यांसदेशे निपपात महाद्युतेः।\nस विह्वलो महाराज शरवेगेन संयुगे।\nनिषसाद रथोपस्थे वैक्लव्यं परमं ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2062876, "chapter_id": 2337, "verse_number": "८-५८-३३", "content_sanskrit": "तं तु मत्वा हतं वीरं सारथिः शत्रुकर्शनम्।\nअपोवाह रणेनाजौ त्वरमाणो रणाजिरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2062877, "chapter_id": 2337, "verse_number": "८-५८-३४", "content_sanskrit": "अथोद्धृष्टं महाराज पाञ्चालैर्जितकाशिभिः।\nमोक्षितं पार्षतं दृष्ट्वा द्रोणपुत्रं च पीडितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2062878, "chapter_id": 2337, "verse_number": "८-५८-३५", "content_sanskrit": "वादित्राणि च दिव्यानि प्रावाद्यन्त सहस्रशः।\nसिंहनादश्च सञ्जज्ञे दृष्ट्वा युद्धं तदद्भुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2062879, "chapter_id": 2337, "verse_number": "८-५८-३६", "content_sanskrit": "ततः कर्णो महाराज व्याक्षिपद्विजयं धनुः।\nदृष्ट्वार्जुनं रणे क्रुद्धः प्रेक्षते च मुहुर्मुहुः।\nद्वैरथं चापि पार्थेन गन्तुकामो महाद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2062880, "chapter_id": 2337, "verse_number": "८-५८-३७", "content_sanskrit": "एवं कृत्वाऽब्रवीत्पार्थो वासुदेवं धनञ्जयः।\nयाहि संशप्तकान्कृष्ण कार्यमेतत्परं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2062881, "chapter_id": 2337, "verse_number": "८-५८-३८", "content_sanskrit": "ततः प्रयातो गोविन्दः श्रुत्वा पाण्डवभाषितम्।\nरथेनातिपताकेन मनोमारुतरंहसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2062882, "chapter_id": 2337, "verse_number": "८-५८-३९", "content_sanskrit": "एवमेष क्षयो वृत्तः पृथिव्यां पृथिवीपते।\nतावकानां परेषां च राजन्दुर्मन्त्रिते तव॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2062883, "chapter_id": 2337, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि सप्तदशदिवसयुद्धे अष्टपञ्चाशोऽध्यायः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]