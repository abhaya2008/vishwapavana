[{"id": 2117915, "chapter_id": 3539, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2117916, "chapter_id": 3539, "verse_number": "१", "content_sanskrit": "ततः समुद्रे तीर्थानि दक्षिणे भरतर्षभ ।\nअभ्यगच्छत् सुपुण्यानि रहितानि तपस्विभिः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2117917, "chapter_id": 3539, "verse_number": "२", "content_sanskrit": "वर्जयन्ति स्म तीर्थानि पञ्च तत्र तु तापसाः ।\nअवतीर्णानि तान्यासन् पुरस्तात् तु तपस्विभिः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2117918, "chapter_id": 3539, "verse_number": "३", "content_sanskrit": "अगस्त्यतीर्थं सौभद्रं पौलोमं च सुपावनम् ।\nकरं धर्मप्लवं चैव हयमेधफलं च यत् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2117919, "chapter_id": 3539, "verse_number": "४", "content_sanskrit": "भारद्वाजस्य तीर्थं च पापप्रशमनं महत् ।\nविविक्तान्युपलक्ष्याथ तानि तीर्थानि पाण्डवः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2117920, "chapter_id": 3539, "verse_number": "५", "content_sanskrit": "दृष्ट्वा च वर्ज्यमानानि मुनिभिर्भावितात्मभिः ।\nतपस्विनस्ततोऽपृच्छत् प्राञ्जलिः कुरुनन्दनः ।\nतीर्थान्येतानि वर्ज्यन्ते किमर्थं ब्रह्मवादिभिः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2117921, "chapter_id": 3539, "verse_number": "", "content_sanskrit": "तापसाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2117922, "chapter_id": 3539, "verse_number": "६", "content_sanskrit": "ग्राहाः पञ्च वसन्त्येषु हरन्ति च तपोधनान् ।\nअत एतानि वर्ज्यन्ते तीर्थानि कुरुसत्तम \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2117923, "chapter_id": 3539, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2117924, "chapter_id": 3539, "verse_number": "७", "content_sanskrit": "श्रुत्वा तु वचनं तेषां वार्यमाणस्तपोधनैः ।\nजगाम तानि तीर्थानि द्रष्टुं पुरुषसत्तमः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2117925, "chapter_id": 3539, "verse_number": "८", "content_sanskrit": "ततः सौभद्रमासाद्य महर्षेस्तीर्थमुत्तमम् ।\nविगाह्य तरसा शूरः स्नानं चक्रे परन्तपः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2117926, "chapter_id": 3539, "verse_number": "९", "content_sanskrit": "अथ तं पुरुषव्याघ्रमन्तर्जलचरो महान् ।\nनिजग्राह जले ग्राहः शापमोक्षाय भारत \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2117927, "chapter_id": 3539, "verse_number": "१०", "content_sanskrit": "स तमादाय कौन्तेयो विस्फुरन्तं जलेचरम् ।\nउदतिष्ठन्महाबाहुर्बलेन बलिनां वरः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2117928, "chapter_id": 3539, "verse_number": "११", "content_sanskrit": "उत्क्षिप्त एव तु ग्राहः सोऽर्जुनेन तपस्विना ।\nबभूव नारी कल्याणी सर्वाभरणभूषिता \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2117929, "chapter_id": 3539, "verse_number": "१२", "content_sanskrit": "दीप्यमाना श्रिया राजन् दिव्यरूपा मनोरमा ।\nतदद्भुततमं दृष्ट्वा कुन्तीपुत्रो धनञ्जयः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2117930, "chapter_id": 3539, "verse_number": "१३", "content_sanskrit": "तां स्त्रियं परमप्रीत इदं वचनमब्रवीत् ।\nका वै त्वमसि कल्याणि कुतो वाऽसि जलेचरी ।\nकिमर्थं च महत् पापमिदं कृतवती पुरा \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2117931, "chapter_id": 3539, "verse_number": "", "content_sanskrit": "स्त्री", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2117932, "chapter_id": 3539, "verse_number": "१४", "content_sanskrit": "अप्सराऽस्मि महाबाहो देवारण्यविचारिणी ।\nइष्टा धनपतेर्नित्यं वृन्दा नाम महाबल \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2117933, "chapter_id": 3539, "verse_number": "१५", "content_sanskrit": "मम सख्यश्चतस्रोऽन्याः सर्वाः कामगमाः शुभाः ।\nताभिः सार्धं प्रयाताऽस्मि लोकपालनिवेशनम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2117934, "chapter_id": 3539, "verse_number": "१६", "content_sanskrit": "ततः पश्याम वै सर्वा ब्राह्मणं संशितव्रतम् ।\nरूपवन्तमधीयानमेकमेकान्तचारिणम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2117935, "chapter_id": 3539, "verse_number": "१७", "content_sanskrit": "तस्यैव तपसा राजंस्तद्वनं तेजसा वृतम् ।\nआदित्य इव तं देशं कृत्स्नमध्यवभासयत् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2117936, "chapter_id": 3539, "verse_number": "१८", "content_sanskrit": "तस्य दृष्ट्वा तपस्तादृग् रूपं चाद्भुतदर्शनम् ।\nअवतीर्णाऽस्मि तं देशं तपोविघ्नचिकीर्षया \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2117937, "chapter_id": 3539, "verse_number": "१९", "content_sanskrit": "अहं च सौरभेयी च समीची लम्बुसा लता ।\nयौगपद्येन तं विप्रमभ्यगच्छाम भारत \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2117938, "chapter_id": 3539, "verse_number": "२०", "content_sanskrit": "गायन्त्यो वै हसन्त्यश्च नृत्यन्त्यो वै वराङ्गनाः ।\nप्रेक्षणानि च कुर्वन्त्यो विवृतं कारयन्ति च \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2117939, "chapter_id": 3539, "verse_number": "२१", "content_sanskrit": "अनिच्छन्तीरिवाङ्गानि हासभावविलासितैः ।\nबाहूरुमूलदन्तानां दर्शनं वै वराङ्गनाः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2117940, "chapter_id": 3539, "verse_number": "२२", "content_sanskrit": "कुर्वन्त्यो लोभयन्त्यश्च तं द्विजं परितः श्रिताः ।\nस च नास्मासु कृतवान् मनो वीर कथञ्चन \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2117941, "chapter_id": 3539, "verse_number": "२३", "content_sanskrit": "नाकम्पत महातेजाः स्थितस्तपसि निर्मलः ।\nसोऽशपत् कुपितोऽस्मांस्तु ब्राह्मणः क्षत्रियर्षभ\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2117942, "chapter_id": 3539, "verse_number": "२४", "content_sanskrit": "ग्राहभूता जले यूयं चरिष्यथ शतं समाः ।\nततो वयं प्रव्यथिताः सर्वा भारतसत्तम \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2117943, "chapter_id": 3539, "verse_number": "२५", "content_sanskrit": "याचाम शरणं विप्रं तं तपोधनमच्युतम् ।\nरूपेण वयसा चैव कन्दर्पेण च दर्पिताः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2117944, "chapter_id": 3539, "verse_number": "२६", "content_sanskrit": "अयुक्तं कृतवत्यश्च क्षन्तुमर्हसि नो द्विज ।\nएष एव वधोऽस्माकं सुपर्याप्तस्तपोधन \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2117945, "chapter_id": 3539, "verse_number": "२७", "content_sanskrit": "यद् वयं संशितात्मानं प्रलोभयितुमागताः ।\nअवध्यास्तु स्त्रियः सृष्टा मन्यन्ते धर्मचिन्तकाः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2117946, "chapter_id": 3539, "verse_number": "२८", "content_sanskrit": "तस्माद् धर्मेण धर्मज्ञ नास्मान् हिंसितुमर्हसि ।\nसर्वभूतेषु धर्मज्ञ मैत्रो ब्राह्मण उच्यते \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2117947, "chapter_id": 3539, "verse_number": "२९", "content_sanskrit": "सत्यो भवतु कल्याण एष वादो मनीषिणाम् ।\nशरणं च प्रपन्नानां शिष्टाः कुर्वन्ति पालनम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2117948, "chapter_id": 3539, "verse_number": "३०", "content_sanskrit": "शरणं त्वां प्रपन्नाः स्म तस्मात् त्वं क्षन्तुमर्हसि ।\nएवमुक्तः स धर्मात्मा ब्राह्मणः शुभकर्मकृत् ।\nप्रसादं कृतवान् वीर रविसोमसमप्रभः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2117949, "chapter_id": 3539, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2117950, "chapter_id": 3539, "verse_number": "३१", "content_sanskrit": "विश्वं शतसहस्रं च सर्वमक्षयवाचकम् ।\nपरिमाणं शतं त्वेतन्नेदमक्षयवाचकम् \t॥ ३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2117951, "chapter_id": 3539, "verse_number": "३२", "content_sanskrit": "यदा च वो ग्राहभूता गृह्णन्तीः पुरुषान् जले ।\nउत्तरिष्येज्जलात् कश्चित् स्थलं पुरुषसत्तमः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2117952, "chapter_id": 3539, "verse_number": "३३", "content_sanskrit": "तदा यूयं पुनः सर्वाः स्वं रूपं प्रतिपत्स्यथ ।\nअनृतं नोक्तपूर्वं मे भविताऽपि कदाचन \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2117953, "chapter_id": 3539, "verse_number": "३४", "content_sanskrit": "तानि तीर्थानि सर्वाणि ततः प्रभृति चैव ह ।\nनारीतीर्थानि नाम्नेह ख्यातिं यास्यन्ति सर्वशः ।\nपुण्यानि च भविष्यन्ति पावनानि मनीषिणाम् \t॥ ३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2117954, "chapter_id": 3539, "verse_number": "", "content_sanskrit": "वृन्दा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2117955, "chapter_id": 3539, "verse_number": "३५", "content_sanskrit": "ततोऽभिवाद्य तं विप्रं कृत्वा चापि प्रदक्षिणम् ।\nविचिन्तया चापसृत्य तस्माद् देशात् सुदुःखिताः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2117956, "chapter_id": 3539, "verse_number": "३६", "content_sanskrit": "क्क नु नाम वयं सर्वाः कालेनाल्पेन तं नरम् ।\nसमागच्छेम यो नस्तद् रूपमापादयेत् पुनः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2117957, "chapter_id": 3539, "verse_number": "३७", "content_sanskrit": "ता वयं चिन्तयित्वैवं मुहूर्तादिव भारत ।\nदृष्टवत्यो महाभागं देवर्षिमुत नारदम् \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2117958, "chapter_id": 3539, "verse_number": "३८", "content_sanskrit": "सम्प्रहृष्टाः स्म तं दृष्ट्वा देवर्षिममितद्युतिम् ।\nअभिवाद्य च तं पार्थ स्थिता व्रीडितचेतनाः \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2117959, "chapter_id": 3539, "verse_number": "३९", "content_sanskrit": "स नोऽपृच्छद् दुःखमूलमुक्तवत्यो वयं च तत् ।\nश्रुत्वा तच्च यथावृत्तमिदं वचनमब्रवीत् \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2117960, "chapter_id": 3539, "verse_number": "४०", "content_sanskrit": "दक्षिणे सागरानूपे पञ्च तीर्थानि सन्ति वै ।\nपुण्यानि रमणीयानि तानि गच्छत माचिरम् \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2117961, "chapter_id": 3539, "verse_number": "४१", "content_sanskrit": "तत्राशु पुरषव्याघ्रः पाण्डवेयो धनञ्जयः ।\nमोक्षयिष्यति शुद्धात्मा पापादस्मान्न संशयः \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2117962, "chapter_id": 3539, "verse_number": "", "content_sanskrit": "वृन्दा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2117963, "chapter_id": 3539, "verse_number": "४२", "content_sanskrit": "इत्युक्त्वा नारदः सर्वास्तत्रैवान्तरधीयत ।\nतस्मात् सर्वा वयं वीर निवसामोऽत्र नित्यशः \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2117964, "chapter_id": 3539, "verse_number": "४३", "content_sanskrit": "तदिदं सत्यमेवाद्य मोक्षिताऽहं त्वयाऽनघ ।\nएतास्तु मम वै सख्यश्चतस्रोऽन्या ह्रदे स्थिताः ।\nएता अपि महाबाहो मुनिशापाद् विमोक्षय \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2117965, "chapter_id": 3539, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2117966, "chapter_id": 3539, "verse_number": "४४", "content_sanskrit": "तच्छ्रुत्वा पाण्डवश्रेष्ठः सर्वा एव विशाम्पते ।\nतस्माच्छापाददीनात्मा मोक्षयामास वीर्यवान् \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2117967, "chapter_id": 3539, "verse_number": "४५", "content_sanskrit": "उत्थाय च जलात् सर्वाः प्रतिलभ्य स्वकं वपुः ।\nतास्तदाऽप्सरसो राजन्नदृश्यन्त यथा पुरा \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2117968, "chapter_id": 3539, "verse_number": "४६", "content_sanskrit": "तीर्थानि शोधयित्वाऽथ तथाऽनुज्ञाय ताः प्रभुः ।\nचित्राङ्गदां पुनर्द्रष्टुं मणलूरपुरं ययौ \t॥ ४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2117969, "chapter_id": 3539, "verse_number": "४७", "content_sanskrit": "तस्यामजनयत् पुत्रं राजानं बभ्रुवाहनम् ।\nतं दृष्ट्वा पाण्डवो राजन् चित्रवाहनमब्रवीत् \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2117970, "chapter_id": 3539, "verse_number": "४८", "content_sanskrit": "चित्राङ्गदायाः शुल्कार्थं गृह्णेमं बभ्रुवाहनम् ।\nचित्राङ्गदां पुनर्वाक्यमब्रवीत् पाकशासनिः \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2117971, "chapter_id": 3539, "verse_number": "४९", "content_sanskrit": "अनेन तु महिष्यद्य ऋणान्मुक्तो जनाधिपः\nइहैव भव भद्रे त्वं बभ्रुवाहनवर्धनात् \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2117972, "chapter_id": 3539, "verse_number": "५०", "content_sanskrit": "इन्द्रप्रस्थनिवासं मे आगत्वा तत्र रंस्यसे ।\nकुन्तीं युधिष्ठिरं भीमं भ्रातरौ मे कनीयसौ\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2117973, "chapter_id": 3539, "verse_number": "५१", "content_sanskrit": "आगता तत्र पश्येथा अन्यानपि च बान्धवान् ।\nबान्धवैः सहिता भद्रे नन्दसे त्वमनिन्दिते \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2117974, "chapter_id": 3539, "verse_number": "५२", "content_sanskrit": "धर्मे स्थितः सत्यधृतिः कुन्तीपुत्रो युधिष्ठिरः ।\nजित्वा तु पृथिवीं कृत्स्नां राजसूयं करिष्यति \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2117975, "chapter_id": 3539, "verse_number": "५३", "content_sanskrit": "तत्रागच्छन्ति राजानः पृथिव्यां नृपसंज्ञिताः ।\nबहूनि रत्नान्यादाय आगमिष्यति ते पिता \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2117976, "chapter_id": 3539, "verse_number": "५४", "content_sanskrit": "एकसार्थं प्रयाताऽसि चित्रवाहनसेनया ।\nद्रक्ष्यामि राजसूये त्वां पुत्रं पालय मा शुचः \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2117977, "chapter_id": 3539, "verse_number": "५५", "content_sanskrit": "बभ्रुवाहननाम्ना तु मम प्राणो बहिश्चरः ।\nतस्माद् भरस्व पुत्रं वै पुरुवंशविवर्धनम् \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2117978, "chapter_id": 3539, "verse_number": "५६", "content_sanskrit": "चित्रवाहनदायादं धर्मात् पौरवनन्दनम् ।\nपाण्डवानां प्रियं पुत्रं तस्मात् पालय सर्वदा ।\nविप्रयोगेण सन्तापं मा कृथास्त्वमनिन्दिते \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2117979, "chapter_id": 3539, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2117980, "chapter_id": 3539, "verse_number": "५७", "content_sanskrit": "चित्राङ्गदामेवमुक्त्वा सागरानूपमाश्रितः ।\nस्यानन्दूरं समाप्लुत्य दत्त्वा बहुधनं तदा ।\nकेरळान् समतिक्रम्य गोकर्णमभितोऽगमत् \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2117981, "chapter_id": 3539, "verse_number": "२१८", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nअष्टविंशत्यधिकद्विशततमोऽध्यायः ॥२१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2117982, "chapter_id": 3539, "verse_number": "४", "content_sanskrit": "॥ इति अर्जुनवनवासपर्वणि चतुर्थोऽध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2117983, "chapter_id": 3539, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]