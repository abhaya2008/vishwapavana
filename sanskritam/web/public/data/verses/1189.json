[{"id": 2009596, "chapter_id": 1189, "verse_number": "१-१९०-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2009597, "chapter_id": 1189, "verse_number": "१-१९०-१", "content_sanskrit": "स गन्धर्ववचः श्रुत्वा तत्तदा भरतर्षभ।\nअर्जुनः परया भक्त्या पूर्णचन्द्र इवाबभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2009598, "chapter_id": 1189, "verse_number": "१-१९०-२", "content_sanskrit": "उवाच च महेष्वासो गन्धर्वं कुरुसत्तमः।\nजातकौतूहलोऽतीव वसिष्ठस्य तपोबलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2009599, "chapter_id": 1189, "verse_number": "१-१९०-३", "content_sanskrit": "वसिष्ठ इति तस्यैतदृषेर्नाम त्वयेरितम्।\nएतदिच्छाम्यहं श्रोतुं यथावत्तद्वदस्व मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2009600, "chapter_id": 1189, "verse_number": "१-१९०-४", "content_sanskrit": "य एष गन्धर्वपते पूर्वेषां नः पुरोहितः।\nआसीदेतन्ममाचक्ष्व क एष भगवानृषिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2009601, "chapter_id": 1189, "verse_number": "१-१९०-५x", "content_sanskrit": "गन्धर्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2009602, "chapter_id": 1189, "verse_number": "१-१९०-५", "content_sanskrit": "ब्रह्मणो मानसः पुत्रो वसिष्ठोऽरुन्धतीपतिः।\nतपसा निर्जितौ शश्वदजेयावमरैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2009603, "chapter_id": 1189, "verse_number": "१-१९०-६", "content_sanskrit": "कामक्रोधावुभौ यस्य चरणौ समुवाहतुः।\nइन्द्रियाणां वशकरो वशिष्ठ इति चोच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2009604, "chapter_id": 1189, "verse_number": "१-१९०-७", "content_sanskrit": "यथा कामश्च क्रोधश्च निर्जितावजितौ नरैः।\nजितारयो जिता लोकाः पन्थानश्च जिता दिशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2009605, "chapter_id": 1189, "verse_number": "१-१९०-८", "content_sanskrit": "यस्तु नोच्छेदनं चक्रे कुशिकानामुदारधीः।\nविश्वामित्रापराधेन धारयन्मन्युमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2009606, "chapter_id": 1189, "verse_number": "१-१९०-९", "content_sanskrit": "पुत्रव्यसनसंतप्तः शक्तिमानप्यशक्तवत्।\nविश्वामित्रविनाशाय न चक्रे कर्म दारुणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2009607, "chapter_id": 1189, "verse_number": "१-१९०-१०", "content_sanskrit": "मृतांश्च पुनराहर्तुं शक्तः पुत्रान्यमक्षयात्।\nकृतान्तं नातिचक्राम वेलामिव महोदधिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2009608, "chapter_id": 1189, "verse_number": "१-१९०-११", "content_sanskrit": "यं प्राप्य विजितात्मानं महात्मानं नराधिपाः।\nइक्ष्वाकवो महीपाला लेभिरे पृथिवीमिमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2009609, "chapter_id": 1189, "verse_number": "१-१९०-१२", "content_sanskrit": "पुरोहितमिमं प्राप्य वसिष्ठमृषिसत्तमम्।\nईजिरे क्रतुभिश्चैव नृपास्ते कुरुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2009610, "chapter_id": 1189, "verse_number": "१-१९०-१३", "content_sanskrit": "स हि तान्याजयामास सर्वान्नृपतिसत्तमान्।\nब्रह्मर्षिः पाण्डवश्रेष्ठ बृहस्पतिरिवामरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2009611, "chapter_id": 1189, "verse_number": "१-१९०-१४", "content_sanskrit": "तस्माद्धर्मप्रधानात्मा वेदधर्मविदीप्सितः।\nब्राह्मणो गुणवान्कश्चित्पुरोधाः प्रतिदृश्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2009612, "chapter_id": 1189, "verse_number": "१-१९०-१५", "content_sanskrit": "क्षत्रियेणाभिजातेन पृथिवीं जेतुमिच्छता।\nपूर्वं पुरोहितः कार्यः पार्थ राज्याभिवृद्धये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2009613, "chapter_id": 1189, "verse_number": "१-१९०-१६", "content_sanskrit": "महीं जिगीषता राज्ञा ब्रह्म कार्यं पुरःस्कृतम्।\nतस्मात्पुरोहितः कश्चिद्गुणवान्विजितेन्द्रियः।\nविद्वान्भवतु वो विप्रो धर्मकामार्थतत्त्ववित्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2009614, "chapter_id": 1189, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वमि चैत्ररथपर्वणि नवत्यधिकशततमोऽध्यायः॥ १९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]