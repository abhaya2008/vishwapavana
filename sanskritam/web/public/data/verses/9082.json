[{"id": 5000082000, "chapter_id": 9082, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे पञ्चमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000082001, "chapter_id": 9082, "verse_number": "२-५-१", "content_sanskrit": "संदिश्य रामं नृपतिः श्वोभाविन्यभिषेचने।\nपुरोहितं समाहूय वसिष्ठमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000082002, "chapter_id": 9082, "verse_number": "२-५-२", "content_sanskrit": "गच्छोपवासं काकुत्स्थं कारयाद्य तपोधन।\nश्रेयसे राज्यलाभाय वध्वा सह यतव्रत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000082003, "chapter_id": 9082, "verse_number": "२-५-३", "content_sanskrit": "तथेति च स राजानमुक्त्वा वेदविदां वरः।\nस्वयं वसिष्ठो भगवान् ययौ रामनिवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000082004, "chapter_id": 9082, "verse_number": "२-५-४", "content_sanskrit": "उपवासयितुं वीरं मन्त्रविन्मन्त्रकोविदम्।\nब्राह्मं रथवरं युक्तमास्थाय सुधृतव्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000082005, "chapter_id": 9082, "verse_number": "२-५-५", "content_sanskrit": "स रामभवनं प्राप्य पाण्डुराभ्रघनप्रभम्।\nतिस्रः कक्ष्या रथेनैव विवेश मुनिसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000082006, "chapter_id": 9082, "verse_number": "२-५-६", "content_sanskrit": "तमागतमृषिं रामस्त्वरन्निव ससम्भ्रमम्।\nमानयिष्यन् स मानार्हं निश्चक्राम निवेशनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000082007, "chapter_id": 9082, "verse_number": "२-५-७", "content_sanskrit": "अभ्येत्य त्वरमाणोऽथ रथाभ्याशं मनीषिणः।\nततोऽवतारयामास परिगृह्य रथात् स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000082008, "chapter_id": 9082, "verse_number": "२-५-८", "content_sanskrit": "स चैनं प्रश्रितं दृष्ट्वा सम्भाष्याभिप्रसाद्य च।\nप्रियार्हं हर्षयन् राममित्युवाच पुरोहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000082009, "chapter_id": 9082, "verse_number": "२-५-९", "content_sanskrit": "प्रसन्नस्ते पिता राम यत्त्वं राज्यमवाप्स्यसि।\nउपवासं भवानद्य करोतु सह सीतया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000082010, "chapter_id": 9082, "verse_number": "२-५-१०", "content_sanskrit": "प्रातस्त्वामभिषेक्ता हि यौवराज्ये नराधिपः।\nपिता दशरथः प्रीत्या ययातिं नहुषो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000082011, "chapter_id": 9082, "verse_number": "२-५-११", "content_sanskrit": "इत्युक्त्वा स तदा राममुपवासं यतव्रतः।\nमन्त्रवत् कारयामास वैदेह्या सहितं शुचिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000082012, "chapter_id": 9082, "verse_number": "२-५-१२", "content_sanskrit": "ततो यथावद् रामेण स राज्ञो गुरुरर्चितः।\nअभ्यनुज्ञाप्य काकुत्स्थं ययौ रामनिवेशनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000082013, "chapter_id": 9082, "verse_number": "२-५-१३", "content_sanskrit": "सुहृद्भिस्तत्र रामोऽपि सहासीनः प्रियंवदैः।\nसभाजितो विवेशाथ ताननुज्ञाप्य सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000082014, "chapter_id": 9082, "verse_number": "२-५-१४", "content_sanskrit": "हृष्टनारीनरयुतं रामवेश्म तदा बभौ।\nयथा मत्तद्विजगणं प्रफुल्लनलिनं सरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000082015, "chapter_id": 9082, "verse_number": "२-५-१५", "content_sanskrit": "स राजभवनप्रख्यात् तस्माद् रामनिवेशनात्।\nनिर्गत्य ददृशे मार्गं वसिष्ठो जनसंवृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000082016, "chapter_id": 9082, "verse_number": "२-५-१६", "content_sanskrit": "वृन्दवृन्दैरयोध्यायां राजमार्गाः समन्ततः।\nबभूवुरभिसम्बाधाः कुतूहलजनैर्वृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000082017, "chapter_id": 9082, "verse_number": "२-५-१७", "content_sanskrit": "जनवृन्दोर्मिसंघर्षहर्षस्वनवृतस्तदा।\nबभूव राजमार्गस्य सागरस्येव निःस्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000082018, "chapter_id": 9082, "verse_number": "२-५-१८", "content_sanskrit": "सिक्तसम्मृष्टरथ्या हि तथा च वनमालिनी।\nआसीदयोध्या तदहः समुच्छ्रितगृहध्वजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000082019, "chapter_id": 9082, "verse_number": "२-५-१९", "content_sanskrit": "तदा ह्ययोध्यानिलयः सस्त्रीबालाकुलो जनः।\nरामाभिषेकमाकांक्षन्नाकांक्षन्नुदयं रवेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000082020, "chapter_id": 9082, "verse_number": "२-५-२०", "content_sanskrit": "प्रजालंकारभूतं च जनस्यानन्दवर्धनम्।\nउत्सुकोऽभूज्जनो द्रष्टुं तमयोध्यामहोत्सवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000082021, "chapter_id": 9082, "verse_number": "२-५-२१", "content_sanskrit": "एवं तज्जनसम्बाधं राजमार्गं पुरोहितः।\nव्यूहन्निव जनौघं तं शनै राजकुलं ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000082022, "chapter_id": 9082, "verse_number": "२-५-२२", "content_sanskrit": "सिताभ्रशिखरप्रख्यं प्रासादमधिरुह्य च।\nसमीयाय नरेन्द्रेण शक्रेणेव बृहस्पतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000082023, "chapter_id": 9082, "verse_number": "२-५-२३", "content_sanskrit": "तमागतमभिप्रेक्ष्य हित्वा राजासनं नृपः।\nपप्रच्छ स्वमतं तस्मै कृतमित्यभिवेदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000082024, "chapter_id": 9082, "verse_number": "२-५-२४", "content_sanskrit": "तेन चैव तदा तुल्यं सहासीनाः सभासदः।\nआसनेभ्यः समुत्तस्थुः पूजयन्तः पुरोहितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000082025, "chapter_id": 9082, "verse_number": "२-५-२५", "content_sanskrit": "गुरुणा त्वभ्यनुज्ञातो मनुजौघं विसृज्य तम्।\nविवेशान्तःपुरं राजा सिंहो गिरिगुहामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000082026, "chapter_id": 9082, "verse_number": "२-५-२६", "content_sanskrit": "तदग्र्यवेषप्रमदाजनाकुलं\nमहेन्द्रवेश्मप्रतिमं निवेशनम्।\nव्यदीपयंश्चारु विवेश पार्थिवः\nशशीव तारागणसंकुलं नभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000082027, "chapter_id": 9082, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे पञ्चमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]