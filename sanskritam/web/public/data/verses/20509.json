[{"id": 7000509000, "chapter_id": 20509, "verse_number": "३-५६-१", "content_sanskrit": "व्यास उवाच ।\nनाद्याच्छूद्रस्य विप्रोन्नं मोहाद्वा यदि कामतः ।\nस शूद्रयोनिं व्रजति यस्तु भुंक्ते त्वनापदि॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000509001, "chapter_id": 20509, "verse_number": "३-५६-२", "content_sanskrit": "षण्मासान्यो द्विजो भुंक्ते शूद्रस्यान्नं विगर्हितम् ।\nजीवन्नेव भवेच्छूद्रो मृतः श्वा चाभिजायते॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000509002, "chapter_id": 20509, "verse_number": "३-५६-३", "content_sanskrit": "ब्राह्मणक्षत्रियविशां शूद्रस्य च मुनीश्वराः ।\nयस्यान्नेनोदरस्थेन मृतस्तद्योनिमाप्नुयात्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000509003, "chapter_id": 20509, "verse_number": "३-५६-४", "content_sanskrit": "राजान्नं वर्तकान्नं च षंढान्नं चर्म्मकारिणाम् ।\nगणान्नं गणिकान्नं च षडन्नं च विवर्जयेत्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000509004, "chapter_id": 20509, "verse_number": "३-५६-५", "content_sanskrit": "चक्रोपजीवि रजक तस्करध्वजिनां तथा ।\nगांधर्वलोहकारान्नं मृतकान्नं विवर्जयेत्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000509005, "chapter_id": 20509, "verse_number": "३-५६-६", "content_sanskrit": "कुलाल चित्रकारान्नं वार्धुषेः पतितस्य च ।\nपौनर्भवच्छत्रिकयोरभिशप्तस्य चैव हि॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000509006, "chapter_id": 20509, "verse_number": "३-५६-७", "content_sanskrit": "सुवर्णकार शैलूष व्याध वंध्यातुरस्य च ।\nचिकित्सकस्य चैवान्नं पुंश्चल्या दंडकस्य च॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000509007, "chapter_id": 20509, "verse_number": "३-५६-८", "content_sanskrit": "स्तेन नास्तिकयोरन्नं देवतानिंदकस्य च ।\nसोमविक्रयिणश्चान्नं श्वपाकस्य विशेषतः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000509008, "chapter_id": 20509, "verse_number": "३-५६-९", "content_sanskrit": "भार्य्याजितस्य चैवान्नं यस्य चोपपतिर्गृहे ।\nउत्सृष्टस्य कदर्यस्य तथैवोच्छिष्टभोजिनः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000509009, "chapter_id": 20509, "verse_number": "३-५६-१०", "content_sanskrit": "पापीयोन्नं च संघान्नं शस्त्राजीवस्य चैव हि ।\nभीतस्य रुदितस्यान्नमवक्रुष्टं परिक्षतम्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000509010, "chapter_id": 20509, "verse_number": "३-५६-११", "content_sanskrit": "ब्रह्मद्विषः पापरुचेः श्राद्धान्नं मृतकस्य च ।\nवृथापाकस्य चैवान्नं शावान्नं चातुरस्य च॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000509011, "chapter_id": 20509, "verse_number": "३-५६-१२", "content_sanskrit": "अप्रजानां तु नारीणां कृतघ्नस्य तथैव च ।\nकारुकान्नं विशेषेण शस्त्रविक्रयिणस्तथा॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000509012, "chapter_id": 20509, "verse_number": "३-५६-१३", "content_sanskrit": "शौंडान्नं घांटिकान्नं च भिषजामन्नमेव च ।\nविद्वत्प्रजननस्यान्नं परिवेत्रन्नमेव च॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000509013, "chapter_id": 20509, "verse_number": "३-५६-१४", "content_sanskrit": "पुनर्भुवो विशेषेण तथैव दिधिषूपतेः ।\nअवज्ञातं चावधूतं सरोषं विस्मयान्वितम्॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000509014, "chapter_id": 20509, "verse_number": "३-५६-१५", "content_sanskrit": "गुरोरपि न भोक्तव्यमन्नं संस्कारवर्जितम् ।\nदुष्कृतं हि मनुष्यस्य सर्वमन्ने व्यवस्थितम्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000509015, "chapter_id": 20509, "verse_number": "३-५६-१६", "content_sanskrit": "यो यस्यान्नं समश्नाति स तस्याश्नाति किल्बिषम् ।\nअर्द्धका कुलं मित्रं च गोपालो वाहनापि तौ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000509016, "chapter_id": 20509, "verse_number": "३-५६-१७", "content_sanskrit": "एते शूद्रेषु भोज्यान्ना यश्चात्मानं निवेदयेत् ।\nकुशीलवः कुंभकश्च क्षेत्रकर्मक एव च॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000509017, "chapter_id": 20509, "verse_number": "३-५६-१८", "content_sanskrit": "एते शूद्रेषु भोज्यान्ना दृष्ट्वा स्वल्पगुणं बुधैः ।\nपायसं स्नेहपक्वं च गोरसश्चैव सक्तवः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000509018, "chapter_id": 20509, "verse_number": "३-५६-१९", "content_sanskrit": "पिण्याकं चैव तैलं च शूद्राद्ग्राह्यं द्विजातिभिः ।\nवृंताकं नालिकाशाकं कुसुंभं भस्मकं तथा॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000509019, "chapter_id": 20509, "verse_number": "३-५६-२०", "content_sanskrit": "पलांडुं लशुनं शुक्तं निर्य्यासं चैव वर्जयेत् ।\nछत्राकं विड्वराहं च स्विन्नं पीयूषमेव च॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000509020, "chapter_id": 20509, "verse_number": "३-५६-२१", "content_sanskrit": "विलयं विमुखं चैव कोरकाणि विवर्जयेत् ।\nगृंजनं किंशुकं चैव कूष्मांडं च तथैव च॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000509021, "chapter_id": 20509, "verse_number": "३-५६-२२", "content_sanskrit": "उदुंबरमलाबुं च जग्ध्वा पतति वै द्विजः ।\nतथा कृसरसंयावौ पायसापूपमेव च॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000509022, "chapter_id": 20509, "verse_number": "३-५६-२३", "content_sanskrit": "अनुपाकृत मांसं च देवान्नानि हवींषि च ।\nयवागूं मातुलिगं च मत्स्यानप्यनुपाकृतान्॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000509023, "chapter_id": 20509, "verse_number": "३-५६-२४", "content_sanskrit": "नीपं कपित्थं प्लक्षं च प्रयत्नेन विवर्जयेत् ।\nपिण्याकं चोद्धृतस्नेहं देवधान्यं तथैव च॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000509024, "chapter_id": 20509, "verse_number": "३-५६-२५", "content_sanskrit": "रात्रौ च तिलसंबंधं प्रयत्नेन दधि त्यजेत् ।\nनाश्नीयात्पयसा तक्रं नाभक्ष्यानुपयोजयेत्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000509025, "chapter_id": 20509, "verse_number": "३-५६-२६", "content_sanskrit": "कृमिदुष्टं भावदुष्टं मृत्संसर्गं च वर्जयेत् ।\nकृमिकीटावपन्नं च सुहृत्क्लेदं च नित्यशः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000509026, "chapter_id": 20509, "verse_number": "३-५६-२७", "content_sanskrit": "श्वाघ्रातं च पुनः सिद्धं चंडालावेक्षितं तथा ।\nउदक्यया च पतितैर्गवा संघ्रातमेव च॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000509027, "chapter_id": 20509, "verse_number": "३-५६-२८", "content_sanskrit": "असंगतं पर्य्युषितं पर्यस्तान्नं च नित्यशः ।\nकाककुक्कुटसंस्पृष्टं कृमिभिश्चैव संगतम्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000509028, "chapter_id": 20509, "verse_number": "३-५६-२९", "content_sanskrit": "मनुष्यैरप्यवघ्रातं कुष्ठिना स्पृष्टमेव च ।\nन रजस्वलया दत्तं न पुंश्चल्या सरोगया॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000509029, "chapter_id": 20509, "verse_number": "३-५६-३०", "content_sanskrit": "मलवद्वाससा वापि परवासोथ वर्जयेत् ।\nविवत्सायाश्च गोक्षीरं मेषस्यानिर्दशस्य च॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000509030, "chapter_id": 20509, "verse_number": "३-५६-३१", "content_sanskrit": "आविकं संधिनीक्षीरमपेयं मनुरब्रवीत् ।\nबलाकं हंसदात्यूहं कलविंकं शुकं तथा॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000509031, "chapter_id": 20509, "verse_number": "३-५६-३२", "content_sanskrit": "कुरुरं च चकोरं च जालपादं च कोकिलम् ।\nवायसान्खंजरीटांश्च श्येनं गृध्रं तथैव च॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000509032, "chapter_id": 20509, "verse_number": "३-५६-३३", "content_sanskrit": "उलूकं चक्रवाकं च भासं पारावतं तथा ।\nकपोतं टिट्टिभं चैव ग्रामकुक्कुटमेव च॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000509033, "chapter_id": 20509, "verse_number": "३-५६-३४", "content_sanskrit": "सिंहं व्याघ्रं च मार्जारं श्वानं सूकरमेव च ।\nशृगालं मर्कटं चैव गर्द्दभं न च भक्षयेत्॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000509034, "chapter_id": 20509, "verse_number": "३-५६-३५", "content_sanskrit": "न भक्षयेत्सर्पमृगाञ्छिखिनोन्यान्वनेचरान् ।\nजलेचरान्स्थलचरान्प्राणिनश्चेति धारणा॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000509035, "chapter_id": 20509, "verse_number": "३-५६-३६", "content_sanskrit": "गोधा कूर्मः शशः खड्गः सल्लकश्चेति सत्तमाः ।\nभक्ष्यान्पंचनखान्नित्यं मनुराह प्रजापतिः॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000509036, "chapter_id": 20509, "verse_number": "३-५६-३७", "content_sanskrit": "मत्स्यान्सशल्कान्भुंजीत मांसं रौरवमेव च ।\nनिवेद्य देवताभ्यस्तु ब्राह्मणेभ्यश्च नान्यथा॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000509037, "chapter_id": 20509, "verse_number": "३-५६-३८", "content_sanskrit": "मयूरं तित्तिरं चैव कपोतं च कपिंजलम् ।\nवार्ध्रीणसं बकं भक्ष्यं मीनं हंसं पराजितम्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000509038, "chapter_id": 20509, "verse_number": "३-५६-३९", "content_sanskrit": "शफरी सिंहतुंडं च तथा पाठीनरोहितौ ।\nमत्स्याश्चैते समुद्दिष्टा भक्षणीया द्विजोत्तमाः॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000509039, "chapter_id": 20509, "verse_number": "३-५६-४०", "content_sanskrit": "प्रोक्षितं भक्षयेदेषां मांसं च द्विजकाम्यया ।\nयथाविधि प्रयुक्तं च प्राणानामपि चात्यये॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000509040, "chapter_id": 20509, "verse_number": "३-५६-४१", "content_sanskrit": "भक्षयेन्नैव मांसानि शेषभोजी न लिप्यते ।\nऔषधार्थमशक्तो वा नियोगाद्यज्ञकारणात्॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000509041, "chapter_id": 20509, "verse_number": "३-५६-४२", "content_sanskrit": "आमंत्रितश्च यः श्राद्धे दैवे वा मांसमुत्सृजेत् ।\nयावंति पशुरोमाणि तावन्नरकमृच्छति॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000509042, "chapter_id": 20509, "verse_number": "३-५६-४३", "content_sanskrit": "अदेयं वाप्यपेयं वा तथैवास्पृश्यमेव वा ।\nद्विजातीनामनालोक्यं नित्यं मद्यमिति स्थितिः॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000509043, "chapter_id": 20509, "verse_number": "३-५६-४४", "content_sanskrit": "तस्मात्सर्वप्रयत्नेन मद्यं नित्यं विवर्जयेत् ।\nपीत्वा पतति कर्म्मभ्यस्त्वसंभाष्यो भवेद्द्विजः॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000509044, "chapter_id": 20509, "verse_number": "३-५६-४५", "content_sanskrit": "भक्षयित्वाप्यभक्ष्याणि पीत्वाऽपेयान्यपि द्विजः ।\nनाधिकारी भवेत्तावद्यावत्तन्न जहात्यधः॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000509045, "chapter_id": 20509, "verse_number": "३-५६-४६", "content_sanskrit": "तस्मात्परिहरेन्नित्यमभक्ष्याणि प्रयत्नतः ।\nअपेयानि च विप्रो वै तथा चेद्याति रौरवम्॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]