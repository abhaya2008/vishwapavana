[{"id": 2206938, "chapter_id": 5411, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2206939, "chapter_id": 5411, "verse_number": "१", "content_sanskrit": "कथं वीर्यः समभवन् स राजा ददतां वरः ।\nकथं स जातरूपेण समायुज्यत वै नृपः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2206940, "chapter_id": 5411, "verse_number": "२", "content_sanskrit": "क्व च तत् साम्प्रतं द्रव्यं भगवन्नवतिष्ठते ।\nकथं च शक्यमस्माभिस्तदवाप्तुं तपोधन\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2206941, "chapter_id": 5411, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2206942, "chapter_id": 5411, "verse_number": "३", "content_sanskrit": "असुराश्चैव देवाश्च दक्षस्यासन् प्रजापतेः ।\nअपत्यं बहुलं तात तेऽस्पर्धन्त परस्परम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2206943, "chapter_id": 5411, "verse_number": "४", "content_sanskrit": "तथैवाङ्गिरसः पुत्रौ पितृतुल्यौ बभूवतुः ।\nबृहस्पतिर्बृहत्तेजाः संवर्तश्च तपोधनः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2206944, "chapter_id": 5411, "verse_number": "५", "content_sanskrit": "तावपि स्पर्धिनौ राजन् पृथगास्तां परस्परम् ।\nबृहस्पतिस्तु संवर्तं बाधते स्म पुनः पुनः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2206945, "chapter_id": 5411, "verse_number": "६", "content_sanskrit": "स बाध्यमानः सततं भ्रात्रा ज्येष्ठेन भारत ।\nअर्थानुत्सृत्य दिग्वासा वने वासमरोचयत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2206946, "chapter_id": 5411, "verse_number": "७", "content_sanskrit": "वासवोऽप्यसुरान् सर्वान् विजित्य च निपात्य च ।\nइन्द्रत्वं प्राप्य लोकेषु ततो वव्रे पुरोहितम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2206947, "chapter_id": 5411, "verse_number": "८", "content_sanskrit": "पुत्रमङ्गिरसो ज्येष्ठं विप्रज्येष्ठं बृहस्पतिम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2206948, "chapter_id": 5411, "verse_number": "९", "content_sanskrit": "याज्यस्त्वङ्गिरसः पूर्वमासीद् राजा करन्धमः ।\nवीर्येणाप्रतिमो लोके वृत्तेन च बलेन च\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2206949, "chapter_id": 5411, "verse_number": "१०", "content_sanskrit": "शतक्रतुरिवौजस्वी धर्मात्मा संशितव्रतः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2206950, "chapter_id": 5411, "verse_number": "११", "content_sanskrit": "वाहनं यस्य योधाश्च द्रव्याणि विविधानि च ।\nशयनानि च मुख्यानि महार्हाणि च सर्वशः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2206951, "chapter_id": 5411, "verse_number": "१२", "content_sanskrit": "ध्यानादेवाभवन् राजन् मुखवातेन सर्वशः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2206952, "chapter_id": 5411, "verse_number": "१३", "content_sanskrit": "स गुणैः पार्थिवान् सर्वान् वशे चक्रे नराधिपः ।\nसञ्जीव्य कालमिष्टं च सशरीरो दिवं गतः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2206953, "chapter_id": 5411, "verse_number": "१४", "content_sanskrit": "बभूव तस्य पुत्रस्तु ययातिरिव धर्मवित् ।\nअवीक्षिन्नाम शत्रुघ्नो यो वशे कृतवान् महीम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2206954, "chapter_id": 5411, "verse_number": "१५", "content_sanskrit": "विक्रमेण गुणैश्चैव पितेवासीत् स पार्थिवः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2206955, "chapter_id": 5411, "verse_number": "१६", "content_sanskrit": "तस्य वासवतुल्योऽभून्मरुत्तो नाम वीर्यवान् ।\nपुत्रस्तमनुरक्ताऽभूत् पृथिवी सागराम्बरा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2206956, "chapter_id": 5411, "verse_number": "१७", "content_sanskrit": "स्पर्धते सततं यस्माद् देवराजेन पार्थिवः ।\nवासवोऽपि मरुत्तेन स्पर्धते पाण्डुनन्दन\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2206957, "chapter_id": 5411, "verse_number": "१८", "content_sanskrit": "शुचिः स गुणवानासीत् मरुत्तः पृथिवीपतिः ।\nयतमानोऽपि यं शक्रो निर्विशेषयति स्म ह\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2206958, "chapter_id": 5411, "verse_number": "१९", "content_sanskrit": "सोऽशक्नुवन् विशेषाय समाहूय बृहस्पतिम् ।\nउवाचेदं वचो देवैः सहितो हरिवाहनः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2206959, "chapter_id": 5411, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2206960, "chapter_id": 5411, "verse_number": "२०", "content_sanskrit": "बृहस्पते मरुत्तस्य मा स्म कार्षीः कदाचन ।\nदैवं कर्माथ पित्र्यं च कर्तासि मम चेत् प्रियम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2206961, "chapter_id": 5411, "verse_number": "२१", "content_sanskrit": "अहं हि त्रिषु लोकेषु सुराणां च बृहस्पते ।\nइन्द्रत्वं प्राप्तवानेको मरुत्तस्तु महीपतिः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2206962, "chapter_id": 5411, "verse_number": "२२", "content_sanskrit": "कथं ह्यमर्त्यं ब्रह्मंस्त्वं याजयित्वा सुराधिपम् ।\nयाजयेर्मृत्युसंयुक्तं मरुत्तमविशङ्कया\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2206963, "chapter_id": 5411, "verse_number": "२३", "content_sanskrit": "मां वा वृणीष्व भद्रं ते मरुत्तं वा महीपतिम् ।\nपरित्यज्य मरुत्तं वा यथाजोषं भजस्व माम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2206964, "chapter_id": 5411, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2206965, "chapter_id": 5411, "verse_number": "२४", "content_sanskrit": "एवमुक्तः स कौरव्य देवराज्ञा बृहस्पतिः ।\nमुहूर्तमपि सञ्चिन्त्य देवराजानमब्रवीत्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2206966, "chapter_id": 5411, "verse_number": "", "content_sanskrit": "बृहस्पतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2206967, "chapter_id": 5411, "verse_number": "२५", "content_sanskrit": "त्वं भूतानामधिपतिस्त्वयि लोकाः समाहिताः ।\nनमुचेर्विश्वरूपस्य निहन्ता त्वं बलस्य च\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2206968, "chapter_id": 5411, "verse_number": "२६", "content_sanskrit": "त्वमाजहार्षीर्र्देवानामेकवीर्यः श्रियं पराम् ।\nत्वं बिभर्षि भुवं द्यां च सदैव बलसूदन\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2206969, "chapter_id": 5411, "verse_number": "२७", "content_sanskrit": "पौरोहित्यमहं कृत्वा तव देव सुरेश्वर ।\nयाजयेयं कथं मर्त्यं मरुत्तं पाकशासन\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2206970, "chapter_id": 5411, "verse_number": "२८", "content_sanskrit": "समाश्वसिहि देवेश नाहं मर्त्याय कर्हिचित् ।\nग्रहीष्यामि स्रुवं यज्ञे शृणु चेदं वचो मम\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2206971, "chapter_id": 5411, "verse_number": "२९", "content_sanskrit": "हिरण्यरेता नोष्णः स्यात् परिवर्तेत मेदिनी ।\nभासं च नो रविः कुर्यात् मत्सत्यं विचलेद् यदि\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2206972, "chapter_id": 5411, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2206973, "chapter_id": 5411, "verse_number": "३०", "content_sanskrit": "बृहस्पतिवचः श्रुत्वा शक्रो विगतमत्सरः ।\nप्रशस्यैनं विवेशाथ स्वमेव भवनं तदा\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2206974, "chapter_id": 5411, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्याम् आश्वमेधिकपर्वणि बृहस्पतिशपथवचनं नाम पञ्चमोऽध्यायः ॥५॥\nअश्वमेधपर्वणि पञ्चमोऽध्यायः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]