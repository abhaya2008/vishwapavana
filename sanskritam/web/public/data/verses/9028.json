[{"id": 5000028000, "chapter_id": 9028, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे अष्टाविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000028001, "chapter_id": 9028, "verse_number": "१-२८-१", "content_sanskrit": "प्रतिगृह्य ततोऽस्त्राणि प्रहृष्टवदनः शुचिः ।\nगच्छन्नेव च काकुत्स्थो विश्वामित्रमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000028002, "chapter_id": 9028, "verse_number": "१-२८-२", "content_sanskrit": "गृहीतास्त्रोऽस्मि भगवन् दुराधर्षः सुरैरपि ।\nअस्त्राणां त्वहमिच्छामि संहारान् मुनिपुङ्गव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000028003, "chapter_id": 9028, "verse_number": "१-२८-३", "content_sanskrit": "एवं ब्रुवति काकुत्स्थे विश्वामित्रो महातपाः ।\nसंहारान् व्याजहाराथ धृतिमान् सुव्रतः शुचिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000028004, "chapter_id": 9028, "verse_number": "१-२८-४", "content_sanskrit": "सत्यवन्तं सत्यकीर्तिं धृष्टं रभसमेव च ।\nप्रतिहारतरं नाम पराङ्मुखमवाङ्मुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000028005, "chapter_id": 9028, "verse_number": "१-२८-५", "content_sanskrit": "लक्ष्यालक्ष्याविमौ चैव दृढनाभसुनाभकौ ।\nदशाक्षशतवक्त्रौ च दशशीर्षशतोदरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000028006, "chapter_id": 9028, "verse_number": "१-२८-६", "content_sanskrit": "पद्मनाभमहानाभौ दुन्दुनाभसुनाभकौ ।\nज्योतिषं शकुनं चैव नैरास्यविमलावुभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000028007, "chapter_id": 9028, "verse_number": "१-२८-७", "content_sanskrit": "यौगन्धरविनिद्रौ च दैत्यप्रमथनौ तथा ।\nशुचिबाहुर्महाबाहुर्निष्कलिर्विरुचस्तथा ।\nसार्चिर्माली धृतिमाली वृत्तिमान् रुचिरस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000028008, "chapter_id": 9028, "verse_number": "१-२८-८", "content_sanskrit": "पित्र्यः सौमनसश्चैव विधूतमकरावुभौ ।\nपरवीरं रतिं चैव धनधान्यौ च राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000028009, "chapter_id": 9028, "verse_number": "१-२८-९", "content_sanskrit": "कामरूपं कामरुचिं मोहमावरणं तथा ।\nजृम्भकं सर्वनाभं च पन्थनवरुणौ तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000028010, "chapter_id": 9028, "verse_number": "१-२८-१०", "content_sanskrit": "कृशाश्वतनयान् राम भास्वरान् कामरूपिणः ।\nप्रतीच्छ मम भद्रं ते पात्रभूतोऽसि राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000028011, "chapter_id": 9028, "verse_number": "१-२८-११", "content_sanskrit": "बाढमित्येव काकुत्स्थः प्रहृष्टेनान्तरात्मना ।\nदिव्यभास्वरदेहाश्च मूर्तिमन्तः सुखप्रदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000028012, "chapter_id": 9028, "verse_number": "१-२८-१२", "content_sanskrit": "केचिदङ्गारसदृशाः केचिद् धूमोपमास्तथा ।\nचन्द्रार्कसदृशाः केचित् प्रह्वाञ्जलिपुटास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000028013, "chapter_id": 9028, "verse_number": "१-२८-१३", "content_sanskrit": "रामं प्राञ्जलयो भूत्वाब्रुवन् मधुरभाषिणः ।\nइमे स्म नरशार्दूल शाधि किं करवाम ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000028014, "chapter_id": 9028, "verse_number": "१-२८-१४", "content_sanskrit": "गम्यतामिति तानाह यथेष्टं रघुनन्दनः ।\nमानसाः कार्यकालेषु साहाय्यं मे करिष्यथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000028015, "chapter_id": 9028, "verse_number": "१-२८-१५", "content_sanskrit": "अथ ते राममामन्त्र्य कृत्वा चापि प्रदक्षिणम् ।\nएवमस्त्विति काकुत्स्थमुक्त्वा जग्मुर्यथागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000028016, "chapter_id": 9028, "verse_number": "१-२८-१६", "content_sanskrit": "स च तान् राघवो ज्ञात्वा विश्वामित्रं महामुनिम् ।\nगच्छन्नेवाथ मधुरं श्लक्ष्णं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000028017, "chapter_id": 9028, "verse_number": "१-२८-१७", "content_sanskrit": "किमेतन्मेघसंकाशं पर्वतस्याविदूरतः ।\nवृक्षखण्डमितो भाति परं कौतूहलं हि मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000028018, "chapter_id": 9028, "verse_number": "१-२८-१८", "content_sanskrit": "दर्शनीयं मृगाकीर्णं मनोहरमतीव च ।\nनानाप्रकारैः शकुनैर्वल्गुभाषैरलङ्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000028019, "chapter_id": 9028, "verse_number": "१-२८-१९", "content_sanskrit": "निःसृताःस्मो मुनिश्रेष्ठ कान्ताराद् रोमहर्षणात् ।\nअनया त्ववगच्छामि देशस्य सुखवत्तया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000028020, "chapter_id": 9028, "verse_number": "१-२८-२०", "content_sanskrit": "सर्वं मे शंस भगवन् कस्याश्रमपदं त्विदम् ।\nसंप्राप्ता यत्र ते पापा ब्रह्मघ्ना दुष्टचारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000028021, "chapter_id": 9028, "verse_number": "१-२८-२१", "content_sanskrit": "तव यज्ञस्य विघ्नाय दुरात्मानो महामुने ।\nभगवंस्तस्य को देशः सा यत्र तव याज्ञिकी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000028022, "chapter_id": 9028, "verse_number": "१-२८-२२", "content_sanskrit": "रक्षितव्या क्रिया ब्रह्मन् मया वध्याश्च राक्षसाः ।\nएतत् सर्वं मुनिश्रेष्ठ श्रोतुमिच्छाम्यहं प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000028023, "chapter_id": 9028, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे अष्टाविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]