[{"id": 2091375, "chapter_id": 2943, "verse_number": "१३-७३-१", "content_sanskrit": "युधिष्ठिर उवाच।\nस्त्रीणां स्वभावमिच्छामि श्रोतुं भरतसत्तम।\nस्त्रियो हि मूलं दोषाणां लघुचित्ता हि ताः स्मृताः?", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2091376, "chapter_id": 2943, "verse_number": "१३-७३-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2091377, "chapter_id": 2943, "verse_number": "१३-७३-२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nनारदस्य च संवादं पुंश्चल्या पञ्चचूडाया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2091378, "chapter_id": 2943, "verse_number": "१३-७३-३", "content_sanskrit": "लोकाननुचरन्सर्वान्देवर्षिर्नारदः पुरा।\nददर्शाप्सरसं ब्राह्मीं पञ्चचूडामनिन्दिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2091379, "chapter_id": 2943, "verse_number": "१३-७३-४", "content_sanskrit": "तां दृष्ट्वा चारुसर्वाङ्गीं पप्रच्चाप्सरसं मुनिः।\nसंशयो हृदि कश्चिन्मे ब्रूहि तन्मे सुमध्यमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2091380, "chapter_id": 2943, "verse_number": "१३-७३-५", "content_sanskrit": "एवमुक्ताऽथ सा विप्रं प्रत्युवाचाथ नारदम्।\nविषये सति वक्ष्यामि समर्थां मन्यसे च माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2091381, "chapter_id": 2943, "verse_number": "१३-७३-६x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2091382, "chapter_id": 2943, "verse_number": "१३-७३-६", "content_sanskrit": "न त्वामविषये भद्रे नियोक्ष्यामि कथञ्चन।\nस्त्रीणां स्वभावमिच्छामि त्वत्तः श्रोतुं वरानने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2091383, "chapter_id": 2943, "verse_number": "१३-७३-७", "content_sanskrit": "एतच्छ्रुत्वा वचस्तस्य देवर्षेरप्सरोत्तमा।\nप्रत्युवाच न शक्ष्यामि स्त्री सती निन्दितुं स्त्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2091384, "chapter_id": 2943, "verse_number": "१३-७३-८", "content_sanskrit": "विदितास्ते स्त्रियो याश्च यादृशाश्च स्वभावतः।\nन मामर्हसि देवर्षे नियोक्तुं कार्य ईदृशे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2091385, "chapter_id": 2943, "verse_number": "१३-७३-९", "content_sanskrit": "तामुवाच स देवर्षिः सत्यं वद सुमध्यमे।\nमृषावादे भवेद्दोषः सत्ये दोषो न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2091386, "chapter_id": 2943, "verse_number": "१३-७३-१०", "content_sanskrit": "इत्युक्ता सा कृतमतिरभवच्चारुहासिनी।\nस्त्रीदोषाञ्शाश्वतान्सत्यान्भाषितुं सम्प्रचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2091387, "chapter_id": 2943, "verse_number": "१३-७३-११", "content_sanskrit": "कुलीना रूपवत्यश्च नाथवत्यश्च योषितः।\nमर्यादासु न तिष्ठन्ति स दोषः स्त्रीषु नारद", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2091388, "chapter_id": 2943, "verse_number": "१३-७३-१२", "content_sanskrit": "न स्त्रीभ्यः किञ्चिदन्यद्वै पापीयस्तरमस्ति वै।\nस्त्रियो हि मूलं दोषाणां तथा त्वमपि वेत्थ ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2091389, "chapter_id": 2943, "verse_number": "१३-७३-१३", "content_sanskrit": "समाज्ञातानृद्धिमतः प्रतिरूपान्वशे स्थितान्।\nपतीनन्तरमासाद्य नालं नार्यः परीक्षितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2091390, "chapter_id": 2943, "verse_number": "१३-७३-१४", "content_sanskrit": "असद्धर्मस्त्वयं स्त्रीणामस्माकं भवति प्रभो।\nपापीयसो नरान्यद्वै लज्जां त्यक्त्वा भजामहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2091391, "chapter_id": 2943, "verse_number": "१३-७३-१५", "content_sanskrit": "स्त्रियं हि यः प्रार्थयते सन्निकर्षं च गच्छति।\nईषच्च कुरुते सेवां तमेवेच्छन्ति योषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2091392, "chapter_id": 2943, "verse_number": "१३-७३-१६", "content_sanskrit": "अनर्थित्वान्मनुष्याणां भयात्परिजनस्य च।\nमर्यादायाममर्यादाः स्त्रियस्तिष्ठन्ति भर्तृषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2091393, "chapter_id": 2943, "verse_number": "१३-७३-१७", "content_sanskrit": "नासां कश्चिदगम्योस्ति नासां वयसि निश्चयः॥\nविरूपं रूपवन्तं वा पुमानित्येव भुञ्जते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2091394, "chapter_id": 2943, "verse_number": "१३-७३-१८", "content_sanskrit": "न भयान्नाप्यनुक्रोशान्नार्थहेतोः कथञ्चन।\nन ज्ञातिकुलसम्बन्धात्स्त्रियस्तिष्ठन्ति भर्तृषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2091395, "chapter_id": 2943, "verse_number": "१३-७३-१९", "content_sanskrit": "यौवने वर्तमानानां मृष्टाभरणवाससाम्।\nनारीणां खैरवृत्तीनां स्पृहयन्ति कुलस्त्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2091396, "chapter_id": 2943, "verse_number": "१३-७३-२०", "content_sanskrit": "याश्च शश्वद्बहुमता रक्ष्यन्ते दयिताः स्त्रियः।\nअपि ताः सम्प्रसज्जन्ते कुब्जान्धजडवामनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2091397, "chapter_id": 2943, "verse_number": "१३-७३-२१", "content_sanskrit": "पङ्गुष्वथ च देवर्षे ये चान्ये कुत्सिता नराः।\nस्त्रीणामगम्यो लोकेऽस्मिन्नास्ति कश्चिन्महामुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2091398, "chapter_id": 2943, "verse_number": "१३-७३-२२", "content_sanskrit": "यदि पुंसां गतिर्ब्रह्मन्कथंचिन्नोपपद्यते।\nअप्यन्योन्यं प्रवर्तन्ते न हि तिष्ठन्ति भर्तृषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2091399, "chapter_id": 2943, "verse_number": "१३-७३-२३", "content_sanskrit": "`दुष्टाचाराः पापरता असत्या मायया वृताः।\nअदृष्टबुद्धिबहुलाः प्रायेणेत्यवगम्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2091400, "chapter_id": 2943, "verse_number": "१३-७३-२४", "content_sanskrit": "अलाभात्पुरुषाणां हि भयात्परिजनस्य च।\nवधबन्धभयाच्चापि स्वयं गुप्ता भवन्ति ताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2091401, "chapter_id": 2943, "verse_number": "१३-७३-२५", "content_sanskrit": "चलस्वभावा दुःसेव्या दुर्ग्राह्या भावतस्तथा।\nप्राज्ञस्य पुरुषस्येह यथाभावास्तथा स्त्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2091402, "chapter_id": 2943, "verse_number": "१३-७३-२६", "content_sanskrit": "नाग्निस्तृप्यति काष्ठानां नापगानां महोदधिः।\nनान्तकः सर्वभूतानां न पुंसां वामलोचनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2091403, "chapter_id": 2943, "verse_number": "१३-७३-२७", "content_sanskrit": "इदमन्यच्च देवर्षे रहस्यं सर्वयोषिताम्।\nदृष्ट्वैव पुरुषं ह्यन्यं योनिः प्रक्लिद्यते स्त्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2091404, "chapter_id": 2943, "verse_number": "१३-७३-२८", "content_sanskrit": "कामानामपि दातारं कर्तारं मानसान्त्वयोः।\nरक्षितारं न मृष्यन्ति स्वभर्तारमसत्स्त्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2091405, "chapter_id": 2943, "verse_number": "१३-७३-२९", "content_sanskrit": "न कामभोगान्विपुलान्नालङ्कारार्थसञ्चयान्।\nतथैव बहुमन्वन्ते यथा रत्यामनुग्रहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2091406, "chapter_id": 2943, "verse_number": "१३-७३-३०", "content_sanskrit": "अन्तकः शमनो मृत्युः पातालं बडबामुखम्।\nक्षुरधारा विषं सर्पो वह्निरित्येकतः स्त्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2091407, "chapter_id": 2943, "verse_number": "१३-७३-३१", "content_sanskrit": "यतश्च भूतानि महान्ति पञ्च\nयतश्च लोका विहिता विधात्रा।\nयतः पुमांसः प्रमदाश्च निर्मिता-\nस्ततश्च दोषाः प्रमदासु नारद॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2091408, "chapter_id": 2943, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि त्रिसप्ततितमोऽध्यायः॥१३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]