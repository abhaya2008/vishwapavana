[{"id": 2096037, "chapter_id": 3050, "verse_number": "१३-१८०-१", "content_sanskrit": "व्यास उवाच।\nशुभेन कर्मणा यद्वै तिर्यग्योनौ न मुह्यसे।\nममैव कीट तत्कर्म येन त्वं न प्रमुह्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2096038, "chapter_id": 3050, "verse_number": "१३-१८०-२", "content_sanskrit": "अहं त्वां दर्शनादेव तारयामि तपोबलात्।\nतपोबलाद्धि बलवद्बलमन्यन्न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2096039, "chapter_id": 3050, "verse_number": "१३-१८०-३", "content_sanskrit": "जानामि पापैः स्वकृतैर्गतं त्वां कीट कीटताम्।\nअवाप्स्य्सि परं र्धर्मं मानुष्ये यदि मन्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2096040, "chapter_id": 3050, "verse_number": "१३-१८०-४", "content_sanskrit": "कर्मभूमिकृतं देवा भुञ्जते तिर्यगाश्च ये।\nधन्या अपि मनुष्येषु कामार्थाश्च यथा गुणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2096041, "chapter_id": 3050, "verse_number": "१३-१८०-५", "content_sanskrit": "वाग्बुद्धिपाणिपादैश्च समुपेता विपश्चितः।\nकिमायाति मनुष्यस्य मन्दस्यार्थस्य जीवतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2096042, "chapter_id": 3050, "verse_number": "१३-१८०-६", "content_sanskrit": "दैवे यः कुरुते पूजां विप्राग्निशशिसूर्ययोः।\nब्रुवन्नपि कथां पुण्यां तत्र कीट त्वमेष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2096043, "chapter_id": 3050, "verse_number": "१३-१८०-७", "content_sanskrit": "गुणभूतानि भूतानि तत्र त्वमुपभोक्ष्यसे।\nक्रमात्तेऽहं विनेष्यामि ब्रह्मत्वं यदि चेच्छसि।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2096044, "chapter_id": 3050, "verse_number": "१३-१८०-७x", "content_sanskrit": "भीष्म उवाच।\nस तथेति प्रतिश्रुत्य कीटः समवतिष्ठत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2096045, "chapter_id": 3050, "verse_number": "१३-१८०-८", "content_sanskrit": "*तमृषिं द्रष्टुमगमत्सर्वास्वन्यासु योनिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2096046, "chapter_id": 3050, "verse_number": "१३-१८०-९", "content_sanskrit": "श्वाविद्गोधावराहाणां तथैव मृगपक्षिणाम्।\nश्वपाकशूद्रवैश्यानां क्षत्रियाणां च योनिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2096047, "chapter_id": 3050, "verse_number": "१३-१८०-१०", "content_sanskrit": "स कीटे एवमाख्यातमृषिणा सत्यवादिना।\nप्रतिस्मृत्याथ जग्राह पादौ मूर्ध्नि कृताञ्जलिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2096048, "chapter_id": 3050, "verse_number": "१३-१८०-११x", "content_sanskrit": "कीट उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2096049, "chapter_id": 3050, "verse_number": "१३-१८०-११", "content_sanskrit": "इदं तदतुलं स्थानमीप्सितं दशभिर्गुणैः।\nयदहं प्राप्य कीटत्वमागतो राजपुत्रताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2096050, "chapter_id": 3050, "verse_number": "१३-१८०-१२", "content_sanskrit": "वहन्ति मामतिबलाः कुञ्जरा हेममालिनः।\nस्यन्दनेषु च काम्भोजा युक्ताःसमरवाजिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2096051, "chapter_id": 3050, "verse_number": "१३-१८०-१३", "content_sanskrit": "उष्ट्राश्वतरयुक्तानि यानानि च वहन्ति माम्।\nसबान्धवः सहामात्यश्चाश्नामि पिशिताशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2096052, "chapter_id": 3050, "verse_number": "१३-१८०-१४", "content_sanskrit": "गृहेषु स्वनिवासेषु सुखेषु शयनेषु च।\nवरार्हेषु महाभाग स्वपामि च सुपूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2096053, "chapter_id": 3050, "verse_number": "१३-१८०-१५", "content_sanskrit": "सर्वेष्वपररात्रेषु सूतमागधबन्दिनः।\nस्तुवन्ति मां यथा देवा महेन्द्रं प्रियवादिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2096054, "chapter_id": 3050, "verse_number": "१३-१८०-१६", "content_sanskrit": "प्रसादात्सत्यसन्धस्य भवतोऽमिततेजसः।\nयदहं कीटतां प्राप्य स्मृतिजाता जुगुप्सिताम्।\nननु नाशोस्ति पापस्य यन्मयोपचितं पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2096055, "chapter_id": 3050, "verse_number": "१३-१८०-१७", "content_sanskrit": "[नमस्तेऽस्तु महाप्राज्ञ किं करोमि प्रशाधि माम्।\nत्वत्तपोबलनिर्दिष्टमिदं ह्यधिगतं मया॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2096056, "chapter_id": 3050, "verse_number": "१३-१८०-१८x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2096057, "chapter_id": 3050, "verse_number": "१३-१८०-१८", "content_sanskrit": "[अर्चितोऽहं त्वया राजन्वाग्भिरद्य यदृच्छया।\nअद्य ते कीटतां प्राप्य स्मृतिर्जाताजुगुप्सिताम्]॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2096058, "chapter_id": 3050, "verse_number": "१३-१८०-१९", "content_sanskrit": "शूद्रेणार्थप्रधानेन नृशंसेनाततायिना।\nममैतद्दर्शनं प्राप्तं तच्च वै सुकृतं पुरा।\nतिर्यग्योनौ स्म जातेन मम चाभ्यर्चनात्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2096059, "chapter_id": 3050, "verse_number": "१३-१८०-२०", "content_sanskrit": "इतस्त्वं राजपुत्रत्वाद्ब्राह्मण्यं समवाप्स्यसि।\nगोब्राह्मणकृते प्राणान्हित्वाऽऽत्मीयान्रणाजिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2096060, "chapter_id": 3050, "verse_number": "१३-१८०-२१x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2096061, "chapter_id": 3050, "verse_number": "१३-१८०-२१", "content_sanskrit": "राजपुत्रः सुखं प्राप्य ईजे चैवाप्तदक्षिणैः।\nअथ चोद्दीप्यत स्वर्गे प्रभूतोप्यव्ययः सुखी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2096062, "chapter_id": 3050, "verse_number": "१३-१८०-२२", "content_sanskrit": "तिर्यग्योन्याः शूद्रतामभ्यपैति\nशूद्रो वैश्यं क्षत्रियत्वं च वैश्यः।\nवृत्तश्लाघी क्षत्रियो ब्राह्मणत्वं\nस्वर्गं पुण्याद्ब्राह्मणः साधुवृत्तः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2096063, "chapter_id": 3050, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि अशीत्यधिकशततमोऽध्यायः॥ १८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]