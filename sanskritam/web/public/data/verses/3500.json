[{"id": 2116144, "chapter_id": 3500, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2116145, "chapter_id": 3500, "verse_number": "१", "content_sanskrit": "ऋष्योस्तु यत्कृते वैरं विश्वामित्रवसिष्ठयोः ।\nबभूव गन्धर्वपते शंस नः सर्वमेव तु \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2116146, "chapter_id": 3500, "verse_number": "२", "content_sanskrit": "माहात्म्यं च वसिष्ठस्य ब्राह्मण्यं ब्रह्मतेजसः ।\nविश्वामित्रस्य च तथा क्षत्रस्य च महात्मनः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2116147, "chapter_id": 3500, "verse_number": "३", "content_sanskrit": "न शृण्वानस्त्वहं तृप्तिमुपगच्छामि खेचर ।\nआख्याहि गन्धर्वपते तत्कथासारमेव च ।\nमाहात्म्यं च वसिष्ठस्य विचित्राणि च भाषसे \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2116148, "chapter_id": 3500, "verse_number": "", "content_sanskrit": "गन्धर्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2116149, "chapter_id": 3500, "verse_number": "४", "content_sanskrit": "इदं वासिष्ठमाख्यानं पुराणं पुण्यमुत्तमम् ।\nपार्थ सर्वेषु लोकेषु विश्रुतं तन्निबोध मे \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2116150, "chapter_id": 3500, "verse_number": "५", "content_sanskrit": "कल्माषपाद इत्यस्मिन् लोके राजा बभूव ह ।\nइक्ष्वाकूणां कुले जातस्तेजसाऽसदृशो भुवि\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2116151, "chapter_id": 3500, "verse_number": "६", "content_sanskrit": "स कदाचिद् वने रम्ये मृगयामाचरद् बली ।\nमृगान् निघ्नन् वराहांश्च चचार रिपुसूदनः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2116152, "chapter_id": 3500, "verse_number": "७", "content_sanskrit": "स तु राजा महात्मानं वासिष्ठमृषिसत्तमम् ।\nसुतृष्णार्तः क्षुधार्तश्च एकायनगतः पथि \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2116153, "chapter_id": 3500, "verse_number": "८", "content_sanskrit": "अपश्यदजितः सङ्खे मुनिं प्रतिमुखागतम् ।\nशक्तिं नाम महाभागं वसिष्ठकुलनन्दनम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2116154, "chapter_id": 3500, "verse_number": "९", "content_sanskrit": "ज्येष्ठं पुत्रशतात् पुत्रं वसिष्ठस्य महात्मनः ।\nअपगच्छ पथोऽस्माकमित्येवं पार्थिवोऽब्रवीत् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2116155, "chapter_id": 3500, "verse_number": "१०", "content_sanskrit": "स चाप्यृषिरुवाचैनं सान्त्वयञ्श्लक्ष्णया गिरा ।\nमम पन्था महाराज धर्म एष सनातनः ।\nराज्ञा धर्मेण सङ्कल्प्य देयः पन्था द्विजातये \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2116156, "chapter_id": 3500, "verse_number": "", "content_sanskrit": "गन्धर्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2116157, "chapter_id": 3500, "verse_number": "११", "content_sanskrit": "ऋषिस्तु नापचक्राम तस्मिन् धर्मपथे स्थितः ।\nअपि राजा मुनेर्मार्गात् क्रोधान्नापजगाम ह \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2116158, "chapter_id": 3500, "verse_number": "१२", "content_sanskrit": "अमुञ्चन्तं तु पन्थानं तमृषिं नृपसत्तमः ।\nजघान कशया मोहान्नृपो राक्षसवन्मुनिम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2116159, "chapter_id": 3500, "verse_number": "१३", "content_sanskrit": "कशाप्रहाराभिहतो राजानमृषिसत्तमः ।\nतं शशाप नृपश्रेष्ठं वासिष्ठः क्रोधमूर्च्छितः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2116160, "chapter_id": 3500, "verse_number": "१४", "content_sanskrit": "हंसि राक्षसवद् यन्मां राजापशद तापसम् ।\nतस्मात् त्वमद्यप्रभृति पुरुषादो भविष्यसि \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2116161, "chapter_id": 3500, "verse_number": "१५", "content_sanskrit": "मनुष्यपिशिते सक्तश्चरिष्यसि महीमिमाम् ।\nगच्छ राजाधमेत्युक्तः शक्तिना वीर्यशक्तिना \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2116162, "chapter_id": 3500, "verse_number": "१६", "content_sanskrit": "ततो याज्यनिमित्तं तु विश्वामित्रवसिष्ठयोः ।\nवैरमासीद् तदा तं तु विश्वामित्रोऽन्वविन्दत \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2116163, "chapter_id": 3500, "verse_number": "१७", "content_sanskrit": "तयोर्विवदतोरेवं समीपमुपचक्रमे ।\nऋषिरुग्रतपाः पार्थ विश्वामित्रः प्रतापवान् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2116164, "chapter_id": 3500, "verse_number": "१८", "content_sanskrit": "ततः स बुबुधे पश्चात् तमृषिं नृपसत्तम ।\nऋषेः पुत्रं वसिष्ठस्य वसिष्ठमिव तेजसा \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2116165, "chapter_id": 3500, "verse_number": "१९", "content_sanskrit": "अन्तर्धाय तदाऽऽत्मानं विश्वामित्रस्तु भारत ।\nतावुभावुपचक्राम चिकीर्षन्नात्मनः प्रियम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2116166, "chapter_id": 3500, "verse_number": "२०", "content_sanskrit": "स तु शप्तस्तदा तेन शक्तिना वै नृपोत्तमः ।\nजगाम शरणं राजा प्रसादयितुमर्हयन् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2116167, "chapter_id": 3500, "verse_number": "२१", "content_sanskrit": "तस्य भावं विदित्वा तु नृपतेः कुरुनन्दन ।\nविश्वामित्रस्ततो रक्ष आदिदेश नृपं प्रति \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2116168, "chapter_id": 3500, "verse_number": "२२", "content_sanskrit": "स शापात् तस्य विप्रर्षेर्विश्वामित्रस्य चाज्ञया ।\nराक्षसः किन्नरो नाम विवेश नृपतिं तदा \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2116169, "chapter_id": 3500, "verse_number": "२३", "content_sanskrit": "रक्षसा तु गृहीतं तं विदित्वा मुनिसत्तमः ।\nविश्वामित्रोऽप्यपाक्रामत् तस्माद् देशादरिन्दम \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2116170, "chapter_id": 3500, "verse_number": "२४", "content_sanskrit": "ततश्च नृपतिर्विद्वान् रक्षन्नात्मानमात्मना ।\nबलवत् पीड्यमानोऽपि नान्वबुध्यत किञ्चन\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2116171, "chapter_id": 3500, "verse_number": "२५", "content_sanskrit": "ददर्श तं द्विजः कश्चिद् राजानं पुनरागतम् ।\nअयाचत् क्षुधितश्चैनं समांसं भोजनं तदा \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2116172, "chapter_id": 3500, "verse_number": "२६", "content_sanskrit": "तमुवाच स राजर्षिर्द्विजं मित्रसहस्तदा ।\nआस्स्व ब्रह्मंस्त्वमत्रैव मुहूर्तमिव सान्त्वयन् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2116173, "chapter_id": 3500, "verse_number": "२७", "content_sanskrit": "विनिवृत्तः प्रदास्यामि भोजनं ते यथेप्सितम् ।\nइत्युक्त्वा प्रययौ राजा तस्थौ स द्विजसत्तमः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2116174, "chapter_id": 3500, "verse_number": "२८", "content_sanskrit": "अन्तःपुरं गतो राजा श्रुत्वा ब्राह्मणभाषितम् ।\nसोऽन्तःपुरं प्रविश्याथ न सस्मार नराधिपः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2116175, "chapter_id": 3500, "verse_number": "२९", "content_sanskrit": "ततोऽर्धरात्र उत्थाय सूदमानाय्य सत्तमः ।\nउवाच वचनं स्मृत्य ब्राह्मणस्य प्रतिश्रुतम् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2116176, "chapter_id": 3500, "verse_number": "३०", "content_sanskrit": "गच्छामुष्मिन्नसौ देशे ब्राह्मणो मां प्रतीक्षते ।\nअन्नार्थिनं त्वमन्नेन समांसेनोपपादय \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2116177, "chapter_id": 3500, "verse_number": "", "content_sanskrit": "गन्धर्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2116178, "chapter_id": 3500, "verse_number": "३१", "content_sanskrit": "एवमुक्तस्तदा सूदः सोऽनासाद्यामिषं क्वचित् ।\nनिवेदयामास पुनस्तस्मै राज्ञे व्यथान्वितः \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2116179, "chapter_id": 3500, "verse_number": "३२", "content_sanskrit": "राजा तु रक्षसाऽऽविष्टः सूदमाह गतव्यथः ।\nअप्येनं नरमांसेन भोजयेति पुनःपुनः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2116180, "chapter_id": 3500, "verse_number": "३३", "content_sanskrit": "तथेत्युक्त्वा ततः सूदः संस्थानं वध्यघातिनः ।\nगत्वाऽऽजहार त्वरितो नरमांसमपेतभीः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2116181, "chapter_id": 3500, "verse_number": "३४", "content_sanskrit": "ततः संस्कृत्य विधिवदन्नं सामिषमाशु वै ।\nतस्मै प्रादाद् ब्राह्मणाय क्षुधिताय तपस्विने \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2116182, "chapter_id": 3500, "verse_number": "३५", "content_sanskrit": "स दिव्यचक्षुर्दृष्ट्वा तु तदन्नं द्विजसत्तमः ।\nअभोज्यमिति मत्वाऽऽह क्रोधपर्याकुलेक्षणः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2116183, "chapter_id": 3500, "verse_number": "३६", "content_sanskrit": "यस्मादभोज्यमन्नं मे ददाति स नृपाधमः ।\nतस्मात् तस्यैव मूढस्य भविष्यत्यत्र लोलुपः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2116184, "chapter_id": 3500, "verse_number": "३७", "content_sanskrit": "सक्तो मानुषमांसेषु यथोक्तं शक्तिना पुरा ।\nउद्वेजनीयो भूतानां चरिष्यति महीमिमाम् \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2116185, "chapter_id": 3500, "verse_number": "", "content_sanskrit": "गन्धर्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2116186, "chapter_id": 3500, "verse_number": "३८", "content_sanskrit": "द्विरनुव्याहृते वाक्ये शापो हि बलवानभूत् ।\nरक्षोबलसमाविष्टो विसञ्ज्ञश्चाभवत् तदा \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2116187, "chapter_id": 3500, "verse_number": "३९", "content_sanskrit": "ततः स नृपतिः पार्थ रक्षसाऽपहृतेन्द्रियः ।\nउवाच शक्तिं दृष्ट्वा तु नचिरादिव भारत \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2116188, "chapter_id": 3500, "verse_number": "४०", "content_sanskrit": "यस्मादसदृशः शापः प्रयुक्तोऽयं मयि त्वया ।\nतस्मात् त्वत्तः प्रवर्तिष्ये खादितुं मानुषानहम् \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2116189, "chapter_id": 3500, "verse_number": "४१", "content_sanskrit": "एवमुक्त्वा ततः सद्यः तं प्राणैर्विप्रयोज्य सः ।\nशक्तिनं भक्षयामास व्याघ्रः पशुमिवेप्सितम् \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2116190, "chapter_id": 3500, "verse_number": "४२", "content_sanskrit": "शक्तिनं तु हतं दृष्ट्वा विश्वामित्रस्ततः पुनः ।\nवसिष्ठस्यैव पुत्रेषु तद्रक्षः सन्दिदेश ह \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2116191, "chapter_id": 3500, "verse_number": "४३", "content_sanskrit": "स तान् शतावरान् पुत्रान् वसिष्ठस्य महात्मनः ।\nभक्षयामास सङ्क्रुद्धः सिंहः क्षुद्रमृगानिव \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2116192, "chapter_id": 3500, "verse_number": "४४", "content_sanskrit": "वसिष्ठो घातितान् श्रुत्वा विश्वामित्रेण स्वान् सुतान् ।\nधारयामास संशोकं महाद्रिरिव मेदिनीम् \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2116193, "chapter_id": 3500, "verse_number": "४५", "content_sanskrit": "चक्रे चात्मविनाशाय बुद्धिं स मुनिपुङ्गवः ।\nन त्वेव कुशिकोच्छेदं मेने मतिमतां वरः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2116194, "chapter_id": 3500, "verse_number": "४६", "content_sanskrit": "स मेरुकूटादात्मानं मुमोच भगवानृषिः ।\nशिरस्तस्य शिलायां च तूलराशाविवापतत् \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2116195, "chapter_id": 3500, "verse_number": "४७", "content_sanskrit": "न ममार च पातेन तदा स मुनिसत्तमः ।\nअथाऽग्निमिद्ध्वा भगवान् संविवेश महावने \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2116196, "chapter_id": 3500, "verse_number": "४८", "content_sanskrit": "तं तदा सुसमिद्धोऽपि न ददाह हुताशनः ।\nदीप्यमानोऽप्यमित्रघ्न शीतोऽग्निरभवत् तदा \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2116197, "chapter_id": 3500, "verse_number": "४९", "content_sanskrit": "स समुद्रमभिप्रेत्य शोकाविष्टो महामुनिः ।\nबद्ध्वा कण्ठे शिलां गुर्वीं निपपात तदम्भसि \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2116198, "chapter_id": 3500, "verse_number": "५०", "content_sanskrit": "स समुद्रोर्मिवेगेन स्थले न्यस्तो महामुनिः ।\nजगाम सततं खिन्नः पुनरेवाश्रमं प्रति \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2116199, "chapter_id": 3500, "verse_number": "१७९", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nएकोनाशीत्यधिकशततमोऽध्यायः ॥१७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2116200, "chapter_id": 3500, "verse_number": "१२", "content_sanskrit": "॥ इति चैत्ररथपर्वणि द्वादशोऽध्यायः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2116201, "chapter_id": 3500, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]