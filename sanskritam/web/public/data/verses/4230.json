[{"id": 2149279, "chapter_id": 4230, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2149280, "chapter_id": 4230, "verse_number": "१", "content_sanskrit": "दुर्योधनस्य तद्वाक्यं निशम्य भरतर्षभः ।\nनेत्राभ्यामतिताम्राभ्यां कैतव्यं समदृश्यत\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2149281, "chapter_id": 4230, "verse_number": "२", "content_sanskrit": "स केशवमभिप्रेक्ष्य गुडाकेशो महायशाः ।\nअभ्यभाषत कैतव्यं प्रगृह्य विपुलं भुजम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2149282, "chapter_id": 4230, "verse_number": "३", "content_sanskrit": "स्ववीर्यं यः समाश्रित्य समाह्वयति वै परान् ।\nअभीतो युद्ध्यते शत्रून् स वै पुरुष उच्यते\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2149283, "chapter_id": 4230, "verse_number": "४", "content_sanskrit": "परवीर्यं समाश्रित्य यः समाह्वयते परान् ।\nक्षत्रबन्धुरशक्तत्वाल्लोके स पुरुषाधमः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2149284, "chapter_id": 4230, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2149285, "chapter_id": 4230, "verse_number": "५", "content_sanskrit": "स त्वं परेषां वीर्येण मन्यसे वीर्यमात्मनः ।\nस्वयं कापुरुषो मूढ परांश्च क्षेप्तुमिच्छसि\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2149286, "chapter_id": 4230, "verse_number": "६", "content_sanskrit": "यस्त्वं वृद्धं सर्वराज्ञां हितबुद्धिं जितेन्द्रियम् ।\nमरणाय महाप्राज्ञं दीक्षयित्वा विकत्थसे\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2149287, "chapter_id": 4230, "verse_number": "७", "content_sanskrit": "भावस्ते विदितोऽस्माभिर्दुर्बुद्धे कुलपांसन ।\nन हनिष्यन्ति गाङ्गेयं पाण्डवा घृणयेति ह\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2149288, "chapter_id": 4230, "verse_number": "८", "content_sanskrit": "यस्य वीर्यं समाश्रित्य धार्तराष्ट्र विकत्थसे ।\nहन्तास्मि प्रथमं भीष्मं मिषतां सर्वधन्विनाम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2149289, "chapter_id": 4230, "verse_number": "९", "content_sanskrit": "कैतव्य गत्वा भरतान् समेत्य\nसुयोधनं धार्तराष्ट्रं ब्रवीहि ।\nतथेत्युवाचार्जुनः सव्यसाची ।\nनिशाव्यपाये भविता विमर्दः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2149290, "chapter_id": 4230, "verse_number": "१०", "content_sanskrit": "यत् त्वाऽब्रवीद् वाक्यमदीनसत्वो\nमध्ये कुरून् हर्षयन् सत्यसन्धः ।\nअहं हन्ता सृञ्जयानामनीकं\nसाल्वेयकांश्चेति ममैष भारः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2149291, "chapter_id": 4230, "verse_number": "११", "content_sanskrit": "हन्याम्यहं द्रोणमृतेऽपि लोकं\nन मे भयं विद्यते पाण्डवेभ्यः ।\nततो हि मे लब्धमदश्च राज्यम्\nआपद्गताः पाण्डवाश्चेति भावः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2149292, "chapter_id": 4230, "verse_number": "१२", "content_sanskrit": "स दर्पपूर्णो न समीक्षसे त्वं\nअनर्थमात्मन्यपि वर्तमानम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2149293, "chapter_id": 4230, "verse_number": "१३", "content_sanskrit": "तस्मादहं ते प्रथमं समूहे\nहन्ता समक्षं कुरुवृद्धमेव ।\nसूर्योदये युक्तसेनः प्रतीक्ष\nध्वजी रथी रक्ष च सत्यसन्धम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2149294, "chapter_id": 4230, "verse_number": "१४", "content_sanskrit": "अहं हि वः पश्यतां वै समक्षं\nभीष्मं रथात् पातयिष्यामि बाणैः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2149295, "chapter_id": 4230, "verse_number": "१५", "content_sanskrit": "श्वोभूते कत्थनावाक्यं विज्ञास्यसि सुयोधन ।\nआचितं शरजालेन मया दृष्ट्वा पितामहम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2149296, "chapter_id": 4230, "verse_number": "१६", "content_sanskrit": "यदुक्तश्च सभामध्ये पुरुषो ह्रस्वदर्शनः ।\nक्रुद्धेन भीमसेनेन भ्राता दुःशासनस्तव\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2149297, "chapter_id": 4230, "verse_number": "१७", "content_sanskrit": "अधर्मज्ञो नित्यवैरी पापबुद्धिर्नृशंसकृत् ।\nस तां प्रतिज्ञामचिराद् द्रक्ष्यसे त्वं सुयोधन\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2149298, "chapter_id": 4230, "verse_number": "१८", "content_sanskrit": "अभिमानस्य दर्पस्य क्रोधपारुष्ययोस्तथा ।\nनैष्ठुर्यस्यावलेपस्य आत्मसम्भावनस्य च\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2149299, "chapter_id": 4230, "verse_number": "१९", "content_sanskrit": "नृशंसतायास्तैक्ष्ण्यस्य धर्मविद्वेषणस्य च ।\nअधर्मस्यापवादस्य वृद्धातिक्रमणस्य च\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2149300, "chapter_id": 4230, "verse_number": "२०", "content_sanskrit": "दर्शनस्य च वक्रस्य कृत्स्नस्यापनयस्य च ।\nद्रक्ष्यसि त्वं फलं तीव्रमचिरेण सुयोधन\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2149301, "chapter_id": 4230, "verse_number": "२१", "content_sanskrit": "वासुदेवद्वितीये हि मयि क्रुद्धे नराधम ।\nआशा ते जीविते मूढ राज्ये वा केन हेतुना\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2149302, "chapter_id": 4230, "verse_number": "२२", "content_sanskrit": "शान्ते भीष्मे तथा द्रोणे सूतपुत्रे च पातिते ।\nनिराशो जीविते राज्ये पुत्रेषु च भविष्यसि\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2149303, "chapter_id": 4230, "verse_number": "२३", "content_sanskrit": "भ्रातॄणां निधनं दृष्ट्वा पुत्राणां च सुयोधन ।\nभीमसेनेन निहतो दुष्कृतानि स्मरिष्यसि\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2149304, "chapter_id": 4230, "verse_number": "२४", "content_sanskrit": "न द्वितीयां प्रतिज्ञां हि प्रतिजानामि कैतव ।\nसत्यं ब्रवीम्यहं ह्येतत् सर्वं सत्यं भविष्यति\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2149305, "chapter_id": 4230, "verse_number": "२५", "content_sanskrit": "युधिष्ठिरोऽपि कैतव्यम् उलूकमिदमब्रवीत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2149306, "chapter_id": 4230, "verse_number": "२६", "content_sanskrit": "उलूक मद्वचो ब्रूहि गत्वा तात सुयोधनम् ।\nस्वेन वृत्तेन मे वृत्तं नाधिगन्तुं त्वमर्हसि\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2149307, "chapter_id": 4230, "verse_number": "२७", "content_sanskrit": "उभयोरन्तरं वेद सूनृतानृतायोरपि ।\nन चाहं कामये पापमपि कीटपिपीलयोः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2149308, "chapter_id": 4230, "verse_number": "२८", "content_sanskrit": "किं पुनर्ज्ञातिषु वधं कामयेयं कथञ्चन\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2149309, "chapter_id": 4230, "verse_number": "२९", "content_sanskrit": "एतदर्थं मया तात पञ्च ग्रामा वृताः पुरा ।\nकथं तव सुदुर्बुद्धे न प्रेक्षे व्यसनं महत्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2149310, "chapter_id": 4230, "verse_number": "३०", "content_sanskrit": "स त्वं कामपरीतात्मा मूढभावाच्च कत्थसे ।\nतथैव वासुदेवस्य न गृह्णाति हितं वचः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2149311, "chapter_id": 4230, "verse_number": "३१", "content_sanskrit": "किमिदानीं बहूक्तेन युध्यस्व सहबान्धवः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2149312, "chapter_id": 4230, "verse_number": "३२", "content_sanskrit": "मम विप्रियकर्तारं कैतव्य ब्रूहि कौरवम् ।\nश्रुतं वाक्यं गृहीतोऽर्थो मतं यत् ते तथाऽस्तु तत्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2149313, "chapter_id": 4230, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2149314, "chapter_id": 4230, "verse_number": "३३", "content_sanskrit": "भीमसेनस्ततो वाक्यं भूय आह नृपात्मजम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2149315, "chapter_id": 4230, "verse_number": "३४", "content_sanskrit": "उलूक मद्वचो ब्रूहि दुर्मतिं पापपूरुषम् ।\nशठं नैकृतिकं पापं दुराचारं सुयोधनम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2149316, "chapter_id": 4230, "verse_number": "३५", "content_sanskrit": "प्रतिज्ञातं मया यच्च सभामध्ये नराधम ।\nकर्ताऽहं तद्वचः सत्यं सत्येनैव शपामि ते\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2149317, "chapter_id": 4230, "verse_number": "३६", "content_sanskrit": "दुःशासनस्य रुधिरं हत्वा पास्याम्यहं मृधे ।\nसक्थिनी तव भङ्क्त्वैव हत्वा हि तव सोदरान्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2149318, "chapter_id": 4230, "verse_number": "३७", "content_sanskrit": "सर्वेषां धार्तराष्ट्राणामहं मृत्युः सुयोधन ।\nसर्वेषां राजपुत्राणामभिमन्युरसंशयम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2149319, "chapter_id": 4230, "verse_number": "३८", "content_sanskrit": "कर्मणा तोषयिष्यामि भूयश्चैव वचः शृणु\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2149320, "chapter_id": 4230, "verse_number": "३९", "content_sanskrit": "हत्वा सुयोधनं त्वां वै सहितं सर्वसोदरैः ।\nआक्रमिष्ये पदा मूर्ध्नि धर्मराजस्य पश्यतः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2149321, "chapter_id": 4230, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2149322, "chapter_id": 4230, "verse_number": "४०", "content_sanskrit": "नकुलस्तु ततो वाक्यमिदमाह महीपते\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2149323, "chapter_id": 4230, "verse_number": "४१", "content_sanskrit": "उलूक ब्रूहि कैतव्य धार्तराष्ट्रं सुयोधनम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2149324, "chapter_id": 4230, "verse_number": "४२", "content_sanskrit": "श्रुतं ते गदतो वाक्यं सर्वमेव यथातथम् ।\nतथा कर्तास्मि कौरव्य यथा त्वमनुशास्सि माम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2149325, "chapter_id": 4230, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2149326, "chapter_id": 4230, "verse_number": "४३", "content_sanskrit": "सहदेवोऽपि नृपते इदमाह वचोऽर्थवत्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2149327, "chapter_id": 4230, "verse_number": "४४", "content_sanskrit": "सुयोधन मतिर्या ते वृथैवैषा भविष्यति ।\nशोचिष्यसे महाराज सपुत्रज्ञातिबान्धवः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2149328, "chapter_id": 4230, "verse_number": "४५", "content_sanskrit": "इमं च क्लेशमस्माकं हृष्टो यत् त्वं विकत्थसे\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2149329, "chapter_id": 4230, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2149330, "chapter_id": 4230, "verse_number": "४६", "content_sanskrit": "विराटद्रुपदौ वृद्धावुलूकमिदमूचतुः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2149331, "chapter_id": 4230, "verse_number": "४७", "content_sanskrit": "दासभावं नियच्छेव साधोरिति मतिः सदा ।\nतौ च दासावदासौ वा पौरुषं यस्य यादृशम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2149332, "chapter_id": 4230, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2149333, "chapter_id": 4230, "verse_number": "४८", "content_sanskrit": "शिखण्डी तु ततो वाक्यमुलूकमिदमब्रवीत्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2149334, "chapter_id": 4230, "verse_number": "४९", "content_sanskrit": "वक्तव्यो भवता राजा पापेष्वभिरतः सदा ।\nपश्य त्वं मां रणे राजन् कुर्वाणं कर्म दारुणम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2149335, "chapter_id": 4230, "verse_number": "५०", "content_sanskrit": "यस्य वीर्यं समासाद्य मन्यसे विजयं युधि ।\nतमहं पातयिष्यामि रथात् तव पितामहम्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2149336, "chapter_id": 4230, "verse_number": "५१", "content_sanskrit": "अहं भीष्मवधे सृष्टो नूनं धात्रा महात्मना ।\nसोऽहं भीष्मं हनिष्यामि मिषतां सर्वधन्विनाम्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2149337, "chapter_id": 4230, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2149338, "chapter_id": 4230, "verse_number": "५२", "content_sanskrit": "धृष्टद्युम्नोऽपि कैतव्यमुलूकमिदमब्रवीत्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2149339, "chapter_id": 4230, "verse_number": "५३", "content_sanskrit": "सुयोधनो मम वचो वक्तव्यो नृपतेः सुतः ।\nअहं द्रोणं हनिष्यामि सगणं सहबान्धवम्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2149340, "chapter_id": 4230, "verse_number": "५४", "content_sanskrit": "कर्ता चाहं तथा कर्म यथा नान्यः करिष्यति\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2149341, "chapter_id": 4230, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2149342, "chapter_id": 4230, "verse_number": "५५", "content_sanskrit": "तमब्रवीद् धर्मराजः कारुण्यार्थं वचो महत्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2149343, "chapter_id": 4230, "verse_number": "५६", "content_sanskrit": "नाहं ज्ञातिवधं राजन् कामयेयं कथञ्चन ।\nतवैव दोषाद् दुर्बुद्धेः सर्वमेतदनावृतम्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2149344, "chapter_id": 4230, "verse_number": "५७", "content_sanskrit": "अवश्यं च मया कार्यं सर्वेषां रक्षणं महत्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2149345, "chapter_id": 4230, "verse_number": "५८", "content_sanskrit": "स गच्छ मा चिरं तात उलूक यदि मन्यसे ।\nइह वा तिष्ठ भद्रं ते वयं हि तव बान्धवाः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2149346, "chapter_id": 4230, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2149347, "chapter_id": 4230, "verse_number": "५९", "content_sanskrit": "इत्युक्तः कैतवो वाक्यं तद्वाक्यमुपधार्य च ।\nअनुज्ञातो निववृते पुनरेव यथागतम्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2149348, "chapter_id": 4230, "verse_number": "६०", "content_sanskrit": "उपावृत्य तु कैतव्यः पाण्डुभ्यो धृतराष्ट्रजम् ।\nगत्वा यथोक्तं तत् सर्वमुवाच कुरुसंसदि\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2149349, "chapter_id": 4230, "verse_number": "६१", "content_sanskrit": "कैतव्यस्य तु तद्वाक्यं निशम्य भरतर्षभः ।\nदुःशासनं च कर्णं च शकुनिं चाभ्यभाषत\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2149350, "chapter_id": 4230, "verse_number": "६२", "content_sanskrit": "आज्ञापयत राज्ञश्च बलं मित्रबलं तथा ।\nयथा प्रागुदयात् सर्वा युक्त तिष्ठत्यनीकिनी\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2149351, "chapter_id": 4230, "verse_number": "६३", "content_sanskrit": "ततः कर्णसमादिष्टा दूताः सन्त्वरिता रथैः ।\nउष्ट्रवामीभिरप्यन्ये सदश्वैश्च महाजवैः\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2149352, "chapter_id": 4230, "verse_number": "६४", "content_sanskrit": "तूर्णं परिययुः सेनां पूर्णां कर्णस्य शासनात् ।\nआज्ञापयन्त राज्ञस्तान् योगः प्रागुदयादिति\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2149353, "chapter_id": 4230, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि एकषष्ट्युत्तरशततमोऽध्यायः ॥१६१॥\nउलूकदूतागमनपर्वणि चतुर्थोऽध्यायः ॥४॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}]