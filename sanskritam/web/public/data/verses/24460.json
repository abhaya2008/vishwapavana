[{"id": 7004460000, "chapter_id": 24460, "verse_number": "५-३-१५४-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nनर्मदादक्षिणे कूले तीर्थं कलकलेश्वरम् ।\nविख्यातं सर्वलोकेषु स्वयं देवेन निर्मितम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004460001, "chapter_id": 24460, "verse_number": "५-३-१५४-२", "content_sanskrit": "अन्धकं समरे हत्वा देवदेवो महेश्वरः ।\nसहितो देवगन्धर्वैः किन्नरैश्च महोरगैः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004460002, "chapter_id": 24460, "verse_number": "५-३-१५४-३", "content_sanskrit": "शङ्खतूर्यनिनादैश्च मृदङ्गपणवादिभिः ।\nवीणावेणुरवैश्चान्यैः स्तुतिभिः पुष्कलादिभिः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004460003, "chapter_id": 24460, "verse_number": "५-३-१५४-४", "content_sanskrit": "गायन्ति सामानि यजूंषि चान्ये छन्दांसि चान्ये ऋचमुद्गिरन्ति ।\nस्तोत्रैरनेकैरपरे गृणन्ति महेश्वरं तत्र महानुभावाः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004460004, "chapter_id": 24460, "verse_number": "५-३-१५४-५", "content_sanskrit": "प्रमथानां निनादेन कल्कलेन च बन्दिनाम् ।\nयस्मात्प्रतिष्ठितं लिङ्गं तस्माज्जातं तदाख्यया॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004460005, "chapter_id": 24460, "verse_number": "५-३-१५४-६", "content_sanskrit": "तत्र तीर्थे तु यः स्नात्वा वीक्षेत्कलकलेश्वरम् ।\nवाजपेयात्परं पुण्यं स लभेन्मानवो भुवि॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004460006, "chapter_id": 24460, "verse_number": "५-३-१५४-७", "content_sanskrit": "तेन पुण्येन पूतात्मा प्राणत्यागाद्दिवं व्रजेत् ।\nआरूढः परमं यानं गीयमानोऽप्सरोगणैः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004460007, "chapter_id": 24460, "verse_number": "५-३-१५४-८", "content_sanskrit": "उपभुज्य महाभोगान्कालेन महता ततः ।\nमर्त्यलोके महात्मासौ जायते विमले कुले॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004460008, "chapter_id": 24460, "verse_number": "५-३-१५४-९", "content_sanskrit": "ब्राह्मणः सुभगो लोके वेदवेदाङ्गपारगः ।\nव्याधिशोकविनिर्मुक्तो जीवेच्च शरदां शतम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]