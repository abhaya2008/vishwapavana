[{"id": 2159819, "chapter_id": 4468, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2159820, "chapter_id": 4468, "verse_number": "१", "content_sanskrit": "एतच्छ्रुत्वा वचस्तस्य केशवस्य महात्मनः ।\nसुभद्रा पुत्रशोकार्ता विललाप सुदुःखिता\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2159821, "chapter_id": 4468, "verse_number": "२", "content_sanskrit": "हा पुत्र मम मन्दायाः कथं संयुगमेयिवान् ।\nनिधनं प्राप्तवांस्तात पितुस्तुल्यपराक्रमः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2159822, "chapter_id": 4468, "verse_number": "३", "content_sanskrit": "कथमिन्दीवरश्यामं सुदंष्ट्रं चारुलोचनम् ।\nमुखं ते दृश्यते वत्स कुण्ठितं रणरेणुना\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2159823, "chapter_id": 4468, "verse_number": "४", "content_sanskrit": "नूनं शूरं निपतितं त्वां पश्यन्त्यनिवर्तिनम् ।\nसुशिरोग्रीवबाह्वंसं व्यूढोरस्कं तनूदरम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2159824, "chapter_id": 4468, "verse_number": "५", "content_sanskrit": "चारूपचितसर्वाङ्गं स्वक्षं शस्त्रक्षताचितम् ।\nभूतानि त्वां निरीक्षन्ते भूमौ चन्द्रमिवोदितम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2159825, "chapter_id": 4468, "verse_number": "६", "content_sanskrit": "शयनीयं पुरा यस्य स्पर्ध्यास्तरणसंवृतम् ।\nभूमावद्य कथं शेषे विप्रविद्धः सुखोचितः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2159826, "chapter_id": 4468, "verse_number": "७", "content_sanskrit": "योऽन्वास्यत् पुरा वीरो वरस्त्रीभिर्महाभुजः ।\nकथमन्वास्यसे सोऽद्य शिवाभिः पतितो मृधे\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2159827, "chapter_id": 4468, "verse_number": "८", "content_sanskrit": "यः स्तूयसे पुरा हृष्टैः सूतमागधवन्दिभिः ।\nसोऽद्य क्रव्याद्गणैर्घोरैर्विनदद्भिरुपास्यसे\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2159828, "chapter_id": 4468, "verse_number": "९", "content_sanskrit": "पाण्डवेषु च नाथेषु वृष्णिवीरेषु चाभिभो ।\nपाञ्चालेषु च वीरेषु हतः केनास्यनाथवत्\nयत्र त्वं केशवे नाथे सत्यनाथो यथा हतः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2159829, "chapter_id": 4468, "verse_number": "१०", "content_sanskrit": "अतृप्तदर्शना पुत्र दर्शनस्य तवानघ ।\nमन्दभाग्या गमिष्यामि व्यक्तमद्य यमक्षयम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2159830, "chapter_id": 4468, "verse_number": "११", "content_sanskrit": "विशालाक्षं सुकेशान्तं चारुहासं सुगन्धि च ।\nतव पुत्र कदा वक्त्रं भूयो द्रक्ष्यामि निर्व्रणम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2159831, "chapter_id": 4468, "verse_number": "", "content_sanskrit": "धिग् बलं भीमसेनस्य धिक् पार्थस्य धनुष्मतः ।\nधिग् बलं वृष्णिवीराणां पाञ्चालानां च धिग् बलम् ।१२।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2159832, "chapter_id": 4468, "verse_number": "१३", "content_sanskrit": "धिक् केकयांस्तथा मत्स्यान् चेदिपाण्डवसृञ्जयान् ।\nये त्वां रणगतं वीरं नारक्षन् विनिपातितम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2159833, "chapter_id": 4468, "verse_number": "१४", "content_sanskrit": "स्वस्रीयं वासुदेवस्य गृध्रास्तं पर्युपासते ।\nकथं त्वाऽतिरथं वीरं पश्याम्यद्य निपातितम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2159834, "chapter_id": 4468, "verse_number": "१५", "content_sanskrit": "अद्य पश्यामि पृथिवीं शून्यामिव गतत्विषम् ।\nअभिमन्युमपश्यन्ती शोकव्याकुललोचना\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2159835, "chapter_id": 4468, "verse_number": "१६", "content_sanskrit": "साक्षान्मघवतः पौत्रं पुत्रं गाण्डीवधन्वनः ।\nस्वस्रीयं वासुदेवस्य तं गृध्राः पर्युपासते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2159836, "chapter_id": 4468, "verse_number": "१७", "content_sanskrit": "हा दृष्टो वीर नष्टश्च रम्यस्वप्न इवासि मे ।\nअहो ह्यनित्यं मानुष्यं जलबुद्बुदवच्चलम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2159837, "chapter_id": 4468, "verse_number": "१८", "content_sanskrit": "इमां ते तरुणीं भार्यां पुत्राधिभिरभिप्लुताम् ।\nउत्तरामुत्तमां जात्या सुशीलां प्रियभाषिणीम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2159838, "chapter_id": 4468, "verse_number": "१९", "content_sanskrit": "शनकैः परिरभ्यैनां स्नुषां मम यशस्विनीम् ।\nसुकुमारीं विशालाक्षीं पूर्णचन्द्रनिभाननाम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2159839, "chapter_id": 4468, "verse_number": "२०", "content_sanskrit": "बालपल्लवतन्वङ्गीं मत्तमातङ्गगामिनीम् ।\nबिम्बाधरोष्ठीमबलामभिमन्यो प्रहर्षय\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2159840, "chapter_id": 4468, "verse_number": "२१", "content_sanskrit": "त्वया विना कथं पुत्र जीर्णां पतितमानसाम् ।\nइमां सन्धारयिष्यामि विवत्सामिव धेनुकाम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2159841, "chapter_id": 4468, "verse_number": "२२", "content_sanskrit": "अहो ह्यकाले प्रस्थानं कृतवानसि पुत्रक ।\nविहाय फलकाले मां सुगृद्धां तव दर्शने\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2159842, "chapter_id": 4468, "verse_number": "२३", "content_sanskrit": "नूनं गतिः कृतान्तस्य प्राज्ञैरपि सुदुस्तरा ।\nयत्र त्वं केशवे नाथे सत्यनाथो यथा हतः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2159843, "chapter_id": 4468, "verse_number": "२४", "content_sanskrit": "यज्वनां दानशीलानां ब्राह्मणानां कृतात्मनाम् ।\nचरितब्रह्मचर्याणां पुण्यतीर्थावगाहिनाम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2159844, "chapter_id": 4468, "verse_number": "२५", "content_sanskrit": "कृतज्ञानां वदान्यानां गुरुशुश्रूषिणामपि ।\nसहस्रदक्षिणानां च या गतिस्तामवाप्नुहि\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2159845, "chapter_id": 4468, "verse_number": "२६", "content_sanskrit": "या गतिर्युद्ध्यमानानां शूराणामनिवर्तिनाम् ।\nअपराङ्मुखानां समरे तां गतिं व्रज पुत्रक\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2159846, "chapter_id": 4468, "verse_number": "२७", "content_sanskrit": "गोसहस्रप्रदातॄणां क्रतुदानां च या गतिः ।\nवैदेशिकानां चाभिमतं ददतां या गतिर्भवेत्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2159847, "chapter_id": 4468, "verse_number": "२८", "content_sanskrit": "ब्रह्मचर्येण यां यान्ति मुनयः संशितव्रताः ।\nएकपत्न्यश्च यां यान्ति तां गतिं व्रज पुत्रक\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2159848, "chapter_id": 4468, "verse_number": "२९", "content_sanskrit": "राज्ञां सुचरितैर्या च गतिर्भवति शाश्वती ।\nया गतिर्न्यस्तदण्डानां तां गतिं व्रज पुत्रक ।\nचतुराश्रमिणां पुण्यैः पावितानां सुरक्षितैः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2159849, "chapter_id": 4468, "verse_number": "३०", "content_sanskrit": "दीनानुकम्पिनां या च सततं संविभागिनाम् ।\nपैशुन्याच्च निवृत्तानां तां गतिं व्रज पुत्रक\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2159850, "chapter_id": 4468, "verse_number": "३१", "content_sanskrit": "व्रतिनां धर्मशीलानां गुरुशुश्रूषिणामपि ।\nअमोघातिथिनां या च तां गतिं व्रज पुत्रक\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2159851, "chapter_id": 4468, "verse_number": "३२", "content_sanskrit": "कृच्छेषु या धारयतामात्मानं व्यसनेषु च ।\nगतिः शोकाग्निदग्धानां तां गतिं व्रज पुत्रक \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2159852, "chapter_id": 4468, "verse_number": "३३", "content_sanskrit": "मातापित्रोश्च शुश्रूषां कल्पयन्तीह ये सदा ।\nस्वदारनिरतानां च या गतिस्तामवाप्नुहि\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2159853, "chapter_id": 4468, "verse_number": "३४", "content_sanskrit": "ऋतुकाले स्वकां पत्नीं गच्छतां या मनीषिणाम् ।\nअनन्यदारसेवीनां तां गतिं व्रज पुत्रक\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2159854, "chapter_id": 4468, "verse_number": "३५", "content_sanskrit": "साम्ना ये सर्वभूतानि गच्छन्ति गतमत्सराः ।\nनारुन्तुदानां क्षमिणां या गतिस्तामवाप्नुहि\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2159855, "chapter_id": 4468, "verse_number": "३६", "content_sanskrit": "मधुमांसनिवृत्तानां मदाद् डम्भात् तथाऽनृतात् ।\nपरोपतापादन्यायात् तां गतिं व्रज पुत्रक\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2159856, "chapter_id": 4468, "verse_number": "३७", "content_sanskrit": "यज्वानः सर्वधर्मज्ञा ज्ञानतृप्ता जितेन्द्रियाः ।\nयां गतिं साधवो यान्ति तां गतिं व्रज पुत्रक\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2159857, "chapter_id": 4468, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2159858, "chapter_id": 4468, "verse_number": "३८", "content_sanskrit": "एवं विलपतीं दीनां सुभद्रां शोककर्शिताम्\nउपागच्छत पाञ्चाली उत्तरासहिता तदा\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2159859, "chapter_id": 4468, "verse_number": "३९", "content_sanskrit": "सा प्रकामं रुदित्वा च विलप्य च सुदुःखिता ।\nउन्मत्तवत् तदा राजन् विसंज्ञा पतिता क्षितौ\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2159860, "chapter_id": 4468, "verse_number": "४०", "content_sanskrit": "सोपचारस्तु कृष्णस्तां दुःखितां भृशदुःखितः ।\nसिक्त्वाऽम्भसा समाश्वास्य तत्तदुक्त्वा हितं वचः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2159861, "chapter_id": 4468, "verse_number": "४१", "content_sanskrit": "विसञ्ज्ञकल्पां रुदतीमपविद्धां प्रवेपतीम् ।\nभगिनीं पुण्डरीकाक्ष इदं वचनमब्रवीत्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2159862, "chapter_id": 4468, "verse_number": "४२", "content_sanskrit": "मानुशोचीः सुभद्रे त्वं स्नुषां चाश्वासयोत्तराम् ।\nगतोऽभिमन्युः प्रथितां गतिं क्षत्रियपुङ्गवः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2159863, "chapter_id": 4468, "verse_number": "४३", "content_sanskrit": "ये चान्ये च कुले सन्तः पुरुषाणां वरानने ।\nसर्वे ते तां गतिं यान्ति याऽभिमन्योर्यशस्विनः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2159864, "chapter_id": 4468, "verse_number": "४४", "content_sanskrit": "कुर्याम तद् वयं कर्म क्रियासुः सुहृदश्च नः ।\nकृतवान् यादृगद्यैकः तव पुत्रो महारथः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2159865, "chapter_id": 4468, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2159866, "chapter_id": 4468, "verse_number": "४५", "content_sanskrit": "एवमाश्वास्य भगिनीं द्रौपदीमपि चोत्तराम् ।\nपार्थस्यैव महाबाहुः पार्श्वमायादरिन्दमः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2159867, "chapter_id": 4468, "verse_number": "४६", "content_sanskrit": "ततोऽभ्यनुज्ञाय गृहं कृष्णं चान्यांश्च पार्थिवान् ।\nविवेशान्तःपुरं राजा तेऽपि जग्मुः स्वमालयम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2159868, "chapter_id": 4468, "verse_number": "४७", "content_sanskrit": "ततोऽर्जुनस्य शिबिरं प्रविश्याप्रतिमं भुवि ।\nस्पृष्ट्वाऽम्भः पुण्डरीकाक्षः स्थण्डिले शुभलक्षणे\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2159869, "chapter_id": 4468, "verse_number": "४८", "content_sanskrit": "सन्तस्तार शुभां शय्यां दर्भैर्वैदूर्यसन्निभैः \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2159870, "chapter_id": 4468, "verse_number": "४९", "content_sanskrit": "ततो माल्येन विधिवल्लाजैर्गन्धैः सुमङ्गलैः ।\nअलञ्चकार तां शय्यां परिवार्यायुधोत्तमैः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2159871, "chapter_id": 4468, "verse_number": "५०", "content_sanskrit": "ततः स्पृष्टोदकं पार्थं विनीतपरिचारकम् ।\nनैत्यकं दर्शयाञ्चक्रे नैशं त्रैयम्बकं बलिम्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2159872, "chapter_id": 4468, "verse_number": "५१", "content_sanskrit": "ततः प्रीतमनाः पार्थो गन्धैर्माल्यैश्च माधवम् ।\nअलङ्कृत्योपहारं च शय्यामस्मै न्यवेदयत्\nसाधु साध्विति गोविन्दः फल्गुनं वाक्यमब्रवीत्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2159873, "chapter_id": 4468, "verse_number": "५२", "content_sanskrit": "सुप्यतां पार्थ भद्रं ते कल्याणाय व्रजाम्यहम् \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2159874, "chapter_id": 4468, "verse_number": "५३", "content_sanskrit": "स्थापयित्वा ततो द्वाःस्थानाप्तान् नानायुधान् नरान् ।\nदारुकानुगतः श्रीमान् विवेश शिबिरं स्वकम्\nशिश्ये च शयने शुभ्रे बहुकार्यं विचिन्तयन्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2159875, "chapter_id": 4468, "verse_number": "५४", "content_sanskrit": "न पाण्डवानां शिबिरे कश्चित् सुष्वाप तां निशाम् ।\nप्रजागरः सर्वजनं ह्याविवेश विशांपते\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2159876, "chapter_id": 4468, "verse_number": "५५", "content_sanskrit": "पुत्रशोकाभिभूतेन प्रतिज्ञातं महात्मना ।\nश्वः सिन्धुराजस्य वधः कार्यो गाण्डीवधन्वना\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2159877, "chapter_id": 4468, "verse_number": "५६", "content_sanskrit": "तत् कथं नु महाबाहुर्वासविः परवीरहा ।\nप्रतिज्ञां सफलां कुर्यादिति ते समचिन्तयन्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2159878, "chapter_id": 4468, "verse_number": "", "content_sanskrit": "जनाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2159879, "chapter_id": 4468, "verse_number": "५७", "content_sanskrit": "कष्टं हीदं व्यवसितं पाण्डवेनामितौजसा ।\nपुत्रशोकाभिभूतेन प्रतिज्ञा महती कृता\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2159880, "chapter_id": 4468, "verse_number": "५८", "content_sanskrit": "भ्रातरश्चापि भूयिष्ठा बलानि विपुलानि च ।\nधृतराष्ट्रस्य पुत्रेण सर्वतः सन्निवेशिताः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2159881, "chapter_id": 4468, "verse_number": "५९", "content_sanskrit": "स हत्वा सैन्धवं सङ्खे पुनरेतु जयी सुखी ।\nस हत्वाऽरिगणं सङ्खे पारयित्वा महाव्रतम्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2159882, "chapter_id": 4468, "verse_number": "", "content_sanskrit": "यद्यस्ति सुकृतं किञ्चिदस्माकं हन्तु सैन्धवम् ।\nजित्वा सर्वान् रिपून् पार्थः त्रातुं नोऽस्मान् महाभयात् ६०", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2159883, "chapter_id": 4468, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2159884, "chapter_id": 4468, "verse_number": "६१", "content_sanskrit": "एवमाशंसमानास्ते केचित् तस्थुरुपश्रुतिम् ।\nश्रुत्वा चेष्टं सुमनसो व्यक्तमाशंसिरे जयम्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2159885, "chapter_id": 4468, "verse_number": "६२", "content_sanskrit": "भविता नः कथं कृत्यमिदमित्यब्रुवञ्जनाः \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2159886, "chapter_id": 4468, "verse_number": "६३", "content_sanskrit": "अहत्वा सिन्धुराजं हि धूमकेतुं प्रवेक्ष्यति ।\nन शक्यमनृतां कर्तुं प्रतिज्ञां विजयेन हि\nमहद्धि साहसं पार्थः कृतवान् शोकमोहितः\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2159887, "chapter_id": 4468, "verse_number": "६४", "content_sanskrit": "धर्मपुत्रः कथं राजा करिष्यति सहानुगः ।\nअर्जुने हि जयस्तेषामायत्तो जीवितानि च\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2159888, "chapter_id": 4468, "verse_number": "६५", "content_sanskrit": "यदि नः सुकृतं किञ्चिद् यदि दत्तमथो हुतम् ।\nफलेन तस्य सर्वस्य सव्यसाची जयत्वरीन्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2159889, "chapter_id": 4468, "verse_number": "६६", "content_sanskrit": "एवं कथयतां तेषां जयमाशंसतामपि ।\nकृच्छ्रेण सा महाराज रजनी ह्यत्यवर्तत\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2159890, "chapter_id": 4468, "verse_number": "६७", "content_sanskrit": "रजन्यामर्धयामायां प्रतिबुद्धो जनार्दनः ।\nस्मृत्वा प्रतिज्ञां पार्थस्य दारुकं प्रत्यभाषत\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2159891, "chapter_id": 4468, "verse_number": "६८", "content_sanskrit": "अर्जुनेन प्रतिज्ञातं पार्थेन हतबन्धुना ।\nजयद्रथमहं हन्ता श्वोभूत इति दारुक\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2159892, "chapter_id": 4468, "verse_number": "६९", "content_sanskrit": "ततो दुर्योधनः श्रुत्वा मन्त्रयिष्यति मन्त्रिभिः ।\nयथा जयद्रथं पार्थो न हन्यादित्यसंशयम्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2159893, "chapter_id": 4468, "verse_number": "७०", "content_sanskrit": "अक्षोहिण्यश्च ताः सर्वा रक्षिष्यन्ति न संशयः ।\nद्रोणश्च सहपुत्रेण ये चान्ये प्रवरा रथाः\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2159894, "chapter_id": 4468, "verse_number": "७१", "content_sanskrit": "महावीर्यः सहस्राक्षो दैत्यदानवसङ्घजित् ।\nसोऽप्येनं नोत्सहेद् हन्तुं सङ्खे द्रोणेन रक्षितम्\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2159895, "chapter_id": 4468, "verse_number": "७२", "content_sanskrit": "अहं तु श्वस्तथा कर्ता यथा कुन्तीसुतोऽर्जुनः ।\nअप्राप्तेऽस्तं यथाऽऽदित्ये हन्ता पापं जयद्रथम्\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2159896, "chapter_id": 4468, "verse_number": "७३", "content_sanskrit": "न हि दारा न मित्राणि न पुत्रज्ञातयोऽपि वा ।\nनान्यः कश्चित् प्रियतरो मर्त्यः पार्थाद्धनञ्जयात्\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2159897, "chapter_id": 4468, "verse_number": "७४", "content_sanskrit": "विनाऽर्जुनमिमं लोकं मुहूर्तमपि दारुक ।\nनोत्सहे वीक्षितुं सूत सत्यमेव ब्रवीमि ते\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2159898, "chapter_id": 4468, "verse_number": "७५", "content_sanskrit": "अहं तु ध्वजिनीः सर्वाः सहयाः सरथद्विपाः ।\nअर्जुनार्थं हनिष्यामि सकर्णाः ससुयोधनाः\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2159899, "chapter_id": 4468, "verse_number": "७६", "content_sanskrit": "श्वो निरीक्षन्तु मे वीर्यं त्रयो लोका महाहवे ।\nधनञ्जयार्थं समरे पराक्रान्तस्य दारुक\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2159900, "chapter_id": 4468, "verse_number": "७७", "content_sanskrit": "श्वो नरेन्द्रसहस्राणि राजपुत्रशतानि च ।\nसाश्वद्विपरथान्याजौ विद्रविष्यन्ति दारुक\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2159901, "chapter_id": 4468, "verse_number": "७८", "content_sanskrit": "श्वस्तां चक्रप्रमथितां द्रक्ष्यसि नृपवाहिनीम् ।\nमया क्रुद्धेन समरे पाण्डवार्थे निपातिताम्\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2159902, "chapter_id": 4468, "verse_number": "७९", "content_sanskrit": "अद्य ज्ञास्यन्ति त्रिदशाः सासुराः सचराचराः ।\nवासुदेवस्य तां प्रीतिं पाण्डवेष्वनपायिनीम्\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2159903, "chapter_id": 4468, "verse_number": "८०", "content_sanskrit": "यस्तान् द्वेष्टि स मां द्वेष्टि यस्ताननु स मामनु ।\nइति सङ्कल्प्यतां बुद्ध्या शरीरार्धं ममार्जुनः\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2159904, "chapter_id": 4468, "verse_number": "८१", "content_sanskrit": "यथा तु त्वं प्रभातायामस्यां निशि रथोत्तमम् ।\nकल्पयित्वा समीपं मे आगच्छसि तथा कुरु\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2159905, "chapter_id": 4468, "verse_number": "८२", "content_sanskrit": "गदां कौमोदकीं दिव्यां शक्तिं चक्रं धनुःशरान् ।\nआरोपय रथे सूत सर्वोपकरणानि च\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2159906, "chapter_id": 4468, "verse_number": "८३", "content_sanskrit": "स्थानं च कल्प्यतां तत्र रथोपस्थे ध्वजस्य मे ।\nवैनतेयस्य वीरस्य समरेष्वभिशोभिनः\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2159907, "chapter_id": 4468, "verse_number": "८४", "content_sanskrit": "छन्नान् जाम्बूनदैर्माल्यैरर्कज्वलनसन्निभैः ।\nविश्वकर्मकृतैर्दिव्यैरश्वानपि च भूषय\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2159908, "chapter_id": 4468, "verse_number": "८५", "content_sanskrit": "बलाहकं मेघपुष्पं सैन्यं सुग्रीवमेव च ।\nयुक्त्वा वाजिवरांस्तत्र कवची तिष्ठ दारुक\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2159909, "chapter_id": 4468, "verse_number": "८६", "content_sanskrit": "पाञ्चजन्यस्य निर्घोषं पर्जन्यनिनदोपमम् ।\nश्रुत्वा भैरवमत्यर्थं जवेनैवोपयाहि माम्\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2159910, "chapter_id": 4468, "verse_number": "८७", "content_sanskrit": "श्वः सदेवाः सगन्धर्वाः सत्र्यक्षाप्सरसोऽसुराः ।\nज्ञास्यन्ति लोकाः सर्वे मां सुहृदं सव्यसाचिनः\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2159911, "chapter_id": 4468, "verse_number": "८८", "content_sanskrit": "एकाह्नाऽहममर्षाच्च सर्वदुःखानि चाभिभो ।\nभ्रातुः पैतृष्वसेयस्य व्यपनेष्यामि दारुक\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2159912, "chapter_id": 4468, "verse_number": "८९", "content_sanskrit": "सर्वोपायैर्यतिष्यामि यथा बीभत्सुराहवे ।\nपश्यतां धार्तराष्ट्राणां हनिष्यति जयद्रथम्\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2159913, "chapter_id": 4468, "verse_number": "९०", "content_sanskrit": "यस्य यस्य च बीभत्सुर्वधे यत्नं करिष्यति ।\nआशंसे स रणे तं तं तत्र तत्र हनिष्यति\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2159914, "chapter_id": 4468, "verse_number": "", "content_sanskrit": "दारुकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2159915, "chapter_id": 4468, "verse_number": "९१", "content_sanskrit": "ध्रुव एव जयस्तस्य न तस्यास्ति पराजयः ।\nयस्य त्वं पुरुषव्याघ्र सारथ्यमुपजग्मिवान्\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2159916, "chapter_id": 4468, "verse_number": "", "content_sanskrit": "कृष्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2159917, "chapter_id": 4468, "verse_number": "९२", "content_sanskrit": "एवं चैतत् करिष्यामि यथा मामनुभाषसे ।\nसुप्रभातमिमां रात्रिं जयार्थं विजयस्य च\t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2159918, "chapter_id": 4468, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि त्रिसप्ततितमोऽध्यायः ॥ ७३ ॥\nप्रतिज्ञापर्वणि पञ्चमोऽध्यायः ॥ ५ ॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}]