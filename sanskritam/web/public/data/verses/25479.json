[{"id": 7005479000, "chapter_id": 25479, "verse_number": "१-४९-१", "content_sanskrit": "सूत उवाच ।\nजम्बूद्वीपस्य विस्ताराद् द्विगुणेन समन्ततः ।\nसंवेष्टयित्वा क्षीरोदं प्लक्षद्वीपो व्यवस्थितः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005479001, "chapter_id": 25479, "verse_number": "१-४९-२", "content_sanskrit": "प्लक्षद्वीपे च विप्रेन्द्राः सप्तासन् कुलपर्वताः ।\nसिद्धायुताः सुपर्वाणः सिद्धसङ्घनिषेविताः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005479002, "chapter_id": 25479, "verse_number": "१-४९-३", "content_sanskrit": "गोमेदः प्रथमस्तेषां द्वितीयश्चन्द्र उच्यते ।\nनारादो दुन्दुभिश्चैव सोमस्य ऋषभस्तथा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005479003, "chapter_id": 25479, "verse_number": "१-४९-४", "content_sanskrit": "वैभ्राजः सप्तमः प्रोक्तो ब्रह्मणोऽत्यन्तवल्लभः ।\nतत्र देवर्षिगन्धर्वैः सिद्धैश्च भगवानजः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005479004, "chapter_id": 25479, "verse_number": "१-४९-५", "content_sanskrit": "उपास्यते स विश्वात्मा साक्षी सर्वस्य विश्वसृक् ।\nतेषु पुण्या जनपदा आधयो व्याधयो न च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005479005, "chapter_id": 25479, "verse_number": "१-४९-६", "content_sanskrit": "न तत्र पापकर्त्तारः पुरुषा वा कथञ्चन ।\nतेषां नद्यश्च सप्तैव वर्षाणां तु समुद्रगाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005479006, "chapter_id": 25479, "verse_number": "१-४९-७", "content_sanskrit": "तासु ब्रह्मर्षयो नित्यं पितामहपुपासते ।\nअनुतप्ता शिखे चैव विपापा त्रिदिवा कृता ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005479007, "chapter_id": 25479, "verse_number": "१-४९-८", "content_sanskrit": "अमृता सुकृता चैव नामतः परिकीर्त्तिताः ।\nक्षुद्रनद्यस्त्वसंख्याताः सरांसि सुबहून्यपि ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005479008, "chapter_id": 25479, "verse_number": "१-४९-९", "content_sanskrit": "न चैतेषु युगावस्था पुरुषा वै चिरायुषः ।\nआर्यकाः कुरराश्चैव विदशा भाविनस्तथा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005479009, "chapter_id": 25479, "verse_number": "१-४९-१०", "content_sanskrit": "ब्रह्मक्षत्रियविट्‌शूद्रास्तस्मिन् द्वीपे प्रकीर्त्तिताः ।\nइज्यते भगवान् सोमो वर्णैस्तत्र निवासिभिः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005479010, "chapter_id": 25479, "verse_number": "१-४९-११", "content_sanskrit": "तेषां च सोमसायुज्यं सारूप्यं मुनिपुंगवाः ।\nसर्वे धर्मपरा नित्यं नित्यं मुदितमानसाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005479011, "chapter_id": 25479, "verse_number": "१-४९-१२", "content_sanskrit": "पञ्चवर्षसहस्राणि जीवन्ति च निरामयाः ।\nप्लक्षद्वीपप्रमाणं तु द्विगुणेन समन्ततः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005479012, "chapter_id": 25479, "verse_number": "१-४९-१३", "content_sanskrit": "संवेष्ट्येक्षुरसाम्भोधिं शाल्मलिः संव्यवस्थितः ।\nसप्त वर्षाणि तत्रापि सप्तैव कुलपर्वताः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005479013, "chapter_id": 25479, "verse_number": "१-४९-१४", "content_sanskrit": "ऋज्वायताः सुपर्वाणः सप्त नद्यश्च सुव्रताः ।\nकुमुदश्चोन्नदश्चैव तृतीयश्च बलाहकः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005479014, "chapter_id": 25479, "verse_number": "१-४९-१५", "content_sanskrit": "द्रोणः कंसस्तु महिषः ककुद्वान् सप्त पर्वताः ।\nयोनी तोया वितृष्णा च चन्द्रा शुक्ला विमोचनी ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005479015, "chapter_id": 25479, "verse_number": "१-४९-१६", "content_sanskrit": "निवृत्तिश्चैति ता नद्यः स्मृता पापहरा नृणाम् ।\nन तेषु विद्यते लोभः क्रोधो वा द्विजसत्तमाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005479016, "chapter_id": 25479, "verse_number": "१-४९-१७", "content_sanskrit": "न चैवास्ति युगावस्था जना जीवन्त्यनामयाः ।\nयजन्ति सततं तत्र वर्णा वायुं सनातनम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005479017, "chapter_id": 25479, "verse_number": "१-४९-१८", "content_sanskrit": "तेषां तस्याथ सायुज्यं सारूप्यं च सलोकता ।\nकपिला ब्राह्मणाः प्रोक्ता राजानश्चारुणास्तथा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005479018, "chapter_id": 25479, "verse_number": "१-४९-१९", "content_sanskrit": "पीता वैश्याः स्मृताः कृष्णा द्वीपेऽस्मिन् वृषला द्विजाः ।\nशाल्मलस्य तु विस्ताराद् द्विगुणेन समन्ततः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005479019, "chapter_id": 25479, "verse_number": "१-४९-२०", "content_sanskrit": "संवेष्ट्य तु सुरोदाब्धिं कुशद्वीपो व्यवस्थितः ।\nविद्रुमश्चैव हेमश्च द्युतिमान् पुष्पवांस्तथा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005479020, "chapter_id": 25479, "verse_number": "१-४९-२१", "content_sanskrit": "कुशेशयो हरिश्चाथ मन्दरः सप्त पर्वताः ।\nधुतपापा शिवा चैव पवित्रा संमिता तथा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005479021, "chapter_id": 25479, "verse_number": "१-४९-२२", "content_sanskrit": "विद्युदन्ता मही चेति नद्यस्तत्र जलावहाः ।\nअन्याश्च शतशोविप्रा नद्यो मणिजलाः शुभाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005479022, "chapter_id": 25479, "verse_number": "१-४९-२३", "content_sanskrit": "तासु ब्रह्माणमीशानं देवाद्याः पर्युपासते ।\nब्राह्मणा द्रविणो विप्राः क्षत्रियाः शुष्मिणस्तथा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005479023, "chapter_id": 25479, "verse_number": "१-४९-२४", "content_sanskrit": "वैश्याः स्नेहास्तु मन्देहाः शूद्रास्तत्र प्रकीर्त्तिताः ।\nसर्वे विज्ञानसंपन्ना मैत्रादिगुणसंयुताः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005479024, "chapter_id": 25479, "verse_number": "१-४९-२५", "content_sanskrit": "यथोक्तकारिणः सर्वे सर्वे भूतहिते रताः ।\nयजन्ति विविधैर्यज्ञैर्ब्रह्माणं परमेष्ठिनम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005479025, "chapter_id": 25479, "verse_number": "१-४९-२६", "content_sanskrit": "तेषां च ब्रह्मसायुज्यं सारूप्यं च सलोकता ।\nकुशद्वीपस्य विस्ताराद् द्विगुणेन समन्ततः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005479026, "chapter_id": 25479, "verse_number": "१-४९-२७", "content_sanskrit": "क्रौञ्चद्वीपस्ततो विप्रा वेष्टयित्वा घृतोदधिम् ।\nक्रौञ्चो वामनकश्चैव तृतीयश्चाधिकारिकः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005479027, "chapter_id": 25479, "verse_number": "१-४९-२८", "content_sanskrit": "देवाब्दश्च विवेदश्च पुण्डरीकस्तथैव च ।\nनाम्ना च सप्तमः प्रोक्तः पर्वतो दुन्दुभिस्वनः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005479028, "chapter_id": 25479, "verse_number": "१-४९-२९", "content_sanskrit": "गौरी कुमुद्विती चैव संध्या रात्रिर्मनोजवा ।\nकोभिश्च पुण्डरीकाच नद्यः प्राधान्यतः स्मृताः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005479029, "chapter_id": 25479, "verse_number": "१-४९-३०", "content_sanskrit": "पुष्कराः पुष्कला धन्यास्तिष्या वर्णा क्रमेण वै ।\nब्राह्मणाः क्षत्रिया वैश्याः शूद्राश्चैव द्विजोत्तमाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005479030, "chapter_id": 25479, "verse_number": "१-४९-३१", "content_sanskrit": "अर्चयन्ति महादेवं यज्ञदानसमाधिभिः ।\nव्रतोपवासैर्विविधैर्होमैः स्वाध्यायतर्पणैः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005479031, "chapter_id": 25479, "verse_number": "१-४९-३२", "content_sanskrit": "तेषां वै रुद्रसायुज्यं सारूप्यं चातिदुर्लभम् ।\nसलोकता च सामीप्यं जायते तत्प्रसादतः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005479032, "chapter_id": 25479, "verse_number": "१-४९-३३", "content_sanskrit": "क्रौञ्चद्वीपस्य विस्ताराद् द्विगुणेन समन्ततः ।\nशाकद्वीपः स्थितो विप्रा आवेष्ट्य दधिसागरम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005479033, "chapter_id": 25479, "verse_number": "१-४९-३४", "content_sanskrit": "उदयो रैवतश्चैव श्यामाकोऽस्तगिरिस्तथा ।\nआम्बिकेयस्तथा रम्यः केशरी चेति पर्वताः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005479034, "chapter_id": 25479, "verse_number": "१-४९-३५", "content_sanskrit": "सुकुमारी कुमारी च नलिनी रेणुका तथा ।\nइक्षुका धेनुका चैव गभस्तिश्चेति निम्नगाः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005479035, "chapter_id": 25479, "verse_number": "१-४९-३६", "content_sanskrit": "आसां पिबन्तः सलिलं जीवन्ते तत्र मानवाः ।\nअनामयाश्चाशोकाश्च रागद्वेषविवर्जिताः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005479036, "chapter_id": 25479, "verse_number": "१-४९-३७", "content_sanskrit": "मृगाश्च मगधाश्चैव मानवा मन्दगास्तथा ।\nब्राह्मणाः क्षत्रिया वैश्याः शूद्राश्चात्र क्रमेण तु ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005479037, "chapter_id": 25479, "verse_number": "१-४९-३८", "content_sanskrit": "यजन्ति सततं देवं सर्वलोकैकसाक्षिणम् ।\nव्रतोपवासैर्विविधैर्देवदेवं दिवाकरम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005479038, "chapter_id": 25479, "verse_number": "१-४९-३९", "content_sanskrit": "तेषां सूर्येण सायुज्यं सामीप्यं च सरूपता ।\nसलोकता च विप्रेन्द्रा जायते तत्प्रसादतः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005479039, "chapter_id": 25479, "verse_number": "१-४९-४०", "content_sanskrit": "शाकद्वीपं समावृत्य क्षीरोदः सागरः स्थितः ।\nश्वेतद्वीपश्च तन्मध्ये नारायणपरायणाः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005479040, "chapter_id": 25479, "verse_number": "१-४९-४१", "content_sanskrit": "तत्र पुण्या जनपदा नानाश्चर्यसमन्विताः ।\nश्वेतास्तत्र नरा नित्यं जायन्ते विष्णुतत्पराः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005479041, "chapter_id": 25479, "verse_number": "१-४९-४२", "content_sanskrit": "नाधयो व्याधयस्तत्र जरामृत्युभयं न च ।\nक्रोधलोभविनिर्मुक्ता मायामात्सर्यवर्जिताः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005479042, "chapter_id": 25479, "verse_number": "१-४९-४३", "content_sanskrit": "नित्यपुष्टा निरातङ्का नित्यानन्दाश्च भोगिनः ।\nनारायणपराः सर्वे नारायणपरायणाः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005479043, "chapter_id": 25479, "verse_number": "१-४९-४४", "content_sanskrit": "केचिद् ध्यानपरा नित्यं योगिनः संयतेन्द्रियाः ।\nकेचिज्जपन्ति तप्यन्ति केचिद् विज्ञानिनोऽपरे ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005479044, "chapter_id": 25479, "verse_number": "१-४९-४५", "content_sanskrit": "अन्ये निर्बीजयोगेन ब्रह्मभावेन भाविताः ।\nध्यायन्ति तत् परं ब्रह्म वासुदेवं परं पदम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005479045, "chapter_id": 25479, "verse_number": "१-४९-४६", "content_sanskrit": "एकान्तिनो निरालम्बा महाभागवताः परे ।\nपश्यन्ति परमं ब्रह्म विष्णवाख्यं तमसः परं ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005479046, "chapter_id": 25479, "verse_number": "१-४९-४७", "content_sanskrit": "सर्वे चतुर्भुजाकाराः शङ्खचक्रगदाधराः ।\nसुपीतवाससः सर्वे श्रीवत्साङ्कितवक्षसः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005479047, "chapter_id": 25479, "verse_number": "१-४९-४८", "content_sanskrit": "अन्ये महेश्वरपरास्त्रिपुण्ड्राङ्कितमस्तकाः ।\nसुयोगोद्‌भूतिकरणा महागरुडवाहनाः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005479048, "chapter_id": 25479, "verse_number": "१-४९-४९", "content_sanskrit": "सर्वशक्तिसमायुक्ता नित्यानन्दाश्च निर्मलाः ।\nवसन्ति तत्र पुरुषा विष्णोरन्तरचारिणः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005479049, "chapter_id": 25479, "verse_number": "१-४९-५०", "content_sanskrit": "तत्र नारायणस्यान्यद् दुर्गमं दुरतिक्रमम् ।\nनारायणं नाम पुरं व्यासाद्यैरुपशोभितम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005479050, "chapter_id": 25479, "verse_number": "१-४९-५१", "content_sanskrit": "हेमप्राकारसंसुक्तं स्फाटिकैर्मण्डपैर्युतम् ।\nप्रभासहस्रकलिलं दुराधर्षं सुशोभनम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7005479051, "chapter_id": 25479, "verse_number": "१-४९-५२", "content_sanskrit": "हर्म्यप्राकारसंयुक्तमट्टालकसमाकुलम् ।\nहेमगोपुरसाहस्त्रैर्नानारत्नोपशोभितैः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7005479052, "chapter_id": 25479, "verse_number": "१-४९-५३", "content_sanskrit": "शुभ्रास्तरणसंयुक्तै विचित्रैः समलंकृतम् ।\nनन्दनैर्विविधाकारैः स्रवन्तीभीश्च शोभितम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7005479053, "chapter_id": 25479, "verse_number": "१-४९-५४", "content_sanskrit": "सरोभिः सर्वतो युक्तं वीणावेणुनिनादितम् ।\nपताकाभिर्विचित्राभिरनेकाभिश्च शोभितम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7005479054, "chapter_id": 25479, "verse_number": "१-४९-५५", "content_sanskrit": "वीथीभिः सर्वतो युक्तं सोपानै रत्नभूषितैः ।\nनारीशतसहस्राढ्यं दिव्यगोयसमन्वितम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7005479055, "chapter_id": 25479, "verse_number": "१-४९-५६", "content_sanskrit": "हंसकारण्डवाकीर्णं चक्रवाकोपशोभितम् ।\nचतुर्द्वारमनौपम्यमगम्यं देवविद्विषाम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7005479056, "chapter_id": 25479, "verse_number": "१-४९-५७", "content_sanskrit": "तत्र तत्राप्सरः सङ्‌धैर्नृत्यद्भिरुपशोभितम् ।\nनानागीतविधानज्ञैर्देवानामपि दुर्लभैः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7005479057, "chapter_id": 25479, "verse_number": "१-४९-५८", "content_sanskrit": "नानाविलाससंपन्नैः कामुकैरतिकोमलैः ।\nप्रभूतचन्द्रवदनैर्नूपुरारावसंयुतैः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7005479058, "chapter_id": 25479, "verse_number": "१-४९-५९", "content_sanskrit": "ईषत्‌स्मितैः सुबिम्बोष्ठैर्बालमुग्धमृगेक्षणैः ।\nअशेषविभवोपेतैर्भूषितैस्तनुमध्य विभूषितैः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7005479059, "chapter_id": 25479, "verse_number": "१-४९-६०", "content_sanskrit": "सुराजहंसचलनैः सुवेषैर्मधुरस्वनैः ।\nसंलापालापकुशलैर्दिव्याभरणभूषितैः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7005479060, "chapter_id": 25479, "verse_number": "१-४९-६१", "content_sanskrit": "स्तनभारविनम्रैश्च मदघूर्णितलोचनैः ।\nनानावर्णविचित्राङ्गैर्नानाभोगरतिप्रियैः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7005479061, "chapter_id": 25479, "verse_number": "१-४९-६२", "content_sanskrit": "प्रफुल्लकुसुमोद्यानैरितश्चेतश्च शोभितम् ।\nअसंख्येयगुणं शुद्धमागम्यं त्रिदशैरपि ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7005479062, "chapter_id": 25479, "verse_number": "१-४९-६३", "content_sanskrit": "श्रीमत्पवित्रं देवस्य श्रीपतेरमितौजसः ।\nतस्य मध्येऽतितेजस्कमुद्यत्प्राकारतोरणम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7005479063, "chapter_id": 25479, "verse_number": "१-४९-६४", "content_sanskrit": "स्थानं तद् वैष्णवं दिव्यं योगिनां सिद्धिदायकम् ।\nतन्मध्ये भगवानेकः पुण्डरीकदलद्युतिः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7005479064, "chapter_id": 25479, "verse_number": "१-४९-६५", "content_sanskrit": "शेतेऽशेषजगत्सूतिः शेषाहिशयने हरिः ।\nविचिन्त्यमानो योगीन्द्रैः सनन्दनपुरोगमैः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7005479065, "chapter_id": 25479, "verse_number": "१-४९-६६", "content_sanskrit": "स्वात्मानन्दामृतं पीत्वा पुरस्तात् तमसः परः ।\nसुपीतवसनोऽनन्तो महामायो महाभुजः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7005479066, "chapter_id": 25479, "verse_number": "१-४९-६७", "content_sanskrit": "क्षीरोदकन्यया नित्यं गृहीतचरणद्वयः ।\nसा च देवी जगद्वन्द्या पादमूले हरिप्रिया ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7005479067, "chapter_id": 25479, "verse_number": "१-४९-६८", "content_sanskrit": "समास्ते तन्मना नित्यं पीत्वा नारायणामृतम् ।\nन तत्राधार्मिका यान्ति न च देवान्तराश्रयाः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7005479068, "chapter_id": 25479, "verse_number": "१-४९-६९", "content_sanskrit": "वैकुण्ठं नाम तत् स्थानं त्रिदशैरपि वन्दितम् ।\nन मेऽत्र भवति प्रज्ञा कृत्स्नशास्त्रन्निरूपणे ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7005479069, "chapter_id": 25479, "verse_number": "१-४९-७०", "content_sanskrit": "एतावच्छक्यते वक्तुं नारायणपुरं हि तत् ।\nस एव परमं ब्रह्म वासुदेवः सनातनः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7005479070, "chapter_id": 25479, "verse_number": "१-४९-७१", "content_sanskrit": "शेते नारायणः श्रीमान् मायया मोहयञ्जगत् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7005479071, "chapter_id": 25479, "verse_number": "१-४९-७२", "content_sanskrit": "नारायणादिदं जातं तस्मिन्नेव व्यवस्थितम् ।\nतमेवाभ्येति कल्पान्ते स एव परमा गतिः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]