[{"id": 5000168000, "chapter_id": 9168, "verse_number": "२-९१-१", "content_sanskrit": "कृतबुद्धिं निवासाय तत्रैव स मुनिस्तदा ।\nभरतं कैकयीपुत्रमातिथ्येन न्यमन्त्रयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000168001, "chapter_id": 9168, "verse_number": "२-९१-२", "content_sanskrit": "अब्रवीद्भरतस्त्वेनं नन्विदं भवता कृतम् ।\nपाद्यमर्घ्यं तथातिथ्यं वने यदुपपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000168002, "chapter_id": 9168, "verse_number": "२-९१-३", "content_sanskrit": "अथोवाच भरद्वाजो भरतं प्रहसन्निव ।\nजाने त्वां प्रीतिसंयुक्तं तुष्येस्त्वं येन केनचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000168003, "chapter_id": 9168, "verse_number": "२-९१-४", "content_sanskrit": "सेनायास्तु तवैतस्या: कर्तुमिच्छामि भोजनम् ।\nमम प्रीतिर्यथारूपा त्वमर्हो मनुजाधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000168004, "chapter_id": 9168, "verse_number": "२-९१-५", "content_sanskrit": "किमर्थं चापि निक्षिप्य दूरे बलमिहागत: ।\nकस्मान्नेहोपयातोसि सबल: पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000168005, "chapter_id": 9168, "verse_number": "२-९१-६", "content_sanskrit": "भरत: प्रत्युवाचेदं प्राञ्जलिस्तं तपोधनम् ।\nससैन्यो नोपयातो ऽस्मि भगवन् भगवद्भयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000168006, "chapter_id": 9168, "verse_number": "२-९१-७", "content_sanskrit": "राज्ञा च भगवन् नित्यं राजपुत्रेण वा सदा ।\nयत्नत: परिहर्त्तव्या विषयेषु तपस्विन: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000168007, "chapter_id": 9168, "verse_number": "२-९१-८", "content_sanskrit": "वाजिमुख्या मनुष्याश्च मत्ताश्च वरवारणा: ।\nप्रच्छाद्य भगवन् भूमिं महतीमनुयान्ति माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000168008, "chapter_id": 9168, "verse_number": "२-९१-९", "content_sanskrit": "ते वृक्षानुदकं भूमिमाश्रमेषूटजांस्तथा ।\nन हिंस्युरिति तेनाहमेक एव समागत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000168009, "chapter_id": 9168, "verse_number": "२-९१-१०", "content_sanskrit": "आनीयतामित: सेनेत्याज्ञप्त: परमर्षिणा ।\nततस्तु चक्रे भरत: सेनाया: समुपागमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000168010, "chapter_id": 9168, "verse_number": "२-९१-११", "content_sanskrit": "अग्निशालां प्रविश्याथ पीत्वाप: परिमृज्य च ।\nआतिथ्यस्य क्रियाहेतोर्विश्वकर्माणमाह्वयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000168011, "chapter_id": 9168, "verse_number": "२-९१-१२", "content_sanskrit": "आह्वये विश्वकर्माणमहं त्वष्टारमेव च ।\nआतिथ्यं कर्तुमिच्छामि तत्र मे संविधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000168012, "chapter_id": 9168, "verse_number": "२-९१-१३", "content_sanskrit": "आह्वये लोकपालांस्त्रीन् देवान् शक्रमुखांस्तथा ।\nआतिथ्यं कर्तुमिच्छामि तत्र मे संविधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000168013, "chapter_id": 9168, "verse_number": "२-९१-१४", "content_sanskrit": "प्राक्स्रोतसश्च या नद्य: प्रत्यक्स्रोतस एव च ।\nपृथिव्यामन्तरिक्षे च समायान्त्वद्य सर्वश: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000168014, "chapter_id": 9168, "verse_number": "२-९१-१५", "content_sanskrit": "अन्या: स्रवन्तु मैरेयं सुरामन्या: सुनिष्ठिताम् ।\nअपराश्चोदकं शीतमिक्षुकाण्डरसोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000168015, "chapter_id": 9168, "verse_number": "२-९१-१६", "content_sanskrit": "आह्वये देवगन्धर्वान् विश्वावसुहहाहुहून् ।\nतथैवाप्सरसो देवीर्गन्धर्व्वीश्चापि सर्वश: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000168016, "chapter_id": 9168, "verse_number": "२-९१-१७", "content_sanskrit": "घृताचीमथ विश्वाचीं मिश्रकेशीमलम्बुसाम् ।\nनागदन्तां च हेमां च हिमामद्रिकृतस्थलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000168017, "chapter_id": 9168, "verse_number": "२-९१-१८", "content_sanskrit": "शक्रं याश्चोपतिष्ठन्ति ब्रह्माणं याश्च योषित: ।\nसर्वास्तुम्बुरुणा सार्द्धमाह्वये सपरिच्छदा: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000168018, "chapter_id": 9168, "verse_number": "२-९१-१९", "content_sanskrit": "वनं कुरुषु यद्दिव्यं वासोभूषणपत्ऺत्रवत् ।\nदिव्यनारीफलं शश्वत्तत्कौबेरमिहैतु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000168019, "chapter_id": 9168, "verse_number": "२-९१-२०", "content_sanskrit": "इह मे भगवान् सोमो विधत्तामन्नमुत्तमम् ।\nभक्ष्यं भोज्यं च चोष्यं च लेह्यं च विविधं बहु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000168020, "chapter_id": 9168, "verse_number": "२-९१-२१", "content_sanskrit": "विचित्राणि च माल्यानि पादपप्रच्युतानि च ।\nसुरादीनि च पेयानि मांसानि विविधानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000168021, "chapter_id": 9168, "verse_number": "२-९१-२२", "content_sanskrit": "एवं समाधिना युक्तस्तेजसा ऽप्रतिमेन च ।\nशीक्षास्वरसमायुक्तं तपसा चाब्रवीन्मुनि: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000168022, "chapter_id": 9168, "verse_number": "२-९१-२३", "content_sanskrit": "मनसा ध्यायतस्तस्य प्राङ्मुखस्य कृताञ्जले: ।\nआजग्मुस्तानि सर्वाणि दैवतानि पृथक्पृथक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000168023, "chapter_id": 9168, "verse_number": "२-९१-२४", "content_sanskrit": "मलयं दर्दुरं चैव तत: स्वेदनुदऽ ऽनिल: ।\nउपस्पृश्य ववौ युक्त्या सुप्रियात्मा सुख: शिव: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000168024, "chapter_id": 9168, "verse_number": "२-९१-२५", "content_sanskrit": "ततोभ्यवर्तन्त घना दिव्या: कुसुमवृष्टय: ।\nदिव्यदुन्दुभिघोषश्च दिक्षु सर्वासु शुश्रुवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000168025, "chapter_id": 9168, "verse_number": "२-९१-२६", "content_sanskrit": "प्रववुश्चोत्तमा वाताननृतुश्चाप्सरोगणा: ।\nप्रजगुर्देवगन्धर्वा वीणा: प्रमुमुचु: स्वरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000168026, "chapter_id": 9168, "verse_number": "२-९१-२७", "content_sanskrit": "स शब्दो द्यां च भूमिं च प्राणिनां श्रवणानि च ।\nविवेशोऺच्चारित: श्लक्ष्ण: समो लयगुणान्वित: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000168027, "chapter_id": 9168, "verse_number": "२-९१-२८", "content_sanskrit": "तस्मिन्नुपरते शब्दे दिव्ये श्रोतृ(त्र)सुखे नृणाम् ।\nददर्श भारतं सैन्यं विधानं विश्वकर्मण: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000168028, "chapter_id": 9168, "verse_number": "२-९१-२९", "content_sanskrit": "बभूव हि समा भूमि: समन्तात्पञ्चयोजना ।\nशाद्वलैर्बहुभिश्छन्ना नीलवैडूर्य्यसन्निभै: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000168029, "chapter_id": 9168, "verse_number": "२-९१-३०", "content_sanskrit": "तस्मिन् बिल्वा: कपित्थाश्च पनसा बीजपूरका: ।\nआमलक्यो बभूवुश्च चूताश्च फलभूषणा: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000168030, "chapter_id": 9168, "verse_number": "२-९१-३१", "content_sanskrit": "उत्तरेभ्य: कुरुभ्यश्च वनं दिव्योपभोगवत् ।\nआजगाम नदी दिव्या तीजैर्बहुभिर्वृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000168031, "chapter_id": 9168, "verse_number": "२-९१-३२", "content_sanskrit": "चतु:शालानि शुभ्राणि शालाश्च गजवाजिनाम् ।\nहर्म्यप्रासादसम्बाधास्तोरणानि शुभानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000168032, "chapter_id": 9168, "verse_number": "२-९१-३३", "content_sanskrit": "सितमेघनिभं चापि राजवेश्मसु तोरणम् ।\nदिव्यमाल्यकृताकारं दिव्यगन्धसमुक्षितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000168033, "chapter_id": 9168, "verse_number": "२-९१-३४", "content_sanskrit": "चतुरश्रमसम्बाधं शयनासनयानवत् ।\nदिव्यै: सर्वरसैर्युक्तं दिव्यभोजनवस्त्रवत् ।\nउपकल्पितसर्वान्नं धौतनिर्मलभाजनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000168034, "chapter_id": 9168, "verse_number": "२-९१-३५", "content_sanskrit": "क्लृप्तसर्वासनं श्रीमत् स्वास्तीर्णशयनोत्तमम् ।\nप्रविवेश महाबाहुरनुज्ञातो महर्षिणा ।\nवेश्म तद्रत्नसम्पूर्णं भरत: केकयीसुत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000168035, "chapter_id": 9168, "verse_number": "२-९१-३६", "content_sanskrit": "अनुजग्मुश्च तं सर्वे मन्त्रिण: सपुरोहिता: ।\nबभूवुश्च मुदा युक्ता दृष्ट्वा तं वेश्मसंविधिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000168036, "chapter_id": 9168, "verse_number": "२-९१-३७", "content_sanskrit": "तत्र राजासनं दिव्यं व्यजनं छत्रमेव च ।\nभरतो मन्त्रिभि: सार्द्धमभ्यवर्त्तत राजवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000168037, "chapter_id": 9168, "verse_number": "२-९१-३८", "content_sanskrit": "आसनं पूजयामास रामायाभिप्रणम्य च ।\nवालव्यजनमादाय न्यषीदत् सचिवासने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000168038, "chapter_id": 9168, "verse_number": "२-९१-३९", "content_sanskrit": "आनुपूर्व्यानिषेदुश्च सर्वे मन्त्रिपुरोहिता: ।\nतत: सेनापति: पश्चात् प्रशास्ता च निषेदतु: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000168039, "chapter_id": 9168, "verse_number": "२-९१-४०", "content_sanskrit": "ततस्तत्र मुहूर्त्तेन नद्य: पायसकर्दमा: ।\nउपातिष्ठन्त भरतं भरद्वाजस्य शासनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000168040, "chapter_id": 9168, "verse_number": "२-९१-४१", "content_sanskrit": "तासामुभयत:कूलं पाण्डुमृत्तिकलेपना: ।\nरम्याश्चावसथा दिव्या ब्रह्मणस्तु प्रसादजा: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000168041, "chapter_id": 9168, "verse_number": "२-९१-४२", "content_sanskrit": "तेनैव च मुहूर्त्तेन दिव्याभरणभूषिता: ।\nआगुर्विंशतिसाहस्रा ब्रह्मणा प्रहिता: स्त्रिय: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000168042, "chapter_id": 9168, "verse_number": "२-९१-४३", "content_sanskrit": "सुवर्णमणिमुक्तेन प्रवालेन च शोभिता: ।\nआगुर्विंशतिसाहस्रा: कुबेरप्रहिता: स्त्रिय: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000168043, "chapter_id": 9168, "verse_number": "२-९१-४४", "content_sanskrit": "याभिर्गृहीतपुरुष: सोन्माद इव लक्ष्यते ।\nआगुर्विंशतिसाहस्रा नन्दनादप्सरोगणा: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000168044, "chapter_id": 9168, "verse_number": "२-९१-४५", "content_sanskrit": "नारदस्तुम्बुरुर्गोप: प्रवरा: सूर्य्यवर्चस: ।\nएते गन्धर्वराजानो भरतस्याग्रतो जगु: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000168045, "chapter_id": 9168, "verse_number": "२-९१-४६", "content_sanskrit": "अलम्बुसा मिश्रकेशी पुण्डरीकाथ वामना ।\nउपानृत्यंस्तु भरत भरद्वाजस्य शासनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000168046, "chapter_id": 9168, "verse_number": "२-९१-४७", "content_sanskrit": "यानि माल्यानि देवेषु यानि चैत्ररथे वने ।\nप्रयागे तान्यदृश्यन्त भरद्वाजस्य तेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000168047, "chapter_id": 9168, "verse_number": "२-९१-४८", "content_sanskrit": "बिल्वा मार्दङ्गिका आसन् शम्याग्राहा विभीतका: ।\nअश्वत्थानर्त्तकाश्चासन् भरद्वाजस्य शासनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000168048, "chapter_id": 9168, "verse_number": "२-९१-४९", "content_sanskrit": "तत: सरलतालाश्च तिलका नक्तमालका: ।\nप्रहृष्टास्तत्र सम्पेतु: कुब्जा भूत्वाथ वामना: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000168049, "chapter_id": 9168, "verse_number": "२-९१-५०", "content_sanskrit": "शिंशुपामलकीजम्ब्वो याश्चान्या: काननेषु ता: ।\nमालती मल्लिका जातिर्याश्चान्या: कानने लता: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000168050, "chapter_id": 9168, "verse_number": "२-९१-५१", "content_sanskrit": "प्रमदाविग्रहं कृत्वा भरद्वाजाश्रमे ऽवदन् ।\nसुरा: सुरापा: पिबत पायसं च बुभुक्षिता: ।\nमांसानि च सुमेध्यानि भक्ष्यन्तां यावदिच्छथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000168051, "chapter_id": 9168, "verse_number": "२-९१-५२", "content_sanskrit": "उच्छाद्य स्नापयन्ति स्म नदीतीरेषु वल्गुषु ।\nअप्येकमेकं पुरुषं प्रमदा: सप्त चाष्ट च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000168052, "chapter_id": 9168, "verse_number": "२-९१-५३", "content_sanskrit": "संवाहन्त्य: समापेतुर्नार्यो रुचिरलोचना: ।\nपरिमृज्य तथान्योन्यं पाययन्ति वराङ्गना: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000168053, "chapter_id": 9168, "verse_number": "२-९१-५४", "content_sanskrit": "हयान् गजान् खरानुष्ट्रांस्तथैव सुरभे: सुतान् ।\nअभोजयन् वाहनपास्तेषां भोज्यं यथाविधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000168054, "chapter_id": 9168, "verse_number": "२-९१-५५", "content_sanskrit": "इक्षूंश्च मधुलाजांश्च भोजयन्ति स्म वाहनान् ।\nइक्ष्वाकुवरयोधानां चोदयन्तो महाबला: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000168055, "chapter_id": 9168, "verse_number": "२-९१-५६", "content_sanskrit": "नाश्वबन्धो ऽश्वमाजानान्न गजं कुञ्जरग्रह: ।\nमत्तप्रमत्तमुदिता नमू: सा तत्र सम्बभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000168056, "chapter_id": 9168, "verse_number": "२-९१-५७", "content_sanskrit": "तर्पिता: सर्वकामैस्ते रक्तचन्दनरूषिता: ।\nअप्सरोगणसंयुक्ता: सैन्या वाचमुदैरयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000168057, "chapter_id": 9168, "verse_number": "२-९१-५८", "content_sanskrit": "नैवायोध्यां गमिष्यामो न गमिष्याम दण्डकान् ।\nकुशलं भरतस्यास्तु रामस्यास्तु तथा सुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000168058, "chapter_id": 9168, "verse_number": "२-९१-५९", "content_sanskrit": "इति पादातयोधाश्च हस्त्यश्वारोह बन्धका: ।\nअनाथास्तं विधिं लब्ध्वा वाचमेतामुदैरयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000168059, "chapter_id": 9168, "verse_number": "२-९१-६०", "content_sanskrit": "सम्प्रहृष्टा विनेदुस्ते नरास्तत्र सहस्रश: ।\nभरतस्यानुयातार: स्वर्गोयमिति चाब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000168060, "chapter_id": 9168, "verse_number": "२-९१-६१", "content_sanskrit": "नृत्यन्ति स्म हसन्ति स्म गायन्ति स्म च सैनिका: ।\nसमन्तात् परिधावन्ति माल्योपेता: सहस्रश: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000168061, "chapter_id": 9168, "verse_number": "२-९१-६२", "content_sanskrit": "ततो भुक्तवतां तेषां तदन्नममृतोपमम् ।\nदिव्यानुद्वीक्ष्य भक्ष्यांस्तानभवद्भक्षणे मति: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000168062, "chapter_id": 9168, "verse_number": "२-९१-६३", "content_sanskrit": "प्रेष्याश्चेष्ट्यश्च वध्वश्च बलस्थाश्च सहस्रश: ।\nबभूवुस्ऺते भृशं दृप्ता: सर्वे चाहतवासस: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000168063, "chapter_id": 9168, "verse_number": "२-९१-६४", "content_sanskrit": "कुञ्जराश्च खरोष्ट्राश्च गोश्वाश्च मृगपक्षिण: ।\nबभूवु: सुभृतास्तत्र नान्यो ह्यन्यमकल्पयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000168064, "chapter_id": 9168, "verse_number": "२-९१-६५", "content_sanskrit": "नाशुक्लवासास्तत्रासीत् क्षुधितो मलिनो ऽपि वा ।\nरजसा ध्वस्तकेशो वा नर: कश्चिददृश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000168065, "chapter_id": 9168, "verse_number": "२-९१-६६", "content_sanskrit": "आजैश्चापि च वाराहैर्निष्ठानवरसञ्चयै: ।\nफलनिर्यूहसंसिद्धै: सूपैर्गन्धरसान्वितै: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 5000168066, "chapter_id": 9168, "verse_number": "२-९१-६७", "content_sanskrit": "पुष्पध्वजवती: पूर्णा: शुक्लस्यान्नस्य चाभित: ।\nददृशुर्विस्मितास्तत्र नरा लौही: सहस्रश: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 5000168067, "chapter_id": 9168, "verse_number": "२-९१-६८", "content_sanskrit": "बभूवुर्वनपार्श्वेषु कूपा: पायसकर्दमा: ।\nताश्च कामदुघा गावो द्रुमाश्चासन् मधुस्रुत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 5000168068, "chapter_id": 9168, "verse_number": "२-९१-६९", "content_sanskrit": "वाप्यो मैरेयपूर्णाश्च मृष्टमांसचयैर्वृता: ।\nप्रतप्तपिठरैश्चापि मार्गमायूरकौक्कुटै: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 5000168069, "chapter_id": 9168, "verse_number": "२-९१-७०", "content_sanskrit": "पात्रीणां च सहस्राणि स्थालीनां नियुतानि च ।\nन्यर्बुदानि च पात्राणि शातकुम्भमयानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 5000168070, "chapter_id": 9168, "verse_number": "२-९१-७१", "content_sanskrit": "स्थाल्य: कुम्भ्य: करम्भ्यश्च दधिपूर्णा: सुसंस्कृता: ।\nयौवनस्थस्य गौरस्य कपित्थस्य सुगन्धिन: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 5000168071, "chapter_id": 9168, "verse_number": "२-९१-७२", "content_sanskrit": "ह्रदा: पूर्णा रसालस्य दघ्न: श्वेतस्य चापरे ।\nबभूवु: पायसस्यान्ये शर्करायाश्च सञ्चया: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 5000168072, "chapter_id": 9168, "verse_number": "२-९१-७३", "content_sanskrit": "कल्कांश्चूर्णकषायांश्च स्नानानि विविधानि च ।\nददृशुर्भाजनस्थानि तीर्थेषु सरितां नरा: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 5000168073, "chapter_id": 9168, "verse_number": "२-९१-७४", "content_sanskrit": "शुक्लानंशुमतश्चापि दन्तधावनसञ्चयान् ।\nशुक्लांश्चन्दनकल्कांश्च समुद्गेष्ववतिष्ठत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 5000168074, "chapter_id": 9168, "verse_number": "२-९१-७५", "content_sanskrit": "दर्पणान् परिमृष्टांश्च वाससां चापि सञ्चयान् ।\nपादुकोपानहश्चैव युग्मानि च सहस्रश: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 5000168075, "chapter_id": 9168, "verse_number": "२-९१-७६", "content_sanskrit": "आञ्जनी: कङ्कतान् कूर्चान् शस्त्राणि च धनूंषि च ।\nमर्मत्राणानि चित्राणि शयनान्यासनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 5000168076, "chapter_id": 9168, "verse_number": "२-९१-७७", "content_sanskrit": "प्रतिपानह्रदान् पूर्णान् खरोष्ट्रगजवाजिनाम् ।\nअवगाह्य सुतीर्थांश्च ह्रदान् सोत्पलपुष्करान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 5000168077, "chapter_id": 9168, "verse_number": "२-९१-७८", "content_sanskrit": "आकाशवर्णप्रतिमान् स्वच्छतोयान् सुखप्लवान् ।\nनीलवैडूर्य्यवर्णांश्च मृदून् यवससञ्चयान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 5000168078, "chapter_id": 9168, "verse_number": "२-९१-७९", "content_sanskrit": "निर्वापार्थान् पशूनां ते ददृशुस्तत्र सर्वश: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 5000168079, "chapter_id": 9168, "verse_number": "२-९१-८०", "content_sanskrit": "व्यस्मयन्त मनुष्यास्ते स्वप्नकल्पं तदद्भुतम् ।\nदृष्ट्वातिथ्यं कृतं तादृक् भरतस्य महर्षिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 5000168080, "chapter_id": 9168, "verse_number": "२-९१-८१", "content_sanskrit": "इत्येवं रममाणानां देवानामिव नन्दने ।\nभरद्वाजाश्रमे रम्ये सा रात्रिर्व्यत्यवर्त्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 5000168081, "chapter_id": 9168, "verse_number": "२-९१-८२", "content_sanskrit": "प्रतिजग्मुश्च ता नद्यो गन्धर्वाश्च यथागतम् ।\nभरद्वाजमनुज्ञाप्य ताश्च सर्वा वराङ्गना: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 5000168082, "chapter_id": 9168, "verse_number": "२-९१-८३", "content_sanskrit": "तथैव मत्ता मदिरोत्कटा नरास्तथैव दिव्यागुरुचन्दनोक्षिता: ।\nतथैव दिव्या विविधा: स्रगुत्तमा: पृथक् प्रकीर्णा मनुजै: प्रमर्दिता: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 5000168083, "chapter_id": 9168, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदयोध्याकाण्डे एकनवतितम: सर्ग: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}]