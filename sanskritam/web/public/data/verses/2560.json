[{"id": 2073862, "chapter_id": 2560, "verse_number": "१२-६५-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2073863, "chapter_id": 2560, "verse_number": "१२-६५-१", "content_sanskrit": "श्रुता मे कथिताः पूर्वं चत्वारो मानवाश्रमाः।\nव्याख्यानमेषामाचक्ष्व पृच्छतो मे पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2073864, "chapter_id": 2560, "verse_number": "१२-६५-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2073865, "chapter_id": 2560, "verse_number": "१२-६५-२", "content_sanskrit": "विदिताः सर्व एवेह धर्मास्तव युधिष्ठिर।\nयथा मम महाबाहो विदिताः साधुसंमताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2073866, "chapter_id": 2560, "verse_number": "१२-६५-३", "content_sanskrit": "यत्तु लिङ्गान्तरगतं पृच्छसे मां युधिष्ठिर।\nधर्मं धर्मभृतां श्रेष्ठ तन्निबोध नराधिप।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2073867, "chapter_id": 2560, "verse_number": "१२-६५-४", "content_sanskrit": "सर्वाण्येतानि कौन्तेय विद्यन्ते भरतर्षभ।\nसाध्वाचारप्रवृत्तानां चातुराश्रम्यकर्मणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2073868, "chapter_id": 2560, "verse_number": "१२-६५-५", "content_sanskrit": "अकामद्वेषसंयुक्तो दण़्डनीत्या युधिष्ठिर।\nसमदर्शी च भूतेषु भैक्ष्याश्रमपदं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2073869, "chapter_id": 2560, "verse_number": "१२-६५-६", "content_sanskrit": "वेत्ति दानं विसर्गं च विग्रहानुग्रहौ तथा।\nयथोक्तवृत्तो धीरश्च क्षमाश्रमपदं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2073870, "chapter_id": 2560, "verse_number": "१२-६५-७", "content_sanskrit": "अर्हान्पूजयतो नित्यं संविभागेन पाण्डव।\nसर्वतस्तस्य कौन्तेय भैक्ष्याश्रमपदं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2073871, "chapter_id": 2560, "verse_number": "१२-६५-८", "content_sanskrit": "ज्ञातिसंबन्धिमित्राणि व्यापन्नानि युधिष्ठिर।\nसमभ्युद्धरमाणस्य दीक्षाश्रमपदं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2073872, "chapter_id": 2560, "verse_number": "१२-६५-९", "content_sanskrit": "लोकमुख्येषु सत्कारं लिङ्गिमुख्येषु चासकृत्।\nकुर्वतस्तस्य कौन्तेय वन्याश्रमपदं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2073873, "chapter_id": 2560, "verse_number": "१२-६५-१०", "content_sanskrit": "आह्निकं पितृयज्ञांश्च भूतयज्ञान्समानुषान्।\nकुर्वतः पार्थ विपुलान्वन्याश्रमपदं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2073874, "chapter_id": 2560, "verse_number": "१२-६५-११", "content_sanskrit": "संविभागेन भूतानामतिथीनां तथाऽर्चनात्।\nदेवयज्ञैश्च राजेन्द्र वन्याश्रमपदं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2073875, "chapter_id": 2560, "verse_number": "१२-६५-१२", "content_sanskrit": "मर्दनं परराष्ट्राणां शिष्टार्थं सत्यविक्रम।\nकुर्वतः पुरुषव्याघ्र वन्याश्रमपदं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2073876, "chapter_id": 2560, "verse_number": "१२-६५-१३", "content_sanskrit": "पालनात्सर्वभूतानां स्वराष्ट्रपरिपालनात्।\nदीक्षा बहुविधा राजन्सत्याश्रमपदं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2073877, "chapter_id": 2560, "verse_number": "१२-६५-१४", "content_sanskrit": "वेदाध्ययननित्यत्वं क्षमाऽथाचार्यपूजनम्।\nतथोपाध्यायशुश्रूषा ब्रह्माश्रमपदं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2073878, "chapter_id": 2560, "verse_number": "१२-६५-१५", "content_sanskrit": "आह्निकाञ्जपमानस्य देवान्पूजयतः सदा।\nधर्मेण पुरुषव्याघ्र धर्माश्रमपदं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2073879, "chapter_id": 2560, "verse_number": "१२-६५-१६", "content_sanskrit": "मृत्युर्वा रक्षणं वेति यस्य राज्ञो विनिश्चयः।\nप्राणद्यूते व्यवस्थाप्य ब्रह्माश्रमपदं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2073880, "chapter_id": 2560, "verse_number": "१२-६५-१७", "content_sanskrit": "अजिह्नमशठं मार्गं वर्तमानस्य भारत।\nसर्वदा सर्वभूतेषु ब्रह्माश्रमपदं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2073881, "chapter_id": 2560, "verse_number": "१२-६५-१८", "content_sanskrit": "वानप्रस्थेषु विप्रेषु त्रैविद्येषु च भारत।\nप्रयच्छतोऽर्थान्विपुलान्वन्याश्रमपदं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2073882, "chapter_id": 2560, "verse_number": "१२-६५-१९", "content_sanskrit": "सर्वभूतेष्वनुक्रोशं कुर्वतस्तव भारत।\nआनृशंस्ये प्रवृत्तस्य नियतः पुण्यसंचयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2073883, "chapter_id": 2560, "verse_number": "१२-६५-२०", "content_sanskrit": "बालवृद्धेषु कौन्तेय सर्वावस्थं युधिष्ठिर।\nअनुक्रोशक्रिया पार्थ धर्म एष सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2073884, "chapter_id": 2560, "verse_number": "१२-६५-२१", "content_sanskrit": "बलात्कृतेषु भूतेषु परित्राणं कुरूद्वह।\nशरणागतेषु कौरव्य परं कारुण्यमाचर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2073885, "chapter_id": 2560, "verse_number": "१२-६५-२२", "content_sanskrit": "चराचराणां भूतानां रक्षणं चापि सर्वशः।\nयथार्हपूजां च तथा कुर्वन्गार्हस्थ्यमावसेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2073886, "chapter_id": 2560, "verse_number": "१२-६५-२३", "content_sanskrit": "ज्येष्ठानुज्येष्ठपत्नीनां भ्रातॄणां पुत्रनप्तृणाम्।\nनिग्रहानुग्रहौ पार्थ गार्हस्थ्यममितं तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2073887, "chapter_id": 2560, "verse_number": "१२-६५-२४", "content_sanskrit": "साधूनामर्चनीयानां पूजासु विदितात्मनाम्।\nपालनं पुरुषव्याघ्र गृहाश्रमपदं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2073888, "chapter_id": 2560, "verse_number": "१२-६५-२५", "content_sanskrit": "आश्रमस्थानि भूतानि यस्य वेश्मनि भारत।\nभुञ्जते विपुलं भोज्यं तद्गार्हस्थ्यं युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2073889, "chapter_id": 2560, "verse_number": "१२-६५-२६", "content_sanskrit": "यः स्थितः पुरुषो धर्मे धात्रा सृष्टे यथार्थवत्।\nआश्रमाणां हि सर्वेषां फलं प्राप्नोत्यनामयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2073890, "chapter_id": 2560, "verse_number": "१२-६५-२७", "content_sanskrit": "यस्मिन्न नश्यन्ति गुणाः कौन्तेय पुरुषे सदा।\nआश्रमस्थं तमप्याहुर्नरश्रेष्ठं युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2073891, "chapter_id": 2560, "verse_number": "१२-६५-२८", "content_sanskrit": "स्थानमानं कुलेमानं वयोमानं तथैव च।\nकुर्वन्वसति सर्वेषु ह्याश्रमेषु युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2073892, "chapter_id": 2560, "verse_number": "१२-६५-२९", "content_sanskrit": "देशधर्मांश्च कौन्तेय कुलधर्मास्तथैव च।\nपालयन्पुरुषव्याघ्र राजा सर्वाश्रमी भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2073893, "chapter_id": 2560, "verse_number": "१२-६५-३०", "content_sanskrit": "काले विभूतिं भूतानामुपहारांस्तथैव च।\nअर्हयन्पुरुषव्याघ्र साधूनामाश्रमे वसेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2073894, "chapter_id": 2560, "verse_number": "१२-६५-३१", "content_sanskrit": "देशधर्मगतश्चापि यो धर्मं प्रत्यवेक्षते।\nसर्वलोकस्य कौन्तेय राजा भवति सोश्रमी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2073895, "chapter_id": 2560, "verse_number": "१२-६५-३२", "content_sanskrit": "ये धर्मकुशला लोके धर्मं कुर्वन्ति भारत।\nपालिता यस्य विषये पादांशस्तस्य भूपतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2073896, "chapter_id": 2560, "verse_number": "१२-६५-३३", "content_sanskrit": "धर्मारामान्धर्मपरान्ये न रक्षन्ति मानवान्।\nपार्थिवाः पुरुषव्याघ्र तेषां पापं हरन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2073897, "chapter_id": 2560, "verse_number": "१२-६५-३४", "content_sanskrit": "ये च रक्षासहायाः स्युः पार्थिवानां युधिष्ठिर।\nते चैवांशहराः सर्वे धर्मे परकृतेऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2073898, "chapter_id": 2560, "verse_number": "१२-६५-३५", "content_sanskrit": "सर्वाश्रमपदेऽप्याहुर्गार्हस्थ्यं दीप्तनिर्णयम्।\nपावनं पुरुषव्याघ्र यद्वयं पर्युपास्महे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2073899, "chapter_id": 2560, "verse_number": "१२-६५-३६", "content_sanskrit": "आत्मोपमस्तु भूतेषु यो वै भवति मानवः।\nन्यस्तदण्डो जितक्रोधः प्रेत्येह लभते सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2073900, "chapter_id": 2560, "verse_number": "१२-६५-३७", "content_sanskrit": "धर्मोच्छ्रिता सत्यजला शीलयष्टिर्दमध्वजा।\nत्यागवाताध्वगा शीघ्रा नौस्तया सन्तरिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2073901, "chapter_id": 2560, "verse_number": "१२-६५-३८", "content_sanskrit": "यदा सर्वत्र निर्मुक्तः कामो नास्य हृदि स्थितः।\nयदा सत्यान्वितो वृत्तैस्तदा ब्रह्म सम श्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2073902, "chapter_id": 2560, "verse_number": "१२-६५-३९", "content_sanskrit": "सुप्रसन्नस्तु भावेन योगेन च नराधिप।\nधर्मं पुरुषशार्दूल प्राप्स्यसे पालने रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2073903, "chapter_id": 2560, "verse_number": "१२-६५-४०", "content_sanskrit": "वेदाध्ययनशीलानां विप्राणां साधुकर्मणाम्।\nपालने यत्नमातिष्ठ सर्वलोकस्य चानघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2073904, "chapter_id": 2560, "verse_number": "१२-६५-४१", "content_sanskrit": "वने चरन्ति ये धर्ममाश्रमेषु च भारत।\nरक्षणात्तच्छतगुणं धर्मं प्राप्नोति पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2073905, "chapter_id": 2560, "verse_number": "१२-६५-४२", "content_sanskrit": "एष ते विविधो धर्मः पाण्डवश्रेष्ठ कीर्तितः।\nयुधिष्ठिर त्वमेनं वै पूर्वं दृष्टं सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2073906, "chapter_id": 2560, "verse_number": "१२-६५-४३", "content_sanskrit": "चातुराश्रम्यमैकाग्र्यं चातुर्वर्ण्यं च पाण्डवं।\nधर्मं पुरुषशार्दूल प्राप्स्यसे पालने रतः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2073907, "chapter_id": 2560, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि पञ्चषष्टितमोऽध्यायः॥ ६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]