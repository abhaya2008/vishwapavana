[{"id": 6000217000, "chapter_id": 10217, "verse_number": null, "content_sanskrit": "अथ एकविंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000217001, "chapter_id": 10217, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.001.m4a", "display_order": 2}, {"id": 6000217002, "chapter_id": 10217, "verse_number": "१०-२१-१", "content_sanskrit": "राम राम महाबाहो कृष्ण दुष्टनिबर्हण।\nएषा वै बाधते क्षुन्नस्तच्छान्तिं कर्तुमर्हथः॥ १०/२१/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.002.m4a", "display_order": 3, "topics": [{"text": "अन्नं प्रार्थयतां गोपानां श्रीकृष्णेन विप्राणां यज्ञशालाप्रेषणम्", "range": "१–८"}]}, {"id": 6000217003, "chapter_id": 10217, "verse_number": "१०-२१-२", "content_sanskrit": "इति विज्ञापितो गोपैर्भगवान् जगदीश्वरः।\nभक्ताया विप्रभार्यायाः प्रसीदन्निदमब्रवीत्॥ १०/२१/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.003.m4a", "display_order": 4}, {"id": 6000217004, "chapter_id": 10217, "verse_number": "१०-२१-३", "content_sanskrit": "प्रयात देवयजनं ब्राह्मणा ब्रह्मवादिनः।\nसत्रमाङ्गिरसं नाम ह्यासते स्वर्गकाम्यया॥ १०/२१/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.004.m4a", "display_order": 5}, {"id": 6000217005, "chapter_id": 10217, "verse_number": "१०-२१-४", "content_sanskrit": "तत्र गत्वौदनं गोपा याचतास्मद्विसर्जिताः।\nकीर्तयन्तो भगवत आर्यस्य मम चाभिधाम्॥ १०/२१/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.005.m4a", "display_order": 6}, {"id": 6000217006, "chapter_id": 10217, "verse_number": "१०-२१-५", "content_sanskrit": "इत्यादिष्टा भगवता गत्वाऽयाचन्त ते तथा।\nकृताञ्जलिपुटा विप्रान् दण्डवत् पतिता भुवि॥ १०/२१/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.006.m4a", "display_order": 7}, {"id": 6000217007, "chapter_id": 10217, "verse_number": "१०-२१-६", "content_sanskrit": "हे भूमिदेवाः शृणुत कृष्णस्यादेशकारिणः।\nप्राप्तान् जानीत भद्रं वो गोपान् नो रामचोदितान्॥ १०/२१/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.007.m4a", "display_order": 8}, {"id": 6000217008, "chapter_id": 10217, "verse_number": "१०-२१-७", "content_sanskrit": "गाश्चारयन्तावविदूर ओदनं रामाच्युतौ वो लषतो बुभुक्षितौ।\nतयोर्द्विजा ओदनमर्थिनोर्यदि श्रद्धा च वो यच्छत धर्मवित्तमाः॥ १०/२१/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.008.m4a", "display_order": 9}, {"id": 6000217009, "chapter_id": 10217, "verse_number": "१०-२१-८", "content_sanskrit": "दीक्षायाः पशुसंस्थायाः सौत्रामण्याश्च सत्तमाः।\nअन्यत्र दीक्षितस्यापि नान्नमश्नन् हि दूष्यति॥ १०/२१/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.009.m4a", "display_order": 10}, {"id": 6000217010, "chapter_id": 10217, "verse_number": "१०-२१-९", "content_sanskrit": "इति ते भगवद्याञ्चां शृण्वन्तोऽपि न शुश्रुवुः।\nक्षुद्राशा भूरिकर्माणो बालिशा वृद्धमानिनः॥ १०/२१/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.010.m4a", "display_order": 11, "topics": [{"text": "भगवतोऽन्नाकाङ्क्षां श्रुत्वाप्युदासीनेषु विप्रेषु श्रीकृष्णेन पुनस्तेषां यज्ञपत्नीर्निवेदयितुं गोपानां प्रेषणम्", "range": "९–१७"}]}, {"id": 6000217011, "chapter_id": 10217, "verse_number": "१०-२१-१०", "content_sanskrit": "देशः कालः पृथग्द्रव्यं मन्त्रतन्त्रर्त्विजोऽग्नयः।\nदेवता यजमानश्च क्रतुर्धर्मश्च यन्मयः॥ १०/२१/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.011.m4a", "display_order": 12}, {"id": 6000217012, "chapter_id": 10217, "verse_number": "१०-२१-११", "content_sanskrit": "तं ब्रह्म परमं साक्षाद् भगवन्तमधोक्षजम्।\nमनुष्यदृष्ट्या दुष्प्रज्ञा मर्त्यात्मानो न मेनिरे॥ १०/२१/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.012.m4a", "display_order": 13}, {"id": 6000217013, "chapter_id": 10217, "verse_number": "१०-२१-१२", "content_sanskrit": "न ते यदोमिति प्रोचुर्न नेति च परन्तप।\nगोपा निराशाः प्रत्येत्य तथोचुः कृष्णरामयोः॥ १०/२१/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.013.m4a", "display_order": 14}, {"id": 6000217014, "chapter_id": 10217, "verse_number": "१०-२१-१३", "content_sanskrit": "तदुपाकर्ण्य भगवान् प्रहस्य जगदीश्वरः।\nव्याजहार पुनर्गोपान् दर्शयन् लौकिकीं गतिम्॥ १०/२१/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.014.m4a", "display_order": 15}, {"id": 6000217015, "chapter_id": 10217, "verse_number": "१०-२१-१४", "content_sanskrit": "मां ज्ञापयत पत्नीभ्यः ससङ्कर्षणमागतम्।\nदास्यन्ति काममन्नं वः स्निग्धा मय्युषिता धिया॥ १०/२१/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.015.m4a", "display_order": 16}, {"id": 6000217016, "chapter_id": 10217, "verse_number": "१०-२१-१५", "content_sanskrit": "गत्वाऽथ पत्नीशालायां दृष्ट्वाऽऽसीनाः स्वलङ्कृताः।\nनत्वा द्विजसतीर्गोपाः प्रश्रिता इदमब्रुवन्॥ १०/२१/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.016.m4a", "display_order": 17}, {"id": 6000217017, "chapter_id": 10217, "verse_number": "१०-२१-१६", "content_sanskrit": "नमो वो द्विजपत्नीभ्यो निबोधत वचांसि नः।\nइतोऽविदूरे चरता कृष्णेन प्रेषिता वयम्॥ १०/२१/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.017.m4a", "display_order": 18}, {"id": 6000217018, "chapter_id": 10217, "verse_number": "१०-२१-१७", "content_sanskrit": "गाश्चारयन् स गोपालः सरामो दूरमागतः।\nबुभुक्षितस्य तस्यान्नं सानुगस्य प्रदीयताम्॥ १०/२१/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.018.m4a", "display_order": 19}, {"id": 6000217019, "chapter_id": 10217, "verse_number": "१०-२१-१८", "content_sanskrit": "श्रुत्वाऽच्युतमुपायान्तं नित्यं तद्दर्शनोत्सुकाः।\nतत्कथाक्षिप्तमनसो बभूवुर्जातसम्भ्रमाः॥ १०/२१/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.019.m4a", "display_order": 20, "topics": [{"text": "द्विजपत्नीभिर्निषेद्धॄन्स्वपतीनप्यनादृत्य श्रीकृष्णाय स्वाद्वन्नानयनम्", "range": "१८–३६"}]}, {"id": 6000217020, "chapter_id": 10217, "verse_number": "१०-२१-१९", "content_sanskrit": "चतुर्विधं बहुगुणमन्नमादाय भाजनैः।\nअभिसस्रुः प्रियं सर्वाः समुद्रमिव निम्नगाः॥ १०/२१/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.020.m4a", "display_order": 21}, {"id": 6000217021, "chapter_id": 10217, "verse_number": "१०-२१-२०", "content_sanskrit": "निषिध्यमानाः पतिभिर्भ्रातृभिर्बन्धुभिः सुतैः।\nभगवत्युत्तमश्लोके दीर्घश्रुतभृताशयाः॥ १०/२१/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.021.m4a", "display_order": 22}, {"id": 6000217022, "chapter_id": 10217, "verse_number": "१०-२१-२१", "content_sanskrit": "यमुनोपवनेऽशोकनवपल्लवमण्डिते।\nप्रचरन्तं वृतं गोपैर्ददृशुः साग्रजं स्‍त्रियः॥ १०/२१/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.022.m4a", "display_order": 23}, {"id": 6000217023, "chapter_id": 10217, "verse_number": "१०-२१-२२", "content_sanskrit": "श्यामं हिरण्यपरिधिं वनमाल्यबर्हधातुप्रवालनटवेषमनुव्रतांसे।\nविन्यस्तहस्तमितरेण धुनानमब्जं कर्णोत्पलालककपोलमुखाब्जहासम्॥ १०/२१/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.023.m4a", "display_order": 24}, {"id": 6000217024, "chapter_id": 10217, "verse_number": "१०-२१-२३", "content_sanskrit": "दीर्घश्रुतप्रियतमोदयकर्णपूरैः यस्मिन् निमग्नमनसस्तमथाक्षिरन्ध्रैः।\nअन्तः प्रवेश्य सुचिरं परिरभ्य तापं प्राज्ञाः यथाऽभिमतयो विजहुर्नरेन्द्र॥ १०/२१/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.024.m4a", "display_order": 25}, {"id": 6000217025, "chapter_id": 10217, "verse_number": "१०-२१-२४", "content_sanskrit": "तास्तथा त्यक्तसर्वाशाः प्राप्ता आत्मदिदृक्षया।\nविज्ञायाखिलदृग् दृष्ट्या प्राह प्रहसिताननः॥ १०/२१/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.025.m4a", "display_order": 26}, {"id": 6000217026, "chapter_id": 10217, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.026.m4a", "display_order": 27}, {"id": 6000217027, "chapter_id": 10217, "verse_number": "१०-२१-२५", "content_sanskrit": "स्वागतं वो महाभागा आस्यतां करवाम किम्।\nयन्नो दिदृक्षयाऽभ्येता उपपन्नमिदं हि वः॥ १०/२१/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.027.m4a", "display_order": 28}, {"id": 6000217028, "chapter_id": 10217, "verse_number": "१०-२१-२६", "content_sanskrit": "न श्रद्धामधिकुर्वन्ति कुशलार्थनिदर्शनाः।\nअहैतुक्यव्यवहितां भक्तिमात्मप्रिये यथा॥ १०/२१/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.028.m4a", "display_order": 29}, {"id": 6000217029, "chapter_id": 10217, "verse_number": "१०-२१-२७", "content_sanskrit": "प्राणबुद्धिमनःखात्मदेहापत्यधनादयः।\nयत्सम्पर्कात् प्रिया आसंस्ततः को न्वपरः प्रियः॥ १०/२१/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.029.m4a", "display_order": 30}, {"id": 6000217030, "chapter_id": 10217, "verse_number": "१०-२१-२८", "content_sanskrit": "तद् यात साध्व्यो यजनं पतयो वो द्विजातयः।\nस्वसत्रं पारयिष्यन्ति युष्माभिर्गृहमेधिनः॥ १०/२१/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.030.m4a", "display_order": 31}, {"id": 6000217031, "chapter_id": 10217, "verse_number": null, "content_sanskrit": "यज्ञपत्न्य ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.031.m4a", "display_order": 32}, {"id": 6000217032, "chapter_id": 10217, "verse_number": "१०-२१-२९", "content_sanskrit": "मैवं विभोऽर्हति भवान् गदितुं नृशंसं सत्यं कुरुष्व निगमं तव पादमूलम्।\nप्राप्ता वयं तुलसिदाम पदावसृष्टं केशैर्निवोढुमतिलङ्घ्य समस्तबन्धून्॥ १०/२१/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.032.m4a", "display_order": 33}, {"id": 6000217033, "chapter_id": 10217, "verse_number": "१०-२१-३०", "content_sanskrit": "गृह्णन्ति नो न पतयः पितरौ सुता वा न भ्रातृबन्धुसुहृदः कुत एव चान्ये।\nतस्मात् प्रसीद पदयोः पतितात्मनां नो नान्या भवेद् गतिररिन्दम तद् विधेहि॥ १०/२१/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.033.m4a", "display_order": 34}, {"id": 6000217034, "chapter_id": 10217, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.034.m4a", "display_order": 35}, {"id": 6000217035, "chapter_id": 10217, "verse_number": "१०-२१-३१", "content_sanskrit": "पतयो नाभ्यसूयेरन् नित्यं भ्रातृसुतादयः।\nलोकाश्च वो मयोपेता देवा अप्यनुमन्वते॥ १०/२१/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.035.m4a", "display_order": 36}, {"id": 6000217036, "chapter_id": 10217, "verse_number": "१०-२१-३२", "content_sanskrit": "न प्रीतयेऽनुरागाय ह्यङ्गसङ्गो नृणामिह।\nतन्मनो मयि युञ्जाना अचिरान्मामवाप्स्यथ॥ १०/२१/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.036.m4a", "display_order": 37}, {"id": 6000217037, "chapter_id": 10217, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.037.m4a", "display_order": 38}, {"id": 6000217038, "chapter_id": 10217, "verse_number": "१०-२१-३३", "content_sanskrit": "इत्युक्ता द्विजपत्न्यस्ता यज्ञवाटं पुनर्गताः।\nते चानसूयवस्ताभिः स्‍त्रीभिः सत्रमपारयन्॥ १०/२१/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.038.m4a", "display_order": 39}, {"id": 6000217039, "chapter_id": 10217, "verse_number": "१०-२१-३४", "content_sanskrit": "तत्रैका विधृता भर्त्रा भगवन्तं यथाश्रुतम्।\nहृदोपगुह्य विजहौ देहं कर्मानुबन्धनम्॥ १०/२१/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.039.m4a", "display_order": 40}, {"id": 6000217040, "chapter_id": 10217, "verse_number": "१०-२१-३५", "content_sanskrit": "भगवानपि गोविन्दस्तेनैवान्नेन गोपकान्।\nचतुर्विधेनाशयित्वा स्वयं च बुभुजे प्रभुः॥ १०/२१/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.040.m4a", "display_order": 41}, {"id": 6000217041, "chapter_id": 10217, "verse_number": "१०-२१-३६", "content_sanskrit": "एवं लीलानरवपुर्नृलोकमनुशीलयन्।\nरेमे गोगोपगोपीनां रमयन् नृप वाक्कृतैः॥ १०/२१/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.041.m4a", "display_order": 42}, {"id": 6000217042, "chapter_id": 10217, "verse_number": "१०-२१-३७", "content_sanskrit": "अथानुस्मृत्य विप्रास्ते अन्वतप्यन् कृतागसः।\nयद् विश्वेश्वरयोर्याञ्चामहनन् नृविडम्बयोः॥ १०/२१/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.042.m4a", "display_order": 43, "topics": [{"text": "स्वपत्नीनां भगवद्भक्तिं दृष्ट्वा द्विजानामनुतापः", "range": "३७–५०"}]}, {"id": 6000217043, "chapter_id": 10217, "verse_number": "१०-२१-३८", "content_sanskrit": "दृष्ट्वा स्‍त्रीणां भगवति कृष्णे भक्तिमलौकिकीम्।\nआत्मानं च तया हीनमनुतप्ता व्यगर्हयन्॥ १०/२१/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.043.m4a", "display_order": 44}, {"id": 6000217044, "chapter_id": 10217, "verse_number": "१०-२१-३९", "content_sanskrit": "धिग् जन्म नस्तु धिग् बुद्धिं धिग् वृत्तं धिग् बहुज्ञताम्।\nधिक् कुलं धिक् क्रियादाक्ष्यं विमुखा ये त्वधोक्षजे॥ १०/२१/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.044.m4a", "display_order": 45}, {"id": 6000217045, "chapter_id": 10217, "verse_number": "१०-२१-४०", "content_sanskrit": "नूनं भगवतो माया मायिनामपि मोहिनी।\nयद् वयं गुरवो नॄणां स्वार्थे मुह्यामहे द्विजाः॥ १०/२१/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.045.m4a", "display_order": 46}, {"id": 6000217046, "chapter_id": 10217, "verse_number": "१०-२१-४१", "content_sanskrit": "अहो पश्यत नारीणामपि कृष्णे जगद्गुरौ।\nदुरन्तभावं यश्छिन्द्यान्मृत्युपाशान् गृहाभिधान्॥ १०/२१/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.046.m4a", "display_order": 47}, {"id": 6000217047, "chapter_id": 10217, "verse_number": "१०-२१-४२", "content_sanskrit": "नासां द्विजातिसंस्कारो न निवासो गुरावपि।\nन तपो नात्ममीमांसा न शौचं न क्रियाः शुभाः॥ १०/२१/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.047.m4a", "display_order": 48}, {"id": 6000217048, "chapter_id": 10217, "verse_number": "१०-२१-४३", "content_sanskrit": "अथापि ह्युत्तमश्लोके कृष्णे योगेश्वरेश्वरे।\nभक्तिर्दृढा न चास्माकं संस्कारादिमतामपि॥ १०/२१/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.048.m4a", "display_order": 49}, {"id": 6000217049, "chapter_id": 10217, "verse_number": "१०-२१-४४", "content_sanskrit": "ननु स्वार्थविमूढानां प्रमत्तानां गृहेहया।\nअहो नः स्मारयामास गोपवाक्यैः सतां गतिः॥ १०/२१/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.049.m4a", "display_order": 50}, {"id": 6000217050, "chapter_id": 10217, "verse_number": "१०-२१-४५", "content_sanskrit": "अन्यथा पूर्णकामस्य कैवल्याद्याशिषां पतेः।\nईशितव्यैः किमस्माभिरीशस्यैतद् विडम्बनम्॥ १०/२१/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.050.m4a", "display_order": 51}, {"id": 6000217051, "chapter_id": 10217, "verse_number": "१०-२१-४६", "content_sanskrit": "हित्वाऽन्यान् भजते यं श्रीः पादस्पर्शाशयाऽसकृत्।\nआत्मदोषापवर्गेण तद्याञ्चा जनमोहिनी॥ १०/२१/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.051.m4a", "display_order": 52}, {"id": 6000217052, "chapter_id": 10217, "verse_number": "१०-२१-४७", "content_sanskrit": "देशः कालः पृथग्द्रव्यं मन्त्रतन्त्रर्त्विजोऽग्नयः।\nदेवता यजमानश्च क्रतुर्धर्मश्च यन्मयाः॥ १०/२१/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.052.m4a", "display_order": 53}, {"id": 6000217053, "chapter_id": 10217, "verse_number": "१०-२१-४८", "content_sanskrit": "स एष भगवान् साक्षाद् विष्णुर्योगेश्वरेश्वरः।\nजातो भुवीति शृण्वाना ये विमूढा न विद्महे॥ १०/२१/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.053.m4a", "display_order": 54}, {"id": 6000217054, "chapter_id": 10217, "verse_number": "१०-२१-४९", "content_sanskrit": "नमस्तुभ्यं भगवते कृष्णायाकुण्ठमेधसे।\nयन्मायामोहितदृशो भ्रमामः कर्मवर्त्मसु॥ १०/२१/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.054.m4a", "display_order": 55}, {"id": 6000217055, "chapter_id": 10217, "verse_number": "१०-२१-५०", "content_sanskrit": "स वै न आद्यः पुरुषः स्वमायामोहितात्मनाम्।\nअविज्ञातानुभावानां क्षन्तुमर्हत्यतिक्रमम्॥ १०/२१/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.055.m4a", "display_order": 56}, {"id": 6000217056, "chapter_id": 10217, "verse_number": "१०-२१-५१", "content_sanskrit": "इति कृष्णमनुस्सृत्य विप्रास्ते कृतहेलनाः।\nदिदृक्षवोऽप्यच्युतयोः कंसाद् भीता न चाचलन्॥ १०/२१/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_021/BhP_10.021.056.m4a", "display_order": 57}, {"id": 6000217057, "chapter_id": 10217, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे एकविंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]