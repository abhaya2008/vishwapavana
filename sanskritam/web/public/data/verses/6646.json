[
  {
    "id": 20007066,
    "chapter_id": 6646,
    "verse_number": "16.1",
    "content_sanskrit": "दमघोषसुतेन कश्चन प्रतिशिष्टः प्रतिभानवानथ । उपगम्यहरिं सदस्यदः स्फुटभिन्नार्थमुदाहरद्वचः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20007067,
    "chapter_id": 6646,
    "verse_number": "16.2",
    "content_sanskrit": "अभिधाय तदा तदप्रियं शिशुपालोऽनुशयं परं गतः । भवतोऽभिमनाः समीहते सरुषः कर्तुमुपेत्य माननाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20007068,
    "chapter_id": 6646,
    "verse_number": "16.3",
    "content_sanskrit": "विपुलेन निपीड्य निर्दयं मुदमायातु नितान्तमुन्मनाः । प्रचुराधिगताङ्गनिर्वृतिं परितस्त्वां खलु विग्रहेण सः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20007069,
    "chapter_id": 6646,
    "verse_number": "16.4",
    "content_sanskrit": "प्रणतः शिरसा करिष्यते सकलैरेत्य समं धराधिपैः । तव शासनमाशु भूपतिः परवानद्य यतस्त्वयैव सः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20007070,
    "chapter_id": 6646,
    "verse_number": "16.5",
    "content_sanskrit": "अधिवह्निपतङ्गतेजसो नियतस्वान्तसमर्थकर्मणः । तव सर्वविधेयवर्तिनः प्रणतिं बिभ्रति केन भूभृतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20007071,
    "chapter_id": 6646,
    "verse_number": "16.6",
    "content_sanskrit": "जनतां भयशून्यधीः परैरभिभूतामवलम्बसे यतः । तव कृष्ण गुणास्ततो नरैरसमानस्य दधत्यगण्यताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20007072,
    "chapter_id": 6646,
    "verse_number": "16.7",
    "content_sanskrit": "अहितादनपत्रपस्त्रसन्नतिमात्रोज्झितभीरनास्तिकः । विनयोपहितस्त्वया कुतः सदृशोन्यो गुणवानविस्मयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20007073,
    "chapter_id": 6646,
    "verse_number": "16.8",
    "content_sanskrit": "कृतगोपवधूरतेर्घ्नतो वृषमुग्रे नरकेऽपि संप्रति । प्रतिपत्तिरधःकृतैनसो जनताभिस्तव साधु वर्ण्यते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20007074,
    "chapter_id": 6646,
    "verse_number": "16.9",
    "content_sanskrit": "विहितापचितिर्महीभृतां द्विषतामाहितसाध्वसो बलैः । भव सानुचरस्त्वमुच्चकैर्महतामप्युपरि क्षमाभृताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20007075,
    "chapter_id": 6646,
    "verse_number": "16.10",
    "content_sanskrit": "घनजालनिभैर्दुरासदाः परितो नागकदम्बकैस्तव । नगरेषु भवन्तु वीथयः परिकीर्णा वनजैर्मृगादिभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20007076,
    "chapter_id": 6646,
    "verse_number": "16.11",
    "content_sanskrit": "सकलापिहितस्वपौरुषो नियतव्यापदवर्धितोदयः । रिपुरुन्नतधीरचेतसः सततव्याधिरनीतिरस्तु ते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20007077,
    "chapter_id": 6646,
    "verse_number": "16.12",
    "content_sanskrit": "विकचोत्पलचारुलोचनस्तव चैद्येन घटामुपेयुषः । यदुपुङ्गव बन्धुसौहृदात्त्वयि पाता ससुरो नवासवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20007078,
    "chapter_id": 6646,
    "verse_number": "16.13",
    "content_sanskrit": "चलितानकदुन्दुभिः पुरः सबलस्त्वं सह सारणेन तम् । समितौ रभसादुपागतः सगदः संप्रतिपत्तुमर्हसि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20007079,
    "chapter_id": 6646,
    "verse_number": "16.14",
    "content_sanskrit": "समरेषु रिपून्विनिघ्नता शिशुपालेन समेत्य संप्रति । सुचिरं सह सर्वसात्वतैर्भव विश्वस्तविलासिनीजनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20007080,
    "chapter_id": 6646,
    "verse_number": "16.15",
    "content_sanskrit": "विजितक्रुधमीक्षतामसौ महतां त्वामहितं महीभृताम् । असकृज्जितसंयतं पुरो मुदितः सप्रमदं महीपतिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20007081,
    "chapter_id": 6646,
    "verse_number": "16.16",
    "content_sanskrit": "इति जोषमवस्थितं द्विषः प्रणिधिं गामभिधाय सात्यकिः । वदति स्म वचोऽथ चोदितश्चलितैकभ्रू रथाङ्गपाणिना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20007082,
    "chapter_id": 6646,
    "verse_number": "16.17",
    "content_sanskrit": "मधुरं बहिरन्तरप्रियं कृतिनावाचि वचस्तथा त्वया । सकलार्थतया विभाव्यते प्रियमन्तर्बहिरप्रियं यथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20007083,
    "chapter_id": 6646,
    "verse_number": "16.18",
    "content_sanskrit": "अतिकोमलमेकतोन्यतः सरसाम्भोरुहवृन्तकर्कशम् । वहति स्फुटमेकमेव ते वचनं शाकपलाशदेश्यताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20007084,
    "chapter_id": 6646,
    "verse_number": "16.19",
    "content_sanskrit": "प्रकटं मृदु नाम जल्पतः परुषं सूचयतोर्थमन्तरा । शकुनादिव मार्गवर्तिभिः परुषादुद्विजितव्यमीदृशात् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20007085,
    "chapter_id": 6646,
    "verse_number": "16.20",
    "content_sanskrit": "हरिमर्चितवान्महीपतिर्यदि राज्ञस्तव कोऽत्र मत्सरः । न्यसनाय ससौरभस्य कस्तरुसूनस्य शिरस्यसूयति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20007086,
    "chapter_id": 6646,
    "verse_number": "16.21",
    "content_sanskrit": "सुकुमारमहो लघीयसां हृदयं तद्गतमप्रियं यतः । सहसैव समुद्गिरन्त्यमी जरयन्त्येव हि तन्मनीषिणः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20007087,
    "chapter_id": 6646,
    "verse_number": "16.22",
    "content_sanskrit": "उपकारपरः स्वभावतः सततं सर्वजनस्य सज्जनः । असतामनिशं तथाप्यहो गुरुहृद्रोगकरी तदुन्नतिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20007088,
    "chapter_id": 6646,
    "verse_number": "16.23",
    "content_sanskrit": "परितप्यत एव नोत्तमः परितप्तोऽप्यपरः सुसंवृतिः । परवृद्धिभिराहितव्यथः स्फुटनिर्भिन्नदुराशयोऽधमः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20007089,
    "chapter_id": 6646,
    "verse_number": "16.24",
    "content_sanskrit": "अनिराकृततापसंपदं फलहीनां सुमनोभिरुज्झिताम् । खलतां खलतामिवासतीं प्रतिपद्येत कथं बुधो जनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20007090,
    "chapter_id": 6646,
    "verse_number": "16.25",
    "content_sanskrit": "प्रतिवाचमदत्त केशवः शपमानाय न चेदिभूभुजे । अनुहुङ्कुरुते घनध्वनिं न हि गोमायुरुतानि केसरी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20007091,
    "chapter_id": 6646,
    "verse_number": "16.26",
    "content_sanskrit": "जितरोषरया महाधियः सपदि क्रोधजितो लघुर्जनः । विजितेन जितस्य दुर्मतेर्मतिमद्भिः सह का विरोधिता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20007092,
    "chapter_id": 6646,
    "verse_number": "16.27",
    "content_sanskrit": "वचनैरसतां महीयसो न खलु व्येति गुरुत्वमुद्धतैः । किमपैति रजोभिरौर्वरैरवकीर्णस्य मणेर्महार्घता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20007093,
    "chapter_id": 6646,
    "verse_number": "16.28",
    "content_sanskrit": "परितोषयिता न कश्चन स्वगतो यस्य गुणोऽस्ति देहिनः । परदोषकथाभिरल्पकः स्वजनं तोषयितुं किलेच्छति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20007094,
    "chapter_id": 6646,
    "verse_number": "16.29",
    "content_sanskrit": "सहजान्धदृशः स्वदुर्नये परदोषेक्षणदिव्यचक्षुषः । स्वगुणोच्चगिरो मुनिव्रताः परवर्णग्रहणेष्वसाधवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20007095,
    "chapter_id": 6646,
    "verse_number": "16.30",
    "content_sanskrit": "प्रकटान्यपि नैपुणं महत्परवाच्यानि चिराय गोपितुम् । विवरीतुमथात्मनो गुणान्भृशमाकौशलमार्यचेतसाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20007096,
    "chapter_id": 6646,
    "verse_number": "16.31",
    "content_sanskrit": "किमिवाखिललोककीर्तितं कथयत्यात्मगुणं महामनाः । वदिता न लघीयसोऽपरः स्वगुणं तेन वदत्यसौ स्वयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20007097,
    "chapter_id": 6646,
    "verse_number": "16.32",
    "content_sanskrit": "विसृजन्त्यविकत्थिनः परे विषमाशीविषवन्नराः क्रुधम् । दधतोऽन्तरसाररूपतां ध्वनिसाराः पटहा इवेतरे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20007098,
    "chapter_id": 6646,
    "verse_number": "16.33",
    "content_sanskrit": "नरकच्छिदमिच्छतीक्षितुं विधिना येन स चेदिभूपतिः । द्रुतमेतु न हापयिष्यते सदृशं तस्य विधातुमुत्तरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20007099,
    "chapter_id": 6646,
    "verse_number": "16.34",
    "content_sanskrit": "समनद्ध किमङ्ग भूपतिर्यदि संधित्सुरसौ सहामुना । हरिराक्रमणेन संनति किल विभ्रति भियेत्यसंभवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20007100,
    "chapter_id": 6646,
    "verse_number": "16.35",
    "content_sanskrit": "महतस्तरसा विलङ्घयन्निजदोषेण कुधीर्विनश्यति । कुरुते न खलु स्वयेच्छया शलभानिन्धनमिद्धदीधितिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20007101,
    "chapter_id": 6646,
    "verse_number": "16.36",
    "content_sanskrit": "यदपूरि पुरा महीपतिर्न मुखेन स्वयमगसा शतम् । अथ संप्रति पर्यपूपुरत्तदसौ दूतमुखेन शार्ङ्गिणः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20007102,
    "chapter_id": 6646,
    "verse_number": "16.37",
    "content_sanskrit": "यदनर्गलगोपुराननस्त्वमितो वक्ष्यसि किञ्चिदप्रियम् । विवरिष्यति तच्चिरस्य नः समयोद्वीक्षणरक्षितां क्रुधम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20007103,
    "chapter_id": 6646,
    "verse_number": "16.38",
    "content_sanskrit": "निशम्य तदूर्जितं शिनेर्वचनं नप्तुरनाप्तुरेनसाम् । पुनरुज्झितसाध्वसो द्विषामभिधत्ते स्म वचो वचोहरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20007104,
    "chapter_id": 6646,
    "verse_number": "16.39",
    "content_sanskrit": "विविनक्ति न बुद्धिदुर्विधः स्वयमेव स्वहितं पृथग्जनः । यदुदीरितमप्यदः परैर्न विजानाति तदद्भुतं महत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20007105,
    "chapter_id": 6646,
    "verse_number": "16.40",
    "content_sanskrit": "विदुरेष्यदपायमात्मना परतः श्रद्दधतेऽथवा बुधाः । न परोपहितं न च स्वतः प्रमिमीतेऽनुभवादृतेऽल्पधीः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20007106,
    "chapter_id": 6646,
    "verse_number": "16.41",
    "content_sanskrit": "कुशलं खलु तुभ्यमेव तद्वचनं कृष्ण यदभ्यधामहम् । उपदेशपराः परेष्वपि स्वविनाशाभिमुखेषु साधवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20007107,
    "chapter_id": 6646,
    "verse_number": "16.42",
    "content_sanskrit": "उभयं युगपन्मयोदितं त्वरया सान्त्वमथेतरच्च ते । प्रविभज्य पृथङ्मनीषया स्वगुणं यत्किल तत्करिष्यसि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20007108,
    "chapter_id": 6646,
    "verse_number": "16.43",
    "content_sanskrit": "अथवाभिनिविष्टबुद्धिषु व्रजति व्यर्थकतां सुभाषितम् । रविरागिषु शीतरोचिषः करजालं कमलाकरेष्विव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20007109,
    "chapter_id": 6646,
    "verse_number": "16.44",
    "content_sanskrit": "अनपेक्ष्य गुणागुणौ जनः स्वरुचिं निश्चयतोनुधावति । अपहाय महीशमर्चिचत्सदति त्वां ननु भीमपूर्वजः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20007110,
    "chapter_id": 6646,
    "verse_number": "16.45",
    "content_sanskrit": "त्वयि भक्तिमता न सत्कृतः कुरुराजा गुरुरेव चेदिपः । प्रियमांसमृगाधिपोज्झितः किमवद्यः करिकुम्भजो मणिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20007111,
    "chapter_id": 6646,
    "verse_number": "16.46",
    "content_sanskrit": "क्रियते धवलः खलूच्चकैर्धवलैरेव सितेतरैरधः । शिरसौधमधत्त श्ङ्करः सुरसिन्धोर्मधुजित्तमङ्घ्रिणा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20007112,
    "chapter_id": 6646,
    "verse_number": "16.47",
    "content_sanskrit": "अबुधैः कृतमानसम्विदस्तव पार्थैः कुत एव योग्यता । सहसि प्लवगैरुपासितं न हि गुञ्जाफलमेति सोष्मताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20007113,
    "chapter_id": 6646,
    "verse_number": "16.48",
    "content_sanskrit": "अपराधशतक्षमं नृपः क्षमयात्येति भवन्तमेकया । हृतवत्यपि भीष्मकात्मजां त्वयि चक्षाम समर्थ एव यत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20007114,
    "chapter_id": 6646,
    "verse_number": "16.49",
    "content_sanskrit": "गुरुभिः प्रतिपादितां वधूमपहृत्य स्वजनस्य भूपतेः । जनकोऽसि जनार्दन स्फुटं हतधर्मार्थतया मनोभुवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20007115,
    "chapter_id": 6646,
    "verse_number": "16.50",
    "content_sanskrit": "अनिरूपिरूपसंपदस्तमसो वान्यभृतच्छदच्छवेः । तव सर्वगतस्य संप्रति क्षितिपः क्षिप्नुरभीशुमानिव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20007116,
    "chapter_id": 6646,
    "verse_number": "16.51",
    "content_sanskrit": "क्षुभितस्य महीभृतस्त्वयि प्रशमोपन्यसनं वृथा मम । प्रलयोल्लसितस्य वारिधेः परिवाहो जगतः करोति किम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20007117,
    "chapter_id": 6646,
    "verse_number": "16.52",
    "content_sanskrit": "प्रहितः प्रधनाय माधवानहमाकारयितुं महीभृता । न परेषु महौजसश्छलादपकुर्वन्ति मलिम्लुचा इव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20007118,
    "chapter_id": 6646,
    "verse_number": "16.53",
    "content_sanskrit": "तदयं समुपैति भूपतिः पयसां पूर इवानिवारितः । अविलम्बितमेधि वेतसस्तरुवन्माधव मा स्म भज्यथाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20007119,
    "chapter_id": 6646,
    "verse_number": "16.54",
    "content_sanskrit": "परिपाति स केवलं शिशूनिति तन्नामनि मा स्म विश्वसीः । तरुणानपि रक्षति क्षमी स शरण्यः शरणागतान्द्विषः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20007120,
    "chapter_id": 6646,
    "verse_number": "16.55",
    "content_sanskrit": "न विदध्युरशङ्कमप्रियं महतः स्वार्थपराः परे कथम् । भजते कुपितोऽप्युदारधीरनुनीतिं नतिमात्रकेण सः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20007121,
    "chapter_id": 6646,
    "verse_number": "16.56",
    "content_sanskrit": "हितमप्रियमिच्छसि श्रुतं यदि संधत्स्व पुरा न नश्यसि । अनृतैरथ तुष्यसि प्रियैर्जयताज्जीव भवावनीश्वरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20007122,
    "chapter_id": 6646,
    "verse_number": "16.57",
    "content_sanskrit": "प्रतिपक्षजिदप्यसंशयं युधि चैद्येन विजेष्यते भवान् । ग्रसते हि तमोपहं मुहुर्ननु राह्वाह्वमहर्पतिं तमः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20007123,
    "chapter_id": 6646,
    "verse_number": "16.58",
    "content_sanskrit": "अचिराज्जितमीनकेतनो विलसन्वृष्णिगणैर्नमस्कृतः । क्षितिपः क्षयितोद्धतान्तको हरलीलां स विडम्बयिष्यति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20007124,
    "chapter_id": 6646,
    "verse_number": "16.59",
    "content_sanskrit": "निहतोन्मददुष्टकुञ्जराद्दधतो भूरि यशः क्रमार्जितम् । न बिभेति रणे हरेरपि क्षितिपः का गणनास्य वृष्णिषु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20007125,
    "chapter_id": 6646,
    "verse_number": "16.60",
    "content_sanskrit": "न तदद्भुतमस्य यन्मुखं युधि पश्यन्ति भिया न शत्रवः । द्रवतां ननु पृष्ठमीक्षते वदनं सोऽपि न जातु विद्विषाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20007126,
    "chapter_id": 6646,
    "verse_number": "16.61",
    "content_sanskrit": "प्रतनूल्लसिताचिरद्युतः शरदं प्राप्य विखण्डितायुधाः । दधतेऽरिभिरस्य तुल्यतां यदि नासारभृतः पयोभृतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20007127,
    "chapter_id": 6646,
    "verse_number": "16.62",
    "content_sanskrit": "मलिनं रणरेणुभिर्मुहुर्द्विषतां क्षालितमङ्गनाश्रुभिः । नृपमौलिमरीचिवर्णकैरथ यस्याङ्घियुगं विलिप्यते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20007128,
    "chapter_id": 6646,
    "verse_number": "16.63",
    "content_sanskrit": "समराय निकामकर्कशं क्षणमाकृष्टमुपैति यस्य च । धनुषा सममाशु विद्विषां कुलमाशङ्कितभङ्गमानतिम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20007129,
    "chapter_id": 6646,
    "verse_number": "16.64",
    "content_sanskrit": "तुहिनांशुममुं सुहृज्जनाः कलयन्त्युष्णकरं विरोधिनः । कृतिभिः कृतदृष्टिविभ्रमाः स्रजमेके भुजगं यथापरे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20007130,
    "chapter_id": 6646,
    "verse_number": "16.65",
    "content_sanskrit": "दधतोऽसुलभक्षयागमास्तनुमेकान्तरताममानुषीम् । भुवि सम्प्रति न प्रतिष्ठिताः सदृशा यस्य सुरैररातयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20007131,
    "chapter_id": 6646,
    "verse_number": "16.66",
    "content_sanskrit": "अतिविस्मयनीयकर्मणो नृपतेर्यस्य विरोधि किञ्चन । यदुमुक्तनयो नयत्यसावहितानां कुलमक्षयं क्षयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "avatarnika": ""
  },
  {
    "id": 20007132,
    "chapter_id": 6646,
    "verse_number": "16.67",
    "content_sanskrit": "चलितोर्ध्वकबन्धसम्पदो मकरव्यूहनिरूद्धवर्त्मनः । अतरत्स्वभुजौजसा मुहुर्महतः सङ्गरसागरानसौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "avatarnika": ""
  },
  {
    "id": 20007133,
    "chapter_id": 6646,
    "verse_number": "16.68",
    "content_sanskrit": "न चिकीर्षति यः स्मयोद्धतो नृपतित्तच्चरणोपपगं शिरः । चरणं कुरुते गतस्मयः स्मसावेव तदीयमूर्धनि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "avatarnika": ""
  },
  {
    "id": 20007134,
    "chapter_id": 6646,
    "verse_number": "16.69",
    "content_sanskrit": "स्वभुजद्वयकेवलायुधश्चतुरङ्गामपहाय वाहिनीम् । बहुशः सह शक्रदन्तिना स चतुर्दन्तमगच्छदाहवम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "avatarnika": ""
  },
  {
    "id": 20007135,
    "chapter_id": 6646,
    "verse_number": "16.70",
    "content_sanskrit": "अविचालितचारुचक्रयोरनुरागादुपगूढयोः श्रिया । युवयोरिदमेव भिद्यते यदुपेन्द्रस्त्वमतीन्द्र एव सः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70,
    "avatarnika": ""
  },
  {
    "id": 20007136,
    "chapter_id": 6646,
    "verse_number": "16.71",
    "content_sanskrit": "भूतभूतिरहीनभोगभाग्विजितानेकपुरोऽपि विद्विषाम् । रुचिमिन्दुदले करोत्यजः परिपूर्णेन्दुरुचिर्महीपतिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71,
    "avatarnika": ""
  },
  {
    "id": 20007137,
    "chapter_id": 6646,
    "verse_number": "16.72",
    "content_sanskrit": "नयति द्रुतमुद्धतिश्रितः प्रसभं भङ्गमभङ्गुरोदयः । गमयत्यवनीतलस्फुरद्भुजशाखं भृशमन्यमुन्नतिम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 72,
    "avatarnika": ""
  },
  {
    "id": 20007138,
    "chapter_id": 6646,
    "verse_number": "16.73",
    "content_sanskrit": "अधिगम्य च रन्ध्रमन्तरा जनयन्मण्डलभेदमन्यतः । खनति क्षतसंहति क्षणादपि मूलानि महान्ति कस्यचित् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 73,
    "avatarnika": ""
  },
  {
    "id": 20007139,
    "chapter_id": 6646,
    "verse_number": "16.74",
    "content_sanskrit": "घनपत्रभृतोऽनुगामिनस्तरसाकृष्य करोति कांश्चन । दृढमप्यपरं प्रतिष्ठितं प्रतिकूलं नितरां निरस्यति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 74,
    "avatarnika": ""
  },
  {
    "id": 20007140,
    "chapter_id": 6646,
    "verse_number": "16.75",
    "content_sanskrit": "इति पूर इवोदकस्य यः सरितां प्रावृषिजस्तटद्रुमैः । क्वचनापि महानखण्डितप्रसरः क्रीडति भूभृतां गणैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 75,
    "avatarnika": ""
  },
  {
    "id": 20007141,
    "chapter_id": 6646,
    "verse_number": "16.76",
    "content_sanskrit": "अलघूपलपङ्क्तिशालिनीः परितो रुद्धनिरन्तराम्बराः । अधिरूढनितम्बभूमयो न विमुञ्चन्ति चिराय मेखलाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 76,
    "avatarnika": ""
  },
  {
    "id": 20007142,
    "chapter_id": 6646,
    "verse_number": "16.77",
    "content_sanskrit": "कटकानि भजन्ति चारुभिर्नवमुक्ताफलभूषणैर्भुजैः । नियतं दधते च चित्रकैरवियोगं पृथुगण्डशैलतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 77,
    "avatarnika": ""
  },
  {
    "id": 20007143,
    "chapter_id": 6646,
    "verse_number": "16.78",
    "content_sanskrit": "इतियस्य ससंपदः पुरा यदवापुर्भवनेष्वरिस्त्रियः । स्फुटमेव समस्तमापदा तदिदानीमवनीध्रमूर्धसु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 78,
    "avatarnika": ""
  },
  {
    "id": 20007144,
    "chapter_id": 6646,
    "verse_number": "16.79",
    "content_sanskrit": "महतः कुकुरान्धकद्रुमानतिमात्रं दववद्दहन्नपि । अतिचित्रमिदं महीपतिर्यदकृष्णामवनीं करिष्यति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 79,
    "avatarnika": ""
  },
  {
    "id": 20007145,
    "chapter_id": 6646,
    "verse_number": "16.80",
    "content_sanskrit": "परितः प्रमिताक्षरापि सर्वं विषयं व्याप्तवती गता प्रतिष्ठाम् । न खलु प्रतिहन्यते कुतश्चित्परिभाषेव गरीयसी यदाज्ञा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 80,
    "avatarnika": ""
  },
  {
    "id": 20007146,
    "chapter_id": 6646,
    "verse_number": "16.81",
    "content_sanskrit": "यामूढवानूढवराहमूर्तिर्मुहूर्तमादौ पुरुषः पुराणः । तेनोह्यते सांप्रतमक्षतैव क्षतारिणा सम्यगसौ पुनर्भूः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 81,
    "avatarnika": ""
  },
  {
    "id": 20007147,
    "chapter_id": 6646,
    "verse_number": "16.82",
    "content_sanskrit": "भूयांस क्वचिदपि काममस्खलन्तस्तुङ्गत्वं दधति च यद्यपि द्वयेऽपि । कल्लोलाः सलिलनिधेरवाप्य पारं शीर्यन्ते न गुणमहोर्मयस्तदीयाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 82,
    "avatarnika": ""
  },
  {
    "id": 20007148,
    "chapter_id": 6646,
    "verse_number": "16.83",
    "content_sanskrit": "लोकालोकव्याहतं घर्मरश्मेः शालीनं वा धाम नालं प्रसर्तुम् । लोकस्याग्रे पश्यतो धृष्टमाशु क्रामत्युच्चैर्भूभृतो यस्य तेजः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 83,
    "avatarnika": ""
  },
  {
    "id": 20007149,
    "chapter_id": 6646,
    "verse_number": "16.84",
    "content_sanskrit": "विच्छित्तिर्नवचन्दनेन वपुषो भिन्नोऽधरोऽलक्तकैरच्छाच्छे पतिताञ्जने च नयने श्रोण्योऽलसन्मेखलाः । प्राप्तो मौक्तिकहारमुन्नतकुचाभोगस्तदीयद्विषामित्थं नित्यविभूषणा युवतयः संपत्सु चापत्स्वपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 84,
    "avatarnika": ""
  },
  {
    "id": 20007150,
    "chapter_id": 6646,
    "verse_number": "16.85",
    "content_sanskrit": "विनिहत्य भवन्तमूर्जितश्रीयुधि सद्यः शिशुपालतां यथार्थाम् । रुदतां भवदङ्गनागणानाङ्करुणान्तःकरणः करिष्यतेऽसौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
