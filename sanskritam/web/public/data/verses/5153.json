[{"id": 2195248, "chapter_id": 5153, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2195249, "chapter_id": 5153, "verse_number": "१", "content_sanskrit": "श्रूयतां पार्थ तत्त्वेन विश्वामित्रो यथा पुरा ।\nब्राह्मणत्वं गतस्तात राजर्षित्वं तथैव च\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2195250, "chapter_id": 5153, "verse_number": "२", "content_sanskrit": "भरतस्यान्वये चैवाजमीढो नाम पार्थिवः ।\nबभूव भरतश्रेष्ठ यज्वा धर्मभृतां वरः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2195251, "chapter_id": 5153, "verse_number": "३", "content_sanskrit": "तस्य पुत्रो महानासीज्जह्नुर्नाम जनेश्वरः ।\nदुहितृत्वमनुप्राप्ता गङ्गा यस्य महात्मनः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2195252, "chapter_id": 5153, "verse_number": "४", "content_sanskrit": "तस्यात्मजस्तुल्यगुणः सिन्धुद्वीपो महायशाः ।\nसिन्धुद्वीपाच्च राजर्षिर्विपाशाशो महाबलः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2195253, "chapter_id": 5153, "verse_number": "५", "content_sanskrit": "पल्लवस्तस्य तनयः साक्षाद् धर्म इवापरः ।\nकुशिकस्तस्य तनयः सहस्राक्षसमद्युतिः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2195254, "chapter_id": 5153, "verse_number": "६", "content_sanskrit": "कुशिकस्यात्मजः श्रीमान् गाधिर्नाम जनेश्वरः ।\nअपुत्रः स महाबाहुर्वनवासमुदावसत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2195255, "chapter_id": 5153, "verse_number": "७", "content_sanskrit": "कन्या जज्ञे शुभात् तस्य वने निवसतः सतः ।\nनाम्ना सत्यवती नाम रूपेणाप्रतिमा भुवि\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2195256, "chapter_id": 5153, "verse_number": "८", "content_sanskrit": "तां वव्रे भार्गवः श्रीमांश्च्यवनस्यात्मजः प्रभुः ।\nऋचीक इति विख्यातो विपुले तपसि स्थितः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2195257, "chapter_id": 5153, "verse_number": "९", "content_sanskrit": "स तां न प्रददौ तस्मै ऋचीकाय महात्मने ।\nदरिद्र इति मत्वा वै गाधिः शत्रुनिबर्हणः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2195258, "chapter_id": 5153, "verse_number": "१०", "content_sanskrit": "प्रत्याख्याय पुनर्यान्तमब्रवीद् राजसत्तमः ।\nशुल्कं प्रदीयतां ब्रह्मन् ततो वेत्स्यसि मे सुताम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2195259, "chapter_id": 5153, "verse_number": "", "content_sanskrit": "ऋचीकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2195260, "chapter_id": 5153, "verse_number": "११", "content_sanskrit": "किं प्रयच्छामि राजेन्द्र तुभ्यं शुल्कमहं नृप ।\nदुहितुर्ब्रूह्यसंसक्तो माऽत्राभूत् ते विचारणा\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2195261, "chapter_id": 5153, "verse_number": "", "content_sanskrit": "गाधिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2195262, "chapter_id": 5153, "verse_number": "१२", "content_sanskrit": "चन्द्ररश्मिप्रकाशानां हयानां वातरंहसाम् ।\nएकतः श्यामकर्णानां सहस्रं देहि भार्गव\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2195263, "chapter_id": 5153, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2195264, "chapter_id": 5153, "verse_number": "१३", "content_sanskrit": "ततः स भृगुशार्दूलश्च्यवनस्यात्मजः प्रभुः ।\nअब्रवीद् वरुणं देवमादित्यं पतिमम्भसाम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2195265, "chapter_id": 5153, "verse_number": "१४", "content_sanskrit": "एकतः श्यामकर्णानां हयानां चन्द्रवर्चसाम् ।\nसहस्रं वातवेगानां भिक्षे त्वां देवसत्तम\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2195266, "chapter_id": 5153, "verse_number": "१५", "content_sanskrit": "तथेति वरुणो देव आदित्यो भृगुसत्तमम् ।\nउवाच यत्र ते छन्दस्तत्रोत्थास्यन्ति वाजिनः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2195267, "chapter_id": 5153, "verse_number": "१६", "content_sanskrit": "ध्यातमात्रे ऋचीकेन हयानां चन्द्रवर्चसाम् ।\nगङ्गाजलात् समुत्तस्थौ सहस्रं विपुलौजसाम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2195268, "chapter_id": 5153, "verse_number": "१७", "content_sanskrit": "अदूरे कन्यकुब्जस्य गङ्गायास्तीरमुत्तमम् ।\nअश्वतीर्थं तदद्यापि मानवाः परिचक्षते\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2195269, "chapter_id": 5153, "verse_number": "१८", "content_sanskrit": "तत् तदा गाधये तात सहस्रं वाजिनां शुभम् ।\nऋचीकः प्रददौ प्रीतः शुल्कार्थं जपतां वरः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2195270, "chapter_id": 5153, "verse_number": "१९", "content_sanskrit": "ततः स विस्मितो राजा गाधिः शापभयेन च ।\nददौ तां समलङ्कृत्य कन्यां भृगुसुताय वै\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2195271, "chapter_id": 5153, "verse_number": "२०", "content_sanskrit": "जग्राह पाणिं विधिना तस्या ब्रह्मर्षिसत्तमः ।\nसा च तं पतिमासाद्य परं हर्षमवाप ह\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2195272, "chapter_id": 5153, "verse_number": "२१", "content_sanskrit": "स तुतोष च विप्रर्षिस्तस्या वृत्तेन भारत ।\nछन्दयामास चैवैनां वरेण वरवर्णिनीम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2195273, "chapter_id": 5153, "verse_number": "२२", "content_sanskrit": "मात्रे तत्सर्वमाचख्यौ सा कन्या राजसत्तमम् ।\nअथ तामब्रवीद् माता सुतां किञ्चिदवाङ्मुखीम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2195274, "chapter_id": 5153, "verse_number": "२३", "content_sanskrit": "ममापि पुत्रि भर्ता ते प्रसादं कर्तुमर्हति ।\nअपत्यस्य प्रदानेन समर्थः स महातपाः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2195275, "chapter_id": 5153, "verse_number": "२४", "content_sanskrit": "ततः सा त्वरितं गत्वा तत्सर्वं प्रत्यवेदयत् ।\nमातुश्चिकीर्षितं राजन् ऋचीकस्तामथाब्रवीत्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2195276, "chapter_id": 5153, "verse_number": "२५", "content_sanskrit": "गुणवन्तमपत्यं वै त्वं च सा जनयिष्यथः ।\nजनन्यास्तव कल्याणि मा भूद्वै प्रणयोऽन्यथा\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2195277, "chapter_id": 5153, "verse_number": "२६", "content_sanskrit": "तव चैव गुणश्लाघी पुत्र उत्पत्स्यते शुभे ।\nअस्मद्वंशकरः श्रीमांस्तव मातुश्च वंशकृत्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2195278, "chapter_id": 5153, "verse_number": "२७", "content_sanskrit": "ऋतुस्नाता च साऽश्वत्थं त्वं च वृक्षमुदुम्बरम् ।\nपरिष्वजेथाः कल्याणि तत इष्टमवाप्स्यथः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2195279, "chapter_id": 5153, "verse_number": "२८", "content_sanskrit": "चरुद्वयमिदं चैव मन्त्रयुक्तं शुचिस्मिते ।\nत्वं च सा चोपयुञ्जीथां ततः पुत्राववाप्स्यथः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2195280, "chapter_id": 5153, "verse_number": "२९", "content_sanskrit": "ततः सत्यवती हृष्टा मातरं प्रत्यभाषत ।\nयद् ऋचीकेन कथितं तच्चाचख्यौ चरुद्वयम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2195281, "chapter_id": 5153, "verse_number": "३०", "content_sanskrit": "तामुवाच ततो माता सुतां सत्यवतीं तदा ।\nपुत्रि मूर्ध्ना प्रपन्नायाः कुरुष्व वचनं मम\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2195282, "chapter_id": 5153, "verse_number": "३१", "content_sanskrit": "भर्त्रा य एष दत्तस्ते चरुर्मन्त्रपुरस्कृतः ।\nएतं प्रयच्छ मह्यं त्वं मदीयं त्वं गृहाण च\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2195283, "chapter_id": 5153, "verse_number": "३२", "content_sanskrit": "व्यत्यासं वृक्षयोश्चापि करवाव शुचिस्मिते ।\nयदि प्रमाणं वचनं मम मातुरनिन्दिते ।\nस्वमपत्यं विशिष्टं हि सर्व इच्छत्यनाविलम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2195284, "chapter_id": 5153, "verse_number": "३३", "content_sanskrit": "व्यक्तं भगवता चात्र कृतमेवं भविष्यति ।\nततो मे त्वच्चरौ भावः पादपे च सुमध्यमे ।\nकथं विशिष्टो भ्राता ते भवेदित्येव चिन्तय\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2195285, "chapter_id": 5153, "verse_number": "३४", "content_sanskrit": "तथा च कृतवत्यौ ते माता सत्यवती च सा ।\nअथ गर्भावनुप्राप्ते उभे ते वै युधिष्ठिर\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2195286, "chapter_id": 5153, "verse_number": "३५", "content_sanskrit": "दृष्ट्वा गर्भमनुप्राप्तां भार्यां स च महानृषिः ।\nउवाच तां सत्यवतीं दुर्मना भृगुसत्तमः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2195287, "chapter_id": 5153, "verse_number": "३६", "content_sanskrit": "व्यत्यासेनोपयुक्तस्ते चरुर्व्यक्तं भविष्यति ।\nव्यत्यासः पादपे चापि सुव्यक्तं ते कृतः शुभे\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2195288, "chapter_id": 5153, "verse_number": "३७", "content_sanskrit": "मया हि विधिवद् ब्रह्म त्वच्चरौ सन्निवेशितम् ।\nक्षत्रवीर्यं च सकलं चरौ तस्या निवेशितम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2195289, "chapter_id": 5153, "verse_number": "३८", "content_sanskrit": "त्रिलोकविख्यातगुणं त्वं विप्रं जनयिष्यसि ।\nसा च क्षत्रं विशिष्टं वै तत एतत् कृतं मया\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2195290, "chapter_id": 5153, "verse_number": "३९", "content_sanskrit": "व्यत्यासस्तु कृतो यस्मात् त्वया मात्रा तथैव च ।\nतस्मात् सा ब्राह्मणश्रेष्ठं माता ते जनयिष्यति\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2195291, "chapter_id": 5153, "verse_number": "४०", "content_sanskrit": "क्षत्रियं तूग्रकर्माणं त्वं भद्रे जनयिष्यसि ।\nन हि ते तत्कृतं साधु मातृस्नेहेन भामिनि\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2195292, "chapter_id": 5153, "verse_number": "४१", "content_sanskrit": "सा श्रुत्वा शोकसन्तप्ता पपात वरवर्णिनी ।\nभूमौ सत्यवती राजंश्छिन्नेव रुचिरा लता\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2195293, "chapter_id": 5153, "verse_number": "४२", "content_sanskrit": "प्रतिलभ्य च सा सञ्ज्ञां शिरसा प्रणिपत्य च ।\nउवाच भार्या भर्तारं गाधेयी ब्राह्मणर्षभम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2195294, "chapter_id": 5153, "verse_number": "४३", "content_sanskrit": "प्रसादयन्त्यां भार्यायां मयि ब्रह्मविदांवर ।\nप्रसादं कुरु विप्रर्षे न मे स्यात् क्षत्रियः सुतः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2195295, "chapter_id": 5153, "verse_number": "४४", "content_sanskrit": "कामं ममोग्रकर्मा वै पौत्रो भवितुमर्हति ।\nन तु मे स्यात् सुतो ब्रह्मन्नेष मे दीयतां वरः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2195296, "chapter_id": 5153, "verse_number": "४५", "content_sanskrit": "एवमस्त्विति होवाच स्वां भार्यां सुमहातपाः ।\nततः सा जनयामास जमदग्निं सुतं शुभम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2195297, "chapter_id": 5153, "verse_number": "४६", "content_sanskrit": "विश्वामित्रं चाजनयद् गाधेर्भार्या यशस्विनी ।\nऋषेः प्रभावाद् राजेन्द्र ब्रह्मर्षिं ब्रह्मवादिनम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2195298, "chapter_id": 5153, "verse_number": "४७", "content_sanskrit": "ततो ब्राह्मणतां यातो विश्वामित्रो महातपाः ।\nक्षत्रियः सोऽपि हि तथा ब्रह्मवंशस्य कारकः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2195299, "chapter_id": 5153, "verse_number": "४८", "content_sanskrit": "तस्य पुत्रा महात्मानो ब्रह्मवंशविवर्धनाः ।\nतपस्विनो ब्रह्मविदो गोत्रकर्तार एव च\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2195300, "chapter_id": 5153, "verse_number": "४९", "content_sanskrit": "मधुच्छन्दश्च भगवान् देवरातश्च वीर्यवान् ।\nअक्षीणश्च शकुम्भश्च बभ्रुः कालपथस्तथा\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2195301, "chapter_id": 5153, "verse_number": "५०", "content_sanskrit": "याज्ञवल्क्यश्च विख्यातस्तथा स्थूणो महाव्रतः ।\nउलूको यमदूतश्च तथर्षिः सैन्धवायनः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2195302, "chapter_id": 5153, "verse_number": "५१", "content_sanskrit": "वल्गुजङ्घश्च भगवान् गालवश्च महानृषिः ।\nऋषिर्वज्रस्तथाख्यातः शालङ्कायन एव च\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2195303, "chapter_id": 5153, "verse_number": "५२", "content_sanskrit": "लालाट्यो नारदश्चैव तथा कूर्चमुखः स्मृतः ।\nबाष्कलिर्मुसलश्चैव रक्षोग्रीवस्तथैव च\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2195304, "chapter_id": 5153, "verse_number": "५३", "content_sanskrit": "अङ्घ्रिको नैकभृच्चैव शिलायूपः सितः शुचिः ।\nचक्रको मारुतन्तव्यो वातघ्नोऽथाश्वलायनः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2195305, "chapter_id": 5153, "verse_number": "५४", "content_sanskrit": "श्यामायनोऽथ गार्ग्यश्च जाबालिः सुश्रुतस्तथा ।\nकारीषिरथ संश्रुत्यः परपौरवतक्षकः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2195306, "chapter_id": 5153, "verse_number": "५५", "content_sanskrit": "महानृषिश्च कपिलस्तथर्षिस्तारकायनः ।\nतथैव चोपगहनस्तथर्षिश्चार्जुनायनः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2195307, "chapter_id": 5153, "verse_number": "५६", "content_sanskrit": "मार्गमित्रिर्हिरण्याक्षो जङ्घारिर्बभ्रुवाहनः ।\nउज्जयो निरदापेक्षी नारदी च महानृषिः ।\nविश्वामित्रात्मजाः सर्वे मुनयो ब्रह्मवादिनः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2195308, "chapter_id": 5153, "verse_number": "५७", "content_sanskrit": "तन्नैष क्षत्रियो राजन् विश्वामित्रो महातपाः ।\nऋचीकेनाहितं ब्रह्म परमेतद् युधिष्ठिर\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2195309, "chapter_id": 5153, "verse_number": "५८", "content_sanskrit": "एतत् ते सर्वमाख्यातं तत्त्वेन भरतर्षभ ।\nविश्वामित्रस्य वै जन्म सोमसूर्याग्नितेजसः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2195310, "chapter_id": 5153, "verse_number": "५९", "content_sanskrit": "यत्र यत्र च सन्देहो भूयस्ते राजसत्तम ।\nतत्र तत्र च मां ब्रूहि च्छेत्तास्मि तव संशयान्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2195311, "chapter_id": 5153, "verse_number": "४", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nअनुशासनपर्वणि चतुर्थोऽध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2195312, "chapter_id": 5153, "verse_number": "", "content_sanskrit": "दानधर्मपर्वणि चतुर्थोऽध्यायः ॥४॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]