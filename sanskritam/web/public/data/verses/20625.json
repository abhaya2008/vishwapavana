[{"id": 7000625000, "chapter_id": 20625, "verse_number": "५-८४-१", "content_sanskrit": "ऋषय ऊचुः ।\nसूतसूत महाभाग रोमहर्षणनंदन ।\nकथा रम्या त्वया प्रोक्ता लोकस्यानंददायिनी ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000625001, "chapter_id": 20625, "verse_number": "५-८४-२", "content_sanskrit": "श्रीकृष्णस्य महाभाग चरितं महदद्भुतम् ।\nश्रुतं सर्वं त्वया प्रोक्तं निर्वृतिस्तेन चाभवत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000625002, "chapter_id": 20625, "verse_number": "५-८४-३", "content_sanskrit": "अहो श्रीकृष्णमाहात्म्यं भक्तानां गतिदायकम् ।\nयतस्तेन महाभाग निर्वृतिं को न चाप्नुयात् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000625003, "chapter_id": 20625, "verse_number": "५-८४-४", "content_sanskrit": "अतः पुनरपि श्रीमत्कृष्णस्य चरितं महत् ।\nश्रोतुमिच्छामहे चान्यद्व्रतदानार्हणादिकम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000625004, "chapter_id": 20625, "verse_number": "५-८४-५", "content_sanskrit": "स्नानं वापि महाभाग यथा येन कृतं पुरा ।\nतत्सर्वं विस्तराद्ब्रूहि यथा नो निर्वृतिर्भवेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000625005, "chapter_id": 20625, "verse_number": "५-८४-६", "content_sanskrit": "सूत उवाच ।\nसाधु पृष्टं द्विजश्रेष्ठा लोकानां तारणं परम् ।\nयूयं कृतार्थाः कृष्णस्य भक्त्या संपूर्णमानसाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000625006, "chapter_id": 20625, "verse_number": "५-८४-७", "content_sanskrit": "श्रीकृष्णचरितं पुण्यं साधूनां हर्षदं परम् ।\nप्रवक्ष्यामि द्विजश्रेष्ठा महदाख्यानमुत्तमम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000625007, "chapter_id": 20625, "verse_number": "५-८४-८", "content_sanskrit": "एकदा नारदो लोकान्पर्यटन्भगवत्प्रियः ।\nमथुरायामंबरीषं कृष्णाराधनतत्परम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000625008, "chapter_id": 20625, "verse_number": "५-८४-९", "content_sanskrit": "महाभागं व्रतपरं ददर्श मुनिसत्तमः ।\nस आगतं मुनिवरं सत्कृत्य मुनिसत्तमः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000625009, "chapter_id": 20625, "verse_number": "५-८४-१०", "content_sanskrit": "भवंत इव पप्रच्छ श्रद्धया हृष्टमानसः ।\nअंबरीष उवाच ।\nयन्मुने परमं ब्रह्म वेदवादिभिरुच्यते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000625010, "chapter_id": 20625, "verse_number": "५-८४-११", "content_sanskrit": "स देवः पुंडरीकाक्षः स्वयं नारायणः परः ।\nयोऽमूर्तो मूर्तिमानीशो व्यक्तोऽव्यक्तः सनातनः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000625011, "chapter_id": 20625, "verse_number": "५-८४-१२", "content_sanskrit": "सर्वभूतमयोऽचिंत्यो ध्यातव्यः स कथं हरिः ।\nयस्मिन्सर्वमिदं विश्वमोतं प्रोतं प्रतिष्ठितम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000625012, "chapter_id": 20625, "verse_number": "५-८४-१३", "content_sanskrit": "अव्यक्तमेकं परमं परमात्मेति विश्रुतम् ।\nयतो जन्मादि जगतो यो निर्माय स्वयं भुवम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000625013, "chapter_id": 20625, "verse_number": "५-८४-१४", "content_sanskrit": "ददौ तस्मै च निगमानात्मन्येव व्यवस्थितान् ।\nकथमाराध्यते सोऽयं समग्रपुरुषार्थदः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000625014, "chapter_id": 20625, "verse_number": "५-८४-१५", "content_sanskrit": "योगिनामपि दुर्गम्यस्तदेतत्कृपया वद ।\nअनाराधित गोविंदा न विदंति हितोदयम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000625015, "chapter_id": 20625, "verse_number": "५-८४-१६", "content_sanskrit": "न तपो यज्ञदानानां लभते फलमुत्तमम् ।\nअनास्वादितगोविंदपदांबुजरसश्च यः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000625016, "chapter_id": 20625, "verse_number": "५-८४-१७", "content_sanskrit": "मनोरथपथातीतं स्फीतं नाकलयेत्फलम् ।\nहरेराराधनं हित्वा दुरितौघ निवारणम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000625017, "chapter_id": 20625, "verse_number": "५-८४-१८", "content_sanskrit": "नान्यत्पश्यामि जंतूनां प्रायश्चित्तं परं मुने ।\nयद्भ्रूनर्तनवर्तिन्यः श्रूयंते सिद्धयोऽखिलाः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000625018, "chapter_id": 20625, "verse_number": "५-८४-१९", "content_sanskrit": "कथमाराध्यतेसोऽयं केशवः क्लेशनाशनः ।\nउपास्यते स भगवान्कथं नारायणो नरैः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000625019, "chapter_id": 20625, "verse_number": "५-८४-२०", "content_sanskrit": "प्रीतश्च सर्वमेतन्मे हिताय जगतो वद ।\nभक्तिप्रियोऽसौ भगवान्कया भक्त्या प्रसीदति ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000625020, "chapter_id": 20625, "verse_number": "५-८४-२१", "content_sanskrit": "कथं तस्मिन्भवेद्भक्तिः सर्वैराराध्यते कथम् ।\nवैष्णवोसि हरेस्तस्य प्रियोऽसि परमार्थवित् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000625021, "chapter_id": 20625, "verse_number": "५-८४-२२", "content_sanskrit": "तेन त्वामेव पृच्छामि ब्रह्मन्ब्रह्मविदुत्तम ।\nश्रोतारमथ वक्तारं प्रष्टारं पुरुषं हरेः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000625022, "chapter_id": 20625, "verse_number": "५-८४-२३", "content_sanskrit": "प्रश्नः पुनाति कृष्णस्य तदंघ्रिसलिलं यथा ।\nदुर्ल्लभो मानुषो देहो देहिनां क्षणभंगुरः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000625023, "chapter_id": 20625, "verse_number": "५-८४-२४", "content_sanskrit": "तत्रापि दुर्ल्लभं मन्ये वैकुंठप्रियदर्शनम् ।\nसंसारेस्मिन्क्षणार्धोऽपि सत्संगः शेवधिर्नृणाम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000625024, "chapter_id": 20625, "verse_number": "५-८४-२५", "content_sanskrit": "यस्मादवाप्यते सर्वं पुरुषार्थचतुष्टयम् ।\nभगवन्भवतो यात्रा स्वस्तये सर्वदेहिनाम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000625025, "chapter_id": 20625, "verse_number": "५-८४-२६", "content_sanskrit": "बालानां तु यथा पित्रोरुत्तमश्लोकवर्त्मनाम् ।\nभूतानां देवचरितं दुःखाय च सुखाय च ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000625026, "chapter_id": 20625, "verse_number": "५-८४-२७", "content_sanskrit": "सुखायैव हि साधूनां त्वादृशामच्युतात्मनाम् ।\nभजंति ये यथा देवान्देवा अपि तथैव तान् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000625027, "chapter_id": 20625, "verse_number": "५-८४-२८", "content_sanskrit": "छायेव कर्मसचिवाः साधवो दीनवत्सलाः ।\nतस्मात्त्वं भगवन्मह्यं वैष्णवं धर्ममादिश ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000625028, "chapter_id": 20625, "verse_number": "५-८४-२९", "content_sanskrit": "यस्योपदेशदानेन लभते वेदजं फलम् ।\nनारद उवाच ।\nसाधु पृष्टं महीपाल विष्णुभक्तिमता त्वया ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000625029, "chapter_id": 20625, "verse_number": "५-८४-३०", "content_sanskrit": "जानता परमं धर्ममेकं माधवसेवनम् ।\nयस्मिन्नाराधिते विष्णौ विश्वमाराधितं भवेत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000625030, "chapter_id": 20625, "verse_number": "५-८४-३१", "content_sanskrit": "तुष्टे चराचरं तुष्टं सर्वदेवमये हरौ ।\nयस्य स्मरणमात्रेण महापातकसंहतिः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000625031, "chapter_id": 20625, "verse_number": "५-८४-३२", "content_sanskrit": "तत्क्षणान्नाशमायाति स सेव्यो हरिरेव हि ।\nकोऽनु राजन्निंद्रियवान्मुकुंदचरणांबुजम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000625032, "chapter_id": 20625, "verse_number": "५-८४-३३", "content_sanskrit": "न भजेत्सर्वतो मृत्युरुपास्यमृषिदैवतैः ।\nश्रुतोऽनु पठितो ध्यात आदृतश्चानुमोदितः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000625033, "chapter_id": 20625, "verse_number": "५-८४-३४", "content_sanskrit": "सद्यः पुनाति सद्धर्मो वीरो विश्वद्रुहोऽपि हि ।\nयोयं कारणकार्यादि कारणस्यापि कारणम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000625034, "chapter_id": 20625, "verse_number": "५-८४-३५", "content_sanskrit": "अनन्यकारणं योगी जगज्जीवो जगन्मयः ।\nअणुर्बृहत्कृशः स्थूलो निर्गुणो गुणभृन्महान् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000625035, "chapter_id": 20625, "verse_number": "५-८४-३६", "content_sanskrit": "अजो जन्मलयातीतो ध्यातव्यः स हरिः सदा ।\nसम्यगेतद्व्यवसितं भवता पुरुषर्षभ ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000625036, "chapter_id": 20625, "verse_number": "५-८४-३७", "content_sanskrit": "यत्पृच्छसे भागवतान्धर्मांस्त्वं विश्वभावनान् ।\nप्रसंगेन सतामात्ममनः श्रुति रसायनाः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000625037, "chapter_id": 20625, "verse_number": "५-८४-३८", "content_sanskrit": "भवंति कीर्तनीयस्य कथाः कृष्णस्य निर्मलाः ।\nभावसाध्योह्ययं देवः स्वयं जानाति तद्भवान् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000625038, "chapter_id": 20625, "verse_number": "५-८४-३९", "content_sanskrit": "तथापि वक्ष्ये जगतो हिताय तव गौरवात् ।\nयदाहुः परमं ब्रह्म प्रधानपुरुषात्परम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000625039, "chapter_id": 20625, "verse_number": "५-८४-४०", "content_sanskrit": "यन्मायया ततं सर्वं सर्वं यच्छति सोऽच्युतः ।\nपुत्रान्कलत्रं दीर्घायू राज्यं स्वर्गापवर्गकम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000625040, "chapter_id": 20625, "verse_number": "५-८४-४१", "content_sanskrit": "स दद्यादीप्सितं सर्वं भक्त्या संपूजितोऽजितः ।\nकर्मणा मनसा वाचा तत्परा ये हि मानवाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000625041, "chapter_id": 20625, "verse_number": "५-८४-४२", "content_sanskrit": "तेषां व्रतानि वक्ष्यामि प्रीतये भूपसत्तम ।\nअहिंसासत्यमस्तेयं ब्रह्मचर्यमकल्पता ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000625042, "chapter_id": 20625, "verse_number": "५-८४-४३", "content_sanskrit": "एतानि मानसान्याहुर्व्रतानि हरितुष्टये ।\nएकभक्तं तथा नक्तमुपवासमयाचितम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000625043, "chapter_id": 20625, "verse_number": "५-८४-४४", "content_sanskrit": "इत्येवं कायिकं पुंसां व्रतमुक्तं नरेश्वर ।\nवेदस्याध्ययनं विष्णोः कीर्तनं सत्यभाषणम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000625044, "chapter_id": 20625, "verse_number": "५-८४-४५", "content_sanskrit": "अपैशुन्यमिदं राजन्वाचिकं व्रतमुत्तमम् ।\nचक्रायुधस्य नामानि सदा सर्वत्र कीर्तयेत् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000625045, "chapter_id": 20625, "verse_number": "५-८४-४६", "content_sanskrit": "नाशौचं कीर्तने तस्य स पवित्रकरो यतः ।\nवर्णाश्रमाचारवता पुरुषेण परः पुमान् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000625046, "chapter_id": 20625, "verse_number": "५-८४-४७", "content_sanskrit": "विष्णुराराध्यते पंथा नान्यः संतोषकारणम् ।\nपतिप्रियहिताभिश्च मनोवाक्कायसंयमैः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000625047, "chapter_id": 20625, "verse_number": "५-८४-४८", "content_sanskrit": "व्रतैराराध्यते स्त्रीभिर्वासुदेवो दयानिधिः ।\nआगमोक्तेन मार्गेण स्त्रीशूद्रैरपिपूजनम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000625048, "chapter_id": 20625, "verse_number": "५-८४-४९", "content_sanskrit": "कर्तव्यं कृष्णचंद्रस्य द्विजातिवररूपिणः ।\nत्रयोवर्णास्तु वेदोक्तमार्गाराधनतत्पराः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000625049, "chapter_id": 20625, "verse_number": "५-८४-५०", "content_sanskrit": "स्त्रीशूद्रादय एव स्युर्नाम्नाऽराधनतत्पराः ।\nन पूजनैर्न यजनैर्न व्रतैरपि माधवः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000625050, "chapter_id": 20625, "verse_number": "५-८४-५१", "content_sanskrit": "तुष्यते केवलं भक्तिप्रियोऽसौ समुदाहृतः ।\nस्त्रीणां पतिव्रतानां तु पतिरेव हि दैवतम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000625051, "chapter_id": 20625, "verse_number": "५-८४-५२", "content_sanskrit": "स तु पूज्यो विष्णुभक्त्या मनोवाक्कायकर्मभिः ।\nकर्तव्यं श्रद्धया विष्णोश्चिंतयित्वा पतिं हृदि ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000625052, "chapter_id": 20625, "verse_number": "५-८४-५३", "content_sanskrit": "शूद्राणां चैव भवति नाम्ना वै देवतार्चनम् ।\nसर्वेऽप्यागममार्गेण कुर्युर्वेदानुकारिणा ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000625053, "chapter_id": 20625, "verse_number": "५-८४-५४", "content_sanskrit": "स्त्रीणामप्यधिकारोऽस्ति विष्णोराराधनादिषु ।\nपतिप्रियरतानां च श्रुतिरेषा सनातनी ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000625054, "chapter_id": 20625, "verse_number": "५-८४-५५", "content_sanskrit": "स्वकुलोचितधर्मेण यद्यस्य विहितं व्रतम् ।\nतत्तदेवाचरेद्यस्तु तेन तुष्यति केशवः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000625055, "chapter_id": 20625, "verse_number": "५-८४-५६", "content_sanskrit": "हविषाग्नौ जले पुष्पैर्ध्यानेन हृदये हरिम् ।\nयजंति सूरयो नित्यं जपेन रविमंडले ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000625056, "chapter_id": 20625, "verse_number": "५-८४-५७", "content_sanskrit": "अहिंसा प्रथमं पुष्पं द्वितीयं करणग्रहः ।\nतृतीयकं भूतदया चतुर्थं क्षांतिरेव च ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000625057, "chapter_id": 20625, "verse_number": "५-८४-५८", "content_sanskrit": "शमस्तु पंचमं पुष्पं दमः षष्ठं च सप्तमम् ।\nध्यानं सत्यं चाष्टमं च ह्येतैस्तुष्यति केशवः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000625058, "chapter_id": 20625, "verse_number": "५-८४-५९", "content_sanskrit": "एतैरेवाष्टभिः पुष्पैस्तुष्यत्येवार्चितो हरिः ।\nपुष्पांतराणि संत्येव बाह्यानि मनुजोत्तम ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000625059, "chapter_id": 20625, "verse_number": "५-८४-६०", "content_sanskrit": "भक्त्या कृतानि यैर्विष्णुः पूजितः परितुष्यति ।\nवारुणं सलिलं पुष्पं सौम्यं घृतपयोदधि ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000625060, "chapter_id": 20625, "verse_number": "५-८४-६१", "content_sanskrit": "प्राजापत्यं तथान्नादि आग्नेयं धूपदीपकम् ।\nफलपुष्पादिकं चैव वानस्पत्यं तु पंचमम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000625061, "chapter_id": 20625, "verse_number": "५-८४-६२", "content_sanskrit": "पार्थिवं कुशमूलाद्यं वायव्यं गंधचंदनम् ।\nश्रद्धाख्यं विष्णुपुष्पं च वाद्यं विष्णुपदं स्मृतम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000625062, "chapter_id": 20625, "verse_number": "५-८४-६३", "content_sanskrit": "एभिस्तुपूजितः पुष्पैरपि विष्णुः प्रसीदति ।\nसूर्योऽग्निर्ब्राह्मणोगावो वैष्णवः खं मरुज्जलम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000625063, "chapter_id": 20625, "verse_number": "५-८४-६४", "content_sanskrit": "भूरात्मा सर्वभूतानि पूजास्थानानि वा हरेः ।\nसूर्य्ये तु मंत्रजाप्येन हविषाग्नौ यजेत्ततः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000625064, "chapter_id": 20625, "verse_number": "५-८४-६५", "content_sanskrit": "आतिथ्येन तु विप्राग्र्ये गोषु ग्रासरसादिना ।\nवैष्णवे बंधुसत्कृत्या हृदये ध्याननिष्ठया ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000625065, "chapter_id": 20625, "verse_number": "५-८४-६६", "content_sanskrit": "वायौ मुख्यधिया तोये द्रव्यैस्तोयपुरस्कृतैः ।\nस्थंडिले मंत्रहृदयैर्भोगैरात्मानमात्मनि ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000625066, "chapter_id": 20625, "verse_number": "५-८४-६७", "content_sanskrit": "क्षेत्रज्ञं सर्वभूतेषु समत्वेनार्चयेद्विभुम् ।\nधिष्ण्येष्वेतेषु तद्रूपं शंखचक्रगदांबुजैः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000625067, "chapter_id": 20625, "verse_number": "५-८४-६८", "content_sanskrit": "युक्तं चतुर्भुजं शांतं ध्यायन्नर्च्चेत्समाहितः ।\nब्राह्मणैः पूजितैरेव पूजितोऽयं न संशयः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000625068, "chapter_id": 20625, "verse_number": "५-८४-६९", "content_sanskrit": "निर्भर्त्सितैश्च तैर्भूप भवेन्निर्भर्त्सितो विभुः ।\nनिगमो धर्मशास्त्रं च यदाधारे प्रवर्तते ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000625069, "chapter_id": 20625, "verse_number": "५-८४-७०", "content_sanskrit": "विप्रास्ते वैष्णवीमूर्तिः पावनी परमा मता ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000625070, "chapter_id": 20625, "verse_number": "५-८४-७१", "content_sanskrit": "सर्वं शुभं जगति धर्मत एव लभ्यं धर्मो गतिर्निगमतो नृपधर्मशास्त्रात् ।\nनूनं तयोरपि गतिर्भुवि भूमिदेवास्तैरर्चितैरिह जगत्पतिरर्चितः स्यात् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000625071, "chapter_id": 20625, "verse_number": "५-८४-७२", "content_sanskrit": "न यज्ञयोगैर्न तपोभिरन्यैर्न योगयुक्त्या न समर्चनेन ।\nतथा विभुस्तुष्यति देवदेवो यथा मही दैवततोषणेन ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000625072, "chapter_id": 20625, "verse_number": "५-८४-७३", "content_sanskrit": "ब्रह्मण्यो ब्रह्मविद्ब्रह्मा ब्रह्मवेदप्रवर्तकः ।\nब्राह्मणैरेव तुष्येत तोषितं ब्रह्मदैवतम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000625073, "chapter_id": 20625, "verse_number": "५-८४-७४", "content_sanskrit": "नरकेऽपि चिरं मग्नाः पूर्वजा ये कुलद्वये ।\nतदैव यांति ते स्वर्गं यदार्च्चति सुतो हरिम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000625074, "chapter_id": 20625, "verse_number": "५-८४-७५", "content_sanskrit": "किं तेषां जीवितेनेह पशुवच्चेष्टितेन किम् ।\nयेषां न प्रवणं चित्तं वासुदेवे जगन्मये ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000625075, "chapter_id": 20625, "verse_number": "५-८४-७६", "content_sanskrit": "ध्यानं तस्य प्रवक्ष्यामि यन्न दृष्टं तु केनचित् ।\nश्रूयतां भूपकैवल्यं केवलं मलवर्जितम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000625076, "chapter_id": 20625, "verse_number": "५-८४-७७", "content_sanskrit": "यथा दीपो निवातस्थो निश्चलो वायुवर्जितः ।\nप्रज्वलन्नाशयेत्सर्वमंधकारं महामते ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000625077, "chapter_id": 20625, "verse_number": "५-८४-७८", "content_sanskrit": "तद्वद्दोषविहीनात्मा भवत्येव निरामयः ।\nनिराशो निश्चलो वीरोनमित्रं न रिपुस्तथा ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000625078, "chapter_id": 20625, "verse_number": "५-८४-७९", "content_sanskrit": "शोकहर्षौ विषादश्च न लोभो मत्सरो भ्रमः ।\nसंभ्रमालापमोहैश्च सुखदुःखैर्विमुच्यते ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000625079, "chapter_id": 20625, "verse_number": "५-८४-८०", "content_sanskrit": "विषयैश्चापि सर्वैश्च इंद्रियाणां प्रमुच्यते ।\nतदा स केवलज्ञानी कैवल्यत्वं प्रजायते ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000625080, "chapter_id": 20625, "verse_number": "५-८४-८१", "content_sanskrit": "ज्वालाकर्मप्रसंगेन दीपस्तैलं प्रशोषयेत् ।\nवर्त्याधारेण राजेंद्र निर्द्वन्द्वो वायुवर्जितः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000625081, "chapter_id": 20625, "verse_number": "५-८४-८२", "content_sanskrit": "कज्जलं वमते पश्चात्तैलस्यापि महामते ।\nकृष्णा संदृश्यते रेखा दीपस्याग्रे महामते ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000625082, "chapter_id": 20625, "verse_number": "५-८४-८३", "content_sanskrit": "स्वयमाकृष्य तत्तैलं तेजसा निर्मलोभवेत् ।\nकाये चांतः स्थितस्तद्वत्कर्मतैलं प्रशोषयेत् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000625083, "chapter_id": 20625, "verse_number": "५-८४-८४", "content_sanskrit": "विषयान्कज्जलं कृत्वा प्रत्यक्षान्संप्रदर्शयेत् ।\nज्वालावन्निर्मलो भूत्वा स्वयमेव प्रकाशयेत् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000625084, "chapter_id": 20625, "verse_number": "५-८४-८५", "content_sanskrit": "क्रोधलोभादिभिः संज्ञैर्वायुभिः परिवर्जितः ।\nनिःस्पृहो निश्चलो भूत्वा तेजश्च स्वयमुज्ज्वलेत् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000625085, "chapter_id": 20625, "verse_number": "५-८४-८६", "content_sanskrit": "त्रैलोक्यं पश्यते सर्वं स्वस्थानस्थं स्वतेजसा ।\nकेवलज्ञानरूपोऽयं मया ते परिकीर्तितः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000625086, "chapter_id": 20625, "verse_number": "५-८४-८७", "content_sanskrit": "ध्यानं चैव प्रवक्ष्यामि द्विविधं तस्य चक्रिणः ।\nकेवलज्ञानरूपेण दृश्यते परचक्षुषा ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000625087, "chapter_id": 20625, "verse_number": "५-८४-८८", "content_sanskrit": "योगयुक्ता महात्मानः परमार्थपरायणाः ।\nयं न पश्यंति मुग्धास्तु सर्वज्ञं सर्वदर्शकम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000625088, "chapter_id": 20625, "verse_number": "५-८४-८९", "content_sanskrit": "हस्तपादविहीनश्च सर्वत्र परिगच्छति ।\nसर्वं गृह्णाति त्रैलोक्यं स्थावरं जंगमं पुनः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000625089, "chapter_id": 20625, "verse_number": "५-८४-९०", "content_sanskrit": "नासामुखविहीनस्तु घ्राति भक्षति भूपते ।\nअकर्णः शृणुते सर्वं सर्वसाक्षी जगत्पतिः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000625090, "chapter_id": 20625, "verse_number": "५-८४-९१", "content_sanskrit": "अरूपो रूपसंबद्धः पंचवर्गवशं गतः ।\nसर्वलोकस्य यः प्राणः पूज्यते सचराचरैः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000625091, "chapter_id": 20625, "verse_number": "५-८४-९२", "content_sanskrit": "अजिह्वो वदते सर्वं वेदशास्त्रानुगं तथा ।\nअत्वचः स्पर्शमेवापि सर्वेषामेव विंदति ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000625092, "chapter_id": 20625, "verse_number": "५-८४-९३", "content_sanskrit": "सदानंदो विविक्ताक्ष एकरूपो निराश्रयः ।\nनिर्गुणो निर्ममो व्यापी सगुणो निर्मलोऽनघः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000625093, "chapter_id": 20625, "verse_number": "५-८४-९४", "content_sanskrit": "अवश्यः सर्ववश्यात्मा सर्वदः सर्ववित्तमः ।\nतस्य माता न चैवास्ति स वै सर्वमयो विभुः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000625094, "chapter_id": 20625, "verse_number": "५-८४-९५", "content_sanskrit": "एवं सर्वमयं ध्यानं यश्च पश्यत्यनन्यधीः ।\nस याति परमं स्थानममूर्त्तममृतोपमम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000625095, "chapter_id": 20625, "verse_number": "५-८४-९६", "content_sanskrit": "द्वितीयं तु प्रवक्ष्यामि तच्छृणुष्व महामते ।\nमूर्त्ताकारं तु साकारं निराकारं निरामयम् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000625096, "chapter_id": 20625, "verse_number": "५-८४-९७", "content_sanskrit": "ब्रह्मांडं सर्वमतुलं वासितं यस्य वासनात् ।\nस तस्माद्वासुदेवस्तु प्रोच्यते नृपनंदन ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000625097, "chapter_id": 20625, "verse_number": "५-८४-९८", "content_sanskrit": "वर्षमाणस्य मेघस्य यद्भासा तस्य तद्भवेत् ।\nसूर्यतेजःप्रतीकाशं चतुर्बाहुं सुरेश्वरम् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000625098, "chapter_id": 20625, "verse_number": "५-८४-९९", "content_sanskrit": "दक्षिणे शोभते शंखो हेमरत्नविभूषितः ।\nकौमोदकी गदा तस्य महासुरविनाशिनी ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000625099, "chapter_id": 20625, "verse_number": "५-८४-१००", "content_sanskrit": "वामे च शोभते वीर हस्ते तस्य महात्मनः ।\nमहापद्मं सुगंधाढ्यं तस्य दक्षिणहस्तगम् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000625100, "chapter_id": 20625, "verse_number": "५-८४-१०१", "content_sanskrit": "शोभमानं सदैवास्ते सायुधं कमलश्रियम् ।\nकंबुग्रीवं सुवृत्तास्यं पद्मपत्रनिभेक्षणम् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000625101, "chapter_id": 20625, "verse_number": "५-८४-१०२", "content_sanskrit": "राजमानं हृषीकेशं दशनैः कुंदसंनिभैः ।\nगुडाकेशस्य यस्यास्ते अधरो विद्रुमाकृतिः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000625102, "chapter_id": 20625, "verse_number": "५-८४-१०३", "content_sanskrit": "शोभते पुंडरीकाक्षः किरीटेनापि भास्वता ।\nविशालेनापि रूपेण केशवस्तु सुवक्षसा ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7000625103, "chapter_id": 20625, "verse_number": "५-८४-१०४", "content_sanskrit": "कौस्तुभेनांकितेनैव राजमानो जनार्दनः ।\nसूर्यतेजःप्रतीकाश कुंडलाभ्यां प्रभाति च ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7000625104, "chapter_id": 20625, "verse_number": "५-८४-१०५", "content_sanskrit": "हरिः केयूरकंकणैर्हारैर्मौक्तिकैरृक्षसन्निभैः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7000625105, "chapter_id": 20625, "verse_number": "५-८४-१०६", "content_sanskrit": "वपुषा भ्राजमानस्तु विजयो जयतां वरः ।\nभ्राजतेसोऽपि गोविंदो हेमवर्णेन वाससा ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7000625106, "chapter_id": 20625, "verse_number": "५-८४-१०७", "content_sanskrit": "मुद्रिकाभिस्तु युक्ताभिरंगुलीषु विराजते ।\nसर्वायुधैः सुसंपूर्णैर्द्दिव्यैराभरणैर्हरिः ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7000625107, "chapter_id": 20625, "verse_number": "५-८४-१०८", "content_sanskrit": "वैनतेयसमारूढो लोककर्त्ता जगत्पतिः ।\nएवं यो ध्यायते नित्यमनन्यमनसा नरः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7000625108, "chapter_id": 20625, "verse_number": "५-८४-१०९", "content_sanskrit": "मुच्यते सर्वपापेभ्यो विष्णुलोकं स गच्छति ।\nएतत्ते सर्वमाख्यातं ध्यानभेदं जगत्पतेः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}]