[{"id": 6000132000, "chapter_id": 10132, "verse_number": null, "content_sanskrit": "अथ त्रयोदशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000132001, "chapter_id": 10132, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_013/BhP_06.013.001.m4a", "display_order": 2}, {"id": 6000132002, "chapter_id": 10132, "verse_number": "६-१३-१", "content_sanskrit": "वृत्रे हते त्रयो लोका विना शक्रेण भूरिद।\nसपाला ह्यभवन् सद्यो विज्वरा निर्वृतेन्द्रियाः॥ ६/१३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_013/BhP_06.013.002.m4a", "display_order": 3, "topics": [{"text": "इन्द्रेण वृत्रे हते सर्वलोकानां सुखप्राप्तिः", "range": "१–२"}]}, {"id": 6000132003, "chapter_id": 10132, "verse_number": "६-१३-२", "content_sanskrit": "देवर्षिपितृभूतानि दैत्यदेवानुगाश्च ये।\nप्रतिजग्मुः स्वधिष्ण्यानि ब्रह्मेशेन्द्रादयस्ततः॥ ६/१३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_013/BhP_06.013.003.m4a", "display_order": 4}, {"id": 6000132004, "chapter_id": 10132, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_013/BhP_06.013.004.m4a", "display_order": 5}, {"id": 6000132005, "chapter_id": 10132, "verse_number": "६-१३-३", "content_sanskrit": "इन्द्रस्यानिर्वृतेर्हेतुं श्रोतुमिच्छामि भो मुने।\nयेनासन् सुखिनो देवा हरेर्दुःखं कुतोऽभवत्॥ ६/१३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_013/BhP_06.013.005.m4a", "display_order": 6, "topics": [{"text": "इन्द्रस्य तु वृत्रहत्यानिमित्तकब्रह्महत्याप्राप्तिः", "range": "३–१०"}]}, {"id": 6000132006, "chapter_id": 10132, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_013/BhP_06.013.006.m4a", "display_order": 7}, {"id": 6000132007, "chapter_id": 10132, "verse_number": "६-१३-४", "content_sanskrit": "वृत्रविक्रमसंविग्नाः सर्वे देवाः सहर्षिभिः।\nतद्वधायार्थयन्निन्द्रं नैच्छद् भीतो बृहद्वधात्॥ ६/१३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_013/BhP_06.013.007.m4a", "display_order": 8}, {"id": 6000132008, "chapter_id": 10132, "verse_number": null, "content_sanskrit": "इन्द्र उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_013/BhP_06.013.008.m4a", "display_order": 9}, {"id": 6000132009, "chapter_id": 10132, "verse_number": "६-१३-५", "content_sanskrit": "भूस्‍त्रीजलद्रुमैरेनो विश्वरूपवधोद्भवम्।\nविभक्तमनुगृह्णद्भिर्वृत्रहत्यां क्‍व मार्ज्म्यहम्॥ ६/१३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_013/BhP_06.013.009.m4a", "display_order": 10}, {"id": 6000132010, "chapter_id": 10132, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_013/BhP_06.013.010.m4a", "display_order": 11}, {"id": 6000132011, "chapter_id": 10132, "verse_number": "६-१३-६", "content_sanskrit": "ऋषयस्तदुपाकर्ण्य महेन्द्रमिदमब्रुवन्।\nमार्जयिष्याम भद्रं ते हयमेधेन मा स्म भैः॥ ६/१३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_013/BhP_06.013.011.m4a", "display_order": 12}, {"id": 6000132012, "chapter_id": 10132, "verse_number": "६-१३-७", "content_sanskrit": "हयमेधेन पुरुषं परमात्मानमीश्वरम्।\nइष्ट्वा नारायणं देवं मोक्ष्यसेऽपि जगद्वधात्॥ ६/१३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_013/BhP_06.013.012.m4a", "display_order": 13}, {"id": 6000132013, "chapter_id": 10132, "verse_number": "६-१३-८", "content_sanskrit": "ब्रह्महा पितृहा गोघ्नो मातृहाऽऽचार्यहाऽघवान्।\nश्वादः पुल्कसको वाऽपि शुध्येरन् यस्य कीर्तनात्॥ ६/१३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_013/BhP_06.013.013.m4a", "display_order": 14}, {"id": 6000132014, "chapter_id": 10132, "verse_number": "६-१३-९", "content_sanskrit": "तमश्वमेधेन महामखेन श्रद्धान्वितोऽस्माभिरनुष्ठितेन।\nहत्वाऽपि सब्रह्म चराचरं त्वं न लिप्यसे किं खलनिग्रहेण॥ ६/१३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_013/BhP_06.013.014.m4a", "display_order": 15}, {"id": 6000132015, "chapter_id": 10132, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_013/BhP_06.013.015.m4a", "display_order": 16}, {"id": 6000132016, "chapter_id": 10132, "verse_number": "६-१३-१०", "content_sanskrit": "एवं सञ्चोदितो विप्रैर्मरुत्वानहनद् रिपुम्।\nब्रह्महत्या हते तस्मिन्नाससाद वृषाकपिम्॥ ६/१३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_013/BhP_06.013.016.m4a", "display_order": 17}, {"id": 6000132017, "chapter_id": 10132, "verse_number": "६-१३-११", "content_sanskrit": "तयेन्द्रं स्म ह सन्तप्तं निर्वृतिर्नामुमाविशत्।\nह्रीमतां हत्यया तप्तं सुखयन्त्यपि नो गुणाः॥ ६/१३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_013/BhP_06.013.017.m4a", "display_order": 18, "topics": [{"text": "ब्रह्महत्याया भीत्वा इन्द्रेण इतरालक्षितस्थले गूढं निवासः", "range": "११–१५"}]}, {"id": 6000132018, "chapter_id": 10132, "verse_number": "६-१३-१२", "content_sanskrit": "तां ददर्शानुधावन्तीं चण्डालीमिव रूपिणीम्।\nजरया वेपमानाङ्गीं यक्ष्मग्रस्तामसृक्पटाम्॥ ६/१३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_013/BhP_06.013.018.m4a", "display_order": 19}, {"id": 6000132019, "chapter_id": 10132, "verse_number": "६-१३-१३", "content_sanskrit": "विकीर्य पलितान् केशांस्तिष्ठ तिष्ठेति भाषिणीम्।\nमीनगन्ध्यसुगन्धेन कुर्वतीं मार्गदूषणम्॥ ६/१३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_013/BhP_06.013.019.m4a", "display_order": 20}, {"id": 6000132020, "chapter_id": 10132, "verse_number": "६-१३-१४", "content_sanskrit": "नभोगतो दिशः सर्वाः सहस्राक्षो विशाम्पते।\nप्रागुदीचीं दिशं दृष्ट्वा प्रविष्टो नृप मानसम्॥ ६/१३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_013/BhP_06.013.020.m4a", "display_order": 21}, {"id": 6000132021, "chapter_id": 10132, "verse_number": "६-१३-१५", "content_sanskrit": "स आवसत् पुष्करनालतन्तूनलब्धभोगो यदिहाग्निदूतः।\nवर्षाणि साहस्रमलक्षितोऽन्तः सञ्चिन्तयन् ब्रह्मवधाद् विमोक्षम्॥ ६/१३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_013/BhP_06.013.021.m4a", "display_order": 22}, {"id": 6000132022, "chapter_id": 10132, "verse_number": "६-१३-१६", "content_sanskrit": "तावत् त्रिणाकं नहुषः शशास विद्यातपोयोगबलानुभावः।\nस सम्पदैश्वर्यमदान्धबुद्धिर्नीतस्तिरश्चां गतिमिन्द्रपत्न्या॥ ६/१३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_013/BhP_06.013.022.m4a", "display_order": 23, "topics": [{"text": "ब्रह्मर्षिभिर्वैष्णवेनाश्वमेधेन याजितस्येन्द्रस्य ब्रह्महत्याया विमोकः", "range": "१६–२३"}]}, {"id": 6000132023, "chapter_id": 10132, "verse_number": "६-१३-१७", "content_sanskrit": "ततो गतो ब्रह्मगिरोपहूत ऋतम्भरध्याननिवारितांहः।\nपापस्तु दिग्देवतया हतौजास्तं नाभ्यभूदवितं विष्णुपद्या॥ ६/१३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_013/BhP_06.013.023.m4a", "display_order": 24}, {"id": 6000132024, "chapter_id": 10132, "verse_number": "६-१३-१८", "content_sanskrit": "तं च ब्रह्मर्षयोऽभ्येत्य हयमेधेन भारत।\nयथावद् दीक्षयाञ्चक्रुः पुरुषाराधनेन हि॥ ६/१३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_013/BhP_06.013.024.m4a", "display_order": 25}, {"id": 6000132025, "chapter_id": 10132, "verse_number": "६-१३-१९", "content_sanskrit": "अथेज्यमाने पुरुषे सर्वभूतमयात्मनि।\nअश्वमेधे महेन्द्रेण वितते ब्रह्मवादिभिः॥ ६/१३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_013/BhP_06.013.025.m4a", "display_order": 26}, {"id": 6000132026, "chapter_id": 10132, "verse_number": "६-१३-२०", "content_sanskrit": "स वै त्वाष्ट्रवधो भूयानपि पापः परन्तप।\nनीतस्तेनैव शून्याय नीहार इव भानुना॥ ६/१३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_013/BhP_06.013.026.m4a", "display_order": 27}, {"id": 6000132027, "chapter_id": 10132, "verse_number": "६-१३-२१", "content_sanskrit": "स वाजिमेधेन यथोदितेन वितायमानेन मरीचिमिश्रैः।\nदृष्ट्वाऽपि यज्ञं पुरुषं पुराणमिन्द्रो महानास विधूतपापः॥ ६/१३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_013/BhP_06.013.027.m4a", "display_order": 28}, {"id": 6000132028, "chapter_id": 10132, "verse_number": "६-१३-२२", "content_sanskrit": "इदं महाख्यानमशेषपाप्मनां प्रक्षालनं तीर्थपदानुकीर्तनम्।\nभक्त्युच्छ्रयं भक्तजनानुवर्णनं महेन्द्रमोक्षं विजयं मरुत्वतः॥ ६/१३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_013/BhP_06.013.028.m4a", "display_order": 29}, {"id": 6000132029, "chapter_id": 10132, "verse_number": "६-१३-२३", "content_sanskrit": "पठेयुराख्यानमिदं सदा बुधाः शृण्वन्त्यथो पर्वणि पर्वणीन्द्रियम्।\nधन्यं यशस्यं निखिलाघमोचनं रिपुञ्जयं स्वस्त्ययनं यथाऽऽयुषम्॥ ६/१३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_013/BhP_06.013.029.m4a", "display_order": 30}, {"id": 6000132030, "chapter_id": 10132, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां षष्ठस्कन्धे त्रयोदशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]