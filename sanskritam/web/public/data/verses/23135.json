[{"id": 7003135000, "chapter_id": 23135, "verse_number": "४-७१-१", "content_sanskrit": "अथैकसप्ततितमोऽध्यायः ।\nनारायण उवाच ।\nराधिकायां च सुप्तायां सुप्तासु गोपिकासु ।\nपुष्पचन्दनतल्पे च वायुना सुरभीकृते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003135001, "chapter_id": 23135, "verse_number": "४-७१-२", "content_sanskrit": "तृतीयप्रहरेऽतीते निशायां च शुभे क्षणे ।\nशुभचन्द्रर्क्षयोगे चामृतयोगसमन्विते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003135002, "chapter_id": 23135, "verse_number": "४-७१-३", "content_sanskrit": "सौम्यस्वामियुते लग्ने सौम्यग्रहविलोकिते ।\nपापग्रहसमासक्तदुष्टदोषादिवर्जिते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003135003, "chapter_id": 23135, "verse_number": "४-७१-४", "content_sanskrit": "यशोदां बोधयामास कारयामास मङ्गलम् ।\nवन्धूनाश्वासयामास समुत्थाय हरिः स्वयम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003135004, "chapter_id": 23135, "verse_number": "४-७१-५", "content_sanskrit": "वाद्यं निषेधयामास राधिकाभयभीतवत् ।\nस्वतन्त्रो विश्वकर्ता च पाता भर्ता स्वतन्त्रवत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003135005, "chapter_id": 23135, "verse_number": "४-७१-६", "content_sanskrit": "प्रक्षाल्य पादयुगलं धृतवा धौते च वाससी ।\nउवास संस्कृते स्थाने विलिप्ते चन्दनादिना ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003135006, "chapter_id": 23135, "verse_number": "४-७१-७", "content_sanskrit": "फलपल्लवसंयुक्तं संस्कृतं चन्दनादिभिः ।\nवामे कृत्वा पूर्णकुम्भं वह्निं विप्रं स्वदक्षिणे ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003135007, "chapter_id": 23135, "verse_number": "४-७१-८", "content_sanskrit": "पतिपुत्रवतीं दीपं दर्पणं पुरतस्तथा ।\nदूर्वाकाण्डं च सुस्निग्धं पुष्पं धान्यं सितं शुभम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003135008, "chapter_id": 23135, "verse_number": "४-७१-९", "content_sanskrit": "गुरुदत्तं गुहीत्वा च प्रदधौ मस्तकोपरि ।\nधृतं ददर्श माध्वीकं रजतं काञ्चनं दधि ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003135009, "chapter_id": 23135, "verse_number": "४-७१-१०", "content_sanskrit": "चन्दनं लेपनं कृत्वा पुष्पमालां गले ददौ ।\nगुरुवर्गं ब्राह्मणं च वन्दयामास भक्तितः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003135010, "chapter_id": 23135, "verse_number": "४-७१-११", "content_sanskrit": "शङ्खध्वनिं वेदपाठं संगीतं मङ्गलाष्टकम् ।\nविप्रशीर्वचनं रम्यं शुश्राव परमादरम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003135011, "chapter_id": 23135, "verse_number": "४-७१-१२", "content_sanskrit": "ध्यात्वा मङ्गलरूपं च सर्वत्र मङ्गलप्रदम् ।\nचिक्षेप दक्षिणां पादं सुन्दरं स्वात्मविग्रहम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003135012, "chapter_id": 23135, "verse_number": "४-७१-१३", "content_sanskrit": "विधृत्य नासिकावामभागं मध्यमया विभुः ।\nविसृज्य वायुं संपूर्णं नासादक्षिणरन्ध्रतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003135013, "chapter_id": 23135, "verse_number": "४-७१-१४", "content_sanskrit": "ततो ययौ नन्दनन्दो नन्दस्य प्राङ्गणं वरम् ।\nसानन्दः परमानन्दो नित्यानन्दः सनातनः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003135014, "chapter_id": 23135, "verse_number": "४-७१-१५", "content_sanskrit": "नित्योऽनित्यो नित्यबीचस्वरूपो नित्यविग्रहः ।\nनित्याङ्गभूतो नित्येशो नित्यकृत्यविशारदः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003135015, "chapter_id": 23135, "verse_number": "४-७१-१६", "content_sanskrit": "नित्यनूतनरूपश्च नित्यनूतनयौवनः ।\nनित्यनूतनवेषश्च वयसा नित्यनूतनः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003135016, "chapter_id": 23135, "verse_number": "४-७१-१७", "content_sanskrit": "नित्यनूतनसंभाषो यत्प्रेम नित्यनूतनम् ।\nनित्यनूतनसंप्राप्तिः सौभाग्यं नित्यनूतनम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003135017, "chapter_id": 23135, "verse_number": "४-७१-१८", "content_sanskrit": "सुधारसपरं मिष्टं यत्वाक्यं नित्यनूतनम् ।\nनित्यनूतनभक्तं च यत्पदं नित्यनूतनम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003135018, "chapter_id": 23135, "verse_number": "४-७१-१९", "content_sanskrit": "स्थायं स्थायं प्राङ्गणेऽस्मिनमायेशो मायया युतः ।\nअतीव रम्ये सुस्निग्धो बभूव गमनोन्मुखः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003135019, "chapter_id": 23135, "verse_number": "४-७१-२०", "content_sanskrit": "रम्भास्तम्भसमूहैश्च रसालपल्लवान्वितैः ।\nपट्टसूत्रनिबद्धैश्च सुन्दरैश्च सुसंस्कृतैः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003135020, "chapter_id": 23135, "verse_number": "४-७१-२१", "content_sanskrit": "पद्मरागेण खचिते रचिते विश्वकर्मणा ।\nकस्तूरीकुङ्कुमाक्तैश्च चन्दनैश्च सुसंस्कृते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003135021, "chapter_id": 23135, "verse_number": "४-७१-२२", "content_sanskrit": "तत्र तस्थौ स्वयं कृष्णः सहाक्रूरः सबान्धवः ।\nयशोदया समाश्लिष्टो वामपार्श्वेन मायया ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003135022, "chapter_id": 23135, "verse_number": "४-७१-२३", "content_sanskrit": "नन्देनाऽऽनन्दयुक्तेनाऽऽश्लिष्टो दक्षिणपार्श्वतः ।\nसंभाषितो बान्धवैश्च पित्रा मात्रा च चुम्बितः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]