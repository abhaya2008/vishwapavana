[{"id": 50016702, "chapter_id": 11583, "verse_number": "1", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50016703, "chapter_id": 11583, "verse_number": "2", "content_sanskrit": "भगवानपि तत्रैव बलदेवेन संयुतः। अपश्यन्निवसन् गोपानिन्द्रयागकृतोद्यमान्॥ १०/२२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50016704, "chapter_id": 11583, "verse_number": "3", "content_sanskrit": "तदभिज्ञोऽपि भगवान् सर्वात्मा सर्वदर्शनः। प्रश्रयावनतोऽपृच्छद् वृद्धान् नन्दपुरोगमान्॥ १०/२२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50016705, "chapter_id": 11583, "verse_number": "4", "content_sanskrit": "कथ्यतां मे पितः कोऽयं सम्भ्रमो व उपागतः। किं फलं कस्य चोद्देशः केन वा साध्यते मखः॥ १०/२२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50016706, "chapter_id": 11583, "verse_number": "5", "content_sanskrit": "एतद् ब्रूहि महान् कामो मह्यं शुश्रूषवे पितः। न हि गोप्यं हि साधूनां कार्त्यं सर्वात्मना त्विह॥ १०/२२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50016707, "chapter_id": 11583, "verse_number": "6", "content_sanskrit": "२अस्त्यस्वपरदृष्टीनाममित्रोदासविद्विषाम्। उदासीनोऽरिवद् वर्ज्य आत्मवत् सुहृदुच्यते॥ १०/२२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50016708, "chapter_id": 11583, "verse_number": "7", "content_sanskrit": "ज्ञात्वाऽज्ञात्वा च कर्माणि जनोऽयमनुतिष्ठते। विदुषः कर्मसिद्धिः स्यात् तथा नाविदुषो भवेत्॥१०/२२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50016709, "chapter_id": 11583, "verse_number": "8", "content_sanskrit": "तत्र तावत् क्रियायोगा भवता किं विचारिताः। अथवा लौकिकास्तन्मे पृच्छतः साधु भण्यताम्॥१०/२२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50016710, "chapter_id": 11583, "verse_number": "9", "content_sanskrit": "नन्द उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50016711, "chapter_id": 11583, "verse_number": "10", "content_sanskrit": "पर्जन्यो भगवानिन्द्रो मेघास्तस्यात्ममूर्तयः। अभिवर्षन्ति भूतानां प्राणनं जीवनं पयः॥ १०/२२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50016712, "chapter_id": 11583, "verse_number": "11", "content_sanskrit": "तत् तात वयमन्ये च वार्मुचां पतिमीश्वरम्। द्रव्यैस्तद्रेतसा सिद्धैर्यजन्ते क्रतुभिर्नराः॥ १०/२२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50016713, "chapter_id": 11583, "verse_number": "12", "content_sanskrit": "तच्छेषेणोपजीवन्ति त्रिवर्गफलहेतवे। पुंसां पुरुषकाराणां पर्जन्यः फलभावनः॥ १०/२२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50016714, "chapter_id": 11583, "verse_number": "13", "content_sanskrit": "य एवं विसृजेद् धर्मं पारम्पर्यागतं नरः। कामाल्लोभाद् भयाद् द्वेषात् स वै नाप्नोति शोभनम्॥ १०/२२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50016715, "chapter_id": 11583, "verse_number": "14", "content_sanskrit": "श्रीबादरायणिरुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50016716, "chapter_id": 11583, "verse_number": "15", "content_sanskrit": "वचो निशम्य नन्दस्य तथाऽन्येषां व्रजौकसाम्। इन्द्राय मन्युं जनयन् पितरं प्राह केशवः॥ १०/२२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50016717, "chapter_id": 11583, "verse_number": "16", "content_sanskrit": "श्रीभगवानुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50016718, "chapter_id": 11583, "verse_number": "17", "content_sanskrit": "कर्मणा जायते जन्तुः कर्मणैव प्रमीयते। सुखं दुःखं भयं क्षेमं कर्मणैवाभिपद्यते॥ १०/२२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50016719, "chapter_id": 11583, "verse_number": "18", "content_sanskrit": "अस्ति चेदीश्वरः कश्चित् फलरूपः स कर्मणः। कर्तारं भजते सोऽपि न ह्यकर्तुः प्रभुर्हि सः॥ १०/२२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50016720, "chapter_id": 11583, "verse_number": "19", "content_sanskrit": "किमिन्द्रेणेह भूतानां स्वस्वकर्मानुवर्तिनाम्। अनीशेनान्यताकर्तुं स्वभावविहितं नृणाम्॥ १०/२२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50016721, "chapter_id": 11583, "verse_number": "20", "content_sanskrit": "स्वभावतन्त्रो हि जनः स्वभावमनुवर्तते। स्वभावस्थमिदं सर्वं सदेवासुरमानुषम्॥ १०/२२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50016722, "chapter_id": 11583, "verse_number": "21", "content_sanskrit": "देहानुच्चवचान् जन्तुः प्राप्योत्सृजति कर्मणा। शत्रुर्मित्रमुदासीनः कर्मैव गुरुरीश्वरः॥ १०/२२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50016723, "chapter_id": 11583, "verse_number": "22", "content_sanskrit": "तस्मात् सम्पूजयेत् कर्म स्वभावस्थः स्वकर्मकृत्। अञ्जसा येन वर्तेत तदेवास्य हि दैवतम्॥ १०/२२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50016724, "chapter_id": 11583, "verse_number": "23", "content_sanskrit": "वर्तेत ब्रह्मणा विप्रो राजन्यो रक्षया भुवः। वैश्यस्तु वार्तया जीवेच्छूद्रस्तु द्विजसेवया॥ १०/२२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50016725, "chapter_id": 11583, "verse_number": "24", "content_sanskrit": "कृषिवाणिज्यगोरक्षाः कुसीदं तुर्यमुच्यते। वार्ता चतुर्विधा तत्र वयं गोवृत्तयोऽनिशम्॥ १०/२२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50016726, "chapter_id": 11583, "verse_number": "25", "content_sanskrit": "सत्त्वं रजस्तम इति स्थित्युत्पत्त्यन्तहेतवः। रजसोत्पद्यते विश्वमन्योन्यं विविधं जगत्॥ १०/२२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50016727, "chapter_id": 11583, "verse_number": "26", "content_sanskrit": "रजसा चोदिता मेघा वर्षन्त्यम्बूनि सर्वतः। प्रजास्तैरेव सिद्ध्यन्ति महेन्द्रः किं करिष्यति॥ १०/२२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50016728, "chapter_id": 11583, "verse_number": "27", "content_sanskrit": "न नः पुरो जनपदा न ग्रामगृहिणो वयम्। वनौकसस्तात नित्यं काननाद्रिनिवासिनः॥ १०/२२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50016729, "chapter_id": 11583, "verse_number": "28", "content_sanskrit": "आजीव्यैकतरं भावं यस्त्वन्यमुपधावति। न तस्माद् विन्दते क्षेमं जारं नार्यसती यथा॥ १०/२२/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50016730, "chapter_id": 11583, "verse_number": "29", "content_sanskrit": "तस्माद् गवां ब्राह्मणानामद्रेश्चारभ्यतां मखः। य इन्द्रयागसम्भारास्तैरयं साध्यतां मखः॥ १०/२२/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50016731, "chapter_id": 11583, "verse_number": "30", "content_sanskrit": "पच्यतां विविधाः पाकाः सूपान्धःपायसादयः। संयावापूपशष्कुल्यः सर्वदोहश्च गृह्यताम्॥ १०/२२/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50016732, "chapter_id": 11583, "verse_number": "31", "content_sanskrit": "हूयन्तामग्नयः सम्यग् ब्राह्मणैर्ब्रह्मवादिभिः। अन्नं बहुगुणं तेभ्यो दीयतां धेनुदक्षिणाः॥ १०/२२/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50016733, "chapter_id": 11583, "verse_number": "32", "content_sanskrit": "अन्येभ्यश्चाश्वचण्डालपतितेभ्यो यथार्हतः। यवसं च गवां दत्वा गिरये दीयतां बलिः॥ १०/२२/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50016734, "chapter_id": 11583, "verse_number": "33", "content_sanskrit": "स्वलङ्कृता भुक्तवन्तः स्वनुलिप्ताः सुवाससः। प्रदक्षिणां च कुरुत गोविप्रानलपर्वतान्॥ १०/२२/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50016735, "chapter_id": 11583, "verse_number": "34", "content_sanskrit": "एतन्मम मतं तात क्रियतां यदि रोचते। अयं गोब्राह्मणाद्रीणां मह्यं च दयितो मखः॥ १०/२२/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50016736, "chapter_id": 11583, "verse_number": "35", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50016737, "chapter_id": 11583, "verse_number": "36", "content_sanskrit": "कालात्मना भगवता शक्रदर्पजिघांसया। प्रोक्तं निशम्य नन्दाद्याः साध्वगृह्णन्त तद्वचः॥ १०/२२/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50016738, "chapter_id": 11583, "verse_number": "37", "content_sanskrit": "तथा च विदधुः सर्वे यथाऽऽह मधुसूदनः। वाचयित्वा स्वस्त्ययनं द्रव्यैर्गोविप्रभूभृताम्॥ १०/२२/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50016739, "chapter_id": 11583, "verse_number": "38", "content_sanskrit": "उपहृत्य बलीन् सर्वानादृता यवसं गवाम्। गोधनानि पुरस्कृत्य गिरिं चक्रुः प्रदक्षिणम्॥ १०/२२/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50016740, "chapter_id": 11583, "verse_number": "39", "content_sanskrit": "अनांस्यनडुद्युक्तानि ते चारुह्य स्वलङ्कृताः। गोप्यश्च कृष्णवीर्याणि गायन्तः सद्विजाशिषः॥ १०/२२/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50016741, "chapter_id": 11583, "verse_number": "40", "content_sanskrit": "कृष्णस्त्वन्यतमं रूपं गोपविस्रम्भणं गतः। शैलोऽस्मीति ब्रुवन् भूरि बलिमादद् बृहद्वपुः॥ १०/२२/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50016742, "chapter_id": 11583, "verse_number": "41", "content_sanskrit": "तस्मै नमो व्रजजनैः स चक्रे ह्यात्मनाऽऽत्मने। अहो पश्यत शैलोऽसौ रूपी नोऽनुग्रहं व्यधात्॥१०/२२/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50016743, "chapter_id": 11583, "verse_number": "42", "content_sanskrit": "एषोऽवजानतो मर्त्यान् कामरूपी वनेचरः। हन्ति ह्यस्मै नमस्यामः शर्मणे आत्मनो गवाम्॥१०/२२/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50016744, "chapter_id": 11583, "verse_number": "43", "content_sanskrit": "इत्यद्रिगोद्विजमखं वासुदेवप्रचोदिताः। यथा विधाय गोपालाः सहकृष्णा व्रजं ययुः॥ १०/२२/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50016745, "chapter_id": 11583, "verse_number": "44", "content_sanskrit": "इति श्रीमद्भागवते दशमस्कन्धे द्वाविंशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]