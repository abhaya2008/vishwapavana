[{"id": 7000269000, "chapter_id": 20269, "verse_number": "१-२३-१", "content_sanskrit": "भीष्म उवाच ।\nवैष्णवा ये तु वै धर्मा यान्रुद्रः प्रोक्तवानिह ।\nतान्मे कथय विप्रेंद्र कीदृशास्ते फलं तु किम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000269001, "chapter_id": 20269, "verse_number": "१-२३-२", "content_sanskrit": "पुलस्त्य उवाच ।\nपुरा रथंतरे कल्पे परिपृष्टो महात्मना ।\nमंदरस्थो महादेवः पिनाकी ब्रह्मणा स्वयम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000269002, "chapter_id": 20269, "verse_number": "१-२३-३", "content_sanskrit": "कथमारोग्यमैश्वर्यमनंतममरेश्वर ।\nअल्पेन तपसा देव भवेन्मोक्षः सदा नृणां ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000269003, "chapter_id": 20269, "verse_number": "१-२३-४", "content_sanskrit": "किं तज्ज्ञानं महादेव त्वत्प्रसादादधोक्षज ।\nअल्पकेनापि तपसा महाफलमिहोच्यते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000269004, "chapter_id": 20269, "verse_number": "१-२३-५", "content_sanskrit": "इति पृष्टस्स विश्वात्मा ब्रह्मणा लोकभावनः ।\nउमापतिरुवाचेदं मनसः प्रीतिकारकम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000269005, "chapter_id": 20269, "verse_number": "१-२३-६", "content_sanskrit": "ईश्वर उवाच ।\nअस्माद्रथंतरात्कल्पाद्भूयो विंशतिमो यदा ।\nवाराहो भविता कल्पस्तदा मन्वंतरे शुभे ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000269006, "chapter_id": 20269, "verse_number": "१-२३-७", "content_sanskrit": "वैवस्वताख्ये संप्राप्ते सप्तमे सप्तलोकधृक् ।\nद्वापराख्यं युगं तस्मिन्सप्तविंशतिमं यदा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000269007, "chapter_id": 20269, "verse_number": "१-२३-८", "content_sanskrit": "तस्यां ते तु महातेजा वासुदेवो जनार्दनः ।\nभारावतरणार्थाय त्रिधा विष्णुर्भविष्यति ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000269008, "chapter_id": 20269, "verse_number": "१-२३-९", "content_sanskrit": "द्वैपायन ऋषिस्तत्र रौहिणेयोथ केशवः ।\nकंसारिः केशिमथनः केशवः क्लेशनाशनः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000269009, "chapter_id": 20269, "verse_number": "१-२३-१०", "content_sanskrit": "पुरीं द्वारवतीं नाम सांप्रतं या कुशस्थली ।\nदिव्यानुभावसंयुक्तामधिवासाय शार्ङ्गिणः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000269010, "chapter_id": 20269, "verse_number": "१-२३-११", "content_sanskrit": "त्वष्टा तदाज्ञया ब्रह्मन्करिष्यति जगत्पतेः ।\nतस्यां कदाचिदासीनः सभायां सोऽमितद्युतिः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000269011, "chapter_id": 20269, "verse_number": "१-२३-१२", "content_sanskrit": "भार्याभिर्वृष्णिविद्वद्भिभूरिभिर्भूरिदक्षिणैः ।\nकुरुभिर्देवगंधर्वैरन्वितः कैटभार्दनः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000269012, "chapter_id": 20269, "verse_number": "१-२३-१३", "content_sanskrit": "प्रवृत्तासु पुराणासु धर्मसंबधधिनीषु च ।\nकथासु भीमसेनेन परिपृष्टः प्रतापवान् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000269013, "chapter_id": 20269, "verse_number": "१-२३-१४", "content_sanskrit": "त्वया पृष्टस्य धर्मस्य वक्ष्यत्यस्य च भेददृक् ।\nभविता स तदा ब्रह्मन्कर्ता चैव वृकोदरः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000269014, "chapter_id": 20269, "verse_number": "१-२३-१५", "content_sanskrit": "प्रवर्तकोऽस्य धर्मस्य पांडुसूनुर्महाबलः ।\nयस्य तीक्ष्णो वृको नाम जठरे हव्यवाहनः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000269015, "chapter_id": 20269, "verse_number": "१-२३-१६", "content_sanskrit": "संभाष्यते स धर्मात्मा तेन चासौ वृकोदरः ।\nअतीव स्वादशीलश्च नागायुत बलो महान् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000269016, "chapter_id": 20269, "verse_number": "१-२३-१७", "content_sanskrit": "धार्मिकस्याप्यशक्तस्य तीव्राग्नित्वादुपोषणे ।\nइदं व्रतमशेषाणां व्रतानामधिकं यतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000269017, "chapter_id": 20269, "verse_number": "१-२३-१८", "content_sanskrit": "कथयिष्यति विश्वात्मा वासुदेवो जगद्गुरुः ।\nअशेषयज्ञफलदमशेषाघविनाशनम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000269018, "chapter_id": 20269, "verse_number": "१-२३-१९", "content_sanskrit": "अशेषदुष्टशमनमशेषसुरपूजितम् ।\nपवित्राणां पवित्रं यन्मगलानां च मंगलम् ।\nभविष्यं च भविष्याणां पुराणानां पुरातनम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000269019, "chapter_id": 20269, "verse_number": "१-२३-२०", "content_sanskrit": "वासुदेव उवाच ।\nयद्यष्टमी चतुर्द्दश्योर्द्वादशीषु च भारत ।\nअन्येष्वपि दिनर्क्षेषु नशक्तस्त्वमुपोषितुम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000269020, "chapter_id": 20269, "verse_number": "१-२३-२१", "content_sanskrit": "ततस्त्वग्र्यामिमां भीम तिथिं पापप्रणाशिनीम् ।\nउपोष्य विधिनानेन गच्छ विष्णोः परं पदं ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000269021, "chapter_id": 20269, "verse_number": "१-२३-२२", "content_sanskrit": "माघमासस्य दशमी यदा शुक्ला भवेत्तदा ।\nघृतेनाभ्यंजनं कृत्वा तिलैः स्नानं समाचरेत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000269022, "chapter_id": 20269, "verse_number": "१-२३-२३", "content_sanskrit": "तथैव विष्णुमभ्यर्चेन्नमो नारायणाय च ।\nकृष्णाय पादौ संपूज्य शिरः कृष्णात्मनेति च ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000269023, "chapter_id": 20269, "verse_number": "१-२३-२४", "content_sanskrit": "वैकुंठायेति वैकंठमुरः श्रीवत्सधारिणे ।\nशंखिने गदिने चैव चक्रिणे वरदाय वै ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000269024, "chapter_id": 20269, "verse_number": "१-२३-२५", "content_sanskrit": "सर्वं नारायणन्त्वेवं संपूज्यावाहनक्रमात् ।\nदामोदरायेत्युदरं कटिं पंचजनाय वै ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000269025, "chapter_id": 20269, "verse_number": "१-२३-२६", "content_sanskrit": "ऊरूसौभाग्यनाथाय जानुनी भूतधारिणे ।\nनमो नीलाय वै जंघे पादौ विश्वभुजे पुनः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000269026, "chapter_id": 20269, "verse_number": "१-२३-२७", "content_sanskrit": "नमो देव्यै नमः शांत्यै नमो लक्ष्म्यै नमः श्रियै ।\nनमस्तुष्ट्यै नमः पुष्ट्यै धृत्यै व्युष्ट्यै नमो नमः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000269027, "chapter_id": 20269, "verse_number": "१-२३-२८", "content_sanskrit": "नमो विहंगनाथाय वायुवेगाय पक्षिणे ।\nविषप्रमथनायेति गरुडं चाभिपूजयेत् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000269028, "chapter_id": 20269, "verse_number": "१-२३-२९", "content_sanskrit": "एवं संपूज्य गोविंदमुमापतिविनायकौ ।\nगंधैर्माल्यैस्तथा धूपैर्भक्ष्यैर्नानाविधैरपि ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000269029, "chapter_id": 20269, "verse_number": "१-२३-३०", "content_sanskrit": "गव्येन पयसा सिक्तां कृसरामथ पायसम् ।\nसर्पिषा सह भुक्त्वा तु गत्वा स्थानांतरं पुनः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000269030, "chapter_id": 20269, "verse_number": "१-२३-३१", "content_sanskrit": "नैयग्रोधं दंतकाष्ठमथवा खादिरं बुधः ।\nगृहीत्वा धावयेद्दंतानाचांतः प्रागुदङ्मुखः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000269031, "chapter_id": 20269, "verse_number": "१-२३-३२", "content_sanskrit": "ब्रूयात्सायंतनीं कृत्वा संध्यामस्तमिते रवौ ।\nनमो नारायणायेति त्वामहं शरणं गतः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000269032, "chapter_id": 20269, "verse_number": "१-२३-३३", "content_sanskrit": "एकादश्यां निराहारः समभ्यर्च्य च केशवम् ।\nतां रात्रिं सकलां स्थित्वा शेषपर्यंकशायिनम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000269033, "chapter_id": 20269, "verse_number": "१-२३-३४", "content_sanskrit": "सर्पिषा विश्वदहनं हुत्वा ब्राह्मणपुंगवैः ।\nसहैव पुंडरीकाक्षं द्वादश्यां क्षीरभोजनम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000269034, "chapter_id": 20269, "verse_number": "१-२३-३५", "content_sanskrit": "करिष्यामि यथात्मानं निर्विघ्नेनास्तु तच्च मे ।\nएवमुक्त्वा स्वपेद्भूमावितिहासकथां पुनः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000269035, "chapter_id": 20269, "verse_number": "१-२३-३६", "content_sanskrit": "श्रुत्वा प्रभाते संजाते नदीं गत्वा विशांपते ।\nस्नानं कृत्वा मुदा तद्वत्पाषण्डानभिवर्जयेत् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000269036, "chapter_id": 20269, "verse_number": "१-२३-३७", "content_sanskrit": "उपास्य सन्ध्यां विधिवत्कृत्वा च पितृतर्पणम् ।\nप्रणम्य च हृषीकेशं शेषपर्यङ्कशायिनम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000269037, "chapter_id": 20269, "verse_number": "१-२३-३८", "content_sanskrit": "गृहस्य पुरतो भक्त्या मण्डपं कारयेद्बुधः ।\nचतुर्हस्तां शुभां कुर्याद्वेदीमरिनिषूदन ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000269038, "chapter_id": 20269, "verse_number": "१-२३-३९", "content_sanskrit": "चतुर्हस्तप्रमाणं तु विन्यसेत्तत्र तोरणम् ।\nमध्ये च कलशं तत्र माषमात्रेण संयुतम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000269039, "chapter_id": 20269, "verse_number": "१-२३-४०", "content_sanskrit": "छिद्रेण जलसंपूर्णमधः कृष्णाजिने स्थितः ।\nतस्य धारां च शिरसा धारयेत्सकलां निशाम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000269040, "chapter_id": 20269, "verse_number": "१-२३-४१", "content_sanskrit": "धाराभिर्भूरिभिर्भूरि फलं वेदविदो विदुः ।\nयस्मात्तस्मात्कुरुश्रेष्ठ कारयेत्प्रयतो द्विजः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000269041, "chapter_id": 20269, "verse_number": "१-२३-४२", "content_sanskrit": "दक्षिणे चार्धचंद्रं तु पश्चिमे वर्तुलं तथा ।\nअश्वत्थपत्राकारं च उत्तरेण तु कारयेत् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000269042, "chapter_id": 20269, "verse_number": "१-२३-४३", "content_sanskrit": "मध्ये तु पद्माकारं च कारयेद्वैष्णवो द्विजः ।\nपूर्वतो वेदिकां स्थो न स्थो न याम्ये च कल्पयेत् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000269043, "chapter_id": 20269, "verse_number": "१-२३-४४", "content_sanskrit": "पानीयधारां शिरसि धारयेद्विष्णुतत्परः ।\nद्वितीया वेदी देवस्य तत्र पद्मं सकर्णिकम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000269044, "chapter_id": 20269, "verse_number": "१-२३-४५", "content_sanskrit": "तस्य मध्ये स्थितं देवं कुर्याद्वै पुरुषोत्तमम् ।\nहस्तमात्रं च तत्कुंडं कृत्वा तत्र त्रिमेखलम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000269045, "chapter_id": 20269, "verse_number": "१-२३-४६", "content_sanskrit": "योनिवक्त्रं ततस्तस्मिन्ब्राह्मणैर्यवसर्पिषी ।\nतिलांश्च विष्णुदेवत्यैर्मंत्रैरेवानले हुनेत् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000269046, "chapter_id": 20269, "verse_number": "१-२३-४७", "content_sanskrit": "कृत्वा तु वैष्णवं सम्यग्यागं तत्र प्रकल्पयेत् ।\nआज्यधारा मध्यमे तु कुंडे दद्यात्तु यत्नतः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000269047, "chapter_id": 20269, "verse_number": "१-२३-४८", "content_sanskrit": "क्षीरधारां देवदेवे वारिधारात्मनोपरि ।\nनिष्पावार्धप्रमाणां वै धारामाज्यस्य पातयेत् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000269048, "chapter_id": 20269, "verse_number": "१-२३-४९", "content_sanskrit": "स्वेच्छया क्षीरजलयोरविच्छिन्नां च शर्वरीं ।\nजलकुंभान्महावीर्य स्थापयित्वा त्रयोदश ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000269049, "chapter_id": 20269, "verse_number": "१-२३-५०", "content_sanskrit": "भक्ष्यैर्नानाविधैर्युक्तान्सितवस्त्रैरलंकृतान् ।\nप्रतानौदुंबरैः पात्रैः पंचरत्नसमन्वितैः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000269050, "chapter_id": 20269, "verse_number": "१-२३-५१", "content_sanskrit": "चतुर्भिर्बह्वृचैर्होमः कार्यस्तत्र उदङ्मुखैः ।\nरुद्रजाप्यश्चतुर्भिश्च यजुर्वेदपरायणैः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000269051, "chapter_id": 20269, "verse_number": "१-२३-५२", "content_sanskrit": "वैष्णवानि च सामानि चतुर्भिः सामवेदिभिः ।\nएवं द्वादश वै विप्रान्वस्त्रमाल्यानुलेपनैः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000269052, "chapter_id": 20269, "verse_number": "१-२३-५३", "content_sanskrit": "पूजयेदंगुलीयैश्च कटकैर्हेमसूत्रकैः ।\nवासोभिः शयनीयैश्च वित्तशाठ्यविवर्जितः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000269053, "chapter_id": 20269, "verse_number": "१-२३-५४", "content_sanskrit": "एवं क्षपातिवाह्या वै गीतमङ्गलनिःस्वनैः ।\nउपाध्यायस्य च पुनर्द्विगुणं सर्वमेव तु ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000269054, "chapter_id": 20269, "verse_number": "१-२३-५५", "content_sanskrit": "ततः प्रभाते विमले समुत्थाय त्रयोदश ।\nगावो देयाः कुरुश्रेष्ठ सौवर्णशृंगसंवृताः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000269055, "chapter_id": 20269, "verse_number": "१-२३-५६", "content_sanskrit": "पयस्विन्यः शीलवत्यः कांस्यदोहसमन्विताः ।\nरौप्यखुराः सवत्साश्च चंदनेनाभिभूषिताः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000269056, "chapter_id": 20269, "verse_number": "१-२३-५७", "content_sanskrit": "तास्तु तेषां ततो दत्वा भक्ष्यभोज्येन तर्पितान् ।\nकृत्वा वै ब्राह्मणान्सर्वान्छत्रैर्नानाविधैस्तथा ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000269057, "chapter_id": 20269, "verse_number": "१-२३-५८", "content_sanskrit": "भुक्त्वा चाक्षारलवणमात्मना च विसर्जयेत् ।\nअनुगम्य पदान्यष्टौ पुत्रभार्यासमन्वितः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000269058, "chapter_id": 20269, "verse_number": "१-२३-५९", "content_sanskrit": "प्रीयतामत्र देवेशः केशवः क्लेशनाशनः ।\nएवं गुर्वाज्ञया कुंभान्गाश्चैव शयनानि च ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000269059, "chapter_id": 20269, "verse_number": "१-२३-६०", "content_sanskrit": "वासांसि चैव सर्वेषां गृहाणि प्रापयेद्बुधः ।\nअभावे बहुशय्यानामेकामपि सुसंस्कृताम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000269060, "chapter_id": 20269, "verse_number": "१-२३-६१", "content_sanskrit": "शय्यां दद्याद्गृही भीम सर्वोपस्करसंयुताम् ।\nइतिहासपुराणानि वाचयित्वा तु वाहयेत् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000269061, "chapter_id": 20269, "verse_number": "१-२३-६२", "content_sanskrit": "तद्दिनं कुरुशार्दूल य इच्छेद्विपुलां श्रियम् ।\nतस्मात्त्वं सत्त्वमालंब्य भीमसेन विमत्सरः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000269062, "chapter_id": 20269, "verse_number": "१-२३-६३", "content_sanskrit": "कुरु व्रतमिदं सम्यक्स्नेहाद्गुह्यं मयोदितम् ।\nत्वया कृतमिदं वीर त्वन्नाम्ना च भविष्यति ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000269063, "chapter_id": 20269, "verse_number": "१-२३-६४", "content_sanskrit": "सा भीमद्वादशी ह्येषा सर्वपापहरा शुभा ।\nया तु कल्याणिनी नाम पुरा कल्पेषु पठ्यते ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000269064, "chapter_id": 20269, "verse_number": "१-२३-६५", "content_sanskrit": "त्वं चादिकर्ता भव सौकरेस्मिन्कल्पे महावीर वरप्रधान ।\nयस्याः स्मृतेः कीर्तनतोप्यशेषं पापं प्रणष्टं त्रिदशाधिपस्य ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000269065, "chapter_id": 20269, "verse_number": "१-२३-६६", "content_sanskrit": "दृष्ट्वा च तामप्सरसामभीष्टां वेश्याकृतामन्यभवांतरेषु ।\nजाताथ सा वैश्यकुलोद्भवापि पुलोमकन्या पुरुहूतपत्नी ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000269066, "chapter_id": 20269, "verse_number": "१-२३-६७", "content_sanskrit": "तत्रापि तस्याः परिचारिकेयं मम प्रिया संप्रति सत्यभामा ।\nकृतं पुरा मंगलमेतदेव द्विजात्मजा वेदवती बभूव ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000269067, "chapter_id": 20269, "verse_number": "१-२३-६८", "content_sanskrit": "अस्यां च कल्याणतिथौ विवस्वान्सहस्रधारेण सहस्ररश्मिः ।\nस्नातः पुरा मंडलमेत्य तद्वत्तेजोमयं खेटपतिर्बभूव ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000269068, "chapter_id": 20269, "verse_number": "१-२३-६९", "content_sanskrit": "इदमेवकृतं महेंद्रमुख्यैर्बहुभिर्देवसुरारिकोटिभिश्च ।\nफलमस्येह न शक्यते हि वक्तुं यदि जिह्वायुतकोटयो मुखे स्युः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000269069, "chapter_id": 20269, "verse_number": "१-२३-७०", "content_sanskrit": "कलिकलुषविदारिणीमनंतामपि कथयिष्यति यादवेंद्रसूनुः ।\nअथ नरकगतान्पितॄनथैषा ह्यलमुद्धर्तुमिहैव यः करोति ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000269070, "chapter_id": 20269, "verse_number": "१-२३-७१", "content_sanskrit": "इदमनघशृणोति वक्ति भक्त्या परिपठतीह परोपकारहेतोः ।\nइह पंकजनाभभक्तिमान्भवेदथ शक्रस्य सपूज्यतामुपैति ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000269071, "chapter_id": 20269, "verse_number": "१-२३-७२", "content_sanskrit": "कल्याणिनी नाम पुरा विसर्गे या द्वादशी माघसितेभिपूज्या ।\nसा पांडुपुत्रेण कृता भविष्यत्यंनतपुण्यानघभीमपूर्वा ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000269072, "chapter_id": 20269, "verse_number": "१-२३-७३", "content_sanskrit": "ब्रह्मोवाच ।\nवर्णाश्रमाणां प्रभवः पुराणेषु मया श्रुतः ।\nसदाचारश्च भगवान्धर्मशास्त्रांगविस्तरैः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000269073, "chapter_id": 20269, "verse_number": "१-२३-७४", "content_sanskrit": "पण्यस्त्रीणां समाचारं श्रोतुमिच्छामि तत्वतः ।\nईश्वर उवाच ।\nतस्मिन्नेव पुरे ब्रह्मन्सहस्राणि तु षोडश ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000269074, "chapter_id": 20269, "verse_number": "१-२३-७५", "content_sanskrit": "वासुदेवस्य नारीणां भविष्यंत्यंबुजोद्भव ।\nताभिर्वसंतसमये कोकिलालिकुलाकुले ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000269075, "chapter_id": 20269, "verse_number": "१-२३-७६", "content_sanskrit": "पुष्पितोपवने फुल्लकल्हारसरसस्तटे ।\nनिर्भरं सहपत्नीभिः प्रशस्ताभिरलंकृतः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000269076, "chapter_id": 20269, "verse_number": "१-२३-७७", "content_sanskrit": "रमयिष्यति विश्वात्मा कृष्णो यदुकुलोद्वहः ।\nकुरंगनयनः श्रीमान्मालतीकृतशेखरः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000269077, "chapter_id": 20269, "verse_number": "१-२३-७८", "content_sanskrit": "गच्छन्समीपमार्गेण सांबो जांबवतीसुतः ।\nसाक्षात्कंदर्परूपेण सर्वाभरणभूषितः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000269078, "chapter_id": 20269, "verse_number": "१-२३-७९", "content_sanskrit": "अनंगशरतप्ताभिः साभिलाषमवेक्षितः ।\nप्रबुद्धो मन्मथस्तासां भविष्यति यदात्मनि ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000269079, "chapter_id": 20269, "verse_number": "१-२३-८०", "content_sanskrit": "तदवेक्ष्य जगन्नाथस्सर्वज्ञो ध्यानचक्षुषा ।\nस्वयंप्रभुर्वक्ष्यति ता वो हरिष्यंति दस्यवः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000269080, "chapter_id": 20269, "verse_number": "१-२३-८१", "content_sanskrit": "अपरोक्षं यतस्त्वेवं स्निग्धमेतद्विचिंतितम् ।\nततः प्रसादितो देव इदं वक्ष्यति शार्ङ्गभृत् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000269081, "chapter_id": 20269, "verse_number": "१-२३-८२", "content_sanskrit": "ताभिः शापाभितप्ताभिर्भगवान्भूतभावनः ।\nउत्तराश्रितदाशानामुद्धर्ता ब्राह्मणप्रियः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000269082, "chapter_id": 20269, "verse_number": "१-२३-८३", "content_sanskrit": "उपदेक्ष्यत्यनंतात्मा भावि कल्याणकारकम् ।\nभवतीनामृषिर्दाल्भ्यो यद्व्रतं कथयिष्यति ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000269083, "chapter_id": 20269, "verse_number": "१-२३-८४", "content_sanskrit": "इत्युक्त्वा ताः परित्यज्य गतोन्तर्धानमीश्वरः ।\nततः कालेन महता भारावतरणे कृते ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000269084, "chapter_id": 20269, "verse_number": "१-२३-८५", "content_sanskrit": "निवृत्ते मौसले तद्वत्केशवे दिवमागते ।\nशून्ये यदुकुले सर्वे चोरैरपि जितेर्जुने ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000269085, "chapter_id": 20269, "verse_number": "१-२३-८६", "content_sanskrit": "हृतासु कृष्णपत्नीषु दाशभोग्यासु चार्बुदे ।\nतिष्ठंतीषु च दौर्गत्यसंतप्तासु चतुर्मुख ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000269086, "chapter_id": 20269, "verse_number": "१-२३-८७", "content_sanskrit": "आगमिष्यति योगात्मा दाल्भ्योनाम महातपाः ।\nतास्तमर्घ्येण संपूज्य प्रणिपत्य पुनःपुनः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000269087, "chapter_id": 20269, "verse_number": "१-२३-८८", "content_sanskrit": "लालप्यमाना बहुशो वाष्पपर्याकुलेक्षणाः ।\nस्मरंत्यो विविधान्भोगान्दिव्यमाल्यानुलेपनान् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000269088, "chapter_id": 20269, "verse_number": "१-२३-८९", "content_sanskrit": "भर्त्तारं जगतामीशमनंतमपराजितम् ।\nदिव्यानुभावां च पुरींनानारत्नगृहाणि च ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000269089, "chapter_id": 20269, "verse_number": "१-२३-९०", "content_sanskrit": "द्वारकावासिनः सर्वान्देवरूपान्कुमारकान् ।\nप्रश्नमेतं करिष्यंति मुनेरभिमुखंस्थिताः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000269090, "chapter_id": 20269, "verse_number": "१-२३-९१", "content_sanskrit": "दस्युमिर्भगवन्सर्वाः परिभुक्ता वयं बलात् ।\nस्वधर्मश्च्यावितोस्माकमस्मिन्नः शरणं भवान् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000269091, "chapter_id": 20269, "verse_number": "१-२३-९२", "content_sanskrit": "आदिष्टोसि पुरा ब्रह्मन्केशवेन च धीमता ।\nकस्मादीशेन संयोगं प्राप्य वेश्यात्वमागताः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000269092, "chapter_id": 20269, "verse_number": "१-२३-९३", "content_sanskrit": "वेश्यानामपि यो धर्मस्तं नो ब्रूहि तपोधन ।\nकथयिष्ये वदत्तासां यद्दाल्भ्यश्चैकितायनः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000269093, "chapter_id": 20269, "verse_number": "१-२३-९४", "content_sanskrit": "दाल्भ्य उवाच ।\nजलक्रीडाविहारेषु पुरा सरसि मानसे ।\nभवतीनां सगर्वाणां नारदोभ्याशमागतः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000269094, "chapter_id": 20269, "verse_number": "१-२३-९५", "content_sanskrit": "हुताशनसुताः सर्वा भवत्योप्सरसः पुरा ।\nअप्रणम्यावलेपेन परिपृष्टः स योगवित् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000269095, "chapter_id": 20269, "verse_number": "१-२३-९६", "content_sanskrit": "कथं नारायणोस्माकं भर्त्ता स्यादित्युपादिश ।\nतस्माद्वरप्रदानं च शापश्चायमभूत्पुरा ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000269096, "chapter_id": 20269, "verse_number": "१-२३-९७", "content_sanskrit": "शय्याद्वयप्रदानेन मधुमाधवमासयोः ।\nसुवर्णोपस्करोत्संगं द्वादश्यां शुक्लपक्षतः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000269097, "chapter_id": 20269, "verse_number": "१-२३-९८", "content_sanskrit": "भर्ता नारायणो नूनं भविष्यत्यन्यजन्मनि ।\nयदकृत्वा प्रणामं मे रूपसौभाग्यमत्सरात् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000269098, "chapter_id": 20269, "verse_number": "१-२३-९९", "content_sanskrit": "परिपृष्टोस्मि तेनाशु वियोगो वो भविष्यति ।\nचोरैरपहृताः सर्वा वेश्यात्वं समवाप्स्यथ ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000269099, "chapter_id": 20269, "verse_number": "१-२३-१००", "content_sanskrit": "एवं नारदशापेन केशवस्य च शापतः ।\nवेश्यात्वमागताः सर्वा भवत्यः काममोहिताः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000269100, "chapter_id": 20269, "verse_number": "१-२३-१०१", "content_sanskrit": "इदानीमपि यद्वक्ष्ये तच्छ्रणुध्वं वरांगनाः ।\nपुरा दैवासुरे युद्धे हतेषु शतशः सुरैः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000269101, "chapter_id": 20269, "verse_number": "१-२३-१०२", "content_sanskrit": "दानवासुरदैत्येषु राक्षसेषु ततस्ततः ।\nतेषां दारसहस्राणि शतशोथ सहस्रशः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000269102, "chapter_id": 20269, "verse_number": "१-२३-१०३", "content_sanskrit": "परिणीतानि यानि स्युर्बलाद्भुक्तानि यानि वै ।\nतानि सर्वाणि देवेशः प्रोवाच वदतां वरः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7000269103, "chapter_id": 20269, "verse_number": "१-२३-१०४", "content_sanskrit": "वेश्याधर्मेण वर्तध्वमधुना नृपमंदिरे ।\nभक्तिमत्यो वरारोहास्तथा देवकुलेषु च ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7000269104, "chapter_id": 20269, "verse_number": "१-२३-१०५", "content_sanskrit": "राजतः स्वामिनश्चापि जीविकां च प्रलप्स्यथ ।\nभविष्यति च सौभाग्यं सर्वासामपि शक्तितः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7000269105, "chapter_id": 20269, "verse_number": "१-२३-१०६", "content_sanskrit": "यः कश्चिच्छुल्कमादाय गृहमेष्यति वः सदा ।\nनिश्छद्मनैवोपचर्यः प्रीतिभावैरदांभिकैः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7000269106, "chapter_id": 20269, "verse_number": "१-२३-१०७", "content_sanskrit": "देवतानां पितॄणां च पुण्येह्नि समुपस्थिते ।\nगोभूहिरण्यधान्यानि प्रदेयानि च शक्तितः ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7000269107, "chapter_id": 20269, "verse_number": "१-२३-१०८", "content_sanskrit": "यद्व्रतं चोपदेक्ष्यामि तत्कुरुध्वं च सर्वशः ।\nसंसारोत्तारणायालमेतद्वेदविदो विदुः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7000269108, "chapter_id": 20269, "verse_number": "१-२३-१०९", "content_sanskrit": "यदा सूर्यदिने हस्तः पुष्यो वाथ पुनर्वसुः ।\nभवेत्सर्वौषधिस्नानं सम्यक्नारी समाचरेत् ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7000269109, "chapter_id": 20269, "verse_number": "१-२३-११०", "content_sanskrit": "तदा पंचशरात्मा तु हरिस्सन्निधिमेष्यति ।\nअर्चयेत्पुंडरीकाक्षमनंगस्यानुकीर्तनैः ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7000269110, "chapter_id": 20269, "verse_number": "१-२३-१११", "content_sanskrit": "कामाय पादौ संपूज्य जंघे वै मोहकारिणे ।\nमेढ्रं कंदर्पनिधये कटिं प्रीतिमते नमः ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7000269111, "chapter_id": 20269, "verse_number": "१-२३-११२", "content_sanskrit": "नाभिं सौख्यसमुद्राय वामनाय तथोदरम् ।\nहृदयं हृदयेशाय स्तनावाह्लादकारिणे ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7000269112, "chapter_id": 20269, "verse_number": "१-२३-११३", "content_sanskrit": "उत्कंठायेति वै कंठमास्यमानंदकारिणे ।\nवामांसं पुष्पचापाय पुष्पबाणाय दक्षिणम् ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7000269113, "chapter_id": 20269, "verse_number": "१-२३-११४", "content_sanskrit": "मानसायेति वै मालि विलोलायेति मूर्द्धजम् ।\nसर्वात्मने शिरस्तद्वद्देवदेवस्य पूजयेत् ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7000269114, "chapter_id": 20269, "verse_number": "१-२३-११५", "content_sanskrit": "नमः शिवाय शांताय पाशांकुशधराय च ।\nगदिने पीतवस्त्राय शंखचक्रधराय च ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7000269115, "chapter_id": 20269, "verse_number": "१-२३-११६", "content_sanskrit": "नमो नारायणायेति कामदेवात्मने नमः ।\nनमः शांत्यै नमः प्रीत्यै नमारेत्यै नमः श्रियै ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7000269116, "chapter_id": 20269, "verse_number": "१-२३-११७", "content_sanskrit": "नमः पुष्ट्यै नमस्तुष्ट्यै नमः सर्वार्थसंपदे ।\nएवं संपूज्य गोविंदमनंगात्मकमीश्वरम् ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7000269117, "chapter_id": 20269, "verse_number": "१-२३-११८", "content_sanskrit": "गंधमाल्यैस्तथा धूपैर्नैवेद्येन च भामिनी ।\nतत आहूय धर्मज्ञं ब्राह्मणं वेदपारगम् ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7000269118, "chapter_id": 20269, "verse_number": "१-२३-११९", "content_sanskrit": "अव्यंगमथ संपूज्य गंधपुष्पार्चनादिभिः ।\nशालेयतंडुलप्रस्थं घृतपात्रेण संयुतम् ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7000269119, "chapter_id": 20269, "verse_number": "१-२३-१२०", "content_sanskrit": "तस्मै विप्राय वै दद्यान्माधवः प्रीयतामिति ।\nयथेष्टाहारसंभुक्तमेनं द्विजमनुत्तमम् ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7000269120, "chapter_id": 20269, "verse_number": "१-२३-१२१", "content_sanskrit": "रत्यर्थं कामदेवोयमिति चित्ते च धारयेत् ।\nयद्यदिच्छति विप्रेंद्रस्तत्तत्कुर्याद्विलासिनी ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7000269121, "chapter_id": 20269, "verse_number": "१-२३-१२२", "content_sanskrit": "सर्वभावेन चात्मानमर्पयेत्स्मितभाषिणी ।\nएवमादित्यवारेण सर्वमेतत्समाचरेत् ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7000269122, "chapter_id": 20269, "verse_number": "१-२३-१२३", "content_sanskrit": "तंडुलप्रस्थदानं च यावन्मासास्त्रयोदश ।\nततस्त्रयोदशे मासि संप्राप्ते चास्य भामिनी ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7000269123, "chapter_id": 20269, "verse_number": "१-२३-१२४", "content_sanskrit": "विप्रस्योपस्करैर्युक्तां शय्यां दद्याद्विचक्षणा ।\nसोपधानां सविन्यासां स्वास्तरावरणां शुभाम् ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7000269124, "chapter_id": 20269, "verse_number": "१-२३-१२५", "content_sanskrit": "दीपिकोपानहच्छत्र पादुकासनसंयुताम् ।\nसपत्नीकमलंकृत्य हेमसूत्रांगुलीयकैः ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7000269125, "chapter_id": 20269, "verse_number": "१-२३-१२६", "content_sanskrit": "सूक्ष्मवस्त्रैः सकटकैर्धूपमाल्यानुलेपनैः ।\nकामदेवं सपत्नीकं गुडकुंभोपरिस्थितम् ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7000269126, "chapter_id": 20269, "verse_number": "१-२३-१२७", "content_sanskrit": "ताम्रपात्रासनगतं हेमनेत्रपटावृतम् ।\nसुकांस्यभाजनोपेतमिक्षुदंडसमन्वितम् ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7000269127, "chapter_id": 20269, "verse_number": "१-२३-१२८", "content_sanskrit": "दद्यादनेन मंत्रेण तथैकां गां पयस्विनीम् ।\nयथांतरं न पश्यामि कामकेशवयोः सदा ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7000269128, "chapter_id": 20269, "verse_number": "१-२३-१२९", "content_sanskrit": "तथैव सर्वकामाप्तिरस्तु विप्र सदा मम ।\nतथा च कांचनं देवं प्रतिगृह्य द्विजोत्तमः ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7000269129, "chapter_id": 20269, "verse_number": "१-२३-१३०", "content_sanskrit": "कोदात्कामोदादिति वैदिकं मंत्रमुदीरयेत् ।\nततः प्रदक्षिणीकृत्य विसृज्य द्विजपुंगवम् ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7000269130, "chapter_id": 20269, "verse_number": "१-२३-१३१", "content_sanskrit": "शय्यासनादिकं सर्वं ब्राह्मणस्य गृहं नयेत् ।\nततः प्रभृति योऽन्योपि रत्यर्थं गेहमागतः ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7000269131, "chapter_id": 20269, "verse_number": "१-२३-१३२", "content_sanskrit": "सम्मान्य सूर्यवारेण स संपूज्यो भवेत्सदा ।\nएवं त्रयोदशं यावन्मासमेकं द्विजोत्तमम् ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7000269132, "chapter_id": 20269, "verse_number": "१-२३-१३३", "content_sanskrit": "तर्पयित्वा यथाकामं प्रेषयेच्चैव मंदिरम् ।\nतदनुज्ञया रूपवंतं यावदस्यागमो भवेत् ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7000269133, "chapter_id": 20269, "verse_number": "१-२३-१३४", "content_sanskrit": "आत्मनोपि यदा विघ्नं गर्भसूतकराजकम् ।\nदैवं वा मानुषं वा स्यादुपरागेण वा ततः ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7000269134, "chapter_id": 20269, "verse_number": "१-२३-१३५", "content_sanskrit": "सावारा नष्टपंचाशद्यथाशक्ति समर्पयेत् ।\nएतद्धि कथितं सम्यग्भवतीनां विशेषतः ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7000269135, "chapter_id": 20269, "verse_number": "१-२३-१३६", "content_sanskrit": "स्वधर्मोयं यतो भाव्यो वेश्यानामिह सर्वदा ।\nशय्यया त्यज्यते देव न कदाचिद्यथा भवान् ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7000269136, "chapter_id": 20269, "verse_number": "१-२३-१३७", "content_sanskrit": "शय्या ममाप्यशून्येयं तथास्तु मधुसूदन ।\nगीतवादित्रनिर्घोषं देवदेवस्य कारयेत् ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7000269137, "chapter_id": 20269, "verse_number": "१-२३-१३८", "content_sanskrit": "एतद्वः कथितं सर्वं वेश्याधर्ममशेषतः ।\nपुरुहूतेन यत्प्रोक्तं दानवीषु पुरा मया ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7000269138, "chapter_id": 20269, "verse_number": "१-२३-१३९", "content_sanskrit": "तदिदं सांप्रतं सर्वं भवतीष्वपि युज्यते ।\nसर्वपापप्रशमनमनंतफलदायकम् ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7000269139, "chapter_id": 20269, "verse_number": "१-२३-१४०", "content_sanskrit": "कल्याणिनीनां कथितं तदेतद्दुश्चरं व्रतम् ।\nकरोति याऽशेषमुदग्रमेतत्कल्याणिनी माधवलोकसंस्था ॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7000269140, "chapter_id": 20269, "verse_number": "१-२३-१४१", "content_sanskrit": "सा पूजिता देवगणैरशेषैरानंदकृत्स्थानमुपैति विष्णोः ।\nतपोधनः सोप्यभिधाय चैतदनंगदानव्रतमंगनानाम् ॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7000269141, "chapter_id": 20269, "verse_number": "१-२३-१४२", "content_sanskrit": "स्वस्थानमेष्यंति समस्तमित्थं व्रतं करिष्यंति च देवयोने ॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}]