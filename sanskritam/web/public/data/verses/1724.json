[{"id": 2033602, "chapter_id": 1724, "verse_number": "४-४७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2033603, "chapter_id": 1724, "verse_number": "४-४७-१", "content_sanskrit": "ततो दुर्योधनो राजा समरे भीष्ममब्रवीत्।\nद्रोणं च रथिशार्दूलं कृपं च सुमहाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2033604, "chapter_id": 1724, "verse_number": "४-४७-२", "content_sanskrit": "उक्तोऽयमर्थ आचार्य मया कर्णेन चासकृत्।\nपुनरेव च वक्ष्यामि न हि तृप्यामि तद्ब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2033605, "chapter_id": 1724, "verse_number": "४-४७-३", "content_sanskrit": "पराजितैर्विवस्तव्यं तैश्च द्वादशवत्सरान् ।\nवने जनपदेऽज्ञातैरेष एव पणो हि नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2033606, "chapter_id": 1724, "verse_number": "४-४७-४", "content_sanskrit": "तेषां न तावन्निर्वृत्तो वत्सरः स त्रयोदशः ।\nअज्ञातवासे बीभत्सुरथास्माभिः परिश्रुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2033607, "chapter_id": 1724, "verse_number": "४-४७-५", "content_sanskrit": "अनिर्वृत्ते तु निर्वासे यदि बीभत्सुरागतः ।\nपुनर्द्वादशवर्षाणि वने वत्स्यन्ति पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2033608, "chapter_id": 1724, "verse_number": "४-४७-६", "content_sanskrit": "लोभाद्वा ते न जानीयुरस्मान्वा मोह आविशत्।\nहीनातिरिक्तमेतेषां भीष्मो वेदितुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2033609, "chapter_id": 1724, "verse_number": "४-४७-७", "content_sanskrit": "अर्थानां हि पुनर्द्वैधे नित्यं भवति संशयः ।\nअन्यथा चिन्तितो ह्यर्थः पुनर्भवति चान्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2033610, "chapter_id": 1724, "verse_number": "४-४७-८", "content_sanskrit": "उत्तरं मार्गमाणानां मात्स्यसेनां युयुत्सताम् ।\nयदि बीभत्सुरायातः किंतु कृत्यमतः परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2033611, "chapter_id": 1724, "verse_number": "४-४७-९", "content_sanskrit": "त्रिगर्तानां कृतं कार्यं पाण्डवानां च मार्गणम् ।\nविप्रकारैर्हि मात्स्येन सुशर्मा बाधित पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2033612, "chapter_id": 1724, "verse_number": "४-४७-१०", "content_sanskrit": "तेषां भयाभिपन्नानां वस्तानां त्राणभिच्छताम् ।\nअभयं याचमानानां तदाऽस्माभिः परिश्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2033613, "chapter_id": 1724, "verse_number": "४-४७-११", "content_sanskrit": "प्रथमं वैर्ग्रहीतव्यं मात्स्यानां गोधनं महत्।\nअष्टम्याश्चापराह्णे तु इति नस्तैः समाहितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2033614, "chapter_id": 1724, "verse_number": "४-४७-१२", "content_sanskrit": "नवम्यां पुनरस्माभिः सूर्यस्योदयनं प्रति।\nइमा गावो ग्रहीतव्या याते मत्स्ये गवांपदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2033615, "chapter_id": 1724, "verse_number": "४-४७-१३", "content_sanskrit": "इत्येवं निश्चयोऽस्माकं मन्त्रोऽभून्नागसाह्वये ।\nपाण्डवानां परिज्ञाने सर्वेषां नः परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2033616, "chapter_id": 1724, "verse_number": "४-४७-१४", "content_sanskrit": "ते वा गाश्च नयिष्यन्ति यदि वा स्युः पराजिताः।\nअस्मान्वाऽप्यतिसन्धाय कुर्युर्मात्स्येन संगतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2033617, "chapter_id": 1724, "verse_number": "४-४७-१५", "content_sanskrit": "अथवा तानुपादाय मात्स्यो जानपदैः सह ।\nसर्वथा सेनया सार्धमस्मानेष युयुत्सति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2033618, "chapter_id": 1724, "verse_number": "४-४७-१६", "content_sanskrit": "तेषामेको महावीर्यः कश्चिदेव पुनःसरः।\nअस्माञ्जेतुमिहायातो मात्स्यो वाऽपि स्वयं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2033619, "chapter_id": 1724, "verse_number": "४-४७-१७", "content_sanskrit": "यद्येष राजा मात्स्यानां यदि बीभत्सुरागतः ।\nसर्वैर्योद्धव्यमस्माभिरिति नः समयः कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2033620, "chapter_id": 1724, "verse_number": "४-४७-१८", "content_sanskrit": "अथ कस्मात्थिता ह्येते रथेषु रथिसत्तमाः ।\nभीष्मद्रोणकृपाः कर्णो विकर्णो द्रौणिरेव च।\nसंभ्रान्तमनसः सर्वे प्राप्ते ह्यस्मिन्धनञ्जये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2033621, "chapter_id": 1724, "verse_number": "४-४७-१९", "content_sanskrit": "नान्यत्र युद्धाच्छ्रेयोस्ति तथाऽऽत्मा प्रणिधीयताम् ।\nसर्वलोकेन वा युद्धं देवैर्वाऽस्तु सवासवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2033622, "chapter_id": 1724, "verse_number": "४-४७-२०", "content_sanskrit": "अनाच्छिन्ने धनेऽस्माकमथ शक्रेण वज्रिणा।\nयमेन वाऽपि संग्रामे को हास्तिनपुरं व्रजेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2033623, "chapter_id": 1724, "verse_number": "४-४७-२१", "content_sanskrit": "शरैरभिप्रणुन्नानां भग्नानां गहने वने ।\nको हि जीवेत्पदातीनां भवेदश्वेषु संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2033624, "chapter_id": 1724, "verse_number": "४-४७-२२", "content_sanskrit": "आचार्यं पृष्ठतः कृत्वा तथा नीतिर्विधीयताम् ।\nजानामि च मतं तेषामतस्त्रासयतीव नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2033625, "chapter_id": 1724, "verse_number": "४-४७-२३", "content_sanskrit": "अर्जुने चापि संप्रीतिमधिकामुपलक्षये ।\nतथा दृष्ट्वा हि बीभत्सुमुपायान्तं प्रशंसति ।\nयथा सेना न भज्येत तथा नीतिर्विधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2033626, "chapter_id": 1724, "verse_number": "४-४७-२४", "content_sanskrit": "अदेशिका ह्यरण्येऽस्मिन्कृच्छ्रे शत्रुवशं गता।\nयथा न विभ्रमेत्सेना तथा नीतिर्विधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2033627, "chapter_id": 1724, "verse_number": "४-४७-२५", "content_sanskrit": "अश्वानां हेषितं श्रुत्वा का प्रशंसा भवेत्परे ।\nस्थाने वाऽपि व्रजन्तो वा सदा हेषन्ति वाजिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2033628, "chapter_id": 1724, "verse_number": "४-४७-२६", "content_sanskrit": "सदा च वायवो वान्ति नित्यं वर्षति वासवः ।\nस्तनयित्नोश्च निर्घोषः श्रूयते बहुशस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2033629, "chapter_id": 1724, "verse_number": "४-४७-२७", "content_sanskrit": "भीषयन्पाण्डवेयेभ्यो भवान्सर्वानिमाञ्जनान्।\nप्रमुखे सर्वसैन्यानामबद्धं बहु भाषते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2033630, "chapter_id": 1724, "verse_number": "४-४७-२८", "content_sanskrit": "यथैवाश्वान्मार्गमाणास्तानेवाभिपरीप्सवः ।\nहेषितानीव शृण्वन्ति तदिदं भवतस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2033631, "chapter_id": 1724, "verse_number": "४-४७-२९", "content_sanskrit": "किमत्र कार्यं पार्थस्य कथं वा स प्रशस्यते।\nअन्यत्र कामाद्द्वेषाद्वा रोषाद्वाऽस्मासु केवलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2033632, "chapter_id": 1724, "verse_number": "४-४७-३०", "content_sanskrit": "आचार्या वै कारुणिकाः प्राज्ञाश्चापायदर्शिनः ।\nनैते महाहवे घोरे संप्रष्टव्याः कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2033633, "chapter_id": 1724, "verse_number": "४-४७-३१", "content_sanskrit": "प्रासादेषु विचित्रेषु गोष्ठीपानाशनेषु च।\nकथा विचित्राः कुर्वाणाः पण्डितास्तत्र सोभनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2033634, "chapter_id": 1724, "verse_number": "४-४७-३२", "content_sanskrit": "बहून्याश्चर्यरूपाणि कुर्वते जनसंसदि ।\nइष्वस्त्रे चापसंधाने पण्डितास्तत्र शोभनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2033635, "chapter_id": 1724, "verse_number": "४-४७-३३", "content_sanskrit": "परेषां विवरज्ञाने मनुष्याचरितेषु च।\nअन्नसंस्कारदोषेषु पण्डितास्तत्र शोभनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2033636, "chapter_id": 1724, "verse_number": "४-४७-३४", "content_sanskrit": "पण्डितान्पृष्ठतः कृत्वा परेषां गुणवादिनः ।\nविधीयतां तथा नीतिर्यथा वध्येत वै परः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2033637, "chapter_id": 1724, "verse_number": "४-४७-३५", "content_sanskrit": "गावश्चैताः प्रतिष्ठन्तां सेनां व्यूहन्तु माचिरम्।\nआरक्षाश्च विधीयन्तां यत्र योत्स्यामहे परैः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2033638, "chapter_id": 1724, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि गोग्रहणपर्वणि सप्तचत्वारिंशोऽध्यायः ॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]