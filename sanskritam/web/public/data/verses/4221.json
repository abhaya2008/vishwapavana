[{"id": 2148822, "chapter_id": 4221, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2148823, "chapter_id": 4221, "verse_number": "१", "content_sanskrit": "वासुदेवस्य तद्वाक्यमनुस्मृत्य युधिष्ठिरः ।\nपुनः पप्रच्छ वार्ष्णेयं कथं मन्दोऽब्रवीदिदम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2148824, "chapter_id": 4221, "verse_number": "२", "content_sanskrit": "अस्मिन्नभ्यागते काले किञ्च नः क्षममच्युत ।\nकथं च वर्तमाना वै स्वधर्मान्न च्यवेमहि\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2148825, "chapter_id": 4221, "verse_number": "३", "content_sanskrit": "दुर्योधनस्य कर्णस्य शकुनेः सौबलस्य च ।\nवासुदेव मतज्ञोऽसि मम सभ्रातृकस्य च\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2148826, "chapter_id": 4221, "verse_number": "४", "content_sanskrit": "विदुरस्यापि तद्वाक्यं श्रुतं भीष्मस्य चोभयोः ।\nकुन्त्याश्च विपुलप्रज्ञ प्रज्ञा कार्त्स्न्येन ते श्रुता\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2148827, "chapter_id": 4221, "verse_number": "५", "content_sanskrit": "सर्वमेतदतिक्रम्य विचार्य च पुनः पुनः ।\nयन्नः क्षमं महाबाहो तद् ब्रवीह्यविचारयन्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2148828, "chapter_id": 4221, "verse_number": "६", "content_sanskrit": "श्रुत्वैतद् धर्मराजस्य धर्मार्थसहितं वचः ।\nमेघदुन्दुभिनिर्घोषः कृष्णो वाक्यमथाब्रवीत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2148829, "chapter_id": 4221, "verse_number": "७", "content_sanskrit": "उक्तवानस्मि यद्वाक्यं धर्मार्थसहितं हितम् ।\nन तु तन्निकृतिप्रज्ञे कौरवे प्रतितिष्ठति\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2148830, "chapter_id": 4221, "verse_number": "८", "content_sanskrit": "न च भीष्मस्य दुर्मेधाः शृणोति विदुरस्य वा ।\nमम वा भाषितं किञ्चित् सर्वमेतन्निरर्थकम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2148831, "chapter_id": 4221, "verse_number": "९", "content_sanskrit": "नैष कामयते धर्मं नैष कामयते यशः ।\nजितं स मन्यते सर्वं दुरात्मा कर्णमाश्रितः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2148832, "chapter_id": 4221, "verse_number": "१०", "content_sanskrit": "बन्धमाज्ञापयामास मम चापि सुयोधनः ।\nन च तं लब्धवान् कामं दुरात्मा शासनातिगः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2148833, "chapter_id": 4221, "verse_number": "११", "content_sanskrit": "न च भीष्मो न च द्रोणो युक्तं तत्राहतुर्वचः ।\nसर्वे तमनुवर्तन्ते ऋते विदुरमच्युत\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2148834, "chapter_id": 4221, "verse_number": "१२", "content_sanskrit": "शकुनिः सौबलश्चैव कर्णदुःशासनावपि ।\nत्वय्ययुक्तान्यभाषन्त मूढाः पण्डितमानिनः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2148835, "chapter_id": 4221, "verse_number": "१३", "content_sanskrit": "किञ्चैतेन मयोक्तेन यान्यभाषत कौरवः ।\nसङ्क्षेपेण दुरात्माऽसौ न युक्तं त्वयि वर्तते\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2148836, "chapter_id": 4221, "verse_number": "१४", "content_sanskrit": "पार्थिवेषु न सर्वेषु य इमे तव सैनिकाः ।\nयत् पापं यन्न कल्याणं सर्वं तस्मिन् प्रतिष्ठितम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2148837, "chapter_id": 4221, "verse_number": "१५", "content_sanskrit": "न चापि वयमत्यर्थं परित्यागेन कर्हिचित् ।\nकौरवैः शममिच्छामस्तत्र युद्धमनन्तरम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2148838, "chapter_id": 4221, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2148839, "chapter_id": 4221, "verse_number": "१६", "content_sanskrit": "तच्छ्रुत्वा पार्थिवाः सर्वे वासुदेवेन भाषितम् ।\nअब्रुवन्तो मुखं राज्ञः समुदैक्षन्त भारत\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2148840, "chapter_id": 4221, "verse_number": "१७", "content_sanskrit": "युधिष्ठिरस्त्वभिप्रायमभिलक्ष्य महीक्षिताम् ।\nयोगमाज्ञापयामास भीमार्जुनयमैः सह\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2148841, "chapter_id": 4221, "verse_number": "१८", "content_sanskrit": "ततः किलकिलाभूतम् अनीकं पाण्डवस्य ह ।\nआज्ञापिते तदा योगे समहृष्यन्त सैनिकाः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2148842, "chapter_id": 4221, "verse_number": "१९", "content_sanskrit": "अवध्यानां वधं पश्यन् धर्मराजो युधिष्ठिरः ।\nनिःश्वसन् भीमसेनं च विजयं चेदमब्रवीत्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2148843, "chapter_id": 4221, "verse_number": "२०", "content_sanskrit": "यदर्थं वनवासश्च प्राप्तं दुःखं च यन्मया ।\nसोऽयमस्मानुपैत्येव परोऽनर्थः प्रयत्नतः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2148844, "chapter_id": 4221, "verse_number": "२१", "content_sanskrit": "यस्मिन् यत्नः कृतोऽस्माभिः स नो हीनः प्रयत्नतः ।\nकृतेऽपि यत्नेऽस्मान् वै उपावृत्तः कलिर्महान्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2148845, "chapter_id": 4221, "verse_number": "२२", "content_sanskrit": "कथं ह्यवध्यैः सङ्ग्रामः कार्यः सह भविष्यति ।\nकथं हत्वा गुरून् वृद्धान् विजयो नो भविष्यति\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2148846, "chapter_id": 4221, "verse_number": "२३", "content_sanskrit": "तच्छ्रुत्वा धर्मराजस्य सव्यसाची परन्तपः ।\nयदुक्तं वासुदेवेन श्रावयामास तद्वचः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2148847, "chapter_id": 4221, "verse_number": "२४", "content_sanskrit": "उक्तवान् देवकीपुत्रः कुन्त्याश्च विदुरस्य च ।\nवचनं तत् त्वया राजन् निखिलेनावधारितम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2148848, "chapter_id": 4221, "verse_number": "२५", "content_sanskrit": "न च तौ वक्ष्यतोऽधर्ममिति मे नैष्ठिकी मतिः ।\nनापि युक्तं च कौन्तेय निवर्तितुमयुद्धतः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2148849, "chapter_id": 4221, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2148850, "chapter_id": 4221, "verse_number": "२६", "content_sanskrit": "तच्छ्रुत्वा वासुदेवोऽपि सव्यसाचिवचस्तदा ।\nस्मयमानोऽब्रवीद् वाक्यं पार्थमेवमिति ब्रुवन्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2148851, "chapter_id": 4221, "verse_number": "२७", "content_sanskrit": "ततस्ते धृतसङ्कल्पा युद्धाय सह सैनिकाः ।\nपाण्डवेया महाराज तां रात्रिं सुखमावसन्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2148852, "chapter_id": 4221, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि द्विपञ्चाशोत्तरशततमोऽध्यायः ॥१५२॥\nसैन्यनिर्याणपर्वणि तृतीयोऽध्यायः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2148853, "chapter_id": 4221, "verse_number": "", "content_sanskrit": "॥ समाप्तं सैन्यनिर्याणपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]