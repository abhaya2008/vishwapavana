[{"id": 7003769000, "chapter_id": 23769, "verse_number": "२-२-१३-१", "content_sanskrit": "मुनय ऊचुः॥  ।\nकपोतेशस्थली चापि कथं ख्याता महामुने ।\nको वा कपोतः कश्चेश एतन्नो वक्तुमर्हसि ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003769001, "chapter_id": 23769, "verse_number": "२-२-१३-२", "content_sanskrit": "जैमिनिरुवाच ।\nपुरा कुशस्थली सा वै असेव्या सर्वजंतुभिः ।\nतीक्ष्णधारैः कुशाग्रैस्तु परितः कंटकैश्चिता ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003769002, "chapter_id": 23769, "verse_number": "२-२-१३-३", "content_sanskrit": "निस्तरुर्निर्जलाधारा पिशाचवसतिर्यथा ।\nयदा पूर्वं भगवतो नान्यो देवोऽपि पूज्यते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003769003, "chapter_id": 23769, "verse_number": "२-२-१३-४", "content_sanskrit": "पूज्यः स्यामहमप्येवं स्पर्धासीद्धूर्जटेस्तदा ।\nचिंतयन्निति तस्यैव विष्णोर्भक्तौ मनोऽदधत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003769004, "chapter_id": 23769, "verse_number": "२-२-१३-५", "content_sanskrit": "सर्वनिर्विषये देशे स्थित्वाऽहं निष्परिग्रहः ।\nसुमहत्तप आस्थाय तोषयिष्यामि तं हरिम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003769005, "chapter_id": 23769, "verse_number": "२-२-१३-६", "content_sanskrit": "किं वदेयं रमेशाय का स्तुतिः शारदापतेः ।\nसर्वब्रह्मांडनाथस्य किं वान्यत्तुष्टिकारकम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003769006, "chapter_id": 23769, "verse_number": "२-२-१३-७", "content_sanskrit": "तस्मान्न बाह्यं वस्त्वन्यदुपयोगाय तस्य वै ।\nअंतर्यागं समास्थाय निर्व्यलीकेन चेतसा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003769007, "chapter_id": 23769, "verse_number": "२-२-१३-८", "content_sanskrit": "भक्तेभ्य आत्मप्रददं चराचरगुरुं हरिम् ।\nआराधयिष्ये सर्वेषां पूज्यः स्यां तत्प्रसादतः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003769008, "chapter_id": 23769, "verse_number": "२-२-१३-९", "content_sanskrit": "तत इत्यभिसंधाय ययौ पुण्यां कुशस्थलीम् ।\nसमीपे नीलगोत्रस्य सर्वद्वंद्वविवर्जितः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003769009, "chapter_id": 23769, "verse_number": "२-२-१३-१०", "content_sanskrit": "ततस्तेपे तपस्तीव्रं वायुभक्षो महेश्वरः ।\nकपोत इव सूक्ष्मोऽभूदष्टमूर्तिरपि प्रभुः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003769010, "chapter_id": 23769, "verse_number": "२-२-१३-११", "content_sanskrit": "ततः प्रसन्नो भगवानैश्वर्यं प्रददौ तदा ।\nयेनात्मतुल्यः संजातः पूजासंमाननादिषु ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003769011, "chapter_id": 23769, "verse_number": "२-२-१३-१२", "content_sanskrit": "तपःप्रभावात्तस्यासीत्स्थली वृन्दावनोपमा ।\nसरस्तडागसरसी नदीभिः शोभितांतरा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003769012, "chapter_id": 23769, "verse_number": "२-२-१३-१३", "content_sanskrit": "नानाद्रुमैर्लताभिश्च सर्वर्तुफलपुष्पकैः ।\nमधुमत्तद्विरेफाणां झंकारैर्मुखराशया ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003769013, "chapter_id": 23769, "verse_number": "२-२-१३-१४", "content_sanskrit": "नानापक्षिगणाकीर्णा सर्वजंतुसुखाश्रया ।\nकपोतसदृशो जातो यतः स तपसा शिवः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003769014, "chapter_id": 23769, "verse_number": "२-२-१३-१५", "content_sanskrit": "मुरारेराज्ञया सोऽत्र कपोतेश्वरतां गतः ।\nतदाज्ञयाऽत्र वसति मृडान्या त्र्यंबकः सदा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003769015, "chapter_id": 23769, "verse_number": "२-२-१३-१६", "content_sanskrit": "येऽर्चयन्ति कपोतेशं स्तुवन्ति प्रणमंति वा ।\nनिर्धूतकल्मषास्ते वै प्रयांति पुरुषोत्तमम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003769016, "chapter_id": 23769, "verse_number": "२-२-१३-१७", "content_sanskrit": "अतः परं प्रवक्ष्यामि बिल्वेशमहिमां द्विजाः ।\nपातालवासिनः पूर्वं दैत्या भित्त्वा महीतलम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003769017, "chapter_id": 23769, "verse_number": "२-२-१३-१८", "content_sanskrit": "उपद्रवंति भूर्लोकं भक्षयन्ति जनांस्तथा ।\nभारावतरणार्थाय देवकीगर्भसंभवः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003769018, "chapter_id": 23769, "verse_number": "२-२-१३-१९", "content_sanskrit": "पालयामास पृथिवीं यदा स भगवान्प्रभुः ।\nयादवैः पांडवैः सार्द्धं तदा तत्स्थानमागतः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003769019, "chapter_id": 23769, "verse_number": "२-२-१३-२०", "content_sanskrit": "तीर्थराजस्य सलिले स्नात्वा तं नीलमाधवम् ।\nदूरात्प्रणम्य मनसा दैत्यद्वारमुपागतः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003769020, "chapter_id": 23769, "verse_number": "२-२-१३-२१", "content_sanskrit": "दृष्ट्वा तद्विवरं घोरमप्रवेश्यं तु मानवैः ।\nभ्रांत्या संमोहयंल्लोकान्प्रथयञ्छिवपूज्यताम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003769021, "chapter_id": 23769, "verse_number": "२-२-१३-२२", "content_sanskrit": "बैल्वं फलं समादाय तत्रावाह्य त्रिलोचनम् ।\nपूजयित्वा पुरारातिं तुष्टावासुरसूदनः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003769022, "chapter_id": 23769, "verse_number": "२-२-१३-२३", "content_sanskrit": "श्री भगवानुवाच ।\nनमस्ते त्रिगुणातीत गुणत्रयविभागकृत् ।\nत्रयीमय त्रयातीत त्रिकालज्ञानिने नमः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003769023, "chapter_id": 23769, "verse_number": "२-२-१३-२४", "content_sanskrit": "शशिसूर्याग्निनेत्राय ब्रह्मण्याय वरात्मने ।\nअष्टैश्वर्यनिधानाय तुभ्यमष्टात्मने नमः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003769024, "chapter_id": 23769, "verse_number": "२-२-१३-२५", "content_sanskrit": "यस्य रूपं तमःपारे तमोनाशनमव्ययम् ।\nअज्ञानानां तमश्छिन्नं तस्मै वितमसे नमः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003769025, "chapter_id": 23769, "verse_number": "२-२-१३-२६", "content_sanskrit": "एवं स्वमात्मनात्मानं स्तुत्वा स भगवान्प्रभुः ।\nतस्य प्रसादाद्विवरं सुप्रवेशमपश्यत ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003769026, "chapter_id": 23769, "verse_number": "२-२-१३-२७", "content_sanskrit": "तेन मार्गेण पातालं ससैन्योऽभ्यगमत्प्रभुः ।\nहत्वा तत्र बलोदग्रान्दैत्यान्भारावतारणः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003769027, "chapter_id": 23769, "verse_number": "२-२-१३-२८", "content_sanskrit": "पुनरागम्य तत्रैव स्थित्वा स वृषभध्वजम् ।\nसंपूज्य भगवान्द्वाररोधाय स्थापयञ्छिवम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003769028, "chapter_id": 23769, "verse_number": "२-२-१३-२९", "content_sanskrit": "इदमाह महाबुद्धिर्भक्तिवश्यो गदाधरः ।\nधूर्जटे तिष्ठ प्रासादे रुन्धानोऽसुर निर्गमम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003769029, "chapter_id": 23769, "verse_number": "२-२-१३-३०", "content_sanskrit": "त्वदन्यः कः क्षमः शंभो कर्बूरबलनाशने ।\nस्थापयित्वा महादेवं ततो द्वारावतीं ययौ ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003769030, "chapter_id": 23769, "verse_number": "२-२-१३-३१", "content_sanskrit": "ततःप्रभृति बिल्वेशः पृथिव्यां ख्यातिमागतः ।\nपूर्वविधिः स बिल्वेशः क्षेत्रराजस्य भो द्विजाः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003769031, "chapter_id": 23769, "verse_number": "२-२-१३-३२", "content_sanskrit": "तं दृष्ट्वा पापहंतारं मृड्रानीपतिमव्ययम् ।\nसर्वान्कामानवाप्नोति विपत्तिं दुस्तरां जयेत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003769032, "chapter_id": 23769, "verse_number": "२-२-१३-३३", "content_sanskrit": "कपोतबिल्वेश्वरयोर्माहात्म्यं कथितं तु वः ।\nअतः परं भो मुनयः किमन्यच्छ्रोतुमिच्छथ ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003769033, "chapter_id": 23769, "verse_number": "२-२-१३-३४", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां द्वितीये वैष्णवखण्डे पुरुषोत्तमक्षेत्रमाहात्म्ये जैमिनिऋषिसंवादे त्रयोदशोऽध्यायः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]