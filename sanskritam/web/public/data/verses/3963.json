[{"id": 2136659, "chapter_id": 3963, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2136660, "chapter_id": 3963, "verse_number": "१", "content_sanskrit": "ततः क्रुद्धो दशग्रीवः प्रिये पुत्रे निपातिते ।\nनिर्ययौ रथमास्थाय हेमरत्नविभूषितम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2136661, "chapter_id": 3963, "verse_number": "२", "content_sanskrit": "स वृतो राक्षसैर्घोरैर्विविधायुधपाणिभिः ।\nअभिदुद्राव रामं स योधयन् हरियूथपान् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2136662, "chapter_id": 3963, "verse_number": "३", "content_sanskrit": "तमाद्रवन्तं सङ्क्रुद्धं मैन्दनीलनलाङ्गदाः ।\nहनूमान् जाम्बवांश्चैव ससैन्याः पर्यवारयन् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2136663, "chapter_id": 3963, "verse_number": "४", "content_sanskrit": "ते दशग्रीवसैन्यं तदृक्षवानरपुङ्गवाः।\nद्रुमैर्विध्वंसयाञ्चक्रुर्दशग्रीवस्य पश्यतः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2136664, "chapter_id": 3963, "verse_number": "५", "content_sanskrit": "ततः स सैन्यमालोक्य वध्यमानमरातिभिः ।\nमायावी चासृजन्मायां रावणो राक्षसाधिपः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2136665, "chapter_id": 3963, "verse_number": "६", "content_sanskrit": "तस्य देहविनिष्क्रान्ताः शतशोऽथ सहस्रशः ।\nराक्षसाः प्रत्यदृश्यन्त शरशक्त्यृष्टिपाणयः\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2136666, "chapter_id": 3963, "verse_number": "७", "content_sanskrit": "तान् रामो जघ्निवान् सर्वान् दिव्येनास्त्रेण राक्षसान् ।\nअथ भूयोऽपि मायां स व्यदधाद् राक्षसाधिपः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2136667, "chapter_id": 3963, "verse_number": "८", "content_sanskrit": "कृत्वा रामस्य रूपाणि लक्ष्मणस्य च भारत ।\nअभिदुद्राव रामं च लक्ष्मणं च दशाननः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2136668, "chapter_id": 3963, "verse_number": "९", "content_sanskrit": "ततस्ते राममार्छन्तो लक्ष्मणं च क्षपाचराः ।\nअभिपेतुस्तदा रामं प्रगृहीतशरासनाः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2136669, "chapter_id": 3963, "verse_number": "१०", "content_sanskrit": "तां दृष्ट्वा राक्षसेन्द्रस्य मायामिक्ष्वाकुनन्दनः ।\nउवाच रामं सौमित्रिरसम्भ्रान्तो बृहद्वचः ।\nजहीमान् राक्षसान् पापानात्मनः प्रतिरूपकान् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2136670, "chapter_id": 3963, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2136671, "chapter_id": 3963, "verse_number": "११", "content_sanskrit": "ततो हर्यश्वयुक्तेन रथेनादित्यवर्चसा ।\nउपतस्थे रणे रामं मातलिः शक्रसारथिः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2136672, "chapter_id": 3963, "verse_number": "", "content_sanskrit": "मातलिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2136673, "chapter_id": 3963, "verse_number": "१२", "content_sanskrit": "अयं हर्यश्वयुगजैत्रो मघोनः स्यन्दनोत्तमः ।\nत्वदर्थमिह सम्प्राप्तः सन्देहाद् वै शतक्रतोः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2136674, "chapter_id": 3963, "verse_number": "१३", "content_sanskrit": "अनेन शक्रः काकुत्स्थ समरे दैत्यदानवान् ।\nशतशः पुरुषव्याघ्र रथोदारेण जघ्निवान् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2136675, "chapter_id": 3963, "verse_number": "१४", "content_sanskrit": "तदनेन नरव्याघ्र मया यत् तेन संयुगे ।\nस्यन्दनेन जहि क्षिप्रं रावणं माचिरं कृथाः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2136676, "chapter_id": 3963, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2136677, "chapter_id": 3963, "verse_number": "१५", "content_sanskrit": "इत्युक्तो राघवस्तथ्यं वचोऽशङ्कत मातलेः ।\nमायैषा राक्षसस्येति तमुवाच विभीषणः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2136678, "chapter_id": 3963, "verse_number": "", "content_sanskrit": "विभीषणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2136679, "chapter_id": 3963, "verse_number": "१६", "content_sanskrit": "नेयं माया नरव्याघ्र रावणस्य दुरात्मनः ।\nतदातिष्ठ रथं शीघ्रमिममैन्द्रं महाद्युते \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2136680, "chapter_id": 3963, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2136681, "chapter_id": 3963, "verse_number": "१७", "content_sanskrit": "ततः प्रहृष्टः काकुत्स्थस्तथेत्युक्त्वा विभीषणम् ।\nरथेनाभिपपाताथ दशग्रीवं रुषान्वितः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2136682, "chapter_id": 3963, "verse_number": "१८", "content_sanskrit": "हाहाकृतानि भूतानि रावणे समभिद्रुते।\nसिंहनादाः सपटहा दिवि दिव्यास्तथानदन् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2136683, "chapter_id": 3963, "verse_number": "१९", "content_sanskrit": "ततः प्रववृते युद्धं रामरावणयोर्महत् ।\nदशकन्धरराजसून्वोस्तथा युद्धमभून्महत् ।\nअलब्धोपममन्यत्र तयोरेव तथाभवत् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2136684, "chapter_id": 3963, "verse_number": "२०", "content_sanskrit": "स रामाय महाघोरं विससर्ज निशाचरः ।\nशूलमिन्द्राशनिप्रख्यं ब्रह्मदण्डमिवोद्यतम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2136685, "chapter_id": 3963, "verse_number": "२१", "content_sanskrit": "तच्छूलं सत्वरं रामश्चिच्छेद निशितैः शरैः ।\nतद् दृष्ट्वा दुष्करं कर्म रावणं भयमाविशत् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2136686, "chapter_id": 3963, "verse_number": "२२", "content_sanskrit": "ततः क्रुद्धः ससर्जाशु दशग्रीवः शिताञ्छरान् ।\nसहस्रायुतशो रामे शस्त्राणि विविधानि च \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2136687, "chapter_id": 3963, "verse_number": "२३", "content_sanskrit": "ततो भुशुण्डीः शूलानि मुसलानि परश्वधान् ।\nशक्तीश्च विविधाकाराः शतघ्नीश्च शितान् क्षुरान् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2136688, "chapter_id": 3963, "verse_number": "२४", "content_sanskrit": "तां मायां विकृतां दृष्ट्वा दशग्रीवस्य रक्षसः ।\nभयात् प्रदुद्रुवुः सर्वे वानराः सर्वतो दिशम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2136689, "chapter_id": 3963, "verse_number": "२५", "content_sanskrit": "ततः सुपत्रं सुमुखं हेमपुङ्खं शरोत्तमम् ।\nतूणादादाय काकुत्स्थो ब्रह्मास्त्रेण युयोज ह \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2136690, "chapter_id": 3963, "verse_number": "२६", "content_sanskrit": "तं बाणवर्यं रामेण ब्रह्मास्त्रेणानुमन्त्रितम् ।\nजहृषुर्देवगन्धर्वा दृष्ट्वा शक्रपुरोगमाः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2136691, "chapter_id": 3963, "verse_number": "२७", "content_sanskrit": "अल्पावशेषमायुश्च ततोऽमन्यन्त रक्षसः ।\nब्रह्मास्त्रोदीरणाच्छत्रोर्देवदानवकिन्नराः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2136692, "chapter_id": 3963, "verse_number": "२८", "content_sanskrit": "ततः ससर्ज तं रामः शरमप्रतिमौजसम् ।\nरावणान्तकरं घोरं ब्रह्मदण्डमिवोद्यतम् \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2136693, "chapter_id": 3963, "verse_number": "२९", "content_sanskrit": "मुक्तमात्रेण रामेण दूराकृष्टेन भारत ।\nस तेन राक्षसश्रेष्ठः सरथः साश्वसारथिः ।\nप्रजज्वाल महाज्वालेनाग्निनाभिपरिप्लुतः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2136694, "chapter_id": 3963, "verse_number": "३०", "content_sanskrit": "ततः प्रहृष्टास्त्रिदशाः सहगन्धर्वचारणाः ।\nनिहतं रावणं दृष्ट्वा रामेणाक्लिष्टकर्मणा \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2136695, "chapter_id": 3963, "verse_number": "३१", "content_sanskrit": "तत्यजुस्तं महाभागं पञ्च भूतानि रावणम् ।\nभ्रंशितः सर्वलोकेषु(भ्यः) स हि ब्रह्मास्त्रतेजसा \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2136696, "chapter_id": 3963, "verse_number": "३२", "content_sanskrit": "शरीरधातवो ह्यस्य मांसं रुधिरमेव च ।\nनेशुर्ब्रह्मास्त्रनिर्दग्धा न च भस्माप्यदृश्यत \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2136697, "chapter_id": 3963, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि रामोपाख्यानपर्वणि रावणवधे एकोनाशीत्यधिकद्विशततमोऽध्यायः ॥२७९॥\nरामोपाख्यानपर्वणि एकोनविंशोऽध्यायः ॥१९॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]