[{"id": 2042419, "chapter_id": 1947, "verse_number": "५-१९३-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2042420, "chapter_id": 1947, "verse_number": "५-१९२-१", "content_sanskrit": "शिखण्डिवाक्यं श्रुत्वाऽथ स यक्षो भरतर्षभ ।\nप्रोवाच मनसा चिन्त्य दैवेनोपनिपीडितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2042421, "chapter_id": 1947, "verse_number": "५-१९२-२", "content_sanskrit": "भवितव्यं तथा तद्धि मम दुःखाय कौरव।\nभद्रे कामं करिष्यामि समयं तु निबोध मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2042422, "chapter_id": 1947, "verse_number": "५-१९२-३", "content_sanskrit": "`स्वं ते पुंस्त्वं प्रदास्यामि स्त्रीत्वं धारयिताऽस्मि ते\nकिंचित्कालं तु ते दास्ये पुल्लिङ्गं स्वमिदं तव।\nआगन्तव्यं त्वया काले सत्यं चैव वदस्व मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2042423, "chapter_id": 1947, "verse_number": "५-१९२-४", "content_sanskrit": "प्रभुः संकल्पसिद्धोऽस्मि कामचारी विहंगमः ।\nमत्प्रसादात्पुरं चैव त्राहि बन्धूंश्च केवलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2042424, "chapter_id": 1947, "verse_number": "५-१९२-५", "content_sanskrit": "स्त्रीलिङ्गं धारयिष्यामि तवेदं पार्थिवात्मजे।\nसत्यं मे प्रतिजानीहि करिष्यामि प्रियं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2042425, "chapter_id": 1947, "verse_number": "५-१९२-६x", "content_sanskrit": "शिखण्ड्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2042426, "chapter_id": 1947, "verse_number": "५-१९२-६", "content_sanskrit": "प्रतिदास्यामि भगवन्पुलिङ्गं तव सुव्रत।\nकिंचित्कालान्तरं स्त्रीत्वं धारयस्व निशाचर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2042427, "chapter_id": 1947, "verse_number": "५-१९२-७", "content_sanskrit": "प्रतियाते दशार्णे तु पार्थिवे हेमवर्मणि ।\nकन्यैव हि भविष्यामि पुरुषस्त्वं भविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2042428, "chapter_id": 1947, "verse_number": "५-१९२-८x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2042429, "chapter_id": 1947, "verse_number": "५-१९२-८", "content_sanskrit": "इत्युक्त्वा समयं तत्र चक्राते तावुभौ नृप ।\nअन्योन्यस्यानभिद्रोहे तौ संक्रामयतां ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2042430, "chapter_id": 1947, "verse_number": "५-१९२-९", "content_sanskrit": "स्त्रीलिङ्गं धारयामास स्थूणो यक्षोऽथ भारत ।\nयक्षरूपं च तद्दीप्तं शिखण्डी प्रत्यपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2042431, "chapter_id": 1947, "verse_number": "५-१९२-१०", "content_sanskrit": "ततः शिखण्डी पाञ्चाल्यः पुंस्त्वमासाद्य पार्थिव ।\nविवेश नगरं हृष्टः पितरं च समासदत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2042432, "chapter_id": 1947, "verse_number": "५-१९२-११", "content_sanskrit": "यथावृत्तं तु तत्सर्वमाचख्यौ द्रुपदस्य तत्।\n`मातुश्च रहिते राजन्प्रसादं यक्षजं तदा।\nद्रुपदस्तस्य तच्छ्रुत्वा हर्षमाहारयत्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2042433, "chapter_id": 1947, "verse_number": "५-१९२-१२", "content_sanskrit": "सभार्यस्तच्च सस्मार महेश्वरवचस्तदा ।\nततः संप्रेषयामास दशार्णाधिपतेर्नृपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2042434, "chapter_id": 1947, "verse_number": "५-१९२-१३", "content_sanskrit": "पुरुषोऽयं मम सुतः श्रद्धत्तां मे भवानिति ।\nअथ दाशार्णको राजा सहसाभ्यागमत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2042435, "chapter_id": 1947, "verse_number": "५-१९२-१४", "content_sanskrit": "पाञ्चालराजं द्रुपदं दुःखशोकसमन्वितः।\nततः काम्पिल्यमासाद्य दशार्णाधिपतिस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2042436, "chapter_id": 1947, "verse_number": "५-१९२-१५", "content_sanskrit": "प्रेषयामास सत्कृत्य दूतं ब्रह्मविदां वरम्।\nब्रूहि मद्वचनाद्दूत पाञ्चाल्यं तं नृपाधमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2042437, "chapter_id": 1947, "verse_number": "५-१९२-१६", "content_sanskrit": "यन्मे कन्यां स्वकन्यार्थे वृतवानसि दुर्मते।\nफलं तस्यावलेपस्य द्रक्ष्यस्यद्य न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2042438, "chapter_id": 1947, "verse_number": "५-१९२-१७", "content_sanskrit": "एवमुक्तश्च तेनासौ ब्राह्मणो राजसत्तम।\nदूतः प्रयातो नगरं दाशार्णनृपचोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2042439, "chapter_id": 1947, "verse_number": "५-१९२-१८", "content_sanskrit": "ततः आसादयामास पुरोधा द्रुपदं पुरे।\nतस्मै पाञ्चालको राजा गामर्घ्यं च सुसत्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2042440, "chapter_id": 1947, "verse_number": "५-१९२-१९", "content_sanskrit": "प्रापयामास राजेन्द्र सह तेन शिखण्डिना ।\nतां पूजां नाभ्यनन्दत्स वाक्यं चेदमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2042441, "chapter_id": 1947, "verse_number": "५-१९२-२०", "content_sanskrit": "यदुक्तं तेन वीरेण राज्ञा काञ्चनवर्मणा ।\nयत्तेऽहमधमाचार दुहित्राऽस्म्यभिवञ्चितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2042442, "chapter_id": 1947, "verse_number": "५-१९२-२१", "content_sanskrit": "तस्य पापस्य करणात्फलं प्राप्नुहि दुर्मते ।\nदेहि युद्धं नरपते ममाद्य रणमूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2042443, "chapter_id": 1947, "verse_number": "५-१९२-२२", "content_sanskrit": "उद्धरिष्यामि ते सद्यः सामात्यसुतबान्धवम् ।\nतदुपालम्भसंयुक्तं श्रावितः किल पार्थिवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2042444, "chapter_id": 1947, "verse_number": "५-१९२-२३", "content_sanskrit": "दशार्णपतिना चोक्तो मन्त्रिमध्ये पुरोधसा।\nअभवद्भरतश्रेष्ठ द्रुपदः प्रणयानतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2042445, "chapter_id": 1947, "verse_number": "५-१९२-२४", "content_sanskrit": "यदाह मां भवान्ब्रह्मन्संबन्धिवचनाद्वचः ।\nअस्योत्तरं प्रतिवचो दूतो राज्ञे वदिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2042446, "chapter_id": 1947, "verse_number": "५-१९२-२५", "content_sanskrit": "ततः संप्रेषयामास द्रुपदोऽपि महात्मने ।\nहिरण्यवर्मणे दूतं ब्राह्मणं वेदपारगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2042447, "chapter_id": 1947, "verse_number": "५-१९२-२६", "content_sanskrit": "तमागम्य तु राजानं दशार्णाधिपतिं तदा।\nतद्वाक्यमाददे राजन्यदुक्तं द्रुपदेन ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2042448, "chapter_id": 1947, "verse_number": "५-१९२-२७", "content_sanskrit": "आगमः क्रियतां व्यक्तः कुमारोऽयं सुतो मम ।\nमिथ्यैतदुक्तं केनापि तदश्रद्धेयमित्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2042449, "chapter_id": 1947, "verse_number": "५-१९२-२८", "content_sanskrit": "ततः स राजा द्रुपदस्य श्रुत्वा।\nविमर्शयुक्तो युवतीर्वरिष्ठाः।\nसंप्रेषयामास सुचारुरूपाः\nशिखण्डिनं स्त्रीपुमान्वेति वेत्तुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2042450, "chapter_id": 1947, "verse_number": "५-१९२-२९", "content_sanskrit": "ताः प्रेषितास्तत्त्वभावं विदित्वा\nप्रीत्या राज्ञे तच्छशंसुर्हि सर्वम् ।\nशिखण्डिनं पुरुषं कौरवेन्द्र\nदाशार्णराजाय महानुभावम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2042451, "chapter_id": 1947, "verse_number": "५-१९२-३०", "content_sanskrit": "ततः कृत्वा तु राजा स आगमं प्रीतिमानथ।\nसंबन्धिना समागम्य हृष्टो वासमुवास ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2042452, "chapter_id": 1947, "verse_number": "५-१९२-३१", "content_sanskrit": "शिखण्डिने च मुदितः प्रादाद्वित्तं जनेश्वरः ।\nहस्तिनोऽश्वांश्च गाश्चैव दासीर्बहुशतास्तथा । ५-१९२०३१c पूजितश्च प्रतिययौ निर्भर्त्स्य तनयां किल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2042453, "chapter_id": 1947, "verse_number": "५-१९२-३२", "content_sanskrit": "विनीतकिल्विषे प्रीते हेमवर्मणि पार्थिवे ।\nप्रतियाते दशार्णे तु हृष्टरूपा शिखण्डिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2042454, "chapter_id": 1947, "verse_number": "५-१९२-३३", "content_sanskrit": "कस्यचित्त्वथ कालस्य कुबेरो नरवाहनः ।\nलोकयात्रां प्रकुर्वाणः स्थूणस्यागान्निवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2042455, "chapter_id": 1947, "verse_number": "५-१९२-३४", "content_sanskrit": "स नद्गृहस्योपरि वतमान\nआलोकयामास धनाधिगोप्ता।\nस्थूणस्य यक्षस्य विवेश वेश्म\nस्वलंकृतं माल्यगुणैर्विचित्रैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2042456, "chapter_id": 1947, "verse_number": "५-१९२-३५", "content_sanskrit": "लाचैश्च गन्धैश्च तथा वितानै-\nरभ्यर्चितं धृनधृपितं च।\nध्वजैः पताकाभिरलंकृतं च\nभक्ष्यान्नपेयामिपदत्तमोदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2042457, "chapter_id": 1947, "verse_number": "५-१९२-३६", "content_sanskrit": "तत्स्थानं तस्य दृष्ट्वा तु सर्वतः समलंकृतम्।\nमणिरत्नसुवर्णानां मालाभिः परिपूरितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2042458, "chapter_id": 1947, "verse_number": "५-१९२-३७", "content_sanskrit": "नानाकुसूमगन्धाढ्यं सिक्तसंमृष्टशोभितम् ।\nअथाब्रवीद्यक्षपतिस्तान्यक्षाननुगांस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2042459, "chapter_id": 1947, "verse_number": "५-१९२-३८", "content_sanskrit": "स्वलंकृतमिदं वेश्म स्थूणस्यामितविक्रमाः ।\nनोपसर्पति मां चैव कस्मादद्य स मन्दधीः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2042460, "chapter_id": 1947, "verse_number": "५-१९२-३९", "content_sanskrit": "यस्माज्जानन्स मन्दात्मा मामसौ नोपसर्पति ।\nतस्मात्तस्मै महादण्डो धार्यः स्यादिति मे मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2042461, "chapter_id": 1947, "verse_number": "५-१९२-४०x", "content_sanskrit": "यक्षा ऊचुः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2042462, "chapter_id": 1947, "verse_number": "५-१९२-४०", "content_sanskrit": "द्रुपदस्य सुता राजन्राज्ञो जाता शिखण्डिनी।\nतस्या निमित्ते कस्मिंश्चित्प्रादात्पुरुषलक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2042463, "chapter_id": 1947, "verse_number": "५-१९२-४१", "content_sanskrit": "अग्रहील्लक्षणं स्त्रीणां स्त्रीभूता तिष्ठते गृहे।\nनोपसर्पति तेनासौ सव्रीडः स्त्रीसरूपवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2042464, "chapter_id": 1947, "verse_number": "५-१९२-४२", "content_sanskrit": "एतस्मात्कारणाद्राजन्स्थूणो न त्वाऽद्य सर्पति।\nश्रुत्वा कुरु यथान्यायं विमानमिह तिष्ठताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2042465, "chapter_id": 1947, "verse_number": "५-१९२-४३", "content_sanskrit": "आनीयतां स्थूण इति ततो यक्षाधिपोऽब्रवीत् ।\nकर्तास्मि निग्रहं तस्य प्रत्युवाच पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2042466, "chapter_id": 1947, "verse_number": "५-१९२-४४", "content_sanskrit": "सोऽभ्यगच्छत यक्षेन्द्रमाहूतः पृथिवीपते।\nस्त्रीमरूपो महाराज तस्थौ व्रीडासमन्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2042467, "chapter_id": 1947, "verse_number": "५-१९२-४५", "content_sanskrit": "तं शशापाथ संक्रुद्धो धनदः कुरूनन्दन ।\nएवमेव भवत्वद्य स्त्रीत्वं पापस्य गुह्यकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2042468, "chapter_id": 1947, "verse_number": "५-१९२-४६", "content_sanskrit": "ततोऽब्रवीद्यक्षपतिर्महात्मा\nयस्माददास्त्ववमन्येह यक्षान्।\nशिखण्डिनो लक्षणं पापबुद्धे\nस्त्रीलक्षणं चाग्रहीः पापकर्मन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2042469, "chapter_id": 1947, "verse_number": "५-१९२-४७", "content_sanskrit": "अप्रवृत्तं सुदुर्बुद्धे यस्मादेतत्त्वया कृतम्।\nतस्मादद्य प्रभृत्येव स्त्री त्वं सा पुरुषस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2042470, "chapter_id": 1947, "verse_number": "५-१९२-४८", "content_sanskrit": "ततः प्रसादयामासुर्यक्षा वैश्रवणं किल।\nस्थूणस्यार्थे कुरुष्वान्तं शापस्येति पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2042471, "chapter_id": 1947, "verse_number": "५-१९२-४९", "content_sanskrit": "ततो महात्मा यक्षेन्द्रः प्रत्युवाचानुगामिनः ।\nसर्वान्यक्षगणांस्तात शापस्यान्तचिकीर्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2042472, "chapter_id": 1947, "verse_number": "५-१९२-५०", "content_sanskrit": "शिखण्डिनि हते यक्षाः स्वं रूपं प्रतिपत्स्यते ।\nस्थूणो यक्षो निरुद्वेगो भवत्विति महामनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2042473, "chapter_id": 1947, "verse_number": "५-१९२-५१", "content_sanskrit": "इत्युक्त्वा भगवान्देवो यक्षराजः सुपूजितः ।\nप्रययौ सहितः सर्वैर्निमेषान्तरचारिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2042474, "chapter_id": 1947, "verse_number": "५-१९२-५२", "content_sanskrit": "स्थूणस्तु शापं संप्राप्य तत्रैव न्यवसत्तदा।\nसमये चागमूत्तूर्णं शिखण्डी तं क्षपाचरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2042475, "chapter_id": 1947, "verse_number": "५-१९२-५३", "content_sanskrit": "सोऽभिगम्याब्रवीद्वाक्यं प्राप्तोऽस्मि भगवन्निति।\nतमब्रवीत्ततः स्थूणः प्रीतोऽस्मीति पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2042476, "chapter_id": 1947, "verse_number": "५-१९२-५४", "content_sanskrit": "आर्जवेनागतं दृष्ट्वा राजपुत्रं शिखण्डिनम् ।\nसर्वमेव यथावृत्तमाचचक्षे शिखण्डिने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2042477, "chapter_id": 1947, "verse_number": "५-१९२-५५x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2042478, "chapter_id": 1947, "verse_number": "५-१९२-५५", "content_sanskrit": "शप्तो वैश्रवणेनाहं त्वत्कृते पार्थिवात्मज ।\nगच्छेदानीं यथाकामं चर लोकान्यथासुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2042479, "chapter_id": 1947, "verse_number": "५-१९२-५६", "content_sanskrit": "दिष्टमेतत्पुरा मन्ये न शक्यमतिवर्तितुम् ।\nगमनं तव चेतो हि पौलस्त्यस्य च दर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2042480, "chapter_id": 1947, "verse_number": "५-१९२-५७x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2042481, "chapter_id": 1947, "verse_number": "५-१९२-५७", "content_sanskrit": "एवमुक्तः शिखण्डी तु स्थूणयक्षेण भारत ।\nप्रत्याजगाम नगरं हर्वेण महतावृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2042482, "chapter_id": 1947, "verse_number": "५-१९२-५८", "content_sanskrit": "पूजयामास विविधैर्गन्धमाल्यैर्महाधनैः ।\nद्विजातीन्देवताश्चैव चैत्यानथ चतुष्पथान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2042483, "chapter_id": 1947, "verse_number": "५-१९२-५९", "content_sanskrit": "द्रुपदः सह पुत्रेण सिद्धार्थेन शिखण्डिना ।\nमुदं च परमां लेभे पाञ्चाल्यः सह बान्धवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2042484, "chapter_id": 1947, "verse_number": "५-१९२-६०", "content_sanskrit": "शिष्यार्थं प्रददौ चाथ द्रोणाय कुरुपुङ्गव ।\nशिखण्डिनं महाराज पुत्रं स्त्रीपूर्विणं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2042485, "chapter_id": 1947, "verse_number": "५-१९२-६१", "content_sanskrit": "प्रतिपेदे चतुष्पादं धनुर्वेदं नृपात्मजः।\nशिखण्डी सह युष्माभिर्धृष्टद्युम्नश्च पार्षतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2042486, "chapter_id": 1947, "verse_number": "५-१९२-६२", "content_sanskrit": "मम त्वेतच्चरास्तात यथावत्प्रत्यवेदयन् ।\nजडान्धबधिराकारा ये मुक्ता द्रपदे मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2042487, "chapter_id": 1947, "verse_number": "५-१९२-६३", "content_sanskrit": "एवमेष महाराज स्त्री पुमान्द्रुपदात्मजः ।\nस संभूतः कुरुश्रेष्ठ शिखण्डी रथसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2042488, "chapter_id": 1947, "verse_number": "५-१९२-६४", "content_sanskrit": "ज्येष्ठा काशिपतेः कन्या अम्बा नामेति विश्रुता ।\nद्रुपदस्य कुले जाता शिखण्डी भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2042489, "chapter_id": 1947, "verse_number": "५-१९२-६५", "content_sanskrit": "नाहमेनं धनुष्पाणिं युयुत्सुं समुपस्थितम् ।\nमुहूर्तमपि पश्येयं प्रहरेयं न चाप्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2042490, "chapter_id": 1947, "verse_number": "५-१९२-६६", "content_sanskrit": "व्रतमेतन्मम सदा पृथिव्यामपि विश्रुतम् ।\nस्त्रियां स्त्रीपूर्वके चैव स्त्रीनाम्नि स्त्रीसरूपिणि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2042491, "chapter_id": 1947, "verse_number": "५-१९२-६७", "content_sanskrit": "न मुञ्चेयमहं बाणमिति कौरवनन्दन ।\nन हन्यामहमेतेन कारणेन शिखण्डिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2042492, "chapter_id": 1947, "verse_number": "५-१९२-६८", "content_sanskrit": "एतत्तत्त्वमहं वेद जन्म तात शिखण्डिनः ।\nततो नैनं हनिष्यामि समरेष्वाततायिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2042493, "chapter_id": 1947, "verse_number": "५-१९२-६९", "content_sanskrit": "यदि भीष्मः स्त्रियं हन्यात्सन्तः कुर्युर्विगर्हणम् ।\nनैनं तस्माद्धनिष्यामि दृष्ट्वापि समरे स्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2042494, "chapter_id": 1947, "verse_number": "५-१९२-७०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2042495, "chapter_id": 1947, "verse_number": "५-१९२-७०", "content_sanskrit": "एतच्छ्रुत्वा तु करव्यो राजा दुर्योधनस्तदा।\nमुहूर्तमिव स ध्यात्वा भीष्मे युक्तममन्यत ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2042496, "chapter_id": 1947, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि अम्बोपाख्यानपर्वणि द्विनवत्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}]