[{"id": 7004508000, "chapter_id": 24508, "verse_number": "५-३-२०२-१", "content_sanskrit": "मार्कण्डेय उवाच ।\nतस्यैवानन्तरं चान्यच्छिखितीर्थमनुत्तमम् ।\nप्रधानं सर्वतीर्थानां पञ्चायतनमुत्तमम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004508001, "chapter_id": 24508, "verse_number": "५-३-२०२-२", "content_sanskrit": "तत्र तीर्थे तपस्तप्त्वा शिखार्थं हव्यवाहनः ।\nशिखां प्राप्य शिखी भूत्वा शिखाख्यं स्थापयञ्छिवम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004508002, "chapter_id": 24508, "verse_number": "५-३-२०२-३", "content_sanskrit": "प्रतिपच्छुक्लपक्षे या भवेदाश्वयुजे नृप ।\nतदा तीर्थवरे गत्वा स्नात्वा वै नर्मदाजले॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004508003, "chapter_id": 24508, "verse_number": "५-३-२०२-४", "content_sanskrit": "देवानृषीन् पित्ःंश्चान्यांस्तर्पयेत्तिलवारिणा ।\nहिरण्यं ब्राह्मणे दद्यात्संतर्प्य च हुताशनम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004508004, "chapter_id": 24508, "verse_number": "५-३-२०२-५", "content_sanskrit": "गन्धमाल्यैस्तथा धूपैस्ततः सम्पूजयेच्छिवम् ।\nअनेन विधिनाभ्यर्च्य शिखितीर्थे महेश्वरम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004508005, "chapter_id": 24508, "verse_number": "५-३-२०२-६", "content_sanskrit": "विमानेनार्कवर्णेन ह्यप्सरोगणसंवृतः ।\nगीयमानस्तु गन्धर्वैर्रुद्रलोकं स गच्छति॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004508006, "chapter_id": 24508, "verse_number": "५-३-२०२-७", "content_sanskrit": "शत्रुक्षयमवाप्नोति तेजस्वी जायते भुवि॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}]