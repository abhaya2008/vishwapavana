[{"id": 2105185, "chapter_id": 3269, "verse_number": "१५-७-१", "content_sanskrit": "वैशम्पायन उवाच।\nतं प्रविष्टं महात्मानं वीरमानकदुन्दुभिः।\nपुत्रशोकेन संतप्तो ददर्श कुरुपुङ्गवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2105186, "chapter_id": 3269, "verse_number": "१५-७-२", "content_sanskrit": "तस्याश्रुपरिपूर्णाक्षो व्यूढोरस्को महाभुजः।\nआर्तस्यार्ततरः पार्थः पादौ जग्राह भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2105187, "chapter_id": 3269, "verse_number": "१५-७-३", "content_sanskrit": "तस्य मूर्धानमाघ्रातुमियेषानकदुन्दुभिः।\nस्वस्रीयस्य महाबाहुर्न शशाक च शत्रुहन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2105188, "chapter_id": 3269, "verse_number": "१५-७-४", "content_sanskrit": "समालिङ्ग्यार्जुनं वृद्धः स भुजाभ्यां महाभुजः।\nरुरोदाथ स्मरञ्शौरिं विललाप सुविह्वलः।\nभ्रातॄन्पुत्रांश्च पौत्रांश्च दौहित्रान्स सखीनपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2105189, "chapter_id": 3269, "verse_number": "१५-७-५x", "content_sanskrit": "वसुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2105190, "chapter_id": 3269, "verse_number": "१५-७-५", "content_sanskrit": "यैर्जिता भूमिपालाश्च दैत्याश्च शतशोऽर्जुन।\nतान्सर्वान्नेह पश्यामि जीवाम्यर्जुन दुर्मरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2105191, "chapter_id": 3269, "verse_number": "१५-७-६", "content_sanskrit": "यो तावर्जुनशिष्यौ ते प्रियौ बहुमतौ सदा।\nतयोरपनयात्पार्थ वृष्णयो निधनं गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2105192, "chapter_id": 3269, "verse_number": "१५-७-७", "content_sanskrit": "यौ तौ वृष्णिप्रवीराणां द्वावेवातिरथौ मतौ।\nप्रद्युम्नो युयुधानश्चि कथनन्कत्थसे च यौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2105193, "chapter_id": 3269, "verse_number": "१५-७-८", "content_sanskrit": "तौ सदा कुरुशार्दूल कृष्णस्य प्रियभाजनौ।\nतावुभौ वृष्णिनाशस्य मुखमास्तां धनंजय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2105194, "chapter_id": 3269, "verse_number": "१५-७-९", "content_sanskrit": "न तु गर्हामि शैनेयं हार्दिक्यं चाहमर्जुन।\nअक्रूरं रौक्मिणेयं च शापो ह्येवात्र कारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2105195, "chapter_id": 3269, "verse_number": "१५-७-१०", "content_sanskrit": "केशिनं यस्तु कंसं च विक्रम्यि हतवान्प्रभुः।\nविदेहमकरोत्पार्थं चैद्यं च बलगर्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2105196, "chapter_id": 3269, "verse_number": "१५-७-११", "content_sanskrit": "नैषादिमेकलव्यं च चक्रे कालिङ्गमागधान्।\nगान्धारान्काशिराजं च मरुभूमौ च पार्थिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2105197, "chapter_id": 3269, "verse_number": "१५-७-१२", "content_sanskrit": "प्राच्यांश्च दाक्षिणात्यांश्च पार्वतीयांस्तथा नृपान्।\nसोभ्युपेक्षितवानेवमनयान्मधुसूदनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2105198, "chapter_id": 3269, "verse_number": "१५-७-१३", "content_sanskrit": "त्वं हि तं नारदश्चैव मुनयश्च सनातनम्।\nगोविन्दमनघं देवमभिजानीध्वमच्युतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2105199, "chapter_id": 3269, "verse_number": "१५-७-१४", "content_sanskrit": "प्रत्यपश्यच्च स विभुर्ज्ञातिक्षयमधोक्षजः।\nसमुपेक्षितवान्नित्यं स्वयं स मम पुत्रकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2105200, "chapter_id": 3269, "verse_number": "१५-७-१५", "content_sanskrit": "गान्धार्या वचनं यत्तदृषीणां च परंतप।\nतन्नूनमन्यथा कर्तुं नैच्छत्स जगतः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2105201, "chapter_id": 3269, "verse_number": "१५-७-१६", "content_sanskrit": "प्रत्यक्षं भवतश्चापि तव पौत्रः परंतप।\nअश्वत्थाम्ना हतश्चापि जीवितस्तस्य तेजसा।\nइमांस्तु नैच्छत्स्वान्ज्ञातीन्रक्षितुं च सखा तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2105202, "chapter_id": 3269, "verse_number": "१५-७-१७", "content_sanskrit": "ततः पुत्रांश्च पौत्रांश्च भ्रातॄनथ सखींस्तथा।\nशयानान्निहतान्दृष्ट्वा कृष्णो मामब्रवीदिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2105203, "chapter_id": 3269, "verse_number": "१५-७-१८", "content_sanskrit": "सम्प्राप्तोऽद्यायमस्यान्तः कुलस्य भरतर्षभ।\nआगमिष्यति बीभत्सुरिमां द्वारवतीं पुरीम्।\nआख्येयं तस्य यद्वृत्तं वृष्णीनां वैशसं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2105204, "chapter_id": 3269, "verse_number": "१५-७-१९", "content_sanskrit": "स तु श्रुत्वा महातेजा यदूनां निधनं प्रभो।\nआगन्ता क्षिप्रमेवेह न मेऽत्रास्ति विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2105205, "chapter_id": 3269, "verse_number": "१५-७-२०", "content_sanskrit": "योऽहं तमर्जुनं विद्धि योऽर्जुनः सोहमेव तु।\nयद्ब्रूयात्तत्तथा कार्यमिति बुद्ध्यस्व भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2105206, "chapter_id": 3269, "verse_number": "१५-७-२१", "content_sanskrit": "स स्त्रीषु प्राप्तकालासु पाण्डवो बालकेषु च।\nप्रतिपत्स्यति बीभत्सुर्भवतश्चौर्ध्वद्गेहिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2105207, "chapter_id": 3269, "verse_number": "१५-७-२२", "content_sanskrit": "इमां च नगरीं सद्यः प्रतियाते धनंजये।\nप्राकारट्टालकोपेतां समुद्रः प्लावयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2105208, "chapter_id": 3269, "verse_number": "१५-७-२३", "content_sanskrit": "अहं देशे तु कस्मिंश्चित्पुण्ये नियममास्थितः।\nकालं काङ्क्षे सद्य एव रामेण सहितो वने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2105209, "chapter_id": 3269, "verse_number": "१५-७-२४", "content_sanskrit": "एवमुक्त्वा हृषीकेशो मामचिन्त्यपराक्रमः।\nहित्वा मां बालकैः सार्धं दिशं कामप्यगात्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2105210, "chapter_id": 3269, "verse_number": "१५-७-२५", "content_sanskrit": "सोहं तौ च महात्मानौ चिन्तयन्रामकेशवौ।\nघोरं ज्ञातिवधं चैव न भुञ्जे शोककर्शितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2105211, "chapter_id": 3269, "verse_number": "१५-७-२६", "content_sanskrit": "न मोक्ष्येन च जीविष्ये दिष्ट्या प्राप्तोसि पाण्डव।\nयदुक्तं पार्थं कृष्णेन तत्सर्वमखिलं कुरु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2105212, "chapter_id": 3269, "verse_number": "१५-७-२७", "content_sanskrit": "एतत्ते पार्थ राज्यं च स्त्रियो रत्नानि चैव हि।\nइष्टान्प्राणानहं हीमांस्त्यक्ष्यामि रिपुसूदन॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2105213, "chapter_id": 3269, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते मौसलपर्वणि सप्तमोऽध्यायः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]