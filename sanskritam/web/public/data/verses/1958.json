[{"id": 2042883, "chapter_id": 1958, "verse_number": "६-७-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2042884, "chapter_id": 1958, "verse_number": "६-७-१", "content_sanskrit": "मेरोरथोत्तरं पार्श्वं पूर्वं चाचक्ष्व संजय।\nनिखिलेन महाबुद्धे माल्यवन्तं च पर्वतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2042885, "chapter_id": 1958, "verse_number": "६-७-२x", "content_sanskrit": "संजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2042886, "chapter_id": 1958, "verse_number": "६-७-२", "content_sanskrit": "दक्षिणेन तु नीलस्य मेरोः पार्श्वे तथोत्तरे।\nउत्तराः कुरवो राजन्पुण्याः सिद्धनिषेविताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2042887, "chapter_id": 1958, "verse_number": "६-७-३", "content_sanskrit": "तत्र वृक्षा मधुफला नित्यपुष्पफलोपगाः।\nपुष्पाणि च सुगन्धीनि रसवन्ति फलानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2042888, "chapter_id": 1958, "verse_number": "६-७-४", "content_sanskrit": "सर्वकामफलास्तत्र केचिद्वृक्षा जनाधिप ।\nअपरे क्षीरिणो नाम वृक्षास्तत्र नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2042889, "chapter_id": 1958, "verse_number": "६-७-५", "content_sanskrit": "ये क्षरन्ति सदा क्षीरं षड्रसं चामृपोतमम् ।\nवस्त्राणि च प्रसूयन्ते फलेष्वाभरणानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2042890, "chapter_id": 1958, "verse_number": "६-७-६", "content_sanskrit": "सर्वा मणिमयी भूमिः सूक्ष्मकाञ्चनवालुका ।\nसर्वर्तुसुखसंस्पर्शा निष्पङ्का च जनाधिप ।\nपुष्करिष्यः शुभास्तत्र सुखस्पर्शा मनोरमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2042891, "chapter_id": 1958, "verse_number": "६-७-७", "content_sanskrit": "देवलोकच्युताः सर्वे जायन्ते तत्र मानवाः।\nशुक्लाभिजनसंयन्नाः सर्वे सुप्रियदर्शनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2042892, "chapter_id": 1958, "verse_number": "६-७-८", "content_sanskrit": "मिथुनानि च जायन्ते स्त्रियश्चाप्सरसोपमाः।\nतेषां ते क्षीरिणां क्षीरं पिबन्त्यमृतसन्निभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2042893, "chapter_id": 1958, "verse_number": "६-७-९", "content_sanskrit": "मिथुनं जायते काले समं तच्च प्रवर्धते।\nतुल्यरूगुणोपेतं समवेषं तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2042894, "chapter_id": 1958, "verse_number": "६-७-१०", "content_sanskrit": "एवमेवानुरूपं च चक्रवाकसमं विभो ।\nनिरापगाम ते लोका नित्यं मुदितमानसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2042895, "chapter_id": 1958, "verse_number": "६-७-११", "content_sanskrit": "दशवर्षसहस्राणि शशवर्षशतानि च ।\nजीवन्ति ते महाराज न चान्योन्यं जहत्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2042896, "chapter_id": 1958, "verse_number": "६-७-१२", "content_sanskrit": "भारुण्डा नाम शकुनास्तीक्ष्णतुण्डा महाबलाः ।\nतान्निहेरन्तीह मृतान्दरीषु प्रक्षिपन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2042897, "chapter_id": 1958, "verse_number": "६-७-१३", "content_sanskrit": "उत्तराः कुरवो राजन्व्याख्यातास्ते समासतः।\nमेरोः पार्श्वमहं पूर्वं वक्ष्याम्यथ यथातथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2042898, "chapter_id": 1958, "verse_number": "६-७-१४", "content_sanskrit": "तस्य मूर्धाभिषेकस्तु भद्राश्वस्य विशांपते ।\nभद्रसालवनं यत्र कालाम्रश्च महाद्रुमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2042899, "chapter_id": 1958, "verse_number": "६-७-१५", "content_sanskrit": "कालाम्रस्तु महाराज नित्यपुष्पफलः शुभः ।\nद्रुमश्च योजनोत्सेधः सिद्धचारणसेवितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2042900, "chapter_id": 1958, "verse_number": "६-७-१६", "content_sanskrit": "तत्र ते पुरुषाः श्वेतास्तेजोयुक्ता महाबलाः।\nस्त्रियः कुमुदवर्णाश्च सुन्दर्यः प्रियदर्शनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2042901, "chapter_id": 1958, "verse_number": "६-७-१७", "content_sanskrit": "चन्द्रप्रभाश्चन्द्रवर्णाः पूर्वचन्द्रनिभाननाः ।\nचन्द्रशीतलगात्र्यश्च नृत्तिगीतविशारदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2042902, "chapter_id": 1958, "verse_number": "६-७-१८", "content_sanskrit": "दशवर्षसहस्राणि तत्रायुर्भरतर्षभ ।\nकालाम्ररसपीतास्ते नित्यं संस्थितयौवनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2042903, "chapter_id": 1958, "verse_number": "६-७-१९", "content_sanskrit": "दक्षिणेन तु नीलस्य निषधस्योत्तरेण तु।\nसुदर्शनो नाम महाञ्जम्बूवृक्षः सनातनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2042904, "chapter_id": 1958, "verse_number": "६-७-२०", "content_sanskrit": "सर्वकामफलः पुण्यः सिद्धचारणसेवितः।\nतस्य नाम्ना समाख्यातो जम्बूद्वीपः सनातनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2042905, "chapter_id": 1958, "verse_number": "६-७-२१", "content_sanskrit": "योजनानां सहस्त्रं च शतं च भरतर्षभ ।\nउत्सेधो वृक्षराजस्य दिवस्पृङ्भनुजेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2042906, "chapter_id": 1958, "verse_number": "६-७-२२", "content_sanskrit": "अरत्नीनां सहस्रं च शतानि दश पञ्च च ।\nपरिणाहस्तु वृक्षस्य फलानां रसभेदिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2042907, "chapter_id": 1958, "verse_number": "६-७-२३", "content_sanskrit": "पतमानानि तान्युर्वी कुर्वन्ति विपुलं स्वनम् ।\nमुञ्चन्ति च रसं राजंस्तस्मिन्रजतसन्निभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2042908, "chapter_id": 1958, "verse_number": "६-७-२४", "content_sanskrit": "तस्या जम्बाः फलरसो नदी भूत्वा जनाधिप ।\nमेरुं प्रदक्षिणं कृत्वा संप्रयात्युत्तरान्कुरून् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2042909, "chapter_id": 1958, "verse_number": "६-७-२५", "content_sanskrit": "तत्र तेषां मनःशान्तिर्न पिपासा जनाधिप ।\nतस्मिन्फलरसे पीते न जरा बाधते च तान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2042910, "chapter_id": 1958, "verse_number": "६-७-२६", "content_sanskrit": "तत्र जाम्बूनदं नाम कनकं देवभूषणम् ।\nइन्द्रगोपकसंकाशं जायते भास्वरं तु तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2042911, "chapter_id": 1958, "verse_number": "६-७-२७", "content_sanskrit": "तरुणादित्यवर्णाश्च जायन्ते तत्र मानवाः ।\nतथा माल्यवतः श्रृङ्गे दृश्यते हव्यवाट् सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2042912, "chapter_id": 1958, "verse_number": "६-७-२८", "content_sanskrit": "नाम्ना संवर्तको नाम कालाग्निर्भरतर्षभ ।\nतथा माल्यवतः श्रृङ्गे पूर्वपूर्वानुगण्डिका ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2042913, "chapter_id": 1958, "verse_number": "६-७-२९", "content_sanskrit": "योजनानां सहस्राणि पञ्चषण्माल्यवानथ ।\nमहारजतसंकाशा जायन्ते तत्र मानवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2042914, "chapter_id": 1958, "verse_number": "६-७-३०", "content_sanskrit": "ब्रह्मलोकच्युताः सर्वे सर्वे सर्वेषु साधवः ।\nतपस्तप्यन्ति ते तीव्रं भवन्ति ह्यूर्ध्वरेतसः ।\nरक्षणार्थं तु भूतानां प्रविश्यन्ते दिवाकरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2042915, "chapter_id": 1958, "verse_number": "६-७-३१", "content_sanskrit": "षष्टिस्तानि सहस्राणि षष्टिरेव शतानि च।\nअरुणस्याग्रतो यान्ति परिवार्य दिवाकरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2042916, "chapter_id": 1958, "verse_number": "६-७-३२", "content_sanskrit": "षष्टिं वर्षसहस्राणि षष्टिमेव शतानि च।\nआदित्यतापतप्तास्ते विशन्ति शशिमण्डलम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2042917, "chapter_id": 1958, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि जम्बूखण्डविनिर्माणपर्वणि सप्तमोऽध्यायाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]