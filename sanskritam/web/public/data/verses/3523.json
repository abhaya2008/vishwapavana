[{"id": 2117190, "chapter_id": 3523, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2117191, "chapter_id": 3523, "verse_number": "१", "content_sanskrit": "ततः स्वयंवरे वृत्ते राजानः सर्व एव ह ।\nयथागतं विप्रजम्मुर्विदित्वा पाण्डवान् वृतान्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2117192, "chapter_id": 3523, "verse_number": "२", "content_sanskrit": "अथ दुर्योधनो राजा विमना भ्रातृभिः सह ।\nअश्वत्थाम्ना मातुलेन कर्णेन च कृपेण च \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2117193, "chapter_id": 3523, "verse_number": "३", "content_sanskrit": "विनिवृत्तो वृतं दृष्ट्वा द्रौपद्या श्वेतवाहनम् ।\nअथ दुःशासनो राजा मन्दं मन्दमिवाब्रवीत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2117194, "chapter_id": 3523, "verse_number": "४", "content_sanskrit": "यद्यसौ ब्राह्मणो न स्यान्न च विन्देत द्रौपदीम् ।\nन हि तं तत्त्वतो राजा वेद कश्चिद् धनञ्जयम् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2117195, "chapter_id": 3523, "verse_number": "५", "content_sanskrit": "धिगस्मत्पौरुषं पञ्च यद् धरन्तीह पाण्डवाः ।\nदैवमेव परं मन्ये पौरुषं तु निरर्थकम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2117196, "chapter_id": 3523, "verse_number": "६", "content_sanskrit": "एवं सम्भाषमाणास्ते निन्दन्तश्च पुरोचनम् ।\nविविशुर्हस्तिनपुरं दीना विगतचेतसः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2117197, "chapter_id": 3523, "verse_number": "७", "content_sanskrit": "त्रस्ता विगतसङ्कल्पा दृष्ट्वा पार्थान् महौजसः ।\nविमुक्तान् हव्यवाहाच्च संयुक्तान् द्रुपदेन च \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2117198, "chapter_id": 3523, "verse_number": "८", "content_sanskrit": "धृष्टद्युम्नं च सञ्चिन्त्य तथैव च शिखण्डिनम् ।\nद्रुपदस्यात्मजांश्चान्यान् सर्वयुद्धविशारदान् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2117199, "chapter_id": 3523, "verse_number": "९", "content_sanskrit": "विदुरस्त्वथ तान् श्रुत्वा द्रौपद्या पाण्डवान् वृतान् ।\nव्रीडितान् धार्तराष्ट्रांश्च भग्नदर्पानुपागतान् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2117200, "chapter_id": 3523, "verse_number": "१०", "content_sanskrit": "ततः प्रीतमनाः क्षत्ता धृतराष्ट्रं विशाम्पते ।\nउवाच कुरवो दिष्ट्या वर्धन्त इति विस्मितः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2117201, "chapter_id": 3523, "verse_number": "११", "content_sanskrit": "वैचित्रवीर्यस्तु तदा निशम्य विदुरस्य तत् ।\nअब्रवीत् परमप्रीतो दिष्ट्या दिष्ट्येति कौरवः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2117202, "chapter_id": 3523, "verse_number": "१२", "content_sanskrit": "मन्यते स वृतं पुत्रं ज्येष्ठं द्रुपदकन्यया ।\nदुर्योधनमविज्ञानात् प्रज्ञाचक्षुर्नरेश्वरः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2117203, "chapter_id": 3523, "verse_number": "१३", "content_sanskrit": "अथ त्वाज्ञापयामास द्रोपद्या भूषणं बहु ।\nआनीयतां वै कृष्णेति पुत्रं दुर्योधनं तदा \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2117204, "chapter_id": 3523, "verse_number": "१४", "content_sanskrit": "अथास्य पश्चाद् विदुर आचख्यौ पाण्डवान् वृतान् ।\nसर्वान् कुशलिनो राजन् पूजितान् द्रुपदेन च \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2117205, "chapter_id": 3523, "verse_number": "१५", "content_sanskrit": "एतच्छ्रुत्वा तु वचनं विदुरस्य नराधिपः ।\nआकारच्छादनार्थं तु दिष्ट्या दिष्ट्येति चाब्रवीत् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2117206, "chapter_id": 3523, "verse_number": "", "content_sanskrit": "धुतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2117207, "chapter_id": 3523, "verse_number": "१६", "content_sanskrit": "एवं विदुर भद्रं ते यदि जीवन्ति पाण्डवाः ।\nसाध्वाचारा तथा कुन्ती सम्बन्धो द्रूपदेन च ।\nबभूव परमश्लाध्यो दिष्ट्या दिष्ट्येति चाब्रवीत् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2117208, "chapter_id": 3523, "verse_number": "१७", "content_sanskrit": "अन्ववाये वसोर्जातः प्रकृष्टे मान्यके कुले ।\nव्रतविद्यातपोवृद्धः पार्थिवानां धुरन्धरः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2117209, "chapter_id": 3523, "verse_number": "१८", "content_sanskrit": "पुत्राश्चास्य तथा पौत्राः सर्वे सुचरितव्रताः ।\nतेषां सम्बन्घिनश्चान्ये बहवः सुमहाबलाः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2117210, "chapter_id": 3523, "verse_number": "१९", "content_sanskrit": "यथैव पाण्डोः पुत्रास्ते तथैवाभ्यधिका मम ।\nसेयमभ्यधिकाऽन्येभ्यो वृतिर्विदुर मे मता \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2117211, "chapter_id": 3523, "verse_number": "२०", "content_sanskrit": "यत् ते कुशलिनो वीरा मित्रवन्तश्च मे सुताः ।\nको हि द्रुपदमासाद्य मित्रं क्षत्तः सबान्धवम् ।\nन बुभूषेत् कथं चार्थी गतश्रीरिव पार्थिवः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2117212, "chapter_id": 3523, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2117213, "chapter_id": 3523, "verse_number": "२१", "content_sanskrit": "तं तथा भाषमाणं तु विदुरः प्रत्यभाषत ।\nनित्या भवतु ते बुद्धिरेषा राजन् शतं समाः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2117214, "chapter_id": 3523, "verse_number": "२२", "content_sanskrit": "इत्युक्त्वा प्रययौ राजन् विदुरः स्वं निवेशनम् ।\nततो दुर्योधनश्चैव राधेयश्च विशाम्पते\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2117215, "chapter_id": 3523, "verse_number": "२३", "content_sanskrit": "धृतराष्ट्रस्य तच्छ्रुत्वा वचोऽब्रूतामिदं ततः ।\nसन्निधौ विदुरस्य त्वां वक्तुं न नृप शक्नुमः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2117216, "chapter_id": 3523, "verse_number": "२४", "content_sanskrit": "विविक्तमिति वक्ष्यावः किं तवेदं चिकीर्षितम् ।\nसपत्नवृद्धिं तां त्वद्य मन्यसे वृद्धिमात्मनः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2117217, "chapter_id": 3523, "verse_number": "२५", "content_sanskrit": "अभिष्टौषि च यत् क्षत्तुः समीपे द्विपदांवर ।\nअन्यस्मिन् नृप कर्तव्ये त्वमन्यत् कुरुषेऽनघ\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2117218, "chapter_id": 3523, "verse_number": "२६", "content_sanskrit": "तेषां बलविघातो हि कर्तव्यस्तात नित्यशः ।\nते वयं प्राप्तकालस्य चिकित्सां मन्त्रयामहे ।\nयथा नो न ग्रसेयुस्ते सपुत्रगणबान्धवान् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2117219, "chapter_id": 3523, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2117220, "chapter_id": 3523, "verse_number": "२७", "content_sanskrit": "दुर्योधनेनैवमुक्तः कर्णेन च विशाम्पते ।\nपुत्रं च सूतपुत्रं च धृतराष्ट्रोऽब्रवीदिदम् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2117221, "chapter_id": 3523, "verse_number": "२८", "content_sanskrit": "अहमप्येवमेवैतच्चिन्तयामि यथा युवाम् ।\nविवृतुं नाहमिच्छामि त्वाकारं विदुरं प्रति \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2117222, "chapter_id": 3523, "verse_number": "२९", "content_sanskrit": "अतस्तेषां गुणानेव कीर्तयामि विशेषतः ।\nन च बुध्येत विदुरो ममाभिप्रायमिङ्गितैः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2117223, "chapter_id": 3523, "verse_number": "३०", "content_sanskrit": "यच्च वै मन्यसे प्राप्तं तद् ब्रूहि त्वं सुयोधन ।\nराधेय मन्यसे त्वं च यत् प्राप्तं तद् ब्रवीहि मे \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2117224, "chapter_id": 3523, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2117225, "chapter_id": 3523, "verse_number": "३१", "content_sanskrit": "प्रच्छन्नं कुशलैर्विप्रैः सुतुष्टैराप्तकारिभिः ।\nकुन्तीपुत्रान् भेदयामो माद्रीपुत्रौ च तावुभौ \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2117226, "chapter_id": 3523, "verse_number": "३२", "content_sanskrit": "अथवा द्रुपदो राजा महद्भिर्धनसञ्चयैः ।\nपुत्राश्चास्य प्रलोभ्यन्ताममात्याश्चैव सर्वशः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2117227, "chapter_id": 3523, "verse_number": "३३", "content_sanskrit": "परित्यजेयू राजानं कुन्तीपुत्रं युधिष्ठिरम् ।\nअथ तत्रैव वा तेषां निवासं रोचयन्तु ते \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2117228, "chapter_id": 3523, "verse_number": "३४", "content_sanskrit": "इहैषां दोषवद् वासं कर्णयन्तु पृथक्पृथक् ।\nते भिद्यमानास्तत्रैव मनः कुर्वन्तु पाण्डवाः \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2117229, "chapter_id": 3523, "verse_number": "३५", "content_sanskrit": "अथवाऽकुशलान् केचिदुपायैर्बहुभिर्नराः ।\nइतरेतरतः पार्थान् भेदयन्त्वनुरागतः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2117230, "chapter_id": 3523, "verse_number": "३६", "content_sanskrit": "व्युत्थापयन्तु तां कृष्णां बहुत्वात् सङ्करं हि तत् ।\nअथवा पाण्डवांस्तस्या भेदयन्तु ततश्च ताम् \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2117231, "chapter_id": 3523, "verse_number": "३७", "content_sanskrit": "भीमसेनस्य वा राजन्नुपायकुशलैर्नरैः ।\nमृत्युर्विधीयतां च्छन्नैः स हि तेषां बलाधिकः \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2117232, "chapter_id": 3523, "verse_number": "३८", "content_sanskrit": "तस्मिंस्तु निहते राजन् हतोत्साहा हतौजसः ।\nयतिष्यन्ते न राज्याय स हि तेषां व्यपाश्रयः \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2117233, "chapter_id": 3523, "verse_number": "३९", "content_sanskrit": "अजेयो ह्यर्जुनः सङ्खे पृष्ठगोपे वृकोदरे ।\nतमृते फल्गुनो युद्धे राधेयस्य न पादभाक् \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2117234, "chapter_id": 3523, "verse_number": "४०", "content_sanskrit": "ते जानन्तो हि दौर्बल्यं भीमसेने हते सति ।\nअस्मान् बलवतो मत्वा न शिष्यन्त्यबलीयसः \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2117235, "chapter_id": 3523, "verse_number": "४१", "content_sanskrit": "इहागतेषु पार्थेषु निदेशवशवर्तिषु ।\nप्रवर्तिष्यामहे राज्यं यथाश्रद्धं यथासुखम् \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2117236, "chapter_id": 3523, "verse_number": "४२", "content_sanskrit": "दर्पं वावदतां तेषां केचिदत्र मनस्विनः ।\nद्रुपदस्यात्मजा राजन् ते भिद्यन्ते ततः परैः \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2117237, "chapter_id": 3523, "verse_number": "४३", "content_sanskrit": "अथवा दर्शनीयाभिः प्रमदाभिर्विलोभ्यताम् ।\nएकैकः पाण्डुपुत्राणां ततः कृष्णा विरुध्यताम् \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2117238, "chapter_id": 3523, "verse_number": "४४", "content_sanskrit": "प्रेष्यतां वाऽपि राजेन्द्र तेषामागमनाय हि ।\nते लोप्त्रहारैः सन्धाय वध्यन्तामाप्तकारिभिः \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2117239, "chapter_id": 3523, "verse_number": "४५", "content_sanskrit": "एतेषामप्युपायानां निर्दोषो यो मतस्तव ।\nतस्य प्रयोगमातिष्ठ पुरा कालोऽतिवर्तते \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2117240, "chapter_id": 3523, "verse_number": "४६", "content_sanskrit": "यावद्ध्यकृतविश्वासा द्रुपदे पार्थिवर्षभे ।\nतावदेव हि शक्यास्ते न शक्यास्तु ततः परम् \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2117241, "chapter_id": 3523, "verse_number": "४७", "content_sanskrit": "सैषा मम मती राजन् पाण्डवान् प्रति दृश्यते ।\nसाध्वी वा यदि वाऽसाध्वी किं वा राधेय मन्यसे \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2117242, "chapter_id": 3523, "verse_number": "२०२", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nद्व्यधिकद्विशततमोऽध्यायः ॥२०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2117243, "chapter_id": 3523, "verse_number": "३", "content_sanskrit": "॥ इति विदुरागमनपर्वणि तृतीयोऽध्यायः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2117244, "chapter_id": 3523, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]