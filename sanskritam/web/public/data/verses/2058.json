[{"id": 2047868, "chapter_id": 2058, "verse_number": "६-१०७-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2047869, "chapter_id": 2058, "verse_number": "६-१०७-१", "content_sanskrit": "युध्यतामेव तेषां तु भास्करेऽस्तमुपागते।\nसन्ध्या समभवद्धोरा नापश्याम ततो रणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2047870, "chapter_id": 2058, "verse_number": "६-१०७-२", "content_sanskrit": "ततो युधिष्ठिरो राजा सन्ध्यां संदृश्य भारत।\nवध्यमानं च भीष्मेण त्यक्तास्त्रं भयविह्वलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2047871, "chapter_id": 2058, "verse_number": "६-१०७-३", "content_sanskrit": "स्वसैन्यं च परावृत्तं पलायनपरायणम्।\nभीष्मं च युधि संरब्धं पीडयन्तं महारथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2047872, "chapter_id": 2058, "verse_number": "६-१०७-४", "content_sanskrit": "सोमकांश्च जितान्दृष्ट्वा निरुत्साहान्महारथान्।\n` निशामुखं च संप्रेक्ष्य घोररूपं भयानकम्।\nचिन्तयित्वा ततो राज्ञामपहारमकारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2047873, "chapter_id": 2058, "verse_number": "६-१०७-५", "content_sanskrit": "ततोऽपहारं सैन्यानां चक्रे राजा युधिष्ठिरः ।\nतथैव तव सैन्यानामपहारे ह्यभूत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2047874, "chapter_id": 2058, "verse_number": "६-१०७-६", "content_sanskrit": "ततोऽपहारं सैन्यानां कृत्वा तत्र महारथाः ।\nन्यविशन्त कुरुश्रेष्ठ संग्रामे क्षतविक्षताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2047875, "chapter_id": 2058, "verse_number": "६-१०७-७", "content_sanskrit": "भीष्मस्य समरे कर्म चिन्तयानास्तु पाण्डवाः ।\nनालभन्त तदा शान्तिं भीष्मबाणप्रपीडिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2047876, "chapter_id": 2058, "verse_number": "६-१०७-८", "content_sanskrit": "भीष्मोऽपि समरे जित्वा पाण्डवान्सह सृञ्जयान्।\nपूज्यमानस्तव सुतैर्वन्द्यमानश्च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2047877, "chapter_id": 2058, "verse_number": "६-१०७-९", "content_sanskrit": "न्यविशत्कुरुभिः सार्धं हृष्टरूपैः समन्ततः ।\nततो रात्रिः समभवत्सर्वभूतप्रमोहिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2047878, "chapter_id": 2058, "verse_number": "६-१०७-१०", "content_sanskrit": "तस्मिन्रात्रिमुखे घोरे पाण्डवा वृष्णिभिः सह ।\nसृञ्जयाश्च दुराधर्षा मन्त्राय समुपाविशन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2047879, "chapter_id": 2058, "verse_number": "६-१०७-११", "content_sanskrit": "आत्मनिःश्रेयसं सर्वे प्राप्तकालं महाबलाः।\nमन्त्रयामासुरव्यग्रा मन्त्रनिश्चयकोविदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2047880, "chapter_id": 2058, "verse_number": "६-१०७-१२", "content_sanskrit": "ततो युधिष्ठिरो राजा मन्त्रयित्वा चिरं नृप ।\nवासुदेवं समुद्वीक्ष्य वचनं चेदमाददे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2047881, "chapter_id": 2058, "verse_number": "६-१०७-१३", "content_sanskrit": "कृष्ण पश्य माहात्मानं भीष्मं भीमपराक्रमम् ।\nगजं नलवनानीव विमृद्गन्तं बलं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2047882, "chapter_id": 2058, "verse_number": "६-१०७-१४", "content_sanskrit": "न चैवैनं महात्मानमुत्सहामो निरीक्षितुम् ।\nलेलिह्यमानं सैन्येषु प्रवृद्धमिव पावकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2047883, "chapter_id": 2058, "verse_number": "६-१०७-१५", "content_sanskrit": "यथा घोरो महानागस्तक्षको वै विषोल्बणः।\nतथा भीष्मो रणे क्रुद्धस्तीक्ष्णशस्त्रः प्रतापवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2047884, "chapter_id": 2058, "verse_number": "६-१०७-१६", "content_sanskrit": "गृहीतचापः समरे प्रमुञ्चन्निशिताञ्छरान्।\nशक्यो जेतुं यमः क्रुद्धो वज्रपाणिश्च देवराट् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2047885, "chapter_id": 2058, "verse_number": "६-१०७-१७", "content_sanskrit": "वरुणः पाशभृच्चापि सगदो वा धनेश्वरः ।\nन तु भीष्मः सुसंक्रुद्धः शक्यो जेतुं महाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2047886, "chapter_id": 2058, "verse_number": "६-१०७-१८", "content_sanskrit": "सोऽहमेवं गते कृष्ण निमग्नः शोकसागरे।\nआत्मनो बुद्धिदौर्बल्याद्भीष्ममासाद्य संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2047887, "chapter_id": 2058, "verse_number": "६-१०७-१९", "content_sanskrit": "वनं यास्यामि दुर्धर्ष श्रेयो वै तत्र मे गतम् ।\nन युद्धं रोचते कृष्ण हन्ति भीष्मो हि नः सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2047888, "chapter_id": 2058, "verse_number": "६-१०७-२०", "content_sanskrit": "यथा प्रज्वलितं वह्निं पतङ्गः समभिद्रवन्।\nएकतो मृत्युमभ्येति तथाऽहं भीष्ममेयिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2047889, "chapter_id": 2058, "verse_number": "६-१०७-२१", "content_sanskrit": "क्षयं नीतोऽस्मि वार्ष्णेय राज्यहेतोः पराक्रमी ।\nभ्रातरश्चैव मे शुराः सायकैर्भृशपीडिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2047890, "chapter_id": 2058, "verse_number": "६-१०७-२२", "content_sanskrit": "मत्कृते भ्रातृसौहार्दाद्राज्यभ्रष्टा वनं गताः।\nपरिक्लिष्टा तथा कृष्णा मत्कृते मधुसूदन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2047891, "chapter_id": 2058, "verse_number": "६-१०७-२३", "content_sanskrit": "जीवितं बहु मन्येऽहं जीवितं ह्यद्य दुर्लभम्।\nजीवितस्याद्य शेषेण चरिष्ये धर्ममुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2047892, "chapter_id": 2058, "verse_number": "६-१०७-२४", "content_sanskrit": "यदि तेऽहमनुग्राह्यो भ्रातृभिः स केशव ।\nस्वधर्मस्याविरोधेन हितं व्याहर केशव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2047893, "chapter_id": 2058, "verse_number": "६-१०७-२५x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2047894, "chapter_id": 2058, "verse_number": "६-१०७-२५", "content_sanskrit": "एवं श्रुत्वा वचस्तस्य कारुण्याद्बहुविस्तरम्।\nप्रत्युवाच ततः कृष्णः सान्त्वयानो युधिष्ठिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2047895, "chapter_id": 2058, "verse_number": "६-१०७-२६x", "content_sanskrit": "श्रीभगवानुवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2047896, "chapter_id": 2058, "verse_number": "६-१०७-२६", "content_sanskrit": "धर्मपुत्र विषादं त्वं मा कृथाः सत्यसंगर ।\nयस्य ते भ्रातरः शूरा दुर्जयाः सत्रुसूदनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2047897, "chapter_id": 2058, "verse_number": "६-१०७-२७", "content_sanskrit": "अर्जुनो भीमसेनश्च वाय्वग्निसमतेजसौ।\nमाद्रीपुत्रौ च विक्रान्तौ त्रिदशानामिविश्वरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2047898, "chapter_id": 2058, "verse_number": "६-१०७-२८", "content_sanskrit": "मां वा नियुङ्क्ष्व सौहार्दाद्योत्स्ये भीष्मेण पाण्डव ।\nत्वप्रयुक्तो महाराज किं न कुर्यां महाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2047899, "chapter_id": 2058, "verse_number": "६-१०७-२९", "content_sanskrit": "हनिष्यामि रणे भीष्ममाहूय पुरुषर्षभम् ।\nपश्यतां धार्तराष्ट्राणां यदि नेच्छति फल्गुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2047900, "chapter_id": 2058, "verse_number": "६-१०७-३०", "content_sanskrit": "यदि भीष्मे हते वीरे जयं पश्यसि पण्डव।\nहन्तास्म्येकरथेनाद्य कुरुवृद्धं पितामहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2047901, "chapter_id": 2058, "verse_number": "६-१०७-३१", "content_sanskrit": "पश्य मे विक्रमं राजन्महेन्द्रस्येव संयुगे।\nविमुञ्चन्तं महास्त्रामि पातयिष्यामि तं रथात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2047902, "chapter_id": 2058, "verse_number": "६-१०७-३२", "content_sanskrit": "यः शत्रुः पाण्डुपुत्राणां मच्छत्रुः स न संशयः।\nमदर्था भवदर्था ये ये मदीयास्तवैव ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2047903, "chapter_id": 2058, "verse_number": "६-१०७-३३", "content_sanskrit": "तव भ्राता मम सखा संबन्धी शिष्य एव च ।\nमांसान्युत्कृत्य दास्यामि फल्गुनार्थे महीपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2047904, "chapter_id": 2058, "verse_number": "६-१०७-३४", "content_sanskrit": "एष चापि नरव्याघ्रो मत्कृते जीवितं त्यजेत्।\nएष नः समयस्तात तारयेम परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2047905, "chapter_id": 2058, "verse_number": "६-१०७-३५", "content_sanskrit": "स मां नियुङ्क्ष्व राजेन्द्र यावत्सज्जो भवाम्यहम् ।\nप्रतिज्ञातमुपप्लाव्ये यत्तत्पार्थेन पूर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2047906, "chapter_id": 2058, "verse_number": "६-१०७-३६", "content_sanskrit": "पातयिष्यामि गाङ्गेयमित्युलूकस्य संनिधौ।\nपरिरक्ष्यमिदं तावद्वचः पार्थस्य धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2047907, "chapter_id": 2058, "verse_number": "६-१०७-३७", "content_sanskrit": "अनुज्ञातेन पार्थेन मया कार्यं न संशयः।\nअथवा फल्गुनस्यैष भारः परिमितो रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2047908, "chapter_id": 2058, "verse_number": "६-१०७-३८", "content_sanskrit": "स हनिष्यति संग्रामे भीष्मं परपुरंजयम् ।\nअशक्यमपि कुर्याद्धि रणे पार्थः समुद्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2047909, "chapter_id": 2058, "verse_number": "६-१०७-३९", "content_sanskrit": "त्रिदशान्वा समुद्युक्तान्सहितान्दैत्यदानवैः ।\nनिहन्त्यादर्जुनः सङ्ख्ये किमु भीष्मं नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2047910, "chapter_id": 2058, "verse_number": "६-१०७-४०", "content_sanskrit": "विपरीतो महावीर्यो गतसत्वोऽल्पजीवनः ।\nभीष्मः शान्तनवो नूनं कर्तव्यं नावबुध्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2047911, "chapter_id": 2058, "verse_number": "६-१०७-४१x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2047912, "chapter_id": 2058, "verse_number": "६-१०७-४१", "content_sanskrit": "एवमेतन्महाबाहो यथा वदसि माधव।\nसर्वे ह्येते न पर्याप्तास्तव वेगविधारणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2047913, "chapter_id": 2058, "verse_number": "६-१०७-४२", "content_sanskrit": "नियतं समावाप्स्यामि सर्वमेतद्यथेप्सितम् ।\nयस्य मे पुरुषव्याघ्र भवान्पक्षे व्यवस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2047914, "chapter_id": 2058, "verse_number": "६-१०७-४३", "content_sanskrit": "सेन्द्रानपि रणे देवाञ्जयेयं जयतां वर।\nत्वया नाथेन गोविन्द किमु भीष्मं महारथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2047915, "chapter_id": 2058, "verse_number": "६-१०७-४४", "content_sanskrit": "न तु त्वामनृतं कर्तुमुत्सहे स्वात्मगौरवात्।\nअयुध्यमानाः सहाय्यं यथोक्तं कुरु माधव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2047916, "chapter_id": 2058, "verse_number": "६-१०७-४५", "content_sanskrit": "समयस्तु कृतः कश्चिन्मम भीष्मेण संयुगे।\nमन्त्रयिष्ये तवार्थाय न तु योत्स्ये कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2047917, "chapter_id": 2058, "verse_number": "६-१०७-४६", "content_sanskrit": "दुर्योधनार्थं योत्स्यामि सत्यमेतदिति प्रभो।\nस हि राज्यस्य मे दाता मन्त्रस्यैव च माधव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2047918, "chapter_id": 2058, "verse_number": "६-१०७-४७", "content_sanskrit": "तस्माद्देवव्रतं भूयो वधोपायार्थमात्मनः ।\nभवता सहिताः सर्वे प्रयाम मधुसूदन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2047919, "chapter_id": 2058, "verse_number": "६-१०७-४८", "content_sanskrit": "तद्वयं सहिता गत्वा भीष्ममाशु नरोत्तमम् ।\nरुचिते तव पृच्छामि मन्त्रं वार्ष्णेय माचिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2047920, "chapter_id": 2058, "verse_number": "६-१०७-४९", "content_sanskrit": "स वक्ष्यति हितं वाक्यं सत्यमस्माज्जनार्दन।\nयथा च वक्ष्यते कृष्ण तथा कर्तास्मि संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2047921, "chapter_id": 2058, "verse_number": "६-१०७-५०", "content_sanskrit": "स नो जयस्य दाता स्यान्मन्त्रस्य च दृढव्रतः ।\nबालाः पित्रा विहीनाश्च तेन संवर्धिता वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2047922, "chapter_id": 2058, "verse_number": "६-१०७-५१", "content_sanskrit": "तं चेत्पितामहं वृद्धं हन्तुमिच्छामि माधव।\nपितुः पितरमिष्टं च धिगस्तु क्षत्रजीविकाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2047923, "chapter_id": 2058, "verse_number": "६-१०७-५२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2047924, "chapter_id": 2058, "verse_number": "६-१०७-५२", "content_sanskrit": "ततोऽब्रवीन्महाराज वार्ष्णेयः कुरुनन्दनम् ।\nरोचते मे महाप्राज्ञ राजेन्द्र तव भाषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2047925, "chapter_id": 2058, "verse_number": "६-१०७-५३", "content_sanskrit": "देवव्रतः कृती भीष्मः प्रेक्षितेनापि निर्दहेत्।\nगम्यतां स्ववधोपायं प्रष्टुं सागरगासुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2047926, "chapter_id": 2058, "verse_number": "६-१०७-५४", "content_sanskrit": "वक्तमर्हति सत्यं स त्वया पृष्टो विशेषतः ।\nते वयं तत्र गच्छामः प्रष्टुं कुरुपितामहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2047927, "chapter_id": 2058, "verse_number": "६-१०७-५५", "content_sanskrit": "गत्वा शान्तनवं वृद्धं मन्त्रं पृच्छाम भारत ।\nस नो दास्यति मन्त्रं यं तेन योत्स्यामहे परान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2047928, "chapter_id": 2058, "verse_number": "६-१०७-५६x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2047929, "chapter_id": 2058, "verse_number": "६-१०७-५६", "content_sanskrit": "एवमामन्त्र्य ते वीराः पाण्डवाः पाण्डुपूर्वज।\nजग्मुस्ते सहिताः सर्वे वासुदेवश्च वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2047930, "chapter_id": 2058, "verse_number": "६-१०७-५७", "content_sanskrit": "विमुक्तशस्त्रकवचा भीष्मस्य सदनं प्रति।\nप्रविश्य च तदा भीष्मं शिरोभिः प्रणिपेदिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2047931, "chapter_id": 2058, "verse_number": "६-१०७-५८", "content_sanskrit": "पूजयन्तो महाराज पाण्डवा भरतर्षभम् ।\nप्रणम्य शिरसा चैनं भीष्मं शरणमभ्ययुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2047932, "chapter_id": 2058, "verse_number": "६-१०७-५९", "content_sanskrit": "तानुवाच महाबाहुर्भीष्मः कुरुपितामहः ।\nस्वागतं तव वार्ष्णेय स्वागतं ते धनञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2047933, "chapter_id": 2058, "verse_number": "६-१०७-६०", "content_sanskrit": "स्वागतं धर्मपुत्राय भीमाय यमयोस्तथा।\nकिं वा कार्यं करोम्यद्य युष्माकं प्रीतिवर्धनं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2047934, "chapter_id": 2058, "verse_number": "६-१०७-६१", "content_sanskrit": "`युद्धादन्यत्र हे वत्साः प्रीयन्तां मा विशङ्कथ ।\nसर्वात्मनापि कर्तास्मि यदपि स्यात्सदुष्करम् ।\nतथा ब्रुवाणं गाङ्गेयं प्रीतियुक्तं पुनःपुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2047935, "chapter_id": 2058, "verse_number": "६-१०७-६२", "content_sanskrit": "उवाच राजा दीनात्मा प्रीतियुक्तमिदं वचः।\nकथं जयेम सर्वज्ञ कथं राज्यं लभेमहि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2047936, "chapter_id": 2058, "verse_number": "६-१०७-६३", "content_sanskrit": "प्रजानां संशयो न स्यात्कथं तन्मे बद प्रभो ।\nभवान्हि नो वधोपायं ब्रवीतु स्वयमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2047937, "chapter_id": 2058, "verse_number": "६-१०७-६४", "content_sanskrit": "भवन्तं समरे वीर विषहेम कथं वयम्।\nन हि ते सूक्ष्ममप्यस्ति रन्ध्रं कुरुपितामह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2047938, "chapter_id": 2058, "verse_number": "६-१०७-६५", "content_sanskrit": "मण्डलेनैव धनुषा दृश्यसे संयुगे सदा।\nआददानं संदधानं विकर्षन्तं धनुर्न च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2047939, "chapter_id": 2058, "verse_number": "६-१०७-६६", "content_sanskrit": "पश्यामस्त्वां महाबाहो रथे सूर्यमिवापरम् ।\nरथाश्वनरनागानां हन्तारं परवीरहन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2047940, "chapter_id": 2058, "verse_number": "६-१०७-६७", "content_sanskrit": "कोऽथवोत्सहते जेतुं वां पुमान्भरतर्षभ ।\nवर्षता शरवर्षाणि महान्ति पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2047941, "chapter_id": 2058, "verse_number": "६-१०७-६८", "content_sanskrit": "क्षयं निता हि पृतना संयुगे महती मम।\nयथा युधि जयेम त्वां यथा राज्यं भृशं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2047942, "chapter_id": 2058, "verse_number": "६-१०७-६९", "content_sanskrit": "मम सैन्यस्य च क्षेमं तन्मे ब्रूहि पितामह । ६-१०७-६९xसञ्जय उवाच।\nततोऽब्रवीच्छान्तनवः पाण्डवान्पाण्डुपूर्वज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2047943, "chapter_id": 2058, "verse_number": "६-१०७-७०", "content_sanskrit": "न कथंचन कौन्तेय मयि जीवति संयुगे।\nजयो भवति सर्वज्ञ सत्यमेतद्ब्रवीमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2047944, "chapter_id": 2058, "verse_number": "६-१०७-७१", "content_sanskrit": "निर्जिते मयि युद्धेन रणे जेष्यथ पाण्डवाः ।\nक्षिप्रं मयि प्रहरत यदीच्छथ रणे जयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2047945, "chapter_id": 2058, "verse_number": "६-१०७-७२", "content_sanskrit": "अनुजानामि वः पार्थाः प्रहरध्वं यथासुखम् ।\nएवं हि सुकृतं मन्ये भवतां विदितो ह्यहम् ।\nहते मयि हतं सर्वं तस्मादेवं विधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2047946, "chapter_id": 2058, "verse_number": "६-१०७-७३x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2047947, "chapter_id": 2058, "verse_number": "६-१०७-७३", "content_sanskrit": "ब्रूहि तस्मादुपायं नो यथा युद्धे जयेमहि।\nभवन्तं समरे क्रुद्धं दण्डहस्तमिवान्तकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2047948, "chapter_id": 2058, "verse_number": "६-१०७-७४", "content_sanskrit": "शक्यो वज्रधरो जेतुं वरुणोऽथ यमस्तथा।\nन भवान्समरे शक्यः सेन्द्रैरपि सुरासुरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2047949, "chapter_id": 2058, "verse_number": "६-१०७-७५x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2047950, "chapter_id": 2058, "verse_number": "६-१०७-७५", "content_sanskrit": "सत्यमेतन्महाबाहो यथा वदसि पाण्डव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2047951, "chapter_id": 2058, "verse_number": "६-१०७-७६", "content_sanskrit": "नाहं जेतुं रणे शक्यः सेन्द्रैरपि सुरासुरैः।\nआत्तशस्त्रो रणे यत्तो गृहीतवरकार्मुकः ।\nततो मां न्यस्तशस्त्रं तु एते हन्युर्महारथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2047952, "chapter_id": 2058, "verse_number": "६-१०७-७७", "content_sanskrit": "निक्षिप्तशस्त्रे पतिते विमुक्तकवचध्वजे ।\nद्रवमाणे च भीते च तवास्मीति च वादिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2047953, "chapter_id": 2058, "verse_number": "६-१०७-७८", "content_sanskrit": "`स्त्रीजिते स्त्रीप्रधाने च स्त्रीप्रधायिनि धर्मज\nस्त्रियां स्त्रीनामधेये च विकले चैकपुत्रिणि ।\nअप्रसूते च षण्डे च न युद्धं रोचते मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2047954, "chapter_id": 2058, "verse_number": "६-१०७-७९", "content_sanskrit": "इमं मे शृणु राजेन्द्र संकल्पं पूर्वचिन्तितम् ।\nअसंकल्पध्वजं दृष्ट्वा न युध्येयं कदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2047955, "chapter_id": 2058, "verse_number": "६-१०७-८०", "content_sanskrit": "य एष द्रौपदो राजंस्तव सैन्ये महारथः ।\nशिखण्डी समरामर्षी शूरश्च समितिंजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2047956, "chapter_id": 2058, "verse_number": "६-१०७-८१", "content_sanskrit": "यथाऽभवच्च स्त्रीपूर्वं पश्चात्पुंस्त्वं समागतः।\nजानन्ति च भवन्तोऽपि सर्वमेतद्यथातथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2047957, "chapter_id": 2058, "verse_number": "६-१०७-८२", "content_sanskrit": "अर्जुनः समरे शूरः पुरस्कृत्य शिखण्डीनम् ।\nमामेव विशिखैस्तीक्ष्णैरभिद्रवतु दंशितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2047958, "chapter_id": 2058, "verse_number": "६-१०७-८३", "content_sanskrit": "असंकल्पध्वजे तस्मिन्स्त्रीपूर्वे च विशेषतः ।\nन प्रहर्तुमभीप्सामि गृहीतेषु कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2047959, "chapter_id": 2058, "verse_number": "६-१०७-८४", "content_sanskrit": "तदन्तरं समासाद्य पाण्डवो मां धनञ्जयः।\nशरैर्घातयतु क्षिप्रं समन्ताद्भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2047960, "chapter_id": 2058, "verse_number": "६-१०७-८५", "content_sanskrit": "न तं पश्यामि लोकेष मां हन्याद्यः समुद्यतम्।\nऋते कृष्णान्महाभागात्पाण्डवाद्वा धनञ्जयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2047961, "chapter_id": 2058, "verse_number": "६-१०७-८६", "content_sanskrit": "पार्षतं तु पुरोधाय क्लीबमद्य ममाग्रतः ।\nआत्तशस्त्रो रणे यत्तो गृहीतवरकार्मुकः ।\nमां पातयतु बीभत्सुरेवं तव जयो ध्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2047962, "chapter_id": 2058, "verse_number": "६-१०७-८७", "content_sanskrit": "एतत्कुरुष्व कौन्तेय यथोक्तं मम सुव्रत ।\nततो जेष्वसि संग्रामे धार्तराष्ट्रान्समागतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2047963, "chapter_id": 2058, "verse_number": "६-१०७-८८x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2047964, "chapter_id": 2058, "verse_number": "६-१०७-८८", "content_sanskrit": "तेऽनुज्ञातास्ततः पार्था जग्मुः स्वशिबिरं प्रति।\nअभिवाद्य महात्मानं भीष्मं कुरुपितामहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2047965, "chapter_id": 2058, "verse_number": "६-१०७-८९", "content_sanskrit": "तथोक्तवति गाङ्गेये परलोकाय दीक्षिते।\nअर्जुनो दुःखसंतप्तः सव्रीडमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2047966, "chapter_id": 2058, "verse_number": "६-१०७-९०", "content_sanskrit": "गुरुणा कुरुवृद्धेन कृतप्रज्ञेन धीमता ।\nपितामहेन संग्रामे कथं योद्धास्मि माधव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2047967, "chapter_id": 2058, "verse_number": "६-१०७-९१", "content_sanskrit": "क्रीडता हि मया बाल्ये वासुदेव महामनाः ।\nपांसुरूषितगात्रेण महात्मा परुषीकृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2047968, "chapter_id": 2058, "verse_number": "६-१०७-९२", "content_sanskrit": "यस्याहमधिरुह्याङ्कं वालः किल गदाग्रज ।\nतातेत्यवोचं पितरं पितुः पाण्डोर्महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2047969, "chapter_id": 2058, "verse_number": "६-१०७-९३", "content_sanskrit": "नाहं तातस्तव पितुस्तातोऽस्मि तव भारत ।\nइति मामब्रवीद्बाल्ये यः स वध्यः कथं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2047970, "chapter_id": 2058, "verse_number": "६-१०७-९४", "content_sanskrit": "कामं वध्यतु सैन्यं मे नाहं योत्स्ये महात्मना ।\nजयो वास्तु वधो वा मे कथं वा कृष्ण मन्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2047971, "chapter_id": 2058, "verse_number": "६-१०७-९५", "content_sanskrit": "` कथमस्माद्विधः कृष्ण जानन्धर्मं सनातनम् ।\nन्यस्तशस्त्रे च वृद्धे च प्रहरेद्धि पितामहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2047972, "chapter_id": 2058, "verse_number": "६-१०७-९६x", "content_sanskrit": "श्रीवासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2047973, "chapter_id": 2058, "verse_number": "६-१०७-९६", "content_sanskrit": "प्रतिज्ञाय वधं जिष्णो पुरा भीष्मस्य संयुगे।\nक्षत्रधर्मे स्थितः पार्थ कथं नैनं हनिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2047974, "chapter_id": 2058, "verse_number": "६-१०७-९७", "content_sanskrit": "पातयैनं रथात्पार्थ क्षत्रियं युद्धदुर्मदम् ।\nनाहत्वा युधि गाङ्गेयं विजयस्ते भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2047975, "chapter_id": 2058, "verse_number": "६-१०७-९८", "content_sanskrit": "दृष्टमेतत्पुरा देवैर्भविष्यत्यवशस्य ते।\nयद्दृष्टं हि पुरा पार्थ तत्तथा न तदन्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2047976, "chapter_id": 2058, "verse_number": "६-१०७-९९", "content_sanskrit": "न हि भीष्मं दुराधर्षं व्यात्ताननमिवान्तकम् ।\nत्वदन्यः शक्नुयाद्योद्धुमपि वज्रधरः स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2047977, "chapter_id": 2058, "verse_number": "६-१०७-१००", "content_sanskrit": "जहि भीष्मं स्थिरो भूत्वा शृणु चेदं वचो मम।\nयथोवाच पुरा शक्रं महाबुद्धिर्बृहस्पतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2047978, "chapter_id": 2058, "verse_number": "६-१०७-१०१", "content_sanskrit": "ज्यायांसमपि चेद्वृद्धं गुणैरपि समन्वितम् ।\nआततायिनमायान्तं हन्याद्धातकमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2047979, "chapter_id": 2058, "verse_number": "६-१०७-१०२", "content_sanskrit": "शाश्वतोऽयं स्थितो धर्मः क्षत्रियाणां धनञ्जय ।\nयोद्धव्यं रक्षितव्यं च यष्टव्यं चानसूयुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2047980, "chapter_id": 2058, "verse_number": "६-१०७-१०३x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2047981, "chapter_id": 2058, "verse_number": "६-१०७-१०३", "content_sanskrit": "शिखण्डी निधनं कृष्ण भीष्मस्य भविता ध्रुवम् ।\nदृष्ट्वैव हि सदा भीष्मः पाञ्चाल्यं विनिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2047982, "chapter_id": 2058, "verse_number": "६-१०७-१०४", "content_sanskrit": "ते वयं प्रमुखे तस्य पुरस्कृत्य शिखण्डिनम्।\nगाङ्गेयं पातयिष्याम उपायेनेति मे मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2047983, "chapter_id": 2058, "verse_number": "६-१०७-१०५", "content_sanskrit": "अहमन्यान्महेष्वासान्वारयिष्यामि सायकैः ।\nशिखण्ड्यपि युधां श्रेष्ठं भीष्ममेवाभियोधयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2047984, "chapter_id": 2058, "verse_number": "६-१०७-१०६", "content_sanskrit": "श्रुतं हि कुरुमुख्यस्य नाहं हन्यां शिखण्डिनम् ।\nकन्या ह्येषा पुरा भूत्वा पुरुषः समपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2047985, "chapter_id": 2058, "verse_number": "६-१०७-१०७", "content_sanskrit": "`अर्जुनस्य वचः श्रुत्वा भीष्मस्य वधसंयुतम्।\nजहृषुर्हृष्टरोमाणः सकृष्णाः पाण्डवास्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2047986, "chapter_id": 2058, "verse_number": "६-१०७-१०८", "content_sanskrit": "इत्येवं निश्चयं कृत्वा पाण्डवाः सहमाधवाः।\nअनुमान्य महात्मानं प्रययुर्हृष्टमानसाः।\nशयनानि यथा स्वानि भेजिरे पुरुषर्षभाः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2047987, "chapter_id": 2058, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि सप्ताधिकशततमोऽध्यायः ॥\nMahabharata - Bhishma Parva - Chapter Footnotes\n६-१०७-२० एकत इति द्वितीयान्तात्तसिः। एकं केवलं मृत्युमेवाभ्येतीत्यर्थः ॥ ६-१०७-४० विपरीतः क्षुद्रेषु पराक्रमी । गतसत्वो गतबुद्धिः ॥ ६-१०७-६१ युद्धादन्यत्रेत्यर्धं कः पुस्तक एव दृश्यते ॥ ६-१०७-९१ परुषीकृतः रूक्षीकृतः ॥ ६-१०७-९७ युद्धदुर्मदं युद्धोत्सुकम् ॥ ६-१०७-९८ गमिष्याति यमक्षयं इति पाठे भीष्म इति शेषः ॥ ६-१०७-१०१ आततायिनमित्यस्य घातकमिति विशेषणमन्येभ्य आततायिभ्यो व्यवच्छेदायोक्तम् ॥ ६-१०७-१०३ निधनं निधनहेतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}]