[{"id": 2058052, "chapter_id": 2255, "verse_number": "७-१८२-०x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2058053, "chapter_id": 2255, "verse_number": "७-१८२-१", "content_sanskrit": "कथमस्मद्धितार्थं ते कैश्च योगैर्जनार्दन।\nजरासन्धप्रभृतयो घातिताः पृथिवीश्वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2058054, "chapter_id": 2255, "verse_number": "७-१८२-२x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2058055, "chapter_id": 2255, "verse_number": "७-१८२-२", "content_sanskrit": "जरासन्धश्चेदिराजो नैषादिश्च महाबलः।\nयदि स्युर्न हताः पूर्वमिदानीं स्युर्भयङ्कराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2058056, "chapter_id": 2255, "verse_number": "७-१८२-३", "content_sanskrit": "दुर्योधनस्तानवश्यं वृणुयाद्रथसत्तमान्।\nतेऽस्मासु नित्यविद्विष्टाः संश्रयेयुश्च कौरवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2058057, "chapter_id": 2255, "verse_number": "७-१८२-४", "content_sanskrit": "ते हि वीरा महेष्वासाः कृतास्त्रा दृढयोधिनः।\nधार्तराष्ट्रचमूं कृत्स्नां रक्षेयुरमरा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2058058, "chapter_id": 2255, "verse_number": "७-१८२-५", "content_sanskrit": "सूतपुत्रो जरासन्धश्चेदिराजो निषादजः।\nसुयोधनं समाश्रित्य तपेरन्पृथिवीमिमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2058059, "chapter_id": 2255, "verse_number": "७-१८२-६", "content_sanskrit": "योगैरभिहता यैस्ते तन्मे शृणु धनञ्जय।\nअजय्या हि विना योगैर्मृधे ते दैवतैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2058060, "chapter_id": 2255, "verse_number": "७-१८२-७", "content_sanskrit": "एकैको हि पृथक् तेषां समस्तां रिपुवाहिनीम्।\nयोधयेत्समरे पार्थ लोकपालाभिरक्षिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2058061, "chapter_id": 2255, "verse_number": "७-१८२-८", "content_sanskrit": "जरासन्धो हि रुषितो रौहिणेयप्रधर्षितः।\nअस्मद्वधार्थं चिक्षेप गदां वै सर्वघातिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2058062, "chapter_id": 2255, "verse_number": "७-१८२-९", "content_sanskrit": "सीमन्तमिव कुर्वाणा नभसः पावकप्रभा।\nअदृश्यतापतन्ती सा शक्रुमुक्ता यथाऽशनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2058063, "chapter_id": 2255, "verse_number": "७-१८२-१०", "content_sanskrit": "तामापतन्तीं दृष्ट्वैव गदां रोहिणिनन्दनः।\nप्रतिघातार्थमस्त्रं वै स्थूणाकर्णमवासृजत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2058064, "chapter_id": 2255, "verse_number": "७-१८२-११", "content_sanskrit": "अस्त्रवेगप्रतिहता सा गदा प्रापतद्भुवि।\nदारयन्ती धरां देवीं कम्पयन्तीव पर्वतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2058065, "chapter_id": 2255, "verse_number": "७-१८२-१२", "content_sanskrit": "तत्र सा राक्षसी घोरा जरानाम्नी सुविक्रमा।\nसन्दधे सा हि सञ्जातं जरासन्धमरिन्दमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2058066, "chapter_id": 2255, "verse_number": "७-१८२-१३", "content_sanskrit": "द्वाभ्यां जातो हि मातृभ्यामर्धदेहः पृथक्पृथक्।\nजरया सन्धितो यस्माज्जरासन्धस्ततोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2058067, "chapter_id": 2255, "verse_number": "७-१८२-१४", "content_sanskrit": "सा तु भूमिं गता पार्थ हता ससुतबान्दवा।\nगदया तेन चास्त्रेण स्थूणाकर्णेन राक्षसी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2058068, "chapter_id": 2255, "verse_number": "७-१८२-१५", "content_sanskrit": "विनाभूतः स गदया जरासन्धो महामृधे।\nनिहतो भीमसेनेन पश्यतस्ते धनञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2058069, "chapter_id": 2255, "verse_number": "७-१८२-१६", "content_sanskrit": "यदि हि स्याद्गदापाणिर्जरासन्धः प्रतापवान्।\nसेन्द्रा देवा न तं हन्तुं रणे शक्ता नरोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2058070, "chapter_id": 2255, "verse_number": "७-१८२-१७", "content_sanskrit": "त्वद्धितार्थं च नैषादिरङ्गुष्ठेन वियोजितः।\nद्रोणेनाचार्यकं कृत्वा छद्मना सत्यविक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2058071, "chapter_id": 2255, "verse_number": "७-१८२-१८", "content_sanskrit": "स तु बद्धाङ्गुलित्राणो नैषादिर्दृढविक्रमः।\nअतिमानी वचनरो बभौ राम इवापरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2058072, "chapter_id": 2255, "verse_number": "७-१८२-१९", "content_sanskrit": "एकलव्यं हि साङ्गुष्ठमशक्ता देवदानवाः।\nसराक्षसोरगाः पार्थ विजेतुं युधि कर्हिचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2058073, "chapter_id": 2255, "verse_number": "७-१८२-२०", "content_sanskrit": "किमु मानुषमात्रेण शक्यः स्यात्प्रतिवीक्षितुम्।\nदृढमुष्टिः कृती नित्यमस्यमानो दिवानिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2058074, "chapter_id": 2255, "verse_number": "७-१८२-२१", "content_sanskrit": "त्वद्धितार्थं तु स मया हतः सङ्ग्राममूर्धनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2058075, "chapter_id": 2255, "verse_number": "७-१८२-२२", "content_sanskrit": "चेदिराजश्च विक्रान्तः प्रत्यक्षं निहतस्तव।\nस चाप्यशक्यः सङ्ग्रामे जेतुं सर्वसुरासुरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2058076, "chapter_id": 2255, "verse_number": "७-१८२-२३", "content_sanskrit": "वधार्थं तस्य जातोऽहमन्येषां च सुरद्विषाम्।\nत्वत्सहायो नरव्याघ्र लोकानां हितकाम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2058077, "chapter_id": 2255, "verse_number": "७-१८२-२४", "content_sanskrit": "हिडिम्बबककिर्मीरा भीमसेनेन पातिताः।\nरावणेन समप्राणा ब्रह्मयज्ञविनाशनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2058078, "chapter_id": 2255, "verse_number": "७-१८२-२५", "content_sanskrit": "हतस्तथैव मायावी हैडिम्बेनाप्यलायुधः।\nहैडिम्बश्चाप्युपायेन शक्त्या कर्णेन घातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2058079, "chapter_id": 2255, "verse_number": "७-१८२-२६", "content_sanskrit": "यदि ह्येनं नाहनिष्यत्कर्णः शक्त्या महामृधे।\nमयां वध्योऽभविष्यत्स भैमसेनिर्घटोत्कचः।\nमया न निहतः पूर्वमेष युष्मत्प्रियेप्सया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2058080, "chapter_id": 2255, "verse_number": "७-१८२-२७", "content_sanskrit": "एष हि ब्राह्मणद्वेषी यज्ञद्वेषी च राक्षसः।\nधर्मस्य लोप्ता पापात्मा तस्मादेव निपातितः।\nव्यंसिता चाप्यूपायेन शक्रदत्ता मयाऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2058081, "chapter_id": 2255, "verse_number": "७-१८२-२८", "content_sanskrit": "येहि धर्मस्य लोप्तारो वध्यास्ते मम पाण्डव।\nधर्मसंस्थापनार्थं हि प्रतिज्ञैषा ममाव्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2058082, "chapter_id": 2255, "verse_number": "७-१८२-२९", "content_sanskrit": "ब्रह्म सत्यं दमः शौचं धर्मो हीः श्रीर्धृतिः क्षमा।\nयत्र तत्र रमे नित्यमहं सत्येन ते शपे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2058083, "chapter_id": 2255, "verse_number": "७-१८२-३०", "content_sanskrit": "न विषादस्त्वया कार्यः कर्णं वैकर्तनं प्रति।\nउपदेक्ष्याम्युपायं ते येन तं प्रसहिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2058084, "chapter_id": 2255, "verse_number": "७-१८२-३१", "content_sanskrit": "सुयोधनं चापि रणे हनिष्यति वृकोदरः।\nतस्यापि च वधोपायं वक्ष्यामि तव पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2058085, "chapter_id": 2255, "verse_number": "७-१८२-३२", "content_sanskrit": "वर्धते तुमुलस्त्वेष शब्दः पचरमूं प्रति।\nविद्रवन्ति च सैन्यानि त्वदीयानि दिशो दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2058086, "chapter_id": 2255, "verse_number": "७-१८२-३३", "content_sanskrit": "लब्धलक्ष्या हि कौरव्या विधमन्ति चमूं तव।\nदहत्येष च वः सैन्यं द्रोणः प्रहरतां वरः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2058087, "chapter_id": 2255, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि घटोत्कचवधपर्वणि चतुर्दशरात्रियुद्धे द्व्यशीत्यधिकथततमोऽध्यायः॥ १८२ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१८२-१ योगैरुपायैः॥ ५-१८२- रौक्मिणेयप्रधर्षितः इति क.ङ.पाठः॥ ५-१८२- व्यंसिता व्यर्थीकृता शक्तिरिति शेषः॥ ५-१८२-द्व्यशीत्यधिकशततमोऽध्यायः॥ १८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]