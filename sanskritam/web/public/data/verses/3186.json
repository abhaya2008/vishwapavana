[{"id": 2101402, "chapter_id": 3186, "verse_number": "१४-४२-१", "content_sanskrit": "ब्रह्मोवाच।\nअहङ्कारात्प्रसूतानि महाभूतानि पञ्च वै।\nपृथिवी वायुराकाशमापो ज्योतिश्च पञ्चमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2101403, "chapter_id": 3186, "verse_number": "१४-४२-२", "content_sanskrit": "तेषु भूतानि मुह्यन्ति महाभूतेषु पञ्चसु।\nशब्दस्पर्शनरूपेषु रसगन्धक्रियासु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2101404, "chapter_id": 3186, "verse_number": "१४-४२-३", "content_sanskrit": "महाभूतविकारान्ते प्रलये प्रत्युपस्थिते।\nसर्वप्राणभूतां धीरा महदुत्पद्यते भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2101405, "chapter_id": 3186, "verse_number": "१४-४२-४", "content_sanskrit": "यद्यस्माज्जायते भूतं तत्र तत्प्रविलीयते।\nलीयन्ते प्रतिलोमानि जायन्ते चोत्तरोत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2101406, "chapter_id": 3186, "verse_number": "१४-४२-५", "content_sanskrit": "ततः प्रलीने सर्वस्मिन्भूते स्थावरजङ्गमे।\nस्मृतिमन्तस्तदा धीरा न लीयन्ते कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2101407, "chapter_id": 3186, "verse_number": "१४-४२-६", "content_sanskrit": "शब्दः स्पर्शस्तथा रूपं रसो गन्धश्च पञ्चमः।\nक्रियाः करणयुक्ताः स्युरनित्या मोहसंज्ञिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2101408, "chapter_id": 3186, "verse_number": "१४-४२-७", "content_sanskrit": "लोभप्रजनसम्भूता निर्विशेषा ह्यकिञ्चनाः।\nमांसशोणितसङ्घाता अन्योन्यस्योपजीविनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2101409, "chapter_id": 3186, "verse_number": "१४-४२-८", "content_sanskrit": "बहिरात्मान इत्येते दीनाः कृपणजीविनः।\nप्राणापानावुदानश्च समानो व्यान एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2101410, "chapter_id": 3186, "verse_number": "१४-४२-९", "content_sanskrit": "अन्तरात्मनि चाप्येते नियताः पञ्च वायवः।\nवाङ्मनोबुद्धिरित्येभिः सार्धमष्टात्मकं जगत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2101411, "chapter_id": 3186, "verse_number": "१४-४२-१०", "content_sanskrit": "त्वग्घ्राणश्रोत्रचक्षूंषि रसना वाक्च संयताः।\nविशुद्धं च मनो यस्य बुद्धिश्चाव्यभिचारिणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2101412, "chapter_id": 3186, "verse_number": "१४-४२-११", "content_sanskrit": "अष्टौ यस्याग्नयो ह्येते दहन्तेऽहङ्क्रियाः सदा।\nस तद्ब्रह्म शुभं याति तस्माद्भूयो न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2101413, "chapter_id": 3186, "verse_number": "१४-४२-१२", "content_sanskrit": "एकादश च यान्याहुरिन्द्रियाणि विशेषतः।\nअहङ्कारात्प्रसूतानि तानि वक्ष्यामि नामतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2101414, "chapter_id": 3186, "verse_number": "१४-४२-१३", "content_sanskrit": "श्रोत्रं त्वक् चक्षुषी जिह्वा नासिका चैव पञ्चमी।\nपादौ पायुरुपस्थश्च हस्तौ वाग्दशमी भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2101415, "chapter_id": 3186, "verse_number": "१४-४२-१४", "content_sanskrit": "इन्द्रियग्राम इत्येष मन एकादशं भवेत्।\nएतं ग्रामं जयेत्पूर्वं ततो ब्रह्म प्रकाशते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2101416, "chapter_id": 3186, "verse_number": "१४-४२-१५", "content_sanskrit": "बुद्धीन्द्रियाणि पञ्चाहुः पञ्च कर्मेन्द्रियाणि च।\nश्रोत्रादीन्यपि पञ्चाहुर्बुद्धियुक्तानि तत्त्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2101417, "chapter_id": 3186, "verse_number": "१४-४२-१६", "content_sanskrit": "अविशेषाणि चान्यानि कर्मयुक्तानि यानि तु।\nउभयत्र मनो ज्ञेयं बुद्धिस्तु द्वादशी भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2101418, "chapter_id": 3186, "verse_number": "१४-४२-१७", "content_sanskrit": "इत्युक्तानीन्द्रियाण्येतान्येकादश यथाक्रमम्।\nमन्यन्ते कृतमित्येवं विदित्वा तानि पण्डिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2101419, "chapter_id": 3186, "verse_number": "१४-४२-१८", "content_sanskrit": "`त्रीणि स्थानानि भूतानां चतुर्थं नोपपद्यते।\nस्थलमापस्तथाऽऽकाशं जन्म चापि चतुर्विधम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2101420, "chapter_id": 3186, "verse_number": "१४-४२-१९", "content_sanskrit": "अण्डजोद्भिज्जसंस्वेदजरायुजमथापि च।\nचतुर्धा जन्म इत्येतद्भूतग्रामस्य लक्ष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2101421, "chapter_id": 3186, "verse_number": "१४-४२-२०", "content_sanskrit": "अपराण्यथ भूतानि खेचराणि तथैव च।\nअण्डजानि विजानीयात्सर्वांश्चैव सरीसृपान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2101422, "chapter_id": 3186, "verse_number": "१४-४२-२१", "content_sanskrit": "स्वेदजाः कृमयः प्रोक्ता जन्तवश्च यथाक्रमम्।\nजन्मद्वितीयमित्येतज्जघन्यतरमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2101423, "chapter_id": 3186, "verse_number": "१४-४२-२२", "content_sanskrit": "भित्त्वा तु पृथिवीं यानि जायन्ते कालपर्ययात्।\nउद्भिज्जानि च तान्याहुर्भूतानि द्विजसत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2101424, "chapter_id": 3186, "verse_number": "१४-४२-२३", "content_sanskrit": "द्विपादबहुपादानि तिर्यग्गतिमतीनि च।\nजरायुजानि भूतानि विकृतान्यपि सत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2101425, "chapter_id": 3186, "verse_number": "१४-४२-२४", "content_sanskrit": "द्विविधा खलु विज्ञेया ब्रह्मयोनिः सनातना।\nतपः कर्म च यत्पुण्यमित्येष विदुषां नयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2101426, "chapter_id": 3186, "verse_number": "१४-४२-२५", "content_sanskrit": "विविधं कर्म विज्ञेयमिज्या दानं च तन्मखे।\nवेदस्याध्ययनं पुण्यमिति वृद्धानुशासनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2101427, "chapter_id": 3186, "verse_number": "१४-४२-२६", "content_sanskrit": "एतद्यो वेत्ति विधिवत्स मुक्तः स्याद्द्विजर्षभाः।\nविमुक्तः सर्वपापेभ्य इति चैव निबोधत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2101428, "chapter_id": 3186, "verse_number": "१४-४२-२७", "content_sanskrit": "`अतः परं प्रवक्ष्यामि सर्वं विविधमिन्द्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2101429, "chapter_id": 3186, "verse_number": "१४-४२-२८", "content_sanskrit": "आकाशं प्रथमं भूतं श्रोत्रमध्यात्ममुच्यते।\nअधिभूतं तथा शब्दो दिशश्चात्राधिदैवतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2101430, "chapter_id": 3186, "verse_number": "१४-४२-२९", "content_sanskrit": "द्वितीयं मारुतं भूतं त्वगध्यात्मं च विश्रुतम्।\nस्प्रष्टव्यमधिभूतं तु विद्युत्तत्राधिदैवतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2101431, "chapter_id": 3186, "verse_number": "१४-४२-३०", "content_sanskrit": "तृतीयं ज्योतिरित्याहुश्चक्षुरध्यात्ममिष्यते।\nअधिभूतं ततो रूपं सूर्यस्तत्राधिदैवतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2101432, "chapter_id": 3186, "verse_number": "१४-४२-३१", "content_sanskrit": "चतुर्थमापो विज्ञेयं जिह्वा चाध्यात्ममिष्यते।\nअधिभूतं रसश्चात्र सोमस्तत्राधिदैवतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2101433, "chapter_id": 3186, "verse_number": "१४-४२-३२", "content_sanskrit": "पृथिवी पञ्चमं भूतं घ्राणश्चाध्यात्ममुच्यते।\nअधिभूतं तथा गन्धो वायुस्तत्रादिदैवतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2101434, "chapter_id": 3186, "verse_number": "१४-४२-३३", "content_sanskrit": "एषु पञ्चसु भूतेषु चतुष्टयविधिः स्मृतः।\nअतः परं प्रवक्ष्यामि सर्वं त्रिविधमिन्द्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2101435, "chapter_id": 3186, "verse_number": "१४-४२-३४", "content_sanskrit": "पादावध्यात्ममित्याहुर्ब्राह्मणास्तत्वदर्शिनः।\nअधिभूतं तु गन्तव्यं विष्णुस्तत्राधिदैवतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2101436, "chapter_id": 3186, "verse_number": "१४-४२-३५", "content_sanskrit": "अवाग्गतिरपानश्च पायुरध्यात्ममिष्यते।\nअधिभूतं विसर्गश्च मित्रस्तत्राधिदैवतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2101437, "chapter_id": 3186, "verse_number": "१४-४२-३६", "content_sanskrit": "प्रजनः सर्वभूतानामुपस्थोऽध्यात्ममुच्यते।\nअधिभूतं तथा शुक्रं दैवतं च प्रजापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2101438, "chapter_id": 3186, "verse_number": "१४-४२-३७", "content_sanskrit": "हस्तावध्यात्ममित्याहुरद्यात्मविदुषो जनाः।\nअधिभूतं च कर्माणि शक्रस्तत्राधिदैवतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2101439, "chapter_id": 3186, "verse_number": "१४-४२-३८", "content_sanskrit": "वैश्वदेवी मनःपूर्वा वागध्यात्ममिहोच्यते।\nवक्तव्यमधिभूतं च वह्निस्तत्राधिदैवतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2101440, "chapter_id": 3186, "verse_number": "१४-४२-३९", "content_sanskrit": "अध्यात्मं मन इत्याहुः पञ्चभूतात्मचारकम्।\nअधिभूतं च सङ्कल्पश्चन्द्रमाश्चाधिदैवतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2101441, "chapter_id": 3186, "verse_number": "१४-४२-४०", "content_sanskrit": "अहङ्कारस्तथाऽध्यात्मं सर्वसंसारकारणम्।\nअभिमानोऽधिभूतं च रुद्रस्तत्राधिदैवतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2101442, "chapter_id": 3186, "verse_number": "१४-४२-४१", "content_sanskrit": "अध्यात्मं बुद्धिरित्याहुः षडिन्द्रियविचारिणी।\nअधिभूतं तु विज्ञेयमहस्तत्राधिदैवतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2101443, "chapter_id": 3186, "verse_number": "१४-४२-४२", "content_sanskrit": "यथावदध्यात्मविधिरेष वः कीर्तितो मया।\nज्ञानमस्य हि धर्मज्ञाः प्राप्तं ज्ञानवतामिह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2101444, "chapter_id": 3186, "verse_number": "१४-४२-४३", "content_sanskrit": "इन्द्रियाणीन्द्रियार्थाश्च महाभूतानि पञ्च च।\nसर्वाण्येतानि संधाय मनसा सम्प्रधारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2101445, "chapter_id": 3186, "verse_number": "१४-४२-४४", "content_sanskrit": "क्षीणे मनसि सर्वस्मिन्न जन्मसुखमिष्यते।\nज्ञानसम्पन्नसत्त्वानां तत्सुखं विदुषां मतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2101446, "chapter_id": 3186, "verse_number": "१४-४२-४५", "content_sanskrit": "अतः परं प्रवक्ष्यामि सूक्ष्मभावकरीं शिवाम्।\nनिवृत्तिं सर्वभूतेषु मृदुना दारुणेन वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2101447, "chapter_id": 3186, "verse_number": "१४-४२-४६", "content_sanskrit": "गुणागुणमनासङ्गमेकचर्यमनन्तरम्।\nएतद्ब्राह्मणजं वृत्तमाहुरेकपदं सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2101448, "chapter_id": 3186, "verse_number": "१४-४२-४७", "content_sanskrit": "विद्वान्कूर्म इवाङ्गानि कामान्संहृत्य सर्वशः।\nविरजाः सर्वतो मुक्तो यो नरः स सुखी सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2101449, "chapter_id": 3186, "verse_number": "१४-४२-४८", "content_sanskrit": "कामानात्मनि संयम्य क्षीणतृष्णः समाहितः।\nसर्वभूतसुहृन्मैत्रो ब्रह्मभूयाय कल्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2101450, "chapter_id": 3186, "verse_number": "१४-४२-४९", "content_sanskrit": "इन्द्रियाणां निरोधेन सर्वेषां विषयैषिणाम्।\nमुनेर्जनपदत्यागादध्यात्माग्निः समिध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2101451, "chapter_id": 3186, "verse_number": "१४-४२-५०", "content_sanskrit": "यथाऽग्निरिन्धनैरिद्धो महाज्योतिः प्रकाशते।\nतथेन्द्रियनिरोधेन महानात्मा प्रकाशतदे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2101452, "chapter_id": 3186, "verse_number": "१४-४२-५१", "content_sanskrit": "यदा पश्यति भूतानि प्रसन्नात्माऽत्मनो हृदि।\nस्वयंज्योतिस्तदासूक्ष्मात्सूक्ष्मं प्राप्नोत्यनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2101453, "chapter_id": 3186, "verse_number": "१४-४२-५२", "content_sanskrit": "अग्नी रूपं रसं स्रोतो वायुः स्पर्शनमेव च।\nमही गन्धधरा घ्राणमाकाशः श्रवणं तथा।\n`दृश्यमादित्यमेवाहुरध्यात्मविदुषो जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2101454, "chapter_id": 3186, "verse_number": "१४-४२-५३", "content_sanskrit": "रोगशोकसमाविष्टं पञ्चस्रोतःसमावृतम्।\nपञ्चभूतसमायुक्तं नवद्वारं द्विदैवतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2101455, "chapter_id": 3186, "verse_number": "१४-४२-५४", "content_sanskrit": "रजस्वलमथादृश्यं त्रिगुणं सप्तधातुकम्।\nसंसर्गाभिरतं मूढं शरीरमिति धारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2101456, "chapter_id": 3186, "verse_number": "१४-४२-५५", "content_sanskrit": "दुश्चरं जीवलोकेऽस्मिन्सत्वं प्रति समाश्रितम्।\nएतदेव हि लोकेऽस्मिन्कालचक्रं प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2101457, "chapter_id": 3186, "verse_number": "१४-४२-५६", "content_sanskrit": "एतन्महार्णवं घोरमगाधं मोहसंझितम्।\nविसृजन्संक्षिपेच्चैव मोहयन्स्वापयञ्जगत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2101458, "chapter_id": 3186, "verse_number": "१४-४२-५७", "content_sanskrit": "कामं क्रोधं भयं लोभमभिद्रोहमथानृतम्।\nइन्द्रियाणां निरोधेन सतस्त्यजति दुस्त्यजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2101459, "chapter_id": 3186, "verse_number": "१४-४२-५८", "content_sanskrit": "यस्यैते निर्जिता लोके त्रिगुणाः पञ्चधातवः।\nव्योम्नि तस्य परं स्थानमानन्तमथ लक्ष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2101460, "chapter_id": 3186, "verse_number": "१४-४२-५९", "content_sanskrit": "पञ्चेन्द्रियमहाकूलां मनःस्रोतोभयावहाम्।\nनदीं मोहह्रदां तीर्त्वा कामक्रोधावुभौ जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2101461, "chapter_id": 3186, "verse_number": "१४-४२-६०", "content_sanskrit": "स सर्वदोषनिर्मुक्तस्ततः पश्यति तत्परम्।\nमनो मनसि सन्धाय पश्यन्नात्मानमात्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2101462, "chapter_id": 3186, "verse_number": "१४-४२-६१", "content_sanskrit": "सर्ववित्सर्वभूतेषु द्रक्ष्यत्यात्मानमात्मनि।\nएकधा बहुधा चैव विकुर्वाणस्ततस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2101463, "chapter_id": 3186, "verse_number": "१४-४२-६२", "content_sanskrit": "ध्रुवं पश्यति रूपाणि दीपाद्दीपशतं यथा।\nस वै विष्णुश्च मित्रश्च वरुणोऽग्निः प्रजापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2101464, "chapter_id": 3186, "verse_number": "१४-४२-६३", "content_sanskrit": "स हि धाता विधाता च स प्रभुः सर्वतोमुखः।\nहृदयं सर्वभूतानां महानात्मा प्रकाशते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2101465, "chapter_id": 3186, "verse_number": "१४-४२-६४", "content_sanskrit": "तं विप्रसङ्घाश्च सुरासुराश्च\nयक्षाः पिशाचाः पितरो वयांसि।\nरक्षोगणा भूतगणाश्च सर्वे\nमहर्षयश्चैव सदा स्तुवन्ति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2101466, "chapter_id": 3186, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि द्विचत्वारिंशोऽध्यायः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]