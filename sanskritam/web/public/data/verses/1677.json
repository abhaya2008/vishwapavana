[{"id": 2031081, "chapter_id": 1677, "verse_number": "३-३१५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2031082, "chapter_id": 1677, "verse_number": "३-३१५-१", "content_sanskrit": "ततस्ते यक्षवचनादुदतिष्ठन्त पाण्डवः।\nक्षुत्पिपासे च सर्वेषां क्षणेन व्यपगच्छताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2031083, "chapter_id": 1677, "verse_number": "३-३१५-२x", "content_sanskrit": "युधिष्ठि उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2031084, "chapter_id": 1677, "verse_number": "३-३१५-२", "content_sanskrit": "सरस्येकेन पादेन तिष्ठन्तमपराजितम्।\nपृच्छामि को भवान्देवो न मे यक्षो मतो भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2031085, "chapter_id": 1677, "verse_number": "३-३१५-३", "content_sanskrit": "बसूनां वा भवानेको रुद्राणामथवा भवान्।\nअथवा मरुतां श्रेष्ठो वज्री वा त्रिदशेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2031086, "chapter_id": 1677, "verse_number": "३-३१५-४", "content_sanskrit": "मम हि भ्रातर इमे सहस्रशतयोधिनः।\nतं योधं न प्रपश्यामि येन सर्वे निपातिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2031087, "chapter_id": 1677, "verse_number": "३-३१५-५", "content_sanskrit": "सुखं प्रति प्रबुद्दानामिन्द्रियाण्युपलक्षये।\nस भवान्सुहृदोस्माकमथवा नः पिता भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2031088, "chapter_id": 1677, "verse_number": "३-३१५-६x", "content_sanskrit": "यक्ष उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2031089, "chapter_id": 1677, "verse_number": "३-३१५-६", "content_sanskrit": "अहंते जनकस्तात धर्मो मृदुपराक्रम।\nत्वां रदिदृक्षुरनुप्राप्तो विद्धि मां भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2031090, "chapter_id": 1677, "verse_number": "३-३१५-७", "content_sanskrit": "यशः सत्यंदमः शौचमार्जवं ह्रीरचापलम्।\nदानं तपो ब्रह्मचर्यमित्येतास्तनवो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2031091, "chapter_id": 1677, "verse_number": "३-३१५-८", "content_sanskrit": "अहिंसा समता शान्तिस्तपः शौचममत्सरः।\nद्वाराण्येतानि मे विद्धि प्रियो ह्यसि सुतो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2031092, "chapter_id": 1677, "verse_number": "३-३१५-९", "content_sanskrit": "दिष्ट्या पञ्चसु रक्तोसि दिष्ट्या ते षट्रपदी जिता।\nद्वे पूर्वे मध्यमे द्वे च द्वे शान्ते सांपरायिके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2031093, "chapter_id": 1677, "verse_number": "३-३१५-१०", "content_sanskrit": "ध्रमोऽहमिति भद्रं ते जिज्ञासुस्त्वामिहागतः।\nआनृशंस्येन तुष्टोस्मि वरं दास्यामि तेऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2031094, "chapter_id": 1677, "verse_number": "३-३१५-११", "content_sanskrit": "वरं वृणीष्व राजेन्द्रदाता ह्यस्मि तवानघ।\nये हि मे पुरुषा भक्ता न तेषामस्ति दुर्गतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2031095, "chapter_id": 1677, "verse_number": "३-३१५-१२x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2031096, "chapter_id": 1677, "verse_number": "३-३१५-१२", "content_sanskrit": "अरणी तु हृतायस्य मृगेण वदतांवर।\nतस्याग्नयो न लुप्येरन्प्रथमोऽस्तु वरो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2031097, "chapter_id": 1677, "verse_number": "३-३१५-१३x", "content_sanskrit": "धर्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2031098, "chapter_id": 1677, "verse_number": "३-३१५-१३", "content_sanskrit": "आरणेयमिदं तस्य ब्राह्मणस्य हृतं मया।\nमृगवेषेण कौन्तेय जिज्ञालार्थं तवानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2031099, "chapter_id": 1677, "verse_number": "३-३१५-१४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2031100, "chapter_id": 1677, "verse_number": "३-३१५-१४", "content_sanskrit": "ददानीत्येव भगवानुत्तरं प्रत्यपद्यत।\nअन्यं वरय भद्रं ते वरं त्वममरोपम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2031101, "chapter_id": 1677, "verse_number": "३-३१५-१५x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2031102, "chapter_id": 1677, "verse_number": "३-३१५-१५", "content_sanskrit": "वर्षाणि द्वादशारण्ये त्रयोदशमुपस्थितम्।\nतत्रनो नाभिजानीयुर्वसतो मनुजाः क्वचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2031103, "chapter_id": 1677, "verse_number": "३-३१५-१६", "content_sanskrit": "ददानीत्येव भगवानुत्तरं प्रत्यपद्यत।\nभूयश्चाश्वासयामास कौन्तेयं सत्यविक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2031104, "chapter_id": 1677, "verse_number": "३-३१५-१७", "content_sanskrit": "यद्यपि स्वेन रूपेण चरिष्यथ महीमिमाम्।\nन वो विज्ञास्यते कश्चित्रिषु लोकेषु भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2031105, "chapter_id": 1677, "verse_number": "३-३१५-१८", "content_sanskrit": "वर्षंत्रयोदशमिदं मत्प्रसादात्कुरूद्वहाः।\nविराटनगरे गूढा अविज्ञाताश्चरिष्यथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2031106, "chapter_id": 1677, "verse_number": "३-३१५-१९", "content_sanskrit": "यद्वः संकल्पितं रूपं मनसा यस् यादृशम्।\nतादृशं तादृशं सर्वे छन्दतो धारयिष्यथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2031107, "chapter_id": 1677, "verse_number": "३-३१५-२०", "content_sanskrit": "अरणीसहितं भाण्डं ब्राह्मणाय प्रयच्छत।\nजिज्ञासार्थं मया ह्येतदाहृतंमृगरूपिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2031108, "chapter_id": 1677, "verse_number": "३-३१५-२१", "content_sanskrit": "प्रवृणीष्वापरं सौम्य वरमिष्टं ददानि ते।\nन तृप्यामि नरश्रेष्ठ प्रयच्छन्वै वरांस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2031109, "chapter_id": 1677, "verse_number": "३-३१५-२२", "content_sanskrit": "तृतीयं गृह्यतां पुत्र वरमप्रतिमं महत्।\nत्वं हि मत्प्रभवो राजन्विदुरश्चममांशजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2031110, "chapter_id": 1677, "verse_number": "३-३१५-२३x", "content_sanskrit": "जुधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2031111, "chapter_id": 1677, "verse_number": "३-३१५-२३", "content_sanskrit": "देवदेवो मया दृष्टो भवान्साक्षात्सनातनः।\nयं ददासि वरं तुष्टस्तं ग्रहीष्याम्यहं पितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2031112, "chapter_id": 1677, "verse_number": "३-३१५-२४", "content_sanskrit": "जयेयं लोभमोहौ च क्रोधं चाहं सदा विभो।\nदाने तपसि सत्ये च मनो मे सततं वेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2031113, "chapter_id": 1677, "verse_number": "३-३१५-२५x", "content_sanskrit": "धर्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2031114, "chapter_id": 1677, "verse_number": "३-३१५-२५", "content_sanskrit": "रउपपन्नो गुणैरेतैः स्वभावेनासि पाण्डव।\nभवान्धर्मः पुनश्चैव यथोक्तं ते भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2031115, "chapter_id": 1677, "verse_number": "३-३१५-२६x", "content_sanskrit": "वैशंवायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2031116, "chapter_id": 1677, "verse_number": "३-३१५-२६", "content_sanskrit": "इत्युक्त्वान्तऽर्दधे धर्मो भगबाँल्लोकभावनः।\nसमेताः पाण्डवाश्चैव सुखसुप्ता मनस्विनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2031117, "chapter_id": 1677, "verse_number": "३-३१५-२७", "content_sanskrit": "उपेत्यचाश्रमं वीराः सर्व एव गतक्लमाः।\nआरणेयं ददुस्तस्मै ब्राह्मणाय तपस्विने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2031118, "chapter_id": 1677, "verse_number": "३-३१५-२८", "content_sanskrit": "इदं समुत्थानसमागतं मह-\nत्पितुश्चपुत्रस्य च कीर्तिवर्धनम्।\nपठन्नरः रस्याद्विजितेन्द्रियो वशी\nसपुत्रपौत्रः शतपर्षभाग्भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2031119, "chapter_id": 1677, "verse_number": "३-३१५-२९", "content_sanskrit": "न चाप्यधर्मे न सुहृद्विभेदने\nपरस्वहारे परदारमर्शने।\nकदर्यभावे न रमेनेमनः सदा\nनृणां सदाख्यानमिदं विजानताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2031120, "chapter_id": 1677, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसाहस्रिकायां संहितायां वैयासिक्यां अरण्यपर्वणि आरणेयपर्वणि पञ्चदशाधिकत्रिशततमोऽध्यायः ॥ ३१५ ॥\nआरणेयपर्व समाप्तम् ॥ २१ ॥ समाप्तमिदमरण्यपर्व च ॥ ३ ॥ अतः परं विराटपर्व भविष्यति। तस्यायमाद्यः श्लोकः। जनमेयज उवाच। कथं विराटनगरे मम पूर्वपितामहाः। अज्ञातवासमुषिता दुर्योधनभयार्दिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]