[{"id": 7004994000, "chapter_id": 24994, "verse_number": "७-१-१७७-१", "content_sanskrit": "ईश्वर उवाच ।\nतस्यैव पूर्वदिग्भागे लकुलीशस्तु मूर्तिमान् ।\nस्वयं तिष्ठति देवेशि कृत्वा घोरं तपः पुरा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004994001, "chapter_id": 24994, "verse_number": "७-१-१७७-२", "content_sanskrit": "संस्थितः पापशमने तत्र स्थाने स्थलोपरि ।\nकार्तिक्यां कृत्तिकायोगे यस्तं पूजयते नरः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004994002, "chapter_id": 24994, "verse_number": "७-१-१७७-३", "content_sanskrit": "स पूज्यते महादेवि सर्वैरपि सुरासुरैः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004994003, "chapter_id": 24994, "verse_number": "७-१-१७७-४", "content_sanskrit": "इति श्रीस्कान्दे महापुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभासखण्डे प्रथमे प्रभासक्षेत्रमाहात्म्ये लकुलीशमाहात्म्यवर्णनंनाम सप्तसप्तत्युत्तरशततमो ऽध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}]