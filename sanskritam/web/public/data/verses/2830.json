[{"id": 2085992, "chapter_id": 2830, "verse_number": "१२-३३५-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2085993, "chapter_id": 2830, "verse_number": "१२-३३५-१", "content_sanskrit": "एतच्छ्रुत्वा तु वचनं कृतात्मा कृतनिश्चयः।\nआत्मनाऽऽत्मानमास्थाय दृष्ट्वा चात्मानमात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2085994, "chapter_id": 2830, "verse_number": "१२-३३५-२", "content_sanskrit": "कृतकार्यः सुखी शान्तस्तूष्णीं प्रायादुदङ्भुखः।\nशैशिरं गिरिमुद्दिश्य सधर्मा मातरिश्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2085995, "chapter_id": 2830, "verse_number": "१२-३३५-३", "content_sanskrit": "एतस्मिन्नेव काले तु देवर्षिर्नारदस्तथा।\nहिमवन्तमियाद्दुष्टुं सिद्धचारणसेवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2085996, "chapter_id": 2830, "verse_number": "१२-३३५-४", "content_sanskrit": "तमप्सरोगाकीर्णं गीतस्वननिनादितम्।\nकिन्नराणां सहस्रैश्च भृङ्गराजैस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2085997, "chapter_id": 2830, "verse_number": "१२-३३५-५", "content_sanskrit": "मद्गुभिः खञ्जरीटैश्च विचित्रैर्जीवजीवकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2085998, "chapter_id": 2830, "verse_number": "१२-३३५-६", "content_sanskrit": "चित्रवर्णैर्मयूरैश्च केकाशतविराजितैः।\nराजहंससमूहैश्च हृष्टैः परभृतैस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2085999, "chapter_id": 2830, "verse_number": "१२-३३५-७", "content_sanskrit": "पक्षिराजो गरुत्मांश्च यं नित्यमधितिष्ठति।\nचत्वारो लोकपालाश्च देवाः सर्षिगणास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2086000, "chapter_id": 2830, "verse_number": "१२-३३५-८", "content_sanskrit": "तत्र नित्यं समायान्ति लोकस्य हितकाम्यया।\nविष्णुना यत्र पुत्रार्थे तपस्तप्तं महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2086001, "chapter_id": 2830, "verse_number": "१२-३३५-९", "content_sanskrit": "तत्रैव च कुमारेण बाल्ये क्षिप्ता दिवौकसः।\nशक्तिर्न्यस्ता क्षितितले त्रैलोक्यमवमन्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2086002, "chapter_id": 2830, "verse_number": "१२-३३५-१०", "content_sanskrit": "तत्रोवाच जगत्स्कन्दः क्षिपन्वाक्यमिदं तदा।\nयोऽन्योस्ति मत्तोऽभ्यधिको विप्रा यस्याधिकं प्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2086003, "chapter_id": 2830, "verse_number": "१२-३३५-११", "content_sanskrit": "यो ब्रह्मण्यो द्वितीयोऽस्ति त्रिषु लोकेषु वीर्यवान्।\nसोभ्युद्धरत्विमां शक्तिमथवा कम्पयत्विति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2086004, "chapter_id": 2830, "verse_number": "१२-३३५-१२", "content_sanskrit": "तच्छुत्वा व्यथिता लोकाः क इमामुद्धरेदिति।\nअथ देवगणं सर्वं संभ्रान्तेन्द्रियमानसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2086005, "chapter_id": 2830, "verse_number": "१२-३३५-१३", "content_sanskrit": "अपश्यद्भगवान्विष्णुः क्षिप्तं सासुरराक्षसम्।\nकिंन्वत्र सुकृतं कार्यं भवेदिति विचिन्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2086006, "chapter_id": 2830, "verse_number": "१२-३३५-१४", "content_sanskrit": "अनामृष्य ततः क्षेपमवैक्षत च पाविकम्।\nसंप्रगृह्य विशुद्धात्मा शक्तिं प्रज्वलितां तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2086007, "chapter_id": 2830, "verse_number": "१२-३३५-१५", "content_sanskrit": "कम्पयामास सव्येन पाणिना पुरुषोत्तमः।\nशक्त्यां तु कम्प्यमानायां विष्णुना बलिना तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2086008, "chapter_id": 2830, "verse_number": "१२-३३५-१६", "content_sanskrit": "मेदिनी कम्पिता सर्वा सशैलवनकानना।\nशक्तेनापि समुद्धर्तुं कम्पिता साऽभवत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2086009, "chapter_id": 2830, "verse_number": "१२-३३५-१७", "content_sanskrit": "रक्षिता स्कन्दराजस्य धर्षणा प्रभविष्णुना।\nतां कम्पयित्वा भगवान्प्रह्लादमिदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2086010, "chapter_id": 2830, "verse_number": "१२-३३५-१८", "content_sanskrit": "पश्य वीर्यं कुमारस्य नैतदन्यः करिष्यति।\nसोऽमृष्यमाणस्तद्वाक्यं समुद्धरणनिश्चितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2086011, "chapter_id": 2830, "verse_number": "१२-३३५-१९", "content_sanskrit": "जग्राह तां तदा शक्तिं न चैनामभ्यकम्पयत्।\nनादं महान्तं मुक्त्वा स मूर्च्छितो गिरिमूर्घनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2086012, "chapter_id": 2830, "verse_number": "१२-३३५-२०", "content_sanskrit": "विह्वलः प्रापतद्भूमौ हिरण्यकशिपोः सुतः।\nतत्रोत्तरां दिशं गत्वा शैलराजस्य पार्श्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2086013, "chapter_id": 2830, "verse_number": "१२-३३५-२१", "content_sanskrit": "तपोऽतप्यत दुर्घर्षं तात नित्यं वृषध्वजः।\nपावकेन परिक्षिप्तं दीप्यता यस्य चाश्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2086014, "chapter_id": 2830, "verse_number": "१२-३३५-२२", "content_sanskrit": "आदित्यपर्वतं नाम दुर्घर्षमकृतात्मभिः।\nन तत्र शक्यते गन्तुं यक्षराक्षसदानवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2086015, "chapter_id": 2830, "verse_number": "१२-३३५-२३", "content_sanskrit": "दशयोजनविस्तारमग्निज्वालसमावृतम्।\nभगवान्पावकस्तत्र स्वयं तिष्ठति वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2086016, "chapter_id": 2830, "verse_number": "१२-३३५-२४", "content_sanskrit": "सर्वान्विघ्नान्प्रशमयन्महादेवस्य धीमतः।\nदिव्यं वर्षसहस्रं हि पादेनैकेन तिष्ठतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2086017, "chapter_id": 2830, "verse_number": "१२-३३५-२५", "content_sanskrit": "देवान्संतापयंस्तत्र महादेवो महाव्रतः।\nऐन्द्रीं तु दिशमास्थाय शैलराजस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2086018, "chapter_id": 2830, "verse_number": "१२-३३५-२६", "content_sanskrit": "विविक्ते पर्वततटे पाराशर्यो महातपाः।\nवेदानध्यापयामास व्यासः शिष्यान्महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2086019, "chapter_id": 2830, "verse_number": "१२-३३५-२७", "content_sanskrit": "सुमन्तुं च महाभागं वैशम्पायनमेव च।\nजैमिनिं च महाप्राज्ञं पैलं चापि तपस्विनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2086020, "chapter_id": 2830, "verse_number": "१२-३३५-२८", "content_sanskrit": "एभिः शिष्यैः परिवृतो व्यास आस्ते महातपाः।\nतत्राश्रमपदं रम्यं ददर्श पितुरुत्तमम्।\nआरणेयो विशुद्धात्मा नभसीव दिवाकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2086021, "chapter_id": 2830, "verse_number": "१२-३३५-२९", "content_sanskrit": "अथ व्यासः परिक्षिप्तं ज्वलन्तमिव पावकम्।\nददृशे सुतमायान्तं दिवाकरसमप्रभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2086022, "chapter_id": 2830, "verse_number": "१२-३३५-३०", "content_sanskrit": "असज्जमानं वृक्षेषु शैलेषु विषयेषु च।\nयोगयुक्तं महात्मानं यथा बाणं गुणच्युतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2086023, "chapter_id": 2830, "verse_number": "१२-३३५-३१", "content_sanskrit": "सोऽभिगम्य पितुः पादावगृह्णादरणीसुतः।\nयथोपजोषं तैश्चापि समागच्छन्महामुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2086024, "chapter_id": 2830, "verse_number": "१२-३३५-३२", "content_sanskrit": "ततो निवेदयामास पित्रे सर्वमशेषतः।\nशुको जनकराजेन संवादं प्रीतमानसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2086025, "chapter_id": 2830, "verse_number": "१२-३३५-३३", "content_sanskrit": "एवमध्यापयञ्शिष्यान्व्यासः पुत्रं च वीर्यवान्।\nउवास हिमवत्पृष्ठे पाराशर्यो महामुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2086026, "chapter_id": 2830, "verse_number": "१२-३३५-३४", "content_sanskrit": "ततः कदाचिच्छिष्यास्तं परिवार्यावतस्थिरे।\nवेदाध्ययनसंपन्नाः शान्तात्मानो जितेन्द्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2086027, "chapter_id": 2830, "verse_number": "१२-३३५-३५", "content_sanskrit": "वेदेषु निष्ठां संप्राप्य साङ्गेष्वपि तपस्विनः।\nअथोचुस्ते तदा व्यासं शिष्याः प्राञ्जलयो गुरुम्॥\nशिष्या ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2086028, "chapter_id": 2830, "verse_number": "१२-३३५-३६", "content_sanskrit": "महता तेजसा युक्ता यशसा चापि वर्धिताः।\nएकं त्विदानीमिच्छामो गुरुणाऽनुग्रहं कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2086029, "chapter_id": 2830, "verse_number": "१२-३३५-३७", "content_sanskrit": "इति तेषां वचः श्रुत्वा ब्रह्मर्षिस्तानुवाद ह।\nउच्यतामिति तद्वत्सा यद्वः कार्यं प्रियं मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2086030, "chapter_id": 2830, "verse_number": "१२-३३५-३८", "content_sanskrit": "एतद्वाक्यं गुरोः श्रुत्वा शिष्यास्ते हृष्टमानसाः।\nपुनः प्राञ्जलयो भूत्वा प्रणम्य शिरसा गुरुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2086031, "chapter_id": 2830, "verse_number": "१२-३३५-३९", "content_sanskrit": "ऊचुस्ते सहिता राजन्निदं वचनमुत्तमम्।\nयदि प्रीत उपाध्यायो धन्याः स्मो मुनिसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2086032, "chapter_id": 2830, "verse_number": "१२-३३५-४०", "content_sanskrit": "काङ्क्षामस्तु वयं सर्वे वरं दत्तं महर्षिणा।\nपष्ठः शिष्यो न ते ख्यातिं गच्छेदत्र प्रसीद नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2086033, "chapter_id": 2830, "verse_number": "१२-३३५-४१", "content_sanskrit": "चत्वारस्ते वयं शिष्या गुरुपूत्रश्च पञ्चमः।\nइह वेदाः प्रतिष्ठेरन्नेष नः काङ्क्षितो वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2086034, "chapter_id": 2830, "verse_number": "१२-३३५-४२", "content_sanskrit": "शिष्याणां वचनं श्रुत्वा व्यासो वेदार्थतत्त्ववित्।\nपराशरात्मजो धीमान्परलोकार्थचिन्तकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2086035, "chapter_id": 2830, "verse_number": "१२-३३५-४३", "content_sanskrit": "उवाच शिष्यान्धर्मात्मा धर्म्यं नैःश्रेयसं वचः।\nब्राह्मणाय सदा देयं ब्रह्म शुश्रूषवे तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2086036, "chapter_id": 2830, "verse_number": "१२-३३५-४४", "content_sanskrit": "ब्रह्मलोके निवासं यो ध्रुवं समभिकाङ्क्षते।\nभवन्तो बहुलाः सन्तु वेदो विस्तार्यतामयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2086037, "chapter_id": 2830, "verse_number": "१२-३३५-४५", "content_sanskrit": "नाशिष्ये संप्रदातव्यो नाव्रते नाकृतात्मनि।\nएते शिष्यगुणाः सर्वे विज्ञातव्या यथार्थतः।\nनापरीक्षितचारित्रे विद्या देया कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2086038, "chapter_id": 2830, "verse_number": "१२-३३५-४६", "content_sanskrit": "यथा हि कनकं शुद्धं तापच्छेदनिकर्षणैः।\nपरीक्षेत तथा शिष्यानीक्षेत्कुलगुणादिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2086039, "chapter_id": 2830, "verse_number": "१२-३३५-४७", "content_sanskrit": "न नियोज्याश्च वः शिष्या अनियोगे महाभये।\nयथामति यथापाठं तथा विद्या फलिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2086040, "chapter_id": 2830, "verse_number": "१२-३३५-४८", "content_sanskrit": "सर्वस्तरतु दुर्गाणि सर्वो भद्राणि पश्यतु।\nश्रावयेच्चतुरो वर्णान्कृत्वा ब्राह्मणमग्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2086041, "chapter_id": 2830, "verse_number": "१२-३३५-४९", "content_sanskrit": "वेदस्याध्ययनं हीदं तच्च कार्यं महत्स्मृतम्।\nस्तुत्यर्थमिह देवानां वेदाः सृष्टाः स्वयंभुवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2086042, "chapter_id": 2830, "verse_number": "१२-३३५-५०", "content_sanskrit": "यो निर्वदेत संमोहाद्ब्राह्मणां वेदपारगम्।\nसोऽभिध्यानाद्ब्राह्मणस्य पराभूयादसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2086043, "chapter_id": 2830, "verse_number": "१२-३३५-५१", "content_sanskrit": "यश्चाधर्मेण विब्रूयाद्यश्चाधर्मेण पृच्छति।\nतयोरन्यतरः प्रैति विद्वेषं चाधिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2086044, "chapter_id": 2830, "verse_number": "१२-३३५-५२", "content_sanskrit": "एतद्वः सर्वमाख्यातं स्वाध्यायस्य विधिं प्रति।\nउपकुर्याच्च शिष्याणामेतच्च हृद्वि वो भवेत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2086045, "chapter_id": 2830, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि पञ्चत्रिंशदधिकत्रिशततमोऽध्यायः॥ ३३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]