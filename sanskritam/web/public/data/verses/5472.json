[{"id": 2209302, "chapter_id": 5472, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2209303, "chapter_id": 5472, "verse_number": "१", "content_sanskrit": "एतस्मिन्नेव काले तु वासुदेवः प्रतापवान् ।\nउपायाद् वृष्णिभिः सार्धं पुरं वारणसाह्वयम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2209304, "chapter_id": 5472, "verse_number": "२", "content_sanskrit": "समयं वाजिमेधस्य विदित्वा पुरुषर्षभ ।\nयथोक्तो धर्मपुत्रेण प्रव्रजन् स्वपुरीं प्रति ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2209305, "chapter_id": 5472, "verse_number": "३", "content_sanskrit": "रौग्मिणेयेन सहितो युयुधानेन चैव हि ।\nचारुदेष्णेन साम्बेन गदेन कृतवर्मणा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2209306, "chapter_id": 5472, "verse_number": "४", "content_sanskrit": "सारणेन च वीरेण निशठेनोन्मुखेन च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2209307, "chapter_id": 5472, "verse_number": "५", "content_sanskrit": "बलदेवं पुरस्कृत्य सुभद्रासहितस्तदा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2209308, "chapter_id": 5472, "verse_number": "६", "content_sanskrit": "द्रौपदीमुत्तरां चापि पृथां चाप्यवलोककः ।\nसमाश्वासयितुं चापि क्षत्रियान् निहतेश्वरान् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2209309, "chapter_id": 5472, "verse_number": "७", "content_sanskrit": "तानागतान् समीक्ष्यैव धृतराष्ट्रो महीपतिः ।\nप्रत्यगृह्णाद् यथान्यायं विदुरश्च महामनाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2209310, "chapter_id": 5472, "verse_number": "८", "content_sanskrit": "तत्रैव न्यवसत् कृष्णः सत्कृतः पुरुषर्षभः ।\nविदुरेण महातेजास्तथैव च युयुत्सुना ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2209311, "chapter_id": 5472, "verse_number": "९", "content_sanskrit": "वसत्सु वृष्णिवीरेषु तत्राथ जनमेजय ।\nजज्ञे तव पिता राजा परीक्षित् परवीरहा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2209312, "chapter_id": 5472, "verse_number": "१०", "content_sanskrit": "स तु जातो महाराज ब्रह्मास्त्रेण च पीडितः ।\nशवो बभूव निश्चेष्टो हर्षशोकविवर्धनः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2209313, "chapter_id": 5472, "verse_number": "११", "content_sanskrit": "हृष्टानां सिंहनादेन जनानां तत्र निःस्वनः ।\nआविवेश दिशः सर्वा पुनरेवाप्युपारमत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2209314, "chapter_id": 5472, "verse_number": "१२", "content_sanskrit": "ततः सोऽभित्वरन् कृष्णो विवेशान्तःपुरं तदा ।\nयुयुधानद्वितीयो वै व्यथितेन्द्रियमानसः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2209315, "chapter_id": 5472, "verse_number": "१३", "content_sanskrit": "ततस्त्वरितमायान्तीं ददर्श स्वां पितृष्वसाम् ।\nक्रोशन्तीमभिधावन्तीं वासुदेवं पुनः पुनः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2209316, "chapter_id": 5472, "verse_number": "१४", "content_sanskrit": "पृष्ठतो द्रौपदीं चैव सुभद्रां च यशस्विनीम् ।\nविक्रोशन्त्यश्च करुणं पाण्डवानां स्त्रियो नृप ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2209317, "chapter_id": 5472, "verse_number": "१५", "content_sanskrit": "ततः कृष्णं समासाद्य कुन्ती राजसुता तदा ।\nप्रोवाच राजशार्दूल बाष्पगद्गदया गिरा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2209318, "chapter_id": 5472, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2209319, "chapter_id": 5472, "verse_number": "१६", "content_sanskrit": "वासुदेव महाबाहो सुप्रजा देवकी त्वया ।\nत्वं नो गतिः प्रतिष्ठा च त्वदायत्तमिदं कुलम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2209320, "chapter_id": 5472, "verse_number": "१७", "content_sanskrit": "यदुप्रवीर योऽयं ते स्वस्रीयस्यात्मजः प्रभो ।\nअश्वत्थाम्ना हतो जातस्तमुज्जीवय केशव ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2209321, "chapter_id": 5472, "verse_number": "१८", "content_sanskrit": "त्वया ह्येतत् प्रतिज्ञातमैषीके यदुनन्दन ।\nअहं सञ्जीवयिष्यामि मृतं जातमिति प्रभो ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2209322, "chapter_id": 5472, "verse_number": "१९", "content_sanskrit": "सोऽयं जातो मृतस्तात पश्यैनं पुरुषर्षभ ।\nउत्तरां च सुभद्रां च द्रौपदीं मां च माधव ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2209323, "chapter_id": 5472, "verse_number": "२०", "content_sanskrit": "धर्मपुत्रं च भीमं च फल्गुनं नकुलं तथा ।\nसहदेवं च दुर्धर्षं सर्वांश्च भरतानपि ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2209324, "chapter_id": 5472, "verse_number": "२१", "content_sanskrit": "तस्मिन् प्राणाः समायत्ताः पाण्डवानां ममैव च ।\nपाण्डोश्च पिण्डो दाशार्ह तथैव श्वशुरस्य मे ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2209325, "chapter_id": 5472, "verse_number": "२२", "content_sanskrit": "अभिमन्योश्च भद्रं ते प्रियस्य सदृशस्य ते ।\nप्रियमुत्पादयाद्य त्वं प्रेतस्यापि जनार्दन ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2209326, "chapter_id": 5472, "verse_number": "२३", "content_sanskrit": "उत्तरा हि पुरोक्तं वै कथयत्यरिसूदन ।\nअभिमन्योर्वचः कृष्ण प्रियं तत् ते न संशयः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2209327, "chapter_id": 5472, "verse_number": "२४", "content_sanskrit": "अब्रवीत् किल दाशार्ह वैराटीमार्जुनिस्तदा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2209328, "chapter_id": 5472, "verse_number": "", "content_sanskrit": "अभिमन्युः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2209329, "chapter_id": 5472, "verse_number": "२५", "content_sanskrit": "मातुलस्य कुलं भद्रे तव पुत्रो गमिष्यति ।\nगत्वा वृष्ण्यन्धककुलं धनुर्वेदं ग्रहीष्यति ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2209330, "chapter_id": 5472, "verse_number": "२६", "content_sanskrit": "अस्त्राणि च विचित्राणि नीतिशास्त्रं च केवलम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2209331, "chapter_id": 5472, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2209332, "chapter_id": 5472, "verse_number": "२७", "content_sanskrit": "इत्येतत् प्रणयात् तात सौभद्रः परवीरहा ।\nकथयामास दुर्धर्षस्तथैवैतन्न संशयः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2209333, "chapter_id": 5472, "verse_number": "२८", "content_sanskrit": "तास्त्वां वयं प्रणम्येह चायामो मधुसूदन ।\nकुलस्यास्य हितार्थं त्वं कुरु कल्याणमुत्तमम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2209334, "chapter_id": 5472, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2209335, "chapter_id": 5472, "verse_number": "२९", "content_sanskrit": "एवमुक्त्वा तु वार्ष्णेयं पृथा पृथुललोचना ।\nउद्धृत्य बाहू दुःखार्ता प्रापतद् भुवि विह्वला ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2209336, "chapter_id": 5472, "verse_number": "३०", "content_sanskrit": "अब्रुवंश्च महाराज सर्वाः सस्राविलेक्षणाः ।\nस्वस्रीयो वासुदेवस्य मृतो जात इति प्रभो ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2209337, "chapter_id": 5472, "verse_number": "३१", "content_sanskrit": "एवं गते ततः कुन्तीं पर्यगृह्णाज्जनार्दनः ।\nभूमौ निपतितां चैनां सान्त्वयामास भारत ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2209338, "chapter_id": 5472, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि परीक्षिज्जननप्रकारकथनं नाम षट्षष्टितमोऽध्यायः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]