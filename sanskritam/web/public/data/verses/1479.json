[{"id": 2022665, "chapter_id": 1479, "verse_number": "३-११७-०x", "content_sanskrit": "अकृतव्रण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2022666, "chapter_id": 1479, "verse_number": "३-११७-१", "content_sanskrit": "स वेदाध्ययने युक्तो जमदग्निर्महातपाः।\nतपस्तेपे ततो देवान्नियमाद्वशमानयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2022667, "chapter_id": 1479, "verse_number": "३-११७-२", "content_sanskrit": "स प्रसेनजितं राजन्नधिगम्य नराधिपम्।\nरेणुकां वरयामास स च तस्मै ददौ नृपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2022668, "chapter_id": 1479, "verse_number": "३-११७-३", "content_sanskrit": "रेणुकां त्वथ संप्राप्य भार्यां भार्गवनन्दनः।\nआश्रमस्थस्तया सार्धं तपस्तेपेऽनुकूलया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2022669, "chapter_id": 1479, "verse_number": "३-११७-४", "content_sanskrit": "तस्याः कुमाराश्चत्वारो जज्ञिरे रामपञ्चमाः।\nसर्वेषामजघन्यस्तु राम आसीञ्जघन्यजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2022670, "chapter_id": 1479, "verse_number": "३-११७-५", "content_sanskrit": "फलाहारेषु सर्वेषु गतेष्वथ सुतेषु वै।\nरेणुका स्नातुमगमत्कदाचिन्नियतव्रता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2022671, "chapter_id": 1479, "verse_number": "३-११७-६", "content_sanskrit": "सा तु चित्ररथं नाम मार्तिकावतकं नृपम्।\nददर्श रेणुका राजन्नागच्छन्ती यदृच्छया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2022672, "chapter_id": 1479, "verse_number": "३-११७-७", "content_sanskrit": "क्रीडन्तं सलिले दृष्ट्वा सभार्यं पद्ममालिनम्।\nऋद्धिमन्तं ततस्तस्य स्पृहयामास रेणुका ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2022673, "chapter_id": 1479, "verse_number": "३-११७-८", "content_sanskrit": "व्यभिचाराच्च तस्मात्सा क्लिन्नाम्भसि विचेतना।\n`अन्तरिक्षान्निपतिता नर्मदायां महाह्रदे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2022674, "chapter_id": 1479, "verse_number": "३-११७-९", "content_sanskrit": "उतीर्य चापि सा यत्नाज्जगाम भरतर्षभ।\nप्रविवेशाश्रमं त्रस्ता तां वै भर्तान्वबुध्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2022675, "chapter_id": 1479, "verse_number": "३-११७-१०", "content_sanskrit": "स तां दृष्ट्वाच्युतांधैर्याद्ब्राह्म्या लक्ष्म्या विवर्जिताम्।\nश्रिक्शब्देन महातेजा गर्हयामास वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2022676, "chapter_id": 1479, "verse_number": "३-११७-११", "content_sanskrit": "ततो ज्येष्ठो जामदग्न्यो रुमण्वान्नाम नामतः।\nआजगाम सुषेणश्च वसुर्विश्वावसुस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2022677, "chapter_id": 1479, "verse_number": "३-११७-१२", "content_sanskrit": "तानानुपूर्व्याद्भगवान्वधे मातुरचोदयत्।\nन च ते जातसंमोहाः किंचिदूचुर्विचेतसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2022678, "chapter_id": 1479, "verse_number": "३-११७-१३", "content_sanskrit": "ततः शशाप तान्क्रोधात्ते शप्ताश्चैतनां जहुः।\nमृगपक्षिसधर्माणः क्षिप्रमासञ्जडोपमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2022679, "chapter_id": 1479, "verse_number": "३-११७-१४", "content_sanskrit": "ततो रामोऽभ्ययात्पश्चादाश्रमं परवीरहा।\nतमुवाच महामन्युर्जमदग्निर्महातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2022680, "chapter_id": 1479, "verse_number": "३-११७-१५", "content_sanskrit": "जहीमां मातरं पापां मा च पुत्र व्यथां कृथाः।\nतत आदाय परशुं रामो मातु शिरोऽहरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2022681, "chapter_id": 1479, "verse_number": "३-११७-१६", "content_sanskrit": "ततस्तस्य महाराज जमदग्नेर्महात्मनः।\nकोपोऽभ्यगच्छत्सहसा प्रसन्नश्चाब्रवीदिदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2022682, "chapter_id": 1479, "verse_number": "३-११७-१७", "content_sanskrit": "ममेदं वचनात्तात कृतं ते कर्म दुष्करम्।\nवृणीष्व कामान्धर्मज्ञ यावतो वाञ्छसे हृदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2022683, "chapter_id": 1479, "verse_number": "३-११७-१८", "content_sanskrit": "स वव्रे मातुरुत्थानमस्मृतिं च वधस्य वै।\nपापेन तेन चास्पर्शं भ्रातॄणां प्रकृतिं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2022684, "chapter_id": 1479, "verse_number": "३-११७-१९", "content_sanskrit": "अप्रतिद्वन्द्वतां युद्धे दीर्घमायुश्च भारत।\nददौ च सर्वान्कामांस्ताञ्जमदग्निर्महातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2022685, "chapter_id": 1479, "verse_number": "३-११७-२०", "content_sanskrit": "कदाचित्तु तथैवास्य विनिष्क्रान्ताः सुताः प्रभो।\nअथानूपपतिर्वीरः कार्तवीर्योऽभ्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2022686, "chapter_id": 1479, "verse_number": "३-११७-२१", "content_sanskrit": "तमाश्रमपदं प्राप्तमृषिरर्ध्यात्समार्चयत्।\nस युद्धमदसंमत्तो नाभ्यनन्दत्तथाऽर्चनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2022687, "chapter_id": 1479, "verse_number": "३-११७-२२", "content_sanskrit": "प्रमथ्य चाश्रमात्तस्माद्धोमधेनोस्ततोबलात्।\nजहार वत्सं क्रोशन्त्या बभञ्ज च महाद्रुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2022688, "chapter_id": 1479, "verse_number": "३-११७-२३", "content_sanskrit": "आगताय च रामाय तदाचष्ट पिता स्वयम्।\nगां च रोरुदतीं दृष्ट्वा कोपो रामं समाविशत्।\nस मन्युवशमापन्नः कार्तवीर्यमुपाद्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2022689, "chapter_id": 1479, "verse_number": "३-११७-२४", "content_sanskrit": "तस्याथ युधि विक्रम्य भार्गवः परवीरहा।\nचिच्छेद निशितैर्भल्लैर्बाहून्परिघसंनिभान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2022690, "chapter_id": 1479, "verse_number": "३-११७-२५", "content_sanskrit": "सहस्रसंमितान्राजन्प्रगृह्य रुचिरं धनुः।\nअभिभूतः स रामेण संयुक्तः कालधर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2022691, "chapter_id": 1479, "verse_number": "३-११७-२६", "content_sanskrit": "अर्जुनस्याथ दायादा रामेण कृतमन्यवः।\nआश्रमस्थं विना रामं जमदग्निमुपाद्रवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2022692, "chapter_id": 1479, "verse_number": "३-११७-२७", "content_sanskrit": "ते तं जघ्नुर्महावीर्यमयुध्यन्तं तपस्विनम्।\nअसकृद्रामरामेति विक्रोशन्तमनाथवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2022693, "chapter_id": 1479, "verse_number": "३-११७-२८", "content_sanskrit": "कार्तवीर्यस्य पुत्रास्तु जमदग्निं युधिष्ठिर।\nघातयित्वा शरैर्जग्मुर्यथागतमरिंदमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2022694, "chapter_id": 1479, "verse_number": "३-११७-२९", "content_sanskrit": "अपक्रान्तेषु वै तेषु जमदग्नौ तथा गते।\nसमित्पाणिरुपागच्छदाश्रमं भृगुनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2022695, "chapter_id": 1479, "verse_number": "३-११७-३०", "content_sanskrit": "स दृष्ट्वा पितरं वीरस्तदा मृत्युवशं गतम्।\nअनर्हं तं तथाभूतं विललाप सुदुःखितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2022696, "chapter_id": 1479, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि सप्तदशाधिकशततमोऽध्यायः ॥ ११७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]