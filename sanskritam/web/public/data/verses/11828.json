[{"id": 50024106, "chapter_id": 11828, "verse_number": "1", "content_sanskrit": "समस्तदेवजनकवासुदेवपरामृत। वासुदेव परामृत ज्ञानमूर्ते नमोऽस्तु ते॥ ७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024107, "chapter_id": 11828, "verse_number": "2", "content_sanskrit": "देवादे देवलोकप पूर्णानन्दमहोदधे। सर्वज्ञेश रमानाथ देवाऽदेऽदेऽव लोकप॥ ७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}]