[{"id": 2030108, "chapter_id": 1658, "verse_number": "३-२९६-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2030109, "chapter_id": 1658, "verse_number": "३-२९६-१", "content_sanskrit": "अथ कन्याप्रदाने स तमेवार्थं विचिन्तयन्।\nसमानित्ये च तत्सर्वंभाण्डं वैवाहिकं नृपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2030110, "chapter_id": 1658, "verse_number": "३-२९६-२", "content_sanskrit": "ततो वृद्धान्द्विजान्सर्वानृत्विक्सभ्यपुरोहितान्।\nसमाहूय दिने पुण्ये प्रययौ सह कन्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2030111, "chapter_id": 1658, "verse_number": "३-२९६-३", "content_sanskrit": "मेध्यारण्यं स गत्वा च द्युमत्सेनाश्रमं नृपः।\nपद्भ्यामेव द्विजैः सार्धं राजर्षिं तमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2030112, "chapter_id": 1658, "verse_number": "३-२९६-४", "content_sanskrit": "तत्रापश्यन्महाभागं सालवृक्षमुपाश्रितम्।\nकौश्यां बृस्यां समासीनं चक्षुर्हीनं नृपं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2030113, "chapter_id": 1658, "verse_number": "३-२९६-५", "content_sanskrit": "स राजा तस्य राजर्षेः कृत्वापूजां यथाऽर्हतः।\nवाचा सुनियतो भूत्वा चकारात्मनिवेदनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2030114, "chapter_id": 1658, "verse_number": "३-२९६-६", "content_sanskrit": "तस्यार्ध्यमासं चैव गां चावेद्यस धर्मवित्।\nकिमागमनमित्येवं राजा राजानमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2030115, "chapter_id": 1658, "verse_number": "३-२९६-७", "content_sanskrit": "तस्य सर्वमभिप्रायमितिकर्तव्यतां च ताम्।\nसत्यवन्तं समुद्दिश्य सर्वमेव न्यवेदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2030116, "chapter_id": 1658, "verse_number": "३-२९६-८", "content_sanskrit": "सावित्री नाम राजर्षे कन्येयं मम शोभना।\nतां स्वधर्मेण धर्मज्ञ स्नुषार्थे त्वं गृहाण मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2030117, "chapter_id": 1658, "verse_number": "३-२९६-८x", "content_sanskrit": "द्युमत्सेन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2030118, "chapter_id": 1658, "verse_number": "३-२९६-९", "content_sanskrit": "च्युताः स्म राज्याद्वनवासमाश्रिता-\nश्चराम धर्मं नियतास्तपस्विनः।\nकथं त्वनर्हा वनवासमाश्रमे\nसहिष्यति क्लेशमिमं सुता तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2030119, "chapter_id": 1658, "verse_number": "३-२९६-१०x", "content_sanskrit": "अश्वमतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2030120, "chapter_id": 1658, "verse_number": "३-२९६-१०", "content_sanskrit": "सुखं च दुःखं च भवाभवात्मकं\nयदा विजानाति सुताऽहमेव च।\nन मद्विधे युज्यतेवाक्यमीदृशं\nविनिश्चयेनाभिगतोस्मि ते नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2030121, "chapter_id": 1658, "verse_number": "३-२९६-११", "content_sanskrit": "आशां नार्हसि मे हन्तुं सौहृदात्प्रणतस्य च।\nअभितश्चागतं प्रेम्णा प्रत्याख्यातुं न माऽर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2030122, "chapter_id": 1658, "verse_number": "३-२९६-१२", "content_sanskrit": "अनुरूपो हि युक्तश्च त्वं ममाहं तवापि च।\nस्नुषां प्रतीच्छ मे कन्यां भार्यां सत्यवतस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2030123, "chapter_id": 1658, "verse_number": "३-२९६-१३x", "content_sanskrit": "द्युमत्सेन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2030124, "chapter_id": 1658, "verse_number": "३-२९६-१३", "content_sanskrit": "पूर्वमेवाभिलवितः संबन्धो मे त्वया सह।\nभ्रष्टराज्यस्त्वहमिति तत एतद्विचारितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2030125, "chapter_id": 1658, "verse_number": "३-२९६-१४", "content_sanskrit": "अभिप्रायस्त्वयं यो मे पूर्वमेवाभिकाङ्क्षितः।\nस निर्वर्ततु मेऽद्यैव काङ्क्षितो ह्यसि मेऽतिथिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2030126, "chapter_id": 1658, "verse_number": "३-२९६-१५", "content_sanskrit": "ततः सर्वान्समानाय्य द्विजानाश्रमवासिनः।\nयथाविधि समुद्वाहं कारयामासतुर्नृपौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2030127, "chapter_id": 1658, "verse_number": "३-२९६-१६", "content_sanskrit": "दत्त्वा सोऽश्वपतिः कन्यां यथार्हं सपरिच्छदम्।\nययौ स्वमेव भवनं युक्तः परमया मुदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2030128, "chapter_id": 1658, "verse_number": "३-२९६-१७", "content_sanskrit": "सत्यवानपि तां भार्यां लब्ध्वा सर्वगुणान्विताम्।\nमुमुदे सा रच रतं लब्ध्वा भर्तारं मनसेप्सितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2030129, "chapter_id": 1658, "verse_number": "३-२९६-१८", "content_sanskrit": "गते पितरि सर्वाणि संन्यस्याभरणानि सा।\nजगृहेवल्कलान्येव वस्त्रं काषायमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2030130, "chapter_id": 1658, "verse_number": "३-२९६-१९", "content_sanskrit": "परिचारैर्गुणैश्चैव प्रश्रयेण दमेन च।\nसर्वकामक्रियाभिश्च सर्वेषां तुष्टिमादधे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2030131, "chapter_id": 1658, "verse_number": "३-२९६-२०", "content_sanskrit": "श्वश्रूं शरीरसत्कारैः सर्वैराच्छादनादिभिः।\nश्वशुरं देवसत्कारैर्वाचः संयमनेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2030132, "chapter_id": 1658, "verse_number": "३-२९६-२१", "content_sanskrit": "तथैव प्रियवादेन नैषुणेन शमेन च।\nरहश्चैवोपचारेण भर्तारं पर्यतोषयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2030133, "chapter_id": 1658, "verse_number": "३-२९६-२२", "content_sanskrit": "एवं तत्राश्रमे तेषां तदा निवसतां सताम्।\nकालस्तपस्यतां कश्चिदपाक्रामत भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2030134, "chapter_id": 1658, "verse_number": "३-२९६-२३", "content_sanskrit": "सावित्र्याग्लायमानायास्तिष्ठन्त्यास्तु दिवानिशम।\nनारदेन यदुक्तं तद्वाक्यं मनसि वर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2030135, "chapter_id": 1658, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि पतिव्रतामाहात्म्यपर्वणि षण्णवत्यधिकद्विशततमोऽध्यायः ॥ २९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]