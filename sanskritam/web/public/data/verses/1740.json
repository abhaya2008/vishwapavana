[{"id": 2034318, "chapter_id": 1740, "verse_number": "४-६३-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2034319, "chapter_id": 1740, "verse_number": "४-६३-१", "content_sanskrit": "ततो भीष्मः शरानष्टौ ध्वजे पार्थस्य वीर्यवान्।\nसमार्पयन्महावेगाज्ज्वलतः पन्नगानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2034320, "chapter_id": 1740, "verse_number": "४-६३-२", "content_sanskrit": "ते ध्वजं पाण्डुपुत्रस्य समासाद्य पतत्रिणः।\nध्वजस्थं कपिमाजघ्नुः ध्वजाग्रनिलयांश्च तान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2034321, "chapter_id": 1740, "verse_number": "४-६३-३", "content_sanskrit": "सारथिं च हयांश्चास्य विव्याध दशभिः शरैः ।\nउरस्यताडयत्पार्थं त्रिभिरेवायसैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2034322, "chapter_id": 1740, "verse_number": "४-६३-४", "content_sanskrit": "ततोऽर्जुनः शरैस्तीक्ष्णैर्विद्ध्वा कुरुपितामहम्।\nध्वजं च सारथिं चापि विव्याध दशभिः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2034323, "chapter_id": 1740, "verse_number": "४-६३-५", "content_sanskrit": "तद्युद्धमभवद्धोरं रोमहर्षणमद्भुतम्।\nभीष्मस्य सह पार्थेन बलिवासवयोरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2034324, "chapter_id": 1740, "verse_number": "४-६३-६", "content_sanskrit": "सन्ततं शरजालाभिराकाशं समपद्यत।\nअम्बुदैरिव धाराभिस्तयोः कार्मुकनिःसृतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2034325, "chapter_id": 1740, "verse_number": "४-६३-७", "content_sanskrit": "भल्लैर्भल्लाः समाहत्य कुरुपाण्डवयो रणे।\nअन्तरिक्षे व्यराजन्त खद्योताः प्रावृषीव हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2034326, "chapter_id": 1740, "verse_number": "४-६३-८", "content_sanskrit": "अग्निवक्रोपमं घोरं मण्डलीकृतमाहवे ।\nगाण्डीवमभवञ्जिष्णोः सव्यं दक्षिणमस्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2034327, "chapter_id": 1740, "verse_number": "४-६३-९", "content_sanskrit": "पर्वतं वारिधाराभिश्छादयन्निव तोयदः ।\nअर्जुनश्छादयद्भीष्मं शरवर्षैरनेकशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2034328, "chapter_id": 1740, "verse_number": "४-६३-१०", "content_sanskrit": "तां समुद्रमिवोद्धूतां शरवृष्टिं समुद्यताम् ।\nव्यधमत्सायकैर्भीष्मः सोर्जुनं च न्यवारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2034329, "chapter_id": 1740, "verse_number": "४-६३-११", "content_sanskrit": "ततस्तानि विसृष्टानि शरजालानि सङ्घशः।\nआहतानि व्यशीर्यन्तं अर्जुनस्य रथं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2034330, "chapter_id": 1740, "verse_number": "४-६३-१२", "content_sanskrit": "ततः कनकपुङ्खाग्रैः शितैः संनतपर्वभिः ।\nपतद्भिः खगवाजैश्च द्यौरासीत्संवृता शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2034331, "chapter_id": 1740, "verse_number": "४-६३-१३", "content_sanskrit": "ततः प्रासृजदुग्राणि शरजालानि पाण्डवः।\nतावन्ति शरजालानि भीष्मः पार्थाय प्राहिणोत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2034332, "chapter_id": 1740, "verse_number": "४-६३-१४", "content_sanskrit": "साश्वं ससूतं सरथं स पार्थं समाचिनोद्भारतो वत्सदन्तैः ।\nप्रच्छादयामास दिशश्च सर्वा नभश्च बाणैस्तपनीयपुङ्खैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2034333, "chapter_id": 1740, "verse_number": "४-६३-१५", "content_sanskrit": "ततो देवर्षिगन्धर्वाः साधुसाध्वित्यपूजयन्।\nदुष्करं कृतवान्भीष्मो यदर्जुनमवारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2034334, "chapter_id": 1740, "verse_number": "४-६३-१६", "content_sanskrit": "बलवानर्जुनो दक्षः क्षिप्रकारी च पाण्डवः।\nकोऽन्यः समर्थः पार्थस्य वेगं धारयितुं रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2034335, "chapter_id": 1740, "verse_number": "४-६३-१७", "content_sanskrit": "ऋते शान्तनवाद्भीष्मात्कृष्णाद्वा देवकीसुतात् ।\nआचार्यवरमुख्याद्वा भारद्वाजान्महाबलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2034336, "chapter_id": 1740, "verse_number": "४-६३-१८", "content_sanskrit": "अस्त्रैरस्त्राणि संवार्य क्रीडतः पुरुषोत्तमौ ।\nचक्षूंषि सर्वभूतानां मोदयन्तौ महाबलौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2034337, "chapter_id": 1740, "verse_number": "४-६३-१९", "content_sanskrit": "प्राजापत्यं तथैवैन्द्रमाग्नेयं च सुदारुणम् ।\nकौबेरं वारुणं चैव याम्यं वायव्यमेव च ।\nप्रयुञ्जानौ महात्मानौ समरे तौ विरेजतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2034338, "chapter_id": 1740, "verse_number": "४-६३-२०", "content_sanskrit": "विस्मितान्यथ भूतानि तौ दृष्ट्वा संयुगे तदा।\nसाधु पार्थ महाबाहो साधु भीष्मेति चाब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2034339, "chapter_id": 1740, "verse_number": "४-६३-२१", "content_sanskrit": "नैतदन्यो मनुष्येषु प्रदर्शयितुमाहवे।\nमहास्राणां संप्रयोगं समरे भीष्मपार्थयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2034340, "chapter_id": 1740, "verse_number": "४-६३-२२", "content_sanskrit": "एवं सर्वास्त्रविदुषोरस्त्रयुद्धमवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2034341, "chapter_id": 1740, "verse_number": "४-६३-२३", "content_sanskrit": "अथ जिष्णुरुदावृत्य शितधारेण कार्मुकम् ।\nन्यकृन्तद्गृध्रपत्रेण शातकुम्भपरिष्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2034342, "chapter_id": 1740, "verse_number": "४-६३-२४", "content_sanskrit": "निमेषान्तरमात्रेण भीष्मोऽन्यत्कार्मुकं रणे।\nसमादाय नरव्याघ्रः सज्यं चक्रे महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2034343, "chapter_id": 1740, "verse_number": "४-६३-२५", "content_sanskrit": "शरांश्च सुबहुन्क्रुद्धो मुमोचाशु धनंजये ।\nअर्जुनोपि शरांस्तीक्ष्णान्भीष्माय निशितान्बहून्।\nचिक्षेप च महातेजास्तथा भीष्मश्च पाण्डवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2034344, "chapter_id": 1740, "verse_number": "४-६३-२६", "content_sanskrit": "तयोर्दिव्यास्त्रविदुषोरस्यतोरनिशं शरान् ।\nन विशेषस्तदा राजन्दृश्यते सुमहात्मनोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2034345, "chapter_id": 1740, "verse_number": "४-६३-२७", "content_sanskrit": "अथावृणोद्दश दिशः शरैरतिरथस्तदा ।\nकिरीटमाली कौन्तेयः शूरं शान्तनवं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2034346, "chapter_id": 1740, "verse_number": "४-६३-२८", "content_sanskrit": "अतीव पाण्डवो भीष्मं भीष्मश्चातीव पाण्डवम् ।\nबभूव तत्र सङ्घेऽस्मिन्लोके राजंस्तदद्भुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2034347, "chapter_id": 1740, "verse_number": "४-६३-२९", "content_sanskrit": "पाण्डवेन हताः शूरा भीष्मस्य रथरक्षिणः।\nशेरते स्म महाबाहो कौन्तेयस्याभितो रथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2034348, "chapter_id": 1740, "verse_number": "४-६३-३०", "content_sanskrit": "ततो गाण्डीवनिर्मुक्ता निरमित्रं चिकीर्षवः।\nअसक्ताः पुङ्खसंसक्ताः श्वेतवाहनपत्रिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2034349, "chapter_id": 1740, "verse_number": "४-६३-३१", "content_sanskrit": "निष्पतन्तो रथात्तस्य धौता हैरण्यवाससः।\nआकाशे प्रत्यदृश्यन्त हंसानामिव पङ्क्तयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2034350, "chapter_id": 1740, "verse_number": "४-६३-३२", "content_sanskrit": "तस्य तद्दिव्यमस्त्रं हि प्रगाढं चित्रमस्यतः ।\nप्रेक्षन्ते स्मान्तरिक्षस्थाः सर्वे देवाः सवासवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2034351, "chapter_id": 1740, "verse_number": "४-६३-३३", "content_sanskrit": "तं दृष्ट्वा परमप्रीतो गन्धर्वश्चित्रमद्भुतम् ।\nशशंस देवराजाय चित्रसेनः प्रतापवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2034352, "chapter_id": 1740, "verse_number": "४-६३-३४", "content_sanskrit": "पश्येमानरिनिर्दारान्संसक्तानिव गच्छतः ।\nचित्ररूपमिदं जिष्णोर्दिव्यमस्त्रमुदीर्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2034353, "chapter_id": 1740, "verse_number": "४-६३-३५", "content_sanskrit": "नेदं मनुष्याः श्रद्दध्युर्न हीदं तेषु विद्यते।\nसौराणां च महास्राणां विचित्रोऽयं समागमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2034354, "chapter_id": 1740, "verse_number": "४-६३-३६", "content_sanskrit": "मध्यन्दिनगतं सूर्यं प्रतपन्तमिवाम्बरे ।\nन शक्नुवन्ति सैन्यानि पाण्डवं प्रसमीक्षितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2034355, "chapter_id": 1740, "verse_number": "४-६३-३७", "content_sanskrit": "उभौ विश्रुतकर्माणावुभौ शूरौ महीक्षिताम् ।\nउभौ विचित्रकर्माणावुभौ युधि दुरासदौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2034356, "chapter_id": 1740, "verse_number": "४-६३-३८", "content_sanskrit": "इत्युक्तो देवराजस्तु पार्थभीष्मसमागमम्।\nपूजयामास दिव्येन पुष्पवर्षेण भारत ॥ ४-६३-३९a[अश्वत्थामा ततोऽभ्येत्य द्रुतं कर्णमभाषत ।\nअहमेको हनिष्यामि समेतान्सर्वपाण्डवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2034357, "chapter_id": 1740, "verse_number": "४-६३-४०", "content_sanskrit": "इति कर्म समक्षं मे सभामध्ये त्वयोदितम् ।\nन तु तत्कृतमेकस्माद्भीतो धावसि सूतज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2034358, "chapter_id": 1740, "verse_number": "४-६३-४१", "content_sanskrit": "वैचित्रवीर्यजाः सर्वे त्वामाश्रित्य पृथासुतान् ।\nजेतुमिच्छन्ति संग्रामे भवान्युध्यस्व फल्गुनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2034359, "chapter_id": 1740, "verse_number": "४-६३-४२", "content_sanskrit": "अश्वत्थामोदितं वाक्यं श्रुत्वा दुर्योधनस्तदा ।\nप्रत्युवाच रुषा द्रौणिं कर्णप्रियचिकीर्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2034360, "chapter_id": 1740, "verse_number": "४-६३-४३", "content_sanskrit": "मा मानभङ्गं विप्रेन्द्र कुरु विश्रुतकर्मणः ।\nमानभङ्गेन राज्ञां तु बलहानिर्भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2034361, "chapter_id": 1740, "verse_number": "४-६३-४४", "content_sanskrit": "शूरा वदन्ति संग्रामे वाचा कर्माणि कुर्वते।\nपराक्रमन्ति संग्रामे स्वस्य वीर्यानुसारतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2034362, "chapter_id": 1740, "verse_number": "४-६३-४५", "content_sanskrit": "तस्मात्तं नार्हति भवान्गर्हितुं शूरसंमतम् ।\nराज्ञैवमुक्तः स द्रौणिर्गतरोषोऽभवत्तदा ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2034363, "chapter_id": 1740, "verse_number": "४-६३-४६", "content_sanskrit": "ततो भीष्मः शान्तनवो बाणान्पार्श्वे समार्पयत्।\nअस्यतः प्रतिसन्धाय विवृतं सव्यसाचिनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2034364, "chapter_id": 1740, "verse_number": "४-६३-४७", "content_sanskrit": "ततः प्रसह्य बीभत्सुः पृथुधारेण कार्मुकम्।\nन्यकृन्तद्गृध्रपत्रेण भीष्मस्यामिततेजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2034365, "chapter_id": 1740, "verse_number": "४-६३-४८", "content_sanskrit": "अथैनं दशभिः पश्चात्प्रत्यविध्यत्स्तनान्तरे।\nयतमानं पराक्रान्तं कुन्तीपुत्रो धनञ्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2034366, "chapter_id": 1740, "verse_number": "४-६३-४९", "content_sanskrit": "स पीडितो महाबाहुर्गृहीत्वा रथकूबरम् ।\nगोङ्गेयो युधि दुर्धर्षस्तस्थौ दीप इवातुरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2034367, "chapter_id": 1740, "verse_number": "४-६३-५०", "content_sanskrit": "तं विसंज्ञमपोवाह संयन्ता रथवाजिनाम् ।\nउपदेशमनुस्मृत्य रक्षमाणो महारथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2034368, "chapter_id": 1740, "verse_number": "४-६३-५१", "content_sanskrit": "पराक्रमे च शौर्ये च वीर्ये सत्त्वे बले रणे।\nशस्त्रास्त्रेषु च सर्वेषु लाघवे दूरपातने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2034369, "chapter_id": 1740, "verse_number": "४-६३-५२", "content_sanskrit": "यस्य नास्ति समो लोके पितृदत्तवरश्च यः।\nजितश्रमो जितारातिर्निस्तन्द्रिः खेदवर्जितः ।\nयः स्वेच्छामरणः शूरः पितृशुश्रूषणे रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2034370, "chapter_id": 1740, "verse_number": "४-६३-५३", "content_sanskrit": "दुर्योधनहितार्थाय युद्ध्वा पार्थेन संगरे।\nपृथासुतहितार्थाय पराजित इवाभवत् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2034371, "chapter_id": 1740, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि गोग्रहणपर्वणि त्रिषष्टितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]