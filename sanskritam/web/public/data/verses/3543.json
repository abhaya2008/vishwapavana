[{"id": 2118106, "chapter_id": 3543, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2118107, "chapter_id": 3543, "verse_number": "१", "content_sanskrit": "स तथेति प्रतिज्ञाय यतिना सहितो हरिः ।\nकृत्वा तु संविदं तेन प्रहृष्टः केशवोऽभवत् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2118108, "chapter_id": 3543, "verse_number": "२", "content_sanskrit": "पर्वते तौ विहृत्यैव यथेष्टं कृष्णपाण्डवौ ।\nतां पुरीं प्रविवेशाथ गृह्य हस्ते च पाण्डवम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2118109, "chapter_id": 3543, "verse_number": "३", "content_sanskrit": "प्रविश्य च गृहं रम्यं सर्वभोगसमन्वितम् ।\nपार्थमावेदयामास रुग्मिणीसत्यभामयोः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2118110, "chapter_id": 3543, "verse_number": "४", "content_sanskrit": "हृषीकेशवचः श्रुत्वा ते उभे चोचतुर्भृशम् ।\nमनोरथो महानेष हृदि नः परिवर्तते \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2118111, "chapter_id": 3543, "verse_number": "५", "content_sanskrit": "कदा द्रक्ष्याम बीभत्सुं पाण्डवं गृहमागतम् ।\nइति चिन्तयमानानां पार्थो दुःखमपानुदत् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2118112, "chapter_id": 3543, "verse_number": "६", "content_sanskrit": "प्राप्तमज्ञातपूजाभिरुत्तमाभिरपूजयन् ।\nस तं प्रियातिथिं श्रेष्ठं समीक्ष्य यतिमागतम् ।\nसोदर्यां भगिनीं कृष्णः सुभद्रामिदमब्रवीत् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2118113, "chapter_id": 3543, "verse_number": "", "content_sanskrit": "भगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2118114, "chapter_id": 3543, "verse_number": "७", "content_sanskrit": "अयं देशातिथिर्भद्रे संयतो व्रतवानृषिः ।\nप्राप्नोतु सततं पूजां तव कन्यापुरे वसन् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2118115, "chapter_id": 3543, "verse_number": "८", "content_sanskrit": "आर्येण च परिज्ञातः पूजनीयो यतिः सदा ।\nतस्माद् भरस्व वार्ष्णेयि भक्ष्यैर्भोज्यैर्यतिं सदा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2118116, "chapter_id": 3543, "verse_number": "९", "content_sanskrit": "एष यद्यदृषिर्ब्रूयात् कार्यमेव न संशयः ।\nसखीभिः सहिता भद्रे भवेथा वशवर्तिनी \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2118117, "chapter_id": 3543, "verse_number": "१०", "content_sanskrit": "पुराऽपि यतयो भद्रे ये भैक्षार्थमनुव्रताः ।\nते बभूवुर्दशार्हाणां कन्यापुरनिवासिनः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2118118, "chapter_id": 3543, "verse_number": "११", "content_sanskrit": "तेभ्यो भोज्यानि भक्ष्याणि यथाकाममतन्द्रिताः ।\nकन्यापुरगताः कन्याः प्रयच्छन्ति यशस्विनि \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2118119, "chapter_id": 3543, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2118120, "chapter_id": 3543, "verse_number": "१२", "content_sanskrit": "सा तथोक्ताऽब्रवीत् कृष्णं करिष्यामि यथाऽऽत्थ माम् ।\nतोषयिष्यामि ऋष्येण कर्मणा च द्विजर्षभम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2118121, "chapter_id": 3543, "verse_number": "१३", "content_sanskrit": "एवमेतेन रूपेण कञ्चित् कालं धनञ्जयः ।\nउवास भक्ष्यैर्भोज्यैश्च भद्रया परमार्चितः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2118122, "chapter_id": 3543, "verse_number": "१४", "content_sanskrit": "तस्य सर्वगुणोपेतां वासुदेवस्य सोदराम् ।\nपश्यतः सततं भद्रां प्रादुरासीन्मनोभवः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2118123, "chapter_id": 3543, "verse_number": "१५", "content_sanskrit": "गूहयन्निव चाकारमालोक्य वरवर्णिनीम् ।\nदीर्घमुष्णं निशश्वास पार्थः कामवशं गतः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2118124, "chapter_id": 3543, "verse_number": "१६", "content_sanskrit": "न कृष्णा द्रौपदी रूपं वासुदेवसहोदरा ।\nप्राप्ता भूदिन्द्रसेना वा साक्षाद् वा वरुणात्मजा \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2118125, "chapter_id": 3543, "verse_number": "१७", "content_sanskrit": "अतीतसमये काले सोदराणां धनञ्जयः ।\nन सस्मार सुभद्रायाः कामाङ्कुशनिवारितः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2118126, "chapter_id": 3543, "verse_number": "१८", "content_sanskrit": "क्रीडारतिपरां भद्रां सखीजनशतैर्वृताम् ।\nप्रीयते स्मार्जुनः पश्यन् स्वाहामिव हुताशनः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2118127, "chapter_id": 3543, "verse_number": "१९", "content_sanskrit": "पाण्डवस्य सुभद्रायाः सकाशे तु यशस्विनः ।\nसमुत्पत्तिः प्रभावश्च गदेन कथितः पुरा \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2118128, "chapter_id": 3543, "verse_number": "२०", "content_sanskrit": "श्रुत्वा चाशनिनिर्घोषं केशवेनोपसीदता ।\nउपमामर्जुनं कृत्वा मत्सरः कथितः पुरा \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2118129, "chapter_id": 3543, "verse_number": "२१", "content_sanskrit": "क्रुद्धमत्तप्रलापश्च वृष्णीनामर्जुनं प्रति ।\nपौरुषं चोपमां कृत्वा प्रावर्तन्त धनुष्मताम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2118130, "chapter_id": 3543, "verse_number": "२२", "content_sanskrit": "अन्योन्यकलहे चापि विवादे चापि वृष्णयः ।\nअर्जुनोऽपि न मे तुल्यः कुतस्त्वमिति तेऽब्रुवन् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2118131, "chapter_id": 3543, "verse_number": "२३", "content_sanskrit": "जातांश्च पुत्रान् गुह्णन्त आशिषो वृष्णयोऽब्रुवन् ।\nअर्जुनस्य समो वीर्ये भव तात धनुर्धरः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2118132, "chapter_id": 3543, "verse_number": "२४", "content_sanskrit": "तस्मात् सुभद्रा चकमे पौरुषाद् भरतर्षभम् ।\nसत्यसन्धस्य रूपेण चातुर्येण च मोहिता\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2118133, "chapter_id": 3543, "verse_number": "२५", "content_sanskrit": "चारणातिथिसङ्घानां शठस्य च निशठस्य च ।\nअदृष्टे कृतभावाऽभूत् सुभद्रा भरतर्षभे \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2118134, "chapter_id": 3543, "verse_number": "२६", "content_sanskrit": "कीर्तयन् ददृशे यो यः कथञ्चित् कुरुजाङ्गलम् ।\nतं तमेव सदा भद्रा बीभत्सुं स्माभिपृच्छति \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2118135, "chapter_id": 3543, "verse_number": "२७", "content_sanskrit": "अभीक्ष्णशः परिप्रश्नादभीक्ष्णश्रवणात् तथा ।\nप्रत्यक्ष इव भद्रायाः पाण्डवः समपद्यत \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2118136, "chapter_id": 3543, "verse_number": "२८", "content_sanskrit": "भुजौ भुजगसङ्काशौ ज्याघातेन किणीकृतौ ।\nपार्थोऽयमिति पश्यन्त्या निःसंशयमजायत \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2118137, "chapter_id": 3543, "verse_number": "२९", "content_sanskrit": "यथारूपं हि शुश्राव सुभद्रा भरतर्षभम् ।\nतथारूपमवेक्ष्यैनं परां प्रीतिमवाप सा \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2118138, "chapter_id": 3543, "verse_number": "३०", "content_sanskrit": "सा कदाचिदुपासीनं पप्रच्छ कुरुनन्दनम् ।\nकथं शैलाः कथं देशा नानाजनपदाः कथम् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2118139, "chapter_id": 3543, "verse_number": "३१", "content_sanskrit": "सरांसि सरितश्चैव वनानि च कथं च ते ।\nदिशस्ताश्च कथं प्राप्ताश्चरद्भगवता सदा \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2118140, "chapter_id": 3543, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2118141, "chapter_id": 3543, "verse_number": "३२", "content_sanskrit": "स तद् व्यक्तं तदा भद्रां बहुनर्मान्वितं ब्रुवन् ।\nउवाच परमप्रीतस्तस्या बहुविधाः कथाः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2118142, "chapter_id": 3543, "verse_number": "३३", "content_sanskrit": "निशम्य विविधं तत् स्म लोके चरितमात्मनः ।\nकथापरिगतो भावः कन्यायाः समपद्यत \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2118143, "chapter_id": 3543, "verse_number": "३४", "content_sanskrit": "पर्वसन्धौ तु कस्मिंश्चित् सुभद्रा भरतर्षभम् ।\nरहस्येकान्तमासाद्य हृष्यमाणाऽभ्यभाषत \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2118144, "chapter_id": 3543, "verse_number": "३५", "content_sanskrit": "यतिना चरतो लोकान् खाण्डवप्रस्थवासिनी ।\nकच्चिद् भगवता दृष्टा पृथाऽस्माकं पितृष्वसा \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2118145, "chapter_id": 3543, "verse_number": "३६", "content_sanskrit": "भ्रातृभिः प्रीयते सर्वैः कच्चिदार्यो युधिष्ठिरः ।\nकच्चिद् धर्मपरो भीमो धर्मराजस्य धीमतः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2118146, "chapter_id": 3543, "verse_number": "३७", "content_sanskrit": "निवृत्तसमयः कच्चिदपराधी धनञ्जयः ।\nनियमे कामभोगानां वर्तमानः प्रिये रतः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2118147, "chapter_id": 3543, "verse_number": "३८", "content_sanskrit": "क्क नु पार्थश्चरत्यद्य बह्वीर्दुर्वसतीर्वसन् ।\nसुखोचितो ह्यदुःखार्हो दीर्घबाहुररिन्दमः ।\nक्वच्चिच्छ्रुतो वा दृष्टो वा पार्थो भगवताऽर्जुनः \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2118148, "chapter_id": 3543, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2118149, "chapter_id": 3543, "verse_number": "३९", "content_sanskrit": "निशम्य वचनं तस्यास्तामुवाच हसन्निव ।\nमाता कुशलिनी आर्या सहपुत्रा सहस्नुषा\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2118150, "chapter_id": 3543, "verse_number": "४०", "content_sanskrit": "प्रीयते पश्यती पुत्रान् कुरुक्षेत्रं च पश्यती ।\nअनुज्ञातश्च मात्रा च सोदर्यैश्च धनञ्जयः \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2118151, "chapter_id": 3543, "verse_number": "४१", "content_sanskrit": "द्वारकामावसत्येको यतिलिङ्गेन पाण्डवः ।\nपश्यन्ती सततं कस्मान्नाभिजानासि माधवि \t॥ ४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2118152, "chapter_id": 3543, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2118153, "chapter_id": 3543, "verse_number": "४२", "content_sanskrit": "निशम्य वचनं तस्य वासुदेवसहोदरा ।\nनिश्वासबहुला तस्थौ क्षितिं विलिखती तदा \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2118154, "chapter_id": 3543, "verse_number": "४३", "content_sanskrit": "ततः परमससंहृष्टः सर्वशस्त्रभृतां वरः ।\nअर्जुनोऽहमिति प्रीतस्तामुवाच धनञ्जयः \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2118155, "chapter_id": 3543, "verse_number": "४४", "content_sanskrit": "यथा भगवतो भावः श्रवणन्मयि भामिनि ।\nत्वद्गतः सततं भावस्तथा शतगुणो मम \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2118156, "chapter_id": 3543, "verse_number": "४५", "content_sanskrit": "प्रशस्तेऽहनि धर्मेण भद्रे स्वयमहं वृतः ।\nसत्यवानिव सावित्र्या भविष्यामि पतिस्तव \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2118157, "chapter_id": 3543, "verse_number": "४६", "content_sanskrit": "एवमुक्त्वा ततः पार्थः प्रविवेश लतागृहम् ।\nततः सुभद्रा ललिता लज्जाभावसमन्विता \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2118158, "chapter_id": 3543, "verse_number": "४७", "content_sanskrit": "मुमोह भवने दिव्ये शयाना नतथोचिता ।\nकन्यापुरे सम्प्रवृत्तं ज्ञात्वा दिव्येन चक्षुषा \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2118159, "chapter_id": 3543, "verse_number": "४८", "content_sanskrit": "शशास रुग्मिणीं कृष्णो भोजनानि तदाऽर्जुने ।\nतदाप्रभृति तां भद्रां चिन्तयन् वै धनञ्जयः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2118160, "chapter_id": 3543, "verse_number": "४९", "content_sanskrit": "आस्ते स्म स तदाऽऽरामे काश्यपेन सहाभिभूः ।\nसुभद्राऽपि न च स्वस्था पार्थं प्रति बभूव सा \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2118161, "chapter_id": 3543, "verse_number": "५०", "content_sanskrit": "कृशा विवर्णवदना चिन्ताशोकपरायणा ।\nनिश्वासपरमा भद्रा मानसेन मनस्विनी \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2118162, "chapter_id": 3543, "verse_number": "५१", "content_sanskrit": "न शय्यासनभोगेषु रतिं विन्दति केनचित् ।\nन नक्तं न दिवा शेते बभूवोन्मत्तदर्शना\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2118163, "chapter_id": 3543, "verse_number": "५२", "content_sanskrit": "एवं शोकपरां भद्रां देवकी वाक्यमब्रवीत् ।\nमा शोकं कुरु वार्ष्णेयि धृतिमालम्ब शोभने \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2118164, "chapter_id": 3543, "verse_number": "५३", "content_sanskrit": "निवेदयित्वा रामाय कृष्णे चैव नरर्षमे ।\nपश्चाज्जानामि ते वार्तां मा शोकं कुरु माधवि \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2118165, "chapter_id": 3543, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2118166, "chapter_id": 3543, "verse_number": "५४", "content_sanskrit": "एवमुक्त्वा च सा माता भद्रायाः प्रियकामिनी ।\nनिवेदयामास तदा भद्रामानकदुन्दुभेः \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2118167, "chapter_id": 3543, "verse_number": "५५", "content_sanskrit": "रहस्येकासना तत्र भर्तारमिदमब्रवीत् ।\nआरामेऽस्ति यतिः श्रीमानर्जुनः सोऽथ नः श्रुतः \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2118168, "chapter_id": 3543, "verse_number": "५६", "content_sanskrit": "अक्रूराय च कृष्णाय आहुकाय च सात्यकेः ।\nनिवेद्यतां महाप्रज्ञ श्रोतव्यं यदि बान्धवैः \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2118169, "chapter_id": 3543, "verse_number": "५७", "content_sanskrit": "वसुदेवस्तु तच्छ्रुत्वा अक्रूराहुकयोस्तदा ।\nनिवेदयित्वा कृष्णेऽथ मन्त्रयामास नैकधा \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2118170, "chapter_id": 3543, "verse_number": "५८", "content_sanskrit": "इदं कार्यमिदं कृत्यमिदमेव च निश्चितम् ।\nअक्रूरश्चोग्रसेनश्च सत्यकेन गदेन ह \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2118171, "chapter_id": 3543, "verse_number": "५९", "content_sanskrit": "पृथुश्रवाश्च कृष्णश्च सहिताः शिनिना सह ।\nरुग्मिणी सत्यभामा च देवकी रेवती तथा\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2118172, "chapter_id": 3543, "verse_number": "६०", "content_sanskrit": "वसुदेवेन सहिताः पुरोहितमते स्थिताः ।\nविवाहं मन्त्रयामासुर्द्वादशेऽहनि भारत \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2118173, "chapter_id": 3543, "verse_number": "६१", "content_sanskrit": "अज्ञातं रौहिणेयस्य उद्धवस्य च भारत ।\nविवाहं तु सुभद्रायाः कर्तुकामो गदाग्रजः \t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2118174, "chapter_id": 3543, "verse_number": "६२", "content_sanskrit": "महादेवस्य पूजार्थं व्याजेन मधुसूदनः ।\nनगरे घोषयामास हितार्थं सव्यसाचिनः \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2118175, "chapter_id": 3543, "verse_number": "६३", "content_sanskrit": "इतश्चतुर्थेऽहनि च अन्तर्द्वीपं तु गम्यताम् ।\nसदारैः सानुयात्रैश्च सपुत्रैः सहबान्धवैः \t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2118176, "chapter_id": 3543, "verse_number": "६४", "content_sanskrit": "वासुदेवसमैश्चापि गन्तव्यं सर्वयादवैः ।\nगन्तव्यं सर्ववर्णैश्च गन्तव्यं सर्वयादवैः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2118177, "chapter_id": 3543, "verse_number": "६५", "content_sanskrit": "एवमुक्तास्तु ते सर्वे तथा चक्रुश्च सर्वशः ।\nततः सर्वदशार्हाणामन्तर्द्वीपे नरर्षभ \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2118178, "chapter_id": 3543, "verse_number": "६६", "content_sanskrit": "चतुस्त्रिंशदहोरात्रं बभूव परमोत्सवः ।\nकृष्णरामाहुकाक्रूराः प्रद्युम्नः शिनिसात्यकी\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2118179, "chapter_id": 3543, "verse_number": "६७", "content_sanskrit": "समुद्रं प्रययुर्हृष्टाः कुकुरान्धकवृष्णयः ।\nयुक्तयन्त्रपताकाभिर्वृष्णयो ब्राह्मणैः सह \t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2118180, "chapter_id": 3543, "verse_number": "६८", "content_sanskrit": "समुद्रं प्रययुर्नौभिः सर्वे पुरनिवासिनः ।\nततस्त्वरितमागत्य दासीशतसुपूजिता \t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2118181, "chapter_id": 3543, "verse_number": "६९", "content_sanskrit": "सुभद्रा पुण्डरीकाक्षमब्रवीद् यतिशासनात् ।\nकृत्यवान् द्वादशाहानि स्थाता स भगवानिह \t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2118182, "chapter_id": 3543, "verse_number": "७०", "content_sanskrit": "तिष्ठतस्तस्य कः कुर्याद् उपस्थानविधिं प्रति ।\nतमुवाच हृषीकेशः कस्त्वदन्यो विशेषतः \t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2118183, "chapter_id": 3543, "verse_number": "७१", "content_sanskrit": "तमृषिं प्रत्युपस्थातुमिह नार्हति मानवः ।\nत्वमेवास्मन्मतेनास्य महर्षेर्वशवर्तिनी\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2118184, "chapter_id": 3543, "verse_number": "७२", "content_sanskrit": "कुरु सर्वाणि कार्याणि कीर्तिं धर्ममवेक्ष्य च ।\nतस्य चातिथिमुख्यस्य सर्वेषां च तपस्विनाम् ।\nसंविधानपरा भद्रे भव त्वं वशवर्तिनी \t॥ ७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2118185, "chapter_id": 3543, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2118186, "chapter_id": 3543, "verse_number": "७३", "content_sanskrit": "एवमादिश्य भद्रां च रक्षां च मधुसूदनः ।\nययौ शङ्खनिनादेन भेरीणां च महास्वनैः\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2118187, "chapter_id": 3543, "verse_number": "७४", "content_sanskrit": "ततस्तद्द्वीपमासाद्य दानधर्मपरायणाः ।\nउग्रसेनमुखाः सर्वे विजह्रुः कुकुरान्धकाः \t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2118188, "chapter_id": 3543, "verse_number": "७५", "content_sanskrit": "सप्तयोजनविस्तार आयतो दशयोजनम् ।\nबभूव स महाद्वीपः सपर्वतमहावनः \t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2118189, "chapter_id": 3543, "verse_number": "७६", "content_sanskrit": "सेतुपुष्करिणीजालैराक्रीडः सर्वसात्वताम् ।\nवापीपल्वलसङ्घैश्च काननैश्च मनोरमैः \t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2118190, "chapter_id": 3543, "verse_number": "७७", "content_sanskrit": "वासुदेवेन च द्वीपः स सर्वैः कुकुरान्धकैः ।\nबभूव परमोपेतः त्रिविष्टप इवामरैः \t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2118191, "chapter_id": 3543, "verse_number": "७८", "content_sanskrit": "चतुस्त्रिंशदहोरात्रं दानधर्मपरायणाः ।\nउग्रसेनमुखाः सर्वे विजह्रुः कुकुरान्धकाः \t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2118192, "chapter_id": 3543, "verse_number": "७९", "content_sanskrit": "विचित्रमाल्याभरणाश्चित्रगन्धानुलेपनाः ।\nविहाराभिमुखाः सर्वे यादवाः पानहेतवः \t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2118193, "chapter_id": 3543, "verse_number": "८०", "content_sanskrit": "सुनृत्तगीतवादित्रै रममाणास्तदाऽभवन् ।\nतत्र याते दशार्हाणामृषभे शार्ङ्गधन्वनि ।\nसुभद्रोद्वाहनं पार्थः प्राप्तकालममन्यत \t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2118194, "chapter_id": 3543, "verse_number": "२२२", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nद्वाविंशत्यधिअकद्विशततमोऽध्यायः ॥२२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2118195, "chapter_id": 3543, "verse_number": "३", "content_sanskrit": "॥ इति सुभद्राहरणपर्वणि तृतीयोऽध्यायः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2118196, "chapter_id": 3543, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}]