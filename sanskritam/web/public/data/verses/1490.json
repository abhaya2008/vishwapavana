[{"id": 2023007, "chapter_id": 1490, "verse_number": "३-१२८-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2023008, "chapter_id": 1490, "verse_number": "३-१२८-१", "content_sanskrit": "कथंवीर्यः स राजाऽभूत्सोमको ददतांवरः।\nकर्माण्यस्य प्रभावं च श्रोतुमिच्छामि तत्त्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2023009, "chapter_id": 1490, "verse_number": "३-१२८-२x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2023010, "chapter_id": 1490, "verse_number": "३-१२८-२", "content_sanskrit": "युधिष्ठिरासीन्नृपतिः सोमको नाम धार्मिकः।\nतस्य भार्याशतं राजन्सदृशीनामभूत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2023011, "chapter_id": 1490, "verse_number": "३-१२८-३", "content_sanskrit": "स वै यत्नेन महता तासु पुत्रं महीपतिः।\nकंचिन्नासादयामास कालेन महता ह्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2023012, "chapter_id": 1490, "verse_number": "३-१२८-४", "content_sanskrit": "कदाचित्तस् वृद्धस्य यतमानस्य धीमतः।\nजन्तुर्नाम सुतस्तस्य ज्येष्ठायां समजायत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2023013, "chapter_id": 1490, "verse_number": "३-१२८-५", "content_sanskrit": "तं जातं मातरः सर्वाः परिवार्य समासते।\nसततं पृष्ठतः कृत्वा कामभोगान्विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2023014, "chapter_id": 1490, "verse_number": "३-१२८-६", "content_sanskrit": "ततः पिपीलिका जन्तुं कदाचिददशत्स्फिचि।\nस दष्टो ह्यरुदद्राजंस्तेन दुःखेन बालकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2023015, "chapter_id": 1490, "verse_number": "३-१२८-७", "content_sanskrit": "ततस्ता मातरः सर्वाः प्राक्रोशन्भृशदुःखिताः।\nप्रवार्य जनतुं सहसा स शब्दस्तुमुलोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2023016, "chapter_id": 1490, "verse_number": "३-१२८-८", "content_sanskrit": "तमार्तनादं सहसा शुश्राव स महीपतिः।\nअमात्यपर्षदो मध्ये उपविष्टः सहर्त्विजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2023017, "chapter_id": 1490, "verse_number": "३-१२८-९", "content_sanskrit": "ततः प्रस्थापयामास किमेतदिति पार्थिवः।\nतस्मै क्षत्ता यथावृत्तमाचचक्षे सुतं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2023018, "chapter_id": 1490, "verse_number": "३-१२८-१०", "content_sanskrit": "त्वरमाणः स चोत्थाय सोमकः सह मन्त्रिभिः।\nप्रविश्यान्तःपुरं पुत्रमाश्वासयदरिंदमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2023019, "chapter_id": 1490, "verse_number": "३-१२८-११", "content_sanskrit": "सान्त्वयित्वा तु तं पुत्रं निष्क्रम्यान्तःपुरान्नृपः।\nऋत्विजा सहितो राजन्सहामात्य उपाविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2023020, "chapter_id": 1490, "verse_number": "३-१२८-१२x", "content_sanskrit": "सोमक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2023021, "chapter_id": 1490, "verse_number": "३-१२८-१२", "content_sanskrit": "धिगस्त्विहैकपुत्रत्वमपुत्रत्वं वरं भवेत्।\nनित्यातुरत्वाद्भूतानां शोक एवैकपुत्रता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2023022, "chapter_id": 1490, "verse_number": "३-१२८-१३", "content_sanskrit": "इदं भार्याशतं ब्रह्मन्परीक्ष्यसदृशं प्रभो।\nपुत्रार्थिना मया वोढं न तासां विद्यते प्रजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2023023, "chapter_id": 1490, "verse_number": "३-१२८-१४", "content_sanskrit": "एकः कथंचिदुत्पन्नः पुत्रो जन्तुरयं मम।\nयतमानासु सर्वासु किंनु दुःखमतः परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2023024, "chapter_id": 1490, "verse_number": "३-१२८-१५", "content_sanskrit": "वयश्च समतीतं मे सभार्यस्यं द्विजोत्तम।\nआसां प्राणाः समायत्ता मम चात्रैकपुत्रके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2023025, "chapter_id": 1490, "verse_number": "३-१२८-१६", "content_sanskrit": "स्यात्तु कर्म तथा युक्तं येन पुत्रशतं भवेत्।\nमहता लघुना वाऽपि कर्मणा दुष्करेण वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2023026, "chapter_id": 1490, "verse_number": "३-१२८-१७x", "content_sanskrit": "ऋत्विगुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2023027, "chapter_id": 1490, "verse_number": "३-१२८-१७", "content_sanskrit": "अस्ति चैतादृशं कर्म येन पुत्रशतं भवेत्।\nयदि शक्नोषि तत्कर्तुमथ वक्ष्यामि सोमक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2023028, "chapter_id": 1490, "verse_number": "३-१२८-१८x", "content_sanskrit": "सोमक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2023029, "chapter_id": 1490, "verse_number": "३-१२८-१८", "content_sanskrit": "कार्यं वा यदि वाऽकार्यं येन पुत्रशतं भवेत्।\nकृतमेवेति तद्विद्धि भगवान्प्रब्रवीतु मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2023030, "chapter_id": 1490, "verse_number": "३-१२८-१९x", "content_sanskrit": "ऋत्विगुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2023031, "chapter_id": 1490, "verse_number": "३-१२८-१९", "content_sanskrit": "यजस्व जन्तुना राजंस्त्वं मया वितते क्रतौ।\nततः पुत्रशतं श्रीमद्भविष्यत्यचिरेण ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2023032, "chapter_id": 1490, "verse_number": "३-१२८-२०", "content_sanskrit": "वपार्या हूयमानायां धूममाघ्राय मातरः।\nततस्ताः सुमहावीर्याञ्जनयिष्यन्ति ते सुतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2023033, "chapter_id": 1490, "verse_number": "३-१२८-२१", "content_sanskrit": "तस्यामेव तु ते जन्तुर्भविता पुनरात्मजः।\nउत्तरे चास्य सौवर्णं लक्ष्म पार्श्वे भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2023034, "chapter_id": 1490, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि अष्टाविंशत्यधिकशततमोऽध्यायः ॥ १२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]