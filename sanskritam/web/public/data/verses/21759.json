[{"id": 7001759000, "chapter_id": 21759, "verse_number": "२-२०-१", "content_sanskrit": "वसिष्ठ उवाच ।\nएवं सुरतमूढस्य राज्ञो रुक्मांगदस्य च ।\nत्रीणि पंच च वर्षाणि व्यतीतानि सुखेन वै ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001759001, "chapter_id": 21759, "verse_number": "२-२०-२", "content_sanskrit": "संप्राप्ते नवमे वर्षे पुत्रो धर्मांगदो बली ।\nजित्वा विद्याधरान्पंच मलये पर्वतोत्तमे ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001759002, "chapter_id": 21759, "verse_number": "२-२०-३", "content_sanskrit": "आजहार मणीन्पंच सर्वकामप्रदान् शुभान् ।\nएकं कांचनदातारं कोटिकोटिगुणं शुभम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001759003, "chapter_id": 21759, "verse_number": "२-२०-४", "content_sanskrit": "द्वितीयं वस्त्रभूषादिलक्षकोटिप्रदं तथा ।\nतृतीयममृतस्रावि पुनर्यौवनकारकम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001759004, "chapter_id": 21759, "verse_number": "२-२०-५", "content_sanskrit": "सभागृहप्रकर्तारं चतुर्थं चान्नसाधकम् ।\nपंचमं व्योभगतिदं त्रैलोक्यपरिसर्पणम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001759005, "chapter_id": 21759, "verse_number": "२-२०-६", "content_sanskrit": "तान्मणीन्गृह्य मनसा विद्याधरसमन्वितः ।\nस्त्रीभिर्विद्याधराणां च साश्रुनेत्राभिरावृतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001759006, "chapter_id": 21759, "verse_number": "२-२०-७", "content_sanskrit": "ववंदे चरणौ मातुः पितू रुक्मांगदस्य च ।\nमणीन्पंच समर्प्याथ पादयोः प्राह संनतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001759007, "chapter_id": 21759, "verse_number": "२-२०-८", "content_sanskrit": "इमे जिता मया तात पञ्च विद्याधरा रणे ।\nमलये भूधरश्रेष्ठे वैष्णवास्त्रेण भूपते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001759008, "chapter_id": 21759, "verse_number": "२-२०-९", "content_sanskrit": "इमे ते भृत्यतां प्राप्ताः सस्त्रीका नृपसत्तम ।\nमणीन्प्रयच्छ मोहिन्यै भुजभूषणहेतवे ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001759009, "chapter_id": 21759, "verse_number": "२-२०-१०", "content_sanskrit": "सर्वकामप्रदा ह्येते पुनर्यौवनकारिणः ।\nजीर्णदंताः पुनर्बाला भवंति मणिधारणात् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001759010, "chapter_id": 21759, "verse_number": "२-२०-११", "content_sanskrit": "वस्त्रहर्म्यसुवर्णानां स्वर्गतेरमृतस्य च ।\nदातारो मासयुद्धेन साधितास्तव तेजसा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001759011, "chapter_id": 21759, "verse_number": "२-२०-१२", "content_sanskrit": "साधितानि मया कृच्छ्रात्सप्तद्वीपानि भूपते ।\nकरदानिसमस्तानि कृतानि तव तेजसा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001759012, "chapter_id": 21759, "verse_number": "२-२०-१३", "content_sanskrit": "समुद्रे च प्रविष्टस्य गतः संवत्सरो मम ।\nजिता भोगवती तात मया नागसमावृता ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001759013, "chapter_id": 21759, "verse_number": "२-२०-१४", "content_sanskrit": "आहृता नागकन्याश्च मया चायुतसंख्यकाः ।\nतत्रापि हाररत्नानि सुबहून्याहृतानि च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001759014, "chapter_id": 21759, "verse_number": "२-२०-१५", "content_sanskrit": "पुनश्चाहं गतस्तात दानवानां पुरं महत् ।\nतान्निर्जित्यं च कन्यानां सुरूपाणां सुवर्चसाम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001759015, "chapter_id": 21759, "verse_number": "२-२०-१६", "content_sanskrit": "आहृतानि मया त्रीणि सहस्राणि च पंच च ।\nदशकोट्यस्तु रत्नानां दीपकर्म निशागमे ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001759016, "chapter_id": 21759, "verse_number": "२-२०-१७", "content_sanskrit": "कुर्वतां ते महीपाल आनीतास्तव मंदिरे ।\nततोऽहं वारुणं लोकं रसातलतलस्थितम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001759017, "chapter_id": 21759, "verse_number": "२-२०-१८", "content_sanskrit": "गतो वीर्यबलोत्सिक्तस्त्वदंघ्रियुगसेवकः ।\nतत्रोक्तो वरुणो देवः स्थीयतां मत्पिंतुर्वशे ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001759018, "chapter_id": 21759, "verse_number": "२-२०-१९", "content_sanskrit": "रुक्मांगदस्य नृपतेर्यदि जीवितुमिच्छसि ।\nकुपितो मम वाक्येन वरुणो योद्धुमागतः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001759019, "chapter_id": 21759, "verse_number": "२-२०-२०", "content_sanskrit": "तेन संवत्सरं युद्धं घोरं जातं रसातले ।\nजितो नारायणास्त्रेण मया स जलनायकः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001759020, "chapter_id": 21759, "verse_number": "२-२०-२१", "content_sanskrit": "न हतः प्रमदावाक्यैस्तस्य जीवितरक्षणे ।\nनिर्जितेनायुतं दत्तं वाजिनां वातरंहसाम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001759021, "chapter_id": 21759, "verse_number": "२-२०-२२", "content_sanskrit": "एकतः श्यामकर्णानां शुभ्राणां चंद्रवर्चसाम् ।\nतृणतोयविहीना ये जीवंति बहुशः समाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001759022, "chapter_id": 21759, "verse_number": "२-२०-२३", "content_sanskrit": "एकां कन्यां सुरूपां मे पुरस्कृत्य स्वलंकृताम् ।\nभार्यार्थे वरुणः प्रादात्साप्यानीता मया शुभा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001759023, "chapter_id": 21759, "verse_number": "२-२०-२४", "content_sanskrit": "कुमारी तु समानीताः बहुवित्तसमन्विता ।\nतन्नास्ति त्रिषु लोकेषु स्थानं तात सुदुर्गमम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001759024, "chapter_id": 21759, "verse_number": "२-२०-२५", "content_sanskrit": "यन्मया न जितं ह्यस्ति तवांघ्रिपरिसेवनात् ।\nतदुत्तिष्ठ परीक्षस्व त्वत्प्रसादार्जितां श्रियम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001759025, "chapter_id": 21759, "verse_number": "२-२०-२६", "content_sanskrit": "अहं च संपदः सर्वास्त्वदधीना विशांपते ।\nयः पुत्रस्तात वदति मया लक्ष्मीः समर्जिता ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001759026, "chapter_id": 21759, "verse_number": "२-२०-२७", "content_sanskrit": "न देया भूमिदेवेभ्यः सोऽपि वै नरकं व्रजेत् ।\nआत्मसंभावनं तात न कर्तव्यं सुतेन हि ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001759027, "chapter_id": 21759, "verse_number": "२-२०-२८", "content_sanskrit": "कुठारदात्रसदृशः पुत्रः संपत्समुच्चये ।\nपितुः शौर्येण पुत्रस्य वर्द्धते धनसंचयः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001759028, "chapter_id": 21759, "verse_number": "२-२०-२९", "content_sanskrit": "तैजसं दात्रमादाय लुनाति तृणसंचयान् ।\nवायुना पूरितं वस्त्रं तारयेन्नौगतं जले ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001759029, "chapter_id": 21759, "verse_number": "२-२०-३०", "content_sanskrit": "यथा दारुमयी योषा चेष्टते कुहकेच्छया ।\nतथाहि पितृवीर्येण पुत्रास्तेजोबलान्विताः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001759030, "chapter_id": 21759, "verse_number": "२-२०-३१", "content_sanskrit": "तस्मादियं माधवदेववल्लभा विलोकयस्वाद्य मयोपनीता ।\nआत्मेच्छया यच्छतु रक्षताद्वा स्वसंपदो मातृसमूहवर्याः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]