[{"id": 2071256, "chapter_id": 2503, "verse_number": "१२-८-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2071257, "chapter_id": 2503, "verse_number": "१२-८-१", "content_sanskrit": "अथार्जुन उवाचेदमधिक्षिप्त इवाक्षमी।\nअभिनीततरं वाक्यं दृढवादपराक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2071258, "chapter_id": 2503, "verse_number": "१२-८-२", "content_sanskrit": "दर्शयन्नैन्द्रिरात्मानमुग्रमुग्रपराक्रमः।\nस्मयमानो महातेजाः सृक्किणी परिसंलिहन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2071259, "chapter_id": 2503, "verse_number": "१२-८-३x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2071260, "chapter_id": 2503, "verse_number": "१२-८-३", "content_sanskrit": "अहो दुःखमहो कृच्छ्रमहो वैक्लव्यमुत्तमम्।\nयत्कृत्वाऽमानुषं कर्म त्यजेथाः श्रियमुत्तमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2071261, "chapter_id": 2503, "verse_number": "१२-८-४", "content_sanskrit": "शत्रून्हत्वा महीं लब्ध्वा स्वधर्मेणोपपादिताम्।\nहतामित्रः कथं स त्वं त्यजेथा बुद्धिलाघवात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2071262, "chapter_id": 2503, "verse_number": "१२-८-५", "content_sanskrit": "क्लीबस्य हि कुतो राज्यं दीर्घसूत्रस्य वा पुनः।\nकिमर्थं च महीपालानवधीः क्रोधमूर्च्छितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2071263, "chapter_id": 2503, "verse_number": "१२-८-६", "content_sanskrit": "यो ह्याजिजीविषेद्भैक्षं कर्मणा नैव कस्य चित्।\nसमारम्भान्बुभूषेत हतस्वस्तिरकिञ्चनः।\nसर्वलोकेषु विख्यातो न पुत्रपशुसंहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2071264, "chapter_id": 2503, "verse_number": "१२-८-७", "content_sanskrit": "कापालीं नृप पापिष्ठां वृत्तिमासाद्य जीवतः।\nसंत्यज्य राज्यमृद्धं ते लोकोऽयं किं वदिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2071265, "chapter_id": 2503, "verse_number": "१२-८-८", "content_sanskrit": "सर्वारम्भान्समुत्सृज्य हतस्वस्तिरकिञ्चनः।\nकस्मादाशंससे भैक्षं चर्तुं प्राकृतवत्प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2071266, "chapter_id": 2503, "verse_number": "१२-८-९", "content_sanskrit": "कस्माद्राजकुले जातो जित्वा कृत्स्नां वसुंधराम्।\nधर्मार्थावखिलौ हित्वा वनं मौढ्यात्प्रतिष्ठसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2071267, "chapter_id": 2503, "verse_number": "१२-८-१०", "content_sanskrit": "यदीमानि हवींषीह विमथिष्यन्त्यसाधवः।\nभवता विप्रहीणत्वात्प्राप्तं त्वामेव किल्विषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2071268, "chapter_id": 2503, "verse_number": "१२-८-११", "content_sanskrit": "आकिञ्चन्यं मुनीनां च इति वै नहुषोऽब्रवीत्।\nकृत्वा नृशंसं ह्यधने धिगस्त्वधनतामिह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2071269, "chapter_id": 2503, "verse_number": "१२-८-१२", "content_sanskrit": "आश्वस्तन्यमृषीणां हि विद्यते वेद तद्भवान्।\nयं त्विमं धर्ममित्याहुर्धनादेष प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2071270, "chapter_id": 2503, "verse_number": "१२-८-१३", "content_sanskrit": "धर्मं स हरते तस्य धनं हरति यस्य यः।\nह्रियमाणे धने राजन्वयं कस्य क्षमेमहि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2071271, "chapter_id": 2503, "verse_number": "१२-८-१४", "content_sanskrit": "अभिशस्तं प्रपश्यन्ति दरिद्रं पार्श्वतः स्थितम्।\nदारिद्र्यं पातकं लोके कस्तच्छंसितुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2071272, "chapter_id": 2503, "verse_number": "१२-८-१५", "content_sanskrit": "पतितः शोच्यते राजन्निर्धनश्चापि शोच्यते।\nविशेषं नाधिगच्छामि पतितस्याधनस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2071273, "chapter_id": 2503, "verse_number": "१२-८-१६", "content_sanskrit": "अर्थेभ्यो हि विवृद्धेभ्यः संभृतेभ्यस्ततस्ततः।\nक्रियाः सर्वाः प्रवर्तन्ते पर्वतेभ्य इवापगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2071274, "chapter_id": 2503, "verse_number": "१२-८-१७", "content_sanskrit": "अर्थाद्धर्मश्च कामश्च स्वर्गश्चैव नराधिप।\nप्राणयात्राऽपि लोकस्य विना ह्यर्थं न सिध्द्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2071275, "chapter_id": 2503, "verse_number": "१२-८-१८", "content_sanskrit": "अर्थेन हि विहीनस्य पुरुषस्याल्पमेधसः।\nविच्छिद्यन्ते क्रियाः सर्वा ग्रीष्मे कुसरितो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2071276, "chapter_id": 2503, "verse_number": "१२-८-१९", "content_sanskrit": "यस्यार्थास्तस्य मित्राणि यस्यार्थास्तस्य बान्धवाः।\nयस्यार्थाः स पुमाँल्लोके यस्यार्थाः स च पण्डितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2071277, "chapter_id": 2503, "verse_number": "१२-८-२०", "content_sanskrit": "अधनेनार्थकामेन नार्थः शक्यो विधित्सितुम्।\nअर्थैरर्था निबध्यन्ते गजैरिव महागजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2071278, "chapter_id": 2503, "verse_number": "१२-८-२१", "content_sanskrit": "धर्मः कामश्च स्वर्गश्च हर्षः क्रोधः श्रुतं दमः।\nअर्थादेतानि सर्वाणि प्रवर्तन्ते नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2071279, "chapter_id": 2503, "verse_number": "१२-८-२२", "content_sanskrit": "धनात्कुलं प्रभवति धनाद्धर्मः प्रवर्धते।\nनाधनस्यास्त्ययं लोको न परः पुरुषोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2071280, "chapter_id": 2503, "verse_number": "१२-८-२३", "content_sanskrit": "नाधनो धर्मकृत्यानि यथावदनुतिष्ठति।\nधनाद्धि धर्मः स्रवति शैलादभिनदी यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2071281, "chapter_id": 2503, "verse_number": "१२-८-२४", "content_sanskrit": "यः कृशार्थः कृशगवः कृशभृत्यः कृशांतिथिः।\nस वै राजन्कृशो नाम न शरीरकृशः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2071282, "chapter_id": 2503, "verse_number": "१२-८-२५", "content_sanskrit": "अवेक्षस्व यथान्यायं पश्य देवासुरं यथा।\nराजन्किमन्यज्ज्ञातीनां वधाद्गृध्यन्ति देवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2071283, "chapter_id": 2503, "verse_number": "१२-८-२६", "content_sanskrit": "न चेद्धर्तव्यमन्यस्य कथं तद्धर्ममारभेत्।\nएतावानेव वेदेषु निश्चयः कविभिः कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2071284, "chapter_id": 2503, "verse_number": "१२-८-२७", "content_sanskrit": "अध्येतव्या त्रयी नित्यं भवितव्यं विपश्चिता।\nसर्वथा धनमाहार्यं यष्टव्यं चापि यत्नतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2071285, "chapter_id": 2503, "verse_number": "१२-८-२८", "content_sanskrit": "द्रोहाद्देवैरवाप्तानि दिवि स्थानानि सर्वशः।\nद्रोहात्किमन्यज्ज्ञातीनां गृध्यन्ते येन देवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2071286, "chapter_id": 2503, "verse_number": "१२-८-२९", "content_sanskrit": "इति देवा व्यवसिता वेदवादाश्च शाश्वताः।\nअधीयन्तेऽध्यापयन्ते यजन्ते याजयन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2071287, "chapter_id": 2503, "verse_number": "१२-८-३०", "content_sanskrit": "कृत्स्नं तदेव तच्छ्रेयो यदप्याददतेऽन्यतः।\nन पश्यामोऽनपकृतं धनं किंचित्क्वचिद्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2071288, "chapter_id": 2503, "verse_number": "१२-८-३१", "content_sanskrit": "एवमेव हि राजानो यजन्ति पृथिवीमिमाम्।\nजित्वा ममेयं ब्रुवते पुत्रा इव पितृर्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2071289, "chapter_id": 2503, "verse_number": "१२-८-३२", "content_sanskrit": "राजर्षयोऽपि ते स्वर्ग्या धर्मो ह्येषां निरुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2071290, "chapter_id": 2503, "verse_number": "१२-८-३३", "content_sanskrit": "यथैव पूर्णादुदधेः स्यन्दन्त्यापो दिशो दश।\nएवं राजकुलाद्वित्तं पृथिवीं प्रतितिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2071291, "chapter_id": 2503, "verse_number": "१२-८-३४", "content_sanskrit": "आसीदियं दिलीपस्य नृगस्य नहुषस्य च।\nअंबरीपस्य मान्धातुः पृथिवी सा त्वयि स्थिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2071292, "chapter_id": 2503, "verse_number": "१२-८-३५", "content_sanskrit": "स त्वां द्रव्यमयो यज्ञः संप्राप्तः सर्वदक्षिणः।\nतं चेन्न यजसे राजन्प्राप्तस्त्वं राज्यकिल्बिषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2071293, "chapter_id": 2503, "verse_number": "१२-८-३६", "content_sanskrit": "येषां राजाऽश्वमेधेन यजते दक्षिणावता।\nउपेत्य तस्यावभृथे पूताः सर्वे भवन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2071294, "chapter_id": 2503, "verse_number": "१२-८-३७", "content_sanskrit": "विश्वरूपो महादेवः सर्वमेधे महामखे।\nजुहाव सर्वभूतानि तथैवात्मानमात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2071295, "chapter_id": 2503, "verse_number": "१२-८-३८", "content_sanskrit": "शाश्वतोऽयं भूतिपथो नास्त्यन्तमनुशुश्रुम।\nमहाजनपथं गन्ता मा राजन्कुपथं गमः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2071296, "chapter_id": 2503, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि अष्टमोऽध्यायः॥ ८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]