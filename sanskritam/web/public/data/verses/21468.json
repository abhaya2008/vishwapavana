[{"id": 7001468000, "chapter_id": 21468, "verse_number": "७-२-६-१", "content_sanskrit": "उपमन्युरुवाच ।\nनशिवस्याणवो बंधः कार्यो मायेय एव वा ।\nप्राकृतो वाथ बोद्धा वा ह्यहंकारात्मकस्तथा॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001468001, "chapter_id": 21468, "verse_number": "७-२-६-२", "content_sanskrit": "नैवास्य मानसो बंधो न चैत्तो नेंद्रियात्मकः ।\nन च तन्मात्रबंधो ऽपि भूतबंधो न कश्चन॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001468002, "chapter_id": 21468, "verse_number": "७-२-६-३", "content_sanskrit": "न च कालः कला चैव न विद्या नियतिस्तथा ।\nन रागो न च विद्वेषः शंभोरमिततेजसः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001468003, "chapter_id": 21468, "verse_number": "७-२-६-४", "content_sanskrit": "न चास्त्यभिनिवेशो ऽस्य कुशला ऽकुशलान्यपि ।\nकर्माणि तद्विपाकश्च सुखदुःखे च तत्फले॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001468004, "chapter_id": 21468, "verse_number": "७-२-६-५", "content_sanskrit": "आशयैर्नापि संबन्धः संस्कारैः कर्मणामपि ।\nभोगैश्च भोगसंस्कारैः कालत्रितयगोचरैः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001468005, "chapter_id": 21468, "verse_number": "७-२-६-६", "content_sanskrit": "न तस्य कारणं कर्ता नादिरंतस्तथांतरम् ।\nन कर्म करणं वापि नाकार्यं कार्यमेव च॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001468006, "chapter_id": 21468, "verse_number": "७-२-६-७", "content_sanskrit": "नास्य बंधुरबंधुर्वा नियंता प्रेरको ऽपि वा ।\nन पतिर्न गुरुस्त्राता नाधिको न समस्तथा॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001468007, "chapter_id": 21468, "verse_number": "७-२-६-८", "content_sanskrit": "न जन्ममरणे तस्य न कांक्षितमकांक्षितम् ।\nन विधिर्न निषेधश्च न मुक्तिर्न च बन्धनम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001468008, "chapter_id": 21468, "verse_number": "७-२-६-९", "content_sanskrit": "नास्ति यद्यदकल्याणं तत्तदस्य कदाचन ।\nकल्याणं सकलं चास्ति परमात्मा शिवो यतः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001468009, "chapter_id": 21468, "verse_number": "७-२-६-१०", "content_sanskrit": "स शिवस्सर्वमेवेदमधिष्ठाय स्वशक्तिभिः ।\nअप्रच्युतस्स्वतो भावः स्थितः स्थाणुरतः स्मृतः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001468010, "chapter_id": 21468, "verse_number": "७-२-६-११", "content_sanskrit": "शिवेनाधिष्ठितं यस्माज्जगत्स्थावरजंगमम् ।\nसर्वरूपः स्मृतश्शर्वस्तथा ज्ञात्वा न मुह्यति॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001468011, "chapter_id": 21468, "verse_number": "७-२-६-१२", "content_sanskrit": "शर्वो रुद्रो नमस्तस्मै पुरुषः सत्परो महान् ।\nहिरण्यबाहुर्भगवान्हिरण्यपतिरीश्वरः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001468012, "chapter_id": 21468, "verse_number": "७-२-६-१३", "content_sanskrit": "अंबिकापतिरीशानः पिनाकी वृषवाहनः ।\nएको रुद्रः परं ब्रह्म पुरुषः कृष्णपिंगलः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001468013, "chapter_id": 21468, "verse_number": "७-२-६-१४", "content_sanskrit": "बालाग्रमात्रो हृन्मध्ये विचिंत्यो दहरांतरे ।\nहिरण्यकेशः पद्माक्षो ह्यरुणस्ताम्र एव च॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001468014, "chapter_id": 21468, "verse_number": "७-२-६-१५", "content_sanskrit": "यो ऽवसर्पत्य सौ देवो नीलग्रीवो हिरण्मयः ।\nसौम्यो घोरस्तथा मिश्रश्चाक्षारश्चामृतो ऽव्ययः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001468015, "chapter_id": 21468, "verse_number": "७-२-६-१६", "content_sanskrit": "स पुंविशेषः परमो भगवानन्तकांतकः ।\nचेतनचेतनोन्मुक्तः प्रपञ्चाच्च परात्परः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001468016, "chapter_id": 21468, "verse_number": "७-२-६-१७", "content_sanskrit": "शिवेनातिशयत्वेन ज्ञानैश्वर्ये विलोकिते ।\nलोकेशातिशयत्वेन स्थितं प्राहुर्मनीषिणः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001468017, "chapter_id": 21468, "verse_number": "७-२-६-१८", "content_sanskrit": "प्रतिसर्गप्रसूतानां ब्रह्मणां शास्त्रविस्तरम् ।\nउपदेष्टा स एवादौ कालावच्छेदवर्तिनाम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001468018, "chapter_id": 21468, "verse_number": "७-२-६-१९", "content_sanskrit": "कालावच्छेदयुक्तानां गुरूणामप्यसौ गुरुः ।\nसर्वेषामेव सर्वेशः कालावच्छेदवर्जितः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001468019, "chapter_id": 21468, "verse_number": "७-२-६-२०", "content_sanskrit": "शुद्धा स्वाभाविकी तस्य शक्तिस्सर्वातिशायिनी ।\nज्ञानमप्रतिमं नित्यं वपुरत्यन्तनिर्मितम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001468020, "chapter_id": 21468, "verse_number": "७-२-६-२१", "content_sanskrit": "ऐश्वर्यमप्रतिद्वंद्वं सुखमात्यन्तिकं बलम् ।\nतेजःप्रभावो वीर्यं च क्षमा कारुण्यमेव च॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001468021, "chapter_id": 21468, "verse_number": "७-२-६-२२", "content_sanskrit": "परिपूर्णस्य सर्गाद्यैर्नात्मनो ऽस्ति प्रयोजनम् ।\nपरानुग्रह एवास्य फलं सर्वस्य कर्मणः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001468022, "chapter_id": 21468, "verse_number": "७-२-६-२३", "content_sanskrit": "प्रणवो वाचकस्तस्य शिवस्य परमात्मनः ।\nशिवरुद्रादिशब्दानां प्रणवो हि परस्स्मृतः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001468023, "chapter_id": 21468, "verse_number": "७-२-६-२४", "content_sanskrit": "शंभो प्रणववाच्यस्य भवनात्तज्जपादपि ।\nया सिद्धिस्सा परा प्राप्या भवत्येव न संशयः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001468024, "chapter_id": 21468, "verse_number": "७-२-६-२५", "content_sanskrit": "तस्मादेकाक्षरं देवमाहुरागमपारगाः ।\nवाच्यवाचकयोरैक्यं मन्यमाना मनस्विनः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001468025, "chapter_id": 21468, "verse_number": "७-२-६-२६", "content_sanskrit": "अस्य मात्राः समाख्याताश्चतस्रो वेदमूर्धनि ।\nअकारश्चाप्युकारश्च मकारो नाद इत्यपि॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001468026, "chapter_id": 21468, "verse_number": "७-२-६-२७", "content_sanskrit": "अकारं बह्वृचं प्राहुरुकारो यजुरुच्यते ।\nमकारः सामनादोस्य श्रुतिराथर्वणी स्मृताः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001468027, "chapter_id": 21468, "verse_number": "७-२-६-२८", "content_sanskrit": "अकारश्च महाबीजं रजः स्रष्टा चतुर्मुखः ।\nउकारः प्रकृतिर्योनिः सत्त्वं पालयिता हरिः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001468028, "chapter_id": 21468, "verse_number": "७-२-६-२९", "content_sanskrit": "मकारः पुरुषो बीजं तमः संहारको हरः ।\nनादः परः पुमानीशो निर्गुणो निष्क्रियः शिवः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001468029, "chapter_id": 21468, "verse_number": "७-२-६-३०", "content_sanskrit": "सर्वं तिसृभिरेवेदं मात्राभिर्निखिलं त्रिधा ।\nअभिधाय शिवात्मानं बोधयत्यर्धमात्रया॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001468030, "chapter_id": 21468, "verse_number": "७-२-६-३१", "content_sanskrit": "यस्मात्परं नापरमस्ति किंचिद्यस्मान्नाणीयो न ज्यायो ऽस्ति किंचित् ।\nवृक्ष इव स्तब्धो दिवि तिष्ठत्येकस्तेनेदं पूर्णं पुरुषेण सर्वम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]