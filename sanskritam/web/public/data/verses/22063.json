[{"id": 7002063000, "chapter_id": 22063, "verse_number": "१०८-१", "content_sanskrit": "अग्निरुवाच ।\nजम्बूप्लक्षाह्वयौ द्वीपौ शाल्मलिश्चापरो महान् ।\nकुशः क्रौञ्चस्तथा शाकः पुष्करश्चेति सप्तमः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002063001, "chapter_id": 22063, "verse_number": "१०८-२", "content_sanskrit": "एते द्वीपाः समुद्रैस्तु सप्त सप्तभिरावृताः ।\nलवणेक्षुसुरासर्पिर्दधिदुग्धजलैः समं ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002063002, "chapter_id": 22063, "verse_number": "१०८-३", "content_sanskrit": "जम्बूद्वीपो द्वीपमध्ये तन्मध्ये मेरुरुच्छ्रितः ।\nचतुरशीतिसाहस्रो भूयिष्ठः षोडशाद्विराट् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002063003, "chapter_id": 22063, "verse_number": "१०८-४", "content_sanskrit": "द्वात्रिंशन्मूर्ध्नि विस्तरात्षोडशाधः सहस्रवान् ।\nभूयस्तस्यास्य शैलोऽसौ कर्णिकाकारसंस्थितः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002063004, "chapter_id": 22063, "verse_number": "१०८-५", "content_sanskrit": "हिमवान् हेमकूटश्च निषधश्चास्य दक्षिणे ।\nनीलः श्वेतश्च शृङ्गो च उत्तरे वर्षपर्वताः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002063005, "chapter_id": 22063, "verse_number": "१०८-६", "content_sanskrit": "लक्षप्रमाणौ द्वौ मध्ये दशहीनास्तथापरे ।\nसहस्रद्वितयोछ्रायास्तावद्विस्तारिणश्च ते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002063006, "chapter_id": 22063, "verse_number": "१०८-७", "content_sanskrit": "भारतं प्रथमं वर्षन्ततः किम्पुरुषं स्मृतं ।\nहरिवर्सन्तथैवान्यन्मेरोर्दक्षिणतो द्विज ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002063007, "chapter_id": 22063, "verse_number": "१०८-८", "content_sanskrit": "रम्यकं चोत्तरे वर्षं तथैवान्यद्धिरण्मयं ।\nउत्तराः कुरवश्चैव यथा वै भारतं तथा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002063008, "chapter_id": 22063, "verse_number": "१०८-९", "content_sanskrit": "नवसाहस्रमेकैकमेतेषां मुनिसत्तम ।\nइलावृतञ्च तन्मध्ये सौवर्णा मेरुरुछ्रितः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002063009, "chapter_id": 22063, "verse_number": "१०८-१०", "content_sanskrit": "मेरोश्चतुर्दिशन्तत्र नवसाहस्रविस्तृतं ।\nइलावृतं महाभाग चत्वारश्चात्र पर्वताः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002063010, "chapter_id": 22063, "verse_number": "१०८-११", "content_sanskrit": "विष्कम्भा रचिता मेरोर्योजनायुतविस्तृताः ।\nपूर्वेण मन्दरो नाम दक्षिणे गन्धमादनः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002063011, "chapter_id": 22063, "verse_number": "१०८-१२", "content_sanskrit": "विपुलः पश्चिमे पार्श्वे सुपार्श्वश्चोत्तरे स्मृतः ।\nकदम्बस्तेषु जम्बुश्च पिप्पलो बट एव च ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002063012, "chapter_id": 22063, "verse_number": "१०८-१३", "content_sanskrit": "एकादशशतायामाः पादपा गिरिकेतवः ।\nजम्बूद्वीपेति सञ्ज्ञा स्यात्फलं जम्बा गजोपमं ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002063013, "chapter_id": 22063, "verse_number": "१०८-१४", "content_sanskrit": "जम्बूनदीरसेनास्यास्त्विदं जाम्बूनदं परं ।\nसुपार्श्वः पूर्वतो मेरोः केतुमालस्तु पश्चिमे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002063014, "chapter_id": 22063, "verse_number": "१०८-१५", "content_sanskrit": "वनं चैत्ररथं पूर्वे दक्षिणे गन्धमादनः ।\nवैभ्राजं पश्चिमे सौम्ये नन्दनञ्च सरांस्यथ ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002063015, "chapter_id": 22063, "verse_number": "१०८-१६", "content_sanskrit": "अरुणोदं महाभद्रं संशितोदं समानसं ।\nशिताभश्चक्रमुञ्जाद्याः पूर्वतः केशराचलाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002063016, "chapter_id": 22063, "verse_number": "१०८-१७", "content_sanskrit": "दक्षिणेन्द्रेस्त्रिकूटाद्याः शिशिवासमुखा जले ।\nशङ्खकूटादयः सौम्ये मेरौ च ब्रह्मणः पुरी ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002063017, "chapter_id": 22063, "verse_number": "१०८-१८", "content_sanskrit": "चतुर्दशसहस्राणि योजनानाञ्च दिक्षु च ।\nइन्द्रादिलोकपालानां समन्तात्ब्रह्मणः पुरः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002063018, "chapter_id": 22063, "verse_number": "१०८-१९", "content_sanskrit": "विष्णुपादात्प्लावयित्वा चन्द्रं स्वर्गात्पतन्त्यपि ।\nपूर्वेण शीता भद्राश्वाच्छैलाच्छैलाद्गतार्णवं ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002063019, "chapter_id": 22063, "verse_number": "१०८-२०", "content_sanskrit": "तथैवालकनन्दापि दक्षिणेनैव भारतं ।\nप्रयाति सागरं कृत्वा सप्तभेदाथ पश्चिमं ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002063020, "chapter_id": 22063, "verse_number": "१०८-२१", "content_sanskrit": "अब्धिञ्च चक्षुःसौम्याब्धिं भद्रोत्तरकुरूनपि ।\nआनीलनिषधायामौ माल्यवद्गन्धमादनौ ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002063021, "chapter_id": 22063, "verse_number": "१०८-२२", "content_sanskrit": "तयोर्मध्यगतो मेरुः कर्णिकाकारसंस्थितः ।\nभारताः केतुमालाश्च भद्राश्वाः कुरवस्तथा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002063022, "chapter_id": 22063, "verse_number": "१०८-२३", "content_sanskrit": "पत्राणि लोकपद्मस्य मर्यादाशैलवाह्यतः ।\nजठरो देवकूटश्च मर्यादापर्वतावुभौ ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002063023, "chapter_id": 22063, "verse_number": "१०८-२४", "content_sanskrit": "तौ दक्षिणोत्तरायामावानीलनिषधायतौ ।\nगन्धमादनकैलासौ पूर्ववचायतावुभौ ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002063024, "chapter_id": 22063, "verse_number": "१०८-२५", "content_sanskrit": "अशीतियोजनायामावर्णवान्तर्व्यवस्थितौ ।\nनिषधः पारिपात्रश्च मर्यादापर्वतावुभौ ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002063025, "chapter_id": 22063, "verse_number": "१०८-२६", "content_sanskrit": "मेरोः पश्चिमदिग्भागे यथा पूर्वे तथा स्थितौ ।\nत्रिशृङ्गो रुधिरश्चैव उत्तरौ वर्षपर्वतौ ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002063026, "chapter_id": 22063, "verse_number": "१०८-२७", "content_sanskrit": "पूर्वपञ्चायतावेतावर्णवान्तर्व्यवस्थितौ ।\nजाठराद्याश्च मर्यादाशैला मेरोश्चतुर्दिशं ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002063027, "chapter_id": 22063, "verse_number": "१०८-२८", "content_sanskrit": "केशरादिषु या द्रोण्यस्तासु सन्ति पुराणि हि ।\nलक्ष्मीविष्ण्वग्निसूर्यादिदेवानां मुनिसत्तम ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002063028, "chapter_id": 22063, "verse_number": "१०८-२९", "content_sanskrit": "भौमानां स्वर्गधर्माणां न पापास्तत्र यान्ति च ।\nभद्राश्वेऽस्ति हयग्रीवो वराहः केतुमालके ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002063029, "chapter_id": 22063, "verse_number": "१०८-३०", "content_sanskrit": "भारते कूर्मरूपी च मत्स्यरूपः कुरुष्वपि ।\nविश्वरूपेण सर्वत्र पूज्यते भगवान् हरिः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002063030, "chapter_id": 22063, "verse_number": "१०८-३१", "content_sanskrit": "किम्पुरुषाद्यष्टसु क्षुद्भीतिशोकादिकं न च ।\nचत्तुर्विंशतिसाहस्रं प्रजा जीवन्त्यनामयाः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002063031, "chapter_id": 22063, "verse_number": "१०८-३२", "content_sanskrit": "कृतादिकल्पना नास्ति भौमान्यम्भांसि नाम्बुदाः ।\nसर्वेष्वेतेषु वर्षेषु सप्त सप्त कुलाचलाः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002063032, "chapter_id": 22063, "verse_number": "१०८-३३", "content_sanskrit": "नद्यश्च शतशस्तेभ्यस्तीर्थभूताः प्रजज्ञिरे ।\nभारते यानि नीर्थानि तानि तीर्थानि वच्मि ते ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]