[{"id": 2039545, "chapter_id": 1872, "verse_number": "५-११७-०x", "content_sanskrit": "गालव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2039546, "chapter_id": 1872, "verse_number": "५-११७-१", "content_sanskrit": "महावीर्यो महीपालः काशीनामीश्वरः प्रभुः।\nदिवोदास इति ख्यातो भैमसेनिर्नराधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2039547, "chapter_id": 1872, "verse_number": "५-११७-२", "content_sanskrit": "तत्र गच्छावहे भद्रे शनैरागच्छ मा शुचः ।\nधार्मिकः संयमे युक्तः सत्ये चैव जनेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2039548, "chapter_id": 1872, "verse_number": "५-११७-३x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2039549, "chapter_id": 1872, "verse_number": "५-११७-३", "content_sanskrit": "तमुपागम्य स मुनिर्न्यायतस्तेन सत्कृतः।\nगालवः प्रसवस्यार्थे तं नृपं प्रत्यचोदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2039550, "chapter_id": 1872, "verse_number": "५-११७-४x", "content_sanskrit": "दिवोदाम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2039551, "chapter_id": 1872, "verse_number": "५-११७-४", "content_sanskrit": "श्रुतमेतन्मया पूर्वं किमुक्त्वा विस्तरं द्विज।\nकाङ्क्षितो हि मयैषोऽर्थः श्रुत्वैव द्विजसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2039552, "chapter_id": 1872, "verse_number": "५-११७-५", "content_sanskrit": "एतच्च मे बहुमतं यदुत्सृज्य नराधिपान्।\nमामेवमुपयातोऽसि भावि चैतदसंशयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2039553, "chapter_id": 1872, "verse_number": "५-११७-६", "content_sanskrit": "स एव विभवोऽसमाकमश्वानामपि गालव।\nअहमप्येकमेवास्यां जनयिष्यामि पार्थिवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2039554, "chapter_id": 1872, "verse_number": "५-११७-७x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2039555, "chapter_id": 1872, "verse_number": "५-११७-७", "content_sanskrit": "तथेत्युक्त्वा द्विजश्रेष्ठः प्रादात्कन्यां महीपतेः।\nविधिपूर्वां च तां राजा कन्यां प्रतिगृहीतवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2039556, "chapter_id": 1872, "verse_number": "५-११७-८", "content_sanskrit": "रेमे स तस्यां राजर्षिः प्रभावत्यां यथा रविः।\nस्वाहायां च यथा वह्निर्यथा शाच्यां च वासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2039557, "chapter_id": 1872, "verse_number": "५-११७-९", "content_sanskrit": "यथा चन्द्रश्च रोहिण्यां यथा धूमोर्णया यमः।\nवरुणश्च यथा गौर्यां यथा चर्ध्यां धनेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2039558, "chapter_id": 1872, "verse_number": "५-११७-१०", "content_sanskrit": "यथा नारायणो लक्ष्म्यां जाह्नव्यां च यथोदधिः ।\nयथा रुद्रश्च रुद्राण्यां यथा वेद्यां पितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2039559, "chapter_id": 1872, "verse_number": "५-११७-११", "content_sanskrit": "अदृश्यन्त्यां च वासिष्ठो वसिष्ठश्चाक्षमालया।\nच्यवनश्च सुकन्यायां पुलस्त्यः सन्ध्यया यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2039560, "chapter_id": 1872, "verse_number": "५-११७-१२", "content_sanskrit": "अगस्त्यश्चापि वैदर्भ्यां सावित्र्यां सत्यवान्यथा।\nयथा भृगुः पुलोमायामदित्यां कश्यपो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2039561, "chapter_id": 1872, "verse_number": "५-११७-१३", "content_sanskrit": "रेणुकायां यथार्चीको हैमवत्यां च कौशिकः।\nबृहस्पतिश्च तारायां शुक्रश्च शतपर्वणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2039562, "chapter_id": 1872, "verse_number": "५-११७-१४", "content_sanskrit": "यथा भूम्यां भूमिपतिरुर्वश्यां च पुरूरवाः।\nऋचीकः सत्यवत्यां च सरस्वस्यां यथा मनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2039563, "chapter_id": 1872, "verse_number": "५-११७-१५", "content_sanskrit": "शकुन्तलायां दुष्यन्तो धृत्यां धर्मश्च शाश्वतः।\nदमयन्त्यां नलश्चैव सत्यवत्यां च नारदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2039564, "chapter_id": 1872, "verse_number": "५-११७-१६", "content_sanskrit": "जरत्कारुर्जरत्कार्वां पुलस्त्यश्च प्रतीच्यया।\nमेनकायां यथोर्णायुस्तुम्बुरुश्चैव रम्भया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2039565, "chapter_id": 1872, "verse_number": "५-११७-१७", "content_sanskrit": "वासुकिः शतशीर्षायां कुमार्यां च धनञ्जयः।\nवैदेह्यां च यथा रामो रुक्मिण्यां च जनार्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2039566, "chapter_id": 1872, "verse_number": "५-११७-१८", "content_sanskrit": "तथा तु रममाणस्य दिवोदासस्य भूपतेः ।\nमाधवी जनयामास पुत्रमेकं प्रतर्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2039567, "chapter_id": 1872, "verse_number": "५-११७-१९", "content_sanskrit": "अथाजगाम भगवान्दिवोदासं स गालवः ।\nसमये समनुप्राप्ते वचनं चेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2039568, "chapter_id": 1872, "verse_number": "५-११७-२०", "content_sanskrit": "निर्यातयतु मे कन्यां भवांस्तिष्ठन्तु वाजिनः ।\nयावदन्यत्र गच्छामि शुल्कार्थं पृथिवीपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2039569, "chapter_id": 1872, "verse_number": "५-११७-२१x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2039570, "chapter_id": 1872, "verse_number": "५-११७-२१", "content_sanskrit": "दिवोदासोऽथ धर्मात्मा समये गालवस्य ताम्।\nकान्यां निर्यातयामास स्थितः सत्ये महीपतिः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2039571, "chapter_id": 1872, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि सप्तदशाधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]