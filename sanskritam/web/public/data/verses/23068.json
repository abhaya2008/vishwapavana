[{"id": 7003068000, "chapter_id": 23068, "verse_number": "४-२-१", "content_sanskrit": "श्रीनारायण उवाच ।\nयेन वा प्रार्थितः कृष्ण आजगाम महीतलम्।\nयं यं विधाय भूमौ स जगाम स्वालयं विभुः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003068001, "chapter_id": 23068, "verse_number": "४-२-२", "content_sanskrit": "भारावतरणोपायं दुष्टानां च वधोद्यमम् ।\nसर्वं ते कथयिष्यामि सुविचार्य विधानतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003068002, "chapter_id": 23068, "verse_number": "४-२-३", "content_sanskrit": "अधुना गोपवेषं च गोकुलागमनं हरेः ।\nराधा गोपालिका येन निबोध कथयामि ते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003068003, "chapter_id": 23068, "verse_number": "४-२-४", "content_sanskrit": "शंखचूडवधं पूर्वं संक्षेपात्कथितं श्रुतम् ।\nअधुना तत्सुविस्तार्य निबोध कथयामि ते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003068004, "chapter_id": 23068, "verse_number": "४-२-५", "content_sanskrit": "श्रीदाम्नः कलहश्चैव बभूव राधया सह ।\nश्रीदामा शंखचूडश्च शापात्तस्या बभूव ह ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003068005, "chapter_id": 23068, "verse_number": "४-२-६", "content_sanskrit": "राधां शशाप श्रीदामा याहि योनिं च मानवीम् ।\nव्रजे व्रजांगना भूत्वा विचरस्व महीतले ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003068006, "chapter_id": 23068, "verse_number": "४-२-७", "content_sanskrit": "भीता श्रीदामशापात्सा श्रीकृष्णं समुवाच ह ।\nगोपीरूपा भविष्यामि श्रीदामा मां शशाप ह ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003068007, "chapter_id": 23068, "verse_number": "४-२-८", "content_sanskrit": "कमुपायं करिष्यामि वद मां भयभंजन ।\nत्वया विना कथमहं धरिष्यामि स्वजीवनम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003068008, "chapter_id": 23068, "verse_number": "४-२-९", "content_sanskrit": "क्षणमेकं युगशतं कालनाथ त्वया विना ।\nचक्षुर्निमेषविरहाद्भवेदंधं मनो मम ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003068009, "chapter_id": 23068, "verse_number": "४-२-१०", "content_sanskrit": "शरत्पार्वणचंद्राभं क्षुधापूर्णाननं तव ।\nनाथ चक्षुञ्चकोराभ्यां पिबाम्यहमहर्निश म् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003068010, "chapter_id": 23068, "verse_number": "४-२-११", "content_sanskrit": "त्वमात्मा मे मनः प्राणा देहमात्रं वहाम्यहम् ।\nदृष्टिशक्तिश्च चक्षुस्त्वं जीवनं परमं धनम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003068011, "chapter_id": 23068, "verse_number": "४-२-१२", "content_sanskrit": "स्वप्ने ज्ञाने त्वयि मनः स्मरामि त्वत्पदांबुजम् ।\nतव दास्यं विना नाथ न जीवामि क्षणं विभो ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003068012, "chapter_id": 23068, "verse_number": "४-२-१३", "content_sanskrit": "कृष्णस्तद्वचनं श्रुत्वा बोधयामास सुंदरीम् ।\nवक्षसि प्रेयसीं कृत्वा चकार निर्भयां च ताम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003068013, "chapter_id": 23068, "verse_number": "४-२-१४", "content_sanskrit": "महीतलं गमिष्यामि वाराहे च वरानने ।\nमया सार्धं भूगमनं जन्म तेऽपि निरूपितम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003068014, "chapter_id": 23068, "verse_number": "४-२-१५", "content_sanskrit": "व्रजं गत्वा व्रजे देवि विहरिष्यामि कानने ।\nमम प्राणाधिका त्वं च भयं किं ते मयि स्थिते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003068015, "chapter_id": 23068, "verse_number": "४-२-१६", "content_sanskrit": "तामित्युक्त्वा हरिस्तत्र विरराम जगत्पतिः ।\nअतो हेतोर्जगन्नाथो जगाम नंदगोकुल म्१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003068016, "chapter_id": 23068, "verse_number": "४-२-१७", "content_sanskrit": "किं वा तस्य भयं कंसाद्भयांतकारकस्य च ।\nमाया भयच्छलेनैव जगाम राधिकांतिकम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003068017, "chapter_id": 23068, "verse_number": "४-२-१८", "content_sanskrit": "विजहार तया सार्धं गोपवेषं विधाय सः ।\nसह गोपांगनाभिश्च प्रतिज्ञापालनाय च ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003068018, "chapter_id": 23068, "verse_number": "४-२-१९", "content_sanskrit": "ब्रह्मणा प्रार्थितः कृष्णः समागत्य महीतलम् ।\nभारावतरणं कृत्वा जगाम स्वालयं विभुः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003068019, "chapter_id": 23068, "verse_number": "४-२-२०", "content_sanskrit": "नारद उवाच ।\nश्रीदाम्नः कलहश्चैव कथं वा राधया सह ।\nसंक्षेपात्कथितं पूर्वं संव्यस्य कथयाधुना ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003068020, "chapter_id": 23068, "verse_number": "४-२-२१", "content_sanskrit": "श्रीनारायण उवाच ।\nएकदा राधया सार्धं गोलोके श्रीहरिः स्वयम् ।\nविजहार महारण्ये निर्जने रासमंडले ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003068021, "chapter_id": 23068, "verse_number": "४-२-२२", "content_sanskrit": "राधिकासुखसंभोगाद् बुबुधे न स्वकं परम्। ।\nकृत्वा विहारं श्रीकृष्णस्तामपृष्ट्वा विहाय च ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003068022, "chapter_id": 23068, "verse_number": "४-२-२३", "content_sanskrit": "गोपिकां विरजामन्यां शृङ्गारार्थं जगाम ह ।\nवृंदारण्ये च विरजा सुभगा राधिकासमा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003068023, "chapter_id": 23068, "verse_number": "४-२-२४", "content_sanskrit": "तस्या वयस्याः सुंदर्यो गोपीनां शतकोटयः ।\nकृष्णप्राणाधिका गोपी धन्या मान्या च योषिताम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003068024, "chapter_id": 23068, "verse_number": "४-२-२५", "content_sanskrit": "रत्नसिंहासनस्था सा ददर्श हरिमन्तिके। ।\nददर्श श्रीहरिस्तां च शरच्चंद्रनिभाननाम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003068025, "chapter_id": 23068, "verse_number": "४-२-२६", "content_sanskrit": "मनोहरां सस्मितां च पश्यंतीं वक्रचक्षुषा ।\nसदा षोडशवर्षीयां प्रोद्भिन्ननवयौवनाम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003068026, "chapter_id": 23068, "verse_number": "४-२-२७", "content_sanskrit": "रत्नालंकारशोभाढ्यां भूषितां शुक्लवाससा ।\nपुलकांकितसर्वांगीं कामबाणप्रपीडिताम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003068027, "chapter_id": 23068, "verse_number": "४-२-२८", "content_sanskrit": "दृष्ट्वा तां श्रीहरिस्तूर्णं विजहार तया सह ।\nपुष्पतल्पे महारण्ये निर्जने रत्नमंडपे ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003068028, "chapter_id": 23068, "verse_number": "४-२-२९", "content_sanskrit": "मूर्च्छामवाप विरजा कृष्णशृंगारकौतुकात् ।\nकृत्वा वक्षसि प्राणेशं कोटिकंदर्पसन्निभम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003068029, "chapter_id": 23068, "verse_number": "४-२-३०", "content_sanskrit": "तया सक्तं श्रीहरिं च रत्नमंडपसंस्थितम् ।\nदृष्ट्वा च राधिकाल्यश्च चक्रुस्तां च निवेदनम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003068030, "chapter_id": 23068, "verse_number": "४-२-३१", "content_sanskrit": "तासां च वचनं श्रुत्वा सुष्वाप च चुकोप ह ।\nभृशं रुरोद सा देवी   रक्तपंकजलोचना ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003068031, "chapter_id": 23068, "verse_number": "४-२-३२", "content_sanskrit": "ता उवाच महादेवी मां तं दर्शयितुं क्षमाः ।\nयदि सत्यं ब्रूत यूयं मया सार्धं प्रगच्छत ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003068032, "chapter_id": 23068, "verse_number": "४-२-३३", "content_sanskrit": "करिष्यामि फलं गोप्याः कृष्णस्य च यथोचितम् ।\nको रक्षिताऽद्य तस्याश्च मयि शास्तिं प्रकुर्वति ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003068033, "chapter_id": 23068, "verse_number": "४-२-३४", "content_sanskrit": "शीघ्रमानयताल्यश्च तया सार्द्धं हरिं प्रियम् ।\nअंतर्वक्त्रं सस्मितं च विषकुंभं सुधामुखम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003068034, "chapter_id": 23068, "verse_number": "४-२-३५", "content_sanskrit": "मदाश्रयं समागंतुं यूयं दासं न दास्यथ ।\nतमेव मंडपं रम्यं यात संरक्षतेश्वरम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003068035, "chapter_id": 23068, "verse_number": "४-२-३६", "content_sanskrit": "राधिकावचनं श्रुत्वा काश्चिद्गोप्यो भयान्विताः ।\nताः सर्वाः संपुटांजल्यो भक्तिनम्रात्मकंधराः ।\nतामूचुः पुरतः स्थित्वा सर्वा एव प्रियां सतीम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003068036, "chapter_id": 23068, "verse_number": "४-२-३७", "content_sanskrit": "आल्य ऊचुः ।\nवयं तं दर्शयिष्यामो विरजासहितं विभुम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003068037, "chapter_id": 23068, "verse_number": "४-२-३८", "content_sanskrit": "तासां च वचनं श्रुत्वा रथमारुह्य सुंदरी ।\nजगाम सार्धं गोपीभिस्त्रिषष्टिशतकोटिभिः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003068038, "chapter_id": 23068, "verse_number": "४-२-३९", "content_sanskrit": "रत्नेंद्रसाररचितं कोटिसूर्यसमप्रभम् ।\nमणींद्रसाररचितं कलशानां त्रिकोटिभिः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003068039, "chapter_id": 23068, "verse_number": "४-२-४०", "content_sanskrit": "राजितं चित्रराजीभिर्वैजयंतीविराजितम् ।\nलक्षचक्रसमायुक्तं मनोयायि मनोहरम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003068040, "chapter_id": 23068, "verse_number": "४-२-४१", "content_sanskrit": "मणिसारविकारैश्च कोटिस्तंभैः सुशोभितम् ।\nनानाचित्रविचित्रैश्च सहितैः सुमनोहरैः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003068041, "chapter_id": 23068, "verse_number": "४-२-४२", "content_sanskrit": "सिंदूराकारमणिभिर्मध्यदेशे विभूषितैः ।\nरत्नकृत्रिमसिंहैश्च रथचक्रोर्ध्वसंस्थितैः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003068042, "chapter_id": 23068, "verse_number": "४-२-४३", "content_sanskrit": "चतुर्लक्षपरिमितैश्चित्रघंटासमन्वितैः ।\nचित्रपुत्तलिशोभाढ्यैर्विचित्रैश्च विराजितम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003068043, "chapter_id": 23068, "verse_number": "४-२-४४", "content_sanskrit": "रतिमंदिरलक्षैश्च रत्नसारविनिर्मितैः ।\nमणिसारकपाटैश्च शोभितैश्चित्रवाजिभिः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003068044, "chapter_id": 23068, "verse_number": "४-२-४५", "content_sanskrit": "मणींद्रसारकलशैः शेखरोज्ज्वलितैर्युतम् ।\nभोगद्रव्यसमायुक्तं वेषद्रव्यसमन्वितम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003068045, "chapter_id": 23068, "verse_number": "४-२-४६", "content_sanskrit": "शोभितं रत्नशय्याभी रत्नपात्रघटान्वितम् ।\nहरिन्मणीनां वेदीनां समूहेन समन्वितम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003068046, "chapter_id": 23068, "verse_number": "४-२-४७", "content_sanskrit": "कुंकुमाभमणीनां च सोपानैः कोटिभिर्युतम् ।\nस्यमंतकैः कौस्तुभैश्च रुचकैः प्रवरैस्तथा ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003068047, "chapter_id": 23068, "verse_number": "४-२-४८", "content_sanskrit": "पद्मकृत्रिमकोटीनां शतकैश्च सुशोभितम् ।\nचित्रकाननवापीभि र्विशिष्टाभिर्विराजितम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003068048, "chapter_id": 23068, "verse_number": "४-२-४९", "content_sanskrit": "रत्नेंद्रसाररचितकलशोज्ज्वलशेखरम् ।\nशतयोजनमूर्ध्वं च दशयोजनविस्तृतम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003068049, "chapter_id": 23068, "verse_number": "४-२-५०", "content_sanskrit": "पारिजातप्रसूनानां मालाकोटिविराजितम् ।\nकुंदाना करवीराणां यूथिकानां तथैव च ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003068050, "chapter_id": 23068, "verse_number": "४-२-५१", "content_sanskrit": "सुचारुचंपकानां च नागेशानां मनोहरैः ।\nमल्लिकानां मालतीनां माधवीनां सुगंधिनाम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003068051, "chapter_id": 23068, "verse_number": "४-२-५२", "content_sanskrit": "कदंबानां च मालानां कदंबैश्च विराजितम् ।\nसहस्रदलपद्मानां मालाभिश्च विराजितम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003068052, "chapter_id": 23068, "verse_number": "४-२-५३", "content_sanskrit": "चित्रपुष्पोद्यानसरः काननैश्च विभूषितम् ।\nसर्वेषां स्यंदनानां च श्रेष्ठं वायुवहं परम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003068053, "chapter_id": 23068, "verse_number": "४-२-५४", "content_sanskrit": "तत्सूक्ष्मवस्त्रसाराणां वरैराच्छादितं परम् ।\nरत्नदर्पणलक्षाणां शतकैश्च समन्वितम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003068054, "chapter_id": 23068, "verse_number": "४-२-५५", "content_sanskrit": "श्वेतचामरकोटीभिर्वज्रकोटिभिरन्वितम् ।\nचन्दनागरुकस्तूरीकुंकुमद्रवचर्चितैः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003068055, "chapter_id": 23068, "verse_number": "४-२-५६", "content_sanskrit": "पारिजातप्रसूनानां कोटितल्पविराजितम् ।\nकोटिघंटासमायुक्तं पताकाकोटिभिर्युतम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003068056, "chapter_id": 23068, "verse_number": "४-२-५७", "content_sanskrit": "रत्नशय्याकोटिभिश्च चित्रवज्रपरिच्छदैः ।\nचंदनाक्तैश्चंपकानां कुंकुमैश्च विचित्रितैः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003068057, "chapter_id": 23068, "verse_number": "४-२-५८", "content_sanskrit": "पुष्पोपधानसंयुक्तैः शृंगारार्हाभिरन्वितम् ।\nअदृश्यैरश्रुतैर्द्रव्यैः सुंदरैश्च विभूषितम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003068058, "chapter_id": 23068, "verse_number": "४-२-५९", "content_sanskrit": "एवंभूताद्रथात्तूर्णमवरुह्य हरिप्रिया ।\nजगाम सहसा देवी तं रत्नमंडपं मुने ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003068059, "chapter_id": 23068, "verse_number": "४-२-६०", "content_sanskrit": "द्वारे नियुक्तं ददृशे द्वारपालं मनोहरम् ।\nलक्षगोपैः परिवृतं स्मेराननसरोरुहम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003068060, "chapter_id": 23068, "verse_number": "४-२-६१", "content_sanskrit": "गोपं श्रीदामनामानं श्रीकृष्णप्रियकिंकरम् ।\nतमुवाच रुषा देवी रक्तपंकजलोचना ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003068061, "chapter_id": 23068, "verse_number": "४-२-६२", "content_sanskrit": "गच्छ दूरं गच्छ दूरं रतिलंपटकिंकर ।\nकीदृशीं मत्परां कांतां द्रक्ष्यामि त्वत्प्रभोरहम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003068062, "chapter_id": 23068, "verse_number": "४-२-६३", "content_sanskrit": "राधिकावचनं श्रुत्वा निःशंकः पुरतः स्थितः ।\nतामेव न ददौ गंतुं वेत्रपाणिर्महाबलः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003068063, "chapter_id": 23068, "verse_number": "४-२-६४", "content_sanskrit": "तूर्णं च राधिकाल्यश्च श्रीदामानं सकिंकरम् ।\nबलेन प्रेरयामासुः कोपेन स्फुरिताधराः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003068064, "chapter_id": 23068, "verse_number": "४-२-६५", "content_sanskrit": "श्रुत्वा कोलाहलं शब्दं गोपिकानां हरिः स्वयम् ।\nज्ञात्वा च कोपितां राधामंतर्धानं चकार ह ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003068065, "chapter_id": 23068, "verse_number": "४-२-६६", "content_sanskrit": "विरजा राधिकाशब्दादंतर्धानं हरेरपि ।\nदृष्ट्वा राधां भयार्ता सा जहौ प्राणांश्च योगतः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003068066, "chapter_id": 23068, "verse_number": "४-२-६७", "content_sanskrit": "सद्यस्तत्र सरिद्रूपं तच्छरीरं बभूव ह ।\nव्याप्तं च वर्तुलाकारं तया गोलोकमेव च ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003068067, "chapter_id": 23068, "verse_number": "४-२-६८", "content_sanskrit": "कोटियोजनविस्तीर्णं प्रस्थेऽतिनिम्नमेव च ।\nदैर्घ्ये दशगुणं चारु नानारत्नाकरं परम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]