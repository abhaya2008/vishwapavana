[{"id": 7003712000, "chapter_id": 23712, "verse_number": "१-४-२०-१", "content_sanskrit": "मार्कंडेय उवाच ।\nअहो महिषदैत्यस्य दुराचारत्वमीदृशम् ।\nअहो दुरितहारिण्या दुर्गायाश्च पराक्रमः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003712001, "chapter_id": 23712, "verse_number": "१-४-२०-२", "content_sanskrit": "एवं तया भद्रकाल्या निहते महिषासुरे ।\nकिं चकार गिरींद्रस्य नंदिनी तपसि स्थिता ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003712002, "chapter_id": 23712, "verse_number": "१-४-२०-३", "content_sanskrit": "नंदिकेश्वर उवाच ।\nअनंतरं सा हस्तेन दधती दैत्यमस्तकम् ।\nननाम गौरीमन्येन पाणिना खङ्गधारिणा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003712003, "chapter_id": 23712, "verse_number": "१-४-२०-४", "content_sanskrit": "अथ हर्षेण नृत्यंतीं तामालोक्य दयार्द्रया ।\nदृष्ट्या देवी जगादैनां दंतांशुद्योतितांबरा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003712004, "chapter_id": 23712, "verse_number": "१-४-२०-५", "content_sanskrit": "त्वयातिदुष्करं कर्म निर्मितं विंध्यवासिनि ।\nजातं तव प्रभावेन निष्प्रत्यूहं च मे तपः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003712005, "chapter_id": 23712, "verse_number": "१-४-२०-६", "content_sanskrit": "अथैतन्माहिषं शीर्षमपवित्र भयंकरम् ।\nजगत्पवित्रचारित्रे त्यक्तुमर्हसि हस्ततः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003712006, "chapter_id": 23712, "verse_number": "१-४-२०-७", "content_sanskrit": "इति गौर्योदिता दुर्गा जुगुप्साकुलमानसा ।\nमूर्ध्नस्तस्य निपाताय व्यधुनोद्बहुशः करम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003712007, "chapter_id": 23712, "verse_number": "१-४-२०-८", "content_sanskrit": "तीर्थमुत्पाद्यतां देवि नवं पापविनाशनम् ।\nतस्मिन्निमज्जनाद्दुर्गे प्रायश्चित्तं भविष्यति ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003712008, "chapter_id": 23712, "verse_number": "१-४-२०-९", "content_sanskrit": "इतीरिता गौतमेन दुर्गा दुरितशंकिनी ।\nपाटयामास खङ्गेन शिलापट्टं पटीयसा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003712009, "chapter_id": 23712, "verse_number": "१-४-२०-१०", "content_sanskrit": "पातालावधि निर्भिन्नात्पाषाणतलतस्ततः ।\nउदजृंभत्तरंगांभः सच्चित्तमिव निर्मलम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003712010, "chapter_id": 23712, "verse_number": "१-४-२०-११", "content_sanskrit": "ममज्ज सापि गंभीरे तस्मिन्नंभसि पावने ।\nनमः शोणाद्रिनाथायेत्युक्त्वा मंत्रमनुत्तमम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003712011, "chapter_id": 23712, "verse_number": "१-४-२०-१२", "content_sanskrit": "तावन्महिषकंठस्थं लिंगं तद्गलितं तले ।\nतटे प्रतिष्ठितं जातं पापनाशनसंज्ञया ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003712012, "chapter_id": 23712, "verse_number": "१-४-२०-१३", "content_sanskrit": "उन्ममज्ज ततो दुर्गा तीर्थांभोधूतकल्मषा ।\nनिपपाताथ तत्पाणेर्महिषासुरमस्तकम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003712013, "chapter_id": 23712, "verse_number": "१-४-२०-१४", "content_sanskrit": "कृतप्रदक्षिणा नत्वा पापनाशनमीश्वरम् ।\nपुरस्तादस्ति सा गौर्या गौतमेनाभिनंदिता ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003712014, "chapter_id": 23712, "verse_number": "१-४-२०-१५", "content_sanskrit": "एवं प्रत्यक्षनिरतपापां तां वीक्ष्य पार्वती ।\nजगाद दीर्घतपसं जगतीधरनंदिनी ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003712015, "chapter_id": 23712, "verse_number": "१-४-२०-१६", "content_sanskrit": "महिषासुरसंहारेंऽजसा स्वनुमतिः कृता ।\nविंध्यवासिनीयमहो दुष्टमाहिषविग्रहम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003712016, "chapter_id": 23712, "verse_number": "१-४-२०-१७", "content_sanskrit": "गृहीत्वा भक्षयामास तस्य लिंगमिदं शिवम् ।\nप्रायश्चित्तं ततो ब्रूहि ममापि मुनिसत्तम ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003712017, "chapter_id": 23712, "verse_number": "१-४-२०-१८", "content_sanskrit": "गौतम उवाच ।\nदेवि सर्वजगत्सर्गस्थितिसंहारकारिणि ।\nत्वद्ध्यानमेव जगतां सर्वपातकनाशनम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003712018, "chapter_id": 23712, "verse_number": "१-४-२०-१९", "content_sanskrit": "अथापि लौकिकं वृत्तमवलंब्य त्वयेरितम् ।\nस्वकृतापि हि मर्यादा न महद्भिर्विलंघ्यते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003712019, "chapter_id": 23712, "verse_number": "१-४-२०-२०", "content_sanskrit": "अन्तःकरणकालुष्यक्षालिनी काचन क्रिया ।\nकथ्यतेऽद्य मया मातरवधानं विधीयताम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003712020, "chapter_id": 23712, "verse_number": "१-४-२०-२१", "content_sanskrit": "अरुणाद्रिरयं साक्षादनलाद्रिस्तिरोहितः ।\nज्वलतिज्योतिषा स्वेन कृत्तिकापूर्णिमा निशि ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003712021, "chapter_id": 23712, "verse_number": "१-४-२०-२२", "content_sanskrit": "तत्सपर्यातपश्चर्या कार्या कात्यायनि त्वया ।\nतज्ज्योतिर्दर्शनात्सर्वमभीष्टं तव सिध्यति ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003712022, "chapter_id": 23712, "verse_number": "१-४-२०-२३", "content_sanskrit": "इत्युक्ता गौतमेनांबा तदाप्रभृति दारुणा ।\nइयं च शिवभक्ता हि शिवपूजारता तदा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003712023, "chapter_id": 23712, "verse_number": "१-४-२०-२४", "content_sanskrit": "तपश्चचार पंचानामग्नीनां मध्यमाश्रिता ।\nचतुर्णां शिखिनां मध्ये स्थिता सूर्यनिविष्टदृक् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003712024, "chapter_id": 23712, "verse_number": "१-४-२०-२५", "content_sanskrit": "रेजे हैमी शलाकेव द्योतमाना गिरींद्रजा ।\nअथाकृष्टेवपार्वत्याः प्रेमपाशैर्निरायतैः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003712025, "chapter_id": 23712, "verse_number": "१-४-२०-२६", "content_sanskrit": "सा कार्त्तिकी पौर्णमासी समापेदे शुभा तिथिः ।\nततस्तस्य दिनस्यांते शृंगे शोणमहीभृतः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003712026, "chapter_id": 23712, "verse_number": "१-४-२०-२७", "content_sanskrit": "अदर्शि किमपि ज्योतिरनुपाधिकवैभवम् ।\nतदर्थोपगतैर्ब्रह्ममधुभिद्वासवादिभिः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003712027, "chapter_id": 23712, "verse_number": "१-४-२०-२८", "content_sanskrit": "उपास्यमानमभितो देवैर्दिव्यर्षिसंगतैः ।\nतदनिंधनमस्नेहमदशावर्तिसंभवम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003712028, "chapter_id": 23712, "verse_number": "१-४-२०-२९", "content_sanskrit": "महाप्रदीपमालोक्य विस्मयं प्राप पार्वती ।\nकृतप्रदक्षिणा साथ प्रणमंती पदेपदे ।\nअरुणाद्रीश्वरं नाथं तुष्टा तुष्टाव शैलजा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003712029, "chapter_id": 23712, "verse_number": "१-४-२०-३०", "content_sanskrit": "नमस्ते मेरुचापाय कैलासाचलवासिने ।\nनीहारशैलजामात्रे शोणक्ष्माधररूपिणे ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003712030, "chapter_id": 23712, "verse_number": "१-४-२०-३१", "content_sanskrit": "वरुणादिसुरार्च्याय तरुणादित्यवर्चसे ।\nअरुणाचलनाथाय करुणामूर्त्तये नमः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003712031, "chapter_id": 23712, "verse_number": "१-४-२०-३२", "content_sanskrit": "जय जह्नुसुताचन्द्र लेखालंकृतशेखर ।\nसौंदर्यमोहिताशेषमुनिपत्नीजनाशय ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003712032, "chapter_id": 23712, "verse_number": "१-४-२०-३३", "content_sanskrit": "जय शैलसुतासंगसंभृतानंगवैभव ।\nमाया नारायणाभोगक्रीडाम्रेडनपंडित ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003712033, "chapter_id": 23712, "verse_number": "१-४-२०-३४", "content_sanskrit": "जय संध्यासमोपेतसंभृतानंदतांडव ।\nजय गीर्वाणगंधर्वसिद्धविद्याधरार्चित ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003712034, "chapter_id": 23712, "verse_number": "१-४-२०-३५", "content_sanskrit": "जय हेरंबजनक जय षण्मुखवत्सल ।\nजय हैमवतीप्रार्थ्य जय पार्थिवदुर्लभ ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003712035, "chapter_id": 23712, "verse_number": "१-४-२०-३६", "content_sanskrit": "इति स्तुत्वा मुहुस्तस्मिञ्ज्योतिषि न्यस्तलोचनाम् ।\nदृष्ट्वा देवीं दयाव्याजाद्विलिल्ये वृषभध्वजः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003712036, "chapter_id": 23712, "verse_number": "१-४-२०-३७", "content_sanskrit": "लयित्वा निजमास्थाय रूपमुत्कटसुन्दरम् ।\nआस्थाय वृषभं दिव्यममूं दृष्ट्वा शिवां शुभाम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003712037, "chapter_id": 23712, "verse_number": "१-४-२०-३८", "content_sanskrit": "मानातिरेकादपहाय सर्वमैश्वर्यमेवं तपसि प्रवृत्ताम् ।\nमुग्धां पुनः सांत्वयितुं गिरीशः प्रचक्रमे पर्वतराजपुत्रीम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]