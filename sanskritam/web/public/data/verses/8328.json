[{"id": 900004225, "chapter_id": 8328, "verse_number": "4.1", "content_sanskrit": "केवलं चतुर्विधम्, ईशलक्ष्मीयोग्ययोगिभेदेन", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900004226, "chapter_id": 8328, "verse_number": "4.2", "content_sanskrit": "पूर्वद्वयमनादि नित्यम्, स्वातन्त्र्यपारतन्त्र्याभ्यां तद्विशेषः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900004227, "chapter_id": 8328, "verse_number": "4.3", "content_sanskrit": "अथ वा पूर्वमित्यनेन कार्त्स्न्येनेशविषयत्वं", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900004228, "chapter_id": 8328, "verse_number": "4.4", "content_sanskrit": "योगिज्ञानमृजूनामनादिनित्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900004229, "chapter_id": 8328, "verse_number": "4.5", "content_sanskrit": "ततोऽर्वाक् क्रमेण ह्रसितम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900004230, "chapter_id": 8328, "verse_number": "4.6", "content_sanskrit": "अयोगिज्ञानमुत्पत्तिविनाशवत्, अल्पम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900004231, "chapter_id": 8328, "verse_number": "4.7", "content_sanskrit": "सर्वम् चोत्पत्तिमत् केवलं त्रिविधम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}]