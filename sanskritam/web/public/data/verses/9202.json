[{"id": 40014572, "chapter_id": 9202, "verse_number": "1", "content_sanskrit": "निशाचरेन्द्रस्यनिशम्यवाक्यंसकुम्भकर्णस्यचगर्जितानि । विभीषणोराक्षसराजमुख्यमुवाचवाक्यंहितमर्थयुक्तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40014573, "chapter_id": 9202, "verse_number": "2", "content_sanskrit": "न्तरभोगराशिश्चिन्ताविषस्सुस्मिततीक्ष्णदंष्ट्रः । पञ्चाङ्गुलीपञ्चशिरोऽतिकायस्सीतामहाहिस्तवकेनराजन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40014574, "chapter_id": 9202, "verse_number": "3", "content_sanskrit": "यावन्नलङ्कांसमभिद्रवन्तिवलीमुखाःपर्वतकूटमात्राः । दष्ट्रायुधाश्चैवनखायुधाश्चप्रदीयतांदाशरथायमैथिली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40014575, "chapter_id": 9202, "verse_number": "4", "content_sanskrit": "यावन्नगृह्णन्तिशिरांसिबाणारामेरिताराक्षसपुङ्गवानाम् । वज्रोपमावायुसमानवेगाःप्रदीयतांदाशरथायमैथिली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40014576, "chapter_id": 9202, "verse_number": "5", "content_sanskrit": "नकुम्भकर्णेन्द्रजितौचराजंस्तथामहापार्श्वमहोदरौवा । निकुम्भकुम्भौचतथाऽतिकायःस्थातुंनशक्तायुधिराघवस्य ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40014577, "chapter_id": 9202, "verse_number": "6", "content_sanskrit": "जीवंस्तुरामस्यनमोक्ष्यसेत्वंगुप्तस्सवित्राप्यथवामरुद्भि: । नवासवस्याङ्कगतोनमृत्योर्नभोनपाताळमनुप्रविष्टः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40014578, "chapter_id": 9202, "verse_number": "7", "content_sanskrit": "निशम्यवाक्यंतुविभीषणस्यततःप्रहस्तोवचनंबभाषे । ननोभयंविद्मनदैवतेभ्योनदानवेभ्योऽप्यथवाकुतश्चित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40014579, "chapter_id": 9202, "verse_number": "8", "content_sanskrit": "नयक्षगन्धर्वमहोरगेभ्योभयंनसंख्येपतगोरगेभ्यः । कथंनुरामाद्भविताभयंनोनरेन्द्रपुत्रात्समरेकदाचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40014580, "chapter_id": 9202, "verse_number": "9", "content_sanskrit": "प्रहस्तवाक्यंत्वहितंनिशम्यविभीषणोराजहितानुकाङ्क्षी । ततोमहार्थंवचनंबभाषेधर्मार्थकामेषुनिविष्टबुद्धि: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40014581, "chapter_id": 9202, "verse_number": "10", "content_sanskrit": "प्रहस्त: राजाचमहोदरश्चत्वंकुम्भकर्णश्चयथाऽर्थजातम् । ब्रवीतरामंप्रतितन्नशक्यंयथागतिस्स्वर्गमधर्मबुद्धेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40014582, "chapter_id": 9202, "verse_number": "11", "content_sanskrit": "वधस्तुरामस्यमयात्वयाचप्रहस्तसर्वैरपिराक्षसैर्वा । कथंभवेदर्थविशारदस्यमहार्णवंतर्तुमिवाप्लवस्य ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40014583, "chapter_id": 9202, "verse_number": "12", "content_sanskrit": "धर्मप्रधानस्यमहारथस्यइक्ष्वाकुवंशप्रभवस्यराज्ञः । पुरोस्यदेवाश्चतथाविधस्यकृत्येषुशक्तस्यभवन्तिमूढा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40014584, "chapter_id": 9202, "verse_number": "13", "content_sanskrit": "तीक्ष्णानतायत्तवकङ्कपत्रादुरासदाराघवविप्रमुक्ताः । भित्वाशरीरंप्रविशन्तिबाणाःप्रहस्ततेनैवविकत्थसेत्वम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40014585, "chapter_id": 9202, "verse_number": "14", "content_sanskrit": "भित्त्वानतावत्प्रविशन्तिकायंप्राणान्तिकास्तेऽशनितुल्यवेगाः । शिताश्शराराघवविप्रमुक्ताःप्रहस्ततेनैवविकत्थसेत्वम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40014586, "chapter_id": 9202, "verse_number": "15", "content_sanskrit": "नरावणोनातिबलस्त्रिशीर्षोनकुम्भकर्णोऽस्यसुतोनिकुम्भः । नचेन्द्रजिद्दाशरधिंप्रसोढुंत्वंवारणेशक्रसमंसमर्थ: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40014587, "chapter_id": 9202, "verse_number": "16", "content_sanskrit": "देवान्तकोवापिनरान्तकोवातथातिकायोऽतिरथोमहात्मा । आकम्पनश्चाद्रिसमानसारःस्थातुंनशक्तायुधिराघवस्य ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40014588, "chapter_id": 9202, "verse_number": "17", "content_sanskrit": "अयंचराजाव्यसनाभिभूतोमित्रैरमित्रप्रतिमैर्भवद्भि: । अन्वास्यतेराक्षसनाशनार्थेतीक्ष्णःप्रकृत्याह्यसीक्षयकारी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40014589, "chapter_id": 9202, "verse_number": "18", "content_sanskrit": "अनन्तभोगेनसहस्रमूर्थ्नानागेनभीमेनमहाबलेव । बलात्परिक्षिप्तमिमंभवन्तोराजानमुत्क्षिप्यविमोचयन्तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40014590, "chapter_id": 9202, "verse_number": "19", "content_sanskrit": "यावद्धिकेशग्रहणातसुहृद्भि: समेत्यसर्वैःपरिपूर्णकामैः । निगृह्यराजापरिरक्षितव्योभूतैर्यथाभीमबलैर्गृहीतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40014591, "chapter_id": 9202, "verse_number": "20", "content_sanskrit": "सुवारिणाराघवसागरेणप्रच्छाद्यमानस्तरसाभवद्भि: । युक्तस्त्वयंतारयितुंसमेत्यकाकुत्स्थपातालमुखेपतन्सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40014592, "chapter_id": 9202, "verse_number": "21", "content_sanskrit": "इदंपुरस्यास्यसराक्षसस्यराज्ञश्चपथ्यंससुहृज्जनस्य । सम्यग्घिवाक्यंस्वमतंब्रवीमिनरेन्द्रपुत्रायददामपत्नीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40014593, "chapter_id": 9202, "verse_number": "22", "content_sanskrit": "परस्यवीर्यंस्वबलंचबुध्वास्थानंक्षयंचैवतथैववृद्धिम् । तथास्वपक्षेप्यनुमृश्यबुध्वावदेत् क्षमंस्वामिहितंसमन्त्री ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]