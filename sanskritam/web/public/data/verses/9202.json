[{"id": 5000202000, "chapter_id": 9202, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे षष्ठः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000202001, "chapter_id": 9202, "verse_number": "३-६-१", "content_sanskrit": "शरभङ्गे दिवं प्राप्ते मुनिसङ्घाः समागताः।\nअभ्यगच्छन्त काकुत्स्थं रामं ज्वलिततेजसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000202002, "chapter_id": 9202, "verse_number": "३-६-२", "content_sanskrit": "वैखानसा वालखिल्याः सम्प्रक्षाला मरीचिपाः।\nअश्मकुट्टाश्च बहवः पत्राहाराश्च तापसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000202003, "chapter_id": 9202, "verse_number": "३-६-३", "content_sanskrit": "दन्तोलूखलिनश्चैव तथैवोन्मज्जकाः परे।\nगात्रशय्या अशय्याश्च तथैवानवकाशिकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000202004, "chapter_id": 9202, "verse_number": "३-६-४", "content_sanskrit": "मुनयः सलिलाहारा वायुभक्षास्तथापरे।\nआकाशनिलयाश्चैव तथा स्थण्डिलशायिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000202005, "chapter_id": 9202, "verse_number": "३-६-५", "content_sanskrit": "तथोर्ध्ववासिनो दान्तास्तथाऽऽर्द्रपटवाससः।\nसजपाश्च तपोनिष्ठास्तथा पञ्चतपोऽन्विताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000202006, "chapter_id": 9202, "verse_number": "३-६-६", "content_sanskrit": "सर्वे ब्राह्म्या श्रिया युक्ता दृढयोगसमाहिताः।\nशरभङ्गाश्रमे राममभिजग्मुश्च तापसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000202007, "chapter_id": 9202, "verse_number": "३-६-७", "content_sanskrit": "अभिगम्य च धर्मज्ञा रामं धर्मभृतां वरम्।\nऊचुः परमधर्मज्ञमृषिसङ्घाः समागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000202008, "chapter_id": 9202, "verse_number": "३-६-८", "content_sanskrit": "त्वमिक्ष्वाकुकुलस्यास्य पृथिव्याश्च महारथः।\nप्रधानश्चापि नाथश्च देवानां मघवानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000202009, "chapter_id": 9202, "verse_number": "३-६-९", "content_sanskrit": "विश्रुतस्त्रिषु लोकेषु यशसा विक्रमेण च।\nपितृव्रतत्वं सत्यं च त्वयि धर्मश्च पुष्कलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000202010, "chapter_id": 9202, "verse_number": "३-६-१०", "content_sanskrit": "त्वामासाद्य महात्मानं धर्मज्ञं धर्मवत्सलम्।\nअर्थित्वान्नाथ वक्ष्यामस्तच्च नः क्षन्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000202011, "chapter_id": 9202, "verse_number": "३-६-११", "content_sanskrit": "अधर्मः सुमहान् नाथ भवेत् तस्य तु भूपतेः।\nयो हरेद् बलिषड्भागं न च रक्षति पुत्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000202012, "chapter_id": 9202, "verse_number": "३-६-१२", "content_sanskrit": "युञ्जानः स्वानिव प्राणान् प्राणैरिष्टान् सुतानिव।\nनित्ययुक्तः सदा रक्षन् सर्वान् विषयवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000202013, "chapter_id": 9202, "verse_number": "३-६-१३", "content_sanskrit": "प्राप्नोति शाश्वतीं राम कीर्तिं स बहुवार्षिकीम्।\nब्रह्मणः स्थानमासाद्य तत्र चापि महीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000202014, "chapter_id": 9202, "verse_number": "३-६-१४", "content_sanskrit": "यत् करोति परं धर्मं मुनिर्मूलफलाशनः।\nतत्र राज्ञश्चतुर्भागः प्रजा धर्मेण रक्षतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000202015, "chapter_id": 9202, "verse_number": "३-६-१५", "content_sanskrit": "सोऽयं ब्राह्मणभूयिष्ठो वानप्रस्थगणो महान्।\nत्वन्नाथोऽनाथवद् राम राक्षसैर्हन्यते भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000202016, "chapter_id": 9202, "verse_number": "३-६-१६", "content_sanskrit": "एहि पश्य शरीराणि मुनीनां भावितात्मनाम्।\nहतानां राक्षसैर्घोरैर्बहूनां बहुधा वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000202017, "chapter_id": 9202, "verse_number": "३-६-१७", "content_sanskrit": "पम्पानदीनिवासानामनुमन्दाकिनीमपि।\nचित्रकूटालयानां च क्रियते कदनं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000202018, "chapter_id": 9202, "verse_number": "३-६-१८", "content_sanskrit": "एवं वयं न मृष्यामो विप्रकारं तपस्विनाम्।\nक्रियमाणं वने घोरं रक्षोभिर्भीमकर्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000202019, "chapter_id": 9202, "verse_number": "३-६-१९", "content_sanskrit": "ततस्त्वां शरणार्थं च शरण्यं समुपस्थिताः।\nपरिपालय नो राम वध्यमानान् निशाचरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000202020, "chapter_id": 9202, "verse_number": "३-६-२०", "content_sanskrit": "परा त्वत्तो गतिर्वीर पृथिव्यां नोपपद्यते।\nपरिपालय नः सर्वान् राक्षसेभ्यो नृपात्मज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000202021, "chapter_id": 9202, "verse_number": "३-६-२१", "content_sanskrit": "एतच्छ्रुत्वा तु काकुत्स्थस्तापसानां तपस्विनाम्।\nइदं प्रोवाच धर्मात्मा सर्वानेव तपस्विनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000202022, "chapter_id": 9202, "verse_number": "३-६-२२", "content_sanskrit": "नैवमर्हथ मां वक्तुमाज्ञाप्योऽहं तपस्विनाम्।\nकेवलेन स्वकार्येण प्रवेष्टव्यं वनं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000202023, "chapter_id": 9202, "verse_number": "३-६-२३", "content_sanskrit": "विप्रकारमपाक्रष्टुं राक्षसैर्भवतामिमम्।\nपितुस्तु निर्देशकरः प्रविष्टोऽहमिदं वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000202024, "chapter_id": 9202, "verse_number": "३-६-२४", "content_sanskrit": "भवतामर्थसिद्ध्यर्थमागतोऽहं यदृच्छया।\nतस्य मेऽयं वने वासो भविष्यति महाफलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000202025, "chapter_id": 9202, "verse_number": "३-६-२५", "content_sanskrit": "तपस्विनां रणे शत्रून् हन्तुमिच्छामि राक्षसान्।\nपश्यन्तु वीर्यमृषयः सभ्रातुर्मे तपोधनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000202026, "chapter_id": 9202, "verse_number": "३-६-२६", "content_sanskrit": "दत्त्वा वरं चापि तपोधनानां\nधर्मे धृतात्मा सह लक्ष्मणेन।\nतपोधनैश्चापि सहार्यदत्तः\nसुतीक्ष्णमेवाभिजगाम वीरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000202027, "chapter_id": 9202, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे षष्ठः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]