[{"id": 2139309, "chapter_id": 4013, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2139310, "chapter_id": 4013, "verse_number": "१", "content_sanskrit": "सुदेष्णामेवमुक्त्वा तु सैरन्ध्री दुःखमोहिता ।\nकीचकस्य वधार्थाय व्रतदीक्षामुपागमत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2139311, "chapter_id": 4013, "verse_number": "२", "content_sanskrit": "अभ्यर्थिता च नारीभिर्मानिता च सुदेष्णया ।\nन च स्नाति न चाश्नाति न पांसून् परिमार्जति\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2139312, "chapter_id": 4013, "verse_number": "३", "content_sanskrit": "रुधिरक्लिन्नवदना बभूव रुदितेक्षणा\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2139313, "chapter_id": 4013, "verse_number": "४", "content_sanskrit": "तां तथा शोकसन्तप्तां दृष्ट्वा प्ररुदितां स्त्रियः ।\nकीचकस्य वधं सर्वा मनोभिश्च शशंसिरे\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2139314, "chapter_id": 4013, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2139315, "chapter_id": 4013, "verse_number": "५", "content_sanskrit": "अहो दुःखतरं प्राप्ता कीचकेन पदा हता ।\nपतिव्रता महाभागा द्रौपदी योषितां वरा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2139316, "chapter_id": 4013, "verse_number": "६", "content_sanskrit": "दुःशलां मानयन्ती या भर्तॄणां भगिनीं शुभाम् ।\nनाशपत् सिन्धुराजं तं बलात्कारेण वाहिता\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2139317, "chapter_id": 4013, "verse_number": "७", "content_sanskrit": "किमर्थं धर्षणं प्राप्ता कीचकेन दुरात्मना ।\nनाशपत् तं महाभागा कृष्णा पादेन ताडिता\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2139318, "chapter_id": 4013, "verse_number": "८", "content_sanskrit": "तेजोराशिरियं देवी धर्मज्ञा सत्यवादिनी ।\nकेशपक्षे परामृष्टा मर्षयिष्यत्यशक्तवत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2139319, "chapter_id": 4013, "verse_number": "९", "content_sanskrit": "नैतत्कारणमल्पं हि श्रोतुकामोऽस्मि सत्तम ।\nकृष्णायास्तु परिक्लेशान्मनो मे दूयते भृशम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2139320, "chapter_id": 4013, "verse_number": "१०", "content_sanskrit": "कस्य वंशे समुद्भूतः स च दुर्ललितो मुने ।\nबलोन्मत्तः कथं चासीत् स्यालो मात्स्यस्य कीचकः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2139321, "chapter_id": 4013, "verse_number": "११", "content_sanskrit": "दृष्ट्वाऽपि तां प्रियां भार्यां सूतपुत्रेण ताडिताम् ।\nनैव चुक्षुभिरे वीराः किमकुर्वत तं प्रति\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2139322, "chapter_id": 4013, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2139323, "chapter_id": 4013, "verse_number": "१२", "content_sanskrit": "त्वदुक्तोऽयमनुप्रश्नः कुरूणां कीर्तिवर्धन ।\nएतत् सर्वं यथा वक्ष्ये विस्तरेणैव पार्थिव\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2139324, "chapter_id": 4013, "verse_number": "१३", "content_sanskrit": "ब्राह्मण्यां क्षत्रियाज्जातः सूतो भवति पार्थिव ।\nप्रातिलोम्येन जातानां स ह्येको द्विज एव तु\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2139325, "chapter_id": 4013, "verse_number": "१४", "content_sanskrit": "रथकारमितीमं हि क्रियायुक्तं द्विजन्मनाम् ।\nक्षत्रियादवरं वैश्याद् विशिष्टमिति चक्षते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2139326, "chapter_id": 4013, "verse_number": "१५", "content_sanskrit": "सह सूतेन सम्बन्धः कृतपूर्वो नरैश्वरैः ।\nतथाऽपि तैर्महीपाल राजशब्दो न लभ्यते\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2139327, "chapter_id": 4013, "verse_number": "१६", "content_sanskrit": "तेषां तु सूतविषयः सूतानां नामतः कृतः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2139328, "chapter_id": 4013, "verse_number": "१७", "content_sanskrit": "उपजीव्य च यत् क्षत्रं लब्धं सूतेन यत् पुरा ।\nसूतानामधिपो राजा केकयो नाम विश्रुतः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2139329, "chapter_id": 4013, "verse_number": "१८", "content_sanskrit": "राजकन्यासमुद्भूतः सारथ्येऽनुपमोऽभवत् ।\nपुत्रास्तस्य कुरुश्रेष्ठ मालव्यां जज्ञिरे तदा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2139330, "chapter_id": 4013, "verse_number": "१९", "content_sanskrit": "तेषामतिबलो ज्येष्ठः कीचकः सर्वजित् प्रभो ।\nअग्रजो बलसम्मत्तः तेनासीत् सूतषट्शतम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2139331, "chapter_id": 4013, "verse_number": "२०", "content_sanskrit": "द्वितीयायां तु मालव्यां चित्रा ह्यवरजाऽभवत् ।\nतां सुदेष्णेति वै प्राहुर्विराटमहिषीं प्रियाम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2139332, "chapter_id": 4013, "verse_number": "२१", "content_sanskrit": "तां विराटस्य मात्स्यस्य केकयः प्रददौ मुदा ।\nसुरथायां मृतायां तु कौसल्यां श्वेतमातरि\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2139333, "chapter_id": 4013, "verse_number": "२२", "content_sanskrit": "श्वेते विनष्टे शङ्खे च गते मातुलवेश्मनि ।\nसुदेष्णां महिषीं लब्ध्वा राजा दुःखमपानुदत्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2139334, "chapter_id": 4013, "verse_number": "२३", "content_sanskrit": "उत्तरं चोत्तरां चैव विराटात् पृथिवीपते ।\nसुदेष्णा सुषुवे देवी कैकेयी कुलवृद्धये\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2139335, "chapter_id": 4013, "verse_number": "२४", "content_sanskrit": "मातृष्वसृसुतां राजन् कीचकस्तामनिन्दिताम् ।\nसदा परिचरन् प्रीत्या विराटे न्यवसत् सुखी\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2139336, "chapter_id": 4013, "verse_number": "२५", "content_sanskrit": "भ्रातरस्तस्य विक्रान्ताः सर्वे च तमनुव्रताः ।\nविराटस्यैव संहृष्टाः बलं कोशं च वर्धयन्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2139337, "chapter_id": 4013, "verse_number": "२६", "content_sanskrit": "कालेया नाम दैतेयाः प्रायशो भुवि विश्रुताः ।\nजज्ञिरे कीचका राजन् बाणो ज्येष्ठस्ततोऽभवत्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2139338, "chapter_id": 4013, "verse_number": "२७", "content_sanskrit": "स हि सर्वास्त्रसम्पन्नो बलवान् भीमविक्रमः ।\nकीचको नष्टमर्यादो बभूव भयदो नृणाम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2139339, "chapter_id": 4013, "verse_number": "२८", "content_sanskrit": "तं प्राप्य बलसम्मत्तं विराटः पृथिवीपतिः ।\nजिगाय सर्वांश्च रिपून् यथेन्द्रो दानवान् पुरा\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2139340, "chapter_id": 4013, "verse_number": "२९", "content_sanskrit": "मेखलांश्च त्रिगर्तांश्च दशार्णांश्च कशेरुकान् ।\nमालवान् यवनांश्चैव पुळिन्दान् काशिकोसलान्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2139341, "chapter_id": 4013, "verse_number": "३०", "content_sanskrit": "अङ्गान् वङ्गान् कळिङ्गांश्च तङ्कणान् परतङ्कणान् ।\nमलदान् निषधांश्चैव तुण्डिकेरांश्च कोङ्कणान्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2139342, "chapter_id": 4013, "verse_number": "३१", "content_sanskrit": "करदांश्च निषिद्धांश्च शिवान् दुश्छिल्लिकांस्तथा\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2139343, "chapter_id": 4013, "verse_number": "३२", "content_sanskrit": "अन्ये च बहवः शूरा नानाजनपदेश्वराः ।\nकीचकेन रणे भग्ना व्यद्रवन्त दिशो दश\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2139344, "chapter_id": 4013, "verse_number": "३३", "content_sanskrit": "तमेवं वीर्यसम्पन्नं नागायुतबलं रणे ।\nविराटस्तत्र सेनायाः चकार पतिमात्मनः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2139345, "chapter_id": 4013, "verse_number": "३४", "content_sanskrit": "विराटभ्रातरश्चैव दश दाशरथोपमः ।\nते चैनानन्ववर्तन्त कीचकान् बलवत्तरान्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2139346, "chapter_id": 4013, "verse_number": "३५", "content_sanskrit": "एवंविधबलोपेताः कीचकास्ते च तद्विधाः ।\nराज्ञः स्याला महात्मानो विराटस्य हितैषिणः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2139347, "chapter_id": 4013, "verse_number": "३६", "content_sanskrit": "एतत् ते कथितं सर्वं कीचकस्य पराक्रमम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2139348, "chapter_id": 4013, "verse_number": "३७", "content_sanskrit": "द्रौपदी न शशापैनं यस्मात् तद् गदतः शृणु\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2139349, "chapter_id": 4013, "verse_number": "३८", "content_sanskrit": "क्षरतीति तपः क्रोधात् ऋषयो न शपन्ति हि ।\nजानन्ती तद्यथातत्त्वं पाञ्चाली न शशाप तम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2139350, "chapter_id": 4013, "verse_number": "३९", "content_sanskrit": "क्षमा धर्मः क्षमा दानं क्षमा यज्ञः क्षमा यशः ।\nक्षमा सत्यं क्षमा शीलं क्षमा सत्यमिति श्रुतिः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2139351, "chapter_id": 4013, "verse_number": "४०", "content_sanskrit": "क्षमावतामयं लोकः परश्चैव क्षमावताम् ।\nएतत् सर्वं विजानन्ती सा क्षमामन्वपद्यत\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2139352, "chapter_id": 4013, "verse_number": "४१", "content_sanskrit": "भ्रातॄणां मतमाज्ञाय क्षमिणां धर्मचारिणाम् ।\nनाशपत् तं विशालाक्षी सती शक्ताऽपि भारत\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2139353, "chapter_id": 4013, "verse_number": "४२", "content_sanskrit": "पाण्डवाश्चापि ते सर्वे द्रौपदीं प्रेक्ष्य दुःखिताः ।\nक्रोधाग्निना व्यदह्यन्त तदा कालव्यपेक्षया\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2139354, "chapter_id": 4013, "verse_number": "४३", "content_sanskrit": "अथ भीमो महाबाहुः सूदयिष्यंस्तु कीचकम् ।\nवारितो धर्मपुत्रेण वेलयेव महोदधिः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2139355, "chapter_id": 4013, "verse_number": "४४", "content_sanskrit": "सन्धार्य मनसा रोषं दिवारात्रं विनिःश्वसन् ।\nमहानसे सदा कृच्छ्रात् सुष्वाप रजनीं च ताम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2139356, "chapter_id": 4013, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां विराटपर्वणि एकविंशोऽध्यायः ॥२१॥\nकीचकवधपर्वणि षष्ठोऽध्यायः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2139357, "chapter_id": 4013, "verse_number": "", "content_sanskrit": "* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]