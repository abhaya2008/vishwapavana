[{"id": 2126552, "chapter_id": 3713, "verse_number": "", "content_sanskrit": "बृहदश्व", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2126553, "chapter_id": 3713, "verse_number": "१", "content_sanskrit": "अपक्रान्ते नळे राजन् दमयन्ती गतक्लमा ।\nअबुध्यत वरारोहा संत्रस्ता विजने वने\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2126554, "chapter_id": 3713, "verse_number": "२", "content_sanskrit": "भर्तारं सा त्वपश्यन्ती शोकदुःखसमन्विता ।\nप्राक्रोशदुच्चैः सन्त्रस्ता हा राजन्निति भारत\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2126555, "chapter_id": 3713, "verse_number": "३", "content_sanskrit": "हा नाथ हा महाराज हा स्वामिन् किं जहासि माम् ।\nहा हताऽस्मि विनष्टाऽस्मि भीताऽस्मि विजने वने\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2126556, "chapter_id": 3713, "verse_number": "४", "content_sanskrit": "ननु नाम महाराज धर्मज्ञ इति विश्रुतः ।\nकथं तथाविधस्त्वं हि सुप्तामुत्सृज्य मां गतः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2126557, "chapter_id": 3713, "verse_number": "५", "content_sanskrit": "कथमुत्सृज्य गन्तासि वश्यां भार्यामनुव्रताम् ।\nविशेषतो नापकृतः परेणापकृते सति\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2126558, "chapter_id": 3713, "verse_number": "६", "content_sanskrit": "वदस्व ता गिरः सत्याः साम्प्रतं च मया सह ।\nशक्ष्यसे ता गिरः सत्याः कर्तुं मयि नरेश्वर ।\nयास्त्वया लोकपालानां सन्निधौ कथिताः पुरा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2126559, "chapter_id": 3713, "verse_number": "७", "content_sanskrit": "पर्याप्तः परिहासोऽयमेतावान् पुरुषर्षभ ।\nभीताऽहमस्मि दुर्धर्ष दर्शयात्मानमीश्वर \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2126560, "chapter_id": 3713, "verse_number": "८", "content_sanskrit": "दृश्यसे दृश्यसे राजन् एष तिष्ठसि नैषध ।\nआवार्य गुल्मैरात्मानं किं मां न प्रतिभाषसे\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2126561, "chapter_id": 3713, "verse_number": "९", "content_sanskrit": "नृशंसं बत राजेन्द्र यन्मामेवंगतामिह ।\nविलपन्तीं समालिङ्ग्य नाश्वासयसि पार्थिव \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2126562, "chapter_id": 3713, "verse_number": "१०", "content_sanskrit": "न शोचाम्यहमात्मानं न चान्यदपि किञ्चन ।\nकथं नु भवितास्येक इति त्वां नृप शोचये\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2126563, "chapter_id": 3713, "verse_number": "११", "content_sanskrit": "कथं नु राजंस्तृषितः क्षुधितः श्रमकर्शितः ।\nसायाह्ने वृक्षमूलेषु मामपश्यन् निवत्स्यसि\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2126564, "chapter_id": 3713, "verse_number": "", "content_sanskrit": "बृहदश्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2126565, "chapter_id": 3713, "verse_number": "१२", "content_sanskrit": "एवं साऽतीवशोकार्ता प्रदीप्तेव च मन्युना ।\nइतश्चेतश्च रुदती पर्यधावत दुःखिता\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2126566, "chapter_id": 3713, "verse_number": "१३", "content_sanskrit": "मुहुरुत्पतते बाला मुहुः पतति विह्वला ।\nमुहुरालीयते भीता मुहुः क्रोशति रोदिति\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2126567, "chapter_id": 3713, "verse_number": "१४", "content_sanskrit": "साऽतीव शोकसन्तप्ता मुहुर्निश्श्वस्य विह्वला ।\nउवाच भैमी निष्क्रम्य रोदमाना पतिव्रता\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2126568, "chapter_id": 3713, "verse_number": "१५", "content_sanskrit": "यस्याभिशापाद् दुःखार्तो दुःखं विन्दति नैषधः ।\nतस्य भूतस्य तद्दुःखाद् दुःखमभ्यधिकं भवेत् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2126569, "chapter_id": 3713, "verse_number": "१६", "content_sanskrit": "अपापचेतसं पापो य एवं कृतवान् नळम् ।\nतस्माद् दुःखतरं प्राप्य जीवत्वसुखजीविकाम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2126570, "chapter_id": 3713, "verse_number": "१७", "content_sanskrit": "एवं तु विलपन्ती सा राज्ञो भार्या महात्मनः ।\nअन्वेषति स्म भर्तारं वने श्वापदसेविते \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2126571, "chapter_id": 3713, "verse_number": "१८", "content_sanskrit": "उन्मत्तवद् भीमसुता विलपन्ती ततस्ततः ।\nहाहा राजन्निति मुहुरितश्चेतश्च धावति \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2126572, "chapter_id": 3713, "verse_number": "१९", "content_sanskrit": "संशुष्यमाणामत्यर्थं कुररीमिव वाशतीम् ।\nकरुणं बहु शोचन्तीं विलपन्तीं सुमध्यमाम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2126573, "chapter_id": 3713, "verse_number": "२०", "content_sanskrit": "सहसैवानवद्याङ्गीमभ्याशे परिवर्तिनीम् ।\nजग्राहाजगरो ग्राहो महाकायः क्षुधाऽन्वितः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2126574, "chapter_id": 3713, "verse_number": "२१", "content_sanskrit": "सा गृह्यमाणा ग्राहेण शोकेन च पराजिता ।\nनात्मानं शोचति तथा यथा शोचति नैषधम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2126575, "chapter_id": 3713, "verse_number": "२२", "content_sanskrit": "हा नाथ मामिह वने गृह्यमाणामनागसीम् ।\nग्राहेणानेन विपिने किमर्थं नाभिधावसि\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2126576, "chapter_id": 3713, "verse_number": "२३", "content_sanskrit": "कथं भवान् जगामाथ मामिहोत्सृज्य नैषध ।\nकथं भविष्यसि पुनर्मामनुस्मृत्य नैषध ।\nशापान्मुक्तः पुनर्लब्ध्वा बुद्धिं चेतो धनानि च\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2126577, "chapter_id": 3713, "verse_number": "२४", "content_sanskrit": "श्रान्तस्य ते क्षुधार्तस्य परिम्लानस्य नैषध ।\nका श्रमं राजशार्दूल नाशयिष्यति तेऽनघ\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2126578, "chapter_id": 3713, "verse_number": "२५", "content_sanskrit": "तामकस्मान्मृगव्याधो विचरन् गहने वने ।\nआक्रन्दतीमुपश्रुत्य जवेनाभिससार ह\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2126579, "chapter_id": 3713, "verse_number": "२६", "content_sanskrit": "तां स दृष्ट्वा तथा ग्रस्तामुरगेणायतेक्षणाम् ।\nत्वरमाणो मृगव्याधः सञ्चरन् गहने वने\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2126580, "chapter_id": 3713, "verse_number": "२७", "content_sanskrit": "समतिक्रम्य वेगेन सत्वरः स वनेचरः ।\nमुखतः पाटयामास शस्त्रेण निशितेन च \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2126581, "chapter_id": 3713, "verse_number": "२८", "content_sanskrit": "निर्विचेष्टं भुजङ्गं तं विशस्य मृगजीविकः ।\nमोक्षयित्वा च तां व्याधः प्रक्षाल्य सलिलेन च ।\nसमाश्वास्य कृताहारामथ पप्रच्छ भारत\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2126582, "chapter_id": 3713, "verse_number": "२९", "content_sanskrit": "कस्य त्वं मृगशाबाक्षि कथं चास्यागता वनम् ।\nकथं चेदं महत् कृच्छ्रं प्राप्तवत्यसि भामिनि\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2126583, "chapter_id": 3713, "verse_number": "", "content_sanskrit": "बृहदश्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2126584, "chapter_id": 3713, "verse_number": "३०", "content_sanskrit": "दमयन्ती तथा तेन पृच्छ्यमाना विशांपते ।\nसर्वमेतद्यथावृत्तमाचचक्षेऽस्य भारत\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2126585, "chapter_id": 3713, "verse_number": "३१", "content_sanskrit": "तामर्धवस्त्रसंवीतां पीनश्रोणिपयोधराम् ।\nसुकुमारानवद्याङ्गीं पूर्णचन्द्रनिभाननाम् \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2126586, "chapter_id": 3713, "verse_number": "३२", "content_sanskrit": "मृणाळपत्रनयनां तथा मधुरभाषिणीम् ।\nलक्षयित्वा मृगव्याधः कामस्य वशमेयिवान्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2126587, "chapter_id": 3713, "verse_number": "३३", "content_sanskrit": "तामथ श्लक्ष्णया वाचा लुब्धको मृदुपूर्वया ।\nसान्त्वयामास कामार्तः तदबुध्यत भामिनी\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2126588, "chapter_id": 3713, "verse_number": "३४", "content_sanskrit": "दमयन्ती च तं दुष्टं विज्ञायाथ पतिव्रता ।\nतीव्ररोषसमाविष्टा प्रजज्वालेव मन्युना \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2126589, "chapter_id": 3713, "verse_number": "३५", "content_sanskrit": "स तु पापमतिः क्षुद्रः प्रधर्षयितुमातुरः ।\nदुर्धर्षां तर्कयामास दीप्तामग्निशिखामिव\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2126590, "chapter_id": 3713, "verse_number": "३६", "content_sanskrit": "दमयन्ती तु दुःखार्ता पतिराज्यविनाकृता ।\nअतीतवाक्पथे काले शशापैनं रुषा किल\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2126591, "chapter_id": 3713, "verse_number": "३७", "content_sanskrit": "यथाऽहं नैषधादन्यं मनसाऽपि न चिन्तये ।\nतथाऽयं पततां क्षुद्रः परासुर्मृगजीवनः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2126592, "chapter_id": 3713, "verse_number": "", "content_sanskrit": "बृहदश्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2126593, "chapter_id": 3713, "verse_number": "३८", "content_sanskrit": "उक्तमात्रे तु वचने तया स मृगजीवनः ।\nव्यसुः पपात मेदिन्यामग्निदग्ध इव द्रुमः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2126594, "chapter_id": 3713, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nवनपर्वणि पञ्चपञ्चाशोऽध्यायः ॥५५॥\n॥ तीर्थयात्रापर्वणि एकादशोऽध्यायः ॥११॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]