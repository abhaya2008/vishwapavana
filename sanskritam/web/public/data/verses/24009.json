[{"id": 7004009000, "chapter_id": 24009, "verse_number": "३-२-२०-१", "content_sanskrit": "व्यास उवाच ।\nअतः परं प्रवक्ष्यामि शिवतीर्थमनुत्तमम् ।\nयत्रासौ शंकरो देवः पुनर्जन्मधरोऽभवत्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004009001, "chapter_id": 24009, "verse_number": "३-२-२०-२", "content_sanskrit": "कीलितो देवदेवेशः शंकरश्च त्रिलोचनः ।\nगिरिजया महाभाग पातितो भूमिमंडले॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004009002, "chapter_id": 24009, "verse_number": "३-२-२०-३", "content_sanskrit": "छलितो मुह्यमानस्तु दिवारात्रिं न वेत्ति च ।\nपुंस्त्रीनपुंसकाश्चैव जडीभूतस्त्रिलोचनः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004009003, "chapter_id": 24009, "verse_number": "३-२-२०-४", "content_sanskrit": "कल्पांतमिव संजातं तदा तस्मिंश्च कीलिते ।\nपार्वत्या सहसा तस्य कृत कीलनकं तदा॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004009004, "chapter_id": 24009, "verse_number": "३-२-२०-५", "content_sanskrit": "युधिष्ठिर उवाच ।\nएतदाश्चर्यमतुलं वचनं यत्त्वयोदितम् ।\nयो गुरुः सर्वदेवानां योगिनां चैव सर्वदा॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004009005, "chapter_id": 24009, "verse_number": "३-२-२०-६", "content_sanskrit": "पार्वत्या कीलितः कस्मा न्नष्टवृत्तिः शिवः कथम् ।\nकारणं कथ्यतां तत्र परं कौतूहलं हि मे॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004009006, "chapter_id": 24009, "verse_number": "३-२-२०-७", "content_sanskrit": "व्यास उवाच ।\nमन्त्रौघा विविधा राजञ्छंकरेण प्रकाशिताः ।\nपार्वत्यग्रे महाराज अथर्वणोपवेदजाः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004009007, "chapter_id": 24009, "verse_number": "३-२-२०-८", "content_sanskrit": "शाकिनी डाकिनी चैव काकिनी हाकिनी तथा ।\nएकिनी लाकिनी ह्येताः षट्भेदास्तत्र कीर्ति ताः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004009008, "chapter_id": 24009, "verse_number": "३-२-२०-९", "content_sanskrit": "बीजान्युद्धृत्य वै ताभ्यो माला चैकवृता कृता ।\nशंभुना कथिता चैव पार्वत्यग्रे नृपोत्तम॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004009009, "chapter_id": 24009, "verse_number": "३-२-२०-१०", "content_sanskrit": "तैश्चैव अष्टा भवति मंत्रोद्धारः कृतस्तु सा ।\nसाधयेत्सा महादुष्टा शाकिनी प्रमदानघे॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004009010, "chapter_id": 24009, "verse_number": "३-२-२०-११", "content_sanskrit": "श्रीपार्वत्युवाच ।\nप्रकाशितास्त्वया नाथ भेदा ह्येते षडेव हि ।\nषड्विधाः शक्तयो नाथ अगम्यायोगमालिनीः ।\nषड्विधोक्तं त्वयैकेन कूटात्कृतं वदस्व माम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004009011, "chapter_id": 24009, "verse_number": "३-२-२०-१२", "content_sanskrit": "श्रीमहादेव उवाच ।\nअप्रकाशो महादेवि देवासुरैस्तु मानवैः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004009012, "chapter_id": 24009, "verse_number": "३-२-२०-१३", "content_sanskrit": "पार्वत्युवाच ।\nनमस्ते सर्वरूपाय नमस्ते वृषभध्वज ।\nजटिलेश नमस्तुभ्यं नीलकण्ठ नमोस्तुते॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004009013, "chapter_id": 24009, "verse_number": "३-२-२०-१४", "content_sanskrit": "कृपासिंधो नमस्तुभ्यं नमस्ते कालरूपिणे ।\nएतैश्च बहुभिर्वाक्यैः कोमलैः करुणानिधिम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004009014, "chapter_id": 24009, "verse_number": "३-२-२०-१५", "content_sanskrit": "तोषयित्वाद्रितनया दण्डवत्प्रणिपत्य च ।\nजग्राह पादयुगलं तां प्रोवाच दयापरः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004009015, "chapter_id": 24009, "verse_number": "३-२-२०-१६", "content_sanskrit": "किमर्थं स्तूयसे भद्रे याच्यतां मनसीप्सितम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004009016, "chapter_id": 24009, "verse_number": "३-२-२०-१७", "content_sanskrit": "पार्वत्युवाच ।\nसमाहारं च सध्यानं कथयस्व सविस्तरम् ।\nअसंदेहमशेषं च यद्यहं वल्लभा तव॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004009017, "chapter_id": 24009, "verse_number": "३-२-२०-१८", "content_sanskrit": "श्रीरुद्र उवाच ।\nन प्रकाश्यं त्वया देवि समाहारोद्भवं फलम् ।\nसर्वं तत्त्वमहं वक्ष्ये मंत्रकूटाद्यमेव हि॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004009018, "chapter_id": 24009, "verse_number": "३-२-२०-१९", "content_sanskrit": "मायाबीजं तु सर्वेषां कूटानां हि वरानने ।\nसर्वेषां मध्यमो वर्णो बिंदुना दादिशोभितः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004009019, "chapter_id": 24009, "verse_number": "३-२-२०-२०", "content_sanskrit": "वह्निबीजं सवातं च कूर्मबीजसमन्वितम् ।\nआदित्यप्रभवं बीजं शक्तिबीजोद्भवं सदा॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004009020, "chapter_id": 24009, "verse_number": "३-२-२०-२१", "content_sanskrit": "एतत्कूटं चाद्यबीजं द्वितीयं च विभोर्मतम् ।\nतृतीयं चाग्निबीजं तु संयुक्तं बिंदुनेंदुना॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004009021, "chapter_id": 24009, "verse_number": "३-२-२०-२२", "content_sanskrit": "चतुर्थं युक्तं शेषेण ब्रह्मबीजमृषिस्तथा ।\nपंचमं कालबीजं च षष्ठं पार्थिव बीजकम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004009022, "chapter_id": 24009, "verse_number": "३-२-२०-२३", "content_sanskrit": "सप्तमे चाष्टमे बाह्यं नृसिंहेन समन्वितम् ।\nनवमे द्वितीयमेकं च दशमे चाष्टकूटकम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004009023, "chapter_id": 24009, "verse_number": "३-२-२०-२४", "content_sanskrit": "विपरीतं तयोर्बीजं रुद्राक्षे वर चारिणि ।\nचतुर्दशे चतुर्थ्यर्थं पृथ्वीबीजेन संयुतम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004009024, "chapter_id": 24009, "verse_number": "३-२-२०-२५", "content_sanskrit": "कूटाः शेषाक्षराः केचिद्रक्षिता मेनकात्मजे ।\nसा पपात यदोर्व्यां हि शिवपत्नी तदा नृप॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004009025, "chapter_id": 24009, "verse_number": "३-२-२०-२६", "content_sanskrit": "रामेणाश्वासिता तत्र प्रहसंस्त्रिपुरांतकः ।\nभद्रे यस्मात्त्वया पन्नं जंवशक्तिर्भविष्यति॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004009026, "chapter_id": 24009, "verse_number": "३-२-२०-२७", "content_sanskrit": "मारणे मोहने वश्ये आकर्षणे च क्षोभणे ।\nयंयं कामयते नूनं ततत्सिद्धिर्भविष्यति॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004009027, "chapter_id": 24009, "verse_number": "३-२-२०-२८", "content_sanskrit": "इति श्रुत्वा तदा देवी दुष्टचित्ता शुचिस्मिता ।\nकूटशेषास्ततो वीराः प्रोक्तास्तस्यै तु शंभु ना॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004009028, "chapter_id": 24009, "verse_number": "३-२-२०-२९", "content_sanskrit": "उवाच च कृपासिंधुः साधयस्व यथाविधि ।\nकैलासात्तु हरस्तत्र धर्मारण्यं गतो भृशम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004009029, "chapter_id": 24009, "verse_number": "३-२-२०-३०", "content_sanskrit": "ज्ञात्वा देवी ययौ तत्र यत्रासौ वृषभध्वजः ।\nतत्क्षणात्पतितो भूमौ धर्मारण्ये नृपोत्तम॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004009030, "chapter_id": 24009, "verse_number": "३-२-२०-३१", "content_sanskrit": "जटा चंद्रोरगाः शूलं वृषभाद्यायुधानि ।\nमुंडमाला च कौपीनं कपालं ब्रह्मणस्तु वै॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004009031, "chapter_id": 24009, "verse_number": "३-२-२०-३२", "content_sanskrit": "गता गणाश्च सर्वत्र भूतप्रेता दिशो दश ।\nविसंज्ञं च स्वमात्मानं ज्ञात्वा देवो महेश्वरः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004009032, "chapter_id": 24009, "verse_number": "३-२-२०-३३", "content_sanskrit": "स्वेदजास्तु समुत्पन्ना गणाः कूटादयस्तथा ।\nपंचकूटान्समुत्पाद्य तस्मात्तदाधमूलिने॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004009033, "chapter_id": 24009, "verse_number": "३-२-२०-३४", "content_sanskrit": "साधकास्ते महाराज जपहोमपरायणाः ।\nप्रेतासनास्तु ते सर्वे कालकूटोपरि स्थिताः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004009034, "chapter_id": 24009, "verse_number": "३-२-२०-३५", "content_sanskrit": "कथयंति स्वमात्मानं येन मोक्षः पिनाकिनः ।\nततः कष्टसमाविष्टा गौरी वह्निभयातुरा॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004009035, "chapter_id": 24009, "verse_number": "३-२-२०-३६", "content_sanskrit": "सभाजितः शिवस्तैश्च गौरी ह्रीणा त्वधोमुखी ।\nतपस्तेपे च तत्रस्था शंकरादेशकारिणी॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004009036, "chapter_id": 24009, "verse_number": "३-२-२०-३७", "content_sanskrit": "पंचाग्निसेवनं कृत्वा धूम्रपानमधोमुखी ।\nकूटाक्षरैः स्तुतस्तैस्तु तोषितो वृषभध्वजः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004009037, "chapter_id": 24009, "verse_number": "३-२-२०-३८", "content_sanskrit": "धराक्षेत्रमिदं राजन्पापघ्नं सर्वकामदम् ।\nदेवमज्जनकं शुभ्रं स्थानकेऽस्मिन्विराजते॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004009038, "chapter_id": 24009, "verse_number": "३-२-२०-३९", "content_sanskrit": "आश्विने कृष्णपक्षे च चतुर्दश्या दिने नृप ।\nतत्र स्नात्वा च पीत्वा च सर्वपापैः प्रमुच्यते॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004009039, "chapter_id": 24009, "verse_number": "३-२-२०-४०", "content_sanskrit": "पूजयित्वा च देवेशमुपोष्य च विधानतः ।\nशाकिनी डाकिनी चैव वेतालाः पितरो ग्रहाः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004009040, "chapter_id": 24009, "verse_number": "३-२-२०-४१", "content_sanskrit": "ग्रहा धिष्ण्या न पीड्यंते सत्यंसत्यं वरानने ।\nसांगं रुद्रजपं तत्र कृत्वा पापैः प्रमुच्यते॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004009041, "chapter_id": 24009, "verse_number": "३-२-२०-४२", "content_sanskrit": "नश्यंति त्रिविधा रोगाः सत्यंसत्यं च भूपते ।\nएतत्सर्वं मया ख्यातं देवमज्जनकं शृणु॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004009042, "chapter_id": 24009, "verse_number": "३-२-२०-४३", "content_sanskrit": "अश्वमेधसहस्रैस्तु कृतैस्तु भूरिदक्षिणैः ।\nतत्फलं समवाप्नोति श्रोता श्रावयिता नरः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004009043, "chapter_id": 24009, "verse_number": "३-२-२०-४४", "content_sanskrit": "अपुत्रो लभते पुत्रान्निर्धनो धनमाप्नुयात् ।\nआयुरारोग्यमैश्वर्यं लभते नात्र संशयः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004009044, "chapter_id": 24009, "verse_number": "३-२-२०-४५", "content_sanskrit": "मनोवाक्कायजनितं पातकं त्रिविधं च यत् ।\nतत्सर्वं नाशमायाति स्मरणात्कीर्तनान्नृप॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004009045, "chapter_id": 24009, "verse_number": "३-२-२०-४६", "content_sanskrit": "धन्यं यशस्यमायुष्यं सुखसंतानदायकम् ।\nमाहात्म्यं शृणुयाद्वत्स सर्वसौख्यान्वितो भवेत्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004009046, "chapter_id": 24009, "verse_number": "३-२-२०-४७", "content_sanskrit": "सर्वतीर्थेषु यत्पुण्यं सर्वदानेषु यत्फलम् ।\nसर्वयज्ञैश्च यत्पुण्यं जायते श्रवणान्नृप॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]