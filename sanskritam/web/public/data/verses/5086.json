[{"id": 2192158, "chapter_id": 5086, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2192159, "chapter_id": 5086, "verse_number": "१", "content_sanskrit": "किं तदक्षरमित्युक्तं यस्मान्नावर्तते पुनः ।\nकिं च तत्क्षरमित्युक्तं यस्मादावर्तते पुनः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2192160, "chapter_id": 5086, "verse_number": "२", "content_sanskrit": "अक्षरक्षरयोर्व्यक्तिमिच्छाम्यरिनिषूदन ।\nउपलब्धुं महाबाहो तत्त्वेन कुरुनन्दन\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2192161, "chapter_id": 5086, "verse_number": "३", "content_sanskrit": "त्वं हि ज्ञाननिधिर्विप्रैरुच्यसेवेदपारगैः ।\nऋषिभिश्च महाभागैर्यतिभिश्च महात्मभिः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2192162, "chapter_id": 5086, "verse_number": "४", "content_sanskrit": "शेषमल्पं दिनानां ते दक्षिणायनभास्करे ।\nआवृत्तेभगवत्यर्के गन्तासि परमां गतिम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2192163, "chapter_id": 5086, "verse_number": "५", "content_sanskrit": "त्वयि प्रतिगते श्रेयः कुतः श्रोष्यामहे वयम् ।\nकुरुवंशप्रदीपस्त्वंज्ञानद्रव्येण दीप्यसे\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2192164, "chapter_id": 5086, "verse_number": "६", "content_sanskrit": "तदेतच्छ्रोतुमिच्छामि त्वत्तः कुरुकुलोद्वह ।\nन तृप्यामीह राजेन्द्र शृण्वन्नमृतमीदृशम्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2192165, "chapter_id": 5086, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2192166, "chapter_id": 5086, "verse_number": "७", "content_sanskrit": "अत्र ते वर्तयिष्येऽहमितिहासं पुरातनम् ।\nवसिष्ठस्य च संवादं करालजनकस्य च\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2192167, "chapter_id": 5086, "verse_number": "८", "content_sanskrit": "वसिष्ठं श्रेष्ठमासीनमृषीणांभास्करद्युतिम् ।\nपप्रच्छ जनको राजा ज्ञानं नैःश्रेयसं परम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2192168, "chapter_id": 5086, "verse_number": "९", "content_sanskrit": "परमध्यात्मकुशलमध्यात्मगतिनिश्चयम्।\nमैत्रावरुणिमासीनमभिवाद्य कृताञ्जलिः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2192169, "chapter_id": 5086, "verse_number": "१०", "content_sanskrit": "स्वक्षरं प्रश्रितंवाक्यं मधुरं चाप्यनुल्बणम् ।\nपप्रच्छर्षिवरं राजा करालजनकः पुरा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2192170, "chapter_id": 5086, "verse_number": "११", "content_sanskrit": "भगवन् श्रोतुमिच्छामि परं ब्रह्म सनातनम् ।\nयस्मान्न पुनरावृत्तिमाप्नुवन्तिमनीषिणः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2192171, "chapter_id": 5086, "verse_number": "१२", "content_sanskrit": "यच्च तत्क्षरमित्युक्तं यत्रेदं क्षरते जगत् ।\nयच्चाक्षरमिति प्रोक्तं शिवं क्षेम्यमनामयम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2192172, "chapter_id": 5086, "verse_number": "", "content_sanskrit": "वसिष्ठः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2192173, "chapter_id": 5086, "verse_number": "१३", "content_sanskrit": "श्रूयतां पृथिवीपाल क्षरतीदं यथा जगत् ।\nयन्न क्षरति पूर्वेण यावत् कालेन चाप्यथ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2192174, "chapter_id": 5086, "verse_number": "१४", "content_sanskrit": "युगं द्वादशसाहस्रं कल्पं विद्धि चतुर्युगम्।\nदशकल्पशतावृत्तं तदहर्ब्राह्ममुच्यते ।\nरात्रिश्चैतावतीराजन् यस्यान्ते प्रतिबुद्ध्यते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2192175, "chapter_id": 5086, "verse_number": "१५", "content_sanskrit": "सृजत्यनन्तकर्माणं महान्तं भूतमग्रजम् ।\nमूर्तिमन्तममूर्तात्माविश्वं शम्भुः स्वयम्भुवम् ।\nअणिमा लघिमा प्राप्तिरीशानं ज्योतिरव्ययम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2192176, "chapter_id": 5086, "verse_number": "१६", "content_sanskrit": "सर्वतःपाणिपादान्तंसर्वतोक्षिशिरोमुखम् ।\nसर्वतःश्रुतिमल्लोके सर्वमावृत्य तिष्ठति\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2192177, "chapter_id": 5086, "verse_number": "१७", "content_sanskrit": "हिरण्यगर्भो भगवानेष बुद्धिरिति स्मृतः ।\nमहानिति च योगेषु विरिञ्च इति चाप्यजः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2192178, "chapter_id": 5086, "verse_number": "१८", "content_sanskrit": "साङ्ख्ये च पठ्यते शास्त्रे नामभिर्बहुधात्मकः।\nविचित्ररूपो विश्वात्मा एकाक्षर इति स्मृतः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2192179, "chapter_id": 5086, "verse_number": "१९", "content_sanskrit": "वृतंनैकात्मकं येन कृत्स्नं त्रैलोक्यमात्मना ।\nतथैव बहुरूपत्वाद् विश्वरूप इति स्मृतः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2192180, "chapter_id": 5086, "verse_number": "२०", "content_sanskrit": "एष वै विक्रियापन्नः सृजत्यात्मानमात्मना ।\nअहङ्कारं महातेजाः प्रजापतिमहङ्कृतम्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2192181, "chapter_id": 5086, "verse_number": "२१", "content_sanskrit": "अव्यक्ताद् व्यक्तमुत्पन्नं विद्यासर्गं वदन्ति तम् ।\nमहान्तं चाप्यहङ्कारमविद्यासर्गमेवच\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2192182, "chapter_id": 5086, "verse_number": "२२", "content_sanskrit": "अपरश्च परश्चैव समुत्पन्नौ तथैकतः ।\nविद्याविद्येति विख्याते श्रुतिशास्त्रार्थचिन्तकैः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2192183, "chapter_id": 5086, "verse_number": "२३", "content_sanskrit": "भूतसर्गमहङ्कारात्तृतीयं विद्धि पार्थिव ।\nअहङ्कारेषु सर्वेषुचतुर्थं विद्धि वैकृतम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2192184, "chapter_id": 5086, "verse_number": "२४", "content_sanskrit": "वायुर्ज्योतिरथाकाशमापोऽथ पृथिवी तथा ।\nशब्दः स्पर्शश्च रूपं च रसो गन्धस्तथैव च\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2192185, "chapter_id": 5086, "verse_number": "२५", "content_sanskrit": "एवंयुगपदुत्पन्नं दशवर्गमसंशयम् ।\nपञ्चमं विद्धि राजेन्द्र भौतिकं सर्गमर्थवत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2192186, "chapter_id": 5086, "verse_number": "२६", "content_sanskrit": "श्रोत्रं त्वक्चक्षुषी जिह्वा घ्राणमेव च पञ्चमम् ।\nवाक्च हस्तौ च पादौ च पायुर्मेढ्रं तथैव च\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2192187, "chapter_id": 5086, "verse_number": "२७", "content_sanskrit": "बुद्धीन्द्रियाणि चैतानितथा कर्मेन्द्रियाणि च ।\nसम्भूतानीह युगपन्मनसा सह पार्थिव\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2192188, "chapter_id": 5086, "verse_number": "२८", "content_sanskrit": "एषा तत्त्वचतुर्विंशा सर्वाकृतिषु वर्तते ।\nयां ज्ञात्वानाभिशोचन्ति ब्राह्मणास्तत्त्वदर्शिनः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2192189, "chapter_id": 5086, "verse_number": "२९", "content_sanskrit": "एतद्देहं समाख्यातं त्रैलोक्ये सर्वदेहिषु ।\nवेदितव्यं नरश्रेष्ठ सदेवनरदानवे॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2192190, "chapter_id": 5086, "verse_number": "३०", "content_sanskrit": "सयक्षभूतगन्धर्वेसकिन्नरमहोरगे ।\nसचारणपिशाचे वै सदेवर्षिनिशाचरे॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2192191, "chapter_id": 5086, "verse_number": "३१", "content_sanskrit": "सदंशकीटमशके सपूतिकृमिमूषके ।\nशुनि श्वपाके वैणेयेसचण्डाले सपुल्कसे\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2192192, "chapter_id": 5086, "verse_number": "३२", "content_sanskrit": "हस्त्यश्वखरशार्दूले सवृक्षे गवि चैव ह ।\nयच्च मूर्तिमयं किञ्चित् सर्वत्रैतन्निदर्शनम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2192193, "chapter_id": 5086, "verse_number": "३३", "content_sanskrit": "जले भुवि तथाकाशे नान्यत्रेति विनिश्चयः ।\nस्थानं देहवतामस्तिइत्येवमनुशुश्रुम\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2192194, "chapter_id": 5086, "verse_number": "३४", "content_sanskrit": "कृत्स्नमेतावतस्तात क्षरते व्यक्तसञ्ज्ञकम् ।\nअहन्यहनि भूतात्मा ततः क्षर इति स्मृतः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2192195, "chapter_id": 5086, "verse_number": "३५", "content_sanskrit": "एतदक्षरमित्युक्तं क्षरतीदं यथा जगत् ।\nजगन्मोहात्मकं प्राहुरव्यक्तं व्यक्तसञ्ज्ञकम्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2192196, "chapter_id": 5086, "verse_number": "३६", "content_sanskrit": "महांश्चैवाग्रजो नित्यमेतत् क्षरनिदर्शनम् ।\nकथितं ते महाराज यस्मान्नावर्तते पुनः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2192197, "chapter_id": 5086, "verse_number": "३७", "content_sanskrit": "पञ्चविंशतिमो विष्णुर्निस्तत्त्वस्तत्त्वसञ्ज्ञकः ।\nतत्त्वसंश्रयणादेतत् तत्त्वमाहुर्मनीषिणः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2192198, "chapter_id": 5086, "verse_number": "३८", "content_sanskrit": "यदमूर्त्यसृजद्व्यक्तं तत्तन्मूर्त्यधितिष्ठति ।\nचतुर्विंशतिमो व्यक्तो ह्यमूर्तःपञ्चविंशकः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2192199, "chapter_id": 5086, "verse_number": "३९", "content_sanskrit": "स एव हृदि सर्वासु मूर्तिष्वातिष्ठतेऽऽत्मवान् ।\nचेतयंश्चेतनो नित्यः सर्वमूर्तिरमूर्तिमान्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2192200, "chapter_id": 5086, "verse_number": "४०", "content_sanskrit": "सर्गप्रलयधर्मिण्याअसर्गप्रळयात्मकः ।\nगोचरे वर्तते नित्यं निर्गुणो गुणसञ्ज्ञकः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2192201, "chapter_id": 5086, "verse_number": "४१", "content_sanskrit": "एवमेष महानात्मा सर्गप्रलयकोविदः ।\nविकुर्वाणः प्रकृतिमानभिमन्यत्यबुद्धिमान्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2192202, "chapter_id": 5086, "verse_number": "४२", "content_sanskrit": "तमःसत्त्वरजोयुक्तस्तासुतास्विह योनिषु ।\nलीयतेऽप्रतिबुद्धत्वादबुद्धजनसेवनात्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2192203, "chapter_id": 5086, "verse_number": "४३", "content_sanskrit": "सहवासो निवासात्मा नान्योऽहमिति मन्यते ।\nयोऽहं सोऽहमिति ह्युक्त्वागुणाननु निवर्तते\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2192204, "chapter_id": 5086, "verse_number": "४४", "content_sanskrit": "तमसा तामसान् भावान् विविधान् प्रतिपद्यते ।\nरजसा राजसांश्चैव सात्त्विकान् सत्त्वसंश्रयात्॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2192205, "chapter_id": 5086, "verse_number": "४५", "content_sanskrit": "शुक्ललोहितकृष्णानि रूपाण्येतानि त्रीणि तु ।\nसर्वाण्येतानि रूपाणि जानीहि प्राकृतानिवै\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2192206, "chapter_id": 5086, "verse_number": "४६", "content_sanskrit": "तामसा निरयं यान्ति राजसा मानुषांस्तथा ।\nसात्त्विका देवलोकाय गच्छन्ति सुखभागिनः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2192207, "chapter_id": 5086, "verse_number": "४७", "content_sanskrit": "निष्कैवल्येन पापेन तिर्यग्योनिमवाप्नुयात् ।\nपुण्यपापेन मानुष्यं पुण्येनैकेन देवताः॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2192208, "chapter_id": 5086, "verse_number": "४८", "content_sanskrit": "एवमव्यक्तविषयं क्षरमाहुर्मनीषिणः ।\nपञ्चविंशतिमो योऽयंज्ञानादेव प्रवर्तते\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2192209, "chapter_id": 5086, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे पञ्चत्रिंशोत्तरतमोऽध्यायः ॥१३५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]