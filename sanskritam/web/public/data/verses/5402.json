[{"id": 2206629, "chapter_id": 5402, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2206630, "chapter_id": 5402, "verse_number": "१", "content_sanskrit": "कार्यते यच्च क्रियते सच्चासच्च कृतं ततः ।\nतत्राश्वसीत सत् कृत्वा असत् कृत्वा न विश्वसेत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2206631, "chapter_id": 5402, "verse_number": "२", "content_sanskrit": "काल एवात्र कालेन निग्रहानुग्रहौ ददत् ।\nबुद्धिमाविश्य भूतानां धर्मार्थेषु प्रवर्तते\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2206632, "chapter_id": 5402, "verse_number": "३", "content_sanskrit": "यदा त्वस्य भवेद् बुद्धिः धर्म्या चार्थप्रदर्शिनी ।\nतदाश्वसीत धर्मात्माऽदृढबुद्धिर्न विश्वसेत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2206633, "chapter_id": 5402, "verse_number": "४", "content_sanskrit": "एतावन्मात्रमेतद्धि भूतानां प्राज्ञलक्षणम् ।\nकालयुक्तोऽप्युभयविच्छेषमर्थं समाचरेत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2206634, "chapter_id": 5402, "verse_number": "५", "content_sanskrit": "यथा ह्युपस्थितैश्वर्याः पूजयन्ते नरा नरान् ।\nएवमेवात्मनाऽऽत्मानं पूजयन्तीह धार्मिकाः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2206635, "chapter_id": 5402, "verse_number": "६", "content_sanskrit": "न ह्यधर्मतया धर्मं दद्यात् कालः कथञ्चन ।\nतस्माद् विशुद्धमात्मानं जानीयाद् धर्मचारिणम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2206636, "chapter_id": 5402, "verse_number": "७", "content_sanskrit": "स्प्रष्टुमप्यसमर्थो हि ज्वलन्तमिव पावकम् ।\nअधर्मः सततो धर्मं कालेन परिरक्षितम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2206637, "chapter_id": 5402, "verse_number": "८", "content_sanskrit": "कार्यावेतौ हि कालेन धर्मो हि विजयावहः ।\nत्रयाणामपि लोकानाम् धर्मो हि शरणं भवेत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2206638, "chapter_id": 5402, "verse_number": "९", "content_sanskrit": "न हि कश्चिन्नयेत् प्राज्ञो गृहीत्वैव करे नरम् ।\nउह्यमानः स धर्मेण धर्मे बहुभयच्छले\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2206639, "chapter_id": 5402, "verse_number": "१०", "content_sanskrit": "शूद्रोऽहं नाधिकारो मे चातुराश्रम्यसेवने ।\nइति विज्ञानमपरे नात्मन्युपदधत्युत\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2206640, "chapter_id": 5402, "verse_number": "११", "content_sanskrit": "विशेषेण च वक्ष्यामि चातुर्वर्ण्यस्य लिङ्गतः ।\nपञ्चभूतशरीराणां सर्वेषां सदृशात्मनाम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2206641, "chapter_id": 5402, "verse_number": "१२", "content_sanskrit": "लोकधर्मे च धर्मे च विशेषकरणं कृतम् ।\nयत्रैकत्वं पुनर्यान्ति प्राणिनस्तत्र विस्तरः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2206642, "chapter_id": 5402, "verse_number": "१३", "content_sanskrit": "अध्रुवो हि कथं लोकः स्मृतो धर्मः कथं ध्रुवः ।\nयत्र कालो ध्रुवस्तात तत्र धर्मः सनातनः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2206643, "chapter_id": 5402, "verse_number": "१४", "content_sanskrit": "सर्वेषां तुल्यदेहानां सर्वेषां सदृशात्मनाम् ।\nकालो धर्मेण संयुक्तः शेष एव सुसङ्ग्रहः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2206644, "chapter_id": 5402, "verse_number": "१५", "content_sanskrit": "एवं सति न दोषोऽस्ति भूतानां धर्मसेवने ।\nतिर्यग्योनावपि सतां काल एव मतो गुरुः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2206645, "chapter_id": 5402, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे शुभकालस्य प्राबल्यकथनं नाम त्रिपञ्चाशोत्तरद्विशततमोऽध्यायः ॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]