[{"id": 40012905, "chapter_id": 9157, "verse_number": "1", "content_sanskrit": "सीता तद्वचनं श्रुत्वा पूर्णचन्द्रनिभानना। हनूमन्तमुवाचेदं धर्मार्थसहितं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40012906, "chapter_id": 9157, "verse_number": "2", "content_sanskrit": "अमृतं विषसंसृष्टं त्वया वानर भाषितम्। यच्च नान्यमना रामो यच्च शोकपरायणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40012907, "chapter_id": 9157, "verse_number": "3", "content_sanskrit": "ऐश्वर्ये वा सुविस्तीर्णे व्यसने वा सुदारुणे। रज्ज्वेव पुरुषं बद्ध्वा कृतान्तः परिकर्षति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40012908, "chapter_id": 9157, "verse_number": "4", "content_sanskrit": "विधिर्नूनमसंहार्यः प्राणिनां प्लवगोत्तम। सौमित्रिं मां च रामं च व्यसनै: पश्य मोहितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40012909, "chapter_id": 9157, "verse_number": "5", "content_sanskrit": "शोकस्यास्य कदा पारं राघवोऽधिगमिष्यति। प्लवमानः परिश्रान्तो हतनौ स्सागरे यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40012910, "chapter_id": 9157, "verse_number": "6", "content_sanskrit": "राक्षसानां वधं कृत्वा सूदयित्वा च रावणम्। लङ्कामुन्मूलितां कृत्वा कदा द्रक्ष्यति मां पतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40012911, "chapter_id": 9157, "verse_number": "7", "content_sanskrit": "स वाच्यस्संत्वरस्वेति यावदेव न पूर्यते। अयं संवत्सरः कालस्तावद्धि मम जीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40012912, "chapter_id": 9157, "verse_number": "8", "content_sanskrit": "वर्तते दशमो मासो द्वौ तु शेषौ प्लवङ्गम। रावणेन नृशंसेन समयो यः कृतो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40012913, "chapter_id": 9157, "verse_number": "9", "content_sanskrit": "विभीषणेन च भ्रात्रा मम निर्यातनं प्रति। अनुनीतः प्रयत्नेन न च तत्कुरुते मतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40012914, "chapter_id": 9157, "verse_number": "10", "content_sanskrit": "मम प्रतिप्रदानं हि रावणस्य न रोचते। रावणं मार्गते संख्ये मृत्युः कालवशं गतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40012915, "chapter_id": 9157, "verse_number": "11", "content_sanskrit": "ज्येष्ठा कन्या नला नाम विभीषणसुता कपे। तया ममेदमाख्यातं मात्रा प्रहितया स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40012916, "chapter_id": 9157, "verse_number": "12", "content_sanskrit": "असंशयं हरिश्रेष्ठ क्षिप्रं मां प्राप्स्यते पतिः। अन्तरात्मा च मे शुद्धस्तस्मिंश्च बहवो गुणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40012917, "chapter_id": 9157, "verse_number": "13", "content_sanskrit": "उत्साहः पौरुषं सत्त्वमानृशंस्यं कृतज्ञता। विक्रमश्च प्रभावश्च सन्ति वानर राघवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40012918, "chapter_id": 9157, "verse_number": "14", "content_sanskrit": "चतुर्दशसहस्राणि राक्षसानां जघान यः। जनस्थाने विना भ्रात्रा शत्रुः कस्तस्य नोद्विजेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40012919, "chapter_id": 9157, "verse_number": "15", "content_sanskrit": "न स शक्यस्तुलयितुं व्यसनैः पुरुषर्षभः। अहं तस्य प्रभावज्ञा शक्रस्येव पुलोमजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40012920, "chapter_id": 9157, "verse_number": "16", "content_sanskrit": "शरजालांशुमान्शूरः कपे रामदिवाकरः। शत्रुरक्षोमयं तोयमुपशोषं नयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40012921, "chapter_id": 9157, "verse_number": "17", "content_sanskrit": "इति सञ्जल्पमानां तां रामार्थे शोककर्शिताम्। आश्रुसम्पूर्णनयनामुवाच वचनं कपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40012922, "chapter_id": 9157, "verse_number": "18", "content_sanskrit": "श्रुत्वैव तु वचो मह्यं क्षिप्रमेष्यति राघवः। चमूं प्रकर्षन्महतीं हर्यृक्षगणसङ्कुलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40012923, "chapter_id": 9157, "verse_number": "19", "content_sanskrit": "अथवा मोचयिष्यामि त्वामद्यैव वरानने। अस्माद्धुःखादुपारोह मम पृष्ठमनिन्दिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40012924, "chapter_id": 9157, "verse_number": "20", "content_sanskrit": "त्वां हि पृष्ठगतां कृत्वा सन्तरिष्यामि सागरम्। शक्तिरस्ति हि मे वोढुं लङ्कामपि सरावणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40012925, "chapter_id": 9157, "verse_number": "21", "content_sanskrit": "अहं प्रस्रवणस्थाय राघवायाद्य मैथिलि। प्रापयिष्यामि शक्राय हव्यं हुतमिवानलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40012926, "chapter_id": 9157, "verse_number": "22", "content_sanskrit": "द्रक्ष्यस्यद्वैव वैदेहि राघवं सहलक्ष्मणम्। व्यवसायसमायुक्तं विष्णुं दैत्यवधे यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40012927, "chapter_id": 9157, "verse_number": "23", "content_sanskrit": "त्वद्दर्शनकृतोत्साहमाश्रमस्थं महाबलम्। पुरन्दरमिवासीनं नागराजस्य मूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40012928, "chapter_id": 9157, "verse_number": "24", "content_sanskrit": "पृष्ठमारोह मे देवि मा विकाङ्क्षस्व शोभने। योगमन्विच्छ रामेण शशाङ्केनेव रोहिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40012929, "chapter_id": 9157, "verse_number": "25", "content_sanskrit": "कथयन्तीव चन्द्रेण सूर्येण च महार्चिषा। मत्पृष्ठमधिरुह्य त्वं तराकाशमहार्णवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40012930, "chapter_id": 9157, "verse_number": "26", "content_sanskrit": "न हि मे सम्प्रयातस्य त्वामितो नयतोऽङ्गने। अनुगन्तुं गतिं शक्तास्सर्वे लङ्कानिवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40012931, "chapter_id": 9157, "verse_number": "27", "content_sanskrit": "यथैवाहमिह प्राप्तस्तथैवाहमसंशयः। यास्यामि पश्य वैदेहि त्वामुद्यम्य विहायसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40012932, "chapter_id": 9157, "verse_number": "28", "content_sanskrit": "मैथिली तु हरिश्रेष्ठाच्छ्रुत्वा वचनमद्भुतम्। हर्षविस्मितसर्वाङ्गी हनुमन्तमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40012933, "chapter_id": 9157, "verse_number": "29", "content_sanskrit": "हनुमन्दूरमध्वानं कथं मां वोढुमिच्छसि। तदेव खलु ते मन्ये कपित्वं हरियूथप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40012934, "chapter_id": 9157, "verse_number": "30", "content_sanskrit": "कथं वाल्पशरीरस्त्वं मामितो नेतुमिच्छसि। सकाशं मानवेन्द्रस्य भर्तुर्मे प्लवगर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40012935, "chapter_id": 9157, "verse_number": "31", "content_sanskrit": "सीताया वचनं श्रुत्वा हनुमान्मारुतात्मजः। चिन्तयामास लक्ष्मीवान्नवं परिभवं कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40012936, "chapter_id": 9157, "verse_number": "32", "content_sanskrit": "न मे जानाति सत्त्वं वा प्रभावं वाऽसितेक्षणा। तस्मात्पश्यतु वैदेही यद्रूपं मम कामतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40012937, "chapter_id": 9157, "verse_number": "33", "content_sanskrit": "इति सञ्चिन्त्य हनुमांस्तदा प्लवगसत्तमः। दर्शयामास वैदेह्यास्स्वरूपमरिमर्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40012938, "chapter_id": 9157, "verse_number": "34", "content_sanskrit": "स तस्मात्पादपाद्धीमानाप्लुत्य प्लवगर्षभः। ततो वर्धितुमारेभे सीताप्रत्ययकारणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40012939, "chapter_id": 9157, "verse_number": "35", "content_sanskrit": "मेरुमन्दरसङ्काशो बभौ दीप्तानलप्रभः। अग्रतो व्यवतस्थे च सीताया वानरोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40012940, "chapter_id": 9157, "verse_number": "36", "content_sanskrit": "हरिः पर्वतसङ्काशस्ताम्रवक्त्रो महाबलः। वज्रदंष्ट्रनखो भीमो वैदेहीमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40012941, "chapter_id": 9157, "verse_number": "37", "content_sanskrit": "सपर्वतवनोद्देशां साट्टप्राकारतोरणाम्। लङ्कामिमां सनाथां वा नयितुं शक्तिरस्ति मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40012942, "chapter_id": 9157, "verse_number": "38", "content_sanskrit": "तदवस्थाप्यतां बुद्धिरलं देवि विकाङ्क्षया। विशोकं कुरु वैदेहि राघवं सहलक्ष्मणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40012943, "chapter_id": 9157, "verse_number": "39", "content_sanskrit": "तं दृष्ट्वा भीमसङ्काशमुवाच जनकात्मजा। पद्मपत्रविशालाक्षी मारुतस्यौरसं सुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40012944, "chapter_id": 9157, "verse_number": "40", "content_sanskrit": "तव सत्त्वं बलं चैव विजानामि महाकपे। वायोरिव गतिं चैव तेजश्चाग्नेरिवाद्भुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40012945, "chapter_id": 9157, "verse_number": "41", "content_sanskrit": "प्राकृतोऽन्यः कथं चेमां भूमिमागन्तुमर्हति। उदधेरप्रमेयस्य पारं वानरपुङ्गव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40012946, "chapter_id": 9157, "verse_number": "42", "content_sanskrit": "जानामि गमने शक्तिं नयने चापि ते मम। अवश्यं सम्प्रधार्याशु कार्यसिद्धिर्महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 40012947, "chapter_id": 9157, "verse_number": "43", "content_sanskrit": "अयुक्तं तु कपिश्रेष्ठ मम गन्तुं त्वयाऽनघ। वायुवेगसवेगस्य वेगो मां मोहयेत्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 40012948, "chapter_id": 9157, "verse_number": "44", "content_sanskrit": "अहमाकाशमापन्ना ह्युपर्युपरि सागरम्। प्रपतेयं हि ते पृष्ठाद्भयाद्वेगेव गच्छतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 40012949, "chapter_id": 9157, "verse_number": "45", "content_sanskrit": "पतिता सागरे चाहं तिमिनक्रझषाकुले। भवेयमाशु विवशा यादसामन्नमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 40012950, "chapter_id": 9157, "verse_number": "46", "content_sanskrit": "न च शक्ष्ये त्वया सार्धं गन्तुं शत्रुविनाशन। कलत्रवति सन्देहस्त्वय्यपि स्यादसंशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 40012951, "chapter_id": 9157, "verse_number": "47", "content_sanskrit": "ह्रियमाणां तु मां दृष्ट्वा राक्षसा भीमविक्रमाः। अनुगच्छेयुरादिष्टा रावणेन दुरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 40012952, "chapter_id": 9157, "verse_number": "48", "content_sanskrit": "तैस्त्वं परिवृतश्शूरैश्शूलमुद्गरपाणिभिः। भवेस्त्वं संशयं प्राप्तो मया वीर कलत्रवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 40012953, "chapter_id": 9157, "verse_number": "49", "content_sanskrit": "सायुधा बहवो व्योम्नि राक्षसास्त्वं निरायुधः। कथं शक्ष्यसि संयातुं मां चैव परिरक्षितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 40012954, "chapter_id": 9157, "verse_number": "50", "content_sanskrit": "युध्यमानस्य रक्षोभिस्तव तैः क्रूरकर्मभिः। प्रपतेयं हि ते पृष्ठाद्भयार्ता कपिसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 40012955, "chapter_id": 9157, "verse_number": "51", "content_sanskrit": "अथ रक्षांसि भीमानि महान्ति बलवन्ति च। कथञ्चित्सांपराये त्वां जयेयुः कपिसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 40012956, "chapter_id": 9157, "verse_number": "52", "content_sanskrit": "अथवा युध्यमानस्य पतेयं विमुखस्य ते। पतितां च गृहीत्वा मां नयेयुः पापराक्षसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 40012957, "chapter_id": 9157, "verse_number": "53", "content_sanskrit": "मां वा हरेयुस्त्वद्धस्ताद्विशसेयुरथापि वा। अव्यवस्थौ हि दृश्येते युद्धे जयपराजयौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 40012958, "chapter_id": 9157, "verse_number": "54", "content_sanskrit": "अहं वापि विपद्येयं रक्षोभिरभितर्जिता। त्वत्प्रयत्नो हरिश्रेष्ठ भवेन्निष्फल एव तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 40012959, "chapter_id": 9157, "verse_number": "55", "content_sanskrit": "कामं त्वमसि पर्याप्तो निहन्तुं सर्वराक्षसान्। राघवस्य यशो हीयेत्त्वया शस्तैस्तु राक्षसैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 40012960, "chapter_id": 9157, "verse_number": "56", "content_sanskrit": "अथवाऽदाय रक्षांसि न्यसेयुस्सम्वृते हि माम्। यत्र ते नाभिजानीयुर्हरयो नापि राघवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 40012961, "chapter_id": 9157, "verse_number": "57", "content_sanskrit": "आरम्भस्तु मदर्थोऽयं ततस्तव निरर्थकः। त्वया हि सह रामस्य महानागमने गुणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 40012962, "chapter_id": 9157, "verse_number": "58", "content_sanskrit": "मयि जीवितमायत्तं राघवस्य महात्मनः। भ्रात्रूणां च महाबाहो तव राजकुलस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 40012963, "chapter_id": 9157, "verse_number": "59", "content_sanskrit": "तौ निराशौ मदर्थं तु शोकसन्तापकर्शितौ। सह सर्वर्क्षहरिभिस्त्यक्ष्यतः प्राणसङ्ग्रहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 40012964, "chapter_id": 9157, "verse_number": "60", "content_sanskrit": "भर्तुर्भक्तिं पुरस्कृत्य रामादन्यस्य वानर। न स्पृशामि शरीरं तु पुंसो वानरपुङ्गव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 40012965, "chapter_id": 9157, "verse_number": "61", "content_sanskrit": "यदहं गात्रसंस्पर्शं रावणस्य बलाद्गता। अनीशा किं करिष्यामि विनाथा विवशा सती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 40012966, "chapter_id": 9157, "verse_number": "62", "content_sanskrit": "यदि रामो दशग्रीवमिह हत्त्वा सबान्धवम्। मामितो गृह्य गच्छेत तत्तस्य सदृशं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 40012967, "chapter_id": 9157, "verse_number": "63", "content_sanskrit": "श्रुता हि दृष्टाश्च मया पराक्रमा महात्मनस्तस्य रणावमर्दिनः। न देवगन्धर्वभुजङ्गराक्षसा भवन्ति रामेण समा हि संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 40012968, "chapter_id": 9157, "verse_number": "64", "content_sanskrit": "समीक्ष्य तं संयति चित्रकार्मुकम् महाबलं वासवतुल्यविक्रमम्। सलक्ष्मणं को विषहेत राघवं हुताशनं दीप्तमिवानिलेरितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 40012969, "chapter_id": 9157, "verse_number": "65", "content_sanskrit": "सलक्ष्मणं राघवमाजिमर्दनं दिशागजं मत्तमिव व्यवस्थितम्। सहेत को वानरमुख्य संयुगे युगान्तसूर्यप्रतिमं शरार्चिषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]