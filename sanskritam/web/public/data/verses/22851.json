[{"id": 7002851000, "chapter_id": 22851, "verse_number": "९-१३६-१", "content_sanskrit": "युधिष्ठिर उवाच ।\nभूतमातेति संहृष्टे ग्रामेग्रामे पुरेपुरे ।\nगायन्नृत्यन्हसंल्लोकः सर्वतः परिधावति ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002851001, "chapter_id": 22851, "verse_number": "९-१३६-२", "content_sanskrit": "उन्मत्तवत्प्रलपति क्षितौ पतति मत्तवत् ।\nक्रुद्धवद्धावति पुरान्मत्तवत्कर्षते बहिः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002851002, "chapter_id": 22851, "verse_number": "९-१३६-३", "content_sanskrit": "मुखांगभंगान्कुरुते लोके वातगृहीतवत् ।\nभूतवद्भस्मगात्रं तु कर्दमानवगाहते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002851003, "chapter_id": 22851, "verse_number": "९-१३६-४", "content_sanskrit": "किमेष शास्त्रनिर्दिष्टो मार्गः किमुत लौकिकः ।\nमुह्यते मे मनः कृष्ण त्वं तु वक्तुमिहार्हसि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002851004, "chapter_id": 22851, "verse_number": "९-१३६-५", "content_sanskrit": "श्रीकृष्ण उवाच ।\nशृणु पार्थ प्रवक्ष्यामि यत्ते किञ्चिन्मनोगतम् ।\nआस्तिकः श्रद्दधानश्च भवतीति मतिर्मम ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002851005, "chapter_id": 22851, "verse_number": "९-१३६-६", "content_sanskrit": "पार्वत्या सहितः पार्थ मन्दरे चारुकन्दरे ।\nक्रीडन्नास्ते मुदा युक्तो दिव्यक्रीडनकैर्हरः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002851006, "chapter_id": 22851, "verse_number": "९-१३६-७", "content_sanskrit": "हंसोन्नतगतिं चारुकुम्भभ्राजिकुचद्वयम् ।\nसिञ्जत्सद्रशनां हृष्टां दृष्ट्वा गौरीं जगद्गुरुः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002851007, "chapter_id": 22851, "verse_number": "९-१३६-८", "content_sanskrit": "दग्धकामोऽपि च हरः संदीप्तमदनोऽभवत् ।\nनिःसृतां कामयामास महार्हशयने शिवः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002851008, "chapter_id": 22851, "verse_number": "९-१३६-९", "content_sanskrit": "रतस्थयोस्तयोर्जातं दिव्यवर्षशतं यदा ।\nतदा देवीसमुच्छ्रायनिरोधान्निर्गता बहिः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002851009, "chapter_id": 22851, "verse_number": "९-१३६-१०", "content_sanskrit": "मूत्रोदकात्समुत्तस्थौ नारी निर्दारितोदरा ।\nकृष्णा करालवदना पिंगाक्षा मुक्तमूर्द्धजा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002851010, "chapter_id": 22851, "verse_number": "९-१३६-११", "content_sanskrit": "कपालमालाभरणा बद्धपिंडोर्ध्वपिंडिका ।\nखट्वाङ्गकं कालधरा मुद्राङ्कितकरा शिवा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002851011, "chapter_id": 22851, "verse_number": "९-१३६-१२", "content_sanskrit": "व्याघ्रचर्मांबरधरा रणत्किंकिणिमेखला ।\nडमड्डमड्डमरुका फूत्कारापूरितांबरा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002851012, "chapter_id": 22851, "verse_number": "९-१३६-१३", "content_sanskrit": "तस्याः पार्श्वानुजाश्चान्या गीतवाद्यलयानुगाः ।\nउत्तालतालमबला नृत्यंति च हसंति च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002851013, "chapter_id": 22851, "verse_number": "९-१३६-१४", "content_sanskrit": "कपालखट्वाङ्गधरा गजचर्मावगुण्ठिताः ।\nतथैव शंकराज्जातस्तद्रूपाभरणः पुमान् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002851014, "chapter_id": 22851, "verse_number": "९-१३६-१५", "content_sanskrit": "अनुगम्यमानो बहुभिर्भूतैरतिभयंकरैः ।\nसिंहशार्दूलवदनै रदनोल्लिखितांबरैः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002851015, "chapter_id": 22851, "verse_number": "९-१३६-१६", "content_sanskrit": "एकीभूतैः क्षणेनैव तौ भवानीभवोद्भवौ ।\nदृष्ट्वा हृष्टमना देवः प्राह देवीं सुविस्मिताम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002851016, "chapter_id": 22851, "verse_number": "९-१३६-१७", "content_sanskrit": "कल्याणि पश्य पश्यैतौ मत्त्वदङ्गसमुद्भवौ ।\nबीभत्साद्भुतशृंगारवरायुधविधारिणौ ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002851017, "chapter_id": 22851, "verse_number": "९-१३६-१८", "content_sanskrit": "भ्रातृभांडौ यथा देवि तद्वदेतौ मतौ मम ।\nनृनार्योरंतरं किञ्चित्सादृश्यात्प्रतिभासयेत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002851018, "chapter_id": 22851, "verse_number": "९-१३६-१९", "content_sanskrit": "भ्रातृभांडा भूतमाता तथैवोदकसेविका ।\nसंज्ञात्रयं तयोः कृत्वा ततः प्रादाद्वरं हरः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002851019, "chapter_id": 22851, "verse_number": "९-१३६-२०", "content_sanskrit": "भुक्त्वार्होपगतां चैतां जरत्तरुतले स्थिताम् ।\nसेवयिष्यंति ये भक्त्या जलसंपूर्णकंडुकैः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002851020, "chapter_id": 22851, "verse_number": "९-१३६-२१", "content_sanskrit": "चन्दनेन समालभ्य पुष्पधूपैरथार्च्य ताम् ।\nभोजयेत्क्षिप्रया चैव कृशरापूपपायसैः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002851021, "chapter_id": 22851, "verse_number": "९-१३६-२२", "content_sanskrit": "य एवं कुरुते देवि भक्तिभावेन भावितः ।\nस पुत्रपशुवृद्धिं च शरीरारोग्यमाप्नुयात् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002851022, "chapter_id": 22851, "verse_number": "९-१३६-२३", "content_sanskrit": "न शाकिन्यो गृहे तस्य न पिशाचा न राक्षसाः ।\nपीडां कुर्वंति शिशवो यांति वृद्धिं निरामयाः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002851023, "chapter_id": 22851, "verse_number": "९-१३६-२४", "content_sanskrit": "युधिष्ठिर उवाच ।\nकदा पूजा प्रकर्तव्या भूतमातुः सुखार्थिभिः ।\nपुरुषैः पुरुषव्याघ्र यत्तन्मे वक्तुमर्हसि ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002851024, "chapter_id": 22851, "verse_number": "९-१३६-२५", "content_sanskrit": "श्रीकृष्ण उवाच ।\nसर्वत्रैषा भगवती बालानां हितकारिणी ।\nनामभेदैः क्रियाभेदैः कालभेदैश्च पूज्यते ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002851025, "chapter_id": 22851, "verse_number": "९-१३६-२६", "content_sanskrit": "प्रतिपत्प्रभृति ज्येष्ठे यावत्पंचदशी तिथिः ।\nतावत्पूजा प्रकर्तव्या प्रेरणैः प्रेक्षणीयकैः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002851026, "chapter_id": 22851, "verse_number": "९-१३६-२७", "content_sanskrit": "विकर्मफलनिर्देशः पांडवानां विडंबनम् ।\nप्रदृश्यंते हास्यपरैर्नरैरद्भुतचेष्टितैः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002851027, "chapter_id": 22851, "verse_number": "९-१३६-२८", "content_sanskrit": "विश्वास्यधनलोभेन संध्यायां निहतः पथि ।\nआरोहणं च शूलाग्रे न पश्यंतं हि पश्यति ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002851028, "chapter_id": 22851, "verse_number": "९-१३६-२९", "content_sanskrit": "दृष्टो भवद्भिः संहृष्टः परपारावमर्शकः ।\nछित्त्वा स्वहस्तैर्यद्दत्तो विभुना मुख्यमोदकः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002851029, "chapter_id": 22851, "verse_number": "९-१३६-३०", "content_sanskrit": "शीर्णसूक्ष्मेण पत्रेण बाला मालानुमोदिताः ।\nमुष्कभुग्रासमारूढो मुखं कृत्वा च पश्चिमे ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002851030, "chapter_id": 22851, "verse_number": "९-१३६-३१", "content_sanskrit": "हे जनाः किं न पश्यध्वं स्वामिद्रोहकरं परम् ।\nकरपत्रैर्विदार्यंतमुच्छलच्छोणितच्छटम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002851031, "chapter_id": 22851, "verse_number": "९-१३६-३२", "content_sanskrit": "चरैः किलासैः संप्राप्तः सर्वोद्वेगकरः परम् ।\nदंडप्रहाराभिहतो नीयते दंडपाशिकैः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002851032, "chapter_id": 22851, "verse_number": "९-१३६-३३", "content_sanskrit": "प्रेक्षकैर्वेष्टितः स्तेनो रटत्येष विमोहितः ।\nसंयम्य नीयतेयं तु मूर्खः क्रौर्याविलेक्षणः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002851033, "chapter_id": 22851, "verse_number": "९-१३६-३४", "content_sanskrit": "सितकेशं सितश्मश्रुसितांबरधरं द्विजम् ।\nवटचेष्टाचपेटाभिर्हन्यमानं न पश्यत ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002851034, "chapter_id": 22851, "verse_number": "९-१३६-३५", "content_sanskrit": "गृहान्निष्क्रम्यतां रंडा वृद्धो भूत्वाप्यसौ स्त्रियाः ।\nस्वस्या असौ न कुरुते मूढो भरणपोषणम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002851035, "chapter_id": 22851, "verse_number": "९-१३६-३६", "content_sanskrit": "भैरवाभरणोत्ताला व्यालयज्ञोपवीतिनः ।\nप्रदत्त्वाताण्डवपदान्पश्यध्वं ध्वांतदीपकान् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002851036, "chapter_id": 22851, "verse_number": "९-१३६-३७", "content_sanskrit": "निर्वेदकोऽस्य हृदये न किंचिदपि तिष्ठति ।\nगृहीतं यदनेनेदं बालेनापि महाव्रतम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002851037, "chapter_id": 22851, "verse_number": "९-१३६-३८", "content_sanskrit": "रक्तदृक्काककृष्णांगं शबरं किं न पश्यत ।\nतरुकोटरांतरगतांश्छित्वा च शुकशावकान् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002851038, "chapter_id": 22851, "verse_number": "९-१३६-३९", "content_sanskrit": "बहुभिः कोष्ठकीकृत्य शरौघैः शकलीकृतम् ।\nविमुक्तढक्काहंकारसुप्रहारं निरीक्षत ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002851039, "chapter_id": 22851, "verse_number": "९-१३६-४०", "content_sanskrit": "इमां कृष्णार्द्धवदनां गृहीतां सिंदुरार्चिताम् ।\nविमुक्तकेशां नृत्यंतीं पश्यध्वं योगिनीमिव ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002851040, "chapter_id": 22851, "verse_number": "९-१३६-४१", "content_sanskrit": "गंभीरतूर्यध्वनिना प्रबुद्धां वृत्ततांडवाम् ।\nएवं प्रेक्षणकं कृत्वा नयेत्वृक्षतले च ताम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002851041, "chapter_id": 22851, "verse_number": "९-१३६-४२", "content_sanskrit": "एवं कृते न दारिद्र्यं न च दुःखं भवेन्नृणाम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]