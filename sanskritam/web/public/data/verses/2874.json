[{"id": 2088124, "chapter_id": 2874, "verse_number": "१३-४-१", "content_sanskrit": "भीष्म उवाच।\nएवमुक्तो मतङ्गस्तु संशितात्मा यतव्रतः।\nअतिष्ठदेकपादेन वर्षाणां शतमच्युतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2088125, "chapter_id": 2874, "verse_number": "१३-४-२", "content_sanskrit": "तमुवाच ततः शक्रः पुनरेव महायशाः।\nब्राह्मण्यं दुर्लभं तात प्रार्थयानो न लप्स्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2088126, "chapter_id": 2874, "verse_number": "१३-४-३", "content_sanskrit": "मतङ्ग परमं स्थानं प्रार्थयन्विनशिष्यसि।\nमा कृथाः साहसं पुत्र नैष धर्मपथस्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2088127, "chapter_id": 2874, "verse_number": "१३-४-४", "content_sanskrit": "`विमार्गतो मार्गमाणः सर्वथा नभविष्यसि।\nन हि शक्यं त्वया प्राप्तुं ब्राह्मण्यमिह दुर्मते।\nअप्राप्यं प्रार्थयानो हि नचिराद्विनशिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2088128, "chapter_id": 2874, "verse_number": "१३-४-५", "content_sanskrit": "मतङ्ग परमं स्थानं वार्यमाणोऽसकृन्मया।\nचिकीर्षस्येव तपसा सर्वथा नभविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2088129, "chapter_id": 2874, "verse_number": "१३-४-६", "content_sanskrit": "तिर्यग्योनिगतः सर्वो मानुष्यं यदि गच्छति।\nस जायते पुल्कसो वा चण्डालो वाऽप्यसंशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2088130, "chapter_id": 2874, "verse_number": "१३-४-७", "content_sanskrit": "पुल्कसः पापयोनिर्वा यः कश्चिदिह लक्ष्यते।\nस तस्यामेव सुचिरं मतङ्ग परिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2088131, "chapter_id": 2874, "verse_number": "१३-४-८", "content_sanskrit": "ततो दशशते काले लभते शूद्रतामपि।\nशूद्रयोनावपि ततो बहुशः परिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2088132, "chapter_id": 2874, "verse_number": "१३-४-९", "content_sanskrit": "ततस्त्रिंशद्गणे काले लभते वैश्यतामपि।\nवैश्यतायां चिरं कालं तत्रैव परिवर्तते।\nततः षष्टिगुणे काले राजन्यो नाम जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2088133, "chapter_id": 2874, "verse_number": "१३-४-१०", "content_sanskrit": "ततः षष्टिगुणे काले लभते ब्रह्मबन्धुताम्।\nब्रह्मबन्धुश्चिरं कालं ततस्तु परिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2088134, "chapter_id": 2874, "verse_number": "१३-४-११", "content_sanskrit": "ततस्तु द्विशते काले लभते काण्डपृष्ठताम्।\nकाण्डपृष्ठश्चिरं कालं तत्रैव परिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2088135, "chapter_id": 2874, "verse_number": "१३-४-१२", "content_sanskrit": "ततस्तु त्रिशते काले लभते जपतामपि।\nतं च प्राप्य चिरं कालं तत्रैव परिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2088136, "chapter_id": 2874, "verse_number": "१३-४-१३", "content_sanskrit": "ततश्चतुःशते काले श्रोत्रियो नाम जायते।\nश्रोत्रियत्वे चिरं कालं तत्रैव परिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2088137, "chapter_id": 2874, "verse_number": "१३-४-१४", "content_sanskrit": "तदेवं शोकहर्षौ तु कामद्वेषौ च पुत्रक।\nअतिमानातिवादौ च प्रविशेते द्विजाधमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2088138, "chapter_id": 2874, "verse_number": "१३-४-१५", "content_sanskrit": "तांश्चेज्जयति शत्रून्स तदा प्राप्नोति सद्गतिम्।\nअथ ते वै जयन्त्येनं तालं पक्वमिवापतेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2088139, "chapter_id": 2874, "verse_number": "१३-४-१६", "content_sanskrit": "मतङ्ग सम्प्रधार्यैवं यदहं त्वामचूचुदम्।\nवृणीष्व काममन्यं त्वं ब्राह्मण्यं हि सुदुर्लभम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2088140, "chapter_id": 2874, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि चतुर्थोऽध्यायः॥ ४ ॥।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]