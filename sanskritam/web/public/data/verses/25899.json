[{"id": 7005899000, "chapter_id": 25899, "verse_number": "१-८२-१", "content_sanskrit": "ब्रह्मोवाच ।\nसारात्सारतरं व्यास गयाभाहात्म्यमुत्तमम् ।\nप्रवक्ष्यामि समासेन भुक्तिमुक्तिप्रदं श्रृणु ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005899001, "chapter_id": 25899, "verse_number": "१-८२-२", "content_sanskrit": "गयासुरोऽभवत्पूर्वं वीर्य्यवान्परमः सच।\nतपस्तप्यन्महाघोरं सर्वभूतोपतापनम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005899002, "chapter_id": 25899, "verse_number": "१-८२-३", "content_sanskrit": "तत्तपस्तापिता देवास्तद्वधार्थं हरिं गताः ।\nशरणं हरिरूचे तान् भवितव्यं शिवात्मभइः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005899003, "chapter_id": 25899, "verse_number": "१-८२-४", "content_sanskrit": "पात्यतेऽस्य महादेहो तथेत्यूचुः सुरा हरिम।\nकदाचिच्छिवपूजार्थं क्षीराब्धेः कमलानि च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005899004, "chapter_id": 25899, "verse_number": "१-८२-५", "content_sanskrit": "आनीय कीकटे देशे शयनं चाकरोद्वली ।\nविष्णुमायाविमूढोऽसौ गदया विष्णुना हतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005899005, "chapter_id": 25899, "verse_number": "१-८२-६", "content_sanskrit": "अतो गदाधरो विष्णुर्गयायां मुक्तिदः स्थितः ।\nतस्य देहो लिङ्गरूपी स्थितः शुद्धे पितामहः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005899006, "chapter_id": 25899, "verse_number": "१-८२-७", "content_sanskrit": "जनार्द्दनश्च कालेशस्तथान्यः प्रपितामहः ।\nविष्णुराहाथ मर्य्यादां पुण्यक्षेत्रं भविष्यति ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005899007, "chapter_id": 25899, "verse_number": "१-८२-८", "content_sanskrit": "यज्ञं श्राद्धं पिण्डदानं स्नानादि कुरुते नरः ।\nस स्वर्गं ब्रह्मलोकं च गच्छेन्न नरकं नरः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005899008, "chapter_id": 25899, "verse_number": "१-८२-९", "content_sanskrit": "गयातीर्थं परं ज्ञात्वा यागं चक्रे पितामह।\nब्राह्मणान्पूजयामास ऋत्विगर्थमुपागतान् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005899009, "chapter_id": 25899, "verse_number": "१-८२-१०", "content_sanskrit": "महानदीं रसवहां सृष्ट्वा वाप्यादिकं तथा ।\nभक्ष्यभोज्यफलादींश्च कामधेनुं तथासृजत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005899010, "chapter_id": 25899, "verse_number": "१-८२-११", "content_sanskrit": "पञ्चक्रोशं गया क्षेत्रं ब्राह्मणेभ्यो ददौपरभुः।\nधर्मयागेषु लोभात्तु प्रतिगृह्य धनादिकम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005899011, "chapter_id": 25899, "verse_number": "१-८२-१२", "content_sanskrit": "स्थिता विप्रास्तदा शप्ता गयायां ब्राह्मणास्ततः ।\nमा भूत्त्रैपुरुषी विद्या मा भूत्त्रैपुरुषं धनम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005899012, "chapter_id": 25899, "verse_number": "१-८२-१३", "content_sanskrit": "युष्माकं स्याद्वारिवहा नदी पाषाणपर्वतः ।\nशप्तैस्तु प्रार्थितो ब्रह्मानुग्रहं कृतवान्प्रभुः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005899013, "chapter_id": 25899, "verse_number": "१-८२-१४", "content_sanskrit": "लोकाः पुण्या गयायां हि श्राद्धिनो ब्रह्मलोकगा।\nयुष्मान्ये पूजयिष्यन्ति तैरहं पूजितः सदा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005899014, "chapter_id": 25899, "verse_number": "१-८२-१५", "content_sanskrit": "ब्रह्मज्ञानं गयाश्राद्धं गोगृहे मरणं तथा ।\nवासः पुंसां कुरुक्षेत्रे मुक्तिरेषा चतुर्विधा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005899015, "chapter_id": 25899, "verse_number": "१-८२-१६", "content_sanskrit": "समुद्राः सरितः सर्वा वापीकूपह्रदास्तथा ।\nस्नातुकामा गयातीर्थं व्यास यान्ति न संशयः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005899016, "chapter_id": 25899, "verse_number": "१-८२-१७", "content_sanskrit": "ब्रह्महत्या सुरापानं स्तेयं गुर्वंगनागमः ।\nपापं तत्सङ्गजं सर्वं गयाश्राद्धाद्विनश्यति ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005899017, "chapter_id": 25899, "verse_number": "१-८२-१८", "content_sanskrit": "असंस्कृता मृता य च पशुचोरहताश्च ये ।\nसर्पदष्टा गयाश्राद्धान्मुक्ताः स्वर्गं व्रजन्ति ते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005899018, "chapter_id": 25899, "verse_number": "१-८२-१९", "content_sanskrit": "गयायां पिण्डदानेन यत्फलं लभते नरः ।\nन तच्छक्यं मया वक्तुं वर्षकोटिशतैरपि ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]