[{"id": 2049794, "chapter_id": 2093, "verse_number": "७-२०-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2049795, "chapter_id": 2093, "verse_number": "७-२०-१", "content_sanskrit": "परिणाम्य निशां तां तु भारद्वाजो महारथः।\nउक्त्वा सुबहु राजेन्द्र वचनं वै सुयोधनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2049796, "chapter_id": 2093, "verse_number": "७-२०-२", "content_sanskrit": "विधाय गोप्तॄन्पार्थस्य संशप्तकगणैः सह।\nनिष्क्रान्ते च तदा पार्थे संशप्तकवधं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2049797, "chapter_id": 2093, "verse_number": "७-२०-३", "content_sanskrit": "व्यूढानीकस्ततो द्रोणः पाण्डवानां महाचमूम्।\nअभ्ययाद्भरतश्रेष्ठ धर्मराजजिघृक्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2049798, "chapter_id": 2093, "verse_number": "७-२०-४", "content_sanskrit": "व्यूढां दृष्ट्वा सुपर्णेन भारद्वाजस्य तां चमूम्।\nव्यूहेन मण्डलार्धेन प्रत्यव्यूहद्युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2049799, "chapter_id": 2093, "verse_number": "७-२०-५", "content_sanskrit": "मुखं त्वासीत्सुपर्णस्य भारद्वाजो महारथः।\nशिरो दुर्योधनो राजा सोदर्यैः सानुगैर्वृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2049800, "chapter_id": 2093, "verse_number": "७-२०-६", "content_sanskrit": "चक्षुषी कृतवर्माऽऽसीद्गौतमश्चास्यतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2049801, "chapter_id": 2093, "verse_number": "७-२०-७", "content_sanskrit": "भूतशर्मा क्षेमशर्मा करकाक्षश्च वीर्यवान्।\nकलिङ्गाः सिंहलाः प्राच्याः शूरा भीरा दशेरकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2049802, "chapter_id": 2093, "verse_number": "७-२०-८", "content_sanskrit": "शका यवनकाम्भोजास्तथा हंसपथाश्च ये।\nग्रीवायां शूरसेनाश्च दरन्दा मद्रकेकयाः।\nगजाश्वरथपत्त्योघास्तस्थुः परमदंशिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2049803, "chapter_id": 2093, "verse_number": "७-२०-९", "content_sanskrit": "भूरिश्रवास्तथा शल्यः सोमदत्तश्च बाह्लिकः।\nअक्षौहिण्या वृता वीरा दक्षिणं पार्श्वमास्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2049804, "chapter_id": 2093, "verse_number": "७-२०-१०", "content_sanskrit": "विन्दानुविन्दावावन्त्यौ काम्भोजश्च सुदक्षिणः।\nवामं पार्श्वं समाश्रित्य द्रोणपुत्राग्रतः स्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2049805, "chapter_id": 2093, "verse_number": "७-२०-११", "content_sanskrit": "पृष्ठे कलिङ्गाः साम्बष्ठा मागधाः पौण्ड्रमद्रकाः।\nगान्धाराः शकुनाः प्राच्याः पार्वतीया वसातयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2049806, "chapter_id": 2093, "verse_number": "७-२०-१२", "content_sanskrit": "पुच्छे वैकर्तनः कर्णः सपुत्रज्ञातिबान्धवः।\nमहत्या सेनया तस्थौ नानाजनपदोत्थया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2049807, "chapter_id": 2093, "verse_number": "७-२०-१३", "content_sanskrit": "जयद्रथो भीमरथः सम्पातिर्ऋषभो जयः।\nभूमिञ्जयो वृषक्राथो नैषधश्च महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2049808, "chapter_id": 2093, "verse_number": "७-२०-१४", "content_sanskrit": "वृता बलेन महता ब्रह्मलोकपरिष्कृताः।\nव्यूहस्योरसि ते राजन्स्थिता युद्धविशारदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2049809, "chapter_id": 2093, "verse_number": "७-२०-१५", "content_sanskrit": "द्रोणेन विहितो व्यूहः पदात्यश्वरथद्विपैः।\nवातोद्धूतार्णवाकारः प्रनृत्त इव लक्ष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2049810, "chapter_id": 2093, "verse_number": "७-२०-१६", "content_sanskrit": "तस्य पक्षप्रपक्षेभ्यो निष्पतन्ति युयुत्सवः।\nसविद्युत्स्तनिता मेघाः सर्वदिग्भ्यः इवोष्णगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2049811, "chapter_id": 2093, "verse_number": "७-२०-१७", "content_sanskrit": "तस्य प्राग्ज्योतिषो मध्ये विधिवत्कल्पितं गजम्।\nआस्थितः शुशुभे राजन्नंशुमानुदये यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2049812, "chapter_id": 2093, "verse_number": "७-२०-१८", "content_sanskrit": "माल्यदामवता राजञ्श्वेतच्छत्रेण धार्यता।\nकृत्तिकायोगयुक्तेन पौर्णमास्यामिवेन्दुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2049813, "chapter_id": 2093, "verse_number": "७-२०-१९", "content_sanskrit": "नीलाञ्जनचयप्रख्यो मदान्धो द्विरदो बभौ।\nअतिवृष्टो महामेघैर्यथा स्यात्पर्वतो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2049814, "chapter_id": 2093, "verse_number": "७-२०-२०", "content_sanskrit": "नानानृपतिभिर्वीरै र्विविधायुधभूषणैः।\nसमन्वितः पार्वतीयैः शक्रो देवगणैरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2049815, "chapter_id": 2093, "verse_number": "७-२०-२१", "content_sanskrit": "ततो युधिष्ठिरः प्रेक्ष्य व्यूहं तमतिमानुषम्।\nअजय्यमरिभिः सङ्ख्ये पार्षतं वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2049816, "chapter_id": 2093, "verse_number": "७-२०-२२", "content_sanskrit": "ब्राह्मणस्य वशं नाहमियामद्य यथा प्रभो।\nपारावतसवर्णाश्व तथा नीतिर्विधीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2049817, "chapter_id": 2093, "verse_number": "७-२०-२३x", "content_sanskrit": "धृष्टद्युम्न उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2049818, "chapter_id": 2093, "verse_number": "७-२०-२३", "content_sanskrit": "द्रोणस्य यतमानस्य वशं नैष्यसि सुव्रत।\nअहमावारयिष्यामि द्रोणमद्य सहानुगम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2049819, "chapter_id": 2093, "verse_number": "७-२०-२४", "content_sanskrit": "मयि जीवति कौरव्य नोद्वेगं कर्तुमर्हसि।\nन हि शक्तो रणे द्रोणो विजेतुं मां कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2049820, "chapter_id": 2093, "verse_number": "७-२०-२५x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2049821, "chapter_id": 2093, "verse_number": "७-२०-२५", "content_sanskrit": "एवमुक्त्वा किरन्बाणान्द्रुपदस्य सुतो बली।\nपारावतसवर्णाश्वः स्वयं द्रोणमुपाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2049822, "chapter_id": 2093, "verse_number": "७-२०-२६", "content_sanskrit": "अनिष्टदर्शनं दृष्ट्वा धृष्टद्युम्नमवस्थितम्।\nक्षणेनैवाभवद्द्रोणो नातिहृष्टमना इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2049823, "chapter_id": 2093, "verse_number": "७-२०-२७", "content_sanskrit": "`स हि जातो महाराज द्रोणस्य निधनं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2049824, "chapter_id": 2093, "verse_number": "७-२०-२८", "content_sanskrit": "मर्त्यधर्मतया तस्माद्भारद्वाजो व्यमुह्यत।\nनाशकत्तत्र तत्किञ्चिदनीकं प्रतिवीक्षितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2049825, "chapter_id": 2093, "verse_number": "७-२०-२९", "content_sanskrit": "ततः किरन्निषूंस्तीक्ष्णान्द्रुपदस्य वरूथिनीम्।\nभराद्वाजो ययौ तूर्णं पार्षतं वर्जयन्युधि।\nद्रुपदस्य महत्सैन्यं दारयामास ब्राह्मणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2049826, "chapter_id": 2093, "verse_number": "७-२०-३०", "content_sanskrit": "तं तु सम्प्रेक्ष्य पुत्रस्ते दुर्मुखः शत्रुकर्षणः।\nप्रियं चिकीर्षुर्द्रोणस्य धृष्टद्युम्नमवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2049827, "chapter_id": 2093, "verse_number": "७-२०-३१", "content_sanskrit": "स सम्प्रहारस्तुमुलः सुघोरः समपद्यत।\nपार्षतस्य च शूरस्य दुर्मुखस्य च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2049828, "chapter_id": 2093, "verse_number": "७-२०-३२", "content_sanskrit": "पार्षतः शरजालेन क्षिप्रं प्रच्छाद्य दुर्मुखम्।\nभारद्वाजं शरौघेण महता समवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2049829, "chapter_id": 2093, "verse_number": "७-२०-३३", "content_sanskrit": "द्रोणावारितं दृष्ट्वा भृशायस्तस्तवात्मजः।\nनानालिङ्गैः शरव्रातैः पार्षतं सममोहयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2049830, "chapter_id": 2093, "verse_number": "७-२०-३४", "content_sanskrit": "तयोर्विषक्तयोः सङ्ख्ये पाञ्चाल्यकुरुमुख्ययोः।\nद्रोणो यौधिष्ठिरं सैन्यं बहुधा व्यधमच्छरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2049831, "chapter_id": 2093, "verse_number": "७-२०-३५", "content_sanskrit": "अनिलेन यथाऽभ्राणि विच्छिन्नानि समन्ततः।\nतथा पार्थस्य सैन्यानि विच्छिन्नानि क्वचित्क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2049832, "chapter_id": 2093, "verse_number": "७-२०-३६", "content_sanskrit": "मुहूर्तमिव तद्युद्धमासीन्मधुरदर्शनम्।\nतत उन्मत्तवद्राजन्निर्मर्यादमवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2049833, "chapter_id": 2093, "verse_number": "७-२०-३७", "content_sanskrit": "`नैव खं न दिशो भूमिर्बभासे न च भास्करः।\nनैव स्वे न परे राजन्नाज्ञायन्त परस्परम्।\nअनुमानेन संज्ञाभिर्युद्धं तत्समवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2049834, "chapter_id": 2093, "verse_number": "७-२०-३८", "content_sanskrit": "चूडामणिषु निष्केषु भूषणेष्वपि वर्मसु।\nतेषामादित्यवर्णाभा रश्मयः प्रचकाशिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2049835, "chapter_id": 2093, "verse_number": "७-२०-३९", "content_sanskrit": "तत्प्रकीर्णपताकानां रथवारणवाजिनाम्।\nबलाकाशबलाभ्रामं ददृशे रूपमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2049836, "chapter_id": 2093, "verse_number": "७-२०-४०", "content_sanskrit": "नरानेव नरा जघ्नरुदग्राश्च हया हयान्।\nरथांश्च रथिनो जघ्नुर्वारणा वरवारणान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2049837, "chapter_id": 2093, "verse_number": "७-२०-४१", "content_sanskrit": "समुच्छ्रितपताकानां गजानां परमद्विपैः।\nक्षणेन तुमुलो घोरः सङ्ग्रामः समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2049838, "chapter_id": 2093, "verse_number": "७-२०-४२", "content_sanskrit": "तेषां संसक्तगात्राणां कर्षतामितरेतरम्।\nदन्तसङ्घातसङ्घर्षात्सधूमोऽग्निरजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2049839, "chapter_id": 2093, "verse_number": "७-२०-४३", "content_sanskrit": "विप्रकीर्णपताकास्ते विषाणजनिताग्नयः।\nबभूवुः खं समासाद्य सविद्युत इवाम्बुदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2049840, "chapter_id": 2093, "verse_number": "७-२०-४४", "content_sanskrit": "विक्षिपद्भिर्नदद्भिश्च निपतद्भिश्च वारणैः।\nसम्बभूव मही कीर्णा मेघैर्द्यौरिव वार्षिकी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2049841, "chapter_id": 2093, "verse_number": "७-२०-४५", "content_sanskrit": "तेषामाहन्यमानानां बाणतोमरऋष्टिभिः।\nवारणानां रवो जज्ञे मेघानामिव सम्पुवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2049842, "chapter_id": 2093, "verse_number": "७-२०-४६", "content_sanskrit": "तोमराभिहताः केचिद्बाणैश्च परमद्विपाः।\nवित्रेसुः सर्वनागानां शब्दमेवापरेऽसृजन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2049843, "chapter_id": 2093, "verse_number": "७-२०-४७", "content_sanskrit": "विषाणाभिहताश्चापि केचित्तत्र गजा गजैः।\nचक्रुरार्तस्वनं घोरमुत्पातजलदा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2049844, "chapter_id": 2093, "verse_number": "७-२०-४८", "content_sanskrit": "प्रतीपाः क्रियमाणाश्च वारणा वरवारणैः।\nउन्मथ्य पुनराजग्मुः प्रेरिताः परमाङ्कुशैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2049845, "chapter_id": 2093, "verse_number": "७-२०-४९", "content_sanskrit": "महामात्रैर्महामात्रास्ताडिताः शरतोमरैः।\nगजेभ्यः पृथिवीं जग्मुर्मुक्तप्रहरणाङ्कुशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2049846, "chapter_id": 2093, "verse_number": "७-२०-५०", "content_sanskrit": "निर्मनुष्याश्च मातङ्गा विनदन्तस्ततस्ततः।\nछिन्नाभ्राणीव सम्पेतुः सम्प्रविश्य परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2049847, "chapter_id": 2093, "verse_number": "७-२०-५१", "content_sanskrit": "हतान्परिवहन्तश्च पतितान्पतितायुधान्।\nदिशो जग्मुर्महानागाः केचिदेकचरा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2049848, "chapter_id": 2093, "verse_number": "७-२०-५२", "content_sanskrit": "ताडितास्ताड्यमानाश्च तोमरर्ष्टिपरश्वथैः।\nपेतुरार्तस्वनं कृत्वा तदा विशसने गजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2049849, "chapter_id": 2093, "verse_number": "७-२०-५३", "content_sanskrit": "तेषां शैलोपमैः कायैर्निपतद्भिः समन्ततः।\nआहता सहसा भूमिश्चकम्पे च ननाद च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2049850, "chapter_id": 2093, "verse_number": "७-२०-५४", "content_sanskrit": "सादितैः सगजारोहैः सपताकैः समन्ततः।\nमातङ्गैः शुशुभे भूमिर्विकीर्णैरिव पर्वतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2049851, "chapter_id": 2093, "verse_number": "७-२०-५५", "content_sanskrit": "गजस्थाश्च महामात्रा निर्भिन्नहृदया रणे।\nरथिभिः पातिता भल्लैर्विकीर्णाङ्कुशतोमराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2049852, "chapter_id": 2093, "verse_number": "७-२०-५६", "content_sanskrit": "क्रौञ्चवद्विनदन्तोऽन्ये नाराचाभिहता गजाः।\nपरान्स्वांश्चापि मृद्गन्तः परिपेतुर्दिशो दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2049853, "chapter_id": 2093, "verse_number": "७-२०-५७", "content_sanskrit": "गजाश्वरथयोधानां शरीरौघसमावृता।\nबभूव पृथिवी राजन्मांसशोणितकर्दमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2049854, "chapter_id": 2093, "verse_number": "७-२०-५८", "content_sanskrit": "प्रमथ्य च विषाणाग्रैः समुत्क्षिप्ताश्च वारणैः।\nसचक्राश्च विचक्राश्च रथैरेव महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2049855, "chapter_id": 2093, "verse_number": "७-२०-५९", "content_sanskrit": "रथाश्च रथिभिर्हीना निर्मनुष्याश्च वाजिनः।\nहतारोहाश्च मातङ्गा दिशो जग्मुर्भयातुराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2049856, "chapter_id": 2093, "verse_number": "७-२०-६०", "content_sanskrit": "जघानात्र पिता पुत्रं पुत्रश्च पितरं तथा।\nइत्यासीत्तुमुलं युद्धं न प्राज्ञायत किञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2049857, "chapter_id": 2093, "verse_number": "७-२०-६१", "content_sanskrit": "आगुल्फेभ्योऽवसीदन्ते नरा लोहितकर्दमैः।\nदीप्यमानैः परिक्षिप्ता दावैरिव महाद्रुमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2049858, "chapter_id": 2093, "verse_number": "७-२०-६२", "content_sanskrit": "शोणितैः सिच्यमानानि वस्त्राणि कवचानि च।\nछत्राणि च पताकाश्च सर्वं रक्तमदृश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2049859, "chapter_id": 2093, "verse_number": "७-२०-६३", "content_sanskrit": "हयौघाश्च रथौघाश्च नरौघाश्च निपातिताः।\nसंक्षुण्णाः पुनरावृत्य बहुधा रथनेमिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2049860, "chapter_id": 2093, "verse_number": "७-२०-६४", "content_sanskrit": "सगजौघमहावेगः परासुनरशैवलः।\nरथौघतुमुलावर्तः प्रबभौ सैन्यसागरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2049861, "chapter_id": 2093, "verse_number": "७-२०-६५", "content_sanskrit": "तं वाहनमहानौभिर्योधा जयधनैषिणः।\nअवगाह्याथ मज्जन्तो नैव मोहं प्रचक्रिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2049862, "chapter_id": 2093, "verse_number": "७-२०-६६", "content_sanskrit": "शरवर्षाभिवृष्टेषु योधेष्वञ्चितलक्ष्मसु।\nन तेष्वचित्ततां लेभे कश्चिदाहतलक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2049863, "chapter_id": 2093, "verse_number": "७-२०-६७", "content_sanskrit": "वर्तमाने तथा युद्धे घोररूपे भयङ्करे।\nमोहयित्वा परान्द्रोणो युधिष्ठिरमुपाद्रवत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2049864, "chapter_id": 2093, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि संशप्तकवधपर्वणि द्वादशदिवसयुद्धे विंशोऽध्यायः॥ २० ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-२०-१६ उष्णगे घर्मात्यये॥ ५-२०-१८ पौर्णमास्यां कृत्तिकायोगयुक्तेन इन्दुना। शारदपूर्णचन्द्रेणेत्यर्थः॥ ५-२०-२६ अनिष्टदर्शनं स्वमृत्युहेतुत्वात्॥ ५-२०-३३ भृशायस्तोऽतिप्रयत्नवान्॥ ५-२०-५१ एकचराः द्विपान्तरदर्शनासहाः॥ ५-२०-६६ अचित्ततां मोहम्॥ ५-२०-२० विंशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]