[{"id": 7004234000, "chapter_id": 24234, "verse_number": "५-२-१२-१", "content_sanskrit": "श्रीहर उवाच ।\nद्वादशं विद्धि देवेशि लोकपालेश्वरं शिवम् ।\nयस्य दर्शनमात्रेण सर्वपापैः प्रमुच्यते॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004234001, "chapter_id": 24234, "verse_number": "५-२-१२-२", "content_sanskrit": "पुरा दैत्यगणा देवि प्रादुर्भूताः सहस्रशः ।\nहिरण्यकशिपोर्वक्षःस्थलादतिपराक्रमाः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004234002, "chapter_id": 24234, "verse_number": "५-२-१२-३", "content_sanskrit": "तैरियं वसुधा व्याप्ता सशैलवनकानना ।\nविध्वस्ताः स्वाश्रमाः सर्वे यज्ञा विध्वंसितास्तथा॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004234003, "chapter_id": 24234, "verse_number": "५-२-१२-४", "content_sanskrit": "ब्राह्मणा भक्षिताश्चैव वेद वेदांगपारगाः ।\nपूरितान्यग्निकुण्डानि पांसुना मधुना तथा॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004234004, "chapter_id": 24234, "verse_number": "५-२-१२-५", "content_sanskrit": "विध्वस्ताः कलशाः सर्वे मृद्भांडादि च चूर्णितम् ।\nनिःस्वाध्यायवषट्कारा स्वधास्वाहाविवर्जिता॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004234005, "chapter_id": 24234, "verse_number": "५-२-१२-६", "content_sanskrit": "कृता च धरणी देवि नष्टयज्ञोत्सवाभवत् ।\nलोकपालास्ततो भीता माधवं शरणं गताः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004234006, "chapter_id": 24234, "verse_number": "५-२-१२-७", "content_sanskrit": "ऊचुः प्रांजलयः सर्वे क्षुधार्ता दुःखिताः कृताः ।\nवयं ग्लानिं गता देव यज्ञभागं विना कृताः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004234007, "chapter_id": 24234, "verse_number": "५-२-१२-८", "content_sanskrit": "वयं त्रातास्त्वया पूर्वं नमुचेर्वृषपर्वणः ।\nहिरण्यकशिपो रौद्रान्नरकाच्च मुरोस्तथा॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004234008, "chapter_id": 24234, "verse_number": "५-२-१२-९", "content_sanskrit": "तथा रक्ष सुरश्रेष्ठ भयं नः समुपस्थितम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004234009, "chapter_id": 24234, "verse_number": "५-२-१२-१०", "content_sanskrit": "तेषां तद्वचनं श्रुत्वा शंखचक्रगदाधरः ।\nजगाम स ततो दैत्याः प्रविष्टा वरुणालयम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004234010, "chapter_id": 24234, "verse_number": "५-२-१२-११", "content_sanskrit": "ते निष्क्रम्य ततो रात्रौ निघ्नंति द्विजसत्तमान् ।\nतापसान्दीक्षितान्देवि धर्मव्रतपरायणान्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004234011, "chapter_id": 24234, "verse_number": "५-२-१२-१२", "content_sanskrit": "अथ स्वर्गं गताः कांते जितः शक्रो मरुत्पतिः ।\nतथैव दक्षिणामाशां धर्मराजो जितस्ततः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004234012, "chapter_id": 24234, "verse_number": "५-२-१२-१३", "content_sanskrit": "गत्वाथ पश्चिमामाशां जलराजो विनिर्जितः ।\nउत्तरे धनदो देवि तैर्दैत्यैः स विनिर्जितः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004234013, "chapter_id": 24234, "verse_number": "५-२-१२-१४", "content_sanskrit": "ततस्ते व्याकुला जाता विष्णुं शरणमागताः ।\nउपायः कथितो देवि देवेभ्यो विष्णुना तदा॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004234014, "chapter_id": 24234, "verse_number": "५-२-१२-१५", "content_sanskrit": "महाकालवनं गत्वा देवा भक्त्या समाहिताः ।\nआराधयत सर्वेशं शंकरं लोकशंकरम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004234015, "chapter_id": 24234, "verse_number": "५-२-१२-१६", "content_sanskrit": "भवतां भविता सिद्धिस्तत्र तस्य प्रसादतः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004234016, "chapter_id": 24234, "verse_number": "५-२-१२-१७", "content_sanskrit": "इति तस्य वचः श्रुत्वा कृष्णस्यामिततेजसः ।\nप्रस्थिता लोकपालास्ते महाकालवने शुभे॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004234017, "chapter_id": 24234, "verse_number": "५-२-१२-१८", "content_sanskrit": "तावत्तत्रैव संरुद्धा दैत्यैः शस्त्रधरैस्तदा ।\nभूयो नष्टाश्च संप्राप्ता यत्र देवो जनार्दनः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004234018, "chapter_id": 24234, "verse_number": "५-२-१२-१९", "content_sanskrit": "कथयामासुरत्युग्रं यथा रुद्धं जगत्त्रयम् ।\nनारायणेन ते प्रोक्ता लोकपालाः पुनः पुनः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004234019, "chapter_id": 24234, "verse_number": "५-२-१२-२०", "content_sanskrit": "यूयं व्रतधरा भूत्वा कपालैश्च विभूषिताः ।\nखट्वांगधारिणः शांताः पंचमुद्राविभूषिताः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004234020, "chapter_id": 24234, "verse_number": "५-२-१२-२१", "content_sanskrit": "भस्मभूषितसर्वांगाः क्षुद्रघंटाविराजिताः ।\nमहाव्रतधरा भूत्वा महाकालवनो त्तमम् ।\nगच्छध्वं ब्रह्मणा सार्द्धं पादबद्धैश्च नूपुरैः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004234021, "chapter_id": 24234, "verse_number": "५-२-१२-२२", "content_sanskrit": "अथ ते लोकपालाश्च श्रुत्वा कृष्णस्य भाषितम् ।\nसमायाता महादेवि कृत्वा कापालिकं वपुः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004234022, "chapter_id": 24234, "verse_number": "५-२-१२-२३", "content_sanskrit": "तत्र दृष्टं महल्लिंगं तेजसां राशिमद्भुतम् ।\nस्तुतं च विविधैः स्तोत्रैर्लोकपालैः पुनःपुनः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004234023, "chapter_id": 24234, "verse_number": "५-२-१२-२४", "content_sanskrit": "ततस्तु तस्य लिंगस्य वह्निज्वाला विनिःसृता ।\nयया ते दानवाः सर्वे दग्धा भस्मत्वमागताः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004234024, "chapter_id": 24234, "verse_number": "५-२-१२-२५", "content_sanskrit": "ज्ञात्वा लिंगस्य माहात्म्यं नाम चक्रुः समाहिताः ।\nसेवितं लोकपालैस्तु लिंगं तेजोमयं परम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004234025, "chapter_id": 24234, "verse_number": "५-२-१२-२६", "content_sanskrit": "लोकपालेश्वरोनाम ख्यातिं यास्यति भूतले ।\nइत्युक्त्वा त्रिदशाः सर्वे लोकपालैः समावृताः ।\nस्वस्वस्थानं गता दिव्यं यथापूर्वं मुदान्विताः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004234026, "chapter_id": 24234, "verse_number": "५-२-१२-२७", "content_sanskrit": "ये पश्यंति नरा देवि लोकपालेश्वरं शिवम् ।\nसमृद्धिभिः सुसंपन्ना भवेयुर्जन्मजन्मसु॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004234027, "chapter_id": 24234, "verse_number": "५-२-१२-२८", "content_sanskrit": "न दारिद्र्यं न च व्याधिर्नाकालमरणं तथा ।\nऐश्वर्यं चातुलं तेषां जायते दर्शनात्सदा॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004234028, "chapter_id": 24234, "verse_number": "५-२-१२-२९", "content_sanskrit": "यो यमुद्दिश्य वै कामं दर्शनं तु करिष्यति ।\nतस्य तज्जायते सर्वं मृतस्य परमा गतिः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004234029, "chapter_id": 24234, "verse_number": "५-२-१२-३०", "content_sanskrit": "अश्वमेधस्य यज्ञस्य सम्यगिष्टस्य यत्फलम् ।\nतत्फलं लभते देवि लोकपाले श्वरार्चनात्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004234030, "chapter_id": 24234, "verse_number": "५-२-१२-३१", "content_sanskrit": "प्रसंगेनापि यः पश्येल्लोकपालेश्वरं शिवम् ।\nमोदते स्वर्गलोके स लोकपालैः समं सदा॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004234031, "chapter_id": 24234, "verse_number": "५-२-१२-३२", "content_sanskrit": "संक्रांतौ सोमवारे च चतुर्दश्यां विशेषतः ।\nये पश्यंति नरा भक्त्या ह्यष्टम्यामयनद्वये॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004234032, "chapter_id": 24234, "verse_number": "५-२-१२-३३", "content_sanskrit": "ते दुर्द्धर्षा भवंतीह शत्रूणां संगरे तथा ।\nमृता यांति विमानेन शक्रलोकं सुदुर्लभम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004234033, "chapter_id": 24234, "verse_number": "५-२-१२-३४", "content_sanskrit": "क्रमेण वारुणं लोकं धनदस्य यथासुखम् ।\nपुनः पैतामहं यांति लोकं देवैः सुदुर्लभम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004234034, "chapter_id": 24234, "verse_number": "५-२-१२-३५", "content_sanskrit": "एष ते कथितो देवि प्रभावः पापनाशनः ।\nदुर्लभः परमो गुह्यं कामेश्वरमथो शृणु॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]