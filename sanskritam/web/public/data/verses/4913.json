[{"id": 2184352, "chapter_id": 4913, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2184353, "chapter_id": 4913, "verse_number": "१", "content_sanskrit": "क्षीणस्य दीर्घसूत्रस्य सानुक्रोशस्य बन्धुषु ।\nविरक्तपौरराष्ट्रस्य निर्द्रव्यनिचयस्य च\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2184354, "chapter_id": 4913, "verse_number": "२", "content_sanskrit": "परिशङ्कितमुख्यस्य स्रुतमन्त्रस्य भारत ।\nअसम्भावितमित्रस्य भिन्नामात्यस्य सर्वशः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2184355, "chapter_id": 4913, "verse_number": "३", "content_sanskrit": "परचक्राभियातस्य दुर्बलस्य बलीयसा ।\nआपन्नचेतसो ब्रूहि किं कार्यमवशिष्यते\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2184356, "chapter_id": 4913, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2184357, "chapter_id": 4913, "verse_number": "४", "content_sanskrit": "बाह्यार्थे विजिगीषुः स्याद् धर्मार्थकुशलः शुचिः ।\nजवेन सन्धिं कुर्वीत पूर्वं पूर्वं विमोक्षयन्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2184358, "chapter_id": 4913, "verse_number": "५", "content_sanskrit": "अधर्मविजिगीषुश्चेद् बलवान् पापनिश्चयः ।\nआत्मनः सन्निरोधेन सन्धिं तेनाभियोजयेत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2184359, "chapter_id": 4913, "verse_number": "६", "content_sanskrit": "अथास्याराजधानीं च तरेदन्येन वापदम् ।\nतद्भावभावे द्रव्याणि जीवन् पुनरुपार्जयेत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2184360, "chapter_id": 4913, "verse_number": "७", "content_sanskrit": "यास्तु कोशवलत्यागाच्छक्यास्तरितुमापदः ।\nकस्तत्राधिकमात्मानं सन्त्यजेदर्थधर्मवित्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2184361, "chapter_id": 4913, "verse_number": "८", "content_sanskrit": "अपराधाज्जुगुप्सेत कः सम्पन्नधनो धनम् ।\nन त्वेवात्मा प्रदातव्यः शक्ये सति कथञ्चन\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2184362, "chapter_id": 4913, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2184363, "chapter_id": 4913, "verse_number": "९", "content_sanskrit": "आभ्यन्तरे प्रकुपिते बाह्ये चोपनिपीडिते ।\nक्षीणे कोशे स्रुते मन्त्रे किं कार्यमवशिष्यते\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2184364, "chapter_id": 4913, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2184365, "chapter_id": 4913, "verse_number": "१०", "content_sanskrit": "क्षिप्रं वा सन्धिकामः स्यात् क्षिप्रं वा तीक्ष्णविक्रमः ।\nयदापनयनं क्षिप्रमेतावत् साम्परायिकम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2184366, "chapter_id": 4913, "verse_number": "११", "content_sanskrit": "अनुरक्तेन पुष्टेन हृष्टेन जगतीपते ।\nअल्पेनापि हि सैन्येन महीं जयति पार्थिवः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2184367, "chapter_id": 4913, "verse_number": "", "content_sanskrit": "हतो वा दिवमारोहेद् विजयी क्षितिमावसेत् ।\nयुद्धे तु सन्त्यजन् प्राणान् शक्रस्यैति सलोकताम्\t॥१२", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2184368, "chapter_id": 4913, "verse_number": "१३", "content_sanskrit": "सर्वलोकागमं कृत्वा मृदुत्वं गन्तुमेव च ।\nविश्वासाद् विनयं कुर्याद् सजलाद्वाप्युपानहम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2184369, "chapter_id": 4913, "verse_number": "१४", "content_sanskrit": "अपविक्रमिषुः क्षिप्रं यथाकामं तु सान्त्वयन् ।\nविलङ्घयित्वा मित्रेण ततः स्वयमुपक्रमेत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2184370, "chapter_id": 4913, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि आपद्धर्मे प्रथमोऽध्यायः ॥ १ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]