[{"id": 2070077, "chapter_id": 2467, "verse_number": "११-१-०x", "content_sanskrit": "श्रीवेदव्यासाय नमः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2070078, "chapter_id": 2467, "verse_number": "११-१-१", "content_sanskrit": "नारायणं नमस्कृत्य नरं चैव नरोत्तमम्।\nदेवीं सरस्वतीं व्यासं ततो जयमुदीरयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2070079, "chapter_id": 2467, "verse_number": "११-१-१x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2070080, "chapter_id": 2467, "verse_number": "११-१-१", "content_sanskrit": "हते दुर्योधने चैव हते सैन्ये च सर्वशः।\nधृतराष्ट्रो महाराज श्रुत्वा किमकरोन्मुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2070081, "chapter_id": 2467, "verse_number": "११-१-२", "content_sanskrit": "तथैव कौरवो राजा धर्मपुत्रो महामनाः।\nकृपप्रभृतयश्चैव किमकुर्वत ते त्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2070082, "chapter_id": 2467, "verse_number": "११-१-३", "content_sanskrit": "अश्वत्थाम्नः कृतं कर्म शापश्चान्योन्यकारितः।\nवृत्तान्मुत्रं ब्रूहि यदभाषत सञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2070083, "chapter_id": 2467, "verse_number": "११-१-४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2070084, "chapter_id": 2467, "verse_number": "११-१-४", "content_sanskrit": "हते पुत्रशते दीनं छिन्नशाखमिव द्रुमम्।\nपुत्रशोकाभिसन्प्तं धृतराष्ट्रं महीपतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2070085, "chapter_id": 2467, "verse_number": "११-१-५", "content_sanskrit": "ध्यानमूकत्वमापन्नं चिन्तया समभिप्लुतम्।\nसञ्जयो जयतां श्रेष्ठ राजानं वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2070086, "chapter_id": 2467, "verse_number": "११-१-६", "content_sanskrit": "किं शोचसि महाराज नास्ति शोके सहायता।\nअक्षौहिण्यो हताश्चाष्टौ दश चैव विशाम्पते।\nनिर्जितेयं वसुमती शून्या स्थास्यति केवलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2070087, "chapter_id": 2467, "verse_number": "११-१-७", "content_sanskrit": "नानादिग्भ्यः समागम्य नानाजात्या नराधिपाः।\nसहितास्व पुत्रेण सर्वे वै निधनं गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2070088, "chapter_id": 2467, "verse_number": "११-१-८", "content_sanskrit": "पितॄणां पुत्रपौत्राणां ज्ञातीनां सुहृदां तथा।\nगुरूणां चानुपूर्व्येण ये चान्येऽनुचरा हताः।\nप्रेतकार्याणि सर्वाणि कारयस्व नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2070089, "chapter_id": 2467, "verse_number": "११-१-९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2070090, "chapter_id": 2467, "verse_number": "११-१-९", "content_sanskrit": "तच्छ्रुत्वा करुणं पुत्रपौत्रवधार्दितः।\nपपात भुवि दुर्धर्षो वाताहत इव द्रुमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2070091, "chapter_id": 2467, "verse_number": "११-१-१०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2070092, "chapter_id": 2467, "verse_number": "११-१-१०", "content_sanskrit": "हतपुत्रो हतामात्यो हतसर्वसुहृज्जनः।\nदुःखं नूनं गमिष्यामि विचरन्पृथिवीमिमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2070093, "chapter_id": 2467, "verse_number": "११-१-११", "content_sanskrit": "किन्नु बन्धुविहीनस्य जीवितेन ममाद्य वै।\nलूनपक्षस्य इव मे वैनतेयस्य सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2070094, "chapter_id": 2467, "verse_number": "११-१-१२", "content_sanskrit": "हृतराज्यो हतसुहृद्वतपुत्रश्च वै तथा।\nन भ्राजिष्ये महाप्राज्ञ क्षीणरश्मिरिवांशुमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2070095, "chapter_id": 2467, "verse_number": "११-१-१३", "content_sanskrit": "न कृतं सुहृदां वाक्यं जामद्ग्न्यस्य च॥\nसभामध्ये तु कृष्णेन यच्छ्रेयोऽभिहितं मम।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2070096, "chapter_id": 2467, "verse_number": "११-१-१४", "content_sanskrit": "अलं वैरेण ते राजन्पुत्रः संगृद्यतामिति।\nतच्च वाक्यमकृत्वाऽहं भृशं तप्यामि दुर्मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2070097, "chapter_id": 2467, "verse_number": "११-१-१५", "content_sanskrit": "न हि श्रोताऽस्मि भीष्मस्य शर्मयुक्तं प्रभाषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2070098, "chapter_id": 2467, "verse_number": "११-१-१६", "content_sanskrit": "दुर्योधनस्य च तथा वृषभस्येव नर्दतः।\nदुःशासनवधं श्रुत्वा कर्णस्य च विपर्ययम्।\nद्रोणसूर्योपरागं च हृदयं मे विदीर्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2070099, "chapter_id": 2467, "verse_number": "११-१-१७", "content_sanskrit": "न स्मराम्यात्मनः किञ्चित्पुरा सञ्जय दुष्कृतम्।\nयस्येदं फलमद्येह मया मूढेन भुज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2070100, "chapter_id": 2467, "verse_number": "११-१-१८", "content_sanskrit": "नूनं व्यपकृतं किञ्चिन्मया पूर्वेषु जन्मसु।\nयेन मां दुःखभागेषु धाता कर्मसु युक्तवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2070101, "chapter_id": 2467, "verse_number": "११-१-१९", "content_sanskrit": "परिणामश्च वयसः सर्वबन्धुक्षयश्च मे।\nसुहृन्मित्रविनाशश्च दैवयोगादुपागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2070102, "chapter_id": 2467, "verse_number": "११-१-२०", "content_sanskrit": "कोन्वस्ति दुःखिततरो मत्तोऽन्यो हि पुमान्भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2070103, "chapter_id": 2467, "verse_number": "११-१-२१", "content_sanskrit": "तन्मामद्यैव पश्यन्तु पाण्डवाः संशितव्रताः।\nविवृतं ब्रह्मलोकस्य दीर्घमध्वानमास्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2070104, "chapter_id": 2467, "verse_number": "११-१-२२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2070105, "chapter_id": 2467, "verse_number": "११-१-२२", "content_sanskrit": "तस्य लालप्यमानस्य बहु शोकं विचिन्वतः।\nशोकापहं नरेन्द्रस्य सञ्जयो वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2070106, "chapter_id": 2467, "verse_number": "११-१-२३", "content_sanskrit": "शोकं राजन्व्यपनुद श्रुतास्ते वेदनिश्चयाः।\nशास्त्रागमाश्च विविधा वृद्धेभ्यो नृपसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2070107, "chapter_id": 2467, "verse_number": "११-१-२४", "content_sanskrit": "सृञ्जये पुत्रशोकार्ते यदूर्चुर्मुनयः पुरा।\nयथा यौवनजं दर्पमास्थिते ते सुते नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2070108, "chapter_id": 2467, "verse_number": "११-१-२५", "content_sanskrit": "न त्वया सुहृदां वाक्यं ब्रुवतामवधारितम्।\nस्वार्थश्च न कृतः कश्चिल्लुब्धेन फलगृद्धिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2070109, "chapter_id": 2467, "verse_number": "११-१-२६", "content_sanskrit": "असिनैवैकधारेण स्वबुद्ध्या तु विचेष्टितम्।\nप्रायशोऽवृत्तसम्पन्नाः सततं पर्युपासिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2070110, "chapter_id": 2467, "verse_number": "११-१-२७", "content_sanskrit": "यस्य दुःशासनो मन्त्री राधेयश्च दुरात्मवान्।\nशकुनिश्चैव दुष्टात्मा चित्रसेनश्च दुर्मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2070111, "chapter_id": 2467, "verse_number": "११-१-२८", "content_sanskrit": "अनल्पं येन वै सर्वं शल्यभूतं कृतं जगत्।\nकुरुवृद्धस्य भीष्मस्य गान्धार्या विदुरस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2070112, "chapter_id": 2467, "verse_number": "११-१-२९", "content_sanskrit": "द्रोणस्य च महाराज कृपस्य च शरद्वतः।\nकृष्णस्य च महाबाहो नारदस्य च धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2070113, "chapter_id": 2467, "verse_number": "११-१-३०", "content_sanskrit": "ऋषीणां च तथाऽन्येषां व्यासस्यामिततेजसः।\nन कृतं तेन वचनं तव पुत्रेण भारत।\nक्षपिताः क्षत्रियाः सर्वे शत्रूणां वर्धितं यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2070114, "chapter_id": 2467, "verse_number": "११-१-३१", "content_sanskrit": "अधर्मसंयुतं किञ्चिन्नित्यं युद्धमिति ब्रुवन्।\nमध्यस्थो हि त्वमप्यासीर्न क्षमं किञ्चिदुक्तवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2070115, "chapter_id": 2467, "verse_number": "११-१-३२", "content_sanskrit": "धूर्धरेण त्वया भारस्तुलया न समं धृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2070116, "chapter_id": 2467, "verse_number": "११-१-३३", "content_sanskrit": "आदावेव मनुष्येण वर्तितव्यं यथाक्रमम्।\nयथा नातीतमर्थं वै पश्चात्तापेन युज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2070117, "chapter_id": 2467, "verse_number": "११-१-३४", "content_sanskrit": "पुत्रगृद्ध्या त्वया राजन्प्रियं तस्य चिकीर्षितम्।\nपश्चात्तापमिमं प्राप्तो न त्वं शोचितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2070118, "chapter_id": 2467, "verse_number": "११-१-३५", "content_sanskrit": "मधु यः केवलं दृष्ट्वा प्रपातं नानुपश्यति।\nस भ्रष्टोमधुलोभेन शोचत्येव यथा भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2070119, "chapter_id": 2467, "verse_number": "११-१-३६", "content_sanskrit": "अर्थान्न शोचन्प्राप्नोति न शोचन्विन्दते सुखम्।\nन शोचञ्श्रियमाप्नोति न शोचन्विन्दते जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2070120, "chapter_id": 2467, "verse_number": "११-१-३७", "content_sanskrit": "स्वयमुत्पादयित्वाऽग्निं परीतस्तेन योऽग्निना।\nदह्यमानः पुनस्तापं भजते न स पण्डितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2070121, "chapter_id": 2467, "verse_number": "११-१-३८", "content_sanskrit": "त्वयैव ससुतेनायं वाक्यवायुसमीरितः।\nलोभाज्येन च संसिक्तो ज्वलितः पार्थपावकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2070122, "chapter_id": 2467, "verse_number": "११-१-३९", "content_sanskrit": "तस्मिन्समिद्धे पतिताः शलभा इव ते सुताः।\nतान्केशवाग्निनिर्दग्धान्न त्वं शोचितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2070123, "chapter_id": 2467, "verse_number": "११-१-४०", "content_sanskrit": "यच्चाश्रुपातकलिलं वदनं वहसे नृप।\nअशास्त्रदृष्टमेतद्धि न प्रशंसन्ति पण्डिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2070124, "chapter_id": 2467, "verse_number": "११-१-४१", "content_sanskrit": "विस्फुलिङ्गा इव ह्येतान्दहन्ति किल मानवान्।\nजहीहि मन्युं बुद्ध्या वै धास्यात्मानमात्मना॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2070125, "chapter_id": 2467, "verse_number": "११-१-४२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2070126, "chapter_id": 2467, "verse_number": "११-१-४२", "content_sanskrit": "एवमाश्वासितं तेन सञ्जयेन महात्मना।\nविदुरो भूय एवाह बुद्धिपूर्वं परन्तप॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2070127, "chapter_id": 2467, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते स्त्रीपर्वणि जलप्रदानिकपर्वणि प्रथमोऽध्यायः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]