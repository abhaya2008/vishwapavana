[{"id": 2108179, "chapter_id": 3339, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2108180, "chapter_id": 3339, "verse_number": "१", "content_sanskrit": "एतत्ते सर्वमाख्यातममृतं मथितं यथा ।\nतत्र सोऽश्वः समुत्पन्नः श्रीमानतुलविक्रमः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2108181, "chapter_id": 3339, "verse_number": "२", "content_sanskrit": "तं निशम्य  तदा कद्रूर्विनतामिदमब्रवीत् ।\nउच्चैःश्रवास्तु किंवर्णो भद्रे जानीहि माचिरम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2108182, "chapter_id": 3339, "verse_number": "", "content_sanskrit": "विनता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2108183, "chapter_id": 3339, "verse_number": "३", "content_sanskrit": "श्वेत एवाश्वराजोऽयं किं वा त्वं मन्यसे शुभे ।\nब्रूहि वर्णं त्वमप्यस्य तथाऽऽवां  विपणावहे \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2108184, "chapter_id": 3339, "verse_number": "", "content_sanskrit": "कद्रूः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2108185, "chapter_id": 3339, "verse_number": "४", "content_sanskrit": "कृष्णबालमहं मन्ये हयमेनं शुचिस्मिते ।\nएहि सार्धं मया पश्य दासभावाय भामिनि\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2108186, "chapter_id": 3339, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2108187, "chapter_id": 3339, "verse_number": "५", "content_sanskrit": "एवं ते समयं कृत्वा दासभावाय वै मिथः ।\nजग्मतुः स्वगृहानेव श्वो द्रक्ष्याव इति स्म ह\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2108188, "chapter_id": 3339, "verse_number": "६", "content_sanskrit": "तत्र पुत्रसहस्रं तत् कद्रूर्जिह्मं चिकीर्षती ।\nआज्ञापयामास तदा बाले भूत्वाऽञ्जनप्रभाः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2108189, "chapter_id": 3339, "verse_number": "८", "content_sanskrit": "प्रविशध्वं हयं शीघ्रं दासी न स्यामहं यथा ।\nतद्वाक्यं नान्वपद्यन्त  तान् शशाप भुजङ्गमान् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2108190, "chapter_id": 3339, "verse_number": "९", "content_sanskrit": "सर्पसत्रे वर्तमाने पावको वः प्रधक्ष्यति ।\nजनमेजयस्य राजर्षेः पाण्डवेयस्य धीमतः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2108191, "chapter_id": 3339, "verse_number": "१०", "content_sanskrit": "शापमेनं  तु शुश्राव स्वयमेव पितामहः ।\nअतिक्रूरं समुद्दिष्टं कद्र्वा दैवादितीव ह \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2108192, "chapter_id": 3339, "verse_number": "११", "content_sanskrit": "सार्धं देवगणैः सर्वैर्वचनं चान्वमोदत ।\nबहुत्वं प्रेक्ष्य सर्पाणां प्रजानां हितकाम्यया \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2108193, "chapter_id": 3339, "verse_number": "१२", "content_sanskrit": "तिग्मवीर्यविषा ह्येते दन्दशूका महाबलाः ।\nतेषां तीक्ष्णविषत्वाद्धि प्रजानां च हिताय वै\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2108194, "chapter_id": 3339, "verse_number": "१३", "content_sanskrit": "युक्तं मातृकृतं तेषां परपीडाप्रसर्पताम् ।\nअन्येषामपि सत्वानां नित्यं दोषकराश्च ये\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2108195, "chapter_id": 3339, "verse_number": "१४", "content_sanskrit": "तेषां प्राणान्तिको दण्डो दैवेन विनिपात्यते ।\nएवमुक्त्वा स देवस्तु पूर्वं कद्रूं च तां तदा \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2108196, "chapter_id": 3339, "verse_number": "१५", "content_sanskrit": "आहूय काश्यपं देवो वचनं चेदमब्रवीत् ।\nयदि ते दन्दशूकाश्च सर्पा जाताश्च तेऽनघ \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2108197, "chapter_id": 3339, "verse_number": "१६", "content_sanskrit": "विषोद्गणा महाभोगा मात्रा शप्ताः परन्तप ।\nतत्र मन्युस्त्वया तात न कर्तव्यः कथञ्चन \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2108198, "chapter_id": 3339, "verse_number": "१७", "content_sanskrit": "दृष्टं पुरातने ह्येतत् यज्ञे सर्पविनाशनम् ।\nइत्युक्त्वा सृष्टिकृद् देवस्तं प्रसाद्य प्रशस्य च \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2108199, "chapter_id": 3339, "verse_number": "१८", "content_sanskrit": "प्रादाद्विषहणीं विद्यां काश्यपाय महात्मने ।\nएवं शप्तेषु नागेषु कद्र्वा च द्विजसत्तम \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2108200, "chapter_id": 3339, "verse_number": "१९", "content_sanskrit": "उद्विग्नः शापतस्तस्याः कद्रूं कार्कोटकोऽब्रवीत् ।\nमातरं परमप्रीतस्तथा भुजगसत्तमः\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2108201, "chapter_id": 3339, "verse_number": "२०", "content_sanskrit": "आविश्य वाजिनं मुख्यं बालो भूत्वाऽञ्जनप्रभः ।\nदर्शयिष्यामि तत्राहमात्मानं काममाश्वस ।\nएवमस्त्विति सा पुत्रं प्रत्युवाच यशस्विनी \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2108202, "chapter_id": 3339, "verse_number": "६", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि अष्टादशोऽध्यायः ॥१८॥ ॥ आस्तीकपर्वणि षष्ठोऽध्यायः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]