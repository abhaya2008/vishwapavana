[{"id": 40003711, "chapter_id": 8895, "verse_number": "1", "content_sanskrit": "ततस्सुमन्त्रमैक्ष्वाकः पीडितोऽत्र प्रतिज्ञया। सबाष्पमतिनिश्श्वश्य जगादेदं पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40003712, "chapter_id": 8895, "verse_number": "2", "content_sanskrit": "सूत रत्नसुसम्पूर्णा चतुर्विधबला चमूः। राघवस्यानुयात्रार्थं क्षिप्रं प्रतिविधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40003713, "chapter_id": 8895, "verse_number": "3", "content_sanskrit": "रूपाजीवाश्च वादिन्यो वणिजश्च महाधनाः। शोभयन्तु कुमारस्य वाहिनीं सुप्रसारिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40003714, "chapter_id": 8895, "verse_number": "4", "content_sanskrit": "ये चैनमुपजीवन्ति रमते यैश्च वीर्यतः। तेषां बहुविधं दत्त्वा तानप्यत्र नियोजय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40003715, "chapter_id": 8895, "verse_number": "5", "content_sanskrit": "आयुधानि च मुख्यानि नागरा श्शकटानि च। अनुगच्छन्तु काकुत्स्थं व्याधाश्चारण्य गोचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40003716, "chapter_id": 8895, "verse_number": "6", "content_sanskrit": "निघ्नन् मृगान् कुञ्जरांश्च पिबंश्चारण्यकं मधु। नदीश्च विविधाः पश्यन्न राज्यस्य स्मरिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40003717, "chapter_id": 8895, "verse_number": "7", "content_sanskrit": "धान्यकोशश्च यः कश्चिद्धनकोशश्च मामकः। तौ राममनुगच्छेतां वसन्तं निर्जने वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40003718, "chapter_id": 8895, "verse_number": "8", "content_sanskrit": "यजन् पुण्येषु देशेषु विसृजं श्चाप्तदक्षिणाः। ऋषिभिश्च समागम्य प्रवत्स्यति सुखं वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40003719, "chapter_id": 8895, "verse_number": "9", "content_sanskrit": "भरतश्च महाबाहुरयोध्यां पालयिष्यति। सर्वकामैः सह श्रीमान् रामः संसाध्यतामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40003720, "chapter_id": 8895, "verse_number": "10", "content_sanskrit": "एवं ब्रुवति काकुत्स्थे कैकेय्या भय मागतम्। मुखं चाप्यगमच्छोषं स्वरश्चापि न्यरुध्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40003721, "chapter_id": 8895, "verse_number": "11", "content_sanskrit": "सा विषण्णा च सन्त्रस्ता मुखेन परिशुष्यता। राजानमेवाभिमुखी कैकेयी वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40003722, "chapter_id": 8895, "verse_number": "12", "content_sanskrit": "राज्यं गतजनं साधो पीतमण्डां सुरामिव। निरास्वाद्यतमं शून्यं भरतो नाभिपत्स्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40003723, "chapter_id": 8895, "verse_number": "13", "content_sanskrit": "कैकेय्यां मुक्तलज्जायां वदन्त्यामतिदारुणाम्। राजा दशरथो वाक्यमुवाचायतलोचनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40003724, "chapter_id": 8895, "verse_number": "14", "content_sanskrit": "वहन्तं किं तुदसि मां नियुज्य धुरि माऽहिते। अनार्ये कृत्यमारब्धं किं न पूर्वमुपारुधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40003725, "chapter_id": 8895, "verse_number": "15", "content_sanskrit": "तस्यैतत्क्रोधसंयुक्तमुक्तं श्रुत्वा वराङ्गना। कैकेयी द्विगुणं क्रुद्धा राजानमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40003726, "chapter_id": 8895, "verse_number": "16", "content_sanskrit": "वैव वंशे सगरो ज्येष्ठं पुत्रमुपारुधत्। असमञ्ज इति ख्यातं तथायं गन्तुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40003727, "chapter_id": 8895, "verse_number": "17", "content_sanskrit": "एवमुक्तो धिगित्येव राजा दशरथोऽब्रवीत्। व्रीडितश्च जनस्सर्व स्सा च तं नावबुध्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40003728, "chapter_id": 8895, "verse_number": "18", "content_sanskrit": "तत्र वृद्धो महामात्रस्सिद्धार्थो नाम नामतः। शुचिर्बहुमतो राज्ञः कैकेयी मिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40003729, "chapter_id": 8895, "verse_number": "19", "content_sanskrit": "असमञ्जो गृहीत्वा तु क्रीडतः पथि बालकान्। सरय्वाः प्रक्षिपन्नप्सु रमते तेन दुर्मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40003730, "chapter_id": 8895, "verse_number": "20", "content_sanskrit": "तं दृष्ट्वा नागरा स्सर्वे कृद्धा राजानमब्रुवन्। असमञ्जं वृणीष्वैकमस्मान्वा राष्ट्रवर्धन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40003731, "chapter_id": 8895, "verse_number": "21", "content_sanskrit": "तानुवाच ततो राजा किन्निमित्तमिदं भयम्। ताश्चापि राज्ञा सम्पृष्टा वाक्यं प्रकृतयोऽब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40003732, "chapter_id": 8895, "verse_number": "22", "content_sanskrit": "डक्रीडतस्त्वेष नः पुत्रान् बालानुद्भ्रान्तचेतनः। सरय्वां प्रक्षिपन्मौर्ख्यादतुलां प्रीतिमश्नुते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40003733, "chapter_id": 8895, "verse_number": "23", "content_sanskrit": "स तासां वचनं श्रुत्वा प्रकृतीनां नराधिपः। तं तत्याजाहितं पुत्रं तेषां प्रियचिकीर्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40003734, "chapter_id": 8895, "verse_number": "24", "content_sanskrit": "तं यानं शीघ्रमारोप्य सभार्यं सपरिच्छदम्। यावज्जीवं विवास्योऽयमिति स्वानन्वशात्पिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40003735, "chapter_id": 8895, "verse_number": "25", "content_sanskrit": "स फालपिटकं गृह्य गिरिदुर्गाण्यलोडयत्। दिश स्सर्वास्त्वनुचरन् स यथा पापकर्मकृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40003736, "chapter_id": 8895, "verse_number": "26", "content_sanskrit": "इत्येनमत्यजद्राजा सगरो वै सुधार्मिकः। रामः किमकरोत्पापं येनैवमुपरुध्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40003737, "chapter_id": 8895, "verse_number": "27", "content_sanskrit": "न हि कञ्चन पश्यामो राघवस्यागुणं वयम्। दुर्लभो ह्यस्य निरय श्शशाङ्कस्येव कल्मषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40003738, "chapter_id": 8895, "verse_number": "28", "content_sanskrit": "अथवा देवि दोषं त्वं कञ्चित्पश्यसि राघवे। तमद्य ब्रूहि तत्वेन तदा रामो विवास्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40003739, "chapter_id": 8895, "verse_number": "29", "content_sanskrit": "अदुष्टस्य हि संत्यागः सत्पथे निरतस्य च। निर्दहेदपि शक्रस्य द्युतिं धर्मनिरोधनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40003740, "chapter_id": 8895, "verse_number": "30", "content_sanskrit": "तदलं देवि रामस्य श्रिया विहतया त्वया। लोकतोऽपि हि ते रक्ष्यः परिवादः शुभानने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40003741, "chapter_id": 8895, "verse_number": "31", "content_sanskrit": "श्रुत्वा तु सिद्धार्थवचो राजा श्रान्ततरस्वनः। शोकोपहतया वाचा कैकेयीमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40003742, "chapter_id": 8895, "verse_number": "32", "content_sanskrit": "एतद्वचो नेच्छसि पापवृत्ते हितं न जानासि ममात्मनो वा। आस्थाय मार्गं कृपणं कुचेष्टा चेष्टा हि ते साधुपथादपेता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40003743, "chapter_id": 8895, "verse_number": "33", "content_sanskrit": "अनुव्रजिष्याम्यहमद्य रामं राज्यं परित्यज्य सुखं धनं च। सहैव राज्ञा भरतेन च त्वं यथासुखं भुङ्क्ष्व चिराय राज्यम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]