[{"id": 2069979, "chapter_id": 2464, "verse_number": "१०-१६-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2069980, "chapter_id": 2464, "verse_number": "१०-१६-१", "content_sanskrit": "तदाज्ञाय हृषीकेशो विकृष्टं पापकर्मणा।\nहृष्यमाण इदं वाक्यं द्रौणिं प्रत्यब्रवीत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2069981, "chapter_id": 2464, "verse_number": "१०-१६-२", "content_sanskrit": "विराटस्य सुतां पूर्वं स्नुषां गाण्डीवधन्वनः।\nउपप्लाव्यगतां दृष्ट्वा ऋतवाग्ब्रह्मणोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2069982, "chapter_id": 2464, "verse_number": "१०-१६-३", "content_sanskrit": "परिक्षीणेषु कुरुषु पुत्रस्तव भविष्यति।\nएतदस्य परिक्षित्त्वं गर्भस्थस्य भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2069983, "chapter_id": 2464, "verse_number": "१०-१६-४", "content_sanskrit": "तस्य तद्वचनं साधोः सत्यमेद्भविष्यति।\nपरिक्षिद्भविता ह्येषां पुनर्वंशकरः सुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2069984, "chapter_id": 2464, "verse_number": "१०-१६-५", "content_sanskrit": "त्वां तु कापुरुषं पापं विंदुः सर्वे मनीषिणः।\nअसकृत्पापकर्माणं बालजीवितघातकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2069985, "chapter_id": 2464, "verse_number": "१०-१६-६", "content_sanskrit": "तस्मात्त्वमस्य पापस्य कर्मणः फलमाप्नुहि।\nत्रीणि वर्षसहस्राणि चरिष्यसि महीमिमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2069986, "chapter_id": 2464, "verse_number": "१०-१६-७", "content_sanskrit": "अप्राप्नुवन्क्वचित्काञ्चित्संविदं जातु केनचित्।\nनिर्जनानसहायस्त्वं देशान्प्रविचरिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2069987, "chapter_id": 2464, "verse_number": "१०-१६-८", "content_sanskrit": "भवित्री न हि ते क्षुद्र जनमध्येषु संस्थितिः।\nपूयशोणिगन्धी च दुर्गकान्तारसंश्रयः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2069988, "chapter_id": 2464, "verse_number": "१०-१६-९", "content_sanskrit": "विचरिष्यसि पापात्मंश्चिरमेको वसुन्धराम्॥\nवयः प्राप्य परिक्षित्तुं देवव्रतमवाप्य च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2069989, "chapter_id": 2464, "verse_number": "१०-१६-१०", "content_sanskrit": "कृपाच्छारद्वताच्छूरः सर्वास्त्राण्युपपत्स्यते॥\nविदित्वा परमास्त्राणि क्षत्रधर्मव्रते स्थितः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2069990, "chapter_id": 2464, "verse_number": "१०-१६-११", "content_sanskrit": "षष्टिं वर्षामि धर्मात्मा वसुधां पालयिष्यति॥\nइतश्चोर्ध्वं महाबाहुः कुरुराजो भविष्यति।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2069991, "chapter_id": 2464, "verse_number": "१०-१६-१२", "content_sanskrit": "परिक्षिन्नाम नृपतिर्मिषतस्ते सुदुर्मते॥\n[अहं तं जीवयिष्यामि दग्धं शस्त्राग्नितेजसा]।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2069992, "chapter_id": 2464, "verse_number": "१०-१६-१३", "content_sanskrit": "पश्य मे तपसो वीर्यं सत्यस्य च नराधम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2069993, "chapter_id": 2464, "verse_number": "१०-१६-१३x", "content_sanskrit": "व्यास उवाच।\nयस्मादनादृत्य कृतं त्वयाऽस्मान्कर्म दारुणम्।\nब्राह्मणस्य सतश्चेदं वृत्तमन्यायवर्तिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2069994, "chapter_id": 2464, "verse_number": "१०-१६-१४", "content_sanskrit": "तस्माद्यद्देवकीपुत्र उक्वानुत्तमं वचः।\nआलोकात्तव तद्भावि क्षुद्रकर्मन्व्रजेति ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2069995, "chapter_id": 2464, "verse_number": "१०-१६-१५x", "content_sanskrit": "अश्वत्थामोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2069996, "chapter_id": 2464, "verse_number": "१०-१६-१५", "content_sanskrit": "सहैव भवता ब्रह्मन्स्थास्यामि पुरुषेष्विह।\nसत्यवागस्तु भगवानयं च पुरुषोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2069997, "chapter_id": 2464, "verse_number": "१०-१६-१६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2069998, "chapter_id": 2464, "verse_number": "१०-१६-१६", "content_sanskrit": "प्रदायाथ मणिं द्रौणिः पाण्डवानां महात्मनाम्।\nजगाम विमनास्तेषां सर्वेषां पश्यतां वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2069999, "chapter_id": 2464, "verse_number": "१०-१६-१७", "content_sanskrit": "पाण्डवाश्च सदाशार्हास्तानृषीनभिवाद्य च।\nकृष्णद्वैपायनं चैव नारदं चैव पर्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2070000, "chapter_id": 2464, "verse_number": "१०-१६-१८", "content_sanskrit": "द्रोणपुत्रस्य सहजं मणिमादाय सत्वराः।\nद्रौपदीमभ्यधावन्त प्रायोपेतां मनस्विनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2070001, "chapter_id": 2464, "verse_number": "१०-१६-१९x", "content_sanskrit": "वैशम्पयन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2070002, "chapter_id": 2464, "verse_number": "१०-१६-१९", "content_sanskrit": "ततस्ते पुरुषव्याघ्राः सदश्वैरनिलोपमैः।\nअभ्ययुः सहदाशार्हाः शिबिरं पुनरेव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2070003, "chapter_id": 2464, "verse_number": "१०-१६-२०", "content_sanskrit": "अवतीर्य रथेभ्यस्तु त्वरमाणा महारथाः।\nददृशुर्द्रौपदीं हृष्टामार्तामार्ततराः स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2070004, "chapter_id": 2464, "verse_number": "१०-१६-२१", "content_sanskrit": "तामुपेत्य निरानन्दां दुःखशोकसमन्विताम्।\nपरिवार्य व्यतिष्ठन्त पाण्डवाः सहकेशवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2070005, "chapter_id": 2464, "verse_number": "१०-१६-२२", "content_sanskrit": "ततो राज्ञाऽभ्यनुज्ञातो भीमसेनो महाबलः।\nप्रददौ तं मणिं दिव्यं वचनं चेदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2070006, "chapter_id": 2464, "verse_number": "१०-१६-२३", "content_sanskrit": "अयं भद्रे तव मणिः पुत्रहन्ता जितश्च ते।\nउत्तिष्ठ शोकमुत्सृज्य क्षात्रधर्ममनुस्मर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2070007, "chapter_id": 2464, "verse_number": "१०-१६-२४", "content_sanskrit": "प्रयाणे वासुदेवस्य शमार्थवसितेक्षणे।\nयान्युक्तानि त्वया भीरु वाक्यानि मधुघातिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2070008, "chapter_id": 2464, "verse_number": "१०-१६-२५", "content_sanskrit": "नैव मे पतयः सन्ति न पुत्रा भ्रातरो न च।\nन वै त्वमिति गोविन्द शममिच्छति राजनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2070009, "chapter_id": 2464, "verse_number": "१०-१६-२६", "content_sanskrit": "उक्तवत्यसि तीव्राणि वाक्यानि पुरुषोत्तमम्।\nक्षत्रधर्मानुरूपाणि तानि संस्मर्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2070010, "chapter_id": 2464, "verse_number": "१०-१६-२७", "content_sanskrit": "हतो दुर्योधनः पापो राज्यस्य परिपन्थिकः।\nदुःशासनस्य रुधिरं पीतं विस्फुरतो मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2070011, "chapter_id": 2464, "verse_number": "१०-१६-२८", "content_sanskrit": "वैरस्य गतमानृण्यं न स्म वाच्या विवक्षताम्।\nजित्वा मुक्तो द्रोणपुत्रो ब्राह्मण्याद्गौरवेण च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2070012, "chapter_id": 2464, "verse_number": "१०-१६-२९", "content_sanskrit": "यशोऽस्य पतितं देवि शरीरं त्ववशेषितम्।\nवियोजितश्च मणिना भ्रंशितश्चायुधं भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2070013, "chapter_id": 2464, "verse_number": "१०-१६-३०x", "content_sanskrit": "द्रौपद्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2070014, "chapter_id": 2464, "verse_number": "१०-१६-३०", "content_sanskrit": "केवलानृण्यमाप्ताऽस्मि गुरुपुत्रो गुरुर्मम।\nशिरस्येतं मणिं राजा ग्रहीतुमनघोऽर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2070015, "chapter_id": 2464, "verse_number": "१०-१६-३१", "content_sanskrit": "तं गृहीत्वा ततो राजा शिरस्येवाकरोत्तदा।\nगुरोरुच्छेषमित्येव द्रौपद्या वचनादपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2070016, "chapter_id": 2464, "verse_number": "१०-१६-३२", "content_sanskrit": "ततो दिव्यं मणिवरं शिरसा धारयन्प्रभुः।\nशुशुभे स तदा राजा सचन्द्र इव पर्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2070017, "chapter_id": 2464, "verse_number": "१०-१६-३३", "content_sanskrit": "उत्तस्थौ पुत्रशोकार्ता ततः कृष्णा मनस्विनी।\nकृष्णं चापि महाबाहुः परिपप्रच्छ धर्मराट्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2070018, "chapter_id": 2464, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सौप्तिकपर्वणि ऐषीकपर्वणि षोडशोऽध्यायः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]