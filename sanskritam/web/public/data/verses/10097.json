[{"id": 6000097000, "chapter_id": 10097, "verse_number": null, "content_sanskrit": "अथ द्वितीयाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000097001, "chapter_id": 10097, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_002/BhP_05.002.001.m4a", "display_order": 2}, {"id": 6000097002, "chapter_id": 10097, "verse_number": "५-२-१", "content_sanskrit": "एवं पितरि सन्निवृत्ते तदनुशासने वर्तमान आग्नीध्रो जम्बुद्वीपौकसः प्रजा औरसवद्धर्मानवेक्षमाणः पर्यगोपायत्॥ ५/२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_002/BhP_05.002.002.m4a", "display_order": 3, "topics": [{"text": "प्रियव्रतपुत्रस्य आग्नीध्रस्य चरित्रम्", "range": "१–२"}]}, {"id": 6000097003, "chapter_id": 10097, "verse_number": "५-२-२", "content_sanskrit": "स कदाचित्पितृलोककामः सुरवरवनिताक्रीडाचलद्रोण्यां भगवन्तं विश्वसृजां पतिमाहृत-परिचर्योपकरण आत्मैकाग्र्येण तपसाऽऽराधयाम्बभूव॥ ५/२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_002/BhP_05.002.003.m4a", "display_order": 4}, {"id": 6000097004, "chapter_id": 10097, "verse_number": "५-२-३", "content_sanskrit": "एतदुपलभ्य भगवानादिपुरुषः सदसि गायन्तीं पूर्वचित्तिं नामाप्सरसमभियापयामास॥ ५/२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_002/BhP_05.002.004.m4a", "display_order": 5, "topics": [{"text": "अनूढस्याप्यपत्यकामस्य आग्नीध्रस्य सकाशे ब्रह्मणा पूर्वचित्तिनामकाप्सरःप्रेषणम्", "range": "२–३"}]}, {"id": 6000097005, "chapter_id": 10097, "verse_number": "५-२-४", "content_sanskrit": "सा च तदाश्रमोपवनमतिरमणीयविविधनिबिडविटपिविटपनिकटपुटलताकुटिलरूढस्थल-विहङ्गममिथुनैः प्लाव्यमानश्रुतिभिः प्रतिबोध्यमानसलिलकुक्कुटकारण्डवकलहंसादिभिर्विचित्रमुप-कूजितामलजलाशयरूढकमलाकरम् उपबभ्राम॥ ५/२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_002/BhP_05.002.005.m4a", "display_order": 6, "topics": [{"text": "मुग्धेनेव तेन तस्या वशीकरणार्थं चाटुवाक्यैरनुनयः", "range": "४–१८"}]}, {"id": 6000097006, "chapter_id": 10097, "verse_number": "५-२-५", "content_sanskrit": "तस्याः सुललितपदविन्यासगतिविलासेनानुपदं खणखणायमानरुचिरचरणाभरणस्वनमुपाकर्ण्य नरदेवकुमारः समाधियोगेनामीलितनयननलिनमुकुलयुगलमीषद्विकास्याचष्ट॥ ५/२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_002/BhP_05.002.006.m4a", "display_order": 7}, {"id": 6000097007, "chapter_id": 10097, "verse_number": "५-२-६", "content_sanskrit": "तामेवाविदूरे विलोक्य मधुकरीमिव सुमनस उपजिघ्रन्तीं दिविजमनुजमनोनयनाह्लाददुघैर्गति- विहारविनयविलोकनसुस्वराक्षरावयवैर्मनसि नृणां कुसुमायुधस्य विदधतीं विवरम्॥ ५/२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_002/BhP_05.002.007.m4a", "display_order": 8}, {"id": 6000097008, "chapter_id": 10097, "verse_number": "५-२-७", "content_sanskrit": "निजमुखविगलितमदासवामोदमदान्धमधुकरनिकरोपरोधेन द्रुतपदविन्यासवल्गुस्पन्दनस्तन-कलशकबरहाररशनां देवीं, तदवलोकनेन विधृतावसरस्य भगवतो मकरध्वजस्य वशमुपनीतो जडवदिति होवाच॥ ५/२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_002/BhP_05.002.008.m4a", "display_order": 9}, {"id": 6000097009, "chapter_id": 10097, "verse_number": null, "content_sanskrit": "आग्नीध्र उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_002/BhP_05.002.009.m4a", "display_order": 10}, {"id": 6000097010, "chapter_id": 10097, "verse_number": "५-२-८", "content_sanskrit": "का त्वं चिकीर्षसि च किं मुनिवर्य शैले मायाऽसि किं भगवतः परदेवतायाः।\nविज्ये बिभर्षि धनुषी सुहृदात्मनोऽर्थे किं वा मृगान्मृगयसे विपिने प्रमत्तान्॥ ५/२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_002/BhP_05.002.010.m4a", "display_order": 11}, {"id": 6000097011, "chapter_id": 10097, "verse_number": "५-२-९", "content_sanskrit": "बाणाविमौ भगवतः शतपत्रपत्रौ शान्तावपुङ्खरुचिरावतितिग्मदन्तौ।\nकस्मै युयुङ्क्षसि वने विचरन्न विद्मः क्षेमाय नो जडधियां तव विक्रमोऽस्तु॥ ५/२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_002/BhP_05.002.011.m4a", "display_order": 12}, {"id": 6000097012, "chapter_id": 10097, "verse_number": "५-२-१०", "content_sanskrit": "शिष्या इमे भगवतः परितः पठन्ति गायन्ति साम सरहस्यमजस्रमीश।\nयुष्मच्छिखाविलुलिताः सुमनोऽभिवृष्टीः सर्वे भजन्त्यृषिगणा इव वेदशाखाः॥ ५/२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_002/BhP_05.002.012.m4a", "display_order": 13}, {"id": 6000097013, "chapter_id": 10097, "verse_number": "५-२-११", "content_sanskrit": "वाचं परं चरणपङ्कजतित्तिरीणां ब्रह्मन्नरूपमुखरीं शृणुमोऽद्य तुभ्यम्।\nलब्धा कदम्बरुचिराङ्कविटङ्कबिम्बे यस्यामलातुपरिधिः क्‍व च वल्कला ते॥ ५/२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_002/BhP_05.002.013.m4a", "display_order": 14}, {"id": 6000097014, "chapter_id": 10097, "verse_number": "५-२-१२", "content_sanskrit": "किं सम्भृतं रुचिरयोर्द्विज शृृङ्गयोस्ते मध्येकृशो वहसि यत्र दृशी श्रिते मे।\nपङ्कोऽरुणः सुरभिरात्मविषाण ईदृग्येनाश्रमं सुभग मे सुरभीकरोषि॥ ५/२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_002/BhP_05.002.014.m4a", "display_order": 15}, {"id": 6000097015, "chapter_id": 10097, "verse_number": "५-२-१३", "content_sanskrit": "लोकं प्रदर्शय सुहृत्तम तावकं मे यत्रत्य इत्थमुरसावयवावपूर्वौ।\nअस्मद्विधस्य मनउन्नयनौ बिभर्षि बह्वद्भुतं सरसहाससुधां च वक्त्रे॥ ५/२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_002/BhP_05.002.015.m4a", "display_order": 16}, {"id": 6000097016, "chapter_id": 10097, "verse_number": "५-२-१४", "content_sanskrit": "का वाऽऽत्मवृत्तिरदनाद्बहिरङ्ग भाति विष्णोः कलास्यनिमिषन्मकरौ च कर्णौ।\nउद्विग्नमीनयुगलं द्विजपङ्क्तिशोभि चासन्नभृङ्गनिकरं सर उन्मुखं ते॥ ५/२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_002/BhP_05.002.016.m4a", "display_order": 17}, {"id": 6000097017, "chapter_id": 10097, "verse_number": "५-२-१५", "content_sanskrit": "योऽसौ त्वया करसरोजहतः पतङ्गो दिक्षु भ्रमन् भ्रमत एजयतेऽक्षिणी ते।\nयुक्तं न ते स्म वरवक्रजटावरूथं कृष्णोऽनिलो हरति लम्पट एष नीवीम्॥ ५/२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_002/BhP_05.002.017.m4a", "display_order": 18}, {"id": 6000097018, "chapter_id": 10097, "verse_number": "५-२-१६", "content_sanskrit": "रूपं तपोधन तपश्चरतां तपोघ्नं ह्येतत्तु केन तपसा भवतेह लब्धम्।\nचर्तुं तपोऽर्हसि मया सह मित्र मह्यं किं वा प्रसीदसि स वै भवभावनो मे॥ ५/२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_002/BhP_05.002.018.m4a", "display_order": 19}, {"id": 6000097019, "chapter_id": 10097, "verse_number": "५-२-१७", "content_sanskrit": "न त्वां त्यजामि दयितां द्विज देवदत्तं यस्मिन्मनो दृगपि वा न वियाति लग्नम्।\nमां चारुशृङ्गार्हसि नेतुमनुव्रतं ते चित्तं यतः प्रतिसरन्तु शिवाः सचिव्यः॥ ५/२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_002/BhP_05.002.019.m4a", "display_order": 20}, {"id": 6000097020, "chapter_id": 10097, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_002/BhP_05.002.020.m4a", "display_order": 21}, {"id": 6000097021, "chapter_id": 10097, "verse_number": "५-२-१८", "content_sanskrit": "इति ललनानुनयातिविशारदो ग्राम्यवैदग्ध्यया परिभाषया तां विबुधवधूमिति सभाजयामास॥ ५/२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_002/BhP_05.002.021.m4a", "display_order": 22}, {"id": 6000097022, "chapter_id": 10097, "verse_number": "५-२-१९", "content_sanskrit": "सा च ततस्तस्य वीरयूथपतेर्बुद्धिशीलरूपविद्यावयःश्रियौदार्यैः पराक्षिप्तमनास्तेन सहायुतायुत-परिवत्सरोपलक्षणं कालं जम्बुद्वीपपतिना भोगान् बुभुजे॥ ५/२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_002/BhP_05.002.022.m4a", "display_order": 23, "topics": [{"text": "सुचिरं कालं तया सह रममाणस्याग्नीध्रस्य तस्यां नाभिकिंपुरुषादिनवपुत्रोत्पत्तिः", "range": "१९–२३"}]}, {"id": 6000097023, "chapter_id": 10097, "verse_number": "५-२-२०", "content_sanskrit": "तस्यामु ह वा आत्मजान्स राजवर्य आग्नीध्रो नाभि-किम्पुरुष-हरिवर्ष-इलावृत-रम्यक-हिरण्मय-कुरु-भद्र-अश्वकेतुमालसंज्ञान्नव भावयाम्बभूव।\nसा सूत्वा तु पुत्रान्नवानुवत्सरं गृह एवापहाय पूर्वचित्तिर्भूय एवाजं देवमुपतस्थे॥ ५/२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_002/BhP_05.002.023.m4a", "display_order": 24}, {"id": 6000097024, "chapter_id": 10097, "verse_number": "५-२-२१", "content_sanskrit": "आग्नीध्रसुतास्ते मातुरनुग्रहादौत्पत्तिकेनैव संहननबलोपेताः पित्रा विभक्तात्मतुल्यनामानि यथाभागं जम्बूद्वीपवर्षाणि बुभुजुः॥ ५/२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_002/BhP_05.002.024.m4a", "display_order": 25}, {"id": 6000097025, "chapter_id": 10097, "verse_number": "५-२-२२", "content_sanskrit": "आग्नीध्रो राजपुत्रस्तामप्सरसमेवानुदिनमभिमन्यमानस्तस्याः सलोकतां श्रुतिभिरवरुन्धन् ईजे यत्र पितरो मादयन्ते॥ ५/२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_002/BhP_05.002.025.m4a", "display_order": 26}, {"id": 6000097026, "chapter_id": 10097, "verse_number": "५-२-२३", "content_sanskrit": "सम्परेते पितरि नव भ्रातरो मेरुदुहितॄर्मेरुदेवीं प्रतिरूपामुग्रदंष्ट्रीं लतां रामां श्यामां नारीं भद्रां देवीमिति संज्ञा नवोदवहन्॥ ५/२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_002/BhP_05.002.026.m4a", "display_order": 27}, {"id": 6000097027, "chapter_id": 10097, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां पञ्चमस्कन्धे द्वितीयाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]