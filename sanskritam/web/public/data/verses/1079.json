[{"id": 2004125, "chapter_id": 1079, "verse_number": "१-८०-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2004126, "chapter_id": 1079, "verse_number": "१-८०-१", "content_sanskrit": "एवं स नाहुषो राजा ययातिः पुत्रमीप्सितम्।\nराज्येऽभिषिच्य मुदितो वानप्रस्थोऽभवन्मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2004127, "chapter_id": 1079, "verse_number": "१-८०-२", "content_sanskrit": "उषित्वा च वने वासं ब्राह्मणैः संशितव्रतः।\nफलमूलाशनो दान्तस्ततः स्वर्गमितो गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2004128, "chapter_id": 1079, "verse_number": "१-८०-३", "content_sanskrit": "स गतः स्वर्निवासं तं निवसन्मुदितः सुखी।\nकालेन नातिमहता पुनः शक्रेण पातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2004129, "chapter_id": 1079, "verse_number": "१-८०-४", "content_sanskrit": "साधुभिः संगतिं लब्ध्वा पुनः स्वर्गमुपेयिवान्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2004130, "chapter_id": 1079, "verse_number": "१-८०-४x", "content_sanskrit": "जनमेजय उवाच।\nस्वर्गतश्च पुनर्ब्रह्मन्निवसन्देववेश्मनि।\nकालेन नातिमहता कथं शक्रेण पातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2004131, "chapter_id": 1079, "verse_number": "१-८०-५", "content_sanskrit": "निपतन्प्रच्युतः स्वर्गादप्राप्तो मेदिनीतलम्।\nस्थित आसीदन्तरिक्षे स तदेति श्रुतं मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2004132, "chapter_id": 1079, "verse_number": "१-८०-६", "content_sanskrit": "तत एव पुनश्चापि गतः स्वर्गमिति श्रुतम्।\nराज्ञा वसुमता सार्धमष्टकेन च वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2004133, "chapter_id": 1079, "verse_number": "१-८०-७", "content_sanskrit": "प्रतर्दनेन शिविना समेत्य किल संसदि।\nकर्मणा केन स दिवं पुनः प्राप्तो महीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2004134, "chapter_id": 1079, "verse_number": "१-८०-८", "content_sanskrit": "सर्वमेतदशेषेण श्रोतुमिच्छामि तत्त्वतः।\nकथ्यमानं त्वया विप्र विप्रर्षिगणसंनिधौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2004135, "chapter_id": 1079, "verse_number": "१-८०-९", "content_sanskrit": "देवराजसमो ह्यासीद्ययातिः पृथिवीपतिः।\nवर्धनः कुरुवंशस्य विभावसुसमद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2004136, "chapter_id": 1079, "verse_number": "१-८०-१०", "content_sanskrit": "तस्य विस्तीर्णयशसः सत्यकीर्तेर्महात्मनः।\nचरितं श्रोतुमिच्छामि दिवि चेह च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2004137, "chapter_id": 1079, "verse_number": "१-८०-११x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2004138, "chapter_id": 1079, "verse_number": "१-८०-११", "content_sanskrit": "हन्त ते कथयिष्यामि ययातेरुत्तरां कथाम्।\nदिवि चेह च पुण्यार्थां सर्वपापप्रणाशिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2004139, "chapter_id": 1079, "verse_number": "१-८०-१२", "content_sanskrit": "ययातिर्नाहुषो राजा पूरुं पुत्रं कनीयसम्।\nराज्येऽभिषिच्य मुदितः प्रावव्राज वनं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2004140, "chapter_id": 1079, "verse_number": "१-८०-१३", "content_sanskrit": "अन्त्युषे स विनिक्षिप्य पुत्रान्यदुपुरोगमान्।\nफलमूलाशनो राजा वने संन्यवसच्चिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2004141, "chapter_id": 1079, "verse_number": "१-८०-१४", "content_sanskrit": "शंसितात्मा जितक्रोधस्तर्पयन्पितृदेवताः।\nअग्नींश्च विधिवज्जुह्वन्वानप्रस्थविधानतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2004142, "chapter_id": 1079, "verse_number": "१-८०-१५", "content_sanskrit": "अथितीन्पूजयामास वन्येन हविषा विभुः।\nशिलोञ्छवृत्तिमास्थाय शेषान्नकृतभोजनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2004143, "chapter_id": 1079, "verse_number": "१-८०-१६", "content_sanskrit": "पूर्णं वर्षसहस्रं च एवंवृत्तिरभून्नृपः।\nअब्भक्षः शरदस्त्रिंशदासीन्नियतवाङ्मनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2004144, "chapter_id": 1079, "verse_number": "१-८०-१७", "content_sanskrit": "ततश्च वायुभक्षोऽभूत्संवत्सरमतन्द्रितः।\nतथा पञ्चाग्निमध्ये च तपस्तेपे स वत्सरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2004145, "chapter_id": 1079, "verse_number": "१-८०-१८", "content_sanskrit": "एकपादः स्तितश्चासीत्षण्मासाननिलाशनः।\nपुण्यकीर्तिस्ततः स्वर्गे जगामावृत्य रोदसी॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2004146, "chapter_id": 1079, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि अशीतितमोऽध्यायः॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]