[{"id": 7004310000, "chapter_id": 24310, "verse_number": "५-३-४-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nततोऽर्णवात्समुत्तीर्य त्रिकूटशिखरे स्थितम् ।\nमहाकनकवर्णाभे नानावर्णशिलाचिते॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004310001, "chapter_id": 24310, "verse_number": "५-३-४-२", "content_sanskrit": "महाशृङ्गे समासीनं रुद्रकोटिसमन्वितम् ।\nमहादेवं महात्मानमीशानमजमव्ययम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004310002, "chapter_id": 24310, "verse_number": "५-३-४-३", "content_sanskrit": "सर्वभूतमयं तात मनुना सह सुव्रत ।\nभूयो ववन्दे चरणौ सर्वदेवनमस्कृतौ॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004310003, "chapter_id": 24310, "verse_number": "५-३-४-४", "content_sanskrit": "तत्काले युगसाहस्रं सह रुद्रेण मानद ।\nतस्मिन्नेकार्णवे घोरे स्थितोऽहं कुरुनंदन॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004310004, "chapter_id": 24310, "verse_number": "५-३-४-५", "content_sanskrit": "युधिष्ठिर उवाच ।\nएतच्छ्रुत्वा तु मे तात परं कौतूहलं हृदि ।\nजातं तत्कथयस्वेति शृण्वतः सह बान्धवैः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004310005, "chapter_id": 24310, "verse_number": "५-३-४-६", "content_sanskrit": "का सा पद्मपलाशाक्षी तमोभूते महार्णवे ।\nयोगिवद्भ्रमते नित्यं रुद्रजां स्वां च याब्रवीत्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004310006, "chapter_id": 24310, "verse_number": "५-३-४-७", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nएतमेव मया प्रश्नं पुरा पृष्टो मनुः स्वयम् ।\nतदेव तेऽद्य वक्ष्यामि अबलायाः समुद्भवम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004310007, "chapter_id": 24310, "verse_number": "५-३-४-८", "content_sanskrit": "व्यतीतायां निशायां तु ब्रह्मणः परमेष्ठिनः ।\nततः प्रभाते विमले सृज्यमानेषु जन्तुषु॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004310008, "chapter_id": 24310, "verse_number": "५-३-४-९", "content_sanskrit": "मनुं प्रणम्य शिरसा पृच्छाम्येतद्युधिष्ठिर ।\nकेयं पद्मपलाशाक्षी श्यामा चंद्रनिभानना॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004310009, "chapter_id": 24310, "verse_number": "५-३-४-१०", "content_sanskrit": "एकार्णवे भ्रमत्येका रुद्रजास्मीति वादिनी ।\nसावित्री वेदमाता च ह्यथवा सा सरस्वती॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004310010, "chapter_id": 24310, "verse_number": "५-३-४-११", "content_sanskrit": "मन्दाकिनी सरिच्छ्रेष्ठा लक्ष्मीर्वा किमथो उमा ।\nकालरात्रिर्भवेत्साक्षात्प्रकृतिर्वा सुखोचिता॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004310011, "chapter_id": 24310, "verse_number": "५-३-४-१२", "content_sanskrit": "एतदाचक्ष्व भगवन्का सा ह्यमृतसंभवा ।\nचरत्येकार्णवे घोरे प्रनष्टोरगराक्षसे॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004310012, "chapter_id": 24310, "verse_number": "५-३-४-१३", "content_sanskrit": "मनुरुवाच ।\nशृणु वत्स यथान्यायमस्या वक्ष्यामि संभवम् ।\nयया रुद्रसमुद्भूता या चेयं वरवर्णिनी॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004310013, "chapter_id": 24310, "verse_number": "५-३-४-१४", "content_sanskrit": "पुरा शिवः शान्ततनुश्चचार विपुलं तपः ।\nहितार्थं सर्वलोकानामुमया सह शंकरः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004310014, "chapter_id": 24310, "verse_number": "५-३-४-१५", "content_sanskrit": "ऋक्षशैलं समारुह्य तपस्तेपे सुदारुणम् ।\nअदृश्यः सर्वभूतानां सर्वभूतात्मको वशी॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004310015, "chapter_id": 24310, "verse_number": "५-३-४-१६", "content_sanskrit": "तपतस्तस्य देवस्य स्वेदः समभवत्किल ।\nतं गिरिं प्लावयामास स स्वेदो रुद्रसंभवः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004310016, "chapter_id": 24310, "verse_number": "५-३-४-१७", "content_sanskrit": "तस्मादासीत्समुद्भूता महापुण्या सरिद्वरा ।\nया सा त्वयार्णवे दृष्टा पद्मपत्रायतेक्षणा॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004310017, "chapter_id": 24310, "verse_number": "५-३-४-१८", "content_sanskrit": "स्त्रीरूपं समवस्थाय रुद्रमाराधयत्पुरा ।\nआद्ये कृतयुगे तस्मिन्समानामयुतं नृप॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004310018, "chapter_id": 24310, "verse_number": "५-३-४-१९", "content_sanskrit": "ततस्तुष्टो महादेव उमया सह शंकरः ।\nब्रूहि त्वं तु महाभागे यत्ते मनसि वर्तते॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004310019, "chapter_id": 24310, "verse_number": "५-३-४-२०", "content_sanskrit": "सरिदुवाच ।\nप्रलये समनुप्राप्ते नष्टे स्थावरजंगमे ।\nप्रसादात्तव देवेश अक्षयाहं भवे प्रभो॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004310020, "chapter_id": 24310, "verse_number": "५-३-४-२१", "content_sanskrit": "सरित्सु सागरेष्वेव पर्वतेषु क्षयिष्वपि ।\nतव प्रसादाद्देवेश पुण्या क्षय्या भवे प्रभो॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004310021, "chapter_id": 24310, "verse_number": "५-३-४-२२", "content_sanskrit": "पापोपपातकैर्युक्ता महापातकिनोऽपि ये ।\nमुच्यन्ते सर्वपापेभ्यो भक्त्या स्नात्वा तु शंकर॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004310022, "chapter_id": 24310, "verse_number": "५-३-४-२३", "content_sanskrit": "उत्तरे जाह्नवीदेशे महापातकनाशिनी ।\nभवामि दक्षिणे मार्गे यद्येवं सुरपूजिता॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004310023, "chapter_id": 24310, "verse_number": "५-३-४-२४", "content_sanskrit": "स्वर्गादागम्य गंगेति यथा ख्याता क्षितौ विभो ।\nतथा दक्षिणगङ्गेति भवेयं त्रिदशेश्वर॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004310024, "chapter_id": 24310, "verse_number": "५-३-४-२५", "content_sanskrit": "पृथिव्यां सर्वतीर्थेषु स्नात्वा यल्लभते फलम् ।\nतत्फलं लभते मर्त्यो भक्त्या स्नात्वा महेश्वर॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004310025, "chapter_id": 24310, "verse_number": "५-३-४-२६", "content_sanskrit": "ब्रह्महत्यादिकं पापं यदास्ते संचितं क्वचित् ।\nमासमात्रेण तद्देव क्षयं यात्ववगाहनात्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004310026, "chapter_id": 24310, "verse_number": "५-३-४-२७", "content_sanskrit": "यत्फलं सर्ववेदेषु सर्वयज्ञेषु शंकर ।\nअवगाहेन तत्सर्वं भवत्विति मतिर्मम॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004310027, "chapter_id": 24310, "verse_number": "५-३-४-२८", "content_sanskrit": "सर्वदानोपवासेषु सर्वतीर्थावगाहने ।\nतत्फलं मम तोयेन जायतामिति शंकर॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004310028, "chapter_id": 24310, "verse_number": "५-३-४-२९", "content_sanskrit": "मम तीरे नरा ये तु अर्चयन्ति महेश्वरम् ।\nते गतास्तव लोकं स्युरेतदेव भवेच्छिव॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004310029, "chapter_id": 24310, "verse_number": "५-३-४-३०", "content_sanskrit": "मम कूले महेशान उमया सह दैवतैः ।\nवस नित्यं जगन्नाथ एष एव वरो मम॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004310030, "chapter_id": 24310, "verse_number": "५-३-४-३१", "content_sanskrit": "सुकर्मा वा विकर्मा वा शान्तो दान्तो जितेन्द्रियः ।\nमृतो जन्तुर्मम जले गच्छतादमरावतीम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004310031, "chapter_id": 24310, "verse_number": "५-३-४-३२", "content_sanskrit": "त्रिषु लोकेषु विख्याता महापातकनाशिनी ।\nभवामि देवदेवेश प्रसन्नो यदि मन्यसे॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004310032, "chapter_id": 24310, "verse_number": "५-३-४-३३", "content_sanskrit": "एतांश्चान्यान्वरान्दिव्यान्प्रार्थितो नृपसत्तम ।\nनर्मदया ततः प्राह प्रसन्नो वृषवाहनः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004310033, "chapter_id": 24310, "verse_number": "५-३-४-३४", "content_sanskrit": "श्रीमहेश उवाच ।\nएवं भवतु कल्याणि यत्त्वयोक्तमनिन्दिते ।\nनान्या वरार्हा लोकेषु मुक्त्वा त्वां कमलेक्षणे॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004310034, "chapter_id": 24310, "verse_number": "५-३-४-३५", "content_sanskrit": "यदैव मम देहात्त्वं समुद्भूता वरानने ।\nतदैव सर्वपापानां मोचिनी त्वं न संशयः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004310035, "chapter_id": 24310, "verse_number": "५-३-४-३६", "content_sanskrit": "कल्पक्षयकरे काले काले घोरे विशेषतः ।\nउत्तरं कूलमाश्रित्य निवसन्ति च ये नराः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004310036, "chapter_id": 24310, "verse_number": "५-३-४-३७", "content_sanskrit": "अपि कीटपतङ्गाश्च वृक्षगुल्मलतादयः ।\nआ देहपतनाद्देवि तेऽपि यास्यन्ति सद्गतिम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004310037, "chapter_id": 24310, "verse_number": "५-३-४-३८", "content_sanskrit": "दक्षिणं कूलमाश्रित्य ये द्विजा धर्मवत्सलाः ।\nआ मृत्योर्निवसिष्यन्ति ते गताः पितृमन्दिरे॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004310038, "chapter_id": 24310, "verse_number": "५-३-४-३९", "content_sanskrit": "अहं हि तव वाक्येन कस्मिंश्चित्कारणान्तरे ।\nत्वत्तीरे निवसिष्यामि सदैव ह्युमया समम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004310039, "chapter_id": 24310, "verse_number": "५-३-४-४०", "content_sanskrit": "एवं देवि महादेवि एवमेव न संशयः ।\nब्रह्मेन्द्रचन्द्रवरुणैः साध्यैश्च सह विष्णुना॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004310040, "chapter_id": 24310, "verse_number": "५-३-४-४१", "content_sanskrit": "उत्तरे देवि ते कूले वसिष्यन्ति ममाज्ञया ।\nदक्षिणे पितृभिः सार्द्धं तथान्ये सुरसुन्दरि॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004310041, "chapter_id": 24310, "verse_number": "५-३-४-४२", "content_sanskrit": "वसिष्यन्ति मया सार्द्धमेष ते वर उत्तमः ।\nगच्छ गच्छ महाभागे मर्त्यान्पापाद्विमोचय॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004310042, "chapter_id": 24310, "verse_number": "५-३-४-४३", "content_sanskrit": "सहिता ऋषिसंघैश्च तथा सिद्धसुरासुरैः ।\nएवमुक्ता महादेव उमया सहितो विभुः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004310043, "chapter_id": 24310, "verse_number": "५-३-४-४४", "content_sanskrit": "वन्द्यमानोऽथ मनुना मया चादर्शनं गतः ।\nतेन चैषा महापुण्या महापातकनाशिनी॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004310044, "chapter_id": 24310, "verse_number": "५-३-४-४५", "content_sanskrit": "कथिता पृच्छ्यते या ते मा ते भवतु विस्मयः ।\nएषा गंगा महापुण्या त्रिषु लोकेषु विश्रुता॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004310045, "chapter_id": 24310, "verse_number": "५-३-४-४६", "content_sanskrit": "दशाभिः पञ्चभिः स्रोतैः प्लावयन्ती दिशो दश ।\nशोणो महानदश्चैव नर्मदा सुरसा कृता॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004310046, "chapter_id": 24310, "verse_number": "५-३-४-४७", "content_sanskrit": "मन्दाकिनी दशार्णा च चित्रकूटा तथैव च ।\nतमसा विदिशा चैव करभा यमुना तथा॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004310047, "chapter_id": 24310, "verse_number": "५-३-४-४८", "content_sanskrit": "चित्रोत्पला विपाशा च रञ्जना वालुवाहिनी ।\nऋक्षपादप्रसूतास्ताः सर्वा वै रुद्रसंभवाः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004310048, "chapter_id": 24310, "verse_number": "५-३-४-४९", "content_sanskrit": "सर्वपापहराः पुण्याः सर्वमंगलदाः शिवाः ।\nइत्येतैर्नामभिर्दिव्यैः स्तूयते वेदपारगैः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004310049, "chapter_id": 24310, "verse_number": "५-३-४-५०", "content_sanskrit": "पुराणज्ञैर्महाभागैराज्यपैः सोमपैस्तथा ।\nइत्येतत्सर्वमाख्यातं महाभाग्यं नरोत्तम॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004310050, "chapter_id": 24310, "verse_number": "५-३-४-५१", "content_sanskrit": "मनुनोक्तं पुरा मह्यममृतायाः समुद्भवम् ।\nपुण्यं पवित्रमतुलं रुद्रोद्गीतमिदं शुभम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004310051, "chapter_id": 24310, "verse_number": "५-३-४-५२", "content_sanskrit": "ये नराः कीर्तयिष्यन्ति भक्त्या शृण्वन्ति येऽपि च ।\nप्रातरुत्थाय नामानि दश पञ्च च भारत॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004310052, "chapter_id": 24310, "verse_number": "५-३-४-५३", "content_sanskrit": "ते नराः सकलं पुण्यं लभिष्यन्त्यवगाहजम् ।\nविमानेनार्कवर्णेन घण्टाशतनिनादिना॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004310053, "chapter_id": 24310, "verse_number": "५-३-४-५४", "content_sanskrit": "त्यक्त्वा मानुष्यकं भावं यास्यन्ति परमां गतिम्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]