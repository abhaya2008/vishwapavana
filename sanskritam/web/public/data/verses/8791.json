[{"id": 40000309, "chapter_id": 8791, "verse_number": "1", "content_sanskrit": "एतच्छ्रुत्वा रहस्सूतो राजानमिदमब्रवीत्। ऋत्विग्भिरुपदिष्टोऽयं पुरावृत्तो मया श्रुत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40000310, "chapter_id": 8791, "verse_number": "2", "content_sanskrit": "सनत्कुमारो भगवान्पूर्वं कथितवान्कथाम्। ऋषीणां सन्निधौ राजन् तव पुत्रागमं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40000311, "chapter_id": 8791, "verse_number": "3", "content_sanskrit": "काश्यपस्यतु पुत्रोऽस्ति विभण्डक इति श्रुत:। ऋष्यशृङ्ग इति ख्यातस्तस्य पुत्रो भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40000312, "chapter_id": 8791, "verse_number": "4", "content_sanskrit": "स वने नित्यसंवृद्धो मुनिर्वनचरस्सदा । नान्यं जानाति विप्रेन्द्रो नित्यं पित्रनुवर्तनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40000313, "chapter_id": 8791, "verse_number": "5", "content_sanskrit": "द्वैविध्यं ब्रह्मचर्यस्य भविष्यति महात्मन:। लोकेषु प्रथितं राजन्विप्रैश्च कथितं सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40000314, "chapter_id": 8791, "verse_number": "6", "content_sanskrit": "तस्यैवं वर्तमानस्य कालस्समभिवर्तत । अग्निं शुश्रूषमाणस्य पितरं च यशस्विनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40000315, "chapter_id": 8791, "verse_number": "7", "content_sanskrit": "एतस्मिन्नेव काले तु रोमपाद: प्रतापवान्। अङ्गेषु प्रथितो राजा भविष्यति महाबल: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40000316, "chapter_id": 8791, "verse_number": "8", "content_sanskrit": "तस्य व्यतिक्रमाद्राज्ञो भविष्यति सुदारुणा । अनावृष्टिस्सुघोरा वै सर्वभूतभयावहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40000317, "chapter_id": 8791, "verse_number": "9", "content_sanskrit": "अनावृष्ट्यां तु वृत्तायां राजा दु:खसमन्वित:। ब्राह्मणान्श्रुतवृद्धांश्च समानीय प्रवक्ष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40000318, "chapter_id": 8791, "verse_number": "10", "content_sanskrit": "भवन्तश्श्रुतधर्माणो लोकचारित्रवेदिन: । समादिशन्तु नियमं प्रायश्चित्तं यथा भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40000319, "chapter_id": 8791, "verse_number": "11", "content_sanskrit": "वक्ष्यन्ति ते महीपालं ब्राह्मणा वेदपारगा:। विभण्डकसुतं राजन्सर्वोपायैरिहानय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40000320, "chapter_id": 8791, "verse_number": "12", "content_sanskrit": "आनाय्य च महीपाल ऋश्यशृङ्गं सुसत्कृतम्। प्रयच्छ कन्यां शान्तां वै विधिना सुसमाहित: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40000321, "chapter_id": 8791, "verse_number": "13", "content_sanskrit": "तेषां तु वचनं श्रुत्वा राजा चिन्तां प्रपत्स्यते । केनोपायेन वै शक्य इहानेतुं स वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40000322, "chapter_id": 8791, "verse_number": "14", "content_sanskrit": "ततो राजा विनिश्चित्य सह मन्त्रिभिरात्मवान्। पुरोहितममात्यांश्च तत: प्रेष्यति सत्कृतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40000323, "chapter_id": 8791, "verse_number": "15", "content_sanskrit": "ते तु राज्ञो वचश्श्रुशृत्वा व्यथिता विनतानना:। न गच्छेम ऋषेर्भीता अनुनेष्यन्ति तं नृपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40000324, "chapter_id": 8791, "verse_number": "16", "content_sanskrit": "वक्ष्यन्ति चिन्तयित्वा ते तस्योपायांश्च तत्क्षमान्। आनेष्यामो वयं विप्रं न च दोषो भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40000325, "chapter_id": 8791, "verse_number": "17", "content_sanskrit": "एवमङ्गाधिपेनैव गणिकाभि: ऋषेस्सुत:। आनीतोऽवर्षयद्देवश्शान्ता चास्मै प्रदीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40000326, "chapter_id": 8791, "verse_number": "18", "content_sanskrit": "ऋश्यशृङ्गस्तु जामाता पुत्रांस्तव विधास्यति। सनत्कुमारकथितमेतावद्व्याहृतं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40000327, "chapter_id": 8791, "verse_number": "19", "content_sanskrit": "अथ हृष्टो दशरथस्सुमन्त्रं प्रत्यभाषत। यथर्श्यशृङ्गस्त्वानीतो विस्तरेण त्वयोच्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]