[{"id": 2114755, "chapter_id": 3467, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2114756, "chapter_id": 3467, "verse_number": "१", "content_sanskrit": "ततः सर्वाः प्रकृतयो नगराद् वारणवतात् ।\nसर्वमङ्गलसंयुक्ता यथाशास्त्रमलङ्कृताः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2114757, "chapter_id": 3467, "verse_number": "२", "content_sanskrit": "श्रुत्वाऽऽगतान् पाण्डवेयान् नानायानैः सहस्रशः ।\nअभिजग्मुर्नरश्रेष्ठाः प्रीत्या परमया युताः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2114758, "chapter_id": 3467, "verse_number": "३", "content_sanskrit": "ते समासाद्य कौन्तेयान् वारणावतनागराः ।\nकृत्वा जयाशिषः सर्वे परिवव्रुर्युधिष्ठिरम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2114759, "chapter_id": 3467, "verse_number": "४", "content_sanskrit": "तैर्वृतः पुरुषव्याघ्रो धर्मराजो युधिष्ठिरः ।\nविबभौ देवसङ्काशो वज्रपाणिरिवामरैः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2114760, "chapter_id": 3467, "verse_number": "५", "content_sanskrit": "सत्कृतास्तत्र पौरैश्च पौरान् सत्कृत्य चानघाः ।\nअलङ्कृतजनाकीर्णं विविशुर्वारणावतम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2114761, "chapter_id": 3467, "verse_number": "६", "content_sanskrit": "ते प्रविश्य पुरीं वीरास्तूर्णं ययुरथो गृहान् ।\nब्राह्मणानां महीपाल रतानां स्वेषु कर्मसु \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2114762, "chapter_id": 3467, "verse_number": "७", "content_sanskrit": "नगराधिकृतानां च गृहाणि रथिनां तदा ।\nउपतस्थुर्नरश्रेष्ठा वैश्यशूद्रगृहाण्यपि \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2114763, "chapter_id": 3467, "verse_number": "८", "content_sanskrit": "अर्चिताश्च नरैः पौरैः पाण्डवा भरतर्षभ ।\nजग्मुरावसथं पश्चात् पुरोचनपुरस्कृताः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2114764, "chapter_id": 3467, "verse_number": "९", "content_sanskrit": "तेभ्यो भक्ष्यान्नपानानि शयनानि शुभानि च ।\nआसनानि च मुख्यानि प्रददौ स पुरोचनः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2114765, "chapter_id": 3467, "verse_number": "१०", "content_sanskrit": "तत्र ते सत्कृतास्तेन सुमहार्हपरिच्छदाः ।\nउपास्यमानाः पुरुषैरूषुः पुरनिवासिभिः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2114766, "chapter_id": 3467, "verse_number": "११", "content_sanskrit": "दशरात्रोषितानां तु तत्र तेषां पुरोचनः ।\nनिवेशयामास गृहं शिवाख्यमशिवं तदा \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2114767, "chapter_id": 3467, "verse_number": "१२", "content_sanskrit": "ततस्ते पुरुषव्याघ्रा ददृशुः सपरिच्छदाः ।\nपुरोचनस्य वचनात् कैलासमिव गुह्मकाः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2114768, "chapter_id": 3467, "verse_number": "१३", "content_sanskrit": "तत्त्वगारमभिप्रेक्ष्य सर्वधर्मविशारदः ।\nउवाचाग्नेयमित्येवं भीमसेनं युधिष्ठिरः ।\nजिघ्रन् सम्यग्वसागन्धं सर्पिर्लाक्षविमिश्रितम् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2114769, "chapter_id": 3467, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2114770, "chapter_id": 3467, "verse_number": "१४", "content_sanskrit": "कृतं हि व्यक्तमाग्नेयमिदं वेश्म परन्तप ।\nमृदेषा व्यक्तमाग्नेयैर्द्रव्यैर्मिश्रस्य वेश्मनः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2114771, "chapter_id": 3467, "verse_number": "१५", "content_sanskrit": "शणसर्जरसोपेता ह्मालिप्ता गृहभित्तिषु ।\nमुञ्जबल्वजवंशादि नूनं सर्वं घृतोक्षितम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2114772, "chapter_id": 3467, "verse_number": "१६", "content_sanskrit": "सभासर्जलसंयुक्तमानीतं गृहकर्मणि ।\nशणबल्वजकार्पासवंशदारुकटान्यपि \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2114773, "chapter_id": 3467, "verse_number": "१७", "content_sanskrit": "आग्नेयान्यत्र क्षिप्तानि परितो वेश्मनस्तथा ।\nशिल्पिभिः स्वहितैराप्तैर्विनीतैर्वेश्मकर्मणि \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2114774, "chapter_id": 3467, "verse_number": "१८", "content_sanskrit": "विश्वस्तानिह नः पापो दग्धुकामः पुरोचनः ।\nतथा हि वर्तते मन्दः सुयोधनमते स्थितः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2114775, "chapter_id": 3467, "verse_number": "१९", "content_sanskrit": "इमां तु वै महाबुद्धिर्विदुरो दृष्टवान् किल ।\nआपदं तेन मां पार्थ सर्वं बोधितवांस्तदा \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2114776, "chapter_id": 3467, "verse_number": "२०", "content_sanskrit": "ते वयं बोधितास्तेन बुद्धिमन्तोऽशिवं गृहम् ।\nआचार्यैः सुकृतं गूढैर्दुर्योधनवशानुगैः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2114777, "chapter_id": 3467, "verse_number": "", "content_sanskrit": "भीमसेनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2114778, "chapter_id": 3467, "verse_number": "२१", "content_sanskrit": "यदिदं गृहमाग्नेयं विदितं मन्यते भवान् ।\nतत्रैव साधु गच्छामो यत्र पूर्वोषिता वयम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2114779, "chapter_id": 3467, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2114780, "chapter_id": 3467, "verse_number": "२२", "content_sanskrit": "इह यत्तैर्निराकारैर्वस्तव्यमिति रोचते ।\nतुष्टैरिव विचिन्वद्भिर्गतिमन्यां ध्रुवामितः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2114781, "chapter_id": 3467, "verse_number": "२३", "content_sanskrit": "आकारं यदि जानीयादस्माकं स पुरोचनः ।\nशीघ्रकारी ततो भूत्वा प्रसह्मापि दहेत् पुनः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2114782, "chapter_id": 3467, "verse_number": "२४", "content_sanskrit": "नैवं बिभेत्युपक्रोशादधर्माच्च पुरोचनः ।\nतथा च वर्तते मन्दो दुर्योधनमते स्थितः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2114783, "chapter_id": 3467, "verse_number": "२५", "content_sanskrit": "अपि चास्मासु दग्धेषु भीष्मः कुरुपितामहः ।\nन कुप्येत किमर्थं वा कौरवान् कोपयेत सः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2114784, "chapter_id": 3467, "verse_number": "२६", "content_sanskrit": "तथा हि सहदग्धेषु विदुरः सपितामहः ।\nधर्मो नेहेति कुप्येत तथाऽन्ये कुरुपुङ्गवाः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2114785, "chapter_id": 3467, "verse_number": "२७", "content_sanskrit": "उपपन्नं तु दग्धेषु कुलवंशानुकीर्तिताः ।\nकुप्येरन् यदि धर्मज्ञास्तथाऽन्ये कुरुपुङ्गवाः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2114786, "chapter_id": 3467, "verse_number": "२८", "content_sanskrit": "वयं तु यदि दाहाद् वै बिभ्यन्तः प्राद्रवेमहि ।\nस्पशैर्नो घातयेत् सर्वान् राज्यलुब्धः सुयोधनः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2114787, "chapter_id": 3467, "verse_number": "२९", "content_sanskrit": "अपदस्थान् पदे तिष्ठन्नपक्षान् पक्षसंश्रितः ।\nहीनकोशान् महाकोशः प्रयोगैर्घातयेद् ध्रुवम् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2114788, "chapter_id": 3467, "verse_number": "३०", "content_sanskrit": "तदस्माभिरिमं पापं तं च पापं सुयोधनम् ।\nवञ्चयद्भिर्निवस्तव्यं छन्नं वासं क्वचित्क्कचित् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2114789, "chapter_id": 3467, "verse_number": "३१", "content_sanskrit": "ते वयं मृगयाशीलाश्चराम वसुधामिमाम् ।\nतथाऽन्ये विदिता मार्गा भविष्यन्ति पलायताम् \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2114790, "chapter_id": 3467, "verse_number": "३२", "content_sanskrit": "भौमं च बिलमद्यैव कारयामः सुसंवृतम् ।\nगूढोच्छ्वासं न नस्तत्र हुताशः सम्प्रधक्ष्यति \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2114791, "chapter_id": 3467, "verse_number": "३३", "content_sanskrit": "द्रवतोऽत्र यथा चास्मान् न बुध्येत पुरोचनः ।\nपौरो वाऽपि जनः कश्चित् तथा कार्यमतन्द्रितैः \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2114792, "chapter_id": 3467, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nषट्चत्वारिंशत्यधिकशततमोऽध्यायः ॥१४६॥ ॥ इति जतुगृहदाहपर्वणि चतुर्थोऽध्यायः ॥४॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]