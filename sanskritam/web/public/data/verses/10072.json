[{"id": 6000072000, "chapter_id": 10072, "verse_number": null, "content_sanskrit": "अथ अष्टमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000072001, "chapter_id": 10072, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.001.m4a", "display_order": 2}, {"id": 6000072002, "chapter_id": 10072, "verse_number": "४-८-१", "content_sanskrit": "इत्यजेनानुनीतेन भवेन परितुष्यता।\nअभ्यधायि महाबाहो प्रहस्य श्रूयतामिति॥ ४/८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.002.m4a", "display_order": 3, "topics": [{"text": "परितुष्टेन शङ्करेण सह ब्रह्मादिदेवानां दक्षाध्वरागमनम्", "range": "१–१२"}]}, {"id": 6000072003, "chapter_id": 10072, "verse_number": null, "content_sanskrit": "रुद्र उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.003.m4a", "display_order": 4}, {"id": 6000072004, "chapter_id": 10072, "verse_number": "४-८-२", "content_sanskrit": "नाघं प्रजेश बालानां वर्णये नानुचिन्तये।\nदेवमायाभिभूतानां दण्डस्तत्र धृतो मया॥ ४/८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.004.m4a", "display_order": 5}, {"id": 6000072005, "chapter_id": 10072, "verse_number": "४-८-३", "content_sanskrit": "प्रजापतेर्दग्धशीर्ष्णो भवत्वजमुखं शिरः।\nमित्रस्य चक्षुषेक्षेत भागं स्वं बर्हिषो भगः॥ ४/८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.005.m4a", "display_order": 6}, {"id": 6000072006, "chapter_id": 10072, "verse_number": "४-८-४", "content_sanskrit": "पूषा तु यजमानस्य दद्भिर्जक्षतु पिष्टभुक्।\nदेवाः प्रकृतसर्वाङ्गा ये म उच्छेषणं ददुः॥ ४/८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.006.m4a", "display_order": 7}, {"id": 6000072007, "chapter_id": 10072, "verse_number": "४-८-५", "content_sanskrit": "बाहुभ्यामश्विनोः पूष्णो हस्ताभ्यां कृतबाहवः।\nभवन्त्वध्वर्यवश्चान्ये बस्तश्मश्रुर्भृगुर्भवेत्॥ ४/८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.007.m4a", "display_order": 8}, {"id": 6000072008, "chapter_id": 10072, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.008.m4a", "display_order": 9}, {"id": 6000072009, "chapter_id": 10072, "verse_number": "४-८-६", "content_sanskrit": "तदा सर्वाणि भूतानि श्रुत्वा मीढुष्टमोदितम्।\nपरितुष्टात्मभिस्तात साधु साध्वित्यथाब्रुवन्॥ ४/८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.009.m4a", "display_order": 10}, {"id": 6000072010, "chapter_id": 10072, "verse_number": "४-८-७", "content_sanskrit": "ततो मीढ्वांसमामन्त्र्य शुनासीराः सहर्षिभिः।\nभूयस्तद् देवयजनं समीढ्वद्वेधसो ययुः॥ ४/८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.010.m4a", "display_order": 11}, {"id": 6000072011, "chapter_id": 10072, "verse_number": "४-८-८", "content_sanskrit": "विधाय कार्त्स्न्येन च तद् यदाह भगवान् भवः।\nसन्दधुः कस्य कायेन सवनीयपशोः शिरः॥ ४/८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.011.m4a", "display_order": 12}, {"id": 6000072012, "chapter_id": 10072, "verse_number": "४-८-९", "content_sanskrit": "सन्धीयमाने शीर्षणि दक्षो रुद्राभिवीक्षितः।\nसद्यः सुप्त इवोत्तस्थौ ददृशे चाग्रतो मृडम्॥ ४/८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.012.m4a", "display_order": 13}, {"id": 6000072013, "chapter_id": 10072, "verse_number": "४-८-१०", "content_sanskrit": "तदा वृषध्वजद्वेषकलिलात्मा प्रजापतिः।\nशिवावलोकादभवच्छरदभ्र इवामलः॥ ४/८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.013.m4a", "display_order": 14}, {"id": 6000072014, "chapter_id": 10072, "verse_number": "४-८-११", "content_sanskrit": "भवस्तवाय कृतधीर्नाशक्नोदनुरागतः।\nऔत्कण्ठ्यबाष्पकलया सम्परेतां सुतां स्मरन्॥ ४/८/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.014.m4a", "display_order": 15}, {"id": 6000072015, "chapter_id": 10072, "verse_number": "४-८-१२", "content_sanskrit": "कृच्छ्रात् संस्तभ्य च मनः प्रेमविह्वलितः सुधीः।\nशशंस निर्व्यलीकेन भावेनेशं प्रजापतिः॥ ४/८/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.015.m4a", "display_order": 16}, {"id": 6000072016, "chapter_id": 10072, "verse_number": null, "content_sanskrit": "दक्ष उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.016.m4a", "display_order": 17}, {"id": 6000072017, "chapter_id": 10072, "verse_number": "४-८-१३", "content_sanskrit": "भूयाननुग्रह अहो भवता कृतो मे दण्डस्त्वया मयि धृतो यदपि प्रसह्य।\nन ब्रह्मबन्धुषु च वां भगवन्नवज्ञा तुभ्यं हरेश्च कुत एव धृतव्रतेषु॥ ४/८/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.017.m4a", "display_order": 18, "topics": [{"text": "दक्षादीनां रुद्रानुग्रहेण शिरआद्यवयवप्राप्तिः", "range": "१३–४८"}]}, {"id": 6000072018, "chapter_id": 10072, "verse_number": "४-८-१४", "content_sanskrit": "विद्यातपोव्रतधरान् मुखतः स्म विप्रान् ब्रह्मात्मतां प्रथयितुं प्रथमं त्वमस्राः।\nतद् ब्राह्मणान् परम शर्व विपत्सु पासि पालः पशूनिव विभो प्रगृहीतदण्डः॥ ४/८/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.018.m4a", "display_order": 19}, {"id": 6000072019, "chapter_id": 10072, "verse_number": "४-८-१५", "content_sanskrit": "योऽसौ मयाऽविदिततत्त्वदृशा सभायां क्षिप्तो दुरुक्तिविशिखैरगणय्य तन्माम्।\nअर्वाक् पतन्तमर्हत्तमनिन्दयैक्षद् दृष्ट्याऽऽर्द्रया स भगवान् स्वकृतेन तुष्येत्॥ ४/८/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.019.m4a", "display_order": 20}, {"id": 6000072020, "chapter_id": 10072, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.020.m4a", "display_order": 21}, {"id": 6000072021, "chapter_id": 10072, "verse_number": "४-८-१६", "content_sanskrit": "क्षमाप्यैवं स मीढ्वांसं ब्रह्मणा चानुमन्त्रितः।\nकर्म सन्तानयामास सोपाध्यायर्त्विगग्निभिः॥ ४/८/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.021.m4a", "display_order": 22}, {"id": 6000072022, "chapter_id": 10072, "verse_number": "४-८-१७", "content_sanskrit": "वैष्णवं यज्ञसन्तत्यै त्रिकपालं द्विजोत्तमाः।\nपुरोडाशं निरवपन् वीरसंसर्गशुद्धये॥ ४/८/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.022.m4a", "display_order": 23}, {"id": 6000072023, "chapter_id": 10072, "verse_number": "४-८-१८", "content_sanskrit": "अध्वर्युणाऽऽत्तहविषा यजमानो यजुष्पतिम्।\nयथा विशुद्धया दध्यौ तथा प्रादुरभूद्धरिः॥ ४/८/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.023.m4a", "display_order": 24}, {"id": 6000072024, "chapter_id": 10072, "verse_number": "४-८-१९", "content_sanskrit": "तदा स्वप्रभया तेषां द्योतयन्त्या दिशो दश।\nमुष्णंस्तेज उपानीतस्तार्क्ष्येण स्तोत्रनिर्जितः॥ ४/८/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.024.m4a", "display_order": 25}, {"id": 6000072025, "chapter_id": 10072, "verse_number": "४-८-२०", "content_sanskrit": "श्यामो हिरण्यरशनोऽर्ककिरीटजुष्टो नीलालकभ्रमरकुण्डलमण्डितास्यः।\nकम्ब्वब्जचक्रशरचापगदासिचर्मव्यग्रैर्हिरण्मयभुजैरिव कर्णिकारः॥ ४/८/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.025.m4a", "display_order": 26}, {"id": 6000072026, "chapter_id": 10072, "verse_number": "४-८-२१", "content_sanskrit": "वक्षस्यधिश्रितवधूर्वनमाल्युदारहासावलोककलया रमयंश्च विश्वम्।\nपार्श्वभ्रमद्व्यजनचामरराजहंसशुभ्रातपत्रशशिनोपरि लक्ष्यमाणः॥ ४/८/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.026.m4a", "display_order": 27}, {"id": 6000072027, "chapter_id": 10072, "verse_number": "४-८-२२", "content_sanskrit": "तमुपागतमालक्ष्य सर्वे सुरगणादयः।\nप्रणेमुः सहसोत्थाय ब्रह्मेन्द्रत्र्यक्षनायकाः॥ ४/८/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.027.m4a", "display_order": 28}, {"id": 6000072028, "chapter_id": 10072, "verse_number": "४-८-२३", "content_sanskrit": "तत्तेजसा हतरुचः सन्नजिह्वाः ससाध्वसाः।\nमूर्ध्नि कृताञ्जलिपुटा उपतस्थुरधोक्षजम्॥ ४/८/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.028.m4a", "display_order": 29}, {"id": 6000072029, "chapter_id": 10072, "verse_number": "४-८-२४", "content_sanskrit": "अप्यर्वाग्वृत्तयो यस्य महित्वे स्वभुवादयः।\nयथामति गृणन्ति स्म कृतानुग्रहविग्रहम्॥ ४/८/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.029.m4a", "display_order": 30}, {"id": 6000072030, "chapter_id": 10072, "verse_number": "४-८-२५", "content_sanskrit": "दक्षो गृहीतार्हणसाधनोत्तमो यज्ञेश्वरं विश्वसृजं परं गुरुम्।\nसुनन्दनन्दाद्यनुगैर्वृतं मुदा गृणन् प्रपेदे प्रयतः कृताञ्जलिः॥ ४/८/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.030.m4a", "display_order": 31}, {"id": 6000072031, "chapter_id": 10072, "verse_number": null, "content_sanskrit": "दक्ष उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.031.m4a", "display_order": 32}, {"id": 6000072032, "chapter_id": 10072, "verse_number": "४-८-२६", "content_sanskrit": "शुद्धं स्वधाम्न्युपरताखिलबुद्ध्यवस्थं चिन्मात्रमेकमभयं प्रतिषिध्य मायाम्।\nतिष्ठंस्तयैव पुरुषत्वमुपेत्य तस्यामास्ते भवानपरिशुद्धमिवामनन्ति॥ ४/८/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.032.m4a", "display_order": 33}, {"id": 6000072033, "chapter_id": 10072, "verse_number": null, "content_sanskrit": "ऋत्विज ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.033.m4a", "display_order": 34}, {"id": 6000072034, "chapter_id": 10072, "verse_number": "४-८-२७", "content_sanskrit": "तत्त्वं न ते वयमनञ्जन रुद्रशापात् कर्मण्यवग्रहधियो भगवन् विदामः।\nधर्मोपलक्षणमिदं त्रिवृदध्वराख्यं ज्ञातं यदर्थमधिदैवमदस्त्वमास्थाः॥ ४/८/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.034.m4a", "display_order": 35}, {"id": 6000072035, "chapter_id": 10072, "verse_number": null, "content_sanskrit": "सदस्या ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.035.m4a", "display_order": 36}, {"id": 6000072036, "chapter_id": 10072, "verse_number": "४-८-२८", "content_sanskrit": "उत्पत्त्यध्वन्यशरण उरुक्लेशदुर्गान्तकोग्रव्यालाकृष्टे विषयमृगतृष्णात्मगेहोरुभारः।\nद्वन्द्वश्वभ्रे खलमृगभये शोकदावेऽज्ञसार्थः पादौ शस्तौ शरणद कदा याति कामोपसृष्टः॥ ४/८/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.036.m4a", "display_order": 37}, {"id": 6000072037, "chapter_id": 10072, "verse_number": null, "content_sanskrit": "रुद्र उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.037.m4a", "display_order": 38}, {"id": 6000072038, "chapter_id": 10072, "verse_number": "४-८-२९", "content_sanskrit": "तव वरद वराड्घ्रावाशिषा चानभिध्ये ह्यपि मुनिभिरसक्तैरादरेणार्हणीये।\nयदि रचितधियं मां विद्धि लोकापविद्धं जगति न गणयेयं त्वत्परानुग्रहेण॥ ४/८/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.038.m4a", "display_order": 39}, {"id": 6000072039, "chapter_id": 10072, "verse_number": null, "content_sanskrit": "भृगुरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.039.m4a", "display_order": 40}, {"id": 6000072040, "chapter_id": 10072, "verse_number": "४-८-३०", "content_sanskrit": "यन्मायया गहनयाऽपहृतात्मबोधा ब्रह्मादयस्तनुभृतस्तमसि स्वपन्तः।\nनात्माश्रितं तव विदन्त्यधुनाऽपि तत्त्वं सोऽयं प्रसीदतु भवान् प्रणतात्मबन्धुः॥ ४/८/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.040.m4a", "display_order": 41}, {"id": 6000072041, "chapter_id": 10072, "verse_number": "४-८-३१", "content_sanskrit": "नैतत् स्वरूपं भवतोऽसौ पदार्थभेदग्रहः पुरुषो यावदीक्षेत्।\nज्ञानस्य चार्थस्य गुणस्य चाश्रयान् मायामयाद् व्यतिरिक्तो यतस्त्वम्॥ ४/८/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.041.m4a", "display_order": 42}, {"id": 6000072042, "chapter_id": 10072, "verse_number": null, "content_sanskrit": "इन्द्र उवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.042.m4a", "display_order": 43}, {"id": 6000072043, "chapter_id": 10072, "verse_number": "४-८-३२", "content_sanskrit": "इदमच्युत विश्वभावनं वपुरानन्दकरं मनोदृशम्।\nसुरविद्विट्क्षपणैरुदायुधैर्भुजदण्डैरुपपन्नमष्टभिः॥ ४/८/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.043.m4a", "display_order": 44}, {"id": 6000072044, "chapter_id": 10072, "verse_number": null, "content_sanskrit": "यज्ञपत्न्य ऊचुः —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.044.m4a", "display_order": 45}, {"id": 6000072045, "chapter_id": 10072, "verse_number": "४-८-३३", "content_sanskrit": "यज्ञोऽयं तव यजनाय केन सृष्टो विध्वस्तः पशुपतिनाऽद्य दक्षकोपात्।\nतन्नस्त्वं शवशयनाभ शान्तमेधं यज्ञात्मन्नलिनरुचा दृशा पुनीहि॥ ४/८/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.045.m4a", "display_order": 46}, {"id": 6000072046, "chapter_id": 10072, "verse_number": null, "content_sanskrit": "ऋषय ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.046.m4a", "display_order": 47}, {"id": 6000072047, "chapter_id": 10072, "verse_number": "४-८-३४", "content_sanskrit": "अनन्वितं ते भगवन् विचेष्टितं यदात्मना चरसि हि कर्म नाज्यसे।\nविभूतयो यत उपसेदुरीश्वरान् न मन्यते स्वयमनुवर्तिनीं भवान्॥ ४/८/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.047.m4a", "display_order": 48}, {"id": 6000072048, "chapter_id": 10072, "verse_number": null, "content_sanskrit": "सिद्धा ऊचुः —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.048.m4a", "display_order": 49}, {"id": 6000072049, "chapter_id": 10072, "verse_number": "४-८-३५", "content_sanskrit": "अयं ते कथामृष्टपीयूषनद्यां मनोवारणः क्लेशदावाग्निदग्धः।\nतृषार्तोऽवगाढो न सस्मार दावं न निष्क्रामति ब्रह्मसंपन्नवन्नः॥ ४/८/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.049.m4a", "display_order": 50}, {"id": 6000072050, "chapter_id": 10072, "verse_number": null, "content_sanskrit": "यजमानी उवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.050.m4a", "display_order": 51}, {"id": 6000072051, "chapter_id": 10072, "verse_number": "४-८-३६", "content_sanskrit": "स्वागतं ते प्रसीदेश तुभ्यं नमः श्रीनिवास श्रिया कान्तया त्राहि नः।\nत्वामृतेऽधीश नाङ्गैर्मखः शोभते शीर्षहीनः कबन्धो यथा पूरुषः॥ ४/८/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.051.m4a", "display_order": 52}, {"id": 6000072052, "chapter_id": 10072, "verse_number": null, "content_sanskrit": "लोकपाला ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.052.m4a", "display_order": 53}, {"id": 6000072053, "chapter_id": 10072, "verse_number": "४-८-३७", "content_sanskrit": "दृष्टः किं नो दृग्भिरसद्ग्रहैस्त्वं प्रत्यग्दृष्ट्या दृश्यते येन विश्वम्।\nमाया ह्येषा भवदीया हि भूमन् यस्त्वं षष्ठः पञ्चभिर्भासि भूतैः॥ ४/८/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.053.m4a", "display_order": 54}, {"id": 6000072054, "chapter_id": 10072, "verse_number": null, "content_sanskrit": "योगेश्वरा ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.054.m4a", "display_order": 55}, {"id": 6000072055, "chapter_id": 10072, "verse_number": "४-८-३८", "content_sanskrit": "प्रेयान्न तेऽन्योऽस्त्यमृतप्रिय प्रभो विश्वात्मनीक्षेन्न पृथग् य आत्मनः।\nअथापि भृत्येश तयोपधावतामनन्यवृत्त्याऽनुगृहाण वत्सल॥ ४/८/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.055.m4a", "display_order": 56}, {"id": 6000072056, "chapter_id": 10072, "verse_number": "४-८-३९", "content_sanskrit": "जगदुद्भवस्थितिलयेषु लीलया प्रविभज्यमानगुणयाऽऽत्ममायया।\nरचितात्मभेदमतये स्वसंस्थया ह्यतिवर्तितभ्रमगुणात्मने नमः॥ ४/८/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.056.m4a", "display_order": 57}, {"id": 6000072057, "chapter_id": 10072, "verse_number": null, "content_sanskrit": "ब्रह्मोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.057.m4a", "display_order": 58}, {"id": 6000072058, "chapter_id": 10072, "verse_number": "४-८-४०", "content_sanskrit": "नमस्तेऽमिततत्त्वाय धर्मादीनां च सूतये।\nनिर्गुणाय च यत्काष्ठां नाहं वेदापरे कुतः॥ ४/८/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.058.m4a", "display_order": 59}, {"id": 6000072059, "chapter_id": 10072, "verse_number": null, "content_sanskrit": "अग्निरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.059.m4a", "display_order": 60}, {"id": 6000072060, "chapter_id": 10072, "verse_number": "४-८-४१", "content_sanskrit": "यत्तेजसाऽहं सुसमिद्धतेजा हव्यं वहाम्यध्वर आज्यसिक्तम्।\nतं यज्ञियं पञ्चविधं च पञ्चभिः स्विष्टं यजुर्भिः प्रणतोऽस्मि यज्ञम्॥ ४/८/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.060.m4a", "display_order": 61}, {"id": 6000072061, "chapter_id": 10072, "verse_number": null, "content_sanskrit": "देवा ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.061.m4a", "display_order": 62}, {"id": 6000072062, "chapter_id": 10072, "verse_number": "४-८-४२", "content_sanskrit": "पुरा कल्पापाये स्वकृतमुदरीकृत्य विकृतं त्वमेवाद्यस्तस्मिन् सलिल उरगेन्द्राधिशयने।\nपुमाञ्छेषे सिर्द्धैहृदि विमृशिताध्यात्मपदविः स एवाद्याक्ष्णोर्नः पथि चरसि भृत्यानवसि च॥ ४/८/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.062.m4a", "display_order": 63}, {"id": 6000072063, "chapter_id": 10072, "verse_number": null, "content_sanskrit": "गन्धर्वा ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.063.m4a", "display_order": 64}, {"id": 6000072064, "chapter_id": 10072, "verse_number": "४-८-४३", "content_sanskrit": "आशासाना देव मरीच्यादय एते ब्रह्मेन्द्राद्या देवगणा रुद्रपुरोगाः।\nक्रीडाभाण्डं विश्वमिदं यस्य विभूम्नस्तस्मै नित्यं नाथ नमस्ते करवामः॥ ४/८/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.064.m4a", "display_order": 65}, {"id": 6000072065, "chapter_id": 10072, "verse_number": null, "content_sanskrit": "विद्याधरा ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.065.m4a", "display_order": 66}, {"id": 6000072066, "chapter_id": 10072, "verse_number": "४-८-४४", "content_sanskrit": "त्वन्माययाऽर्थमभिपद्य कलेवरेऽस्मिन् कृत्वा ममाहमिति दुर्मतिरुत्पथैः स्वैः।\nक्षिप्तोऽप्यसद्विषयलालस आत्ममोहं युष्मत्कथामृतनिषेवक उद्व्युदस्येत्॥ ४/८/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.066.m4a", "display_order": 67}, {"id": 6000072067, "chapter_id": 10072, "verse_number": null, "content_sanskrit": "ब्राह्मणा ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.067.m4a", "display_order": 68}, {"id": 6000072068, "chapter_id": 10072, "verse_number": "४-८-४५", "content_sanskrit": "त्वं क्रतुस्त्वं हविस्त्वं हुताशः स्वयं त्वं हि मन्त्राः समिद् दर्भपात्राणि च।\nत्वं सदस्यर्त्विजो दम्पती देवता अग्निहोत्रं स्वधा सोम आज्यं पशुः॥ ४/८/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.068.m4a", "display_order": 69}, {"id": 6000072069, "chapter_id": 10072, "verse_number": "४-८-४६", "content_sanskrit": "त्वं पुरा गां रसाया महान् सूकरो दंष्ट्रया पद्मिनीं वारणेन्द्रो यथा।\nस्तूयमानो नदल्लीलया योगिभिर्व्युज्जहर्थ त्रयीगात्र यज्ञक्रतुः॥ ४/८/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.069.m4a", "display_order": 70}, {"id": 6000072070, "chapter_id": 10072, "verse_number": null, "content_sanskrit": "सामगा ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.070.m4a", "display_order": 71}, {"id": 6000072071, "chapter_id": 10072, "verse_number": "४-८-४७", "content_sanskrit": "संप्रसीद त्वमस्माकमाकाङ्क्षतां दर्शनं ते परिभ्रष्टसत्कर्मणाम्।\nकीर्त्यमाना नृभिः सामगीरीश ते यज्ञविघ्नाः क्षयं यान्ति तस्मै नमः॥ ४/८/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.071.m4a", "display_order": 72}, {"id": 6000072072, "chapter_id": 10072, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.072.m4a", "display_order": 73}, {"id": 6000072073, "chapter_id": 10072, "verse_number": "४-८-४८", "content_sanskrit": "इति दक्षः कविर्यज्ञं भद्ररुद्रावमर्शितम्।\nकीर्त्यमाने हृषीकेशे उन्निन्ये यज्ञभावने॥ ४/८/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.073.m4a", "display_order": 74}, {"id": 6000072074, "chapter_id": 10072, "verse_number": "४-८-४९", "content_sanskrit": "भगवान् स्वेन भागेन सर्वात्मा सर्वभागभुक्।\nदक्षं बभाष आभाष्य प्रीयमाण इवानघ॥ ४/८/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.074.m4a", "display_order": 75, "topics": [{"text": "तत्र यज्ञकुण्डात्प्रादुर्भूतस्य विष्णोः दक्षादिभिरनेकैः कृता स्तुतिः", "range": "४९"}]}, {"id": 6000072075, "chapter_id": 10072, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.075.m4a", "display_order": 76}, {"id": 6000072076, "chapter_id": 10072, "verse_number": "४-८-५०", "content_sanskrit": "अहं ब्रह्मा च शर्वश्च जगतः कारणं परम्।\nआत्मेश्वर उपद्रष्टा स्वयंदृगविशेषणः॥ ४/८/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.076.m4a", "display_order": 77, "topics": [{"text": "विष्णुना दक्षं प्रति स्वस्वरूप-वर्णनम्", "range": "५०–५४"}]}, {"id": 6000072077, "chapter_id": 10072, "verse_number": "४-८-५१", "content_sanskrit": "स आत्ममायामाविश्य योऽहं गुणमयीं द्विज।\nसृजन् रक्षन् हरन् विश्वं दध्रे संज्ञाः क्रियोचिताः॥ ४/८/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.077.m4a", "display_order": 78}, {"id": 6000072078, "chapter_id": 10072, "verse_number": "४-८-५२", "content_sanskrit": "तस्मिन् ब्रह्मण्यद्वितीये केवले परमात्मनि।\nदेहात्मबुद्धिर्भूतानि भेदेनाज्ञोऽनुपश्यति॥ ४/८/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.078.m4a", "display_order": 79}, {"id": 6000072079, "chapter_id": 10072, "verse_number": "४-८-५३", "content_sanskrit": "यथा पुमान् न स्वाङ्गेषु शिरःपाण्यादिषु क्‍वचित्।\nपारक्यबुद्धिं कुरुत एवं भूतेषु मत्परः॥ ४/८/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.079.m4a", "display_order": 80}, {"id": 6000072080, "chapter_id": 10072, "verse_number": "४-८-५४", "content_sanskrit": "त्रयाणामेकभावानां यो न पश्यति वै भिदाम्।\nसर्वभूतात्मना ब्रह्मन् स शान्तिमधिगच्छति॥ ४/८/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.080.m4a", "display_order": 81}, {"id": 6000072081, "chapter_id": 10072, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.081.m4a", "display_order": 82}, {"id": 6000072082, "chapter_id": 10072, "verse_number": "४-८-५५", "content_sanskrit": "एवं भगवताऽऽदिष्टः प्रजापतिपतिर्हरिम्।\nअर्चित्वा क्रतुना स्वेन देवानुभयतोऽयजत्॥ ४/८/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.082.m4a", "display_order": 83, "topics": [{"text": "अवभृथस्नानानन्तरं देवानां स्वस्वस्थानगमनम्", "range": "५५–५७"}]}, {"id": 6000072083, "chapter_id": 10072, "verse_number": "४-८-५६", "content_sanskrit": "रुद्रं च स्वेन भागेन ह्युपाधावत् समाहितः।\nकर्मणोदवसानेन सोमपानितरानपि॥ ४/८/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.083.m4a", "display_order": 84}, {"id": 6000072084, "chapter_id": 10072, "verse_number": "४-८-५७", "content_sanskrit": "उदवस्य सहर्त्विग्भिः सस्नाववभृथं ततः। तस्मा अप्यनुभावेन स्वेनैवावाप्तराधसे।\nधर्म एव मतिं दत्त्वा त्रिदशास्ते दिवं ययुः॥ ४/८/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.084.m4a", "display_order": 85}, {"id": 6000072085, "chapter_id": 10072, "verse_number": "४-८-५८", "content_sanskrit": "एवं दाक्षायणी हित्वा सती पूर्वकलेवरम्।\nजज्ञे हिमवतः क्षेत्रे मेनायामिति शुश्रुम॥ ४/८/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.085.m4a", "display_order": 86, "topics": [{"text": "मैत्रेयेण विदुरं प्रति यज्ञकथा-श्रवणफलकथनम्", "range": "५८–६१"}]}, {"id": 6000072086, "chapter_id": 10072, "verse_number": "४-८-५९", "content_sanskrit": "तमेव दयितं भूय आवृणोत् पतिमम्बिका।\nअनन्यभावैकगतिः शक्तिः सुप्तेव पूरुषम्॥ ४/८/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.086.m4a", "display_order": 87}, {"id": 6000072087, "chapter_id": 10072, "verse_number": "४-८-६०", "content_sanskrit": "एतद् भगवतः शम्भोः कर्म दक्षाध्वरद्रुहः।\nश्रुतं भागवताच्छिष्यादुद्धवान्मे बृहस्पतेः॥ ४/८/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.087.m4a", "display_order": 88}, {"id": 6000072088, "chapter_id": 10072, "verse_number": "४-८-६१", "content_sanskrit": "इदं रहस्यं परमीशचेष्टितं यशस्यमायुष्यमघौघमर्षणम्।\nयो नित्यदाऽऽकर्ण्य तु कीर्तयेद् बुधो धुनोत्यघं कौरव भक्तिभावितः॥ ४/८/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.088.m4a", "display_order": 89}, {"id": 6000072089, "chapter_id": 10072, "verse_number": "४-८-६२", "content_sanskrit": "सतीं मेनात्मजां तात प्राप्य जायां भवः पुनः।\nतया मैथुनमारभ्य रेमे देवः समाः शतम्॥ ४/८/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.089.m4a", "display_order": 90, "topics": [{"text": "सतीदेव्याः पार्वतीत्वेनावतारः, तस्यां सुब्रह्मण्योत्पत्तेश्च कथनम्", "range": "६२–६५"}]}, {"id": 6000072090, "chapter_id": 10072, "verse_number": "४-८-६३", "content_sanskrit": "स्ववीर्यधारणेऽकल्पां ज्ञात्वा जायां स धूर्जटिः।\nउत्ससर्जाम्बरे रेतो गङ्गा जग्राह तन्नदी॥ ४/८/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.090.m4a", "display_order": 91}, {"id": 6000072091, "chapter_id": 10072, "verse_number": "४-८-६४", "content_sanskrit": "पीत्वाऽन्तरजरं वह्निश्चच्छर्द शरकानने।\nकुमारोऽभूत् ततस्तस्मै स्तनं षट् कृत्तिका ददुः॥ ४/८/६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.091.m4a", "display_order": 92}, {"id": 6000072092, "chapter_id": 10072, "verse_number": "४-८-६५", "content_sanskrit": "षड्भिर्मुखैः स्तनं पीत्वा स बालः षण्मुखोऽभवत्।\nततश्चक्रुः सैन्यपालं सर्वासुरभयंकरम्॥ ४/८/६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_008/BhP_04.008.092.m4a", "display_order": 93}, {"id": 6000072093, "chapter_id": 10072, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां चतुर्थस्कन्धे अष्टमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}]