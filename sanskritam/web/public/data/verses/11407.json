[{"id": 50008664, "chapter_id": 11407, "verse_number": "1", "content_sanskrit": "राजोवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50008665, "chapter_id": 11407, "verse_number": "2", "content_sanskrit": "महीं प्रतिष्ठामध्यास्य ऋषे स्वायम्भुवो मनुः। कान्यध्यतिष्ठद् द्वाराणि मार्गायावरजन्मनाम्॥ ३/२१/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50008666, "chapter_id": 11407, "verse_number": "3", "content_sanskrit": "क्षत्ता महाभागवतः कृष्णस्यैकान्तिकः सुहृत्। यस्तत्याजाग्रजं कृष्णे सापत्यमघवानिति॥ ३/२१/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50008667, "chapter_id": 11407, "verse_number": "4", "content_sanskrit": "द्वैपायनादनवमो महित्वे तस्य देहजः। सर्वात्मना श्रितः कृष्णं तत्परांश्चाप्यनुव्रतः॥ ३/२१/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50008668, "chapter_id": 11407, "verse_number": "5", "content_sanskrit": "किमन्वपृच्छन्मैत्रेयं विरजास्तीर्थसेवया। उपगम्य कुशावर्त आसीनं तत्त्ववित्तमम्॥ ३/२१/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50008669, "chapter_id": 11407, "verse_number": "6", "content_sanskrit": "तयोः संवदतोः सूत प्रवृत्ता ह्यमलाः कथाः। आपो गाङ्ग्य इवाघघ्न्यो हरेः पादाम्बुजाश्रयाः॥ ३/२१/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50008670, "chapter_id": 11407, "verse_number": "7", "content_sanskrit": "ता नः कार्तय भद्रं ते कार्तन्योदारकर्मणः। रसज्ञः को नु तृप्येत हरिलीलामृतं पिबन्॥ ३/२१/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50008671, "chapter_id": 11407, "verse_number": "8", "content_sanskrit": "सूत उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50008672, "chapter_id": 11407, "verse_number": "9", "content_sanskrit": "एवं परीक्षिता पृष्टो भगवान् बादरायणिः। भगवत्यर्पिताध्यात्मस्तमाह श्रूयतामिति॥ ३/२१/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50008673, "chapter_id": 11407, "verse_number": "10", "content_sanskrit": "श्रीशुक उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50008674, "chapter_id": 11407, "verse_number": "11", "content_sanskrit": "हरेर्धृतक्रोडतनोः स्वमायया निशम्य गोरुद्धरणं रसातळात्। मृधे हिरण्याक्षमवज्ञया हतं सञ्जातहर्षो मुनिमाह भारत॥ ३/२१/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50008675, "chapter_id": 11407, "verse_number": "12", "content_sanskrit": "विदुर उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50008676, "chapter_id": 11407, "verse_number": "13", "content_sanskrit": "प्रजापतिपतिः सृष्ट्वा प्रजासर्गे प्रजापतीन्। किमारभत मे ब्रह्मन् प्रब्रूह्यव्यक्तमार्गवित्॥ ३/२१/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50008677, "chapter_id": 11407, "verse_number": "14", "content_sanskrit": "ये मरीच्यादयो विप्रा यस्तु स्वायम्भुवो मनुः। ते वै ब्रह्मण आदेशात् कथमेतदभावयन्॥ ३/२१/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50008678, "chapter_id": 11407, "verse_number": "15", "content_sanskrit": "सद्वितीयाः किमसृजन् स्वतन्त्रा उत कर्मभिः। आहोस्वित् संहताः सर्व इदं स्म समकल्पयन्॥ ३/२१/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50008679, "chapter_id": 11407, "verse_number": "16", "content_sanskrit": "मैत्रेय उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50008680, "chapter_id": 11407, "verse_number": "17", "content_sanskrit": "दैवेन दुर्वितर्क्येण परेणानिमिषेण च। जातक्षोभाद् भगवतो महानासीद् गुणत्रयात्॥ ३/२१/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50008681, "chapter_id": 11407, "verse_number": "18", "content_sanskrit": "रजःप्रधानान्महतस्त्रिलिङ्गो दैवचोदितात्। जातः ससर्ज भूतादिर्वियदादीनि पञ्च च॥ ३/२१/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50008682, "chapter_id": 11407, "verse_number": "19", "content_sanskrit": "तानि चैकैकशः स्रष्टुमसमर्थानि भौतिकम्। संहत्य दैवयोगेन हैममण्डमवासृजन्॥ ३/२१/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50008683, "chapter_id": 11407, "verse_number": "20", "content_sanskrit": "सोऽशयिष्टाधिसलिल आण्डकोशो निरात्मकः। साग्रं वै वर्षसाहस्रमन्ववात्सीत् तमीश्वरः॥ ३/२१/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50008684, "chapter_id": 11407, "verse_number": "21", "content_sanskrit": "तस्य नाभेरभूत् पद्मं सहस्रार्कोरुदीधिति। सर्वजीवनिकायौको यत्र स्वयमभूत् स्वराट्॥ ३/२१/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50008685, "chapter_id": 11407, "verse_number": "22", "content_sanskrit": "सोऽनुविष्टो भगवता यः शेते सलिलाशये। लोकसंस्थां यथापूर्वं निर्ममे संस्थया स्वया॥ ३/२१/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50008686, "chapter_id": 11407, "verse_number": "23", "content_sanskrit": "ससर्ज च्छाययाऽविद्यां पञ्चपर्वाणमग्रतः। तामिस्रमन्धतामिस्रं तमो मोहो महातमः॥ ३/२१/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50008687, "chapter_id": 11407, "verse_number": "24", "content_sanskrit": "विससर्जात्मनः कायं नाभ्यनन्दत् तमोमयम्। जगृहुर्यक्षरक्षांसि रात्रिं क्षुत्तृट्समुद्भवाम्॥ ३/२१/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50008688, "chapter_id": 11407, "verse_number": "25", "content_sanskrit": "क्षुत्तृड्भ्यामुपसृष्टास्ते तं जग्धुमभिदुद्रुवुः। मा रक्षतैनं जक्षघ्वमित्युच्चैः क्षुत्तृडर्दिताः॥ ३/२१/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50008689, "chapter_id": 11407, "verse_number": "26", "content_sanskrit": "देवस्तानाह संविग्नो मा मा जक्षत रक्षत। अहो मे यक्षरक्षांसि प्रजा यूयं भविष्यथ॥ ३/२१/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50008690, "chapter_id": 11407, "verse_number": "27", "content_sanskrit": "देवताः प्रभया या या दिव्याः प्रमुखतोऽसृजत्। तेऽहार्षुर्देवयन्तो विसृष्टां तां प्रभामहः॥ ३/२१/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50008691, "chapter_id": 11407, "verse_number": "28", "content_sanskrit": "देवोऽदेवान् जघनतः सृजति स्मातिलोलुपान्। त एनं लोलुपतया मैथुनायाभिपेदिरे॥ ३/२१/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50008692, "chapter_id": 11407, "verse_number": "29", "content_sanskrit": "ततो हसन् स भगवानसुरैर्निरपत्रपैः। अन्वीयमानस्तरसा क्रुद्धो भीतः परापतत्॥ ३/२१/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50008693, "chapter_id": 11407, "verse_number": "30", "content_sanskrit": "स उपव्रज्य वरदं प्रपन्नार्तिहरं हरिम्। अनुग्रहाय भक्तानामनुरूपात्मदर्शनम्॥ ३/२१/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50008694, "chapter_id": 11407, "verse_number": "31", "content_sanskrit": "त्राहि मां परमात्मंस्ते प्रेषणेनासृजं प्रजाः। ता इमा यभितुं पापा उपक्रामन्ति मां प्रभो॥ ३/२१/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50008695, "chapter_id": 11407, "verse_number": "32", "content_sanskrit": "त्वमेकः किल लोकानां क्ल्ष्टानां क्लेशनाशनः। त्वमेकः क्लेशदस्तेषामनासन्नपदां तव॥ ३/२१/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50008696, "chapter_id": 11407, "verse_number": "33", "content_sanskrit": "सोऽवधार्यास्य कार्पण्यं विविक्ताध्यात्मदर्शनः। विमुञ्चात्मतनुं घोरामित्युक्तो विमुमोच ह॥ ३/२१/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50008697, "chapter_id": 11407, "verse_number": "34", "content_sanskrit": "तां क्वणच्चरणाम्भोजां मदविह्वललोचनाम्। काञ्चीकलापविलसद्दुकूलच्छन्नरोधसम्॥ ३/२१/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50008698, "chapter_id": 11407, "verse_number": "35", "content_sanskrit": "अन्योन्याश्लेषयोत्तुङ्गनिरन्तरपयोधराम्। सुनासां सुद्विजां स्निग्धहासलीलावलोकिनीम्॥ ३/२१/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50008699, "chapter_id": 11407, "verse_number": "36", "content_sanskrit": "गूहन्तीं व्रीळयाऽऽत्मानं नीलाळकवरूथिनीम्। उपलभ्यासुराः सन्ध्यां सर्वे तां मुमुहुः स्त्रियम्॥ ३/२१/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50008700, "chapter_id": 11407, "verse_number": "37", "content_sanskrit": "अहो रूपमहो स्थैर्यमहो अस्या नवं वयः। मध्ये कामयमानानामकामेव प्रसर्पति॥ ३/२१/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50008701, "chapter_id": 11407, "verse_number": "38", "content_sanskrit": "वितर्कयन्तो बहुधा तां सन्ध्यां प्रमदायतीम्। अभिसम्भाव्य विस्रम्भात् पर्यपृच्छन् कुमेधसः॥ ३/२१/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50008702, "chapter_id": 11407, "verse_number": "39", "content_sanskrit": "काऽसि कस्यासि रम्भोरु को वाऽर्थस्तेऽत्र भामिनि। रूपद्रविणपण्येन दुर्भगान् नो विबाधसे॥ ३/२१/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50008703, "chapter_id": 11407, "verse_number": "40", "content_sanskrit": "या वा काऽसि त्वमबले दिष्ट्या सन्दर्शनं तव। उद्धुनोषीक्षमाणानां कन्दुकक्रीडया मनः॥ ३/२१/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50008704, "chapter_id": 11407, "verse_number": "41", "content_sanskrit": "नैकत्र ते जयति शालिनि पादपद्मं घ्नन्त्या मुहुः करतळेन पतत्पतङ्गम्। मध्यं विषीदति बृहत्स्तनभारभीतं श्रान्ता च दृष्टिरमलः सुजटावरूथः॥ ३/२१/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50008705, "chapter_id": 11407, "verse_number": "42", "content_sanskrit": "इति सायन्तनीं सन्ध्यामसुराः प्रमदायतीम्। प्रलोभयन्तीं जगृहुर्मत्ता मूढधियः स्त्रियम्॥ ३/२१/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50008706, "chapter_id": 11407, "verse_number": "43", "content_sanskrit": "प्रहस्य भावगम्भीरं जिघ्रन्त्यात्मानमात्मना। कान्त्या ससर्ज भगवान् गन्धर्वाप्सरसां गणान्॥ ३/२१/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50008707, "chapter_id": 11407, "verse_number": "44", "content_sanskrit": "विससर्ज तनुं तां वै ज्योत्स्नां कान्तिमतीं प्रियाम्। त एनामाददुः प्रीत्या विश्वावसुपुरोगमाः॥ ३/२१/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 50008708, "chapter_id": 11407, "verse_number": "45", "content_sanskrit": "सृष्ट्वा भूतपिशाचांश्च भगवानात्मतन्द्रिणा। दिग्वाससो मुक्तकेशान् वीक्ष्य चामीलयद् दृशौ॥ ३/२१/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 50008709, "chapter_id": 11407, "verse_number": "46", "content_sanskrit": "जगृहुस्तद्विसृष्टां तां जृम्भणाख्यां तनुं प्रभोः। निद्रादीन्द्रियविक्लेदो यया भूतेषु दृश्यते। तयोच्छिष्टान् धर्षयान्त तदुन्मादं प्रचक्षते॥ ३/२१/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 50008710, "chapter_id": 11407, "verse_number": "47", "content_sanskrit": "ऊर्जस्वन्तं मन्यमान आत्मानं भगवानजः। साध्यान् गणान् पितृगणान् परोक्षेणासृजत् प्रभुः॥ ३/२१/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 50008711, "chapter_id": 11407, "verse_number": "48", "content_sanskrit": "त आत्मसर्गं तं कायं पितरः प्रतिपेदिरे। साध्येभ्यश्च पितृभ्यश्च कवयो यद् वितन्वते॥ ३/२१/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 50008712, "chapter_id": 11407, "verse_number": "49", "content_sanskrit": "सिद्धान् विद्याधरांश्चैव तिरोधानेन सोऽसृजत्। तेभ्यो ददौ तमात्मानमन्तर्धानाख्यमद्भुतम्॥ ३/२१/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 50008713, "chapter_id": 11407, "verse_number": "50", "content_sanskrit": "स किन्नरान् किम्पुरुषानात्मना चासृजत् प्रभुः। मानयन्नात्मनाऽऽत्मानमात्माभासं विलोकयन्॥ ३/२१/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 50008714, "chapter_id": 11407, "verse_number": "51", "content_sanskrit": "ते तु तज्जगृहू रूपं त्यक्तं यत् परमेष्ठिना। मिथुनीभूय गायन्तस्तमेवोषसि कर्मभिः॥ ३/२१/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 50008715, "chapter_id": 11407, "verse_number": "52", "content_sanskrit": "देहेन वै भोगवता शयानो बहुचिन्तया। सर्गेऽनुपचिते क्रोधादुत्ससर्ज हि तद् वपुः॥ ३/२१/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 50008716, "chapter_id": 11407, "verse_number": "53", "content_sanskrit": "येऽहीयन्तामुतः केशा अहयस्तेऽङ्ग जज्ञिरे। सर्पा विसर्पतः क्रूरा नागा भोगोरुकन्धराः॥ ३/२१/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 50008717, "chapter_id": 11407, "verse_number": "54", "content_sanskrit": "स आत्मानं मन्यमानः कृतकृत्यमिवात्मभूः। तदा मनून् ससर्जान्ते मनसा लोकभावनान्॥ ३/२१/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 50008718, "chapter_id": 11407, "verse_number": "55", "content_sanskrit": "तेभ्यः स व्यसृजद् देहं परः पुरुष आत्मनः। तान् दृष्ट्वा ये पुरा सृष्टाः प्रशशंसुः प्रजापतिम्॥ ३/२१/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 50008719, "chapter_id": 11407, "verse_number": "56", "content_sanskrit": "अहो एतज्जगत्स्रष्टः सुकृतं बत ते कृतम्। प्रतिष्ठिताः क्रिया यस्मिन् साकमन्नमदामहे॥ ३/२१/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 50008720, "chapter_id": 11407, "verse_number": "57", "content_sanskrit": "तपसा विद्यया युक्तो योगेन सुसमाधिना। आदावृषीन् हृषीकेशः ससर्जाभिमताः प्रजाः॥ ३/२१/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 50008721, "chapter_id": 11407, "verse_number": "58", "content_sanskrit": "तेभ्यश्चैकैकशस्तस्य देहस्यांशमदादजः। यत् तत् समाधियोगर्धितपोविद्याविरक्तिमत्॥ ३/२१/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 50008722, "chapter_id": 11407, "verse_number": "59", "content_sanskrit": "॥ इति श्रीमद्भागवते तृतीयस्कन्धे एकविंशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]