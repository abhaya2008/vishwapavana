[{"id": 5000454000, "chapter_id": 9454, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे सप्तचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000454001, "chapter_id": 9454, "verse_number": "६-४७-१", "content_sanskrit": "तस्मिन् प्रविष्टे लङ्कायां कृतार्थे रावणात्मजे।\nराघवं परिवार्याथ ररक्षुर्वानरर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000454002, "chapter_id": 9454, "verse_number": "६-४७-२", "content_sanskrit": "हनुमानङ्गदो नीलः सुषेणः कुमुदो नलः।\nगजो गवाक्षो गवयः शरभो गन्धमादनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000454003, "chapter_id": 9454, "verse_number": "६-४७-३", "content_sanskrit": "जाम्बवानृषभः स्कन्धो रम्भः शतबलिः पृथुः।\nव्यूढानीकाश्च यत्ताश्च द्रुमानादाय सर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000454004, "chapter_id": 9454, "verse_number": "६-४७-४", "content_sanskrit": "वीक्षमाणा दिशः सर्वास्तिर्यगूर्ध्वं च वानराः।\nतृणेष्वपि च चेष्टत्सु राक्षसा इति मेनिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000454005, "chapter_id": 9454, "verse_number": "६-४७-५", "content_sanskrit": "रावणश्चापि संहृष्टो विसृज्येन्द्रजितं सुतम्।\nआजुहाव ततः सीतारक्षणी राक्षसीस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000454006, "chapter_id": 9454, "verse_number": "६-४७-६", "content_sanskrit": "राक्षस्यस्त्रिजटा चापि शासनात् तमुपस्थिताः।\nता उवाच ततो हृष्टो राक्षसी राक्षसाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000454007, "chapter_id": 9454, "verse_number": "६-४७-७", "content_sanskrit": "हताविन्द्रजिताख्यात वैदेह्या रामलक्ष्मणौ।\nपुष्पकं तत्समारोप्य दर्शयध्वं रणे हतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000454008, "chapter_id": 9454, "verse_number": "६-४७-८", "content_sanskrit": "यदाश्रयादवष्टब्धा नेयं मामुपतिष्ठते।\nसोऽस्या भर्ता सह भ्रात्रा निहतो रणमूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000454009, "chapter_id": 9454, "verse_number": "६-४७-९", "content_sanskrit": "निर्विशङ्का निरुद्विग्ना निरपेक्षा च मैथिली।\nमामुपस्थास्यते सीता सर्वाभरणभूषिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000454010, "chapter_id": 9454, "verse_number": "६-४७-१०", "content_sanskrit": "अद्य कालवशं प्राप्तं रणे रामं सलक्ष्मणम्।\nअवेक्ष्य विनिवृत्ता सा चान्यां गतिमपश्यती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000454011, "chapter_id": 9454, "verse_number": "६-४७-११", "content_sanskrit": "अनपेक्षा विशालाक्षी मामुपस्थास्यते स्वयम्।\nतस्य तद् वचनं श्रुत्वा रावणस्य दुरात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000454012, "chapter_id": 9454, "verse_number": "६-४७-१२", "content_sanskrit": "राक्षस्यस्तास्तथेत्युक्त्वा जग्मुर्वै यत्र पुष्पकम्।\nततः पुष्पकमादाय राक्षस्यो रावणाज्ञया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000454013, "chapter_id": 9454, "verse_number": "६-४७-१३", "content_sanskrit": "अशोकवनिकास्थां तां मैथिलीं समुपानयन्।\nतामादाय तु राक्षस्यो भर्तृशोकपराजिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000454014, "chapter_id": 9454, "verse_number": "६-४७-१४", "content_sanskrit": "सीतामारोपयामासुर्विमानं पुष्पकं तदा।\nततः पुष्पकमारोप्य सीतां त्रिजटया सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000454015, "chapter_id": 9454, "verse_number": "६-४७-१५", "content_sanskrit": "जग्मुर्दर्शयितुं तस्यै राक्षस्यो रामलक्ष्मणौ।\nरावणश्चारयामास पताकाध्वजमालिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000454016, "chapter_id": 9454, "verse_number": "६-४७-१६", "content_sanskrit": "प्राघोषयत हृष्टश्च लङ्कायां राक्षसेश्वरः।\nराघवो लक्ष्मणश्चैव हताविन्द्रजिता रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000454017, "chapter_id": 9454, "verse_number": "६-४७-१७", "content_sanskrit": "विमानेनापि गत्वा तु सीता त्रिजटया सह।\nददर्श वानराणां तु सर्वं सैन्यं निपातितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000454018, "chapter_id": 9454, "verse_number": "६-४७-१८", "content_sanskrit": "प्रहृष्टमनसश्चापि ददर्श पिशिताशनान्।\nवानरांश्चातिदुःखार्तान् रामलक्ष्मणपार्श्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000454019, "chapter_id": 9454, "verse_number": "६-४७-१९", "content_sanskrit": "ततः सीता ददर्शोभौ शयानौ शरतल्पगौ।\nलक्ष्मणं चैव रामं च विसंज्ञौ शरपीडितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000454020, "chapter_id": 9454, "verse_number": "६-४७-२०", "content_sanskrit": "विध्वस्तकवचौ वीरौ विप्रविद्धशरासनौ।\nसायकैश्छिन्नसर्वाङ्गौ शरस्तम्बमयौ क्षितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000454021, "chapter_id": 9454, "verse_number": "६-४७-२१", "content_sanskrit": "तौ दृष्ट्वा भ्रातरौ तत्र प्रवीरौ पुरुषर्षभौ।\nशयानौ पुण्डरीकाक्षौ कुमाराविव पावकी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000454022, "chapter_id": 9454, "verse_number": "६-४७-२२", "content_sanskrit": "शरतल्पगतौ वीरौ तथाभूतौ नरर्षभौ।\nदुःखार्ता करुणं सीता सुभृशं विललाप ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000454023, "chapter_id": 9454, "verse_number": "६-४७-२३", "content_sanskrit": "भर्तारमनवद्याङ्गी लक्ष्मणं चासितेक्षणा।\nप्रेक्ष्य पांसुषु चेष्टन्तौ रुरोद जनकात्मजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000454024, "chapter_id": 9454, "verse_number": "६-४७-२४", "content_sanskrit": "सबाष्पशोकाभिहता समीक्ष्य\nतौ भ्रातरौ देवसुतप्रभावौ।\nवितर्कयन्ती निधनं तयोः सा\nदुःखान्विता वाक्यमिदं जगाद ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000454025, "chapter_id": 9454, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे सप्तचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]