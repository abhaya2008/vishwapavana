[{"id": 7006234000, "chapter_id": 26234, "verse_number": "२-६२-१", "content_sanskrit": "पूर्वाचार्यमतं बुद्ध्वा प्रवक्ष्याम्यनुपूर्वशः ।\nविख्यातान्वै अलङ्कारांस्तन्मे निगदतः श्रुणु ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006234001, "chapter_id": 26234, "verse_number": "२-६२-२", "content_sanskrit": "अलङ्कारास्तु वक्तव्याः स्वैः स्वैर्वर्णैः प्रहेतवः ।\nसंस्था नयोगैश्च तथा सदा नाढ्याद्यवेक्षया ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006234002, "chapter_id": 26234, "verse_number": "२-६२-३", "content_sanskrit": "वाक्यार्थपदयोगार्थैरलङ्कारैश्च पूरणम् ।\nपदानि गीतकस्याहुः पुरस्तात्पृष्ठतोऽथ वा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006234003, "chapter_id": 26234, "verse_number": "२-६२-४", "content_sanskrit": "स्थातोनित्रीनरो नीड्डीमनःकण्ठशिरस्थया ।\nएतेषु त्रिषु स्थानेषु प्रवृत्तो विधिरुत्तमः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006234004, "chapter_id": 26234, "verse_number": "२-६२-५", "content_sanskrit": "चत्त्वारः प्रकृतौ वर्णाः प्रविचारस्य नुर्विधा ।\nविकल्पमष्टधा चैव देवाः षोडशधा विदुः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006234005, "chapter_id": 26234, "verse_number": "२-६२-६", "content_sanskrit": "सृष्टो वर्मः प्रसंचारी तृतीयमवरोहणम् ।\nआरोहणं चतुर्थं तु वर्णं वर्मविदो विदुः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006234006, "chapter_id": 26234, "verse_number": "२-६२-७", "content_sanskrit": "तत्रैकः संचरस्थायी संचरस्तु चरोऽभवत् ।\nअवरोहणवर्णानामवरोहं विनिर्दिशेत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006234007, "chapter_id": 26234, "verse_number": "२-६२-८", "content_sanskrit": "आरोहणेन वारोहान्वर्णान्वर्णविदो विदुः ।\nएतेषामेव वर्णानामलङ्कारन्निबोधत ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006234008, "chapter_id": 26234, "verse_number": "२-६२-९", "content_sanskrit": "अलङ्कारास्तु चत्वारस्थापनी क्रमरेजनः ।\nप्रमादस्याप्रमादश्च तेषां वक्ष्यामि लक्षणम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006234009, "chapter_id": 26234, "verse_number": "२-६२-१०", "content_sanskrit": "विस्वरोऽष्टकलाश्चैव स्थानं द्व्येकतरागतः ।\nआवर्त्तस्याक्रमो त्वाक्षी वेकार्यां परिमाणतः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006234010, "chapter_id": 26234, "verse_number": "२-६२-११", "content_sanskrit": "कुमारं संपरं विद्धि द्विस्तरं वामनं गतः ।\nएष वै एष चैवस्यकुतरेकः कुलाधिकः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006234011, "chapter_id": 26234, "verse_number": "२-६२-१२", "content_sanskrit": "स्वेत स्वे कातरे जातकलामग्नितरैषितः ।\nतस्मिंश्चैव स्वरे वृद्धिर्निष्टप्ते तद्विचक्षणः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006234012, "chapter_id": 26234, "verse_number": "२-६२-१३", "content_sanskrit": "स्येनस्तु अपरो हस्त उत्तरः कमलाकलः ।\nप्रमाणघसबिन्दुर्ना जायते विदुरे पुनः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006234013, "chapter_id": 26234, "verse_number": "२-६२-१४", "content_sanskrit": "कला कार्या तु वर्णानां तदा नुः स्थापितो भवेत् ।\nविपर्ययस्य रोपिस्या द्यस्य प्रादुर्घटी मम ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006234014, "chapter_id": 26234, "verse_number": "२-६२-१५", "content_sanskrit": "एकोत्तरः स्वरस्तु स्यात्षड्जतः परमः स्वरः ।\nअक्षेपस्कन्दनाकार्यं काकस्योयचपुष्कलम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006234015, "chapter_id": 26234, "verse_number": "२-६२-१६", "content_sanskrit": "संतारौ तौनुसर्वाय्यौ कार्यं वा कारणं तथा ।\nआक्षिप्तमवरोह्यासीत्प्रोक्षमद्यस्तथैव च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006234016, "chapter_id": 26234, "verse_number": "२-६२-१७", "content_sanskrit": "द्वादशे च कलास्थानामेकान्तरगतस्तथा ।\nप्रेशोल्लिखितमलङ्कारमेवस्वरसमन्विता ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006234017, "chapter_id": 26234, "verse_number": "२-६२-१८", "content_sanskrit": "स्वरस्वरबहुग्रामकाप्रयोष्टनुपत्कला ।\nप्रक्षिप्तमेव कलयाचोपादानारयो भवेत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006234018, "chapter_id": 26234, "verse_number": "२-६२-१९", "content_sanskrit": "द्विकथंवावथाभूतयत्रभाषितमुच्यते ।\nउच्चराद्विश्वरारूढातथायाष्टस्वरातथा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006234019, "chapter_id": 26234, "verse_number": "२-६२-२०", "content_sanskrit": "वापः स्यादवरोहेण नारतो भवति ध्रुवम् ।\nएकान्तरं च ह्येतेवैतमेवस्वरसत्तमः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006234020, "chapter_id": 26234, "verse_number": "२-६२-२१", "content_sanskrit": "सक्षिप्रच्छेदनामाचचतुष्कलगणः स्मृतः ।\nअलङ्कारा भवन्त्येते त्रिंशद्देवैः प्रकीर्त्तिताः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006234021, "chapter_id": 26234, "verse_number": "२-६२-२२", "content_sanskrit": "वर्णास्थानप्रयोगेण कलामात्राप्रमाणतः ।\nसंस्थानं च प्रमाणं च विकारो लक्षणस्तथा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006234022, "chapter_id": 26234, "verse_number": "२-६२-२३", "content_sanskrit": "चतुर्विधमिदं ज्ञेय मलङ्कारप्रयोजनम् ।\nयथात्मनो ह्यलङ्कारो विपयस्तो विगर्हितः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006234023, "chapter_id": 26234, "verse_number": "२-६२-२४", "content_sanskrit": "वर्ममेवाप्यलङ्कर्त्तुं विषमाह्यात्मसंभवाः ।\nनानाभरणसंयोगा यथा नार्या विभूषणम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006234024, "chapter_id": 26234, "verse_number": "२-६२-२५", "content_sanskrit": "वर्मस्य चैवालङ्कारो विभूषा ह्यात्मसंभवः ।\nन पादे कुण्डलं दृष्टं न कण्ठे रसना तथा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006234025, "chapter_id": 26234, "verse_number": "२-६२-२६", "content_sanskrit": "एवमेवाद्यलङ्कारे विपर्यस्तो विगर्हितः ।\nक्रियमाणोऽप्यलङ्कारो नागं यश्चैव दर्शयत् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006234026, "chapter_id": 26234, "verse_number": "२-६२-२७", "content_sanskrit": "यथादृष्टस्य मार्गस्यकर्त्तव्यस्यविधीयते ।\nलक्षणंपर्यवस्यापिवर्त्तिका मपिवर्त्तते ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006234027, "chapter_id": 26234, "verse_number": "२-६२-२८", "content_sanskrit": "याथातथ्येन वक्ष्यामि मासोद्भवमुखोद्भव ।\nत्रयोविंशतिशीतिस्तु विज्ञातपवदैवतम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006234028, "chapter_id": 26234, "verse_number": "२-६२-२९", "content_sanskrit": "नगोनातुपुरस्तानुमध्यमांशस्तु पर्ययः ।\nतयोर्विभागो देवानां लावण्ये मार्गसंस्थितः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006234029, "chapter_id": 26234, "verse_number": "२-६२-३०", "content_sanskrit": "अनुषङ्गमयो दृष्टं स्वसारं वस्वरातर ।\nविपर्ययः संवर्त्तो च सप्तस्वरपदक्रमम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006234030, "chapter_id": 26234, "verse_number": "२-६२-३१", "content_sanskrit": "गान्धारसेतुगीयन्ते वरोमद्भगवानिच ।\nपञ्चमंमध्यमञ्चैवधैवतं तु निषादतः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006234031, "chapter_id": 26234, "verse_number": "२-६२-३२", "content_sanskrit": "षड्जर्षभश्चजानीमोमद्रकेष्वेवनान्तरे ।\nद्वेव्द्यपरतुकिंविद्याद्द्वयमुष्णन्तिकस्यतु ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006234032, "chapter_id": 26234, "verse_number": "२-६२-३३", "content_sanskrit": "प्राकृते वैकृते चैव गान्धारः स प्रयुज्यते ।\nपदस्यात्ययरूपन्तुसप्तरूपन्तुकौशिकीम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006234033, "chapter_id": 26234, "verse_number": "२-६२-३४", "content_sanskrit": "गान्धारस्येनकार्त्स्येन चायं यस्यविधिः स्मृतः ।\nएषचैवक्रमोद्दिष्टोमध्यमांशस्य मध्यमः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006234034, "chapter_id": 26234, "verse_number": "२-६२-३५", "content_sanskrit": "यानि प्रोक्तानि गीतानिवतुरूपं विशेषतः ।\nततः सप्तस्वरङ्कार्यंसप्तरूपञ्चकौशिकी ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006234035, "chapter_id": 26234, "verse_number": "२-६२-३६", "content_sanskrit": "अगदर्शनमित्याहुर्मानुद्वैममकेतथा ।\nद्वितीयामासमात्राणाभिः सर्वाः प्रतिष्ठिताः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006234036, "chapter_id": 26234, "verse_number": "२-६२-३७", "content_sanskrit": "उत्तरेवप्रकृत्येवंमाताब्राह्मतलायत ।\nतथाहतानोपिडकेयत्रमायांनिवर्त्तते ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006234037, "chapter_id": 26234, "verse_number": "२-६२-३८", "content_sanskrit": "पादेनैकेनमायात्रा पादोनामतिवारिमः ।\nसंख्यापनोपहूतांवैतत्रपानमिति स्मृतम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006234038, "chapter_id": 26234, "verse_number": "२-६२-३९", "content_sanskrit": "द्वितीयपादभङ्गञ्चग्रहेनामप्रतिष्ठितम् ।\nपूर्वमष्ठतीटती नद्वितीयं चापरान्तिकैः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006234039, "chapter_id": 26234, "verse_number": "२-६२-४०", "content_sanskrit": "पादभागसपादं तु प्रकृत्यमपि संस्थितम् ।\nचतुर्थमुत्तरं चैवमद्रवत्पावमद्रकौ ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006234040, "chapter_id": 26234, "verse_number": "२-६२-४१", "content_sanskrit": "मद्रकोदक्षिणस्यापि यथोक्ता वर्त्तते कला ।\nसर्वमेवानुयोगं तु द्वितीयं बुद्धिमिष्यते ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006234041, "chapter_id": 26234, "verse_number": "२-६२-४२", "content_sanskrit": "पादौवाहरणं चास्यात्पारं नात्र विधीयते ।\nएकत्वं मुनुयोगस्य द्वयोर्यद्यद्द्विजोत्तम ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006234042, "chapter_id": 26234, "verse_number": "२-६२-४३", "content_sanskrit": "अनेकसमवायस्तु पातका हरिणा स्मृताः ।\nतिसृणां चैव वृत्तीनां वृत्तौ वृत्ते च दक्षिणः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006234043, "chapter_id": 26234, "verse_number": "२-६२-४४", "content_sanskrit": "अष्टौ तु समवायस्तु वीरा संमूर्छना तथा ।\nकस्यनासुतराचैव स्वरशाखा प्रकीर्त्तिता ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]