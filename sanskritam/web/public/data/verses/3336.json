[{"id": 2108064, "chapter_id": 3336, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2108065, "chapter_id": 3336, "verse_number": "१", "content_sanskrit": "एतस्मिन्नेव काले तु भगिन्यौ ते तपोधन ।\nअपश्यतां समायान्तं उच्चैःश्रवसमन्तिकात् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2108066, "chapter_id": 3336, "verse_number": "२", "content_sanskrit": "यं तु देवगणाः सर्वे हृष्टरूपा ह्यपूजयन् ।\nमथ्यमानेऽमृते जातमश्वरत्नमनुत्तमम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2108067, "chapter_id": 3336, "verse_number": "३", "content_sanskrit": "अमोघबलमश्वानामुत्तमं जववतां वरम् ।\nश्रीमन्तमजरं दिव्यं सर्वलक्षणलक्षितम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2108068, "chapter_id": 3336, "verse_number": "", "content_sanskrit": "शौनकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2108069, "chapter_id": 3336, "verse_number": "४", "content_sanskrit": "कथं तदमृतं देवैर्मथितं क्व च शंस मे ।\nयत्र जज्ञे महावीर्यः सोऽश्वराजो महाद्युतिः\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2108070, "chapter_id": 3336, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2108071, "chapter_id": 3336, "verse_number": "५", "content_sanskrit": "ज्वलन्तमचलं मेरुं तेजोराशिमनुत्तमम् ।\nआक्षिपन्तं प्रभां भानोः स्वशृङ्गैः काञ्चनोज्ज्वलैः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2108072, "chapter_id": 3336, "verse_number": "६", "content_sanskrit": "काञ्चनाभरणं दिव्यं देवगन्धर्वसेवितम् ।\nअप्रमेयमनाधृष्यमधर्मबहुलैर्जनैः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2108073, "chapter_id": 3336, "verse_number": "७", "content_sanskrit": "व्यालैराचरितं घोरैर्दिव्यौषधविदीपितम् ।\nनाकमावृत्य तिष्ठन्तमुच्छ्रायेण महागिरिम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2108074, "chapter_id": 3336, "verse_number": "८", "content_sanskrit": "अगम्यं मनसाप्यन्यैर्नदीवृक्षगणान्वितम् ।\nनानापतङ्गसङ्घैश्च नादितं सुमनोहरैः\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2108075, "chapter_id": 3336, "verse_number": "९", "content_sanskrit": "तस्य पृष्ठं समारुह्य बहुरत्नाचितं द्युमत् ।\nअनन्तकल्पमद्वन्द्वं सुराः सर्वे महौजसः\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2108076, "chapter_id": 3336, "verse_number": "१०", "content_sanskrit": "ते मन्त्रयितुमारब्धास्तत्रासीना दिवौकसः ।\nअमृतार्थं समागम्य सर्वे चन्द्रपुरोगमाः\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2108077, "chapter_id": 3336, "verse_number": "११", "content_sanskrit": "तत्र नारायणो देवो ब्रह्माणमिदमब्रवीत् ।\nचिन्तयत्सु सुरेष्वेवं मन्त्रयत्सु च सर्वशः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2108078, "chapter_id": 3336, "verse_number": "१२", "content_sanskrit": "देवैरसुरसङ्घैश्च मथ्यतां कलशोदधिः ।\nभविष्यत्यमृतं तत्र मथ्यमाने महोदधौ \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2108079, "chapter_id": 3336, "verse_number": "१३", "content_sanskrit": "सर्वौषधीः समावाप्य सर्वरत्नानि चैव हि ।\nमन्थध्वमुदधिं देवा लप्स्यध्वममृतं ततः\t ॥ १३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2108080, "chapter_id": 3336, "verse_number": "१५", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि पञ्चदशोऽध्यायः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2108081, "chapter_id": 3336, "verse_number": "३", "content_sanskrit": "॥ आस्तीकपर्वणि तृतीयोऽध्यायः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]