[{"id": 7005880000, "chapter_id": 25880, "verse_number": "१-६३-१", "content_sanskrit": "॥हरिरुवाच ।\nनरस्त्रीलक्षणं वक्ष्ये संक्षपाच्छृण शङ्कर।\nअस्वेदिनौ मृदुतलौ कमलोदरसन्निभौ ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005880001, "chapter_id": 25880, "verse_number": "१-६३-२", "content_sanskrit": "श्लिष्टाङ्गुली ताम्रनखौ सुगुल्फौ शिरयोज्झितौ ।\nकूर्मोन्नतौ च चरणौ स्यातां नृपवरस्य हि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005880002, "chapter_id": 25880, "verse_number": "१-६३-३", "content_sanskrit": "विरूक्षपाण्डुरनखौ वक्रौ चैव शिरानतौ ।\nसूर्पाकारौ च चरणौ संशुष्कौ विरलाङ्गुली ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005880003, "chapter_id": 25880, "verse_number": "१-६३-४", "content_sanskrit": "दुः खदारिद्यदौ स्याता नात्र कार्य्यां विचारण।\nअल्परोमयुता श्रेष्ठा जङ्घा हस्तिकरोपमा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005880004, "chapter_id": 25880, "verse_number": "१-६३-५", "content_sanskrit": "रोमैकैकं कूपके स्याद्भूपानां तु महात्मनाम् ।\nद्वेद्वे रोम्णी पण्डितानां श्रोत्रियाणां तथैव च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005880005, "chapter_id": 25880, "verse_number": "१-६३-६", "content_sanskrit": "रोमत्रयं दरिद्राणां रोगी निर्मांसजानुकः ।\nअल्पलिङ्गी च धनवान्स्याच्च पुत्रादिवर्जितः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005880006, "chapter_id": 25880, "verse_number": "१-६३-७", "content_sanskrit": "स्थूललिङ्गो दरिद्रः स्यादुख्येकवृष्णी भवेत् ।\nविषमेस्त्रीचञ्चलो वै नृपः स्याद्वृषणे समे ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005880007, "chapter_id": 25880, "verse_number": "१-६३-८", "content_sanskrit": "प्रलम्बवृषणोऽल्पायुर्निर्द्रव्यः कुमणिर्वेत्।\nपाण्डुरैर्मलिनैश्चैव मणिभिश्च सुखी नरः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005880008, "chapter_id": 25880, "verse_number": "१-६३-९", "content_sanskrit": "निः स्वाः सशब्दमूत्राः स्युर्नृपा निश्शब्दधारय।\nभोगाढ्याः समजठरा निः स्वाः स्युर्घटसन्निभाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005880009, "chapter_id": 25880, "verse_number": "१-६३-१०", "content_sanskrit": "सर्पोदरा दरिद्राः स्यू रेखाभिस्चायुरुच्यते ।\nललाटे यस्य दृश्यन्ते तिस्त्रो रेखाः समाहिताः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005880010, "chapter_id": 25880, "verse_number": "१-६३-११", "content_sanskrit": "सुखी पुत्रसमायुक्तः स षष्टिं जीवते नरः ।\nचत्वारिंशच्च वर्षाणि द्विरेखादर्शनान्नरः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005880011, "chapter_id": 25880, "verse_number": "१-६३-१२", "content_sanskrit": "विंशत्यब्दं त्वेकरेखा आकर्णान्ताः शतायुषः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005880012, "chapter_id": 25880, "verse_number": "१-६३-१३", "content_sanskrit": "सप्तत्यायुर्द्विरेखा तु षष्ट्यायुस्तिसृभिर्भवेत।\nव्यक्ताव्यक्ताभी रेखाभिर्विंशत्यायुर्भवेन्नरः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005880013, "chapter_id": 25880, "verse_number": "१-६३-१४", "content_sanskrit": "चत्वारिंशच्च वर्षाणि हीनरेखस्तु जीवति ।\nभिन्नाभिश्चैव रेखाभिरपमृत्युर्नरस्य हि ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005880014, "chapter_id": 25880, "verse_number": "१-६३-१५", "content_sanskrit": "त्रिशूलं पट्टिशं वापि ललाटे यस्य दृश्यते ।\nधनपुत्र समायुक्तः स जीवेच्छरदः शतम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005880015, "chapter_id": 25880, "verse_number": "१-६३-१६", "content_sanskrit": "तर्जन्या मध्यमाङ्गुल्या आयूरेखा तु मध्यतः ।\nसंप्राप्ता या भवेद्रुद्र ! स जीवेच्छरदः शतम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005880016, "chapter_id": 25880, "verse_number": "१-६३-१७", "content_sanskrit": "प्रथमा ज्ञानरेखा तु ह्यंगुष्ठादनुवर्त्त।\nमध्यमामूलगा रेखा आयूरेखा अतः परम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005880017, "chapter_id": 25880, "verse_number": "१-६३-१८", "content_sanskrit": "कनिष्ठिकां समाश्रित्य आयूरेखा समाविशेत् ।\nअच्छिन्ना वा विभक्ता वा स जीवेच्छरदः शतम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005880018, "chapter_id": 25880, "verse_number": "१-६३-१९", "content_sanskrit": "यस्य पाणितले रेखा आयुस्तस्य प्रकाशयेत् ।\nशतवर्षाणि जीवेच्च भोगी रुद्र ! न संशयः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005880019, "chapter_id": 25880, "verse_number": "१-६३-२०", "content_sanskrit": "कनिष्ठिकां समाश्रित्य मध्यमायामुपागता ।\nषष्ठिवर्षायुषं कुर्य्यादायूरेखा तु मानवम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]