[{"id": 2000971, "chapter_id": 1005, "verse_number": "१-६-०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2000972, "chapter_id": 1005, "verse_number": "१-६-१", "content_sanskrit": "अग्नेरथ वचः श्रुत्वा तद्रक्षः प्रजहार ताम्।\nब्रह्मन्वराहरूपेण मनोमारुतरंहसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2000973, "chapter_id": 1005, "verse_number": "१-६-२", "content_sanskrit": "ततः स गर्भो निवसन्कुक्षौ भृगुकुलोद्वह।\nरोषान्मातुश्च्युतः कुक्षेश्च्यवनस्तेन सोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2000974, "chapter_id": 1005, "verse_number": "१-६-३", "content_sanskrit": "तं दृष्ट्वा मातुरुदराच्च्युतमादित्यवर्चसम्।\nतद्रक्षो भस्मसाद्भूतं पपात परिमुच्य ताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2000975, "chapter_id": 1005, "verse_number": "१-६-४", "content_sanskrit": "सा तमादाय सुश्रोणी ससार भृगुनन्दनम्।\nच्यवनं भार्गवं पुत्रं पुलोमा दुःखमूर्च्छिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2000976, "chapter_id": 1005, "verse_number": "१-६-५", "content_sanskrit": "तां ददर्श स्वयं ब्रह्मा सर्वलोकपितामहः।\nरुदतीं बाष्पपूर्णाक्षीं भृगोर्भार्यामनिन्दिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2000977, "chapter_id": 1005, "verse_number": "१-६-६", "content_sanskrit": "सान्त्वयामास भगवान्वधूं ब्रह्मा पितामहः।\nअश्रुबिन्दूद्भवा तस्याः प्रावर्तत महानदी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2000978, "chapter_id": 1005, "verse_number": "१-६-७", "content_sanskrit": "आवर्तन्ती सृतिं तस्या भृगोः पत्न्यास्तपस्विनः।\nतस्या मार्गं सृतवतीं दृष्ट्वा तु सरितं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2000979, "chapter_id": 1005, "verse_number": "१-६-८", "content_sanskrit": "नाम तस्यास्तदा नद्याश्चक्रे लोकपितामहः।\nवधूसरेति भगवांश्च्यवनस्याश्रमं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2000980, "chapter_id": 1005, "verse_number": "१-६-९", "content_sanskrit": "स एवं च्यवनो जज्ञे भृगोः पुत्रः प्रतापवान्।\nतं ददर्श पिता तत्र च्यवनं तां च भामिनीम्।\nस पुलोमां ततो भार्यां पप्रच्छ कुपितो भृगुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2000981, "chapter_id": 1005, "verse_number": "१-६-१०x", "content_sanskrit": "भृगुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2000982, "chapter_id": 1005, "verse_number": "१-६-१०", "content_sanskrit": "केनासि रक्षसे तस्मै कथिता त्वं जिहीर्षवे।\nन हि त्वा वेद तद्रक्षो मद्भार्यां चारुहासिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2000983, "chapter_id": 1005, "verse_number": "१-६-११", "content_sanskrit": "तत्त्वमाख्याहि तं ह्यद्य शप्तुमिच्छाम्यहं रुषा।\nबिभेति को न शापान्मे कस्य चायं व्यतिक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2000984, "chapter_id": 1005, "verse_number": "१-६-१२x", "content_sanskrit": "पुलोमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2000985, "chapter_id": 1005, "verse_number": "१-६-१२", "content_sanskrit": "अग्निना भगवंस्तस्मै रक्षसेऽहं निवेदिता।\nततो मामनयद्रक्षः क्रोशन्तीं कुररीमिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2000986, "chapter_id": 1005, "verse_number": "१-६-१३", "content_sanskrit": "साऽहं तव सुतस्यास्य तेजसा परिमोक्षिता।\nभस्मीभूतं च तद्रक्षो मामुत्सृज्य पपात वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2000987, "chapter_id": 1005, "verse_number": "१-६-१४x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2000988, "chapter_id": 1005, "verse_number": "१-६-१४", "content_sanskrit": "इति श्रुत्वा पुलोमाया भृगुः परममन्युमान्।\nशशापाग्निमतिक्रुद्धः सर्वभक्षो भविष्यसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2000989, "chapter_id": 1005, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि पौलोमपर्वणि षष्ठोऽध्यायः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]