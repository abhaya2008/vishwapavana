[{"id": 2097374, "chapter_id": 3086, "verse_number": "१३-२१६-१", "content_sanskrit": "महेश्वर उवाच।\nपशवः पशुबन्धेषु ये हन्यन्तेऽध्वरेषु च।\nयूपे निबध्य मन्त्रैश्च यथान्यायं यथाविधि।\nमन्त्राहुतिविपूतास्ते स्वर्गं यान्ति यशस्विनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2097375, "chapter_id": 3086, "verse_number": "१३-२१६-२", "content_sanskrit": "तर्पिता यज्ञभागेषु तेषां मांसैर्वरानने।\nअग्नयस्त्रिदशाश्चैव लोकपाला महेश्वराः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2097376, "chapter_id": 3086, "verse_number": "१३-२१६-३", "content_sanskrit": "तेषु तुष्टेषु जायेत यस्य यज्ञस्य यत्फलम्।\nतेन संयुज्यते देवि यजमानो न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2097377, "chapter_id": 3086, "verse_number": "१३-२१६-४", "content_sanskrit": "सपत्नीकः सपुत्रश्चि पित्रा च भ्रातृभिः सह।\nये तत्र दीक्षिता देवि सर्वे स्वर्गं प्रयान्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2097378, "chapter_id": 3086, "verse_number": "१३-२१६-५", "content_sanskrit": "एतत्ते सर्वमाख्यातं किं भूयः श्रोतुमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2097379, "chapter_id": 3086, "verse_number": "१३-२१६-६x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2097380, "chapter_id": 3086, "verse_number": "१३-२१६-६", "content_sanskrit": "भगवन्सर्वभूतेश शूलपाणे महाद्युते।\nश्रोतुमिच्छाम्यहं वृत्तं सर्वेषां गृहमेधिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2097381, "chapter_id": 3086, "verse_number": "१३-२१६-७", "content_sanskrit": "कीदृशं चरितं तेषां त्रिवर्गसहितं प्रभो।\nप्रत्यायतिः कथं तेषां जीवनार्थमुदाहृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2097382, "chapter_id": 3086, "verse_number": "१३-२१६-८", "content_sanskrit": "वर्तमानाः कथं सर्वे प्राप्नुवन्त्युत्तमां गतिम्।\nएतत्सर्वं समासेन वक्तुमर्हसि मानदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2097383, "chapter_id": 3086, "verse_number": "१३-२१६-९x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2097384, "chapter_id": 3086, "verse_number": "१३-२१६-९", "content_sanskrit": "न्यायतस्त्वं महाभागे श्रोतुकामाऽसि भामिनि।\nप्रायशो लोकसद्वृत्तमिष्यते गृहवासिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2097385, "chapter_id": 3086, "verse_number": "१३-२१६-१०", "content_sanskrit": "तेषां संरक्षणार्थाय राजानः संस्कृता भुवि।\nसर्वेषामथ मर्त्यानां वृत्तिं सामान्यतः शृणुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2097386, "chapter_id": 3086, "verse_number": "१३-२१६-११", "content_sanskrit": "विद्या वार्ता च सेवा च कारुत्वं नाट्यता तथा।\nइत्यते जीवनार्थाय मर्त्यानां विहिताः प्रिये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2097387, "chapter_id": 3086, "verse_number": "१३-२१६-१२", "content_sanskrit": "अपि जन्मफलं तावन्मानुषाणां विशेषतः।\nविहितं तत्स्ववृत्तेन तन्मे शृणु समाहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2097388, "chapter_id": 3086, "verse_number": "१३-२१६-१३", "content_sanskrit": "कर्मक्षेत्रं हि मानुष्यं सुखदुःखयुताः परे।\nसर्वेषां प्राणिनां तस्मान्मानुष्ये वृत्तिरिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2097389, "chapter_id": 3086, "verse_number": "१३-२१६-१४", "content_sanskrit": "विद्यायोगस्तु सर्वेषां पूर्वमेव विधीयते।\nकार्याकार्यं विजानन्ति विद्यया देवि नान्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2097390, "chapter_id": 3086, "verse_number": "१३-२१६-१५", "content_sanskrit": "विद्यया स्फीयते ज्ञानं ज्ञानात्तत्वनिदर्शनम्।\nदृष्टतत्वो विनीतात्मा सर्वार्थस्य च भाजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2097391, "chapter_id": 3086, "verse_number": "१३-२१६-१६", "content_sanskrit": "शक्यं विद्याविनीतेन लोके संजीवनं शुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2097392, "chapter_id": 3086, "verse_number": "१३-२१६-१७", "content_sanskrit": "आत्मानं विद्यया तस्मात्पूर्वं वृत्वा तु भाजनम्।\nवश्येन्द्रियो जितक्रोधो भूतात्मानं तु भावयेत्।\nभावयित्वा तदाऽऽत्मानं पूजनीयः सतामपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2097393, "chapter_id": 3086, "verse_number": "१३-२१६-१८", "content_sanskrit": "कुलानुवृत्तं वृत्तं वा पूर्वमात्मा समाश्रयेत्।\nइत्येतत्कुलवासाय दानकर्म यथा पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2097394, "chapter_id": 3086, "verse_number": "१३-२१६-१९", "content_sanskrit": "यदि चेद्विद्यया चैव वृत्तिं काङ्क्षेदथात्मनः।\nराजविद्यानुवादेऽपि लोकविद्यामथापि वा।\nतीर्थतश्चापि गृह्णीयाच्छुश्रूषादिगुणैर्युतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2097395, "chapter_id": 3086, "verse_number": "१३-२१६-२०", "content_sanskrit": "ग्रन्थतश्चार्थतश्चैव दृढं कुर्यात्प्रयत्नतः।\nएवं विद्याफलं देवि प्राप्नुयान्नान्यथा नरः।\nन्यायाद्विद्याफलानीच्छेदधर्मं तत्र वर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2097396, "chapter_id": 3086, "verse_number": "१३-२१६-२१", "content_sanskrit": "यदिच्छेद्वार्तया वृत्तिं काङ्क्षेत विधिपूर्वकम्।\nक्षेत्रे जलोपपन्ने च तद्योग्यां कृषिमाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2097397, "chapter_id": 3086, "verse_number": "१३-२१६-२२", "content_sanskrit": "वाणिज्यं वा यथाकालं कुर्यात्तद्देशयोगतः।\nमूल्यमर्थं प्रयासं च विचार्यैव व्ययोदयौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2097398, "chapter_id": 3086, "verse_number": "१३-२१६-२३", "content_sanskrit": "पशुसंजीवनं चैव दश गाः पोषयेद्ध्रुवम्।\nबहुप्रकारा बहवः पशवस्तस्य साधकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2097399, "chapter_id": 3086, "verse_number": "१३-२१६-२४", "content_sanskrit": "यः कश्चित्सेवया वृत्तिं काङ्क्षेत मतिमान्नरः।\nयतात्मा श्रवणीयानां भवेद्वै सम्प्रयोजकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2097400, "chapter_id": 3086, "verse_number": "१३-२१६-२५", "content_sanskrit": "बुद्ध्या वा कर्मयोगाद्वा बोधनाद्वा समाश्रयेत्।\nमार्गतस्तु समाश्रित्य तदा तत्सम्प्रयोजयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2097401, "chapter_id": 3086, "verse_number": "१३-२१६-२६", "content_sanskrit": "यथायथा सु तुष्येत तथा संतोषयेत्तु तम्।\nअनुजीविगुणोपेतः कुर्यादात्मार्थमाश्रितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2097402, "chapter_id": 3086, "verse_number": "१३-२१६-२७", "content_sanskrit": "विप्रियं नाचरेत्तस्य एषा सेवा समासतः।\nविप्रयोगात्पुरा तेन गतिमन्यां न लक्षयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2097403, "chapter_id": 3086, "verse_number": "१३-२१६-२८", "content_sanskrit": "कारुकर्म च नाट्यं च प्रायशो नीचयोनिषु।\nतयोरपि यथायोगं न्यायतः कर्मवेतनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2097404, "chapter_id": 3086, "verse_number": "१३-२१६-२९", "content_sanskrit": "आजीवेभ्योऽपि सर्वभ्यः स्वार्जवाद्वेतनं हरेत्।\nअनार्जवादाहरतस्तत्तु पापाय कल्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2097405, "chapter_id": 3086, "verse_number": "१३-२१६-३०", "content_sanskrit": "सर्वेषां पूर्वमारम्भांश्चिन्तयेन्नयपूर्वकम्।\nआत्मशक्तिमुपायांश्च देशकालौ च युक्तितः।\nकारणानि प्रयासं च प्रक्षेपं च फलोदयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2097406, "chapter_id": 3086, "verse_number": "१३-२१६-३१", "content_sanskrit": "एवमादीनि सञ्चिन्त्य दृष्ट्वा दैवानुकूलताम्।\nअतः परं समारम्भेद्यत्रात्महितमाहितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2097407, "chapter_id": 3086, "verse_number": "१३-२१६-३२", "content_sanskrit": "वृत्तिमेव समासाद्य तां सदा परिपालयेत्।\nदेवमानुषविघ्नेभ्यो न पुनर्मन्यते यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2097408, "chapter_id": 3086, "verse_number": "१३-२१६-३३", "content_sanskrit": "पालयन्वर्धयन्भुञ्जंस्तां प्राप्य न विनाशयेत्।\nक्षीयते गिरिसङ्काशमश्नतो ह्यनपेक्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2097409, "chapter_id": 3086, "verse_number": "१३-२१६-३४", "content_sanskrit": "आजीवेभ्यो धनं प्राप्य चतुर्धा विभजेद्बुधः।\nधर्मायार्थाय कामाय आपत्प्रशमनाय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2097410, "chapter_id": 3086, "verse_number": "१३-२१६-३५", "content_sanskrit": "चतुर्ष्वपि विभागेषु विधानं शृणु शोभने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2097411, "chapter_id": 3086, "verse_number": "१३-२१६-३६", "content_sanskrit": "यज्ञार्थं चान्नदानार्थं दीनानुग्रहकारणात्।\nदेवब्राह्मणपूजार्थं पितृपूजार्थमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2097412, "chapter_id": 3086, "verse_number": "१३-२१६-३७", "content_sanskrit": "मूलार्थं सन्निवासार्थं क्रियानित्यैश्चि धार्मिकैः।\nएवमादिषु चान्येषु धर्मार्थं संत्यजेद्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2097413, "chapter_id": 3086, "verse_number": "१३-२१६-३८", "content_sanskrit": "धर्मकार्ये धनं दद्यादनवेक्ष्य फलोदयम्।\nऐश्वर्यस्थानलाभार्थं राजवाल्लभ्यकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2097414, "chapter_id": 3086, "verse_number": "१३-२१६-३९", "content_sanskrit": "वार्तायां च समारम्भेऽमात्यमित्रपरिग्रहे।\nआवाहे च विवाहे च पुत्राणां वृत्तिकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2097415, "chapter_id": 3086, "verse_number": "१३-२१६-४०", "content_sanskrit": "अर्थोदयसमावाप्तावनर्थस्य विघातने।\nएवमादिषु चान्येषु अर्थार्थं विसृजेद्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2097416, "chapter_id": 3086, "verse_number": "१३-२१६-४१", "content_sanskrit": "अनुबन्धं हेतुयुक्तं दृष्ट्वा वित्तं परित्यजेत्।\nअनर्थं बाधते ह्यर्थो अर्तं चैव फलान्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2097417, "chapter_id": 3086, "verse_number": "१३-२१६-४२", "content_sanskrit": "नाधनाः प्राप्नुन्त्यर्थं नरा यत्नशतैरपि।\nतस्माद्धनं रक्षितव्यं दातव्यं च विधानतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2097418, "chapter_id": 3086, "verse_number": "१३-२१६-४३", "content_sanskrit": "शरीरपोषणार्थाय आहारस्य विशोषणे।\nनट*****धर्वसंयोगे कामयात्राविहारयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2097419, "chapter_id": 3086, "verse_number": "१३-२१६-४४", "content_sanskrit": "मनःप्रियाणां संयोगे प्रीतिदाने तथैव च।\nएवमादिषु चान्येषु कामार्तं विसृजेद्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2097420, "chapter_id": 3086, "verse_number": "१३-२१६-४५", "content_sanskrit": "विचार्य गुणदोषांस्तु त्रयाणां तत्र संत्यजेत्।\nचतुर्थं सन्निदध्याच्च आपदर्थं शुचिस्मिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2097421, "chapter_id": 3086, "verse_number": "१३-२१६-४६", "content_sanskrit": "राज्यभ्रंशविनाशार्थं दुर्भिक्षार्थं च शोभने।\nमहाव्याधिविमोक्षार्थं वार्धकस्यैव कारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2097422, "chapter_id": 3086, "verse_number": "१३-२१६-४७", "content_sanskrit": "शत्रूणां प्रतिकाराय साहसैश्चाप्यमर्षणात्।\nप्रस्थाने चान्यदेशार्थमापदां विप्रमोक्षणे।\nएवमादि समुद्दिश्य सन्निदध्यात्स्वकं धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2097423, "chapter_id": 3086, "verse_number": "१३-२१६-४८", "content_sanskrit": "सुखमर्थवतां लोके कृच्छ्राणां विप्रमोक्षणम्।\nयस्य नास्ति धनं किञ्चित्तस्य लोकद्वयं न च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2097424, "chapter_id": 3086, "verse_number": "१३-२१६-४९", "content_sanskrit": "अशनादिन्द्रियाणीव सर्वमर्थात्प्रवर्तते।\nनिधानमात्रं यस्तेषामन्यथा विलयं व्रजेत्।\nएवं देवि मनुष्याणां लोकानां जीवनं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2097425, "chapter_id": 3086, "verse_number": "१३-२१६-५०", "content_sanskrit": "एवं लोकस्य वृत्तस्य लोकवृत्तं पुनः शृणु।\nधन्यं यशस्यमायुष्यं स्वर्ग्यं च परमं यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2097426, "chapter_id": 3086, "verse_number": "१३-२१६-५१", "content_sanskrit": "त्रिवर्गो हि वशे युक्तः सर्वेषां संविधीयते।\nतथा संवर्तमानास्तु लोकयोर्हितमाप्नुयुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2097427, "chapter_id": 3086, "verse_number": "१३-२१६-५२", "content_sanskrit": "काल्योत्थानं च शौचं च देवब्राह्मणभक्तितः।\nगुरुणामेव शुश्रूषा ब्राह्मणेष्वभिवादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2097428, "chapter_id": 3086, "verse_number": "१३-२१६-५३", "content_sanskrit": "प्रत्युत्थानं च वृद्धानां देवस्थानप्रणामनम्।\nआभिमुख्यं पुरस्कृत्य अतिथीनां च पूजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2097429, "chapter_id": 3086, "verse_number": "१३-२१६-५४", "content_sanskrit": "वृद्धोपदेशकरणं श्रवणं हितपथ्ययोः।\nपोषणं भूत्यवर्गस्य सान्त्वदानपरिग्रहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2097430, "chapter_id": 3086, "verse_number": "१३-२१६-५५", "content_sanskrit": "न्यायतः कर्मकरणमन्यायाहितवर्जितम्।\nसम्यग्वृत्तं स्वदारेषु दोषाणां प्रतिषेधनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2097431, "chapter_id": 3086, "verse_number": "१३-२१६-५६", "content_sanskrit": "पुत्राणां विनयं कुर्यात्तत्तत्कार्यनियोजनम्।\nवर्जनं चाशुभार्थानां शुभानां जोषणं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2097432, "chapter_id": 3086, "verse_number": "१३-२१६-५७", "content_sanskrit": "कुलोचितानां धर्माणां यतावत्परिपालनम्।\nकुलसन्धारणं चैव पौरुषेणैव सर्वशः।\nएवमादि शुभं सर्वं तस्य वृत्तमिति स्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2097433, "chapter_id": 3086, "verse_number": "१३-२१६-५८", "content_sanskrit": "वृद्धसेवी भवेन्नित्यं हितार्थं ज्ञानकाङ्क्षया।\nपरार्थं नाहरेद्द्रव्यमनामन्त्र्य तु सर्वथा।\nन याचेत परान्धीरः स्वबाहुबलमाश्रयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2097434, "chapter_id": 3086, "verse_number": "१३-२१६-५९", "content_sanskrit": "स्वशरीरं सदा रक्षेदाहाराचारयोरपि।\nहितं पथ्यं सदाहारं जीर्णं भुञ्जीत मात्रया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2097435, "chapter_id": 3086, "verse_number": "१३-२१६-६०", "content_sanskrit": "देवतातिथिसत्कारं कृत्वा सर्वं यथाविधि।\nशेषं भुञ्जेच्छुचिर्भूत्वा न च भाषेत विप्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2097436, "chapter_id": 3086, "verse_number": "१३-२१६-६१", "content_sanskrit": "प्रतिश्रयं च पानीयं बलिं भिक्षां च सर्वतः।\nगृहस्थवासी सततं तद्याद्गाश्चैव पोषयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2097437, "chapter_id": 3086, "verse_number": "१३-२१६-६२", "content_sanskrit": "बहिर्निष्क्रमणं चैव कुर्यात्कारणतोपि वा।\nमध्याह्ने वाऽर्धरात्रे वा गमनाय न रोचयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2097438, "chapter_id": 3086, "verse_number": "१३-२१६-६३", "content_sanskrit": "विषयान्नावगाहेत स्वशक्त्या तु समाचरेत्।\nयथाऽऽयव्ययता लोके गृहस्थानां प्रपूजितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2097439, "chapter_id": 3086, "verse_number": "१३-२१६-६४", "content_sanskrit": "अयशस्करमर्थघ्नं कर्म यत्परपीडनम्।\nभयाद्वा यदि लोभाद्वा न कुर्वीत कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2097440, "chapter_id": 3086, "verse_number": "१३-२१६-६५", "content_sanskrit": "बुद्धिपूर्वं समालोक्य दूरतो गुणदोषतः।\nआरभेत तदा कर्भ शुभं वा यदि वेतरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2097441, "chapter_id": 3086, "verse_number": "१३-२१६-६६", "content_sanskrit": "आत्मसाक्षी भवेन्नित्यमात्मनस्तु शुभाशुभे।\nमनसा कर्मणा वाचा न च काङ्क्षेत पातकम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2097442, "chapter_id": 3086, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि षोडशाधिकद्विशततमोऽध्यायः॥ २१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]