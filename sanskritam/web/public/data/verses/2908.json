[{"id": 2089145, "chapter_id": 2908, "verse_number": "१३-३८-१", "content_sanskrit": "`युधिष्ठिर उवाच।\nक्लिश्यमानेषु भूतेषु जातीमरणसागरे।\nयत्प्राप्य क्लेशं नाप्नोति तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2089146, "chapter_id": 2908, "verse_number": "१३-३८-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2089147, "chapter_id": 2908, "verse_number": "१३-३८-२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nसनत्कुमारस्य सतः संवादं नारदस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2089148, "chapter_id": 2908, "verse_number": "१३-३८-३", "content_sanskrit": "सनत्कुमारो भगवान्ब्रह्मपुत्रो महायशाः।\nपूर्वजातास्त्रयस्तस्य कथ्यन्ते ब्रह्मवादिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2089149, "chapter_id": 2908, "verse_number": "१३-३८-४", "content_sanskrit": "सनकः सनन्दनश्चैव तृतीयश्च सनातनः।\nजातमात्राश्च ते सर्वे प्रतिबुद्धा इति श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2089150, "chapter_id": 2908, "verse_number": "१३-३८-५", "content_sanskrit": "चतुर्थश्चैव तेषां स भगवान्योगवित्तमः।\nसनत्कुमार इति वै कथयन्ति महर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2089151, "chapter_id": 2908, "verse_number": "१३-३८-६", "content_sanskrit": "हैरण्यगर्भः स मुनिर्वसिष्ठः पञ्चमः स्मृतः।\nषष्ठः स्थाणुः स भगवानमेयात्मा त्रिशूलधृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2089152, "chapter_id": 2908, "verse_number": "१३-३८-७", "content_sanskrit": "ततोऽपरे समुत्पन्नाः पावकादारुणे क्रतौ।\nमनसा स्वयंभुवो हीमे मरीचिप्रमुखास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2089153, "chapter_id": 2908, "verse_number": "१३-३८-८", "content_sanskrit": "भुगुर्मरीचेरनुजो भृगोरप्यङ्गिरास्तथा।\nअनुजोङ्गिरसोऽथात्रिः पुलस्त्योत्रेस्तथाऽनुजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2089154, "chapter_id": 2908, "verse_number": "१३-३८-९", "content_sanskrit": "पुलस्त्यस्यानुजो विद्वान्पुलहो न महाद्युतिः।\nपठ्यन्ते ब्रह्मजा ह्येते विद्वद्बिरमितौजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2089155, "chapter_id": 2908, "verse_number": "१३-३८-१०", "content_sanskrit": "सर्वमेतन्महाराज कुर्वन्नादिगुरुर्महान्।\nप्रभुर्विभुरनन्तश्रीर्ब्रह्मा लोकपितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2089156, "chapter_id": 2908, "verse_number": "१३-३८-११", "content_sanskrit": "मूर्तिमन्तोऽमृतीभूतास्तेजसाऽतितपोन्विताः।\nसनकप्रभृतयस्तत्र ये च प्राप्ताः परं पदम्।\nकृत्स्नं क्षयमनुप्राप्य विमुक्ता मूर्तिबन्धनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2089157, "chapter_id": 2908, "verse_number": "१३-३८-१२", "content_sanskrit": "सनत्कुमारस्तु विभुर्योगमास्थाय योगवित्।\nत्रीँल्लोकानचरच्छश्वदैर्येण परेण हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2089158, "chapter_id": 2908, "verse_number": "१३-३८-१३", "content_sanskrit": "रुद्रश्चाप्यष्टगुणितं योगं प्राप्तो महायशाः।\nसूक्ष्ममष्टगुणं राजन्नितरे नृपसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2089159, "chapter_id": 2908, "verse_number": "१३-३८-१४", "content_sanskrit": "मरीचिप्रमुखास्तात सर्वे सृष्ट्यर्थमेव ते।\nनियुक्ता राजशार्दूल तेषां सृष्टिं शृणुष्व मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2089160, "chapter_id": 2908, "verse_number": "१३-३८-१५", "content_sanskrit": "सप्त ब्रह्मण इत्येते पुराणे निश्चयं गताः।\nसर्वे वेदेषु चैवोक्ताः खिलेषु च न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2089161, "chapter_id": 2908, "verse_number": "१३-३८-१६", "content_sanskrit": "इतिहासपुराणे च श्रुतिरेषा सनातनी।\nब्राह्मणा वरदानेतान्प्राहुर्वेदान्तपारगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2089162, "chapter_id": 2908, "verse_number": "१३-३८-१७", "content_sanskrit": "एतेषां पितरस्तात पुत्रा इत्यनुचक्षते।\nगणाः सप्त महाराज मूर्तयोऽमूर्तयस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2089163, "chapter_id": 2908, "verse_number": "१३-३८-१८", "content_sanskrit": "पितृणां चैव राजेन्द्र पुत्रा देवा इति श्रुतिः।\nदेवैर्व्याप्ता इमे लोका इत्येवमनुशुश्रुम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2089164, "chapter_id": 2908, "verse_number": "१३-३८-१९", "content_sanskrit": "कृष्णद्वैपायनाच्चैव देवस्थानात्तथैव त।\nदेवलाच्च नरश्रेष्ठ काश्यपाच्च मया श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2089165, "chapter_id": 2908, "verse_number": "१३-३८-२०", "content_sanskrit": "गौतमादपि कौण्डिन्याद्बारद्वाजात्तथैव च।\nमार्कण्डेयात्तथैवैतदृषेर्देवमतादपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2089166, "chapter_id": 2908, "verse_number": "१३-३८-२१", "content_sanskrit": "पित्रा च मम राजेन्द्र श्राद्धकाले प्रभाषितम्।\nपरं रहस्यं वेदान्तं प्रियं हि परमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2089167, "chapter_id": 2908, "verse_number": "१३-३८-२२", "content_sanskrit": "अतः परं प्रवक्ष्यामि यन्मां पृच्छसि भारतः।\nतदिहैकमनोबुद्धिः शृणुष्वावहितो नृप।\nस्वायंभुवस्य संवादं नारदस्य च धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2089168, "chapter_id": 2908, "verse_number": "१३-३८-२३", "content_sanskrit": "सनत्कुमारो भगवान्दिव्यं जज्वाल तेजसा।\nअङ्गुष्ठमात्रो भूत्वा वै विचचार महाद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2089169, "chapter_id": 2908, "verse_number": "१३-३८-२४", "content_sanskrit": "स कदाचिन्महाभागो मेरुपृष्ठं समागमत्।\nनारदेन नरश्रेष्ठ मुनिना ब्रह्मवादिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2089170, "chapter_id": 2908, "verse_number": "१३-३८-२५", "content_sanskrit": "जिज्ञासमानावन्योन्यं सकाशे ब्रह्मणस्ततः।\nब्रह्म भागवतौ तात परमार्थार्थचिन्तकौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2089171, "chapter_id": 2908, "verse_number": "१३-३८-२६", "content_sanskrit": "मतिमान्मतिमच्छ्रेष्ठं बुद्धिमान्बुद्धिमत्तरम्।\nक्षेत्रवित्क्षेत्रविच्छ्रेष्ठं ज्ञानविज्ज्ञानमत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2089172, "chapter_id": 2908, "verse_number": "१३-३८-२७", "content_sanskrit": "सनत्कुमारं तत्वज्ञं भगवन्तमरिंदम।\nलोकविल्लोकविच्छ्रेष्ठमात्मविच्चात्मवित्तमम्।\nसर्ववेदार्थकुशलं सर्वशास्त्रविशारदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2089173, "chapter_id": 2908, "verse_number": "१३-३८-२८", "content_sanskrit": "साङ्ख्ययोगं च यो वेद पाणावामलकं यथा।\nनारदोऽथ नरश्रेष्ठ तं पप्रच्छ महाद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2089174, "chapter_id": 2908, "verse_number": "१३-३८-२९x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2089175, "chapter_id": 2908, "verse_number": "१३-३८-२९", "content_sanskrit": "त्रयोविंशतितत्वस्य अव्यक्तस्य महामुने।\nप्रभवं चाप्ययं चैव श्रोतुमिच्छामि तत्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2089176, "chapter_id": 2908, "verse_number": "१३-३८-३०", "content_sanskrit": "अध्यात्ममधिभूतं च अधिदैवं तथैव च।\nकालसङ्ख्याश्च सर्गं च स्रष्टारं पुरुषं प्रभुम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2089177, "chapter_id": 2908, "verse_number": "१३-३८-३१", "content_sanskrit": "यं विस्वमुपजीवन्ति येन सर्वमिदं ततम्।\nयं प्राप्य न निवर्तन्ते तद्भवान्वक्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2089178, "chapter_id": 2908, "verse_number": "१३-३८-३२x", "content_sanskrit": "सनत्कुमार उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2089179, "chapter_id": 2908, "verse_number": "१३-३८-३२", "content_sanskrit": "यं विश्वमुपजीवन्ति यमाहुः पुरुषं परम्।\nतं वै शृणु महाबुद्धे नारायणमनामयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2089180, "chapter_id": 2908, "verse_number": "१३-३८-३३", "content_sanskrit": "एष नारायणो नाम यं विश्वमुपजीवति।\nएष स्रष्टा विधाता च भर्ता पालयिता प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2089181, "chapter_id": 2908, "verse_number": "१३-३८-३४", "content_sanskrit": "प्राप्यैनं न निवर्तन्ते यतयोऽध्यात्मचिन्तकाः।\nएतावदेव वक्तव्यं मया नारद पृच्छते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2089182, "chapter_id": 2908, "verse_number": "१३-३८-३५", "content_sanskrit": "परं न वेद्मि तत्सर्गं यावांश्चायं यथाप्यहम्।\nश्रूयतामानुपूर्व्येण न च सर्गः प्रयत्नतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2089183, "chapter_id": 2908, "verse_number": "१३-३८-३६", "content_sanskrit": "यथा कालपरीमाणं तत्वानामृषिसत्तम।\nअध्यात्ममधिभूतं च अधिदैवं तथैव च।\nकालसंख्यां च सर्गं च सर्वमेव महामुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2089184, "chapter_id": 2908, "verse_number": "१३-३८-३७", "content_sanskrit": "तमसः कुर्वतः सर्गं तामसो ह्यभिधीयते।\nब्रह्मविद्भिर्द्विजैर्नित्यं नित्यमध्यात्मचिन्तकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2089185, "chapter_id": 2908, "verse_number": "१३-३८-३८", "content_sanskrit": "पर्यायनामान्येतस्य कथयन्ति मनीषिणः।\nतानि ते सम्प्रवक्ष्यामि तदिहैकमनाः शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2089186, "chapter_id": 2908, "verse_number": "१३-३८-३९", "content_sanskrit": "महार्णवोऽर्णवश्चैव सलिलं च गुणास्तथा।\nवेदास्तपांसि यज्ञाश्च धर्माश्च भगवान्विभुः।\nप्राणः सांवर्तकोग्निश्च व्योम कालस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2089187, "chapter_id": 2908, "verse_number": "१३-३८-४०", "content_sanskrit": "नामान्येतानि ब्रह्मर्षे शरीरस्येश्वरस्य वै।\nकीर्तितानि द्विजश्रेष्ठ मया शास्त्रानुसारतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2089188, "chapter_id": 2908, "verse_number": "१३-३८-४१", "content_sanskrit": "चतुर्युगसहस्राणि चतुर्युगमरिंदम।\nप्राहुः कल्पसहस्रं वै ब्राह्मणास्तत्वदर्शिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2089189, "chapter_id": 2908, "verse_number": "१३-३८-४२", "content_sanskrit": "दशकल्पसहस्राणि अव्ययस्य महानिशा।\nतथैव दिवसं प्राहुर्योगाः सांख्याश्च तत्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2089190, "chapter_id": 2908, "verse_number": "१३-३८-४३", "content_sanskrit": "निशासुप्तोथ भगवान्क्षपान्ते प्रत्यबुध्यत।\nपश्चाद्बुद्ध्वा ससर्जापस्तासु वीर्यमवासृजत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2089191, "chapter_id": 2908, "verse_number": "१३-३८-४४", "content_sanskrit": "तदण्डमभवद्धैमं सहस्रांशुसमप्रभम्।\nअहंकृत्वा ततस्तस्मिन्ससर्ज प्रभुरीश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2089192, "chapter_id": 2908, "verse_number": "१३-३८-४५", "content_sanskrit": "हिरण्यगर्भं विस्वात्मा ब्रह्माणां जलवन्मुनिम्।\nभूतभव्यभविष्यस्य कर्तारमनघं विभुम्।\nमूर्तिमन्तं महात्मानं विश्वशभुं स्वयंभुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2089193, "chapter_id": 2908, "verse_number": "१३-३८-४६", "content_sanskrit": "अणिमा लघिमा प्राप्तिरीशानो ज्योतिषां नरम्।\nचक्रे तिरोधां भगवानेत्कृत्वा महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2089194, "chapter_id": 2908, "verse_number": "१३-३८-४७", "content_sanskrit": "एतस्यापि निशामाहुर्वेदवेदाङ्गपारगाः।\nपञ्चकल्पसहस्राणि अहरेतावदेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2089195, "chapter_id": 2908, "verse_number": "१३-३८-४८", "content_sanskrit": "स सर्गं कुरुत ब्रह्मा तामसश्चानुपूर्व्यशः।\nसृजतेऽहं त्वहंकारं परमेष्ठिनमव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2089196, "chapter_id": 2908, "verse_number": "१३-३८-४९", "content_sanskrit": "अहङ्कारेणैव लोका व्याप्ताः साहंकृतेन वै।\nयेनाविष्टानि भूतानि मज्जन्त्यव्यक्तसागरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2089197, "chapter_id": 2908, "verse_number": "१३-३८-५०", "content_sanskrit": "देवर्षिदानवनरा यक्षगन्धर्वकिन्नराः।\nउन्मज्जन्ति निमज्जन्ति ऊर्ध्वाधस्तिर्यगेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2089198, "chapter_id": 2908, "verse_number": "१३-३८-५१", "content_sanskrit": "एतस्यापि निशामाहुस्तृतीयामथ कुर्वतः।\nत्रीणि कल्पसहस्राणि अहरेतावदेव तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2089199, "chapter_id": 2908, "verse_number": "१३-३८-५२", "content_sanskrit": "अहङ्कारस्तु सृजति महाभूतानि पञ्च वै।\nपृथिवी वायुराकाशमापो ज्योतिश्च पञ्चमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2089200, "chapter_id": 2908, "verse_number": "१३-३८-५३", "content_sanskrit": "एतेषां गुणतत्वानि पञ्च प्राहुर्द्विजातयः।\nशब्दे स्पर्शे च रूपे च रसे गन्धे तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2089201, "chapter_id": 2908, "verse_number": "१३-३८-५४", "content_sanskrit": "गुणेष्वेतेष्वभिरताः पङ्कलग्ना इव द्विपाः।\nनोत्तिष्ठन्त्यवशीभूताः सक्ता अव्यक्तसागरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2089202, "chapter_id": 2908, "verse_number": "१३-३८-५५", "content_sanskrit": "एतेषामिह वै सर्वं चतुर्थमिह कुर्वतः।\nचतुर्युगसहस्रे वै अहोरात्रास्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2089203, "chapter_id": 2908, "verse_number": "१३-३८-५६", "content_sanskrit": "अनन्त इति विख्यातः पञ्चमः सर्ग उच्यते।\nइन्द्रियाणि दशैकं च यथाश्रुतिनिदर्शनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2089204, "chapter_id": 2908, "verse_number": "१३-३८-५७", "content_sanskrit": "मनः सर्वमिदं तात विश्वं सर्वमिदं जगत्।\nन तथान्यानि भूतानि बलवन्ति यथा मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2089205, "chapter_id": 2908, "verse_number": "१३-३८-५८", "content_sanskrit": "एतस्यापि ह वै सर्गं षष्ठमाहुर्द्विजातयः।\nअहः कल्पसहस्रं वै रात्रिरेतावती तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2089206, "chapter_id": 2908, "verse_number": "१३-३८-५९", "content_sanskrit": "ऊर्ध्वस्रोतस्तु वै सर्गं सप्तमं ब्रह्मणो विदुः।\nअष्टमं चाप्यधःस्रोतस्तिर्यक्तु नवमः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2089207, "chapter_id": 2908, "verse_number": "१३-३८-६०", "content_sanskrit": "एतानि नव सर्गाणि तत्वानि च महामुने।\nचतुर्विंशतितत्वानि तत्वसंख्यानि तेऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2089208, "chapter_id": 2908, "verse_number": "१३-३८-६१", "content_sanskrit": "सर्वस्य प्रभवः पूर्वमुक्तो नारायणः प्रभुः।\nअव्ययः प्रभवश्चैव अव्यक्तस्य महामुने।\nप्रवक्ष्याम्यपरं तत्वं यस्य यस्येश्वरश्च यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2089209, "chapter_id": 2908, "verse_number": "१३-३८-६२", "content_sanskrit": "अध्यात्ममधिभूतं च अधिदैवं तथैव च।\nयथाश्रुतं यथादृष्टं तत्वतो वै निबोध मे॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2089210, "chapter_id": 2908, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि अष्टत्रिंशोऽध्यायः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]