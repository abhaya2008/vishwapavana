[{"id": 6000058000, "chapter_id": 10058, "verse_number": null, "content_sanskrit": "अथ अष्टाविंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "topics": [{"text": "कपिलेन स्वमात्रे देवहूत्यै प्रकृतिपुरुषविवेकनिरूपणम्", "range": null}]}, {"id": 6000058001, "chapter_id": 10058, "verse_number": "३-२८-१", "content_sanskrit": "प्रकृतिस्थोऽपि पुरुषो नाज्यते प्राकृतैर्गुणैः।\nअविकारादकर्तृत्वान्निर्गुणत्वाज्जलार्कवत्॥ ३/२८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_028/BhP_03.028.001.m4a", "display_order": 2}, {"id": 6000058002, "chapter_id": 10058, "verse_number": "३-२८-२", "content_sanskrit": "स एष यर्हि प्रकृतेर्गुणेष्वभिविषज्जते।\nअहङ्कारविमूढात्मा कर्ताऽस्मीत्यभिमन्यते॥ ३/२८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_028/BhP_03.028.002.m4a", "display_order": 3}, {"id": 6000058003, "chapter_id": 10058, "verse_number": "३-२८-३", "content_sanskrit": "तेन संसारपदवीम् अवशोऽभ्येत्य निर्वृतः।\nप्रासङ्गिकैः कर्मदोषैः सदसन्मिश्रयोनिषु॥ ३/२८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_028/BhP_03.028.003.m4a", "display_order": 4}, {"id": 6000058004, "chapter_id": 10058, "verse_number": "३-२८-४", "content_sanskrit": "अर्थे ह्यविद्यमानेऽपि संसृतिर्न निवर्तते।\nध्यायतो विषयानस्य स्वप्नेऽनर्थागमो यथा॥ ३/२८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_028/BhP_03.028.004.m4a", "display_order": 5}, {"id": 6000058005, "chapter_id": 10058, "verse_number": "३-२८-५", "content_sanskrit": "प्रबुध्य स्वप्नसुप्तिभ्यां संस्मरन्नात्मवैशसम्।\nवैतथ्यं व्यभिचारं च नासौ ध्यायेद् यतो भयम्॥ ३/२८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_028/BhP_03.028.005.m4a", "display_order": 6}, {"id": 6000058006, "chapter_id": 10058, "verse_number": "३-२८-६", "content_sanskrit": "अत एव शनैश्चित्तं प्रसक्तमसतां पथि।\nभक्तियोगेन तीव्रेण विरक्त्याऽऽत्मवशं नयेत्॥ ३/२८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_028/BhP_03.028.006.m4a", "display_order": 7}, {"id": 6000058007, "chapter_id": 10058, "verse_number": "३-२८-७", "content_sanskrit": "यमादिभिर्योगपथैरभ्यसन् श्रद्धयाऽन्वितः।\nमयि भावेन सत्येन मत्कथाश्रवणेन च॥ ३/२८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_028/BhP_03.028.007.m4a", "display_order": 8}, {"id": 6000058008, "chapter_id": 10058, "verse_number": "३-२८-८", "content_sanskrit": "सर्वभूतसमत्वेन निर्वैरेणाप्रसङ्गतः।\nब्रह्मचर्येण मौनेन स्वधर्मेण महीयसा॥ ३/२८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_028/BhP_03.028.008.m4a", "display_order": 9}, {"id": 6000058009, "chapter_id": 10058, "verse_number": "३-२८-९", "content_sanskrit": "यदृच्छयोपलब्धेन सन्तुष्टो मितभुङ् मुनिः।\nविविक्तशरणः शान्तो मैत्रः करुण आत्मवान्॥ ३/२८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_028/BhP_03.028.009.m4a", "display_order": 10}, {"id": 6000058010, "chapter_id": 10058, "verse_number": "३-२८-१०", "content_sanskrit": "सानुबन्धे च देहेऽस्मिन्नकुर्वन्नसदाग्रहम्।\nज्ञानेन दृष्टतत्त्वेन प्रकृतेः पुरुषस्य च॥ ३/२८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_028/BhP_03.028.010.m4a", "display_order": 11}, {"id": 6000058011, "chapter_id": 10058, "verse_number": "३-२८-११", "content_sanskrit": "निवृत्तबुद्ध्यवस्थानो दूरीभूतान्यदर्शनः।\nउपलभ्यात्मनाऽऽत्मानं चक्षुषेवार्कमेकदृक्॥ ३/२८/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_028/BhP_03.028.011.m4a", "display_order": 12}, {"id": 6000058012, "chapter_id": 10058, "verse_number": "३-२८-१२", "content_sanskrit": "मुक्तलिङ्गः सदाभासमसति प्रतिपद्यते।\nसतो बन्धुं समं चक्षुः सर्वानुस्यूतमद्वयम्॥ ३/२८/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_028/BhP_03.028.012.m4a", "display_order": 13}, {"id": 6000058013, "chapter_id": 10058, "verse_number": "३-२८-१३", "content_sanskrit": "यथा जलस्थ आभासः स्थलस्थेनाभिदृश्यते।\nस्वाभासेन यथा सूर्यो जलस्थेन दिवि स्थितः॥ ३/२८/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_028/BhP_03.028.013.m4a", "display_order": 14}, {"id": 6000058014, "chapter_id": 10058, "verse_number": "३-२८-१४", "content_sanskrit": "एवं त्रिवृदहङ्कारो भूतेन्द्रियमनोगुणैः।\nस्वाभासैर्लक्षितोऽनेन सदाभासेन सत्यदृक्॥ ३/२८/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_028/BhP_03.028.014.m4a", "display_order": 15}, {"id": 6000058015, "chapter_id": 10058, "verse_number": "३-२८-१५", "content_sanskrit": "भूतसूक्ष्मेन्द्रियमनोबुद्ध्यादिष्विह निद्रया।\nलीनेषु सत्सु यस्तत्र विनिद्रो निरहङ्क्रियः॥ ३/२८/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_028/BhP_03.028.015.m4a", "display_order": 16}, {"id": 6000058016, "chapter_id": 10058, "verse_number": "३-२८-१६", "content_sanskrit": "मन्यमानस्तदात्मानमनष्टो नष्टवन्मृषा।\nनष्टेऽहङ्करणे द्रष्टा नष्टचित्त इवातुरः॥ ३/२८/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_028/BhP_03.028.016.m4a", "display_order": 17}, {"id": 6000058017, "chapter_id": 10058, "verse_number": "३-२८-१७", "content_sanskrit": "एवं प्रत्यवमृश्यासावात्मानं प्रतिपद्यते।\nसाहङ्कारस्य द्रव्यस्य योऽवस्थानमनुग्रहः॥ ३/२८/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_028/BhP_03.028.017.m4a", "display_order": 18}, {"id": 6000058018, "chapter_id": 10058, "verse_number": null, "content_sanskrit": "देवहूतिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_028/BhP_03.028.018.m4a", "display_order": 19}, {"id": 6000058019, "chapter_id": 10058, "verse_number": "३-२८-१८", "content_sanskrit": "पुरुषं प्रकृतिर्ब्रह्मन् न विमुञ्चति कर्हिचित्।\nअन्योन्यापाश्रयत्वाच्च नित्यत्वादनयोः प्रभो॥ ३/२८/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_028/BhP_03.028.019.m4a", "display_order": 20}, {"id": 6000058020, "chapter_id": 10058, "verse_number": "३-२८-१९", "content_sanskrit": "यथा गन्धस्य भूमेश्च न भावो व्यतिरेकतः।\nअपां रसस्य च यथा तथा बुद्धेः परस्य च॥ ३/२८/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_028/BhP_03.028.020.m4a", "display_order": 21}, {"id": 6000058021, "chapter_id": 10058, "verse_number": "३-२८-२०", "content_sanskrit": "अकर्तुः कर्मबन्धोऽयं पुरुषस्य यदाश्रयः।\nगुणेषु सत्सु प्रकृतेः कैवल्यं तेष्वतः कथम्॥ ३/२८/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_028/BhP_03.028.021.m4a", "display_order": 22}, {"id": 6000058022, "chapter_id": 10058, "verse_number": "३-२८-२१", "content_sanskrit": "सकृत् तत्त्वावमर्शेन निवृत्तं भयमुल्बणम्।\nनिवृत्तस्यानिवृत्तत्त्वात् पुनः प्रत्यवतिष्ठते॥ ३/२८/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_028/BhP_03.028.022.m4a", "display_order": 23}, {"id": 6000058023, "chapter_id": 10058, "verse_number": null, "content_sanskrit": "भगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_028/BhP_03.028.023.m4a", "display_order": 24}, {"id": 6000058024, "chapter_id": 10058, "verse_number": "३-२८-२२", "content_sanskrit": "अनिमित्तप्रवृत्तेन स्वधर्मेणामलत्मना।\nतीव्रया मयि भक्त्या च श्रुतिसम्भृतया चिरम्॥ ३/२८/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_028/BhP_03.028.024.m4a", "display_order": 25}, {"id": 6000058025, "chapter_id": 10058, "verse_number": "३-२८-२३", "content_sanskrit": "दृष्टतत्त्वेन ज्ञानेन वैराग्येण बलीयसा।\nतपोयुक्तेन योगेन तीव्रेणात्मसमाधिना॥ ३/२८/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_028/BhP_03.028.025.m4a", "display_order": 26}, {"id": 6000058026, "chapter_id": 10058, "verse_number": "३-२८-२४", "content_sanskrit": "प्रकृतिः पुरुषस्यैवं दह्यमाना त्वहर्निशम्।\nतिरोभवित्री शनकैरग्नेर्योनिरिवारणिः॥ ३/२८/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_028/BhP_03.028.026.m4a", "display_order": 27}, {"id": 6000058027, "chapter_id": 10058, "verse_number": "३-२८-२५", "content_sanskrit": "भुक्तभोगा परित्यक्ता दृष्टदोषा च नित्यशः।\nनेश्वरस्याशुभं धत्ते स्वे महिम्नि स्थितस्य च॥ ३/२८/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_028/BhP_03.028.027.m4a", "display_order": 28}, {"id": 6000058028, "chapter_id": 10058, "verse_number": "३-२८-२६", "content_sanskrit": "यथा ह्यप्रतिबुद्धस्य प्रस्वापो बह्वनर्थकृत्।\nस एव प्रतिबुद्धस्य न वै मोहाय कल्पते॥ ३/२८/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_028/BhP_03.028.028.m4a", "display_order": 29}, {"id": 6000058029, "chapter_id": 10058, "verse_number": "३-२८-२७", "content_sanskrit": "एवं विदिततत्त्वस्य प्रकृतिर्मयि मानसम्।\nयुञ्जतो नापकुरुते आत्मारामस्य कर्हिचित्॥ ३/२८/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_028/BhP_03.028.029.m4a", "display_order": 30}, {"id": 6000058030, "chapter_id": 10058, "verse_number": "३-२८-२८", "content_sanskrit": "यदैवमध्यात्मरतः कालेन बहुजन्मना।\nसर्वत्र जातवैराग्य आब्रह्मभुवनान्मुनिः॥ ३/२८/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_028/BhP_03.028.030.m4a", "display_order": 31}, {"id": 6000058031, "chapter_id": 10058, "verse_number": "३-२८-२९", "content_sanskrit": "मद्भक्तः प्रतिबुद्धार्थो मत्प्रसादेन भूयसा।\nनिःश्रेयसं स्वसंस्थानं कैवल्याख्यं मदाश्रयम्॥ ३/२८/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_028/BhP_03.028.031.m4a", "display_order": 32}, {"id": 6000058032, "chapter_id": 10058, "verse_number": "३-२८-३०", "content_sanskrit": "प्राप्नोतीहाञ्जसा धीरः स्वदृशा च्छिन्नसंशयः।\nयद् गत्वा न निवर्तेत योगी लिङ्गविनिर्गमे॥ ३/२८/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_028/BhP_03.028.032.m4a", "display_order": 33}, {"id": 6000058033, "chapter_id": 10058, "verse_number": "३-२८-३१", "content_sanskrit": "यदा न योगोपचितासु चेतो मायासु सिद्धस्य विषज्जतेऽम्ब।\nअनन्यहेतुष्वथ मे गतिः स्याद् आत्यन्तिकी यत्र न मृत्युहासः॥ ३/२८/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_028/BhP_03.028.033.m4a", "display_order": 34}, {"id": 6000058034, "chapter_id": 10058, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां तृतीयस्कन्धे अष्टाविंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]