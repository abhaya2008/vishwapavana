[{"id": 2094531, "chapter_id": 3021, "verse_number": "१३-१५१-१", "content_sanskrit": "`पराशर उवाच।\nततः श्रुतिसमापन्नः संस्कृश्च यथाविधि।\nचौलोपनयनं तस्य यथावत्क्रियते द्विजैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2094532, "chapter_id": 3021, "verse_number": "१३-१५१-२", "content_sanskrit": "ततोऽष्टमे स वर्षे तु व्रतोपनयनादिभिः।\nक्रियाभिर्विधिदृष्टाभिर्ब्रह्मत्वमुपनीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2094533, "chapter_id": 3021, "verse_number": "१३-१५१-३", "content_sanskrit": "गायत्रेण छन्दसा तु संस्कृतश्चरितव्रतः।\nअधीयमानो मेधावी शुद्धात्मा नियतव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2094534, "chapter_id": 3021, "verse_number": "१३-१५१-४", "content_sanskrit": "अचिरेणैव कालेन साङ्गान्वेदानवाप्नुते।\nसमावृत्तः स धर्मात्मा समावृत्तिक्रियस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2094535, "chapter_id": 3021, "verse_number": "१३-१५१-५", "content_sanskrit": "याजनाध्यापनरतः कुशले कर्मणि स्थितः।\nअग्निहोइत्रपरो नित्यं देवतातिथिपूजकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2094536, "chapter_id": 3021, "verse_number": "१३-१५१-६", "content_sanskrit": "यजते विविधैर्यज्ञैर्जपयज्ञैस्तथैव च।\nन्यायागतधनान्वेषी न्यायवृत्तस्तपोधनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2094537, "chapter_id": 3021, "verse_number": "१३-१५१-७", "content_sanskrit": "सर्वभूतहितश्चैव सर्वशास्त्रविशारदः।\nस्वदारपरितुष्टात्मा क्रतुगामी जितेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2094538, "chapter_id": 3021, "verse_number": "१३-१५१-८", "content_sanskrit": "परापवादविरतः सत्यव्रतपरः सदा।\nस कालपरिणामात्तु संयुतः कालधर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2094539, "chapter_id": 3021, "verse_number": "१३-१५१-९", "content_sanskrit": "संस्कृतश्चाग्निहोत्रेण यथावद्विधिपूर्वकम्।\nसोमलोकमवाप्नोति देहन्यासान्न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2094540, "chapter_id": 3021, "verse_number": "१३-१५१-१०", "content_sanskrit": "तत्र सोमप्रभैर्देवैरग्निष्वात्तैश्च भास्वरैः।\nतथा बर्हिषदैश्चैव देवैराङ्गिरसैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2094541, "chapter_id": 3021, "verse_number": "१३-१५१-११", "content_sanskrit": "विश्वेभिश्चैव देवैश्च तथा ब्रह्मर्षिभिः पुनः।\nदेवर्षिभिश्चाप्रतिमैस्तथैवाप्सरसां गणैः।\nसाध्यैः सिद्धैश्च सततं सत्कृतस्तत्र मोदते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2094542, "chapter_id": 3021, "verse_number": "१३-१५१-१२", "content_sanskrit": "जातरूपमयं दिव्यमर्कतुल्यं मनोजवम्।\nदेवगन्धर्वसंकीर्णं विमानमधिरोहति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2094543, "chapter_id": 3021, "verse_number": "१३-१५१-१३", "content_sanskrit": "सौम्यरूपा मनःकान्तास्तप्तकाञ्चनभूषणाः।\nसोमकन्या विमानस्थं रमयन्ति मुदान्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2094544, "chapter_id": 3021, "verse_number": "१३-१५१-१४", "content_sanskrit": "स तत्र रमते प्रीतः सह देवैः सहर्षिभिः।\nलोकान्सर्वाननुचरन्दीप्ततेजा मनोजवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2094545, "chapter_id": 3021, "verse_number": "१३-१५१-१५", "content_sanskrit": "सभां कामजवीं चापि नित्यमेवाभिगच्छति।\nसर्वलोकेश्वरमृषिं नमस्कृत्य पितामहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2094546, "chapter_id": 3021, "verse_number": "१३-१५१-१६", "content_sanskrit": "परमेष्ठिरनन्तश्रीर्लोकानां प्रभवाप्ययः।\nयतः सर्वाः प्रवर्तन्ते सर्गप्रलयविक्रियाः।\nस तत्र वर्तते श्रीमान्द्विशतं द्विजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2094547, "chapter_id": 3021, "verse_number": "१३-१५१-१७", "content_sanskrit": "अथ कालक्षयात्तस्मात्स्थानादावर्तते पुनः।\nजातिधर्मांस्तथा सर्वान्सर्गादावर्तनानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2094548, "chapter_id": 3021, "verse_number": "१३-१५१-१८", "content_sanskrit": "अशाश्वतमिदं सवेमिति चिन्त्योपलभ्य च।\nशाश्वतं दिव्यमचलमदीनमपनर्भवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2094549, "chapter_id": 3021, "verse_number": "१३-१५१-१९", "content_sanskrit": "आस्थास्यत्यभयं नित्यं यत्रावृत्तिर्न विद्यते।\nयत्रि गत्वा न म्रियते जन्म चापि न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2094550, "chapter_id": 3021, "verse_number": "१३-१५१-२०", "content_sanskrit": "गर्भक्लेशामयाः प्राप्ता जायता च पुनः पुनः।\nकायक्लेशाश्च विविधा द्वन्द्वानि विविधानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2094551, "chapter_id": 3021, "verse_number": "१३-१५१-२१", "content_sanskrit": "शीतोष्णसुखदुःखानि ईर्ष्याद्वेषकृतानि च।\nतत्रतत्रोपभुक्तानि न क्वचिच्छाश्वती स्थितिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2094552, "chapter_id": 3021, "verse_number": "१३-१५१-२२", "content_sanskrit": "एवं स निश्चयं कृत्वा निर्मुच्यि ग्रहबन्धनात्।\nछित्त्वा भार्यामयं पाशं तथैवापत्यसम्भवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2094553, "chapter_id": 3021, "verse_number": "१३-१५१-२३", "content_sanskrit": "यतिधर्ममुपाश्रित्यि गुरुशुश्रूषणे रतः।\nअचिरेणैव कालेन श्रेयः समभिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2094554, "chapter_id": 3021, "verse_number": "१३-१५१-२४", "content_sanskrit": "योगशास्त्रं च साङ्ख्यं च विदित्वा सोऽर्थतत्वतः।\nअनुज्ञातश्च गुरुणा यथाशास्त्रमवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2094555, "chapter_id": 3021, "verse_number": "१३-१५१-२५", "content_sanskrit": "पुण्यतीर्थानुसेवी च नदीनां पुलिनाश्रयः।\nशून्यागारनिकेतश्च वनवृक्षगुहाशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2094556, "chapter_id": 3021, "verse_number": "१३-१५१-२६", "content_sanskrit": "अरण्यानुचरो नित्यं देवारण्यनिकेतनः।\nएकरात्रं द्विरात्रं वा न क्वचित्सज्जते द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2094557, "chapter_id": 3021, "verse_number": "१३-१५१-२७", "content_sanskrit": "शीर्णपर्णभुगेवापि वने चरति भिक्षुकः।\nन भोगार्थमनुप्रेत्य यात्रामात्रं समश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2094558, "chapter_id": 3021, "verse_number": "१३-१५१-२८", "content_sanskrit": "धर्मलब्धं समश्नाति न कामात्किञ्चिदश्नुते।\nयुगमात्रदृगध्वानं क्रोशादूर्ध्वं न गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2094559, "chapter_id": 3021, "verse_number": "१३-१५१-२९", "content_sanskrit": "समो मानावमानाभ्यां समलोष्टाश्मकाञ्चनः।\nसर्वभूताभयकरस्तथैवाभयदक्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2094560, "chapter_id": 3021, "verse_number": "१३-१५१-३०", "content_sanskrit": "निर्द्वन्द्वो निर्नमस्कारो निरानन्दपरिग्रहः।\nनिर्ममो निरहङ्कारः सर्वभूतनिराश्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2094561, "chapter_id": 3021, "verse_number": "१३-१५१-३१", "content_sanskrit": "परिसङ्ख्यानतत्वज्ञस्तदा सत्यरतः सदा।\nऊर्ध्वं नाधो न तिर्यक्च न किञ्चिदभिकामयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2094562, "chapter_id": 3021, "verse_number": "१३-१५१-३२", "content_sanskrit": "एवं हि रममाणस्तु यतिधर्मं यथाविधि।\nकालस्य परिणामात्तु यथा पक्वफलं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2094563, "chapter_id": 3021, "verse_number": "१३-१५१-३३", "content_sanskrit": "स विसृज्य स्वकं देहं प्रविशेद्ब्रह्म शाश्वतम्।\nनिरामयमनाद्यन्तं गुणसौम्यमचेतनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2094564, "chapter_id": 3021, "verse_number": "१३-१५१-३४", "content_sanskrit": "निरक्षरमबीजं च निरिन्द्रियमजं तथा।\nअजय्यमक्षयं यत्तदभेद्यं सूक्ष्ममेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2094565, "chapter_id": 3021, "verse_number": "१३-१५१-३५", "content_sanskrit": "निर्गुणं च प्रकृतिमन्निर्विकारं च सर्वशः।\nभूतभव्यभविष्यस्य कालस्य परमेश्वरम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2094566, "chapter_id": 3021, "verse_number": "१३-१५१-३६", "content_sanskrit": "अव्यक्तं पुरुषं क्षेत्रमानन्त्याय प्रपद्यते॥॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2094567, "chapter_id": 3021, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकपञ्चाशदधिकशततमोऽध्यायः॥ १५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]