[{"id": 2111345, "chapter_id": 3409, "verse_number": "", "content_sanskrit": "कण्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2111346, "chapter_id": 3409, "verse_number": "१", "content_sanskrit": "एवमुक्तस्तया शक्रः सन्दिदेश सदागतिम् ।\nप्रातिष्ठत ततः काले मेनका वायुना सह \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2111347, "chapter_id": 3409, "verse_number": "२", "content_sanskrit": "तथाऽपश्यद् वरारोहा तपसोग्रेण कर्शितम् ।\nविश्वामित्रं तपस्यन्तं दुर्धर्षं संशितव्रतम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2111348, "chapter_id": 3409, "verse_number": "३", "content_sanskrit": "ततोऽभिवाद्य सा तस्मै प्राक्रीडद् ऋषिसन्निधौ ।\nअपोवाह च वासोऽस्या मारुतः शशिसन्निभम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2111349, "chapter_id": 3409, "verse_number": "४", "content_sanskrit": "साऽगच्छत् त्वरिता भूमिं वासस्तदवलम्बती ।\nकुत्सयन्तीव सव्रीळं मारुतं देववर्णिनी \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2111350, "chapter_id": 3409, "verse_number": "५", "content_sanskrit": "गृध्रां वाससि सम्भ्रान्तां मेनकां मुनिसत्तमः ।\nअनिर्देश्यवयोरूपामपश्यद् विवृतां तदा \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2111351, "chapter_id": 3409, "verse_number": "६", "content_sanskrit": "तस्या रूपगुणं दृष्ट्वा कामार्तः समपद्यत ।\nचकार भावं संसर्गे तया कामवशं गतः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2111352, "chapter_id": 3409, "verse_number": "७", "content_sanskrit": "न्यमन्त्रयत चाप्येनां साप्यैच्छत् तमनिन्दिता ।\nतौ तत्र सुचिरं कालं विजह्राते महावने \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2111353, "chapter_id": 3409, "verse_number": "८", "content_sanskrit": "रममाणौ यथाकामं यथैकदिवसं तथा ।\nएवं वर्षसहस्राणामतीतं नाभ्यचिन्तयत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2111354, "chapter_id": 3409, "verse_number": "९", "content_sanskrit": "कामक्रोधावजितवान् मुनिर्नित्यं क्षमान्वितः ।\nचिरार्जितस्य तपसः क्षयं सम्प्राप्तवानृषिः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2111355, "chapter_id": 3409, "verse_number": "१०", "content_sanskrit": "तपसः सङ्क्षयादेव मुनिर्मोहं समाविशत् ।\nमोहाभिभूतः क्रोधात्मा ययौ तां कौशिकीं मुनिः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2111356, "chapter_id": 3409, "verse_number": "११", "content_sanskrit": "पादैर्जलरवं कृत्वा अन्तर्द्वीपे कुटीं गतः ।\nमेनका गन्तुकामा वै शुश्राव जलनिस्वनम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2111357, "chapter_id": 3409, "verse_number": "१२", "content_sanskrit": "तपसा दीप्तवीर्योऽसावकाशादेति याति च ।\nअद्य सञ्ज्ञां विजानामि ययाऽस्य तपसःक्षयम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2111358, "chapter_id": 3409, "verse_number": "१३", "content_sanskrit": "हन्त निर्यातमित्युक्त्वा ऋतुस्नाता तु मेनका ।\nकामरागाभिभूतस्य मुनेः पार्श्वं जगाम सा \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2111359, "chapter_id": 3409, "verse_number": "१४", "content_sanskrit": "जनयामास स मुनिर्मेनकायां शकुन्तलाम् ।\nप्रस्थे हिमवतो रम्ये मालिनीमभितो नदीम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2111360, "chapter_id": 3409, "verse_number": "१५", "content_sanskrit": "देवगर्भोपमां बालां सर्वाभरणभूषिताम् ।\nशयानां शयने रम्ये मेनका वाक्यमब्रवीत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2111361, "chapter_id": 3409, "verse_number": "१६", "content_sanskrit": "महर्षेरुग्रतपसस्तेजस्त्वमविनाशिनी ।\nतस्मात् स्वर्गं गमिष्यामि देवकार्यार्थमागता \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2111362, "chapter_id": 3409, "verse_number": "", "content_sanskrit": "कण्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2111363, "chapter_id": 3409, "verse_number": "१७", "content_sanskrit": "जातमुत्सृज्य तं गर्भं मेनका मालिनीमनु ।\nशक्रसंसदमागच्छत् कृत्वा कार्यं शचीपतेः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2111364, "chapter_id": 3409, "verse_number": "१८", "content_sanskrit": "तं वने गहने गर्भं सिंहव्याघ्रनिषेविते ।\nदृष्ट्वा शयानं शकुनाः समन्तात् पर्यवारयन् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2111365, "chapter_id": 3409, "verse_number": "१९", "content_sanskrit": "नैनां हिंस्युर्वने बालां क्रव्यादा मांसगर्धिनः ।\nइति कृत्वा स्म रक्षन्ति शकुन्ता मेनकात्मजाम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2111366, "chapter_id": 3409, "verse_number": "२०", "content_sanskrit": "उपस्प्रष्टुं गतश्चाहं तामपश्यमनिन्दिताम् ।\nनिर्जने विपिने रम्ये शकुन्तैः परिवारिताम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2111367, "chapter_id": 3409, "verse_number": "२१", "content_sanskrit": "मां दृष्ट्वैवान्वपद्यन्त पादयोः पतिता द्विजाः ।\nअब्रुवञ्शकुनाः सर्वे कलं मधुरभाषिणः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2111368, "chapter_id": 3409, "verse_number": "२२", "content_sanskrit": "विश्वामित्रसुतां ब्रह्मन् न्यासभूतां भरस्व वै ।\nकामक्रोधावजितवान् सखा ते कौशिकीं गतः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2111369, "chapter_id": 3409, "verse_number": "२३", "content_sanskrit": "तस्मात् पोषय तत्पुत्रीं दयावानिति तेऽब्रुवन् ।\nसर्वभूतरुतज्ञोऽहं दयावान् सर्वजन्तुषु \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2111370, "chapter_id": 3409, "verse_number": "२४", "content_sanskrit": "निर्जनेऽपि महारण्ये शकुन्तैः परिवारिताम् ।\nआनयित्वा ततश्चैनां दुहितृत्वे न्ययोजयम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2111371, "chapter_id": 3409, "verse_number": "२५", "content_sanskrit": "शरीरकृत् प्राणदाता यस्य चान्नानि भुञ्जते ।\nक्रमेणैते त्रयोऽप्युक्ताः पितरो धर्मसाधने\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2111372, "chapter_id": 3409, "verse_number": "२६", "content_sanskrit": "निर्जने च वने यस्माच्छकुन्तैः परिवारिता ।\nशकुन्तलेति नामास्याः कृतं चापि ततो मया \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2111373, "chapter_id": 3409, "verse_number": "२७", "content_sanskrit": "एवं दुहितरं विद्धि मम सौम्य शकुन्तलाम् ।\nशकुन्तला च पितरं मन्यते मामनिन्दिता \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2111374, "chapter_id": 3409, "verse_number": "", "content_sanskrit": "शकुन्तला", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2111375, "chapter_id": 3409, "verse_number": "२८", "content_sanskrit": "एतदाचष्ट भगवान् मम जन्म महतपाः ।\nसुतां कण्वस्य मामेवं विद्धि त्वं मनुजाधिप \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2111376, "chapter_id": 3409, "verse_number": "२९", "content_sanskrit": "कण्वं हि पितरं मन्ये पितरं स्वमजानती ।\nइति ते कथितं राजन् यथावृत्तं यथाश्रुतम् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2111377, "chapter_id": 3409, "verse_number": "८८", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nअष्टाशीतितमोऽध्यायः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2111378, "chapter_id": 3409, "verse_number": "३६", "content_sanskrit": "॥ इति सम्भवपर्वणि षट्त्रिंशोऽध्यायः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2111379, "chapter_id": 3409, "verse_number": "", "content_sanskrit": "* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]