[{"id": 2203637, "chapter_id": 5343, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2203638, "chapter_id": 5343, "verse_number": "१", "content_sanskrit": "भगवन् सर्वभूतेश शूलपाणे वृषध्वज ।\nआवासेषु विचित्रेषु रम्येषु च शुभेषु च\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2203639, "chapter_id": 5343, "verse_number": "२", "content_sanskrit": "सत्सु चान्येषु देशेषु श्मशाने रमसे कथम् ।\nकेशास्थिकलिले भीमे कपालशतसङ्कुले\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2203640, "chapter_id": 5343, "verse_number": "३", "content_sanskrit": "सृगालगृध्रसम्पूर्णे शवधूमसमाकुले ।\nचिताग्निविषमे घोरे गहने च भयानके\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2203641, "chapter_id": 5343, "verse_number": "", "content_sanskrit": "एवं कळेवरक्षेत्रे दुर्दर्शे रमसे कथम् ।\nएष मे संशयो देव तन्मे शंसितुमर्हसि\t ॥४", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2203642, "chapter_id": 5343, "verse_number": "", "content_sanskrit": "महादेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2203643, "chapter_id": 5343, "verse_number": "५", "content_sanskrit": "हन्त ते कथयिष्यामि शृणु देवि समाहिता ।\nआवासार्थं पुरा देवि शुद्धान्वेषी शुचिस्मिते\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2203644, "chapter_id": 5343, "verse_number": "६", "content_sanskrit": "नाध्यगच्छं चिरं कालं देशं शुचितमं शुभे ।\nएष मेऽभिनिवेशोऽभूत् तस्मिन् काले प्रजाः प्रति\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2203645, "chapter_id": 5343, "verse_number": "७", "content_sanskrit": "आकुलं सुमहाघोरं प्रादुरासीत् समन्ततः ।\nसम्भूता भूतसृष्टिश्च घोरा लोकभयावहा\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2203646, "chapter_id": 5343, "verse_number": "८", "content_sanskrit": "नानावर्णविरूपाश्च तीक्ष्णदंष्ट्राः प्रहारिणः ।\nपिशाचरक्षोवदनाः प्राणिनां प्राणहारिणः ।\nयतस्ततश्चरन्ति स्म निघ्नन्तः प्राणिनो भृशम्\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2203647, "chapter_id": 5343, "verse_number": "९", "content_sanskrit": "एवं लोके क्षयं याते प्राणिहीने पितामहः ।\nचिन्तयंस्तत्प्रतीकारं मां च शक्तं हि निग्रहे\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2203648, "chapter_id": 5343, "verse_number": "१०", "content_sanskrit": "एवं ज्ञात्वा ततो ब्रह्मा तस्मिन् कर्मण्योजयत् ।\nतच्च प्राणिदयार्थं तु मयाऽप्यनुमतं प्रिये\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2203649, "chapter_id": 5343, "verse_number": "११", "content_sanskrit": "तस्मात्संरक्षिता देवि भूतेभ्यः प्राणिनो भयात् ।\nअस्मात् श्मशानान्मेध्यं तु नास्ति किञ्चिदनिन्दिते ।\nनिःसम्पातं मनुष्याणां तस्माच्छुचितमं स्मृतम्\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2203650, "chapter_id": 5343, "verse_number": "१२", "content_sanskrit": "भूतसृष्टिं च तां चाहं श्मशाने सन्न्यवेशयम् ।\nतत्रस्थः सर्वलोकानां विनिहन्मि प्रिये भयम्\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2203651, "chapter_id": 5343, "verse_number": "१३", "content_sanskrit": "न च भूतगणेनाहं विना वसितुमुत्सहे ।\nतस्मान्मे सन्निवासाय श्मशाने रोचते मनः\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2203652, "chapter_id": 5343, "verse_number": "१४", "content_sanskrit": "मेध्यकामैर्द्विजैनित्यं मेध्यमित्यभिधीयते ।\nआचरद्भिर्व्रतं नित्यं मोक्षकामैश्च सेव्यते\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2203653, "chapter_id": 5343, "verse_number": "१५", "content_sanskrit": "स्थानं मे तत्र विहितं वीरस्थानमिति प्रिये ।\nकपालशतसम्पूर्णं भीमरूपं भयानकम्\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2203654, "chapter_id": 5343, "verse_number": "१६", "content_sanskrit": "मध्याह्ने सन्ध्ययोस्तत्र नक्षत्रे रुद्रदैवते ।\nआयुष्कामैरशुद्धैर्वा न गन्तव्यमिति स्थितिः\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2203655, "chapter_id": 5343, "verse_number": "१७", "content_sanskrit": "मदन्येन न शक्यं हि निहन्तुं भूतजं भयम् ।\nतत्रस्थोऽहं प्रजाः सर्वाः पालयामि दिनेदिने\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2203656, "chapter_id": 5343, "verse_number": "१८", "content_sanskrit": "मन्नियोगाद् भूतसङ्घा न च घ्नन्तीह किञ्चन ।\nतस्माल्लोकहितार्ताय श्मशाने रमयाम्यहम् ।\nएतत्ते सर्वमाख्यातं किं भूयः श्रोतुमिच्छसि\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2203657, "chapter_id": 5343, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2203658, "chapter_id": 5343, "verse_number": "१९", "content_sanskrit": "भगवन् देवदेवेश त्रिनेत्र वृषभध्वज ।\nपिङ्गलं विकृतं भाति रूपं ते तु भयानकम्\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2203659, "chapter_id": 5343, "verse_number": "२०", "content_sanskrit": "भस्मदिग्धं विरूपाक्षं तीक्ष्णदंष्ट्रं जटाकुलम् ।\nव्याघ्रोरगत्वक्संवीतं कपिलश्मश्रुसन्ततम्\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2203660, "chapter_id": 5343, "verse_number": "२१", "content_sanskrit": "रौद्रं भयानकं घोरं शूलपट्टससंयुतम् ।\nकिमर्थमीदृशं रूपं तन्मे शंसितुमर्हसि\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2203661, "chapter_id": 5343, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2203662, "chapter_id": 5343, "verse_number": "२२", "content_sanskrit": "तदहं कथयिष्यामि शृणु तत्त्वं समाहिता ।\nद्विविधो लौकिको भावः शीतमुष्णमिति प्रिये\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2203663, "chapter_id": 5343, "verse_number": "२३", "content_sanskrit": "तयोर्विग्रथितं सर्वं सौम्याग्नेयमिदं जगत्\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2203664, "chapter_id": 5343, "verse_number": "२४", "content_sanskrit": "सौम्यत्वं सततं विष्णौ मय्याग्नेयं प्रतिष्ठितम् ।\nअनेन वपुषा नित्यं सर्वलोकान् बिभर्म्यहम्\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2203665, "chapter_id": 5343, "verse_number": "२५", "content_sanskrit": "रौद्राकृति विरूपाक्षं शूलपट्टससंयुतम् ।\nआग्नेयमिति मे रूपं देवि लोकहिते रतम्\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2203666, "chapter_id": 5343, "verse_number": "२६", "content_sanskrit": "यद्यहं विपरीतः स्यामेतत् त्यक्त्वा शुभानने ।\nतदैव सर्वलोकानां विपरीतं प्रवर्तते\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2203667, "chapter_id": 5343, "verse_number": "", "content_sanskrit": "तस्मान्मयेदं ध्रियते रूपं लोकहितैषिणा ।\nइति ते कथितं देवि किं भूयः श्रोतुमिच्छसि\t ॥२७", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2203668, "chapter_id": 5343, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2203669, "chapter_id": 5343, "verse_number": "", "content_sanskrit": "भगवन् देवदेवेश शूलपाणे वृषध्वज ।\nकिमर्थं चन्द्ररेखा ते शिरोभागे विरोचते ।\nश्रोतुमिच्छाम्यहं देव तन्मे शंसितुमर्हसि\t ॥२८", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2203670, "chapter_id": 5343, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2203671, "chapter_id": 5343, "verse_number": "२९", "content_sanskrit": "तदहं ते प्रवक्ष्यामि शृणु कल्याणि कारणम् ।\nपुराऽहं कारणाद् देवि कोपयुक्तः शुचिस्मिते ।\nदक्षयज्ञवधार्याय भूतसङ्घसमावृतः\t ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2203672, "chapter_id": 5343, "verse_number": "३०", "content_sanskrit": "तस्मिन् क्रतुवधे घोरे यज्ञभागनिमित्ततः ।\nदेवा विभ्रंशितास्ते वै येषां भागः क्रतौ कृतः\t ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2203673, "chapter_id": 5343, "verse_number": "३१", "content_sanskrit": "सोमस्तत्र मया देवि कुपितेन भृशार्दितः ।\nपश्यंश्चानपराधी सन् पादङ्गुष्ठेन ताडितः\t ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2203674, "chapter_id": 5343, "verse_number": "३२", "content_sanskrit": "तथापि विनिकृतेनाहं सामपूर्वं प्रसादितः ।\nतन्मे चिन्तयतश्चासीत् पश्चात्तापः पुरा प्रिये\t ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2203675, "chapter_id": 5343, "verse_number": "३३", "content_sanskrit": "तदाप्रभृति सोमं वै शिरसा धारयाम्यम् ।\nएवं मे पापहानिस्तु भवेदिति मतिर्मम ।\nतदाप्रभृति वै सोमो मूर्ध्नि सन्दृश्यते सदा\t ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2203676, "chapter_id": 5343, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2203677, "chapter_id": 5343, "verse_number": "३४", "content_sanskrit": "एवं ब्रुवति देवेशे विस्मिताः परमर्षयः ।\nवाग्भिः साञ्जलिमालाभिरभितुष्टुवुरीश्वरम्\t ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2203678, "chapter_id": 5343, "verse_number": "३५", "content_sanskrit": "नमः शङ्कर सर्वेश नमः सर्वजगद्भुरो ।\nनमो देवादिदेवाय नमः शशिकलाधर\t ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2203679, "chapter_id": 5343, "verse_number": "३६", "content_sanskrit": "नमो घोरतराद्धोर नमो रुद्र भयङ्कर ।\nनमः शान्ततराच्छान्त नमश्चन्द्रस्य पालक\t ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2203680, "chapter_id": 5343, "verse_number": "३७", "content_sanskrit": "नमः सोमाय देवाय नमस्तुभ्यं चतुर्मुख ।\nनमो भूतपते शम्भो जह्नुकन्याम्बुशेखर\t ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2203681, "chapter_id": 5343, "verse_number": "३८", "content_sanskrit": "नमस्त्रिशूलहस्ताय पन्नगाभरणाय च ।\nनमोस्तु विषमाक्षाय दक्षयज्ञप्रदाहक\t ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2203682, "chapter_id": 5343, "verse_number": "३९", "content_sanskrit": "नमोस्तु बहुनेत्राय लोकरक्षणतत्पर ।\nअहो देवस्य माहात्म्यं महादेवस्य वै कृपा ।\nएवं धर्मपरत्वं च देवदेवस्य चार्हति\t ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2203683, "chapter_id": 5343, "verse_number": "", "content_sanskrit": "एवं ब्रुवत्सु मुनिषु वचो देव्यब्रवीद् हरम् ।\nप्रीत्यर्थं च मुनीनां सा क्षणज्ञा परमं हितम्\t ॥४०", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2203684, "chapter_id": 5343, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2203685, "chapter_id": 5343, "verse_number": "४१", "content_sanskrit": "भगवन् देवदेवेश सर्वलोकनमस्कृत ।\nअस्य वै ऋषिसङ्घस्य मम च प्रियकाम्यया\t ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2203686, "chapter_id": 5343, "verse_number": "४२", "content_sanskrit": "वर्णाश्रमकृतं धर्मं वक्तुमर्हस्यशेषतः ।\nन तृप्तिरस्ति देवेश श्रवणीयं हि ते वचः\t ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2203687, "chapter_id": 5343, "verse_number": "४३", "content_sanskrit": "सधर्मचारिणी चेयं भक्ता चेयमिति प्रभो ।\nवक्तुमर्हसि देवेश लोकानां हितकाम्यया ।\nयाथातथ्येन तत्सर्वं वक्तुमर्हसि शङ्कर\t ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2203688, "chapter_id": 5343, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे रौद्ररूपनिमित्तकथनं नाम चतुर्नवत्युत्तरशततमोऽध्यायः ॥१९४॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]