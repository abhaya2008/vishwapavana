[{"id": 900004291, "chapter_id": 8333, "verse_number": "9.1", "content_sanskrit": "प्रत्यक्षं सप्तविधम् साक्षिषडिन्द्रियभेदेन", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900004292, "chapter_id": 8333, "verse_number": "9.2", "content_sanskrit": "द्विविधमिन्द्रियम् । प्रमातृस्वरूपं तदतिरिक्तञ्चेति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900004293, "chapter_id": 8333, "verse_number": "9.3", "content_sanskrit": "अस्वरूपं च षड्विधम् । श्रोत्रत्वक्चक्षुर्जिह्वाघ्राणमनो-भेदात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900004294, "chapter_id": 8333, "verse_number": "9.4", "content_sanskrit": "निर्विकल्पकसविकल्पकभेदात् द्विविधं प्रत्यक्षमित्येके", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900004295, "chapter_id": 8333, "verse_number": "9.5", "content_sanskrit": "निर्विकल्पकमेव प्रत्यक्षमित्यपरे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900004296, "chapter_id": 8333, "verse_number": "9.6", "content_sanskrit": "तदेतदयुक्तम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900004297, "chapter_id": 8333, "verse_number": "9.7", "content_sanskrit": "एतेनैतदपि निरस्तम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900004298, "chapter_id": 8333, "verse_number": "9.8", "content_sanskrit": "मानसप्रत्यक्षजा स्मृतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900004299, "chapter_id": 8333, "verse_number": "9.9", "content_sanskrit": "स्मृतिः केवलप्रमाणमेव न भवति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900004300, "chapter_id": 8333, "verse_number": "9.10", "content_sanskrit": "न हि गृहीतग्राहित्वेन स्मृतेरनुवादस्य चाप्रामाण्यं वाच्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900004301, "chapter_id": 8333, "verse_number": "9.11", "content_sanskrit": "अन्यस्त्वाह । न स्मृतिः प्रमाणम् अयथार्थत्वात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900004302, "chapter_id": 8333, "verse_number": "9.12", "content_sanskrit": "न च वाच्यम् न निवृत्तपूर्वावस्थतया स्मृतिरर्थं विषयीकर्तुमीष्टे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900004303, "chapter_id": 8333, "verse_number": "9.13", "content_sanskrit": "अहानेश्च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900004304, "chapter_id": 8333, "verse_number": "9.14", "content_sanskrit": "एतेनैव ‘तर्को न प्रमाणम् किं तु ? प्रमाणानामनुग्राहकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900004305, "chapter_id": 8333, "verse_number": "9.15", "content_sanskrit": "विरोधो मानस्ववाक्याभ्याम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900004306, "chapter_id": 8333, "verse_number": "9.16", "content_sanskrit": "स्ववाक्यविरोधोऽपसिद्धान्तजातिरूपेण", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]