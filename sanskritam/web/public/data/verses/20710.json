[{"id": 7000710000, "chapter_id": 20710, "verse_number": "६-५३-१", "content_sanskrit": "युधिष्ठिर उवाच ।\nआषाढस्य सिते पक्षे का च एकादशी भवेत् ।\nकिं नाम को विधिस्तस्या एतद्विस्तरतो वद ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000710001, "chapter_id": 20710, "verse_number": "६-५३-२", "content_sanskrit": "श्रीकृष्ण उवाच ।\nकथयामि महापुण्यां स्वर्गमोक्षप्रदायिनीम् ।\nशयनीं नामनामेति सर्वपापहरां पराम् ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000710002, "chapter_id": 20710, "verse_number": "६-५३-३", "content_sanskrit": "यस्याः श्रवणमात्रेण वाजपेयफलं लभेत् ।\nसत्यं सत्यं मया प्रोक्तं नातः परतरं नृणाम् ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000710003, "chapter_id": 20710, "verse_number": "६-५३-४", "content_sanskrit": "पापिनां पापनाशाय सृष्टा धात्रा महोत्तमा ।\nअतः परा न राजेंद्र वर्त्तते मोक्षदायिनी ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000710004, "chapter_id": 20710, "verse_number": "६-५३-५", "content_sanskrit": "एतस्मात्कारणाद्राजन्श्रूयतां गतिरुत्तमा ।\nभवेन्नराणां श्रोतॄणां कथायाः श्रवणादपि ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000710005, "chapter_id": 20710, "verse_number": "६-५३-६", "content_sanskrit": "ते सदा वैष्णवा राजन्मम भक्तिपरायणाः ।\nआषाढे वामनश्चैव पूज्यते परमेश्वरः ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000710006, "chapter_id": 20710, "verse_number": "६-५३-७", "content_sanskrit": "वामनः पूजितो येन कमलैः कमलेक्षणः ।\nआषाढस्य सिते पक्षे कामिकाया दिने तथा ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000710007, "chapter_id": 20710, "verse_number": "६-५३-८", "content_sanskrit": "तेनार्चितं जगत्सर्वं त्रयो देवाः सनातनाः ।\nकृता चैकादशी येन हरिवासरमुत्तमम् ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000710008, "chapter_id": 20710, "verse_number": "६-५३-९", "content_sanskrit": "युधिष्ठिर उवाच ।\nसंशयोऽस्ति महान्मेऽत्र श्रूयतां पुरुषोत्तम ।\nकथं सुप्तोऽसि देवेश कथं च बलिमाश्रितः ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000710009, "chapter_id": 20710, "verse_number": "६-५३-१०", "content_sanskrit": "कथं च भूमौ संवेशः किं कुर्वंति जनाः परे ।\nएतद्वद महाप्राज्ञ संशयोऽस्ति महान्मम ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000710010, "chapter_id": 20710, "verse_number": "६-५३-११", "content_sanskrit": "श्रीकृष्ण उवाच ।\nश्रूयतां राजशार्दूल कथां पापहरां पराम् ।\nयस्याः श्रवणमात्रेण सर्वपापक्षयो भवेत् ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000710011, "chapter_id": 20710, "verse_number": "६-५३-१२", "content_sanskrit": "बलिनामा पूर्वमासीद्दैत्यस्त्रेतायुगे नृप ।\nपूजयंश्चैव मां नित्यं मद्भक्तो मत्परायणः ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000710012, "chapter_id": 20710, "verse_number": "६-५३-१३", "content_sanskrit": "यज्ञैस्तु विधिवद्दैत्यो यजते मां सनातनम् ।\nभक्त्या च परया राजन्यज्ञकृद्व्रतकृत्तथा ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000710013, "chapter_id": 20710, "verse_number": "६-५३-१४", "content_sanskrit": "परं विचार्य बहुधा मघोना चैव सूक्तिभिः ।\nगुरुणा दैवतैः सार्द्धं बहुधा पूजितोऽप्यहम् ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000710014, "chapter_id": 20710, "verse_number": "६-५३-१५", "content_sanskrit": "ततो वामनरूपेण अवतारे च पंचमे ।\nअत्युग्ररूपेण तदा सर्वब्रह्मांडरूपिणा ॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000710015, "chapter_id": 20710, "verse_number": "६-५३-१६", "content_sanskrit": "वाक्छलेन जिता दैत्याः सत्यमाश्रित्य संस्थितः ।\nशुक्रस्तं वारयामास यन्नारायण इत्ययम् ॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000710016, "chapter_id": 20710, "verse_number": "६-५३-१७", "content_sanskrit": "याचिता वसुधा राजन्सार्द्धत्रयपदी मया ।\nसंकल्पोदकमात्रे तु करे तेनैव चार्पिते ॥१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000710017, "chapter_id": 20710, "verse_number": "६-५३-१८", "content_sanskrit": "रूपमीदृग्विधं राजंस्तदा शृणु मया कृतम् ।\nभूर्लोके चरणौ न्यस्य भुवर्लोके तु जानुनी ॥१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000710018, "chapter_id": 20710, "verse_number": "६-५३-१९", "content_sanskrit": "स्वर्लोके च कटिं न्यस्य महर्लोके तथोदरम् ।\nजनलोके च हृदयं तपोलोके तु कंठकम् ॥१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000710019, "chapter_id": 20710, "verse_number": "६-५३-२०", "content_sanskrit": "सत्यलोके मुखं स्थाप्य मस्तकं च तदूर्द्ध्वकम् ।\nचंद्रसूर्यग्रहाश्चैव नक्षत्राणि तथैव च ॥२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000710020, "chapter_id": 20710, "verse_number": "६-५३-२१", "content_sanskrit": "देवाः सेंद्राश्च नागाश्च यक्षगंधर्वकिन्नराः ।\nस्तुवंतो वेदसंभूतैः सूक्तैश्च विविधैस्तथा ॥२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000710021, "chapter_id": 20710, "verse_number": "६-५३-२२", "content_sanskrit": "करे गृहीत्वा च बलिं त्रिपदैः पूरिता मही ।\nअर्द्धं च तस्य पृष्ठे च पदं न्यस्तं मया तदा ॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000710022, "chapter_id": 20710, "verse_number": "६-५३-२३", "content_sanskrit": "गतो रसातलं राजन्दानवो मम पूजकः ।\nक्षिप्तोऽधो दानवश्चैव किमकुर्वं ततः परम् ॥२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000710023, "chapter_id": 20710, "verse_number": "६-५३-२४", "content_sanskrit": "विनयेनानतोसौ वै सुप्रसन्नो जनार्दनः ।\nआषाढशुक्लपक्षे तु कामिका हरिवासरः ॥२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000710024, "chapter_id": 20710, "verse_number": "६-५३-२५", "content_sanskrit": "तस्यामेका च मूर्तिर्मे बलिमाश्रित्य तिष्ठति ।\nद्वितीया शेषपृष्ठे वै क्षीरसागरमध्यतः ॥२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000710025, "chapter_id": 20710, "verse_number": "६-५३-२६", "content_sanskrit": "स्वपित्येव महाराज यावदागामि कार्तिकी ।\nतावद्भवेत्सुधर्मात्मा सर्वधर्मोत्तमोत्तमः ॥२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000710026, "chapter_id": 20710, "verse_number": "६-५३-२७", "content_sanskrit": "व्रतं च कुरुते मर्त्यः स याति परमां गतिम् ।\nएतस्मात्कारणाद्राजन्कर्त्तव्या च प्रयत्नतः ॥२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000710027, "chapter_id": 20710, "verse_number": "६-५३-२८", "content_sanskrit": "नातः परतरा काचित्पवित्रा पापनाशिनी ।\nयस्यां स्वपिति देवेशः शंखचक्रगदाधरः ॥२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000710028, "chapter_id": 20710, "verse_number": "६-५३-२९", "content_sanskrit": "तस्यां च पूजयेद्देवं शंखचक्रगदाधरम् ।\nरात्रौ जागरणं कृत्वा भक्त्या चैव विशेषतः ॥२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000710029, "chapter_id": 20710, "verse_number": "६-५३-३०", "content_sanskrit": "नास्याः पुण्यस्य संख्यानं कर्तुं शक्तश्चतुर्मुखः ।\nएवं यः कुरुते राजन्नेकादश्या व्रतोत्तमम् ॥३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000710030, "chapter_id": 20710, "verse_number": "६-५३-३१", "content_sanskrit": "सर्वपापहरं चैव भुक्तिमुक्तिप्रदायकम् ।\nस च लोके मम सदा श्वपचोऽपि प्रियंकरः ॥३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000710031, "chapter_id": 20710, "verse_number": "६-५३-३२", "content_sanskrit": "दीपदानेन पालाशपत्रे भुक्त्या व्रतेन च ।\nचातुर्मास्यं नयंतीह ते नरा मम वल्लभाः ॥३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000710032, "chapter_id": 20710, "verse_number": "६-५३-३३", "content_sanskrit": "चातुर्मास्ये हरौ सुप्ते भूमिशायी भवेन्नरः ।\nश्रावणे वर्जयेच्छाकं दधि भाद्रपदे तथा ॥३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000710033, "chapter_id": 20710, "verse_number": "६-५३-३४", "content_sanskrit": "दुग्धमाश्वयुजि त्याज्यं कार्तिके द्विदलं त्यजेत् ।\nअथवा ब्रह्मचर्यस्थः स याति परमां गतिम् ॥३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000710034, "chapter_id": 20710, "verse_number": "६-५३-३५", "content_sanskrit": "एकादश्या व्रतेनैव पुमान्पापैर्विमुच्यते ।\nकर्तव्या सर्वदा राजन्विस्मर्तव्या न कर्हिचित् ॥३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000710035, "chapter_id": 20710, "verse_number": "६-५३-३६", "content_sanskrit": "शयनी बोधिनी मध्ये या कृष्णैकादशीभवेत् ।\nसैवोपोष्या गृहस्थस्य नान्या कृष्णा कदाचन ॥३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000710036, "chapter_id": 20710, "verse_number": "६-५३-३७", "content_sanskrit": "शृणुयाच्चैव यो राजन्कथां पापहरां पराम् ।\nअश्वमेधस्य यज्ञस्य फलं प्राप्नोति मानवः ॥३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]