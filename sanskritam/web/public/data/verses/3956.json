[{"id": 2136384, "chapter_id": 3956, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2136385, "chapter_id": 3956, "verse_number": "१", "content_sanskrit": "ततस्तत्रैव रामस्य समासीनस्य तैः सह ।\nसमाजग्मुः कपिश्रेष्ठाः सुग्रीववचनात् तदा \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2136386, "chapter_id": 3956, "verse_number": "२", "content_sanskrit": "वृतः कोटिसहस्रेण वानराणां तरस्विनाम् ।\nश्वशुरो वालिनः श्रीमान् सुषेणो राममभ्ययात् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2136387, "chapter_id": 3956, "verse_number": "३", "content_sanskrit": "कोटीशतवृतो वापि गजो गवय एव च ।\nवानरेन्द्रौ महावीर्यौ पृथक्पृथगदृश्यताम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2136388, "chapter_id": 3956, "verse_number": "४", "content_sanskrit": "षष्टिकोटिसहस्राणि प्रकर्षन् प्रत्यदृश्यत ।\nगोलाङ्गूलो महाराज गवाक्षो भीमदर्शनः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2136389, "chapter_id": 3956, "verse_number": "५", "content_sanskrit": "गन्धमादनवासी तु प्रथितो गन्धमादनः ।\nकोटीशतसहस्राणि हरीणां समकर्षत \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2136390, "chapter_id": 3956, "verse_number": "६", "content_sanskrit": "पनसो नाम मेधावी वानरः सुमहाबलः ।\nकोटीर्दश द्वादश च त्रिशंत्पञ्च प्रकर्षति \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2136391, "chapter_id": 3956, "verse_number": "७", "content_sanskrit": "श्रीमान् दधिमुखो नाम हरिवृद्धोऽतिवीर्यवान् ।\nप्रचकर्ष महासैन्यं हरीणां भीमतेजसाम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2136392, "chapter_id": 3956, "verse_number": "८", "content_sanskrit": "कृष्णानां मुखपुण्ड्राणामृक्षाणां भीमकर्मणाम् ।\nकोटीशतसहस्रेण जाम्बवान्प्रत्यदृश्यत \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2136393, "chapter_id": 3956, "verse_number": "९", "content_sanskrit": "एते चान्ये च बहवो हरियूथपयूथपाः ।\nअसङ्ख्येया महाराज समीयू रामकारणात् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2136394, "chapter_id": 3956, "verse_number": "१०", "content_sanskrit": "गिरिकूटनिभाङ्गानां सिंहानामिव गर्जताम् ।\nश्रूयते तुमुलः शब्दस्तत्र तत्र प्रधावताम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2136395, "chapter_id": 3956, "verse_number": "११", "content_sanskrit": "गिरिकूटनिभाः केचित् केचिन्महिषसन्निभाः ।\nशरदभ्रप्रतीकाशाः पिष्टहिङ्गुलिकाननाः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2136396, "chapter_id": 3956, "verse_number": "१२", "content_sanskrit": "उत्पतन्तः पतन्तश्च प्लवमानाश्च वानराः।\nउद्धून्वन्तोऽपरे रेणून् समाजग्मुः समन्ततः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2136397, "chapter_id": 3956, "verse_number": "१३", "content_sanskrit": "स वानरमहासङ्ग पूर्णसागरसन्निभः ।\nनिवेशमकरोत् तत्र सुग्रीवानुमते तदा \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2136398, "chapter_id": 3956, "verse_number": "१४", "content_sanskrit": "ततस्तेषु हरीन्द्रेषु समावृत्तेषु सर्वशः ।\nतिथौ प्रशस्ते नक्षत्रे मुहूर्ते चाभिपूजिते \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2136399, "chapter_id": 3956, "verse_number": "१५", "content_sanskrit": "तेन व्यूढेन सैन्येन लोकानुद्वर्तयन्निव ।\nप्रययौ राघवः श्रीमान् सुग्रीवसहितस्तदा \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2136400, "chapter_id": 3956, "verse_number": "१६", "content_sanskrit": "मुखमासीत्तु सैन्यस्य हनूमान् मारुतात्मजः।\nजघनं पालयामास सौमित्रिरकुतोभयः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2136401, "chapter_id": 3956, "verse_number": "१७", "content_sanskrit": "बद्धगोधाङ्गुलित्राणौ राघवौ तत्र जग्मतुः ।\nवृतौ हरिमहामात्रैश्चन्द्रसूर्यौ ग्रहैरिव \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2136402, "chapter_id": 3956, "verse_number": "१८", "content_sanskrit": "प्रभभौ हरिसैन्यं तत्सालतालशिलायुधम् ।\nसुमहच्छालिभवनं यथा सूर्योदयं प्रति \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2136403, "chapter_id": 3956, "verse_number": "१९", "content_sanskrit": "नलनीलाङ्गदक्राथमैन्दद्विविदपालिता ।\nययौ सुमहती सेना राघवस्यार्थसिद्धये \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2136404, "chapter_id": 3956, "verse_number": "२०", "content_sanskrit": "विविधेषु वनेष्वेव(प्रशस्तेषु) बहुमूलफलेषु च ।\nप्रभूतमधुमूलेषु वारिमत्सु शिवेषु च \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2136405, "chapter_id": 3956, "verse_number": "२१", "content_sanskrit": "निवसन्ती निराबाधा तथैव गिरिसानुषु ।\nउपायाद् हरिसेना सा क्षी(क्षा)रोदमथ सागरम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2136406, "chapter_id": 3956, "verse_number": "२२", "content_sanskrit": "द्वितीयसागरनिभं तद्बलं बहुलध्वजम् ।\nवेलावनं समासाद्य निवासमकरोत् तदा \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2136407, "chapter_id": 3956, "verse_number": "२३", "content_sanskrit": "ततो दाशरथिः श्रीमान् सुग्रीवं प्रत्यभाषत ।\nमध्ये वानरमुख्यानां प्राप्तकालमिदं वचः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2136408, "chapter_id": 3956, "verse_number": "", "content_sanskrit": "श्रीरामः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2136409, "chapter_id": 3956, "verse_number": "२४", "content_sanskrit": "उपायः को नु भवतां मतः सागरलङ्घने ।\nइयं हि महती सेना सागरश्चातिदुस्तरः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2136410, "chapter_id": 3956, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2136411, "chapter_id": 3956, "verse_number": "२५", "content_sanskrit": "तत्रान्ये व्याहरन्ति स्म वानरा बहुमानिनः ।\nसमर्था लङ्घने सिन्धोर्न तु तत्कृत्स्नकारकम् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2136412, "chapter_id": 3956, "verse_number": "२६", "content_sanskrit": "केचिन्नौभिर्व्यवस्यन्ति केचिच्च विविधैः प्लवैः ।\nनेति रामस्तु तान् सर्वान् सान्त्वयन् प्रत्यभाषत \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2136413, "chapter_id": 3956, "verse_number": "", "content_sanskrit": "श्रीरामः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2136414, "chapter_id": 3956, "verse_number": "२७", "content_sanskrit": "शतयोजनविस्तारं न शक्ताः सर्ववानराः ।\nक्रान्तुं तोयनिधिं वीरा नैषा वो नैष्ठिकी मतिः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2136415, "chapter_id": 3956, "verse_number": "२८", "content_sanskrit": "नावो न सन्ति सेनाया बह्व्यस्तारयितुं तथा ।\nवणिजामुपघातं च कथमस्मद्विधश्चरेत् \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2136416, "chapter_id": 3956, "verse_number": "२९", "content_sanskrit": "विस्तीर्णं चैव नः सैन्यं हन्याच्छिद्रेण वै परः ।\nप्लवोडुपप्रतारश्च नैवात्र मम रोचते \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2136417, "chapter_id": 3956, "verse_number": "३०", "content_sanskrit": "अहं त्विमं जलनिधिं समारप्स्याम्भुपायतः ।\nप्रतिशेष्याम्युपवसन् दर्शयिष्यति मां ततः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2136418, "chapter_id": 3956, "verse_number": "३१", "content_sanskrit": "न चेद् दर्शयिता मार्गं धक्ष्याम्येनमहं ततः ।\nमहास्त्रैरप्रतिहतैरत्यग्निपवनोज्ज्वलैः \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2136419, "chapter_id": 3956, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2136420, "chapter_id": 3956, "verse_number": "३२", "content_sanskrit": "इत्युक्त्वा सह सौमित्रिरुपस्पृश्याथ राघवः ।\nप्रतिशिश्ये जलनिधिं विधिवत् कुशसंस्तरे \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2136421, "chapter_id": 3956, "verse_number": "३३", "content_sanskrit": "सागरस्तु ततः स्वप्ने दर्शयामास राघवम्।\nदेवो नदनदीभर्ता श्रीमान् यादोगणैर्वृतः \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2136422, "chapter_id": 3956, "verse_number": "३४", "content_sanskrit": "कौसल्यामातरित्येवमाभाष्य मधुरं वचः ।\nइदमित्याह रत्नानामाकारैः शतशो वृतः \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2136423, "chapter_id": 3956, "verse_number": "", "content_sanskrit": "सागरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2136424, "chapter_id": 3956, "verse_number": "३५", "content_sanskrit": "ब्रूहि किं ते करोम्यत्र साहाय्यं पुरुषर्षभ ।\nऐक्ष्वाकोरस्मि ते ज्ञातिरिति रामस्तमब्रवीत् ।\nएवमुक्तः समुद्रेण रामो वाक्यमथाब्रवित् \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2136425, "chapter_id": 3956, "verse_number": "", "content_sanskrit": "श्रीरामः-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2136426, "chapter_id": 3956, "verse_number": "३६", "content_sanskrit": "मार्गमिच्छामि सैन्यस्य दत्तं नदनदीपते \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2136427, "chapter_id": 3956, "verse_number": "३७", "content_sanskrit": "येन गत्वा दशग्रीवं हन्यां पौलस्त्यपांसनम् ।\nराक्षसं सानुबन्धं तु मम भार्यापहारिणम् \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2136428, "chapter_id": 3956, "verse_number": "३८", "content_sanskrit": "यद्येवं याचतो मार्गं न प्रदास्यति मे भवान् ।\nशरैस्त्वां शोषयिष्यामि दिव्यास्त्रप्रतिमन्त्रितैः \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2136429, "chapter_id": 3956, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2136430, "chapter_id": 3956, "verse_number": "३९", "content_sanskrit": "इत्येवं ब्रुवतः श्रुत्वा रामस्य वरुणालयः ।\nउवाच व्यथितो वाक्यमिति बद्धाञ्जलिः स्थितः \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2136431, "chapter_id": 3956, "verse_number": "", "content_sanskrit": "सागरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2136432, "chapter_id": 3956, "verse_number": "४०", "content_sanskrit": "नेच्छामि प्रतिघातं ते नास्मि विघ्नकरस्तव ।\nशृणु चेदं वचो राम श्रुत्वा कर्तव्यमाचर \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2136433, "chapter_id": 3956, "verse_number": "४१", "content_sanskrit": "यदि दास्यामि ते मार्गं सैन्यस्य व्रजतोऽऽज्ञया ।\nअन्येऽप्याज्ञापयिष्यन्ति मामेवं धनुषो बलात् \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2136434, "chapter_id": 3956, "verse_number": "४२", "content_sanskrit": "अस्ति त्वत्र नलो नाम वानरः शिल्पिसम्मतः ।\nत्वष्टुर्देवस्य तनयो बलवान् विश्वकर्मणः \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2136435, "chapter_id": 3956, "verse_number": "४३", "content_sanskrit": "स यत्काष्ठं तृणं वापि शिलां वा क्षेप्स्यते मयि ।\nसर्वं तद्धारयिष्यामि स ते सेतुर्भविष्यति \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2136436, "chapter_id": 3956, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2136437, "chapter_id": 3956, "verse_number": "", "content_sanskrit": "इत्युक्त्वान्तर्हिते तस्मिन् रामो नलमुवाच ह ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2136438, "chapter_id": 3956, "verse_number": "", "content_sanskrit": "श्रीरामः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2136439, "chapter_id": 3956, "verse_number": "४४", "content_sanskrit": "कुरु सेतुं समुद्रे त्वं शक्तो ह्यसि मतो मम \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2136440, "chapter_id": 3956, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2136441, "chapter_id": 3956, "verse_number": "४५", "content_sanskrit": "तेनोपायेन काकुत्स्थः सेतुबन्धमकारयत् ।\nदशयोजनविस्तारमायतं शतयोजनम् \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2136442, "chapter_id": 3956, "verse_number": "४६", "content_sanskrit": "नलसेतुरिति ख्यातो योऽद्यापि प्रथितो भुवि ।\nरामस्याज्ञां पुरस्कृत्य धार्यते गिरिसंनिभः \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2136443, "chapter_id": 3956, "verse_number": "४७", "content_sanskrit": "तत्रस्थं स तु धर्मात्मा समागच्छद् विभीषणः ।\nभ्राता वै राक्षसेन्द्रस्य चतुर्भिः सचिवैः सह \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2136444, "chapter_id": 3956, "verse_number": "४८", "content_sanskrit": "प्रतिजग्राह रामस्तं स्वागतेन महामनाः ।\nसुग्रीवस्य तु शङ्काऽभूत् प्रणिधिः स्यादिति स्म ह \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2136445, "chapter_id": 3956, "verse_number": "४९", "content_sanskrit": "राघवः सत्यचेष्टाभिः सम्यक्च चरितेङ्गितैः ।\nयदा तत्त्वेन तुष्टोऽभूत् तत एनमपूजयत् \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2136446, "chapter_id": 3956, "verse_number": "५०", "content_sanskrit": "सर्वराक्षसराज्ये चाप्यभ्यषिञ्चद् विभीषणम् ।\nचक्रे च मन्त्रिप्रवरं(न्त्रसचिवं) सुहृदं लक्ष्मणस्य च ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2136447, "chapter_id": 3956, "verse_number": "५१", "content_sanskrit": "विभीषणमते चैव सोऽत्यक्रामन्महार्णवम् ।\nससैन्यः सेतुना तेन मासेनैव नराधिप \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2136448, "chapter_id": 3956, "verse_number": "५२", "content_sanskrit": "ततो गत्वा समासाद्य लङ्कोद्यानान्यनेकशः ।\nभेदयामास कपिभिर्महान्ति च बहूनि च \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2136449, "chapter_id": 3956, "verse_number": "५३", "content_sanskrit": "ततस्तौ रावणामात्यौ मन्त्रिणौ शुकसारणौ ।\nचारौ वानररूपेण तौ जग्राह विभीषणः \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2136450, "chapter_id": 3956, "verse_number": "५४", "content_sanskrit": "प्रतिपन्नौ यदा रूपं राक्षसं तौ निशाचरौ ।\nदर्शयित्वा ततः सैन्यं रामः पश्चादवासृजत् \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2136451, "chapter_id": 3956, "verse_number": "५५", "content_sanskrit": "निवेश्योपवने सैन्यं तत्पुरः प्राज्ञवानरम् ।\nप्रेषयामास दौत्येन रावणस्य ततोऽङ्गदम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2136452, "chapter_id": 3956, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि द्विसप्तत्यधिकद्विशततमोऽध्यायः ॥२७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2136453, "chapter_id": 3956, "verse_number": "", "content_sanskrit": "रामोपाख्यानपर्वणि सेतुबन्धने द्वादशोऽध्यायः ॥१२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}]