[{"id": 2090763, "chapter_id": 2930, "verse_number": "१३-६०-१", "content_sanskrit": "युधिष्ठिर उवाच।\nकिमाहुर्भरतश्रेष्ठ पात्रं विप्राः सनातनम्।\nब्राह्मणं लिङ्गिनं चैव ब्राह्मणं वाऽप्यलिङ्गिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2090764, "chapter_id": 2930, "verse_number": "१३-६०-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2090765, "chapter_id": 2930, "verse_number": "१३-६०-२", "content_sanskrit": "स्ववृत्तिमभिपन्नाय लिङ्गिने चेतराय च।\nदेयमाहुर्महाराज उभावेतौ तपस्विनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2090766, "chapter_id": 2930, "verse_number": "१३-६०-३x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2090767, "chapter_id": 2930, "verse_number": "१३-६०-३", "content_sanskrit": "श्रद्धया परयाऽपूतो यः प्रयच्छेद्द्विजातये।\nहव्यं कव्यं तथा दानं को दोषः स्यात्पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2090768, "chapter_id": 2930, "verse_number": "१३-६०-४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2090769, "chapter_id": 2930, "verse_number": "१३-६०-४", "content_sanskrit": "श्रद्धापूतो नरस्तात दुर्दान्तोऽपि न संशयः।\nपूतो भवति सर्वत्र किमुत त्वं महाद्युते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2090770, "chapter_id": 2930, "verse_number": "१३-६०-५x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2090771, "chapter_id": 2930, "verse_number": "१३-६०-५", "content_sanskrit": "न ब्राह्मणं परिक्षेत दैवेषु सततं नरः।\nकव्यप्रदाने तु बुधाः परीक्ष्यं ब्राह्मणं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2090772, "chapter_id": 2930, "verse_number": "१३-६०-६x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2090773, "chapter_id": 2930, "verse_number": "१३-६०-६", "content_sanskrit": "न ब्राह्मणः साधयते हव्यं दैवात्प्रसिद्ध्यति।\nदेवप्रसादादिज्यन्ते यजमानैर्न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2090774, "chapter_id": 2930, "verse_number": "१३-६०-७", "content_sanskrit": "ब्राह्मणान्भरतश्रेष्ठ सततं ब्रह्मवादिनः।\nमार्कण्डेयः पुरा प्राह इति लोकेषु बुद्धिमान्।\n`ब्राह्मणाः पात्रभूताश्च शुद्धा नैवं पितृष्विह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2090775, "chapter_id": 2930, "verse_number": "१३-६०-८x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2090776, "chapter_id": 2930, "verse_number": "१३-६०-८", "content_sanskrit": "अपर्वोऽप्यथवा विद्वान्सम्बन्धी वा यथा भवेत्।\nतपस्वी यज्ञशीलो वा कथं पात्रं भवेत्तु सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2090777, "chapter_id": 2930, "verse_number": "१३-६०-९x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2090778, "chapter_id": 2930, "verse_number": "१३-६०-९", "content_sanskrit": "कुलीनः कर्मकृद्वैद्यस्तथैवाप्यनृशंस्यवान्।\nह्रीमानृजुः सत्यवादी पात्रं पूर्वे च ये त्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2090779, "chapter_id": 2930, "verse_number": "१३-६०-१०", "content_sanskrit": "तत्रेमं शृणु मे पार्थ चतुर्णां तेजसां मतम्।\nपृथिव्याः काश्यपस्याग्नेर्मार्कण्डेयस्य चैव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2090780, "chapter_id": 2930, "verse_number": "१३-६०-११", "content_sanskrit": "पृथिव्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2090781, "chapter_id": 2930, "verse_number": "१३-६०-११", "content_sanskrit": "यथा महार्णवे क्षिप्तः क्षिप्रं नेष्टुर्विनश्यति।\nतथा दुश्चरितं सर्वं त्रयीनित्ये निमज्जति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2090782, "chapter_id": 2930, "verse_number": "१३-६०-१२x", "content_sanskrit": "काश्यप उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2090783, "chapter_id": 2930, "verse_number": "१३-६०-१२", "content_sanskrit": "सर्वे च वेदाः सह षङ्भिरङ्गैः\nसाङ्ख्यं पुराणं च कुले च जन्म।\nनैतानि सर्वाणि गतिर्भवन्ति\nशीलव्यपेतस्य नृप द्विजस्य॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2090784, "chapter_id": 2930, "verse_number": "१३-६०-१३x", "content_sanskrit": "अग्निरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2090785, "chapter_id": 2930, "verse_number": "१३-६०-१३", "content_sanskrit": "अधीयानः पण्डितम्मन्यमानो\nयो विद्यया हन्ति यशः परेषाम्।\nब्रह्मन्स तेन लभते ब्रह्मवध्यां\nलोकास्तस्य ह्यन्तवन्तो भवन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2090786, "chapter_id": 2930, "verse_number": "१३-६०-१४x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2090787, "chapter_id": 2930, "verse_number": "१३-६०-१४", "content_sanskrit": "अश्वमेधसहस्रं च सत्यं च तुलया धृतम्।\nनाभिजानामि यज्ञं तु सत्यस्यार्धमवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2090788, "chapter_id": 2930, "verse_number": "१३-६०-१५x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2090789, "chapter_id": 2930, "verse_number": "१३-६०-१५", "content_sanskrit": "इत्युक्त्वा ते जग्मुराशु चत्वारोऽमिततेजसः।\nपृथिवी काश्यपोऽग्निश्च प्रकृष्टायुश्च भार्गवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2090790, "chapter_id": 2930, "verse_number": "१३-६०-१६x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2090791, "chapter_id": 2930, "verse_number": "१३-६०-१६", "content_sanskrit": "यदि ते ब्राह्मणा लोके व्रतिनो भुञ्जते हविः।\nदत्तं ब्राह्मणकामाय कथं तत्सुकृतं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2090792, "chapter_id": 2930, "verse_number": "१३-६०-१७x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2090793, "chapter_id": 2930, "verse_number": "१३-६०-१७", "content_sanskrit": "आदिष्टिनो ये राजेन्द्र ब्राह्मणा वेदपारगाः।\nभुञ्जते ब्रह्मकामाय व्रतलुप्ता भवन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2090794, "chapter_id": 2930, "verse_number": "१३-६०-१८x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2090795, "chapter_id": 2930, "verse_number": "१३-६०-१८", "content_sanskrit": "अनेकान्तं बहुद्वारं धर्ममाहुर्मनीषिणः।\nकिं निमित्तं भवेदत्र तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2090796, "chapter_id": 2930, "verse_number": "१३-६०-१९x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2090797, "chapter_id": 2930, "verse_number": "१३-६०-१९", "content_sanskrit": "अहिंसा सत्यमकोध आनृशंस्यं दमस्तथा।\nआर्जवं चैव राजेन्द्र निश्चितं धर्मलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2090798, "chapter_id": 2930, "verse_number": "१३-६०-२०", "content_sanskrit": "ये तु धर्मं प्रशंसन्तश्चरन्ति पृथिवीमिमाम्।\nअनाचरन्तस्तद्धर्म सङ्करेऽभिरता प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2090799, "chapter_id": 2930, "verse_number": "१३-६०-२१", "content_sanskrit": "तेभ्यो हिरण्यं रत्नं वा गामश्वं वा ददाति यः।\nदशवर्षाणि विष्ठां स भुङ्क्ते निरयमास्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2090800, "chapter_id": 2930, "verse_number": "१३-६०-२२", "content_sanskrit": "धनेन पुल्कसानां च तथैवान्तेवसायिनाम्।\nकृतं कर्माकृतं वाऽपि रागमोहेन जल्पताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2090801, "chapter_id": 2930, "verse_number": "१३-६०-२३", "content_sanskrit": "वैश्वदेवं च ये मूढा विप्राय ब्रह्मचारिणे।\nन ददन्तीह राजेन्द्र ते लोकान्भुञ्जतेऽशुभान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2090802, "chapter_id": 2930, "verse_number": "१३-६०-२४x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2090803, "chapter_id": 2930, "verse_number": "१३-६०-२४", "content_sanskrit": "किं परं ब्रह्मचर्यं च किं परं धर्मलक्षणम्।\nकिञ्च श्रेष्ठतमं शौचं तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2090804, "chapter_id": 2930, "verse_number": "१३-६०-२५x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2090805, "chapter_id": 2930, "verse_number": "१३-६०-२५", "content_sanskrit": "ब्रह्मचर्यं परं तात मधुमांसस्य वर्जनम्।\nमर्यादायां स्थितो धर्मः शमः शौचस्य लक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2090806, "chapter_id": 2930, "verse_number": "१३-६०-२६x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2090807, "chapter_id": 2930, "verse_number": "१३-६०-२६", "content_sanskrit": "कस्मिन्काले चरेद्धर्म कस्मिन्कालेऽर्थमाचरेत्।\nकस्मिन्काले सुखी च स्यात्तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2090808, "chapter_id": 2930, "verse_number": "१३-६०-२७x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2090809, "chapter_id": 2930, "verse_number": "१३-६०-२७", "content_sanskrit": "काल्यमर्थं निषेवेत ततो धर्ममनन्तरम्।\nपश्चात्कामं निषेवेत न च गच्छेत्प्रसङ्गिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2090810, "chapter_id": 2930, "verse_number": "१३-६०-२८", "content_sanskrit": "ब्राह्मणांश्चैव मन्येत गुरूंश्चाप्यभिपूजयेत्।\nसर्वभूतानुलोमश्च मृदुशीलः प्रियंवदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2090811, "chapter_id": 2930, "verse_number": "१३-६०-२९", "content_sanskrit": "अधिकारे यदनृतं यच्च राजसु पैशुनम्।\nगुरोश्चालीकनिर्बन्धः समानि ब्रह्महत्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2090812, "chapter_id": 2930, "verse_number": "१३-६०-३०", "content_sanskrit": "प्रहरेन्न नरेन्द्रेषु न हन्याद्गां तथैव च।\nभ्रूणहत्यासमं चैतदुभयं ये निषेधते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2090813, "chapter_id": 2930, "verse_number": "१३-६०-३१", "content_sanskrit": "नाग्निं परित्यजेज्जातु न च वेदान्परित्यजेत्।\nन च ब्राह्मणमाक्रोशेत्समं तद्ब्रह्महत्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2090814, "chapter_id": 2930, "verse_number": "१३-६०-३२x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2090815, "chapter_id": 2930, "verse_number": "१३-६०-३२", "content_sanskrit": "कीदृशाः साधवो विप्राः केभ्यो दत्तं महाफलम्।\nकीदृशानां च भोक्तव्यं तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2090816, "chapter_id": 2930, "verse_number": "१३-६०-३३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2090817, "chapter_id": 2930, "verse_number": "१३-६०-३३", "content_sanskrit": "अक्रोधना धर्मपराः सत्यनित्या दमे रताः।\nतादृशाः साधवो विप्रास्तेभ्यो दत्तं महाफलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2090818, "chapter_id": 2930, "verse_number": "१३-६०-३४", "content_sanskrit": "अमानिनः सर्वसहा दृढार्था विजितेन्द्रियाः।\nसर्वभूतहिता मैत्रास्तेभ्यो दत्तं महाफलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2090819, "chapter_id": 2930, "verse_number": "१३-६०-३५", "content_sanskrit": "अलुब्धाः शुचयो वैद्या ह्रीमन्तः सत्यवादिनः।\nस्वकर्मनिरता ये च तेभ्यो दत्तं महाफलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2090820, "chapter_id": 2930, "verse_number": "१३-६०-३६", "content_sanskrit": "साङ्गांश्च चतुरो वेदानधीते यो द्विजर्षभः।\nषड्भ्यः प्रवृत्तः कर्मभ्यस्तं पात्रमृषयो विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2090821, "chapter_id": 2930, "verse_number": "१३-६०-३७", "content_sanskrit": "ये त्वेवंगुणजातीयास्तेभ्यो दत्तं महाफलम्।\nसहस्रगुणमाप्नोति गुणार्हाय प्रदायकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2090822, "chapter_id": 2930, "verse_number": "१३-६०-३८", "content_sanskrit": "प्रज्ञाश्रुताभ्यां वृत्तेन शीलेन च समन्वितः।\nतारयेत कुलं सर्वमेकोऽपीह द्विजर्षभः।\n`तृप्ते तृप्ताः सर्वदेवाः पितरो मुनयोपि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2090823, "chapter_id": 2930, "verse_number": "१३-६०-३९", "content_sanskrit": "गामश्वं वित्तमन्नं वा तद्विधे प्रतिपादयेत्।\nद्रव्याणि चान्यानि तथा प्रेत्यभावे न शोचति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2090824, "chapter_id": 2930, "verse_number": "१३-६०-४०", "content_sanskrit": "तारयेत कुलं सर्वमेकोपि ह द्विजोत्तमः।\nकिमङ्ग पुनरेवैते तस्मात्पात्रं समाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2090825, "chapter_id": 2930, "verse_number": "१३-६०-४१", "content_sanskrit": "निशाम्य च गुणोपेतं ब्राह्मणं साधुसम्मतम्।\nदूरादानाय्य सत्कृत्य सर्वतश्चापि पूजयेत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2090826, "chapter_id": 2930, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि षष्टितमोऽध्यायः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]