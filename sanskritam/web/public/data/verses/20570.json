[{"id": 7000570000, "chapter_id": 20570, "verse_number": "५-२९-१", "content_sanskrit": "शेष उवाच ।\nते तु तातवचः श्रुत्वा हर्षिताः संप्रहारिणः ।\nतथेत्यूचुर्महाराजं रामदर्शनलालसम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000570001, "chapter_id": 20570, "verse_number": "५-२९-२", "content_sanskrit": "पुत्रा ऊचुः ।\nराजन्भवत्पदांभोजान्नान्यं जानीमहे वयम् ।\nयत्तव स्वांततो जातं तद्भवत्वद्य वेगतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000570002, "chapter_id": 20570, "verse_number": "५-२९-३", "content_sanskrit": "अश्वोऽयं नीयतां तत्र सितचामरभूषितः ।\nरत्नमालातिशोभाढ्यश्चंदनादिकचर्चितः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000570003, "chapter_id": 20570, "verse_number": "५-२९-४", "content_sanskrit": "राज्यमाज्ञाफलं स्वामिन्कोशा बहुसमृद्धयः ।\nवासांसि सुमहार्हाणि सूक्ष्माणि सुगुणानि च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000570004, "chapter_id": 20570, "verse_number": "५-२९-५", "content_sanskrit": "चंदनं चंद्रकं चैव वाजिनः सुमनोहराः ।\nहस्तिनस्तु मदोद्धूता रथाः कांचनकूबराः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000570005, "chapter_id": 20570, "verse_number": "५-२९-६", "content_sanskrit": "विचित्रतरवर्णादि नानाभूषणभूषिताः ।\nदास्यः शतसहस्रं च दासाश्च सुमनोरमाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000570006, "chapter_id": 20570, "verse_number": "५-२९-७", "content_sanskrit": "मणयः सूर्यसंकाशा रत्नानि विविधानि च ।\nमुक्ताफलानि शुभ्राणि गजकुंभभवानि च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000570007, "chapter_id": 20570, "verse_number": "५-२९-८", "content_sanskrit": "विद्रुमाः शतसाहस्रा यद्यद्वस्तुमहोदयम् ।\nतत्सर्वं रामचंद्राय देहि राजन्महामते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000570008, "chapter_id": 20570, "verse_number": "५-२९-९", "content_sanskrit": "सुतानस्मान्किंकरान्नः सर्वानर्पय भूपते ।\nकथं न कुरुषेराजंस्तदधीनं नृपासनम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000570009, "chapter_id": 20570, "verse_number": "५-२९-१०", "content_sanskrit": "शेष उवाच ।\nइति पुत्रवचः श्रुत्वा हर्षितोऽभून्महीपतिः ।\nउवाच च सुतान्वीरान्स्ववाक्यकरणोद्यतान् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000570010, "chapter_id": 20570, "verse_number": "५-२९-११", "content_sanskrit": "राजोवाच ।\nआनयंतु हयं सर्वे सन्नद्धाः शस्त्रपाणयः ।\nनानारथपरीवारास्ततो यास्ये नृपं प्रति ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000570011, "chapter_id": 20570, "verse_number": "५-२९-१२", "content_sanskrit": "शेष उवाच ।\nइति राज्ञोवचः श्रुत्वा विचित्रो दमनस्तथा ।\nसुकेतुः समरे शूरा जग्मुस्तस्याज्ञयोद्यताः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000570012, "chapter_id": 20570, "verse_number": "५-२९-१३", "content_sanskrit": "ते गत्वाथ पुरीं शूरा वाजिनं सुमनोरमम् ।\nसितचामरसंयुक्तं स्वर्णपत्राद्यलंकृतम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000570013, "chapter_id": 20570, "verse_number": "५-२९-१४", "content_sanskrit": "रत्नमालाविभूषाढ्यं चित्रपत्रेणशोभितम् ।\nविचित्रमणिभूषाढ्यं मुक्ताजालस्वलंकृतम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000570014, "chapter_id": 20570, "verse_number": "५-२९-१५", "content_sanskrit": "रज्ज्वा धृतं महावीरैः पूर्वतः पृष्ठतो भटैः ।\nमहाशस्त्रास्त्रसंयुक्तैः सर्वशोभासमन्वितैः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000570015, "chapter_id": 20570, "verse_number": "५-२९-१६", "content_sanskrit": "सितातपत्रमस्योच्चैर्भाति मूर्धनि वाजिनः ।\nसुचामरद्वयं यस्य ध्रियते पुरतो मुहुः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000570016, "chapter_id": 20570, "verse_number": "५-२९-१७", "content_sanskrit": "कृष्णागर्वादिधूपैश्च धूपितं वायुवेगिनम् ।\nराज्ञः पुरो निनायाश्वं हयमेधस्य सत्क्रतोः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000570017, "chapter_id": 20570, "verse_number": "५-२९-१८", "content_sanskrit": "तमानीतं हयं दृष्ट्वा रत्नमालाविभूषितम् ।\nमनोजवं कामरूपं जहर्ष मतिमान्नृपः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000570018, "chapter_id": 20570, "verse_number": "५-२९-१९", "content_sanskrit": "जगाम पद्भ्यां शत्रुघ्नं राजचिह्नाद्यलंकृतः ।\nस्वपुत्रपौत्रैः संयुक्तो राजा परमधार्मिकः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000570019, "chapter_id": 20570, "verse_number": "५-२९-२०", "content_sanskrit": "ययौ कर्तुं धनानां स सद्व्ययं चलगामिनाम् ।\nएतद्विनश्वरं मत्वा दुःखदं सक्तचेतसाम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000570020, "chapter_id": 20570, "verse_number": "५-२९-२१", "content_sanskrit": "शत्रुघ्नं स ददर्शाथ सितच्छत्रेण शोभितम् ।\nचामरैर्वीज्यमानञ्च सेवकैः पुरतः स्थितैः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000570021, "chapter_id": 20570, "verse_number": "५-२९-२२", "content_sanskrit": "सुमतिं परिपृच्छंतं रामचंद्रकथानकम् ।\nभयवार्ताविनिर्मुक्तं वीरशोभास्वलंकृतम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000570022, "chapter_id": 20570, "verse_number": "५-२९-२३", "content_sanskrit": "वीरैः कोटिभिराकीर्णं वाजिपालनकांक्षिभिः ।\nवानराणां सहस्रैश्च समंतात्परिवारितम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000570023, "chapter_id": 20570, "verse_number": "५-२९-२४", "content_sanskrit": "दृष्ट्वा शत्रुघ्नचरणौ प्रणनाम सपुत्रकः ।\nधन्योऽहमिति संहृष्टो वदन्रामैकमानसः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000570024, "chapter_id": 20570, "verse_number": "५-२९-२५", "content_sanskrit": "शत्रुघ्नस्तं प्रणयिनं दृष्ट्वा राजानमुद्भटम् ।\nउत्थायासनतः सर्वैर्भटैर्दोर्भ्यां स सस्वजे ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000570025, "chapter_id": 20570, "verse_number": "५-२९-२६", "content_sanskrit": "दृढं संपूज्य राजा तं शत्रुघ्नं परवीरहा ।\nउवाच हर्षमापन्नो गद्गदस्वरया गिरा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000570026, "chapter_id": 20570, "verse_number": "५-२९-२७", "content_sanskrit": "सुबाहुरुवाच ।\nअद्य धन्योस्मि ससुतः सकुटुंबः सवाहनः ।\nयद्युष्मच्चरणौ द्रक्ष्ये नृपकोटिभिरीडितौ ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000570027, "chapter_id": 20570, "verse_number": "५-२९-२८", "content_sanskrit": "अज्ञानिना सुतेनायं गृहीतो वाजिनां वरः ।\nदमनेनानयं त्वस्य क्षमस्व करुणानिधे ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000570028, "chapter_id": 20570, "verse_number": "५-२९-२९", "content_sanskrit": "न जानाति रघूत्तंसं सर्वदेवाधिदैवतम् ।\nलीलया विश्वस्रष्टारं हंतारमपि पालकम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000570029, "chapter_id": 20570, "verse_number": "५-२९-३०", "content_sanskrit": "इदं राज्यं समृद्धांगं समृद्धबलवाहनम् ।\nइमे कोशा धनैः पूर्णा इमे पुत्रा इमे वयम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000570030, "chapter_id": 20570, "verse_number": "५-२९-३१", "content_sanskrit": "सर्वे वयं रामनाथास्त्वदाज्ञा प्रतिपालकाः ।\nगृहाण सर्वं सफलं न मेऽस्ति क्वचिदुन्मतम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000570031, "chapter_id": 20570, "verse_number": "५-२९-३२", "content_sanskrit": "क्वासौ हनूमान्रामस्य चरणांभोजषट्पदः ।\nयत्प्रसादादहं प्राप्स्ये राजराजस्य दर्शनम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000570032, "chapter_id": 20570, "verse_number": "५-२९-३३", "content_sanskrit": "साधूनां संगमे किं किं प्राप्यते न महीतले ।\nयत्प्रसादादहं मूढो ब्रह्मशापमतीतरम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000570033, "chapter_id": 20570, "verse_number": "५-२९-३४", "content_sanskrit": "दृष्ट्वा त्वद्य महाराजं पद्मपत्रनिभेक्षणम् ।\nप्राप्स्यामि जन्मनः सर्वं फलं दुर्लभमत्र च ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000570034, "chapter_id": 20570, "verse_number": "५-२९-३५", "content_sanskrit": "मम तावद्गतं चायुर्बहुरामवियोगिनः ।\nस्वल्पमुर्वरितं तत्र कथं द्रक्ष्ये रघूत्तमम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000570035, "chapter_id": 20570, "verse_number": "५-२९-३६", "content_sanskrit": "मह्यं दर्शयतं रामं यज्ञकर्मविचक्षणम् ।\nयदंघ्रिरजसापूता शिलाभूता मुनिप्रिया ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000570036, "chapter_id": 20570, "verse_number": "५-२९-३७", "content_sanskrit": "काकः परं पदं प्राप्तो यद्बाणस्पर्शनात्खगः ।\nअनेके यस्य वक्त्राब्जं वीक्ष्य संख्ये पदं गताः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000570037, "chapter_id": 20570, "verse_number": "५-२९-३८", "content_sanskrit": "ये त्वस्य रघुनाथस्य नाम गृह्णंति सादराः ।\nते यांति परमं स्थानं योगिभिर्यद्विचिंत्यते ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000570038, "chapter_id": 20570, "verse_number": "५-२९-३९", "content_sanskrit": "धन्यायोध्याभवा लोका ये राममुखपंजम् ।\nस्वलोचनपुटैः पीत्वा सुखं यांति महोदयम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000570039, "chapter_id": 20570, "verse_number": "५-२९-४०", "content_sanskrit": "इति संभाष्य नृपतिं वाहं राज्यं धनानि च ।\nसर्वं समर्प्य चावोचत्किंकरोस्मि महीपते ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000570040, "chapter_id": 20570, "verse_number": "५-२९-४१", "content_sanskrit": "इति वाक्यं समाकर्ण्य राज्ञः परपुरंजयः ।\nप्रत्युवाचेति तं भूपं वाग्मी वाक्यविशारदः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000570041, "chapter_id": 20570, "verse_number": "५-२९-४२", "content_sanskrit": "शत्रुघ्न उवाच ।\nकथं राजन्निदं ब्रूषे त्वं वृद्धो मम पूजितः ।\nसर्वं त्वदीयं त्वद्राज्यं दमनो विदधात्वयम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000570042, "chapter_id": 20570, "verse_number": "५-२९-४३", "content_sanskrit": "क्षत्त्रियाणामिदं कृत्यं यत्संग्रामविधायकम् ।\nसर्वं राज्यं धनं चेदं प्रतियातु ममाज्ञया ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000570043, "chapter_id": 20570, "verse_number": "५-२९-४४", "content_sanskrit": "यथा मे रघुनाथस्तु पूज्यो वाङ्मनसा सदा ।\nतथा त्वमपि मत्पूज्यो भविष्यसि महीपते ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000570044, "chapter_id": 20570, "verse_number": "५-२९-४५", "content_sanskrit": "भवान्सज्जो भवत्वद्य हयस्यानुगमं प्रति ।\nसन्नद्धः कवची खड्गी गजाश्वरथसंयुतः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000570045, "chapter_id": 20570, "verse_number": "५-२९-४६", "content_sanskrit": "इति वाक्यं समाकर्ण्य शत्रुघ्नस्य महीपतिः ।\nपुत्रं राज्येऽभिषेच्यैव शत्रुघ्नेन सुपूजितः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000570046, "chapter_id": 20570, "verse_number": "५-२९-४७", "content_sanskrit": "महारथैः परिवृतो निजं पुत्रं रणांगणे ।\nपुष्कलेन हतं भूपः संस्कृत्य विधिपूर्वकम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000570047, "chapter_id": 20570, "verse_number": "५-२९-४८", "content_sanskrit": "क्षणं शुशोच तत्त्वज्ञो लोकदृष्ट्या महारथः ।\nज्ञानेनानाशयच्छोकं रघुनाथमनुस्मरन् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000570048, "chapter_id": 20570, "verse_number": "५-२९-४९", "content_sanskrit": "सज्जीभूतो रथे तिष्ठन्महासैन्यसमावृतः ।\nआजगाम स शत्रुघ्नं महारथिपुरस्कृतः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000570049, "chapter_id": 20570, "verse_number": "५-२९-५०", "content_sanskrit": "राजा तमागतं दृष्ट्वा सर्वसैन्यसमन्वितम् ।\nगंतुं चकार धिषणां हयवर्यस्य पालने ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000570050, "chapter_id": 20570, "verse_number": "५-२९-५१", "content_sanskrit": "सोऽश्वो विमोचितस्तेन भाले पत्रेण चिह्नितः ।\nवामावर्तं भ्रमन्प्रायात्पौर्वाञ्जनपदान्बहून् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000570051, "chapter_id": 20570, "verse_number": "५-२९-५२", "content_sanskrit": "तत्रतत्रत्य भूपालैर्महाशूराभिपूजितैः ।\nप्रणतिः क्रियते तस्य न कोपि तमगृह्णत ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000570052, "chapter_id": 20570, "verse_number": "५-२९-५३", "content_sanskrit": "केचिद्वासांसि चित्राणि केचिद्राज्यं स्वकं महत् ।\nकेचिद्धनं जनं केचिदानीय प्रणमंति तम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]