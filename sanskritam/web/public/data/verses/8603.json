[{"id": 900007925, "chapter_id": 8603, "verse_number": "184.1", "content_sanskrit": "ॐ तानि परे तथा ह्याह ॐ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900007926, "chapter_id": 8603, "verse_number": "184.2", "content_sanskrit": "तस्मादशेषा गिरिजां प्रविश्य तयैव रुद्रं सह तेन वाणीम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900007927, "chapter_id": 8603, "verse_number": "184.3", "content_sanskrit": "सोमस्तु वारीशयुतोऽनिरुद्धं", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900007928, "chapter_id": 8603, "verse_number": "184.4", "content_sanskrit": "सूर्योऽग्नियुक्तो गुरुमाप्य तेन शक्रं सहैतेन सुपर्णपत्नीम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900007929, "chapter_id": 8603, "verse_number": "184.5", "content_sanskrit": "भृग्वादयो दक्षमवाप्य तेन प्राप्येन्द्रमेतेन सुपर्णपत्नीम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900007930, "chapter_id": 8603, "verse_number": "184.6", "content_sanskrit": "अतश्चेष्टत एव निर्गताः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900007931, "chapter_id": 8603, "verse_number": "184.7", "content_sanskrit": "उक्तं समस्तं परमश्रुतौ हि प्रोक्तं च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900007932, "chapter_id": 8603, "verse_number": "184.8", "content_sanskrit": "यं वदिष्यति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900007933, "chapter_id": 8603, "verse_number": "184.9", "content_sanskrit": "तेजोऽभिधां तु श्रियमाप्य विष्णुमग्रे ततः पुत्रतयैव वायुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900007934, "chapter_id": 8603, "verse_number": "184.10", "content_sanskrit": "सर्वेऽनिरुद्धं पृतनाधिपाद्याः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900007935, "chapter_id": 8603, "verse_number": "184.11", "content_sanskrit": "इयं विमुक्तिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]