[{"id": 2210512, "chapter_id": 5503, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2210513, "chapter_id": 5503, "verse_number": "१", "content_sanskrit": "अश्वमेधे पुरा वृत्ते केशवं केशिसूदनम् ।\nधर्मसंशयमुद्दिश्य किमपृच्छत् पितामहः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2210514, "chapter_id": 5503, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2210515, "chapter_id": 5503, "verse_number": "२", "content_sanskrit": "पश्चिमेनाश्वमेधेन यदा स्नातो युधिष्ठिरः ।\nतदा राजा नमस्कृत्य केशवं वाक्यमब्रीत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2210516, "chapter_id": 5503, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2210517, "chapter_id": 5503, "verse_number": "३", "content_sanskrit": "भगवन् वैष्णवा धर्माः किंफलाः किंपरायणाः ।\nकिं धर्ममधिकृत्याथ भवतोत्पादिताः पुरा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2210518, "chapter_id": 5503, "verse_number": "४", "content_sanskrit": "यदि तेऽहमनुग्राह्यः प्रियो वा मधुसूदन ।\nश्रोतव्या यदि वा कृष्ण तान् मे कथय सुव्रत ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2210519, "chapter_id": 5503, "verse_number": "५", "content_sanskrit": "पवित्राः किल ते धर्माः सर्वे प्रापप्रणाशनाः ।\nसर्वधर्मोत्तमाः पुण्या भगवंस्त्वन्मुखोद्गताः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2210520, "chapter_id": 5503, "verse_number": "६", "content_sanskrit": "यच्छ्रुत्वा ब्रह्महा गोघ्नो मातृहा गुरुतल्पगः ।\nपाकभेदी कृतघ्नश्च सुरापो ब्रह्मविक्रयी ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2210521, "chapter_id": 5503, "verse_number": "७", "content_sanskrit": "मित्रविश्वासघाती च भ्रूणहा वीरहा तथा ।\nतपोविक्रयिणश्चैव दानविक्रयिणस्तथा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2210522, "chapter_id": 5503, "verse_number": "८", "content_sanskrit": "आत्मविक्रयिणो मूढा जीवेद्यश्च विकर्मभिः ।\nपापाचारा नैकृतिका डाम्भिका दूषकास्तथा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2210523, "chapter_id": 5503, "verse_number": "९", "content_sanskrit": "रसभेदकरा ये च ये च स्युर्ब्रह्मदूषकाः ।\nशूद्रप्रेष्यकराश्चोरा विप्रा ये च पुरोहिताः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2210524, "chapter_id": 5503, "verse_number": "१०", "content_sanskrit": "निक्षेपहारिणः स्त्रीघ्नास्तथा ये पारदारिकाः ।\nएते चान्ये च बहवो मुच्यन्ते तेऽपि किल्बिषात् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2210525, "chapter_id": 5503, "verse_number": "११", "content_sanskrit": "तानाचक्ष्व सुरश्रेष्ठ त्वद्भक्तस्य ममाच्युत ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2210526, "chapter_id": 5503, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2210527, "chapter_id": 5503, "verse_number": "१२", "content_sanskrit": "इत्येवं कथिते देवे धर्मपुत्रेण संसदि ।\nवसिष्ठाद्यास्तपोयुक्ता मुनयस्तत्त्वदर्शिनः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2210528, "chapter_id": 5503, "verse_number": "१३", "content_sanskrit": "श्रोतुकामाः परं गुह्यं भक्तिमन्तो निरत्ययाः ।\nतथा भागवताश्चैव ततस्तं पर्यवारयन् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2210529, "chapter_id": 5503, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2210530, "chapter_id": 5503, "verse_number": "१४", "content_sanskrit": "तत्त्वतस्तव भावेन पादमूलमुपागतम् ।\nयदि जानासि मां भक्तं स्निग्धं वा भक्तवत्सल ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2210531, "chapter_id": 5503, "verse_number": "१५", "content_sanskrit": "धर्मगुह्यानि सर्वाणि वेत्तुमिच्छामि तत्त्वतः ।\nधर्मान् कथय देवेश यद्यनुग्रहभागहम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2210532, "chapter_id": 5503, "verse_number": "१६", "content_sanskrit": "श्रुता मे मानवा धर्मा वासिष्ठाः काश्यपास्तथा ।\nगार्गीया गौतमीयाश्च तथा गोपालकस्य च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2210533, "chapter_id": 5503, "verse_number": "१७", "content_sanskrit": "पराशरकृताः पूर्वमात्रेयस्य च धीमतः ।\nऔमा माहेश्वराश्चैव नन्दिधर्माश्च पावनाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2210534, "chapter_id": 5503, "verse_number": "१८", "content_sanskrit": "ब्रह्मणा कथिता ये च कौमाराश्च श्रुता मया ।\nधूमायनकृता धर्माः काण्डवैश्वानरा अपि ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2210535, "chapter_id": 5503, "verse_number": "१९", "content_sanskrit": "भार्गवा याज्ञवल्क्याश्च मार्कण्डेयकृतास्तथा ।\nभारद्वाजकृता ये च बृहस्पतिकृताश्च ये ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2210536, "chapter_id": 5503, "verse_number": "२०", "content_sanskrit": "कुणेश्च कुणिबाहोश्च विश्वामित्रकृताश्च ये ।\nसुमन्तुजैमिनिकृताः शाकुनेयास्तथैव च ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2210537, "chapter_id": 5503, "verse_number": "२१", "content_sanskrit": "पुलस्त्यपुलहोद्गीताः पावकीयास्तथैव च ।\nअगस्त्यगीता मौद्गल्याः शाण्डिल्याः शलभायनाः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2210538, "chapter_id": 5503, "verse_number": "२२", "content_sanskrit": "वालखिल्यकृता ये च ये च सप्तर्षिभिः कृताः ।\nआपस्तम्बकृता धर्माः शङ्खस्य लिखितस्य च ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2210539, "chapter_id": 5503, "verse_number": "२३", "content_sanskrit": "प्राजापत्यास्तथा याम्या माहेन्द्राश्च श्रुता मया ।\nवैयाघ्रव्यासगीताश्च विभण्डककृताश्च ये ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2210540, "chapter_id": 5503, "verse_number": "२४", "content_sanskrit": "नारदीयाः श्रुता धर्माः कापोताश्च श्रुता मया ।\nतथा विदुरवाक्यानि भृगोरङ्गिरसस्तथा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2210541, "chapter_id": 5503, "verse_number": "२५", "content_sanskrit": "क्रौञ्चा मृदङ्गगीताश्च सौर्या हारीतकास्तथा ।\nपिङ्गवर्मकृताश्चापि कौन्तपाः पांसुबालिकाः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2210542, "chapter_id": 5503, "verse_number": "२६", "content_sanskrit": "उद्दालककृता धर्मा औशनस्यास्तथैव च ।\nवैशम्पायनगीताश्च ये चान्येऽप्येवमादयः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2210543, "chapter_id": 5503, "verse_number": "२७", "content_sanskrit": "एतेभ्यः सर्वधर्मेभ्यो देव त्वन्मुखनिःसृताः ।\nपावनत्वात् पवित्रत्वाद् विशिष्टा इति मे मतिः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2210544, "chapter_id": 5503, "verse_number": "२८", "content_sanskrit": "तस्माद्धि त्वां प्रपन्नस्य त्वद्भक्तस्य च भावतः ।\nयुष्मदीयान् परान् धर्मान् पुण्यान् कथय मेऽच्युत ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2210545, "chapter_id": 5503, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2210546, "chapter_id": 5503, "verse_number": "२९", "content_sanskrit": "एवमुक्तस्तु धर्मज्ञो धर्मपुत्रेण माधवः ।\nउवाच धर्मान् सूक्ष्मार्थान् धर्मपुत्रस्य धीमतः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2210547, "chapter_id": 5503, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2210548, "chapter_id": 5503, "verse_number": "३०", "content_sanskrit": "एवं ते यस्य कौन्तेय यत्नो धर्मेषु सुव्रत ।\nत्वत्समो दुर्लभो लोके न कश्चिदिह विद्यते ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2210549, "chapter_id": 5503, "verse_number": "३१", "content_sanskrit": "धर्मःश्रुतो वा दृष्टो वा कथितो वा कृतोऽपि वा ।\nअनुमोदितो वा राजेन्द्र पुनातीह सदा नरम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2210550, "chapter_id": 5503, "verse_number": "३२", "content_sanskrit": "धर्मः पिता च माता च धर्मोऽथ सुहृदस्तथा ।\nधर्मो भ्राता सखा चैव धर्मः स्वामी परन्तप ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2210551, "chapter_id": 5503, "verse_number": "३३", "content_sanskrit": "धर्मादर्थश्च कामश्च धर्माद् भोगाः सुखानि च ।\nधर्मादैश्वर्यमेवाग्र्यं धर्मात् स्वर्गगतिः परा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2210552, "chapter_id": 5503, "verse_number": "३४", "content_sanskrit": "धर्मोऽयं सेवितः शुद्धस्त्रायते महतो भयात् ।\nद्विजत्वं देवतात्वं च धर्मः प्रापयते नरम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2210553, "chapter_id": 5503, "verse_number": "३५", "content_sanskrit": "यदा च क्षीयते पापं कालेन पुरुषस्य तु ।\nसदा सञ्जायते बुद्धिर्धर्मं कर्तुं युधिष्ठिर ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2210554, "chapter_id": 5503, "verse_number": "३६", "content_sanskrit": "जन्मान्तरसहस्रैस्तु मानुषत्वं हि दुर्लभम् ।\nतल्लब्ध्वाऽपीह यो धर्मं न करोति स वञ्चितः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2210555, "chapter_id": 5503, "verse_number": "३७", "content_sanskrit": "कुत्सिताश्च दरिद्राश्च विरूपा व्याधितास्तथा ।\nपरद्वेष्याश्च मूर्खाश्च न तैर्धर्मः कृतः पुरा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2210556, "chapter_id": 5503, "verse_number": "३८", "content_sanskrit": "ये तु दीर्घायुषः शूराः पण्डिता भोगिनस्तथा ।\nनीरोगा रूपसम्पन्नास्तैर्धर्माः सुकृताः पुरा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2210557, "chapter_id": 5503, "verse_number": "३९", "content_sanskrit": "एवं धर्मः कृतः सद्यो नयते गतिमुत्तमाम् ।\nअधर्मः सेव्यमानस्तु तिर्यग्योनिं नयत्यमुम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2210558, "chapter_id": 5503, "verse_number": "४०", "content_sanskrit": "इदं रहस्यं कौन्तेय श्रूयतामिदमुत्तमम् ।\nकथयिष्ये परं गुह्यं मम भक्तस्य पाण्डव ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2210559, "chapter_id": 5503, "verse_number": "४१", "content_sanskrit": "इष्टस्त्वमसि मेऽत्यर्थं प्रपन्नश्चासि मां सदा ।\nपरमार्थमपि ब्रूयां किं पुनर्धर्मसंहिताम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2210560, "chapter_id": 5503, "verse_number": "४२", "content_sanskrit": "इदं मे मानुषं जन्म कृतमात्मनि मायया ।\nधर्मसंस्थापनायैव दुष्टानां शासनाय च ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2210561, "chapter_id": 5503, "verse_number": "४३", "content_sanskrit": "मानुष्यं भावमापन्नं ये मां गृह्णन्त्यवज्ञया ।\nसंसरन्तीह ते मूढास्तिर्यग्योनिष्वनेकशः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2210562, "chapter_id": 5503, "verse_number": "४४", "content_sanskrit": "ये च मां सर्वभूतस्थं पश्यन्ति ज्ञानचक्षुषः ।\nमद्भक्तांस्तान् सदा युक्तान् मत्समीपं नयाम्यहम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2210563, "chapter_id": 5503, "verse_number": "४५", "content_sanskrit": "मद्भक्ता न विनश्यन्ति मद्भक्ता वीतकल्मषाः ।\nमद्भक्तानां तु मानुष्ये सफलं जन्म पाण्डव ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2210564, "chapter_id": 5503, "verse_number": "४६", "content_sanskrit": "अपि पापेष्वभिरता मद्भक्ताः पाण्डुनन्दन ।\nमुच्यन्ते पातकैः सर्वैः पद्मपत्रमिवाम्भसा ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2210565, "chapter_id": 5503, "verse_number": "४७", "content_sanskrit": "जन्मान्तरसहस्रेषु तपसा भावितात्मनाम् ।\nमद्भक्तिर्विद्यते तात मनुष्याणां न संशयः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2210566, "chapter_id": 5503, "verse_number": "४८", "content_sanskrit": "यच्च रूपं परं गुह्यं कूटस्थमचलं ध्रुवम् ।\nन दृश्यते तथा देवैर्मद्भक्तैर्दृश्यते यथा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2210567, "chapter_id": 5503, "verse_number": "४९", "content_sanskrit": "अपरं यच्च मे रूपं प्रादुर्भावेषु दृश्यते ।\nतदर्चयन्ति सर्वार्थैः सर्वभूतानि पाण्डव ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2210568, "chapter_id": 5503, "verse_number": "५०", "content_sanskrit": "कल्पकोटिसहस्रेषु व्यतीतेष्वागतेषु च ।\nदर्शयामि तु यद्रूपं तत् प्रपश्यन्ति मे सुराः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2210569, "chapter_id": 5503, "verse_number": "५१", "content_sanskrit": "स्थित्युत्पत्तिप्लवकरं यो मां ज्ञात्वा प्रपद्यते ।\nअनुगृह्णाम्यहं तं वै संसारान्मोचयामि च ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2210570, "chapter_id": 5503, "verse_number": "५२", "content_sanskrit": "अहमादिर्हि देवानां सृष्टा ब्रह्मादयो मया ।\nप्रकृतिं स्वामवष्टभ्य जगत्सर्वं सृजाम्यहम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2210571, "chapter_id": 5503, "verse_number": "५३", "content_sanskrit": "तमोमूलोऽहमव्यक्तो रजोमध्ये प्रतिष्ठितः ।\nऊर्ध्वं सत्त्वविशालोऽहं ब्रह्मादिस्तम्बसंहितः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2210572, "chapter_id": 5503, "verse_number": "५४", "content_sanskrit": "मूर्धानं मे दिवं विद्धि चन्द्रादित्यो च लोचने ।\nगावोऽग्निर्ब्राह्मणो वक्त्रं मारुतः श्वसनं च मे ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2210573, "chapter_id": 5503, "verse_number": "५५", "content_sanskrit": "दिशो मे बाहवश्चाष्टौ नक्षत्राणि विभूषणम् ।\nअन्तरिक्षमुरो विद्धि सर्वभूतप्रकाशकम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2210574, "chapter_id": 5503, "verse_number": "५६", "content_sanskrit": "मार्गो मेघानिलाभ्यां तु यन्ममोदरमव्ययम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2210575, "chapter_id": 5503, "verse_number": "५७", "content_sanskrit": "पृथिवीमण्डलं यद्वै द्वीपार्णवनगैर्युतम् ।\nसर्वसन्धारणोपेतं पादौ मम युधिष्ठिर ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2210576, "chapter_id": 5503, "verse_number": "५८", "content_sanskrit": "स्थितो ह्येकगुणः खेऽहं द्विगुणश्चास्मि मारुते ।\nत्रिगुणोऽग्नौ स्थितोऽहं वै सलिले तु चतुर्गुणः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2210577, "chapter_id": 5503, "verse_number": "५९", "content_sanskrit": "शब्दाद्या ये गुणाः पञ्च महाभूतेषु पञ्चसु ।\nतन्मात्रसंस्थितः सोऽहं पृथिव्यां पञ्चधा स्थितः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2210578, "chapter_id": 5503, "verse_number": "६०", "content_sanskrit": "अहं सहस्रशीर्षस्तु सहस्रवदनेक्षणः ।\nसहस्रबाहूदरभृत् सहस्राक्षः सहस्रपात् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2210579, "chapter_id": 5503, "verse_number": "६१", "content_sanskrit": "धृत्वोर्वीं सर्वतः सम्यगत्यतिष्ठद् दशाङ्गुलम् ।\nसर्वभूतात्मभूतस्थः सर्वव्यापी नरो ह्यहम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2210580, "chapter_id": 5503, "verse_number": "६२", "content_sanskrit": "अचिन्त्योऽहमनन्तोऽहमजरोऽहमजो ह्यहम् ।\nअनाद्योऽहमवध्योऽहम् अप्रमेयोऽहमव्ययः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2210581, "chapter_id": 5503, "verse_number": "६३", "content_sanskrit": "निर्गुणोऽहं निगूढात्मा नित्योऽहं निर्ममोऽपि च ।\nनिर्द्वन्द्वो निर्विकारोऽहं निदानं चामृतस्य ह ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2210582, "chapter_id": 5503, "verse_number": "६४", "content_sanskrit": "स्वधा चाहं सुधा चाहं स्वाहाकारो नराधिप ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2210583, "chapter_id": 5503, "verse_number": "६५", "content_sanskrit": "तेजसा तपसा चाहं भूतग्रामं चतुर्विधम् ।\nस्नेहपाशगुणैर्बद्ध्वा धारयाम्यात्ममायया ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2210584, "chapter_id": 5503, "verse_number": "६६", "content_sanskrit": "चातुराश्रमधर्मोऽहं चातुर्होत्रफलाशनः ।\nचतुर्मूर्तिश्चतुर्व्यूहः चतुराश्रमभाजनम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2210585, "chapter_id": 5503, "verse_number": "६७", "content_sanskrit": "संहृत्याहं जगत्सर्वं कृत्वा वै गर्भमात्मनः ।\nशयामि दिव्ययोगेन प्रलयेषु युधिष्ठिर ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2210586, "chapter_id": 5503, "verse_number": "६८", "content_sanskrit": "सहस्रयुगपर्यन्तां ब्राह्मीं रात्रिं महार्णवे ।\nस्थित्वा सृजामि भूतानि जङ्गमानि स्थिराणि च ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2210587, "chapter_id": 5503, "verse_number": "६९", "content_sanskrit": "कल्पे कल्पे च भूतानि संहरामि सृजामि च ।\nन च मां तानि जानन्ति मायया मोहितानि ह ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2210588, "chapter_id": 5503, "verse_number": "७०", "content_sanskrit": "मम चैवान्धकारस्य मार्गितव्यस्य नित्यशः ।\nनिर्वाणस्येव (प्रशान्तस्येव) दीपस्य गतिर्नैवोपलभ्यते ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2210589, "chapter_id": 5503, "verse_number": "७१", "content_sanskrit": "न तदस्ति क्वचिद् राजन् यत्राहं न प्रतिष्ठितः ।\nन च तद् विद्यते भूतं मयि यन्न प्रतिष्ठितम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2210590, "chapter_id": 5503, "verse_number": "७२", "content_sanskrit": "यावन्मात्रं भवेद् भूतं स्थूलसूक्ष्ममिदं जगत् ।\nजीवभूतो ह्यहं तस्मिंस्तावन्मात्रप्रतिष्ठितः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2210591, "chapter_id": 5503, "verse_number": "७३", "content_sanskrit": "किञ्चात्र बहुनोक्तेन सत्यमेतद् ब्रवीमि ते ।\nयद्भूतं यद्भविष्यद्वा तत्सर्वमहमेव तु ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2210592, "chapter_id": 5503, "verse_number": "७४", "content_sanskrit": "मया सृष्टानि भूतानि मन्मयानि च पाण्डव ।\nमामेव न विजानन्ति मायया मोहितानि मे ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2210593, "chapter_id": 5503, "verse_number": "७५", "content_sanskrit": "एवं सर्वं जगदिदं सदेवासुरमानुषम् ।\nमत्तः प्रभवते राजन् मय्येव प्रविलीयते ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2210594, "chapter_id": 5503, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि श्रीकृष्णस्य जगद् व्यापकत्वकथनं नाम सप्तनवतितमोऽध्यायः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}]