[{"id": 2121466, "chapter_id": 3602, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2121467, "chapter_id": 3602, "verse_number": "१", "content_sanskrit": "यच्चक्रे भगवान् विष्णुर्वसुदेवकुलोद्वहः ।\nतत् तेऽहं नृप वक्ष्यामि शृणु सर्वमशेषतः ।\nवासुदेवस्य माहात्म्यं चरितं च महाद्युतेः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2121468, "chapter_id": 3602, "verse_number": "२", "content_sanskrit": "हितार्थं सुरमर्त्यानां लोकानां हि हिताय च ।\nयदा दिवि विभुस्तात न रेमे भगवानसौ\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2121469, "chapter_id": 3602, "verse_number": "३", "content_sanskrit": "ततो व्यादिश्य भूतानि भुवि भौमसुखावहः ।\nनिग्रहार्थाय दैत्यानां चोदयामास वै तदा\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2121470, "chapter_id": 3602, "verse_number": "४", "content_sanskrit": "मरुतश्च वसूंश्चैव सूर्याचन्द्रमसावुभौ ।\nगन्धर्वाप्सरसश्चैव रुद्रादित्यांस्तथाऽश्विनौ\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2121471, "chapter_id": 3602, "verse_number": "५", "content_sanskrit": "जायध्वं मानुषे लोके सर्वलोकमहेश्वराः ।\nजङ्गमानि विशालाक्षो ह्यात्मानं ह्यात्मनाऽसृजत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2121472, "chapter_id": 3602, "verse_number": "६", "content_sanskrit": "जायतामिति गोविन्दः तिर्यग्योनिगतैरपि ।\nतानि सर्वाणि सर्वज्ञः सोऽजायत यदोः क्षये ।\nआज्ञापयित्वा रत्यर्थमजायत यदोः कुले\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2121473, "chapter_id": 3602, "verse_number": "७", "content_sanskrit": "आत्मानमात्मना तात कृत्वा बहुविधं हरिः ।\nरत्यर्थमिह गास्तास्तु ररक्ष पुरुषोत्तमः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2121474, "chapter_id": 3602, "verse_number": "१३", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि चतुश्चत्वारिंशोऽध्यायः॥४४॥\n॥ अर्घाभिहरणपर्वणि त्र्योदशोऽध्यायः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2121475, "chapter_id": 3602, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]