[{"id": 40014779, "chapter_id": 9208, "verse_number": "1", "content_sanskrit": "ततोनिविष्टांध्वजिनींसुग्रीवेणाभिपालिताम् । ददर्शराक्षसोऽभ्येत्यशार्दूलोनामवीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40014780, "chapter_id": 9208, "verse_number": "2", "content_sanskrit": "चारोराक्षसराजस्यरावणस्यदुरात्मनः । तांदृष्ट्वासर्वतोव्यग्रंप्रतिगम्यसराक्षसः ॥ प्रविश्यलङ्कांवेगेनरावणंवाक्यमब्रवीत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40014781, "chapter_id": 9208, "verse_number": "3", "content_sanskrit": "एषवानरऋक्षौघोलङ्कांसमभिवर्तते । अगाधश्चाप्रमेयश्चद्वितीयइवसागरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40014782, "chapter_id": 9208, "verse_number": "4", "content_sanskrit": "पुत्रौदशरथस्येमौभ्रातरौरामलक्ष्मणौ ॥ उत्तमौरूपसम्पन्नौसीतायाःपदमागतौ । एतौसागरमासाद्यसन्निविष्टौमहाद्युती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40014783, "chapter_id": 9208, "verse_number": "5", "content_sanskrit": "पुत्रौदशरथस्येमौभ्रातरौरामलक्ष्मणौ ॥ उत्तमौरूपसम्पन्नौसीतायाःपदमागतौ । एतौसागरमासाद्यसन्निविष्टौमहाद्युती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40014784, "chapter_id": 9208, "verse_number": "6", "content_sanskrit": "बलंचामाकाशमावृत्यसर्वतोदशयोजनम् । तत्त्वभूतंमहाराज क्षिप्रंवेदितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40014785, "chapter_id": 9208, "verse_number": "7", "content_sanskrit": "तवदूतामहाराजक्षिप्रमर्हन्त्यवेक्षितुम् । उपप्रदानंसान्त्वंवाभेदोवात्रप्रयुज्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40014786, "chapter_id": 9208, "verse_number": "8", "content_sanskrit": "शार्दूलस्यवचश्श्रुत्वारावणोराक्षसेश्वरः । उवाचसहसाव्यग्रस्सम्प्रधार्यार्थमात्मनः ॥ शुकंनामतदारक्षोवाक्यमर्थविदांवरम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40014787, "chapter_id": 9208, "verse_number": "9", "content_sanskrit": "सुग्रीवंब्रूहिगत्वाशुराजानंवचनान्मम । यथासन्देशमक्लीबंश्लक्ष्णयापरयागिरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40014788, "chapter_id": 9208, "verse_number": "10", "content_sanskrit": "त्वंवैमहाराजकुलप्रसूतोमहाबलश्चर् क्षरजस्सुतश्च । नकश्चिदार्थस्तवनास्त्यनर्थस्तथाहिमेभ्रातृसमोहरीश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40014789, "chapter_id": 9208, "verse_number": "11", "content_sanskrit": "अहंयद्यहरंभार्यांराजपुत्रस्यधीमतः । किंतत्रतवसुग्रीव: किष्किन्धांप्रतिगम्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40014790, "chapter_id": 9208, "verse_number": "12", "content_sanskrit": "नहीयंहरिभिर्लङ्काशक्याप्राप्तुंकथञ्चन । देवैरपिसगन्धर्वैःकिंपुनर्नरवानरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40014791, "chapter_id": 9208, "verse_number": "13", "content_sanskrit": "सतथाराक्षसेन्द्रेणसन्दिष्टोरजनीचरः । शुकोविहङ्गमोभूत्वातूर्णमाप्लुत्यचाम्बरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40014792, "chapter_id": 9208, "verse_number": "14", "content_sanskrit": "सगत्वादूरमध्वानमुपर्युपरिसागरम् । संस्थितोह्यम्बरेवाक्यंसुग्रीवमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40014793, "chapter_id": 9208, "verse_number": "15", "content_sanskrit": "सर्वमुक्तंयथादिष्टंरावणेनदुरात्मना । तंप्रापयन्तंवचनंतूर्णमाप्लुत्यवानराः ॥ प्रापद्यन्तदिवंक्षिप्रंलोप्तुंहन्तुंचमुष्टिभि: ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40014794, "chapter_id": 9208, "verse_number": "16", "content_sanskrit": "सतैःप्लवङ्गैःप्रसभंनिगृहीतोनिशाचरः । गगनाद्भूतलेचाशुपरिगृह्यनिपातितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40014795, "chapter_id": 9208, "verse_number": "17", "content_sanskrit": "वानरैःपीड्यमानस्तुशुकोवचनमब्रवीत् । नदूतान्घ्नन्तिकाकुत्स्थ वार्यन्तांसाधुवानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40014796, "chapter_id": 9208, "verse_number": "18", "content_sanskrit": "यस्तुहित्वामतंभर्तुस्स्वमतंसम्प्रभाषते । अनुक्तवादीदूतस्सन् सदूतोवधमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40014797, "chapter_id": 9208, "verse_number": "19", "content_sanskrit": "शुकस्यवचनंश्रुत्वारामस्तुपरिदेवितम् । उवाचमावधिष्टेतिघ्नतश्शाखामृगर्षभान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40014798, "chapter_id": 9208, "verse_number": "20", "content_sanskrit": "सचपत्रलघुर्भूत्वाहरिभिर्दर्शितेभये । अन्तरिक्षेस्थितोभूत्वापुनर्वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40014799, "chapter_id": 9208, "verse_number": "21", "content_sanskrit": "सुग्रीव:स त्त्वसम्पन्न: महाबलपराक्रम: । किंमयाखलुवक्तव्योरावणोलोकरावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "mea