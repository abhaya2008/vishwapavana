[{"id": 5000208000, "chapter_id": 9208, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे द्वादशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000208001, "chapter_id": 9208, "verse_number": "३-१२-१", "content_sanskrit": "स प्रविश्याश्रमपदं लक्ष्मणो राघवानुजः।\nअगस्त्यशिष्यमासाद्य वाक्यमेतदुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000208002, "chapter_id": 9208, "verse_number": "३-१२-२", "content_sanskrit": "राजा दशरथो नाम ज्येष्ठस्तस्य सुतो बली।\nरामः प्राप्तो मुनिं द्रष्टुं भार्यया सह सीतया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000208003, "chapter_id": 9208, "verse_number": "३-१२-३", "content_sanskrit": "लक्ष्मणो नाम तस्याहं भ्राता त्ववरजो हितः।\nअनुकूलश्च भक्तश्च यदि ते श्रोत्रमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000208004, "chapter_id": 9208, "verse_number": "३-१२-४", "content_sanskrit": "ते वयं वनमत्युग्रं प्रविष्टाः पितृशासनात्।\nद्रष्टुमिच्छामहे सर्वे भगवन्तं निवेद्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000208005, "chapter_id": 9208, "verse_number": "३-१२-५", "content_sanskrit": "तस्य तद् वचनं श्रुत्वा लक्ष्मणस्य तपोधनः।\nतथेत्युक्त्वाग्निशरणं प्रविवेश निवेदितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000208006, "chapter_id": 9208, "verse_number": "३-१२-६", "content_sanskrit": "स प्रविश्य मुनिश्रेष्ठं तपसा दुष्प्रधर्षणम्।\nकृताञ्जलिरुवाचेदं रामागमनमञ्जसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000208007, "chapter_id": 9208, "verse_number": "३-१२-७", "content_sanskrit": "यथोक्तं लक्ष्मणेनैव शिष्योऽगस्त्यस्य सम्मतः।\nपुत्रौ दशरथस्येमौ रामो लक्ष्मण एव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000208008, "chapter_id": 9208, "verse_number": "३-१२-८", "content_sanskrit": "प्रविष्टावाश्रमपदं सीतया सह भार्यया।\nद्रष्टुं भवन्तमायातौ शुश्रूषार्थमरिंदमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000208009, "chapter_id": 9208, "verse_number": "३-१२-९", "content_sanskrit": "यदत्रानन्तरं तत् त्वमाज्ञापयितुमर्हसि।\nततः शिष्यादुपश्रुत्य प्राप्तं रामं सलक्ष्मणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000208010, "chapter_id": 9208, "verse_number": "३-१२-१०", "content_sanskrit": "वैदेहीं च महाभागामिदं वचनमब्रवीत्।\nदिष्ट्या रामश्चिरस्याद्य द्रष्टुं मां समुपागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000208011, "chapter_id": 9208, "verse_number": "३-१२-११", "content_sanskrit": "मनसा कांक्षितं ह्यस्य मयाप्यागमनं प्रति।\nगम्यतां सत्कृतो रामः सभार्यः सहलक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000208012, "chapter_id": 9208, "verse_number": "३-१२-१२", "content_sanskrit": "प्रवेश्यतां समीपं मे किमसौ न प्रवेशितः।\nएवमुक्तस्तु मुनिना धर्मज्ञेन महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000208013, "chapter_id": 9208, "verse_number": "३-१२-१३", "content_sanskrit": "अभिवाद्याब्रवीच्छिष्यस्तथेति नियताञ्जलिः।\nतदा निष्क्रम्य सम्भ्रान्तः शिष्यो लक्ष्मणमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000208014, "chapter_id": 9208, "verse_number": "३-१२-१४", "content_sanskrit": "कोऽसौ रामो मुनिं द्रष्टुमेतु प्रविशतु स्वयम्।\nततो गत्वाऽऽश्रमपदं शिष्येण सह लक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000208015, "chapter_id": 9208, "verse_number": "३-१२-१५", "content_sanskrit": "दर्शयामास काकुत्स्थं सीतां च जनकात्मजाम्।\nतं शिष्यः प्रश्रितं वाक्यमगस्त्यवचनं ब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000208016, "chapter_id": 9208, "verse_number": "३-१२-१६", "content_sanskrit": "प्रावेशयद् यथान्यायं सत्कारार्हं सुसत्कृतम्।\nप्रविवेश ततो रामः सीतया सह लक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000208017, "chapter_id": 9208, "verse_number": "३-१२-१७", "content_sanskrit": "प्रशान्तहरिणाकीर्णमाश्रमं ह्यवलोकयन्।\nस तत्र ब्रह्मणः स्थानमग्नेः स्थानं तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000208018, "chapter_id": 9208, "verse_number": "३-१२-१८", "content_sanskrit": "विष्णोः स्थानं महेन्द्रस्य स्थानं चैव विवस्वतः।\nसोमस्थानं भगस्थानं स्थानं कौबेरमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000208019, "chapter_id": 9208, "verse_number": "३-१२-१९", "content_sanskrit": "धातुर्विधातुः स्थानं च वायोः स्थानं तथैव च।\nस्थानं च पाशहस्तस्य वरुणस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000208020, "chapter_id": 9208, "verse_number": "३-१२-२०", "content_sanskrit": "स्थानं तथैव गायत्र्या वसूनां स्थानमेव च।\nस्थानं च नागराजस्य गरुडस्थानमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000208021, "chapter_id": 9208, "verse_number": "३-१२-२१", "content_sanskrit": "कार्तिकेयस्य च स्थानं धर्मस्थानं च पश्यति।\nततः शिष्यैः परिवृतो मुनिरप्यभिनिष्पतत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000208022, "chapter_id": 9208, "verse_number": "३-१२-२२", "content_sanskrit": "तं ददर्शाग्रतो रामो मुनीनां दीप्ततेजसाम्।\nअब्रवीद् वचनं वीरो लक्ष्मणं लक्ष्मिवर्धनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000208023, "chapter_id": 9208, "verse_number": "३-१२-२३", "content_sanskrit": "बहिर्लक्ष्मण निष्क्रामत्यगस्त्यो भगवानृषिः।\nऔदार्येणावगच्छामि निधानं तपसामिमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000208024, "chapter_id": 9208, "verse_number": "३-१२-२४", "content_sanskrit": "एवमुक्त्वा महाबाहुरगस्त्यं सूर्यवर्चसम्।\nजग्राहापततस्तस्य पादौ च रघुनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000208025, "chapter_id": 9208, "verse_number": "३-१२-२५", "content_sanskrit": "अभिवाद्य तु धर्मात्मा तस्थौ रामः कृताञ्जलिः।\nसीतया सह वैदेह्या तदा रामः सलक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000208026, "chapter_id": 9208, "verse_number": "३-१२-२६", "content_sanskrit": "प्रतिगृह्य च काकुत्स्थमर्चयित्वाऽऽसनोदकैः।\nकुशलप्रश्नमुक्त्वा च आस्यतामिति सोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000208027, "chapter_id": 9208, "verse_number": "३-१२-२७", "content_sanskrit": "अग्निं हुत्वा प्रदायार्घ्यमतिथीन् प्रतिपूज्य च।\nवानप्रस्थेन धर्मेण स तेषां भोजनं ददौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000208028, "chapter_id": 9208, "verse_number": "३-१२-२८", "content_sanskrit": "प्रथमं चोपविश्याथ धर्मज्ञो मुनिपुंगवः।\nउवाच राममासीनं प्राञ्जलिं धर्मकोविदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000208029, "chapter_id": 9208, "verse_number": "३-१२-२९", "content_sanskrit": "अग्निं हुत्वा प्रदायार्घ्यमतिथिं प्रतिपूजयेत्।\nअन्यथा खलु काकुत्स्थ तपस्वी समुदाचरन्।\nदुःसाक्षीव परे लोके स्वानि मांसानि भक्षयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000208030, "chapter_id": 9208, "verse_number": "३-१२-३०", "content_sanskrit": "राजा सर्वस्य लोकस्य धर्मचारी महारथः।\nपूजनीयश्च मान्यश्च भवान् प्राप्तः प्रियातिथिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000208031, "chapter_id": 9208, "verse_number": "३-१२-३१", "content_sanskrit": "एवमुक्त्वा फलैर्मूलैः पुष्पैश्चान्यैश्च राघवम्।\nपूजयित्वा यथाकामं ततोऽगस्त्यस्तमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000208032, "chapter_id": 9208, "verse_number": "३-१२-३२", "content_sanskrit": "इदं दिव्यं महच्चापं हेमवज्रविभूषितम्।\nवैष्णवं पुरुषव्याघ्र निर्मितं विश्वकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000208033, "chapter_id": 9208, "verse_number": "३-१२-३३", "content_sanskrit": "अमोघः सूर्यसंकाशो ब्रह्मदत्तः शरोत्तमः।\nदत्तौ मम महेन्द्रेण तूणी चाक्षय्यसायकौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000208034, "chapter_id": 9208, "verse_number": "३-१२-३४", "content_sanskrit": "सम्पूर्णौ निशितैर्बाणैर्ज्वलद्भिरिव पावकैः।\nमहाराजतकोशोऽयमसिर्हेमविभूषितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000208035, "chapter_id": 9208, "verse_number": "३-१२-३५", "content_sanskrit": "अनेन धनुषा राम हत्वा संख्ये महासुरान्।\nआजहार श्रियं दीप्तां पुरा विष्णुर्दिवौकसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000208036, "chapter_id": 9208, "verse_number": "३-१२-३६", "content_sanskrit": "तद्धनुस्तौ च तूणी च शरं खड्गं च मानद।\nजयाय प्रतिगृह्णीष्व वज्रं वज्रधरो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000208037, "chapter_id": 9208, "verse_number": "३-१२-३७", "content_sanskrit": "एवमुक्त्वा महातेजाः समस्तं तद्वरायुधम्।\nदत्त्वा रामाय भगवानगस्त्यः पुनरब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000208038, "chapter_id": 9208, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे द्वादशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]