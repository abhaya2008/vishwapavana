[{"id": 2213815, "chapter_id": 5568, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2213816, "chapter_id": 5568, "verse_number": "१", "content_sanskrit": "मोक्षं प्राप्तेथ विदुरे धृतराष्ट्रे दिवं गते ।\nसञ्जयादौ च भगवन् किमकुर्वत पाण्डवः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2213817, "chapter_id": 5568, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2213818, "chapter_id": 5568, "verse_number": "२", "content_sanskrit": "षट्त्रिंशे वत्सरे प्राप्ते तदा कौरवनन्दनः ।\nददर्श विपरीतानि निमित्तानि युधिष्ठिरः\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2213819, "chapter_id": 5568, "verse_number": "३", "content_sanskrit": "ववुर्वाताश्च निर्घाता रूक्षाः शर्करवर्षिणः ।\nअपसव्यानि शकुना मण्डलानि प्रचक्रिरे\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2213820, "chapter_id": 5568, "verse_number": "४", "content_sanskrit": "प्रत्यगूहुर्महानद्यो दिशो नीहारसंवृताः ।\nउल्काश्चाङ्गारवर्षिण्यः प्रापतन् गगनाद् भुवि\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2213821, "chapter_id": 5568, "verse_number": "५", "content_sanskrit": "आदित्यो रजसा राजन् समवच्छन्नमण्डलः ।\nविरश्मिरुदये नित्यं कबन्धैः समलङ्कृतः\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2213822, "chapter_id": 5568, "verse_number": "६", "content_sanskrit": "परिवेषाश्च दृश्यन्ते दारुणाश्चन्द्रसूर्ययोः ।\nत्रिवर्णाः श्यामरूक्षान्तास्तथा भस्मारुणप्रभाः\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2213823, "chapter_id": 5568, "verse_number": "७", "content_sanskrit": "एते चान्ये च बहव उत्पाता भयशंसिनः ।\nदृश्यन्ते जगतो नाथे दिवमारोढुमिच्छति\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2213824, "chapter_id": 5568, "verse_number": "", "content_sanskrit": "(यस्य प्रसादाद् धर्मोऽयं कृते यद्वत् कलावपि ।\nपाण्डवाश्च महाभाग युक्तास्तु यशसाऽनघ\t ॥८॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2213825, "chapter_id": 5568, "verse_number": "९", "content_sanskrit": "कस्य चित्त्वथ कालस्य कुरुराजो विशङ्कितः ।\nशुश्राव वृष्णिचक्रस्य मुसलोत्सादनं कृतम्\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2213826, "chapter_id": 5568, "verse_number": "१०", "content_sanskrit": "विमुक्तं वासुदेवं च श्रुत्वा रामं च पाण्डवः ।\nसमानीयाब्रवीद् भ्रातॄन् किं करिष्याम इत्युत\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2213827, "chapter_id": 5568, "verse_number": "११", "content_sanskrit": "परस्परं समासाद्य ब्रह्मदण्डबलात् कृतान् ।\nवृष्णीन् विनष्टांस्ते श्रुत्वा व्यथिताः पाण्डवा भृशम्\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2213828, "chapter_id": 5568, "verse_number": "१२", "content_sanskrit": "निधनं वासुदेवस्य समुद्रस्येव शोषणम् ।\nवीरा न श्रद्दधुस्तस्य विनाशं शार्ङ्गधन्वनः\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2213829, "chapter_id": 5568, "verse_number": "१३", "content_sanskrit": "मौसलं ते समाश्रित्य दुःखशोकसमन्विताः ।\nविषण्णा हतसङ्कल्पाः पाण्डवाः समुपाविशन्\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2213830, "chapter_id": 5568, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् मौसलपर्वणि\nवृष्णीनां निधनं श्रुत्वा पाण्डवानां चिन्ता नाम प्रथमोऽध्यायः ॥१॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]