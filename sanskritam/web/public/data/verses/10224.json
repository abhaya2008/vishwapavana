[{"id": 6000224000, "chapter_id": 10224, "verse_number": null, "content_sanskrit": "अथ अष्टाविंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000224001, "chapter_id": 10224, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_028/BhP_10.028.001.m4a", "display_order": 2}, {"id": 6000224002, "chapter_id": 10224, "verse_number": "१०-२८-१", "content_sanskrit": "अन्तर्हिते भगवति सहसैव व्रजाङ्गनाः।\nअतप्यंस्तमचक्षाणाः करिण्य इव यूथपम्॥ १०/२८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_028/BhP_10.028.002.m4a", "display_order": 3, "topics": [{"text": "श्रीकृष्णविरहसंतप्तानां गोपीनां तमन्विष्येतस्ततो धावनम्", "range": "१–४"}]}, {"id": 6000224003, "chapter_id": 10224, "verse_number": "१०-२८-२", "content_sanskrit": "गत्याऽनुरागस्मितरञ्जितेक्षितैर्मनोरमालापविहारविभ्रमैः।\nआक्षिप्तचित्ताः प्रमदा रमापतेस्तास्ता विचेष्टा जगृहुस्तदात्मिकाः॥ १०/२८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_028/BhP_10.028.003.m4a", "display_order": 4}, {"id": 6000224004, "chapter_id": 10224, "verse_number": "१०-२८-३", "content_sanskrit": "गतिस्मितप्रेक्षणभाषणादिषु प्रियाः प्रियस्य प्रतिरूढमूर्तयः।\nअसावहं न्वित्यबलास्तदात्मिका नावेदिषुः कृष्णविहारविभ्रमाः॥ १०/२८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_028/BhP_10.028.004.m4a", "display_order": 5}, {"id": 6000224005, "chapter_id": 10224, "verse_number": "१०-२८-४", "content_sanskrit": "गायन्त्य उच्चैरमुमेव सङ्गता विचेरुरुन्मत्तकवद् वनाद् वनम्।\nपप्रच्छुराकाशवदन्तरं बहिर्भूतेषु सन्तं पुरुषं वनस्पतीन्॥ १०/२८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_028/BhP_10.028.005.m4a", "display_order": 6}, {"id": 6000224006, "chapter_id": 10224, "verse_number": "१०-२८-५", "content_sanskrit": "दृष्टो वः कच्चिदश्वत्थ प्लक्ष न्यग्रोध किंशुक।\nनन्दसूनुरिहागात् किं सह हासावलोकनैः॥ १०/२८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_028/BhP_10.028.006.m4a", "display_order": 7, "topics": [{"text": "तासामुन्मादावस्थावर्णनम्", "range": "५–१३"}]}, {"id": 6000224007, "chapter_id": 10224, "verse_number": "१०-२८-६", "content_sanskrit": "कच्चित् कुरबकाशोक नाग पुन्नाग चम्पक।\nरामानुजो मानिनीनां दोग्धा नन्दस्य चात्मजः॥ १०/२८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_028/BhP_10.028.007.m4a", "display_order": 8}, {"id": 6000224008, "chapter_id": 10224, "verse_number": "१०-२८-७", "content_sanskrit": "कच्चित् तुलसि कल्याणि गोविन्दचरणप्रिये।\nसह त्वालिकुलैर्बिभ्रद् दृष्टस्तेऽतिप्रियोऽच्युतः॥ १०/२८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_028/BhP_10.028.008.m4a", "display_order": 9}, {"id": 6000224009, "chapter_id": 10224, "verse_number": "१०-२८-८", "content_sanskrit": "मालत्यदर्शि वः कच्चिन्मल्लिके जातियूथिके।\nप्रीतिं वा जनयन् यातः करस्पर्शेन माधवः॥ १०/२८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_028/BhP_10.028.009.m4a", "display_order": 10}, {"id": 6000224010, "chapter_id": 10224, "verse_number": "१०-२८-९", "content_sanskrit": "चूतप्रियालपनसासनकोविदारजम्ब्वर्क्षबिल्वबकुलाम्रकदम्बनीपाः।\nयेऽन्ये परार्थभविनो यमुनोपकूलाः शंसन्तु कृष्णपदवीं रहितात्मनां नः॥ १०/२८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_028/BhP_10.028.010.m4a", "display_order": 11}, {"id": 6000224011, "chapter_id": 10224, "verse_number": "१०-२८-१०", "content_sanskrit": "किं ते कृतं क्षिति शुभं बत केशवाङ्घ्रिस्पर्शोत्सवोत्पुलकिताऽङ्गरुहैर्विभासि।\nअप्यङ्घ्रिसम्भव उरुक्रमविक्रमाद्वा आहो वराहवपुषा परिरम्भणेन॥ १०/२८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_028/BhP_10.028.011.m4a", "display_order": 12}, {"id": 6000224012, "chapter_id": 10224, "verse_number": "१०-२८-११", "content_sanskrit": "अप्येणपत्न्युपगतः प्रिययेह गात्रैस्तन्वन् दृशां सखि सुनिर्वृतिमीश्वरो वः।\nकान्ताङ्गसङ्गकुचकुङ्कुमरञ्जितायाः कुन्दस्रजः कुलपतेरिह वाति गन्धः॥ १०/२८/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_028/BhP_10.028.012.m4a", "display_order": 13}, {"id": 6000224013, "chapter_id": 10224, "verse_number": "१०-२८-१२", "content_sanskrit": "बाहुं प्रियांस उपधाय गृहीतपद्मो रामानुजस्तुलसिकालिकुलैर्मदान्धैः।\nअन्वीयमान इह वस्तरवः प्रणामं किं वाऽभिनन्दति चरन् प्रणयावलोकैः॥ १०/२८/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_028/BhP_10.028.013.m4a", "display_order": 14}, {"id": 6000224014, "chapter_id": 10224, "verse_number": "१०-२८-१३", "content_sanskrit": "पश्यतेह लता बाहूनप्याश्लिष्टा वनस्पतेः।\nनूनं तत्करजस्पर्शाद् बिभ्रत्युत्पुलकान्यहो॥ १०/२८/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_028/BhP_10.028.014.m4a", "display_order": 15}, {"id": 6000224015, "chapter_id": 10224, "verse_number": "१०-२८-१४", "content_sanskrit": "एवं कृष्णं पृच्छमाना वृन्दावनलतास्तरून्।\nव्यचक्षत वनोद्देशे पदानि परमात्मनः॥ १०/२८/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_028/BhP_10.028.015.m4a", "display_order": 16, "topics": [{"text": "मध्येमार्गं दामोदरपादाङ्केन सह कस्याश्चित्पदाङ्कमपि दृष्ट्वा तासामधिकतापप्राप्तिः", "range": "१४–२७"}]}, {"id": 6000224016, "chapter_id": 10224, "verse_number": "१०-२८-१५", "content_sanskrit": "पदानि व्यक्तमेतानि नन्दसूनोर्महात्मनः।\nलक्ष्यन्ते हि ध्वजाम्भोजवज्राङ्कुशलतादिभिः॥ १०/२८/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_028/BhP_10.028.016.m4a", "display_order": 17}, {"id": 6000224017, "chapter_id": 10224, "verse_number": "१०-२८-१६", "content_sanskrit": "तैस्तैः पदैस्तत्पदवीमन्विच्छन्त्योऽग्रतोऽबलाः।\nवध्वाः पदैः सुपृक्तानि विलोक्यार्ताः समब्रुवन्॥ १०/२८/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_028/BhP_10.028.017.m4a", "display_order": 18}, {"id": 6000224018, "chapter_id": 10224, "verse_number": "१०-२८-१७", "content_sanskrit": "कस्याः पदानि चैतानि याताया नन्दसूनुना।\nअंसन्यस्तप्रकोष्ठायाः करिण्याः करिणा यथा॥ १०/२८/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_028/BhP_10.028.018.m4a", "display_order": 19}, {"id": 6000224019, "chapter_id": 10224, "verse_number": "१०-२८-१८", "content_sanskrit": "अनयाऽऽराधितो नूनं भगवान् हरिरीश्वरः।\nयन्नो विहाय गोविन्दः प्रीतो यामनयद् रहः॥ १०/२८/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_028/BhP_10.028.019.m4a", "display_order": 20}, {"id": 6000224020, "chapter_id": 10224, "verse_number": "१०-२८-१९", "content_sanskrit": "धन्या अहो अमी आल्यो गोविन्दाङ्घ्र्यब्जरेणवः।\nयान् ब्रह्मेशौ रमादेवी दधुर्मूर्ध्ना तदूतये॥ १०/२८/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_028/BhP_10.028.020.m4a", "display_order": 21}, {"id": 6000224021, "chapter_id": 10224, "verse_number": "१०-२८-२०", "content_sanskrit": "तस्या अमूनि नः क्षोभं कुर्वन्त्युच्चैः पदानि यत्।\nएकाऽपहृत्य गोपीनां रहो भुङ्क्तेऽच्युताधरम्॥ १०/२८/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_028/BhP_10.028.021.m4a", "display_order": 22}, {"id": 6000224022, "chapter_id": 10224, "verse_number": "१०-२८-२१", "content_sanskrit": "न लक्ष्यन्ते पदान्यत्र तस्या नूनं तृणाङ्कुरैः।\nखिद्यत्सुजाताङ्घ्रितलामुन्निन्ये प्रेयसीं प्रियः॥ १०/२८/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_028/BhP_10.028.022.m4a", "display_order": 23}, {"id": 6000224023, "chapter_id": 10224, "verse_number": "१०-२८-२२", "content_sanskrit": "इमान्यधिकमग्नानि पदानि वहतो वधूम्।\nगोप्यः पश्यत कृष्णस्य भाराक्रान्तानि मामिनः॥ १०/२८/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_028/BhP_10.028.023.m4a", "display_order": 24}, {"id": 6000224024, "chapter_id": 10224, "verse_number": "१०-२८-२३", "content_sanskrit": "अत्रावरोपिता कान्ता पुष्पहेतोर्महात्मना।\nअत्र प्रसूनावचयः प्रियार्थे प्रेयसा कृतः॥ १०/२८/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_028/BhP_10.028.024.m4a", "display_order": 25}, {"id": 6000224025, "chapter_id": 10224, "verse_number": "१०-२८-२४", "content_sanskrit": "प्रपदाक्रमणे एते पश्यतासकले पदे।\nकेशप्रसाधनं त्वत्र कामिन्याः कामिना कृतम्॥ १०/२८/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_028/BhP_10.028.025.m4a", "display_order": 26}, {"id": 6000224026, "chapter_id": 10224, "verse_number": "१०-२८-२५", "content_sanskrit": "तानि चूडयता कान्तामुपविष्टमिह ध्रुवम्।\nरेमे तया चात्मरत आत्मारामोऽप्यखण्डितः॥ १०/२८/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_028/BhP_10.028.026.m4a", "display_order": 27}, {"id": 6000224027, "chapter_id": 10224, "verse_number": "१०-२८-२६", "content_sanskrit": "इत्येवं प्रलपन्त्यस्ताश्चेरुर्गोप्योऽविचेतनाः।\nकामिनां दर्शयन् दैन्यं स्‍त्रीणां चैव दुरात्मताम्॥ १०/२८/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_028/BhP_10.028.027.m4a", "display_order": 28}, {"id": 6000224028, "chapter_id": 10224, "verse_number": "१०-२८-२७", "content_sanskrit": "यां गोपीमनयत्कृष्णो विहायान्याः स्‍त्रियो वने।\nसा च मेने तदाऽऽत्मानं वरिष्ठं सर्वयोषिताम्॥ १०/२८/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_028/BhP_10.028.028.m4a", "display_order": 29}, {"id": 6000224029, "chapter_id": 10224, "verse_number": "१०-२८-२८", "content_sanskrit": "हित्वा गोपीः कामयाना मामसौ भजतेऽति ह।\nततो गत्वा वनोद्देशं दृप्ता केशवमब्रवीत्॥ १०/२८/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_028/BhP_10.028.029.m4a", "display_order": 30, "topics": [{"text": "दृप्तायास्तस्या अपि गर्वभङ्गार्थं श्रीकृष्णेन त्यागः", "range": "२८–३२"}]}, {"id": 6000224030, "chapter_id": 10224, "verse_number": "१०-२८-२९", "content_sanskrit": "न पारयेऽहं चलितुं नय मां यत्र ते मनः।\nएवमुक्तः प्रियामाह स्कन्ध आरुह्यतामिति॥ १०/२८/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_028/BhP_10.028.030.m4a", "display_order": 31}, {"id": 6000224031, "chapter_id": 10224, "verse_number": "१०-२८-३०", "content_sanskrit": "ततश्चान्तर्दधे कृष्णः सा वधूरन्वतप्यत। हा नाथ रमण प्रेष्ठ क्‍वासि क्‍वासि महाभुज।\nदास्यास्ते कृपणाया मे सखे दर्शय सन्निधिम्॥ १०/२८/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_028/BhP_10.028.031.m4a", "display_order": 32}, {"id": 6000224032, "chapter_id": 10224, "verse_number": "१०-२८-३१", "content_sanskrit": "अन्विच्छन्त्यो भगवतो मार्गं गोप्योऽविदूरतः।\nददृशुः प्रियविश्लिष्टां मोहितां दुःखितां सखीम्॥ १०/२८/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_028/BhP_10.028.032.m4a", "display_order": 33}, {"id": 6000224033, "chapter_id": 10224, "verse_number": "१०-२८-३२", "content_sanskrit": "तया कथितमाकर्ण्य मानप्राप्तिं च माधवात्।\nअवमानं च दौरात्म्याद् विस्मयं परमं ययुः॥ १०/२८/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_028/BhP_10.028.033.m4a", "display_order": 34}, {"id": 6000224034, "chapter_id": 10224, "verse_number": "१०-२८-३३", "content_sanskrit": "गत्वा वनाद् वनं चन्द्रज्योत्स्ना यावद् विभाव्यते।\nतमःप्रविष्टमालक्ष्य ततो निववृतुः स्‍त्रियः॥ १०/२८/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_028/BhP_10.028.034.m4a", "display_order": 35, "topics": [{"text": "तया पूर्वविसृष्टाभिर्गोपीभिः सह यमुनापुलिने श्रीकृष्णप्रतीक्षणम्", "range": "३३–३५"}]}, {"id": 6000224035, "chapter_id": 10224, "verse_number": "१०-२८-३४", "content_sanskrit": "तन्मनस्कास्तदालापास्तद्विचेष्टास्तदात्मिकाः।\nतद्गुणानेव गायन्त्यो नात्मागाराणि सस्मरुः॥ १०/२८/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_028/BhP_10.028.035.m4a", "display_order": 36}, {"id": 6000224036, "chapter_id": 10224, "verse_number": "१०-२८-३५", "content_sanskrit": "पुनः पुलिनमागत्य कालिन्द्याः कृष्णभावनाः।\nसमवेता जगुः कृष्णं तदागमनकाङ्क्षिणीः॥ १०/२८/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_028/BhP_10.028.036.m4a", "display_order": 37}, {"id": 6000224037, "chapter_id": 10224, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे अष्टाविंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]