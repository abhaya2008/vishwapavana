[{"id": 7003885000, "chapter_id": 23885, "verse_number": "२-७-१५-१", "content_sanskrit": "श्रुतदेव उवाच ।\nभूयः शृणुष्व भूपाल माहात्म्यं पापनाशनम् ।\nवैशाखस्य च मासस्य वल्लभस्य मधुद्विषः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003885001, "chapter_id": 23885, "verse_number": "२-७-१५-२", "content_sanskrit": "पुरा पांचालदेशे तु राजा पुरुयशोऽभवत् ।\nतनयो भूरियशसः पुण्यशीलस्य धीमतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003885002, "chapter_id": 23885, "verse_number": "२-७-१५-३", "content_sanskrit": "पितर्युपरते भूप राज्यस्थो धर्मलालसः ।\nशौर्यौदार्यगुणोपेतो धनुर्विद्याविशारदः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003885003, "chapter_id": 23885, "verse_number": "२-७-१५-४", "content_sanskrit": "शशास पृथिवीं सर्वां स्वधर्मेण महामतिः ।\nपूर्वजन्मजलादानाद्दोषेण महता वृतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003885004, "chapter_id": 23885, "verse_number": "२-७-१५-५", "content_sanskrit": "संपद्धानिमवापाऽसौ कालेन कियताऽनघ ।\nहया गजा मृतिं याता महद्रोगेण पीडिताः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003885005, "chapter_id": 23885, "verse_number": "२-७-१५-६", "content_sanskrit": "दुर्भिक्षमतुलं चासीन्निर्मानुष्यविधायकम् ।\nराज्यं कोशं तदा चाऽसीद्गजभुक्तकपित्थवत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003885006, "chapter_id": 23885, "verse_number": "२-७-१५-७", "content_sanskrit": "बलहीनं नृपं ज्ञात्वा कोशराष्ट्रविवर्जितम् ।\nतं जेतुमेष समय इति निश्चितमानसाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003885007, "chapter_id": 23885, "verse_number": "२-७-१५-८", "content_sanskrit": "आजग्मुः शतशो भूपा रिपवस्तस्य भूपतेः ।\nजिग्युर्युद्धेन तं भूपं पांचालविषयाधिपम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003885008, "chapter_id": 23885, "verse_number": "२-७-१५-९", "content_sanskrit": "पराजितस्ततो राजा विवेश गिरिगह्वरे ।\nशिखिन्या भार्यया साकं धात्र्यादिगणसंयुतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003885009, "chapter_id": 23885, "verse_number": "२-७-१५-१०", "content_sanskrit": "अज्ञातपद्धतिश्चान्यैर्बहुदुःखसमाकुलः ।\nत्रिपंचाशत्समाश्चैव नीतास्तेन विलीयता ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003885010, "chapter_id": 23885, "verse_number": "२-७-१५-११", "content_sanskrit": "चिन्तयामास भूपालः किमेतदिति भूरिशः ।\nकर्मणा जन्मशुद्धोऽहं मातृपितृहिते रतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003885011, "chapter_id": 23885, "verse_number": "२-७-१५-१२", "content_sanskrit": "गुरुभक्तः सदाक्षिण्यो ब्रह्मण्यो धर्मतत्परः ।\nदयावान्सर्वभूतेषु देवभक्तो जितेन्द्रियः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003885012, "chapter_id": 23885, "verse_number": "२-७-१५-१३", "content_sanskrit": "न भ्राता मे न पुत्रो मे न च मे सुहृदो हिताः ।\nदयापौरुषविख्याताः कुलीनस्याऽपि मे कुतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003885013, "chapter_id": 23885, "verse_number": "२-७-१५-१४", "content_sanskrit": "केन वा कर्मणा चाप्तं दारिद्र्यं भूरिदुःखदम् ।\nकेन वाऽपजयो मेऽद्य केन वा वनवासिता ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003885014, "chapter_id": 23885, "verse_number": "२-७-१५-१५", "content_sanskrit": "इति चिन्ताकुलो राजा गुरुं सस्मार खिन्नधीः ।\nयाजोपयाजकौ नाम सर्वज्ञौ मुनिसत्तमौ ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003885015, "chapter_id": 23885, "verse_number": "२-७-१५-१६", "content_sanskrit": "आजग्मतुर्मुनीद्रौ तौ राज्ञाहूतौ महामती ।\nतौ दृष्ट्वा सहसोत्थाय राजा पांचालवल्लभः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003885016, "chapter_id": 23885, "verse_number": "२-७-१५-१७", "content_sanskrit": "ननाम शिरसा भक्त्या प्रवासेनाऽतिपीडितः ।\nराजचिह्नविहीनश्च केनाप्यज्ञातपद्धतिः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003885017, "chapter_id": 23885, "verse_number": "२-७-१५-१८", "content_sanskrit": "तूष्णीं तस्थौ मुहूर्तं हि पतित्वा भुवि पादयोः ।\nदोर्भ्यामुत्थापितस्ताभ्यां परिमृष्टाऽश्रुलोचनः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003885018, "chapter_id": 23885, "verse_number": "२-७-१५-१९", "content_sanskrit": "विधिवत्पूजयामास वन्यैरेवाऽर्हणैः शुभैः ।\nसूपविष्टौ तु तौ विप्रौ पप्रच्छाऽनतकन्धरः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003885019, "chapter_id": 23885, "verse_number": "२-७-१५-२०", "content_sanskrit": "ब्राह्मणौ वदतं दुःखकारणं च क्षितीशितुः ।\nकर्मणा जन्मशुद्धस्य पितृदेवप्रियस्य च ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003885020, "chapter_id": 23885, "verse_number": "२-७-१५-२१", "content_sanskrit": "पापभीरोः कृपालोश्च गुरुभक्तस्य मे कुतः ।\nदारिद्र्यं कोशहानिश्च रिपुभिश्च पराभवः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003885021, "chapter_id": 23885, "verse_number": "२-७-१५-२२", "content_sanskrit": "कस्मादरण्यवासश्च कुत एकाकिता मम ।\nन पुत्रो न च मे भ्राता न हिताः सुहृदश्च मे ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003885022, "chapter_id": 23885, "verse_number": "२-७-१५-२३", "content_sanskrit": "दुर्भिक्षं वा कुतश्चासीद्देशे मत्पालितेऽनघे ।\nएतद्विस्तार्य मे ब्रूतं कारणं मुनिपुंगवौ ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003885023, "chapter_id": 23885, "verse_number": "२-७-१५-२४", "content_sanskrit": "इत्युक्तौ तौ मुनिश्रेष्ठौ भूतेनात्यन्तदुःखिना ।\nप्रत्यूचतुर्महात्मानौ किंचिद्ध्यानपरायणौ ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003885024, "chapter_id": 23885, "verse_number": "२-७-१५-२५", "content_sanskrit": "याजोपयाजकावूचतुः ।\nशृणु भूप प्रवक्ष्यावस्तव दुःखस्य कारणम् ।\nपुरा भूप महापापी व्याधस्त्वं दशजन्मसु ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003885025, "chapter_id": 23885, "verse_number": "२-७-१५-२६", "content_sanskrit": "निष्ठुरः सर्वलोकानां सदा हिंसापरायणः ।\nधर्मलेशाकरः क्वापि न दमो न च वै शमः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003885026, "chapter_id": 23885, "verse_number": "२-७-१५-२७", "content_sanskrit": "न जिह्वा वक्ति नामानि विष्णोर्वापि कथंचन ।\nचेतः स्मरति गोविन्दचरणांबुरुहद्वयम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003885027, "chapter_id": 23885, "verse_number": "२-७-१५-२८", "content_sanskrit": "न प्रणामः कृतः क्वापि शिरसा परमात्मने ।\nनवजन्मानि ते भूप गतान्येवं दुरात्मनः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003885028, "chapter_id": 23885, "verse_number": "२-७-१५-२९", "content_sanskrit": "दशमे जन्मनि प्राप्ते व्याधस्त्वं सह्य भूधरे ।\nनिष्ठुरः सर्वलोकानां नराणां त्वं नरांतकः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003885029, "chapter_id": 23885, "verse_number": "२-७-१५-३०", "content_sanskrit": "दयाहीनः शस्त्रजीवी सदा हिंसापरायणः ।\nनिर्गुणः सकलत्रस्त्वं मार्गपीडाकरः शठः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003885030, "chapter_id": 23885, "verse_number": "२-७-१५-३१", "content_sanskrit": "प्रजानां गौडदेश्यानां राक्षसो मानुषाशनः॥ एवं चा  ।\nब्दान्यतीतानि नैजं हितमजानतः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003885031, "chapter_id": 23885, "verse_number": "२-७-१५-३२", "content_sanskrit": "बालापत्यमृगाणां च पक्षिणां च वधात्तव॥  ।\nदयाहीनस्य दुर्बुद्धेर्जन्मन्यस्मिन्नपुत्रता ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003885032, "chapter_id": 23885, "verse_number": "२-७-१५-३३", "content_sanskrit": "विश्वासघातकत्वेन भ्रातरो नैव सोदराः ।\nमार्गपीडाकरत्वेन सुहृज्जनविवर्जितः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003885033, "chapter_id": 23885, "verse_number": "२-७-१५-३४", "content_sanskrit": "साधूनां च तिरस्काराच्छत्रुभिस्ते पराजयः ।\nकदाप्यदत्तदोषेण दारिद्यं पतितं गृहे ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003885034, "chapter_id": 23885, "verse_number": "२-७-१५-३५", "content_sanskrit": "सदैवोद्वेगकारित्वात्प्रवासस्ते दुरासदः ।\nसर्वेषामप्रियत्वाच्च दुःखमत्यंतदुःसहम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003885035, "chapter_id": 23885, "verse_number": "२-७-१५-३६", "content_sanskrit": "निराहारोप्यतः पूर्वं सदा क्रूरेण कर्मणा ।\nतस्माद्राज्यापहारस्ते जन्मन्यस्मिन्महामते ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003885036, "chapter_id": 23885, "verse_number": "२-७-१५-३७", "content_sanskrit": "अथ ते सत्कुलीनत्वे हेतूंश्चापि ब्रवीम्यहम् ।\nयदाऽभूर्गौडदेशीयो ह्यंतिमे व्याधजन्मनि ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003885037, "chapter_id": 23885, "verse_number": "२-७-१५-३८", "content_sanskrit": "स्वकर्मनिरते क्रूरे विपिने कण्टकाविले ।\nतिष्ठत्येवं दयाहीने सर्वभूतांतके पथि ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003885038, "chapter_id": 23885, "verse_number": "२-७-१५-३९", "content_sanskrit": "वैश्यावाजग्मतुर्दिव्यौ धनाढ्यौ घर्मपीडितौ ।\nमुनिश्च कर्षणोनाम वेदवेदांगपारगः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003885039, "chapter_id": 23885, "verse_number": "२-७-१५-४०", "content_sanskrit": "जटाचीरधरः पुण्यः कमण्डलुपरिग्रहः ।\nतान्दृष्ट्वा धनुरादाय मार्गं रुद्ध्वा व्यवस्थितः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003885040, "chapter_id": 23885, "verse_number": "२-७-१५-४१", "content_sanskrit": "अनुद्रुत्य शरी वैश्यौ कृत्वा छिन्नशरीरकौ ।\nतयोरेकं च त्वं हत्वा गृहीत्वाऽखिल तत्पणम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003885041, "chapter_id": 23885, "verse_number": "२-७-१५-४२", "content_sanskrit": "अपरं हन्तुमुद्युक्ते स दुद्राव भयाद्द्रुतम् ।\nपणं गुल्मे विनिक्षिप्य भीतः प्राणपरीप्सकः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003885042, "chapter_id": 23885, "verse_number": "२-७-१५-४३", "content_sanskrit": "कर्षणोऽपि मुनिः शीघ्रं व्याधान्मृतिविशंकया ।\nआतपे धावमानः संस्तृषाघर्मप्रपीडितः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003885043, "chapter_id": 23885, "verse_number": "२-७-१५-४४", "content_sanskrit": "मूर्च्छामाप गलत्स्वेदः संज्ञामात्रावशेषितः ।\nविहायैनं दुद्रुवे च वैश्यो जीवनतत्परः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003885044, "chapter_id": 23885, "verse_number": "२-७-१५-४५", "content_sanskrit": "त्वं तावनुद्रुतौ दृष्ट्वा मूर्छितं पथि भूसुरम् ।\nपणं कुत्र विनिक्षिप्तं कियद्दूरं गतो वणिक् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003885045, "chapter_id": 23885, "verse_number": "२-७-१५-४६", "content_sanskrit": "इति पृष्टं द्विजं श्रांतमुज्जीवयितुमुद्यतः ।\nफूत्कृत्वा कर्णयोस्तस्य नागरं स्मृतिकारणम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003885046, "chapter_id": 23885, "verse_number": "२-७-१५-४७", "content_sanskrit": "पल्वलस्थोदकेनैव कृमिकर्दमसंयुजा ।\nनेत्रे संमृज्य श्रांतस्य पर्णैः संवीज्य तन्मुखे ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003885047, "chapter_id": 23885, "verse_number": "२-७-१५-४८", "content_sanskrit": "ससंज्ञं च मुनिं कृत्वा त्वमात्थ स्वस्थमानसः ।\nमा शंका ते मुने कार्या मत्तः शस्त्रभृतो वने ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003885048, "chapter_id": 23885, "verse_number": "२-७-१५-४९", "content_sanskrit": "निष्किंचनः सुखी लोके कुतस्ते भयमुल्बणम् ।\nभिन्नपात्रेण जीर्णेन न मे किंचिद्भविष्यति ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003885049, "chapter_id": 23885, "verse_number": "२-७-१५-५०", "content_sanskrit": "एतावद्वद मे विद्वन्वणिक्कुत्र पलायितः ।\nकुत्र गुल्मे धनं क्षिप्तं तेन शीघ्रं पलायता ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003885050, "chapter_id": 23885, "verse_number": "२-७-१५-५१", "content_sanskrit": "अन्यथा त्वां हनिष्यामि यदि मिथ्या वदिष्यसि ।\nकर्षण उवाच ।\nधनं गुल्मे विनिक्षिप्तं मार्गादस्मात्पलायितः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003885051, "chapter_id": 23885, "verse_number": "२-७-१५-५२", "content_sanskrit": "इति प्राह भयात्सोपि पृष्टः प्राणपरीप्सया ।\nगच्छ विप्र सुखं मार्गं मत्तो भीतिं विहाय व ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003885052, "chapter_id": 23885, "verse_number": "२-७-१५-५३", "content_sanskrit": "इतो विदूरे सलिलं तडागे वर्तते शुभम् ।\nतत्पीत्वा सलिलं पुण्यं गच्छ ग्रामं गतश्रमः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003885053, "chapter_id": 23885, "verse_number": "२-७-१५-५४", "content_sanskrit": "अधुनैवागमिष्यंति राजकीयाः पथा जनाः ।\nमत्पदान्वेषणे सक्ताः श्रुत्वा रावं वणिक्पतेः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003885054, "chapter_id": 23885, "verse_number": "२-७-१५-५५", "content_sanskrit": "तृषार्तमनुगंतुं मे न शक्यं त्वां ततो द्विज ।\nवीजयानेन पर्णेन घर्मः किंचिद्गमिष्यति ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003885055, "chapter_id": 23885, "verse_number": "२-७-१५-५६", "content_sanskrit": "तस्मै दत्त्वा पलाशं च त्वमागा विपिनं पुनः ।\nतेन पुण्यप्रभावेन वैशाखे घर्मघर्घरे ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003885056, "chapter_id": 23885, "verse_number": "२-७-१५-५७", "content_sanskrit": "स्वकार्यार्थं कृतेनापि मुनेस्त्राणाय पद्धतौ ।\nजन्मासीत्ते महापुण्ये राजवंशेऽतिविस्तृते ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003885057, "chapter_id": 23885, "verse_number": "२-७-१५-५८", "content_sanskrit": "यदीच्छसि सुखं राज्यं धनधान्यादिसंपदः ।\nस्वर्गापवर्गौ यदि वा सायुज्यं वा हरेः पदम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003885058, "chapter_id": 23885, "verse_number": "२-७-१५-५९", "content_sanskrit": "कुरु वैशाखधर्मांस्त्वं सर्वसौख्यमवाप्स्यसि ।\nमासोऽयं माधवो नाम तृतीया चाक्षयाह्वया ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003885059, "chapter_id": 23885, "verse_number": "२-७-१५-६०", "content_sanskrit": "गां च सकृत्प्रसूताख्यां देहि विप्राय सीदते ।\nतेन ते कोशपूर्तिः स्याच्छय्यां देहि सुखं भवेत् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003885060, "chapter_id": 23885, "verse_number": "२-७-१५-६१", "content_sanskrit": "कुरु च्छत्रप्रदानं च साम्राज्यं ते भविष्यति ।\nस्नानं कुरु यथान्यायं तथैवार्चय माधवम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003885061, "chapter_id": 23885, "verse_number": "२-७-१५-६२", "content_sanskrit": "देहि त्वं प्रतिमां दिव्यां कृत्वा तेन जयो भवेत् ।\nआत्मतुल्यगुणान्पुत्रान्यदि कामयसे नृप ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003885062, "chapter_id": 23885, "verse_number": "२-७-१५-६३", "content_sanskrit": "सर्वभूतहितार्थाय प्रपादानं च त्वं कुरु ।\nवैशाखोक्तानिमान्धर्मान्सम्यगाचर भूमिप ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003885063, "chapter_id": 23885, "verse_number": "२-७-१५-६४", "content_sanskrit": "तेन ते सकला लोका वशं यांति न संशयः ।\nनिष्कामकेन चित्तेन यदि धर्मान्करिष्यसि ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003885064, "chapter_id": 23885, "verse_number": "२-७-१५-६५", "content_sanskrit": "वैशाखे पुण्यमासेऽस्मिन्प्रीतये मधुघातिनः ।\nप्रत्यक्षो भविता विष्णुस्तवनिर्मलचेतसः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003885065, "chapter_id": 23885, "verse_number": "२-७-१५-६६", "content_sanskrit": "येन चाचरिताः पुंसा धर्माह्येते शुभावहाः ।\nतेषां च ह्यक्षया लोकाः पुराणे कवयो विदुः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003885066, "chapter_id": 23885, "verse_number": "२-७-१५-६७", "content_sanskrit": "एतत्सर्वं तव प्रोक्तं यथादृष्टं यथाश्रुतम् ।\nइति राजानमामंत्र्य ब्राह्मणौ च पुरोधसौ ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003885067, "chapter_id": 23885, "verse_number": "२-७-१५-६८", "content_sanskrit": "याजोपयाजकौनाम जग्मतुस्तौ यथागतौ ।\nततो राजा महावीर्यः पुरोधोभ्यां च बोधितः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003885068, "chapter_id": 23885, "verse_number": "२-७-१५-६९", "content_sanskrit": "वैशाखधर्मात्सकलांश्चकार श्रद्धयाऽन्वितः ।\nयथोपदिष्टं च तथा मधुसूदनमर्चयत् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003885069, "chapter_id": 23885, "verse_number": "२-७-१५-७०", "content_sanskrit": "ततो लब्धप्रभावः सन्बंधुभिः सकलैर्वृतः ।\nपांचालनगरीं प्राप हतशेषबलान्वितः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003885070, "chapter_id": 23885, "verse_number": "२-७-१५-७१", "content_sanskrit": "ततस्तु शत्रवो भूपा उपश्रुत्य च भूपतेः ।\nप्रवेशं च पुरस्याऽथ पुनराजग्मुरुद्धताः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003885071, "chapter_id": 23885, "verse_number": "२-७-१५-७२", "content_sanskrit": "तदा पांचालभूपेन नृपाणामभवद्रणम् ।\nजिग्ये सर्वान्महाबाहूनेक एव महारथः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003885072, "chapter_id": 23885, "verse_number": "२-७-१५-७३", "content_sanskrit": "पलायितेषु भूपेषु नानादेशपथिष्वपि ।\nराज्ञां कोशगजानश्वान्स्वयं जग्राह वीर्यवान् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003885073, "chapter_id": 23885, "verse_number": "२-७-१५-७४", "content_sanskrit": "अश्वानां निर्बुदं चैव गजानां च त्रिकोटिकम् ।\nरथानामर्बुदं चैव दीर्घग्रीवायुतं तथा ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003885074, "chapter_id": 23885, "verse_number": "२-७-१५-७५", "content_sanskrit": "रासभाणां त्रिलक्षाणि प्रापयामास तां पुरीम् ।\nवैशाखधर्ममाहात्म्यात्क्षणात्सर्वे च भूभृतः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003885075, "chapter_id": 23885, "verse_number": "२-७-१५-७६", "content_sanskrit": "करदा भग्नसंकल्पाः पादाक्रांता बभूविरे ।\nसुभिक्षमतुलं चासीत्पांचालविषयेषु च ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003885076, "chapter_id": 23885, "verse_number": "२-७-१५-७७", "content_sanskrit": "एकच्छत्रमभूद्राज्यं प्रसादान्मधुघातिनः ।\nपुत्राः पंचाऽपि तस्यासञ्च्छौर्य्यौदार्यगुणान्विताः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003885077, "chapter_id": 23885, "verse_number": "२-७-१५-७८", "content_sanskrit": "धृष्टकीर्तिर्धृष्टकेतुर्धृष्टद्युम्नस्तथाऽपरे ।\nविजयश्चित्रकेतुश्च मयूरध्वजसन्निभाः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003885078, "chapter_id": 23885, "verse_number": "२-७-१५-७९", "content_sanskrit": "अनुरक्ताः प्रजाश्चासन्धर्मेण प्रतिपालिताः ।\nवैशाखस्य प्रतापेन प्रत्ययस्तत्क्षणादभूत् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003885079, "chapter_id": 23885, "verse_number": "२-७-१५-८०", "content_sanskrit": "पुनश्चकार तान्धर्मान्पांचालनगरीश्वरः ।\nअकामुकेन चित्तेन प्रीतये मधुघातिनः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003885080, "chapter_id": 23885, "verse_number": "२-७-१५-८१", "content_sanskrit": "धर्मेणानेन संतुष्टो भगवान्मधुसूदनः ।\nअक्षयायां तृतीयायां प्रत्यक्षः समजायत ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003885081, "chapter_id": 23885, "verse_number": "२-७-१५-८२", "content_sanskrit": "तं दृष्ट्वा विस्मितो भूत्वा परमात्मानमच्युतम् ।\nनारायणं चतुर्बाहुं शंखचकगदाधरम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003885082, "chapter_id": 23885, "verse_number": "२-७-१५-८३", "content_sanskrit": "पीतांबरधरं देवं वनमालाविभूषितम् ।\nसलक्ष्मीकं सानुगं च गरुडोपरि संस्थितम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003885083, "chapter_id": 23885, "verse_number": "२-७-१५-८४", "content_sanskrit": "निरीक्ष्य दुःसहं तेजः सद्यो मीलितलोचनः ।\nउत्पतन्संपतन्हर्षान्मत्तोन्मत्त इव भ्रमन् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003885084, "chapter_id": 23885, "verse_number": "२-७-१५-८५", "content_sanskrit": "पुलकांकितसर्वांगो गलद्वाष्पाकुलेक्षणः ।\nतुष्टाव परया भक्त्या प्रांजलिः प्रणतो भुवि ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003885085, "chapter_id": 23885, "verse_number": "२-७-१५-८६", "content_sanskrit": "इति श्रीस्कांदे महा पुराण एकाशीतिसाहस्र्यां संहितायां द्वितीये वैष्णवखण्डे वैशाखमास माहात्म्ये नारदाम्बरीषसंवादे पांचालदेशाधिपतेर्जयप्राप्ति दरिद्रनाशवर्णनं नाम पंचदशोऽध्यायः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}]