[{"id": 2044908, "chapter_id": 2002, "verse_number": "६-५१-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2044909, "chapter_id": 2002, "verse_number": "६-५१-१", "content_sanskrit": "क्रौञ्चं दृष्ट्वा ततो व्यूहमभेद्यं तनयस्तव ।\nरक्षमाणं महाघोरं पार्थेनामिततेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2044910, "chapter_id": 2002, "verse_number": "६-५१-२", "content_sanskrit": "आचार्यमुपसंगम्य कृपं शल्यं च पार्थिव ।\nसौमदत्तिं विकर्णं च सोऽश्वत्थामानमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2044911, "chapter_id": 2002, "verse_number": "६-५१-३", "content_sanskrit": "दुःशाकसनादीन्भ्रातॄंश्च सर्वनेव च भारत ।\nअन्यांश्च सुबहूञ्शूरान्युद्धाय समुपागतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2044912, "chapter_id": 2002, "verse_number": "६-५१-४", "content_sanskrit": "प्राहेदं वचनं काले हर्षयंस्तनयस्तव ।\nनानाशस्त्रप्रहरणाः सर्वे युद्धविशारदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2044913, "chapter_id": 2002, "verse_number": "६-५१-५", "content_sanskrit": "एकैकशः समर्था हि यूयं सर्वे महारथाः ।\nपाण्डुपुत्रान्रणे हन्तुं ससैन्यान्किमु संहताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2044914, "chapter_id": 2002, "verse_number": "६-५१-६", "content_sanskrit": "अपर्याप्तं तदस्माकं बलं भीष्माभिरक्षितम् ।\nपर्याप्तमिदमेतेषां बलं भीमाभिरक्षितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2044915, "chapter_id": 2002, "verse_number": "६-५१-७", "content_sanskrit": "संस्थानाः शूरसेनाश्च वेत्रिकाः कुकुरास्तथा ।\nआरोचकास्त्रिगर्ताश्च मद्रका यवनास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2044916, "chapter_id": 2002, "verse_number": "६-५१-८", "content_sanskrit": "शत्रुंजयेन सहितास्तथा दुःशासनेन च ।\nविकर्णेन च वीरेण तथा नन्दोपनन्दकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2044917, "chapter_id": 2002, "verse_number": "६-५१-९", "content_sanskrit": "चित्रसेनेन सहिताः सहिताः पारिभद्रकैः ।\nभीष्ममेवाभिरक्षन्तु सह सैन्यपुरस्कृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2044918, "chapter_id": 2002, "verse_number": "६-५१-१०", "content_sanskrit": "ततो भीष्मश्च द्रोणश्च तव पुत्राश्च मारिष ।\nअव्यूहन्त महाव्यूहं पाण्डूनां प्रतिबाधकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2044919, "chapter_id": 2002, "verse_number": "६-५१-११", "content_sanskrit": "भीष्मः सैन्येन महता समनन्तात्परिवारितः ।\nययौ प्रकर्षन्महतीं वाहिनीं सरराडिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2044920, "chapter_id": 2002, "verse_number": "६-५१-१२", "content_sanskrit": "तमन्वायान्महेष्वासो भारद्वाजः प्रतापवान् ।\nकुन्तलैश्च दशार्णैश्च मागधैश्च विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2044921, "chapter_id": 2002, "verse_number": "६-५१-१३", "content_sanskrit": "विदमर्भैर्मेकलैश्चैव कर्णप्रावरणैरपि ।\nसहिताः सर्वसैन्येन भीष्ममहावशोभिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2044922, "chapter_id": 2002, "verse_number": "६-५१-१४", "content_sanskrit": "गान्धाराः सिन्धुसौवीराः शिबयोऽथ वसातयः।\nशकुनिश्च स्वसैन्येन भीष्ममाहवशोभिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2044923, "chapter_id": 2002, "verse_number": "६-५१-१५", "content_sanskrit": "ततो दुर्योधनो राजा सहितः सर्वसोदरैः ।\nअश्वातर्केर्विकर्णैश्च तथा चाम्बष्ठकोसलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2044924, "chapter_id": 2002, "verse_number": "६-५१-१६", "content_sanskrit": "दरदैश्च शकैश्चैव तथा क्षुद्रकमालवैः ।\nअभ्यरक्षत संहृष्टः सौबलेयस्य वाहिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2044925, "chapter_id": 2002, "verse_number": "६-५१-१७", "content_sanskrit": "भूरिश्रवाः शलः शल्यो भगदत्तश्च मारिषः।\nविन्दानुविन्दावावन्त्यौ वामं पार्श्वमपालयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2044926, "chapter_id": 2002, "verse_number": "६-५१-१८", "content_sanskrit": "सौमदत्तिः सुशर्मा च काम्भोजश्च सुदक्षिणः।\nश्रुतायुश्चाच्युतायुश्च दक्षिणं पक्षमास्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2044927, "chapter_id": 2002, "verse_number": "६-५१-१९", "content_sanskrit": "अश्वत्थामा कृपश्चैव कृतवर्मा च सात्वतः ।\nमहत्या सेनया सार्धं सेनापृष्टे व्यवस्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2044928, "chapter_id": 2002, "verse_number": "६-५१-२०", "content_sanskrit": "पृष्ठगोपास्तु तस्यासन्नानादेश्या जनेश्वराः। ६-५१-२०bकेतुमान्वसुदानश्च पुत्रः काश्यस्य चाभिभूः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2044929, "chapter_id": 2002, "verse_number": "६-५१-२१", "content_sanskrit": "ततस्ते तावकाः सर्वे हृष्टा युद्धाय भारत।\nदध्मुः शङ्खान्मुदा युक्ताः सिंहनादांस्तथोन्नदन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2044930, "chapter_id": 2002, "verse_number": "६-५१-२२", "content_sanskrit": "तेषां श्रुत्वा तु हृष्टानां वृद्धः कुरुपितामहः।\nसिंहनादं विनद्योच्चैः शङ्खं दध्मौ प्रतापवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2044931, "chapter_id": 2002, "verse_number": "६-५१-२३", "content_sanskrit": "ततः शङ्खाश्च भेर्यश्च पेश्यश्च विविधाः परैः।\nआनकाश्चाभ्यहन्यन्त स शब्दस्तुमुलोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2044932, "chapter_id": 2002, "verse_number": "६-५१-२४", "content_sanskrit": "ततः श्वेतैर्हयैर्युक्ते महति स्यन्दने स्थितौ ।\nप्रदध्मतुः शङ्खवरौ हेमरत्नपरिष्कृतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2044933, "chapter_id": 2002, "verse_number": "६-५१-२५", "content_sanskrit": "पाञ्चजन्यं हृषीकेशो देवदत्तं धनंजयः।\nपौण्ड्रं दध्मौ महाशङ्खं भीमकर्मा वृकोदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2044934, "chapter_id": 2002, "verse_number": "६-५१-२६", "content_sanskrit": "अन्तविजयं राजा कुन्तीपुत्रो युधिष्ठिरः।\nनकुलः सहदेवश्च सुघोषमणिपुष्पकौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2044935, "chapter_id": 2002, "verse_number": "६-५१-२७", "content_sanskrit": "काशिराजश्च शैब्यश्च शिखण्डी च महारथः ।\nधृष्टद्युम्नो विराटश्च सात्यकिश्च महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2044936, "chapter_id": 2002, "verse_number": "६-५१-२८", "content_sanskrit": "पाञ्चाल्याश्च महेष्वासा द्रौपद्याः पञ्च चात्मजाः ।\nसर्वे दध्युर्महाशङ्खान्सिंहनादांश्च नेदिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2044937, "chapter_id": 2002, "verse_number": "६-५१-२९", "content_sanskrit": "स घोषः सुमहांस्तत्र वीरैस्तैः समुदीरितः।\nनभश्च पृथिवीं चैव तुमुलो व्यनुनादयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2044938, "chapter_id": 2002, "verse_number": "६-५१-३०", "content_sanskrit": "एवमेते महाराज प्रहृष्टाः कुरुपाण्डवाः।\nपुनर्युद्धाय संजग्मुस्तापयानाः परस्परम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2044939, "chapter_id": 2002, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि द्वितीयदिवसयुद्धे एकपञ्चाशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]