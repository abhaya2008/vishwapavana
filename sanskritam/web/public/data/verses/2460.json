[{"id": 2069845, "chapter_id": 2460, "verse_number": "१०-१२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2069846, "chapter_id": 2460, "verse_number": "१०-१२-१", "content_sanskrit": "तस्मिन्प्रयाते दुर्धर्षे यदूनामृषभस्ततः।\nअब्रवीत्पुण्डरीकाक्षः कुन्तीपुत्रं युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2069847, "chapter_id": 2460, "verse_number": "१०-१२-२", "content_sanskrit": "एष पाण़्डवे ते भ्राता पुत्रशोकपरायणः।\nजिघांसुर्द्रौणिमाक्रन्दे एक एवाभिधावति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2069848, "chapter_id": 2460, "verse_number": "१०-१२-३", "content_sanskrit": "भीमः प्रियस्ते सर्वेभ्यो भ्रातृभ्यो भरतर्षभ।\nतं कृच्छ्रगतमद्य त्वं कस्मान्नाभ्युपपद्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2069849, "chapter_id": 2460, "verse_number": "१०-१२-४", "content_sanskrit": "यत्तदाचष्ट पुत्राय द्रोणः परपुरञ्जयः।\nअस्त्रं ब्रह्मशिरो नाम दहेत पृथिवीमपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2069850, "chapter_id": 2460, "verse_number": "१०-१२-५", "content_sanskrit": "तन्महात्मा महाभागः केतुः सर्वधनुष्मताम्।\nप्रत्यपायदाचार्यः प्रीयमाणो धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2069851, "chapter_id": 2460, "verse_number": "१०-१२-६", "content_sanskrit": "तं पुत्रोऽप्येक एवैनमन्वयाचदमर्षणः।\nततः प्रोवाच पुत्राय नातिहृष्टमना इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2069852, "chapter_id": 2460, "verse_number": "१०-१२-७", "content_sanskrit": "विदितं चापलं ह्यासीदात्मजस्य दुरात्मनः।\nसर्वधर्मविदाचार्यः सोऽन्वशासत्सुतं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2069853, "chapter_id": 2460, "verse_number": "१०-१२-८", "content_sanskrit": "परमापद्गतेनापि न स्म तात त्वया रणे।\nइदमस्त्रं प्रयोक्तव्यं मानुषेषु विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2069854, "chapter_id": 2460, "verse_number": "१०-१२-९", "content_sanskrit": "इत्युक्त्वान्गुरुः पुत्रं द्रोणः पश्चाथोक्तवान्।\nन त्वं जातु सतां मार्गे स्थातेति पुरुषर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2069855, "chapter_id": 2460, "verse_number": "१०-१२-१०", "content_sanskrit": "स तदाज्ञाय दुष्टात्मा पितुर्वचनमप्रियम्।\nनिराशः सर्वकल्याणैः शोकात्पर्यचरन्महीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2069856, "chapter_id": 2460, "verse_number": "१०-१२-११", "content_sanskrit": "ततस्तदा कुरुश्रेष्ठ वनस्थे त्वयि भारत।\nअवसद्द्वारकामेत्य वृष्णिभिः परमार्चितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2069857, "chapter_id": 2460, "verse_number": "१०-१२-१२", "content_sanskrit": "स कदाचित्समुद्रान्ते वसन्द्वारवतीमनु।\nएक एकं समागम्य मामुवाच हसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2069858, "chapter_id": 2460, "verse_number": "१०-१२-१३", "content_sanskrit": "यत्तदुग्रं तपः कृष्ण चरन्नमितविक्रमः।\nअगस्त्याद्भारताचार्यः प्रत्यपद्यत मे पिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2069859, "chapter_id": 2460, "verse_number": "१०-१२-१४", "content_sanskrit": "अस्त्रं ब्रह्मशिरो नाम देवगन्धर्वपूजितम्।\nतदद्य मयि दाशार्ह यथा पितरि मे तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2069860, "chapter_id": 2460, "verse_number": "१०-१२-१५", "content_sanskrit": "अस्मत्तस्दुपादाय दिव्यमस्त्रं यदूत्तम।\nममाप्यस्रं प्रयच्छ त्वं चक्रं रिपुहणं रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2069861, "chapter_id": 2460, "verse_number": "१०-१२-१६", "content_sanskrit": "स राजन्प्रीयमाणेन मयाप्युक्तः कृताञ्जलिः।\nयाचमानः प्रयत्नेन मत्तोऽस्त्रं भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2069862, "chapter_id": 2460, "verse_number": "१०-१२-१७", "content_sanskrit": "देवदानवगन्धर्वमनुष्यपतगोरगाः।\nन समा मम वीर्यस्य शतांशेनापि पिण्डिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2069863, "chapter_id": 2460, "verse_number": "१०-१२-१८", "content_sanskrit": "इदं धनुरियं शक्तिरिदं चक्रमियं गदा।\nयद्यदिच्छसि चेदस्रं मत्तस्तत्तद्ददामि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2069864, "chapter_id": 2460, "verse_number": "१०-१२-१९", "content_sanskrit": "यच्छक्नोषि समुद्यन्तुं प्रयोक्तुमपि वा रणे।\nतद्गृहाण विनाऽस्त्रेण यन्मे दातुमभीप्ससि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2069865, "chapter_id": 2460, "verse_number": "१०-१२-२०", "content_sanskrit": "स सुनाभं सहस्रारं वज्रनाभमयस्मयम्।\nवव्रे चक्रं महाभागो मत्तः स्पर्धन्मया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2069866, "chapter_id": 2460, "verse_number": "१०-१२-२१", "content_sanskrit": "गृहाण चक्रमित्युक्तो मया तु तदनन्तरम्।\nजग्राहोत्पत्य सहसा चक्रं सव्येन पाणिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2069867, "chapter_id": 2460, "verse_number": "१०-१२-२२", "content_sanskrit": "न चैनमशकत्स्थानात्सञ्चालयितुमप्युत।\nअथैनं दक्षिणेनापि ग्रहीतुमुपचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2069868, "chapter_id": 2460, "verse_number": "१०-१२-२३", "content_sanskrit": "सर्वयत्नेन तेनापि गृह्य नैनमकम्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2069869, "chapter_id": 2460, "verse_number": "१०-१२-२४", "content_sanskrit": "ततः सर्वबलेनापि यदैनं न शशाक ह।\nउद्यन्तुं वा चालयितुं द्रौणिः परमदुर्मनाः।\nकृत्वा यत्नं परिश्रान्तः स न्यवर्तत भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2069870, "chapter_id": 2460, "verse_number": "१०-१२-२५", "content_sanskrit": "निवृत्मनसं तस्मादभिप्रायाद्विचेतसम्।\nअहमामन्त्र्य संविग्नमश्वत्थामानमब्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2069871, "chapter_id": 2460, "verse_number": "१०-१२-२६", "content_sanskrit": "यः स दैवमनुष्येषु प्रमाणं परमं गतः।\nगाण्डीवधन्वा श्वेताश्चः कपिप्रवरकेतनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2069872, "chapter_id": 2460, "verse_number": "१०-१२-२७", "content_sanskrit": "यः साक्षाद्देवदेवेशं शितिकण्ठमुमापतिम्।\nद्वन्द्वयुद्धे पुरा जिष्णुस्तोषयामास शङ्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2069873, "chapter_id": 2460, "verse_number": "१०-१२-२८", "content_sanskrit": "यस्मात्प्रियतरो नास्ति ममान्यः पुरुषो भुवि।\nनादेयं यस्य मे किञ्चिदपि प्राणान्महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2069874, "chapter_id": 2460, "verse_number": "१०-१२-२९", "content_sanskrit": "तेनापि सुहृदा ब्रह्मन्पार्थेनाक्लिष्टकर्मणा।\nनोक्पूर्वमिदं वाक्यं यस्त्वं मामभिभाषसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2069875, "chapter_id": 2460, "verse_number": "१०-१२-३०", "content_sanskrit": "ब्रह्मचर्यं महद्धोरं तीर्वा द्वादशवार्षिकम्।\nहिमवत्पार्श्वमास्थाय यो मया तपसाऽऽर्जितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2069876, "chapter_id": 2460, "verse_number": "१०-१२-३१", "content_sanskrit": "समानव्रतचारिण्यां रुक्मिण्यां योऽन्वजायत।\nसनत्कुमारस्तेजस्वी प्रद्युम्नो नाम मे सुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2069877, "chapter_id": 2460, "verse_number": "१०-१२-३२", "content_sanskrit": "तेनाप्येतन्महद्दिव्यं चक्रमप्रतिमं रणे।\nन प्रार्थितमभून्मूढ तदितं प्रार्थितं त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2069878, "chapter_id": 2460, "verse_number": "१०-१२-३३", "content_sanskrit": "रामेणातिबलेनैतन्नोक्तपूर्वं कदाचन।\nन गदेन साम्बेन यदिदं प्रार्थितं त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2069879, "chapter_id": 2460, "verse_number": "१०-१२-३४", "content_sanskrit": "द्वारकावासिभिश्चान्यैर्वृष्ण्यन्धकमहारथैः।\nनोक्तपूर्वमिदं क्षुद्रं तदिदं प्रार्थितं त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2069880, "chapter_id": 2460, "verse_number": "१०-१२-३५", "content_sanskrit": "भारताचार्यपुत्रस्त्वं मानितः सर्वयादवैः।\nचक्रेण रथिनां श्रेष्ठ कं नु तात युयुत्ससे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2069881, "chapter_id": 2460, "verse_number": "१०-१२-३६", "content_sanskrit": "एवमुक्तो मया द्रौणिर्मामिदं प्रत्युवाच ह।\nप्रयुज्य भवते पूजां योत्स्ये कृष्ण त्वया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2069882, "chapter_id": 2460, "verse_number": "१०-१२-३७", "content_sanskrit": "प्रार्थितं ते मया चक्रं देवदानवपूजितम्।\nअजेयः स्यामिति विभो सत्यमेद्ब्रवीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2069883, "chapter_id": 2460, "verse_number": "१०-१२-३८", "content_sanskrit": "सोऽहं तद्दुर्लभं चक्रमनवाप्यैव केशव।\nप्रतियास्यामि गोविन्द शिवेनाभिवदस्व माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2069884, "chapter_id": 2460, "verse_number": "१०-१२-३९", "content_sanskrit": "एतत्सुनाभं भोजानामृषभेण त्वया धृतम्।\nचक्रमप्रतिचक्रेण भुवि नान्योऽभिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2069885, "chapter_id": 2460, "verse_number": "१०-१२-४०", "content_sanskrit": "एतावदुक्त्वा द्रौणिर्मां युग्यानश्वान्धनानि च।\nआदायोपययौ काले रत्नानि वविधानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2069886, "chapter_id": 2460, "verse_number": "१०-१२-४१", "content_sanskrit": "स संरम्भी दुरात्मा च चपलः क्रूर एव च।\nवेद चास्रं ब्रह्मशिरस्तस्माद्रक्ष्यो वृकोदरः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2069887, "chapter_id": 2460, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सौप्तिकपर्वणि ऐषीकपर्वणि द्वाशोऽध्यायः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]