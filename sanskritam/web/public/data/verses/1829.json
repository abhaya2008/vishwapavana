[{"id": 2038153, "chapter_id": 1829, "verse_number": "५-७४-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2038154, "chapter_id": 1829, "verse_number": "५-७४-१", "content_sanskrit": "एतछ्रुत्वा महाबाहुः केशवः प्रहसन्निव।\nअभूतपूर्वं भीमस्य मार्दवोपहितं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2038155, "chapter_id": 1829, "verse_number": "५-७४-२", "content_sanskrit": "गिरेरिव लघुत्वं तच्छीतत्वमिव पावके।\nमत्वा रामानुजः शौरिः शार्ङ्गधन्वा वृकोदरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2038156, "chapter_id": 1829, "verse_number": "५-७४-३", "content_sanskrit": "सन्तेजसंस्तदा वाग्भिर्भातरिश्वेव पावकम्।\nउवाच भीममासीनं कृपयाऽभिपरिप्लुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2038157, "chapter_id": 1829, "verse_number": "५-७४-४x", "content_sanskrit": "श्रीभगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2038158, "chapter_id": 1829, "verse_number": "५-७४-४", "content_sanskrit": "त्वमन्यदा भीमसेन युद्धमेव प्रशंससि।\nवधामिनन्दिनः क्रूरान्धार्तराष्ट्रन्मिमर्दिषुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2038159, "chapter_id": 1829, "verse_number": "५-७४-५", "content_sanskrit": "न च स्वपिषि जागर्षि न्युब्जः शेषे परन्तप ।\nघोरामशान्तां रुशतीं सदा वाचं प्रभाषसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2038160, "chapter_id": 1829, "verse_number": "५-७४-६", "content_sanskrit": "निःश्वसन्नग्निवत्तेन सन्तप्तः स्वेन मन्युना ।\nअप्रशान्तमना भीम सधूम इव पावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2038161, "chapter_id": 1829, "verse_number": "५-७४-७", "content_sanskrit": "एकान्ते निःश्वसञ्शेपे भारार्त इव दुर्बलः ।\nअपि त्वां केचिदुन्मत्तं मन्यन्तेऽतद्विदो जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2038162, "chapter_id": 1829, "verse_number": "५-७४-८", "content_sanskrit": "आरुज्य वृक्षान्निर्मूलान्गजः परिरुजन्निव ।\nनिघ्नन्पद्भिः क्षितिं भीम निष्टनन्परिधावसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2038163, "chapter_id": 1829, "verse_number": "५-७४-९", "content_sanskrit": "नास्मिञ्जने न रमसे रहः क्षिपसि पाण्डव ।\nनान्यं निशि दिवा चापि कदाचिदभिनन्दसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2038164, "chapter_id": 1829, "verse_number": "५-७४-१०", "content_sanskrit": "अकस्मात्स्मयमानश्च रहस्यास्से रुदन्निव।\nजान्वोर्मूर्धानमाधाय चिरमास्ते प्रमीलितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2038165, "chapter_id": 1829, "verse_number": "५-७४-११", "content_sanskrit": "भ्रुकिटिं च पुनः कुर्वन्नोष्ठौ च विदशन्निव ।\nअभीक्ष्णं दृश्यसे भीम सर्वं तन्मन्युकारितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2038166, "chapter_id": 1829, "verse_number": "५-७४-१२", "content_sanskrit": "यथा तपुरस्तात्सविता दृश्यते शुक्रमुच्चरन् ।\nयथा च पश्चान्निर्मुक्तो ध्रुवं पर्येति रश्मिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2038167, "chapter_id": 1829, "verse_number": "५-७४-१३", "content_sanskrit": "तथा सत्यं ब्रवीम्येतन्नास्ति तस्य व्यतिक्रमः ।\nहन्ताहं गदयाभ्येत्य दुर्योधनममर्पणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2038168, "chapter_id": 1829, "verse_number": "५-७४-१४", "content_sanskrit": "इति स्म मध्ये भ्रातृणां सत्येनालभसे वदाम्।\nतस्य ते प्रशमे बुद्धिर्ध्रियतेऽद्य परन्तप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2038169, "chapter_id": 1829, "verse_number": "५-७४-१५", "content_sanskrit": "अहो युद्धाभिकाङ्क्षाणां युद्धकाल उपस्थिते ।\nचेतांसि विप्रतीपानि यत्त्वां भीभीम विन्दति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2038170, "chapter_id": 1829, "verse_number": "५-७४-१६", "content_sanskrit": "अहो पार्थ निमित्तानि विपरीतानि पश्यसि।\nस्वप्नान्ते जागरान्ते च तस्मात्प्रशममिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2038171, "chapter_id": 1829, "verse_number": "५-७४-१७", "content_sanskrit": "अहो नाशंससे किंचित्पुंस्त्वं क्लीब इवात्मनि ।\nकश्मलेनाभिपन्नोऽसि तेन ते विकृतं मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2038172, "chapter_id": 1829, "verse_number": "५-७४-१८", "content_sanskrit": "उद्वेपते ते हृदयं मनस्ते प्रतिसीदति ।\nऊरुस्तम्भगृहीतोऽसि तस्मात्प्रशममिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2038173, "chapter_id": 1829, "verse_number": "५-७४-१९", "content_sanskrit": "अनित्यं किल मर्त्यस्य पार्थ चित्तं चलाचलम् ।\nवातवेगप्रचलिता अष्ठीला शाल्मलेरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2038174, "chapter_id": 1829, "verse_number": "५-७४-२०", "content_sanskrit": "तवैषा विकृता बुद्धिर्गवां वागिव मानुषी ।\nमनांसि पाण्डुपुत्राणां मञ्जयत्यप्लवानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2038175, "chapter_id": 1829, "verse_number": "५-७४-२१", "content_sanskrit": "इदं मे महादाश्चर्यं पर्वतस्येव सर्पणम्।\nयदीदृशं प्रभाषेथा भीमसेनासमं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2038176, "chapter_id": 1829, "verse_number": "५-७४-२२", "content_sanskrit": "स दृष्ट्वा स्वानि कर्माणि कुले जन्म च भारत ।\nउत्तिष्ठस्व विषादं मा कृथा वीर स्थिरो भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2038177, "chapter_id": 1829, "verse_number": "५-७४-२३", "content_sanskrit": "न चैतदनुरूपं ते यत्ते ग्लानिररिन्दम।\nयदोजसा न लभते क्षत्रियो न तदश्रुते ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2038178, "chapter_id": 1829, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि चतुःसप्ततितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]