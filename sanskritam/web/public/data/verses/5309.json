[{"id": 2202310, "chapter_id": 5309, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2202311, "chapter_id": 5309, "verse_number": "१", "content_sanskrit": "पितामहेन विधिवद् यज्ञाः प्रोक्ता महात्मना ।\nगुणाश्चैषां यथातत्त्वं प्रेत्य चेह च सर्वशः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2202312, "chapter_id": 5309, "verse_number": "२", "content_sanskrit": "न ते शक्या दरिद्रेण यज्ञाः प्राप्तुं पितामह ।\nबहूपकरणा यज्ञा नानासम्भारविस्तराः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2202313, "chapter_id": 5309, "verse_number": "३", "content_sanskrit": "पार्थिवै राजपुत्रैर्वा शक्याः प्राप्तुं पितामह ।\nनार्थन्यूनैरवगुणैरेकात्मभिरसंहतैः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2202314, "chapter_id": 5309, "verse_number": "४", "content_sanskrit": "यो दरिद्रैरपि विधिः शक्यः प्राप्तुं सदा भवेत् ।\nतुल्यो यज्ञफलैरेतैस्तन्मे ब्रूहि पितामह\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2202315, "chapter_id": 5309, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2202316, "chapter_id": 5309, "verse_number": "५", "content_sanskrit": "इदमङ्गिरसा प्रोक्तमुपवासफलात्मकम् ।\nविधिं यज्ञफलैस्तुल्यं तन्निबोध युधिष्ठिर\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2202317, "chapter_id": 5309, "verse_number": "६", "content_sanskrit": "यस्तु काल्यं तथा सायं भुञ्जानो नान्तरा पिबेत् ।\nअहिंसानिरतो नित्यं जुह्वानो जातवेदसम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2202318, "chapter_id": 5309, "verse_number": "७", "content_sanskrit": "षड्भिरेव तु वर्षैः स सिध्यते नात्र संशयः ।\nतप्तकाञ्चनवर्णं च विमानं लभते नरः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2202319, "chapter_id": 5309, "verse_number": "८", "content_sanskrit": "देवस्त्रीणामधीवासे नृत्यगीतनिनादिते ।\nप्राजापत्ये वसेत् पद्मम् अग्निवर्णनिभे शुभे\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2202320, "chapter_id": 5309, "verse_number": "९", "content_sanskrit": "त्रीणि वर्षाणि यः प्राशेत् सततं त्वेकभोजनम् ।\nधर्मपत्नीरतो नित्यमग्निष्टोमफलं लभेत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2202321, "chapter_id": 5309, "verse_number": "१०", "content_sanskrit": "द्वितीये दिवसे यस्तु प्राश्नीयादेकभोजनम् ।\nसदा द्वादशमासांस्तु जुह्वानो जातवेदसम् ।\nयज्ञं बहुसुवर्णं वा वासवप्रियमाहरेत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2202322, "chapter_id": 5309, "verse_number": "११", "content_sanskrit": "सत्यवाग् दानशीलश्च ब्रह्मण्यश्चानसूयकः ।\nक्षान्तो दान्तो जितक्रोधः स गच्छेत् परमां गतिम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2202323, "chapter_id": 5309, "verse_number": "१२", "content_sanskrit": "पाण्डराभ्रप्रतीकाशे विमाने हंसलक्षणे ।\nद्वे समाप्ते ततः पद्मे सोऽप्सरोभिर्वसेत् सह\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2202324, "chapter_id": 5309, "verse_number": "१३", "content_sanskrit": "तृतीये दिवसे यस्तु प्राश्नीयादेकभोजनम् ।\nसदा द्वादशमासांस्तु जुह्वानो जातवेदसम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2202325, "chapter_id": 5309, "verse_number": "१४", "content_sanskrit": "अतिरात्रस्य यज्ञस्य फलं प्राप्नोत्यनुत्तमम् ।\nमयूरहंससंयुक्तं विमानं लभते नरः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2202326, "chapter_id": 5309, "verse_number": "१५", "content_sanskrit": "सप्तर्षीणां सदा लोके सोऽप्सरोभिर्वसेत् सह ।\nनिवर्तनं च तत्रास्य त्रीणि पद्मानि वै विदुः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2202327, "chapter_id": 5309, "verse_number": "१६", "content_sanskrit": "दिवसे यश्चतुर्थे तु प्राश्नीयादेकभोजनम् ।\nसदा द्वादशमासान् वै जुह्वानो जातवेदसम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2202328, "chapter_id": 5309, "verse_number": "१७", "content_sanskrit": "वाजपेयस्य यज्ञस्य फलं प्राप्नोत्यनुत्तमम् ।\nइन्द्रकन्याधिरूढं च विमानं लभते नरः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2202329, "chapter_id": 5309, "verse_number": "१८", "content_sanskrit": "सागरस्य च पर्यन्ते वासवं लोकमावसेत् ।\nदेवराजस्य च क्रीडां नित्यकालमवेक्षते\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2202330, "chapter_id": 5309, "verse_number": "१९", "content_sanskrit": "दिवसे पञ्चमे यस्तु प्राश्नीयादेकभोजनम् ।\nसदा द्वादशमासांस्तु जुह्वानो जातवेदसम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2202331, "chapter_id": 5309, "verse_number": "२०", "content_sanskrit": "अलुब्धः सत्यवादी च ब्रह्मण्यश्चाविहिंसकः ।\nअनसूयुरपापस्थो द्वादशाहफलं लभेत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2202332, "chapter_id": 5309, "verse_number": "२१", "content_sanskrit": "जाम्बूनदमयं दिव्यं विमानमधिरोहति ।\nसूर्यमालासमाभासमारोहेत् पाण्डरं गृहम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2202333, "chapter_id": 5309, "verse_number": "२२", "content_sanskrit": "आवर्तनानि चत्वारि तथा पद्मानि द्वादश ।\nदाराग्निपरिमाणश्च तत्रासौ वसते सुखम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2202334, "chapter_id": 5309, "verse_number": "२३", "content_sanskrit": "दिवसे यस्तु षष्ठे वै मुनिः प्राशेत भोजनम् ।\nसदा द्वादशमासान् वै जुह्वानो जातवेदसम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2202335, "chapter_id": 5309, "verse_number": "२४", "content_sanskrit": "सदा त्रिषवणस्नायी ब्रह्मचार्यनसूयकः ।\nगवामयस्य यज्ञस्य फलं प्राप्नोत्यनुत्तमम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2202336, "chapter_id": 5309, "verse_number": "२५", "content_sanskrit": "अग्निज्वालासमाभासं हंसबर्हिणसेवितम् ।\nशातकुम्भमयं युक्तं साधयेद् यानमुत्तमम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2202337, "chapter_id": 5309, "verse_number": "२६", "content_sanskrit": "तथैवाप्सरसामङ्के प्रसुप्तः प्रतिबुध्यते ।\nनूपुराणां निनादेन मेखलानां च निस्वनैः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2202338, "chapter_id": 5309, "verse_number": "२७", "content_sanskrit": "कोटीसहस्रं वर्षाणां त्रीणि कोटिशतानि च ।\nपद्मान्यष्टादश तथा पताके द्वे तथैव च\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2202339, "chapter_id": 5309, "verse_number": "२८", "content_sanskrit": "अयुतानि च पञ्चाशद् लक्षपञ्चाशतस्य च ।\nलोम्नां प्रमाणेन समं ब्रह्मलोके महीयते\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2202340, "chapter_id": 5309, "verse_number": "२९", "content_sanskrit": "दिवसे सप्तमे यस्तु प्राश्नीयादेकभोजनम् ।\nसदा द्वादशमासान् वै जुह्वानो जातवेदसम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2202341, "chapter_id": 5309, "verse_number": "३०", "content_sanskrit": "सरस्वतीं गोपयानो ब्रह्मचर्यं समाचरन् ।\nसुमनोवर्णकं चैव मधुमांसं च वर्जयेत्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2202342, "chapter_id": 5309, "verse_number": "३१", "content_sanskrit": "पुरुषो मरुतां लोकमिन्द्रलोकं च गच्छति ।\nतत्र तत्र च सिद्धार्थो देवकन्याभिरर्च्यते\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2202343, "chapter_id": 5309, "verse_number": "३२", "content_sanskrit": "फलं बहुसुवर्णस्य यज्ञस्य लभते नरः ।\nसङ्ख्यामतिगुणां चापि तेषु लोकेषु मोदते\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2202344, "chapter_id": 5309, "verse_number": "३३", "content_sanskrit": "यस्तु संवत्सरं क्षान्तो भुङ्क्तेऽहन्यष्टमे नरः ।\nदेवकार्यपरो नित्यं जुह्वानो जातवेदसम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2202345, "chapter_id": 5309, "verse_number": "३४", "content_sanskrit": "पौण्डरीकस्य यज्ञस्य फलं प्राप्नोत्यनुत्तमम् ।\nपद्मवर्णनिभं चैव विमानमधिगच्छति\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2202346, "chapter_id": 5309, "verse_number": "३५", "content_sanskrit": "कृष्णाः कनकगौर्यश्च नार्यः श्यामास्तथापराः ।\nवयोरूपविलासिन्यो लभते नात्र संशयः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2202347, "chapter_id": 5309, "verse_number": "३६", "content_sanskrit": "यस्तु संवत्सरं भुङ्क्ते नवमे नवमेऽहनि ।\nसदा द्वादशमासान् वै जुह्वानो जातवेदसम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2202348, "chapter_id": 5309, "verse_number": "३७", "content_sanskrit": "अश्वमेधस्य यज्ञस्य फलं प्राप्नोति मानवः ।\nपुण्डरीकप्रकाशं च विमानं लभते नरः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2202349, "chapter_id": 5309, "verse_number": "३८", "content_sanskrit": "दीप्तसूर्याग्नितेजोभिर्दिव्यमालाभिरेव च ।\nनीयते रुद्रकन्याभिः सोऽन्तरिक्षं सनातनम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2202350, "chapter_id": 5309, "verse_number": "३९", "content_sanskrit": "अष्टादशसहस्राणि वर्षाणां कल्पमेव च ।\nकोटीशतसहस्रं च तेषु लोकेषु मोदते\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2202351, "chapter_id": 5309, "verse_number": "४०", "content_sanskrit": "यस्तु संवत्सरं भुङ्क्ते दशमेऽह्नि गते सति ।\nसदा द्वादशमासान् वै जुह्वानो जातवेदसम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2202352, "chapter_id": 5309, "verse_number": "४१", "content_sanskrit": "ब्रह्मकन्यानिवेशे च सर्वभूतमनोहरे ।\nअश्वमेधसहस्रस्य फलं प्राप्नोत्यनुत्तमम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2202353, "chapter_id": 5309, "verse_number": "४२", "content_sanskrit": "रूपवत्यश्च तं कन्या रमयन्ति सदा नरम् ।\nनीलोत्पलनिभैर्वर्णै रक्तोत्पलनिभैस्तथा\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2202354, "chapter_id": 5309, "verse_number": "४३", "content_sanskrit": "विमानं मण्डलावर्तमावर्तगहनावृतम् ।\nसागरोर्मिप्रतीकाशं स लभेद् यानमुत्तमम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2202355, "chapter_id": 5309, "verse_number": "४४", "content_sanskrit": "विचित्रमणिमालाभिर्नादितं शङ्खपुष्करैः ।\nस्फाटिकैर्वज्रसारैश्च स्तम्भैः सुकृतवेदिकम् ।\nआरोहति महद् यानं हंससारसवाहनम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2202356, "chapter_id": 5309, "verse_number": "४५", "content_sanskrit": "एकादशे तु दिवसे यः प्राप्ते प्राशते हविः ।\nसदा द्वादशमासान् वै जुह्वानो जातवेदसम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2202357, "chapter_id": 5309, "verse_number": "४६", "content_sanskrit": "परस्त्रियो नाभिलषेद् वाचाथ मनसापि वा ।\nअनृतं च न भाषेत गुरूणां पूजते नरः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2202358, "chapter_id": 5309, "verse_number": "४७", "content_sanskrit": "अभिगच्छेन्महादेवं विमानस्थं महाबलम् ।\nस्वयम्भुवं च पश्येत विमानं समुपस्थितम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2202359, "chapter_id": 5309, "verse_number": "४८", "content_sanskrit": "कुमार्यः काञ्चनाभासा रूपवत्यो नयन्ति तम् ।\nरुद्राणां तमधीवासं दिवि दिव्यं मनोहरम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2202360, "chapter_id": 5309, "verse_number": "४९", "content_sanskrit": "वर्षाण्यपरिमेयानि युगान्तमपि चावसेत् ।\nकोटीशतसहस्रं च दश कोटिशतानि च\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2202361, "chapter_id": 5309, "verse_number": "५०", "content_sanskrit": "रुद्रं नित्यं प्रणमते देवदानवसम्मतम् ।\nस तस्मै दर्शनं प्राप्तो दिवसे दिवसे भवेत्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2202362, "chapter_id": 5309, "verse_number": "५१", "content_sanskrit": "दिवसे द्वादशे यस्तु प्राप्ते वै प्राशते हविः ।\nसदा द्वादशमासान् वै सर्वमेधफलं लभेत्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2202363, "chapter_id": 5309, "verse_number": "५२", "content_sanskrit": "आदित्यैर्द्वादशैस्तस्य विमानं संविधीयते ।\nमणिमुक्ताप्रवाळैश्च महार्हैरुपशोभितम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2202364, "chapter_id": 5309, "verse_number": "५३", "content_sanskrit": "हंसमालापरिक्षिप्तं नागवीथीसमाकुलम् ।\nमयूरैश्चक्रवाकैश्च कूजद्भिरुपशोभितम्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2202365, "chapter_id": 5309, "verse_number": "५४", "content_sanskrit": "अट्टैर्महद्भिः संयुक्तं ब्रह्मलोके प्रतिष्ठितम् ।\nनित्यमावसते राजन् नरनारीसमावृतम् ।\nऋषिरेवं महाभागस्त्वङ्गिराः प्राह धर्मवित्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2202366, "chapter_id": 5309, "verse_number": "५५", "content_sanskrit": "त्रयोदशे तु दिवसे यः प्राप्ते प्राशते हविः ।\nसदा द्वादश मासान् वै जुह्वानो जातवेदसम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2202367, "chapter_id": 5309, "verse_number": "५६", "content_sanskrit": "रक्तपद्मोदयं नाम विमानं साधयेन्नरः ।\nजातरूपप्रयुक्तं च रत्नसञ्चयभूषितम्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2202368, "chapter_id": 5309, "verse_number": "५७", "content_sanskrit": "देवकन्याभिराकीर्णं दिव्याभरणभूषितम् ।\nपुण्यगन्धोदयं दिव्यं नित्यं वायव्यशोभितम्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2202369, "chapter_id": 5309, "verse_number": "५८", "content_sanskrit": "तत्र शङ्कुपताकं च युगान्तं कल्पमेव च ।\nअयुतायुतं तथा पद्मं समुद्रं च तथा वसेत्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2202370, "chapter_id": 5309, "verse_number": "५९", "content_sanskrit": "गीतगन्धर्वघोषैश्च भेरीपणवनिस्वनैः ।\nसदा प्रमुदितस्ताभिर्देवकन्याभिरीड्यते\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2202371, "chapter_id": 5309, "verse_number": "६०", "content_sanskrit": "चतुर्दशे तु दिवसे यः पूर्णे प्राशते हविः ।\nसदा द्वादशमासान् वै महामेधफलं लभेत्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2202372, "chapter_id": 5309, "verse_number": "६१", "content_sanskrit": "अनिर्देश्यवयोरूपा देवकन्याः स्वलङ्कृताः ।\nमृष्टतप्ताङ्गदधरा विमानैरनुयान्ति तम्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2202373, "chapter_id": 5309, "verse_number": "६२", "content_sanskrit": "कलहंसविनिर्घोषैर्नूपुराणां च निस्वनैः ।\nकाञ्चीनां च समुत्कर्षैस्तत्र तत्र निषेव्यते\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2202374, "chapter_id": 5309, "verse_number": "६३", "content_sanskrit": "देवकन्यानिवासे च तस्मिन् वसति मानवः ।\nजाह्नवीवालुकाकीर्णे पूर्णं संवत्सरं नरः\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2202375, "chapter_id": 5309, "verse_number": "६४", "content_sanskrit": "यस्तु पक्षे गते भुङ्क्ते एकभक्तं जितेन्द्रियः ।\nसदा दादश मासांस्तु जुह्वानो जातवेदसम् ।\nराजसूयसहस्रस्य फलं प्राप्नोत्यनुत्तमम्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2202376, "chapter_id": 5309, "verse_number": "६५", "content_sanskrit": "यानमारोहते नित्यं हंसबर्हिणसेवितम् ।\nमणिमण्डलकैश्चित्रं जातरूपसमन्वितम्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2202377, "chapter_id": 5309, "verse_number": "६६", "content_sanskrit": "दिव्याभरणशोभाभिर्वरस्त्रीभिरलङ्कृतम् ।\nएकस्तम्भं चतुर्द्वारं सप्तभौमं सुमङ्गलम् ।\nवैजयन्तीसहस्रैश्च शोभितं गीतनिस्वनैः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2202378, "chapter_id": 5309, "verse_number": "६७", "content_sanskrit": "दिव्यं दिव्यगुणोपेतं विमानमधिरोहति ।\nमणिमुक्ताप्रवाळैश्च भूषितं वैद्युतप्रभम् ।\nवसेद् युगसहस्रं च खड्गकुञ्जरवाहनः\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2202379, "chapter_id": 5309, "verse_number": "६८", "content_sanskrit": "षोडशे दिवसे यस्तु सम्प्राप्ते प्राशते हविः ।\nसदा द्वादश मासान् वै सोमयज्ञफलं भवेत्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2202380, "chapter_id": 5309, "verse_number": "६९", "content_sanskrit": "सोमकन्यानिवासेषु सोऽध्यावसति नित्यदा ।\nसौम्यगन्धानुलिप्तश्च कामचारगतिर्भवेत्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2202381, "chapter_id": 5309, "verse_number": "७०", "content_sanskrit": "सुदर्शनाभिर्नारीभिर्मधुराभिस्तथैव च ।\nअर्च्यते वै विमानस्थः कामभोगैश्च सेव्यते\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2202382, "chapter_id": 5309, "verse_number": "७१", "content_sanskrit": "फलं पद्मशतप्रख्यं महाकल्पं दशाधिकम् ।\nआवर्तनानि चत्वारि सागरे यात्यसौ नरः\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2202383, "chapter_id": 5309, "verse_number": "७२", "content_sanskrit": "दिवसे सप्तदशमे प्राप्ते यः प्राशयेद् हविः ।\nसदा द्वादश मासान् वै जुह्वानो जातवेदसम्\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2202384, "chapter_id": 5309, "verse_number": "७३", "content_sanskrit": "स्थानं वारुणमैन्द्रं च रौद्रं चैवाधिगच्छति ।\nमारुतौशनसे चैव ब्रह्मलोकं च गच्छति\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2202385, "chapter_id": 5309, "verse_number": "७४", "content_sanskrit": "तत्र दैवतकन्याभिरासनेनोपचर्यते ।\nभूर्भुवं चापि देवर्षिं विश्वरूपमवेक्षते\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2202386, "chapter_id": 5309, "verse_number": "७५", "content_sanskrit": "तत्र देवाधिदेवस्य कुमार्यो रमयन्ति तम् ।\nमनोज्ञरूपधारिण्यो मधुराः समलङ्कृताः\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2202387, "chapter_id": 5309, "verse_number": "७६", "content_sanskrit": "चन्द्रादित्यावुभौ यावद् गगने चरतः प्रभो ।\nतावच्चरत्यसौ वीरः सुधामृतरसाशनः\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2202388, "chapter_id": 5309, "verse_number": "७७", "content_sanskrit": "अष्टादशे तु दिवसे प्राश्नीयादेकभोजनम् ।\nसदा द्वादश मासान् वै सप्त लोकान् स पश्यति\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2202389, "chapter_id": 5309, "verse_number": "७८", "content_sanskrit": "रथैः सनन्दिघोषैश्च पृष्ठतः सोऽनुगम्यते ।\nदेवकन्याधिरूढैस्तु भ्राजमानैः स्वलङ्कृतैः\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2202390, "chapter_id": 5309, "verse_number": "७९", "content_sanskrit": "व्याघ्रसिंहप्रयुक्तं च मेघस्वननिनादितम् ।\nविमानमुत्तमं दिव्यं सुसुखी ह्यधिरोहति\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2202391, "chapter_id": 5309, "verse_number": "८०", "content_sanskrit": "तत्र कल्पसहस्रं स कान्ताभिः सह मोदते ।\nसुधारसं च भुञ्जीत ह्यमृतोपममुत्तमम्\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2202392, "chapter_id": 5309, "verse_number": "८१", "content_sanskrit": "एकोनविंशे दिवसे यो भुङ्क्ते एकभोजनम् ।\nसदा द्वादश मासान् वै सत्यवादी धृतव्रतः\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2202393, "chapter_id": 5309, "verse_number": "८२", "content_sanskrit": "उत्तमं लभते स्थानमप्सरोगणसेवितम् ।\nगन्धर्वैरुपगीतं च विमानं सूर्यवर्चसम्\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2202394, "chapter_id": 5309, "verse_number": "८३", "content_sanskrit": "तत्रामरवरस्त्रीभिर्मोदते विगतज्वरः ।\nदिव्याम्बरधरः श्रीमानयुतानां शतं समाः\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2202395, "chapter_id": 5309, "verse_number": "८४", "content_sanskrit": "पूर्णेऽथ दिवसे विंशे यो भुङ्क्ते ह्येकभोजनम् ।\nसदा द्वादश मासांस्तु सत्यवादी धृतव्रतः\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2202396, "chapter_id": 5309, "verse_number": "८५", "content_sanskrit": "अमांसाशी ब्रह्मचारी सर्वभूतहिते रतः ।\nस लोकान् विपुलान् दिव्यानादित्यानामुपाश्नुते\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2202397, "chapter_id": 5309, "verse_number": "८६", "content_sanskrit": "गन्धर्वैरप्सरोभिश्च दिव्यमाल्यानुलेपनैः ।\nविमानैः काञ्चनैर्दिव्यैः सुखी चरति नित्यदा\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2202398, "chapter_id": 5309, "verse_number": "८७", "content_sanskrit": "एकविंशे तु दिवसे यो भुङ्क्ते ह्येकभोजनम् ।\nसदा द्वादश मासान् वै जुह्वानो जातवेदसम्\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2202399, "chapter_id": 5309, "verse_number": "८८", "content_sanskrit": "लोकमौशनसं दिव्यं शक्रलोकं च गच्छति ।\nअश्विनोर्मरुतां चैव सुखेष्वभिरतः सदा\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2202400, "chapter_id": 5309, "verse_number": "८९", "content_sanskrit": "अनभिज्ञश्च दुःखानां विमानवरमास्थितः ।\nसेव्यमानो वरस्त्रीभिः क्रीडत्यमरवत् प्रभुः\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2202401, "chapter_id": 5309, "verse_number": "९०", "content_sanskrit": "द्वाविंशे दिवसे प्राप्ते यो भुङ्क्ते ह्येकभोजनम् ।\nसदा द्वादश मासान् वै जुह्वानो जातवेदसम्\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2202402, "chapter_id": 5309, "verse_number": "९१", "content_sanskrit": "धृतिमानहिंसानिरतः सत्यवागनसूयकः ।\nरुद्राणां लोकमाप्नोति दिवाकरसमप्रभः\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2202403, "chapter_id": 5309, "verse_number": "९२", "content_sanskrit": "कामचारी सुधाहारो विमानवरमास्थितः ।\nरमते देवकन्याभिर्दिव्याभरणभूषितः\t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2202404, "chapter_id": 5309, "verse_number": "९३", "content_sanskrit": "त्रयोविंशे तु दिवसे प्राशेद् यस्त्वेकभोजनम् ।\nसदा द्वादश मासांस्तु मिताहारो जितेन्द्रियः\t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2202405, "chapter_id": 5309, "verse_number": "९४", "content_sanskrit": "वायोरुशनसश्चैव रुद्रलोकं च गच्छति ।\nकामचारी कामगमः पूज्यमानोऽप्सरोगणैः\t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2202406, "chapter_id": 5309, "verse_number": "९५", "content_sanskrit": "अनेकयुगपर्यन्तं विमानवरमास्थितः ।\nमोदते देवकन्याभिर्दिव्याभरणभूषितः\t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2202407, "chapter_id": 5309, "verse_number": "९६", "content_sanskrit": "चतुर्विंशे तु दिवसे यः प्राशेदेकभोजनम् ।\nसदा द्वादश मासान् वै जुह्वानो जातवेदसम्\t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2202408, "chapter_id": 5309, "verse_number": "९७", "content_sanskrit": "आदित्यानामधीवासे मोदमानो वसेच्चिरम् ।\nदिव्यमाल्याम्बरधरो दिव्यगन्धानुलेपनः\t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2202409, "chapter_id": 5309, "verse_number": "९८", "content_sanskrit": "विमाने काञ्चने दिव्ये हंसयुक्ते मनोरमे ।\nरमते देवकन्यानां सहस्रैरयुतैस्तदा\t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2202410, "chapter_id": 5309, "verse_number": "९९", "content_sanskrit": "पञ्चविंशे तु दिवसे यः प्राशेदेकभोजनम् ।\nसदा द्वादश मासांस्तु पुष्कळं यानमारुहेत्\t॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2202411, "chapter_id": 5309, "verse_number": "१००", "content_sanskrit": "सिंहव्याघ्रप्रयुक्तैश्च मेघस्वननिनादितैः ।\nरथैः सनन्दिघोषैश्च पृष्ठतः सोऽनुगम्यते\t॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2202412, "chapter_id": 5309, "verse_number": "१०१", "content_sanskrit": "देवकन्यासमारूढै राजतैर्विमलैः शुभैः ।\nविमानमुत्तमं दिव्यमास्थाय सुमनोहरम्\t॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2202413, "chapter_id": 5309, "verse_number": "१०२", "content_sanskrit": "तत्र कल्पसहस्रं वै रमते स्त्रीशतावृतः ।\nसुधारसं चोपजीवन्नमृतोपममुत्तमम्\t॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2202414, "chapter_id": 5309, "verse_number": "१०३", "content_sanskrit": "षड्विंशे दिवसे यस्तु प्राश्नीयादेकभोजनम् ।\nसदा द्वादश मासांस्तु नियतो नियताशनः\t॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2202415, "chapter_id": 5309, "verse_number": "१०४", "content_sanskrit": "जितेन्द्रियो वीतरागो जुह्वानो जातवेदसम् ।\nस प्राप्नोति महाभागः पूज्यमानोऽप्सरोगणैः\t॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2202416, "chapter_id": 5309, "verse_number": "१०५", "content_sanskrit": "सप्तानां मरुतां लोकान् वसूनां चापि सोऽश्नुते ।\nविमाने स्फाटिके र्दिव्ये सर्वरत्नैरलङ्कृते\t॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2202417, "chapter_id": 5309, "verse_number": "१०६", "content_sanskrit": "गन्धर्वैरप्सरोभिश्च पूज्यमानः प्रमोदते ।\nद्वे युगानां सहस्रे तु दिव्ये दिव्येन तेजसा\t॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2202418, "chapter_id": 5309, "verse_number": "१०७", "content_sanskrit": "सप्तविंशे तु दिवसे यः प्राशेदेकभोजनम् ।\nसदा द्वादश मासांस्तु जुह्वानो जातवेदसम्\t॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2202419, "chapter_id": 5309, "verse_number": "१०८", "content_sanskrit": "फलं प्राप्नोति विपुलं देवलोके च पूज्यते ।\nअमृताशी वसंस्तत्र स वितृप्तः प्रमोदते\t॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2202420, "chapter_id": 5309, "verse_number": "१०९", "content_sanskrit": "देवर्षिचरितं राजन् राजर्षिभिरधिष्ठितम् ।\nअध्यावसति दिव्यात्मा विमानवरमास्थितः\t॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2202421, "chapter_id": 5309, "verse_number": "११०", "content_sanskrit": "स्त्रीभिर्मनोभिरामाभी रममाणो मदोत्कटः ।\nयुगकल्पसहस्राणि त्रीण्यावसति वै सुखम्\t॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2202422, "chapter_id": 5309, "verse_number": "१११", "content_sanskrit": "योऽष्टाविंशे तु दिवसे प्राश्नीयादेकभोजनम् ।\nसदा द्वादश मासांस्तु जितात्मा विजितेन्द्रियः\t॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2202423, "chapter_id": 5309, "verse_number": "११२", "content_sanskrit": "फलं देवर्षिचरितं विपुलं समुपाश्नुते ।\nभोगवांस्तेजसा भाति सहस्रांशुरिवामलः\t॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2202424, "chapter_id": 5309, "verse_number": "११३", "content_sanskrit": "सुकुमार्यश्च नार्यस्तम् अमराणां सुवर्चसाम् ।\nपीनस्तनोरुजघना दिव्याभरणभूषिताः\t॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2202425, "chapter_id": 5309, "verse_number": "११४", "content_sanskrit": "रमयन्ति मनःकान्ता विमाने सूर्यसन्निभे ।\nसर्वकामगमे दिव्ये कल्पायुतशतं समाः\t॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2202426, "chapter_id": 5309, "verse_number": "११५", "content_sanskrit": "एकोनत्रिंशे दिवसे यः प्राशेदेकभोजनम् ।\nसदा द्वादश मासान् वै सत्यव्रतपरायणः\t॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2202427, "chapter_id": 5309, "verse_number": "११६", "content_sanskrit": "तस्य लोकाः शुभा दिव्या देवराजर्षिपूजिताः ।\nविमानं चन्द्रशुभ्राभं दिव्यं समधिगच्छति\t॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2202428, "chapter_id": 5309, "verse_number": "११७", "content_sanskrit": "जातरूपमयं युक्तं सर्वरत्नविभूषितम् ।\nअप्सरोगणसम्पूर्णं गन्धर्वैरुपशोभितम्\t॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2202429, "chapter_id": 5309, "verse_number": "११८", "content_sanskrit": "तत्र चैनं शुभा नार्यो दिव्याभरणभूषिताः ।\nमनोभिरामा मधुरा रमयन्ति मदोत्कटाः\t॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2202430, "chapter_id": 5309, "verse_number": "११९", "content_sanskrit": "भोगवांस्तेजसा युक्तो वैश्वानरसमप्रभः ।\nदिव्यो दिव्येन वपुषा भ्राजमान इवामरः\t॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2202431, "chapter_id": 5309, "verse_number": "१२०", "content_sanskrit": "वसूनां मरुतां चैव साध्यानामश्विनोस्तथा ।\nरुद्राणां च तथा लोकान् ब्रह्मलोकगतिर्भवेत्\t॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2202432, "chapter_id": 5309, "verse_number": "१२१", "content_sanskrit": "यस्तु मासे गते भुङ्क्ते एकभक्तं शमात्मकः ।\nसदा द्वादश मासान् वै ब्रह्मलोकमवाप्नुयात्\t॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2202433, "chapter_id": 5309, "verse_number": "१२२", "content_sanskrit": "सुधारसकृताहारः श्रीमान् सर्वमनोहरः ।\nतेजसा वपुषा लक्ष्म्या भ्राजते रश्मिवानिव\t॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2202434, "chapter_id": 5309, "verse_number": "१२३", "content_sanskrit": "दिव्यमाल्याम्बरधरो दिव्यगन्धानुलेपनः ।\nसुखेष्वभिरतो योगी दुःखानामविजानकः\t॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2202435, "chapter_id": 5309, "verse_number": "१२४", "content_sanskrit": "स्वयम्प्रभाभिर्नारीभिर्विमानस्थो महीयते ।\nरुद्रदेवर्षिकन्याभिः सततं चाभिपूज्यते\t॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2202436, "chapter_id": 5309, "verse_number": "१२५", "content_sanskrit": "नानाविधसुरूपाभिर्नानारागाभिरेव च ।\nनानामधुरभाषाभिर्नानारतिभिरेव च\t॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2202437, "chapter_id": 5309, "verse_number": "१२६", "content_sanskrit": "विमाने नगराकारे सूर्यवत् सूर्यसन्निभे ।\nपृष्ठतः सोमसङ्काशे उदर्केचाभ्रसन्निभे\t॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2202438, "chapter_id": 5309, "verse_number": "१२७", "content_sanskrit": "दक्षिणायां तु रक्ताभे अधस्तान्नीलमण्डले ।\nऊर्ध्वं चित्राभिसङ्काशे नैको वसति पूजितः\t॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2202439, "chapter_id": 5309, "verse_number": "१२८", "content_sanskrit": "यावद्वर्षसहस्रं तु जम्बूद्वीपे प्रवर्षति ।\nतावत् संवत्सराः प्रोक्ता ब्रह्मलोकस्य धीमतः\t॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2202440, "chapter_id": 5309, "verse_number": "१२९", "content_sanskrit": "विप्रुषश्चैव यावन्त्यो निपतन्ति नभस्तळात् ।\nवर्षासु वर्षतस्तावन्निवसत्यमरप्रभः\t॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2202441, "chapter_id": 5309, "verse_number": "१३०", "content_sanskrit": "मासोपवासी वर्षैस्तु दशभिः स्वर्गमुत्तमम् ।\nमहर्षित्वमथासाद्य सशरीरगतिर्भवेत्\t॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2202442, "chapter_id": 5309, "verse_number": "१३१", "content_sanskrit": "मुनिर्दान्तो जितक्रोधो जितशिश्नोदरः सदा ।\nजुह्वन्नग्नींश्च नियतः सन्ध्योपासनसेविता\t॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2202443, "chapter_id": 5309, "verse_number": "१३२", "content_sanskrit": "बहुभिर्नियमैरेवं मासानश्नाति यो नरः ।\nअभ्रावकाशशीलश्च तस्य भानोरिव त्विषः\t॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2202444, "chapter_id": 5309, "verse_number": "१३३", "content_sanskrit": "दिवं गत्वा शरीरेण स्वेन राजन् यथाऽमरः ।\nस्वर्गं पुण्यं यथाकाममुपभुङ्क्ते यथाविधि\t॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2202445, "chapter_id": 5309, "verse_number": "१३४", "content_sanskrit": "एष ते भरतश्रेष्ठ यज्ञानां विधिरुत्तमः ।\nव्याख्यातो ह्यानुपूर्व्येण उपवासफलात्मकः\t॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 2202446, "chapter_id": 5309, "verse_number": "१३५", "content_sanskrit": "दरिद्रैर्मनुजैः पार्थ प्राप्यं यज्ञफलं यथा ।\nउपवासमिमं कृत्वा गच्छेच्च परमां गतिम् ।\nदेवद्विजातिपूजायां रतो भरतसत्तम\t॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 2202447, "chapter_id": 5309, "verse_number": "१३६", "content_sanskrit": "उपवासविधिस्त्वेष विस्तरेण प्रकीर्तितः ।\nनियतेष्वप्रमत्तेषु शौचवत्सु महत्सु च\t॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 2202448, "chapter_id": 5309, "verse_number": "१३७", "content_sanskrit": "दम्भद्रोहनिवृत्तेषु कृतबुद्धिषु भारत ।\nअचलेष्वप्रकम्पेषु मा ते भूदत्र संशयः\t॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 2202449, "chapter_id": 5309, "verse_number": "१६०", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे उपवासविधिर्नाम षष्ट्युत्तरशततमोध्यायः ॥१६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}]