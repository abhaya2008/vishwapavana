[{"id": 5000099000, "chapter_id": 9099, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे द्वाविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000099001, "chapter_id": 9099, "verse_number": "२-२२-१", "content_sanskrit": "अथ तं व्यथया दीनं सविशेषममर्षितम्।\nसरोषमिव नागेन्द्रं रोषविस्फारितेक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000099002, "chapter_id": 9099, "verse_number": "२-२२-२", "content_sanskrit": "आसाद्य रामः सौमित्रिं सुहृदं भ्रातरं प्रियम्।\nउवाचेदं स धैर्येण धारयन् सत्त्वमात्मवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000099003, "chapter_id": 9099, "verse_number": "२-२२-३", "content_sanskrit": "निगृह्य रोषं शोकं च धैर्यमाश्रित्य केवलम्।\nअवमानं निरस्यैनं गृहीत्वा हर्षमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000099004, "chapter_id": 9099, "verse_number": "२-२२-४", "content_sanskrit": "उपक्लृप्तं यदैतन्मे अभिषेकार्थमुत्तमम्।\nसर्वं निवर्तय क्षिप्रं कुरु कार्यं निरव्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000099005, "chapter_id": 9099, "verse_number": "२-२२-५", "content_sanskrit": "सौमित्रे योऽभिषेकार्थे मम सम्भारसम्भ्रमः।\nअभिषेकनिवृत्त्यर्थे सोऽस्तु सम्भारसम्भ्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000099006, "chapter_id": 9099, "verse_number": "२-२२-६", "content_sanskrit": "यस्या मदभिषेकार्थे मानसं परितप्यते।\nमाता नः सा यथा न स्यात् सविशङ्का तथा कुरु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000099007, "chapter_id": 9099, "verse_number": "२-२२-७", "content_sanskrit": "तस्याः शङ्कामयं दुःखं मुहूर्तमपि नोत्सहे।\nमनसि प्रतिसंजातं सौमित्रेऽहमुपेक्षितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000099008, "chapter_id": 9099, "verse_number": "२-२२-८", "content_sanskrit": "न बुद्धिपूर्वं नाबुद्धं स्मरामीह कदाचन।\nमातॄणां वा पितुर्वाहं कृतमल्पं च विप्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000099009, "chapter_id": 9099, "verse_number": "२-२२-९", "content_sanskrit": "सत्यः सत्याभिसंधश्च नित्यं सत्यपराक्रमः।\nपरलोकभयाद् भीतो निर्भयोऽस्तु पिता मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000099010, "chapter_id": 9099, "verse_number": "२-२२-१०", "content_sanskrit": "तस्यापि हि भवेदस्मिन् कर्मण्यप्रतिसंहृते।\nसत्यं नेति मनस्तापस्तस्य तापस्तपेच्च माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000099011, "chapter_id": 9099, "verse_number": "२-२२-११", "content_sanskrit": "अभिषेकविधानं तु तस्मात् संहृत्य लक्ष्मण।\nअन्वगेवाहमिच्छामि वनं गन्तुमितः पुरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000099012, "chapter_id": 9099, "verse_number": "२-२२-१२", "content_sanskrit": "मम प्रव्राजनादद्य कृतकृत्या नृपात्मजा।\nसुतं भरतमव्यग्रमभिषेचयतां ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000099013, "chapter_id": 9099, "verse_number": "२-२२-१३", "content_sanskrit": "मयि चीराजिनधरे जटामण्डलधारिणि।\nगतेऽरण्यं च कैकेय्या भविष्यति मनः सुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000099014, "chapter_id": 9099, "verse_number": "२-२२-१४", "content_sanskrit": "बुद्धिः प्रणीता येनेयं मनश्च सुसमाहितम्।\nतं नु नार्हामि संक्लेष्टुं प्रव्रजिष्यामि मा चिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000099015, "chapter_id": 9099, "verse_number": "२-२२-१५", "content_sanskrit": "कृतान्त एव सौमित्रे द्रष्टव्यो मत्प्रवासने।\nराज्यस्य च वितीर्णस्य पुनरेव निवर्तने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000099016, "chapter_id": 9099, "verse_number": "२-२२-१६", "content_sanskrit": "कैकेय्याः प्रतिपत्तिर्हि कथं स्यान्मम वेदने।\nयदि तस्या न भावोऽयं कृतान्तविहितो भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000099017, "chapter_id": 9099, "verse_number": "२-२२-१७", "content_sanskrit": "जानासि हि यथा सौम्य न मातृषु ममान्तरम्।\nभूतपूर्वं विशेषो वा तस्या मयि सुतेऽपि वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000099018, "chapter_id": 9099, "verse_number": "२-२२-१८", "content_sanskrit": "सोऽभिषेकनिवृत्त्यर्थैः प्रवासार्थैश्च दुर्वचैः।\nउग्रैर्वाक्यैरहं तस्या नान्यद् दैवात् समर्थये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000099019, "chapter_id": 9099, "verse_number": "२-२२-१९", "content_sanskrit": "कथं प्रकृतिसम्पन्ना राजपुत्री तथागुणा।\nब्रूयात् सा प्राकृतेव स्त्री मत्पीड्यं भर्तृसंनिधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000099020, "chapter_id": 9099, "verse_number": "२-२२-२०", "content_sanskrit": "यदचिन्त्यं तु तद् दैवं भूतेष्वपि न हन्यते।\nव्यक्तं मयि च तस्यां च पतितो हि विपर्ययः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000099021, "chapter_id": 9099, "verse_number": "२-२२-२१", "content_sanskrit": "कश्च दैवेन सौमित्रे योद्धुमुत्सहते पुमान्।\nयस्य नु ग्रहणं किंचित् कर्मणोऽन्यन्न दृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000099022, "chapter_id": 9099, "verse_number": "२-२२-२२", "content_sanskrit": "सुखदुःखे भयक्रोधौ लाभालाभौ भवाभवौ।\nयस्य किंचित् तथाभूतं ननु दैवस्य कर्म तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000099023, "chapter_id": 9099, "verse_number": "२-२२-२३", "content_sanskrit": "ऋषयोऽप्युग्रतपसो दैवेनाभिप्रचोदिताः।\nउत्सृज्य नियमांस्तीव्रान् भ्रश्यन्ते काममन्युभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000099024, "chapter_id": 9099, "verse_number": "२-२२-२४", "content_sanskrit": "असंकल्पितमेवेह यदकस्मात् प्रवर्तते।\nनिवर्त्यारब्धमारम्भैर्ननु दैवस्य कर्म तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000099025, "chapter_id": 9099, "verse_number": "२-२२-२५", "content_sanskrit": "एतया तत्त्वया बुद्ध्या संस्तभ्यात्मानमात्मना।\nव्याहतेऽप्यभिषेके मे परितापो न विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000099026, "chapter_id": 9099, "verse_number": "२-२२-२६", "content_sanskrit": "तस्मादपरितापः संस्त्वमप्यनुविधाय माम्।\nप्रतिसंहारय क्षिप्रमाभिषेचनिकीं क्रियाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000099027, "chapter_id": 9099, "verse_number": "२-२२-२७", "content_sanskrit": "एभिरेव घटैः सर्वैरभिषेचनसम्भृतैः।\nमम लक्ष्मण तापस्ये व्रतस्नानं भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000099028, "chapter_id": 9099, "verse_number": "२-२२-२८", "content_sanskrit": "अथवा किं मयैतेन राज्यद्रव्यमयेन तु।\nउद‍्धृतं मे स्वयं तोयं व्रतादेशं करिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000099029, "chapter_id": 9099, "verse_number": "२-२२-२९", "content_sanskrit": "मा च लक्ष्मण संतापं कार्षीर्लक्ष्म्या विपर्यये।\nराज्यं वा वनवासो वा वनवासो महोदयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000099030, "chapter_id": 9099, "verse_number": "२-२२-३०", "content_sanskrit": "न लक्ष्मणास्मिन् मम राज्यविघ्ने\nमाता यवीयस्यभिशङ्कितव्या।\nदैवाभिपन्ना न पिता कथंचि-\nज्जानासि दैवं हि तथाप्रभावम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000099031, "chapter_id": 9099, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे द्वाविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]