[{"id": 7005839000, "chapter_id": 25839, "verse_number": "१-२२-१", "content_sanskrit": "सूत उवाच ।\nशिवार्चनं प्रवक्ष्यामि भक्तिमुक्तिकरं परम् ।\nशान्तं सर्वगतं शून्यं मात्राद्वादशके स्थितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005839001, "chapter_id": 25839, "verse_number": "१-२२-२", "content_sanskrit": "पञ्च वक्त्राणि ह्रस्वानि दीर्घाण्यंगानि बिन्दुन।\nसविसर्गं वदेदस्त्रं शिव ऊर्घ्वं तथा पुनः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005839002, "chapter_id": 25839, "verse_number": "१-२२-३", "content_sanskrit": "षष्ठेनाधो महामन्त्रो हौमित्येवाखिलार्थदः ।\nहस्ताभ्यां संस्पृशेत्पादावूर्ध्वं पादान्मस्तकम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005839003, "chapter_id": 25839, "verse_number": "१-२२-४", "content_sanskrit": "महामुद्रा हि सर्वेषां करांगन्यासमाचरेत् ।\nतालहस्तेन पृष्ठं च अस्त्रमन्त्रेण शोधयेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005839004, "chapter_id": 25839, "verse_number": "१-२२-५", "content_sanskrit": "कनिष्ठामादितः कृत्वा तर्जन्यंगानि विन्यसेत्।\nपूजनं संप्रवक्ष्यामि कर्णिकायां हृदम्बुजे ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005839005, "chapter_id": 25839, "verse_number": "१-२२-६", "content_sanskrit": "धर्मं ज्ञानं च वैराग्यमैश्वर्य्यादि हृदार्चयेत।\nआवाहनं स्थापनं च पाद्यमर्घ्यं हृदार्पयेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005839006, "chapter_id": 25839, "verse_number": "१-२२-७", "content_sanskrit": "आचामं स्नपनं पूजामेकाधारणतुल्यकाम् ? ।\nअग्निकार्य्यविधिं वक्ष्ये अस्त्रेणोल्लेखनं चरेत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005839007, "chapter_id": 25839, "verse_number": "१-२२-८", "content_sanskrit": "वर्म्मणाभ्युक्षणं कार्य्यं शक्तिन्यासं हृदा चरेत।\nहृदि वा शक्तिगर्त्ते च प्रक्षिपेज्जातवेदसम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005839008, "chapter_id": 25839, "verse_number": "१-२२-९", "content_sanskrit": "गर्भाधानादिकं कृत्वा निष्कृतिं चारस्य पश्चिमाम् ।\nहृदा कृत्वा सर्वकर्म्म शिवं सांगं तु होमयेत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005839009, "chapter_id": 25839, "verse_number": "१-२२-१०", "content_sanskrit": "पूजयेन्मण्डले शम्भुं पद्मगर्भे गरांकितम् ।\nचतुः षष्ट्यन्तमष्टादि स्वाक्षि खाद्यादिमण्डलम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005839010, "chapter_id": 25839, "verse_number": "१-२२-११", "content_sanskrit": "खाक्षीन्द्रसूर्य्यगं सर्वखादिवेदेन्दु (देवेन्दु)र्त्तनम्।\nआग्नेय्यां कारयेत्कुण्डमर्द्धचन्द्रनिभं शुभम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005839011, "chapter_id": 25839, "verse_number": "१-२२-१२", "content_sanskrit": "अग्निशास्त्र परायुस्थो त्दृदयादिगणोच्यते ।\nअस्त्रं दिशा सुपद्मस्य कर्णिकायां सदाशिवः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005839012, "chapter_id": 25839, "verse_number": "१-२२-१३", "content_sanskrit": "दीक्षां वक्ष्ये पञ्चतत्त्वे स्थितां भूम्यादिकां पर।\nनिवृत्तिर्भूप्रतिष्ठाद्यैर्विद्याग्निः शान्तिवन्निजः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005839013, "chapter_id": 25839, "verse_number": "१-२२-१४", "content_sanskrit": "शान्त्यतीतं भवेद्धोम तत्परं शान्तमव्म्।\nएकैकस्य शतं होमित्येवं पंच होमयेत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005839014, "chapter_id": 25839, "verse_number": "१-२२-१५", "content_sanskrit": "पश्चात्पूर्णाहुतिं दत्त्वा प्रा(प्र)सादेन शिवंसमरेत्।\nप्रायश्चित्तविशुद्ध्यर्थमेकैकाष्टाहुतिं क्रमात् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005839015, "chapter_id": 25839, "verse_number": "१-२२-१६", "content_sanskrit": "होमयेदस्त्रबीजेन एवं दीक्षां समाप्येत् ।\nयजनव्यतिरेकेण गोप्यं संस्कारमुत्तमम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005839016, "chapter_id": 25839, "verse_number": "१-२२-१७", "content_sanskrit": "एवं संस्कारशुद्धस्य शिवत्वं जायते ध्रुवम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]