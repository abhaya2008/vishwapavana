[{"id": 2117332, "chapter_id": 3527, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2117333, "chapter_id": 3527, "verse_number": "१", "content_sanskrit": "राजन् निःसंशयं श्रेयो वाच्यस्त्वमसि बान्धवैः ।\nन त्वं शुश्रूषमाणो हि वाक्यं सम्प्रति तिष्ठसि \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2117334, "chapter_id": 3527, "verse_number": "२", "content_sanskrit": "प्रियं हितं च यद्वाक्यमुक्तवान् कुरुसत्तमः ।\nभीष्मः शान्तनवो राजा महावीर्यपराक्रमः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2117335, "chapter_id": 3527, "verse_number": "३", "content_sanskrit": "तथा द्रोणेन बहुधा भाषितं हितमुत्तमम् ।\nतच्च राधासुतः कर्णो मन्यते न हितं वचः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2117336, "chapter_id": 3527, "verse_number": "४", "content_sanskrit": "चिन्तयंश्च न पश्यामि राजंस्तव सुहृत्तमम् ।\nआभ्यां पुरुषसिंहाभ्यां यो वा स्यात् प्रज्ञयाऽधिकः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2117337, "chapter_id": 3527, "verse_number": "५", "content_sanskrit": "इमौ हि वृद्धौ वयसा राजनीतिविशारदौ ।\nसमानौ त्वयि राजेन्द्र तेषु पाण्डुसुतेषु च \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2117338, "chapter_id": 3527, "verse_number": "६", "content_sanskrit": "धर्मे चानवमौ राजन् सत्यतायां च भारत ।\nरामाद् दाशरथेश्चैव गयाच्चैव न संशयः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2117339, "chapter_id": 3527, "verse_number": "७", "content_sanskrit": "न चोक्तवन्तावश्रेयः पुरस्तादपि किञ्चन ।\nन चाप्यपकृतं किञ्चिदनयोर्लक्ष्यते त्वयि \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2117340, "chapter_id": 3527, "verse_number": "८", "content_sanskrit": "ताविमौ पुरुषव्याघ्रावनागसि नृप त्वथि ।\nन मन्त्रयेतां त्वच्छ्रेयः कथं सत्यपराक्रमौ \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2117341, "chapter_id": 3527, "verse_number": "९", "content_sanskrit": "प्रज्ञावन्तौ नृप श्रेष्ठावस्मिँल्लोके नराधिप ।\nत्वन्निमित्तमतो नेमौ किञ्चिज्जिह्मं वदिष्यतः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2117342, "chapter_id": 3527, "verse_number": "समाप्तिः", "content_sanskrit": "इति मे नैष्ठिकी बुद्धिर्वर्तते कुरुनन्दन ।\nन चार्थहेतोर्धर्मज्ञौ वक्ष्यतः पक्षसंश्रितम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2117343, "chapter_id": 3527, "verse_number": "११", "content_sanskrit": "एतद्धि परमं श्रेयो मेनाते तव भारत ।\nअथ ते हृदये राजन् विशेषस्तेषु वर्तते \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2117344, "chapter_id": 3527, "verse_number": "१२", "content_sanskrit": "अन्तरं स्थं विवृण्वानाः श्रेयः कुर्युर्न ते ध्रुवम् ।\nएतदर्थं महात्मानाविमौ राजन् महाद्युती \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2117345, "chapter_id": 3527, "verse_number": "१३", "content_sanskrit": "नोचतुर्विवृतं किञ्चिन्न ह्येष तव निश्चयः ।\nतथाप्यशक्यतां तेषामाहतुः पुरुषर्षभौ\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2117346, "chapter_id": 3527, "verse_number": "१४", "content_sanskrit": "तत् तथा पुरुषव्याघ्र तव तद् भद्रमस्तु ते ।\nकथं हि पाण्डवः श्रीमान् सव्यसाची धनञ्जयः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2117347, "chapter_id": 3527, "verse_number": "१५", "content_sanskrit": "शक्यो हि जेतुं सङ्ग्रामे राजन् मघवताऽपि हि ।\nभीमसेनो महाबाहुर्नागायुतबलो महान् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2117348, "chapter_id": 3527, "verse_number": "१६", "content_sanskrit": "कथं हि युधि शक्येत विजेतुममरैरपि ।\nतथैव कृतिनौ युद्धे यमौ यमसुताविव \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2117349, "chapter_id": 3527, "verse_number": "१७", "content_sanskrit": "कथं विषहितुं शक्यौ रणे जीवितुमिच्छता ।\nयस्मिन् धृतिरनुक्रोशः क्षमा सत्यं पराक्रमः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2117350, "chapter_id": 3527, "verse_number": "१८", "content_sanskrit": "नित्यानि पाण्डवे ज्येष्ठे स जयी न कथं रणे ।\nयेषां पक्षधरो रामो येषां मन्त्री च केशवः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2117351, "chapter_id": 3527, "verse_number": "१९", "content_sanskrit": "किं नु तैरजितं सङ्खे येषां पक्षे च सात्यकिः ।\nद्रुपदः श्वशुरो येषां येषां स्यालाश्च पार्षताः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2117352, "chapter_id": 3527, "verse_number": "२०", "content_sanskrit": "धृष्टद्युम्नमुखा वीरा भ्रातरो द्रुपदात्मजाः ।\nचैद्यश्च येषां भ्राता च शिशुपालो महारथः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2117353, "chapter_id": 3527, "verse_number": "२१", "content_sanskrit": "सोऽशक्यतां च विज्ञाय तेषां युद्धेन भारत ।\nदायाद्यतां च धर्मेण सम्यक् तेषु समाचर \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2117354, "chapter_id": 3527, "verse_number": "२२", "content_sanskrit": "इदं निर्दग्धमयशः पुरोचनकृतं महत् ।\nतेषामनुग्रहेणाद्य राजन् प्रक्षालयात्मनः \t॥ २२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2117355, "chapter_id": 3527, "verse_number": "२३", "content_sanskrit": "तेषामनुग्रहश्चायं सर्वेषां चैव नः कुले ।\nजीविते परमं श्रेयः क्षत्रस्य च विवर्धनम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2117356, "chapter_id": 3527, "verse_number": "२४", "content_sanskrit": "द्रुपदो हि महान् राजा कृतवैरश्च नः पुरा ।\nतस्य सङ्ग्रहणं श्रेयः स्वपक्षस्य च वर्धनम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2117357, "chapter_id": 3527, "verse_number": "२५", "content_sanskrit": "बलवन्तश्च दाशार्हा बहवश्च विशाम्पते ।\nयतः कृष्णस्ततस्ते स्युर्यतः कृष्णस्ततो जयः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2117358, "chapter_id": 3527, "verse_number": "२६", "content_sanskrit": "यच्च सान्त्वेन शक्येत कार्यं साधयितुं नृप ।\nको दैवशप्तस्तत् कर्तुं विग्रहेण समाचरेत्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2117359, "chapter_id": 3527, "verse_number": "२७", "content_sanskrit": "श्रुत्वा च जीवतः पार्थान् पौरजानपदा जनाः ।\nअभवन् मुदिता वृद्धस्तेषां राजन् कुरु प्रियम् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2117360, "chapter_id": 3527, "verse_number": "२८", "content_sanskrit": "दुर्योधनश्च कर्णश्च शकुनिश्चापि सौबलः ।\nअधर्माश्चापि दुष्प्रज्ञा बाला मैषां वचः कृथाः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2117361, "chapter_id": 3527, "verse_number": "२९", "content_sanskrit": "उक्तमेतन्मया राजन् पुरा गुणवतस्तव ।\nदुर्योधनापराधेन प्रज्ञेयं तव नश्यति \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2117362, "chapter_id": 3527, "verse_number": "२०६", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nषडधिकद्विशततमोऽध्यायः ॥२०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2117363, "chapter_id": 3527, "verse_number": "७", "content_sanskrit": "॥ इति विदुरागमनपर्वणि सप्तमोऽध्यायः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2117364, "chapter_id": 3527, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]