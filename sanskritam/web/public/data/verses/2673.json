[{"id": 2078781, "chapter_id": 2673, "verse_number": "१२-१७८-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2078782, "chapter_id": 2673, "verse_number": "१२-१७८-१", "content_sanskrit": "बान्धवाः कर्म वित्तं वा प्रज्ञा वेह पितामह।\nनरस्य का प्रतिष्ठा स्यादेतत्पृष्टो वदस्व मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2078783, "chapter_id": 2673, "verse_number": "१२-१७८-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2078784, "chapter_id": 2673, "verse_number": "१२-१७८-२", "content_sanskrit": "प्रज्ञा प्रतिष्ठा भूतानां प्रज्ञा लाभः परो मतः।\nप्रज्ञा निःश्रेयसी लोके प्रज्ञा स्वर्गो मतः सताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2078785, "chapter_id": 2673, "verse_number": "१२-१७८-३", "content_sanskrit": "प्रज्ञया प्रापितार्थो हि बलिरैश्वर्यसंक्षये।\nप्रह्लादो नमुचिर्मङ्किस्तस्याः किं विद्यते परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2078786, "chapter_id": 2673, "verse_number": "१२-१७८-४", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nइन्द्रकाश्यपसंवादं तन्निबोध युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2078787, "chapter_id": 2673, "verse_number": "१२-१७८-५", "content_sanskrit": "वैश्यः कश्चिदृषिसुतं काश्यपं संशितव्रतम्।\nरथेन पातयामास श्रीमान्दृप्तस्तपस्विनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2078788, "chapter_id": 2673, "verse_number": "१२-१७८-६", "content_sanskrit": "आर्तः स पतितः क्रुद्धस्त्यक्त्वाऽऽत्मानमथाब्रवीत्।\nमरिष्याम्यधनस्येह जीवितार्थो न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2078789, "chapter_id": 2673, "verse_number": "१२-१७८-७", "content_sanskrit": "तथा मुमूर्षमासीनमकूजन्तमचेतसम्।\nइन्द्रः सृगालरूपेण बभाषे क्षुब्धमानसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2078790, "chapter_id": 2673, "verse_number": "१२-१७८-८", "content_sanskrit": "मनुष्ययोनिमिच्छन्ति सर्वभूतानि सर्वशः।\nमनुष्यत्वे च विप्रत्वं सर्व एवाभिनन्दति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2078791, "chapter_id": 2673, "verse_number": "१२-१७८-९", "content_sanskrit": "मनुष्यो ब्राह्मणश्चासि श्रोत्रियश्चासि काश्यप।\nसुदुर्लभमवाप्यैतन्न दोषान्मर्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2078792, "chapter_id": 2673, "verse_number": "१२-१७८-१०", "content_sanskrit": "सर्वे लाभाः साभिमाना इति सत्यवती श्रुतिः।\nसंतोषणीयरूपोऽसि लोभाद्यदभिमन्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2078793, "chapter_id": 2673, "verse_number": "१२-१७८-११", "content_sanskrit": "अहो सिद्धार्थता तेषां येषां सन्तीह पाणयः।\n[अतीव स्पृहये तेषां येषां सन्तीह पाणयः॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2078794, "chapter_id": 2673, "verse_number": "१२-१७८-१२", "content_sanskrit": "पाणिमद्भ्यः स्पृहाऽस्माकं यथा तव धनस्य वै।\nन पाणिलाभादधिको लाभः कश्चन विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2078795, "chapter_id": 2673, "verse_number": "१२-१७८-१३", "content_sanskrit": "अपाणित्वाद्वयं ब्रह्मन्कण्टकं नोद्धरामहे।\nजन्तूनुच्चावचानङ्गे दशतो न कषाम वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2078796, "chapter_id": 2673, "verse_number": "१२-१७८-१४", "content_sanskrit": "अथ येषां पुनः पाणी देवदत्तौ दशाङ्गुली।\nउद्धरन्ति कृमीनङ्गाद्दशतो निकषन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2078797, "chapter_id": 2673, "verse_number": "१२-१७८-१५", "content_sanskrit": "वर्षाहिमातपानां च परित्राणानि कुर्वते।\nचेलमन्नं सुखं शय्यां निवातं चोपभुञ्जते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2078798, "chapter_id": 2673, "verse_number": "१२-१७८-१६", "content_sanskrit": "अधिष्ठाय च गां लोके भुञ्जते वाहयन्ति च।\nउपायैर्बहुभिश्चैव वश्यानात्मनि कुर्वते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2078799, "chapter_id": 2673, "verse_number": "१२-१७८-१७", "content_sanskrit": "ये खल्वजिह्वाः कृपणा अल्पप्राणा अपाणयः।\nसहन्ते तानि दुःखानि दिष्ट्या त्वं न तथा मुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2078800, "chapter_id": 2673, "verse_number": "१२-१७८-१८", "content_sanskrit": "दिष्ट्या त्वं न शृगालो वै न कृमिर्न च मूषकः।\nन सर्पो न च मण्डूको न चान्यः पापयोनिजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2078801, "chapter_id": 2673, "verse_number": "१२-१७८-१९", "content_sanskrit": "एतावताऽपि लाभेन तोष्टुमर्हसि काश्यप।\nकिं पुनर्योसि सत्वानां सर्वेषां ब्राह्मणोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2078802, "chapter_id": 2673, "verse_number": "१२-१७८-२०", "content_sanskrit": "इमे मां कृमयोऽदन्ति येषामुद्धरणाय वै।\nनास्ति शक्तिरपाणित्वात्पश्यावस्थामिमां मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2078803, "chapter_id": 2673, "verse_number": "१२-१७८-२१", "content_sanskrit": "अकार्यमिति चैवेमं नात्मानं संत्यजाम्यहम्।\nनातः पापीयसीं योनिं पतेयमपरामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2078804, "chapter_id": 2673, "verse_number": "१२-१७८-२२", "content_sanskrit": "मध्ये वै पापयोनीनां सृगालीयामहं गतः।\nपापीयस्यो बहुतरा इतोऽन्याः पापयोनयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2078805, "chapter_id": 2673, "verse_number": "१२-१७८-२३", "content_sanskrit": "जात्यैवैके सुखितराः सन्त्यन्ये भृशदुःखिताः।\nनैकान्तं सुखमेवेह क्वचित्पश्यामि कस्यचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2078806, "chapter_id": 2673, "verse_number": "१२-१७८-२४", "content_sanskrit": "मनुष्या ह्याढ्यतां प्राप्य राज्यमिच्छन्त्यनन्तरम्।\nराज्याद्देवत्वमिच्छन्ति देवत्वादिन्द्रतामपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2078807, "chapter_id": 2673, "verse_number": "१२-१७८-२५", "content_sanskrit": "भवेस्त्वं यद्यपि त्वाढ्यो न राजा न च दैवतम्।\nदेवत्वं प्राप्य चेन्द्रत्वं नैव तुष्येस्तथा सति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2078808, "chapter_id": 2673, "verse_number": "१२-१७८-२६", "content_sanskrit": "न तृप्तिः प्रियलाभेऽस्ति तृष्णा नाद्भिः प्रशाम्यति।\nसंप्रज्वलति सा भूयः समिद्भिरिव पावकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2078809, "chapter_id": 2673, "verse_number": "१२-१७८-२७", "content_sanskrit": "अस्त्येव त्वयि शोकोऽपि हर्षश्चापि तथा त्वयि।\nसुखदुःखे तथा चोभे तत्र का परिदेवना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2078810, "chapter_id": 2673, "verse_number": "१२-१७८-२८", "content_sanskrit": "परिच्छिद्यैव कामानां सर्वेषां चैव कर्मणाम्।\nमूलं बुद्धीन्द्रियग्रामं शकुन्तानिव पञ्जरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2078811, "chapter_id": 2673, "verse_number": "१२-१७८-२९", "content_sanskrit": "न द्वितीयस्य शिरसश्छेदनं विद्यते क्वचित्।\nन च पाणेस्तृतीयस्य यन्नास्ति न ततो भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2078812, "chapter_id": 2673, "verse_number": "१२-१७८-३०", "content_sanskrit": "न खल्वप्यरसज्ञस्य कामः क्वचन जायते।\nसंस्पर्शाद्दर्शनाद्वापि श्रवणाद्वापि जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2078813, "chapter_id": 2673, "verse_number": "१२-१७८-३१", "content_sanskrit": "न त्वं स्मरसि वारुण्या लट्वाकानां च पक्षिणाम्।\nताभ्यां चाभ्यधिको भक्ष्यो न कश्चिद्विद्यते क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2078814, "chapter_id": 2673, "verse_number": "१२-१७८-३२", "content_sanskrit": "यानि चान्यानि भूतेषु भक्ष्यभोज्यानि काश्यप।\nयेषामभुक्तपूर्वाणि तेषामस्मृतिरेव ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2078815, "chapter_id": 2673, "verse_number": "१२-१७८-३३", "content_sanskrit": "अप्राशनमसंस्पर्शमसंदर्शनमेव च।\nपुरुषस्यैष नियमो मन्ये श्रेयो न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2078816, "chapter_id": 2673, "verse_number": "१२-१७८-३४", "content_sanskrit": "पाणिमन्तो बलवन्तो धनवन्तो न संशयः।\nमनुष्या मानुषैरेव दासत्वमुपपादिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2078817, "chapter_id": 2673, "verse_number": "१२-१७८-३५", "content_sanskrit": "वधबन्धपरिक्लेशैः क्लिश्यन्ते च पुनः पुनः।\nते खल्वपि रमन्ते च मोदन्ते च हसन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2078818, "chapter_id": 2673, "verse_number": "१२-१७८-३६", "content_sanskrit": "अपरे बाहुबलिनः कृतविद्या मनस्विनः।\nजुगुप्सितां च कृपणां पापवृत्तिमुपासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2078819, "chapter_id": 2673, "verse_number": "१२-१७८-३७", "content_sanskrit": "उत्सहन्ते च ते वृत्तिमन्यामप्युपसेवितुम्।\nस्वकर्मणा तु नियतं भवितव्यं तु तत्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2078820, "chapter_id": 2673, "verse_number": "१२-१७८-३८", "content_sanskrit": "न पुल्कसो न चण्डाल आत्मानं त्यक्तुमिच्छति।\nतया तुष्टः स्वया योन्या मायां पश्यस्व यादृशीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2078821, "chapter_id": 2673, "verse_number": "१२-१७८-३९", "content_sanskrit": "दृष्ट्वा कुणीन्पक्षहतान्मनुष्यानामयाविनः।\nसुसंपूर्णः स्वया योन्या लब्धलाभोसि काश्यप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2078822, "chapter_id": 2673, "verse_number": "१२-१७८-४०", "content_sanskrit": "यदि ब्राह्मणदेहस्ते निरातङ्को निरामयः।\nअङ्गानि च समग्राणि न च लोकेषु धिक्कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2078823, "chapter_id": 2673, "verse_number": "१२-१७८-४१", "content_sanskrit": "न केनचित्प्रवादेन सत्येनैवापहारिणा।\nधर्मायोत्तिष्ठ विप्रर्षे नात्मानं त्यक्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2078824, "chapter_id": 2673, "verse_number": "१२-१७८-४२", "content_sanskrit": "यदि ब्रह्मञ्शृणोष्येतच्छ्रद्दधासि च मे वचः।\nवेदोक्तस्यैव धर्मस्य फलं मुख्यमवाप्स्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2078825, "chapter_id": 2673, "verse_number": "१२-१७८-४३", "content_sanskrit": "स्वाध्यायमग्निसंस्कारमप्रमत्तोऽनुपालय।\nसत्यं दमं च दानं च स्पर्धिष्ठा मा च केनचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2078826, "chapter_id": 2673, "verse_number": "१२-१७८-४४", "content_sanskrit": "ये केचन स्वध्ययनाः प्राप्ता यजनयाजनम्।\nकथं ते चानुशोचेयुर्ध्यायेयुर्वाऽप्यशोभनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2078827, "chapter_id": 2673, "verse_number": "१२-१७८-४५", "content_sanskrit": "इच्छन्तस्ते विहाराय सुखं महदवाप्नुयुः।\nयेऽनुजाताः सुनक्षत्रे सुतिथौ सुमुहूर्तके।\nयज्ञदानप्रजेहायां यतन्ते शक्तिपूर्वकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2078828, "chapter_id": 2673, "verse_number": "१२-१७८-४६", "content_sanskrit": "नक्षत्रेष्वासुरेष्वन्ये दुस्तिथौ दुर्मुहूर्तजाः।\nसम्पतन्त्यासुरीं योनिं यज्ञप्रसववर्जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2078829, "chapter_id": 2673, "verse_number": "१२-१७८-४७", "content_sanskrit": "अहमासं पण्डितको हैतुको वेदनिन्दकः।\nआन्वीक्षिकीं तर्कविद्यामनुरक्तो निरर्थिकाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2078830, "chapter_id": 2673, "verse_number": "१२-१७८-४८", "content_sanskrit": "हेतुवादान्प्रवदिता वक्ता संसत्सु हेतुमत्।\nआक्रोष्टा चातिवक्ता च ब्रह्मवाक्येषु च द्विजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2078831, "chapter_id": 2673, "verse_number": "१२-१७८-४९", "content_sanskrit": "नास्तिकः सर्वशङ्की च मूर्खः पण्डितमानिकः।\nतस्येयं फलनिर्वृत्तिः सृगालत्वं मम द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2078832, "chapter_id": 2673, "verse_number": "१२-१७८-५०", "content_sanskrit": "अपि जातु तथा तत्स्यादहोरात्रशतैरपि।\nयदहं मानुषीं योनिं सृगालः प्राप्नुयां पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2078833, "chapter_id": 2673, "verse_number": "१२-१७८-५१", "content_sanskrit": "संतुष्टश्चाप्रमत्तश्च यज्ञदानतपोरतः।\nज्ञेयं ज्ञाता भवेयं वै वर्ज्यं वर्जयिता तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2078834, "chapter_id": 2673, "verse_number": "१२-१७८-५२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2078835, "chapter_id": 2673, "verse_number": "१२-१७८-५२", "content_sanskrit": "ततः स मुनिरुत्थाय काश्यपस्तमुवाच ह।\nअहो बतामि कुशलो बुद्धिमांश्चेति विस्मितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2078836, "chapter_id": 2673, "verse_number": "१२-१७८-५३", "content_sanskrit": "समवैक्षत तं विप्रो ज्ञानदीर्घेण चक्षुषा।\nददर्श चैनं देवानां देवमिन्द्रं शचीपतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2078837, "chapter_id": 2673, "verse_number": "१२-१७८-५४", "content_sanskrit": "ततः संपूजयामास काश्यपो हरिवाहनम्।\nअनुज्ञातस्तु तेनाथ प्रविवेश स्वमालयम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2078838, "chapter_id": 2673, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि अष्टसप्तत्यधिकशततमोऽध्यायः॥ १७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]