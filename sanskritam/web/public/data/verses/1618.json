[{"id": 2028496, "chapter_id": 1618, "verse_number": "३-२५६-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2028497, "chapter_id": 1618, "verse_number": "३-२५६-१", "content_sanskrit": "जित्वा तु पृथिवीं राजन्सूतपुत्रो जनाधिप।\nअब्रवीत्परवीरघ्नो दुर्योधनमिदं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2028498, "chapter_id": 1618, "verse_number": "३-२५६-२", "content_sanskrit": "दुर्योधन निबोधेदं यत्त्वां वक्ष्यामि कौरव।\nश्रुत्वा वाचं तथा सर्वं कर्तुमर्हस्यरिंदम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2028499, "chapter_id": 1618, "verse_number": "३-२५६-३", "content_sanskrit": "तवाद्य पृथिवी वीर निःसपत्ना नृपोत्तम।\nतां पालय यथा शक्रो हतशत्रुर्महामनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2028500, "chapter_id": 1618, "verse_number": "३-२५६-४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2028501, "chapter_id": 1618, "verse_number": "३-२५६-४", "content_sanskrit": "एवमुक्तस्तु कर्णेन कर्णं राजाऽब्रवीत्पुनः।\nन किंचिद्दुर्लभं तस्य यस् त्वं पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2028502, "chapter_id": 1618, "verse_number": "३-२५६-५", "content_sanskrit": "सहायश्चानुरक्तश्च मदर्थं च समुद्यतः।\nअभिप्रायस्तु मे कश्चित्तं वै शृणु यथातथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2028503, "chapter_id": 1618, "verse_number": "३-२५६-६", "content_sanskrit": "राजसूयं पाण्डवस्य दृष्ट्वा क्रतुवरं तदा।\nकमम स्पृहा समुत्पन्ना तां संपादय सूतज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2028504, "chapter_id": 1618, "verse_number": "३-२५६-७", "content_sanskrit": "एवमुक्तस्ततः कर्णो राजानमिदमब्रवीत्।\nतवाद्य पृथिवीपाला वश्याः सर्वे नृपोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2028505, "chapter_id": 1618, "verse_number": "३-२५६-८", "content_sanskrit": "आहूयन्तां द्विजवराः संभाराश्च यथाविधि।\nसंभ्रियन्तां कुरुश्रेष्ठ यज्ञोपकरणानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2028506, "chapter_id": 1618, "verse_number": "३-२५६-९", "content_sanskrit": "ऋत्विजश्च समाहूता यथोक्तं वेदपारगाः।\nक्रियां कुर्वन्तु ते राजन्यथाशास्त्रमरिंदम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2028507, "chapter_id": 1618, "verse_number": "३-२५६-१०", "content_sanskrit": "बह्वन्नपानसंयुक्तः सुसमृद्धगुणान्वितः।\nप्रवर्ततां महायज्ञस्तवापि भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2028508, "chapter_id": 1618, "verse_number": "३-२५६-११", "content_sanskrit": "एवमुक्तस्तु कर्णेन धार्तराष्ट्रो विशांपते।\nपुरोहितं समानाय्य वचनं चेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2028509, "chapter_id": 1618, "verse_number": "३-२५६-१२", "content_sanskrit": "राजसूयं क्रतुश्रेष्ठं समाप्तवरदक्षिणम्।\nआहरस्व यथाशास्त्रं यथान्यायं यथाक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2028510, "chapter_id": 1618, "verse_number": "३-२५६-१३", "content_sanskrit": "स एवमुक्तो नृपतिमुवाच द्विजसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2028511, "chapter_id": 1618, "verse_number": "३-२५६-१४", "content_sanskrit": "`ब्राह्मणैः सहितो राजन्ये तत्रासन्समागताः।\nन स शक्यः क्रतुश्रेष्ठो जीवमाने युधिष्ठिरे।\nआहर्तुं कौरवश्रेष्ठ कुले तव नृपोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2028512, "chapter_id": 1618, "verse_number": "३-२५६-१५", "content_sanskrit": "दीर्घायुर्जीवति च ते धृतराष्ट्रः पिता नृप।\nअतश्चापि विरुद्धस्ते क्रतुरेणष नृपोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2028513, "chapter_id": 1618, "verse_number": "३-२५६-१६", "content_sanskrit": "अस्ति त्वन्यन्महत्सत्रं राजसूयसमं प्रभो।\nतेन त्वं यज राजेन्द्र शृणु चेदं वचो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2028514, "chapter_id": 1618, "verse_number": "३-२५६-१७", "content_sanskrit": "य इमे पृथिवीपालाः करदास्तव पार्थिव।\nते करान्संप्रयच्छन्तु सुवर्णं च कृताकृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2028515, "chapter_id": 1618, "verse_number": "३-२५६-१८", "content_sanskrit": "तेन ते क्रियतामद्यलाङ्गलं नृपसत्तम।\nयज्ञवाटस् ते भूमिः कृष्यतां तेन भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2028516, "chapter_id": 1618, "verse_number": "३-२५६-१९", "content_sanskrit": "तत्र यज्ञो नृपश्रेष्टः प्रभूतान्नः सुसंस्कृतः।\nप्रवर्ततां यथान्यायं सर्वतो ह्यनिवारितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2028517, "chapter_id": 1618, "verse_number": "३-२५६-२०", "content_sanskrit": "एष ते वैष्णवो नाम यज्ञः सत्पुरुषोचितः।\nएतेन नेष्टवान्कश्चिदृतेविष्णुं पुरातनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2028518, "chapter_id": 1618, "verse_number": "३-२५६-२१", "content_sanskrit": "राजसूयं क्रतुश्रेष्ठं स्पर्धत्येष महाक्रतुः।\nअस्माकं रोचते चैव श्रेयश्च तव भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2028519, "chapter_id": 1618, "verse_number": "३-२५६-२२", "content_sanskrit": "निर्विघ्नश्च भवत्येष सफला स्यात्स्पृहा तव।\n`तस्मादेष महाबाहो तव यज्ञः प्रवर्तताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2028520, "chapter_id": 1618, "verse_number": "३-२५६-२३", "content_sanskrit": "एवमुकत्स्तु तैर्विप्रैर्धार्तराष्ट्रो महीपतिः।\nकर्णं च सौबलं चैव भ्रातॄश्चैवेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2028521, "chapter_id": 1618, "verse_number": "३-२५६-२४", "content_sanskrit": "रोचते मे वचः कृत्स्नं ब्राह्मणानां न संशयः।\nरोचते यदि युष्माकं तस्मात्प्रब्रूत माचिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2028522, "chapter_id": 1618, "verse_number": "३-२५६-२५", "content_sanskrit": "एवमुक्तास्तु ते सर्वे तथेत्यूचुर्नराधिपम्।\nसंदिदेश ततोराजाव्यापारस्थान्यथाक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2028523, "chapter_id": 1618, "verse_number": "३-२५६-२६", "content_sanskrit": "हलस्य करणे चापि व्यादिष्टाः सर्वशिल्पिनः।\nयथोक्तं च नृपश्रेष्ठ कृतं सर्वं यथाक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2028524, "chapter_id": 1618, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि घोषयात्रापर्वणि षट्पञ्चाशदधिकद्विशततमोऽध्यायः ॥ २५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]