[{"id": 6000234000, "chapter_id": 10234, "verse_number": null, "content_sanskrit": "अथ अष्टत्रिंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000234001, "chapter_id": 10234, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_038/BhP_10.038.001.m4a", "display_order": 2}, {"id": 6000234002, "chapter_id": 10234, "verse_number": "१०-३८-१", "content_sanskrit": "एवं दृष्ट्वा तमक्रूरः प्रसन्नहृदयेन्द्रियः।\nतुष्टाव पुण्डरीकाक्षं भक्त्याऽवनतकन्धरः॥ १०/३८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_038/BhP_10.038.002.m4a", "display_order": 3, "topics": [{"text": "अक्रूरेण भगवत्स्तुतिः", "range": "१–३१"}]}, {"id": 6000234003, "chapter_id": 10234, "verse_number": null, "content_sanskrit": "अक्रूर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_038/BhP_10.038.003.m4a", "display_order": 4}, {"id": 6000234004, "chapter_id": 10234, "verse_number": "१०-३८-२", "content_sanskrit": "नतोऽस्म्यहं त्वाऽखिलहेतुभूतं नारायणं पूरुषमादिमव्ययम्।\nयन्नाभिजातादरविन्दकोशाद् ब्रह्माऽऽविरासीद् यत एष लोकः॥ १०/३८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_038/BhP_10.038.004.m4a", "display_order": 5}, {"id": 6000234005, "chapter_id": 10234, "verse_number": "१०-३८-३", "content_sanskrit": "भूस्तोयमग्निः पवनः खमादिर्महानजादिर्मन इन्द्रियाणि।\nसर्वेन्द्रियार्था विबुधाश्च सर्वे ये हेतवस्ते जगतोऽङ्गभूताः॥ १०/३८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_038/BhP_10.038.005.m4a", "display_order": 6}, {"id": 6000234006, "chapter_id": 10234, "verse_number": "१०-३८-४", "content_sanskrit": "नैते स्वरूपं विदुरात्मनस्ते अजादयोऽन्यात्मतया गृहीताः।\nअजोऽनुबद्धः स गुणैरजाया गुणात् परं वेद न ते स्वरूपम्॥ १०/३८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_038/BhP_10.038.006.m4a", "display_order": 7}, {"id": 6000234007, "chapter_id": 10234, "verse_number": "१०-३८-५", "content_sanskrit": "त्वां योगिनो यजन्त्यद्धा महापुरुषमीश्वरम्।\nसाध्यात्मं साधिभूतं च साधिदैवं च साधवः॥ १०/३८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_038/BhP_10.038.007.m4a", "display_order": 8}, {"id": 6000234008, "chapter_id": 10234, "verse_number": "१०-३८-६", "content_sanskrit": "त्रय्या च विद्यया केचित् त्वां वै वैतानिका द्विजाः।\nयजन्ते विततैर्यज्ञैर्नानारूपामराख्यया॥ १०/३८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_038/BhP_10.038.008.m4a", "display_order": 9}, {"id": 6000234009, "chapter_id": 10234, "verse_number": "१०-३८-७", "content_sanskrit": "एके त्वखिलकर्माणि सन्न्यस्योपशमं गताः।\nज्ञानिनो ज्ञानयज्ञेन यजन्ति ज्ञानविग्रहम्॥ १०/३८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_038/BhP_10.038.009.m4a", "display_order": 10}, {"id": 6000234010, "chapter_id": 10234, "verse_number": "१०-३८-८", "content_sanskrit": "अन्ये तु संस्कृतात्मानो विधिना विहितेन वै।\nयजन्ति त्वन्मयास्त्वां वै बहुमूर्त्यैकमूर्तिकम्॥ १०/३८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_038/BhP_10.038.010.m4a", "display_order": 11}, {"id": 6000234011, "chapter_id": 10234, "verse_number": "१०-३८-९", "content_sanskrit": "त्वामेवान्ये शिवोक्तेन मार्गेण शिवरूपिणम्।\nबह्वाचार्यविभेदेन भगवन् समुपासते॥ १०/३८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_038/BhP_10.038.011.m4a", "display_order": 12}, {"id": 6000234012, "chapter_id": 10234, "verse_number": "१०-३८-१०", "content_sanskrit": "सर्व एव यजन्ति त्वां सर्वदेवमहेश्वरम्।\nयेप्यन्यदेवताभक्ता यद्यप्यन्यधियः प्रभो॥ १०/३८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_038/BhP_10.038.012.m4a", "display_order": 13}, {"id": 6000234013, "chapter_id": 10234, "verse_number": "१०-३८-११", "content_sanskrit": "यथाऽद्रिप्रभवा नद्यः पर्जन्यापूरिता विभो।\nविशन्ति सर्वतः सिन्धुं तद्वत् त्वां गतयोऽन्ततः॥ १०/३८/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_038/BhP_10.038.013.m4a", "display_order": 14}, {"id": 6000234014, "chapter_id": 10234, "verse_number": "१०-३८-१२", "content_sanskrit": "सत्त्वं रजस्तम इति भवतः प्रकृतेर्गुणाः।\nतेषु हि प्राकृताः प्रोता आब्रह्म स्थावरादयः॥ १०/३८/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_038/BhP_10.038.014.m4a", "display_order": 15}, {"id": 6000234015, "chapter_id": 10234, "verse_number": "१०-३८-१३", "content_sanskrit": "तुभ्यं नमस्तेऽस्त्वविषक्तदृष्टये सर्वात्मने सर्वधियां च साक्षिणे।\nगुणप्रवाहोऽयमविद्यया ततःप्रवर्तते देवनृतिर्यगात्मसु॥ १०/३८/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_038/BhP_10.038.015.m4a", "display_order": 16}, {"id": 6000234016, "chapter_id": 10234, "verse_number": "१०-३८-१४", "content_sanskrit": "अग्निर्मुखं तेऽवनिरङ्घ्रिरीक्षणं सूर्यो नभो नाभिरथो दिशः श्रुतिः।\nद्यौः कं सुरेन्द्रास्तव बाहवोऽर्णवाः कुक्षिर्मरुत् प्राणबलं प्रकल्पितम्॥ १०/३८/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_038/BhP_10.038.016.m4a", "display_order": 17}, {"id": 6000234017, "chapter_id": 10234, "verse_number": "१०-३८-१५", "content_sanskrit": "रोमाणि वृक्षौषधयः शिरोरुहा मेघाः परस्यास्थिनखानि तेऽद्रयः।\nनिमेषणं रात्र्यहनी प्रजापतिर्मेढ्रं तु वृष्टिस्तव वीर्यमिष्यते॥ १०/३८/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_038/BhP_10.038.017.m4a", "display_order": 18}, {"id": 6000234018, "chapter_id": 10234, "verse_number": "१०-३८-१६", "content_sanskrit": "त्वय्यव्ययात्मन् पुरुषे प्रकल्पिता लोकाः सपाला बहुजीवसङ्कुलाः।\nयथा जले सञ्जिहते जलौकसोऽप्युदुम्बरे वा मशका मनोमये॥ १०/३८/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_038/BhP_10.038.018.m4a", "display_order": 19}, {"id": 6000234019, "chapter_id": 10234, "verse_number": "१०-३८-१७", "content_sanskrit": "यानि यानीह रूपाणि क्रीडनार्थं विभर्षि हि।\nतैरामृष्टशुचो लोका मुदा गायन्ति ते यशः॥ १०/३८/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_038/BhP_10.038.019.m4a", "display_order": 20}, {"id": 6000234020, "chapter_id": 10234, "verse_number": "१०-३८-१८", "content_sanskrit": "नमः कारणमत्स्याय प्रलयाब्धिचराय च।\nहयशीर्ष्णे नमस्तुभ्यं मधुकैटभमृत्यवे॥ १०/३८/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_038/BhP_10.038.020.m4a", "display_order": 21}, {"id": 6000234021, "chapter_id": 10234, "verse_number": "१०-३८-१९", "content_sanskrit": "अकूपाराय बृहते नमो मन्दरधारिणे।\nक्षित्युद्धारविहाराय नमः सूकरमूर्तये॥ १०/३८/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_038/BhP_10.038.021.m4a", "display_order": 22}, {"id": 6000234022, "chapter_id": 10234, "verse_number": "१०-३८-२०", "content_sanskrit": "नमस्तेऽद्भुतसिंहाय साधुलोकभयापह।\nवामनाय नमस्तुभ्यं क्रान्तत्रिभुवनाय च॥ १०/३८/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_038/BhP_10.038.022.m4a", "display_order": 23}, {"id": 6000234023, "chapter_id": 10234, "verse_number": "१०-३८-२१", "content_sanskrit": "नमो भृगूणां पतये दृप्तक्षत्त्रवनच्छिदे।\nनमस्ते रघुवर्याय रावणान्तकराय च॥ १०/३८/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_038/BhP_10.038.023.m4a", "display_order": 24}, {"id": 6000234024, "chapter_id": 10234, "verse_number": "१०-३८-२२", "content_sanskrit": "नमस्ते वासुदेवाय नमः सङ्कर्षणाय च।\nप्रद्युम्नायानिरुद्धाय सात्वतां पतये नमः॥ १०/३८/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_038/BhP_10.038.024.m4a", "display_order": 25}, {"id": 6000234025, "chapter_id": 10234, "verse_number": "१०-३८-२३", "content_sanskrit": "नमो बुद्धाय शुद्धाय दैत्यदानवमोहिने।\nम्लेञ्छप्रायक्षत्त्रहन्त्रे नमस्ते कल्किरूपिणे॥ १०/३८/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_038/BhP_10.038.025.m4a", "display_order": 26}, {"id": 6000234026, "chapter_id": 10234, "verse_number": "१०-३८-२४", "content_sanskrit": "भगवन् जीवलोकोऽयं मोहितस्तव मायया।\nअहं ममेत्यसद्ग्राहो भ्राम्यते कर्मवर्त्मसु॥ १०/३८/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_038/BhP_10.038.026.m4a", "display_order": 27}, {"id": 6000234027, "chapter_id": 10234, "verse_number": "१०-३८-२५", "content_sanskrit": "अहं चात्मात्मजागारदारार्थस्वजनादिषु।\nभ्रमामि स्वप्नकल्पेषु मूढः सुखधिया विभो॥ १०/३८/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_038/BhP_10.038.027.m4a", "display_order": 28}, {"id": 6000234028, "chapter_id": 10234, "verse_number": "१०-३८-२६", "content_sanskrit": "अनित्यानात्मदुःखेषु विपर्ययमतिर्ह्यहम्।\nद्वन्द्वारामस्तमोनिष्ठो न जाने त्वां जगत्पते॥ १०/३८/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_038/BhP_10.038.028.m4a", "display_order": 29}, {"id": 6000234029, "chapter_id": 10234, "verse_number": "१०-३८-२७", "content_sanskrit": "यथाऽबुधो जलं हित्वा प्रतिच्छन्नं तदुद्भवैः।\nअभ्येति मृगतृष्णां वै हित्वाऽहं त्वा पराङ्मुखः॥ १०/३८/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_038/BhP_10.038.029.m4a", "display_order": 30}, {"id": 6000234030, "chapter_id": 10234, "verse_number": "१०-३८-२८", "content_sanskrit": "नोत्सहेऽहं कृपणधीः कामकर्महतं मनः।\nरोद्धुं प्रमाथिभिश्चाक्षैर्ह्रियमाणमितस्ततः॥ १०/३८/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_038/BhP_10.038.030.m4a", "display_order": 31}, {"id": 6000234031, "chapter_id": 10234, "verse_number": "१०-३८-२९", "content_sanskrit": "सोऽहं तवाङ्घ्य्रुपगतोऽस्म्यसतां दुरापं यच्चाप्यहं भवदनुग्रहमीश मन्ये।\nपुंसो भवेद् यर्हि संसरणापवर्गस्त्वय्यब्जनाभ सदुपासनयामतिः स्यात्॥ १०/३८/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_038/BhP_10.038.031.m4a", "display_order": 32}, {"id": 6000234032, "chapter_id": 10234, "verse_number": "१०-३८-३०", "content_sanskrit": "नमो विज्ञानमात्राय सर्वप्रत्ययहेतवे।\nपुरुषेशप्रधानाय ब्रह्मणेऽनन्तशक्तये॥ १०/३८/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_038/BhP_10.038.032.m4a", "display_order": 33}, {"id": 6000234033, "chapter_id": 10234, "verse_number": "१०-३८-३१", "content_sanskrit": "नमस्ते वासुदेवाय सर्वभूतक्षयाय च।\nहृषीकेश नमस्तुभ्यं प्रपन्नं पाहि मां प्रभो॥ १०/३८/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_038/BhP_10.038.033.m4a", "display_order": 34}, {"id": 6000234034, "chapter_id": 10234, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे अष्टत्रिंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]