[{"id": 2040156, "chapter_id": 1888, "verse_number": "५-१३३-०x", "content_sanskrit": "कुन्त्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2040157, "chapter_id": 1888, "verse_number": "५-१३३-१", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nविदुलायाश्च संवादं पुत्रस्य च परन्तप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2040158, "chapter_id": 1888, "verse_number": "५-१३३-२", "content_sanskrit": "ततः श्रेयश्च भूयश्च यथावद्वक्तुमर्हसि ।\nयशस्विनी मन्युमती कुले जाता विभावरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2040159, "chapter_id": 1888, "verse_number": "५-१३३-३", "content_sanskrit": "क्षत्रधर्मरता दान्ता विदुला दीर्घदर्शिनी ।\nविश्रुता राजसंसत्सु श्रुतवाक्या बहुश्रुता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2040160, "chapter_id": 1888, "verse_number": "५-१३३-४", "content_sanskrit": "विदुला नाम राजन्या जगर्हे पुत्रमौरसम् ।\nनिर्जितं सिन्धुराजेन शयानं दीनचेतसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2040161, "chapter_id": 1888, "verse_number": "५-१३३-५x", "content_sanskrit": "विदुलोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2040162, "chapter_id": 1888, "verse_number": "५-१३३-५", "content_sanskrit": "अनन्दन मया जात द्विषतां हर्षवर्धन ।\nन मया त्वं न पित्रा च जातः क्वाभ्यागतोह्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2040163, "chapter_id": 1888, "verse_number": "५-१३३-६", "content_sanskrit": "निर्मन्युश्चाप्यसङ्ख्येयः पुरुषः क्लीबसाधनः ।\nयावज्जीवं निराशोऽसि कल्याणाय धुरं वह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2040164, "chapter_id": 1888, "verse_number": "५-१३३-७", "content_sanskrit": "माऽऽत्मानमवमन्यस्व मैनमल्पेन बीभरः ।\nमनः कृत्वा सुकल्याणं मा भैस्त्वं प्रतिसंहर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2040165, "chapter_id": 1888, "verse_number": "५-१३३-८", "content_sanskrit": "उत्तिष्ठ हे कापुरुष मा शेष्वैवं पराजितः।\nअमित्रान्नन्दयन्सर्वान्निर्मानो बन्धुशोकदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2040166, "chapter_id": 1888, "verse_number": "५-१३३-९", "content_sanskrit": "सुपूरा वै कुनदिका सुपूरो मुषिकाञ्जलिः ।\nसुसंतोषः कापुरुषः स्वल्पकेनैव तुष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2040167, "chapter_id": 1888, "verse_number": "५-१३३-१०", "content_sanskrit": "अप्यहेरारुजन्दंष्ट्रामाश्वेव निधनं व्रज ।\nअपि वा संशयं प्राप्य जीवितेऽपि पराक्रमेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2040168, "chapter_id": 1888, "verse_number": "५-१३३-११", "content_sanskrit": "अप्यरेः श्येनवच्छिद्रं पश्येस्त्वं विपरिक्रमन् ।\nविवदन्वाऽथवा तूष्णीं व्योम्नीवापरिशङ्कितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2040169, "chapter_id": 1888, "verse_number": "५-१३३-१२", "content_sanskrit": "त्वमेवं प्रेतवच्छेषे कस्माद्वज्रहतो यथा।\nउत्तिष्ठ हे कापुरुष मा स्वाप्सीः शत्रुनिर्जितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2040170, "chapter_id": 1888, "verse_number": "५-१३३-१३", "content_sanskrit": "माऽस्तं गमस्त्वं कृपणो वि श्रूयस्व स्वकर्मणा ।\nमा मध्ये मा जघन्ये त्वं माऽधो भूस्तिष्ठ गर्जितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2040171, "chapter_id": 1888, "verse_number": "५-१३३-१४", "content_sanskrit": "अलातं तिन्दुकस्येव मुहूर्तमपि हि ज्वल ।\nमा तुषाग्निरिवानर्चिर्धूमायस्व जिजीविषुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2040172, "chapter_id": 1888, "verse_number": "५-१३३-१५", "content_sanskrit": "मुहूर्तं ज्वलितं श्रेयो न च धूमायितं चिरम् ।\nमा ह स्म कस्यचिद्गेहे जनी राज्ञः स्वरीमृदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2040173, "chapter_id": 1888, "verse_number": "५-१३३-१६", "content_sanskrit": "कृत्वा मानुष्यकं कर्म सृत्वाऽऽजिं यावदुत्तमम् ।\nधर्मस्यानृण्यमाप्नोति न चात्मानं विगर्हते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2040174, "chapter_id": 1888, "verse_number": "५-१३३-१७", "content_sanskrit": "अलब्ध्वा यदि वा लब्ध्वा नानुशोचति पण्डितः ।\nआनन्तर्यं चारभते न प्राणानां धनायते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2040175, "chapter_id": 1888, "verse_number": "५-१३३-१८", "content_sanskrit": "उद्भावयस्वं वीर्यं वा तां वा गच्छ ध्रुवां गतिम् ।\nधर्मं पुत्राग्रतः कृत्वा किंनिमित्तं हि जीवसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2040176, "chapter_id": 1888, "verse_number": "५-१३३-१९", "content_sanskrit": "इष्टापूर्तं हि ते क्लीब कीर्तिश्च सकला हता ।\nविच्छिन्नं भोगमूलं ते किंनिमित्तं हि जीवसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2040177, "chapter_id": 1888, "verse_number": "५-१३३-२०", "content_sanskrit": "शत्रुर्निमञ्जता ग्राह्यो जङ्घायां प्रपतिष्यता।\nविपरिच्छिन्नमूलोऽपि न विषीदेत्कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2040178, "chapter_id": 1888, "verse_number": "५-१३३-२१", "content_sanskrit": "उद्यम्य धुरमुत्कर्षेदाजानेयकतं स्मरन्।\nकुरु सत्वं च मानं च विद्धि पौरुषमात्मनः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2040179, "chapter_id": 1888, "verse_number": "५-१३३-२२", "content_sanskrit": "उद्भावय कुलं मग्नं त्वत्कृते स्वयमेव हि।\nयस्य वृत्तं न जल्पन्ति मानवा महदद्भुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2040180, "chapter_id": 1888, "verse_number": "५-१३३-२३", "content_sanskrit": "राशिवर्धनमात्रं स नैव स्त्री न पुनः पुमान् ।\nदाने तपसि सत्ये च यस्य नोच्चरितं यशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2040181, "chapter_id": 1888, "verse_number": "५-१३३-२४", "content_sanskrit": "विद्यायामर्थलाभे वा मातुरुच्चार एव सः।\nश्रुतेन तपसा वाऽपि श्रिया वा विक्रमेण वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2040182, "chapter_id": 1888, "verse_number": "५-१३३-२५", "content_sanskrit": "जनान्योऽभिभवत्यन्यान्कर्मणा हि स वै पुमान् ।\nन त्वेव जाल्मीं कापालीं वृत्तिमेषितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2040183, "chapter_id": 1888, "verse_number": "५-१३३-२६", "content_sanskrit": "नृशंस्यामयशस्यां च दुःखां कापुरुषोचिताम्।\nयमेनमभिनन्देयुरमित्राः पुरुषं कृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2040184, "chapter_id": 1888, "verse_number": "५-१३३-२७", "content_sanskrit": "लोकस्य समवज्ञातं निहीनासनवाससम् ।\nअहोलाभकरं हीनमल्पजीवनमल्पकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2040185, "chapter_id": 1888, "verse_number": "५-१३३-२८", "content_sanskrit": "नेदृशं बन्धुमासाद्य बान्धवः सुखमेधते।\nअवृत्त्यैव विपत्स्यामो वयं राष्ट्रात्प्रवासिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2040186, "chapter_id": 1888, "verse_number": "५-१३३-२९", "content_sanskrit": "सर्वकामरसैर्हीनाः स्थानभ्रष्टा अकिंचनाः ।\nअवल्गुकारिण सत्सु कुलवंशस्य नाशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2040187, "chapter_id": 1888, "verse_number": "५-१३३-३०", "content_sanskrit": "कलिं पुत्रप्रवादेन सञ्जय त्वामजीजनम् ।\nनिरमर्षं निरुत्साहं निर्वीर्यमरिनन्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2040188, "chapter_id": 1888, "verse_number": "५-१३३-३१", "content_sanskrit": "मा स्म सीमन्तिनी काचिञ्जनयेत्पुत्रमीदृशम्।\nमा धूमाय ज्वलात्यन्तमाक्रम्य जहि शात्रवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2040189, "chapter_id": 1888, "verse_number": "५-१३३-३२", "content_sanskrit": "ज्वल मूर्धन्यमित्राणां मुहूर्तमपि वा क्षणम्।\nएतावानेव पुरुषो यदमर्षी यदक्षमी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2040190, "chapter_id": 1888, "verse_number": "५-१३३-३३", "content_sanskrit": "क्षमावान्निरमर्षश्च नैव स्त्री न पुनः पुमान् ।\nसंतोषो वै श्रियं हन्ति तथाऽनुक्रोश एव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2040191, "chapter_id": 1888, "verse_number": "५-१३३-३४", "content_sanskrit": "अनुत्थानभये चोभे निरीहो नाश्रुते महत्।\nएभ्यो निकृतिपापेभ्यः प्रमुञ्चात्मानमात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2040192, "chapter_id": 1888, "verse_number": "५-१३३-३५", "content_sanskrit": "आयसं हृदयं कृत्वा मृगयस्व पुनः स्वकम् ।\nपरं विषहते यस्मात्तस्मात्पुरुष उच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2040193, "chapter_id": 1888, "verse_number": "५-१३३-३६", "content_sanskrit": "तमाहुर्व्यर्थनामानं स्त्रीवद्य इह जीवति।\nशूरस्योर्जितसत्वस्य सिंहविक्रान्तचारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2040194, "chapter_id": 1888, "verse_number": "५-१३३-३७", "content_sanskrit": "दिष्टभावं गतस्यापि विषये मोदते प्रजा ।\nय आत्मनः प्रियमुखे हित्वा मृगयते श्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2040195, "chapter_id": 1888, "verse_number": "५-१३३-३८", "content_sanskrit": "अमात्यानामथो हर्षमादधात्यचिरेण सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2040196, "chapter_id": 1888, "verse_number": "५-१३३-३९x", "content_sanskrit": "पुत्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2040197, "chapter_id": 1888, "verse_number": "५-१३३-३९", "content_sanskrit": "किं नु मे मामपश्यन्त्याः पृथिव्या अपि सर्वया।\nकिमाभरणकृत्यं ते किं भोगैर्जीवितेन वा ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2040198, "chapter_id": 1888, "verse_number": "५-१३३-४०x", "content_sanskrit": "मातोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2040199, "chapter_id": 1888, "verse_number": "५-१३३-४०", "content_sanskrit": "`पैरर्विहन्यमानस्य जीवितेनापि किं फलम्।\nनिर्मन्युकानां ये लोका द्विषन्तस्तानवाप्नुयुः ।\nये त्वादृतात्मनां लोकाः सुहृदस्तान्व्रजन्तु नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2040200, "chapter_id": 1888, "verse_number": "५-१३३-४१", "content_sanskrit": "भृत्यैर्विहीयमानानां परपिण्डोपजीविनाम्।\nकृपणानामसत्वानां मा वृत्तिमनुवर्तिथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2040201, "chapter_id": 1888, "verse_number": "५-१३३-४२", "content_sanskrit": "अनु त्वां तात जीवन्तु ब्राह्मणाः सुहृदस्तथा ।\nपर्यन्यमिव भूतानि देवा इव शतक्रतुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2040202, "chapter_id": 1888, "verse_number": "५-१३३-४३", "content_sanskrit": "यमाजीवन्ति पुरुषं सर्वभूतानि संजय।\nपक्वं द्रुममिवासाद्य तस्य जीवितमर्थवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2040203, "chapter_id": 1888, "verse_number": "५-१३३-४४", "content_sanskrit": "यस्य शूरस्य विक्रान्तैरेधन्ते बान्धवाः सुखम्।\nत्रिदशा इव शक्रस्य साधु तस्येह जीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2040204, "chapter_id": 1888, "verse_number": "५-१३३-४५", "content_sanskrit": "स्वबाहुबलमाश्रित्य योहि जीवति मानवः ।\nस लोके लभते कीर्तिं परत्र च शुभां गतिम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2040205, "chapter_id": 1888, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्माभारते उद्योगपर्वणि भगवद्यानपर्वणि त्रयस्त्रिंशदधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]