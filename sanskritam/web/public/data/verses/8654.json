[{"id": 900008605, "chapter_id": 8654, "verse_number": "35.1", "content_sanskrit": "पूर्वत्र सिद्धरूपदेवतातत्क्रम..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900008606, "chapter_id": 8654, "verse_number": "35.2", "content_sanskrit": "सिद्धान्तस्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900008607, "chapter_id": 8654, "verse_number": "35.3", "content_sanskrit": "अत्र च श्रुतावेतमित्यनेन ‘‘प्राणस्तथे’’ त्यत्र ब्रह्मत्वेन..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900008608, "chapter_id": 8654, "verse_number": "35.4", "content_sanskrit": "न च सकृत्प्रयुक्तस्यानेकार्थत्वमन्याय्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900008609, "chapter_id": 8654, "verse_number": "35.5", "content_sanskrit": "अन्यत्रादृष्टत्वेपि प्रकृत ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900008610, "chapter_id": 8654, "verse_number": "35.6", "content_sanskrit": "अत्र चाद्ये सूत्रे स्वपक्षसाधकोक्तिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900008611, "chapter_id": 8654, "verse_number": "35.7", "content_sanskrit": "अन्येतु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}]