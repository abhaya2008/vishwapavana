[{"id": 7002447000, "chapter_id": 22447, "verse_number": "१-१०९-१", "content_sanskrit": "ब्रह्मोवाच ।\nमार्तण्डसप्तमीं कृष्ण यथान्यां१ वच्चि तेऽनघ ।\nशृणुष्वैकमना वीर गदतो मे शुभप्रदाम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002447001, "chapter_id": 22447, "verse_number": "१-१०९-२", "content_sanskrit": "यस्याः सम्यगनुष्ठानात्प्राप्नोत्यभिमतं फलम् ।\nपौषे मासे सिते पक्षे सप्तम्यां समुपोषितः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002447002, "chapter_id": 22447, "verse_number": "१-१०९-३", "content_sanskrit": "सम्यक्सम्पूज्य मार्तण्डं मार्तण्ड इति वै जपेत् ।\nपूजयेत्कुतपं भक्त्या श्रद्धया परयान्वितः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002447003, "chapter_id": 22447, "verse_number": "१-१०९-४", "content_sanskrit": "धूपपुष्पोपहराद्यैरुपवासैः समाहितः ।\nमार्तण्डेति जपन्नाम पुनस्तद्गतमानसः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002447004, "chapter_id": 22447, "verse_number": "१-१०९-५", "content_sanskrit": "विप्राय दक्षिणां दद्याद्यथाशक्त्या खगध्वज ।\nस्वपन्विबोधन्स्खलितो मार्तण्डेति च कीर्तयेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002447005, "chapter_id": 22447, "verse_number": "१-१०९-६", "content_sanskrit": "पाषण्डादिविकर्मस्थैरालापं च विवर्जयेत् ।\nगोमूत्रं गोपयो वापि दधि क्षीरमथापि वा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002447006, "chapter_id": 22447, "verse_number": "१-१०९-७", "content_sanskrit": "गोदेहतः समुद्भूतं प्राश्नीयादात्मशुद्धये ।\nद्वितीयेऽह्नि पुनः स्नातस्तथैवाभ्यर्चनं रवेः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002447007, "chapter_id": 22447, "verse_number": "१-१०९-८", "content_sanskrit": "तेनैव नाम्ना सम्भूय दत्त्वा विप्राय दक्षिणाम् ।\nततो भुञ्जीत गोदोहसम्भूतेन समन्वितम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002447008, "chapter_id": 22447, "verse_number": "१-१०९-९", "content_sanskrit": "एवमेवाखिलान्मासानुपोष्य प्रयतः शुचिः ।\nदद्याद्गवादिकं विप्रान्प्रतिमासं स्वशक्तितः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002447009, "chapter_id": 22447, "verse_number": "१-१०९-१०", "content_sanskrit": "धारिता चेत्पुनर्वर्षे यथाशक्त्या गवादिकम् ।\nदत्त्वा परं रवेर्भूयः शृणु यत्फलमश्नुते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002447010, "chapter_id": 22447, "verse_number": "१-१०९-११", "content_sanskrit": "स्वर्णशृंगीं च पञ्चम्यां षष्ठ्यां च वृषभं नरः ।\nप्रतिमासं द्विजातिभ्यो यद्दत्त्वा फलमश्नुते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002447011, "chapter_id": 22447, "verse_number": "१-१०९-१२", "content_sanskrit": "तत्प्राप्नोत्यखिलं सम्यग्व्रतमेतदुपोषितः ।\nतं च लोकमवाप्नोति मार्तण्डो यत्र तिष्ठति ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002447012, "chapter_id": 22447, "verse_number": "१-१०९-१३", "content_sanskrit": "शाण्डेलेयसमः कृष्ण तेजसा नात्र संशयः ।\nमार्तण्डसप्तमीमेतामुपोष्यैते गणा दिवि ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002447013, "chapter_id": 22447, "verse_number": "१-१०९-१४", "content_sanskrit": "विद्योतमाना दृश्यन्ते लोकैरद्यापि भूधर ।\nतस्मात्त्वमादिदेवेशं ग्रहेशं भास्करं रविम् ।\nअनयार्चय गोविन्द गोपतिं गोलसन्निभम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]