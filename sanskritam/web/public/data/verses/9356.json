[{"id": 5000356000, "chapter_id": 9356, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे सप्तदशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000356001, "chapter_id": 9356, "verse_number": "५-१७-१", "content_sanskrit": "ततः कुमुदखण्डाभो निर्मलं निर्मलोदयः।\nप्रजगाम नभश्चन्द्रो हंसो नीलमिवोदकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000356002, "chapter_id": 9356, "verse_number": "५-१७-२", "content_sanskrit": "साचिव्यमिव कुर्वन् स प्रभया निर्मलप्रभः।\nचन्द्रमा रश्मिभिः शीतैः सिषेवे पवनात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000356003, "chapter_id": 9356, "verse_number": "५-१७-३", "content_sanskrit": "स ददर्श ततः सीतां पूर्णचन्द्रनिभाननाम्।\nशोकभारैरिव न्यस्तां भारैर्नावमिवाम्भसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000356004, "chapter_id": 9356, "verse_number": "५-१७-४", "content_sanskrit": "दिदृक्षमाणो वैदेहीं हनूमान् मारुतात्मजः।\nस ददर्शाविदूरस्था राक्षसीर्घोरदर्शनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000356005, "chapter_id": 9356, "verse_number": "५-१७-५", "content_sanskrit": "एकाक्षीमेककर्णां च कर्णप्रावरणां तथा।\nअकर्णां शङ्कुकर्णां च मस्तकोच्छ्वासनासिकाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000356006, "chapter_id": 9356, "verse_number": "५-१७-६", "content_sanskrit": "अतिकायोत्तमांगीं च तनुदीर्घशिरोधराम्।\nध्वस्तकेशीं तथाकेशीं केशकम्बलधारिणीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000356007, "chapter_id": 9356, "verse_number": "५-१७-७", "content_sanskrit": "लम्बकर्णललाटां च लम्बोदरपयोधराम्।\nलम्बोष्ठीं चिबुकोष्ठीं च लम्बास्यां लम्बजानुकाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000356008, "chapter_id": 9356, "verse_number": "५-१७-८", "content_sanskrit": "ह्रस्वां दीर्घां च कुब्जां च विकटां वामनां तथा।\nकरालां भुग्नवक्त्रां च पिंगाक्षीं विकृताननाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000356009, "chapter_id": 9356, "verse_number": "५-१७-९", "content_sanskrit": "विकृताः पिंगलाः कालीः क्रोधनाः कलहप्रियाः।\nकालायसमहाशूलकूटमुद‍्गरधारिणीः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000356010, "chapter_id": 9356, "verse_number": "५-१७-१०", "content_sanskrit": "वराहमृगशार्दूलमहिषाजशिवामुखाः।\nगजोष्ट्रहयपादाश्च निखातशिरसोऽपराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000356011, "chapter_id": 9356, "verse_number": "५-१७-११", "content_sanskrit": "एकहस्तैकपादाश्च खरकर्ण्यश्वकर्णिकाः।\nगोकर्णीर्हस्तिकर्णीश्च हरिकर्णीस्तथापराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000356012, "chapter_id": 9356, "verse_number": "५-१७-१२", "content_sanskrit": "अतिनासाश्च काश्चिच्च तिर्यङ्नासा अनासिकाः।\nगजसंनिभनासाश्च ललाटोच्छ्वासनासिकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000356013, "chapter_id": 9356, "verse_number": "५-१७-१३", "content_sanskrit": "हस्तिपादा महापादा गोपादाः पादचूलिकाः।\nअतिमात्रशिरोग्रीवा अतिमात्रकुचोदरीः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000356014, "chapter_id": 9356, "verse_number": "५-१७-१४", "content_sanskrit": "अतिमात्रास्यनेत्राश्च दीर्घजिह्वाननास्तथा।\nअजामुखीर्हस्तिमुखीर्गोमुखीः सूकरीमुखीः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000356015, "chapter_id": 9356, "verse_number": "५-१७-१५", "content_sanskrit": "हयोष्ट्रखरवक्त्राश्च राक्षसीर्घोरदर्शनाः।\nशूलमुद‍्गरहस्ताश्च क्रोधनाः कलहप्रियाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000356016, "chapter_id": 9356, "verse_number": "५-१७-१६", "content_sanskrit": "कराला धूम्रकेशिन्यो राक्षसीर्विकृताननाः।\nपिबन्ति सततं पानं सुरामांससदाप्रियाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000356017, "chapter_id": 9356, "verse_number": "५-१७-१७", "content_sanskrit": "मांसशोणितदिग्धांगीर्मांसशोणितभोजनाः।\nता ददर्श कपिश्रेष्ठो रोमहर्षणदर्शनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000356018, "chapter_id": 9356, "verse_number": "५-१७-१८", "content_sanskrit": "स्कन्धवन्तमुपासीनाः परिवार्य वनस्पतिम्।\nतस्याधस्ताच्च तां देवीं राजपुत्रीमनिन्दिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000356019, "chapter_id": 9356, "verse_number": "५-१७-१९", "content_sanskrit": "लक्षयामास लक्ष्मीवान् हनूमाञ्जनकात्मजाम्।\nनिष्प्रभां शोकसंतप्तां मलसंकुलमूर्धजाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000356020, "chapter_id": 9356, "verse_number": "५-१७-२०", "content_sanskrit": "क्षीणपुण्यां च्युतां भूमौ तारां निपतितामिव।\nचारित्रव्यपदेशाढ्यां भर्तृदर्शनदुर्गताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000356021, "chapter_id": 9356, "verse_number": "५-१७-२१", "content_sanskrit": "भूषणैरुत्तमैर्हीनां भर्तृवात्सल्यभूषिताम्।\nराक्षसाधिपसंरुद्धां बन्धुभिश्च विनाकृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000356022, "chapter_id": 9356, "verse_number": "५-१७-२२", "content_sanskrit": "वियूथां सिंहसंरुद्धां बद्धां गजवधूमिव।\nचन्द्ररेखां पयोदान्ते शारदाभ्रैरिवावृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000356023, "chapter_id": 9356, "verse_number": "५-१७-२३", "content_sanskrit": "क्लिष्टरूपामसंस्पर्शादयुक्तामिव वल्लकीम्।\nस तां भर्तृहिते युक्तामयुक्तां रक्षसां वशे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000356024, "chapter_id": 9356, "verse_number": "५-१७-२४", "content_sanskrit": "अशोकवनिकामध्ये शोकसागरमाप्लुताम्।\nताभिः परिवृतां तत्र सग्रहामिव रोहिणीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000356025, "chapter_id": 9356, "verse_number": "५-१७-२५", "content_sanskrit": "ददर्श हनुमांस्तत्र लतामकुसुमामिव।\nसा मलेन च दिग्धांगी वपुषा चाप्यलंकृता।\nमृणाली पङ्कदिग्धेव विभाति च न भाति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000356026, "chapter_id": 9356, "verse_number": "५-१७-२६", "content_sanskrit": "मलिनेन तु वस्त्रेण परिक्लिष्टेन भामिनीम्।\nसंवृतां मृगशावाक्षीं ददर्श हनुमान् कपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000356027, "chapter_id": 9356, "verse_number": "५-१७-२७", "content_sanskrit": "तां देवीं दीनवदनामदीनां भर्तृतेजसा।\nरक्षितां स्वेन शीलेन सीतामसितलोचनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000356028, "chapter_id": 9356, "verse_number": "५-१७-२८", "content_sanskrit": "तां दृष्ट्वा हनुमान् सीतां मृगशावनिभेक्षणाम्।\nमृगकन्यामिव त्रस्तां वीक्षमाणां समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000356029, "chapter_id": 9356, "verse_number": "५-१७-२९", "content_sanskrit": "दहन्तीमिव निःश्वासैर्वृक्षान् पल्लवधारिणः।\nसंघातमिव शोकानां दुःखस्योर्मिमिवोत्थिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000356030, "chapter_id": 9356, "verse_number": "५-१७-३०", "content_sanskrit": "तां क्षमां सुविभक्तांगीं विनाभरणशोभिनीम्।\nप्रहर्षमतुलं लेभे मारुतिः प्रेक्ष्य मैथिलीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000356031, "chapter_id": 9356, "verse_number": "५-१७-३१", "content_sanskrit": "हर्षजानि च सोऽश्रूणि तां दृष्ट्वा मदिरेक्षणाम्।\nमुमोच हनुमांस्तत्र नमश्चक्रे च राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000356032, "chapter_id": 9356, "verse_number": "५-१७-३२", "content_sanskrit": "नमस्कृत्वाथ रामाय लक्ष्मणाय च वीर्यवान्।\nसीतादर्शनसंहृष्टो हनुमान् संवृतोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000356033, "chapter_id": 9356, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे सप्तदशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]