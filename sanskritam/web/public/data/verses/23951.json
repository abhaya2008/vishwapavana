[{"id": 7003951000, "chapter_id": 23951, "verse_number": "३-१-१४-१", "content_sanskrit": "श्रीसूत उवाच ।\nस्नात्वा त्वमृत वाप्यां वै सेवित्वैकांतराघवम् ।\nजितेंद्रियो नरः स्नातुं ब्रह्मकुंडं ततो व्रजेत्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003951001, "chapter_id": 23951, "verse_number": "३-१-१४-२", "content_sanskrit": "सेतुमध्ये महातीर्थं गंधमादनपर्वते ।\nब्रह्मकुडमिति ख्यातं सर्व दारिद्र्यभेषजम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003951002, "chapter_id": 23951, "verse_number": "३-१-१४-३", "content_sanskrit": "विद्यते ब्रह्महत्यानामयुतायुतनाशनम् ।\nदर्शनं ब्रह्मकुंडस्य सर्वपापौघनाशनम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003951003, "chapter_id": 23951, "verse_number": "३-१-१४-४", "content_sanskrit": "किं तस्य बहुभिस्तीर्थैः किं तपोभिः किमध्वरैः ।\nमहादानैश्च किं तस्य ब्रह्मकुंडविलोकिनः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003951004, "chapter_id": 23951, "verse_number": "३-१-१४-५", "content_sanskrit": "ब्रह्मकुंडे सकृत्स्नानं वैकुंठप्राप्तिकारणम् ।\nब्रह्मकुंडसमुद्भूतं भस्म येन धृतं द्विजाः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003951005, "chapter_id": 23951, "verse_number": "३-१-१४-६", "content_sanskrit": "तस्यानुगास्त्रयो देवा ब्रह्मविष्णुमहेश्वराः ।\nब्रह्मकुंडसमुद्भूतभस्मना यस्त्रिपुंड्रकम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003951006, "chapter_id": 23951, "verse_number": "३-१-१४-७", "content_sanskrit": "करोति तस्य कैवल्यं करस्थं नात्र संशयः ।\nतद्भस्मपरमाणुर्वा यो ललाटे धृतो भवेत्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003951007, "chapter_id": 23951, "verse_number": "३-१-१४-८", "content_sanskrit": "तावदेवास्य मुक्तिः स्यान्नात्र कार्या विचारणा ।\nतत्कुंडभस्मना मर्त्यः कुर्यादुद्धूलनं तु यः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003951008, "chapter_id": 23951, "verse_number": "३-१-१४-९", "content_sanskrit": "तस्य पुण्यफलं वक्तुं शंकरो वेत्ति वा न वा ।\nब्रह्मकुंडसमुद्भूतं भस्म यो नैव धारयेत्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003951009, "chapter_id": 23951, "verse_number": "३-१-१४-१०", "content_sanskrit": "रौरवे नरके सोऽयं पतेदाचंद्रतारकम् ।\nउद्धूलनं त्रिपुंड्रं वा ब्रह्मकुंडस्थभस्मना॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003951010, "chapter_id": 23951, "verse_number": "३-१-१४-११", "content_sanskrit": "नराधमो न कुर्याद्यः सुखं नास्य कदाचन ।\nब्रह्मकुंडसमुद्भूतभस्मनिंदारतस्तु यः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003951011, "chapter_id": 23951, "verse_number": "३-१-१४-१२", "content_sanskrit": "उत्पत्तौ तस्य सांकर्यमनुमेयं विपश्चिता ।\nब्रह्मकुंडसमुद्भूतं भस्मैतल्लोकपावनम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003951012, "chapter_id": 23951, "verse_number": "३-१-१४-१३", "content_sanskrit": "अन्यभस्मसमं यस्तु न्यूनं वा वक्ति मानवः ।\nउत्पत्तौ तस्य सांकर्य मनुमेयं विपश्चिता॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003951013, "chapter_id": 23951, "verse_number": "३-१-१४-१४", "content_sanskrit": "ब्रह्मकुंडसमुद्भूतेऽप्यस्मिन्भस्मनि जाग्रति ।\nभस्मांतरेण मनुजो धारयेद्यस्त्रिपुंड्रकम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003951014, "chapter_id": 23951, "verse_number": "३-१-१४-१५", "content_sanskrit": "उत्पत्तौ तस्य सांक र्यमनुमेयं विपश्चिता ।\nकदाचिदपि यो मर्त्यो भस्मैतत्तु न धारयेत्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003951015, "chapter_id": 23951, "verse_number": "३-१-१४-१६", "content_sanskrit": "उत्पत्तौ तस्य सांकर्यमनुमेयं विपश्चिता ।\nब्रह्मकुंडसमुद्भूतं भस्म दद्याद्द्विजाय यः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003951016, "chapter_id": 23951, "verse_number": "३-१-१४-१७", "content_sanskrit": "चतुरर्णवपर्यंता तेन दत्ता वसुन्धरा ।\nसंदेहो नात्र कर्तव्यस्त्रिर्वा शपथयाम्यहम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003951017, "chapter_id": 23951, "verse_number": "३-१-१४-१८", "content_sanskrit": "सत्यंसत्यं पुनः सत्यमुद्धृत्य भुजमुच्यते ।\nब्रह्मकुंडोद्भवं भस्म धारयध्वं द्विजोत्तमाः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003951018, "chapter_id": 23951, "verse_number": "३-१-१४-१९", "content_sanskrit": "एतद्धि पावनं भस्म ब्रह्मयज्ञसमुद्भवम् ।\nपुरा हि भगवान्ब्रह्मा सर्वलोकपितामहः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003951019, "chapter_id": 23951, "verse_number": "३-१-१४-२०", "content_sanskrit": "सन्निधौ सर्वदेवानां पर्वते गंधमादने ।\nईशशापनिवृत्त्यर्थं क्रतून्सर्वान्समातनोत्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003951020, "chapter_id": 23951, "verse_number": "३-१-१४-२१", "content_sanskrit": "विधाय विधिवत्सर्वानध्वरान्बहुदक्षिणान् ।\nमुमुचे सहसा ब्रह्मा शंभुशापाद्द्विजोत्तमाः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003951021, "chapter_id": 23951, "verse_number": "३-१-१४-२२", "content_sanskrit": "तदेतत्तीर्थमासाद्य स्नानं कुर्वंति ये नराः ।\nते महादेवसायुज्यं प्राप्नुवंति न संशयः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003951022, "chapter_id": 23951, "verse_number": "३-१-१४-२३", "content_sanskrit": "ऋषय ऊचुः ।\nव्यासशिष्य महाप्राज्ञ पुराणार्थविशारद ।\nचतुर्दशानां लोकानां स्रष्टारं चतुराननम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003951023, "chapter_id": 23951, "verse_number": "३-१-१४-२४", "content_sanskrit": "शंभुः केनापराधेन शप्तवान्भारतीपतिम् ।\nशापश्च कीदृशस्तस्य पुरा दत्तो हरेण वै ।\nएतत्सर्वं मुने ब्रूहि तत्त्वतोऽस्माकमादरात्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003951024, "chapter_id": 23951, "verse_number": "३-१-१४-२५", "content_sanskrit": "श्रीसूत उवाच ।\nपुरा बभूव कलहो ब्रह्मविष्ण्वोः परस्परम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003951025, "chapter_id": 23951, "verse_number": "३-१-१४-२६", "content_sanskrit": "कंचिद्धेतुं समुद्दिश्य स्पर्धया श्लाघमानयोः ।\nअहं कर्त्ता न मत्तोऽन्यः कर्त्तास्ति जगतीतले॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003951026, "chapter_id": 23951, "verse_number": "३-१-१४-२७", "content_sanskrit": "एवमाह हरिं ब्रह्मा ब्रह्माणं च हरिस्तथा ।\nएवं विवादः सुमहान्प्रावर्त्तत पुरा तयोः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003951027, "chapter_id": 23951, "verse_number": "३-१-१४-२८", "content_sanskrit": "एतस्मिन्नंतरे विप्राः कुर्वतोः कलहं मिथः ।\nतयोर्गर्वविनाशाय प्रबोधार्थं च देवयोः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003951028, "chapter_id": 23951, "verse_number": "३-१-१४-२९", "content_sanskrit": "मध्ये प्रादुरभूल्लिंगं स्वयंज्योतिरनामयम् ।\nतौ दृष्ट्वा विस्मितौ लिंगं ब्रह्मविष्णु परस्परम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003951029, "chapter_id": 23951, "verse_number": "३-१-१४-३०", "content_sanskrit": "समयं चक्रतुर्विप्रा देवानां सन्निधौ पुरा ।\nअनाद्यंतं महालिंगं यदेतद्दृश्यते पुरः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003951030, "chapter_id": 23951, "verse_number": "३-१-१४-३१", "content_sanskrit": "अनंतादित्यसंका शमनंताग्निसमप्रभम् ।\nआवयोरस्य लिंगस्य योंऽतमादिं च द्रक्ष्यति॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003951031, "chapter_id": 23951, "verse_number": "३-१-१४-३२", "content_sanskrit": "स भवेदधिको लोके लोककर्ता च स प्रभुः ।\nअहमूर्ध्वं गमिष्यामि लिंगस्यातं गवेषयन्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003951032, "chapter_id": 23951, "verse_number": "३-१-१४-३३", "content_sanskrit": "गवेषणाय मूलस्य त्वमधस्ताद्धरे व्रज ।\nइति तस्य वचः श्रुत्वा तथे त्याह रमापतिः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003951033, "chapter_id": 23951, "verse_number": "३-१-१४-३४", "content_sanskrit": "एवं तौ समयं कृत्वा मार्गणाय विनिर्गतौ ।\nविष्णुर्वराहरूपेण गतोऽधस्ताद्गवेषितुम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003951034, "chapter_id": 23951, "verse_number": "३-१-१४-३५", "content_sanskrit": "हंसतां भारतीजानिः स्वीकृत्योपरि निर्ययौ ।\nअधो लोकान्विचित्याथो विष्णुर्वर्षगणान्बहून् ।\nयथास्थानं समागत्य वभाषे देवसन्निधौ॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003951035, "chapter_id": 23951, "verse_number": "३-१-१४-३६", "content_sanskrit": "विष्णुरुवाच ।\nअहं लिंगस्य नाद्राक्षमादिमस्येति सत्यवाक्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003951036, "chapter_id": 23951, "verse_number": "३-१-१४-३७", "content_sanskrit": "ऊर्ध्वं गवेषयित्वाथ ब्रह्माप्यागच्छदत्र सः ।\nआगत्य च वचः प्राह छद्मना चतुराननः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003951037, "chapter_id": 23951, "verse_number": "३-१-१४-३८", "content_sanskrit": "ब्रह्मोवाच ।\nअहमद्राक्षमस्यांतं लिंगस्येति मृषा पुनः ।\nतयोस्तद्वचनं श्रुत्वा व्रह्मविष्ण्वोर्महेश्वरः ।\nमिथ्यावादिनमाहेदं प्रहस्य चतुराननम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003951038, "chapter_id": 23951, "verse_number": "३-१-१४-३९", "content_sanskrit": "ईश्वर उवाच ।\nअसत्यं यदवोचस्त्वं चतुरानन मत्पुरः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003951039, "chapter_id": 23951, "verse_number": "३-१-१४-४०", "content_sanskrit": "तस्मात्पूजा न ते भूयाल्लोके सर्वत्र सर्वदा ।\nअथ विष्णुं पुनः प्राह भगवान्परमेश्वरः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003951040, "chapter_id": 23951, "verse_number": "३-१-१४-४१", "content_sanskrit": "यस्मात्सत्यमवोचस्त्वं कमलायाः पते हरे ।\nतस्मात्ते मत्समा पूजा भविष्यति न संशयः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003951041, "chapter_id": 23951, "verse_number": "३-१-१४-४२", "content_sanskrit": "ततो ब्रह्मा विषण्णः सञ्छंकरं प्रत्यभाषत ।\nस्वामिन्ममापराधं त्वं क्षमस्व करुणानिधे॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003951042, "chapter_id": 23951, "verse_number": "३-१-१४-४३", "content_sanskrit": "एकोपराधः क्षंतव्यः स्वामि भिर्जगदीश्वरैः ।\nततो महेश्वरोऽवादीद्ब्रह्माणं परिसांत्वयन्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003951043, "chapter_id": 23951, "verse_number": "३-१-१४-४४", "content_sanskrit": "ईश्वर उवाच ।\nन मिथ्यावचनं मे स्याद्ब्रह्मन्वक्ष्यामि ते शृणु ।\nगच्छ त्वं सहसा वत्स गन्धमादनपर्वतम्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003951044, "chapter_id": 23951, "verse_number": "३-१-१४-४५", "content_sanskrit": "तत्र क्रतून्कुरुष्व त्वं मिथ्यादोषप्रशांतये ।\nततो विधूतपापस्त्वं भविष्यसि न संशयः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003951045, "chapter_id": 23951, "verse_number": "३-१-१४-४६", "content_sanskrit": "तेन श्रौतेषु ते ब्रह्मन्स्मार्तेष्वपि च कर्मसु ।\nपूजा भविष्यति सदा न पूजा प्रतिमासु ते॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003951046, "chapter_id": 23951, "verse_number": "३-१-१४-४७", "content_sanskrit": "इत्युक्त्वा भगवानीशस्तत्रैवांतरधीयत ।\nततो ब्रह्मा ययौ विप्रा गंधमादनपर्वतम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003951047, "chapter_id": 23951, "verse_number": "३-१-१४-४८", "content_sanskrit": "ईजे च क्रतुकर्तारं क्रतुभिः पार्वतीपतिम् ।\nअष्टाशीतिसहस्राणि वर्षाणि मुनिपुंगवाः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003951048, "chapter_id": 23951, "verse_number": "३-१-१४-४९", "content_sanskrit": "पौंडरीकादिभिः सर्वैरध्वरैर्भूरिदक्षिणैः ।\nइन्द्रादिसर्वदेवानां सन्निधावयजच्छिवम् ।\nतेन तुष्टोभवच्छंभुर्वरमस्मै प्रदत्तवान्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003951049, "chapter_id": 23951, "verse_number": "३-१-१४-५०", "content_sanskrit": "ईश्वर उवाच ।\nमिथ्योक्तिदोषस्ते नष्टः कृतैरेतैर्मखैरिह॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003951050, "chapter_id": 23951, "verse_number": "३-१-१४-५१", "content_sanskrit": "चतुरानन ते पूजा श्रौतस्मार्तेषु कर्मसु ।\nभविष्यत्यमला ब्रह्मन्न पूजा प्रतिमासु ते॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003951051, "chapter_id": 23951, "verse_number": "३-१-१४-५२", "content_sanskrit": "यागस्थलमिदं तेऽद्य ब्रह्मकुण्डमिति प्रथाम् ।\nगमिष्यति त्रिलोकेस्मिन्पुण्यं पापविनाशनम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003951052, "chapter_id": 23951, "verse_number": "३-१-१४-५३", "content_sanskrit": "ब्रह्मकुण्डाभिधे तीर्थे सकृद्यः स्नानमा चरेत् ।\nमुक्तिद्वारार्गलं तस्य भिद्यते तत्क्षणाद्विधे॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003951053, "chapter_id": 23951, "verse_number": "३-१-१४-५४", "content_sanskrit": "ब्रह्मकुण्डसमुद्भूतं ललाटे भस्म धारयन् ।\nमायाकपाटं निर्भिद्य मुक्तिद्वारं प्रया स्यति॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003951054, "chapter_id": 23951, "verse_number": "३-१-१४-५५", "content_sanskrit": "ब्रह्मकुण्डोत्थितं भस्म ललाटे यो न धारयेत् ।\nस्वपितुर्बीजसंभूतो न मातरि सुतस्तु सः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003951055, "chapter_id": 23951, "verse_number": "३-१-१४-५६", "content_sanskrit": "ब्रह्मकुण्डसमुद्भूतभस्मधारणतो विधे ।\nब्रह्महत्यायुतं नश्येत्सुरापानायुतं तथा॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003951056, "chapter_id": 23951, "verse_number": "३-१-१४-५७", "content_sanskrit": "गुरुतल्पायुतं नश्येत्स्वर्णस्तेयायुतं तथा ।\nतत्संसर्गायुतं नश्येत्सत्यमुक्तं मया विधे॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003951057, "chapter_id": 23951, "verse_number": "३-१-१४-५८", "content_sanskrit": "ब्रह्मकुण्डसमुद्भूतभस्मधारणवैभवात् ।\nभूतप्रेतपिशाचाद्या नश्यंति क्षणमात्रतः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003951058, "chapter_id": 23951, "verse_number": "३-१-१४-५९", "content_sanskrit": "इत्युक्त्वा भगवानीशस्तत्रैवांतरधीयत ।\nयज्ञेष्वथ समाप्तेषु मुनयश्च जितेंद्रियाः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003951059, "chapter_id": 23951, "verse_number": "३-१-१४-६०", "content_sanskrit": "इन्द्रादिदेवताश्चैव सिद्धचारणकिन्नराः ।\nअन्ये च देवनिवहा गंधमादनपर्वते॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003951060, "chapter_id": 23951, "verse_number": "३-१-१४-६१", "content_sanskrit": "तां यज्ञभूमिमाश्रित्य स्वयं रुद्रेण सेविताम् ।\nनिरंतरमवर्तंत विदित्वा तस्य वैभवम्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003951061, "chapter_id": 23951, "verse_number": "३-१-१४-६२", "content_sanskrit": "यथाविधि ततो यज्ञान्समाप्य बहुदक्षिणान् ।\nसत्यलोकमगाद्ब्रह्मा शिवाल्लब्धमनोरथः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003951062, "chapter_id": 23951, "verse_number": "३-१-१४-६३", "content_sanskrit": "तदाप्रभृति देवाश्च मुनयश्च द्विजोत्तमाः ।\nब्रह्मकुण्डं समासाद्य चक्रुर्यागान्विधानतः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003951063, "chapter_id": 23951, "verse_number": "३-१-१४-६४", "content_sanskrit": "तस्मादियक्षवो मर्त्याः कुर्युर्यज्ञानिहैव हि॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003951064, "chapter_id": 23951, "verse_number": "३-१-१४-६५", "content_sanskrit": "मनुजदेवमुनीश्वरवंदितं सकलसंसृतिनाशकरं द्विजाः ।\nजलजसंभवकुण्डमिदं शुभं सकल पापहरं सकलार्थदम्॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]