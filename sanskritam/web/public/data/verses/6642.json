    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20006764,
    "chapter_id": 6642,
    "verse_number": "12.29",
    "content_sanskrit": "तैर्वजयन्तीवनराजिराजिभिर्गिरिप्रतिच्छन्दमहामतङ्गजैः । बह्व्यः प्रसर्पज्जनतानानदीशतैर्भुवो बलैरन्तरायामबभूविरे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
