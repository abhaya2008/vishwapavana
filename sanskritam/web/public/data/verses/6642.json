    "avatarnika": ""
  },
  {
    "id": 20006765,
    "chapter_id": 6642,
    "verse_number": "12.30",
    "content_sanskrit": "तस्थेमुहूर्त हरिणीविलोचनैः सदृशि दृष्ट्वा नयनानि योषिताम् । त्वाथ सत्रासमनेकविभ्रमक्रियाविकाराणि मृगैः पलाय्यत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20006766,
    "chapter_id": 6642,
    "verse_number": "12.31",
    "content_sanskrit": "निम्नानि दुःखादवतार्य सादिभिः सयत्नमाकृष्टकशाः शनैः शनैः । उत्तेरुरुत्तालखुरारवं द्रुताः श्लथीकृतप्रग्रहमर्वतां व्रजाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20006767,
    "chapter_id": 6642,
    "verse_number": "12.32",
    "content_sanskrit": "अध्यध्वमारूढवतैव केनचित्प्रतीक्षमाणेन जनं मुहुर्धृतः । दाक्ष्यं हि सद्यः फलदं यदग्रतश्चखाद दासेरयुवा वनावलीः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
