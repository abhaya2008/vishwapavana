    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71,
    "avatarnika": ""
  },
  {
    "id": 20006807,
    "chapter_id": 6642,
    "verse_number": "12.72",
    "content_sanskrit": "तत्पूर्वमंसद्वयसं द्विपाधिपाः क्षणं सहेलाः परितो जगाहिरे । सद्यस्ततस्तेरुरनारतस्रुतस्वदानवारिप्रचुरीकृतं पयः ॥",
