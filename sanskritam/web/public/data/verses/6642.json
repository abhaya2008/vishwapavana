    "avatarnika": ""
  },
  {
    "id": 20006804,
    "chapter_id": 6642,
    "verse_number": "12.69",
    "content_sanskrit": "व्यक्तं बलीयान्यदि हेतुरागमादपूरयत्सा जलधिं न जाह्नवी । गङ्गौघनिर्भस्मितशम्भुकन्धरासवर्णमर्णः कथमन्यथास्य तत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "avatarnika": ""
  },
  {
    "id": 20006805,
    "chapter_id": 6642,
    "verse_number": "12.70",
    "content_sanskrit": "अभ्युद्यतस्य क्रमितुं जवेन गां तमालनीला गिरां धृतायतिः । सीमेव सा तस्य पुरः क्षणं बभौ बलाम्बुराशेर्महतो महापगा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
