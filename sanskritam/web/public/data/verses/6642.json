[
  {
    "id": 20006736,
    "chapter_id": 6642,
    "verse_number": "12.1",
    "content_sanskrit": "इत्थं रथाश्वेभनिषादिनां प्रगे गणो नृपाणामथ तोरणाद्बहिः । प्रस्थानकालक्षमवेषकल्पनाकृतक्षणक्षेपमुदैक्षताच्युतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20006737,
    "chapter_id": 6642,
    "verse_number": "12.2",
    "content_sanskrit": "स्वक्षं सुपत्रं कनकोज्वलद्युतिं जवेन नागाञ्जितवन्तमुच्चकैः । आरुह्य तार्क्ष्य नभसीव भूतले ययावनुद्घातमुखेन सोऽध्वना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20006738,
    "chapter_id": 6642,
    "verse_number": "12.3",
    "content_sanskrit": "हस्तस्थिताखण्डितचक्रशालिनं द्वजेन्द्रकान्तं श्रितवक्षसं श्रिया । सत्यानुरक्तं नरकस्य जिष्णवो गुणैर्नृपाः शाङ्गिणमन्ययासिषुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20006739,
    "chapter_id": 6642,
    "verse_number": "12.4",
    "content_sanskrit": "शुक्लैः सतारैर्मुकुलीकृतैः स्थूलैः कुमुद्वतीनां कुमुदाकरैरिव । व्युष्टं प्रयाणं च वियोगवेदनाविदूननारीकमभूत्समं तदा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20006740,
    "chapter_id": 6642,
    "verse_number": "12.5",
    "content_sanskrit": "उत्क्षिप्तगात्रः स्म विडम्बयन्नभः समुत्पतिष्यन्तमगेन्द्रमुच्चकैः । आकुञ्चितप्रोहनिरूपितक्रमं करेणुरारोहयते निषादिनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20006741,
    "chapter_id": 6642,
    "verse_number": "12.6",
    "content_sanskrit": "स्वैरं कृतास्फालनललितान्पुरः स्फुरत्नून्दर्शितलाघवक्रियाः । वङ्गावलग्नैकसवल्गपाणयस्तुरङ्गमानारुरुहुस्तुरङ्गिणः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20006742,
    "chapter_id": 6642,
    "verse_number": "12.7",
    "content_sanskrit": "अह्नाय यावन्न चकार भूयसे निषेदिवानासनबन्धमध्वने । तीव्रोत्थितास्तावदसह्यरंहसो विशृङ्खलं शृङ्खलकाः प्रतस्थिरे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20006743,
    "chapter_id": 6642,
    "verse_number": "12.8",
    "content_sanskrit": "गण्डोज्वलामुज्ज्वनाभिचक्रया विराजमानां नवयोदरश्रिया । कश्चित्सुखं प्राप्तुमनाः सुसारथी रथीं युयोजाधिधुरां वधूमिव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20006744,
    "chapter_id": 6642,
    "verse_number": "12.9",
    "content_sanskrit": "उत्थातुमिच्छन्विधृतः पुरो बलान्निधीयमाने भरभाजि यन्त्रके । अर्धोज्झितोद्गारविझर्झरस्वरः स्वनाम निन्ये रवणः स्फुटार्थताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20006745,
    "chapter_id": 6642,
    "verse_number": "12.10",
    "content_sanskrit": "नस्यागृहीतोऽपि धुवन्विषाणयोर्युगं ससूत्कारविवर्तितत्रिकः । गोणीं जनन स्म निधातुमुद्धृतामनुक्षणं नोक्षतरः प्रतीच्छति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20006746,
    "chapter_id": 6642,
    "verse_number": "12.11",
    "content_sanskrit": "नानाविधाविष्कृसामजस्वरः सहस्रवर्त्मा चपलैर्दुरध्ययः । गान्धर्वभूय्ष्ठतया समानतां स सामवेदस्य दधौ बलोदधिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20006747,
    "chapter_id": 6642,
    "verse_number": "12.12",
    "content_sanskrit": "प्रत्यन्यनागं चल्तस्तरावता निरस्य कुण्ठं दधतान्यमङ्कुशम् । मूर्धानमूर्ध्वायतदन्तमण्डलं धुवन्नरोधि द्विरदां निषादिना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20006748,
    "chapter_id": 6642,
    "verse_number": "12.13",
    "content_sanskrit": "समूर्च्छदुच्छृङ्खलशङ्खनिस्वनः स्वनः प्रयाते पटहस्य शार्ङ्गिणि । सत्त्वानि निन्ये नितरां महान्त्यपि व्यथां द्वयेषामपि मेदिनीभृताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20006749,
    "chapter_id": 6642,
    "verse_number": "12.14",
    "content_sanskrit": "कालीयकक्षोदविलेपनश्रियं दिशद्दिशमुल्लसदंशुमद्द्युति । खातं खुरैमुद्गभुजां विपप्रते गिरेरधः काञ्चनभूमिजं रजः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20006750,
    "chapter_id": 6642,
    "verse_number": "12.15",
    "content_sanskrit": "मन्द्रैगजानां रथमण्डलस्वनैर्निजुह्नुवे तादृशमेव बृंहितम् । तारैर्बभूवे परभागलाभतः परिश्फुटैस्तेषु तुरङ्गहेषितैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20006751,
    "chapter_id": 6642,
    "verse_number": "12.16",
    "content_sanskrit": "अन्वेतुकामोऽवमताङ्गुशग्रहस्तिरोगतं साङ्गुशमुद्वहञ्शिरः । स्थूलोच्चयेनागमदन्तिकगतां गजोऽग्रयाताग्रकरः करेणुकाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20006752,
    "chapter_id": 6642,
    "verse_number": "12.17",
    "content_sanskrit": "यन्तोऽस्पृशन्तश्चरणैरिवावनिं जवात्प्रकीर्णैरभितः प्रकीर्णकैः । अद्यापि सेनातुरगाः सविस्मयैरलूनपक्षा इव मेनिरे जनैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20006753,
    "chapter_id": 6642,
    "verse_number": "12.18",
    "content_sanskrit": "ऋज्वीर्दधानैरवतत्य कन्धराश्चलावचूडाः कलाघर्घररारवैः । भूमिर्महत्यप्यविलम्बितक्रमं क्रमेलकैस्तक्षणमेव चिच्छिदे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20006754,
    "chapter_id": 6642,
    "verse_number": "12.19",
    "content_sanskrit": "तूर्ण प्रणेत्रा कृतनादमुच्चकैः प्रणोदितं वेसरयुग्मध्वनि । आत्मीयनेमिक्षतसान्द्रमेदिनीरजश्चयाक्रान्तभयादिवाद्रवत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20006755,
    "chapter_id": 6642,
    "verse_number": "12.20",
    "content_sanskrit": "व्यावृत्तवक्त्रैरखिलैश्चमूचरैर्व्रजिद्भिरेव क्षणमीक्षिताननाः । वल्गद्गरीयःस्तनकम्प्रकञ्चुकं ययुस्तुरङ्गाधिरुहोऽवरोधिकाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20006756,
    "chapter_id": 6642,
    "verse_number": "12.21",
    "content_sanskrit": "पादैः पुरः कूबरिणां विदारिताः प्रकाममाक्रान्ततलास्ततो गजैः । भग्नोन्नतानन्तरपूरितान्तरा बभुर्भुवः कृष्टसमीकृता इव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20006757,
    "chapter_id": 6642,
    "verse_number": "12.22",
    "content_sanskrit": "दुर्दुन्तमुपकृत्य निरस्तसादिनं सहासहाकारमलोकयज्जनः । पर्याणतः स्रस्तमुरोविलम्बिनस्तुरङ्गमं प्रद्रुतमेकया दिशा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20006758,
    "chapter_id": 6642,
    "verse_number": "12.23",
    "content_sanskrit": "भूभृद्भिरप्यस्खलिताः खलून्नतैरप्यपह्नवाना सरितः पृथूरपि । अन्वर्थसंज्ञयैव परं त्रिमार्गगा ययावसंख्यैः पथिभिश्चमूरसौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20006759,
    "chapter_id": 6642,
    "verse_number": "12.24",
    "content_sanskrit": "त्रस्तौ समासन्नकरेणुसूत्कृतान्नियन्तरि व्याकुलमुक्तरज्जुके । क्षिप्तावरोधाङ्गनमुत्पथेन गां विलङ्घ्य लघ्वीं करभौ बभञ्जतुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20006760,
    "chapter_id": 6642,
    "verse_number": "12.25",
    "content_sanskrit": "स्रस्ताङ्गसन्धौ विगताशापाटवे रुजा निकामं विकलीकृते रथे । आप्तेन तत्क्षणा भिषजेव तत्क्षणं प्रचक्रमे लङ्घनपूर्वकः क्रमः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20006761,
    "chapter_id": 6642,
    "verse_number": "12.26",
    "content_sanskrit": "धूर्भङ्गसंक्षोभविदारितोष्ट्रिका गलन्मधुप्लावितदूरवर्त्मनि । स्थाणौ निषङ्गिण्यनसि क्षणं पुरः शुशोच लाभाय कृतक्रयो वणिक् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20006762,
    "chapter_id": 6642,
    "verse_number": "12.27",
    "content_sanskrit": "भेरिभिराक्रुष्टमहागुहामुखो ध्वजांशुकैस्तर्जितकन्दलीवनः । उत्तङ्गमातङ्गजितालघूपलो बलैः स पश्चात्कियते स्म भूधरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20006763,
    "chapter_id": 6642,
    "verse_number": "12.28",
    "content_sanskrit": "वन्येभदानानिलगन्धददुर्धुराः क्षणं तरुच्छेदविनोदितक्रुधः । व्यालद्विपा यन्तृभिरुन्मतिष्णवः कथंचिदीरादपनयेन निन्यिरे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
