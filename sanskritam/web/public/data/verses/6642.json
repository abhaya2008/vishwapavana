  {
    "id": 20006802,
    "chapter_id": 6642,
    "verse_number": "12.67",
    "content_sanskrit": "या घर्मभानोस्तनयापि शीतलैः स्वसा यमस्यापि जनस्य जीवनैः । कृष्णापि शुद्धेरधिकं विधातृभिर्विहन्तुमहांसि जलैः पटीयसी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
