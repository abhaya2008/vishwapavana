[{"id": 7000429000, "chapter_id": 20429, "verse_number": "२-१०१-१", "content_sanskrit": "सूत उवाच ।\nदेवदेवो हृषीकेशस्त्वंगपुत्रं नृपोत्तमम् ।\nसमाचष्ट महाश्रेय आख्यानं पापनाशनम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000429001, "chapter_id": 20429, "verse_number": "२-१०१-२", "content_sanskrit": "श्रूयतामभिधास्यामि चरित्रं श्रेयदायकम् ।\nद्विजस्यापि च वृत्तांतं कुंजलस्य महात्मनः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000429002, "chapter_id": 20429, "verse_number": "२-१०१-३", "content_sanskrit": "विष्णुरुवाच ।\nकुंजलश्चापि धर्मात्मा चतुर्थं पुत्रमेव च ।\nसमाहूय मुदायुक्त उवाचैनं कपिंजलम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000429003, "chapter_id": 20429, "verse_number": "२-१०१-४", "content_sanskrit": "किं नु पुत्र त्वया दृष्टमपूर्वं कथयस्व मे ।\nभोजनार्थं तु यासि त्वमितः कस्मिन्सुतोत्तम॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000429004, "chapter_id": 20429, "verse_number": "२-१०१-५", "content_sanskrit": "तदाचक्ष्व महाभाग यदि दृष्टं सुपुण्यदम् ।\nकपिंजल उवाच ।\nयच्च तात त्वया पृष्टमपूर्वं प्रवदाम्यहम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000429005, "chapter_id": 20429, "verse_number": "२-१०१-६", "content_sanskrit": "यन्न दृष्टं श्रुतं केन कस्मान्नैव श्रुतं मया ।\nतदिहैव प्रवक्ष्यामि श्रूयतामधुना पितः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000429006, "chapter_id": 20429, "verse_number": "२-१०१-७", "content_sanskrit": "शृण्वंतु भ्रातरः सर्वे मातस्त्वं शृणु सांप्रतम् ।\nकैलासः पर्वतश्रेष्ठो धवलश्चंद्र सन्निभः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000429007, "chapter_id": 20429, "verse_number": "२-१०१-८", "content_sanskrit": "नानाधातुसमाकीर्णो नानावृक्षोपशोभितः ।\nगंगाजलैः शुभैः पुण्यैः क्षालितः सर्वतः पितः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000429008, "chapter_id": 20429, "verse_number": "२-१०१-९", "content_sanskrit": "नदीनां तु सहस्राणि दिव्यानि विविधानि च ।\nयस्मात्तात प्रसूतानि जलानि विविधानि च॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000429009, "chapter_id": 20429, "verse_number": "२-१०१-१०", "content_sanskrit": "तडागानि सहस्राणि सोदकानि महागिरौ ।\nनद्यः संति विशालिन्यो हंससारससेविताः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000429010, "chapter_id": 20429, "verse_number": "२-१०१-११", "content_sanskrit": "तस्मिञ्छिखरिणां श्रेष्ठे पुण्यदाः पापनाशनाः ।\nवनानि विविधान्येव पुष्पितानि फलानि च॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000429011, "chapter_id": 20429, "verse_number": "२-१०१-१२", "content_sanskrit": "नानावृक्षोपयुक्तानि हरितानि शुभानि च ।\nकिन्नराणां गणैर्युक्तश्चाप्सरोभिः समाकुलः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000429012, "chapter_id": 20429, "verse_number": "२-१०१-१३", "content_sanskrit": "गंधर्वचारणैः सिद्धैर्देववृंदैः सुशोभितः ।\nदिव्यवृक्षवनोपेतो दिव्यभावैः समाकुलः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000429013, "chapter_id": 20429, "verse_number": "२-१०१-१४", "content_sanskrit": "दिव्यगंधैः सुशोभाढ्यैर्नानारत्नसमन्वितः ।\nशिलाभिः स्फटिकस्यापि शुक्लाभिस्तु सुशोभनः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000429014, "chapter_id": 20429, "verse_number": "२-१०१-१५", "content_sanskrit": "सूर्यतेजोमयो राजंस्तेजोभिस्तु समाकुलः ।\nचंदनैश्चारुगंधैश्च बकुलैर्नीलपुष्पकैः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000429015, "chapter_id": 20429, "verse_number": "२-१०१-१६", "content_sanskrit": "नानापुष्पमयैर्वृक्षैः सर्वत्र समलंकृतः ।\nपक्षिणां सुनिनादैश्च दिव्यानां मधुरायते॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000429016, "chapter_id": 20429, "verse_number": "२-१०१-१७", "content_sanskrit": "षट्पदानां निनादैश्च वृक्षौघैर्मधुरायते ।\nरुतैश्च कोकिलानां तु शोभते स वनो गिरिः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000429017, "chapter_id": 20429, "verse_number": "२-१०१-१८", "content_sanskrit": "गणकोटिसमाकीर्णं तत्रास्ति शिवमंदिरम् ।\nअंशुभिर्धवलं पुण्यं पुण्यराशिशिलोच्चयम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000429018, "chapter_id": 20429, "verse_number": "२-१०१-१९", "content_sanskrit": "सिंहैश्च गर्जमानैश्च सैरिभैः कुंजरैस्ततः ।\nदिग्गजानां सुघोषैश्च शब्दितं च समंततः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000429019, "chapter_id": 20429, "verse_number": "२-१०१-२०", "content_sanskrit": "नानामृगैः समाकीर्णं शाखामृगगणाकुलम् ।\nमयूरकेकाघोषैश्च गुहासु च विनादितम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000429020, "chapter_id": 20429, "verse_number": "२-१०१-२१", "content_sanskrit": "कंदरैर्लेपनैः कूटैः सानुभिश्च विराजितम् ।\nनानाप्रस्रवणोपेतमोषधीभिर्विराजितम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000429021, "chapter_id": 20429, "verse_number": "२-१०१-२२", "content_sanskrit": "दिव्यं दिव्यगुणं पुण्यं पुण्यधाम समाकुलम् ।\nसेवितं पुण्यलोकैश्च पुण्यराशिं महागिरिम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000429022, "chapter_id": 20429, "verse_number": "२-१०१-२३", "content_sanskrit": "पुलिंदभिल्लकोलैश्च सेवितं पर्वतोत्तमम् ।\nविकटैः शिखरैः कोटैरद्रिराजः प्रकाशते॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000429023, "chapter_id": 20429, "verse_number": "२-१०१-२४", "content_sanskrit": "अन्यैर्नानाविधैः पुण्यैः कौतुकैर्मंगलैः शुभैः ।\nगंगोदकप्रवाहैश्च महाशब्दं प्रसुस्रुवे॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000429024, "chapter_id": 20429, "verse_number": "२-१०१-२५", "content_sanskrit": "शंकरस्य गृहं तत्र कैलासं गतवानहम् ।\nतत्राश्चर्यं मया दृष्टं यन्न दृष्टं कदा श्रुतम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000429025, "chapter_id": 20429, "verse_number": "२-१०१-२६", "content_sanskrit": "श्रूयतामभिधास्यामि तात सर्वं मयोदितम् ।\nशिखराद्गिरिराजस्य मेरोः पुण्यान्महोदयात्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000429026, "chapter_id": 20429, "verse_number": "२-१०१-२७", "content_sanskrit": "हिमक्षीरसुवर्णस्तु प्रवाहः पतते भुवि ।\nगंगायाश्च महाभाग रंहसा घोषभूषितः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000429027, "chapter_id": 20429, "verse_number": "२-१०१-२८", "content_sanskrit": "कैलासस्य शिरः प्राप्य तत्र विस्तरतां गतः ।\nदशयोजनमानेन तत्र गंगा ह्रदो महान्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000429028, "chapter_id": 20429, "verse_number": "२-१०१-२९", "content_sanskrit": "महातोयेन पुण्येन विमलेन विराजते ।\nसर्वतोभद्रतां प्राप्तो महाहंसैः प्रशोभते॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000429029, "chapter_id": 20429, "verse_number": "२-१०१-३०", "content_sanskrit": "सामोच्चारेण पुण्येन दिव्येन मधुरेण च ।\nहंसास्तत्र प्रकूजंति सरस्तेन विराजते॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000429030, "chapter_id": 20429, "verse_number": "२-१०१-३१", "content_sanskrit": "तस्य तीरे शिलायां वै हिमकन्या महामते ।\nआसीना मुक्तकेशांता रूपद्रविणशालिनी॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000429031, "chapter_id": 20429, "verse_number": "२-१०१-३२", "content_sanskrit": "दिव्यरूपसुसंपन्ना सगुणा दिव्यलक्षणा ।\nदिव्यालंकारभूषा च तस्यास्तीरे विराजते॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000429032, "chapter_id": 20429, "verse_number": "२-१०१-३३", "content_sanskrit": "न जाने गिरिराजस्य तनया वा महोदधेः ।\nनो वास्ति ब्रह्मणः पत्नी सा वा स्वाहा भविष्यति॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000429033, "chapter_id": 20429, "verse_number": "२-१०१-३४", "content_sanskrit": "इंद्राणी वा महाभागा रोहिणी वा भविष्यति ।\nईदृशी रूपसंपत्तिर्युवतीनां न दृश्यते॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000429034, "chapter_id": 20429, "verse_number": "२-१०१-३५", "content_sanskrit": "अन्यासां च सुदिव्यानां नारीणां तात सर्वथा ।\nयादृशं रूपसंभावं गुणशीलं प्रदृश्यते॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000429035, "chapter_id": 20429, "verse_number": "२-१०१-३६", "content_sanskrit": "अप्सरसां कदा नास्ति तादृशं रूपलक्षणम् ।\nयादृशं तु मया दृष्टं तदंगं विश्वमोहनम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000429036, "chapter_id": 20429, "verse_number": "२-१०१-३७", "content_sanskrit": "शिलापदे समासीना दुःखेनापि समाकुला ।\nरुदते सुस्वरैर्बाला अनेकैः स्वजनैर्विना॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000429037, "chapter_id": 20429, "verse_number": "२-१०१-३८", "content_sanskrit": "अश्रूणि मुंचमाना सा मुक्ताभानि बहूनि च ।\nनिर्मलानि सरस्यत्र पतंत्येव महामते॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000429038, "chapter_id": 20429, "verse_number": "२-१०१-३९", "content_sanskrit": "बिंदवो मौक्तिकाभास्ते निपतंति महोदके ।\nतेभ्यो भवंति पद्मानि हृद्यानि सुरभीणि तु॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000429039, "chapter_id": 20429, "verse_number": "२-१०१-४०", "content_sanskrit": "पद्मानि जज्ञिरे तेभ्यो नेत्राश्रुभ्यो महामते ।\nगंगांभसि तरंत्येव असंख्यातानि तानि तु॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000429040, "chapter_id": 20429, "verse_number": "२-१०१-४१", "content_sanskrit": "पतितानि सुहृद्यानि रंहसा यानि तानि तु ।\nगंगाप्रवाहमध्ये तु हंसवृंदैः सुसेविते॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000429041, "chapter_id": 20429, "verse_number": "२-१०१-४२", "content_sanskrit": "भागीरथ्याः प्रवाहस्तु तस्मात्स्थानाद्विनिर्गतः ।\nकैलासशिखरं प्राप्य रत्नाख्यं चारुकंदरम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000429042, "chapter_id": 20429, "verse_number": "२-१०१-४३", "content_sanskrit": "वर्तते तोयपूर्णस्तु योजनद्वयविस्तृतः ।\nहंसवृंदसमाकीर्णो जलपक्षि समाकुलः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000429043, "chapter_id": 20429, "verse_number": "२-१०१-४४", "content_sanskrit": "नानावर्णविशेषाणि संति पद्मानि तत्र च ।\nप्रवाहे निर्मले तात मुनिवृंदनिषेविते॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000429044, "chapter_id": 20429, "verse_number": "२-१०१-४५", "content_sanskrit": "अश्रुभ्यो यानि जातानि प्रभाते कमलानि तु ।\nगंगोदकप्लुतान्येव सौरभाणि महांति च॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000429045, "chapter_id": 20429, "verse_number": "२-१०१-४६", "content_sanskrit": "प्रतरंति प्रवाहे तु निर्मले जलपूरिते ।\nमध्ये मध्ये सुहंसैश्च जलपक्षिनिनादिते॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000429046, "chapter_id": 20429, "verse_number": "२-१०१-४७", "content_sanskrit": "सूत उवाच ।\nरत्नाख्ये तु गिरौ तस्मिन्रत्नेश्वरमहेश्वरः ।\nदेवदैत्यसुपूज्योपि तिष्ठते तात सर्वदा॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000429047, "chapter_id": 20429, "verse_number": "२-१०१-४८", "content_sanskrit": "तत्र दृष्टो मया तात कश्चित्पुण्यमयो मुनिः ।\nजटाभारसमाक्रांतो निर्वासा दंडधारकः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000429048, "chapter_id": 20429, "verse_number": "२-१०१-४९", "content_sanskrit": "निराधारो निराहारस्तपसातीव दुर्बलः ।\nकृशांगोऽप्यस्थिसंघातस्त्वचामात्रेण वेष्टितः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000429049, "chapter_id": 20429, "verse_number": "२-१०१-५०", "content_sanskrit": "भस्मोद्धूलितमात्राणि सर्वांगानि महात्मनः ।\nशुष्कपत्राणि भक्षेत शीर्णानि पतितानि च॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000429050, "chapter_id": 20429, "verse_number": "२-१०१-५१", "content_sanskrit": "शिवभक्तिसमासीनो दुराधारो महातपाः ।\nअश्रुभ्यो यानि जातानि पद्मानि सुरभीणि च॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000429051, "chapter_id": 20429, "verse_number": "२-१०१-५२", "content_sanskrit": "गंगातोयात्समानीय देवदेवं प्रपूजयेत् ।\nरत्नेश्वरं महाभागो गीतनृत्यविशारदः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000429052, "chapter_id": 20429, "verse_number": "२-१०१-५३", "content_sanskrit": "गायते नृत्यते तस्य द्वारस्थस्त्रिपुरद्विषः ।\nमठमागत्य धर्मात्मा रोदते सुस्वरैरपि॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000429053, "chapter_id": 20429, "verse_number": "२-१०१-५४", "content_sanskrit": "एतद्दृष्टं मया तात अपूर्वं वदतांवर ।\nकथयस्व प्रसादान्मे यदि त्वं वेत्सि कारणम्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000429054, "chapter_id": 20429, "verse_number": "२-१०१-५५", "content_sanskrit": "सा का नारी महाभागा कस्मात्तात प्ररोदिति ।\nकस्मात्स देवपुरुषो देवमर्चेन्महेश्वरम्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000429055, "chapter_id": 20429, "verse_number": "२-१०१-५६", "content_sanskrit": "तन्मे त्वं विस्तराद्ब्रूहि सर्वसंदेहकारणम् ।\nएवमुक्तो महाप्राज्ञः कुंजलोपि सुतेन हि॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000429056, "chapter_id": 20429, "verse_number": "२-१०१-५७", "content_sanskrit": "कपिंजलेन प्रोवाच विस्तराच्छृण्वतो मुनेः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]