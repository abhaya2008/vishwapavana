[{"id": 2108082, "chapter_id": 3337, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2108083, "chapter_id": 3337, "verse_number": "१", "content_sanskrit": "ततोऽभ्रशिखराकारैर्गिरिशृङ्गैरलङ्कृतम् ।\nमन्दरं पर्वतवरं लताजालसमावृतम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2108084, "chapter_id": 3337, "verse_number": "२", "content_sanskrit": "नानाविहङ्गसङ्घुष्टं नानादंष्ट्रिसमाकुलम् ।\nकिन्नरैरप्सरोभिश्च देवैरपि च शोभितम्\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2108085, "chapter_id": 3337, "verse_number": "३", "content_sanskrit": "एकादश सहस्राणि योजनानां समुच्छ्रितम् ।\nअधोभूमेः सहस्रेषु तावत्स्वेव प्रतिष्ठितम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2108086, "chapter_id": 3337, "verse_number": "४", "content_sanskrit": "समुद्धर्तुमशक्ता वै सर्वे देवगणास्तदा ।\nविष्णुमासीनमभ्येत्य ब्रह्माणं चेदमब्रुवन् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2108087, "chapter_id": 3337, "verse_number": "५", "content_sanskrit": "भवन्तावत्र कुरुतां बुद्धिं नैश्रेयसीं पराम् ।\nमन्दरोद्धरणे यत्नः क्रियतां च हिताय नः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2108088, "chapter_id": 3337, "verse_number": "६", "content_sanskrit": "तथेति चाब्रवीद् विष्णुर्ब्रह्मणा सह भार्गव ।\nअचोदयदमेयात्मा फणीन्द्रं पद्मलोचनः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2108089, "chapter_id": 3337, "verse_number": "७", "content_sanskrit": "ततोऽनन्तः समुत्थाय ब्रह्मणा परिचोदितः ।\nनारायणेन चाप्युक्तस्तस्मिन् कर्मणि वीर्यवान् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2108090, "chapter_id": 3337, "verse_number": "९", "content_sanskrit": "अथ पर्वतराजानं तमनन्तो महाबलः ।\nउज्जहार बलाद् ब्रह्मन् सवनं सवनौकसम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2108091, "chapter_id": 3337, "verse_number": "१०", "content_sanskrit": "ततस्तेन सुराः सार्धं समुद्रमुपतस्थिरे ।\nतमूचुरमृतस्यार्थे निर्मथिष्याम ते जलम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2108092, "chapter_id": 3337, "verse_number": "११", "content_sanskrit": "अपाम्पतिरथोवाच ममाप्यंशो भवेत् ततः ।\nसोढाऽस्मि विपुळं मर्दं मन्दरभ्रमणादिह \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2108093, "chapter_id": 3337, "verse_number": "१२", "content_sanskrit": "ऊचुश्च कूर्मराजानमकूपारं सुरासुराः ।\nअधिष्ठानं गिरेरस्य भवान् भवितुमर्हति \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2108094, "chapter_id": 3337, "verse_number": "१३", "content_sanskrit": "कूर्मेण तु तथेत्युक्ते पृष्ठे तस्य समर्पितः ।\nस शैलस्तस्य चाग्रं वै वज्रेणेन्द्रो ह्यपीडयत् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2108095, "chapter_id": 3337, "verse_number": "१४", "content_sanskrit": "मन्थानं मन्दरं कृत्वा योक्त्रं कृत्वा तु वासुकिम् ।\nदेवा मथितुमारब्धाः समुद्रं निधिमम्भसाम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2108096, "chapter_id": 3337, "verse_number": "१५", "content_sanskrit": "अमृतार्थिनस्ततो ब्रह्मन् सहिता दैत्यदानवैः ।\nअनन्तो भगवान् देवो यतो नारायणः स्थितः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2108097, "chapter_id": 3337, "verse_number": "१६", "content_sanskrit": "विबुधाः सहिताः सर्वे यतः पुच्छं ततः स्थिताः ।\nवासुकेरङ्गमाश्लिष्टा नागराज्ञो महासुराः\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2108098, "chapter_id": 3337, "verse_number": "१७", "content_sanskrit": "शिर उद्यम्य नागस्य पुनः पुनरवाक्षिपन् ।\nवासुकेरथ नागस्य सहसा क्षिप्यतोऽसुरैः\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2108099, "chapter_id": 3337, "verse_number": "१८", "content_sanskrit": "सधूमाश्चार्चिषो वाता निष्पेतुरसकृन्मुखात् ।\nवासुकेर्मथ्यमानस्य निस्सृतेन विषेण च\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2108100, "chapter_id": 3337, "verse_number": "१९", "content_sanskrit": "अभवन् मिश्रितं तोयं तदा भार्गवनन्दन ।\nमथनान्मन्दरेणाथ देवदानवबाहुभिः\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2108101, "chapter_id": 3337, "verse_number": "२०", "content_sanskrit": "विषं तीक्ष्णं समुद्भूतं हालाहलमिति श्रुतम् ।\nदेवाश्च दानवाश्चैव दग्धास्तेन विषेण ह \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2108102, "chapter_id": 3337, "verse_number": "२१", "content_sanskrit": "अपक्रामंस्ततो भीता विषादमगमंस्तदा ।\nब्रह्माणमब्रुवन् देवाः समेत्य मुनिपुङ्गवैः\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2108103, "chapter_id": 3337, "verse_number": "२२", "content_sanskrit": "मथ्यमानेऽमृते जातं विषं कालानलप्रभम् ।\nतेन वै तापिता लोकास्तस्य प्रतिकुरुष्व ह\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2108104, "chapter_id": 3337, "verse_number": "२३", "content_sanskrit": "एवमुक्तस्ततो ब्रह्मा दध्यौ लोकेश्वरं हरम् ।\nत्र्यक्षं त्रिशूलिनं रुद्रं देवदेवमुमापतिम्\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2108105, "chapter_id": 3337, "verse_number": "२४", "content_sanskrit": "तदाऽथ चिन्तितो देवस्तज्ज्ञात्वा द्रुतमाययौ ।\nतस्याथ देवस्तत्सर्वमाचचक्षे प्रजापतिः\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2108106, "chapter_id": 3337, "verse_number": "२५", "content_sanskrit": "तच्छ्रुत्वा देवदेवेशो लोकस्यास्य हिते रतः ।\nअपिबत् तद्विषं रुद्रः कालानलसमप्रभम् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2108107, "chapter_id": 3337, "verse_number": "२६", "content_sanskrit": "कण्ठे स्थापितवान् देवो लोकानां हितकाम्यया ।\nयस्मात्तु नीलता कण्ठे नीलकण्ठस्ततः स्मृतः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2108108, "chapter_id": 3337, "verse_number": "२७", "content_sanskrit": "पीतमात्रे विषे तत्र रुद्रेणामिततेजसा ।\nदेवाः प्रीताः पुनर्जग्मुश्चक्रुर्वै कर्म तत्तथा\t ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2108109, "chapter_id": 3337, "verse_number": "२८", "content_sanskrit": "मथ्यमानेऽमृतस्यार्थे भूयो वै देवदानवैः ।\nवासुकेरथ नागस्य सहसा क्षिप्यतस्तु तैः\t ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2108110, "chapter_id": 3337, "verse_number": "२९", "content_sanskrit": "सधूमाः सार्चिषो वाता निष्पेतुरसकृन्मुखात् ।\nते धूमसङ्घाः सम्भूता महामेघाः सविद्युतः\t ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2108111, "chapter_id": 3337, "verse_number": "३०", "content_sanskrit": "अभ्यवर्षन् सुरगणान् श्रमसन्तापकर्शितान् ।\nतस्माच्च गिरिकूटाग्रात् प्रच्युताः पुष्पवृष्टयः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2108112, "chapter_id": 3337, "verse_number": "३१", "content_sanskrit": "सुरासुरगणान् माल्यैः सर्वतः समवाकिरन् ।\nबभूवात्र महाघोषो महामेघरवोपमः \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2108113, "chapter_id": 3337, "verse_number": "३२", "content_sanskrit": "उदधेर्मथ्यमानस्य मन्दरेण सुरासुरैः ।\nतत्र नानाजलचरा विनिर्धूता महाद्रिणा\t ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2108114, "chapter_id": 3337, "verse_number": "३३", "content_sanskrit": "विलयं समुपाजग्मुः शतशो लवणाम्भसि ।\nवारुणानि च भूतानि विविधानि महीधरात्\t ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2108115, "chapter_id": 3337, "verse_number": "३४", "content_sanskrit": "पाताळतळवासीनि विलयं समुपागमन् ।\nतस्मिंश्च भ्राम्यमाणेऽद्रौ सङ्घृष्यन्तः परस्परम्\t ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2108116, "chapter_id": 3337, "verse_number": "३५", "content_sanskrit": "न्यपतन्पतगोपेताः पर्वताग्रान् महाद्रुमाः ।\nतेषां सङ्घर्षतश्चाग्निरुत्थितः प्रज्वलन् मुहुः\t ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2108117, "chapter_id": 3337, "verse_number": "३६", "content_sanskrit": "विद्युद्भिरिव नीलाभ्रमावृणोन्मन्दरं गिरिम् ।\nददाह कुञ्जरांश्चैव सिंहांश्चैव विनिर्गतान्\t ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2108118, "chapter_id": 3337, "verse_number": "३७", "content_sanskrit": "विगतासूनि सत्वानि सर्वाणि विविधानि च ।\nतमग्निं मन्दरश्रेष्ठं प्रदहन्तमितस्ततः\t ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2108119, "chapter_id": 3337, "verse_number": "३८", "content_sanskrit": "वारिणा मेघजेनेन्द्रः शमयामास सर्वशः ।\nततो नानाविधास्तत्र सुस्रुवुः सागराम्भसि\t ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2108120, "chapter_id": 3337, "verse_number": "३९", "content_sanskrit": "महाद्रुमाणां निर्यासा बहवश्चौषधीरसाः ।\nतेषाममृतवीर्याणां रसानामासवेन च \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2108121, "chapter_id": 3337, "verse_number": "४०", "content_sanskrit": "अमृतत्वं सुरा जग्मुः काञ्चनस्य च निस्रवात् ।\nअथ तस्य समुद्रस्य सञ्जातमुदकं पयः\t ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2108122, "chapter_id": 3337, "verse_number": "४१", "content_sanskrit": "रसोपमर्दैर्मिश्रं च ततः क्षीरादभूद् घृतम् ।\nततो ब्रह्माणमासीनं देवा वरदमब्रुवन् \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2108123, "chapter_id": 3337, "verse_number": "४२", "content_sanskrit": "श्रान्ताः स्म सुभृशं ब्रह्मन्न भवत्यमृतं जलात् ।\nऋते नारायणं देवं दैत्या नागोत्तमो वयम् \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2108124, "chapter_id": 3337, "verse_number": "४३", "content_sanskrit": "चिरारब्धमिदं चापि सागरस्य विमन्थनम् ।\nदेवानां वचनं श्रुत्वा ब्रह्मा लोकपितामहः \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2108125, "chapter_id": 3337, "verse_number": "४४", "content_sanskrit": "ततो नारायणं देवं वचनं चेदमब्रवीत् ।\nविधत्स्वैषां बलं विष्णो भवानत्र परायणः \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2108126, "chapter_id": 3337, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2108127, "chapter_id": 3337, "verse_number": "४५", "content_sanskrit": "बलं ददामि सर्वेषां कर्मैतद् ये समास्थिताः ।\nक्षोभ्यतां कलशः सर्वैर्मन्दरः परिवर्त्यताम् \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2108128, "chapter_id": 3337, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2108129, "chapter_id": 3337, "verse_number": "४६", "content_sanskrit": "नारायणवचः श्रुत्वा बलिनस्ते महोदधेः ।\nतत्पयः सहिता भूयश्चक्रिरे भृशमाकुलम् \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2108130, "chapter_id": 3337, "verse_number": "४७", "content_sanskrit": "तत्र पूर्वं विषं जातं तद् ब्रह्मवचनाच्छिवः ।\nप्राग्रसल्लोकरक्षार्थं ततो ज्येष्ठा समुत्थिता \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2108131, "chapter_id": 3337, "verse_number": "४८", "content_sanskrit": "कृष्णरूपधरा देवी सर्वाभरणभूषिता ।\nततः शतसहस्रांशुः समान इव सागरात् \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2108132, "chapter_id": 3337, "verse_number": "४९", "content_sanskrit": "प्रसन्नाभः समुत्पन्नः सोमः शीतांशुरुज्ज्वलन् ।\nश्रीरनन्तरमुत्पन्ना घृतात् पाण्डरवासिनी \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2108133, "chapter_id": 3337, "verse_number": "५०", "content_sanskrit": "सुरा देवी समुत्पन्ना तुरगः पाण्डरस्तथा ।\nकौस्तुभश्च मणिर्दिव्य उत्पन्नोऽमृतसम्भवः \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2108134, "chapter_id": 3337, "verse_number": "५१", "content_sanskrit": "मरीचिविकचः श्रीमान् स च नारायणं गतः ।\nपारिजातश्च तत्रैव सुरभिश्च महामुने \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2108135, "chapter_id": 3337, "verse_number": "५२", "content_sanskrit": "जज्ञाते तौ तदा ब्रह्मन् सर्वकामफलप्रदौ ।\nततो जज्ञे महाभाग चतुर्दन्तो महागजः \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2108136, "chapter_id": 3337, "verse_number": "५३", "content_sanskrit": "ऐरावतः स वै नागो नागानां प्रवरः शुचिः ।\nकौस्तुभश्चाप्सरश्चैव ऐरावतमहागजः \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2108137, "chapter_id": 3337, "verse_number": "५४", "content_sanskrit": "यतो देवास्ततो जग्मुरादित्यपथमाश्रिताः ।\nधन्वन्तरिस्ततो देवो वपुष्मानुदतिष्ठत\t ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2108138, "chapter_id": 3337, "verse_number": "५५", "content_sanskrit": "श्वेतं कमण्डलुं बिभ्रदमृतं यत्र तिष्ठति ।\nएतदत्यद्भुतं दृष्ट्वा दानवानां समुत्थितः\t ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2108139, "chapter_id": 3337, "verse_number": "५६", "content_sanskrit": "अमृतार्थे महान् नादो ममेदमिति जल्पताम् ।\nततो नारायणो मायामास्थितो मोहिनीं प्रभुः\t ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2108140, "chapter_id": 3337, "verse_number": "५७", "content_sanskrit": "स्त्रीरूपमद्भुतं कृत्वा दानवानभिसंश्रितः ।\nततस्तदमृतं तस्यै ददुस्ते मूढचेतसः \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2108141, "chapter_id": 3337, "verse_number": "५८", "content_sanskrit": "स्त्रियै दानवदैतेयाः सर्वे तद्गतमानसाः ।\nसा तु नारायणी माया धारयन्ती कमण्डलुम् \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2108142, "chapter_id": 3337, "verse_number": "५९", "content_sanskrit": "आस्यमानेषु देवेषु पङ्क्त्या च सह दानवैः ।\nदेवानपाययद् देवी न दैत्यांस्ते च चुक्रुशुः \t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2108143, "chapter_id": 3337, "verse_number": "४", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि षोडशोऽध्यायः ॥१६॥ ॥ आस्तीकपर्वणि चतुर्थोऽध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]