[
  {
    "id": 20132174,
    "chapter_id": 7015,
    "verse_number": "36.1",
    "content_sanskrit": "अथ षट्त्रिंशो ऽध्यायः",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20132175,
    "chapter_id": 7015,
    "verse_number": "36.2",
    "content_sanskrit": "अथात्रेयो वसिष्ठश्च पुलस्त्यः पुलहः क्रतुः । अङ्गिरा गौतमो ऽगस्त्यो मनुरायुस्तथात्मवान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20132176,
    "chapter_id": 7015,
    "verse_number": "36.3",
    "content_sanskrit": "विश्वामित्रः स्थूलशिराः संवर्तः प्रमतिर्दनुः । उशना बृहस्पतिर्व्यासश्च्यवनः काश्यपो ध्रुवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20132177,
    "chapter_id": 7015,
    "verse_number": "36.4",
    "content_sanskrit": "दुर्वासा जामदग्न्यश्च मार्कण्डेयो ऽथ गालवः । भरद्वाजश्च रैभ्यश्च यवक्रीतस्तथैव च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20132178,
    "chapter_id": 7015,
    "verse_number": "36.5",
    "content_sanskrit": "स्थूलाक्षः शकलाक्षश्च काण्वो मेघातिथिः क्रतुः । नारदः पर्वतश्चैव सुवर्माथैकजो द्विजः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20132179,
    "chapter_id": 7015,
    "verse_number": "36.6",
    "content_sanskrit": "नितम्बुर्भुवनः सौम्यः शतानन्दः कृतव्रणः । जामदग्न्यस्तथा रामः कचश्चेत्येवमादयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20132180,
    "chapter_id": 7015,
    "verse_number": "36.7",
    "content_sanskrit": "एवं ते मुनयः श्रुत्वा सर्वज्ञं भरतं ततः । पुनरूचुरिदं वाक्यं कुतूहलपुरोगमम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20132181,
    "chapter_id": 7015,
    "verse_number": "36.8",
    "content_sanskrit": "यस्त्वया गदितो ह्येष नाट्यवेदः पुरातनः । एकचित्तैः स चास्माभिः सम्यक् समुपधारितः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20132182,
    "chapter_id": 7015,
    "verse_number": "36.9",
    "content_sanskrit": "एकश्च संशयो ऽस्माकं तं नो व्याख्यातुमर्हसि । को वान्यो नाट्यवेदस्य निश्चयं वक्तुमर्हति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20132183,
    "chapter_id": 7015,
    "verse_number": "36.10",
    "content_sanskrit": "न वयं परिहासेन न विरोधेन न चेर्ष्यया । पृच्छामो भगवन् नाट्यमुपदेशार्थमेव तु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20132184,
    "chapter_id": 7015,
    "verse_number": "36.11",
    "content_sanskrit": "अस्माभिश्च तदा नोक्तं कथाच्छेदो भवेदिति । इदानीं तूपशिक्षार्थं नाट्यगुह्यं निदर्शय ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20132185,
    "chapter_id": 7015,
    "verse_number": "36.12",
    "content_sanskrit": "लोकस्य चरितं नाट्यमित्यवोचस्त्वमीदृशम् । तेषां तु लोकं गुह्यानां निश्चयं वक्तुमर्हसि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20132186,
    "chapter_id": 7015,
    "verse_number": "36.13",
    "content_sanskrit": "देवस्य कस्य चरितं पूर्वरङ्गे द्विजर्षभ । किमर्थं भुज्यते ह्येष प्रयुक्तः किं करोति वा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20132187,
    "chapter_id": 7015,
    "verse_number": "36.14",
    "content_sanskrit": "कस्माच्चैव पुनः शौचं सम्यक् चरति सूत्रदृक् । कथमुर्वीतले नाट्यं स्वर्गान्निपतितं विभो ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20132188,
    "chapter_id": 7015,
    "verse_number": "36.15",
    "content_sanskrit": "कथं तवायं वंशश्च नटसंज्ञः प्रतिष्ठितः । सर्वमेव यथातत्त्वं कथयस्व महामुने ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20132189,
    "chapter_id": 7015,
    "verse_number": "36.16",
    "content_sanskrit": "तेषं तु वचनं श्रुत्वा मुनीनां भरतो मुनिः । प्रत्युवाच पुनर्वाक्यं गुह्यार्थाभिनयं प्रति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20132190,
    "chapter_id": 7015,
    "verse_number": "36.17",
    "content_sanskrit": "ब्रवीमि वः कथां गुह्यां यन्मां पृच्छन् सुव्रताः । पूर्वरङ्गविधानस्य तां च मे सन्निबोधत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20132191,
    "chapter_id": 7015,
    "verse_number": "36.18",
    "content_sanskrit": "प्रोक्तवानस्मि यत्पूर्वं शुभं विघ्ननिबर्हणम् । तस्यानुबन्धेन मया पूर्वरङ्गः प्रकीर्तितः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20132192,
    "chapter_id": 7015,
    "verse_number": "36.19",
    "content_sanskrit": "शस्त्राणां प्रतिकारार्थं शरीरावरणं यथा । क्रियते हि तथा पापं हुतेनैव प्रशाम्यति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20132193,
    "chapter_id": 7015,
    "verse_number": "36.20",
    "content_sanskrit": "एवं जप्यैश्च होमैश्च देवताभ्यर्चनेन च । सर्वातोद्यविधानैश्च तथा गीतस्वनेन च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20132194,
    "chapter_id": 7015,
    "verse_number": "36.21",
    "content_sanskrit": "स्तुत्याशीर्वचनैः शान्तैः कर्मभावानुकीर्तनैः । मया पापापहरणैः कृते विघ्ननिबर्हणे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20132195,
    "chapter_id": 7015,
    "verse_number": "36.22",
    "content_sanskrit": "स्तुतिगीतादिसंसृष्टैर्देवैरभिहितो ऽस्म्यहम् । नितरां परितुष्टाः स्मः प्रयोगेणामुना च ते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20132196,
    "chapter_id": 7015,
    "verse_number": "36.23",
    "content_sanskrit": "देवतासुरमानन्द्य यस्मांल्लोकश्च नन्दति । तस्मादयं प्रयोगस्तु नान्दीनामा भविष्यति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20132197,
    "chapter_id": 7015,
    "verse_number": "36.24",
    "content_sanskrit": "गीतवाद्यानुनादो हि यत्र काकुस्वनः शुभः । तस्मिन् देशे विपाप्मानो माङ्गल्यं च भविष्यति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20132198,
    "chapter_id": 7015,
    "verse_number": "36.25",
    "content_sanskrit": "यावत्तं पूरयेद्देशं ध्वनिर्नाट्यसमाश्रयः । न स्थास्यन्ति हि रक्षांसि तं देशं न विनायकाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20132199,
    "chapter_id": 7015,
    "verse_number": "36.26",
    "content_sanskrit": "आवाहे च विवाहे च यज्ञे नृपतिमङ्गले । नान्दीशब्दमुपश्रुत्य हिंस्रा नश्यन्ति चैव हि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20132200,
    "chapter_id": 7015,
    "verse_number": "36.27",
    "content_sanskrit": "पाठ्यं नाट्यं तथा गेयं चित्रवादित्रमेव च । वेदमन्त्रार्थवचनैः समं ह्येतद् भविष्यति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20132201,
    "chapter_id": 7015,
    "verse_number": "36.28",
    "content_sanskrit": "श्रुतं मया देवदेवात् तत्त्वतः शङ्कराद्धितम् । स्नानजप्यसहस्रेभ्यः पवित्रं गीतवादितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20132202,
    "chapter_id": 7015,
    "verse_number": "36.29",
    "content_sanskrit": "यस्मिन्नातोद्यनाट्यस्य गीतपाठ्यध्वनिः शुभः । भविष्यत्यशुभं देशे नैव तस्मिन् कदाचन ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20132203,
    "chapter_id": 7015,
    "verse_number": "36.30",
    "content_sanskrit": "एवं पूजाधिकारार्थं पूर्वरङ्गः कृतो मया । नानास्तुतिकृतैर्वाक्यैर्देवताभ्यर्चनेन च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20132204,
    "chapter_id": 7015,
    "verse_number": "36.31",
    "content_sanskrit": "यतो ऽभिवादनं क्लिष्टं शिष्टं तद्रङ्गमण्डले । ततस्तस्य हि तच्छौचं विहितं तु द्विजोत्तमाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20132205,
    "chapter_id": 7015,
    "verse_number": "36.32",
    "content_sanskrit": "शौचं कृत्वा यतो मन्त्रं पूजनं जर्जरस्य तु । उच्यते पूर्वरङ्गे ऽस्मिन् तस्माच्छौचं प्रकीर्तितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20132206,
    "chapter_id": 7015,
    "verse_number": "36.33",
    "content_sanskrit": "यथावतारितं चैव नाट्यमेतन्महीतले । वक्तव्यं सर्वमेतद्धि न शक्यं हि निगूहितुम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20132207,
    "chapter_id": 7015,
    "verse_number": "36.34",
    "content_sanskrit": "ममैते तनयाः सर्वे नाट्यवेदसमन्विताः । सर्वलोकं प्रहसनैः बाधन्ते नाट्यसंश्रयैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20132208,
    "chapter_id": 7015,
    "verse_number": "36.35",
    "content_sanskrit": "कस्यचित्त्वथ कालस्य शिल्पकं ग्राम्यधर्मकम् । ऋषीणां व्यङ्ग्यकरणं कुर्वद्भिर्गुणसंश्रयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20132209,
    "chapter_id": 7015,
    "verse_number": "36.36",
    "content_sanskrit": "अश्राव्यं तद्दुराचारं ग्राम्यधर्मप्रवर्तितम् । निष्ठुरं चाप्रस्तुतं च काव्यं संसदि योजितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20132210,
    "chapter_id": 7015,
    "verse_number": "36.37",
    "content_sanskrit": "तच्छ्रुत्वा मुनयः सर्वे भीमरोषप्रकम्पिताः । ऊचुस्तान् भरतान् क्रुद्धा निर्दहन्त इवाग्नयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20132211,
    "chapter_id": 7015,
    "verse_number": "36.38",
    "content_sanskrit": "मा तावद्भो द्विजा युक्तमिदमस्मद्विडम्बनम् । को नामायं परिभवः किञ्च नास्मासु सम्मतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20132212,
    "chapter_id": 7015,
    "verse_number": "36.39",
    "content_sanskrit": "यस्माज्ज्ञानमदोन्मत्ता न वेत्थाविनयाश्रिताः । तस्मादेतद्धि भवतां कुज्ञानं नाशमेष्यति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20132213,
    "chapter_id": 7015,
    "verse_number": "36.40",
    "content_sanskrit": "ऋषीणां ब्राह्मणानां च समवायसमागताः । निराहुता विना होमैः शूद्राचारा भविष्यथ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20132214,
    "chapter_id": 7015,
    "verse_number": "36.41",
    "content_sanskrit": "अपाङ्क्तेयाः कुत्सिताश्चावमा एव भविष्यथ । यश्च वो भविता वंशः सर्वाशौचो भविष्यति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20132215,
    "chapter_id": 7015,
    "verse_number": "36.42",
    "content_sanskrit": "ये च वो वंशजास्ते ऽपि भविष्यन्त्यथ नर्तकाः । परोपस्थानवन्तश्च शस्त्रपण्योपजीविनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20132216,
    "chapter_id": 7015,
    "verse_number": "36.43",
    "content_sanskrit": "शापं दत्तं तथा ज्ञात्वा सुतेभ्यो मे तदा सुराः । सर्वे विमनसो भूत्वा तानृषीन् समुपस्थिताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20132217,
    "chapter_id": 7015,
    "verse_number": "36.44",
    "content_sanskrit": "याचमानैस्ततः प्रोक्तं देवैः शक्रपुरोगमैः । इदानीं दुःखमुत्पन्नं नाट्यमेतद् विनङ्क्षति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20132218,
    "chapter_id": 7015,
    "verse_number": "36.45",
    "content_sanskrit": "ऋषिभिश्च ततः प्रोक्तं न चैतद्धि विनक्ष्यति । शेषमन्यत्र यद् प्रोक्तं सर्वमेतद् भविष्यति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20132219,
    "chapter_id": 7015,
    "verse_number": "36.46",
    "content_sanskrit": "एतच्छ्रुत्वा तु वचनं मुनीनामुग्रतेजसाम् । विष्ण्णास्ते ततः सर्वे श्रुत्वा मां समुपस्थिताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20132220,
    "chapter_id": 7015,
    "verse_number": "36.47",
    "content_sanskrit": "प्रोक्तवन्तश्च मां पुत्रास्त्वयाहो नाशिता वयम् । अनेन नाट्यदोषेण शूद्राचारा हि यत् कृताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20132221,
    "chapter_id": 7015,
    "verse_number": "36.48",
    "content_sanskrit": "मयापि सान्त्वयित्वोक्ता मा क्रोधं व्रजतानघाः । कृतान्तविहितो ऽस्माकं नूनमेष विधिः सुताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20132222,
    "chapter_id": 7015,
    "verse_number": "36.49",
    "content_sanskrit": "मुनीनां हि मृषा वाक्यं भविष्यति कदाचन । निधने च मनो मा भूद् युष्माकमिति सान्त्विताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20132223,
    "chapter_id": 7015,
    "verse_number": "36.50",
    "content_sanskrit": "जानीध्वं तत्तथा नाट्यं ब्रह्मणा संप्रवर्तितम् । शिष्येभ्यश्च तदन्येभ्यः प्रयच्छामः प्रयोगतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20132224,
    "chapter_id": 7015,
    "verse_number": "36.51",
    "content_sanskrit": "मा वै प्रणश्यतामेतन्नाट्यं दुःखप्रवर्तितम् । महाश्रयं महापुण्यं वेदाङ्गोपाङ्गसम्भवम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20132225,
    "chapter_id": 7015,
    "verse_number": "36.52",
    "content_sanskrit": "अप्सरोभ्य इदं चैव यथातत्त्वं यथाश्रुतम् । नाट्यं दत्त्वा ततः सर्वे प्रायश्चित्तं चरिष्यथ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20132226,
    "chapter_id": 7015,
    "verse_number": "36.53",
    "content_sanskrit": "इति भरतीये नाट्यशास्त्रे नाट्यशापो नाम षट्त्रिंशो ऽध्यायः",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  }
