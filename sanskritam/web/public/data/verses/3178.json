[{"id": 2101200, "chapter_id": 3178, "verse_number": "१४-३४-१", "content_sanskrit": "ब्राह्मण उवाच।\nनाहं तथा भूरु चरामि लोके\nयथा त्वं मां तर्जयसे स्वबुद्ध्या।\nविप्रोस्मिं मुक्तोस्मि वनेचरोस्मि\nगृहस्थधर्मा व्रतवांस्तथाऽस्मि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2101201, "chapter_id": 3178, "verse_number": "१४-३४-२", "content_sanskrit": "नाहमस्मि यता मां त्वं पश्यसे च शुभाशुभे।\nमया व्याप्तमिदं सर्वं यत्किञ्चिज्जगतीगतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2101202, "chapter_id": 3178, "verse_number": "१४-३४-३", "content_sanskrit": "ये केचिज्जन्तवो लोके जङ्गमाः स्थावराश्च ह।\nतेषां मामन्तकं विद्धि दारुणामिव पावकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2101203, "chapter_id": 3178, "verse_number": "१४-३४-४", "content_sanskrit": "राज्ये पृथिव्यां सर्वस्यामथवापि त्रिविष्टपे।\nतथा बुद्धिरियं वेत्ति बुद्धिरेव धनं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2101204, "chapter_id": 3178, "verse_number": "१४-३४-५", "content_sanskrit": "एकः पन्था ब्राह्मणानां येन गच्छन्ति तद्विदः।\nगृहेषु वनवासेषु गुरुवासेषु भिक्षुषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2101205, "chapter_id": 3178, "verse_number": "१४-३४-६", "content_sanskrit": "लिङ्गैर्बहुभिरव्यग्रैरेका बुद्धिरुपास्यते।\nनानालिङ्गाश्रमस्थानां येषां बुद्धिः शमात्मिका॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2101206, "chapter_id": 3178, "verse_number": "१४-३४-७", "content_sanskrit": "ते भावमेकमायान्ति सरितः सागरं यथा।\nबुद्ध्याऽयं गम्यते मार्गः शरीरेणि न गम्यते।\nआद्यन्तवन्ति कर्माणि शरीरं कर्मबन्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2101207, "chapter_id": 3178, "verse_number": "१४-३४-८", "content_sanskrit": "तस्मान्मे सुभगे नास्ति परलोककृतं भयम्।\nतद्भावभावनिरता ममैवात्मानमेष्यसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2101208, "chapter_id": 3178, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि चतुस्त्रिंशोऽध्यायः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]