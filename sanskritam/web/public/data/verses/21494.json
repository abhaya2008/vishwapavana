[{"id": 7001494000, "chapter_id": 21494, "verse_number": "७-२-३२-१", "content_sanskrit": "उपमन्युरुवाच ।\nएतत्ते कथितं कृष्ण कर्मेहामुत्र सिद्धिदम् ।\nक्रियातपोजपध्यानसमुच्चयमयं परम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001494001, "chapter_id": 21494, "verse_number": "७-२-३२-२", "content_sanskrit": "अथ वक्ष्यामि शैवानामिहैव फलदं नृणाम् ।\nपूजाहोमजपध्यानतपोदानमयं महत्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001494002, "chapter_id": 21494, "verse_number": "७-२-३२-३", "content_sanskrit": "तत्र संसाधयेत्पूर्वं मन्त्रं मन्त्रार्थवित्तमः ।\nदृष्टसिद्धिकरं कर्म नान्यथा फलदं यतः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001494003, "chapter_id": 21494, "verse_number": "७-२-३२-४", "content_sanskrit": "सिद्धमन्त्रो ऽप्यदृष्टेन प्रबलेन तु केनचित् ।\nप्रतिबन्धफलं कर्म न कुर्यात्सहसा बुधः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001494004, "chapter_id": 21494, "verse_number": "७-२-३२-५", "content_sanskrit": "तस्य तु प्रतिबन्धस्य कर्तुं शक्येह निष्कृतिः ।\nपरीक्ष्य शकुनाद्यैस्तदादौ निष्कृतिमाचरेत्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001494005, "chapter_id": 21494, "verse_number": "७-२-३२-६", "content_sanskrit": "यो ऽन्यथा कुरुते मोहात्कर्मैहिकफलं नरः ।\nन तेन फलभाक्स स्यात्प्राप्नुयाच्चोपहास्यताम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001494006, "chapter_id": 21494, "verse_number": "७-२-३२-७", "content_sanskrit": "अबिस्रब्धो न कुर्वीत कर्म दृष्टफलं क्वचित् ।\nस खल्वश्रद्धधानः स्यान्नाश्रद्धः फलमृच्छति॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001494007, "chapter_id": 21494, "verse_number": "७-२-३२-८", "content_sanskrit": "नापराधोस्ति देवस्य कर्मण्यपि तु निष्फले ।\nयथोक्तकारिणां पुंसामिहैव फलदर्शनात्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001494008, "chapter_id": 21494, "verse_number": "७-२-३२-९", "content_sanskrit": "साधकः सिद्धमंत्रश्च निरस्तप्रतिबंधकः ।\nविश्वस्तः श्रद्धधानश्च कुर्वन्नाप्नोति तत्फलम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001494009, "chapter_id": 21494, "verse_number": "७-२-३२-१०", "content_sanskrit": "अथवा तत्फलावाप्त्यै ब्रह्मचर्यरतो भवेत् ।\nरात्रौ हविष्यमश्नीयात्पायसं वा फलानि वा॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001494010, "chapter_id": 21494, "verse_number": "७-२-३२-११", "content_sanskrit": "हिंसादि यन्निषिद्धं स्यान्न कुर्यान्मनसापि तत् ।\nसदा भस्मानुलिप्तां गस्सुवेषश्च शुचिर्भवेत्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001494011, "chapter_id": 21494, "verse_number": "७-२-३२-१२", "content_sanskrit": "इत्थमाचारवान्भूत्वा स्वानुकूले शुभे ऽहनि ।\nपूर्वोक्तलक्षणे देशे पुष्पदामाद्यलंकृते॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001494012, "chapter_id": 21494, "verse_number": "७-२-३२-१३", "content_sanskrit": "आलिप्य शकृता १ भूमिं हस्तमानावरां यथा ।\nविलिखेत्कमले भद्रे दीप्यमानं स्वतेजसा॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001494013, "chapter_id": 21494, "verse_number": "७-२-३२-१४", "content_sanskrit": "तप्तजांबूनदमयमष्टपत्रं सकेसरम् ।\nमध्ये कर्णिकया युक्तं सर्वरत्नैरलंकृतम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001494014, "chapter_id": 21494, "verse_number": "७-२-३२-१५", "content_sanskrit": "स्वाकारसदृशेनैव नालेन च समन्वितम् ।\nतादृशे स्वर्णनिर्माणे कंदे सम्यग्विधानतः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001494015, "chapter_id": 21494, "verse_number": "७-२-३२-१६", "content_sanskrit": "तत्राणिमादिकं सर्वं संकल्प्य मनसा पुनः ।\nरत्नजं वाथ सौवर्णं स्फटिकं वा सलक्षणम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001494016, "chapter_id": 21494, "verse_number": "७-२-३२-१७", "content_sanskrit": "लिङ्गं सवेदिकं चैव स्थापयित्वा विधानतः ।\nतत्रावाह्य यजेद्देवं सांबं सगणमव्ययम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001494017, "chapter_id": 21494, "verse_number": "७-२-३२-१८", "content_sanskrit": "तत्र माहेश्वरी कल्प्या मूर्तिर्मूर्तिमतः प्रभोः ।\nचतुर्भुजा चतुर्वक्त्रा सर्वाभरणभूषिता॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001494018, "chapter_id": 21494, "verse_number": "७-२-३२-१९", "content_sanskrit": "शार्दूलचर्मवसना किंचिद्विहसितानना ।\nवरदाभयहस्ता च मृगटंकधरा तथा॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001494019, "chapter_id": 21494, "verse_number": "७-२-३२-२०", "content_sanskrit": "अथ वाष्टभुजा चिंत्या चिंतकस्य यथारुचि ।\nतदा त्रिशूलपरशुखड्गवज्राणि दक्षिणे॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001494020, "chapter_id": 21494, "verse_number": "७-२-३२-२१", "content_sanskrit": "वामे पाशांकुशौ तद्वत्खेटं नागं च बिभ्रती ।\nबालार्कसदृशप्रख्या प्रतिवक्त्रं त्रिलोचना॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001494021, "chapter_id": 21494, "verse_number": "७-२-३२-२२", "content_sanskrit": "तस्याः पूर्वमुखं सौम्यं स्वाकारसदृशप्रभम् ।\nदक्षिणं नीलजीमूतसदृशं घोरदर्शनम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001494022, "chapter_id": 21494, "verse_number": "७-२-३२-२३", "content_sanskrit": "उत्तरं विद्रुमप्रख्यं नीलालकविभूषितम् ।\nपश्चिमं पूर्णचंद्राभं सौम्यमिंदुकलाधरम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001494023, "chapter_id": 21494, "verse_number": "७-२-३२-२४", "content_sanskrit": "तदंकमंडलारूढा शक्तिर्माहेश्वरी परा ।\nमहालक्ष्मीरिति ख्याता श्यामा सर्वमनोहरा॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001494024, "chapter_id": 21494, "verse_number": "७-२-३२-२५", "content_sanskrit": "मूर्तिं कृत्वैवमाकारां सकलीकृत्य च क्रमात् ।\nमूर्तिमंतमथावाह्य यजेत्परमकारणम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001494025, "chapter_id": 21494, "verse_number": "७-२-३२-२६", "content_sanskrit": "स्नानार्थे कल्पयेत्तत्र पञ्चगव्यं तु कापिलम् ।\nपञ्चामृतं च पूर्णानि बीजानि च विशेषतः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001494026, "chapter_id": 21494, "verse_number": "७-२-३२-२७", "content_sanskrit": "पुरस्तान्मण्डलं कृत्वा रत्नचूर्णाद्यलंकृतम् ।\nकर्णिकायां प्रविन्यस्येदीशानकलशं पुनः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001494027, "chapter_id": 21494, "verse_number": "७-२-३२-२८", "content_sanskrit": "सद्यादिकलशान्पश्चात्परितस्तस्य कल्पयेत् ।\nततो विद्येशकलशानष्टौ पूर्वादिवत्क्रमात्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001494028, "chapter_id": 21494, "verse_number": "७-२-३२-२९", "content_sanskrit": "तीर्थाम्बुपूरितान्कृत्वा सूत्रेणावेष्ट्य पूर्ववत् ।\nपुण्यद्रव्याणि निक्षिप्य समन्त्रं सविधानकम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001494029, "chapter_id": 21494, "verse_number": "७-२-३२-३०", "content_sanskrit": "दुकूलाद्येन वस्त्रेण समाच्छाद्य समंततः ।\nसर्वत्र मंत्रं विन्यस्य तत्तन्मंत्रपुरस्सरम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001494030, "chapter_id": 21494, "verse_number": "७-२-३२-३१", "content_sanskrit": "स्नानकाले तु संप्राप्ते सर्वमङ्गलनिस्वनैः ।\nपञ्चगव्यादिभिश्चैव स्नापयेत्परमेश्वरम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001494031, "chapter_id": 21494, "verse_number": "७-२-३२-३२", "content_sanskrit": "ततः कुशोदकाद्यानि स्वर्णरत्नोदकान्यपि ।\nगंधपुष्पादिसिद्धानि मन्त्रसिद्धानि च क्रमात्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001494032, "chapter_id": 21494, "verse_number": "७-२-३२-३३", "content_sanskrit": "उद्धृत्योद्धृत्य मन्त्रेण तैस्तैस्स्नाप्य महेश्वरम् ।\nगंधं पुष्पादिदीपांश्च पूजाकर्म समाचरेत्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001494033, "chapter_id": 21494, "verse_number": "७-२-३२-३४", "content_sanskrit": "पलावरः स्यादालेप एकादशपलोत्तरः ।\nसुवर्णरत्नपुष्पाणि शुभानि सुरभीणि च॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001494034, "chapter_id": 21494, "verse_number": "७-२-३२-३५", "content_sanskrit": "नीलोत्पलाद्युत्पलानि बिल्वपत्राण्यनेकशः ।\nकमलानि च रक्तानि श्वेतान्यपि च शंभवे॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001494035, "chapter_id": 21494, "verse_number": "७-२-३२-३६", "content_sanskrit": "कृष्णागुरूद्भवो धूपः सकर्पूराज्यगुग्गुलः ।\nकपिलाघृतसंसिद्धा दीपाः कर्पूरवर्तिजाः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001494036, "chapter_id": 21494, "verse_number": "७-२-३२-३७", "content_sanskrit": "पञ्चब्रह्मषडंगानि पूज्यान्यावरणानि च ।\nनैवेद्यः पयसा सिद्धः स गुडाज्यो महाचरुः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001494037, "chapter_id": 21494, "verse_number": "७-२-३२-३८", "content_sanskrit": "पाटलोत्पलपद्माद्यैः पानीयं च सुगन्धितम् ।\nपञ्चसौगंधिकोपेतं तांबूलं च सुसंस्कृतम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001494038, "chapter_id": 21494, "verse_number": "७-२-३२-३९", "content_sanskrit": "सुवर्णरत्नसिद्धानि भूषणानि विशेषतः ।\nवासांसि च विचित्राणि सूक्ष्माणि च नवानि च॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001494039, "chapter_id": 21494, "verse_number": "७-२-३२-४०", "content_sanskrit": "दर्शनीयानि देयानि गानवाद्यादिभिस्सह ।\nजपश्च मूलमंत्रस्य लक्षः परमसंख्यया॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001494040, "chapter_id": 21494, "verse_number": "७-२-३२-४१", "content_sanskrit": "एकावरा त्र्युत्तरा च पूजा फलवशादिह ।\nदशसंख्यावरो होमः प्रतिद्रव्यं शतोत्तरः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001494041, "chapter_id": 21494, "verse_number": "७-२-३२-४२", "content_sanskrit": "घोररूपश्शिवश्चिंत्यो मारणोच्चाटनादिषु ।\nशिवलिंगे शिवाग्नौ च ह्यन्यासु प्रतिमासु च॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001494042, "chapter_id": 21494, "verse_number": "७-२-३२-४३", "content_sanskrit": "चिंत्यस्सौम्यतनुश्शंभुः कार्ये शांतिकपौष्टिके ।\nआयसौ स्रुक्स्रुवौ कार्यौ मारणादिषु कर्मसु॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001494043, "chapter_id": 21494, "verse_number": "७-२-३२-४४", "content_sanskrit": "तदन्यत्र तु सौवर्णौ शांतिकाद्येषु कृत्स्नशः ।\nदूर्वया घृतगोक्षीरमिश्रया मधुना तथा॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001494044, "chapter_id": 21494, "verse_number": "७-२-३२-४५", "content_sanskrit": "चरुणा सघृतेनैव केवलं पयसापि वा ।\nजुहुयान्मृत्युविजये तिलै रोगोपशांतये॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001494045, "chapter_id": 21494, "verse_number": "७-२-३२-४६", "content_sanskrit": "घृतेन पयसा चैव कमलैर्वाथ केवलैः ।\nसमृद्धिकामो जुहुयान्महादारिद्र्यशांतये॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001494046, "chapter_id": 21494, "verse_number": "७-२-३२-४७", "content_sanskrit": "जातीपुष्पेण वश्यार्थी जुहुयात्सघृतेन तु ।\nघृतेन करवीरैश्च कुर्यादाकर्षणं द्विजः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001494047, "chapter_id": 21494, "verse_number": "७-२-३२-४८", "content_sanskrit": "तैलेनोच्चाटनं कुर्यात्स्तंभनं मधुना पुनः ।\nस्तंभनं सर्षपेणापि लशुनेन तु पातनम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001494048, "chapter_id": 21494, "verse_number": "७-२-३२-४९", "content_sanskrit": "ताडनं रुधिरेण स्यात्खरस्योष्ट्रस्य चोभयोः ।\nमारणोच्चाटने कुर्याद्रोहिबीजैस्तिलान्वितैः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001494049, "chapter_id": 21494, "verse_number": "७-२-३२-५०", "content_sanskrit": "विद्वेषणं च तैलेन कुर्याल्लांगलकस्य तु ।\nबंधनं रोहिबीजेन सेनास्तंभनमेव च॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001494050, "chapter_id": 21494, "verse_number": "७-२-३२-५१", "content_sanskrit": "रक्तसर्षपसंमिश्रैर्होमद्रव्यैरशेषतः ।\nहस्तयंत्रोद्भवैस्तैलैर्जुहुयादाभिचारिके॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001494051, "chapter_id": 21494, "verse_number": "७-२-३२-५२", "content_sanskrit": "कटुकीतुषसंयुक्तैः कार्पासास्थिभिरेव च ।\nसर्षपैस्तैलसंमिश्रैर्जुहुयादाभिचारिके॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001494052, "chapter_id": 21494, "verse_number": "७-२-३२-५३", "content_sanskrit": "ज्वरोपशांतिदं क्षीरं सौभाग्यफलदं तथा ।\nसर्वसिद्धिकरो होमः क्षौद्राज्यदधिभिर्युतैः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001494053, "chapter_id": 21494, "verse_number": "७-२-३२-५४", "content_sanskrit": "क्षीरेण तंदुलैश्चैव चरुणा केवलेन वा ।\nशांतिकं पौष्टिकं वापि सप्तभिः समिदादिभिः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001494054, "chapter_id": 21494, "verse_number": "७-२-३२-५५", "content_sanskrit": "द्रव्यैर्विशेषतो होमे वश्यमाकर्षणं तथा ।\nवश्यमाकर्षणं चैव श्रीपदं च विशेषतः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001494055, "chapter_id": 21494, "verse_number": "७-२-३२-५६", "content_sanskrit": "बिल्वपत्रैस्तु हवनं शत्रोर्विजयदं तथा ।\nसमिधः शांतिकार्येषु पालाशखदिरादिकाः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001494056, "chapter_id": 21494, "verse_number": "७-२-३२-५७", "content_sanskrit": "करवीरार्कजाः क्रौर्ये कण्टकिन्यश्च विग्रहे ।\nप्रशांतः शांतिकं कुर्यात्पौष्टिकं च विशेषतः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001494057, "chapter_id": 21494, "verse_number": "७-२-३२-५८", "content_sanskrit": "निर्घृणः क्रुद्धचित्तस्तु प्रकुर्यादाभिचारिकम् ।\nअतीवदुरवस्थायां प्रतीकारांतरं न चेत्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001494058, "chapter_id": 21494, "verse_number": "७-२-३२-५९", "content_sanskrit": "आततायिनमुद्दिश्य प्रकुर्यादाभिचारिकम् ।\nस्वराष्ट्रपतिमुद्दिश्य न कुर्यादाभिचारिकम्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001494059, "chapter_id": 21494, "verse_number": "७-२-३२-६०", "content_sanskrit": "यद्यास्तिकस्सुधर्मिष्ठो मान्यो वा यो ऽपि कोपि वा ।\nतमुद्दिश्यापि नो कुर्यादाततायिनमप्युत॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001494060, "chapter_id": 21494, "verse_number": "७-२-३२-६१", "content_sanskrit": "मनसा कर्मणा वाचा यो ऽपि कोपि शिवाश्रितः ।\nस्वराष्ट्रपतिमुद्दिश्य शिवा श्रितमथापि वा॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001494061, "chapter_id": 21494, "verse_number": "७-२-३२-६२", "content_sanskrit": "कृत्वाभिचारिकं कर्म सद्यो विनिपतेन्नरः ।\nस्वराष्ट्रपालकं तस्माच्छिवभक्तं च कञ्चन॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001494062, "chapter_id": 21494, "verse_number": "७-२-३२-६३", "content_sanskrit": "न हिंस्यादभिचाराद्यैर्यदीच्छेत्सुखमात्मनः ।\nअन्यं कमपि चोद्दिश्य कृत्वा वै मारणादिकम्॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001494063, "chapter_id": 21494, "verse_number": "७-२-३२-६४", "content_sanskrit": "पश्चात्तापेन संयुक्तः प्रायश्चित्तं समाचरेत् ।\nबाणलिंगे ऽपि वा कुर्यान्निर्धनो धनवानपि॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001494064, "chapter_id": 21494, "verse_number": "७-२-३२-६५", "content_sanskrit": "स्वयंभूते ऽथ वा लिंगे आर्षके वैदिके ऽपि वा ।\nअभावे हेमरत्नानामशक्तौ च तदर्जने॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001494065, "chapter_id": 21494, "verse_number": "७-२-३२-६६", "content_sanskrit": "मनसैवाचरेदेतद्द्रव्यैर्वा प्रतिरूपकैः ।\nक्वचिदंशे तु यः शक्तस्त्वशक्तः क्वचिदंशके॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001494066, "chapter_id": 21494, "verse_number": "७-२-३२-६७", "content_sanskrit": "सो ऽपि शक्त्यनुसारेण कुर्वंश्चेत्फलमृच्छति ।\nकर्मण्यनुष्ठिते ऽप्यस्मिन्फलं यत्र न दृश्यते॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001494067, "chapter_id": 21494, "verse_number": "७-२-३२-६८", "content_sanskrit": "द्विस्त्रिर्वावर्तयेत्तत्र सर्वथा दृश्यते फलम् ।\nपूजोपयुक्तं यद्द्रव्यं हेमरत्नाद्यनुत्तमम्॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001494068, "chapter_id": 21494, "verse_number": "७-२-३२-६९", "content_sanskrit": "तत्सर्वं गुरवे दद्याद्दक्षिणां च ततः पृथक् ।\nस चेन्नेच्छति तत्सर्वं शिवाय विनिवेदयेत्॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001494069, "chapter_id": 21494, "verse_number": "७-२-३२-७०", "content_sanskrit": "अथवा शिवभक्तेभ्यो नान्येभ्यस्तु प्रदीयते ।\nयः स्वयं साधयेच्छक्त्या गुर्वादिनिरपेक्षया॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001494070, "chapter_id": 21494, "verse_number": "७-२-३२-७१", "content_sanskrit": "सो ऽप्येवमाचरेदत्र न गृह्णीयात्स्वयं पुनः ।\nस्वयं गृह्णाति यो लोभात्पूजांगद्रव्यमुत्तमम्॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001494071, "chapter_id": 21494, "verse_number": "७-२-३२-७२", "content_sanskrit": "कांक्षितं न लभेन्मूढो नात्र कार्या विचारणा ।\nअर्चितं यत्तु तल्लिंगं गृह्णीयाद्वा नवा स्वयम्॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001494072, "chapter_id": 21494, "verse_number": "७-२-३२-७३", "content_sanskrit": "गृह्णीयाद्यदि तन्नित्यं स्वयं वान्यो ऽपि वार्चयेत् ।\nयथोक्तमेव कर्मैतदाचरेद्यो ऽनपायतः॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001494073, "chapter_id": 21494, "verse_number": "७-२-३२-७४", "content_sanskrit": "फलं व्यभिचरेन्नैवमित्यतः किं प्ररोचकम् ।\nतथाप्युद्देशतो वक्ष्ये कर्मणः सिद्धिमुत्तमम्॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001494074, "chapter_id": 21494, "verse_number": "७-२-३२-७५", "content_sanskrit": "अपि शत्रुभिराक्रांतो व्याधिभिर्वाप्यनेकशः ।\nमृत्योरास्यगतश्चापि मुच्यते निरपायतः॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001494075, "chapter_id": 21494, "verse_number": "७-२-३२-७६", "content_sanskrit": "पूजायते ऽतिकृपणो रिक्तो वैश्रवणायते ।\nकामायते विरूपो ऽपि वृद्धो ऽपि तरुणायते॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001494076, "chapter_id": 21494, "verse_number": "७-२-३२-७७", "content_sanskrit": "शत्रुर्मित्रायते सद्यो विरोधी किंकरायते ।\nविषायते यदमृतं विषमप्यमृतायते॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001494077, "chapter_id": 21494, "verse_number": "७-२-३२-७८", "content_sanskrit": "स्थलायते समुद्रो ऽपि स्थलमप्यर्णवायते ।\nमहीधरायते श्वभ्रं स च श्वभ्रायते गिरिः॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001494078, "chapter_id": 21494, "verse_number": "७-२-३२-७९", "content_sanskrit": "पद्माकरायते वह्निः सरो वैश्वानरायते ।\nवनायते यदुद्यानं तदुद्यानायते वनम्॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001494079, "chapter_id": 21494, "verse_number": "७-२-३२-८०", "content_sanskrit": "सिंहायते मृगः क्षुद्रः सिंहः क्रीडामृगायते ।\nस्त्रियो ऽभिसारिकायन्ते लक्ष्मीः सुचरितायते॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001494080, "chapter_id": 21494, "verse_number": "७-२-३२-८१", "content_sanskrit": "स्वैरप्रेष्यायते वाणी कीर्तिस्तु गणिकायते ।\nस्वैराचारायते मेधा वज्रसूचीयते मनः॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001494081, "chapter_id": 21494, "verse_number": "७-२-३२-८२", "content_sanskrit": "महावातायते शक्तिर्बलं मत्तगजायते ।\nस्तम्भायते समुद्योगैः शत्रुपक्षे स्थिता क्रिया॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001494082, "chapter_id": 21494, "verse_number": "७-२-३२-८३", "content_sanskrit": "शत्रुपक्षायते ऽरीणां सर्व एव सुहृज्जनः ।\nशत्रवः कुणपायन्ते जीवन्तोपि सबांधवाः॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7001494083, "chapter_id": 21494, "verse_number": "७-२-३२-८४", "content_sanskrit": "आपन्नो ऽपि गतारिष्टः स्वयं खल्वमृतायते ।\nरसाय नायते नित्यमपथ्यमपि सेवितम्॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7001494084, "chapter_id": 21494, "verse_number": "७-२-३२-८५", "content_sanskrit": "अनिशं क्रियमाणापि रतिस्त्वभिनवायते ।\nअनागतादिकं सर्वं करस्थामलकायते॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7001494085, "chapter_id": 21494, "verse_number": "७-२-३२-८६", "content_sanskrit": "यादृच्छिकफलायन्ते सिद्धयो ऽप्यणिमादयः ।\nबहुनात्र किमुक्तेन सर्वकामार्थसिद्धिषु॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7001494086, "chapter_id": 21494, "verse_number": "७-२-३२-८७", "content_sanskrit": "अस्मिन्कर्मणि निर्वृत्ते त्वनवाप्यं न विद्यते॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}]