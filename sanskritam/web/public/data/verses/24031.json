[{"id": 7004031000, "chapter_id": 24031, "verse_number": "३-३-२-१", "content_sanskrit": "सूत उवाच ।\nअथान्यदपि वक्ष्यामि माहात्म्यं त्रिपुरद्विषः ।\nश्रुतमात्रेण येनाशु च्छिद्यंते सर्वसंशयाः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004031001, "chapter_id": 24031, "verse_number": "३-३-२-२", "content_sanskrit": "अतः परतरं नास्ति किंचित्पापविशोधनम् ।\nसर्वानंदकरं श्रीमत्सर्वकामार्थसाधम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004031002, "chapter_id": 24031, "verse_number": "३-३-२-३", "content_sanskrit": "दीर्घायुर्विजयारोग्यभुक्तिमुक्तिफलप्रदम् ।\nयदनन्येन भावेन महे शाराधनं परम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004031003, "chapter_id": 24031, "verse_number": "३-३-२-४", "content_sanskrit": "आर्द्राणामपि शुष्काणामल्पानां महतामपि ।\nएतदेव विनिर्दिष्टं प्रायश्चितमथोत्तमम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004031004, "chapter_id": 24031, "verse_number": "३-३-२-५", "content_sanskrit": "सर्वकालेऽप्यभेद्यानामघानां क्षयकारणम् ।\nमहामुनिविनिर्दिष्टैः प्रायश्चित्तैरथोत्तमैः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004031005, "chapter_id": 24031, "verse_number": "३-३-२-६", "content_sanskrit": "इयमेव परं श्रेयः सर्वशास्त्रविनिश्चितम् ।\nयद्भक्त्या परमेशस्य पूजनं परमो दयम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004031006, "chapter_id": 24031, "verse_number": "३-३-२-७", "content_sanskrit": "जानताऽजानता वापि येन केनापि हेतुना ।\nयत्किंचिपि देवाय कृतं कर्म विमुक्तिदम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004031007, "chapter_id": 24031, "verse_number": "३-३-२-८", "content_sanskrit": "माघे कृष्णचतुर्द्दश्यामुपवासोऽति दुर्लभः ।\nतत्रापि दुर्लभं मन्ये रात्रौ जागरणं नृणाम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004031008, "chapter_id": 24031, "verse_number": "३-३-२-९", "content_sanskrit": "अतीव दुर्लभं मन्ये शिवलिंगस्य दर्शनम् ।\nसुदुर्लभतरं मन्ये पूजनं परमेशितुः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004031009, "chapter_id": 24031, "verse_number": "३-३-२-१०", "content_sanskrit": "भवकोटिशतोत्पन्नषुण्यराशिविपाकतः ।\nलभ्यते वा पुनस्तत्र बिल्वपत्रार्चनं विभोः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004031010, "chapter_id": 24031, "verse_number": "३-३-२-११", "content_sanskrit": "वर्षाणामयुतं येन स्नातं गंगासरिज्जले ।\nसकृद्बिल्वार्चनेनैव तत्फलं लभते नरः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004031011, "chapter_id": 24031, "verse_number": "३-३-२-१२", "content_sanskrit": "यानियानि तु पुण्यानि लीनानीह युगेयुगे ।\nमाघेऽसितचतुर्दश्यां तानि तिष्ठंति कृत्स्नशः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004031012, "chapter_id": 24031, "verse_number": "३-३-२-१३", "content_sanskrit": "एतामेव प्रशंसंति लोके ब्रह्मादयः सुराः ।\nमुनयश्च वशिष्ठाद्या माघेऽसितचतुर्दशीम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004031013, "chapter_id": 24031, "verse_number": "३-३-२-१४", "content_sanskrit": "अत्रोपवासः केनापि कृतः क्रतुशताधिकैः ।\nरात्रौ जागरणं पुण्यं कल्पकोटितपोऽधिकम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004031014, "chapter_id": 24031, "verse_number": "३-३-२-१५", "content_sanskrit": "एकेन बिल्वपत्रेण शिवलिंगार्चनं कृतम् ।\nत्रैलोक्ये तस्य पुण्यस्य को वा सादृश्यमिच्छति॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004031015, "chapter_id": 24031, "verse_number": "३-३-२-१६", "content_sanskrit": "अत्रानुवर्ण्यते गाथा पुण्या परमशोभना ।\nगोपनीयापि कारुण्याद्गौतमेन प्रकाशिता॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004031016, "chapter_id": 24031, "verse_number": "३-३-२-१७", "content_sanskrit": "इक्ष्वाकुवंशजः श्रीमान्राजा परम धार्मिकः ।\nआसीन्मित्रसहोनाम श्रेष्ठः सर्वधनुर्भृताम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004031017, "chapter_id": 24031, "verse_number": "३-३-२-१८", "content_sanskrit": "स राजा सकलास्त्रज्ञः शास्त्रज्ञः श्रुतिपारगः ।\nवीरोऽत्यंतबलोत्साहो नित्योद्योगी दयानिधिः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004031018, "chapter_id": 24031, "verse_number": "३-३-२-१९", "content_sanskrit": "पुण्यानामिव संघातस्तेजसामिव पंजरः ।\nआश्चर्याणामिव क्षेत्रं यस्य मूर्तिर्विराजते॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004031019, "chapter_id": 24031, "verse_number": "३-३-२-२०", "content_sanskrit": "हृदयं दययाक्रांतं श्रियाक्रांतं च तद्वपुः ।\nचरणौ यस्य सामंतचूडामणिमरीचिभिः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004031020, "chapter_id": 24031, "verse_number": "३-३-२-२१", "content_sanskrit": "एकदा मृगयाकेलिलोलुपः स महीपतिः ।\nविवेश गह्वरं घोरं बलेन महतावृतः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004031021, "chapter_id": 24031, "verse_number": "३-३-२-२२", "content_sanskrit": "तत्र विव्याध विशिखैः शार्दूलान्गवयान्मृगान् ।\nरुरून्वराहान्महिषान्मृगेंद्रानपि भूरिशः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004031022, "chapter_id": 24031, "verse_number": "३-३-२-२३", "content_sanskrit": "स रथी मृगयासक्तो गहनं दंशित श्चरन् ।\nकमपि ज्वलनाकारं निजघान निशाचरम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004031023, "chapter_id": 24031, "verse_number": "३-३-२-२४", "content_sanskrit": "तस्यानुजः शुचाविष्टो दृष्ट्वा दूरे तिरोहितः ।\nभ्रातरं निहतं दृष्ट्वा चिंतयामास चेतसा॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004031024, "chapter_id": 24031, "verse_number": "३-३-२-२५", "content_sanskrit": "नन्वेष राजा दुर्द्धर्षो देवानां रक्षसामपि ।\nछद्मनैव प्रजेतव्यो मम शत्रुर्न चान्यथा॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004031025, "chapter_id": 24031, "verse_number": "३-३-२-२६", "content_sanskrit": "इति व्यवसितः पापो राक्षसो मनुजाकृतिः ।\nआससाद नृपश्रेष्ठमुत्पात इव मूर्तिमान्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004031026, "chapter_id": 24031, "verse_number": "३-३-२-२७", "content_sanskrit": "तं विनम्राकृतिं दृष्ट्वा भृत्यतां कर्तुमागतम् ।\nचक्रे महानसाध्यक्षमज्ञानात्स महीपतिः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004031027, "chapter_id": 24031, "verse_number": "३-३-२-२८", "content_sanskrit": "अथ तस्मिन्वने राजा किंचित्कालं विहृत्य सः ।\nनिवृत्तो मृगयां हित्वा स्वपुरीं पुनराययौ॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004031028, "chapter_id": 24031, "verse_number": "३-३-२-२९", "content_sanskrit": "तस्य राजेंद्रमुख्यस्य मदयंतीतिनामतः ।\nदमयन्ती नलस्येव विदिता वल्लभा सती॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004031029, "chapter_id": 24031, "verse_number": "३-३-२-३०", "content_sanskrit": "एतस्मिन्समये राजा निमंत्र्य मुनिपुंगवम् ।\nवशिष्ठं गृहमानिन्ये संप्राप्ते पितृवासरे॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004031030, "chapter_id": 24031, "verse_number": "३-३-२-३१", "content_sanskrit": "रक्षसा सूदरूपेण संमिश्रितनरामिषम् ।\nशाकामिषं पुरः क्षिप्तं दृष्ट्वा गुरुरथाब्रवीत्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004031031, "chapter_id": 24031, "verse_number": "३-३-२-३२", "content_sanskrit": "धिग्धिङ्नरामिषं राजं स्त्वयैतच्छद्मकारिणा ।\nखलेनोपहृतं मेऽद्य अतो रक्षो भविष्यसि॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004031032, "chapter_id": 24031, "verse_number": "३-३-२-३३", "content_sanskrit": "रक्षःकृतमविज्ञाय शप्त्वैवं स गुरुस्ततः ।\nपुनर्विमृश्य तं शापं चकार द्वादशाब्दिकम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004031033, "chapter_id": 24031, "verse_number": "३-३-२-३४", "content_sanskrit": "राजापि कोपितः प्राह यदिदं मे न चेष्टितम् ।\nन ज्ञातं च वृथा शप्तो गुरुं चैव शपाम्यहम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004031034, "chapter_id": 24031, "verse_number": "३-३-२-३५", "content_sanskrit": "इत्यपोंजलिनादाय गुरुं शप्तुं समुद्यतः ।\nपतित्वा पादयोस्तस्य मदयन्ती न्यवारयत्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004031035, "chapter_id": 24031, "verse_number": "३-३-२-३६", "content_sanskrit": "ततो निवृत्तः शापाच्च तस्या वचनगौरवात् ।\nतत्याज पादयोरंभः पादौ कल्मषतां गतौ॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004031036, "chapter_id": 24031, "verse_number": "३-३-२-३७", "content_sanskrit": "कल्मषांघ्रिरिति ख्यातस्ततः प्रभृति पार्थिवः ।\nबभूव गुरुशापेन राक्षसो वनगोचरः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004031037, "chapter_id": 24031, "verse_number": "३-३-२-३८", "content_sanskrit": "स बिभ्रद्राक्षसं रूपं घोरं कालां तकोपमम् ।\nचखाद विविधाञ्जंतून्मानुषादीन्वनेचरः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004031038, "chapter_id": 24031, "verse_number": "३-३-२-३९", "content_sanskrit": "स कदाचिद्वने क्वापि रममाणौ किशोरकौ ।\nअपश्यदंतकाकारो नवोढौ मुनिदंपती॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004031039, "chapter_id": 24031, "verse_number": "३-३-२-४०", "content_sanskrit": "राक्षसो मानुषाहारः किशोरमुनिनंदनम् ।\nजग्धुं जग्राह शापार्तो व्याघ्रो मृगशिशुं यथा॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004031040, "chapter_id": 24031, "verse_number": "३-३-२-४१", "content_sanskrit": "रक्षोगृहीतं भर्तारं दृष्ट्वा भीताथ तत्प्रिया ।\nउवाच करुणं बाला क्रंदंती भृशवेपिता॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004031041, "chapter_id": 24031, "verse_number": "३-३-२-४२", "content_sanskrit": "भोभो मामा कृथाः पापं सूर्यवंशयशोधर ।\nमदयंतीपतिस्त्वं हि राजेंद्रो न तु राक्षसः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004031042, "chapter_id": 24031, "verse_number": "३-३-२-४३", "content_sanskrit": "न खाद मम भर्त्तारं प्राणात्प्रियतमं प्रभो ।\nआर्त्तानां शरणार्त्तानां त्वमेव हि यतो गतिः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004031043, "chapter_id": 24031, "verse_number": "३-३-२-४४", "content_sanskrit": "पापानामिव संघातैः किं मे दुष्टैर्जडासुभिः ।\nदेहेन चातिभारेण विना भर्त्रा महात्मना॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004031044, "chapter_id": 24031, "verse_number": "३-३-२-४५", "content_sanskrit": "मलीमसेन पापेन पांचभौतेन किं सुखम् ।\nबालोयं वेदविच्छांतस्तपस्वी बहुशास्त्रवित्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004031045, "chapter_id": 24031, "verse_number": "३-३-२-४६", "content_sanskrit": "अतोऽस्य प्राणदानेन जगद्रक्षा त्वया कृता ।\nकृपां कुरु महाराज बालायां ब्राह्मणस्त्रियाम्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004031046, "chapter_id": 24031, "verse_number": "३-३-२-४७", "content_sanskrit": "अनाथकृपणार्तेषु सघृणाः खलु साधवः॥ ॥  ।\nइत्थमभ्यर्थितः सोऽपि पुरुषादः स निर्घृणः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004031047, "chapter_id": 24031, "verse_number": "३-३-२-४८", "content_sanskrit": "चखाद शिर उत्कृत्य विप्रपुत्रं दुराशयः ।\nअथ साध्वी कृशा दीना विलप्य भृशदुःखिता॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004031048, "chapter_id": 24031, "verse_number": "३-३-२-४९", "content_sanskrit": "आहृत्य भर्तुरस्थीनि चितां चक्रे तथोल्बणाम् ।\nभर्तारमनुगच्छंती संविशंती हुताशनम्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004031049, "chapter_id": 24031, "verse_number": "३-३-२-५०", "content_sanskrit": "राजानं राक्षसाकारं शापास्त्रेण जघान तम् ।\nरेरे पार्थिव पापात्मंस्त्वया मे भक्षितः पतिः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004031050, "chapter_id": 24031, "verse_number": "३-३-२-५१", "content_sanskrit": "अतः पतिव्रतायास्त्वं शापं भुंक्ष्व यथोल्बणम् ।\nअद्यप्रभृति नारीषु यदा त्वमपि संगतः ।\nतदा मृतिस्तवेत्युक्त्वा विवेश ज्वलनं सती॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004031051, "chapter_id": 24031, "verse_number": "३-३-२-५२", "content_sanskrit": "सोऽपि राजा गुरोः शापमुपभुज्य कृतावधिम् ।\nपुनः स्वरूपमादाय स्वगृहं मुदितो ययौ॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004031052, "chapter_id": 24031, "verse_number": "३-३-२-५३", "content_sanskrit": "ज्ञात्वा विप्रसतीशापं तत्पत्नी रतिलालसम् ।\nपतिं निवारयामास वैधव्यातिबिभ्यती॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004031053, "chapter_id": 24031, "verse_number": "३-३-२-५४", "content_sanskrit": "अनपत्यः स निर्विण्णो राज्यभोगेषु पार्थिवः ।\nविसृज्य सकलं लक्ष्मीं ययौ भूयोऽपि काननम्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004031054, "chapter_id": 24031, "verse_number": "३-३-२-५५", "content_sanskrit": "सूर्यवंशप्रतिष्ठित्यै वशिष्ठो मुनिसत्तमः ।\nतस्यामुत्पादयामास मदयंत्यां सुतोत्तमम्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004031055, "chapter_id": 24031, "verse_number": "३-३-२-५६", "content_sanskrit": "विसृष्टराज्यो राजापि विचरन्सकलां महीम् ।\nआयांतीं पृष्ठतोऽपश्यत्पिशाचीं घोररूपिणीम्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004031056, "chapter_id": 24031, "verse_number": "३-३-२-५७", "content_sanskrit": "सा हि मूर्तिमती घोरा ब्रह्महत्या दुरत्यया ।\nयदासौ शापविभ्रष्टो मुनिपुत्रमभक्षयत्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004031057, "chapter_id": 24031, "verse_number": "३-३-२-५८", "content_sanskrit": "तेनात्मकर्मणा यांतीं ब्रह्महत्यां स पृष्ठतः ।\nबुबुधे मुनिवर्याणामुपदेशेन भूपतिः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004031058, "chapter_id": 24031, "verse_number": "३-३-२-५९", "content_sanskrit": "तस्या निर्वेशमन्विच्छन्राजा निर्विण्णमानसः ।\nनानाक्षेत्राणि तीर्थानि चचार बहुवत्सरम्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004031059, "chapter_id": 24031, "verse_number": "३-३-२-६०", "content_sanskrit": "यदा सर्वेषु तीर्थेषु स्नात्वापि च मुहुर्मुहुः ।\nन निवृत्ता ब्रह्महत्या मिथिलामाययौ तदा ।\nबाह्योद्यानगतस्तस्याश्चिंतया परयार्दितः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004031060, "chapter_id": 24031, "verse_number": "३-३-२-६१", "content_sanskrit": "ददर्श मुनिमायांतं गौतमं विमलाशयम् ।\nहुताशनमिवाशेषतपस्विजनसेवितम्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004031061, "chapter_id": 24031, "verse_number": "३-३-२-६२", "content_sanskrit": "विवस्वंतमिवात्यंतं घनदोषतमोनुदम् ।\nशशांकमिव निःशंकमवदातगुणोदयम्॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004031062, "chapter_id": 24031, "verse_number": "३-३-२-६३", "content_sanskrit": "महेश्वरमिव श्रीमद्द्विजराजकलाधरम् ।\nशांतं शिष्यगणोपेतं तपसामेकभाजनम्॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004031063, "chapter_id": 24031, "verse_number": "३-३-२-६४", "content_sanskrit": "उपसृत्य स राजेंद्रः प्रणनाम मुहुर्मुहुः ।\nगौतमोऽपि मुनिश्रेष्ठो राजानं रविवंशजम्॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004031064, "chapter_id": 24031, "verse_number": "३-३-२-६५", "content_sanskrit": "अभिनंद्य मुनिः प्रीत्या संस्मितं समभाषत॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004031065, "chapter_id": 24031, "verse_number": "३-३-२-६६", "content_sanskrit": "गौतम उवाच ।\nकच्चित्ते कुशलं राजन्कच्चित्ते पदमव्ययम्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004031066, "chapter_id": 24031, "verse_number": "३-३-२-६७", "content_sanskrit": "कुशलिन्यः प्रजाः कच्चिदवरोधजनोपि वा ।\nकिमर्थमिह संप्राप्तो विसृज्य सकलां श्रियम्॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004031067, "chapter_id": 24031, "verse_number": "३-३-२-६८", "content_sanskrit": "किं च ध्यायसि भो राजन्दीर्घमुष्णं च निःश्वसन्॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004031068, "chapter_id": 24031, "verse_number": "३-३-२-६९", "content_sanskrit": "राजोवाच ।\nसर्वे कुशलिनो ब्रह्मन्वयं त्वदनुकंपया॥राज्ञामुत्तमवंश्यानां ब्रह्मायत्ता हि संपदः ।\nकिं नु मां बाधते त्वेषा पिशाची घोररूपिणी॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004031069, "chapter_id": 24031, "verse_number": "३-३-२-७०", "content_sanskrit": "अलक्षिता मदपरैर्भर्त्सयंती पदेपदे ।\nयन्मया शापदग्धेन कृतमहो दुरत्ययम् ।\nन शांतिर्जायते तस्य प्रायश्चित्तसहस्रकैः॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004031070, "chapter_id": 24031, "verse_number": "३-३-२-७१", "content_sanskrit": "इष्टाश्च विविधा यज्ञाः कोशसर्वस्वदक्षिणाः ।\nसरित्सरांसि स्नातानि यानि पूज्यानि भूतले ।\nनिषेवितानि सर्वाणि क्षेत्राणि भ्रमता मया॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004031071, "chapter_id": 24031, "verse_number": "३-३-२-७२", "content_sanskrit": "जप्तान्यखिलमंत्राणि ध्याताः सकलदेवताः ।\nमहाव्रतानि चीर्णानि पर्णमूलफलाशिना॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004031072, "chapter_id": 24031, "verse_number": "३-३-२-७३", "content_sanskrit": "तानि सर्वाणि कुर्वंति स्वस्थं मां न कदाचन ।\nअद्य मे जन्मसाफल्यं संप्राप्तमिव लक्ष्यते॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004031073, "chapter_id": 24031, "verse_number": "३-३-२-७४", "content_sanskrit": "यतस्त्वद्दर्शनादेव ममात्मानंदभागभूत् ।\nअन्विच्छंल्लभते क्वापि वर्षपूगैर्मनोरथम्॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004031074, "chapter_id": 24031, "verse_number": "३-३-२-७५", "content_sanskrit": "इत्येवं जनवादोऽपि संप्राप्तो मयि सत्यताम् ।\nआजन्मसंचितानां तु पुण्यानामुदयोदये॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004031075, "chapter_id": 24031, "verse_number": "३-३-२-७६", "content_sanskrit": "यद्भवान्भवभीतानां त्राता नयनगोचरः ।\nकस्माद्देशादिहायातो भवान्भवभयापहः॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004031076, "chapter_id": 24031, "verse_number": "३-३-२-७७", "content_sanskrit": "दूरभ्रमणविश्रांतं शंके त्वामिह चागतम् ।\nदृष्ट्वाश्चर्यमिवात्यर्थं मुदितोसि मुखश्रिया॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004031077, "chapter_id": 24031, "verse_number": "३-३-२-७८", "content_sanskrit": "आनंदयसि मे चेतः प्रेम्णा संभाषणादिव ।\nअद्य मे तव पादाब्जशरणस्य कृतैनसः ।\nशांतिं कुरु महाभाग येनाहं सुखमाप्नुयाम्॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004031078, "chapter_id": 24031, "verse_number": "३-३-२-७९", "content_sanskrit": "इति तेन समादिष्टो गौतमः करुणानिधिः ।\nसमादिदेश घोराणामघानां साधु निष्कृतिम्॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004031079, "chapter_id": 24031, "verse_number": "३-३-२-८०", "content_sanskrit": "गौतम उवाच ।\nसाधु राजेंद्र धन्योऽसि महा घेभ्यो भयं त्यज॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004031080, "chapter_id": 24031, "verse_number": "३-३-२-८१", "content_sanskrit": "शिवे त्रातरि भक्तानां क्व भयं शरणैषिणाम् ।\nशृणु राजन्महाभाग क्षेत्रमन्यत्प्रतिष्ठितम्॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004031081, "chapter_id": 24031, "verse_number": "३-३-२-८२", "content_sanskrit": "महापातकसंहारि गोकर्णाख्यं मनोरमम् ।\nयत्र स्थितिर्न पापानां महद्भ्यो महतामपि॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004031082, "chapter_id": 24031, "verse_number": "३-३-२-८३", "content_sanskrit": "स्मृतो ह्यशेषपापघ्नो यत्र संनिहितः शिवः ।\nयथा कैलासशिखरे यथा मंदारमूर्द्धनि॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004031083, "chapter_id": 24031, "verse_number": "३-३-२-८४", "content_sanskrit": "निवासो निश्चितः शंभोस्तथा गोकर्णमण्डले ।\nनाग्निना न शशांकेन न ताराग्रहनायकैः॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004031084, "chapter_id": 24031, "verse_number": "३-३-२-८५", "content_sanskrit": "तमो निस्तीर्यते सम्य ग्यथा सवितृदर्शनात् ।\nतथैव नेतरैस्तीर्थैर्न च क्षेत्रैर्मनोरमैः॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004031085, "chapter_id": 24031, "verse_number": "३-३-२-८६", "content_sanskrit": "सद्यः पापविशुद्धिः स्याद्यथा गोकर्णदर्शनात् ।\nअपि पापशतं कृत्वा ब्रह्म हत्यादि मानवः॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004031086, "chapter_id": 24031, "verse_number": "३-३-२-८७", "content_sanskrit": "सकृत्प्रविश्य गोकर्णं न बिभेति ह्यघात्क्वचित् ।\nतत्र सर्वे महात्मानस्तपसा शांतिमागताः॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004031087, "chapter_id": 24031, "verse_number": "३-३-२-८८", "content_sanskrit": "इन्द्रोपेंद्रविरिंच्याद्यैः सेव्यते सिद्धिकांक्षिभिः ।\nतत्रैकेन दिनेनापि यत्कृतं व्रतमुत्तमम्॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004031088, "chapter_id": 24031, "verse_number": "३-३-२-८९", "content_sanskrit": "तदन्यत्राब्दलक्षेण कृतं भवति तत्समम् ।\nयत्रेंद्रब्रह्मविष्ण्वादिदेवानां हितकाम्यया॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004031089, "chapter_id": 24031, "verse_number": "३-३-२-९०", "content_sanskrit": "महाबलाभिधानेन देवः संनिहितः स्वयम् ।\nघोरेण तपसा लब्धं रावणाख्येन रक्षसा॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004031090, "chapter_id": 24031, "verse_number": "३-३-२-९१", "content_sanskrit": "तल्लिंगं स्थापयामास गोकर्णे गणनायकः ।\nइन्द्रो ब्रह्मा मुकुन्दश्च विश्वेदेवा मरुद्गणाः॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004031091, "chapter_id": 24031, "verse_number": "३-३-२-९२", "content_sanskrit": "आदित्या वसवो दस्रौ शशांकश्च दिवाकरः ।\nएते विमानगतयो देवास्ते सह पार्षदैः॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004031092, "chapter_id": 24031, "verse_number": "३-३-२-९३", "content_sanskrit": "पूर्वद्वारं निषेवन्ते देवदेवस्य शूलिनः ।\nयोन्यो मृत्युः स्वयं साक्षाच्चित्रगुप्तश्च पावकः॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004031093, "chapter_id": 24031, "verse_number": "३-३-२-९४", "content_sanskrit": "पितृभिः सह रुद्रैश्च दक्षिणद्वारमाश्रितः ।\nवरुणः सरितां नाथो गंगादिसरितां गणैः॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004031094, "chapter_id": 24031, "verse_number": "३-३-२-९५", "content_sanskrit": "आसेवते महादेवं पश्चिमद्वारमाश्रितः ।\nतथा वायुः कुबेरश्च देवेशी भद्रकर्णिका॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004031095, "chapter_id": 24031, "verse_number": "३-३-२-९६", "content_sanskrit": "मातृभिश्चंडिकाद्याभिरुत्तरद्वारमाश्रिता ।\nविश्वावसुश्चित्ररथश्चित्रसेनो महाबलः॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004031096, "chapter_id": 24031, "verse_number": "३-३-२-९७", "content_sanskrit": "सह गन्धर्ववर्गैश्च पूजयंति महाबलम् ।\nरंभा घृताची मेना च पूर्वचित्तिस्तिलोत्तमा॥ ९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004031097, "chapter_id": 24031, "verse_number": "३-३-२-९८", "content_sanskrit": "नृत्यंति पुरतः शम्भोरुर्वश्याद्याः सुरस्त्रियः ।\nवशिष्ठः कश्यपः कण्वो विश्वामित्रो महा तपाः॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004031098, "chapter_id": 24031, "verse_number": "३-३-२-९९", "content_sanskrit": "जैमिनिश्च भरद्वाजो जाबालिः क्रतुरंगिराः ।\nएते वयं च राजेंद्र सर्वे ब्रह्मर्षयोऽमलाः॥ ९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004031099, "chapter_id": 24031, "verse_number": "३-३-२-१००", "content_sanskrit": "देवं महाबलं भक्त्या समंतात्पर्यु पास्महे ।\nमरीचिना सहात्रिश्च दक्षाद्याश्च मुनीश्वराः॥ १०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004031100, "chapter_id": 24031, "verse_number": "३-३-२-१०१", "content_sanskrit": "सनकाद्या महात्मान उपविष्टा उपासते ।\nतथैव मुनयः साध्या अजिनांबर धारिणः॥ १०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004031101, "chapter_id": 24031, "verse_number": "३-३-२-१०२", "content_sanskrit": "दंडिनो व्रतमुण्डाश्च स्नातका ब्रह्मचारिणः ।\nत्वगस्थिमात्रावयवास्तपसा दग्धकिल्बिषाः॥ १०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004031102, "chapter_id": 24031, "verse_number": "३-३-२-१०३", "content_sanskrit": "सेवन्ते परया भक्त्या देवदेवं पिनाकिनम् ।\nतथा देवाः सगन्धर्वाः पितरः सिद्धचारणाः॥ १०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7004031103, "chapter_id": 24031, "verse_number": "३-३-२-१०४", "content_sanskrit": "विद्याधराः किंपुरुषाः किन्नरा गुह्यकाः खगाः ।\nनागाः पिशाचा वेताला दैतेयाश्च महाबलाः॥ १०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7004031104, "chapter_id": 24031, "verse_number": "३-३-२-१०५", "content_sanskrit": "नानाविभवसंपन्ना नानाभूषणवाहनाः ।\nविमानैः सूर्यसंकाशैरग्निवर्णैः शशिप्रभैः॥ १०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7004031105, "chapter_id": 24031, "verse_number": "३-३-२-१०६", "content_sanskrit": "विद्युत्पुंजनिभैरन्यैः समं तात्परिवारितम् ।\nप्रस्तुवंति प्रगायंति पठंति प्रणमंति च॥ १०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7004031106, "chapter_id": 24031, "verse_number": "३-३-२-१०७", "content_sanskrit": "प्रनृत्यंति प्रहृष्यंति गोकर्णे पृथिवीपते ।\nलभंतेऽभीप्सितान्कामान्रमंते च यथा सुखम्॥ १०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7004031107, "chapter_id": 24031, "verse_number": "३-३-२-१०८", "content_sanskrit": "गोकर्णसदृशं क्षेत्रं नास्ति ब्रह्मांडगोलके ।\nतत्र घोरं तपस्तप्तमगस्त्येन महात्मना॥ १०८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7004031108, "chapter_id": 24031, "verse_number": "३-३-२-१०९", "content_sanskrit": "तथा सनत्कुमारेण प्रियव्रतसुतैरपि ।\nअग्निना देववर्येण कन्दर्पेण च पार्थिव॥ १०९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7004031109, "chapter_id": 24031, "verse_number": "३-३-२-११०", "content_sanskrit": "तथा देव्या भद्रकाल्या शिशुमारेण धीमता ।\nदुर्मुखेन फणींद्रेण मणिनागाह्वयेन च॥ ११० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7004031110, "chapter_id": 24031, "verse_number": "३-३-२-१११", "content_sanskrit": "इलावर्तादिभिर्नागैर्गरुडेन बलीयसा ।\nरक्षसा रावणेनापि कुम्भकर्णाह्वयेन तु॥ १११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7004031111, "chapter_id": 24031, "verse_number": "३-३-२-११२", "content_sanskrit": "विभीषणेन पुण्येन तपस्तप्तं महात्मना ।\nएते चान्ये च गीर्वाणाः सिद्धदानवमानवाः॥ ११२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7004031112, "chapter_id": 24031, "verse_number": "३-३-२-११३", "content_sanskrit": "गोकर्णे देवदेवेशं शिवमाराध्य भक्तितः ।\nस्वनामांकानि लिंगानि स्थापयित्वा सहस्रशः॥ ११३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7004031113, "chapter_id": 24031, "verse_number": "३-३-२-११४", "content_sanskrit": "लेभिरे परमां सिद्धिं तथा तीर्थानि चक्रिरे ।\nअत्र स्थानानि सर्वेषां देवानां संति पार्थिव॥ ११४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7004031114, "chapter_id": 24031, "verse_number": "३-३-२-११५", "content_sanskrit": "विष्णोश्च देवदेवस्य ब्रह्मणः परमेष्ठिनः ।\nकार्त्तिकेयस्य वीरस्य गजवक्त्रस्य चानघ॥ ११५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7004031115, "chapter_id": 24031, "verse_number": "३-३-२-११६", "content_sanskrit": "धर्मस्य क्षेत्रपालस्य दुर्गायाश्च महामते ।\nगोकर्णे शिवलिंगानि विद्यंते कोटिकोटिशः॥ ११६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7004031116, "chapter_id": 24031, "verse_number": "३-३-२-११७", "content_sanskrit": "असंख्यातानि तीर्थानि तिष्ठंति च पदेपदे ।\nबहुनात्र किमुक्तेन गोकर्णस्थानि पार्थिव॥ ११७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7004031117, "chapter_id": 24031, "verse_number": "३-३-२-११८", "content_sanskrit": "सर्वाण्यश्मानि लिंगानि तीर्थान्यंभांसि सर्वशः ।\nगोकर्णे शिवलिंगानां तीर्थानामपि भूरिशः॥ ११८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7004031118, "chapter_id": 24031, "verse_number": "३-३-२-११९", "content_sanskrit": "गीयते महिमा राजन्पुराणेषु महर्षिभिः ।\nगोकर्णे कोटितीर्थं च तीर्थानां मुख्यतां गतम्॥ ११९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7004031119, "chapter_id": 24031, "verse_number": "३-३-२-१२०", "content_sanskrit": "सर्वेषां शिवलिंगानां सार्वभौमो महाबलः ।\nकृते महाबलः श्वेतस्त्रेतायामतिलोहितः॥ १२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7004031120, "chapter_id": 24031, "verse_number": "३-३-२-१२१", "content_sanskrit": "द्वापरे पीत वर्णश्च कलौ श्यामो भविष्यति ।\nआक्रांतं सप्तपातालं कुर्वन्नपि महाबलः॥ १२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7004031121, "chapter_id": 24031, "verse_number": "३-३-२-१२२", "content_sanskrit": "प्राप्ते कलियुगे घोरे मृदुतामुपयास्यति ।\nपश्चिमांबुधितीरस्थं गोकर्णक्षेत्रमुत्तमम्॥ १२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7004031122, "chapter_id": 24031, "verse_number": "३-३-२-१२३", "content_sanskrit": "ब्रह्महत्यादिपापानि दहतीति किमद्भुतम् ।\nये चात्र ब्रह्महंतारो ये च भूतद्रुहः शठाः॥ १२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7004031123, "chapter_id": 24031, "verse_number": "३-३-२-१२४", "content_sanskrit": "ये सर्वगुणहीनाश्च परदाररताश्च ये ।\nये दुर्वृत्ता दुराचारा दुःशीलाः कृपणाश्च ये॥ १२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7004031124, "chapter_id": 24031, "verse_number": "३-३-२-१२५", "content_sanskrit": "लुब्धाः क्रूराः खला मूढाः स्ते नाश्चैवातिकामिनः ।\nते सर्वे प्राप्य गोकर्णं स्नात्वा तीर्थजलेषु च॥ १२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7004031125, "chapter_id": 24031, "verse_number": "३-३-२-१२६", "content_sanskrit": "देवं महाबलं दृष्ट्वा प्रयाताः शांकरं पदम् ।\nतत्र पुण्यासु तिथिषु पुण्य र्क्षे पुण्यवासरे॥ १२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7004031126, "chapter_id": 24031, "verse_number": "३-३-२-१२७", "content_sanskrit": "येऽर्चयंति महेशानं ते रुद्राः स्युर्न संशयः ।\nयदा कदाचिद्गोकर्णं यो वा को वापि मानवः॥ १२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7004031127, "chapter_id": 24031, "verse_number": "३-३-२-१२८", "content_sanskrit": "प्रविश्य पूजयेदीशं स गच्छेद्ब्रह्मणः पदम् ।\nरवींदुसौम्यवारेषु यदा दर्शो भविष्यति॥ १२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7004031128, "chapter_id": 24031, "verse_number": "३-३-२-१२९", "content_sanskrit": "तदा जलनिधौ स्नानं दानं च पितृतर्पणम् ।\nशिवपूजा जपो होमो व्रतचर्या द्विजार्चनम्॥ १२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7004031129, "chapter_id": 24031, "verse_number": "३-३-२-१३०", "content_sanskrit": "यत्किंचिद्वा कृतं कर्म तदनंतफलप्रदम् ।\nव्यतीपातादियोगेषु रविसंक्रमणेषु च॥ १३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7004031130, "chapter_id": 24031, "verse_number": "३-३-२-१३१", "content_sanskrit": "महाप्रदोषवेलासु शिव पूजा विमुक्तिदा ।\nअथैकां ते प्रवक्ष्यामि तिथिं पार्थिव मुक्तिदाम्॥ १३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7004031131, "chapter_id": 24031, "verse_number": "३-३-२-१३२", "content_sanskrit": "यस्यां किल महाव्याधो लेभे शंभोः परं पदम् ।\nमाघमासे महापुण्या या सा कृष्णचतुर्दशी॥ १३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7004031132, "chapter_id": 24031, "verse_number": "३-३-२-१३३", "content_sanskrit": "शिवलिंगं बिल्वपत्रं दुर्लभं हि चतुष्टयम् ।\nअहो बलवती माया यया शैवी महातिथिः॥ १३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7004031133, "chapter_id": 24031, "verse_number": "३-३-२-१३४", "content_sanskrit": "नोपोष्यते जनैर्मूढैर्महामूकैरिव त्रयी ।\nउपवासो जागरणं सन्निधिः परमेशितुः॥ १३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7004031134, "chapter_id": 24031, "verse_number": "३-३-२-१३५", "content_sanskrit": "गोकर्णं शिवलोकस्य नृणां सोपानपद्धतिः ।\nशृणु राजन्नहमपि गोकर्णा दधुनागतः॥ १३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7004031135, "chapter_id": 24031, "verse_number": "३-३-२-१३६", "content_sanskrit": "उपास्यैनां शिवतिथिं विलोक्य च महोत्सवम् ।\nअस्यां शिवतिथौ सर्वे महोत्सवदिदृक्षवः॥ १३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7004031136, "chapter_id": 24031, "verse_number": "३-३-२-१३७", "content_sanskrit": "आगताः सर्वदेशेभ्यश्चातुर्वर्णा महाजनाः ।\nस्त्रियो वृद्धाश्च बालाश्च चतुराश्रमवासिनः॥ १३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7004031137, "chapter_id": 24031, "verse_number": "३-३-२-१३८", "content_sanskrit": "आगत्य दृष्ट्वा देवेशं लेभिरे कृतकृत्यताम् ।\nअथाहमप्यमी शिष्या ऋषयश्च तथाऽपरे॥ १३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7004031138, "chapter_id": 24031, "verse_number": "३-३-२-१३९", "content_sanskrit": "राजर्षयश्च राजेंद्र सनकाद्याः सुरर्षयः ।\nस्नात्वा सर्वेषु तीर्थेषु समुपास्य महाबलम्॥ १३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7004031139, "chapter_id": 24031, "verse_number": "३-३-२-१४०", "content_sanskrit": "लब्ध्वा च जन्मसाफल्यं प्रयाताः सर्वतोदिशम् ।\nअमुनाद्य नरेंद्रेण जनकेन यियक्षुणा॥ १४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7004031140, "chapter_id": 24031, "verse_number": "३-३-२-१४१", "content_sanskrit": "निमंत्रितोऽहं संप्राप्तो गोकर्णाच्छिवमंदिरात् ।\nप्रत्यागमं किमप्यंग दृष्ट्वाश्चर्यमहं पथि ।\nमहानंदेन मनसा कृतार्थोऽस्मि महीपते॥ १४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}]