[{"id": 2195547, "chapter_id": 5160, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2195548, "chapter_id": 5160, "verse_number": "१", "content_sanskrit": "भूयस्तु शृणु राजेन्द्र धर्मान् धर्मभृतांवर ।\nअत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nइन्द्राग्न्योः सूर्यशच्योश्च तन्मे निगदतः शृणु\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2195549, "chapter_id": 5160, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2195550, "chapter_id": 5160, "verse_number": "२", "content_sanskrit": "यथा राज्यं प्रपास्यामि कामक्रोधविवर्जितान् ।\nएतेन सत्यवाक्येन पादः कुम्भस्य पूर्यताम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2195551, "chapter_id": 5160, "verse_number": "", "content_sanskrit": "अग्निः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2195552, "chapter_id": 5160, "verse_number": "३", "content_sanskrit": "यथाहं तत्र नाश्नामि यत्र नाश्नन्ति वै द्विजाः ।\nएतेन सत्यवाक्येन पादः कुम्भस्य पूर्यताम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2195553, "chapter_id": 5160, "verse_number": "", "content_sanskrit": "सूर्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2195554, "chapter_id": 5160, "verse_number": "४", "content_sanskrit": "यथा गोब्राह्मणस्यार्थे न तपामि यथाबलम् ।\nएतेन सत्यवाक्येन पादः कुम्भस्य पूर्यताम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2195555, "chapter_id": 5160, "verse_number": "", "content_sanskrit": "शची", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2195556, "chapter_id": 5160, "verse_number": "५", "content_sanskrit": "कर्मणा मनसा वाचा नावमन्ये पुरन्दरम् ।\nएतेन सत्यवाक्येन पादः कुम्भस्य पूर्यताम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2195557, "chapter_id": 5160, "verse_number": "११", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि\nदानधर्मे इन्द्राग्निसंवादे सत्यप्रतिज्ञाकथने शपथोक्तिर्नाम एकादशोऽध्यायः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2195558, "chapter_id": 5160, "verse_number": "", "content_sanskrit": "* * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}]