[{"id": 5000494000, "chapter_id": 9494, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे सप्ताशीतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000494001, "chapter_id": 9494, "verse_number": "६-८७-१", "content_sanskrit": "एवमुक्त्वा तु सौमित्रिं जातहर्षो विभीषणः।\nधनुष्पाणिं तमादाय त्वरमाणो जगाम सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000494002, "chapter_id": 9494, "verse_number": "६-८७-२", "content_sanskrit": "अविदूरं ततो गत्वा प्रविश्य तु महद् वनम्।\nअदर्शयत तत्कर्म लक्ष्मणाय विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000494003, "chapter_id": 9494, "verse_number": "६-८७-३", "content_sanskrit": "नीलजीमूतसंकाशं न्यग्रोधं भीमदर्शनम्।\nतेजस्वी रावणभ्राता लक्ष्मणाय न्यवेदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000494004, "chapter_id": 9494, "verse_number": "६-८७-४", "content_sanskrit": "इहोपहारं भूतानां बलवान् रावणात्मजः।\nउपहृत्य ततः पश्चात् संग्राममभिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000494005, "chapter_id": 9494, "verse_number": "६-८७-५", "content_sanskrit": "अदृश्यः सर्वभूतानां ततो भवति राक्षसः।\nनिहन्ति समरे शत्रून् बध्नाति च शरोत्तमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000494006, "chapter_id": 9494, "verse_number": "६-८७-६", "content_sanskrit": "तमप्रविष्टं न्यग्रोधं बलिनं रावणात्मजम्।\nविध्वंसय शरैर्दीप्तैः सरथं साश्वसारथिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000494007, "chapter_id": 9494, "verse_number": "६-८७-७", "content_sanskrit": "तथेत्युक्त्वा महातेजाः सौमित्रिर्मित्रनन्दनः।\nबभूवावस्थितस्तत्र चित्रं विस्फारयन् धनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000494008, "chapter_id": 9494, "verse_number": "६-८७-८", "content_sanskrit": "स रथेनाग्निवर्णेन बलवान् रावणात्मजः।\nइन्द्रजित् कवची खड्गी सध्वजः प्रत्यदृश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000494009, "chapter_id": 9494, "verse_number": "६-८७-९", "content_sanskrit": "तमुवाच महातेजाः पौलस्त्यमपराजितम्।\nसमाह्वये त्वां समरे सम्यग् युद्धं प्रयच्छ मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000494010, "chapter_id": 9494, "verse_number": "६-८७-१०", "content_sanskrit": "एवमुक्तो महातेजा मनस्वी रावणात्मजः।\nअब्रवीत् परुषं वाक्यं तत्र दृष्ट्वा विभीषणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000494011, "chapter_id": 9494, "verse_number": "६-८७-११", "content_sanskrit": "इह त्वं जातसंवृद्धः साक्षात् भ्राता पितुर्मम।\nकथं द्रुह्यसि पुत्रस्य पितृव्यो मम राक्षस ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000494012, "chapter_id": 9494, "verse_number": "६-८७-१२", "content_sanskrit": "न ज्ञातित्वं न सौहार्दं न जातिस्तव दुर्मते।\nप्रमाणं न च सौदर्यं न धर्मो धर्मदूषण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000494013, "chapter_id": 9494, "verse_number": "६-८७-१३", "content_sanskrit": "शोच्यस्त्वमसि दुर्बुद्धे निन्दनीयश्च साधुभिः।\nयस्त्वं स्वजनमुत्सृज्य परभृत्यत्वमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000494014, "chapter_id": 9494, "verse_number": "६-८७-१४", "content_sanskrit": "नैतच्छिथिलया बुद्ध्या त्वं वेत्सि महदन्तरम्।\nक्व च स्वजनसंवासः क्व च नीच पराश्रयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000494015, "chapter_id": 9494, "verse_number": "६-८७-१५", "content_sanskrit": "गुणवान् वा परजनः स्वजनो निर्गुणोऽपि वा।\nनिर्गुणः स्वजनः श्रेयान् यः परः पर एव सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000494016, "chapter_id": 9494, "verse_number": "६-८७-१६", "content_sanskrit": "यः स्वपक्षं परित्यज्य परपक्षं निषेवते।\nस स्वपक्षे क्षयं याते पश्चात् तैरेव हन्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000494017, "chapter_id": 9494, "verse_number": "६-८७-१७", "content_sanskrit": "निरनुक्रोशता चेयं यादृशी ते निशाचर।\nस्वजनेन त्वया शक्यं पौरुषं रावणानुज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000494018, "chapter_id": 9494, "verse_number": "६-८७-१८", "content_sanskrit": "इत्युक्तो भ्रातृपुत्रेण प्रत्युवाच विभीषणः।\nअजानन्निव मच्छीलं किं राक्षस विकत्थसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000494019, "chapter_id": 9494, "verse_number": "६-८७-१९", "content_sanskrit": "राक्षसेन्द्रसुतासाधो पारुष्यं त्यज गौरवात्।\nकुले यद्यप्यहं जातो रक्षसां क्रूरकर्मणाम्।\nगुणो यः प्रथमो नॄणां तन्मे शीलमराक्षसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000494020, "chapter_id": 9494, "verse_number": "६-८७-२०", "content_sanskrit": "न रमे दारुणेनाहं न चाधर्मेण वै रमे।\nभ्रात्रा विषमशीलोऽपि कथं भ्राता निरस्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000494021, "chapter_id": 9494, "verse_number": "६-८७-२१", "content_sanskrit": "धर्मात् प्रच्युतशीलं हि पुरुषं पापनिश्चयम्।\nत्यक्त्वा सुखमवाप्नोति हस्तादाशीविषं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000494022, "chapter_id": 9494, "verse_number": "६-८७-२२", "content_sanskrit": "परस्वहरणे युक्तं परदाराभिमर्शकम्।\nत्याज्यमाहुर्दुरात्मानं वेश्म प्रज्वलितं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000494023, "chapter_id": 9494, "verse_number": "६-८७-२३", "content_sanskrit": "परस्वानां च हरणं परदाराभिमर्शनम्।\nसुहृदामतिशङ्का च त्रयो दोषाः क्षयावहाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000494024, "chapter_id": 9494, "verse_number": "६-८७-२४", "content_sanskrit": "महर्षीणां वधो घोरः सर्वदेवैश्च विग्रहः।\nअभिमानश्च रोषश्च वैरित्वं प्रतिकूलता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000494025, "chapter_id": 9494, "verse_number": "६-८७-२५", "content_sanskrit": "एते दोषा मम भ्रातुर्जीवितैश्वर्यनाशनाः।\nगुणान् प्रच्छादयामासुः पर्वतानिव तोयदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000494026, "chapter_id": 9494, "verse_number": "६-८७-२६", "content_sanskrit": "दोषैरेतैः परित्यक्तो मया भ्राता पिता तव।\nनेयमस्ति पुरी लङ्का न च त्वं न च ते पिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000494027, "chapter_id": 9494, "verse_number": "६-८७-२७", "content_sanskrit": "अतिमानश्च बालश्च दुर्विनीतश्च राक्षस।\nबद्धस्त्वं कालपाशेन ब्रूहि मां यद् यदिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000494028, "chapter_id": 9494, "verse_number": "६-८७-२८", "content_sanskrit": "अद्येह व्यसनं प्राप्तं यन्मां परुषमुक्तवान्।\nप्रवेष्टुं न त्वया शक्यं न्यग्रोधं राक्षसाधम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000494029, "chapter_id": 9494, "verse_number": "६-८७-२९", "content_sanskrit": "धर्षयित्वा च काकुत्स्थं न शक्यं जीवितुं त्वया।\nयुध्यस्व नरदेवेन लक्ष्मणेन रणे सह।\nहतस्त्वं देवताकार्यं करिष्यसि यमक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000494030, "chapter_id": 9494, "verse_number": "६-८७-३०", "content_sanskrit": "निदर्शयस्वात्मबलं समुद्यतं\nकुरुष्व सर्वायुधसायकव्ययम्।\nन लक्ष्मणस्यैत्य हि बाणगोचरं\nत्वमद्य जीवन् सबलो गमिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000494031, "chapter_id": 9494, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे सप्ताशीतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]