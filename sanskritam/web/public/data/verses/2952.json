[{"id": 2091704, "chapter_id": 2952, "verse_number": "१३-८२-१", "content_sanskrit": "युधिष्ठिर उवाच।\nसर्वशास्त्रविधानज्ञ राजधर्मविदुत्तम।\nअतीव संशयच्छेत्ता भवान्वै प्रथितः क्षितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2091705, "chapter_id": 2952, "verse_number": "१३-८२-२", "content_sanskrit": "कश्चित्तु संशयो मेऽस्ति तन्मे ब्रूहि पितामह।\n`अस्यामापदि कष्टायामन्यं पृच्छाम कं वयम्॥\nजातेऽस्मिन्संशये राजन्नान्यं पृच्छेम कञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2091706, "chapter_id": 2952, "verse_number": "१३-८२-३", "content_sanskrit": "यथा नरेण कर्तव्यं धर्ममार्गानुवर्तिना।\nएतत्सर्वं महाबाहो भवान्व्याख्यातुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2091707, "chapter_id": 2952, "verse_number": "१३-८२-४", "content_sanskrit": "चतस्रो विहिता भार्या ब्राह्मणस्य पितामह।\nब्राह्मणी क्षत्रिया वैश्या शूद्रा च रतिमिच्छतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2091708, "chapter_id": 2952, "verse_number": "१३-८२-५", "content_sanskrit": "तत्र जातेषु पुत्रेषु सर्वासां कुरुसत्तम।\nआनुपूर्व्येण कस्तेषां पित्र्यं दायाद्यमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2091709, "chapter_id": 2952, "verse_number": "१३-८२-६", "content_sanskrit": "केन वा किं ततो हार्यं पितृवित्तात्पितामह।\nएतदिच्छामि कथितं विभागस्तेषु कः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2091710, "chapter_id": 2952, "verse_number": "१३-८२-७x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2091711, "chapter_id": 2952, "verse_number": "१३-८२-७", "content_sanskrit": "ब्राह्मणः क्षत्रियो वैश्यस्त्रयो वर्णा द्विजातयः।\nएतेषु विहितो धर्मो ब्राह्मणस्य युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2091712, "chapter_id": 2952, "verse_number": "१३-८२-८", "content_sanskrit": "वैषम्यादथवा लोभात्कामाद्वाऽपि परन्तप।\nब्राह्मणस्य भवेच्छूद्रा न तु दृष्टा न तु स्मृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2091713, "chapter_id": 2952, "verse_number": "१३-८२-९", "content_sanskrit": "शूद्रां शयनमारोप्य ब्राह्मणि यात्यधोगतिम्।\nप्रायश्चित्तीयते चापि विधिदृष्टेन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2091714, "chapter_id": 2952, "verse_number": "१३-८२-१०", "content_sanskrit": "तत्र जातेष्वपत्येषु द्विगुणं स्वाद्युधिष्ठिर।\nअतस्ते नियमं वित्ते सम्प्रवक्ष्यामि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2091715, "chapter_id": 2952, "verse_number": "१३-८२-११", "content_sanskrit": "लक्षण्यं गोवृषो यानं यत्प्रधानतमं भवेत्।\nब्राह्मण्यास्तद्धरेत्पुत्र एकांशं वै पितुर्धनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2091716, "chapter_id": 2952, "verse_number": "१३-८२-१२", "content_sanskrit": "एषं तु दशधा कार्यं ब्राह्मणस्वं युधिष्ठिर।\nतत्र तेनैव हर्तव्याश्चत्वारोंशाः पितुर्धनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2091717, "chapter_id": 2952, "verse_number": "१३-८२-१३", "content_sanskrit": "त्रियायास्तु यः पुत्रो ब्राह्मणः सोप्यसंशयः।\nस तु मातुर्विशेषेण त्रीनंशान्हर्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2091718, "chapter_id": 2952, "verse_number": "१३-८२-१४", "content_sanskrit": "वर्णे तृतीये जातस्तु वैश्यायां ब्राह्मणादपि।\nद्विरंशस्तेन हर्तव्यो ब्राह्मणस्वाद्युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2091719, "chapter_id": 2952, "verse_number": "१३-८२-१५", "content_sanskrit": "शूद्रायां ब्राह्मणाज्जातो नित्यादेयधनः स्मृतः।\nअल्पं चापि प्रदातव्यं शूद्रापुत्राय भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2091720, "chapter_id": 2952, "verse_number": "१३-८२-१६", "content_sanskrit": "दशधा प्रविभक्तस्य धनस्यैव भवेत्क्रमः।\nसवर्णासु तु जातानां समान्भागान्प्रकल्पयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2091721, "chapter_id": 2952, "verse_number": "१३-८२-१७", "content_sanskrit": "अब्राह्मणं तु मन्यन्ते शूद्रापुत्रमनैपुणात्।\nत्रिषु वर्णेषु जातो हि ब्राह्मणाद्ब्राह्मणो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2091722, "chapter_id": 2952, "verse_number": "१३-८२-१८", "content_sanskrit": "स्मृताश्च वर्णाश्चत्वारः पञ्चमो नाधिगम्यते।\nहरेच्च दशमं भागं शूद्रापुत्रः पितुर्धनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2091723, "chapter_id": 2952, "verse_number": "१३-८२-१९", "content_sanskrit": "तत्तु दत्तं हरेत्पित्रा नादत्तं हर्तुमर्हति।\nअवश्यं हि धनं देयं शूद्रापुत्राय भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2091724, "chapter_id": 2952, "verse_number": "१३-८२-२०", "content_sanskrit": "आनृशंस्यं परो धर्म इति तस्मै प्रदीयते।\nयत्रतत्र समुत्पन्नं गुणायैवोपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2091725, "chapter_id": 2952, "verse_number": "१३-८२-२१", "content_sanskrit": "यद्यप्येष सुपुत्रः स्यादपुत्रो यदि वा भवेत्।\nनाधिकं दशमाद्दद्याच्छूद्रापुत्राय भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2091726, "chapter_id": 2952, "verse_number": "१३-८२-२२", "content_sanskrit": "`स्मृत एकश्चतुर्भागः कन्याभागस्तु धर्मतः।\nअभ्रातृका समग्राहा चार्धास्येत्यपरे विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2091727, "chapter_id": 2952, "verse_number": "१३-८२-२३", "content_sanskrit": "त्रैवार्विकाद्यदा भक्तादधिकं स्याद्द्विजस्य तु।\nयजेत तेन द्रव्येण न वृथा साधयेद्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2091728, "chapter_id": 2952, "verse_number": "१३-८२-२४", "content_sanskrit": "त्रिसहस्रपरो दायः स्त्रियै देयो धनस्य वै।\nभर्त्रा तच्च धनं दत्तं यथार्हं भोक्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2091729, "chapter_id": 2952, "verse_number": "१३-८२-२५", "content_sanskrit": "स्त्रीणां तु पतिदायाद्यमुपभोगफलं स्मृतम्।\nनापहारं स्त्रियः कुर्युः पितृवित्तात्कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2091730, "chapter_id": 2952, "verse_number": "१३-८२-२६", "content_sanskrit": "स्त्रियास्तु यद्भवेद्वित्तं पित्रा दत्तं युधिष्ठिर।\nब्राह्मण्यास्तद्धरेत्कन्या यथा पुत्रस्तथाऽस्य सा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2091731, "chapter_id": 2952, "verse_number": "१३-८२-२७", "content_sanskrit": "सा हि पुत्रसमा राजन्विहिता कुरुनन्दन।\nएवमेव समुद्दिष्टो धर्मो वै भरतर्षभ।\nएवं धर्ममनुस्मृत्य न वृथा साधयेद्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2091732, "chapter_id": 2952, "verse_number": "१३-८२-२८x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2091733, "chapter_id": 2952, "verse_number": "१३-८२-२८", "content_sanskrit": "शूद्रायां ब्राह्मणाज्जातो यद्यदेयधनः स्मृतः।\nकेन प्रतिविशेषेण दशमोऽप्यस्य दीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2091734, "chapter_id": 2952, "verse_number": "१३-८२-२९", "content_sanskrit": "ब्राह्मण्यां ब्राह्मणाज्जातो ब्राह्मणः स्यान्न संशयः।\nक्षत्रियायां तथैव स्याद्वैश्यायामपि चैव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2091735, "chapter_id": 2952, "verse_number": "१३-८२-३०", "content_sanskrit": "कस्मात्तु विषमं भागं भजेरन्नृपसत्तम।\nयदा सर्वे त्रयो वर्णास्त्वयोक्ता ब्राह्मणा इति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2091736, "chapter_id": 2952, "verse_number": "१३-८२-३१x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2091737, "chapter_id": 2952, "verse_number": "१३-८२-३१", "content_sanskrit": "दारा इत्युच्यते लोके नाम्नैकेन परन्तप।\nप्रोक्तेनि चैव नाम्नाऽयं विशेषः सुमहान्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2091738, "chapter_id": 2952, "verse_number": "१३-८२-३२", "content_sanskrit": "तिस्रः कृत्वा पुरो भार्याः पश्चाद्विन्देत ब्राह्मणीम्।\nसा ज्येष्ठा सा च पूज्या स्यात्सा च ताभ्यो गरीयसी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2091739, "chapter_id": 2952, "verse_number": "१३-८२-३३", "content_sanskrit": "स्नानं प्रसाधनं भर्तुर्दन्तधावनमुञ्जनम्।\nहव्यं कव्यं च यच्चान्यद्धर्मयुक्तं गृहे भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2091740, "chapter_id": 2952, "verse_number": "१३-८२-३४", "content_sanskrit": "न तस्यां जातु तिष्ठन्त्यामन्या तत्कर्तुमर्हति।\nब्राह्मणीत्वेव कुर्याद्वा ब्राह्मणस्य युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2091741, "chapter_id": 2952, "verse_number": "१३-८२-३५", "content_sanskrit": "अन्नं पानं च माल्यं च वासांस्याभरणानि च।\nब्राह्मण्यैतानि देयानि भर्तुः सा हि गरीयसी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2091742, "chapter_id": 2952, "verse_number": "१३-८२-३६", "content_sanskrit": "मनुनाऽभिहितं शास्त्रं यच्चापि कुरुनन्दन।\nतत्राप्येष महाराज दृष्टो धर्मः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2091743, "chapter_id": 2952, "verse_number": "१३-८२-३७", "content_sanskrit": "अथ चेदन्यथा कुर्याद्यदि कामाद्युधिष्ठिर।\nयथा ब्राह्मणचाण्डालः पूर्वदृष्टस्तथैव सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2091744, "chapter_id": 2952, "verse_number": "१३-८२-३८", "content_sanskrit": "ब्राह्मण्याः सदृशः पुत्रः क्षत्रियायाश्च यो भवेत्।\nराजन्विशेषो यस्त्वत्र वर्णयोरुभयोरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2091745, "chapter_id": 2952, "verse_number": "१३-८२-३९", "content_sanskrit": "न तु जात्या समा लोके ब्राह्मण्याः क्षत्रिया भवेत्।\nब्राह्मण्याः प्रथमः पुत्रो भूयान्स्याद्राजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2091746, "chapter_id": 2952, "verse_number": "१३-८२-४०", "content_sanskrit": "भूयोभूयोपि संहार्यः पितृवित्ताद्युधिष्ठिर।\nयथा न सदृशी जातु ब्राह्मण्याः क्षत्रिया भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2091747, "chapter_id": 2952, "verse_number": "१३-८२-४१", "content_sanskrit": "क्षत्रियायास्तथा वैश्या न जातु सदृशी भवेत्।\nश्रीश्च राज्यं च कोशश्च क्षत्रियाणां युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2091748, "chapter_id": 2952, "verse_number": "१३-८२-४२", "content_sanskrit": "विहितं दृश्यते राजन्सागरान्तां च मेदिनीम्।\nक्षत्रियो हि स्वधर्मेण श्रियं प्राप्नोति भूयसीम्।\nराजा दण्डधरो राजन्रक्षा नान्यत्र क्षत्रियात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2091749, "chapter_id": 2952, "verse_number": "१३-८२-४३", "content_sanskrit": "ब्राह्मणा हि महाभाग देवानामपि देवताः।\nतेषु राजा प्रवर्तेत पूजया विधिपूर्वकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2091750, "chapter_id": 2952, "verse_number": "१३-८२-४४", "content_sanskrit": "प्रणीतमृषिभिर्ज्ञात्वा धर्मं शाश्वतमव्ययम्।\nलुप्यमानं स्वधर्मेण क्षत्रियो रक्षति प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2091751, "chapter_id": 2952, "verse_number": "१३-८२-४५", "content_sanskrit": "दस्युभिर्ह्रियमाणं च धनं दारांश्च सर्वशः।\nसर्वेषामेव वर्णानां त्राता भवति पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2091752, "chapter_id": 2952, "verse_number": "१३-८२-४६", "content_sanskrit": "भूयान्स्यात्क्षत्रियापुत्रो वैश्यापुत्रान्न संशयः।\nभूयस्तेनापि हर्तव्यं पितृवित्ताद्युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2091753, "chapter_id": 2952, "verse_number": "१३-८२-४७x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2091754, "chapter_id": 2952, "verse_number": "१३-८२-४७", "content_sanskrit": "उक्तं ते विधिवद्राजन्ब्राह्मणस्य पितामह।\nइतरेषां तु वर्णानां कथं वै नियमो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2091755, "chapter_id": 2952, "verse_number": "१३-८२-४८x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2091756, "chapter_id": 2952, "verse_number": "१३-८२-४८", "content_sanskrit": "क्षत्रियस्यापि भार्ये द्वे विहिते कुरुनन्दन।\nतृतीया च भवेच्छूद्रा न तु दृष्टा न तु स्मूता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2091757, "chapter_id": 2952, "verse_number": "१३-८२-४९", "content_sanskrit": "एष एव क्रमो हि स्यात्क्षत्रियाणां युधिष्ठिर।\nअष्टधा तु भवेत्कार्यं क्षत्रियस्वं जनाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2091758, "chapter_id": 2952, "verse_number": "१३-८२-५०", "content_sanskrit": "क्षत्रियाया हरेत्पुत्रश्चतुरोंशान्पितुर्धनात्।\nयुद्धावहारिकं यच्च पितुः स्वात्स हरेत्तु तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2091759, "chapter_id": 2952, "verse_number": "१३-८२-५१", "content_sanskrit": "वैश्यापुत्रस्तु भागांस्त्रीञ्शूद्रापुत्रस्तथाष्टमम्।\nएकैव हि भवेद्भार्या वैश्यस्य कुरुनन्दन।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2091760, "chapter_id": 2952, "verse_number": "१३-८२-५२", "content_sanskrit": "द्वितीया तु भवेच्छूद्रा न तु दृष्टा न तु स्मृता॥\nवैश्यस्य वर्तमानस्य वैश्यायां भरतर्षभ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2091761, "chapter_id": 2952, "verse_number": "१३-८२-५३", "content_sanskrit": "शूद्रायां चापि कौन्तेय तयोर्विनियमः स्मृतः॥\nपञ्चधा तु भवेत्कार्यं वैश्यस्वं भरतर्षभ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2091762, "chapter_id": 2952, "verse_number": "१३-८२-५४", "content_sanskrit": "तयोरपत्ये वक्ष्यामि विभागं च जनाधिप॥\nवैश्यापुत्रेण हर्तव्याश्चत्वारोंशाः पितुर्धनात्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2091763, "chapter_id": 2952, "verse_number": "१३-८२-५५", "content_sanskrit": "पञ्चमस्तु स्मृतोः भागः शूद्रापुत्राय भारत॥\nसोपि दत्तं हरेत्पित्रा नादत्तं हर्तुमर्हति।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2091764, "chapter_id": 2952, "verse_number": "१३-८२-५६", "content_sanskrit": "त्रिमिर्वर्णैः सदा जातः शूद्रो देयधनो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2091765, "chapter_id": 2952, "verse_number": "१३-८२-५७", "content_sanskrit": "शूद्रस्य स्यात्सवर्णैव भार्या नान्या कथञ्चन।\nसमभागाश्च पुत्राः स्युर्यदि पुत्रशतं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2091766, "chapter_id": 2952, "verse_number": "१३-८२-५८", "content_sanskrit": "जातानां समवर्णायाः पुत्राणामविशेषतः।\nसर्वेषामेव वर्णानां समभागो धनात्स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2091767, "chapter_id": 2952, "verse_number": "१३-८२-५९", "content_sanskrit": "ज्येष्ठस्य भागो ज्येष्ठः स्यादेकांशो यः प्रधानतः।\nएष दायविधिः पार्थ पूर्वमुक्तः स्वयंभुवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2091768, "chapter_id": 2952, "verse_number": "१३-८२-६०", "content_sanskrit": "समवर्णासु जातानां विशेषोऽस्त्यपरो नृप।\nविवाहवैशिष्ट्यकृतः पूर्वपूर्वो विशिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2091769, "chapter_id": 2952, "verse_number": "१३-८२-६१", "content_sanskrit": "हरेज्ज्येष्ठः प्रधानांशमेकभार्यासुतेष्वपि।\nमध्यमो मध्यमं चैव कनीयांस्तु कनीयसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2091770, "chapter_id": 2952, "verse_number": "१३-८२-६२", "content_sanskrit": "एवं जातिषु सर्वासु सवर्णः श्रेष्ठतां गतः।\nमहर्षिरपि चैतद्वै मारीचः काश्यपोऽब्रवीत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2091771, "chapter_id": 2952, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि द्व्यशीतितमोऽध्यायः॥। ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]