[{"id": 6000180000, "chapter_id": 10180, "verse_number": null, "content_sanskrit": "अथ पञ्चमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000180001, "chapter_id": 10180, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_005/BhP_09.005.001.m4a", "display_order": 2}, {"id": 6000180002, "chapter_id": 10180, "verse_number": "९-५-१", "content_sanskrit": "नाभागोऽन्यस्ततः प्राज्ञो यं मत्वा भ्रातरः कविम्।\nयविष्ठं व्यभजन् दायं ब्रह्मचारिणमाह सः॥ ९/५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_005/BhP_09.005.002.m4a", "display_order": 3, "topics": [{"text": "मनुपौत्रस्य नाभागस्य कथा", "range": "१–१२"}]}, {"id": 6000180003, "chapter_id": 10180, "verse_number": "९-५-२", "content_sanskrit": "भ्रातरोऽभाङ्क्त किं मह्यं भजान पितरं तव।\nकिं म आर्यास्तताभाङ्क्षुर्मा पुत्रक तदादृथाः॥ ९/५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_005/BhP_09.005.003.m4a", "display_order": 4}, {"id": 6000180004, "chapter_id": 10180, "verse_number": "९-५-३", "content_sanskrit": "इम अङ्गिरसः सत्रमासतेऽद्य सुमेधसः।\nषष्ठं षष्ठमुपेत्याहः कवे मुह्यन्ति कर्मणि॥ ९/५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_005/BhP_09.005.004.m4a", "display_order": 5}, {"id": 6000180005, "chapter_id": 10180, "verse_number": "९-५-४", "content_sanskrit": "तांस्त्वं शंसय सूक्ते द्वे वैश्वदेवे महात्मनः।\nते स्वर्यन्तो धनं सत्रपरिशेषितमात्मनः॥ ९/५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_005/BhP_09.005.005.m4a", "display_order": 6}, {"id": 6000180006, "chapter_id": 10180, "verse_number": "९-५-५", "content_sanskrit": "दास्यन्ति तेऽथ तान् गच्छ तथा स कृतवान् यथा।\nतस्मै दत्त्वा ययुः स्वर्गं ते सत्रपरिवेषणम्॥ ९/५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_005/BhP_09.005.006.m4a", "display_order": 7}, {"id": 6000180007, "chapter_id": 10180, "verse_number": "९-५-६", "content_sanskrit": "तं कश्चित् स्वीकरिष्यन्तं पुरुषः कृष्णदर्शनः।\nउवाचोत्तरतोऽभ्येत्य ममेदं वास्तवं वसु॥ ९/५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_005/BhP_09.005.007.m4a", "display_order": 8}, {"id": 6000180008, "chapter_id": 10180, "verse_number": "९-५-७", "content_sanskrit": "ममेदमृषिभिर्दत्तमिति तर्हि स्म मानव।\nस्यान्नौ ते पितरि प्रश्नः स गतः पितरं तथा॥ ९/५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_005/BhP_09.005.008.m4a", "display_order": 9}, {"id": 6000180009, "chapter_id": 10180, "verse_number": "९-५-८", "content_sanskrit": "यज्ञवास्तुगतं सर्वमुच्छिष्टमृषयःक्‍वचित्।\nचक्रुर्हि भागं रुद्राय स देवः सर्वमर्हति॥ ९/५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_005/BhP_09.005.009.m4a", "display_order": 10}, {"id": 6000180010, "chapter_id": 10180, "verse_number": "९-५-९", "content_sanskrit": "नाभागस्तं प्रणम्याह तवेश किल वास्तुगम्।\nइत्याह मे पिता ब्रह्मञ् शिरसा त्वां प्रसादये॥ ९/५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_005/BhP_09.005.010.m4a", "display_order": 11}, {"id": 6000180011, "chapter_id": 10180, "verse_number": "९-५-१०", "content_sanskrit": "यत् ते पिताऽवदद् धर्मं त्वं च सत्यं प्रभाषसे।\nददामि ते मन्त्रदृशो ज्ञानं ब्रह्म सनातनम्॥ ९/५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_005/BhP_09.005.011.m4a", "display_order": 12}, {"id": 6000180012, "chapter_id": 10180, "verse_number": "९-५-११", "content_sanskrit": "गृहाण द्रविणं दत्तं यत् सत्रपरिवेषितम्।\nइत्युक्त्वाऽन्तर्हितो रुद्रो भगवान् भक्तवत्सलः॥ ९/५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_005/BhP_09.005.012.m4a", "display_order": 13}, {"id": 6000180013, "chapter_id": 10180, "verse_number": "९-५-१२", "content_sanskrit": "य एतत् संस्मरेत् प्रातः सायं च सुसमाहितः।\nकविर्भवति मन्त्रज्ञो गतिं चैव तथाऽऽत्मनः॥ ९/५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_005/BhP_09.005.013.m4a", "display_order": 14}, {"id": 6000180014, "chapter_id": 10180, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां नवमस्कन्धे पञ्चमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]