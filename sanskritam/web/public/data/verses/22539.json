[{"id": 7002539000, "chapter_id": 22539, "verse_number": "१-२०१-१", "content_sanskrit": "व्यास उवाच ।\nअथ त्वां कथयिष्येहं संवादं धर्मवर्द्धनम् ।\nसुरज्येष्ठस्य देवस्य केशवस्य च भारत ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002539001, "chapter_id": 22539, "verse_number": "१-२०१-२", "content_sanskrit": "मनोवत्यां सुरज्येष्ठं सुखासीनं चतुर्मुखम् ।\nप्रणम्य शिरसा विष्णुरिदं वचनमब्रवीत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002539002, "chapter_id": 22539, "verse_number": "१-२०१-३", "content_sanskrit": "विष्णुरुवाच ।\nभगवन्देवदेवेश सुरज्येष्ठ चतुर्मुख ।\nआराधनविधिं ब्रूहि भास्करस्य महात्मनः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002539003, "chapter_id": 22539, "verse_number": "१-२०१-४", "content_sanskrit": "कथमाराधयेद्भानुं मंडलस्थं दिवस्पतिम् ।\nब्रूहि मेऽत्र गणं देवं येनाहं पूजये विभुम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002539004, "chapter_id": 22539, "verse_number": "१-२०१-५", "content_sanskrit": "साधुसाधु महाबाहो साधु पृष्टोऽ स्मि भूधर ।\nशृणु चैकमना देव भास्कराराधने विधिम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002539005, "chapter_id": 22539, "verse_number": "१-२०१-६", "content_sanskrit": "खषोल्कं निर्मलं देवं पूजयित्वा विभावसुम् ।\nपूर्वे मध्ये तथाग्नेय्यां विरूपाक्षे प्रभं जने ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002539006, "chapter_id": 22539, "verse_number": "१-२०१-७", "content_sanskrit": "क्रमेण यावदीशानीं हृदि बीजेन विन्यसेत् ।\nखषोल्कासनमेतत्तु विन्यस्तं मानवोत्तमैः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002539007, "chapter_id": 22539, "verse_number": "१-२०१-८", "content_sanskrit": "ततस्तस्योपरिष्टात्तु हृदयेन तु कंचु कम् ।\nसप्तावरणसंयुक्तमष्टपत्रं सकर्णिकम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002539008, "chapter_id": 22539, "verse_number": "१-२०१-९", "content_sanskrit": "केसरालंबदेवत्वं पंचवर्णं महाद्भुतम् ।\nपरीक्षाभूमिविधिवच्छास्त्रोक्तविधिना कृतम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002539009, "chapter_id": 22539, "verse_number": "१-२०१-१०", "content_sanskrit": "दीप्तादि पूर्वादारभ्य यावदीशानगोचरम् ।\nन्यसेच्छक्त्यष्टकं मंत्री मध्यतः सर्वतोमुखीम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002539010, "chapter_id": 22539, "verse_number": "१-२०१-११", "content_sanskrit": "दीप्ता सूक्ष्मा जया भद्रा विभूतिर्विमला तथा ।\nअमोघा विद्युता चैव नवमी सर्वतोमुखी ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002539011, "chapter_id": 22539, "verse_number": "१-२०१-१२", "content_sanskrit": "तत आवाहयेद्भानुं स्थापयेत्कर्णिकोपरि ।\nउपस्थानं तु वै कृत्वा मंत्रेणानेन सुव्रत ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002539012, "chapter_id": 22539, "verse_number": "१-२०१-१३", "content_sanskrit": "उदुत्यं जातवेदसमिति मंत्रः प्रकीर्तितः ।\nअग्निं दूतेन मंत्रेण अनेन विश्वसुव्रत ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002539013, "chapter_id": 22539, "verse_number": "१-२०१-१४", "content_sanskrit": "आकृष्णेन रजसा मंत्रेणानेन चार्चयेत् ।\nहंसःशुचिषदिति च मंत्रेणार्कं प्रपूजयेत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002539014, "chapter_id": 22539, "verse_number": "१-२०१-१५", "content_sanskrit": "अपप्तेतारकं देवीदीप्तानेन प्रपूजयेत् ।\nअदृश्रमस्यकेतवः सूक्ष्मां देवीं समर्चयेत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002539015, "chapter_id": 22539, "verse_number": "१-२०१-१६", "content_sanskrit": "तरणिर्विश्वदर्शेति अनेन सततं जयम् ।\nप्रत्यङ्देवानां विशेति भद्रां देवीं समर्चयेत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002539016, "chapter_id": 22539, "verse_number": "१-२०१-१७", "content_sanskrit": "विभूतिमर्चयेन्नित्यं येनापावकचक्षसा ।\nविद्यामेषीति मंत्रेण ह्यनेन विमलां सदा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002539017, "chapter_id": 22539, "verse_number": "१-२०१-१८", "content_sanskrit": "अमोघां पूजयेन्नित्यं मंत्रेणानेन सुव्रत ।\nनवमीं पूजयेद्देवीं सततं सर्वतोमुखीम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002539018, "chapter_id": 22539, "verse_number": "१-२०१-१९", "content_sanskrit": "मंत्रेणानेन कृष्णस्य उद्वयंतमितीह च ।\nउद्यन्नद्यमित्रहोमं प्रथममक्षरं व्रजेत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002539019, "chapter_id": 22539, "verse_number": "१-२०१-२०", "content_sanskrit": "द्वितीयं पूजयेत्कृष्णं शुक्लेषु हरिमाहवे ।\nउदगादयमादित्यो अनेनापि तृतीयकम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002539020, "chapter_id": 22539, "verse_number": "१-२०१-२१", "content_sanskrit": "तत्सवितुर्वरेण्येति चतुर्थं परिकीर्तितम् ।\nमहितोमहितोयेति पंचर्चं परिकीर्तयेत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002539021, "chapter_id": 22539, "verse_number": "१-२०१-२२", "content_sanskrit": "हिरण्यगर्भः समवर्तता षष्ठं बीजं प्रकीर्तितम् ।\nसविता पश्चातात्पुरस्तात्सप्तमं देवसत्तम ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002539022, "chapter_id": 22539, "verse_number": "१-२०१-२३", "content_sanskrit": "एवं बीजानि विन्यस्य आदित्यं स्थापयेद्द्विजः ।\nआदित्यं स्थापयेद्ध्याने सर्वेषां पूजयेद्बुधः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002539023, "chapter_id": 22539, "verse_number": "१-२०१-२४", "content_sanskrit": "बाह्यतो देवशार्दूल इन्द्रादीनां समंततः ।\nरक्तवर्णं महातेजं सितपद्मोपरि स्थितम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002539024, "chapter_id": 22539, "verse_number": "१-२०१-२५", "content_sanskrit": "सर्वलक्षणसंयुक्तं सर्वाभरणभूषितम् ।\nद्विभुजं चैकचक्रं च सौम्यं पद्मधनुष्करम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002539025, "chapter_id": 22539, "verse_number": "१-२०१-२६", "content_sanskrit": "वर्तुलं तेन बिंबेन मध्यस्थमतितेजसम् ।\nआदित्यस्य त्विदं रूपं सर्वलोकेषु पूजितम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002539026, "chapter_id": 22539, "verse_number": "१-२०१-२७", "content_sanskrit": "ध्यात्वा संपूजयेन्नित्यं स्थंडिलं मंडलाश्रितम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]