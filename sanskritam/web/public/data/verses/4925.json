[{"id": 2185080, "chapter_id": 4925, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2185081, "chapter_id": 4925, "verse_number": "१", "content_sanskrit": "पितामह महाप्राज्ञ सर्वशास्त्रविशारद ।\nशरणं पालयानस्य यो धर्मस्तं वदस्व मे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2185082, "chapter_id": 4925, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2185083, "chapter_id": 4925, "verse_number": "२", "content_sanskrit": "महान् धर्मो महाराज शरणागतपालने ।\nअर्हः प्रष्टुं भवांश्चैव प्रश्नं भरतसत्तम\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2185084, "chapter_id": 4925, "verse_number": "३", "content_sanskrit": "नृगप्रभृतयो राजन्राजानः शरणागतान् ।\nपरिपाल्य महाराज संसिद्धिं परमां गताः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2185085, "chapter_id": 4925, "verse_number": "४", "content_sanskrit": "श्रूयते हि कपोतेन शत्रुः शरणमागतः ।\nपूजितश्च यथान्यायं स्वैश्च मांसैर्निमन्त्रितः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2185086, "chapter_id": 4925, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2185087, "chapter_id": 4925, "verse_number": "५", "content_sanskrit": "कथं कपोतेन पुरा शत्रुः शरणमागतः ।\nस्वमांसैर्भोजितः कां च गतिं लेभे स भारत\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2185088, "chapter_id": 4925, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2185089, "chapter_id": 4925, "verse_number": "६", "content_sanskrit": "शृणु राजन् कथां दिव्यां सर्वपापप्रणाशिनीम् ।\nनृपतेर्मुचुकुन्दस्य कथितां भार्गवेण ह\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2185090, "chapter_id": 4925, "verse_number": "७", "content_sanskrit": "इममर्थं पुरा पार्थ मुचुकुन्दो नराधिपः ।\nभार्गवं परिपप्रच्छ प्रणतो भरतर्षभ\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2185091, "chapter_id": 4925, "verse_number": "८", "content_sanskrit": "तस्मै शुश्रूषमाणाय भार्गवोऽकथयत् कथाम् ।\nइयं यथा कपोतेन सिद्धिः प्राप्ता नराधिप\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2185092, "chapter_id": 4925, "verse_number": "९", "content_sanskrit": "धर्मनिश्चयसंयुक्तां कामार्थसहितां कथाम् ।\nशृणुष्वावहितो राजन्गदतो मे महाभुज\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2185093, "chapter_id": 4925, "verse_number": "१०", "content_sanskrit": "कश्चित् क्षुद्रसमाचारः पृथिव्यां कालसम्मतः ।\nचचार पृथिवीं पापो घोरः शकुनिलुब्धकः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2185094, "chapter_id": 4925, "verse_number": "११", "content_sanskrit": "काकोल इव कृष्णाङ्गो रूक्षः पापसमाहितः ।\nयवमध्यः कृशग्रीवो ह्रस्वपादो महाहनुः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2185095, "chapter_id": 4925, "verse_number": "१२", "content_sanskrit": "नैव तस्य सुहृत् कश्चिन्न सम्बन्धी न बान्धवः ।\nस हि तैः सम्परित्यक्तस्तेन घोरेण कर्मणा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2185096, "chapter_id": 4925, "verse_number": "१३", "content_sanskrit": "स वै क्षारकमादाय द्विजान् हत्वा वने सदा ।\nचकार विक्रयं तेषां पतङ्गानां नराधिप\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2185097, "chapter_id": 4925, "verse_number": "१४", "content_sanskrit": "एवं तु वर्तमानस्य तस्य वृत्तिं दुरात्मनः ।\nअगमत् सुमहान्कालो न चाधर्ममबुध्यत\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2185098, "chapter_id": 4925, "verse_number": "१५", "content_sanskrit": "तस्य भार्यासहायस्य रममाणस्य शाश्वतम् ।\nदैवयोगविमूढस्य नान्या वृत्तिररोचत\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2185099, "chapter_id": 4925, "verse_number": "१६", "content_sanskrit": "ततः कदाचित्तस्याथ वनस्थस्य समुद्गतः ।\nपातयन्निव वृक्षांस्तान् सुमहान् वातसम्भ्रमः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2185100, "chapter_id": 4925, "verse_number": "१७", "content_sanskrit": "मेघसङ्कुलमाकाशं विद्युन्मण्डलमण्डितम् ।\nसञ्छन्नं सुमुहूर्तेन नौसार्थेनेव सागरः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2185101, "chapter_id": 4925, "verse_number": "१८", "content_sanskrit": "वारिधारासमूहैश्च सम्प्रहृष्टः शतक्रतुः ।\nक्षणेन पूरयामास सलिलेन वसुन्धराम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2185102, "chapter_id": 4925, "verse_number": "१९", "content_sanskrit": "ततो धाराकुले लोके सम्भ्रमन्नष्टचेतनः ।\nशीतार्तस्तद्वनं सर्वमाकुलेनान्तरात्मना\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2185103, "chapter_id": 4925, "verse_number": "२०", "content_sanskrit": "नैव निम्नं स्थलं वापि सोऽविन्दत विहङ्गहा ।\nपूरितो हि जलौघेन मार्गस्तस्य वनस्य वै\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2185104, "chapter_id": 4925, "verse_number": "२१", "content_sanskrit": "पक्षिणो वातवेगेन हता लीनास्तदाभवन् ।\nमृगाः सिंहा वराहाश्च स्थलान्याश्रित्य तस्थिरे\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2185105, "chapter_id": 4925, "verse_number": "२२", "content_sanskrit": "महता वातवर्षेण त्रासितास्ते वनौकसः ।\nभयार्ताश्च क्षुधार्ताश्च बभ्रमुः सहिता वने\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2185106, "chapter_id": 4925, "verse_number": "२३", "content_sanskrit": "स तु शीतहतैर्गात्रैर्जगामैव न तस्थिवान् ।\nसोऽपश्यद्वनषण्डेषु मेघनीलं वनस्पतिम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2185107, "chapter_id": 4925, "verse_number": "२४", "content_sanskrit": "ताराढ्यं कुमुदाकारमाकाशं निर्मलं च ह ।\nमेघैर्मुक्तं नभो दृष्ट्वा लुब्धकः शीतविह्वलः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2185108, "chapter_id": 4925, "verse_number": "२५", "content_sanskrit": "दिशोऽवलोकयामास वेलां चैव दुरात्मवान् ।\nदूरे ग्रामनिवेशश्च तस्माद्देशादिति प्रभो॥\nकृतबुद्धिर्वने तस्मिन् वस्तुं तां रजनीं तदा\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2185109, "chapter_id": 4925, "verse_number": "२६", "content_sanskrit": "सोऽञ्जलिं प्रयतः कृत्वा वाक्यमाह वनस्पतिम् ।\nशरणं यामि यान्यस्मिन् दैवतानीह भारत\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2185110, "chapter_id": 4925, "verse_number": "२७", "content_sanskrit": "स शिलायां शिरः कृत्वा पर्णान्यास्तीर्य भूतले ।\nदुःखेन महताविष्टस्ततः सुष्वाप पक्षिहा\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2185111, "chapter_id": 4925, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि आपद्धर्मे त्रयोदशोऽध्यायः ॥ १३ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]