[{"id": 2104929, "chapter_id": 3261, "verse_number": "१४-११७-१", "content_sanskrit": "युधिष्ठिर उवाच।\nकीदृशानां तु शूद्राणां नानुगृह्णासि चार्चनम्।\nउद्वेगस्तव कस्माद्धि तन्मे ब्रूहि सुरेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2104930, "chapter_id": 3261, "verse_number": "१४-११७-२x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2104931, "chapter_id": 3261, "verse_number": "१४-११७-२", "content_sanskrit": "अव्रतेनाप्यभक्तेन स्पृष्टां शूद्रेण चार्चनाम्।\nतां वर्जयामि राजेन्द्र श्वपाकविहितामिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2104932, "chapter_id": 3261, "verse_number": "१४-११७-३", "content_sanskrit": "नन्वहं शङ्करश्चापि गावो विप्रास्तथैव च।\nअश्वत्थोऽमररूपं हि त्रयमेतद्युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2104933, "chapter_id": 3261, "verse_number": "१४-११७-४", "content_sanskrit": "एतत्त्रयं हि मद्भक्तो नावमन्येत कर्हिचित्।\nअवमानितमेतत्तु दहत्यासप्तमं कुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2104934, "chapter_id": 3261, "verse_number": "१४-११७-५", "content_sanskrit": "अश्वत्थो ब्राह्मणा गावो मन्मयास्तारयन्ति हि।\nतस्मादेतत्प्रयत्नेन त्रयं पूजय पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2104935, "chapter_id": 3261, "verse_number": "१४-११७-६x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2104936, "chapter_id": 3261, "verse_number": "१४-११७-६", "content_sanskrit": "ब्राह्मणेनैव देहेन कथं शूद्रत्वमाप्नुयात्।\nब्रह्म वा नश्यति कथं वक्तुं देव त्वमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2104937, "chapter_id": 3261, "verse_number": "१४-११७-७x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2104938, "chapter_id": 3261, "verse_number": "१४-११७-७", "content_sanskrit": "कूपस्नानं तु यो विप्रः कुर्याद्द्वादशवार्षिकम्।\nस तेनैव शरीरेण शूद्रत्वं यात्यसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2104939, "chapter_id": 3261, "verse_number": "१४-११७-८", "content_sanskrit": "यस्तु राजाश्रयेणैव जीवेद्द्वादशवार्षिकम्।\nस शूद्रत्वं व्रजेद्विप्रो वेदानां पारगोपि सन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2104940, "chapter_id": 3261, "verse_number": "१४-११७-९", "content_sanskrit": "पत्तने नगरे वाऽपि यो द्वादशसमा वसेत्।\nस शूद्रत्वं व्रजेद्विप्रो नात्र कार्या विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2104941, "chapter_id": 3261, "verse_number": "१४-११७-१०", "content_sanskrit": "उत्पादयति यः पुत्रं शूद्रायां काममोहितः।\nतस्य कायगतं ब्रह्म सद्य एव विनश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2104942, "chapter_id": 3261, "verse_number": "१४-११७-११", "content_sanskrit": "यः सोमलतिकां विप्रः केवलं भक्षयेद्वृथा।\nतस्य कायगतं ब्रह्म सद्य एव विनश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2104943, "chapter_id": 3261, "verse_number": "१४-११७-१२", "content_sanskrit": "मैथुनं कुरुते यस्तु जिह्वायां ब्राह्मणो नृप।\nतस्य कायगतं ब्रह्म सद्य एव विनश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2104944, "chapter_id": 3261, "verse_number": "१४-११७-१३", "content_sanskrit": "विप्रत्वं दुर्लभं प्राप्य दुर्मर्गैरेवमादिभिः।\nविनाशयन्ति ये तत्तु ताञ्शोचामि युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2104945, "chapter_id": 3261, "verse_number": "१४-११७-१४", "content_sanskrit": "तस्मात्सर्वप्रत्नेन मत्प्रियो यो युधिष्ठिर।\nजातिभ्रंशकरं कर्म न कुर्यादीदृशं द्विजः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2104946, "chapter_id": 3261, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि वैष्णवधर्मपर्वणि सप्तदशाधिकशततमोऽध्यायः॥ ११७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]