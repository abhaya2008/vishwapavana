[{"id": 6000067000, "chapter_id": 10067, "verse_number": null, "content_sanskrit": "अथ तृतीयाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000067001, "chapter_id": 10067, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_003/BhP_04.003.001.m4a", "display_order": 2}, {"id": 6000067002, "chapter_id": 10067, "verse_number": "४-३-१", "content_sanskrit": "सदा विद्विषतोरेवं कालो विवदमानयोः।\nजामातुः श्वशुरस्यापि सुमहानतिचक्रमे॥ ४/३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_003/BhP_04.003.002.m4a", "display_order": 3, "topics": [{"text": "स्वपितुर्दक्षस्य बृहस्पतिसवनामकक्रतुं प्रति गन्तुं सत्या प्रार्थितेन रुद्रेण सहेतुकं गमननिवारणम्", "range": "१–२५"}]}, {"id": 6000067003, "chapter_id": 10067, "verse_number": "४-३-२", "content_sanskrit": "यदाऽभिषिक्तो दक्षस्तु ब्रह्मणा परमेष्ठिना।\nप्रजापतीनां सर्वेषामाधिपत्ये स्मयोऽभवत्॥ ४/३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_003/BhP_04.003.003.m4a", "display_order": 4}, {"id": 6000067004, "chapter_id": 10067, "verse_number": "४-३-३", "content_sanskrit": "इष्ट्वा स वाजपेयेन ब्रह्मिष्ठो भूय एव च।\nबृहस्पतिसवं नाम समारेभे क्रतूत्तमम्॥ ४/३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_003/BhP_04.003.004.m4a", "display_order": 5}, {"id": 6000067005, "chapter_id": 10067, "verse_number": "४-३-४", "content_sanskrit": "तस्मिन् ब्रह्मर्षयः सर्वे देवर्षिपितृदेवताः।\nआसन् कृतस्वस्त्ययनास्तत्पत्न्यश्च सभर्तृकाः॥ ४/३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_003/BhP_04.003.005.m4a", "display_order": 6}, {"id": 6000067006, "chapter_id": 10067, "verse_number": "४-३-५", "content_sanskrit": "तदुपश्रुत्य नभसि खेचराणां प्रजल्पताम्।\nसती दाक्षायणी देवी पितुर्यज्ञमहोत्सवम्॥ ४/३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_003/BhP_04.003.006.m4a", "display_order": 7}, {"id": 6000067007, "chapter_id": 10067, "verse_number": "४-३-६", "content_sanskrit": "व्रजतीः सर्वतो दिग्भ्य उपदेववरस्‍त्रियः।\nविमानयाना सप्रेष्ठा निष्ककण्ठ्यः सुवाससः॥ ४/३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_003/BhP_04.003.007.m4a", "display_order": 8}, {"id": 6000067008, "chapter_id": 10067, "verse_number": "४-३-७", "content_sanskrit": "दृष्ट्वा स्वनिलयाभ्याशे लोलाक्षीर्मृष्टकुण्डलाः।\nपतिं भूतपतिं देवमौत्सुक्यादभ्यभाषत॥ ४/३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_003/BhP_04.003.008.m4a", "display_order": 9}, {"id": 6000067009, "chapter_id": 10067, "verse_number": null, "content_sanskrit": "सती उवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_003/BhP_04.003.009.m4a", "display_order": 10}, {"id": 6000067010, "chapter_id": 10067, "verse_number": "४-३-८", "content_sanskrit": "प्रजापतेस्ते श्वशुरस्य सांप्रतं निर्यापितो यज्ञमहोत्सवः किल।\nवयं च तत्राभिसराम वाम ते यद्यर्थिताऽमी विबुधा व्रजन्ति हि॥ ४/३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_003/BhP_04.003.010.m4a", "display_order": 11}, {"id": 6000067011, "chapter_id": 10067, "verse_number": "४-३-९", "content_sanskrit": "तस्मिन् भगिन्यो मम भर्तृभिः स्वकैर्ध्रुवं गमिष्यन्ति सुहृद्दिदृक्षवः।\nअहं च तस्मिन् भवताऽभिकामये सहोपनीतं परिबर्हमर्हितुम्॥ ४/३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_003/BhP_04.003.011.m4a", "display_order": 12}, {"id": 6000067012, "chapter_id": 10067, "verse_number": "४-३-१०", "content_sanskrit": "तत्र स्वसॄर्मे ननु भर्तृसंमिता मातृष्वसॄः क्लिन्नधियं च मातरम्।\nद्रक्ष्ये चिरोत्कण्ठमना महर्षिभिरुन्नीयमानं च मृडाध्वरध्वजम्॥ ४/३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_003/BhP_04.003.012.m4a", "display_order": 13}, {"id": 6000067013, "chapter_id": 10067, "verse_number": "४-३-११", "content_sanskrit": "त्वय्येतदाश्चर्यमनात्ममायया विनिर्मितं भाति गुणत्रयात्मकम्।\nअथाप्यहं योषिदतत्त्वविच्च ते दीना दिदृक्षे भव मे भवक्षितिम्॥ ४/३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_003/BhP_04.003.013.m4a", "display_order": 14}, {"id": 6000067014, "chapter_id": 10067, "verse_number": "४-३-१२", "content_sanskrit": "पश्य प्रयान्तीश्च भवान्ययोषितः स्वलंकृताः कान्तसखा वरूथशः।\nयासां व्रजद्भिः शितिकण्ठ मण्डितं नभो विमानैः कलहंसपाण्डुभिः॥ ४/३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_003/BhP_04.003.014.m4a", "display_order": 15}, {"id": 6000067015, "chapter_id": 10067, "verse_number": "४-३-१३", "content_sanskrit": "कथं सुतायाः पितृगेहकौतुकं निशम्य देहः सुरवर्य नेङ्गते।\nअनाहुता अप्यभियान्ति सौहृदाद् भर्तुर्गुरोर्देहकृतश्च केतनम्॥ ४/३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_003/BhP_04.003.015.m4a", "display_order": 16}, {"id": 6000067016, "chapter_id": 10067, "verse_number": "४-३-१४", "content_sanskrit": "तन्मे प्रसीदेदममर्त्य वाञ्छितं कर्तुं भवान् कारुणिको बतार्हसि।\nत्वयाऽपि पूर्णोऽयमदभ्रचक्षुषा निरूपितोऽतोऽनुगृहाण याचितः॥ ४/३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_003/BhP_04.003.016.m4a", "display_order": 17}, {"id": 6000067017, "chapter_id": 10067, "verse_number": null, "content_sanskrit": "ऋषिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_003/BhP_04.003.017.m4a", "display_order": 18}, {"id": 6000067018, "chapter_id": 10067, "verse_number": "४-३-१५", "content_sanskrit": "एवं गिरित्रः प्रिययाऽभिभाषितः प्रत्यभ्यधत्त प्रहसन् सुरप्रियः।\nसंस्मारितो मर्मभिदः कुवागिषून् यानाह को विश्वसृजां समक्षतः॥ ४/३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_003/BhP_04.003.018.m4a", "display_order": 19}, {"id": 6000067019, "chapter_id": 10067, "verse_number": null, "content_sanskrit": "शम्भुरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_003/BhP_04.003.019.m4a", "display_order": 20}, {"id": 6000067020, "chapter_id": 10067, "verse_number": "४-३-१६", "content_sanskrit": "त्वयोदितं शोभनमेव शोभने अनाहुता अप्यभियान्ति बन्धुषु।\nते यद्यनुत्पादितदोषदृष्टयो बलीयसाऽनात्ममदेन मन्युना॥ ४/३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_003/BhP_04.003.020.m4a", "display_order": 21}, {"id": 6000067021, "chapter_id": 10067, "verse_number": "४-३-१७", "content_sanskrit": "विद्यातपोवित्तवपुर्वयःकुलैः सतां गुणैः षड्भिरसत्तमा मदैः।\nस्मृतौ हतायामभिमानदुर्दृशस्तप्ता न पश्यन्ति हि धाम भूयसाम्॥ ४/३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_003/BhP_04.003.021.m4a", "display_order": 22}, {"id": 6000067022, "chapter_id": 10067, "verse_number": "४-३-१८", "content_sanskrit": "नैतादृशानां स्वजनव्यपेक्षया गृहान् प्रतीयादनवस्थितात्मनाम्।\nयेऽभ्यागतान् वक्रधियाऽभिचक्षते आरोपितभ्रूभिरमर्षणाक्षिभिः॥ ४/३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_003/BhP_04.003.022.m4a", "display_order": 23}, {"id": 6000067023, "chapter_id": 10067, "verse_number": "४-३-१९", "content_sanskrit": "तथाऽरिभिर्न प्रधने शिलीमुखैः शेतेऽर्दिताङ्गो हृदयेन दूयता।\nस्वानां यथा वक्रधियां दुरुक्तिभिर्दिवानिशं तप्यति मर्मताडितः॥ ४/३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_003/BhP_04.003.023.m4a", "display_order": 24}, {"id": 6000067024, "chapter_id": 10067, "verse_number": "४-३-२०", "content_sanskrit": "व्यक्तं त्वमुत्कृष्टगतेः प्रजापतेः प्रियाऽऽत्मजानामसि सुभ्रु संमता।\nअथापि मानं न पितुः प्रपत्स्यसे मदाश्रयात् कः परितप्यते यतः॥ ४/३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_003/BhP_04.003.024.m4a", "display_order": 25}, {"id": 6000067025, "chapter_id": 10067, "verse_number": "४-३-२१", "content_sanskrit": "तातप्यमानेन हृदाऽऽतुरेन्द्रियः समृद्धिभिः पूरुषबुद्धिसाक्षिणाम्।\nअकल्प एषामधिरोढुमञ्जसा पदं परं द्वेष्टि यथाऽसुरा हरिम्॥ ४/३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_003/BhP_04.003.025.m4a", "display_order": 26}, {"id": 6000067026, "chapter_id": 10067, "verse_number": "४-३-२२", "content_sanskrit": "प्रत्युद्गमप्रश्रयणाभिवादनं विधीयते साधु मिथः सुमध्यमे।\nप्राज्ञैः परस्मै पुरुषाय चेतसा गुहाशयायैव न देहमानिने॥ ४/३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_003/BhP_04.003.026.m4a", "display_order": 27}, {"id": 6000067027, "chapter_id": 10067, "verse_number": "४-३-२३", "content_sanskrit": "सत्त्वं विशुद्धं वसुदेवशब्दितं यदीयते तत्र पुमानपावृतः।\nसत्त्वं च यस्मिन् भगवान् वासुदेवो त्वधोक्षजो मे मनसा विधीयते॥ ४/३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_003/BhP_04.003.027.m4a", "display_order": 28}, {"id": 6000067028, "chapter_id": 10067, "verse_number": "४-३-२४", "content_sanskrit": "त्वया निरीक्ष्यो न पिताऽपि देहकृद् दक्षो मम द्विट् तदनुव्रताश्च ये।\nयो विश्वसृग्यज्ञगतं वरोरु मामनागसं दुर्वचसाऽकरोत् तिरः॥ ४/३/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_003/BhP_04.003.028.m4a", "display_order": 29}, {"id": 6000067029, "chapter_id": 10067, "verse_number": "४-३-२५", "content_sanskrit": "यदि व्रजिष्यस्यतिहाय मद्वचो भद्रं भवत्या न ततो भविष्यति।\nसम्भावितस्य स्वजनात् पराभवो यदा स सद्यो मरणाय कल्पते॥ ४/३/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_003/BhP_04.003.029.m4a", "display_order": 30}, {"id": 6000067030, "chapter_id": 10067, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां चतुर्थस्कन्धे तृतीयाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]