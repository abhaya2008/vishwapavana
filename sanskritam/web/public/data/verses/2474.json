[{"id": 2070291, "chapter_id": 2474, "verse_number": "११-८-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2070292, "chapter_id": 2474, "verse_number": "११-८-१", "content_sanskrit": "विदुरस्य तु तद्वाक्यं निशम्य कुरुसत्तमः।\nपुत्रशोकाभिसन्तप्तः पपात भुवि मूर्छितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2070293, "chapter_id": 2474, "verse_number": "११-८-२", "content_sanskrit": "तं तथा पतितं भूमौ निःसंज्ञं प्रेक्ष्य बान्धवाः।\nकृष्णद्वैपायनश्चैव क्षत्ता च विदुरस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2070294, "chapter_id": 2474, "verse_number": "११-८-३", "content_sanskrit": "सञ्जयः सुहृदश्चान्ये द्वास्था ये चास्य सम्मताः।\nजलेन सुखशीतेन तालवृन्तैश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2070295, "chapter_id": 2474, "verse_number": "११-८-४", "content_sanskrit": "पस्पर्शुश्च करैर्गात्रं वीजमानाश्च यत्नतः।\nअन्वासत चिरं कालं धृतराष्ट्रं तथाविधम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2070296, "chapter_id": 2474, "verse_number": "११-८-५", "content_sanskrit": "अथ दीर्घस्य कालस्य लब्धस़ञ्ज्ञो महीपतिः।\nविललाप चिरं कालं पुत्राधिभिरभिप्लुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2070297, "chapter_id": 2474, "verse_number": "११-८-६", "content_sanskrit": "धिगस्तु खलु मानुष्यं मानुष्ये च परिग्रहम्।\nयतोमूलानि दुःखानि सम्भवन्ति पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2070298, "chapter_id": 2474, "verse_number": "११-८-७", "content_sanskrit": "मित्रनाशेऽर्थनाशे च ज्ञातिसम्बन्धिनामपि।\nप्राप्यते सुमहद्दुःखं विषाग्निप्रतिमं विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2070299, "chapter_id": 2474, "verse_number": "११-८-८", "content_sanskrit": "येन दह्यन्ति गात्राणि येन प्रज्ञा विनश्यति।\nयेनाभिभूतः पुरुषो मरणं प्रतिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2070300, "chapter_id": 2474, "verse_number": "११-८-९", "content_sanskrit": "तदिदं मरणं प्राप्तं मया भाग्यविपर्ययात्।\n[तस्यान्तं नाधिगच्छामि ऋते प्राणविमोक्षणात्]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2070301, "chapter_id": 2474, "verse_number": "११-८-१०", "content_sanskrit": "तच्चैवाहं करिष्यामि अद्यैव द्विजसत्तम।\nइत्युक्त्वा तु महात्मानं पितरं ब्रह्मवित्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2070302, "chapter_id": 2474, "verse_number": "११-८-११", "content_sanskrit": "धृतराष्ट्रोऽभवन्मूढः स शोकं परमं गतः।\nअभूच्च तूष्णीं राजाऽसौ ध्यायमानो महीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2070303, "chapter_id": 2474, "verse_number": "११-८-१२", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा कृष्णद्वैपायनः प्रभुः।\nपुत्रशोकाभिसन्तप्तं पुत्रं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2070304, "chapter_id": 2474, "verse_number": "११-८-१३x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2070305, "chapter_id": 2474, "verse_number": "११-८-१३", "content_sanskrit": "धृतराष्ट्र महाबाहो शृणु वक्ष्यामि पुत्रक।\nश्रुतवानसि मेधावी धर्मार्थकुशलः प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2070306, "chapter_id": 2474, "verse_number": "११-८-१४", "content_sanskrit": "न तेऽस्त्यविदितं किञ्चिद्वेदितव्यं परन्तप।\nअनित्यतां हि भूतानां विजानासि न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2070307, "chapter_id": 2474, "verse_number": "११-८-१५", "content_sanskrit": "अध्रुवे जीवलोके च स्थाने वा शाश्वते सति।\nजीविते मरणान्ते च कस्माच्छोचसि पुत्रक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2070308, "chapter_id": 2474, "verse_number": "११-८-१६", "content_sanskrit": "प्रत्यक्षं तव राजेन्द्र वैरस्यास्य समुद्भवः।\nपुत्रं ते कारणं कृत्वा कालयोगेन निर्मितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2070309, "chapter_id": 2474, "verse_number": "११-८-१७", "content_sanskrit": "अवश्यं भवितव्ये च कुरूणां सङ्क्षये नृप।\nकस्माच्छोचसि ताञ्शूरान्गतान्परमिकां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2070310, "chapter_id": 2474, "verse_number": "११-८-१८", "content_sanskrit": "जानता च महाबाहो विदुरेण महात्मना।\nयतितं सर्वयत्नेन शमं प्रति जनेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2070311, "chapter_id": 2474, "verse_number": "११-८-१९", "content_sanskrit": "न च दैवकृतो मार्गः शक्यो भूतेन केनचित्।\nघटताऽपि चिरं कालं नियन्तुमिति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2070312, "chapter_id": 2474, "verse_number": "११-८-२०", "content_sanskrit": "देवतानां हि यत्कार्यं मया प्रत्यक्षतः श्रुतम्।\nतत्तेऽहं सम्प्रवक्ष्यामि यथा स्थैर्यं भवेत्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2070313, "chapter_id": 2474, "verse_number": "११-८-२१", "content_sanskrit": "पुराऽहं परितो यातः सभामैन्द्रीं जितक्लमः।\nअपश्यं तत्र च सदा समवेतान्दिवौकसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2070314, "chapter_id": 2474, "verse_number": "११-८-२२", "content_sanskrit": "नारदप्रमुखांश्चापि सर्वान्देवर्षिसत्तमान्।\nतत्र चापि मया दृष्टा पृथिवी पृथिवीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2070315, "chapter_id": 2474, "verse_number": "११-८-२३", "content_sanskrit": "कार्यार्थमुपसम्पन्ना देवतानां समीपतः।\nउपगम्य तदा धात्री देवानाह समागतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2070316, "chapter_id": 2474, "verse_number": "११-८-२४", "content_sanskrit": "यत्कार्यं मम युष्माभिर्ब्रह्मणः सदने तदा।\nप्रतिज्ञातं महाभागास्तच्छीघ्रं संविधीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2070317, "chapter_id": 2474, "verse_number": "११-८-२५", "content_sanskrit": "तस्यास्तद्वचनं श्रुत्वा विष्णुर्लोकनमस्कृतः।\nउवाच वाक्यं प्रहसन्प्रभुस्तां देवसंसदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2070318, "chapter_id": 2474, "verse_number": "११-८-२६", "content_sanskrit": "धृतराष्ट्रस्य पुत्राणां यस्तु ज्येष्ठः शतस्य वै।\nदुर्योधन इति ख्यातः स ते कार्यं करिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2070319, "chapter_id": 2474, "verse_number": "११-८-२७", "content_sanskrit": "तं च प्राप्य महीपालं कृतकृत्या भविष्यसि।\nतस्यार्थे पृथिवीपालाः कुरुक्षेत्रं समागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2070320, "chapter_id": 2474, "verse_number": "११-८-२८", "content_sanskrit": "अन्योन्यं घातयिष्यन्ति दृढैः शस्त्रैः प्रहारिणः।\nततस्ते भविता देवि भारस्य युधि नाशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2070321, "chapter_id": 2474, "verse_number": "११-८-२९", "content_sanskrit": "गच्छ शीघ्रं स्वकं स्थानं लोकान्धारय शोभने।\nस एष ते सुतो राजँल्लोकसंहारकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2070322, "chapter_id": 2474, "verse_number": "११-८-३०", "content_sanskrit": "कलेरंशः समुत्पन्नो गान्धार्या जठरे नृप।\nअमर्षी बलवाञ्शूरः क्रोधनो दुष्प्रसाधनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2070323, "chapter_id": 2474, "verse_number": "११-८-३१", "content_sanskrit": "दैवयोगात्समुत्पन्ना भ्रातरस्तस्य तादृशाः।\nशकुनिर्मातुलश्चैव कर्णश्च परमः सखा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2070324, "chapter_id": 2474, "verse_number": "११-८-३२", "content_sanskrit": "समुत्पन्ना विनाशार्थं पृथिव्यां सहिता नृपाः।\n[यादृशो जायते राजा तादृशोऽस्य जनो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2070325, "chapter_id": 2474, "verse_number": "११-८-३३", "content_sanskrit": "अधर्मो धर्मतां याति स्वामी चेद्धार्मिको भवेत्।\nस्वामिनो गुणदोषाभ्यां भृत्याः स्युर्नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2070326, "chapter_id": 2474, "verse_number": "११-८-३४", "content_sanskrit": "दुष्टं राजानमासाद्य गतास्ते तनया नृप।]\nएतमर्थं महाबाहो नारदो वेद तत्त्ववित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2070327, "chapter_id": 2474, "verse_number": "११-८-३५", "content_sanskrit": "आत्मापराधात्पुत्रास्ते विनष्टाः पृथिवीपते।\nमा ताञ्शोचस्व राजेन्द्र न हि शोकेऽस्ति कारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2070328, "chapter_id": 2474, "verse_number": "११-८-३६", "content_sanskrit": "न हि ते पाण्डवाः स्वल्पमपराध्यन्ति भारत।\nपुत्रास्तव दुरात्मानो यैरियं घातिता मही॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2070329, "chapter_id": 2474, "verse_number": "११-८-३७", "content_sanskrit": "नारदेन च भद्रं ते पूर्वमेव न संशयः।\nयुधिष्ठिरस्य समितौ राजसूये निवेदितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2070330, "chapter_id": 2474, "verse_number": "११-८-३८", "content_sanskrit": "पाण्डवाः कौरवाः सर्वे समासाद्य परस्परम्।\nनभविष्यन्ति कौन्तेय यत्ते कृत्यं तदाचर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2070331, "chapter_id": 2474, "verse_number": "११-८-३९", "content_sanskrit": "नारदस्य वचः श्रुत्वा तथाऽकुर्वत पाण्डवाः।\nएतत्ते सर्वमाख्यातं देवगुह्यं सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2070332, "chapter_id": 2474, "verse_number": "११-८-४०", "content_sanskrit": "कथं ते शोकनाशः स्यात्प्राणेषु च दया प्रभो।\nस्नेहश्च पाण्डुपुत्रेषु ज्ञात्वा दैवकृतं विधिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2070333, "chapter_id": 2474, "verse_number": "११-८-४१", "content_sanskrit": "एष चार्थो महाबाहो पूर्वमेव मया श्रुतः।\nकथितो धर्मराजस्य राजसूये कुरूत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2070334, "chapter_id": 2474, "verse_number": "११-८-४२", "content_sanskrit": "यतितं धर्मपुत्रेण मया गुह्ये निवेदिते।\nअविग्रहे कौरवाणां दैवं तु बलवत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2070335, "chapter_id": 2474, "verse_number": "११-८-४३", "content_sanskrit": "अनतिक्रमणीयो हि विधी राजन्कथञ्चन।\nकृतान्तस्य तु भूतेन स्थावरेण चरेण च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2070336, "chapter_id": 2474, "verse_number": "११-८-४४", "content_sanskrit": "भवान्धर्मपरो यत्र बुद्धिश्रेष्ठश्च भारत।\nमुह्यते प्राणिनां ज्ञात्वा गतिं चागतिमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2070337, "chapter_id": 2474, "verse_number": "११-८-४५", "content_sanskrit": "त्वां तु शोकेन सन्तप्तं मुह्यमानं मुहुर्मुहुः।\nज्ञात्वा युधिष्ठिरो राजा प्राणानपि परित्यजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2070338, "chapter_id": 2474, "verse_number": "११-८-४६", "content_sanskrit": "कृपालुर्नित्यशो वीरस्तिर्यग्योनिगतेष्वपि।\nस कथं त्वयि राजेन्द्र कृपां नैव करिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2070339, "chapter_id": 2474, "verse_number": "११-८-४७", "content_sanskrit": "मम चैव नियोगेन विधेश्चाप्यनिवर्तनाम्।\nपाण्डवानां च कारुण्यात्प्राणान्धारय भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2070340, "chapter_id": 2474, "verse_number": "११-८-४८", "content_sanskrit": "एवं ते वर्तमानस्य लोके कीर्तिर्भविष्यति।\nधर्मार्थः सुमहांस्तात तप्तं स्याच्च तपश्चिरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2070341, "chapter_id": 2474, "verse_number": "११-८-४९", "content_sanskrit": "पुत्रशोकं समुत्पन्नं हुताशं ज्वलितं यथा।\nप्रज्ञाम्भसा महाराज निर्वापय सदा सता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2070342, "chapter_id": 2474, "verse_number": "११-८-५०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2070343, "chapter_id": 2474, "verse_number": "११-८-५०", "content_sanskrit": "तच्छ्रुत्वा तस्य वचनं व्यासस्यामिततेजसः।\nमुहूर्तं समनुध्यायन्धृतराष्ट्रोऽभ्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2070344, "chapter_id": 2474, "verse_number": "११-८-५१", "content_sanskrit": "महता शोकजालेन प्रणुन्नोऽस्मि द्विजोत्तम।\nनात्मानमवबुध्यामि मुह्यमानो मुहुर्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2070345, "chapter_id": 2474, "verse_number": "११-८-५२", "content_sanskrit": "इदं तु वचनं श्रुत्वा तव देवनियोगजम्।\nधारयिष्याम्यहं प्राणान्यतिष्ये च न शोचितुं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2070346, "chapter_id": 2474, "verse_number": "११-८-५३", "content_sanskrit": "एतच्छ्रुत्वा तु वचनं व्यासः सत्यवतीसुतः।\nधृतराष्ट्रस्य राजेन्द्र तत्रैवान्तरधीयत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2070347, "chapter_id": 2474, "verse_number": "११-८-०", "content_sanskrit": "इति श्रीमन्महाभारते स्त्रीपर्वणि जलप्रदानिकपर्वणि अष्टमोऽध्यायः॥ ८ ॥*\nस्त्रीपर्व - अध्याय ००८*\n॥ श्रीः ॥\n११.८. अध्यायः ००८\nMahabharata - Strii Parva - Chapter Topics\nव्यासेन धृतराष्ट्रस्य शोकापनोदनम्॥ १ ॥\nMahabharata - Strii Parva - Chapter Text", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2070348, "chapter_id": 2474, "verse_number": "११-८-०x", "content_sanskrit": "[जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2070349, "chapter_id": 2474, "verse_number": "११-८-१", "content_sanskrit": "गते भगवति व्यासे धृतराष्ट्रो महीपतिः।\nकिमचेष्टत विप्रर्षे तन्मे व्याख्यातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2070350, "chapter_id": 2474, "verse_number": "११-८-२", "content_sanskrit": "तथैव कौरवो राजा धर्मपुत्रो महामनाः।\nकृपप्रभृतयश्चैव किमकुर्वत ते त्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2070351, "chapter_id": 2474, "verse_number": "११-८-३", "content_sanskrit": "अश्वत्थाम्नः श्रुतं कर्म शापश्चान्योन्यकारितः।\nवृत्तान्तमुत्तरं ब्रूहि यदभाषत सञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2070352, "chapter_id": 2474, "verse_number": "११-८-४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2070353, "chapter_id": 2474, "verse_number": "११-८-४", "content_sanskrit": "हते दुर्योधने चैव हते सैन्ये च सर्वशः।\nसञ्जयो विगतप्रज्ञो धृतराष्ट्रमुपस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2070354, "chapter_id": 2474, "verse_number": "११-८-५x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2070355, "chapter_id": 2474, "verse_number": "११-८-५", "content_sanskrit": "आगम्य नानादेशेभ्यो नानाजनपदेश्वराः।\nपितृलोकं गता राजन्सर्वे तव सुतैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2070356, "chapter_id": 2474, "verse_number": "११-८-६", "content_sanskrit": "याच्यमानेन सततं तव पुत्रेण भारत।\nघातिता पृथिवी सर्वा वैरस्यान्तं विधित्सता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2070357, "chapter_id": 2474, "verse_number": "११-८-७", "content_sanskrit": "पुत्राणामथ पौत्राणां पितॄणां च महीपते।\nआनुपूर्व्येण सर्वेषां प्रेतकार्याणि कारय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2070358, "chapter_id": 2474, "verse_number": "११-८-८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2070359, "chapter_id": 2474, "verse_number": "११-८-८", "content_sanskrit": "तच्छ्रुत्वा वचनं घोरं सञ्जयस्य महीपतिः।\nगतासुरिव निश्चेष्टो न्यपतत्पृथिवीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2070360, "chapter_id": 2474, "verse_number": "११-८-९", "content_sanskrit": "तं शयानमुपागम्य पृथिव्यां पृथिवीपतिम्।\nविदुरः सर्वधर्मज्ञ इदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2070361, "chapter_id": 2474, "verse_number": "११-८-१०", "content_sanskrit": "उत्तिष्ठ राजन्किं शेषे मा शुचो भरतर्षभ।\nएषा वै सर्वसत्वानां लोकेश्वर परा गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2070362, "chapter_id": 2474, "verse_number": "११-८-११", "content_sanskrit": "अभावादीनि भूतानि भावमध्यानि भारत।\nअभावनिधनान्येव तत्र का परिदेवना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2070363, "chapter_id": 2474, "verse_number": "११-८-१२", "content_sanskrit": "न शोचन्मृतमन्वेति न शोचन्म्रियते नरः।\nएवं सांसिद्धिके लोके किमर्थमनुशोचसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2070364, "chapter_id": 2474, "verse_number": "११-८-१३", "content_sanskrit": "अयुध्यमानो म्रियते युध्यमानस्तु जीवति।\nकालं प्राप्य महाराज न कश्चिदतिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2070365, "chapter_id": 2474, "verse_number": "११-८-१४", "content_sanskrit": "कालः कर्षति भूतानि सर्वाणि विविधानि च।\nन कालस्य प्रियः कश्चिन्न द्वेष्यः कुरुसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2070366, "chapter_id": 2474, "verse_number": "११-८-१५", "content_sanskrit": "यथा वायुस्तृणाग्राणि संवर्तपति सर्वतः।\nतथा कालवशं यान्ति भूतानि भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2070367, "chapter_id": 2474, "verse_number": "११-८-१६", "content_sanskrit": "एकसार्थप्रयातानां सर्वेषां तत्र गामिनाम्।\nयस्य कालः प्रयात्यग्रे तत्र का परिदेवना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2070368, "chapter_id": 2474, "verse_number": "११-८-१७", "content_sanskrit": "यांश्चापि निहतान्युद्धे राजंस्त्वमनुशोचसि।\nन शोच्या हि माहत्मानः सर्वे ते त्रिदिवं गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2070369, "chapter_id": 2474, "verse_number": "११-८-१८", "content_sanskrit": "न यज्ञैर्दक्षिणावद्भिर्न तपोभिर्न विद्यया।\nतथा स्वर्गमुपायान्ति यथा शूरास्तनुत्यजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2070370, "chapter_id": 2474, "verse_number": "११-८-१९", "content_sanskrit": "सर्वे वेदविदः शूराः सर्वे सुचरितव्रताः।\nसर्वे चाभिमुखाः क्षीणास्तत्र का परिदेवना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2070371, "chapter_id": 2474, "verse_number": "११-८-२०", "content_sanskrit": "शरीराग्निषु शूराणां जुहुवुस्ते शराहुतीः।\nहूयमानाञ्शरांश्चैव सेहुरुत्तमपूरषाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2070372, "chapter_id": 2474, "verse_number": "११-८-२१", "content_sanskrit": "एवं राजंस्तवाचक्षे स्वर्ग्यं पन्थानमुत्तमम्।\nन युद्धादधिकं किञ्चित्क्षत्रियस्येह विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2070373, "chapter_id": 2474, "verse_number": "११-८-२२", "content_sanskrit": "क्षत्रियास्ते महात्मानः शूराः समितिशोभनाः।\nआशिषं परमां प्राप्ता न शोच्याः सर्व एव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2070374, "chapter_id": 2474, "verse_number": "११-८-२३", "content_sanskrit": "आत्मनाऽऽत्मानमाश्वास्य मा शुचः पुरुषर्षभ।\nनाद्य शोकाभिभूतस्त्वं कार्यमुत्स्नष्टुमर्हसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2070375, "chapter_id": 2474, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते स्त्रीपर्वणि जलप्रदानिकपर्वणि अध्यायः॥\nMahabharata - Strii Parva - Chapter Footnotes\n११-८-२९ कालः संहारकारणादिति क.छ.ठ.पाठः॥ ११-८-३७ नारदेन समाख्यातमिति क.छ.ठ.पाठः॥ ११-८-३९ तदाऽशोचन्त पाण्डवा इति झ.पाठः॥ ११-८-४८ धर्मश्च सुमहास्तात तप्तस्य तपसश्चिरादिति क.छ.ठ.पाठः॥ ११-८-८ अष्टमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}]