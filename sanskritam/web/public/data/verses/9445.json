[{"id": 5000445000, "chapter_id": 9445, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे अष्टात्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000445001, "chapter_id": 9445, "verse_number": "६-३८-१", "content_sanskrit": "स तु कृत्वा सुवेलस्य मतिमारोहणं प्रति।\nलक्ष्मणानुगतो रामः सुग्रीवमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000445002, "chapter_id": 9445, "verse_number": "६-३८-२", "content_sanskrit": "विभीषणं च धर्मज्ञमनुरक्तं निशाचरम्।\nमन्त्रज्ञं च विधिज्ञं च श्लक्ष्णया परया गिरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000445003, "chapter_id": 9445, "verse_number": "६-३८-३", "content_sanskrit": "सुवेलं साधु शैलेन्द्रमिमं धातुशतैश्चितम्।\nअध्यारोहामहे सर्वे वत्स्यामोऽत्र निशामिमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000445004, "chapter_id": 9445, "verse_number": "६-३८-४", "content_sanskrit": "लङ्कां चालोकयिष्यामो निलयं तस्य रक्षसः।\nयेन मे मरणान्ताय हृता भार्या दुरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000445005, "chapter_id": 9445, "verse_number": "६-३८-५", "content_sanskrit": "येन धर्मो न विज्ञातो न वृत्तं न कुलं तथा।\nराक्षस्या नीचया बुद्ध्या येन तद् गर्हितं कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000445006, "chapter_id": 9445, "verse_number": "६-३८-६", "content_sanskrit": "तस्मिन् मे वर्तते रोषः कीर्तिते राक्षसाधमे।\nयस्यापराधान्नीचस्य वधं द्रक्ष्यामि रक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000445007, "chapter_id": 9445, "verse_number": "६-३८-७", "content_sanskrit": "एको हि कुरुते पापं कालपाशवशं गतः।\nनीचेनात्मापचारेण कुलं तेन विनश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000445008, "chapter_id": 9445, "verse_number": "६-३८-८", "content_sanskrit": "एवं सम्मन्त्रयन् नेव सक्रोधो रावणं प्रति।\nरामः सुवेलं वासाय चित्रसानुमुपारुहत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000445009, "chapter_id": 9445, "verse_number": "६-३८-९", "content_sanskrit": "पृष्ठतो लक्ष्मणश्चैनमन्वगच्छत् समाहितः।\nसशरं चापमुद्यम्य सुमहद्विक्रमे रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000445010, "chapter_id": 9445, "verse_number": "६-३८-१०", "content_sanskrit": "तमन्वारोहत् सुग्रीवः सामात्यः सविभीषणः।\nहनुमानङ्गदो नीलो मैन्दो द्विविद एव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000445011, "chapter_id": 9445, "verse_number": "६-३८-११", "content_sanskrit": "गजो गवाक्षो गवयः शरभो गन्धमादनः।\nपनसः कुमुदश्चैव हरो रम्भश्च यूथपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000445012, "chapter_id": 9445, "verse_number": "६-३८-१२", "content_sanskrit": "जाम्बवांश्च सुषेणश्च ऋषभश्च महामतिः।\nदुर्मुखश्च महातेजास्तथा शतवलिः कपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000445013, "chapter_id": 9445, "verse_number": "६-३८-१३", "content_sanskrit": "एते चान्ये च बहवो वानराः शीघ्रगामिनः।\nते वायुवेगप्रवणास्तं गिरिं गिरिचारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000445014, "chapter_id": 9445, "verse_number": "६-३८-१४", "content_sanskrit": "अध्यारोहन्त शतशः सुवेलं यत्र राघवः।\nते त्वदीर्घेण कालेन गिरिमारुह्य सर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000445015, "chapter_id": 9445, "verse_number": "६-३८-१५", "content_sanskrit": "ददृशुः शिखरे तस्य विषक्तामिव खे पुरीम्।\nतां शुभां प्रवरद्वारां प्राकारवरशोभिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000445016, "chapter_id": 9445, "verse_number": "६-३८-१६", "content_sanskrit": "लङ्कां राक्षससम्पूर्णां ददृशुर्हरियूथपाः।\nप्राकारवरसंस्थैश्च तथा नीलैश्च राक्षसैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000445017, "chapter_id": 9445, "verse_number": "६-३८-१७", "content_sanskrit": "ददृशुस्ते हरिश्रेष्ठाः प्राकारमपरं कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000445018, "chapter_id": 9445, "verse_number": "६-३८-१८", "content_sanskrit": "ते दृष्ट्वा वानराः सर्वे राक्षसान् युद्धकाङ्क्षिणः।\nमुमुचुर्विविधान् नादांस्तस्य रामस्य पश्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000445019, "chapter_id": 9445, "verse_number": "६-३८-१९", "content_sanskrit": "ततोऽस्तमगमत् सूर्यः संध्यया प्रतिरञ्जितः।\nपूर्णचन्द्रप्रदीप्ता च क्षपा समतिवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000445020, "chapter_id": 9445, "verse_number": "६-३८-२०", "content_sanskrit": "ततः स रामो हरिवाहिनीपति-\nर्विभीषणेन प्रतिनन्द्य सत्कृतः।\nसलक्ष्मणो यूथपयूथसंयुतः\nसुवेलपृष्ठे न्यवसद् यथासुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000445021, "chapter_id": 9445, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे अष्टात्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]