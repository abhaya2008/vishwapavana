[{"id": 2002743, "chapter_id": 1061, "verse_number": "१-६२-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2002744, "chapter_id": 1061, "verse_number": "१-६२-१", "content_sanskrit": "कथितं वै समासेन त्वया सर्वं द्विजोत्तम।\nमहाभारतमाख्यानं कुरूणां चरितं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2002745, "chapter_id": 1061, "verse_number": "१-६२-२", "content_sanskrit": "कथां त्वनघ चित्रार्थां कथयस्व तपोधन।\nविस्तरश्रवणे जातं कौतूहलमतीव मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2002746, "chapter_id": 1061, "verse_number": "१-६२-३", "content_sanskrit": "स भवान्विस्तरेणेमां पुनराख्यातुमर्हति।\nन हि तृप्यामि पूर्वेषां शृण्वानश्चरितं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2002747, "chapter_id": 1061, "verse_number": "१-६२-४", "content_sanskrit": "न तत्कारणमल्पं वै धर्मज्ञा यत्र पाण्डवाः।\nअवध्यान्सर्वशो जघ्नुः प्रशस्यन्ते च मानवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2002748, "chapter_id": 1061, "verse_number": "१-६२-५", "content_sanskrit": "किमर्थं ते नरव्याघ्राः शक्ताः सन्तो ह्यनागसः।\nप्रयुज्यमानान्संक्लेशान्क्षान्तवन्तो दुरात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2002749, "chapter_id": 1061, "verse_number": "१-६२-६", "content_sanskrit": "कथं नागायुतप्राणो बाहुशाली वृकोदरः।\nपरिक्लिश्यन्नपि क्रोधं धृतवान्वै द्विजोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2002750, "chapter_id": 1061, "verse_number": "१-६२-७", "content_sanskrit": "कथं सा द्रौपदी कृष्णा क्लिश्यमाना दुरात्मभिः।\nशक्ता सती धार्तराष्ट्रान्नादहत्क्रोधचक्षुषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2002751, "chapter_id": 1061, "verse_number": "१-६२-८", "content_sanskrit": "कथं व्यसनिनं द्यूते पार्थौ माद्रीसुतौ तदा।\nअन्वयुस्ते नरव्याघ्रा बाध्यमाना दुरात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2002752, "chapter_id": 1061, "verse_number": "१-६२-९", "content_sanskrit": "कथं धर्मभृतां श्रेष्ठः सुतो धर्मस्य धर्मवित्।\nअनर्हः परमं क्लेशं सोढवान्स युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2002753, "chapter_id": 1061, "verse_number": "१-६२-१०", "content_sanskrit": "कथं च बहुलाः सेनाः पाण्डवः कृष्णसारथिः।\nअस्यन्नेकोऽनयत्सर्वाः पितृलोकं धनंजयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2002754, "chapter_id": 1061, "verse_number": "१-६२-११", "content_sanskrit": "एतदाचक्ष्व मे सर्वं यथावृत्तं तपोधन।\nयद्यच्च कृतवन्तस्ते तत्रतत्र महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2002755, "chapter_id": 1061, "verse_number": "१-६२-१२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2002756, "chapter_id": 1061, "verse_number": "१-६२-१२", "content_sanskrit": "क्षणं कुरु महाराज विपुलोऽयमनुक्रमः।\nपुण्याख्यानस्य वक्तव्यः कृष्णद्वैपायनेरितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2002757, "chapter_id": 1061, "verse_number": "१-६२-१३", "content_sanskrit": "महर्षेः सर्वलोकेषु पूजितस्य महात्मनः।\nप्रवक्ष्यामि मतं कृत्स्नं व्यासस्यामिततेजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2002758, "chapter_id": 1061, "verse_number": "१-६२-१४", "content_sanskrit": "इदं शतसहस्रं हि श्लोकानां पुण्यकर्मणाम्।\nसत्यवत्यात्मजेनेह व्याख्यातममितौजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2002759, "chapter_id": 1061, "verse_number": "१-६२-१५", "content_sanskrit": "उपाख्यानैः सह ज्ञेयं श्राव्यं भारतमुत्तमम्।\nसंक्षेपेण तु वक्ष्यामि सर्वमेतन्नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2002760, "chapter_id": 1061, "verse_number": "१-६२-१६", "content_sanskrit": "अध्यायानां सहस्रे द्वे पर्वणां शतमेव च।\nश्लोकानां तु सहस्राणि नवतिश्च दशैव च।\nततोऽष्टादशभिः पर्वैः संगृहीतं महर्षिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2002761, "chapter_id": 1061, "verse_number": "१-६२-१७", "content_sanskrit": "य इदं श्रावयेद्विद्वान्ये चेदं शृणुयुर्नराः।\nते ब्रह्मणः स्थानमेत्य प्राप्नुयुर्देवतुल्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2002762, "chapter_id": 1061, "verse_number": "१-६२-१८", "content_sanskrit": "इदं हि वेदैः समितं पवित्रमपि चोत्तमम्।\nश्राव्याणामुत्तमं चेदं पुराणमृषिसंस्तुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2002763, "chapter_id": 1061, "verse_number": "१-६२-१९", "content_sanskrit": "अस्मिन्नर्थश्च कामश्च निखिलेनोपदेक्ष्यते।\nइतिहासे महापुण्ये बुद्धिश्च परिनैष्ठिकी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2002764, "chapter_id": 1061, "verse_number": "१-६२-२०", "content_sanskrit": "अक्षुद्रान्दानशीलांश्च सत्यशीलाननास्तिकान्।\nकार्ष्णं वेदमिमं विद्वाञ्छ्रावयित्वाऽर्थमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2002765, "chapter_id": 1061, "verse_number": "१-६२-२१", "content_sanskrit": "भ्रूणहत्याकृतं चापि पापं जह्यादसंशयम्।\nइतिहासमिमं श्रुत्वा पुरुषोऽपि सुदारुणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2002766, "chapter_id": 1061, "verse_number": "१-६२-२२", "content_sanskrit": "मुच्यते सर्वपापेभ्यो राहुणा चन्द्रमा यथा।\nजयो नामेतिहासोऽयं श्रोतव्यो विजिगीषुणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2002767, "chapter_id": 1061, "verse_number": "१-६२-२३", "content_sanskrit": "महीं विजयते राजा शत्रूंश्चापि पराजयेत्।\nइदं पुंसवनं श्रेष्ठमिदं स्वस्त्ययनं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2002768, "chapter_id": 1061, "verse_number": "१-६२-२४", "content_sanskrit": "महिषीयुवराजाभ्यां श्रोतव्यं बहुशस्तथा।\nवीरं जनयते पुत्रं कन्यां वा राज्यभागिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2002769, "chapter_id": 1061, "verse_number": "१-६२-२५", "content_sanskrit": "धर्मशास्त्रमिदं पुण्यमर्थशास्त्रमिदं परम्।\nमोक्षशास्त्रमिदं प्रोक्तं व्यासेनामितबुद्धिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2002770, "chapter_id": 1061, "verse_number": "१-६२-२६", "content_sanskrit": "धर्मे चार्थे च कामे च मोक्षे च भरतर्षभ।\nयदिहास्ति तदन्यत्र यन्नेहास्ति न कुत्रचित्।\nइदं हि ब्राह्मणैर्लोके आख्यातं ब्राह्मणेष्विह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2002771, "chapter_id": 1061, "verse_number": "१-६२-२७", "content_sanskrit": "संप्रत्याचक्षते चेदं तथा श्रोष्यन्ति चापरे।\nपुत्राः शुश्रूषवः सन्ति प्रेष्याश्च प्रियकारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2002772, "chapter_id": 1061, "verse_number": "१-६२-२८", "content_sanskrit": "भरतानां महज्जन्म शृण्वतामनसूयताम्।\nनास्ति व्याधिभयं तेषां परलोकभयं कुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2002773, "chapter_id": 1061, "verse_number": "१-६२-२९", "content_sanskrit": "शरीरेण कृतं पापं वाचा च मनसैव च।\nसर्वं संत्यजति क्षिप्रं य इदं शृणुयान्नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2002774, "chapter_id": 1061, "verse_number": "१-६२-३०", "content_sanskrit": "धन्यं यशस्यमायुष्यं पुण्यं स्वर्ग्यं तथैव च।\nकृष्णद्वैपायनेनेदं कृतं पुण्यचिकीर्षुणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2002775, "chapter_id": 1061, "verse_number": "१-६२-३१", "content_sanskrit": "कीर्तिं प्रथयता लोके पाण्डवानां महात्मनाम्।\nअन्येषां क्षत्रियाणां च भूरिद्रविणतेजसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2002776, "chapter_id": 1061, "verse_number": "१-६२-३२", "content_sanskrit": "सर्वविद्यावदातानां लोके प्रथितकर्मणाम्।\nय इदं मानवो लोके पुण्यार्थे ब्राह्मणाञ्छुचीन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2002777, "chapter_id": 1061, "verse_number": "१-६२-३३", "content_sanskrit": "श्रावयेत महापुण्यं तस्य धर्मः सनातनः।\nकुरूणां प्रथितं वंशं कीर्तयन्सततं शुचिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2002778, "chapter_id": 1061, "verse_number": "१-६२-३४", "content_sanskrit": "वंशमाप्नोति विपुलं लोके पूज्यतमो भवेत्।\nयोऽधीते भारतं पुम्यं ब्राह्मणो नियतव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2002779, "chapter_id": 1061, "verse_number": "१-६२-३५", "content_sanskrit": "चतुरो वार्षिकान्मासान्सर्वपापैः प्रमुच्यते।\nविज्ञेयः स च वेदानां पारगो भारतं पठन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2002780, "chapter_id": 1061, "verse_number": "१-६२-३६", "content_sanskrit": "देवा राजर्षयो ह्यत्र पुण्या ब्रह्मर्षयस्तथा।\nकीर्त्यन्ते धूतपाप्मानः कीर्त्यते केशवस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2002781, "chapter_id": 1061, "verse_number": "१-६२-३७", "content_sanskrit": "भगवांश्चापि देवेशो यत्र देवी च कीर्त्यते।\nअनेकजननो यत्र कार्तिकेयस्य संभवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2002782, "chapter_id": 1061, "verse_number": "१-६२-३८", "content_sanskrit": "ब्राह्मणानां गवां चैव माहात्म्यं यत्र कीर्त्यते।\nसर्वश्रुतिसमूहोऽयं श्रोतव्यो धर्मबुद्धिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2002783, "chapter_id": 1061, "verse_number": "१-६२-३९", "content_sanskrit": "य इदं श्रावयेद्विद्वान्ब्राह्मणानिह पर्वसु।\nधूतपाप्मा जितस्वर्गो ब्रह्म गच्छति शाश्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2002784, "chapter_id": 1061, "verse_number": "१-६२-४०", "content_sanskrit": "श्रावयेद्ब्राह्मणाञ्श्राद्धे यश्चेमं पादमन्ततः।\nअक्षय्यं तस्य तच्छ्राद्धमुपावर्तेत्पितॄनिह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2002785, "chapter_id": 1061, "verse_number": "१-६२-४१", "content_sanskrit": "अह्ना यदेनः क्रियते इन्द्रियैर्मनसाऽपि वा।\nज्ञानादज्ञानतो वापि प्रकरोति नरश्च यत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2002786, "chapter_id": 1061, "verse_number": "१-६२-४२", "content_sanskrit": "तन्महाभारताख्यानं श्रुत्वैव प्रविलीयते।\nभरतानां महज्जन्म महाभारतमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2002787, "chapter_id": 1061, "verse_number": "१-६२-४३", "content_sanskrit": "निरुक्तमस्य यो वेद सर्वपापैः प्रमुच्यते।\nभरतानां महज्जन्म महाभारतमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2002788, "chapter_id": 1061, "verse_number": "१-६२-४४", "content_sanskrit": "महतो ह्येनसो मर्त्यान्मोचयेदनुकीर्तितः।\nत्रिभिर्वर्षैर्महाभागः कृष्णद्वैपायनोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2002789, "chapter_id": 1061, "verse_number": "१-६२-४५", "content_sanskrit": "नित्योत्थितः शुचिः शक्तो महाभारतमादितः।\nतपोनियममास्थाय कृतमेतन्महर्षिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2002790, "chapter_id": 1061, "verse_number": "१-६२-४६", "content_sanskrit": "तस्मान्नियमसंयुक्तैः श्रोतव्यं ब्राह्मणैरिदम्।\nकृष्णप्रोक्तामिमां पुण्यां भारतीमुत्तमां कथाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2002791, "chapter_id": 1061, "verse_number": "१-६२-४७", "content_sanskrit": "श्रावयिष्यन्ति ये विप्रा ये च श्रोष्यन्ति मानवाः।\nसर्वथा वर्तमाना वै न ते शोच्याः कृताकृतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2002792, "chapter_id": 1061, "verse_number": "१-६२-४८", "content_sanskrit": "नरेण धर्मकामेन सर्वः श्रोतव्य इत्यपि।\nनिखिलेनेतिहासोऽयं ततः सिद्धिमवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2002793, "chapter_id": 1061, "verse_number": "१-६२-४९", "content_sanskrit": "न तां स्वर्गगतिं प्राप्य तुष्टिं प्राप्नोति मानवः।\nयां श्रुत्वैवं महापुण्यमितिहासमुपाश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2002794, "chapter_id": 1061, "verse_number": "१-६२-५०", "content_sanskrit": "शृण्वञ्श्राद्धः पुण्यशीलः श्रावयंश्चेदमद्भुतम्।\nनरः फलमवाप्नोति राजसूयाश्वमेधयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2002795, "chapter_id": 1061, "verse_number": "१-६२-५१", "content_sanskrit": "यथा समुद्रो भगवान्यथा मेरुर्महागिरिः।\nउभौ ख्यातौ रत्ननिधी तथा भारतमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2002796, "chapter_id": 1061, "verse_number": "१-६२-५२", "content_sanskrit": "इदं हि वेदैः समितं पवित्रमषि चोत्तमम्।\nश्राव्यं श्रुतिसुखं चैव पावनं शीलवर्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2002797, "chapter_id": 1061, "verse_number": "१-६२-५३", "content_sanskrit": "य इदं भारतं राजन्वाचकाय प्रयच्छति।\nतेन सर्वा मही दत्ता भवेत्सागरमेखला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2002798, "chapter_id": 1061, "verse_number": "१-६२-५४", "content_sanskrit": "पारिक्षित कथां दिव्यां पुण्याय विजयाय च।\nकथ्यमानां मया कृत्स्नां शृणु हर्षकरीमिमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2002799, "chapter_id": 1061, "verse_number": "१-६२-५५", "content_sanskrit": "त्रिभिर्वर्षैः सदोत्थायी कृष्णद्वैपायनो मुनिः।\nमहाभारतमाख्यानं कृतवानिदमद्भुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2002800, "chapter_id": 1061, "verse_number": "१-६२-५६", "content_sanskrit": "शृणु कीर्तयतस्तन्म इतिहासं पुरातनम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2002801, "chapter_id": 1061, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि अंशावतरणपर्वणि द्विषष्टितमोऽध्यायः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]