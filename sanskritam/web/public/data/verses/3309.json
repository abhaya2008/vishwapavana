[{"id": 2106368, "chapter_id": 3309, "verse_number": "१६-३८-१", "content_sanskrit": "जनमेजय उवाच।\nदृष्ट्वा पुत्रांस्तथा पौत्रान्सानुबन्धाञ्जनाधिपः।\nधृतराष्ट्रः किमकरोद्राजा चैव युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2106369, "chapter_id": 3309, "verse_number": "१६-३८-२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2106370, "chapter_id": 3309, "verse_number": "१६-३८-२", "content_sanskrit": "तद्दृष्ट्वा महदाश्चर्यं पुत्राणां दर्शनं पुनः।\nवीतशोकः स राजर्षिः पुनराश्रममागमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2106371, "chapter_id": 3309, "verse_number": "१६-३८-३", "content_sanskrit": "इतरस्तु जनः सर्वस्ते चैव परमर्षयः।\nप्रतिजग्मुर्यथाकामं धृताराष्ट्राभ्यनुज्ञया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2106372, "chapter_id": 3309, "verse_number": "१६-३८-४", "content_sanskrit": "पाण्डवास्तु महात्मानो लघुभूयिष्ठसैनिकाः।\nअनुजग्मुर्महात्मानं सदारास्तं महीपतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2106373, "chapter_id": 3309, "verse_number": "१६-३८-५", "content_sanskrit": "तमाश्रमगतं धीमान्ब्रह्मर्षिर्लोकपूजितः।\nद्वैपायनोऽभ्युपागम्य राजानमिदम्नब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2106374, "chapter_id": 3309, "verse_number": "१६-३८-६", "content_sanskrit": "धृताष्ट्र महाबाहो शृणु कौरवनन्दन।\nश्रुतास्ते ज्ञानवृद्धानामृषीणां पुण्यकर्मणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2106375, "chapter_id": 3309, "verse_number": "१६-३८-७", "content_sanskrit": "अद्धाभिजनवृद्धानां वेदवेदाङ्गवेदिनाम्।\nधर्मज्ञानां पुराणानां वदतां विविधाः कथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2106376, "chapter_id": 3309, "verse_number": "१६-३८-८", "content_sanskrit": "मा स्म शोके मनः कार्षीर्दिष्टे न व्यथते बुधः।\nश्रुतं देवरहस्यं ते नारदाद्देवदर्शनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2106377, "chapter_id": 3309, "verse_number": "१६-३८-९", "content_sanskrit": "गतास्ते क्षत्रधर्मेण शस्त्रपूतां गतिं शुभाम्।\nयथा दृष्टास्त्वया पुत्रास्तथा कामविहारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2106378, "chapter_id": 3309, "verse_number": "१६-३८-१०", "content_sanskrit": "युधिष्ठिरः स्वयं धीमान्भवन्तमनुरुध्यते।\nसहितो भ्रातृभिः सर्वैःइ सदारः ससुहृज्जनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2106379, "chapter_id": 3309, "verse_number": "१६-३८-११", "content_sanskrit": "विसर्जयैनं यात्वेष स्वराज्यमनुशासताम्।\nमासः समधिकस्तेषामतीतो वसतां वने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2106380, "chapter_id": 3309, "verse_number": "१६-३८-१२", "content_sanskrit": "एतद्धि नित्यं यत्नेन पदं रक्ष्यं नराधिप।\nबहुप्रत्यर्थिकं ह्येतद्राज्यं नाम कुरूद्वह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2106381, "chapter_id": 3309, "verse_number": "१६-३८-१३", "content_sanskrit": "इत्युक्तः कौरवो राजा व्यासेनामितबुद्धिना।\nयुधिष्ठिरमथाहूय वाग्मी वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2106382, "chapter_id": 3309, "verse_number": "१६-३८-१४", "content_sanskrit": "अजातशत्रो भद्रं ते शृणु मे भ्रातृभिः सह।\nत्वत्प्रसादान्महीपाल शोको नास्मान्प्रबाधते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2106383, "chapter_id": 3309, "verse_number": "१६-३८-१५", "content_sanskrit": "रमे चाहं त्वया पुत्र पुरेव गजसाहये।\nनाथेनानुगतो विद्वन्प्रियेषु परिवर्तिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2106384, "chapter_id": 3309, "verse_number": "१६-३८-१६", "content_sanskrit": "प्राप्तं पुत्रफलं त्वत्तः प्रीतिर्मे परमा त्वयि।\nन मे मन्युर्महाबाहो गम्यतां मा चिरं कृथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2106385, "chapter_id": 3309, "verse_number": "१६-३८-१७", "content_sanskrit": "भवन्तं चेह संप्रेक्ष्य तपो मे परिहीयते।\nउपयुक्तं शरीरं च त्वां दृष्ट्वा धारितं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2106386, "chapter_id": 3309, "verse_number": "१६-३८-१८", "content_sanskrit": "मातरौ ते तथैवेमे शीर्णपर्णकृताशने।\nमम तुल्यव्रते पुत्र न चिरं वर्तयिष्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2106387, "chapter_id": 3309, "verse_number": "१६-३८-१९", "content_sanskrit": "दुर्योधनप्रभृतयो दृष्टा लोकान्तरं गताः।\nव्यासस्य तपसो वीर्याद्भवतश्च समागमात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2106388, "chapter_id": 3309, "verse_number": "१६-३८-२०", "content_sanskrit": "प्रयोजनं चिरं वृत्तं जीवितस्य ममानघ।\nउग्रं तपः समास्थास्येत्वमनुज्ञातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2106389, "chapter_id": 3309, "verse_number": "१६-३८-२१", "content_sanskrit": "त्वय्यद्य पिण्डः कीर्तिश्च कुलं चेदं प्रतिष्ठितम्।\nश्वोवाऽद्य वा महाबाहो गम्यतां माचिरं कृथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2106390, "chapter_id": 3309, "verse_number": "१६-३८-२२", "content_sanskrit": "राजनीतिः सुबहुशः श्रुता ते भरतर्षभ।\nसंदेष्टव्यं न पश्यामि कृतमेतावता विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2106391, "chapter_id": 3309, "verse_number": "१६-३८-२३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2106392, "chapter_id": 3309, "verse_number": "१६-३८-२३", "content_sanskrit": "इत्युक्तवचनं तं तु नृपो राजानमब्रवीत्।\nन मामर्हसि धर्मज्ञ परित्यक्तुमनागसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2106393, "chapter_id": 3309, "verse_number": "१६-३८-२४", "content_sanskrit": "कामं गच्छन्तु मे सर्वे भ्रातरोऽनुचरास्तथा।\nभवन्तमहमन्विष्ये मातरौ च यतव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2106394, "chapter_id": 3309, "verse_number": "१६-३८-२५", "content_sanskrit": "तमुवाचाथ गान्धारी मैवं पुत्र शृणुष्व च।\nत्वय्यधीनं कुरुकुलं पिण्डश्च श्वशुरस्य मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2106395, "chapter_id": 3309, "verse_number": "१६-३८-२६", "content_sanskrit": "गम्यतां पुत्र पर्याप्तमेतावत्पूजिता वयम्।\nराजा यदाह तत्कार्यं त्वया पुत्र पितुर्वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2106396, "chapter_id": 3309, "verse_number": "१६-३८-२७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2106397, "chapter_id": 3309, "verse_number": "१६-३८-२७", "content_sanskrit": "इत्युक्तः स तु गान्धार्या कुन्तीमिदमभाषत।\nस्नेहबाष्पाकुले नेत्रे परिमृज्य विनीतवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2106398, "chapter_id": 3309, "verse_number": "१६-३८-२८", "content_sanskrit": "विसर्जयति मां राजा गान्धारी च यशस्विनी।\nभवत्यां बद्धचित्तस्तु कथं यास्यामि दुःखितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2106399, "chapter_id": 3309, "verse_number": "१६-३८-२९", "content_sanskrit": "न चोत्सहे तपोविघ्नं कर्तुं ते धर्मचारिणि।\nतपसो हि परं नास्ति तपसा विन्दते महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2106400, "chapter_id": 3309, "verse_number": "१६-३८-३०", "content_sanskrit": "ममापि न तथा राज्ञि राज्ये बुद्धिर्यथा पुरा।\nतपस्येवानुरक्तं मे मनः सर्वात्मना तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2106401, "chapter_id": 3309, "verse_number": "१६-३८-३१", "content_sanskrit": "शून्येयं च मही कृत्स्ना न मे प्रीतिकरी शुभे।\nबान्धवा नः परिक्षीणा बलं नो न यथा पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2106402, "chapter_id": 3309, "verse_number": "१६-३८-३२", "content_sanskrit": "पाञ्चालाः सुभृशं क्षीणाः कन्यामात्रावशेषिताः।\nन तेषां कुलकर्तारं कञ्चित्पश्याम्यहं शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2106403, "chapter_id": 3309, "verse_number": "१६-३८-३३", "content_sanskrit": "सर्वे हि भस्मासान्नीतास्ते द्रोणेन रणाजिरे।\nअवशिष्टाश्च निहता द्रोणपुत्रेण वै निशि।\nचेदयश्चैव मत्स्याश्च दृष्टपूर्वास्तथैव नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2106404, "chapter_id": 3309, "verse_number": "१६-३८-३४", "content_sanskrit": "केवलं वृष्णिचक्रं च वासुदेवपरिग्रहात्।\nयद्दृष्ट्वा स्थातुमिच्छामि धर्मार्थं नार्थहेतुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2106405, "chapter_id": 3309, "verse_number": "१६-३८-३५", "content_sanskrit": "शिवेन पश्य नः सर्वान्दुर्लभं तव दर्शनम्।\nभविष्यत्यंब राजा हि तीव्रं चारप्स्यते तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2106406, "chapter_id": 3309, "verse_number": "१६-३८-३६", "content_sanskrit": "एतच्छ्रुत्वा महाबाहुः सहदेवो युधांपतिः।\nयुधिष्ठिरमुवाचेदं बाष्पव्याकुललोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2106407, "chapter_id": 3309, "verse_number": "१६-३८-३७", "content_sanskrit": "नोत्सहेऽहं परित्यक्तुं मातरं भरतर्षभ।\nप्रतियातु भवान्क्षिप्रं तपस्तप्स्याम्यहं वने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2106408, "chapter_id": 3309, "verse_number": "१६-३८-३८", "content_sanskrit": "इहैव शोषयिष्यामि तपसेदं कलेवरम्।\nपादशुश्रूषणेरक्तो राज्ञो मात्रोस्तथाऽनयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2106409, "chapter_id": 3309, "verse_number": "१६-३८-३९", "content_sanskrit": "तमुवाच ततः कुन्ती परिष्वज्य महाभुजम्।\nगम्यतां पुत्र मैवं त्वं वोचः कुरु वचो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2106410, "chapter_id": 3309, "verse_number": "१६-३८-४०", "content_sanskrit": "आगमा वः शिवाः सन्तु स्वस्था भवत पुत्रकाः।\nउपरोधो भवेदेवमस्माकं तपसः कृते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2106411, "chapter_id": 3309, "verse_number": "१६-३८-४१", "content_sanskrit": "त्वत्स्नेहपाशबद्धा च हीयेयं तपसः परात्।\nतस्मात्पुत्रक गच्छ त्वं शिष्टमल्पं च नः प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2106412, "chapter_id": 3309, "verse_number": "१६-३८-४२", "content_sanskrit": "एवं संस्तंभितं वाक्यैः कुन्त्या बहुविधैर्मनः।\nसहदेवस्य राजेन्द्र राज्ञश्चैव विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2106413, "chapter_id": 3309, "verse_number": "१६-३८-४३", "content_sanskrit": "ते मात्रा समनुज्ञाता राज्ञा च कुरुपुङ्गवाः।\nअभिवाद्य कुरुश्रेष्ठमामन्त्रयितुमारभन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2106414, "chapter_id": 3309, "verse_number": "१६-३८-४४x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2106415, "chapter_id": 3309, "verse_number": "१६-३८-४४", "content_sanskrit": "राज्यं प्रति गमिष्यामः शिवेन प्रतिनन्दितः।\nअनुज्ञातास्त्वया राजन्गमिष्यामो विकल्मषाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2106416, "chapter_id": 3309, "verse_number": "१६-३८-४५", "content_sanskrit": "एवमुक्तः स राजर्षिर्धर्मराज्ञा महात्मना।\nअनुयज्ञे जयाशीर्भिः पूजयित्वा युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2106417, "chapter_id": 3309, "verse_number": "१६-३८-४६", "content_sanskrit": "भीमं च बलिनां श्रेष्ठं सान्त्वयामास पार्थिवः।\nस चास्य सम्यङ्मेधावी प्रत्यपद्यत वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2106418, "chapter_id": 3309, "verse_number": "१६-३८-४७", "content_sanskrit": "अर्जुनं च समाश्लिष्य यंमौ च भरतर्षभौ।\nअनुयज्ञे स कौरव्यः परिष्वज्याभिनन्द्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2106419, "chapter_id": 3309, "verse_number": "१६-३८-४८", "content_sanskrit": "गान्धार्या चाभ्यनुज्ञाताः कृतपादाभिवादनाः।\nजनन्या समुपाघ्राताः परिष्वक्ताश्च ते नृपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2106420, "chapter_id": 3309, "verse_number": "१६-३८-४९", "content_sanskrit": "चक्रुः प्रदक्षिणं सर्वे वत्सा इव निवारणे।\nपुनः पुनर्निरीक्षन्तः प्रचक्रुस्ते प्रदक्षिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2106421, "chapter_id": 3309, "verse_number": "१६-३८-५०", "content_sanskrit": "द्रौपदीप्रमुखाश्चैव सर्वाः कौरवयोषितः।\nन्यायतः श्वशुरे वृत्तिं प्रयुज्य प्रययुस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2106422, "chapter_id": 3309, "verse_number": "१६-३८-५१", "content_sanskrit": "श्वश्रूभ्यां समनुज्ञाताः परिष्वज्याभिनन्दिताः॥\nसंदिष्टाश्चेतिकर्तव्यं प्रययुर्भर्तृभिः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2106423, "chapter_id": 3309, "verse_number": "१६-३८-५२", "content_sanskrit": "ततः प्रजज्ञे निनदः सूतानां युज्यतामिति।\nउष्ट्राणां क्रोशतां चापि हयानां हेषतामपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2106424, "chapter_id": 3309, "verse_number": "१६-३८-५३", "content_sanskrit": "ततो युधिष्ठिरो राजा सदारः सहसैनिकः।\nनगरं हास्तिनपुरं पुनरायात्सबान्धवः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2106425, "chapter_id": 3309, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्रमवासिकपर्वणि पुत्रदर्शनपर्वणि अष्टत्रिंशोऽध्यायः॥ ३८ ॥ ॥ समाप्तं चेदं पुत्रदर्शनपर्व ॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]