[{"id": 2209858, "chapter_id": 5488, "verse_number": "", "content_sanskrit": "बभ्रुवाहने प्रायोपविष्टे उलूप्या स्मरणमात्रसन्निहितसञ्जीवनमणिना-\nर्ऽजुनस्य समुद्बोधनम् । ततः सुप्तोत्थितेनेव तेनार्जुनेन बभ्रुवाहनं\nप्रति चित्राङ्गदादीनां रणाङ्गणागमने कारणप्रश्ने तेनोलूपीं प्रति प्रश्नचोदना ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2209859, "chapter_id": 5488, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2209860, "chapter_id": 5488, "verse_number": "१", "content_sanskrit": "प्रायोपविष्टे नृपतौ मणलूरेश्वरे तदा ।\nपितृशोकसमाविष्टे सह मात्रा परन्तप ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2209861, "chapter_id": 5488, "verse_number": "२", "content_sanskrit": "उलूपी चिन्तयामास तदा सञ्जीवनं मणिम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2209862, "chapter_id": 5488, "verse_number": "३", "content_sanskrit": "स चोपातिष्ठत तदा पन्नगानां परायणम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2209863, "chapter_id": 5488, "verse_number": "४", "content_sanskrit": "तं गृहीत्वा तु कौरव्य पन्नगाधिपतेः सुता ।\nमनःप्रह्लादनीं वाचं सैनिकानामथाब्रवीत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2209864, "chapter_id": 5488, "verse_number": "", "content_sanskrit": "उलूपी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2209865, "chapter_id": 5488, "verse_number": "५", "content_sanskrit": "उत्तिष्ठ मा शुचः पुत्र नैष जिष्णुस्त्वया हतः ।\nअजय्यः पुरुषैरन्यैर्देवैरपि सवासवैः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2209866, "chapter_id": 5488, "verse_number": "६", "content_sanskrit": "मया तु मोहनी नाम मायैषा सम्प्रयोजिता ।\nप्रियार्थं पुरुषव्याघ्र पितुस्तेऽद्य यशस्विनः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2209867, "chapter_id": 5488, "verse_number": "७", "content_sanskrit": "जिज्ञासुर्ह्येष वै पुत्र बलस्य तव कौरवः ।\nसङ्ग्रामे युद्ध्यमानस्य सम्प्राप्तः परवीरहा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2209868, "chapter_id": 5488, "verse_number": "८", "content_sanskrit": "तस्मादसि मया पुत्र युद्धार्थं परिचोदितः ।\nस पापमात्मनः पुत्र शङ्केथा ह्यण्वपि प्रभो ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2209869, "chapter_id": 5488, "verse_number": "९", "content_sanskrit": "ऋषिरेष महातेजाः पुरुषः शाश्वतोऽव्ययः ।\nनैनं शक्तो हि सङ्ग्रामे जेतुं शक्रोऽपि पार्थिव ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2209870, "chapter_id": 5488, "verse_number": "१०", "content_sanskrit": "अयं तु मे मणिर्दिव्यः समानीतो विशाम्पते ।\nमृतान् मृतान् पन्नगेन्द्रान् सञ्जीवयति सर्वदा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2209871, "chapter_id": 5488, "verse_number": "११", "content_sanskrit": "एनमस्योरसि त्वं च स्थापयाद्य पितुः प्रभो ।\nसजीवितं पुनः पुत्र ततो द्रष्टासि पाण्डवम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2209872, "chapter_id": 5488, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2209873, "chapter_id": 5488, "verse_number": "", "content_sanskrit": "इत्युक्तः स्थापयामास तस्योरसि मणिं तदा ।\n(पार्थस्यामिततेजाः स पितुः स्नेहादपापकृत् ॥१२॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2209874, "chapter_id": 5488, "verse_number": "१३", "content_sanskrit": "तस्मिन् न्यस्ते मणौ वीर जिष्णुरुज्जीवितः प्रभुः ।\nसुप्तोत्थित इवोत्तस्थौ स्पष्टलोहितलोचनः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2209875, "chapter_id": 5488, "verse_number": "१४", "content_sanskrit": "तमुत्थितं महात्मानं लब्धसञ्ज्ञं मनस्विनम् ।\nसमीक्ष्य पितरं स्वस्थं ववन्दे बभ्रुवाहनः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2209876, "chapter_id": 5488, "verse_number": "१५", "content_sanskrit": "उत्थिते पुरुषव्याघ्रे पुनर्लक्ष्मीपतिः प्रभो ।\nदिव्याः सुमनसः पुण्या ववर्ष बलसूदनः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2209877, "chapter_id": 5488, "verse_number": "१६", "content_sanskrit": "अनाहता दुन्दुभयो प्रणेदुर्मेघनिःस्वनाः ।\nसाधु साध्विति चाकाशे बभूव सुमहान् स्वनः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2209878, "chapter_id": 5488, "verse_number": "१७", "content_sanskrit": "उत्थाय तु महाबाहुः पर्याश्वस्तो धनञ्जयः ।\nबभ्रुवाहनमालिङ्ग्य समाजिघ्रत मूर्धनि ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2209879, "chapter_id": 5488, "verse_number": "१८", "content_sanskrit": "ददर्श चाविदूरेऽस्य मातरं शोककर्शिताम् ।\nउलूप्या सह तिष्ठन्तीं ततोऽपृच्छद् धनञ्जयः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2209880, "chapter_id": 5488, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2209881, "chapter_id": 5488, "verse_number": "१९", "content_sanskrit": "किमिदं लक्ष्यते सर्वं शोकविस्मयहर्षवत् ।\nरणाजिरममित्रघ्न यदि जानासि शंस मे ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2209882, "chapter_id": 5488, "verse_number": "२०", "content_sanskrit": "जननी च किमर्थं ते रणभूमिमुपागता ।\nनागेन्द्रदुहिता चेयमुलूपी किमिहागता ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2209883, "chapter_id": 5488, "verse_number": "२१", "content_sanskrit": "जानाम्यहमिदं युद्धं त्वया मद्वचनात् कृतम् ।\nस्त्रीणामत्रागमे हेतुमहमिच्छामि वेदितुम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2209884, "chapter_id": 5488, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2209885, "chapter_id": 5488, "verse_number": "२२", "content_sanskrit": "तमुवाच ततः पृष्टो मणलूरपतिस्तदा ।\nप्रसाद्य शिरसा विद्वान् उलूपी पृच्छ्यतामिति ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2209886, "chapter_id": 5488, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि अश्वसम्भरणे अर्जुनसञ्जीवनप्रकारकथनं नाम द्व्यशीतितमोऽध्यायः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]