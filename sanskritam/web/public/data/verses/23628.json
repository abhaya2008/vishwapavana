[{"id": 7003628000, "chapter_id": 23628, "verse_number": "१-२-१५-१", "content_sanskrit": "वरांग्युवाच ।\nनाशितास्म्यपविद्धास्मि त्रासिता पीडितास्मि च ।\nरौद्रोण देवनाथेन नष्टनाथेन भूरिशः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003628001, "chapter_id": 23628, "verse_number": "१-२-१५-२", "content_sanskrit": "दुःखपारमपश्यंती प्राणांस्त्यक्तुं व्यवस्थिता ।\nपुत्रं मे घोरदुःखस्य तारकं देहि चेत्कृपा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003628002, "chapter_id": 23628, "verse_number": "१-२-१५-३", "content_sanskrit": "एवमुक्तस्तु दैत्येंद्रो दुःखितोऽचिंतयद्धृदि ।\nआसुरेष्वपि भावेषु स्पृहा यद्यपि नास्ति मे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003628003, "chapter_id": 23628, "verse_number": "१-२-१५-४", "content_sanskrit": "तथापि मन्ये शास्त्रैभ्यस्त्वनुकंप्या प्रियेति यत् ।\nसर्वाश्रमानुपादाय स्वाश्रमेण कलत्रवान् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003628004, "chapter_id": 23628, "verse_number": "१-२-१५-५", "content_sanskrit": "व्यसनार्णवमत्येति जलयानैरिवार्णवम् ।\nयामाश्रित्येंद्रियारातीन्दुर्जयानितराश्रयैः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003628005, "chapter_id": 23628, "verse_number": "१-२-१५-६", "content_sanskrit": "गेहिनो हेलया जिग्युर्दस्यून्दूर्ग पतिर्यथा ।\nन केऽपि प्रभवस्तां चाप्यनुकर्तुं गृहेश्वरीम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003628006, "chapter_id": 23628, "verse_number": "१-२-१५-७", "content_sanskrit": "अथायुषा वा कार्त्स्न्येन धर्मे दित्सुर्यथैव च ।\nयस्यां भवति चात्मैव ततो जाया निगद्यते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003628007, "chapter_id": 23628, "verse_number": "१-२-१५-८", "content_sanskrit": "भर्तव्या एव यस्माच्च तस्माद्भार्येति सा स्मृता ।\nसा एव गृहमुक्तं च गृहीणी सा ततः स्मृता ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003628008, "chapter_id": 23628, "verse_number": "१-२-१५-९", "content_sanskrit": "संसारकल्मषात्त्रात्री कलत्रमिति सा ततः ।\nएवंविधां प्रियां को वै नानुकंपितुमर्हति ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003628009, "chapter_id": 23628, "verse_number": "१-२-१५-१०", "content_sanskrit": "त्रीणि ज्योतींषि पुरुष इति वै देवलोऽब्रवीत् ।\nभार्या कर्म च विद्या च संसाध्यं यत्नतस्त्रयम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003628010, "chapter_id": 23628, "verse_number": "१-२-१५-११", "content_sanskrit": "तदेनां पीडितां चेद्यः पतिर्भूत्वा न पालये ।\nततो यास्ये शास्त्रवादान्नरकांतं न संशयः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003628011, "chapter_id": 23628, "verse_number": "१-२-१५-१२", "content_sanskrit": "अह मप्येनमिंद्रं वै शक्तो जेतुं यथाऽनृणाम् ।\nपुनः कामं करिष्येऽस्या दास्ये पुत्रऊं महाबलम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003628012, "chapter_id": 23628, "verse_number": "१-२-१५-१३", "content_sanskrit": "इति संचिंत्य वज्रांगः कोपव्याकुललोचनः ।\nप्रतिकर्तुं महेंद्राय तपो भूयो व्यवस्यत ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003628013, "chapter_id": 23628, "verse_number": "१-२-१५-१४", "content_sanskrit": "ज्ञात्वा तु तस्य संकल्पं ब्रह्मा क्रूरतरं पुनः ।\nआजगाम त्वरायुक्तो यत्राऽसौ दितिनंदनः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003628014, "chapter_id": 23628, "verse_number": "१-२-१५-१५", "content_sanskrit": "उवाचैनं स भगवान्प्रभुर्मधुरया गिरा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003628015, "chapter_id": 23628, "verse_number": "१-२-१५-१६", "content_sanskrit": "ब्रह्मोवाच ।\nकिमर्थं भूय एव त्वं नियमं क्रूरमिच्छसि ।\nआहाराभिमुखो दैत्य तन्मे ब्रूहि महाव्रतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003628016, "chapter_id": 23628, "verse_number": "१-२-१५-१७", "content_sanskrit": "यावदब्दसहस्रेण निराहारेण वै फलम् ।\nत्यजता प्राप्तमाहारं लब्धं ते क्षणमात्रतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003628017, "chapter_id": 23628, "verse_number": "१-२-१५-१८", "content_sanskrit": "त्यागो ह्यप्राप्तकामानां न तथा च गुरुः स्मृतः ।\nयथा प्राप्तं परित्यज्य कामं कमललोचन ।\nश्रुत्वैतद्ब्रह्मणो वाक्यं दैत्यः प्रांजलिरब्रवीत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003628018, "chapter_id": 23628, "verse_number": "१-२-१५-१९", "content_sanskrit": "दैत्य उवाच ।\nपत्न्यर्थेऽहं करिष्यामि तपो घोरं पितामह ।\nपुत्रार्थमुद्यतश्चाहं यः स्याद्गीर्वाणदर्पहा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003628019, "chapter_id": 23628, "verse_number": "१-२-१५-२०", "content_sanskrit": "एतच्छ्रुत्वा वचो देवः पद्मगर्भोद्भवस्तदा ।\nउवाच दैत्यराजानं प्रसन्नश्चतुराननः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003628020, "chapter_id": 23628, "verse_number": "१-२-१५-२१", "content_sanskrit": "ब्रह्मोवाच ।\nअलं ते तपसा वत्स मा क्लेशे विस्तरे विश ।\nपुत्रस्ते तारकोनाम भविष्यति महाबलः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003628021, "chapter_id": 23628, "verse_number": "१-२-१५-२२", "content_sanskrit": "देवसीमंतिनीकाम्यधम्मिल्लकविमोक्षणः ।\nइत्युक्तो दैत्यराजस्तु प्रणम्य प्रपितामहम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003628022, "chapter_id": 23628, "verse_number": "१-२-१५-२३", "content_sanskrit": "विसृज्य गत्वा महिषीं नंदया मास तां मुदा ।\nतौ दंपती कृतार्थौ च जग्मतुश्चाश्रमं तदा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003628023, "chapter_id": 23628, "verse_number": "१-२-१५-२४", "content_sanskrit": "आहितं च ततो गर्भं वरांगी वरवर्णिनी ।\nपूर्णं वर्षसहस्रं तु दधारोदर एव हि ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003628024, "chapter_id": 23628, "verse_number": "१-२-१५-२५", "content_sanskrit": "ततो वर्षसहस्रांते वरांगी समसूयत ।\nजायमाने तु दैत्येंद्रे तस्मिंल्लोकभयंकरे ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003628025, "chapter_id": 23628, "verse_number": "१-२-१५-२६", "content_sanskrit": "चचाल सकला पृथ्वी प्रोद्धूताश्च महार्णवा ।\nचेलुर्धराधराश्चापि ववुर्वाता विभीषणाः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003628026, "chapter_id": 23628, "verse_number": "१-२-१५-२७", "content_sanskrit": "जेपुर्जप्यं मुनिवरा व्याधविद्धा मृगा इव ।\nजहुः कांतिं च सूर्याद्या नीहाराश्छांदयन्दिशः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003628027, "chapter_id": 23628, "verse_number": "१-२-१५-२८", "content_sanskrit": "जाते महासुरे तस्मिन्सर्व एव महासुराः ।\nआजग्मुर्हर्षितास्तत्र तथा चासुरयोषितः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003628028, "chapter_id": 23628, "verse_number": "१-२-१५-२९", "content_sanskrit": "जगुर्हर्षसमाविष्टा ननृतुश्चासुरांगनाः ।\nततो महोत्सवे जाते दानवानां पृथासुत ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003628029, "chapter_id": 23628, "verse_number": "१-२-१५-३०", "content_sanskrit": "विषण्णमनसो देवाः समहेंद्रास्तदाभवन् ।\nजातामात्रस्तु दैत्येंद्रस्तारकश्चंडविक्रमः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003628030, "chapter_id": 23628, "verse_number": "१-२-१५-३१", "content_sanskrit": "अभिषिक्तोऽसुरो दैत्यैः कुरंगमहिषादिभिः ।\nसर्वासुरमहाराज्ये युतः सर्वैर्महासुरैः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003628031, "chapter_id": 23628, "verse_number": "१-२-१५-३२", "content_sanskrit": "स तु प्राप्तमहाराज्यस्तारकः पांडुसत्तम ।\nउवाच दानवश्रेष्ठान्युक्तियुक्तमिदं वचः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003628032, "chapter_id": 23628, "verse_number": "१-२-१५-३३", "content_sanskrit": "श्रृणुध्वमसुराः सर्वे वाक्यं मम महाबलाः ।\nश्रुत्वा वः स्थेयसी बुद्धिः क्रियतां वचने मम ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003628033, "chapter_id": 23628, "verse_number": "१-२-१५-३४", "content_sanskrit": "अस्माकं जातिधर्मेण विरूढं वैरमक्षयम् ।\nकरिष्याम्यहं तद्वैरं तेषां च विजयाय च ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003628034, "chapter_id": 23628, "verse_number": "१-२-१५-३५", "content_sanskrit": "किं तु तत्तपसा साध्यं मन्येहं सुरसंगमम् ।\nतस्मादादौ करिष्यामि तपो घोरं दनोः सुताः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003628035, "chapter_id": 23628, "verse_number": "१-२-१५-३६", "content_sanskrit": "ततः सुरान्विजेष्यामो भोक्ष्यामोऽथ जगत्त्रयम् ।\nयुक्तोपायोऽहि पुरुषः स्थिरश्रीरेव जायते ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003628036, "chapter_id": 23628, "verse_number": "१-२-१५-३७", "content_sanskrit": "अयुक्तश्चपलः प्राप्तामपि रक्षितुमक्षमः ।\nतच्छ्रुत्वा दानवाः सर्वे वाक्यं तस्यासुरस्य तु ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003628037, "chapter_id": 23628, "verse_number": "१-२-१५-३८", "content_sanskrit": "साधुसाध्वित्यथोचुस्ते वचनं तस्य विस्मिताः ।\nसोऽगच्छत्पारियात्रस्य गिरेः कंदरमुत्तमम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003628038, "chapter_id": 23628, "verse_number": "१-२-१५-३९", "content_sanskrit": "सर्वर्तुकुसुमाकीर्णनानौषधिविदिपितम् ।\nनानाधातुरसस्राविचित्रनानागृहाश्रयम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003628039, "chapter_id": 23628, "verse_number": "१-२-१५-४०", "content_sanskrit": "अनेकाकारबहुलं पृथक्पक्षिकुलाकुलम् ।\nनानाप्रस्रवणोपेतं नानाविधजलाशयम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003628040, "chapter_id": 23628, "verse_number": "१-२-१५-४१", "content_sanskrit": "प्राप्य तत्कंदरं दैत्यश्चकार विपुलं तपः ।\nवहन्पाशुपतीं दीक्षां पंच मंत्राञ्जजाप सः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003628041, "chapter_id": 23628, "verse_number": "१-२-१५-४२", "content_sanskrit": "निराहारः पंचतपा वर्षायुतमभूत्किल ।\nततः स्वदेहादुत्कृत्त्य कर्षंकर्षं दिनेदिने ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003628042, "chapter_id": 23628, "verse_number": "१-२-१५-४३", "content_sanskrit": "मांसस्याग्नौ जुहावैव ततो निर्मांसतां गतः ।\nततो निर्मांसदेहः स तपोराशिरजायत ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003628043, "chapter_id": 23628, "verse_number": "१-२-१५-४४", "content_sanskrit": "जज्वलुः सर्वभूतानि तेजसा तस्य सर्वतः ।\nउद्विग्नाश्च सुराः सर्वे तपसा तस्य भीषिताः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003628044, "chapter_id": 23628, "verse_number": "१-२-१५-४५", "content_sanskrit": "एतस्मिन्नंतरे ब्रह्मा परमं तोषमागतः ।\nतारकस्य वरं दातुं जगाम शिखरं गिरेः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003628045, "chapter_id": 23628, "verse_number": "१-२-१५-४६", "content_sanskrit": "प्राप्य तं शैलराजानं हंसस्यंदनमास्थितः ।\nउवाच तारकं देवो गिरा मधुरया तदा ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003628046, "chapter_id": 23628, "verse_number": "१-२-१५-४७", "content_sanskrit": "ब्रह्मोवाच ।\nउत्तिष्ठ पुत्र तपसो नास्त्यसाध्यं तवाधुना ।\nवरं वृणीष्वाभिमतं यत्ते मनसि वर्तते ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003628047, "chapter_id": 23628, "verse_number": "१-२-१५-४८", "content_sanskrit": "इत्युक्तस्तारको दैत्यः प्रांजलिः प्राह तं विभुम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003628048, "chapter_id": 23628, "verse_number": "१-२-१५-४९", "content_sanskrit": "तारक उवाच ।\nवयं प्रभो जातिधर्माः कृतवैराः सहमरैः ।\nतैश्च निःशेषिता दैत्याः कृताः क्रूरैनृशं सवत् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003628049, "chapter_id": 23628, "verse_number": "१-२-१५-५०", "content_sanskrit": "तेषामहं समुद्धर्ता भवेयमिति मे मतिः ।\nअवध्यः सर्वभूतानामस्त्राणां च महौजसाम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003628050, "chapter_id": 23628, "verse_number": "१-२-१५-५१", "content_sanskrit": "स्यामहं चामरैश्चैष वरो मम हृदिस्थितः ।\nएतन्मे देहि देवेश नान्यं वै रोचये वरम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003628051, "chapter_id": 23628, "verse_number": "१-२-१५-५२", "content_sanskrit": "तमुवाच ततो दैत्यं विरंचोऽमरनायकः ।\nन युज्यते विना मृत्युं देहिनो देहधारणम् ।\nजातस्य हि ध्रुवो मृत्युः सत्यमेतच्छ्रुतीरितम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003628052, "chapter_id": 23628, "verse_number": "१-२-१५-५३", "content_sanskrit": "इति संचिंत्य वरय वरं यस्मान्न शंकसे ।\nततः संचिंत्य दैत्येंद्रः शिशुतः सप्तवासरात् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003628053, "chapter_id": 23628, "verse_number": "१-२-१५-५४", "content_sanskrit": "तारक उवाच ।\nवासराणां च सप्तानां वर्जयित्वा तु बालकम् ।\nदेवानामप्यवध्योऽहं भूयासं तेन याचितः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003628054, "chapter_id": 23628, "verse_number": "१-२-१५-५५", "content_sanskrit": "वव्रे महासुरो मृत्युं ब्रह्माणं मानमोहितः ।\nब्रह्मा प्रोचे ततस्तं च तथेति हरवाक्यतः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003628055, "chapter_id": 23628, "verse_number": "१-२-१५-५६", "content_sanskrit": "जगाम त्रिदिवं देवो दैत्योऽपि स्वकमालयम् ।\nउत्तीर्णं तपसस्तं च दैत्यं दैत्येश्वरास्तदा ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003628056, "chapter_id": 23628, "verse_number": "१-२-१५-५७", "content_sanskrit": "परिवव्रुः फलाकीर्णं वृक्षं शकुनयो यथा ।\nतस्मिन्महति राज्यस्थे तारके दितिनंदने ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003628057, "chapter_id": 23628, "verse_number": "१-२-१५-५८", "content_sanskrit": "ब्रह्मणाभिहि तस्थाने महार्णवतटोत्तरे ।\nतरवो जज्ञिरे पार्थ तत्र सर्वर्तवः शुभाः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003628058, "chapter_id": 23628, "verse_number": "१-२-१५-५९", "content_sanskrit": "कांतिर्द्युतिर्धृतिर्मेधा श्रीरखंडा च दानवम् ।\nपरिवव्रुर्गुणा कीर्णं निश्छिद्राः सर्व एव हि ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003628059, "chapter_id": 23628, "verse_number": "१-२-१५-६०", "content_sanskrit": "कालागरुविलिप्तांगं महामुकुटमंडितम् ।\nरुचिरांगदसन्नद्धं महासिंहासने स्थितम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003628060, "chapter_id": 23628, "verse_number": "१-२-१५-६१", "content_sanskrit": "नृत्यंत्यप्सरसः श्रेष्ठा गन्धर्वा गाययंति च ।\nचन्द्रार्कौ दीपमार्गेषु व्यजनेषु च मारुतः ।\nग्रहा अग्रेसरास्तस्य जीवादेशप्रभाषिणः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003628061, "chapter_id": 23628, "verse_number": "१-२-१५-६२", "content_sanskrit": "एवं स्वकाद्बाहुबलात्स दैत्यः संप्राप्य राज्यं परिमोदमानः ।\nकदाचिदाभाष्य जगाद मंत्रिणः प्रोद्धृत्तसर्वांगबलेन दर्पितः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]