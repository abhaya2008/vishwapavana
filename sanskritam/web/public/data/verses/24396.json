[{"id": 7004396000, "chapter_id": 24396, "verse_number": "५-३-९०-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nरेवाया उत्तरे कूले वैष्णवं तीर्थमुत्तमम् ।\nजलशायीति वै नाम विख्यातं वसुधातले॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004396001, "chapter_id": 24396, "verse_number": "५-३-९०-२", "content_sanskrit": "दानवानां वधं कृत्वा सुप्तस्तत्र जनार्दनः ।\nचक्रं प्रक्षालितं तत्र देवदेवेन चक्रिणा ।\nसुदर्शनं च निष्पापं रेवाजलसमाश्रयात्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004396002, "chapter_id": 24396, "verse_number": "५-३-९०-३", "content_sanskrit": "युधिष्ठिर उवाच ।\nचक्रतीर्थं समाचक्ष्व मुनिसंघैश्च वन्दितम् ।\nविष्णोः प्रभावमतुलं रेवायाश्चैव यत्फलम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004396003, "chapter_id": 24396, "verse_number": "५-३-९०-४", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nसाधु साधु महाप्राज्ञ विरक्तस्त्वं युधिष्ठिर ।\nगुह्याद्गुह्यतरं तीर्थं निर्मितं चक्रिणा स्वयम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004396004, "chapter_id": 24396, "verse_number": "५-३-९०-५", "content_sanskrit": "तत्तेऽहं सम्प्रवक्ष्यामि कथां पापप्रणाशिनीम् ।\nआसीत्पुरा महादैत्यस्तालमेघ इति श्रुतः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004396005, "chapter_id": 24396, "verse_number": "५-३-९०-६", "content_sanskrit": "तेन देवा जिताः सर्वे हृतराज्या नराधिप ।\nयज्ञभागान् स्वयं भुङ्क्ते अहं विष्णुर्न संशयः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004396006, "chapter_id": 24396, "verse_number": "५-३-९०-७", "content_sanskrit": "धनदस्य हृतं चित्तं हृतः शक्रस्य वारणः ।\nइन्द्राणीं वाञ्छते पापो हयरत्नं रवेरपि॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004396007, "chapter_id": 24396, "verse_number": "५-३-९०-८", "content_sanskrit": "तालमेघभयात्पार्थ रविरुद्राः सवासवाः ।\nयमः स्कन्दो जलेशोऽग्निर्वायुर्देवो धनेश्वरः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004396008, "chapter_id": 24396, "verse_number": "५-३-९०-९", "content_sanskrit": "सवाक्पतिमहेशाश्च नष्टचित्ताः पितामहम् ।\nगता देवा ब्रह्मलोकं तत्र दृष्ट्वा पितामहम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004396009, "chapter_id": 24396, "verse_number": "५-३-९०-१०", "content_sanskrit": "तुष्टुवुर्विविधैः स्तोत्रैर्वागीशप्रमुखाः सुराः ।\nगुणत्रयविभागाय पश्चाद्भेदमुपेयुषे॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004396010, "chapter_id": 24396, "verse_number": "५-३-९०-११", "content_sanskrit": "दृष्ट्वा देवान्निरुत्साहान् विवर्णानवनीपते ।\nप्रसादाभिमुखो देवः प्रत्युवाच दिवौकसः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004396011, "chapter_id": 24396, "verse_number": "५-३-९०-१२", "content_sanskrit": "ब्रह्मोवाच ।\nस्वागतं सुरसङ्घस्य कान्तिर्नष्टा पुरातनी ।\nहिमक्लिष्टप्रभावेण ज्योतींषीव मुखानि वः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004396012, "chapter_id": 24396, "verse_number": "५-३-९०-१३", "content_sanskrit": "प्रशमादर्चिषामेतदनुद्गीर्णं सुरायुधम् ।\nवृत्रस्य हन्तुः कुलिशं कुण्ठितश्रीव लक्ष्यते॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004396013, "chapter_id": 24396, "verse_number": "५-३-९०-१४", "content_sanskrit": "किं चायमरिदुर्वारः पाणौ पाशः प्रचेतसः ।\nमन्त्रेण हतवीर्यस्य फणिनो दैन्यमाश्रितः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004396014, "chapter_id": 24396, "verse_number": "५-३-९०-१५", "content_sanskrit": "कुबेरस्य मनःशल्यं शंसतीव पराभवम् ।\nअपविद्धगतो वायुर्भग्नशाख इव द्रुमः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004396015, "chapter_id": 24396, "verse_number": "५-३-९०-१६", "content_sanskrit": "यमोऽपि विलिखन्भूमिं दण्डेनास्तमितत्विषा ।\nकुरुतेऽस्मिन्नमोघोऽपि निर्वाणालातलाघवम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004396016, "chapter_id": 24396, "verse_number": "५-३-९०-१७", "content_sanskrit": "अमी च कथमादित्याः प्रतापक्षतिशीतलाः ।\nचित्रन्यस्ता इव गताः प्रकामालोकनीयताम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004396017, "chapter_id": 24396, "verse_number": "५-३-९०-१८", "content_sanskrit": "तद्ब्रूत वत्साः किमितः प्रार्थयध्वं समागताः ।\nकिमागमनकृत्यं वो ब्रूत निःसंशयं सुराः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004396018, "chapter_id": 24396, "verse_number": "५-३-९०-१९", "content_sanskrit": "मयि सृष्टिर्हि लोकानां रक्षा युष्मास्ववस्थिता ।\nततो मन्दानिलोद्भूतकमलाकरशोभिना॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004396019, "chapter_id": 24396, "verse_number": "५-३-९०-२०", "content_sanskrit": "गुरुं नेत्रसहस्रेण प्रेरयामास वृत्रहा ।\nस द्विनेत्रं हरेश्चक्षुः सहस्रनयनाधिकम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004396020, "chapter_id": 24396, "verse_number": "५-३-९०-२१", "content_sanskrit": "वाचस्पतिरुवाचेदं प्राञ्जलिर्जलजासनम् ।\nयुष्मद्वंशोद्भवस्तात तालमेघो महाबलः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004396021, "chapter_id": 24396, "verse_number": "५-३-९०-२२", "content_sanskrit": "उपतापयते देवान्धूमकेतुरिवोच्छ्रितः ।\nतेन देवगणाः सर्वे दुःखिता दानवेन च॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004396022, "chapter_id": 24396, "verse_number": "५-३-९०-२३", "content_sanskrit": "तालमेघो दैत्यपतिः सर्वान्नो बाधते बली ।\nतस्मात्त्वां शरणं प्राप्ताः शरणं नो विधे भव॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004396023, "chapter_id": 24396, "verse_number": "५-३-९०-२४", "content_sanskrit": "ततः प्रसन्नो भगवान् वेधास्तानब्रवीद्वचः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004396024, "chapter_id": 24396, "verse_number": "५-३-९०-२५", "content_sanskrit": "ब्रह्मोवाच ।\nतालमेघेन वो मध्ये बली तेन समः सुराः ।\nविना माधवदेवेन साध्यो मे नैव दानवः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004396025, "chapter_id": 24396, "verse_number": "५-३-९०-२६", "content_sanskrit": "ततः सुरगणाः सर्वे विरिञ्चिप्रमुखा नृप ।\nक्षीरोदं प्रस्थिताः सर्वे दुःखितास्तेन वैरिणा॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004396026, "chapter_id": 24396, "verse_number": "५-३-९०-२७", "content_sanskrit": "त्वरिताः प्रस्थिता देवाः केशवं द्रष्टुकाम्यया ।\nक्षीरोदं सागरं गत्वास्तुवंस्ते जलशायिनम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004396027, "chapter_id": 24396, "verse_number": "५-३-९०-२८", "content_sanskrit": "देवा ऊचुः ।\nजगदादिरनादिस्त्वं जगदन्तोऽप्यनन्तकः ।\nजगन्मूर्तिरमूर्तिस्त्वं जय गीर्वाणपूजित॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004396028, "chapter_id": 24396, "verse_number": "५-३-९०-२९", "content_sanskrit": "जय क्षीरोदशयन जय लक्ष्म्या सदा वृत ।\nजय दानवनाशाय जय देवकिनन्दन॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004396029, "chapter_id": 24396, "verse_number": "५-३-९०-३०", "content_sanskrit": "जय शङ्खगदापाणे जय चक्रधर प्रभो ।\nइति देवस्तुतिं श्रुत्वा प्रबुद्धो जलशाय्यथ॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004396030, "chapter_id": 24396, "verse_number": "५-३-९०-३१", "content_sanskrit": "उवाच मधुरां वाणीं मेघगम्भीरनिस्वनाम् ।\nकिमर्थं बोधितो ब्रह्मन् समर्थैर्वः सुरासुरैः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004396031, "chapter_id": 24396, "verse_number": "५-३-९०-३२", "content_sanskrit": "ब्रह्मोवाच ।\nतालमेघभयात्कृष्ण सम्प्राप्तास्तव मन्दिरम् ।\nन वध्यः कस्यचित्पापस्तालमेघो जनार्दन॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004396032, "chapter_id": 24396, "verse_number": "५-३-९०-३३", "content_sanskrit": "त्वमेव जहि तं दुष्टं मृत्युं यास्यति नान्यथा॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004396033, "chapter_id": 24396, "verse_number": "५-३-९०-३४", "content_sanskrit": "श्रीकृष्ण उवाच ।\nस्वस्थानं गम्यतां देवाः स्वकीयां लभत प्रजाम् ।\nदुष्टात्मानं हनिष्यामि तालमेघं महाबलम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004396034, "chapter_id": 24396, "verse_number": "५-३-९०-३५", "content_sanskrit": "स्थानं ब्रुवन्तु मे देवा वसेद्यत्र स दानवः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004396035, "chapter_id": 24396, "verse_number": "५-३-९०-३६", "content_sanskrit": "देवा ऊचुः ।\nहिमाचलगुहायां स वसते दानवेश्वरः ।\nचतुर्विंशतिसाहस्रैः कन्याभिः परिवारितः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004396036, "chapter_id": 24396, "verse_number": "५-३-९०-३७", "content_sanskrit": "तुरङ्गैः स्यन्दनैः कृष्ण संख्या तस्य न विद्यते ।\nनटा नानाविधास्तत्र असंख्यातगुणा हरे॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004396037, "chapter_id": 24396, "verse_number": "५-३-९०-३८", "content_sanskrit": "द्विरदाः पर्वताकारा हयाश्च द्विरदोपमाः ।\nमहाबलो वसेत्तत्र गीर्वाणभयदायकः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004396038, "chapter_id": 24396, "verse_number": "५-३-९०-३९", "content_sanskrit": "श्रुत्वा देवो वचस्तेषां देवानामातुरात्मनाम् ।\nअचिन्तयद्गरुत्मन्तं शत्रुसङ्घविनाशनम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004396039, "chapter_id": 24396, "verse_number": "५-३-९०-४०", "content_sanskrit": "चक्रं करेण संगृह्य गदाचक्रधरः प्रभुः ।\nशार्ङ्गं च मुशलं सीरं करैर्गृह्य जनार्दनः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004396040, "chapter_id": 24396, "verse_number": "५-३-९०-४१", "content_sanskrit": "आरूढः पक्षिराजेन्द्रं वधार्थं दानवस्य च ।\nदानवस्य पुरे पेतुरुत्पाता घोररूपिणः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004396041, "chapter_id": 24396, "verse_number": "५-३-९०-४२", "content_sanskrit": "गोमायुर्गृध्रमध्ये तु कपोतैः सममाविशत् ।\nविना वातेन तस्यैव ध्वजदण्डः पपात ह॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004396042, "chapter_id": 24396, "verse_number": "५-३-९०-४३", "content_sanskrit": "सर्पसूषकयोर्युद्धं तथा केसरिनागयोः ।\nउन्मार्गाः सरितस्तत्रावहन्रक्तविमिश्रिताः ।\nअकालतरुपुष्पाणि दृश्यन्ते स्म समन्ततः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004396043, "chapter_id": 24396, "verse_number": "५-३-९०-४४", "content_sanskrit": "ततः प्राप्तो जगन्नाथो हिमवन्तं नगेश्वरम् ।\nपाञ्चजन्यश्वसहसा पूरितः पुरसन्निधौ॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004396044, "chapter_id": 24396, "verse_number": "५-३-९०-४५", "content_sanskrit": "तेन शब्देन महता ह्यारूढो दानवेश्वरः ।\nउवाच च तदा वाक्यं तालमेघो महाबलः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004396045, "chapter_id": 24396, "verse_number": "५-३-९०-४६", "content_sanskrit": "तालमेघ उवाच ।\nकोऽयं मृत्युवशं प्राप्तो ह्यज्ञात्वा मम विक्रमम् ।\nधुन्धुमाराज्ञया ह्याशु स्वसैन्यपरिवारितः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004396046, "chapter_id": 24396, "verse_number": "५-३-९०-४७", "content_sanskrit": "बलादानय तं बद्ध्वा ममाग्रे बहुशालिनम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004396047, "chapter_id": 24396, "verse_number": "५-३-९०-४८", "content_sanskrit": "धुन्धुमार उवाच ।\nआनयामि न सन्देहः सुरो यक्षोऽथ किन्नरः ।\nस्यन्दनौघैः समायुक्तो गजवाजिभटैः सह॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004396048, "chapter_id": 24396, "verse_number": "५-३-९०-४९", "content_sanskrit": "हृष्टस्ततो जगद्योनिः सुपर्णस्थो महाबलः ।\nगृह्यतां गृह्यतामेष इत्युक्तास्तेन किंकराः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004396049, "chapter_id": 24396, "verse_number": "५-३-९०-५०", "content_sanskrit": "चतुर्दिक्षु प्रधावन्त इतश्चेतश्च सर्वतः ।\nसुपर्णेनाग्निरूपेण दग्धास्ते शलभा यथा॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004396050, "chapter_id": 24396, "verse_number": "५-३-९०-५१", "content_sanskrit": "धुन्धुमारोऽपि कृष्णेन शरघातेन ताडितः ।\nहतो वक्षःस्थले पापो मृतावस्थो रथोपरि॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004396051, "chapter_id": 24396, "verse_number": "५-३-९०-५२", "content_sanskrit": "हाहाकारं ततः सर्वे दानवाश्चक्रुरातुराः ।\nतालमेघस्ततः क्रुद्धो रथारूढो विनिर्गतः ।\nददृशे केशवं पार्थ शङ्खचक्रगदाधरम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004396052, "chapter_id": 24396, "verse_number": "५-३-९०-५३", "content_sanskrit": "तालमेघ उवाच ।\nअन्ये ते दानवाः कृष्ण ये हताः समरे त्वया ।\nहिरण्यकशिपुप्रख्यानपुमांसो हि तेऽच्युत॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004396053, "chapter_id": 24396, "verse_number": "५-३-९०-५४", "content_sanskrit": "इत्युक्त्वा दानवः पार्थ वर्षयामास सायकैः ।\nदानवस्य शरान्मुक्तान् छेदयामास केशवः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004396054, "chapter_id": 24396, "verse_number": "५-३-९०-५५", "content_sanskrit": "गरुत्मानवधीत्सैन्यमवध्यं यत्सुरासुरैः ।\nकृष्णेन द्विगुणास्तस्य प्रेषिताः स्वशिलीमुखाः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004396055, "chapter_id": 24396, "verse_number": "५-३-९०-५६", "content_sanskrit": "द्विगुणं द्विगुणीकृत्य प्रेषयामास दानवः ।\nतानप्यष्टगुणैः कृष्णश्छादयामास सायकैः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004396056, "chapter_id": 24396, "verse_number": "५-३-९०-५७", "content_sanskrit": "ततः क्रुद्धेन दैत्येन ह्याग्नेयं बाणमुत्तमम्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004396057, "chapter_id": 24396, "verse_number": "५-३-९०-५८", "content_sanskrit": "वारुणं प्रेषयामास त्वाग्नेयं शमितं ततः ।\nवारुणेनैव वायव्यं तालमेघो व्यसर्जयत्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004396058, "chapter_id": 24396, "verse_number": "५-३-९०-५९", "content_sanskrit": "सार्पं चैव हृषीकेशो वायव्यस्य प्रशान्तये ।\nनारसिंहं नृसिंहोऽपि प्रेषयामास पाण्डव॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004396059, "chapter_id": 24396, "verse_number": "५-३-९०-६०", "content_sanskrit": "नारसिंहं ततो दृष्ट्वा तालमेघो महाबलः ।\nउत्तीर्य स्यन्दनाच्छीघ्रं गृहीत्वा खड्गचर्मणी॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004396060, "chapter_id": 24396, "verse_number": "५-३-९०-६१", "content_sanskrit": "कृष्ण त्वां प्रेषयिष्यामि यममार्गं सुदारुणम् ।\nइत्युक्त्वा दानवः पार्थ आगतः केशवं प्रति॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004396061, "chapter_id": 24396, "verse_number": "५-३-९०-६२", "content_sanskrit": "खड्गेनाताडयद्दैत्यो गदापाणिं जनार्दनम् ।\nमण्डलाग्रं ततो गृह्य केशवो हृष्टमानसः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004396062, "chapter_id": 24396, "verse_number": "५-३-९०-६३", "content_sanskrit": "जघनोरःस्थले पार्थ तालमेघं महाहवे ।\nजनार्दनस्तदा दैत्यं दैत्यो हरिमहन्मृधे॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004396063, "chapter_id": 24396, "verse_number": "५-३-९०-६४", "content_sanskrit": "जनार्दनस्ततः क्रुद्धस्तालमेघाय भारत ।\nअमोघं चक्रमादाय मुक्तं तस्य च मूर्धनि॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004396064, "chapter_id": 24396, "verse_number": "५-३-९०-६५", "content_sanskrit": "निपपात शिरस्तस्य पर्वताश्च चकम्पिरे ।\nसमुद्राः क्षुभिताः पार्थ नद्य उन्मार्गगामिनीः॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004396065, "chapter_id": 24396, "verse_number": "५-३-९०-६६", "content_sanskrit": "पुष्पवृष्टिं ततो देवा मुमुचुः केशवोपरि ।\nअवध्यः सुरसङ्घानां सूदितः केशव त्वया॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004396066, "chapter_id": 24396, "verse_number": "५-३-९०-६७", "content_sanskrit": "स्वस्थाश्चैव ततो देवास्तालमेघे निपातिते ।\nजनार्दनोऽपि कौन्तेय नर्मदातटमाश्रितः॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004396067, "chapter_id": 24396, "verse_number": "५-३-९०-६८", "content_sanskrit": "क्षीरोदां नर्मदां मत्वा अनन्तभुजगोपरि ।\nलक्ष्म्या समन्वितः कृष्णो निलीनश्चोत्तरे तटे॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004396068, "chapter_id": 24396, "verse_number": "५-३-९०-६९", "content_sanskrit": "चक्रं विभीषणं मर्त्ये ज्वालामालासमन्वितम् ।\nपतितं नर्मदातोये जलशायिसमीपतः॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004396069, "chapter_id": 24396, "verse_number": "५-३-९०-७०", "content_sanskrit": "निर्धूतकल्मषं जातं नर्मदातोययोगतः ।\nतालमेघवधोत्पन्नं यत्पापं नृपनन्दन॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004396070, "chapter_id": 24396, "verse_number": "५-३-९०-७१", "content_sanskrit": "तत्स्रवं क्षालितं सद्यो नर्मदांभसि भारत ।\nतदाप्रभृति लोकेऽस्मिञ्जलशायी महीपते॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004396071, "chapter_id": 24396, "verse_number": "५-३-९०-७२", "content_sanskrit": "चक्रतीर्थं वदन्त्यन्ये केचित्कालाघनाशनम् ।\nविख्यातं भारते वर्षे नर्मदायां महीपते॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004396072, "chapter_id": 24396, "verse_number": "५-३-९०-७३", "content_sanskrit": "तत्तीर्थस्य प्रभावोऽयं श्रूयतामवनीपते ।\nयथाऽनन्तो हि नागानां देवानां च जनार्दनः॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004396073, "chapter_id": 24396, "verse_number": "५-३-९०-७४", "content_sanskrit": "मासानां मार्गशीर्षोऽस्ति नदीनां नर्मदा यथा ।\nमासि मार्गशिरे पार्थ ह्येकादश्यां सितेऽहनि॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004396074, "chapter_id": 24396, "verse_number": "५-३-९०-७५", "content_sanskrit": "गत्वा यो मनुजो भक्त्या कामक्रोधविवर्जितः ।\nवैष्णवीं भावनां कृत्वा जलेशं तु व्रजेत वै॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004396075, "chapter_id": 24396, "verse_number": "५-३-९०-७६", "content_sanskrit": "एकभुक्तं च नक्तं च तथैवायाचितं नृप ।\nउपवासं तथा दानं ब्राह्मणानां च भोजनम्॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004396076, "chapter_id": 24396, "verse_number": "५-३-९०-७७", "content_sanskrit": "करोति च कुरुश्रेष्ठ न स याति यमालयम् ।\nयमलोकभयाद्भीता ये लोकाः पाण्डुनन्दन॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004396077, "chapter_id": 24396, "verse_number": "५-३-९०-७८", "content_sanskrit": "ते पश्यन्तु श्रियः कान्तं नागपर्यङ्कशायिनम् ।\nगोपीजनसमावृत्तं योगनिद्रां समाश्रितम् ।\nविश्वरूपं जगन्नाथं संसारभयनाशनम्॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004396078, "chapter_id": 24396, "verse_number": "५-३-९०-७९", "content_sanskrit": "स्नापयेत्परया भक्त्या क्षौद्रक्षीरेण सर्पिषा ।\nखण्डेन तोयमिश्रेण जगद्योनिं जनार्दनम्॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004396079, "chapter_id": 24396, "verse_number": "५-३-९०-८०", "content_sanskrit": "स्नाप्यमानं च पश्यन्ति ये लोका गतमत्सराः ।\nते यान्ति परमं लोकं सुरासुरनमस्कृतम्॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004396080, "chapter_id": 24396, "verse_number": "५-३-९०-८१", "content_sanskrit": "घृतेन बोधयेद्दीपमथवा तैलपूरितम् ।\nरात्रौ जागरणं कृत्वा दैवस्याग्रे विमत्सराः॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004396081, "chapter_id": 24396, "verse_number": "५-३-९०-८२", "content_sanskrit": "ये कथां वैष्णवीं भक्त्या शृण्वन्ति च नृपोत्तम ।\nब्रह्महत्यादिपापानि नश्यन्ते नात्र संशयः॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004396082, "chapter_id": 24396, "verse_number": "५-३-९०-८३", "content_sanskrit": "प्रदक्षिणन्ति ये मर्त्या जलशायिजगद्गुरुम् ।\nप्रदक्षिणीकृता तैस्तु सप्तद्वीपा वसुंधरा॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004396083, "chapter_id": 24396, "verse_number": "५-३-९०-८४", "content_sanskrit": "ततः प्रभाते विमले पित्ःन् संतर्पयेज्जलैः ।\nश्राद्धं च ब्राह्मणैस्तत्र योग्यैः पाण्डव मानवाः॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004396084, "chapter_id": 24396, "verse_number": "५-३-९०-८५", "content_sanskrit": "स्वदारनिरतैः शान्तैः परदारविवर्जकैः ।\nवेदाभ्यसनशीलैश्च स्वकर्मनिरतैः शुभैः॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004396085, "chapter_id": 24396, "verse_number": "५-३-९०-८६", "content_sanskrit": "नित्यं यजनशीलैश्च त्रिसन्ध्यापरिपालकैः ।\nश्रद्धया कारयेच्छ्राद्धं यदीच्छेच्छ्रेय आत्मनः॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004396086, "chapter_id": 24396, "verse_number": "५-३-९०-८७", "content_sanskrit": "ते धन्या मानुषे लोके वन्द्या हि भुवि मानवाः ।\nये वसन्ति सदाकालं पादपद्माश्रया हरेः॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004396087, "chapter_id": 24396, "verse_number": "५-३-९०-८८", "content_sanskrit": "जलशायं प्रपश्यन्ति प्रत्यक्षं सुरनायकम् ।\nपक्षोपवासं पाराकं व्रतं चान्द्रायणं शुभम्॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004396088, "chapter_id": 24396, "verse_number": "५-३-९०-८९", "content_sanskrit": "मासोपवासमुग्रं च षष्ठान्नं पञ्चमं व्रतम् ।\nतत्र तीर्थे तु यः कुर्यात्सोऽक्षयां गतिमाप्नुयात्॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004396089, "chapter_id": 24396, "verse_number": "५-३-९०-९०", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nअतः परं प्रवक्ष्यामि तिलधेनोश्च यत्फलम् ।\nयथा यस्मिन्यदा देया दाने तस्याः शुभं फलम्॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004396090, "chapter_id": 24396, "verse_number": "५-३-९०-९१", "content_sanskrit": "एतत्कथान्तरं पुण्यमृषेर्द्वैपायनात्पुरा ।\nश्रुतं हि नैमिषे पुण्ये नारदाद्यैरनेकधा॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004396091, "chapter_id": 24396, "verse_number": "५-३-९०-९२", "content_sanskrit": "इदं परममायुष्यं मङ्गल्यं कीर्तिवर्धनम् ।\nविप्राणां श्रावयन्विद्वान्फलानन्त्यंसमश्नुते॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004396092, "chapter_id": 24396, "verse_number": "५-३-९०-९३", "content_sanskrit": "बहुभ्यो न प्रदेयानि गौर्गृहं शयनं स्त्रियः ।\nविभक्तदक्षिणा ह्येता दातारं नाप्नुवन्ति च॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004396093, "chapter_id": 24396, "verse_number": "५-३-९०-९४", "content_sanskrit": "एकमेतत्प्रदातव्यं न बहूनां युधिष्ठिर ।\nसा च विक्रयमापन्ना दहत्यासप्तमं कुलम्॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004396094, "chapter_id": 24396, "verse_number": "५-३-९०-९५", "content_sanskrit": "यथालाभा तु सर्वेषां चतुर्द्रोणा तु गौः स्मृता ।\nद्रोणस्य वत्सकः कार्यो बहूनां वापि कामतः॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004396095, "chapter_id": 24396, "verse_number": "५-३-९०-९६", "content_sanskrit": "यस्मिन्देशे तु यन्मानं विषये वा विचारितम् ।\nतेन मानेन तां कुर्वन्नक्षयं फलमश्नुते॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004396096, "chapter_id": 24396, "verse_number": "५-३-९०-९७", "content_sanskrit": "सुखपूर्वं शुचौ भूमौ पुष्पधूपाक्षतैस्तथा ।\nकर्णाभ्यां रत्ने दातव्ये दीपौ नेत्रद्वये तथा॥ ९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004396097, "chapter_id": 24396, "verse_number": "५-३-९०-९८", "content_sanskrit": "श्रीखण्डमुरसि स्थाप्यं ताभ्यां चैव तु काञ्चनम् ।\nऊर्ध्वे मधु घृतं देयं कुर्यात्सर्षपरोमकम्॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004396098, "chapter_id": 24396, "verse_number": "५-३-९०-९९", "content_sanskrit": "कम्बले कम्बलं दद्याच्छ्रोण्यां मधु घृतं तथा ।\nयवसं पायसं दद्याद्घृतं क्षौद्रसमन्वितम्॥ ९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004396099, "chapter_id": 24396, "verse_number": "५-३-९०-१००", "content_sanskrit": "स्वर्णशृङ्गी रूप्यशिफारुक्मलाङ्गूलसंयुता ।\nरत्नपृष्ठी तु दातव्या कांस्यपात्रावदोहिनी॥ १०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004396100, "chapter_id": 24396, "verse_number": "५-३-९०-१०१", "content_sanskrit": "यत्स्याद्बाल्यकृतं पापं यद्वा कृतमजानता ।\nवाचा कृतं कर्मकृतं मनसा यद्विचिन्तितम्॥ १०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004396101, "chapter_id": 24396, "verse_number": "५-३-९०-१०२", "content_sanskrit": "जले निष्ठीवितं चैव मुशलं वापि लङ्घितम् ।\nवृषलीगमनं चैव गुरुदारनिषेवणम्॥ १०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004396102, "chapter_id": 24396, "verse_number": "५-३-९०-१०३", "content_sanskrit": "कन्याया गमनं चैव सुवर्णस्तेयमेव च ।\nसुरापानं तथा चान्यत्तिलधेनुः पुनाति हि॥ १०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7004396103, "chapter_id": 24396, "verse_number": "५-३-९०-१०४", "content_sanskrit": "अहोरात्रोपवासेन विधिवत्तां विसर्जयेत् ।\nया सा यमपुरे घोरे नदी वैतरणी स्मृता॥ १०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7004396104, "chapter_id": 24396, "verse_number": "५-३-९०-१०५", "content_sanskrit": "वालुकायोऽश्मस्थला च पच्यते यत्र दुष्कृती ।\nअवीचिर्नरको यत्र यत्र यामलपर्वतौ॥ १०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7004396105, "chapter_id": 24396, "verse_number": "५-३-९०-१०६", "content_sanskrit": "यत्र लोहमुखाः काका यत्र श्वानो भयंकराः ।\nअसिपत्त्रवनं चैव यत्र सा कूटशाल्मली॥ १०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7004396106, "chapter_id": 24396, "verse_number": "५-३-९०-१०७", "content_sanskrit": "तान्सुखेन व्यतिक्रम्य धर्मराजालयं व्रजेत् ।\nधर्मराजस्तु तं दृष्ट्वा सूनृतं वक्ति भारत॥ १०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7004396107, "chapter_id": 24396, "verse_number": "५-३-९०-१०८", "content_sanskrit": "विमानमुत्तमं योग्यं मणिरत्नविभूषितम् ।\nअत्रारुह्य नरश्रेष्ठ प्रयाहि परमां गतिम्॥ १०८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7004396108, "chapter_id": 24396, "verse_number": "५-३-९०-१०९", "content_sanskrit": "मा च चाटु भटे देहि मैव देहि पुरोहिते ।\nमा च काणे विरूपे च न्यूनाङ्गे न च देवले॥ १०९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7004396109, "chapter_id": 24396, "verse_number": "५-३-९०-११०", "content_sanskrit": "अवेदविदुषे नैव ब्राह्मणे सर्वविक्रये ।\nमित्रघ्ने च कृतघ्ने च मन्त्रहीने तथैव च॥ ११० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7004396110, "chapter_id": 24396, "verse_number": "५-३-९०-१११", "content_sanskrit": "वेदान्तगाय दातव्या श्रोत्रियाय कुटुम्बिने ।\nवेदान्तगसुते देया श्रोत्रिये गृहपालके॥ १११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7004396111, "chapter_id": 24396, "verse_number": "५-३-९०-११२", "content_sanskrit": "सर्वाङ्गरुचिरे विप्रे सद्वृत्ते च प्रियंवदे ।\nपूर्णिमायां तु माघस्य कार्त्तिक्यामथ भारत॥ ११२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7004396112, "chapter_id": 24396, "verse_number": "५-३-९०-११३", "content_sanskrit": "वैशाख्यां मार्गशीर्ष्यां वाषाढ्यां चैत्र्यामथापि वा ।\nअयने विषुवे चैव व्यतीपाते च सर्वदा॥ ११३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7004396113, "chapter_id": 24396, "verse_number": "५-३-९०-११४", "content_sanskrit": "षडशीतिमुखे पुण्ये छायायां कुंजरस्य वा ।\nएष ते कथितः कल्पस्तिलधेनोर्मयानघ॥ ११४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7004396114, "chapter_id": 24396, "verse_number": "५-३-९०-११५", "content_sanskrit": "व्रजन्ति वैष्णवं लोकं दत्त्वा पादं यमोपरि ।\nप्राणत्यागात्परं लोकं वैष्णवं नात्र संशयः ।\nभित्त्वाशु भास्करं यान्ति नात्र कार्या विचारणा॥ ११५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7004396115, "chapter_id": 24396, "verse_number": "५-३-९०-११६", "content_sanskrit": "एतत्ते सर्वमाख्यातं चक्रतीर्थफलं नृप ।\nयच्छ्रुत्वा मानवो भक्त्या सर्वपापैः प्रमुच्यते॥ ११६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}]