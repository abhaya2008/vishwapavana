[{"id": 7001134000, "chapter_id": 21134, "verse_number": "२-२-२५-१", "content_sanskrit": "राम उवाच ।\nएकदा हि पुरा देवि शंभुः परमसूतिकृत् ।\nविश्वकर्माणमाहूय स्वलोके परतः परे॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001134001, "chapter_id": 21134, "verse_number": "२-२-२५-२", "content_sanskrit": "स्वधेनुशालायां रम्यं कारयामास तेन च ।\nभवनं विस्तृतं सम्यक् तत्र सिंहासनं वरम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001134002, "chapter_id": 21134, "verse_number": "२-२-२५-३", "content_sanskrit": "तत्रच्छत्रं महादिव्यं सर्वदाद्भुत मुत्तमम् ।\nकारयामास विघ्नार्थं शंकरो विश्वकर्मणा॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001134003, "chapter_id": 21134, "verse_number": "२-२-२५-४", "content_sanskrit": "शक्रादीनां जुहावाशु समस्तान्देवतागणान् ।\nसिद्धगंधर्वनागानुपदे शांश्च कृत्स्नशः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001134004, "chapter_id": 21134, "verse_number": "२-२-२५-५", "content_sanskrit": "देवान् सर्वानागमांश्च विधिं पुत्रैर्मुनीनपि ।\nदेवीः सर्वा अप्सरोभिर्नानावस्तुसमन्विताः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001134005, "chapter_id": 21134, "verse_number": "२-२-२५-६", "content_sanskrit": "देवानां च तथर्षीणां सिद्धानां फणिनामपि ।\nआनयन्मंगलकराः कन्याः षोडशषोडश॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001134006, "chapter_id": 21134, "verse_number": "२-२-२५-७", "content_sanskrit": "वीणामृदंगप्रमुखवाद्यान्नानाविधान्मुने ।\nउत्सवं कारयामास वादयित्वा सुगायनैः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001134007, "chapter_id": 21134, "verse_number": "२-२-२५-८", "content_sanskrit": "राजाभिषेकयोग्यानि द्रव्याणि सकलौषधैः ।\nप्रत्यक्षतीर्थपाथोभिः पंचकुभांश्च पूरितान्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001134008, "chapter_id": 21134, "verse_number": "२-२-२५-९", "content_sanskrit": "तथान्यास्संविधा दिव्या आनयत्स्वगणैस्तदा ।\nब्रह्मघोषं महारावं कारयामास शंकरः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001134009, "chapter_id": 21134, "verse_number": "२-२-२५-१०", "content_sanskrit": "अथो हरिं समाहूय वैकुंठात्प्रीतमानसः ।\nतद्भक्त्या पूर्णया देवि मोदतिस्म महेश्वरः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001134010, "chapter_id": 21134, "verse_number": "२-२-२५-११", "content_sanskrit": "सुमुहूर्ते महादेवस्तत्र सिंहासने वरे ।\nउपवेश्य हरिं प्रीत्या भूषयामास सर्वशः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001134011, "chapter_id": 21134, "verse_number": "२-२-२५-१२", "content_sanskrit": "आबद्धरम्यमुकुटं कृतकौतुकमंगलम् ।\nअभ्यषिंचन्महेशस्तु स्वयं ब्रह्मांडमंडपे॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001134012, "chapter_id": 21134, "verse_number": "२-२-२५-१३", "content_sanskrit": "दत्तवान्निखिलैश्वर्यं यन्नैजं नान्यगामि यत् ।\nततस्तुष्टाव तं शंभुस्स्वतंत्रो भक्तवत्सलः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001134013, "chapter_id": 21134, "verse_number": "२-२-२५-१४", "content_sanskrit": "ब्रह्माणं लोककर्तारमवोचद्वचनं त्विदम् ।\nव्यापयन्स्वं वराधीनं स्वतंत्रं भक्तवत्सलः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001134014, "chapter_id": 21134, "verse_number": "२-२-२५-१५", "content_sanskrit": "महेश उवाच ।\nअतः प्रभृति लोकेश मन्निदेशादयं हरिः ।\nमम वंद्य स्वयं विष्णुर्जातस्सर्वश्शृणोति हि॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001134015, "chapter_id": 21134, "verse_number": "२-२-२५-१६", "content_sanskrit": "सर्वैर्देवादिभिस्तात प्रणमत्वममुं हरिम् ।\nवर्णयंतु हरिं वेदा ममैते मामिवाज्ञया॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001134016, "chapter_id": 21134, "verse_number": "२-२-२५-१७", "content_sanskrit": "राम उवाच ।\nइत्युक्त्वाथ स्वयं रुद्रोऽनमद्वै गरुडध्वजम् ।\nविष्णुभक्तिप्रसन्नात्मा वरदो भक्तवत्सलः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001134017, "chapter_id": 21134, "verse_number": "२-२-२५-१८", "content_sanskrit": "ततो ब्रह्मादिभिर्देवैः सर्वरूपसुरैस्तथा ।\nमुनिसिद्धादिभिश्चैवं वंदितोभूद्धरिस्तदा॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001134018, "chapter_id": 21134, "verse_number": "२-२-२५-१९", "content_sanskrit": "ततो महेशो हरयेशंसद्दिविषदां तदा ।\nमहावरान् सुप्रसन्नो धृतवान्भक्तवत्सलः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001134019, "chapter_id": 21134, "verse_number": "२-२-२५-२०", "content_sanskrit": "महेश उवाच ।\nत्वं कर्ता सर्वलोकानां भर्ता हर्ता मदाज्ञया ।\nदाता धर्मार्थकामानां शास्ता दुर्नयकारिणाम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001134020, "chapter_id": 21134, "verse_number": "२-२-२५-२१", "content_sanskrit": "जगदीशो जगत्पूज्यो महाबलपराक्रमः ।\nअजेयस्त्वं रणे क्वापि ममापि हि भविष्यसि॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001134021, "chapter_id": 21134, "verse_number": "२-२-२५-२२", "content_sanskrit": "शक्तित्रयं गृहाण त्वमिच्छादि प्रापितं मया ।\nनानालीलाप्रभावत्वं स्वतंत्रत्वं भवत्रये॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001134022, "chapter_id": 21134, "verse_number": "२-२-२५-२३", "content_sanskrit": "त्वद्द्वेष्टारो हरे नूनं मया शास्याः प्रयत्नतः ।\nत्वद्भक्तानां मया विष्णो देयं निर्वाणमुत्तमम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001134023, "chapter_id": 21134, "verse_number": "२-२-२५-२४", "content_sanskrit": "मायां चापि गृहाणेमां दुःप्रणोद्यां सुरादिभिः ।\nयया संमोहितं विश्वमचिद्रूपं भविष्यति॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001134024, "chapter_id": 21134, "verse_number": "२-२-२५-२५", "content_sanskrit": "मम बाहुर्मदीयस्तं दक्षिणोऽसौ विधिर्हरे ।\nअस्यापि हि विधेः पाता जनितापि भविष्यसि॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001134025, "chapter_id": 21134, "verse_number": "२-२-२५-२६", "content_sanskrit": "हृदयं मम यो रुद्रस्स एवाहं न संशयः ।\nपूज्यस्तव सदा सोपि ब्रह्मादीनामपि ध्रुवम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001134026, "chapter_id": 21134, "verse_number": "२-२-२५-२७", "content_sanskrit": "अत्र स्थित्वा जगत्सर्वं पालय त्वं विशेषतः ।\nनानावतारभेदैश्च सदा नानोति कर्तृभिः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001134027, "chapter_id": 21134, "verse_number": "२-२-२५-२८", "content_sanskrit": "मम लोके तवेदं व स्थानं च परमर्द्धिमत् ।\nगोलोक इति विख्यातं भविष्यति महोज्ज्वलम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001134028, "chapter_id": 21134, "verse_number": "२-२-२५-२९", "content_sanskrit": "भविष्यंति हरे ये तेऽवतारा भुवि रक्षकाः ।\nमद्भक्तास्तान् ध्रुवं द्रक्ष्ये प्रीतानथ निजाद्वरात॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001134029, "chapter_id": 21134, "verse_number": "२-२-२५-३०", "content_sanskrit": "राम उवाच ।\nअखंडैश्वर्यमासाद्य हरेरित्थं हरस्स्वयम् ।\nकैलासे स्वगणैस्तस्मिन् स्वैरं क्रीडत्युमापतिः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001134030, "chapter_id": 21134, "verse_number": "२-२-२५-३१", "content_sanskrit": "तदाप्रभृति लक्ष्मीशो गोपवेषोभवत्तथा ।\nअयासीत्तत्र सुप्रीत्या गोपगोपोगवां पतिः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001134031, "chapter_id": 21134, "verse_number": "२-२-२५-३२", "content_sanskrit": "सोपि विष्णुः प्रसन्नात्मा जुगोप निखिलं जगत् ।\nनानावतारस्संधर्ता वनकर्ता शिवाज्ञया॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001134032, "chapter_id": 21134, "verse_number": "२-२-२५-३३", "content_sanskrit": "इदानीं स चतुर्द्धात्रावातरच्छंकराज्ञया ।\nरामोहं तत्र भरतो लक्ष्मणश्शत्रुहेति च॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001134033, "chapter_id": 21134, "verse_number": "२-२-२५-३४", "content_sanskrit": "अथ पित्राज्ञया देवि ससीतालक्ष्मणस्सति ।\nआगतोहं वने चाद्य दुःखितौ दैवतो ऽभवम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001134034, "chapter_id": 21134, "verse_number": "२-२-२५-३५", "content_sanskrit": "निशाचरेण मे जाया हृता सीतेति केनचित् ।\nअन्वेष्यामि प्रियां चात्र विरही बंधुना वने॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001134035, "chapter_id": 21134, "verse_number": "२-२-२५-३६", "content_sanskrit": "दर्शनं ते यदि प्राप्तं सर्वथा कुशलं मम ।\nभविष्यति न संदेहो मातस्ते कृपया सति॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001134036, "chapter_id": 21134, "verse_number": "२-२-२५-३७", "content_sanskrit": "सीताप्राप्तिवरो देवि भविष्यति न संशयः ।\nतं हत्वा दुःखदं पापं राक्षसं त्वदनुग्रहात्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001134037, "chapter_id": 21134, "verse_number": "२-२-२५-३८", "content_sanskrit": "महद्भाग्यं ममाद्यैव यद्यकार्ष्टां कृपां युवाम् ।\nयस्मिन् सकरुणौ स्यातां स धन्यः पुरुषो वरः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001134038, "chapter_id": 21134, "verse_number": "२-२-२५-३९", "content_sanskrit": "इत्थमाभाष्य बहुधा सुप्रणम्य सतीं शिवाम् ।\nतदाज्ञया वने तस्मिन् विचचार रघूद्वहः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001134039, "chapter_id": 21134, "verse_number": "२-२-२५-४०", "content_sanskrit": "अथाकर्ण्य सती वाक्यं रामस्य प्रयतात्मनः ।\nहृष्टाभूत्सा प्रशंसन्ती शिवभक्तिरतं हृदि॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001134040, "chapter_id": 21134, "verse_number": "२-२-२५-४१", "content_sanskrit": "स्मृत्वा स्वकर्म मनसाकार्षीच्छोकं सुविस्तरम् ।\nप्रत्यागच्छदुदासीना विवर्णा शिवसन्निधौ॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001134041, "chapter_id": 21134, "verse_number": "२-२-२५-४२", "content_sanskrit": "अचिंतयत्पथि सा देवी संचलंती पुनः पुनः ।\nनांगीकृतं शिवोक्तं मे रामं प्रति कुधीः कृता॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001134042, "chapter_id": 21134, "verse_number": "२-२-२५-४३", "content_sanskrit": "किमुत्तरमहं दास्ये गत्वा शंकरसन्निधौ ।\nइति संचिंत्य बहुधा पश्चात्तापोऽभवत्तदा॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001134043, "chapter_id": 21134, "verse_number": "२-२-२५-४४", "content_sanskrit": "गत्वा शंभुसमीपं च प्रणनाम शिवं हृदा ।\nविषण्णवदना शोकव्याकुला विगतप्रभा॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001134044, "chapter_id": 21134, "verse_number": "२-२-२५-४५", "content_sanskrit": "अथ तां दुःखितां दृष्ट्वा पप्रच्छ कुशलं हरः ।\nप्रोवाच वचनं प्रीत्या तत्परीक्षा कृता कथम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001134045, "chapter_id": 21134, "verse_number": "२-२-२५-४६", "content_sanskrit": "श्रुत्वा शिववचो नाहं किमपि प्रणतानना ।\nसती शोकविषण्णा सा तस्थौ तत्र समीपतः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001134046, "chapter_id": 21134, "verse_number": "२-२-२५-४७", "content_sanskrit": "अथ ध्यात्वा महेशस्तु बुबोध चरितं हृदा ।\nदक्षजाया महायोगी नानालीला विशारदः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001134047, "chapter_id": 21134, "verse_number": "२-२-२५-४८", "content_sanskrit": "सस्मार स्वपणं पूर्वं यत्कृतं हरिकोपतः ।\nतत्प्रार्थितोथ रुद्रोसौ मर्यादा प्रतिपालकः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001134048, "chapter_id": 21134, "verse_number": "२-२-२५-४९", "content_sanskrit": "विषादोभूत्प्रभोस्तत्र मनस्येवमुवाच ह ।\nधर्मवक्ता धर्मकर्त्ता धर्मावनकरस्सदा॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001134049, "chapter_id": 21134, "verse_number": "२-२-२५-५०", "content_sanskrit": "शिव उवाच ।\nकुर्यां चेद्दक्षजायां हि स्नेहं पूर्वं यथा महान् ।\nनश्येन्मम पणः शुद्धो लोकलीलानुसारिणः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001134050, "chapter_id": 21134, "verse_number": "२-२-२५-५१", "content_sanskrit": "ब्रह्मोवाच ।\nइत्थं विचार्य बहुधा हृदा तामत्यजत्सतीम् ।\nपणं न नाशयामास वेदधर्मप्रपालकः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001134051, "chapter_id": 21134, "verse_number": "२-२-२५-५२", "content_sanskrit": "ततो विहाय मनसा सतीं तां परमेश्वरः ।\nजगाम स्वगिरि भेदं जगावद्धा स हि प्रभुः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001134052, "chapter_id": 21134, "verse_number": "२-२-२५-५३", "content_sanskrit": "चलंतं पथि तं व्योमवाण्युवाच महेश्वरम् ।\nसर्वान् संश्रावयन् तत्र दक्षजां च विशेषतः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001134053, "chapter_id": 21134, "verse_number": "२-२-२५-५४", "content_sanskrit": "व्योमवाण्युवाच ।\nधन्यस्त्वं परमेशान त्वत्त्समोद्य तथा पणः ।\nन कोप्यन्यस्त्रिलोकेस्मिन् महायोगी महाप्रभुः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001134054, "chapter_id": 21134, "verse_number": "२-२-२५-५५", "content_sanskrit": "ब्रह्मोवाच ।\nश्रुत्वा व्योमवचो देवी शिवं पप्रच्छ विप्रभा ।\nकं पणं कृतवान्नाथ ब्रूहि मे परमेश्वर॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001134055, "chapter_id": 21134, "verse_number": "२-२-२५-५६", "content_sanskrit": "इति पृष्टोपि गिरिशस्सत्या हितकरः प्रभुः ।\nनोद्वाहे स्वपणं तस्यै कहर्यग्रेऽकरोत्पुरा॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001134056, "chapter_id": 21134, "verse_number": "२-२-२५-५७", "content_sanskrit": "तदा सती शिवं ध्यात्वा स्वपतिं प्राणवल्लभम् ।\nसर्वं बुबोध हेतुं तं प्रियत्यागमयं मुने॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001134057, "chapter_id": 21134, "verse_number": "२-२-२५-५८", "content_sanskrit": "ततोऽतीव शुशोचाशु बुध्वा सा त्यागमात्मनः ।\nशंभुना दक्षजा तस्मान्निश्वसंती मुहुर्मुहुः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001134058, "chapter_id": 21134, "verse_number": "२-२-२५-५९", "content_sanskrit": "शिवस्तस्याः समाज्ञाय गुप्तं चक्रे मनोभवम् ।\nसत्ये पणं स्वकीयं हि कथा बह्वीर्वदन्प्रभुः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001134059, "chapter_id": 21134, "verse_number": "२-२-२५-६०", "content_sanskrit": "सत्या प्राप स कैलासं कथयन् विविधाः कथा ।\nवरे स्थित्वा निजं रूपं दधौ योगी समाधिभृत्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001134060, "chapter_id": 21134, "verse_number": "२-२-२५-६१", "content_sanskrit": "तत्र तस्थौ सती धाम्नि महाविषण्णमानसा ।\nन बुबोध चरित्रं तत्कश्चिच्च शिवयोर्मुने॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001134061, "chapter_id": 21134, "verse_number": "२-२-२५-६२", "content_sanskrit": "महान्कालो व्यतीयाय तयोरित्थं महामुने ।\nस्वोपात्तदेहयोः प्रभ्वोर्लोकलीलानुसारिणोः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001134062, "chapter_id": 21134, "verse_number": "२-२-२५-६३", "content_sanskrit": "ध्यानं तत्याज गिरिशस्ततस्स परमार्तिहृत् ।\nतज्ज्ञात्वा जगदंबा हि सती तत्राजगाम सा॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001134063, "chapter_id": 21134, "verse_number": "२-२-२५-६४", "content_sanskrit": "ननामाथ शिवं देवी हृदयेन विदूयता ।\nआसनं दत्तवाञ्शंभुः स्वसन्मुख उदारधीः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001134064, "chapter_id": 21134, "verse_number": "२-२-२५-६५", "content_sanskrit": "कथयामास सुप्रीत्या कथा बह्वीर्मनोरमाः ।\nनिश्शोका कृतवान्सद्यो लीलां कृत्वा च तादृशीम्॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001134065, "chapter_id": 21134, "verse_number": "२-२-२५-६६", "content_sanskrit": "पूर्ववत्सा सुखं लेभे तत्याज स्वपणं न सः ।\nनेत्याश्चर्यं शिवे तात मंतव्यं परमेश्वरे॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001134066, "chapter_id": 21134, "verse_number": "२-२-२५-६७", "content_sanskrit": "इत्थं शिवाशिवकथां वदन्ति मुनयो मुने ।\nकिल केचिदविद्वांसो वियोगश्च कथं तयोः॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001134067, "chapter_id": 21134, "verse_number": "२-२-२५-६८", "content_sanskrit": "शिवाशिवचरित्रं को जानाति परमार्थतः ।\nस्वेच्छया क्रीडतस्तो हि चरितं कुरुतस्सदा॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001134068, "chapter_id": 21134, "verse_number": "२-२-२५-६९", "content_sanskrit": "वागर्थाविव संपृक्तौ सदा खलु सतीशिवौ ।\nतयोर्वियोगस्संभाव्यस्संभवेदिच्छया तयोः॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]