[{"id": 7003234000, "chapter_id": 23234, "verse_number": "१-३७-१", "content_sanskrit": "सनत्कुमार उवाच  ।\nभवान्कथमनुप्राप्तो महादेवमुमापतिम्  ।\nश्रोतुमिच्छामि तत्सर्वं वक्तुमर्हसि मे प्रभो ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003234001, "chapter_id": 23234, "verse_number": "१-३७-२", "content_sanskrit": "शैलादिरुवाच  ।\nप्रजाकामः शिलादोभूत्पिता मम महामुने  ।\nसोप्यंधः सुचिरं कालं तपस्तेपे सुदुश्चरम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003234002, "chapter_id": 23234, "verse_number": "१-३७-३", "content_sanskrit": "तपतस्तस्य तपसा संतुष्टो वज्रधृक् प्रभुः  ।\nशिलादमाह तुष्टोस्मि वरयस्व वरानिति ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003234003, "chapter_id": 23234, "verse_number": "१-३७-४", "content_sanskrit": "ततः प्रणम्य देवेशं सहस्राक्षं सहामरैः  ।\nप्रोवाच मुनिशार्दूल कृतांजलिपुटो हरिम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003234004, "chapter_id": 23234, "verse_number": "१-३७-५", "content_sanskrit": "शिलाद उवाच  ।\nभगवन्देवतारिघ्न सहस्राक्ष वरप्रद  ।\nअयोनिजं मृत्युहीनं पुत्रमिच्छामि सुव्रत ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003234005, "chapter_id": 23234, "verse_number": "१-३७-६", "content_sanskrit": "शक्र उवाच  ।\nपुत्रं दास्यामि विप्रर्षे योनिजं मृत्युसंयुतम्  ।\nअन्यता ते न दास्यामि मृत्युहीना न संति वै ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003234006, "chapter_id": 23234, "verse_number": "१-३७-७", "content_sanskrit": "न दास्यति सुतं तेऽत्र मृत्युहीनमयोनिजम्  ।\nपितामहोपि भगवान्किमुतान्ये महामुने ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003234007, "chapter_id": 23234, "verse_number": "१-३७-८", "content_sanskrit": "सोपि देवः स्वयं ब्रह्मा मृत्युहीनो न चेश्वरः  ।\nयोनिजश्च महा तेजाश्चाण्डजः पद्मसंभवः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003234008, "chapter_id": 23234, "verse_number": "१-३७-९", "content_sanskrit": "महेश्वरांगजश्चैव भवान्यास्तनयः प्रभुः  ।\nतस्याप्यायुः समाख्यातं परार्धद्वयसंमितम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003234009, "chapter_id": 23234, "verse_number": "१-३७-१०", "content_sanskrit": "कोटिकोटिसहस्राणि अहर्भूतानि यानि वै  ।\nसमतीतानि कल्पानां तावच्छेषा परत्र ये ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003234010, "chapter_id": 23234, "verse_number": "१-३७-११", "content_sanskrit": "तस्मादयोनिजे पुत्रे मृत्युहीने प्रयत्नतः  ।\nपरित्यजाशां विप्रेंद्र गृहाणात्मसमं सुतम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003234011, "chapter_id": 23234, "verse_number": "१-३७-१२", "content_sanskrit": "शैलादिरुवाच  ।\nतस्य तद्वचनं श्रुत्वा पिता मे लोकविश्रुतः  ।\nशिलाद इति पुण्यात्मा पुनः प्राह शचीपतिम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003234012, "chapter_id": 23234, "verse_number": "१-३७-१३", "content_sanskrit": "शिलाद उवाच  ।\nभगवन्नंडयोनित्वं पद्मयोनित्वमेव च  ।\nमहेश्वरांगयोनित्वं श्रुतं वै ब्रह्मणो मया ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003234013, "chapter_id": 23234, "verse_number": "१-३७-१४", "content_sanskrit": "पुरा महेंद्रदायादाद्गदतश्चास्य पूर्वजात्  ।\nनारदाद्वै महाबाहो कथमत्राशु नो वद ॥१४।।॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003234014, "chapter_id": 23234, "verse_number": "१-३७-१५", "content_sanskrit": "दाक्षायणी सा दक्षोपि देवः पद्मोद्भवात्मजः  ।\nपौजी कनकगर्भस्य कथं तस्याः सुतो विभुः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003234015, "chapter_id": 23234, "verse_number": "१-३७-१६", "content_sanskrit": "शक्र उवाच  ।\nस्थाने संशयितुं विप्र तव वक्ष्यामि कारणम्  ।\nकल्पे तत्पुरुषे वृत्तं ब्रह्मणः परमेष्ठिनः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003234016, "chapter_id": 23234, "verse_number": "१-३७-१७", "content_sanskrit": "ससर्ज सकलं ध्यात्वा ब्रह्माणं परमेश्वरः  ।\nजनार्दनो जगन्नाथः कल्पे वै मेघवाहने ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003234017, "chapter_id": 23234, "verse_number": "१-३७-१८", "content_sanskrit": "दिव्यं वर्षसहस्रं तु मेघो भूत्वावहद्धरम्  ।\nनारायणो महादेवं बहुमानेन सादरम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003234018, "chapter_id": 23234, "verse_number": "१-३७-१९", "content_sanskrit": "दृष्ट्वा भावं महादेवो हरेः स्वात्मनि शंकरः  ।\nप्रददौ तस्य सकलं स्रष्टुं वै ब्रह्मणा सह ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003234019, "chapter_id": 23234, "verse_number": "१-३७-२०", "content_sanskrit": "तदा तं कल्पमाहुर्वै मेघवाहनसंज्ञया  ।\nहिरण्यगर्भस्तं दृष्ट्वा तस्य देहोद्भवस्तदा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003234020, "chapter_id": 23234, "verse_number": "१-३७-२१", "content_sanskrit": "जनार्दनसुतः प्राह तपसा प्राप्य शंकरम्  ।\nतव वामांगजो विष्णुर्दक्षिणांगभवो ह्यहम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003234021, "chapter_id": 23234, "verse_number": "१-३७-२२", "content_sanskrit": "मया सह जगत्सर्वं तथाप्यसृजदच्युतः  ।\nजगन्मयोवहद्यस्मान्मेघो भूत्वा दिवानिशम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003234022, "chapter_id": 23234, "verse_number": "१-३७-२३", "content_sanskrit": "भवंतमवहद्विष्णुर्देवदेवं जगद्गुरुम्  ।\nनारायणादपि विभो भक्तोहं तव शंकर ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003234023, "chapter_id": 23234, "verse_number": "१-३७-२४", "content_sanskrit": "प्रसीद देहि मे सर्वं सर्वात्मत्वं तव प्रभो  ।\nतदाथ लब्ध्वा भगवान् भवात्सर्वात्मतां क्षणात् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003234024, "chapter_id": 23234, "verse_number": "१-३७-२५", "content_sanskrit": "त्वरमाणोथ संगम्य ददर्श पुरुषोत्तमम्  ।\nएकार्णवालये शुभ्रे त्वन्धकारे सुदारुणे ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003234025, "chapter_id": 23234, "verse_number": "१-३७-२६", "content_sanskrit": "हेमरत्नचिते दिव्ये मनसा च विनिर्मिते  ।\nदुष्प्राप्ये दुर्जनैः पुण्यैः सनकाद्यैरगोचरे ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003234026, "chapter_id": 23234, "verse_number": "१-३७-२७", "content_sanskrit": "जगदावासहृदयं ददर्श पुरुषं त्वजः  ।\nअनंत भोगशय्यायां शायिनं पंकजेक्षणम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003234027, "chapter_id": 23234, "verse_number": "१-३७-२८", "content_sanskrit": "शंखचक्रगदापद्मं धारयन्तं चतुर्भुजम्  ।\nसर्वाभरणसंयुक्तं शशिमंडलसन्निभम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003234028, "chapter_id": 23234, "verse_number": "१-३७-२९", "content_sanskrit": "श्रीवत्स लक्षणं देवं प्रसन्नास्यं जनार्दनम्  ।\nरमामृदुकरांभोजस्पर्शरक्तपदांबुजम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003234029, "chapter_id": 23234, "verse_number": "१-३७-३०", "content_sanskrit": "परमात्मानमीशानं तमसा कालरूपिणम्  ।\nरजसा सर्वलोकानां सर्गलीलाप्रवर्तकम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003234030, "chapter_id": 23234, "verse_number": "१-३७-३१", "content_sanskrit": "सत्त्वेन सर्वभूतानां स्थापकं परमेश्वरम्  ।\nसर्वात्मानं महात्मानं परमात्मानमीश्वरम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003234031, "chapter_id": 23234, "verse_number": "१-३७-३२", "content_sanskrit": "क्षीरार्णवेऽमृतमये शायिनं योगनिद्रया  ।\nतं दृष्ट्वा प्राह वै ब्रह्मा भगवन्तं जनार्दनम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003234032, "chapter_id": 23234, "verse_number": "१-३७-३३", "content_sanskrit": "ग्रसामि त्वां प्रसादेन यथापूर्वं भवानहम्  ।\nस्मयमानस्तु भगवान् प्रतिबुध्य पितामहम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003234033, "chapter_id": 23234, "verse_number": "१-३७-३४", "content_sanskrit": "उदैक्षत महाबाहुः स्मितमीषच्चकार सः  ।\nविवेश चांडजं तं तु ग्रस्तस्तेन महात्मना ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003234034, "chapter_id": 23234, "verse_number": "१-३७-३५", "content_sanskrit": "ततस्तं चासृजद्ब्रह्म भ्रुवोर्मध्येन चाच्युतम्  ।\nसृष्टस्तेन हरिः प्रेक्ष्य स्थितस्तस्याथ सन्निधौ ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003234035, "chapter_id": 23234, "verse_number": "१-३७-३६", "content_sanskrit": "एतस्मिन्नंतरे रुद्रः सर्वदेवभवोद्भवः  ।\nविकृतं रूपमास्थाय पुरा दत्तवरस्तयोः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003234036, "chapter_id": 23234, "verse_number": "१-३७-३७", "content_sanskrit": "आगच्छद्यत्र वै विष्णुर्विश्वात्मा परमेश्वरः  ।\nप्रसादमतुलं कर्तुं ब्रह्मणश्च हरेः प्रभुः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003234037, "chapter_id": 23234, "verse_number": "१-३७-३८", "content_sanskrit": "ततः समेत्य तौ देवौ सर्वदेवभवोद्भवम्  ।\nअपश्यतां भवं देवं कालाग्निसदृशं प्रभुम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003234038, "chapter_id": 23234, "verse_number": "१-३७-३९", "content_sanskrit": "तौ तं तुष्टुवतुश्चैव शर्वमुग्रं कपर्दिनम्  ।\nप्रणेमतुश्च वरदं बहुमानेन दूरतः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003234039, "chapter_id": 23234, "verse_number": "१-३७-४०", "content_sanskrit": "भवोपि भगवान् देवमनुगृह्य पितामहम्  ।\nजनार्दनं जगन्नाथस्तत्रैवांतरधीयत ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]