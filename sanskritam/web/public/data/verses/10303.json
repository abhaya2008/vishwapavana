[{"id": 6000303000, "chapter_id": 10303, "verse_number": null, "content_sanskrit": "द्वितीयाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000303001, "chapter_id": 10303, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.001.m4a", "display_order": 2}, {"id": 6000303002, "chapter_id": 10303, "verse_number": "११-२-१", "content_sanskrit": "गोविन्दभुजगुप्तायां द्वारकायां कुरूद्वह।\nअवात्सीन्नारदोऽभीक्ष्णं कृष्णोपासनलालसः॥ ११/२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.002.m4a", "display_order": 3, "topics": [{"text": "श्रीकृष्णसेवार्थमभीक्ष्णं द्वारकायां निवसन्तं नारदं प्रति वसुदेवेन भागवतधर्मप्रश्नः", "range": "१–९"}]}, {"id": 6000303003, "chapter_id": 10303, "verse_number": "११-२-२", "content_sanskrit": "को नु राजन्निन्द्रियवान् मुकुन्दचरणाम्बुजम्।\nन भजेत् सर्वतोमृत्युरुपास्यममरोत्तमैः॥ ११/२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.003.m4a", "display_order": 4}, {"id": 6000303004, "chapter_id": 10303, "verse_number": "११-२-३", "content_sanskrit": "तमेकदा तु देवर्षिं वसुदेवो गृहागतम्।\nअर्चितं सुखमासीनमभिवन्द्येदमब्रवीत्॥ ११/२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.004.m4a", "display_order": 5}, {"id": 6000303005, "chapter_id": 10303, "verse_number": null, "content_sanskrit": "वसुदेव उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.005.m4a", "display_order": 6}, {"id": 6000303006, "chapter_id": 10303, "verse_number": "११-२-४", "content_sanskrit": "भगवन् भवतो यात्रा स्वस्तये सर्वदेहिनाम्।\nकृपणानां यथा पित्रोरुत्तमश्लोकवर्त्मनः॥ ११/२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.006.m4a", "display_order": 7}, {"id": 6000303007, "chapter_id": 10303, "verse_number": "११-२-५", "content_sanskrit": "भूतानां देवचरितं दुःखाय च सुखाय च।\nसुखायैव हि साधूनां त्वादृशामच्युतात्मनाम्॥ ११/२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.007.m4a", "display_order": 8}, {"id": 6000303008, "chapter_id": 10303, "verse_number": "११-२-६", "content_sanskrit": "भजन्ति ये यथा देवान् देवा अपि तथैव तान्।\nछायेव कर्मसचिवाः साधवो दीनवत्सलाः॥ ११/२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.008.m4a", "display_order": 9}, {"id": 6000303009, "chapter_id": 10303, "verse_number": "११-२-७", "content_sanskrit": "ब्रह्मंस्तथापि पृच्छामो धर्मान् भागवतांस्तव।\nयान् श्रुत्वा श्रद्धया मर्त्यो मुच्यते सर्वतोभयात्॥ ११/२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.009.m4a", "display_order": 10}, {"id": 6000303010, "chapter_id": 10303, "verse_number": "११-२-८", "content_sanskrit": "अहं किल पुराऽनन्तं प्रजार्थे भुवि मुक्तिदम्।\nअपूजयं न मोक्षाय मोहितो देवमायया॥ ११/२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.010.m4a", "display_order": 11}, {"id": 6000303011, "chapter_id": 10303, "verse_number": "११-२-९", "content_sanskrit": "यथा विचित्रव्यसनाद् भवेऽस्मिन् विश्वतोभयात्।\nमुच्येम ह्यञ्जसैवाद्धा तथा नः शाधि सुव्रत॥ ११/२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.011.m4a", "display_order": 12}, {"id": 6000303012, "chapter_id": 10303, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.012.m4a", "display_order": 13}, {"id": 6000303013, "chapter_id": 10303, "verse_number": "११-२-१०", "content_sanskrit": "राजन्नेवं कृतप्रश्नो वसुदेवेन धीमता।\nप्रीतस्तमाह देवर्षिर्हरेः संस्मारितो गुणैः॥ ११/२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.013.m4a", "display_order": 14, "topics": [{"text": "नारदेन वसुदेवाय निमिजायन्तेयसंवादरूपभागवतधर्मकथनम्", "range": "१०–३१"}]}, {"id": 6000303014, "chapter_id": 10303, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.014.m4a", "display_order": 15}, {"id": 6000303015, "chapter_id": 10303, "verse_number": "११-२-११", "content_sanskrit": "सम्यगेतद् व्यवसितं भवता सात्वतर्षभ।\nयत् पृच्छसे भागवतान् धर्मांस्त्वं विश्वभावनान्॥ ११/२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.015.m4a", "display_order": 16}, {"id": 6000303016, "chapter_id": 10303, "verse_number": "११-२-१२", "content_sanskrit": "श्रुतोऽनुपठितो ध्यात आदृतो वाऽनुमोदितः।\nसद्यः पुनाति सद्धर्मो देवविश्वद्रुहोऽपि हि॥ ११/२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.016.m4a", "display_order": 17}, {"id": 6000303017, "chapter_id": 10303, "verse_number": "११-२-१३", "content_sanskrit": "त्वया परमकल्याण पुण्यश्रवणकीर्तनः।\nस्मारितो भगवानद्य देवो नारायणो मम॥ ११/२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.017.m4a", "display_order": 18}, {"id": 6000303018, "chapter_id": 10303, "verse_number": "११-२-१४", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nआर्षभाणां च संवादं विदेहस्य महात्मनः॥ ११/२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.018.m4a", "display_order": 19}, {"id": 6000303019, "chapter_id": 10303, "verse_number": "११-२-१५", "content_sanskrit": "प्रियव्रतो नाम सुतो मनोः स्वायम्भुवस्य यः।\nतस्याग्नीध्रस्ततो नाभिर्ऋषभस्तत्सुतः स्मृतः॥ ११/२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.019.m4a", "display_order": 20}, {"id": 6000303020, "chapter_id": 10303, "verse_number": "११-२-१६", "content_sanskrit": "तमाहुर्वासुदेवांशं मोक्षधर्मविवक्षया।\nअवतीर्णं, सुतशतं तस्यासीद् ब्रह्मपारगम्॥ ११/२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.020.m4a", "display_order": 21}, {"id": 6000303021, "chapter_id": 10303, "verse_number": "११-२-१७", "content_sanskrit": "तेषां वै भरतः श्रेष्ठो नारायणपरायणः।\nविख्यातं वर्षमेतद् यन्नाम्ना भारतमद्भुतम्॥ ११/२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.021.m4a", "display_order": 22}, {"id": 6000303022, "chapter_id": 10303, "verse_number": "११-२-१८", "content_sanskrit": "स भुक्तभोगां त्यक्त्वेमां निर्गतस्तपसा हरिम्।\nउपासीनस्तत्पदवीं लेभे वै जन्मभिस्‍त्रिभिः॥ ११/२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.022.m4a", "display_order": 23}, {"id": 6000303023, "chapter_id": 10303, "verse_number": "११-२-१९", "content_sanskrit": "तेषां नव नवद्वीपपतयोऽस्य समन्ततः।\nकर्मतन्त्रप्रणेतार एकाशीतिर्द्विजातयः॥ ११/२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.023.m4a", "display_order": 24}, {"id": 6000303024, "chapter_id": 10303, "verse_number": "११-२-२०", "content_sanskrit": "नवाभवन् महाभागा मुनयो ह्यूर्ध्वमन्थिनः।\nश्रमणा वातरशना आत्मविद्याविशारदाः॥ ११/२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.024.m4a", "display_order": 25}, {"id": 6000303025, "chapter_id": 10303, "verse_number": "११-२-२१", "content_sanskrit": "कविर्हरिरन्तरिक्षः प्रबुद्धः पिप्पलायनः।\nआविर्होत्रोऽथ द्रुमिलश्चमसः करभाजनः॥ ११/२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.025.m4a", "display_order": 26}, {"id": 6000303026, "chapter_id": 10303, "verse_number": "११-२-२२", "content_sanskrit": "त एते भगवद्रूपं विश्वं सदसदात्मकम्।\nआत्मनो व्यतिरेकेण पश्यन्तो व्यचरन् महीम्॥ ११/२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.026.m4a", "display_order": 27}, {"id": 6000303027, "chapter_id": 10303, "verse_number": "११-२-२३", "content_sanskrit": "अव्याहतेष्टगतयः सुरसिद्धसाध्यगन्धर्वयक्षनरकिन्नरनागलोकान्।\nमुक्ताश्चरन्ति मुनिचारणभूतनाथविद्याधरद्विजगवां भुवनानि कामम्॥ ११/२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.027.m4a", "display_order": 28}, {"id": 6000303028, "chapter_id": 10303, "verse_number": "११-२-२४", "content_sanskrit": "त एकदा निमेः सत्रमुपजग्मुर्यदृच्छया।\nवितायमानमृषिभिराञ्जनाभा महात्मनः॥ ११/२/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.028.m4a", "display_order": 29}, {"id": 6000303029, "chapter_id": 10303, "verse_number": "११-२-२५", "content_sanskrit": "तान् दृष्ट्वा सूर्यसङ्काशान् महाभागवतान् नृप।\nयजमानोऽग्नयो विप्राः सर्व एवोपतस्थिरे॥ ११/२/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.029.m4a", "display_order": 30}, {"id": 6000303030, "chapter_id": 10303, "verse_number": "११-२-२६", "content_sanskrit": "विदेहस्तानभिप्रेत्य नारायणपरायणान्।\nप्रीतः सम्पूजयाञ्चक्र आसनस्थान् यथार्हतः॥ ११/२/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.030.m4a", "display_order": 31}, {"id": 6000303031, "chapter_id": 10303, "verse_number": "११-२-२७", "content_sanskrit": "तान् रोचमानान् स्वरुचा ब्रह्मपुत्रोपमान् नव।\nपप्रच्छ परमप्रीतः प्रश्रयावनतो नृपः॥ ११/२/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.031.m4a", "display_order": 32}, {"id": 6000303032, "chapter_id": 10303, "verse_number": null, "content_sanskrit": "विदेह उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.032.m4a", "display_order": 33}, {"id": 6000303033, "chapter_id": 10303, "verse_number": "११-२-२८", "content_sanskrit": "मन्ये भगवतः साक्षात् पार्षदान् वो मधुद्विषः।\nविष्णोर्भूतानि लोकानां पावनाय चरन्ति हि॥ ११/२/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.033.m4a", "display_order": 34}, {"id": 6000303034, "chapter_id": 10303, "verse_number": "११-२-२९", "content_sanskrit": "दुर्लभो मानुषो देहो देहिनां क्षणभङ्गुरः।\nतत्रापि दुर्लभं मन्ये वैकुण्ठप्रियदर्शनम्॥ ११/२/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.034.m4a", "display_order": 35}, {"id": 6000303035, "chapter_id": 10303, "verse_number": "११-२-३०", "content_sanskrit": "अत आत्यन्तिकं क्षेमं पृच्छामो भवतोऽनघाः।\nसंसारेऽस्मिन् क्षणार्धोऽपि सत्सङ्गः शेवधिर्नृणाम्॥ ११/२/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.035.m4a", "display_order": 36}, {"id": 6000303036, "chapter_id": 10303, "verse_number": "११-२-३१", "content_sanskrit": "धर्मान् भागवतान् ब्रूत यदि नः श्रुतये क्षमम्।\nयैः प्रसन्नः प्रपन्नाय दास्यत्यात्मानमप्यजः॥ ११/२/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.036.m4a", "display_order": 37}, {"id": 6000303037, "chapter_id": 10303, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.037.m4a", "display_order": 38}, {"id": 6000303038, "chapter_id": 10303, "verse_number": "११-२-३२", "content_sanskrit": "एवं ते निमिना पृष्टा वसुदेव महत्तमाः।\nप्रतिपूज्याब्रुवन् प्रीत्या ससदस्यर्त्विजं नृपम्॥ ११/२/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.038.m4a", "display_order": 39, "topics": [{"text": "जायन्तेयेषु कविहरिभ्यां निमिराजाय धर्मोपदेशः", "range": "३२–५५"}]}, {"id": 6000303039, "chapter_id": 10303, "verse_number": null, "content_sanskrit": "कविरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.039.m4a", "display_order": 40}, {"id": 6000303040, "chapter_id": 10303, "verse_number": "११-२-३३", "content_sanskrit": "मन्येऽकुतश्चिद्भयमच्युतस्य पादाम्बुजोपासनमत्र नित्यम्।\nउद्विग्नबुद्धेरसदात्मभावाद् विश्वात्मना यत्र निवर्तते भीः॥ ११/२/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.040.m4a", "display_order": 41}, {"id": 6000303041, "chapter_id": 10303, "verse_number": "११-२-३४", "content_sanskrit": "ये वै भगवता प्रोक्ता उपाया ह्यात्मलब्धये।\nअञ्जः पुंसामविदुषां विद्धि भागवतान् हि तान्॥ ११/२/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.041.m4a", "display_order": 42}, {"id": 6000303042, "chapter_id": 10303, "verse_number": "११-२-३५", "content_sanskrit": "यानास्थाय नरो राजन् न प्रमाद्येत कर्हिचित्।\nधावन्नुन्मील्य वा नेत्रे न स्खलेन्न पतेदिह॥ ११/२/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.042.m4a", "display_order": 43}, {"id": 6000303043, "chapter_id": 10303, "verse_number": "११-२-३६", "content_sanskrit": "कायेन वाचा मनसेन्द्रियैर्वा बुद्‌ध्याऽऽत्मना वाऽनुसृतः स्वभावम्।\nकरोति यद्यत् सकलं परस्मै नारायणायेति समर्पयेत् तत्॥ ११/२/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.043.m4a", "display_order": 44}, {"id": 6000303044, "chapter_id": 10303, "verse_number": "११-२-३७", "content_sanskrit": "भयं द्वितीयाभिनिवेशतः स्यादीशादपेतस्य विपर्ययोऽस्मृतिः।\nयन्माययाऽतो बुध आभजेत् तं भक्त्यैकयेशं गुरुदेवतात्मा॥ ११/२/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.044.m4a", "display_order": 45}, {"id": 6000303045, "chapter_id": 10303, "verse_number": null, "content_sanskrit": "अविद्यमानोऽप्यवभाति हि द्वयो ध्यातुर्धिया स्वप्नमनोरथो यथा।॥ ११/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.045.m4a", "display_order": 46}, {"id": 6000303046, "chapter_id": 10303, "verse_number": "११-२-३८", "content_sanskrit": "तत्कर्म सङ्कल्पविकल्पकं मनो बुधो निदध्यादभयं ततः स्यात्॥ ११/२/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.046.m4a", "display_order": 47}, {"id": 6000303047, "chapter_id": 10303, "verse_number": "११-२-३९", "content_sanskrit": "शृण्वन् सुभद्राणि रथाङ्गपाणेर्जन्मानि कर्माणि च यानि लोके।\nगीतानि नामानि तदर्थकानि गायन् विलज्जो विचरेदसङ्गः॥ ११/२/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.047.m4a", "display_order": 48}, {"id": 6000303048, "chapter_id": 10303, "verse_number": "११-२-४०", "content_sanskrit": "एवंव्रतश्च प्रियनामकीर्त्या जातानुरागो द्रुतचित्त उच्चैः।\nहसत्यथो रोदिति रौति गायत्युन्मादवन्नृत्यति लोकबाह्यः॥ ११/२/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.048.m4a", "display_order": 49}, {"id": 6000303049, "chapter_id": 10303, "verse_number": "११-२-४१", "content_sanskrit": "खं वायुमग्निं सलिलं महीं च ज्योतींषि सत्त्वानि दिशो द्रुमादीन्।\nसरित्समुद्रांश्च हरेः शरीरं यत् किञ्च भूतं प्रणमेदनन्यम्॥ ११/२/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.049.m4a", "display_order": 50}, {"id": 6000303050, "chapter_id": 10303, "verse_number": "११-२-४२", "content_sanskrit": "भक्तिः परे स्वेऽनुभवो विरक्तिरन्यत्र तत्त्रिकमेककालः।\nप्रपद्यमानस्य यथाऽश्नतः स्युस्तुष्टिः पुष्टिः क्षुदपायोऽनुघासम्॥ ११/२/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.050.m4a", "display_order": 51}, {"id": 6000303051, "chapter_id": 10303, "verse_number": "११-२-४३", "content_sanskrit": "इत्यच्युताङ्घ्रिं भजतोऽनु प्रीत्या भक्तिर्विरक्तिर्भगवत्प्रबोधः।\nभवन्ति वै भागवतस्य राजन् ततः परां शान्तिमुपैति साक्षात्॥ ११/२/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.051.m4a", "display_order": 52}, {"id": 6000303052, "chapter_id": 10303, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.052.m4a", "display_order": 53}, {"id": 6000303053, "chapter_id": 10303, "verse_number": "११-२-४४", "content_sanskrit": "अथ भागवतं ब्रूत यद्धर्मो यादृशो नृणाम्।\nयथा चरति यद् ब्रूते यैर्लिङ्गैर्भगवत्प्रियः॥ ११/२/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.053.m4a", "display_order": 54}, {"id": 6000303054, "chapter_id": 10303, "verse_number": null, "content_sanskrit": "हरिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.054.m4a", "display_order": 55}, {"id": 6000303055, "chapter_id": 10303, "verse_number": "११-२-४५", "content_sanskrit": "सर्वभूतेषु यः पश्येद् भगवद्भावमात्मनः।\nभूतानि भगवत्यात्मन्नेष भागवतोत्तमः॥ ११/२/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.055.m4a", "display_order": 56}, {"id": 6000303056, "chapter_id": 10303, "verse_number": "११-२-४६", "content_sanskrit": "ईश्वरे तदधीनेषु बालिशेषु द्विषत्सु च।\nप्रेममैत्रीकृपोपेक्षा यः करोति स मध्यमः॥ ११/२/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.056.m4a", "display_order": 57}, {"id": 6000303057, "chapter_id": 10303, "verse_number": "११-२-४७", "content_sanskrit": "अर्चायामेव हरये पूजां यः श्रद्धयेहते।\nन तद्भक्तेषु चान्येषु स भक्तः प्राकृतः स्मृतः॥ ११/२/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.057.m4a", "display_order": 58}, {"id": 6000303058, "chapter_id": 10303, "verse_number": "११-२-४८", "content_sanskrit": "गृहीत्वापीन्द्रियैरर्थान् यो न द्वेष्टि न हृष्यति।\nविष्णोर्मायामिमां पश्यन् स वै भागवतोत्तमः॥ ११/२/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.058.m4a", "display_order": 59}, {"id": 6000303059, "chapter_id": 10303, "verse_number": "११-२-४९", "content_sanskrit": "देहेन्द्रियप्राणमनोधियां यो जन्माप्ययक्षुद्भयतर्षकृच्छ्रैः।\nसंसारधर्मैरविमुह्यमानः स्मृत्या हरेर्भागवतप्रधानः॥ ११/२/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.059.m4a", "display_order": 60}, {"id": 6000303060, "chapter_id": 10303, "verse_number": "११-२-५०", "content_sanskrit": "यः कामकर्मबीजानि पश्यत्येषां च सम्भवम्।\nवासुदेवैकनिलयः स वै भागवतोत्तमः॥ ११/२/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.060.m4a", "display_order": 61}, {"id": 6000303061, "chapter_id": 10303, "verse_number": "११-२-५१", "content_sanskrit": "न यस्य जन्मकर्मभ्यां न वर्णाश्रमजातिभिः।\nसञ्ज्ञितेऽस्मिन्नहम्भावो देहे वै स हरेः प्रियः॥ ११/२/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.061.m4a", "display_order": 62}, {"id": 6000303062, "chapter_id": 10303, "verse_number": "११-२-५२", "content_sanskrit": "न यस्य स्वः पर इति चित्ते स्वात्मनि वाऽभिदा।\nसर्वभूतसमः शान्तः स वै भागवतोत्तमः॥ ११/२/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.062.m4a", "display_order": 63}, {"id": 6000303063, "chapter_id": 10303, "verse_number": "११-२-५३", "content_sanskrit": "त्रिभुवनविभवहेतुभिर्विकुण्ठस्मृतिभिरजेशसुरादिभिर्विमृग्यात्।\nन चलति भगवत्पदारविन्दाल्लवनिमिषार्धमपि स्म स वैष्णवाग्र्यः॥ ११/२/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.063.m4a", "display_order": 64}, {"id": 6000303064, "chapter_id": 10303, "verse_number": "११-२-५४", "content_sanskrit": "भगवत उरुविक्रमाङ्घ्रिशाखानखमणिचन्द्रिकया निरस्ततापे।\nहृदि कथमुपसीदतां पुनः स प्रभवति चन्द्र इवोदितेऽर्कतापः॥ ११/२/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.064.m4a", "display_order": 65}, {"id": 6000303065, "chapter_id": 10303, "verse_number": "११-२-५५", "content_sanskrit": "विसृजति हृदयं न यस्य साक्षाद् हरिरवशाभिहितोऽप्यघौघनाशः।\nप्रणयरशनया धृताङ्घ्रिपद्मः स भवति भागवतप्रधान उक्तः॥ ११/२/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_002/BhP_11.002.065.m4a", "display_order": 66}, {"id": 6000303066, "chapter_id": 10303, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायाम् एकादशस्कन्धे द्वितीयाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}]