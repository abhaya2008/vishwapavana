[{"id": 7003703000, "chapter_id": 23703, "verse_number": "१-४-११-१", "content_sanskrit": "नंदिकेश्वर उवाच ।\nअथ हंसाकृतिं व्योमपदवीलंघनक्षमाम् ।\nभेजे विरंचिस्तस्याग्रं द्रक्ष्यामीति कृतोद्यमः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003703001, "chapter_id": 23703, "verse_number": "१-४-११-२", "content_sanskrit": "जग्राह विष्णुर्वाराहं विग्रहं दृढविग्रहः ।\nविश्वंभराविनिर्भेद क्रीडासुलभवैभवम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003703002, "chapter_id": 23703, "verse_number": "१-४-११-३", "content_sanskrit": "मूलं तस्य परिज्ञाय प्रत्यावर्तितुमुत्सुकः ।\nकृत्रिमस्तब्धरोमैष दंष्ट्राभ्यामभिनन्महीम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003703003, "chapter_id": 23703, "verse_number": "१-४-११-४", "content_sanskrit": "विदारयन्स पोत्रेण भूतधात्रीमवाङ्मुखः ।\nमहावराहो ददृशे तेजस्तंभं नमन्निव ।\nक्रीडाक्रोडकठोरेण कंठघोषेण पूरयन् ।\nपातालं बहुलोत्साहः प्रवेष्टुमुपचक्रमे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003703004, "chapter_id": 23703, "verse_number": "१-४-११-५", "content_sanskrit": "विवेश यत्रयत्रासौ तत्रतत्र तथास्थितम् ।\nअवैक्षिष्टानलस्तंभं तमेव कुहनाकिटिः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003703005, "chapter_id": 23703, "verse_number": "१-४-११-६", "content_sanskrit": "विदारितान्महीरंधात्प्रत्यदृश्यंत भोगिनः ।\nप्ररोहा इव शेषाद्यास्तेजःस्तंभस्य केचन ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003703006, "chapter_id": 23703, "verse_number": "१-४-११-७", "content_sanskrit": "प्रत्यदृश्यत हेमाद्रेर्मूल कन्द इव स्थितः ।\nआधारतां गतो दृष्टो ह्यच्युतेनादिकच्छपः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003703007, "chapter_id": 23703, "verse_number": "१-४-११-८", "content_sanskrit": "आराद्वसुन्धरागुल्फे धुरंधरतया स्थिताः ।\nदिक्सिंधुराश्च दृश्यंते मदमंथरबंधुराः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003703008, "chapter_id": 23703, "verse_number": "१-४-११-९", "content_sanskrit": "मधुद्विषा च स महान्मंडूकोऽपि विलोकितः ।\nअखंडमंडलं भूमेर्यस्य पृष्ठे प्रतिष्ठितम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003703009, "chapter_id": 23703, "verse_number": "१-४-११-१०", "content_sanskrit": "आधारशक्तिमपि तामभ्यपश्यदधोक्षजः ।\nयदनुग्रहतः शेषकूर्माद्या अपि धूर्वहाः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003703010, "chapter_id": 23703, "verse_number": "१-४-११-११", "content_sanskrit": "अतलं वितलं चैष सुतलं नितलं तथा ।\nतलातलं च प्रतलं महातलमिति क्रमात् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003703011, "chapter_id": 23703, "verse_number": "१-४-११-१२", "content_sanskrit": "ददर्श सप्त पातालानपि वारिजलोचनः ।\nतत्रत्यान्विविधाकारान्सर्वानपि सविस्मयः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003703012, "chapter_id": 23703, "verse_number": "१-४-११-१३", "content_sanskrit": "अत्यगाद्भोगवत्याख्यां पुरीं वैरोचनीमपि ।\nजगाहेन्यांश्च दैत्यानामावासानतिगह्वरान् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003703013, "chapter_id": 23703, "verse_number": "१-४-११-१४", "content_sanskrit": "इदं दृष्टमिदं दृष्टमित्युपारूढकौतुकः ।\nमूलं मुग्धाशयस्तस्य विचिनोति स्म माधवः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003703014, "chapter_id": 23703, "verse_number": "१-४-११-१५", "content_sanskrit": "अधस्तादपि गाढेन पयोधेस्तेन पोत्रिणा ।\nतथैव तेजःस्तंभः स निर्विकारमवैक्ष्यत ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003703015, "chapter_id": 23703, "verse_number": "१-४-११-१६", "content_sanskrit": "दलिता केवलं पृष्वी पाथोराशिर्विलोलितः ।\nनैवालोक्यत तन्मूलं कोलरूपेन विष्णुना ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003703016, "chapter_id": 23703, "verse_number": "१-४-११-१७", "content_sanskrit": "इत्थं वर्षसहस्राणि भ्रांत्या संभ्रांतमानसः ।\nनालं बभूव तन्मूलं लीलाक्रोडो विलोकितुम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003703017, "chapter_id": 23703, "verse_number": "१-४-११-१८", "content_sanskrit": "अवरुग्णखुरः क्षुण्णदंष्ट्रो विध्वस्तविग्रहः ।\nभग्नपोत्रः स भूदारो जगाहे बहलं श्रमम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003703018, "chapter_id": 23703, "verse_number": "१-४-११-१९", "content_sanskrit": "श्रांत्या निश्वसतस्तस्य तादृग्दर्पो विशृंखलः ।\nननाश तत्क्षणात्साकं तन्मूलावेक्षणेच्छया ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003703019, "chapter_id": 23703, "verse_number": "१-४-११-२०", "content_sanskrit": "अनिर्व्यूढप्रतिज्ञोऽपि प्रत्यावर्तितुमुत्सकः ।\nन चक्षमे सरोजाक्षश्चलितुं च पदात्पदम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003703020, "chapter_id": 23703, "verse_number": "१-४-११-२१", "content_sanskrit": "श्रमांधचक्षुषस्तस्य पातालांतरवर्त्तिनः ।\nतत्तेज एव पंथानं पुनरप्युदभावयत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003703021, "chapter_id": 23703, "verse_number": "१-४-११-२२", "content_sanskrit": "कथंकथंचिदुत्तीर्णो ऽप्यकूपारादपारतः ।\nस्वेदांभःसागरस्रावे मग्नोऽभूच्छद्मशूकरः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003703022, "chapter_id": 23703, "verse_number": "१-४-११-२३", "content_sanskrit": "रज्ज्वेव तेजःस्तंभस्य प्रभया सानुबद्धया ।\nलब्ध्वाचलं वनं कष्टं न्यवर्त्तिष्ट जनार्दनः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003703023, "chapter_id": 23703, "verse_number": "१-४-११-२४", "content_sanskrit": "नावैक्षि यन्मया मूलममुष्य महसां निधेः ।\nततः स्रष्ट्रापि नो दृष्टः शिरोभागः कथंचन ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003703024, "chapter_id": 23703, "verse_number": "१-४-११-२५", "content_sanskrit": "अमुष्य महसां राशेः प्रागभूद्यत्र संभवः ।\nततो निवृत्त्य यास्यामि शरणं शिवमीश्वरम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003703025, "chapter_id": 23703, "verse_number": "१-४-११-२६", "content_sanskrit": "स हि विश्वाधिको देवश्चिरं मोहांधचक्षुषा ।\nयद्विस्मृतो मया तस्माद्दुर्विपाकोऽजनीदृशः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003703026, "chapter_id": 23703, "verse_number": "१-४-११-२७", "content_sanskrit": "एवं विनिर्धार्य विमुक्तदर्पो निवृत्तवानाशु सरोरुहाक्षः ।\nतमेव देशं प्रबभूव यत्र स्तंभः स तेजोमयतां दधानः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]