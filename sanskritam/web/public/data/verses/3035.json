[{"id": 2095391, "chapter_id": 3035, "verse_number": "१३-१६५-१", "content_sanskrit": "युधिष्ठिर उवाच।\nपितामहेन कथिता दानधर्माश्रिताः कथाः।\nमया श्रुता ऋषीणां तु संनिधौ केशवस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2095392, "chapter_id": 3035, "verse_number": "१३-१६५-२", "content_sanskrit": "पुनः कौतूहलमभूत्तामेवाध्यात्मिकीं प्रति।\nकथाः कथय राजेन्द्र त्वदन्यः क उदाहरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2095393, "chapter_id": 3035, "verse_number": "१३-१६५-३", "content_sanskrit": "एष यादवदायादस्तथानुज्ञातुमर्हति।\nज्ञाते तु यस्मिञ्ज्ञातव्यं ज्ञातं भवति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2095394, "chapter_id": 3035, "verse_number": "१३-१६५-४", "content_sanskrit": "पश्चाच्छ्रोष्यामहे राज्ञां श्राव्यान्धर्मान्पितामह।\nकौतूहलमृषीणां तु च्छेतुमर्हसि साम्प्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2095395, "chapter_id": 3035, "verse_number": "१३-१६५-५x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2095396, "chapter_id": 3035, "verse_number": "१३-१६५-५", "content_sanskrit": "अत ऊर्ध्वं महाराज साङ्ख्ययोगोभयशास्त्राधि-\nगतयाथात्म्यदर्शनसम्पन्नयोराचार्ययोः संवादमनुव्याख्यास्यामः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2095397, "chapter_id": 3035, "verse_number": "१३-१६५-६", "content_sanskrit": "तद्यथा भगवन्तं सनत्कुमारमासीनमङ्गुष्ठपर्व-\nमात्रं महति विमानवरे योजनसहस्रमण्डले तरुण-\nभास्करप्रतीकाशे शयनीये महति बद्धासनमनु-\nध्यायन्तममृतमनावर्तकरममूर्तमक्षयजमथोपदि-\nष्टमुपससर्प भगवन्तमाचार्यं भगवानाचार्यो रुद्रः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2095398, "chapter_id": 3035, "verse_number": "१३-१६५-७", "content_sanskrit": "तं प्रोवाच स्वागतं महेश्वर ब्रह्मसुत एतदास-\nनमास्तां भगवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2095399, "chapter_id": 3035, "verse_number": "१३-१६५-८", "content_sanskrit": "इत्युक्ते चासीनो भगवाननन्तरूपो रुद्रस्तं\nप्रोवाच भगवानपि ध्यानमावर्तयति। इत्युक्ते चाह\nभगवान्सनत्कुमारस्तथेति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2095400, "chapter_id": 3035, "verse_number": "१३-१६५-९", "content_sanskrit": "तथेत्युक्तश्च प्रोवाच भगवाञ्शङ्करस्तदा।\nपरावरज्ञं सर्वस्य त्रैलोक्यस्य महामुनिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2095401, "chapter_id": 3035, "verse_number": "१३-१६५-१०", "content_sanskrit": "किं वा ध्यानेन द्रष्टव्यं यद्भवाननुपश्यति।\nयच्च ध्यात्वा न शोचन्ति यतयस्तत्वदर्शिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2095402, "chapter_id": 3035, "verse_number": "१३-१६५-११", "content_sanskrit": "कथय त्वमिमं देवं देहिनां यतिसत्तम।\nयच्च तत्पुरुषं शुद्धमित्युक्तं योगसाङ्ख्ययोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2095403, "chapter_id": 3035, "verse_number": "१३-१६५-१२", "content_sanskrit": "किमध्यात्माधिभूतं च तथा चाप्यधिदैवतम्।\nकालसङ्ख्या च का देव द्रष्टव्या तस्य ब्रह्मणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2095404, "chapter_id": 3035, "verse_number": "१३-१६५-१३", "content_sanskrit": "सङ्ख्या सङ्ख्यादनस्यैव या प्रोक्ता परमर्षिभिः।\nशास्त्रदृष्टेन मार्गेण यथावद्यतिसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2095405, "chapter_id": 3035, "verse_number": "१३-१६५-१४", "content_sanskrit": "यच्च तत्पुरुषं शुद्धं प्रबुद्धमजरं ध्रुवम्।\nबुध्यमानाप्रबुद्धाभ्यां विद्यावेद्यं तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2095406, "chapter_id": 3035, "verse_number": "१३-१६५-१५", "content_sanskrit": "विमोक्षं त्रिविधं चैव ब्रूहि मोक्षविदांवर।\nपरिसाङ्ख्यं च साङ्ख्यानां ध्यानं योगेषु चार्थवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2095407, "chapter_id": 3035, "verse_number": "१३-१६५-१६", "content_sanskrit": "एकत्वदर्शनं चैव तथा नानात्वदर्शनम्।\nअरिष्टानि च तत्वेन तथैवोत्क्रमणानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2095408, "chapter_id": 3035, "verse_number": "१३-१६५-१७", "content_sanskrit": "दैवतानि च सर्वाणि निखिलेनानुपूर्वशः।\nयान्याश्रितानि देहेषु देहिनां यतिसत्तम।\nसर्वमेतद्यथातत्वमाख्याहि मुनिसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2095409, "chapter_id": 3035, "verse_number": "१३-१६५-१८", "content_sanskrit": "श्रेष्ठो भवान्हि सर्वेषां ब्रह्मज्ञानामनिन्दितः।\nचतुर्थस्त्वं त्रयाणां तु ये गताःइ परमां गतिम्।\nज्ञानेन च प्राकृतेन निर्मुक्तो मृत्युबन्धनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2095410, "chapter_id": 3035, "verse_number": "१३-१६५-१९", "content_sanskrit": "वयं तु वैकृतं मार्गमाश्रिता वै क्षरं सदा।\nपरमुत्सृज्य पन्थानममृताक्षरमेव तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2095411, "chapter_id": 3035, "verse_number": "१३-१६५-२०", "content_sanskrit": "न्यूने पथि निमग्नास्तु ऐश्वर्येऽष्टगुणे तथा।\nमहिमानं प्रगृह्येमं विचरामो यथासुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2095412, "chapter_id": 3035, "verse_number": "१३-१६५-२१", "content_sanskrit": "न चैतत्सुखमत्यन्तं न्यूनमेतदनन्तरम्।\nमूर्तिमत्परमेतत्स्यादिदमेवं सुसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2095413, "chapter_id": 3035, "verse_number": "१३-१६५-२२", "content_sanskrit": "पुनः पुनश्च पतनं मूर्तिमत्युपदिश्यते।\nन पुनर्मृत्युमित्यन्यं निर्मुक्तानां तु मूर्तितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2095414, "chapter_id": 3035, "verse_number": "१३-१६५-२३", "content_sanskrit": "मृत्युदोषास्त्वनन्ता वै उत्पद्यन्ते कृतात्मनाम्।\nमर्त्येषु नाकपृष्ठेषु निरयेषु महामुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2095415, "chapter_id": 3035, "verse_number": "१३-१६५-२४", "content_sanskrit": "तत्र मञ्जन्ति पुरुषाः सुखदुःखेन वेष्टिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2095416, "chapter_id": 3035, "verse_number": "१३-१६५-२५", "content_sanskrit": "सुखदुःखव्यपेतं च यदाहुरमृतं पदम्।\nतदहं श्रोतुमिच्छामि यथावच्छ्रुतिदर्शनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2095417, "chapter_id": 3035, "verse_number": "१३-१६५-२६x", "content_sanskrit": "सनत्कुमार उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2095418, "chapter_id": 3035, "verse_number": "१३-१६५-२६", "content_sanskrit": "यदुक्तं भवता वाक्यं तत्वसंज्ञेति देहिनाम्।\nचतुर्विंशतिमेवात्र केचिदाहुर्मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2095419, "chapter_id": 3035, "verse_number": "१३-१६५-२७", "content_sanskrit": "केचिदाहुस्त्रयोविंशं यथाश्रुतिनिदर्शनात्।\nवयं तु पञ्चविंशं वै तदधिष्ठानसंज्ञितम्।\nतत्वं समधिमन्यामः सर्वतन्त्रप्रलापनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2095420, "chapter_id": 3035, "verse_number": "१३-१६५-२८", "content_sanskrit": "अव्ययश्चैव वै व्यक्तावुभावपि पिनाकधृक्।\nसह चैव विना चैव तावन्योन्यं प्रतिष्ठितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2095421, "chapter_id": 3035, "verse_number": "१३-१६५-२९", "content_sanskrit": "हिरण्मयीं प्रविश्यैष मूर्तिं मूर्तिमतांवर।\nचकार पुरुषस्तात विकारपुरुषावुभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2095422, "chapter_id": 3035, "verse_number": "१३-१६५-३०", "content_sanskrit": "अव्यक्तादेक एवैष महानात्मा प्रसूयते।\nअहङ्कारेण लोकांश्च व्याप्य चाहंकृतेन वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2095423, "chapter_id": 3035, "verse_number": "१३-१६५-३१", "content_sanskrit": "पिना सर्वं तदव्यक्तादभफिमन्यस्व शूलधृक्।\nभूतसर्गमहङ्कारात्तृतीयं विद्धि वै क्रमात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2095424, "chapter_id": 3035, "verse_number": "१३-१६५-३२", "content_sanskrit": "अहङ्काराच्च भूतेषु चतुर्थं विद्दि वैकृतम्।\nअहङ्काराच्च जातानि युगपद्विबुधेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2095425, "chapter_id": 3035, "verse_number": "१३-१६५-३३", "content_sanskrit": "सविशेषाणि भूतानि पञ्च प्राहुर्मनीषिणः।\nचतुर्विंशात्तु वै प्रोक्तात्पञ्चविंशोऽधितिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2095426, "chapter_id": 3035, "verse_number": "१३-१६५-३४", "content_sanskrit": "एते सर्गा मया प्रोक्ताश्चत्वारः प्राकृतास्त्विह।\nअहङ्काराच्च जातानि युगपद्विबुधेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2095427, "chapter_id": 3035, "verse_number": "१३-१६५-३५", "content_sanskrit": "अङ्काराच्च भूतेषु विविधार्थं व्यजायत।\nइन्द्रियैर्युगपत्सर्वैः सो नित्यश्च समीक्षते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2095428, "chapter_id": 3035, "verse_number": "१३-१६५-३६", "content_sanskrit": "मरुत्त्वं सत्वसर्गश्च तुष्टिः सिद्धिस्तथैव च।\nवैकृतानि प्रवक्ष्यामि शृणु तानि महामते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2095429, "chapter_id": 3035, "verse_number": "१३-१६५-३७", "content_sanskrit": "एषा तत्वचतुर्विंशन्मया शास्त्रानुमानतः।\nवर्णिता तव देवेश पञ्चविंशत्समन्विता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2095430, "chapter_id": 3035, "verse_number": "१३-१६५-३८", "content_sanskrit": "पञ्चमोऽनुग्रहश्चैव नवैते प्राकृतैः सह।\nऐन्द्रेप्यहमधोप्यन्यन्ममात्मनि च भास्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2095431, "chapter_id": 3035, "verse_number": "१३-१६५-३९", "content_sanskrit": "यच्च देहमयं किञ्चित्त्रिषु लोकेषु विद्यते।\nसर्वत्रैवाभिमन्तव्यं त्वया त्रिपुरसूदन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2095432, "chapter_id": 3035, "verse_number": "१३-१६५-४०", "content_sanskrit": "अन्यथा येऽनुपश्यन्ति ते न पश्यन्ति ब्रह्मज।\nएतदव्यक्तविषयं पञ्चविंशसमन्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2095433, "chapter_id": 3035, "verse_number": "१३-१६५-४१", "content_sanskrit": "अनेन कारणेनैव तत्वमाहुर्मनीषिणः।\nविकारमात्रमेतं तु तत्वमाचक्षते परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2095434, "chapter_id": 3035, "verse_number": "१३-१६५-४२", "content_sanskrit": "निस्तत्वश्चैष देवेश बोद्धव्यं तु न बुद्ध्यते।\nयदि बुद्ध्येत्परं बुद्धं बुद्ध्यमानः सुरर्षभः।\nप्रबुद्धो ह्यभिमन्येत योयं नाहमिति प्रभो॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2095435, "chapter_id": 3035, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि पञ्चषष्ट्यधिकशततमोऽध्यायः॥ १६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]