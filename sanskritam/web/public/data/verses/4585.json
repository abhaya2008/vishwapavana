[{"id": 2166859, "chapter_id": 4585, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2166860, "chapter_id": 4585, "verse_number": "१", "content_sanskrit": "एतच्छ्रुत्वा महाराज धृतराष्ट्रोऽम्बिकासुतः ।\nअब्रवीत् सञ्जयं सूतं शोकेनाकुलचेतनः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2166861, "chapter_id": 4585, "verse_number": "२", "content_sanskrit": "दुष्प्रणीतेन मे तात सुतस्यादीर्घदर्शिनः ।\nहतं वैकर्तनं श्रुत्वा शोको मर्माणि कृन्तति\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2166862, "chapter_id": 4585, "verse_number": "३", "content_sanskrit": "तस्य मे संशयं छिन्धि शोकपारं तितीर्षतः ।\nकुरूणां सृञ्जयानां च के नु जीवन्ति के हताः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2166863, "chapter_id": 4585, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2166864, "chapter_id": 4585, "verse_number": "४", "content_sanskrit": "हतः शान्तनवो राजन् दुराधर्षः प्रतापवान् ।\nहत्वा पाण्डवयोधानामर्बुदं दशभिर्दिनैः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2166865, "chapter_id": 4585, "verse_number": "५", "content_sanskrit": "तथा द्रोणो महेष्वासः पाञ्चालानां महारथान् ।\nनिहत्य युधि दुर्धर्षः पश्चाद् रुग्मरथो हतः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2166866, "chapter_id": 4585, "verse_number": "६", "content_sanskrit": "हतशिष्टस्य भीष्मेण द्रोणेन च महात्मना ।\nअर्धं निहत्य सैन्यस्य कर्णो वैकर्तनो हतः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2166867, "chapter_id": 4585, "verse_number": "७", "content_sanskrit": "विविंशतिर्महाराज राजपुत्रो महारथः ।\nआनर्तयोधान् शतशो निहत्य निहतो युधि\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2166868, "chapter_id": 4585, "verse_number": "८", "content_sanskrit": "तथा पुत्रो विकर्णस्ते क्षत्रधर्ममनुस्मरन् ।\nक्षीणबाणो हतः शूरः स्थितो ह्यभिमुखः परैः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2166869, "chapter_id": 4585, "verse_number": "९", "content_sanskrit": "घोररूपानतिक्लेशान् दुर्योधनकृतान् बहून् ।\nप्रतिज्ञां स्मरता तेन भीमसेनेन पातितः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2166870, "chapter_id": 4585, "verse_number": "१०", "content_sanskrit": "विन्दानुविन्दावावन्त्यौ राजपुत्रौ महाबलौ ।\nकृत्वा सुदुष्करं कर्म गतौ वैवस्वतक्षयम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2166871, "chapter_id": 4585, "verse_number": "११", "content_sanskrit": "सिन्धुराष्ट्रमुखानीह दश राष्ट्राणि यस्य वै ।\nवशे तिष्ठन्ति वीरस्य स्थितस्य तव शासने\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2166872, "chapter_id": 4585, "verse_number": "१२", "content_sanskrit": "अक्षोहिणीर्दशैकां च विनिर्जित्य शितैः शरैः ।\nसोऽर्जुनेन हतो राजन् महावीर्यो जयद्रथः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2166873, "chapter_id": 4585, "verse_number": "१३", "content_sanskrit": "तथा दुर्योधनसुतः तरस्वी युद्धदुर्मदः ।\nवर्तमानः पितुः शास्त्रे सौभद्रेण निपातितः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2166874, "chapter_id": 4585, "verse_number": "१४", "content_sanskrit": "तथा दौःशासनिर्वीरो बाहुशाली रणोत्कटः ।\nद्रौपदेयेन विक्रम्य गमितो यमसादनम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2166875, "chapter_id": 4585, "verse_number": "१५", "content_sanskrit": "किरातानामधिपतिः सागरानूपवासिनाम् ।\nदेवराजस्य धर्मात्मा प्रियो बहुमतः सखा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2166876, "chapter_id": 4585, "verse_number": "१६", "content_sanskrit": "भगदत्तो महीपालः क्षात्रधर्मरतः सदा ।\nधनञ्जयेन विक्रम्य गमितो यमसादनम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2166877, "chapter_id": 4585, "verse_number": "१७", "content_sanskrit": "तथा कौरवदायादः सौमदत्तिर्महायशाः ।\nहतो भूरिश्रवा राजन् शूरः सात्यकिना युधि\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2166878, "chapter_id": 4585, "verse_number": "१८", "content_sanskrit": "श्रुतायुरपि चाम्बष्ठः क्षत्रियाणां धुरन्धरः ।\nचरन्नभीतवत् सङ्खे निहतः सव्यसाचिना\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2166879, "chapter_id": 4585, "verse_number": "१९", "content_sanskrit": "तव पुत्रः सदाऽमर्षी कृतास्त्रो युद्धदुर्मदः ।\nदुःशासनो महाराज भीमसेनेन पातितः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2166880, "chapter_id": 4585, "verse_number": "२०", "content_sanskrit": "यस्य राजन् गजानीकं बहुसाहस्रमुत्तमम् ।\nसुदक्षिणः स सङ्ग्रामे निहतः सव्यसाचिना\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2166881, "chapter_id": 4585, "verse_number": "२१", "content_sanskrit": "कोसलानामधिपतिर्हत्वा बहुशतान् परान् ।\nसौभद्रेणेह विक्रम्य गमितो यमसादनम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2166882, "chapter_id": 4585, "verse_number": "२२", "content_sanskrit": "बहुशो योधयित्वा तु भीमसेनं महारथः ।\nचित्रसेनस्तव सुतो भीमसेनेन पातितः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2166883, "chapter_id": 4585, "verse_number": "२३", "content_sanskrit": "मद्रराजात्मजः शूरः परेषां भयवर्धनः ।\nअसिचर्मधरः श्रीमान् सौभद्रेण निपातितः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2166884, "chapter_id": 4585, "verse_number": "२४", "content_sanskrit": "समः कर्णेन समरे स कर्णस्यैव पश्यतः ।\nवृषसेनो महातेजाः शीघ्रास्त्रो दृढविक्रमः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2166885, "chapter_id": 4585, "verse_number": "२५", "content_sanskrit": "अभिमन्योर्वधं स्मृत्वा प्रतिज्ञामपि चात्मनः ।\nधनञ्जयेन विक्रम्य गमितो यमसादनम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2166886, "chapter_id": 4585, "verse_number": "२६", "content_sanskrit": "नित्यप्रयुक्तवैरो यः पाण्डवैः पृथिवीपतिः ।\nविश्राव्य वैरं पार्थेन श्रुतायुः स निपातितः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2166887, "chapter_id": 4585, "verse_number": "२७", "content_sanskrit": "शल्यपुत्रस्तु विक्रान्तः सहदेवेन मारिष ।\nहतो रुग्मरथो राजन् स्यालो मातुलजो युधि\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2166888, "chapter_id": 4585, "verse_number": "२८", "content_sanskrit": "राजा भागीरथो वृद्धो बृहत्क्षत्रश्च केकयः ।\nपराक्रान्तौ सुविक्रान्तौ निहतौ वीर्यवत्तरौ\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2166889, "chapter_id": 4585, "verse_number": "२९", "content_sanskrit": "भगदत्तसुतो राजन् कृतप्रज्ञो महाबलः ।\nश्येनवच्चरता सङ्खे नकुलेन निपातितः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2166890, "chapter_id": 4585, "verse_number": "३०", "content_sanskrit": "पितामहस्तव तथा बाह्लीकः सह बाह्लिकैः ।\nनिहतो भीमसेनेन महाबलपराक्रमः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2166891, "chapter_id": 4585, "verse_number": "३१", "content_sanskrit": "जयत्सेनस्तथा राजन् जारासन्धिर्महाबलः ।\nमागधो निहतः सङ्खे सौभद्रेण महात्मना\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2166892, "chapter_id": 4585, "verse_number": "३२", "content_sanskrit": "असिचर्मधरः शूरः परेषां भयवर्धनः ।\nअग्निचक्रवदाघूर्णन् सौमदत्तिर्निपातितः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2166893, "chapter_id": 4585, "verse_number": "३३", "content_sanskrit": "पुत्रस्ते दुर्मुखो राजन् दुष्षहश्च महारथः ।\nगदया भीमसेनेन निहतौ शूरमानिनौ\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2166894, "chapter_id": 4585, "verse_number": "३४", "content_sanskrit": "दुर्मर्षणो दुर्विषहो दुर्जयश्च महारथः ।\nकृत्वा सुदुष्करं कर्म गता वैवस्वतक्षयम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2166895, "chapter_id": 4585, "verse_number": "", "content_sanskrit": "(उभौ कलिङ्गवृषभौ भ्रातरौ युद्धदुर्मदौ ।\nकृत्वा सुदुष्करं कर्म गतौ वैवस्वतक्षयम्\t॥३५॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2166896, "chapter_id": 4585, "verse_number": "३६", "content_sanskrit": "सचिवो वृषपर्वा ते तथा परमवीर्यवान् ।\nभीमसेनेन विक्रम्य गमितो यमसादनम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2166897, "chapter_id": 4585, "verse_number": "३७", "content_sanskrit": "तथैव पौरवो राजा नागायुतबलो महान् ।\nसगणः पाण्डुपुत्रेण निहतः सव्यसाचिना\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2166898, "chapter_id": 4585, "verse_number": "३८", "content_sanskrit": "वसातयो महाराज द्विसाहस्राः प्रहारिणः ।\nशूरसेनाश्च विक्रान्ताः सर्वे युधि निपातिताः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2166899, "chapter_id": 4585, "verse_number": "३९", "content_sanskrit": "आभीरकाः कवचिनः प्रहरन्तो रणोत्कटाः ।\nशिबयश्च रथोदाराः कलिङ्गसहिता हताः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2166900, "chapter_id": 4585, "verse_number": "४०", "content_sanskrit": "गोकुले नित्यसंवृद्धा युद्धे परमकोविदाः ।\nगोपालाः कृतवीर्याश्च निहताः सव्यसाचिना\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2166901, "chapter_id": 4585, "verse_number": "४१", "content_sanskrit": "श्रेणयो बहुसाहस्राः संशप्तकगणाश्च ये ।\nते सर्वे पार्थमासाद्य गता वैवस्वतक्षयम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2166902, "chapter_id": 4585, "verse_number": "४२", "content_sanskrit": "श्यालौ तव महाराज राजानौ वृषकाचलौ ।\nत्वदर्थं तौ पराक्रान्तौ निहतौ सव्यसाचिना\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2166903, "chapter_id": 4585, "verse_number": "४३", "content_sanskrit": "उग्रकर्मा महेष्वासो नामतः कर्मतस्तथा ।\nसाल्वराजो महाराज भीमसेनेन पातितः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2166904, "chapter_id": 4585, "verse_number": "४४", "content_sanskrit": "ओधवांश्च महाराज बृहन्तसहितो रणे ।\nपराक्रमी च मित्रार्थे गतो वैवस्वतक्षयम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2166905, "chapter_id": 4585, "verse_number": "४५", "content_sanskrit": "तथैव रथिनां श्रेष्ठः क्षेमधूर्तिर्विशाम्पते ।\nनिहतो गदया राजन् भीमसेनेन संयुगे\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2166906, "chapter_id": 4585, "verse_number": "४६", "content_sanskrit": "तथा राजन् महेष्वासो जलसन्धो महाबलः ।\nसुमहत् कदनं कृत्वा हतः सात्यकिना युधि\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2166907, "chapter_id": 4585, "verse_number": "४७", "content_sanskrit": "अलायुधो राक्षसेन्द्रो बकबन्धुश्च यानवान् ।\nघटोत्कचेन विक्रम्य गमितो यमसादनम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2166908, "chapter_id": 4585, "verse_number": "", "content_sanskrit": "(विक्रान्ता बलवन्तश्च भ्रातरः सह भारत ।\nकेकयाः सर्वतश्चापि निहताः सव्यसाचिना\t॥४८॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2166909, "chapter_id": 4585, "verse_number": "४९", "content_sanskrit": "राधेयाः सूतपुत्राश्च कर्णस्य भ्रातरस्तथा ।\nरिपूणां कदनं कृत्वा गता वैवस्वतक्षयम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2166910, "chapter_id": 4585, "verse_number": "५०", "content_sanskrit": "मद्रका मालवाश्चैव द्रविडाश्चोग्रविक्रमाः ।\nयौधेयाश्च लिलिन्ध्राश्च क्षुद्रकाश्चाप्युशीनराः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2166911, "chapter_id": 4585, "verse_number": "५१", "content_sanskrit": "मच्चिल्लकास्तुण्डिकेराः सावित्रीपुत्रकास्तथा ।\nप्रागुदीच्याः प्रतीच्याश्च दाक्षिणात्याश्च भारत\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2166912, "chapter_id": 4585, "verse_number": "५२", "content_sanskrit": "पत्तीनां निहताः सङ्घा हयानामर्बुदानि च ।\nरथव्राताश्च निहताः हताश्च वरवारणाः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2166913, "chapter_id": 4585, "verse_number": "५३", "content_sanskrit": "सध्वजाः सायुधाः शूराः सवर्माम्बरभूषणाः ।\nकालेन महता यत्ताः कुशलैर्येऽभिवर्धिताः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2166914, "chapter_id": 4585, "verse_number": "५४", "content_sanskrit": "ते हताः समरे राजन् पार्थेनाक्लिष्टकर्मणा\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2166915, "chapter_id": 4585, "verse_number": "५५", "content_sanskrit": "अन्ये तथाऽमितबलाः परस्परवधैषिणः ।\nनिहताः समरे शूराः परस्परसमागमे\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2166916, "chapter_id": 4585, "verse_number": "५६", "content_sanskrit": "एते चान्ये च बहवो राजानः सगणा रणे ।\nहताः सहस्रशो राजन् यन्मां त्वं परिपृच्छसि\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2166917, "chapter_id": 4585, "verse_number": "५७", "content_sanskrit": "एवमेष क्षयो वृत्तः कर्णार्जुनसमागमे ।\nमहेन्द्रेण यथा वृत्रो यथा रामेण रावणः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2166918, "chapter_id": 4585, "verse_number": "५८", "content_sanskrit": "यथा कृष्णेन नरको मुरश्च निहतो रणे ।\nकार्तवीर्यश्च रामेण भार्गवेण यथा हतः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2166919, "chapter_id": 4585, "verse_number": "५९", "content_sanskrit": "सज्ञातिबान्धवः शूरः समरे युद्धदुर्मदः ।\nरणे कृत्वा महद् युद्धं घोरं त्रैलोक्यमोहनम्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2166920, "chapter_id": 4585, "verse_number": "६०", "content_sanskrit": "यथा स्कन्देन महिषो यथा रुद्रेण चान्धकः ।\nतथाऽर्जुनेन निहतो द्वैरथे युद्धदुर्मदः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2166921, "chapter_id": 4585, "verse_number": "६१", "content_sanskrit": "सामात्यबान्धवः शूरः कर्णः प्रहरतां वरः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2166922, "chapter_id": 4585, "verse_number": "६२", "content_sanskrit": "जयाशा धार्तराष्ट्राणां वैरस्य च मुखं नृप\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2166923, "chapter_id": 4585, "verse_number": "६३", "content_sanskrit": "तीर्णं तत् पाण्डवै राजन् यत्पुरा नावबुध्यसे ।\nप्रोच्यमानं महाराज बन्धुभिर्हितकाङ्क्षिभिः\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2166924, "chapter_id": 4585, "verse_number": "६४", "content_sanskrit": "(न कृतं च त्वया पूर्वं दैवेन विधिना बलात् ।)\nतदिदं समनुप्राप्तं व्यसनं त्वां महात्ययम्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2166925, "chapter_id": 4585, "verse_number": "६५", "content_sanskrit": "पुत्राणां राज्यकामानां त्वया राजन् हितैषिणा ।\nअहितान्येव चीर्णानि तेषां ते फलमागतम्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2166926, "chapter_id": 4585, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nपञ्चमोऽध्यायः ॥५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]