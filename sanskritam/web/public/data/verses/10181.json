[{"id": 6000181000, "chapter_id": 10181, "verse_number": null, "content_sanskrit": "अथ षष्ठाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000181001, "chapter_id": 10181, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.001.m4a", "display_order": 2}, {"id": 6000181002, "chapter_id": 10181, "verse_number": "९-६-१", "content_sanskrit": "नाभागादम्बरीषोऽभून्महाभागवतः कृती।\nनास्पृशद् ब्रह्मशापोऽपि चक्रप्रतिहतःक्‍वचित्॥ ९/६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.002.m4a", "display_order": 3, "topics": [{"text": "नाभागपुत्रस्याम्बरीषस्य कथा", "range": "१–२२"}]}, {"id": 6000181003, "chapter_id": 10181, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.003.m4a", "display_order": 4}, {"id": 6000181004, "chapter_id": 10181, "verse_number": "९-६-२", "content_sanskrit": "भगवन् श्रोतुमिच्छामि राजर्षेस्तस्य धीमतः।\nन प्राभूद् यत्र निर्मुक्तो ब्रह्मदण्डो दुरत्ययः॥ ९/६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.004.m4a", "display_order": 5}, {"id": 6000181005, "chapter_id": 10181, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.005.m4a", "display_order": 6}, {"id": 6000181006, "chapter_id": 10181, "verse_number": "९-६-३", "content_sanskrit": "अम्बरीषो महाभागः सप्तद्वीपवतीं महीम्।\nअव्ययां च श्रियं लब्ध्वा विभवं चातुलं भुवि॥ ९/६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.006.m4a", "display_order": 7}, {"id": 6000181007, "chapter_id": 10181, "verse_number": "९-६-४", "content_sanskrit": "मेनेऽतिदुर्लभं पुंसां सर्वं तत् स्वप्नसम्मितम्।\nविद्वान् विभवनिर्वाणं तमो विशति यत् पुमान्॥ ९/६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.007.m4a", "display_order": 8}, {"id": 6000181008, "chapter_id": 10181, "verse_number": "९-६-५", "content_sanskrit": "वासुदेवे भगवति तद्भक्तेषु च साधुषु।\nप्राप्तो भावं परं विश्वं येनेदं लोष्ठवत् स्मृतम्॥ ९/६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.008.m4a", "display_order": 9}, {"id": 6000181009, "chapter_id": 10181, "verse_number": "९-६-६", "content_sanskrit": "स वै मनः कृष्णपदारविन्दयोर्वचांसि वैकुण्ठगुणानुवर्णने।\nकरो हरेर्मन्दिरमार्जनादिषु श्रुतिं चकाराच्युतसत्कथोदये॥ ९/६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.009.m4a", "display_order": 10}, {"id": 6000181010, "chapter_id": 10181, "verse_number": "९-६-७", "content_sanskrit": "मुकुन्दलिङ्गालयदर्शने दृशौ तद्भृत्यगात्रस्पर्शेऽङ्गसङ्गम्।\nघ्राणं च तत्पादसरोजसौरभश्रीमत्तुलस्यां रसनां तदर्पिते॥ ९/६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.010.m4a", "display_order": 11}, {"id": 6000181011, "chapter_id": 10181, "verse_number": "९-६-८", "content_sanskrit": "पादौ हरेः क्षेत्रपदानुसर्पणे शिरो हृषीकेशपदाभिवन्दने।\nकामं तु दास्ये न तु कामकाम्यया तथोत्तमश्लोकजनाश्रयां रतिम्॥ ९/६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.011.m4a", "display_order": 12}, {"id": 6000181012, "chapter_id": 10181, "verse_number": "९-६-९", "content_sanskrit": "एवं सदा कर्मकलापमात्मनः परेऽधियज्ञे भगवत्यधोक्षजे।\nसर्वात्मभावं विदधन्महीमिमां तन्निष्ठविप्राभिहितः शशास ह॥ ९/६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.012.m4a", "display_order": 13}, {"id": 6000181013, "chapter_id": 10181, "verse_number": "९-६-१०", "content_sanskrit": "ईजेऽश्वमेधैरधियज्ञमीश्वरं महाविभूत्योपचिताङ्गदक्षिणैः।\nततैर्वसिष्ठासितगौतमादिभिर्विद्वानभिस्रोतमसौ सरस्वतीम्॥ ९/६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.013.m4a", "display_order": 14}, {"id": 6000181014, "chapter_id": 10181, "verse_number": "९-६-११", "content_sanskrit": "यस्य क्रतुषु गीर्वाणैः सदस्या ऋत्विजो जनाः।\nतुल्यरूपाश्चानिमिषा व्यदृश्यन्त सुवाससः॥ ९/६/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.014.m4a", "display_order": 15}, {"id": 6000181015, "chapter_id": 10181, "verse_number": "९-६-१२", "content_sanskrit": "स्वर्गो न प्रार्थितो यस्य मनुजैरमरप्रियः।\nशृण्वद्भिरुपगायद्भिरुत्तमश्लोकचेष्टितम्॥ ९/६/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.015.m4a", "display_order": 16}, {"id": 6000181016, "chapter_id": 10181, "verse_number": "९-६-१३", "content_sanskrit": "समृद्धा यस्य नो कामाः स्वाराज्यपरिभाविताः।\nदुर्लभा अपि सिद्धानां मुकुन्दं हृदि पश्यतः॥ ९/६/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.016.m4a", "display_order": 17}, {"id": 6000181017, "chapter_id": 10181, "verse_number": "९-६-१४", "content_sanskrit": "स इत्थं भक्तियोगेन तपोयुक्तेन पार्थिव।\nस्वधर्मेण हरिं प्रीणन् सङ्गान् सर्वाञ्छनैर्जहौ॥ ९/६/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.017.m4a", "display_order": 18}, {"id": 6000181018, "chapter_id": 10181, "verse_number": "९-६-१५", "content_sanskrit": "गृहेषु दारेषु सुतेषु बन्धुषु द्विपोत्तमस्यन्दनवाजिपत्तिषु।\nअक्षय्यरत्नाभरणायुधादिष्वनन्तकोशेष्वकरोदसन्मतिम्॥ ९/६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.018.m4a", "display_order": 19}, {"id": 6000181019, "chapter_id": 10181, "verse_number": "९-६-१६", "content_sanskrit": "तस्मा अदाद्धरिश्चक्रं प्रत्यनीकभयावहम्।\nएकान्तभक्तियोगेन प्रीतो भूत्वाऽभिरक्षणम्॥ ९/६/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.019.m4a", "display_order": 20}, {"id": 6000181020, "chapter_id": 10181, "verse_number": "९-६-१७", "content_sanskrit": "आरिराधयिषुः कृष्णं महिष्या तुल्यशीलया।\nयुक्तः सांवत्सरं वीरो दधार द्वादशीव्रतम्॥ ९/६/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.020.m4a", "display_order": 21}, {"id": 6000181021, "chapter_id": 10181, "verse_number": "९-६-१८", "content_sanskrit": "व्रतान्ते कार्तिके मासि त्रिरात्रं समुपोषितः।\nस्नातः कदाचित् कालिन्द्यां हरिं मधुवनेऽर्चयत्॥ ९/६/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.021.m4a", "display_order": 22}, {"id": 6000181022, "chapter_id": 10181, "verse_number": "९-६-१९", "content_sanskrit": "महाभिषेकविधिना सर्वोपस्करसम्पदा।\nअभिषिच्य वराकल्पैर्गन्धमाल्यार्हणादिभिः॥ ९/६/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.022.m4a", "display_order": 23}, {"id": 6000181023, "chapter_id": 10181, "verse_number": "९-६-२०", "content_sanskrit": "तद्गतान्तरभावेन पूजयामास केशवम्।\nब्राह्मणांश्च महाभागान् सिद्धार्थानपि भक्तितः॥ ९/६/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.023.m4a", "display_order": 24}, {"id": 6000181024, "chapter_id": 10181, "verse_number": "९-६-२१", "content_sanskrit": "गवां रुक्मविषाणीनां रूप्याङ्घ्रीणां सुवाससाम्।\nपयःशीलवयोरूपवत्सोपस्करसम्पदाम्॥ ९/६/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.024.m4a", "display_order": 25}, {"id": 6000181025, "chapter_id": 10181, "verse_number": "९-६-२२", "content_sanskrit": "प्राहिणोत् साधुविप्रेभ्यो गृहेषु न्यर्बुदानि षट्।\nभोजयित्वा द्विजानग्रे स्वाद्वन्नं गुणवत्तरम्॥ ९/६/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.025.m4a", "display_order": 26}, {"id": 6000181026, "chapter_id": 10181, "verse_number": "९-६-२३", "content_sanskrit": "लब्धकामैरनुज्ञातः पारणायोपचक्रमे।\nतस्य तर्ह्यतिथिः साक्षाद् दुर्वासा भगवानभूत्॥ ९/६/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.026.m4a", "display_order": 27, "topics": [{"text": "एकादशीव्रतमनुतिष्ठतोऽम्बरीषस्य द्वादशीपारणसमये दुर्वासस आगमनम्", "range": "२३"}]}, {"id": 6000181027, "chapter_id": 10181, "verse_number": "९-६-२४", "content_sanskrit": "तमानर्चातिथिं भूयः प्रत्युत्थानासनार्हणैः।\nययाचेऽभ्यवहाराय पादमूलमुपागतः॥ ९/६/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.027.m4a", "display_order": 28, "topics": [{"text": "स्वपारणवेलातिक्रमभिया अम्बरीषेण अब्भक्षणे कृते क्रुद्धेन ऋषिणा अम्बरीषं हन्तुं स्वजटातः कृत्यानिर्माणम्", "range": "२४–३४"}]}, {"id": 6000181028, "chapter_id": 10181, "verse_number": "९-६-२५", "content_sanskrit": "प्रतिनन्द्य स तद्याञ्चां कर्तुमावश्यकं गतः।\nनिममज्ज बृहद् ध्यायन् कालिन्दीसलिले शुचौ॥ ९/६/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.028.m4a", "display_order": 29}, {"id": 6000181029, "chapter_id": 10181, "verse_number": "९-६-२६", "content_sanskrit": "मुहूर्तार्धावशिष्टायां द्वादश्यां पारणं प्रति।\nचिन्तयामास धर्मज्ञो द्विजैस्तद्धर्मसङ्कटे॥ ९/६/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.029.m4a", "display_order": 30}, {"id": 6000181030, "chapter_id": 10181, "verse_number": "९-६-२७", "content_sanskrit": "ब्राह्मणातिक्रमे दोषो द्वादश्यां यदपारणे।\nयत् कृत्वा साधु मे भूयादधर्मो वा न मां स्पृशेत्॥ ९/६/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.030.m4a", "display_order": 31}, {"id": 6000181031, "chapter_id": 10181, "verse_number": "९-६-२८", "content_sanskrit": "अम्भसा केवलेनाद्य करिष्ये व्रतपारणम्।\nआहुरब्भक्षणं विप्रा ह्यशितं नाशितं च यत्॥ ९/६/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.031.m4a", "display_order": 32}, {"id": 6000181032, "chapter_id": 10181, "verse_number": "९-६-२९", "content_sanskrit": "इत्यपः प्राश्य राजर्षिश्चिन्तयन् मनसाऽच्युतम्।\nप्रत्याचष्ट कुरुश्रेष्ठ द्विजागमनमेव सः॥ ९/६/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.032.m4a", "display_order": 33}, {"id": 6000181033, "chapter_id": 10181, "verse_number": "९-६-३०", "content_sanskrit": "दुर्वासा यमुनाकूलात् कृतावश्यक आगतः।\nराज्ञाऽभिच्छन्दितस्तस्य बुबुधे चेष्टितं धिया॥ ९/६/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.033.m4a", "display_order": 34}, {"id": 6000181034, "chapter_id": 10181, "verse_number": "९-६-३१", "content_sanskrit": "मन्युना प्रचलद्गात्रो भुकुटीकुटिलाननः।\nबुभुक्षितश्च सुतरां कृताञ्जलिमभाषत॥ ९/६/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.034.m4a", "display_order": 35}, {"id": 6000181035, "chapter_id": 10181, "verse_number": "९-६-३२", "content_sanskrit": "अहो अस्य नृशंसस्य श्रियोन्मत्तस्य पश्यत।\nधर्मव्यतिक्रमं विष्णोरभक्तस्येष्टमानिनः॥ ९/६/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.035.m4a", "display_order": 36}, {"id": 6000181036, "chapter_id": 10181, "verse_number": "९-६-३३", "content_sanskrit": "यो मामतिथिमायातमातिथ्येन निमन्त्र्य च।\nअदत्त्वा भुक्तवांंस्तस्य सद्यस्ते दर्शये फलम्॥ ९/६/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.036.m4a", "display_order": 37}, {"id": 6000181037, "chapter_id": 10181, "verse_number": "९-६-३४", "content_sanskrit": "एवं ब्रुवाण उत्कृत्य जटां रोषविदीपितः।\nतया स निर्ममे तस्मै कृत्यां कालानलोपमाम्॥ ९/६/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.037.m4a", "display_order": 38}, {"id": 6000181038, "chapter_id": 10181, "verse_number": "९-६-३५", "content_sanskrit": "तामापतन्तीं ज्वलतीमसिहस्तां पदा भुवम्।\nवेपयन्तीं समुद्वीक्ष्य न चचाल पदा नृपः॥ ९/६/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.038.m4a", "display_order": 39, "topics": [{"text": "तस्य राज्ञो रक्षणार्थं स्थितेन चक्रायुधेन कृत्यां दग्ध्वा ऋषिमपि हन्तुमभिद्रावणम्", "range": "३५–४०"}]}, {"id": 6000181039, "chapter_id": 10181, "verse_number": "९-६-३६", "content_sanskrit": "आदिष्टं भक्तरक्षायां पुरुषेण महात्मना।\nददाह कृत्यां तच्चक्रं क्रुद्धाहिमिव पावकः॥ ९/६/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.039.m4a", "display_order": 40}, {"id": 6000181040, "chapter_id": 10181, "verse_number": "९-६-३७", "content_sanskrit": "तदभिद्रवदुद्वीक्ष्य स्वप्रयासं च निष्फलम्।\nदुर्वासा दुद्रुवे भीतो दिक्षु प्राणपरीप्सया॥ ९/६/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.040.m4a", "display_order": 41}, {"id": 6000181041, "chapter_id": 10181, "verse_number": "९-६-३८", "content_sanskrit": "तमन्वधावद् भगवद्रथाङ्गं दावाग्निरुद्भूतशिखो यथाऽहिम्।\nतथाऽनुषक्तं मुनिरीक्षमाणो गुहां विविक्षुः प्रससार मेरोः॥ ९/६/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.041.m4a", "display_order": 42}, {"id": 6000181042, "chapter_id": 10181, "verse_number": "९-६-३९", "content_sanskrit": "दिशो नभः क्ष्मां विवरान् समुद्राल्‍ँलोकान् सपालांस्‍त्रिदिवं गतः सः।\nयतो यतो धावति तत्र तत्र सुदर्शनं दुष्प्रसहं ददर्श॥ ९/६/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.042.m4a", "display_order": 43}, {"id": 6000181043, "chapter_id": 10181, "verse_number": "९-६-४०", "content_sanskrit": "अलब्धनाथः स यदा कुतश्चित् संत्रस्तचित्तोऽरणमेषमाणः।\nदेवं विरिञ्चं समगाद् विधातस्‍त्राह्यात्मयोनेऽजिततेजसो माम्॥ ९/६/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.043.m4a", "display_order": 44}, {"id": 6000181044, "chapter_id": 10181, "verse_number": null, "content_sanskrit": "श्रीब्रह्मोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.044.m4a", "display_order": 45}, {"id": 6000181045, "chapter_id": 10181, "verse_number": "९-६-४१", "content_sanskrit": "स्थानं मदीयं सह विश्वमेतत् क्रीडावसाने द्विपरार्धसंज्ञे।\nभ्रूभङ्गमात्रेण हि सन्दिधक्षोः कालात्मनः पश्यति को भविष्यत्॥ ९/६/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.045.m4a", "display_order": 46, "topics": [{"text": "कुत्राप्यलब्धत्राणेन ऋषिणा भगवन्तं प्रति शरणगमनम्", "range": "४१–५०"}]}, {"id": 6000181046, "chapter_id": 10181, "verse_number": "९-६-४२", "content_sanskrit": "अहं भवो दक्षभृगुप्रधानाः प्रजेशभूतेशसुरेशमुख्याः।\nसर्वे वयं यन्नियमं प्रपन्ना मूर्ध्‍नाऽर्पितं लोकहितं वहामः॥ ९/६/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.046.m4a", "display_order": 47}, {"id": 6000181047, "chapter_id": 10181, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.047.m4a", "display_order": 48}, {"id": 6000181048, "chapter_id": 10181, "verse_number": "९-६-४३", "content_sanskrit": "प्रत्याख्यातो विरिञ्चेन विष्णुचक्रोपतापितः।\nदुर्वासाः शरणं यातः शर्वं कैलासवासिनम्॥ ९/६/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.048.m4a", "display_order": 49}, {"id": 6000181049, "chapter_id": 10181, "verse_number": null, "content_sanskrit": "श्रीशङ्कर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.049.m4a", "display_order": 50}, {"id": 6000181050, "chapter_id": 10181, "verse_number": "९-६-४४", "content_sanskrit": "वयं न तात प्रभवाम भूम्नो भवन्ति काले न भवन्ति हीदृशाः।\nयस्मिन् परेऽन्येऽप्यजजीवकोशाः सहस्रशो यत्र वयं भ्रमामः॥ ९/६/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.050.m4a", "display_order": 51}, {"id": 6000181051, "chapter_id": 10181, "verse_number": "९-६-४५", "content_sanskrit": "अहं सनत्कुमारश्च नारदो भगवानजः।\nकपिलोऽपान्ततरमा देवलो धर्म आसुरिः॥ ९/६/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.051.m4a", "display_order": 52}, {"id": 6000181052, "chapter_id": 10181, "verse_number": "९-६-४६", "content_sanskrit": "मरीचिप्रमुखाश्चान्ये सिद्धेशाः पारदर्शिनः।\nविदाम न वयं सर्वे यन्मायां माययाऽऽवृताः॥ ९/६/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.052.m4a", "display_order": 53}, {"id": 6000181053, "chapter_id": 10181, "verse_number": "९-६-४७", "content_sanskrit": "तस्य विश्वेश्वरस्येदं शस्‍त्रं दुर्विषहं हि नः।\nतमेव शरणं याहि हरिस्ते शं विधास्यति॥ ९/६/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.053.m4a", "display_order": 54}, {"id": 6000181054, "chapter_id": 10181, "verse_number": "९-६-४८", "content_sanskrit": "ततो निराशो दुर्वासाः पदं भगवतो ययौ।\nविकुण्ठाख्यं यदध्यास्ते श्रीनिवासः श्रिया सह॥ ९/६/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.054.m4a", "display_order": 55}, {"id": 6000181055, "chapter_id": 10181, "verse_number": "९-६-४९", "content_sanskrit": "सन्दह्यमानोऽजितशस्‍त्रवह्निना तत्पादमूले पतितः सवेपथुः।\nआहाच्युतानन्त सदीप्सित प्रभो कृतागसं मामव विश्वभावन॥ ९/६/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.055.m4a", "display_order": 56}, {"id": 6000181056, "chapter_id": 10181, "verse_number": "९-६-५०", "content_sanskrit": "अजानता ते परमानुभावं कृतं मयाऽघं भवतः प्रियाणाम्।\nविधेहि तस्यापचितिं विधातर्मुच्येत यन्नाम्न्युदिते नारकोऽपि॥ ९/६/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.056.m4a", "display_order": 57}, {"id": 6000181057, "chapter_id": 10181, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.057.m4a", "display_order": 58}, {"id": 6000181058, "chapter_id": 10181, "verse_number": "९-६-५१", "content_sanskrit": "अहं भक्तपराधीनो ह्यस्वतन्त्र इव द्विज।\nसाधुभिर्ग्रस्तहृदयो भक्तैर्भक्तजनप्रियः॥ ९/६/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.058.m4a", "display_order": 59, "topics": [{"text": "भगवता नारायणेन स्वभक्तमाहात्म्यप्रकटनार्थम् अम्बरीषं प्रत्येव शरणगमनचोदना", "range": "५१–५९"}]}, {"id": 6000181059, "chapter_id": 10181, "verse_number": "९-६-५२", "content_sanskrit": "नाहमात्मानमाशासे मद्भक्तैः साधुभिर्विना।\nश्रियं चात्यन्तिकीं ब्रह्मन् येषां गतिरहं परा॥ ९/६/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.059.m4a", "display_order": 60}, {"id": 6000181060, "chapter_id": 10181, "verse_number": "९-६-५३", "content_sanskrit": "ये दारागारपुत्रादीन् प्राणान् वित्तमिदं परम्।\nहित्वा मां शरणं याताः कथं तांस्त्यक्तुमुत्सहे॥ ९/६/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.060.m4a", "display_order": 61}, {"id": 6000181061, "chapter_id": 10181, "verse_number": "९-६-५४", "content_sanskrit": "मयि निर्बद्धहृदयाः साधवः समदर्शिनः।\nवशीकुर्वन्ति मां भक्त्या सत्स्‍त्रियः सत्पतिं यथा॥ ९/६/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.061.m4a", "display_order": 62}, {"id": 6000181062, "chapter_id": 10181, "verse_number": "९-६-५५", "content_sanskrit": "मत्सेवया प्रदिष्टं च सालोक्यादिचतुष्टयम्।\nनेच्छन्ति सेवया पूर्णाः कुतोऽन्यत् कालविप्लुतम्॥ ९/६/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.062.m4a", "display_order": 63}, {"id": 6000181063, "chapter_id": 10181, "verse_number": "९-६-५६", "content_sanskrit": "साधवो हृदयं मह्यं साधूनां हृदयं त्वहम्।\nमदन्यत्ते न जानन्ति नाहं तेभ्यो मनागपि॥ ९/६/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.063.m4a", "display_order": 64}, {"id": 6000181064, "chapter_id": 10181, "verse_number": "९-६-५७", "content_sanskrit": "उपायं कथयिष्यामि तव विप्र शृणुष्व तत्।\nअयं ह्यात्माभिचारस्ते यतस्तं यातु वै भवान्॥ ९/६/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.064.m4a", "display_order": 65}, {"id": 6000181065, "chapter_id": 10181, "verse_number": "९-६-५८", "content_sanskrit": "साधुषु प्रहितं तेजः प्रहर्तुः कुरुते भयम्।\nतपो विद्या च विप्राणां निःश्रेयसकरे उभे॥ ९/६/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.065.m4a", "display_order": 66}, {"id": 6000181066, "chapter_id": 10181, "verse_number": "९-६-५९", "content_sanskrit": "त एव दुर्विनीतस्य कल्पेते कर्तुरन्यथा। ब्रह्मस्तद् गच्छ भद्रं ते नाभागतनयं नृपम्।\nक्षमापय महाभागं ततः शान्तिर्भविष्यति॥ ९/६/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.066.m4a", "display_order": 67}, {"id": 6000181067, "chapter_id": 10181, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.067.m4a", "display_order": 68}, {"id": 6000181068, "chapter_id": 10181, "verse_number": "९-६-६०", "content_sanskrit": "एवं भगवताऽऽदिष्टो दुर्वासाश्चक्रतापितः।\nअम्बरीषमुपावृत्य तत्पादौ दुःखितोऽग्रहीत्॥ ९/६/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.068.m4a", "display_order": 69, "topics": [{"text": "भगवदाज्ञानुसारेण अम्बरीषमागत्य तस्य पादौ गृहीतवतो दुर्वाससो रक्षणार्थमम्बरीषेण सुदर्शनस्तुतिः", "range": "६०–७०"}]}, {"id": 6000181069, "chapter_id": 10181, "verse_number": "९-६-६१", "content_sanskrit": "तस्य तद्व्यसनं वीक्ष्य पादस्पर्शविलज्जितः।\nअस्तावीत् तद्धरेरस्‍त्रं कृपया पीडितो भृशम्॥ ९/६/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.069.m4a", "display_order": 70}, {"id": 6000181070, "chapter_id": 10181, "verse_number": null, "content_sanskrit": "अम्बरीष उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.070.m4a", "display_order": 71}, {"id": 6000181071, "chapter_id": 10181, "verse_number": "९-६-६२", "content_sanskrit": "त्वमग्निर्भगवान् सूर्यस्त्वं सोमो ज्योतिषां पतिः।\nत्वमापस्त्वं क्षितिर्व्योम वायुमात्रेन्द्रियाणि च॥ ९/६/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.071.m4a", "display_order": 72}, {"id": 6000181072, "chapter_id": 10181, "verse_number": "९-६-६३", "content_sanskrit": "सुदर्शन नमस्तुभ्यं सहस्राराच्युतप्रिय।\nसर्वास्त्रघातिन् विप्राय स्वस्ति भूयादिडस्पते॥ ९/६/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.072.m4a", "display_order": 73}, {"id": 6000181073, "chapter_id": 10181, "verse_number": "९-६-६४", "content_sanskrit": "त्वं धर्मस्त्वं धृतिः सत्यं त्वं यज्ञोऽखिलयज्ञभुक्।\nत्वं लोकपालः सर्वात्मा त्वं तेजः पौरुषं परम्॥ ९/६/६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.073.m4a", "display_order": 74}, {"id": 6000181074, "chapter_id": 10181, "verse_number": "९-६-६५", "content_sanskrit": "नमः सुनाभाखिलधर्मसेतवे अधर्मशीलासुरधूमकेतवे।\nत्रैलोक्यगोपाय विशुद्धवर्चसे मनोजवायाद्भुतकर्मणेऽस्तु ते॥ ९/६/६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.074.m4a", "display_order": 75}, {"id": 6000181075, "chapter_id": 10181, "verse_number": "९-६-६६", "content_sanskrit": "यदा विसृष्टस्त्वमनञ्जनेन वै बलं प्रविश्योर्जितदैत्यदानवम्।\nबाहूदरोर्वङ्घ्रिशिरोधराणि वृक्णन्नजस्रं प्रधने विराजसे॥ ९/६/६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.075.m4a", "display_order": 76}, {"id": 6000181076, "chapter_id": 10181, "verse_number": "९-६-६७", "content_sanskrit": "त्वत्तेजसा धर्ममयेन संहृतं तमः प्रकाशश्च दृशोर्महात्मनाम्।\nदुरत्ययस्ते महिमा गिराम्पते त्वद्रूपमेतत् सदसत् परावरम्॥ ९/६/६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.076.m4a", "display_order": 77}, {"id": 6000181077, "chapter_id": 10181, "verse_number": "९-६-६८", "content_sanskrit": "स त्वं जगत्त्राण खलप्रहाणये निरूपितः सर्वसहो गदाभृता।\nविप्राय चास्मत्कुलदैवहेतवे विधेहि भद्रं तदनुग्रहो हि नः॥ ९/६/६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.077.m4a", "display_order": 78}, {"id": 6000181078, "chapter_id": 10181, "verse_number": "९-६-६९", "content_sanskrit": "यद्यस्ति दत्तमिष्टं वो स्वधर्मो वा स्वनुष्ठितः।\nकुलं नो विप्रदैवं चेद् दिजो भवतु विज्वरः॥ ९/६/६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.078.m4a", "display_order": 79}, {"id": 6000181079, "chapter_id": 10181, "verse_number": "९-६-७०", "content_sanskrit": "यदि मे भगवान् प्रीत एकः सर्वगुणाश्रयः।\nसर्वभूतात्मभावेन द्विजो भवतु विज्वरः॥ ९/६/७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.079.m4a", "display_order": 80}, {"id": 6000181080, "chapter_id": 10181, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.080.m4a", "display_order": 81}, {"id": 6000181081, "chapter_id": 10181, "verse_number": "९-६-७१", "content_sanskrit": "इति संस्तुवतो राज्ञो विष्णुचक्रं सुदर्शनम्।\nअशाम्यत् सर्वतो विप्रं प्रदहद् राजयाञ्चया॥ ९/६/७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.081.m4a", "display_order": 82, "topics": [{"text": "तत्स्तुतिप्रसन्नेन सुदर्शनेन दुर्वाससो मोचनम्", "range": "७१–८६"}]}, {"id": 6000181082, "chapter_id": 10181, "verse_number": "९-६-७२", "content_sanskrit": "स मुक्तोऽस्‍त्राग्नितापेन दुर्वासाः स्वस्तिमांस्ततः।\nप्रशशंस तमुर्वीशं युञ्जानः परमाशिषः॥ ९/६/७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.082.m4a", "display_order": 83}, {"id": 6000181083, "chapter_id": 10181, "verse_number": null, "content_sanskrit": "दुर्वासा उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.083.m4a", "display_order": 84}, {"id": 6000181084, "chapter_id": 10181, "verse_number": "९-६-७३", "content_sanskrit": "अहो अनन्तदासानां महित्वं दृष्टमद्य मे।\nकृतागसोऽपि यद् राजन् मङ्गलानि समीहसे॥ ९/६/७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.084.m4a", "display_order": 85}, {"id": 6000181085, "chapter_id": 10181, "verse_number": "९-६-७४", "content_sanskrit": "दुष्करं किन्नु साधूनां दुस्त्यजं वा महात्मनाम्।\nयैः सङ्गृहीतो भगवान् सात्वतामृषभो हरिः॥ ९/६/७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.085.m4a", "display_order": 86}, {"id": 6000181086, "chapter_id": 10181, "verse_number": "९-६-७५", "content_sanskrit": "यन्नामश्रुतिमात्रेण पुमान् भवति निर्मलः।\nतस्य तीर्थपदः किं वा दासानामवशिष्यते॥ ९/६/७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.086.m4a", "display_order": 87}, {"id": 6000181087, "chapter_id": 10181, "verse_number": "९-६-७६", "content_sanskrit": "राजन्ननुगृहीतोऽहं त्वयाऽतिकरुणात्मना।\nममाघं पृष्ठतः कृत्वा प्राणा यन्मेऽभिरक्षिताः॥ ९/६/७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.087.m4a", "display_order": 88}, {"id": 6000181088, "chapter_id": 10181, "verse_number": "९-६-७७", "content_sanskrit": "राजा तमकृताहारः प्रत्यागमनकाङ्क्षया।\nचरणावुपसङ्गृह्य प्रसाद्य समभोजयत्॥ ९/६/७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.088.m4a", "display_order": 89}, {"id": 6000181089, "chapter_id": 10181, "verse_number": "९-६-७८", "content_sanskrit": "सोऽशित्वाऽऽदृतमानीतमातिथ्यं सार्वकामिकम्।\nतृप्तात्मा नृपतिं प्राह भुज्यतामिति सादरम्॥ ९/६/७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.089.m4a", "display_order": 90}, {"id": 6000181090, "chapter_id": 10181, "verse_number": "९-६-७९", "content_sanskrit": "प्रीतोऽस्म्यनुगृहीतोऽस्मि तव भागवतस्य वै।\nदर्शनस्पर्शनालापैरातिथ्येनात्ममेधसा॥ ९/६/७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.090.m4a", "display_order": 91}, {"id": 6000181091, "chapter_id": 10181, "verse_number": "९-६-८०", "content_sanskrit": "कर्मावदातमेतत् ते गायन्ति स्वःस्‍त्रियो मुहुः।\nकीर्तिं परमपुण्यां च कीर्तयिष्यति भूरियम्॥ ९/६/८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.091.m4a", "display_order": 92}, {"id": 6000181092, "chapter_id": 10181, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.092.m4a", "display_order": 93}, {"id": 6000181093, "chapter_id": 10181, "verse_number": "९-६-८१", "content_sanskrit": "एवं सङ्कीर्त्य राजानं दुर्वासाः परितोषितः।\nययौ विहायसाऽऽमन्त्र्य ब्रह्मलोकमहैतुकम्॥ ९/६/८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.093.m4a", "display_order": 94}, {"id": 6000181094, "chapter_id": 10181, "verse_number": "९-६-८२", "content_sanskrit": "संवत्सरोऽत्यगात् तावत् यावत्तं नागतो गतः।\nमुनिस्तद्दर्शनाकाङ्क्षी राजाऽब्भक्षो बभूव ह॥ ९/६/८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.094.m4a", "display_order": 95}, {"id": 6000181095, "chapter_id": 10181, "verse_number": "९-६-८३", "content_sanskrit": "गतेऽथ दूर्वाससि सोऽम्बरीषो द्विजोपभोगातिपवित्रमाहरन्।\nऋषेर्विमोक्षं व्यसनाच्च बुद्ध्या मेने स्ववीर्यं च परानुभावम्॥ ९/६/८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.095.m4a", "display_order": 96}, {"id": 6000181096, "chapter_id": 10181, "verse_number": "९-६-८४", "content_sanskrit": "एवंविधानेकगुणः स राजा परात्मनि ब्रह्मणि वासुदेवे।\nक्रियाकलापैः समुवाह भक्तिं यया विरिञ्चादिमधश्चकार॥ ९/६/८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.096.m4a", "display_order": 97}, {"id": 6000181097, "chapter_id": 10181, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.097.m4a", "display_order": 98}, {"id": 6000181098, "chapter_id": 10181, "verse_number": "९-६-८५", "content_sanskrit": "अथाम्बरीषस्तनयेषु राज्यं समानशीलेषु विसृज्य धीरः।\nवनं विवेशात्मनि वासुदेवे मनो दधद् ध्वस्तगुणप्रवाहः॥ ९/६/८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.098.m4a", "display_order": 99}, {"id": 6000181099, "chapter_id": 10181, "verse_number": "९-६-८६", "content_sanskrit": "इत्येतत् पुण्यमाख्यानमम्बरीषस्य भूपतेः।\nसङ्कीर्तयन्ननुध्यायन् भक्तो भगवतो भवेत्॥ ९/६/८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_006/BhP_09.006.099.m4a", "display_order": 100}, {"id": 6000181100, "chapter_id": 10181, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां नवमस्कन्धे षष्ठाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}]