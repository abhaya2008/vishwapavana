[{"id": 2023684, "chapter_id": 1507, "verse_number": "३-१४५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2023685, "chapter_id": 1507, "verse_number": "३-१४५-१", "content_sanskrit": "ते शूरा सज्जधन्वानस्तूणवन्तः समार्गणाः।\nबद्धगोधाङ्गुलित्राणाः खङ्गवन्तोऽमितौजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2023686, "chapter_id": 1507, "verse_number": "३-१४५-२", "content_sanskrit": "परिगृह्य द्विजश्रेष्ठाञ्ज्येष्ठाः सर्वधनुष्मताम्।\nपञ्चालीसहिता राजन्प्रययुर्गन्धमादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2023687, "chapter_id": 1507, "verse_number": "३-१४५-३", "content_sanskrit": "सरांसि सरितश्चैव पर्वतांश्च वनानि च।\nवृक्षांश्च बहुलच्छायान्ददृशुर्गिरिमूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2023688, "chapter_id": 1507, "verse_number": "३-१४५-४", "content_sanskrit": "नित्यपुष्पफलान्देशान्देवर्षिगणसेवितान्।\nआत्मन्यात्मानमाधाय वीरा मूलफलाशिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2023689, "chapter_id": 1507, "verse_number": "३-१४५-५", "content_sanskrit": "चेरुरुच्चावचाकारान्देशान्विषमसंकटान्।\nपश्यन्तो मृगजातानि बहूनि विविधानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2023690, "chapter_id": 1507, "verse_number": "३-१४५-६", "content_sanskrit": "ऋषिसिद्धामरयुतं गन्धर्वाप्सरसां प्रियम्।\nविविशुस्ते महात्मानः किन्नराचरितं गिरिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2023691, "chapter_id": 1507, "verse_number": "३-१४५-७", "content_sanskrit": "प्रविशत्स्वथ वीरेषु पर्वतं गन्धमादनम्।\nचणअडवातं महद्वर्षं प्रादुरासीद्विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2023692, "chapter_id": 1507, "verse_number": "३-१४५-८", "content_sanskrit": "ततो रेणुः समुद्भूतः सपत्रबहुलो महान्।\nपृथिवीं चान्तरिक्षं च द्यां चैव सहसाऽवृणोत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2023693, "chapter_id": 1507, "verse_number": "३-१४५-९", "content_sanskrit": "न स्म प्रज्ञायते किंचिदावृते व्योम्नि रेणुना।\nन चापि शेकुस्तत्कर्तुमन्योन्यस्याभिभाषणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2023694, "chapter_id": 1507, "verse_number": "३-१४५-१०", "content_sanskrit": "न चापश्यंस्ततोऽन्योन्यं तमसाऽऽवृतचक्षुषः।\nआकृष्यमाणा वातेन साश्मचूर्णेन भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2023695, "chapter_id": 1507, "verse_number": "३-१४५-११", "content_sanskrit": "द्रुमाणां वातरुग्णआनां पततां भूतलेऽनिशम्।\nअन्येषां च महीजानां शब्दः समभवन्महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2023696, "chapter_id": 1507, "verse_number": "३-१४५-१२", "content_sanskrit": "द्यौः स्वित्पतति किं भूमिर्दीर्यते पर्वतोनु किम्।\nइति ते मेनिरे सर्वेपवनेन विमोहिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2023697, "chapter_id": 1507, "verse_number": "३-१४५-१३", "content_sanskrit": "ते पथाऽनन्तरांन्वृक्षान्वल्मीकान्विषमाणि च।\nपाणिभिः परिमार्गन्तो भीता वायोर्निलिल्यिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2023698, "chapter_id": 1507, "verse_number": "३-१४५-१४", "content_sanskrit": "ततः कार्मुकमादाय भीमसेनो महाबलः।\nकृष्णामादाय संगम्य तस्थावाश्रित्य पादपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2023699, "chapter_id": 1507, "verse_number": "३-१४५-१५", "content_sanskrit": "धर्मराजश्च धौम्यश् निलिल्याते महावने।\nअग्निहोत्राण्युपादाय सहदेवस्तु पर्वते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2023700, "chapter_id": 1507, "verse_number": "३-१४५-१६", "content_sanskrit": "नकुलो ब्राह्मणाश्चान्ये लोमशश्च महातपाः।\nवृक्षानासाद्य संत्रस्तास्तत्रतत्र निलिल्यिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2023701, "chapter_id": 1507, "verse_number": "३-१४५-१७", "content_sanskrit": "मन्दीभूते तु पवने तस्मिन्रजसि शाम्यति।\nमहद्भिर्जलधारौर्घर्वर्षमभ्याजगाम ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2023702, "chapter_id": 1507, "verse_number": "३-१४५-१८", "content_sanskrit": "भृशं चटचटाशब्दो वज्राणां क्षिप्यतामिव।\nततस्ताश्चञ्चलाभासश्चेरुरभ्रेषु विद्युतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2023703, "chapter_id": 1507, "verse_number": "३-१४५-१९", "content_sanskrit": "ततोऽश्मसहिता धाराः संवृण्वन्त्यः समन्ततः।\nप्रपेतुरनिशं तत्र शीघ्रवातसमीरिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2023704, "chapter_id": 1507, "verse_number": "३-१४५-२०", "content_sanskrit": "तत्र सागरगा ह्यापः कीर्यमाणाः समन्ततः।\nप्रादुरासन्सकलुषाः फेनवत्यो विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2023705, "chapter_id": 1507, "verse_number": "३-१४५-२१", "content_sanskrit": "वहन्त्यो वारि बहुलं फेनोडुपपरिप्लुतम्।\nपरिसमस्रुर्महाशब्दाः प्रकर्षन्त्यो महीरुहान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2023706, "chapter_id": 1507, "verse_number": "३-१४५-२२", "content_sanskrit": "तस्मिन्नुपरते शब्देबाते च समतां गते।\nगते ह्यम्भसि निम्नानि प्रादुर्भूते दिवाकरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2023707, "chapter_id": 1507, "verse_number": "३-१४५-२३", "content_sanskrit": "निर्जग्मुस्ते शनैः सर्वे समाजग्मुश्च भारत।\nप्रतस्थिरे पुनर्वीराः पर्वतं गन्धमादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2023708, "chapter_id": 1507, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि पञ्चचत्वारिंशदधिकशततमोऽध्यायः ॥ १४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]