[{"id": 7004912000, "chapter_id": 24912, "verse_number": "७-१-९५-१", "content_sanskrit": "ईश्वर उवाच ।\nततो गच्छेद्वरारोहे लिंगं मृत्युञ्जयेश्वरम् ।\nतस्यैव वह्नि कोणस्थं धनुषां दशके स्थितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004912001, "chapter_id": 24912, "verse_number": "७-१-९५-२", "content_sanskrit": "पश्चिमे सागरादित्यात्स्थितं धनुश्चतुष्टये ।\nपापघ्नं सर्वजन्तूनां दर्शनात्स्पर्शनादपि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004912002, "chapter_id": 24912, "verse_number": "७-१-९५-३", "content_sanskrit": "पूर्वे युगे समाख्यातं नाम नन्दीश्वरेति च ।\nयत्र तप्तं तपो घोरं नन्दिनाम्ना गणेन मे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004912003, "chapter_id": 24912, "verse_number": "७-१-९५-४", "content_sanskrit": "प्रतिष्ठाप्य महालिंगं नित्यं पूजापरेण च ।\nतत्र जप्तो महामन्त्रो मृत्युञ्जय इति श्रुतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004912004, "chapter_id": 24912, "verse_number": "७-१-९५-५", "content_sanskrit": "कोटीनां नियुतं देवि ततस्तुष्टो महेश्वरः ।\nददौ गणेशतां तस्य मुक्तिं सामीप्यगां तथा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004912005, "chapter_id": 24912, "verse_number": "७-१-९५-६", "content_sanskrit": "मृत्युञ्जयेन मन्त्रेण तस्य तुष्टो यतो हरः ।\nतेन मृत्युञ्जयेशेति ख्यातं लिंगं धरातले ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004912006, "chapter_id": 24912, "verse_number": "७-१-९५-७", "content_sanskrit": "यस्तं पूजयते भक्त्या पश्येद्वा भावितात्मवान् ।\nनाशयेत्तस्य पापानि सप्तजन्मार्जितान्यपि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004912007, "chapter_id": 24912, "verse_number": "७-१-९५-८", "content_sanskrit": "स्नापयेत्पयसा लिंगं दध्ना घृतयुतेन च ।\nमधुनेक्षुरसेनैव कुंकुमेन विलेपयेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004912008, "chapter_id": 24912, "verse_number": "७-१-९५-९", "content_sanskrit": "कर्पूरोशीर मिश्रेण मृगनाभिरसेन च ।\nचन्दनेन सुगन्धेन पुष्पैः संपूजयेत्ततः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004912009, "chapter_id": 24912, "verse_number": "७-१-९५-१०", "content_sanskrit": "दद्याद्धूपं पुरो देवि ततो देवस्य चागुरुम् ।\nवस्त्रैः संपूज्य विविधैरात्मवित्तानुसारतः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004912010, "chapter_id": 24912, "verse_number": "७-१-९५-११", "content_sanskrit": "नैवेद्यं परमान्नं च दत्त्वा दीपसमन्वितम् ।\nअष्टांगं प्रणिपातं च ततः कार्यं च भक्तितः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004912011, "chapter_id": 24912, "verse_number": "७-१-९५-१२", "content_sanskrit": "हेमदानं प्रदातव्यं ब्राह्मणे वेदपारगे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004912012, "chapter_id": 24912, "verse_number": "७-१-९५-१३", "content_sanskrit": "एवं यात्रा भवेत्तस्य शास्त्रोक्ता नात्र संशयः ।\nएवं कृत्वा नरो देवि लभते जन्मनः फलम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004912013, "chapter_id": 24912, "verse_number": "७-१-९५-१४", "content_sanskrit": "इति संक्षेपतः प्रोक्तं मृत्युञ्जयमहोदयम् ।\nपापघ्नं सर्वजंतूनां सर्वकामफलप्रदम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004912014, "chapter_id": 24912, "verse_number": "७-१-९५-१५", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभास खण्डे प्रथमे प्रभासक्षेत्रमाहात्म्य एकादशरुद्रमाहात्म्ये मृत्युञ्जयमाहात्म्यवर्णनंनाम पञ्चनवतितमोऽध्यायः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]