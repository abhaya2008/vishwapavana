[{"id": 2015552, "chapter_id": 1328, "verse_number": "२-६९-१", "content_sanskrit": "वैशम्पायन उवाच॥\nततो युद्धाय संनद्धं चेदिराजं युधिष्ठिरः।\nदृष्ट्वा मतिमतां श्रेष्ठो नारदं समुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2015553, "chapter_id": 1328, "verse_number": "२-६९-२x", "content_sanskrit": "युधिष्ठिर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2015554, "chapter_id": 1328, "verse_number": "२-६९-२", "content_sanskrit": "अन्तरिक्षे च भूमौ च तेऽस्त्यविदितं क्वचित्।\nयानि राजविनाशाय भौमानि च खगानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2015555, "chapter_id": 1328, "verse_number": "२-६९-३", "content_sanskrit": "निमित्तानीह जायन्ते उत्पाताश्च पृथग्विधाः।\nएतदित्छामि कार्त्स्न्येन श्रोतुं त्वत्तो महामुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2015556, "chapter_id": 1328, "verse_number": "२-६९-४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2015557, "chapter_id": 1328, "verse_number": "२-६९-४", "content_sanskrit": "इत्येवं मितमान्विप्रः कुरुराजस्य धीमतः।\nपृच्छतः सर्वमव्यग्रमाचचक्षे महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2015558, "chapter_id": 1328, "verse_number": "२-६९-५x", "content_sanskrit": "नारद उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2015559, "chapter_id": 1328, "verse_number": "२-६९-५", "content_sanskrit": "पराक्रमं च मार्गं च संनिपातं समुच्छ्रयम्।\nआरोहणं कुरुश्रेष्ठ अन्योन्यं प्रतिसर्पणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2015560, "chapter_id": 1328, "verse_number": "२-६९-६", "content_sanskrit": "पश्मीनां व्यतिसंसर्गं व्यायामं वृत्तिपीडनम्।\nदर्शनादर्शनं चैव अदृश्यानां च दर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2015561, "chapter_id": 1328, "verse_number": "२-६९-७", "content_sanskrit": "हानिं वृद्धिं च ह्रासं च वर्णस्थानं बलाबलम्।\nसर्वमेतत्परीक्षेत ग्रहाणां ग्रहकोविदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2015562, "chapter_id": 1328, "verse_number": "२-६९-८", "content_sanskrit": "भौमाः पूर्वं प्रवर्तन्ते खेचराश्च ततः परम्।\nउत्पद्यन्ते च लोकेऽस्मिन्नुत्पाता देवनिर्मिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2015563, "chapter_id": 1328, "verse_number": "२-६९-९", "content_sanskrit": "यदा तु सर्वभूतानां छाया न परिवर्तते।\nअपरेण गते सूर्ये तत्पराभवलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2015564, "chapter_id": 1328, "verse_number": "२-६९-१०", "content_sanskrit": "अच्छाये विमलच्छाया प्रतिच्छायेव दृश्यते।\nयत्र चैत्यकवृक्षाणां तत्र विद्यान्महद्भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2015565, "chapter_id": 1328, "verse_number": "२-६९-११", "content_sanskrit": "शीर्णपर्णप्रवालाश्च शुष्कपर्णाश्च चैत्यकाः।\nअपभ्रष्टप्रवालाश्च तत्राभावं विनिर्दिशेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2015566, "chapter_id": 1328, "verse_number": "२-६९-१२", "content_sanskrit": "स्निग्धपर्णप्रवालाश्च दृश्यन्ते यत्र चैत्यकाः।\nईहमानाश्च वृक्षाश्च भावस्तत्र न संशयटः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2015567, "chapter_id": 1328, "verse_number": "२-६९-१३", "content_sanskrit": "पुष्पे पुष्पं प्रजायेत फले वा फलमाश्रितम्।\nराजा वा राजमात्रो वा मरणायोपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2015568, "chapter_id": 1328, "verse_number": "२-६९-१४", "content_sanskrit": "प्रावृट्छरदि हेमन्ते वसन्ते वापि सर्वशः।\nआकालिकं पुष्पफलं राष्ट्रक्षोभं विनिर्दिशेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2015569, "chapter_id": 1328, "verse_number": "२-६९-१५", "content_sanskrit": "नदीनां स्त्रोतसोऽकाले द्योतयन्ति महाभयम्।\nवनस्पतिः पूज्यमानः पूजितोऽपूजितोऽपि वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2015570, "chapter_id": 1328, "verse_number": "२-६९-१६", "content_sanskrit": "यदा भज्येत वातेन भिद्यते नमितोऽपि वा।\nअग्निवायुभयं विद्याच्छ्रेष्ठो वापि विनश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2015571, "chapter_id": 1328, "verse_number": "२-६९-१७", "content_sanskrit": "दिशः सर्वाश्च दीप्यन्ते जायन्ते राजविभ्रमाः।\nभिद्यमानो यदा वृक्षो निनदेच्चापि पातितः।\nसह राष्ट्रं च पतितं नतं वृक्षं प्रपातयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2015572, "chapter_id": 1328, "verse_number": "२-६९-१८", "content_sanskrit": "अथैनं छेदयेत्कश्चित्प्रतिक्रुद्धो वनस्पतिः।\nछेत्ता भेत्ता पतिश्चैव क्षिप्रमेव नशिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2015573, "chapter_id": 1328, "verse_number": "२-६९-१९", "content_sanskrit": "देवतानां च पतनं मष्टपानां च पातनम्।\nअचलानां प्रकम्पश्च तत्पराभवलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2015574, "chapter_id": 1328, "verse_number": "२-६९-२०", "content_sanskrit": "निशि चेन्द्रधनुर्दृष्टं ततोपि च महद्भयम्।\nतद्द्रष्टरेव भीतिः स्यान्नान्येषां भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2015575, "chapter_id": 1328, "verse_number": "२-६९-२१", "content_sanskrit": "रात्राविन्द्रधनुर्दृष्ट्वा तद्राष्ट्रं परिवर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2015576, "chapter_id": 1328, "verse_number": "२-६९-२२", "content_sanskrit": "अर्चा यत्र प्रनृत्यन्त नदन्ति च हसन्ति च।\nउन्मीलन्ति निमीलन्ति राष्ट्रक्षोभं विनिर्दिशेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2015577, "chapter_id": 1328, "verse_number": "२-६९-२३", "content_sanskrit": "शिला यदि प्रसिञ्चन्ति स्नेहांश्चोदकसम्भवान्।\nअन्यद्वा विकृतं किञ्चित्तद्भयस्य निदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2015578, "chapter_id": 1328, "verse_number": "२-६९-२४", "content_sanskrit": "म्रियन्ते वा महामात्रा राजा सपरिवारकः।\nपुरस्य या भवेद्व्याधी राष्ट्रे देशे च विभ्रमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2015579, "chapter_id": 1328, "verse_number": "२-६९-२५", "content_sanskrit": "देवतानां यदाऽऽवासे राज्ञां वा यत्र वेश्मनि।\nभाण्डागारायुधागारे निविशेत यदा मधु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2015580, "chapter_id": 1328, "verse_number": "२-६९-२६", "content_sanskrit": "सर्वं तदा भवेत्स्थानं हन्यमानं बलीयसा।\nआगन्तुकं भयं तत्र भवेदित्येव निर्दिशेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2015581, "chapter_id": 1328, "verse_number": "२-६९-२७", "content_sanskrit": "पादपश्चैव यो यत्र रक्तं स्रवति शोणितम्।\nदन्ताग्रात्कुञ्जरो वापि शृङ्गाद्वा वृषभस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2015582, "chapter_id": 1328, "verse_number": "२-६९-२८", "content_sanskrit": "पादपाद्राष्ट्रिविभ्रंशः कुञ्जराद्राजविभ्रमः।\nगोब्राह्मणविनाशः स्याद्वृवभस्येति निर्दिशेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2015583, "chapter_id": 1328, "verse_number": "२-६९-२९", "content_sanskrit": "छत्रं नरपतेर्यत्र निपतेत्पृथिवीतले।\nसराष्ट्रो नृपती राजन्क्षिप्रमेव विनश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2015584, "chapter_id": 1328, "verse_number": "२-६९-३०", "content_sanskrit": "देवागारेषु वा यत्र राज्ञो वा यत्र वेश्मनि।\nविकृतं यदि दृश्येत नागावासेषु वा पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2015585, "chapter_id": 1328, "verse_number": "२-६९-३१", "content_sanskrit": "तस्य देशस्य पीडा स्याद्राज्ञो जनपदस्य वा।\nअनावृष्टिभयं घोरमतिदुर्भिक्षमादिशेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2015586, "chapter_id": 1328, "verse_number": "२-६९-३२", "content_sanskrit": "अर्चाया बाहुभङ्गेन गृहस्थानां भयं भवेत्।\nभग्ने प्रहरणे विद्यात्सेनापतिविनाशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2015587, "chapter_id": 1328, "verse_number": "२-६९-३३", "content_sanskrit": "आगन्तुका तु प्रतिमा स्थानं यत्र न विन्दति।\nजभ्यन्तरेण षण्मासाद्राजा त्यजति तत्पुरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2015588, "chapter_id": 1328, "verse_number": "२-६९-३४", "content_sanskrit": "प्रदीर्यते मही यत्र विनदत्यपि पात्यते।\nम्रियते तत्र राजा च तत्र राष्ट्रं विनश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2015589, "chapter_id": 1328, "verse_number": "२-६९-३५", "content_sanskrit": "एणीपदान्वा सर्पान्वा डुण्डुभानथ दीप्यकान्।\nमण्डूको ग्रसते यत्र तत्र राजा विनश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2015590, "chapter_id": 1328, "verse_number": "२-६९-३६", "content_sanskrit": "अभिन्नं वाप्यपक्वं वा यत्रान्नमुपचीयते।\nजीर्यन्ते वा म्रियन्ते वा तदन्नं नोपभुञ्जते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2015591, "chapter_id": 1328, "verse_number": "२-६९-३७", "content_sanskrit": "उदपाने च यत्रापो विवर्धन्ते युधिष्ठिर।\nस्थावरेषु प्रवर्तन्ते निर्गच्छेन्न पुनस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2015592, "chapter_id": 1328, "verse_number": "२-६९-३८", "content_sanskrit": "अपादं वा त्रिपादं वा द्विशीर्षं वा चतुर्भुजम्।\nस्त्रियो यत्र प्रसूयन्ते ब्रूयात्तत्र पराभवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2015593, "chapter_id": 1328, "verse_number": "२-६९-३९", "content_sanskrit": "अजैडकाः स्त्रियो गावो ये चान्ये च वियोनयः।\nविकृतानि प्रजायन्ते तत्र तत्र पराभवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2015594, "chapter_id": 1328, "verse_number": "२-६९-४०", "content_sanskrit": "नदी यत्र प्रतिस्रोता आवहेत्कलुषोदकम्।\nदिशश्च न प्रकाशन्ते तत्पराभवलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2015595, "chapter_id": 1328, "verse_number": "२-६९-४१", "content_sanskrit": "एतानि च निमित्तानि यानि चान्यानि भारत।\nकेशवादेव जायन्ते भौमानि च खगानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2015596, "chapter_id": 1328, "verse_number": "२-६९-४२", "content_sanskrit": "चन्द्रादित्यौ ग्रहाश्चैव नक्षत्राणि च भारत।\nवायुरग्निस्तथा चापः पृथिवी च जनार्दनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2015597, "chapter_id": 1328, "verse_number": "२-६९-४३", "content_sanskrit": "यस्य देशस्य हानिं वा वृद्धिं वा कर्तुमिच्छति।\nतस्मिन्देशे निमित्तानि तानि तानि करोत्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2015598, "chapter_id": 1328, "verse_number": "२-६९-४४", "content_sanskrit": "सोसौ चेदिपतेस्तात विनाशं समुपस्थितम्।\nनिवेदयति गोविन्दः स्वैरुपायैर्न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2015599, "chapter_id": 1328, "verse_number": "२-६९-४५", "content_sanskrit": "इयं प्रचलिता भूमिरशिवा वान्ति मारुताः।\nराहुश्चाप्यपतत्सोममपर्वणि विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2015600, "chapter_id": 1328, "verse_number": "२-६९-४६", "content_sanskrit": "सनिर्घाताः पतन्त्युल्कास्तमः सञ्जायते भृशम्।\nचेदिराजविनाशाय हरिरेष विजृम्भते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2015601, "chapter_id": 1328, "verse_number": "२-६९-४७x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2015602, "chapter_id": 1328, "verse_number": "२-६९-४७", "content_sanskrit": "एवमुक्त्वा तु देवर्षिर्नारदो विरराम ह।\nताभ्यां पुरुषसिंहाभ्यां तस्मिन्युद्ध उपस्थिते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2015603, "chapter_id": 1328, "verse_number": "२-६९-४८", "content_sanskrit": "ददृशुर्भूमिपालास्ते घोरानौत्पातिकान्बहून्॥\nतत्र वै दृश्यमानानां दिक्षु सर्वासु भारत।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2015604, "chapter_id": 1328, "verse_number": "२-६९-४९", "content_sanskrit": "अश्रूयन्त तदा राजञ्छिवानामशिवा रवाः॥\nररास च मही कृत्स्ना सवृक्षवनपर्वता।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2015605, "chapter_id": 1328, "verse_number": "२-६९-५०", "content_sanskrit": "अपर्वणि च मध्याह्ने मूर्यं स्वर्भानुरग्रसत्॥\nध्वजाग्रे चेदिराजस्य सर्वरत्नपरिष्कृते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2015606, "chapter_id": 1328, "verse_number": "२-६९-५१", "content_sanskrit": "अपतत्खाच्च्युतो गृध्रस्तीक्ष्णतुण्डः परन्तप॥\nआरण्यैः सहसा हृष्टा ग्राम्याश्च मृगपक्षिणः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2015607, "chapter_id": 1328, "verse_number": "२-६९-५२", "content_sanskrit": "चुक्रुशुर्भैरवं तत्र तस्मिन्युद्ध उपस्थिते॥\nएवमादिनि घोराणि भौमानि च स्वगानि च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2015608, "chapter_id": 1328, "verse_number": "२-६९-५३", "content_sanskrit": "औत्पातिकान्यदृश्यन्त सङ्क्रुद्धे शार्ङ्गधन्वनि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2015609, "chapter_id": 1328, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि शिशुपालवधपर्वणि एकोनसप्ततितमोऽध्यायः॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]