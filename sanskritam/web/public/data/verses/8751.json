[{"id": 900009586, "chapter_id": 8751, "verse_number": "3.1", "content_sanskrit": "सर्ववस्त्वात्मकत्वं च यदनन्तत्वमीरितम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900009587, "chapter_id": 8751, "verse_number": "3.2", "content_sanskrit": "प्रागुक्तज्ञानतामात्रं सर्वज्ञत्वेन यत्ततः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900009588, "chapter_id": 8751, "verse_number": "3.3", "content_sanskrit": "किं च निर्विकृतेरेव निमित्तत्वं परात्मनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900009589, "chapter_id": 8751, "verse_number": "3.4", "content_sanskrit": "लक्षणस्य तटस्थत्वकथापि व्याहता तव", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900009590, "chapter_id": 8751, "verse_number": "3.5", "content_sanskrit": "स च स्थित्यदनाभ्यां चेत्याह भेदं सयुक्तिकम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900009591, "chapter_id": 8751, "verse_number": "3.6", "content_sanskrit": "टीकानुसारतो ह्यर्थो मूलस्योन्नीयते बुधैः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900009592, "chapter_id": 8751, "verse_number": "3.7", "content_sanskrit": "शृणु देवि प्रवक्ष्यामि तामसानि यथाक्रमात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900009593, "chapter_id": 8751, "verse_number": "3.8", "content_sanskrit": "तस्माच्छैवब्राह्मणपक्षपुराणवचनाश्रयात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900009594, "chapter_id": 8751, "verse_number": "3.9", "content_sanskrit": "अहं भवान्न चान्यस्त्वं त्वमेवाहं विचक्ष्व भोः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900009595, "chapter_id": 8751, "verse_number": "3.10", "content_sanskrit": "यथोल्मुकाद्विष्फुलिङ्गाद्धूमाद्वापि स्वसम्भवात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900009596, "chapter_id": 8751, "verse_number": "3.11", "content_sanskrit": "मतिभेदोपि भेदे स्यान्नैकदैकस्य धीर्द्विधा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900009597, "chapter_id": 8751, "verse_number": "3.12", "content_sanskrit": "नित्यानामपि नित्यो यश्चेतनानां च चेतनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900009598, "chapter_id": 8751, "verse_number": "3.13", "content_sanskrit": "किञ्च सद्युक्तिपरशोरेकीभावो बिभेति ते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900009599, "chapter_id": 8751, "verse_number": "3.14", "content_sanskrit": "तदच्छेद्यं कथं छेद्यं भागे भागे त्वविद्यया", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900009600, "chapter_id": 8751, "verse_number": "3.15", "content_sanskrit": "अथ सर्वा व्यवस्थेयं दृश्यते केवलं जनैः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900009601, "chapter_id": 8751, "verse_number": "3.16", "content_sanskrit": "अथ सन्त्येव चैतन्यभागास्ते सर्वदेहगाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900009602, "chapter_id": 8751, "verse_number": "3.17", "content_sanskrit": "वेदस्तु सर्वं ब्रह्मेति सर्वस्याप्येकतां स्फुटम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900009603, "chapter_id": 8751, "verse_number": "3.18", "content_sanskrit": "श्रुतबाधितसंत्यागे भाष्यं दुर्भाष्यमेव ते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900009604, "chapter_id": 8751, "verse_number": "3.19", "content_sanskrit": "अल्पोल्पवित्तेऽप्यात्मानं वित्तेशं किं न मन्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900009605, "chapter_id": 8751, "verse_number": "3.20", "content_sanskrit": "शब्दसाम्येऽपि नार्थैक्यं यत्र चित्रचरित्रता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900009606, "chapter_id": 8751, "verse_number": "3.21", "content_sanskrit": "खल एव खलो लोके नासुरा वैरिवैरिणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900009607, "chapter_id": 8751, "verse_number": "3.22", "content_sanskrit": "बहुजीवत्वपक्षेऽपि निर्मूला तेष्वभिन्नता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900009608, "chapter_id": 8751, "verse_number": "3.23", "content_sanskrit": "अन्योन्याभावभेदोऽयं न ह्यसत्येषु मन्मते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900009609, "chapter_id": 8751, "verse_number": "3.24", "content_sanskrit": "अन्योन्याभावाभिधानं तत्त्वं न पृथगुक्तवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900009610, "chapter_id": 8751, "verse_number": "3.25", "content_sanskrit": "विमतौ जीवपरमौ विरुद