[{"id": 2115957, "chapter_id": 3496, "verse_number": "", "content_sanskrit": "गन्धर्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2115958, "chapter_id": 3496, "verse_number": "१", "content_sanskrit": "अथ तस्यामदृश्यायां नृपतिर्भावमोहितः ।\nपातनः शत्रुसङ्घानां पपात धरणीतळे \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2115959, "chapter_id": 3496, "verse_number": "२", "content_sanskrit": "तस्मिन् निपतिते भूमावथ सा चारुवर्णिनी ।\nपुनः पीनायतश्रोणी दर्शयामास तं नृपम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2115960, "chapter_id": 3496, "verse_number": "३", "content_sanskrit": "आबभाषेऽथ कल्याणी वाचा मधुरया नृपम् ।\nतं कुरूणां कुलकरं कामाभिहतचेतसम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2115961, "chapter_id": 3496, "verse_number": "४", "content_sanskrit": "उत्तिष्ठोत्तिष्ठ भद्रं ते न त्वमर्हस्यरिन्दम ।\nमोहं नृपतिशार्दूल मोघमाविष्कृतं कृतम् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2115962, "chapter_id": 3496, "verse_number": "", "content_sanskrit": "गन्धर्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2115963, "chapter_id": 3496, "verse_number": "५", "content_sanskrit": "एवमुक्तः स नृपतिर्वाचा मधुरया तदा ।\nददर्श विपुलश्रोणीं तामेवाभिमुखे स्थिताम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2115964, "chapter_id": 3496, "verse_number": "६", "content_sanskrit": "अथ तामसितापाङ्गीमाबभाषे नराधिपः ।\nमन्मथाभिपरीतात्मा सन्दिग्धाक्षरया गिरा \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2115965, "chapter_id": 3496, "verse_number": "७", "content_sanskrit": "साधु मामसितापाङ्गे कामार्तं मत्तकाशिनि ।\nभजस्वेह यथा नाहं प्राणान् जह्यां शुचिस्मिते \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2115966, "chapter_id": 3496, "verse_number": "८", "content_sanskrit": "त्वदर्थं हि विशालाक्षि मामयं निशितैः शरैः ।\nकामः कमलपत्राभे प्रतिविध्यन् न शाम्यति \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2115967, "chapter_id": 3496, "verse_number": "९", "content_sanskrit": "ग्रस्तमेवमनाक्रन्दं भद्रे काममहाहिना ।\nमां च पीनघनश्रोणि सञ्जीवयितुमर्हसि \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2115968, "chapter_id": 3496, "verse_number": "१०", "content_sanskrit": "त्वय्यधीनाश्च मे प्राणाः किन्नरोद्गीतभाषिणि ।\nचारुसर्वानवद्याङ्गी पद्मेन्दुसदृशानने \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2115969, "chapter_id": 3496, "verse_number": "११", "content_sanskrit": "न ह्यहं त्वामृते भीरु शक्ष्ये जीवितुमात्मना ।\nभक्तं मामसितापाङ्गे न परित्यक्तुमर्हसि\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2115970, "chapter_id": 3496, "verse_number": "१२", "content_sanskrit": "त्वं हि मां प्रीतियोगेन त्रातुमर्हसि भामिनि ।\nगान्धर्वेण च मां भीरु विवाहेनैहि सुन्दरि ।\nविवाहानां हि वामोरु गान्धर्वः श्रेष्ठ उच्यते \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2115971, "chapter_id": 3496, "verse_number": "", "content_sanskrit": "कन्या", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2115972, "chapter_id": 3496, "verse_number": "१३", "content_sanskrit": "नाहमीशाऽऽत्मनो राजन् कन्या पितृमती ह्यहम् ।\nमयि चेदस्ति ते प्रीतिर्याचस्व पितरं मम \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2115973, "chapter_id": 3496, "verse_number": "१४", "content_sanskrit": "यथा हि ते मया प्राणाः सम्भृताश्च नरेश्वर ।\nदर्शनादेव भूयस्त्वं तथा प्राणान् ममाहर \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2115974, "chapter_id": 3496, "verse_number": "१५", "content_sanskrit": "न चाहमीशा देवस्य तस्मान्नृपतिसत्तम ।\nसमीपं नोपगच्छामि न स्वतन्त्रा हि योषितः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2115975, "chapter_id": 3496, "verse_number": "१६", "content_sanskrit": "का हि सर्वेषु लोकेषु विश्रुताभिजनं नृपम् ।\nकन्या नाभिलषेन्नाथं भर्तारं भक्तवत्सलम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2115976, "chapter_id": 3496, "verse_number": "१७", "content_sanskrit": "तस्मादेवङ्गते काले याचस्व पितरं मम ।\nआदित्यं प्रणिपातेन तपसा नियमेन च \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2115977, "chapter_id": 3496, "verse_number": "१८", "content_sanskrit": "स चेत् कामयते दातुं तव मामरिमर्दन ।\nभविष्याम्यथ ते राजन् सततं वशवर्तिनी \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2115978, "chapter_id": 3496, "verse_number": "१९", "content_sanskrit": "अहं हि तपती नाम सावित्र्यवरजा सुता ।\nअस्य लोकप्रदीपस्य सवितुः क्षत्रियर्षभ \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2115979, "chapter_id": 3496, "verse_number": "१७५", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nपञ्चसप्तत्यधिकशततमोऽध्यायः ॥१७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2115980, "chapter_id": 3496, "verse_number": "८", "content_sanskrit": "॥ इति चैत्ररथपर्वणि अष्टमोऽध्यायः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2115981, "chapter_id": 3496, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]