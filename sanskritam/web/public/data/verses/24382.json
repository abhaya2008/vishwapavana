[{"id": 7004382000, "chapter_id": 24382, "verse_number": "५-३-७६-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nततो गच्छेत्तु राजेन्द्र पारेश्वरमनुत्तमम् ।\nपराशरो महात्मा वै नर्मदायास्तटे शुभे॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004382001, "chapter_id": 24382, "verse_number": "५-३-७६-२", "content_sanskrit": "तपश्चचार विपुलं पुत्रार्थं पाण्डुनन्दन ।\nहिमवद्दुहिता तेन गौरी नारायणी नृप॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004382002, "chapter_id": 24382, "verse_number": "५-३-७६-३", "content_sanskrit": "तोषिता परया भक्त्या नर्मदोत्तरके तटे ।\nतस्य तुष्टा महादेवी शङ्करार्धाङ्गधारिणी॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004382003, "chapter_id": 24382, "verse_number": "५-३-७६-४", "content_sanskrit": "भोभो ऋषिवर श्रेष्ठ तुष्टाहं तव भक्तितः ।\nवरं याचय मे विप्र पराशर महामते॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004382004, "chapter_id": 24382, "verse_number": "५-३-७६-५", "content_sanskrit": "पराशर उवाच ।\nपरितुष्टासि मे देवि यदि देयो वरो मम ।\nदेहि पुत्रं भगवति सत्यशौचगुणान्वितम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004382005, "chapter_id": 24382, "verse_number": "५-३-७६-६", "content_sanskrit": "वेदाभ्यसनशीलं हि सर्वशास्त्रविशारदम् ।\nतीर्थे चात्र भवेद्देवि सन्निधानवरेण तु॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004382006, "chapter_id": 24382, "verse_number": "५-३-७६-७", "content_sanskrit": "लोकोपकारहेतोश्च स्थीयतां गिरिनन्दिनि ।\nपराशराभिधानेन नर्मदादक्षिणे तटे॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004382007, "chapter_id": 24382, "verse_number": "५-३-७६-८", "content_sanskrit": "श्रीदेव्युवाच ।\nएवं भवतु ते विप्र तत्रैवान्तरधीयत ।\nपराशरो महात्मा वै स्थापयामास पार्वतीम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004382008, "chapter_id": 24382, "verse_number": "५-३-७६-९", "content_sanskrit": "शङ्करं स्थापयामास सुरासुरनमस्कृतम् ।\nअच्छेद्यमप्रतर्क्यं च देवानां तु दुरासदम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004382009, "chapter_id": 24382, "verse_number": "५-३-७६-१०", "content_sanskrit": "पराशरो महात्मा वै कृतार्थो ह्यभवन्नृप॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004382010, "chapter_id": 24382, "verse_number": "५-३-७६-११", "content_sanskrit": "तत्र तीर्थे तु यो भक्त्या शुचिः प्रयतमानसः ।\nस्त्र्यथवा पुरुषो वापि कामक्रोधविवर्जितः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004382011, "chapter_id": 24382, "verse_number": "५-३-७६-१२", "content_sanskrit": "माघे चैत्रेऽथ वैशाखे श्रावणे नृपनन्दन ।\nमासि मार्गशिरे चैव शुक्लपक्षे तु सर्वदा॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004382012, "chapter_id": 24382, "verse_number": "५-३-७६-१३", "content_sanskrit": "तत्र गत्वा शुभे स्थाने नर्मदादक्षिणे तटे॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004382013, "chapter_id": 24382, "verse_number": "५-३-७६-१४", "content_sanskrit": "उपोष्य परया भक्त्या व्रतमेतत्समाचरेत् ।\nरात्रौ जागरणं कृत्वा दीपदानं स्वशक्तितः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004382014, "chapter_id": 24382, "verse_number": "५-३-७६-१५", "content_sanskrit": "गीतं नृत्यं तथा वाद्यं कामक्रोधविवर्जितः ।\nप्रभाते विमले प्राप्ते द्विजाः पूज्याः स्वशक्तितः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004382015, "chapter_id": 24382, "verse_number": "५-३-७६-१६", "content_sanskrit": "सम्पूज्य ब्राह्मणान् पार्थ धनदानहिरण्यतः ।\nवस्त्रेण छत्रदानेन शय्याताम्बूलभोजनैः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004382016, "chapter_id": 24382, "verse_number": "५-३-७६-१७", "content_sanskrit": "प्रीणयेन्नर्मदातीरे ब्राह्मणाञ्छंसितव्रतान् ।\nश्राद्धं कार्यं नृपश्रेष्ठ आमैः पक्वैर्जलेन च॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004382017, "chapter_id": 24382, "verse_number": "५-३-७६-१८", "content_sanskrit": "स्त्रीणां चैव तु शूद्राणामामश्राद्धं प्रशस्यते ।\nआमं चतुर्गुणं देयं ब्राह्मणानां युधिष्ठिर॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004382018, "chapter_id": 24382, "verse_number": "५-३-७६-१९", "content_sanskrit": "वेदोक्तेन विधानेन द्विजाः पूज्याः प्रयत्नतः ।\nहस्तमात्रैः कुशैश्चैव तिलैश्चैवाक्षतैर्नृप॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004382019, "chapter_id": 24382, "verse_number": "५-३-७६-२०", "content_sanskrit": "विप्रा उदङ्मुखाः कार्याः स्वयं वै दक्षिणामुखः ।\nदर्भेषु निक्षिपेदन्नमित्युच्चार्य द्विजाग्रतः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004382020, "chapter_id": 24382, "verse_number": "५-३-७६-२१", "content_sanskrit": "प्रेता यान्तु परे लोके तीर्थस्यास्य प्रभावतः ।\nपापं मे प्रशमं यातु एतु वृद्धिं शुभं सदा॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004382021, "chapter_id": 24382, "verse_number": "५-३-७६-२२", "content_sanskrit": "वृद्धिं यातु सदा वंशो ज्ञातिवर्गो द्विजोत्तम ।\nएवमुच्चार्य विप्राय दानं देयं स्वशक्तितः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004382022, "chapter_id": 24382, "verse_number": "५-३-७६-२३", "content_sanskrit": "गोभूतिसहिरण्यादि चान्नं वस्त्रं स्वशक्तितः ।\nदातव्यं पाण्डवश्रेष्ठ पारेश्वरवराश्रमे॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004382023, "chapter_id": 24382, "verse_number": "५-३-७६-२४", "content_sanskrit": "ये शृण्वन्ति परं भक्त्या मुच्यन्ते सर्वपातकैः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]