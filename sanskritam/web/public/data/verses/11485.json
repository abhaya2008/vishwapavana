[{"id": 50012122, "chapter_id": 11485, "verse_number": "1", "content_sanskrit": "राजोवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50012123, "chapter_id": 11485, "verse_number": "2", "content_sanskrit": "यस्य हेतोः परित्यक्ता आचार्येणात्मनः सुराः। एतदाचक्ष्व भगवन् शिष्याणामक्रमं गुरोः॥ ६/७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50012124, "chapter_id": 11485, "verse_number": "3", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50012125, "chapter_id": 11485, "verse_number": "4", "content_sanskrit": "इन्द्रस्त्रिभुवनैश्वर्यमदोल्लङ्घितसत्पथः। मरुद्भिर्वसुभी रुद्रैरादित्यैऋर्भुभिर्नृप॥ ६/७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50012126, "chapter_id": 11485, "verse_number": "5", "content_sanskrit": "विश्वेदेवैश्च साध्यैश्च नासत्याभ्यां परिश्रितः। सिद्धचारणगन्धर्वैर्मुनिभिर्ब्रह्मवादिभिः॥ ६/७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50012127, "chapter_id": 11485, "verse_number": "6", "content_sanskrit": "विद्याधराप्सरोभिश्च किन्नरैः पतगोरगैः। निषेव्यमाणो भगवान् स्तूयमानश्च भारत॥ ६/७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50012128, "chapter_id": 11485, "verse_number": "7", "content_sanskrit": "उपगीयमानो लिळतमास्थानाध्यासनाश्रितः। पाण्डुरेणातपत्रेण चन्द्रमण्डलचारुणा॥ ६/७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50012129, "chapter_id": 11485, "verse_number": "8", "content_sanskrit": "युक्तश्चान्यैः पारमेष्ठ्यैश्चामरव्यजनादिभिः। विराजमानः पौलोम्या सहार्धासनया भृशम्॥ ६/७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50012130, "chapter_id": 11485, "verse_number": "9", "content_sanskrit": "स यदा परमाचार्यं देवानामात्मनश्च ह। नाभ्यनन्दत सम्प्राप्तं प्रत्युत्थानासनादिभिः॥ ६/७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50012131, "chapter_id": 11485, "verse_number": "10", "content_sanskrit": "वाचस्पतिं मुनिवरं सुरासुरनमस्कृतम्। नोच्चचालासनादिन्द्रः पश्यन्नपि समागतम्॥ ६/७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50012132, "chapter_id": 11485, "verse_number": "11", "content_sanskrit": "ततो निर्गत्य सहसा कविराङ्गिरसः प्रभुः। आययौ स्वगृहं तूष्णीं विद्वान् श्रीमदविक्रियाम्॥ ६/७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50012133, "chapter_id": 11485, "verse_number": "12", "content_sanskrit": "तर्ह्येव प्रतिबुध्येन्द्रो गुरुहेळनमात्मनः। गर्हयामास सदसि स्वयमात्मानमात्मना॥ ६/७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50012134, "chapter_id": 11485, "verse_number": "13", "content_sanskrit": "अहो बत मयाऽसाधु कृतं वै दभ्रबुद्धिना। यन्मयैश्वर्यमत्तेन गुरुः सदसि कात्कृतः॥ ६/७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50012135, "chapter_id": 11485, "verse_number": "14", "content_sanskrit": "को गृध्द्येत् पण्डितो लक्ष्मीं त्रिविष्टपपतेरपि। ययाऽहमासुरं भावं नीतोऽद्य विबुधेश्वरः॥ ६/७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50012136, "chapter_id": 11485, "verse_number": "15", "content_sanskrit": "ये पारमेष्ठ्यधिषणमधितिष्ठन् न कञ्चन। प्रत्युत्तिष्ठेदिति ब्रूयुर्धर्मं ते न परं विदुः॥ ६/७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50012137, "chapter_id": 11485, "verse_number": "16", "content_sanskrit": "तेषां कुपथदेष्टॄणां पततां तमसि ह्यधः। ये श्रद्धध्युर्वचस्ते वै मज्जन्त्यश्मप्लवा इव॥ ६/७/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50012138, "chapter_id": 11485, "verse_number": "17", "content_sanskrit": "अथाहममराचार्यमगाधधिषणं द्विजम्। प्रसादयिष्ये निशठः शीर्ष्णा तच्चरणं स्पृशन्॥ ६/७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50012139, "chapter_id": 11485, "verse_number": "18", "content_sanskrit": "एवं चिन्तयतस्तस्य मघोनो भगवान् गृहात्। बृहस्पतिर्गतोऽदृष्टां गतिमध्यात्ममायया॥ ६/७/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50012140, "chapter_id": 11485, "verse_number": "19", "content_sanskrit": "गुरोर्नाधिगतः सञ्ज्ञां परीक्षन् भगवान् स्वराट्। ध्यायन् धिया शुचा युक्तः शर्म नालभतात्मनः॥ ६/७/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50012141, "chapter_id": 11485, "verse_number": "20", "content_sanskrit": "तच्छ्रुत्वैवासुराः सर्व आश्रित्यौशनसं मतम्। देवान् प्रत्युद्यमं चक्रुर्दुर्मदा आततायिनः॥ ६/७/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50012142, "chapter_id": 11485, "verse_number": "21", "content_sanskrit": "तैर्विसृष्टेषुभिस्तीक्ष्णैर्निर्भिण्णाङ्गोरुबाहवः। ब्रह्माणं शरणं जग्मुः सहेन्द्रा नतकन्धराः॥ ६/७/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50012143, "chapter_id": 11485, "verse_number": "22", "content_sanskrit": "तांस्तथाऽभ्यर्दितान् वीक्ष्य भगवानात्मभूरजः। कृपया परया देव उवाच परिसान्त्वयन्॥ ६/७/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50012144, "chapter_id": 11485, "verse_number": "23", "content_sanskrit": "ब्रह्मोवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50012145, "chapter_id": 11485, "verse_number": "24", "content_sanskrit": "अहो बत सुरश्रेष्ठा ह्यभद्रं वः कृतं महत्। ब्रह्मिष्ठं ब्राह्मणं दान्तमैश्वर्यान्नाभ्यनन्दत॥ ६/७/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50012146, "chapter_id": 11485, "verse_number": "25", "content_sanskrit": "तस्यायमनयस्यासीत् परेभ्यो वः पराभवः। प्रक्षीणेभ्यः सपत्नेभ्यः समृद्धानां च यत् सुराः॥ ६/७/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50012147, "chapter_id": 11485, "verse_number": "26", "content_sanskrit": "मघवन् द्विषतः पश्य प्रक्षीणान् गुर्वतिक्रमात्। सम्प्रत्युपचितान् भूयः काव्यमाराध्य भक्तितः॥ आददीरन् निलयनं ममापि भृगुदेवताः॥ ६/७/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50012148, "chapter_id": 11485, "verse_number": "27", "content_sanskrit": "त्रिविष्टपं किं गणयन्त्यभेद्यं मन्त्रा भृगूणामनुशिक्षितार्थाः। न विप्रगोविन्दगवीश्वराणां भवन्त्यभद्राणि नरेश्वराणाम्॥ ६/७/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50012149, "chapter_id": 11485, "verse_number": "28", "content_sanskrit": "तद् विश्वरूपं भजताशु विप्रं तपस्विनं त्वाष्ट्रमथात्मवन्तम्। सभाजितोऽर्थान् स विधास्यते वो यदि क्षमध्वं यदुतास्य कर्म॥ ६/४/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50012150, "chapter_id": 11485, "verse_number": "29", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50012151, "chapter_id": 11485, "verse_number": "30", "content_sanskrit": "त एवमुदिता राजन् ब्रह्मणा विगतज्वराः। ऋषिं त्वाष्ट्रमुपव्रज्य परिष्वज्येदमब्रुवन्॥ ६/७/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50012152, "chapter_id": 11485, "verse_number": "31", "content_sanskrit": "देवा ऊचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50012153, "chapter_id": 11485, "verse_number": "32", "content_sanskrit": "वयं तेऽतिथयः प्राप्ता आश्रमं भद्रमस्तु ते। कामः सम्पाद्यतां तात पितॄणां समयोचितः॥ ६/७/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50012154, "chapter_id": 11485, "verse_number": "33", "content_sanskrit": "पुत्राणां हि परो धर्मः पितृशुश्रूषणं सताम्। अपि पुत्रवतां ब्रह्मन् किमुत ब्रह्मचारिणाम्॥ ६/७/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50012155, "chapter_id": 11485, "verse_number": "34", "content_sanskrit": "आचार्यो ब्रह्मणो मूर्तिः पिता मूर्तिः प्रजापतेः। भ्राता मरुत्पतेर्मूर्तिर्माता साक्षात् क्षितेस्तनुः॥ ६/७/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50012156, "chapter_id": 11485, "verse_number": "35", "content_sanskrit": "दयाया भगिनी मूर्तिर्धर्मस्यात्माऽतिथिः स्वयम्। अग्नेरभ्यागतो मूर्तिः सर्वभूतानि चात्मनः॥ ६/७/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50012157, "chapter_id": 11485, "verse_number": "36", "content_sanskrit": "तस्मात् पितॄणामार्तानामार्तिं परपराभवम्। तपसाऽपनयन् तात सन्देशं कर्तुमर्हसि॥ ६/७/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50012158, "chapter_id": 11485, "verse_number": "37", "content_sanskrit": "वृणीमहे त्वोपाध्यायं ब्रह्मिष्ठं ब्राह्मणं गुरुम्। यथाऽञ्जसा विजेष्यामः सपत्नांस्तव तेजसा॥ ६/७/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50012159, "chapter_id": 11485, "verse_number": "38", "content_sanskrit": "न गर्हयन्ति ह्यर्थेषु यविष्ठङ्घ्रायभिवादनम्। छन्दोभ्योन्यत्र न ब्रह्मन् वयो ज्यैष्ठ्यस्य कारणम्॥ ६/७/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50012160, "chapter_id": 11485, "verse_number": "39", "content_sanskrit": "ऋषिरुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50012161, "chapter_id": 11485, "verse_number": "40", "content_sanskrit": "अभ्यर्थितः सुरगणैः पौरोहित्ये महातपाः। स विश्वरूपस्तानाह प्रसन्नः श्लक्ष्णया गिरा॥ ६/७/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50012162, "chapter_id": 11485, "verse_number": "41", "content_sanskrit": "विश्वरूप उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50012163, "chapter_id": 11485, "verse_number": "42", "content_sanskrit": "विगर्हितं धर्मशीलैर्ब्रह्मवर्चौपव्ययम्। कथं नु मद्विधो नाथा लोकेशैरभियाचितः। प्रत्याख्यास्यति तच्छिष्यः स एव स्वार्थ उच्यते॥ ६/७/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50012164, "chapter_id": 11485, "verse_number": "43", "content_sanskrit": "अकिञ्चनानां हि धनं सिलोञ्छनं तेनैव निर्वर्तितसाधुसत्क्रियः। कथं विगर्ह्यं तु करोम्यधीश्वराः पौरोधसं हृष्यति येन दुर्मतिः॥ ६/७/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50012165, "chapter_id": 11485, "verse_number": "44", "content_sanskrit": "तथाऽपि न प्रतिब्रूयां गुरुभिः प्रार्थितं कियत्। भवतां प्रार्थितं सर्वं प्राणैरर्थैश्च साधये॥ ६/७/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 50012166, "chapter_id": 11485, "verse_number": "45", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 50012167, "chapter_id": 11485, "verse_number": "46", "content_sanskrit": "तेभ्य एवं प्रतिश्रुत्य विश्वरूपो महातपाः। पौरोहित्यं ततश्चक्रे परमेण समाधिना॥ ६/७/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 50012168, "chapter_id": 11485, "verse_number": "47", "content_sanskrit": "सुरद्विषां श्रियं गुप्तामौशनस्याऽपि विद्यया। आच्छिद्यादान्महेन्द्राय वैष्णव्या विद्यया विभुः॥ ६/७/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 50012169, "chapter_id": 11485, "verse_number": "48", "content_sanskrit": "यया गुप्तः सहस्राक्षो जिग्येऽसुरचमूर्विभुः। तां प्राह स महेन्द्राय विश्वरूप उदारधीः॥ ६/७/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 50012170, "chapter_id": 11485, "verse_number": "49", "content_sanskrit": "यां प्रविश्यासुराञ्छश्वत् कक्ष्यां नारायणात्मिकाम्। अजैषीद् वृषभस्तात सिंहः क्षुद्रमृगानिव॥ ६/७/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 50012171, "chapter_id": 11485, "verse_number": "50", "content_sanskrit": "इति श्रीमद्भागवते षष्ठस्कन्धे सप्तमोऽध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]