[{"id": 2168171, "chapter_id": 4608, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2168172, "chapter_id": 4608, "verse_number": "१", "content_sanskrit": "युधिष्ठिरं महाराज विसृजन्तं शरान् बहून् ।\nस्वयं दुर्योधनो राजा प्रत्यगृह्णादभीतवत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2168173, "chapter_id": 4608, "verse_number": "२", "content_sanskrit": "तमापतन्तं सहसा तव पुत्रं महारथम् ।\nधर्मराजो द्रुतं विद्ध्वा तिष्ठ तिष्ठेति चाब्रवीत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2168174, "chapter_id": 4608, "verse_number": "३", "content_sanskrit": "स तु तं प्रतिविव्याध नवभिर्निशितैः शरैः ।\nसारथिं चास्य भल्लेन भृशं क्रुद्धोऽभ्यताडयत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2168175, "chapter_id": 4608, "verse_number": "४", "content_sanskrit": "ततो युधिष्ठिरो राजन् स्वर्णपुङ्खान् शिलीमुखान् ।\nदुर्योधनाय चिक्षेप त्रयोदश शिलाशितान्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2168176, "chapter_id": 4608, "verse_number": "५", "content_sanskrit": "चतुर्भिश्चतुरो वाहांस्तस्य हत्वा महारथः ।\nपञ्चमेन शिरः कायात् सारथेश्च समाक्षिपत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2168177, "chapter_id": 4608, "verse_number": "६", "content_sanskrit": "षष्ठेन तु ध्वजं राज्ञः सप्तमेन तु कार्मुकम् ।\nअष्टमेन तथा खड्गं पातयामास भूतळे\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2168178, "chapter_id": 4608, "verse_number": "७", "content_sanskrit": "पञ्चभिर्नृपतिं चापि धर्मराजोऽर्दयद् भृशम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2168179, "chapter_id": 4608, "verse_number": "८", "content_sanskrit": "हताश्वात्तु रथात्तस्मादवप्लुत्य सुतस्तव ।\nउत्तमं व्यसनं प्राप्तो भूमावेवावतिष्ठत\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2168180, "chapter_id": 4608, "verse_number": "९", "content_sanskrit": "तं तु कृच्छ्रगतं दृष्ट्वा कर्णद्रौणिकृपादयः ।\nअभ्यवर्तन्त सहसा परीप्सन्तो नराधिपम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2168181, "chapter_id": 4608, "verse_number": "१०", "content_sanskrit": "अथ पाण्डुसुताः सर्वे परिवार्य युधिष्ठिरम् ।\nअन्वयुः समरे राजन् ततो युद्धमवर्तत\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2168182, "chapter_id": 4608, "verse_number": "११", "content_sanskrit": "ततस्तूर्यसहस्राणि प्रावाद्यन्त महामृधे\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2168183, "chapter_id": 4608, "verse_number": "१२", "content_sanskrit": "क्ष्वेलाः किलकिलाशब्दाः प्रादुरासन् महीपते ।\nयत्राभ्यगच्छन् समरे पाञ्चालाः कौरवैः सह\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2168184, "chapter_id": 4608, "verse_number": "१३", "content_sanskrit": "नरा नरैः समाजग्मुर्वारणा वरवारणैः ।\nरथाश्च रथिभिः सार्धं हयाश्च हयसादिभिः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2168185, "chapter_id": 4608, "verse_number": "१४", "content_sanskrit": "द्वन्द्वान्यासन् महाराज प्रेक्षणीयानि संयुगे ।\nविविधान्यप्यचिन्त्यानि शस्त्रवन्त्युत्तमानि च\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2168186, "chapter_id": 4608, "verse_number": "१५", "content_sanskrit": "ते शूराः समरे सर्वे चित्रं लघु च सुष्ठु च ।\nअयुध्यन्त महावेगाः परस्परवधैषिणः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2168187, "chapter_id": 4608, "verse_number": "१६", "content_sanskrit": "अन्योन्यं समरे जघ्नुर्योधव्रतमनुष्ठिताः ।\nन हि ते समरं चक्रुः पृष्ठतो वै कथञ्चन\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2168188, "chapter_id": 4608, "verse_number": "१७", "content_sanskrit": "मुहूर्तमेव तद्युद्धमासीन्मधुरदर्शनम् ।\nतत उन्मत्तवद् राजन्निर्मर्यादमवर्तत\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2168189, "chapter_id": 4608, "verse_number": "१८", "content_sanskrit": "रथी नागं समासाद्य दारयन्निशितैः शरैः ।\nप्रेषयामास कालाय शरैः सन्नतपर्वभिः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2168190, "chapter_id": 4608, "verse_number": "१९", "content_sanskrit": "नागा हयान् समासाद्य विक्षिपन्तो बहून् रणे ।\nदारयामासुरत्युग्रं तत्र तत्र तदा तदा\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2168191, "chapter_id": 4608, "verse_number": "२०", "content_sanskrit": "हयारोहाश्च बहवः परिवार्य गजोत्तमान् ।\nतळशब्दरवांश्चक्रुः सम्पतन्तस्ततस्ततः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2168192, "chapter_id": 4608, "verse_number": "२१", "content_sanskrit": "धावमानांस्ततस्तांस्तु युद्ध्यमानान् महागजान् ।\nपार्श्वतः पृष्ठतश्चैव निजघ्नुर्हयसादिनः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2168193, "chapter_id": 4608, "verse_number": "२२", "content_sanskrit": "विद्राव्य च बहूनश्वान्नागा राजन् मदोत्कटाः ।\nविषाणैश्चापरे जघ्नुर्ममृदुश्चापरे भृशम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2168194, "chapter_id": 4608, "verse_number": "२३", "content_sanskrit": "साश्वारोहांश्च तुरगान् विषाणैर्विव्यधू रुषा ।\nअपरे चिक्षिपुर्वेगात् प्रगृह्यातिबलास्तदा\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2168195, "chapter_id": 4608, "verse_number": "२४", "content_sanskrit": "पदातैराहता नागा विवरेषु समन्ततः ।\nचक्रुरार्तस्वरं घोरं दुद्रुवुश्च दिशो दश\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2168196, "chapter_id": 4608, "verse_number": "२५", "content_sanskrit": "पदातीनां तु सहसा प्रद्रुतानां महाहवे ।\nउत्सृज्य च रणं तूर्णमववव्रू रणाजिरे\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2168197, "chapter_id": 4608, "verse_number": "२६", "content_sanskrit": "निमित्तं मन्यमानास्तु परिणाम्य महागजाः ।\nजगृहुर्बिभिदुश्चैव चित्राण्याभरणानि च\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2168198, "chapter_id": 4608, "verse_number": "२७", "content_sanskrit": "तांस्तु तत्र प्रसक्तान् वै परिवार्य पदातयः ।\nहस्त्यारोहान्निजघ्नुस्ते महावेगा बलोत्कटाः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2168199, "chapter_id": 4608, "verse_number": "२८", "content_sanskrit": "अपरे हस्तिभिर्हस्तैः खं विक्षिप्ता महाहवे ।\nनिपतन्तो विषाणाग्रैर्भृशं विद्धा सुशिक्षितैः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2168200, "chapter_id": 4608, "verse_number": "२९", "content_sanskrit": "अपरे सहसा गृह्य विषाणैरेव सूदिताः ।\nसेनान्तरं समासाद्य केचित्तत्र महागजैः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2168201, "chapter_id": 4608, "verse_number": "३०", "content_sanskrit": "क्षुण्णगात्रा महाराज विक्षिप्य च पुनः पुनः ।\nअपरे व्यजनानीव बिभ्राम्य निहता मृधे\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2168202, "chapter_id": 4608, "verse_number": "३१", "content_sanskrit": "पुरोगमैश्च नागानामपरेषां विशाम्पते ।\nशरीराण्यतिविद्धानि तत्र तत्र रणाजिरे\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2168203, "chapter_id": 4608, "verse_number": "३२", "content_sanskrit": "प्रतिमानेषु कुम्भेषु दन्तवेष्टेषु चापरे ।\nनिगृहीता भृशं नागाः प्रासतोमरशक्तिभिः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2168204, "chapter_id": 4608, "verse_number": "३३", "content_sanskrit": "निगृह्य च गजाः केचित् पार्श्वस्थैर्भृशदारुणैः ।\nरथाश्वसादिभिस्तत्र सम्भिन्ना न्यपतन् भुवि\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2168205, "chapter_id": 4608, "verse_number": "३४", "content_sanskrit": "सरथं सादिनं तत्र अपरे ते महागजाः ।\nभूमावमृद्नन् वेगेन सवर्माणं पदातिनम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2168206, "chapter_id": 4608, "verse_number": "३५", "content_sanskrit": "तथा सावरणान् कांश्चित् तत्र तत्र विशाम्पते ।\nरथान्नागाः समासाद्य परिगृह्य च मारिष\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2168207, "chapter_id": 4608, "verse_number": "३६", "content_sanskrit": "व्याक्षिपन् सहसा तत्र घोररूपे महामृधे\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2168208, "chapter_id": 4608, "verse_number": "३७", "content_sanskrit": "नाराचैर्निहताश्चापि गजाः पेतुर्महाबलाः ।\nगिरीणां शिखराणीव वज्ररुग्णानि भूतळे\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2168209, "chapter_id": 4608, "verse_number": "३८", "content_sanskrit": "योधा योधान् समासाद्य मुष्टिभिर्व्यहनन्युधि ।\nकेशेष्वन्योन्यमाक्षिप्य चिक्षिपुर्बिभिदुश्च ह\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2168210, "chapter_id": 4608, "verse_number": "३९", "content_sanskrit": "उत्पाट्य च भुजानन्यो निक्षिप्य च महीतळे ।\nपदा चोरःसमाक्रम्य स्फुरतोऽपाहरच्छिरः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2168211, "chapter_id": 4608, "verse_number": "४०", "content_sanskrit": "(पततश्चापरो राजन् विजहारासिना शिरः ।)\nमृतमन्यो महाराज पदा ताडितवांस्तदा\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2168212, "chapter_id": 4608, "verse_number": "४१", "content_sanskrit": "जीवतश्च तथैवान्यः शस्त्रं काये न्यमज्जयत् ।\nमुष्टियुद्धं महच्चासीद् योधानां तत्र भारत\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2168213, "chapter_id": 4608, "verse_number": "४२", "content_sanskrit": "तथा केशग्रहश्चोग्रो बाहुयुद्धं च भैरवम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2168214, "chapter_id": 4608, "verse_number": "४३", "content_sanskrit": "समासक्तस्य चान्येन अविज्ञातस्तथाऽपरः ।\nजहार समरे प्राणान्नानाशस्त्रैरनेकशः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2168215, "chapter_id": 4608, "verse_number": "४४", "content_sanskrit": "संसक्तेषु च योधेषु वर्तमाने च सङ्कुले ।\nकबन्धान्युत्थितानि स्म शतशोऽथ सहस्रशः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2168216, "chapter_id": 4608, "verse_number": "४५", "content_sanskrit": "शोणितैः सिच्यमानानि शस्त्राणि कवचानि च ।\nमहारजनरक्तानि वस्त्राणीव चकाशिरे\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2168217, "chapter_id": 4608, "verse_number": "४६", "content_sanskrit": "एवमेतन्महद् युद्धं दारुणं शस्त्रसङ्कुलम् ।\nउन्मत्तरङ्गप्रतिमं शब्देनापूरयज्जगत्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2168218, "chapter_id": 4608, "verse_number": "४७", "content_sanskrit": "नैव स्वे न परे राजन् विज्ञायन्ते महारणे ।\nयोद्धव्यमिति युध्यन्ते राजानो जयगृद्धिनः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2168219, "chapter_id": 4608, "verse_number": "४८", "content_sanskrit": "स्वान् स्वे जघ्नुर्महाराज परांश्चैव समागतान् ।\nउभयोः सेनयोर्वीरैर्व्याकुलं समपद्यत\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2168220, "chapter_id": 4608, "verse_number": "४९", "content_sanskrit": "रथैर्भग्नैर्महाराज वारणैश्च निपातितैः ।\nहयैश्च पतितैस्तत्र नरैश्च विनिपातितैः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2168221, "chapter_id": 4608, "verse_number": "५०", "content_sanskrit": "अगम्यरूपा पृथिवी क्षणेन समपद्यत ।\nक्षणेनासीन्महीपाल क्षतजौघप्रवर्तिनी\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2168222, "chapter_id": 4608, "verse_number": "५१", "content_sanskrit": "पाञ्चालानहनत् कर्णस्त्रिगर्तांश्च धनञ्जयः ।\nभीमसेनः कुरून् राजन् हस्त्यनीकं च सर्वशः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2168223, "chapter_id": 4608, "verse_number": "५२", "content_sanskrit": "एवमेव क्षयो वृत्तः कुरुपाण्डवसेनयोः ।\nअपराह्णे गते सूर्ये काङ्क्षन्त्योर्विपुलं यशः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2168224, "chapter_id": 4608, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nअष्टाविंशोऽध्यायः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2168225, "chapter_id": 4608, "verse_number": "", "content_sanskrit": "––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]