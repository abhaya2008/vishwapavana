[{"id": 2148977, "chapter_id": 4225, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2148978, "chapter_id": 4225, "verse_number": "१", "content_sanskrit": "एतस्मिन्नेव काले तु भीष्मकस्य महात्मनः ।\nहिरण्यरोम्णो नृपतेः साक्षादिन्द्रसखस्य वै\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2148979, "chapter_id": 4225, "verse_number": "२", "content_sanskrit": "आहृतीनामधिपतेः भोजस्यातियशस्विनः ।\nदाक्षिणात्यपतेः पुत्रो दिक्षु रुग्मीति विश्रुतः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2148980, "chapter_id": 4225, "verse_number": "३", "content_sanskrit": "यः किम्पुरुषसिंहस्य गन्धमादनवासिनः ।\nकृत्स्नं शिष्यो धनुर्वेदं चतुष्पादमवाप्तवान्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2148981, "chapter_id": 4225, "verse_number": "४", "content_sanskrit": "यो माहेन्द्रं धनुर्लेभे तुल्यं गाण्डीवतेजसा ।\nशार्ङ्गेण च महाबाहुः सम्मितं दिव्यमक्षयम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2148982, "chapter_id": 4225, "verse_number": "५", "content_sanskrit": "त्रीण्येवैतानि दिव्यानि धनूंषि दिविचारिणाम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2148983, "chapter_id": 4225, "verse_number": "६", "content_sanskrit": "वारुणं गाण्डिवं तत्र माहेन्द्रं विजयं धनुः ।\nशार्ङ्गं तु वैष्णवं प्राहुः दिव्यं तेजोमयं धनुः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2148984, "chapter_id": 4225, "verse_number": "७", "content_sanskrit": "धारयामास तत् कृष्णः परसेनाभयावहम् ।\nगाण्डिवं पावकाल्लेभे खाण्डवे पाकशासनिः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2148985, "chapter_id": 4225, "verse_number": "८", "content_sanskrit": "द्रुमाद् रुग्मी महातेजा विजयं प्रत्यपद्यत\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2148986, "chapter_id": 4225, "verse_number": "९", "content_sanskrit": "सञ्छिद्य मौरवान् पाशान् निहत्य मुरजोजसा ।\nनिर्जित्य नरकं भौममाहृत्य मणिकुण्डले\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2148987, "chapter_id": 4225, "verse_number": "१०", "content_sanskrit": "षोडश स्त्रीसहस्राणि रत्नानि विविधानि च ।\nप्रतिपेदे हृषीकेशः शार्ङ्गं च धनुरुत्तमम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2148988, "chapter_id": 4225, "verse_number": "११", "content_sanskrit": "रुग्मी तु विजयं लब्ध्वा धनुर्मेघनिभस्वनम् ।\nविभीषयन्निव जगत् पाण्डवानभ्यवर्तत\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2148989, "chapter_id": 4225, "verse_number": "१२", "content_sanskrit": "नामृष्यत पुरा योऽसौ स्वबाहुबलदर्पितः ।\nरुग्मिण्या हरणं वीरो वासुदेवेन धीमता\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2148990, "chapter_id": 4225, "verse_number": "१३", "content_sanskrit": "कृत्वा प्रतिज्ञां नाहत्वा निवर्तिष्ये जनार्दनम् ।\nततोऽन्वधावद् वार्ष्णेयं सर्वशस्त्रभृतां वरः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2148991, "chapter_id": 4225, "verse_number": "१४", "content_sanskrit": "सेनया चतुरङ्गिण्या महत्या दूरपातया ।\nविचित्रायुधवर्मिण्या गङ्गयेव प्रवृद्धया\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2148992, "chapter_id": 4225, "verse_number": "१५", "content_sanskrit": "स समासाद्य वार्ष्णेयं योगानामीश्वरं प्रभुम् ।\nव्यंसितो व्रीडितो राजा नाजगाम स कुण्डिनम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2148993, "chapter_id": 4225, "verse_number": "१६", "content_sanskrit": "यत्रैव कृष्णेन रणे निर्जितः परवीरहा ।\nतत्र भोजकटं नाम कृतं नगरमुत्तमम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2148994, "chapter_id": 4225, "verse_number": "१७", "content_sanskrit": "सैन्येन महता तेन प्रभूतगजवाजिना ।\nपुरं तद् भुवि विख्यातं नाम्ना भोजकटं नृप\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2148995, "chapter_id": 4225, "verse_number": "१८", "content_sanskrit": "स भोजराजः सैन्येन महता परिवारितः ।\nअक्षोहिण्या महावीर्यः पाण्डवं क्षिप्रमागतम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2148996, "chapter_id": 4225, "verse_number": "१९", "content_sanskrit": "ततः स कवची खड्गी तळी धन्वी शरी रथी ।\nरथेनादित्यवर्णेन प्रविवेश महाचमूम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2148997, "chapter_id": 4225, "verse_number": "२०", "content_sanskrit": "विदितः पाण्डवेयानां वासुदेवप्रियेप्सया ।\nयुधिष्ठिरस्तु तं राजा प्रत्युद्गम्याभ्यपूजयत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2148998, "chapter_id": 4225, "verse_number": "२१", "content_sanskrit": "स पूजितः पाण्डुसुतैर्यथान्यायं सुसत्कृतः ।\nप्रतिपूज्य च तान् सर्वान् विश्रान्तः सहसैनिकः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2148999, "chapter_id": 4225, "verse_number": "२२", "content_sanskrit": "उवाच मध्ये वीराणां कुन्तीपुत्रं धनञ्जयम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2149000, "chapter_id": 4225, "verse_number": "२३", "content_sanskrit": "साहाय्येऽस्मि स्थितो युद्धे यदि भीतोऽसि पाण्डव ।\nकरिष्यामि रणे साँह्यमसँह्यं तव शत्रुभिः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2149001, "chapter_id": 4225, "verse_number": "२४", "content_sanskrit": "न हि मे विक्रमे तुल्यः पुमानस्तीह कश्चन ।\nहरिष्यामि रणे भागं यन्मे दास्यसि पाण्डव\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2149002, "chapter_id": 4225, "verse_number": "२५", "content_sanskrit": "अपि द्रोणकृपौ वीरौ भीष्मकर्णावथो पुनः ।\nअथवा सर्व एवैते तिष्ठन्तु वसुधाधिपाः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2149003, "chapter_id": 4225, "verse_number": "२६", "content_sanskrit": "निहत्य समरे शत्रून् तव दास्यामि फल्गुन\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2149004, "chapter_id": 4225, "verse_number": "२७", "content_sanskrit": "इत्युक्तो धर्मराजस्य केशवस्य च सन्निधौ ।\nशृण्वतां पार्थिवेन्द्राणामन्येषां चैव सर्वतः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2149005, "chapter_id": 4225, "verse_number": "२८", "content_sanskrit": "वासुदेवमभिप्रेक्ष्य धर्मराजं च पाण्डवम् ।\nउवाच धीमान् कौन्तेयः प्रहस्य सखिपूर्वकम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2149006, "chapter_id": 4225, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2149007, "chapter_id": 4225, "verse_number": "२९", "content_sanskrit": "युध्यमानस्य मे वीर गन्धर्वैः सुमहाबलैः ।\nसहायो घोषयात्रायां कस्तदाऽऽसीत् सखा मम\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2149008, "chapter_id": 4225, "verse_number": "३०", "content_sanskrit": "तदा प्रतिभये तस्मिन् देवदानवसङ्कुले ।\nखाण्डवे युध्यमानस्य कः सहायस्तदाऽभवत्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2149009, "chapter_id": 4225, "verse_number": "३१", "content_sanskrit": "निवातकवचैर्युद्धे कालकेयैश्च दानवैः ।\nतत्र मे युध्यमानस्य कः सहायस्तदाऽभवत्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2149010, "chapter_id": 4225, "verse_number": "३२", "content_sanskrit": "तथा विराटनगरे कुरुभिः सह संयुगे ।\nयुध्यतो बहुभिस्तत्र कः सहायस्तदाऽभवत्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2149011, "chapter_id": 4225, "verse_number": "३३", "content_sanskrit": "उपजीव्य रणे रुद्रं शक्रं वैश्रवणं यमम् ।\nवरुणं पावकं चैव कृपं कृष्णं च माधवम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2149012, "chapter_id": 4225, "verse_number": "३४", "content_sanskrit": "धारयन् गाण्डिवं दिव्यं धनुस्तेजोमयं दृढम् ।\nअक्षय्यशरसंयुक्तो दिव्यास्त्रपरिबृंहितः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2149013, "chapter_id": 4225, "verse_number": "३५", "content_sanskrit": "कौरवाणां कुले जातः पाण्डोः पुत्रो विशेषतः ।\nद्रोणं व्यपदिशन् शिष्य वासुदेवसहायवान्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2149014, "chapter_id": 4225, "verse_number": "३६", "content_sanskrit": "कथमस्मद्विधो ब्रूयाद् भीतोऽस्मीत्ययशस्करम् ।\nवचनं नर(राज)शार्दूल वज्रायुधमपि स्वयम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2149015, "chapter_id": 4225, "verse_number": "३७", "content_sanskrit": "नास्मि भीतो महाबाहो सहायार्थं च नास्ति मे ।\nयथाकामं यथायोगं गच्छ वाऽत्रैव तिष्ठ वा\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2149016, "chapter_id": 4225, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2149017, "chapter_id": 4225, "verse_number": "३८", "content_sanskrit": "तच्छ्रुत्वा वचनं तस्य विजयस्य हि धीमतः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2149018, "chapter_id": 4225, "verse_number": "३९", "content_sanskrit": "विनिवृत्य ततो रुग्मी सेनां सागरसन्निभाम् ।\nदुर्योधनमुपागच्छत् तथैव भरतर्षभ\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2149019, "chapter_id": 4225, "verse_number": "४०", "content_sanskrit": "तथैव चाभिगम्यैनमुवाच वसुधाधिपः ।\nप्रत्याख्यातश्च तेनापि स तदा शूरमानिना\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2149020, "chapter_id": 4225, "verse_number": "४१", "content_sanskrit": "द्वावेव तु महाराज तस्माद् युद्धादपेयतुः ।\nरौहिणेयश्च वार्ष्णेयो रुग्मी च स नराधिपः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2149021, "chapter_id": 4225, "verse_number": "४२", "content_sanskrit": "गते रामे तीर्थयात्रां भीष्मकस्य सुते तदा ।\nउपाविशन् पाण्डवेया मन्त्राय पुनरेव च\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2149022, "chapter_id": 4225, "verse_number": "४३", "content_sanskrit": "समितिर्धर्मराजस्य सा पार्थिवसमाकुला ।\nशुशुभे तारकाचित्रा द्यौः सचन्द्रेव भारत\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2149023, "chapter_id": 4225, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि षट्पञ्चाशोत्तरशततमोऽध्यायः ॥१५६॥\nभीष्माभिषेचनपर्वणि चतुर्थोऽध्यायः ॥४॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]