[{"id": 2093999, "chapter_id": 3011, "verse_number": "१३-१४१-१", "content_sanskrit": "युधिष्ठिर उवाच।\nब्राह्मणेभ्यः प्रयच्छन्ति दानानि विविधानि च।\nदातृप्रतिग्रहीत्रोर्वै को विशेषः पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2094000, "chapter_id": 3011, "verse_number": "१३-१४१-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2094001, "chapter_id": 3011, "verse_number": "१३-१४१-२", "content_sanskrit": "साधोर्यः प्रतिगृह्णीयात्तथैवासाधुतो द्विजः।\nगुणवत्यल्पदोषः स्यान्निर्गुणे तु निमज्जति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2094002, "chapter_id": 3011, "verse_number": "१३-१४१-३", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nवृषादर्भेश्च संवादं सप्तर्षीणां च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2094003, "chapter_id": 3011, "verse_number": "१३-१४१-४", "content_sanskrit": "कश्यपोऽत्रिर्वसिष्ठश्च भरद्वाजोऽथ गौतमः।\nविश्वामित्रो जमदग्निः साध्वी चैवाप्यरुन्धती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2094004, "chapter_id": 3011, "verse_number": "१३-१४१-५", "content_sanskrit": "सर्वेषामथ तेषां तु गण्डाभूत्परिचारिका।\nशूद्रः पशुसखश्चैव भर्ता चास्या बभूव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2094005, "chapter_id": 3011, "verse_number": "१३-१४१-६", "content_sanskrit": "ते च सर्वे तपस्यन्तः पुरा चेरुर्महीमिमाम्।\nसमाधिना प्रतीक्षन्तो ब्रह्मलोकं सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2094006, "chapter_id": 3011, "verse_number": "१३-१४१-७", "content_sanskrit": "अथाभवदनावृष्टिर्महती कुरुनन्दन।\nकृच्छ्रप्राणोऽभवद्यत्र लोकोऽयं वै क्षुधान्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2094007, "chapter_id": 3011, "verse_number": "१३-१४१-८", "content_sanskrit": "कस्मिंश्चिच्च पुरा यज्ञे याज्येन शिबिसूनुना।\nदक्षिणार्थेऽथ ऋत्विग्भ्यो दत्तः पुत्रोऽनिलः किल", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2094008, "chapter_id": 3011, "verse_number": "१३-१४१-९", "content_sanskrit": "अस्मिन्कालेऽथ सोऽल्पायुर्दिष्टान्तमगमत्प्रभुः।\nते तं क्षुधाभिसन्तप्ताः परिवार्योपतस्थिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2094009, "chapter_id": 3011, "verse_number": "१३-१४१-१०", "content_sanskrit": "याज्यात्मजमथो दृष्ट्वा गतासुमृषिसत्तमाः।\nअपचन्त तदा स्थाल्यां क्षुधार्ताः किल भारत", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2094010, "chapter_id": 3011, "verse_number": "१३-१४१-११", "content_sanskrit": "नाजीव्ये मर्त्यलोकेऽस्मिन्नात्मानं ते परीप्सवः।\nकृच्छ्रामापेदिरे वृत्तिमन्नहेतोस्तपस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2094011, "chapter_id": 3011, "verse_number": "१३-१४१-१२", "content_sanskrit": "अटमानोऽथ तान्मार्गे पचमानान्महीपतिः।\nराजा शैब्यो वृषादर्भिः क्लिश्यमानान्ददर्श ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2094012, "chapter_id": 3011, "verse_number": "१३-१४१-१३x", "content_sanskrit": "वृषादर्भिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2094013, "chapter_id": 3011, "verse_number": "१३-१४१-१३", "content_sanskrit": "प्रतिग्रहस्तारयति पुष्टिर्वै प्रतिगृह्णताम्।\nमयि यद्विद्यते वित्तं तद्वृणुध्वं तपोधनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2094014, "chapter_id": 3011, "verse_number": "१३-१४१-१४", "content_sanskrit": "`प्रतिग्रहो ब्राह्मणानां सृष्टा वृत्तिरनिन्दिता।\nतस्माद्ददामि वो वित्तं तद्वृणुध्वं तपोधनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2094015, "chapter_id": 3011, "verse_number": "१३-१४१-१५", "content_sanskrit": "प्रियो हि मे ब्राह्मणो याचमानो\nदद्यामहं वोऽश्वतरीसहस्रम्।\nधेनूनां दद्यामयुतं समग्र-\nमेकैकशः सवृषाः सम्प्रसूताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2094016, "chapter_id": 3011, "verse_number": "१३-१४१-१६", "content_sanskrit": "अश्वांस्तथा शीघ्रगाञ्श्वेतरूपां-\nन्मनोजवान्प्रददाम्यर्बुदानि।\nकुलम्भराननडुहः शतं शता-\nन्धुर्याञ्श्वेतान्सर्वशोऽहं ददामि।\nप्रष्ठौहीनां पीवराणां च ताव-\nदग्र्या गृष्टीर्धेनवः सुव्रताश्च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2094017, "chapter_id": 3011, "verse_number": "१३-१४१-१७", "content_sanskrit": "वरान्ग्रमान्व्रीहिरसं यवांश्च\nरत्नं चान्यद्दुर्लभं किं ददानि।\nनास्मिन्नभक्ष्ये भावमेवं कुरुध्वं\nपुष्ट्यर्थं वः किं प्रयच्छाम्यहं वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2094018, "chapter_id": 3011, "verse_number": "१३-१४१-१८x", "content_sanskrit": "ऋषय ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2094019, "chapter_id": 3011, "verse_number": "१३-१४१-१८", "content_sanskrit": "राजन्प्रतिग्रहो राज्ञं मध्वास्वादो विषोपमः।\nतज्जानमानः कस्मात्त्वं कुरुषे नः प्रलोभनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2094020, "chapter_id": 3011, "verse_number": "१३-१४१-१९", "content_sanskrit": "`दशसूनासमश्चक्री दशचक्रिसमो ध्वजी।\nदशध्वजिसमा वेश्या दशवेश्यासमो नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2094021, "chapter_id": 3011, "verse_number": "१३-१४१-२०", "content_sanskrit": "दशसूनासहस्राणि यो वाहयति सौनिकः।\nतेन तुल्यो भवेद्राजा घोरस्तस्य प्रतिग्रहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2094022, "chapter_id": 3011, "verse_number": "१३-१४१-२१", "content_sanskrit": "क्षेत्रं हि दैवतमिव ब्राह्मणान्समुपाश्रितम्।\nअमलो ह्येष तपसा प्रीतः प्रीणाति देवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2094023, "chapter_id": 3011, "verse_number": "१३-१४१-२२", "content_sanskrit": "अह्नायेह तपो जातु ब्राह्मणस्योपजायते।\nतद्दाव इव निर्दह्यात्प्राप्तो राजप्रतिग्रहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2094024, "chapter_id": 3011, "verse_number": "१३-१४१-२३", "content_sanskrit": "कुशलं सह दानेन राजन्नस्तु सदा तव।\nअर्थिभ्यो दीयतां सर्वमित्युक्त्वा तेन्यतो ययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2094025, "chapter_id": 3011, "verse_number": "१३-१४१-२४", "content_sanskrit": "अपक्वमेव तन्मांसमभूत्तेषां महात्मनाम्।\nअथ हित्वा ययु सर्वे वनमाहारकाङ्क्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2094026, "chapter_id": 3011, "verse_number": "१३-१४१-२५", "content_sanskrit": "ततः प्रचोदिता राज्ञा वनं गत्वाऽस्य मन्त्रिणः।\nप्रचीयोदुम्बराणि स्म दातुं तेषां प्रचक्रिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2094027, "chapter_id": 3011, "verse_number": "१३-१४१-२६", "content_sanskrit": "`दृष्ट्वा फलानि मुनयस्ते ग्रहीतुमुपाद्रवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2094028, "chapter_id": 3011, "verse_number": "१३-१४१-२७", "content_sanskrit": "उदुम्बराण्यथान्यानि हेमगर्भाण्युपाहरन्।\nभृत्यास्तेषां ततस्तानि प्रग्राहितुमुपाद्रवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2094029, "chapter_id": 3011, "verse_number": "१३-१४१-२८", "content_sanskrit": "गुरूणीति विदित्वाऽथ न ग्राह्याण्यत्रिरब्रवीत्।\nनास्मेह मन्दविज्ञाना नास्म मानुषबुद्धयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2094030, "chapter_id": 3011, "verse_number": "१३-१४१-२९", "content_sanskrit": "हैमानीमानि जानीमः प्रतिबुद्धाः स्म जागृम।\nइह ह्येतदुपावृत्तं प्रेत्य स्यात्कटुकोदयम्।\nअप्रतिग्राह्यमेवैतत्प्रेत्येह च सुखेप्सुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2094031, "chapter_id": 3011, "verse_number": "१३-१४१-३०x", "content_sanskrit": "वसिष्ठ उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2094032, "chapter_id": 3011, "verse_number": "१३-१४१-३०", "content_sanskrit": "शतेन निष्कगुणितं सहस्रेण च सम्मितम्।\nतथा बहु प्रतीच्छन्वै पापिष्ठां लभते गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2094033, "chapter_id": 3011, "verse_number": "१३-१४१-३१x", "content_sanskrit": "कश्यप उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2094034, "chapter_id": 3011, "verse_number": "१३-१४१-३१", "content_sanskrit": "यत्पृथिव्यां व्रीहियवं हिरण्यं पशवः स्त्रियः।\nसर्वं तन्नालमेकस्य तस्माद्विद्वाञ्शमं व्रजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2094035, "chapter_id": 3011, "verse_number": "१३-१४१-३२x", "content_sanskrit": "भरद्वाज उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2094036, "chapter_id": 3011, "verse_number": "१३-१४१-३२", "content_sanskrit": "उत्पन्नस्य रुरोः शृङ्गं वर्दमानस्य वर्धते।\nप्रार्थना पुरुषस्येव तस्य मात्रा न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2094037, "chapter_id": 3011, "verse_number": "१३-१४१-३३x", "content_sanskrit": "गौतम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2094038, "chapter_id": 3011, "verse_number": "१३-१४१-३३", "content_sanskrit": "न तल्लोके द्रव्यमस्ति यल्लोभं प्रतिपूरयेत्।\nसमुद्रकल्पः पुरुषो न कदाचन पूर्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2094039, "chapter_id": 3011, "verse_number": "१३-१४१-३४x", "content_sanskrit": "विश्वामित्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2094040, "chapter_id": 3011, "verse_number": "१३-१४१-३४", "content_sanskrit": "कामं कामयमानस्य यदा कामः समृध्यते।\nअथैनमपरः काम इष्टो विध्यति बाणवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2094041, "chapter_id": 3011, "verse_number": "१३-१४१-३५x", "content_sanskrit": "`अत्रिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2094042, "chapter_id": 3011, "verse_number": "१३-१४१-३५", "content_sanskrit": "न जातु कामः कामानामुपभोगेन शाम्यति।\nहविषा कृष्णवर्त्मेव भूय एवाभिवर्धते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2094043, "chapter_id": 3011, "verse_number": "१३-१४१-३६x", "content_sanskrit": "जमदग्निरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2094044, "chapter_id": 3011, "verse_number": "१३-१४१-३६", "content_sanskrit": "प्रतिग्रहे संयमो वै तपो धारयते ध्रुवम्।\nतद्धनं ब्राह्मणस्येह लुभ्यमानस्य विस्रवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2094045, "chapter_id": 3011, "verse_number": "१३-१४१-३७x", "content_sanskrit": "अरुन्धत्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2094046, "chapter_id": 3011, "verse_number": "१३-१४१-३७", "content_sanskrit": "धर्मार्थं सञ्चयो यो वा द्रव्याणां पक्षसम्मतः।\nतपःसञ्चय एवेह विशिष्टो द्रव्यसञ्चयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2094047, "chapter_id": 3011, "verse_number": "१३-१४१-३८x", "content_sanskrit": "चण्डोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2094048, "chapter_id": 3011, "verse_number": "१३-१४१-३८", "content_sanskrit": "उग्रादितो भयाद्यस्माद्बिभ्यतीमे ममेश्वराः।\nबलीयसो दुर्बलवद्बिभेम्यहमतः परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2094049, "chapter_id": 3011, "verse_number": "१३-१४१-३९x", "content_sanskrit": "पशुसस्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2094050, "chapter_id": 3011, "verse_number": "१३-१४१-३९", "content_sanskrit": "यद्वै धर्मात्परं नास्ति तादृशं ब्राह्मणा विदुः।\nविनयात्साधु विद्वांसमुपासेयं यथातथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2094051, "chapter_id": 3011, "verse_number": "१३-१४१-४०x", "content_sanskrit": "ऋषय ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2094052, "chapter_id": 3011, "verse_number": "१३-१४१-४०", "content_sanskrit": "कुशलं सह दानेन तस्मै यस्य प्रजा इमाः।\nफलान्युपधियुक्तानि य एवं नः प्रयच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2094053, "chapter_id": 3011, "verse_number": "१३-१४१-४१x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2094054, "chapter_id": 3011, "verse_number": "१३-१४१-४१", "content_sanskrit": "इत्युक्त्वा हेमगर्भाणि हित्वा तानि फलानि ते।\nऋषयो जग्मुरन्यत्र सर्व एव दृढव्रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2094055, "chapter_id": 3011, "verse_number": "१३-१४१-४२", "content_sanskrit": "अथ ते मन्त्रिणः सर्वे राजानमिदमब्रुवन्।\nउपधिं शङ्कमानास्ते हित्वा तानि फलानि वै।\nततोऽन्यत्रैव गच्छन्ति विदितं तेऽस्तु पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2094056, "chapter_id": 3011, "verse_number": "१३-१४१-४३", "content_sanskrit": "इत्युक्तः स तु भृत्यैस्तैर्वृषादर्भिश्चुकोप ह।\nतेषां वै प्रतिकर्तुं च सर्वेषामगमद्गृहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2094057, "chapter_id": 3011, "verse_number": "१३-१४१-४४", "content_sanskrit": "स गत्वाऽऽहवनीयेऽग्नौ तीव्रं नियममास्थितः।\nजुहाव संस्कृतैर्मन्त्रैरेकैकामाहुतिं नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2094058, "chapter_id": 3011, "verse_number": "१३-१४१-४५", "content_sanskrit": "तस्मादग्नेः समुत्तस्थौ कृत्या लोकभयंकरी।\nतस्या नाम वृषादर्भिर्यातुधानीत्यथाकरोत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2094059, "chapter_id": 3011, "verse_number": "१३-१४१-४६", "content_sanskrit": "सा कृत्या कालरात्रीव कृताञ्जलिरुपस्थिता।\nवृषादर्भि नरपतिं किं करोमीति चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2094060, "chapter_id": 3011, "verse_number": "१३-१४१-४७x", "content_sanskrit": "वृषादर्भिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2094061, "chapter_id": 3011, "verse_number": "१३-१४१-४७", "content_sanskrit": "ऋषीणां गच्छ सप्तानामरुन्धत्यास्तथैव च।\nदासीभर्तुश्च दास्याश्च मनसा नाम धारय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2094062, "chapter_id": 3011, "verse_number": "१३-१४१-४८", "content_sanskrit": "ज्ञात्वा नामानि चैवैषां सर्वानेतान्विनाशय।\nविनष्टेषु तथा स्वैरं गच्छ यत्रेप्सितं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2094063, "chapter_id": 3011, "verse_number": "१३-१४१-४९", "content_sanskrit": "सा तथेति प्रतिश्रुत्य यातुधानी स्वरूपिणी।\nजगाम तद्वनं यत्र विचेरुस्ते महर्षयः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2094064, "chapter_id": 3011, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकचत्वारिंशदधिकशततमोऽध्यायः॥ १४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]