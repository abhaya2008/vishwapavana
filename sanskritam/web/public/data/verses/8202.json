[{"id": 900001008, "chapter_id": 8202, "verse_number": "1.1", "content_sanskrit": "ब्रह्मा देवानां प्रथमः सम्बभूव विश्वस्य कर्ता भुवनस्य गोप्ता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900001009, "chapter_id": 8202, "verse_number": "1.2", "content_sanskrit": "मन्त्रेषु कर्माणि कवयो यान्यपश्यन् तानि त्रेतायां बहुधा सन्ततानि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900001010, "chapter_id": 8202, "verse_number": "1.3", "content_sanskrit": "तदेतत् सत्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900001011, "chapter_id": 8202, "verse_number": "1.4", "content_sanskrit": "आविः सन्निहितं गुहाचरं नाम महत् पदम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900001012, "chapter_id": 8202, "verse_number": "1.5", "content_sanskrit": "द्वा सुपर्णा सयुजा सखाया समानं वृक्षं परिषस्वजाते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900001013, "chapter_id": 8202, "verse_number": "1.6", "content_sanskrit": "स वेदैतत् परमं ब्रह्मधाम यत्र विश्वं निहितं भाति शुभ्रम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]