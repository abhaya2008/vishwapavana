[{"id": 2142196, "chapter_id": 4064, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2142197, "chapter_id": 4064, "verse_number": "१", "content_sanskrit": "ततो द्वितीये दिवसे भ्रातरः पञ्च पाण्डवाः ।\nस्नाताः शुक्लाम्बरधराः सर्वे सुचरितव्रताः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2142198, "chapter_id": 4064, "verse_number": "२", "content_sanskrit": "युधिष्ठिरं पुरस्कृत्य सर्वाभरणभूषिताः ।\nअभिपन्ना यथा नागा भ्राजमाना महारथाः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2142199, "chapter_id": 4064, "verse_number": "३", "content_sanskrit": "विराटस्य सभां प्राप्य भूमिपालासनेष्वथ ।\nनिषेदुः पावकप्रख्याः सर्वे धिष्ण्येष्विवाग्नयः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2142200, "chapter_id": 4064, "verse_number": "४", "content_sanskrit": "तेषु तत्रोपविष्टेषु विराटः पृथिवीपतिः ।\nआजगाम सभां राजा उत्तरेण सह प्रभो\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2142201, "chapter_id": 4064, "verse_number": "५", "content_sanskrit": "स तान् दृष्ट्वा महासत्वान् ज्वलतः पावकानिव ।\nराजवेषानुपादाय पार्थिवो विस्मितोऽभवत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2142202, "chapter_id": 4064, "verse_number": "६", "content_sanskrit": "किमिदं को विधिस्त्वेष भयार्त इव पार्थिवः ।\nपुरुषप्रवरान् दृष्ट्वा विषादमगमन्नृपः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2142203, "chapter_id": 4064, "verse_number": "७", "content_sanskrit": "अथ मात्स्योऽब्रवीत् कङ्कं देवराजमिव स्थितम् ।\nमरुद्गणैः सहासीनं त्रिदशानामिवेश्वरम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2142204, "chapter_id": 4064, "verse_number": "८", "content_sanskrit": "स किलाक्षनिवापस्त्वं सभास्तारो मया कृतः ।\nअथ राजासने कस्माद् उपविष्टोऽस्यलङ्कृतः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2142205, "chapter_id": 4064, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2142206, "chapter_id": 4064, "verse_number": "९", "content_sanskrit": "परिहासेच्छया राज्ञो विराटस्य निशम्य तत् ।\nस्मयमानोऽब्रवीद् वाक्यमर्जुनः परवीरहा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2142207, "chapter_id": 4064, "verse_number": "१०", "content_sanskrit": "इन्द्रस्यार्धासनं राजन्नयमारोढुमर्हति ।\nब्रह्मण्यः श्रुतवांस्त्यागी सर्वलोकाभिपूजितः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2142208, "chapter_id": 4064, "verse_number": "११", "content_sanskrit": "अयं कुरूणामृषभः कुन्तीपुत्रो युधिष्ठिरः ।\nयस्य कीर्तिः स्थिता लोके सूर्यस्येवोद्यतः प्रभा\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2142209, "chapter_id": 4064, "verse_number": "१२", "content_sanskrit": "संसरन्ति दिशः सर्वा यशसोऽस्य गभस्तयः ।\nउदितस्येव सूर्यस्य तेजसोऽनु गभस्तयः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2142210, "chapter_id": 4064, "verse_number": "१३", "content_sanskrit": "एनं त्रिंशत्सहस्राणि कुञ्जराणां तरस्विनाम् ।\nअन्वयुः पृष्ठतो राजन् यावदध्यावसत् कुरून्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2142211, "chapter_id": 4064, "verse_number": "१४", "content_sanskrit": "त्रिंशच्चैव सहस्राणि रथानां रथिनां वरम् ।\nसदश्वैरुपपन्नानि पृष्ठतोऽनुययुः पुरा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2142212, "chapter_id": 4064, "verse_number": "१५", "content_sanskrit": "वाजिनां च शतं राजन् सहस्राण्ययुतं तथा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2142213, "chapter_id": 4064, "verse_number": "१६", "content_sanskrit": "इममष्टशतं शूराः सुमृष्टमणिकुण्डलाः ।\nतुष्टुवुर्मागधैः सार्धं सूताः शक्रमिवर्षयः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2142214, "chapter_id": 4064, "verse_number": "१७", "content_sanskrit": "इमं नित्यमुपातिष्ठन् कुरवः किङ्करा यथा ।\nसर्वे चैव नृपा राजन् धनेश्वरमिवामराः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2142215, "chapter_id": 4064, "verse_number": "१८", "content_sanskrit": "एष सर्वान् महीपालान् करमाहारयत् तदा ।\nवैश्यानिव महाराज विवशान् स्ववशानपि\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2142216, "chapter_id": 4064, "verse_number": "१९", "content_sanskrit": "अष्टाशीतिसहस्राणि स्नातकानां महात्मनाम् ।\nउपजीवन्ति राजानमेनं सुचरितव्रतम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2142217, "chapter_id": 4064, "verse_number": "२०", "content_sanskrit": "एष विग्रहवान् धर्म एष वीर्यवतां वरः ।\nएष बुद्ध्याऽधिको लोके साधूनां च परायणम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2142218, "chapter_id": 4064, "verse_number": "२१", "content_sanskrit": "एषोऽस्त्रं विविधं वेत्ति त्रैलोक्ये सचराचरे ।\nन चैवान्यः पुमान् वेत्ति न वेत्स्यति कदाचन\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2142219, "chapter_id": 4064, "verse_number": "२२", "content_sanskrit": "न देवा नासुरा केचिन्न मनुष्या न राक्षसाः ।\nगन्धर्वयक्षप्रवरा सकिन्नरमहोरगाः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2142220, "chapter_id": 4064, "verse_number": "२३", "content_sanskrit": "दीर्घदर्शी महातेजाः पौरजानपदप्रियः ।\nपाण्डवानामतिरथो यज्वा धर्मपरो वशी\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2142221, "chapter_id": 4064, "verse_number": "२४", "content_sanskrit": "महर्षिकल्पो राजर्षिस्त्रिषु लोकेषु विश्रुतः ।\nबलवान् धृतिमान् प्राज्ञः सत्यवादी जितेन्द्रियः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2142222, "chapter_id": 4064, "verse_number": "२५", "content_sanskrit": "धनैश्च सञ्चितैश्चैव शक्रवैश्रवणोपमः ।\nयथा मनुर्महातेजा लोकानां परिरक्षिता\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2142223, "chapter_id": 4064, "verse_number": "२६", "content_sanskrit": "एवमेष महातेजाः प्रजानुग्रहकारकः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2142224, "chapter_id": 4064, "verse_number": "२७", "content_sanskrit": "एष वृद्धाननाथांश्च व्यङ्गान् पङ्गूंश्च वामनान् ।\nपुत्रवत् पालयामास प्रजाः धर्मेण मानयन्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2142225, "chapter_id": 4064, "verse_number": "२८", "content_sanskrit": "एष धर्मे दमे चैव दाने सत्ये रतः सदा ।\nमहाप्रसादो ब्रह्मण्यः सत्यवादी च पार्थिवः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2142226, "chapter_id": 4064, "verse_number": "२९", "content_sanskrit": "यत्प्रभावेण वै पश्य तप्यते वै सुयोधनः ।\nसगणः सह कर्णेन सौबलेन च वीर्यवान्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2142227, "chapter_id": 4064, "verse_number": "३०", "content_sanskrit": "न शक्यन्ते गुणास्तस्य प्रसङ्ख्यातुं नरोत्तम ।\nएष धर्मपरो नित्यमनृशंसी च पाण्डवः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2142228, "chapter_id": 4064, "verse_number": "३१", "content_sanskrit": "एवंयुक्तो महाराज पाण्डवः पुरुषर्षभः ।\nकथं नार्हति राजार्हमासनं पृथिवीपतिः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2142229, "chapter_id": 4064, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि द्वासप्ततितमोऽध्यायः ॥७२॥ वैवाहिकपर्वणि प्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]