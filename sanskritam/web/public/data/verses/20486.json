[{"id": 7000486000, "chapter_id": 20486, "verse_number": "३-३३-१", "content_sanskrit": "युधिष्ठिर उवाच ।\nवाराणस्याश्च माहात्म्यं संक्षेपात्कथितं त्वया ।\nविस्तरेण मुने ब्रूहि तदा प्रीणाति मे मनः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000486001, "chapter_id": 20486, "verse_number": "३-३३-२", "content_sanskrit": "नारद उवाच ।\nअत्रेतिहासं वक्ष्यामि वाराणस्या गुणाश्रयम् ।\nयस्य श्रवणमात्रेण मुच्यते ब्रह्महत्यया॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000486002, "chapter_id": 20486, "verse_number": "३-३३-३", "content_sanskrit": "मेरुशृंगे पुरा देवमीशानं त्रिपुरद्विषम् ।\nदेवासनगता देवी महादेवमपृच्छत॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000486003, "chapter_id": 20486, "verse_number": "३-३३-४", "content_sanskrit": "देव्युवाच ।\nदेवदेव महादेव भक्तानामार्तिनाशन ।\nकथं त्वां पुरुषो देवमचिरादेव पश्यति॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000486004, "chapter_id": 20486, "verse_number": "३-३३-५", "content_sanskrit": "सांख्ययोगस्तथा ध्यानं कर्मयोगोऽथ वैदिकः ।\nआयासबहुला लोके यानि चान्यानि शंकर॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000486005, "chapter_id": 20486, "verse_number": "३-३३-६", "content_sanskrit": "येन विश्रांतचित्तानां योगिनां कर्मिणामपि ।\nदृश्यो हि भगवान्सूक्ष्मः सर्वेषामथ देहिनाम्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000486006, "chapter_id": 20486, "verse_number": "३-३३-७", "content_sanskrit": "एतद्गुह्यतमं ज्ञानं गूढं शक्रादिसेवितम् ।\nहिताय सर्वभूतानां ब्रूहि कामाग्निनाशनम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000486007, "chapter_id": 20486, "verse_number": "३-३३-८", "content_sanskrit": "ईश्वर उवाच ।\nअवाच्यमत्र विज्ञानं ज्ञानमज्ञैर्बहिष्कृतम् ।\nवक्ष्ये तव यथातत्त्वं यदुक्तं परमर्षिभिः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000486008, "chapter_id": 20486, "verse_number": "३-३३-९", "content_sanskrit": "परं गुह्यतमं क्षेत्रं मम वाराणसी पुरी ।\nसर्वेषामेव भूतानां संसारार्णवतारिणी॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000486009, "chapter_id": 20486, "verse_number": "३-३३-१०", "content_sanskrit": "तत्र भक्त्या महादेवि मदीयं व्रतमास्थिताः ।\nनिवसंति महात्मानः परं नियममास्थिताः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000486010, "chapter_id": 20486, "verse_number": "३-३३-११", "content_sanskrit": "उत्तमं सर्वतीर्थानां स्थानानामुत्तमं च यत् ।\nज्ञानानामुत्तमं ज्ञानमविमुक्तं परं मम॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000486011, "chapter_id": 20486, "verse_number": "३-३३-१२", "content_sanskrit": "स्थानांतर पवित्राणि तीर्थान्यायतनानि च ।\nश्मशानसंस्थितान्येव दिव्यभूमिगतानि च॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000486012, "chapter_id": 20486, "verse_number": "३-३३-१३", "content_sanskrit": "भूर्लोके नैव संलग्नमंतरिक्षे ममालयम् ।\nअमुक्तास्तत्र पश्यंति मुक्ताः पश्यंति चेतसा॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000486013, "chapter_id": 20486, "verse_number": "३-३३-१४", "content_sanskrit": "श्मशानमेतद्विख्यातमविमुक्तमिति श्रुतम् ।\nकालो भूत्वा जगदिदं संहराम्यत्र सुंदरि॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000486014, "chapter_id": 20486, "verse_number": "३-३३-१५", "content_sanskrit": "देवीदं सर्वगुह्यानां स्थानं प्रियतरं मम ।\nमद्भक्तास्तत्र गच्छंति मामेव प्रविशंति च॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000486015, "chapter_id": 20486, "verse_number": "३-३३-१६", "content_sanskrit": "दत्तं जप्तं हुतं चेष्टं तपस्तप्तं कृतं च यत् ।\nध्यानमध्ययनं ज्ञानं सर्वं तत्राक्षयं भवेत्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000486016, "chapter_id": 20486, "verse_number": "३-३३-१७", "content_sanskrit": "जन्मांतरसहस्रेषु यत्पापं पूर्वसंचितम् ।\nअविमुक्तं प्रविष्टस्य तत्सर्वं व्रजति क्षयम्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000486017, "chapter_id": 20486, "verse_number": "३-३३-१८", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्याः शूद्राश्च वर्णसंकराः ।\nस्त्रियो म्लेच्छाश्च ये चान्ये संकीर्णाः पापयोनयः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000486018, "chapter_id": 20486, "verse_number": "३-३३-१९", "content_sanskrit": "कीटाः पिपीलिकाश्चैव ये चान्ये मृगपक्षिणः ।\nकालेन निधनं प्राप्ता अविमुक्ते वरानने॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000486019, "chapter_id": 20486, "verse_number": "३-३३-२०", "content_sanskrit": "चंद्रार्द्धमौलयस्त्र्यक्षा महावृषभवाहनाः ।\nशिवे मम पुरे देवि जायंते तत्र मानवाः॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000486020, "chapter_id": 20486, "verse_number": "३-३३-२१", "content_sanskrit": "नाविमुक्ते मृतः कश्चिन्नरकं याति किल्बिषी ।\nईश्वरानुगृहीता हि सर्वे यांति परां गतिम्॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000486021, "chapter_id": 20486, "verse_number": "३-३३-२२", "content_sanskrit": "मोक्षं सुदुर्ल्लभं मत्वा संसारं चातिभीषणम् ।\nअश्मना चरणौ भंक्त्वा वाराणस्यां वसेन्नरः॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000486022, "chapter_id": 20486, "verse_number": "३-३३-२३", "content_sanskrit": "दुर्ल्लभा तपसा चापि मृतस्य परमेश्वरि ।\nयत्र तत्र विपन्नस्य गतिः संसारमोक्षणी॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000486023, "chapter_id": 20486, "verse_number": "३-३३-२४", "content_sanskrit": "प्रसादाज्जायते सम्यक्मम शैलेंद्रनंदिनि ।\nअप्रवृद्धा न पश्यंति मम मायाविमोहिताः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000486024, "chapter_id": 20486, "verse_number": "३-३३-२५", "content_sanskrit": "विण्मूत्ररेतसां मध्ये ते वसंति पुनः पुनः ।\nहन्यमानोऽपि यो विद्वान्वसेद्विघ्नशतैरपि॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000486025, "chapter_id": 20486, "verse_number": "३-३३-२६", "content_sanskrit": "स याति परमं स्थानं यत्र गत्वा न शोचति ।\nजन्ममृत्युजरामुक्तं परं यांति शिवालयम्॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000486026, "chapter_id": 20486, "verse_number": "३-३३-२७", "content_sanskrit": "अपुनर्मरणानां हि सा गतिर्मोक्षकांक्षिणाम् ।\nयां प्राप्य कृतकृत्यः स्यादिति मन्यंति पंडिताः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000486027, "chapter_id": 20486, "verse_number": "३-३३-२८", "content_sanskrit": "न दानैर्न तपोभिश्च न यज्ञैर्नापि विद्यया ।\nप्राप्यते गतिरुत्कृष्टा याविमुक्ते तु लभ्यते॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000486028, "chapter_id": 20486, "verse_number": "३-३३-२९", "content_sanskrit": "नानावर्णा विवर्णाश्च चांडालाद्या जुगुप्सिताः ।\nकिल्बिषैः पूर्णदेहाश्च विशिष्टैः पातकैस्तथा॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000486029, "chapter_id": 20486, "verse_number": "३-३३-३०", "content_sanskrit": "भेषजं परमं तेषामविमुक्तं विदुर्बुधाः ।\nअविमुक्तं परं ज्ञानमविमुक्तं परं पदम्॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000486030, "chapter_id": 20486, "verse_number": "३-३३-३१", "content_sanskrit": "अविमुक्तं परं तत्त्वमविमुक्तं परं शिवम् ।\nकृत्वा वै नैष्ठिकीं दीक्षामविमुक्ते वसंति ये॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000486031, "chapter_id": 20486, "verse_number": "३-३३-३२", "content_sanskrit": "तेषां तत्परमं ज्ञानं ददाम्यंते परं पदम् ।\nप्रयागं नैमिषारण्यं श्रीशैलोऽथ महाबलम्॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000486032, "chapter_id": 20486, "verse_number": "३-३३-३३", "content_sanskrit": "केदारं भद्रकर्णं तु गया पुष्करमेव च ।\nकुरुक्षेत्रं भद्रकोटिर्नर्मदाम्रातकेश्वरी॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000486033, "chapter_id": 20486, "verse_number": "३-३३-३४", "content_sanskrit": "शालग्रामं च कुब्जाम्रं कोकामुखमनुत्तमम् ।\nप्रभासं विजयेशानं गोकर्णं भद्रकर्णकम्॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000486034, "chapter_id": 20486, "verse_number": "३-३३-३५", "content_sanskrit": "एतानि पुण्यस्थानानि त्रैलोक्ये विश्रुतानि ह ।\nन यास्यंति परं तत्त्वं वाराणस्यां यथा मृताः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000486035, "chapter_id": 20486, "verse_number": "३-३३-३६", "content_sanskrit": "वाराणस्यां विशेषेण गंगा त्रिपथगामिनी ।\nप्रविष्टा नाशयेत्पापं जन्मांतरशतैः कृतम्॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000486036, "chapter_id": 20486, "verse_number": "३-३३-३७", "content_sanskrit": "अन्यत्र सुलभा गंगा श्राद्धं दानं तपो जपः ।\nव्रतानि सर्वमेवैतद्वाराणस्यां सुदुर्ल्लभम्॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000486037, "chapter_id": 20486, "verse_number": "३-३३-३८", "content_sanskrit": "जपेच्च जुहुयान्नित्यं ददात्यर्चयतेऽमरान् ।\nवायुभक्षश्च सततं वाराणस्यां स्थितो नरः॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000486038, "chapter_id": 20486, "verse_number": "३-३३-३९", "content_sanskrit": "यदि पापो यदि शठो यदि वा धार्मिको नरः ।\nवाराणसीं समासाद्य पुनाति सकलं कुलम्॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000486039, "chapter_id": 20486, "verse_number": "३-३३-४०", "content_sanskrit": "वाराणस्यां येऽर्चयंति महादेवं स्तुवंति वै ।\nसर्वपापविनिर्मुक्तास्ते विज्ञेया गणेश्वराः॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000486040, "chapter_id": 20486, "verse_number": "३-३३-४१", "content_sanskrit": "अन्यत्र योगज्ञानाभ्यां संन्यासादथवान्यतः ।\nप्राप्यते तत्परं स्थानं सहस्रेणैव जन्मनाम्॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000486041, "chapter_id": 20486, "verse_number": "३-३३-४२", "content_sanskrit": "ये भक्ता देवदेवेशि वाराणस्यां वसंति वै ।\nते विंदंति परं मोक्षमेकेनैव तु जन्मना॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000486042, "chapter_id": 20486, "verse_number": "३-३३-४३", "content_sanskrit": "यत्र योगस्तथा ज्ञानं मुक्तिरेकेन जन्मना ।\nअविमुक्तं तदासाद्य नान्यदिच्छेत्तपोवनम्॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000486043, "chapter_id": 20486, "verse_number": "३-३३-४४", "content_sanskrit": "यतो मयाऽविमुक्तं तदविमुक्तं ततः स्मृतम् ।\nतदेव गुह्यं गुह्यानामेतद्विज्ञानमुच्यते॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000486044, "chapter_id": 20486, "verse_number": "३-३३-४५", "content_sanskrit": "ज्ञानाज्ञानाभिनिष्ठानां परमानंदमिच्छताम् ।\nयागतिर्विदिता सुभ्रूः साविमुक्ते मृतस्य तु॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000486045, "chapter_id": 20486, "verse_number": "३-३३-४६", "content_sanskrit": "यानि चैवाविमुक्तस्य देहे दृष्टानि कृत्स्नशः ।\nपुरी वाराणसी तेभ्यः स्थानेभ्योऽप्यधिका शुभा॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000486046, "chapter_id": 20486, "verse_number": "३-३३-४७", "content_sanskrit": "यत्र साक्षान्महादेवो देहांते स्वयमीश्वरः ।\nव्याचष्टे तारकं ब्रह्म तत्रैव ह्यविमुक्तये॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000486047, "chapter_id": 20486, "verse_number": "३-३३-४८", "content_sanskrit": "यत्तत्परतरं तत्त्वमविमुक्तमिति श्रुतम् ।\nएकेन जन्मना देवि वाराणस्यां तदाप्नुयात्॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000486048, "chapter_id": 20486, "verse_number": "३-३३-४९", "content_sanskrit": "भ्रूमध्ये नाभिमध्ये च हृदये चैव मूर्धनि ।\nयथाविमुक्तमादित्ये वाराणस्यां व्यवस्थितम्॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000486049, "chapter_id": 20486, "verse_number": "३-३३-५०", "content_sanskrit": "वरणायास्तथा चास्या मध्ये वाराणसीपुरी ।\nतत्रैव संस्थितं तत्त्वं नित्यमेवंविमुक्तकम्॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000486050, "chapter_id": 20486, "verse_number": "३-३३-५१", "content_sanskrit": "वाराणस्याः परं स्थानं न भूतं न भविष्यति ।\nयत्र नारायणो देवो महादेवो दिवीश्वरः॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000486051, "chapter_id": 20486, "verse_number": "३-३३-५२", "content_sanskrit": "तत्र देवाः सगंधर्वाः सयक्षोरगराक्षसाः ।\nउपासते यं सततं देवदेवः पितामहः॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000486052, "chapter_id": 20486, "verse_number": "३-३३-५३", "content_sanskrit": "महापातकिनो देवि ये तेभ्यः पापकृत्तमाः ।\nवाराणसीं समासाद्य ते यांति परमां गतिम्॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000486053, "chapter_id": 20486, "verse_number": "३-३३-५४", "content_sanskrit": "तस्मान्मुमुक्षुर्नियतो वसेद्वै मरणांतकम् ।\nवाराणस्यां महादेवाज्ज्ञानं लब्ध्वा विमुच्यते॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000486054, "chapter_id": 20486, "verse_number": "३-३३-५५", "content_sanskrit": "किंतु विघ्ना भविष्यंति पापोपहतचेतसः ।\nततो नैवाचरेत्पापं कायेन मनसा गिरा॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000486055, "chapter_id": 20486, "verse_number": "३-३३-५६", "content_sanskrit": "एतद्रहस्यं देवानां पुराणानां च सुव्रते ।\nअविमुक्ताश्रयं ज्ञानं न कश्चिद्वेत्ति तत्त्वतः॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000486056, "chapter_id": 20486, "verse_number": "३-३३-५७", "content_sanskrit": "नारद उवाच ।\nदेवतानामृषीणां च शृण्वतां परमेष्ठिनाम् ।\nदेवदेवेन कथितं सर्वपापविनाशनम्॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000486057, "chapter_id": 20486, "verse_number": "३-३३-५८", "content_sanskrit": "यथानारायणः श्रेष्ठो देवानां पुरुषोत्तमः ।\nयथेश्वराणां गिरिशः स्थानानामेतदुत्तमम्॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000486058, "chapter_id": 20486, "verse_number": "३-३३-५९", "content_sanskrit": "यैः समाराधितो रुद्रः पूर्वस्मिन्नेकजन्मनि ।\nते विदंति परं क्षेत्रमविमुक्तं शिवालयम्॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000486059, "chapter_id": 20486, "verse_number": "३-३३-६०", "content_sanskrit": "कलिकल्मषसंभूता येषामुपहृता मतिः ।\nन तेषां वेदितुं शक्यं स्थानं तत्परमेष्ठिनः॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000486060, "chapter_id": 20486, "verse_number": "३-३३-६१", "content_sanskrit": "ये स्मरंति सदा कालं वदंति च पुरीमिमाम् ।\nतेषां विनश्यति क्षिप्रमिहामुत्र च पातकम्॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000486061, "chapter_id": 20486, "verse_number": "३-३३-६२", "content_sanskrit": "यानि चेह प्रकुर्वंति पातकानि कृतालयाः ।\nनाशयेत्तानि सर्वाणि देवः कालतनुः शिवः॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000486062, "chapter_id": 20486, "verse_number": "३-३३-६३", "content_sanskrit": "आगच्छेत्तदिदं स्थानं सेवितं मोक्षकांक्षिभिः ।\nमृतानां च पुनर्जन्म न भूयो भवसागरे॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000486063, "chapter_id": 20486, "verse_number": "३-३३-६४", "content_sanskrit": "तस्मात्सर्वप्रयत्नेन वाराणस्यां वसेन्नरः ।\nयोगी वाप्यथवायोगी पापी वा पुण्यकृत्तमः॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000486064, "chapter_id": 20486, "verse_number": "३-३३-६५", "content_sanskrit": "न लोकवचनात्पित्रोर्न चैव गुरुवादतः ।\nमतिर्न क्रमणीया स्यादविमुक्तगतिं प्रति॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]