[{"id": 2086797, "chapter_id": 2844, "verse_number": "१२-३४९-०x", "content_sanskrit": "शौकन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2086798, "chapter_id": 2844, "verse_number": "१२-३४९-१", "content_sanskrit": "कथं स भगवान्देवो यज्ञेष्वग्रहरः प्रभुः।\nयज्ञधारी च सततं वेदवेदाङ्गवित्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2086799, "chapter_id": 2844, "verse_number": "१२-३४९-२", "content_sanskrit": "निवृत्तं चास्थितो धर्मं क्षेमी भागवतः प्रभुः।\nनिवृत्तिधर्मान्विदधे स एव भगवान्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2086800, "chapter_id": 2844, "verse_number": "१२-३४९-३", "content_sanskrit": "कथं प्रवृत्तिधर्मेषु भागार्हा देवताः कृताः।\nकथं निवृत्तिधर्माश्च कृता व्यावृत्तबुद्धयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2086801, "chapter_id": 2844, "verse_number": "१२-३४९-४", "content_sanskrit": "एतं नः संशयं सौते छिन्धि गुह्यं सनातनम्।\nत्वया नारायणकथाः श्रुता वै धर्मसंहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2086802, "chapter_id": 2844, "verse_number": "१२-३४९-५x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2086803, "chapter_id": 2844, "verse_number": "१२-३४९-५", "content_sanskrit": "जनमेजयेन यत्पृष्टः शिष्यो व्यासस्य धीमतः।\nतत्तेऽहं कथयिष्यामि पौराणं शौनकोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2086804, "chapter_id": 2844, "verse_number": "१२-३४९-६", "content_sanskrit": "श्रुत्वा माहात्म्यमेतस्य देहिनां परमात्मनः।\nजनमेजयो महाप्राज्ञो वैशम्पायनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2086805, "chapter_id": 2844, "verse_number": "१२-३४९-७", "content_sanskrit": "इमे सब्रह्यका लोकाः ससुरासुरमानवाः।\nक्रियास्वभ्युदयोक्तासु सक्ता दृश्यन्ति सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2086806, "chapter_id": 2844, "verse_number": "१२-३४९-८", "content_sanskrit": "मोक्षश्चोक्तस्त्वया ब्रह्मन्निर्वाणं परमं सुखम्।\nये तु मुक्ता भवन्तीह पुण्यपापविवर्जिताः।\nते सहस्रार्चिषं देवं प्रविशन्तीह शुश्रुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2086807, "chapter_id": 2844, "verse_number": "१२-३४९-९", "content_sanskrit": "अयं हि दुरनुष्ठेयो मोक्षधर्मः सनातनः।\nयं हित्वा देवताः सर्वा हव्यकव्यभुजोऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2086808, "chapter_id": 2844, "verse_number": "१२-३४९-१०", "content_sanskrit": "किंच ब्रह्मा च रुद्रश्च बलभित्प्रभुः।\nसूर्यस्ताराधिपो वायुरग्निर्वरुण एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2086809, "chapter_id": 2844, "verse_number": "१२-३४९-११", "content_sanskrit": "आकाशं जगती चैव ये च शेषा दिवौकसः।\nप्रलयं न विजानन्ति आत्मनः परिनिर्मितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2086810, "chapter_id": 2844, "verse_number": "१२-३४९-१२", "content_sanskrit": "ततस्तेनास्थिता मार्गं ध्रुवमक्षरमव्ययम्।\nस्मृत्वा कालपरीमाणं प्रवृत्तिं ये समास्थिताः।\nदोषः कालपरीमाणो महानेष क्रियावताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2086811, "chapter_id": 2844, "verse_number": "१२-३४९-१३", "content_sanskrit": "एतन्मे संशयं विप्र हृदि शल्यमिवार्पितम्।\nछिन्धीतिहासकथनात्परं कौतूहलं हि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2086812, "chapter_id": 2844, "verse_number": "१२-३४९-१४", "content_sanskrit": "कथं भागहराः प्रोक्ता देवताः क्रतुषु द्विज।\nकिमर्थं चाध्वरे ब्रह्मन्निज्यन्ते त्रिदिवौकसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2086813, "chapter_id": 2844, "verse_number": "१२-३४९-१५", "content_sanskrit": "ये च भागं प्रगृह्णन्ति यज्ञेषु द्विजसत्तम।\nते यजन्तो महायज्ञैः कस्य भागं ददन्ति वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2086814, "chapter_id": 2844, "verse_number": "१२-३४९-१६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2086815, "chapter_id": 2844, "verse_number": "१२-३४९-१६", "content_sanskrit": "अहो गूढतमः प्रश्नस्त्वया पृष्टो जनेश्वर।\nनातप्ततपसा ह्येष नावेदविदुषा तथा।\nनापुराणविदा चैव शक्यो व्याहर्तुमञ्जसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2086816, "chapter_id": 2844, "verse_number": "१२-३४९-१७", "content_sanskrit": "हन्त ते कथयिष्यामि यन्मे पृष्टः पुरा गुरुः।\nकृष्णद्वैपायनो व्यासो वेदव्यासो महानृषिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2086817, "chapter_id": 2844, "verse_number": "१२-३४९-१८", "content_sanskrit": "सुमन्तुर्जैमिनिश्चैव पैलश्च सुदृढव्रतः।\nअहं चतुर्थः शिष्यो वै पञ्चमश्च शुकः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2086818, "chapter_id": 2844, "verse_number": "१२-३४९-१९", "content_sanskrit": "एतान्समागतान्सर्वान्पञ्च शिष्यान्दमान्वितान्।\nशौचाचारसमायुक्ताञ्जितक्रोधाञ्जितेन्द्रियान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2086819, "chapter_id": 2844, "verse_number": "१२-३४९-२०", "content_sanskrit": "वेदानध्यापयामास महाभारतपञ्चमान्।\nमेरौ गिरिवरे रम्ये सिद्धचारणसेविते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2086820, "chapter_id": 2844, "verse_number": "१२-३४९-२१", "content_sanskrit": "तेषामभ्यस्यतां वेदान्कदाचित्संशयोऽभवत्।\nएष वै यस्त्वया पृष्टस्तेन तेषां प्रकीर्तितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2086821, "chapter_id": 2844, "verse_number": "१२-३४९-२२", "content_sanskrit": "ततः श्रुतो मया चापि तवाख्येयोऽद्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2086822, "chapter_id": 2844, "verse_number": "१२-३४९-२३", "content_sanskrit": "शिष्याणां वचनं श्रुत्वा सर्वाज्ञानतमोनुदः।\nपराशरसुतः श्रीमान्व्यासो वाक्यमथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2086823, "chapter_id": 2844, "verse_number": "१२-३४९-२४", "content_sanskrit": "मया हि सुमहत्तप्तं तपः परमदारुणम्।\nभूतं भव्यं भविष्यं च जानीयामिति सत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2086824, "chapter_id": 2844, "verse_number": "१२-३४९-२५", "content_sanskrit": "तस्य मे तप्ततपसो निगृहीतेन्द्रियस्य च।\nनारायणप्रसादेन क्षीरोदस्यानुकूलतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2086825, "chapter_id": 2844, "verse_number": "१२-३४९-२६", "content_sanskrit": "त्रैकालिकमिदं ज्ञानं प्रादुर्भूतं यथेप्सितम्।\nतच्छृणुध्वं यथान्यायं वक्ष्ये संशयमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2086826, "chapter_id": 2844, "verse_number": "१२-३४९-२७", "content_sanskrit": "यथा वृत्तं हि कल्पादौ दृष्टं मे ज्ञानचक्षुषा।\nपरमात्मेति यं प्राहुः साङ्ख्ययोगविदो जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2086827, "chapter_id": 2844, "verse_number": "१२-३४९-२८", "content_sanskrit": "महापुरुषसंज्ञां स लभते स्वेन कर्मणा।\nतस्मात्प्रसूतमव्यक्तं प्रधानं तं विदुर्बुधाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2086828, "chapter_id": 2844, "verse_number": "१२-३४९-२९", "content_sanskrit": "अव्यक्ताद्व्यक्तमुत्पन्नं लोकसृष्ट्यर्थमीश्वरात्।\nअनिरुद्धो हि लोकेषु महानात्मेति कथ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2086829, "chapter_id": 2844, "verse_number": "१२-३४९-३०", "content_sanskrit": "योसौ व्यक्तत्वमापन्नो निर्ममे च पितामहम्।\nयोऽहंकार इति प्रोक्तः सर्वतेजोमयो हि सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2086830, "chapter_id": 2844, "verse_number": "१२-३४९-३१", "content_sanskrit": "पृथिवी वायुराकाशमापो ज्योतिश्च पञ्चमम्।\nअहंकारप्रसूतानि महाभूतानि पञ्चधा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2086831, "chapter_id": 2844, "verse_number": "१२-३४९-३२", "content_sanskrit": "महाभूतानि सृष्ट्वैव तान्गुणान्निर्ममे पुनः।\nभूतेभ्यश्चैव निष्पन्ना मूर्तिमन्तश्च ताञ्शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2086832, "chapter_id": 2844, "verse_number": "१२-३४९-३३", "content_sanskrit": "मरीचिरङ्गिराश्चात्रिः पुलस्त्यः पुलहः क्रतुः।\nवसिष्ठश्च महात्मा वै मनुः स्वायंभुवस्तथा।\nज्ञेयाः प्रकृतयोऽष्टौ ता यासु लोकाः प्रतिष्ठिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2086833, "chapter_id": 2844, "verse_number": "१२-३४९-३४", "content_sanskrit": "वेदान्वेदाङ्गसंयुक्तान्यज्ञयज्ञाङ्गसंयुतान्।\nनिर्ममे लोकसिद्ध्यर्थं ब्रह्मा लोकपितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2086834, "chapter_id": 2844, "verse_number": "१२-३४९-३५", "content_sanskrit": "अष्टाभ्यः प्रकृतिभ्यश्च जातं विश्वमिदं जगत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2086835, "chapter_id": 2844, "verse_number": "१२-३४९-३६", "content_sanskrit": "रुद्रो रोषात्मको जातो दशान्यान्सोसृजस्त्वयम्।\nएकादशैते रुद्रास्तु विकाराः पुरुषाः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2086836, "chapter_id": 2844, "verse_number": "१२-३४९-३७", "content_sanskrit": "ते रुद्राः प्रकृरतिश्चैव सर्वे चैव सुरर्षयः।\nउत्पन्ना लोकसिद्ध्यर्थं ब्रह्माणं समुपस्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2086837, "chapter_id": 2844, "verse_number": "१२-३४९-३८", "content_sanskrit": "वयं सृष्टा हि भगवंस्त्वया च प्रभविष्णुना।\nयेन यस्मिन्नधीकारे वर्तितव्यं पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2086838, "chapter_id": 2844, "verse_number": "१२-३४९-३९", "content_sanskrit": "योसौ त्वयाऽभिनिर्दिष्टो ह्यधिकारोऽर्थचिन्तकः।\nपरिपाल्यः कथं तेन साहंकारेण कर्तृणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2086839, "chapter_id": 2844, "verse_number": "१२-३४९-४०", "content_sanskrit": "प्रदिशस्व बलं तस्य योऽधिकारार्थचिन्तकः।\nएवमुक्तो महादेवो देवांस्तानिदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2086840, "chapter_id": 2844, "verse_number": "१२-३४९-४१x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2086841, "chapter_id": 2844, "verse_number": "१२-३४९-४१", "content_sanskrit": "साध्वहं ज्ञापितो देवा युष्माभिर्भद्रमस्तु वः।\nममाप्येषा समुत्पन्ना चिन्ता या भवतामिह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2086842, "chapter_id": 2844, "verse_number": "१२-३४९-४२", "content_sanskrit": "लोकतन्त्रस्य कृत्स्नस्य कथं कार्यः परिग्रहः।\nकथं बलक्षयो न स्याद्युष्माकं ह्यात्मनश्च वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2086843, "chapter_id": 2844, "verse_number": "१२-३४९-४३", "content_sanskrit": "इतः सर्वेऽपि गच्छामः शरणं लोकसाक्षिणम्।\nमहापुरुषमव्यक्तं स नो वक्ष्यति यद्धितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2086844, "chapter_id": 2844, "verse_number": "१२-३४९-४४", "content_sanskrit": "ततस्ते ब्रह्मणा सार्धमृषयो विबुधास्तथा।\nक्षीरादस्योत्तरं कूलं जग्मूर्लोकहितार्थिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2086845, "chapter_id": 2844, "verse_number": "१२-३४९-४५", "content_sanskrit": "ते तपः समुपातिष्ठन्ब्रह्मोक्तं वेदकल्पितम्।\nस महानियमो नाम तपश्चर्या सुदारुणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2086846, "chapter_id": 2844, "verse_number": "१२-३४९-४६", "content_sanskrit": "ऊर्ध्वदृग्बाहवश्चैव एकाग्रमनसोऽभवन्।\nएकपादस्थिताः सर्वे काष्ठभूताः समाहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2086847, "chapter_id": 2844, "verse_number": "१२-३४९-४७", "content_sanskrit": "दिव्यं वर्षसहस्रं ते तपस्तप्त्वा सुदारुणम्।\nशुश्रुवुर्मधुरां वाणीं वेदवेदाङ्गभूषिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2086848, "chapter_id": 2844, "verse_number": "१२-३४९-४८x", "content_sanskrit": "वागुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2086849, "chapter_id": 2844, "verse_number": "१२-३४९-४८", "content_sanskrit": "भोभोः सब्रह्यका देवा ऋषयश्च तपोधनाः।\nस्वागतेनार्च्य वः सर्वाञ्श्रावये वाक्यमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2086850, "chapter_id": 2844, "verse_number": "१२-३४९-४९", "content_sanskrit": "विज्ञातं वो मया कार्यं तच्च लोकहितं महत्।\nप्रवृत्तियुक्तं कर्तव्यं युष्मत्प्राणोपबृंहणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2086851, "chapter_id": 2844, "verse_number": "१२-३४९-५०", "content_sanskrit": "सुतप्तं वस्तपो देवा ममाराधनकाम्यया।\nभोक्ष्यथास्य महासत्वास्तपसः फलमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2086852, "chapter_id": 2844, "verse_number": "१२-३४९-५१", "content_sanskrit": "एष ब्रह्मा लोकगुरुः सर्वलोकपितामहः।\nयूयं च विबुधश्रेष्ठा मां यजध्वं समाहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2086853, "chapter_id": 2844, "verse_number": "१२-३४९-५२", "content_sanskrit": "सर्वे भागान्कल्पयध्वं यज्ञेषु मम नित्यशः।\nतत्र श्रेयोऽभिधास्यामि यथाऽधीकारमीश्वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2086854, "chapter_id": 2844, "verse_number": "१२-३४९-५३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2086855, "chapter_id": 2844, "verse_number": "१२-३४९-५३", "content_sanskrit": "श्रुत्वैतद्देवदेवस्य वाक्यं हृष्टतनूरुहाः।\nततस्ते विबुधाः सर्वे ब्रह्मा ते च महर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2086856, "chapter_id": 2844, "verse_number": "१२-३४९-५४", "content_sanskrit": "वेददृष्टेन विधिना वैष्णवं क्रतुमाहरन्।\nतस्मिन्सत्रे सदा ब्रह्मा स्वयं भागमकल्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2086857, "chapter_id": 2844, "verse_number": "१२-३४९-५५", "content_sanskrit": "देवा देवर्षयश्चैव स्वंस्वं भागमकल्पयम्।\nते कार्तयुगधर्माणो भागाः परमसत्कृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2086858, "chapter_id": 2844, "verse_number": "१२-३४९-५६", "content_sanskrit": "प्राहुरादित्यवर्णं तं पुरुषं तमसः परम्।\nबृहन्तं सर्वगं देवमीशानं वरदं प्रभुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2086859, "chapter_id": 2844, "verse_number": "१२-३४९-५७", "content_sanskrit": "ततोऽथ वरदौ देवस्तान्सर्वानमरान्स्थितान्।\nअशरीरो बभापेदं वाक्यं स्वस्थो महेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2086860, "chapter_id": 2844, "verse_number": "१२-३४९-५८", "content_sanskrit": "येन यः कल्पितो भागः स तथा मामुपागतः।\nप्रीतोऽहं प्रदिशाम्यद्य फलमावृत्तिलक्षणम्।\nएतद्वो लक्षणं देवा मत्प्रसादसमुद्भवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2086861, "chapter_id": 2844, "verse_number": "१२-३४९-५९", "content_sanskrit": "यूयं यज्ञैरिज्यमानाः समाप्तवरदक्षिणैः।\nयुगेयुगे भविष्यध्वं प्रवृत्तिफलभागिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2086862, "chapter_id": 2844, "verse_number": "१२-३४९-६०", "content_sanskrit": "यज्ञैर्ये चापि यक्ष्यन्ति सर्वलोकेषु वै सुराः।\nकल्पयिष्यन्ति वो भागांस्ते नरा वेदकल्पितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2086863, "chapter_id": 2844, "verse_number": "१२-३४९-६१", "content_sanskrit": "यो मे यथा कल्पितवान्भागमस्मिन्महाक्रतौ।\nस तथा यज्ञभागार्हो वेदसूत्रे मया कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2086864, "chapter_id": 2844, "verse_number": "१२-३४९-६२", "content_sanskrit": "यूयं लोकान्भावयध्वं यज्ञभागफलोचिताः।\nसर्वार्थचिन्तका लोके मयाऽधीकारनिर्मिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2086865, "chapter_id": 2844, "verse_number": "१२-३४९-६३", "content_sanskrit": "याः क्रियाः प्रचरिष्यन्ति प्रवृत्तिफलसत्कृताः।\nताभिराप्यायितबला लोकान्वै धारयिष्यथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2086866, "chapter_id": 2844, "verse_number": "१२-३४९-६४", "content_sanskrit": "यूयं हि भाविता यज्ञैः सर्वयज्ञेषु मानवैः।\nमां ततो भावयिष्यध्वमेषा वो भावना मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2086867, "chapter_id": 2844, "verse_number": "१२-३४९-६५", "content_sanskrit": "इत्यर्थं निर्मिता वेदा यज्ञाश्चौषधिभिः सह।\nएभिः सम्यक्प्रयुक्तैर्हि प्रीयन्ते देवताः क्षितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2086868, "chapter_id": 2844, "verse_number": "१२-३४९-६६", "content_sanskrit": "निर्माणमेतद्युष्माकं प्रवृत्तिगुणकल्पितम्।\nमया कृतं सुरश्रेष्ठा यवात्कल्पक्षयादिह।\nचिन्तयध्वं लोकहितं यथादीकारमीश्वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2086869, "chapter_id": 2844, "verse_number": "१२-३४९-६७", "content_sanskrit": "मरीचिरङ्गिराश्चात्रिः पुलस्त्यः पुलहः क्रतुः।\nवसिष्ठ इति सप्तैते मनसा निर्मिता हि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2086870, "chapter_id": 2844, "verse_number": "१२-३४९-६८", "content_sanskrit": "एते वेदविदो मुख्या वेदाचार्याश्च कल्पिताः।\nप्रवृत्तिधर्मिणश्चैव प्राजापत्ये च कल्पिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2086871, "chapter_id": 2844, "verse_number": "१२-३४९-६९", "content_sanskrit": "अयं क्रियावतां पन्था व्यक्तीभूतः सनातनः।\nअनिरुद्ध इति प्रोक्तो लोकसर्गकरः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2086872, "chapter_id": 2844, "verse_number": "१२-३४९-७०", "content_sanskrit": "सनः सनत्सुजातश्च सनकः समनन्दनः।\nसनत्कुमारः कपिलः सप्तमश्च सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2086873, "chapter_id": 2844, "verse_number": "१२-३४९-७१", "content_sanskrit": "सप्तैते मानसाः प्रोक्ता ऋषयो ब्रह्मणः सुताः।\nस्वयमागतविज्ञाना निवृत्तिं धर्ममास्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2086874, "chapter_id": 2844, "verse_number": "१२-३४९-७२", "content_sanskrit": "एते योगविदो मुख्याः साङ्ख्यशास्त्रविशारदाः।\nआचार्या धर्मशास्त्रेषु मोक्षधर्मप्रवर्तकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2086875, "chapter_id": 2844, "verse_number": "१२-३४९-७३", "content_sanskrit": "यतोऽहं प्रसृतः पूर्वमव्यक्तात्रिगुणो महान्।\nतस्मात्परतरो योसौ क्षेत्रज्ञ इति कल्पितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2086876, "chapter_id": 2844, "verse_number": "१२-३४९-७४", "content_sanskrit": "सोहं क्रियावतां पन्थाः पुनरावृत्तिदुर्लभः।\nयो यथा निर्मितो जन्तुर्यस्मिन्यस्मिंश्च कर्मणि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2086877, "chapter_id": 2844, "verse_number": "१२-३४९-७५", "content_sanskrit": "प्रवृत्तौ वा निवृत्तौ वा तत्फलं सोश्नुतेऽवशः।\nएष लोकगुरुर्ब्रह्मा जगदादिकरः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2086878, "chapter_id": 2844, "verse_number": "१२-३४९-७६", "content_sanskrit": "एष माता पिता चैव युष्माकं च पितामहः।\nमयाऽनुशिष्टो भविता सर्वभूतवरप्रदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2086879, "chapter_id": 2844, "verse_number": "१२-३४९-७७", "content_sanskrit": "अस्य चैवात्मजो रुद्रो ललाटाद्यः समुत्थितः।\nब्रह्मानुशिष्टो भविता सर्वभूतधरः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2086880, "chapter_id": 2844, "verse_number": "१२-३४९-७८", "content_sanskrit": "गच्छध्वं स्वानधीकारांश्चिन्तयध्वं यथाविधि।\nप्रवर्तन्तां क्रियाः सर्वाः सर्वलोकेषु माचिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2086881, "chapter_id": 2844, "verse_number": "१२-३४९-७९", "content_sanskrit": "प्रदिश्यन्तां च कर्माणि प्राणिनां गतयस्तथा।\nपरिनिष्ठितकालानि आयूंषीह सुरोत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2086882, "chapter_id": 2844, "verse_number": "१२-३४९-८०", "content_sanskrit": "इदं कृतयुगं नाम कालः श्रेष्ठः प्रवर्तितः।\nअहिंस्या यज्ञपशवो युगेऽस्मिन्न तदन्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2086883, "chapter_id": 2844, "verse_number": "१२-३४९-८१", "content_sanskrit": "चतुष्पात्सकलो धर्मो भविष्यत्यत्र वै सुराः।\nततस्त्रेतायुगं नाम त्रयी यत्र भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2086884, "chapter_id": 2844, "verse_number": "१२-३४९-८२", "content_sanskrit": "प्रोक्षिता यत्र पशवो वधं प्राप्स्यन्ति वै मखे।\nयत्र पादश्चतुर्थो वै धर्मस्य न भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2086885, "chapter_id": 2844, "verse_number": "१२-३४९-८३", "content_sanskrit": "ततो वै द्वापरं नाम मिश्रः कालो भविष्यति।\nद्विपादहीनो धर्मश्च युगे तस्मिन्भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2086886, "chapter_id": 2844, "verse_number": "१२-३४९-८४", "content_sanskrit": "ततस्तिष्येऽथ संप्राप्ते युगे कलिपुरस्कृते।\nएकपादस्थितो धर्मो यत्र तत्र भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2086887, "chapter_id": 2844, "verse_number": "१२-३४९-८५x", "content_sanskrit": "देवा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2086888, "chapter_id": 2844, "verse_number": "१२-३४९-८५", "content_sanskrit": "देवा देवर्षयश्चोचुस्तमेवंवादिनं गुरुम्।\nएकपादस्थिते धर्मे यत्र क्वचन गामिनि।\nकथं कर्तव्यमस्माभिर्भगवंस्तद्वदस्व नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2086889, "chapter_id": 2844, "verse_number": "१२-३४९-८६x", "content_sanskrit": "श्रीभगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2086890, "chapter_id": 2844, "verse_number": "१२-३४९-८६", "content_sanskrit": "`गुरवो यत्र पूज्यन्ते साधुवृत्तसमन्विताः।\nवस्तव्यं तत्र युष्माभिर्यत्र धर्मो न हीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2086891, "chapter_id": 2844, "verse_number": "१२-३४९-८७", "content_sanskrit": "यत्र वेदाश्च यज्ञाश्च तपः सत्यं दमस्तथा।\nअहिंसा धर्मसंयुक्ताः प्रचरेयुः सुरोत्तमाः।\nस वो देशः सेवितव्यो मा वोऽधर्मः पदा स्पृशेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2086892, "chapter_id": 2844, "verse_number": "१२-३४९-८८x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2086893, "chapter_id": 2844, "verse_number": "१२-३४९-८८", "content_sanskrit": "तेऽनुशिष्टा भगवता देवाः सपिगणास्तथा।\nनमस्कृत्वा भगवते जग्मुर्देशान्यथेप्सितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2086894, "chapter_id": 2844, "verse_number": "१२-३४९-८९", "content_sanskrit": "गतेषु त्रिदिवौकस्सु ब्रह्मैकः पर्यवस्थितः।\nदिदृक्षुर्भगवन्तं तमनिरुद्धतनौ स्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2086895, "chapter_id": 2844, "verse_number": "१२-३४९-९०", "content_sanskrit": "तं देवो दर्शयामास कृत्वा हयशिरो महत्।\nसाङ्गानावर्तयन्वेदान्कमण्डलुत्रिदण्डधृक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2086896, "chapter_id": 2844, "verse_number": "१२-३४९-९१", "content_sanskrit": "ततोऽश्वशिरसं दृष्ट्वातं देवममितौजसम्।\nलोककर्ता प्रभुर्ब्रह्मा लोकानां हितकाम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2086897, "chapter_id": 2844, "verse_number": "१२-३४९-९२", "content_sanskrit": "मूर्ध्ना प्रणम्य वरदं तस्थौ प्राञ्जलिरग्रतः।\nस परिष्वज्य देवेन वचनं श्रावितस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2086898, "chapter_id": 2844, "verse_number": "१२-३४९-९३x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2086899, "chapter_id": 2844, "verse_number": "१२-३४९-९३", "content_sanskrit": "लोककार्यगतीः सर्वास्त्वं चिन्तय यथाविधि।\nधाता त्वं सर्वभूतानां त्वं प्रभुर्जगतो गुरुः।\nत्वय्यावेशितभारोऽहं धृतिं प्राप्स्याम्यथाञ्जसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2086900, "chapter_id": 2844, "verse_number": "१२-३४९-९४", "content_sanskrit": "यदा च सुरकार्यं ते अविषह्यं भविष्यति।\nप्रादुर्भावं गमिष्यामि तदात्मज्ञानदैशिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2086901, "chapter_id": 2844, "verse_number": "१२-३४९-९५x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2086902, "chapter_id": 2844, "verse_number": "१२-३४९-९५", "content_sanskrit": "एवमुक्त्वा हयशिरास्तत्रैवान्तरधीयत।\nतेनानुशिष्टो ब्रह्मापि स्वं लोकमचिराद्गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2086903, "chapter_id": 2844, "verse_number": "१२-३४९-९६", "content_sanskrit": "एवमेष महाभागः पद्मनाभः सनातनः।\nयज्ञेष्वग्रहरः प्रोक्तो यज्ञधारी च नित्यदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2086904, "chapter_id": 2844, "verse_number": "१२-३४९-९७", "content_sanskrit": "निवृत्तिं चास्थितो धर्मं गमिमक्षयधर्मिणाम्।\nप्रवृत्तिधर्मान्विदधे कृत्वा लोकस्य चित्रताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2086905, "chapter_id": 2844, "verse_number": "१२-३४९-९८", "content_sanskrit": "स आदिः स मध्यः स चान्तः प्रजानां\nस धाता स धेयं स कर्ता स कार्यम्।\nयुगान्ते प्रसुप्तः सुसंक्षिप्य लोकान्\nयुगादौ प्रबुद्धो जगद्ध्युत्ससर्ज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2086906, "chapter_id": 2844, "verse_number": "१२-३४९-९९", "content_sanskrit": "तस्मै नमध्वं देवाय निर्गुणाय महात्मने।\nअजाय विश्वरूपाय धाम्ने सर्वदिवौकसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2086907, "chapter_id": 2844, "verse_number": "१२-३४९-१००", "content_sanskrit": "महाभूताधिपतये रुद्राणां पतये तथा।\nआदित्यपतये चैव वसूनां पतये तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2086908, "chapter_id": 2844, "verse_number": "१२-३४९-१०१", "content_sanskrit": "अश्विभ्यां पतये चैव मरुतां पतये तथा।\nवेदयज्ञाधिपतये वेदाङ्गपतयेऽपि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2086909, "chapter_id": 2844, "verse_number": "१२-३४९-१०२", "content_sanskrit": "समुद्रावसिने नित्यं हरये मुञ्जकेशिने।\nशान्ताय सर्वभूतानां मोक्षधर्मानुभाषिणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2086910, "chapter_id": 2844, "verse_number": "१२-३४९-१०३", "content_sanskrit": "तपसां तेजसां चैव पतये यशसामपि।\nवचसां पतये नित्यं सरितां पतये तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2086911, "chapter_id": 2844, "verse_number": "१२-३४९-१०४", "content_sanskrit": "कपर्दिने वराहाय एकशृङ्गाय धीमते।\nविवस्वतेऽश्वशिरसे चतुर्मूर्तिधृते सदा।\nसूक्ष्माय ज्ञानदृश्याय अजरायाक्षयाय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2086912, "chapter_id": 2844, "verse_number": "१२-३४९-१०५", "content_sanskrit": "एष देवः संचरति सर्वत्र गतिरव्ययः।\n[एष चैतत्परं ब्रह्म ज्ञेयो विज्ञानचक्षुषा॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2086913, "chapter_id": 2844, "verse_number": "१२-३४९-१०६", "content_sanskrit": "एवमेतत्पुरा दृष्टं मया वै ज्ञानचक्षुषा।\nकथितं तच्च वै सर्वं मया पृष्टेन तत्त्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2086914, "chapter_id": 2844, "verse_number": "१२-३४९-१०७", "content_sanskrit": "क्रियतां मद्वचः शिष्याः सेव्यतां हरिरीश्वरः।\nगीयतां वेदशब्दैश्च पूज्यतां च यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2086915, "chapter_id": 2844, "verse_number": "१२-३४९-१०८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2086916, "chapter_id": 2844, "verse_number": "१२-३४९-१०८", "content_sanskrit": "इत्युक्तास्तु वयं तेन वेदव्यासेन धीमता।\nसर्वे शिष्या सुतश्चास्य शुकः परमधर्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2086917, "chapter_id": 2844, "verse_number": "१२-३४९-१०९", "content_sanskrit": "स चास्माकमुपाध्यायः सहास्माभिर्विशांपते।\nचतुर्वेदोद्गताभिस्तमृग्भिः समभितुष्टुवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2086918, "chapter_id": 2844, "verse_number": "१२-३४९-११०", "content_sanskrit": "एतत्ते सर्वमाख्यातं यन्मां त्वं परिपृच्छसि।\nएवं मेऽकथयद्राजन्पुरा द्वैपायनो गुरुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2086919, "chapter_id": 2844, "verse_number": "१२-३४९-१११", "content_sanskrit": "यश्चेदं शृणुयान्नित्यं यश्चैनं परिकीर्तयेत्।\nनमो भगवते कृत्वा समाहितमतिर्नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2086920, "chapter_id": 2844, "verse_number": "१२-३४९-११२", "content_sanskrit": "भवत्यरोगो मतिमान्बलरूपसमन्वितः।\nआतुरो मुच्यते रोगाद्बद्धो मुच्येत बन्धनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2086921, "chapter_id": 2844, "verse_number": "१२-३४९-११३", "content_sanskrit": "कामकामी लभेत्कामं दीर्घं चायुरवाप्नुयात्।\nब्राह्मणः सर्ववेदी स्यात्क्षत्रियो विजयी भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2086922, "chapter_id": 2844, "verse_number": "१२-३४९-११४", "content_sanskrit": "वैश्यो विपुललाभः स्याच्छूद्रः सुखमवाप्नुयात्।\nअपुत्रो लभते पुत्रं कन्या चैवेप्सितं पतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2086923, "chapter_id": 2844, "verse_number": "१२-३४९-११५", "content_sanskrit": "लग्नगर्भा विमुच्येत गर्भिणी जनयेत्सुतम्।\nबन्ध्या प्रसवमाप्नोति पुत्रपौत्रसमृद्धिमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2086924, "chapter_id": 2844, "verse_number": "१२-३४९-११६", "content_sanskrit": "क्षेमेण गच्छेदध्वानमिदं यः पठते पथि।\nयो यं कामं कामयते स तमाप्नोति च ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2086925, "chapter_id": 2844, "verse_number": "१२-३४९-११७", "content_sanskrit": "इदं महर्षेर्वचनं विनिश्चितं\nमहात्मनः पुरुषवरस्य कीर्तितम्।\nसमागमं चर्षिदिवौकसामिमं\nनिशम्य भक्ताः सुसुखं लभन्ते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2086926, "chapter_id": 2844, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि नारायणीये एकोनपञ्चाशदधिकत्रिशततमोऽध्यायः॥ ३४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}]