[{"id": 2054632, "chapter_id": 2198, "verse_number": "७-१२५-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2054633, "chapter_id": 2198, "verse_number": "७-१२५-१", "content_sanskrit": "अपराह्णे महाराज सङ्ग्रामः सुमहानभूत्।\nपर्जन्यसमनिर्घोषः पुनर्द्रोणस्य सोमकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2054634, "chapter_id": 2198, "verse_number": "७-१२५-२", "content_sanskrit": "शोणाश्वं रथमास्थाय नरवीरः समाहितः।\nसमरेऽभ्यद्रवत्पाण्डूञ्जवमास्थाय मध्यमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2054635, "chapter_id": 2198, "verse_number": "७-१२५-३", "content_sanskrit": "तव प्रियहिते युक्तो महेष्वासो महाबलः।\nचित्रपुङ्खैः शितैर्बाणैः कलशोत्तमसम्भवः।\n`जघान सोमकान्राजन्सृञ्जयान्केकयानपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2054636, "chapter_id": 2198, "verse_number": "७-१२५-४", "content_sanskrit": "वरान्वरान्हि योधानां विचिन्वन्निव भारत।\nआक्रीडत रमे राजन्भारद्वाजः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2054637, "chapter_id": 2198, "verse_number": "७-१२५-५", "content_sanskrit": "तमभ्ययाद्बृहत्क्षत्रः केकयानां महारथः।\nभातॄणां नृप पञ्चानां श्रेष्ठः समरकर्कशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2054638, "chapter_id": 2198, "verse_number": "७-१२५-६", "content_sanskrit": "विमुञ्चन्विशिखांस्तीक्ष्णानाचार्यं भृशमार्दयत्।\nमहामेघो यथा वर्षं विमुञ्चन्गन्धमादने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2054639, "chapter_id": 2198, "verse_number": "७-१२५-७", "content_sanskrit": "तस्य द्रोणो महाराज स्वर्णपुङ्खाञ्शिलाशितान्।\nप्रेषयामास सङ्क्रुद्ध- सायकान्दश पञ्च च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2054640, "chapter_id": 2198, "verse_number": "७-१२५-८", "content_sanskrit": "तांस्तु द्रोणविनिर्मुक्तान्क्रुंद्धाशीविषसन्निभान्।\nएकैकं पञ्चभिर्बाणैर्युधि चिच्छेद हृष्टवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2054641, "chapter_id": 2198, "verse_number": "७-१२५-९", "content_sanskrit": "तदस्य लाघवं दृष्ट्वा प्रहस्य द्विजपुङ्गवः।\nप्रेषयामास विशिखानष्टौ सन्नतपर्वणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2054642, "chapter_id": 2198, "verse_number": "७-१२५-१०", "content_sanskrit": "तान्दृष्ट्वा पततस्तूर्णं द्रोणचापच्युताञ्शरान्।\nअवारयच्छरैरेव तावद्भिर्निशितैर्मृधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2054643, "chapter_id": 2198, "verse_number": "७-१२५-११", "content_sanskrit": "ततोऽभवन्महाराज तव सैन्यस्य विस्मयः।\nबृहत्क्षत्रेण तत्कर्म कृतं दृष्ट्वा सुदुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2054644, "chapter_id": 2198, "verse_number": "७-१२५-१२", "content_sanskrit": "ततो द्रोणो महाराज बृहत्क्षत्रं विशेषयन्।\nप्रादुश्चक्रे रणे दिव्यं ब्राह्ममस्त्रं सुदुर्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2054645, "chapter_id": 2198, "verse_number": "७-१२५-१३", "content_sanskrit": "कैकेयोऽस्त्रं समालोक्य मुक्तं द्रोणेन संयुगे।\nब्रह्मास्त्रेणैव राजेन्द्र ब्राह्ममस्त्रमशातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2054646, "chapter_id": 2198, "verse_number": "७-१२५-१४", "content_sanskrit": "ततोऽस्त्रे निहते ब्राह्मे बृहत्क्षत्रस्तु भारत।\nविव्याध ब्राह्मणं षष्ट्या स्वर्णपुङ्खैः शिलाशितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2054647, "chapter_id": 2198, "verse_number": "७-१२५-१५", "content_sanskrit": "तं द्रोणो द्विपदां श्रेष्ठो नाराचेन समार्पयत्।\nस तस्य कवचं भित्त्वा प्राविशद्धरणीतलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2054648, "chapter_id": 2198, "verse_number": "७-१२५-१६", "content_sanskrit": "कृष्णसर्पो यथा मुक्तो वल्मीकं नृपसत्तम।\nतथाऽत्यगान्महीं बाणो भित्त्वा कैकेयमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2054649, "chapter_id": 2198, "verse_number": "७-१२५-१७", "content_sanskrit": "सोऽतिविद्धो महाराज कैकेयो द्रोणसायकैः।\nक्रोधेन महताऽऽविष्टो व्यावृत्य नयने शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2054650, "chapter_id": 2198, "verse_number": "७-१२५-१८", "content_sanskrit": "द्रोणं विव्याध सप्तत्या स्वर्णपुङ्खैः शिलाशितैः।\nसारथिं चास्य बाणेन भृशं मर्मस्वताडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2054651, "chapter_id": 2198, "verse_number": "७-१२५-१९", "content_sanskrit": "द्रोणस्तु बहुभिर्विद्धो बृहत्क्षत्रेण मारिष।\nअसृजद्विशिखांस्तीक्ष्णान्कैकेयस्य रथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2054652, "chapter_id": 2198, "verse_number": "७-१२५-२०", "content_sanskrit": "व्याकुलीकृत्य तं द्रोणो बृहत्क्षत्रं महारथम्।\nअश्वांश्चतुर्भिरन्यवधीच्चतुरोऽस्य पतत्त्रिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2054653, "chapter_id": 2198, "verse_number": "७-१२५-२१", "content_sanskrit": "सूतं चैकेन बाणेन रथनीडादपातयत्।\nद्वाभ्यां ध्वजं च च्छत्रं च च्छित्त्वा भूमावपातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2054654, "chapter_id": 2198, "verse_number": "७-१२५-२२", "content_sanskrit": "ततः साधुविसृष्टेन नाराचेन द्विजर्षभः।\nहृद्यविध्यद्बृहत्क्षत्रं स च्छिन्नहृदयोऽपतत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2054655, "chapter_id": 2198, "verse_number": "७-१२५-२३", "content_sanskrit": "बृहत्क्षत्रे हते राजन्केकयानां महारथे।\nशैशुपालिरभिक्रुद्धो यन्तारमिदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2054656, "chapter_id": 2198, "verse_number": "७-१२५-२४", "content_sanskrit": "सारथे याहि यत्रैष द्रोणस्तिष्ठति दंशितः।\nविनिघ्नन्केकयान्सर्वान्पाञ्चालानां च वाहिनीं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2054657, "chapter_id": 2198, "verse_number": "७-१२५-२५", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा सारथी रथिनां वरम्।\nद्रोणाय प्रापयामास काम्भोजैर्जवनैर्हयैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2054658, "chapter_id": 2198, "verse_number": "७-१२५-२६", "content_sanskrit": "धृष्टकेतुश्च चेदीनामृषभोऽतिबलोदितः।\nवधायाभ्यद्रवद्द्रोणं पतङ्ग इव पावकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2054659, "chapter_id": 2198, "verse_number": "७-१२५-२७", "content_sanskrit": "सोऽविध्यत तदा द्रोणं षष्ट्या साश्वरथध्वजम्।\nपुनश्चान्यैः सऱैस्तीक्ष्णैः सुप्तं व्याघ्रं तुदन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2054660, "chapter_id": 2198, "verse_number": "७-१२५-२८", "content_sanskrit": "तस्य द्रोणो धनुर्मध्ये क्षुरप्रेण शितेन च॥\nचकर्त गार्ध्रपत्रेण यतमानस्य शुष्मिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2054661, "chapter_id": 2198, "verse_number": "७-१२५-२९", "content_sanskrit": "अथान्यद्धनुरादाय शैशुपालिर्महारथः।\nविव्याध सायकैर्द्रोणं कङ्कबर्हिणवाजितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2054662, "chapter_id": 2198, "verse_number": "७-१२५-३०", "content_sanskrit": "तस्य द्रोणो हयान्हत्वा चतुर्भिश्चतुरः शरैः।\nसारथेश्च शिरः कायाच्चकर्त प्रहसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2054663, "chapter_id": 2198, "verse_number": "७-१२५-३१", "content_sanskrit": "अथैनं पञ्चविंशत्या सायकानां समार्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2054664, "chapter_id": 2198, "verse_number": "७-१२५-३२", "content_sanskrit": "अवप्लुत्य रथाच्चैद्यो गदामादाय सत्वरः।\nभारद्वाजाय चिक्षेप रुपितामिव पन्नगीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2054665, "chapter_id": 2198, "verse_number": "७-१२५-३३", "content_sanskrit": "तामापतन्तीमालोक्य कालरात्रिमिवोद्यताम्।\nअश्मसारमयीं गुर्वीं तपनीयविभूषिताम्।\nशरैरनेकसाहस्रैर्भाद्वाजोऽच्छिनच्छितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2054666, "chapter_id": 2198, "verse_number": "७-१२५-३४", "content_sanskrit": "सा छिन्ना बहुभिर्बाणैभारद्वाजेन मारिष।\nगदा पपात कौरव्य नादयन्ती धरातलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2054667, "chapter_id": 2198, "verse_number": "७-१२५-३५", "content_sanskrit": "गदां विनिहतां दृष्ट्वा धृष्टकेतुरमर्षणः।\nतोमरं व्यसृजद्वीरः शक्तिं च कन कोज्ज्वलाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2054668, "chapter_id": 2198, "verse_number": "७-१२५-३६", "content_sanskrit": "तोमरं पञ्चभिर्भित्त्वा शक्तिं चिच्छेद पञ्चभिः।\nतौ जग्मतुर्महीं छिन्नौ सर्पाविव गरुत्मता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2054669, "chapter_id": 2198, "verse_number": "७-१२५-३७", "content_sanskrit": "ततोऽस्य विशिखं तीक्ष्णं वधाय वधकाङ्क्षिणः।\nप्रेषयामास समरे भारद्वाजः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2054670, "chapter_id": 2198, "verse_number": "७-१२५-३८", "content_sanskrit": "स तस्य कवचं भित्त्वा हृदयं चामितौजसः।\nअभ्यगाद्धरणीं बाणो हंसः पद्मवनं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2054671, "chapter_id": 2198, "verse_number": "७-१२५-३९", "content_sanskrit": "पतङ्गं हि ग्रसेच्चाषो यथा क्षुद्रं बुभुक्षितः।\nतथा द्रोणोऽग्रसच्छूरो धृष्टकेतुं महाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2054672, "chapter_id": 2198, "verse_number": "७-१२५-४०", "content_sanskrit": "निहते चेदिराजे तु तत्खण्डं पित्र्यमाविशत्।\nअमर्षवशमापन्नः पुत्रोऽस्य परमास्त्रवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2054673, "chapter_id": 2198, "verse_number": "७-१२५-४१", "content_sanskrit": "तमपि प्रहसन्द्रोणः शरैर्नित्ये यमक्षयम्।\nमहाव्याघ्रो महारण्ये मृगशावं यथा बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2054674, "chapter_id": 2198, "verse_number": "७-१२५-४२", "content_sanskrit": "तेषु प्रक्षीयमाणेषु पाण्डवेयेषु भारत।\nजरासन्धसुतो वीरः स्वयं द्रोणमुपाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2054675, "chapter_id": 2198, "verse_number": "७-१२५-४३", "content_sanskrit": "स तु द्रोणं महाबाहुः शरधाराभिराहवे।\nअदृश्यमकरोत्तूर्णं जलदो भास्करं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2054676, "chapter_id": 2198, "verse_number": "७-१२५-४४", "content_sanskrit": "तस्य तल्लाघवं दृष्ट्वा द्रोणः क्षत्रियमर्दनः।\nव्यसृजत्सायकांस्तूर्णं शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2054677, "chapter_id": 2198, "verse_number": "७-१२५-४५", "content_sanskrit": "छादयित्वा रमे द्रोणं रथस्थं रथिनां वरम्।\nजारासन्धिं जघानाशु मिषतां सर्वधन्विनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2054678, "chapter_id": 2198, "verse_number": "७-१२५-४६", "content_sanskrit": "योयो विधीयते खण्डस्तंतं द्रोणोऽन्तकोपमः।\nआदत्त सर्वभूतानि प्राप्ते काले यथान्तकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2054679, "chapter_id": 2198, "verse_number": "७-१२५-४७", "content_sanskrit": "ततो द्रोणो महाराज नाम विश्राव्य संयुगे।\nशरैरनेकसाहस्रैः पाण्डवेयान्समावृणोत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2054680, "chapter_id": 2198, "verse_number": "७-१२५-४८", "content_sanskrit": "ते तु नामाङ्किता बाणा द्रोणेनास्ताः शिलाशिताः।\nनरान्नागान्हयांश्चैव निजघ्नुः शतशो मृधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2054681, "chapter_id": 2198, "verse_number": "७-१२५-४९", "content_sanskrit": "ते वध्यमाना द्रोणेन शक्रेणेव महासुराः।\nसमकम्पन्त पाञ्चाला गावः शीतार्दिता इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2054682, "chapter_id": 2198, "verse_number": "७-१२५-५०", "content_sanskrit": "ततो निष्टानको घोरः पाण्डवानामजायत।\nद्रोणेन वध्यमानेषु सैन्येषु भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2054683, "chapter_id": 2198, "verse_number": "७-१२५-५१", "content_sanskrit": "प्रताप्यमानाः सूर्येण हन्यमानाश्च सायकैः।\nअन्वपद्यन्त पाञ्चालास्तदा सन्त्रस्तचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2054684, "chapter_id": 2198, "verse_number": "७-१२५-५२", "content_sanskrit": "मोहिता बाणजालेन भारद्वाजेन संयुगे।\nऊरुग्राहगृहीतानां पाञ्चालानां महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2054685, "chapter_id": 2198, "verse_number": "७-१२५-५३", "content_sanskrit": "चेदयश्च महाराज सृञ्जयाः काशिकोसलाः।\nअभ्यद्रवन्त संहृष्टा भारद्वाजं युयुत्सया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2054686, "chapter_id": 2198, "verse_number": "७-१२५-५४", "content_sanskrit": "ब्रुवन्तश्च रणेऽन्योन्यं चेदिपाञ्चालसृञ्जयाः।\nहत द्रोणं हत द्रोणमिति ते द्रोणमभ्ययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2054687, "chapter_id": 2198, "verse_number": "७-१२५-५५", "content_sanskrit": "यतन्तः पुरुपव्याघ्राः सर्वशक्त्या महाद्युतिम्।\nनिनीपवो रणे द्रोणं यमस्य सदनं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2054688, "chapter_id": 2198, "verse_number": "७-१२५-५६", "content_sanskrit": "यतमानांस्तु तान्वीरान्भारद्वाजः शिलीमुखैः।\nयमाय प्रेपयामास चेदिमुख्यान्विशेपतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2054689, "chapter_id": 2198, "verse_number": "७-१२५-५७", "content_sanskrit": "तेषु प्रक्षीयमाणेषु चेदिमुख्येषु सर्वशः।\nपाञ्चलाः समकम्पन्त द्रोणसायकपीडिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2054690, "chapter_id": 2198, "verse_number": "७-१२५-५८", "content_sanskrit": "प्राक्रोशन्भीमसेनं ते धृष्टद्युम्नं च भारत।\nदृष्ट्वा द्रोणस्य कर्माणि तथारूपाणि मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2054691, "chapter_id": 2198, "verse_number": "७-१२५-५९x", "content_sanskrit": "भीम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2054692, "chapter_id": 2198, "verse_number": "७-१२५-५९", "content_sanskrit": "ब्राह्मणेन तपो नूनं चरितं दुश्चरं महत्।\nतथा हि युधि सङ्क्रुद्धो दहति क्षत्रियर्पभान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2054693, "chapter_id": 2198, "verse_number": "७-१२५-६०", "content_sanskrit": "धर्मो युद्धं क्षत्रियस्य ब्राह्मणस्य परं तपः।\nतपस्वी कृतविद्यश्च प्रेक्षितेनापि निर्दहेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2054694, "chapter_id": 2198, "verse_number": "७-१२५-६१", "content_sanskrit": "द्रोणाग्निमस्त्रसंस्पर्शं प्रविष्टाः क्षत्रियर्पभाः।\nबहवो दुस्तरं घोरं यत्रादह्यन्त भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2054695, "chapter_id": 2198, "verse_number": "७-१२५-६२", "content_sanskrit": "यथाबलं यथोत्साहं यथासत्वं महाद्युतिः।\nमोहयन्सर्वभूतानि द्रोणो हन्ति बलानि नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2054696, "chapter_id": 2198, "verse_number": "७-१२५-६३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2054697, "chapter_id": 2198, "verse_number": "७-१२५-६३", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा क्षत्रधर्मा व्यवस्थितः।\nअर्धचन्द्रेण चिच्छेद द्रोणस्य सशरं धनुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2054698, "chapter_id": 2198, "verse_number": "७-१२५-६४", "content_sanskrit": "स संरब्धतरो भूत्वा द्रोणः क्षत्रियमर्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2054699, "chapter_id": 2198, "verse_number": "७-१२५-६५", "content_sanskrit": "अन्यत्कार्मुकमादाय भास्वरं वेगवत्तरम्।\nतत्राधाय शरं तीक्ष्णं परानीकविशातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2054700, "chapter_id": 2198, "verse_number": "७-१२५-६६", "content_sanskrit": "आकर्णपूर्णमाचार्यो बलवानभ्यवासृजत्।\nस हत्वा क्षत्रधर्माणं जगाम धरणीतलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2054701, "chapter_id": 2198, "verse_number": "७-१२५-६७", "content_sanskrit": "स भिन्नहृदयो वाहान्न्यपतन्मेदिनीतले।\nततः सैन्यान्यकम्पन्त धृष्टद्युम्नसुते हते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2054702, "chapter_id": 2198, "verse_number": "७-१२५-६८", "content_sanskrit": "अथ द्रोणं समारोहच्चेकितानो महाबलः।\nस द्रोणं दशभिर्विद्ध्वा प्रत्यविद्ध्यत्स्तनान्तरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2054703, "chapter_id": 2198, "verse_number": "७-१२५-६९", "content_sanskrit": "चतुर्भिः सारथिं चास्य चतुर्भिश्चतुरो हयान्।\nतमाचार्यस्त्रिभिर्बाणैर्बाह्वोरुरसि चार्दयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2054704, "chapter_id": 2198, "verse_number": "७-१२५-७०", "content_sanskrit": "ध्वजं सप्तभिरुन्मथ्य यन्तारमवधीत्त्रिभिः।\nतस्य सूते हते तेऽश्वा रथमादाय विद्रुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2054705, "chapter_id": 2198, "verse_number": "७-१२५-७१", "content_sanskrit": "समरे शरसंवीता भारद्वाजेन मारिष।\nचेकितानरथं दृष्ट्वा हताश्वं हतसारथिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2054706, "chapter_id": 2198, "verse_number": "७-१२५-७२", "content_sanskrit": "तान्समेतान्रणे शूरांश्चेदिपाञ्चालसृञ्जयान्।\nसमन्ताद्द्रावयन्द्रोणो बह्वशोभत मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2054707, "chapter_id": 2198, "verse_number": "७-१२५-७३", "content_sanskrit": "आकर्णपलितः श्यामो वयसाऽशीतिपञ्चकः।\nरणे पर्यचरद्द्रोणो वृद्धः षोडशवर्षवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2054708, "chapter_id": 2198, "verse_number": "७-१२५-७४", "content_sanskrit": "अथ द्रोणं महाराज विचरन्तमभीतवत्।\nवज्रहस्तममन्यन्त शत्रवः शत्रुसूदनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2054709, "chapter_id": 2198, "verse_number": "७-१२५-७५", "content_sanskrit": "ततोऽब्रवीन्महाबाहुर्द्रुपदो बुद्धिमान्नृप।\nलुब्धोऽयं क्षत्रियान्हन्ति व्याघ्रः क्षुद्रमृगानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2054710, "chapter_id": 2198, "verse_number": "७-१२५-७६", "content_sanskrit": "कृच्छ्रान्दुर्योधनो लोकान्पापः प्राप्स्यति दुर्मतिः।\nयस्य लोभाद्विनिहताः समरे क्षत्रियर्षभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2054711, "chapter_id": 2198, "verse_number": "७-१२५-७७", "content_sanskrit": "शतशः शेरते भूमौ निकृत्ता गोवृषा इव।\nरुधिरेण परीताङ्गाः श्वशृगालादनीकृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2054712, "chapter_id": 2198, "verse_number": "७-१२५-७८x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2054713, "chapter_id": 2198, "verse_number": "७-१२५-७८", "content_sanskrit": "एवमुक्त्वा महाराज द्रुपदोऽक्षौहिणीपतिः।\nपुरस्कृत्य रणे पार्थान्द्रोणमभ्यद्रवद्द्रुतम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2054714, "chapter_id": 2198, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि जयद्रथवधपर्वमि चतुर्दशदिवसयुद्धे पञ्चविंशत्यधिकशततमोऽध्यायः॥ १२५ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१२५-५० निष्टानकः कष्टस्वनः॥ ५-१२५-५२ ऊरुग्राहः ऊरुस्तम्भः॥ ५-१२५-७३ आकर्णमुपागतं पलितं केशादेः शौक्ल्यं यस्य। वयसा कालपिण्डसंयोगेन। अशीतिपञ्चकः चतुःशताब्दः॥ ५-१२५-१२५ पञ्चविंशत्यधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}]