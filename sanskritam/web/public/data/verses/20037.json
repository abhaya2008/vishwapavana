[{"id": 7000037000, "chapter_id": 20037, "verse_number": "३७-१", "content_sanskrit": "शिवस्तुति-वर्णनम् ब्रह्मोवाच अथ वृत्ते विवाहे तु भवस्यामिततेजसः ।\nप्रहर्षमतुलं गत्वा देवाः शक्रपुरोगमाः तुष्टुवुर्वाग्‌भिराद्याभिः प्रणेमुस्ते सहेश्वरम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000037001, "chapter_id": 20037, "verse_number": "३७-२", "content_sanskrit": "देवा ऊचुः नमः पर्वतलिङ्गाय पर्वतेशाय वै नमः ।\nनमः पवनवेगाय विरुपायाजिताय च ।\nनमः क्लेशविनाशाय दात्रे च शुभसम्पदाम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000037002, "chapter_id": 20037, "verse_number": "३७-३", "content_sanskrit": "नमो नीलशखण्डाय अम्बिकापतये नमः ।\nनमः पवनरूपाय शतरूपाय वै नमः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000037003, "chapter_id": 20037, "verse_number": "३७-४", "content_sanskrit": "नमोभैरवरूपाय विरूपनयनाय च ।\nनमः सहस्रनेत्राय सहस३चरणाय च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000037004, "chapter_id": 20037, "verse_number": "३७-५", "content_sanskrit": "नमो द्ववयस्याय वेदाङ्गाय नमो नमः ।\nविष्टम्भनाय शक्रस्य बाह्वोर्वेदाङ्कुराय च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000037005, "chapter_id": 20037, "verse_number": "३७-६", "content_sanskrit": "चराचराधिपतये शमनाय नमो नमः ।\nसलिलाशयलिङ्गाय युगान्ताय नमो नमः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000037006, "chapter_id": 20037, "verse_number": "३७-७", "content_sanskrit": "नमः कपालमालाय कपालसूत्रधारिणे ।\nनमः कपालहस्ताय दण्डिने गदिने नमः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000037007, "chapter_id": 20037, "verse_number": "३७-८", "content_sanskrit": "नमस्त्रैलोक्यनाथाय पशुलोकरताय च ।\nनमः खट्‌वाङ्गहस्ताय प्रमथार्त्तिहराय च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000037008, "chapter_id": 20037, "verse_number": "३७-९", "content_sanskrit": "नमो यज्ञशिरोहन्त्रे कृष्णकेशापहारिणे ।\nभगनेत्रनिपाताय पूष्णो दन्तहराय च ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000037009, "chapter_id": 20037, "verse_number": "३७-१०", "content_sanskrit": "नमः पिनाकशूलसिखङ्गमुद्‌गरधारिणे ।\nनमोऽस्तु कालकालाय तृतीयनयनाय च ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000037010, "chapter_id": 20037, "verse_number": "३७-११", "content_sanskrit": "अन्तकान्तकृते चैव नामः पर्व्वतवासिने ।\nसुवर्मरेतसे चैव नमः कुण्डलधारिमे ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000037011, "chapter_id": 20037, "verse_number": "३७-१२", "content_sanskrit": "दैत्यानां योगनाशाय योगिनां गुरेव नमः ।\nशशाङ्कादित्यनेत्राय ललाटनयनाय च ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000037012, "chapter_id": 20037, "verse_number": "३७-१३", "content_sanskrit": "नमः शमशानरतये श्मशानवरदाय च ।\nनमो दैवतनाथाय त्र्यम्बकाय नमो नमः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000037013, "chapter_id": 20037, "verse_number": "३७-१४", "content_sanskrit": "गृहस्थसाधवे नित्यं जटिले ब्रह्मचारिणे ।\nनमो मुण्डार्धमुण्डाय पशूनां पतये नमः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000037014, "chapter_id": 20037, "verse_number": "३७-१५", "content_sanskrit": "सलिले तप्यमानाय योगैश्वर्य्यप्रदाय च ।\nनमः शान्ताय दान्ताय प्रलयोत्‌पत्तिकारिणे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000037015, "chapter_id": 20037, "verse_number": "३७-१६", "content_sanskrit": "नमोऽनुग्रहकर्त्रे च स्थितिकर्त्रे नमो नमः ।\nनमो रुद्राय वसव आदित्यायाश्विने नमः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000037016, "chapter_id": 20037, "verse_number": "३७-१७", "content_sanskrit": "नमः पित्रेऽथ साङ्ख्याय विश्वेदेवाय वै नमः ।\nनमो शर्वाय उग्राय शिवाय वरदाय च ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000037017, "chapter_id": 20037, "verse_number": "३७-१८", "content_sanskrit": "नमो भीमाय सेनान्यै पशूनां पतये नमः ।\nशुचये वैरिहानाय सद्योजाताय वै नमः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000037018, "chapter_id": 20037, "verse_number": "३७-१९", "content_sanskrit": "महादेवाय चित्राय विचित्राय च वै नमः ।\nप्रधानायाप्रमेयाय कार्याय कारणाय च ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000037019, "chapter_id": 20037, "verse_number": "३७-२०", "content_sanskrit": "पुरुषाय नमस्तेऽस्तु पुरुषेच्छाकराय च ।\nनमः पुरुषसंयोगप्रधानगुणकारिणे ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000037020, "chapter_id": 20037, "verse_number": "३७-२१", "content_sanskrit": "प्रवर्त्तकाय प्रकृतेः पुरुषस्य च सर्वशः ।\nकृताकृतस्य सत्‌कर्त्रे फलसंयोगदाय च ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000037021, "chapter_id": 20037, "verse_number": "३७-२२", "content_sanskrit": "कालज्ञाय च सर्वेषां नमो नियमकारिणे ।\nनमो वैषम्यकर्त्रे च गुणानां वृत्तिदाय च ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000037022, "chapter_id": 20037, "verse_number": "३७-२३", "content_sanskrit": "नमस्ते देवदेवेश नमस्ते भूतभावन ।\nशिव सौम्यमुखो द्रष्टुं भव सौम्यो हि नः प्रभो ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000037023, "chapter_id": 20037, "verse_number": "३७-२४", "content_sanskrit": "ब्रह्मोवाच एवं स भगवान् देवो जगत्‌पतिरुमापतिः ।\nस्तूयमानः सुरैः सर्वेरमरानिदमब्रवीत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000037024, "chapter_id": 20037, "verse_number": "३७-२५", "content_sanskrit": "श्रीशङ्कर उवाच द्रष्टुं सुखश्च सौम्यश्च देवानामस्मि भोः सुराः ।\nवरं वरयत क्षिप्रं दाताऽस्मि तमसंशयम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000037025, "chapter_id": 20037, "verse_number": "३७-२६", "content_sanskrit": "ब्रह्मोवाच ततस्ते प्रणताः सर्वे सुरा ऊचुस्त्रिलोचनम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000037026, "chapter_id": 20037, "verse_number": "३७-२७", "content_sanskrit": "देव ऊचुः तवैव भगवन् हस्ते वर एषोऽवतिष्ठताम् ।\nयदा कार्यं तदा नस्त्वं दास्यसे वरमीप्सितम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000037027, "chapter_id": 20037, "verse_number": "३७-२८", "content_sanskrit": "ब्रह्मोवाच वमस्त्विति तानुक्त्वा विसृज्य च सुरान् हरः ।\nलोकांश्च प्रमथैः सार्धं विवेश भवनंस्वकम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000037028, "chapter_id": 20037, "verse_number": "३७-२९", "content_sanskrit": "यस्तु हरोत्सवमद्‌भुतमेनं गायति दैवतविप्रसमक्षम् ।\nसोऽप्रतिरूपगणेशसमानो देहविपर्य्ययमेत्य सुखी सायत् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000037029, "chapter_id": 20037, "verse_number": "३७-३०", "content_sanskrit": "ब्रह्मोवा विप्रवर्याः स्तवं हीमं श्रृणुयाद्व पठेच्च यः ।\nस सर्व्वलोकगो देवैः पूज्यतेऽमरराडिव ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]