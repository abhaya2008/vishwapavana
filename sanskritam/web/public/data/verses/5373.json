[{"id": 2205262, "chapter_id": 5373, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2205263, "chapter_id": 5373, "verse_number": "१", "content_sanskrit": "एवं कृतस्य धर्मस्य श्रोतुमिच्छाम्यहं प्रभो ।\nप्रमाणं फलमानानां तन्मे शंसितुमर्हसि\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2205264, "chapter_id": 5373, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2205265, "chapter_id": 5373, "verse_number": "२", "content_sanskrit": "प्रमाणकल्पनां देवि दानस्य शृणु भामिनि\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2205266, "chapter_id": 5373, "verse_number": "३", "content_sanskrit": "यत्सारस्तु नरो लोके तद्दानं चोत्तमं स्मृतम् ।\nसर्वदानविधिं प्राहुस्तदेव भुवि शोभने\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2205267, "chapter_id": 5373, "verse_number": "४", "content_sanskrit": "प्रस्थं सारं दरिद्रस्य शतं कोटिधनस्य च ।\nप्रस्थसारस्तु तत्प्रस्थं ददन्महदवाप्नुयात्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2205268, "chapter_id": 5373, "verse_number": "५", "content_sanskrit": "कोटिसारस्तु तां कोटिं ददान्महदवाप्नुयात् ।\nउभयं तन्महत् तच्च फलेनैव समं स्मृतम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2205269, "chapter_id": 5373, "verse_number": "६", "content_sanskrit": "धर्मार्थकामभोगेषु शक्यं दानं तु मध्यमम् ।\nस्वद्रव्यादतिहीनं तु तद्दानमधमं स्मृतम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2205270, "chapter_id": 5373, "verse_number": "७", "content_sanskrit": "शृणु दत्तस्य वै देवि पञ्चधा फलकल्पनाम् ।\nआनन्त्यं च महच्चैव समं हीनं हि पातकम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2205271, "chapter_id": 5373, "verse_number": "८", "content_sanskrit": "तेषां विशेषान् वक्ष्यामि शृणु देवि समाहिता ।\nदुस्त्यजस्य च वै दानं पात्र आनन्त्यमुच्यते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2205272, "chapter_id": 5373, "verse_number": "९", "content_sanskrit": "दानं षड्गुणयुक्तं तु महदित्यभिधीयते ।\nयथाश्रद्धं तु वै दानं यथार्हं सममुच्यते\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2205273, "chapter_id": 5373, "verse_number": "१०", "content_sanskrit": "गुणतस्तु तथा हीनं दानं हीनमिति स्मृतम् ।\nदानं पातकमित्याहुः षड्गुणानां विपर्यये\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2205274, "chapter_id": 5373, "verse_number": "११", "content_sanskrit": "देवलोके महत्कालमानन्त्यस्य फलं विदुः ।\nमहतस्तु तथा दानं स्वर्गलोके तु पूज्यते\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2205275, "chapter_id": 5373, "verse_number": "१२", "content_sanskrit": "समस्य तु तदा दानं मानुष्यं भोगमावहेत् ।\nदानं निष्फलमित्याहुर्विहीनं क्रियया शुभे\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2205276, "chapter_id": 5373, "verse_number": "१३", "content_sanskrit": "अथवा म्लेच्छदेशेषु तत्र तत्फलतां व्रजेत् ।\nनरकं प्रेत्य तिर्यक्षु गच्छेदशुभदानतः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2205277, "chapter_id": 5373, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2205278, "chapter_id": 5373, "verse_number": "", "content_sanskrit": "अशुभस्यापि दानस्य शुभं स्याच्च फलं कथम्\t॥१४", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2205279, "chapter_id": 5373, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2205280, "chapter_id": 5373, "verse_number": "१५", "content_sanskrit": "मनसा तत्त्वतः शुद्धमानृशंस्यपुरःसरम् ।\nप्रीत्या तु सर्वदानानि दत्त्वा फलमवाप्नुयात्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2205281, "chapter_id": 5373, "verse_number": "१६", "content_sanskrit": "रहस्यं सर्वदानानामेतद् विद्धि शुभेक्षणे ।\nअन्यानि सर्वकार्याणि शृणु सद्भिः कृतानि च\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2205282, "chapter_id": 5373, "verse_number": "१७", "content_sanskrit": "आरामं देवगोष्ठानि सङ्क्रमाः कूप एव च ।\nगोवाटं च तटाकं च सभाः शालाश्च सर्वशः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2205283, "chapter_id": 5373, "verse_number": "१८", "content_sanskrit": "भिक्षुकावसथाश्चैव पानीयं गोतृणानि च ।\nव्याधितानां च भैषज्यमनाथानां च भोजनम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2205284, "chapter_id": 5373, "verse_number": "१९", "content_sanskrit": "अनाथशवसंस्कारस्तीर्थमार्गविशोधनम् ।\nव्यसनाभ्यवपत्तिश्च सर्वेषां च स्वशक्तितः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2205285, "chapter_id": 5373, "verse_number": "२०", "content_sanskrit": "एतत्सर्वं समासेन धर्मकार्यमिति स्मृतम् ।\nतत् कर्तव्यं मनुष्येण स्वशक्त्या श्रद्धया शुभे\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2205286, "chapter_id": 5373, "verse_number": "२१", "content_sanskrit": "प्रेत्यभावे लभेत् पुण्यं नास्ति तत्र विचारणा ।\nरूपं सौभाग्यमारोग्यं बलं सौख्यं लभेन्नरः ।\nस्वर्गे वा मानुषे वाऽपि तैस्तैराप्यायते हि सः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2205287, "chapter_id": 5373, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2205288, "chapter_id": 5373, "verse_number": "", "content_sanskrit": "भगवन् लोकपालेश धर्मस्तु कतिभेदकः ।\nदृश्यते चरितः सद्भिस्तन्मे शंसितुमर्हसि\t॥२२", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2205289, "chapter_id": 5373, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2205290, "chapter_id": 5373, "verse_number": "२३", "content_sanskrit": "शृणु देवि समुद्देशान्नानात्वं धर्मसङ्कटे ।\nधर्मा बहुविधा लोके श्रुतिभेदमुखोद्भवाः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2205291, "chapter_id": 5373, "verse_number": "२४", "content_sanskrit": "स्मृतिधर्मश्च बहुधा सद्भिराचार इष्यते\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2205292, "chapter_id": 5373, "verse_number": "२५", "content_sanskrit": "देशधर्माश्च दृश्यन्ते कुलधर्मास्तथैव च ।\nजातिधर्माश्च वै धर्मा गणधर्माश्च शोभने\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2205293, "chapter_id": 5373, "verse_number": "२६", "content_sanskrit": "शरीरकालवैषम्यादापद्धर्मश्च दृश्यते ।\nएतद्धर्मस्य नानात्वं क्रियते लोकवासिभिः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2205294, "chapter_id": 5373, "verse_number": "२७", "content_sanskrit": "कारणात् तत्रतत्रैव फलं धर्मस्य चेष्यते ।\nतत्कारणसमायोगे लभेत् कुर्वन् फलं नरः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2205295, "chapter_id": 5373, "verse_number": "२८", "content_sanskrit": "अन्यथा न लभेत् पुण्यमतदर्हः समादिशन् ।\nएवं धर्मस्य नानात्वं फलं कुर्वल्लँभेन्नरः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2205296, "chapter_id": 5373, "verse_number": "२९", "content_sanskrit": "श्रौतः स्मार्तस्तु धर्माणां प्राकृतो धर्म उच्यते ।\nइति ते कथितं सर्वं भूयः श्रोतुं किमिच्छसि\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2205297, "chapter_id": 5373, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे धर्मफलकालकथनं नाम चतुर्विंशोत्तरद्विशततमोऽध्यायः ॥२२४॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]