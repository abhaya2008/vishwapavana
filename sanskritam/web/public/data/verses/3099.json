[{"id": 2098076, "chapter_id": 3099, "verse_number": "१३-२२९-१", "content_sanskrit": "उमोवाच।\nभगवन्सर्वलोकेश त्रिपुरार्दन शङ्कर।\nकीदृशा यमदण्डास्ते कीदृशाः परिचारकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2098077, "chapter_id": 3099, "verse_number": "१३-२२९-२", "content_sanskrit": "कथं मृतास्ते गच्छन्ति प्राणिनो यमसादनम्।\nकीदृशं भवनं तस्य कथं दण्डयति प्रजाः।\nएतत्सर्वं महादेव श्रोतुमिच्छाम्यहं प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2098078, "chapter_id": 3099, "verse_number": "१३-२२९-३x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2098079, "chapter_id": 3099, "verse_number": "१३-२२९-३", "content_sanskrit": "शृणु कल्याणि तत्सर्वं यत्ते देवि मनःप्रियम्।\nदक्षिणस्यां दिशि शुभे यमस्य सदनं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2098080, "chapter_id": 3099, "verse_number": "१३-२२९-४", "content_sanskrit": "विचित्रं रमणीयं च नानाभावसमन्वितम्।\nपितृभिः प्रेतसङ्घैश्च यमदूतैश्च सन्ततम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2098081, "chapter_id": 3099, "verse_number": "१३-२२९-५", "content_sanskrit": "प्राणिसङ्घैश्च बहुभिः कर्मवश्यैश्च पूरितम्।\nतत्रास्ते दण्डयन्नित्यं यमो लोकहिते रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2098082, "chapter_id": 3099, "verse_number": "१३-२२९-६", "content_sanskrit": "मायया सततं वेत्ति प्राणिनां यच्छुभाशुभम्।\nमायया संहरंस्तत्र प्राणिसङ्घान्यतस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2098083, "chapter_id": 3099, "verse_number": "१३-२२९-७", "content_sanskrit": "तस्य मायामयाः पाशा न वेद्यन्ते सुरासुरैः।\nको हि मानुषमात्रस्तु देवस्य चरितं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2098084, "chapter_id": 3099, "verse_number": "१३-२२९-८", "content_sanskrit": "एवं संवसतस्तस्य यमस्य परिचारकाः।\nगृहीत्वा सन्नयन्त्येव प्राणिनः क्षीणकर्मणः।\nयन केनापदेशेन त्वपदेशसमुद्भवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2098085, "chapter_id": 3099, "verse_number": "१३-२२९-९", "content_sanskrit": "कर्मणा प्राणिनो लोके उत्तमाधममध्यमाः।\nयथार्हं तान्समादाय नयन्ति यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2098086, "chapter_id": 3099, "verse_number": "१३-२२९-१०", "content_sanskrit": "धार्मिकानुत्तमान्विद्धि स्वर्गिणस्ते यथाऽमराः।\nत्रिषु जन्म लभन्ते ये कर्मणा मध्यमाः स्मृताः।\nतिर्यङनरकगन्तारो ह्यधमास्ते नराधमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2098087, "chapter_id": 3099, "verse_number": "१३-२२९-११", "content_sanskrit": "पन्थानस्त्रिविधा दृष्टाः सर्वेषां गतजीविनाम्।\nरमणीयं निराबाधं दुर्दर्शमिति नामतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2098088, "chapter_id": 3099, "verse_number": "१३-२२९-१२", "content_sanskrit": "रमणीयं तु यन्मार्गं पताकाध्वजसङ्कुलम्।\nधूपितं सिक्तसंमृष्टं पुष्पमालाभिसङ्कुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2098089, "chapter_id": 3099, "verse_number": "१३-२२९-१३", "content_sanskrit": "मनोहरं सुखस्पर्शं गच्छतामेव तद्भवेत्।\nनिराबाधं यथालोकं सुप्रशस्तं कृतं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2098090, "chapter_id": 3099, "verse_number": "१३-२२९-१४", "content_sanskrit": "तृतीयं यत्तु दुर्दर्शं दुर्गन्धि तमसा वृतम्।\nपरुषं शर्कराकीर्णं श्वदंष्ट्राबहुलं भृशम्।\nकिमिकीटसमाकीर्णं भजतामतिदुर्गमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2098091, "chapter_id": 3099, "verse_number": "१३-२२९-१५", "content_sanskrit": "मार्गैरेवं त्रिभिर्नित्यमुत्तमाधममध्यमान्।\nसन्नयन्ति यथा काले तन्मे शृणु शुचिस्मिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2098092, "chapter_id": 3099, "verse_number": "१३-२२९-१६", "content_sanskrit": "उत्तमानन्तकाले तु यमदूताः सुसंवृताः।\nनयन्ति सुखमादाय रमणीयपथेन वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2098093, "chapter_id": 3099, "verse_number": "१३-२२९-१७x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2098094, "chapter_id": 3099, "verse_number": "१३-२२९-१७", "content_sanskrit": "भगवंस्तत्र चात्मानं त्यक्तदेहं निराश्रयम्।\nअदृश्यं कथमादाय सन्नयन्ति यमान्तिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2098095, "chapter_id": 3099, "verse_number": "१३-२२९-१८x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2098096, "chapter_id": 3099, "verse_number": "१३-२२९-१८", "content_sanskrit": "शृणु भामिनि तत्स्रवं त्रिविधं देहकारणम्।\nकर्मवश्यं भोगवश्यं दुःखवश्यमिति प्रिये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2098097, "chapter_id": 3099, "verse_number": "१३-२२९-१९", "content_sanskrit": "मानुषं कर्मवश्यं स्याद्द्वितीयं भोगसाधनम्।\nतृतीयं यातनावश्यं शरीरं मायया कृतम्।\nयमलोके न चान्यत्र दृश्यते यातनायुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2098098, "chapter_id": 3099, "verse_number": "१३-२२९-२०", "content_sanskrit": "शरीरैर्यातनावश्यैर्जीवानामुच्य भामिनि।\nनयन्ति यामिकास्तत्र प्राणिनो मायया मृतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2098099, "chapter_id": 3099, "verse_number": "१३-२२९-२१", "content_sanskrit": "मध्यमान्योधवेषेण मध्यमेन पथा तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2098100, "chapter_id": 3099, "verse_number": "१३-२२९-२२", "content_sanskrit": "चण्डालवेषास्त्वधमान्गृहीत्वा भर्त्सतर्जनैः।\nआकर्षन्तस्तथा पाशैर्दुर्दर्शेन नयन्ति तान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2098101, "chapter_id": 3099, "verse_number": "१३-२२९-२३", "content_sanskrit": "त्रिविधानेवमादाय नयन्ति यमसादनम्।\nधर्मासनगतं दक्षं भ्राजमानं स्वतेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2098102, "chapter_id": 3099, "verse_number": "१३-२२९-२४", "content_sanskrit": "लोकपालं सहाध्यक्षं तथैव परिषद्गतम्।\nदर्शयन्ति महाभागे यामिकास्तं निवेद्य ते॥\nपूजयन्दण्डयन्कांश्चित्तेषां शृण्वञ्शुभाशुभम्।\nव्याहृतो बहुसाहस्रैस्तत्रास्ते सततं यमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2098103, "chapter_id": 3099, "verse_number": "१३-२२९-२६", "content_sanskrit": "गतानां तु यमस्तेषामुत्तमानभिपूजया।\nअभिसङ्गृह्य विधिवत्पृष्ट्वा स्वागतकौशलम्।\nप्रस्तुत्य तत्कृतं तेषां लोकं संदिशते यमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2098104, "chapter_id": 3099, "verse_number": "१३-२२९-२७", "content_sanskrit": "यमेनैवमनुज्ञाता यान्ति पश्चात्त्रिविष्टपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2098105, "chapter_id": 3099, "verse_number": "१३-२२९-२८", "content_sanskrit": "मध्यमानां यमस्तेषां श्रुत्वा कर्म यथातथम्।\nजायन्तां मानुषेष्वेव इति संदिशते च तान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2098106, "chapter_id": 3099, "verse_number": "१३-२२९-२९", "content_sanskrit": "अधमान्पाशसंयुक्तान्यमो नावेक्षते गतान्।\nयमस्य पुरुषा घोराश्चण्डालसमदर्शनाः।\nयातनाः प्रापयन्त्येताँल्लोकपालस्य शासनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2098107, "chapter_id": 3099, "verse_number": "१३-२२९-३०", "content_sanskrit": "भिन्दन्तश्च तुदन्तश्च प्रकर्षन्तो यतस्ततः।\nक्रोशन्तः पातयन्त्येतान्मिथो गर्तेष्ववाङ्मुखान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2098108, "chapter_id": 3099, "verse_number": "१३-२२९-३१", "content_sanskrit": "संयामिन्यः शिलास्तेषां पतन्ति शिरसि प्रिये।\nअयोमुखाः कङ्कवला भक्षयन्ति सुदारुणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2098109, "chapter_id": 3099, "verse_number": "१३-२२९-३२", "content_sanskrit": "असिपत्रवने घोरे चारयन्ति तथा परान्।\nतीक्ष्णदंष्ट्रास्तथा श्वानः कांश्चित्तत्र ह्यदन्ति वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2098110, "chapter_id": 3099, "verse_number": "१३-२२९-३३", "content_sanskrit": "तत्र वैतरणी नाम नदी ग्राहसमाकुला।\nदुष्प्रवेशा च घोरा च मूत्रशोणितवाहिनी।\nतस्यां सम्मज्जयन्त्येते तृषितान्पाययन्ति तान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2098111, "chapter_id": 3099, "verse_number": "१३-२२९-३४", "content_sanskrit": "आरोपयन्ति वै कांश्चित्तत्र कण्टकशल्मलीम्।\nयन्त्रचक्रेषु तिलवत्पीड्यन्ते तत्र केचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2098112, "chapter_id": 3099, "verse_number": "१३-२२९-३५", "content_sanskrit": "अङ्गरेषु च दह्यन्ते तथा दुष्कृतकारिणः।\nकुम्भीपाकेषु पच्यन्ते पच्यन्ते सिकतासु वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2098113, "chapter_id": 3099, "verse_number": "१३-२२९-३६", "content_sanskrit": "पाट्यन्ते तरुवच्छस्त्रैः पापिनः क्रकचादिभिः।\nभिद्यन्ते भागशः शूलैस्तुद्यन्ते सूक्ष्मसूचिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2098114, "chapter_id": 3099, "verse_number": "१३-२२९-३७", "content_sanskrit": "एवं त्वया कृतं दोषं तदर्थं दण्डनं त्विति।\nवाचैव घोषयन्ति स्म दण्डमानाः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2098115, "chapter_id": 3099, "verse_number": "१३-२२९-३८", "content_sanskrit": "एवं ते यातनां प्राप्य शरीरैर्यातनाशयैः।\nप्रसहन्तश्च तद्दुःखं स्मरन्तः स्वापराधजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2098116, "chapter_id": 3099, "verse_number": "१३-२२९-३९", "content_sanskrit": "क्रोशन्तश्च रुद्रन्तश्च न मुच्यन्ते कथञ्चन।\nस्मरन्तस्तत्र तप्यन्ते पापमात्मकृतं भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2098117, "chapter_id": 3099, "verse_number": "१३-२२९-४०", "content_sanskrit": "एवं बहुविधा दण्डा भुज्यन्ते पापकारिभिः।\nयातनाभिश्च पच्यन्ते नरकेषु पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2098118, "chapter_id": 3099, "verse_number": "१३-२२९-४१", "content_sanskrit": "अपरे यातनां भुक्त्वा मुच्यन्ते तत्र किल्बिषात्।\nपापदोषक्षयकरा यातनाः संस्मृता नृणाम्।\nबहुतप्तं यथा लोहममलं तत्तथा भवेत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2098119, "chapter_id": 3099, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकोनत्रिंशदधिकद्विशततमोऽध्यायः॥ २२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]