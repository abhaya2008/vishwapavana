[{"id": 2070168, "chapter_id": 2469, "verse_number": "११-३-०x", "content_sanskrit": "वृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2070169, "chapter_id": 2469, "verse_number": "११-३-१", "content_sanskrit": "सुमाषितं महाप्राज्ञ शोकोऽयं विगतो मम।\nभूय एव तु वाक्यानि श्रोतुमिच्छामि तत्त्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2070170, "chapter_id": 2469, "verse_number": "११-३-२", "content_sanskrit": "अनिष्टानां च संसर्गादिष्टानां च निवर्तनात्।\nकथं हि मानसं दुःखं विप्रयुज्यन्ति पण्डिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2070171, "chapter_id": 2469, "verse_number": "११-३-३x", "content_sanskrit": "विदुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2070172, "chapter_id": 2469, "verse_number": "११-३-३", "content_sanskrit": "वतोयतो मनो दुःखात्सुखाद्र विप्रमुच्यते।\nतवत्तसः शगं लब्ध्वा सुगतिं विन्दते बुधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2070173, "chapter_id": 2469, "verse_number": "११-३-४", "content_sanskrit": "अशाधतमिदं सर्वं चिन्त्यमानं नरर्षभ।\nकदलीसन्निभो लोकः सारो ह्यस्य न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2070174, "chapter_id": 2469, "verse_number": "११-३-५", "content_sanskrit": "[यदा प्राज्ञाश्च मूढाश्च धनवन्तोऽथ निर्धनाः।\nसर्वे पितृवनं प्राप्य स्वपन्ति विगतज्वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2070175, "chapter_id": 2469, "verse_number": "११-३-६", "content_sanskrit": "निर्मांसैरस्थिभूयिष्ठैर्गात्रैः स्नायुनिबन्धिभिः।\nकिं विशेषं प्रपश्यन्ति तत्र तेषां परे जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2070176, "chapter_id": 2469, "verse_number": "११-३-७", "content_sanskrit": "येन प्रत्यवगच्छेयुः कुलरूपविशेषणम्।\nकस्मादन्योन्यमिच्छन्ति विप्रलब्धधियो नराः॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2070177, "chapter_id": 2469, "verse_number": "११-३-८", "content_sanskrit": "गृहाण्येव हि मर्त्यानामाहुर्देहानि पण्डिताः।\nकालेन विनियुज्यन्ते सत्वमेकं तु शोभनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2070178, "chapter_id": 2469, "verse_number": "११-३-९", "content_sanskrit": "यथा जीर्णमजीर्णं वा वस्त्रं त्यक्त्वा तु पूरुषः।\nअन्यद्रोचयते वस्त्रमेवं देहाः शरीरिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2070179, "chapter_id": 2469, "verse_number": "११-३-१०", "content_sanskrit": "वैचित्रवीर्य सत्यं हि दुःखं वा यदि वा सुखम्।\nप्राप्नुवन्तीह भूतानि स्वकृतेनैव कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2070180, "chapter_id": 2469, "verse_number": "११-३-११", "content_sanskrit": "कर्मणा प्राप्यते स्वर्गः सुखं दुःखं च भारत।\nततो वहति तं भारमवशः स्ववशोऽपि वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2070181, "chapter_id": 2469, "verse_number": "११-३-१२", "content_sanskrit": "यथा च मृन्मयं भाण्डं चक्रारूढं विपद्यते।\nकिञ्चित्प्रक्रियमाणं वा कृतमात्रमथापि वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2070182, "chapter_id": 2469, "verse_number": "११-३-१३", "content_sanskrit": "हीनं वाऽप्यवरोप्यं वा अवतीर्णमथापि वा।\nआर्द्रं वाऽप्यथवा शुष्कं पच्यमानमथापि वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2070183, "chapter_id": 2469, "verse_number": "११-३-१४", "content_sanskrit": "अवतार्यन्तमापाङ्कादुद्धृतं चापि भारत।\nअथवा परिभुज्जन्तमेवं देहाः शरीरिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2070184, "chapter_id": 2469, "verse_number": "११-३-१५", "content_sanskrit": "गर्भस्थो वा प्रसूतो वाऽप्यथवा दशरात्रिकः।\nअर्धमासगतो वाऽपि मासमात्रगतोऽपि वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2070185, "chapter_id": 2469, "verse_number": "११-३-१६", "content_sanskrit": "संवत्सरगतो वापि द्विसंवत्सर एव वा।\nयौवनस्थोऽथ मध्यस्थो वृद्धो वापि विपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2070186, "chapter_id": 2469, "verse_number": "११-३-१७", "content_sanskrit": "प्राक्कर्मभिस्तु भूतानि भवन्ति नभवन्ति च।\nएवं संबर्धिते लोके किमर्थमनुतप्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2070187, "chapter_id": 2469, "verse_number": "११-३-१८", "content_sanskrit": "यथा तु सलिलं राजन्क्रीडार्थमनुसञ्चरन्।\nउन्मज्जेच्च निमज्जेच्च चेष्टते च नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2070188, "chapter_id": 2469, "verse_number": "११-३-१९", "content_sanskrit": "एवं संसारगहने उन्मज्जननिमज्जने।\nकर्मयोगेन बध्यन्ते क्लिश्यन्ते चाल्पबुद्धयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2070189, "chapter_id": 2469, "verse_number": "११-३-२०", "content_sanskrit": "ये तु प्राज्ञाः स्थिता मध्ये संसारान्तगतैषिणः।\nसमागमज्ञा भूतानां ते यान्ति परमां गतिम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2070190, "chapter_id": 2469, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते स्त्रीपर्वणि जलप्रदानिकपर्वणि तृतीयोऽध्यायः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]