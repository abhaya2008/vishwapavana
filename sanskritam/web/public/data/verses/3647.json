[{"id": 2123356, "chapter_id": 3647, "verse_number": "", "content_sanskrit": "द्रौपदी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2123357, "chapter_id": 3647, "verse_number": "१", "content_sanskrit": "तावत् प्रतीक्ष दुष्प्रज्ञ दुश्शासन नराधम ।\nपुरस्तात् करणीयं मे न कृतं कार्यमुत्तमम् ।\nविह्वलाऽस्मि कृताऽनेन कर्षता बलिना बलात् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2123358, "chapter_id": 3647, "verse_number": "२", "content_sanskrit": "अभिवादं करोम्येषां कूरूणां कुरुसंसदि ।\nन मे स्यादपराधोऽयं यदिदं न कृतं मया ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2123359, "chapter_id": 3647, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2123360, "chapter_id": 3647, "verse_number": "३", "content_sanskrit": "सा तेन च समुद्धूता दुःखेन च तपस्विनी ।\nपतिता विललापेदं सभायामतथोचिता ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2123361, "chapter_id": 3647, "verse_number": "", "content_sanskrit": "द्रौपदी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2123362, "chapter_id": 3647, "verse_number": "४", "content_sanskrit": "स्वयंवरे याऽस्मि नृपैर्दृष्टा रङ्गे समागतैः ।\nनदृष्टपूर्वा चान्यत्र साऽहमद्य सभां गता ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2123363, "chapter_id": 3647, "verse_number": "५", "content_sanskrit": "यां न वायुर्न चादित्यो दृष्टवन्तौ पुरा गृहे ।\nसाहमद्य सभामध्ये क्लिश्यामि कुरुसंसदि ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2123364, "chapter_id": 3647, "verse_number": "६", "content_sanskrit": "यां न मृष्यन्ति वातेन स्पृश्यमानां पुरा गृहे ।\nस्पृश्यमानां सहन्तेऽद्य पाण्डवास्तां दुरात्मना ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2123365, "chapter_id": 3647, "verse_number": "७", "content_sanskrit": "मृष्यन्ते कुरवश्चेमे मन्ये कालविपर्ययम् ।\nस्नुषां दुहितरं चैव क्लिश्यमानामनर्हतीम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2123366, "chapter_id": 3647, "verse_number": "८", "content_sanskrit": "किन्न्वतः कृपणं भूयो यदुताहं स्त्री सती शुभा ।\nसभामध्ये विगाहेऽद्य क्व नु धर्मो महीक्षिताम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2123367, "chapter_id": 3647, "verse_number": "९", "content_sanskrit": "धर्मं स्त्रियः सभां पूर्ण्णां न नयन्तीति नः श्रुतम् ।\nस नष्टः कौरवेयेषु पूर्वो धर्मः सनातनः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2123368, "chapter_id": 3647, "verse_number": "१०", "content_sanskrit": "कथं भार्या पाण्डवानां पार्षतस्य स्वसा सती ।\nवासुदेवस्य च सखी पार्थिवानां सभामिमाम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2123369, "chapter_id": 3647, "verse_number": "११", "content_sanskrit": "मामिमां धर्मराजस्य भार्यां सदृशवर्णजाम्\nब्रूत दासीमदासीं च किं करिष्यामि कौरवाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2123370, "chapter_id": 3647, "verse_number": "१२", "content_sanskrit": "अयं हि मां दृढं क्षुद्रः कौरवाणां यशोहरः ।\nक्लिश्नाति नाहं तत् सोढुं चिरं शक्ष्यामि कौरवाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2123371, "chapter_id": 3647, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2123372, "chapter_id": 3647, "verse_number": "१४", "content_sanskrit": "उक्तवानस्मि कल्याणि धर्मस्यास्य परां गतिम् ।\nलोके न शक्यते गन्तुमपि विप्रैर्महात्मभिः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2123373, "chapter_id": 3647, "verse_number": "१५", "content_sanskrit": "बलवांस्तु यथा धर्मं लोके पश्यति पूरुषः ।\nस धर्मोऽधर्मवेळायां भवत्यभिहतः परैः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2123374, "chapter_id": 3647, "verse_number": "१६", "content_sanskrit": "नहि वक्तुं तु ते प्रश्नमिमं शक्नोमि निश्चयात् ।\nसूक्ष्मत्वाद् गहनत्वाच्च कार्यस्यास्य च गौरवात् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2123375, "chapter_id": 3647, "verse_number": "१७", "content_sanskrit": "नूनमन्तः कुलस्यास्य भविता नचिरादिव ।\nतथा हि कुरवः सर्वे लोभमोहपरायणाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2123376, "chapter_id": 3647, "verse_number": "१८", "content_sanskrit": "कुले जाता हि कल्याणि व्यसनाभ्यागता भृशम् ।\nधर्म्यान्मार्गान्न च्यवन्ते यथा नस्त्वं वधूस्तथा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2123377, "chapter_id": 3647, "verse_number": "१९", "content_sanskrit": "उपपन्नं च पाञ्चालि तवेदं वृत्तमीदृशम् ।\nयत् कृच्छ्रमपि सम्प्राप्ता धर्ममेवान्ववेक्षसे ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2123378, "chapter_id": 3647, "verse_number": "२०", "content_sanskrit": "एते द्रोणादयश्चैव वृद्धा धर्मविदो जनाः ।\nशून्यैः शरीरैस्तिष्ठन्ति गतासव इवानताः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2123379, "chapter_id": 3647, "verse_number": "२१", "content_sanskrit": "युधिष्ठिरस्तु प्रश्नेऽस्मिन् प्रमाणमिति मे मतिः ।\nअजितां वा जितां वा त्वां स्वयं व्याहर्तुमर्हति ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2123380, "chapter_id": 3647, "verse_number": "२१", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि एकोननवतितमोऽध्यायः ॥८९॥\n॥ द्यूतपर्वणि एकविंशोऽध्यायः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]