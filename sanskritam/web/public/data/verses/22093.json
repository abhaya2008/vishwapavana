[{"id": 7002093000, "chapter_id": 22093, "verse_number": "१३८-१", "content_sanskrit": "ईश्वर उवाच ।\nषट्कर्माणि प्रवक्ष्यामि सर्वमन्त्रेषु तच्छृणु ।\nआदौ साध्यं लिखेत्पूर्वं चान्ते मन्त्रसमन्वितं ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002093001, "chapter_id": 22093, "verse_number": "१३८-२", "content_sanskrit": "पल्लवः स तु विज्ञेयो महोच्चाटकरः परः ।\nआदौ मन्त्रः ततः साध्यो मध्ये साध्यः पुनर्मनुः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002093002, "chapter_id": 22093, "verse_number": "१३८-३", "content_sanskrit": "योगाख्यः सम्प्रदायोऽयङ्कुलोत्सादेषु योजयेत् ।\nआदौ मन्त्रपदन्दद्यान्मध्ये साध्यं नियोजयेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002093003, "chapter_id": 22093, "verse_number": "१३८-४", "content_sanskrit": "पुनश्चान्ते लिखेन्मन्त्रं साध्यं मन्त्रपदं पुनः ।\nरोधकः सम्प्रदायस्तु स्तम्भनादिषु योजयेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002093004, "chapter_id": 22093, "verse_number": "१३८-५", "content_sanskrit": "अधोर्ध्वं याम्यवामे तु मध्ये साध्यन्तु योजयेत् ।\nसम्पुटः सतु विज्ञेयो वश्याकर्षेषु योजयेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002093005, "chapter_id": 22093, "verse_number": "१३८-६", "content_sanskrit": "मन्त्राक्षरं यदा साध्यं प्रथितञ्चाक्षराक्षरं ।\nप्रथमः सम्प्रदायः स्यादाकृष्टिवशकारकः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002093006, "chapter_id": 22093, "verse_number": "१३८-७", "content_sanskrit": "मन्त्राक्षरद्वयं लिख्य एकं साध्यक्षरं पुनः ।\nविदर्भः सतु विज्ञेयो वश्याकाकर्षेषु योजयेत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002093007, "chapter_id": 22093, "verse_number": "१३८-८", "content_sanskrit": "आकर्षणाद्यत्कर्म वसन्ते चैव कारयेत् ।\nतापज्वरे तथा वश्ये स्वाहा चाकर्षणे शुभं ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002093008, "chapter_id": 22093, "verse_number": "१३८-९", "content_sanskrit": "नमस्कारपदञ्चैव शान्तिवृद्धौ प्रयोजयेत् ।\nपौष्टिकेषु वषट्कारमाकर्षे वशकर्मणि ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002093009, "chapter_id": 22093, "verse_number": "१३८-१०", "content_sanskrit": "विद्वेषोच्चाटने मृत्यौ फट्स्यात्खण्डीकृतौ शुभे ।\nलाभादौ मन्त्रदीक्षादौ वषट्कारस्तु सिद्धिदः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002093010, "chapter_id": 22093, "verse_number": "१३८-११", "content_sanskrit": "यमोऽसि यमाराजोऽसि कालरूपोऽसि धर्मराट् ।\nमयादत्तमिमं शत्रुमचिरेण निपातय ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002093011, "chapter_id": 22093, "verse_number": "१३८-१२", "content_sanskrit": "निपातयामि यत्नेन निवृत्तो भव साधक ।\nसंहृष्टमनसा ब्रूयाद्देशिकोऽरिप्रसूदनः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002093012, "chapter_id": 22093, "verse_number": "१३८-१३", "content_sanskrit": "पद्मे शुक्ले यमं प्रार्च्य होमादेतत्प्रसिद्ध्यति ।\nआत्मानम्भैरवं ध्यात्वा ततो मध्ये कुलेश्वरीं ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002093013, "chapter_id": 22093, "verse_number": "१३८-१४", "content_sanskrit": "रात्रौ वार्तां विजानाति आत्मनश्च परस्य च ।\nदुर्गे दुर्गे रक्षणीति दुर्गां प्रार्च्यारिहा भवेत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002093014, "chapter_id": 22093, "verse_number": "१३८-१५", "content_sanskrit": "जप्त्वा हसक्षमलवरयुम्भैरवीं घातयेदरिम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]