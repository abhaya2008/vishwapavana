[{"id": 2076679, "chapter_id": 2627, "verse_number": "१२-१३२-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2076680, "chapter_id": 2627, "verse_number": "१२-१३२-१", "content_sanskrit": "हीने परमके धर्मे सर्वलोकातिलङ्घने।\nसर्वस्मिन्दस्युसाद्भूते पृथिव्यामुपजीवने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2076681, "chapter_id": 2627, "verse_number": "१२-१३२-२", "content_sanskrit": "केन स्विद्ब्राह्मणो जीवेज्जघन्ये काल आगते।\nअसंत्यजन्पुत्रपौत्राननुक्रोशात्पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2076682, "chapter_id": 2627, "verse_number": "१२-१३२-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2076683, "chapter_id": 2627, "verse_number": "१२-१३२-३", "content_sanskrit": "विज्ञानबलमास्थाय जीवितव्यं तथा गते।\nसर्वं साध्वर्थमेवेदमसाध्वर्थं न किंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2076684, "chapter_id": 2627, "verse_number": "१२-१३२-४", "content_sanskrit": "असाधुभ्योऽर्थमादाय साधुभ्यो यः प्रयच्छति।\nआत्मानं संक्रमं कृत्वा कृच्छ्रधर्मकृदेव सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2076685, "chapter_id": 2627, "verse_number": "१२-१३२-५", "content_sanskrit": "अरोषेणात्मनो राजन्राज्ये स्थितिमकोपयन्।\nअदत्तमप्याददीत् भ्रातुर्वित्तं ममेति वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2076686, "chapter_id": 2627, "verse_number": "१२-१३२-६", "content_sanskrit": "विज्ञानबलपूतो यो वर्तते निन्दितेष्वपि।\nवृत्तिविज्ञानवान्धीरः कस्तं वक्तुमिहार्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2076687, "chapter_id": 2627, "verse_number": "१२-१३२-७", "content_sanskrit": "येषां बहुकृता बुद्धिस्तेषामन्या न रोचते।\nयजसा ते प्रवर्तन्ते बलवन्तो युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2076688, "chapter_id": 2627, "verse_number": "१२-१३२-८", "content_sanskrit": "यदैव प्रकृतं शास्त्रं जनस्तदनुवर्तते।\nयदैवमध्यासेवन्ते मेध्रावी वाऽप्यथोत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2076689, "chapter_id": 2627, "verse_number": "१२-१३२-९", "content_sanskrit": "ऋत्विक्पुरोहिताचार्यान्सत्कृतानभिसत्कृतान्।\nन ब्राह्मणान्घातयीत दोषान्प्राप्नोति घातयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2076690, "chapter_id": 2627, "verse_number": "१२-१३२-१०", "content_sanskrit": "एतत्प्रमाणं लोकस्य चक्षुरेतत्सातनम्।\nतत्प्रमाणोऽवगाहेत तेन तत्साध्वसाधु वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2076691, "chapter_id": 2627, "verse_number": "१२-१३२-११", "content_sanskrit": "हवो ग्रामवास्तव्या दोषान्ब्रूयुः परस्परम्।\nन तेषां वचनाद्राजा सत्कुर्याद्धातयीत वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2076692, "chapter_id": 2627, "verse_number": "१२-१३२-१२", "content_sanskrit": "न वाच्यः परिवादो वै न श्रोतव्यः कथंचन।\nकर्णौ तत्र पिधातव्यौ गन्तव्यं वा ततोऽन्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2076693, "chapter_id": 2627, "verse_number": "१२-१३२-१३", "content_sanskrit": "न सतां शीलमेतद्वै परिवादो न पैशुनम्।\nगुणानामेव वक्तारः सन्तो नित्यं युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2076694, "chapter_id": 2627, "verse_number": "१२-१३२-१४", "content_sanskrit": "यथा समधुरौ दम्यौ सुदान्तौ साधुवाहिनौ।\nधुरमुद्यम्य वहतस्तथा वर्तेत वै नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2076695, "chapter_id": 2627, "verse_number": "१२-१३२-१५", "content_sanskrit": "यथायथाऽस्य बहवः सहायाः स्युस्तथा चरेत्।\nआचारमेव मन्यन्ते गरीयो धर्मलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2076696, "chapter_id": 2627, "verse_number": "१२-१३२-१६", "content_sanskrit": "अपरे नैवमिच्छन्ति ये शङ्खलिखिंतप्रियाः।\nअर्थे क्षीणेऽथवा लुब्धास्ते ब्रूयुर्वाक्यमीदृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2076697, "chapter_id": 2627, "verse_number": "१२-१३२-१७", "content_sanskrit": "आर्षमष्यत्र पश्यन्ति विकर्मस्थस्य पातनम्।\nन चार्षात्सदृशं किंचित्प्रमाणं दृश्यते क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2076698, "chapter_id": 2627, "verse_number": "१२-१३२-१८", "content_sanskrit": "देवा ह्यपि विकर्मस्थं घातयन्ति नराधमम्।\nव्याजेन विन्दन्वित्तं हि धर्मतः परिहीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2076699, "chapter_id": 2627, "verse_number": "१२-१३२-१९", "content_sanskrit": "सर्वतः सत्कृतः सद्भिर्भूतिप्रवरकारणैः।\nहृदयेनाभ्यनुज्ञातो यो धर्मस्तं व्यवस्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2076700, "chapter_id": 2627, "verse_number": "१२-१३२-२०", "content_sanskrit": "यश्चतुर्गुणसंपन्नं धर्मं वेद स धर्मवित्।\nअहेरिव हि धर्मस्य पदं दुःखं गवेषितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2076701, "chapter_id": 2627, "verse_number": "१२-१३२-२१", "content_sanskrit": "यथा मृगस्य विद्धस्य मृगव्याधः पदं नयेत्।\nलक्षेद्रुधिरपातेन तथा धर्मपदं नयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2076702, "chapter_id": 2627, "verse_number": "१२-१३२-२२", "content_sanskrit": "यथा सम्यग्वितेन पथा गन्तव्यमप्युत।\nराजर्षीणां वृत्तमेतदेवं गच्छ युधिष्ठिर॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2076703, "chapter_id": 2627, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि द्वात्रिंशदधिकशततमोऽध्यायः॥ १३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]