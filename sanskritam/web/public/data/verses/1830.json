[{"id": 2038179, "chapter_id": 1830, "verse_number": "५-७५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2038180, "chapter_id": 1830, "verse_number": "५-७५-१", "content_sanskrit": "तथोक्तो वासुदेवेन नित्यमन्युरमर्षणः।\nसदश्ववत्समाधावद्बभाषे तदनन्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2038181, "chapter_id": 1830, "verse_number": "५-७५-२x", "content_sanskrit": "भीमसेन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2038182, "chapter_id": 1830, "verse_number": "५-७५-२", "content_sanskrit": "अन्यथा मां चिकीर्षन्तमन्यथा मन्यसेऽच्युत।\nप्रणीतभावमत्यर्थं युधि सत्यपराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2038183, "chapter_id": 1830, "verse_number": "५-७५-३", "content_sanskrit": "वेत्सि दाशार्ह सत्यं मे दीर्घकालं सहोषितः।\nउत वा मां न जानासि प्लवन्हृद इवाप्लवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2038184, "chapter_id": 1830, "verse_number": "५-७५-४", "content_sanskrit": "तस्मादनभिरुपाभिर्वाग्भिर्मां त्वं समर्च्छसि ।\nकथं हि भीमसेनं मां जानन्कश्चन माधव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2038185, "chapter_id": 1830, "verse_number": "५-७५-५", "content_sanskrit": "ब्रूयादप्रतिरूपाणि यथा मां वक्तमर्हसि ।\nतस्मादिदं प्रवक्ष्यामि वचनं वृष्णिनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2038186, "chapter_id": 1830, "verse_number": "५-७५-६", "content_sanskrit": "आत्मनः पौरुषं चैव बलं च न समं परैः ।\nसर्वथाऽनार्यकर्मैतत्प्रशंसा स्वयमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2038187, "chapter_id": 1830, "verse_number": "५-७५-७", "content_sanskrit": "अतिवादापविद्धस्तु वक्ष्यामि बलमात्मनः ।\nपश्येमे रोदसी कृष्ण ययोरासन्निमाः प्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2038188, "chapter_id": 1830, "verse_number": "५-७५-८", "content_sanskrit": "अचले चाप्रतिष्ठे चाप्यनन्ते सर्वमातरौ ।\nयदीमे सहसा क्रुद्धे समेयातां शिले इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2038189, "chapter_id": 1830, "verse_number": "५-७५-९", "content_sanskrit": "अहमेते निगृह्णीयां बाहुभ्यां सचसाचरे ।\nपश्यैतदन्तरं बाह्वोर्महापरिघयोरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2038190, "chapter_id": 1830, "verse_number": "५-७५-१०", "content_sanskrit": "य एतत्प्राय मुच्येत न तं पश्यामि पुरूषम्।\nहिमवांश्च समुद्रश्च वज्री वा बलमित्स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2038191, "chapter_id": 1830, "verse_number": "५-७५-११", "content_sanskrit": "मयाभिपन्नं त्रायेरन्बलमास्थाय न त्रयः ।\nयुद्धार्हान्क्षत्रियान्सर्वान्पाण्डवेष्वाततायिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2038192, "chapter_id": 1830, "verse_number": "५-७५-१२", "content_sanskrit": "अधः पादतलेनैतानधिष्ठास्यामि भूतले ।\nन हि त्वं नाभिजानासि मम विक्रममच्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2038193, "chapter_id": 1830, "verse_number": "५-७५-१३", "content_sanskrit": "यथा मया विनिर्जित्य राजानो वशगाः कृताः ।\nअथ चेन्मां न जानासि सूर्यस्येवोद्यतः प्रभाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2038194, "chapter_id": 1830, "verse_number": "५-७५-१४", "content_sanskrit": "विगाढे युधि संबाधे वेत्स्यसे मां जनार्दन ।\nपरुषैराक्षिपसि किं व्रणं सूच्येव चानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2038195, "chapter_id": 1830, "verse_number": "५-७५-१५", "content_sanskrit": "यथामति ब्रवीम्येतद्विद्धि मामधिकं ततः ।\nद्रष्टासि युधि संबाधे प्रवृत्ते वैशसेऽहनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2038196, "chapter_id": 1830, "verse_number": "५-७५-१६", "content_sanskrit": "मया प्रणुन्नान्मातङ्गात्नथिनः सादनस्तथा ।\nतथा नरानभिक्रुद्धं निघ्नन्तं क्षत्रियर्षभान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2038197, "chapter_id": 1830, "verse_number": "५-७५-१७", "content_sanskrit": "द्रष्टा मां त्वं च लोकश्च विकर्षन्तं वरान्वरान् ।\nन मे सीदन्ति गात्राणि न ममोद्वेपते मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2038198, "chapter_id": 1830, "verse_number": "५-७५-१८", "content_sanskrit": "सर्वलोकादभिक्रुद्धान्न भयं विद्यते मम।\nकिं तु सौहृदमेवैतत्कृपया मधुसूदन ।\nसर्वांस्तितिक्षे संक्लेशान्मा स्म नो भरता नशन् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2038199, "chapter_id": 1830, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि पञ्चसप्ततितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]