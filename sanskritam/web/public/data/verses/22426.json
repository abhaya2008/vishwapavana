[{"id": 7002426000, "chapter_id": 22426, "verse_number": "१-८८-१", "content_sanskrit": "ब्रह्मोवाच ।\nशुक्लपक्षस्य सप्तम्यां प्राजापत्यर्क्षसंयुतः ।\nस ज्ञेयो विजयो नाम सर्वपापभयापहः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002426001, "chapter_id": 22426, "verse_number": "१-८८-२", "content_sanskrit": "तत्र कोटिगुणं सर्वफलं पुण्यस्य कर्मणः ।\nददाति भगवान्देवः पूजितश्चन्दनाधिपः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002426002, "chapter_id": 22426, "verse_number": "१-८८-३", "content_sanskrit": "स्नानं दानं जपो होमः पितृदेवादिपूजनम् ।\nनक्तं चाप्युपवासस्तु सर्वमत्र दिवाकरः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002426003, "chapter_id": 22426, "verse_number": "१-८८-४", "content_sanskrit": "कुर्यात्कोटिगुणं सर्वं पूजितो ह्यत्र गोपतिः ।\nतस्मादत्र सदा देवं पूजयेद्भक्तिमान्नरः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002426004, "chapter_id": 22426, "verse_number": "१-८८-५", "content_sanskrit": "सर्वेशं सप्तद्वीपेशं सप्तसैन्धववाहनम् ।\nसप्तम्यां तु समाराध्य सप्तप्रकृतिसम्भवम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002426005, "chapter_id": 22426, "verse_number": "१-८८-६", "content_sanskrit": "सप्तलोकाधिपत्यं तु प्राप्नुते सप्तरश्मिभिः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]