[{"id": 2015888, "chapter_id": 1335, "verse_number": "२-७६-१", "content_sanskrit": "वैशम्पायन उवाच॥\nअनुभूय तु राज्ञस्तं राजसूयं सुदुर्मतिः।\nयुधिष्ठिरस्य शकुनिर्दुर्योधसुसंयुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2015889, "chapter_id": 1335, "verse_number": "२-७६-२", "content_sanskrit": "विवेश हास्तिनपुरं दुर्योधनमतेन सः।\nवाढमित्येव शकुनिर्दृढं हृदि चकार ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2015890, "chapter_id": 1335, "verse_number": "२-७६-३", "content_sanskrit": "अस्वस्थतां चतां दृष्ट्वा धार्तराष्ट्रस्य पापकृत्।\nभारतानां च दुष्टात्मा क्षयाय हि नृपक्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2015891, "chapter_id": 1335, "verse_number": "२-७६-४", "content_sanskrit": "प्रियकृन्मतमाज्ञाय पूर्वं दुर्योधनस्य तत्।\nप्रज्ञाचक्षुषमासीनं शकुनिः सौबलस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2015892, "chapter_id": 1335, "verse_number": "२-७६-५", "content_sanskrit": "दुर्योधनवचः श्रुत्वा धृतराष्ट्रं जनाधिपम्।\nउपगम्य महाप्राज्ञं शकुनिर्वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2015893, "chapter_id": 1335, "verse_number": "२-७६-६x", "content_sanskrit": "शकुनिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2015894, "chapter_id": 1335, "verse_number": "२-७६-६", "content_sanskrit": "दुर्योधनो महाराज विवर्णो हरिणः कृशः।\nदीनश्चिन्तापरश्चैव तं विद्धि मनुजाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2015895, "chapter_id": 1335, "verse_number": "२-७६-७", "content_sanskrit": "न वै परीक्षसे सम्यगसह्यं शत्रुसंभवम्।\nज्येष्ठपुत्रस्य हृच्छोकं किमर्थं नावबुध्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2015896, "chapter_id": 1335, "verse_number": "२-७६-८", "content_sanskrit": "एवमुक्तः शकुनिना धृतराष्ट्रो जनेश्वरः।\nदुर्योधनं समाहूयं इदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2015897, "chapter_id": 1335, "verse_number": "२-७६-९x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2015898, "chapter_id": 1335, "verse_number": "२-७६-९", "content_sanskrit": "दुर्योधन कृतोमूलं भृशमार्तोऽसि पुत्रक।\nश्रोतव्यश्चेन्मया सोऽर्थो ब्रूहि मे कुरुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2015899, "chapter_id": 1335, "verse_number": "२-७६-१०", "content_sanskrit": "अयं त्वां शकुनिः प्राह विवर्णं हरिमं कृशम्।\nचिन्तयंश्च न पश्यामि शोकस्य तव सम्भवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2015900, "chapter_id": 1335, "verse_number": "२-७६-११", "content_sanskrit": "ऐश्वर्यं हि महत्पुत्र त्वयि सर्वं प्रतिष्ठितम्।\nभ्रातरः सुहृदश्चैव नाचरन्ति तवाप्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2015901, "chapter_id": 1335, "verse_number": "२-७६-१२", "content_sanskrit": "आच्छादयसि प्रावारानश्नासि पिशितौदनम्।\nआजानेया वहन्त्यश्वाः केनासि हरिणः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2015902, "chapter_id": 1335, "verse_number": "२-७६-१३", "content_sanskrit": "शयनानि महार्हाणि योषितश्च मनोरमाः।\nगुणवन्ति च वेश्मानि विहाराश्च यथासुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2015903, "chapter_id": 1335, "verse_number": "२-७६-१४", "content_sanskrit": "देवनामिव ते सर्वं वाचि बद्धं न संशयः।\nस दीन इव दुर्धर्ष कस्माच्छोचसि पुत्रक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2015904, "chapter_id": 1335, "verse_number": "२-७६-१५", "content_sanskrit": "मात्रा पित्रा च पुत्रस्य यद्वै कार्यं परं स्मृतम्।\nप्राप्तस्त्वमसि तत्तात निखिलां नः कुलश्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2015905, "chapter_id": 1335, "verse_number": "२-७६-१६", "content_sanskrit": "उपस्थितः सर्वकामैस्त्रिदिवे वासवो यथा।\nविविधैरन्नपानैश्च प्रवरैः किं नु शोचसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2015906, "chapter_id": 1335, "verse_number": "२-७६-१७", "content_sanskrit": "निरुक्तं निगमं छन्दः षडङ्गान्यस्त्रशास्त्रवान्।\nअधीती कृतविद्यस्त्वं दशव्याकरणैः कृपात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2015907, "chapter_id": 1335, "verse_number": "२-७६-१८", "content_sanskrit": "हलायुधात्कृपाद्द्रोणादस्त्रविद्यामधीतवान्।\nभ्राताज्येष्ठः स्थितो राज्ये किमु शोचसि पुत्रक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2015908, "chapter_id": 1335, "verse_number": "२-७६-१९", "content_sanskrit": "पृथग्जनैरलभ्यं यदशनाच्छादनं बहु।\nप्रभुः सन्भुञ्जसे पुत्र संस्तुतः सूतमागधैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2015909, "chapter_id": 1335, "verse_number": "२-७६-२०", "content_sanskrit": "तस्य ते विदितप्रज्ञ शोकमूलमिदं कथम्।\nलोकेस्मिञ्ज्येष्ठभागन्यस्तन्ममाचक्ष्व पृच्छतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2015910, "chapter_id": 1335, "verse_number": "२-७६-२१x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2015911, "chapter_id": 1335, "verse_number": "२-७६-२१", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा मन्दः क्रोधवशानुगः।\nपितरं प्रत्युवाचेदं स्वमतिं सम्प्रकाशयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2015912, "chapter_id": 1335, "verse_number": "२-७६-२२x", "content_sanskrit": "दुर्योधन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2015913, "chapter_id": 1335, "verse_number": "२-७६-२२", "content_sanskrit": "अश्नाम्याच्छादये चाहं यथा कुपुरुषस्तथा।\nअमर्षं धारये चोग्रं निनीषुः कालपर्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2015914, "chapter_id": 1335, "verse_number": "२-७६-२३", "content_sanskrit": "अमर्षणः स्वाः प्रकृतीरभिभूय परं स्थितः।\nक्लेशान्मुमुक्षुः परजान्स वै पुरुष उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2015915, "chapter_id": 1335, "verse_number": "२-७६-२४", "content_sanskrit": "सन्तोषो वै श्रियं हन्ति ह्यभिमानं च भारत।\nअनुक्रोशभये चोभे यैर्वृतो नाश्नुते महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2015916, "chapter_id": 1335, "verse_number": "२-७६-२५", "content_sanskrit": "न मां प्रीणाति मद्भुक्तं श्रियं दृष्ट्वा युधिष्ठेरे।\nअतिज्वलन्तीं कौन्तेये विवर्णकरणीं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2015917, "chapter_id": 1335, "verse_number": "२-७६-२६", "content_sanskrit": "सपत्नानृद्व्यतोत्मानं हीयमानं निशाम्य च।\nअदृश्यामपि कौन्तेय श्रियं पश्यन्निवोद्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2015918, "chapter_id": 1335, "verse_number": "२-७६-२७", "content_sanskrit": "तस्मादहं विवर्णश्च दीनश्च हरिमः कृशः।\nअष्टाशीतिसहस्राणि स्नातका गृहमेधिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2015919, "chapter_id": 1335, "verse_number": "२-७६-२८", "content_sanskrit": "त्रिंशद्दासीक एकैको यान्बिभर्ति युधिष्ठिरः।\nदशान्यानि सहस्राणि यतीनामूर्ध्वरेतसाम्।\nभुञ्जते रुक्मपात्रीभिर्युधिष्ठिरनिवेशने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2015920, "chapter_id": 1335, "verse_number": "२-७६-२९", "content_sanskrit": "कदलीमृगमोकानि कृष्णश्यामारुणानि च।\nकाम्भोजः प्राहिणोत्तस्मै परार्ध्यानपि कम्बलान्।\nगजयोषिद्गवाश्वस्य शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2015921, "chapter_id": 1335, "verse_number": "२-७६-३०", "content_sanskrit": "त्रिशतं चोष्ट्रवामीनां शतानि विचरन्त्युत।\nराजन्या बलिमादाय समेता हि नृपक्षये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2015922, "chapter_id": 1335, "verse_number": "२-७६-३१", "content_sanskrit": "पृथग्विधानि रत्नान पार्थिवाः पृथिवीपते।\nआहरन्क्रतुमुख्येऽस्मिन्कुन्तीपुत्राय भूरिशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2015923, "chapter_id": 1335, "verse_number": "२-७६-३२", "content_sanskrit": "न क्वचिद्धि मया तादृग्दृष्टपूर्वो न च श्रुतः।\nयादृग्धनागमो यज्ञे पाण्डुपुत्रस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2015924, "chapter_id": 1335, "verse_number": "२-७६-३३", "content_sanskrit": "असत्यं चेदिदं सर्वं सञ्जयं प्रष्टुमर्हसि।\nअपर्यन्तं धनौघं तं दृष्ट्वा शत्रोरहं नृप।\nशर्म नैवाभिगच्छामि चिन्तयानो विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2015925, "chapter_id": 1335, "verse_number": "२-७६-३४", "content_sanskrit": "ब्रह्मणा वाटधानाश्च गोमन्तः शतसङ्घशः।\nत्रिखर्वं बलिमादाय द्वारि तिष्ठन्ति वारिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2015926, "chapter_id": 1335, "verse_number": "२-७६-३५", "content_sanskrit": "कमण्डलूनुपादाय जातरूपमयाञ्शुभान्।\nत्रैखर्वाः प्रतिवेद्यास्मै लेभिरेऽथ प्रवेशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2015927, "chapter_id": 1335, "verse_number": "२-७६-३६", "content_sanskrit": "यथैव मधु शक्राय धारयन्त्यमरस्त्रियटः।\nतदस्मै कांस्यमाहार्षीद्वारुणं कलशोदधिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2015928, "chapter_id": 1335, "verse_number": "२-७६-३७", "content_sanskrit": "शङ्खप्रवरमादाय वासुदेवोऽभिषिक्तवान्।\nशक्यं रुक्मसहस्रस्य बहुरत्नविभूषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2015929, "chapter_id": 1335, "verse_number": "२-७६-३८", "content_sanskrit": "दृष्ट्वा च मम तत्सर्वं ज्वररूपमिवाभवत्।\nगृहीत्वा तत्तु गच्छन्ति समुद्रौ पूर्वदक्षिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2015930, "chapter_id": 1335, "verse_number": "२-७६-३९", "content_sanskrit": "तथैव पश्चिमं यान्ति गृहीत्वा भरतर्षभ।\nउत्तरं तु न गच्छन्ति विना तात पतत्रिणः।\nतत्र गत्वाऽर्जुनो दण्डमाजहारामितं धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2015931, "chapter_id": 1335, "verse_number": "२-७६-४०", "content_sanskrit": "कृतां बैन्दुसरै रत्नैर्मयेन स्फाटिकच्छदाम्।\nअपश्यं नलिनीं पूर्णामुदकस्येव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2015932, "chapter_id": 1335, "verse_number": "२-७६-४१", "content_sanskrit": "उत्कर्षन्तं च वासश्च प्राहसन्मां वृकोदरः।\nकिङ्कराश्च सभापाला जहसुर्भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2015933, "chapter_id": 1335, "verse_number": "२-७६-४२", "content_sanskrit": "पित्रोरर्थे विशेषेण प्रावृण्वं तत्र जीवितम्।\nतत्र त्म यदि शक्तः स्यां घातयेयं वृकोदरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2015934, "chapter_id": 1335, "verse_number": "२-७६-४३", "content_sanskrit": "सपत्नेनापहासो हि स मां दहति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2015935, "chapter_id": 1335, "verse_number": "२-७६-४४", "content_sanskrit": "तत्र स्फाटिकतोयां हि स्फाटिकाम्बुजशोभिताम्।\nसभां पुष्करिणीं मत्वा पतितोऽस्मि नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2015936, "chapter_id": 1335, "verse_number": "२-७६-४५", "content_sanskrit": "तत्र मामहसद्भीमः सह पार्थेन सस्वरम्।\nद्रौपदी चसह स्त्रीभिः पातयन्ती मनो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2015937, "chapter_id": 1335, "verse_number": "२-७६-४६", "content_sanskrit": "क्लिन्नवस्त्रस्य च जले किङ्करा राजचोदिताः।\nददुर्वासांसि मेऽन्यानि तच्च दुःखतरं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2015938, "chapter_id": 1335, "verse_number": "२-७६-४७", "content_sanskrit": "अस्तम्भा इव तिष्ठन्ति स्तम्भा इव सहस्रशः।\nसोहं तत्राहतो राजन्स्फटिकाभ्यन्तरे विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2015939, "chapter_id": 1335, "verse_number": "२-७६-४८", "content_sanskrit": "अद्वारेण विनिर्गच्छन्द्वारसंस्थानरूपिणा।\nअभिहत्य शिलां भूयो ललाटेनास्मि विक्षतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2015940, "chapter_id": 1335, "verse_number": "२-७६-४९", "content_sanskrit": "आमृशन्निव तां दृष्ट्वा मार्गान्तरमुपाविशम्।\nइदं द्वारमिदं राजन्नद्वारमिति मां प्रति।\nअद्भुतं प्रहसन्वाक्यं बभाषे स वृकोदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2015941, "chapter_id": 1335, "verse_number": "२-७६-५०", "content_sanskrit": "स्त्रियश्च तत्र मां दृष्ट्वा जहसुस्तादृशं नृप।\nसर्वं हासकरं तेषां सदस्यानां नरर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2015942, "chapter_id": 1335, "verse_number": "२-७६-५१", "content_sanskrit": "न श्रुतानि न दृष्टानि यानि रत्नान मे क्वचित्।\nतानि मे तत्र दृष्टानि तेन तप्तोस्मि दुःखितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2015943, "chapter_id": 1335, "verse_number": "२-७६-५२", "content_sanskrit": "हुताशनं प्रवेक्ष्यामि प्रवेक्ष्यामि महोदधिम्।\nसम्भावितस्य चाकीर्तिर्मरणादतिरिच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2015944, "chapter_id": 1335, "verse_number": "२-७६-५३", "content_sanskrit": "इदं चाद्भुतमत्रासीत्तन्मे निगदतः शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2015945, "chapter_id": 1335, "verse_number": "२-७६-५४", "content_sanskrit": "पूर्णे शतसहस्रे तु विप्राणां भुञ्जतां सदा।\nस्थापितस्तत्र सञ्ज्ञार्थं शङ्खो ध्मायति नित्यसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2015946, "chapter_id": 1335, "verse_number": "२-७६-५५", "content_sanskrit": "मुहुर्मुहुः प्रणदतस्तस्य शङ्खस्य भारत।\nअनिशं शब्दमश्रौषं ततो रोमाणि मेऽहृषन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2015947, "chapter_id": 1335, "verse_number": "२-७६-५६", "content_sanskrit": "पार्थिवैर्बहुभिः कीर्णमुपस्थानं दिदृक्षुभिः।\nअशोभत महाराज नक्षत्रैर्द्यैरिवामला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2015948, "chapter_id": 1335, "verse_number": "२-७६-५७", "content_sanskrit": "सर्वरत्नान्युपादाय पार्थिवा वै जनेश्वर।\nयज्ञे तस्य महाराज पाण्डुपुत्रस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2015949, "chapter_id": 1335, "verse_number": "२-७६-५८", "content_sanskrit": "वैश्या इव महीपाला द्विजातिपरिवेषकाः।\nन सा श्रीर्देवराजस्य यमस्य वरुणस्य च।\nगुह्यकाधिपतेर्वापि या श्री राजन्युधिष्ठिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2015950, "chapter_id": 1335, "verse_number": "२-७६-५९", "content_sanskrit": "तां दृष्ट्वा पाण्डुपुत्रस्य श्रियं परमिक्रामहम्।\nशान्तिं न परिगच्छामि दह्यमानेन चेतसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2015951, "chapter_id": 1335, "verse_number": "२-७६-६०", "content_sanskrit": "अप्राप्य पाण्डवैश्वर्यं शमो मम न विद्यते।\nअरीन्बाणैः शाययिष्ये शयिष्ये वा हतः परैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2015952, "chapter_id": 1335, "verse_number": "२-७६-६१", "content_sanskrit": "एतादृशस्य मे किं तु जीवितेन परन्तप।\nवर्धन्ते पाण्डवा राजन्वयं हि स्थितवृद्धयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2015953, "chapter_id": 1335, "verse_number": "२-७६-६२x", "content_sanskrit": "शकुनिरुवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2015954, "chapter_id": 1335, "verse_number": "२-७६-६२", "content_sanskrit": "यामेतामतुलां लक्ष्मीं दृष्टवानसि पाण्डवे।\nतस्याटः प्राप्तावुपायं मे शृणु सत्यपराक्रम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2015955, "chapter_id": 1335, "verse_number": "२-७६-६३", "content_sanskrit": "अहमक्षेष्वभिज्ञोऽस्मि पृथिव्यामपि भारत।\nहृदयज्ञः पणज्ञश्च विशेषज्ञश्च देवने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2015956, "chapter_id": 1335, "verse_number": "२-७६-६४", "content_sanskrit": "द्यूतप्रियश्च कौन्तेयो न च जानाति देवितुम्।\nआहूतश्चैष्यति व्यक्तं नित्यमेवाह्वयत्स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2015957, "chapter_id": 1335, "verse_number": "२-७६-६५", "content_sanskrit": "नियतं तं विजेष्यामि कृत्वा तु कपटं विभो।\nआनयामि समृद्धिं तां दिव्यां चोपाह्वयस्व तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2015958, "chapter_id": 1335, "verse_number": "२-७६-६६x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2015959, "chapter_id": 1335, "verse_number": "२-७६-६६", "content_sanskrit": "एवमुक्तः शकुनिना राजा दुर्योधनस्ततः।\nधृतराष्ट्रमिदं वाक्यमपदान्तरमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2015960, "chapter_id": 1335, "verse_number": "२-७६-६७", "content_sanskrit": "अयमुत्सहते राजञ्श्रियमाहर्तुमक्षवित्।\nद्यूतेन पाण्डुपुत्रस्य तदनुज्ञातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2015961, "chapter_id": 1335, "verse_number": "२-७६-६८x", "content_sanskrit": "धृतराष्ट्र उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2015962, "chapter_id": 1335, "verse_number": "२-७६-६८", "content_sanskrit": "क्षत्ता मन्त्री महाप्राज्ञः स्थितो यस्यास्मि शासने।\nतेन सङ्गम्य वेत्स्यामि कार्यस्यास्य विनिश्चयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2015963, "chapter_id": 1335, "verse_number": "२-७६-६९", "content_sanskrit": "स हि धर्मं पुरस्कृत्य दीर्घदर्शी परं हितम्।\nउभयोटः पक्षयोर्युक्तं वक्ष्यत्यर्थविनिश्चयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2015964, "chapter_id": 1335, "verse_number": "२-७६-७०x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2015965, "chapter_id": 1335, "verse_number": "२-७६-७०", "content_sanskrit": "निवर्तयिष्यति त्वाऽसौ यदि क्षत्ता समेष्यति।\nनिवृत्ते त्वयि राजेन्द्र मरिष्येऽहमसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2015966, "chapter_id": 1335, "verse_number": "२-७६-७१", "content_sanskrit": "स त्वं मयि मृते राजन्विदुरेण सुखी भव।\nभोक्ष्यसे पृथिवीं कृत्स्नां किं मया त्वं करिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2015967, "chapter_id": 1335, "verse_number": "२-७-७२x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2015968, "chapter_id": 1335, "verse_number": "२-७६-७२", "content_sanskrit": "आर्तवाक्यं तु तत्तस्य प्रणयोक्तं निशम्य सः।\nधृतराष्ट्रोऽब्रवीत्प्रेष्यन्दुर्योधनमते स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2015969, "chapter_id": 1335, "verse_number": "२-७६-७३", "content_sanskrit": "स्थूणासहस्रैर्बृहतीं शतद्वारां सभां मम।\nमनोरमां दर्शनीयामाशु कुर्वन्तुं शिल्पिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2015970, "chapter_id": 1335, "verse_number": "२-७६-७४", "content_sanskrit": "ततः संस्तीर्य रत्नैस्तां तक्ष्ण आनाय्य सर्वशः।\nसुकृतां सुप्रवेशां च निवेदयत मेऽशनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2015971, "chapter_id": 1335, "verse_number": "२-७६-७५", "content_sanskrit": "दूर्योधनस्य शान्त्यर्थमिति निश्चित्य भूमिपः।\nधृतराष्ट्रो महाराज प्राहिणोद्विदुराय वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2015972, "chapter_id": 1335, "verse_number": "२-७६-७६", "content_sanskrit": "अपृष्ट्वा विदुरं स्वस्यन नासीत्कश्चिद्विनिश्चयः।\nद्यूते दोषांश्च जानन्स पुत्रस्नेहादकृष्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2015973, "chapter_id": 1335, "verse_number": "२-७६-७७", "content_sanskrit": "तच्छ्रुत्वा विदुरो धीमान्कलिद्वारमुपस्थितम्।\nविनाशमुखमुत्पन्नं धृतराष्ट्रमुपाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2015974, "chapter_id": 1335, "verse_number": "२-७६-७८", "content_sanskrit": "सोऽभिगम्य महात्मानं भ्राता भ्रातरमग्रजम्।\nमूर्ध्ना प्रणम्य चरणाविदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2015975, "chapter_id": 1335, "verse_number": "२-७६-७९x", "content_sanskrit": "विदुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2015976, "chapter_id": 1335, "verse_number": "२-७६-७९", "content_sanskrit": "नाभिनन्दामि ते राजन्व्यवसायमिमं प्रभो।\nपुत्रैर्भेदो यथा न स्थाद्द्यूतहेतोस्तथा कुरु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2015977, "chapter_id": 1335, "verse_number": "२-७६-८०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2015978, "chapter_id": 1335, "verse_number": "२-७६-८०", "content_sanskrit": "क्षत्तः पुत्रेषु पुत्रैर्मे कलहो न भविष्यति।\nयदि देवाः प्रसादं नः करिष्यन्ति न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2015979, "chapter_id": 1335, "verse_number": "२-७६-८१", "content_sanskrit": "अशुभं वा शुभं वापि हितं वा यदि वाऽहितम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2015980, "chapter_id": 1335, "verse_number": "२-७६-८२", "content_sanskrit": "मयि सन्निहिते द्रोणे भीष्मे त्वयि च भारत।\nअनयो दैवविहितो न कथञ्चिद्भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2015981, "chapter_id": 1335, "verse_number": "२-७६-८३", "content_sanskrit": "गच्छ त्वं रथमास्थाय हयैर्वातसमैर्जवे।\nखाण्डवप्रस्थमद्यैव समानय युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2015982, "chapter_id": 1335, "verse_number": "२-७६-८४", "content_sanskrit": "न वाच्यो व्यवसायो मे विदुरैतद्ब्रवीमि ते।\nदैवमेव परं मन्ये येनैतदुपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2015983, "chapter_id": 1335, "verse_number": "२-७६-८५", "content_sanskrit": "इत्युक्तो विदुरो धीमान्नेदमस्तीति चिन्तयन्।\nआपगेयं महाप्राज्ञमभ्यगच्छत्सुदुः खितः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2015984, "chapter_id": 1335, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि द्यूतपर्वणि षट्सप्ततितमोऽध्यायः॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}]