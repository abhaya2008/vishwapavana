[{"id": 900000607, "chapter_id": 8177, "verse_number": "4.1", "content_sanskrit": "न च श्रवणाद्यनवृत्त्यापरोक्षज्ञानोदये सर्वेषां सुशक्यत्वमिति गुणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900000608, "chapter_id": 8177, "verse_number": "4.2", "content_sanskrit": "न च वाक् पूर्वरूपं मन उत्तररूपं \"मनः पूर्वरूपं वागुत्तररूपम्'", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900000609, "chapter_id": 8177, "verse_number": "4.3", "content_sanskrit": "न च तत्र तत्र मार्गस्यान्यथोक्तेरधिकारिभेदेन पृथङ्मार्गसुक्रमोपपत्तिरिति वाच्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900000610, "chapter_id": 8177, "verse_number": "4.4", "content_sanskrit": "न च एतं सेतुं तीर्त्वा' इत्यत्रातिक्रमोक्ते र्मुक्तो ब्रह्म तीत्वा गच्छतीति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}]