[{"id": 7003496000, "chapter_id": 23496, "verse_number": "१३६-१", "content_sanskrit": "अथ प्रायश्चित्तकर्मसूत्रम्।\nश्रीवराह उवाच ।\nदीपं स्पृष्ट्वा तु यो देवि मम कर्माणि कारयेत् ।\nतस्यापराधाद्वै भूमे पापं प्राप्नोति मानवः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003496001, "chapter_id": 23496, "verse_number": "१३६-२", "content_sanskrit": "तच्छृणुष्व महाभागे कथ्यमानं मयाऽनघे।\nजायते षष्टिवर्षाणि कुष्ठी गात्रपरिप्लुत ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003496002, "chapter_id": 23496, "verse_number": "१३६-३", "content_sanskrit": "चाण्डालस्य गृहे तत्र एवमेतन्न संशयः ।\nएवं भुक्त्वा तु तत्कर्म मम क्षेत्रे मृतो यदि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003496003, "chapter_id": 23496, "verse_number": "१३६-४", "content_sanskrit": "मद्भक्तश्चैव जायेत शुद्धे भागवते गृहे ।\nप्रायश्चित्तं प्रवक्ष्यामि दीपस्य स्पर्शनाद्भुवि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003496004, "chapter_id": 23496, "verse_number": "१३६-५", "content_sanskrit": "तरन्ति मनुजा येन कष्टं चाण्डालयोनिषु ।\nयस्य कस्यापि मासस्य शुक्लपक्षे च द्वादशी ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003496005, "chapter_id": 23496, "verse_number": "१३६-६", "content_sanskrit": "चतुर्थभक्तमाहारमाकाशशयने स्वपेत् ।\nदीपं दत्त्वापराधाद्वै तरन्ति मनुजा भुवि ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003496006, "chapter_id": 23496, "verse_number": "१३६-७", "content_sanskrit": "शुचिर्भूत्वा यथान्यायं मम कर्मपथे स्थितः ।\nएतत्ते कथितं भद्रे स्पर्शने दीपकस्य तु ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003496007, "chapter_id": 23496, "verse_number": "१३६-८", "content_sanskrit": "संसारशोधनं चैव यत्कृत्वा लभते शुभम् ।\nश्मशानं यो नरो गत्वा अस्नात्वैव तु मां स्पृशेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003496008, "chapter_id": 23496, "verse_number": "१३६-९", "content_sanskrit": "मम दोषापराधस्य शृणु तत्त्वेन यत्फलम् ।\nजम्बुको जायते भूमौ वर्षाणां नव पंच च ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003496009, "chapter_id": 23496, "verse_number": "१३६-१०", "content_sanskrit": "गृध्रस्तु सप्त वर्षाणि जायते खचरेश्वरः ।\nचरन्तौ मानुषं मांसमुभौ तौ गृध्रजम्बुकौ ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003496010, "chapter_id": 23496, "verse_number": "१३६-११", "content_sanskrit": "पिशाचो जायते तत्र वर्षाणि नव पंच च ।\nततस्तु कुणपोच्छिष्टं त्रिंशद्वर्षाणि खादति ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003496011, "chapter_id": 23496, "verse_number": "१३६-१२", "content_sanskrit": "ततो नारायणाच्छ्रुत्वा धरणी वाक्यमब्रवीत् ।\nएतन्मे परमं गुह्यं लोकनाथ जनार्दन ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003496012, "chapter_id": 23496, "verse_number": "१३६-१३", "content_sanskrit": "परं कौतूहलं देव निखिलं वक्तुमर्हसि ।\nश्मशानं पुण्डरीकाक्ष ईश्वरेण प्रशंसितम्॥ १३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003496013, "chapter_id": 23496, "verse_number": "१३६-१४", "content_sanskrit": "किन्त्वत्र त्रिगुणं देव पवित्रे शिवभाषिते ।\nस तव रमते नित्यं भगवांस्तु महामतिः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003496014, "chapter_id": 23496, "verse_number": "१३६-१५", "content_sanskrit": "कपालं गृह्य देवोऽत्र दीप्तिमन्तं महौजसम् ।\nप्रशंसितं च रुद्रेण भवता किं विनिन्दितम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003496015, "chapter_id": 23496, "verse_number": "१३६-१६", "content_sanskrit": "श्मशानं पद्मपत्राक्ष रुद्रस्य च निशि प्रियम् ।\nश्रीवराह उवाच ।\nशृणु तत्त्वेन मे देवि इदमाख्यानमुत्तमम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003496016, "chapter_id": 23496, "verse_number": "१३६-१७", "content_sanskrit": "अद्यापि ते न जानन्ति ह्यनघे संशितव्रताः ।\nकृत्वा सुदुष्करं कर्म सर्वभूतपतिं हरिम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003496017, "chapter_id": 23496, "verse_number": "१३६-१८", "content_sanskrit": "हत्वा च बालान्वृद्धांश्च त्रिपुरे रूपिणीः स्त्रियः ।\nतेन पापेन सम्बद्धो न शक्नोति विचेष्टितुम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003496018, "chapter_id": 23496, "verse_number": "१३६-१९", "content_sanskrit": "प्रणष्टमानसैश्वर्यो नष्टा माया च योगिनः ।\nविवर्णवदनो भूत्वा तिष्ठते स महेश्वरः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003496019, "chapter_id": 23496, "verse_number": "१३६-२०", "content_sanskrit": "तत्र स्थाने शिवो भूमे गणैः सर्वैः समावृतः ।\nनष्टमायं ततो देवि चिन्तयामि वसुन्धरे ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003496020, "chapter_id": 23496, "verse_number": "१३६-२१", "content_sanskrit": "ततो ध्यातो मया देवि शङ्करः पुनरेष्यति ।\nयावत्पश्यामि तं देवं देवि दिव्येन चक्षुषा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003496021, "chapter_id": 23496, "verse_number": "१३६-२२", "content_sanskrit": "नष्टं मायाबलं रुद्रं सर्वभूतमहेश्वरम् ।\nततोऽहं तत्र गत्वा तु यष्टुकामं त्रियम्बकम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003496022, "chapter_id": 23496, "verse_number": "१३६-२३", "content_sanskrit": "नष्टसंज्ञो हतज्ञानो नष्टयोगबलोऽबलः ।\nतत ईशो मया चोक्तो वाक्यमेवं सुखावहम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003496023, "chapter_id": 23496, "verse_number": "१३६-२४", "content_sanskrit": "किमिदं तिष्ठसे रुद्र कश्मलेन समावृतः ।\nत्वं कर्त्ता च विकर्त्ता च विकाराकार एव च ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003496024, "chapter_id": 23496, "verse_number": "१३६-२५", "content_sanskrit": "त्वं वैशाख्यं वियोगं च त्वं योनिस्त्वं परायणम् ।\nत्वमुग्रदेवदेवादिस्त्वं साम त्वं तथा दिशः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003496025, "chapter_id": 23496, "verse_number": "१३६-२६", "content_sanskrit": "किं न बुध्यति चात्मानं गणैः परिवृतो भवान् ।\nकिमिदं देवदेवेश विवर्णः पृथुलोचनः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003496026, "chapter_id": 23496, "verse_number": "१३६-२७", "content_sanskrit": "तन्ममाचक्ष्व तत्त्वेन यत्पृष्टोसि मया भवान् ।\nस्मर योगं च मायां च पश्य विष्णोर्महात्मनः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003496027, "chapter_id": 23496, "verse_number": "१३६-२८", "content_sanskrit": "तव चैव प्रियार्थाय येनाहमिह चागतः ।\nततो मम वचः श्रुत्वा लब्धसंज्ञो महेश्वरः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003496028, "chapter_id": 23496, "verse_number": "१३६-२९", "content_sanskrit": "उवाच मधुरं वाक्यं पापसन्तप्तलोचनः ।\nश्रृणु तत्त्वेन मे देव कोऽन्योऽप्येवं करिष्यति ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003496029, "chapter_id": 23496, "verse_number": "१३६-३०", "content_sanskrit": "देवं नारायणं चैकं सर्वलोकमहेश्वरम् ।\nहे विष्णो त्वत्प्रसादेन देवत्वं चैव माधव ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003496030, "chapter_id": 23496, "verse_number": "१३६-३१", "content_sanskrit": "लब्धो योगश्च साङ्ख्यं च जातोऽस्मि विगतज्वरः ।\nत्वत्प्रसादेन जातोऽस्मि पूर्णाम्बुरिव सागरः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003496031, "chapter_id": 23496, "verse_number": "१३६-३२", "content_sanskrit": "अहं त्वां तु विजानामि मां त्वं जानासि माधव ।\nआवयोरन्तरं कोऽपि न पश्यति जनार्दन ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003496032, "chapter_id": 23496, "verse_number": "१३६-३३", "content_sanskrit": "ब्रह्माणं तु विजानाति नावयोरन्तरेण हि ।\nसाधु विष्णो महाभाग सर्वमायाकरण्डक ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003496033, "chapter_id": 23496, "verse_number": "१३६-३४", "content_sanskrit": "एवं मह्यं हरो वाक्यमुक्त्वा भूतमहेश्वरः ।\nमुहूर्त्तं ध्यानमास्थाय पुनः प्रोवाच माधवि ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003496034, "chapter_id": 23496, "verse_number": "१३६-३५", "content_sanskrit": "तव विष्णो प्रसादेन मया तत्त्रिपुरं हतम् ।\nनिहता दानवास्तत्र गर्भिण्यश्च निपातिताः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003496035, "chapter_id": 23496, "verse_number": "१३६-३६", "content_sanskrit": "बालवृद्धा हतास्तत्र विस्फुरन्तो दिशो दश ।\nतस्य पापस्य दोषेण न शक्नोमि विचेष्टितुम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003496036, "chapter_id": 23496, "verse_number": "१३६-३७", "content_sanskrit": "प्रणष्टयोगमायश्च नष्टैश्वर्यश्च माधव ।\nकि कर्त्तव्यं मया विष्णो पापावस्थेन सम्प्रति ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003496037, "chapter_id": 23496, "verse_number": "१३६-३८", "content_sanskrit": "विष्णो तत्त्वेन मे ब्रूहि शोधनं पाप नाशनम् ।\nयेन वै कृतमात्रेण शुद्धो मुच्येत किल्बिषात् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003496038, "chapter_id": 23496, "verse_number": "१३६-३९", "content_sanskrit": "एवं चिन्तात्मनस्तस्य मया रुद्रस्य भाषितम् ।\nकपालमालां गृहीत्वा समलं गच्छ शङ्कर ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003496039, "chapter_id": 23496, "verse_number": "१३६-४०", "content_sanskrit": "ममैवं वचनं श्रुत्वा भगवान्परमेश्वरः ।\nउवाच मां पुनर्व्यक्तं मां बोधय जगत्पते ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003496040, "chapter_id": 23496, "verse_number": "१३६-४१", "content_sanskrit": "कीदृशः समलो विष्णो यत्र गच्छामहे वयम् ।\nततस्तस्य वचः श्रुत्वा शङ्करस्य महेश्वरि ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003496041, "chapter_id": 23496, "verse_number": "१३६-४२", "content_sanskrit": "तत्पापशोधनार्थाय मया वाक्यं प्रभाषितम् ।\nश्मशानं समलं रुद्र पूतिको व्रणगन्धिकः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003496042, "chapter_id": 23496, "verse_number": "१३६-४३", "content_sanskrit": "स्वयं तिष्ठन्ति वै तत्र मनुजा विगतस्पृहः ।\nतत्र गृह्य कपालानि रम तत्रैव शङ्कर ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003496043, "chapter_id": 23496, "verse_number": "१३६-४४", "content_sanskrit": "तत्र वर्षसहस्राणि दिव्यान्येव दृढव्रतः ।\nततो भक्षय मांसानि पापक्षयचिकीर्षुकः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003496044, "chapter_id": 23496, "verse_number": "१३६-४५", "content_sanskrit": "हतानां चैव मांसानि ये च भोज्यास्तव प्रियाः ।\nएवं सर्वैर्गणैः सार्द्धं वस तत्र सुनिश्चितः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003496045, "chapter_id": 23496, "verse_number": "१३६-४६", "content_sanskrit": "पूर्णे वर्षसहस्रे तु स्थित्वा त्वं समले पुनः ।\nगच्छाश्रमपदं पश्चाद्गौतमस्य महामुनेः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003496046, "chapter_id": 23496, "verse_number": "१३६-४७", "content_sanskrit": "तत्र ज्ञास्यसि चात्मानं गौतमाश्रमसंस्थितः ।\nप्रसादाद्गौतममुनेर्भवता गतकिल्बिषः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003496047, "chapter_id": 23496, "verse_number": "१३६-४८", "content_sanskrit": "सततं पापसम्पन्नं कपालं शिरसि स्थितम् ।\nऋषिः पातयितुं शक्तस्त्वत्प्रसादान्न सशंयः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003496048, "chapter_id": 23496, "verse_number": "१३६-४९", "content_sanskrit": "एवं रुद्रं वरं दत्त्वा तत्रैवान्तर्हितोऽभवम् ।\nरुद्रोऽपि भ्रमते तत्र श्मशाने पापसंवृते ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003496049, "chapter_id": 23496, "verse_number": "१३६-५०", "content_sanskrit": "अतो न रोचते भूमे श्मशानं मे कदाचन ।\nयत्र रुद्रकृतं पापं स्थितं किल भयावहम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003496050, "chapter_id": 23496, "verse_number": "१३६-५१", "content_sanskrit": "एतत्ते कथितं भद्रे श्मशानं मे जुगुप्सितम् ।\nविना तु कृतसंस्कारो मम कर्मपरायणः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003496051, "chapter_id": 23496, "verse_number": "१३६-५२", "content_sanskrit": "प्रायश्चित्तं प्रवक्ष्यामि येन शुध्यति किल्बिषात् ।\nकृत्वा चतुर्थभक्षं तु दिनानि दश पंच च ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003496052, "chapter_id": 23496, "verse_number": "१३६-५३", "content_sanskrit": "आकाशशयनं कुर्यादेकवस्त्रः कुशासने ।\nप्रभाते पंचगव्यं च पातव्यं कर्मशोधनम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003496053, "chapter_id": 23496, "verse_number": "१३६-५४", "content_sanskrit": "विमुक्तः सर्वपापेभ्यो मम लोकं स गच्छति ।\nपिण्याकं भक्षयित्वा तु यो देवमुपसर्पति ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003496054, "chapter_id": 23496, "verse_number": "१३६-५५", "content_sanskrit": "तस्य वै शृणु सुश्रोणि प्रायश्चित्तं सुशोधनम् ।\nउलूको दश वर्षाणि कच्छपस्तु समास्त्रयः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003496055, "chapter_id": 23496, "verse_number": "१३६-५६", "content_sanskrit": "जायते मानवस्तत्र मम कर्मपरायणः ।\nयांस्तु दोषान्प्रपश्यन्ते संसारेऽस्मिन्वसुन्धरे ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003496056, "chapter_id": 23496, "verse_number": "१३६-५७", "content_sanskrit": "तस्य वक्ष्यामि सुश्रोणि प्रायश्चित्तं महौजसम् ।\nकिल्बिषाद्येन मुच्येत संसारान्तं च गच्छति ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003496057, "chapter_id": 23496, "verse_number": "१३६-५८", "content_sanskrit": "यावकेन दिनैकं तु गोमूत्रेण च कारयेत्।\nरात्रौ वीरासनं कुर्यादाकाशशयने वसेत् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003496058, "chapter_id": 23496, "verse_number": "१३६-५९", "content_sanskrit": "न स गच्छति संसारं मम लोकं स गच्छति ।\nवराहमांसेन तु यो मम कुर्वीत प्रापणम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003496059, "chapter_id": 23496, "verse_number": "१३६-६०", "content_sanskrit": "मूर्खः स पापकर्मा च मम कर्मपरायणः ।\nयांस्तु दोषान्प्रपद्येत संसारं च वसुन्धरे ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003496060, "chapter_id": 23496, "verse_number": "१३६-६१", "content_sanskrit": "यावद्रोम वराहस्य मम गात्रेषु संस्थितम् ।\nतावद्वर्षसहस्राणि नरके पच्यते भुवि ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003496061, "chapter_id": 23496, "verse_number": "१३६-६२", "content_sanskrit": "अन्यच्च ते प्रवक्ष्यामि तच्छृणुष्व वसुन्धरे ।\nवाराहेण तु मांसेन यस्तु कुर्वीत प्रापणम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003496062, "chapter_id": 23496, "verse_number": "१३६-६३", "content_sanskrit": "यावत् तत्तनुसंस्थं तु भजते तु प्रतिष्ठितम् ।\nतावत्स पतते देवि सौकरीं योनिमास्थितः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003496063, "chapter_id": 23496, "verse_number": "१३६-६४", "content_sanskrit": "अन्यच्च ते प्रवक्ष्यामि तच्छृणुष्व वसुन्धरे ।\nयां गतिं सम्प्रपद्येत मम कर्मपरायणः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003496064, "chapter_id": 23496, "verse_number": "१३६-६५", "content_sanskrit": "अन्धो भूत्वा ततो देवि जन्म चैवं प्रतिष्ठितम् ।\nएवं गत्वा तु संसारं वराहमांसप्रापणात् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003496065, "chapter_id": 23496, "verse_number": "१३६-६६", "content_sanskrit": "जायते विपुले सिद्धे कुले भागवते शुचिः ।\nविनीतः कृतसंस्कारो मम कमर्परायणः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003496066, "chapter_id": 23496, "verse_number": "१३६-६७", "content_sanskrit": "द्रव्यवान्गुणवांश्चैव रूपवाञ्छीलवाञ्छुचिः ।\nप्रायश्चित्तं प्रवक्ष्यामि तस्य कायविशोधनम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003496067, "chapter_id": 23496, "verse_number": "१३६-६८", "content_sanskrit": "किल्बिषाद्येन मुच्येत मम कर्मपरायणः ।\nफलाहारो दिनान्सप्त सप्त मूलाशनस्तथा ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003496068, "chapter_id": 23496, "verse_number": "१३६-६९", "content_sanskrit": "दिनानि सप्त तिष्ठेत सप्त वै पायसेन च ।\nतक्रेण सप्त दिवसान्सप्त पावकभोजनः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003496069, "chapter_id": 23496, "verse_number": "१३६-७०", "content_sanskrit": "प्रायश्चित्तान्महाभागे मम लोकं स गच्छति ।\nमद्यं पीत्वा वरारोहे यस्तु मामुपसर्पति ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003496070, "chapter_id": 23496, "verse_number": "१३६-७१", "content_sanskrit": "तत्र दोषं प्रवक्ष्यामि शृणु सुन्दरि तत्त्वतः ।\nदशवर्षसहस्राणि दरिद्रो जायते पुनः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003496071, "chapter_id": 23496, "verse_number": "१३६-७२", "content_sanskrit": "ततो भवेत्सुपूतात्मा मद्भक्तः स न संशयः ।\nयस्तु भागवतो भूत्वा कामरागेण मोहितः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003496072, "chapter_id": 23496, "verse_number": "१३६-७३", "content_sanskrit": "दीक्षितः पिबते मद्यं प्रायश्चित्तं न विद्यते ।\nअन्यच्च ते प्रवक्ष्यामि तच्छृणुष्व वसुन्धरे ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003496073, "chapter_id": 23496, "verse_number": "१३६-७४", "content_sanskrit": "अग्निवर्णां सुरां पीत्वा तेन मुच्येत किल्बिषात् ।\nय एतेन विधानेन प्रायश्चित्तं समाचरेत् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003496074, "chapter_id": 23496, "verse_number": "१३६-७५", "content_sanskrit": "न स लिप्यति पापेन संसारं च न गच्छति ।\nकौसुम्भं चैव यः शाकं भक्षयेन्मम पूजकः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003496075, "chapter_id": 23496, "verse_number": "१३६-७६", "content_sanskrit": "नरके पच्यते घोरे दश पंच च सूकरः ।\nततो गच्छेच्छ्वयोनौ च त्रीणि वर्षाणि जम्बुकः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003496076, "chapter_id": 23496, "verse_number": "१३६-७७", "content_sanskrit": "वर्षमेकं ततः शुध्येन्मत्कर्मणि रतः शुचिः ।\nमम लोकमवाप्नोति शुद्धो भूत्वा वसुन्धरे ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003496077, "chapter_id": 23496, "verse_number": "१३६-७८", "content_sanskrit": "ततो भूमिर्वचः श्रुत्वा प्रत्युवाच पुनर्हरिम् ।\nकुसुम्भशाकनैवेद्यप्रापणेन च किल्बिषात् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003496078, "chapter_id": 23496, "verse_number": "१३६-७९", "content_sanskrit": "कथं मुच्येत देवेश प्रायश्चित्तं वद प्रभो ।\nश्रीवराह उवाच ।\nयो मे कुसुम्भशाकेन प्रापणं कुरुते नरः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003496079, "chapter_id": 23496, "verse_number": "१३६-८०", "content_sanskrit": "दशवर्षसहस्राणि नरके परिपच्यते ।\nप्रायश्चित्तं प्रवक्ष्यामि तच्च मे वदतः शृणु ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003496080, "chapter_id": 23496, "verse_number": "१३६-८१", "content_sanskrit": "भक्षणे तु कृते कुर्याच्चान्द्रायणमतन्द्रितः ।\nप्रापणे तु कृते कुर्याद्द्वादशाहं पयोव्रतम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003496081, "chapter_id": 23496, "verse_number": "१३६-८२", "content_sanskrit": "य एतेन विधानेन प्रायश्चित्तं समाचरेत् ।\nन स लिप्येत पापेन मम लोकं च गच्छति ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003496082, "chapter_id": 23496, "verse_number": "१३६-८३", "content_sanskrit": "यः पारक्येण वस्त्रेण न धूतेन च माधवि ।\nप्रायश्चित्ती भवेन्मूर्खो मम कर्मपरायणः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003496083, "chapter_id": 23496, "verse_number": "१३६-८४", "content_sanskrit": "करोति मम कर्माणि स्पृशते मां तदा स्थितः ।\nमृगो वै जायते देवि वर्षाणि त्रीणि सप्त च ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003496084, "chapter_id": 23496, "verse_number": "१३६-८५", "content_sanskrit": "हीनपादेन जायेत चैकं जन्म वसुन्धरे ।\nमूर्खश्च क्रोधनश्चैव मद्भक्तश्चैव जायते ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003496085, "chapter_id": 23496, "verse_number": "१३६-८६", "content_sanskrit": "तस्य वक्ष्यामि सुश्रोणि प्रायश्चित्तं महौजसम् ।\nयेन गच्छति संसारं मम भक्तो व्यवस्थितः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003496086, "chapter_id": 23496, "verse_number": "१३६-८७", "content_sanskrit": "अष्टभक्तं ततः कृत्वा मम भक्तिपरायणः ।\nमाघस्यैव तु मासस्य शुक्लपक्षस्य द्वादशीम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003496087, "chapter_id": 23496, "verse_number": "१३६-८८", "content_sanskrit": "तिष्ठेज्जलाशये गत्वा शान्तो दान्तो यतव्रतः ।\nअनन्यमानसो भूत्वा मम चिन्तापरायणः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003496088, "chapter_id": 23496, "verse_number": "१३६-८९", "content_sanskrit": "प्रभातायां तु शर्वर्यामुदिते तु दिवाकरे ।\nपचगव्यं ततः पीत्वा मम कर्माणि कारयेत् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003496089, "chapter_id": 23496, "verse_number": "१३६-९०", "content_sanskrit": "य एतेन विधानेन प्रायश्चित्तं समाचरेत् ।\nसर्वपापविनिर्मुक्तो मम लोकं स गच्छति ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003496090, "chapter_id": 23496, "verse_number": "१३६-९१", "content_sanskrit": "( अकृत्वा यो नवान्नानि मम कर्मपरायणः॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003496091, "chapter_id": 23496, "verse_number": "१३६-९२", "content_sanskrit": "ततो भागवतो भूत्वा नवान्नं यो न कारयेत् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003496092, "chapter_id": 23496, "verse_number": "१३६-९३", "content_sanskrit": "पितरस्तस्य नाश्नन्ति वर्षाणि दश पंच च ।\nअदत्त्वा यस्तु भुञ्जीत नवान्नानि कदाचन ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003496093, "chapter_id": 23496, "verse_number": "१३६-९४", "content_sanskrit": "न तस्य धर्मो विद्येत एवमेतन्न संशयः ।\nअन्यच्च ते प्रवक्ष्यामि येन तस्मात्प्रमुच्यते ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003496094, "chapter_id": 23496, "verse_number": "१३६-९५", "content_sanskrit": "प्रायश्चित्तं महाभागे मम भक्तसुखावहम् ।\nउपवासं त्रिरात्रं तु तत एकेन वा पुनः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003496095, "chapter_id": 23496, "verse_number": "१३६-९६", "content_sanskrit": "आकाशशयनं कृत्वा चतुर्थेऽहनि शुध्यति ।\nएवं तत्र विधिं कृत्वा उदिते च दिवाकरे ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003496096, "chapter_id": 23496, "verse_number": "१३६-९७", "content_sanskrit": "पंचगव्यं ततः पीत्वा शीघ्रं मुच्येत किल्बिषात् ।\nय एतेन विधानेन प्रायश्चित्तं समाचरेत् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003496097, "chapter_id": 23496, "verse_number": "१३६-९८", "content_sanskrit": "सर्वसङ्गं परित्यज्य मम लोकं स गच्छति ।\nअदत्त्वा गन्धमाल्यानि यो मे धूपं प्रयच्छति ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003496098, "chapter_id": 23496, "verse_number": "१३६-९९", "content_sanskrit": "कुणपो जायते भूमे यातुधानो न संशयः ।\nवर्षाणि चैकविंशानि अयस्कारनिवासकः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003496099, "chapter_id": 23496, "verse_number": "१३६-१००", "content_sanskrit": "तिष्ठत्यत्र महाभागे एवमेतन्न संशयः ।\nअन्यच्च ते प्रवक्ष्यामि तच्छृणुष्व वसुन्धरे ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003496100, "chapter_id": 23496, "verse_number": "१३६-१०१", "content_sanskrit": "प्रायश्चित्तं प्रवक्ष्यामि येन मुच्येत किल्बिषात् ।\nयस्य कस्यचिन्मासस्य शुक्लपक्षस्य द्वादशीम् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003496101, "chapter_id": 23496, "verse_number": "१३६-१०२", "content_sanskrit": "उपोष्य चाष्टभक्तं तु दशैकादशमेव च ।\nप्रभातायां तु शर्वर्यामुदिते रविमण्डले ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003496102, "chapter_id": 23496, "verse_number": "१३६-१०३", "content_sanskrit": "पंचगव्यं ततः पीत्वा शीघ्रं मुच्यति किल्बिषात् ।\nय एतेन विधानेन प्रायश्चित्तं समाचरेत् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003496103, "chapter_id": 23496, "verse_number": "१३६-१०४", "content_sanskrit": "तानि तानि तरन्त्येव सर्व एव पितामहाः ।\nवहन्नुपानहौ पद्भ्यां यस्तु मामुपचक्रमेत् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003496104, "chapter_id": 23496, "verse_number": "१३६-१०५", "content_sanskrit": "चर्मकारस्तु जायेत वर्षाणां तु त्रयोदश ।\nतज्जन्मनः परिभ्रष्टः सूकरो जायते पुनः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003496105, "chapter_id": 23496, "verse_number": "१३६-१०६", "content_sanskrit": "सूकरत्वात्परिभ्रष्टः श्वा भवेच्च जुगुप्सितः ।\nततः श्वत्त्वात्परिभ्रष्टो मानुषेषूपजायते ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003496106, "chapter_id": 23496, "verse_number": "१३६-१०७", "content_sanskrit": "मद्भक्तश्च विनीतश्च अपराधविवर्जितः ।\nमुक्तस्तु सर्वसंसारान्मम लोकं स गच्छति ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003496107, "chapter_id": 23496, "verse_number": "१३६-१०८", "content_sanskrit": "य एतेन विधानेन वसुधे कर्म कारयेत् ।\nन स लिप्येत पापेन एवमेतन्न संशयः ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003496108, "chapter_id": 23496, "verse_number": "१३६-१०९", "content_sanskrit": "भेरीशब्दमकृत्वा तु यस्तु मां प्रतिबोधयेत् ।\nबधिरो जायते भूमे एकं जन्म न संशयः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003496109, "chapter_id": 23496, "verse_number": "१३६-११०", "content_sanskrit": "तस्य वक्ष्यामि सुश्रोणि प्रायश्चित्तं मम प्रियम् ।\nकिल्बिषाद्येन मुच्येत भेरीताडनमोहितः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003496110, "chapter_id": 23496, "verse_number": "१३६-१११", "content_sanskrit": "यस्य कस्यचिन्मासस्य शुक्लपक्षे तु द्वादशी ।\nआकाशशयनं कृत्वा शीघ्रं मुच्येत किल्बिषात् ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003496111, "chapter_id": 23496, "verse_number": "१३६-११२", "content_sanskrit": "य एतेन विधानेन वसुधे कर्म कारयेत् ।\nअपराधं न गच्छेत्तु मम लोकं स गच्छति ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003496112, "chapter_id": 23496, "verse_number": "१३६-११३", "content_sanskrit": "अन्नं भुक्त्वा बहुतरमजीर्णेन परिप्लुतः ।\nउद्गारेण समायुक्तः अस्नात उपसर्पति ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003496113, "chapter_id": 23496, "verse_number": "१३६-११४", "content_sanskrit": "एकजन्मनि श्वा चैव वानरश्चैव जायते ।\nएकस्मिञ्जन्मनि च्छागः सृगालश्चैकजन्मनि ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003496114, "chapter_id": 23496, "verse_number": "१३६-११५", "content_sanskrit": "एकजन्म भवेदन्धो मूषको जायते पुनः ।\nतारितो ह्येष संसाराज्जायते विपुले कुले ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003496115, "chapter_id": 23496, "verse_number": "१३६-११६", "content_sanskrit": "शुद्धो भागवतः श्रेष्ठस्त्वपराधविवर्ज्जित।\nप्रायश्चित्तं प्रवक्ष्यामि मम भक्तसुखावहम् ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7003496116, "chapter_id": 23496, "verse_number": "१३६-११७", "content_sanskrit": "किल्बिषाद्येन मुच्येत मम भक्तिपरायणः ।\nत्रिदिनं पावकाहारो मूलाहारो दिनत्रयम् ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7003496117, "chapter_id": 23496, "verse_number": "१३६-११८", "content_sanskrit": "पायसेन दिनत्रय्यां त्रिदिनं सक्तुना तथा ।\nत्रिदिनं वायुभक्षोऽपि आकाशशयनस्त्रिकम् ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7003496118, "chapter_id": 23496, "verse_number": "१३६-११९", "content_sanskrit": "उत्थायापररात्रे तु कृत्वा वै दन्तधावनम्।\nपंचगव्यं पिबेच्चैव शरीरपरिशोधनम् ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7003496119, "chapter_id": 23496, "verse_number": "१३६-१२०", "content_sanskrit": "य एतेन विधानेन प्रायश्चित्तं समाचरेत् ।\nन स लिप्येत पापेन मम लोकं स गच्छति ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7003496120, "chapter_id": 23496, "verse_number": "१३६-१२१", "content_sanskrit": "आख्यानानां महाख्यानं तपसां च परं तपः ।\nअत्राहं कीर्त्तयिष्यामि ब्राह्मणेभ्यो महेश्वरि ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7003496121, "chapter_id": 23496, "verse_number": "१३६-१२२", "content_sanskrit": "एष धर्मश्च कीर्त्तिश्च आचाराणां महौजसाम् ।\nगुणानां च परं श्रेष्ठं ऋतीनां च महा ऋतिः ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7003496122, "chapter_id": 23496, "verse_number": "१३६-१२३", "content_sanskrit": "य एतत्पठते नित्यं कल्यमुत्थाय मानवः ।\nस पितॄँस्तारयेज्जन्तुर्दश पूर्वान्दशापरान् ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7003496123, "chapter_id": 23496, "verse_number": "१३६-१२४", "content_sanskrit": "आरोग्याणां महारोग्यं मङ्गलानां तु मङ्गलम् ।\nरत्नानां परमं रत्नं सर्वपापप्रणाशनम् ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7003496124, "chapter_id": 23496, "verse_number": "१३६-१२५", "content_sanskrit": "यस्तु भागवतो नित्यं पठते च दृढव्रतः ।\nकृत्वा सर्वापराधानि न स पापेन लिप्यते ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7003496125, "chapter_id": 23496, "verse_number": "१३६-१२६", "content_sanskrit": "एष जप्यः प्रमाणं च सन्ध्योपासनमेव च ।\nकल्यमुत्थाय पठते मम लोकं स गच्छति ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7003496126, "chapter_id": 23496, "verse_number": "१३६-१२७", "content_sanskrit": "न पठेन्मूर्खमध्ये तु कुशिष्याणां तथैव च ।\nदद्याद्भागवते श्रेष्ठे मम कर्मपरायणे ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7003496127, "chapter_id": 23496, "verse_number": "१३६-१२८", "content_sanskrit": "एतत्ते कथितो देवि आचारस्य विनिश्चयः ।\nपूर्वं त्वया यत्पृष्टं तु किमन्यच्छ्रोतुमिच्छसि ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}]