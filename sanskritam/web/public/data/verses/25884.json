[{"id": 7005884000, "chapter_id": 25884, "verse_number": "१-६७-१", "content_sanskrit": "सूत उवाच ।\nहरेः श्रुत्वा हरो गौरीं देहस्थं ज्ञानमब्रवीत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005884001, "chapter_id": 25884, "verse_number": "१-६७-२", "content_sanskrit": "कुजो वह्नी रविः पृथ्वी सौरिरापः प्रकीर्त्ततः।\nवायुसंस्थास्थितो राहुर्दक्षरन्ध्रावभासकः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005884002, "chapter_id": 25884, "verse_number": "१-६७-३", "content_sanskrit": "गुरुः शुक्रस्तथा सौम्यश्चन्द्रश्चैव चतुरथकः।\nवामनाडीं तु मध्यस्थां कारयेदात्मनस्तथा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005884003, "chapter_id": 25884, "verse_number": "१-६७-४", "content_sanskrit": "यदाचर इलायुक्तस्तदा कर्मसमाचरेत् ।\nस्थानसेवां तथा ध्यानं वाणिज्यं राजदर्शनम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005884004, "chapter_id": 25884, "verse_number": "१-६७-५", "content_sanskrit": "अन्यानि शुभकर्माणि कारयेत प्रयत्नतः ।\nदक्षनाडीप्रवाहे तु शनिर्भौमश्च सैहिकः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005884005, "chapter_id": 25884, "verse_number": "१-६७-६", "content_sanskrit": "इनश्चैव तथाप्ये पापानामुदयो भवेत् ।\nशुभाशुभविवेको हि ज्ञायते तु स्वरोदयात् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005884006, "chapter_id": 25884, "verse_number": "१-६७-७", "content_sanskrit": "देहमध्ये स्थिता नाड्यो बहुरूपाः सुविस्तराः ।\nनाभेरधस्ताद्यः कन्दस्त्वंकुरास्तत्र निर्गताः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005884007, "chapter_id": 25884, "verse_number": "१-६७-८", "content_sanskrit": "द्विसप्ततिसहस्त्राणि नाभिमध्ये व्यवस्थिते ।\nचक्रवच्च स्थितास्तास्तु सर्वाः प्राणहराः स्मृताः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005884008, "chapter_id": 25884, "verse_number": "१-६७-९", "content_sanskrit": "तासां मध्ये त्रयः श्रेष्ठा वामदक्षिणमध्यमाः।\nवामा सोमात्मिका प्रोक्ता दक्षिणा रविसन्निभा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005884009, "chapter_id": 25884, "verse_number": "१-६७-१०", "content_sanskrit": "मध्यमा च भवेदग्निः फलंती कालपूरिणी ।\nवामा ह्यमृतरूपा च जगदाप्यायने स्थिता ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005884010, "chapter_id": 25884, "verse_number": "१-६७-११", "content_sanskrit": "दक्षिणा रौद्रभागेन जगच्छोषयते सदा ।\nद्वयोर्वाहे तु मृत्युः स्यात्सर्वकार्य्यविनाशिनी ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005884011, "chapter_id": 25884, "verse_number": "१-६७-१२", "content_sanskrit": "निर्गमे तु भवेद्वामा प्रवेशे दक्षिणा स्मृता ।\nइडाचारे तथा सौम्यं चन्द्रसूर्य्यगतस्तथा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005884012, "chapter_id": 25884, "verse_number": "१-६७-१३", "content_sanskrit": "कारयेत्क्रूर कर्माणि प्राणे पिंगलसंस्थित।\nयात्रायां सर्वकार्येषु विषापहारणे इडा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005884013, "chapter_id": 25884, "verse_number": "१-६७-१४", "content_sanskrit": "भोजने मैथुने युद्धे पिंगला सिद्धिदायिका ।\nउच्चाटमारणाद्येषु कर्मस्वेतेषु पिङ्गला ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005884014, "chapter_id": 25884, "verse_number": "१-६७-१५", "content_sanskrit": "मैथुने चैव संग्रामे भोजने सिद्धिदायिका ।\nशोभनेषु च कार्य्येषु यात्रायां विषकर्मणि ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005884015, "chapter_id": 25884, "verse_number": "१-६७-१६", "content_sanskrit": "शान्तिमुक्त्यर्थसिद्ध्यै च इडा योज्या नराधिपैः ।\nद्वाभ्यां चैव प्रवाहे च क्रूरसौम्यविवर्जने ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005884016, "chapter_id": 25884, "verse_number": "१-६७-१७", "content_sanskrit": "विषवत्तं तु जानीयात्संस्मरेत्तु विकषणः।\nसौम्यादिशुभकार्येषु लाभादिजयजीविते ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005884017, "chapter_id": 25884, "verse_number": "१-६७-१८", "content_sanskrit": "गमनागमने चैव वामा सर्वत्र पूजिता ।\nयुद्धादिभोजने घाते स्त्रीणां चैव तु सङ्गमे ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005884018, "chapter_id": 25884, "verse_number": "१-६७-१९", "content_sanskrit": "प्रशस्ता दक्षिणा नाडी प्रवेशे क्षुद्र्मणि।\nशुभाशुभानि कार्य्याणि लाभालाभौ जयाजयौ ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005884019, "chapter_id": 25884, "verse_number": "१-६७-२०", "content_sanskrit": "जीवाजीवाय यत्पृच्छेन्न सिध्यति च मध्यमा ।\nवामाचारेऽथवा दक्षे प्रत्यये यत्र नायकः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005884020, "chapter_id": 25884, "verse_number": "१-६७-२१", "content_sanskrit": "तनुस्थः पृच्छते यस्तु तत्र सिद्धिर्न संय।\nवैच्छन्दो वामदेवस्तु यदा वहति चात्मनि ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005884021, "chapter_id": 25884, "verse_number": "१-६७-२२", "content_sanskrit": "तत्र भागे स्थितः पृच्छेत्सिद्धिर्भवति निष्फल।\nवामे वा दक्षिणे वापि यत्र संक्रमते शिवा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005884022, "chapter_id": 25884, "verse_number": "१-६७-२३", "content_sanskrit": "घोरे घोराणि कार्य्याणि सौम्ये वै मध्यमानि च ।\nप्रस्थिते भागतो हंसे द्वाभ्यां वै सर्ववाहिनी ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005884023, "chapter_id": 25884, "verse_number": "१-६७-२४", "content_sanskrit": "तदा मृत्युं विजानीयाद्योगी योगविशारदः ।\nयत्र यत्र स्थितः पृच्छेद्वामदक्षिणसंमुखः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005884024, "chapter_id": 25884, "verse_number": "१-६७-२५", "content_sanskrit": "तत्र तत्र समं दिश्याद्वातस्योदयनं सदा ।\nअग्रतो वामिका श्रेष्ठा पृष्ठतो दक्षिणा शुभा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005884025, "chapter_id": 25884, "verse_number": "१-६७-२६", "content_sanskrit": "वामेन वामिका प्रोक्ता दक्षिणे दक्षिणा शुभा ।\nवामे वामा शुभे चैव दक्षिणे दक्षिणा शुभा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005884026, "chapter_id": 25884, "verse_number": "१-६७-२७", "content_sanskrit": "जीवो जीवति जीवेन यच्छून्यं तस्त्वरो भवेत् ।\nयत्किञ्चित्कार्य्यमुद्दिष्टं जयादिशुभलक्षणम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005884027, "chapter_id": 25884, "verse_number": "१-६७-२८", "content_sanskrit": "तत्सर्वं पूर्णनाड्यां तु जायते निर्विकल्पतः ।\nअन्यनाड्यादिपर्य्यन्तं पक्षत्रयमुदाहृतम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005884028, "chapter_id": 25884, "verse_number": "१-६७-२९", "content_sanskrit": "यावत्षष्ठी तु पृच्छायां पूर्णायां प्रथमो जयत।\nरिक्तायां तु द्वितीयस्तु कथयेत्तदशङ्कितः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005884029, "chapter_id": 25884, "verse_number": "१-६७-३०", "content_sanskrit": "वामाचारसमो वायुर्जायते कर्मसिद्धिदः ।\nप्रवृत्ते दक्षिणे मार्गे विषमे विषमाक्षरम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005884030, "chapter_id": 25884, "verse_number": "१-६७-३१", "content_sanskrit": "अन्यत्र वामवाहे तु नाम वै विषमाक्षम।\nतदासौ जयमाप्नोति योधः संग्राममध्यतः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005884031, "chapter_id": 25884, "verse_number": "१-६७-३२", "content_sanskrit": "दक्षवातप्रवाहे तु यदि नाम समाक्षरम् ।\nजा(ज) यते नात्र सन्देहो नाडीमघ्ये तु लक्षयेत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005884032, "chapter_id": 25884, "verse_number": "१-६७-३३", "content_sanskrit": "पिङ्गलान्तर्गते प्राणे शमनीयाहवं जयेत् ।\nयावन्नाड्युदयं चारस्तां दिशं यावदापयेत् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005884033, "chapter_id": 25884, "verse_number": "१-६७-३४", "content_sanskrit": "न दातुं जायते सोऽपि नात्र कार्य्या विचारणा ।\nअथ संग्राममध्ये तु यत्र नाडी सदा वहेत् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005884034, "chapter_id": 25884, "verse_number": "१-६७-३५", "content_sanskrit": "सा दिशा जयमाप्नोति शून्ये भंगं विनिर्दिशत।\nजातचारे जयं विद्यान्मृतके मृतमादिशेत् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005884035, "chapter_id": 25884, "verse_number": "१-६७-३६", "content_sanskrit": "जयं पराजयं चैव यो जानाति स पण्डितः ।\nवामे वा दक्षिणे वापि यत्र सञ्चरते शिवम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005884036, "chapter_id": 25884, "verse_number": "१-६७-३७", "content_sanskrit": "कृत्वा तत्पदमाप्नोति यात्रा सन्ततशोभना ।\nशशिसूर्य्यप्रवाहे तु सति युद्धं समाचरेत् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005884037, "chapter_id": 25884, "verse_number": "१-६७-३८", "content_sanskrit": "यस्तु पृच्छति तत्रस्थः स साधुर्जयतिधरवम्।\nयां दिशं वहते वायुस्तां दिशं यावदाजयः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005884038, "chapter_id": 25884, "verse_number": "१-६७-३९", "content_sanskrit": "जायते नात्र सन्देह हन्द्रो यद्यग्रतः स्थितः ।\nमेष्याद्या दश या नाड्यो दक्षिणा वाम संस्थिताः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005884039, "chapter_id": 25884, "verse_number": "१-६७-४०", "content_sanskrit": "चरेस्थिरे तद्विमार्गे तादृशेतादृशे क्रमात् ।\nनिर्गमे निर्गमं याति संग्रहे संग्रहं विदुः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005884040, "chapter_id": 25884, "verse_number": "१-६७-४१", "content_sanskrit": "पृच्छकस्य वचः श्रुत्वा घण्टाकारेण लक्षयेत् ।\nवामे वा दक्षिणे वापि पञ्चतत्त्वस्थितः शिवे ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005884041, "chapter_id": 25884, "verse_number": "१-६७-४२", "content_sanskrit": "ऊर्द्ध्वेऽग्निरध आपश्च तिर्य्यक्संस्थः प्रभञनः।\nमध्ये तु पृथिवी ज्ञेया नभः सर्वत्र सर्वदा ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005884042, "chapter_id": 25884, "verse_number": "१-६७-४३", "content_sanskrit": "ऊर्द्ध्वे मृत्युरधः शान्तिस्तिर्य्यक् चोच्चाटयेत्सुधी।\nमध्ये स्तम्भं विजानीयान्मोक्षः सर्वत्र सर्वगे ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]