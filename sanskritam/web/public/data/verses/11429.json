[{"id": 50009662, "chapter_id": 11429, "verse_number": "1", "content_sanskrit": "मैत्रेय उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50009663, "chapter_id": 11429, "verse_number": "2", "content_sanskrit": "इत्यजेनानुनीतेन भवेन परितुष्यता अभ्यधायि महाबाहो प्रहस्य श्रूयतामिति॥ ४/८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50009664, "chapter_id": 11429, "verse_number": "3", "content_sanskrit": "महादेव उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50009665, "chapter_id": 11429, "verse_number": "4", "content_sanskrit": "नाघं प्रजेश बालानां वर्णये नानुचिन्तये देवमायाभिभूतानां दण्डस्तत्र धृतो मया॥ ४/८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50009666, "chapter_id": 11429, "verse_number": "5", "content_sanskrit": "प्रजापतेर्दग्धशीर्ष्णो भवत्वजमुखं शिरः मित्रस्य चक्षुषेक्षेत भागं स्वं बर्हिषो भगः॥ ४/८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50009667, "chapter_id": 11429, "verse_number": "6", "content_sanskrit": "पूषा तु यजमानस्य दद्भिर्जक्षतु पिष्टभुक्। देवाः प्रकृतसर्वाङ्गा ये म उच्छेषणं ददुः॥ ४/८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50009668, "chapter_id": 11429, "verse_number": "7", "content_sanskrit": "बाहुभ्यामश्विनोः पूष्णो हस्ताभ्यां कृतबाहवः भवन्त्वध्वर्यवश्चान्ये बस्तश्मश्रुर्भृगुर्भवेत्॥ ४/८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50009669, "chapter_id": 11429, "verse_number": "8", "content_sanskrit": "मैत्रेय उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50009670, "chapter_id": 11429, "verse_number": "9", "content_sanskrit": "तदा सर्वाणि भूतानि श्रुत्वा मीढुष्टमोदितम् परितुष्टात्मभिस्तात साधु साध्वित्यथाब्रुवन्॥ ४/८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50009671, "chapter_id": 11429, "verse_number": "10", "content_sanskrit": "ततो मीढ्वांसमामन्त्र्य शुनासीराः सहर्षिभिः भूयस्तद्देवयजनं समीढ्वद्वेधसो ययुः॥ ४/८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50009672, "chapter_id": 11429, "verse_number": "11", "content_sanskrit": "विधाय कार्त्स्न्येन च तद्यदाह भगवान्भवः सन्दधुः कस्य कायेन सवनीयपशोः शिरः॥ ४/८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50009673, "chapter_id": 11429, "verse_number": "12", "content_sanskrit": "सन्धीयमाने शिरसि दक्षो रुद्राभिवीक्षितः सद्यः सुप्त इवोत्तस्थौ ददृशे चाग्रतो मृडम्॥ ४/८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50009674, "chapter_id": 11429, "verse_number": "13", "content_sanskrit": "तदा वृषध्वजद्वेष कलिलात्मा प्रजापतिः शिवावलोकादभवच्छरद्ध्रद इवामलः॥ ४/८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50009675, "chapter_id": 11429, "verse_number": "14", "content_sanskrit": "भवस्तवाय कृतधीर्नाशक्नोदनुरागतः औत्कण्ठ्याद्बाष्पकलया सम्परेतां सुतां स्मरन्॥ ४/८/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50009676, "chapter_id": 11429, "verse_number": "15", "content_sanskrit": "कृच्छ्रात्संस्तभ्य च मनः प्रेमविह्वलितः सुधीः॥ ४/८/१२॥ शशंस निर्व्यलीकेन भावेनेशं प्रजापतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50009677, "chapter_id": 11429, "verse_number": "16", "content_sanskrit": "दक्ष उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50009678, "chapter_id": 11429, "verse_number": "17", "content_sanskrit": "भूयाननुग्रह अहो भवता कृतो मे दण्डस्त्वया मयि भृतो यदपि प्रलब्धः। न ब्रह्मबन्धुषु च वां भगवन्नवज्ञा तुभ्यं हरेश्च कुत एव धृतव्रतेषु॥ ४/८/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50009679, "chapter_id": 11429, "verse_number": "18", "content_sanskrit": "विद्यातपोव्रतधरान्मुखतः स्म विप्रान् ब्रह्मात्मतत्त्वमवितुं प्रथमं त्वमस्राक् तद्ब्राह्मणान्परम सर्वविपत्सु पासि पालः पशूनिव विभो प्रगृहीतदण्डः॥ ४/८/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50009680, "chapter_id": 11429, "verse_number": "19", "content_sanskrit": "योऽसौ मयाविदिततत्त्वदृशा सभायां क्षिप्तो दुरुक्तिविशिखैर्विगणय्य तन्माम्। अर्वाक्पतन्तमर्हत्तमनिन्दयापाद् दृष्ट्यार्द्रया स भगवान्स्वकृतेन तुष्येत्॥ ४/८/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50009681, "chapter_id": 11429, "verse_number": "20", "content_sanskrit": "मैत्रेय उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50009682, "chapter_id": 11429, "verse_number": "21", "content_sanskrit": "क्षमाप्यैवं स मीढ्वांसं ब्रह्मणा चानुमन्त्रितः कर्म सन्तानयामास सोपाध्यायर्त्विगादिभिः॥ ४/८/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50009683, "chapter_id": 11429, "verse_number": "22", "content_sanskrit": "वैष्णवं यज्ञसन्तत्यै त्रिकपालं द्विजोत्तमाः पुरोडाशं निरवपन्वीरसंसर्गशुद्धये॥ ४/८/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50009684, "chapter_id": 11429, "verse_number": "23", "content_sanskrit": "अध्वर्युणात्तहविषा यजमानो विशाम्पते धिया विशुद्धया दध्यौ तथा प्रादुरभूद्धरिः॥ ४/८/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50009685, "chapter_id": 11429, "verse_number": "24", "content_sanskrit": "तदा स्वप्रभया तेषां द्योतयन्त्या दिशो दश मुष्णंस्तेज उपानीतस्तार्क्ष्येण स्तोत्रवाजिना॥ ४/८/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50009686, "chapter_id": 11429, "verse_number": "25", "content_sanskrit": "श्यामो हिरण्यरशनोऽर्ककिरीटजुष्टो नीलालकभ्रमरमण्डितकुण्डलास्यः। शङ्खाब्जचक्रशरचापगदासिचर्म व्यग्रैर्हिरण्मयभुजैरिव कर्णिकारः॥ ४/८/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50009687, "chapter_id": 11429, "verse_number": "26", "content_sanskrit": "वक्षस्यधिश्रितवधूर्वनमाल्युदार हासावलोककलया रमयंश्च विश्वम्। पार्श्वभ्रमद्व्यजनचामरराजहंसः श्वेतातपत्रशशिनोपरि रज्यमानः॥ ४/८/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50009688, "chapter_id": 11429, "verse_number": "27", "content_sanskrit": "तमुपागतमालक्ष्य सर्वे सुरगणादयः प्रणेमुः सहसोत्थाय ब्रह्मेन्द्रत्र्यक्षनायकाः॥ ४/८/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50009689, "chapter_id": 11429, "verse_number": "28", "content_sanskrit": "तत्तेजसा हतरुचः सन्नजिह्वाः ससाध्वसाः मूर्ध्ना धृताञ्जलिपुटा उपतस्थुरधोक्षजम्॥ ४/८/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50009690, "chapter_id": 11429, "verse_number": "29", "content_sanskrit": "अप्यर्वाग्वृत्तयो यस्य महि त्वात्मभुवादयः यथामति गृणन्ति स्म कृतानुग्रहविग्रहम्॥ ४/८/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50009691, "chapter_id": 11429, "verse_number": "30", "content_sanskrit": "दक्षो गृहीतार्हणसादनोत्तमं यज्ञेश्वरं विश्वसृजां परं गुरुम्। सुनन्दनन्दाद्यनुगैर्वृतं मुदा गृणन्प्रपेदे प्रयतः कृताञ्जलिः॥ ४/८/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50009692, "chapter_id": 11429, "verse_number": "31", "content_sanskrit": "दक्ष उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50009693, "chapter_id": 11429, "verse_number": "32", "content_sanskrit": "शुद्धं स्वधाम्न्युपरताखिलबुद्ध्यवस्थं चिन्मात्रमेकमभयं प्रतिषिध्य मायाम्। तिष्ठंस्तयैव पुरुषत्वमुपेत्य तस्याम् आस्ते भवानपरिशुद्ध इवात्मतन्त्रः॥ ४/८/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50009694, "chapter_id": 11429, "verse_number": "33", "content_sanskrit": "ऋत्विज ऊचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50009695, "chapter_id": 11429, "verse_number": "34", "content_sanskrit": "तत्त्वं न ते वयमनञ्जन रुद्रशापात् कर्मण्यवग्रहधियो भगवन्विदामः। धर्मोपलक्षणमिदं त्रिवृदध्वराख्यं ज्ञातं यदर्थमधिदैवमदो व्यवस्थाः॥ ४/८/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50009696, "chapter_id": 11429, "verse_number": "35", "content_sanskrit": "सदस्या ऊचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50009697, "chapter_id": 11429, "verse_number": "36", "content_sanskrit": "उत्पत्त्यध्वन्यशरण उरुक्लेशदुर्गेऽन्तकोग्र व्यालान्विष्टे विषयमृगतृष्यात्मगेहोरुभारः। द्वन्द्वश्वभ्रे खलमृगभये शोकदावेऽज्ञसार्थः पादौकस्ते शरणद कदा याति कामोपसृष्टः॥ ४/८/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50009698, "chapter_id": 11429, "verse_number": "37", "content_sanskrit": "रुद्र उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50009699, "chapter_id": 11429, "verse_number": "38", "content_sanskrit": "तव वरद वराङ्घ्रावाशिषेहाखिलार्थे ह्यपि मुनिभिरसक्तैरादरेणार्हणीये। यदि रचितधियं माविद्यलोकोऽपविद्धं जपति न गणये तत्त्वत्परानुग्रहेण॥ ४/८/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50009700, "chapter_id": 11429, "verse_number": "39", "content_sanskrit": "भृगुरुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50009701, "chapter_id": 11429, "verse_number": "40", "content_sanskrit": "यन्मायया गहनयापहृतात्मबोधा ब्रह्मादयस्तनुभृतस्तमसि स्वपन्तः। नात्मन्श्रितं तव विदन्त्यधुनापि तत्त्वं सोऽयं प्रसीदतु भवान्प्रणतात्मबन्धुः॥ ४/८/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50009702, "chapter_id": 11429, "verse_number": "41", "content_sanskrit": "ब्रह्मोवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50009703, "chapter_id": 11429, "verse_number": "42", "content_sanskrit": "नैतत्स्वरूपं भवतोऽसौ पदार्थ भेदग्रहैः पुरुषो यावदीक्षेत् ज्ञानस्य चार्थस्य गुणस्य चाश्रयो मायामयाद्व्यतिरिक्तो मतस्त्वम्॥ ४/८/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50009704, "chapter_id": 11429, "verse_number": "43", "content_sanskrit": "इन्द्र उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50009705, "chapter_id": 11429, "verse_number": "44", "content_sanskrit": "इदमप्यच्युत विश्वभावनं वपुरानन्दकरं मनोदृशाम् सुरविद्विट्क्षपणैरुदायुधैर्भुजदण्डैरुपपन्नमष्टभिः॥ ४/८/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 50009706, "chapter_id": 11429, "verse_number": "45", "content_sanskrit": "पत्न्य ऊचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 50009707, "chapter_id": 11429, "verse_number": "46", "content_sanskrit": "यज्ञोऽयं तव यजनाय केन सृष्टो विध्वस्तः पशुपतिनाद्य दक्षकोपात् तं नस्त्वं शवशयनाभशान्तमेधं यज्ञात्मन्नलिनरुचा दृशा पुनीहि॥ ४/८/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 50009708, "chapter_id": 11429, "verse_number": "47", "content_sanskrit": "ऋषय ऊचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 50009709, "chapter_id": 11429, "verse_number": "48", "content_sanskrit": "अनन्वितं ते भगवन्विचेष्टितं यदात्मना चरसि हि कर्म नाज्यसे विभूतये यत उपसेदुरीश्वरीं न मन्यते स्वयमनुवर्ततीं भवान्॥ ४/८/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 50009710, "chapter_id": 11429, "verse_number": "49", "content_sanskrit": "सिद्धा ऊचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 50009711, "chapter_id": 11429, "verse_number": "50", "content_sanskrit": "अयं त्वत्कथामृष्टपीयूषनद्यां मनोवारणः क्लेशदावाग्निदग्धः तृषार्तोऽवगाढो न सस्मार दावं न निष्क्रामति ब्रह्मसम्पन्नवन्नः॥ ४/८/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 50009712, "chapter_id": 11429, "verse_number": "51", "content_sanskrit": "यजमान्युवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 50009713, "chapter_id": 11429, "verse_number": "52", "content_sanskrit": "स्वागतं ते प्रसीदेश तुभ्यं नमः श्रीनिवास श्रिया कान्तया त्राहि नः त्वामृतेऽधीश नाङ्गैर्मखः शोभते शीर्षहीनः कबन्धो यथा पुरुषः॥ ४/८/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 50009714, "chapter_id": 11429, "verse_number": "53", "content_sanskrit": "लोकपाला ऊचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 50009715, "chapter_id": 11429, "verse_number": "54", "content_sanskrit": "दृष्टः किं नो दृग्भिरसद्ग्रहैस्त्वं प्रत्यग्द्रष्टा दृश्यते येन विश्वम् माया ह्येषा भवदीया हि भूमन्यस्त्वं षष्ठः पञ्चभिर्भासि भूतैः॥ ४/८/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 50009716, "chapter_id": 11429, "verse_number": "55", "content_sanskrit": "योगेश्वरा ऊचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 50009717, "chapter_id": 11429, "verse_number": "56", "content_sanskrit": "प्रेयान्न तेऽन्योऽस्त्यमुतस्त्वयि प्रभो विश्वात्मनीक्षेन्न पृथग्य आत्मनः अथापि भक्त्येश तयोपधावतामनन्यवृत्त्यानुगृहाण वत्सल॥ ४/८/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 50009718, "chapter_id": 11429, "verse_number": "57", "content_sanskrit": "जगदुद्भवस्थितिलयेषु दैवतो बहुभिद्यमानगुणयात्ममायया रचितात्मभेदमतये स्वसंस्थया विनिवर्तितभ्रमगुणात्मने नमः॥ ४/८/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 50009719, "chapter_id": 11429, "verse_number": "58", "content_sanskrit": "ब्रह्मोवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 50009720, "chapter_id": 11429, "verse_number": "59", "content_sanskrit": "नमस्ते श्रितसत्त्वाय धर्मादीनां च सूतये निर्गुणाय च यत्काष्ठां नाहं वेदापरेऽपि च॥ ४/८/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 50009721, "chapter_id": 11429, "verse_number": "60", "content_sanskrit": "अग्निरुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 50009722, "chapter_id": 11429, "verse_number": "61", "content_sanskrit": "यत्तेजसाहं सुसमिद्धतेजा हव्यं वहे स्वध्वर आज्यसिक्तम् तं यज्ञियं पञ्चविधं च पञ्चभिः स्विष्टं यजुर्भिः प्रणतोऽस्मि यज्ञम्॥ ४/८/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 50009723, "chapter_id": 11429, "verse_number": "62", "content_sanskrit": "देवा ऊचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 50009724, "chapter_id": 11429, "verse_number": "63", "content_sanskrit": "पुरा कल्पापाये स्वकृतमुदरीकृत्य विकृतं त्वमेवाद्यस्तस्मिन्सलिल उरगेन्द्राधिशयने। पुमान्शेषे सिद्धैर्हृदि विमृशिताध्यात्मपदविः स एवाद्याक्ष्णोर्यः पथि चरसि भृत्यानवसि नः॥ ४/८/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 50009725, "chapter_id": 11429, "verse_number": "64", "content_sanskrit": "गन्धर्वा ऊचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 50009726, "chapter_id": 11429, "verse_number": "65", "content_sanskrit": "अंशांशास्ते देव मरीच्यादय एते ब्रह्मेन्द्राद्या देवगणा रुद्रपुरोगाः क्रीडाभाण्डं विश्वमिदं यस्य विभूमन्तस्मै नित्यं नाथ नमस्ते करवाम॥ ४/८/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 50009727, "chapter_id": 11429, "verse_number": "66", "content_sanskrit": "विद्याधरा ऊचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 50009728, "chapter_id": 11429, "verse_number": "67", "content_sanskrit": "त्वन्माययार्थमभिपद्य कलेवरेऽस्मिन् कृत्वा ममाहमिति दुर्मतिरुत्पथैः स्वैः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 50009729, "chapter_id": 11429, "verse_number": "68", "content_sanskrit": "क्षिप्तोऽप्यसद्विषयलालस आत्ममोहं युष्मत्कथामृतनिषेवक उद्व्युदस्येत्॥ ४/८/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 50009730, "chapter_id": 11429, "verse_number": "69", "content_sanskrit": "ब्राह्मणा ऊचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 50009731, "chapter_id": 11429, "verse_number": "70", "content_sanskrit": "त्वं क्रतुस्त्वं हविस्त्वं हुताशः स्वयं त्वं हि मन्त्रः समिद्दर्भपात्राणि च त्वं सदस्यर्त्विजो दम्पती देवता अग्निहोत्रं स्वधा सोम आज्यं पशुः॥ ४/८/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 50009732, "chapter_id": 11429, "verse_number": "71", "content_sanskrit": "त्वं पुरा गां रसाया महासूकरो दंष्ट्रया पद्मिनीं वारणेन्द्रो यथा स्तूयमानो नदल्लीलया योगिभिर्व्युज्जहर्थ त्रयीगात्र यज्ञक्रतुः॥ ४/८/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 50009733, "chapter_id": 11429, "verse_number": "72", "content_sanskrit": "स प्रसीद त्वमस्माकमाकाङ्क्षतां दर्शनं ते परिभ्रष्टसत्कर्मणाम् कीर्त्यमाने नृभिर्नाम्नि यज्ञेश ते यज्ञविघ्नाः क्षयं यान्ति तस्मै नमः॥ ४/८/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 50009734, "chapter_id": 11429, "verse_number": "73", "content_sanskrit": "मैत्रेय उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 50009735, "chapter_id": 11429, "verse_number": "74", "content_sanskrit": "इति दक्षः कविर्यज्ञं भद्र रुद्राभिमर्शितम् कीर्त्यमाने हृषीकेशे सन्निन्ये यज्ञभावने॥ ४/८/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 50009736, "chapter_id": 11429, "verse_number": "75", "content_sanskrit": "भगवान्स्वेन भागेन सर्वात्मा सर्वभागभुक् दक्षं बभाष आभाष्य प्रीयमाण इवानघ॥ ४/८/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 50009737, "chapter_id": 11429, "verse_number": "76", "content_sanskrit": "श्रीभगवानुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 50009738, "chapter_id": 11429, "verse_number": "77", "content_sanskrit": "अहं ब्रह्मा च शर्वश्च जगतः कारणं परम् आत्मेश्वर उपद्रष्टा स्वयन्दृगविशेषणः॥ ४/८/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 50009739, "chapter_id": 11429, "verse_number": "78", "content_sanskrit": "आत्ममायां समाविश्य सोऽहं गुणमयीं द्विज सृजन्रक्षन्हरन्विश्वं दध्रे संज्ञां क्रियोचिताम्॥ ४/८/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 50009740, "chapter_id": 11429, "verse_number": "79", "content_sanskrit": "तस्मिन्ब्रह्मण्यद्वितीये केवले परमात्मनि ब्रह्मरुद्रौ च भूतानि भेदेनाज्ञोऽनुपश्यति॥ ४/८/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 50009741, "chapter_id": 11429, "verse_number": "80", "content_sanskrit": "यथा पुमान्न स्वाङ्गेषु शिरःपाण्यादिषु क्वचित् पारक्यबुद्धिं कुरुते एवं भूतेषु मत्परः॥ ४/८/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 50009742, "chapter_id": 11429, "verse_number": "81", "content_sanskrit": "त्रयाणामेकभावानां यो न पश्यति वै भिदाम् सर्वभूतात्मनां ब्रह्मन्स शान्तिमधिगच्छति॥ ४/८/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 50009743, "chapter_id": 11429, "verse_number": "82", "content_sanskrit": "मैत्रेय उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 50009744, "chapter_id": 11429, "verse_number": "83", "content_sanskrit": "एवं भगवतादिष्टः प्रजापतिपतिर्हरिम् अर्चित्वा क्रतुना स्वेन देवानुभयतोऽयजत्॥ ४/८/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 50009745, "chapter_id": 11429, "verse_number": "84", "content_sanskrit": "रुद्रं च स्वेन भागेन ह्युपाधावत्समाहितः कर्मणोदवसानेन सोमपानितरानपि उदवस्य सहर्त्विग्भिः सस्नाववभृथं ततः॥ ४/८/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 50009746, "chapter_id": 11429, "verse_number": "85", "content_sanskrit": "तस्मा अप्यनुभावेन स्वेनैवावाप्तराधसे धर्म एव मतिं दत्त्वा त्रिदशास्ते दिवं ययुः॥ ४/८/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 50009747, "chapter_id": 11429, "verse_number": "86", "content_sanskrit": "एवं दाक्षायणी हित्वा सती पूर्वकलेवरम् जज्ञे हिमवतः क्षेत्रे मेनायामिति शुश्रुम॥ ४/८/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 50009748, "chapter_id": 11429, "verse_number": "87", "content_sanskrit": "तमेव दयितं भूय आवृङ्क्ते पतिमम्बिका अनन्यभावैकगतिं शक्तिः सुप्तेव पूरुषम्॥ ४/८/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 50009749, "chapter_id": 11429, "verse_number": "88", "content_sanskrit": "एतद्भगवतः शम्भोः कर्म दक्षाध्वरद्रुहः श्रुतं भागवताच्छिष्यादुद्धवान्मे बृहस्पतेः॥ ४/८/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 50009750, "chapter_id": 11429, "verse_number": "89", "content_sanskrit": "इदं पवित्रं परमीशचेष्टितं यशस्यमायुष्यमघौघमर्षणम् यो नित्यदाकर्ण्य नरोऽनुकीर्तयेद्धुनोत्यघं कौरव भक्तिभावतः॥ ४/८/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 50009751, "chapter_id": 11429, "verse_number": "90", "content_sanskrit": "सतीं मेनात्मजां तात प्राप्य जायां भवः पुनः। तया मैथुनमारभ्य रेमे देवः समाः शतम्॥ ४/८/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 50009752, "chapter_id": 11429, "verse_number": "91", "content_sanskrit": "स्ववीर्यधारणेऽकल्पां ज्ञात्वा जायां स धूर्जटिः। उत्ससर्जाम्बरे रेतो गङ्गा जग्राह तन्नदी॥ ४/८/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 50009753, "chapter_id": 11429, "verse_number": "92", "content_sanskrit": "पीत्वाऽन्तरजरं वह्निश्चच्छर्द शरकानने। कुमारोऽभूत् ततस्तस्मै स्तनं षट् कृत्तिका ददुः॥ ४/८/६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 50009754, "chapter_id": 11429, "verse_number": "93", "content_sanskrit": "षड्भिर्मुखैः स्तनं पीत्वा स बालः षण्मुखोऽभवत्। ततश्चक्रुः सैन्यपालं सर्वासुरभयंकरम्॥ ४/८/६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 50009755, "chapter_id": 11429, "verse_number": "94", "content_sanskrit": "इति श्रीमद्भागवते चतुर्थस्कन्धे अष्टमोऽध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}]