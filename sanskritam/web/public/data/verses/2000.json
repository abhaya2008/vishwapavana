[{"id": 2044793, "chapter_id": 2000, "verse_number": "६-४९-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2044794, "chapter_id": 2000, "verse_number": "६-४९-१", "content_sanskrit": "( श्वेते सेनापतौ तात संग्रमे निहते परैः।\nकिमकुर्वन्महेष्वासाः पाञ्चालाः पाण्डवैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2044795, "chapter_id": 2000, "verse_number": "६-४९-२", "content_sanskrit": "सेनापतिं समाकर्ण्य श्वेतं युधि निपातितम् ।\nतदर्थं यततां चापि परेषां प्रपलायिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2044796, "chapter_id": 2000, "verse_number": "६-४९-३", "content_sanskrit": "मनः प्रीणाति मे वाक्यं जयं संजय श्रृण्वतः।\nप्रत्युपायं चिन्तयन्तः सञ्जनाः प्रस्रवन्ति मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2044797, "chapter_id": 2000, "verse_number": "६-४९-४", "content_sanskrit": "स हि वीरोऽनुरक्तश्च वृद्धः कुरुपतिस्तदा ।\nकृतं वैरं सदा तेन पितुः पुत्रेण धीमता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2044798, "chapter_id": 2000, "verse_number": "६-४९-५", "content_sanskrit": "तस्योद्वेगभयाच्चापि संश्रितः पाण्डवान्पुरा ।\nसर्वं बलं परित्यज्य दुर्गं संश्रित्य तिष्ठति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2044799, "chapter_id": 2000, "verse_number": "६-४९-६", "content_sanskrit": "पाण्डवानां प्रतापेन दुर्गं देशं निवेश्य च ।\nसपत्नान्सततं बाधन्नार्यवृत्तिमनुष्ठितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2044800, "chapter_id": 2000, "verse_number": "६-४९-७", "content_sanskrit": "आश्चर्यं वै सदा तेषां पुरा राज्ञां सुदुर्मतिः।\nततो युधिष्ठिरे भक्तः कथं सञ्जय सूदितः ॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2044801, "chapter_id": 2000, "verse_number": "६-४९-८", "content_sanskrit": "प्रक्षिप्तः संमतः क्षुद्रः पुत्रो मे पुरुषाधमः।\nन युद्धं रोचयेद्भीष्मो न चाचार्यः कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2044802, "chapter_id": 2000, "verse_number": "६-४९-९", "content_sanskrit": "न कृपो न च गान्धारी नाहं सञ्जय रोचये ।\nन वासुदेवो वार्ष्णेयो धर्मराजश्च पाण्डवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2044803, "chapter_id": 2000, "verse_number": "६-४९-१०", "content_sanskrit": "न भीमो नार्जुनश्चैव न यमौ पुरुषर्षभौ ।\nवार्यमाणो मया नित्यं गान्धार्या विदुरेण च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2044804, "chapter_id": 2000, "verse_number": "६-४९-११", "content_sanskrit": "जामदग्न्येन रामेण व्यासेन च महात्मना ।\nदुर्योधनो युध्यमानो नित्यमेव हि सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2044805, "chapter_id": 2000, "verse_number": "६-४९-१२", "content_sanskrit": "कर्णस्य मतमास्थाय सौबलस्य च पापकृत् ।\nदुःशासनस्य च तथा पाण्डवान्नान्वचिन्तयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2044806, "chapter_id": 2000, "verse_number": "६-४९-१३", "content_sanskrit": "तस्याहं व्यसनं घोरं मन्ये प्राप्तं तु सञ्जय ।\nश्वेतस्य च विनाशेन भीष्मस्य विजयेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2044807, "chapter_id": 2000, "verse_number": "६-४९-१४", "content_sanskrit": "संक्रुद्धः कृष्णसहितः पार्थः किमकरोद्युधि ।\nअर्जुनाद्धि भयं भूयस्तन्मे तात न शाम्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2044808, "chapter_id": 2000, "verse_number": "६-४९-१५", "content_sanskrit": "स हि शूरश्च कौन्तेयः क्षिप्रकारी धनंजयः ।\nमन्ये शरैः शरीराणि शत्रूणां प्रमथिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2044809, "chapter_id": 2000, "verse_number": "६-४९-१६", "content_sanskrit": "ऐन्द्रिमिन्द्रानुजसमं महेन्द्रसदृशं बले ।\nअमोघक्रोधसंकल्पं दृष्ट्वा वः किमभून्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2044810, "chapter_id": 2000, "verse_number": "६-४९-१७", "content_sanskrit": "तथैव वेदविच्छूरो ज्वलनार्कसमद्युतिः ।\nइन्द्रास्त्रविदमेयात्मा प्रपतन्समितिंजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2044811, "chapter_id": 2000, "verse_number": "६-४९-१८", "content_sanskrit": "वज्रसंस्पर्शरूपाणामस्त्राणां च प्रयोजकः ।\nसखङ्गाक्षेपहस्तस्तु घोषं चक्रे महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2044812, "chapter_id": 2000, "verse_number": "६-४९-१९", "content_sanskrit": "स सञ्जय महाप्राज्ञो द्रुपदस्यात्मजो बली ।\nधृष्टद्युम्नः किमकरोच्छ्वेते युधि निपातिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2044813, "chapter_id": 2000, "verse_number": "६-४९-२०", "content_sanskrit": "पुरा चैवापराधेन वधेन च चमूपतेः ।\nमन्ये मनः प्रजज्वाल पाण्डवानां महात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2044814, "chapter_id": 2000, "verse_number": "६-४९-२१", "content_sanskrit": "तेषां क्रोधं चिन्तयंस्तु अहःसु च निशासु च ।\nन शान्तिमधिगच्छामि दुर्योदनकृतेन हि ।\nकथं चाभून्महायुद्धं सर्वमाचक्ष्व सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2044815, "chapter_id": 2000, "verse_number": "६-४९-२२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2044816, "chapter_id": 2000, "verse_number": "६-४९-२२", "content_sanskrit": "श्रृणु राजन्स्थिरो भूत्वा तवापनयनो महान् ।\nन च दुर्योधने दोषमिमामाधातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2044817, "chapter_id": 2000, "verse_number": "६-४९-२३", "content_sanskrit": "गतोदके सेतुबन्धो यादृक्तादृङ्भतिस्तव।\nसंदीप्ते भवने यद्वत्कूपस्य खननं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2044818, "chapter_id": 2000, "verse_number": "६-४९-२४", "content_sanskrit": "गतपूर्वाह्णभूयिष्ठे तस्मिन्नहनि दारुणे ।\nतावकानां परेषां च पुनर्युद्धमवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2044819, "chapter_id": 2000, "verse_number": "६-४९-२५", "content_sanskrit": "श्वेतं तु निहतं दृष्ट्वा विराटस्य चमूपतिम् ।\nकृतवर्मणा च सहितं दृष्ट्वा शल्यमवस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2044820, "chapter_id": 2000, "verse_number": "६-४९-२६", "content_sanskrit": "शङ्खः क्रोधात्प्रजज्वाल हविषा हव्यवाडिव ।\nस विस्फार्य महच्चापं शक्रचापोपमं बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2044821, "chapter_id": 2000, "verse_number": "६-४९-२७", "content_sanskrit": "अभ्यधावज्जिघांसन्वै शल्यं मद्राधिपं युधि ।\nमहता रथसङ्घेन समन्तात्परिरक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2044822, "chapter_id": 2000, "verse_number": "६-४९-२८", "content_sanskrit": "सृजन्बाणमयं वर्षं प्रायाच्छल्यरथं प्रति।\nतमापतन्तं संप्रेक्ष्य मत्तवारणविक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2044823, "chapter_id": 2000, "verse_number": "६-४९-२९", "content_sanskrit": "तावकानां रथाः सप्त समन्तात्पर्यवारयन् ।\nमद्रराजं परीप्सन्तो मृत्योर्दंष्ट्रान्तरं गतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2044824, "chapter_id": 2000, "verse_number": "६-४९-३०", "content_sanskrit": "बृहद्बलश्च कौसल्यो जयत्सेनश्च मागधः।\nतथा रुक्मरथो राजन्पुत्रः शल्यस्य मानितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2044825, "chapter_id": 2000, "verse_number": "६-४९-३१", "content_sanskrit": "विन्दानुविन्दावावन्त्यौ काम्भोजश्च सुदक्षिणःक ।\nबृहत्क्षत्रस्य दायादः सैन्धवश्च जयद्रथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2044826, "chapter_id": 2000, "verse_number": "६-४९-३२", "content_sanskrit": "नानाधातुविचित्राणि कार्मुकाणि महात्मनाम् ।\nविस्फारितान्यदृश्यन्त तोयदेष्विव विद्युतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2044827, "chapter_id": 2000, "verse_number": "६-४९-३३", "content_sanskrit": "ते तु बाणमयं वर्षं शङ्खमूर्ध्निं न्यपातयन् ।\nनिदाघान्तेऽनिलोद्धृता मेघा इव नगे जलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2044828, "chapter_id": 2000, "verse_number": "६-४९-३४", "content_sanskrit": "ततः क्रुद्धो महेष्वासः सप्तभल्लैः सुतेजनैः ।\nधनूंषि तेषामाच्छिद्य ननर्द पृतनापतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2044829, "chapter_id": 2000, "verse_number": "६-४९-३५", "content_sanskrit": "ततो भीष्मो महाबाहुर्विनद्य जलदो यथा।\nतालमात्रं धनुर्गृह्य शङ्खमभ्यद्रवद्रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2044830, "chapter_id": 2000, "verse_number": "६-४९-३६", "content_sanskrit": "तमुद्यन्तमुदीक्ष्याथ महेष्वासं महाबलम् ।\nसंत्रस्ता पाण्डवी सेना वातवेगहतेव नौः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2044831, "chapter_id": 2000, "verse_number": "६-४९-३७", "content_sanskrit": "ततोऽर्जुनः संत्वरितः शङ्खस्यासीत्पुरःसरः ।\nभीष्माद्रक्ष्योऽयमद्येति ततो युद्धमवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2044832, "chapter_id": 2000, "verse_number": "६-४९-३८", "content_sanskrit": "हाहाकारो महानासीद्योधानां युधि युध्यताम् ।\nतेजस्तेजसि संपृक्तमित्येवं विस्मयं ययुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2044833, "chapter_id": 2000, "verse_number": "६-४९-३९", "content_sanskrit": "अथ शल्यो गदापाणिरवतीर्य महारथात् ।\nशङ्खस्य चतुरो वाहानहनद्भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2044834, "chapter_id": 2000, "verse_number": "६-४९-४०", "content_sanskrit": "स हताश्वाद्रथात्तूर्णं खङ्गमादाय विद्रुतः ।\nबीभत्सोश्च रथं प्राप्य पुनः शान्तिमविन्दत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2044835, "chapter_id": 2000, "verse_number": "६-४९-४१", "content_sanskrit": "ततो भीष्मरथात्तूर्णमुत्पतन्ति पतत्रिणः ।\nयैरन्तरीक्षं भूमिश्च सर्वतः समवस्तृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2044836, "chapter_id": 2000, "verse_number": "६-४९-४२", "content_sanskrit": "पञ्चालानथ मत्स्यांश्च केकयांश्च प्रभद्रकान् ।\nभीष्मः प्रहरतां श्रेष्ठः पातयामास पत्रिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2044837, "chapter_id": 2000, "verse_number": "६-४९-४३", "content_sanskrit": "उत्सृज्य समरे राजन्पाण्डवं सव्यसाचिनम् ।\nअभ्यद्रवत पाञ्चाल्यं द्रुपदं सेनया वृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2044838, "chapter_id": 2000, "verse_number": "६-४९-४४", "content_sanskrit": "प्रियं संबन्धिनं राजञ्शरानवकिरन्बहून् ।\nअग्निनेव प्रदग्धानि वनानि शिशिरात्यये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2044839, "chapter_id": 2000, "verse_number": "६-४९-४५", "content_sanskrit": "शरदग्धान्यदृश्यन्त सैन्यानि द्रुपदस्य ह।\nअत्यतिष्ठद्रणे भीष्मो विधूम इव पावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2044840, "chapter_id": 2000, "verse_number": "६-४९-४६", "content_sanskrit": "मध्यन्दिने यथाऽऽदित्यं तपन्तमिव तेजसा।\nन शेकुः पाण्डवेयस्य योधा भीष्मं निरीक्षितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2044841, "chapter_id": 2000, "verse_number": "६-४९-४७", "content_sanskrit": "वीक्षांचक्रुः समंतात्ते पाण्डवा भयपीडिताः ।\nत्रातारं नाध्यगच्छन्त गावः शीतार्दिता इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2044842, "chapter_id": 2000, "verse_number": "६-४९-४८", "content_sanskrit": "सा तु यौधिष्ठिरी सेना गाङ्गेयशरपीडिता ।\nसिंहेनेव विनिर्भिन्ना शुक्ला गौरिव गोपतेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2044843, "chapter_id": 2000, "verse_number": "६-४९-४९", "content_sanskrit": "हते विप्रुद्रुते सैन्ये निरुत्साहे विमर्दिते।\nहाहाकारो महानासीत्पाण्डुसैन्येषु भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2044844, "chapter_id": 2000, "verse_number": "६-४९-५०", "content_sanskrit": "ततो भीष्मः शान्तनवो नित्यं मण्डलकार्मुकः ।\nमुमोच बाणान्दीप्ताग्रानहीनाशीविषानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2044845, "chapter_id": 2000, "verse_number": "६-४९-५१", "content_sanskrit": "शरैरेकायनीकुर्वन्दिशः सर्वा यतव्रतः।\nजघान पाण्डवरथानादिश्यादिश्य भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2044846, "chapter_id": 2000, "verse_number": "६-४९-५२", "content_sanskrit": "ततः सैन्येषु भग्नेषु मथितेषु च सर्वशः ।\nप्राप्ते चास्तं दिनकरे न प्राज्ञायत किंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2044847, "chapter_id": 2000, "verse_number": "६-४९-५३", "content_sanskrit": "भीष्मं च समुदीर्यन्तं दृष्ट्वा पार्था महाहवे ।\nअवहारमकुर्वन्त सैन्यानां भरतर्षभ ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2044848, "chapter_id": 2000, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि प्रथमदिवसयुद्धे एकोनपञ्चाशोऽध्यायः ॥ ॥ इति प्रथमदिवसयुद्धम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]