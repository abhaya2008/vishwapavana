[{"id": 6000314000, "chapter_id": 10314, "verse_number": null, "content_sanskrit": "त्रयोदशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000314001, "chapter_id": 10314, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.001.m4a", "display_order": 2}, {"id": 6000314002, "chapter_id": 10314, "verse_number": "११-१३-१", "content_sanskrit": "सत्त्वं रजस्तम इति गुणा बुद्धेर्न चाऽऽत्मनः।\nसत्त्वेनान्यतमौ हन्यात् सत्त्वं सत्त्वेन चैव हि॥ ११/१३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.002.m4a", "display_order": 3, "topics": [{"text": "सत्त्ववृद्‌ध्या विद्योदयः", "range": "१–१४"}]}, {"id": 6000314003, "chapter_id": 10314, "verse_number": "११-१३-२", "content_sanskrit": "सत्त्वाद् धर्मो भवेच्छुद्धात् पुंसो मद्भक्तिलक्षणः।\nसात्त्विकोपात्तया ज्ञानं ततो धर्मः प्रवर्तते॥ ११/१३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.003.m4a", "display_order": 4}, {"id": 6000314004, "chapter_id": 10314, "verse_number": "११-१३-३", "content_sanskrit": "धर्मो रजस्तमो हन्यात् सत्त्ववृत्तिरनुत्तमा।\nआशु नश्यति तन्मूलो ह्यधर्म उभये हते॥ ११/१३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.004.m4a", "display_order": 5}, {"id": 6000314005, "chapter_id": 10314, "verse_number": "११-१३-४", "content_sanskrit": "आगमोऽर्थः प्रजा देशः कालः कर्म च जन्म च।\nध्यानं मन्त्रोऽथ संस्कारो दशैते गुणहेतवः॥ ११/१३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.005.m4a", "display_order": 6}, {"id": 6000314006, "chapter_id": 10314, "verse_number": "११-१३-५", "content_sanskrit": "तत्तत् सात्त्विकमेव स्याद् यद्यद् वृद्धाः प्रचक्षते।\nनिन्दन्ति तामसं तत्तद् राजसं तदुपेक्षितम्॥ ११/१३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.006.m4a", "display_order": 7}, {"id": 6000314007, "chapter_id": 10314, "verse_number": "११-१३-६", "content_sanskrit": "सात्त्विकान्येव सेवेत पुमान् सत्त्वविवृद्धये।\nततो धर्मस्ततो ज्ञानं वाचः स्मृतिरपोहनम्॥ ११/१३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.007.m4a", "display_order": 8}, {"id": 6000314008, "chapter_id": 10314, "verse_number": "११-१३-७", "content_sanskrit": "वेणुसङ्घर्षजो वह्निर्दग्ध्वा शाम्यति तद्वनम्।\nएवं गुणव्यत्ययजो वेदः शाम्यति तद् यथा॥ ११/१३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.008.m4a", "display_order": 9}, {"id": 6000314009, "chapter_id": 10314, "verse_number": null, "content_sanskrit": "उद्धव उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.009.m4a", "display_order": 10}, {"id": 6000314010, "chapter_id": 10314, "verse_number": "११-१३-८", "content_sanskrit": "विन्दन्ति मर्त्याः प्रायेण विषयान् पदमापदाम्।\nअथापि भुञ्जते कृष्ण तत् कथं श्वखराजवत्॥ ११/१३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.010.m4a", "display_order": 11}, {"id": 6000314011, "chapter_id": 10314, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.011.m4a", "display_order": 12}, {"id": 6000314012, "chapter_id": 10314, "verse_number": "११-१३-९", "content_sanskrit": "अहमित्यन्यथाबुद्धिः प्रमत्तस्य यदा हृदि।\nउत्सर्पति रजो घोरं ततो वैकारिकं मनः॥ ११/१३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.012.m4a", "display_order": 13}, {"id": 6000314013, "chapter_id": 10314, "verse_number": "११-१३-१०", "content_sanskrit": "रजोयुक्तस्य मनसः सङ्कल्पः सविकल्पकः।\nततः कामो गुणध्यानाद् दुःसहः स्याद् हि दुर्मतेः॥ ११/१३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.013.m4a", "display_order": 14}, {"id": 6000314014, "chapter_id": 10314, "verse_number": "११-१३-११", "content_sanskrit": "करोति कामवशगः कर्माण्यविजितेन्द्रियः।\nदुःखोदर्काणि संपश्यन् रजोवेगविमोहितः॥ ११/१३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.014.m4a", "display_order": 15}, {"id": 6000314015, "chapter_id": 10314, "verse_number": "११-१३-१२", "content_sanskrit": "रजस्तमोभ्यां यदपि विद्वान् विक्षिप्तधीः पुनः।\nअतन्द्रितो मनो युञ्जन् दोषदृष्टिर्न सज्जते॥ ११/१३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.015.m4a", "display_order": 16}, {"id": 6000314016, "chapter_id": 10314, "verse_number": "११-१३-१३", "content_sanskrit": "अप्रमत्तो हि युञ्जीत मनो मय्यर्पयन् शनैः।\nअनिर्विण्णो यथाकालं जितश्वासो जितासनः॥ ११/१३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.016.m4a", "display_order": 17}, {"id": 6000314017, "chapter_id": 10314, "verse_number": "११-१३-१४", "content_sanskrit": "एतावान् योग आदिष्टो मच्छिष्यैः सनकादिभिः।\nसर्वतो मन आकृष्य मय्यद्धाऽऽवेश्यते यथा॥ ११/१३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.017.m4a", "display_order": 18}, {"id": 6000314018, "chapter_id": 10314, "verse_number": null, "content_sanskrit": "उद्धव उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.018.m4a", "display_order": 19}, {"id": 6000314019, "chapter_id": 10314, "verse_number": "११-१३-१५", "content_sanskrit": "यदा त्वं सनकादिभ्यो येन रूपेण केशव।\nयोगमादिष्टवानेतद् रूपमिच्छामि वेदितुम्॥ ११/१३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.019.m4a", "display_order": 20, "topics": [{"text": "हंसेतिहासः", "range": "१५–४२"}]}, {"id": 6000314020, "chapter_id": 10314, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.020.m4a", "display_order": 21}, {"id": 6000314021, "chapter_id": 10314, "verse_number": "११-१३-१६", "content_sanskrit": "पुत्रा हिरण्यगर्भस्य मानसाः सनकादयः।\nपप्रच्छुः पितरं सूक्ष्मां योगस्यैकान्तिकीं गतिम्॥ ११/१३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.021.m4a", "display_order": 22}, {"id": 6000314022, "chapter_id": 10314, "verse_number": null, "content_sanskrit": "सनकादय ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.022.m4a", "display_order": 23}, {"id": 6000314023, "chapter_id": 10314, "verse_number": "११-१३-१७", "content_sanskrit": "गुणेष्वाविशते चेतो गुणाश्चेतसि च प्रभो।\nकथमन्योन्यसन्त्यागो मुमुक्षोः सन्तितीर्षोः॥ ११/१३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.023.m4a", "display_order": 24}, {"id": 6000314024, "chapter_id": 10314, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.024.m4a", "display_order": 25}, {"id": 6000314025, "chapter_id": 10314, "verse_number": "११-१३-१८", "content_sanskrit": "एवं पृष्टो महादेवः स्वयम्भूर्भूतभावनः।\nध्यायमानः प्रश्नबीजं नाभ्यपद्यत कर्मधीः॥ ११/१३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.025.m4a", "display_order": 26}, {"id": 6000314026, "chapter_id": 10314, "verse_number": "११-१३-१९", "content_sanskrit": "स मामचिन्तयद् देवः प्रश्नपारविनिश्चयम्।\nतस्याहं हंसरूपेण समीपमगमं तदा॥ ११/१३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.026.m4a", "display_order": 27}, {"id": 6000314027, "chapter_id": 10314, "verse_number": "११-१३-२०", "content_sanskrit": "दृष्ट्वा मां त उपाव्रज्य कृतपादाभिवन्दनम्।\nब्रह्माणमग्रतः कृत्वा पप्रच्छुः को भवानिति॥ ११/१३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.027.m4a", "display_order": 28}, {"id": 6000314028, "chapter_id": 10314, "verse_number": "११-१३-२१", "content_sanskrit": "इत्यहं मुनिभिः पृष्टस्तत्वजिज्ञासुभिस्तदा।\nयदवोचमहं तेभ्यस्तदुद्धव निबोध मे॥ ११/१३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.028.m4a", "display_order": 29}, {"id": 6000314029, "chapter_id": 10314, "verse_number": "११-१३-२२", "content_sanskrit": "वस्तुनो यद्यनानात्वमात्मनः प्रश्न ईदृशः।\nकथं घटेत वो विप्रा वक्तुं वाऽनेक आश्रयः॥ ११/१३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.029.m4a", "display_order": 30}, {"id": 6000314030, "chapter_id": 10314, "verse_number": "११-१३-२३", "content_sanskrit": "पञ्चात्मकेषु भूतेषु समानेषु च वस्तुतः।\nको भवानिति वः प्रश्नो वाचारम्भो निरर्थकः॥ ११/१३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.030.m4a", "display_order": 31}, {"id": 6000314031, "chapter_id": 10314, "verse_number": "११-१३-२४", "content_sanskrit": "मनसा वचसा दृष्ट्या गृह्यतेऽन्यैरपीन्द्रियैः।\nअहमेव न मत्तोऽन्यदिति बुद्ध्यध्वमञ्जसा॥ ११/१३/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.031.m4a", "display_order": 32}, {"id": 6000314032, "chapter_id": 10314, "verse_number": "११-१३-२५", "content_sanskrit": "गुणेष्वाविशते चेतो गुणाश्चेतसि च प्रजाः।\nजीवस्य देह उभयं गुणाश्चेतो मदात्मनः॥ ११/१३/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.032.m4a", "display_order": 33}, {"id": 6000314033, "chapter_id": 10314, "verse_number": "११-१३-२६", "content_sanskrit": "गुणेषु वा विशेच्चित्तमभीक्ष्णं गुणसेवया।\nगुणाश्च चित्तप्रभवा मद्रूप उभयं त्यजेत्॥ ११/१३/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.033.m4a", "display_order": 34}, {"id": 6000314034, "chapter_id": 10314, "verse_number": "११-१३-२७", "content_sanskrit": "जाग्रत्स्वप्नः सुषुप्तिश्च गुणतो बुद्धिवृत्तयः।\nतासां विलक्षणो जीवः साक्षित्वेन विनिश्चितः॥ ११/१३/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.034.m4a", "display_order": 35}, {"id": 6000314035, "chapter_id": 10314, "verse_number": "११-१३-२८", "content_sanskrit": "यर्हि संसृतिबन्धोऽयमात्मनो गुणवृत्तितः।\nमयि तुर्ये स्थितो जह्यात् त्यागस्तु गुणचेतसाम्॥ ११/१३/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.035.m4a", "display_order": 36}, {"id": 6000314036, "chapter_id": 10314, "verse_number": "११-१३-२९", "content_sanskrit": "अहङ्कारकृतं बन्धमात्मनोऽर्थविपर्ययम्।\nविद्वान् निर्विद्य संसारचिन्तां तुर्ये स्थितस्त्यजेत्॥ ११/१३/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.036.m4a", "display_order": 37}, {"id": 6000314037, "chapter_id": 10314, "verse_number": "११-१३-३०", "content_sanskrit": "यावन्नानार्थधीः पुंसो न निवर्तेत युक्तिभिः।\nजाग्रत्यपि स्वपन्नज्ञः स्वप्ने जागरणं यथा॥ ११/१३/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.037.m4a", "display_order": 38}, {"id": 6000314038, "chapter_id": 10314, "verse_number": "११-१३-३१", "content_sanskrit": "असत्त्वादात्मनोऽन्येषां भावानां किंकृताऽभिदा।\nगतयो हेतवश्चास्य मृषा स्वप्नदृशो यथा॥ ११/१३/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.038.m4a", "display_order": 39}, {"id": 6000314039, "chapter_id": 10314, "verse_number": "११-१३-३२", "content_sanskrit": "यो जागरे बहुविधान् क्षणधर्मिणोऽर्थान् भुङ्क्ते समस्तकरणो हृदि तत्सदृक्षान्।\nस्वप्नेऽथ सुप्त उपसंहरते स एकः स्मृत्यन्वयात् त्रिगुणवृत्तिदृगिन्द्रियेशः॥ ११/१३/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.039.m4a", "display_order": 40}, {"id": 6000314040, "chapter_id": 10314, "verse_number": "११-१३-३३", "content_sanskrit": "एवं विमृश्य गुणतो मनसस्‍त्र्यवस्था मन्मायया मयि कृता इति निश्चितार्थाः।\nसञ्छिद्य हार्दमनुमानसदुक्तितीक्ष्णज्ञानासिना भजत माऽखिलसंशयाधिम्॥ ११/१३/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.040.m4a", "display_order": 41}, {"id": 6000314041, "chapter_id": 10314, "verse_number": "११-१३-३४", "content_sanskrit": "वीक्षेत विभ्रममिमं मनसो विलासं दृष्टं विनष्टमतिलोलमलातचक्रम्।\nविज्ञानमेकमुरुधेव विभाति माया स्वप्ने यथा त्रिगुणसर्गकृतो विकल्पः॥ ११/१३/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.041.m4a", "display_order": 42}, {"id": 6000314042, "chapter_id": 10314, "verse_number": "११-१३-३५", "content_sanskrit": "दृष्टिं ततः प्रतिनिवर्त्य निवृत्ततर्षस्तूष्णीं भवेन्निजसुखानुभवो निरीहः।\nसन्दृश्यते क्‍वच यदीदमवस्तुबुद्ध्या त्यक्तं भ्रमाय न भवेत् स्मृतिरानिपातात्॥ ११/१३/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.042.m4a", "display_order": 43}, {"id": 6000314043, "chapter_id": 10314, "verse_number": "११-१३-३६", "content_sanskrit": "देहं च नश्वरमवस्थितमुत्थितश्च च सिद्धो न पश्यति यतोऽध्यगमत् स्वरूपम्।\nदैवादुपेतमथ दैववशादपेतं वासो यथा परिवृतं मदिरामदान्धः॥ ११/१३/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.043.m4a", "display_order": 44}, {"id": 6000314044, "chapter_id": 10314, "verse_number": "११-१३-३७", "content_sanskrit": "देहोऽपि दैववशगः खलु कर्म यावत् स्वारम्भकं प्रति समीक्षत एव सासुः।\nतं सप्रपञ्चमधिरूढसमाधियोगः स्वाप्नं पुनर्न भजते प्रतिबुद्धवत् सः॥ ११/१३/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.044.m4a", "display_order": 45}, {"id": 6000314045, "chapter_id": 10314, "verse_number": "११-१३-३८", "content_sanskrit": "मयैतदुक्तं वो विप्रा गुह्यं यत् साङ्ख्ययोगयोः।\nजानीत माऽऽगतं यज्ञं युष्मद्धर्मविवक्षया॥ ११/१३/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.045.m4a", "display_order": 46}, {"id": 6000314046, "chapter_id": 10314, "verse_number": "११-१३-३९", "content_sanskrit": "अहं योगस्य साङ्ख्यस्य सत्यस्यर्तस्य तेजसः।\nपरायणं द्विजश्रेष्ठाः श्रियः कीर्तेर्दमस्य च॥ ११/१३/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.046.m4a", "display_order": 47}, {"id": 6000314047, "chapter_id": 10314, "verse_number": "११-१३-४०", "content_sanskrit": "मां भजन्ति गुणाः सर्वे निर्गुणं निरपेक्षकम्।\nसुहृदं परमात्मानं साम्यासङ्गादयो गुणाः॥ ११/१३/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.047.m4a", "display_order": 48}, {"id": 6000314048, "chapter_id": 10314, "verse_number": "११-१३-४१", "content_sanskrit": "इति ते च्छिन्नसन्देहा मुनयः सनकादयः।\nसभाजयित्वा परया भक्त्याऽगृणत संस्तवैः॥ ११/१३/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.048.m4a", "display_order": 49}, {"id": 6000314049, "chapter_id": 10314, "verse_number": "११-१३-४२", "content_sanskrit": "तैरहं पूजितः सम्यक् संस्तुतः परमर्षिभिः।\nप्रतीयाय स्वकं धाम पश्यतः परमेष्ठिनः॥ ११/१३/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_013/BhP_11.013.049.m4a", "display_order": 50}, {"id": 6000314050, "chapter_id": 10314, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायाम् एकादशस्कन्धे त्रयोदशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]