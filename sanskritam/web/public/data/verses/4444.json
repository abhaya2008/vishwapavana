[{"id": 2158912, "chapter_id": 4444, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2158913, "chapter_id": 4444, "verse_number": "१", "content_sanskrit": "एवं विलपमाने तु कुन्तीपुत्रे युधिष्ठिरे ।\nकृष्णद्वैपायनस्तत्र प्रादुर्भूतो महानृषिः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2158914, "chapter_id": 4444, "verse_number": "२", "content_sanskrit": "अथ दृष्ट्वा महात्मानं पाण्डुपुत्रो युधिष्ठिरः ।\nमुक्तासनो दीनमनाः पूजां चक्रे महामनाः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2158915, "chapter_id": 4444, "verse_number": "३", "content_sanskrit": "तं समर्च्य यथान्यायमुपातिष्ठद् युधिष्ठिरः ।\nअब्रवीच्छोकसन्तप्तो भ्रातुः पुत्रवधेन सः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2158916, "chapter_id": 4444, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2158917, "chapter_id": 4444, "verse_number": "४", "content_sanskrit": "अधर्मयुद्धे बहुभिः परिवार्य महारथैः ।\nयुद्ध्यमानो महेष्वासैः सौभद्रो निहतो रणे\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2158918, "chapter_id": 4444, "verse_number": "५", "content_sanskrit": "बालश्चाबालबुद्धिश्च वीरश्च परवीरहा ।\nअनुपायेन सङ्ग्रामे युद्ध्यमानो विनाशितः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2158919, "chapter_id": 4444, "verse_number": "६", "content_sanskrit": "मयाऽपि चोक्तः सङ्ग्रामे द्वारं सञ्जनयस्व नः ।\nप्रविष्टे च परांस्तस्मिन् सैन्धवेन स्म वारिताः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2158920, "chapter_id": 4444, "verse_number": "७", "content_sanskrit": "ननु नाम समं युद्धमेष्टव्यं युद्धजीविना ।\nइदं च विषमं युद्धमीदृशं बहुभिः कृतम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2158921, "chapter_id": 4444, "verse_number": "८", "content_sanskrit": "तेनास्मि भृशसन्तप्तः शोकबाष्पसमाकुलः ।\nशमं नैवाधिगच्छामि चिन्तयानः पुनःपुनः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2158922, "chapter_id": 4444, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2158923, "chapter_id": 4444, "verse_number": "९", "content_sanskrit": "तं तथा विलपन्तं वै शोकोपहतचेतसम् ।\nउवाच भगवान् व्यासो युधिष्ठिरमिदं वचः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2158924, "chapter_id": 4444, "verse_number": "१०", "content_sanskrit": "युधिष्ठिर महाप्राज्ञ सर्वशास्त्रविशारद ।\nव्यसनेषु न मुह्यन्ति त्वादृशाः पुरुषर्षभ\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2158925, "chapter_id": 4444, "verse_number": "११", "content_sanskrit": "स्वर्गमेष गतः शूरः शत्रून् हत्वा रणे बहून् ।\nअबालसदृशं कर्म कृत्वा वै पुरुषर्षभः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2158926, "chapter_id": 4444, "verse_number": "१२", "content_sanskrit": "अनतिक्रमणीयो हि विधिरेष सनातनः ।\nदेवदानवगन्धर्वा मृत्युं गच्छन्ति भारत\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2158927, "chapter_id": 4444, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2158928, "chapter_id": 4444, "verse_number": "१३", "content_sanskrit": "य इमे पृथिवीपालाः शेरते पृथिवीतळे ।\nनिहताः पृतनामध्ये मृतसञ्ज्ञा महाबलाः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2158929, "chapter_id": 4444, "verse_number": "१४", "content_sanskrit": "दृढं नागबलाश्चान्ये सर्वे युद्धविशारदाः ।\nत एते निहताः सङ्खे तुल्यरूपैर्नरैर्नराः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2158930, "chapter_id": 4444, "verse_number": "१५", "content_sanskrit": "एकैकशो भीमबला नागायुतशतोपमाः ।\nइषुवेगबलाश्चान्ये वायुवेगबलास्तथा\nनैषां पश्यामि हन्तारं प्राणिनां संयुगे क्वचित्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2158931, "chapter_id": 4444, "verse_number": "१६", "content_sanskrit": "विक्रमेणोपपन्ना हि तेजोबलसमन्विताः ।\nजेतव्यमिति चान्योन्यं नित्यं येषां हृदि स्थितः\nअथ चेमे महाप्राज्ञाः शेरते च गतायुषः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2158932, "chapter_id": 4444, "verse_number": "१७", "content_sanskrit": "मृता इति च शब्दोऽयं वर्तते च गतायुषाम्॥ १७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2158933, "chapter_id": 4444, "verse_number": "१८", "content_sanskrit": "इमे मृता महीपालाः प्रायशो भीमविक्रमाः ।\nराजपुत्राश्च संरब्धा वैश्वानरसमप्रभाः\nनिश्चेष्टाः निरभीमानाः शूराः शत्रुवशं गताः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2158934, "chapter_id": 4444, "verse_number": "१९", "content_sanskrit": "तत्र मे संशयः प्राप्तः कुतः सञ्ज्ञा मृता इति ।\nकस्य मृत्युः कुतो मृत्युः केन मृत्युरिमाः प्रजाः\nहरत्यमरसङ्काश तन्मे ब्रूहि पितामह\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2158935, "chapter_id": 4444, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2158936, "chapter_id": 4444, "verse_number": "२०", "content_sanskrit": "तं तथा परिपृच्छन्तं कुन्तीपुत्रं युधिष्ठिरम् ।\nआश्वासनमिदं वाक्यमुवाच भगवानृषिः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2158937, "chapter_id": 4444, "verse_number": "२१", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nअकम्पनस्य कथितं नारदेन पुरा नृप\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2158938, "chapter_id": 4444, "verse_number": "२२", "content_sanskrit": "स चापि राजा राजेन्द्र पुत्रव्यसनमुत्तमम् ।\nअप्रसँह्यतमं लोके प्राप्तवानिति नः श्रुतम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2158939, "chapter_id": 4444, "verse_number": "२३", "content_sanskrit": "तत् तेऽहं सम्प्रवक्ष्यामि मृत्योः प्रभवमुत्तमम् ।\nततस्त्वं मोक्ष्यसे दुःखाद् स्नेहबन्धनसंश्रयात्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2158940, "chapter_id": 4444, "verse_number": "२५", "content_sanskrit": "पुरावृत्तमिदं तात मम कीर्तयतः शृणु ।\nधर्म्यमाख्यानमायुष्यं शोकघ्नं पुष्टिवर्धनम्\t॥२४॥\nपवित्रमरिसङ्गघ्नं मङ्गळानां च मङ्गळम् ।\nयथैव वेदाध्ययनमुपाख्यानमिदं तथा\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2158941, "chapter_id": 4444, "verse_number": "२६", "content_sanskrit": "श्रवणीयं महाराज प्रातर्नित्यं नृपोत्तमैः ।\nपुत्रानायुष्मतो राज्यमीहमानैः श्रियं तथा\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2158942, "chapter_id": 4444, "verse_number": "२७", "content_sanskrit": "पुरा कृतयुगे तात राजा ह्यासीदकम्पनः ।\nस शत्रुवशमापन्नो मध्ये सङ्ग्राममूर्धनि\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2158943, "chapter_id": 4444, "verse_number": "२८", "content_sanskrit": "तस्य पुत्रो हरिर्नाम नारायणसमद्युतिः ।\nश्रीमान् कृतास्त्रो मेधावी युधि शक्रसमो बली\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2158944, "chapter_id": 4444, "verse_number": "२९", "content_sanskrit": "स शत्रुभिः परिवृतो बहुधा रणमूर्धनि ।\nयोधयामास तान् सर्वान् सर्वास्त्रकुशलो बली\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2158945, "chapter_id": 4444, "verse_number": "३०", "content_sanskrit": "वर्षन् बाणसहस्राणि शत्रुष्वमितविक्रमः ।\nपदातिरथनागाश्वान् प्रममाथ महाबलः\nस कर्म दुष्करं कृत्वा सङ्ग्रामे शत्रुतापनः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2158946, "chapter_id": 4444, "verse_number": "३१", "content_sanskrit": "तदुदीर्णं बलं सर्वं हत्वाऽरीनरिसूदनः ।\nस शत्रुवशमापन्नो मध्ये सङ्ग्राममूर्धनि\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2158947, "chapter_id": 4444, "verse_number": "३२", "content_sanskrit": "स दृष्ट्वा पितरं युद्धे तदवस्थं महाद्युतिः ।\nअचिन्तयित्वा मरणं शत्रुमध्येऽविशत् सुतः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2158948, "chapter_id": 4444, "verse_number": "३३", "content_sanskrit": "स शरैरायसैश्चक्रैः गदाभिर्मुसलैरपि ।\nमृद्गन् रथिसहस्राणि रथांश्च हयवारणान्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2158949, "chapter_id": 4444, "verse_number": "३४", "content_sanskrit": "परानीकं विभिद्याजौ मोक्षयित्वा च तं नृपम् ।\nपुनरेवाकरोद् युद्धं शत्रुमध्यगतो बली\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2158950, "chapter_id": 4444, "verse_number": "३५", "content_sanskrit": "ततस्ते रथिनः सर्वे समेत्य पुनराहवे ।\nजघ्नुस्तं परिवार्यैकं तोमरैरिव कुञ्जरम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2158951, "chapter_id": 4444, "verse_number": "३६", "content_sanskrit": "स कर्म दुष्करं कृत्वा सङ्ग्रामे शत्रुतापनः ।\nशत्रुभिर्निहतः शेते पृतनायां युधिष्ठिर\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2158952, "chapter_id": 4444, "verse_number": "३७", "content_sanskrit": "द्विषद्भिर्निहतं दृष्ट्वा प्रियं पुत्रमकम्पनः ।\nअमर्षजनितक्रोध आहवात् सहसाऽऽगतः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2158953, "chapter_id": 4444, "verse_number": "३८", "content_sanskrit": "स राजा प्रेतकृत्यानि तस्य कृत्वा शुचाऽन्वितः ।\nशोचन्नहनि रात्रौ च न लेभे सुखमात्मनः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2158954, "chapter_id": 4444, "verse_number": "३९", "content_sanskrit": "तस्य शोकं विदित्वा तु पुत्रव्यसनसम्भवम् ।\nअथाजगाम देवर्षिर्नारदोऽस्य समीपतः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2158955, "chapter_id": 4444, "verse_number": "४०", "content_sanskrit": "स तु राजा महाभागो दृष्ट्वा देवर्षिमागतम् ।\nपूजयित्वा यथान्यायं कथामकथयत् तदा\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2158956, "chapter_id": 4444, "verse_number": "४१", "content_sanskrit": "तदस्मै सर्वमाचष्ट यथावृत्तं युधिष्ठिर ।\nशत्रुभिर्निर्जितं सङ्खे पुत्रस्य च वधं तथा\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2158957, "chapter_id": 4444, "verse_number": "", "content_sanskrit": "अकम्पनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2158958, "chapter_id": 4444, "verse_number": "४२", "content_sanskrit": "मम पुत्रो महावीर्य इन्द्रविष्णुसमद्युतिः ।\nशत्रुभिर्बहुभिः सङ्खे पराक्रम्य हतो युधि\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2158959, "chapter_id": 4444, "verse_number": "४३", "content_sanskrit": "शृणोमि प्राणिनां चापि मृत्युः प्रभवते किल ।\nक एष बलवान् मृत्युः किंवीर्यबलपौरुषः\nएतदिच्छामि तत्त्वेन कथितं द्विजसत्तम\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2158960, "chapter_id": 4444, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2158961, "chapter_id": 4444, "verse_number": "४४", "content_sanskrit": "तस्य तद् वचनं श्रुत्वा नारदो भगवान् ऋषिः ।\nआख्यानमिदमाचष्ट पुत्रशोकापहं महत्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2158962, "chapter_id": 4444, "verse_number": "४५", "content_sanskrit": "राजन् शृणु ममेदं त्वमाख्यानं बहुविस्तरम् ।\nयथावृत्तं श्रुतं चैव मयाऽपि वसुधाधिप\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2158963, "chapter_id": 4444, "verse_number": "४६", "content_sanskrit": "प्रजाः सृष्ट्वा महाराज प्रजासर्गे पितामहः ।\nअसंहृतं महातेजा दृष्ट्वा जगदिदं प्रभुः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2158964, "chapter_id": 4444, "verse_number": "४७", "content_sanskrit": "तस्य चिन्ता समुत्पन्ना संहारं प्रति पार्थिव ।\nचिन्तयन् नाससादैव संहारं वसुधाधिप\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2158965, "chapter_id": 4444, "verse_number": "४८", "content_sanskrit": "तस्य रोषान्महाराज मुखेभ्योऽग्निरजायत ।\nतेन सर्वा दिशो व्याप्ताः सर्वान् देशान् दिधक्षता\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2158966, "chapter_id": 4444, "verse_number": "४९", "content_sanskrit": "ततो भुवं दिवं चैव सर्वं ज्वालाभिरावृतम् ।\nचराचरं जगत् सर्वं ददाह भगवान् प्रभुः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2158967, "chapter_id": 4444, "verse_number": "५०", "content_sanskrit": "महता कोपवेगेन त्रासयन्निव वीर्यवान् ।\nकोपो दहति भूतानि जङ्गमानि ध्रुवाणि च\nतथा हतानि भूतानि त्रसानि स्थावराणि च\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2158968, "chapter_id": 4444, "verse_number": "५१", "content_sanskrit": "ततो हरो जटी स्थाणुर्निशाचरपतिः शिवः ।\nजगाम शरणं देवं ब्रह्माणं परवीरहन्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2158969, "chapter_id": 4444, "verse_number": "५२", "content_sanskrit": "तस्मिन्नुपस्थिते स्थाणौ प्रजानां हितकाम्यया ।\nअब्रवीत् परमो देवो ज्वलन्निव महाद्युतिः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2158970, "chapter_id": 4444, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2158971, "chapter_id": 4444, "verse_number": "५३", "content_sanskrit": "किं कुर्मि कामं कामारे कामाज्जातोऽसि पुत्रक ।\nकरिष्यामि प्रियं सर्वं ब्रूहि स्थाणो यदिच्छसि\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2158972, "chapter_id": 4444, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि एकोनपञ्चाशत्तमोऽध्यायः ॥ ४९ ॥\nअभिमन्युवधपर्वणि अष्टादशोऽध्यायः ॥ १८ ॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]