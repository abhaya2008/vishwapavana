[{"id": 2101285, "chapter_id": 3181, "verse_number": "१४-३७-१", "content_sanskrit": "ब्रह्मोवाच।\nतदव्यक्तमनुद्रिक्तं सर्वव्यापि ध्रुवं स्थिरम्।\nनवद्वारं पुरं विद्यात्त्रिगुणं पञ्चधातुकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2101286, "chapter_id": 3181, "verse_number": "१४-३७-२", "content_sanskrit": "एकादशपरिक्षेपं मनोव्याकरणात्मकम्।\nबुद्धिस्वामिकमित्येतत्परमेकादशं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2101287, "chapter_id": 3181, "verse_number": "१४-३७-३", "content_sanskrit": "त्रीणि स्रोतांसि यान्यस्मिन्नाप्यायन्ते पुनःपुनः।\nप्रनाड्यस्तिस्र एवैताः प्रवर्न्तते गुणात्मिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2101288, "chapter_id": 3181, "verse_number": "१४-३७-४", "content_sanskrit": "तमो रजस्तथा सत्वं गुणानेतान्प्रचक्षते।\nअन्योन्यमिथुनाः सर्वे तथाऽन्योन्यानुजीविनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2101289, "chapter_id": 3181, "verse_number": "१४-३७-५", "content_sanskrit": "अन्योन्यापाश्रयाश्चापि तथाऽन्योन्यानुवर्तिनः।\nअन्योन्यव्यतिषक्ताश्च त्रिगुणाः पञ्चधातवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2101290, "chapter_id": 3181, "verse_number": "१४-३७-६", "content_sanskrit": "तमसो मिथुनं सत्वं सत्वस्य मिथुनं रजः।\nरजसश्चापि सत्वं स्यात्सत्वस्य मिथुनं तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2101291, "chapter_id": 3181, "verse_number": "१४-३७-७", "content_sanskrit": "नियम्यते तमो यत्र रजस्तत्र निवर्तते।\nनियम्यते रजो यत्र सत्वं तत्र प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2101292, "chapter_id": 3181, "verse_number": "१४-३७-८", "content_sanskrit": "नैशात्मकं तमो विद्यात्त्रिगुणं मोहसंज्ञितम्।\nअधर्मलक्षणं चैव नियतं पापकर्मसु।\nतामसं रूपमेतत्तु दृश्यते चापि सङ्गतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2101293, "chapter_id": 3181, "verse_number": "१४-३७-९", "content_sanskrit": "प्रकृत्यात्मकमेवाहू रजः पर्यायकारकम्।\nसत्त्वे तु सर्वभूतेषु दृश्यमुत्पत्तिलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2101294, "chapter_id": 3181, "verse_number": "१४-३७-१०", "content_sanskrit": "प्रकाशं सर्वभूतेषु लाघवं श्रद्धधानता।\nसात्विकं रूपमेवं तु लाघवं साधुसंमितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2101295, "chapter_id": 3181, "verse_number": "१४-३७-११", "content_sanskrit": "एतेषां गुणतत्त्वानि वक्ष्यन्ते तत्त्वहेतुभिः।\nसमासव्यासयुक्तानि तत्त्वतस्तानि बोधत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2101296, "chapter_id": 3181, "verse_number": "१४-३७-१२", "content_sanskrit": "सम्मोहो ज्ञानमत्यागः कर्मणामविनिर्णयः।\nस्वप्नः स्तंभो भयं लोभः शोकः सुकृतदूषणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2101297, "chapter_id": 3181, "verse_number": "१४-३७-१३", "content_sanskrit": "अस्मृतिश्चाविपाकश्च नास्तिक्यं भिन्नवृत्तिता।\nनिर्विशेषत्वमन्धत्वं जघन्यगुणवृत्तिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2101298, "chapter_id": 3181, "verse_number": "१४-३७-१४", "content_sanskrit": "अकृते कृतमानित्वमज्ञाने ज्ञानमानिता।\nअमैत्री विकृतो भावो ह्यश्रद्धा मूढभावना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2101299, "chapter_id": 3181, "verse_number": "१४-३७-१५", "content_sanskrit": "अनार्जवमसंज्ञत्वं कर्म पापमचेतना।\nगुरुत्वं सन्नभावत्वमवशित्वमवाग्गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2101300, "chapter_id": 3181, "verse_number": "१४-३७-१६", "content_sanskrit": "सर्व एते गुणा वृत्तास्तामसाः सम्प्रकीर्तिताः।\nये चान्ये विहिता भावा लोकेऽस्मिन्भावसंज्ञिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2101301, "chapter_id": 3181, "verse_number": "१४-३७-१७", "content_sanskrit": "तत्रतत्र नियम्यन्ते सर्वे ते तामसा गुणाः।\nपरिवादकथा नित्यं मेवब्राह्मणवैरिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2101302, "chapter_id": 3181, "verse_number": "१४-३७-१८", "content_sanskrit": "अत्यागश्चातिमानश्च मोहो मन्युस्तथाऽक्षमा।\nमत्सरश्चैव भूतेषु तामसं वृत्तमिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2101303, "chapter_id": 3181, "verse_number": "१४-३७-१९", "content_sanskrit": "वृथारम्भा हि ये केचिद्वृथा दानानि यानि च।\nवृथाभक्षणमित्येतत्तामसं वृत्तमिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2101304, "chapter_id": 3181, "verse_number": "१४-३७-२०", "content_sanskrit": "अतिवादोऽतितिक्षा च मात्सर्यमभिमानिता।\nअश्रद्दधानता चैव तामसं वृत्तमिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2101305, "chapter_id": 3181, "verse_number": "१४-३७-२१", "content_sanskrit": "एवंविधाश्च ये केचिल्लोकेऽस्मिन्पापकर्मिणः।\nमनुष्या भिन्नमर्यादास्ते सर्वे तामसाः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2101306, "chapter_id": 3181, "verse_number": "१४-३७-२२", "content_sanskrit": "तेषां योनीः प्रवक्ष्यामि नियताः पापकर्मिणाम्।\nअवाङ्निरयभावा ये तिर्यङ्निरयगामिनः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2101307, "chapter_id": 3181, "verse_number": "१४-३७-२३", "content_sanskrit": "स्थावराणि च भूतानि पशवो वाहनानि च।\nक्रव्यादा दंदशूकाश्च कृमिकीटविहङ्गमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2101308, "chapter_id": 3181, "verse_number": "१४-३७-२४", "content_sanskrit": "अब्जाता जन्तवश्चैव सर्वे चापि चतुष्पदाः।\nउन्मत्ता बधिरा मूका ये चान्ये पापरोगिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2101309, "chapter_id": 3181, "verse_number": "१४-३७-२५", "content_sanskrit": "मग्नास्तमसि दुर्वृत्ताः स्वकर्मकृतलक्षणाः।\nअवाक्स्रोतस इत्येते मग्नास्तमसि तामसाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2101310, "chapter_id": 3181, "verse_number": "१४-३७-२६", "content_sanskrit": "तेषामुत्कर्षमुद्रेकं वक्ष्याम्यहमतः परम्।\nयथा ते सुकृतां लोकाँल्लभन्ते पुण्यकर्मिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2101311, "chapter_id": 3181, "verse_number": "१४-३७-२७", "content_sanskrit": "अन्यथा प्रतिपन्नास्तु विवृद्धा ये च कर्मसु।\nस्वकर्मनिरतानां च ब्राह्मणानां शुभैषिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2101312, "chapter_id": 3181, "verse_number": "१४-३७-२८", "content_sanskrit": "संस्कारेणोर्ध्वमायान्ति यतमानाः सलोकताम्।\nस्वर्गे गच्छन्ति देवानामित्येषा वैदिकी श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2101313, "chapter_id": 3181, "verse_number": "१४-३७-२९", "content_sanskrit": "अन्यथा प्रतिपन्नास्ते विबुद्धाः स्वेषु कर्मसु।\nपुनरावृत्तिधर्माणस्ते भवन्तीह मानुषाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2101314, "chapter_id": 3181, "verse_number": "१४-३७-३०", "content_sanskrit": "पापयोनिं समापन्नाश्चण्डाला मूकचूचुकाः॥\nवर्णान्पर्यायशश्चापि प्राप्नुवन्त्युत्तरोत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2101315, "chapter_id": 3181, "verse_number": "१४-३७-३१", "content_sanskrit": "शूद्रयोनिमतिक्रम्य ये चान्ये तामसा गुणाः।\nस्रोतोमध्ये समागम्य वर्तन्ते तामसे गुणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2101316, "chapter_id": 3181, "verse_number": "१४-३७-३२", "content_sanskrit": "अभिष्वङ्गस्तु कामेषु महामोह इति स्मृतः।\nऋषयो मुनयो देवा मुह्यन्त्यत्र सुखेप्सवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2101317, "chapter_id": 3181, "verse_number": "१४-३७-३३", "content_sanskrit": "तमोमोहो महामोहस्तामिस्रो ह्यन्धसंज्ञितः।\nमरणं त्वन्धतामिस्रस्तामिस्रः क्रोध उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2101318, "chapter_id": 3181, "verse_number": "१४-३७-३४", "content_sanskrit": "वर्णतो गुणतश्चैव योनितश्चैव तत्त्वतः।\nसर्वमेततमो विप्राः कीर्तितं वो यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2101319, "chapter_id": 3181, "verse_number": "१४-३७-३५", "content_sanskrit": "को न्वेतद्बुध्यते साधु को न्वेतत्साधु पश्यति।\nअतत्त्वे तत्त्वदर्शी यस्तमसस्तच्च लक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2101320, "chapter_id": 3181, "verse_number": "१४-३७-३६", "content_sanskrit": "तमोगुणा बहुविधाः प्रकीर्तिता\nयथावदुक्तं च तमः परावरम्।\nनरो हि यो वेद गुणानिमान्सदा\nस तामसैः सर्वगुणैः प्रमुच्यते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2101321, "chapter_id": 3181, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि सप्तत्रिंशोऽध्यायः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]