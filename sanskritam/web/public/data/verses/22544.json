[{"id": 7002544000, "chapter_id": 22544, "verse_number": "१-२०६-१", "content_sanskrit": "भीष्म उवाच ।\nमंत्रोद्धारं परं ब्रूहि मुद्राशक्तिसमन्वितम् ।\nरूपवर्ण समं चैव पौराणिकमनुत्तमम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002544001, "chapter_id": 22544, "verse_number": "१-२०६-२", "content_sanskrit": "व्यास उवाच ।\nशृणु भीष्म महाबाहो यथा वक्ष्यामि तेनघ ।\nपौराणिकानां मंत्राणामुद्धारं वैदिकादृते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002544002, "chapter_id": 22544, "verse_number": "१-२०६-३", "content_sanskrit": "वर्णरेफसमायुक्तं विद्रुमेनैव भूषितम् ।\nअंतस्थानां हि अंत्यं वै ब्रह्मदैवत्यमुच्यते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002544003, "chapter_id": 22544, "verse_number": "१-२०६-४", "content_sanskrit": "बिंदुरेफसमायुक्तं दीर्घया मात्रया तथा ।\nदीक्षाक्षरं समुद्दिष्टं द्वितीयं विष्णुदैवतम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002544004, "chapter_id": 22544, "verse_number": "१-२०६-५", "content_sanskrit": "तृतीयं तु तथा प्रोक्तं सविसर्गं जनाधिप ।\nस तृतीयो बुधैः प्रोक्तो रुद्रदैवत एव हि ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002544005, "chapter_id": 22544, "verse_number": "१-२०६-६", "content_sanskrit": "भास्करोयं महान्साक्षान्मंत्रमूर्तिस्त्रिरक्षरः ।\nदुर्लभः परमो गुह्यस्त्रिदेवो देवपूजितः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002544006, "chapter_id": 22544, "verse_number": "१-२०६-७", "content_sanskrit": "यस्त्विदं जपते भक्त्या स याति परमां गतिम् ।\nततश्च मुद्रां वक्ष्यामि सान्निध्य कारणं परम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002544007, "chapter_id": 22544, "verse_number": "१-२०६-८", "content_sanskrit": "पद्माकारौ करौ कृत्वा मध्ये श्लिष्टे तु मध्यमे ।\nअंगुलिं क्षारयेत्तस्मिन्विमुद्रेति च सोच्यते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002544008, "chapter_id": 22544, "verse_number": "१-२०६-९", "content_sanskrit": "अनया बद्धया राजन्भास्करस्य प्रियो भवेत् ।\nमहाभयेषु सर्वेषु मातृवत्परिरक्षति ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002544009, "chapter_id": 22544, "verse_number": "१-२०६-१०", "content_sanskrit": "हृदयं तस्य विज्ञेयं यदक्षरवरं स्मृतम् ।\nविद्रुमोपरि संछन्नं हृद्गतं तद्गतं सदा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002544010, "chapter_id": 22544, "verse_number": "१-२०६-११", "content_sanskrit": "शिरस्यर्कमिति प्रोक्तं देवदेवस्य भारत ।\nमहाव्याहृतयस्तिस्रस्तथारज्वालिनी शिखा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002544011, "chapter_id": 22544, "verse_number": "१-२०६-१२", "content_sanskrit": "अष्टाक्षरा तु विद्येयमादित्यस्य महात्मनः ।\nयः स्मरेत्साधकस्त्वेनं नासौ केनापि बाध्यते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002544012, "chapter_id": 22544, "verse_number": "१-२०६-१३", "content_sanskrit": "अकारेण समायुक्तं बिंदुरेफसमन्वितम् ।\nहकारमग्निदैवत्यं कवचं भास्करप्रियम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002544013, "chapter_id": 22544, "verse_number": "१-२०६-१४", "content_sanskrit": "एकाक्षरमिदं प्रोक्तमभेद्यं यः स्मरेदिदम् ।\nदुष्टानां चैव विघ्नानां नाशनं नात्र संशयः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002544014, "chapter_id": 22544, "verse_number": "१-२०६-१५", "content_sanskrit": "सविसर्गो रेफ इति अस्त्रमेकाक्षरं स्मृतम् ।\nनाशयेद्दुष्टकर्माणि साधकस्य न संशयः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002544015, "chapter_id": 22544, "verse_number": "१-२०६-१६", "content_sanskrit": "संमुखौ तौ करौ कृत्वा श्लिष्टौ तु ग्रथितांगुली ।\nकनिष्ठेनामिके योज्ये तर्जन्यौ मध्यमे तथा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002544016, "chapter_id": 22544, "verse_number": "१-२०६-१७", "content_sanskrit": "हृच्छिरः सशिखा चर्मा मुद्रेयं व्योमसंज्ञिता ।\nमुष्टिवक्रोच्छ्रितं कुर्यात्सव्यहस्तस्य तर्जनीम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002544017, "chapter_id": 22544, "verse_number": "१-२०६-१८", "content_sanskrit": "मालशब्दकृतादिस्तु मुद्रा ह्यस्त्रस्य कीर्तिता ।\nत्रासनी नाम विख्याता सर्वविप्रभयंकरी ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002544018, "chapter_id": 22544, "verse_number": "१-२०६-१९", "content_sanskrit": "कर्णबिंदुसमायुक्तं यं चतुर्थं महामते ।\nभास्करस्य त्विदं नेत्रमग्रिदैवतमुच्यते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002544019, "chapter_id": 22544, "verse_number": "१-२०६-२०", "content_sanskrit": "स्मरः स्यात्साधकेंद्राणां दुरंतो नाशने ध्रुवम् ।\nमध्यमा तर्जनी चैव सव्यहस्तस्य चोच्छ्रितम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002544020, "chapter_id": 22544, "verse_number": "१-२०६-२१", "content_sanskrit": "कनिष्ठानामिके कुंच्य अंगुष्ठेन ततः क्रमेत् ।\nनेत्राभ्यां स्पर्शयेदेनां नेत्रमुद्रा प्रकीर्तिता ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002544021, "chapter_id": 22544, "verse_number": "१-२०६-२२", "content_sanskrit": "गोवृषा नाम विख्याता दर्शयेद्दिव्यगोचरम् ।\nरां दीप्तारिं ततः सूक्ष्मारीं जया भीष्म उच्यते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002544022, "chapter_id": 22544, "verse_number": "१-२०६-२३", "content_sanskrit": "उभाह्वारूं विभूतिश्च विमला रें प्रकीर्तिता ।\nअघहा च महाबाहो विद्युता रौं प्रकीर्तिता ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002544023, "chapter_id": 22544, "verse_number": "१-२०६-२४", "content_sanskrit": "गोवृषा नाम रं सर्वं वीरभद्रकरी तथा ।\nइत्येता बीजरूपास्तु कथिताश्चैव शक्तयः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002544024, "chapter_id": 22544, "verse_number": "१-२०६-२५", "content_sanskrit": "उत्तानौ तु करौ कृत्वा सव्याकुंच्य ततोंगुलीः ।\nकुर्यादुपरि चांगुष्ठौ चालयेत पुनःपुनः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002544025, "chapter_id": 22544, "verse_number": "१-२०६-२६", "content_sanskrit": "सर्वासां चैव शक्तीनामेता मुद्राः प्रदर्शयेत् ।\nनाम्ना च विद्युता चैव नवमी सर्वतोमुखी ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002544026, "chapter_id": 22544, "verse_number": "१-२०६-२७", "content_sanskrit": "नामान्येतानि शक्तीनां समासात्कथितानि तु ।\nसबीजानि महाबाहो मया स्नेहेन भारत ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002544027, "chapter_id": 22544, "verse_number": "१-२०६-२८", "content_sanskrit": "ग्रहाणां शृणु बीजानि रूपं च गदतो मम ।\nसर्वत्र भं तथा खं च कंजकूतुहलोद्वह ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002544028, "chapter_id": 22544, "verse_number": "१-२०६-२९", "content_sanskrit": "ओंकारा दीपिताः सर्वे नमस्कारांतयोजिताः ।\nपूजाकाले प्रयोक्तव्या जपकाले तथैव च ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002544029, "chapter_id": 22544, "verse_number": "१-२०६-३०", "content_sanskrit": "होमकाले तु स्वाहांतं मंत्रं षट्कारसंयुतम् ।\nसर्वे बिंदुयुता भीष्म शिखा बिंदुविभूषिताः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002544030, "chapter_id": 22544, "verse_number": "१-२०६-३१", "content_sanskrit": "सोमाद्याः केतुपर्यंता ग्रहा ह्येवं प्रकीर्तिताः ।\nएता मुद्राः प्रवक्ष्यामि सर्वसिद्धिप्रदायिकाः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002544031, "chapter_id": 22544, "verse_number": "१-२०६-३२", "content_sanskrit": "सुमुखौ तु करौ कृत्वा श्लिष्टौ चैव प्रसारितौ ।\nइयं मुद्रा नमस्कारे ग्रहसान्निध्यकारिका ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002544032, "chapter_id": 22544, "verse_number": "१-२०६-३३", "content_sanskrit": "मंत्रोद्धारस्तवाख्यातो रहस्यो दुर्लभो नृप ।\nशृणुष्व रूपं देवानां ध्यानकाले ह्युपस्थिते ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002544033, "chapter_id": 22544, "verse_number": "१-२०६-३४", "content_sanskrit": "जपावर्णं महातेजं श्वेतपद्मोपरि स्थितम् ।\nसर्वलक्षणसंपन्नं सर्वाभरणभूषितम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002544034, "chapter_id": 22544, "verse_number": "१-२०६-३५", "content_sanskrit": "तथैकवक्त्रं द्विभुजं सोमपंकजकंधरम् ।\nमंडलेन च रूपं तु मध्यस्थं रक्तवाससम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002544035, "chapter_id": 22544, "verse_number": "१-२०६-३६", "content_sanskrit": "मार्तंडस्य इदं रूपं शुचिः स्नातो जितेंद्रियः ।\nत्रिकालं यः स्मरेद्भीम एकचित्तो व्यवस्थितः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002544036, "chapter_id": 22544, "verse_number": "१-२०६-३७", "content_sanskrit": "सोऽचिराद्भवते लोके वित्तेन धनदोपमः ।\nमुच्यते सर्वभोगैस्तु तेजस्वी बलवान्भवेत् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002544037, "chapter_id": 22544, "verse_number": "१-२०६-३८", "content_sanskrit": "हृदयं चोत्तमांगं च शिखा वै वक्त्रमेव च ।\nरक्तवर्णा इमे श्यामाः सर्वाभरणभूषिताः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002544038, "chapter_id": 22544, "verse_number": "१-२०६-३९", "content_sanskrit": "वरदाऽभयहस्ताश्च ध्यातव्या साधकेन तु ।\nतडित्पुंजनिभं शस्त्रं रौद्रं चंद्रकरालिनम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002544039, "chapter_id": 22544, "verse_number": "१-२०६-४०", "content_sanskrit": "विशेषः कथितो ह्येष कामरूपः स्वभावतः ।\nदीप्ता दीप्तशिखाकारा ध्यातव्या मम शक्तयः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002544040, "chapter_id": 22544, "verse_number": "१-२०६-४१", "content_sanskrit": "श्वेतवर्णं स्मरेत्सोमं रक्तवर्णं कुजं स्मरेत् ।\nसौम्यमष्टापदाभं च गुरुं च पीतवर्णकम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002544041, "chapter_id": 22544, "verse_number": "१-२०६-४२", "content_sanskrit": "शंखक्षीरनिभं श्वेतं काणं चांजनसंनिभम् ।\nरजावर्तनिभं राहुं धूम्रं च विकचं स्मरेत् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002544042, "chapter_id": 22544, "verse_number": "१-२०६-४३", "content_sanskrit": "वामहस्तौ कटिन्यस्तौ दक्षिणौ चाभयप्रदौ ।\nरक्तभ्रूरक्तनेत्रास्य अर्धकायकृतांजलिः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002544043, "chapter_id": 22544, "verse_number": "१-२०६-४४", "content_sanskrit": "इति भानुं ग्रहैः सार्धं ये ध्यायंति नृपोत्तम ।\nलभंते ते महासिद्धिमचिरान्नात्र संशयः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002544044, "chapter_id": 22544, "verse_number": "१-२०६-४५", "content_sanskrit": "तवाख्यातमिदं वक्त्रं ग्रहाणां भीष्म कृत्स्नशः ।\nयच्छ्रुत्वा सर्वपापेभ्यो मुच्यंते भुवि मानवाः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002544045, "chapter_id": 22544, "verse_number": "१-२०६-४६", "content_sanskrit": "अनेन विधिना भीष्म सदा देवं दिवाकरम् ।\nत्रिकालं पूजयेद्भक्त्या वीर श्रद्धासमन्वितः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002544046, "chapter_id": 22544, "verse_number": "१-२०६-४७", "content_sanskrit": "इत्थं पूजयमानस्तु सर्वदेवं दिवाकरम् ।\nब्रह्महत्याविनिर्मुक्तो महादेवत्वमाप्नुयात् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]