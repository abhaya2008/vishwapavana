[{"id": 2166753, "chapter_id": 4581, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2166754, "chapter_id": 4581, "verse_number": "१", "content_sanskrit": "ततो द्रोणे हते राजन् दुर्योधनमुखा नृपाः ।\nभृशमुद्विग्नमनसो द्रोणपुत्रमुपागमन्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2166755, "chapter_id": 4581, "verse_number": "२", "content_sanskrit": "ते द्रोणमनुशोचन्तः कश्मलाभिहतौजसः ।\nपर्युपासन्त शोकार्तास्ततः शारद्वतीसुतम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2166756, "chapter_id": 4581, "verse_number": "३", "content_sanskrit": "ते मुहूर्तं समाश्वास्य हेतुभिः शास्त्रसम्मितैः ।\nरात्र्यागमे महीपालाः स्वानि वेश्मानि भेजिरे\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2166757, "chapter_id": 4581, "verse_number": "४", "content_sanskrit": "ते वेश्मस्वपि कौरव्य पृथ्वीशा नाप्नुवन् सुखम् ।\nचिन्तयन्तः क्षयं तीव्रं दुःखशोकसमन्विताः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2166758, "chapter_id": 4581, "verse_number": "५", "content_sanskrit": "विशेषतः सूतपुत्रो राजा चैव सुयोधनः ।\nदुःशासनश्च शकुनिः सौबलश्च महाबलः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2166759, "chapter_id": 4581, "verse_number": "६", "content_sanskrit": "उषितास्ते निशां तां तु दुर्योधननिवेशने ।\nचिन्तयन्तः परिक्लेशान् पाण्डवानां महात्मनाम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2166760, "chapter_id": 4581, "verse_number": "७", "content_sanskrit": "यत्तद् द्यूते परिक्लिष्टा कृष्णा चानायिता सभाम् ।\nतत् स्मरन्तोऽनुशोचन्तो भृशमुद्विग्नचेतसः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2166761, "chapter_id": 4581, "verse_number": "८", "content_sanskrit": "तथा तु सञ्चिन्तयतां तान् क्लेशान् द्यूतकारितान् ।\nदुःखेन क्षणदा राजन् जगामाब्दशतोपमा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2166762, "chapter_id": 4581, "verse_number": "९", "content_sanskrit": "ततः प्रभाते विमले स्थिता दिष्टस्य शासने ।\nचक्रुरावश्यकं सर्वे विधिदृष्टेन कर्मणा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2166763, "chapter_id": 4581, "verse_number": "१०", "content_sanskrit": "ते कृत्वाऽवश्यकार्याणि समाश्वस्य च भारत ।\nयोगमाज्ञापयामासुर्युद्धाय च विनिर्ययुः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2166764, "chapter_id": 4581, "verse_number": "११", "content_sanskrit": "कर्णं सेनापतिं कृत्वा कृतकौतुकमङ्गलाः ।\nपूजयित्वा द्विजश्रेष्ठान् दधिपात्रघृताक्षतैः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2166765, "chapter_id": 4581, "verse_number": "१२", "content_sanskrit": "गोभिरश्वैश्च निष्कैश्च वासोभिश्च महाधनैः ।\nवन्द्यमाना जयाशीर्भिः सूतमागधवन्दिभिः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2166766, "chapter_id": 4581, "verse_number": "१३", "content_sanskrit": "तथैव पाण्डवा राजन् कृतपूर्वाह्णिकक्रियाः ।\nशिबिरान्निर्ययुस्तूर्णं युद्धाय कृतनिश्चयाः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2166767, "chapter_id": 4581, "verse_number": "१४", "content_sanskrit": "ततः प्रववृते युद्धं तुमुलं रोमहर्षणम् ।\nकुरूणां पाण्डवानां च परस्परजयैषिणाम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2166768, "chapter_id": 4581, "verse_number": "१५", "content_sanskrit": "तयोर्द्विदिवसं युद्धं कुरुपाण्डवसेनयोः ।\nकर्णे सेनापतौ राजन् बभूवाद्भुतदर्शनम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2166769, "chapter_id": 4581, "verse_number": "१६", "content_sanskrit": "ततः शत्रुक्षयं कृत्वा सुमहान्तं रणे वृषः ।\nपश्यतां धार्तराष्ट्राणां फल्गुनेन निपातितः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2166770, "chapter_id": 4581, "verse_number": "१७", "content_sanskrit": "ततस्तु सञ्जयः सर्वं गत्वा नागपुरं द्रुतम् ।\nआचष्ट धृतराष्ट्राय यद् वृत्तं कुरुजाङ्गले\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2166771, "chapter_id": 4581, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2166772, "chapter_id": 4581, "verse_number": "१८", "content_sanskrit": "आपगेयं हतं श्रुत्वा द्रोणं चापि महारथम् ।\nआजगाम परामार्तिं वृद्धो राजाऽम्बिकासुतः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2166773, "chapter_id": 4581, "verse_number": "१९", "content_sanskrit": "स श्रुत्वा निहतं कर्णं दुर्योधनहितैषिणम् ।\nकथं द्विजवर प्राणानधारयत दुःखितः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2166774, "chapter_id": 4581, "verse_number": "२०", "content_sanskrit": "यस्मिन् जयाशां पुत्राणां सममन्यत पार्थिवः ।\nतस्मिन् हते स कौरव्यः कथं प्राणानधारयत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2166775, "chapter_id": 4581, "verse_number": "२१", "content_sanskrit": "दुर्मरत्वमहं मन्ये नृणां कृच्छ्रेऽपि वर्तताम् ।\nयत्र कर्णं हतं श्रुत्वा नात्यजज्जीवितं नृपः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2166776, "chapter_id": 4581, "verse_number": "२२", "content_sanskrit": "तथा शान्तनवं वृद्धं ब्रह्मन् बाह्लीकमेव च ।\n(द्रोणं च सोमदत्तं च भूरिश्रवसमेव च\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2166777, "chapter_id": 4581, "verse_number": "२३", "content_sanskrit": "तथैव चान्यान् सुहृदः पुत्रान् पौत्रांश्च पातितान् ।\nश्रुत्वा यन्नाजहात् प्राणांस्तन्मन्ये दुष्करं द्विज\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2166778, "chapter_id": 4581, "verse_number": "२४", "content_sanskrit": "एतन्मे सर्वमाचक्ष्व विस्तरेण महामुने ।)\nन हि तृप्यामि पूर्वेषां शृण्वानश्चरितं महत्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2166779, "chapter_id": 4581, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसाहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nप्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2166780, "chapter_id": 4581, "verse_number": "", "content_sanskrit": "* * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]