[{"id": 7004380000, "chapter_id": 24380, "verse_number": "५-३-७४-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nरेवाया उत्तरे कूले तीर्थं परमशोभनम् ।\nसर्वपापहरं मर्त्ये नाम्ना वै गौतमेश्वरम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004380001, "chapter_id": 24380, "verse_number": "५-३-७४-२", "content_sanskrit": "स्थापितं गौतमेनैव लोकानां हितकाम्यया ।\nस्वर्गसोपानरूपं तु तीर्थं पुंसां युधिष्ठिर॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004380002, "chapter_id": 24380, "verse_number": "५-३-७४-३", "content_sanskrit": "तत्र गच्छ परं भक्त्या यत्र देवो जगद्गुरुः ।\nपातकस्य विनाशार्थं स्वर्गवासप्रदस्तथा॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004380003, "chapter_id": 24380, "verse_number": "५-३-७४-४", "content_sanskrit": "सौभाग्यवर्द्धनं तीर्थं जयदं दुःखनाशनम् ।\nपिण्डदानेन चैकेन कुलानामुद्धरेत्त्रयम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004380004, "chapter_id": 24380, "verse_number": "५-३-७४-५", "content_sanskrit": "यत्किंचिद्दीयते भक्त्या स्वल्पं वा यदि वा बहु ।\nतत्सर्वं शतसाहस्रमाज्ञया गौतमस्य हि॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004380005, "chapter_id": 24380, "verse_number": "५-३-७४-६", "content_sanskrit": "तीर्थानां परमं तीर्थं स्वयं रुद्रेण भाषितम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]