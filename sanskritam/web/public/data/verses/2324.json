[{"id": 2062086, "chapter_id": 2324, "verse_number": "८-४५-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2062087, "chapter_id": 2324, "verse_number": "८-४५-१", "content_sanskrit": "तानभिद्रवतो दृष्ट्वा पाण्डवांस्तावकं बलम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2062088, "chapter_id": 2324, "verse_number": "८-४५-१०", "content_sanskrit": "अन्तमद्य गमिष्यामि तस्य दुःखस्य पार्षत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2062089, "chapter_id": 2324, "verse_number": "८-४५-११", "content_sanskrit": "हन्तास्म्यद्य रणे कर्णं स वा मां निहनिष्यति।\nसङ्ग्रामेऽद्य सुघोरेऽस्मिन्सत्यमेतद्ब्रवीमि वः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2062090, "chapter_id": 2324, "verse_number": "८-४५-१२", "content_sanskrit": "राजानमद्य भवतां न्यासभूतं ददानि वै।\nतस्य संरक्षणे सर्वे यतध्वं विगतज्वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2062091, "chapter_id": 2324, "verse_number": "८-४५-१३", "content_sanskrit": "एवमुक्त्वा महाबाहुः प्रायादाधिरथिं प्रति।\nसिंहनादेन महता सर्वाः सन्नादयन्दिशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2062092, "chapter_id": 2324, "verse_number": "८-४५-१४", "content_sanskrit": "दृष्ट्वा त्वरितमायान्तं भीमं युद्धाभिनन्दिनम्।\nसूतपुत्रमथोवाच मद्राणामीश्वरो विभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2062093, "chapter_id": 2324, "verse_number": "८-४५-१५x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2062094, "chapter_id": 2324, "verse_number": "८-४५-१५", "content_sanskrit": "पश्य कर्ण महाबाहुं सङ्क्रुद्धं पाण्डुनन्दनम्।\nदीर्घकालार्जितं क्रोधं मोक्तुकामं त्वयि ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2062095, "chapter_id": 2324, "verse_number": "८-४५-१६", "content_sanskrit": "ईदृशं नास्य रूपं मे दृष्टपूर्वं कदाचन।\nअभिमन्यौ हते कर्ण राक्षसे च घटोत्कचे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2062096, "chapter_id": 2324, "verse_number": "८-४५-१७", "content_sanskrit": "त्रैलोक्यस्य समस्तस्य शक्तः क्रुद्धो निवारणे।\nबिभर्ति सदृशं रूपं युगान्ताग्निसमप्रभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2062097, "chapter_id": 2324, "verse_number": "८-४५-१८x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2062098, "chapter_id": 2324, "verse_number": "८-४५-१८", "content_sanskrit": "इति ब्रुवति राधेयं मद्राणामीश्वरे नृप।\nअभ्यवर्तत वै कर्णं क्रोधदीप्ततो वृकोदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2062099, "chapter_id": 2324, "verse_number": "८-४५-१९", "content_sanskrit": "अथागतं तु सम्प्रेक्ष्य भीमं युद्धाभिनन्दिनम्।\nअब्रवीद्वचनं शल्यं राधेयः प्रहसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2062100, "chapter_id": 2324, "verse_number": "८-४५-२०", "content_sanskrit": "यदुक्तं वचनं मेऽद्य त्वया मद्रजनेश्वर।\nभीमसेनं प्रति विभो तत्सत्यं नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2062101, "chapter_id": 2324, "verse_number": "८-४५-२१", "content_sanskrit": "एष शूरश्च वीरश्च क्रोधनश्च वृकोदरः।\nनिरपेक्षः शरीरे च प्राणतश्च बलाधिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2062102, "chapter_id": 2324, "verse_number": "८-४५-२२", "content_sanskrit": "अज्ञातवासं वसता विराटनगरे तदा।\nद्रौपद्याः प्रियकामेन केवलं बाहुसंश्रयात्।\nगूढभावं समाश्रित्य कीचकः सगणो हतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2062103, "chapter_id": 2324, "verse_number": "८-४५-२३", "content_sanskrit": "सोऽद्य सङ्ग्रामशिरसि सन्नद्वः क्रोधमूर्च्छितः।\nकिं करोद्यतदण्डेन मृत्युनापि व्रजेद्रणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2062104, "chapter_id": 2324, "verse_number": "८-४५-२४", "content_sanskrit": "चिरकालाभिलषितो ममायं तु मनोरथः।\nअर्जुनं समरे हन्यां मां वा हन्याद्वनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2062105, "chapter_id": 2324, "verse_number": "८-४५-२५", "content_sanskrit": "स मे कदाचिदद्यैव भवेद्भीमसमागमात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2062106, "chapter_id": 2324, "verse_number": "८-४५-२६", "content_sanskrit": "निहते भीमसेने वा यदि वा विरथीकृते।\nअभियास्यति मां पार्थस्तन्मे साधु भविष्यति।\nअत्र यन्मन्यसे प्राप्तं तच्छीघ्रं सम्प्रधारय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2062107, "chapter_id": 2324, "verse_number": "८-४५-२७x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2062108, "chapter_id": 2324, "verse_number": "८-४५-२७", "content_sanskrit": "एतच्छ्रुत्वा तु वचनं राधेयस्यामितौजसः।\nउवाच वचनं शल्यः सूतपुत्रं तथागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2062109, "chapter_id": 2324, "verse_number": "८-४५-२८", "content_sanskrit": "अभियाहि महाबाहो भीमसेनं महाबलम्।\nनिरपेक्षश्च युध्यस्व शक्तिं स्वां सम्प्रदर्शयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2062110, "chapter_id": 2324, "verse_number": "८-४५-२९", "content_sanskrit": "यस्ते कामोऽभिलषितश्चिरात्प्रभृति हृद्गततः।\nस वै सम्पत्स्यते कर्ण सत्यमेतद्ब्रवीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2062111, "chapter_id": 2324, "verse_number": "८-४५-३०", "content_sanskrit": "एवमुक्ते ततः कर्णः शल्यं पुनरभाषत।\nहन्ताऽहमेनं संरब्धं मां वा हन्ता वृकोदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2062112, "chapter_id": 2324, "verse_number": "८-४५-३१", "content_sanskrit": "एवमुक्त्वा महाराज राधेयो रथिनां वरः।\nयुद्धे मनः समाधाय याहि याहीत्यचोदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2062113, "chapter_id": 2324, "verse_number": "८-४५-३२", "content_sanskrit": "ततः प्रायाद्रथेनाशु शल्यस्तत्र विशाम्पते।\nयत्र भीमो महेष्वासो व्यद्रावयत वाहिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2062114, "chapter_id": 2324, "verse_number": "८-४५-३३", "content_sanskrit": "ततस्तूर्यनिनादश्च भेरीणां च महास्वनः।\nउदतिष्ठच्च राजेन्द्र कर्णभीमसमागमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2062115, "chapter_id": 2324, "verse_number": "८-४५-३४", "content_sanskrit": "भीमसेनोऽथथ सङ्क्रुद्धस्तस्य सैन्यं दुरासदम्।\nनाराचैर्विमलैस्तीक्ष्णैर्दिशः प्राद्रावयद्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2062116, "chapter_id": 2324, "verse_number": "८-४५-३५", "content_sanskrit": "स सन्निपातस्ततुमुलो घोररूपो विशाम्पते।\nआसीद्रौद्रो महाराज कर्णपाण्डवयोर्मृधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2062117, "chapter_id": 2324, "verse_number": "८-४५-३६", "content_sanskrit": "ततो मुहूर्ताद्राजेन्द्र नातिकृच्छ्राद्धसन्निव।\nभीमसेनो महाबाहुः कर्णं प्रेप्सुरभिद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2062118, "chapter_id": 2324, "verse_number": "८-४५-३७", "content_sanskrit": "समापतन्तं सम्प्रेक्ष्य कर्णो वैकर्तनो वृषा।\nआजघान सुसङ्क्रुद्धो नाराचेन स्तनान्तरे।\nपुनश्चैनममेयात्मा शरवर्षैरवाकिरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2062119, "chapter_id": 2324, "verse_number": "८-४५-३८", "content_sanskrit": "स विद्वः सूतपुत्रेण च्छादयामास पत्रिभिः।\nविव्याध निशितैः कर्णं नवभिर्नतपर्वभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2062120, "chapter_id": 2324, "verse_number": "८-४५-३९", "content_sanskrit": "तस्य कर्णो धनुर्मध्ये द्विधा चिच्छेद पत्रिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2062121, "chapter_id": 2324, "verse_number": "८-४५-४०", "content_sanskrit": "अथैनं छिन्नधन्वानं प्रतत्यविध्यत्स्तनान्तरे।\nनाराचेन सुतीक्ष्णेन सर्वावरणभेदिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2062122, "chapter_id": 2324, "verse_number": "८-४५-४१", "content_sanskrit": "सोऽन्यत्कार्मुकमादाय सूततपुत्रं वृकोदरः।\nराजन्मर्मसु मर्मज्ञो विव्याध निशितैः शरैः।\nननाद बलवन्नादं कम्पयन्निव रोदसी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2062123, "chapter_id": 2324, "verse_number": "८-४५-४२", "content_sanskrit": "ततं कर्णः पञ्चविंशत्या नाराचानां समार्पयत्।\nमदोत्कटं वने दृप्ततमुल्काभिरिव कुञ्जरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2062124, "chapter_id": 2324, "verse_number": "८-४५-४३", "content_sanskrit": "ततः सायकभिन्नाङ्गः पाण्डवः क्रोधमूर्च्छितः।\nसंरम्भामर्षताम्राक्षः सूतपुत्रवधेप्सया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2062125, "chapter_id": 2324, "verse_number": "८-४५-४४", "content_sanskrit": "स कार्मुके महावेगं भारसाधनमुत्तमम्।\nगिरीणामपि भेत्तारं सायकं समयोजयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2062126, "chapter_id": 2324, "verse_number": "८-४५-४५", "content_sanskrit": "विकृष्य बलवच्चापमाकर्णादतिमारुतिः।\nतं मुमोच महेष्वासः क्रुद्धः कर्णजिघांसया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2062127, "chapter_id": 2324, "verse_number": "८-४५-४६", "content_sanskrit": "स विसृष्टो बलवता बाणो वज्राशनिस्वनः।\nअदारयद्रणे कर्णं वज्रवेगो यथाऽचलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2062128, "chapter_id": 2324, "verse_number": "८-४५-४७", "content_sanskrit": "स भीमसेनाभिहतः सूतपुत्रः कुरूद्वह।\nनिषसाद रथोपस्थे विसंज्ञः पृतनापतिः।\n`रुधिरेणावसिक्ताङ्गो गतासुवदरिन्दमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2062129, "chapter_id": 2324, "verse_number": "८-४५-४८", "content_sanskrit": "एतस्मिन्नन्तरे दृष्ट्वा मद्रराजो वृकोदरम्।\nजिघांसुं छेत्तुमायान्तं साधयन्निदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2062130, "chapter_id": 2324, "verse_number": "८-४५-४९", "content_sanskrit": "भीमसेन महाबाहो यतत्तत्वां वक्ष्यामि तच्छृणु।\nवचनं हेतुसम्पन्नं श्रुत्वा चैतत्तथा कुरु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2062131, "chapter_id": 2324, "verse_number": "८-४५-५०", "content_sanskrit": "अर्जुनेन प्रतिज्ञातो वधः कर्णस्य शुष्मिणः।\nतां तथा कुरु भद्रं ते प्रतिज्ञां सव्यसाचिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2062132, "chapter_id": 2324, "verse_number": "८-४५-५१x", "content_sanskrit": "भीमसेन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2062133, "chapter_id": 2324, "verse_number": "८-४५-५१", "content_sanskrit": "दृढव्रतत्वं पार्थस्य जानामि नृपसत्तम।\nराज्ञस्तु धर्षणं पापः कृतवान्मम सन्निधौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2062134, "chapter_id": 2324, "verse_number": "८-४५-५२", "content_sanskrit": "ततः कोपाभिभूतेन शेषं न गणितं मया।\nपतिते चापि राधेये न मे मन्युः शमं गतः)।\nजिह्वोद्वरणमेवास्य प्राप्तकालं मतं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2062135, "chapter_id": 2324, "verse_number": "८-४५-५३", "content_sanskrit": "अनेन सुनृशंसेन समवेतेषु राजसु।\nअस्माकं शृण्वतां शल्य यानि वाक्यानि मातुल।\nअसहेयानि नीचानि बहूनि श्रावितानि भो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2062136, "chapter_id": 2324, "verse_number": "८-४५-५४", "content_sanskrit": "नूनं चैतत्प्रतिज्ञातं दूरस्थस्यापि पार्थिव।\nछेदनं चास्य जिह्वायास्तदैवाकाङ्क्षितं मया।\nराज्ञस्तु प्रियकामेन कालोऽयं परिपालितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2062137, "chapter_id": 2324, "verse_number": "८-४५-५५", "content_sanskrit": "भवता तु यदुक्तोऽस्मि वाक्यं हेत्वर्थसंहितम्।\nतद्गृहीतं महारात कटुकस्थमिवौषधम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2062138, "chapter_id": 2324, "verse_number": "८-४५-५६", "content_sanskrit": "हीनप्रतिज्ञो बीभत्सुर्न हि जीवेत कर्हिचित्।\nअस्मिन्विनष्टे नष्टाः स्मः सर्व एव सकेशवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2062139, "chapter_id": 2324, "verse_number": "८-४५-५७", "content_sanskrit": "अद्य चैव नृशंसात्मा पापः पापकृतां वरः।\nगमिष्यतति परीभावं दृष्टमात्रः किरीटिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2062140, "chapter_id": 2324, "verse_number": "८-४५-५८", "content_sanskrit": "युधिष्ठिरस्य कोपेन पूर्वं दग्धो नृशंसकृत्।\nत्वया संरक्षिततस्तत्वद्य मत्समीपादुपागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2062141, "chapter_id": 2324, "verse_number": "८-४५-५९x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2062142, "chapter_id": 2324, "verse_number": "८-४५-५९", "content_sanskrit": "एवं मद्राधिपः श्रुत्वा विसंज्ञं सूतनन्दनम्।\nअपोवाह रथेनाजौ कर्णमाहवशोभिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2062143, "chapter_id": 2324, "verse_number": "८-४५-६०", "content_sanskrit": "पराजिते ततः कर्णे धार्तराष्ट्री महाचमूः।\nव्यपायात्सर्वतो भग्ना हाहाभूता समन्ततः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2062144, "chapter_id": 2324, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि सप्ततदशदिवसयुद्धे पञ्चचत्वारिंशोऽध्यायः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]