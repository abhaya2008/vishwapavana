[{"id": 2212691, "chapter_id": 5533, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2212692, "chapter_id": 5533, "verse_number": "१", "content_sanskrit": "ततो राज्ञाऽभ्यनुज्ञातो धृतराष्ट्रो महामनाः ।\nययौ स्वभवनं राजा गान्धार्याऽनुगतस्तदा\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2212693, "chapter_id": 5533, "verse_number": "२", "content_sanskrit": "मन्दप्राणगतिर्धीमान् कृच्छ्रादिव समुद्धरन् ।\nपदातिः स महीपालो जीर्णो गजपतिर्यथा\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2212694, "chapter_id": 5533, "verse_number": "३", "content_sanskrit": "तमन्वगच्छद् विदुरो विद्वान् सूतश्च सञ्जयः ।\nस चैव परमेष्वासः कृपः शारद्वतस्तदा\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2212695, "chapter_id": 5533, "verse_number": "४", "content_sanskrit": "प्रविश्य च गृहं राजा कृतपूर्वाह्णिकक्रियः ।\nतर्पयित्वा द्विजश्रेष्ठान् आहारमकरोत् तदा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2212696, "chapter_id": 5533, "verse_number": "५", "content_sanskrit": "गान्धारी चैव धर्मज्ञा कुन्त्या सह मनस्विनी ।\nवधूभिरुपचारेण पूजिताऽभुङ्क्त भारत\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2212697, "chapter_id": 5533, "verse_number": "६", "content_sanskrit": "कृताहारं कृताहाराः सर्वे ते विदुरादयः ।\nपाण्डवाश्च कुरुश्रेष्ठमुपातिष्ठन्त भारत\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2212698, "chapter_id": 5533, "verse_number": "७", "content_sanskrit": "ततोऽब्रवीन्महाराजः कुन्तीपुत्रमुपह्वरे ।\nनिषण्णं पाणिना पृष्ठे संस्पृशन्नम्बिकासुतः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2212699, "chapter_id": 5533, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2212700, "chapter_id": 5533, "verse_number": "८", "content_sanskrit": "अप्रमादस्त्वया कार्यः सर्वथा कुरुनन्दन ।\nअष्टाङ्गे राजशार्दूल राज्ये धर्मपुरस्कृते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2212701, "chapter_id": 5533, "verse_number": "९", "content_sanskrit": "ननु शक्यं यथा तात रक्षितुं पाण्डुनन्दन ।\nराज्यं धर्मं च कौन्तेय विद्वानसि निबोध तत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2212702, "chapter_id": 5533, "verse_number": "१०", "content_sanskrit": "विद्यावृद्धान् सदैव त्वमुपासीथा युधिष्ठिर ।\nशृणुयास्ते हि यद् ब्रूयुः कुर्याश्चैवाविचारयन्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2212703, "chapter_id": 5533, "verse_number": "११", "content_sanskrit": "प्रातरुत्थाय तान् राजन् पूजयित्वा यथाविधि ।\nकृच्छ्रकाले समुत्पन्ने पृच्छेथाः कार्यमात्मनः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2212704, "chapter_id": 5533, "verse_number": "१२", "content_sanskrit": "ते सुसम्मानिता राजन् त्वया राज्ये हितार्थिना ।\nप्रवक्ष्यन्ति हितं तात सर्वं कौरवनन्दन\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2212705, "chapter_id": 5533, "verse_number": "१३", "content_sanskrit": "इन्द्रियाणि च सर्वाणि राज्यवत् परिपालय ।\nहिताय वै भविष्यन्ति रक्षितं द्रविणं यथा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2212706, "chapter_id": 5533, "verse_number": "", "content_sanskrit": "(अमात्यानुपधातीतान् पितृपैतामहान् शुचीन् ।\nदान्तान् कर्मसु सर्वेषु मुख्यान् मुख्येषु योजय\t॥१४॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2212707, "chapter_id": 5533, "verse_number": "१५", "content_sanskrit": "साधयेथाश्च सततं चारैरविदितैः परान् ।\nपरीक्षितैर्बहुविधैः स्वराष्ट्रेषु परेषु च\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2212708, "chapter_id": 5533, "verse_number": "१६", "content_sanskrit": "पुरं च ते सुगुप्तं स्याद् दृढप्राकारतोरणम् ।\nअट्टाट्टालकसम्बाधं षट्पदं सर्वतो दिशम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2212709, "chapter_id": 5533, "verse_number": "१७", "content_sanskrit": "तस्य द्वाराणि कार्याणि पर्याप्तानि बृहन्ति च ।\nसर्वतः सुविभक्तानि यन्त्रैरारक्षितानि च\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2212710, "chapter_id": 5533, "verse_number": "१८", "content_sanskrit": "पुरुषैरर्थतत्त्वज्ञैर्विदितैः कुलशीलतः ।\nआत्मा च रक्ष्यः सततं भोजनादिषु भारत\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2212711, "chapter_id": 5533, "verse_number": "१९", "content_sanskrit": "विहारादिषु सर्वेषु माल्यशय्यासनेषु च\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2212712, "chapter_id": 5533, "verse_number": "२०", "content_sanskrit": "स्त्रियश्च ते सुगुप्ताः स्युर्वृद्धैराप्तैरधिष्ठिताः ।\nशीलवद्भिः कुलीनैश्च विद्वद्भिश्च युधिष्ठिर\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2212713, "chapter_id": 5533, "verse_number": "२१", "content_sanskrit": "मन्त्रिणश्चैव कुर्वीथा द्विजान् विद्याविशारदान् ।\nविनीतांश्च कुलीनांश्च धर्मार्थकुशलानृजून्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2212714, "chapter_id": 5533, "verse_number": "२२", "content_sanskrit": "तैः सार्धं मन्त्रयेथास्त्वं नात्यर्थं बहुभिः सह ।\nसमस्तैरपि च व्यस्तैर्व्यपदेशेन केनचित्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2212715, "chapter_id": 5533, "verse_number": "२३", "content_sanskrit": "सुसंवृतं मन्त्रगृहं सौधं चारुह्य मन्त्रयेत् ।\nअरण्ये निःशलाके वा न च रात्रौ कदाचन\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2212716, "chapter_id": 5533, "verse_number": "२४", "content_sanskrit": "वानराः पक्षिणश्चैव ये मनुष्यानुकारिणः ।\nसर्वे मन्त्रगृहे वर्ज्या ये चापि जडपङ्गवः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2212717, "chapter_id": 5533, "verse_number": "२५", "content_sanskrit": "मन्त्रभेदे च ये दोषा भवन्ति पृथिवीक्षिताम् ।\nन ते शक्याः समाधातुं कथञ्चिदिति मे मतिः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2212718, "chapter_id": 5533, "verse_number": "२६", "content_sanskrit": "दोषांश्च मन्त्रभेदेषु ब्रूयास्त्वं मन्त्रिमण्डले ।\nअभेदे च गुणान् राजन् पुनः पुनररिन्दम\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2212719, "chapter_id": 5533, "verse_number": "२७", "content_sanskrit": "पौरजानपदानां च शौचाशौचे युधिष्ठिर\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2212720, "chapter_id": 5533, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nआश्रमवासिकपर्वणि राज्यरक्षणोपायकथनं नाम नवमोऽध्यायः ॥९॥\nआश्रमवासपर्वणि नवमोऽध्यायः ॥९॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]