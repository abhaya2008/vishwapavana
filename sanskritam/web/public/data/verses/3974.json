[{"id": 2137246, "chapter_id": 3974, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2137247, "chapter_id": 3974, "verse_number": "१", "content_sanskrit": "यत्तदा ह महद् ब्रह्मल्लोमशो वाक्यमब्रवीत् ।\nइन्द्रस्य वचनादेव पाण्डुपुत्रं युधिष्ठिरम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2137248, "chapter_id": 3974, "verse_number": "२", "content_sanskrit": "यच्चापि ते भयं तीव्रं न च कीर्तयसे क्वचित् ।\nतच्चाप्यपहरिष्यामि धनञ्जय इतो गते \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2137249, "chapter_id": 3974, "verse_number": "३", "content_sanskrit": "किं नु तज्जपतां श्रेष्ठ कर्णं प्रति महद् भयम् ।\nआसीन्न च स धर्मात्मा कथयामास कस्यचित् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2137250, "chapter_id": 3974, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2137251, "chapter_id": 3974, "verse_number": "४", "content_sanskrit": "अहं ते राजशार्दूल कथयामि कथामिमाम् ।\nपृच्छतो भरतश्रेष्ठ शुश्रूषस्व गिरं मम \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2137252, "chapter_id": 3974, "verse_number": "५", "content_sanskrit": "द्वादशे समतिक्रान्ते वर्षे प्राप्ते त्रयोदशे ।\nपाण्डूनां हितकृच्छक्रः कर्णं भिक्षितुमुद्यतः \t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2137253, "chapter_id": 3974, "verse_number": "६", "content_sanskrit": "अभिप्रायमथो ज्ञात्वा महेन्द्रस्य विभावसुः ।\nकुण्डलार्थे महाराज सूर्यः कर्णमुपागतः \t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2137254, "chapter_id": 3974, "verse_number": "७", "content_sanskrit": "महार्हे शयने वीरं स्पर्द्ध्यास्तरणसंवृते ।\nशयानमतिविश्वस्तं ब्रह्मण्यं सत्यवादिनम् \t ॥ ७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2137255, "chapter_id": 3974, "verse_number": "८", "content_sanskrit": "स्वप्नान्ते निशि राजेन्द्र दर्शयामास रश्मिवान् ।\nकृपया परयाऽऽविष्टः पुत्रस्नेहाच्च भारत \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2137256, "chapter_id": 3974, "verse_number": "९", "content_sanskrit": "ब्राह्मणो वेदविद् भूत्वा सूर्यो योगर्द्धिरूपवान् ।\nहितार्थमब्रवीत् कर्णं सान्त्वपूर्वमिदं वचः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2137257, "chapter_id": 3974, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2137258, "chapter_id": 3974, "verse_number": "१०", "content_sanskrit": "कर्ण मद्वचनं तात शृणु सत्यभृतां वर ।\nब्रुवतोऽद्य महाबाहो सौहृदात् परमं हितम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2137259, "chapter_id": 3974, "verse_number": "११", "content_sanskrit": "उपायास्यति शक्रस्त्वां पाण्डवानां हितेप्सया ।\nब्राह्मणच्छद्मना कर्ण कुण्डलापजिहीर्षया \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2137260, "chapter_id": 3974, "verse_number": "१२", "content_sanskrit": "विदितं तेन शीलं ते सर्वस्य जगतस्तथा।\nयथा त्वं भिक्षितः सद्भिर्ददास्येव न याचसे \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2137261, "chapter_id": 3974, "verse_number": "१३", "content_sanskrit": "त्वं हि तात ददास्येव ब्राह्मणेभ्यः प्रयाचितम् ।\nवित्तं यच्चान्यदप्याहुर्न प्रत्याख्यासि कस्यचित् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2137262, "chapter_id": 3974, "verse_number": "१४", "content_sanskrit": "त्वां तु चैवं विधं ज्ञात्वा स्वयं वै पाकशासनः ।\nआगन्ता कुण्डलार्थाय कवचं चैव भिक्षितुम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2137263, "chapter_id": 3974, "verse_number": "१५", "content_sanskrit": "तस्मै प्रयाचमानाय न देये कुण्डले त्वया ।\nअनुनेयः परं शक्त्या श्रेय एतद्धि ते परम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2137264, "chapter_id": 3974, "verse_number": "१६", "content_sanskrit": "कुण्डलार्थे ब्रुवंस्तात कारणैर्बहुभिस्त्वया ।\nअन्यैर्बहुविधैर्वित्तैः सन्निवार्यः पुनः पुनः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2137265, "chapter_id": 3974, "verse_number": "१७", "content_sanskrit": "रत्नैः स्त्रिभिस्तथा गोभिर्धनैर्बहुविधैरपि ।\nनिदर्शनैश्च बहुभिः कुण्डलेप्सुः पुरन्दरः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2137266, "chapter_id": 3974, "verse_number": "१८", "content_sanskrit": "यदि दास्यसि कर्ण त्वं सहजे कुण्डले शुभे ।\nआयुषः प्रक्षयं गत्वा मृत्योर्वशमुपैष्यसि \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2137267, "chapter_id": 3974, "verse_number": "१९", "content_sanskrit": "कवचेन समायुक्तः कुण्डलाभ्यां च मानद ।\nअवध्यस्त्वं रणेऽरीणामिति विद्धि वचो मम \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2137268, "chapter_id": 3974, "verse_number": "२०", "content_sanskrit": "अमृतादुत्थितं ह्येतदुभयं रत्नसम्भवम् ।\nतस्माद् रक्षं त्वया कर्ण जीवितं चेत् प्रियं तव \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2137269, "chapter_id": 3974, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2137270, "chapter_id": 3974, "verse_number": "२१", "content_sanskrit": "को मामेवं भवान् प्राह दर्शयन् सौहृदं परम् ।\nकामं मे भगवन् ब्रूहि को भवान् द्विजवेषधृक् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2137271, "chapter_id": 3974, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2137272, "chapter_id": 3974, "verse_number": "२२", "content_sanskrit": "अहं तात सहस्रांशुः सौहृदात् त्वां निदर्शये ।\nकुरुष्वैतद् वचो मे त्वमेतच्छ्रेयः परं हि ते \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2137273, "chapter_id": 3974, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2137274, "chapter_id": 3974, "verse_number": "२३", "content_sanskrit": "श्रेय एव ममात्यन्तं यस्य मे गोपतिः प्रभुः ।\nप्रवक्ताद्य हितान्वेषी शृणु चेदं वचो मम \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2137275, "chapter_id": 3974, "verse_number": "२४", "content_sanskrit": "प्रसादये त्वां वरदं प्रणयाच्च ब्रवीम्यहम् ।\nन निवार्यो व्रतादस्मादहं यद्यस्मि ते प्रियः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2137276, "chapter_id": 3974, "verse_number": "२५", "content_sanskrit": "व्रतं वै मम लोकोऽयं वेत्ति कृत्स्नं विभावसो ।\nयथाहं द्विजमुख्येभ्यो दद्यां प्राणानपि ध्रुवम् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2137277, "chapter_id": 3974, "verse_number": "२६", "content_sanskrit": "यद्यागच्छति मां शक्रो ब्राह्मणच्छद्मना वृतः ।\nहितार्थं पाण्डुपुत्राणां खेचरोत्तम भिक्षितुम् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2137278, "chapter_id": 3974, "verse_number": "२७", "content_sanskrit": "दास्यामि विबुधश्रेष्ठ कुण्डले वर्म चोत्तमम् ।\nन मे कीर्तिः प्रणश्येत त्रिषु लोकेषु विश्रुता \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2137279, "chapter_id": 3974, "verse_number": "२८", "content_sanskrit": "मद्विधस्य यशस्यं हि न युक्तं प्राणरक्षणम् ।\nयुक्तं हि यशसा युक्तं मरणं लोकसम्मतम् \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2137280, "chapter_id": 3974, "verse_number": "२९", "content_sanskrit": "सोऽहमिन्द्राय दास्यामि कुण्डले सह वर्मणा ।\nयदि मां बलवृत्रघ्नो भिक्षार्थमुपयास्यति \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2137281, "chapter_id": 3974, "verse_number": "३०", "content_sanskrit": "हितार्थं पाण्डुपुत्राणां कुण्डले मे प्रयाचितम् ।\nतन्मे कीर्तिकरं लोके तस्याकीर्तिर्भविष्यति \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2137282, "chapter_id": 3974, "verse_number": "३१", "content_sanskrit": "वृणोमि कीर्तिं लोके हि जीवितेनापि भानुमन् ।\nकीर्तिमानश्नुते स्वर्गं हीनकीर्तिस्तु नश्यति \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2137283, "chapter_id": 3974, "verse_number": "३२", "content_sanskrit": "कीर्तिर्हि पुरुषं लोके सञ्जीवयति मातृवत् ।\nअकीर्तिर्जीवितं हन्ति जीवतोऽपि शरीरिणः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2137284, "chapter_id": 3974, "verse_number": "३३", "content_sanskrit": "अयं पुराणः श्लोको हि स्वयं गीतो विभावसो ।\nधात्रा लोकेश्वर यथा कीर्तिरायुर्नरस्य ह \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2137285, "chapter_id": 3974, "verse_number": "३४", "content_sanskrit": "पुरुषस्य परे लोके कीर्तिरेव परायणम् ।\nइह लोके विशुद्धा च कीर्तिरायुर्विवर्धनी \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2137286, "chapter_id": 3974, "verse_number": "३५", "content_sanskrit": "सोऽहं शरीरजे दत्त्वा कीर्तिं प्राप्स्यामि शाश्वतीम् ।\nदत्त्वा च विधिवद् दानं ब्राह्मणेभ्यो यथाविधि \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2137287, "chapter_id": 3974, "verse_number": "३६", "content_sanskrit": "हुत्वा शरीरं सङ्ग्रामे कृत्वा कर्म सुदुष्करम् ।\nविजित्य च परानाजौ यशः प्राप्स्यामि केवलम् \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2137288, "chapter_id": 3974, "verse_number": "३७", "content_sanskrit": "भीतानामभयं दत्त्वा सङ्ग्रामे जीवितार्थिनाम् ।\nवृद्धान् बालान् द्विजातींश्च मोक्षयित्वा महाभयात् \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2137289, "chapter_id": 3974, "verse_number": "३८", "content_sanskrit": "प्राप्स्यामि परमं लोके यशः स्वर्ग्यमनुत्तमम् ।\nजीवितेनापि मे रक्ष्या कीर्तिस्तद्विद्धि मे व्रतम् \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2137290, "chapter_id": 3974, "verse_number": "३९", "content_sanskrit": "सोऽहं दत्त्वा मघवते भिक्षामेतामनुत्तमाम् ।\nब्राह्मणच्छद्मिने देव लोके गन्ता परां गतिम् \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2137291, "chapter_id": 3974, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि एकोननवत्यधिकद्विशततमोऽध्यायः ॥२८९॥\nकुण्डलाहरणपर्वणि सूर्यकर्णसंवादे प्रथमाध्यायः ॥१॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]