[{"id": 7001449000, "chapter_id": 21449, "verse_number": "७-१-२२-१", "content_sanskrit": "तस्मिन्नवसरे व्योम्नि समाविरभवद्रथः ।\nसहस्रसूर्यसंकाशश्चारुचीरवृषध्वजः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001449001, "chapter_id": 21449, "verse_number": "७-१-२२-२", "content_sanskrit": "अश्वरत्नद्वयोदारो रथचक्रचतुष्टयः ।\nसञ्चितानेकदिव्यास्त्रशस्त्ररत्नपरिष्कृतः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001449002, "chapter_id": 21449, "verse_number": "७-१-२२-३", "content_sanskrit": "तस्यापि रथवर्यस्य स्यात्स एव हि सारथिः ।\nयथा च त्रैपुरे युद्धे पूर्वं शार्वरथे स्थितः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001449003, "chapter_id": 21449, "verse_number": "७-१-२२-४", "content_sanskrit": "स तं रथवरं ब्रह्मा शासनादेव शूलिनः ।\nहरेस्समीपमानीय कृताञ्जलिरभाषत॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001449004, "chapter_id": 21449, "verse_number": "७-१-२२-५", "content_sanskrit": "भगवन्भद्र भद्रांग भगवानिन्दुभूषणः ।\nआज्ञापयति वीरस्त्वां रथमारोढुमव्ययः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001449005, "chapter_id": 21449, "verse_number": "७-१-२२-६", "content_sanskrit": "रेभ्याश्रमसमीपस्थस्त्र्यंबको ऽंबिकया सह ।\nसम्पश्यते महाबाहो दुस्सहं ते पराक्रमम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001449006, "chapter_id": 21449, "verse_number": "७-१-२२-७", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा स वीरो गणकुञ्जरः ।\nआरुरोह रथं दिव्यमनुगृह्य पितामहम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001449007, "chapter_id": 21449, "verse_number": "७-१-२२-८", "content_sanskrit": "तथा रथवरे तस्मिन्स्थिते ब्रह्मणि सारथौ ।\nभद्रस्य ववृधे लक्ष्मी रुद्रस्येव पुरद्विषः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001449008, "chapter_id": 21449, "verse_number": "७-१-२२-९", "content_sanskrit": "ततः शंखवरं दीप्तं पूर्णचंद्रसमप्रभम् ।\nप्रदध्मौ वदने कृत्वा भानुकंपो महाबलः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001449009, "chapter_id": 21449, "verse_number": "७-१-२२-१०", "content_sanskrit": "तस्य शंखस्य तं नादं भिन्नसारससन्निभम् ।\nश्रुत्वा भयेन देवानां जज्वाल जठरानलः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001449010, "chapter_id": 21449, "verse_number": "७-१-२२-११", "content_sanskrit": "यक्षविद्याधराहीन्द्रैः सिद्धैर्युद्धदिदृक्षुभिः ।\nक्षणेन निबडीभूताः साकाशविवरा दिशाः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001449011, "chapter_id": 21449, "verse_number": "७-१-२२-१२", "content_sanskrit": "ततः शार्ङ्गेण चापाङ्कात्स नारायणनीरदः ।\nमहता बाणवर्षेण तुतोद गणगोवृषम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001449012, "chapter_id": 21449, "verse_number": "७-१-२२-१३", "content_sanskrit": "तं दृष्ट्वा विष्णुमायांतं शतधा बाणवर्षिणम् ।\nस चाददे धनुर्जैत्रं भद्रो बाणसहस्रमुक्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001449013, "chapter_id": 21449, "verse_number": "७-१-२२-१४", "content_sanskrit": "समादाय च तद्दिव्यं धनुस्समरभैरवम् ।\nशनैर्विस्फारयामास मेरुं धनुरिवेश्वरः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001449014, "chapter_id": 21449, "verse_number": "७-१-२२-१५", "content_sanskrit": "तस्य विस्फार्यमाणस्य धनुषो ऽभून्महास्वनः ।\nतेन स्वनेन महता पृथिवीं समकंपयत्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001449015, "chapter_id": 21449, "verse_number": "७-१-२२-१६", "content_sanskrit": "ततः शरवरं घोरं दीप्तमाशीविषोपमम् ।\nजग्राह गणपः श्रीमान्स्वयमुग्रपराक्रमः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001449016, "chapter_id": 21449, "verse_number": "७-१-२२-१७", "content_sanskrit": "बाणोद्धारे भुजो ह्यस्य तूणीवदनसंगतः ।\nप्रत्यदृश्यत वल्मीकं विवेक्षुरिव पन्नगः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001449017, "chapter_id": 21449, "verse_number": "७-१-२२-१८", "content_sanskrit": "समुद्धृतः करे तस्य तत्क्षणं रुरुचे शरेः ।\nमहाभुजंगसंदष्टो यथा बालभुजङ्गमः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001449018, "chapter_id": 21449, "verse_number": "७-१-२२-१९", "content_sanskrit": "शरेण घनतीव्रेण भद्रो रुद्रपराक्रमः ।\nविव्याध कुपितो गाढं ललाटे विष्णुमव्ययम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001449019, "chapter_id": 21449, "verse_number": "७-१-२२-२०", "content_sanskrit": "ललाटे ऽभिहितो विष्णुः पूर्वमेवावमानितः ।\nचुकोप गणपेंद्राय मृगेंद्रायेव गोवृषः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001449020, "chapter_id": 21449, "verse_number": "७-१-२२-२१", "content_sanskrit": "ततस्त्वशनिकल्पेन क्रूरास्येन महेषुणा ।\nविव्याध गणराजस्य भुजे भुजगसन्निभे॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001449021, "chapter_id": 21449, "verse_number": "७-१-२२-२२", "content_sanskrit": "सो ऽपि तस्य भुजे भूयः सूर्यायुतसमप्रभम् ।\nविससर्ज शरं वेगाद्वीरभद्रो महाबलः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001449022, "chapter_id": 21449, "verse_number": "७-१-२२-२३", "content_sanskrit": "स च विष्णुः पुनर्भद्रं भद्रो विष्णुं तथा पुनः ।\nस च तं स च तं विप्राश्शरैस्तावनुजघ्नतुः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001449023, "chapter_id": 21449, "verse_number": "७-१-२२-२४", "content_sanskrit": "तयोः परस्परं वेगाच्छरानाशु विमुंचतोः ।\nद्वयोस्समभवद्युद्धं तुमुलं रोमहर्षणम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001449024, "chapter_id": 21449, "verse_number": "७-१-२२-२५", "content_sanskrit": "तद्दृष्ट्वा तुमुलं युद्धं तयोरेव परस्परम् ।\nहाहाकारो महानासीदाकाशे खेचरेरितः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001449025, "chapter_id": 21449, "verse_number": "७-१-२२-२६", "content_sanskrit": "ततस्त्वनलतुंडेन शरेणादित्यवर्चसा ।\nविव्याध सुदृढं भद्रो विष्णोर्महति वक्षसि॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001449026, "chapter_id": 21449, "verse_number": "७-१-२२-२७", "content_sanskrit": "स तु तीव्रप्रपातेन शरेण दृढमाहतः ।\nमहतीं रुजमासाद्य निपपात विमोहितः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001449027, "chapter_id": 21449, "verse_number": "७-१-२२-२८", "content_sanskrit": "पुनः क्षणादिवोत्थाय लब्धसंज्ञस्तदा हरिः ।\nसर्वाण्यपि च दिव्यास्त्राण्यथैनं प्रत्यवासृजत्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001449028, "chapter_id": 21449, "verse_number": "७-१-२२-२९", "content_sanskrit": "स च विष्णुर्धनुर्मुक्तान्सर्वाञ्छर्वचमूपतिः ।\nसहसा वारयामास घोरैः प्रतिशरैः शरान्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001449029, "chapter_id": 21449, "verse_number": "७-१-२२-३०", "content_sanskrit": "ततो विष्णुस्स्वनामांकं बाणमव्याहतं क्वचित् ।\nससर्ज क्रोधरक्ता क्षस्तमुद्दिश्य गणेश्वरम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001449030, "chapter_id": 21449, "verse_number": "७-१-२२-३१", "content_sanskrit": "तं बाणं बाणवर्येण भद्रो भद्राह्वयेण तु ।\nअप्राप्तमेव भगवाञ्चिच्छेद शतधा पथि॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001449031, "chapter_id": 21449, "verse_number": "७-१-२२-३२", "content_sanskrit": "अथैकेनेषुणा शार्ङ्गं द्वाभ्यां पक्षौ गरुत्मतः ।\nनिमेषादेव चिच्छेद तदद्भुतमिवाभवत्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001449032, "chapter_id": 21449, "verse_number": "७-१-२२-३३", "content_sanskrit": "ततो योगबलाद्विष्णुर्देहाद्देवान्सुदारुणान् ।\nशंखचक्रगदाहस्तान् विससर्ज सहस्रशः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001449033, "chapter_id": 21449, "verse_number": "७-१-२२-३४", "content_sanskrit": "सर्वांस्तान्क्षणमात्रेण त्रैपुरानिव शंकरः ।\nनिर्ददाह महाबाहुर्नेत्रसृष्टेन वह्निना॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001449034, "chapter_id": 21449, "verse_number": "७-१-२२-३५", "content_sanskrit": "ततः क्रुद्धतरो विष्णुश्चक्रमुद्यम्य सत्वरः ।\nतस्मिन्वीरो समुत्स्रष्टुं तदानीमुद्यतो ऽभवत्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001449035, "chapter_id": 21449, "verse_number": "७-१-२२-३६", "content_sanskrit": "तं दृष्ट्वा चक्रमुद्यम्य पुरतः समुपस्थितम् ।\nस्मयन्निव गणेशानो व्यष्टंभयदयत्नतः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001449036, "chapter_id": 21449, "verse_number": "७-१-२२-३७", "content_sanskrit": "स्तंभितांगस्तु तच्चक्रं घोरमप्रतिमं क्वचित् ।\nइच्छन्नपि समुत्स्रष्टुं न विष्णुरभवत्क्षमः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001449037, "chapter_id": 21449, "verse_number": "७-१-२२-३८", "content_sanskrit": "श्वसन्निवैकमुद्धृत्य बाहुं चक्रसमन्वितम् ।\nअतिष्ठदलसो भूत्वा पाषाण इव निश्चलः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001449038, "chapter_id": 21449, "verse_number": "७-१-२२-३९", "content_sanskrit": "विशरीरो यथाजीवो विशृङ्गो वा यथा वृषः ।\nविदंष्ट्रश्च यथा सिंहस्तथा विष्णुरवस्थितः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001449039, "chapter_id": 21449, "verse_number": "७-१-२२-४०", "content_sanskrit": "तं दृष्ट्वा दुर्दशापन्नं विष्णुमिंद्रादयः सुराः ।\nसमुन्नद्धा गणेन्द्रेण मृगेंद्रेणेव गोवृषाः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001449040, "chapter_id": 21449, "verse_number": "७-१-२२-४१", "content_sanskrit": "प्रगृहीतायुधा यौद्धुंक्रुद्धाः समुपतस्थिरे ।\nतान्दृष्ट्वा समरे भद्रःक्षुद्रानिव हरिर्मृगान्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001449041, "chapter_id": 21449, "verse_number": "७-१-२२-४२", "content_sanskrit": "साक्षाद्रुद्रतनुर्वीरो वरवीरगणावृतः ।\nअट्टहासेन घोरेण व्यष्टं भयदनिंदितः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001449042, "chapter_id": 21449, "verse_number": "७-१-२२-४३", "content_sanskrit": "तथा शतमखस्यापि सवज्रो दक्षिणः करः ।\nसिसृक्षोरेव उद्वज्रश्चित्रीकृत इवाभवत्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001449043, "chapter_id": 21449, "verse_number": "७-१-२२-४४", "content_sanskrit": "अन्येषामपि सर्वेषां सरक्ता अपि बाहवः ।\nअलसानामिवारंभास्तादृशाः प्रतियांत्युत॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001449044, "chapter_id": 21449, "verse_number": "७-१-२२-४५", "content_sanskrit": "एवं भगवता तेन व्याहताशेषवैभवात् ।\nअमराः समरे तस्य पुरतः स्थातुमक्षमाः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001449045, "chapter_id": 21449, "verse_number": "७-१-२२-४६", "content_sanskrit": "स्तब्धैरवयवैरेव दुद्रुवुर्भयविह्वलाः ।\nस्थितिं च चक्रिरे युद्धे वीरतेजोभयाकुलाः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001449046, "chapter_id": 21449, "verse_number": "७-१-२२-४७", "content_sanskrit": "विद्रुतांस्त्रिदशान्वीरान्वीरभद्रो महाभुजः ।\nविव्याध निशितैर्बाणैर्मघो वर्षैरिवाचलान्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001449047, "chapter_id": 21449, "verse_number": "७-१-२२-४८", "content_sanskrit": "बहवस्तस्य वीरस्य बाहवः परिघोपमाः ।\nशस्त्रैश्चकाशिरे दीप्तैः साग्निज्वाला इवोरगाः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001449048, "chapter_id": 21449, "verse_number": "७-१-२२-४९", "content_sanskrit": "अस्त्रशस्त्राण्यनेकानिसवीरो विसृजन्बभौ ।\nविसृजन्सर्वभूतानि यथादौ विश्वसंभवः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001449049, "chapter_id": 21449, "verse_number": "७-१-२२-५०", "content_sanskrit": "यथा रश्मिभिरादित्यः प्रच्छादयति मेदिनीम् ।\nतथा वीरः क्षणादेव शरैः प्राच्छादयद्दिशः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001449050, "chapter_id": 21449, "verse_number": "७-१-२२-५१", "content_sanskrit": "खमंडले गणेन्द्रस्य शराः कनकभूषिताः ।\nउत्पतंतस्तडिद्रूपैरुपमानपदं ययुः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001449051, "chapter_id": 21449, "verse_number": "७-१-२२-५२", "content_sanskrit": "महांतस्ते सुरगणान्मंडूकानिवडुंडुभाः ।\nप्राणैर्वियोजयामासुः पपुश्च रुधिरासवम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001449052, "chapter_id": 21449, "verse_number": "७-१-२२-५३", "content_sanskrit": "निकृत्तबाहवः केचित्केचिल्लूनवराननाः ।\nपार्श्वे विदारिताः केचिन्निपेतुरमरा भुवि॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001449053, "chapter_id": 21449, "verse_number": "७-१-२२-५४", "content_sanskrit": "विशिखोन्मथितैर्गात्रैर्बहुभिश्छिन्नसन्धिभिः ।\nविवृत्तनयनाः केचिन्निपेतुर्भूतले मृताः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001449054, "chapter_id": 21449, "verse_number": "७-१-२२-५५", "content_sanskrit": "गां प्रवेष्टुमिवेच्छंतः खं गंतुमिव लिप्सवः ।\nअलब्धात्मनिरोधानां व्यलीयंतः परस्परम्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001449055, "chapter_id": 21449, "verse_number": "७-१-२२-५६", "content_sanskrit": "भूमौ केचित्प्रविविशुः पर्वतानां गुहाः परे ।\nअपरे जग्मुराकाशं परे च विविशुर्जलम्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001449056, "chapter_id": 21449, "verse_number": "७-१-२२-५७", "content_sanskrit": "तथा संछिन्नसर्वांगैस्स वीरस्त्रिदशैर्बभौ ।\nपरिग्रस्तप्रजावर्गो भगवानिव भैरवः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001449057, "chapter_id": 21449, "verse_number": "७-१-२२-५८", "content_sanskrit": "दग्धत्रिपुरसंव्यूहस्त्रिपुरारिर्यथाभवत् ।\nएवं देवबलं सर्वं दीनं बीभत्सदर्शनम्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001449058, "chapter_id": 21449, "verse_number": "७-१-२२-५९", "content_sanskrit": "गणेश्वरसमुत्पन्नं कृपणं वपुराददे ।\nतदा त्रिदशवीराणामसृक्सलिलवाहिनी॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001449059, "chapter_id": 21449, "verse_number": "७-१-२२-६०", "content_sanskrit": "प्रावर्तत नदी घोरा प्राणिनां भयशंसिनी ।\nरुधिरेण परिक्लिन्ना यज्ञभूमिस्तदा बभौ॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001449060, "chapter_id": 21449, "verse_number": "७-१-२२-६१", "content_sanskrit": "रक्तार्द्रवसना श्यामा हतशुंभेव कैशिकी ।\nतस्मिन्महति संवृत्ते समरे भृशदारुणे॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001449061, "chapter_id": 21449, "verse_number": "७-१-२२-६२", "content_sanskrit": "भयेनेव परित्रस्ता प्रचचाल वसुन्धरा ।\nमहोर्मिकलिलावर्तश्चुक्षुभे च महोदधिः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001449062, "chapter_id": 21449, "verse_number": "७-१-२२-६३", "content_sanskrit": "पेतुश्चोल्का महोत्पाताः शाखाश्च मुमुचुर्द्रुमाः ।\nअप्रसन्ना दिशः सर्वाः पवनश्चाशिवो ववौ॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001449063, "chapter_id": 21449, "verse_number": "७-१-२२-६४", "content_sanskrit": "अहो विधिविपर्यासस्त्वश्वमेधोयमध्वरः ।\nयजमानस्स्वयं दक्षौ ब्रह्मपुत्रप्रजापतिः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001449064, "chapter_id": 21449, "verse_number": "७-१-२२-६५", "content_sanskrit": "धर्मादयस्सदस्याश्च रक्षिता गरुडध्वजः ।\nभागांश्च प्रतिगृह्णंति साक्षादिंद्रादयः सुराः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001449065, "chapter_id": 21449, "verse_number": "७-१-२२-६६", "content_sanskrit": "तथापि यजमानस्य यज्ञस्य च सहर्त्विजः ।\nसद्य एव शिरश्छेदस्साधु संपद्यते फलम्॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001449066, "chapter_id": 21449, "verse_number": "७-१-२२-६७", "content_sanskrit": "तस्मान्नावेदनिर्दिष्टं न चेश्वरबहिष्कृतम् ।\nनासत्परिगृहीतं च कर्म कुर्यात्कदाचन॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001449067, "chapter_id": 21449, "verse_number": "७-१-२२-६८", "content_sanskrit": "कृत्वापि सुमहत्पुण्यमिष्ट्वा यज्ञशतैरपि ।\nन तत्फलमवाप्नोति भक्तिहीनो महेश्वरे॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001449068, "chapter_id": 21449, "verse_number": "७-१-२२-६९", "content_sanskrit": "कृत्वापि सुमहत्पापं भक्त्या यजति यश्शिवम् ।\nमुच्यते पातकैः सर्वैर्नात्र कार्या विचारणा॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001449069, "chapter_id": 21449, "verse_number": "७-१-२२-७०", "content_sanskrit": "बहुनात्र किमुक्तेन वृथा दानं वृथा तपः ।\nवृथा यज्ञो वृथा होमः शिवनिन्दारतस्य तु॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001449070, "chapter_id": 21449, "verse_number": "७-१-२२-७१", "content_sanskrit": "ततः सनारायणकास्सरुद्राः सलोकपालास्समरे सुरौघाः ।\nगणेंद्रचापच्युतबाणविद्धाः प्रदुद्रुवुर्गाढरुजाभिभूताः॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001449071, "chapter_id": 21449, "verse_number": "७-१-२२-७२", "content_sanskrit": "चेलुः क्वचित्केचन शीर्णकेशाः सेदुः क्वचित्केचन दीर्घगात्राः ।\nपेतुः क्वचित्केचन भिन्नवक्त्रा नेशुः क्वचित्केचन देववीराः॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001449072, "chapter_id": 21449, "verse_number": "७-१-२२-७३", "content_sanskrit": "केचिच्च तत्र त्रिदशा विपन्ना विस्रस्तवस्त्राभरणास्त्रशस्त्राः ।\nनिपेतुरुद्भासितदीनमुद्रा मदं च दर्पं च बलं च हित्वा॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001449073, "chapter_id": 21449, "verse_number": "७-१-२२-७४", "content_sanskrit": "सस्मुत्पथप्रस्थितमप्रधृष्यो विक्षिप्य दक्षाध्वरमक्षतास्त्रैः ।\nबभौ गणेशस्स गणेश्वराणां मध्ये स्थितः सिंह इवर्षभाणाम्॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}]