[{"id": 2039143, "chapter_id": 1858, "verse_number": "५-१०३-०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2039144, "chapter_id": 1858, "verse_number": "५-१०३-१", "content_sanskrit": "इयं भोगवती नाम पुरी वासुकिपालिता।\nयादृशी देवराजस्य पुरी वर्याऽमरावती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2039145, "chapter_id": 1858, "verse_number": "५-१०३-२", "content_sanskrit": "एष शेषः स्थितो नागो येनेयं धार्यते सदा।\nतपसा लोकमुख्येन प्रभावसहिता मही ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2039146, "chapter_id": 1858, "verse_number": "५-१०३-३", "content_sanskrit": "श्वेताचलनिभाकारो दिव्याभरणभूषितः ।\nसहस्रं धारयन्मूर्ध्नां ज्वालाजिह्वो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2039147, "chapter_id": 1858, "verse_number": "५-१०३-४", "content_sanskrit": "इह नानाविधाकारा नानाविधविभूषणाः।\nसुरसायाः सुता नागा निवसन्ति गतव्यथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2039148, "chapter_id": 1858, "verse_number": "५-१०३-५", "content_sanskrit": "मणिस्वस्तिकचक्राङ्काः कमण्डलुकलक्षणाः।\nसहस्रसंख्या बलिन सर्वे रौद्राः स्वभावतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2039149, "chapter_id": 1858, "verse_number": "५-१०३-६", "content_sanskrit": "सहस्रशिरसः केचित्केचित्पञ्चशताननाः ।\nशतशीर्षास्तथा केचित्केचित्रिशिरसोऽपि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2039150, "chapter_id": 1858, "verse_number": "५-१०३-७", "content_sanskrit": "द्विपञ्चशिरसः केचित्केचित्सप्तसुखास्तथा।\nमहाभोगा महाकायाः पर्वताभोगभोगिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2039151, "chapter_id": 1858, "verse_number": "५-१०३-८", "content_sanskrit": "बहूनीह सहस्राणि प्रयुतान्यर्बुदानि च।\nनागानामेकवंशानां यथाश्रेष्ठं तु मे श्रुणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2039152, "chapter_id": 1858, "verse_number": "५-१०३-९", "content_sanskrit": "वासुकिस्तक्षकश्चैव कर्कोटकधनञ्जयौ।\nकालीयो नहुषश्चैव कम्बलाश्वतरावुभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2039153, "chapter_id": 1858, "verse_number": "५-१०३-१०", "content_sanskrit": "बाह्यकुण्डो मणिर्नागस्तथैवापूरणः खगः।\nवामनश्चैलपत्रश्च कुकुरः कुकुणस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2039154, "chapter_id": 1858, "verse_number": "५-१०३-११", "content_sanskrit": "आर्यको नन्दकश्चैव तथा कलशपोतकौ ।\nकैलासकः पिञ्जरको नागश्चैरावतस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2039155, "chapter_id": 1858, "verse_number": "५-१०३-१२", "content_sanskrit": "सुमनोमुखो दधिमुखः शङ्खो नन्दोपनन्दकौ ।\nआप्तः कोटरकश्चैव शिखी निष्ठूरिकस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2039156, "chapter_id": 1858, "verse_number": "५-१०३-१३", "content_sanskrit": "तित्तिरिर्हस्तिभद्रश्च कुमुदो माल्यपिण्डकः।\nद्वौ पद्मौ पुण्डरीकश्च पुष्पो मुद्गरपर्णकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2039157, "chapter_id": 1858, "verse_number": "५-१०३-१४", "content_sanskrit": "करवीरः पीठरकः संवृत्तो वृत्त एव च।\nपिण्डारो बिल्वपत्रश्च मूषिकादः शिरीषकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2039158, "chapter_id": 1858, "verse_number": "५-१०३-१५", "content_sanskrit": "दिलीपः शङ्खशीर्षश्च ज्योतिष्कोऽथापराजितः ।\nकौरव्यो धृतराष्ट्रश्च कुहुरः कृशकस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2039159, "chapter_id": 1858, "verse_number": "५-१०३-१६", "content_sanskrit": "विरजा धारणश्चैव सुबाहुर्मुखरो जयः ।\nबधिरान्धौ विशुण्डिश्च विरसः सुरसस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2039160, "chapter_id": 1858, "verse_number": "५-१०३-१७", "content_sanskrit": "एते चान्ये च बहवः कश्यपस्यात्मजाः स्मृताः ।\nमातले पश्य यद्यत्र कश्चित्ते रोचते वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2039161, "chapter_id": 1858, "verse_number": "५-१०३-१८x", "content_sanskrit": "कण्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2039162, "chapter_id": 1858, "verse_number": "५-१०३-१८", "content_sanskrit": "मातलिस्त्वेकमव्यग्रः सततं संनिरीक्ष्य वै।\nपप्रच्छ नारदं तत्र प्रीतिमानिव चाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2039163, "chapter_id": 1858, "verse_number": "५-१०३-१९x", "content_sanskrit": "मातलिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2039164, "chapter_id": 1858, "verse_number": "५-१०३-१९", "content_sanskrit": "स्थितो य एष पुरतः कौरव्यस्यार्यकस्य तु।\nद्युतिमान्दर्शनीयश्च कस्यैष कुलनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2039165, "chapter_id": 1858, "verse_number": "५-१०३-२०", "content_sanskrit": "कः पिता जननी चास्य कतमस्यैष भोगिनः।\nवंशस्य कस्यैष महान्केतुभूत इव स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2039166, "chapter_id": 1858, "verse_number": "५-१०३-२१", "content_sanskrit": "प्रणिधानेन धैर्येण रूपेण वयसा च मे।\nमनः प्रविष्टो देवर्षे गुणकेश्याः पतिर्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2039167, "chapter_id": 1858, "verse_number": "५-१०३-२२x", "content_sanskrit": "कण्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2039168, "chapter_id": 1858, "verse_number": "५-१०३-२२", "content_sanskrit": "मातलिं प्रीतमनसं दृष्ट्वा सुमुखदर्शनात्।\nनिवेदयामास तदा माहात्म्यं जन्म कर्म च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2039169, "chapter_id": 1858, "verse_number": "५-१०३-२३x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2039170, "chapter_id": 1858, "verse_number": "५-१०३-२३", "content_sanskrit": "ऐरावतकुले जातः सुमुखो नाम नागराट्।\nआर्यकस्य मतः पौत्रो दौहित्रो वामनस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2039171, "chapter_id": 1858, "verse_number": "५-१०३-२४", "content_sanskrit": "एतस्य हि पिता नागश्चिकुरो नाम मातले।\nनचिराद्वैतनेयेन पञ्चत्वमुपपादितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2039172, "chapter_id": 1858, "verse_number": "५-१०३-२५", "content_sanskrit": "ततोऽब्रवीत्प्रीतमना मातलिर्नारदं वचः ।\nएष मे रुचितस्तात जामाता भुजगोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2039173, "chapter_id": 1858, "verse_number": "५-१०३-२६", "content_sanskrit": "क्रियतामत्र यत्नो वै प्रीतिमानस्म्यनेन वै।\nअस्मै नागाय वै दातुं प्रियां दुहितरं मुने ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2039174, "chapter_id": 1858, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि त्र्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]