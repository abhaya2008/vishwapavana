[{"id": 2135948, "chapter_id": 3948, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2135949, "chapter_id": 3948, "verse_number": "१", "content_sanskrit": "ततो ब्रह्मर्षयः सर्वे सिद्धा देवर्षयस्तथा ।\nहव्यवाहं पुरस्कृत्य ब्रह्माणं शरणं गताः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2135950, "chapter_id": 3948, "verse_number": "", "content_sanskrit": "देवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2135951, "chapter_id": 3948, "verse_number": "२", "content_sanskrit": "योऽसौ विश्रवसः पुत्रो दशग्रीवो महाबलः ।\nअवध्यो वरदानेन कृतो भगवता पुरा \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2135952, "chapter_id": 3948, "verse_number": "३", "content_sanskrit": "स बाधते प्रजाः सर्वा विप्रकारैर्महाबलः ।\nततो नस्त्रातु भगवन् नान्यस्त्राता हि विद्यते \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2135953, "chapter_id": 3948, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2135954, "chapter_id": 3948, "verse_number": "४", "content_sanskrit": "न स देवासुरैः शक्यो युद्धे जेतुं विभावसो ।\nविहितं तत्र यत् कार्यमभितस्तस्य निग्रहः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2135955, "chapter_id": 3948, "verse_number": "५", "content_sanskrit": "तदर्थमवतीर्णोऽसौ मन्नियोगाच्चतुर्भुजः ।\nविष्णुः प्रहरतां श्रेष्ठः स तत्कर्म करिष्यति \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2135956, "chapter_id": 3948, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2135957, "chapter_id": 3948, "verse_number": "६", "content_sanskrit": "पितामहस्ततस्तेषां संनिधौ शक्रमब्रवीत् ।\nसर्वैर्देवगणैः सार्धं सम्भव त्वं महीतळे \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2135958, "chapter_id": 3948, "verse_number": "७", "content_sanskrit": "विष्णोः सहायानृक्षीषु वानरीषु च सर्वशः ।\nजनयध्वं सुतान् वीरान् कामरूपबलान्वितान् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2135959, "chapter_id": 3948, "verse_number": "८", "content_sanskrit": "ते यथोक्ता भगवता तत्प्रतिश्रुत्य शासनम् ।\nससृजुर्देवगन्धर्वाः पुत्रान् वानररूपिणः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2135960, "chapter_id": 3948, "verse_number": "९", "content_sanskrit": "ततो भागानुभागेन देवगन्धर्वपन्नगाः ।\nअवतर्तुं महीं सर्वे मन्त्रयामासुरञ्जसा \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2135961, "chapter_id": 3948, "verse_number": "१०", "content_sanskrit": "अवतेरुर्महीं स्वर्गादंशैश्च सहिताः सुराः ।\nऋषयश्च महात्मानः सिद्धाश्च सह किन्नरैः ।\nचारणाश्चासृजन्घोरान्वानरान्वनचारिणः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2135962, "chapter_id": 3948, "verse_number": "११", "content_sanskrit": "यस्य देवस्य यद्रूपं वेषस्तेजश्च यद्विधम् ।\nअजायन्त समास्तेन तस्य तस्य सुतास्तदा\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2135963, "chapter_id": 3948, "verse_number": "१२", "content_sanskrit": "तेषां समक्षं गन्धर्वीं दुन्दुभीं नाम नामतः ।\nशशास वरदो देवो गच्छ कार्यार्थसिद्धये \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2135964, "chapter_id": 3948, "verse_number": "१३", "content_sanskrit": "पितामहवचः श्रुत्वा गन्धर्वी दुन्दुभी ततः ।\nमन्थरा मानुषे लोके कुब्जा समभवत् तदा \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2135965, "chapter_id": 3948, "verse_number": "१४", "content_sanskrit": "शक्रप्रभृतयश्चैव सर्वे ते सुरसत्तमाः ।\nवानरर्क्षवरस्त्रीषु जनयामासुरात्मजान् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2135966, "chapter_id": 3948, "verse_number": "१५", "content_sanskrit": "तेऽन्ववर्तन् पितॄन् सर्वे यशसा च बलेन च ।\nभेत्तारो गिरिशृङ्गाणां शालतालशिलायुधाः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2135967, "chapter_id": 3948, "verse_number": "१६", "content_sanskrit": "वज्रसंहननाः सर्वे सर्वे चौघबलास्तथा ।\nकामवीर्यबलाश्चैव सर्वे युद्धविशारदाः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2135968, "chapter_id": 3948, "verse_number": "१७", "content_sanskrit": "नागायुतसमप्राणा वायुवेगसमा जवे ।\nयथे(त्रे)च्छकनिवासाश्च केचिदत्र वनौकसः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2135969, "chapter_id": 3948, "verse_number": "१८", "content_sanskrit": "एवं विधाय तत्सर्वं भगवाँलोकभावनः ।\nमन्थरां बोधयामास यद्यत्कार्यं यथा यथा \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2135970, "chapter_id": 3948, "verse_number": "१९", "content_sanskrit": "सा तद्वचः समाज्ञाय तथा चक्रे मनोजवा ।\nइतश्चेतश्च गच्छन्ती वैरसन्धुक्षणे रता \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2135971, "chapter_id": 3948, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि चतुःषष्ट्यधिकद्विशततमोऽध्यायः ॥२६४॥\nरामोपाख्यानपर्वणि वानराद्युत्पत्तौ चतुर्थोऽध्यायः ॥४॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]