[{"id": 7000348000, "chapter_id": 20348, "verse_number": "२-२०-१", "content_sanskrit": "हरिरुवाच ।\nतपसानेन पुण्येन सत्येनानेन ते द्विज ।\nस्तोत्रेण पावनेनापि तुष्टोस्मि व्रियतां वरः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000348001, "chapter_id": 20348, "verse_number": "२-२०-२", "content_sanskrit": "वरं दद्मि महाभाग यत्ते मनसि वर्तते ।\nयंयमिच्छसि कामं त्वं तंतं ते पूरयाम्यहम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000348002, "chapter_id": 20348, "verse_number": "२-२०-३", "content_sanskrit": "सोमशर्मोवाच ।\nप्रथमं देहि मे कृष्ण वरमेकं सुवाञ्छितम् ।\nसुप्रसन्नेन मनसा यद्यस्ति सुदया मम॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000348003, "chapter_id": 20348, "verse_number": "२-२०-४", "content_sanskrit": "जन्मजन्मांतरं प्राप्य तव भक्तिं करोम्यहम् ।\nदर्शयस्व परं स्थानमचलं मोक्षदायकम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000348004, "chapter_id": 20348, "verse_number": "२-२०-५", "content_sanskrit": "स्ववंशतारकं पुत्रं दिव्यलक्षणसंयुतम् ।\nविष्णुभक्तिपरं नित्यं मम वंशप्रधारकम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000348005, "chapter_id": 20348, "verse_number": "२-२०-६", "content_sanskrit": "सर्वज्ञं सर्वदं दांतं तपस्तेजः समन्वितम् ।\nदेवब्राह्मणलोकानां पालकं पूजकं सदा॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000348006, "chapter_id": 20348, "verse_number": "२-२०-७", "content_sanskrit": "देवमित्रं पुण्यभावं दातारं ज्ञानपंडितम् ।\nदेहि मे ईदृशं पुत्रं दारिद्रं हर केशव॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000348007, "chapter_id": 20348, "verse_number": "२-२०-८", "content_sanskrit": "भवत्वेवं न संदेहो वरमेनं वृणोम्यहम् ।\nहरिरुवाच ।\nएवमस्तु द्विजश्रेष्ठ भविष्यति न संशयः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000348008, "chapter_id": 20348, "verse_number": "२-२०-९", "content_sanskrit": "मत्प्रसादात्सुपुत्रस्तु तव वंश प्रतारकः ।\nभोक्ष्यसि त्वं वरान्भोगान्दिव्यांश्च मानुषानिह॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000348009, "chapter_id": 20348, "verse_number": "२-२०-१०", "content_sanskrit": "समालोक्य परं सौख्यं पुत्रसंभवजं शुभम् ।\nयावज्जीवसि विप्र त्वं तावद्दुःखं न पश्यसि॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000348010, "chapter_id": 20348, "verse_number": "२-२०-११", "content_sanskrit": "दाता भोक्ता गुणग्राही भविष्यसि न संशयः ।\nसुतीर्थे मरणं चापि यास्यसि त्वं परां गतिम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000348011, "chapter_id": 20348, "verse_number": "२-२०-१२", "content_sanskrit": "एवं वरं हरिर्दत्त्वा सप्रियाय द्विजाय सः ।\nअंतर्धानं गतो देवः स्वप्नवत्परिदृश्यते॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000348012, "chapter_id": 20348, "verse_number": "२-२०-१३", "content_sanskrit": "तदा सुमनया युक्तः सोमशर्मा द्विजोत्तमः ।\nसुतीर्थे पावने तस्मिन्रेवातीरे सुपुण्यदे॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000348013, "chapter_id": 20348, "verse_number": "२-२०-१४", "content_sanskrit": "अमरकंटके विप्रो दानं पुण्यं करोति सः ।\nगते बहुतरे काले तस्य वै सोमशर्मणः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000348014, "chapter_id": 20348, "verse_number": "२-२०-१५", "content_sanskrit": "कपिलारेवयोः संगे स्नानं कृत्वा स निर्गतः ।\nदृष्टवान्पुरतो विप्रः श्वेतमेकं हि कुंजरम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000348015, "chapter_id": 20348, "verse_number": "२-२०-१६", "content_sanskrit": "सुप्रभं सुंदरं दिव्यं सुमदं चारुलक्षणम् ।\nनानाभरणशोभांगं बहुलक्ष्म्या समन्वितम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000348016, "chapter_id": 20348, "verse_number": "२-२०-१७", "content_sanskrit": "सिंदूरैः कुंकुमैस्तस्य कुंभस्थले विराजिते ।\nकर्णनीलोत्पलयुतं पताकादंडसंयुतम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000348017, "chapter_id": 20348, "verse_number": "२-२०-१८", "content_sanskrit": "नागोपरिस्थितो दिव्यः पुरुषो दृढसुप्रभः ।\nदिव्यलक्षणसंपन्नः सर्वाभरणभूषितः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000348018, "chapter_id": 20348, "verse_number": "२-२०-१९", "content_sanskrit": "दिव्यमाल्यांबरधरो दिव्यगंधानुलेपनः ।\nसुसौम्यं सोमवत्पूर्णच्छत्रचामरसंयुतम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000348019, "chapter_id": 20348, "verse_number": "२-२०-२०", "content_sanskrit": "नागारूढं प्रयांतं तं पुनः पश्यति सत्तमः ।\nसिद्धचारणगंधर्वैः स्तूयमानं सुमंगलम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000348020, "chapter_id": 20348, "verse_number": "२-२०-२१", "content_sanskrit": "सगजं सुंदरं दृष्ट्वा पुरुषं दिव्यलक्षणम् ।\nव्यतर्कयत्सोमशर्मा विस्मयाविष्टमानसः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000348021, "chapter_id": 20348, "verse_number": "२-२०-२२", "content_sanskrit": "कोऽयं प्रयाति दिव्यांगः पंथानं प्राप्य सुव्रतः ।\nएवं चिंतयतस्तस्य यावद्गृहं समाप्तवान्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000348022, "chapter_id": 20348, "verse_number": "२-२०-२३", "content_sanskrit": "प्रविशंतं गृहद्वारं देवरूपं मनोहरम् ।\nहर्षेण महताविष्टः सोमशर्मा द्विजोत्तमः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000348023, "chapter_id": 20348, "verse_number": "२-२०-२४", "content_sanskrit": "स्वगृहं प्रति धर्मात्मा त्वरमाणः प्रयाति च ।\nगृहद्वारं गतो यावत्तावत्तं तु न पश्यति॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000348024, "chapter_id": 20348, "verse_number": "२-२०-२५", "content_sanskrit": "पतितान्येव पुष्पाणि सौहृद्यानि महामतिः ।\nदिव्यानि वासयुक्तानि प्रांगणे द्विजसत्तमः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000348025, "chapter_id": 20348, "verse_number": "२-२०-२६", "content_sanskrit": "चंदनैः कुंकुमैः पुण्यैः सुगंधैस्तु विलेपितम् ।\nस्वकीयं प्रांगणे दृष्ट्वा दूर्वाक्षतसमन्वितम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000348026, "chapter_id": 20348, "verse_number": "२-२०-२७", "content_sanskrit": "स एवं विस्मयाविष्टश्चिंतयानः पुनः पुनः ।\nददर्श सुमनां प्राज्ञो दिव्यमंगलसंपदम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000348027, "chapter_id": 20348, "verse_number": "२-२०-२८", "content_sanskrit": "सोमशर्मोवाच ।\nकेन दत्तानि दिव्यानि एतान्याभरणानि च ।\nशृंगारंरूपसौभाग्यं वस्त्रालंकारभूषणम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000348028, "chapter_id": 20348, "verse_number": "२-२०-२९", "content_sanskrit": "तन्मे त्वं कारणं भद्रे कथयस्वाविशंकिता ।\nएवं संभाष्यतां भार्यां विरराम द्विजोत्तमः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000348029, "chapter_id": 20348, "verse_number": "२-२०-३०", "content_sanskrit": "सुमनोवाच ।\nशृणु कांत समायातः कश्चिद्देववरोत्तमः ।\nश्वेतनागसमारूढो दिव्याभरणभूषितः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000348030, "chapter_id": 20348, "verse_number": "२-२०-३१", "content_sanskrit": "दिव्यगंधानुलिप्तांगो दिव्याश्चर्यसमन्वितः ।\nन जाने को हि देवोसौ विप्रगंधर्वसेवितः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000348031, "chapter_id": 20348, "verse_number": "२-२०-३२", "content_sanskrit": "स्तूयमानः समायातो देवगंधर्वचारणैः ।\nयोषितः पुण्यरूपाढ्या रूपशृंगारसंयुताः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000348032, "chapter_id": 20348, "verse_number": "२-२०-३३", "content_sanskrit": "सर्वाभरणशोभाढ्याः सर्वाः पूर्णमनोरथाः ।\nताभिः सह समक्षं मे पुरुषेण महात्मना॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000348033, "chapter_id": 20348, "verse_number": "२-२०-३४", "content_sanskrit": "चतुष्कं पूरितं रत्नैः सर्वशोभासमन्वितम् ।\nतत्राहमासने पुण्ये स्थापिता ब्राह्मणैः किल॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000348034, "chapter_id": 20348, "verse_number": "२-२०-३५", "content_sanskrit": "वस्त्रालंकारभूषां मे ददुस्ते सर्व एव हि ।\nवेदमंगलगीतैस्तु शास्त्रगीतैश्च पुण्यदैः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000348035, "chapter_id": 20348, "verse_number": "२-२०-३६", "content_sanskrit": "अभिषिक्तास्मि तैः सर्वैरंतर्धानं पुनर्गताः ।\nमामेवं परितः सर्वे पुनरूचुर्द्विजोत्तम॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000348036, "chapter_id": 20348, "verse_number": "२-२०-३७", "content_sanskrit": "तव गेहं वयं सर्वे वसिष्यामः सदैव हि ।\nशुचिर्भव सुकल्याणि भर्त्रा सार्द्धं सदैव हि॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000348037, "chapter_id": 20348, "verse_number": "२-२०-३८", "content_sanskrit": "एवमुक्त्वा गताः सर्वे एवं दृष्टं मयैव हि ।\nतया यत्कथितं वृत्तं समाकर्ण्य महामतिः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000348038, "chapter_id": 20348, "verse_number": "२-२०-३९", "content_sanskrit": "पुनश्चिंतां प्रपन्नोऽसौ किमिदं देवनिर्मितम् ।\nविचिन्तयित्वाथ तदा सोमशर्मा महामतिः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000348039, "chapter_id": 20348, "verse_number": "२-२०-४०", "content_sanskrit": "ब्रह्मकर्मणि संयुक्तः साधर्म्यं धर्ममुत्तमम् ।\nतस्माद्गर्भं महाभागा दधार व्रतशालिनी॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000348040, "chapter_id": 20348, "verse_number": "२-२०-४१", "content_sanskrit": "तेन गर्भेण सा देवी अधिकं शुशुभे तदा ।\nसंदीप्तपुत्रसंयुक्त तेजोज्वालासमन्विता॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000348041, "chapter_id": 20348, "verse_number": "२-२०-४२", "content_sanskrit": "सा हि जज्ञे च तपसा तनयं देवसन्निभम् ।\nअंतरिक्षे ततो नेदुर्देवदुंदुभयस्तदा॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000348042, "chapter_id": 20348, "verse_number": "२-२०-४३", "content_sanskrit": "शंखान्दध्मुर्महादेवा गंधर्वा ललितं जगुः ।\nअप्सरसस्तथा सर्वा ननृतुस्तास्तदा किल॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000348043, "chapter_id": 20348, "verse_number": "२-२०-४४", "content_sanskrit": "अथ ब्रह्मासुरैः सार्द्धं समायातो द्विजोत्तमः ।\nचकार नाम तस्यैव सुव्रतेति समाहितः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000348044, "chapter_id": 20348, "verse_number": "२-२०-४५", "content_sanskrit": "नाम कृत्वा ततो देवा जग्मुः सर्वे महौजसः ।\nगतेषु तेषु देवेषु सोमशर्मासु तस्य च॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000348045, "chapter_id": 20348, "verse_number": "२-२०-४६", "content_sanskrit": "जातकर्मादिकं कर्म चकार द्विजसत्तमः ।\nजाते पुत्रे महाभागे सुव्रते देवनिर्मिते॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000348046, "chapter_id": 20348, "verse_number": "२-२०-४७", "content_sanskrit": "तस्य गेहे महालक्ष्मीर्धनधान्यसमाकुला ।\nगजाश्वमहिषी गावः कांचनं रत्नमेव च॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000348047, "chapter_id": 20348, "verse_number": "२-२०-४८", "content_sanskrit": "यथा कुबेरभवनं शुशुभे धनसंचयैः ।\nतत्सोमशर्मणो गेहं तथैव परिराजते॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000348048, "chapter_id": 20348, "verse_number": "२-२०-४९", "content_sanskrit": "ध्यानपुण्यादिकं कर्म चका रद्विजसत्तमः ।\nतीर्थयात्रां गतो विप्रो नानापुण्यसमाकुलः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000348049, "chapter_id": 20348, "verse_number": "२-२०-५०", "content_sanskrit": "अन्यानि यानि पुण्यानि दानानि द्विजसत्तमः ।\nचकार तत्र मेधावी ज्ञानपुण्य समन्वितः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000348050, "chapter_id": 20348, "verse_number": "२-२०-५१", "content_sanskrit": "एवं साधयते धर्मं पालयेच्च पुनःपुनः ।\nपुत्रस्य जातकर्मादि कर्माणि द्विजसत्तमः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000348051, "chapter_id": 20348, "verse_number": "२-२०-५२", "content_sanskrit": "विवाहं कारयामास हर्षेण महता किल ।\nपुत्रस्य पुत्राः संजाताः सगुणा लक्षणान्विताः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000348052, "chapter_id": 20348, "verse_number": "२-२०-५३", "content_sanskrit": "सत्यधर्मतपोपेता दानधर्मरताः सदा ।\nस तेषां पुण्यकर्माणि सोमशर्मा चकार ह॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000348053, "chapter_id": 20348, "verse_number": "२-२०-५४", "content_sanskrit": "पौत्राणां तु महाभागस्तेषां सुखेन मोदते ।\nसर्वं सौख्यं च संभुज्य जरारोगविवर्जितः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000348054, "chapter_id": 20348, "verse_number": "२-२०-५५", "content_sanskrit": "पंचविंशाब्दिको यद्वत्तद्वत्कायं तु तस्य हि ।\nसूर्यतेजः प्रतीकाशः सोमशर्मा महामतिः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000348055, "chapter_id": 20348, "verse_number": "२-२०-५६", "content_sanskrit": "सा चापि शुशुभे देवी सुमना पुण्यमंगलैः ।\nपुत्रपौत्रैर्महाभागा दानव्रतैश्च संयमैः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000348056, "chapter_id": 20348, "verse_number": "२-२०-५७", "content_sanskrit": "अतिभाति विशालाक्षी पुण्यैः पतिव्रतादिभिः ।\nतारुण्येन समायुक्ता यथा षोडशवार्षिकी॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000348057, "chapter_id": 20348, "verse_number": "२-२०-५८", "content_sanskrit": "मोदमानौ महात्मानौ दंपती चारुमंगलौ ।\nहर्षेण च समायुक्तौ पुण्यात्मानौ महोदयौ॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000348058, "chapter_id": 20348, "verse_number": "२-२०-५९", "content_sanskrit": "एवं तयोस्तु वृत्तांतं पुण्याचारसमन्वितम् ।\nसुव्रतस्य प्रवक्ष्यामि व्रतचर्यां द्विजोत्तमाः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000348059, "chapter_id": 20348, "verse_number": "२-२०-६०", "content_sanskrit": "यथा तेन समाराध्य नारायणमनामयम्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]