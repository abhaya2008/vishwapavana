[{"id": 6000062000, "chapter_id": 10062, "verse_number": null, "content_sanskrit": "अथ द्वात्रिंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000062001, "chapter_id": 10062, "verse_number": null, "content_sanskrit": "भगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.001.m4a", "display_order": 2}, {"id": 6000062002, "chapter_id": 10062, "verse_number": "३-३२-१", "content_sanskrit": "कर्मणा दैवतन्त्रैण जन्तुर्देहोपपत्तये।\nस्‍त्रियः प्रविष्ट उदरं पुंसो रेतःकणाश्रयः॥ ३/३२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.002.m4a", "display_order": 3, "topics": [{"text": "कपिलेन देवहूतिं प्रति जीवानां गर्भयातनादिकथनम्", "range": "१–२८"}]}, {"id": 6000062003, "chapter_id": 10062, "verse_number": "३-३२-२", "content_sanskrit": "कलिलं त्वेकरात्रेण पञ्चरात्रेण बुद्बुदम्।\nदशाहेन तु कर्कन्धुः पेश्यण्डं वा ततः परम्॥ ३/३२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.003.m4a", "display_order": 4}, {"id": 6000062004, "chapter_id": 10062, "verse_number": "३-३२-३", "content_sanskrit": "मासेन तु शिरो द्वाभ्यां बाह्वङ्घ्र्याद्यङ्गविग्रहः।\nनखलोमास्थिचर्माणि लिङ्गच्छिद्रोद्भवस्‍त्रिभिः॥ ३/३२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.004.m4a", "display_order": 5}, {"id": 6000062005, "chapter_id": 10062, "verse_number": "३-३२-४", "content_sanskrit": "चतुर्भिर्धातवः सप्त पञ्चभिः क्षुत्तृडुद्भवः।\nषड्भिर्जरायुणा वीतः कुक्षौ भ्रमति दक्षिणे॥ ३/३२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.005.m4a", "display_order": 6}, {"id": 6000062006, "chapter_id": 10062, "verse_number": "३-३२-५", "content_sanskrit": "सप्तमे जन्मकर्माणि गतानि स्मरते ऋषिः।\nजगत्यां यानि देवस्य मायया बन्धमात्मनः॥ ३/३२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.006.m4a", "display_order": 7}, {"id": 6000062007, "chapter_id": 10062, "verse_number": "३-३२-६", "content_sanskrit": "मातुर्जग्धान्नपानाद्यैरेधत्यातुरसम्मतः।\nआस्ते विण्मूत्रयोर्गर्ते सजन्तुर्जन्तुसम्भवे॥ ३/३२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.007.m4a", "display_order": 8}, {"id": 6000062008, "chapter_id": 10062, "verse_number": "३-३२-७", "content_sanskrit": "कृमिभिः क्षतकण्ड्वङ्गः सौकुमार्यात् प्रतिक्षणम्।\nमूर्च्छामाप्नोत्युरुक्लेशस्तत्रत्यैः क्षुधितैर्मुहुः॥ ३/३२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.008.m4a", "display_order": 9}, {"id": 6000062009, "chapter_id": 10062, "verse_number": "३-३२-८", "content_sanskrit": "कटुतीक्ष्णोष्णलवणक्षाराम्लादिभिरुल्बणैः।\nमातृभुक्तैरुपस्पृष्टः सर्वाङ्गोत्थितवेदनः॥ ३/३२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.009.m4a", "display_order": 10}, {"id": 6000062010, "chapter_id": 10062, "verse_number": "३-३२-९", "content_sanskrit": "उल्बेन संवृतस्तस्मिन्नान्त्रैश्च बहिरावृतः।\nआस्ते कृत्वा शिरः कुक्षौ भुग्नपृष्ठशिरोधरः॥ ३/३२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.010.m4a", "display_order": 11}, {"id": 6000062011, "chapter_id": 10062, "verse_number": "३-३२-१०", "content_sanskrit": "अकल्पः स्वाङ्गचेष्टायां शकुन्त इव पञ्जरे। तत्र लब्धस्मृतिर्दैवात् कर्म जन्मशतोद्भवम्।\nस्मरन् दीर्घमनुच्छ्वासं शर्म किं नाम विन्दते॥ ३/३२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.011.m4a", "display_order": 12}, {"id": 6000062012, "chapter_id": 10062, "verse_number": "३-३२-११", "content_sanskrit": "आरभ्य सप्तमान्मासाल्लब्धबोधोऽपि वेपितः।\nनैकत्रास्ते सूतिवातैर्विष्ठाभूरिव सोदरः॥ ३/३२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.012.m4a", "display_order": 13}, {"id": 6000062013, "chapter_id": 10062, "verse_number": "३-३२-१२", "content_sanskrit": "नाथमानो ऋषिर्भीतः सप्तवध्रिः कृताञ्जलिः।\nस्तुवीत तं विक्लवया वाचा येनोदरेऽर्पितः॥ ३/३२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.013.m4a", "display_order": 14}, {"id": 6000062014, "chapter_id": 10062, "verse_number": null, "content_sanskrit": "जीव उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.014.m4a", "display_order": 15}, {"id": 6000062015, "chapter_id": 10062, "verse_number": "३-३२-१३", "content_sanskrit": "तस्योपसन्नमवितुर्जगदिच्छयाऽत्तलीलातनोर्भुवि लसच्चरणारविन्दम्।\nसोऽहं व्रजामि शरणं नकुतोभयं मे येनेदृशी गतिरदर्श्यसतोऽनुरूपा॥ ३/३२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.015.m4a", "display_order": 16}, {"id": 6000062016, "chapter_id": 10062, "verse_number": "३-३२-१४", "content_sanskrit": "यस्त्वत्र बद्ध इव कर्मभिरावृतात्मा भूतेन्द्रियाशयमयीमवलम्ब्य मायाम्।\nआस्ते विशुद्धमविकारमखण्डबोधमातप्यमानहृदयेऽवसितं तमेमि॥ ३/३२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.016.m4a", "display_order": 17}, {"id": 6000062017, "chapter_id": 10062, "verse_number": "३-३२-१५", "content_sanskrit": "यः पञ्चभूतरचितेऽवहितः शरीरे छन्नो यथेन्द्रियगुणार्थविदात्मकोऽहम्।\nतेनाविकुण्ठमहिमानमृषिं तमेनं वन्दे परं प्रकृतिपूरुषयोः पुमांसम्॥ ३/३२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.017.m4a", "display_order": 18}, {"id": 6000062018, "chapter_id": 10062, "verse_number": "३-३२-१६", "content_sanskrit": "यन्माययोरुगुणकर्मनिबन्धनेऽस्मिन् सांसारिके पथि चरंस्तदतिश्रमेण।\nनष्टस्मृतिः पुनरयं प्रवृणीत लोको युक्त्या कया महदनुग्रहमन्तरेण॥ ३/३२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.018.m4a", "display_order": 19}, {"id": 6000062019, "chapter_id": 10062, "verse_number": "३-३२-१७", "content_sanskrit": "ज्ञानं यदेतददधात् कतमः स देवस्‍त्रैकालिकं स्थिरचरेष्वनुवर्तितांशः।\nतं जीवकर्मपदवीमनुवर्तमानास्तापत्रयोपशमनाय वयं भजेम॥ ३/३२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.019.m4a", "display_order": 20}, {"id": 6000062020, "chapter_id": 10062, "verse_number": "३-३२-१८", "content_sanskrit": "देह्यन्यदेहविवरे जठराग्निनासृग्विण्मूत्रकूपपतितो भृशतप्तदेहः।\nइच्छन्नितो विवसितुं गणयन् स्वमासान् निर्वास्यते कृपणधीर्भवता कदा नु॥ ३/३२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.020.m4a", "display_order": 21}, {"id": 6000062021, "chapter_id": 10062, "verse_number": "३-३२-१९", "content_sanskrit": "येनेदृशीं मतिमसौ दशमास्य ईशसङ्ग्राहितः पुरुदयेन भवादृशेन।\nस्वेनैव तुष्यतु कृतेन स दीननाथः को नाम तत्प्रति विनाऽञ्जलिमस्य कुर्यात्॥ ३/३२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.021.m4a", "display_order": 22}, {"id": 6000062022, "chapter_id": 10062, "verse_number": "३-३२-२०", "content_sanskrit": "पश्यत्ययं धिषणया ननु सप्तवध्रिः शारीरभेदमशरीरवदस्य देहे।\nयद्दत्तया स तमहं पुरुषं पुराणं पश्ये बहिर्हृदि च चैत्त्यमिव प्रतीतम्॥ ३/३२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.022.m4a", "display_order": 23}, {"id": 6000062023, "chapter_id": 10062, "verse_number": "३-३२-२१", "content_sanskrit": "सोऽहं वसन्नपि विभो बहुदुःखवासं गर्भान्न निर्जिगमिषे बहिरन्धकूपे।\nयत्रोपयातमुपसर्पति देवमायामिथ्यामतिर्यदनु संसृतिचक्रमेतत्॥ ३/३२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.023.m4a", "display_order": 24}, {"id": 6000062024, "chapter_id": 10062, "verse_number": "३-३२-२२", "content_sanskrit": "तस्मादहं विगतविक्लव उद्धरिष्ये आत्मानमाशु तमसः सुहृदात्मनैव।\nभूयो यथा व्यसनमेतदनेकरन्ध्रं मा मे भविष्यदुपसादितविष्णुपादः॥ ३/३२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.024.m4a", "display_order": 25}, {"id": 6000062025, "chapter_id": 10062, "verse_number": null, "content_sanskrit": "भगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.025.m4a", "display_order": 26}, {"id": 6000062026, "chapter_id": 10062, "verse_number": "३-३२-२३", "content_sanskrit": "एवं कृतमतिं गर्भे दशमास्यं सपद्यृषिम्।\nसद्यः क्षिपत्यवाचीनं प्रसूत्यै सूतिमारुतः॥ ३/३२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.026.m4a", "display_order": 27}, {"id": 6000062027, "chapter_id": 10062, "verse_number": "३-३२-२४", "content_sanskrit": "तेनोपसृष्टः सहसा कृत्वाऽवाक्शिर आतुरः।\nविनिष्क्रामति कृच्छ्रेण निरुच्छ्वासो गतस्मृतिः॥ ३/३२/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.027.m4a", "display_order": 28}, {"id": 6000062028, "chapter_id": 10062, "verse_number": "३-३२-२५", "content_sanskrit": "पतितो भुव्यसृङ्मूत्रे विष्ठाभूरिव चेष्टते।\nरोरूयति गतज्ञानो विपरीतां गतिं गतः॥ ३/३२/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.028.m4a", "display_order": 29}, {"id": 6000062029, "chapter_id": 10062, "verse_number": "३-३२-२६", "content_sanskrit": "परच्छन्दं नविदुषा पुष्यमाणो जनेन सः।\nअनभिप्रेतमापन्नः प्रत्याख्यातुमनीश्वरः॥ ३/३२/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.029.m4a", "display_order": 30}, {"id": 6000062030, "chapter_id": 10062, "verse_number": "३-३२-२७", "content_sanskrit": "शायितोऽशुचिपर्यङ्के जन्तुः स्वेदजदूषिते।\nनेशः कण्डूयनेऽङ्गानामासनोत्थानचेष्टने॥ ३/३२/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.030.m4a", "display_order": 31}, {"id": 6000062031, "chapter_id": 10062, "verse_number": "३-३२-२८", "content_sanskrit": "तुदन्त्यामत्वचं दंशा मशका मत्कुणादयः।\nरुदन्तं विगतज्ञानं कृमयः कृमिकं यथा॥ ३/३२/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.031.m4a", "display_order": 32}, {"id": 6000062032, "chapter_id": 10062, "verse_number": "३-३२-२९", "content_sanskrit": "स त्वेवं शैशवं भुक्त्वा दुःखं पौगण्डमेव च।\nअलब्धाभीप्सितोऽज्ञानादिद्धमन्युः शुचार्पितः॥ ३/३२/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.032.m4a", "display_order": 33, "topics": [{"text": "तथा स्‍त्रीसङ्गस्यानर्थहेतुत्वकथनम्", "range": "२८–५२"}]}, {"id": 6000062033, "chapter_id": 10062, "verse_number": "३-३२-३०", "content_sanskrit": "सह देहेन मानेन वर्धमानेन मन्युना।\nकरोति विग्रहं कामी कामिष्वन्ताय चात्मनः॥ ३/३२/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.033.m4a", "display_order": 34}, {"id": 6000062034, "chapter_id": 10062, "verse_number": "३-३२-३१", "content_sanskrit": "भूतैः पञ्चभिरारब्धे देहे देह्यबुधोऽसकृत्।\nअहंममेत्यसद्ग्राहां करोति कुमतिर्मतिम्॥ ३/३२/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.034.m4a", "display_order": 35}, {"id": 6000062035, "chapter_id": 10062, "verse_number": "३-३२-३२", "content_sanskrit": "तदर्थं कुरुते कर्म यद्बद्धो याति संसृतिम्।\nतमो विशति यद्बद्धो येनासौ मर्त्यजन्मनि॥ ३/३२/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.035.m4a", "display_order": 36}, {"id": 6000062036, "chapter_id": 10062, "verse_number": "३-३२-३३", "content_sanskrit": "येन यातीदृशं क्लेशमविद्याकर्मबन्धनम्॥ ३/३२/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.036.m4a", "display_order": 37}, {"id": 6000062037, "chapter_id": 10062, "verse_number": "३-३२-३४", "content_sanskrit": "यद्यसद्भिः पथि पुनः शिश्नोदरकृतोद्यमैः।\nआस्थितो रमते जन्तुस्तमो विशति पूर्ववत्॥ ३/३२/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.037.m4a", "display_order": 38}, {"id": 6000062038, "chapter_id": 10062, "verse_number": "३-३२-३५", "content_sanskrit": "सत्यं शौचं दया मौनं बुद्धिः श्रीर्ह्रीर्यशः क्षमा।\nशमो दमो भगश्चेति यत्सङ्गाद् याति संक्षयम्॥ ३/३२/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.038.m4a", "display_order": 39}, {"id": 6000062039, "chapter_id": 10062, "verse_number": "३-३२-३६", "content_sanskrit": "तेष्वशान्तेषु मूढेषु खण्डितात्मावसायिषु।\nसङ्गं न कुर्याच्छोच्येषु योषित्क्रीडामृगेषु च॥ ३/३२/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.039.m4a", "display_order": 40}, {"id": 6000062040, "chapter_id": 10062, "verse_number": "३-३२-३७", "content_sanskrit": "न तथाऽस्य भवेन्मोहो बन्धश्चान्यप्रसङ्गतः।\nयोषित्सङ्गाद् यथा पुंसां यथा तत्सङ्गिसङ्गतः॥ ३/३२/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.040.m4a", "display_order": 41}, {"id": 6000062041, "chapter_id": 10062, "verse_number": "३-३२-३८", "content_sanskrit": "प्रजापतिः स्वां दुहितरं दृष्ट्वा तद्रूपधर्षितः।\nरोहिद्भूतां सोऽन्वधावद् ऋष्यरूपी गतत्रपः॥ ३/३२/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.041.m4a", "display_order": 42}, {"id": 6000062042, "chapter_id": 10062, "verse_number": "३-३२-३९", "content_sanskrit": "तत्सृष्टिसृष्टसृष्टेषु को न्वखण्डितधीः पुमान्।\nऋषिं नारायणमृते योषिन्मय्येह मायया॥ ३/३२/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.042.m4a", "display_order": 43}, {"id": 6000062043, "chapter_id": 10062, "verse_number": "३-३२-४०", "content_sanskrit": "बलं मे पश्य मायायाः स्‍त्रीमय्या जयिनो दिशाम्।\nया करोति निजायत्तान् भ्रूविजृम्भेण केवलम्॥ ३/३२/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.043.m4a", "display_order": 44}, {"id": 6000062044, "chapter_id": 10062, "verse_number": "३-३२-४१", "content_sanskrit": "सङ्गं न कुर्यात् प्रमदासु जातु योगस्य पारं परमारुरुक्षुः।\nमत्सेवया प्रतिलब्धात्मलाभो वदन्ति यां निरयद्वारमस्य॥ ३/३२/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.044.m4a", "display_order": 45}, {"id": 6000062045, "chapter_id": 10062, "verse_number": "३-३२-४२", "content_sanskrit": "योपयाति शनैर्माया योषिद् देवविनिर्मिता।\nतामीक्षेतात्मनो मृत्युं तृणैः कूपमिवावृतम्॥ ३/३२/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.045.m4a", "display_order": 46}, {"id": 6000062046, "chapter_id": 10062, "verse_number": "३-३२-४३", "content_sanskrit": "यां मन्यते पतिर्मोहान्मन्मायामृषभायतीम्।\nस्‍त्रीत्वं स्‍त्रीसङ्गतः प्राप्तां वित्तापत्यगृहप्रदाम्॥ ३/३२/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.046.m4a", "display_order": 47}, {"id": 6000062047, "chapter_id": 10062, "verse_number": "३-३२-४४", "content_sanskrit": "तमात्मनो विजानीयाद् भृत्यापत्यगृहात्मकम्।\nदैवोपसादितं मृत्युं मृगयोर्गायनं यथा॥ ३/३२/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.047.m4a", "display_order": 48}, {"id": 6000062048, "chapter_id": 10062, "verse_number": "३-३२-४५", "content_sanskrit": "देहेन जीवभूतेन लोकाल्लोकमनुव्रजन्।\nभुञ्जान एव कर्माणि करोत्यविरतं पुमान्॥ ३/३२/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.048.m4a", "display_order": 49}, {"id": 6000062049, "chapter_id": 10062, "verse_number": "३-३२-४६", "content_sanskrit": "जीवो यस्यानुगो देहो भूतेन्द्रियमनोमयः।\nतन्निरोधोऽस्य मरणमाविर्भावस्तु सम्भवः॥ ३/३२/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.049.m4a", "display_order": 50}, {"id": 6000062050, "chapter_id": 10062, "verse_number": "३-३२-४७", "content_sanskrit": "द्रव्योपलब्धिस्थानस्य द्रव्येक्षाऽयोग्यता यदा।\nतत् पञ्चत्वमहंमानादुत्पत्तिर्द्रव्यदर्शनम्॥ ३/३२/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.050.m4a", "display_order": 51}, {"id": 6000062051, "chapter_id": 10062, "verse_number": "३-३२-४८", "content_sanskrit": "यथाऽक्ष्णोर्द्रव्यावयवदर्शनायोग्यता यदा।\nतदैव चक्षुषो द्रष्टुर्द्रष्टृत्वं योग्यताऽनयोः॥ ३/३२/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.051.m4a", "display_order": 52}, {"id": 6000062052, "chapter_id": 10062, "verse_number": "३-३२-४९", "content_sanskrit": "पुंसो यथैवेन्द्रियाणि विन्दन्ति स्वगतं परम्।\nसुखं दुःखं नान्यगतं तथेशांशाः पृथक्‍कलाः॥ ३/३२/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.052.m4a", "display_order": 53}, {"id": 6000062053, "chapter_id": 10062, "verse_number": "३-३२-५०", "content_sanskrit": "आत्मनः केवलं ज्ञानमर्थो देहाद्यसङ्गिनः।\nसुखदुःखादयो भावा न देहस्य न चात्मनः॥ ३/३२/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.053.m4a", "display_order": 54}, {"id": 6000062054, "chapter_id": 10062, "verse_number": "३-३२-५१", "content_sanskrit": "तस्मान्न कार्यः सन्त्रासो न कार्पण्यं न सम्भ्रमः।\nबुद्‌ध्वा जीवगतिं धीरो मुक्तसङ्गश्चरेदिह॥ ३/३२/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.054.m4a", "display_order": 55}, {"id": 6000062055, "chapter_id": 10062, "verse_number": "३-३२-५२", "content_sanskrit": "सम्यग्दर्शनया बुद्ध्या योगवैराग्ययुक्तया।\nमायाविरचिते लोके चरेद् यस्य कलेवरम्॥ ३/३२/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_032/BhP_03.032.055.m4a", "display_order": 56}, {"id": 6000062056, "chapter_id": 10062, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां तृतीयस्कन्धे द्वात्रिंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]