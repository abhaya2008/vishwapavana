[{"id": 5000359000, "chapter_id": 9359, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे विंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000359001, "chapter_id": 9359, "verse_number": "५-२०-१", "content_sanskrit": "स तां परिवृतां दीनां निरानन्दां तपस्विनीम्।\nसाकारैर्मधुरैर्वाक्यैर्न्यदर्शयत रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000359002, "chapter_id": 9359, "verse_number": "५-२०-२", "content_sanskrit": "मां दृष्ट्वा नागनासोरु गूहमाना स्तनोदरम्।\nअदर्शनमिवात्मानं भयान्नेतुं त्वमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000359003, "chapter_id": 9359, "verse_number": "५-२०-३", "content_sanskrit": "कामये त्वां विशालाक्षि बहु मन्यस्व मां प्रिये।\nसर्वांगगुणसम्पन्ने सर्वलोकमनोहरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000359004, "chapter_id": 9359, "verse_number": "५-२०-४", "content_sanskrit": "नेह किञ्चिन्मनुष्या वा राक्षसाः कामरूपिणः।\nव्यपसर्पतु ते सीते भयं मत्तः समुत्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000359005, "chapter_id": 9359, "verse_number": "५-२०-५", "content_sanskrit": "स्वधर्मो रक्षसां भीरु सर्वदैव न संशयः।\nगमनं वा परस्त्रीणां हरणं सम्प्रमथ्य वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000359006, "chapter_id": 9359, "verse_number": "५-२०-६", "content_sanskrit": "एवं चैवमकामां त्वां न च स्प्रक्ष्यामि मैथिलि।\nकामं कामः शरीरे मे यथाकामं प्रवर्तताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000359007, "chapter_id": 9359, "verse_number": "५-२०-७", "content_sanskrit": "देवि नेह भयं कार्यं मयि विश्वसिहि प्रिये।\nप्रणयस्व च तत्त्वेन मैवं भूः शोकलालसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000359008, "chapter_id": 9359, "verse_number": "५-२०-८", "content_sanskrit": "एकवेणी अधःशय्या ध्यानं मलिनमम्बरम्।\nअस्थानेऽप्युपवासश्च नैतान्यौपयिकानि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000359009, "chapter_id": 9359, "verse_number": "५-२०-९", "content_sanskrit": "विचित्राणि च माल्यानि चन्दनान्यगुरूणि च।\nविविधानि च वासांसि दिव्यान्याभरणानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000359010, "chapter_id": 9359, "verse_number": "५-२०-१०", "content_sanskrit": "महार्हाणि च पानानि शयनान्यासनानि च।\nगीतं नृत्यं च वाद्यं च लभ मां प्राप्य मैथिलि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000359011, "chapter_id": 9359, "verse_number": "५-२०-११", "content_sanskrit": "स्त्रीरत्नमसि मैवं भूः कुरु गात्रेषु भूषणम्।\nमां प्राप्य हि कथं वा स्यास्त्वमनर्हा सुविग्रहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000359012, "chapter_id": 9359, "verse_number": "५-२०-१२", "content_sanskrit": "इदं ते चारु संजातं यौवनं ह्यतिवर्तते।\nयदतीतं पुनर्नैति स्रोतः स्रोतस्विनामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000359013, "chapter_id": 9359, "verse_number": "५-२०-१३", "content_sanskrit": "त्वां कृत्वोपरतो मन्ये रूपकर्ता स विश्वकृत्।\nनहि रूपोपमा ह्यन्या तवास्ति शुभदर्शने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000359014, "chapter_id": 9359, "verse_number": "५-२०-१४", "content_sanskrit": "त्वां समासाद्य वैदेहि रूपयौवनशालिनीम्।\nकः पुनर्नातिवर्तेत साक्षादपि पितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000359015, "chapter_id": 9359, "verse_number": "५-२०-१५", "content_sanskrit": "यद् यत् पश्यामि ते गात्रं शीतांशुसदृशानने।\nतस्मिंस्तस्मिन् पृथुश्रोणि चक्षुर्मम निबध्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000359016, "chapter_id": 9359, "verse_number": "५-२०-१६", "content_sanskrit": "भव मैथिलि भार्या मे मोहमेतं विसर्जय।\nबह्वीनामुत्तमस्त्रीणां ममाग्रमहिषी भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000359017, "chapter_id": 9359, "verse_number": "५-२०-१७", "content_sanskrit": "लोकेभ्यो यानि रत्नानि सम्प्रमथ्याहृतानि मे।\nतानि ते भीरु सर्वाणि राज्यं चैव ददामि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000359018, "chapter_id": 9359, "verse_number": "५-२०-१८", "content_sanskrit": "विजित्य पृथिवीं सर्वां नानानगरमालिनीम्।\nजनकाय प्रदास्यामि तव हेतोर्विलासिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000359019, "chapter_id": 9359, "verse_number": "५-२०-१९", "content_sanskrit": "नेह पश्यामि लोकेऽन्यं यो मे प्रतिबलो भवेत्।\nपश्य मे सुमहद्वीर्यमप्रतिद्वन्द्वमाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000359020, "chapter_id": 9359, "verse_number": "५-२०-२०", "content_sanskrit": "असकृत् संयुगे भग्ना मया विमृदितध्वजाः।\nअशक्ताः प्रत्यनीकेषु स्थातुं मम सुरासुराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000359021, "chapter_id": 9359, "verse_number": "५-२०-२१", "content_sanskrit": "इच्छ मां क्रियतामद्य प्रतिकर्म तवोत्तमम्।\nसुप्रभाण्यवसज्जन्तां तवांगे भूषणानि हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000359022, "chapter_id": 9359, "verse_number": "५-२०-२२", "content_sanskrit": "साधु पश्यामि ते रूपं सुयुक्तं प्रतिकर्मणा।\nप्रतिकर्माभिसंयुक्ता दाक्षिण्येन वरानने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000359023, "chapter_id": 9359, "verse_number": "५-२०-२३", "content_sanskrit": "भुङ्क्ष्व भोगान् यथाकामं पिब भीरु रमस्व च।\nयथेष्टं च प्रयच्छ त्वं पृथिवीं वा धनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000359024, "chapter_id": 9359, "verse_number": "५-२०-२४", "content_sanskrit": "ललस्व मयि विस्रब्धा धृष्टमाज्ञापयस्व च।\nमत्प्रासादाल्ललन्त्याश्च ललतां बान्धवस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000359025, "chapter_id": 9359, "verse_number": "५-२०-२५", "content_sanskrit": "ऋद्धिं ममानुपश्य त्वं श्रियं भद्रे यशस्विनि।\nकिं करिष्यसि रामेण सुभगे चीरवासिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000359026, "chapter_id": 9359, "verse_number": "५-२०-२६", "content_sanskrit": "निक्षिप्तविजयो रामो गतश्रीर्वनगोचरः।\nव्रती स्थण्डिलशायी च शंके जीवति वा न वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000359027, "chapter_id": 9359, "verse_number": "५-२०-२७", "content_sanskrit": "नहि वैदेहि रामस्त्वां द्रष्टुं वाप्युपलभ्यते।\nपुरोबलाकैरसितैर्मेघैर्ज्योत्स्नामिवावृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000359028, "chapter_id": 9359, "verse_number": "५-२०-२८", "content_sanskrit": "न चापि मम हस्तात् त्वां प्राप्तुमर्हति राघवः।\nहिरण्यकशिपुः कीर्तिमिन्द्रहस्तगतामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000359029, "chapter_id": 9359, "verse_number": "५-२०-२९", "content_sanskrit": "चारुस्मिते चारुदति चारुनेत्रे विलासिनि।\nमनो हरसि मे भीरु सुपर्णः पन्नगं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000359030, "chapter_id": 9359, "verse_number": "५-२०-३०", "content_sanskrit": "क्लिष्टकौशेयवसनां तन्वीमप्यनलंकृताम्।\nत्वां दृष्ट्वा स्वेषु दारेषु रतिं नोपलभाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000359031, "chapter_id": 9359, "verse_number": "५-२०-३१", "content_sanskrit": "अन्तःपुरनिवासिन्यः स्त्रियः सर्वगुणान्विताः।\nयावत्यो मम सर्वासामैश्वर्यं कुरु जानकि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000359032, "chapter_id": 9359, "verse_number": "५-२०-३२", "content_sanskrit": "मम ह्यसितकेशान्ते त्रैलोक्यप्रवरस्त्रियः।\nतास्त्वां परिचरिष्यन्ति श्रियमप्सरसो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000359033, "chapter_id": 9359, "verse_number": "५-२०-३३", "content_sanskrit": "यानि वैश्रवणे सुभ्रु रत्नानि च धनानि च।\nतानि लोकांश्च सुश्रोणि मया भुङ्क्ष्व यथासुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000359034, "chapter_id": 9359, "verse_number": "५-२०-३४", "content_sanskrit": "न रामस्तपसा देवि न बलेन च विक्रमैः।\nन धनेन मया तुल्यस्तेजसा यशसापि वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000359035, "chapter_id": 9359, "verse_number": "५-२०-३५", "content_sanskrit": "पिब विहर रमस्व भुङ्क्ष्व भोगान्\nधननिचयं प्रदिशामि मेदिनीं च।\nमयि लल ललने यथासुखं त्वं\nत्वयि च समेत्य ललन्तु बान्धवास्ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000359036, "chapter_id": 9359, "verse_number": "५-२०-३६", "content_sanskrit": "कुसुमिततरुजालसंततानि\nभ्रमरयुतानि समुद्रतीरजानि।\nकनकविमलहारभूषितांगी\nविहर मया सह भीरु काननानि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000359037, "chapter_id": 9359, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे विंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]