[{"id": 40021568, "chapter_id": 9359, "verse_number": "1", "content_sanskrit": "तथा स्म तेषां वसतामृक्षवानररक्षसाम् । राघवस्तु महातेजाः सुग्रीवमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40021569, "chapter_id": 9359, "verse_number": "2", "content_sanskrit": "गम्यतां सौम्य किष्किन्धां दुराधर्षां सुरासुरैः । पालयस्व सहामात्यो राज्यं निहतकण्टकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40021570, "chapter_id": 9359, "verse_number": "3", "content_sanskrit": "अङ्गदं च महाबाहो प्रीत्या परमया युतः । पश्य त्वं हनुमन्तं च नलं च सुमहाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40021571, "chapter_id": 9359, "verse_number": "4", "content_sanskrit": "सुषेणं श्वशुरं वीरं तारं च बलिनां वरम् । कुमुदं चैव दुर्धर्षं नीलं चैव महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40021572, "chapter_id": 9359, "verse_number": "5", "content_sanskrit": "वीरं शतवलिं चैव मैन्दं द्विविदमेव च । गजं गवाक्षं गवयं शरभं च महाबलम् । पश्य प्रीतिसमायुक्तो गन्धमादनमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40021573, "chapter_id": 9359, "verse_number": "6", "content_sanskrit": "ऋषभं च सुविक्रान्तं जाम्बवन्तं महाबलम् । ये चेमे सुमहात्मानो मदर्थे त्यक्तजीविताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40021574, "chapter_id": 9359, "verse_number": "7", "content_sanskrit": "पश्य त्वं प्रीतिसंयुक्तो मा चैषां विप्रियं कृथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40021575, "chapter_id": 9359, "verse_number": "8", "content_sanskrit": "एवमुक्त्वा तु सुग्रीवमाश्लिष्य च पुनः पुनः । विभीषणमुवाचाथ रामो मधुरया गिरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40021576, "chapter_id": 9359, "verse_number": "9", "content_sanskrit": "लङ्कां प्रशाधि धर्मेण धर्मज्ञस्त्वं मतो मम । पुरस्य राक्षसानां च स्वभ्रातुस्सम्मतो ह्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40021577, "chapter_id": 9359, "verse_number": "10", "content_sanskrit": "मा च बुद्धिमधर्मे त्वं कुर्या राजन्कथञ्चन । बुद्धिमन्तो हि राजानो ध्रुवमश्नन्ति मेदिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40021578, "chapter_id": 9359, "verse_number": "11", "content_sanskrit": "अहं च नित्यशो राजन्सुग्रीवसहितस्त्वया । स्मर्तव्यः परया प्रीत्या गच्छ त्वं विगतज्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40021579, "chapter_id": 9359, "verse_number": "12", "content_sanskrit": "रामस्य भाषितं श्रुत्वा ऋक्षवानरराक्षसाः । साधुसाध्विति काकुत्स्थं प्रशशंसुः पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40021580, "chapter_id": 9359, "verse_number": "13", "content_sanskrit": "तव बुद्धिर्महाबाहो वीर्यमद्भुतमेव च । माधुर्यं परमं राम स्वयम्भोरिव नित्यदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40021581, "chapter_id": 9359, "verse_number": "14", "content_sanskrit": "तेषामेवं ब्रुवाणानां वानराणां च राक्षसाम् । हनूमान्प्रवणः भूत्वा राघवं वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40021582, "chapter_id": 9359, "verse_number": "15", "content_sanskrit": "स्नेहो मे परमो राजंस्त्वयि तिष्ठतु नित्यदा । भक्तिश्च नियता वीर भावो नान्यत्र गच्छतु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40021583, "chapter_id": 9359, "verse_number": "16", "content_sanskrit": "वायद्रामकथा वीर चरिष्यति महीतले । तावच्छरीरे वत्स्यन्ति प्राणा मम न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40021584, "chapter_id": 9359, "verse_number": "17", "content_sanskrit": "यच्चैतच्चरितं दिव्यं कथा ते रघुनन्दन । तन्मयाप्सरसो नाम श्रावयेयुर्नरर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40021585, "chapter_id": 9359, "verse_number": "18", "content_sanskrit": "तच्छ्रुत्वाहं ततो वीर तव चर्यामृतं प्रभो । उत्कण्ठां तां हरिष्यामि मेघलेखामिवानिलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40021586, "chapter_id": 9359, "verse_number": "19", "content_sanskrit": "एवं ब्रुवाणं रामस्तु हनूमन्तं वरासनात् । उत्थाय सस्वजे स्नेहाद्वाक्यमेतदुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40021587, "chapter_id": 9359, "verse_number": "20", "content_sanskrit": "एवमेतत्कपिश्रेष्ठ भविता नात्र संशयः । चरिष्यति कथा यावदेषा लोके च मामिका । तावत्ते भविता कीर्तिः शरीरे ऽप्यसवस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40021588, "chapter_id": 9359, "verse_number": "21", "content_sanskrit": "लोका हि यावत्स्थास्यन्ति तावत्स्थास्यति मे कथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40021589, "chapter_id": 9359, "verse_number": "22", "content_sanskrit": "लोके च मामिका । एकैकस्योपकारस्य प्राणान्दास्यामि ते कपे । नरः प्रत्युपकाराणामापस्त्वायाति पात्रताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40021590, "chapter_id": 9359, "verse_number": "23", "content_sanskrit": "ततो ऽस्य हारं चन्द्राभं मुच्य कण्ठात्स राघवः । वैडूर्यतरलं कण्ठे बबन्ध च हनूमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40021591, "chapter_id": 9359, "verse_number": "24", "content_sanskrit": "तेनोरसि निबद्धेन हारेण महता कपिः । रराज हेमशैलेन्द्रश्चन्द्रेणाक्रान्तमस्तकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40021592, "chapter_id": 9359, "verse_number": "25", "content_sanskrit": "श्रुत्वा तु राघवस्यैतदुत्थायोत्थाय वानराः । प्रणम्य शिरसा पादौ निर्जग्मुस्ते महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40021593, "chapter_id": 9359, "verse_number": "26", "content_sanskrit": "सुग्रीवः स च रामेण निरन्तरमुरोगतः । विभीषणश्च धर्मात्मा सर्वे ते बाष्पविक्लवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40021594, "chapter_id": 9359, "verse_number": "27", "content_sanskrit": "सर्वे च ते बाष्पकलाः साश्रुनेत्रा विचेतसः । सम्मूढा इव दुःखेन त्यजन्तो राघवं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40021595, "chapter_id": 9359, "verse_number": "28", "content_sanskrit": "कृतप्रसादास्तेनैवं राघवेण महात्मना । जग्मुः स्वं स्वं गृहं सर्वे देही देहमिव त्यजन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40021596, "chapter_id": 9359, "verse_number": "29", "content_sanskrit": "ततस्तु ते राक्षसऋक्षवानराः प्रणम्य रामं रघुवंशवर्धनम् । वियोगजाश्रुप्रतिपूर्णलोचनाः प्रतिप्रयातास्तु यथा निवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]