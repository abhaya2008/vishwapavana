[{"id": 5000441000, "chapter_id": 9441, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे चतुस्त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000441001, "chapter_id": 9441, "verse_number": "६-३४-१", "content_sanskrit": "अथ तां जातसंतापां तेन वाक्येन मोहिताम्।\nसरमा ह्लादयामास महीं दग्धामिवाम्भसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000441002, "chapter_id": 9441, "verse_number": "६-३४-२", "content_sanskrit": "ततस्तस्या हितं सख्याश्चिकीर्षन्ती सखी वचः।\nउवाच काले कालज्ञा स्मितपूर्वाभिभाषिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000441003, "chapter_id": 9441, "verse_number": "६-३४-३", "content_sanskrit": "उत्सहेयमहं गत्वा त्वद्वाक्यमसितेक्षणे।\nनिवेद्य कुशलं रामे प्रतिच्छन्ना निवर्तितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000441004, "chapter_id": 9441, "verse_number": "६-३४-४", "content_sanskrit": "नहि मे क्रममाणाया निरालम्बे विहायसि।\nसमर्थो गतिमन्वेतुं पवनो गरुडोऽपि वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000441005, "chapter_id": 9441, "verse_number": "६-३४-५", "content_sanskrit": "एवं ब्रुवाणां तां सीता सरमामिदमब्रवीत्।\nमधुरं श्लक्ष्णया वाचा पूर्वशोकाभिपन्नया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000441006, "chapter_id": 9441, "verse_number": "६-३४-६", "content_sanskrit": "समर्था गगनं गन्तुमपि च त्वं रसातलम्।\nअवगच्छाद्य कर्तव्यं कर्तव्यं ते मदन्तरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000441007, "chapter_id": 9441, "verse_number": "६-३४-७", "content_sanskrit": "मत्प्रियं यदि कर्तव्यं यदि बुद्धिः स्थिरा तव।\nज्ञातुमिच्छामि तं गत्वा किं करोतीति रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000441008, "chapter_id": 9441, "verse_number": "६-३४-८", "content_sanskrit": "स हि मायाबलः क्रूरो रावणः शत्रुरावणः।\nमां मोहयति दुष्टात्मा पीतमात्रेव वारुणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000441009, "chapter_id": 9441, "verse_number": "६-३४-९", "content_sanskrit": "तर्जापयति मां नित्यं भर्त्सापयति चासकृत्।\nराक्षसीभिः सुघोराभिर्यो मां रक्षति नित्यशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000441010, "chapter_id": 9441, "verse_number": "६-३४-१०", "content_sanskrit": "उद्विग्ना शङ्किता चास्मि न स्वस्थं च मनो मम।\nतद्भयाच्चाहमुद्विग्ना अशोकवनिकां गता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000441011, "chapter_id": 9441, "verse_number": "६-३४-११", "content_sanskrit": "यदि नाम कथा तस्य निश्चितं वापि यद्भवेत्।\nनिवेदयेथाः सर्वं तद् वरो मे स्यादनुग्रहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000441012, "chapter_id": 9441, "verse_number": "६-३४-१२", "content_sanskrit": "साप्येवं ब्रुवतीं सीतां सरमा मृदुभाषिणी।\nउवाच वदनं तस्याः स्पृशन्ती बाष्पविक्लवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000441013, "chapter_id": 9441, "verse_number": "६-३४-१३", "content_sanskrit": "एष ते यद्यभिप्रायस्तस्माद् गच्छामि जानकि।\nगृह्य शत्रोरभिप्रायमुपावर्तामि मैथिलि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000441014, "chapter_id": 9441, "verse_number": "६-३४-१४", "content_sanskrit": "एवमुक्त्वा ततो गत्वा समीपं तस्य रक्षसः।\nशुश्राव कथितं तस्य रावणस्य समन्त्रिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000441015, "chapter_id": 9441, "verse_number": "६-३४-१५", "content_sanskrit": "सा श्रुत्वा निश्चयं तस्य निश्चयज्ञा दुरात्मनः।\nपुनरेवागमत् क्षिप्रमशोकवनिकां शुभाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000441016, "chapter_id": 9441, "verse_number": "६-३४-१६", "content_sanskrit": "सा प्रविष्टा ततस्तत्र ददर्श जनकात्मजाम्।\nप्रतीक्षमाणां स्वामेव भ्रष्टपद्मामिव श्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000441017, "chapter_id": 9441, "verse_number": "६-३४-१७", "content_sanskrit": "तां तु सीता पुनः प्राप्तां सरमां प्रियभाषिणीम्।\nपरिष्वज्य च सुस्निग्धं ददौ च स्वयमासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000441018, "chapter_id": 9441, "verse_number": "६-३४-१८", "content_sanskrit": "इहासीना सुखं सर्वमाख्याहि मम तत्त्वतः।\nक्रूरस्य निश्चयं तस्य रावणस्य दुरात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000441019, "chapter_id": 9441, "verse_number": "६-३४-१९", "content_sanskrit": "एवमुक्ता तु सरमा सीतया वेपमानया।\nकथितं सर्वमाचष्ट रावणस्य समन्त्रिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000441020, "chapter_id": 9441, "verse_number": "६-३४-२०", "content_sanskrit": "जनन्या राक्षसेन्द्रो वै त्वन्मोक्षार्थं बृहद्वचः।\nअतिस्निग्धेन वैदेहि मन्त्रिवृद्धेन चोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000441021, "chapter_id": 9441, "verse_number": "६-३४-२१", "content_sanskrit": "दीयतामभिसत्कृत्य मनुजेन्द्राय मैथिली।\nनिदर्शनं ते पर्याप्तं जनस्थाने यदद्भुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000441022, "chapter_id": 9441, "verse_number": "६-३४-२२", "content_sanskrit": "लङ्घनं च समुद्रस्य दर्शनं च हनूमतः।\nवधं च रक्षसां युद्धे कः कुर्यान्मानुषो युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000441023, "chapter_id": 9441, "verse_number": "६-३४-२३", "content_sanskrit": "एवं स मन्त्रवृद्धैश्च मात्रा च बहुबोधितः।\nन त्वामुत्सहते मोक्तुमर्थमर्थपरो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000441024, "chapter_id": 9441, "verse_number": "६-३४-२४", "content_sanskrit": "नोत्सहत्यमृतो मोक्तुं युद्धे त्वामिति मैथिलि।\nसामात्यस्य नृशंसस्य निश्चयो ह्येष वर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000441025, "chapter_id": 9441, "verse_number": "६-३४-२५", "content_sanskrit": "तदेषा सुस्थिरा बुद्धिर्मृत्युलोभादुपस्थिता।\nभयान्न शक्तस्त्वां मोक्तुमनिरस्तः स संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000441026, "chapter_id": 9441, "verse_number": "६-३४-२६", "content_sanskrit": "राक्षसानां च सर्वेषामात्मनश्च वधेन हि।\nनिहत्य रावणं संख्ये सर्वथा निशितैः शरैः।\nप्रतिनेष्यति रामस्त्वामयोध्यामसितेक्षणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000441027, "chapter_id": 9441, "verse_number": "६-३४-२७", "content_sanskrit": "एतस्मिन्नन्तरे शब्दो भेरीशङ्खसमाकुलः।\nश्रुतो वै सर्वसैन्यानां कम्पयन् धरणीतलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000441028, "chapter_id": 9441, "verse_number": "६-३४-२८", "content_sanskrit": "श्रुत्वा तु तं वानरसैन्यनादं\nलङ्कागता राक्षसराजभृत्याः।\nहतौजसो दैन्यपरीतचेष्टाः\nश्रेयो न पश्यन्ति नृपस्य दोषात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000441029, "chapter_id": 9441, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे चतुस्त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]