[{"id": 2014531, "chapter_id": 1300, "verse_number": "२-४१-१", "content_sanskrit": "वैशम्पायन उवाच।\nततो युधिष्ठिरो राजा शिशुपालमुपाद्रवत्।\nउवाच चैनं मधुरं सान्त्वपूर्वमिदं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2014532, "chapter_id": 1300, "verse_number": "२-४१-२", "content_sanskrit": "नेदं युक्तं महीपाल यादृशं वै त्वमुक्तवान्।\nअधर्मश्च परो राजन्पारुष्यं च निरर्थकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2014533, "chapter_id": 1300, "verse_number": "२-४१-३", "content_sanskrit": "न हि धर्मं परं जातु नावबुध्येत पार्थिवः।\nभीष्मः शान्तनवस्त्वेनं मावमंस्थास्त्वमन्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2014534, "chapter_id": 1300, "verse_number": "२-४१-४", "content_sanskrit": "पश्य चैतान्महीपालांस्त्वत्तो वृद्धतरान्बहून्।\nमृष्यन्ते चार्हणां कृष्णे तद्वत्वं क्षन्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2014535, "chapter_id": 1300, "verse_number": "२-४१-५", "content_sanskrit": "वेद तत्त्वेन कृष्णं हि भीष्णश्चेदिपते भृशम्।\nन ह्येनं त्वं तथा यथैनं वेद कौरवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2014536, "chapter_id": 1300, "verse_number": "२-४१-६x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2014537, "chapter_id": 1300, "verse_number": "२-४१-६", "content_sanskrit": "नास्मै देयो ह्यनुनयो नायमर्हति सान्त्वनम्।\nलोकवृद्धतमे कृष्णे योऽर्हणां नाभिमन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2014538, "chapter_id": 1300, "verse_number": "२-४१-७", "content_sanskrit": "क्षत्रियः क्षत्रियं जित्वा रणे रणकृतां वरः।\nयो मुञ्चति वशे कृत्वा गुरुर्भवति तस्य सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2014539, "chapter_id": 1300, "verse_number": "२-४१-८", "content_sanskrit": "अस्यां हि समितौ राज्ञामेकमप्यजितं युधि।\nन पश्यामि महीपालं सात्वतीपुत्रतेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2014540, "chapter_id": 1300, "verse_number": "२-४१-९", "content_sanskrit": "न हि केवलमस्माकमयमर्च्यतमोऽच्युतः।\nत्रयाणामपि लोकानामर्चनीयो महाभुजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2014541, "chapter_id": 1300, "verse_number": "२-४१-१०", "content_sanskrit": "कृष्णेन हि जिता युद्धे बहवः क्षत्रियर्षभाः।\nजगत्सर्वं च वार्ष्णेये निखिलेन प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2014542, "chapter_id": 1300, "verse_number": "२-४१-११", "content_sanskrit": "तस्मात्सत्स्वपि वृद्धेषु कृष्णमर्चाम नेतरान्।\nएवं वक्तुं न चार्हस्त्वं मा तेऽभूद्बुद्धिरीदृशी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2014543, "chapter_id": 1300, "verse_number": "२-४१-१२", "content_sanskrit": "ज्ञानवृद्धा मया राजन्बहवः पर्युपासिताः।\nयस्य राजन्प्रभावज्ञाः पुरा सर्वे च रक्षिताः।\nतेषां कथयतां शौरेरहं गुणवतो गुणान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2014544, "chapter_id": 1300, "verse_number": "२-४१-१३", "content_sanskrit": "समागतानामश्रौषं बहून्बहुमतान्सताम्।\nकर्माण्यपि च यान्यस्य जन्मप्रभृति धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2014545, "chapter_id": 1300, "verse_number": "२-४१-१४", "content_sanskrit": "बहृशः कथ्यमानानि नरैर्भूयः श्रुतानि मे।\nन केवलं वयं कामाच्चेदिगज जनार्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2014546, "chapter_id": 1300, "verse_number": "२-४१-१५", "content_sanskrit": "न सम्बन्धं पुरस्कृत्य कृतार्थं वा कथञ्चन।\nअर्चामहेऽर्चितं सद्भिर्भुवि भूतसुखावहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2014547, "chapter_id": 1300, "verse_number": "२-४१-१६", "content_sanskrit": "यशः शौर्यं जयं चास्य विज्ञायार्चां प्रयुञ्ज्महे\nन च कश्चिदिहास्माभिः सुवालोप्यपरीक्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2014548, "chapter_id": 1300, "verse_number": "२-४१-१७", "content_sanskrit": "गुणैर्वृद्धानतिक्रम्य हरिरर्च्यतमो मतः।\nज्ञानवृद्धो द्विजातीनां क्षत्रियाणां बलाधिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2014549, "chapter_id": 1300, "verse_number": "२-४१-१८", "content_sanskrit": "वैश्यानां धान्यधनवाञ्शूद्राणामेव जन्मतः।\nपूज्यतायां च गोविन्दे हेतू द्वावपि संस्थितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2014550, "chapter_id": 1300, "verse_number": "२-४१-१९", "content_sanskrit": "वेदवेदाङ्गविज्ञानं बलं चाभ्यधिकं तथा।\nनृणां लोके हि कोऽन्योस्ति विशिष्टः केशवादृते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2014551, "chapter_id": 1300, "verse_number": "२-४१-२०", "content_sanskrit": "दानं दाक्ष्यं श्रुतं शौर्यं ह्रीः कीर्तिर्बुद्धिरुत्तमा।\nसंनतिः श्रीर्धृतिस्तुष्टिः पुष्टिश्च नियताऽच्युते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2014552, "chapter_id": 1300, "verse_number": "२-४१-२१", "content_sanskrit": "तमिमं लोकसम्पन्नमाचार्यं पितरं गुरुम्।\nअर्घ्यमर्चितमर्चामः सर्वे सङ्क्षन्तुमर्हथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2014553, "chapter_id": 1300, "verse_number": "२-४१-२२", "content_sanskrit": "ऋत्विग्गुरुर्विवाह्यश्च स्नातको नृपतिः प्रियः।\nसर्वमेतद्धृषीकेशस्तस्मादभ्यर्चितोऽच्युतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2014554, "chapter_id": 1300, "verse_number": "२-४१-२३", "content_sanskrit": "कृष्ण एव हि लोकानामुत्पत्तिरपि चाप्ययः।\nकृष्णस्य हि कृते विश्वमिदं भूतं चराचरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2014555, "chapter_id": 1300, "verse_number": "२-४१-२४", "content_sanskrit": "एष प्रकृतिरव्यक्ता कर्ता चैव सनातनः।\nपरश्च सर्वभूतेभ्यस्तस्मात्पूज्यतमोऽच्युतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2014556, "chapter_id": 1300, "verse_number": "२-४१-२५", "content_sanskrit": "बुद्धिर्मनो महद्वायुस्तेजोऽभः खं मही च या।\nचतुर्विधं च यद्भूतं सर्वं कृष्णे प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2014557, "chapter_id": 1300, "verse_number": "२-४१-२६", "content_sanskrit": "आदित्यश्चन्द्रमाश्चैव नक्षत्राणि ग्रहाश्च ये।\nदिशश्च विदिशश्चैव सर्वं कृष्णे प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2014558, "chapter_id": 1300, "verse_number": "२-४१-२७", "content_sanskrit": "एष रुद्रश्च सर्वात्मा ब्रह्मा चैव सनातनः।\nअक्षरं क्षररूपेण मानुषत्वमुपागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2014559, "chapter_id": 1300, "verse_number": "२-४१-२८", "content_sanskrit": "अग्निहोत्रमुखा वेदा गायत्री च्छन्दसां मुखम्।\nराजा मुखं मनुष्याणां नदीनां सागरो मुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2014560, "chapter_id": 1300, "verse_number": "२-४१-२९", "content_sanskrit": "नक्षत्राणां मुखं चन्द्र आदित्यस्तेजसां मुखम्।\nपर्वतानां मुखं मेरुर्गरुडः पततां मुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2014561, "chapter_id": 1300, "verse_number": "२-४१-३०", "content_sanskrit": "ऊर्ध्वं तिर्यगधश्चैव यावती जगतो गतिः।\nसदेवकेषु लोकेषु भगवान्केशवो मुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2014562, "chapter_id": 1300, "verse_number": "२-४१-३१", "content_sanskrit": "अयं तु पुरुषो बालः शिशुपालो न बुध्यते।\nसर्वत्र सर्वदा कृष्णं तस्मादेवं प्रभाषते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2014563, "chapter_id": 1300, "verse_number": "२-४१-३२", "content_sanskrit": "यो हि धर्मं विचिनुयादुत्कृष्टं मतिमान्नरः।\nस वै पश्येद्यथा धर्मं न तथा चेदिराडयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2014564, "chapter_id": 1300, "verse_number": "२-४१-३३", "content_sanskrit": "सवृद्धबालेष्वथवा पार्थिवेषु महात्मसु।\nको नार्हं मन्यते कृष्णं को वाप्येनं न पूजयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2014565, "chapter_id": 1300, "verse_number": "२-४१-३४", "content_sanskrit": "अथैनां दुष्कृतां पूजां शिशुपालो व्यवस्यति।\nदुष्कृतायां यथान्यायं तथाऽयं कर्तुमर्हति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2014566, "chapter_id": 1300, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि अर्घाहरणपर्वणि एकचत्वारिंशोऽध्यायः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]