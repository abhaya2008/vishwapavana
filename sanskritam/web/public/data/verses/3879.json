[{"id": 2133518, "chapter_id": 3879, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2133519, "chapter_id": 3879, "verse_number": "१", "content_sanskrit": "एवं सङ्कथिते कृत्स्ने मोक्षधर्मे युधिष्ठिर ।\nदृढप्रीतमना विप्रो धर्मव्याधमुवाच ह \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2133520, "chapter_id": 3879, "verse_number": "२", "content_sanskrit": "न्याययुक्तमिदं सर्वं भवता परिकीर्तितम् ।\nन तेऽस्त्यविदितं किञ्चिद् धर्मेष्विह हि दृश्यते \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2133521, "chapter_id": 3879, "verse_number": "", "content_sanskrit": "व्याधः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2133522, "chapter_id": 3879, "verse_number": "३", "content_sanskrit": "प्रत्यक्षं मम यो धर्मस्तं च पश्य द्विजोत्तम ।\nयेन सिद्धिरियं प्राप्ता मया ब्राह्मणपुङ्गव \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2133523, "chapter_id": 3879, "verse_number": "४", "content_sanskrit": "उत्तिष्ठ भगवन् क्षिप्रं प्रविश्याभ्यन्तरं गृहम् ।\nद्रष्टुमर्हसि धर्मज्ञ मातरं पितरं च मे\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2133524, "chapter_id": 3879, "verse_number": "५", "content_sanskrit": "इत्युक्तः स प्रविश्याथ ददर्श परमार्चितम् ।\nसौधं हृद्यं चतुःशालमतीव च मनोरमम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2133525, "chapter_id": 3879, "verse_number": "६", "content_sanskrit": "देवतागृहसङ्काशं दैवतैश्च सुपूजितम् ।\nशयनासनसम्बाधं गन्धैश्च परमैर्युतम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2133526, "chapter_id": 3879, "verse_number": "७", "content_sanskrit": "तत्र शुक्लाम्बरधरौ पितरावस्य पूजितौ ।\nकृताहारौ तु सन्तुष्टावुपविष्टौ वरासने\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2133527, "chapter_id": 3879, "verse_number": "८", "content_sanskrit": "तस्य व्याधस्य पितरौ ब्राह्मणः सन्ददर्श ह ।\nधर्मव्याधस्तु तौ दृष्ट्वा पादेषु शिरसाऽपतत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2133528, "chapter_id": 3879, "verse_number": "", "content_sanskrit": "वृद्धौ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2133529, "chapter_id": 3879, "verse_number": "९", "content_sanskrit": "उत्तिष्ठोत्तिष्ठ धर्मज्ञ धर्मस्त्वामभिरक्षतु ।\nप्रीतौ स्वस्तव शौचेन दीर्घमायुरवाप्नुहि\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2133530, "chapter_id": 3879, "verse_number": "१०", "content_sanskrit": "सत्पुत्रेण त्वया पुत्र नित्यं काले सुपूजितौ ।\nसुखमावां वसावोऽत्र देवलोकगताविव\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2133531, "chapter_id": 3879, "verse_number": "११", "content_sanskrit": "न तेऽन्यद् दैवतं किञ्चिद् दैवतेष्वपि वर्तते ।\nप्रयतत्वात् द्विजातीनां दमेनासि समन्वितः\t ॥ ११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2133532, "chapter_id": 3879, "verse_number": "१२", "content_sanskrit": "पितुः पितामहा ये च तथैव प्रपितामहाः ।\nप्रीतास्ते सततं पुत्र दमेनावां च पूजया\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2133533, "chapter_id": 3879, "verse_number": "१३", "content_sanskrit": "मनसा कर्मणा वाचा शुश्रूषा नैव हीयते ।\nन चान्या हि तथा बुद्धिर्दृश्यते साम्प्रतं तव \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2133534, "chapter_id": 3879, "verse_number": "१४", "content_sanskrit": "जामदग्न्येन रामेण यथा वृद्धौ सुपूजितौ ।\nतथा त्वया कृतं सर्वं तद्विशिष्टं च पुत्रक\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2133535, "chapter_id": 3879, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2133536, "chapter_id": 3879, "verse_number": "१५", "content_sanskrit": "ततस्तं ब्राह्मणं ताभ्यां धर्मव्याधो न्यवेदयत् ।\nतौ स्वागतेन तं विप्रमर्चयामासतुस्तदा ।\nप्रतिपूज्य च तां पूजां द्विजः पप्रच्छ तावुभौ\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2133537, "chapter_id": 3879, "verse_number": "१६", "content_sanskrit": "सुपुत्राभ्यां सभृत्याभ्यां कच्चिद् वां कुशलं गृहे ।\nअनामयं च वां कच्चित् सदैवेह शरीरयोः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2133538, "chapter_id": 3879, "verse_number": "", "content_sanskrit": "वृद्धौ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2133539, "chapter_id": 3879, "verse_number": "१७", "content_sanskrit": "कुशलं नौ गृहे विप्र भृत्यवर्गे च सर्वशः ।\nकच्चित् त्वमप्यविघ्नेन सम्प्राप्तो भगवन्निति\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2133540, "chapter_id": 3879, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2133541, "chapter_id": 3879, "verse_number": "१८", "content_sanskrit": "बाढमित्येव तौ विप्रः प्रत्युवाच मुदान्वितः ।\nधर्मव्याधो निरीक्ष्याथ ततस्तं वाक्यमब्रवीत्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2133542, "chapter_id": 3879, "verse_number": "१९", "content_sanskrit": "पिता माता च भगवन्नेतौ मद्दैवतं परम् ।\nयद् दैवतेभ्यः कर्तव्यं तदेताभ्यां करोम्यहम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2133543, "chapter_id": 3879, "verse_number": "२०", "content_sanskrit": "त्रयस्त्रिंशद् यथा देवाः सर्वे शक्रपुरोगमाः ।\nसम्पूज्याः सर्वलोकस्य तथा वृद्धाविमौ मम\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2133544, "chapter_id": 3879, "verse_number": "२१", "content_sanskrit": "उपाहारानाहरन्तो देवतानां यथा द्विजाः ।\nकुर्वन्ति तद्वदेताभ्यां करोम्यहमतन्द्रितः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2133545, "chapter_id": 3879, "verse_number": "२२", "content_sanskrit": "एतौ मे परमं ब्रह्मन् पिता माता च दैवतम् ।\nएतौ पुष्पैः फलै रत्नैस्तोषयामि सदा द्विज \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2133546, "chapter_id": 3879, "verse_number": "२३", "content_sanskrit": "एतावेवाग्नयो मह्यं यान् वदन्ति मनीषिणः ।\nयज्ञा वेदाश्च चत्वारः सर्वमेतौ मम द्विज \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2133547, "chapter_id": 3879, "verse_number": "२४", "content_sanskrit": "एतदर्थं मम प्राणा भार्या पुत्रः सुहृज्जनः ।\nसपुत्रदारः शुश्रूषां नित्यमेव करोम्यहम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2133548, "chapter_id": 3879, "verse_number": "२५", "content_sanskrit": "स्वयं च स्नापयाम्येतौ तथा पादौ प्रधावये ।\nआहारं च प्रयच्छामि स्वयं च द्विजसत्तम\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2133549, "chapter_id": 3879, "verse_number": "२६", "content_sanskrit": "अनुकूलं तथा वच्मि विप्रियं परिवर्जये ।\nअधर्मेणापि संयुक्तं प्रियमाभ्यां करोम्यहम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2133550, "chapter_id": 3879, "verse_number": "२७", "content_sanskrit": "धर्ममेव गुरुं ज्ञात्वा करोमि द्विजसत्तम ।\nअतन्द्रितः सदा विप्र शुश्रूषां वै करोम्यहम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2133551, "chapter_id": 3879, "verse_number": "२८", "content_sanskrit": "पञ्चैव गुरवो ब्रह्मन् पुरुषस्य बुभूषतः ।\nपिता माताऽग्निरात्मा च गुरुश्च द्विजसत्तम\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2133552, "chapter_id": 3879, "verse_number": "२९", "content_sanskrit": "एतेषु यस्तु वर्तेत सम्यगेव द्विजोत्तम ।\nभवेयुरग्नयस्तस्य परिचीर्णास्तु नित्यशः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2133553, "chapter_id": 3879, "verse_number": "३०", "content_sanskrit": "गार्हस्थ्ये वर्तमानस्य एष धर्मः सनातनः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2133554, "chapter_id": 3879, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि मार्कण्डेयसमास्यापर्वणि ब्राह्मणमाहात्म्ये द्विशततमोध्यायः ॥२००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2133555, "chapter_id": 3879, "verse_number": "", "content_sanskrit": "॥ मार्कण्डेयसमास्यापर्वणि पञ्चविंशोऽध्यायः ॥२५॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]