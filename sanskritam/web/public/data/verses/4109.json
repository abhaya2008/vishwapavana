[{"id": 2144384, "chapter_id": 4109, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2144385, "chapter_id": 4109, "verse_number": "१", "content_sanskrit": "अनुक्तं यदि ते किञ्चिद् वाचा विदुर विद्यते ।\nतन्मे शुश्रूषवे ब्रूहि विचित्राणि हि भाषसे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2144386, "chapter_id": 4109, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2144387, "chapter_id": 4109, "verse_number": "२", "content_sanskrit": "धृतराष्ट्र कुमारो वै यः पुराणः सनातनः ।\nसनत्सुजातः प्रोवाच मृत्युर्नास्तीति भारत\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2144388, "chapter_id": 4109, "verse_number": "३", "content_sanskrit": "स ते गुह्यान् प्रकाशांश्च सर्वान् हृदयसंश्रयान् ।\nप्रवक्ष्यति महाराज सर्वबुद्धिमतां वरः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2144389, "chapter_id": 4109, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2144390, "chapter_id": 4109, "verse_number": "४", "content_sanskrit": "किं त्वं न वेद तद् भूयो यन्मे ब्रूयात् सनातनः ।\nत्वमेव विदुर ब्रूहि प्रज्ञाशेषोऽस्ति चेत् तव\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2144391, "chapter_id": 4109, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2144392, "chapter_id": 4109, "verse_number": "५", "content_sanskrit": "शूद्रयोनावहं जातो नातोऽन्यद् वक्तुमुत्सहे ।\nकुमारस्य तु या बुद्धिर्वेद तां शाश्वतीमहम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2144393, "chapter_id": 4109, "verse_number": "६", "content_sanskrit": "ब्राह्मीं हि योनिमापन्नः सुगुह्यमपि यो वदेत् ।\nन तेन गर्ह्यो देवानां तस्मादेतद् ब्रवीमि ते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2144394, "chapter_id": 4109, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2144395, "chapter_id": 4109, "verse_number": "७", "content_sanskrit": "ब्रवीहि विदुर त्वं मे पुराणं तं सनातनम् ।\nकथमेतेन देहेन स्यादिहैव समागमः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2144396, "chapter_id": 4109, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2144397, "chapter_id": 4109, "verse_number": "८", "content_sanskrit": "चिन्तयामास विदुरः तमृषिं संशितव्रतम् ।\nस च तच्चिन्तितं ज्ञात्वा दर्शयामास भारत\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2144398, "chapter_id": 4109, "verse_number": "९", "content_sanskrit": "स चैनं प्रतिजग्राह विधिदृष्टेन कर्मणा ।\nसुखोपविष्टं विश्रान्तमथैनं विदुरोऽब्रवीत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2144399, "chapter_id": 4109, "verse_number": "१०", "content_sanskrit": "भगवन् संशयः कश्चिद् धृतराष्ट्रस्य मानसे ।\nयो न शक्यो मया वक्तुं त्वमस्मै वक्तुमर्हसि\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2144400, "chapter_id": 4109, "verse_number": "११", "content_sanskrit": "यं श्रुत्वाऽयं मनुष्येन्द्रः सर्वदुःखातिगो भवेत्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2144401, "chapter_id": 4109, "verse_number": "१२", "content_sanskrit": "लाभालाभौ प्रियद्वेषौ यथैनं न जरान्तकौ ।\nविषहेरन् क्षयामर्षौ क्षुत्पिपासे भयाभये\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2144402, "chapter_id": 4109, "verse_number": "१३", "content_sanskrit": "अरतिश्चैव तन्द्री च कामक्रोधौ क्षयोदयौ\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2144403, "chapter_id": 4109, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि एकचत्वारिंशोऽध्यायः ॥४१॥\nप्रजागरपर्वणि दशमोऽध्यायः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2144404, "chapter_id": 4109, "verse_number": "", "content_sanskrit": "॥ समाप्तं प्रजागरपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2144405, "chapter_id": 4109, "verse_number": "", "content_sanskrit": "* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]