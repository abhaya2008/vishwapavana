[{"id": 2061322, "chapter_id": 2311, "verse_number": "८-३२-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2061323, "chapter_id": 2311, "verse_number": "८-३२-१", "content_sanskrit": "प्रयत्नेन तदा कर्णो हर्षयन्वाहिनीं तव।\nएकैकं समरे दृष्ट्वा पाण्डवं पर्यपृच्छत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2061324, "chapter_id": 2311, "verse_number": "८-३२-२", "content_sanskrit": "यो ममाद्य महात्मानं दर्शयेच्छ्वेतवाहनम्।\nतस्मै दद्यामभिप्रेतं धनं यन्मनसेच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2061325, "chapter_id": 2311, "verse_number": "८-३२-३", "content_sanskrit": "न चेत्तदभिमन्येत तस्मै दद्यामहं पुनः।\nशकटं रत्नसम्पूर्णं यो मे ब्रूयाद्वनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2061326, "chapter_id": 2311, "verse_number": "८-३२-४", "content_sanskrit": "न चेत्तदभिमन्येत पुरुषोऽर्जुनदर्शिवान्।\nशतं दद्यां गवां तस्मै नैत्यकं कांस्यदोहनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2061327, "chapter_id": 2311, "verse_number": "८-३२-५", "content_sanskrit": "शतं ग्रामवरांश्चैव दद्यामर्जुनदर्शिने।\nतथा तस्मै पुनर्दद्यां श्वेतमश्वतरीरथम्।\nयुक्तमञ्जनकेशीभिर्यो मे ब्रूयाद्वनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2061328, "chapter_id": 2311, "verse_number": "८-३२-६", "content_sanskrit": "न चेत्तदभिमन्येत पुरुषोऽर्जुनदर्शिवान्।\nअन्यं वाऽस्मै पुनर्दद्यां सौवर्णं हस्तिषङ्गवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2061329, "chapter_id": 2311, "verse_number": "८-३२-७", "content_sanskrit": "तथाप्यस्मै पुनर्दद्यां स्त्रीणां शतमलङ्कृतम्।\nश्यामानां निष्ककण्ठीनां गीतवाद्यविपश्चिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2061330, "chapter_id": 2311, "verse_number": "८-३२-८", "content_sanskrit": "न चेत्तदभिमन्येत पुरुषोऽर्जुनदर्शिवान्।\nतस्मै दद्यां शतं नागाञ्शतं ग्रामाञ्शतं रथान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2061331, "chapter_id": 2311, "verse_number": "८-३२-९", "content_sanskrit": "सुवर्णस्य च मुख्यस्य हयाग्र्याणां शतं शतान्।\nऋद्व्या गुणैः सुदान्तांश्च धुर्यवाहान्सुशिक्षितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2061332, "chapter_id": 2311, "verse_number": "८-३२-१०", "content_sanskrit": "तथा सुवर्णशृङ्गीणां गोधेनूनां चतुःशतम्।\nदद्यां तस्मै सवत्सानां यो मे ब्रूयाद्वनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2061333, "chapter_id": 2311, "verse_number": "८-३२-११", "content_sanskrit": "न चेत्तदभिमन्येत पुरुषोऽर्जुनदर्शिवान्।\nअन्यदस्मै वरं दद्यां श्वेतान्पञ्चशतान्हयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2061334, "chapter_id": 2311, "verse_number": "८-३२-१२", "content_sanskrit": "हेमभाण्डपरिच्छन्नान्सुमृष्टमणिभूषणान्।\nसुदान्तानपि चैवाहं दद्यामष्टादशापरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2061335, "chapter_id": 2311, "verse_number": "८-३२-१३", "content_sanskrit": "रथं च शुभ्रं सौवर्णं दद्यां तस्मै स्वलङ्कृतम्।\nयुक्तं परमकाम्भोजैर्यो मे ब्रूयाद्वनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2061336, "chapter_id": 2311, "verse_number": "८-३२-१४", "content_sanskrit": "न चेत्तदभिमन्येत पुरुषोऽर्जुनदर्शिवान्।\nअन्यदस्मै वरं दद्यां कुञ्जराणां शतानि षट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2061337, "chapter_id": 2311, "verse_number": "८-३२-१५", "content_sanskrit": "काञ्चनैर्विविधैर्भाण्डैराच्छन्नान्हेममालिनः।\nउत्पन्नानपरान्तेषु विनीतान्हस्तिशिक्षकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2061338, "chapter_id": 2311, "verse_number": "८-३२-१६", "content_sanskrit": "न चेत्तदभिमन्येत पुरुषोऽर्जुनदर्शिवान्।\nअन्यदस्मै वरं दद्यां वैश्यग्रामांश्चतुर्दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2061339, "chapter_id": 2311, "verse_number": "८-३२-१७", "content_sanskrit": "सुस्फीतान्धनसंयुक्तान्प्रत्यासन्नवनोदकान्।\nअकुतोभयान्सुसम्पन्नान्राजभोज्यांश्चतुर्दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2061340, "chapter_id": 2311, "verse_number": "८-३२-१८", "content_sanskrit": "दासीनां निष्ककण्ठीनां मागधीनां शतं तथा।\nप्रत्यग्रवयसां दद्यां यो मे ब्रूयाद्धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2061341, "chapter_id": 2311, "verse_number": "८-३२-१९", "content_sanskrit": "न चेत्तदभिमन्येत पुरुषोऽर्जुनदर्शिवान्।\nअन्यं तस्मै वरं दद्यां यमसौ कामयेत्स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2061342, "chapter_id": 2311, "verse_number": "८-३२-२०", "content_sanskrit": "पुत्रदारान्विहायैव यदन्यद्वित्तमस्ति मे।\nतच्च तस्मै पुनर्दद्यां यद्यच्च मनसेच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2061343, "chapter_id": 2311, "verse_number": "८-३२-२१", "content_sanskrit": "हत्वा च सहितौ कृष्णौ तयोर्वित्तानि सर्वशः।\nतस्मै दद्यामहं यो मे प्रब्रूयात्केशवार्जुनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2061344, "chapter_id": 2311, "verse_number": "८-३२-२२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2061345, "chapter_id": 2311, "verse_number": "८-३२-२२", "content_sanskrit": "एता वाचः सुबहुशः कर्ण उच्चारयन्युधि।\nदध्मौ सागरसम्भूतं सुस्वरं शङ्खमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2061346, "chapter_id": 2311, "verse_number": "८-३२-२३", "content_sanskrit": "ता वाचः सूतपुत्रस्य तथा युक्ता निशम्य तु।\nदुर्योधनो महाराज संहृष्टः सानुजोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2061347, "chapter_id": 2311, "verse_number": "८-३२-२४", "content_sanskrit": "ततो दुन्दुभिनिर्घोषो मृदङ्गानां च सर्वशा।\nसिंहनादः सवादित्रः कुञ्चराणां च निःस्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2061348, "chapter_id": 2311, "verse_number": "८-३२-२५", "content_sanskrit": "प्रादुरासीत्तदा राजंस्त्वत्सैन्ये पुरुषर्षभ।\nयोधानां सम्प्रहृष्टानां तथा समभवत्स्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2061349, "chapter_id": 2311, "verse_number": "८-३२-२६", "content_sanskrit": "तथा प्रहृष्टे सैन्ये तं प्लुवमानं महारथम्।\nविकत्थमानं च तदा राधेयमरिकर्शनम्।\nमद्रराजः प्रहस्येदं वचनं प्रत्यभाषत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2061350, "chapter_id": 2311, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि द्वात्रिंशोऽध्यायः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]