[{"id": 2206975, "chapter_id": 5412, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2206976, "chapter_id": 5412, "verse_number": "१", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nबृहस्पतेश्च संवादं मरुत्तस्य च धीमतः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2206977, "chapter_id": 5412, "verse_number": "२", "content_sanskrit": "देवराजस्य समयं कृतमाङ्गिरसेन ह ।\nश्रुत्वा मरुत्तो नृपतिर्मन्युमाहारयत् तदा\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2206978, "chapter_id": 5412, "verse_number": "३", "content_sanskrit": "सङ्कल्प्य मनसा यज्ञं करन्धमसुतात्मजः ।\nबृहस्पतिमुपागम्य वाग्मी वचनमब्रवीत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2206979, "chapter_id": 5412, "verse_number": "", "content_sanskrit": "मरुत्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2206980, "chapter_id": 5412, "verse_number": "४", "content_sanskrit": "भगवन् यन्मया पूर्वमधिगम्य तपोधन ।\nकृताभिसन्धिर्यज्ञाय भवतो वचनाद् गुरोः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2206981, "chapter_id": 5412, "verse_number": "५", "content_sanskrit": "तदहं यष्टुमिच्छामि सम्भाराः सम्भृताश्च मे ।\nयाज्योऽस्मि भवतः साधो तं प्राप्नुहि विधत्स्व च\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2206982, "chapter_id": 5412, "verse_number": "", "content_sanskrit": "बृहस्पतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2206983, "chapter_id": 5412, "verse_number": "६", "content_sanskrit": "न कामये याजयितुं त्वामहं पृथिवीपते ।\nवृतोऽस्मि देवराजेन प्रतिज्ञातं च तस्य मे\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2206984, "chapter_id": 5412, "verse_number": "", "content_sanskrit": "मरुत्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2206985, "chapter_id": 5412, "verse_number": "७", "content_sanskrit": "पित्र्यमस्मि तव क्षेत्रं बहु मन्ये च ते भृशम् ।\nन चास्म्ययाज्यतां प्राप्तो भजमानं भजस्व माम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2206986, "chapter_id": 5412, "verse_number": "", "content_sanskrit": "बृहस्पतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2206987, "chapter_id": 5412, "verse_number": "८", "content_sanskrit": "अमर्त्यं याजयित्वाऽहं याजयिष्ये न मानुषम् ।\nमरुत्त गच्छ वा मा वा निवृत्तोऽस्म्यद्य याजनात्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2206988, "chapter_id": 5412, "verse_number": "९", "content_sanskrit": "न त्वां याजयितास्म्यद्य वृणु चान्यं यमिच्छसि ।\nउपाध्यायं महाबाहो यस्ते यज्ञं करिष्यति\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2206989, "chapter_id": 5412, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2206990, "chapter_id": 5412, "verse_number": "१०", "content_sanskrit": "एवमुक्तस्तु नृपतिर्मरुत्तो व्रीडितोऽभवत् ।\nप्रत्यागच्छत् सुसंविग्नो ददर्श पथि नारदम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2206991, "chapter_id": 5412, "verse_number": "११", "content_sanskrit": "देवर्षिणा समागम्य नारदेन स पार्थिवः ।\nविधिवत् प्राञ्जलिस्तस्थौ तथैनं नारदोऽब्रवीत्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2206992, "chapter_id": 5412, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2206993, "chapter_id": 5412, "verse_number": "१२", "content_sanskrit": "राजर्षे नातिहृष्टोऽसि कच्चित् क्षेमं तवानघ ।\nक्व गतोऽसि कुतो वेदमप्रीतिस्थानमागतम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2206994, "chapter_id": 5412, "verse_number": "१३", "content_sanskrit": "श्रोतव्यं चेन्मया राजन् ब्रूहि मे पार्थिवर्षभ ।\nव्यपनेष्यामि ते मन्युं सर्वयत्नैर्नराधिप\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2206995, "chapter_id": 5412, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2206996, "chapter_id": 5412, "verse_number": "१४", "content_sanskrit": "एवमुक्तो मरुत्तस्तु नारदेन महर्षिणा ।\nविप्रलम्भमुपाध्यायात् सर्वमेव न्यवेदयत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2206997, "chapter_id": 5412, "verse_number": "", "content_sanskrit": "मरुत्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2206998, "chapter_id": 5412, "verse_number": "१५", "content_sanskrit": "गतोऽस्म्यङ्गिरसः पुत्रं देवाचार्यं बृहस्पतिम् ।\nयज्ञार्थमृत्विजं प्रष्टुं स च मां नाभ्यनन्दत\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2206999, "chapter_id": 5412, "verse_number": "१६", "content_sanskrit": "प्रत्याख्यातश्च तेनाहं जीवितं नाद्य कामये ।\nपरित्यक्तश्च गुरुणा दूषितश्चास्मि नारद\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2207000, "chapter_id": 5412, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2207001, "chapter_id": 5412, "verse_number": "१७", "content_sanskrit": "एवमुक्तस्तु राज्ञा स नारदः प्रत्युवाच ह ।\nआविक्षितं महाराज वाचा सञ्जीवयन्निव\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2207002, "chapter_id": 5412, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2207003, "chapter_id": 5412, "verse_number": "१८", "content_sanskrit": "राजन्नङ्गिरसः पुत्रः संवर्तो नाम धार्मिकः ।\nचङ्क्रमीति दिशः सर्वा दिग्वासा मोहयन् प्रजाः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2207004, "chapter_id": 5412, "verse_number": "१९", "content_sanskrit": "तं गच्छ यदि याज्यं त्वां न वाञ्छति बृहस्पतिः ।\nप्रसन्नस्त्वां महातेजाः संवर्तो याजयिष्यति\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2207005, "chapter_id": 5412, "verse_number": "", "content_sanskrit": "मरुत्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2207006, "chapter_id": 5412, "verse_number": "२०", "content_sanskrit": "सञ्जीवितोऽहं भवता वाक्येनानेन नारद ।\nपश्येयं क्व नु सवंर्तं शंस मे वदतां वर\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2207007, "chapter_id": 5412, "verse_number": "२१", "content_sanskrit": "कथं च तस्मै वर्तेयं कथं मां न परित्यजेत् ।\nप्रत्याख्यातो हि तेनापि नाहं जीवितुमुत्सहे\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2207008, "chapter_id": 5412, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2207009, "chapter_id": 5412, "verse_number": "२२", "content_sanskrit": "उन्मत्तवेषं बिभ्रत् स चङ्क्रमीति यथासुखम् ।\nवाराणसीं तु नगरीमभीक्ष्णमुपसेवते\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2207010, "chapter_id": 5412, "verse_number": "२३", "content_sanskrit": "यत्र साक्षात् महादेवो देहान्ते परमेश्वरः ।\nव्याचष्टे तारकं ज्ञानं जन्तूनामपवर्गदम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2207011, "chapter_id": 5412, "verse_number": "२४", "content_sanskrit": "तस्या द्वारं समासाद्य न्यसेथाः कुणपं क्वचित् ।\nतं दृष्ट्वा यो निवर्तेत स संवर्तो महीपते\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2207012, "chapter_id": 5412, "verse_number": "२५", "content_sanskrit": "तं पृष्ठतोऽनुगच्छेथा यत्र गच्छेत् स वीर्यवान् ।\nतमेकान्ते समासाद्य प्राञ्जलिः शरणं व्रज\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2207013, "chapter_id": 5412, "verse_number": "२६", "content_sanskrit": "पृच्छेत् त्वां यदि केनाहं तवाख्यात इति स्म ह ।\nब्रूयास्त्वं नारदेनेति सञ्ज्ञप्त इति शत्रुहन्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2207014, "chapter_id": 5412, "verse_number": "२७", "content_sanskrit": "स चेत् त्वामनुयुञ्जीत ममानुगमनेप्सया ।\nशंसेथा वह्निमारूढं मामपि त्वमशङ्कया\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2207015, "chapter_id": 5412, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2207016, "chapter_id": 5412, "verse_number": "२८", "content_sanskrit": "स तथेति प्रतिश्रुत्य पूजयित्वा च नारदम् ।\nअभ्यनुज्ञाप्य राजर्षिर्ययौ वाराणसीं पुरीम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2207017, "chapter_id": 5412, "verse_number": "२९", "content_sanskrit": "तत्र गत्वा यथोक्तं स पुर्या द्वारे महायशाः ।\nकुणपं स्थापयामास नारदस्य वचः स्मरन्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2207018, "chapter_id": 5412, "verse_number": "३०", "content_sanskrit": "यौगपद्येन विप्रः स पुरीद्वारं समाविशत् ।\nततः स कुणपं दृष्ट्वा सहसा सन्न्यवर्तत\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2207019, "chapter_id": 5412, "verse_number": "३१", "content_sanskrit": "स तं निवृत्तमालोक्य प्राञ्जलिः पृष्ठतोऽन्वगात् ।\nआविक्षितो महीपालः संवर्तमुपवीक्षितुम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2207020, "chapter_id": 5412, "verse_number": "३२", "content_sanskrit": "स चैनं विजने दृष्ट्वा पांसुभिः कर्दमेन च ।\nश्लेष्मणा चैव राजानं ष्ठीवनैश्च समाकिरत्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2207021, "chapter_id": 5412, "verse_number": "३३", "content_sanskrit": "स तथा पीड्यमानोऽपि संवर्तेन महीपतिः ।\nअन्वगादेव तमृषिं प्राञ्जलिः सम्प्रसादयन्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2207022, "chapter_id": 5412, "verse_number": "३४", "content_sanskrit": "ततो निवृत्य संवर्तः परिश्रान्त उपाविशत् ।\nशीतलच्छायमासाद्य न्यग्रोधं बहुशाखिनम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2207023, "chapter_id": 5412, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्याम् आश्वमेधिकपर्वणि मरुत्तस्य संवर्तदर्शनं नाम षष्ठोऽध्यायः ॥६॥\nअश्वमेधपर्वणि षष्ठोऽध्यायः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]