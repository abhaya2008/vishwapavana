[{"id": 7002431000, "chapter_id": 22431, "verse_number": "१-९३-१", "content_sanskrit": "ब्रह्मोवाच ।\nयेषां धर्मक्रियाः सर्वाः सदैवोद्दिश्य भास्करम् ।\nन कुले जायते तेषां दरिद्रो व्याधितोऽपि वा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002431001, "chapter_id": 22431, "verse_number": "१-९३-२", "content_sanskrit": "देवायतनभूमेस्तु गोमयेनोपलेपनम् ।\nयः करोति नरो भक्त्या सद्यः पापात्प्रमुच्यते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002431002, "chapter_id": 22431, "verse_number": "१-९३-३", "content_sanskrit": "श्वेतया रक्तया वापि पीतमृत्तिकयापि वा ।\nउपलेपनकर्ता वै चिन्तितं लभते फलम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002431003, "chapter_id": 22431, "verse_number": "१-९३-४", "content_sanskrit": "चित्रभानुं विरञ्च्यैव१ कुसुमैर्यः सुगन्धिभिः ।\nपूजयेत्सोपवासस्तु स कामानीप्सितांल्लभेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002431004, "chapter_id": 22431, "verse_number": "१-९३-५", "content_sanskrit": "घृतेन दीपकं ज्वाल्य तिलतैलेन वा रवेः ।\nप्रयाति सूर्यलोकं स दीपकोटिशतैर्वृतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002431005, "chapter_id": 22431, "verse_number": "१-९३-६", "content_sanskrit": "दीपतैलप्रदानेन न याति नरकं नरः ।\nदीपतैलं तिलाश्चैव२ महापातकनाशनाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002431006, "chapter_id": 22431, "verse_number": "१-९३-७", "content_sanskrit": "दीपं ददाति यो नित्यं भास्करायतनेषु३ वै ।\nचतुष्पथेषु तीर्थेषु रूपौजस्वी ह जायते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002431007, "chapter_id": 22431, "verse_number": "१-९३-८", "content_sanskrit": "यस्तु कारयते४ दीपं रवेर्भक्तिसमन्वितः ।\nस कामानीप्सितान्प्राप्य वृन्दारकपुरं व्रजेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002431008, "chapter_id": 22431, "verse_number": "१-९३-९", "content_sanskrit": "यः समालभते सूर्यं चन्दनागुरुकुङ्कुमैः ।\nकर्पूरेण विमिश्रैश्च तथा कस्तूरिकान्वितैः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002431009, "chapter_id": 22431, "verse_number": "१-९३-१०", "content_sanskrit": "शुभं कालं कोटिशतं विहृत्य५ च भवालये ।\nपुनः सञ्जायते भूमौ राजराजो न संशयः ।\nसर्वकामसमृद्धात्मा सर्वलोकनमस्कृतः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002431010, "chapter_id": 22431, "verse_number": "१-९३-११", "content_sanskrit": "चन्दनोदकमिश्रैश्च दत्त्वार्घ्यं कुसुमै रवेः ।\nसपुत्रपौत्रपत्नीकः स्वर्गलोके महीयते६ ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002431011, "chapter_id": 22431, "verse_number": "१-९३-१२", "content_sanskrit": "सुगन्धोदकमिश्रैस्तु दत्त्वार्घ्यं कुसुमै रवेः ।\nदेवलोके चिरं स्थित्वा राजा भवति भूतले ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002431012, "chapter_id": 22431, "verse_number": "१-९३-१३", "content_sanskrit": "स हिरण्येन चार्घेण रक्तोदकयुतेन वा ।\nकोटीशतं तु वर्षाणां स्वर्गलोके महीयते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002431013, "chapter_id": 22431, "verse_number": "१-९३-१४", "content_sanskrit": "पद्मैरभ्यर्चनं कृत्वा रवेः स्वर्गगतो नरः ।\nपद्मे वसति वर्षाणां स्त्रीपद्मशतसंवृतः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002431014, "chapter_id": 22431, "verse_number": "१-९३-१५", "content_sanskrit": "गुग्गुलं सघृतं दत्त्वा रवेर्भक्तिसमन्वितः ।\nतत्क्षणात्सर्वपापेभ्यो मुच्यते नात्र संशयः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002431015, "chapter_id": 22431, "verse_number": "१-९३-१६", "content_sanskrit": "पक्षं तु गुग्गुलं दत्त्वा मुच्यते ब्रह्महत्यया ।\nसंवत्सरेण लभते अश्वमेधफलं शिव ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002431016, "chapter_id": 22431, "verse_number": "१-९३-१७", "content_sanskrit": "धूपेन लभते स्वर्गं तुरुष्केण सुगन्धिना ।\nकर्पूरागुरुधूपेन राजसूयफलं लभेत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002431017, "chapter_id": 22431, "verse_number": "१-९३-१८", "content_sanskrit": "पूर्वाह्णे मानवो भक्त्या श्रद्धया योऽर्चयेद्रविम् ।\nस तत्फलमवाप्नोति यद्दत्ते कपिलाशते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002431018, "chapter_id": 22431, "verse_number": "१-९३-१९", "content_sanskrit": "मध्याह्ने योऽर्चयेत्सूर्यं प्रयतात्मा जितेन्द्रियः ।\nलभते भूमिदानस्य गोशतस्य च तत्फलम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002431019, "chapter_id": 22431, "verse_number": "१-९३-२०", "content_sanskrit": "पश्चिमायां तु सन्ध्यायां योऽर्चयेद्भास्करं नरः ।\nशुचिः शुक्लाम्बरोष्णीषो गोसहस्रफलं लभेत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002431020, "chapter_id": 22431, "verse_number": "१-९३-२१", "content_sanskrit": "अर्धरात्रे तु यो हेलिं भक्त्या सम्पूजयेन्नरः ।\nजातिस्मरत्वमाप्नोति कुले जातो वृषान्वितः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002431021, "chapter_id": 22431, "verse_number": "१-९३-२२", "content_sanskrit": "प्रदोषरात्रिवेलायां यः पूजयति भास्करम् ।\nस गत्वा सहसा वीर क्रीडेत्सौमनसं२ क्षयम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002431022, "chapter_id": 22431, "verse_number": "१-९३-२३", "content_sanskrit": "दण्डनायकवेलायां प्रभातसमये पुनः ।\nपूजयित्वा रविं भक्त्या व्रजेदनिमिषालयम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002431023, "chapter_id": 22431, "verse_number": "१-९३-२४", "content_sanskrit": "एवं वेलासु सर्वासु अवेलासु च मानवः ।\nभक्त्या पूजयते योऽर्कमर्कपुष्पैः समाहितः ।\nतेजसादित्यसंकाशो ह्यर्कलोके महीयते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002431024, "chapter_id": 22431, "verse_number": "१-९३-२५", "content_sanskrit": "अयने तूत्तरे सूर्यमथ वा दक्षिणायने ।\nपूजयेद्यस्तु वै भक्त्या स गच्छेत्कञ्जजालयम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002431025, "chapter_id": 22431, "verse_number": "१-९३-२६", "content_sanskrit": "तत्रस्थः पूज्यते केशैः१ सर्वेः सुमनसस्तथा ।\nगोपतिः पूज्यते यद्वद्गोपतिप्रमुखैः सुरैः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002431026, "chapter_id": 22431, "verse_number": "१-९३-२७", "content_sanskrit": "विषुवेषूपरागेषु षडशीतिमुखेषु च ।\nपूजयित्वा रविं भक्त्या नात्मानं शोचते नरः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002431027, "chapter_id": 22431, "verse_number": "१-९३-२८", "content_sanskrit": "विबुध्य२ वा स्वयं वापि यो नमस्कुरुते रविम् ।\nसन्तुष्टो भास्करस्तस्मै गतिमिष्टां प्रयच्छति ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002431028, "chapter_id": 22431, "verse_number": "१-९३-२९", "content_sanskrit": "कृशरापायसापूपपललोन्मिश्रमोदकैः ।\nबलिं कृत्वा तु सूर्याय सर्वकाममवाप्नुयात् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002431029, "chapter_id": 22431, "verse_number": "१-९३-३०", "content_sanskrit": "मोदकानां प्रदानेन३ पायसस्य च सुव्रत ।\nमधुमांसरसैश्चापि प्रीयतेऽतीवभास्करः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002431030, "chapter_id": 22431, "verse_number": "१-९३-३१", "content_sanskrit": "घृतेन तर्पणं कृत्वा सदा स्निग्धो भवेन्नरः ।\nतर्पयित्वा तु मांसेन सद्यः पापात्प्रमुच्यते ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002431031, "chapter_id": 22431, "verse_number": "१-९३-३२", "content_sanskrit": "घृतेन स्नपनं कृत्वा एकाहमुदये रवेः ।\nगवां शतसहस्रस्य दत्तस्य फलमश्नुते ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002431032, "chapter_id": 22431, "verse_number": "१-९३-३३", "content_sanskrit": "गवां क्षीरेण सन्तर्प्य पुण्डरीकफलं लभेत् ।\nरसेन स्नापयेद्देवमश्वमेधफलं लभेत् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002431033, "chapter_id": 22431, "verse_number": "१-९३-३४", "content_sanskrit": "सूर्याय तरुणीं धेनुं गामेकां यः प्रयच्छति ।\nकञ्जजामचलां प्राप्य पुनर्लेखपुरं व्रजेत् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002431034, "chapter_id": 22431, "verse_number": "१-९३-३५", "content_sanskrit": "गोशरीरे तु रोमाणि यावन्ति त्रिपुरान्तक ।\nस तावद्वर्षकोटीस्तु लेखलोके महीयते ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002431035, "chapter_id": 22431, "verse_number": "१-९३-३६", "content_sanskrit": "गोशतं भानवे दत्त्वा राजसूयफलं लभेत् ।\nअश्वमेधफलं तस्य यः सहस्रं प्रयच्छति ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002431036, "chapter_id": 22431, "verse_number": "१-९३-३७", "content_sanskrit": "गुग्गुलं देवदारुं च दहेन्नित्यं घृतस्रवम् ।\nआज्यधूमो६ हि देवानां प्रकृत्यैव प्रियः सदा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002431037, "chapter_id": 22431, "verse_number": "१-९३-३८", "content_sanskrit": "भेर्यादीनि च वाद्यानि शङ्खवेण्वादिकानि च ।\nये प्रयच्छन्ति सूर्याय यान्ति ते हंसमन्दिरम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002431038, "chapter_id": 22431, "verse_number": "१-९३-३९", "content_sanskrit": "वज्रमाहरते यस्तु रवेर्भक्तिसमन्वितः ।\nतीर्थोदकमथैवान्यः स याति विबुधालयम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002431039, "chapter_id": 22431, "verse_number": "१-९३-४०", "content_sanskrit": "विमानैः स्त्रीशताकीर्णैः क्रीडयित्वा चिरं नरः ।\nमानुषत्वमनुप्राप्य राजा भवति धार्मिकः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002431040, "chapter_id": 22431, "verse_number": "१-९३-४१", "content_sanskrit": "छत्रं ध्वजं वितानं च पताकाश्चामराणि च ।\nहेमदण्डानि वै दद्याद्रवेर्यो भक्तिमान्नरः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002431041, "chapter_id": 22431, "verse_number": "१-९३-४२", "content_sanskrit": "विमानेन स दिव्येन किङ्किणीजालमालिना ।\nसूर्यलोकमतो गत्वा भवत्यप्सरसां पतिः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002431042, "chapter_id": 22431, "verse_number": "१-९३-४३", "content_sanskrit": "तत्रोष्य सुचिरं कालं स्वर्गात्प्रत्यागतः पुनः ।\nमानुष्ये जायते राजा सर्वराजनमस्कृतः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002431043, "chapter_id": 22431, "verse_number": "१-९३-४४", "content_sanskrit": "दत्त्वा वासांसि सूर्याय अलङ्कारांस्तथैव च ।\nक्रीडते जनलोकस्थो यावदाभूतसंप्लवम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002431044, "chapter_id": 22431, "verse_number": "१-९३-४५", "content_sanskrit": "गीतवादित्रनृत्यैश्च कुर्याज्जागरणं रवेः ।\nगन्धर्वाप्सरसां मध्ये क्रीडते सुचिरं नरः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002431045, "chapter_id": 22431, "verse_number": "१-९३-४६", "content_sanskrit": "गन्धैः पुष्पैस्तथा पत्रैः स्तोत्रैर्वा विविधैस्तथा ।\nये स्तुवन्ति रविं भक्त्या ते यान्ति पतगालयम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002431046, "chapter_id": 22431, "verse_number": "१-९३-४७", "content_sanskrit": "उषः स्तुवन्ति ये सूर्यमुपगायन्ति ते सदा ।\nपाठकाश्चारणाश्चैव सर्वे ते स्वर्गगामिनः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002431047, "chapter_id": 22431, "verse_number": "१-९३-४८", "content_sanskrit": "अश्वयुक्तं युगैर्युक्तं यो दद्याद्रवये रथम् ।\nकाञ्चनं वापि रौप्यं वा मणिरत्नान्वितं शुभम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002431048, "chapter_id": 22431, "verse_number": "१-९३-४९", "content_sanskrit": "स यानेनार्कवर्णेन किङ्किणीजालमालिना ।\nस्वर्गलोकमितो गत्वा क्रीडतेऽप्सरसा सह ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002431049, "chapter_id": 22431, "verse_number": "१-९३-५०", "content_sanskrit": "यस्तु दारुमयं कुर्याद्रवे रथमनुत्तमम् ।\nस यात्यर्कसवर्णेन१ विमानेनार्कमण्डलम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002431050, "chapter_id": 22431, "verse_number": "१-९३-५१", "content_sanskrit": "यात्रां कुर्वन्ति ये भानोर्नराः संवत्सरादपि ।\nषण्मासाद्वा गणश्रेष्ठ तेषां पुण्यफलं शृणु ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002431051, "chapter_id": 22431, "verse_number": "१-९३-५२", "content_sanskrit": "ध्यानिनो योगिनश्चैव प्राप्नुवन्तीह यां गतिम् ।\nतां गतिं प्रतिपद्यन्ते सूर्यवर्त्मावगाहिनः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002431052, "chapter_id": 22431, "verse_number": "१-९३-५३", "content_sanskrit": "रथं वहन्ति ये भानोर्नरा भक्तिसमन्विताः ।\nअरोगाश्चादरिद्राश्च जातौ जातौ भवन्ति ते ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002431053, "chapter_id": 22431, "verse_number": "१-९३-५४", "content_sanskrit": "कर्तारो रथयात्राया ये नरा भास्करस्य तु ।\nते भानुलोकमासाद्य विहरन्ति यथासुखम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002431054, "chapter_id": 22431, "verse_number": "१-९३-५५", "content_sanskrit": "यात्राभङ्गं तु यो मोहात्क्रोधाद्वा कुरुते नरः ।\nमन्देहास्ते नरा ज्ञेया राक्षसाः पापकारिणः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002431055, "chapter_id": 22431, "verse_number": "१-९३-५६", "content_sanskrit": "धनं धान्यं हिरण्यं वा वासांसि विविधानि च ।\nये प्रयच्छन्ति सूर्याय ते यान्ति परमां गतिम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002431056, "chapter_id": 22431, "verse_number": "१-९३-५७", "content_sanskrit": "गा वाथ महिषीर्वापि गजानश्वांश्च शोभनान् ।\nय प्रयच्छति सूर्याय तस्य पुण्यफलं शृणु ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002431057, "chapter_id": 22431, "verse_number": "१-९३-५८", "content_sanskrit": "अक्षयं सर्वकामीयमश्वमेधफलं लभेत् ।\nसहस्रगुणितं तच्च दानमस्योपतिष्ठति ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002431058, "chapter_id": 22431, "verse_number": "१-९३-५९", "content_sanskrit": "महीं ददाति योऽर्काय कृष्टां फलवती शुभाम् ।\nस तारयति वै वंश्यान्दश पूर्वान्दशापरान् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002431059, "chapter_id": 22431, "verse_number": "१-९३-६०", "content_sanskrit": "विमानेन च दिव्येन गोपुरं गोपतेर्व्रजेत् ।\nक्रीडत्यप्सरसां मध्ये करीव करिणीगणे ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002431060, "chapter_id": 22431, "verse_number": "१-९३-६१", "content_sanskrit": "ग्रामं ददाति यो भक्त्या सूर्याय मतिमान्नरः ।\nविमानेनार्कवर्णेन स याति परमां गतिम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002431061, "chapter_id": 22431, "verse_number": "१-९३-६२", "content_sanskrit": "आरामान्ये प्रयच्छन्ति पत्रपुष्पफलोपगान् ।\nभानवे भक्तियुक्तास्तु ते यान्ति परमां गतिम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002431062, "chapter_id": 22431, "verse_number": "१-९३-६३", "content_sanskrit": "मानसं वाचिकं वापि कर्मजं यच्च दुष्कृतम् ।\nसर्वं सूर्यप्रसादेन अशेषं च प्रणश्यति ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002431063, "chapter_id": 22431, "verse_number": "१-९३-६४", "content_sanskrit": "आर्तो वा व्याधितो वापि दरिद्रो दुःखितोऽपि वा ।\nआदित्यं शरणं गत्वा नात्मानं शोचते नरः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002431064, "chapter_id": 22431, "verse_number": "१-९३-६५", "content_sanskrit": "एकाहेनापि यद्भानोः पूजायाः प्राप्यते फलम् ।\nतद्वै क्रतुशतैरिष्टैः प्राप्यते फलमुत्तमम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002431065, "chapter_id": 22431, "verse_number": "१-९३-६६", "content_sanskrit": "कृत्वा प्रेक्षणकं भानोर्दिव्यमायतने शुभम् ।\nअक्षयं सर्वकामीयं राजसूयफलं लभेत् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7002431066, "chapter_id": 22431, "verse_number": "१-९३-६७", "content_sanskrit": "वेश्याकदम्बकं यस्तु दद्यात्सूर्याय भक्तितः ।\nस गच्छेत्परमं स्थानं यत्र तिष्ठति भानुमान् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7002431067, "chapter_id": 22431, "verse_number": "१-९३-६८", "content_sanskrit": "पुस्तकं भानवे दद्याद्भारतस्य गणाधिप ।\nसर्वपापविमुक्तात्मा विष्णुलोके महीयते ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7002431068, "chapter_id": 22431, "verse_number": "१-९३-६९", "content_sanskrit": "रामायणस्य दत्वा तु पुस्तकं त्रिपुरान्तक ।\nवाजपेयफलं प्राप्य गोपतेः पुरमाव्रजेत् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7002431069, "chapter_id": 22431, "verse_number": "१-९३-७०", "content_sanskrit": "भविष्यं साम्बसंज्ञं वा दत्त्वा सूर्याय पुस्तकम् ।\nराजसूयाश्वमेधाभ्यां फलं प्राप्नोति मानवः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7002431070, "chapter_id": 22431, "verse_number": "१-९३-७१", "content_sanskrit": "सर्वान्कामानवाप्नोति याति सूर्यसलोकताम् ।\nसूर्यलोके चिरं स्थित्वा ब्रह्मलोकं व्रजेत्पुनः ।\nस्थित्वा कल्पशतं तत्र राजा भवति भूतले ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7002431071, "chapter_id": 22431, "verse_number": "१-९३-७२", "content_sanskrit": "भानोरायतने यस्तु प्रपां कुर्याद्गणाधिप ।\nस याति परमं स्थानं दिव्यं सौमनसं नरः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7002431072, "chapter_id": 22431, "verse_number": "१-९३-७३", "content_sanskrit": "शीतकाले घनं दद्यान्नराणां शीतनाशनम् ।\nभानोरायतने देव अश्वमेधफलं लभेत् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7002431073, "chapter_id": 22431, "verse_number": "१-९३-७४", "content_sanskrit": "इतिहासपुराणाभ्यां पुण्यं पुस्तकवाचनम् ।\nअश्वमेधसहस्रं यो नित्यं कर्तुं प्रवर्तते ।\nन तत्फलमवाप्नोति यदाप्नोत्यस्य कर्मणः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7002431074, "chapter_id": 22431, "verse_number": "१-९३-७५", "content_sanskrit": "तस्मात्सर्वप्रयत्नेन कार्यं पुस्तकवाचनम् ।\nइतिहासपुराणाभ्यां भानोरायतने शुभम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7002431075, "chapter_id": 22431, "verse_number": "१-९३-७६", "content_sanskrit": "नान्यत्पुष्टिकरं भानोस्तथा तुष्टिकरं परम् ।\nपुण्याख्यानकथा यास्तु यथा तुष्यति भास्करः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}]