[{"id": 2159680, "chapter_id": 4465, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2159681, "chapter_id": 4465, "verse_number": "१", "content_sanskrit": "श्रुत्वा तु तं महाशब्दं पाण्डूनां पुत्रगृद्धिनाम् ।\nचारैः प्रवेदितस्त्रस्तः समुत्थाय जयद्रथः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2159682, "chapter_id": 4465, "verse_number": "२", "content_sanskrit": "शोकसम्मूढहृदयो दुःखेनाभ्याहतो भृशम् ।\nमज्जमान इवागाधे विपुले शोकसागरे\nजगाम समितिं राज्ञां सैन्धवो विमृशन् बहु\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2159683, "chapter_id": 4465, "verse_number": "३", "content_sanskrit": "स तेषां नरदेवानां सकाशे पर्यदेवयत् ।\nअभिमन्युपितुर्भीतः सव्रीडो वाक्यमब्रवीत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2159684, "chapter_id": 4465, "verse_number": "४", "content_sanskrit": "पाण्डोः क्षेत्रे यस्तु जातः शक्रेण किल कामिना ।\nस निनीषति दुर्बुद्धिर्मां किलैकं यमक्षयम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2159685, "chapter_id": 4465, "verse_number": "५", "content_sanskrit": "स्वस्ति वोऽस्तु गमिष्यामि स्वगृहं जीवितेप्सया॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2159686, "chapter_id": 4465, "verse_number": "६", "content_sanskrit": "अथवा स्थ प्रतिबलाः त्रातुं मां क्षत्रियर्षभाः ।\nपार्थेन पार्थिवा वीरास्स्तद् ददध्वं ममाभयम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2159687, "chapter_id": 4465, "verse_number": "७", "content_sanskrit": "द्रोणदुर्योधनकृपाः कर्णमद्रेशबाह्लिकाः ।\nदुःशासनादयः शक्ताः त्रातुमप्यन्तकार्दितम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2159688, "chapter_id": 4465, "verse_number": "८", "content_sanskrit": "किमङ्गाः पुनरेकेन फल्गुनेन जिघांसता ।\nन त्रास्यन्ति भवन्तो मां समस्ताः पतयः क्षितेः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2159689, "chapter_id": 4465, "verse_number": "९", "content_sanskrit": "प्रतिज्ञां पाण्डवेयानां श्रुत्वा मम महद् भयम् ।\nसीदन्ति मम गात्राणि मुमूर्षोरिव पार्थिवाः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2159690, "chapter_id": 4465, "verse_number": "१०", "content_sanskrit": "वधो नूनं प्रतिज्ञातो मम गाण्डीवधन्वना ।\nतथा हि हृष्टाः क्रोशन्ति शोककालेऽपि पाण्डवाः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2159691, "chapter_id": 4465, "verse_number": "११", "content_sanskrit": "तन्न देवा न गन्धर्वा नासुरा न च राक्षसाः ।\nशक्नुवन्त्यन्यथाकर्त कुत एव नराधिपाः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2159692, "chapter_id": 4465, "verse_number": "१२", "content_sanskrit": "तस्मान्मामनुजानीध्वं भद्रं वोऽस्तु नराधिपाः ।\nअदर्शनं गमिष्यामि न मां द्रक्ष्यन्ति पाण्डवाः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2159693, "chapter_id": 4465, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2159694, "chapter_id": 4465, "verse_number": "१३", "content_sanskrit": "एवं विलपमानं तं भयव्याकुलचेतसम् ।\nआत्मकार्यगरीयस्त्वाद् राजा दुर्योधनोऽब्रवीत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2159695, "chapter_id": 4465, "verse_number": "१४", "content_sanskrit": "न भेतव्यं नरव्याघ्र को हि त्वा पुरुषर्षभ ।\nमध्ये क्षत्रियवीराणां तिष्ठन्तं प्रार्थयेत् पुमान्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2159696, "chapter_id": 4465, "verse_number": "१५", "content_sanskrit": "एषां हि नरदेवानां मत्तमातङ्गगामिनाम् ।\nसङ्घातमुपयातानामपि बिभ्येत् पुरन्दरः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2159697, "chapter_id": 4465, "verse_number": "१६", "content_sanskrit": "अहं वैकर्तनः कर्णः चित्रसेनो विविंशतिः ।\nभूरिश्रवाः शलः शल्यो वृषसेनो दुरासदः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2159698, "chapter_id": 4465, "verse_number": "१७", "content_sanskrit": "पुरुमित्रो जयो भोजः काम्बोजो बाह्लिकः कृपः ।\nसत्यव्रतो महाबाहुर्विकर्णो दुर्मुखः सहः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2159699, "chapter_id": 4465, "verse_number": "१८", "content_sanskrit": "दुःशासनः सुबाहुश्च कळिङ्गश्चाप्युदायुधः ।\nविन्दानुविन्दावावन्त्यौ द्रौणिश्च सहसौबलः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2159700, "chapter_id": 4465, "verse_number": "१९", "content_sanskrit": "एते चान्ये च बहवो नानाजनपदेश्वराः ।\nससैन्यास्त्वाभियास्यन्ति व्येतु ते मानसो ज्वरः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2159701, "chapter_id": 4465, "verse_number": "२०", "content_sanskrit": "मायावी बलवान् शूरो राक्षसश्चाप्यलम्बुसः ।\nइमे च त्वाऽभिगोप्स्यन्ति सैन्येन महता वृताः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2159702, "chapter_id": 4465, "verse_number": "२१", "content_sanskrit": "त्वं चापि रथिनां श्रेष्ठः स्वयं शूरोऽसि पार्थिव ।\nकथञ्च पाण्डवेयेभ्यो भयं पश्यसि सैन्धव\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2159703, "chapter_id": 4465, "verse_number": "२२", "content_sanskrit": "अक्षोहिण्यो महावीर्य मदीयास्तव रक्षणे ।\nयत्ता योत्स्यन्ति मा भैषीः सैन्धव व्येतु ते भयम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2159704, "chapter_id": 4465, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2159705, "chapter_id": 4465, "verse_number": "२३", "content_sanskrit": "एवमाश्वासितो राज्ञा पुत्रेण तव सैन्धवः ।\nदुर्योधनेन सहितो द्रोणं रात्रावुपागमत्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2159706, "chapter_id": 4465, "verse_number": "२४", "content_sanskrit": "उपसङ्गृह्य चरणौ द्रोणस्य च विशांपतिः ।\nउपोपविश्य प्रणतः पर्यपृच्छदिदं तदा\nअर्जुनस्यात्मनश्चार्थे विशेषं पर्यपृच्छत\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2159707, "chapter_id": 4465, "verse_number": "२५", "content_sanskrit": "निमित्ते दूरपातित्वे लघुत्वे दृढवेधने ।\nब्रवीतु भगवान् मह्यं विशेषं फल्गुनस्य च\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2159708, "chapter_id": 4465, "verse_number": "२६", "content_sanskrit": "विद्याविशेषमाचार्य ज्ञातुमिच्छामि तत्त्वतः ।\nअर्जुनस्यात्मनश्चैव यथातत्त्वं ब्रवीहि मे\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2159709, "chapter_id": 4465, "verse_number": "", "content_sanskrit": "द्रोणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2159710, "chapter_id": 4465, "verse_number": "२७", "content_sanskrit": "सममाचार्यकं तात तव चैवार्जुनस्य च ।\nयोगाद् दुःखोचितत्वाच्च तस्मात् त्वदधिकोऽर्जुनः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2159711, "chapter_id": 4465, "verse_number": "२८", "content_sanskrit": "न तु ते युधि सन्त्रासः पार्थात् कार्यः कथञ्चन ।\nअहं हि रक्षिता तात भयात् त्वां श्वो न संशयः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2159712, "chapter_id": 4465, "verse_number": "२९", "content_sanskrit": "न हि मद्बाणगुप्तस्य प्रभवन्त्यमरा अपि ।\nव्यूहिष्यामि च तं व्यूहं यं पार्थो न तरिष्यति\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2159713, "chapter_id": 4465, "verse_number": "३०", "content_sanskrit": "तस्माद् युद्ध्यस्व मा भैस्त्वं स्वधर्ममनुपालय ।\nपितृपैतामहं मार्गमनुयाहि महारथ\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2159714, "chapter_id": 4465, "verse_number": "३१", "content_sanskrit": "अधीता विधिवद् वेदा अग्नयः सुहुतास्त्वया ।\nइष्टं च बहुभिर्यज्ञैर्न ते मृत्युभवं भयम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2159715, "chapter_id": 4465, "verse_number": "", "content_sanskrit": "दुर्लभं मानुषैर्मन्दैर्महाभाग्यमवाप्य तु ।\nभुजवीर्यार्जिताँल्लोकान् दिव्यान् प्राप्स्यस्यनुत्तमान् ।३२।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2159716, "chapter_id": 4465, "verse_number": "३३", "content_sanskrit": "कुरवः पाण्डवाश्चैव वृष्णयोऽन्ये च मानवाः ।\nअहं च सह पुत्रेण अध्रुवा इति चिन्त्यताम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2159717, "chapter_id": 4465, "verse_number": "३४", "content_sanskrit": "पर्यायेण वयं सर्वे कालेन बलिना हताः ।\nपरलोकं गमिष्यामः स्वैः स्वैः कर्मभिरन्विताः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2159718, "chapter_id": 4465, "verse_number": "३५", "content_sanskrit": "तपस्तप्त्वा तु याँल्लोकान् प्राप्नुवन्ति यशस्विनः ।\nक्षत्रधर्माश्रिता वीराः क्षत्रियाः प्राप्नुवन्ति तान्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2159719, "chapter_id": 4465, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2159720, "chapter_id": 4465, "verse_number": "३६", "content_sanskrit": "एवमाश्वासितो राजा भारद्वाजेन सैन्धवः ।\nव्यपानुदद् भयं पार्थाद् युद्धाय च मनो दधे\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2159721, "chapter_id": 4465, "verse_number": "३७", "content_sanskrit": "ततः प्रहर्षः सैन्यानां तस्य चासीद् विशांपते ।\nवादित्राणां ध्वनिश्चोग्रः सिंहनादरवैः सह\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2159722, "chapter_id": 4465, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि सप्ततितमोऽध्यायः ॥ ७० ॥\nप्रतिज्ञापर्वणि द्वितीयोऽध्यायः ॥ २ ॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]