[{"id": 50020657, "chapter_id": 11668, "verse_number": "1", "content_sanskrit": "राजोवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50020658, "chapter_id": 11668, "verse_number": "2", "content_sanskrit": "परस्य विष्णोरीशस्य मायिनामपि मोहिनीम्। मायां वेदितुमिच्छामो भगवन्तो ब्रुवन्तु नः॥ ११/३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50020659, "chapter_id": 11668, "verse_number": "3", "content_sanskrit": "नानुतृप्ये जुषन् युष्मद्वचो हरिकथामृतम्। संसारतापनिष्टप्तो मर्त्यस्तत्तापभेषजम्॥ ११/३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50020660, "chapter_id": 11668, "verse_number": "4", "content_sanskrit": "अन्तरिक्ष उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50020661, "chapter_id": 11668, "verse_number": "5", "content_sanskrit": "एभिर्भूतानि भूतात्मा महाभूतैर्महाभुज। ससर्जोच्चावचान्यादौ स्वयमात्मप्रसिद्धये॥ ११/३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50020662, "chapter_id": 11668, "verse_number": "6", "content_sanskrit": "एवं सृष्ट्वा स भूतानि स्थविष्ठैः पञ्चधातुभिः। एकधा दशधाऽऽत्मानं विभजन् जुषते गुणान्॥ ११/३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50020663, "chapter_id": 11668, "verse_number": "7", "content_sanskrit": "गुणैर्गुणान् स भुञ्जान आत्मप्रद्योतितैः प्रभुः। मन्यमान इदं सृष्टमात्मानमिह सज्जते॥ ११/३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50020664, "chapter_id": 11668, "verse_number": "8", "content_sanskrit": "कर्माणि कर्मभिः कुर्वन् सनिमित्तानि देहभृत्। तत्तत्कर्मफलं गृह्णन् भ्रमतीह सुखेतरम्॥ ११/३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50020665, "chapter_id": 11668, "verse_number": "9", "content_sanskrit": "इत्थं कर्मगतीर्गच्छन् बह्वभद्रावहः पुमान्। आभूतसंप्लवात् स्वर्गप्रळयावश्नुतेऽवशः॥ ११/३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50020666, "chapter_id": 11668, "verse_number": "10", "content_sanskrit": "धातूपप्लव आसन्ने व्यक्तं द्रव्यगुणात्मकम्। अनादिनिधनः कालो ह्यव्यक्ताय विकर्षति॥ ११/३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50020667, "chapter_id": 11668, "verse_number": "11", "content_sanskrit": "शतवर्षमनावृष्टिर्भविष्यत्युद्बणा भुवि। तत्कालोपचितोष्णार्को लोकांस्त्रीन् प्रतपिष्यति॥ ११/३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50020668, "chapter_id": 11668, "verse_number": "12", "content_sanskrit": "पाताळतळमारभ्य सङ्कर्षणमुखानलः। दहन्नूर्ध्वमुखो विष्वग्वर्धते वायुनेरितः॥ ११/३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50020669, "chapter_id": 11668, "verse_number": "13", "content_sanskrit": "संवर्तको मेघगणो वर्षति स्म शतं समाः। धाराभिर्हस्तिहस्ताभिर्लीयते सलिले विराट्॥ ११/३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50020670, "chapter_id": 11668, "verse_number": "14", "content_sanskrit": "ततो विराजमुत्सृज्य वैराजः पुरुषो नृप। अव्यक्तं विशते सूक्ष्मं निरिन्धन इवानलः॥ ११/३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50020671, "chapter_id": 11668, "verse_number": "15", "content_sanskrit": "वारिणा हृतगन्धा भूः सलिलत्वाय कल्पते। सलिलं तद् हृतरसं ज्योतिष्ट्वायोपकल्पते॥ ११/३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50020672, "chapter_id": 11668, "verse_number": "16", "content_sanskrit": "हृतरूपं तु तमसा वायौ ज्योतिः प्रलीयते। हृतस्पर्शोऽवकाशेन वायुर्नभसि लीयते॥ ११/३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50020673, "chapter_id": 11668, "verse_number": "17", "content_sanskrit": "कालात्मना हृतगुणं नभ आत्मनि लीयते। इन्द्रियाणि मनो बुद्धिः सह वैकारिकैर्नृप॥ ११/३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50020674, "chapter_id": 11668, "verse_number": "18", "content_sanskrit": "प्रविशन्ति ह्यहङ्कारं स्वगुणैरहमात्मनि॥ ११/३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50020675, "chapter_id": 11668, "verse_number": "19", "content_sanskrit": "एषा माया भगवतः सृष्टिस्थित्यन्तकारिणी। त्रिवर्णा वर्णिताऽस्माभिः किं भूयः श्रोतुमिच्छसि॥ ११/३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50020676, "chapter_id": 11668, "verse_number": "20", "content_sanskrit": "राजोवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50020677, "chapter_id": 11668, "verse_number": "21", "content_sanskrit": "यथैतामैश्वरीं मायां दुस्तरामकृतात्मभिः। तरन्त्यञ्जः स्थूलधियो महर्ष इदमुच्यताम्॥ ११/३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50020678, "chapter_id": 11668, "verse_number": "22", "content_sanskrit": "प्रबुद्ध उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50020679, "chapter_id": 11668, "verse_number": "23", "content_sanskrit": "कर्माण्यारभमाणानां दुःखहत्यै सुखाय च। पश्येत् पाकविपर्यासं मिथुनीचारिणां नृणाम्॥ ११/३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50020680, "chapter_id": 11668, "verse_number": "24", "content_sanskrit": "नित्यार्तिदेन वित्तेन दुर्लभेनात्ममृत्युना। गृहापत्याप्तपशुभिः का प्रीतिः साधितैश्चलैः॥ ११/३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50020681, "chapter_id": 11668, "verse_number": "25", "content_sanskrit": "एवं लोकं परं विद्यान्नश्वरं कर्मनिर्मितम्। अतुल्यातिशयध्वंसाद् यथा मण्डलवर्तिनाम्॥ ११/३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50020682, "chapter_id": 11668, "verse_number": "26", "content_sanskrit": "तस्माद् गुरुं प्रपद्येत जिज्ञासुः श्रेय उत्तमम्। शाब्दे परे च निष्णातं ब्रह्मण्युपशमाश्रयम्॥ ११/३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50020683, "chapter_id": 11668, "verse_number": "27", "content_sanskrit": "तत्र भागवतान् धर्मान् शिक्षेद् गुर्वात्मदैवतः। अमाययाऽनुवृत्त्या यैस्तुष्येदात्माऽऽत्मदो हरिः॥ ११/३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50020684, "chapter_id": 11668, "verse_number": "28", "content_sanskrit": "सर्वतो मनसोऽसङ्गमादौ सङ्गं च साधुषु। दयां मैत्रीं प्रश्रयं च भूतेष्वद्धा यथोचितम्॥ ११/३/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50020685, "chapter_id": 11668, "verse_number": "29", "content_sanskrit": "शौचं तपस्तितिक्षां च मौनं स्वाध्यायमार्जवम्। ब्रह्मचर्यमहिंसां च समत्वं द्वन्द्वसञ्ज्ञयोः॥ ११/३/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50020686, "chapter_id": 11668, "verse_number": "30", "content_sanskrit": "सर्वत्रात्मेश्वरान्वीक्षां कैवल्यमनिकेतनम्। विविक्तं चीरवसनं सन्तोषं येन केन चित्॥ ११/३/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50020687, "chapter_id": 11668, "verse_number": "31", "content_sanskrit": "श्रद्धां भागवते शास्त्रेऽनिन्दामन्यत्र चापि हि। मनोवाक्कायदण्डं च सत्यं शमदमावपि॥ ११/३/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50020688, "chapter_id": 11668, "verse_number": "32", "content_sanskrit": "श्रवणं कार्तनं ध्यानं हरेरद्भुतकर्मणः। जन्मकर्मगुणानां च तदर्थेऽखिलचेष्टितम्॥ ११/३/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50020689, "chapter_id": 11668, "verse_number": "33", "content_sanskrit": "इष्टं दत्तं तपो जप्तं पूर्तं यच्चात्मनः प्रियम्। दारान् सुतान् प्रियान् प्राणान् परस्मै सन्निवेदयेत्॥ ११/३/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50020690, "chapter_id": 11668, "verse_number": "34", "content_sanskrit": "एवं कृष्णात्मनाथेषु मनुष्येषु च सौहृदम्। परिचर्यां चोभयत्र महत्सु नृषु साधुषु॥ ११/३/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50020691, "chapter_id": 11668, "verse_number": "35", "content_sanskrit": "परस्परानुकथनं पावनं भगवद्यशः। मिथो रतिर्मिथस्तुष्टि निर्वृत्तिर्मिथ आत्मनः॥ ११/३/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50020692, "chapter_id": 11668, "verse_number": "36", "content_sanskrit": "स्मरन्तः स्मारयन्तश्च मिथोऽघौघहरं हरिम्। भक्त्या सञ्जातया भक्त्या बिभ्रत्युत्पुळकां तनुम्॥ ११/३/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50020693, "chapter_id": 11668, "verse_number": "37", "content_sanskrit": "क्वचिद् रुदन्त्यच्युतचिन्तया क्वचि- द्धसन्ति नन्दन्ति वदन्त्यलौकिकान्। नृत्यन्ति गायन्त्यनुशीलयन्त्यजं भवन्ति तूष्णीं परमेत्य निर्वृताः॥ ११/३/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50020694, "chapter_id": 11668, "verse_number": "38", "content_sanskrit": "इति भागवतान् धर्मान् शिक्षन् भक्त्या तदुत्थया। नारायणपरो मायामञ्जस्तरति दुस्तराम्॥ ११/३/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50020695, "chapter_id": 11668, "verse_number": "39", "content_sanskrit": "राजोवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50020696, "chapter_id": 11668, "verse_number": "40", "content_sanskrit": "नारायणाभिधानस्य ब्रह्मणः परमात्मनः। निष्ठामर्हथ नो वक्तुं यूयं हि ब्रह्मवित्तमाः॥ ११/३/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50020697, "chapter_id": 11668, "verse_number": "41", "content_sanskrit": "पिप्पलायन उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50020698, "chapter_id": 11668, "verse_number": "42", "content_sanskrit": "स्थित्युद्भवप्रलयहेतुरहेतुरस्य यः स्वप्नजागरसुषुप्तिषु सन् बहिश्च। देहेन्द्रियासुहृदयानि चरन्ति येन सञ्जीवितानि तदवैहि परं नरेन्द्र॥ ११/३/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50020699, "chapter_id": 11668, "verse_number": "43", "content_sanskrit": "नैनं मनो विशति वागुत चक्षुरात्मा प्राणेन्द्रियाण्यपि यथाऽनलमर्चिषः स्वाः। शब्दोऽप्यबोधकनिषेधतयाऽऽत्ममूल- मर्थोक्तमाह यदृते न निषेध्यसिध्दिः॥ ११/३/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50020700, "chapter_id": 11668, "verse_number": "44", "content_sanskrit": "सत्त्वं रजस्तम इति त्रिवृदेकमादौ सूत्रं महानहमिति प्रवदन्ति जीवम्। ज्ञानक्रियार्थफलरूपतयोरुशक्ति ब्रह्मैव भाति सदसच्च तयोः परं यत्॥ ११/३/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 50020701, "chapter_id": 11668, "verse_number": "45", "content_sanskrit": "नासौ जजान न मरिष्यति नैधतेऽसौ न क्षीयते स च न विध्द्यति चारिणाऽपि। सर्वत्र शश्वदनपाय्युपलब्धिमात्रं प्राणो यथेन्द्रियबलेन विकल्पितं सत्॥ ११/३/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 50020702, "chapter_id": 11668, "verse_number": "46", "content_sanskrit": "अण्डेषु पेशिषु तरुष्ववनिस्थितेषु प्राणेन जीव उपधावति तत्र तत्र। छन्ने मतीन्द्रियगुणेऽहमि च प्रसुप्ते कूटस्थ आस यमृते तदनुस्मृतिर्न॥ ११/३/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 50020703, "chapter_id": 11668, "verse_number": "47", "content_sanskrit": "यर्ह्यब्जनाभचरणेषणयोरुभक्त्या चेतो मलानि विधमेद् गुणकर्मजानि। तस्मिन् विशुद्ध उपलभ्यत आत्मतत्वं साक्षाद् यथाऽमलदृशौ सवितृप्रकाशः॥ ११/३/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 50020704, "chapter_id": 11668, "verse_number": "48", "content_sanskrit": "राजोवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 50020705, "chapter_id": 11668, "verse_number": "49", "content_sanskrit": "कर्मयोगं वदत नः पुरुषो येन संस्कृतः। विधूयेहाशु कर्माणि नैर्ष्कम्यं विन्दते परम्॥ ११/३/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 50020706, "chapter_id": 11668, "verse_number": "50", "content_sanskrit": "एतत्प्रश्नमृषीन् पूर्वमपृच्छं पितुरन्तिके। नाब्रुवन् ब्रह्मणः पुत्रास्तत्र कारणमुच्यताम्॥ ११/३/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 50020707, "chapter_id": 11668, "verse_number": "51", "content_sanskrit": "आविर्होत्र उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 50020708, "chapter_id": 11668, "verse_number": "52", "content_sanskrit": "कर्माकर्मविकर्मेति वेदवादो न लौकिकः। वेदस्य चेश्वरात्मत्वात् तत्र मुह्यन्ति सूरयः॥ ११/३/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 50020709, "chapter_id": 11668, "verse_number": "53", "content_sanskrit": "परोक्षवादो वेदोऽयं बालानामनुशासनम्। कर्ममोक्षाय कर्माणि विधत्ते ह्यगदं यथा॥ ११/३/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 50020710, "chapter_id": 11668, "verse_number": "54", "content_sanskrit": "नाऽऽचरेद् यस्तु वेदोक्तं स्वयमज्ञोऽजितेन्द्रियः। विकर्मणा ह्यधर्मेण मृत्योर्मृत्युमुपैति सः॥ ११/३/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 50020711, "chapter_id": 11668, "verse_number": "55", "content_sanskrit": "वेदोक्तमेव कुर्वाणो निःसङ्गोऽर्पितमीश्वरे। नैर्ष्कम्यां लभते सिद्धिं रोचनार्थं फलश्रुतिः॥ ११/३/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 50020712, "chapter_id": 11668, "verse_number": "56", "content_sanskrit": "य आशु हृदयग्रन्थिं निर्जिहीर्षुरथात्मनः। विधिनोपचरेद् देवं तन्त्रोक्तेन च केशवम्॥ ११/३/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 50020713, "chapter_id": 11668, "verse_number": "57", "content_sanskrit": "लब्ध्वा चाव्यग्रमाचार्यं तेन सन्दर्शितागमः। महापुरुषमभ्यर्चेन्मूर्त्याऽभिमतयाऽऽत्मनः॥ ११/३/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 50020714, "chapter_id": 11668, "verse_number": "58", "content_sanskrit": "शुचिः संमुख आसीनः प्राणसंयमनादिभिः। पिण्डं विशोध्य सन्न्यासकृतरक्षोऽर्चयेद् हरिम्॥ ११/३/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 50020715, "chapter_id": 11668, "verse_number": "59", "content_sanskrit": "अर्चादौ हृदये वापि यथालब्धोपचारकैः। द्रव्यक्षित्यात्मलिङ्गानि निष्पाद्य प्रोक्ष्य चासनम्॥ ११/३/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 50020716, "chapter_id": 11668, "verse_number": "60", "content_sanskrit": "पाद्यादीनुपकल्प्याथ सन्निधाप्य समाहितः। हृदयादिकृतन्यासो मूलमन्त्रेण चार्चयेत्॥ ११/३/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 50020717, "chapter_id": 11668, "verse_number": "61", "content_sanskrit": "साङ्गोपाङ्गां सपार्षदां तां तां मूर्तिं स्वमन्त्रतः। पाद्यार्ध्याचमनीयाद्यैः स्नानवासोविभूषणैः॥ ११/३/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 50020718, "chapter_id": 11668, "verse_number": "62", "content_sanskrit": "साङ्गं सम्पूज्य विधिवत् स्तवैःस्तुत्वा नमेद् हरिम्॥ ११/३/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 50020719, "chapter_id": 11668, "verse_number": "63", "content_sanskrit": "आत्मानं तन्मयं ध्यायन् मूर्तिं सम्पूजयेद् हरेः। शेषमाधाय शिरसि स्वधाम्न्युद्वास्य सत्कृतम्॥ ११/३/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 50020720, "chapter_id": 11668, "verse_number": "64", "content_sanskrit": "एवमग्न्यर्कतोयादावर्चयन् हृदये च यः। यज्ञेश्वरं स्वमात्मानमचिरान्मुच्यते हि सः॥ ११/३/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 50020721, "chapter_id": 11668, "verse_number": "65", "content_sanskrit": "इति श्रीमद्भागवते एकादशस्कन्धे तृतीयोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]