[{"id": 7005761000, "chapter_id": 25761, "verse_number": "२३४-१", "content_sanskrit": "शान्तिविधानवर्णनम् ।\nगर्ग उवाच ।\nनगरादपसर्पन्ते समीपमुपयान्ति च ।\nनद्यो ह्रद प्रस्रवाणि विरसाश्च भवन्ति च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005761001, "chapter_id": 25761, "verse_number": "२३४-२", "content_sanskrit": "विवर्णं कलुषन्तप्तं फेनवज्जन्तु सङ्कुलम् ।\nस्नेहं क्षीरं सुरां रक्तं वहन्ते वा कुलोदकाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005761002, "chapter_id": 25761, "verse_number": "२३४-३", "content_sanskrit": "षण्मासाभ्यन्तरे तत्र परचक्रभयम्भवेत् ।\nजलाशया नदन्ते वा प्रज्वलन्ति कथञ्चन ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005761003, "chapter_id": 25761, "verse_number": "२३४-४", "content_sanskrit": "विमुञ्चन्ति तथा ब्रह्मन्! ज्वालाधूमरजांसि च ।\nअथवा ते जलोत्पत्तिः सुसत्वा वा जलाशयाः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005761004, "chapter_id": 25761, "verse_number": "२३४-५", "content_sanskrit": "सङ्गीतशब्दाः श्रूयन्ते जनमारभयम्भवेत् ।\nदिव्यमम्भोमयं सर्पिर्मधुतैलावसेचनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005761005, "chapter_id": 25761, "verse_number": "२३४-६", "content_sanskrit": "जप्तव्या वारुणा मन्त्रास्तैश्च होमो जले भवेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005761006, "chapter_id": 25761, "verse_number": "२३४-७", "content_sanskrit": "मध्वाज्ययुक्तं परमान्नमत्र देयं द्विजानां द्विज भोजनार्थम् ।\nगावश्च देयाः सितवस्त्रयुक्तास्तथोदकुम्भाः सलिलाघशान्त्यै ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}]