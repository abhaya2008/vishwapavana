[{"id": 5000532000, "chapter_id": 9532, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे पञ्चविंशत्यधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000532001, "chapter_id": 9532, "verse_number": "६-१२५-१", "content_sanskrit": "अयोध्यां तु समालोक्य चिन्तयामास राघवः।\nप्रियकामः प्रियं रामस्ततस्त्वरितविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000532002, "chapter_id": 9532, "verse_number": "६-१२५-२", "content_sanskrit": "चिन्तयित्वा ततो दृष्टिं वानरेषु न्यपातयत्।\nउवाच धीमांस्तेजस्वी हनूमन्तं प्लवंगमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000532003, "chapter_id": 9532, "verse_number": "६-१२५-३", "content_sanskrit": "अयोध्यां त्वरितो गत्वा शीघ्रं प्लवगसत्तम।\nजानीहि कच्चित् कुशली जनो नृपतिमन्दिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000532004, "chapter_id": 9532, "verse_number": "६-१२५-४", "content_sanskrit": "शृङ्गवेरपुरं प्राप्य गुहं गहनगोचरम्।\nनिषादाधिपतिं ब्रूहि कुशलं वचनान्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000532005, "chapter_id": 9532, "verse_number": "६-१२५-५", "content_sanskrit": "श्रुत्वा तु मां कुशलिनमरोगं विगतज्वरम्।\nभविष्यति गुहः प्रीतः स ममात्मसमः सखा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000532006, "chapter_id": 9532, "verse_number": "६-१२५-६", "content_sanskrit": "अयोध्यायाश्च ते मार्गं प्रवृत्तिं भरतस्य च।\nनिवेदयिष्यति प्रीतो निषादाधिपतिर्गुहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000532007, "chapter_id": 9532, "verse_number": "६-१२५-७", "content_sanskrit": "भरतस्तु त्वया वाच्यः कुशलं वचनान्मम।\nसिद्धार्थं शंस मां तस्मै सभार्यं सहलक्ष्मणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000532008, "chapter_id": 9532, "verse_number": "६-१२५-८", "content_sanskrit": "हरणं चापि वैदेह्या रावणेन बलीयसा।\nसुग्रीवेण च संवादं वालिनश्च वधं रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000532009, "chapter_id": 9532, "verse_number": "६-१२५-९", "content_sanskrit": "मैथिल्यन्वेषणं चैव यथा चाधिगता त्वया।\nलङ्घयित्वा महातोयमापगापतिमव्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000532010, "chapter_id": 9532, "verse_number": "६-१२५-१०", "content_sanskrit": "उपयानं समुद्रस्य सागरस्य च दर्शनम्।\nयथा च कारितः सेतू रावणश्च यथा हतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000532011, "chapter_id": 9532, "verse_number": "६-१२५-११", "content_sanskrit": "वरदानं महेन्द्रेण ब्रह्मणा वरुणेन च।\nमहादेवप्रसादाच्च पित्रा मम समागमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000532012, "chapter_id": 9532, "verse_number": "६-१२५-१२", "content_sanskrit": "उपयातं च मां सौम्य भरताय निवेदय।\nसह राक्षसराजेन हरीणामीश्वरेण च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000532013, "chapter_id": 9532, "verse_number": "६-१२५-१३", "content_sanskrit": "जित्वा शत्रुगणान् रामः प्राप्य चानुत्तमं यशः।\nउपायाति समृद्धार्थः सह मित्रैर्महाबलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000532014, "chapter_id": 9532, "verse_number": "६-१२५-१४", "content_sanskrit": "एतच्छ्रुत्वा यमाकारं भजते भरतस्ततः।\nस च ते वेदितव्यः स्यात् सर्वं यच्चापि मां प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000532015, "chapter_id": 9532, "verse_number": "६-१२५-१५", "content_sanskrit": "ज्ञेयाः सर्वे च वृत्तान्ता भरतस्येङ्गितानि च।\nतत्त्वेन मुखवर्णेन दृष्ट्या व्याभाषितेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000532016, "chapter_id": 9532, "verse_number": "६-१२५-१६", "content_sanskrit": "सर्वकामसमृद्धं हि हस्त्यश्वरथसंकुलम्।\nपितृपैतामहं राज्यं कस्य नावर्तयेन्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000532017, "chapter_id": 9532, "verse_number": "६-१२५-१७", "content_sanskrit": "संगत्या भरतः श्रीमान् राज्येनार्थी स्वयं भवेत्।\nप्रशास्तु वसुधां सर्वामखिलां रघुनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000532018, "chapter_id": 9532, "verse_number": "६-१२५-१८", "content_sanskrit": "तस्य बुद्धिं च विज्ञाय व्यवसायं च वानर।\nयावन्न दूरं याताः स्मः क्षिप्रमागन्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000532019, "chapter_id": 9532, "verse_number": "६-१२५-१९", "content_sanskrit": "इति प्रतिसमादिष्टो हनूमान् मारुतात्मजः।\nमानुषं धारयन् रूपमयोध्यां त्वरितो ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000532020, "chapter_id": 9532, "verse_number": "६-१२५-२०", "content_sanskrit": "अथोत्पपात वेगेन हनूमान् मारुतात्मजः।\nगरुत्मानिव वेगेन जिघृक्षन्नुरगोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000532021, "chapter_id": 9532, "verse_number": "६-१२५-२१", "content_sanskrit": "लङ्घयित्वा पितृपथं विहगेन्द्रालयं शुभम्।\nगङ्गायमुनयोर्भीमं समतीत्य समागमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000532022, "chapter_id": 9532, "verse_number": "६-१२५-२२", "content_sanskrit": "शृङ्गवेरपुरं प्राप्य गुहमासाद्य वीर्यवान्।\nस वाचा शुभया हृष्टो हनूमानिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000532023, "chapter_id": 9532, "verse_number": "६-१२५-२३", "content_sanskrit": "सखा तु तव काकुत्स्थो रामः सत्यपराक्रमः।\nससीतः सह सौमित्रिः स त्वां कुशलमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000532024, "chapter_id": 9532, "verse_number": "६-१२५-२४", "content_sanskrit": "पञ्चमीमद्य रजनीमुषित्वा वचनान्मुनेः।\nभरद्वाजाभ्यनुज्ञातं द्रक्ष्यस्यत्रैव राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000532025, "chapter_id": 9532, "verse_number": "६-१२५-२५", "content_sanskrit": "एवमुक्त्वा महातेजाः सम्प्रहृष्टतनूरुहः।\nउत्पपात महावेगाद् वेगवानविचारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000532026, "chapter_id": 9532, "verse_number": "६-१२५-२६", "content_sanskrit": "सोऽपश्यद् रामतीर्थं च नदीं वालुकिनीं तथा।\nवरूथीं गोमतीं चैव भीमं शालवनं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000532027, "chapter_id": 9532, "verse_number": "६-१२५-२७", "content_sanskrit": "प्रजाश्च बहुसाहस्रीः स्फीताञ्जनपदानपि।\nस गत्वा दूरमध्वानं त्वरितः कपिकुञ्जरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000532028, "chapter_id": 9532, "verse_number": "६-१२५-२८", "content_sanskrit": "आससाद द्रुमान् फुल्लान् नन्दिग्रामसमीपगान्।\nसुराधिपस्योपवने यथा चैत्ररथे द्रुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000532029, "chapter_id": 9532, "verse_number": "६-१२५-२९", "content_sanskrit": "स्त्रीभिः सपुत्रैः पौत्रैश्च रममाणैः स्वलंकृतैः।\nक्रोशमात्रे त्वयोध्यायाश्चीरकृष्णाजिनाम्बरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000532030, "chapter_id": 9532, "verse_number": "६-१२५-३०", "content_sanskrit": "ददर्श भरतं दीनं कृशमाश्रमवासिनम्।\nजटिलं मलदिग्धाङ्गं भ्रातृव्यसनकर्शितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000532031, "chapter_id": 9532, "verse_number": "६-१२५-३१", "content_sanskrit": "फलमूलाशिनं दान्तं तापसं धर्मचारिणम्।\nसमुन्नतजटाभारं वल्कलाजिनवाससम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000532032, "chapter_id": 9532, "verse_number": "६-१२५-३२", "content_sanskrit": "नियतं भावितात्मानं ब्रह्मर्षिसमतेजसम्।\nपादुके ते पुरस्कृत्य प्रशासन्तं वसुंधराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000532033, "chapter_id": 9532, "verse_number": "६-१२५-३३", "content_sanskrit": "चातुर्वर्ण्यस्य लोकस्य त्रातारं सर्वतो भयात्।\nउपस्थितममात्यैश्च शुचिभिश्च पुरोहितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000532034, "chapter_id": 9532, "verse_number": "६-१२५-३४", "content_sanskrit": "बलमुख्यैश्च युक्तैश्च काषायाम्बरधारिभिः।\nनहि ते राजपुत्रं तं चीरकृष्णाजिनाम्बरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000532035, "chapter_id": 9532, "verse_number": "६-१२५-३५", "content_sanskrit": "परिभोक्तुं व्यवस्यन्ति पौरा वै धर्मवत्सलाः।\nतं धर्ममिव धर्मज्ञं देहबन्धमिवापरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000532036, "chapter_id": 9532, "verse_number": "६-१२५-३६", "content_sanskrit": "उवाच प्राञ्जलिर्वाक्यं हनूमान् मारुतात्मजः।\nवसन्तं दण्डकारण्ये यं त्वं चीरजटाधरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000532037, "chapter_id": 9532, "verse_number": "६-१२५-३७", "content_sanskrit": "अनुशोचसि काकुत्स्थं स त्वां कौशलमब्रवीत्।\nप्रियमाख्यामि ते देव शोकं त्यज सुदारुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000532038, "chapter_id": 9532, "verse_number": "६-१२५-३८", "content_sanskrit": "अस्मिन् मुहूर्ते भ्रात्रा त्वं रामेण सह संगतः।\nनिहत्य रावणं रामः प्रतिलभ्य च मैथिलीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000532039, "chapter_id": 9532, "verse_number": "६-१२५-३९", "content_sanskrit": "उपयाति समृद्धार्थः सह मित्रैर्महाबलैः।\nलक्ष्मणश्च महातेजा वैदेही च यशस्विनी।\nसीता समग्रा रामेण महेन्द्रेण शची यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000532040, "chapter_id": 9532, "verse_number": "६-१२५-४०", "content_sanskrit": "एवमुक्तो हनुमता भरतः कैकयीसुतः।\nपपात सहसा हृष्टो हर्षान्मोहमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000532041, "chapter_id": 9532, "verse_number": "६-१२५-४१", "content_sanskrit": "ततो मुहूर्तादुत्थाय प्रत्याश्वस्य च राघवः।\nहनूमन्तमुवाचेदं भरतः प्रियवादिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000532042, "chapter_id": 9532, "verse_number": "६-१२५-४२", "content_sanskrit": "अशोकजैः प्रीतिमयैः कपिमालिङ्ग्य सम्भ्रमात्।\nसिषेच भरतः श्रीमान् विपुलैरश्रुबिन्दुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000532043, "chapter_id": 9532, "verse_number": "६-१२५-४३", "content_sanskrit": "देवो वा मानुषो वा त्वमनुक्रोशादिहागतः।\nप्रियाख्यानस्य ते सौम्य ददामि ब्रुवतः प्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000532044, "chapter_id": 9532, "verse_number": "६-१२५-४४", "content_sanskrit": "गवां शतसहस्रं च ग्रामाणां च शतं परम्।\nसकुण्डलाः शुभाचारा भार्याः कन्यास्तु षोडश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000532045, "chapter_id": 9532, "verse_number": "६-१२५-४५", "content_sanskrit": "हेमवर्णाः सुनासोरूः शशिसौम्याननाः स्त्रियः।\nसर्वाभरणसम्पन्नाः सम्पन्नाः कुलजातिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000532046, "chapter_id": 9532, "verse_number": "६-१२५-४६", "content_sanskrit": "निशम्य रामागमनं नृपात्मजः\nकपिप्रवीरस्य तदाद्भुतोपमम्।\nप्रहर्षितो रामदिदृक्षयाभवत्\nपुनश्च हर्षादिदमब्रवीद् वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000532047, "chapter_id": 9532, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे पञ्चविंशत्यधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]