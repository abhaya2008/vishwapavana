[{"id": 7000558000, "chapter_id": 20558, "verse_number": "५-१७-१", "content_sanskrit": "शेष उवाच ।\nशत्रुघ्नश्च्यवनस्याथ दृष्ट्वाऽचिंत्यं तपोबलम् ।\nप्रशशंस तपो ब्राह्मं सर्वलोकैकवंदितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000558001, "chapter_id": 20558, "verse_number": "५-१७-२", "content_sanskrit": "अहो पश्यत योगस्य सिद्धिं ब्राह्मणसत्तमे ।\nयः क्षणादेव दुष्प्रापं तद्विमानमचीकरत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000558002, "chapter_id": 20558, "verse_number": "५-१७-३", "content_sanskrit": "क्व भोगसिद्धिर्महती मुनीनाममलात्मनाम् ।\nक्व तपोबलहीनानां भोगेच्छा मनुजात्मनाम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000558003, "chapter_id": 20558, "verse_number": "५-१७-४", "content_sanskrit": "इति स्वगतमाशंसञ्छत्रुघ्नश्च्यवनाश्रमे ।\nक्षणं स्थित्वा जलं पीत्वा सुखसंभोगमाप्तवान् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000558004, "chapter_id": 20558, "verse_number": "५-१७-५", "content_sanskrit": "हयस्तस्याः पयोष्ण्याख्या नद्याः पुण्यजलात्मनः ।\nपयः पीत्वा ययौ मार्गे वायुवेगगतिर्महान् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000558005, "chapter_id": 20558, "verse_number": "५-१७-६", "content_sanskrit": "योधास्तन्निर्गमं दृष्ट्वा पृष्ठतोऽनुययुस्तदा ।\nहस्तिभिः पत्तिभिः केचिद्रथैः केचन वाजिभिः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000558006, "chapter_id": 20558, "verse_number": "५-१७-७", "content_sanskrit": "शत्रुघ्नोऽमात्यवर्येण सुमत्याख्येन संयुतः ।\nपृष्ठतोऽनुजगामाशु रथेन हयशोभिना ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000558007, "chapter_id": 20558, "verse_number": "५-१७-८", "content_sanskrit": "गच्छन्वाजीपुरं प्राप्तो विमलाख्यस्य भूपतेः ।\nरत्नातटाख्यं च जनैर्हृष्टपुष्टैः समाकुलम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000558008, "chapter_id": 20558, "verse_number": "५-१७-९", "content_sanskrit": "स सेवकादुपश्रुत्य रघुनाथ हयोत्तमम् ।\nपुरोंतिके हि संप्राप्तं सर्वयोधसमन्वितम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000558009, "chapter_id": 20558, "verse_number": "५-१७-१०", "content_sanskrit": "तदा गजानां सप्तत्या चंद्रवर्णसमानया ।\nअश्वानामयुतैः सार्धं रथानां कांचनत्विषाम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000558010, "chapter_id": 20558, "verse_number": "५-१७-११", "content_sanskrit": "सहस्रेण च संयुक्तः शत्रुघ्नं प्रति जग्मिवान् ।\nशत्रुघ्नं स नमस्कृत्य सर्वान्प्राप्तान्महारथान् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000558011, "chapter_id": 20558, "verse_number": "५-१७-१२", "content_sanskrit": "वसुकोशं धनं सर्वं राज्यं तस्मै निवेद्य च ।\nकिं करोमीति राजा तं जगाद पुरतः स्थितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000558012, "chapter_id": 20558, "verse_number": "५-१७-१३", "content_sanskrit": "राजापि तं स्वीयपदे प्रणम्रं ।\nदोर्भ्यां दृढं संपरिषस्वजे महान् ।\nजगाम साकं तनये स्वराज्यं ।\nनिक्षिप्य सर्वं बहुधन्विभिर्वृतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000558013, "chapter_id": 20558, "verse_number": "५-१७-१४", "content_sanskrit": "रामचंद्राभिधां श्रुत्वा सर्वश्रुतिमनोहराम् ।\nसर्वे प्रणम्य तं वाहं ददुर्वसुमहाधनम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000558014, "chapter_id": 20558, "verse_number": "५-१७-१५", "content_sanskrit": "राजानं पूजयित्वा तु शत्रुघ्नः परया मुदा ।\nसेनया सहितोऽगच्छद्वाजिनः पृष्ठतस्तदा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000558015, "chapter_id": 20558, "verse_number": "५-१७-१६", "content_sanskrit": "एवं स गच्छंस्तन्मार्गे पर्वताग्र्यं ददर्श ह ।\nस्फाटिकैः कानकै रौप्यै राजितं प्रस्थराजिभिः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000558016, "chapter_id": 20558, "verse_number": "५-१७-१७", "content_sanskrit": "जलनिर्झरसंह्रादं नानाधातुकभूतलम् ।\nगैरिकादिकसद्धातु लाक्षारंगविराजितम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000558017, "chapter_id": 20558, "verse_number": "५-१७-१८", "content_sanskrit": "यत्र सिद्धांगनाः सिद्धैः संक्रीडंत्यकुतोभयाः ।\nगंधर्वाप्सरसो नागा यत्र क्रीडंति लीलया ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000558018, "chapter_id": 20558, "verse_number": "५-१७-१९", "content_sanskrit": "गंगातरंगसंस्पर्श शीतवायुनिषेवितम् ।\nवीणारणद्धंसशुकक्वणसुंदरशोभितम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000558019, "chapter_id": 20558, "verse_number": "५-१७-२०", "content_sanskrit": "पर्वतं वीक्ष्य शत्रुघ्न उवाच सुमतिं त्विदम् ।\nतद्दर्शनसमुद्भूत विस्मयाविष्टमानसः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000558020, "chapter_id": 20558, "verse_number": "५-१७-२१", "content_sanskrit": "कोऽयं महागिरिवरो विस्मापयति मे मनः ।\nमहारजतसत्प्रस्थो मार्गे राजति मेऽद्भुतः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000558021, "chapter_id": 20558, "verse_number": "५-१७-२२", "content_sanskrit": "अत्र किं देवतावासो देवानां क्रीडनस्थलम् ।\nयदेतन्मनसः क्षोभं करोति श्रीसमुच्चयैः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000558022, "chapter_id": 20558, "verse_number": "५-१७-२३", "content_sanskrit": "इति वाक्यं समाकर्ण्य जगाद सुमतिस्तदा ।\nवक्ष्यमाणगुणागार रामचंद्र पदाब्जधीः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000558023, "chapter_id": 20558, "verse_number": "५-१७-२४", "content_sanskrit": "नीलोऽयं पर्वतो राजन्पुरतो भाति भूमिप ।\nमनोहरैर्महाशृङ्गैः स्फाटिकाग्रैः समंततः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000558024, "chapter_id": 20558, "verse_number": "५-१७-२५", "content_sanskrit": "एनं पश्यंति नो पापाः परदाररता नराः ।\nविष्णोर्गुणगणान्ये वै न मन्यंते नराधमाः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000558025, "chapter_id": 20558, "verse_number": "५-१७-२६", "content_sanskrit": "श्रुतिस्मृतिसमुत्थं ये धर्मं सद्भिः सुसाधितम् ।\nन मन्यंते स्वबुद्धिस्थ हेतुवादविचारणाः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000558026, "chapter_id": 20558, "verse_number": "५-१७-२७", "content_sanskrit": "नीलीविक्रयकर्तारो लाक्षाविक्रयकारकाः ।\nयो ब्राह्मणो घृतादीनि विक्रीणाति सुरापकः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000558027, "chapter_id": 20558, "verse_number": "५-१७-२८", "content_sanskrit": "कन्यां रूपेण संपन्नां न दद्यात्कुलशीलिने ।\nविक्रीणाति द्रव्यलोभात्पिता पापेन मोहितः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000558028, "chapter_id": 20558, "verse_number": "५-१७-२९", "content_sanskrit": "पत्नीं दूषयते यस्तु कुलशीलवतीं नरः ।\nस्वयमेवात्ति मधुरं बंधुभ्यो न ददाति यः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000558029, "chapter_id": 20558, "verse_number": "५-१७-३०", "content_sanskrit": "भोजने ब्राह्मणार्थे च पाकभेदं करोति यः ।\nकृसरं पायसं वापि नार्थिनं दापयेत्कुधीः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000558030, "chapter_id": 20558, "verse_number": "५-१७-३१", "content_sanskrit": "अतिथीनवमन्यंते सूर्यतापादितापितान् ।\nअंतरिक्षभुजो ये च ये च विश्वासघातकाः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000558031, "chapter_id": 20558, "verse_number": "५-१७-३२", "content_sanskrit": "न पश्यंति महाराज रघुनाथ पराङ्मुखाः ।\nअसौ पुण्यो गिरिवरः पुरुषोत्तम शोभितः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000558032, "chapter_id": 20558, "verse_number": "५-१७-३३", "content_sanskrit": "पवित्रयति सर्वान्नो दर्शनेन मनोहरः ।\nअत्र तिष्ठति देवानां मुकुटैरर्चितांघ्रिकः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000558033, "chapter_id": 20558, "verse_number": "५-१७-३४", "content_sanskrit": "पुण्यवद्भिर्दर्शनार्हः पुण्यदः पुरुषोत्तमः ।\nश्रुतयो नेतिनेतीति ब्रुवाणा न विदंति यम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000558034, "chapter_id": 20558, "verse_number": "५-१७-३५", "content_sanskrit": "यत्पादरज इंद्रादिदेवैर्मृग्यं सुदुर्ल्लभम् ।\nवेदांतादिभिरन्यूनैर्वाक्यैर्विदंति यं बुधाः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000558035, "chapter_id": 20558, "verse_number": "५-१७-३६", "content_sanskrit": "सोऽत्र श्रीमान्नीलशैले वसते पुरुषोत्तमः ।\nआरुह्य तं नमस्कृत्य संपूज्य सुकृतादिना ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000558036, "chapter_id": 20558, "verse_number": "५-१७-३७", "content_sanskrit": "नैवेद्यं भक्षयित्वा वै भूप भूयाच्चतुर्भुजः ।\nअत्राप्युदाहरंतीममितिहासं पुरातनम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000558037, "chapter_id": 20558, "verse_number": "५-१७-३८", "content_sanskrit": "तं शृणुष्व महाराज सर्वाश्चर्यसमन्वितम् ।\nरत्नग्रीवस्य नृपतेर्यद्वृत्तं सकुटुंबिनः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000558038, "chapter_id": 20558, "verse_number": "५-१७-३९", "content_sanskrit": "चतुर्भुजादिकं प्राप्तं देवदानवदुर्लभम् ।\nआसीत्कांची महाराज पुरी लोकेषु विश्रुता ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000558039, "chapter_id": 20558, "verse_number": "५-१७-४०", "content_sanskrit": "महाजनपरीवारसमृद्धबलवाहना ।\nयस्यां वसंति विप्राग्र्याः षट्कर्मनिरता भृशम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000558040, "chapter_id": 20558, "verse_number": "५-१७-४१", "content_sanskrit": "सर्वभूतहिते युक्ता रामभक्तिषु लालसाः ।\nक्षत्रिया रणकर्तारः संग्रामेऽप्यपलायिनः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000558041, "chapter_id": 20558, "verse_number": "५-१७-४२", "content_sanskrit": "परदार परद्रव्य परद्रोहपराङ्मुखाः ।\nवैश्याः कुसीदकृष्यादिवाणिज्यशुभवृत्तयः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000558042, "chapter_id": 20558, "verse_number": "५-१७-४३", "content_sanskrit": "कुर्वन्ति रघुनाथस्य पदाम्भोजे रतिं सदा ।\nशूद्रा ब्राह्मणसेवाभिर्गतरात्रिदिनान्तराः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000558043, "chapter_id": 20558, "verse_number": "५-१७-४४", "content_sanskrit": "कुर्वंति कथनं रामरामेति रसनाग्रतः ।\nप्राकृताः केऽपि नो पापं कुर्वंति मनसात्र वै ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000558044, "chapter_id": 20558, "verse_number": "५-१७-४५", "content_sanskrit": "दानं दया दमः सत्यं तत्र तिष्ठंति नित्यशः ।\nवदते न पराबाधं वाक्यं कोऽपि नरोऽनघः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000558045, "chapter_id": 20558, "verse_number": "५-१७-४६", "content_sanskrit": "न पारक्ये धने लोभं कुर्वंति न हि पातकम् ।\nएवं प्रजा महाराज रत्नग्रीवेण पाल्यते ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000558046, "chapter_id": 20558, "verse_number": "५-१७-४७", "content_sanskrit": "षष्ठांशं तत्र गृह्णाति नान्यं लोभविवर्जितः ।\nएवं पालयमानस्य प्रजाधर्मेण भूपतेः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000558047, "chapter_id": 20558, "verse_number": "५-१७-४८", "content_sanskrit": "गतानि बहुवर्षाणि सर्वभोगविलासिनः ।\nविशालाक्षीं महाराज एकदा ह्यूचिवानिदम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000558048, "chapter_id": 20558, "verse_number": "५-१७-४९", "content_sanskrit": "पतिव्रतां धर्मपत्नीं पतिव्रतपरायणाम् ।\nपुत्रा जाता विशालाक्षि प्रजारक्षा धुरंधराः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000558049, "chapter_id": 20558, "verse_number": "५-१७-५०", "content_sanskrit": "परीवारो महान्मह्यं वर्तते विगतज्वरः ।\nहस्तिनो मम शैलाभा वाजिनः पवनोपमाः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000558050, "chapter_id": 20558, "verse_number": "५-१७-५१", "content_sanskrit": "रथाश्च सुहयैर्युक्ता वर्तंते मम नित्यशः ।\nमहाविष्णुप्रसादेन किंचिन्न्यूनं ममास्ति न ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000558051, "chapter_id": 20558, "verse_number": "५-१७-५२", "content_sanskrit": "एवं मनोरथस्त्वेकस्तिष्ठते मानसे मम ।\nपरं तीर्थं मया नाद्य कृतं परमशोभने ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000558052, "chapter_id": 20558, "verse_number": "५-१७-५३", "content_sanskrit": "गर्भवासविरामाय क्षमं गोविंदशोभितम् ।\nवृद्धो जातोऽस्म्यहं तावद्वलीपलितदेहवान् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000558053, "chapter_id": 20558, "verse_number": "५-१७-५४", "content_sanskrit": "करिष्यामि मनोहारि तीर्थसेवनमादृतः ।\nयो नरो जन्मपर्यंतं स्वोदरस्य प्रपूरकः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000558054, "chapter_id": 20558, "verse_number": "५-१७-५५", "content_sanskrit": "न करोति हरेः पूजां स नरो गोवृषः स्मृतः ।\nतस्माद्गच्छामि भो भद्रे तीर्थयात्रां प्रति प्रिये ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000558055, "chapter_id": 20558, "verse_number": "५-१७-५६", "content_sanskrit": "सकुटुंबः सुते न्यस्य धुरं राज्यस्य निर्भृताम् ।\nइति व्यवस्य संध्यायां हरिं ध्यायन्निशांतरे ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000558056, "chapter_id": 20558, "verse_number": "५-१७-५७", "content_sanskrit": "अद्राक्षीत्स्वप्नमप्येकं ब्राह्मणं तापसं वरम् ।\nप्रातरुत्थाय राजासौ कृत्वा संध्यादिकाः क्रियाः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000558057, "chapter_id": 20558, "verse_number": "५-१७-५८", "content_sanskrit": "सभां मंत्रिजनैः सार्द्धं सुखमासेदिवान्महान् ।\nतावद्विप्रं ददर्शाथ तापसं कृशदेहिनम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000558058, "chapter_id": 20558, "verse_number": "५-१७-५९", "content_sanskrit": "जटावल्कलकौपीनधारिणं दंडपाणिनम् ।\nअनेकतीर्थसेवाभिः कृतपुण्यकलेवरम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000558059, "chapter_id": 20558, "verse_number": "५-१७-६०", "content_sanskrit": "राजा तं वीक्ष्य शिरसा प्रणनाम महाभुजः ।\nअर्घ्यपाद्यादिकं चक्रे प्रहृष्टात्मा महीपतिः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000558060, "chapter_id": 20558, "verse_number": "५-१७-६१", "content_sanskrit": "सुखोपविष्टं विश्रांतं पप्रच्छ विदितं द्विजम् ।\nस्वामिंस्त्वद्दर्शनान्मेऽद्य गतं देहस्य पातकम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000558061, "chapter_id": 20558, "verse_number": "५-१७-६२", "content_sanskrit": "महांतः कृपणान्पातुं यांति तद्गेहमादरात् ।\nतस्मात्कथय भो विप्र वृद्धस्य मम संप्रति ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000558062, "chapter_id": 20558, "verse_number": "५-१७-६३", "content_sanskrit": "को देवो गर्भनाशाय किं तीर्थं च क्षमं भवेत् ।\nयूयं सर्वगताः श्रेष्ठाः समाधिध्यानतत्पराः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000558063, "chapter_id": 20558, "verse_number": "५-१७-६४", "content_sanskrit": "सर्वतीर्थावगाहेन कृतपुण्यात्मनोऽमलाः ।\nयथावच्छृण्वते मह्यं श्रद्दधानाय विस्तरात् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000558064, "chapter_id": 20558, "verse_number": "५-१७-६५", "content_sanskrit": "कथयस्व प्रसादेन सर्वतीर्थविचक्षण ।\nब्राह्मण उवाच ।\nशृणु राजेंद्र वक्ष्यामि यत्पृष्टं तीर्थसेवनम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000558065, "chapter_id": 20558, "verse_number": "५-१७-६६", "content_sanskrit": "कस्य देवस्य कृपया गर्भनिर्वारणं भवेत् ।\nसेव्यः श्रीरामचंद्रोऽसौ संसारज्वरनाशकः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000558066, "chapter_id": 20558, "verse_number": "५-१७-६७", "content_sanskrit": "पूज्यः स एव भगवान्पुरुषोत्तमसंज्ञकः ।\nनाना पुर्यो मया दृष्टाः सर्वपापक्षयंकराः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000558067, "chapter_id": 20558, "verse_number": "५-१७-६८", "content_sanskrit": "अयोध्या सरयूस्तापी तथा द्वारं हरेः परम् ।\nअवंती विमला कांची रेवा सागरगामिनी ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000558068, "chapter_id": 20558, "verse_number": "५-१७-६९", "content_sanskrit": "गोकर्णं हाटकाख्यं च हत्याकोटिविनाशनम् ।\nमल्लिकाख्यो महाशैलो मोक्षदः पश्यतां नृणाम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000558069, "chapter_id": 20558, "verse_number": "५-१७-७०", "content_sanskrit": "यत्रांगेषु नृणां तोयं श्यामं वा निर्मलं भवेत् ।\nपातकस्यापहारीदं मया दृष्टं तु तीर्थकम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000558070, "chapter_id": 20558, "verse_number": "५-१७-७१", "content_sanskrit": "मया द्वारवती दृष्टा सुरासुर निषेविता ।\nगोमती यत्र वहति साक्षाद्ब्रह्मजला शुभा ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000558071, "chapter_id": 20558, "verse_number": "५-१७-७२", "content_sanskrit": "यत्र स्वापो लयः प्रोक्तो मृतिर्मोक्ष इति श्रुतिः ।\nयस्यां संवसतां नॄणां न कलि प्रभवेत्क्वचित् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000558072, "chapter_id": 20558, "verse_number": "५-१७-७३", "content_sanskrit": "चक्रांका यत्र पाषाणा मानवा अपि चक्रिणः ।\nपशवः कीटपक्ष्याद्याः सर्वे चक्रशरीरिणः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000558073, "chapter_id": 20558, "verse_number": "५-१७-७४", "content_sanskrit": "त्रिविक्रमो वसेद्यस्यां सर्वलोकैकपालकः ।\nसा पुरी तु महापुण्यैर्मया दृग्गोचरीकृता ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000558074, "chapter_id": 20558, "verse_number": "५-१७-७५", "content_sanskrit": "कुरुक्षेत्रं मया दृष्टं सर्वहत्यापनोदनम् ।\nस्यमंतपंचकं यत्र महापातकनाशनम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000558075, "chapter_id": 20558, "verse_number": "५-१७-७६", "content_sanskrit": "वाराणसी मया दृष्टा विश्वनाथकृतालया ।\nयत्रोपदिशते मंत्रं तारकं ब्रह्मसंज्ञितम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000558076, "chapter_id": 20558, "verse_number": "५-१७-७७", "content_sanskrit": "यस्यां मृताः कीटपतंगभृंगाः ।\nपश्वादयो वा सुरयोनयो वा ।\nस्वकर्मसंभोगसुखं विहाय ।\nगच्छंति कैलासमतीतदुःखाः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000558077, "chapter_id": 20558, "verse_number": "५-१७-७८", "content_sanskrit": "मणिकर्णिर्यत्र तीर्थं यस्यामुत्तरवाहिनी ।\nकरोति संसृतेर्बंधच्छेदं पापकृतामपि ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000558078, "chapter_id": 20558, "verse_number": "५-१७-७९", "content_sanskrit": "कपर्दिनः कुंडलिनः सर्पभूषाधरावराः ।\nगजचर्मपरीधाना वसंति गतदुःखकाः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000558079, "chapter_id": 20558, "verse_number": "५-१७-८०", "content_sanskrit": "कालभैरवनामात्र करोति यमशासनम् ।\nन करोति नृणां वार्तां यमो दंडधरः प्रभुः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000558080, "chapter_id": 20558, "verse_number": "५-१७-८१", "content_sanskrit": "एतादृशी मया दृष्टा काशी विश्वेश्वरांकिता ।\nअनेकान्यपि तीर्थानि मया दृष्टानि भूमिप ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000558081, "chapter_id": 20558, "verse_number": "५-१७-८२", "content_sanskrit": "परमेकं महच्चित्रं यद्दृष्टं नीलपर्वते ।\nपुरुषोत्तमसान्निध्ये तन्न क्वाप्यक्षिगोचरम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}]