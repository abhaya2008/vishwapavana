[{"id": 6000056000, "chapter_id": 10056, "verse_number": null, "content_sanskrit": "अथ षड्विंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000056001, "chapter_id": 10056, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.001.m4a", "display_order": 2}, {"id": 6000056002, "chapter_id": 10056, "verse_number": "३-२६-१", "content_sanskrit": "कपिलस्तत्त्वसंख्याता भगवानात्ममायया।\nजातः स्वयमजः साक्षादात्मप्रज्ञप्तये नृणाम्॥ ३/२६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.002.m4a", "display_order": 3, "topics": [{"text": "देवहूत्या कपिलं प्रति जीवानां बन्धमोक्षोपायकथनप्रार्थना", "range": "१–११"}]}, {"id": 6000056003, "chapter_id": 10056, "verse_number": "३-२६-२", "content_sanskrit": "अर्हस्य धर्मिणां पुंसां गरिम्णः सर्वयोगिनाम्।\nविश्रुतौ श्रुतदेवस्य भूरि तृप्यन्ति मेऽसवः॥ ३/२६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.003.m4a", "display_order": 4}, {"id": 6000056004, "chapter_id": 10056, "verse_number": "३-२६-३", "content_sanskrit": "यद् यद् विधत्ते भगवान् स्वच्छन्दात्माऽऽत्ममायया।\nतानि मे श्रद्धधानस्य कीर्तन्यान्यनुकीर्तय॥ ३/२६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.004.m4a", "display_order": 5}, {"id": 6000056005, "chapter_id": 10056, "verse_number": null, "content_sanskrit": "शुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.005.m4a", "display_order": 6}, {"id": 6000056006, "chapter_id": 10056, "verse_number": "३-२६-४", "content_sanskrit": "द्वैपायनसखश्चैवं मैत्रेयो भगवांस्तथा।\nप्राहैनं विदुरं प्रीत आन्वीक्षिक्यां प्रचोदितः॥ ३/२६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.006.m4a", "display_order": 7}, {"id": 6000056007, "chapter_id": 10056, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.007.m4a", "display_order": 8}, {"id": 6000056008, "chapter_id": 10056, "verse_number": "३-२६-५", "content_sanskrit": "पितरि प्रस्थितेऽरण्यं मातुः प्रियचिकीर्षया।\nतस्मिन् बिन्दुसरेऽवात्सीद् भगवान् कपिलः किल॥ ३/२६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.008.m4a", "display_order": 9}, {"id": 6000056009, "chapter_id": 10056, "verse_number": "३-२६-६", "content_sanskrit": "तमासीनमकर्माणं तत्त्वमार्गाग्रदर्शनम्।\nस्वसुतं देवहूत्याह धातुः संस्मरती वचः॥ ३/२६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.009.m4a", "display_order": 10}, {"id": 6000056010, "chapter_id": 10056, "verse_number": null, "content_sanskrit": "देवहूतिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.010.m4a", "display_order": 11}, {"id": 6000056011, "chapter_id": 10056, "verse_number": "३-२६-७", "content_sanskrit": "निर्विण्णातितरां भूमन्नसदिन्द्रियतर्पणात्।\nयेन सम्भाव्यमानेन प्रपन्नाऽन्धतमः प्रभो॥ ३/२६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.011.m4a", "display_order": 12}, {"id": 6000056012, "chapter_id": 10056, "verse_number": "३-२६-८", "content_sanskrit": "तस्य त्वं तमसोऽन्धस्य दुष्पारस्याद्य पारगम्।\nसच्चक्षुर्जन्मनामन्ते लब्धं मे त्वदनुग्रहात्॥ ३/२६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.012.m4a", "display_order": 13}, {"id": 6000056013, "chapter_id": 10056, "verse_number": "३-२६-९", "content_sanskrit": "य आद्यो भगवान् पुंसामीश्वरो वै भवान् किल।\nलोकस्य तमसाऽन्धस्य चक्षुः सूर्य इवोदितः॥ ३/२६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.013.m4a", "display_order": 14}, {"id": 6000056014, "chapter_id": 10056, "verse_number": "३-२६-१०", "content_sanskrit": "अथ मे देव संमोहमपाक्रष्टुं त्वमर्हसि।\nयोऽवग्रहोऽहंममेतीत्येतस्मिन् योजितस्त्वया॥ ३/२६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.014.m4a", "display_order": 15}, {"id": 6000056015, "chapter_id": 10056, "verse_number": "३-२६-११", "content_sanskrit": "तं त्वा गताऽहं शरणं शरण्यं स्वभृत्यसंसारतरोः कुठारम्।\nजिज्ञासया प्रकृतेः पूरुषस्य नमामि सद्धर्मविदां वरिष्ठम्॥ ३/२६/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.015.m4a", "display_order": 16}, {"id": 6000056016, "chapter_id": 10056, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.016.m4a", "display_order": 17}, {"id": 6000056017, "chapter_id": 10056, "verse_number": "३-२६-१२", "content_sanskrit": "इति स्वमातुर्निरवद्यमीप्सितं निशम्य पुंसामपवर्गचोदनम्।\nधियाऽभिनन्द्यात्मवतां सतां गतिर्बभाष ईषत् स्मितशोभिताननः॥ ३/२६/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.017.m4a", "display_order": 18, "topics": [{"text": "कपिलेन भक्तियोगस्य तदुपायत्वकथने तया तं प्रति भक्तियोगनिरूपणप्रार्थना", "range": "१२–३०"}]}, {"id": 6000056018, "chapter_id": 10056, "verse_number": null, "content_sanskrit": "भगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.018.m4a", "display_order": 19}, {"id": 6000056019, "chapter_id": 10056, "verse_number": "३-२६-१३", "content_sanskrit": "योग आध्यात्मिकः पुंसां मतो निःश्रेयसाय मे।\nअत्यन्तोपरतिर्यत्र दुःखस्य च सुखस्य वै॥ ३/२६/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.019.m4a", "display_order": 20}, {"id": 6000056020, "chapter_id": 10056, "verse_number": "३-२६-१४", "content_sanskrit": "तमिमं ते प्रवक्ष्यामि यमवोचं पुराऽनघे।\nऋषीणां श्रोतुकामानां योगमुर्वङ्गनैपुणम्॥ ३/२६/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.020.m4a", "display_order": 21}, {"id": 6000056021, "chapter_id": 10056, "verse_number": "३-२६-१५", "content_sanskrit": "चेतः खल्वस्य बन्धाय मुक्तये चात्मनो मतम्।\nगुणेषु सक्तं बन्धाय रतं वा पुंसि मुक्तये॥ ३/२६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.021.m4a", "display_order": 22}, {"id": 6000056022, "chapter_id": 10056, "verse_number": "३-२६-१६", "content_sanskrit": "अहंममाभिमानोत्थैः कामलोभादिभिर्मलैः।\nवीतं यदा मनः शुद्धमदुःखमसुखं समम्॥ ३/२६/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.022.m4a", "display_order": 23}, {"id": 6000056023, "chapter_id": 10056, "verse_number": "३-२६-१७", "content_sanskrit": "तदा पुरुष आत्मानं केवलं प्रकृतेः परम्।\nनिरन्तरं स्वयंज्योतिरणिमानमखण्डितम्॥ ३/२६/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.023.m4a", "display_order": 24}, {"id": 6000056024, "chapter_id": 10056, "verse_number": "३-२६-१८", "content_sanskrit": "ज्ञानवैराग्ययुक्तेन भक्तियोगेन चात्मना।\nपरिपश्यत्युदासीनां प्रकृतिं च हतौजसम्॥ ३/२६/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.024.m4a", "display_order": 25}, {"id": 6000056025, "chapter_id": 10056, "verse_number": "३-२६-१९", "content_sanskrit": "न युज्यमानया भक्त्या भगवत्यखिलात्मनि।\nसदृशोऽस्ति शिवः पन्था योगिनां ब्रह्मसिद्धये॥ ३/२६/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.025.m4a", "display_order": 26}, {"id": 6000056026, "chapter_id": 10056, "verse_number": "३-२६-२०", "content_sanskrit": "प्रसङ्गमजरं पाशमात्मनः कवयो विदुः।\nस एव साधुषु कृतो मोक्षद्वारमपावृतम्॥ ३/२६/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.026.m4a", "display_order": 27}, {"id": 6000056027, "chapter_id": 10056, "verse_number": "३-२६-२१", "content_sanskrit": "तितिक्षवः कारुणिकाः सुहृदः सर्वदेहिनाम्।\nअजातशत्रवः शान्ताः साधवः साधुभूषणाः॥ ३/२६/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.027.m4a", "display_order": 28}, {"id": 6000056028, "chapter_id": 10056, "verse_number": "३-२६-२२", "content_sanskrit": "मय्यनन्येन भावेन भक्तिं कुर्वन्ति ये दृढाम्।\nमत्कृते त्यक्तकर्माणस्त्यक्तस्वजनबान्धवाः॥ ३/२६/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.028.m4a", "display_order": 29}, {"id": 6000056029, "chapter_id": 10056, "verse_number": "३-२६-२३", "content_sanskrit": "मदाश्रयाः कथा मृष्टाः शृण्वन्ति कथयन्ति च।\nतपन्ति विविधांस्तापान् ऐकात्म्यगतचेतसः॥ ३/२६/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.029.m4a", "display_order": 30}, {"id": 6000056030, "chapter_id": 10056, "verse_number": "३-२६-२४", "content_sanskrit": "त एते साधवः साध्वि सर्वसङ्गविवर्जिताः।\nसङ्गस्तेष्वथ ते प्रार्थ्यः सङ्गदोषहरा हि ते॥ ३/२६/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.030.m4a", "display_order": 31}, {"id": 6000056031, "chapter_id": 10056, "verse_number": "३-२६-२५", "content_sanskrit": "सतां प्रसङ्गान्मम वीर्यसम्पदो भवन्ति हृत्कर्णरसायनाः कथाः।\nतज्जोषणादाश्वपवर्गवर्त्मनि श्रद्धावती भक्तिरनुक्रमिष्यति॥ ३/२६/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.031.m4a", "display_order": 32}, {"id": 6000056032, "chapter_id": 10056, "verse_number": "३-२६-२६", "content_sanskrit": "भक्त्या पुमान् जातविराग ऐन्द्रियाद् दृष्टश्रुतात्मद्रविणानुचिन्तया।\nचित्तस्य यत्तो ग्रहणे योगयुक्तो यतिष्यते ऋजुभिर्योगमार्गैः॥ ३/२६/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.032.m4a", "display_order": 33}, {"id": 6000056033, "chapter_id": 10056, "verse_number": "३-२६-२७", "content_sanskrit": "असेवयाऽयं प्रकृतेर्गुणानां ज्ञानेन वैराग्यविजृम्भितेन।\nयोगेन मय्यर्पितया च भक्त्या मां प्रत्यगात्मानमिहावरुन्धे॥ ३/२६/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.033.m4a", "display_order": 34}, {"id": 6000056034, "chapter_id": 10056, "verse_number": null, "content_sanskrit": "देवहूतिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.034.m4a", "display_order": 35}, {"id": 6000056035, "chapter_id": 10056, "verse_number": "३-२६-२८", "content_sanskrit": "का स्वित् त्वय्यर्पिता भक्तिः कीदृशी मम गोचरा।\nयया पदं ते निर्वाणमञ्जसा प्राप्नुयामहम्॥ ३/२६/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.035.m4a", "display_order": 36}, {"id": 6000056036, "chapter_id": 10056, "verse_number": "३-२६-२९", "content_sanskrit": "यो योगो भगवत्प्राप्तौ निर्वाणात्मंस्त्वयोदितः।\nकीदृशः कति चाङ्गानि यतस्तत्त्वावबोधनम्॥ ३/२६/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.036.m4a", "display_order": 37}, {"id": 6000056037, "chapter_id": 10056, "verse_number": "३-२६-३०", "content_sanskrit": "तदेतन्मे विजानीहि यथाऽहं मन्दधीर्हरे।\nसुखं बुध्येय दुर्बोधं योषा भवदनुग्रहात्॥ ३/२६/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.037.m4a", "display_order": 38}, {"id": 6000056038, "chapter_id": 10056, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.038.m4a", "display_order": 39}, {"id": 6000056039, "chapter_id": 10056, "verse_number": "३-२६-३१", "content_sanskrit": "विदित्वाऽर्थं कपिलो मातुरित्थं जातस्नेहो यत्र तन्वाऽभिजातः।\nतत्त्वाम्नायं यत् प्रवदन्ति साङ्ख्यं प्रावोचद् वै भक्तिवितानयोगम्॥ ३/२६/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.039.m4a", "display_order": 40, "topics": [{"text": "कपिलेन तां प्रति स्वमहिमानुवर्णनपूर्वकं भक्तियोगप्रशंसनम्", "range": "३१–४४"}]}, {"id": 6000056040, "chapter_id": 10056, "verse_number": null, "content_sanskrit": "भगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.040.m4a", "display_order": 41}, {"id": 6000056041, "chapter_id": 10056, "verse_number": "३-२६-३२", "content_sanskrit": "देवानां गुणलिङ्गानाम् आनुश्राविककर्मणाम्।\nसत्त्व एवैकमनसो वृत्तिः स्वाभाविकी तु या॥ ३/२६/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.041.m4a", "display_order": 42}, {"id": 6000056042, "chapter_id": 10056, "verse_number": "३-२६-३३", "content_sanskrit": "अनिमित्ता भगवति भक्तिः सिद्धेर्गरीयसी।\nजरयत्याशु या कोशं निगीर्णमनलो यथा॥ ३/२६/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.042.m4a", "display_order": 43}, {"id": 6000056043, "chapter_id": 10056, "verse_number": "३-२६-३४", "content_sanskrit": "नैकात्म्यतां मे स्पृहयन्ति केचिन्मत्पादसेवाभिरता मदीहाः।\nयेऽन्योन्यतो भागवताः प्रसज्य सम्भाजयन्ते मम पौरुषाणि॥ ३/२६/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.043.m4a", "display_order": 44}, {"id": 6000056044, "chapter_id": 10056, "verse_number": "३-२६-३५", "content_sanskrit": "पश्यन्ति मे ते रुचिराण्यम्ब सन्तः प्रसन्नवक्त्रारुणलोचनानि।\nरूपाणि दैत्यासुविनाशनानि साकं वाचं स्पृहणीयां वदन्ति॥ ३/२६/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.044.m4a", "display_order": 45}, {"id": 6000056045, "chapter_id": 10056, "verse_number": "३-२६-३६", "content_sanskrit": "तैर्दर्शनीयावयवैरुदारविलासहासेक्षितवामसूक्तैः।\nहृतात्मनो हृतप्राणस्य भक्तिमन्विच्छतो गतिमण्वीं प्रयुञ्जे॥ ३/२६/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.045.m4a", "display_order": 46}, {"id": 6000056046, "chapter_id": 10056, "verse_number": "३-२६-३७", "content_sanskrit": "अथो विभूतिं मम मायया चितामैश्वर्यमष्टाङ्गमनुप्रवृत्तम्।\nश्रियं न देवीं स्पृहयन्ति भद्रां परस्य मे तेऽश्नुवते हि लोके॥ ३/२६/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.046.m4a", "display_order": 47}, {"id": 6000056047, "chapter_id": 10056, "verse_number": "३-२६-३८", "content_sanskrit": "न कर्हिचिन्मत्पराः शान्तरूपा नङ्क्षन्ति मे नोऽनिमिषो लेढि हेतिः।\nयेषामहं प्रिय आत्मा सुतश्च सखा गुरुः सुहृदो दैवमिष्टम्॥ ३/२६/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.047.m4a", "display_order": 48}, {"id": 6000056048, "chapter_id": 10056, "verse_number": "३-२६-३९", "content_sanskrit": "इमं लोकं तथैवामुमात्मानमुभयायिनम्।\nआत्मानमनु ये चेमे ये रायः पशवो गृहाः॥ ३/२६/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.048.m4a", "display_order": 49}, {"id": 6000056049, "chapter_id": 10056, "verse_number": "३-२६-४०", "content_sanskrit": "विसृज्य सर्वानन्यांश्च मामेवं विश्वतोमुखम्।\nभजन्त्यनन्यया भक्त्या तान् मृत्योरतिपारये॥ ३/२६/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.049.m4a", "display_order": 50}, {"id": 6000056050, "chapter_id": 10056, "verse_number": "३-२६-४१", "content_sanskrit": "नान्यत्र मद् भगवतः प्रधानपुरुषेश्वरात्।\nआत्मनः सर्वभूतानां भयं तीव्रं निवर्तते॥ ३/२६/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.050.m4a", "display_order": 51}, {"id": 6000056051, "chapter_id": 10056, "verse_number": "३-२६-४२", "content_sanskrit": "मद्भयाद् वाति वातोऽयं सूर्यस्तपति मद्भयात्।\nवर्षतीन्द्रो दहत्यग्निर्मृत्युश्चरति मद्भयात्॥ ३/२६/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.051.m4a", "display_order": 52}, {"id": 6000056052, "chapter_id": 10056, "verse_number": "३-२६-४३", "content_sanskrit": "ज्ञानवैराग्ययुक्तेन भक्तियोगेन योगिनः।\nक्षेमाय पादमूलं मे प्रविशन्त्यकुतोभयम्॥ ३/२६/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.052.m4a", "display_order": 53}, {"id": 6000056053, "chapter_id": 10056, "verse_number": "३-२६-४४", "content_sanskrit": "एतावानेव लोकेऽस्मिन् पुंसां निःश्रेयसोदयः।\nतीव्रेण भक्तियोगेन मनो मय्यर्पितं स्थितम्॥ ३/२६/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_026/BhP_03.026.053.m4a", "display_order": 54}, {"id": 6000056054, "chapter_id": 10056, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां तृतीयस्कन्धे षड्विंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]