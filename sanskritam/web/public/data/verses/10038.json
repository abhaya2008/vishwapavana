[{"id": 6000038000, "chapter_id": 10038, "verse_number": null, "content_sanskrit": "अथ अष्टमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000038001, "chapter_id": 10038, "verse_number": "३-८-१", "content_sanskrit": "एवं ब्रुवाणं मैत्रेयं द्वैपायनसुतो बुधः।\nप्रीणयन्निव भारत्या विदुरः प्रत्यभाषत॥ ३/८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.001.m4a", "display_order": 2, "topics": [{"text": "विदुरेण मैत्रेयं प्रति चतुर्मुखब्रह्मकर्तृकप्रजापति-मनु-मन्वन्तरादिसृष्ट्यादिविषयकप्रश्नाः", "range": "१–७"}]}, {"id": 6000038002, "chapter_id": 10038, "verse_number": null, "content_sanskrit": "विदुर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.002.m4a", "display_order": 3}, {"id": 6000038003, "chapter_id": 10038, "verse_number": "३-८-२", "content_sanskrit": "ब्रह्मन् कथं भगवतश्चिन्मात्रस्याविकारिणः।\nलीलया चापि युज्येरन् निर्गुणस्य गुणाः क्रियाः॥ ३/८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.003.m4a", "display_order": 4}, {"id": 6000038004, "chapter_id": 10038, "verse_number": "३-८-३", "content_sanskrit": "क्रीडाया मुद् यतोऽर्हस्य कामं चिक्रीडिषाऽन्यतः।\nस्वतस्तृप्तस्य तु कथं निर्वृतस्य सदाऽऽत्मनः॥ ३/८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.004.m4a", "display_order": 5}, {"id": 6000038005, "chapter_id": 10038, "verse_number": "३-८-४", "content_sanskrit": "अस्राक्षीद् भगवान् विश्वं गुणमय्याऽऽत्ममायया।\nतथा संस्थापयत्येतद् भूयः प्रत्यभिधास्यति॥ ३/८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.005.m4a", "display_order": 6}, {"id": 6000038006, "chapter_id": 10038, "verse_number": "३-८-५", "content_sanskrit": "देशतः कालतो योऽसाववस्थातः स्वतोऽन्यतः।\nअविलुप्तावबोधात्मा स युज्येताजया कथम्॥ ३/८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.006.m4a", "display_order": 7}, {"id": 6000038007, "chapter_id": 10038, "verse_number": "३-८-६", "content_sanskrit": "भगवानेष एवैकः सर्वक्षेत्रेष्ववस्थितः।\nअमुष्य दुर्भगत्वं वा क्लेशो वा कर्मभिः कुतः॥ ३/८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.007.m4a", "display_order": 8}, {"id": 6000038008, "chapter_id": 10038, "verse_number": "३-८-७", "content_sanskrit": "एतस्मिन् मे मनो विद्वन् खिद्यतेऽज्ञानसंकटे।\nतन्नः पराणुद विभो कश्मलं मानसं महत्॥ ३/८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.008.m4a", "display_order": 9}, {"id": 6000038009, "chapter_id": 10038, "verse_number": null, "content_sanskrit": "शुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.009.m4a", "display_order": 10}, {"id": 6000038010, "chapter_id": 10038, "verse_number": "३-८-८", "content_sanskrit": "स इत्थं चोदितः क्षत्त्रा तत्त्वजिज्ञासुना मुनिः।\nप्रत्याह भगवच्चित्तः स्मयन्निव गतस्मयः॥ ३/८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.010.m4a", "display_order": 11, "topics": [{"text": "ईश्वरस्य कार्पण्य-बन्धनाद्यभावादिप्रतिपादने मैत्रेयोत्तराणि च", "range": "८–१४"}]}, {"id": 6000038011, "chapter_id": 10038, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.011.m4a", "display_order": 12}, {"id": 6000038012, "chapter_id": 10038, "verse_number": "३-८-९", "content_sanskrit": "सेयं भगवतो माया न्याय्यं येन विरुध्यते।\nईश्वरस्य विमुक्तस्य कार्पण्यमुत बन्धनम्॥ ३/८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.012.m4a", "display_order": 13}, {"id": 6000038013, "chapter_id": 10038, "verse_number": "३-८-१०", "content_sanskrit": "यथाऽर्थेन विनाऽमुष्य पुंस आत्मविपर्ययः।\nप्रतीयत उपद्रष्टुः स्वशिरश्छेदनादिकः॥ ३/८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.013.m4a", "display_order": 14}, {"id": 6000038014, "chapter_id": 10038, "verse_number": "३-८-११", "content_sanskrit": "यथा जले चन्द्रमसः कम्पादिस्तत्कृतो गुणः।\nदृश्यतेऽसन्नपि द्रष्टुरात्मनोऽनात्मनो गुणः॥ ३/८/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.014.m4a", "display_order": 15}, {"id": 6000038015, "chapter_id": 10038, "verse_number": "३-८-१२", "content_sanskrit": "स वै निवृत्तिधर्मेण वासुदेवानुकम्पया।\nभगवद्भक्तियोगेन तिरोधत्ते शनैरिह॥ ३/८/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.015.m4a", "display_order": 16}, {"id": 6000038016, "chapter_id": 10038, "verse_number": "३-८-१३", "content_sanskrit": "यदेन्द्रियोपरामार्थो दृष्टात्मनि परे हरौ।\nविलीयन्ते तदा क्लेशाः संसुप्तस्येव कृत्स्नशः॥ ३/८/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.016.m4a", "display_order": 17}, {"id": 6000038017, "chapter_id": 10038, "verse_number": "३-८-१४", "content_sanskrit": "अशेषसंक्लेशशमं विधत्ते गुणानुवादश्रवणं मुरारेः।\nकिं वा पुनस्तच्चरणारविन्दपरागसेवारतिरात्मलब्धा॥ ३/८/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.017.m4a", "display_order": 18}, {"id": 6000038018, "chapter_id": 10038, "verse_number": null, "content_sanskrit": "विदुर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.018.m4a", "display_order": 19}, {"id": 6000038019, "chapter_id": 10038, "verse_number": "३-८-१५", "content_sanskrit": "संछिन्नः संशयो मह्यं तव सूक्तासिना विभो।\nउभयत्रापि भगवन्मनो मे संप्रधावति॥ ३/८/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.019.m4a", "display_order": 20, "topics": [{"text": "सृष्ट्यादि भगवद्व्यापारविषये विस्तरण प्रश्नः", "range": "१५–४१"}]}, {"id": 6000038020, "chapter_id": 10038, "verse_number": "३-८-१६", "content_sanskrit": "साधु तद् व्याहृतं विद्वन्नात्ममायायनं हरेः।\nआभात्यपार्थं निर्मूलं विश्वमूलं न यद् बहिः॥ ३/८/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.020.m4a", "display_order": 21}, {"id": 6000038021, "chapter_id": 10038, "verse_number": "३-८-१७", "content_sanskrit": "यश्च मूढतमो लोके यश्च बुद्धेः परं गतः।\nतावुभौ सुखमेधेते क्लिश्यत्यन्तरितो जनः॥ ३/८/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.021.m4a", "display_order": 22}, {"id": 6000038022, "chapter_id": 10038, "verse_number": "३-८-१८", "content_sanskrit": "अर्थाभावं विनिश्चित्य प्रतीतस्याप्यनात्मनः।\nतां चापि युष्मच्चरणसेवयाऽहं पराणुदे॥ ३/८/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.022.m4a", "display_order": 23}, {"id": 6000038023, "chapter_id": 10038, "verse_number": "३-८-१९", "content_sanskrit": "यत्सेवया भगवतः कूटस्थस्य मधुद्विषः।\nरतिरासो भवेत् तीव्रः पादयोर्व्यसनार्दनः॥ ३/८/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.023.m4a", "display_order": 24}, {"id": 6000038024, "chapter_id": 10038, "verse_number": "३-८-२०", "content_sanskrit": "दुरापा ह्यल्पतपसः सेवा वैकुण्ठवर्त्मसु।\nयत्रोपगीयते नित्यं देवदेवो जनार्दनः॥ ३/८/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.024.m4a", "display_order": 25}, {"id": 6000038025, "chapter_id": 10038, "verse_number": "३-८-२१", "content_sanskrit": "सृष्ट्वाऽग्रे महदादीनि सविकाराण्यनुक्रमात्।\nतेभ्यो विराजमुद्धृत्य तमनु प्राविशद् विभुः॥ ३/८/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.025.m4a", "display_order": 26}, {"id": 6000038026, "chapter_id": 10038, "verse_number": "३-८-२२", "content_sanskrit": "यमाहुराद्यं पुरुषं सहस्राङ्घ्र्यूरुबाहुकम्।\nयत्र विश्व इमे लोकाः सविकाशं समासते॥ ३/८/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.026.m4a", "display_order": 27}, {"id": 6000038027, "chapter_id": 10038, "verse_number": "३-८-२३", "content_sanskrit": "यस्मिन् दशविधः प्राणः सेन्द्रियार्थेन्द्रियस्‍त्रिवृत्।\nत्वयेरिता यतो वर्णास्तद्विभूतीर्वदस्व नः॥ ३/८/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.027.m4a", "display_order": 28}, {"id": 6000038028, "chapter_id": 10038, "verse_number": "३-८-२४", "content_sanskrit": "यत्र पुत्रैश्च पौत्रैश्च नप्तृभिः सह गोत्रजैः।\nप्रजा विचित्राकृतय आसन् याभिरिदं ततम्॥ ३/८/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.028.m4a", "display_order": 29}, {"id": 6000038029, "chapter_id": 10038, "verse_number": "३-८-२५", "content_sanskrit": "प्रजापतीनां स पतिश्चक्लृपे कान् प्रजापतीन्।\nसर्गांश्चैवानुसर्गांश्च मनून् मन्वन्तराधिपान्॥ ३/८/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.029.m4a", "display_order": 30}, {"id": 6000038030, "chapter_id": 10038, "verse_number": "३-८-२६", "content_sanskrit": "एतेषामपि वंशांश्च वंशानुचरितानि च। उपर्यधश्च ये लोका भूमेर्मित्रात्मजासते।\nतेषां संस्थां प्रमाणं च भूर्लोकस्य च वर्णय॥ ३/८/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.030.m4a", "display_order": 31}, {"id": 6000038031, "chapter_id": 10038, "verse_number": "३-८-२७", "content_sanskrit": "तिर्यङ्मानुषदेवानां सरीसृपपतत्रिणाम्।\nवद नः सर्गसंव्यूहं गर्भस्वेदद्विजोद्भिदाम्॥ ३/८/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.031.m4a", "display_order": 32}, {"id": 6000038032, "chapter_id": 10038, "verse_number": "३-८-२८", "content_sanskrit": "गुणावतारैर्विश्वस्य सर्गस्थित्यप्ययात्मनः।\nसृजतः श्रीनिवासस्य व्याचक्ष्वोदारविक्रमम्॥ ३/८/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.032.m4a", "display_order": 33}, {"id": 6000038033, "chapter_id": 10038, "verse_number": "३-८-२९", "content_sanskrit": "वर्णाश्रमविभागांश्च रूपशीलस्वभावतः। ऋषीणां जन्मकर्माणि वेदस्य च विकर्षणम्।\nयज्ञस्य च वितानानि योगस्य च पथः प्रभो॥ ३/८/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.033.m4a", "display_order": 34}, {"id": 6000038034, "chapter_id": 10038, "verse_number": "३-८-३०", "content_sanskrit": "नैष्कर्म्यस्य च सांख्यस्य तन्त्रं वा भगवत्स्मृतम्।\nपाषण्डपथवैषम्यं प्रतिलोमनिवेशनम्॥ ३/८/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.034.m4a", "display_order": 35}, {"id": 6000038035, "chapter_id": 10038, "verse_number": "३-८-३१", "content_sanskrit": "जीवस्य गतयो याश्च यावर्तीर्गुणकर्मजाः।\nधर्मार्थकाममोक्षाणां निमित्तान्यविरोधतः॥ ३/८/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.035.m4a", "display_order": 36}, {"id": 6000038036, "chapter_id": 10038, "verse_number": "३-८-३२", "content_sanskrit": "वार्ताया दण्डनीतेश्च श्रुतस्य च विधिं पृथक्।\nश्राद्धस्य च विधिं ब्रह्मन् पितॄणां सर्वमेव च॥ ३/८/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.036.m4a", "display_order": 37}, {"id": 6000038037, "chapter_id": 10038, "verse_number": "३-८-३३", "content_sanskrit": "ग्रहनक्षत्रताराणां कालावयवसंस्थितिम्।\nदानस्य तपसो वाऽपि यच्चेष्टापूर्तयोः फलम्॥ ३/८/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.037.m4a", "display_order": 38}, {"id": 6000038038, "chapter_id": 10038, "verse_number": "३-८-३४", "content_sanskrit": "प्रवासस्थस्य यो धर्मो यश्च पुंस उतापदि।\nयेन वा भगवांस्तुष्येद् धर्मयोनिर्जनार्दनः॥ ३/८/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.038.m4a", "display_order": 39}, {"id": 6000038039, "chapter_id": 10038, "verse_number": "३-८-३५", "content_sanskrit": "सम्प्रसीदति वा येषामेतदाख्याहि मेऽनघ।\nअनुव्रतानां शिष्याणां पुत्राणां च द्विजोत्तम॥ ३/८/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.039.m4a", "display_order": 40}, {"id": 6000038040, "chapter_id": 10038, "verse_number": "३-८-३६", "content_sanskrit": "अनापृष्टमपि ब्रूयुर्गुरवो दीनवत्सलाः।\nतत्त्वानां भगवंस्तेषां कतिधा प्रतिसंक्रमः॥ ३/८/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.040.m4a", "display_order": 41}, {"id": 6000038041, "chapter_id": 10038, "verse_number": "३-८-३७", "content_sanskrit": "तत्रेमं क उपासीरन् क उ स्विदनुशेरते। पुरुषस्य च संस्थानं स्वरूपं वाऽपरस्य च।\nज्ञानं च नैगमं यत् तद् गुरुशिष्यप्रयोजनम्॥ ३/८/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.041.m4a", "display_order": 42}, {"id": 6000038042, "chapter_id": 10038, "verse_number": "३-८-३८", "content_sanskrit": "निमित्तानि च तस्येह प्रोक्तान्यनघ सूरिभिः।\nस्वतो ज्ञानं कुतः पुंसां भक्तिर्वैराग्यमेव वा॥ ३/८/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.042.m4a", "display_order": 43}, {"id": 6000038043, "chapter_id": 10038, "verse_number": "३-८-३९", "content_sanskrit": "एतान् मे पृच्छतः प्रश्नान् हरेः कर्मविवित्सया।\nब्रूहि मेऽन्धस्य मित्रत्वादजया नष्टचक्षुषः॥ ३/८/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.043.m4a", "display_order": 44}, {"id": 6000038044, "chapter_id": 10038, "verse_number": "३-८-४०", "content_sanskrit": "सर्वे वेदाश्च यज्ञाश्च तपोदानानि चानघ।\nजीवाभयप्रदानस्य न कुर्वीरन् कलामपि॥ ३/८/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.044.m4a", "display_order": 45}, {"id": 6000038045, "chapter_id": 10038, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.045.m4a", "display_order": 46}, {"id": 6000038046, "chapter_id": 10038, "verse_number": "३-८-४१", "content_sanskrit": "स इत्थमापृष्टपुराणकल्पः कुरुप्रधानेन मुनिप्रधानः।\nप्रवृद्धहर्षो भगवत्कथायां संचोदितस्तं प्रहसन्निवाह॥ ३/८/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_008/BhP_03.008.046.m4a", "display_order": 47}, {"id": 6000038047, "chapter_id": 10038, "verse_number": null, "content_sanskrit": "इति श्रीमद्भागवते वैयासिक्यां संहितायां तृतीयस्कन्धे अष्टमाध्यायः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]