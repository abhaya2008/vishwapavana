[{"id": 7002500000, "chapter_id": 22500, "verse_number": "१-१६२-१", "content_sanskrit": "सुमंतुरुवाच ।\nभानुं प्रतिष्ठाप्य नरः सर्वदेवमयं विभुम् ।\nप्राप्नोत्यमरतां वीर तेजसा रविसन्निभः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002500001, "chapter_id": 22500, "verse_number": "१-१६२-२", "content_sanskrit": "यो भानुं द्वेष्टि संमोहात्सर्वदेवनम स्कृतम् ।\nनरो नरकगामी स्यात्तस्यसंभाषणादपि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002500002, "chapter_id": 22500, "verse_number": "१-१६२-३", "content_sanskrit": "भानुमिष्टं प्रतिष्ठाप्य सर्वयत्नैर्विधानतः ।\nयत्पुण्यफलमाप्नोति तदेकाग्रमनाः शृणु ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002500003, "chapter_id": 22500, "verse_number": "१-१६२-४", "content_sanskrit": "सर्वयज्ञतपोदानतीर्थदेवेषु यत्फलम् ।\nतत्फलं कोटिगुणितं स्थाप्य भानुं लभेन्नरः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002500004, "chapter_id": 22500, "verse_number": "१-१६२-५", "content_sanskrit": "यो भानुं स्थापयेद्भक्त्या विधिपूर्वं नराधिप ।\nसर्वांगमुदितं पुण्यं लभेत्कोटिगुणं नरः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002500005, "chapter_id": 22500, "verse_number": "१-१६२-६", "content_sanskrit": "मातृजान्पितृजांश्चैव यत्र चोद्वहते स्त्रियम् ।\nकुलत्रयं समुद्धृत्य शक्रलोके महीयते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002500006, "chapter_id": 22500, "verse_number": "१-१६२-७", "content_sanskrit": "भुक्त्वा विपुलान्भोगान्प्रलये समुपस्थिते ।\nज्ञानयोगं समासाद्य तत्रैव प्रविमुच्यते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002500007, "chapter_id": 22500, "verse_number": "१-१६२-८", "content_sanskrit": "अथ वा राज्यमाकांक्षेज्जायते संभवांतरे ।\nसप्तद्वीमसमुद्रायाः क्षितेरधिपतिर्भवेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002500008, "chapter_id": 22500, "verse_number": "१-१६२-९", "content_sanskrit": "यत्कृत्वा पार्थिवं ब्योम्नि अर्चयेत्सर्वदेवकम् ।\nसमूलमखिलं तेन त्रैलोक्यं पूजितं भवेत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002500009, "chapter_id": 22500, "verse_number": "१-१६२-१०", "content_sanskrit": "इहैव धनवाञ्च्छ्रीमा न्सोंतेऽर्कत्वमवाप्नुयात् ।\nत्रिसंध्यं कीर्तयेद्व्योम कृत्वा बिंबेन पार्थिवम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002500010, "chapter_id": 22500, "verse_number": "१-१६२-११", "content_sanskrit": "शतैकादशकं यावत्तस्य पुण्यफलं शृणु ।\nअनेन सह देहेन भानुः संतिष्ठते क्षितौ ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002500011, "chapter_id": 22500, "verse_number": "१-१६२-१२", "content_sanskrit": "पापहा सर्वमर्त्यानां दर्शनात्स्पर्शनादपि ।\nउद्धारयेच्च संस्थाप्य कुलानामेकविंशतिम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002500012, "chapter_id": 22500, "verse_number": "१-१६२-१३", "content_sanskrit": "गीर्वाणैः सहितो नित्यं मोदते दिवि सूरवत् ।\nयोऽपि पिष्टमयं व्योम सर्वगंधोपशोभितम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002500013, "chapter_id": 22500, "verse_number": "१-१६२-१४", "content_sanskrit": "कुसुमैः सुसुगंधैश्च फलैश्च विविधैर्नृप ।\nभक्ष्यलेह्यरसैश्चैव कृतदीपैरलंकृतैः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002500014, "chapter_id": 22500, "verse_number": "१-१६२-१५", "content_sanskrit": "नानारसमायुक्तं नानागंधसमन्वितम् ।\nतस्य दक्षिणपार्श्वे तु विन्यसेदगुरुं बुधः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002500015, "chapter_id": 22500, "verse_number": "१-१६२-१६", "content_sanskrit": "दद्याद्वै पश्चिमे भागे श्रीखंडं चंदनं शुभम् ।\nउत्तरे चंदनं दद्याद्रक्तं दद्याच्च पूर्वतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002500016, "chapter_id": 22500, "verse_number": "१-१६२-१७", "content_sanskrit": "एवं वित्तानुसारेण कृत्वा विभवविस्तरम् ।\nकृष्णपक्षे तु सप्तम्यां भास्क रस्य निवेदयेत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002500017, "chapter_id": 22500, "verse_number": "१-१६२-१८", "content_sanskrit": "सकृदेव तु यः कुर्याद्व्योम भरतसत्तम ।\nयत्फलं हि भवेत्तस्य तन्मे निगदतः शृणु ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002500018, "chapter_id": 22500, "verse_number": "१-१६२-१९", "content_sanskrit": "सर्वपापविनिर्मुक्तः सर्वदुःखविवर्जितः ।\nनिष्कलः सर्वगो भूत्वा प्रविशेत्परमव्ययम् ।\nतेजसा रविसंकाशः प्रभयार्कसमप्रभः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002500019, "chapter_id": 22500, "verse_number": "१-१६२-२०", "content_sanskrit": "पांसुना क्रीडमानो यः कुर्याद्व्योम ह्यकार्यतः ।\nस राजन्भवते राजा पर्वतेषु समंततः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002500020, "chapter_id": 22500, "verse_number": "१-१६२-२१", "content_sanskrit": "सर्वेषामेव पात्राणां परं पात्रं विभावसुः ।\nएतत्संतारयेद्यस्मादतीव नरकार्णवात् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002500021, "chapter_id": 22500, "verse_number": "१-१६२-२२", "content_sanskrit": "तस्य पात्रस्य माहात्म्यं ध्रुवमक्षयमादिशेत् ।\nतस्मात्तस्मै सदा देयमप्रमेयफलार्थिभिः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002500022, "chapter_id": 22500, "verse_number": "१-१६२-२३", "content_sanskrit": "रवौ दत्तं हुतं जप्तं बलिं पूजां निवेदयेत् ।\nअनंतफलमादिष्टं ब्रह्मादिसुरसत्तमैः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002500023, "chapter_id": 22500, "verse_number": "१-१६२-२४", "content_sanskrit": "भक्त्या वित्तानुसारेण यः कुर्यादालयं रवेः ।\nसोग्नेयं यानमारुह्य मोदते सह भानुना ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002500024, "chapter_id": 22500, "verse_number": "१-१६२-२५", "content_sanskrit": "महाविभवसारोपि यः कुर्याद्भक्तिवर्जितम् ।\nअल्पे महति वा तुल्यं फलमाढ्यदरिद्रयोः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002500025, "chapter_id": 22500, "verse_number": "१-१६२-२६", "content_sanskrit": "वित्तशाठ्येन यः कुर्याद्वित्तवानपि मानवः ।\nन स फलमवाप्नोति प्रलोभाक्रांतमानसः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002500026, "chapter_id": 22500, "verse_number": "१-१६२-२७", "content_sanskrit": "तस्मात्त्रिभागं वित्तस्य जीवनाय प्रकल्पयेत् ।\nभागद्वयं च धर्मार्थे अनित्यं जीवनं यतः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002500027, "chapter_id": 22500, "verse_number": "१-१६२-२८", "content_sanskrit": "भक्त्या प्रचोदितं कुर्यादल्पवित्तोऽपि यो नरः ।\nमहाविभवसारोऽपि न कुर्याद्भक्तिवर्जितः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002500028, "chapter_id": 22500, "verse_number": "१-१६२-२९", "content_sanskrit": "सर्वस्वमपि यो दद्यादर्के भक्तिविवर्जितः ।\nन तेन धर्मभागी स्याद्भक्तिरेवात्र कारणम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002500029, "chapter_id": 22500, "verse_number": "१-१६२-३०", "content_sanskrit": "न तपोभिर्विभोरुग्रैर्न च सर्वैर्महामखैः ।\nगच्छेदेकं पुरं दिव्यमर्के भक्तियुतो नृप ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002500030, "chapter_id": 22500, "verse_number": "१-१६२-३१", "content_sanskrit": "रुचिरं शुभशैलोत्थं कुर्यायस्तु रवेर्गृहम् ।\nत्रिसप्तकुलसंयुक्तः सूर्यलोकमवाप्नुयात् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002500031, "chapter_id": 22500, "verse_number": "१-१६२-३२", "content_sanskrit": "यन्मया कोटिगुणितं कृतं स्यादिष्टकाम्यया ।\nद्विपरार्धगुणं पुण्यं शैलजेऽपि विदुर्बुधाः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002500032, "chapter_id": 22500, "verse_number": "१-१६२-३३", "content_sanskrit": "मृच्छैलेन समं ज्ञेयं पुण्यमाढ्यदरिद्रयोः ।\nयत्र तत्र गतः कुर्याद्भक्त्या पुण्यं भगालयम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002500033, "chapter_id": 22500, "verse_number": "१-१६२-३४", "content_sanskrit": "शैलोत्थमिष्टकाभिर्वा दृढं दारुमयं शुभम् ।\nस गच्छेत्परमं स्थानं भानोरमिततेजसः ।\nगैरिकं यानमारुह्य यः कुर्याद्धृतभूषणः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002500034, "chapter_id": 22500, "verse_number": "१-१६२-३५", "content_sanskrit": "क्रीडमानोऽपि यः कुर्याद्बालभावेऽर्कमंदिरम् ।\nसोऽर्कलोकमवाप्नोति विमानवरमास्थितः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002500035, "chapter_id": 22500, "verse_number": "१-१६२-३६", "content_sanskrit": "पुष्पमालाकुलं दिव्यं धूपगंधादिवासितम् ।\nअप्सरोगणसंकीर्णं सर्वकाममुखप्रदम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002500036, "chapter_id": 22500, "verse_number": "१-१६२-३७", "content_sanskrit": "तत्र रूढो महाराज वत्सरं वृन्दमुत्तमम् ।\nउषित्वा भास्करपुरे पूज्यमानस्तु दैवतैः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002500037, "chapter_id": 22500, "verse_number": "१-१६२-३८", "content_sanskrit": "क्रमादागत्य लोकेऽस्मिन्राजा भवति धार्मिकः ।\nधर्मार्थकामसंपन्नो यशसा च नराधिप ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002500038, "chapter_id": 22500, "verse_number": "१-१६२-३९", "content_sanskrit": "पश्यन्परिहरञ्जंतून्मार्जन्या मृदुसूक्ष्मया ।\nशनैः संमार्जनं कुर्याच्चांद्रायणफलं भवेत् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002500039, "chapter_id": 22500, "verse_number": "१-१६२-४०", "content_sanskrit": "पुत्रार्थं देहजीर्णाया वन्ध्यायाश्च विशेषतः ।\nरोगार्तानां च भूतानामारोग्यार्थं प्रपूजयेत् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002500040, "chapter_id": 22500, "verse_number": "१-१६२-४१", "content_sanskrit": "गृहीत्वा गोमयं स्वच्छं स्थाने च पतितं शुभे ।\nउपर्युपरि संत्यज्य प्रत्यग्रं जन्तुवर्जितम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002500041, "chapter_id": 22500, "verse_number": "१-१६२-४२", "content_sanskrit": "वस्त्रपूतगोमयेन यः कुर्यादुपलेपनम् ।\nपश्येत्तु सुखिताञ्जंतूंश्चांद्रायणशतं लभेत् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002500042, "chapter_id": 22500, "verse_number": "१-१६२-४३", "content_sanskrit": "यः कुर्यात्सर्वकार्याणि वस्त्रपूतेन वारिणा ।\nस मुनिः स महासाधुः स गच्छेत्परमां गतिम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002500043, "chapter_id": 22500, "verse_number": "१-१६२-४४", "content_sanskrit": "क्षरंति सर्वदानानि यज्ञहोमबलिक्रियाः ।\nअक्षरं तु महादानं सुखदं सर्वदेहिनाम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002500044, "chapter_id": 22500, "verse_number": "१-१६२-४५", "content_sanskrit": "नैरंतर्येण यः कुर्यात्पक्षं संमार्जनार्चनम् ।\nवर्षमेकं शतं दिव्यं सुरलोके महीयते ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002500045, "chapter_id": 22500, "verse_number": "१-१६२-४६", "content_sanskrit": "तस्यांते च चतुर्वेद सुरूपः प्रियदर्शनः ।\nआद्यः सर्वगुणोपेतो राजा भवति धार्मिकः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002500046, "chapter_id": 22500, "verse_number": "१-१६२-४७", "content_sanskrit": "संपर्केणापि यः कुर्यान्नरः कर्म भगालये ।\nसोपि सौमनसं गत्वा पुरं क्रीडति नित्यशः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002500047, "chapter_id": 22500, "verse_number": "१-१६२-४८", "content_sanskrit": "तावद्भ्रमंति संसारे दुःखशोकपरिप्लुताः ।\nन भजंति रविं भक्त्या यावत्सर्वेऽपि देहिनः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002500048, "chapter_id": 22500, "verse_number": "१-१६२-४९", "content_sanskrit": "समासक्तं तथा चित्तं जन्तोर्विषयगोचरे ।\nयद्यर्को न भवद्देवः को मुञ्चेदेव बन्धनात् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002500049, "chapter_id": 22500, "verse_number": "१-१६२-५०", "content_sanskrit": "यः कुर्यात्कुट्टिमां भूमिं दर्पणोदरसन्निभाम् ।\nनानावर्णविचित्रां च विचित्र कुसुमोज्ज्वलाम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002500050, "chapter_id": 22500, "verse_number": "१-१६२-५१", "content_sanskrit": "क्वचित्कलशविन्यस्तां पंकजैरुपशोभिताम् ।\nरम्यां मनोरमां सौम्यामर्कायतनसंसदि ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002500051, "chapter_id": 22500, "verse_number": "१-१६२-५२", "content_sanskrit": "यावद्दंडा भवेद्भूमिः समंताच्च सुशोभना ।\nतावद्युगसहस्राणि सूरलोके महीयते ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002500052, "chapter_id": 22500, "verse_number": "१-१६२-५३", "content_sanskrit": "कारयेच्चित्रशास्त्रज्ञैश्चित्रकर्मार्कमंदिरे ।\nविचित्रं यानमारुह्य चित्रभानोर्गृहं व्रजेत् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002500053, "chapter_id": 22500, "verse_number": "१-१६२-५४", "content_sanskrit": "यावत्स देवरूपाणि ग्रहरूपाणि लेखयेत् ।\nतावद्युगसहस्राणि स्वर्गलोके महीयते ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002500054, "chapter_id": 22500, "verse_number": "१-१६२-५५", "content_sanskrit": "भवेद्भूमिः समंताच्च यः कुर्यादर्कमंदि रम् ।\nआरामावसथादीनां लभेदामूल्यकं फलम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]