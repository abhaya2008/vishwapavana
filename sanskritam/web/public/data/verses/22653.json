[{"id": 7002653000, "chapter_id": 22653, "verse_number": "६-३१-१", "content_sanskrit": "ऋषय ऊचुः ।\nभगवन्सर्वतीर्थानां दानानां किं परं स्मृतम् ।\nयत्कृत्वा च कलौ घोरे परां निर्वृतिमाप्नुयात् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002653001, "chapter_id": 22653, "verse_number": "६-३१-२", "content_sanskrit": "सूत उवाच ।\nसामनस्य सुतः श्रेष्ठः पाणिनिर्नाम विश्रुतः ।\nकणभुग्वरशिष्यैश्च शास्त्रज्ञैः स पराजितः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002653002, "chapter_id": 22653, "verse_number": "६-३१-३", "content_sanskrit": "लज्जितः पाणिनिस्तत्र गतस्तीर्थान्तरं प्रति ।\nस्नात्वा सर्वाणि तीर्थानि संतर्प्य पितृदेवताः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002653003, "chapter_id": 22653, "verse_number": "६-३१-४", "content_sanskrit": "केदारमुदकं पीत्वा शिवध्यानपरोऽभवत् ।\nपर्णाशी सप्तदिवसाञ्जलभक्षस्ततोऽभवत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002653004, "chapter_id": 22653, "verse_number": "६-३१-५", "content_sanskrit": "ततो दशदिनान्ते स वायुभक्षो दशाहनि ।\nअष्टाविंशद्दिने रुद्रो वरं ब्रूहि वचोऽब्रवीत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002653005, "chapter_id": 22653, "verse_number": "६-३१-६", "content_sanskrit": "श्रुत्वामृतमयं वाक्यमस्तौद्गद्गदया गिरा ।\nसर्वेशं सर्वलिंगेशं गिरिजावल्लभं हरम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002653006, "chapter_id": 22653, "verse_number": "६-३१-७", "content_sanskrit": "पाणिनिरुवाच ।\nनमो रुद्राय महते सर्वेशाय हितैषिणे ।\nनन्दीसंस्थाय देवाय विद्याभयकराय च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002653007, "chapter_id": 22653, "verse_number": "६-३१-८", "content_sanskrit": "पापान्तकाय भर्गाय नमोनन्ताय वेधसे ।\nनमो मायाहरेशाय नमस्ते लोकशंकर ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002653008, "chapter_id": 22653, "verse_number": "६-३१-९", "content_sanskrit": "यदि प्रसन्नो देवेश विद्यामूलप्रदो भव ।\nपरं तीर्थं हि मे देहि द्वैमातुरपितर्नमः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002653009, "chapter_id": 22653, "verse_number": "६-३१-१०", "content_sanskrit": "सूत उवाच  ।\nइति श्रुत्वा महादेवः सूत्राणि प्रददौ मुदा ।\nसर्ववर्णमयान्येव ऐउणादिशुभानि वै ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002653010, "chapter_id": 22653, "verse_number": "६-३१-११", "content_sanskrit": "ज्ञानह्रदे सत्यजले राग द्वेषमलापहे ।\nयः प्राप्तो मानसे तीर्थे सर्वतीर्थफलं भजेत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002653011, "chapter_id": 22653, "verse_number": "६-३१-१२", "content_sanskrit": "मानसं हि महत्तीर्थ ब्रह्मदर्शनकारकम् ।\nपाणिने ते ददौ विप्र कृतकृत्यो भवान्भव ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002653012, "chapter_id": 22653, "verse_number": "६-३१-१३", "content_sanskrit": "इत्युक्त्वांतर्दधे रुद्रः पाणिनिः स्वगृहं ययौ ।\nसूत्रपाठं धातुपाठं गणपाठं तथैव च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002653013, "chapter_id": 22653, "verse_number": "६-३१-१४", "content_sanskrit": "लिंगसूत्रं तथा कृत्वा परं निर्वाणमाप्त वान् ।\nतस्मात्त्वं भार्गवश्रेष्ठ मानसं तीर्थमाचर ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002653014, "chapter_id": 22653, "verse_number": "६-३१-१५", "content_sanskrit": "यतो याता स्वयं गंगा सर्वतीर्थमयी शिवा ।\nगंगातीर्थात्परं तीर्थं न भूतं न भवि ष्यति ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]