[{"id": 2040814, "chapter_id": 1906, "verse_number": "५-१५१-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2040815, "chapter_id": 1906, "verse_number": "५-१५१-१", "content_sanskrit": "जनार्दनवचः श्रुत्वा धर्मराजो युधिष्ठिरः।\nभ्रातॄनुवाच धर्मात्मा समक्षं केशवस्य ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2040816, "chapter_id": 1906, "verse_number": "५-१५१-२", "content_sanskrit": "श्रुतं भवद्भिर्यद्वृत्तं सभायां कुरुसंसदि ।\nकेशवस्यापि यद्वाक्यं तत्सर्वमवधारितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2040817, "chapter_id": 1906, "verse_number": "५-१५१-३", "content_sanskrit": "तस्मात्सेनाविभागं मे कुरुध्वं नरसत्तमाः ।\nअक्षौहिण्यश्च सप्तैताः समेता विजयाय वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2040818, "chapter_id": 1906, "verse_number": "५-१५१-४", "content_sanskrit": "तासां ये पतयः सप्त विख्यातास्तान्निबोधत।\nद्रुपदश्च विराटश्च धृष्टद्युम्नशिखण्डिनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2040819, "chapter_id": 1906, "verse_number": "५-१५१-५", "content_sanskrit": "सात्यकिश्चेकितानश्च भीमसेनश्च वीर्यवान् ।\nएते सेनाप्रणेतारो वीराः सर्वे तनुत्यजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2040820, "chapter_id": 1906, "verse_number": "५-१५१-६", "content_sanskrit": "सर्वे वेदविदः शूराः सर्वे सुचिरितव्रताः ।\nह्रीमन्तो नीतिमन्तश्च सर्वे युद्धविशारदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2040821, "chapter_id": 1906, "verse_number": "५-१५१-७", "content_sanskrit": "इष्वस्त्रकुशलाः सर्वे तथा सर्वास्त्रयोधिनः ।\nसप्तानामपि यो नेता सेनानां प्रविभागवित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2040822, "chapter_id": 1906, "verse_number": "५-१५१-८", "content_sanskrit": "यः सहेत रणे भीष्णं शरार्चिःपावकोपमम् ।\nतं तावत्सहदेवात्र प्रब्रूहि कुरुनन्दन।\nस्वगतं पुरुषव्याघ्र को नः सेनापतिः क्षमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2040823, "chapter_id": 1906, "verse_number": "५-१५१-९x", "content_sanskrit": "सहदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2040824, "chapter_id": 1906, "verse_number": "५-१५१-९", "content_sanskrit": "संयुक्त एकदुःखश्च वीर्यवांश्च महीपतिः।\nयं समाश्रित्य धर्मज्ञं स्वमंशमनुयुञ्ज्महे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2040825, "chapter_id": 1906, "verse_number": "५-१५१-१०", "content_sanskrit": "मत्स्यो विराटो बलवान्कृतास्त्रो युद्धदुर्मदः ।\nप्रसहिष्यति सङ्ग्रामे भीष्मं तांश्च महारथान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2040826, "chapter_id": 1906, "verse_number": "५-१५१-११x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2040827, "chapter_id": 1906, "verse_number": "५-१५१-११", "content_sanskrit": "तथोक्ते सहदेवेन वाक्ये वाक्यविशारदः ।\nनकुलोऽनन्तरं तस्मादिदं वचनमाददे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2040828, "chapter_id": 1906, "verse_number": "५-१५१-१२", "content_sanskrit": "वयसा शास्त्रतो धैर्यात्कुलेनाभिजनेन च ।\nह्रीमान्बलान्वितः श्रीमान्सर्वशास्त्रविशारदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2040829, "chapter_id": 1906, "verse_number": "५-१५१-१३", "content_sanskrit": "वेद चास्त्रं भारद्वाजाहुर्धर्षः सत्यसङ्गरः ।\nयो नित्यं स्पर्धते द्रोणं भीष्मं चैव महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2040830, "chapter_id": 1906, "verse_number": "५-१५१-१४", "content_sanskrit": "श्लाघ्यः पार्थिववंशस्य प्रमुखे वाहिनीपतिः।\nपुत्रपौत्रेः परिवृतः शतशाख इव द्रुमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2040831, "chapter_id": 1906, "verse_number": "५-१५१-१५", "content_sanskrit": "यस्तताप तपो घोरं सदारः पृथिवीपतिः ।\nरोषाद्द्रोणविनाशाय वीरः समितिशोभनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2040832, "chapter_id": 1906, "verse_number": "५-१५१-१६", "content_sanskrit": "पितेवास्मान्समाधत्ते यः सदा पार्थिवर्षभः ।\nश्वशुरो द्रुपदोऽस्माकं सेनाग्रं स प्रकर्षतु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2040833, "chapter_id": 1906, "verse_number": "५-१५१-१७", "content_sanskrit": "स द्रोणभीष्मावायातौ सहेदिति मतिर्मम ।\nस हि दिव्यास्त्रविद्राजा सखा चाङ्गिरसो नृपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2040834, "chapter_id": 1906, "verse_number": "५-१५१-१८", "content_sanskrit": "माद्रीसुताभ्यामुक्ते तु स्वमते कुरुनन्दनः।\nवासविर्वासवसमः सव्यसाच्यब्रवीद्वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2040835, "chapter_id": 1906, "verse_number": "५-१५१-१९", "content_sanskrit": "योयं तपःप्रभावेन ऋषिसन्तोषणेन च ।\nदिव्यः पुरुष उत्पन्नो ज्वालावर्णो महाभुजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2040836, "chapter_id": 1906, "verse_number": "५-१५१-२०", "content_sanskrit": "धनुष्मान्कवची खङ्गी रथमारुह्य दंशितः ।\nदिव्यैर्हयवरैर्युक्तमग्निकुण्डात्समुत्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2040837, "chapter_id": 1906, "verse_number": "५-१५१-२१", "content_sanskrit": "गर्जन्निव महामेघो रथघोषेण वीर्यवान् ।\nसिंहसंहननो वीरः सिंहतुल्यपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2040838, "chapter_id": 1906, "verse_number": "५-१५१-२२", "content_sanskrit": "सिंहोरस्कः सिंहभुजः सिंहवक्षा महाबलः ।\nसिंहप्रगर्जनो वीरः संहस्कन्धो महाद्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2040839, "chapter_id": 1906, "verse_number": "५-१५१-२३", "content_sanskrit": "शुभ्रूः सुदंष्ट्रः सुहनुः सुबाहुः सुमुखोऽकृशः ।\nसुजत्रुः सुविशालाक्षः सुपादः सुप्रतिष्ठितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2040840, "chapter_id": 1906, "verse_number": "५-१५१-२४", "content_sanskrit": "अभेद्यः सर्वशस्त्राणां प्रभिन्न इव वारणः ।\nजज्ञे द्रोणविनाशाय सत्यवादी जितेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2040841, "chapter_id": 1906, "verse_number": "५-१५१-२५", "content_sanskrit": "धृष्टद्युम्नमहं मन्ये सहेद्भीष्मस्य सायकान्।\nवज्राशनिसमस्पर्शान्दीप्तास्यानुरगानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2040842, "chapter_id": 1906, "verse_number": "५-१५१-२६", "content_sanskrit": "यमदूतसमान्वेगे निपाते पावकोपमान् ।\nरामेणाजौ विषिहितान्वज्रनिष्पेषदारुणान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2040843, "chapter_id": 1906, "verse_number": "५-१५१-२७", "content_sanskrit": "पुरुष तं न पश्यामि यः सहेत महाव्रतम्।\nधृष्टद्युम्नमृते राजन्निति मे धीयते मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2040844, "chapter_id": 1906, "verse_number": "५-१५१-२८", "content_sanskrit": "क्षिप्रहस्तश्चित्रयोधी मतः सेनापतिर्मम ।\nअभेद्यकवचः श्रीमान्मातङ्ग इव यूथपः ॥ ५-१५१-२९a`अर्जुनेनैवमुक्ते तु भीमो वाक्यं समाददे।\nवधार्थं यः समुत्पन्नः शिखण्डी द्रुपदात्मजः ।\nवदन्ति सिद्धा राजेन्द्र ऋषयश्च समागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2040845, "chapter_id": 1906, "verse_number": "५-१५१-३०", "content_sanskrit": "यस्य सङ्ग्राममध्ये तु दिव्यमस्त्रं प्रकुर्वतः ।\nरूपं द्रक्ष्यन्ति पुरुषा रामस्येव महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2040846, "chapter_id": 1906, "verse_number": "५-१५१-३१", "content_sanskrit": "न तं युद्धे प्रपश्यामि यो भिन्द्यात्तु शिखण्डिनाम् ।\nशस्त्रेण समरे राजन्सन्नद्वं स्यन्दने स्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2040847, "chapter_id": 1906, "verse_number": "५-१५१-३२", "content_sanskrit": "द्वैरथे समरे नान्यो भीष्मं हन्यान्महाव्रतम् ।\nशिखण्डिनमृते वीरं स मे सेनापतिर्मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2040848, "chapter_id": 1906, "verse_number": "५-१५१-३३x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2040849, "chapter_id": 1906, "verse_number": "५-१५१-३३", "content_sanskrit": "सर्वस्य जगतस्तात सारासारं बालाबलम् ।\nसर्वं जानाति धर्मात्मा मतमेषां च केशवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2040850, "chapter_id": 1906, "verse_number": "५-१५१-३४", "content_sanskrit": "यमाह कृष्णो दाशार्हः सोऽस्तु सेनापतिर्मम ।\nकृतास्त्रोप्यकृतास्त्रो वा वृद्धो वा यदि वा युवा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2040851, "chapter_id": 1906, "verse_number": "५-१५१-३५", "content_sanskrit": "एष नो विजये मूलमेष तात विपर्यये।\nअत्र प्राणाश्च राज्यं च भावाभावौ सुखासुखे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2040852, "chapter_id": 1906, "verse_number": "५-१५१-३६", "content_sanskrit": "एष धाता विधाता च सिद्धिरत्र प्रतिष्ठिता।\nयमाह कृष्णो दाशार्हः सोस्तु नो वाहिनीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2040853, "chapter_id": 1906, "verse_number": "५-१५१-३७", "content_sanskrit": "ब्रवीतु वदतां श्रेष्ठो निशा समभिवर्तते।\nततः सेनापतिं कृत्वा कृष्णस्य वशवर्तिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2040854, "chapter_id": 1906, "verse_number": "५-१५१-३८", "content_sanskrit": "रात्रेः शेषे व्यतिक्रान्ते प्रयास्यामो रणाजिरम् ।\nअधिवासितशस्त्राश्च कृतकौतुकमङ्गलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2040855, "chapter_id": 1906, "verse_number": "५-१५१-३९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2040856, "chapter_id": 1906, "verse_number": "५-१५१-३९", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा धर्मराजस्य धीमतः।\nअब्रवीत्पुण्डरीकाक्षो धनञ्जयमवेक्ष्य ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2040857, "chapter_id": 1906, "verse_number": "५-१५१-४०", "content_sanskrit": "ममाप्येते महाराज भवद्भिर्य उदाहृताः।\nनेतारस्तव सेनाया मता विक्रान्तयोधिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2040858, "chapter_id": 1906, "verse_number": "५-१५१-४१", "content_sanskrit": "सर्व एव समर्था हि तव शत्रुं प्रबाधितुम्।\nइन्द्रस्यापि भयं ह्येते जनयेयुर्महाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2040859, "chapter_id": 1906, "verse_number": "५-१५१-४२", "content_sanskrit": "किं पुनर्धार्तराष्ट्राणां लुब्धानां पापचेतसाम्।\nमयापि हि महाबाहो त्वत्प्रियार्थं महाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2040860, "chapter_id": 1906, "verse_number": "५-१५१-४३", "content_sanskrit": "कृतो यत्नो महांस्तत्र शमः स्यादिति भारत ।\nधर्मस्य गतमानृण्यं न स्म वाच्या विवक्षताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2040861, "chapter_id": 1906, "verse_number": "५-१५१-४४", "content_sanskrit": "कृतार्थं मन्यते बाल आत्मनमविचक्षणः ।\nधार्तराष्ट्रो बलस्थं च पश्यत्यात्मानमातुरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2040862, "chapter_id": 1906, "verse_number": "५-१५१-४५", "content_sanskrit": "युज्यतां वाहिनी साधु वधसाध्या हि मे मताः ।\nन धार्तराष्ट्राः शक्ष्यन्ति स्थातुं दृष्ट्वा धनञ्जयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2040863, "chapter_id": 1906, "verse_number": "५-१५१-४६", "content_sanskrit": "भीमसेनं च सङ्क्रुद्धं यमौ चापि यमोपमौ ।\nयुयुधानं द्वितीयं च धृष्टद्युम्नममर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2040864, "chapter_id": 1906, "verse_number": "५-१५१-४७", "content_sanskrit": "अभिमन्युं द्रौपदेयान्विराटद्रुपदावपि।\nअक्षौहिणीपतींश्चान्यान्नरेन्द्रान्भीमविक्रमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2040865, "chapter_id": 1906, "verse_number": "५-१५१-४८", "content_sanskrit": "सारवद्बलमस्माकं दुष्प्रधर्षं दुरासदम्।\nधार्तराष्ट्रबलं सङ्ख्ये हनिष्यति न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2040866, "chapter_id": 1906, "verse_number": "५-१५१-४९", "content_sanskrit": "धृष्टद्युम्नमहं मन्ये सेनापतिमरिन्दम।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2040867, "chapter_id": 1906, "verse_number": "५-१५१-४९x", "content_sanskrit": "वैशम्पायन उवाच।\nएवमुक्ते तु कृष्णेन संप्राहृष्यन्नरोत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2040868, "chapter_id": 1906, "verse_number": "५-१५१-५०", "content_sanskrit": "तेषां प्रहृष्टमनसां नादः समभवन्महान्।\nयोग इत्यथ सैन्यानां त्वरतां संप्रधावताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2040869, "chapter_id": 1906, "verse_number": "५-१५१-५१", "content_sanskrit": "हयवारणशब्दाश्च नेमिघोषाश्च सर्वतः।\nशङ्खदुन्दुभिघोषाश्च तुमुलाः सर्वतोऽभवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2040870, "chapter_id": 1906, "verse_number": "५-१५१-५२", "content_sanskrit": "तद्रुग्रं सागरनिभं क्षुब्धं बलसमागमम्।\nरथपत्तिगजोदयं महोर्मिभिरिवाकुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2040871, "chapter_id": 1906, "verse_number": "५-१५१-५३", "content_sanskrit": "धावतामाहुयानानां तनुत्राणि च बध्नताम् ।\nप्रयास्यतां पाण्डवानां ससैन्यानां समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2040872, "chapter_id": 1906, "verse_number": "५-१५१-५४", "content_sanskrit": "गङ्गेव पूर्णा दुर्धर्षा समदृश्यत वाहिनी ।\nअग्रानीके भीमसेनो माद्रीपुत्रौ च दंशितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2040873, "chapter_id": 1906, "verse_number": "५-१५१-५५", "content_sanskrit": "सौभद्रो द्रौपदेयाश्च धृष्टद्युम्नस्य पार्षतः ।\nप्रभद्रकाश्च पञ्चाला भीमसेनमुखा ययुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2040874, "chapter_id": 1906, "verse_number": "५-१५१-५६", "content_sanskrit": "ततः शब्दः समभवत्सुमुद्रस्येव पर्वणि ।\nहृष्टानां संप्रयातानां घोषो दिवमिवास्पृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2040875, "chapter_id": 1906, "verse_number": "५-१५१-५७", "content_sanskrit": "प्रहृष्टा दंशिता योधाः परानीकविदारणाः।\nतेषां मध्ये ययौ राजा कुन्तीपुत्रो युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2040876, "chapter_id": 1906, "verse_number": "५-१५१-५८", "content_sanskrit": "शकटापणवेशाश्च यानयुग्यं च सर्वशः ।\nकोशं यन्त्रायुधं चैव ये च वैद्याश्चिकित्सकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2040877, "chapter_id": 1906, "verse_number": "५-१५१-५९", "content_sanskrit": "फल्गु यच्चं बलं किंचिद्यच्चापि कृशदुर्बलम्।\nतत्सङ्गृह्य ययौ राजा ये चापि परिचारकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2040878, "chapter_id": 1906, "verse_number": "५-१५१-६०", "content_sanskrit": "उपप्लाव्ये तु पाञ्चाली द्रौपदी सत्यवादिनी ।\nसह स्त्रीभिर्निनवृते दासीदाससमावृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2040879, "chapter_id": 1906, "verse_number": "५-१५१-६१", "content_sanskrit": "कृत्वा मूलप्रतीकारं गुल्मैः स्थावरजङ्गमैः ।\nस्कन्धावारेण महता प्रययुः पाण्डुनन्दनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2040880, "chapter_id": 1906, "verse_number": "५-१५१-६२", "content_sanskrit": "ददतो गां हिरण्यं च ब्राह्मणैरभिसंवृताः।\nस्तूयमाना ययू राजन्रथैर्मणिविभूषितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2040881, "chapter_id": 1906, "verse_number": "५-१५१-६३", "content_sanskrit": "केकया धृष्टकेतुश्च पुत्रः काश्यस्य चाभिभूः ।\nश्रेणिमान्वसुदानश्च शिखण्डी चापराजितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2040882, "chapter_id": 1906, "verse_number": "५-१५१-६४", "content_sanskrit": "हृष्टास्तुष्टाः कवचिनः सशस्त्राः समलङ्कृताः।\nराजानमन्वयुः सर्वे परिवार्य युधिष्ठिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2040883, "chapter_id": 1906, "verse_number": "५-१५१-६५", "content_sanskrit": "जघनार्धे विराटश्च याज्ञसेनिश्च सौमकिः ।\nसुधर्मा कुन्तिभोजश्च धृष्टद्युम्नस्य चात्मजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2040884, "chapter_id": 1906, "verse_number": "५-१५१-६६", "content_sanskrit": "रथायुतानि चत्वारि हयाः पञ्चगुणास्तथा ।\nपत्तिसैन्यं दशगुणं गजानामयुतानि षट् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2040885, "chapter_id": 1906, "verse_number": "५-१५१-६७", "content_sanskrit": "अनाधृष्टिश्चेकितानो धृष्टकेतुश्च सात्यकिः ।\nपरिवार्य ययुः सर्वे वासुदेवधनञ्जयौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2040886, "chapter_id": 1906, "verse_number": "५-१५१-६८", "content_sanskrit": "आसाद्य तु कुरुक्षेत्रं व्यूढानीकाः प्रहारिणः ।\nपाण्डवाः समदृश्यन्त नर्दन्तो वृषभा इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2040887, "chapter_id": 1906, "verse_number": "५-१५१-६९", "content_sanskrit": "तेऽवगाह्य कुरुक्षेत्रं शङ्खान्दध्मुररिन्दमाः।\nतथैव दध्मतुः शङ्खं वासुदेवधनञ्जयौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2040888, "chapter_id": 1906, "verse_number": "५-१५१-७०", "content_sanskrit": "पाञ्चजन्यस्य निर्घोषं विस्फूर्जितमिवाशनेः ।\nनिशम्य सर्वसैन्यानि समहष्यन्त सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2040889, "chapter_id": 1906, "verse_number": "५-१५१-७१", "content_sanskrit": "शङ्खदुन्दुभिसंहृष्टः सिंहनादस्तरस्विनाम् ।\nपृथिवीं चान्तरिक्षं च सागरांश्चान्वनादयत् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2040890, "chapter_id": 1906, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि सैन्यनिर्याणपर्वणि एकपञ्चाशदधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}]