[{"id": 2168021, "chapter_id": 4605, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2168022, "chapter_id": 4605, "verse_number": "१", "content_sanskrit": "युयुत्सुं तव पुत्रस्य तापयन्तं वरूथिनीम् ।\nउलूकोऽभ्यपतत् तूर्णं तिष्ठ तिष्ठेति चाब्रवीत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2168023, "chapter_id": 4605, "verse_number": "२", "content_sanskrit": "युयुत्सुश्च ततो राजन् शितधारेण पत्रिणा ।\nउलूकं ताडयामास वज्रेणेव महाचलम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2168024, "chapter_id": 4605, "verse_number": "३", "content_sanskrit": "उलूकस्तु ततः क्रुद्धस्तव पुत्रस्य मारिष ।\nक्षुरप्रेण सुतीक्ष्णेन धनुश्चिच्छेद संयुगे\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2168025, "chapter_id": 4605, "verse_number": "४", "content_sanskrit": "अपास्य तद्धनुच्छिन्नं युयुत्सुर्वेगवत्तरम् ।\nअन्यदादत्त सुमहच्चापं संरक्तलोचनः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2168026, "chapter_id": 4605, "verse_number": "५", "content_sanskrit": "शाकुनिं तु ततः षष्ट्या विव्याध भरतर्षभ ।\nसारथिं त्रिभिरानर्च्छत्तं च भूयो व्यविध्यत\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2168027, "chapter_id": 4605, "verse_number": "६", "content_sanskrit": "उलूकः पञ्चविंशत्या विद्ध्वा रुग्मविभूषितैः ।\nअथास्य समरे क्रुद्धो ध्वजं चिच्छेद काञ्चनम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2168028, "chapter_id": 4605, "verse_number": "७", "content_sanskrit": "स च्छिन्नयष्टिः सुमहान् शीर्यमाणो महाध्वजः ।\nपपात प्रमुखे राजन् युयुत्सोर्विश्रुतो रथात्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2168029, "chapter_id": 4605, "verse_number": "८", "content_sanskrit": "ध्वजमुन्मथितं दृष्ट्वा युयुत्सुः क्रोधमूर्च्छितः ।\nउलूकं पञ्चभिर्बाणैराजघान स्तनान्तरे\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2168030, "chapter_id": 4605, "verse_number": "९", "content_sanskrit": "उलूकस्तस्य भल्लेन तैलधौतेन मारिष ।\nयन्तुश्चिच्छेद समरे शिरः भरतसत्तम\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2168031, "chapter_id": 4605, "verse_number": "१०", "content_sanskrit": "तच्छिन्नमपतद् भूमौ युयुत्सोः सारथेस्तदा ।\nतारारूपं यथा चित्रं निपपात महीतळे\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2168032, "chapter_id": 4605, "verse_number": "११", "content_sanskrit": "जघान चतुरोऽश्वांश्च तं च विव्याध पञ्चभिः ।\nसोऽतिविद्धो बलवता प्रत्यपायाद् रथान्तरम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2168033, "chapter_id": 4605, "verse_number": "१२", "content_sanskrit": "निर्जित्य तं रणे राजन्नुलूकस्त्वरितो ययौ ।\nपाञ्चालान् सृञ्जयांश्चैव विकिरन् निशितैः शरैः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2168034, "chapter_id": 4605, "verse_number": "१३", "content_sanskrit": "शतानीकं महाराज श्रुतकर्मा सुतस्तव ।\nव्यश्वसूतरथं चक्रे निमेषार्धादसम्भ्रमः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2168035, "chapter_id": 4605, "verse_number": "१४", "content_sanskrit": "हताश्वे तु रथे तिष्ठन् शतानीको महारथः ।\nगदां चिक्षेप सङ्क्रुद्धस्तव पुत्रस्य मारिष\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2168036, "chapter_id": 4605, "verse_number": "", "content_sanskrit": "सा कृत्वा स्यन्दनं भस्म हयान् सारथिमेव च ।\n(ध्वजं चैव पताकां च मेदिनीमन्वपद्यत\t॥१५॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2168037, "chapter_id": 4605, "verse_number": "१६", "content_sanskrit": "तावुभौ विरथौ वीरौ कुरूणां कीर्तिवर्धनौ ।\nव्यपाक्रमेतां युद्धात्तु प्रेक्षमाणौ परस्परम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2168038, "chapter_id": 4605, "verse_number": "१७", "content_sanskrit": "पुत्रस्तु तव सम्भ्रान्तो विविंशो रथमाव्रजत् ।\nशतानीकोऽपि राजेन्द्र प्रतिविन्ध्यरथं गतः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2168039, "chapter_id": 4605, "verse_number": "१८", "content_sanskrit": "सुतसोमं तु शकुनिर्विद्ध्वा सुनिशितैः शरैः ।\nनाकम्पयत सङ्क्रुद्धो वार्यौघ इव पर्वतम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2168040, "chapter_id": 4605, "verse_number": "१९", "content_sanskrit": "सुतसोमस्तु तं दृष्ट्वा पितुरत्यन्तवैरिणम् ।\nशरैरनेकसाहस्रैश्छादयामास भारत\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2168041, "chapter_id": 4605, "verse_number": "२०", "content_sanskrit": "तान् शरान् शकुनिस्तूर्णं चिच्छेदान्यैः पतत्रिभिः ।\nलघ्वस्त्रश्चित्रयोधी जितकाशी च संयुगे\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2168042, "chapter_id": 4605, "verse_number": "२१", "content_sanskrit": "निवार्य समरे चापि शरांस्तान् निशितैः शरैः ।\nआजघान सुसङ्क्रुद्धः सुतसोमं त्रिभिः शरैः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2168043, "chapter_id": 4605, "verse_number": "२२", "content_sanskrit": "तस्याश्वान् स्यन्दनं केतुं तिलशो व्यधमच्छरैः ।\nश्यालस्तव महाराज ततः उच्चक्रुशुर्जनाः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2168044, "chapter_id": 4605, "verse_number": "२३", "content_sanskrit": "हताश्वो विरथश्चैव छिन्नकेतुश्च मारिष ।\nधन्वी धनुर्वरं गृह्य रथाद् भूमौ व्यतिष्ठत\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2168045, "chapter_id": 4605, "verse_number": "२४", "content_sanskrit": "व्यसृजत् सायकांश्चैव स्वर्णपुङ्खान् शिलाशितान्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2168046, "chapter_id": 4605, "verse_number": "२५", "content_sanskrit": "छादयामासुरथ ते तव श्यालस्य तं रथम् ।\nपतङ्गानामिव व्राताः शरव्राता महारथम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2168047, "chapter_id": 4605, "verse_number": "२६", "content_sanskrit": "सञ्छाद्यमानोऽपि दृढं विव्यथे नैव सौबलः ।\nप्रामर्दत शरानस्तान् शरजालैर्महारथः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2168048, "chapter_id": 4605, "verse_number": "२७", "content_sanskrit": "तत्रातुष्यन्त योधाश्च सिद्धाश्चैव दिवि स्थिताः ।\nसुतसोमस्य तत् कर्म दृष्ट्वाऽश्रद्धेयमद्भुतम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2168049, "chapter_id": 4605, "verse_number": "२८", "content_sanskrit": "रथस्थं नृपतिं यत्तु पदातिः समयोधयत्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2168050, "chapter_id": 4605, "verse_number": "२९", "content_sanskrit": "तस्य तीक्ष्णैर्महावेगैः भल्लैः सन्नतपर्वभिः ।\nव्यधमत् कार्मुकं राजन् तूणीरांश्चैव सर्वशः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2168051, "chapter_id": 4605, "verse_number": "३०", "content_sanskrit": "स च्छिन्नधन्वा विरथः खड्गमुद्यम्य चानदत् ।\nवैदूर्योत्पलवर्णाभं दन्तिदन्तमयत्सरुम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2168052, "chapter_id": 4605, "verse_number": "३१", "content_sanskrit": "भ्राम्यमाणं ततस्तं तु विमलाम्बरदर्शनम् ।\nकालोपमं तदा मेने सुतसोमस्य धीमतः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2168053, "chapter_id": 4605, "verse_number": "३२", "content_sanskrit": "सोऽचरत् सहसा खड्गी मण्डलानि समन्ततः ।\nचतुर्दशं महाराज शिक्षाबलसमन्वितः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2168054, "chapter_id": 4605, "verse_number": "३३", "content_sanskrit": "भ्रान्तमुद्भ्रान्तमाविद्धमाप्लुतं विप्लुतं सृतम् ।\nसम्पातं समुदीर्यं च दर्शयामास संयुगे\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2168055, "chapter_id": 4605, "verse_number": "३४", "content_sanskrit": "सौबलस्तु ततस्तस्य शरांश्चिक्षेप वीर्यवान् ।\nतानापतत एवाशु चिच्छेद परमासिना\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2168056, "chapter_id": 4605, "verse_number": "३५", "content_sanskrit": "ततः क्रुद्धो महाराज सौबलः परवीरहा ।\nप्राहिणोत् सुतसोमस्य शरानाशीविषोपमान्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2168057, "chapter_id": 4605, "verse_number": "३६", "content_sanskrit": "चिच्छेद तांस्तु खड्गेन शिक्षया च बलेन च ।\nदर्शयँल्लाघवं युद्धे तार्क्ष्यतुल्यपराक्रमः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2168058, "chapter_id": 4605, "verse_number": "३७", "content_sanskrit": "तस्य सञ्चरतो राजन् मण्डलावर्तने तदा ।\nक्षुरप्रेण सुतीक्ष्णेन खड्गं चिच्छेद सुप्रभम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2168059, "chapter_id": 4605, "verse_number": "३८", "content_sanskrit": "स च्छिन्नः सहसा भूमौ निपपात महानसिः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2168060, "chapter_id": 4605, "verse_number": "३९", "content_sanskrit": "अर्धमस्य स्थितं हस्ते सत्सरोर्यत्तु भारत ।\nछिन्नमाज्ञाय निस्त्रिंशमवप्लुत्य पदानि षट्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2168061, "chapter_id": 4605, "verse_number": "४०", "content_sanskrit": "प्राविध्यतासिं तच्छेषं सुतसोमो महाबलः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2168062, "chapter_id": 4605, "verse_number": "४१", "content_sanskrit": "तच्छित्त्वा सगुणं चापं रणे तस्य महात्मनः ।\nपपात धरणीं तूर्णं स्वर्णवज्रविभूषितम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2168063, "chapter_id": 4605, "verse_number": "४२", "content_sanskrit": "सुतसोमस्ततो राजन् श्रुतकीर्तिरथं गतः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2168064, "chapter_id": 4605, "verse_number": "४३", "content_sanskrit": "सौबलोऽपि धनुर्गृह्य घोरमन्यत् सुदुःसहम् ।\nअभ्ययात् पाण्डवानीकं निघ्नन् शत्रुगणान् बहून्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2168065, "chapter_id": 4605, "verse_number": "४४", "content_sanskrit": "तत्र नादो महानासीत् पाण्डवानां विशाम्पते ।\nसौबलं समरे दृष्ट्वा विचरन्तमभीतवत्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2168066, "chapter_id": 4605, "verse_number": "४५", "content_sanskrit": "तान्यनीकानि दृप्तानि शस्त्रवन्ति महान्ति च ।\nद्राव्यमाणान्यदृश्यन्त सौबलेन महात्मना\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2168067, "chapter_id": 4605, "verse_number": "४६", "content_sanskrit": "यथा दैत्यचमूं राजन् देवराजो ममर्द ह ।\nतथैव पाण्डवानीकं सौबलेयो व्यनाशयत्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2168068, "chapter_id": 4605, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nसुतसोमसौबलयुद्धं नाम पञ्चविंशोऽध्यायः ॥२५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]