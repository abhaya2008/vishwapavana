[{"id": 7005804000, "chapter_id": 25804, "verse_number": "२७८-१", "content_sanskrit": "गोसहस्रप्रदानाख्य-महादानविधिवर्णनम् ।\nमत्स्य उवाच ।\nअथातः सम्प्रवक्ष्यामि महादानमनुत्तमम् ।\nगोसहस्रप्रदानाख्यं सर्वपापहरं परम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005804001, "chapter_id": 25804, "verse_number": "२७८-२", "content_sanskrit": "पुण्यां तिथिं समासाद्य युगमन्वन्तरादिकीम् ।\nपयोव्रतं त्रिरात्रं स्यादेकरात्रमथापि वा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005804002, "chapter_id": 25804, "verse_number": "२७८-३", "content_sanskrit": "लोकेशावाहनं कुर्यात् तुला पुरुषदानवत् ।\nपुण्याहवाचनं कुर्याद्धोमः कार्यस्तथैव च ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005804003, "chapter_id": 25804, "verse_number": "२७८-४", "content_sanskrit": "गोसहस्रं बहिः कुर्याद् वस्त्रमाल्य विभूषणम् ।\nसुवर्णश्रृङ्गाभरणं रौप्यपाद समन्वितम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005804004, "chapter_id": 25804, "verse_number": "२७८-५", "content_sanskrit": "अन्तः प्रवेश्य दशकं वस्त्रमाल्यैश्च पूजयेत् ।\nसुवर्णघण्टिकायुक्तं कांस्य दोहनकान्वितम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005804005, "chapter_id": 25804, "verse_number": "२७८-६", "content_sanskrit": "सुवर्णतिलकोपेतं हेमपट्टैरलङ्कृतम् ।\nकौशेयवस्त्रसम्वीतं माल्यगन्धसमन्वितम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005804006, "chapter_id": 25804, "verse_number": "२७८-७", "content_sanskrit": "हेमरत्नमयैः श्रुङ्गैः चामरैरुपशोभितम् ।\nपादुकोपानहच्छत्र भाजनासन संयुतम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005804007, "chapter_id": 25804, "verse_number": "२७८-८", "content_sanskrit": "गवां दशक मध्ये स्यात् काञ्चनो नन्दिकेश्वरः ।\nकौशेयवस्त्रसम्वीतो नानाभरणभूषितः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005804008, "chapter_id": 25804, "verse_number": "२७८-९", "content_sanskrit": "लवणद्रोमशिखरे मालयेक्षु फलसंयुतः ।\nकुर्यात् पलशतादूर्ध्वं सर्वमेतदशेषतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005804009, "chapter_id": 25804, "verse_number": "२७८-१०", "content_sanskrit": "शक्तितः पलसाहस्र त्रितयं यावदेव तु ।\nगोशतेऽपि दशांशेन सर्वमेतत् समाचरेत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005804010, "chapter_id": 25804, "verse_number": "२७८-११", "content_sanskrit": "पुण्यकालं समासाद्य गीतमङ्गल निःस्वनैः ।\nसर्वौषध्युदकस्नान स्नापितो वेदपुङ्गवैः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005804011, "chapter_id": 25804, "verse_number": "२७८-१२", "content_sanskrit": "इममुच्चारयेन् मन्त्रं गृहीतकुसुमाञ्जलिः ।\nनमोऽस्तु विश्वमूर्तिभ्यो विश्वमातृभ्य एव च ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005804012, "chapter_id": 25804, "verse_number": "२७८-१३", "content_sanskrit": "लोकाधिवासिनीभ्यश्च रोहिणीभ्यो नमो नमः ।\nगवामङ्गेषु तिष्ठन्ति भुवनान्येकविंशतिः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005804013, "chapter_id": 25804, "verse_number": "२७८-१४", "content_sanskrit": "ब्रह्मादयस्तथा देवा रोहिण्यः पान्तु मातरः ।\nगावो मे अग्रतः सन्तु गावः पृष्ठत एव च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005804014, "chapter_id": 25804, "verse_number": "२७८-१५", "content_sanskrit": "गावः शिरसि मे नित्यं गवां मध्ये वसाम्यहम् ।\nयस्मात्त्वं वृषरूपेण धर्म एव सनातनः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005804015, "chapter_id": 25804, "verse_number": "२७८-१६", "content_sanskrit": "अष्टमूर्तेरधिष्ठानमतः पाहि सनातन! ।\nइत्यामन्त्र्य ततो दद्याद् गुरवे नन्दिकेश्वरम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005804016, "chapter_id": 25804, "verse_number": "२७८-१७", "content_sanskrit": "सर्वोपकरणोपेतं गोयुतञ्च विचक्षणः ।\nऋत्विग्भ्यो धेनुमेकैकां दशकाद्विनिवेदयेत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005804017, "chapter_id": 25804, "verse_number": "२७८-१८", "content_sanskrit": "गवाञ्च शतमेकैकं तदर्द्धं वाथ विंशतिम् ।\nदश पञ्चाथ वा दद्यादन्येभ्यस्तदनुज्ञया ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005804018, "chapter_id": 25804, "verse_number": "२७८-१९", "content_sanskrit": "नैका बहुभ्यो दातव्या यतो दोषकरी भवेत् ।\nबह्व्यश्चैकस्य दातव्या धीमतारोग्यवृद्धये ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005804019, "chapter_id": 25804, "verse_number": "२७८-२०", "content_sanskrit": "पयोव्रतः पुनस्तिष्ठेदेकाहं गोसहस्रदः ।\nश्रावयेच्छृणुयाद्वापि महादानानुकीर्तनम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005804020, "chapter_id": 25804, "verse_number": "२७८-२१", "content_sanskrit": "तद्दिने ब्रह्मचारी स्यात् यदीच्छेद्विपुलां श्रियम् ।\nअनेन विधिनायस्तु गोसहस्रप्रदो भवेत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005804021, "chapter_id": 25804, "verse_number": "२७८-२२", "content_sanskrit": "सर्वपाप विनिर्मुक्तः सिद्धचारणसेवितः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005804022, "chapter_id": 25804, "verse_number": "२७८-२३", "content_sanskrit": "विमानेनार्कवर्णेन किङ्किणीजालमालिना ।\nसर्वेषां लोकपालानां लोके संपूज्यतेऽमरैः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005804023, "chapter_id": 25804, "verse_number": "२७८-२४", "content_sanskrit": "प्रतिमन्वन्तरं तिष्ठेत् पुत्रपौत्रसमन्वितः ।\nसप्तलोकानतिक्रम्य ततः शिवपुरं व्रजेत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005804024, "chapter_id": 25804, "verse_number": "२७८-२५", "content_sanskrit": "शतमेकोत्तरन्तद्वत् पितॄणां तारयेद् बुधः ।\nमातामहानां तद्वच्च पुत्रपौत्रसमन्वितः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005804025, "chapter_id": 25804, "verse_number": "२७८-२६", "content_sanskrit": "यावत्कल्पशतन्तिष्ठेत् राजराजो भवेत् पुनः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005804026, "chapter_id": 25804, "verse_number": "२७८-२७", "content_sanskrit": "अश्वमेधशतं कुर्याच्छिवध्यानपरायणः ।\nवैष्णवं योगमास्थाय ततो मुच्येत बन्धनात् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005804027, "chapter_id": 25804, "verse_number": "२७८-२८", "content_sanskrit": "पितरश्चाभिनन्दन्ति गोसहस्रप्रदं सुतम् ।\nअपिस्यात्स कुलेऽस्माकं पुत्रो दौहित्र एव वा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005804028, "chapter_id": 25804, "verse_number": "२७८-२९", "content_sanskrit": "गोसहस्रप्रदो भूत्वा नरकादुद्धरिष्यति ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005804029, "chapter_id": 25804, "verse_number": "२७८-३०", "content_sanskrit": "तस्य कर्मकरो वा स्यादपि द्रष्टा तथैव च ।\nसंसारसागरादस्माद्योऽस्मान् सन्तारयिष्यति ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005804030, "chapter_id": 25804, "verse_number": "२७८-३१", "content_sanskrit": "इति पठति य एतत् गोसहस्रप्रदानं ।\nसुरभुवनमुपेयात् संस्मरेद्वाथ पश्येत् ।\nअनुभवति मुदं वा मुच्यमानो निकामं ।\nप्रहतकलुषदेह सोऽपि यातीन्द्रलोकम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]