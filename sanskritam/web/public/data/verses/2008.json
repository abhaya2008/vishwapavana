[{"id": 2045255, "chapter_id": 2008, "verse_number": "६-५७-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2045256, "chapter_id": 2008, "verse_number": "६-५७-१", "content_sanskrit": "ततो व्यूढेष्वनीकेषु तावकेषु परेषु च।\nधनञ्जयो रथानीकमवधीत्तव भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2045257, "chapter_id": 2008, "verse_number": "६-५७-२", "content_sanskrit": "शरैरथिरथो युद्धे दारयन्रथयूथपान् ।\nते वध्यमानाः पार्थेन कालेनेव युगक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2045258, "chapter_id": 2008, "verse_number": "६-५७-३", "content_sanskrit": "धार्तराष्ट्रा रणे यत्नात्पाण्डवान्प्रत्ययोधयन् ।\nप्रार्थयाना यशो दीप्तां मृत्युं कृत्वा निवर्तनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2045259, "chapter_id": 2008, "verse_number": "६-५७-४", "content_sanskrit": "एकाग्रमनसो भूत्वा पाण्डवानां वरूथिनीम् ।\nबभञ्जुर्बहुशो राजंस्ते चासञ्जन्त संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2045260, "chapter_id": 2008, "verse_number": "६-५७-५", "content_sanskrit": "द्रवद्भिरथभग्नैश्च परिवर्तद्भिरेव च।\nपाण्डवैः कौरवेयैश्च न प्राज्ञायत किंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2045261, "chapter_id": 2008, "verse_number": "६-५७-६", "content_sanskrit": "उदतिष्ठद्रजो भौमं छादयानं दिवाकरम्।\nन दिशः प्रदिशो वापि जज्ञिरेऽत्र समागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2045262, "chapter_id": 2008, "verse_number": "६-५७-७", "content_sanskrit": "अनुमानेन संज्ञाभिर्नामगोत्रैश्च संयुगे।\nअवर्तत तदा युद्धं तत्र तत्र विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2045263, "chapter_id": 2008, "verse_number": "६-५७-८", "content_sanskrit": "न व्यूहो भिद्यते तत्र कौरवाणां कथञ्चन ।\nरक्षितः सत्यसन्धेन भारद्वाजेन संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2045264, "chapter_id": 2008, "verse_number": "६-५७-९", "content_sanskrit": "तथैव पाण्डवानां च रक्षितः सव्यसाचिना।\nनाभिद्यत महाव्यूहो भीमेन च सुरक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2045265, "chapter_id": 2008, "verse_number": "६-५७-१०", "content_sanskrit": "सेनाग्रादपि निष्पत्य प्रायुध्यंस्तत्र मानवाः ।\nउभयोः सेनयो राजन्व्यतिषक्तरथद्विपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2045266, "chapter_id": 2008, "verse_number": "६-५७-११", "content_sanskrit": "हयारोहैर्हयारोहाः पात्यन्ते स्म महाहवे।\nऋष्टिभिर्विमलाभिश्च प्रासैरपि च संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2045267, "chapter_id": 2008, "verse_number": "६-५७-१२", "content_sanskrit": "रथी रथिनमासाद्य शरैः कनकभूषणैःक ।\nपातयामास समरे तस्मिन्नतिभयंकरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2045268, "chapter_id": 2008, "verse_number": "६-५७-१३", "content_sanskrit": "गजारोहा गजारोहान्नाराचशरतोमरैः ।\nसंसक्तान्पातयामासुस्तव तेषां च सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2045269, "chapter_id": 2008, "verse_number": "६-५७-१४", "content_sanskrit": "कश्चिदुत्पत्य समरे वस्वारणमास्थितः ।\nकेशपक्षे परामृश्य जहार समरे शिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2045270, "chapter_id": 2008, "verse_number": "६-५७-१५", "content_sanskrit": "अन्ये द्विरददन्ताग्रनिर्भिन्नहृदया रणे।\nवेमुश्च रुधिरं वीरा निःश्वसन्तः समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2045271, "chapter_id": 2008, "verse_number": "६-५७-१६", "content_sanskrit": "कश्चित्करिविषाणस्थो वीरो रणविशारदाः ।\nप्रावेपच्छक्तिनिर्भिन्नो गजशिक्षास्त्रवेदिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2045272, "chapter_id": 2008, "verse_number": "६-५७-१७", "content_sanskrit": "पत्तिमङ्घा रणे पक्तीन्भिमन्दिपालपरश्वथैः ।\nन्यतापतयन्त संहृष्टाः परस्परकृतागसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2045273, "chapter_id": 2008, "verse_number": "६-५७-१८", "content_sanskrit": "रथी च समरे राजन्नासाद्य गजयूथपम् ।\nस गजं पातयामास गजी च रथिनां वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2045274, "chapter_id": 2008, "verse_number": "६-५७-१९", "content_sanskrit": "रथिनं च हयारोहः प्रासेन भरतर्षभ ।\nपातयामास समरे रथी च हयसादिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2045275, "chapter_id": 2008, "verse_number": "६-५७-२०", "content_sanskrit": "पदाती रथिनं सङ्ख्ये रथी चापि पदातिनम् ।\nन्यपातयच्छितैः शस्त्रैः सेनयोरुभयोरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2045276, "chapter_id": 2008, "verse_number": "६-५७-२१", "content_sanskrit": "गजारोहा हयारोहान्पातयांचक्रिरे तदा।\nहयारोहा गजस्थांश्च तदद्भुतमिवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2045277, "chapter_id": 2008, "verse_number": "६-५७-२२", "content_sanskrit": "गजारोहवरैश्चापि तत्रतत्र पदातयः।\nपातिताः समदृश्यन्त तैश्चापि गजयोधिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2045278, "chapter_id": 2008, "verse_number": "६-५७-२३", "content_sanskrit": "पत्तिसङ्घा हयारोहैः सादिसङ्घाश्च पत्तिभिः ।\nपात्यमाना व्यदृश्यन्त शतशोऽथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2045279, "chapter_id": 2008, "verse_number": "६-५७-२४", "content_sanskrit": "ध्वजैस्तत्रापविद्धैश्च कार्मुकैस्तोमरैस्तथा।\nप्रासैस्तथा गदाभिश्च परिघैः कम्पनैस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2045280, "chapter_id": 2008, "verse_number": "६-५७-२५", "content_sanskrit": "शक्तिभिः कवचैश्चित्रैः कणपैरङ्कुशैरपि।\nनिस्त्रिंशैर्विमलैश्चापि स्वर्णपुङ्खैः शरैस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2045281, "chapter_id": 2008, "verse_number": "६-५७-२६", "content_sanskrit": "परिस्तोमैः कुथाभिश्च कम्बलैश्च महाधनैः ।\nभूर्भाति भरतश्रेष्ठ स्रग्दामैरिव चित्रिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2045282, "chapter_id": 2008, "verse_number": "६-५७-२७", "content_sanskrit": "नराश्वकायैः पतितैर्दन्तिभिश्च महाहवे ।\nअगम्यरूपा पृथिवी मांसशोणितकर्दमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2045283, "chapter_id": 2008, "verse_number": "६-५७-२८", "content_sanskrit": "प्रशशाम रजो भौमं व्युक्षितं रणशोणितैः ।\nदिशश्च विमलाः सर्वाः संबभूवुर्जनेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2045284, "chapter_id": 2008, "verse_number": "६-५७-२९", "content_sanskrit": "उत्थितान्यगणेयानि कबन्धानि समन्ततः।\nचिह्नभूतानि जगतो विनाशार्थाय भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2045285, "chapter_id": 2008, "verse_number": "६-५७-३०", "content_sanskrit": "तस्मिन्युद्धे महारौद्रे वर्तमाने सुदारुणे ।\nप्रत्यदृश्यन्त रथिनो धावमानाः समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2045286, "chapter_id": 2008, "verse_number": "६-५७-३१", "content_sanskrit": "ततो भीष्मश्च द्रोणश्च सैन्धवश्च जयद्रथः ।\nपुरुमित्रो जयो भोजः शल्यश्चापि ससौबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2045287, "chapter_id": 2008, "verse_number": "६-५७-३२", "content_sanskrit": "एते समरदुर्धर्षाः सिंहतुल्यपराक्रमाः।\nपाण्डवानामनीकानि बभञ्जुःस्म पुनःपुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2045288, "chapter_id": 2008, "verse_number": "६-५७-३३", "content_sanskrit": "तथैव भीमसेनोऽपि राक्षसश्च घटोत्कचः ।\nसात्यकिश्चेकितानश्च द्रोपदेयाश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2045289, "chapter_id": 2008, "verse_number": "६-५७-३४", "content_sanskrit": "तावकांस्तव पुत्रांश्च सहितान्सर्वराजभिः ।\nद्रावयामासुराजौ ते त्रिदशा दानवानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2045290, "chapter_id": 2008, "verse_number": "६-५७-३५", "content_sanskrit": "तथा ते समरेऽन्योन्यं निघ्नन्तः क्षत्रियर्षभाः ।\nरक्तोक्षिता घोररूपा विरेर्जुर्दानवा इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2045291, "chapter_id": 2008, "verse_number": "६-५७-३६", "content_sanskrit": "विनिर्जित्य रिपून्वीरा सेकनयोरुभयोरपि।\nव्यदृस्यन्त महामात्रा ग्रहा इव नभस्तले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2045292, "chapter_id": 2008, "verse_number": "६-५७-३७", "content_sanskrit": "ततो रथसहस्रेण पुत्रो दुर्योधनस्तव ।\nअभ्ययात्पाण्डवं युद्धे राक्षसं च घटोत्कचम् ॥ ६-५७-३८aतथैव पाण्डवाः सर्वे महत्या सेनया सह ।\nद्रोणभीष्मौ रणे यत्तौ प्रत्युद्ययुररिन्दमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2045293, "chapter_id": 2008, "verse_number": "६-५७-३९", "content_sanskrit": "किरीटी च ययौ क्रुद्धः समन्तात्पार्थिवोत्तमान् ।\nआर्जुनिः सात्यकिश्चैव ययतुः सौबलं बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2045294, "chapter_id": 2008, "verse_number": "६-५७-४०", "content_sanskrit": "ततः प्रववृते भूयः संग्रामो रोमहर्षणः ।\nतावकानां परेषां च समरे विजयैषिणाम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2045295, "chapter_id": 2008, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि तृतीयदिवसयुद्धे सप्तपञ्चशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]