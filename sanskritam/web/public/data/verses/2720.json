[{"id": 2080962, "chapter_id": 2720, "verse_number": "१२-२२५-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2080963, "chapter_id": 2720, "verse_number": "१२-२२५-१", "content_sanskrit": "किं कुर्वन्सुखमाप्नोति किं कुर्वन्दुःखमाप्नुयात्।\nकिं कुर्वन्निर्भयो लोके सिद्धश्चरति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2080964, "chapter_id": 2720, "verse_number": "१२-२२५-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2080965, "chapter_id": 2720, "verse_number": "१२-२२५-२", "content_sanskrit": "दममेव प्रशंसन्ति वृद्धाः श्रुतिसमाधयः।\nसर्वेषामेव वर्णानां ब्राह्मणस्य विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2080966, "chapter_id": 2720, "verse_number": "१२-२२५-३", "content_sanskrit": "नादान्तस्य क्रियासिद्धिर्यथावदुपपद्यते।\nक्रिया तपश्च देवाश्च दमे सर्वं प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2080967, "chapter_id": 2720, "verse_number": "१२-२२५-४", "content_sanskrit": "दमस्तेजो वर्धयति पवित्रं दम उच्यते।\nविपाष्मा निर्भयो दान्तः पुरुषो विन्दते महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2080968, "chapter_id": 2720, "verse_number": "१२-२२५-५", "content_sanskrit": "सुखं दान्तः प्रस्वपिति सुखं च प्रतिबुध्यते।\nसुखं लोके विपर्येति मनश्चास्य प्रसीदति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2080969, "chapter_id": 2720, "verse_number": "१२-२२५-६", "content_sanskrit": "तेजो दमन ध्रियते तत्र तीक्ष्णोऽधिगच्छति।\nअमित्रांश्च बहून्नित्यं पृथगात्मनि पश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2080970, "chapter_id": 2720, "verse_number": "१२-२२५-७", "content_sanskrit": "क्रव्याद्भ्य इव भूतानामदान्तेभ्यः सदा भयम्।\nतेषां विप्रतिषेधार्थं राजा सृष्टः स्वयंभुवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2080971, "chapter_id": 2720, "verse_number": "१२-२२५-८", "content_sanskrit": "आश्रमेषु च सर्वेषु दम एव विशिष्यते। १२-२२५-८b`धर्मः संरक्ष्यते तैस्तु यतस्ते धर्मसेतवः।\nयच्च तेषु फलं धर्म्यं भूयो दान्ते तदुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2080972, "chapter_id": 2720, "verse_number": "१२-२२५-९", "content_sanskrit": "तेषां लिङ्गानि वक्ष्यानि येषां समुदयो दमः।\nअकार्पण्यमसंरम्भः संतोषः श्रद्दधानता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2080973, "chapter_id": 2720, "verse_number": "१२-२२५-१०", "content_sanskrit": "अक्रोध आर्जवं नित्यं नातिवादोऽभिमानिता।\nगुरुपूजाऽनसूया च दया भूतेष्वपैशुनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2080974, "chapter_id": 2720, "verse_number": "१२-२२५-११", "content_sanskrit": "जनवादमृषावादस्तुतिनिन्दाविवर्जनम्।\nसाधुकामांश्च स्पृहयेन्नायतिं प्रत्ययेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2080975, "chapter_id": 2720, "verse_number": "१२-२२५-१२", "content_sanskrit": "अवैरकृत्सूपचारः समो निन्दाप्रशंसयोः।\nसुवृत्तः शीलसंपन्नः प्रसन्नात्माऽऽत्मवाञ्शुचिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2080976, "chapter_id": 2720, "verse_number": "१२-२२५-१३", "content_sanskrit": "प्राप्य लोके च सत्कारं स्वर्गं वै प्रेत्य गच्छति।\nदुर्गमं सर्वभूतानां प्रापयन्मोदते सुखी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2080977, "chapter_id": 2720, "verse_number": "१२-२२५-१४", "content_sanskrit": "सर्वभूतहिते युक्तो न स्म यो द्विषते जनम्।\nमहाह्रद इवाक्षोभ्यः प्राज्ञस्तृप्तः प्रसीदति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2080978, "chapter_id": 2720, "verse_number": "१२-२२५-१५", "content_sanskrit": "अभयं यस्य भूतेभ्यः सर्वेषामभयं यतः।\nनमस्यः सर्वभूतानां दान्तो भवति बुद्धिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2080979, "chapter_id": 2720, "verse_number": "१२-२२५-१६", "content_sanskrit": "न हृष्यति महत्यर्थे व्यसने च न शोचति।\nसदाऽपरिमितप्रज्ञः स दान्तो द्विज उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2080980, "chapter_id": 2720, "verse_number": "१२-२२५-१७", "content_sanskrit": "कर्मभिः श्रुतसंपन्नः सद्भिराचारेतः शुचिः।\nसदैव दमसंयुक्तस्तस्य भुङ्क्ते महाफलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2080981, "chapter_id": 2720, "verse_number": "१२-२२५-१८", "content_sanskrit": "अनसूयाऽक्षमा शान्तिः संतोषः प्रियवादिता।\nसत्यं दानमनायासो नैष मार्गो दुरात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2080982, "chapter_id": 2720, "verse_number": "१२-२२५-१९", "content_sanskrit": "कामक्रोधौ च लोभश्च परस्येर्ष्या विकत्थना।\n`अतुष्टिरनृतं मोह एष मार्गो दुरात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2080983, "chapter_id": 2720, "verse_number": "१२-२२५-२०", "content_sanskrit": "कामक्रोधौ वशे कृत्वा ब्रह्मचारी जितेन्द्रियः।\nविक्रम्य घोरे तमसि ब्राह्मणः संशितव्रतः।\nकालाकाङ्क्षी चरेल्लोकान्निरपाय इवात्मवान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2080984, "chapter_id": 2720, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि पञ्चविंशत्यधिकद्विशततमोऽध्यायः॥ २२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]