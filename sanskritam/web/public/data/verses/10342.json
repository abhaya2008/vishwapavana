[{"id": 6000342000, "chapter_id": 10342, "verse_number": null, "content_sanskrit": "अथ दशमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000342001, "chapter_id": 10342, "verse_number": null, "content_sanskrit": "शौनक उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_010/BhP_12.010.001.m4a", "display_order": 2}, {"id": 6000342002, "chapter_id": 10342, "verse_number": "१२-१०-१", "content_sanskrit": "अथेममर्थं पृच्छामो भवन्तं बहुवित्तमम्।\nसमस्ततन्त्रराद्धान्ते भवान् भागवततत्त्ववित्॥ १२/१०/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_010/BhP_12.010.002.m4a", "display_order": 3, "topics": [{"text": "पूजार्थं महापुरुषवर्णनम्", "range": "१–४२"}]}, {"id": 6000342003, "chapter_id": 10342, "verse_number": "१२-१०-२", "content_sanskrit": "तान्त्रिकाः परिचर्यायां केशवस्य श्रियः पतेः।\nअङ्गोपाङ्गायुधाकल्पं कल्पयन्ति यथैव यैः॥ १२/१०/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_010/BhP_12.010.003.m4a", "display_order": 4}, {"id": 6000342004, "chapter_id": 10342, "verse_number": "१२-१०-३", "content_sanskrit": "तान् नो वर्णय भद्रं ते क्रियायोगं बुभुत्सताम्।\nयेन क्रियानैपुणेन मर्त्यो यायादमर्त्यताम्॥ १२/१०/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_010/BhP_12.010.004.m4a", "display_order": 5}, {"id": 6000342005, "chapter_id": 10342, "verse_number": null, "content_sanskrit": "सूत उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_010/BhP_12.010.005.m4a", "display_order": 6}, {"id": 6000342006, "chapter_id": 10342, "verse_number": "१२-१०-४", "content_sanskrit": "नमस्कृत्वा गुरून् वक्ष्ये विभूतीर्वैष्णवीरपि।\nया वेदागमतन्त्राभ्यामाचार्यैः पद्मजादिभिः॥ १२/१०/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_010/BhP_12.010.006.m4a", "display_order": 7}, {"id": 6000342007, "chapter_id": 10342, "verse_number": "१२-१०-५", "content_sanskrit": "मायाद्यैर्नवभिस्तत्त्वैः सविकारैरयं विराट्।\nनिर्मितो दृश्यते यस्मिन् सचित्के भुवनत्रयम्॥ १२/१०/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_010/BhP_12.010.007.m4a", "display_order": 8}, {"id": 6000342008, "chapter_id": 10342, "verse_number": "१२-१०-६", "content_sanskrit": "एतद् वै पौरुषं रूपं भूः पादौ द्यौः शिरो नभः।\nनाभिः सूर्योऽक्षिणी नासे वायुः कर्णौ दिशः प्रभोः॥ १२/१०/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_010/BhP_12.010.008.m4a", "display_order": 9}, {"id": 6000342009, "chapter_id": 10342, "verse_number": "१२-१०-७", "content_sanskrit": "प्रजापतिः प्रजननमपानो मृत्युरीशितुः।\nतद्बाहवो लोकपाला मनश्चन्द्रो भ्रुवोर्यमः॥ १२/१०/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_010/BhP_12.010.009.m4a", "display_order": 10}, {"id": 6000342010, "chapter_id": 10342, "verse_number": "१२-१०-८", "content_sanskrit": "लज्जोत्तरोऽधरो लोभो द्युतिर्ज्योत्स्ना स्मयो भ्रमः।\nरोमाणि भूरुहा भूम्नो मेघाः पुरुषमूर्धजाः॥ १२/१०/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_010/BhP_12.010.010.m4a", "display_order": 11}, {"id": 6000342011, "chapter_id": 10342, "verse_number": "१२-१०-९", "content_sanskrit": "यावानयं स पुरुषो यावत्या संस्थया मितः।\nतावानसावपि महान् पुरुषो लोकसंस्थया॥ १२/१०/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_010/BhP_12.010.011.m4a", "display_order": 12}, {"id": 6000342012, "chapter_id": 10342, "verse_number": "१२-१०-१०", "content_sanskrit": "कौस्तुभव्यपदेशेन स्वात्मज्योतिर्बिभर्त्यजः।\nतत्प्रभा व्यापिनी साक्षाच्छ्रीवत्समुरसा विभुः॥ १२/१०/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_010/BhP_12.010.012.m4a", "display_order": 13}, {"id": 6000342013, "chapter_id": 10342, "verse_number": "१२-१०-११", "content_sanskrit": "स्वमायां वनमालाख्यां नानागुणमयीं दधत्।\nवासश्छन्दोमयं पीतं ब्रह्मसूत्रं त्रिवृत् स्वरम्॥ १२/१०/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_010/BhP_12.010.013.m4a", "display_order": 14}, {"id": 6000342014, "chapter_id": 10342, "verse_number": "१२-१०-१२", "content_sanskrit": "बिभर्ति साङ्ख्यं योगं च देवो मकरकुण्डले।\nमौलिं पदं पारमेष्ठ्यं सर्वलोकनमस्कृतम्॥ १२/१०/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_010/BhP_12.010.014.m4a", "display_order": 15}, {"id": 6000342015, "chapter_id": 10342, "verse_number": "१२-१०-१३", "content_sanskrit": "अव्याकृतमनन्ताख्यमासनं यदधिष्ठितम्।\nधर्मज्ञानादिभिर्युक्तं सत्त्वं पद्ममिहोच्यते॥ १२/१०/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_010/BhP_12.010.015.m4a", "display_order": 16}, {"id": 6000342016, "chapter_id": 10342, "verse_number": "१२-१०-१४", "content_sanskrit": "ओजस्सहोबलयुतं मुख्यतत्वं गदां दधत्।\nअपां तत्वं दरवरं तेजस्तत्वं सुदर्शनम्॥ १२/१०/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_010/BhP_12.010.016.m4a", "display_order": 17}, {"id": 6000342017, "chapter_id": 10342, "verse_number": "१२-१०-१५", "content_sanskrit": "नभोनिभं नभस्तत्वमसिं चर्म तमोमयम्।\nकालरूपं धनुः शार्ङ्गं तथा कर्ममयेषुधी॥ १२/१०/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_010/BhP_12.010.017.m4a", "display_order": 18}, {"id": 6000342018, "chapter_id": 10342, "verse_number": "१२-१०-१६", "content_sanskrit": "इन्द्रियाणि शरानाहुराकृतिरस्य स्यन्दनम्।\nतन्मात्राण्यस्याभिव्यक्तिरिन्द्रियार्थाः क्रिया मताः॥ १२/१०/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_010/BhP_12.010.018.m4a", "display_order": 19}, {"id": 6000342019, "chapter_id": 10342, "verse_number": "१२-१०-१७", "content_sanskrit": "मण्डलं देवयजनं दीक्षा संस्कार आत्मनः।\nपरिचर्या भगवत आत्मनो दुरितक्षयः॥ १२/१०/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_010/BhP_12.010.019.m4a", "display_order": 20}, {"id": 6000342020, "chapter_id": 10342, "verse_number": "१२-१०-१८", "content_sanskrit": "भगवान् भगशब्दात्मा लीलाकमलमुद्वहन्।\nधर्मं यशश्च भगवान् चामरव्यजनेऽभजत्॥ १२/१०/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_010/BhP_12.010.020.m4a", "display_order": 21}, {"id": 6000342021, "chapter_id": 10342, "verse_number": "१२-१०-१९", "content_sanskrit": "आतपत्रं तद्वैकुण्ठं निजधामाकुतोभयम्।\nत्रिवृद्वेदः सुपर्णाख्यो यज्ञं वहति पूरुषम्॥ १२/१०/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_010/BhP_12.010.021.m4a", "display_order": 22}, {"id": 6000342022, "chapter_id": 10342, "verse_number": "१२-१०-२०", "content_sanskrit": "अनपायिनी श्रीः साक्षादात्मभूता हरेः प्रभोः।\nनन्दादयोऽष्टौ द्वाःस्थाश्च तेऽणिमाद्या हरेर्गुणाः॥ १२/१०/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_010/BhP_12.010.022.m4a", "display_order": 23}, {"id": 6000342023, "chapter_id": 10342, "verse_number": "१२-१०-२१", "content_sanskrit": "वासुदेवः सङ्कर्षणः प्रद्युम्नः पुरुषः स्वयम्।\nअनिरुद्ध इति ब्रह्मन् मूर्तिव्यूहेऽभिधीयते॥ १२/१०/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_010/BhP_12.010.023.m4a", "display_order": 24}, {"id": 6000342024, "chapter_id": 10342, "verse_number": "१२-१०-२२", "content_sanskrit": "स विश्वतैजसप्राज्ञतुरीय इति वृत्तिभिः।\nअर्थेन्द्रियाशयज्ञानैर्भगवान् भाष्यते ततः॥ १२/१०/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_010/BhP_12.010.024.m4a", "display_order": 25}, {"id": 6000342025, "chapter_id": 10342, "verse_number": "१२-१०-२३", "content_sanskrit": "अङ्गोपाङ्गायुधाकल्पैर्भगवांस्तच्चतुष्टयम्।\nबिभर्ति स्म चतुमूर्तिर्भगवान् हरिरीश्वरः॥ १२/१०/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_010/BhP_12.010.025.m4a", "display_order": 26}, {"id": 6000342026, "chapter_id": 10342, "verse_number": "१२-१०-२४", "content_sanskrit": "द्विजवृषभ स एष ब्रह्मयोनिः स्वयं दृक् स्वमहिमपरिपूर्णो माययाऽऽद्यः स्वयैतत्।\nसृजति हरति पातीत्याख्ययाऽनावृताक्षो विसृजत इव निरुक्तस्तत्परैरात्मलभ्यः॥ १२/१०/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_010/BhP_12.010.026.m4a", "display_order": 27}, {"id": 6000342027, "chapter_id": 10342, "verse_number": "१२-१०-२५", "content_sanskrit": "श्रीकृष्ण कृष्णसख वृष्णिवृषावनिध्रुग्-राजन्यवंशदहनानपवर्गवीर्य।\nगोविन्द गोद्विजसुरार्तिहरावतार तीर्थश्रवःश्रवणमङ्गल पाहि भृत्यान्॥ १२/१०/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_010/BhP_12.010.027.m4a", "display_order": 28}, {"id": 6000342028, "chapter_id": 10342, "verse_number": "१२-१०-२६", "content_sanskrit": "य इदं कल्य उत्थाय महापुरुषलक्षणम्।\nतच्चित्तः प्रयतो जप्त्वा ब्रह्म वेद गुहाशयम्॥ १२/१०/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_010/BhP_12.010.028.m4a", "display_order": 29}, {"id": 6000342029, "chapter_id": 10342, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां द्वादशस्कन्धे दशमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]