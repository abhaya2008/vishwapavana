[{"id": 7001929000, "chapter_id": 21929, "verse_number": "१०८-१", "content_sanskrit": "वंशानुक्रमवर्णनम् ।\nमार्कण्डेय उवाच ।\nएवंप्रभावो भगवाननादिनिधनो रविः ।\nयस्य त्वं क्रौष्टुके भक्त्या माहात्म्यं परिपृच्छसि ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001929001, "chapter_id": 21929, "verse_number": "१०८-२", "content_sanskrit": "परमात्मा स योगिनां युञ्जतां चेतसां लयम् ।\nक्षेत्रज्ञः सांख्ययोगानां यज्ञेशो यज्विनामपि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001929002, "chapter_id": 21929, "verse_number": "१०८-३", "content_sanskrit": "सूर्याधिकारं वहतो विष्णोरीशस्य वेधसः ।\nमनुस्तस्याभवत्पुत्रश्छिन्नसर्वार्थसंशयः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001929003, "chapter_id": 21929, "verse_number": "१०८-४", "content_sanskrit": "मन्वन्तराधिपो विप्र यस्य सप्तममन्तरम् ।\nइक्ष्वाकुर्नाभगो रिष्टो महाबलपराक्रमः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001929004, "chapter_id": 21929, "verse_number": "१०८-५", "content_sanskrit": "नरिष्यन्तोऽथ नाभागः पृषध्रो धृष्ट एव च ।\nएते पुत्रा मनोस्तस्य पृथग्राज्यस्य पालकाः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001929005, "chapter_id": 21929, "verse_number": "१०८-६", "content_sanskrit": "विख्यातकीर्त्तयः सर्वे सर्वे शस्त्रास्त्रपारगाः ।\nविशिष्टतरमन्विच्छन्मनुः पुत्रं तथा पुनः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001929006, "chapter_id": 21929, "verse_number": "१०८-७", "content_sanskrit": "मित्रावरुणयोरिष्टिं चकार कृतिनां वरः ।\nयत्र चापहुते होतुरपचारान्महामुने ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001929007, "chapter_id": 21929, "verse_number": "१०८-८", "content_sanskrit": "इला नाम समुत्पन्ना मनोः कन्या सुमध्यमा ।\nतां दृष्ट्वा कन्यकां तत्र समुत्पन्नां ततो मनुः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001929008, "chapter_id": 21929, "verse_number": "१०८-९", "content_sanskrit": "तुष्टाव मित्रावरुणौ वाक्यं चेदमुवाच ह ।\nभवत्प्रसादात्तनयो विशिष्टो मे भवेदिति ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001929009, "chapter_id": 21929, "verse_number": "१०८-१०", "content_sanskrit": "कृते मखे समुत्पन्ना तनया मम धीमतः ।\nयदि प्रसन्नौ वरदौ तदियं तनया मम ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001929010, "chapter_id": 21929, "verse_number": "१०८-११", "content_sanskrit": "प्रसादाद्भवतो पुत्रो भवत्वतिगुणान्वितः ।\nतथेति चाभ्यामुक्ते देवाभ्यां सैव कन्यका ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001929011, "chapter_id": 21929, "verse_number": "१०८-१२", "content_sanskrit": "इला समभवत्सद्यः सुद्युम्न इति विश्रुतः ।\nपुनश्चेश्वरकोपेन मृगयामटता वने ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001929012, "chapter_id": 21929, "verse_number": "१०८-१३", "content_sanskrit": "स्त्रीत्वमासादितं तेन मनुपुत्रेण धीमता ।\nपुरूरवसनामानं चक्रवर्तिनमूर्जितम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001929013, "chapter_id": 21929, "verse_number": "१०८-१४", "content_sanskrit": "जनयामास तनयं यत्र सोमसुतो बुधः ।\nजाते सुते पुनः कृत्वा सोऽश्वमेधं महाक्रतुम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001929014, "chapter_id": 21929, "verse_number": "१०८-१५", "content_sanskrit": "पुरुषत्वमनुप्राप्तः सुद्युम्नः पार्थिवोऽभवत् ।\nसुद्युम्नस्य त्रयः पुत्रा उत्कलो विनयो गयः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001929015, "chapter_id": 21929, "verse_number": "१०८-१६", "content_sanskrit": "पुरुषत्वे महावीर्या यज्विनः पृथुलौजसः ।\nपुरुषत्वे तु ये जातास्तस्य राज्ञस्त्रयः सुताः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001929016, "chapter_id": 21929, "verse_number": "१०८-१७", "content_sanskrit": "बुभुजुस्ते महीमेतां धर्मे नियतचेतसः ।\nस्त्रीभूतस्य तु यो जातस्तस्य राज्ञः पुरूरवाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001929017, "chapter_id": 21929, "verse_number": "१०८-१८", "content_sanskrit": "न स लेभे महाभागं यतो बुधसुतो हि सः ।\nततो वसिष्ठवचनात्प्रतिष्ठानं पुरोत्तमम् ।\nतस्मै दत्तं स राजाभूत्तत्रातीव मनोहरे ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]