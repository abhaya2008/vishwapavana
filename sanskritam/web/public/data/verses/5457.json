[{"id": 2208601, "chapter_id": 5457, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2208602, "chapter_id": 5457, "verse_number": "१", "content_sanskrit": "भूतानामथ पञ्चानां सर्वेषामीश्वरं मनः ।\nनियमे च विसर्गे च भूतानां मन एव च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2208603, "chapter_id": 5457, "verse_number": "२", "content_sanskrit": "अधिष्ठातृ मनो नित्यं भूतानां महतां तथा ।\nबुद्धिमैश्वर्यमाचष्टे क्षेत्रज्ञः सर्व उच्यते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2208604, "chapter_id": 5457, "verse_number": "३", "content_sanskrit": "इन्द्रियाणि मनो युङ्क्ते सदश्वानिव सारथिः ।\nइन्द्रियाणि मनो बुद्धिः क्षेत्रज्ञे युज्यते सदा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2208605, "chapter_id": 5457, "verse_number": "४", "content_sanskrit": "भूतबुद्धिसमायुक्तं बुद्धिसंयमनं रथम् ।\nसमारुह्य स भूतात्मा समन्तात् परिधावति ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2208606, "chapter_id": 5457, "verse_number": "५", "content_sanskrit": "इन्द्रियग्रामसंयुक्तो मनः सारथिमेव च ।\nबुद्धिसंयमनो नित्यं महान् ब्रह्ममयो रथः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2208607, "chapter_id": 5457, "verse_number": "६", "content_sanskrit": "एवं यो वेत्ति विद्वान् वै सदा ब्रह्ममयं रथम् ।\nस धीरः सर्वलोकेषु न मोहमधिगच्छति ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2208608, "chapter_id": 5457, "verse_number": "७", "content_sanskrit": "अव्यक्तादिविशेषान्तं चरस्थावरसङ्कुलम् ।\nचन्द्रसूर्यप्रभालोकं ग्रहनक्षत्रमण्डितम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2208609, "chapter_id": 5457, "verse_number": "८", "content_sanskrit": "नदीपर्वतजालैश्च सर्वतः परिभूषितम् ।\nविविधाभिस्तथाऽद्भिश्च सततं समलङ्कृतम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2208610, "chapter_id": 5457, "verse_number": "९", "content_sanskrit": "अजितं सर्वभूतानां सर्वप्राणभृतां गतिः ।\nएतद् ब्रह्मपदं नित्यं क्षेत्रज्ञो यत्र तिष्ठति ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2208611, "chapter_id": 5457, "verse_number": "१०", "content_sanskrit": "लोकेऽस्मिन् यानि भूतानि स्थावराणि चराणि च ।\nतान्येवाग्रे प्रलीयन्ते पश्चाद् भूतकृता गुणाः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2208612, "chapter_id": 5457, "verse_number": "११", "content_sanskrit": "गुणेभ्यः पञ्च भूतानि एष भूतसमुच्छ्रयः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2208613, "chapter_id": 5457, "verse_number": "१२", "content_sanskrit": "देवा मनुष्या गन्धर्वाः पिशाचोरगराक्षसाः ।\nसर्वे स्वभावतः सृष्टा न क्रियाभ्यो न कारणात् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2208614, "chapter_id": 5457, "verse_number": "१३", "content_sanskrit": "एते विश्वकृतो विप्रा जायन्तीह पुनः पुनः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2208615, "chapter_id": 5457, "verse_number": "१४", "content_sanskrit": "तेभ्यः प्रसूतास्तेष्वेव महाभूतेषु पञ्चसु ।\nप्रलीयन्ते यथाकालमूर्मयः सागरे यथा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2208616, "chapter_id": 5457, "verse_number": "१५", "content_sanskrit": "विश्वसृग्भ्यस्तु(श्च) भूतेभ्यो महाभूतानि गच्छति ।\nभूतेभ्यश्चापि पञ्चभ्यो मुक्तो गच्छेत् परां गतिम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2208617, "chapter_id": 5457, "verse_number": "१६", "content_sanskrit": "प्रजापतिरिदं सर्वं तपसैवासृजत् प्रभुः ।\nतथैव देवानृषयस्तपसा प्रतिपेदिरे ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2208618, "chapter_id": 5457, "verse_number": "१७", "content_sanskrit": "तपसश्चानुपूर्व्येण फलमूलाशिनस्तथा ।\nत्रैलोक्यं तपसा सिद्धाः पश्यन्तीह समाहिताः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2208619, "chapter_id": 5457, "verse_number": "१८", "content_sanskrit": "औषधान्यगदादीनि नानाविद्याश्च सर्वशः ।\nतपसैव प्रसिद्ध्यन्ति तपोमूलं हि साधनम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2208620, "chapter_id": 5457, "verse_number": "१९", "content_sanskrit": "यद् दुरापं दुराम्नायं दुराधर्षं दुरन्वयम् ।\nतत्सर्वं तपसा साध्यं तपो हि दुरतिक्रमम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2208621, "chapter_id": 5457, "verse_number": "२०", "content_sanskrit": "सुरापो ब्रह्महा स्तेनो भ्रूणहा गुरुतल्पगः ।\nतपसैव सुतप्तेन मुच्यते किल्बिषात् ततः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2208622, "chapter_id": 5457, "verse_number": "२१", "content_sanskrit": "मनुष्याः पितरो देवाः पशवो मृगपक्षिणः ।\nयानि चान्यानि भूतानि चराणि स्थावराणि च ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2208623, "chapter_id": 5457, "verse_number": "२२", "content_sanskrit": "तपःपरायणा नित्यं सिद्ध्यन्ते तपसा सदा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2208624, "chapter_id": 5457, "verse_number": "२३", "content_sanskrit": "तथैव तपसा देवा महाभागा दिवं गताः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2208625, "chapter_id": 5457, "verse_number": "२४", "content_sanskrit": "आशीर्युक्तानि कर्माणि कुर्वते ये त्वतन्द्रिताः ।\nअहङ्कारसमायुक्ताः ते सकाशे प्रजापतेः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2208626, "chapter_id": 5457, "verse_number": "२५", "content_sanskrit": "ध्यानयोगेन शुद्धेन निर्ममा निरहङ्कृताः ।\nआप्नुवन्ति महात्मानो महान्तं लोकमुत्तमम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2208627, "chapter_id": 5457, "verse_number": "२६", "content_sanskrit": "ध्यानयोगमुपागम्य प्रसन्नमतयः सदा ।\nसुखोपायमव्यक्तं प्रविशन्त्यात्मवत्तया ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2208628, "chapter_id": 5457, "verse_number": "२७", "content_sanskrit": "ध्यानयोगादुपागम्य निर्ममा निरहङ्कृताः ।\nअव्यक्तं प्रविशन्तीह महतां लोकमुत्तमम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2208629, "chapter_id": 5457, "verse_number": "२८", "content_sanskrit": "अव्यक्तादेव सम्भूताः समयज्ञा गताः पुनः ।\nतमोरजोभ्यां निर्मुक्ताः सङ्गात् सञ्ज्ञां गताहि ते ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2208630, "chapter_id": 5457, "verse_number": "२९", "content_sanskrit": "निर्मुक्तः सर्वपापेभ्यः सर्वं त्यजति सर्वशः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2208631, "chapter_id": 5457, "verse_number": "३०", "content_sanskrit": "क्षेत्रज्ञ इति तं चिन्त्यात् यस्तं वेद स वेदवित् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2208632, "chapter_id": 5457, "verse_number": "३१", "content_sanskrit": "चित्तं चित्तादुपागम्य मुनिरासीत संयतः ।\nतच्चित्तस्तन्मना भूत्वा ग्राह्यमेतत् सनातनम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2208633, "chapter_id": 5457, "verse_number": "३२", "content_sanskrit": "अव्यक्तादिविशेषान्तमविद्यालक्षणं स्मृतम् ।\nनिबोधत यथा हीनं गुणैर्लक्षणमित्युत ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2208634, "chapter_id": 5457, "verse_number": "३३", "content_sanskrit": "द्व्यक्षरस्तु भवेन्मृत्युः त्र्यक्षरं ब्रह्म शाश्वतम् ।\nममेति हि भवेन्मृत्युर्न ममेति हि शाश्वतम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2208635, "chapter_id": 5457, "verse_number": "३४", "content_sanskrit": "कर्म केचित् प्रशंसन्ति मन्दबुद्धिरता नराः ।\nये तु बुद्ध्या महात्मानो न प्रशंसन्ति कर्म ते ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2208636, "chapter_id": 5457, "verse_number": "३५", "content_sanskrit": "कर्मणा जायते जन्तुर्मूर्तिमान् षोडशात्मकः ।\nपुरुषं व्रजतेऽविद्या अग्राह्यममृताशिनम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2208637, "chapter_id": 5457, "verse_number": "३६", "content_sanskrit": "तस्मात् कर्मसु निःस्नेहा ये केचित् पारदर्शिनः ।\nविद्यामयोऽयं पुरुषो न तु कर्ममयः स्मृतः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2208638, "chapter_id": 5457, "verse_number": "३७", "content_sanskrit": "अपूर्वममृतं नित्यं स्वयैनमभिचारिणम् ।\nय एनं विन्दते त्मानममेयमविनाशिनम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2208639, "chapter_id": 5457, "verse_number": "३८", "content_sanskrit": "अग्राह्यो ह्यमृतो भवति स एभिः कारणैर्ध्रुवम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2208640, "chapter_id": 5457, "verse_number": "३९", "content_sanskrit": "अपोह्य सर्वसङ्कल्पान् संयम्यात्मानमात्मनि ।\nस तद् ब्रह्म शुभं वेत्ति यस्माद् भूयो न विद्यते ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2208641, "chapter_id": 5457, "verse_number": "४०", "content_sanskrit": "प्रसादेन हि(च) सत्त्वस्य प्रसादं समवाप्नुयात् ।\nलक्षणं हि प्रसादस्य यथा स्यात् स्वप्नदर्शनम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2208642, "chapter_id": 5457, "verse_number": "४१", "content_sanskrit": "गतिरेषा तु मुक्तानां ये ज्ञानपरिनिष्ठिताः ।\nप्रवृत्तयश्च याः सर्वाः पश्यन्ति परिणामजाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2208643, "chapter_id": 5457, "verse_number": "४२", "content_sanskrit": "एषा गतिरसक्तानामेष धर्मः सनातनः ।\nएषा ज्ञानवतां प्राप्तिः एतद् वृत्तमनिन्दितम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2208644, "chapter_id": 5457, "verse_number": "४३", "content_sanskrit": "समेन सर्वभूतेषु निस्पृहेण निराशिषा ।\nशक्या गतिरियं गन्तुं सर्वत्र समदर्शिना ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2208645, "chapter_id": 5457, "verse_number": "४४", "content_sanskrit": "एतद् सर्वमाख्यातं मया विप्रर्षिसत्तमाः ।\nएवमाचरत क्षिप्रं ततः सिद्धिमवाप्स्यथ ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2208646, "chapter_id": 5457, "verse_number": "", "content_sanskrit": "गुरुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2208647, "chapter_id": 5457, "verse_number": "४५", "content_sanskrit": "इत्युक्ता गुरुणा ते तु ब्राह्मणा मुनयस्तथा ।\nकृतवन्तो महात्मानस्ततो लोकमवाप्नुवन् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2208648, "chapter_id": 5457, "verse_number": "४६", "content_sanskrit": "त्वमप्येवं महाभाग यथोक्तं ब्रह्मणो वचः ।\nसम्यगाचर शुद्धात्मन् ततः सिद्धिमवाप्स्यसि ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2208649, "chapter_id": 5457, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2208650, "chapter_id": 5457, "verse_number": "४७", "content_sanskrit": "इत्युक्तः स तदा शिष्यो गुरुणा धर्ममुत्तमम् ।\nचकार सर्वं कौन्तेय ततो मोक्षमवाप्तवान् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2208651, "chapter_id": 5457, "verse_number": "४८", "content_sanskrit": "कृतकृत्यश्च स तदा शिष्यः कुरुकुलोद्वह ।\nतत्पदं समनुप्राप्तो यत्र गत्वा न शोचति ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2208652, "chapter_id": 5457, "verse_number": "४९", "content_sanskrit": "त्वमप्येतन्महाभाग यथोक्तं ब्रह्मणो वचः ।\nसम्यगाचर शुद्धात्मन् ततः सिद्धिमवाप्स्यसि ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2208653, "chapter_id": 5457, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2208654, "chapter_id": 5457, "verse_number": "५०", "content_sanskrit": "को न्वसौ ब्राह्मणः कृष्ण कश्च शिष्यो जनार्दन ।\nज्ञातव्यं चेन्मयैतद् वै तन्ममाचक्ष्व मे विभो ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2208655, "chapter_id": 5457, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2208656, "chapter_id": 5457, "verse_number": "५१", "content_sanskrit": "अहं गुरुर्महाबाहो मनः शिष्यो हि विद्धि मे ।\nत्वत्प्रीत्या सर्वमेतद् वै कथितं ते धनञ्जय ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2208657, "chapter_id": 5457, "verse_number": "५२", "content_sanskrit": "मयि चेदस्ति ते भक्तिर्नित्यं कुरुकुलोद्वह ।\nअध्यात्ममेतच्छ्रुत्वा त्वं सम्यगाचर सुव्रत ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2208658, "chapter_id": 5457, "verse_number": "५३", "content_sanskrit": "ततस्त्वं सम्यगाचारो धर्मेऽस्मिन् कुरुनन्दन ।\nसर्वपापविशुद्धात्मा मोक्षं प्राप्स्यसि केवलम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2208659, "chapter_id": 5457, "verse_number": "५४", "content_sanskrit": "पूर्वमप्येतदेवोक्तं युद्धकाल उपस्थिते ।\nमया तव महाबाहो तस्मादत्र मनः कुरु ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2208660, "chapter_id": 5457, "verse_number": "५५", "content_sanskrit": "मया तु भरतश्रेष्ठ चिरदृष्टः पिता विभो ।\nतमहं द्रष्टुमिच्छामि सम्मते तव फल्गुन ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2208661, "chapter_id": 5457, "verse_number": "५६", "content_sanskrit": "इत्युक्तवचनं कृष्णं प्रत्युवाच धनञ्जयः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2208662, "chapter_id": 5457, "verse_number": "५७", "content_sanskrit": "यदिष्टं कुरु सर्वस्यापीश्वरोऽस्मान् प्रपालय ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2208663, "chapter_id": 5457, "verse_number": "५८", "content_sanskrit": "नमस्ते सर्वलोकात्मन् नारायण परात्पर ।\nमनोमलात् तपोऽशक्यं कर्म चाविद्यया तथा ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2208664, "chapter_id": 5457, "verse_number": "५९", "content_sanskrit": "दानमप्यर्थदोषेण नाम तस्मात् कलौ स्मरेत् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2208665, "chapter_id": 5457, "verse_number": "६०", "content_sanskrit": "यदि गन्तुं कृता बुद्धिर्वासुदेव नमोऽस्तु ते ।\nगच्छावो नगरं कृष्ण गजसाह्वयमद्य वै ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2208666, "chapter_id": 5457, "verse_number": "६१", "content_sanskrit": "समेत्य तत्र राजानं धर्मात्मानं युधिष्ठिरम् ।\nसमनुज्ञाप्य दुर्धर्षं स्वां पुरीं यातुमर्हसि ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2208667, "chapter_id": 5457, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि अनुगीतासु गुरुशिष्यसंवादे तपःसामर्थ्यकथनं नाम एकपञ्चाशोऽध्यायः ॥५१॥\nअनुगीतापर्वणि षट्त्रिंशोऽध्यायः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2208668, "chapter_id": 5457, "verse_number": "", "content_sanskrit": "॥ अनुगीता समाप्ता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]