[
  {
    "id": 20006048,
    "chapter_id": 6633,
    "verse_number": "3.1",
    "content_sanskrit": "कौबेरदिग्भागमपास्य मार्गमागस्त्यमिव आशुःइव अवतार्णः । अपेतयुद्धाभिनिवेशसौम्यो हरिहरप्रस्थमथ प्रतस्थे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20006049,
    "chapter_id": 6633,
    "verse_number": "3.2",
    "content_sanskrit": "जगत्पवित्रैःअपि तं न पादैः स्प्रष्टुं जगत्पूज्यमयुज्यत अर्कः । यतः बृहत्पार्वणचारु तस्यातपत्रं बिभरांबभूवे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20006050,
    "chapter_id": 6633,
    "verse_number": "3.3",
    "content_sanskrit": "मृणालसूत्रामलमन्तरेण स्थितश्चलचामरयोर्द्वयं सः । भेजेऽभितःपातुकसिद्धसिन्धोरभूतपूर्वां रुचमम्बुराशेः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20006051,
    "chapter_id": 6633,
    "verse_number": "3.4",
    "content_sanskrit": "चित्राभिरस्योपरि मौलिभाजां भाभिर्मणीनामणीयसीभिः । अनेकधातुच्छुरिताश्मराशेर्गोवनर्धनस्याकृतिरन्वकारि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20006052,
    "chapter_id": 6633,
    "verse_number": "3.5",
    "content_sanskrit": "तस्योल्लसत्काञ्चनकुण्डलाग्रप्रत्युप्तगारुग्मतरस्रभासा । अवाप बाल्योचितनीलकण्ठपिच्छावचूडाकलनामिवोरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20006053,
    "chapter_id": 6633,
    "verse_number": "3.6",
    "content_sanskrit": "तमङ्गदे मन्दरकूटकोटिव्याघट्टनोत्तेजनतया मणीनाम् । बंहीयसा दीप्तिवितानकेन चकासयामासतुरुल्लसन्ती ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20006054,
    "chapter_id": 6633,
    "verse_number": "3.7",
    "content_sanskrit": "निसर्गरक्तैर्वलयावनद्धताम्राश्मरश्मिच्छुरितैर्नखाग्रैः । व्यद्योताद्यापि सुरारिवक्षोविक्षोभजासृक्स्नपितैरिवासो ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20006055,
    "chapter_id": 6633,
    "verse_number": "3.8",
    "content_sanskrit": "उभौयदि व्योम्नि पृथक्प्रवाहावाकाशगङ्गापयसः पतेताम् । तेनोपमीयते तमालनीलमामुक्तमुक्तालतमस्य वक्षः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20006056,
    "chapter_id": 6633,
    "verse_number": "3.9",
    "content_sanskrit": "तेनाम्भसां सारसमयः पयोधेर्दधे मणिदीधितिदीपिताशः । अन्तर्वसन्बिम्बगतस्तदङ्गे साक्षादिवालक्ष्यत यत्र लोकः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20006057,
    "chapter_id": 6633,
    "verse_number": "3.10",
    "content_sanskrit": "मुक्तामयं सारसानावलम्बिसभाति स्म दामाप्रपदीयमानस्य । अङ्गुष्ठनिष्ठ्यूतमिवोर्ध्वमुच्चैस्त्रिसस्रोतसः संततधारामम्भः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20006058,
    "chapter_id": 6633,
    "verse_number": "3.11",
    "content_sanskrit": "स इन्द्रनीलसस्थलनीलमूर्ती रराज कर्पूरपिशङ्गवासाः । विसृत्वरैरम्बुरुहां रजोभिर्यमस्वसुश्चित्र इवोदभारः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20006059,
    "chapter_id": 6633,
    "verse_number": "3.12",
    "content_sanskrit": "प्रसाधितस्यास्य मुधाद्विषोऽभूदन्यैव लक्ष्मीरिति युक्तमेतत् । वपुष्यशेषेऽखिललोककान्ता सानन्यकान्ता ह्युरसीतरा तु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20006060,
    "chapter_id": 6633,
    "verse_number": "3.13",
    "content_sanskrit": "कपाटविस्तीर्णमनोरमोरःस्थलस्थितश्रीललनस्य तस्य । आनन्दिताशेषजना बभूव सर्वङ्गसङ्गिन्यपरैव लक्ष्मीः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20006061,
    "chapter_id": 6633,
    "verse_number": "3.14",
    "content_sanskrit": "प्राणच्छिदां दैत्यपतेर्नखानामुपेयुषां भूषणतां क्षतेन । प्रकाशकार्कश्यगुणै दधानाः स्तनौ तरुण्यः परिव्रुरेनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20006062,
    "chapter_id": 6633,
    "verse_number": "3.15",
    "content_sanskrit": "आकर्षतेवोर्ध्वमतिक्रशीयानत्युन्नतत्वात्कुचमण्डलेन । ननाम मध्योऽतिगुरुत्वभाजा नितान्तमाक्रान्त इवाङ्गनानाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20006063,
    "chapter_id": 6633,
    "verse_number": "3.16",
    "content_sanskrit": "यां यां प्रियः प्रैक्षत कातराश्क्षीं सा सा ह्रिया नम्रमुखी बभूव । निःःशङ्गमन्या सममाहितेर्ष्यास्तत्रान्तरे जघ्रुरमुं कटाक्षैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20006064,
    "chapter_id": 6633,
    "verse_number": "3.17",
    "content_sanskrit": "तस्यातसीसून समानभासो भ्राम्यन्मयूखावलीमण्डलेन । चक्रेण रेजे यमुनाजलौघः स्फुरन्महागर्त इवैकबाहुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20006065,
    "chapter_id": 6633,
    "verse_number": "3.18",
    "content_sanskrit": "विरोधिनां विग्रहभेददक्षा मूर्तेव शक्तिः क्वचितस्खलन्ती । नित्यं हरेः संनिहिता निकामं मोदयति स्म चेतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20006066,
    "chapter_id": 6633,
    "verse_number": "3.19",
    "content_sanskrit": "न केवलं यः स्वतया मुरारेरसाधारणतां दधानः । अत्यर्थमुद्वेजयिता परेषां नाम्नापि तस्यैव नन्दकोऽभूत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20006067,
    "chapter_id": 6633,
    "verse_number": "3.20",
    "content_sanskrit": "न नीतमन्येन नतिं कदाचिकर्णान्तिकप्रप्तगुणं क्रयासु । विधेयमस्या भवदन्तिकस्थं शार्ङ्गं धनुर्मित्रमिव द्रढीयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20006068,
    "chapter_id": 6633,
    "verse_number": "3.21",
    "content_sanskrit": "प्रवृद्धमन्द्राम्बुदधीरनादः कृष्णार्णवाभ्यर्णचरैकहंसः । मनेदानिलापूरकृतं दधानो निध्वानमश्रूयत पाञ्चजन्यः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20006069,
    "chapter_id": 6633,
    "verse_number": "3.22",
    "content_sanskrit": "रराज संपादकमिष्टसिद्धेः सर्वासु दिक्ष्वप्रसिद्घमार्गम् । महारथः पुष्यरथं रथाङ्गी क्षिप्रं क्षपानाथ इवाधिरूढः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20006070,
    "chapter_id": 6633,
    "verse_number": "3.23",
    "content_sanskrit": "ध्वजाग्रधामा ददृशेऽथशौरैः संक्रन्तमूर्तिर्मणिमेदिनीषु । फणावतस्त्रासयितुं रसायास्तलं विवक्षन्निव पन्नगारिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20006071,
    "chapter_id": 6633,
    "verse_number": "3.24",
    "content_sanskrit": "यियासतस्तस्य महीधरन्ध्रभिदपटीयान्पटहप्रणादः । जलान्तराणीव महार्णवौघः शशब्दान्तराण्यन्तरायाञ्चकार ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20006072,
    "chapter_id": 6633,
    "verse_number": "3.25",
    "content_sanskrit": "यतः स भर्ता जगतां जगाम धर्त्रा धरित्र्याः फणिनाततोऽधः । महाभराभुग्नशिरःसहस्रसहायकव्यग्रभुजं प्रसस्रे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20006073,
    "chapter_id": 6633,
    "verse_number": "3.26",
    "content_sanskrit": "अथोच्चकैस्तोरणसङ्गभङ्गभयावनम्राकृतकेतनानि । क्रियाफलानीव सुनीतिभाजं सैन्यानि सोमान्वयन्वयुस्तम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20006074,
    "chapter_id": 6633,
    "verse_number": "3.27",
    "content_sanskrit": "श्यामारुणैर्वारणदानतोयैरालोडिताः काञ्ञ्चनभूपराः । आनेमि मग्नैः शितिकण्ठपक्षक्षोदद्युतश्चुक्षुदिरे रथौघैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20006075,
    "chapter_id": 6633,
    "verse_number": "3.28",
    "content_sanskrit": "न लङ्घयामास महाजनानां शिरांसि नैवोद्धतिमाजगाम । अचेष्टताष्टापदभूमिरेणुः पदाहतो यत्सदृशं गरिम्णः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20006076,
    "chapter_id": 6633,
    "verse_number": "3.29",
    "content_sanskrit": "निरुद्ध्यमाना यदुभिः कथञ्चिन्मुहुर्यदुच्चिक्षिपुरग्रपादान् । ध्रुवं गुरून्मार्गरुधः करान्द्रानुल्लङ्घ्य गन्तुं तुरगास्ततीषुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20006077,
    "chapter_id": 6633,
    "verse_number": "3.30",
    "content_sanskrit": "अवेक्षितानायतवल्गमग्रे तुरङ्गिभिर्यत्ननिरुद्धवाहैः । प्रकीडितान्रेणुभिरेत्य तूर्णं निन्ययुर्जनन्यः पृथुकान्पथिभ्यः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20006078,
    "chapter_id": 6633,
    "verse_number": "3.31",
    "content_sanskrit": "दिदृक्षमाणः प्रतिरथ्यमीयुर्मुरारिमारादनघं जनौघाः । अनेकशः संस्तुतमप्यनल्पा नवं नवं प्रतिरहो करोति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20006079,
    "chapter_id": 6633,
    "verse_number": "3.32",
    "content_sanskrit": "उपेयुषो वर्त्म निरन्तराभिरसौ निरुच्छ्वासमनीकनीभिः । रथस्य तस्यां पुरि दत्तचक्षुर्विद्वान्विदामास शनैर्न यातम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20006080,
    "chapter_id": 6633,
    "verse_number": "3.33",
    "content_sanskrit": "मध्येसमुद्रं ककुभः पिशङ्गीर्या कुर्वती काञ्चनवप्रभासा । तुरङ्गकान्तामुखहव्यवाहज्वालेव भित्वा जलमुल्ललास ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20006081,
    "chapter_id": 6633,
    "verse_number": "3.34",
    "content_sanskrit": "कृतास्पदा भूमिभृतां सहस्रैरुदन्वदम्भःपरिवीतमूर्तिः । अनिर्विदा या विदधे विधात्रा पृथिवी पृथिव्याः प्रतियातनेव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20006082,
    "chapter_id": 6633,
    "verse_number": "3.35",
    "content_sanskrit": "त्वष्टुः सदाभ्यासगृहीतशिल्पविदज्ञानसंपत्प्रसरस्य सीमा । अदृश्यतादर्शतलामलेषु छायेव या स्वर्जलधेर्जलेषु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20006083,
    "chapter_id": 6633,
    "verse_number": "3.36",
    "content_sanskrit": "रथाङ्गभर्त्रेऽभिनवं वराय यस्याः पितेव प्रतिपादितायाः । प्रेम्णोपकण्ठं मुहुरङ्गभाजो रत्नवलीरम्बुधिराबबन्ध ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20006084,
    "chapter_id": 6633,
    "verse_number": "3.37",
    "content_sanskrit": "यस्याश्चलद्वारिधिवीचिछ्छटोच्छलच्छङ्खकुलाकुलेन । वप्रेण पर्न्तचरोडुचक्रः सुमेरुवप्रोऽहमन्वकारि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20006085,
    "chapter_id": 6633,
    "verse_number": "3.38",
    "content_sanskrit": "वणिक्पथे पूगकृतानि यत्र भ्रमागतैरम्बुभिरम्बुराशिः । लोलैरलोद्युतिभाञ्जि मुष्णन्रत्नानि रत्नाकरतामवाप ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20006086,
    "chapter_id": 6633,
    "verse_number": "3.39",
    "content_sanskrit": "अम्भुच्युतः कोमलरत्नराशीनपांनिधिः फेनपिनद्धभासः । त्रातपे दातुमिवाधितल्पं विस्तारायमास तरङ्गहस्तैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20006087,
    "chapter_id": 6633,
    "verse_number": "3.40",
    "content_sanskrit": "यच्छालमुत्तङ्गतया विजेतुं दूरादुदस्थीयत सागरस्य । महोर्मिभिव्याहतवाञ्छितार्थैर्वीडादिवाभ्याशगतैर्विलिल्ये ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20006088,
    "chapter_id": 6633,
    "verse_number": "3.41",
    "content_sanskrit": "कुतूहलेन जवादुपेत्य प्राकारभित्या सहसा निषिद्धः । रसन्नरोदीद्भृशमम्बुवर्षव्याजेन यस्या बहिरम्बुवाहः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20006089,
    "chapter_id": 6633,
    "verse_number": "3.42",
    "content_sanskrit": "यदङ्गनरूपसरूपतायाः कञ्चिद्गुणं भेदकमिच्छतीभिः । आराधितोऽद्धा मनुरप्सरोभिश्चक्रे प्रजाः स्वाः सनिमेषचिह्नाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20006090,
    "chapter_id": 6633,
    "verse_number": "3.43",
    "content_sanskrit": "स्फुरत्तुषारांशुमरीचिजालैर्विनुह्नुताः स्फटिकपङ्क्तीः । आरुह्य नार्यः क्षणदासु यत्र नभोगता देव्य इव व्याराजन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20006091,
    "chapter_id": 6633,
    "verse_number": "3.44",
    "content_sanskrit": "कान्तेन्दुकान्तोपलकुट्टिमेषु प्रतिक्षपं हर्म्यतलेषु यत्र । उच्चैरधपातिपयोमुचोऽपि समूहमूहुः पययसां प्रणाल्यः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20006092,
    "chapter_id": 6633,
    "verse_number": "3.45",
    "content_sanskrit": "रतौ ह्रिया यत्र निशाम्यदीपाञ्जालगताभ्योऽधिगृहं गृहिण्यः । बिभ्युर्बिडालेक्षणभीषणाभ्यो वैदूर्यकुड्येषु शशिद्युतिभ्यः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20006093,
    "chapter_id": 6633,
    "verse_number": "3.46",
    "content_sanskrit": "यस्यामतिश्लक्षणतया गृहेषु विधातुमालेख्यमशुक्नुवन्तः । चक्रुर्युवानः प्रतिबिम्बिताङ्गाः सजीवचित्रा इव रत्नभित्तीः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20006094,
    "chapter_id": 6633,
    "verse_number": "3.47",
    "content_sanskrit": "सावर्ण्यभाजां प्रतिमागतानां लक्ष्यैः स्मरपाण्डुतयाङ्गनानाम् । यस्यां कपोलैः कलधौतधामस्तम्भेषु भेजे मणिदर्पणश्रीः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20006095,
    "chapter_id": 6633,
    "verse_number": "3.48",
    "content_sanskrit": "शुकाङ्गनीलोपलनिर्मितानां लिप्तेषु भासा गृहदेहलीनां । यस्यामलिन्देषु न चक्रुरेव मुग्धाङ्गना गोमयगोमुखानि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20006096,
    "chapter_id": 6633,
    "verse_number": "3.49",
    "content_sanskrit": "गोपानसीषु क्षणमास्थितानामालम्बिभिश्चन्द्रकाणां कलापैः । हरिन्मणिश्यामतृणाभिरामैगृहाणि नीध्रैरिव यत्र रेजुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20006097,
    "chapter_id": 6633,
    "verse_number": "3.50",
    "content_sanskrit": "बृहत्तुलैरपिप्यतुलैर्वतानमालापिनद्धैरपि चावितानै । रेजे विचित्रैरपि या सचित्रैगृहैर्विशालैरपि भूरिशालै ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20006098,
    "chapter_id": 6633,
    "verse_number": "3.51",
    "content_sanskrit": "चिक्रंसया कृत्रिमपत्त्रिपङ्क्तेः कपोतपालीषु निकेतनानां । मार्जारमप्यातनिश्चलाङ्कं यस्यां जनः कृत्रिममेव मेने ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20006099,
    "chapter_id": 6633,
    "verse_number": "3.52",
    "content_sanskrit": "क्षितिप्रतिष्ठोपि मुखारविन्दैर्वधूजनश्चन्द्रमधश्चकार । अतीतनक्षत्रपथानि यत्र प्रसादशृङ्गाणि वृथाध्यरुक्षत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20006100,
    "chapter_id": 6633,
    "verse_number": "3.53",
    "content_sanskrit": "रम्या इति प्राप्तवतीः पताका रागं विविक्ता इति वर्धयन्तीः । यस्यामसेवन्त नमद्वलीकाः समं वधूभिर्वलभीर्युवानः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20006101,
    "chapter_id": 6633,
    "verse_number": "3.54",
    "content_sanskrit": "सुगन्धितामप्रतियत्नपूर्वां बिभ्रन्ति यत्र प्रमदाय पुंसाम् । मधूनि वक्त्राणि च कामिनीनामामोदकर्मव्यतिहारमीयुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20006102,
    "chapter_id": 6633,
    "verse_number": "3.55",
    "content_sanskrit": "रतान्तरे यत्र गृहान्तरेषु वितर्दिनिर्यूहविटङ्नीडः । रुतानिश्रुण्वन्वयसां गणोऽन्तेवासित्वमाप स्फुटमङ्गनानाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20006103,
    "chapter_id": 6633,
    "verse_number": "3.56",
    "content_sanskrit": "छन्नेऽपि स्पष्टतरेषु यत्र स्वच्छानि नारीकुचमण्डलेषु । आकाशसाम्यं दधुरम्बराणि न नामतः केवलमर्थतःऽपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20006104,
    "chapter_id": 6633,
    "verse_number": "3.57",
    "content_sanskrit": "यस्यामजिह्मा महतीमपङ्गाः सीमानमत्यायतयोऽत्यजन्तः । जनैरजास्खलनै जातु द्वयेप्यमुच्यन्त विनीतमार्गाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20006105,
    "chapter_id": 6633,
    "verse_number": "3.58",
    "content_sanskrit": "परस्पस्फर्धिपरार्घ्यरूपाः पौरस्त्रियो यत्र विधाय वेधाः । श्रीनिर्मितप्राप्तगुणक्षतैकवर्णोपमावाच्यमलं ममार्ज ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20006106,
    "chapter_id": 6633,
    "verse_number": "3.59",
    "content_sanskrit": "क्षुण्णं यदन्तःकरणेनवृक्षाः फलन्ति कल्पोपदास्तदेव । अध्यूषुषो यामभवञ्जनस्य याः सम्पदस्ता मनसोऽप्यगम्याः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20006107,
    "chapter_id": 6633,
    "verse_number": "3.60",
    "content_sanskrit": "कला दधानः सकलाः स्भाभिरुद्भासयन्सौधसिताभिराशाः । यां रेवतीजानिरियेष हातुं न रौहिणीयो न च रोहिणीशः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20006108,
    "chapter_id": 6633,
    "verse_number": "3.61",
    "content_sanskrit": "बाणाहवव्याहतशंभुशक्तेरासत्तिमासाद्य जनार्दनस्य । शरीरिणा जैत्रशरेण यत्र निःशङ्घमूषे मकरध्वजेन ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20006109,
    "chapter_id": 6633,
    "verse_number": "3.62",
    "content_sanskrit": "निषेव्यमाणेन शिवैमरुद्भिरध्यास्यमाना हरिणा चिराय । उद्रश्मिरत्नाङ्कुरधाम्नि सिन्धावाहास्त मेरावमरावतीं या ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20006110,
    "chapter_id": 6633,
    "verse_number": "3.63",
    "content_sanskrit": "स्नग्धाञ्जनस्यमरुचिः सुवृत्तः बद्वा इवाद्वंसितवर्णकान्तेः । विशेषको वा विशिशेष यस्याः श्रियन्त्रिलोकीतिलकः स एव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20006111,
    "chapter_id": 6633,
    "verse_number": "3.64",
    "content_sanskrit": "तामीक्षमाणः स पुरं पुरस्तात्प्रापत्प्रतोलीमतुलप्रतापः । वज्रप्रभोद्भासिसुरायुधश्रीर्या देवसेनेव परैरलङ्घ्या ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20006112,
    "chapter_id": 6633,
    "verse_number": "3.65",
    "content_sanskrit": "प्रजा इवाङ्गादरविन्दनाभेः शंभोर्जटाजूटतटादिवापः । मुखादिवाथ श्रुतयो विधातुः पुरान्निरीयुर्मुरजिद्ध्वजिन्यः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20006113,
    "chapter_id": 6633,
    "verse_number": "3.66",
    "content_sanskrit": "श्लिःष्यद्भिरन्योनमुखाग्रसङ्गस्खलत्खलीनं हरिभिर्विलोलैः । परस्परोत्पीडितजानुभागा दुःखेन निशचक्रमुरश्ववाराः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "avatarnika": ""
  },
  {
    "id": 20006114,
    "chapter_id": 6633,
    "verse_number": "3.67",
    "content_sanskrit": "निरन्तरालेऽपि विमुच्माने दूरं पथि प्राणभृतां गणेन । तेजोमहद्भिस्तमसेव दीपैर्द्वीपैरसंबधमयांबभूवे ॥",
