    "display_order": 74,
    "avatarnika": ""
  },
  {
    "id": 20006122,
    "chapter_id": 6633,
    "verse_number": "3.75",
    "content_sanskrit": "उद्धृत्यमेघैस्तत एव तोयमर्थं मुनीन्द्रैरिव संप्रणीताः । आलोकयामास हरिः पतन्तीर्नदीः स्मृतिर्वदमिवाम्बुराशिम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
