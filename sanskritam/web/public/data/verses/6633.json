  {
    "id": 20006121,
    "chapter_id": 6633,
    "verse_number": "3.74",
    "content_sanskrit": "साटोपमुर्वीमनिशं नदन्तः यैः प्लवयिष्यन्ति समन्ततःऽमी । तान्यकदेशान्निभृतंपयोधेः सोऽम्भांसि मेघान्पिबतः ददर्श ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
