  {
    "id": 20006123,
    "chapter_id": 6633,
    "verse_number": "3.76",
    "content_sanskrit": "विक्रीय दिश्यानि धनान्युरूणिदैप्यानसावुत्तमलाभबाजः । तरीषु तत्रत्यमफल्गु भाण्डं सांयान्त्रिकानावापतःऽभ्यनन्दत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 76,
    "avatarnika": ""
  },
  {
    "id": 20006124,
    "chapter_id": 6633,
    "verse_number": "3.77",
    "content_sanskrit": "उत्पित्सवोऽन्तर्नदभर्तुरुच्चैर्गरीयसा निःश्वसितानिलेन । पयांसि भक्त्या गरुडध्वजस्य ध्वाजानिवोच्चिक्षिपिरे फणीन्द्राः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
