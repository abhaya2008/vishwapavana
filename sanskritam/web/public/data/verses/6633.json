    "avatarnika": ""
  },
  {
    "id": 20006125,
    "chapter_id": 6633,
    "verse_number": "3.78",
    "content_sanskrit": "तमागतं वीक्ष्य युगान्तबन्धुमुत्सङ्गशय्याशयमम्बुराशिः । प्रत्युज्जगामेव गुरुप्रमोदप्रसारितोत्तुङ्गतरङ्गबाहुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
