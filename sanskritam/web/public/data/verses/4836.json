[{"id": 2181050, "chapter_id": 4836, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2181051, "chapter_id": 4836, "verse_number": "१", "content_sanskrit": "ततः प्रविश्य भवनं प्रसुप्तो मधुसूदनः ।\nयाममात्रावशेषायां यामिन्यां प्रत्यबुद्ध्यत\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2181052, "chapter_id": 4836, "verse_number": "२", "content_sanskrit": "स ध्यानपथमाश्रित्य सर्वज्ञानानि माधवः ।\nअवलोक्य ततः पश्चाद् दध्यौ ब्रह्म सनातनम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2181053, "chapter_id": 4836, "verse_number": "३", "content_sanskrit": "ततः श्रुतिपुराणज्ञाः शिक्षिता रक्तकण्ठिनः ।\nअस्तुवन् विश्वकर्माणं वासुदेवं प्रजापतिम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2181054, "chapter_id": 4836, "verse_number": "४", "content_sanskrit": "पठन्ति पाणिका गाथास्तथा गायन्ति गायनाः ।\nशङ्खानकमृदङ्गाश्च प्रवाद्यन्त सहस्रशः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2181055, "chapter_id": 4836, "verse_number": "५", "content_sanskrit": "वीणापणववेणूनां स्वनश्चातिमनोरमः ।\nप्रहास इव विस्तीण्ार्ः शुश्रुवे तस्य वेश्मनः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2181056, "chapter_id": 4836, "verse_number": "६", "content_sanskrit": "तथा युधिष्ठिरस्यापि राज्ञो मङ्गलसंिहताः ।\nउच्चेरुर्मधुरा वाचो गीतवादित्रमिश्रिताः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2181057, "chapter_id": 4836, "verse_number": "७", "content_sanskrit": "तत उत्थाय दाशार्हः स्नातः प्राञ्जलिरच्युतः ।\nजप्त्वा गुह्यं महाबाहुरग्नीनाश्रित्य तस्थिवान् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2181058, "chapter_id": 4836, "verse_number": "८", "content_sanskrit": "ततः सहस्रं विप्राणां चतुर्वेदविदां तथा ।\nगवां सहस्रेणैकैकं वाचयामास माधवः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2181059, "chapter_id": 4836, "verse_number": "९", "content_sanskrit": "मङ्गलालम्भनं कृत्वा आत्मानमवलोक्य च ।\nआदर्शे विमले कृष्णस्ततः सात्यकिमब्रवीत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2181060, "chapter_id": 4836, "verse_number": "१०", "content_sanskrit": "गच्छ शैनेय जानीहि गत्वा राजनिवेशनम् ।\nअपि सज्जो महातेजा भीष्मं द्रष्टुं युधिष्ठिरः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2181061, "chapter_id": 4836, "verse_number": "११", "content_sanskrit": "ततः कृष्णस्य वचनात् सात्यकिस्त्वरितो ययौ ।\nउपगम्य च राजानं युधिष्ठिरमुव्आच ह\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2181062, "chapter_id": 4836, "verse_number": "१२", "content_sanskrit": "युक्तो रथवरो राजन् वासुदेवस्य धीमतः ।\nसमीपमापगेयस्य प्रयास्यति जनार्दनः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2181063, "chapter_id": 4836, "verse_number": "१३", "content_sanskrit": "भवत्प्रतीक्षः कृष्णोऽसौ धर्मराज महाद्युते ।\nयदत्रानन्तरं कृत्यं तद् भवान् कर्तुमर्हति\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2181064, "chapter_id": 4836, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2181065, "chapter_id": 4836, "verse_number": "१४", "content_sanskrit": "युज्यतां मे रथवरः फल्गुनाप्रतिमद्युते ।\nन सैनिकैश्च यातव्यं यास्यामो वयमेव हि\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2181066, "chapter_id": 4836, "verse_number": "१५", "content_sanskrit": "नच पीडयितव्यो मे भीष्मो धर्मभृतांवरः ।\nअतः पुरःसराश्चापि निवर्तन्तु धनञ्जय\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2181067, "chapter_id": 4836, "verse_number": "१६", "content_sanskrit": "अद्य प्रभृति गाङ्गेयः परं गुह्यं प्रवक्ष्यति ।\nततो नेच्छामि कौन्तेय पृथग् जनसमागमम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2181068, "chapter_id": 4836, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2181069, "chapter_id": 4836, "verse_number": "१७", "content_sanskrit": "तद् वाक्यमाकर्ण्य तथा कुन्तीपुत्रो धनञ्जयः ।\nयुक्तं रथवरं तस्मा आचचक्षे नरर्षभ\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2181070, "chapter_id": 4836, "verse_number": "१८", "content_sanskrit": "ततो युधिष्ठिरो राजा यमौ भीमार्जुनावपि ।\nभूतानीव समस्तानि ययुः कृष्णनिवेशनम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2181071, "chapter_id": 4836, "verse_number": "१९", "content_sanskrit": "आगच्छत्स्वथ कृष्णोऽपि पाण्डवेषु महात्मसु ।\nशैनेयसहितो धीमान् रथमेवान्वपद्यत\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2181072, "chapter_id": 4836, "verse_number": "२०", "content_sanskrit": "रथस्थाः संविदं कृत्वा सुखां पृष्ट्वा च शर्वरीम् ।\nमेघघोषैः रथवरैः प्रययुस्ते महारथाः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2181073, "chapter_id": 4836, "verse_number": "२१", "content_sanskrit": "मेघपुष्पं बलाहं च सैन्यं सुग्रीवमेव च ।\nदारुकश्चोदयामास वासुदेवस्य वाजिनः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2181074, "chapter_id": 4836, "verse_number": "२२", "content_sanskrit": "ते हया वासुदेवस्य दारुकेण प्रचोदिताः ।\nगां खुराग्रैस्तथा राजँल्लिखन्तः प्रययुस्तदा\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2181075, "chapter_id": 4836, "verse_number": "२३", "content_sanskrit": "ते ग्रसन्त इवाकाशं वेगवन्तो महाबलाः ।\nक्षेत्रं धर्मस्य कृत्स्नस्य कुरुक्षेत्रमवातरन्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2181076, "chapter_id": 4836, "verse_number": "२४", "content_sanskrit": "ततो ययुर्यत्र भीष्मः शरतल्पगतः प्रभुः ।\nआस्ते ब्रह्मर्षिभिः सार्धं ब्रह्मा देवगणैर्यथा\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2181077, "chapter_id": 4836, "verse_number": "२५", "content_sanskrit": "ततोऽवतीर्य गोविन्दो रथात् स च युधिष्ठिरः ।\nभीमो गाण्डीवधन्वा च यमौ सात्यकिरेव च ।\nऋषीनभ्यच्र्अयामासुः करानुद्यम्य दक्षिणान्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2181078, "chapter_id": 4836, "verse_number": "२६", "content_sanskrit": "स तैः परिवृतो राजा नक्षत्रैरिव चन्द्रमाः ।\nअभ्याजगाम गाङ्गेयं ब्रह्माणमिव वासवः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2181079, "chapter_id": 4836, "verse_number": "२७", "content_sanskrit": "शरतल्पे शयानं तमादित्यं पतितं यथा ।\nददर्श स महाबाहुर्भयादागतसाध्वसः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2181080, "chapter_id": 4836, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे त्रिपञ्चाशोऽध्यायः ॥ ५३ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]