[{"id": 2060721, "chapter_id": 2300, "verse_number": "८-२१-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2060722, "chapter_id": 2300, "verse_number": "८-२१-१", "content_sanskrit": "ततः कर्णं पुरस्कृत्य त्वदीया युद्वदुर्मदाः।\nपुनरावृत्य सङ्ग्रामं चक्रुर्देवासुरोपमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2060723, "chapter_id": 2300, "verse_number": "८-२१-२", "content_sanskrit": "द्विरदनररथाश्वशङ्खशब्दैः\nपरिहृषिता विविधैश्च शस्त्रपातैः।\nद्विरदरथपदातिसादिसङ्घाः\nपरिकुपिताभिमुखाः प्रजघ्निरे ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2060724, "chapter_id": 2300, "verse_number": "८-२१-३", "content_sanskrit": "शितपरश्वथसासिपट्टसै--\nरिषुभिरनेकविधैश्च सूदिताः।\nद्विरदरथहया महाहवे\nवरपुरुषैः पुरुषाश्च वाहनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2060725, "chapter_id": 2300, "verse_number": "८-२१-४", "content_sanskrit": "कमलदिनकरेन्दुसन्निभैः\nसितदशनैः सुमुखाक्षिनासिकैः।\nरुचिरमकुटकुण्डलैर्मही\nपुरुषशिरोभिरुपस्तृता बभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2060726, "chapter_id": 2300, "verse_number": "८-२१-५", "content_sanskrit": "परिघमुसलशक्तितौमरै--\nर्नखरभुशुण्डिगदाशतैर्हताः।\nद्विरदनरहयाः सहस्रशो\nरुधिरनदीप्रवहास्तदाऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2060727, "chapter_id": 2300, "verse_number": "८-२१-६", "content_sanskrit": "प्रहतरथनराश्वकुञ्जरं\nप्रतिभयदर्शनमुल्बणव्रणम्।\nतदहितहतमाबभौ बलं\nपितृपतिराष्ट्रमिव प्रजाक्षये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2060728, "chapter_id": 2300, "verse_number": "८-२१-७", "content_sanskrit": "अथ तव नरदेव सैनिका--\nस्तव च सुताः सुरसूनुसन्निभाः।\nअमितबलपुरः सरा रणे\nकुरुवृषभाः शिनिपुत्रमभ्ययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2060729, "chapter_id": 2300, "verse_number": "८-२१-८", "content_sanskrit": "तदतिरुधिरभीममाबभौ\nपुरुषवराश्वरथद्विपाकुलम्।\nलवणजलसमुद्वतस्वनं\nबलमसुरामरसैन्यसप्रभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2060730, "chapter_id": 2300, "verse_number": "८-२१-९", "content_sanskrit": "सुरपतिसमविक्रमस्तत--\nस्त्रिदशवरावरजोपमं युधि।\nदिनकरकिरणप्रभैः पृषत्कै\nरवितनयोऽभ्यहनच्छिनिप्रवीरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2060731, "chapter_id": 2300, "verse_number": "८-२१-१०", "content_sanskrit": "तमपि सरथवाजिसारथिं\nशिनिवृषभो विविधैः शरैस्त्वरन्।\nभुजगविषसमप्रभै रणे\nपुरुषवरं समवास्तृणोत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2060732, "chapter_id": 2300, "verse_number": "८-२१-११", "content_sanskrit": "शिनिवृषभशरैर्निपीडितं\nतव सुहृदो वसुषेणमभ्ययुः।\nत्वरितमतिरथा रथर्षभं\nद्विरदरथाश्वपदातिभिः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2060733, "chapter_id": 2300, "verse_number": "८-२१-१२", "content_sanskrit": "तदुदधिनिभमाद्रवद्बलं\nत्वरिततरैः समभिद्रुतं परैः।\nद्रुपदसुतमुखैस्तदाऽभवत्\nपुरुषरथाश्वगजक्षयो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2060734, "chapter_id": 2300, "verse_number": "८-२१-१३", "content_sanskrit": "अथ पुरुषवरौ कृताह्निकौ\nभवमभिपूज्य यथाविधि प्रभुम्।\nअरिवधकृतनिश्चयौ द्रुतं\nतव बलमर्जुनकेशवौ सृतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2060735, "chapter_id": 2300, "verse_number": "८-२१-१४", "content_sanskrit": "जलदनिनदनिःस्वनं रथं\nपवनविधूतपताककेतनम्।\nसितहयमुपयान्तमन्तिकं\nकृतमनसो ददृशुस्तदाऽरयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2060736, "chapter_id": 2300, "verse_number": "८-२१-१५", "content_sanskrit": "अथ विष्फार्य गाण्डीवं रथे नृत्यन्निवार्जुनः।\nशरसम्बाधमकरोत्खं दिशः प्रदिशस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2060737, "chapter_id": 2300, "verse_number": "८-२१-१६", "content_sanskrit": "रथान्विमानप्रतिमान्मज्जयन्सायुधध्वजान्।\nससारथींस्तदा बाणैरभ्राणीवानिलोऽवधीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2060738, "chapter_id": 2300, "verse_number": "८-२१-१७", "content_sanskrit": "गजान्गजप्रयन्तॄंश्च वैजयन्त्यायुधध्वजान्।\nसादिनोऽश्वांश्च पत्तींश्च शरैर्निन्ये यमक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2060739, "chapter_id": 2300, "verse_number": "८-२१-१८", "content_sanskrit": "तमन्तकमिव क्रुद्धमनिवार्यं महारथम्।\nदुर्योधनोऽभ्ययादेको निघ्नन्बाणैरजिह्मगैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2060740, "chapter_id": 2300, "verse_number": "८-२१-१९", "content_sanskrit": "तस्यार्जुनो धनुः सूतमश्वान्केतुं च सायकैः।\nहत्वा सप्तभिरेकेन च्छत्रं चिच्छेद पत्रिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2060741, "chapter_id": 2300, "verse_number": "८-२१-२०", "content_sanskrit": "नवमं च समाधाय व्यसृजत्प्राणघातिनम्।\nदुर्योधनायेषुवरं तं द्रौणिः सप्तधाऽच्छिनत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2060742, "chapter_id": 2300, "verse_number": "८-२१-२१", "content_sanskrit": "ततो द्रौणेर्धनुश्छित्वा हत्वा चाश्वरथाञ्शरैः।\nकृपस्यापि तदत्युग्रं धनुश्चिच्छेद पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2060743, "chapter_id": 2300, "verse_number": "८-२१-२२", "content_sanskrit": "हार्दिक्यस्य धनुश्छित्त्वा ध्वजं चाश्वांस्तदाऽवधीत्।\nदुःशासनस्येष्वसनं छित्त्वा राधेयमभ्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2060744, "chapter_id": 2300, "verse_number": "८-२१-२३", "content_sanskrit": "अथ सात्यकिमुत्सृज्य त्वरन्कर्णोऽर्जुनं त्रिभिः।\nविद्व्वा विव्याध विंशत्या कृष्णं पार्थं पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2060745, "chapter_id": 2300, "verse_number": "८-२१-२४", "content_sanskrit": "न ग्लानिरासीत्कर्णस्य क्षिपतः सायकान्बहून्।\nरणे विनिघ्नतः शत्रून्क्रुद्धस्येव शतक्रतोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2060746, "chapter_id": 2300, "verse_number": "८-२१-२५", "content_sanskrit": "अथ सात्यकिरागत्य कर्णं विद्द्वा शितैः शरैः।\nनवत्या नवभिश्चोग्रैः शतेन पुनरार्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2060747, "chapter_id": 2300, "verse_number": "८-२१-२६", "content_sanskrit": "ततः प्रवीराः पार्थानां सर्वे कर्णमपीडयन्।\nयुधामन्युः शिखण्डी च द्रौपदेयाः प्रभद्रकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2060748, "chapter_id": 2300, "verse_number": "८-२१-२७", "content_sanskrit": "उत्तमौजा युयुत्सुश्च यमौ पार्षत एव च।\nचेदिकारूशमात्स्यानां केकयानां च यद्बलं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2060749, "chapter_id": 2300, "verse_number": "८-२१-२८", "content_sanskrit": "चेकितानश्च बलवान्धर्मराजश्च सुव्रतः।\nएते रथाश्वद्विरदैः पत्तिभिश्चोग्रविक्रमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2060750, "chapter_id": 2300, "verse_number": "८-२१-२९", "content_sanskrit": "परिवार्य रणे कर्णं नानाशस्त्रैरवाकिरन्।\nभाषन्तो वाग्भिरुग्राभिः सर्वे कर्णवधे धृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2060751, "chapter_id": 2300, "verse_number": "८-२१-३०", "content_sanskrit": "तां शस्त्रवृष्टिं बहुधा कर्णश्छित्त्वा शितैः शरैः।\nअपोवाहास्त्रवीर्येण द्रुमं भङ्क्त्वेव मारुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2060752, "chapter_id": 2300, "verse_number": "८-२१-३१", "content_sanskrit": "रथिनः समहामात्रान्गजानश्वान्ससादिनः।\nपत्तिव्रातांश्च सङ्क्रुद्वो निघ्नन्कर्णो व्यदृश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2060753, "chapter_id": 2300, "verse_number": "८-२१-३२", "content_sanskrit": "तद्वध्यमानं पाण्डूनां बलं कर्णास्त्रतेजसा।\nविशस्त्रपत्रदेहासु प्राय आसीत्पराङ्मुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2060754, "chapter_id": 2300, "verse_number": "८-२१-३३", "content_sanskrit": "अथ कर्णास्त्रमस्त्रेण प्रतिहत्यार्जुनः स्मयन्।\nदिशं खं चैव भूमिं च प्रावृणोच्छरवृष्टिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2060755, "chapter_id": 2300, "verse_number": "८-२१-३४", "content_sanskrit": "मुसलानीव सम्पेतुः परिघा इव चेषवः।\nशतघ्न्य इव चाप्यन्ये वज्राण्युग्राणि चापरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2060756, "chapter_id": 2300, "verse_number": "८-२१-३५", "content_sanskrit": "तैर्वध्यमानं तत्सैन्यं सपत्त्यश्वरथद्विपम्।\nनिमीलिताक्षमत्यर्थं बभ्राम च ननाद च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2060757, "chapter_id": 2300, "verse_number": "८-२१-३६", "content_sanskrit": "निष्कैवल्यं तदा युद्वं प्रापुरश्वनरद्विपाः।\nहन्यमानाः शरैरार्तास्तदा भीताः प्रदुद्रुवुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2060758, "chapter_id": 2300, "verse_number": "८-२१-३७", "content_sanskrit": "त्वदीयानां तदा युद्वे संसक्तानां जयैषिणाम्।\nगिरिमस्तं समासाद्य प्रत्यपद्यत भानुमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2060759, "chapter_id": 2300, "verse_number": "८-२१-३८", "content_sanskrit": "तमसा च महाराज रजसा च विशेषतः।\nन किञ्चित्प्रत्यपश्याम शुभं वा यदि वाऽशुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2060760, "chapter_id": 2300, "verse_number": "८-२१-३९", "content_sanskrit": "ते त्रस्यन्तो महेष्वासा रात्रियुद्वस्य भारत।\nअपयानं ततश्चक्रुः सहिताः सर्वयोधिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2060761, "chapter_id": 2300, "verse_number": "८-२१-४०", "content_sanskrit": "कौरवेष्वपयातेषु तदा राजन्दिनक्षये।\nजयं सुमनसः प्राप्य पार्थाः स्वशिबिरं ययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2060762, "chapter_id": 2300, "verse_number": "८-२१-४१", "content_sanskrit": "वादित्रशब्दैर्विविधैः सिंहनादैः सगर्जितैः।\nपरानुवहन्तश्च स्तुवन्तश्चाच्युतार्जुनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2060763, "chapter_id": 2300, "verse_number": "८-२१-४२", "content_sanskrit": "कृतेऽवहारे तैर्वीरैः सैनिकाः सर्व एव ते।\nआशीर्वाचः पाण्डवेषु प्रायुञ्जन्त नरेश्वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2060764, "chapter_id": 2300, "verse_number": "८-२१-४३", "content_sanskrit": "ततः कृतेऽवहारे च प्रहृष्टास्तत्र पाण्डवाः।\nनिशायां शिबिरं गत्वा न्यवसन्त नरेश्वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2060765, "chapter_id": 2300, "verse_number": "८-२१-४४", "content_sanskrit": "ततो रक्षः पिशाचाश्च श्वापदाश्चैव सङ्घशः।\nजग्मुरायोधनं घोरं रुद्रस्याक्रीडसन्निभम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2060766, "chapter_id": 2300, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि षोडशदिवसयुद्धे एकविंशोऽध्यायः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]