[{"id": 2027860, "chapter_id": 1598, "verse_number": "३-२३६-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2027861, "chapter_id": 1598, "verse_number": "३-२३६-१", "content_sanskrit": "मार्कण्डेयादिभिर्विप्रैः पाण्डवैश्च महात्मभिः।\nकथाभिरनुकूलाभिः सह स्तित्वा जनार्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2027862, "chapter_id": 1598, "verse_number": "३-२३६-२", "content_sanskrit": "ततस्तैः संविदं कृत्वा यथावन्मधुसूदनः।\nआरुरुक्षू रथं सत्यामाह्वयामास भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2027863, "chapter_id": 1598, "verse_number": "३-२३६-३", "content_sanskrit": "सत्यभामा ततस्तत्र स्वजित्वा द्रुपदात्मजाम्।\nउवाच वचनं हृद्यं यथाभावं समाहितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2027864, "chapter_id": 1598, "verse_number": "३-२३६-४", "content_sanskrit": "कृष्णे माभूत्तवोत्कण्ठा मा व्यथा मा प्रजागरः।\nभर्तृभिर्देवसंकाशैर्जितां प्राप्स्यसि मेदिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2027865, "chapter_id": 1598, "verse_number": "३-२३६-५", "content_sanskrit": "न ह्येवं शीलसंपन्ना नैवं पूजितलक्षणाः।\nप्राप्नुवन्ति चिरं क्लेशं यथा त्वमसितेक्षणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2027866, "chapter_id": 1598, "verse_number": "३-२३६-६", "content_sanskrit": "अवश्यं च त्वया भूमिरियं निहतकण्टका।\nभर्तृभिः सहभोक्तव्या निर्द्वन्द्वेति श्रुतं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2027867, "chapter_id": 1598, "verse_number": "३-२३६-७", "content_sanskrit": "धार्तराष्ट्रवधं कृत्वावैराणि प्तियात्य च।\nयुधिष्ठिरस्थां पृथिवीं द्रष्टासि द्रुपदात्मजे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2027868, "chapter_id": 1598, "verse_number": "३-२३६-८", "content_sanskrit": "यास्ताः प्रव्राजपानां त्वां प्राहसन्दर्पमोहिताः।\nताः क्षिप्रं हतसंकल्पा द्रक्ष्यसि त्वं कुरुस्त्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2027869, "chapter_id": 1598, "verse_number": "३-२३६-९", "content_sanskrit": "तव दुःखोपपन्नाया यैराचरितमप्रियम्।\nविद्धि संप्रस्थितान्सर्वांस्तान्कृष्णे यमसादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2027870, "chapter_id": 1598, "verse_number": "३-२३६-१०", "content_sanskrit": "पुत्रस्ते प्रतिविन्ध्यश्च सुतसोमस्तथाविधः।\nश्रुतकर्माऽर्जुनिश्चैव शतानीकश्च नाकुलिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2027871, "chapter_id": 1598, "verse_number": "३-२३६-११", "content_sanskrit": "सहदेवाच्च यो जातः श्रुतसेनस्तवात्मजः।\nसर्वेकुशलिनो वीराः कृतास्त्राश्च सुतास्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2027872, "chapter_id": 1598, "verse_number": "३-२३६-१२", "content_sanskrit": "अभिमन्युरिव प्रीता द्वारवत्यां रता भृशम्।\nत्वमिवैषां सुभद्रा च प्रीत्या सर्वात्मना स्थिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2027873, "chapter_id": 1598, "verse_number": "३-२३६-१३", "content_sanskrit": "प्रीयते तव निर्द्वन्द्वा तेभ्यश्च विगतज्वरा।\nदुःखिता तेन दुःखेन सुखेन सुखिता तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2027874, "chapter_id": 1598, "verse_number": "३-२३६-१४", "content_sanskrit": "भजेत्सर्वात्मना चैव प्रद्युम्नजननी तथा।\nभानुप्रभृतिभिश्चैनान्विशिनष्टि च केशवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2027875, "chapter_id": 1598, "verse_number": "३-२३६-१५", "content_sanskrit": "भोजनाच्छादने चैषां नित्यं मे श्वशुरः स्थितः।\nरामप्रभृतयः सर्वे भजन्त्यन्धकवृष्णयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2027876, "chapter_id": 1598, "verse_number": "३-२३६-१६", "content_sanskrit": "तुल्यो हिप्रणयस्तेषां प्रद्युम्नस्य च भामिनि।\nएवमादि प्रियं सत्यंहृद्यमुक्त्वा मनोनुगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2027877, "chapter_id": 1598, "verse_number": "३-२३६-१७", "content_sanskrit": "गमनाय मनश्चक्रेवासुदेवरथं प्रति।\nतां कृष्णां कृष्णमहिषी चकाराभिप्रदक्षिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2027878, "chapter_id": 1598, "verse_number": "३-२३६-१८", "content_sanskrit": "आरुरोह रथं शौरेः सत्यभामाऽथ भामिनी।\nस्मयित्वातु यदुश्रेष्ठो द्रौपदीं परिसान्त्व्य च।\nउपावर्त्य ततः शीघ्रैर्हयैः प्रायात्परंतपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2027879, "chapter_id": 1598, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि द्रौपदीसत्यभामासंवादपर्वणि षट्त्रिंशदधिकद्विशततमोऽध्यायः ॥ २३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]