[{"id": 2001724, "chapter_id": 1031, "verse_number": "१-३२-०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2001725, "chapter_id": 1031, "verse_number": "१-३२-१", "content_sanskrit": "ततस्तस्माद्गिरिवरात्समुदीर्णमहाबलः।\nगरुडः पक्षिराट् तूर्णं संप्राप्तो विबुधान्प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2001726, "chapter_id": 1031, "verse_number": "१-३२-२", "content_sanskrit": "तं दृष्ट्वातिबलं चैव प्राकम्पन्त सुरास्ततः।\nपरस्परं च प्रत्यघ्नन्सर्वप्रहरणान्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2001727, "chapter_id": 1031, "verse_number": "१-३२-३", "content_sanskrit": "तत्र चासीदमेयात्मा विद्युदग्निसमप्रभः।\nभौमनः सुमहावीर्यः सोमस्य परिरक्षिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2001728, "chapter_id": 1031, "verse_number": "१-३२-४", "content_sanskrit": "स तेन पतगेन्द्रेण पक्षतुण्डनखैः क्षतः।\nमुहूर्तमतुलं युद्धं कृत्वा विनिहतो युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2001729, "chapter_id": 1031, "verse_number": "१-३२-५", "content_sanskrit": "रजश्चोद्धूय सुमहत्पक्षवातेन खेचरः।\nकृत्वा लोकान्निरालोकांस्तेन देवानवाकिरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2001730, "chapter_id": 1031, "verse_number": "१-३२-६", "content_sanskrit": "तेनावकीर्णा रजसा देवा मोहमुपागमन्।\nन चैवं ददृशुश्छन्ना रजसाऽमृतरक्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2001731, "chapter_id": 1031, "verse_number": "१-३२-७", "content_sanskrit": "एवं संलोडयामास गरुडस्त्रिदिवालयम्।\nपक्षतुण्डप्रहारैस्तु देवान्स विददार ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2001732, "chapter_id": 1031, "verse_number": "१-३२-८", "content_sanskrit": "ततो देवः सहस्राक्षस्तूर्णं वायुमचोदयत्।\nविक्षिपेमां रजोवृष्टिं तवेदं कर्म मारुत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2001733, "chapter_id": 1031, "verse_number": "१-३२-९x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2001734, "chapter_id": 1031, "verse_number": "१-३२-९", "content_sanskrit": "अथ वायुरपोवाह तद्रजस्तरसा बली।\nततो वितिमिरे जाते देवाः शकुनिमार्दयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2001735, "chapter_id": 1031, "verse_number": "१-३२-१०", "content_sanskrit": "ननादोच्चैः स बलवान्महामेघ इवाम्बरे।\nवध्यमानः सुरगणैः सर्वभूतानि भीषयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2001736, "chapter_id": 1031, "verse_number": "१-३२-११", "content_sanskrit": "उत्पपात महावीर्यः पक्षिराट् परवीरहा।\nसमुत्पत्यान्तरिक्षस्थं देवानामुपरि स्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2001737, "chapter_id": 1031, "verse_number": "१-३२-१२", "content_sanskrit": "वर्मिमो विबुधाः सर्वे नानाशस्त्रैरवाकिरन्।\nपट्टिशैः परिधैः शूलैर्गदाभिश्च सवासवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2001738, "chapter_id": 1031, "verse_number": "१-३२-१३", "content_sanskrit": "क्षुरप्रैर्ज्वलितैश्चापि चक्रैरादित्यरूपिभिः।\nनानाशस्त्रविसर्गैस्तैर्वध्यमानः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2001739, "chapter_id": 1031, "verse_number": "१-३२-१४", "content_sanskrit": "कुर्वन्सुतुमुलं युद्धं पक्षिराण्ण व्यकम्पत।\nनिर्दहन्निव चाकाशे वैनतेयः प्रतापवान्।\nपक्षाभ्यामुरसा चैव समन्ताद्व्यक्षिपत्सुरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2001740, "chapter_id": 1031, "verse_number": "१-३२-१५", "content_sanskrit": "ते विक्षिप्तास्ततो देवा दुद्रुवुर्गरुडार्दिताः।\nनखतुण्डक्षताश्चैव सुस्रुवुः शोणितं बहु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2001741, "chapter_id": 1031, "verse_number": "१-३२-१६", "content_sanskrit": "साध्याः प्राचीं सगन्धर्वा वसवो दक्षिणां दिशम्।\nप्रजग्मुः सहिता रुद्राः पतगेन्द्रप्रधर्षिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2001742, "chapter_id": 1031, "verse_number": "१-३२-१७", "content_sanskrit": "दिशं प्रतीचीमादित्या नासत्यावुत्तरां दिशम्।\nमुहुर्मुहुः प्रेक्षमाणा युध्यमानं महौजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2001743, "chapter_id": 1031, "verse_number": "१-३२-१८", "content_sanskrit": "अश्वक्रन्देन वीरेण रेणुकेन च पक्षिराट्।\nक्रथनेन च शूरेण तपनेन च खेचरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2001744, "chapter_id": 1031, "verse_number": "१-३२-१९", "content_sanskrit": "उलूकश्वसनाभ्यां च निमेषेण च पक्षिराट्।\nप्ररुजेन च संग्रामं चकार पुलिनेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2001745, "chapter_id": 1031, "verse_number": "१-३२-२०", "content_sanskrit": "तान्पक्षनखतुण्डाग्रैरभिनद्विनतासुतः।\nयुगान्तकाले संक्रुद्धः पिनाकीव परंतप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2001746, "chapter_id": 1031, "verse_number": "१-३२-२१", "content_sanskrit": "महाबला महोत्साहास्तेन ते बहुधा क्षताः।\nरेजुरभ्रघनप्रख्या रुधिरौघप्रवर्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2001747, "chapter_id": 1031, "verse_number": "१-३२-२२", "content_sanskrit": "तान्कृत्वा पतगश्रेष्ठः सर्वानुत्क्रान्तजीवितान्।\nअतिक्रान्तोऽमृतस्यार्थे सर्वतोऽग्निमपश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2001748, "chapter_id": 1031, "verse_number": "१-३२-२३", "content_sanskrit": "आवृण्वानं महाज्वालमर्चिर्भिः सर्वतोऽम्बरम्।\nदहन्तमिव तीक्ष्णांशुं चण्डवायुसमीरितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2001749, "chapter_id": 1031, "verse_number": "१-३२-२४", "content_sanskrit": "नभः स्पृशन्तं ज्वालाभिः सर्वभूतभयंकरम्।\nततो नवत्या नवतीर्मुखानां\nकृत्वा महात्मा गरुडस्तरस्वी।\nनदीः समापीय मुखैस्ततस्तैः\nसुशीघ्रमागम्य पुनर्जवेन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2001750, "chapter_id": 1031, "verse_number": "१-३२-२५", "content_sanskrit": "ज्वलन्तमग्निं तममित्रतापनः\nसमास्तरत्पत्ररथो नदीभिः।\nततः प्रचक्रे वपुरन्यदल्पं\nप्रवेष्टुकामोऽग्निमभिप्रशाम्य॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2001751, "chapter_id": 1031, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि आस्तीकपर्वणि द्वात्रिंशोऽध्यायः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]