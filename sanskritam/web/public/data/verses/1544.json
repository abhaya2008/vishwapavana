[{"id": 2025294, "chapter_id": 1544, "verse_number": "३-१८२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2025295, "chapter_id": 1544, "verse_number": "३-१८२-१", "content_sanskrit": "युधिष्ठिरस्तमासाद्य सर्पभोगेन वेष्टितम्।\nदयितं भ्रातरं धीमानिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2025296, "chapter_id": 1544, "verse_number": "३-१८२-२", "content_sanskrit": "कुन्तीमातः कथमिमामापदं त्वमवाप्तवान्।\nकश्चायं पर्वताभोगप्रतिमः पन्नगोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2025297, "chapter_id": 1544, "verse_number": "३-१८२-३", "content_sanskrit": "स धर्मराजमालक्ष्य भ्राता भ्रतरमग्रजम्।\nकथयामास तत्सर्वं ग्रहणादिविचेष्टितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2025298, "chapter_id": 1544, "verse_number": "३-१८२-४", "content_sanskrit": "[अयमार्य महासत्वो भक्षार्थं मां गृहीतवान्।\nनहुषो नाम राजर्षिः प्राणवानिव संस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2025299, "chapter_id": 1544, "verse_number": "३-१८२-५x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2025300, "chapter_id": 1544, "verse_number": "३-१८२-५", "content_sanskrit": "मुच्यतामयमायुष्मन्भ्राता मेऽमितविक्रमः।\nवयमाहारमन्यं ते दास्यामः क्षुन्निवारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2025301, "chapter_id": 1544, "verse_number": "३-१८२-६x", "content_sanskrit": "सर्प उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2025302, "chapter_id": 1544, "verse_number": "३-१८२-६", "content_sanskrit": "मुच्यतामयमायुष्मन्भ्राता मेऽमितविक्रमः।\nगम्यतां नेह स्थातव्यं श्वो भवानपि मे भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2025303, "chapter_id": 1544, "verse_number": "३-१८२-७", "content_sanskrit": "व्रतमेतन्महाबाहो विषयं मम यो ब्रजेत्।\nस म भक्षो भवेत्तात त्वं चापि विषये मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2025304, "chapter_id": 1544, "verse_number": "३-१८२-८", "content_sanskrit": "चिरेणाद्य मयाऽऽहारः प्राप्तोऽयमनुजस्तव।\nनाहमेनं विमोक्ष्यामि न चान्यमभिकाङ्क्षये ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2025305, "chapter_id": 1544, "verse_number": "३-१८२-९x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2025306, "chapter_id": 1544, "verse_number": "३-१८२-९", "content_sanskrit": "देवो वा यदि वा दैत्य उरगो वा भवान्यदि।\nसत्यं सर्प वचो ब्रूहि पृच्छति त्वां युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2025307, "chapter_id": 1544, "verse_number": "३-१८२-१०", "content_sanskrit": "किमर्थं च त्वया ग्रस्तो भीमसेनो भुजंगम।\nकिमाहृत्यविदित्वा वा प्रीतिस्ते स्याद्भुजंगम।\nकिमाहारं प्रयच्छामि कथं मुञ्चेद्भवानिमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2025308, "chapter_id": 1544, "verse_number": "३-१८२-११x", "content_sanskrit": "सर्प उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2025309, "chapter_id": 1544, "verse_number": "३-१८२-११", "content_sanskrit": "नहुषो नाम राजाऽहमासं पूर्वस्तवानघ।\nप्रथितः पञ्चमः सोमादायोः पुत्रो नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2025310, "chapter_id": 1544, "verse_number": "३-१८२-१२", "content_sanskrit": "क्रतुभिस्तपसा चैवस्वाध्यायेन दमेन च।\nत्रैलोक्यैश्वर्यमव्यग्रं प्राप्तोऽहंविकर्मेण च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2025311, "chapter_id": 1544, "verse_number": "३-१८२-१३", "content_sanskrit": "तदैश्वर्यं समासाद्य दर्पो मामगमत्तदा।\nसहस्रं हि द्विजातीनामुवाह शिविकां मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2025312, "chapter_id": 1544, "verse_number": "३-१८२-१४", "content_sanskrit": "ऐश्वर्यमदमत्तोऽहमवमत्य ततो द्विजान्।\nइमामगस्त्येन दशामानीत इतिमे स्मृतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2025313, "chapter_id": 1544, "verse_number": "३-१८२-१५", "content_sanskrit": "न तु मामजहात्प्रज्ञा यावदन्वेति पाण्डवः।\nतस्यैवानुग्रहाद्राजन्नगस्त्यस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2025314, "chapter_id": 1544, "verse_number": "३-१८२-१६", "content_sanskrit": "षष्ठे काले मयाऽऽहारः प्राप्तोऽयमनुजस्तव।\nनाहमेनं विमोक्ष्यामि न चान्यदपि कामये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2025315, "chapter_id": 1544, "verse_number": "३-१८२-१७", "content_sanskrit": "प्रश्नानुच्चारितानद्य वायहरिष्यसि चेन्मम।\nतथापश्चाद्विमोक्ष्यामि भ्रातरं ते वृकोदरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2025316, "chapter_id": 1544, "verse_number": "३-१८२-१८x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2025317, "chapter_id": 1544, "verse_number": "३-१८२-१८", "content_sanskrit": "ब्रूहि सर्प यथाकामं प्रतिवक्ष्यामि ते वचः।\nअपि चच्छक्नुयां प्रीतिमाहर्तुं ते भुजङ्गम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2025318, "chapter_id": 1544, "verse_number": "३-१८२-१९", "content_sanskrit": "वेद्यंच ब्राह्मणेनेह तद्भवान्वेत्ति केवलम्।\nसर्पराज ततः श्रुत्वा प्रतिवक्ष्यामि ते वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2025319, "chapter_id": 1544, "verse_number": "३-१८२-२०x", "content_sanskrit": "सर्प उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2025320, "chapter_id": 1544, "verse_number": "३-१८२-२०", "content_sanskrit": "ब्राह्मणः को भवेद्राजन्वेद्यं किंच युधिष्ठिर।\nब्रवीह्यतिमतिं त्वां हि वाक्यैरनिमिनोमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2025321, "chapter_id": 1544, "verse_number": "३-१८२-२१x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2025322, "chapter_id": 1544, "verse_number": "३-१८२-२१", "content_sanskrit": "सत्यं दानं क्षमा शीलमानृशंस्यं तपो घृणा।\nदृश्यन्ते यत्रनागेन्द्रस ब्राह्मण इति स्मृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2025323, "chapter_id": 1544, "verse_number": "३-१८२-२२", "content_sanskrit": "वेद्यं सर्प परं ब्र्हम निर्दुःखमसुखं च यत्।\nयत्रगत्वा न शोचन्ति भवतः किं विवक्षितं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2025324, "chapter_id": 1544, "verse_number": "३-१८२-२३x", "content_sanskrit": "सर्प उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2025325, "chapter_id": 1544, "verse_number": "३-१८२-२३", "content_sanskrit": "चातुर्वर्ण्यं प्रमाणं च सत्यं च ब्रह्म चैव हि।\nआनृशंस्यमहिंसा च घृणा चैव युधिष्ठिर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2025326, "chapter_id": 1544, "verse_number": "३-१८२-२४", "content_sanskrit": "वेद्यं यच्चात्र निर्दुःखमसुखं च नराधिप।\nताभ्यां हीनं पदं चान्यन्न तदस्तीति लक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2025327, "chapter_id": 1544, "verse_number": "३-१८२-२५x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2025328, "chapter_id": 1544, "verse_number": "३-१८२-२५", "content_sanskrit": "शूद्रे तु यद्भवेल्लक्ष्म द्विजे तच्च न विद्यते।\nन वै शूद्रो भवेच्छूद्रो ब्राह्मणो न च ब्राह्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2025329, "chapter_id": 1544, "verse_number": "३-१८२-२६", "content_sanskrit": "यत्रैतल्लक्ष्यते सर्प वृत्तं स ब्राह्मणः स्मृतः।\nतत्रैतन्न वेत्सर्प तं शूद्रमिति निर्दिशेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2025330, "chapter_id": 1544, "verse_number": "३-१८२-२७", "content_sanskrit": "यत्पुनर्भवता प्रोक्तं न वेद्यं विद्यतेति च।\nताभ्यां हीनमतोऽन्यत्र पदं नास्तीति चेदपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2025331, "chapter_id": 1544, "verse_number": "३-१८२-२८", "content_sanskrit": "एवमेतन्मतं सर्प ताभ्यां हीनं तु विद्यते।\nयथा शीतोष्णयोर्मध्ये भवेन्नोष्णं न शीतता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2025332, "chapter_id": 1544, "verse_number": "३-१८२-२९", "content_sanskrit": "एवं वै सुखदुःखाभ्यां हीनमस्ति पदं क्वचित्।\nएषा मम मतिः सर्प यथा वा मन्यते भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2025333, "chapter_id": 1544, "verse_number": "३-१८२-३०x", "content_sanskrit": "सर्प उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2025334, "chapter_id": 1544, "verse_number": "३-१८२-३०", "content_sanskrit": "यदि ते वृत्ततो राजन्ब्राह्मणः प्रसमीक्षितः।\nवृथा जातिस्तदायुष्मन्कृतिर्यावन्न विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2025335, "chapter_id": 1544, "verse_number": "३-१८२-३१x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2025336, "chapter_id": 1544, "verse_number": "३-१८२-३१", "content_sanskrit": "जातिरत्रमहासर्प मनुष्यत्वे महामते।\nसंकरात्सर्ववर्णानां दुष्परीक्ष्येति मे मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2025337, "chapter_id": 1544, "verse_number": "३-१८२-३२", "content_sanskrit": "सर्वे सर्वास्वपत्यानि जनयन्ति यदा नराः।\nवाङ्मैथुनमथो जन्म मरणं च समं नृणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2025338, "chapter_id": 1544, "verse_number": "३-१८२-३३", "content_sanskrit": "इदमार्षं प्रमाणं च ये यजामह इत्यपि।\nतस्माच्छीलं प्रधानेष्टं विदुर्ये तत्त्वदर्शिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2025339, "chapter_id": 1544, "verse_number": "३-१८२-३४", "content_sanskrit": "प्राङ्गाभिवर्धनात्पुंसो जातकर्म विधीयते।\n`तथोपनयनं प्रोक्तं द्विजातीनां यथाक्रमम्।\nतत्रास्य माता सावित्री पिता त्वाचार्य उच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2025340, "chapter_id": 1544, "verse_number": "३-१८२-३५", "content_sanskrit": "वृत्त्या शूद्रसमो ह्येष यावद्वेदेन जायते।\nतस्मिन्नेवं मतिद्वैधे मनुः स्वायंभुवोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2025341, "chapter_id": 1544, "verse_number": "३-१८२-३६", "content_sanskrit": "कृतकृत्याः सर्ववर्णा यदि वृत्तं न पश्यति।\nसंकरस्त्वत्र नागेन्द्र बलवान्प्रसमीक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2025342, "chapter_id": 1544, "verse_number": "३-१८२-३७", "content_sanskrit": "यत्रेदानीं महासर्प संस्कृतं वृत्तमिष्यते।\nतं ब्राह्मणमहं पूर्वमुक्तवान्भुजगोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2025343, "chapter_id": 1544, "verse_number": "३-१८२-३८x", "content_sanskrit": "सर्प उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2025344, "chapter_id": 1544, "verse_number": "३-१८२-३८", "content_sanskrit": "श्रुतं विदितवेद्यस्य तव वाक्यं युधिष्ठिर।\nभक्षयेयमहं कस्माद्भ्रातरं ते वृकोदरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2025345, "chapter_id": 1544, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि आजगरपर्वणि द्व्यशीत्यधिकशततमोऽध्यायः ॥ १८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]