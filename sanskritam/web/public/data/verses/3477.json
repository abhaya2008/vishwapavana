[{"id": 2115123, "chapter_id": 3477, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2115124, "chapter_id": 3477, "verse_number": "१", "content_sanskrit": "प्रबुद्धास्ते हिडिम्बाया रूपमालोक्य शोभनम् ।\nविस्मिताः पुरुषव्याघ्रा बभूवुः पृथया सह \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2115125, "chapter_id": 3477, "verse_number": "२", "content_sanskrit": "ततः कुन्ती समीक्ष्यैनां विस्मिता रूपसम्पदा ।\nउवाच मधुरं वाक्यं सान्त्वपूर्वमिदं शनैः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2115126, "chapter_id": 3477, "verse_number": "३", "content_sanskrit": "कस्य त्वं सुरगर्भाभे का चासि वरवर्णिनि ।\nकेन कार्येण सुभगे कुतश्चागमनं तव \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2115127, "chapter_id": 3477, "verse_number": "४", "content_sanskrit": "यदि वाऽसि वनस्यास्य देवता यदि वाऽप्सराः ।\nआचक्ष्व भद्रे तत् सर्वं किमर्थं चेह तिष्ठसि \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2115128, "chapter_id": 3477, "verse_number": "", "content_sanskrit": "हिडिम्बी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2115129, "chapter_id": 3477, "verse_number": "५", "content_sanskrit": "यदेतत् पश्यसि वनं नीलमेघनिभं महत् ।\nनिवासो राक्षसस्यैतद् हिडिम्बस्य ममैव च \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2115130, "chapter_id": 3477, "verse_number": "६", "content_sanskrit": "तस्य मां राक्षसेन्द्रस्य भगिनीं विद्धि भामिनि ।\nभ्रात्रा सम्प्रेषितामार्ये त्वां सपुत्रां जिघांसता \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2115131, "chapter_id": 3477, "verse_number": "७", "content_sanskrit": "क्रूरबुद्धेरहं तस्य वचनादागता त्विह ।\nअद्राक्षं हेमवर्णाभं तव पुत्रं वृकोदरम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2115132, "chapter_id": 3477, "verse_number": "८", "content_sanskrit": "ततोऽहं सर्वभूतानां भावे विचरता शुभे ।\nचोदिता तव पुत्रार्थं मन्मथेन वशानुगा \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2115133, "chapter_id": 3477, "verse_number": "९", "content_sanskrit": "ततो वृतो मया भर्ता तव पुत्रस्त्वनिन्दिते ।\nअपनेतुं व्यवसितो न चैव कथितो मया \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2115134, "chapter_id": 3477, "verse_number": "१०", "content_sanskrit": "चिरायमाणां मां ज्ञात्वा ततोऽयं पुरुषादकः ।\nस्वयमेवागतो हन्तुमिमान् सर्वांस्तवात्मजान् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2115135, "chapter_id": 3477, "verse_number": "११", "content_sanskrit": "स तेन तव पुत्रेण मम कान्तेन धीमता ।\nबलादितो विनिष्पिष्य व्यपकृष्टो महात्मना\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2115136, "chapter_id": 3477, "verse_number": "१२", "content_sanskrit": "विकर्षन्तौ महावेगौ गर्जन्तौ च परस्परम् ।\nपश्य त्वं युधि विक्रान्तौ तावेतौ नरराक्षसौ \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2115137, "chapter_id": 3477, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2115138, "chapter_id": 3477, "verse_number": "१३", "content_sanskrit": "ततस्तस्या वचः श्रुत्वा उत्पपात युधिष्ठिरः ।\nअर्जुनो नकुलश्चैव सहदेवश्च वीर्यवान् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2115139, "chapter_id": 3477, "verse_number": "१४", "content_sanskrit": "ते तौ ददृशुरासक्तौ विकर्षन्तौ परस्परम् ।\nकाङ्क्षमाणौ जयं चैव मत्ताविव महागजौ \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2115140, "chapter_id": 3477, "verse_number": "१५", "content_sanskrit": "तावन्योन्यं समाश्लिष्य निष्पतन्तौ परस्परम् ।\nदावाग्निधूमसङ्काशं चक्रतुः पार्थिवं रजः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2115141, "chapter_id": 3477, "verse_number": "१६", "content_sanskrit": "वसुधारेणुसंवीतौ वसुधाधरसन्निभौ ।\nबिभ्राजेते यथा शैलौ नीहारेणाभिसंवृतौ \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2115142, "chapter_id": 3477, "verse_number": "१७", "content_sanskrit": "ते पश्यन्तो महद्युद्धं सर्वे व्यथितचेतसः ।\nराक्षसेन बलाद् भीमं क्लिश्यमानं निरीक्ष्य तु \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2115143, "chapter_id": 3477, "verse_number": "१८", "content_sanskrit": "चिरप्रयुद्धौ दृष्ट्वा च अन्योन्यवधकाङ्क्षया ।\nउवाचेदं वचः पार्थः प्रहसन्निव भारत \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2115144, "chapter_id": 3477, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2115145, "chapter_id": 3477, "verse_number": "१९", "content_sanskrit": "भीम मा भैर्महाबाहो न त्वां बुध्यामहे वयम् ।\nसमेतं भीमरूपेण प्रसुप्ताः श्रमकर्शिताः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2115146, "chapter_id": 3477, "verse_number": "२०", "content_sanskrit": "साहाय्येऽस्मि स्थितः पार्श्वे योधयिष्यामि राक्षसम् ।\nयमौ च राजा कौन्तेयो गोपयिष्यति मातरम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2115147, "chapter_id": 3477, "verse_number": "", "content_sanskrit": "भीमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2115148, "chapter_id": 3477, "verse_number": "२१", "content_sanskrit": "उदासीनो निरीक्षस्व न कार्यः सम्भ्रमस्त्वया ।\nन जात्वयं पुनर्जीवेन्मद्भुजान्तरमागतः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2115149, "chapter_id": 3477, "verse_number": "२२", "content_sanskrit": "अयमस्मांस्तु नो हन्याज्जातु वै पार्थ राक्षसः ।\nजीवन्तं न प्रमोक्ष्यामि मा भैषीर्भरतर्षभ \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2115150, "chapter_id": 3477, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2115151, "chapter_id": 3477, "verse_number": "२३", "content_sanskrit": "पूर्वरात्रे प्रबुद्धोऽसि भीमरूपेण रक्षसा ।\nक्षपा व्युष्टा न चेदानीं समाप्नोषि महारणम् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2115152, "chapter_id": 3477, "verse_number": "२४", "content_sanskrit": "किमनेन चिरं भीम जीवता दुष्टचारिणा ।\nनान्तरेण चिरं स्थातुमिह शक्यं परन्तप \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2115153, "chapter_id": 3477, "verse_number": "२५", "content_sanskrit": "पुरा संरज्यते प्राची पुरा सन्ध्या प्रवर्तते ।\nरौद्रे मुहूर्ते रक्षांसि भवन्ति बलवन्ति च \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2115154, "chapter_id": 3477, "verse_number": "२६", "content_sanskrit": "त्वरस्व भीम मा लीला जहि रक्षो विभीषणम् ।\nपुरा मायां विकुरुते भुजयोः सारमर्पय \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2115155, "chapter_id": 3477, "verse_number": "२७", "content_sanskrit": "माहात्म्यमात्मनो वेत्थ नराणां हितकाम्यया ।\nरक्षो जहि यथा शक्रः पुरा वृत्रं महाहवे \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2115156, "chapter_id": 3477, "verse_number": "२८", "content_sanskrit": "अथवा मन्यसे भारं त्वमिमं राक्षसं युधि ।\nआतिष्ठे तव साहाय्यं शीघ्रमेव तु हन्यताम् \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2115157, "chapter_id": 3477, "verse_number": "२९", "content_sanskrit": "अथवा ह्यहमेवैनं हनिष्यामि वृकोदर ।\nकृतकर्मा परिश्रान्तः साधु तावदुपारम \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2115158, "chapter_id": 3477, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2115159, "chapter_id": 3477, "verse_number": "३०", "content_sanskrit": "अर्जुनेनैवमुक्तस्तु भीमो भीमस्य रक्षसः ।\nउत्क्षिप्य भ्रामयद् देहं तूर्णं शतगुणाधिकम् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2115160, "chapter_id": 3477, "verse_number": "समाप्तिः", "content_sanskrit": "इति चोवाच सङ्क्रुद्धो भ्रामयन् राक्षसं तु सः ।\nभीमसेनो महाबाहुरभिगर्जन् मुहुर्मुहुः \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2115161, "chapter_id": 3477, "verse_number": "", "content_sanskrit": "भीमसेनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2115162, "chapter_id": 3477, "verse_number": "३२", "content_sanskrit": "वृथामांसो वृथापुष्टो वृथावृद्धो वृथामतिः ।\nवृथामरणमर्हस्त्वं वृथैव विनशिष्यसि \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2115163, "chapter_id": 3477, "verse_number": "३३", "content_sanskrit": "क्षेममेतत् करिष्यामि वनं निहतकण्टकम् ।\nन पुनर्मानुषान् हत्वा भक्षयिष्यसि राक्षस \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2115164, "chapter_id": 3477, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2115165, "chapter_id": 3477, "verse_number": "३४", "content_sanskrit": "इत्युक्त्वा भीमसेनस्तं निष्पिष्य धरणीतळे ।\nबाहुभ्यामवपीड्याशु पशुमारममारयत् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2115166, "chapter_id": 3477, "verse_number": "३५", "content_sanskrit": "स मार्यमाणो भीमेन ननाद विपुलं स्वनम् ।\nपूरयंस्तद्वनं सर्वं जलाब्द इव दुन्दुभिः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2115167, "chapter_id": 3477, "verse_number": "३६", "content_sanskrit": "भुजाभ्यां योक्त्रयित्वा तु बलवान् पाण्डुनन्दनः ।\nसमुद्भ्राम्य शिरश्चास्य सग्रीवं तदुदाहवत्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2115168, "chapter_id": 3477, "verse_number": "३७", "content_sanskrit": "मध्ये भित्त्वा शिरश्चास्य सग्रीवं तदुपाक्षिपत् ।\nतस्य निष्कर्णनयनं निर्जिह्वं रुधिरोक्षितम् \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2115169, "chapter_id": 3477, "verse_number": "३८", "content_sanskrit": "प्रविद्धं भीमसेनेन शिरो विदशनं बभौ ।\nप्रसारितभुजोद्धृष्टो भिन्नमांसत्वगन्तरः \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2115170, "chapter_id": 3477, "verse_number": "३९", "content_sanskrit": "कबन्धभूतस्तत्रासीदद्रिर्वज्रहतो यथा ।\nहिडिम्बं निहतं दृष्ट्वा प्रहृष्टास्तत्र पाण्डवाः \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2115171, "chapter_id": 3477, "verse_number": "४०", "content_sanskrit": "हिडिम्बी चैव सम्प्रेक्ष्य निहतं राक्षसं रणे ।\nअदृष्टाश्चैव ये खस्थाः समेता भूतचारकाः \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2115172, "chapter_id": 3477, "verse_number": "४१", "content_sanskrit": "पूजयन्ति स्म संहृष्टाः साधुसाध्विति पाण्डवम् ।\nभ्रातरश्चापि संहृष्टा युधिष्ठिरपुरोगमाः \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2115173, "chapter_id": 3477, "verse_number": "४२", "content_sanskrit": "अपूजयन् नरव्याघ्रं भीमसेनमरिन्दमम् ।\nअथ पूज्य महात्मानं भीमं भीमपराक्रमम् \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2115174, "chapter_id": 3477, "verse_number": "४३", "content_sanskrit": "पुनरेवार्जुनो वाक्यमुवाचेदं वृकोदरम् ।\nअदूरे नगरं मन्ये वनादस्मादहं प्रभो ।\nशीघ्रं गच्छाम भद्रं ते न नो विद्यात् सुयोधनः \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2115175, "chapter_id": 3477, "verse_number": "", "content_sanskrit": "वेशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2115176, "chapter_id": 3477, "verse_number": "४४", "content_sanskrit": "ततः सर्वे तथेत्युक्त्वा मात्रा सह महारथाः ।\nप्रययुः पुरुषव्याघ्रा हिडिम्बी चैव राक्षसी \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2115177, "chapter_id": 3477, "verse_number": "१५६", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nषट्पञ्चाशदधिकशततमोऽध्यायः ॥१५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2115178, "chapter_id": 3477, "verse_number": "४", "content_sanskrit": "॥ इति हिडिम्बवधपर्वणि चतुर्थोऽध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2115179, "chapter_id": 3477, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]