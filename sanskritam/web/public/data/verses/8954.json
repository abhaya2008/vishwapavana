[{"id": 40005680, "chapter_id": 8954, "verse_number": "1", "content_sanskrit": "अथ शैलाद्विनिष्क्रम्य मैथिलीं कोसलेश्वरः। अदर्शयच्छुभजलां रम्यां मन्दाकिनीं नदीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40005681, "chapter_id": 8954, "verse_number": "2", "content_sanskrit": "अब्रवीच्च वरारोहां चारुचन्द्रनिभाननाम्। विदेहराजस्य सुतां रामो राजीवलोचनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40005682, "chapter_id": 8954, "verse_number": "3", "content_sanskrit": "विचित्रपुलिनां रम्यां हंससारससेविताम्। कमलैरुपसम्पन्नां पश्य मन्दाकिनीं नदीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40005683, "chapter_id": 8954, "verse_number": "4", "content_sanskrit": "नानाविधैस्तीररुहै र्वृतां पुष्पफलद्रुमैः। राजन्तीं राजराजस्य नलिनीमिव सर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40005684, "chapter_id": 8954, "verse_number": "5", "content_sanskrit": "मृगयूथनिपीतानि कलुषाम्भांसि साम्प्रतम्। तीर्थानि रमणीयानि रतिं सञ्जनयन्ति मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40005685, "chapter_id": 8954, "verse_number": "6", "content_sanskrit": "जटाजिनधराः काले वल्कलोत्तरवाससः। ऋषय स्त्ववगाहन्ते नदीं मन्दाकिनीं प्रिये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40005686, "chapter_id": 8954, "verse_number": "7", "content_sanskrit": "आदित्यमुपतिष्ठन्ते नियमादूर्ध्वबाहवः। एते परे विशालाक्षि मुनय स्संशितव्रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40005687, "chapter_id": 8954, "verse_number": "8", "content_sanskrit": "मारुतोद्धूतशिखरैः प्रनृत्त इव पर्वतः। पादपैः पत्रपुष्पाणि सृजद्भिरभितो नदीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40005688, "chapter_id": 8954, "verse_number": "9", "content_sanskrit": "चिन्मणिनिकाशोदां क्वचित्पुलिनशालिनीम्। क्वचित्सिद्धजनाकीर्णां पश्य मन्दाकिनीं नदीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40005689, "chapter_id": 8954, "verse_number": "10", "content_sanskrit": "निर्धूतान्वायुना पश्य विततान्पुष्पसञ्चयान्। पोप्लूयमानानपरान्पश्य त्वं जलमध्यगान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40005690, "chapter_id": 8954, "verse_number": "11", "content_sanskrit": "तांश्चातिवल्गुवचसो रथाङ्गाह्वयना द्विजाः। अधिरोहन्ति कल्याणि निष्कूजन्त श्शुभा गिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40005691, "chapter_id": 8954, "verse_number": "12", "content_sanskrit": "दर्शनं चित्रकूटस्य मन्दाकिन्याश्च शोभने। अधिकं पुरवासाच्च मन्ये तव च दर्शनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40005692, "chapter_id": 8954, "verse_number": "13", "content_sanskrit": "विधूतकलुषै स्सिद्धैस्तपोदमशमान्वितैः। नित्यविक्षोभितजलां विगाहस्व मया सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40005693, "chapter_id": 8954, "verse_number": "14", "content_sanskrit": "सखीवच्च विगाहस्व सीते मन्दाकिनीं नदीम्। कमलान्यवमज्जन्ती पुष्कराणि च भामिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40005694, "chapter_id": 8954, "verse_number": "15", "content_sanskrit": "त्वं पौरजनवद्व्यालानयोध्यामिव पर्वतम्। मन्यस्व वनिते नित्यं सरयूवदिमां नदीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40005695, "chapter_id": 8954, "verse_number": "16", "content_sanskrit": "लक्ष्मणश्चापि धर्मात्मा मन्निदेशे व्यवस्थितः। त्वं चानुकूला वैदेहि प्रीतिं जनयथो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40005696, "chapter_id": 8954, "verse_number": "17", "content_sanskrit": "उपस्पृशंस्त्रिषवणं मधुमूलफलाशनः। नायोध्यायैन राज्याय स्पृहयेऽद्य त्वया सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40005697, "chapter_id": 8954, "verse_number": "18", "content_sanskrit": "इमांहि रम्यां मृगयूथशालिनीं निपीततोयां गजसिंहवानरैः। सुपुष्पितां पुष्पभरैरलङ्कृतां नसोऽस्ति य स्स्यान्न गतक्लम स्सुखी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40005698, "chapter_id": 8954, "verse_number": "19", "content_sanskrit": "इतीव रामो बहुसङ्गतं वचः प्रियासहाय स्सरितं प्रति ब्रुवन्। चचार रम्यं नयनाञ्जनप्रभं स चित्रकूटं रघुवंशवर्धनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]