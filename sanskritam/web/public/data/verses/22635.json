[{"id": 7002635000, "chapter_id": 22635, "verse_number": "६-१३-१", "content_sanskrit": "सूत उवाच ।\nकृतकृत्यः प्रसन्नात्मा वैतालो नृपमब्रवीत् ।\nनगरे चन्द्रहृदये रणधीरो नृपोऽभवत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002635001, "chapter_id": 22635, "verse_number": "६-१३-२", "content_sanskrit": "तत्र वैश्योऽवसद्धर्मी नाम्ना धर्मध्वजो धनी ।\nतस्य पुत्री समायाता सुन्दरी सुखभाविनी ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002635002, "chapter_id": 22635, "verse_number": "६-१३-३", "content_sanskrit": "एकदा नगरे तस्मिन्यातुभक्तो नरोऽभवत् ।\nद्यूतविद्यापरो नित्यं मद्यमांसपरायणः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002635003, "chapter_id": 22635, "verse_number": "६-१३-४", "content_sanskrit": "वाशरो नाम तत्रासीद्राक्षसः पुरुषादनः ।\nतस्मै मद्यं च मांसं च प्रत्यहं स च दत्तवान् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002635004, "chapter_id": 22635, "verse_number": "६-१३-५", "content_sanskrit": "प्रसन्नो राक्षसो भूत्वा यातुभक्तं तमब्रवीत् ।\nवरं वरय यो योग्यो मत्तः सर्वमवाप्स्यसि ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002635005, "chapter_id": 22635, "verse_number": "६-१३-६", "content_sanskrit": "स होवाच वरो मह्यं देयस्ते पुरुषादक ।\nगुप्तगर्तं च भूमध्ये कुरु चौरनिरूपणम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002635006, "chapter_id": 22635, "verse_number": "६-१३-७", "content_sanskrit": "इति श्रुत्वाकरोद्गर्तं नर बुद्धिविमोहनम् ।\nस्वयं तत्र स्थितो देवः स्वभक्तेन समन्वितः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002635007, "chapter_id": 22635, "verse_number": "६-१३-८", "content_sanskrit": "तेन रात्रौ तु चौर्येण नृपदासी वरांगना ।\nहृता संस्थापिता गर्ते बहुद्रव्यं तथा हृतम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002635008, "chapter_id": 22635, "verse_number": "६-१३-९", "content_sanskrit": "सप्तपत्न्योऽभवंस्तस्य चतुर्वर्णस्य योषितः ।\nतासां मध्ये भूपदासी तस्य चौरस्य वल्लभा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002635009, "chapter_id": 22635, "verse_number": "६-१३-१०", "content_sanskrit": "नृपदुर्गसमं गेहं रचितं तेन रक्षसा ।\nभूतले गुप्तरूपं च नरबुद्धिविमोहनम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002635010, "chapter_id": 22635, "verse_number": "६-१३-११", "content_sanskrit": "चोरितं बहुधा द्रव्यं गर्ते संस्थापितं बलात् ।\nतदा ते व्याकुला राजञ्जना राजानमब्रु वन् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002635011, "chapter_id": 22635, "verse_number": "६-१३-१२", "content_sanskrit": "त्यजाम नगरीं भूप चौरविघ्नकरीं तव ।\nइति श्रुत्वाथ भूपेन रक्षिणः शस्त्रसंयुताः ।\nस्थापिता नगरे तस्मिश्चौरहिंसापराय णाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002635012, "chapter_id": 22635, "verse_number": "६-१३-१३", "content_sanskrit": "आज्ञाप्य स ययौ गेहं तैस्तु श्रुत्वा तथा कृतम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002635013, "chapter_id": 22635, "verse_number": "६-१३-१४", "content_sanskrit": "राक्षस्या मायया सर्वे मोहिता रक्षिणस्तदा ।\nचौरेण बहुधा द्रव्यं हृतं च धनिनां वलात् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002635014, "chapter_id": 22635, "verse_number": "६-१३-१५", "content_sanskrit": "पुनस्ते प्रययुर्भूपं रणधीरं समेरयन् ।\nश्रुत्वा तु विस्मितो राजा स्वयं नगरमागतः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002635015, "chapter_id": 22635, "verse_number": "६-१३-१६", "content_sanskrit": "अर्धरात्रे तमोभूते स चौरो नृपमागतम् ।\nज्ञात्वाब्रवीच्च राजानं को भवानत्र चाप्तवान् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002635016, "chapter_id": 22635, "verse_number": "६-१३-१७", "content_sanskrit": "नृपोऽब्रवीदहं चौरश्चोदितार्थः समागतः ।\nयास्यामि धनिनां गेहे भवान्मे वचनं कुरु ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002635017, "chapter_id": 22635, "verse_number": "६-१३-१८", "content_sanskrit": "मया सार्द्धं च बहुधा द्रव्यं हर सुखी भव ।\nतथा मत्वा तु बहुधा चौरेण धनमाहृतम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002635018, "chapter_id": 22635, "verse_number": "६-१३-१९", "content_sanskrit": "गर्तमध्ये गतो रात्रौ स्थापयित्वा नृपं बहिः ।\nएतस्मिन्नेव तत्पत्नी नृपदासी वरांगना ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002635019, "chapter_id": 22635, "verse_number": "६-१३-२०", "content_sanskrit": "भूपतिं प्राह भो राजन्गच्छ शीघ्रं स्वकं गृहम् ।\nचौरोऽसौ हि त्वदर्थे च मृत्युं कुर्वन्गृहं गतः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002635020, "chapter_id": 22635, "verse_number": "६-१३-२१", "content_sanskrit": "इत्युक्त्वा सा तु भूपाय मार्गभेदमदर्शयत् ।\nनृपोऽपि स्वगृहं प्राप्य प्रभाते विमले रवौ ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002635021, "chapter_id": 22635, "verse_number": "६-१३-२२", "content_sanskrit": "आययौ सेनया सार्द्धं यत्र चौरः स्वयं स्थितः ।\nचौरोऽपि भयमासाद्य वाशरं नाम राक्षसम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002635022, "chapter_id": 22635, "verse_number": "६-१३-२३", "content_sanskrit": "संपूज्य वर्णयामास यथा जातं तथाविधि ।\nविहस्याह च रक्षस्तं त्वया मे भोजनं कृतम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002635023, "chapter_id": 22635, "verse_number": "६-१३-२४", "content_sanskrit": "अद्य भक्ष्याम्यहं सर्वान्मानुषान्दैवचोदितान् ।\nइत्युक्त्वा स ययौ घोरो राक्षसो नृपतिं प्रति ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002635024, "chapter_id": 22635, "verse_number": "६-१३-२५", "content_sanskrit": "चखाद बहुलां सेनां तेपि याता दिशो दश ।\nआक्रांतः स च भूपालो रक्षसा विकलीकृतः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002635025, "chapter_id": 22635, "verse_number": "६-१३-२६", "content_sanskrit": "तदा चौरः स्वयं प्राप्य भूपतिं प्राह रोषतः ।\nपलायनं न भूपस्य योग्यं धर्मजनस्य वै ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002635026, "chapter_id": 22635, "verse_number": "६-१३-२७", "content_sanskrit": "इति श्रुत्वा नृपश्चैव तूर्णमागत्य तत्र ह ।\nध्यात्वा देवीं महाकालीं लब्ध्वा मंत्रं महोत्तमम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002635027, "chapter_id": 22635, "verse_number": "६-१३-२८", "content_sanskrit": "रक्षसा सह तद्गर्तं भस्मसादभवत्क्षणात् ।\nनिगडैस्तं बबंधाशु चौरं नगरलुंठकम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002635028, "chapter_id": 22635, "verse_number": "६-१३-२९", "content_sanskrit": "तथा सर्वधनैः सार्धं स्त्रीभिस्ताभिः समाययौ ।\nराज्यस्थानं समासाद्य दुर्गतिस्तस्य चाभवत् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002635029, "chapter_id": 22635, "verse_number": "६-१३-३०", "content_sanskrit": "पटहाताडितेनैव शब्देन च गृहेगृहे ।\nज्ञापितं करणं सर्वं तच्चौरस्य वधस्य तैः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002635030, "chapter_id": 22635, "verse_number": "६-१३-३१", "content_sanskrit": "तद्दिने नगरे तस्मिन्भ्रामितो गर्दभोपरि ।\nधर्मध्वजगृहद्वारे स चौरो हि समागतः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002635031, "chapter_id": 22635, "verse_number": "६-१३-३२", "content_sanskrit": "तस्य रूपं समालोक्य मुमोह सुखभाविनी ।\nपितरं प्राह दुःखार्ता चौरं मोचय सत्वरम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002635032, "chapter_id": 22635, "verse_number": "६-१३-३३", "content_sanskrit": "स गत्वा नृपतिं प्राह पंचलक्षधनं मम ।\nगृहाण चौरमोक्षार्थे म्रियते न हि मे सुता ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002635033, "chapter_id": 22635, "verse_number": "६-१३-३४", "content_sanskrit": "विहस्याह नृपस्तं वै चौरोऽयं धनलुंठकः ।\nकर्हिचिन्न मया त्याज्यो भुवि वै पुरुषाधमः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002635034, "chapter_id": 22635, "verse_number": "६-१३-३५", "content_sanskrit": "इति श्रुत्वा निराशोऽभूत्स चौरो मरणं गतः ।\nशल्यारोपणकाले तु प्राक्प्रहस्य ततोऽरुदत् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002635035, "chapter_id": 22635, "verse_number": "६-१३-३६", "content_sanskrit": "एतस्मिन्नेव तत्पुत्री देवमायाविमोहिता ।\nगृहीत्वा चौरदेहं तु वह्निकुण्डे तु सागमत् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002635036, "chapter_id": 22635, "verse_number": "६-१३-३७", "content_sanskrit": "तदा प्रसन्ना सा दुर्गा तावुजीव्य प्रसादतः ।\nतस्यै दत्तो वरो दिव्यो भुक्तिमुक्तिफलप्रदः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002635037, "chapter_id": 22635, "verse_number": "६-१३-३८", "content_sanskrit": "इत्युक्त्वा स तु भूपालं पुनः प्राह विहस्य तम् ।\nकिं कारणेन चौरोसौ प्राक्प्रहस्य ततोऽरुदत् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002635038, "chapter_id": 22635, "verse_number": "६-१३-३९", "content_sanskrit": "राजोवाच ।\nमदर्थे सुन्दरी नारी स्वप्राणान्दातुमुद्यता ।\nतस्यै किं च प्रदातव्यं मया तत्स्नेहरूपिणा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002635039, "chapter_id": 22635, "verse_number": "६-१३-४०", "content_sanskrit": "अतो रोदितवान्पश्चाद्धसने कारणं शृणु ।\nधन्योऽयं भगवान्कृष्णो यस्य लीलेयमीदृशी ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002635040, "chapter_id": 22635, "verse_number": "६-१३-४१", "content_sanskrit": "अधर्मिणे च नाकस्य फलं दातुं समर्हति ।\nधर्मिणे नरकस्यैव फलं तस्मै नमोनमः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002635041, "chapter_id": 22635, "verse_number": "६-१३-४२", "content_sanskrit": "अतः स हसितः पूर्वं मोहितो हरिलीलया ।\nइति श्रुत्वाह वैतालो हरेः शरणमुत्तमम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002635042, "chapter_id": 22635, "verse_number": "६-१३-४३", "content_sanskrit": "वाक्यं तेन कृतं शूल्यामतो जीवितवाच्छुचिः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]