[{"id": 5000169000, "chapter_id": 9169, "verse_number": "२-९२-१", "content_sanskrit": "ततस्तां रजनीं व्युष्य भरत: सपरिच्छद: ।\nकृतातिथ्यो भरद्वाजं कामादभिजगाम ऺह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000169001, "chapter_id": 9169, "verse_number": "२-९२-२", "content_sanskrit": "तमृषि: पुरुषव्याघ्रं प्राञ्जलिं प्रेक्ष्य चागतम् ।\nहुताग्निहोत्रो भरतं भरद्वाजो ऽभ्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000169002, "chapter_id": 9169, "verse_number": "२-९२-३", "content_sanskrit": "कच्चिदत्र सुखा रात्रिस्तवास्मद्विषये गता ।\nसमग्रस्ते जन: कच्चिदातिथ्ये शंस मे ऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000169003, "chapter_id": 9169, "verse_number": "२-९२-४", "content_sanskrit": "तमुवाचाञ्जलिं कृत्वा भरतो ऽभिप्रणम्य च ।\nआश्रमादभिनिष्क्रान्तमृषिमुत्तमतेजसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000169004, "chapter_id": 9169, "verse_number": "२-९२-५", "content_sanskrit": "सुखोषितो ऽस्मि भगवन् समग्रबलवाहन: ।\nतर्पित: सर्वकामैश्च सामात्यो बलवत्त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000169005, "chapter_id": 9169, "verse_number": "२-९२-६", "content_sanskrit": "अपेतक्लमसन्तापा: सुभिक्षा: सुप्रतिश्रया: ।\nअपि प्रेष्यानुपादाय सर्वे स्म सुसुखोषिता: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000169006, "chapter_id": 9169, "verse_number": "२-९२-७", "content_sanskrit": "आमन्त्रये ऽहं भगवन् कामं त्वामृषिसत्तम ।\nसमीपं प्रस्थितं भ्रातुर्मैत्रेणेक्षस्व चक्षुषा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000169007, "chapter_id": 9169, "verse_number": "२-९२-८", "content_sanskrit": "आश्रमं तस्य धर्मज्ञ धार्मिकस्य महात्मन: ।\nआचक्ष्व कतमो मार्ग: कियानिति च शंस मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000169008, "chapter_id": 9169, "verse_number": "२-९२-९", "content_sanskrit": "इति पृष्टस्तु भरतं भ्रातृदर्शनलालसम् ।\nप्रत्युवाच महातेजा भरद्वाजो महातपा: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000169009, "chapter_id": 9169, "verse_number": "२-९२-१०", "content_sanskrit": "भरतार्द्धतृतीयेषु योजनेष्वजने वने ।\nचित्रकूटो गिरिस्तत्र रम्यनिर्दरकानन: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000169010, "chapter_id": 9169, "verse_number": "२-९२-११", "content_sanskrit": "उत्तरं पार्श्वमासाद्य तस्य मन्दाकिनी नदी ।\nपुष्ऺिपतद्रुमसञ्छन्ना रम्यपुष्पितकानना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000169011, "chapter_id": 9169, "verse_number": "२-९२-१२", "content_sanskrit": "अनन्तरं तत्सरितश्चित्रकूटश्च पर्वत: ।\nतयो: पर्णकुटी तात तत्र तौ वसतो ध्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000169012, "chapter_id": 9169, "verse_number": "२-९२-१३", "content_sanskrit": "दक्षिणेनैव मार्गेण सव्यदक्षिणमेव वा ।\nगजवाजिरथाकीर्णां वाहिनीं वाहिनीपते ।\nवाहयस्व महाभाग ततो द्रक्ष्यसि राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000169013, "chapter_id": 9169, "verse_number": "२-९२-१४", "content_sanskrit": "प्रयाणमिति तच्छ्रुत्वा राजराजस्य योषित: ।\nहित्वा यानानि यानार्हा ब्राह्मणं पर्य्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000169014, "chapter_id": 9169, "verse_number": "२-९२-१५", "content_sanskrit": "वेपमाना कृशा ऺदीना सह देव्या सुमित्रया ।\nकौसल्या तत्र जग्राह कराभ्यां चरणौ मुने: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000169015, "chapter_id": 9169, "verse_number": "२-९२-१६", "content_sanskrit": "असमृद्धेन कामेन सर्वलोकस्य गर्हिता ।\nकैकेयी तस्य जग्राह चरणौ सव्यपत्रपा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000169016, "chapter_id": 9169, "verse_number": "२-९२-१७", "content_sanskrit": "तं प्रदक्षिणमागम्य भगवन्तं महामुनिम् ।\nअदूराद्भरतस्यैव तस्थौ दीनमनास्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000169017, "chapter_id": 9169, "verse_number": "२-९२-१८", "content_sanskrit": "तत: पप्रच्छ भरतं भरद्वाजो दृढव्रत: ।\nविशेषं ज्ञातुमिच्छामि मातऽणां तव राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000169018, "chapter_id": 9169, "verse_number": "२-९२-१९", "content_sanskrit": "एवमुक्तस्तु भरतो भरद्वाजेन धार्मिक: ।\nउवाच प्राञ्जलिर्भूत्वा वाक्यं वचनकोविद: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000169019, "chapter_id": 9169, "verse_number": "२-९२-२०", "content_sanskrit": "यामिमां भगवन् दीनां शोकानशनकर्शिताम् ।\nपितुर्हि महिषीं देवीं देवतामिव पश्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000169020, "chapter_id": 9169, "verse_number": "२-९२-२१", "content_sanskrit": "एषा तं पुरुषव्याघ्रं सिंहविक्रान्तगामिनम् ।\nकौसल्या सुषुवे रामं धातारमदितिर्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000169021, "chapter_id": 9169, "verse_number": "२-९२-२२", "content_sanskrit": "अस्यावामभुजं श्लिष्टा यैषा तिष्ठति दुर्मना: ।\nकर्णिकारस्य शाखेव शीर्णपुष्पा वनान्तरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000169022, "chapter_id": 9169, "verse_number": "२-९२-२३", "content_sanskrit": "एतस्यास्तु सुतौ देव्या: कुमारौ देववर्णिनौ ।\nउभौ लक्ष्मणशत्रुघ्नौ वीरौ सत्यपराक्रमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000169023, "chapter_id": 9169, "verse_number": "२-९२-२४", "content_sanskrit": "यस्या: कृते नरव्याघ्रौ जीवनाशमितो गतौ ।\nराजपुत्रविहीनश्च स्वर्गं दशरथो गत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000169024, "chapter_id": 9169, "verse_number": "२-९२-२५", "content_sanskrit": "क्रोधनामकृतप्रज्ञां दृप्तां सुभगमानिनीम् ।\nऐश्वर्यकामां कैकेयीमनार्य्यामार्यरूपिणीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000169025, "chapter_id": 9169, "verse_number": "२-९२-२६", "content_sanskrit": "ममैतां मातरं विद्धि नृशंसां पापनिश्चयाम् ।\nयतो मूलं हि पश्यामि व्यसनं महदात्मन: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000169026, "chapter_id": 9169, "verse_number": "२-९२-२७", "content_sanskrit": "इत्युक्त्वा नरशार्दूलो बाष्पगद्गदया गिरा ।\nस निशश्वास ताम्राक्षो नाग: क्रुद्ध इव श्वसन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000169027, "chapter_id": 9169, "verse_number": "२-९२-२८", "content_sanskrit": "भरद्वाजो महर्षिस्तं ब्रुवन्तं भरतं तथा ।\nप्रत्युवाच महाबुद्धिरिदं वचनमर्थवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000169028, "chapter_id": 9169, "verse_number": "२-९२-२९", "content_sanskrit": "न दोषेणावगन्तव्या कैकेयी भरत त्वया ।\nरामप्रव्राजनं ह्येतत् सुखोदर्कं भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000169029, "chapter_id": 9169, "verse_number": "२-९२-३०", "content_sanskrit": "देवानां दानवानां च ऋषीणां भावितात्मनाम् ।\nहितमेव भविष्यद्धि रामप्रव्राजनादिह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000169030, "chapter_id": 9169, "verse_number": "२-९२-३१", "content_sanskrit": "अभिवाद्य तु संसिद्ध: कृत्वा चैनं प्रदक्षिणम् ।\nआमन्त्र्य भरत: सेन्यं युज्यतामित्यचोदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000169031, "chapter_id": 9169, "verse_number": "२-९२-३२", "content_sanskrit": "ततो वाजिरथान् युक्त्वा दिव्यान् हेमपरिष्कृतान् ।\nअध्यारोहत् प्रयाणार्थी बहून् बहुविधो जन: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000169032, "chapter_id": 9169, "verse_number": "२-९२-३३", "content_sanskrit": "गजकन्या गजाश्चैव हेमकक्ष्या: पताकिन: ।\nजीमूता इव घर्मान्ते सघोषा: सम्प्रतस्थिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000169033, "chapter_id": 9169, "verse_number": "२-९२-३४", "content_sanskrit": "विविधान्यपि यानानि महान्ति च लघूनि च ।\nप्रययु: सुमहार्हाणि पादैरेव पदातय: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000169034, "chapter_id": 9169, "verse_number": "२-९२-३५", "content_sanskrit": "अथ यानप्रवेकैस्तु कौसल्याप्रमुखा: स्त्रिय: ।\nरामदर्शनकांक्षिण्य: प्रययुर्मुदितास्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000169035, "chapter_id": 9169, "verse_number": "२-९२-३६", "content_sanskrit": "चन्द्रार्कतरुणाभासां नियुक्तां शिबिकां शुभाम् ।\nआस्थाय प्रययौ श्रीमान् भरत: सपरिच्छद: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000169036, "chapter_id": 9169, "verse_number": "२-९२-३७", "content_sanskrit": "सा प्रयाता महासेना गजवाजिरथाकुला ।\nदक्षिणां दिशमावृत्य महामेघ इवोत्थित: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000169037, "chapter_id": 9169, "verse_number": "२-९२-३८", "content_sanskrit": "वनानि तु व्यतिक्रम्य जुष्टानि मृगपक्षिभि: ।\nगङ्गाया: परवेलायां गिरिष्वपि नदीषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000169038, "chapter_id": 9169, "verse_number": "२-९२-३९", "content_sanskrit": "सा सम्प्रहृष्टद्विजवाजियोधा वित्रासयन्ती मृगपक्षिसङ्घान् ।\nमहद्वनं तत्प्रतिगाहमाना रराज सेना भरतस्य तत्र ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000169039, "chapter_id": 9169, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदयोध्याकाण्डे द्विनवतितम: सर्ग: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]