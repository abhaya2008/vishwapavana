[{"id": 5000001000, "chapter_id": 9001, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकीयरामायणे बालकाण्डे प्रथमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000001001, "chapter_id": 9001, "verse_number": "१-१-१", "content_sanskrit": "तपः स्वाध्यायनिरतं तपस्वी वाग्विदां वरम् ।\nनारदं परिपप्रच्छ वाल्मीकिर्मुनिपुङ्गवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000001002, "chapter_id": 9001, "verse_number": "१-१-२", "content_sanskrit": "को न्वस्मिन्साम्प्रतं लोके गुणवान्कश्च वीर्यवान् ।\nधर्मज्ञश्च कृतज्ञश्च सत्यवाक्यो दृढव्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000001003, "chapter_id": 9001, "verse_number": "१-१-३", "content_sanskrit": "चारित्रेण च को युक्तः सर्वभूतेषु को हितः ।\nविद्वान्कः कः समर्थश्च कश्चैकप्रियदर्शनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000001004, "chapter_id": 9001, "verse_number": "१-१-४", "content_sanskrit": "आत्मवान्को जितक्रोधो द्युतिमान्कोऽनसूयकः ।\nकस्य बिभ्यति देवाश्च जातरोषस्य संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000001005, "chapter_id": 9001, "verse_number": "१-१-५", "content_sanskrit": "एतदिच्छाम्यहं श्रोतुं परं कौतूहलं हि मे ।\nमहर्षे त्वं समर्थोऽसि ज्ञातुमेवंविधं नरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000001006, "chapter_id": 9001, "verse_number": "१-१-६", "content_sanskrit": "श्रुत्वा चैतत्त्रिलोकज्ञो वाल्मीकेर्नारदो वचः ।\nश्रूयतामिति चामन्त्र्य प्रहृष्टो वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000001007, "chapter_id": 9001, "verse_number": "१-१-७", "content_sanskrit": "बहवो दुर्लभाश्चैव ये त्वया कीर्तिता गुणाः ।\nमुने वक्ष्याम्यहं बुद्ध्वा तैर्युक्तः श्रूयतां नरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000001008, "chapter_id": 9001, "verse_number": "१-१-८", "content_sanskrit": "इक्ष्वाकुवंशप्रभवो रामो नाम जनैः श्रुतः ।\nनियतात्मा महावीर्यो द्युतिमान्धृतिमान्वशी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000001009, "chapter_id": 9001, "verse_number": "१-१-९", "content_sanskrit": "बुद्धिमान्नीतिमान्वाग्मी श्रीमाञ्छ्त्रुनिबर्हणः ।\nविपुलांसो महाबाहुः कम्बुग्रीवो महाहनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000001010, "chapter_id": 9001, "verse_number": "१-१-१०", "content_sanskrit": "महोरस्को महेष्वासो गूढजत्रुररिन्दमः ।\nआजानुबाहुः सुशिराः सुललाटः सुविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000001011, "chapter_id": 9001, "verse_number": "१-१-११", "content_sanskrit": "समः समविभक्ताङ्गः स्निग्धवर्णः प्रतापवान् ।\nपीनवक्षा विशालाक्षो लक्ष्मीवाञ्छुभलक्षणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000001012, "chapter_id": 9001, "verse_number": "१-१-१२", "content_sanskrit": "धर्मज्ञः सत्यसन्धश्च प्रजानां च हिते रतः ।\nयशस्वी ज्ञानसम्पन्नः शुचिर्वश्यः समाधिमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000001013, "chapter_id": 9001, "verse_number": "१-१-१३", "content_sanskrit": "प्रजापतिसमः श्रीमान् धाता रिपुनिषूदनः ।\nरक्षिता जीवलोकस्य धर्मस्य परिरक्षिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000001014, "chapter_id": 9001, "verse_number": "१-१-१४", "content_sanskrit": "रक्षिता स्वस्य धर्मस्य स्वजनस्य च रक्षिता ।\nवेदवेदाङ्गतत्त्वज्ञो धनुर्वेदे च निष्ठितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000001015, "chapter_id": 9001, "verse_number": "१-१-१५", "content_sanskrit": "सर्वशास्त्रार्थतत्त्वज्ञो स्मृतिमान् प्रतिभानवान् ।\nसर्वलोकप्रियः साधुरदीनात्मा विचक्षणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000001016, "chapter_id": 9001, "verse_number": "१-१-१६", "content_sanskrit": "सर्वदाभिगतः सद्भिः समुद्र इव सिन्धुभिः ।\nआर्यः सर्वसमश्चैव सदैव प्रियदर्शनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000001017, "chapter_id": 9001, "verse_number": "१-१-१७", "content_sanskrit": "स च सर्व गुणोपेतः कौसल्यानन्दवर्धनः ।\nसमुद्र इव गाम्भीर्ये धैर्येण हिमवानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000001018, "chapter_id": 9001, "verse_number": "१-१-१८", "content_sanskrit": "विष्णुना सदृशो वीर्ये सोमवत्प्रियदर्शनः ।\nकालाग्निसदृशः क्रोधे क्षमया पृथिवीसमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000001019, "chapter_id": 9001, "verse_number": "१-१-१९", "content_sanskrit": "धनदेन समस्त्यागे सत्ये धर्म इवापरः ।\nतमेवंगुणसम्पन्नं रामं सत्यपराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000001020, "chapter_id": 9001, "verse_number": "१-१-२०", "content_sanskrit": "ज्येष्ठं ज्येष्ठगुणैर्युक्तं प्रियं दशरथस्सुतम् ।\nप्रकृतीनां हितैर्युक्तं प्रकृतिप्रियकाम्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000001021, "chapter_id": 9001, "verse_number": "१-१-२१", "content_sanskrit": "यौवराज्येन संयोक्तुम् ऐच्छत्प्रीत्या महीपतिः ।\nतस्याभिषेकसम्भारान् दृष्ट्वा भार्याथ कैकयी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000001022, "chapter_id": 9001, "verse_number": "१-१-२२", "content_sanskrit": "पूर्वं दत्तवरा देवी वरमेनमयाचत ।\nविवासनञ्च रामस्य भरतस्याभिषेचनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000001023, "chapter_id": 9001, "verse_number": "१-१-२३", "content_sanskrit": "स सत्यवचनाद्राजा धर्मपाशेन संयतः ।\nविवासयामास सुतं रामं दशरथः प्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000001024, "chapter_id": 9001, "verse_number": "१-१-२४", "content_sanskrit": "स जगाम वनं वीरः प्रतिज्ञामनुपालयन् ।\nपितुर्वचननिर्देशात् कैकेय्याः प्रियकारणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000001025, "chapter_id": 9001, "verse_number": "१-१-२५", "content_sanskrit": "तं व्रजन्तं प्रियो भ्राता लक्ष्मणोऽनुजगाम ह ।\nस्नेहाद् विनयसम्पन्नः सुमित्रानन्दवर्धनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000001026, "chapter_id": 9001, "verse_number": "१-१-२६", "content_sanskrit": "भ्रातरं दयितो भ्रातुः सौभ्रात्रमनुदर्शयन् ।\nरामस्य दयिता भार्या नित्यं प्राणसमा हिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000001027, "chapter_id": 9001, "verse_number": "१-१-२७", "content_sanskrit": "जनकस्य कुले जाता देवमायेव निर्मिता ।\nसर्वलक्षणसम्पन्ना नारीणामुत्तमा वधूः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000001028, "chapter_id": 9001, "verse_number": "१-१-२८", "content_sanskrit": "सीताप्यनुगता रामं शशिनं रोहिणी यथा ।\nपौरैरनुगतो दूरं पित्रा दशरथेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000001029, "chapter_id": 9001, "verse_number": "१-१-२९", "content_sanskrit": "शृङ्गवीरपुरे सूतं गङ्गाकूले व्यसर्जयत् ।\nगुहमासाद्य धर्मात्मा निषादाधिपतिं प्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000001030, "chapter_id": 9001, "verse_number": "१-१-३०", "content_sanskrit": "गुहेन सहितो रामो लक्ष्मणेन च सीतया ।\nते वनेन वनङ्गत्वा नदीस्तीर्त्वा बहूदकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000001031, "chapter_id": 9001, "verse_number": "१-१-३१", "content_sanskrit": "चित्रकूटमनुप्राप्य भरद्वाजस्य शासनात् ।\nरम्यमावसथं कृत्वा रममाणा वने त्रयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000001032, "chapter_id": 9001, "verse_number": "१-१-३२", "content_sanskrit": "देवगन्धर्वसंकाशाः तत्र ते न्यवसन् सुखम् ।\nचित्रकूटङ्गते रामे पुत्रशोकातुरस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000001033, "chapter_id": 9001, "verse_number": "१-१-३३", "content_sanskrit": "राजा दशरथस्स्वर्गं जगाम विलपन् सुतम् ।\nगते तु तस्मिन् भरतो वसिष्ठप्रमुखैर्द्विजैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000001034, "chapter_id": 9001, "verse_number": "१-१-३४", "content_sanskrit": "नियुज्यमानो राज्याय नैच्छत् राज्यं महाबलः ।\nस जगाम वनं वीरो रामपादप्रसादकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000001035, "chapter_id": 9001, "verse_number": "१-१-३५", "content_sanskrit": "गत्वा तु स महात्मानं रामं सत्यपराक्रमम् ।\nअयाचद्भ्रातरं रामम् आर्यभावपुरस्कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000001036, "chapter_id": 9001, "verse_number": "१-१-३६", "content_sanskrit": "त्वमेव राजा धर्मज्ञ इति रामं वचोऽब्रवीत् ।\nरामोऽपि परमोदारः सुमुखस्सुमहायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000001037, "chapter_id": 9001, "verse_number": "१-१-३७", "content_sanskrit": "न चैच्छत् पितुरादेशात् राज्यं रामो महाबलः ।\nपादुके चास्य राज्याय न्यासं दत्त्वा पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000001038, "chapter_id": 9001, "verse_number": "१-१-३८", "content_sanskrit": "निवर्तयामास ततो भरतं भरताग्रजः ।\nस काममनवाप्यैव रामपादावुपस्पृशन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000001039, "chapter_id": 9001, "verse_number": "१-१-३९", "content_sanskrit": "नन्दिग्रामेऽकरोद् राज्यं रामागमनकाङ्क्षया ।\nगते तु भरते श्रीमान् सत्यसन्धो जितेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000001040, "chapter_id": 9001, "verse_number": "१-१-४०", "content_sanskrit": "रामस्तु पुनरालक्ष्य नागरस्य जनस्य च ।\nतत्रागमनमेकाग्रो दण्डकान् प्रविवेश ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000001041, "chapter_id": 9001, "verse_number": "१-१-४१", "content_sanskrit": "प्रविश्य तु महारण्यं रामो राजीवलोचनः ।\nविराधं राक्षसं हत्वा शरभङ्गं ददर्श ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000001042, "chapter_id": 9001, "verse_number": "१-१-४२", "content_sanskrit": "सुतीक्ष्णं चाप्यगस्त्यं च अगस्त्यभ्रातरं तथा ।\nअगस्त्यवचनाच्चैव जग्राहैन्द्रं शरासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000001043, "chapter_id": 9001, "verse_number": "१-१-४३", "content_sanskrit": "खड्गञ्च परम प्रीतस्तूणी चाक्षयसायकौ ।\nवसतस्तस्य रामस्य वने वनचरैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000001044, "chapter_id": 9001, "verse_number": "१-१-४४", "content_sanskrit": "ऋषयोऽभ्यागमन् सर्वे वधायासुररक्षसाम् ।\nस तेषां प्रतिशुश्राव राक्षसानां तदा वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000001045, "chapter_id": 9001, "verse_number": "१-१-४५", "content_sanskrit": "प्रतिज्ञातश्च रामेण वधः संयति रक्षसाम् ।\nऋषीणामग्निकल्पानां दण्डकारण्यवासीनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000001046, "chapter_id": 9001, "verse_number": "१-१-४६", "content_sanskrit": "तेन तत्रैव वसता जनस्थाननिवासिनी ।\nविरूपिता शूर्पणखा राक्षसी कामरूपिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000001047, "chapter_id": 9001, "verse_number": "१-१-४७", "content_sanskrit": "ततः शूर्पणखावाक्यादुद्युक्तान् सर्वराक्षसान् ।\nखरं त्रिशिरसं चैव दूषणं चैव राक्षसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000001048, "chapter_id": 9001, "verse_number": "१-१-४८", "content_sanskrit": "निजघान रणे रामस्तेषां चैव पदानुगान् ।\nवने तस्मिन् निवसता जनस्थाननिवासिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000001049, "chapter_id": 9001, "verse_number": "१-१-४९", "content_sanskrit": "रक्षसां निहतान्यासन् सहस्राणि चतुर्दश ।\nततो ज्ञातिवधं श्रुत्वा रावणः क्रोधमूर्छितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000001050, "chapter_id": 9001, "verse_number": "१-१-५०", "content_sanskrit": "सहायं वरयामास मारीचं नाम राक्षसम् ।\nवार्यमाणः सुबहुशो मारीचेन स रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000001051, "chapter_id": 9001, "verse_number": "१-१-५१", "content_sanskrit": "न विरोधो बलवता क्षमो रावण तेन ते ।\nअनादृत्य तु तद्वाक्यं रावणः कालचोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000001052, "chapter_id": 9001, "verse_number": "१-१-५२", "content_sanskrit": "जगाम सहमारीचस्तस्याश्रमपदं तदा ।\nतेन मायाविना दूरमपवाह्य नृपात्मजौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000001053, "chapter_id": 9001, "verse_number": "१-१-५३", "content_sanskrit": "जहार भार्यां रामस्य गृध्रं हत्वा जटायुषम् ।\nगृध्रञ्च निहतं दृष्ट्वा हृतां श्रुत्वा च मैथिलीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000001054, "chapter_id": 9001, "verse_number": "१-१-५४", "content_sanskrit": "राघवः शोकसंतप्तो विललापाकुलेन्द्रियः ।\nततस्तेनैव शोकेन गृध्रं दग्ध्वा जटायुषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000001055, "chapter_id": 9001, "verse_number": "१-१-५५", "content_sanskrit": "मार्गमाणो वने सीतां राक्षसं सन्ददर्श ह ।\nकबन्धं नाम रूपेण विकृतं घोरदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000001056, "chapter_id": 9001, "verse_number": "१-१-५६", "content_sanskrit": "तन्निहत्य महाबाहुर्ददाह स्वर्गतश्च सः ।\nस चास्य कथयामास शबरीं धर्मचारिणीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000001057, "chapter_id": 9001, "verse_number": "१-१-५७", "content_sanskrit": "श्रमणां धर्मनिपुणामभिगच्छेति राघव ।\nसोऽभ्य गच्छन्महातेजाः शबरीं शत्रुसूदनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000001058, "chapter_id": 9001, "verse_number": "१-१-५८", "content_sanskrit": "शबर्या पूजितः सम्यग् रामो दशरथात्मजः ।\nपम्पातीरे हनुमता सङ्गतो वानरेण ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000001059, "chapter_id": 9001, "verse_number": "१-१-५९", "content_sanskrit": "हनुमद्वचनाच्चैव सुग्रीवेण समागतः ।\nसुग्रीवाय च तत्सर्वं शंसद्रामो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000001060, "chapter_id": 9001, "verse_number": "१-१-६०", "content_sanskrit": "आदितस्तद् यथावृत्तं सीतायाश्च विशेषतः ।\nसुग्रीवश्चापि तत्सर्वं श्रुत्वा रामस्य वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000001061, "chapter_id": 9001, "verse_number": "१-१-६१", "content_sanskrit": "चकार सख्यं रामेण प्रीतश्चैवाग्निसाक्षिकम् ।\nततो वानरराजेन वैरानुकथनं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000001062, "chapter_id": 9001, "verse_number": "१-१-६२", "content_sanskrit": "रामायावेदितं सर्वं प्रणयात् दुःखितेन च ।\nप्रतिज्ञातञ्च रामेण तदा वालिवधं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000001063, "chapter_id": 9001, "verse_number": "१-१-६३", "content_sanskrit": "वालिनश्च बलं तत्र कथयामास वानरः ।\nसुग्रीवः शङ्कितश्चासीन्नित्यं वीर्येण राघवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000001064, "chapter_id": 9001, "verse_number": "१-१-६४", "content_sanskrit": "राघवप्रत्ययार्थं तु दुन्दुभेः कायमुत्तमम् ।\nदर्शयामास सुग्रीवः महापर्वतसन्निभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000001065, "chapter_id": 9001, "verse_number": "१-१-६५", "content_sanskrit": "उत्स्मयित्वा महाबाहुः प्रेक्ष्य चास्ति महाबलः ।\nपादाङ्गुष्ठेन चिक्षेप संपूर्णं दशयोजनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 5000001066, "chapter_id": 9001, "verse_number": "१-१-६६", "content_sanskrit": "बिभेद च पुनस्सालान् सप्तैकेन महेषुणा ।\nगिरिं रसातलञ्चैव जनयन् प्रत्ययं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 5000001067, "chapter_id": 9001, "verse_number": "१-१-६७", "content_sanskrit": "ततः प्रीतमनास्तेन विश्वस्तस्स महाकपिः ।\nकिष्किन्धां रामसहितो जगाम च गुहां तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 5000001068, "chapter_id": 9001, "verse_number": "१-१-६८", "content_sanskrit": "ततोऽगर्जद्धरिवरः सुग्रीवो हेमपिङ्गलः ।\nतेन नादेन महता निर्जगाम हरीश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 5000001069, "chapter_id": 9001, "verse_number": "१-१-६९", "content_sanskrit": "अनुमान्य तदा तारां सुग्रीवेण समागतः ।\nनिजघान च तत्रैनं शरेणैकेन राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 5000001070, "chapter_id": 9001, "verse_number": "१-१-७०", "content_sanskrit": "ततः सुग्रीववचनात् हत्वा वालिनमाहवे ।\nसुग्रीवमेव तद्राज्ये राघवः प्रत्यपादयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 5000001071, "chapter_id": 9001, "verse_number": "१-१-७१", "content_sanskrit": "स च सर्वान् समानीय वानरान् वानरर्षभः ।\nदिशः प्रस्थापयामास दिदृक्षुर्जनकात्मजाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 5000001072, "chapter_id": 9001, "verse_number": "१-१-७२", "content_sanskrit": "ततो गृध्रस्य वचनात् संपातेर्हनुमान् बली ।\nशतयोजनविस्तीर्णं पुप्लुवे लवणार्णवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 5000001073, "chapter_id": 9001, "verse_number": "१-१-७३", "content_sanskrit": "तत्र लङ्कां समासाद्य पुरीं रावणपालिताम् ।\nददर्श सीतां ध्यायन्तीम् अशोकवनिकां गताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 5000001074, "chapter_id": 9001, "verse_number": "१-१-७४", "content_sanskrit": "निवेदयित्वाभिज्ञानं प्रवृत्तिं विनिवेद्य च ।\nसमाश्वास्य च वैदेहीं मर्दयामास तोरणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 5000001075, "chapter_id": 9001, "verse_number": "१-१-७५", "content_sanskrit": "पञ्च सेनाग्रगान् हत्वा सप्त मन्त्रिसुतानपि ।\nशूरमक्षं च निष्पिष्य ग्रहणं समुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 5000001076, "chapter_id": 9001, "verse_number": "१-१-७६", "content_sanskrit": "अस्त्रेणोन्मुक्तमात्मानं ज्ञात्वा पैतामहाद् वरात् ।\nमर्षयन् राक्षसान् वीरो यन्त्रिणस्तान् यदृच्छया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 5000001077, "chapter_id": 9001, "verse_number": "१-१-७७", "content_sanskrit": "ततो दग्ध्वा पुरीं लङ्काम् ऋते सीताञ्च मैथिलीम् ।\nरामाय प्रियमाख्यातुं पुनरायान्महाकपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 5000001078, "chapter_id": 9001, "verse_number": "१-१-७८", "content_sanskrit": "सोऽभिगम्य महात्मानं कृत्वा रामं प्रदक्षिणम् ।\nन्यवेदयदमेयात्मा दृष्टा सीतेति तत्त्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 5000001079, "chapter_id": 9001, "verse_number": "१-१-७९", "content_sanskrit": "ततः सुग्रीवसहितो गत्वा तीरं महोदधेः ।\nसमुद्रं क्षोभयामास शरैरादित्यसन्निभैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 5000001080, "chapter_id": 9001, "verse_number": "१-१-८०", "content_sanskrit": "दर्शयामास चात्मानं समुद्रः सरितां पतिः ।\nसमुद्रवचनाच्चैव नलं सेतुमकारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 5000001081, "chapter_id": 9001, "verse_number": "१-१-८१", "content_sanskrit": "तेन गत्वा पुरीं लङ्कां हत्वा रावणमाहवे ।\nरामः सीतामनुप्राप्य परां व्रीडामुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 5000001082, "chapter_id": 9001, "verse_number": "१-१-८२", "content_sanskrit": "तामुवाच ततो रामः परुषं जनसंसदि ।\nअमृष्यमाणा सा सीता विवेश ज्वलनं सती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 5000001083, "chapter_id": 9001, "verse_number": "१-१-८३", "content_sanskrit": "ततोऽग्निवचनात् सीतां ज्ञात्वा विगतकल्मषाम् ।\nकर्मणा तेन महता त्रैलोक्यं सचराचरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 5000001084, "chapter_id": 9001, "verse_number": "१-१-८४", "content_sanskrit": "सदेवर्षिगणं तुष्टं राघवस्य महात्मनः ॥\nबभौ रामः सम्प्रहृष्टः पूजितः सर्वदेवतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 5000001085, "chapter_id": 9001, "verse_number": "१-१-८५", "content_sanskrit": "अभ्यषिच्य च लङ्कायां राक्षसेन्द्रं विभीषणम् ।\nकृतकृत्यस्तदा रामो विज्वरः प्रमुमोद ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 5000001086, "chapter_id": 9001, "verse_number": "१-१-८६", "content_sanskrit": "देवताभ्यो वरं प्राप्य समुत्थाप्य च वानरान् ।\nअयोध्यां प्रस्थितो रामः पुष्पकेण सुहृद्वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 5000001087, "chapter_id": 9001, "verse_number": "१-१-८७", "content_sanskrit": "भरद्वाजाश्रमं गत्वा रामः सत्यपराक्रमः ।\nभरतस्यान्तिके रामो हनूमन्तं व्यसर्जयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 5000001088, "chapter_id": 9001, "verse_number": "१-१-८८", "content_sanskrit": "पुनराख्यायिकां जल्पन् सुग्रीवसहितस्तदा ।\nपुष्पकं तत् समारुह्य नन्दिग्रामं ययौ तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 5000001089, "chapter_id": 9001, "verse_number": "१-१-८९", "content_sanskrit": "नन्दिग्रामे जटां हित्वा भ्रातृभिः सहितोऽनघः ।\nरामः सीतामनुप्राप्य राज्यं पुनरवाप्तवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 5000001090, "chapter_id": 9001, "verse_number": "१-१-९०", "content_sanskrit": "प्रहृष्टमुदितो लोकस्तुष्टः पुष्टः सुधार्मिकः ।\nनिरामयो ह्यरोगश्च दुर्भिक्षभयवर्जितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 5000001091, "chapter_id": 9001, "verse_number": "१-१-९१", "content_sanskrit": "न पुत्रमरणं केचित् द्रक्ष्यन्ति पुरुषाः क्वचित् ।\nनार्यश्चाविधवा नित्यं भविष्यन्ति पतिव्रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 5000001092, "chapter_id": 9001, "verse_number": "१-१-९२", "content_sanskrit": "न चाग्निजं भयं किञ्चिन्नाप्सु मज्जन्ति जन्तवः ।\nन वातजं भयं किञ्चित् नापि ज्वरकृतं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 5000001093, "chapter_id": 9001, "verse_number": "१-१-९३", "content_sanskrit": "न चापि क्षुद्भयं तत्र न तस्करभयं तथा ।\nनगराणि च राष्ट्राणि धनधान्ययुतानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 5000001094, "chapter_id": 9001, "verse_number": "१-१-९४", "content_sanskrit": "नित्यं प्रमुदिताः सर्वे यथा कृतयुगे तथा ।\nअश्वमेधशतैरिष्ट्वा तथा बहुसुवर्णकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 5000001095, "chapter_id": 9001, "verse_number": "१-१-९५", "content_sanskrit": "गवां कोट्ययुतं दत्त्वा विद्वद्भ्यो विधिपूर्वकम् ।\nअसंख्येयं धनं दत्त्वा ब्राह्मणेभ्यो महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 5000001096, "chapter_id": 9001, "verse_number": "१-१-९६", "content_sanskrit": "राजवंशान् शतगुणान् स्थापयिष्यति राघवः ।\nचातुर्वर्ण्यं च लोकेऽस्मिन् स्वे स्वे धर्मे नियोक्ष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 5000001097, "chapter_id": 9001, "verse_number": "१-१-९७", "content_sanskrit": "दशवर्षसहस्राणि दशवर्षशतानि च ।\nरामो राज्यमुपासित्वा ब्रह्मलोकं प्रयास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 5000001098, "chapter_id": 9001, "verse_number": "१-१-९८", "content_sanskrit": "इदं पवित्रं पापघ्नं पुण्यं वेदैश्च सम्मितम् ।\nयः पठेद् रामचरितं सर्वपापैः प्रमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 5000001099, "chapter_id": 9001, "verse_number": "१-१-९९", "content_sanskrit": "एतदाख्यानमायुष्यं पठन् रामायणं नरः ।\nसपुत्रपौत्रः सगणः प्रेत्य स्वर्गे महीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 5000001100, "chapter_id": 9001, "verse_number": "१-१-१००", "content_sanskrit": "पठन् द्विजो वागृषभत्वमीयात् ।\nत् क्षत्रियो भूमिपतित्वमीयात् ॥\nवणिक् जनः पण्यफलत्वमीयात् ।\nजनश्च शूद्रोऽपि महत्त्वमीयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 5000001101, "chapter_id": 9001, "verse_number": null, "content_sanskrit": "इति श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे प्रथमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}]