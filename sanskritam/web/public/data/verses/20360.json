[{"id": 7000360000, "chapter_id": 20360, "verse_number": "२-३२-१", "content_sanskrit": "सूत उवाच ।\nनानारत्नैः सुदीप्तांगो हाटकेनापि सर्वतः ।\nराजमानो गिरिश्रेष्ठो यथा सूर्यः स्वरश्मिभिः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000360001, "chapter_id": 20360, "verse_number": "२-३२-२", "content_sanskrit": "छायामशोकां संप्राप्य शीतलां सुखदायिनीम् ।\nध्यायंति योगिनः सर्वे उपविष्टा दृढासने॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000360002, "chapter_id": 20360, "verse_number": "२-३२-३", "content_sanskrit": "क्वचित्तपंति मुनयः क्वचिद्गायंति किन्नराः ।\nसंतुष्टा ऋषिगंधर्वा वीणातालकराविलाः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000360003, "chapter_id": 20360, "verse_number": "२-३२-४", "content_sanskrit": "तालमानलये लीनाः स्वरैः सप्तभिरन्वितैः ।\nमूर्च्छनारत्निसंयुक्तैर्व्यक्तं गीतं मनोहरम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000360004, "chapter_id": 20360, "verse_number": "२-३२-५", "content_sanskrit": "तस्मिन्वै पर्वतश्रेष्ठे चंदनच्छायसंश्रिताः ।\nगंधर्वा गीततत्वज्ञा गीतं गायंति तत्पराः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000360005, "chapter_id": 20360, "verse_number": "२-३२-६", "content_sanskrit": "नृत्यंति योषितस्तत्र देवानां पर्वत्तोत्तमे ।\nपापहा पुण्यदो दिव्यः सुश्रेयसां प्रदायकः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000360006, "chapter_id": 20360, "verse_number": "२-३२-७", "content_sanskrit": "वेदध्वनिः समधुरः श्रूयते पर्वतोत्तमे ।\nचंदनाशोकपुन्नागैः शालैस्तालैस्तमालकैः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000360007, "chapter_id": 20360, "verse_number": "२-३२-८", "content_sanskrit": "वटैस्तु मेघसंकाशै राजते पर्वतोत्तमः ।\nसंतानकैः कल्पवृक्षै रंभापादपसंकुलैः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000360008, "chapter_id": 20360, "verse_number": "२-३२-९", "content_sanskrit": "नगेंद्रो भाति सर्वत्र नाकवृक्षैः सुपुष्पितैः ।\nनानाधातुसमाकीर्णो नानारत्नचयो गिरिः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000360009, "chapter_id": 20360, "verse_number": "२-३२-१०", "content_sanskrit": "नानाकौतुकसंयुक्तो नानामंगलसंयुतः ।\nवेदवृंदैः सुसंजुष्टो ह्यप्सरोगणसंकुलः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000360010, "chapter_id": 20360, "verse_number": "२-३२-११", "content_sanskrit": "ऋषिभिर्मुनिभिः सिद्धैर्गंधर्वैःपरिभातिसः ।\nगजैश्चाचलसंकाशैः सिंहनादैर्विराजते॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000360011, "chapter_id": 20360, "verse_number": "२-३२-१२", "content_sanskrit": "शरभैर्मत्तशार्दूलैर्मृगधूर्तैरलंकृतः ।\nवापीकूपतडागैश्च संपूर्णैर्विमलोदकैः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000360012, "chapter_id": 20360, "verse_number": "२-३२-१३", "content_sanskrit": "हंसकारंडवाकीर्णैः सर्वत्र परिशोभते ।\nकनकोत्पलैश्च श्वेतैश्च रक्तोत्पलैर्विराजते॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000360013, "chapter_id": 20360, "verse_number": "२-३२-१४", "content_sanskrit": "नदीस्रवणसंघातैर्विमलैश्चोदकैस्तथा ।\nशालतालैश्च रूपैश्च सगजैः स्फाटिकैस्तथा॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000360014, "chapter_id": 20360, "verse_number": "२-३२-१५", "content_sanskrit": "विस्तीर्णैः कांचनैर्दिव्यैः सूर्यवह्निसमप्रभैः ।\nशिलातलैश्च संपूर्णः शैलराजो विराजते॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000360015, "chapter_id": 20360, "verse_number": "२-३२-१६", "content_sanskrit": "विमानैर्देवतानां च प्रासादैः पर्वतोत्तमैः ।\nहंसचंद्रप्रतीकाशैर्हेमदंडैरलंकृतः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000360016, "chapter_id": 20360, "verse_number": "२-३२-१७", "content_sanskrit": "कलशैश्चामरैर्युक्तैः प्रासादैः परिशोभितः ।\nनानागुणप्रमुदित देववृंदैश्च शोभितः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000360017, "chapter_id": 20360, "verse_number": "२-३२-१८", "content_sanskrit": "देववृंदैरनेकैश्च गंधर्वैश्चारणैस्तथा ।\nसर्वत्र राजते पुण्यो मेरुर्गिरिवरोत्तमः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000360018, "chapter_id": 20360, "verse_number": "२-३२-१९", "content_sanskrit": "तस्माद्गंगामहापुण्या पुण्यतोया महानदी ।\nप्रसूता पुण्यतीर्थाढ्या हंसपद्मैः समाकुला॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000360019, "chapter_id": 20360, "verse_number": "२-३२-२०", "content_sanskrit": "मुनिभिः सेव्यमाना सा ऋषिसंघैर्महानदी ।\nएवंगुणं गिरिश्रेष्ठं पुण्यकौतुकमंगलम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000360020, "chapter_id": 20360, "verse_number": "२-३२-२१", "content_sanskrit": "अंगश्चात्रिसुतः पुण्यः प्रविवेश महामुनिः ।\nगंगातीरे सुपुण्ये च एकांते चारुकंदरे॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000360021, "chapter_id": 20360, "verse_number": "२-३२-२२", "content_sanskrit": "तत्रोपविश्य मेधावी कामक्रोधविवर्जितः ।\nसर्वेंद्रियाणि संयम्य हृषीकेशं मनोगतम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000360022, "chapter_id": 20360, "verse_number": "२-३२-२३", "content_sanskrit": "ध्यायमानः स धर्मात्मा कृष्णं क्लेशापहं प्रभुम् ।\nआसने शयने याने ध्याने च मधुसूदनम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000360023, "chapter_id": 20360, "verse_number": "२-३२-२४", "content_sanskrit": "नित्यं पश्यति युक्तात्मा योगयुक्तो जितेंद्रियः ।\nचराचरेषु जीवेषु तेषु पश्यति केशवम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000360024, "chapter_id": 20360, "verse_number": "२-३२-२५", "content_sanskrit": "आर्द्रेषु चैव शुष्केषु सर्वेष्वन्येषु स द्विजः ।\nएवं वर्षशतं जातं तप्यमानस्य तस्य च॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000360025, "chapter_id": 20360, "verse_number": "२-३२-२६", "content_sanskrit": "समालोक्य जगन्नाथश्चक्रपाणिर्द्विजोत्तमम् ।\nबहुविघ्नान्सुघोरांश्च दर्शयत्येव नित्यशः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000360026, "chapter_id": 20360, "verse_number": "२-३२-२७", "content_sanskrit": "तेजसा तस्य देवस्य नृसिंहस्य महात्मनः ।\nनिरातंकः स धर्मात्मा दहत्यग्निरिवेंधनम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000360027, "chapter_id": 20360, "verse_number": "२-३२-२८", "content_sanskrit": "नियमैः संयमैश्चान्यैरुपवासैर्द्विजोत्तमः ।\nक्षीयमाणस्तु संजातो दीप्यमानः स्वतेजसा॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000360028, "chapter_id": 20360, "verse_number": "२-३२-२९", "content_sanskrit": "सूर्यपावकसंकाशस्त्वंग एवं प्रदृश्यते ।\nएवं तपःसु निरतं ध्यायमानं जनार्दनम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000360029, "chapter_id": 20360, "verse_number": "२-३२-३०", "content_sanskrit": "आविर्भूयाब्रवीद्देवो वरं वरय मानद ।\nतं च दृष्ट्वा हृषीकेशमंगः परम निर्वृतः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000360030, "chapter_id": 20360, "verse_number": "२-३२-३१", "content_sanskrit": "तुष्टाव प्रणतो भूत्वा वासुदेवं प्रसन्नधीः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000360031, "chapter_id": 20360, "verse_number": "२-३२-३२", "content_sanskrit": "अंग उवाच ।\nत्वं गतिः सर्वभूतानां भूतभावन पावन ।\nभूतात्मा सर्वभूतेश नमस्तुभ्यं गुणात्मने॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000360032, "chapter_id": 20360, "verse_number": "२-३२-३३", "content_sanskrit": "गुणरूपाय गुह्याय गुणातीताय ते नमः ।\nगुणाय गुणकर्त्रे च गुणाढ्याय गुणात्मने॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000360033, "chapter_id": 20360, "verse_number": "२-३२-३४", "content_sanskrit": "भवाय भवकर्त्रे च भक्तानां भवहारिणे ।\nभवोद्भवाय गुह्याय नमो भवविनाशिने॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000360034, "chapter_id": 20360, "verse_number": "२-३२-३५", "content_sanskrit": "यज्ञाय यज्ञरूपाय यज्ञेशाय नमोनमः ।\nयज्ञकर्मप्रसंगाय नमः शंखधराय च॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000360035, "chapter_id": 20360, "verse_number": "२-३२-३६", "content_sanskrit": "नमोनमो हिरण्याय नमो रथांगधारिणे ।\nसत्याय सत्यभावाय सर्वसत्यमयाय च॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000360036, "chapter_id": 20360, "verse_number": "२-३२-३७", "content_sanskrit": "धर्माय धर्मकर्त्रे च सर्वकर्त्रे च ते नमः ।\nधर्मांगाय सुवीराय धर्माधाराय ते नमः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000360037, "chapter_id": 20360, "verse_number": "२-३२-३८", "content_sanskrit": "नमः पुण्याय पुत्राय ह्यपुत्राय महात्मने ।\nमायामोहविनाशाय सर्वमायाकराय ते॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000360038, "chapter_id": 20360, "verse_number": "२-३२-३९", "content_sanskrit": "मायाधराय मूर्ताय त्वमूर्ताय नमोनमः ।\nसर्वमूर्तिधरायैव शंकराय नमोनमः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000360039, "chapter_id": 20360, "verse_number": "२-३२-४०", "content_sanskrit": "ब्रह्मणे ब्रह्मरूपाय परब्रह्मस्वरूपिणे ।\nनमस्ते सर्वधाम्ने च नमो धामधराय च॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000360040, "chapter_id": 20360, "verse_number": "२-३२-४१", "content_sanskrit": "श्रीमते श्रीनिवासाय श्रीधराय नमोनमः ।\nक्षीरसागरवासाय चामृताय च ते नमः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000360041, "chapter_id": 20360, "verse_number": "२-३२-४२", "content_sanskrit": "महौषधाय घोराय महाप्रज्ञापराय च ।\nअक्रूराय प्रमेध्याय मेध्यानां पतये नमः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000360042, "chapter_id": 20360, "verse_number": "२-३२-४३", "content_sanskrit": "अनंताय ह्यशेषाय चानघाय नमोनमः ।\nआकाशस्य प्रकाशाय पक्षिरूपाय ते नमः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000360043, "chapter_id": 20360, "verse_number": "२-३२-४४", "content_sanskrit": "हुताय हुतभोक्त्रे च हवीरूपाय ते नमः ।\nबुद्धाय बुधरूपाय सदाबुद्धाय ते नमः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000360044, "chapter_id": 20360, "verse_number": "२-३२-४५", "content_sanskrit": "नमो हव्यायकव्याय स्वधाकाराय ते नमः ।\nस्वाहाकाराय शुद्धाय ह्यव्यक्ताय महात्मने॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000360045, "chapter_id": 20360, "verse_number": "२-३२-४६", "content_sanskrit": "व्यासाय वासवायैव वसुरूपाय ते नमः ।\nवासुदेवाय विश्वाय वह्निरूपाय ते नमः ।\nहरये केवलायैव वामनाय नमोनमः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000360046, "chapter_id": 20360, "verse_number": "२-३२-४७", "content_sanskrit": "नमो नृसिंहदेवाय सत्वपालाय ते नमः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000360047, "chapter_id": 20360, "verse_number": "२-३२-४८", "content_sanskrit": "नमो गोविंदगोपाय नम एकाक्षराय च ।\nनमः सर्वाक्षरायैव हंसरूपाय ते नमः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000360048, "chapter_id": 20360, "verse_number": "२-३२-४९", "content_sanskrit": "त्रितत्त्वाय नमस्तुभ्यं पंचतत्त्वाय ते नमः ।\nपंचविंशतितत्त्वाय तत्त्वाधाराय वै नमः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000360049, "chapter_id": 20360, "verse_number": "२-३२-५०", "content_sanskrit": "कृष्णाय कृष्णरूपाय लक्ष्मीनाथाय ते नमः ।\nनमः पद्मपलाशाय आनंदाय पराय च॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000360050, "chapter_id": 20360, "verse_number": "२-३२-५१", "content_sanskrit": "नमो विश्वंभरायैव पापनाशाय वै नमः ।\nनमः पुण्यसुपुण्याय सत्यधर्माय ते नमः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000360051, "chapter_id": 20360, "verse_number": "२-३२-५२", "content_sanskrit": "नमोनमः शाश्वतअव्ययाय नमोनमः संघ नभोमयाय ।\nश्रीपद्मनाभाय महेश्वराय नमामि ते केशवपादपद्मम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000360052, "chapter_id": 20360, "verse_number": "२-३२-५३", "content_sanskrit": "आनंदकंद कमलाप्रिय वासुदेव सर्वेश ईश मधुसूदन देहि दास्यम् ।\nपादौ नमामि तव केशव जन्मजन्म कृपां कुरुष्व मम शांतिद शंखपाणे॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000360053, "chapter_id": 20360, "verse_number": "२-३२-५४", "content_sanskrit": "संसारदारुणहुताशनतापदग्धं पुत्रादिबंधुमरणैर्बहुशोकतापैः ।\nज्ञानांबुदेन मम प्लावय पद्मनाभ दीनस्य मच्छरणरूपभवस्व नाथ॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000360054, "chapter_id": 20360, "verse_number": "२-३२-५५", "content_sanskrit": "एवं स्तोत्रं समाकर्ण्य त्वंगस्यापि महात्मनः ।\nदर्शयित्वा स्वकं रूपं घनश्यामं महौजसम्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000360055, "chapter_id": 20360, "verse_number": "२-३२-५६", "content_sanskrit": "शंखचक्रगदापाणिं पद्महस्तं महाप्रभुम् ।\nवैनतेयसमारूढमात्मरूपं प्रदर्शितम्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000360056, "chapter_id": 20360, "verse_number": "२-३२-५७", "content_sanskrit": "सर्वाभरणशोभांगं हारकंकणकुंडलैः ।\nराजमानं परं दिव्यं निर्मलं वनमालया॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000360057, "chapter_id": 20360, "verse_number": "२-३२-५८", "content_sanskrit": "अंगस्याग्रे हृषीकेशः शोभमान महत्प्रभः ।\nश्रीवत्सांकेन पुण्येन कौस्तुभेन जनार्दनः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000360058, "chapter_id": 20360, "verse_number": "२-३२-५९", "content_sanskrit": "दर्शयित्वा स्वकं देहं सर्वदेवमयो हरिः ।\nस उवाच महात्मानं तमंगमृषिसत्तमम्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000360059, "chapter_id": 20360, "verse_number": "२-३२-६०", "content_sanskrit": "भो भो विप्र महाभाग श्रूयतां वचनं शुभम् ।\nमेघगंभीरघोषेण समाभाष्य द्विजोत्तमम्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000360060, "chapter_id": 20360, "verse_number": "२-३२-६१", "content_sanskrit": "तपसानेन तुष्टोस्मि वरं वरय शोभनम् ।\nतुष्यमाणं हृषीकेशं तं दृष्ट्वा कमलापतिम्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000360061, "chapter_id": 20360, "verse_number": "२-३२-६२", "content_sanskrit": "दीप्यमानं विराजंतं विश्वरूपं जनेश्वरम् ।\nपादांबुजद्वयं तस्य प्रणम्य च पुनःपुनः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000360062, "chapter_id": 20360, "verse_number": "२-३२-६३", "content_sanskrit": "हर्षेण महताविष्टस्तमुवाच जनार्दनम् ।\nदासोहं तव देवेश शंखचक्रगदाधर॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000360063, "chapter_id": 20360, "verse_number": "२-३२-६४", "content_sanskrit": "वरं मे दातुकामोसि देहि त्वं वंशजं सुतम् ।\nदिवि शक्रो यथाऽभाति सर्वतेजः समन्वितः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000360064, "chapter_id": 20360, "verse_number": "२-३२-६५", "content_sanskrit": "तादृशं देहि मे पुत्रं सर्वलोकस्य रक्षकम् ।\nसर्वदेवप्रियं देव ब्रह्मण्यं धर्मपंडितम्॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000360065, "chapter_id": 20360, "verse_number": "२-३२-६६", "content_sanskrit": "दातारं ज्ञानसंपन्नं धर्मतेजः समन्वितम् ।\nत्रैलोक्यरक्षकं कृष्ण सत्यधर्मानुपालकम्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000360066, "chapter_id": 20360, "verse_number": "२-३२-६७", "content_sanskrit": "यज्वनामुत्तमं चैकं शूरं त्रैलोक्यभूषणम् ।\nब्रह्मण्यं वेदविद्वांसं सत्यसंधं जितेंद्रियम्॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000360067, "chapter_id": 20360, "verse_number": "२-३२-६८", "content_sanskrit": "अजितं सर्वजेतारं विष्णुं तेजःसमप्रभम् ।\nवैष्णवं पुण्यकर्तारं पुण्यजं पुण्यलक्षणम्॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000360068, "chapter_id": 20360, "verse_number": "२-३२-६९", "content_sanskrit": "शांतं तु तपसोपेतं सर्वशास्त्रविशारदम् ।\nवेदज्ञं योगिनां श्रेष्ठं भवतो गुणसंनिभम्॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000360069, "chapter_id": 20360, "verse_number": "२-३२-७०", "content_sanskrit": "ईदृशं देहि मे पुत्रं दातुकामो यदा वरम् ।\nश्रीवासुदेव उवाच ।\nएभिर्गुणैः समोपेतस्तव पुत्रो भविष्यति॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000360070, "chapter_id": 20360, "verse_number": "२-३२-७१", "content_sanskrit": "अत्रिवंशस्य वै धर्ता विश्वस्यास्य महामते ।\nतेजसा यशसा पुण्यैः पितरं चोद्धरिष्यति॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000360071, "chapter_id": 20360, "verse_number": "२-३२-७२", "content_sanskrit": "उद्धरिष्यति यः सत्यैः पितरं च पितामहम् ।\nभवान्यास्यति मे स्थानं तद्विष्णोः परमं पदम्॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000360072, "chapter_id": 20360, "verse_number": "२-३२-७३", "content_sanskrit": "इत्युक्त्वा देवदेवेशस्तमंगं प्रति स द्विज ।\nकस्यचित्पुण्यवीर्यस्य पुण्यां कन्यां विवाहय॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000360073, "chapter_id": 20360, "verse_number": "२-३२-७४", "content_sanskrit": "तस्यामुत्पादय सुतं शुभं पुण्यावह प्रियम् ।\nस भविष्यति धर्मात्मा मत्प्रसादान्महामते॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000360074, "chapter_id": 20360, "verse_number": "२-३२-७५", "content_sanskrit": "सर्वज्ञः सर्ववेत्ता च यादृशो वांछितस्त्वया ।\nएवं वरं ततो दत्वा अंतर्धानं गतो हरिः॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}]