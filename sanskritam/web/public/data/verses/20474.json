[{"id": 7000474000, "chapter_id": 20474, "verse_number": "३-२१-१", "content_sanskrit": "नारद उवाच ।\nततो गच्छेत राजेंद्र विहगेश्वरमुत्तमम् ।\nदर्शनात्तस्यराजेंद्र मुच्यते सर्वपातकैः ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000474001, "chapter_id": 20474, "verse_number": "३-२१-२", "content_sanskrit": "ततो गच्छेत राजेन्द्र नर्मदेश्वरमुत्तमम् ।\nतत्र स्नात्वा नरो राजन्स्वर्गलोके महीयते ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000474002, "chapter_id": 20474, "verse_number": "३-२१-३", "content_sanskrit": "अश्वतीर्थं ततो गच्छेत्स्नानं तत्र समाचरेत् ।\nसुभगो दर्शनीयश्च भोगवान्जायते नरः ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000474003, "chapter_id": 20474, "verse_number": "३-२१-४", "content_sanskrit": "पितामहं ततो गच्छेद्ब्रह्मणा निर्मितं पुरा ।\nतत्र स्नात्वा नरो भक्त्या पितृपिंडं तु दापयेत् ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000474004, "chapter_id": 20474, "verse_number": "३-२१-५", "content_sanskrit": "तिलदर्भविमिश्रं तु उदकं तु प्रदापयेत् ।\nतस्य तीर्थप्रभावेण सर्वं भवति चाक्षयम् ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000474005, "chapter_id": 20474, "verse_number": "३-२१-६", "content_sanskrit": "सावित्री तीर्थमासाद्य यस्तु स्नानं समाचरेत् ।\nविधूय सर्वपापानि ब्रह्मलोके महीयते ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000474006, "chapter_id": 20474, "verse_number": "३-२१-७", "content_sanskrit": "मनोहरं च तत्रैव तीर्थं परमशोभनम् ।\nतत्र स्नात्वा नरो राजन्पितृलोके महीयते ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000474007, "chapter_id": 20474, "verse_number": "३-२१-८", "content_sanskrit": "ततो गच्छेत राजेंद्र मानसं तीर्थमुत्तमम् ।\nतत्र स्नात्वा नरो राजन्रुद्रलोके महीयते ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000474008, "chapter_id": 20474, "verse_number": "३-२१-९", "content_sanskrit": "ततो गच्छेत राजेंद्र क्रतुतीर्थमनुत्तमम् ।\nविख्यातं सर्वलोकेषु सर्वपापप्रणाशनम् ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000474009, "chapter_id": 20474, "verse_number": "३-२१-१०", "content_sanskrit": "यान्यान्प्रार्थयते कामान्पशुपुत्रधनानि च ।\nप्राप्नुयात्तानि सर्वाणि तत्र स्नात्वा नराधिप ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000474010, "chapter_id": 20474, "verse_number": "३-२१-११", "content_sanskrit": "ततो गच्छेत राजेंद्र त्रिदशद्योति विश्रुतम् ।\nतत्र ता ऋषिकन्यास्तु तपस्तप्यंति सुव्रताः ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000474011, "chapter_id": 20474, "verse_number": "३-२१-१२", "content_sanskrit": "भर्त्ता भवतु सर्वासामीश्वरः प्रभुरव्ययः ।\nप्रीतस्तेषां महादेवश्चंडरूपधरो हरः ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000474012, "chapter_id": 20474, "verse_number": "३-२१-१३", "content_sanskrit": "विकृतानन बीभत्सस्तच्च तीर्थमुपागतः ।\nतत्र कन्या महाराज वराय परमेश्वरः ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000474013, "chapter_id": 20474, "verse_number": "३-२१-१४", "content_sanskrit": "कन्याऋद्धिं च यः सेवेत्कन्यादानं प्रयच्छति ।\nतीर्थं तत्र महाराज दशकन्येति विश्रुतम् ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000474014, "chapter_id": 20474, "verse_number": "३-२१-१५", "content_sanskrit": "तत्र स्नात्वार्च्चयेद्देवं सर्वपापैः प्रमुच्यते ।\nततो गच्छेत राजेंद्र स्वर्गबिंदुरिति श्रुतम् ॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000474015, "chapter_id": 20474, "verse_number": "३-२१-१६", "content_sanskrit": "तत्र स्नात्वा नरो राजन्दुर्गतिं च न पश्यति ।\nअप्सरेशं ततो गच्छेत्स्नानं तत्र समाचरेत् ॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000474016, "chapter_id": 20474, "verse_number": "३-२१-१७", "content_sanskrit": "क्रीडते नागलोकस्थोऽप्सरोभिः सह मोदते ।\nततो गच्छेत राजेंद्र नरकं तीर्थमुत्तमम् ॥१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000474017, "chapter_id": 20474, "verse_number": "३-२१-१८", "content_sanskrit": "तत्र स्नात्वार्च्चयेद्देवं नरकं च न गच्छति ।\nभारभूतं ततो गच्छेदुपवासपरायणः ॥१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000474018, "chapter_id": 20474, "verse_number": "३-२१-१९", "content_sanskrit": "एतत्तीर्थं समासाद्य अवतारं तु शांभवम् ।\nअर्चयित्वा विरूपाक्षं रुद्रलोके महीयते ॥१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000474019, "chapter_id": 20474, "verse_number": "३-२१-२०", "content_sanskrit": "तस्मिंस्तीर्थे नरः स्नात्वा भारभूते महात्मनः ।\nयत्रतत्र मृतस्यापि ध्रुवं गाणेश्वरी गतिः ॥२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000474020, "chapter_id": 20474, "verse_number": "३-२१-२१", "content_sanskrit": "कार्तिकस्य तु मासस्य अर्चयित्वा महेश्वरम् ।\nअश्वमेधाच्छतगुणं प्रवदंति मनीषिणः ॥२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000474021, "chapter_id": 20474, "verse_number": "३-२१-२२", "content_sanskrit": "दीपकानां शतं कृत्वा घृतपूर्णं तु दापयेत् ।\nविमानैः सूर्यसंकाशैर्व्रजते यत्र शंकरः ॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000474022, "chapter_id": 20474, "verse_number": "३-२१-२३", "content_sanskrit": "वृषभं यः प्रयच्छेत शंखकुंदेंदु संनिभम् ।\nवृषयुक्तेन यानेन रुद्रलोकं स गच्छति ॥२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000474023, "chapter_id": 20474, "verse_number": "३-२१-२४", "content_sanskrit": "चरुमेकं तु यो दद्यात्तस्मिंस्तीर्थे नराधिप ।\nपायसं मधुसंयुक्तं भक्ष्याणि विविधानि च ॥२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000474024, "chapter_id": 20474, "verse_number": "३-२१-२५", "content_sanskrit": "यथाशक्त्यनुराजेंद्र भोजयेत्सहदक्षिणम् ।\nतस्यतीर्थप्रभावेण सर्वं कोटिगुणं भवेत् ॥२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000474025, "chapter_id": 20474, "verse_number": "३-२१-२६", "content_sanskrit": "नर्मदाया जलं सिक्त्वा अर्चयित्वा वृषध्वजम् ।\nदुर्गतिं च न पंश्यंति तस्य तीर्थप्रभावतः ॥२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000474026, "chapter_id": 20474, "verse_number": "३-२१-२७", "content_sanskrit": "एतत्तीर्थं समासाद्य यस्तुप्राणान्परित्यजेत् ।\nसर्वपापविशुद्धात्मा व्रजते यत्र शंकरः ॥२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000474027, "chapter_id": 20474, "verse_number": "३-२१-२८", "content_sanskrit": "जलप्रवेशं यः कुर्यात्तस्मिंस्तीर्थे नराधिप ।\nहंसयुक्तेन यानेन रुद्रलोकं स गच्छति ॥२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000474028, "chapter_id": 20474, "verse_number": "३-२१-२९", "content_sanskrit": "यावच्चंद्रश्च सूर्यश्च हिमवांश्च महोदधिः ।\nगंगाद्याः सरितो यावत्तावत्स्वर्गे महीयते ॥२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000474029, "chapter_id": 20474, "verse_number": "३-२१-३०", "content_sanskrit": "अनाशनं तु यः कुर्यात्तस्मिंस्तीर्थे नराधिप ।\nगर्भवासे तु राजेंद्र न पुनर्जायते नरः ॥३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000474030, "chapter_id": 20474, "verse_number": "३-२१-३१", "content_sanskrit": "ततो गच्छेत राजेंद्र अटवीतीर्थमुत्तमम् ।\nतत्र स्नात्वा नरो राजन्निंद्रस्यार्द्धासनंलभेत् ॥३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000474031, "chapter_id": 20474, "verse_number": "३-२१-३२", "content_sanskrit": "शृंगतीर्थं ततो गच्छेत्सर्वपापप्रणाशनम् ।\nतत्रापि स्नातमात्रस्य ध्रुवं गाणेश्वरी गतिः ॥३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000474032, "chapter_id": 20474, "verse_number": "३-२१-३३", "content_sanskrit": "एरंडीनर्मदायाश्च संगमं लोकविश्रुतम् ।\nतत्र तीर्थं महापुण्यं सर्वपापप्रणाशनम् ॥३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000474033, "chapter_id": 20474, "verse_number": "३-२१-३४", "content_sanskrit": "उपवासपरो भूत्वा नित्यं ब्रह्मपरायणः ।\nतत्र स्नात्वा तु राजेंद्र मुच्यते ब्रह्महत्यया ॥३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000474034, "chapter_id": 20474, "verse_number": "३-२१-३५", "content_sanskrit": "ततो गच्छेत राजेन्द्र नर्मदोदधिसंगमम् ।\nजमदग्निरिति ख्यातं सिद्धो यत्र जनार्दनः ॥३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000474035, "chapter_id": 20474, "verse_number": "३-२१-३६", "content_sanskrit": "यत्रेष्ट्वा बहुभिर्यज्ञैरिंद्रो देवाधिपोभवत् ।\nतत्र स्नात्वा नरो राजन्नर्मदोदधिसंगमे ॥३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000474036, "chapter_id": 20474, "verse_number": "३-२१-३७", "content_sanskrit": "त्रिगुणस्याश्वमेधस्य फलं प्राप्नोति मानवः ।\nपश्चिमोदधिसायुज्यं मुक्तिद्वारविघाटनम् ॥३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000474037, "chapter_id": 20474, "verse_number": "३-२१-३८", "content_sanskrit": "तत्र देवाः सगंधर्वा ऋषयः सिद्धचारणाः ।\nआराधयंति देवेशं त्रिसंध्यं विमलेश्वरम् ॥३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000474038, "chapter_id": 20474, "verse_number": "३-२१-३९", "content_sanskrit": "सर्वपापविशुद्धात्मा रुद्रलोके महीयते ।\nविमलेश्वरपरं तीर्थं न भूतं न भविष्यति ॥३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000474039, "chapter_id": 20474, "verse_number": "३-२१-४०", "content_sanskrit": "तत्रोपवासं कृत्वा ये पश्यंति विमलेश्वरम् ।\nसर्वपापविशुद्धात्मा रुद्रलोकं व्रजंति ते ॥४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000474040, "chapter_id": 20474, "verse_number": "३-२१-४१", "content_sanskrit": "ततो गच्छेत राजेंद्र केशिनीतीर्थमुत्तमम् ।\nतत्र स्नात्वा नरो राजन्नुपवासपरायणः ॥४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000474041, "chapter_id": 20474, "verse_number": "३-२१-४२", "content_sanskrit": "उपोष्य रजनीमेकां नियतो नियताशनः ।\nतत्र तीर्थप्रभावेण मुच्यते ब्रह्महत्यया ॥४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000474042, "chapter_id": 20474, "verse_number": "३-२१-४३", "content_sanskrit": "सर्वतीर्थाभिषेकं च यः पश्येत्सागरेश्वरम् ।\nयोजनाभ्यंतरे तिष्ठेदावर्ते संस्थितः शिवः ॥४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000474043, "chapter_id": 20474, "verse_number": "३-२१-४४", "content_sanskrit": "तं दृष्ट्वा सर्वतीर्थानि दृष्टानि स्युर्न संशयः ।\nसर्वपापविनिर्मुक्तो यत्र रुद्र सः गच्छति ॥४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000474044, "chapter_id": 20474, "verse_number": "३-२१-४५", "content_sanskrit": "नर्मदासंगमं यावद्यावच्चामरकंटकम् ।\nतत्रांतरे महाराजन्तीर्थकोट्योदकस्थिताः ॥४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000474045, "chapter_id": 20474, "verse_number": "३-२१-४६", "content_sanskrit": "तीर्थात्तीर्थाटनं चर्या ऋषिकोटिनिषेविता ।\nअग्निहोत्रैश्च दिव्यांशैः सर्वैर्ज्ञानपरायणैः ॥४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000474046, "chapter_id": 20474, "verse_number": "३-२१-४७", "content_sanskrit": "सेवितास्तेन राजेंद्र ईप्सितार्थप्रदायिकाः ।\nयश्चेदं वै पठेन्नित्यं शृणुयाद्वापि भक्तितः ॥४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000474047, "chapter_id": 20474, "verse_number": "३-२१-४८", "content_sanskrit": "तं तु तीर्थानि सर्वाणि अभिषिंचंति पांडव ।\nनर्मदा च सदा प्रीता भवेद्वै नात्र संशयः ॥४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000474048, "chapter_id": 20474, "verse_number": "३-२१-४९", "content_sanskrit": "प्रीतस्तस्य भवेद्रुद्रो मार्कंडेयो महामुनिः ।\nवंध्या च लभते पुत्रान्दुर्भगा सुभगाभवेत् ॥४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000474049, "chapter_id": 20474, "verse_number": "३-२१-५०", "content_sanskrit": "कुमारीं लभते भर्त्ता यच्च यो वाञ्छते फलम् ।\nतदेव लभते सर्वं नात्र कार्या विचारणा ॥५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000474050, "chapter_id": 20474, "verse_number": "३-२१-५१", "content_sanskrit": "ब्राह्मणो वेदमाप्नोति क्षत्रियो विजयी भवेत् ।\nवैश्यस्तु लभते धान्यं शूद्रः प्राप्नोति सद्गतिम् ॥५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000474051, "chapter_id": 20474, "verse_number": "३-२१-५२", "content_sanskrit": "मूर्खस्तु लभते विद्यां त्रिसंध्यं यः पठेन्नरः ।\nनरकं च न पश्येत वियोनिं च न गच्छति ॥५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]