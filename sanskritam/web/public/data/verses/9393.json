[{"id": 40022395, "chapter_id": 9393, "verse_number": "1", "content_sanskrit": "तथा तु करुणं तस्य द्विजस्य परिदेवनम् । शुश्राव राघवः सर्वं दुःखशोकसमन्वितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40022396, "chapter_id": 9393, "verse_number": "2", "content_sanskrit": "स दुःखेन च सन्तप्तो मन्त्रिणस्तानुपाह्वयत् । वसिष्ठं वामदेवं च भ्रातरौ सह नैगमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40022397, "chapter_id": 9393, "verse_number": "3", "content_sanskrit": "ततो द्विजा वसिष्ठेन सार्धमष्टौ प्रवेशिताः । राजानं देवसङ्काशं वर्धस्वेति ततो ऽब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40022398, "chapter_id": 9393, "verse_number": "4", "content_sanskrit": "मार्कण्डेयो ऽथ मौद्गल्यो वामदेवश्च काश्यपः । कात्यायनो ऽथ जाबालिर्गौतमो नारदस्तथा । एते द्विजर्षभाः सर्वे आसनेषूपवेशिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40022399, "chapter_id": 9393, "verse_number": "5", "content_sanskrit": "महर्षीन्समनुप्राप्तानभिवाद्य कृताञ्जलिः । मन्त्रिणो नैगमांश्चैव यथार्हमनुकूलतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40022400, "chapter_id": 9393, "verse_number": "6", "content_sanskrit": "तेषां समुपविष्टानां सर्वेषां दीप्ततेजसाम् । राघवः सर्वमाचष्टे द्विजो ऽयमुपरोधते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40022401, "chapter_id": 9393, "verse_number": "7", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा राज्ञो दीनस्य नारदः । प्रत्युवाच शुभं वाक्यमृषीणां सन्निधौ नृपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40022402, "chapter_id": 9393, "verse_number": "8", "content_sanskrit": "शृणु राजन्यथाकाले प्राप्तो बालस्य सङ्क्षयः । श्रुत्वा कर्तव्यतां राजन्कुरुष्वरघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40022403, "chapter_id": 9393, "verse_number": "9", "content_sanskrit": "पुरा कृतयुगे राजन्ब्राह्मणा वै तपस्विनः । अब्राह्मणस्तदा राजन्न तपस्वी कथञ्चन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40022404, "chapter_id": 9393, "verse_number": "10", "content_sanskrit": "तस्मिन्युगे प्रज्वलिते ब्रह्मभूते त्वनावृते । अमृत्यवस्तदा सर्वे जज्ञिरे दीर्घदर्शिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40022405, "chapter_id": 9393, "verse_number": "11", "content_sanskrit": "ततस्त्रेतायुगं नाम मानवानां वपुष्मताम् । क्षत्रियास्तत्र जायन्ते पूर्णेन तपसा ऽन्विताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40022406, "chapter_id": 9393, "verse_number": "12", "content_sanskrit": "वीर्येण तपसा चैव ते ऽधिकाः पूर्वजन्मनि । मानवा ये महात्मानस्त्वत्र त्रेतायुगे युगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40022407, "chapter_id": 9393, "verse_number": "13", "content_sanskrit": "ब्रह्मक्षत्रं च तत्सर्वं यत्पूर्वमपरं च यत् । युगयोरुभयोरासीत्समवीर्यसमन्वितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40022408, "chapter_id": 9393, "verse_number": "14", "content_sanskrit": "अपश्यंस्तु न ते सर्वे विशेषमधिकं ततः । स्थापनं चक्रिरे तत्र चातुर्वर्ण्यस्य सम्मतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40022409, "chapter_id": 9393, "verse_number": "15", "content_sanskrit": "तस्मिन्युगे प्रज्वलिते धर्मभूते ह्यनावृते । अधर्मः पादमेकं तु पातयत्पृथिवीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40022410, "chapter_id": 9393, "verse_number": "16", "content_sanskrit": "अधर्मेण हि संयुक्तस्तेजो मन्दं भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40022411, "chapter_id": 9393, "verse_number": "17", "content_sanskrit": "आमिषं यच्च पूर्वेषां राजसं च मलं भृशम् । अनृतं नाम तद्भूतं पादेन पृथिवीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40022412, "chapter_id": 9393, "verse_number": "18", "content_sanskrit": "अनृतं पातयित्वा तु पादमेकमधर्मतः । ततः प्रादुष्कृतं पूर्वमायुषः परिनिष्ठितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40022413, "chapter_id": 9393, "verse_number": "19", "content_sanskrit": "पतिते त्वनृते तस्मिन्नधर्मे च महीतले । शुभान्येवाचरँल्लोकः सत्यधर्मपरायणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40022414, "chapter_id": 9393, "verse_number": "20", "content_sanskrit": "त्रेतायुगे च वर्तन्ते ब्राह्मणाः क्षत्रियाश्च ये । तपो ऽतप्यन्त ते सर्वे शुश्रूषामपरे जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40022415, "chapter_id": 9393, "verse_number": "21", "content_sanskrit": "स धर्मः परमस्तेषां वैश्यशूद्रं समागमत् । पूजां च सर्ववर्णानां शूद्राश्चक्रुर्विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40022416, "chapter_id": 9393, "verse_number": "22", "content_sanskrit": "एतस्मिन्नन्तरे तेषामधर्मे चानृते च ह । ततः पूर्वे भृशं ह्रासमगमन्नृपसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40022417, "chapter_id": 9393, "verse_number": "23", "content_sanskrit": "ततः पादमधर्मस्स द्वितीयमवतारयत् । ततो द्वापरसञ्ज्ञा ऽस्य युगस्य समजायत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40022418, "chapter_id": 9393, "verse_number": "24", "content_sanskrit": "तस्मिन्द्वापरसञ्ज्ञे तु वर्तमाने युगक्षये । अधर्मश्चानृतं चैव ववृधे पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40022419, "chapter_id": 9393, "verse_number": "25", "content_sanskrit": "तस्मिन्द्वापरसङ्ख्याते तपो वैश्यान्समाविशत् । त्रिभ्यो युगेभ्यस्त्रीन्वर्णान्क्रमाद्वै तप आविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40022420, "chapter_id": 9393, "verse_number": "26", "content_sanskrit": "त्रिभ्यो युगेभ्यस्त्रीन्वर्णान्धर्मश्च परिनिष्ठितः । न शुद्धो लभते धर्मं युगतस्तु नरर्षभ । हीनवर्णो नृपश्रेष्ठ तप्यते सुमहत्तपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40022421, "chapter_id": 9393, "verse_number": "27", "content_sanskrit": "भविष्यच्छूद्रयोन्यां वै तपश्चर्या कलौ युगे । अधर्मः परमो राजन्द्वापरे शूद्रजन्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40022422, "chapter_id": 9393, "verse_number": "28", "content_sanskrit": "स वै विषयपर्यन्ते तव राजन्महातपाः । अद्य तप्यति दुर्बुद्धिस्तेन बालवधो ह्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40022423, "chapter_id": 9393, "verse_number": "29", "content_sanskrit": "यो ह्यधर्ममकार्यं वा विषये पार्थिवस्य तु । करोति चाश्रीमूलं तत्पुरे वा दुर्मतिर्नरः । क्षिप्रं च नरकं याति स च राजा न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40022424, "chapter_id": 9393, "verse_number": "30", "content_sanskrit": "अधीतस्य च तप्तस्य कर्मणः सुकृतस्य च । षष्ठं भजति भागं तु प्रजा धर्मेण पालयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40022425, "chapter_id": 9393, "verse_number": "31", "content_sanskrit": "षङ्भागस्य न भोक्ता ऽसौ रक्षते न प्रजाः कथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40022426, "chapter_id": 9393, "verse_number": "32", "content_sanskrit": "स त्वं पुरुषशार्दूल मार्गस्व विषयं स्वकम् । दुष्कृतं यत्र पश्येथास्तत्र यत्नं समाचर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40022427, "chapter_id": 9393, "verse_number": "33", "content_sanskrit": "एवं चेद्धर्मवृद्धिश्च नृणां चायुर्विवर्धनम् । भविष्यति नरश्रेष्ठ बालस्यास्य च जीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]