[{"id": 7003658000, "chapter_id": 23658, "verse_number": "१-२-४५-१", "content_sanskrit": "नारद उवाच ।\nतथा बहूदकस्थाने कथामाकर्णयाद्भुताम् ।\nयस्माद्बहूदकं कामरूपे यदस्ति च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003658001, "chapter_id": 23658, "verse_number": "१-२-४५-२", "content_sanskrit": "तदस्ति चात्र संक्रांतं तस्मात्प्रोक्तं बहूदकम् ।\nकपिलेनात्र तप्त्वा च वर्षाणि सुबहून्यपि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003658002, "chapter_id": 23658, "verse_number": "१-२-४५-३", "content_sanskrit": "स्थापितं शोभनं लिंगं कपिलश्वरसंज्ञितम् ।\nतच्च लिगं सदा पार्थ नन्दभद्र इति समृतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003658003, "chapter_id": 23658, "verse_number": "१-२-४५-४", "content_sanskrit": "वाणिक्संपूजयामास त्रिकालं च कृतादरः ।\nसर्वधर्प्रविशेवज्ञः साक्षाद्धर्म इवापरः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003658004, "chapter_id": 23658, "verse_number": "१-२-४५-५", "content_sanskrit": "नाज्ञातं तस्य किंचिच्च यद्धर्मेषु प्रकीर्त्यते ।\nसर्वेषां च सुहृन्नित्यं सर्वेषां च हिते रतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003658005, "chapter_id": 23658, "verse_number": "१-२-४५-६", "content_sanskrit": "कर्मणा मनसा वाचा धर्ममेनमुपाश्रितः ।\nन भूतो न भविष्यश्च न स धर्मोऽस्ति किंचन ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003658006, "chapter_id": 23658, "verse_number": "१-२-४५-७", "content_sanskrit": "विदोषो यो हि सर्वत्र निश्चित्यैवं व्यवस्थितः ।\nअस्य धर्मसमुद्रस्य संप्रवृद्धस्य सर्वतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003658007, "chapter_id": 23658, "verse_number": "१-२-४५-८", "content_sanskrit": "निर्मथ्य नन्दभद्रेण आहृतं तन्निशामय ।\nवाणिज्यं मन्यते श्रेष्ठं जीवनाय तदा स्थितः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003658008, "chapter_id": 23658, "verse_number": "१-२-४५-९", "content_sanskrit": "परिच्छिन्नैः काष्ठतृणैः शरणं तेन कारितम् ।\nमद्यवर्जं भेदवर्जं कूटवर्जं समं तथा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003658009, "chapter_id": 23658, "verse_number": "१-२-४५-१०", "content_sanskrit": "सर्वभूतेषु वाणिज्यमल्पलाभेन सोऽचरत् ।\nअमायया परेभ्योऽसौ गृहीत्वैव क्रयाणकम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003658010, "chapter_id": 23658, "verse_number": "१-२-४५-११", "content_sanskrit": "अमाययैव भूतेभ्यो विक्रीणात्यस्य सद्व्रतम् ।\nकेचिद्यज्ञं प्रशंसंति नन्दभद्रो न मन्यते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003658011, "chapter_id": 23658, "verse_number": "१-२-४५-१२", "content_sanskrit": "दोषमेनं विनिश्चत्य श्रृमु तं पांडुनन्दन ।\nलुब्धोऽनृती दांभीकश्च स्वप्रशंसापरायणः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003658012, "chapter_id": 23658, "verse_number": "१-२-४५-१३", "content_sanskrit": "यजन्यज्ञैर्जगद्धं ति स्वं चांधतमसं नयेत् ।\nअग्नौ प्रास्ताहुतिः सम्यगादित्यमुपतिष्ठते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003658013, "chapter_id": 23658, "verse_number": "१-२-४५-१४", "content_sanskrit": "आदित्याज्जायते वृष्टिर्वष्टेरन्नं ततः प्रजाः ।\nयद्यदा यजमानस्य ऋत्विजो द्रव्यमेव च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003658014, "chapter_id": 23658, "verse_number": "१-२-४५-१५", "content_sanskrit": "चौरप्रायस्य कलुषाज्जन्म जायेज्जनस्य हि ।\nअदक्षिणे वृथा यज्ञे कृते चाप्यविधानतः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003658015, "chapter_id": 23658, "verse_number": "१-२-४५-१६", "content_sanskrit": "पशवो लकुटैर्हन्युर्यजमानं मृतं हताः ।\nतस्माच्छुद्धैर्यवद्रव्यैर्यजमानः शुभः स्मृतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003658016, "chapter_id": 23658, "verse_number": "१-२-४५-१७", "content_sanskrit": "यज्ञ एवं विचार्यासौ यज्ञसारं समास्थितः ।\nश्रद्धया देवपूजा या नमस्कारः स्तुतिः शुभा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003658017, "chapter_id": 23658, "verse_number": "१-२-४५-१८", "content_sanskrit": "नैवेद्यं हविषश्चैव यज्ञोऽयं हि विकल्मषः ।\nस एव यज्ञः प्रोक्तो वै येन तुष्यन्ति देवताः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003658018, "chapter_id": 23658, "verse_number": "१-२-४५-१९", "content_sanskrit": "केचिच्छंसन्ति संन्यासं नन्दभद्रो न मन्यते ।\nयो हि संन्यस्य विषयान्मनसा गृह्यते पुनः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003658019, "chapter_id": 23658, "verse_number": "१-२-४५-२०", "content_sanskrit": "उभयभ्रष्ट एवासौ भिन्ना भूमिर्विनश्यति ।\nसंन्यासस्य तु यत्सारं तत्तेनावृतमुत्तमम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003658020, "chapter_id": 23658, "verse_number": "१-२-४५-२१", "content_sanskrit": "कस्यचिन्नैव कर्माणि शपते वा प्रशंसति ।\nनानामार्गस्थितांल्लोकांश्चन्द्रवल्लीयते क्षितौ ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003658021, "chapter_id": 23658, "verse_number": "१-२-४५-२२", "content_sanskrit": "न द्वेष्टि नो कामयते न विरुद्धोऽनुरुध्यते ।\nसमाश्मकांचनो धीरस्तुल्यनिंदात्मसंस्तुतिः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003658022, "chapter_id": 23658, "verse_number": "१-२-४५-२३", "content_sanskrit": "अभयः सर्वभूतेभ्यो यथांधबधिराकृतिः ।\nन कर्मणां फलाकांक्षा शिवस्याराधनं हि तत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003658023, "chapter_id": 23658, "verse_number": "१-२-४५-२४", "content_sanskrit": "कारणाद्धर्ममन्विच्छन्न लोभं च ततश्चरन् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003658024, "chapter_id": 23658, "verse_number": "१-२-४५-२५", "content_sanskrit": "विविच्य नंदभद्रस्तत्सारं मोक्षेषु जगृहे ।\nकृषिं केचित्प्रशंसंति नंदभद्रो न मन्यते ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003658025, "chapter_id": 23658, "verse_number": "१-२-४५-२६", "content_sanskrit": "यस्यां छिंदंति वृषाणां चैव नासिकाम् ।\nकर्षयंति महाभारान्बध्नंति दमयंति च ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003658026, "chapter_id": 23658, "verse_number": "१-२-४५-२७", "content_sanskrit": "बहुदंशमयान्देशान्नयंति बहुकर्दमान् ।\nवाहसंपीडिता धुर्याः सीदंत्यविधिना परे ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003658027, "chapter_id": 23658, "verse_number": "१-२-४५-२८", "content_sanskrit": "मन्यंते भ्रूणहत्यापि विशिष्टा नास्य कर्मणः ।\nअघ्न्या इति गवां नाम श्रुतौ ताः पीडयेत्कथम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003658028, "chapter_id": 23658, "verse_number": "१-२-४५-२९", "content_sanskrit": "भूमिं भूमिशयांश्चैव हंति काष्ठमयोमुखम् ।\nपंचेंद्रियेषु जीवेषु सर्वं वसति दैवतम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003658029, "chapter_id": 23658, "verse_number": "१-२-४५-३०", "content_sanskrit": "आदित्यश्चंद्रमा वायुः प्रभूत्यैव च तांस्तु यः ।\nविक्रीणाति सुमूढस्य तस्य का नु विचारणा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003658030, "chapter_id": 23658, "verse_number": "१-२-४५-३१", "content_sanskrit": "अजोऽग्निर्वरुणो मेषः सूर्यश्च पृथिवी विराट् ।\nधेनुर्वत्सश्च सोमो वै विक्रीयैतान्न सिध्यति ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003658031, "chapter_id": 23658, "verse_number": "१-२-४५-३२", "content_sanskrit": "एवंविधसहस्रैश्च युता दोषैः कृषिः सदा ।\nअष्टगवं स्याद्धि हलं त्रिंशद्भागं त्यजेत्कृषेः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003658032, "chapter_id": 23658, "verse_number": "१-२-४५-३३", "content_sanskrit": "धर्मे दद्यात्पशून्वृद्धान्पुष्यादेषा कृषिः कुतः ।\nसारमेतत्कृषेस्तेन नंदभद्रेण चादृतम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003658033, "chapter_id": 23658, "verse_number": "१-२-४५-३४", "content_sanskrit": "विसाधितव्यान्यन्नानि स्वशक्त्या देवपितृषु ।\nमनुष्य द्विजभूतेषु नियुज्याश्नीत सर्वदा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003658034, "chapter_id": 23658, "verse_number": "१-२-४५-३५", "content_sanskrit": "केचिच्छंसंति चैश्वर्यं नंदभद्रो न मन्यते ।\nमानुषा मानुषानेव दासभावेन भुंजते ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003658035, "chapter_id": 23658, "verse_number": "१-२-४५-३६", "content_sanskrit": "वधबंधनिरोधेन पीडयंति दिवानिशम् ।\nदेहं किमेतद्धातुः स्वं मातुर्वा जनकस्य वा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003658036, "chapter_id": 23658, "verse_number": "१-२-४५-३७", "content_sanskrit": "मातुः पितुर्वा बलिनः क्रेतुरग्नेः शुनोऽपि वा ।\nइति संचिंत्य व्यहरन्नमरा इव ईश्वराः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003658037, "chapter_id": 23658, "verse_number": "१-२-४५-३८", "content_sanskrit": "ऐश्वर्यमदपापिष्ठा महामद्यमदादयः ।\nऐश्वर्यमदमत्तो हि ना पतित्वा हि माद्यति ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003658038, "chapter_id": 23658, "verse_number": "१-२-४५-३९", "content_sanskrit": "आत्मवत्सर्वभृत्येषु श्रिया नैव च माद्यति ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003658039, "chapter_id": 23658, "verse_number": "१-२-४५-४०", "content_sanskrit": "आत्मप्रत्ययवान्देही क्वेश्वरश्चेदृशोऽस्ति हि ।\nऐश्वर्यस्यापि सारं स जग्राहैतन्निशामय ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003658040, "chapter_id": 23658, "verse_number": "१-२-४५-४१", "content_sanskrit": "स्वशक्त्या सर्व भूतेषु यदसौ न पराङ्मुखः ।\nतीर्थायेके प्रशंसंति नंदभद्रो न मन्यते ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003658041, "chapter_id": 23658, "verse_number": "१-२-४५-४२", "content_sanskrit": "श्रमेण संकरात्तापशीतवातक्षुधा तृषा ।\nक्रोधेन धर्मगेहस्य नापि नाशमवाप्नुयात् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003658042, "chapter_id": 23658, "verse_number": "१-२-४५-४३", "content_sanskrit": "सौख्येन वा धनस्यापि श्रद्धया स्वल्पगोर्थवान् ।\nसमर्थो हि महत्पुण्यं शक्त आप्तुं क्व वास्ति सः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003658043, "chapter_id": 23658, "verse_number": "१-२-४५-४४", "content_sanskrit": "सदा शुचिर्देवयाजी तीर्थसारं गृहेगृह ।\nनापः पुनंति पापानि न शैला न महाश्रमाः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003658044, "chapter_id": 23658, "verse_number": "१-२-४५-४५", "content_sanskrit": "आत्मा पुनाति पापानि यदि पापान्निवर्तते ।\nएवमेव समाचारं प्रादुर्भूतं ततस्ततः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003658045, "chapter_id": 23658, "verse_number": "१-२-४५-४६", "content_sanskrit": "एकीकृत्य सदा धीमान्नंदभद्रः समास्थितः ।\nतस्यैवं वर्ततः साधोः स्पृहयंत्यपि देवताः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003658046, "chapter_id": 23658, "verse_number": "१-२-४५-४७", "content_sanskrit": "वासवप्रमुखाः सर्वे विस्मयं च परं ययुः ।\nअत्रैव स्थानके चापि शूद्रोऽभूत्प्रतिवेश्मकः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003658047, "chapter_id": 23658, "verse_number": "१-२-४५-४८", "content_sanskrit": "स नंदभद्रं धर्मिष्ठं पुनः पुनरसूयत ।\nनास्तिकः स दुराचारः सत्यव्रत इति श्रुतः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003658048, "chapter_id": 23658, "verse_number": "१-२-४५-४९", "content_sanskrit": "स सदा नंदभद्रस्य विलोकयति चांतरम् ।\nछिद्रं चेदस्य पश्यामि ततो धर्मान्निवर्तये ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003658049, "chapter_id": 23658, "verse_number": "१-२-४५-५०", "content_sanskrit": "स्वभाव एव क्रूराणां नास्तिकानां दुरात्मनाम् ।\nआत्मानं पातयंत्येव पातयंत्यपरं च यत् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003658050, "chapter_id": 23658, "verse_number": "१-२-४५-५१", "content_sanskrit": "ततस्त्वेवं वर्ततोऽस्य नंदभद्रस्य धीमतः ।\nएकोऽभूत्तयः कष्टाद्वार्धिके सोऽप्यनश्यत ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003658051, "chapter_id": 23658, "verse_number": "१-२-४५-५२", "content_sanskrit": "तच्च दैवकृतं मत्वा न शुशोच महामतिः ।\nदेवो वा मानवो वापि को हि दवाद्विमुच्यते ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003658052, "chapter_id": 23658, "verse_number": "१-२-४५-५३", "content_sanskrit": "ततोऽस्य सुप्रिया भार्या सर्वैः साध्वीगुणैर्युता ।\nगृहधर्मस्य मूर्तिर्या साक्षादिव अरुंधती ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003658053, "chapter_id": 23658, "verse_number": "१-२-४५-५४", "content_sanskrit": "विनाशमागता पार्थ कनकानाम नामतः ।\nततो यतेंद्रियोऽप्येष गृहधर्मविनाशतः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003658054, "chapter_id": 23658, "verse_number": "१-२-४५-५५", "content_sanskrit": "शुशोच हा कष्टमिति पापोहमिति चासकृत् ।\nतत्तस्य चांतरं दृष्ट्वाऽहृष्यत्यव्रतश्चिरात् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003658055, "chapter_id": 23658, "verse_number": "१-२-४५-५६", "content_sanskrit": "उपाव्रज्य च हा कष्टं ब्रुवंस्तं नंदभद्रकम् ।\nदधिकर्ण इवासाद्य नंदभद्रमुवाच सः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003658056, "chapter_id": 23658, "verse_number": "१-२-४५-५७", "content_sanskrit": "हा नंदभद्र यद्येवं तवाप्येवंविधं फलम् ।\nएतेन मन्ये मनसि धर्मोप्येष वृथैव यत् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003658057, "chapter_id": 23658, "verse_number": "१-२-४५-५८", "content_sanskrit": "इत्यादि बहुधा प्रोच्य तत्तद्वाक्यं ततस्ततः ।\nसत्यव्रतस्ततः प्राह नंदभद्रं कृपान्वितः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003658058, "chapter_id": 23658, "verse_number": "१-२-४५-५९", "content_sanskrit": "नंदभद्र सदा तुभ्यं वक्तुकामोस्मि किंचन ।\nप्रस्तावस्याप्यभावाच्च नोदितं च मया क्वचित् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003658059, "chapter_id": 23658, "verse_number": "१-२-४५-६०", "content_sanskrit": "अप्रस्तावं ब्रुवन्वाक्यं बृहस्पतिरपिध्रुवम् ।\nलभते बुद्ध्यवज्ञानमवमानं च हीनवत् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003658060, "chapter_id": 23658, "verse_number": "१-२-४५-६१", "content_sanskrit": "नन्दभद्र उवाच ।\nब्रूहिब्रूहि न मे किंचित्साधु गोप्यं प्रियं परम् ।\nवचोभिः शुद्धसत्त्वानां न मोक्षोऽप्युपमीयते ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003658061, "chapter_id": 23658, "verse_number": "१-२-४५-६२", "content_sanskrit": "सत्यव्रत उवाच ।\nनवभिर्नवभिश्चैव विमुक्तं वाग्विदूषणैः ।\nनवभिर्बुद्धिदोषैश्च वाक्यं वक्ष्याम्यदोषवत् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003658062, "chapter_id": 23658, "verse_number": "१-२-४५-६३", "content_sanskrit": "सौक्ष्म्यं संख्याक्रमश्चापि निर्णयः सप्रयोजनः ।\nपंचैतान्यर्थजातानि यत्र तद्वाक्यमुच्यते ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003658063, "chapter_id": 23658, "verse_number": "१-२-४५-६४", "content_sanskrit": "धर्ममर्थं च कामं च मोक्षं चोद्दिश्य चोच्यते ।\nप्रयोजनमिति प्रोक्तं प्रथमं वाक्यलक्षणम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003658064, "chapter_id": 23658, "verse_number": "१-२-४५-६५", "content_sanskrit": "धर्मार्थकाममोक्षेषु प्रतिज्ञाय विशेषतः ।\nइदं तदिति वाक्यांते प्रोच्यते स विनिर्णयः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003658065, "chapter_id": 23658, "verse_number": "१-२-४५-६६", "content_sanskrit": "इदं पूर्वमिदं पश्चाद्वक्तव्यं यत्क्रमेण हि ।\nक्रमयोगं तमप्याहुर्वाक्यतत्तविदो बुधाः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003658066, "chapter_id": 23658, "verse_number": "१-२-४५-६७", "content_sanskrit": "दोषाणां च गुणानां च प्रमाणं प्रविभागतः ।\nउभयार्थमपि प्रेक्ष्य सा संख्येत्युपधार्यताम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003658067, "chapter_id": 23658, "verse_number": "१-२-४५-६८", "content_sanskrit": "वाक्यज्ञेयेषु भिन्नेषु यत्राभेदः प्रदृश्यते ।\nतत्रातिशयहेतुत्वं तत्सौक्ष्म्यमिति निर्दिशेत् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003658068, "chapter_id": 23658, "verse_number": "१-२-४५-६९", "content_sanskrit": "इति वाक्यगुणानां च वाग्दोषान्द्विनव श्रृणु ।\nअपेतार्थमभिन्नार्थमपवृत्तं तथाधिकम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003658069, "chapter_id": 23658, "verse_number": "१-२-४५-७०", "content_sanskrit": "अश्लक्ष्णं चापि संदिग्धं पदांते गुरु चाक्षरम् ।\nपराङ्मुखमुखं यच्च अनृतं चाप्यसंस्कृतम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003658070, "chapter_id": 23658, "verse_number": "१-२-४५-७१", "content_sanskrit": "विरुद्धं यत्त्रिवर्गेण न्यूनं कष्टातिशब्दकम् ।\nव्युत्क्रमाभिहृतं यच् सशेषं चाप्यहेतुकम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003658071, "chapter_id": 23658, "verse_number": "१-२-४५-७२", "content_sanskrit": "निष्कारणं च वाग्दोषान्बुद्धिजाञ्छृणु त्वं च यान् ।\nकामात्क्रोधाद्भयाच्चैव लोभाद्दैन्यादनार्यकात् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003658072, "chapter_id": 23658, "verse_number": "१-२-४५-७३", "content_sanskrit": "हीनानुक्रोशतो मानान्न च वक्ष्यामि किंचन ।\nवक्ता श्रोता च वाक्यं च यदा त्वविकलं भवेत् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003658073, "chapter_id": 23658, "verse_number": "१-२-४५-७४", "content_sanskrit": "सममेति विवक्षायां तदा सोऽर्थः प्रकाशते ।\nवक्तव्ये तु यदा वक्ता श्रोतारमवमन्यते ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003658074, "chapter_id": 23658, "verse_number": "१-२-४५-७५", "content_sanskrit": "श्रोता चाप्यथ वक्तारं तदा वाक्यं न रोहति ।\nअथ यः स्वप्रियं ब्रूयाच्छ्रोतुर्वोत्सृज्ययदृतम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003658075, "chapter_id": 23658, "verse_number": "१-२-४५-७६", "content_sanskrit": "विशंका जायते तस्मिन्वाक्यं तदपि दोषवत् ।\nतस्माद्यः स्वप्रियं त्यक्त्वा श्रोतुश्चाप्यथ यत्प्रियम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003658076, "chapter_id": 23658, "verse_number": "१-२-४५-७७", "content_sanskrit": "सत्यमेव प्रभाषेत स वक्ता नेतरो भुवि ।\nमिथ्यावादाञ्छास्त्रजालसंभवान्यद्विहाय च ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003658077, "chapter_id": 23658, "verse_number": "१-२-४५-७८", "content_sanskrit": "सत्यमेव व्रतं यस्मात्तस्मात्सत्यव्रतस्त्वहम् ।\nसत्यं ते संप्रवक्ष्यामि मंतुमर्हसि तत्तथा ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003658078, "chapter_id": 23658, "verse_number": "१-२-४५-७९", "content_sanskrit": "यदाप्रभृति भद्र त्वं पाषाणस्यार्चने रतः ।\nतदाप्रभृति किंचिच्च न हि पश्यामि शोभनम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003658079, "chapter_id": 23658, "verse_number": "१-२-४५-८०", "content_sanskrit": "एकः सोऽपि सुतो नष्टो भार्या चार्याऽप्यनश्यत ।\nकूटानां कर्मणां साधो फलमेवंविधं भवेत् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003658080, "chapter_id": 23658, "verse_number": "१-२-४५-८१", "content_sanskrit": "क्व देवाः संति मिथ्यैतद्दृश्यंते चेद्भवंत्यपि ।\nसर्वा च कूटविप्राणां द्रव्यायैषा विकल्पना ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003658081, "chapter_id": 23658, "verse_number": "१-२-४५-८२", "content_sanskrit": "पितॄनुद्दिश्य यच्छंति मम हासः प्रजायते ।\nअन्नस्योपद्रवं यच्च मृतो हि किमशिष्यत ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003658082, "chapter_id": 23658, "verse_number": "१-२-४५-८३", "content_sanskrit": "यत्त्विदं बहुधा मूढा वर्णयंति द्विजाधमाः ।\nविश्वनिर्माणमखिलं तथापि श्रृणु सत्यतः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003658083, "chapter_id": 23658, "verse_number": "१-२-४५-८४", "content_sanskrit": "उत्पत्तिश्चापि भंगश्च विश्वस्यैतद्द्वयं मृषा ।\nएवमेव हि सर्वं च सदिदं वर्तते जगत् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003658084, "chapter_id": 23658, "verse_number": "१-२-४५-८५", "content_sanskrit": "स्वभावतो विश्वमिदं हि वर्तते स्वभावतः सूर्यमुखा भ्रमंत्यमी ।\nस्वभावतो वायवो वांति नित्यं स्वभावतो वर्षति चांबुदोऽयम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003658085, "chapter_id": 23658, "verse_number": "१-२-४५-८६", "content_sanskrit": "स्वभावतो रोहति धान्यजातं स्वभावतो वर्षशीतातपत्वम् ।\nस्वभावतः संस्थिता मेदिनी च स्वभावतः सरितः संस्रवंति ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003658086, "chapter_id": 23658, "verse_number": "१-२-४५-८७", "content_sanskrit": "स्वभावतः पर्वता भांति नित्यं स्वभावतो वारिधिरेष संस्थितः ।\nस्वभावतो गर्भिणी संप्रसूते स्वभावतोऽमी बहवश्च जीवाः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003658087, "chapter_id": 23658, "verse_number": "१-२-४५-८८", "content_sanskrit": "यथा स्वभावेन भवंति वक्रा ऋतुस्वबावाद्बदरीषु कण्टकाः ।\nतथा स्वभावेन हि सर्वमेतत्प्रकाशते कोऽपि कर्ता न दृश्यः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003658088, "chapter_id": 23658, "verse_number": "१-२-४५-८९", "content_sanskrit": "तदेवं संस्थिते लोके मूढो मुह्यति मत्तवत् ।\nमानुष्यमपि यद्धूर्ता वदंत्यग्र्यं श्रृणुष्वतत् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003658089, "chapter_id": 23658, "verse_number": "१-२-४५-९०", "content_sanskrit": "मानुष्यान्न परं कष्टं वैरिणां नो भवेद्धि तत् ।\nशोकस्थानसहस्राणि मनुष्यस्य क्षणेक्षणे ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003658090, "chapter_id": 23658, "verse_number": "१-२-४५-९१", "content_sanskrit": "मानुष्यं हि स्मृताकारं सभाग्योऽस्माद्विमुच्यते ।\nपशवः पक्षिणः कीटाः कृमयश्च यथासुखम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003658091, "chapter_id": 23658, "verse_number": "१-२-४५-९२", "content_sanskrit": "अबद्धा विहरंत्येते योनिरेषां सुदुर्लभा ।\nनिश्चिंताः स्थावरा ह्येते सौख्यमेषां महद्भुवि ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003658092, "chapter_id": 23658, "verse_number": "१-२-४५-९३", "content_sanskrit": "बहुना किं मनुष्येभ्यः सर्वो धन्योऽन्ययोनिजः ।\nस्वभावमेव जानीहि पुण्यापुण्यादिकल्पना ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003658093, "chapter_id": 23658, "verse_number": "१-२-४५-९४", "content_sanskrit": "यदेके स्थावराः कीटाः पतंगा मानुषादिकाः ।\nतस्मान्मित्या परित्यज्य नंदभद्र यथासुखम् ।\nपिब क्रीडनकैः सार्धं भोगान्सत्यमिदं भुवि ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003658094, "chapter_id": 23658, "verse_number": "१-२-४५-९५", "content_sanskrit": "नारद उवाच ।\nइत्येतैरमुखैर्वाक्यैरयुक्तैरसमंजसैः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003658095, "chapter_id": 23658, "verse_number": "१-२-४५-९६", "content_sanskrit": "सत्यव्रतस्य नाकम्पन्नंदभद्रो महामनाः ।\nप्रहसन्निव तं प्राह स्वक्षोभ्यः सागरो यथा ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003658096, "chapter_id": 23658, "verse_number": "१-२-४५-९७", "content_sanskrit": "यद्भवानाह धर्मिष्ठाः सदा दुःखस्य भागिनः ।\nतन्मिथ्या दुःखजालानि पश्यामः पापिनामपि ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003658097, "chapter_id": 23658, "verse_number": "१-२-४५-९८", "content_sanskrit": "वधबंधपरिक्लेशाः पुत्रदारादि पंचता ।\nपापिनामपि दृश्यंते तस्माद्धर्मो गुरुर्मतः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003658098, "chapter_id": 23658, "verse_number": "१-२-४५-९९", "content_sanskrit": "अयं साधुरहो कष्टं कष्टमस्य महाजनाः ।\nसाधोर्वदंत्येतदपि पापिनां दुर्लभं त्विदम् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003658099, "chapter_id": 23658, "verse_number": "१-२-४५-१००", "content_sanskrit": "दारादिद्रव्यलोभार्यं विशतः पापिनो गृहे ।\nभवानपि बिभेत्यस्माद्द्वेष्टि कुप्यति तद्वृथा ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003658100, "chapter_id": 23658, "verse_number": "१-२-४५-१०१", "content_sanskrit": "यथास्य जगतो ब्रूषे नास्ति हेतुर्महेश्वरः ।\nतद्बालभाषितं तुभ्यं किं राजानं विना प्रजाः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003658101, "chapter_id": 23658, "verse_number": "१-२-४५-१०२", "content_sanskrit": "यच्च ब्रवीषि पाषाणं मिथ्या लिंगं समर्चसि ।\nतद्भवांल्लिंगमाहात्म्यं वेत्ति नांधो यथा रविम् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003658102, "chapter_id": 23658, "verse_number": "१-२-४५-१०३", "content_sanskrit": "ब्रह्मादायः सुरा सर्वे राजानश्च महर्द्धिकाः ।\nमानवा मुनयश्चैव सर्वे लिंगं यजंति च ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003658103, "chapter_id": 23658, "verse_number": "१-२-४५-१०४", "content_sanskrit": "स्वनामकानि चिह्नानि तेषां लिंगानि संति च ।\nएते किं त्वभवत्मूर्खास्त्वं तु सत्यव्रतः सुधीः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003658104, "chapter_id": 23658, "verse_number": "१-२-४५-१०५", "content_sanskrit": "प्रतिष्ठाप्य पुरा ब्रह्मा पुष्करे नीललोहितम् ।\nप्राप्तवान्परमां सिद्धिं ससर्जेमाः प्रजाः प्रभुः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003658105, "chapter_id": 23658, "verse_number": "१-२-४५-१०६", "content_sanskrit": "विष्णुनापि निहत्याजौ रावणं पयसांनिधेः ।\nतीरे रामेश्वरं लिंगं स्थापितं चास्ति किं मुधा ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003658106, "chapter_id": 23658, "verse_number": "१-२-४५-१०७", "content_sanskrit": "वृत्रं हत्वा पुरा शक्रो महेंद्रे स्थाप्य शंकरम् ।\nलिंगं विमुक्तपापोऽथ त्रिदिवेद्यापि मोदते ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003658107, "chapter_id": 23658, "verse_number": "१-२-४५-१०८", "content_sanskrit": "स्थापयित्वा शिवं सूर्यो गंगासागरसंगमे ।\nनिरामयोऽभूत्सोमश्च प्रभासे पश्चिमोदधौ ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003658108, "chapter_id": 23658, "verse_number": "१-२-४५-१०९", "content_sanskrit": "काश्यां यमश्च धनदः सह्ये गरुडकश्यपौ ।\nनैमिषे वायुवरुणौ स्थाप्य लिंगं प्रमोदिताः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003658109, "chapter_id": 23658, "verse_number": "१-२-४५-११०", "content_sanskrit": "अस्मिन्नेव स्तंभतीर्थे कुमारेणं गुहो विभुः ।\nलिंगं संस्थापयामास सर्वपापहरं न किम् ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003658110, "chapter_id": 23658, "verse_number": "१-२-४५-१११", "content_sanskrit": "एवमन्यैः सुरैर्यानि पार्थिवैर्मुनिभिस्तथा ।\nसंस्तापितानि लिंगानि तन्न संख्यातुमुत्सहे ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003658111, "chapter_id": 23658, "verse_number": "१-२-४५-११२", "content_sanskrit": "पृथिवीवासिनः सर्वे ये च स्वर्गनिवासिनः ।\nपातालवासिनस्तृप्ता जायंते लिंगपूजया ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003658112, "chapter_id": 23658, "verse_number": "१-२-४५-११३", "content_sanskrit": "यच्च ब्रवीषि गीर्वाणा न संति सन्ति चेत्कुतः ।\nकुत्रापि नैव दृश्यंते तेन मे विस्मयो महान् ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003658113, "chapter_id": 23658, "verse_number": "१-२-४५-११४", "content_sanskrit": "रंकवत्किं स्म ते देवा याचंतां त्वां कुलत्थवत् ।\nयमिच्छिसि महाप्राज्ञ साधको हि गुरुस्तव ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003658114, "chapter_id": 23658, "verse_number": "१-२-४५-११५", "content_sanskrit": "स्वबावान्नैव सर्वार्थाः संसिद्धा यदि ते मते ।\nभोजनादि कथं सिध्येद्वद कर्तारमंतरा ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003658115, "chapter_id": 23658, "verse_number": "१-२-४५-११६", "content_sanskrit": "बदरीमंतरेणापि दृश्यंते कण्टका न हि ।\nतस्मात्कस्यास्ति निर्माणं यस्य यावत्तथैव तत् ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7003658116, "chapter_id": 23658, "verse_number": "१-२-४५-११७", "content_sanskrit": "यच्च ब्रवीषि पश्वाद्याः सुखिनो धन्यकास्त्वमी ।\nत्वदृते नेदमुक्तं च केनापि श्रुतमेव वा ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7003658117, "chapter_id": 23658, "verse_number": "१-२-४५-११८", "content_sanskrit": "तामसा विकला ये च कष्टं तेषां च श्लाघ्यताम् ।\nसर्वेंद्रिययुताः श्रेष्ठाः कुतो धन्या न मानुषाः ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7003658118, "chapter_id": 23658, "verse_number": "१-२-४५-११९", "content_sanskrit": "सत्यं तव व्रतं मन्ये नरकाय त्वयाऽदृतम् ।\nअत्यनर्थे न भीः कार्या कामोयं भविताचिरात् ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7003658119, "chapter_id": 23658, "verse_number": "१-२-४५-१२०", "content_sanskrit": "आदावाडंबरेणैव ध्रुवतोऽज्ञानमेव मे ।\nइत्थं निःसारता व्यक्तमादावाडंबारात्तु यत् ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7003658120, "chapter_id": 23658, "verse_number": "१-२-४५-१२१", "content_sanskrit": "मायाविनां हि ब्रुवतां वाक्यं चांडबरावृतम् ।\nकुनाणकमिवोद्दीप्तं परीक्षेयं सदा सताम् ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7003658121, "chapter_id": 23658, "verse_number": "१-२-४५-१२२", "content_sanskrit": "आदौ मध्ये तथा चांते येषां वाक्यमदोषवत् ।\nकषदाहैः स्वर्णमिव च्छेदेऽपि स्याच्छुभं शुभम् ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7003658122, "chapter_id": 23658, "verse_number": "१-२-४५-१२३", "content_sanskrit": "त्वयान्यथा प्रतिज्ञातमुक्तं चैवान्यथा पुनः ।\nत्वद्दोषो नायमस्माकं तद्वचः श्रृणुमो हि ये ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7003658123, "chapter_id": 23658, "verse_number": "१-२-४५-१२४", "content_sanskrit": "नास्तिकानां च सर्पाणां विषस्य च गुणस्त्वयम् ।\nमोहयंति परं यच्च दोषो नैषपरस्य तु ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7003658124, "chapter_id": 23658, "verse_number": "१-२-४५-१२५", "content_sanskrit": "आपो वस्त्रं तिलास्तैलं गंधो वा स यथा तथा ।\nपुष्पाणामधिवासेन तथा संसर्गजा गुणाः ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7003658125, "chapter_id": 23658, "verse_number": "१-२-४५-१२६", "content_sanskrit": "मोहजालस्य यो योनिर्मूढैरिह समागमः ।\nअहन्यहनि धर्मस्य योनिः साधुसमागमः ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7003658126, "chapter_id": 23658, "verse_number": "१-२-४५-१२७", "content_sanskrit": "तस्मात्प्राज्ञैश्च वृद्धैश्च शुद्धभावैस्तपस्विभिः ।\nसद्भिश्च सह संसर्गः कार्यः शमपरायणैः ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7003658127, "chapter_id": 23658, "verse_number": "१-२-४५-१२८", "content_sanskrit": "न नीचैर्नाप्यविद्वद्भिर्नानात्मज्ञैर्विशेषतः ।\nयेषां त्रीण्यवदातानि योनिर्विद्या च कर्म च ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7003658128, "chapter_id": 23658, "verse_number": "१-२-४५-१२९", "content_sanskrit": "तांश्च सेवेद्विशेषेण शास्त्रं येषां हि विद्यते ।\nअसतां दर्शनस्पर्शसंजल्पासनभोजनैः ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7003658129, "chapter_id": 23658, "verse_number": "१-२-४५-१३०", "content_sanskrit": "धर्माचारात्प्रहीयंते न च सिध्यंति मानवाः ।\nबुद्धिश्च हीयते पुंसां नीचैः सह समागमात् ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7003658130, "chapter_id": 23658, "verse_number": "१-२-४५-१३१", "content_sanskrit": "मध्यैश्च मध्यतां याति श्रेष्ठतां याति चोत्तमैः ।\nइति धर्मं स्मरन्नाहं संगमार्थी पुनस्तव ।\nयन्निन्दसि द्विजानेव यैरपेयोऽर्णवः कृतः ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7003658131, "chapter_id": 23658, "verse_number": "१-२-४५-१३२", "content_sanskrit": "वेदाः प्रमाणं स्मृतयः प्रमाणं धर्मार्थयुक्तं वचनं प्रमाणम् ।\nनैतत्त्रयं यस्य भवेत्प्रमाणं कस्तस्य कुर्याद्वचनं प्रमाणम् ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7003658132, "chapter_id": 23658, "verse_number": "१-२-४५-१३३", "content_sanskrit": "इतिरयित्वा वचनं महात्मा स नंदभद्रः सहसा तदैव ।\nगृहाद्विनिःसृत्य जगाम पुण्यं बहूदकं भट्टरवेस्तु कुंडम् ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}]