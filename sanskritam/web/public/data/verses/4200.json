[{"id": 2147929, "chapter_id": 4200, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2147930, "chapter_id": 4200, "verse_number": "१", "content_sanskrit": "प्रविश्याथ गृहं कुन्त्याः चरणावभिवाद्य च ।\nआचख्यौ तत् समासेन यद् वृत्तं कुरुसंसदि\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2147931, "chapter_id": 4200, "verse_number": "", "content_sanskrit": "श्रीवासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2147932, "chapter_id": 4200, "verse_number": "२", "content_sanskrit": "उक्तं बहुविधं वाक्यं स्पृहणीयं सहेतुकम् ।\nऋषिभिश्चैव च मया न चासौ तद् गृहीतवान्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2147933, "chapter_id": 4200, "verse_number": "३", "content_sanskrit": "कालपक्वमिदं सर्वं सुयोधनवशानुगम् ।\nसर्वक्षत्रं क्षणेनैव दह्यते पार्थवह्निना\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2147934, "chapter_id": 4200, "verse_number": "४", "content_sanskrit": "आपृच्छे भवतीं शीघ्रं प्रयास्ये पाण्डवान् प्रति\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2147935, "chapter_id": 4200, "verse_number": "५", "content_sanskrit": "किं वाच्याः पाण्डवेयास्ते भवत्या वचनान्मया ।\nतद् ब्रूहि त्वं महाप्राज्ञे शुश्रूषे वचनं तव\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2147936, "chapter_id": 4200, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2147937, "chapter_id": 4200, "verse_number": "६", "content_sanskrit": "ब्रूयाः केशव राजानं धर्मात्मानं युधिष्ठिरम् ।\nभूयांस्ते हीयते धर्मो मा पुत्रक वृथा कृथाः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2147938, "chapter_id": 4200, "verse_number": "७", "content_sanskrit": "श्रोत्रियस्येव ते राजन् मन्दकस्याविपश्चितः ।\nअनुवाकहता बुद्धिः धर्ममेवैकमीक्षते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2147939, "chapter_id": 4200, "verse_number": "८", "content_sanskrit": "अङ्गावेक्षस्व धर्मं त्वं यथा सृष्टः स्वयम्भुवा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2147940, "chapter_id": 4200, "verse_number": "९", "content_sanskrit": "बाहुभ्यां क्षत्रियाः सृष्टा बाहुवीर्योपजीविनः ।\nक्रूराय कर्मणे नित्यं प्रजानां परिपालने\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2147941, "chapter_id": 4200, "verse_number": "१०", "content_sanskrit": "शृणु चात्रोपमामेकां या वृद्धेभ्यः श्रुता मया\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2147942, "chapter_id": 4200, "verse_number": "११", "content_sanskrit": "मुचुकुन्दस्य राजर्षेरददात् पृथिवीमिमाम् ।\nपुरा वैश्रवणः प्रीतो न चासौ तद् गृहीतवान्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2147943, "chapter_id": 4200, "verse_number": "१२", "content_sanskrit": "बाहुवीर्यार्जितं राज्यमश्नीयामिति कामये ।\nततो वैश्रवणः प्रीतो विस्मितः समपद्यत\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2147944, "chapter_id": 4200, "verse_number": "१३", "content_sanskrit": "मुचुकुन्दस्ततो राजा सोऽन्वशासद् वसुन्धराम् ।\nबाहुवीर्यार्जितां सम्यक् क्षत्रधर्ममनुव्रतः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2147945, "chapter_id": 4200, "verse_number": "१४", "content_sanskrit": "यं हि धर्मं चरन्तीह प्रजा राज्ञा सुरक्षिताः ।\nचतुर्थं तस्य धर्मस्य राजा विन्देत भारत\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2147946, "chapter_id": 4200, "verse_number": "१५", "content_sanskrit": "राजा चरति चेद् धर्मं देवत्वायैव कल्पते ।\nस चेदधर्मं चरति नरकायैव गच्छति\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2147947, "chapter_id": 4200, "verse_number": "१६", "content_sanskrit": "दण्डनीतिः स्वधर्मेण चातुर्वर्ण्यं नियच्छति ।\nप्रयुक्ता स्वामिना सम्यगधर्मेभ्यो नियच्छति\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2147948, "chapter_id": 4200, "verse_number": "१७", "content_sanskrit": "दण्डनीत्यां यदा राजा सम्यक् कार्त्स्न्येन वर्तते ।\nतदा कृतयुगं नाम कालः श्रेष्ठः प्रवर्तते\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2147949, "chapter_id": 4200, "verse_number": "१८", "content_sanskrit": "कालो वा कारणं राज्ञो राजा वा कालकारणम् ।\nइति ते संशयो मा भूद् राजा कालस्य कारणम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2147950, "chapter_id": 4200, "verse_number": "१९", "content_sanskrit": "राजा कृतयुगस्रष्टा त्रेताया द्वापरस्य च ।\nयुगस्य च चतुर्थस्य राजा भवति कारणम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2147951, "chapter_id": 4200, "verse_number": "२०", "content_sanskrit": "कृतस्य करणाद् राजा स्वर्गमत्यन्तमश्नुते ।\nत्रेतायाः करणाद् राजा स्वर्गं नात्यन्तमश्नुते\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2147952, "chapter_id": 4200, "verse_number": "२१", "content_sanskrit": "प्रवर्तनाद् द्वापरस्य यथाभागमुपाश्नुते ।\nकलेः प्रवर्तनाद् राजा पापमत्यन्तमश्नुते\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2147953, "chapter_id": 4200, "verse_number": "२२", "content_sanskrit": "ततो वसति दुष्कर्मा नरके शाश्वतीः समाः ।\nराजदोषेण हि जगत् स्पृश्यते जगतः स च\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2147954, "chapter_id": 4200, "verse_number": "२३", "content_sanskrit": "राजधर्मानवेक्षस्व पितृपैतामहोचितान् ।\nनैतद् राजर्षिवृत्तं हि यत्र त्वं स्थातुमिच्छसि\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2147955, "chapter_id": 4200, "verse_number": "२४", "content_sanskrit": "न हि वैक्लब्यसंस्पृष्ट आनृशंस्ये व्यवस्थितः ।\nप्रजापालनसम्भूतं फलं किञ्चन लब्धवान्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2147956, "chapter_id": 4200, "verse_number": "२५", "content_sanskrit": "न ह्येतामाशिषं पाण्डुर्न चाहं न पितामहः ।\nप्रयुक्तवन्तः पूर्वं ते यथा चरसि मेधया\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2147957, "chapter_id": 4200, "verse_number": "२६", "content_sanskrit": "यज्ञो दानं तपः शौर्यं प्रज्ञा सन्तानमेव च ।\nमाहात्म्यं बलमोजश्च नित्यमाशंसितं मया\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2147958, "chapter_id": 4200, "verse_number": "२७", "content_sanskrit": "नित्यं स्वाहा स्वधा नित्यं दद्युर्मानुषदेवताः ।\nदीर्घमायुर्धनं पुत्रान् सम्यगाराधिताः शुभाः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2147959, "chapter_id": 4200, "verse_number": "२८", "content_sanskrit": "पुत्रेष्वाशंसते नित्यं पितरो दैवतानि च ।\nदानमध्ययनं यज्ञः प्रजानां परिपालनम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2147960, "chapter_id": 4200, "verse_number": "२९", "content_sanskrit": "एतद् धर्ममधर्मं वा जन्मनैवाभ्यजायथाः ।\nते न वैद्याः कुले जाता अवृत्त्या तात पीडिताः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2147961, "chapter_id": 4200, "verse_number": "३०", "content_sanskrit": "यत्र दानपतिं शूरं क्षुधिताः पृथिवीचराः ।\nप्राप्य तुष्टाः प्रतिष्ठन्ते धर्मः कोऽभ्यधिकस्ततः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2147962, "chapter_id": 4200, "verse_number": "३१", "content_sanskrit": "दानेनान्यं बलेनान्यं तथा सूनृतयाऽपरम् ।\nसर्वतः प्रतिगृह्णीयाद् राज्यं प्राप्येह धार्मिकः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2147963, "chapter_id": 4200, "verse_number": "३२", "content_sanskrit": "ब्राह्मणः प्रचरेद् भैक्ष्यं क्षत्रियः परिपालयेत् ।\nवैश्यो धनार्जनं कुर्यात् शूद्रः परिचरेच्च तान्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2147964, "chapter_id": 4200, "verse_number": "३३", "content_sanskrit": "भैक्ष्यं विप्रतिषिद्धं ते कृषिर्नैवोपपद्यते ।\nक्षत्रियोऽसि क्षतान्(त्) त्राता बाहुवीर्योपजीविता\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2147965, "chapter_id": 4200, "verse_number": "३४", "content_sanskrit": "पित्र्यमंशं महाबाहो निमग्नं पुनरुद्धर ।\nसाम्ना भेदेन दानेन दण्डेनाथ नयेन वा\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2147966, "chapter_id": 4200, "verse_number": "३५", "content_sanskrit": "इतो दुःखतरं किं नु यदहं हीनबान्धवा ।\nपरपिण्डमुदीक्षामि त्वां सूत्वाऽमित्रनन्दनम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2147967, "chapter_id": 4200, "verse_number": "३६", "content_sanskrit": "युध्यस्व राजधर्मेण मा निमज्जेः पितामहान् ।\nमा गमः क्षीणपुण्यस्त्वं सानुजः पापिकां गतिम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2147968, "chapter_id": 4200, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि एकत्रिंशोत्तरशततमोऽध्यायः ॥१३१॥\nभगवद्यानपर्वणि द्विषष्टितमोऽध्यायः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]