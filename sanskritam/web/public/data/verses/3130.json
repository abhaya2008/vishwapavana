[{"id": 2099563, "chapter_id": 3130, "verse_number": "१३-२६०-१", "content_sanskrit": "भीष्म उवाच।\nइत्युक्तः स नृपस्तूष्णीमभूद्वायुस्ततोऽब्रवीत्।\nशृणु राजन्नगस्त्यस्य महात्म्यं ब्राह्ममस्य ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2099564, "chapter_id": 3130, "verse_number": "१३-२६०-२", "content_sanskrit": "असुरैर्निर्जिता देवा निरुत्साहाश्च ते कृताः।\nयज्ञाश्चैषां हृताः सर्वे पितॄणां च स्वधास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2099565, "chapter_id": 3130, "verse_number": "१३-२६०-३", "content_sanskrit": "कर्मज्या मानवानां च दानवैर्हैहयर्षभ।\nभ्रष्टैश्वर्यास्ततो देवाश्चेरुः पृथ्वीमिति श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2099566, "chapter_id": 3130, "verse_number": "१३-२६०-४", "content_sanskrit": "ततः कदाचित्ते राजन्दीप्तमादित्यवर्चसम्।\nददृशुस्तेजसाः युक्तमगस्त्यं विपुलव्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2099567, "chapter_id": 3130, "verse_number": "१३-२६०-५", "content_sanskrit": "अभिवाद्य तु तं देवाः पृष्ट्वा कुशलमेव च।\nइदमूचुर्महात्मानं वाक्यं काले जनाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2099568, "chapter_id": 3130, "verse_number": "१३-२६०-६", "content_sanskrit": "दानवैर्युधि भग्नाः स्म तथैश्वर्याच्चि भ्रंशिताः।\nतदस्मान्नो भयात्तीव्रात्त्राहि त्वं मुनिपुङ्गवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2099569, "chapter_id": 3130, "verse_number": "१३-२६०-७", "content_sanskrit": "इत्युक्तः स तदा देवैरगस्त्यः कुपितोऽभवत्।\nप्रजज्वाल च तेजस्वी कालाग्निरिव संक्षये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2099570, "chapter_id": 3130, "verse_number": "१३-२६०-८", "content_sanskrit": "तेन दीप्तांशुजालेन निर्दग्धा दानवास्तदा।\nअन्तरिक्षान्महाराज निपेतुस्ते सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2099571, "chapter_id": 3130, "verse_number": "१३-२६०-९", "content_sanskrit": "दह्यमानास्तु ते दैत्यास्तस्यागस्त्यस्य तेजसा।\nउभौ लोकौ परित्यज्य गताः काष्ठां तु दक्षिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2099572, "chapter_id": 3130, "verse_number": "१३-२६०-१०", "content_sanskrit": "बलिस्तु यजते यज्ञमश्वमेधं महीं गतः।\nयेन्येऽधस्ता महीस्थाश्च तेन दग्धा महासुराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2099573, "chapter_id": 3130, "verse_number": "१३-२६०-११", "content_sanskrit": "त्यक्तलोकाः पुनः प्राप्ताः सुरैः शान्तभयैर्नृप।\nअथैनमब्रुवन्देवा भूमिष्ठानसु राञ्जहि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2099574, "chapter_id": 3130, "verse_number": "१३-२६०-१२", "content_sanskrit": "इत्युक्तः प्राह देवान्स न शक्तोस्मि महीगतान्।\nदग्धुं तपो हि क्षीयेन्मे न धक्ष्यामीति पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2099575, "chapter_id": 3130, "verse_number": "१३-२६०-१३", "content_sanskrit": "एवं दग्धा भगवता दानवाः स्वेन तेजसा।\nअगस्त्येन तदा राजंस्तपसा भावितात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2099576, "chapter_id": 3130, "verse_number": "१३-२६०-१४", "content_sanskrit": "ईदृशश्चाप्यगस्त्यो हि कथितस्ते मयाऽनघ।\nब्रवीम्यन्यं ब्रूहि वा त्वमगस्त्यात्क्षत्रियं वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2099577, "chapter_id": 3130, "verse_number": "१३-२६०-१५x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2099578, "chapter_id": 3130, "verse_number": "१३-२६०-१५", "content_sanskrit": "इत्युक्तः स तदा तूष्णीमभूद्वायुस्ततोऽब्रवीत्।\nशृणु राजन्वसिष्ठस्य मुख्यं कर्म यशस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2099579, "chapter_id": 3130, "verse_number": "१३-२६०-१६", "content_sanskrit": "`वैखानसविधानेन गङ्गातीरं समाश्रिताः।\nआदित्याः सत्रमासन्त सरो वैखानसं प्रति।\nवसिष्ठं मनसा गत्वा ज्ञात्वा तत्वस्य गोचरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2099580, "chapter_id": 3130, "verse_number": "१३-२६०-१७", "content_sanskrit": "यजमानांस्तु तान्दृष्वा सर्वान्दीक्षानुकर्शितान्।\nहन्तुमैच्छन्त शैलाभा बलिनो नाम दानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2099581, "chapter_id": 3130, "verse_number": "१३-२६०-१८", "content_sanskrit": "अदूरात्तु ततस्तेषां ब्रह्मदत्तवरं सरः।\nहता हता वै तत्रैते जीवन्त्याप्लुत्य दानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2099582, "chapter_id": 3130, "verse_number": "१३-२६०-१९", "content_sanskrit": "ते प्रगृह्य महाघोरान्पर्वतान्परिघान्द्रुमान्।\nविक्षोभयन्तः सलिलमुत्थितं शतयोजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2099583, "chapter_id": 3130, "verse_number": "१३-२६०-२०", "content_sanskrit": "अभ्यद्रवन्त देवांस्ते सहस्राणि दशैव हि।\nततस्तैरर्दिता देवाः शरणं वासवं ययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2099584, "chapter_id": 3130, "verse_number": "१३-२६०-२१", "content_sanskrit": "स च तैर्व्यथितः शक्रो वसिष्ठं सरणं ययौ।\nततोऽभयं ददौ तेभ्यो वसिष्ठो भगवानृषिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2099585, "chapter_id": 3130, "verse_number": "१३-२६०-२२", "content_sanskrit": "तदा तान्दुःकितान्ज्ञात्वा आनृशंस्यपरो मुनिः।\nअयत्नेनादहत्सर्वाञ्ज्वलता स्वेन तेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2099586, "chapter_id": 3130, "verse_number": "१३-२६०-२३", "content_sanskrit": "कैलासं प्रस्थितां चैव नदीं गङ्गां महातपाः।\nआनयत्तत्सरो दिव्यं तया भिन्नं च तत्सरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2099587, "chapter_id": 3130, "verse_number": "१३-२६०-२४", "content_sanskrit": "सरो भिन्नं तया नद्या सरयूः सा ततोऽभवत्।\nहताश्च बलिनो यत्र स देशे बलिनोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2099588, "chapter_id": 3130, "verse_number": "१३-२६०-२५", "content_sanskrit": "एवं सेन्द्रा वसिष्ठेन रक्षितास्त्रिदिवौकसः।\nब्रह्मदत्तवराश्चैव हता दैत्या महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2099589, "chapter_id": 3130, "verse_number": "१३-२६०-२६", "content_sanskrit": "एतत्कर्म वसिष्ठस्य कथितं हि मयाऽनघ।\nब्रवीम्यन्यं ब्रूहि वा त्वं वसिष्ठात्क्षत्रियं वरम्॥ २६ ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2099590, "chapter_id": 3130, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि षष्ट्यधिकद्विशततमोऽध्यायः॥ २६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]