[{"id": 7003003000, "chapter_id": 23003, "verse_number": "२-५०-१", "content_sanskrit": "पार्वत्युवाच ।\nको वा सुयज्ञो नृपतिः कुत्र वंशे बभूव सः ।\nकथं विप्राभिशप्तश्च कथं संप्राप राधिकाम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003003001, "chapter_id": 23003, "verse_number": "२-५०-२", "content_sanskrit": "सर्वात्मनश्च कृष्णस्य पत्नीं श्रीकृष्णपूजिताम् ।\nकथं विण्मूत्रधारी च सिषेवे परमेश्वरीम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003003002, "chapter_id": 23003, "verse_number": "२-५०-३", "content_sanskrit": "षष्टिवर्षसहस्राणि तपस्तेपे पुरा विधिः ।\nयत्पादाम्भोजरेणूनां लब्धये पुष्करे विभुः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003003003, "chapter_id": 23003, "verse_number": "२-५०-४", "content_sanskrit": "कथं ददर्श तां देवो महालक्ष्मीं पुरा सतीम् ।\nदुर्दर्शामपि युष्माकं दृश्या साऽभूत्कथं नृणाम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003003004, "chapter_id": 23003, "verse_number": "२-५०-५", "content_sanskrit": "कथं त्रिजगतां धाता तस्मै तत्कवचं ददौ ।\nध्यानं पूजाविधिं स्तोत्रं तस्या व्याख्यातुमर्हसि ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003003005, "chapter_id": 23003, "verse_number": "२-५०-६", "content_sanskrit": "श्रीमहादेव उवाच ।\nस्वायम्भुवो मनुर्देवि मनूनामादिरेव च ।\nब्रह्मात्मजस्तपस्वी च शतरूपापतिः प्रभुः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003003006, "chapter_id": 23003, "verse_number": "२-५०-७", "content_sanskrit": "उत्तानपादस्तत्पुत्रस्तत्पुत्रो ध्रुव एव च ।\nध्रुवस्य कीर्तिर्विख्यातस्त्रैलोक्ये शैलकन्यके ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003003007, "chapter_id": 23003, "verse_number": "२-५०-८", "content_sanskrit": "उत्कलस्तस्य पुत्रश्च नारायणपरायणः ।\nसहस्रं राजसूयानां पुष्करे स चकार ह ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003003008, "chapter_id": 23003, "verse_number": "२-५०-९", "content_sanskrit": "सर्वाणि रत्नपात्राणि ब्राह्मणेभ्यो ददौ मुदा ।\nअमूल्यरत्नराशीनां सहस्रं तेजसा वृतम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003003009, "chapter_id": 23003, "verse_number": "२-५०-१०", "content_sanskrit": "ब्राह्मणेभ्यो ददौ राजा यज्ञान्ते स महोत्सवे ।\nदृष्ट्वा तच्छोभनं यज्ञं विधाता जगतां प्रिये ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003003010, "chapter_id": 23003, "verse_number": "२-५०-११", "content_sanskrit": "सुयज्ञं नाम नृपतिं चकार सुरसंसदि ।\nस च राजा सुयज्ञश्च मनुवंशसमुद्भवः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003003011, "chapter_id": 23003, "verse_number": "२-५०-१२", "content_sanskrit": "अन्नदाता रत्नदाता दाता वै सर्वसम्पदाम् ।\nदशलक्षं गवां चैव रत्नशृङ्गपरिच्छदम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003003012, "chapter_id": 23003, "verse_number": "२-५०-१३", "content_sanskrit": "नित्यं ददौ स विप्रेभ्यो मुदायुक्तः सदक्षिणम् ।\nगवां द्वादशलक्षाणां ददौ नित्यं मुदाऽन्वितः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003003013, "chapter_id": 23003, "verse_number": "२-५०-१४", "content_sanskrit": "सुपक्वानि च मांसानि ब्राह्मणेभ्यश्च पार्वति ।\nषट्कोटीर्ब्राह्मणानां च भोजयामास नित्यशः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003003014, "chapter_id": 23003, "verse_number": "२-५०-१५", "content_sanskrit": "चोष्यैश्चर्व्यैर्लेह्यपेयैरतितृप्तं दिने दिने ।\nविप्रलक्षं सूपकारं भोजयामास तत्परम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003003015, "chapter_id": 23003, "verse_number": "२-५०-१६", "content_sanskrit": "पूर्णमन्नं च सूपाक्तं सगव्यं मांसवर्जितम् ।\nविप्रा भोजनकाले च मनुवंशसमुद्भवम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003003016, "chapter_id": 23003, "verse_number": "२-५०-१७", "content_sanskrit": "न तुष्टुवुः सुयज्ञं च तुष्टुवुस्तत्पितॄंश्च ते ।\nदिने सुयज्ञयज्ञान्ते षट्त्रिंशल्लक्षकोटयः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003003017, "chapter_id": 23003, "verse_number": "२-५०-१८", "content_sanskrit": "चक्रुः सुभोजनं विप्राश्चातितृप्ताश्च सुन्दरि ।\nगृहीतानि च रत्नानि स्वगृहं वोढुमक्षमाः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003003018, "chapter_id": 23003, "verse_number": "२-५०-१९", "content_sanskrit": "वृषलेभ्यो ददुः किञ्चित्किञ्चित्पथि च तत्यजुः ।\nविप्राणां भोजनान्ते च विप्रान्येभ्यो ददौ नृपः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003003019, "chapter_id": 23003, "verse_number": "२-५०-२०", "content_sanskrit": "तथाप्युर्वरितं तत्र चान्नराशिसहस्रकम् ।\nकृत्वा यज्ञं महाबाहुः समुवास स्वसंसदि॥ ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003003020, "chapter_id": 23003, "verse_number": "२-५०-२१", "content_sanskrit": "रत्नेन्द्रसारसंक्लृप्तच्छत्रकोटिसमन्विते ।\nरत्नसिंहासने रम्ये पट्टवस्त्रैः सुसंस्कृते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003003021, "chapter_id": 23003, "verse_number": "२-५०-२२", "content_sanskrit": "चन्दनादिसुसंसृष्टे रम्ये चन्दनपल्लवैः ।\nशाखायुक्तैः पूर्णकुम्भै रम्भावृक्षैश्च शोभिते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003003022, "chapter_id": 23003, "verse_number": "२-५०-२३", "content_sanskrit": "चन्दनागुरुकस्तूरीवनसिन्दूरसंस्कृते ।\nवसुवासवचन्द्रेन्द्ररुद्रादित्य समन्विते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003003023, "chapter_id": 23003, "verse_number": "२-५०-२४", "content_sanskrit": "मुनिनारदमन्वादिब्रह्मविष्णुशिवान्विते ।\nएतस्मिन्नन्तरे तत्र विप्र एकः समाययौ ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003003024, "chapter_id": 23003, "verse_number": "२-५०-२५", "content_sanskrit": "रूक्षो मलिनवासाश्च शुष्ककण्ठौष्ठतालुकः ।\nरत्नसिंहासनस्थं च माल्यचन्दनचर्चितम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003003025, "chapter_id": 23003, "verse_number": "२-५०-२६", "content_sanskrit": "राजानमाशिषं चक्रे सस्मितः सम्पुटाञ्जलिः ।\nप्रणनाम नृपस्तं च नोत्तस्थौ किंचिदेव हि ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003003026, "chapter_id": 23003, "verse_number": "२-५०-२७", "content_sanskrit": "सभासदश्च नोत्तस्थुर्जहसुः स्वल्पमेव च ।\nमुनिभ्योऽपि च देवेभ्यो नमस्कृत्य द्विजोत्तमः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003003027, "chapter_id": 23003, "verse_number": "२-५०-२८", "content_sanskrit": "शशाप नृपतिं क्रोधात्तत्रातिष्ठन्निरंकुशः ।\nगच्छ दूरमतो राज्याद्भ्रष्टश्रीर्भव पामर ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003003028, "chapter_id": 23003, "verse_number": "२-५०-२९", "content_sanskrit": "भवाचिरं गलत्कुष्ठी बुद्धिहीनोऽप्युपद्रुतः ।\nइत्युक्त्वा कम्पितः क्रोधात्सभास्थाञ्छप्तुमुद्यतः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003003029, "chapter_id": 23003, "verse_number": "२-५०-३०", "content_sanskrit": "ये यत्र जहसुः सर्वे समुत्तस्थुः सभासदः ।\nसर्वे चक्रुः प्रणामं ते क्रोधं तत्याज वाडवः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003003030, "chapter_id": 23003, "verse_number": "२-५०-३१", "content_sanskrit": "प्रणम्यागत्य राजा तं रुरोद भयकातरः ।\nनिस्ससार सभामध्याद्धृदयेन विदूयता ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003003031, "chapter_id": 23003, "verse_number": "२-५०-३२", "content_sanskrit": "ब्राह्मणो गूढरूपी च प्रज्वलन्ब्रह्मतेजसा ।\nतत्पश्चान्मुनयः सर्वे प्रययुर्भयकातराः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003003032, "chapter_id": 23003, "verse_number": "२-५०-३३", "content_sanskrit": "हे विप्र तिष्ठ तिष्ठेति समुच्चार्य्य पुनः पुनः ।\nपुलहश्च पुलस्त्यश्च प्रचेता भृगुरंगिराः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003003033, "chapter_id": 23003, "verse_number": "२-५०-३४", "content_sanskrit": "मरीचिः कश्यपश्चैव वसिष्ठः क्रतुरेव च ।\nशुक्रो बृहस्पति श्चैव दुर्वासा लोमशस्तथा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003003034, "chapter_id": 23003, "verse_number": "२-५०-३५", "content_sanskrit": "गौतमश्च कणादश्च कण्वः कात्यायनः कठः ।\nपाणिनिर्जाजलिश्चैव ऋष्यशृंगो विभाण्डकः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003003035, "chapter_id": 23003, "verse_number": "२-५०-३६", "content_sanskrit": "तैत्तिरिश्चाप्यापिशलिर्मार्कण्डेयो महातपाः ।\nसनकश्च सनन्दश्च वोढुः पैलः सनातनः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003003036, "chapter_id": 23003, "verse_number": "२-५०-३७", "content_sanskrit": "सनत्कुमारो भगवान्नरनारायणावृषी ।\nपराशरो जरत्कारुः संवर्त्तः करभस्तथा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003003037, "chapter_id": 23003, "verse_number": "२-५०-३८", "content_sanskrit": "भरद्वाजश्च वाल्मीकिरौर्वश्च च्यवनस्तथा ।\nअगस्त्यो ऽत्रिरुतथ्यश्च सङ्कर्ताऽऽस्तीक आसुरिः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003003038, "chapter_id": 23003, "verse_number": "२-५०-३९", "content_sanskrit": "शिलालिर्लाङ्गलिश्चैव शाकल्यः शाकटायनः ।\nगर्गो वत्सः पञ्चशिखो जमदग्निश्च देवलः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003003039, "chapter_id": 23003, "verse_number": "२-५०-४०", "content_sanskrit": "जैगीषव्यो वामदेवो वालखिल्यादयस्तथा ।\nशक्तिर्दक्षः कर्दमश्च प्रस्कन्नः कपिलस्तथा ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003003040, "chapter_id": 23003, "verse_number": "२-५०-४१", "content_sanskrit": "विश्वामित्रश्च कौत्सश्चाप्यृचीकोऽप्यघमर्षणः ।\nएते चान्ये च मुनयः पितरोऽग्निर्हरिप्रिया ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003003041, "chapter_id": 23003, "verse_number": "२-५०-४२", "content_sanskrit": "दिक्पाला देवताः सर्वा विप्रं पश्चात्समाययुः ।\nब्राह्मणं बोधयामासुर्वासयामासुरीश्वरि ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003003042, "chapter_id": 23003, "verse_number": "२-५०-४३", "content_sanskrit": "समूचुस्तं क्रमेणैव नीतिं नीतिविशारदाः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]