[{"id": 900008612, "chapter_id": 8655, "verse_number": "36.1", "content_sanskrit": "पूर्वत्र प्रसिद्धस्य ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900008613, "chapter_id": 8655, "verse_number": "36.2", "content_sanskrit": "ननु ‘‘गुहां प्रविष्टा’’विति न्यायेन..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900008614, "chapter_id": 8655, "verse_number": "36.3", "content_sanskrit": "सिद्धान्तस्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900008615, "chapter_id": 8655, "verse_number": "36.4", "content_sanskrit": "अत्र चाद्ये सूत्रे पूर्वाधिकरणोक्तसाधकैरेवेहापि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900008616, "chapter_id": 8655, "verse_number": "36.5", "content_sanskrit": "ननु श्रुतावाकाशात्मनोः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}]