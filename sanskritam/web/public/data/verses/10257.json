[{"id": 6000257000, "chapter_id": 10257, "verse_number": null, "content_sanskrit": "अथ एकषष्टितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000257001, "chapter_id": 10257, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.001.m4a", "display_order": 2}, {"id": 6000257002, "chapter_id": 10257, "verse_number": "१०-६१-१", "content_sanskrit": "विज्ञातार्थोऽपि गोविन्दो दग्धानाकर्ण्य पाण्डवान्।\nकुन्तीं च कुल्यकरणे सहरामो ययौ कुरून्॥ १०/६१/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.002.m4a", "display_order": 3, "topics": [{"text": "कदाचित्कृष्णे हास्तिनपुरं गते शतधन्वना सत्राजितो वधः", "range": "१–६"}]}, {"id": 6000257003, "chapter_id": 10257, "verse_number": "१०-६१-२", "content_sanskrit": "भीष्मं नृपं सविदुरं गान्धारीं द्रोणमेव च।\nतुल्यदुःखौ समागम्य हा कष्टमिति होचतुः॥ १०/६१/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.003.m4a", "display_order": 4}, {"id": 6000257004, "chapter_id": 10257, "verse_number": "१०-६१-३", "content_sanskrit": "लब्ध्वैतदन्तरं राजन् शतधन्वानमूचतुः।\nअक्रूरकृतवर्माणौ मणिः कस्मान्न गृह्यते॥ १०/६१/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.004.m4a", "display_order": 5}, {"id": 6000257005, "chapter_id": 10257, "verse_number": "१०-६१-४", "content_sanskrit": "योऽस्मभ्यं सम्प्रतिश्रुत्य कन्यारत्नं विगर्ह्य नः।\nकृष्णायादात् स सत्राजित् तस्माद् भ्रातरमन्वियात्॥ १०/६१/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.005.m4a", "display_order": 6}, {"id": 6000257006, "chapter_id": 10257, "verse_number": "१०-६१-५", "content_sanskrit": "एवं भिन्नमतिस्ताभ्यां सत्राजितमसत्तमः।\nशयानमवधील्लोभात् स पापः क्षीणजीवितः॥ १०/६१/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.006.m4a", "display_order": 7}, {"id": 6000257007, "chapter_id": 10257, "verse_number": "१०-६१-६", "content_sanskrit": "स्‍त्रीणां विक्रोशमानानां क्रन्दतीनामनाथवत्।\nहत्वा पशुं सौनिकवन्मणिमादाय जग्मिवान्॥ १०/६१/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.007.m4a", "display_order": 8}, {"id": 6000257008, "chapter_id": 10257, "verse_number": "१०-६१-७", "content_sanskrit": "सत्यभामा च पितरं हतं वीक्ष्य शुचार्पिता।\nव्यलपत् तात तातेति हा हताऽस्मीति मुह्यती॥ १०/६१/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.008.m4a", "display_order": 9, "topics": [{"text": "कृष्णेन पाञ्चालनगरं प्रति गमनम्", "range": "७–१४"}]}, {"id": 6000257009, "chapter_id": 10257, "verse_number": "१०-६१-८", "content_sanskrit": "तैलद्रोण्यां मृतं प्रास्य जगाम गजसाह्वयम्।\nकृष्णाय विदितार्थाय तप्ताऽऽचख्यौ पितुर्वधम्॥ १०/६१/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.009.m4a", "display_order": 10}, {"id": 6000257010, "chapter_id": 10257, "verse_number": "१०-६१-९", "content_sanskrit": "तदाकर्ण्येश्वरौ राजन्ननुसृत्य नृलोकताम्।\nअहो नः परमं कष्टमित्यस्राक्षौ विलेपतुः॥ १०/६१/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.010.m4a", "display_order": 11}, {"id": 6000257011, "chapter_id": 10257, "verse_number": "१०-६१-१०", "content_sanskrit": "आगम्य भगवांस्तस्माद् सभार्यः साग्रजः पुरम्।\nशतधन्वानमारेभे हन्तुं हर्तुं च तं मणिम्॥ १०/६१/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.011.m4a", "display_order": 12}, {"id": 6000257012, "chapter_id": 10257, "verse_number": "१०-६१-११", "content_sanskrit": "ततः पाञ्चालनगराद् याज्ञसेन्याः स्वयंवरम्।\nघुष्यता यज्ञसेनेन प्रेषितो दूत आगतः॥ १०/६१/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.012.m4a", "display_order": 13}, {"id": 6000257013, "chapter_id": 10257, "verse_number": "१०-६१-१२", "content_sanskrit": "आहूतस्तेन गोविन्दो गत्वा पाञ्चालके पुरे।\nददर्श साग्रजस्तत्र किशोरान् पाण्डुनन्दनान्॥ १०/६१/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.013.m4a", "display_order": 14}, {"id": 6000257014, "chapter_id": 10257, "verse_number": "१०-६१-१३", "content_sanskrit": "अदृष्टपूर्वान् सुव्यक्तं ब्रह्मरूपधरान् नृपान्।\nतैर्विद्धलक्ष्यैः पौरुष्यप्रतिलब्धमनोरथैः॥ १०/६१/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.014.m4a", "display_order": 15}, {"id": 6000257015, "chapter_id": 10257, "verse_number": "१०-६१-१४", "content_sanskrit": "कुम्भकारस्य शालायां समागम्याभिवन्द्य च।\nपितृष्वसामनुज्ञाप्य राजानं च युधिष्ठिरम्॥ १०/६१/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.015.m4a", "display_order": 16}, {"id": 6000257016, "chapter_id": 10257, "verse_number": "१०-६१-१५", "content_sanskrit": "निहन्तुं शतधन्वानं तूर्णं द्वारावतीमियात्।\nसोऽपि कृष्णोद्यमं ज्ञात्वा भीतः प्राणपरीप्सया॥ १०/६१/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.016.m4a", "display_order": 17, "topics": [{"text": "श्रीकृष्णेन शतधन्वनो वधः", "range": "१५–२७"}]}, {"id": 6000257017, "chapter_id": 10257, "verse_number": "१०-६१-१६", "content_sanskrit": "साहाय्ये कृतवर्माणमयाचत स चाब्रवीत्।\nनाहमीश्वरयोः कुर्यां हेलनं रामकृष्णयोः॥ १०/६१/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.017.m4a", "display_order": 18}, {"id": 6000257018, "chapter_id": 10257, "verse_number": "१०-६१-१७", "content_sanskrit": "को नु क्षेमाय कल्पेत तयोर्वृजिनमाचरन्।\nकंसः सहानुगो वीरो यद्द्वेषात्त्याजितः श्रिया॥ १०/६१/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.018.m4a", "display_order": 19}, {"id": 6000257019, "chapter_id": 10257, "verse_number": "१०-६१-१८", "content_sanskrit": "जरासन्धः सप्तदशसंयुगाद् विरथो गतः।\nप्रत्याख्यातः स चाक्रूरं पार्ष्णिग्राहमयाचत॥ १०/६१/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.019.m4a", "display_order": 20}, {"id": 6000257020, "chapter_id": 10257, "verse_number": "१०-६१-१९", "content_sanskrit": "सोऽप्याह को विरुध्येत विद्वानीश्वरयोर्बलम्।\nयं कैलासाश्रयः शम्भुर्ननाम शिरसा हरिम्॥ १०/६१/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.020.m4a", "display_order": 21}, {"id": 6000257021, "chapter_id": 10257, "verse_number": "१०-६१-२०", "content_sanskrit": "यो हंसडिभिकौ युद्धे जितवान् वरदुर्मदौ।\nआशीविषो महानागो येन निर्वासितो ह्रदात्॥ १०/६१/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.021.m4a", "display_order": 22}, {"id": 6000257022, "chapter_id": 10257, "verse_number": "१०-६१-२१", "content_sanskrit": "य इदं लीलया विश्वं सृजत्यवति हन्ति च।\nचेष्टां विश्वसृजो यस्य न विदुर्मोहिता यया॥ १०/६१/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.022.m4a", "display_order": 23}, {"id": 6000257023, "chapter_id": 10257, "verse_number": "१०-६१-२२", "content_sanskrit": "यः सप्तहायनः शैलमुत्पाट्यैकेन पाणिना।\nदधार लीलया बाल उच्छिलीन्ध्रमिवार्भकः॥ १०/६१/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.023.m4a", "display_order": 24}, {"id": 6000257024, "chapter_id": 10257, "verse_number": "१०-६१-२३", "content_sanskrit": "नमस्तस्मै भगवते कृष्णायाद्भुतकर्मणे।\nअनन्तायादिभूताय कूटस्थायात्मने नमः॥ १०/६१/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.024.m4a", "display_order": 25}, {"id": 6000257025, "chapter_id": 10257, "verse_number": "१०-६१-२४", "content_sanskrit": "प्रत्याख्यातः स तेनापि शतधन्वा महामणिम्।\nतस्मिन् न्यस्याश्वमारुह्य शतयोजनगं ययौ॥ १०/६१/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.025.m4a", "display_order": 26}, {"id": 6000257026, "chapter_id": 10257, "verse_number": "१०-६१-२५", "content_sanskrit": "गरुडध्वजमारुह्य रथं रामजनार्दनौ।\nअन्वयातां महावेगैरश्वै राजन् गुरुद्रुहम्॥ १०/६१/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.026.m4a", "display_order": 27}, {"id": 6000257027, "chapter_id": 10257, "verse_number": "१०-६१-२६", "content_sanskrit": "मिथिलाया उपवने विसृज्य पतितं हयम्।\nपद्भ्यामधावत् सन्त्रस्तः कृष्णोऽन्वभ्यद्रवद् रुषा॥ १०/६१/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.027.m4a", "display_order": 28}, {"id": 6000257028, "chapter_id": 10257, "verse_number": "१०-६१-२७", "content_sanskrit": "पदातेर्धावतस्तस्य पदातिस्तिग्मनेमिना।\nचक्रेण शिर उत्कृत्य वाससोर्व्यचिनोन्मणिम्॥ १०/६१/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.028.m4a", "display_order": 29}, {"id": 6000257029, "chapter_id": 10257, "verse_number": "१०-६१-२८", "content_sanskrit": "अलब्धमणिरागत्य कृष्ण आहाग्रजान्तिकम्।\nवृथा हतः शतधनुर्मणिस्तत्र न विद्यते॥ १०/६१/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.029.m4a", "display_order": 30, "topics": [{"text": "श्रीकृष्णेनाक्रूराय स्यमन्तकमणिदानम्", "range": "२८–५१"}]}, {"id": 6000257030, "chapter_id": 10257, "verse_number": "१०-६१-२९", "content_sanskrit": "तत आह बलो नूनं स मणिः शतधन्वना।\nकस्मिंश्चित् पुरुषे न्यस्तस्तमन्वेषन् पुरं व्रज॥ १०/६१/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.030.m4a", "display_order": 31}, {"id": 6000257031, "chapter_id": 10257, "verse_number": "१०-६१-३०", "content_sanskrit": "अहं वैदेहमिच्छामि द्रष्टुं प्रियतरं मम।\nइत्युक्त्वा स ययौ राजन् मिथिलां यदुनन्दनः॥ १०/६१/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.031.m4a", "display_order": 32}, {"id": 6000257032, "chapter_id": 10257, "verse_number": "१०-६१-३१", "content_sanskrit": "तं दृष्ट्वा सहसोत्थाय मैथिलः प्रीतमानसः।\nअर्हयामास विधिवदर्हण्यं वै समर्हणैः॥ १०/६१/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.032.m4a", "display_order": 33}, {"id": 6000257033, "chapter_id": 10257, "verse_number": "१०-६१-३२", "content_sanskrit": "उवास तस्यां कतिचिन्मिथिलायां समा विभुः। ततोऽशिक्षद् गदां काले धार्तराष्ट्रः सुयोधनः।\nमानितः प्रीतियुक्तेन जनकेन महात्मना॥ १०/६१/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.033.m4a", "display_order": 34}, {"id": 6000257034, "chapter_id": 10257, "verse_number": "१०-६१-३३", "content_sanskrit": "केशवो द्वारकामेत्य निधनं शतधन्वनः।\nअप्राप्तिं च मणेः प्राह प्रियायाः प्रियकृद् विभुः॥ १०/६१/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.034.m4a", "display_order": 35}, {"id": 6000257035, "chapter_id": 10257, "verse_number": "१०-६१-३४", "content_sanskrit": "ततः स कारयामास क्रिया बन्धोर्हतस्य वै।\nसाकं सुहृद्भिर्भगवान् या याः स्युः साम्परायिकाः॥ १०/६१/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.035.m4a", "display_order": 36}, {"id": 6000257036, "chapter_id": 10257, "verse_number": "१०-६१-३५", "content_sanskrit": "अक्रूरकृतवर्माणौ श्रुत्वा शतधनोर्वधम्।\nव्यूषतुर्वधवित्रस्तौ द्वारकायाः प्रयोजकौ॥ १०/६१/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.036.m4a", "display_order": 37}, {"id": 6000257037, "chapter_id": 10257, "verse_number": "१०-६१-३६", "content_sanskrit": "अक्रूरे प्रेषितेऽरिष्टान्यासन् वै द्वारकौकसाम्।\nशारीरा मानसास्तापा मुहुर्दैविकभौतिकाः॥ १०/६१/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.037.m4a", "display_order": 38}, {"id": 6000257038, "chapter_id": 10257, "verse_number": "१०-६१-३७", "content_sanskrit": "ततोऽपृच्छद्धरिर्वृद्धानुग्रसेनपुरोगमान्।\nकस्मादिहारिष्टान्यासन् महतां सुचिरेण वः॥ १०/६१/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.038.m4a", "display_order": 39}, {"id": 6000257039, "chapter_id": 10257, "verse_number": "१०-६१-३८", "content_sanskrit": "इत्यङ्गोपदिशन्त्येके विस्मिता वै गदाभृतः।\nनिवासनिकटे किं वा घटेतारिष्टदर्शनम्॥ १०/६१/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.039.m4a", "display_order": 40}, {"id": 6000257040, "chapter_id": 10257, "verse_number": "१०-६१-३९", "content_sanskrit": "देवेऽवर्षति काशीशः श्वफल्कायागताय गाम्।\nस्वसुतां गान्दिनीं प्रादात् ततोऽवर्षत् स काशिषु॥ १०/६१/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.040.m4a", "display_order": 41}, {"id": 6000257041, "chapter_id": 10257, "verse_number": "१०-६१-४०", "content_sanskrit": "तत्सुतस्तत्प्रभावोऽसावक्रूरो यत्र तत्र सः।\nदेवोऽभिवर्षते तत्र नोपतापा न मारिकाः॥ १०/६१/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.041.m4a", "display_order": 42}, {"id": 6000257042, "chapter_id": 10257, "verse_number": "१०-६१-४१", "content_sanskrit": "इति वृद्धवचः श्रुत्वा नैतावदिह कारणम्।\nइति दूतैः समानीय रामाक्रूरौ जनार्दनः॥ १०/६१/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.042.m4a", "display_order": 43}, {"id": 6000257043, "chapter_id": 10257, "verse_number": "१०-६१-४२", "content_sanskrit": "अक्रूरं मानयन् कृष्णः कथयित्वा प्रियाः कथाः।\nविदिताखिलतत्वज्ञो स्मयमान उवाच ह॥ १०/६१/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.043.m4a", "display_order": 44}, {"id": 6000257044, "chapter_id": 10257, "verse_number": "१०-६१-४३", "content_sanskrit": "ननु दानपते न्यस्तस्त्वय्यसौ शतधन्वना।\nस्यमन्तकमणिः श्रीमान् विदितः पूर्वमेव नः॥ १०/६१/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.044.m4a", "display_order": 45}, {"id": 6000257045, "chapter_id": 10257, "verse_number": "१०-६१-४४", "content_sanskrit": "सत्राजितोऽनपत्यत्वाद् गृह्णीयुर्दुहितुः सुताः। दायं निनीयापः पिण्डान् विमुच्यर्णमशेषतः।\nतथापि दुर्धरो ह्यन्यैस्त्वय्यास्तां प्रापितो मणिः॥ १०/६१/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.045.m4a", "display_order": 46}, {"id": 6000257046, "chapter_id": 10257, "verse_number": "१०-६१-४५", "content_sanskrit": "किन्तु मामग्रजः सम्यङ् न प्रत्येति मणिं प्रति।\nदर्शयस्व महाभाग बन्धूनां शान्तिमावह॥ १०/६१/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.046.m4a", "display_order": 47}, {"id": 6000257047, "chapter_id": 10257, "verse_number": "१०-६१-४६", "content_sanskrit": "अव्युच्छिन्ना मखास्तेऽद्य वर्तन्ते रुग्मवेदयः।\nएवं सामभिरारब्धः श्वफल्कतनयो मणिम्॥ १०/६१/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.047.m4a", "display_order": 48}, {"id": 6000257048, "chapter_id": 10257, "verse_number": "१०-६१-४७", "content_sanskrit": "आदाय वाससा च्छन्नं ददौ सूर्यसमप्रभम्।\nस्यमन्तकं दर्शयित्वा ज्ञातिभ्यो रज आत्मनः॥ १०/६१/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.048.m4a", "display_order": 49}, {"id": 6000257049, "chapter_id": 10257, "verse_number": "१०-६१-४८", "content_sanskrit": "मार्जयामास लोकेश अभिभाष्य हलायुधम्।\nदृष्ट्वा मणिं हलधरस्तदर्थं प्रोष्य आगतः॥ १०/६१/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.049.m4a", "display_order": 50}, {"id": 6000257050, "chapter_id": 10257, "verse_number": "१०-६१-४९", "content_sanskrit": "योग्योऽहमिति मन्वानश्चकमे कुरुपुङ्गव।\nसत्यभामा पितृधनं मन्वाना स्वात्मनोचितम्॥ १०/६१/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.050.m4a", "display_order": 51}, {"id": 6000257051, "chapter_id": 10257, "verse_number": "१०-६१-५०", "content_sanskrit": "गृहीतुमैच्छद् विस्रब्धं हरेश्चित्तमजानती।\nजाम्बवत्यपि शुल्कार्थं पित्रा दत्तो ममेति ह॥ १०/६१/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.051.m4a", "display_order": 52}, {"id": 6000257052, "chapter_id": 10257, "verse_number": "१०-६१-५१", "content_sanskrit": "स्पृहां चक्रे मणौ तस्मिन् सर्वं विज्ञाय माधवः।\nअक्रूरस्य करे भूयो मणिं प्रत्यर्पयद् विभुः॥ १०/६१/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.052.m4a", "display_order": 53}, {"id": 6000257053, "chapter_id": 10257, "verse_number": "१०-६१-५२", "content_sanskrit": "यस्त्वेतद् भगवत ईश्वरस्य विष्णोर्वीर्याख्यं वृजिनहरं सुमङ्गलं च।\nआख्यानं पठति शृृणोत्यनुस्मरेद् वा दुष्कीर्तिं चरितमपोह्य याति शान्तिम्॥ १०/६१/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_061/BhP_10.061.053.m4a", "display_order": 54}, {"id": 6000257054, "chapter_id": 10257, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्ध एकषष्टितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]