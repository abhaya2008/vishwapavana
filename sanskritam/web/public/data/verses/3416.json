[{"id": 2111933, "chapter_id": 3416, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2111934, "chapter_id": 3416, "verse_number": "१", "content_sanskrit": "प्रतीपस्तु ततो राजा सर्वभूतहिते रतः ।\nनिषसाद महाबाहुर्गङ्गातीरे जितेन्द्रियः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2111935, "chapter_id": 3416, "verse_number": "२", "content_sanskrit": "तस्य रूपगुणोपेता लोभनीयतमाकृतिः ।\nउत्तीर्य गङ्गा सलिलादुद्देशं स्त्री समभ्यगात्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2111936, "chapter_id": 3416, "verse_number": "३", "content_sanskrit": "अधीयानस्य राजर्षेस्तस्य सा देववर्णिनी ।\nदक्षिणं सालसङ्काशमूरुं भेजे शुभानना \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2111937, "chapter_id": 3416, "verse_number": "४", "content_sanskrit": "प्रतीपस्तु महीपालस्तामुवाच मनस्विनीम् ।\nवाक्यं वाक्यविदां श्रेष्ठो धर्मनिश्चयतत्त्ववित् ।\nकरवाणि किं ते कल्याणि यदर्थं त्वमिहाभ्यगाः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2111938, "chapter_id": 3416, "verse_number": "", "content_sanskrit": "गङ्गा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2111939, "chapter_id": 3416, "verse_number": "५", "content_sanskrit": "कामये त्वां नरव्याघ्र स कौरव्य भजस्व माम् ।\nत्यागः कामयमानानां स्त्रीणां सद्भिर्विगर्हितः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2111940, "chapter_id": 3416, "verse_number": "", "content_sanskrit": "प्रतीपः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2111941, "chapter_id": 3416, "verse_number": "६", "content_sanskrit": "नाहं कामात् स्त्रियं भद्रे गच्छेयं वरवर्णिनि ।\nन चासवर्णां कल्याणि धर्म्यं तद् विद्धि मे व्रतम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2111942, "chapter_id": 3416, "verse_number": "", "content_sanskrit": "गङ्गा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2111943, "chapter_id": 3416, "verse_number": "७", "content_sanskrit": "नाश्रेयस्यस्मि नागम्या न वक्तव्या कथञ्चन ।\nमां वै भजस्व नृपते देहि कामं वरस्त्रियः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2111944, "chapter_id": 3416, "verse_number": "", "content_sanskrit": "प्रतीपः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2111945, "chapter_id": 3416, "verse_number": "८", "content_sanskrit": "समयातीतमेतद् वै यन्मां चोदयसि प्रियम् ।\nअन्यथा प्रतिपन्नं मां क्षिणुयाद् धर्मविप्लवः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2111946, "chapter_id": 3416, "verse_number": "९", "content_sanskrit": "प्राप्य दक्षिणमूरुं मे समाश्लिष्टा वराङ्गने ।\nअपत्यानां स्नुषाणां च आसनं विद्धि तच्छुभे \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2111947, "chapter_id": 3416, "verse_number": "१०", "content_sanskrit": "सव्योरुर्भामिनीभागस्त्वया सम्यग् विवर्जितः ।\nतस्मादहं नाचरामि त्वयि कामं तु कामतः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2111948, "chapter_id": 3416, "verse_number": "११", "content_sanskrit": "स्नुषा मे भव कल्याणि पुत्रार्थं त्वां वृणोम्यहम् ।\nस्नुषापार्श्वं हि वामोरु त्वमागम्य समाश्रिता \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2111949, "chapter_id": 3416, "verse_number": "", "content_sanskrit": "गङ्गा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2111950, "chapter_id": 3416, "verse_number": "१२", "content_sanskrit": "एवमप्यस्तु धर्मज्ञ संयोगः स्यात् सुतेन ते ।\nत्वद्भक्त्यैव गमिष्याभि प्रख्यातं भारतं कुलम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2111951, "chapter_id": 3416, "verse_number": "१३", "content_sanskrit": "पृथिव्यां पार्थिवा ये च तेषां यूयं वरा गुणैः ।\nगुणा न हि मया शक्या वक्तुं वर्षशतैरपि \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2111952, "chapter_id": 3416, "verse_number": "१४", "content_sanskrit": "योऽयं प्रणेता वंशस्य तव पुत्रो नृपोत्तम ।\nस हि मेऽभिजनं जातिमाचारं चापि तद् विभो \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2111953, "chapter_id": 3416, "verse_number": "१५", "content_sanskrit": "न मीमांसेत ते पुत्रः सर्वमेव नृपोत्तम ।\nएवं वसन्ती राजेन्द्र वर्धयिष्यमि ते प्रियम् ।\nपुत्रैः पुण्यैः सखैश्चापि स्वर्गं जेष्यति ते सुतः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2111954, "chapter_id": 3416, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2111955, "chapter_id": 3416, "verse_number": "१६", "content_sanskrit": "तथेत्युक्त्वा तु सा राज्ञा तत्रैवान्तरधीयत ।\nअदृश्या राजसिंहस्य पश्यतः साऽभवत् तदा \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2111956, "chapter_id": 3416, "verse_number": "१७", "content_sanskrit": "पुत्रजन्म प्रतीक्षन् वै स राजा तदधारयत् ।\nएतस्मिन्नेव काले तु प्रतीपः क्षत्रियर्षभः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2111957, "chapter_id": 3416, "verse_number": "१८", "content_sanskrit": "तपस्तेपे सुतस्यार्थे सभार्यः कुरुनन्दन ।\nप्रतीपस्य तु भार्यायां गर्भः श्रीमानजायत \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2111958, "chapter_id": 3416, "verse_number": "१९", "content_sanskrit": "श्रिया परमया युक्तः शुक्लपक्षे यथा शशी ।\nततस्तु दशमे मासि प्राजायत रविप्रभम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2111959, "chapter_id": 3416, "verse_number": "२०", "content_sanskrit": "कुमारं देवगर्भाभं प्रतीपमहिषी तदा ।\nतयोः समभवत् पुत्रो वृद्धयोः स महाभिषक्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2111960, "chapter_id": 3416, "verse_number": "२१", "content_sanskrit": "शान्तस्य जज्ञे सन्तानं तस्मादासीत् स शन्तनुः ।\nतस्य जातस्य कृत्यानि प्रतीपोऽकारयत् प्रभुः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2111961, "chapter_id": 3416, "verse_number": "२२", "content_sanskrit": "जातकर्मादि विप्रैस्तु वेदोक्तैः कर्मभिस्तदा ।\nनामकर्म च विप्रास्तु चक्रुः परमसंस्कृतम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2111962, "chapter_id": 3416, "verse_number": "२३", "content_sanskrit": "शन्तनोरवनीपाल वेदोक्तैः कर्मभिस्तदा ।\nततः संवर्धितो राजा शन्तनुर्लोकधार्मिकः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2111963, "chapter_id": 3416, "verse_number": "२४", "content_sanskrit": "स तु लेभे परां निष्ठां धर्मे धर्मभृतां वरः ।\nधनुर्वेदे च वेदे च गतिं स परमां गतः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2111964, "chapter_id": 3416, "verse_number": "२५", "content_sanskrit": "यौवनं चापि सम्प्राप्तः कुमारो वदतां वरः ।\nसंस्मरंश्चाक्षयान् लोकान् विजितांस्तान्स्वकर्मणा \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2111965, "chapter_id": 3416, "verse_number": "२६", "content_sanskrit": "बभूव धर्मकृद् राजा शन्तनुर्भरतर्षभ ।\nप्रतीपः शन्तनुं पुत्रं यौवनस्थमबोधयत्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2111966, "chapter_id": 3416, "verse_number": "२७", "content_sanskrit": "पुरा स्त्री मां समभ्यागाच्छन्तनो भूतये तव ।\nत्वामाव्रजेद् यदि रहः सा पुत्र वरवर्णिनी \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2111967, "chapter_id": 3416, "verse_number": "२८", "content_sanskrit": "कामयानाऽभिरूपाढ्या दिव्यस्त्री पुत्रकाम्यया ।\nन प्रष्टव्या त्वया सा वै क्वासि कस्य सुता त्विति\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2111968, "chapter_id": 3416, "verse_number": "२९", "content_sanskrit": "यच्च कुर्यान्न तत् कार्यं प्रतिषेध्यं त्वयाऽनघ ।\nमन्नियोगाद् भजन्तीं तां भजेथा इत्युवाच तम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2111969, "chapter_id": 3416, "verse_number": "३०", "content_sanskrit": "एवं सन्दिश्य तनयं प्रतीपः शन्तनुं तदा ।\nस्वे च राज्येऽभिषिच्यैनं वनं राजा जगाम ह \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2111970, "chapter_id": 3416, "verse_number": "३१", "content_sanskrit": "स राजा शन्तनुर्धीमान् पार्थिवानां धुरन्धरः ।\nबभूव सर्वलोकस्य सत्यवागिति सत्तमः \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2111971, "chapter_id": 3416, "verse_number": "३२", "content_sanskrit": "पीनस्कन्धो महाबाहुर्मत्तवारणविक्रमः ।\nअन्वितः परिपूर्णैश्च सर्वैर्नृपतिलक्षणैः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2111972, "chapter_id": 3416, "verse_number": "३३", "content_sanskrit": "अमात्यसम्पदोपेतः क्षत्रधर्मविशेषवित् ।\nवशे चक्रे महीमेको विजित्य वसुधाधिपान्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2111973, "chapter_id": 3416, "verse_number": "३४", "content_sanskrit": "वेदानागमयत् कृत्स्नान् राजधर्मांश्च कृत्स्नशः ।\nईजे च बहुभिः सत्रैः क्रतुभिर्भूरिदक्षिणैः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2111974, "chapter_id": 3416, "verse_number": "३५", "content_sanskrit": "तर्पयामास विप्रांश्च वेदाध्ययनकोविदान् ।\nरत्नैरुच्चावचैर्गोभिर्ग्रामैरश्वैर्धनैरपि \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2111975, "chapter_id": 3416, "verse_number": "३६", "content_sanskrit": "वयोरूपेण सम्पन्नः पौरुषेण बलेन च ।\nऐश्वर्येण प्रभावेण विक्रमेणातुलेन च \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2111976, "chapter_id": 3416, "verse_number": "३७", "content_sanskrit": "वर्तमानं च सत्येन सर्वधर्मविशारदम् ।\nतं महीपं महीपाला राजराजमकुर्वत \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2111977, "chapter_id": 3416, "verse_number": "३८", "content_sanskrit": "वीतशोकभयाबाधाः सुखस्वप्नप्रबोधनाः ।\nश्रिया भरतशार्दूल समपद्यन्त भूमिपाः \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2111978, "chapter_id": 3416, "verse_number": "३९", "content_sanskrit": "शन्तनुप्रमुखैर्गुप्तं राष्ट्राधिपतिभिर्जगत् ।\nनियमैः सर्ववर्णानां ब्रह्मोत्तरमवर्धत \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2111979, "chapter_id": 3416, "verse_number": "४०", "content_sanskrit": "ब्राह्मणाभिमुखं क्षत्रं क्षत्रं चाभिमुखा विशः ।\nब्रह्मक्षत्रानुलोमाश्च शूद्राः पर्यचरन् विशः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2111980, "chapter_id": 3416, "verse_number": "४१", "content_sanskrit": "एवं पशुवराहाणां तथैव मृगपक्षिणाम् ।\nशन्तनावथ राज्यस्थे नावर्तत वृथा वधः \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2111981, "chapter_id": 3416, "verse_number": "४२", "content_sanskrit": "असुखानामनाथानां तिर्यग्योनिषु वर्तताम् ।\nस एव राजा सर्वेषां भूतानामभवत् पिता \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2111982, "chapter_id": 3416, "verse_number": "४३", "content_sanskrit": "स हस्तिनाम्नि धर्मात्मा विहरन् कुरुनन्दनः ।\nतेजसा सूर्यकल्पोऽसौ वायुना च समो बले \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2111983, "chapter_id": 3416, "verse_number": "४४", "content_sanskrit": "अन्तकप्रतिमः कोपे क्षमया पृथिवीसमः ।\nबभूव राजा सुमतिः प्रजानां सत्यविक्रमः \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2111984, "chapter_id": 3416, "verse_number": "४५", "content_sanskrit": "स वनेषु च रम्येषु शैलप्रस्रवणेषु च ।\nचचार मृगयाशीलः शन्तनुर्वनगोचरः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2111985, "chapter_id": 3416, "verse_number": "४६", "content_sanskrit": "स मृगान् महिषांश्चैव विनिघ्नन् राजसत्तमः ।\nनदीमन्वचरद् राजा शन्तनुः परया मुदा \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2111986, "chapter_id": 3416, "verse_number": "४७", "content_sanskrit": "गङ्गां त्रिपथगां पुण्यां सिद्धचारणसेविताम् ।\nस कदाचिन्महाराज ददर्श परमां स्त्रियम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2111987, "chapter_id": 3416, "verse_number": "४८", "content_sanskrit": "जाज्वल्यमानां वपुषा साक्षाच्छ्रियमिवापराम् ।\nसर्वानवद्यां युवतिं सर्वाभरणभूषिताम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2111988, "chapter_id": 3416, "verse_number": "४९", "content_sanskrit": "सूक्ष्माम्बरधरां साक्षात् पद्मोदरसमप्रभाम् ।\nस्नातमात्रामधोवक्त्रां गङ्गातीररुहे वने \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2111989, "chapter_id": 3416, "verse_number": "५०", "content_sanskrit": "प्रकीर्णकेशीं पाणिभ्यां संस्पृशन्तीं शिरोरुहान् ।\nरूपेणातीत्य तिष्ठन्तीं सर्वराजन्ययोषितः \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2111990, "chapter_id": 3416, "verse_number": "५१", "content_sanskrit": "तां दृष्ट्वा हृष्टरोमाऽभूद् दर्शनादेव शन्तनुः ।\nपिबन्निव च नेत्राभ्यां नातृप्यत नराधिपः \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2111991, "chapter_id": 3416, "verse_number": "५२", "content_sanskrit": "सा तु दृष्ट्वैव राजानं विचरन्तं महाद्युतिम् ।\nस्नेहादागतसौहार्दा नातृप्यत विलासिनी \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2111992, "chapter_id": 3416, "verse_number": "५३", "content_sanskrit": "पिबन्तीव च नेत्राभ्यां नातृप्यद् दर्शनेन च ।\nगङ्गाकाङ्क्षी च राजा स प्रेक्षमाणो विलासिनीम् \t॥ ५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2111993, "chapter_id": 3416, "verse_number": "५४", "content_sanskrit": "हावभावविलासैश्च लोचनाञ्चलविक्रियैः ।\nश्रोणीभारेण मध्येन स्तनाभ्यामुरसा दृशा \t॥ ५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2111994, "chapter_id": 3416, "verse_number": "५५", "content_sanskrit": "विलासचेष्टितैस्तस्या हृतचेताश्च योषितः ।\nतामुवाच ततो राजा कामिनीं तु मनोरमाम्\t॥ ५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2111995, "chapter_id": 3416, "verse_number": "५६", "content_sanskrit": "देवता किन्नरी वा त्वं गन्धर्वी वा सुमध्यमे ।\nयक्षी वा मानुषी वाऽपि जानीयां कां शुचिस्मिते \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2111996, "chapter_id": 3416, "verse_number": "५७", "content_sanskrit": "याऽसि काऽसि सुरप्रख्ये त्वं महिषी मे भवानघे ।\nत्वद्गता हि मम प्राणा वसु यन्मेऽस्ति किञ्चन \t॥ ५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2111997, "chapter_id": 3416, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2111998, "chapter_id": 3416, "verse_number": "५८", "content_sanskrit": "श्रुत्वा तु राज्ञः सा बाला सस्मितं मृदु वल्गु च ।\nयशस्विनी च साऽगच्छच्छन्तनोर्भूतये तदा \t॥ ५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2111999, "chapter_id": 3416, "verse_number": "५९", "content_sanskrit": "सा च दृष्ट्वा नृपश्रेष्ठं चरन्तं तीरमाश्रितम् ।\nस्मृत्वा वसूनां समयमभ्यगच्छदनिन्दिता \t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2112000, "chapter_id": 3416, "verse_number": "६०", "content_sanskrit": "प्रजार्थिनी राजपुत्रं शन्तनुं पृथिवीपतिम् ।\nप्रतीपवचनं चैव संस्मृत्वाऽभिययौ नृपम्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2112001, "chapter_id": 3416, "verse_number": "६१", "content_sanskrit": "कालोऽयमिति मत्वा सा वसूनां शापचोदिता ।\nप्रत्युवाच महीपालं ह्लादयन्ती मनो गिरा \t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2112002, "chapter_id": 3416, "verse_number": "६२", "content_sanskrit": "भविष्यामि महीपाल महिषी ते वशानुगा ।\nन तु त्वं वा द्वितीयो वा ज्ञातुमिच्छेत् कथञ्चन \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2112003, "chapter_id": 3416, "verse_number": "६३", "content_sanskrit": "यत् तु कुर्यामहं राजन् शुभं वा यदि वाऽशुभम् ।\nनाहं वारयितव्याऽस्मि न वक्तव्या तथाऽप्रियम्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2112004, "chapter_id": 3416, "verse_number": "६४", "content_sanskrit": "एवं वै वर्तमाने तु त्वयि वत्स्यामि पार्थिव ।\nवारिता विप्रियं चोक्ता त्यजेयं त्वां नराधिप \t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2112005, "chapter_id": 3416, "verse_number": "६५", "content_sanskrit": "एष मे समयो राजन् भज मां त्वं यथेप्सितम् ।\nअनुनीताऽस्मि ते पित्रा भर्ता मे त्वं भव प्रभो \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2112006, "chapter_id": 3416, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2112007, "chapter_id": 3416, "verse_number": "६६", "content_sanskrit": "तथेति राज्ञा सा तूक्ता तत्रैव वरवर्णिनी ।\nप्रहर्षमतुलं लेभे श्रुत्वा वाक्यमनिन्दिता \t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2112008, "chapter_id": 3416, "verse_number": "६७", "content_sanskrit": "प्रतिज्ञाय तु तत् तस्यास्तथेति मनुजाधिपः ।\nरथमारोप्य तां देवीं जगाम स तया सह \t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2112009, "chapter_id": 3416, "verse_number": "६८", "content_sanskrit": "सा च शन्तनुमभ्यागात् साक्षाल्लक्ष्मीरिवापरा ।\nआसाद्य शन्तनुस्तां च बुभुजे कामवान् सुखी \t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2112010, "chapter_id": 3416, "verse_number": "६९", "content_sanskrit": "न प्रष्टव्येति मन्वानो न स तां किञ्चिदूचिवान् ।\nस तस्याः शीलवृत्तेन रूपेण परमेण च \t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2112011, "chapter_id": 3416, "verse_number": "७०", "content_sanskrit": "सम्यक्चैवोपचारेण सुखमाराधितोऽभवत् ।\nस राजा परमप्रीतः परमस्त्रीप्रलालितः \t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2112012, "chapter_id": 3416, "verse_number": "७१", "content_sanskrit": "दिव्यरूपा हि सा देवी गङ्गा त्रिपथगा नदी ।\nमानुषं विग्रहं श्रीमत् कृत्वा वै वरवर्णिनी \t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2112013, "chapter_id": 3416, "verse_number": "७२", "content_sanskrit": "भाग्योपनतकामस्य भार्येवोपस्थिताऽभवत् ।\nशन्तनो राजसिंहस्य देवराजसमद्युतेः \t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2112014, "chapter_id": 3416, "verse_number": "७३", "content_sanskrit": "सम्भोगस्नेहचातुर्यैर्हावभावसमन्वितैः ।\nराजानं रमयामास यथा रज्येत स प्रभुः ।\nस राजा रतिसक्तोऽभूदुत्तमस्त्रीगुणैर्हृतः \t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2112015, "chapter_id": 3416, "verse_number": "४३", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nपञ्चनवतितमोऽध्यायः॥९५॥ ॥ इति सम्भवपर्वणि त्रिचत्वारिंशोऽध्यायः॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2112016, "chapter_id": 3416, "verse_number": "", "content_sanskrit": "* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}]