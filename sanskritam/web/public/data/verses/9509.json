[{"id": 5000509000, "chapter_id": 9509, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे द्व्यधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000509001, "chapter_id": 9509, "verse_number": "६-१०२-१", "content_sanskrit": "लक्ष्मणेन तु तद् वाक्यमुक्तं श्रुत्वा स राघवः।\nसंदधे परवीरघ्नो धनुरादाय वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000509002, "chapter_id": 9509, "verse_number": "६-१०२-२", "content_sanskrit": "रावणाय शरान् घोरान् विससर्ज चमूमुखे।\nअथान्यं रथमास्थाय रावणो राक्षसाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000509003, "chapter_id": 9509, "verse_number": "६-१०२-३", "content_sanskrit": "अभ्यधावत काकुत्स्थं स्वर्भानुरिव भास्करम्।\nदशग्रीवो रथस्थस्तु रामं वज्रोपमैः शरैः।\nआजघान महाशैलं धाराभिरिव तोयदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000509004, "chapter_id": 9509, "verse_number": "६-१०२-४", "content_sanskrit": "दीप्तपावकसंकाशैः शरैः काञ्चनभूषणैः।\nअभ्यवर्षद् रणे रामो दशग्रीवं समाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000509005, "chapter_id": 9509, "verse_number": "६-१०२-५", "content_sanskrit": "भूमौ स्थितस्य रामस्य रथस्थस्य स रक्षसः।\nन समं युद्धमित्याहुर्देवगन्धर्वकिंनराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000509006, "chapter_id": 9509, "verse_number": "६-१०२-६", "content_sanskrit": "ततो देववरः श्रीमान् श्रुत्वा तेषां वचोऽमृतम्।\nआहूय मातलिं शक्रो वचनं चेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000509007, "chapter_id": 9509, "verse_number": "६-१०२-७", "content_sanskrit": "रथेन मम भूमिष्ठं शीघ्रं याहि रघूत्तमम्।\nआहूय भूतलं यात कुरु देवहितं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000509008, "chapter_id": 9509, "verse_number": "६-१०२-८", "content_sanskrit": "इत्युक्तो देवराजेन मातलिर्देवसारथिः।\nप्रणम्य शिरसा देवं ततो वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000509009, "chapter_id": 9509, "verse_number": "६-१०२-९", "content_sanskrit": "शीघ्रं यास्यामि देवेन्द्र सारथ्यं च करोम्यहम्।\nततो हयैश्च संयोज्य हरितैः स्यन्दनोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000509010, "chapter_id": 9509, "verse_number": "६-१०२-१०", "content_sanskrit": "ततः काञ्चनचित्राङ्गः किङ्किणीशतभूषितः।\nतरुणादित्यसंकाशो वैदूर्यमयकूबरः।\nसदश्वैः काञ्चनापीडैर्युक्तः श्वेतप्रकीर्णकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000509011, "chapter_id": 9509, "verse_number": "६-१०२-११", "content_sanskrit": "हरिभिः सूर्यसंकाशैर्हेमजालविभूषितैः।\nरुक्मवेणुध्वजः श्रीमान् देवराजरथो वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000509012, "chapter_id": 9509, "verse_number": "६-१०२-१२", "content_sanskrit": "देवराजेन संदिष्टो रथमारुह्य मातलिः।\nअभ्यवर्तत काकुत्स्थमवतीर्य त्रिविष्टपात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000509013, "chapter_id": 9509, "verse_number": "६-१०२-१३", "content_sanskrit": "अब्रवीच्च तदा रामं सप्रतोदो रथे स्थितः।\nप्राञ्जलिर्मातलिर्वाक्यं सहस्राक्षस्य सारथिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000509014, "chapter_id": 9509, "verse_number": "६-१०२-१४", "content_sanskrit": "सहस्राक्षेण काकुत्स्थ रथोऽयं विजयाय ते।\nदत्तस्तव महासत्त्व श्रीमन् शत्रुनिबर्हण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000509015, "chapter_id": 9509, "verse_number": "६-१०२-१५", "content_sanskrit": "इदमैन्द्रं महच्चापं कवचं चाग्निसंनिभम्।\nशराश्चादित्यसंकाशाः शक्तिश्च विमला शिवा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000509016, "chapter_id": 9509, "verse_number": "६-१०२-१६", "content_sanskrit": "आरुह्येमं रथं वीर राक्षसं जहि रावणम्।\nमया सारथिना देव महेन्द्र इव दानवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000509017, "chapter_id": 9509, "verse_number": "६-१०२-१७", "content_sanskrit": "इत्युक्तः सम्परिक्रम्य रथं तमभिवाद्य च।\nआरुरोह तदा रामो लोकाँल्लक्ष्म्या विराजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000509018, "chapter_id": 9509, "verse_number": "६-१०२-१८", "content_sanskrit": "तद् बभौ चाद्भुतं युद्धं द्वैरथं रोमहर्षणम्।\nरामस्य च महाबाहो रावणस्य च रक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000509019, "chapter_id": 9509, "verse_number": "६-१०२-१९", "content_sanskrit": "स गान्धर्वेण गान्धर्वं दैवं दैवेन राघवः।\nअस्त्रं राक्षसराजस्य जघान परमास्त्रवित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000509020, "chapter_id": 9509, "verse_number": "६-१०२-२०", "content_sanskrit": "अस्त्रं तु परमं घोरं राक्षसं राक्षसाधिपः।\nससर्ज परमक्रुद्धः पुनरेव निशाचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000509021, "chapter_id": 9509, "verse_number": "६-१०२-२१", "content_sanskrit": "ते रावणधनुर्मुक्ताः शराः काञ्चनभूषणाः।\nअभ्यवर्तन्त काकुत्स्थं सर्पा भूत्वा महाविषाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000509022, "chapter_id": 9509, "verse_number": "६-१०२-२२", "content_sanskrit": "ते दीप्तवदना दीप्तं वमन्तो ज्वलनं मुखैः।\nराममेवाभ्यवर्तन्त व्यादितास्या भयानकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000509023, "chapter_id": 9509, "verse_number": "६-१०२-२३", "content_sanskrit": "तैर्वासुकिसमस्पर्शैर्दीप्तभोगैर्महाविषैः।\nदिशश्च संतताः सर्वा विदिशश्च समावृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000509024, "chapter_id": 9509, "verse_number": "६-१०२-२४", "content_sanskrit": "तान् दृष्ट्वा पन्नगान् रामः समापतत आहवे।\nअस्त्रं गारुत्मतं घोरं प्रादुश्चक्रे भयावहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000509025, "chapter_id": 9509, "verse_number": "६-१०२-२५", "content_sanskrit": "ते राघवधनुर्मुक्ता रुक्मपुङ्खाः शिखिप्रभाः।\nसुपर्णाः काञ्चना भूत्वा विचेरुः सर्पशत्रवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000509026, "chapter_id": 9509, "verse_number": "६-१०२-२६", "content_sanskrit": "ते तान् सर्वान् शराञ्जघ्नुः सर्परूपान् महाजवान्।\nसुपर्णरूपा रामस्य विशिखाः कामरूपिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000509027, "chapter_id": 9509, "verse_number": "६-१०२-२७", "content_sanskrit": "अस्त्रे प्रतिहते क्रुद्धो रावणो राक्षसाधिपः।\nअभ्यवर्षत् तदा रामं घोराभिः शरवृष्टिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000509028, "chapter_id": 9509, "verse_number": "६-१०२-२८", "content_sanskrit": "ततः शरसहस्रेण राममक्लिष्टकारिणम्।\nअर्दयित्वा शरौघेण मातलिं प्रत्यविध्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000509029, "chapter_id": 9509, "verse_number": "६-१०२-२९", "content_sanskrit": "चिच्छेद केतुमुद्दिश्य शरेणैकेन रावणः।\nपातयित्वा रथोपस्थे रथात् केतुं च काञ्चनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000509030, "chapter_id": 9509, "verse_number": "६-१०२-३०", "content_sanskrit": "ऐन्द्रानपि जघानाश्वान् शरजालेन रावणः।\nविषेदुर्देवगन्धर्वचारणा दानवैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000509031, "chapter_id": 9509, "verse_number": "६-१०२-३१", "content_sanskrit": "राममार्तं तदा दृष्ट्वा सिद्धाश्च परमर्षयः।\nव्यथिता वानरेन्द्राश्च बभूवुः सविभीषणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000509032, "chapter_id": 9509, "verse_number": "६-१०२-३२", "content_sanskrit": "रामचन्द्रमसं दृष्ट्वा ग्रस्तं रावणराहुणा।\nप्राजापत्यं च नक्षत्रं रोहिणीं शशिनः प्रियाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000509033, "chapter_id": 9509, "verse_number": "६-१०२-३३", "content_sanskrit": "समाक्रम्य बुधस्तस्थौ प्रजानामहितावहः।\nसधूमपरिवृर्त्तोमिः प्रज्वलन्निव सागरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000509034, "chapter_id": 9509, "verse_number": "६-१०२-३४", "content_sanskrit": "उत्पपात तदा क्रुद्धः स्पृशन्निव दिवाकरम्।\nशस्त्रवर्णः सुपरुषो मन्दरश्मिर्दिवाकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000509035, "chapter_id": 9509, "verse_number": "६-१०२-३५", "content_sanskrit": "अदृश्यत कबन्धाङ्कः संसक्तो धूमकेतुना।\nकोसलानां च नक्षत्रं व्यक्तमिन्द्राग्निदैवतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000509036, "chapter_id": 9509, "verse_number": "६-१०२-३६", "content_sanskrit": "आहत्याङ्गारकस्तस्थौ विशाखमपि चाम्बरे।\nदशास्यो विंशतिभुजः प्रगृहीतशरासनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000509037, "chapter_id": 9509, "verse_number": "६-१०२-३७", "content_sanskrit": "अदृश्यत दशग्रीवो मैनाक इव पर्वतः।\nनिरस्यमानो रामस्तु दशग्रीवेण रक्षसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000509038, "chapter_id": 9509, "verse_number": "६-१०२-३८", "content_sanskrit": "नाशक्नोदभिसंधातुं सायकान् रणमूर्धनि।\nस कृत्वा भ्रुकुटिं क्रुद्धः किंचित् संरक्तलोचनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000509039, "chapter_id": 9509, "verse_number": "६-१०२-३९", "content_sanskrit": "जगाम सुमहाक्रोधं निर्दहन्निव राक्षसान्।\nतस्य क्रुद्धस्य वदनं दृष्ट्वा रामस्य धीमतः।\nसर्वभूतानि वित्रेसुः प्राकम्पत च मेदिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000509040, "chapter_id": 9509, "verse_number": "६-१०२-४०", "content_sanskrit": "सिंहशार्दूलवाञ्छैलः संचचाल चलद् द्रुमः।\nबभूव चापि क्षुभितः समुद्रः सरितां पतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000509041, "chapter_id": 9509, "verse_number": "६-१०२-४१", "content_sanskrit": "खराश्च खरनिर्घोषा गगने परुषा घनाः।\nऔत्पातिकाश्च नर्दन्तः समन्तात् परिचक्रमुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000509042, "chapter_id": 9509, "verse_number": "६-१०२-४२", "content_sanskrit": "रामं दृष्ट्वा सुसंक्रुद्धमुत्पातांश्चैव दारुणान्।\nवित्रेसुः सर्वभूतानि रावणस्याभवद् भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000509043, "chapter_id": 9509, "verse_number": "६-१०२-४३", "content_sanskrit": "विमानस्थास्तदा देवा गन्धर्वाश्च महोरगाः।\nऋषिदानवदैत्याश्च गरुत्मन्तश्च खेचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000509044, "chapter_id": 9509, "verse_number": "६-१०२-४४", "content_sanskrit": "ददृशुस्ते तदा युद्धं लोकसंवर्तसंस्थितम्।\nनानाप्रहरणैर्भीमैः शूरयोः सम्प्रयुध्यतोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000509045, "chapter_id": 9509, "verse_number": "६-१०२-४५", "content_sanskrit": "ऊचुः सुरासुराः सर्वे तदा विग्रहमागताः।\nप्रेक्षमाणा महायुद्धं वाक्यं भक्त्या प्रहृष्टवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000509046, "chapter_id": 9509, "verse_number": "६-१०२-४६", "content_sanskrit": "दशग्रीवं जयेत्याहुरसुराः समवस्थिताः।\nदेवा राममथोचुस्ते त्वं जयेति पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000509047, "chapter_id": 9509, "verse_number": "६-१०२-४७", "content_sanskrit": "एतस्मिन्नन्तरे क्रोधाद् राघवस्य च रावणः।\nप्रहर्तुकामो दुष्टात्मा स्पृशन् प्रहरणं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000509048, "chapter_id": 9509, "verse_number": "६-१०२-४८", "content_sanskrit": "वज्रसारं महानादं सर्वशत्रुनिबर्हणम्।\nशैलशृङ्गनिभैः कूटैश्चित्तदृष्टिभयावहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000509049, "chapter_id": 9509, "verse_number": "६-१०२-४९", "content_sanskrit": "सधूममिव तीक्ष्णाग्रं युगान्ताग्निचयोपमम्।\nअतिरौद्रमनासाद्यं कालेनापि दुरासदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000509050, "chapter_id": 9509, "verse_number": "६-१०२-५०", "content_sanskrit": "त्रासनं सर्वभूतानां दारणं भेदनं तथा।\nप्रदीप्त इव रोषेण शूलं जग्राह रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000509051, "chapter_id": 9509, "verse_number": "६-१०२-५१", "content_sanskrit": "तच्छूलं परमक्रुद्धो जग्राह युधि वीर्यवान्।\nअनीकैः समरे शूरै राक्षसैः परिवारितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000509052, "chapter_id": 9509, "verse_number": "६-१०२-५२", "content_sanskrit": "समुद्यम्य महाकायो ननाद युधि भैरवम्।\nसंरक्तनयनो रोषात् स्वसैन्यमभिहर्षयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000509053, "chapter_id": 9509, "verse_number": "६-१०२-५३", "content_sanskrit": "पृथिवीं चान्तरिक्षं च दिशश्च प्रदिशस्तथा।\nप्राकम्पयत् तदा शब्दो राक्षसेन्द्रस्य दारुणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000509054, "chapter_id": 9509, "verse_number": "६-१०२-५४", "content_sanskrit": "अतिकायस्य नादेन तेन तस्य दुरात्मनः।\nसर्वभूतानि वित्रेसुः सागरश्च प्रचुक्षुभे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000509055, "chapter_id": 9509, "verse_number": "६-१०२-५५", "content_sanskrit": "स गृहीत्वा महावीर्यः शूलं तद् रावणो महत्।\nविनद्य सुमहानादं रामं परुषमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000509056, "chapter_id": 9509, "verse_number": "६-१०२-५६", "content_sanskrit": "शूलोऽयं वज्रसारस्ते राम रोषान्मयोद्यतः।\nतव भ्रातृसहायस्य सद्यः प्राणान् हरिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000509057, "chapter_id": 9509, "verse_number": "६-१०२-५७", "content_sanskrit": "रक्षसामद्य शूराणां निहतानां चमूमुखे।\nत्वां निहत्य रणश्लाघिन् करोमि तरसा समम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000509058, "chapter_id": 9509, "verse_number": "६-१०२-५८", "content_sanskrit": "तिष्ठेदानीं निहन्मि त्वामेष शूलेन राघव।\nएवमुक्त्वा स चिक्षेप तच्छूलं राक्षसाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000509059, "chapter_id": 9509, "verse_number": "६-१०२-५९", "content_sanskrit": "तद् रावणकरान्मुक्तं विद्युन्मालासमावृतम्।\nअष्टघण्टं महानादं वियद‍्गतमशोभत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000509060, "chapter_id": 9509, "verse_number": "६-१०२-६०", "content_sanskrit": "तच्छूलं राघवो दृष्ट्वा ज्वलन्तं घोरदर्शनम्।\nससर्ज विशिखान् रामश्चापमायम्य वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000509061, "chapter_id": 9509, "verse_number": "६-१०२-६१", "content_sanskrit": "आपतन्तं शरौघेण वारयामास राघवः।\nउत्पतन्तं युगान्ताग्निं जलौघैरिव वासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000509062, "chapter_id": 9509, "verse_number": "६-१०२-६२", "content_sanskrit": "निर्ददाह स तान् बाणान् रामकार्मुकनिःसृतान्।\nरावणस्य महान् शूलः पतङ्गानिव पावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000509063, "chapter_id": 9509, "verse_number": "६-१०२-६३", "content_sanskrit": "तान् दृष्ट्वा भस्मसाद्भूतान् शूलसंस्पर्शचूर्णितान्।\nसायकानन्तरिक्षस्थान् राघवः क्रोधमाहरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000509064, "chapter_id": 9509, "verse_number": "६-१०२-६४", "content_sanskrit": "स तां मातलिना नीतां शक्तिं वासवसम्मताम्।\nजग्राह परमक्रुद्धो राघवो रघुनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000509065, "chapter_id": 9509, "verse_number": "६-१०२-६५", "content_sanskrit": "सा तोलिता बलवता शक्तिर्घण्टाकृतस्वना।\nनभः प्रज्वालयामास युगान्तोल्केव सप्रभा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 5000509066, "chapter_id": 9509, "verse_number": "६-१०२-६६", "content_sanskrit": "सा क्षिप्ता राक्षसेन्द्रस्य तस्मिञ्छूले पपात ह।\nभिन्नः शक्त्या महान् शूलो निपपात गतद्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 5000509067, "chapter_id": 9509, "verse_number": "६-१०२-६७", "content_sanskrit": "निर्बिभेद ततो बाणैर्हयानस्य महाजवान्।\nरामस्तीक्ष्णैर्महावेगैर्वज्रकल्पैरजिह्मगैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 5000509068, "chapter_id": 9509, "verse_number": "६-१०२-६८", "content_sanskrit": "निर्बिभेदोरसि तदा रावणं निशितैः शरैः।\nराघवः परमायत्तो ललाटे पत्त्रिभिस्त्रिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 5000509069, "chapter_id": 9509, "verse_number": "६-१०२-६९", "content_sanskrit": "स शरैर्भिन्नसर्वाङ्गो गात्रप्रस्रुतशोणितः।\nराक्षसेन्द्रः समूहस्थः फुल्लाशोक इवाबभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 5000509070, "chapter_id": 9509, "verse_number": "६-१०२-७०", "content_sanskrit": "स रामबाणैरतिविद्धगात्रो\nनिशाचरेन्द्रः क्षतजार्द्रगात्रः।\nजगाम खेदं च समाजमध्ये\nक्रोधं च चक्रे सुभृशं तदानीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 5000509071, "chapter_id": 9509, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे द्व्यधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 5000509072, "chapter_id": 9509, "verse_number": null, "content_sanskrit": "”’", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}]