[{"id": 2065774, "chapter_id": 2391, "verse_number": "९-९-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2065775, "chapter_id": 2391, "verse_number": "९-९-१", "content_sanskrit": "तत्प्रभग्नं बलं दृष्ट्वा मद्रराजः प्रतापवान्।\nउवाच सारथिं तूर्णं चोदयाश्वान्महाजवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2065776, "chapter_id": 2391, "verse_number": "९-९-२", "content_sanskrit": "एष तिष्ठति वै राजा पाण्डुपुत्रो युधिष्ठिरः।\nछत्रेण ध्रियमाणेन पाण्डुरेण विराजता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2065777, "chapter_id": 2391, "verse_number": "९-९-३", "content_sanskrit": "अत्र मां प्रापय क्षिप्रं पश्य मे सारथे बलम्।\nन समर्था हि मे पार्थाः स्थातुमद्य पुरो युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2065778, "chapter_id": 2391, "verse_number": "९-९-४", "content_sanskrit": "एवमुक्तस्ततः प्रायान्मद्रराजस्य सारथिः।\nयत्रा राजा सत्यसन्धो धर्मपुत्रो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2065779, "chapter_id": 2391, "verse_number": "९-९-५", "content_sanskrit": "आपतन्तं च सहसा पाण्डवानां महद्बलम्।\nदधारैको रणे शल्यो वेलोद्वृत्तमिवार्णवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2065780, "chapter_id": 2391, "verse_number": "९-९-६", "content_sanskrit": "पाण्डवानां बलौघस्तु शल्यमासाद्य मारिष।\nव्यतिष्ठत तदा युद्वे सिन्धोर्वेग इवाचलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2065781, "chapter_id": 2391, "verse_number": "९-९-७", "content_sanskrit": "मद्रराजं तु समरे दृष्ट्वा युद्धाय धिष्ठितम्।\nकुरवः सन्न्यवर्तन्त मृत्युं कृत्वा निवर्तनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2065782, "chapter_id": 2391, "verse_number": "९-९-८", "content_sanskrit": "तेषु राजन्निवृत्तेषु व्यूढानीकेषु सर्वशः।\nप्रावर्तत महारौद्रः सङ्ग्रामः शोणितोदकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2065783, "chapter_id": 2391, "verse_number": "९-९-९", "content_sanskrit": "समार्च्छच्चित्रसेनं तु नकुलो युद्धदुर्मदः।\nतौ परस्परमासाद्य चित्रकार्मुकधारिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2065784, "chapter_id": 2391, "verse_number": "९-९-१०", "content_sanskrit": "मेघाविव यथोद्वृत्तौ दक्षिणोत्तरवर्षिणौ।\nशरतोयैः सिषिचतुस्तौ परस्परमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2065785, "chapter_id": 2391, "verse_number": "९-९-११", "content_sanskrit": "नान्तरं तत्र पश्यामः पाण्डवस्येतरस्य च।\nउभौ कृतास्त्रौ बलिनौ रथचर्याविशारदौ।\nपरस्परवधे यत्तौ छिद्रान्वेषणतत्परौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2065786, "chapter_id": 2391, "verse_number": "९-९-१२", "content_sanskrit": "चित्रसेनस्तु भल्लेन पीतेन निशितेन च।\nनकुलस्य महाराज मुष्टिदेशेऽच्छिनद्धनुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2065787, "chapter_id": 2391, "verse_number": "९-९-१३", "content_sanskrit": "अथैनं छिन्नधन्वानं रुक्मपुङ्खैः शिलाशितैः।\nत्रिभिः शरैरसम्भ्रान्तो ललाटे वै समार्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2065788, "chapter_id": 2391, "verse_number": "९-९-१४", "content_sanskrit": "हयांश्चास्य शरैस्तीक्ष्णैः प्रेषयामास मृत्यवे।\nतथा ध्वजं सारथिं च त्रिभिस्त्रिभिरपातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2065789, "chapter_id": 2391, "verse_number": "९-९-१५", "content_sanskrit": "स शत्रुभुजनिर्मुक्तैर्ललाटस्थैस्त्रिभिः शरैः।\nनकुलः शुशुभे राजंस्त्रिशृङ्ग इव पर्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2065790, "chapter_id": 2391, "verse_number": "९-९-१६", "content_sanskrit": "स च्छिन्नधन्वा विरथः खङ्गमादाय चर्म च।\nरथादवातरद्वीरः शैलाग्रादिव केसरी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2065791, "chapter_id": 2391, "verse_number": "९-९-१७", "content_sanskrit": "पद्मामापततस्तस्य शस्वृष्टिं समासृजत्।\nनकुलोऽप्यग्रसत्तां वै चर्मणा लघुविक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2065792, "chapter_id": 2391, "verse_number": "९-९-१८", "content_sanskrit": "चित्रसेनरथं प्राप्य चित्रयोधी जितश्रमः।\nआरुरोह महाबाहुः सर्वसैन्यस्य पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2065793, "chapter_id": 2391, "verse_number": "९-९-१९", "content_sanskrit": "सकुण्डलं समुकुटं सुनसं स्वायतेक्षणम्।\nचित्रसेनशिरः कायादपाहरत पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2065794, "chapter_id": 2391, "verse_number": "९-९-२०", "content_sanskrit": "स पपात रथात्तस्माद्दिवाकरसमद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2065795, "chapter_id": 2391, "verse_number": "९-९-२१", "content_sanskrit": "चित्रसेनशिरस्तत्तु दृष्ट्वा तत्र महारथाः।\nसाधुवादस्वनांश्चक्रुः सिंहनादांश्च पुष्कलान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2065796, "chapter_id": 2391, "verse_number": "९-९-२२", "content_sanskrit": "विशस्तं भ्रातरं दृष्ट्वा कर्णपुत्रौ महारथौ।\nसुशर्मा सत्यसेनश्च मुञ्चन्तौ विविधाञ्शरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2065797, "chapter_id": 2391, "verse_number": "९-९-२३", "content_sanskrit": "ततोऽभ्यधावतां तूर्णं पाण्डवं रथिनां वरम्।\nजिघांसन्तौ यथा नागं व्याघ्रौ राजन्महावने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2065798, "chapter_id": 2391, "verse_number": "९-९-२४", "content_sanskrit": "तावभ्येत्य महाबाहू द्वावप्यतिमहारथौ।\nशरौषान्सम्यगस्यन्तौ जीमूतौ सलिलं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2065799, "chapter_id": 2391, "verse_number": "९-९-२५", "content_sanskrit": "स शरैः सर्वतो विद्धः प्रहृष्ट इव पाण्डवः।\nअन्यत्कार्मुकमादाय रथमारुह्य वेगवान्।\nअतिष्ठत रणे वीरः क्रुद्धरूप इवान्तकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2065800, "chapter_id": 2391, "verse_number": "९-९-२६", "content_sanskrit": "तस्य तौ भ्रातरौ राजञ्शरैः सन्नतपर्वभिः।\nरथं विशकलीकर्तुं समारब्धौ विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2065801, "chapter_id": 2391, "verse_number": "९-९-२७", "content_sanskrit": "ततः प्रहस्य नकुलश्चतुर्भिश्चतुरो रणे।\nजघान निशितैर्बाणैः सत्यसेनस्य वाजिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2065802, "chapter_id": 2391, "verse_number": "९-९-२८", "content_sanskrit": "ततः सन्धाय नारचं रुक्मपुङ्खं शिलाशितम्।\nधनुश्चिच्छेद राजेन्द्र सत्यसेनस्य पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2065803, "chapter_id": 2391, "verse_number": "९-९-२९", "content_sanskrit": "अथान्यं रथमास्थाय धनुरादाय चापरम्।\nसत्यसेनः सुशर्मा च पाण्डवं पर्यधावताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2065804, "chapter_id": 2391, "verse_number": "९-९-३०", "content_sanskrit": "अविध्यत्तावसम्भ्रान्तौ माद्रीपुत्रः प्रतापवान्।\nद्वाभ्यां द्वाभ्यां महाराज शराभ्यां रणमूर्धनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2065805, "chapter_id": 2391, "verse_number": "९-९-३१", "content_sanskrit": "सुशर्मा तु ततः क्रुद्धः पाण्डवस्य महद्धनुः।\nचिच्छेद प्रहसन्युद्धे क्षुरप्रेण महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2065806, "chapter_id": 2391, "verse_number": "९-९-३२", "content_sanskrit": "अथान्यद्धनुरादाय नकुलः क्रोधमूच्छितः।\nसुशर्माणं पञ्चभिर्विद्ध्वा ध्वजमेकेन चिच्छिदे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2065807, "chapter_id": 2391, "verse_number": "९-९-३३", "content_sanskrit": "सत्यसेनस्य स धनुर्हस्तावपं च मारिष।\nचिच्छेद तरसा युद्धे तत उच्चुक्रुशुर्जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2065808, "chapter_id": 2391, "verse_number": "९-९-३४", "content_sanskrit": "अथान्यद्धनुरादाय वेगघ्नं भारसाधनम्।\nशरैः सञ्छादयामास समन्तात्पाण्डुनन्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2065809, "chapter_id": 2391, "verse_number": "९-९-३५", "content_sanskrit": "सन्निवार्य तु तान्बाणान्नकुलः परवीरहा।\nसत्यसेनसुशर्माणौ द्वाभ्यां द्वाभ्यामविध्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2065810, "chapter_id": 2391, "verse_number": "९-९-३६", "content_sanskrit": "तावेनं प्रत्यविध्येतां पृथक्पृथगजिह्मगैः।\nसारथिं चास्य राजेन्द्र शितैर्विव्यधतुः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2065811, "chapter_id": 2391, "verse_number": "९-९-३७", "content_sanskrit": "सत्यसेनो रथेषां तु नकुलस्य धनुस्तथा।\nपृथक् शराभ्यां चिच्छेद कृतहस्तः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2065812, "chapter_id": 2391, "verse_number": "९-९-३८", "content_sanskrit": "स रथेऽतिरथस्तिष्ठन्रथशक्तिं परामृशत्॥\nस्वर्णदण्डामकुण्ठाग्रां तैलधौतां सुनिर्मलाम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2065813, "chapter_id": 2391, "verse_number": "९-९-३९", "content_sanskrit": "लेलिहानामिव विमो नागकन्यां महाविषाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2065814, "chapter_id": 2391, "verse_number": "९-९-४०", "content_sanskrit": "समुद्यम्य च चिक्षेप सत्यसेनस्य संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2065815, "chapter_id": 2391, "verse_number": "९-९-४१", "content_sanskrit": "सा तस्य हृदयं गत्या विभेद शतधा नृप।\nस पवात रथाद्भूमिं यतसत्वोऽल्पत्तेतनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2065816, "chapter_id": 2391, "verse_number": "९-९-४२", "content_sanskrit": "भ्रातरं निहतं दृष्ट्वा सुशर्मा क्रोधमूर्च्छितः।\nअभ्यवर्षच्छरैस्तूर्णं पादातं पाण्डुनन्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2065817, "chapter_id": 2391, "verse_number": "९-९-४३", "content_sanskrit": "चतुर्भिश्चतुरो वाहान्ध्वजं छित्त्वा च पञ्चभिः।\nत्रिभिर्वै सारथिं हत्वा कर्णपुत्रो ननाद ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2065818, "chapter_id": 2391, "verse_number": "९-९-४४", "content_sanskrit": "नकुलं विरथं दृष्ट्वा द्रौपदेयो महारथम्।\nसुतसोमोऽभिदुद्राव परीप्सन्पितरं रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2065819, "chapter_id": 2391, "verse_number": "९-९-४५", "content_sanskrit": "ततोऽधिरुह्य नकुलः सुतसोमस्य तं रथम्।\nशुशुभे भरतश्रेष्ठो गिरिस्य इव केसरी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2065820, "chapter_id": 2391, "verse_number": "९-९-४६", "content_sanskrit": "अन्यत्कार्मुकमादाय सुशर्माणमयोधयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2065821, "chapter_id": 2391, "verse_number": "९-९-४७", "content_sanskrit": "तत्र तौ शरवर्षाभ्यां समासाद्य परस्परम्।\nपरस्परवधे यत्नं चक्रतुः सुमहारथौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2065822, "chapter_id": 2391, "verse_number": "९-९-४८", "content_sanskrit": "सुशर्मा तु तः क्रुद्धः पाण्डवं विशिखैस्त्रिभिः।\nसुतसोमं तु विंशत्या वाह्वोरुरसि चार्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2065823, "chapter_id": 2391, "verse_number": "९-९-४९", "content_sanskrit": "ततः क्रुद्धो महाराज नकुलः परवीरहा।\nशरैस्तस्य दिशः सर्वाश्छादयामास वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2065824, "chapter_id": 2391, "verse_number": "९-९-५०", "content_sanskrit": "ततो गृहीत्वा तीक्ष्णाग्रमर्धचन्द्रं सुतेजनम्।\nआकर्णपूर्णं चिक्षेप कर्णपुत्राय संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2065825, "chapter_id": 2391, "verse_number": "९-९-५१", "content_sanskrit": "तस्य तेन शिरः कायाज्जहार नृपसत्तम।\nपश्यतां सर्वसैन्यानां तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2065826, "chapter_id": 2391, "verse_number": "९-९-५२", "content_sanskrit": "स हतः प्रापतद्राजन्नकुलेन महात्मना।\nनदीपेxxxxxxxणस्तीरजः पादपो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2065827, "chapter_id": 2391, "verse_number": "९-९-५३", "content_sanskrit": "कर्णपुत्रवचं दृष्ट्वा नकुलस्य च विक्रमम्।\nप्रदुद्राव भवात्सेना तावकी भरतर्वभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2065828, "chapter_id": 2391, "verse_number": "९-९-५४", "content_sanskrit": "तां तु सेनां महाराज्ञ मद्रराजः प्रतापवान्।\nxxxxxx शूरः सेनापतिररिन्दमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2065829, "chapter_id": 2391, "verse_number": "९-९-५५", "content_sanskrit": "xxxxxx व्यवस्याप्य च वाहिनीम्।\nxxxxxxx भूशं कृत्वा धनुःशब्दं च दारुणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2065830, "chapter_id": 2391, "verse_number": "९-९-५६", "content_sanskrit": "xxxxxx सगरे राजन्रांक्षेता दृढधन्वना।\nप्रत्युद्ययुश्च तांस्ते तु समन्ताद्विगतव्यथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2065831, "chapter_id": 2391, "verse_number": "९-९-५७", "content_sanskrit": "मद्रराजं महेष्वासं परिवार्य समन्ततः।\nस्थिता राजन्महासेना योद्वुकामा समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2065832, "chapter_id": 2391, "verse_number": "९-९-५८", "content_sanskrit": "सात्यकिर्भीमसेनश्च माद्रीपुत्रौ च पाण्डवौ।\nयुधिष्ठिरं पुरस्कृत्य हीनिषेवमरिन्दमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2065833, "chapter_id": 2391, "verse_number": "९-९-५९", "content_sanskrit": "परिवार्य रणे वीराः सिंहनादं प्रचक्रिरे।\nबाणशङ्खरवांस्तीव्रान्क्ष्वेलाश्च विविधा दधुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2065834, "chapter_id": 2391, "verse_number": "९-९-६०", "content_sanskrit": "तथैव तावकाः सर्वे मद्राधिपतिमञ्जसा।\nपरिवार्य सुसंरब्धाः पुनर्युद्धमरोचयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2065835, "chapter_id": 2391, "verse_number": "९-९-६१", "content_sanskrit": "ततः प्रववृते युद्धं भीरूणां भयवर्धनम्।\nतावकानां परेषां च मृत्युं कृत्वा निबर्तनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2065836, "chapter_id": 2391, "verse_number": "९-९-६२", "content_sanskrit": "यथा देवासुरं युद्धं पूर्वमासीद्विशाम्पते।\nअभीतानां तथाऽऽसीत्तद्यमराष्ट्रविवर्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2065837, "chapter_id": 2391, "verse_number": "९-९-६३", "content_sanskrit": "ततः कपिध्वजो राजन्हत्वा संशप्तकान्रणे।\nअभ्यद्रवत तां सेनां कौरवीं पाण्डुनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2065838, "chapter_id": 2391, "verse_number": "९-९-६४", "content_sanskrit": "तथैव पाण्डवाः सर्वे धृष्टद्युम्नपुरोगमाः।\nअभ्यधावन्ततां सेनां विसृजन्तः शिताञ्शरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2065839, "chapter_id": 2391, "verse_number": "९-९-६५", "content_sanskrit": "पाण्डवैरवकीर्णानां सम्मोहः समजायत।\nन च जज्ञुस्त्वनीकानि दिशो वा विदिशस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2065840, "chapter_id": 2391, "verse_number": "९-९-६६", "content_sanskrit": "आपूर्यमाणा निशितैः शरैः पाण्डवचोदितैः।\nहतप्रवीरा विध्वस्ता वार्यमाणा समन्ततः।\nकौरव्यवध्यत चमूः पाण्डुपुत्रैर्महारथैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2065841, "chapter_id": 2391, "verse_number": "९-९-६७", "content_sanskrit": "तथैव पाण्डवं सैन्यं शरै राजन्समन्ततः।\nरणेऽहन्यत पुत्रैस्ते शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2065842, "chapter_id": 2391, "verse_number": "९-९-६८", "content_sanskrit": "ते सेने भृशसन्तप्ते वध्यमाने परस्परम्।\nव्याकुले समपद्येतां वर्षासु सरिताविव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2065843, "chapter_id": 2391, "verse_number": "९-९-६९", "content_sanskrit": "आविवेश ततस्तीव्रं तावकानां महद्भयम्।\nपाण्डवानां च राजेन्द्र तथाभूते महाहवे॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2065844, "chapter_id": 2391, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारतेयथा शल्यपर्वणि शल्यवधपर्वणि अष्टादशदिवसयुद्धे नवमोऽध्यायः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]