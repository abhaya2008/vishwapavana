[{"id": 6000134000, "chapter_id": 10134, "verse_number": null, "content_sanskrit": "अथ पञ्चदशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "topics": [{"text": "नारदाङ्गिरोभ्यां चित्रकेतोः सकाशमेत्य तत्त्वोपदेशेन तस्य पुत्रशोकापनोदनम्", "range": null}]}, {"id": 6000134001, "chapter_id": 10134, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.001.m4a", "display_order": 2}, {"id": 6000134002, "chapter_id": 10134, "verse_number": "६-१५-१", "content_sanskrit": "ऊचतुर्मृतकोपान्ते पतितं मृतकोपमम्।\nशोकाभिभूतं राजानं बोधयन्तौ सदुक्तिभिः॥ ६/१५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.002.m4a", "display_order": 3}, {"id": 6000134003, "chapter_id": 10134, "verse_number": "६-१५-२", "content_sanskrit": "कोऽयं स्यात् तव राजेन्द्र भवान् यमनुशोचति।\nत्वं चास्य कतमः सृष्टौ पुरेदानीमतः परम्॥ ६/१५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.003.m4a", "display_order": 4}, {"id": 6000134004, "chapter_id": 10134, "verse_number": "६-१५-३", "content_sanskrit": "यथा प्रयान्ति संयान्ति स्रोतोवेगेन वालुकाः।\nसंयुज्यन्ते वियुज्यन्ते तथा कालेन देहिनः॥ ६/१५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.004.m4a", "display_order": 5}, {"id": 6000134005, "chapter_id": 10134, "verse_number": "६-१५-४", "content_sanskrit": "यथा धानासु वै धाना भवन्ति न भवन्ति च।\nएवं भूतेषु भूतानि चोदितानीशमायया॥ ६/१५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.005.m4a", "display_order": 6}, {"id": 6000134006, "chapter_id": 10134, "verse_number": "६-१५-५", "content_sanskrit": "वयं च त्वं च ये चेमे तुल्यकालाश्चराचराः।\nजन्ममृत्योर्यथा पश्चात् प्रागेवमधुना विभो॥ ६/१५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.006.m4a", "display_order": 7}, {"id": 6000134007, "chapter_id": 10134, "verse_number": "६-१५-६", "content_sanskrit": "भूतैर्भूतानि भूतेशः सृजत्यवति हन्त्यजः।\nआत्मसृष्टैरस्वतन्त्रैरनपेक्षोऽपि बालवत्॥ ६/१५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.007.m4a", "display_order": 8}, {"id": 6000134008, "chapter_id": 10134, "verse_number": "६-१५-७", "content_sanskrit": "देहेन देहिनो राजन् देहाद् देहोऽभिजायते।\nबीजादेव यथा बीजं देह्यर्थ इव शाश्वतः॥ ६/१५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.008.m4a", "display_order": 9}, {"id": 6000134009, "chapter_id": 10134, "verse_number": "६-१५-८", "content_sanskrit": "देहदेह्यविभागोऽयमविवेककृतः पुरा।\nजातिव्यक्तिविभागोऽयं यथा वस्तुनि कल्पितः॥ ६/१५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.009.m4a", "display_order": 10}, {"id": 6000134010, "chapter_id": 10134, "verse_number": "६-१५-९", "content_sanskrit": "नानात्वं जन्मनाशश्च क्षयो वृद्धिः क्रियाफलम्।\nद्रष्टुश्च भान्त्यतद्धर्मा यथाऽग्नेर्दाह्यविक्रियाः॥ ६/१५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.010.m4a", "display_order": 11}, {"id": 6000134011, "chapter_id": 10134, "verse_number": "६-१५-१०", "content_sanskrit": "त इमे देहसंयोगाद् आत्मन्याभान्त्यसद्ग्रहात्।\nस्वप्ने यथा तथा नान्यद् ध्यायेत् सर्वं भयं च यत्॥ ६/१५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.011.m4a", "display_order": 12}, {"id": 6000134012, "chapter_id": 10134, "verse_number": "६-१५-११", "content_sanskrit": "प्रसुप्तस्यानहम्मानान्न घोरा भाति संसृतिः।\nजानतोऽपि यथा तद्वद् विमुक्तस्यानहम्मतेः॥ ६/१५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.012.m4a", "display_order": 13}, {"id": 6000134013, "chapter_id": 10134, "verse_number": "६-१५-१२", "content_sanskrit": "तस्मादन्यन्मनोमात्रं जह्यहम्ममतातमः।\nवासुदेवे भगवति मनो धेह्यात्मनीश्वरे॥ ६/१५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.013.m4a", "display_order": 14}, {"id": 6000134014, "chapter_id": 10134, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.014.m4a", "display_order": 15}, {"id": 6000134015, "chapter_id": 10134, "verse_number": "६-१५-१३", "content_sanskrit": "एवमाश्वासितो राजा चित्रकेतुर्द्विजोक्तिभिः।\nविमृज्य पाणिना वक्त्रमाधिम्लानमभाषत॥ ६/१५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.015.m4a", "display_order": 16}, {"id": 6000134016, "chapter_id": 10134, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.016.m4a", "display_order": 17}, {"id": 6000134017, "chapter_id": 10134, "verse_number": "६-१५-१४", "content_sanskrit": "कौ युवां ज्ञानसंपन्नौ महिष्ठौ च महीयसाम्।\nअवधूतेन वेषेण गूढाविह समागतौ॥ ६/१५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.017.m4a", "display_order": 18}, {"id": 6000134018, "chapter_id": 10134, "verse_number": "६-१५-१५", "content_sanskrit": "चरन्ति ह्यवनौ कामं ब्राह्मणा भगवत्प्रियाः।\nमादृशां ग्राम्यबुद्धीनां बोधायोन्मत्तलिङ्गिनः॥ ६/१५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.018.m4a", "display_order": 19}, {"id": 6000134019, "chapter_id": 10134, "verse_number": "६-१५-१६", "content_sanskrit": "कुमारो नारद ऋभुरङ्गिरा देवलोऽसितः।\nअपान्तरतमो व्यासो मार्कण्डेयोऽथ गौतमः॥ ६/१५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.019.m4a", "display_order": 20}, {"id": 6000134020, "chapter_id": 10134, "verse_number": "६-१५-१७", "content_sanskrit": "वसिष्ठो भगवान् रामः कपिलो बादरायणिः।\nदूर्वासा याज्ञवल्क्यश्च जातूकर्ण्यस्तथाऽऽरुणिः॥ ६/१५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.020.m4a", "display_order": 21}, {"id": 6000134021, "chapter_id": 10134, "verse_number": "६-१५-१८", "content_sanskrit": "रोमशश्च्यवनो दत्त आसुरिः सपतञ्जलिः। पराशरोऽथ मैत्रेयो भरद्वाजश्च आरुणः।\nऋषिर्वेदशिरा बोध्यो मुनिः पञ्चशिखस्तथा॥ ६/१५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.021.m4a", "display_order": 22}, {"id": 6000134022, "chapter_id": 10134, "verse_number": "६-१५-१९", "content_sanskrit": "हिरण्यनाभः कौशल्यः श्रुतदेवः क्रतुध्वजः।\nएते परे च सिद्धेशाश्चरन्ति ज्ञानहेतवः॥ ६/१५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.022.m4a", "display_order": 23}, {"id": 6000134023, "chapter_id": 10134, "verse_number": "६-१५-२०", "content_sanskrit": "तस्माद् युवां ग्राम्यपशोर्मम मुग्धधियः प्रभू।\nअन्धे तमसि मग्नस्य ज्ञानदीप उदीर्यताम्॥ ६/१५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.023.m4a", "display_order": 24}, {"id": 6000134024, "chapter_id": 10134, "verse_number": null, "content_sanskrit": "अङ्गिरा उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.024.m4a", "display_order": 25}, {"id": 6000134025, "chapter_id": 10134, "verse_number": "६-१५-२१", "content_sanskrit": "अहं ते पुत्रकामस्य पुत्रदोऽस्म्यङ्गिरा नृप।\nएष ब्रह्मसुतस्साक्षान्नारदो भगवान् ऋषिः॥ ६/१५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.025.m4a", "display_order": 26}, {"id": 6000134026, "chapter_id": 10134, "verse_number": "६-१५-२२", "content_sanskrit": "इत्थं त्वां पुत्रशोकेन मग्नं तमसि दुस्तरे।\nअतदर्हमनुस्मृत्य महापुरुषगोचरम्॥ ६/१५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.026.m4a", "display_order": 27}, {"id": 6000134027, "chapter_id": 10134, "verse_number": "६-१५-२३", "content_sanskrit": "अनुग्रहाद् भगवतः प्राप्तावावामिह प्रभो।\nब्रह्मण्यो भगवद्भक्तो नावसीदितुमर्हति॥ ६/१५/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.027.m4a", "display_order": 28}, {"id": 6000134028, "chapter_id": 10134, "verse_number": "६-१५-२४", "content_sanskrit": "तदैव ते परं ज्ञानं ददामि गृहमागतः।\nज्ञात्वाऽन्याभिनिवेशं ते पुत्रमेवाददामहम्॥ ६/१५/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.028.m4a", "display_order": 29}, {"id": 6000134029, "chapter_id": 10134, "verse_number": "६-१५-२५", "content_sanskrit": "अधुना पुत्रिणां तापो भवतैवानुभूयते।\nएवं दारा गृहा रायो विविधैश्वर्यसम्पदः॥ ६/१५/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.029.m4a", "display_order": 30}, {"id": 6000134030, "chapter_id": 10134, "verse_number": "६-१५-२६", "content_sanskrit": "शब्दादयश्च विषयाश्चला राजन् विभूतयः।\nराज्यं मही बलं कोशो भृत्यामात्यसुहृज्जनाः॥ ६/१५/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.030.m4a", "display_order": 31}, {"id": 6000134031, "chapter_id": 10134, "verse_number": "६-१५-२७", "content_sanskrit": "सर्वेऽपि शूरसेनेमे शोकमोहभयार्तिदाः।\nगन्धर्वनगरप्रख्याः स्वप्नमायामनोरथाः॥ ६/१५/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.031.m4a", "display_order": 32}, {"id": 6000134032, "chapter_id": 10134, "verse_number": "६-१५-२८", "content_sanskrit": "दृश्यमाना विनाऽर्थेन न दृश्यन्ते मनोभवाः।\nकर्माभिध्यायतो नाना कर्माणि मनसोऽभवन्॥ ६/१५/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.032.m4a", "display_order": 33}, {"id": 6000134033, "chapter_id": 10134, "verse_number": "६-१५-२९", "content_sanskrit": "अयं हि देहिनो देहो द्रव्यज्ञानक्रियात्मकः।\nदेहिनो विविधक्लेशसन्तापकृदुदाहृतः॥ ६/१५/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.033.m4a", "display_order": 34}, {"id": 6000134034, "chapter_id": 10134, "verse_number": "६-१५-३०", "content_sanskrit": "तस्मात् स्वस्थेन मनसा विमृश्य गतिमात्मनः।\nद्वैते ध्रुवार्थविस्रम्भं त्यजोपशममाविश॥ ६/१५/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.034.m4a", "display_order": 35}, {"id": 6000134035, "chapter_id": 10134, "verse_number": "६-१५-३१", "content_sanskrit": "भोजो नाम नृपः स्वप्ने शत्रुग्रस्तान्नभोजनः।\nदुःखं दुर्विषहं प्राप्तः शोकमोहभयार्दितः॥ ६/१५/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.035.m4a", "display_order": 36}, {"id": 6000134036, "chapter_id": 10134, "verse_number": "६-१५-३२", "content_sanskrit": "केचिद् विलुलुपुर्भोगानपरेऽवधिषुः श्रितान्।\nपूर्ववैरग्रहैर्जाया अन्य आत्मशिरोऽहरन्॥ ६/१५/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.036.m4a", "display_order": 37}, {"id": 6000134037, "chapter_id": 10134, "verse_number": "६-१५-३३", "content_sanskrit": "इत्थं दुरन्तदुःखौघादुत्थितस्तदनुस्मरन्।\nतावद् भृशं सुनिर्विण्णो निर्जगाम ततो गृहात्॥ ६/१५/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.037.m4a", "display_order": 38}, {"id": 6000134038, "chapter_id": 10134, "verse_number": "६-१५-३४", "content_sanskrit": "दर्शयन्नात्मनाऽऽत्मानं निस्सङ्गः शान्तविग्रहः।\nप्रविष्टो ब्रह्म निर्वाणं कुलायं नाविदच्च तम्॥ ६/१५/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.038.m4a", "display_order": 39}, {"id": 6000134039, "chapter_id": 10134, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.039.m4a", "display_order": 40}, {"id": 6000134040, "chapter_id": 10134, "verse_number": "६-१५-३५", "content_sanskrit": "इमां मन्त्रोपनिषदं प्रतीच्छ प्रयतो मम।\nयां धारयन् सप्तरात्राद् द्रष्टा सङ्कर्षणं विभुम्॥ ६/१५/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.040.m4a", "display_order": 41}, {"id": 6000134041, "chapter_id": 10134, "verse_number": "६-१५-३६", "content_sanskrit": "यत्पादमूलमुपसृत्य नरेन्द्र पूर्वे शर्वादयो भ्रममिमं द्वितयं विसृज्य।\nसद्यस्तदीयमतुलानधिकं महित्वं प्रापुर्भवानपि परं न चिरादुपैति॥ ६/१५/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_015/BhP_06.015.041.m4a", "display_order": 42}, {"id": 6000134042, "chapter_id": 10134, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां षष्ठस्कन्धे पञ्चदशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]