[{"id": 7000419000, "chapter_id": 20419, "verse_number": "२-९१-१", "content_sanskrit": "कुंजलौवाच ।\nब्रह्महत्याभिभूतस्तु सहस्राक्षो यदा पुरा ।\nगौतमस्य प्रियासंगादगम्यागमनं महत्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000419001, "chapter_id": 20419, "verse_number": "२-९१-२", "content_sanskrit": "संजातं पातकं तस्य त्यक्तो देवैश्च ब्राह्मणैः ।\nसहस्राक्षस्तपस्तेपे निरालंबो निराश्रयः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000419002, "chapter_id": 20419, "verse_number": "२-९१-३", "content_sanskrit": "तपोंते देवताः सर्वा ऋषयो यक्षकिन्नराः ।\nदेवराजस्य पूजार्थमभिषेकं प्रचक्रिरे॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000419003, "chapter_id": 20419, "verse_number": "२-९१-४", "content_sanskrit": "देशं मालवकं नीत्वा देवराजं सुतोत्तम ।\nचक्रे स्नानं महाभाग कुंभैरुदकपूरितैः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000419004, "chapter_id": 20419, "verse_number": "२-९१-५", "content_sanskrit": "स्नापितुं प्रथमं नीतो वाराणस्यां स्वयं ततः ।\nप्रयागे तु सहस्राक्ष अर्घतीर्थे ततः पुनः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000419005, "chapter_id": 20419, "verse_number": "२-९१-६", "content_sanskrit": "पुष्करेण महात्मासौ स्नापितः स्वयमेव हि ।\nब्रह्मादिभिः सुरैः सर्वैर्मुनिवृंदैर्द्विजोत्तम॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000419006, "chapter_id": 20419, "verse_number": "२-९१-७", "content_sanskrit": "नागैर्वृक्षैर्नागसर्पैर्गंधर्वैस्तु सकिन्नरैः ।\nस्नापितो देवराजस्तु वेदमंत्रैः सुसंस्कृतः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000419007, "chapter_id": 20419, "verse_number": "२-९१-८", "content_sanskrit": "मुनिभिः सर्वपापघ्नैस्तस्मिन्काले द्विजोत्तम ।\nशुद्धे तस्मिन्महाभागे सहस्राक्षे महात्मनि॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000419008, "chapter_id": 20419, "verse_number": "२-९१-९", "content_sanskrit": "ब्रह्महत्या गता तस्य अगम्यागमनं तथा ।\nब्रह्महत्या ततो नष्टा अगम्यागमनेन च॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000419009, "chapter_id": 20419, "verse_number": "२-९१-१०", "content_sanskrit": "पापेन तेन घोरेण सार्द्धमिंद्रस्य भूतले ।\nसुप्रसन्नः सहस्राक्षस्तीर्थेभ्यो हि वरं ददौ॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000419010, "chapter_id": 20419, "verse_number": "२-९१-११", "content_sanskrit": "भवंतस्तीर्थराजानो भविष्यथ न संशयः ।\nमत्प्रसादात्पवित्राश्च यस्मादहं विमोक्षितः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000419011, "chapter_id": 20419, "verse_number": "२-९१-१२", "content_sanskrit": "सुघोरात्किल्बिषादत्र युष्माभिर्विमलैरहम् ।\nएवं तेभ्यो वरं दत्वा मालवाय वरं ददौ॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000419012, "chapter_id": 20419, "verse_number": "२-९१-१३", "content_sanskrit": "यस्मात्त्वया मलं मेऽद्य विधृतं श्रमदायकम् ।\nतस्मात्त्वमन्नपानैश्च धनधान्यैरलंकृतः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000419013, "chapter_id": 20419, "verse_number": "२-९१-१४", "content_sanskrit": "भविष्यसि न संदेहो मत्प्रसादान्न संशयः ।\nसुदुःकालैर्विना त्वं तु भविष्यसि सुपुण्यवान्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000419014, "chapter_id": 20419, "verse_number": "२-९१-१५", "content_sanskrit": "एवं तस्मै वरं दत्वा देवराजः पुरंदरः ।\nक्षेत्राणि सर्वतीर्थानि देशो मालवकस्तथा॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000419015, "chapter_id": 20419, "verse_number": "२-९१-१६", "content_sanskrit": "आखंडलेन सार्द्धं ते स्वस्थानं प्रतिजग्मिरे ।\nसूत उवाच ।\nतदाप्रभृति चत्वारः प्रयागः पुष्करस्तथा॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000419016, "chapter_id": 20419, "verse_number": "२-९१-१७", "content_sanskrit": "वाराणसी चार्घतीर्थं प्राप्ता राजत्वमुत्तमम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000419017, "chapter_id": 20419, "verse_number": "२-९१-१८", "content_sanskrit": "कुंजल उवाच ।\nअस्ति पंचालदेशेषु विदुरो नाम क्षत्रियः ।\nतेन मोहप्रसंगेन ब्राह्मणो निहतः पुराः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000419018, "chapter_id": 20419, "verse_number": "२-९१-१९", "content_sanskrit": "शिखासूत्रविहीनस्तु तिलकेन विवर्जितः ।\nभिक्षार्थमटतेसोऽपि ब्रह्मघ्नोहं समागतः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000419019, "chapter_id": 20419, "verse_number": "२-९१-२०", "content_sanskrit": "ब्रह्मघ्नाय सुरापाय भिक्षा चान्नं प्रदीयताम् ।\nगृहेष्वेवं समस्तेषु भ्रमते याचते पुरा॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000419020, "chapter_id": 20419, "verse_number": "२-९१-२१", "content_sanskrit": "एवं सर्वेषु तीर्थेषु अटित्वैव समागतः ।\nब्रह्महत्या न तस्यापि प्रयाति द्विजसत्तम॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000419021, "chapter_id": 20419, "verse_number": "२-९१-२२", "content_sanskrit": "वृक्षच्छायां समाश्रित्यदह्यमानेन चेतसा ।\nसंस्थितो विदुरः पापो दुःखशोकसमन्वितः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000419022, "chapter_id": 20419, "verse_number": "२-९१-२३", "content_sanskrit": "चंद्रशर्मा ततो विप्रो महामोहेन पीडितः ।\nन्यवसन्मागधे देशे गुरुघातकरश्च सः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000419023, "chapter_id": 20419, "verse_number": "२-९१-२४", "content_sanskrit": "स्वजनैर्बंधुवर्गैश्च परित्यक्तो दुरात्मवान् ।\nस हि तत्र समायातो यत्रासौ विदुरः स्थितः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000419024, "chapter_id": 20419, "verse_number": "२-९१-२५", "content_sanskrit": "शिखासूत्रविहीनस्तु विप्रलिंगैर्विवर्जितः ।\nतदासौ पृच्छितस्तेन विदुरेण दुरात्मना॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000419025, "chapter_id": 20419, "verse_number": "२-९१-२६", "content_sanskrit": "भवान्को हि समायातोः दुर्भगो दग्धमानसः ।\nविप्रलिंगविहीनस्तु कस्मात्त्वं भ्रमसे महीम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000419026, "chapter_id": 20419, "verse_number": "२-९१-२७", "content_sanskrit": "विदुरेणोक्तमात्रस्तु चंद्रशर्मा द्विजाधमः ।\nआचष्टे सर्वमेवापि यथापूर्वकृतं स्वकम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000419027, "chapter_id": 20419, "verse_number": "२-९१-२८", "content_sanskrit": "पातकं च महाघोरं वसता च गुरोर्गृहे ।\nमहामोहगतेनापि क्रोधेनाकुलितेन च॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000419028, "chapter_id": 20419, "verse_number": "२-९१-२९", "content_sanskrit": "गुरोर्घातः कृतः पूर्वं तेन दग्धोस्मि सांप्रतम् ।\nचंद्रशर्मा च वृत्तांतमुक्त्वा सर्वमपृच्छत॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000419029, "chapter_id": 20419, "verse_number": "२-९१-३०", "content_sanskrit": "भवान्को हि सुदुःखात्मा वृक्षच्छायां समाश्रितः ।\nविदुरेण समासेन आत्मपापं निवेदितम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000419030, "chapter_id": 20419, "verse_number": "२-९१-३१", "content_sanskrit": "अथ कश्चिद्द्विजः प्राप्तस्तृतीयः श्रमकर्षितः ।\nवेदशर्मेति वै नाम बहुपातकसंचयः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000419031, "chapter_id": 20419, "verse_number": "२-९१-३२", "content_sanskrit": "द्वाभ्यामपि सुसंपृष्टः को भवान्दुःखिताकृतिः ।\nकस्माद्भ्रमसि वै पृथ्वीं वद भावं त्वमात्मनः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000419032, "chapter_id": 20419, "verse_number": "२-९१-३३", "content_sanskrit": "वेदशर्मा ततः सर्वमात्मचेष्टितमेव च ।\nकथयामास ताभ्यां वै ह्यगम्यागमनं कृतम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000419033, "chapter_id": 20419, "verse_number": "२-९१-३४", "content_sanskrit": "धिक्कृतः सर्वलोकैश्च अन्यैः स्वजनबांधवैः ।\nतेन पापेन संलिप्तो भ्रमाम्येवं महीमिमाम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000419034, "chapter_id": 20419, "verse_number": "२-९१-३५", "content_sanskrit": "वंजुलो नाम वैश्योथ सुरापायी समागतः ।\nस गोघ्नश्च विशेषेण तैश्च पृष्टो यथा पुरा॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000419035, "chapter_id": 20419, "verse_number": "२-९१-३६", "content_sanskrit": "तेन आवेदितं सर्वं पातकं यत्पुराकृतम् ।\nतैराकर्णितमन्यैश्च सर्वं तस्यप्रभाषितम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000419036, "chapter_id": 20419, "verse_number": "२-९१-३७", "content_sanskrit": "एवं चत्वारःपापिष्ठा एकस्थानं समागताः ।\nकः कस्यापि न संपर्कं भोजनाच्छादनेन च॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000419037, "chapter_id": 20419, "verse_number": "२-९१-३८", "content_sanskrit": "करोति च महाभाग वार्तां चक्रुः परस्परम् ।\nन विशंत्यासने चैके न स्वपंत्येकसंस्तरे॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000419038, "chapter_id": 20419, "verse_number": "२-९१-३९", "content_sanskrit": "एवं दुःखसमाविष्टा नानातीर्थेषु वै गताः ।\nतेषां तु पापका घोरा न नश्यंति च नंदन॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000419039, "chapter_id": 20419, "verse_number": "२-९१-४०", "content_sanskrit": "सामर्थ्यं नास्ति तीर्थानां महापातकनाशने ।\nविदुराद्यास्ततस्ते तु गताः कालंजरं गिरिम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]