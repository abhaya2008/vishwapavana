[{"id": 900008998, "chapter_id": 8719, "verse_number": "9.1", "content_sanskrit": "ननु– स्वरूपसहकार्यतिरिक्तशक्तौ मानं नेति चेन्न", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900008999, "chapter_id": 8719, "verse_number": "9.2", "content_sanskrit": "न च दृष्टसामग्र्या: सत्त्वेपि मणिरेव..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900009000, "chapter_id": 8719, "verse_number": "9.3", "content_sanskrit": "नापि मणिना दाहप्रतिपक्षादृष्टजननाद्दाहविलम्बः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900009001, "chapter_id": 8719, "verse_number": "9.4", "content_sanskrit": "अत्र नैयायिकाः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900009002, "chapter_id": 8719, "verse_number": "9.5", "content_sanskrit": "किञ्च कार्यानुत्पत्तिव्याप्यत्वं प्रतिबन्धकत्वमिति पक्षे ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900009003, "chapter_id": 8719, "verse_number": "9.6", "content_sanskrit": "उच्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900009004, "chapter_id": 8719, "verse_number": "9.7", "content_sanskrit": "न चेयं स्वरूपमात्रपरा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900009005, "chapter_id": 8719, "verse_number": "9.8", "content_sanskrit": "किञ्च दण्डादेरन्वयव्यातिरेकाभ्यां घटादिकारणत्वं तावदनुमीयते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900009006, "chapter_id": 8719, "verse_number": "9.9", "content_sanskrit": "न च व्यभिचरितं सहचारदर्शनं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900009007, "chapter_id": 8719, "verse_number": "9.10", "content_sanskrit": "किञ्चानन्यथासिद्धनियतपूर्ववृत्तित्वमेव कारणत्वं चेद्..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900009008, "chapter_id": 8719, "verse_number": "9.11", "content_sanskrit": "नन्वेवं शक्तिः कारणत्वं चेत्सा कारणं न स्यात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900009009, "chapter_id": 8719, "verse_number": "9.12", "content_sanskrit": "किञ्चैवमुत्तेजकाभावविशिष्टमण्यभावस्य हेतुत्वं स्वीकृत्य..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900009010, "chapter_id": 8719, "verse_number": "9.13", "content_sanskrit": "अपिच यत्र देवदत्तादिशरीरं प्रत्यक्षेण गृहीतं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900009011, "chapter_id": 8719, "verse_number": "9.14", "content_sanskrit": "ननु शक्तिपक्षे प्रतिबन्धकेन पूर्वस्याः शक्तेर्नाशात् ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900009012, "chapter_id": 8719, "verse_number": "9.15", "content_sanskrit": "किञ्चास्तु त्वया वक्ष्यमाणे पक्षचतुष्टये..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900009013, "chapter_id": 8719, "verse_number": "9.16", "content_sanskrit": "किञ्च मण्याद्यभावस्य कारणत्वे मणेः प्रतिबन्धकत्वमपि न स्यात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900009014, "chapter_id": 8719, "verse_number": "9.17", "content_sanskrit": "किञ्च त्वन्मते विशिष्टं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900009015, "chapter_id": 8719, "verse_number": "9.18", "content_sanskrit": "ननु तर्हि स्वरूपेण विद्यमानस्यैव ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900009016, "chapter_id": 8719, "verse_number": "9.19", "content_sanskrit": "किञ्चास्यैव मणेरुत्तेजकात्पूर्वमुत्तेजकाभावविशिष्टतया ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900009017, "chapter_id": 8719, "verse_number": "9.20", "content_sanskrit": "अपि चैवं रक्ततादशायां घटस्य ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900009018, "chapter_id": 8719, "verse_number": "9.21", "content_sanskrit": "किञ्च प्रतियोगिसत्त्वकालेऽपि सन्नयमभावो न..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900009019, "chapter_id": 8719, "verse_number": "9.22", "content_sanskrit": "नाप्ययमुत्पादविनाशशीलस्तुरीयोऽभावः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900009020, "chapter_id": 8719, "verse_number": "9.23", "content_sanskrit": "ननु तर्हि मण्युत्तम्भकोभयसत्त्वकाले..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900009021, "chapter_id": 8719, "verse_number": "9.24", "content_sanskrit": "ननु भवेदिदं यद्युत्तम्भकसहितमण्यादिकाले..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900009022, "chapter_id": 8719, "verse_number": "9.25", "content_sanskrit": "केचित्तु संशयोत्तरप्रत्यक्षं प्रति विशेषदर्शनमिव..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900009023, "chapter_id": 8719, "verse_number": "9.26", "content_sanskrit": "किञ्च शक्त्यभावे तृणारणिमणीनां..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 900009024, "chapter_id": 8719, "verse_number": "9.27", "content_sanskrit": "तृणादिजन्यवह्नौ हि जातिविशेषः न तावत्प्रदीपे..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 900009025, "chapter_id": 8719, "verse_number": "9.28", "content_sanskrit": "किञ्च सम्भवत्येकसामग्रीत्वे सामग्रीत्रयकल्पने गौरवम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 900009026, "chapter_id": 8719, "verse_number": "9.29", "content_sanskrit": "अथ तत्रोपस्थितेन धूमत्वेनैव वह्निकार्यता बाधकाभावात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 900009027, "chapter_id": 8719, "verse_number": "9.30", "content_sanskrit": "किञ्च यद्यादावेव तृणत्वस्य कारणतावच्छेदकता..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 900009028, "chapter_id": 8719, "verse_number": "9.31", "content_sanskrit": "ननु वह्निजनने तृणस्यैव फूत्कारः सहकारी..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 900009029, "chapter_id": 8719, "verse_number": "9.32", "content_sanskrit": "किञ्च, (१) संसार्यात्मा ...", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 900009030, "chapter_id": 8719, "verse_number": "9.33", "content_sanskrit": "द्वितीयानुमाने दाहानुकूलपदं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 900009031, "chapter_id": 8719, "verse_number": "9.34", "content_sanskrit": "न चाचाक्षुषद्रव्यत्वमुपाधिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 900009032, "chapter_id": 8719, "verse_number": "9.35", "content_sanskrit": "ननु तथाऽपि बीजादावङ्कुरानुकूलशक्तिवच्छक्त्यनुकूला शक्तिरपि-स्वीकार्या.", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 900009033, "chapter_id": 8719, "verse_number": "9.36", "content_sanskrit": "एवमाधेयशक्तिरपि स्वीकार्या", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 900009034, "chapter_id": 8719, "verse_number": "9.37", "content_sanskrit": "न च प्रोक्षणजन्यजलसंयोग एव व्रीहिनिष्ठोऽतिशयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 900009035, "chapter_id": 8719, "verse_number": "9.38", "content_sanskrit": "किञ्चैवं व्रीहीणामपि प्राप्यकर्मत्वे संस्कार्यकर्मत्वाभावेन..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 900009036, "chapter_id": 8719, "verse_number": "9.39", "content_sanskrit": "किञ्चैवं परमतेऽपि प्रोक्षणजन्यमात्मनिष्ठमपूर्वं कल्प्यं स्यात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 900009037, "chapter_id": 8719, "verse_number": "9.40", "content_sanskrit": "न च ग्रामं गच्छामि, घटं जानामि, अतीतं जानामीत्यादौ व्यभिचारः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 900009038, "chapter_id": 8719, "verse_number": "9.41", "content_sanskrit": "न च संस्काराणां प्रतिव्रीहि नानात्वे गौरवम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 900009039, "chapter_id": 8719, "verse_number": "9.42", "content_sanskrit": "किञ्च त्वन्मते जीवन्मुक्तावनुष्ठितप्रोक्षणादिनाऽदृष्टाजननात् कथं तस्य भाव्युपयोगः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 900009040, "chapter_id": 8719, "verse_number": "9.43", "content_sanskrit": "किञ्च प्रोक्षणादेरपूर्वजनकत्वे दर्शादिवत्प्रधनकर्मत्वं वा..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]