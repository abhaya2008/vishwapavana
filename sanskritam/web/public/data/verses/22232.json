[{"id": 7002232000, "chapter_id": 22232, "verse_number": "२७७-१", "content_sanskrit": "अग्निरुवाच ।\nतुर्व्वसोश्च सुतो वर्गो गोभानुस्तस्य चात्मजः ।\nगोभानोरासीत् त्रैशानिस्त्रैशानेस्तु करन्धमः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002232001, "chapter_id": 22232, "verse_number": "२७७-२", "content_sanskrit": "करन्धमान्मरुत्तोभूऽद्दुष्मन्तस्तस्य चात्मजः ।\nदुष्मन्तस्य वरूथोऽभूद्गाण्डीरस्तु वरूथतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002232002, "chapter_id": 22232, "verse_number": "२७७-३", "content_sanskrit": "गाण्डीराच्चैव गान्धारः पञ्च जानपदास्ततः ।\nगान्धाराः केरलाश्चोलाः पाण्ड्याः कोला महाबलाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002232003, "chapter_id": 22232, "verse_number": "२७७-४", "content_sanskrit": "द्रुह्यस्तु वभ्रुसेतुश्च वभ्रुसेतोः पुरोवसुः ।\nततो गान्धारा गान्धारैर्घर्म्मो घर्म्माद् घृतोऽभवत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002232004, "chapter_id": 22232, "verse_number": "२७७-५", "content_sanskrit": "घृतात्तु विदुषस्तस्मात् प्रचेतास्तस्य वै शतम् ।\nआनद्रश्च सभानरश्चाक्षुपः परमेषुकः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002232005, "chapter_id": 22232, "verse_number": "२७७-६", "content_sanskrit": "सभानरात् कालानलः कालानलजसृञ्जयः ।\nपुरञ्जयः सृञ्जयस्य तत्पुत्रो जनमेजयः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002232006, "chapter_id": 22232, "verse_number": "२७७-७", "content_sanskrit": "तत्पुत्रस्तु महाशालस्तुत्पुत्रोऽभून्महामनाः ।\nतस्मादुशीनरो ब्रह्मन्नृगायान्तु तृगस्ततः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002232007, "chapter_id": 22232, "verse_number": "२७७-८", "content_sanskrit": "नरायान्तु नरश्चासीत् कृमिस्तु कृमितः सुतः ।\nदशायां सुब्रतो जज्ञे दृशद्वत्यां शिविस्तथा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002232008, "chapter_id": 22232, "verse_number": "२७७-९", "content_sanskrit": "शिवेः पुत्त्रास्तु चत्वारः पृथुदर्भश्च वीरकः ।\nकैकेयो भद्रकस्तेषां नाम्ना जनपदाः शुभाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002232009, "chapter_id": 22232, "verse_number": "२७७-१०", "content_sanskrit": "तितिक्षुरुशीनरजस्तितिक्षोस्च रुषद्रयः ।\nरुषद्रथादभूत्पैलः पैलाच्च सुतपाः सुतः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002232010, "chapter_id": 22232, "verse_number": "२७७-११", "content_sanskrit": "महायोगी बलिस्तस्मादह्गो वङ्गश्च मुख्यकः ।\nपुण्डुः कलिङ्गो बालोयो बलिर्योगी बलान्वितः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002232011, "chapter_id": 22232, "verse_number": "२७७-१२", "content_sanskrit": "अङ्गाद्दधिवाहनोऽभूत तस्माद्दिविरथो नृपः ।\nदिविरथाद्धर्म्मरथस्तस्य चित्ररथः सुतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002232012, "chapter_id": 22232, "verse_number": "२७७-१३", "content_sanskrit": "चित्ररथात्सत्यरथो लोमपादश्च तत्सुतः ।\nलोमपादाच्चतुरङ्गः पृथुलाक्षश्च तत्सुतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002232013, "chapter_id": 22232, "verse_number": "२७७-१४", "content_sanskrit": "पृथुलाक्षाच्च चम्पोऽभूच्चम्पाद्धर्य्यङ्गकोऽभवत् ।\nहर्य्यङ्गाच्च भद्ररथो बृहत्कर्म्मा च तत्सुतः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002232014, "chapter_id": 22232, "verse_number": "२७७-१५", "content_sanskrit": "तस्मादभूद्वॄहद्भानुर्वृहद्भानोर्बृहात्मवान् ।\nतस्माज्जयद्रथो ह्यासीज्जयद्रथाद्वृहद्रथः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002232015, "chapter_id": 22232, "verse_number": "२७७-१६", "content_sanskrit": "वृहद्रथाद्विश्वजिच्च कर्णो विश्वजितोऽभवत् ।\nकर्णस्य वृषसेनस्तु पृथुसेनस्तदात्मजः ।\nएतेऽङ्गवंशजा भूपाः पूरोर्वंशं निबोध मे ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]