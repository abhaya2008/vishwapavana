[{"id": 2213101, "chapter_id": 5547, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2213102, "chapter_id": 5547, "verse_number": "१", "content_sanskrit": "कुन्त्यास्तु वचनं श्रुत्वा पाण्डवा राजसत्तम ।\nव्रीडिताः सन्न्यवर्तन्त पाञ्चाल्या सह भारत\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2213103, "chapter_id": 5547, "verse_number": "२", "content_sanskrit": "ततः शब्दो महानासीत् सर्वेषामेव भारत ।\nअन्तःपुराणां रुदतां दृष्ट्वा कुन्तीं तथा गताम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2213104, "chapter_id": 5547, "verse_number": "३", "content_sanskrit": "प्रदक्षिणमुपावृत्त्य राजानं पाण्डवास्तदा ।\nअभिवाद्य निवर्तन्त पृथां तामनिवर्त्य ते\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2213105, "chapter_id": 5547, "verse_number": "४", "content_sanskrit": "तामब्रवीन्महाराजो धृतराष्ट्रोऽम्बिकासुतः ।\nगान्धारीं विदुरं चैव समाभाष्य निगृह्य च\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2213106, "chapter_id": 5547, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2213107, "chapter_id": 5547, "verse_number": "५", "content_sanskrit": "युधिष्ठिरस्य जननी देवी साऽपि निवर्त्यताम् ।\nतथा युधिष्ठिरः प्राह तत्सर्वं सत्यमेव हि\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2213108, "chapter_id": 5547, "verse_number": "६", "content_sanskrit": "पुत्रैश्वर्यं महदिदमपहाय महाफलम् ।\nका गच्छेत वनं दुर्गं पुत्रानुत्सृज्य मूढवत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2213109, "chapter_id": 5547, "verse_number": "७", "content_sanskrit": "राज्यस्थया तपश्चर्तुं नानाव्रतकृतं महत् ।\nअनया शक्यमद्येह श्रूयतां च वचो मम\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2213110, "chapter_id": 5547, "verse_number": "८", "content_sanskrit": "गान्धारि परितुष्टोऽस्मि वध्वाः शुश्रूषणेन वै ।\nतस्मात् त्वमेनां धर्मज्ञे समनुज्ञातुमर्हसि\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2213111, "chapter_id": 5547, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2213112, "chapter_id": 5547, "verse_number": "९", "content_sanskrit": "इत्युक्ता सौबलेयी तु राज्ञा कुन्तीमुवाच ह ।\nतत्सर्वं राजवचनं स्वं च वाक्यं विशेषवत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2213113, "chapter_id": 5547, "verse_number": "१०", "content_sanskrit": "न च सा वनवासाय देवी कृतमतिस्तदा ।\nशक्ता ह्युपावर्तयितुं कुन्ती धर्मपरा सती\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2213114, "chapter_id": 5547, "verse_number": "११", "content_sanskrit": "तस्यास्तु तं स्थिरं ज्ञात्वा व्यवसायं कुरुस्त्रियः ।\nनिवृत्ताश्च कुरुश्रेष्ठ दृष्ट्वा प्ररुरुदुस्तदा\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2213115, "chapter_id": 5547, "verse_number": "१२", "content_sanskrit": "उपावृत्तेषु पार्थेषु सर्वेष्वन्तःपुरेषु च ।\nययौ राजा महाप्राज्ञो धृतराष्ट्रो वनं तदा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2213116, "chapter_id": 5547, "verse_number": "१३", "content_sanskrit": "पाण्डवा अपि दीनास्ते दुःखशोकपरायणाः ।\nयानैः स्त्रीसहिताः सर्वे पुरं प्रविविशुस्तदा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2213117, "chapter_id": 5547, "verse_number": "१४", "content_sanskrit": "तदहृष्टमिवाकूजं गतोत्सवमिवाभवत् ।\nनगरं हस्तिनपुरं सस्त्रीवृद्धकुमारकम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2213118, "chapter_id": 5547, "verse_number": "१५", "content_sanskrit": "सर्वे चासन् निरुत्साहाः पाण्डवा जातमन्यवः ।\nकुन्त्या हीनाः सुदुःखार्ता वत्सा इव निवारिताः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2213119, "chapter_id": 5547, "verse_number": "१६", "content_sanskrit": "धृतराष्ट्रस्तु तेनाह्ना गत्वा सुमहदन्तरम् ।\nततो भागीरथीतीरे निवासमकरोत् प्रभुः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2213120, "chapter_id": 5547, "verse_number": "१७", "content_sanskrit": "प्रादुष्कृता यथान्यायमग्नयो वेदपारगैः ।\nव्यराजन्त द्विजश्रेष्ठैस्तत्र तत्र तपोधनैः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2213121, "chapter_id": 5547, "verse_number": "१८", "content_sanskrit": "प्रादुष्कृताग्निरभवत्स च वृद्धो नराधिपः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2213122, "chapter_id": 5547, "verse_number": "१९", "content_sanskrit": "स राजाऽग्नीन् पर्युपास्य हुत्वा च विधिवत् तदा ।\nसन्ध्यागतसहस्रांशुमुपातिष्ठत भारत\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2213123, "chapter_id": 5547, "verse_number": "२०", "content_sanskrit": "विदुरः सञ्जयश्चैव राज्ञः शय्यां कुशैस्ततः ।\nचक्रतुः कुरुवीरस्य गान्धार्याश्चाविदूरतः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2213124, "chapter_id": 5547, "verse_number": "२१", "content_sanskrit": "गान्धार्याः सन्निकर्षे तु निषसाद कुशेष्वथ ।\nयुधिष्ठिरस्य जननी कुन्ती साधुव्रते स्थिता\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2213125, "chapter_id": 5547, "verse_number": "२२", "content_sanskrit": "तेषां संश्रयणे चापि निषेदुर्विदुरादयः ।\nयाजकाश्च यथोद्देशं द्विजा ये चानुयायिनः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2213126, "chapter_id": 5547, "verse_number": "२३", "content_sanskrit": "प्रधीतद्विजमुख्या सा सम्प्रज्वलितपावका ।\nबभूव तेषां रजनी ब्राह्मीव प्रीतिवर्धनी\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2213127, "chapter_id": 5547, "verse_number": "२४", "content_sanskrit": "ततो रात्र्यां व्यतीतायां कृतपूर्वाह्णिकक्रियाः ।\nहुत्वाऽत्निं विधिवत् सर्वे प्रययुस्ते यथाक्रमम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2213128, "chapter_id": 5547, "verse_number": "२५", "content_sanskrit": "उदङ्मुखा निरीक्षन्त उपवासपरायणाः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2213129, "chapter_id": 5547, "verse_number": "२६", "content_sanskrit": "स तेषामतिदुःखोऽभून्निवासः प्रथमेऽहनि ।\nशोचतां वदतां चापि पौरजानपदानपि\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2213130, "chapter_id": 5547, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्रमवासिकपर्वणि धृतराष्ट्रस्य आश्रमवासो नाम त्रयोविंशोऽध्यायः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2213131, "chapter_id": 5547, "verse_number": "२३", "content_sanskrit": "आश्रमवासपर्वणि त्रयोविंशोऽध्यायः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2213132, "chapter_id": 5547, "verse_number": "", "content_sanskrit": "(** इल्लि तात्पर्यनिर्णयवु बिट्टुहोगिदेये? नोडबेकु)\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]