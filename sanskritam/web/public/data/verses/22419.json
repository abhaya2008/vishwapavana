[{"id": 7002419000, "chapter_id": 22419, "verse_number": "१-८१-१", "content_sanskrit": "ब्रह्मोवाच ।\nजया च विजया चैव जयन्ती चापराजिता ।\nमहाजवा च नन्दा च भद्रा चान्या प्रकीर्तिता ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002419001, "chapter_id": 22419, "verse_number": "१-८१-२", "content_sanskrit": "शुक्लपक्षस्य सप्तम्यां सूर्यवारो भवेद्यदि ।\nसप्तमी विजया नाम तत्र दत्तं महाफलम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002419002, "chapter_id": 22419, "verse_number": "१-८१-३", "content_sanskrit": "स्नानं दान तथा होमं उपवासस्तथैव च ।\nसर्वं विजयसप्तम्यां महापातकनाशनम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002419003, "chapter_id": 22419, "verse_number": "१-८१-४", "content_sanskrit": "पञ्चम्यामेकभक्तं स्यात्पष्ठ्यां नक्तं प्रचक्षते ।\nउपवासस्तु सप्तम्यामष्टम्यां पारणं भवेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002419004, "chapter_id": 22419, "verse_number": "१-८१-५", "content_sanskrit": "केचिद्देवमुशन्त्येव नेति चान्ये गणाधिप ।\nअभिप्रेतस्तु मे षष्ठ्यामुपवासो गणोत्तम ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002419005, "chapter_id": 22419, "verse_number": "१-८१-६", "content_sanskrit": "चतुर्थ्यामेकभक्तं तु पञ्चम्यां नक्तमादिशेत् ।\nउपवासस्तु षष्ठ्यां स्यात्सप्तम्यां पारणं भवेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002419006, "chapter_id": 22419, "verse_number": "१-८१-७", "content_sanskrit": "उपवासपरः षष्ठ्यामब्देशं पूजयेद्बुधः ।\nगन्धपुष्पोपहारैश्च भक्त्या श्रद्धासमन्वितः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002419007, "chapter_id": 22419, "verse_number": "१-८१-८", "content_sanskrit": "प्रकल्प्य पूजां भूमौ तु देवस्य पुरतः स्वपेत् ।\nजपमानस्तु२ गायत्रीं सौरसूक्तमथापि वा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002419008, "chapter_id": 22419, "verse_number": "१-८१-९", "content_sanskrit": "अक्षरं वा महाश्वेतं षडक्षरमथापि वा ।\nविबुद्धस्त्वथ सप्तम्यां कृत्वा स्नानं गणाधिप ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002419009, "chapter_id": 22419, "verse_number": "१-८१-१०", "content_sanskrit": "ग्रहेशं पूजयित्वा तु होमं कृत्वा विधानतः ।\nब्राह्मणान्भोजयेद्भक्त्या शक्त्या च गणनायक ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002419010, "chapter_id": 22419, "verse_number": "१-८१-११", "content_sanskrit": "शाल्योदनमपूपाश्च खण्डवेष्टांश्च शक्तितः ।\nसघृतं पायसं दद्यात्तथा विप्रेषु शक्तितः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002419011, "chapter_id": 22419, "verse_number": "१-८१-१२", "content_sanskrit": "दत्त्वा च दक्षिणा भक्त्या ततो विप्रान्विसर्जयेत् ।\nइत्येषा कथिता देव पुण्या विजयसप्तमी ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002419012, "chapter_id": 22419, "verse_number": "१-८१-१३", "content_sanskrit": "यामुपोष्य नरो गच्छेत्पदं वैरोचनं परम् ।\nकरवीराणि रक्तानि कुङ्कुमं च विलेपनम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002419013, "chapter_id": 22419, "verse_number": "१-८१-१४", "content_sanskrit": "विजयं धूपमस्यां तु भानोस्तुष्टिकराणि वै ।\nएषा पुण्या पापहरा महापातकनाशिनी ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002419014, "chapter_id": 22419, "verse_number": "१-८१-१५", "content_sanskrit": "अत्र दत्तं हुतं चापि क्षीयते न गणाधिप ।\nस्नानं दानं तथा होमः पितृदेवाभिपूजनम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002419015, "chapter_id": 22419, "verse_number": "१-८१-१६", "content_sanskrit": "सर्वं विजयसप्तम्यां महापातकनाशनम् ।\nआदित्यवारेण युता स्मृता विजयसप्तमी ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002419016, "chapter_id": 22419, "verse_number": "१-८१-१७", "content_sanskrit": "इत्येषा कथिता वीर सर्वकामप्रदायिनी ।\nधन्यं यशस्यमायुष्यं कीर्तितं श्रवणं तथा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002419017, "chapter_id": 22419, "verse_number": "१-८१-१८", "content_sanskrit": "स्मरणं तु तथास्यां तु पुण्यदं त्रिपुरान्तक ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]