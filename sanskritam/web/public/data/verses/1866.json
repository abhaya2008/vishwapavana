[{"id": 2039381, "chapter_id": 1866, "verse_number": "५-१११-०x", "content_sanskrit": "सपर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2039382, "chapter_id": 1866, "verse_number": "५-१११-१", "content_sanskrit": "यस्मादुत्तार्यते पापाद्यस्मान्निश्रेयसोऽश्रुते ।\nअस्मादुत्तारणबलादुत्तरेत्युच्यते द्विज ॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2039383, "chapter_id": 1866, "verse_number": "५-१११-२", "content_sanskrit": "उत्तरस्य हिरण्यस्य परिवापस्य गालव ।\nमार्गः पश्चिमपूर्वाभ्यां दिग्भ्यां वै मध्यमः स्मृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2039384, "chapter_id": 1866, "verse_number": "५-१११-३", "content_sanskrit": "अस्यां दिशि वरिष्ठायामुत्तरायां द्विजर्षभ ।\nनासौम्यो नाविधेयात्मा नाधर्मो वसते जनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2039385, "chapter_id": 1866, "verse_number": "५-१११-४", "content_sanskrit": "अत्र नारायणः कृष्णो जिष्णुश्चैव नरोत्तमः ।\nबदर्यामाश्रमपदे तथा ब्रह्मा च शाश्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2039386, "chapter_id": 1866, "verse_number": "५-१११-५", "content_sanskrit": "अत्र वै हिमवत्पृष्ठे नित्यमास्ते महेश्वरः।\n`प्रकृत्या पुरुषः सार्धं युगान्ताग्निसमप्रभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2039387, "chapter_id": 1866, "verse_number": "५-१११-६", "content_sanskrit": "न स दृश्यो मुनिगणैस्तथा देवैः सवासवैः ।\nगन्धर्वयक्षसिद्धैर्वा नरनारायणादृते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2039388, "chapter_id": 1866, "verse_number": "५-१११-७", "content_sanskrit": "अत्र विष्णुः सहस्राक्षः सहस्रचरणोऽव्ययः ।\nसहस्रशिरसः श्रीमानेकः पश्यति मायया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2039389, "chapter_id": 1866, "verse_number": "५-१११-८", "content_sanskrit": "अत्र राज्येन विप्राणां चन्द्रमाश्चाभ्यषिच्यत ।\nअत्र गङ्गां महादेवः पतन्तीं गगनाच्च्युताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2039390, "chapter_id": 1866, "verse_number": "५-१११-९", "content_sanskrit": "प्रतिगृह्य ददौ लोके मानुषे ब्रह्मवित्तम ।\nअत्र देव्या तपस्तप्तं महेश्वरपरीप्सया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2039391, "chapter_id": 1866, "verse_number": "५-१११-१०", "content_sanskrit": "अत्र कामश्च रोषश्च शैलश्चोमा च संबभुः ।\nअत्र राक्षसयक्षाणां गन्धर्वाणां च गालव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2039392, "chapter_id": 1866, "verse_number": "५-१११-११", "content_sanskrit": "आधिपत्येन कैलासे धनदोऽप्यभिषेचितः।\nअत्र चैत्ररथं रम्यमत्र वैखानसाश्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2039393, "chapter_id": 1866, "verse_number": "५-१११-१२", "content_sanskrit": "अत्र मन्दाकिनी चैव मन्दरश्च द्विजर्षभ ।\nअत्र सौगन्धिकवनं नैर्ऋतैरभिरक्ष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2039394, "chapter_id": 1866, "verse_number": "५-१११-१३", "content_sanskrit": "शाद्वलं कदलीस्कन्धमत्र सन्तानका नगाः।\nअत्र संयमनित्यानां सिद्धानां स्वैरचारिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2039395, "chapter_id": 1866, "verse_number": "५-१११-१४", "content_sanskrit": "विमानान्युनुरूपाणि कामभोग्यानि गालव ।\nअत्र ते ऋषयः सप्त देवी चारुन्धती तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2039396, "chapter_id": 1866, "verse_number": "५-१११-१५", "content_sanskrit": "अत्र तिष्ठति वै रात्रिन्दिवाप्यत्रावतिष्ठते।\nअत्र यज्ञं समासाद्य ध्रुवं स्थाता पितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2039397, "chapter_id": 1866, "verse_number": "५-१११-१६", "content_sanskrit": "ज्योतींषि चन्द्रसूर्यौ च परिवर्तन्ति नित्यशः ।\nअत्र गङ्गामहाद्वारं रक्षन्ति द्विजसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2039398, "chapter_id": 1866, "verse_number": "५-१११-१७", "content_sanskrit": "धामा नाम महात्मानो मुनयः सत्यवादिनः ।\nन तेषां ज्ञायते मूर्तिर्नाकृतिर्न तपश्चितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2039399, "chapter_id": 1866, "verse_number": "५-१११-१८", "content_sanskrit": "परिवर्तसहस्रामि कामभोज्याननि गालव ।\nयथायथा प्रविशति तस्मात्परतरं नरः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2039400, "chapter_id": 1866, "verse_number": "५-१११-१९", "content_sanskrit": "तथातथा द्विजश्रेष्ठ प्रविलीयति गालव ।\nनैतत्केनचिदन्येन गतपूर्वं द्विजर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2039401, "chapter_id": 1866, "verse_number": "५-१११-२०", "content_sanskrit": "ऋते नारायणं देवं नरं वा जिष्णुमव्ययम् ।\nअत्र कैलासमित्युक्तं स्थानमैलविलस्य तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2039402, "chapter_id": 1866, "verse_number": "५-१११-२१", "content_sanskrit": "अत्र विद्युत्प्रभा नाम जझिरेऽप्सरसो दश।\nअत्र विष्णुपदं नाम क्रमता विष्णुना कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2039403, "chapter_id": 1866, "verse_number": "५-१११-२२", "content_sanskrit": "त्रिलोकविक्रमे ब्रह्मन्नुत्तरां दिशमाश्रितम् ।\nअत्र राज्ञा मरुतेन यज्ञेनेष्टं द्विजोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2039404, "chapter_id": 1866, "verse_number": "५-१११-२३", "content_sanskrit": "उशीरबीजे विप्रर्षे यत्र जाम्बूनदं सरः।\nजीमूतस्यात्र विप्रर्षेरुपतस्थे महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2039405, "chapter_id": 1866, "verse_number": "५-१११-२४", "content_sanskrit": "साक्षाद्धैमवतः पुण्यो विमलः कनकाकरः ।\nब्राह्मणेषु च यत्कृत्स्नं स्वन्तं कृत्वा धनं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2039406, "chapter_id": 1866, "verse_number": "५-१११-२५", "content_sanskrit": "वव्रे धनं महर्षिः स जैमूतं तद्धनं ततः।\nअत्र नित्यं दिशांपालाः सायंप्रातर्द्विजर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2039407, "chapter_id": 1866, "verse_number": "५-१११-२६", "content_sanskrit": "कस्य कार्यं किमिति वै परिक्रोशान्ति गालव ।\nएवमेषा द्विजश्रेष्ठ गुणैरन्यैर्दिगुत्तरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2039408, "chapter_id": 1866, "verse_number": "५-१११-२७", "content_sanskrit": "उत्तरेति परिख्याता सर्वकर्मस्तु चोत्तरा ।\nएता विस्तरशस्तात तव शङ्गीर्तिता दिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2039409, "chapter_id": 1866, "verse_number": "५-१११-२८", "content_sanskrit": "चतस्रः क्रमयोगेन कामाशां गन्तुमिच्छसि।\nउद्यतोऽहं द्विजश्रेष्ठ तव दर्शयितुं दिशः।\nपृथिवीं चाखिलां ब्रह्मंस्तस्मादारोह मां द्विज ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2039410, "chapter_id": 1866, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि एकादशाधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]