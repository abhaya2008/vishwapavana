[{"id": 7005690000, "chapter_id": 25690, "verse_number": "१६३-१", "content_sanskrit": "सूत उवाच ।\nखराः खरमुखाश्चैव मकराशी विषाननाः ।\nईहामृगमुखाश्चान्ये वराह मुखसंस्थिताः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005690001, "chapter_id": 25690, "verse_number": "१६३-२", "content_sanskrit": "बालसूर्यमुखाश्चान्ये धूमकेतु मुखास्तथा ।\nअर्द्धचन्द्रार्धवक्त्राश्च अग्नि दीप्त मुखास्तथा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005690002, "chapter_id": 25690, "verse_number": "१६३-३", "content_sanskrit": "हंसकुक्कुटवक्त्राश्च व्यादितास्या भयावहाः ।\nसिंहास्या लेलिहानाश्च काकगृध्र मुखास्तथा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005690003, "chapter_id": 25690, "verse_number": "१६३-४", "content_sanskrit": "द्विजिह्वका वक्त्रशीर्षास्तथोल्का मुखसंस्थिताः ।\nमहाग्राहमुकाश्चान्ये दानवा बलदर्पिताः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005690004, "chapter_id": 25690, "verse_number": "१६३-५", "content_sanskrit": "शैलसंवर्ष्मणस्तस्य शरीरे शरवृष्टिभिः ।\nअबध्यस्य मृगेन्द्रस्य न व्यथाञ्चक्रुराहवे ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005690005, "chapter_id": 25690, "verse_number": "१६३-६", "content_sanskrit": "एवं भूयोऽपरान् घोरानसृजन् दानवेश्वराः ।\nमृगेन्द्रस्योपरि क्रुद्धा निश्वसन्त इवोरगाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005690006, "chapter_id": 25690, "verse_number": "१६३-७", "content_sanskrit": "ते दानवशरा घोरा दानवेन्द्रसमीरिताः ।\nविलयं जग्मुराकाशे खद्योता इव पर्वते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005690007, "chapter_id": 25690, "verse_number": "१६३-८", "content_sanskrit": "ततश्चक्राणि दिव्यानि दैत्याः क्रोधसमन्विताः ।\nमृगेन्द्रायासृजन्नाशु ज्वलितानि समन्ततः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005690008, "chapter_id": 25690, "verse_number": "१६३-९", "content_sanskrit": "तैरासीद्गगनं चक्रैः सम्पतद्भिरितस्ततः ।\nयुगान्ते सम्प्रकाशद्भिश्चन्द्रादित्य ग्रहैरिव ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005690009, "chapter_id": 25690, "verse_number": "१६३-१०", "content_sanskrit": "तानि सर्वाणि चक्राणि मृगेन्द्रेण शमात्मना ।\nग्रस्तान्युदीर्णानि तदा पावकार्चिः समानि वै ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005690010, "chapter_id": 25690, "verse_number": "१६३-११", "content_sanskrit": "तानि चक्राणि वदनं विशमानानि भान्ति वै ।\nमेघोदरदरीष्वेव चन्द्रसूर्यग्रहा इव ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005690011, "chapter_id": 25690, "verse_number": "१६३-१२", "content_sanskrit": "हिरण्यकशिपुर्दैत्यो भूयः प्रासृजदूर्जितम् ।\nशक्तिं प्रज्वलितां घोरां धौतशस्त्रतड़ित्प्रभाम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005690012, "chapter_id": 25690, "verse_number": "१६३-१३", "content_sanskrit": "तामापतन्ती संप्रेक्ष्य मृगेन्द्रः शक्तिमुज्वलाम् ।\nहुङ्कारेणैव रौद्रेण ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005690013, "chapter_id": 25690, "verse_number": "१६३-१४", "content_sanskrit": "रराज भग्ना सा शक्तिर्मृगेन्द्रेण महीतले ।\nस विस्फुलिङ्गा ज्वलिता ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005690014, "chapter_id": 25690, "verse_number": "१६३-१५", "content_sanskrit": "नाराचपङ्क्तिः सिंहस्य प्राप्ता रेजे विदूरतः ।\nनीलोत्पलपलाशानां मालेवोज्ज्वल दर्शना ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005690015, "chapter_id": 25690, "verse_number": "१६३-१६", "content_sanskrit": "स गर्जित्वा यथान्यायं विक्रम्य च यथासुखम् ।\nतत्सैन्यमपसारितवान् तृणाग्राणीव मारुतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005690016, "chapter_id": 25690, "verse_number": "१६३-१७", "content_sanskrit": "ततोऽश्मवर्षं दैत्येन्द्रा व्यसृजन्त नभोगताः ।\nनगमात्रैः शिलाखण्डै र्गिरिशृङ्गैर्महाप्रभैः ।\n॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005690017, "chapter_id": 25690, "verse_number": "१६३-१८", "content_sanskrit": "तदश्मवर्षं सिंहस्य महन्मूर्द्धनि पातितम् ।\nदिशो दश विकीर्णा वै खद्योतप्रकरा इव ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005690018, "chapter_id": 25690, "verse_number": "१६३-१९", "content_sanskrit": "तदाश्मौघैर्दैत्यगणाः पुनः सिंहमरिन्दमम् ।\nछायायां चक्रिरे मेघा धाराभिरिव पर्वतम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005690019, "chapter_id": 25690, "verse_number": "१६३-२०", "content_sanskrit": "न च तं चालयामासुः दैत्यौघा देवसत्तमम् ।\nभीमवेगोऽचलश्रेष्टं समुद्र इव मन्दरम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005690020, "chapter_id": 25690, "verse_number": "१६३-२१", "content_sanskrit": "ततोऽश्मवर्षे विहिते जलवर्षमनन्तरम् ।\nधाराभिरक्षमात्राभिः प्रादुरासीत् समन्ततः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005690021, "chapter_id": 25690, "verse_number": "१६३-२२", "content_sanskrit": "नभसः प्रच्युताधाराः तिग्मवेगाः समन्ततः ।\nआवृत्य सर्वतो व्योम दिशश्चोपदिशस्तथा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005690022, "chapter_id": 25690, "verse_number": "१६३-२३", "content_sanskrit": "धारा दिवि च सर्वत्र वसुधायाञ्च सर्वशः ।\nन स्पृशन्ति च ता देवं निपतन्तोऽनिशं भुवि ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005690023, "chapter_id": 25690, "verse_number": "१६३-२४", "content_sanskrit": "बाह्यतो ववृषुर्वर्षं नोपरिष्टाच्च ववृषुः ।\nमृगेन्द्र प्रतिरूपस्य स्थितस्य युधि मायया ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005690024, "chapter_id": 25690, "verse_number": "१६३-२५", "content_sanskrit": "हतेऽश्मवर्षे तुमुले जलवर्षे च शोषिते ।\nसोऽसृजद्दानवो मायामग्निवायुसमीरिताम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005690025, "chapter_id": 25690, "verse_number": "१६३-२६", "content_sanskrit": "महेन्द्रस्तोयदैः सार्द्धं सहस्राक्षो महाद्युतिः ।\nमहता तोयवर्षेण शमयामास पावकम् ॥ ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005690026, "chapter_id": 25690, "verse_number": "१६३-२७", "content_sanskrit": "तस्यां प्रतिहतायां तु मायायां युधि दानवः ।\nअसृजत् घोरसंकाशं तमस्तीव्रं समन्ततः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005690027, "chapter_id": 25690, "verse_number": "१६३-२८", "content_sanskrit": "तमसा संवृते लोके दैत्येष्वात्तायुधेषु च ।\nस्वतेजसा परिवृतो दिवाकर इवा बभौ ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005690028, "chapter_id": 25690, "verse_number": "१६३-२९", "content_sanskrit": "त्रिशाखां भ्रुकुटीञ्चास्य ददृशुर्दानवा रणे ।\nललाटस्थां त्रिशूलाङ्कां गङ्गां त्रिपथगामिव ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005690029, "chapter_id": 25690, "verse_number": "१६३-३०", "content_sanskrit": "ततः सर्वासु मायासु हतासु दितिनन्दनाः ।\nहिरण्यकशिपुं दैत्यं विवर्णाः शरणं ययुः ।\n॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005690030, "chapter_id": 25690, "verse_number": "१६३-३१", "content_sanskrit": "ततः प्रज्वलितः क्रोधात् प्रदहन्निव तेजसा ।\nतस्मिन् क्रुद्धे तु दैत्येन्द्रे तमो भूतमभूज्जगत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005690031, "chapter_id": 25690, "verse_number": "१६३-३२", "content_sanskrit": "आवहः प्रवहश्चैव विवहोऽथ ह्युदावहः ।\nपरावहः संवहश्च महाबलपराक्रमाः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005690032, "chapter_id": 25690, "verse_number": "१६३-३३", "content_sanskrit": "तथा परिवहः श्रीमानुत्पातभयशंसनाः ।\nइत्येवं क्षुभिताः सप्त मरुतो गगनेचराः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005690033, "chapter_id": 25690, "verse_number": "१६३-३४", "content_sanskrit": "ये ग्रहाः सर्वलोकस्य क्षये प्रादुर्भवन्ति वै ।\nते सर्वे गगने दृष्टा व्यचरन्त यथासुखम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005690034, "chapter_id": 25690, "verse_number": "१६३-३५", "content_sanskrit": "अन्यङ्गते चाप्यचरन् मार्गं निशि निशाचरः ।\nसंग्रहः सहनक्षत्रैराकापतिररिन्दमः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005690035, "chapter_id": 25690, "verse_number": "१६३-३६", "content_sanskrit": "विवर्णताञ्च भगवान् गतो दिवि दिवाकरः ।\nकृष्णं कबन्धं च तथा लक्ष्यते सुमहद्दिवि ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005690036, "chapter_id": 25690, "verse_number": "१६३-३७", "content_sanskrit": "अमुञ्चच्चार्चिषां वृन्दं भूमिवृत्ति र्विभावसुः ।\nगगनस्थश्च भगवानभीक्ष्णं परिदृश्यते ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005690037, "chapter_id": 25690, "verse_number": "१६३-३८", "content_sanskrit": "सप्त धूम्रनिभा घोराः सूर्य्या दिवि समुत्थिताः ।\nसोमस्य गगनस्थस्य ग्रहास्तिष्ठन्ति शृङ्गगाः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005690038, "chapter_id": 25690, "verse_number": "१६३-३९", "content_sanskrit": "वामेन दक्षिणे चैव स्थितौ शुक्रबृहस्पती ।\nशनैश्चरो लोहिताङ्गो ज्वलनाङ्ग-समुद्यती ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005690039, "chapter_id": 25690, "verse_number": "१६३-४०", "content_sanskrit": "समं समधिरोहन्तः सर्वे ते गगनेचराः ।\nशृङ्गाणि शनकैर्घोरा युगान्तावर्तिनो ग्रहाः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005690040, "chapter_id": 25690, "verse_number": "१६३-४१", "content_sanskrit": "चन्द्रमाश्च सनक्षत्रैर्ग्रहैः सह तमोनुदः ।\nचराचरविनाशाय रोहिणीं नाभ्यनन्दत ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005690041, "chapter_id": 25690, "verse_number": "१६३-४२", "content_sanskrit": "गृह्यते राहुणा चन्द्र उल्काभिरभिहन्यते ।\nउल्काः प्रज्वलिताश्चन्द्रे विचरन्ति यथासुखम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005690042, "chapter_id": 25690, "verse_number": "१६३-४३", "content_sanskrit": "देवानामपि यो देवः सोऽप्यवर्षत शोणितम् ।\nअपतन् गगनादुल्का विद्युद्रूपा महास्वनाः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005690043, "chapter_id": 25690, "verse_number": "१६३-४४", "content_sanskrit": "अकाले च द्रुमाः सर्वे पुष्पन्ति च फलन्ति च ।\nलताश्च सफलाः सर्वा ये चाहुर्दैत्यनाशनम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005690044, "chapter_id": 25690, "verse_number": "१६३-४५", "content_sanskrit": "फलैः फलान्यजायन्त पुष्पैः पुष्पं तथैव च ।\nउन्मीलन्ति निमीलन्ति हसन्ति च रुदन्ति च ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005690045, "chapter_id": 25690, "verse_number": "१६३-४६", "content_sanskrit": "विक्रोशन्ति च गम्भीरा धूमयन्ति ज्वलन्ति च ।\nप्रतिमाः सर्वदेवानां वेदयन्ति महद्भयम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005690046, "chapter_id": 25690, "verse_number": "१६३-४७", "content_sanskrit": "आरण्यैः सह संसृष्ट ग्राम्याश्च मृगपक्षिणः ।\nचक्रुः सुभैरवं तत्र महायुद्धमुपस्थितम् ॥ ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005690047, "chapter_id": 25690, "verse_number": "१६३-४८", "content_sanskrit": "तद्यश्च प्रतिकूलानि वहन्ति कलुषोदकाः ।\nन प्रकाशन्ति च दिशो रक्तरेणुसमाकुलाः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005690048, "chapter_id": 25690, "verse_number": "१६३-४९", "content_sanskrit": "वानस्पत्यो न पूज्यन्ते पूजनार्हाः कथञ्चन ।\nवायुवेगेन हन्यन्ते भज्यन्ते प्रणमन्ति च ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005690049, "chapter_id": 25690, "verse_number": "१६३-५०", "content_sanskrit": "यदा च सर्वभूतानां छाया न परिवर्तते ।\nअपराह्णगते सूर्ये लोकानां युगसंक्षये ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005690050, "chapter_id": 25690, "verse_number": "१६३-५१", "content_sanskrit": "तदा हिरण्यकशिपो र्दैत्यस्योपरि वेश्मनः ।\nभाण्डागारे युधागारे निविष्टमभवन्मधु ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7005690051, "chapter_id": 25690, "verse_number": "१६३-५२", "content_sanskrit": "असुराणां विनाशाय सुराणां विजयाय च ।\nदृश्यन्ते विविधोत्पाता घोरा घोरनिदर्शनाः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7005690052, "chapter_id": 25690, "verse_number": "१६३-५३", "content_sanskrit": "एते चान्ये च बहवो गोरोत्पाताः समुत्थिताः ।\nदैत्येन्द्रस्य विनाशाय दृश्यन्ते कालनिर्मिताः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7005690053, "chapter_id": 25690, "verse_number": "१६३-५४", "content_sanskrit": "मेदिन्यां कम्पमानायां दैत्येन्द्रेण महात्मना ।\nमहीधरा नागगणा निपेतुरमितौजसः ॥ ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7005690054, "chapter_id": 25690, "verse_number": "१६३-५५", "content_sanskrit": "विषज्वालाकुलैर्वक्त्रैर्विमुञ्चन्तो हुताशनम् ।\nचतुःशीर्षाः पञ्चशीर्षाः सप्तशीर्षाश्च पन्नगाः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7005690055, "chapter_id": 25690, "verse_number": "१६३-५६", "content_sanskrit": "वासुकिस्तक्षकश्चैव कर्कोटक धनञ्जयौ ।\nएलामुखः कालिकश्च महापद्मश्च वीर्यवान् ॥ ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7005690056, "chapter_id": 25690, "verse_number": "१६३-५७", "content_sanskrit": "सहस्रशीर्षा नागोवै हेमतालध्वजः प्रभुः ।\nशेषोऽनन्तोमहाभागो दुष्प्रकम्प्यः प्रकम्पितः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7005690057, "chapter_id": 25690, "verse_number": "१६३-५८", "content_sanskrit": "दीप्तान्यन्तर्जलस्थानि पृथिवी धरणानि च ।\nतदा क्रुद्धेन महता कम्पितानि समन्ततः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7005690058, "chapter_id": 25690, "verse_number": "१६३-५९", "content_sanskrit": "नागास्तेजोधराश्चापि पातालतलचारिणः ।\nहिरण्यकशिपुर्दैत्यस्तदा संस्पृष्टवान् महीम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7005690059, "chapter_id": 25690, "verse_number": "१६३-६०", "content_sanskrit": "सन्दष्टौष्टपुटः क्रोधाद्वाराह इव पूर्वजः ।\nनदी भागीरथी चैव सरयूः कौशिकी तथा ॥ ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7005690060, "chapter_id": 25690, "verse_number": "१६३-६१", "content_sanskrit": "यमुना त्वथ कावेरी कृष्णवेणी च निम्नगा ।\nसुवेणा च महाभागा नदी गोदावरी तथा ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7005690061, "chapter_id": 25690, "verse_number": "१६३-६२", "content_sanskrit": "चर्मण्वती च सिन्दुश्च तथा नदनदीपतिः ।\nकमलप्रभवश्चैव शोणोमणि निभोदकः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7005690062, "chapter_id": 25690, "verse_number": "१६३-६३", "content_sanskrit": "नर्मदा शुभतोया च तथा वेत्रवती नदी ।\nगोमती गोकुलाकीर्णा तथा पूर्वसरस्वती ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7005690063, "chapter_id": 25690, "verse_number": "१६३-६४", "content_sanskrit": "मही कालमही चैव तमसा पुष्पवाहिनी ।\nजम्बूद्वीपं रत्नवटं सर्वरत्नोपशोभितम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7005690064, "chapter_id": 25690, "verse_number": "१६३-६५", "content_sanskrit": "सुवर्ण प्रकटञ्चैव सुवर्णाकरमण्डितम् ।\nमहानदञ्च लौहित्यं शैलकाननशोभितम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7005690065, "chapter_id": 25690, "verse_number": "१६३-६६", "content_sanskrit": "पत्तनं कोशकरणं ऋषिवीर जनाकरम् ।\nमागधाश्च महाग्रामा मुडाः शुङ्गास्तथैव च ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7005690066, "chapter_id": 25690, "verse_number": "१६३-६७", "content_sanskrit": "सुह्मा मल्ला विदेहाश्च मालवाः काशिकोसलाः ।\nभवनं वैनतेयस्य दैत्येन्द्रेणाभिकम्पितम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7005690067, "chapter_id": 25690, "verse_number": "१६३-६८", "content_sanskrit": "कैलासशिखराकारं यत् कृतं विश्वकर्मणा ।\nरक्ततोयो महाभीमो लौहित्यो नाम सागरः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7005690068, "chapter_id": 25690, "verse_number": "१६३-६९", "content_sanskrit": "उदयश्च महाशैल उच्छ्रितः शतयोजनम् ।\nसुवर्णवेदिकः श्रीमान् मेघपङ्क्ति-निषेवितः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7005690069, "chapter_id": 25690, "verse_number": "१६३-७०", "content_sanskrit": "भ्राजमानोऽर्कसदृशै जातरूपमयैर्द्रुमैः ।\nशालैस्तालैस्तमालैश्च कर्णिकारैश्च पुष्पितैः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7005690070, "chapter_id": 25690, "verse_number": "१६३-७१", "content_sanskrit": "अयोमुखश्च विख्यातः सर्वतो धातुमण्डितः ।\nतमालवनगन्धश्च पर्वतो मलयः शुभः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7005690071, "chapter_id": 25690, "verse_number": "१६३-७२", "content_sanskrit": "सुराष्ट्राश्च सवाल्हीकाः शूराभीरास्तथैवच ।\nभोजाः पाण्ड्याश्च वङ्गाश्च कलिङ्गस्ताम्रलिप्तकाः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7005690072, "chapter_id": 25690, "verse_number": "१६३-७३", "content_sanskrit": "तथैवोड्राश्च पौण्ड्राश्च वामचूडाः सकेरलाः ।\nक्षोभितास्तेन दैत्येन सदेवाश्चाप्सरोगणाः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7005690073, "chapter_id": 25690, "verse_number": "१६३-७४", "content_sanskrit": "अगस्त्यभवनञ्चैव यदगम्यङ्कृतं पुरा ।\nसिद्धचारणसङ्घैश्च विप्रकीर्णं मनोहरम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7005690074, "chapter_id": 25690, "verse_number": "१६३-७५", "content_sanskrit": "विचित्रनानाविहगं सुपुष्पितमहाद्रुमम् ।\nजातरूपमयैः श्रृङ्गैर्गगनं विलिखन्निव ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7005690075, "chapter_id": 25690, "verse_number": "१६३-७६", "content_sanskrit": "चन्द्रसूर्यांशुसङ्काशैः सागराम्बु समावृतैः ।\nविद्युत्त्वान् सर्वः श्रीमानायतः शतयोजनम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7005690076, "chapter_id": 25690, "verse_number": "१६३-७७", "content_sanskrit": "विद्युतां यत्र सङ्घाता निपात्यन्ते नगोत्तमे ।\nऋषभः पर्वतश्चैव श्रीमान् वृषभसंज्ञितः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7005690077, "chapter_id": 25690, "verse_number": "१६३-७८", "content_sanskrit": "कुञ्चरः पर्वतः श्रीमानगस्त्यस्य गृहं शुभम् ।\nविशालाक्षश्च दुर्धर्षः सर्पाणामालयः पुरी ॥ ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7005690078, "chapter_id": 25690, "verse_number": "१६३-७९", "content_sanskrit": "तथा भोगवतीचापि दैत्येन्द्रेणाभिकम्पिताः ।\nमहासेनो गिरिश्चैव पारियात्रश्च पर्वतः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7005690079, "chapter_id": 25690, "verse_number": "१६३-८०", "content_sanskrit": "चक्रवांश्च गिरिश्रेष्ठो वाराहश्चैव पर्वतः ।\nप्राग्ज्योतिष परञ्चापि जातरूपमयं शुभम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7005690080, "chapter_id": 25690, "verse_number": "१६३-८१", "content_sanskrit": "यस्मिन्वसति दुष्टात्मा नरको नाम दानवः ।\nविशालाक्षश्च दुर्द्धर्षो मेघगम्भीरनिस्वनः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7005690081, "chapter_id": 25690, "verse_number": "१६३-८२", "content_sanskrit": "षष्टिस्तत्र सहस्राणि पर्वतानां द्विजोत्तमाः ।\nतरुणादित्यसङ्काशो मेरुस्तत्र महागिरिः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7005690082, "chapter_id": 25690, "verse_number": "१६३-८३", "content_sanskrit": "यक्षराक्षसगन्धर्वैः नित्यं सेवितकन्दरः ।\nहेमगर्भो महाशैलस्तथा हेमसखो-गिरिः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7005690083, "chapter_id": 25690, "verse_number": "१६३-८४", "content_sanskrit": "कैलासश्चैव शैलेन्द्रो दानवेन्द्रेण कम्पिताः ।\nहेमपुष्परसक्षेत्रं तेन वैखानसं सरः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7005690084, "chapter_id": 25690, "verse_number": "१६३-८५", "content_sanskrit": "कम्पितं मानसञ्चैव हंसकारण्डवाकुलम् ।\nत्रिशृङ्गपर्वतश्चैव कुमारी च सरिद्वरा ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7005690085, "chapter_id": 25690, "verse_number": "१६३-८६", "content_sanskrit": "तुषारचय-सञ्छन्ना मन्दरश्चापि पर्वतः ।\nउशीरबिन्दुश्च गिरिश्चन्द्रप्रस्थः तथाद्रिराट् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7005690086, "chapter_id": 25690, "verse_number": "१६३-८७", "content_sanskrit": "प्रजापतिगिरिश्चैव तथा पुष्करपर्वतः ।\nदेवाभ्रपर्वतश्चैव यथावै रेणुको गिरिः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7005690087, "chapter_id": 25690, "verse_number": "१६३-८८", "content_sanskrit": "क्रौञ्चः सप्तर्षिशैलश्च धूम्रवर्णश्च पर्वतः ।\nएते चान्ये च गिरयो देशा जनपदास्तथा ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7005690088, "chapter_id": 25690, "verse_number": "१६३-८९", "content_sanskrit": "नद्यः ससागराः सर्वाः सोऽकम्पयत दानवः ।\nकपिलश्च महीपुत्रो व्याघ्रवांश्चैव कम्पितः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7005690089, "chapter_id": 25690, "verse_number": "१६३-९०", "content_sanskrit": "खेचराश्च सतीपुत्राः पातालतलवासिनः ।\nगणस्तथा परो रौद्रो मेघनामाङ्कुशायुधः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7005690090, "chapter_id": 25690, "verse_number": "१६३-९१", "content_sanskrit": "ऊर्ध्वगो भीमवेगश्च सर्व एवाभिकम्पिताः ।\nगदी शूली करालश्च हिरण्यकशिपुस्तदा ॥ ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7005690091, "chapter_id": 25690, "verse_number": "१६३-९२", "content_sanskrit": "जीमूतघनसङ्काशो जीमूतघननिस्वनः ।\nजीमूतघननिर्घोषो जीमूत इव वेगवान् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7005690092, "chapter_id": 25690, "verse_number": "१६३-९३", "content_sanskrit": "देवारिर्दितिजो वीरो नृसिंहं समुपाद्रवत् ।\nसमुत्पत्य ततस्तीक्ष्णैर्मृगेन्द्रेण महानखैः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7005690093, "chapter_id": 25690, "verse_number": "१६३-९४", "content_sanskrit": "तदोङ्कारसहायेन विदार्य निहतो युधि ।\nमही च कालश्च वशी नभश्च ग्रहाश्च सूर्यश्च दिशश्च सर्वाः ।\nनद्यश्च च शैलाश्च महार्णवाश्च गताः प्रसादन्दितिपुत्रनाशात् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7005690094, "chapter_id": 25690, "verse_number": "१६३-९५", "content_sanskrit": "ततः प्रमुदिता देवा ऋषयश्च तपोधनाः ।\nतुष्टुवुर्नामभिर्दिव्यै रादिदेवं सनातनम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7005690095, "chapter_id": 25690, "verse_number": "१६३-९६", "content_sanskrit": "यत्त्वया विहितं देव! नारसिंहमिदं वपुः ।\nएतदेवार्चयिष्यन्ति परावरविदो जनाः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7005690096, "chapter_id": 25690, "verse_number": "१६३-९७", "content_sanskrit": "ब्रह्मोवाच ।\nभवान् ब्रह्मा च रुद्रश्च महोन्द्रो देवसत्तमाः! ।\nभवान् कर्ता विकर्ता च लोकानां प्रभवाप्ययः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7005690097, "chapter_id": 25690, "verse_number": "१६३-९८", "content_sanskrit": "पराञ्च सिद्धाञ्च परञ्च देवं परञ्च मन्त्रं परमं हविश्च ।\nपरञ्च धर्मं परमञ्च विश्वं त्वामाहुरग्र्य्रं पुरुषं पुराणम् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7005690098, "chapter_id": 25690, "verse_number": "१६३-९९", "content_sanskrit": "परं शरीरं परमञ्च ब्रह्म परञ्च योगं परमाञ्च वाणीम् ।\nपरं रहस्यं परमाङ्गतिञ्च त्वामाहुरग्र्य्रं पुरुषं पुराणम् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7005690099, "chapter_id": 25690, "verse_number": "१६३-१००", "content_sanskrit": "एवं परस्यापि परं पदं यत् परं परस्यापि परञ्च देवम् ।\nपरं परस्यापि परञ्च भूतन्त्वामाहुरग्र्य्रं पुरुषं पुराणम् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7005690100, "chapter_id": 25690, "verse_number": "१६३-१०१", "content_sanskrit": "परं परस्यापि परं निधानं परं परस्यापि परं पवित्रम् ।\nपरं परस्यापि परं च दान्तन्त्वामाहुरग्र्य्रं पुरुषं पुराणम् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7005690101, "chapter_id": 25690, "verse_number": "१६३-१०२", "content_sanskrit": "एवमुक्त्वा तु भगवान् सर्वलोकपितामहः ।\nस्तुत्वा नारायणं देवं ब्रह्मलोकं गतः प्रभुः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7005690102, "chapter_id": 25690, "verse_number": "१६३-१०३", "content_sanskrit": "तप्तो नदत्सु तूर्येषु नृत्यन्तीष्वत्सरः सु च ।\nक्षीरोदस्योत्तरं कूलं जगाम हरिरीश्वरः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7005690103, "chapter_id": 25690, "verse_number": "१६३-१०४", "content_sanskrit": "नारसिंहं वपुर्देवः स्थापयित्वा सुदीप्तिमत् ।\nपौराणां रूपमास्थाय प्रययौ गरुडध्वजः ॥ ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7005690104, "chapter_id": 25690, "verse_number": "१६३-१०५", "content_sanskrit": "अष्टचक्रेण यानेन भूतयुक्तेन भास्वता ।\nअव्यक्त-प्रकृतिर्देवः स्वस्थानं गतवान् प्रभुः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}]