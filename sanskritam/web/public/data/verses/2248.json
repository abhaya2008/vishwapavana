[{"id": 2057651, "chapter_id": 2248, "verse_number": "७-१७५-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2057652, "chapter_id": 2248, "verse_number": "७-१७५-१", "content_sanskrit": "दृष्ट्वा घटोत्कचं राजन्सूतपुत्ररथं प्रति।\nआयान्तं तु तथायुक्तं जिघांसुं कर्णमाहवे।\nअब्रवीत्तत्र पुत्रस्ते दुःशासनमिदं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2057653, "chapter_id": 2248, "verse_number": "७-१७५-२", "content_sanskrit": "एतद्रक्षो रणे तूर्णं दृष्ट्वा कर्णस्य विक्रमम्।\nअभियाति द्रुतं कर्णं तद्वारय महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2057654, "chapter_id": 2248, "verse_number": "७-१७५-३", "content_sanskrit": "वृतः सैन्येन महता याहि यत्र महाबलः।\nकर्णो वैकर्तनो युद्धे राक्षसेन युयुत्सति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2057655, "chapter_id": 2248, "verse_number": "७-१७५-४", "content_sanskrit": "रक्ष कर्णं रणे यत्तो वृतः सैन्येन मानद।\nमा कर्णं राक्षसो घोरः प्रमादान्नाशयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2057656, "chapter_id": 2248, "verse_number": "७-१७५-५", "content_sanskrit": "एतस्मिन्नन्तरे राजञ्जटासुरसुतो बली।\nदुर्योधनमुपागम्य प्राह प्रहरतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2057657, "chapter_id": 2248, "verse_number": "७-१७५-६", "content_sanskrit": "दुर्योधन तवामित्रान्प्रख्यातान्युद्धदुर्मदान्।\nपाण्डवान्हन्तुमिच्छामि त्वयाऽऽज्ञप्तः सहानुगान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2057658, "chapter_id": 2248, "verse_number": "७-१७५-७", "content_sanskrit": "जटासुरो मम पिता रक्षसां ग्रामणीः पुरा।\nप्रयुज्य कर्म रक्षोघ्नं क्षुद्रैः पार्थैर्निपातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2057659, "chapter_id": 2248, "verse_number": "७-१७५-८", "content_sanskrit": "तस्यापचितिमिच्छामि शत्रुशोणितपूजया।\nशत्रुमांसैश्च राजेन्द्र मामनुज्ञातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2057660, "chapter_id": 2248, "verse_number": "७-१७५-९", "content_sanskrit": "तमब्रवीत्ततो राजा प्रीयमाणः पुनःपुनः।\nद्रोणकर्मादिभिः सार्धं पर्याप्तोऽहं द्विषद्वधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2057661, "chapter_id": 2248, "verse_number": "७-१७५-१०", "content_sanskrit": "त्वं तु गच्छ मयाऽऽज्ञप्तो जहि युद्धे घटोत्कचम्।\nराक्षसं क्रूरकर्माणं रक्षोमानुषसम्भवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2057662, "chapter_id": 2248, "verse_number": "७-१७५-११", "content_sanskrit": "पाण्डवानां हितं नित्यं हस्त्यश्वरथघातिनम्।\nवैहायसगतं युद्धे प्रेषयेर्यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2057663, "chapter_id": 2248, "verse_number": "७-१७५-१२", "content_sanskrit": "तथेत्युक्त्वा महाकायः समाहूय घटोत्कचम्।\nजाटासुरिर्भैमसेनिं नानाशस्त्रैरवाकिरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2057664, "chapter_id": 2248, "verse_number": "७-१७५-१३", "content_sanskrit": "अलम्बलं च कर्णं च कुरुसैन्यं च दुस्तरम्।\nहैडिम्बिः प्रममाथैको महाबातोम्बुदानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2057665, "chapter_id": 2248, "verse_number": "७-१७५-१४", "content_sanskrit": "ततो मायाबलं दृष्ट्वा रक्षस्तूर्णमलम्बलः।\nघटोत्कचं शरव्रातैर्नानालिङ्गैः समार्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2057666, "chapter_id": 2248, "verse_number": "७-१७५-१५", "content_sanskrit": "विद्धा च बहुभिर्बाणैर्भैमसेनिं महाबलः।\nव्यद्रावयच्छरव्रातैः पाण्डवानामनीकिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2057667, "chapter_id": 2248, "verse_number": "७-१७५-१६", "content_sanskrit": "तेन विद्राव्यमाणानि पाण्डुसैन्यानि भारत।\nनिशीथे विप्रकीर्यन्ते वातनुन्ना घना इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2057668, "chapter_id": 2248, "verse_number": "७-१७५-१७", "content_sanskrit": "घटोत्कचशरैर्नुन्ना तथैव तव वाहिनी।\nनिशीथे प्राद्रवद्राजन्नुत्सृज्योल्काः सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2057669, "chapter_id": 2248, "verse_number": "७-१७५-१८", "content_sanskrit": "अलम्बलस्ततः क्रुद्धो भैमसेनिं महामृधे।\nआजघ्ने दशभिर्बाणैस्तोत्रैरिव महाद्विपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2057670, "chapter_id": 2248, "verse_number": "७-१७५-१९", "content_sanskrit": "तिxशस्तस्य संवाहं सूतं सर्वायुधानि च।\nघटोत्कचः प्रचिच्छेद प्रणदंश्चातिदारुणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2057671, "chapter_id": 2248, "verse_number": "७-१७५-२०", "content_sanskrit": "ततः कर्णं शरव्रातैः कुरूनन्यान्सहस्रशः।\nअलम्बलं चाभ्यवर्षन्मेघो मेरुमिवाचलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2057672, "chapter_id": 2248, "verse_number": "७-१७५-२१", "content_sanskrit": "ततः सञ्चुक्षुभे सैन्यं कुरूणां राक्षसार्दितम्।\nउपर्युपरि चान्योन्यं चतुरङ्गं ममर्द ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2057673, "chapter_id": 2248, "verse_number": "७-१७५-२२", "content_sanskrit": "जाटासुरिर्महाराज विरथो हतसारथिः।\nघटोत्कचं रणे क्रुद्धो मुष्टिनाऽभ्यहनद्दृढम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2057674, "chapter_id": 2248, "verse_number": "७-१७५-२३", "content_sanskrit": "मुष्टिनाऽभ्याहतस्तेन प्रचचाल घटोत्कचः।\nक्षितिकम्पे यथा शैलः सवृक्षस्तृणगुल्मवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2057675, "chapter_id": 2248, "verse_number": "७-१७५-२४", "content_sanskrit": "ततः स परिघाभेन द्विट्सङ्घघ्नेन बाहुना।\nजाटासुरिं भैमसेनिरवधीन्मुष्टिना भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2057676, "chapter_id": 2248, "verse_number": "७-१७५-२५", "content_sanskrit": "तं प्रमथ्य ततः क्रुद्धस्तूर्णं हैडिम्बिराक्षिपत्।\nदोर्भ्यामिन्द्रध्वजाभाभ्यां निष्पिपेष च भूतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2057677, "chapter_id": 2248, "verse_number": "७-१७५-२६", "content_sanskrit": "जाटासुरिर्मोक्षयित्वा आत्मानं च घटोत्कचात्।\nपुनरुत्थाय वेगेन घटोत्कचमुपाद्रावत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2057678, "chapter_id": 2248, "verse_number": "७-१७५-२७", "content_sanskrit": "अलम्बलोऽपि विक्षिप्य समुत्क्षिप्य च राक्षसम्।\nघटोत्कचं रणे रोषान्निष्पिपेष च भूतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2057679, "chapter_id": 2248, "verse_number": "७-१७५-२८", "content_sanskrit": "तयो समभवद्युद्धं गर्जतोरतिकाययोः।\nघटोत्कचालम्बलयोस्तुमुलं रोमहर्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2057680, "chapter_id": 2248, "verse_number": "७-१७५-२९", "content_sanskrit": "विशेषयन्तावन्योन्यं मायाभिरतिमायिनौ।\nयुयुधाते महावीर्याविन्द्रवैरोचनाविव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2057681, "chapter_id": 2248, "verse_number": "७-१७५-३०", "content_sanskrit": "पावकाम्बुनिधी भूत्वा पुनर्गरुडतक्षकौ।\nपुनर्मेघमहाबत्तौ पुनर्वज्रमहाचलौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2057682, "chapter_id": 2248, "verse_number": "७-१७५-३१", "content_sanskrit": "पुनः कुञ्जरशार्दूलौ पुनः स्वर्भानुभास्करौ।\nएवं मायाशतसृजावन्योन्यवधकाङ्क्षिणौ।\nभृशं चित्रमयुध्येतामलम्बलघटोत्कचौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2057683, "chapter_id": 2248, "verse_number": "७-१७५-३२", "content_sanskrit": "परिघैश्च गदाभिश्च प्रासमुद्ररपट्टसैः।\nमुसलैः पर्वताग्रैश्च तावन्योन्यं विजघ्नतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2057684, "chapter_id": 2248, "verse_number": "७-१७५-३३", "content_sanskrit": "हयाभ्यां च गजाभ्यां च रथाभ्यां च पदातिभिः।\nयुयुधाते महामायौ राक्षसप्रवरौ युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2057685, "chapter_id": 2248, "verse_number": "७-१७५-३४", "content_sanskrit": "ततो घटोत्कचो राजन्नलम्बलवधेप्सया।\nउत्पतात भृशं क्रुद्धः श्येनवन्निपपात च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2057686, "chapter_id": 2248, "verse_number": "७-१७५-३५", "content_sanskrit": "गृहीत्वा च महाकायं राक्षसेन्द्रमलम्बलम्।\nउद्यम्य न्यवधीद्भूमौ मयं विष्णुरिवाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2057687, "chapter_id": 2248, "verse_number": "७-१७५-३६", "content_sanskrit": "ततो घटोत्कचः खङ्गमुद्वृत्याद्भुतदर्शनम्।\nरौद्रस्य कायाद्वि शिरो भीमं विकृतदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2057688, "chapter_id": 2248, "verse_number": "७-१७५-३७", "content_sanskrit": "स्फुरतस्तस्य समरे नदतश्चातिभैरवम्।\nनिचकर्त महाराज शत्रोमितविक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2057689, "chapter_id": 2248, "verse_number": "७-१७५-३८", "content_sanskrit": "शिरस्तच्चापि सङ्गृह्य केशेषु रुधिरोक्षितम्।\nययौ घटोत्कचस्तूर्णं दुर्योधनरथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2057690, "chapter_id": 2248, "verse_number": "७-१७५-३९", "content_sanskrit": "`द्रोणकर्णकृपान्योधानतीत्य सुमहाबलः।\nअभ्येत्य च महाबाहुः स्मयमानः स राक्षसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2057691, "chapter_id": 2248, "verse_number": "७-१७५-४०", "content_sanskrit": "शिरो रथेऽस्य निक्षिप्य विकृताननमूर्धजम्।\nप्राणदद्भैरवं नादं प्रावृषीव वलाहकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2057692, "chapter_id": 2248, "verse_number": "७-१७५-४१", "content_sanskrit": "अब्रवीच्च ततो राजन्दुर्योधनमिदं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2057693, "chapter_id": 2248, "verse_number": "७-१७५-४२", "content_sanskrit": "एष ते निहतो बन्धुस्त्वया दृष्टोऽस्य विक्रमः।\nपुनर्द्रष्टासि कर्णस्य निष्ठामेतां तथाऽऽत्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2057694, "chapter_id": 2248, "verse_number": "७-१७५-४३", "content_sanskrit": "स्वधर्ममर्थं कामं च त्रितयं योऽभिवाञ्छति।\nरिक्तपाणिर्न पश्येत राजानं ब्राह्मणं स्त्रियम्।\nतिष्ठस्व तावत्सुप्रीतो यावत्कर्णं वधाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2057695, "chapter_id": 2248, "verse_number": "७-१७५-४४x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2057696, "chapter_id": 2248, "verse_number": "७-१७५-४४", "content_sanskrit": "एवमुक्त्वा ततः प्रायात्कर्णं प्रति नरेश्वरः।\nकिरञ्छरगणांस्तीक्ष्णान्रुषितो रणमूर्धनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2057697, "chapter_id": 2248, "verse_number": "७-१७५-४५", "content_sanskrit": "ततः समभवद्युद्धं घोररूपं भयानकम्।\nविस्मापनं महाराज नरराक्षसयोर्मृधे॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2057698, "chapter_id": 2248, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि घटोत्कचवधपर्वणि चतुर्दशरात्रियुद्धे पञ्चसप्तत्यधिकशततमोऽध्यायः॥ १७५ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१७५-८ अपचिनिं निष्कृतिम्॥ ५-१७५-४२ निष्ठां नाशम्॥ ५-१७५-१७५ पञ्चसप्तत्यधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]