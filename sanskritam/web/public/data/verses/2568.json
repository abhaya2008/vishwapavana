[{"id": 2074236, "chapter_id": 2568, "verse_number": "१२-७३-०x", "content_sanskrit": "` युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2074237, "chapter_id": 2568, "verse_number": "१२-७३-१", "content_sanskrit": "राज्ञा पुरोहितः कार्यः कीदृशो वर्णतो भवेत्।\nपुरोधा यादृशः कार्यः कथयस्व पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2074238, "chapter_id": 2568, "verse_number": "१२-७३-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2074239, "chapter_id": 2568, "verse_number": "१२-७३-२", "content_sanskrit": "गौरो वा लोहितो वाऽपि श्यामो वा नीरुजः सुखी।\nअक्रोधनो ह्यचपलः सर्वतश्च जितेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2074240, "chapter_id": 2568, "verse_number": "१२-७३-३", "content_sanskrit": "राज्ञा पुरोहितः कार्यो भवेद्विद्वान्बहुश्रुतः।\nउभौ समीक्ष्य धर्मार्थावप्रमेयावनन्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2074241, "chapter_id": 2568, "verse_number": "१२-७३-४", "content_sanskrit": "धर्मात्मा मन्त्रविद्येषां राज्ञां राजन्पुरोहितः।\n`तेषामर्थश्च कामश्च धर्मश्चेति विनिश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2074242, "chapter_id": 2568, "verse_number": "१२-७३-५", "content_sanskrit": "श्लोकाश्चोशनसा गीतास्तान्निबोध युधिष्ठिर।\nउच्छिष्टः स भवेद्राजा यस्य नास्ति पुरोहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2074243, "chapter_id": 2568, "verse_number": "१२-७३-६", "content_sanskrit": "रक्षसामसुराणां च पिशाचोरगपक्षिणाम्।\nशत्रूणां च भवेद्वध्यो यस्य नास्ति पुरोहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2074244, "chapter_id": 2568, "verse_number": "१२-७३-७", "content_sanskrit": "ब्रह्मत्वं सर्वयज्ञेषु कुर्वीताथर्वणो द्विजः।\nराज्ञश्चाथर्ववेदेन सर्वकर्माणि कारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2074245, "chapter_id": 2568, "verse_number": "१२-७३-८", "content_sanskrit": "ब्रूयाद्गर्ह्याणि सततं महोत्पातान्यघानि च।\nइष्टमङ्गलयुक्तानि तथाऽन्तः पुरिकाणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2074246, "chapter_id": 2568, "verse_number": "१२-७३-९", "content_sanskrit": "गीतनृत्ताधिकारेषु संमतेषु महीपतेः।\nकर्तव्यं करणीयं वै वैश्वदेवबलिस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2074247, "chapter_id": 2568, "verse_number": "१२-७३-१०", "content_sanskrit": "पक्षसंधिषु कुर्वीत महाशान्तिं पुरोहितः।\nरौद्रहोमसहस्रं च स्वस्य राज्ञः प्रियं हितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2074248, "chapter_id": 2568, "verse_number": "१२-७३-११", "content_sanskrit": "राज्ञः पापमलाः सप्त यानृच्छति पुरोहितः।\nअमात्याश्च कुकर्माणो मन्त्रिणश्चाप्युपेक्षकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2074249, "chapter_id": 2568, "verse_number": "१२-७३-१२", "content_sanskrit": "चौर्यमव्यवहारश्च व्यवहारोपसेविनाम्।\nअदण्ड्यदण्डनं चैव दण्ड्यानां चाप्यदण्डनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2074250, "chapter_id": 2568, "verse_number": "१२-७३-१३", "content_sanskrit": "हिंसा चान्यत्र संग्रामाद्राज्ञश्च मल उच्यते।\nकुभृत्यैस्तु प्रजानाशः सप्तमस्तु महामलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2074251, "chapter_id": 2568, "verse_number": "१२-७३-१४", "content_sanskrit": "रौद्रैर्होमैर्महाशान्त्या घृतकम्बलकर्मणा।\nभृग्वङ्गिरोविधिज्ञो वै पुरोधा निर्णुदे मलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2074252, "chapter_id": 2568, "verse_number": "१२-७३-१५", "content_sanskrit": "एतान्हित्वा दिवं याति राजा सप्त महामलान्।\nसामात्यः सपुरोधाश्च प्रजानां पालने रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2074253, "chapter_id": 2568, "verse_number": "१२-७३-१६", "content_sanskrit": "एतस्मिन्नेव कौरव्य पौरोहित्ये महामते।\nश्लोकानाह महेन्द्रस्य गुरुर्देवो बृहस्पतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2074254, "chapter_id": 2568, "verse_number": "१२-७३-१७", "content_sanskrit": "तान्निबोध महीपाल महाभाग हिताञ्शुभान्।\nऋग्वेदे सामवेदे च यजुर्वेदे च वाजिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2074255, "chapter_id": 2568, "verse_number": "१२-७३-१८", "content_sanskrit": "न निर्दिष्टानि कर्माणि त्रिषु स्थानेषु भूभृताम्।\nशान्तिकं पौष्टिकं चैव अरिष्टानां च शातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2074256, "chapter_id": 2568, "verse_number": "१२-७३-१९", "content_sanskrit": "शप्तास्ते याज्ञवल्क्येन यज्ञानां हितमीहता।\nब्रह्मिष्ठानां वरिष्ठेन ब्रह्मणः संमते विभोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2074257, "chapter_id": 2568, "verse_number": "१२-७३-२०", "content_sanskrit": "बह्वृचं सामगं चैव वाजिनं च विवर्जयेत्।\nबह्वृचो राष्ट्रनाशाय राजनाशाय सामगः।\nअध्वर्युर्बलनाशाय प्रोक्तो वाजसनेयकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2074258, "chapter_id": 2568, "verse_number": "१२-७३-२१", "content_sanskrit": "अब्राह्मणेषु वर्णेषु मन्त्रान्वाजसनेयकान्।\nशान्तिके पौष्टिके चैव नित्यं कर्मणि वर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2074259, "chapter_id": 2568, "verse_number": "१२-७३-२२", "content_sanskrit": "ब्राह्मणस्य महीपस्य सर्वथा न विरोधिनः।\nवेदाश्चत्वार इत्येते ब्राह्मणा ये च तद्विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2074260, "chapter_id": 2568, "verse_number": "१२-७३-२३", "content_sanskrit": "पौरोहित्ये प्रमाणं तु ब्राह्मणश्च महीपतेः।\nजात्या न क्षत्रियः प्रोक्तः क्षतत्राणं करोति यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2074261, "chapter_id": 2568, "verse_number": "१२-७३-२४", "content_sanskrit": "चातुर्वर्ण्यबहिष्ठोऽपि स एव क्षत्रियः स्मृतः।\nभार्गवाङ्गिरसैर्मन्त्रैस्तेषां कर्म विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2074262, "chapter_id": 2568, "verse_number": "१२-७३-२५", "content_sanskrit": "वैतानं कर्म यच्चैव गृह्यकर्म च यत्स्मृतम्।\nद्विजातीनां त्रयाणां तु सर्वकर्म विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2074263, "chapter_id": 2568, "verse_number": "१२-७३-२६", "content_sanskrit": "राजधर्मप्रवृत्तानां हितार्थं त्रीमि कारयेत्।\nशान्तिकं पौष्टिकं चैव तथाऽभिचरणं च यत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2074264, "chapter_id": 2568, "verse_number": "१२-७३-२७", "content_sanskrit": "अग्निष्टोममुखैर्यज्ञैर्दूषिता भूपकर्मभिः।\nन सम्यक्फलमृच्छन्ति ये यजन्ति द्विजातयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2074265, "chapter_id": 2568, "verse_number": "१२-७३-२८", "content_sanskrit": "पौरोहित्यं तु कुर्वाणा नाशं यास्यन्ति भूभृताम्।\nयज्ञकर्माणि कुर्वाणा ऋत्विजस्तु विरोधिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2074266, "chapter_id": 2568, "verse_number": "१२-७३-२९", "content_sanskrit": "ब्रह्मक्षत्रविशः सर्वे पौरोहित्ये विवर्जिताः।\nतदभावे च पारक्यं निर्दिष्टं राजकर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2074267, "chapter_id": 2568, "verse_number": "१२-७३-३०", "content_sanskrit": "ऋषिणा याज्ञवल्क्येन तत्तथा न तदन्यथा।\nभार्गवाङ्गिरसां वेदे कृतविद्यः षडङ्गवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2074268, "chapter_id": 2568, "verse_number": "१२-७३-३१", "content_sanskrit": "यज्ञकर्मविधिज्ञस्तु विधिज्ञः पौष्टिकेषु च।\nअष्टादशविकल्पानां विधिज्ञः शान्तिकर्मणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2074269, "chapter_id": 2568, "verse_number": "१२-७३-३२", "content_sanskrit": "सर्वरोगविहीनश्च संयतः संयतेन्द्रियः।\nश्वित्रकुष्ठक्षयक्षीणैर्ग्रहापस्मारदूषितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2074270, "chapter_id": 2568, "verse_number": "१२-७३-३३", "content_sanskrit": "अशस्तैर्वातदुष्टैश्च दूरस्थैः संवदेन्नृपः।\nरोगिणं ऋत्विजं चैव वर्जयेच्च पुरोहितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2074271, "chapter_id": 2568, "verse_number": "१२-७३-३४", "content_sanskrit": "नचान्यस्य कृतं येन पौरोहित्यं कदाचन।\nयस्य याज्यो मृतश्चैव भ्रष्टः प्रव्रजितो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2074272, "chapter_id": 2568, "verse_number": "१२-७३-३५", "content_sanskrit": "युद्धे पराजितश्चैव सर्वांस्तान्वर्जयेन्नृपः।\nनक्षत्रस्यानुकूल्येन यः संजातो नरेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2074273, "chapter_id": 2568, "verse_number": "१२-७३-३६", "content_sanskrit": "राजशास्त्रविनीतश्च श्रेयान्राज्ञः पुरोहितः।\nअधन्यानां निमित्तानामुत्पातानामथार्थवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2074274, "chapter_id": 2568, "verse_number": "१२-७३-३७", "content_sanskrit": "शत्रुपक्षक्षयज्ञश्च श्रेयान्राज्ञः पुरोहितः।\nवाजिनं तदभावे च चरकाध्वर्यवानपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2074275, "chapter_id": 2568, "verse_number": "१२-७३-३८", "content_sanskrit": "बह्वृचं सामगं चैव नीतिशास्त्रकृतश्रमान्।\nकृतिनोऽथर्वणो वेदे स्थापयेत्तु पुरोहितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2074276, "chapter_id": 2568, "verse_number": "१२-७३-३९", "content_sanskrit": "हिंसालिङ्गा हि निर्दिष्टा मन्त्रा वैतानिकैर्द्विजैः।\nन तानुच्चारयेत्प्राज्ञः क्षात्रधर्मविरोधिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2074277, "chapter_id": 2568, "verse_number": "१२-७३-४०", "content_sanskrit": "प्रजागुणाः पुरोधाश्च पुरोहितगुणाः प्रजाः।\nराजा वै सगुणो येषां कुशलं तेषु सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2074278, "chapter_id": 2568, "verse_number": "१२-७३-४१", "content_sanskrit": "उभौ प्रजा वर्धयतो देवान्पूर्वापरान्पितॄन्।\nयौ भवेतां स्थितौ धर्मे श्रद्धेयौ सुतपस्विनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2074279, "chapter_id": 2568, "verse_number": "१२-७३-४२", "content_sanskrit": "परस्परस्य सुहृदौ विहितौ समचेतसौ।\nब्रह्मक्षत्रस्य समानात्प्रजा सुखमवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2074280, "chapter_id": 2568, "verse_number": "१२-७३-४३", "content_sanskrit": "विमाननात्तयोरेव प्रजा नश्येयुरेव हि।\nब्रह्मक्षत्रं हि सर्वासां प्रजानां मूलमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2074281, "chapter_id": 2568, "verse_number": "१२-७३-४४", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nऐलकश्यपसंवादं तं निबोध युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2074282, "chapter_id": 2568, "verse_number": "१२-७३-४५x", "content_sanskrit": "ऐल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2074283, "chapter_id": 2568, "verse_number": "१२-७३-४५", "content_sanskrit": "यदा हि ब्रह्म प्रजहाति क्षत्रं\nक्षत्रं यदा वा प्रजहाति ब्रह्म।\nअन्वग्बलं कतमेऽस्मिन्भजन्ते\nतथा बलं कतमेऽस्मिन्ध्रियन्ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2074284, "chapter_id": 2568, "verse_number": "१२-७३-४६x", "content_sanskrit": "कश्यप उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2074285, "chapter_id": 2568, "verse_number": "१२-७३-४६", "content_sanskrit": "द्विधा हि राष्ट्रं भवति क्षत्रियस्य\nब्रह्म क्षत्रं यत्र विरुध्यतीह।\nअन्वग्बलं दस्यवस्तद्भजन्ते\nतथा वर्णं तत्र विदन्ति सन्तः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2074286, "chapter_id": 2568, "verse_number": "१२-७३-४७", "content_sanskrit": "नैषां ब्रह्म च वर्धते नोत पुत्रा\nन गर्गरो मथ्यते नो जयन्ते।\nनैषां पुत्रा देवमधीयते च\nयदा ब्रह्म क्षत्रियाः संत्यजन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2074287, "chapter_id": 2568, "verse_number": "१२-७३-४८", "content_sanskrit": "नैषामर्थो वर्धते जातु गेहे\nनाधीयते तत्प्रजा नो यजन्ते।\nअपध्वस्ता दस्युभूता भवन्ति\nये ब्राह्मणान्क्षत्रियाः संत्यजन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2074288, "chapter_id": 2568, "verse_number": "१२-७३-४९", "content_sanskrit": "एतौ हि नित्यं संयुक्तावितरेतरधारणे।\nक्षत्रं वै ब्रह्मणो योनिर्योनिः क्षत्रस्य वै द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2074289, "chapter_id": 2568, "verse_number": "१२-७३-५०", "content_sanskrit": "उभावेतौ नित्यमभिप्रपन्नौ\nसंप्रापतुर्महतीं संप्रतिष्ठाम्।\nतयोः सन्धिर्भिद्यते चेत्पुराण\nस्ततः सर्वं भवति हि संप्रमूढम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2074290, "chapter_id": 2568, "verse_number": "१२-७३-५१", "content_sanskrit": "नात्र पारं लभते पारगामी\nमहोदधौ नौरिव संप्रभिन्ना।\nचातुर्वण्यं भवति हि संप्रमूढं\nप्रजास्ततः क्षयसंस्था भवन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2074291, "chapter_id": 2568, "verse_number": "१२-७३-५२", "content_sanskrit": "ब्रह्मवृक्षो रक्ष्यमाणो मधु हेम च वर्षति।\nअरक्ष्यमाणः सततमश्रु पापं च वर्षति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2074292, "chapter_id": 2568, "verse_number": "१२-७३-५३", "content_sanskrit": "अब्रह्मचारी चरणादपेतो\nयदा ब्रह्म ब्रह्मणि त्राणमिच्छेत्।\nआश्चर्यतो वर्षति तत्र देव\nस्तत्राभीक्ष्णं दुष्प्रभाश्चाविशन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2074293, "chapter_id": 2568, "verse_number": "१२-७३-५४", "content_sanskrit": "स्त्रियं हत्वा ब्राह्मणं वाऽपि पापः\nसभायां यत्र लभते साधुवादम्।\nराज्ञः सकाशे न विभेति चापि\nततो भयं विद्यते क्षत्रियस्य॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2074294, "chapter_id": 2568, "verse_number": "१२-७३-५५", "content_sanskrit": "पापैः पापे क्रियमाणेऽतिवेलं\nततो रुद्रो जायते देव एषः।\nपापैः पापाः संजनयन्ति रुद्रं\nततः सर्वान्साध्वसाधून्हिनस्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2074295, "chapter_id": 2568, "verse_number": "१२-७३-५६x", "content_sanskrit": "ऐल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2074296, "chapter_id": 2568, "verse_number": "१२-७३-५६", "content_sanskrit": "कुतो रुद्रः कीदृशो वाऽपि रुद्रः\nसत्वैः सत्वं दृश्यते वध्यमानम्।\nएतत्सर्वं कश्यप मे प्रचक्ष्व\nयतो रुद्रो जायते देव एषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2074297, "chapter_id": 2568, "verse_number": "१२-७३-५७x", "content_sanskrit": "कश्यप उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2074298, "chapter_id": 2568, "verse_number": "१२-७३-५७", "content_sanskrit": "आत्मा रुद्रो हृदये मानवानां\nस्वं स्वं देहं परदेहं च हन्ति।\nवातोत्पातैः सदृशं रुद्रमाहु\nर्देवं जीमूतैः सदृशं रूपमस्य॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2074299, "chapter_id": 2568, "verse_number": "१२-७३-५८x", "content_sanskrit": "ऐल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2074300, "chapter_id": 2568, "verse_number": "१२-७३-५८", "content_sanskrit": "न वै वातः परिवृणोति कश्चि\nन्न जीमूतो वर्षति तत्र देवः।\nतथा युक्तो दृश्यते मानुषेषु\nकामद्वेषाद्वध्यते मुह्यते च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2074301, "chapter_id": 2568, "verse_number": "१२-७३-५९x", "content_sanskrit": "कश्यप उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2074302, "chapter_id": 2568, "verse_number": "१२-७३-५९", "content_sanskrit": "यथैकगेहाज्जातवेदाः प्रदीप्तः\nकृत्स्नं ग्रामं दहते च त्वरावान्।\nविमोहनं कुरुते देव एप\nततः सर्वं स्पृश्यते पुण्यपापैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2074303, "chapter_id": 2568, "verse_number": "१२-७३-६०x", "content_sanskrit": "ऐल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2074304, "chapter_id": 2568, "verse_number": "१२-७३-६०", "content_sanskrit": "यदि दण्डः स्पृशतेऽपुण्यपापं\nपापं पापे क्रियमाणे विशेषात्।\nकस्य हेतोः सुकृतं नाम कुर्या\nद्दुष्कृतं वा कस्य हेतोर्न कुर्यात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2074305, "chapter_id": 2568, "verse_number": "१२-७३-६१x", "content_sanskrit": "कश्यप उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2074306, "chapter_id": 2568, "verse_number": "१२-७३-६१", "content_sanskrit": "असंत्यागात्पापकृतामपापां\nस्तुल्यो दण्डः स्पृशते मिश्रभावात्।\nशुष्केणार्द्रं दह्यते मिश्रभावा\nन्न मिश्रः स्यात्पापकृद्भिः कथंचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2074307, "chapter_id": 2568, "verse_number": "१२-७३-६२x", "content_sanskrit": "ऐल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2074308, "chapter_id": 2568, "verse_number": "१२-७३-६२", "content_sanskrit": "साध्वसाधून्धारयतीह भूमिः\nसाध्वसाधूंस्तापयतीह सूर्यः।\nसाध्वसाधूंश्चापि वातीह वायु\nरापस्तथा साध्वसाधून्वहन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2074309, "chapter_id": 2568, "verse_number": "१२-७३-६३x", "content_sanskrit": "कश्यप उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2074310, "chapter_id": 2568, "verse_number": "१२-७३-६३", "content_sanskrit": "एवमस्मिन्वर्तते लोक एष\nनामुत्रैवं वर्तते राजपुत्र।\nप्रेत्यैतयोरन्तरावान्विशेषो\nयो वै पुण्यं चरते यश्च पापम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2074311, "chapter_id": 2568, "verse_number": "१२-७३-६४", "content_sanskrit": "पुण्यस्य लोको मधुमान्घृतार्चि\nर्हिरण्यज्योतिरमृतस्य नाभिः।\nतत्र प्रेत्य मोदते ब्रह्मचारी\nन तत्र मृत्युर्न जरा नोत दुःखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2074312, "chapter_id": 2568, "verse_number": "१२-७३-६५", "content_sanskrit": "पापस्य लोको निरयोऽप्रकाशो\nनित्यं दुःखं शोकभूयिष्ठमेव।\nतत्रात्मानं शोचति पापकर्मा\nवह्वीः समाः प्रतपन्नप्रतिष्ठः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2074313, "chapter_id": 2568, "verse_number": "१२-७३-६६", "content_sanskrit": "मिथोभेदाद्ब्राह्मणक्षत्रियाणां\nप्रजा दुःखं दुःसहं चाविशन्ति।\nएवं ज्ञात्वा कार्य एवेह विद्वान्\nपुरोहितो नैकविद्यो नृपेण॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2074314, "chapter_id": 2568, "verse_number": "१२-७३-६७", "content_sanskrit": "तं चैव लब्ध्वाभिषिञ्चेत्तथा धर्मो विधीयते।\nअग्रं हि ब्राह्मणः प्रोक्तं सर्वस्यैवेह धर्मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2074315, "chapter_id": 2568, "verse_number": "१२-७३-६८", "content_sanskrit": "पूर्वं हि ब्रह्मणः सृष्टिरिति ब्रह्मविदो विदुः।\nज्येष्ठेनाभिजनेनास्य प्राप्तं पूर्वं यदुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2074316, "chapter_id": 2568, "verse_number": "१२-७३-६९", "content_sanskrit": "तस्मान्मान्यश्च पूज्यश्च ब्राह्मणः प्रसृताग्रभुक्।\nसर्वं श्रेष्ठं विशिष्टं च निवेद्यं तस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2074317, "chapter_id": 2568, "verse_number": "१२-७३-७०", "content_sanskrit": "अवश्यमेतत्कर्तव्यं राज्ञा बलवताऽपि हि।\nब्रह्म वर्धयति क्षत्रं क्षत्रतो ब्रह्म वर्धते।\nराज्ञः सर्वस्य चान्यस्य स्वामी राज्ञः पुरोहितः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2074318, "chapter_id": 2568, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि त्रिसप्ततितमोऽध्यायः॥ ७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}]