[{"id": 2077923, "chapter_id": 2652, "verse_number": "१२-१५७-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2077924, "chapter_id": 2652, "verse_number": "१२-१५७-१", "content_sanskrit": "अनर्थानामधिष्ठानमुक्तो लोभः पितामह।\nअज्ञानमपि कौरव्य श्रोतुमिच्छामि तत्त्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2077925, "chapter_id": 2652, "verse_number": "१२-१५७-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2077926, "chapter_id": 2652, "verse_number": "१२-१५७-२", "content_sanskrit": "करोति पापं योऽज्ञानान्नात्मनो वेत्ति च क्षमम्।\nद्विषते साधुवृत्तांश्च स लोकस्यैति वाच्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2077927, "chapter_id": 2652, "verse_number": "१२-१५७-३", "content_sanskrit": "अज्ञानान्निरयं याति तथा ज्ञानेन दुर्गतिम्।\nअज्ञानात्क्लेशमाप्नोति तथाऽऽपत्सु निमज्जति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2077928, "chapter_id": 2652, "verse_number": "१२-१५७-४x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2077929, "chapter_id": 2652, "verse_number": "१२-१५७-४", "content_sanskrit": "प्रजानामप्रवृत्तिं च ज्ञानवृद्धिक्षयोदयान्।\nमूलं स्थानं गतिं कालं कारणं हेतुमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2077930, "chapter_id": 2652, "verse_number": "१२-१५७-५", "content_sanskrit": "श्रोतुमिच्छामि तत्त्वेन यथावदिह पार्थिव।\nअज्ञानप्रसवं हीदं यद्दुःखमुपलभ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2077931, "chapter_id": 2652, "verse_number": "१२-१५७-६x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2077932, "chapter_id": 2652, "verse_number": "१२-१५७-६", "content_sanskrit": "रागो द्वेषस्तथा मोहो हर्षः शोकोऽभिमानिता।\nकामः क्रोधश्च दर्पश्च तन्द्री चालस्यमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2077933, "chapter_id": 2652, "verse_number": "१२-१५७-७", "content_sanskrit": "इच्छा द्वेषस्तथा तापः परवृद्ध्युपतापिता।\nअज्ञानमेन्निर्दिष्टं पापानां चैव याः क्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2077934, "chapter_id": 2652, "verse_number": "१२-१५७-८", "content_sanskrit": "एतस्य वा प्रवृत्तेश्च वृद्ध्यादीन्यांश्च पृच्छसि।\nविस्तरेण महाराज शृणु तच्च विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2077935, "chapter_id": 2652, "verse_number": "१२-१५७-९", "content_sanskrit": "उभावेतौ समफलौ समदोषौ च भारत।\nअज्ञानं चातिलोभश्चाप्येवं जानीहि पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2077936, "chapter_id": 2652, "verse_number": "१२-१५७-१०", "content_sanskrit": "लोभप्रभवमज्ञानं वृद्धं भूयः प्रवर्धते।\nस्थाने स्थानं क्षयेत्क्षीणमुपैति विविधां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2077937, "chapter_id": 2652, "verse_number": "१२-१५७-११", "content_sanskrit": "मूलं लोभस्य मोहो वै कालात्मगतिरेव च।\n[छिन्ने भिन्ने तथा लोभे कारणं काल एव च॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2077938, "chapter_id": 2652, "verse_number": "१२-१५७-१२", "content_sanskrit": "तस्याज्ञानाद्धि लोभो हि कामात्मा गतिरेव च।\nसर्वे दोषास्तथा लोभात्तस्माल्लोभं विवर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2077939, "chapter_id": 2652, "verse_number": "१२-१५७-१३", "content_sanskrit": "जनको युवनाश्वश्च पृषदश्वः प्रसेनजित्।\nलोभक्षयाद्दिवं प्राप्तास्तथैवान्ये नराधिपाः।\n`छिन्ने छिन्ने तथा लोभे दिवं प्राप्ता जनाधिपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2077940, "chapter_id": 2652, "verse_number": "१२-१५७-१४", "content_sanskrit": "प्रत्यक्षं तु कुरुश्रेष्ठ त्यज लोभमिहात्मना।\nत्यक्त्वा लोभं सुखी लोके प्रेत्य चेह च मोदते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2077941, "chapter_id": 2652, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि सप्तपञ्चाशदधिकशततमोऽध्यायः॥ १५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]