[{"id": 5000549000, "chapter_id": 9549, "verse_number": "७-१४-१", "content_sanskrit": "ततस्तु सचिवैः सार्धं षड्भिर्नित्यं बलोद्धतैः ।\nमहोदरप्रहस्ताभ्यां मारीचशुकसारणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000549001, "chapter_id": 9549, "verse_number": "७-१४-२", "content_sanskrit": "धूम्राक्षेण च वीरेण नित्यं समरगृध्नुना ।\nवृतः संप्रययौ श्रीमान्क्रोधाल्लोकान्दहन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000549002, "chapter_id": 9549, "verse_number": "७-१४-३", "content_sanskrit": "पुराणि स नदीः शैलान्वनान्युपवनानि च ।\nअतिक्रम्य मुहूर्तेन कैलासं गिरिमागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000549003, "chapter_id": 9549, "verse_number": "७-१४-४", "content_sanskrit": "सन्निविष्टं गिरौ तस्मिन्राक्षसेन्द्रं निशम्य तु ।\nयुद्धे ऽत्यर्थकृतोत्साहं दुरात्मानं समन्त्रिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000549004, "chapter_id": 9549, "verse_number": "७-१४-५", "content_sanskrit": "यक्षा न शेकुः संस्थातुं प्रमुखे तस्य रक्षसः ।\nराज्ञो भ्रातेति विज्ञाय गता यत्र धनेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000549005, "chapter_id": 9549, "verse_number": "७-१४-६", "content_sanskrit": "ते गत्वा सर्वमाचख्युर्भ्रातुस्तस्य चिकीर्षितम् ।\nअनुज्ञाता ययुर्हष्टा युद्धाय धनदेन ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000549006, "chapter_id": 9549, "verse_number": "७-१४-७", "content_sanskrit": "ततो बलानां सङ्क्षोभो व्यवर्धत महोदधेः ।\nतस्य नैर्ऋतराजस्य शैलं सञ्चालयन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000549007, "chapter_id": 9549, "verse_number": "७-१४-८", "content_sanskrit": "ततो युद्धं समभवद्यक्षराक्षससङ्कुलम् ।\nव्यथिताश्चाभवंस्तत्र सचिवा राक्षसस्य ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000549008, "chapter_id": 9549, "verse_number": "७-१४-९", "content_sanskrit": "स दृष्ट्वा तादृशं सैन्यं दशग्रीवो निशाचरः ।\nहर्षनादान्बहून्कृत्वा स क्रोधादभ्यधावत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000549009, "chapter_id": 9549, "verse_number": "७-१४-१०", "content_sanskrit": "ये तु ते राक्षसेन्द्रस्य सचिवा घोरविक्रमाः ।\nतेषां सहस्रमेकैकं यक्षाणां समयोधयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000549010, "chapter_id": 9549, "verse_number": "७-१४-११", "content_sanskrit": "ततो गदाभिर्मुसलैरसिभिः शक्तितोमरैः ।\nहन्यमानो दशग्रीवस्तत्सैन्यं समगाहत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000549011, "chapter_id": 9549, "verse_number": "७-१४-१२", "content_sanskrit": "स निरुच्छ्वासवत्तत्र वध्यमानो दशाननः ।\nवर्षद्भिरिव जीमूतैर्धाराभिरवरुध्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000549012, "chapter_id": 9549, "verse_number": "७-१४-१३", "content_sanskrit": "न चकार व्यथां चैव यक्षशस्त्रैः समाहतः ।\nमहीधर इवाम्भोदैर्धाराशतसमुक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000549013, "chapter_id": 9549, "verse_number": "७-१४-१४", "content_sanskrit": "स दुरात्मा समुद्यम्य कालदण्डोपमां गदाम् ।\nप्रविवेश ततः सैन्यं नयन्यक्षान्यमक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000549014, "chapter_id": 9549, "verse_number": "७-१४-१५", "content_sanskrit": "स कक्षमिव विस्तीर्णं शुष्केन्धनमिवाकुलम् ।\nवातेनाग्निरिवायत्तो यक्षसैन्यं ददाह तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000549015, "chapter_id": 9549, "verse_number": "७-१४-१६", "content_sanskrit": "तैस्तु तत्र महामात्यैर्महोदरशुकादिभिः ।\nअल्पावशेषास्ते यक्षाः कृता वातैरिवाम्बुदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000549016, "chapter_id": 9549, "verse_number": "७-१४-१७", "content_sanskrit": "केचित्समाहता भग्नाः पतिताः समरक्षितौ ।\nओष्ठांश्च दशनैस्तीक्ष्णैरदशन्कुपिता रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000549017, "chapter_id": 9549, "verse_number": "७-१४-१८", "content_sanskrit": "श्रान्ताश्चान्योन्यमालिङ्ग्य भ्रष्टशस्त्रा रणाजिरे ।\nसीदन्ति च तदा यक्षाः कूला इव जलेन ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000549018, "chapter_id": 9549, "verse_number": "७-१४-१९", "content_sanskrit": "हतानां गच्छतां स्वर्गं युध्यतां पृथिवीतले ।\nप्रेक्षतामृषिसङ्घानां न बभूवान्तरं दिवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000549019, "chapter_id": 9549, "verse_number": "७-१४-२०", "content_sanskrit": "भग्नांस्तु तान्समालक्ष्य यक्षेन्द्रांस्तु महाबलान् ।\nधनाध्यक्षो महाबाहुः प्रेषयामास यक्षकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000549020, "chapter_id": 9549, "verse_number": "७-१४-२१", "content_sanskrit": "एतस्मिन्नन्तरे राम विस्तीर्णबलवाहनः ।\nप्रेषितो न्यपतद्यक्षो नाम्ना संयोधकण्टकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000549021, "chapter_id": 9549, "verse_number": "७-१४-२२", "content_sanskrit": "तेन चक्रेण मारीचो विष्णुनेव रणे हतः ।\nपतितो भूतले शैलात्क्षीणपुण्य इव ग्रहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000549022, "chapter_id": 9549, "verse_number": "७-१४-२३", "content_sanskrit": "ससञ्ज्ञस्तु मुहूर्तेन स विश्रम्य निशाचरः ।\nतं यक्षं योधयामास स च भग्नः प्रदुद्रुवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000549023, "chapter_id": 9549, "verse_number": "७-१४-२४", "content_sanskrit": "ततः काञ्चनचित्राङ्गं वैडूर्यरजसोक्षितम् ।\nमर्यादां प्रतिहाराणां तोरणान्तरमाविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000549024, "chapter_id": 9549, "verse_number": "७-१४-२५", "content_sanskrit": "तं तु राजन्दशग्रीवं प्रविशन्तं निशाचरम् ।\nसूर्यभानुरिति ख्यातो द्वारपालो न्यवारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000549025, "chapter_id": 9549, "verse_number": "७-१४-२६", "content_sanskrit": "स वार्यमाणो यक्षेण प्रविवेश निशाचरः ।\nयदा तु वारितो राम न व्यतिष्ठत्स राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000549026, "chapter_id": 9549, "verse_number": "७-१४-२७", "content_sanskrit": "ततस्तोरणमुत्पाट्य तेन यक्षेण ताडितः ।\nरुधिरं प्रस्रवन्भाति शैलो धातुस्रवैरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000549027, "chapter_id": 9549, "verse_number": "७-१४-२८", "content_sanskrit": "स शैलशिखराभेण तोरणेन समाहतः ।\nजगाम न क्षतिं वीरो वरदानात्स्वयम्भुवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000549028, "chapter_id": 9549, "verse_number": "७-१४-२९", "content_sanskrit": "तेनैव तोरणेनाथ यक्षस्तेनाभिताडितः ।\nनादृश्यत तदा यक्षो भस्मीकृततनुस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000549029, "chapter_id": 9549, "verse_number": "७-१४-३०", "content_sanskrit": "ततः प्रदुद्रुवुः सर्वे दृष्ट्वा रक्षःपराक्रमम् ।\nततो नदीर्गुहाश्चैव विविशुर्भयपीडिताः ।\nत्यक्तप्रहरणाः श्रान्ता विवर्णवदनास्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000549030, "chapter_id": 9549, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे चतुर्दशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]