[{"id": 7001201000, "chapter_id": 21201, "verse_number": "२-३-४९-१", "content_sanskrit": "॥ ब्रह्मोवाच  ।\nअथो ममाज्ञया विप्रैस्संस्थाप्यानलमीश्वरः ।\nहोमं चकार तत्रैवमङ्के संस्थाप्य पार्वतीम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001201001, "chapter_id": 21201, "verse_number": "२-३-४९-२", "content_sanskrit": "ऋग्यजुस्साममन्त्रैश्चाहुतिं वह्नौ ददौ शिवः ।\nलाजाञ्जलिं ददौ कालीभ्राता मैनाकसंज्ञकः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001201002, "chapter_id": 21201, "verse_number": "२-३-४९-३", "content_sanskrit": "अथ काली शिवश्चोभौ चक्रतुर्विधिवन्मुदा ।\nवह्निप्रदक्षिणां तात लोकाचारं विधाय च॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001201003, "chapter_id": 21201, "verse_number": "२-३-४९-४", "content_sanskrit": "तत्राद्भुतमलञ्चक्रे चरितं गिरिजापतिः ।\nतदेव शृणु देवर्षे तवस्नेहाद्ब्रवीम्यहम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001201004, "chapter_id": 21201, "verse_number": "२-३-४९-५", "content_sanskrit": "तस्मिन्नवसरे चाहं शिवमायाविमोहितः ।\nअपश्यञ्चरणे देव्या नखेन्दुञ्च मनोहरम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001201005, "chapter_id": 21201, "verse_number": "२-३-४९-६", "content_sanskrit": "दर्शनात्तस्य च तदाऽभूवं देवमुने ह्यहम् ।\nमदनेन समाविष्टोऽतीव क्षुभितमानसः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001201006, "chapter_id": 21201, "verse_number": "२-३-४९-७", "content_sanskrit": "मुहुर्मुहुरपश्यं वै तदंगं स्मरमोहितः ।\nततस्तद्दर्शनात्सद्यो वीर्यं मे प्राच्युतद्भुवि॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001201007, "chapter_id": 21201, "verse_number": "२-३-४९-८", "content_sanskrit": "रेतसा क्षरता तेन लज्जितोहं पितामहः ।\nमुने व्यमर्द तच्छिन्नं चरणाभ्यां हि गोपयन्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001201008, "chapter_id": 21201, "verse_number": "२-३-४९-९", "content_sanskrit": "तज्ज्ञात्वा च महादेवश्चुकोपातीव नारद ।\nहन्तुमैच्छत्तदा शीघ्रं वां विधिं काममोहितम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001201009, "chapter_id": 21201, "verse_number": "२-३-४९-१०", "content_sanskrit": "हाहाकारो महानासीत्तत्र सर्वत्र नारद ।\nजनाश्च कम्पिरे सर्व्वे भय मायाति विश्वभृत्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001201010, "chapter_id": 21201, "verse_number": "२-३-४९-११", "content_sanskrit": "ततस्तंन्तुष्टुवुश्शम्भुं विष्ण्वाद्या निर्जरा मुने ।\nसकोपम्प्रज्वलन्तन्तन्तेजसा हन्तुमुद्यतम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001201011, "chapter_id": 21201, "verse_number": "२-३-४९-१२", "content_sanskrit": "देवा ऊचुः ।\nदेवदेव जगद्व्यापिन्परमेश सदाशिव ।\nजगदीश जगन्नाथ सम्प्रसीद जगन्मय॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001201012, "chapter_id": 21201, "verse_number": "२-३-४९-१३", "content_sanskrit": "सर्वेषामपि भावानान्त्वमात्मा हेतुरीश्वरः ।\nनिर्विकारोऽव्ययो नित्यो निर्विकल्पोऽक्षरः परः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001201013, "chapter_id": 21201, "verse_number": "२-३-४९-१४", "content_sanskrit": "आद्यन्तावस्य यन्मध्यमिदमन्यदहम्बहिः ।\nयतोऽव्ययः सनैतानि तत्सत्यम्ब्रह्म चिद्भवान्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001201014, "chapter_id": 21201, "verse_number": "२-३-४९-१५", "content_sanskrit": "तवैव चरणाम्भोजम्मुक्तिकामा दृढव्रताः ।\nविसृज्योभयतस्संगं मुनयस्समुपासते॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001201015, "chapter_id": 21201, "verse_number": "२-३-४९-१६", "content_sanskrit": "त्वम्ब्रह्म पूर्णममृतं विशोकं निर्गुणम्परम् ।\nआनंदमात्रमव्यग्रमविकारमनात्मकम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001201016, "chapter_id": 21201, "verse_number": "२-३-४९-१७", "content_sanskrit": "विश्वस्य हेतुरुदयस्थितिसंयमनस्य हि ।\nतदपेक्षतयात्मेशोऽनपेक्षस्सर्वदा विभुः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001201017, "chapter_id": 21201, "verse_number": "२-३-४९-१८", "content_sanskrit": "एकस्त्वमेव सदसद्वयमद्वयमेव च ।\nस्वर्णं कृताकृतमिव वस्तुभेदो न चैव हि॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001201018, "chapter_id": 21201, "verse_number": "२-३-४९-१९", "content_sanskrit": "अज्ञानतस्त्वयि जनैर्विकल्पो विदितो यतः ।\nतस्माद्भ्रमप्रतीकारो निरुपाधेर्न हि स्वतः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001201019, "chapter_id": 21201, "verse_number": "२-३-४९-२०", "content_sanskrit": "धन्या वयं महेशान तव दर्शनमात्रतः ।\nदृढभक्तजनानन्दप्रदश्शम्भो दयां कुरु॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001201020, "chapter_id": 21201, "verse_number": "२-३-४९-२१", "content_sanskrit": "त्वमादिस्त्वमनादिश्च प्रकृतेस्त्वं परः पुमान् ।\nविश्वेश्वरो जगन्नाथो निर्विकारः परात्परः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001201021, "chapter_id": 21201, "verse_number": "२-३-४९-२२", "content_sanskrit": "योऽयं ब्रह्मास्तिऽ रजसा विश्वमूर्तिः पितामहः ।\nत्वत्प्रसादात्प्रभो विष्णुस्सत्त्वेन पुरुषोत्तमः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001201022, "chapter_id": 21201, "verse_number": "२-३-४९-२३", "content_sanskrit": "कालाग्निरुद्रस्तमसा परमात्मा गुणः परः ।\nसदा शिवो महेशानस्सर्वव्यापी महेश्वरः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001201023, "chapter_id": 21201, "verse_number": "२-३-४९-२४", "content_sanskrit": "व्यक्तं महच्च भूतादिस्तन्मात्राणीन्द्रियाणि च ।\nत्वयैवाधिष्ठितान्येव विश्वमूर्ते महेश्वर॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001201024, "chapter_id": 21201, "verse_number": "२-३-४९-२५", "content_sanskrit": "महादेव परेशान करुणाकर शंकर ।\nप्रसीद देवदेवेश प्रसीद पुरुषोत्तम॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001201025, "chapter_id": 21201, "verse_number": "२-३-४९-२६", "content_sanskrit": "वासांसि सागरास्सप्त दिशश्चैव महाभुजाः ।\nद्यौर्मूर्द्धा ते विभोर्नाभिः खं वायुर्नासिका ततः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001201026, "chapter_id": 21201, "verse_number": "२-३-४९-२७", "content_sanskrit": "चक्षूंष्यग्नी रविस्सोमः केशा मेघास्तव प्रभो ।\nनक्षत्रतारकाद्याश्च ग्रहाश्चैव विभूषणम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001201027, "chapter_id": 21201, "verse_number": "२-३-४९-२८", "content_sanskrit": "कथं स्तोष्यामि देवेश त्वां विभो परमेश्वर ।\nवाचामगोचरोऽसि त्वं मनसा चापि शंकर॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001201028, "chapter_id": 21201, "verse_number": "२-३-४९-२९", "content_sanskrit": "पञ्चास्याय च रुद्राय पञ्चाशत्कोटिमूर्तये ।\nत्र्यधिपाय वरिष्ठाय विद्यातत्त्वाय ते नमः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001201029, "chapter_id": 21201, "verse_number": "२-३-४९-३०", "content_sanskrit": "अनिदेंश्याय नित्याय विद्युज्ज्वालाय रूपिणे ।\nअग्निवर्णाय देवाय शंकराय नमोनमः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001201030, "chapter_id": 21201, "verse_number": "२-३-४९-३१", "content_sanskrit": "विद्युत्कोटिप्रतीकाशमष्टकोणं सुशोभनम् ।\nरूपमास्थाय लोकेऽस्मिन्संस्थिताय नमो नमः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001201031, "chapter_id": 21201, "verse_number": "२-३-४९-३२", "content_sanskrit": "ब्रह्मोवाच ।\nइत्याकर्ण्य वचस्तेषां प्रसन्नः परमेश्वरः ।\nब्रह्मणो मे ददौ शीघ्रमभयं भक्तवत्सलः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001201032, "chapter_id": 21201, "verse_number": "२-३-४९-३३", "content_sanskrit": "अथ सर्वे सुरास्तत्र विष्ण्वाद्या मुनयस्तथा ।\nअभवन्सुस्मितास्तात चक्रुश्च परमोत्सवम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001201033, "chapter_id": 21201, "verse_number": "२-३-४९-३४", "content_sanskrit": "मम तद्रेतसा तात मर्दितेन मुहुर्मुहुः ।\nअभवन्कणकास्तत्र भूरिशः परमोज्ज्वलाः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001201034, "chapter_id": 21201, "verse_number": "२-३-४९-३५", "content_sanskrit": "ऋषयो बहवो जाता वालखिल्यास्सहस्रशः ।\nकणकैस्तैश्च वीर्यस्य प्रज्वलद्भिः स्वतेजसा॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001201035, "chapter_id": 21201, "verse_number": "२-३-४९-३६", "content_sanskrit": "अथ ते ह्यृषयस्सर्वे उपतस्थुस्तदा मुने ।\nममान्तिकं परप्रीत्या तात तातेति चाब्रुवन्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001201036, "chapter_id": 21201, "verse_number": "२-३-४९-३७", "content_sanskrit": "ईश्वरेच्छाप्रयुक्तेन प्रोक्तास्ते नारदेन हि ।\nवालखिल्यास्तु ते तत्र कोपयुक्तेन चेतसा॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001201037, "chapter_id": 21201, "verse_number": "२-३-४९-३८", "content_sanskrit": "॥ नारद उवाच  ।\nगच्छध्वं संगता यूयं पर्वतं गन्धमादनम् ।\nन स्थातव्यम्भवद्भिश्च न हि वोऽत्र प्रयोजनम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001201038, "chapter_id": 21201, "verse_number": "२-३-४९-३९", "content_sanskrit": "तत्र तप्त्वा तपश्चाति भवितारो मुनीश्वराः ।\nसूर्य्यशिष्याश्शिवस्यैवाज्ञया मे कथितन्त्विदम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001201039, "chapter_id": 21201, "verse_number": "२-३-४९-४०", "content_sanskrit": "॥ ब्रह्मोवाच  ।\nइत्युक्तास्ते तदा सर्वे बालखिल्याश्च पर्वतम् ।\nसत्वरम्प्रययुर्नत्वा शंकरं गन्धमादनम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001201040, "chapter_id": 21201, "verse_number": "२-३-४९-४१", "content_sanskrit": "विष्ण्वादिभिस्तदाभूवं श्वासितोहं मुनीश्वर ।\nनिर्भयः परमेशानप्रेरितैस्तैर्महात्मभिः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001201041, "chapter_id": 21201, "verse_number": "२-३-४९-४२", "content_sanskrit": "अस्तवञ्चापि सर्वेशं शंकरम्भक्तवत्सलम् ।\nसर्वकार्यकरं ज्ञात्वा दुष्टगर्वापहारकम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001201042, "chapter_id": 21201, "verse_number": "२-३-४९-४३", "content_sanskrit": "देवदेव महादेव करुणासागर प्रभो ।\nत्वमेव कर्ता सर्वस्य भर्ता हर्त्ता च सर्वथा॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001201043, "chapter_id": 21201, "verse_number": "२-३-४९-४४", "content_sanskrit": "त्वदिच्छया हि सकलं स्थितं हि सचराचरम् ।\nतन्त्यां यथा बलीवर्दा मया ज्ञातं विशेषतः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001201044, "chapter_id": 21201, "verse_number": "२-३-४९-४५", "content_sanskrit": "इत्येवमुक्त्वा सोहं वै प्रणामं च कृताञ्जलिः ।\nअन्येऽपि तुष्टुवुस्सर्वे विष्ण्वाद्यास्तं महेश्वरम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001201045, "chapter_id": 21201, "verse_number": "२-३-४९-४६", "content_sanskrit": "अथाकर्ण्य नुतिं शुद्धां मम दीनतया तदा ।\nविष्ण्वादीनाञ्च सर्वेषां प्रसन्नोऽभून्महेश्वरः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001201046, "chapter_id": 21201, "verse_number": "२-३-४९-४७", "content_sanskrit": "ददौ सोतिवरं मह्यमभयं प्रीतमानसः ।\nसर्वे सुखमतीवापुरत्यमोदमहं मुने॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]