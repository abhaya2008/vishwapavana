[{"id": 2039595, "chapter_id": 1874, "verse_number": "५-११९-०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2039596, "chapter_id": 1874, "verse_number": "५-११९-१", "content_sanskrit": "गालवं वैनतेयोऽथ प्रहसन्निदमब्रवीत्।\nदिष्ट्या कृतार्थं पश्यामि भवन्तमिह वै द्विज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2039597, "chapter_id": 1874, "verse_number": "५-११९-२", "content_sanskrit": "गालवस्तु वचः श्रुत्वा वैनतेयेन भाषितम् ।\nचतुर्भागावशिष्टं तदाचख्यौ कार्यमस्य हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2039598, "chapter_id": 1874, "verse_number": "५-११९-३", "content_sanskrit": "सुपर्णस्त्वब्रवीदेनं गालवं वदतां वरः।\nप्रयत्नस्ते न कर्तव्यो नैष संपत्स्यते तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2039599, "chapter_id": 1874, "verse_number": "५-११९-४", "content_sanskrit": "पुरा हि कान्यकुब्जे वै गाधेः सत्यवतीं सुताम्।\nभार्यार्थे वरयत्कन्यामृचीकस्तेन भाषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2039600, "chapter_id": 1874, "verse_number": "५-११९-५", "content_sanskrit": "एकतःश्यामकर्णानां हयानां चन्द्रवर्चसाम् ।\nभगवन्दीयताकं मह्यं महस्रमिति गालव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2039601, "chapter_id": 1874, "verse_number": "५-११९-६", "content_sanskrit": "ऋचीकस्तु तथेत्युक्त्वा वरुणस्यालयं गतः।\nअश्वतीर्थे हयाँल्लब्ध्वा दत्तवान्पार्थिवाय वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2039602, "chapter_id": 1874, "verse_number": "५-११९-७", "content_sanskrit": "इष्ट्वा ते पुण्डरीकेण दत्ता राज्ञा द्विजातिषु।\nतेभ्यो द्वे द्वे शते क्रीत्वा प्राप्ते तैः पार्थिवैस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2039603, "chapter_id": 1874, "verse_number": "५-११९-८", "content_sanskrit": "अपराण्यपि चत्वारि शतानि द्विजसत्तम ।\nनीयमानानि संतारे हृतान्यासन्नितस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2039604, "chapter_id": 1874, "verse_number": "५-११९-९", "content_sanskrit": "एवं न शक्यमप्राप्यं प्राप्तुं गालव कर्हिचित् ।\nइमामश्वशताभ्यां वै द्वाभ्यां तस्मै निवेदय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2039605, "chapter_id": 1874, "verse_number": "५-११९-१०", "content_sanskrit": "विश्वामित्राय धर्मात्मन्षङ्भिरश्वशतैः सह।\nततोऽसि गतसंमोहः कृतकृत्यो द्विजोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2039606, "chapter_id": 1874, "verse_number": "५-११९-११", "content_sanskrit": "गालवस्तं तथेत्युक्त्वा सुपर्णसहितस्ततः ।\nआदायाश्वांश्च कन्यां च विश्वामित्रपुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2039607, "chapter_id": 1874, "verse_number": "५-११९-१२", "content_sanskrit": "अश्वानां काङ्क्षितार्थानां षडिमानि शतानि वै ।\nशतद्वयेन कन्येयं भवता प्रतिगृह्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2039608, "chapter_id": 1874, "verse_number": "५-११९-१३", "content_sanskrit": "अस्यां राजर्षिभिः पुत्रा जाता वै धार्मिकास्त्रयः ।\nचतुर्थं जनयत्वेकं भवानपि नरोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2039609, "chapter_id": 1874, "verse_number": "५-११९-१४", "content_sanskrit": "पूर्णान्येवं शतान्यष्टौ तुरगाणां भवन्तु ते।\nभवतो ह्यनृणो भूत्वा तपः कुर्यां यथासुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2039610, "chapter_id": 1874, "verse_number": "५-११९-१५", "content_sanskrit": "विश्वामित्रस्तु तं दृष्ट्वा गालवं सह पक्षिणा।\nकन्यां च तां वरारोहामिदमित्यब्रवीद्वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2039611, "chapter_id": 1874, "verse_number": "५-११९-१६", "content_sanskrit": "किमियं पूर्वमेवेह न दत्ता मम गालव।\nपुत्रा ममैव चत्वारो भवेयुः कुलभावनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2039612, "chapter_id": 1874, "verse_number": "५-११९-१७", "content_sanskrit": "प्रतिगृह्णामि ते कन्यामेकपुत्रफलाय वै ।\nअश्वाश्चाश्रममासाद्य चरन्तु मम सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2039613, "chapter_id": 1874, "verse_number": "५-११९-१८x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2039614, "chapter_id": 1874, "verse_number": "५-११९-१८", "content_sanskrit": "स तया रममाणोऽथ विश्वामित्रो महाद्युतिः ।\nआत्मजं जनयामास माधवीपुत्रमष्टकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2039615, "chapter_id": 1874, "verse_number": "५-११९-१९", "content_sanskrit": "जातमात्रं सुतं तं च विश्वामित्रो महामुनिः ।\nसंयोज्यार्थैस्तथा धर्मैरश्वैस्तैः समयोजयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2039616, "chapter_id": 1874, "verse_number": "५-११९-२०", "content_sanskrit": "अथाष्टकः पुरं प्रायात्तदा सोमपुरप्रभम् ।\nनिर्यात्य कन्यां शिष्याय कौशिकोपि वनं ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2039617, "chapter_id": 1874, "verse_number": "५-११९-२१", "content_sanskrit": "गालवोपि सुपर्णेन सह निर्यात्य दक्षिणाम्।\nमनसाऽतिप्रतीतेन कन्यामिदमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2039618, "chapter_id": 1874, "verse_number": "५-११९-२२", "content_sanskrit": "जातो दानपतिः पुत्रस्त्वया शूरस्तथाऽपरः।\nसत्यधर्मरतश्चान्यो यज्वा चापि तथाऽपरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2039619, "chapter_id": 1874, "verse_number": "५-११९-२३", "content_sanskrit": "तदागच्छ वरारोहे तारितस्ते पिता सुतैः ।\nचत्वारश्चैव राजानस्तथा चाहं सुमध्यमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2039620, "chapter_id": 1874, "verse_number": "५-११९-२४x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2039621, "chapter_id": 1874, "verse_number": "५-११९-२४", "content_sanskrit": "गालवस्त्वभ्यनुज्ञाय सुपर्णं पन्नगाशनम् ।\nपितुर्निर्यात्य तां कन्यां प्रययौ वनमेव ह ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2039622, "chapter_id": 1874, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवाद्यनपर्वणि एकोनविंशत्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]