[{"id": 7002979000, "chapter_id": 22979, "verse_number": "२-२६-१", "content_sanskrit": "नारायण उवाच ।\nसावित्रीवचनं श्रुत्वा जगाम विस्मयं यमः ।\nप्रहस्य वक्तुमारेभे कर्मपाकं च जीविनाम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002979001, "chapter_id": 22979, "verse_number": "२-२६-२", "content_sanskrit": "यम उवाच ।\nकन्या द्वादशवर्षीया वत्से त्वं वयसाऽधुना ।\nज्ञानं ते पूर्वविदुषां योगिनां ज्ञानिनां परम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002979002, "chapter_id": 22979, "verse_number": "२-२६-३", "content_sanskrit": "सावित्रीवरदानेन त्वं सावित्रीकला सति ।\nप्राप्ता पुरा भूभृता च तपसा तत्समा शुभे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002979003, "chapter_id": 22979, "verse_number": "२-२६-४", "content_sanskrit": "यथा श्रीः श्रीपतेः क्रोडे भवानी च भवोरसि ।\nयथा राधा च श्रीकृष्णे सावित्री ब्रह्मवक्षसि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002979004, "chapter_id": 22979, "verse_number": "२-२६-५", "content_sanskrit": "धर्मोरसि यथा मूर्त्तिः शतरूपा मनौ यथा ।\nकर्दमे देवहूतिश्च वसिष्ठेऽरुन्धती यथा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002979005, "chapter_id": 22979, "verse_number": "२-२६-६", "content_sanskrit": "अदितिः कश्यपे चापि यथाऽहल्या च गौतमे ।\nयथा शची महेन्द्रे च यथा चन्द्रे च रोहिणी ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002979006, "chapter_id": 22979, "verse_number": "२-२६-७", "content_sanskrit": "यथा रतिः कामदेवे यथा स्वाहा हुताशने ।\nयथा स्वधा च पितृषु यथा संज्ञा दिवाकरे ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002979007, "chapter_id": 22979, "verse_number": "२-२६-८", "content_sanskrit": "वरुणानी च वरुणे यज्ञे च दक्षिणा यथा ।\nयथा धरा वराहे च देवसेना च कार्तिके ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002979008, "chapter_id": 22979, "verse_number": "२-२६-९", "content_sanskrit": "सौभाग्या सुप्रिया त्वं च भव सत्यवति प्रिये ।\nइति तुभ्यं वरं दत्तमपरं च यदीप्सितम् ।\nवृणु देवि महाभागे सर्वं दास्यामि निश्चितम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002979009, "chapter_id": 22979, "verse_number": "२-२६-१०", "content_sanskrit": "सावित्र्युवाच ।\nसत्यवदौरसेनैव पुत्राणां शतकं मम ।\nभविष्यति महाभाग वरमेतन्मदीप्सितम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002979010, "chapter_id": 22979, "verse_number": "२-२६-११", "content_sanskrit": "मत्पितुः पुत्रशतकं श्वशुरस्य च चक्षुषी ।\nराज्यलाभो भवत्वेव वरमेवं मदीप्सितम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002979011, "chapter_id": 22979, "verse_number": "२-२६-१२", "content_sanskrit": "अन्ते सत्यवता सार्द्धं यास्यामि हरिमन्दिरम् ।\nसमतीते लक्षवर्षे देहीमं मे जगत्प्रभो ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002979012, "chapter_id": 22979, "verse_number": "२-२६-१३", "content_sanskrit": "जीवकर्मविपाकं च श्रोतुं कौतूहलं च मे ।\nविश्वविस्तारबीजं च तन्मे व्याख्यातुमर्हसि ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002979013, "chapter_id": 22979, "verse_number": "२-२६-१४", "content_sanskrit": "यम उवाच ।\nभविष्यति महासाध्वि सर्वं मानसिकं तव ।\nजीवकर्म्मविपाकं च कथयामि निशामय ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002979014, "chapter_id": 22979, "verse_number": "२-२६-१५", "content_sanskrit": "शुभानामशुभानां च कर्म्मणां जन्म भारते ।\nपुण्यक्षेत्रेऽत्र सर्वत्र नान्यत्र भुञ्जते जनाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002979015, "chapter_id": 22979, "verse_number": "२-२६-१६", "content_sanskrit": "सुरा दैत्या दानवाश्च गन्धर्वा राक्षसादयः ।\nनराश्च कर्म्मजनका न सर्वे समजीविनः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002979016, "chapter_id": 22979, "verse_number": "२-२६-१७", "content_sanskrit": "विशिष्टजीविनः कर्म्म भुञ्जते सर्वयोनिषु ।\nविशेषतो मानवाश्च भ्रमन्ति सर्वयोनिषु॥ ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002979017, "chapter_id": 22979, "verse_number": "२-२६-१८", "content_sanskrit": "शुभाशुभं भुञ्जते च कर्म पूर्वार्जितं परम् ।\nशुभेन कर्मणा यान्ति ते स्वर्गादिकमेव च ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002979018, "chapter_id": 22979, "verse_number": "२-२६-१९", "content_sanskrit": "कर्म्मणा चाशुभेनैव भ्रमन्ति नरकेषु च ।\nकर्म्मनिर्मूलने मुक्तिः सा चोक्ता द्विविधा मता ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002979019, "chapter_id": 22979, "verse_number": "२-२६-२०", "content_sanskrit": "निर्वाणरूपा सेवा च कृष्णस्य परमात्मनः ।\nकुकर्मणा जीवश्चारोगी शुभकर्मणा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002979020, "chapter_id": 22979, "verse_number": "२-२६-२१", "content_sanskrit": "दीर्घजीवी च क्षीणायुः सुखी दुःखी च निश्चितम् ।\nअन्धादयश्चाङ्गहीनाः कुत्सितेन च कर्मणा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002979021, "chapter_id": 22979, "verse_number": "२-२६-२२", "content_sanskrit": "सिद्ध्यादिकमवाप्नोति सर्वोत्कृष्टेन कर्म्मणा ।\nसामान्यं कथितं सर्वं विशेषं शृणु सुन्दरि ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002979022, "chapter_id": 22979, "verse_number": "२-२६-२३", "content_sanskrit": "सुदुर्लभं सुभोग्यं च पुराणेषु श्रुतिष्वपि ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002979023, "chapter_id": 22979, "verse_number": "२-२६-२४", "content_sanskrit": "दुर्लभा मानवी जातिः सर्वजातिषु भारते ।\nसर्वाभ्यो ब्राह्मणः श्रेष्ठः प्रशस्तः सर्वकर्म्मसु ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002979024, "chapter_id": 22979, "verse_number": "२-२६-२५", "content_sanskrit": "विष्णुभक्तो द्विजश्चैव गरीयान्भारते ततः ।\nनिष्कामश्च सकामश्च वैष्णवो द्विविधः सति ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002979025, "chapter_id": 22979, "verse_number": "२-२६-२६", "content_sanskrit": "सकामश्च प्रधानश्च निष्कामो भक्त एव च ।\nकर्मभोगी सकामश्च निष्कामो निरुपद्रवः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002979026, "chapter_id": 22979, "verse_number": "२-२६-२७", "content_sanskrit": "स याति देहं त्यक्ता च पदं विष्णोर्निरामयम् ।\nपुनरागमनं नास्ति तेषां निष्कामिणां सति ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002979027, "chapter_id": 22979, "verse_number": "२-२६-२८", "content_sanskrit": "ये सेवन्ते च द्विभुजं कृष्णमात्मानमीश्वरम् ।\nगोलोकं यान्ति ते भक्ता दिव्यरूपविधारिणः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002979028, "chapter_id": 22979, "verse_number": "२-२६-२९", "content_sanskrit": "ये च नारायणं भक्ताः सेवन्ते च चतुर्भुजम् ।\nवैकुण्ठं यान्ति ते सर्वे दिव्यरूपविधारिणः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002979029, "chapter_id": 22979, "verse_number": "२-२६-३०", "content_sanskrit": "सकामिनो वैष्णवाश्च गत्वा वैकुण्ठमेव च ।\nभारतं पुनरायान्ति तेषां जन्म द्विजातिषु ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002979030, "chapter_id": 22979, "verse_number": "२-२६-३१", "content_sanskrit": "कालेन ते च निष्कामा भविष्यन्ति क्रमेण च ।\nभक्तिं च निर्मलां बुद्धिं तेभ्यो दास्यति निश्चितम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002979031, "chapter_id": 22979, "verse_number": "२-२६-३२", "content_sanskrit": "ब्राह्मणाद्वैष्णवादन्ये सकामाः सर्वजन्मसु ।\nन तेषां निर्मला बुद्धिर्विष्णुभक्तिविवर्जिताः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002979032, "chapter_id": 22979, "verse_number": "२-२६-३३", "content_sanskrit": "तीर्थाश्रिता द्विजा ये च तपस्यानिरताः सति ।\nते यान्ति ब्रह्मलोकं च पुनरायान्ति भारतम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002979033, "chapter_id": 22979, "verse_number": "२-२६-३४", "content_sanskrit": "स्वधर्मनिरता विप्राः सूर्य्यभक्ताश्च भारते ।\nव्रजन्ति सूर्यलोकं ते पुनरायान्ति भारतम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002979034, "chapter_id": 22979, "verse_number": "२-२६-३५", "content_sanskrit": "स्वधर्मनिरता विप्राः शैवाः शाक्ताश्च गाणपाः ।\nते यान्ति शिवलोकं च पुनरायान्ति भारतम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002979035, "chapter_id": 22979, "verse_number": "२-२६-३६", "content_sanskrit": "ये विप्रा अन्यदेवेष्टाः स्वधर्मनिरताः सति ।\nते गत्वा शक्रलोकं च पुनरायान्ति भारतम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002979036, "chapter_id": 22979, "verse_number": "२-२६-३७", "content_sanskrit": "हरिभक्ताश्च निष्कामाः स्वधर्म्मरहिता द्विजाः ।\nतेऽपि यान्ति हरेर्लोकं क्रमाद्भक्तिबलादहो ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002979037, "chapter_id": 22979, "verse_number": "२-२६-३८", "content_sanskrit": "स्वधर्म्मरहिता विप्रा देवान्यसेविनः सदा ।\nभ्रष्टाचाराश्च बालाश्च ते यांति नरकं ध्रुवम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002979038, "chapter_id": 22979, "verse_number": "२-२६-३९", "content_sanskrit": "स्वधर्म्मनिरताश्चैवं वर्णाश्चत्वार एव च ।\nभवन्त्येव शुभस्यैव कर्मणः फलभागिनः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002979039, "chapter_id": 22979, "verse_number": "२-२६-४०", "content_sanskrit": "स्वधर्म्मरहितास्ते च नरकं यान्ति हि ध्रुवम् ।\nभारते च भवन्त्येव कर्म्मणः फलभागिनः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002979040, "chapter_id": 22979, "verse_number": "२-२६-४१", "content_sanskrit": "स्वधर्मनिरता विप्राः स्वधर्मनिरताय च ।\nकन्यां ददति विप्राय चन्द्रलोकं व्रजन्ति ते ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002979041, "chapter_id": 22979, "verse_number": "२-२६-४२", "content_sanskrit": "वसंति तत्र ते साध्वि यावदिन्द्राश्चतुर्दश ।\nसालङ्कृताया दानेन द्विगुणं फलमुच्यते ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002979042, "chapter_id": 22979, "verse_number": "२-२६-४३", "content_sanskrit": "सकामा यांति तल्लोकं न निष्कामाश्च वैष्णवाः ।\nते प्रयांति विष्णुलोकं फलसन्धानवर्जिताः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002979043, "chapter_id": 22979, "verse_number": "२-२६-४४", "content_sanskrit": "गव्यं च रजतं भार्यां वस्त्रं सस्यं फलं जलम् ।\nये ददत्येव विप्रेभ्यस्तल्लोकं हि व्रजन्ति च ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002979044, "chapter_id": 22979, "verse_number": "२-२६-४५", "content_sanskrit": "वसंति ते च तल्लोकं यावन्मन्वन्तरं सति ।\nकालं च सुचिरं वासं कुर्वंति तत्र ते जनाः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002979045, "chapter_id": 22979, "verse_number": "२-२६-४६", "content_sanskrit": "ये ददति सुवर्णं च गां च ताम्रादिकं सति ।\nते यांति सूर्यलोकं च शुचये ब्राह्मणाय च ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002979046, "chapter_id": 22979, "verse_number": "२-२६-४७", "content_sanskrit": "वसन्ति तत्र ते लोके वर्षाणामयुतं सति ।\nविपुले च चिरं वासं कुर्वंति च निरामयाः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002979047, "chapter_id": 22979, "verse_number": "२-२६-४८", "content_sanskrit": "ददाति भूमिं विप्रेभ्यो धान्यानि विपुलानि च ।\nस याति विष्णुलोकं च श्वेतद्वीपं मनोहरम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002979048, "chapter_id": 22979, "verse_number": "२-२६-४९", "content_sanskrit": "तत्रैव निवसत्येव यावच्चन्द्रदिवाकरौ ।\nविपुलं विपुले वासं करोति पुण्यवान्सति ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002979049, "chapter_id": 22979, "verse_number": "२-२६-५०", "content_sanskrit": "गृहं ददंति विप्राय ये जना भक्तिपूर्वकम् ।\nते यांति सुरलोकं च चिरं तत्र भवंति ते ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002979050, "chapter_id": 22979, "verse_number": "२-२६-५१", "content_sanskrit": "गृहरेणुप्रमाणाब्दं दानं पुण्यदिने यदि ।\nविपुलं विपुले वासं कुर्वंति मानवाः सति ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002979051, "chapter_id": 22979, "verse_number": "२-२६-५२", "content_sanskrit": "यस्मै यस्मै च देवाय यो ददाति गृहं नरः ।\nस याति तस्य लोकं च रेणुमानाब्दमेव च ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002979052, "chapter_id": 22979, "verse_number": "२-२६-५३", "content_sanskrit": "सौधे चतुर्गुणं पुण्यं पूर्त्ते शतगुणं फलम् ।\nप्रकृष्टेऽष्टगुणं तस्मादित्याह कमलोद्भवः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002979053, "chapter_id": 22979, "verse_number": "२-२६-५४", "content_sanskrit": "यो ददाति तडागं च सर्वभूताय भारते ।\nस याति जनलोकं च वर्षाणामयुतं सति ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002979054, "chapter_id": 22979, "verse_number": "२-२६-५५", "content_sanskrit": "वाप्यां फलं शतगुणं प्राप्नोति मानवस्ततः ।\nतथा सेतुप्रदानेन तडागस्य फलं लभेत् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002979055, "chapter_id": 22979, "verse_number": "२-२६-५६", "content_sanskrit": "धनुश्चतुःसहस्रेण दैर्घ्यमानेन निश्चितम् ।\nन्यूना वा तावती प्रस्थे सा वापी परिकीर्त्तिता ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002979056, "chapter_id": 22979, "verse_number": "२-२६-५७", "content_sanskrit": "दशवापीसमा कन्या यदि पात्रे प्रदीयते ।\nफलं ददाति द्विगुणं यदि सालंकृता भवेत् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002979057, "chapter_id": 22979, "verse_number": "२-२६-५८", "content_sanskrit": "तत्फलं च तडागे च पङ्कोद्धारेण तत्फलम् ।\nवाप्याश्च पंकोद्धारेण वापीतुल्यफलं लभेत् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002979058, "chapter_id": 22979, "verse_number": "२-२६-५९", "content_sanskrit": "अश्वत्थवृक्षमारोप्य प्रतिष्ठां च करोति यः ।\nस याति तपसो लोकं वर्षाणामयुतं परम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002979059, "chapter_id": 22979, "verse_number": "२-२६-६०", "content_sanskrit": "पुष्पोद्यानं यो ददाति सावित्रि सर्वभूतये ।\nस वसेद्ध्रुवलोके च वर्षाणामयुतं ध्रुवम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002979060, "chapter_id": 22979, "verse_number": "२-२६-६१", "content_sanskrit": "यो ददाति विमानं च विष्णवे भारते सति ।\nविष्णुलोके वसेत्सोऽपि यावन्मन्वन्तरं परम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002979061, "chapter_id": 22979, "verse_number": "२-२६-६२", "content_sanskrit": "चित्रयुक्ते च विपुले फलं तस्य चतुर्गुणम् ।\nरथार्धं शिबिकादाने फलमेव लभेद्ध्रुवम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002979062, "chapter_id": 22979, "verse_number": "२-२६-६३", "content_sanskrit": "यो ददाति भक्तियुक्तो हरये दोलमन्दिरम् ।\nविष्णुलोके वसेत्सोऽपि यावन्मन्वतरं परम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002979063, "chapter_id": 22979, "verse_number": "२-२६-६४", "content_sanskrit": "राजमार्गं सौधयुक्तं यः करोति पतिव्रते ।\nवर्षाणामयुतं सोऽपि शक्रलोके महीयते ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002979064, "chapter_id": 22979, "verse_number": "२-२६-६५", "content_sanskrit": "ब्राह्मणेभ्योऽपि देवेभ्यो दाने समफलं लभेत् ।\nयच्च दत्तं हि तद्भोक्तुर्न दत्तं नोपतिष्ठते ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002979065, "chapter_id": 22979, "verse_number": "२-२६-६६", "content_sanskrit": "भुक्त्वा स्वर्गादिकं सौख्यं पुनरायान्ति भारते ।\nलभेद्विप्रकुलेष्वेव क्रमेणैवोत्तमादिषु ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7002979066, "chapter_id": 22979, "verse_number": "२-२६-६७", "content_sanskrit": "भारते पुण्यवान्विप्रो भुक्त्वा स्वर्गादिकं परम् ।\nपुनः सोऽपि भवेद्विप्रो न पुनः क्षत्रियादयः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7002979067, "chapter_id": 22979, "verse_number": "२-२६-६८", "content_sanskrit": "क्षत्रियो वाऽपि वैश्यो वा कल्पकोटिशतेन च ।\nतपसा ब्राह्मणत्वं च न प्राप्नोति श्रुतौ श्रुतम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7002979068, "chapter_id": 22979, "verse_number": "२-२६-६९", "content_sanskrit": "स्वधर्मरहिता विप्रा नानायोनिं व्रजन्ति च ।\nभुक्त्वा च कर्मभागं च विप्रयोनिं लभेत्पुनः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7002979069, "chapter_id": 22979, "verse_number": "२-२६-७०", "content_sanskrit": "नाभुक्तं क्षीयते कर्म्म कल्पकोटिशतैरपि ।\nअवश्यवमेव भोक्तव्यं कल्पकोटिशतैरपि ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7002979070, "chapter_id": 22979, "verse_number": "२-२६-७१", "content_sanskrit": "अवश्यमेव भोक्तव्यं कृतं कर्म शुभाशुभम् ।\nदेवतीर्थे सहायेन कायव्यूहेन शुध्यति ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7002979071, "chapter_id": 22979, "verse_number": "२-२६-७२", "content_sanskrit": "एतत्ते कथितं सर्वं किं भूयः श्रोतुमिच्छसि ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]