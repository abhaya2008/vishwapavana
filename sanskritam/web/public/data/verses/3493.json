[{"id": 2115838, "chapter_id": 3493, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2115839, "chapter_id": 3493, "verse_number": "१", "content_sanskrit": "ते प्रतस्थुः पुरस्कृत्य मातरं भरतर्षभाः ।\nसमैरुदङ्मुखैर्मार्गैर्यथोद्दिष्टं महाबलाः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2115840, "chapter_id": 3493, "verse_number": "२", "content_sanskrit": "ते गच्छन्तस्त्वहोरात्रं पाञ्चालनगरं प्रति ।\nअभ्याजग्मुर्लोकनदीं गङ्गां भागीरथीं प्रति \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2115841, "chapter_id": 3493, "verse_number": "३", "content_sanskrit": "चन्द्रास्तमनवेळायामर्धरात्रे समागते ।\nते चैवात्रानुमज्जन्तस्तीर्थं सोमाश्रयायणम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2115842, "chapter_id": 3493, "verse_number": "४", "content_sanskrit": "उल्मुकं तु समुद्यम्य तेषामग्रे धनञ्जयः ।\nप्रकाशार्थं ययौ तत्र रक्षार्थं च धनञ्जयः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2115843, "chapter_id": 3493, "verse_number": "५", "content_sanskrit": "अथ तत्र जले रम्ये विजने क्रीडयन् स्त्रियः ।\nईक्ष्य गन्धर्वराजस्तु जलक्रीडामुपागतः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2115844, "chapter_id": 3493, "verse_number": "६", "content_sanskrit": "शब्दमेषां स शुश्राव नदीं समुपसर्पताम् ।\nतेन शब्देन चोद्रिक्तः चुक्रोध सहसा बली \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2115845, "chapter_id": 3493, "verse_number": "७", "content_sanskrit": "स दृष्ट्वा पाण्डवांस्तत्र सह मात्रा परन्तपान् ।\nविष्फारयन् धनुर्घोरमिदं वचनमब्रवीत् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2115846, "chapter_id": 3493, "verse_number": "", "content_sanskrit": "अङ्गारवर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2115847, "chapter_id": 3493, "verse_number": "८", "content_sanskrit": "सन्ध्या संरज्यते घोरा पर्वरात्रागमेषु या ।\nअशीतित्रुटिभिर्हीनान् त्रीन् मुहूर्तान् प्रचक्षते \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2115848, "chapter_id": 3493, "verse_number": "९", "content_sanskrit": "विहितान् कामचाराय यक्षगन्धर्वरक्षसाम् ।\nशेषं कालं मनुष्याणां कामचारमिह स्मृतम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2115849, "chapter_id": 3493, "verse_number": "१०", "content_sanskrit": "लोभात् प्रचारं चरतस्तासु वेळासु वै नरान् ।\nउपक्रम्य निगृह्णीमो राक्षसैः सह बालिशान् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2115850, "chapter_id": 3493, "verse_number": "११", "content_sanskrit": "अतो रात्र्यां प्राप्नुवन्ति भूयिष्ठं पापचेतसः ।\nनिघ्नन्त्येते नित्यमेषु क्षणेषु नृपतीनपि \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2115851, "chapter_id": 3493, "verse_number": "१२", "content_sanskrit": "आराच्च तिष्ठतास्माकं समीपं नोपगच्छत ।\nकस्मान्मां नाभिजानीथ प्राप्तं भागीरथीजलम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2115852, "chapter_id": 3493, "verse_number": "१३", "content_sanskrit": "अङ्गारवर्णं गन्धर्वं वित्त मां प्रबलाश्रयम् ।\nअहं हि मानी चेर्ष्युश्च कुबेरस्य प्रियः सखा \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2115853, "chapter_id": 3493, "verse_number": "१४", "content_sanskrit": "अङ्गारवर्णमिति च वनं ख्यातमिदं मम ।\nअनुगङ्गं महच्चित्रमस्मिन् नित्यं चराम्यहम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2115854, "chapter_id": 3493, "verse_number": "१५", "content_sanskrit": "न कौणपाः शृङ्गिणो वा न च देवा जनव्रजः ।\nइदं समुपसर्पन्ति तत् किं समुपसर्पथ \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2115855, "chapter_id": 3493, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2115856, "chapter_id": 3493, "verse_number": "१६", "content_sanskrit": "समुद्रे हिमवत्पार्श्वे नद्यामस्यां च दुर्मते ।\nरात्रावहनि सन्ध्यायां कस्य क्लृप्तः परिग्रहः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2115857, "chapter_id": 3493, "verse_number": "१७", "content_sanskrit": "वयं च शक्तिसम्पन्ना अकाले त्वां च धृष्णुमः ।\nअशक्ता हि रणे क्रूर युष्मानर्चन्ति मानवाः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2115858, "chapter_id": 3493, "verse_number": "१८", "content_sanskrit": "पुरा हिमवतश्चैषा हेमशृङ्गाद् विनिस्सृता ।\nगङ्गा प्रतिदिशं गत्वा सप्तधा प्रविभज्यते \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2115859, "chapter_id": 3493, "verse_number": "१९", "content_sanskrit": "स भूत्वैकप्रवाहा च शुचिराकाशगा पुनः ।\nदेवेषु गङ्गा गन्धर्व प्राप्नोत्यलकनन्दताम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2115860, "chapter_id": 3493, "verse_number": "२०", "content_sanskrit": "तथा पितॄन् वैतरणी दुस्तरा पापकर्मभिः ।\nगङ्गा भुवि च गन्धर्व यथा द्वैपायनोऽब्रवीत् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2115861, "chapter_id": 3493, "verse_number": "२१", "content_sanskrit": "असम्बाधा देवनदी सर्वेषां पावनी शुभा ।\nकथमिच्छसि तां रोद्धुं नैष धर्मः सनातनः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2115862, "chapter_id": 3493, "verse_number": "२२", "content_sanskrit": "अनाश्चर्यमसम्बाधं तव वाचा कथं वयम् ।\nन स्पृशेम यथाकामं पुण्यं भागीरथीजलम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2115863, "chapter_id": 3493, "verse_number": "२३", "content_sanskrit": "अङ्गारवर्णस्तच्छ्रुत्वा क्रुद्ध आयम्य कार्मुकम् ।\nमुमोच सायकान् दीप्तानहीन् दीप्ताननानिव \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2115864, "chapter_id": 3493, "verse_number": "२४", "content_sanskrit": "उल्मुकं भ्रामयंस्तूर्णं पाण्डवश्च नरोत्तम ।\nव्यपोवाह शरांस्तस्य सर्वानेव धनञ्जयः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2115865, "chapter_id": 3493, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2115866, "chapter_id": 3493, "verse_number": "२५", "content_sanskrit": "विभीषिकां हि गन्धर्व नतु प्राज्ञेषु योजय ।\nअस्त्रज्ञेषु प्रयुक्तेयं फेनवत् प्रविलीयते \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2115867, "chapter_id": 3493, "verse_number": "२६", "content_sanskrit": "मानुषान्न तु गन्धर्वान् सर्वान् गन्धर्व लक्षयेः ।\nतस्मादस्त्रेण दिव्येन योत्स्येऽहं न तु मायया \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2115868, "chapter_id": 3493, "verse_number": "२७", "content_sanskrit": "तदिदं जातवेदास्तु प्रादादस्त्रं बृहस्पतेः ।\nतस्मादगाद् भरद्वाजं गुरुपुत्रं शतक्रतोः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2115869, "chapter_id": 3493, "verse_number": "२८", "content_sanskrit": "भरद्वाजात् ततो रामं भार्गवाच्च गुरुं मम ।\nस त्विदं मह्यमददाद् द्रोणो ब्राह्मणसत्तमः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2115870, "chapter_id": 3493, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2115871, "chapter_id": 3493, "verse_number": "२९", "content_sanskrit": "इत्युक्त्वा पाण्डवः क्रुद्धो गन्धर्वाय मुमोच ह ।\nप्रदीप्तमस्त्रमाग्नेयं ददाहास्य रथं ततः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2115872, "chapter_id": 3493, "verse_number": "३०", "content_sanskrit": "रथात् तु विप्लुतं तं तु गन्धर्वं सुमहाबलम् ।\nअस्त्रतेजःप्ररूढं च गन्धर्वं सुमहाबलम् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2115873, "chapter_id": 3493, "verse_number": "३१", "content_sanskrit": "शिरोरुहेषु जग्राह माल्यवत्सु धनञ्जयः ।\nभ्रातॄन् प्रति चकर्षाथ सोऽस्त्रपातादचेतनम् \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2115874, "chapter_id": 3493, "verse_number": "३२", "content_sanskrit": "युधिष्ठिरं तस्य भार्या प्रपेदे शरणार्थिनी ।\nनाम्ना कुम्भीनसी नाम पतित्राणमभीप्सती \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2115875, "chapter_id": 3493, "verse_number": "", "content_sanskrit": "गन्धर्वी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2115876, "chapter_id": 3493, "verse_number": "३३", "content_sanskrit": "त्राहि त्वं मां महाराज पतिं चेमं विमुञ्च मे ।\nगन्धर्वीं शरणं प्राप्तां दीनां कुम्भीनसीं प्रभो \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2115877, "chapter_id": 3493, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2115878, "chapter_id": 3493, "verse_number": "३५", "content_sanskrit": "श्रुत्वाऽनुग्रहभावाच्च पार्थः पार्थमुवाच ह ।\nअभयं प्रतिपद्यस्व गच्छ गन्धर्व मा शुचः ।\nप्रदिशत्यभयं तेऽत्र कुरुराजो युधिष्ठिरः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]