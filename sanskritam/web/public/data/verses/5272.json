[{"id": 2200468, "chapter_id": 5272, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2200469, "chapter_id": 5272, "verse_number": "१", "content_sanskrit": "मया गवां पुरीषं वै श्रिया जुष्टमिति श्रुतम् ।\nएतदिच्छाम्यहं श्रोतुं संशयोऽत्र हि मे महान्\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2200470, "chapter_id": 5272, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2200471, "chapter_id": 5272, "verse_number": "२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nगोभिर्नृपेह संवादं श्रिया भरतसत्तम\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2200472, "chapter_id": 5272, "verse_number": "३", "content_sanskrit": "श्रीः कृत्वेह वपुः कान्तं गोमध्यं प्रविवेश ह ।\nगावोऽथ विस्मितास्तस्या दृष्ट्वा रूपस्य सम्पदम्\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2200473, "chapter_id": 5272, "verse_number": "", "content_sanskrit": "गावः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2200474, "chapter_id": 5272, "verse_number": "४", "content_sanskrit": "काऽसि देवि कुतो वा त्वं रूपेणाप्रतिमा भुवि ।\nविस्मिताः स्म महाभागे तव रूपस्य सम्पदा\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2200475, "chapter_id": 5272, "verse_number": "५", "content_sanskrit": "इच्छामस्त्वां वयं ज्ञातुं का त्वं क्व च गमिष्यसि ।\nतत्त्वेन च सुवर्णाभे सर्वमेतद् ब्रवीहि नः\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2200476, "chapter_id": 5272, "verse_number": "", "content_sanskrit": "श्रीः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2200477, "chapter_id": 5272, "verse_number": "६", "content_sanskrit": "लोककान्ताऽस्मि भद्रं वः श्रीर्नाम्नेह परिश्रुता ।\nमया दैत्याः परित्यक्ता विनष्टाः शाश्वतीः समाः\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2200478, "chapter_id": 5272, "verse_number": "७", "content_sanskrit": "इन्द्रो विवस्वान् सोमश्च विष्णुरापोऽग्निरेव च ।\nमयाऽभिपन्ना ऋध्यन्ते ऋषयो देवतास्तथा\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2200479, "chapter_id": 5272, "verse_number": "८", "content_sanskrit": "यांश्च द्विष्याम्यहं गावस्ते विनश्यन्ति सर्वशः ।\nधर्मार्थकामहीनाश्च ते भवन्त्यसुखान्विताः\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2200480, "chapter_id": 5272, "verse_number": "९", "content_sanskrit": "एवम्प्रभावां मां गावो विजानीत सुखप्रदाम् ।\nइच्छामि चापि युष्मासु वस्तुं सर्वासु नित्यदा ।\nआगता प्रार्थयानाऽहं श्रीजुष्टा भवताद्य वै\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2200481, "chapter_id": 5272, "verse_number": "", "content_sanskrit": "गावः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2200482, "chapter_id": 5272, "verse_number": "१०", "content_sanskrit": "अध्रुवां चञ्चलां च त्वां सामान्यां बहुभिः सह ।\nन त्वामिच्छाम भद्रं ते गम्यतां यत्र रोचते\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2200483, "chapter_id": 5272, "verse_number": "११", "content_sanskrit": "वपुष्मन्त्यो वयं सर्वाः किमस्माकं त्वयाऽद्य वै ।\nयत्रेष्टं गम्यतां तत्र कृतकार्या वयं त्वया\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2200484, "chapter_id": 5272, "verse_number": "", "content_sanskrit": "श्रीः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2200485, "chapter_id": 5272, "verse_number": "१२", "content_sanskrit": "किमेतद् धक्षणं गावो यन्मां नेहाभ्यनन्दथ ।\nन मां सम्प्रति गृह्णीथ कस्माद्वै दुर्लभां सतीम्\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2200486, "chapter_id": 5272, "verse_number": "१३", "content_sanskrit": "सत्यश्च लोकवादोऽयं लोके चरति सुव्रताः ।\nस्वयं प्राप्ते परिभवो भवतीति विनिश्चयः\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2200487, "chapter_id": 5272, "verse_number": "१४", "content_sanskrit": "महदुग्रं तपः कृत्वा मां निषेवन्ति मानवाः ।\nदेवदानवगन्धर्वाः पिशाचोरगराक्षसाः\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2200488, "chapter_id": 5272, "verse_number": "१५", "content_sanskrit": "क्षममेतद्धि वो गावः प्रतिगृह्णीत मामिह ।\nनावमन्या ह्यहं सौम्यास्त्रैलोक्ये सचराचरे\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2200489, "chapter_id": 5272, "verse_number": "", "content_sanskrit": "गावः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2200490, "chapter_id": 5272, "verse_number": "१६", "content_sanskrit": "नावमन्यामहे देवि न त्वां परिभवामहे ।\nअध्रुवा चलचित्ताऽसि ततस्त्वां वर्जयामहे\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2200491, "chapter_id": 5272, "verse_number": "१७", "content_sanskrit": "बहुनाऽत्र किमुक्तेन गम्यतां यत्र वाञ्छसि ।\nवपुष्मत्यो वयं सर्वाः किमस्माकं त्वयाऽनघे\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2200492, "chapter_id": 5272, "verse_number": "", "content_sanskrit": "श्रीः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2200493, "chapter_id": 5272, "verse_number": "१८", "content_sanskrit": "अवज्ञाता भविष्यामि सर्वलोकेषु मानदाः ।\nप्रत्याख्यानेन युष्माभिः प्रसादः क्रियतामिति\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2200494, "chapter_id": 5272, "verse_number": "१९", "content_sanskrit": "महाभागा भवत्यो वै शरण्याः शरणागताम् ।\nपरित्रायन्तु मां नित्यं भजमानामनिन्दिताम् ।\nमाननां त्वहमिच्छामि भवत्यः सततं शुभाः\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2200495, "chapter_id": 5272, "verse_number": "२०", "content_sanskrit": "अप्येकाङ्गे तु वो वस्तुमिच्छामि च सुकुत्सिते ।\nन वोऽस्ति कुत्सितं किञ्चिदङ्गेष्वालक्ष्यतेऽनघाः\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2200496, "chapter_id": 5272, "verse_number": "२१", "content_sanskrit": "पुण्याः पवित्राः सुभगा ममादेशं प्रयच्छत ।\nवसेयं यत्र चाङ्गेऽहं तन्मे व्याख्यातुमर्हथ\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2200497, "chapter_id": 5272, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2200498, "chapter_id": 5272, "verse_number": "२२", "content_sanskrit": "एवमुक्तास्तु ता गावः शुभाः करुणवत्सलाः ।\nसम्मन्त्र्य सहिताः सर्वाः श्रियमूचुर्नराधिप\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2200499, "chapter_id": 5272, "verse_number": "२३", "content_sanskrit": "अवश्यं मानना कार्या तवास्माभिर्यशस्विनि ।\nशकृन्मूत्रे निवस नः पुण्यमेतद्धि नः शुभे\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2200500, "chapter_id": 5272, "verse_number": "", "content_sanskrit": "श्रीः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2200501, "chapter_id": 5272, "verse_number": "२४", "content_sanskrit": "दिष्ट्या प्रसादो युष्माभिः कृतो मेऽनुग्रहात्मकः ।\nएवं भवतु भद्रं वः पूजिताऽस्मि सुखप्रदाः\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2200502, "chapter_id": 5272, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2200503, "chapter_id": 5272, "verse_number": "२५", "content_sanskrit": "एवं कृत्वा तु समयं श्रीर्गोभिः सह भारत ।\nपश्यन्तीनां ततस्तासां तत्रैवान्तरधीयत\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2200504, "chapter_id": 5272, "verse_number": "२६", "content_sanskrit": "एतद् गोशकृतः पुत्र माहात्म्यं तेऽनुवर्णितम् ।\nमाहात्म्यं च गवां भूयः श्रूयतां गदतो मम\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2200505, "chapter_id": 5272, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे गोशकृन्महिमवर्णनं नाम त्रयोविंशत्यधिकशततमोऽध्यायः ॥१२३॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]