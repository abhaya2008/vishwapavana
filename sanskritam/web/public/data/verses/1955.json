[{"id": 2042779, "chapter_id": 1955, "verse_number": "६-४-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2042780, "chapter_id": 1955, "verse_number": "६-४-१", "content_sanskrit": "एवमुक्त्वा ययौ व्यासो धृतराष्ट्रय धीमते।\nधृतराष्ट्रोऽपि तच्छ्रुत्वा ध्यानमेवान्वपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2042781, "chapter_id": 1955, "verse_number": "६-४-२", "content_sanskrit": "स मुहूर्तमिव ध्यात्वा विनिःश्वस्य मुहुर्मुहुः ।\nसंजयं संशितात्मानमपृच्छद्रतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2042782, "chapter_id": 1955, "verse_number": "६-४-३", "content_sanskrit": "संजयेमे महीपालाः शूरा युद्धाभिनन्दिनः ।\nअन्योन्यमभिनिघ्नन्ति शस्त्रैरुच्चावचैरिह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2042783, "chapter_id": 1955, "verse_number": "६-४-४", "content_sanskrit": "पार्थिवाः पृथिवीहेतोः समभित्यज्य जीवितम् ।\nन वा शाम्यन्ति निघ्नन्तो वर्धयन्ति यमक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2042784, "chapter_id": 1955, "verse_number": "६-४-५", "content_sanskrit": "भौममैश्वर्यमिच्छन्तो न मृष्यन्ते परस्परम् ।\nमन्ये बहुगुणा भूमिस्तन्ममाचक्ष्व संजय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2042785, "chapter_id": 1955, "verse_number": "६-४-६", "content_sanskrit": "बहूनि च सहस्राणि प्रयुतान्यर्बुदानि च।\nकोट्यश्च लोकवीराणां समेताः कुरुजाङ्गले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2042786, "chapter_id": 1955, "verse_number": "६-४-७", "content_sanskrit": "देशानां च परीमाणं नगराणां च संजय ।\nश्रोतुमिच्छामि तत्त्वेन यत एते समागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2042787, "chapter_id": 1955, "verse_number": "६-४-८", "content_sanskrit": "दिव्यबुद्धिप्रदीपेन युक्तस्त्वं ज्ञानचक्षुषा।\nप्रभावात्तस्य विप्रर्षेर्व्यासस्यामिततेजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2042788, "chapter_id": 1955, "verse_number": "६-४-९x", "content_sanskrit": "संजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2042789, "chapter_id": 1955, "verse_number": "६-४-९", "content_sanskrit": "यथाप्रज्ञं महाप्राज्ञ भौमान्वक्ष्यामि ते गुणान्।\nशास्त्रचक्षुरवेक्षस्व नमस्ते भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2042790, "chapter_id": 1955, "verse_number": "६-४-१०", "content_sanskrit": "द्विविधानीह भूतानि चराणि स्थावराणि च।\nत्रसानां त्रिविधा योनिरण्डस्वेदजरायुजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2042791, "chapter_id": 1955, "verse_number": "६-४-११", "content_sanskrit": "त्रसानां खलु सर्वेषां श्रेष्ठा राजञ्जरायुजाः।\nजरायुजानां प्रवरा मानवाः पशवश्च ये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2042792, "chapter_id": 1955, "verse_number": "६-४-१२", "content_sanskrit": "नानारूपधरा राजंस्तेषां भेदाश्चतुर्दश ।\nवेदोक्ताः पृथिवीपाल येषु यज्ञाः प्रतिष्ठिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2042793, "chapter_id": 1955, "verse_number": "६-४-१३", "content_sanskrit": "ग्राम्याणां पुरुषाः श्रेष्ठाः सिंहाश्चारण्यवासिनाम् ।\nसर्वेषामेव भूतानामन्योन्येनोपजीवनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2042794, "chapter_id": 1955, "verse_number": "६-४-१४", "content_sanskrit": "उद्भिञ्जाः स्थावराः प्रोक्तास्तेषां पञ्चैव जातयः ।\nवृक्षगुल्मलतावल्ल्यस्त्वक्सारास्तृणजातयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2042795, "chapter_id": 1955, "verse_number": "६-४-१५", "content_sanskrit": "तेषां विंशतिरेकोना महाभूतेषु पञ्चसु ।\nचतुर्विशतिरुद्दिष्टा गायत्री लोकसंमता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2042796, "chapter_id": 1955, "verse_number": "६-४-१६", "content_sanskrit": "य एतां वेद गायत्रीं पुण्यां सर्वगुणान्विताम् ।\nतत्त्वेन भरतश्रेष्ठ स लोके न प्रणश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2042797, "chapter_id": 1955, "verse_number": "६-४-१७", "content_sanskrit": "अरण्यवासिनः सप्त सप्तैषां ग्रामवासिनः ।\nसिंहा व्याघ्रा वराहाश्च महिषा वारणास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2042798, "chapter_id": 1955, "verse_number": "६-४-१८", "content_sanskrit": "ऋक्षाश्च वानराश्चैव सप्तारण्याः स्मृता नृप ।\nगौरजाविमनुष्याश्च अश्वाश्वतरगर्दभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2042799, "chapter_id": 1955, "verse_number": "६-४-१९", "content_sanskrit": "एते ग्राम्याः समाख्याताः पशवः सप्त साधुभिः ।\nएते वै पशवो राजन्ग्राम्यारण्याश्चतुर्दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2042800, "chapter_id": 1955, "verse_number": "६-४-२०", "content_sanskrit": "भूमौ च जायते सर्वं भूमौ सर्वं विनश्यति ।\nभूमिः प्रतिष्ठा भूतानां भूमिरेव सनातनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2042801, "chapter_id": 1955, "verse_number": "६-४-२१", "content_sanskrit": "यस्य भूमिस्तस्य सर्वं जगत्स्थावरजङ्गमम् ।\nतत्रातिगृद्धा राजानो विनिघ्नन्तीतरेतरम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2042802, "chapter_id": 1955, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि जम्बूखण्डविनिर्माणपर्वणि चतुर्थोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]