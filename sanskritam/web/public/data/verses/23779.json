[{"id": 7003779000, "chapter_id": 23779, "verse_number": "२-२-२३-१", "content_sanskrit": "नारद उवाच ।\nदौवारिकाय राजर्षिरिंद्रद्युम्नो महायशाः ।\nसार्वभौमो वैष्णवाग्र्यो धातारं द्रष्टुमागतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003779001, "chapter_id": 23779, "verse_number": "२-२-२३-२", "content_sanskrit": "यात्वयं पुरतस्तस्य यदि त्वमनुमन्यसे ।\nइत्युक्तस्तं पुनः प्राह नारदं मणिकोदरः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003779002, "chapter_id": 23779, "verse_number": "२-२-२३-३", "content_sanskrit": "स्वामिंस्त्वयागतो योऽसौ न सामान्यो हि बुध्यते ।\nयत्र पश्यसि दिक्पालान्पितॄन्मन्वंतराधिपान् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003779003, "chapter_id": 23779, "verse_number": "२-२-२३-४", "content_sanskrit": "तत्रायं मर्त्त्यनिलयस्तिष्ठेदपि हि पौरुषम् ।\nभवान्गत्वा पद्मयोनिं विज्ञाप्यैनं प्रवेशय ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003779004, "chapter_id": 23779, "verse_number": "२-२-२३-५", "content_sanskrit": "सभाद्वारगतो योऽसौ दिक्पालैः सह यास्यति ।\nएकाग्रचित्तो भगवान्गायने चतुराननः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003779005, "chapter_id": 23779, "verse_number": "२-२-२३-६", "content_sanskrit": "अस्माकं द्वारि युक्तानां प्रतीक्ष्योऽवसरो ध्रुवम् ।\nन क्रोधो मयि कर्त्तव्यो दासे तव पितुश्च ते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003779006, "chapter_id": 23779, "verse_number": "२-२-२३-७", "content_sanskrit": "इत्युक्तो नारदो गत्वा ब्रह्माणं जगतां पतिम् ।\nनत्वा साष्टांगपतनं विज्ञप्तो वसुधाधिपः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003779007, "chapter_id": 23779, "verse_number": "२-२-२३-८", "content_sanskrit": "कटाक्षेणादिशत्सोऽथ इन्द्रद्युम्नप्रवेशनम् ।\nनोवाच किंचिद्भगवान्गाने दत्तावधानतः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003779008, "chapter_id": 23779, "verse_number": "२-२-२३-९", "content_sanskrit": "दिव्यगायनसंगीते कौतुकाविष्टमानसः ।\nज्ञात्वेंगितं नारदोऽथ इंद्रद्युम्नं नृपोत्तमम् ।\nप्रवेशयामास ततः शक्राद्यैः सुनिरीक्षितः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003779009, "chapter_id": 23779, "verse_number": "२-२-२३-१०", "content_sanskrit": "दृष्ट्वा पितामहं दूरात्स्रष्टारं जगतां नृपः ।\nअमन्यत द्विजश्रेष्ठाः साक्षाद्दारुमयं हरिम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003779010, "chapter_id": 23779, "verse_number": "२-२-२३-११", "content_sanskrit": "शनैः शनैर्ययौ भूपः प्रणमंश्च कृतांजलिः ।\nस्तुवन्नमन्प्रणिपतन्साध्वसस्खलितं व्रजन् ।\nकिंचिद्दूरे स्थितो भूपो नारदस्य निदेशतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003779011, "chapter_id": 23779, "verse_number": "२-२-२३-१२", "content_sanskrit": "ततः पुण्यं गीयमानं चरितं सिंधुजापतेः ।\nशृण्वंश्चतुर्मुखस्तस्थौ मुहू्र्त्तं द्विजपुंगवाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003779012, "chapter_id": 23779, "verse_number": "२-२-२३-१३", "content_sanskrit": "सावित्रीशारदाभ्यां च वीज्यमानस्तु पार्श्वयोः ।\nशुद्धदेहधरैर्वेदैः स्तूयमानः स्वयंभुवः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003779013, "chapter_id": 23779, "verse_number": "२-२-२३-१४", "content_sanskrit": "कलाकाष्ठानिमेषादि कल्पयन्युगपर्ययम् ।\nन जराजन्ममरणं रूपादिपरिणामनम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003779014, "chapter_id": 23779, "verse_number": "२-२-२३-१५", "content_sanskrit": "यस्य लोकगतानां वै नाधयो व्याधयस्तथा ।\nमन्वतरादयो यत्र युगावर्त्तादयस्तथा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003779015, "chapter_id": 23779, "verse_number": "२-२-२३-१६", "content_sanskrit": "कल्पांताद्या न विद्यंते स साक्षात्परमेश्वरः ।\nगीतावसाने तं भूपमुवाच प्रहसन्निव ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003779016, "chapter_id": 23779, "verse_number": "२-२-२३-१७", "content_sanskrit": "इंद्रद्युम्न महासत्त्व साक्षात्त्वं भगवत्प्रियः ।\nअन्यस्य दुर्लभो लोकः सत्याख्यो विदितस्तव ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003779017, "chapter_id": 23779, "verse_number": "२-२-२३-१८", "content_sanskrit": "अत्रागतिं हि वांछंतो मुनयः क्षीणकल्मषाः ।\nतपोनिष्ठाश्च तिष्ठंति यावदाभूतसंप्लवम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003779018, "chapter_id": 23779, "verse_number": "२-२-२३-१९", "content_sanskrit": "चतुर्दशसु लोकेषु सृष्टानां प्राणिनां हि यत् ।\nचैतन्यादिविचित्राणि सर्वेषामाश्रयो ह्यसौ ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003779019, "chapter_id": 23779, "verse_number": "२-२-२३-२०", "content_sanskrit": "जानन्नपि हि तत्कार्यं मानयन्नृपसत्तमम् ।\nउवाच परमप्रीत इंद्रद्युम्नं पितामहः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003779020, "chapter_id": 23779, "verse_number": "२-२-२३-२१", "content_sanskrit": "किमर्थमागतोस्यत्र तद्ब्रूहि हृदयस्थितम् ।\nमयि दृष्टे न दुष्प्रापममृतं किन्नु वांछितम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003779021, "chapter_id": 23779, "verse_number": "२-२-२३-२२", "content_sanskrit": "इन्द्रद्युम्न उवाच ।\nअंतर्यामिन्हि भगवंस्त्वदज्ञातं कुतो भवेत् ।\nतथापि प्रश्नो यो नाथ मय्यनुक्रोश एव सः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003779022, "chapter_id": 23779, "verse_number": "२-२-२३-२३", "content_sanskrit": "मूर्ध्न्याधाय तवानुज्ञां कथितं तव सूनुना ।\nइष्टाः सहस्रं क्रतवस्तदंते दारुदेहभृत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003779023, "chapter_id": 23779, "verse_number": "२-२-२३-२४", "content_sanskrit": "आविर्बभूव भगवान्भूतभव्यभवत्प्रभुः ।\nत्वदनुग्रहसंपत्तिवशादेवावलोकयन् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003779024, "chapter_id": 23779, "verse_number": "२-२-२३-२५", "content_sanskrit": "तादृशं पुंडरीकाक्षं येन त्वल्लोकमागतः ।\nयस्यारब्धो मया देव प्रासादस्तत्र चेत्स्वयम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003779025, "chapter_id": 23779, "verse_number": "२-२-२३-२६", "content_sanskrit": "गत्वा देवं जगन्नाथं स्थापयिष्यसि चेत्प्रभो ।\nत्वदनुग्रहस्तु सफलो भवेन्मे लोकभावन ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003779026, "chapter_id": 23779, "verse_number": "२-२-२३-२७", "content_sanskrit": "एतदर्थं जगत्स्वामिन्नारदेन सहाधुना ।\nत्वत्पादपद्मयुगलं द्रष्टुं त्वल्लोकमागतः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003779027, "chapter_id": 23779, "verse_number": "२-२-२३-२८", "content_sanskrit": "प्रसीद मां कुरुष्वेदं जगन्नाथस्त्वमेव हि ।\nत्वमेव स जगन्नाथो न भेदो युवयोर्विभो ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003779028, "chapter_id": 23779, "verse_number": "२-२-२३-२९", "content_sanskrit": "स्थाप्यः स्थापयिता चासि वेद्यो वेदयिता भवान् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003779029, "chapter_id": 23779, "verse_number": "२-२-२३-३०", "content_sanskrit": "जैमिनिरुवाच ।\nएवं विज्ञापनांते तु दुर्वासा स महामुनिः ।\nप्रणम्य साष्टांगपातं कृतांजलिरुपस्थितः ।\nप्रोवाच विनयान्नीचो धातारं जगतां गुरुम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003779030, "chapter_id": 23779, "verse_number": "२-२-२३-३१", "content_sanskrit": "विभो द्वारप्रवेशेऽत्र दौवारिकनिवारिताः ।\nलोकपालाः सपितरस्तथा मन्वंतराधिपाः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003779031, "chapter_id": 23779, "verse_number": "२-२-२३-३२", "content_sanskrit": "तिष्ठंति दीनजनवत्सुचिराल्लोकभावन ।\nतदाज्ञापय पश्यंतु तव पादसरोरुहम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003779032, "chapter_id": 23779, "verse_number": "२-२-२३-३३", "content_sanskrit": "तच्छ्रुत्वा देवदेवस्तु तदा दुर्वाससो वचः ।\nप्रहस्य वचनं प्राह नैषां प्रस्ताव एव हि ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003779033, "chapter_id": 23779, "verse_number": "२-२-२३-३४", "content_sanskrit": "इंद्रद्युम्नेन स्पर्द्धंते किं तु मोहवशानुगाः ।\nजीवन्मुक्तोऽयं नृपतिः क्षीणकर्माघसंहतिः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003779034, "chapter_id": 23779, "verse_number": "२-२-२३-३५", "content_sanskrit": "मत्संततेः पंचमोऽयं वैष्णवो विष्णुतत्परः ।\nएते हि सुखभोगाय कर्मणा प्राप्तपौरुषाः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003779035, "chapter_id": 23779, "verse_number": "२-२-२३-३६", "content_sanskrit": "अत्रागतिं प्रार्थयंतस्तपस्तप्त्वा हि देवताः ।\nममानुग्रहत एते आयाता मदुपासने ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003779036, "chapter_id": 23779, "verse_number": "२-२-२३-३७", "content_sanskrit": "तथापि त्वदनुज्ञाता आयांतु मम दर्शने ।\nततः प्रविष्टास्ते देवा दुर्वासोवचनेन वै ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003779037, "chapter_id": 23779, "verse_number": "२-२-२३-३८", "content_sanskrit": "दूरात्प्रणेमुर्ब्रह्माणं गायनानां समीपतः ।\nइंद्रद्युम्नं नरपतिं संलपंतं कृतांजलिम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003779038, "chapter_id": 23779, "verse_number": "२-२-२३-३९", "content_sanskrit": "तांल्लोकपालान्प्रणतान्कटाक्षेण जगत्प्रभुः ।\nअनुजग्राह कथयन्निंद्रद्युम्नं ससादरम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003779039, "chapter_id": 23779, "verse_number": "२-२-२३-४०", "content_sanskrit": "राजन्कृतस्त्वया सत्यं प्रासादो भगवत्स्थितौ ।\nनायं कालस्तथा राज्यं न वा त्वत्संततिर्नृप ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003779040, "chapter_id": 23779, "verse_number": "२-२-२३-४१", "content_sanskrit": "गीतगानावसरतो भूयान्कालो गतस्तव ।\nमन्वंतरो हि दिव्यानां युगानामेकसप्ततिः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003779041, "chapter_id": 23779, "verse_number": "२-२-२३-४२", "content_sanskrit": "तव वंशोऽपि विच्छिन्नः कोटिशः क्षितिपा गताः ।\nदेवोंऽतिमश्च प्रासादो द्वयमत्रावशिष्यते ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003779042, "chapter_id": 23779, "verse_number": "२-२-२३-४३", "content_sanskrit": "द्वितीयस्य मनोरादियुगं स्वारोचिषस्य तु ।\nममांतिकेऽत्र वसतोमृत्युर्वा न जरा तथा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003779043, "chapter_id": 23779, "verse_number": "२-२-२३-४४", "content_sanskrit": "विपर्ययमृतूनां वा न कालपरिणामता ।\nतद्गच्छ भूमौ राजेंद्र देवं प्रासादमेव च ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003779044, "chapter_id": 23779, "verse_number": "२-२-२३-४५", "content_sanskrit": "आत्मसंबंधिनं कृत्वा पुनरायाहि वेगवान् ।\nअथवाहं प्रयास्यामि तवानुपदमेव हि ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003779045, "chapter_id": 23779, "verse_number": "२-२-२३-४६", "content_sanskrit": "त्वमग्रतो धरां गत्वा यावत्संभारमृद्धिमत् ।\nकरिष्यसि महाभाग तावदेव व्रजाम्यहम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003779046, "chapter_id": 23779, "verse_number": "२-२-२३-४७", "content_sanskrit": "इत्याज्ञाप्येंद्रद्युम्नं तं भगवान्स पितामहः ।\nदेवान्पुरःस्थितानाह विनयानतकंधरान् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003779047, "chapter_id": 23779, "verse_number": "२-२-२३-४८", "content_sanskrit": "बद्धांजलीन्साध्वसांस्तांस्तत्पादन्यस्तवीक्षणान् ।\nउवाच भगवान्स्निग्धगंभीरवचसा द्विजाः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003779048, "chapter_id": 23779, "verse_number": "२-२-२३-४९", "content_sanskrit": "किमर्थमागताः सर्वे युगपत्तु दिवौकसः ।\nयत्कार्यं वो मया कार्यं विज्ञापयत मा चिरम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003779049, "chapter_id": 23779, "verse_number": "२-२-२३-५०", "content_sanskrit": "जैमिनिरुवाच ।\nइति श्रुत्वा वचो धातुस्त्रिदशा विगतज्वराः ।\nप्रत्यूचुर्हर्षिताः सर्वे भगवंतं पितामहम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003779050, "chapter_id": 23779, "verse_number": "२-२-२३-५१", "content_sanskrit": "देवा ऊचुः ।\nउपासितः पुरास्माभिर्यो नीलाद्रौ मणीमयः ।\nअन्तर्हितः कथं देव इदानीं दारुदेहधृक् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003779051, "chapter_id": 23779, "verse_number": "२-२-२३-५२", "content_sanskrit": "आविर्भूतः क्रतोरंत इन्द्रद्युम्नस्य भूपतेः ।\nएतस्य कारणं ज्ञातुं भवतः पादपंकजम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003779052, "chapter_id": 23779, "verse_number": "२-२-२३-५३", "content_sanskrit": "आराधितुमिहायाताः प्रसीद कथयस्व तत् ।\nइत्युक्ते त्रिदशैर्देवो भगवान्पंकजासनः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003779053, "chapter_id": 23779, "verse_number": "२-२-२३-५४", "content_sanskrit": "रहस्यमेतद्भो देवाः कस्यचिन्नोदितं पुरा ।\nसर्वे समुदिता यस्मादपृच्छत चिरागताः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003779054, "chapter_id": 23779, "verse_number": "२-२-२३-५५", "content_sanskrit": "ततो वः कथयिष्यामि सुराणां गुह्यमुत्तमम् ।\nपूर्वे परार्द्धे भो देवाः क्षेत्रं श्रीपुरुषोत्तमम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003779055, "chapter_id": 23779, "verse_number": "२-२-२३-५६", "content_sanskrit": "नीलाश्मवपुरास्थाय न तत्याज जनार्दनः ।\nसांप्रतं मे द्वितीयं तु परार्द्धं समुपस्थितम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003779056, "chapter_id": 23779, "verse_number": "२-२-२३-५७", "content_sanskrit": "मनुः स्वायम्भुवो नाम श्वेतवाराहकल्पके ।\nप्रवर्त्ततेऽयं कालो वै प्रातराद्यदिनस्य च ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003779057, "chapter_id": 23779, "verse_number": "२-२-२३-५८", "content_sanskrit": "दारुमूर्तिरयं देवो भुवनानां हि मध्यमे ।\nममायुषः प्रमाणं तु स्थास्यते मानयन्प्रभुः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003779058, "chapter_id": 23779, "verse_number": "२-२-२३-५९", "content_sanskrit": "ममात्मा एष भगवानहमेतन्मयः सुराः ।\nनावयोर्विद्यते किंचिदस्मिन्स्थावरजंगमे ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003779059, "chapter_id": 23779, "verse_number": "२-२-२३-६०", "content_sanskrit": "क्षीरोदार्णवमध्ये हि श्वेतद्वीपे हि तल्पके ।\nयः शेते योगनिद्रां तां मानयन्पुरुषोत्तमः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003779060, "chapter_id": 23779, "verse_number": "२-२-२३-६१", "content_sanskrit": "स मूलं जगतामादिस्तस्य रोमाणि यानि वै॥ तानि कल्पद्रुमाख्यानि शंखचक्रांकितानि वै ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003779061, "chapter_id": 23779, "verse_number": "२-२-२३-६२", "content_sanskrit": "तन्मध्यस्थो ह्ययं वृक्षश्चैतन्याधिष्ठितः सुराः ।\nस्वयमुत्पतितः सिंधोः सलिले सत्यपूरुषः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003779062, "chapter_id": 23779, "verse_number": "२-२-२३-६३", "content_sanskrit": "भोगान्भोक्तुं त्रिलोकस्थान्दारुवर्ष्मा जनार्दनः ।\nअनेकजन्मसाहस्रैर्भक्तियोगेन भावितः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003779063, "chapter_id": 23779, "verse_number": "२-२-२३-६४", "content_sanskrit": "घोरसंसारनाशाय मया पूर्वं प्रयाचितः ।\nपुनः पुनः सृष्टिलीनपालनोद्विग्नचेतसा ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003779064, "chapter_id": 23779, "verse_number": "२-२-२३-६५", "content_sanskrit": "अशेषकर्मनाशाय जगतां सर्वमुक्तये ।\nधारणाध्यानयोगानां दुष्कराणां विनापि सः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003779065, "chapter_id": 23779, "verse_number": "२-२-२३-६६", "content_sanskrit": "मोक्षाय भगवानाविर्बभूव पुरुषोत्तमः ।\nप्रच्छन्नं वपुरेतस्य क्षेत्रं नास्य विचारयेत् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003779066, "chapter_id": 23779, "verse_number": "२-२-२३-६७", "content_sanskrit": "धर्मिग्राहप्रमाणेन यादृग्दृष्टः स एव सः ।\nचतुर्वर्गप्रदो देवो यो यथा तं विभावयेत् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003779067, "chapter_id": 23779, "verse_number": "२-२-२३-६८", "content_sanskrit": "तद्दर्शनपरिक्षीणपापसंघाः क्रमाद्भुवि ।\nभवन्ति निर्मलात्मानः पुरुषा मुक्तिभाजनम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003779068, "chapter_id": 23779, "verse_number": "२-२-२३-६९", "content_sanskrit": "जैमिनिरुवाच ।\nएतच्छ्रुत्वा तु ते देवाः पद्मयोनेर्वचोमृतम् ।\nहृष्टाः संचिंतयामासुः प्रहृष्टेनांतरात्मना ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003779069, "chapter_id": 23779, "verse_number": "२-२-२३-७०", "content_sanskrit": "अचिरस्थायि देवत्वं विहायैतद्भुवं गताः ।\nअस्मिन्क्षेत्रवरे देवमाराध्यामः सुसंयताः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003779070, "chapter_id": 23779, "verse_number": "२-२-२३-७१", "content_sanskrit": "हर्षप्रफुल्लवदनान्सुरान्दृष्ट्वा पितामह ।\nइन्द्रद्युम्नानुग्रहाय यः प्रकाशं गतः प्रभुः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003779071, "chapter_id": 23779, "verse_number": "२-२-२३-७२", "content_sanskrit": "याताऽत्र प्रतिमा त्वस्य स्वयमेव वदिष्यति ।\nवरान्प्रदास्यति बहून्भगवान्भक्तवत्सलः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003779072, "chapter_id": 23779, "verse_number": "२-२-२३-७३", "content_sanskrit": "प्रासादमिन्द्रद्युम्नस्य प्रतिष्ठापयितुं विभुम् ।\nअहं चापि गमिष्यामि यूयं तत्र प्रयात वै ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003779073, "chapter_id": 23779, "verse_number": "२-२-२३-७४", "content_sanskrit": "इन्द्रद्युम्नोऽग्रतो यातु प्रतिष्ठावस्तुसंभृतौ ।\nसहायास्तत्र भवत यूयं क्षीणाधिकारिणः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003779074, "chapter_id": 23779, "verse_number": "२-२-२३-७५", "content_sanskrit": "मन्वन्तरं व्यतीतं वै प्रथमं सांप्रतं सुराः ।\nइन्द्रद्युम्नेन सहितास्तत्र गत्वा सुरोत्तमाः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003779075, "chapter_id": 23779, "verse_number": "२-२-२३-७६", "content_sanskrit": "प्रासादप्रतिमानां च विधर्ता स्वाम्यमस्य वै ।\nतस्मात्संभृतसंभारः ससहायोऽधुना ह्यसौ ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003779076, "chapter_id": 23779, "verse_number": "२-२-२३-७७", "content_sanskrit": "अस्य संततिसंबन्धस्मरणादपि भूतले ।\nमदाज्ञया पद्मनिधिः सह यास्यति भूतलम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003779077, "chapter_id": 23779, "verse_number": "२-२-२३-७८", "content_sanskrit": "प्रतिष्ठायै भगवतः संयतौ सर्ववस्तुनः ।\nइन्द्रद्युम्नोऽपि हृष्टात्मा दृष्ट्वा ब्राह्मीं श्रियं द्विजाः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003779078, "chapter_id": 23779, "verse_number": "२-२-२३-७९", "content_sanskrit": "महदाश्चर्यसंपन्नः प्रणिपत्य जगद्गुरुम् ।\nतदाज्ञां शिरसा धृत्वा देवैः क्षीणाधिकारिभिः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003779079, "chapter_id": 23779, "verse_number": "२-२-२३-८०", "content_sanskrit": "आजगाम भुवं विप्रा विधिना चानुमोदिताः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003779080, "chapter_id": 23779, "verse_number": "२-२-२३-८१", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां द्वितीये वैष्णवखण्डे पुरुषोत्तमक्षेत्रमाहात्म्ये जैमिनिऋषिसंवादे त्रयोविंशोऽध्यायः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}]