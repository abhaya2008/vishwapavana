[{"id": 2110851, "chapter_id": 3396, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2110852, "chapter_id": 3396, "verse_number": "१", "content_sanskrit": "एवं स नाहुषो राजा ययातिः पूरुमीप्सितम् ।\nराज्येऽभिषिच्य मुदितो वानप्रस्थोऽभवन्मुनिः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2110853, "chapter_id": 3396, "verse_number": "२", "content_sanskrit": "उषित्वा च वने वासं ब्राह्मणैस्तापसैः सह ।\nफलमूलाशनो भूत्वा ततः स्वर्गमितो गतः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2110854, "chapter_id": 3396, "verse_number": "३", "content_sanskrit": "स गतः स्वर्गवासार्थं निवसन् सुरवेश्मनि ।\nकालेन नातिमहता पुनः शक्रेण पातितः ।\nसाधुभिः सङ्गतिं लब्ध्वा पुनः स्वर्गमिति श्रुतिः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2110855, "chapter_id": 3396, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2110856, "chapter_id": 3396, "verse_number": "४", "content_sanskrit": "स्वर्गतः स पुनर्ब्रह्मन् निवसन् देववेश्मनि ।\nकालेन नातिमहता शक्रेण च्यावितः कथम् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2110857, "chapter_id": 3396, "verse_number": "५", "content_sanskrit": "निवसन् प्रच्युतः स्वर्गादप्राप्तो मेदिनीतळम् ।\nस्थित आसीदन्तरिक्षे स तदेति श्रुतं मया\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2110858, "chapter_id": 3396, "verse_number": "६", "content_sanskrit": "तत एव पुनश्चापि गतः स्वर्गमिति श्रुतम् ।\nतदा सार्धं वसुमता श्रीमता चाष्टकेन च \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2110859, "chapter_id": 3396, "verse_number": "७", "content_sanskrit": "प्रतर्दनेन शिबिना समेत्य किल संसदि ।\nकारणेन दिवं केन सम्प्राप्तो द्विजसत्तम\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2110860, "chapter_id": 3396, "verse_number": "८", "content_sanskrit": "सर्वमेतदशेषेण श्रोतुमिच्छामि तत्वतः ।\nकथ्यमानं त्वया विप्र देवर्षिगणसन्निधौ \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2110861, "chapter_id": 3396, "verse_number": "९", "content_sanskrit": "देवराजसमो ह्यासीद् ययातिः पृथिवीपतिः ।\nवर्धनः कुरुवंशस्य विभावसुसमद्युतिः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2110862, "chapter_id": 3396, "verse_number": "१०", "content_sanskrit": "तस्य विस्तीर्णयशसः सत्यकीर्तेर्महात्मनः ।\nचरितं श्रोतुमिच्छामि दिवि चेह च सर्वशः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2110863, "chapter_id": 3396, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2110864, "chapter_id": 3396, "verse_number": "११", "content_sanskrit": "हन्त ते कथयिष्यामि ययातेरुत्तरां कथाम् ।\nदिवि चेह च पूर्णार्थां सर्वपापप्रणाशिनीम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2110865, "chapter_id": 3396, "verse_number": "१२", "content_sanskrit": "ययातिर्नाहुषो राजा पूरुं पुत्रं कनीयसम् ।\nराज्येऽभिषिच्य मुदितः प्रवव्राज वनं तदा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2110866, "chapter_id": 3396, "verse_number": "१३", "content_sanskrit": "अन्तेषु स विनिक्षिप्य पुत्रान् वै पूरुपूर्वजान् ।\nफलमूलाशनो भूत्वा वने सन्न्यवसच्चिरम् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2110867, "chapter_id": 3396, "verse_number": "१४", "content_sanskrit": "संयतात्मा जितक्रोधः तर्पयन् पितृदेवताः ।\nअग्नींश्च विधिवज्जुह्णन् वानप्रस्थविधानतः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2110868, "chapter_id": 3396, "verse_number": "१५", "content_sanskrit": "अतिथीन् पूजयामास वन्येन हविषा द्विजान् ।\nसिलोञ्छवृत्तिमास्थाय शेषान्नकृतभोजनः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2110869, "chapter_id": 3396, "verse_number": "१६", "content_sanskrit": "पूर्णं वर्षसहस्रं च एवंवृत्तिरभून्नृपः ।\nअब्भक्षः शरदस्त्रिंशद् आसीन्नियतवाङ्मनः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2110870, "chapter_id": 3396, "verse_number": "१७", "content_sanskrit": "ततश्च वायुभक्षोऽभूत् संवत्सरमतन्द्रितः ।\nपञ्चाग्निमध्ये च तपस्तेपे संवत्सरं मुनिः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2110871, "chapter_id": 3396, "verse_number": "१८", "content_sanskrit": "एकपादस्थितश्चासीत् षण्मासांश्च ततः परम् ।\nएवमेव तदाब्दानां पर्यायेण तपन् वने ।\nमहायोगी गतः स्वर्गं जगामावृत्य रोदसी\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2110872, "chapter_id": 3396, "verse_number": "७५", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nपञ्चसप्ततितमोऽध्यायः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2110873, "chapter_id": 3396, "verse_number": "२३", "content_sanskrit": "॥ सम्भवर्पणि त्रयोविंशोऽध्यायः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]