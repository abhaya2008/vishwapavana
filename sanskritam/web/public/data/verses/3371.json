[{"id": 2109237, "chapter_id": 3371, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2109238, "chapter_id": 3371, "verse_number": "१", "content_sanskrit": "बालो वाक्यं स्थविर इव प्रभाषसे\nनायं बालः स्थविरो धर्मतो मे ।\nइच्छाम्यहं वरमस्मै प्रदातुं\nतद् वै विप्राः प्रवदध्वं समेताः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2109239, "chapter_id": 3371, "verse_number": "", "content_sanskrit": "सदस्याः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2109240, "chapter_id": 3371, "verse_number": "२", "content_sanskrit": "बालो विप्रो मान्य एवेह राज्ञा\nयश्चाविद्वान् यश्च विद्वान् यथावत् ।\nसर्वान् कामांस्त्वत्त एवार्हतेऽद्य\nयथा च नस्तक्षक एति शीघ्रम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2109241, "chapter_id": 3371, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2109242, "chapter_id": 3371, "verse_number": "३", "content_sanskrit": "व्याहर्तुकामे वरदे नृपे द्विजं\nवरं वृणीष्वेति तमभ्युवाच ।\nहोता वाचा नातिहृष्टान्तरात्मा\nकर्मण्यस्मिंस्तक्षको नैति राजन् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2109243, "chapter_id": 3371, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2109244, "chapter_id": 3371, "verse_number": "४", "content_sanskrit": "यथा चेदं कर्म समाप्यते मे\nयथा च नस्तक्षक एति शीघ्रम् ।\nतथा भवन्तः प्रयतन्तु सर्वे\nपरं शक्त्या स हि मे विद्विषाणः\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2109245, "chapter_id": 3371, "verse_number": "", "content_sanskrit": "ऋत्विजः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2109246, "chapter_id": 3371, "verse_number": "५", "content_sanskrit": "यथा शास्त्राणि नः प्राहुर्निमित्तानि तथैव च ।\nइन्द्रस्य भवने राजंस्तक्षको भयपीडितः\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2109247, "chapter_id": 3371, "verse_number": "६", "content_sanskrit": "यथा सूतो लोहिताक्षो महात्मा\nपौराणिको वेदितवान् पुरस्तात् ।\nस राजानं प्राह हृष्टस्तदानीं\nयथाहुर्विप्रास्तद्वदेतन्नरेन्द्र \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2109248, "chapter_id": 3371, "verse_number": "७", "content_sanskrit": "पुराणमागम्य ततो ब्रवीम्यहं\nदत्तं तस्मै वरमिन्द्रेण राजन् ।\nवसेह त्वं मत्सकाशे सुगुप्तो\nन पावकस्त्वां प्रतिधक्ष्यतीति\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2109249, "chapter_id": 3371, "verse_number": "८", "content_sanskrit": "एतच्छ्रुत्वा दीक्षितस्तप्यमान\nआस्ते होतारं चोदयन् कर्मकाले ।\nहोता यत्तः स जुहाव मन्त्रै-\nरथान्विन्द्रः स्वयमेवाजगाम \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2109250, "chapter_id": 3371, "verse_number": "९", "content_sanskrit": "आयातु चेन्द्रोऽपि सतक्षकः पतेद्\nविभावसौ नागराजेन तूर्णम् ।\nजम्भस्य हन्तेति जुहाव होता\nतदा जगामाहिदत्ताभयः प्रभुः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2109251, "chapter_id": 3371, "verse_number": "१०", "content_sanskrit": "विमानमारुह्य महानुभावः सर्वैर्देवैः परिसंस्तूयमानः ।\nबलाहकैश्चाप्यनुगम्यमानो विद्याधरैरप्सरसां गणैश्च \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2109252, "chapter_id": 3371, "verse_number": "११", "content_sanskrit": "तस्योत्तरीये निहितः स नागो\nभयोद्विग्नः शर्म नैवाभ्यगच्छत् ।\nततो राजा मन्त्रविदोऽब्रवीच्च\nक्रुद्धस्तदा तक्षकस्यान्तमिच्छन्\t ॥ ११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2109253, "chapter_id": 3371, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2109254, "chapter_id": 3371, "verse_number": "१२", "content_sanskrit": "इन्द्रस्य भवने विप्र यदि तस्थौ स तक्षकः ।\nतमिन्द्रेणैव सहितं पातयध्वं विभावसौ ।\nपालयेद् यदि तत्रेन्द्रः स नागं तक्षकं तथा \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2109255, "chapter_id": 3371, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2109256, "chapter_id": 3371, "verse_number": "१३", "content_sanskrit": "जनमेजयेन राज्ञा तु चोदितस्तक्षकं प्रति ।\nहोताऽऽजुहाव तत्रस्थं सशक्रं तक्षकं तथा \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2109257, "chapter_id": 3371, "verse_number": "१४", "content_sanskrit": "हूयमाने तथा चैव तक्षकः सपुरन्दरः ।\nआकाशे ददृशे तत्र क्षणेन व्यथितस्तदा \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2109258, "chapter_id": 3371, "verse_number": "१५", "content_sanskrit": "पुरन्दरस्तु तं यज्ञं दृष्ट्वा तु भयमाविशत् ।\nहित्वा तु तक्षकं नागं स्वमेव भवनं ययौ \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2109259, "chapter_id": 3371, "verse_number": "१६", "content_sanskrit": "इन्द्रे गते तु नागेन्द्रः तक्षको भयमोहितः ।\nमन्त्रशक्त्या तु सप्तार्चेः समीपमवशोऽगमत् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2109260, "chapter_id": 3371, "verse_number": "१७", "content_sanskrit": "तं दृष्टा ऋत्विजस्तत्र वचनं चेदमब्रुवन् ।\nअयमायाति वै तूर्णं तक्षकस्ते वशं गतः ।\nश्रूयतेऽस्य महान् नादो भैरवं रुवतो महत् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2109261, "chapter_id": 3371, "verse_number": "१८", "content_sanskrit": "नूनं युक्तोऽयं यज्ञभूमौ स नागो\nभ्रष्टो महामन्त्रवित्रस्तकाय\nआघूर्णमानो हि समभ्युपैति\nतीव्रान् निश्वासान् निश्वसन् पन्नगेन्द्रः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2109262, "chapter_id": 3371, "verse_number": "१९", "content_sanskrit": "वर्तते तव राजेन्द्र कर्मैतद् विधिवत् प्रभो ।\nअस्मै च द्विजमुख्याय वरं दातुं त्वमर्हसि \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2109263, "chapter_id": 3371, "verse_number": "", "content_sanskrit": "राजा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2109264, "chapter_id": 3371, "verse_number": "२०", "content_sanskrit": "बालाभिरूपस्य तवाप्रमेय\nवरं प्रयच्छामि यथानुरूपम् ।\nवृणीष्व यत् तेऽभिमतं हृदिस्थं\nतत् ते प्रदास्याम्यपि चेददेयम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2109265, "chapter_id": 3371, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2109266, "chapter_id": 3371, "verse_number": "२१", "content_sanskrit": "पतिष्यमाणे नागेन्द्रे तक्षके जातवेदसि ।\nइदमन्तरमित्येवं तदाऽऽस्तीको न्यवेदयत् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2109267, "chapter_id": 3371, "verse_number": "", "content_sanskrit": "आस्तीकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2109268, "chapter_id": 3371, "verse_number": "२२", "content_sanskrit": "वरं ददासि चेन्मह्यं वृणोमि जनमेजय ।\nसत्रं ते विरमत्वेतन्न पतेयुरिहोरगाः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2109269, "chapter_id": 3371, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2109270, "chapter_id": 3371, "verse_number": "२३", "content_sanskrit": "एवमुक्तस्तदा राजा ब्रह्मन् पारीक्षितस्तदा ।\nनातिहृष्टमना वाक्यमास्तीकमिदमब्रवीत् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2109271, "chapter_id": 3371, "verse_number": "२४", "content_sanskrit": "सुवर्णं रजतं गाश्च यच्चान्यन्मन्यसे द्विज ।\nतत् ते दद्यां सुवासांसि न निवर्तेत् क्रतुर्मम\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2109272, "chapter_id": 3371, "verse_number": "", "content_sanskrit": "आस्तीकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2109273, "chapter_id": 3371, "verse_number": "२५", "content_sanskrit": "सुवर्णं रजतं गाश्च न त्वां राजन् वृणोम्यहम् ।\nसत्रं ते विरमत्वेतत् स्वस्ति मातृकुलस्य नः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2109274, "chapter_id": 3371, "verse_number": "", "content_sanskrit": "सौतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2109275, "chapter_id": 3371, "verse_number": "२६", "content_sanskrit": "आस्तीकेनैवमुक्तस्तु राजा पारीक्षितस्तदा ।\nपुनःपुनरुवाचेदमास्तीकं वदतां वरः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2109276, "chapter_id": 3371, "verse_number": "२७", "content_sanskrit": "अन्यं वरय भद्रं ते वरं द्विजवरोत्तम ।\nअयाचत नचाप्यन्यं वरं स भृगुनन्दन\t ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2109277, "chapter_id": 3371, "verse_number": "२८", "content_sanskrit": "ततो वेदविदस्तात सदस्याः सर्व एव तम् ।\nराजानमूचुः सहिता लभतां ब्राह्मणो वरम् \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2109278, "chapter_id": 3371, "verse_number": "२९", "content_sanskrit": "श्रुत्वा तन्नृपतिर्वाक्यं ददौ तस्मै वरं तदा ।\nसिषितुश्चैव राजानं ब्राह्मणा दीक्षितं पुनः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2109279, "chapter_id": 3371, "verse_number": "५०", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nपञ्चाशोऽध्यायः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2109280, "chapter_id": 3371, "verse_number": "३८", "content_sanskrit": "॥ आस्तीकपर्वणि अष्टत्रिंशोऽध्यायः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]