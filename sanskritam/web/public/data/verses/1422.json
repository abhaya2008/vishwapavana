[{"id": 2020138, "chapter_id": 1422, "verse_number": "३-६०-०x", "content_sanskrit": "बृहदश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2020139, "chapter_id": 1422, "verse_number": "३-६०-१", "content_sanskrit": "अपक्रान्ते नले राजन्दमयन्ती गतक्लमा।\nअबुध्यत वरारोहा संत्रस्ता विजने वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2020140, "chapter_id": 1422, "verse_number": "३-६०-२", "content_sanskrit": "अपश्यमाना भर्तारं शोकदुःखसमन्विता।\nप्राक्रोशदुच्चैः संत्रस्ता महाराजेति नैषधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2020141, "chapter_id": 1422, "verse_number": "३-६०-३", "content_sanskrit": "हा नाथ हा महाराज हा स्वामिन्किं जहासि माम्।\nहा हताऽस्मि विनष्टाऽस्मि भीताऽस्मि विजने वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2020142, "chapter_id": 1422, "verse_number": "३-६०-४", "content_sanskrit": "ननु नाम महारज धर्मज्ञः सत्यवागसि।\nकथंविधस्त्वंहि तथा सुप्तामुत्सृज्य मां गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2020143, "chapter_id": 1422, "verse_number": "३-६०-५", "content_sanskrit": "कथमुत्सृज्यगन्ताऽसि वश्यां भार्यामनुव्रताम्।\nविशेषतो नापकृतः परेणापकृतो ह्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2020144, "chapter_id": 1422, "verse_number": "३-६०-६", "content_sanskrit": "शक्यसे न गिरः सत्याः कर्तुं मयि नरेश्वर।\nयास्त्वया लोकपालानां सन्निधौ कथिताः पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2020145, "chapter_id": 1422, "verse_number": "३-६०-७", "content_sanskrit": "नाकाले विहितो मृत्युर्मर्त्यानां पुरुषर्षभ।\nयत्र कान्ता त्वयोत्सृष्टा मुहूर्तमपि जीवति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2020146, "chapter_id": 1422, "verse_number": "३-६०-८", "content_sanskrit": "पर्याप्तः परिहासोऽयमेतावान्पुरुषर्षभ।\nभृशं भीतास्मि दुर्धर्ष दर्शयात्मानमीश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2020147, "chapter_id": 1422, "verse_number": "३-६०-९", "content_sanskrit": "दृश्यसे दृश्यसे राजन्नेष तिष्ठसि नैषध।\nआवार्य गुल्मैरात्मानं किं मां न प्रतिभाषसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2020148, "chapter_id": 1422, "verse_number": "३-६०-१०", "content_sanskrit": "नृशंसां वत राजेन्द्र यन्मामेवंगतामिह।\nविलपन्तीं समालिङ्ग्य नाश्वासयसि पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2020149, "chapter_id": 1422, "verse_number": "३-६०-११", "content_sanskrit": "न शोचाम्यहमात्मानं न चान्यदपि किंचन।\nकथं नु भवितास्येक इति त्वां नृप शोचये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2020150, "chapter_id": 1422, "verse_number": "३-६०-१२", "content_sanskrit": "कथं नु राजंस्तृषितः क्षुक्षितः श्रमकर्शितः।\nसायाह्ने वृक्षमूलेषु मामपश्यन्भविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2020151, "chapter_id": 1422, "verse_number": "३-६०-१३", "content_sanskrit": "ततः सा तीव्रशोकार्ता प्रदीप्तेव च मन्युना।\nइतश्चेतश्च रुदती पर्यधावत दुःखिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2020152, "chapter_id": 1422, "verse_number": "३-६०-१४", "content_sanskrit": "मुहुरुत्पतते बाला मुहुः पतति विह्वला।\nमुहुरालीयते भीता मुहुः क्रोशति रोदिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2020153, "chapter_id": 1422, "verse_number": "३-६०-१५", "content_sanskrit": "अतीव शोकसंतप्ता मुहुर्निःश्वस् विह्वला।\nउवाच भैमी निःश्वस् रोदमाना पतिव्रता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2020154, "chapter_id": 1422, "verse_number": "३-६०-१६", "content_sanskrit": "यस्याभिशापाद्दुःखार्तो नैष नन्दति नैषधः।\nतस्य भूतस्य तद्दुःखाद्दुःखमभ्यधिकं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2020155, "chapter_id": 1422, "verse_number": "३-६०-१७", "content_sanskrit": "अपापचेतसं पापो य एवं कृतवान्नलम्।\nतस्माद्दुःखतरं प्राप्य जीवत्वमसुखजीविकाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2020156, "chapter_id": 1422, "verse_number": "३-६०-१८", "content_sanskrit": "एवं तु विलपन्ती सा राज्ञो भार्या महात्मनः।\nअन्वेषति स्म भर्तारं वने श्वापदसेविते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2020157, "chapter_id": 1422, "verse_number": "३-६०-१९", "content_sanskrit": "उन्मत्तवद्भीमसुता विलपन्ती ततस्ततः।\nहाहा राजन्निति मुहुरितश्चेतश्च धावति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2020158, "chapter_id": 1422, "verse_number": "३-६०-२०", "content_sanskrit": "तां शुष्यमाणामत्यर्थं कुररीमिव वाशतीम्।\nकरुणं बहुशोचन्तीं विलपन्तीं सुमध्यमाम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2020159, "chapter_id": 1422, "verse_number": "३-६०-२१", "content_sanskrit": "सहसाऽभ्यागतां भैमीमभ्याशपरिवर्तिनीम्।\nजग्राहाजगरो ग्राहो महाकायः क्षुधान्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2020160, "chapter_id": 1422, "verse_number": "३-६०-२२", "content_sanskrit": "सा ग्रस्यमाना ग्रहेण शोकेन च पराजिता।\nनात्मानं शोचति तथा यथा शोचति नैषधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2020161, "chapter_id": 1422, "verse_number": "३-६०-२३", "content_sanskrit": "द्वा नाथ मामिह वने ग्रस्यमानामनागसम्।\nग्राहेणानेन विजने किमर्थं नानुधावसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2020162, "chapter_id": 1422, "verse_number": "३-६०-२४", "content_sanskrit": "कथं भविष्यसि पुनर्मामनुस्मृत्य नैषध।\n[कथं भवाञ्जगामाद्य मामुत्सृज्य वने प्रभो।]\nपापान्मुक्तः पुनर्लब्ध्वा बुद्धिं चोतो धनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2020163, "chapter_id": 1422, "verse_number": "३-६०-२५", "content_sanskrit": "श्रान्तस्य ते क्षुधार्तस् परिग्लानस्य नैषध।\nकः श्रमं राजशार्दूल नाशयिष्यति तेऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2020164, "chapter_id": 1422, "verse_number": "३-६०-२६x", "content_sanskrit": "बृहदश्च उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2020165, "chapter_id": 1422, "verse_number": "३-६०-२६", "content_sanskrit": "तां तु दृष्ट्वा तथा ग्रस्तामुरगेणायतेक्षणाम्।\nआक्रन्दमानां संश्रुत्य जवेनाभिससार ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2020166, "chapter_id": 1422, "verse_number": "३-६०-२७", "content_sanskrit": "तां तु दृष्ट्वा तथा ग्रस्तामुरगेणायतेक्षणाम्।\nत्वरमाणो मृगव्याधः संचरन्गहने वने।\nसमभिक्रम्य वेगेन सत्वरः स वनेचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2020167, "chapter_id": 1422, "verse_number": "३-६०-२८", "content_sanskrit": "मुखे तं पाटयामास शस्त्रेण निशितेन च।\nनिर्विचेष्टं भुजङ्गं तं विशस् मृगजीवनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2020168, "chapter_id": 1422, "verse_number": "३-६०-२९", "content_sanskrit": "मोक्षयित्वा स तांव्याधः प्रक्षाल्य सलिलेन ह।\nसमाश्वास्य कृताहारामथ पप्रच्छ भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2020169, "chapter_id": 1422, "verse_number": "३-६०-३०", "content_sanskrit": "कस्य त्वं मृगशावाक्षि कथं चास्यागता वनम्।\nकथं चेदं महत्कृच्छ्रं प्राप्तवत्यसि भामिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2020170, "chapter_id": 1422, "verse_number": "३-६०-३१", "content_sanskrit": "दमयन्ती तथा तेन पृच्छ्यमाना विशांपते।\nसर्वमेतद्यथावृत्तमाचचक्षेऽस्य भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2020171, "chapter_id": 1422, "verse_number": "३-६०-३२", "content_sanskrit": "तामर्धवस्त्रसंवीतां पीनश्रोणिपयोधराम्।\nसुकुमारानवद्याङ्गीं पूर्णचन्द्रनिभाननाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2020172, "chapter_id": 1422, "verse_number": "३-६०-३३", "content_sanskrit": "अरालपक्ष्मनयनां तथा मधुरभाषिणीम्।\nलक्षयित्वा मृगव्याधः कामस्य वशमीयिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2020173, "chapter_id": 1422, "verse_number": "३-६०-३४", "content_sanskrit": "तामथ श्लक्ष्णया वाचा लुब्धको मृदुपूर्वया।\nसान्त्वयामास कामार्तस्तदबुध्यत भामिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2020174, "chapter_id": 1422, "verse_number": "३-६०-३५", "content_sanskrit": "दमयन्त्यपि तं दुष्टमुपलभ्य पतिव्रता।\nतीव्ररोषसमाविष्टा प्रजज्वालेव मन्युना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2020175, "chapter_id": 1422, "verse_number": "३-६०-३६", "content_sanskrit": "स तु पापमतिः क्षुद्रः प्रधर्षयितुमातुरः।\nदुर्धर्षां तर्कयामास दीप्तामग्निशिखामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2020176, "chapter_id": 1422, "verse_number": "३-६०-३७", "content_sanskrit": "दमयन्ती तु दुःखार्था पतिराज्यविनाकृता।\nअतीतवाक्यथे काले शशापैनं रुषा किल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2020177, "chapter_id": 1422, "verse_number": "३-६०-३८", "content_sanskrit": "यथाऽहं नैषधादन्यं मनसाऽपि न चिन्तये।\nतथाऽयं पततां क्षुद्रः परासुर्मृगजीवनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2020178, "chapter_id": 1422, "verse_number": "३-६०-३९", "content_sanskrit": "उक्तमात्रे तु वचने तया स मृगजीवनः।\nव्यसुः पपात मेदिन्यामग्निदग्ध इव द्रुमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2020179, "chapter_id": 1422, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि नलोपाख्यानपर्वणि षष्टितमोऽध्यायः ॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]