[{"id": 2027037, "chapter_id": 1579, "verse_number": "३-२१७-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2027038, "chapter_id": 1579, "verse_number": "३-२१७-१", "content_sanskrit": "एवं संकथिते कृत्स्ने मोक्षधर्मे युधिष्ठिर।\nदृढप्रीतमना विप्रो धर्मव्याधमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2027039, "chapter_id": 1579, "verse_number": "३-२१७-२", "content_sanskrit": "न्याययुक्तमिदं सर्वं भवता परिकीर्तितम्।\nन तेऽस्त्यविदितं किंचिद्धर्मेष्वभिसमीक्ष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2027040, "chapter_id": 1579, "verse_number": "३-२१७-३x", "content_sanskrit": "व्याध उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2027041, "chapter_id": 1579, "verse_number": "३-२१७-३", "content_sanskrit": "प्रत्यक्षं मम यो धर्मस्तं च पश्य द्विजोत्तम।\nयेन सिद्धिरियं प्राप्ता मया ब्राह्मणपुङ्गव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2027042, "chapter_id": 1579, "verse_number": "३-२१७-४", "content_sanskrit": "उत्तिष्ठ भगवन्क्षिप्रं प्रविश्याभ्यन्तरं गृहम्।\nद्रष्टुमर्हसि धर्मज्ञ मातरं पितरं च मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2027043, "chapter_id": 1579, "verse_number": "३-२१७-५", "content_sanskrit": "इत्युक्तः स प्रविश्याथ ददर्श परमार्चितम्।\nसौधं हृद्यं चतुःशालमतीव च मनोरमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2027044, "chapter_id": 1579, "verse_number": "३-२१७-६", "content_sanskrit": "देवतागृहसंकाश दैवतैश्च सुपूजितम्।\nशयनासनसंबाधं गन्धैश्च परमैर्युतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2027045, "chapter_id": 1579, "verse_number": "३-२१७-७", "content_sanskrit": "तत्रशुक्लाम्बरधरौ पितरावस्य पूजितौ।\nकृताहारौ तु संतुष्टावुपविष्टौ वरासने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2027046, "chapter_id": 1579, "verse_number": "३-२१७-८", "content_sanskrit": "`तस्य व्याधस्य पितरौ ब्राह्मणः संददर्श ह।\nधर्मव्याधस्तु तौ दृष्ट्वा पादेषु शिरसाऽपतत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2027047, "chapter_id": 1579, "verse_number": "३-२१७-९x", "content_sanskrit": "वृद्धावूचतुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2027048, "chapter_id": 1579, "verse_number": "३-२१७-९", "content_sanskrit": "उत्तिष्ठोत्तिष्ठ धर्मज्ञ धर्मस्त्वामभिरक्षतु।\nप्रीतौ स्वस्तव शौचेन दीर्घमायुरवाप्नुहि।\n[गतिमिष्टां तपो ज्ञानं मेधां च परमां गतः] ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2027049, "chapter_id": 1579, "verse_number": "३-२१७-१०", "content_sanskrit": "सत्पुत्रेण त्वया पुत्र नित्यं काले सुपूजितौ।\n`सुखमेव वसावोऽत्र देवलोकगताविव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2027050, "chapter_id": 1579, "verse_number": "३-२१७-११", "content_sanskrit": "न तेऽन्यद्दैवतं किंचिद्दैवतेष्वपि वर्तते।\nप्रयतसत्वाद्द्विजातीनांदमेनासि समनवितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2027051, "chapter_id": 1579, "verse_number": "३-२१७-१२", "content_sanskrit": "पितुः पितामहा ये च तथैव प्रपितामहाः।\nप्रीतास्ते सततं पुत्र दमेनावां च पूजया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2027052, "chapter_id": 1579, "verse_number": "३-२१७-१३", "content_sanskrit": "मनसा कर्मणा वाचा शुश्रूषा नैव हीयते।\nन चान्या हि तथा बुद्धिर्दृश्यते सांप्रतं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2027053, "chapter_id": 1579, "verse_number": "३-२१७-१४", "content_sanskrit": "जामदग्न्येन रामेण यथा वृद्धौ सुपूजितौ।\nतथा त्वया कृतंसर्वंतद्विशिष्टं च पुत्रक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2027054, "chapter_id": 1579, "verse_number": "३-२१७-१५x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2027055, "chapter_id": 1579, "verse_number": "३-२१७-१५", "content_sanskrit": "ततस्तं ब्राह्मणं ताभ्यां धर्मव्याधो न्यवेदयत्।\nतौ स्वागतेन तं विप्रमर्चयामासतुस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2027056, "chapter_id": 1579, "verse_number": "३-२१७-१६", "content_sanskrit": "प्रतिगृह्यच तां पूजां द्विजः पप्रच्छ तावुभौ।\nसपुत्राभ्यां सभृत्याभ्यां कच्चिद्वां कुशलं गृहे।\nअनामय च वां कच्चित्सुखं वेह शरीरयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2027057, "chapter_id": 1579, "verse_number": "३-२१७-१७x", "content_sanskrit": "वृद्धावूचतुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2027058, "chapter_id": 1579, "verse_number": "३-२१७-१७", "content_sanskrit": "कुशलं नौ गृहे विप्र भृत्यवर्गे च सर्वशः।\nकच्चित्त्वमप्यविघ्नेन संप्राप्तो भगवन्निति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2027059, "chapter_id": 1579, "verse_number": "३-२१७-१८x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2027060, "chapter_id": 1579, "verse_number": "३-२१७-१८", "content_sanskrit": "हाढमित्येव तौ विप्रः प्रत्युवाच मुदान्वितः।\nधर्मव्याधस्तु तं विप्रमर्थवद्वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2027061, "chapter_id": 1579, "verse_number": "३-२१७-१९", "content_sanskrit": "पिता माता च भगवन्नेतौ मे दैवतं परम्।\nयद्दैवतेभ्यः कर्तव्यं तदेताभ्यां करोम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2027062, "chapter_id": 1579, "verse_number": "३-२१७-२०", "content_sanskrit": "त्रयस्त्रिंशद्यथा देवाः सर्वे शक्रपुरोगमाः।\nसंपूज्याः सर्वलोकस्य तथा वृद्धाविमौ मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2027063, "chapter_id": 1579, "verse_number": "३-२१७-२१", "content_sanskrit": "उपाहारानाहरन्तो देवतानां यथा द्विजः।\nकुर्वन्ति तद्वदेताभ्यां करोम्यहमतन्द्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2027064, "chapter_id": 1579, "verse_number": "३-२१७-२२", "content_sanskrit": "एतौ मे परमं ब्रह्मन्पिता माता च दैवतम्।\nएतौ पुष्पैः फलैरन्नैस्तोषयामि सदा द्विज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2027065, "chapter_id": 1579, "verse_number": "३-२१७-२३", "content_sanskrit": "एतावेवाग्नयो मह्यं यान्वदन्ति मनीषिणः।\nयज्ञा वेदाश्च चत्वारः सर्वमेतौ मम द्विज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2027066, "chapter_id": 1579, "verse_number": "३-२१७-२४", "content_sanskrit": "एतदर्थं मम प्राणा भार्या पुत्रः सुहृज्जनः।\nसपुत्रदारः शुश्रूषां नित्यमेव करोम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2027067, "chapter_id": 1579, "verse_number": "३-२१७-२५", "content_sanskrit": "स्वयं च स्नापयाम्येतौ तथा पादौ प्रधावये।\nआहारं च प्रयच्छामि स्वयंच द्विजसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2027068, "chapter_id": 1579, "verse_number": "३-२१७-२६", "content_sanskrit": "अनुकूलाः कथा वच्मि विप्रियं परिवर्जये।\nअधर्मेणापि संयुक्तं प्रियमाभ्यां करोम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2027069, "chapter_id": 1579, "verse_number": "३-२१७-२७", "content_sanskrit": "धर्ममेव गुरुं मत्वा साक्षादेतौ द्विजोत्तम।\nअतन्द्रितः सदा विप्र शुश्रूषां वै करोम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2027070, "chapter_id": 1579, "verse_number": "३-२१७-२८", "content_sanskrit": "पञ्चैव गुरवो ब्रह्मनपुरुषस्य बुभूषतः।\nपिता माताऽग्निरात्मा च गुरुश्च द्विजसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2027071, "chapter_id": 1579, "verse_number": "३-२१७-२९", "content_sanskrit": "एतेषु यस्तु वर्तेत सम्यगेव द्विजोत्तम।\nभवेयुरप्रयस्तेन परिचीर्णास्तु नित्यशः।\nगार्हस्थ्ये वर्तमानस्य एष धर्मः सनातनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2027072, "chapter_id": 1579, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि मार्कण्डेयसमास्यापर्वणि सप्तदशाधिकद्विशततमोऽध्यायः ॥ २१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]