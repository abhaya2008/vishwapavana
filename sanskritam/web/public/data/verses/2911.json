[{"id": 2089334, "chapter_id": 2911, "verse_number": "१३-४१-१", "content_sanskrit": "`सुपर्ण उवाच।\nसोऽहमामन्त्र्य पितरं तद्भावगतमानसः।\nस्वमेवालयमासाद्य तमेवार्थमचिन्तयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2089335, "chapter_id": 2911, "verse_number": "१३-४१-२", "content_sanskrit": "तद्भावगतभावात्मा तद्भूतगतमानसः।\nगोविन्दं चिन्तयन्नासे शाश्वतं परमव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2089336, "chapter_id": 2911, "verse_number": "१३-४१-३", "content_sanskrit": "धृतं बभूव हृदयं नारायणदिदृक्षया।\nसोहं वेगं समास्थाय मनोमारुतवेगवान्।\nरम्यां विशालां बदरीं गतो नारायणाश्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2089337, "chapter_id": 2911, "verse_number": "१३-४१-४", "content_sanskrit": "ततस्तत्र हरिं जगतः प्रभवं विभुम्।\nगोविन्दं पुण्डरीकाक्षं प्रणतः शिरसा हरिम्।\nऋग्यजुस्सामभिश्चैनं तुष्टाव परया मुदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2089338, "chapter_id": 2911, "verse_number": "१३-४१-५", "content_sanskrit": "अथापश्यं सुविपुलमश्वत्थं देवसंश्रयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2089339, "chapter_id": 2911, "verse_number": "१३-४१-६", "content_sanskrit": "चतुर्द्विगुणपीनांसः शङ्कचक्रगदाधरः।\nप्रादुर्बभूव पुरुषः पीतवासाः सनातनः।\nमध्याह्नार्कप्रतीकाशस्तेजसा भासयन्दिशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2089340, "chapter_id": 2911, "verse_number": "१३-४१-७", "content_sanskrit": "संस्तुतः संविदं कृत्वा व्रजेति श्रेयसे रतः।\nप्रागुदीचीं दिशं देवः प्रतस्थे पुरुषोत्तमः।\nदिशश्च विदिशश्चैव भासयन्स्वेन तेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2089341, "chapter_id": 2911, "verse_number": "१३-४१-८", "content_sanskrit": "तमहं पुरुषं दिव्यं व्रजन्तममितौजसम्।\nअनुवव्राज वेगेन शनैर्गच्छन्तमव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2089342, "chapter_id": 2911, "verse_number": "१३-४१-९", "content_sanskrit": "योजनानां सहस्राणि षष्टिमष्टौ तथा शतम्।\nतथा शतसहस्रं च शतं द्विगुणमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2089343, "chapter_id": 2911, "verse_number": "१३-४१-१०", "content_sanskrit": "स गत्वा दीर्गमध्वानमपश्यमहमद्भुतम्।\nमहान्तं पावकं दीप्तमर्चिष्मन्तमनिन्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2089344, "chapter_id": 2911, "verse_number": "१३-४१-११", "content_sanskrit": "शतयोजनविस्तीर्णं तस्माद्द्विगुणमायतम्।\nविवेश स महायोगी पावकं पावकद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2089345, "chapter_id": 2911, "verse_number": "१३-४१-१२", "content_sanskrit": "तत्र शंभुस्तपस्तेपे महादेवः सहोमया।\nस तेन संविदं कृत्वा पावकं समतिक्रमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2089346, "chapter_id": 2911, "verse_number": "१३-४१-१३", "content_sanskrit": "श्रमाभिभूतेन मया कथञ्चिदनुगम्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2089347, "chapter_id": 2911, "verse_number": "१३-४१-१४", "content_sanskrit": "गत्वा स दीर्घमध्वानं भास्करेणावभासितम्।\nअभास्करममर्यादं विवेश सुमहत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2089348, "chapter_id": 2911, "verse_number": "१३-४१-१५", "content_sanskrit": "अथ दृष्टिः प्रतिहता मम तत्र बभूव ह।\nयथास्वभावं भूतात्मा विवेश स महाद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2089349, "chapter_id": 2911, "verse_number": "१३-४१-१६", "content_sanskrit": "ततोऽहमभवं मूढो जडान्धबधिरोपमः।\nदिशश्च विदिशश्चैव न विजज्ञे तमोवृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2089350, "chapter_id": 2911, "verse_number": "१३-४१-१७", "content_sanskrit": "अविजानन्नहं किञ्चित्तस्मिंस्तमसि संवृते।\nससंभ्रान्तेन मनसा व्यथां परमिकां गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2089351, "chapter_id": 2911, "verse_number": "१३-४१-१८", "content_sanskrit": "सोऽहं प्रपन्नः शरणं देवदेवं सनातनम्।\nप्राञ्चलिर्मनसा भूत्वा वाक्यमेतत्तदोक्तवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2089352, "chapter_id": 2911, "verse_number": "१३-४१-१९", "content_sanskrit": "भगवन्भूतभव्येश भवद्भूतकृदव्यय।\nशरणं सम्प्रपन्नं मां त्रातुमर्हस्यरिंदम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2089353, "chapter_id": 2911, "verse_number": "१३-४१-२०", "content_sanskrit": "अहं तु तत्त्वजिज्ञासुः कोसि कस्यासि कुत्र वा।\nसम्प्राप्तः पदवीं देव स मां संत्रातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2089354, "chapter_id": 2911, "verse_number": "१३-४१-२१", "content_sanskrit": "आविर्भूतः पुराणात्मा मामेहीति सनातनः।\nततोपरान्ततो देवो विश्वस्य गतिरात्मवान्।\nमोहयामास मां तत्र दुर्विभाव्यवपुर्विभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2089355, "chapter_id": 2911, "verse_number": "१३-४१-२२", "content_sanskrit": "स्वभावमात्मनस्तत्र दर्शयन्स्वयमात्मना।\nश्रमं मे जनयामास भयं चाभयदः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2089356, "chapter_id": 2911, "verse_number": "१३-४१-२३", "content_sanskrit": "खिन्न इत्येव मां मत्वा भगवानव्ययोऽच्युतः।\nशब्देनाश्वासयामास जगाहे च तमो महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2089357, "chapter_id": 2911, "verse_number": "१३-४१-२४", "content_sanskrit": "अहं तमेवानुगतः श्रमालसपदश्चरन्।\nमनसा देवदेवेशं ध्यातुं समुपचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2089358, "chapter_id": 2911, "verse_number": "१३-४१-२५", "content_sanskrit": "तथागतं तु मां ज्ञात्वा भगवानमितद्युतिः।\nतमः प्रणाशयामास ममानुग्रहकाङ्क्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2089359, "chapter_id": 2911, "verse_number": "१३-४१-२६", "content_sanskrit": "ततः प्रनष्टे तमसि तमहं दीप्ततेजसम्।\nअपश्यं तेजसा व्याप्तं मध्याह्न इव भास्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2089360, "chapter_id": 2911, "verse_number": "१३-४१-२७", "content_sanskrit": "स्वयंप्रभांश्च पुरुषान्स्त्रियश्च परमाद्भुताः।\nअपश्यमहमव्यग्रस्तस्मिन्देशे सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2089361, "chapter_id": 2911, "verse_number": "१३-४१-२८", "content_sanskrit": "न तत्र द्योतते सूर्यो नक्षत्राणि तथैव च।\nन तत्र चन्द्रमा भाति न वायुर्वाति पांसुलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2089362, "chapter_id": 2911, "verse_number": "१३-४१-२९", "content_sanskrit": "तत्र तूर्याण्यनेकानि गीतानि मधुराणि च।\nअदृश्यानि मनोज्ञानि श्रूयन्ते सर्वतोदिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2089363, "chapter_id": 2911, "verse_number": "१३-४१-३०", "content_sanskrit": "स्रवन्ति वैडूर्यलताः पद्मोत्पलझषाकुलाः।\nमुक्तासिकतवप्राश्च सरितो निर्मलोदकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2089364, "chapter_id": 2911, "verse_number": "१३-४१-३१", "content_sanskrit": "अगतिस्तत्र देवानामसुराणां तथैव च।\nगन्धर्वनागयक्षाणां राक्षसानां तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2089365, "chapter_id": 2911, "verse_number": "१३-४१-३२", "content_sanskrit": "स्वयंप्रभास्तत्र नरा दृश्यन्तेऽद्भुतदर्शनाः।\nयेषां न देवतास्तुल्याः प्रभाभिर्भावितात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2089366, "chapter_id": 2911, "verse_number": "१३-४१-३३", "content_sanskrit": "स च तानप्यतिक्रम्य दैवतैरपि पूजितः।\nविवेश ज्वलनं दीप्तमनिन्धनमनौपमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2089367, "chapter_id": 2911, "verse_number": "१३-४१-३४", "content_sanskrit": "ज्वालाभिर्मां प्रविष्टं च ज्वलन्तं सर्वतोदिशम्।\nदैत्यदानवरक्षोभिर्दैवतैश्चापि दुस्सहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2089368, "chapter_id": 2911, "verse_number": "१३-४१-३५", "content_sanskrit": "ज्वालामालिनमासाद्य तमग्निमहमव्ययम्।\nअविषह्यतमं मत्वा मनसेदमचिन्तयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2089369, "chapter_id": 2911, "verse_number": "१३-४१-३६", "content_sanskrit": "मया हि समरेष्वग्निरनेकेषु महाद्युतिः।\nप्रविष्टश्चापविद्धश्च न च मां दग्धवान्क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2089370, "chapter_id": 2911, "verse_number": "१३-४१-३७", "content_sanskrit": "अयं च दुस्सहः शश्वत्तेजसाऽतिहुताशनः।\nअत्यादित्यप्रकाशार्चिरनलो दीप्यते महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2089371, "chapter_id": 2911, "verse_number": "१३-४१-३८", "content_sanskrit": "स तथा दह्यमानोपि तेजसा दीप्तवर्चसा।\nप्रपन्नः शरणं देवं शङ्कचक्रगदाधरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2089372, "chapter_id": 2911, "verse_number": "१३-४१-३९", "content_sanskrit": "भक्तश्चानुगतश्चेति त्रातुमर्हसि मां विभो।\nयथा मां न दहेदग्निः सद्यो देव तथा कुरु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2089373, "chapter_id": 2911, "verse_number": "१३-४१-४०", "content_sanskrit": "एवं विलपमानस्य ज्ञात्वा मे वचनं प्रभुः।\nमा भैरिति वचः प्राह मेघगम्बीरनिस्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2089374, "chapter_id": 2911, "verse_number": "१३-४१-४१", "content_sanskrit": "स मामाश्वास्य वचनं प्राहेदं भगवान्विभुः।\nमम त्वं विदितः सौम्य यथावत्तत्वदर्शने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2089375, "chapter_id": 2911, "verse_number": "१३-४१-४२", "content_sanskrit": "ज्ञापितश्चापि यत्पित्रा तच्चापि विदितं महत्।\nवैनतेय ममाप्येवमहं वेद्यः कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2089376, "chapter_id": 2911, "verse_number": "१३-४१-४३", "content_sanskrit": "महदेतत्स्वरूपं मे न ते वेद्यं कथञ्चन।\nमां हि विन्दन्ति विद्वांसो ये ज्ञाने परिनिष्ठिताः॥\nनिर्ममा निरहङ्कारा निराशीर्बन्धनायुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2089377, "chapter_id": 2911, "verse_number": "१३-४१-४४", "content_sanskrit": "भवांस्तु सततं भक्तो मन्मनाः पक्षिसत्तम।\nस्थूलंमां वेत्स्यसे तस्माज्जगतः कारणेस्थितम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2089378, "chapter_id": 2911, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकचत्वारिंशोऽध्यायः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]