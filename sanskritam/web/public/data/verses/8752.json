[{"id": 900009626, "chapter_id": 8752, "verse_number": "4.1", "content_sanskrit": "प्रपञ्चो यदि विद्येत निवर्तेत न संशयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900009627, "chapter_id": 8752, "verse_number": "4.2", "content_sanskrit": "असत्यमप्रतिष्ठं ते जगदाहुरनीश्वरम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900009628, "chapter_id": 8752, "verse_number": "4.3", "content_sanskrit": "अतोऽवसानं तन्नित्ये न ब्रह्मणि जगत्यपि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900009629, "chapter_id": 8752, "verse_number": "4.4", "content_sanskrit": "विश्वं सत्यमिति श्रुत्या सत्यत्वं स्पष्टमुच्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900009630, "chapter_id": 8752, "verse_number": "4.5", "content_sanskrit": "आदिसृष्टौ ततः कुर्यात्कल्पे कल्पे महाप्रभुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900009631, "chapter_id": 8752, "verse_number": "4.6", "content_sanskrit": "आवृतेऽर्थे कथं साक्षात्काररूपा प्रमा वद", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900009632, "chapter_id": 8752, "verse_number": "4.7", "content_sanskrit": "ब्रह्मचिन्न घटारोपो यदज्ञाननिवर्तनम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900009633, "chapter_id": 8752, "verse_number": "4.8", "content_sanskrit": "मायाविनो न चेद्भ्रान्तिर्विश्वमासीदनाकुलम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900009634, "chapter_id": 8752, "verse_number": "4.9", "content_sanskrit": "एकस्य भ्रमनाशस्स्यादेकाज्ञानविनाशने", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900009635, "chapter_id": 8752, "verse_number": "4.10", "content_sanskrit": "प्रधानसदृशाकारवर्णाधिष्ठानदर्शने", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900009636, "chapter_id": 8752, "verse_number": "4.11", "content_sanskrit": "अथ दृग्दृश्यसम्बन्धायोगात्केवलमीदृशी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900009637, "chapter_id": 8752, "verse_number": "4.12", "content_sanskrit": "यद्यन्ते निष्प्रकारा धीर्ब्रह्माऽन्यस्य न बाधनम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900009638, "chapter_id": 8752, "verse_number": "4.13", "content_sanskrit": "नेह नानेति वाक्यं च नानात्वं ब्रह्मणि क्षिपेत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900009639, "chapter_id": 8752, "verse_number": "4.14", "content_sanskrit": "अनादितोऽनुवृत्तेन सत्त्वेन सहितं जगत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900009640, "chapter_id": 8752, "verse_number": "4.15", "content_sanskrit": "क्षीरं पिबसि तृप्तस्य सुखं साक्षी प्रपश्यति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900009641, "chapter_id": 8752, "verse_number": "4.16", "content_sanskrit": "जडे नाज्ञानदोषोऽस्ति न च काचादि दृश्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900009642, "chapter_id": 8752, "verse_number": "4.17", "content_sanskrit": "सदा सर्वत्र सद्ब्रह्म सदा सर्वत्र चार्थकृत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900009643, "chapter_id": 8752, "verse_number": "4.18", "content_sanskrit": "तथाऽक्षादिप्रमाणानां जडानां हीनताऽपि न", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900009644, "chapter_id": 8752, "verse_number": "4.19", "content_sanskrit": "निरधिष्ठानधीत्वं च परोक्षप्रमयोपमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900009645, "chapter_id": 8752, "verse_number": "4.20", "content_sanskrit": "स्वपृष्ठचालने पक्षी त्रिलोकीं मनुते चलाम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900009646, "chapter_id": 8752, "verse_number": "4.21", "content_sanskrit": "वादिराजाख्ययतिना साधिता युक्तिमल्लिका", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]