[{"id": 6000226000, "chapter_id": 10226, "verse_number": null, "content_sanskrit": "अथ त्रिंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000226001, "chapter_id": 10226, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_030/BhP_10.030.001.m4a", "display_order": 2}, {"id": 6000226002, "chapter_id": 10226, "verse_number": "१०-३०-१", "content_sanskrit": "इति गोप्यः प्रगायन्त्यः प्रलपन्त्यश्च चित्रधा।\nरुरुदुः सुस्वरं राजन् कृष्णदर्शनलालसाः॥ १०/३०/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_030/BhP_10.030.002.m4a", "display_order": 3, "topics": [{"text": "शोचन्तीनां गोपीनां मध्ये श्रीकृष्णस्य प्रादुर्भावः", "range": "१–१५"}]}, {"id": 6000226003, "chapter_id": 10226, "verse_number": "१०-३०-२", "content_sanskrit": "तासामाविरभूच्छौरिः स्मयमानमुखाम्बुजः।\nपीताम्बरधरः स्‍त्रग्वी साक्षान्मन्मथमन्मथः॥ १०/३०/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_030/BhP_10.030.003.m4a", "display_order": 4}, {"id": 6000226004, "chapter_id": 10226, "verse_number": "१०-३०-३", "content_sanskrit": "तं विलोक्यागतं प्रेष्ठं प्रीत्युत्फुल्लदृशोऽबलाः।\nउत्तस्थुर्युगपत् सर्वास्तन्वः प्राणमिवागतम्॥ १०/३०/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_030/BhP_10.030.004.m4a", "display_order": 5}, {"id": 6000226005, "chapter_id": 10226, "verse_number": "१०-३०-४", "content_sanskrit": "काचित् कराम्बुजं शौरेर्जगृहेऽञ्जलिना मुदा।\nकाचिद् दधार तद्बाहुमंसे चन्दनरूषितम्॥ १०/३०/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_030/BhP_10.030.005.m4a", "display_order": 6}, {"id": 6000226006, "chapter_id": 10226, "verse_number": "१०-३०-५", "content_sanskrit": "काचिदञ्जलिनाऽगृह्णात् तन्वी ताम्बूलचर्वितम्।\nएका तदङ्घ्रियुगलं सन्तप्तस्तनयोरधात्॥ १०/३०/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_030/BhP_10.030.006.m4a", "display_order": 7}, {"id": 6000226007, "chapter_id": 10226, "verse_number": "१०-३०-६", "content_sanskrit": "एका भ्रुकुटिमाबध्य प्रेमसंरम्भविह्वला।\nप्रत्यवैक्षत् कटाक्षेण निर्दष्टदशनच्छदा॥ १०/३०/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_030/BhP_10.030.007.m4a", "display_order": 8}, {"id": 6000226008, "chapter_id": 10226, "verse_number": "१०-३०-७", "content_sanskrit": "अपराऽनिमिषं दृग्भ्यां जुषाणा तन्मुखाम्बुजम्।\nआपीतमपि नातृप्यत् सन्तस्तच्चरणं यथा॥ १०/३०/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_030/BhP_10.030.008.m4a", "display_order": 9}, {"id": 6000226009, "chapter_id": 10226, "verse_number": "१०-३०-८", "content_sanskrit": "तं काचिन्नेत्ररन्ध्रेण हृदिकृत्य निमील्य च।\nपुलकाङ्ग्युपगुह्यास्ते योगीवानन्दनिर्भरा॥ १०/३०/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_030/BhP_10.030.009.m4a", "display_order": 10}, {"id": 6000226010, "chapter_id": 10226, "verse_number": "१०-३०-९", "content_sanskrit": "सर्वास्ताः केशवालोकपरमोत्सवनिर्वृताः।\nजहुर्विरहजं तापं प्राज्ञं प्राप्य यथा जनः॥ १०/३०/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_030/BhP_10.030.010.m4a", "display_order": 11}, {"id": 6000226011, "chapter_id": 10226, "verse_number": "१०-३०-१०", "content_sanskrit": "ताभिर्विधूतशोकाभिर्भगवानच्युतो नृप।\nव्यरोचताधिकं तात पुरुषः शक्तिभिर्यथा॥ १०/३०/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_030/BhP_10.030.011.m4a", "display_order": 12}, {"id": 6000226012, "chapter_id": 10226, "verse_number": "१०-३०-११", "content_sanskrit": "ताः समादाय कालिन्द्या निर्विश्य पुलिनं विभुः।\nविकसत्कुन्दमन्दारसुरभ्यनिलषट्पदम्॥ १०/३०/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_030/BhP_10.030.012.m4a", "display_order": 13}, {"id": 6000226013, "chapter_id": 10226, "verse_number": "१०-३०-१२", "content_sanskrit": "शरच्चन्द्रांशुसन्दोहध्वस्तदोषातमः शिवम्।\nकृष्णेहायास्ततरलाचितकोमलवालुकम्॥ १०/३०/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_030/BhP_10.030.013.m4a", "display_order": 14}, {"id": 6000226014, "chapter_id": 10226, "verse_number": "१०-३०-१३", "content_sanskrit": "तद्दर्शनाह्लादविधूतहृद्रुजो मनोरथान्तं श्रुतयो यथा ययुः।\nस्वैरुत्तरीयैः कुचकुङ्कुमाङ्कितैरचीक्लृपन्नासनमात्मबन्धवे॥ १०/३०/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_030/BhP_10.030.014.m4a", "display_order": 15}, {"id": 6000226015, "chapter_id": 10226, "verse_number": "१०-३०-१४", "content_sanskrit": "तत्रोपविष्टो भगवान् स ईश्वरो योगेश्वरान्तर्हृदि कल्पितासनः।\nचकास गोपीपरिषद्गतोऽर्चितस्‍त्रैलोक्यलक्ष्म्यैकपदं वपुर्दधत्॥ १०/३०/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_030/BhP_10.030.015.m4a", "display_order": 16}, {"id": 6000226016, "chapter_id": 10226, "verse_number": "१०-३०-१५", "content_sanskrit": "सभाजयित्वा तमनङ्गदीपनं सहासलीलेक्षणविभ्रमद्भ्रुवः।\nसंस्पर्शनोत्काङ्ककृताङ्गहृच्छयं संस्तभ्य ईषत्कुपिता बभाषिरे॥ १०/३०/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_030/BhP_10.030.016.m4a", "display_order": 17}, {"id": 6000226017, "chapter_id": 10226, "verse_number": null, "content_sanskrit": "गोप्य ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_030/BhP_10.030.017.m4a", "display_order": 18}, {"id": 6000226018, "chapter_id": 10226, "verse_number": "१०-३०-१६", "content_sanskrit": "भजतोऽनु भजन्त्येक एक एतद्विपर्ययम्।\nनोभयांश्च भजन्त्यन्य एतन्नो ब्रूहि साधु भोः॥ १०/३०/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_030/BhP_10.030.018.m4a", "display_order": 19, "topics": [{"text": "श्रीकृष्णगोपीसम्भाषणम्", "range": "१६–२३"}]}, {"id": 6000226019, "chapter_id": 10226, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_030/BhP_10.030.019.m4a", "display_order": 20}, {"id": 6000226020, "chapter_id": 10226, "verse_number": "१०-३०-१७", "content_sanskrit": "मिथो भजन्ति ये सख्यः स्वार्थैकान्तोद्यमा हि ते।\nन तत्र सौहृदं धर्मः स्वार्थं तद् वित्त नान्यथा॥ १०/३०/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_030/BhP_10.030.020.m4a", "display_order": 21}, {"id": 6000226021, "chapter_id": 10226, "verse_number": "१०-३०-१८", "content_sanskrit": "भजन्त्यभजतो ये वै करुणाः पितरो यथा।\nधर्मो निरपवादोऽत्र सौहृदं च सुमध्यमाः॥ १०/३०/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_030/BhP_10.030.021.m4a", "display_order": 22}, {"id": 6000226022, "chapter_id": 10226, "verse_number": "१०-३०-१९", "content_sanskrit": "भजतोऽपि न वै केचिद् भजन्त्यभजतः कुतः।\nआत्मारामा ह्याप्तकामा ह्यकृतज्ञा गुरुद्रुहः॥ १०/३०/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_030/BhP_10.030.022.m4a", "display_order": 23}, {"id": 6000226023, "chapter_id": 10226, "verse_number": "१०-३०-२०", "content_sanskrit": "नाहं तु सख्यो भजतोऽपि जन्तून् भजाम्यमीषामनुवृत्तयो यथा।\nतथैव मत्तः फलसम्पदः स्युरुच्चावचाः कल्पतरोरिवार्थिनाम्॥ १०/३०/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_030/BhP_10.030.023.m4a", "display_order": 24}, {"id": 6000226024, "chapter_id": 10226, "verse_number": "१०-३०-२१", "content_sanskrit": "यथाऽधनो लब्धधने विनष्टे तच्चिन्तयाऽन्यं निभृतं न वेद।\nएवं मदर्थार्पितलोकवेदस्वानां हि वो मय्यनुवृत्तयोऽबलाः॥ १०/३०/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_030/BhP_10.030.024.m4a", "display_order": 25}, {"id": 6000226025, "chapter_id": 10226, "verse_number": "१०-३०-२२", "content_sanskrit": "मया परोक्षं भजता तिरोहितं सासूयितुं नार्हथ मां प्रियं प्रियाः॥ १०/३०/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_030/BhP_10.030.025.m4a", "display_order": 26}, {"id": 6000226026, "chapter_id": 10226, "verse_number": "१०-३०-२३", "content_sanskrit": "न पारयेऽहं निरवद्यसंयुजां सुसाधुकृत्यं विबुधायुषाऽपि वः।\nयो मां भजेद् दुर्जरदेहशृङ्खलाः संवृश्च्य वृद्धिं प्रतियाति सोऽधुना॥ १०/३०/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_030/BhP_10.030.026.m4a", "display_order": 27}, {"id": 6000226027, "chapter_id": 10226, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे त्रिंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]