[{"id": 2041133, "chapter_id": 1914, "verse_number": "५-१५९-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2041134, "chapter_id": 1914, "verse_number": "५-१५९-१", "content_sanskrit": "तथा व्यूढेष्वनीकेषु कुरुक्षेत्रे द्विजर्षभ ।\nकिमर्कुर्वंश्च कुरवः कालेनाभिप्रचोदिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2041135, "chapter_id": 1914, "verse_number": "५-१५९-२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2041136, "chapter_id": 1914, "verse_number": "५-१५९-२", "content_sanskrit": "तथा व्यूढेष्वनीकेषु यत्तेषु भरतर्षभ।\nधृतराष्ट्रो महाराज सञ्जयं वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2041137, "chapter_id": 1914, "verse_number": "५-१५९-३", "content_sanskrit": "एहि सञ्जय सर्व मे आचक्ष्वानवशेषतः ।\nसेनानिवेशे यद्वृत्तं कुरुपाण्डवसेनयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2041138, "chapter_id": 1914, "verse_number": "५-१५९-४", "content_sanskrit": "दिष्टमेव परं मन्ये पौरुषं चाप्यनर्थकम् ।\nयदहं बुद्ध्यमानोऽपि युद्धदोषान्क्षयोदयान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2041139, "chapter_id": 1914, "verse_number": "५-१५९-५", "content_sanskrit": "तथापि निकृतिप्रज्ञं पुत्रं दुर्द्यूतदेविनम् ।\nन शक्नोमि नियन्तुं वा कर्तुं वा हितमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2041140, "chapter_id": 1914, "verse_number": "५-१५९-६", "content_sanskrit": "भवत्येव हि मे सूत बुद्धिर्दोषानुदर्शिनी ।\nदुर्योधनं समासाद्य पुनः सा परिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2041141, "chapter_id": 1914, "verse_number": "५-१५९-७", "content_sanskrit": "एवं गते वै यद्भावि तद्भविष्यति सञ्जय ।\nक्षत्रधर्मः किल रणे तनुत्यागे हि पूजितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2041142, "chapter_id": 1914, "verse_number": "५-१५९-८x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2041143, "chapter_id": 1914, "verse_number": "५-१५९-८", "content_sanskrit": "त्वद्युक्तोऽयमनुप्रश्नो महाराज यथेच्छसि।\nन तु दुर्योधने दोषमिममाधातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2041144, "chapter_id": 1914, "verse_number": "५-१५९-९", "content_sanskrit": "शृणुष्वानवशेषेण वदतो मम पार्थिव ।\nय आत्मनो दुश्चरितादशुभं प्राप्नुयान्नरः ।\nन स कालं न वा देवानेनसा गन्तुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2041145, "chapter_id": 1914, "verse_number": "५-१५९-१०", "content_sanskrit": "महाराज मनुष्येषु निन्द्यं यः सर्वमाचरेत्।\nस वध्यः सर्वलोकस्य निन्दितानि समाचरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2041146, "chapter_id": 1914, "verse_number": "५-१५९-११", "content_sanskrit": "निकारा मनुजश्रेष्ठ पाण्डवैस्त्वत्प्रतीक्षया ।\nअनुभूताः सहामात्यैर्निकृतैरधिदेवने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2041147, "chapter_id": 1914, "verse_number": "५-१५९-१२", "content_sanskrit": "हयानां च गजानां च राज्ञां चामिततेजसाम् ।\nवैशसं समरे वृत्तं यत्तन्मे शृणु सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2041148, "chapter_id": 1914, "verse_number": "५-१५९-१३", "content_sanskrit": "स्थिरो भूत्वा महाप्राज्ञ सर्वलोकक्षयोदयम्।\nयथाभूतं महायुद्धे श्रुत्वा मा विमना भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2041149, "chapter_id": 1914, "verse_number": "५-१५९-१४", "content_sanskrit": "न ह्येव कर्ता पुरुषः कर्मणोः शुभपापयोः ।\nअस्वतन्त्रो हि पुरुषः कार्यते दारुयन्त्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2041150, "chapter_id": 1914, "verse_number": "५-१५९-१५", "content_sanskrit": "केचिदीश्वरनिर्दिष्टाः केचिदेव यदृच्छया।\nपूर्वकर्मभिरप्यन्ये त्रैधमेतत्प्रदृश्यते।\nतस्मादनर्थमापन्नः स्थिरो भूत्वा निशामय ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2041151, "chapter_id": 1914, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि सैन्यनिर्याणपर्वणि एकोनषष्ट्यधिकशततमोऽध्यायः ॥ ॥ समाप्तं च सैन्यनिर्याणपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]