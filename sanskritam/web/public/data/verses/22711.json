[{"id": 7002711000, "chapter_id": 22711, "verse_number": "८-२२-१", "content_sanskrit": "सूत उवाच ।\nइति श्रुत्वा बलिर्दैत्यो देवानां विजयं महत् ।\nरोषणं नाम दैत्येन्द्रं समाहूय वचोऽब्रवीत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002711001, "chapter_id": 22711, "verse_number": "८-२२-२", "content_sanskrit": "सुतस्तिमिरलिङ्गस्य सरुषो नाम विश्रुतः ।\nत्वं हि तत्र समागम्य दैत्यकार्यं महत्कुरु ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002711002, "chapter_id": 22711, "verse_number": "८-२२-३", "content_sanskrit": "इति श्रुत्वा स वै दैत्यो हृदि विप्राप्तरोषणः ।\nननाश वेदमार्गस्थान्देहलीदेशमास्थितः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002711003, "chapter_id": 22711, "verse_number": "८-२२-४", "content_sanskrit": "पञ्चवर्षं कृतं राज्यं तत्सुतो बाबरोभवत् ।\nविंशदब्दं कृत राज्यं होमायुस्तत्सुतोऽभवत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002711004, "chapter_id": 22711, "verse_number": "८-२२-५", "content_sanskrit": "होमायुषा मदान्धेन देवताश्च निराकृताः ।\nते सुराः कृष्णचैतन्यं नदीहोपवने स्थितम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002711005, "chapter_id": 22711, "verse_number": "८-२२-६", "content_sanskrit": "तुष्टुवुर्बहुधा तत्र श्रुत्वा क्रुद्धो हरिः स्वयम् ।\nस्वतेजसा च तद्राज्यं विघ्नभूतं चकार ह ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002711006, "chapter_id": 22711, "verse_number": "८-२२-७", "content_sanskrit": "तत्सैन्यजनितैर्लोकैर्होमायुश्च निराकृतः ।\nमहाराष्ट्रैस्तदा तत्र शेषशाकः समास्थितः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002711007, "chapter_id": 22711, "verse_number": "८-२२-८", "content_sanskrit": "देहलीनगरे रम्ये म्लेच्छो राज्यं चकार ह ।\nधर्मकार्यं कृतं तेन तद्राज्यं पञ्चहायनम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002711008, "chapter_id": 22711, "verse_number": "८-२२-९", "content_sanskrit": "ब्रह्मचारी मुकुन्दश्च शङ्कराचार्यगोत्रजः ।\nप्रयागे च तपः कुर्वन्विंशच्छिष्यैर्युतः स्थितः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002711009, "chapter_id": 22711, "verse_number": "८-२२-१०", "content_sanskrit": "बाबरेण च धूर्तेन म्लेच्छराजेन देवताः ।\nभ्रंशिता स तदा ज्ञात्वा वह्नौ देहं जुहाव वै ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002711010, "chapter_id": 22711, "verse_number": "८-२२-११", "content_sanskrit": "तस्य शिष्या गता वह्नौ म्लेच्छनाशनहेतुना ।\nगोदुग्धे च स्थितं रोमं पीत्वा स पयसा मुनिः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002711011, "chapter_id": 22711, "verse_number": "८-२२-१२", "content_sanskrit": "मुकुन्दस्तस्य दोषेण म्लेच्छयोनौ बभूव ह ।\nहोमायुषश्च काश्मीरे संस्थितस्यैव पुत्रकः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002711012, "chapter_id": 22711, "verse_number": "८-२२-१३", "content_sanskrit": "जातमात्रे सुते तस्मिन्वागुवाचा शरीरिणी ।\nअकस्माच्च वरो जातः पुत्रोऽयं सर्वभाग्यवान् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002711013, "chapter_id": 22711, "verse_number": "८-२२-१४", "content_sanskrit": "पैशाचे दारुणे मार्गे न भूतो न भविष्यति ।\nअतः सोऽकबरो नाम होमायुस्तनयस्तव ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002711014, "chapter_id": 22711, "verse_number": "८-२२-१५", "content_sanskrit": "श्रीधरः श्रीपतिः शम्भुर्वरेण्यश्च मधुव्रती ।\nविमलो देववान्सोमो वर्द्धनो वर्तको रुचिः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002711015, "chapter_id": 22711, "verse_number": "८-२२-१६", "content_sanskrit": "मान्धाता मानकारी च केशवो माधवो मधुः ।\nदेवापिः सोमपाः शूरो मदनो यस्य शिष्यकाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002711016, "chapter_id": 22711, "verse_number": "८-२२-१७", "content_sanskrit": "स मुकुन्दो द्विजः श्रीमान्दैवात्त्वद्गेहमागतः ।\nइत्याकाशवचः श्रुत्वा होमायुश्च प्रसन्नधीः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002711017, "chapter_id": 22711, "verse_number": "८-२२-१८", "content_sanskrit": "ददौ दानं क्षुधार्तेभ्यः प्रेम्णा पुत्रमपालयत् ।\nदशाब्दे तनये जाते देहलीदेशमागतः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002711018, "chapter_id": 22711, "verse_number": "८-२२-१९", "content_sanskrit": "शेषशाङ्कं पराजित्य स च राजा बभूव ह ।\nअब्दं तेन कृतं राज्यं तत्पुत्रश्च नृपोऽभवत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002711019, "chapter_id": 22711, "verse_number": "८-२२-२०", "content_sanskrit": "सम्प्राप्तेऽकबरे राज्यं सप्तशिष्याश्च तत्प्रियाः ।\nपूर्वजन्मनि ये मुख्यास्ते प्राप्ता भूपतिं प्रति ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002711020, "chapter_id": 22711, "verse_number": "८-२२-२१", "content_sanskrit": "केशवो गानसेनश्च वैजवाक्स तु माधवः ।\nम्लेच्छास्ते च स्मृतास्तत्र हरिदासो मधुस्तथा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002711021, "chapter_id": 22711, "verse_number": "८-२२-२२", "content_sanskrit": "मध्वाचार्यकुले जातो वैष्णवः सर्वरागवित् ।\nपूर्वजन्मनि देवापिः स च वीरबलोऽभवत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002711022, "chapter_id": 22711, "verse_number": "८-२२-२३", "content_sanskrit": "ब्राह्मणः पाश्चिमात्यो वै वाग्देवीवरदर्पितः ।\nसोमपा मानसिंहश्च गौतमान्वयसम्भवः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002711023, "chapter_id": 22711, "verse_number": "८-२२-२४", "content_sanskrit": "सेनापतिश्च नृपतेरार्यभूपशिरोमणेः ।\nसूरश्चैव द्विजो जातो दक्षिणश्चैव पण्डितः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002711024, "chapter_id": 22711, "verse_number": "८-२२-२५", "content_sanskrit": "बिल्वमङ्गल एवापि नाम्ना तन्नृपतेः सखा ।\nनायिकाभेदनिपुणो वेश्यानां स च पारगः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002711025, "chapter_id": 22711, "verse_number": "८-२२-२६", "content_sanskrit": "मदनो ब्राह्मणो जातः पौर्वात्यः स च नर्तकः ।\nचन्दलो नाम विख्यातो रहः क्रीडाविशारदः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002711026, "chapter_id": 22711, "verse_number": "८-२२-२७", "content_sanskrit": "अन्यदेशे गताः शिष्यास्तेषां पूर्वास्त्रयोदश ।\nअनपस्य सुतो जातः श्रीधरः शत्रुवेदितः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002711027, "chapter_id": 22711, "verse_number": "८-२२-२८", "content_sanskrit": "विख्यातस्तुलसीशर्मा पुराणनिपुणः कविः ।\nनारीशिक्षां समादाय राघवानन्दमागतः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002711028, "chapter_id": 22711, "verse_number": "८-२२-२९", "content_sanskrit": "शिष्यो भूत्वा स्थितः काश्यां रामानन्दमते स्थितः ।\nश्रीपतिः स बभूवान्धो मध्वाचार्यमते स्थितः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002711029, "chapter_id": 22711, "verse_number": "८-२२-३०", "content_sanskrit": "सूरदास इति ज्ञेयः कृष्णलीलाकरः कविः ।\nशम्भुर्वै चन्द्रभट्टस्य कुले जातो हरिप्रियः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002711030, "chapter_id": 22711, "verse_number": "८-२२-३१", "content_sanskrit": "रामानन्दमते संस्थो भक्तकीर्तिपरायणः ।\nवरेण्यः सोग्रभुङ्नामा रामानन्दमते स्थितः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002711031, "chapter_id": 22711, "verse_number": "८-२२-३२", "content_sanskrit": "ज्ञानध्यानपरो नित्यं भाषाछन्दकरः कविः ।\nमधुव्रती स वै जातो कीलको नाम विश्रुतः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002711032, "chapter_id": 22711, "verse_number": "८-२२-३३", "content_sanskrit": "रामलीलाकरो धीमान्रामानन्दमते स्थितः ।\nविमलश्च स वै जातः स नाम्नैव दिवाकरः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002711033, "chapter_id": 22711, "verse_number": "८-२२-३४", "content_sanskrit": "सीतालीलाकरो धीमान्रामानन्दमते स्थितः ।\nदेववान्केशवो जातो विष्णुस्वामिमते स्थितः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002711034, "chapter_id": 22711, "verse_number": "८-२२-३५", "content_sanskrit": "कविप्रियादिरचनां कृत्वा प्रेतत्वमागतः ।\nरामज्योत्स्नामयं ग्रन्थं कृत्वा स्वर्गमुपाययौ ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002711035, "chapter_id": 22711, "verse_number": "८-२२-३६", "content_sanskrit": "सोमो जातः स वै व्यासो निम्बादित्यमते स्थितः ।\nरहः क्रीडामयं ग्रन्थं कृत्वा स्वर्गमुपाययौ ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002711036, "chapter_id": 22711, "verse_number": "८-२२-३७", "content_sanskrit": "वर्द्धनश्च स वै जातो नाम्ना चरणदासकः ।\nज्ञानमालामयं कृत्वा ग्रन्थं रैदासमार्गगः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002711037, "chapter_id": 22711, "verse_number": "८-२२-३८", "content_sanskrit": "वर्तकः स च वै जातो रोपणस्य मते स्थितः ।\nरत्नभानुरिति ज्ञेयो भाषाकर्ता च जैमिनेः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002711038, "chapter_id": 22711, "verse_number": "८-२२-३९", "content_sanskrit": "रुचिश्च रोचनो जातो मध्वाचार्यमते स्थितः ।\nनानागानमयीं लीलां कृत्वा स्वर्गमुपाययौ ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002711039, "chapter_id": 22711, "verse_number": "८-२२-४०", "content_sanskrit": "मान्धाता भूपतिर्नाम कायस्थः स बभूव ह ।\nमध्वाचार्यो भागवतं चक्रे भाषामयं शुभम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002711040, "chapter_id": 22711, "verse_number": "८-२२-४१", "content_sanskrit": "मानकारो नारिभावान्नारीदेहमुपागतः ।\nमीरानामेति विख्याता भूपतेस्तनया शुभा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002711041, "chapter_id": 22711, "verse_number": "८-२२-४२", "content_sanskrit": "मा शोभा च तनौ यस्या गतिर्गजसमा किल ।\nसा मीरा च बुधैः प्रोक्ता मध्वाचार्यमते स्थिता ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002711042, "chapter_id": 22711, "verse_number": "८-२२-४३", "content_sanskrit": "एवं ते कथितं विप्र भाषाग्रन्थप्रकारणम् ।\nप्रबन्धं मङ्गलकरं कलिकाले भयङ्करे ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002711043, "chapter_id": 22711, "verse_number": "८-२२-४४", "content_sanskrit": "स भूपोऽकबरो नाम कृत्वा राज्यमकण्टकम् ।\nशतार्द्धेन च शिष्यैश्च वैकुण्ठभवनं ययौ ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002711044, "chapter_id": 22711, "verse_number": "८-२२-४५", "content_sanskrit": "सलोमा तनयस्तस्य कृतं राज्यं पितुः समम् ।\nखुर्दकस्तनयस्तस्य दशाब्दं च कृतं पदम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002711045, "chapter_id": 22711, "verse_number": "८-२२-४६", "content_sanskrit": "चत्वारस्तनयास्तस्य नवरङ्गो हि मध्यमः ।\nपितरं च तथा भ्रातॄञ्जित्वा राज्यमचीकरत् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002711046, "chapter_id": 22711, "verse_number": "८-२२-४७", "content_sanskrit": "पूर्वजन्मनि दैत्योऽयमन्धको नाम विश्रुतः ।\nकर्मभूम्यां तदंशेन दैत्यराजाज्ञया ययौ ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002711047, "chapter_id": 22711, "verse_number": "८-२२-४८", "content_sanskrit": "तेनैव बहुधा मूर्तीर्भ्रंशिताश्च समन्ततः ।\nदृष्ट्वा देवास्तदागत्य कृष्णचैतन्यमब्रुवन् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002711048, "chapter_id": 22711, "verse_number": "८-२२-४९", "content_sanskrit": "भगवन्दैत्यराजांशः स जातश्च महीपतिः ।\nभ्रंशयित्वा सुरान्वेदान्दैत्यपक्षं विवर्द्धते ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002711049, "chapter_id": 22711, "verse_number": "८-२२-५०", "content_sanskrit": "इति श्रुत्वा स यज्ञांशो नदीहोपवने स्थितः ।\nशशाप तं दुराचारं यथा वंशक्षयो भवेत् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002711050, "chapter_id": 22711, "verse_number": "८-२२-५१", "content_sanskrit": "राज्यमेकोनपञ्चाशत्कृतं तेन दुरात्मना ।\nसेवाजयो नाम नृपो देवपक्षविवर्द्धनः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002711051, "chapter_id": 22711, "verse_number": "८-२२-५२", "content_sanskrit": "महाराष्ट्रद्विजस्तस्य युद्धविद्याविशारदः ।\nहत्वा तं च दुराचारं तत्पुत्राय च तत्पदम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002711052, "chapter_id": 22711, "verse_number": "८-२२-५३", "content_sanskrit": "दत्वा ययौ दाक्षिणात्ये देशे देवविवर्द्धनः ।\nअलोमा नाम तनयः पञ्चाब्दं तत्पदं कृतम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002711053, "chapter_id": 22711, "verse_number": "८-२२-५४", "content_sanskrit": "तत्पश्चान्मरणं प्राप्तो विद्रधेन रुजा मुने ।\nविक्रमस्य गते राज्ये सप्तत्युत्तरकं शतम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002711054, "chapter_id": 22711, "verse_number": "८-२२-५५", "content_sanskrit": "ज्ञेयं सप्त दशं विप्र यदालोमा मृतिं गतः ।\nतालनस्य कुले जातो म्लेच्छः फलरुषो बली ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002711055, "chapter_id": 22711, "verse_number": "८-२२-५६", "content_sanskrit": "मुकुलस्य कुलं हत्वा स्वयं राज्यं चकार ह ।\nदशाब्दं च कृतं राज्यं तेन भूपेन भूतले ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002711056, "chapter_id": 22711, "verse_number": "८-२२-५७", "content_sanskrit": "शत्रुभिर्मरणं प्राप्तो दैत्यलोकमुपागमत् ।\nमहामदस्तत्तनयो विंशत्यब्दं कृतं पदम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002711057, "chapter_id": 22711, "verse_number": "८-२२-५८", "content_sanskrit": "तद्राष्ट्रे नादरो नाम दैत्यो देश उपागमत् ।\nहत्वार्यांश्च सुराञ्जित्वा देशं खुरजमाययौ ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002711058, "chapter_id": 22711, "verse_number": "८-२२-५९", "content_sanskrit": "महामत्स्यो हि मदस्य तनयस्तत्पितुः पदम् ।\nगृहीत्वा पञ्चवर्षान्तं स च राज्यं चकार ह ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002711059, "chapter_id": 22711, "verse_number": "८-२२-६०", "content_sanskrit": "महाराष्ट्रैर्हतो दुष्टस्तालनान्वयसम्भवः ।\nदेहलीनगरे राज्यं दशाब्दं माधवेन वै ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002711060, "chapter_id": 22711, "verse_number": "८-२२-६१", "content_sanskrit": "कृतं तत्र तदा म्लेच्छ आलोमा राज्यमाप्तवान् ।\nतद्राष्ट्रे बहवो जाता राजानो निजदेशजाः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002711061, "chapter_id": 22711, "verse_number": "८-२२-६२", "content_sanskrit": "ग्रामपा बहवो भूपा देशे देशे बभूविरे ।\nमण्डलीकपदं तत्राक्षयं जातं महीतले ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002711062, "chapter_id": 22711, "verse_number": "८-२२-६३", "content_sanskrit": "त्रिंशदब्दमतो जातं ग्रामे ग्रामे नृपे नृपे ।\nतदा तु सकला देवाः कृष्णचैतन्यमाययुः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002711063, "chapter_id": 22711, "verse_number": "८-२२-६४", "content_sanskrit": "यज्ञांशश्च हरिः साक्षाज्ज्ञात्वा दुःखं महीतले ।\nमुहूर्तं ध्यानमागम्य देवान्वचनमब्रवीत् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002711064, "chapter_id": 22711, "verse_number": "८-२२-६५", "content_sanskrit": "पुरा तु राघवो धीमाञ्जित्वा रावणराक्षसम् ।\nकपीनुज्जीवयामास सुधावर्षैस्समन्ततः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002711065, "chapter_id": 22711, "verse_number": "८-२२-६६", "content_sanskrit": "विकटो वृजिलो जालो वरलीनो हि सिंहलः ।\nजवस्सुमात्रश्च तथा नाम्ना ते क्षुद्रवानराः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7002711066, "chapter_id": 22711, "verse_number": "८-२२-६७", "content_sanskrit": "रामचन्द्रं वचः प्राहुर्देहि नो वाच्छितं प्रभो ।\nरामो दाशरथिः श्रीमाञ्ज्ञात्वा तेषां मनोरथम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7002711067, "chapter_id": 22711, "verse_number": "८-२२-६८", "content_sanskrit": "देवाङ्गनोद्भवाः कन्या रावणाल्लोकरावणात् ।\nदत्त्वा तेभ्यो हरिस्साक्षाद्वचनं प्राह हर्षितः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7002711068, "chapter_id": 22711, "verse_number": "८-२२-६९", "content_sanskrit": "भवन्नाम्ना च ये द्वीपा जालन्धरविनिर्मिताः ।\nतेषु राज्ञो भविष्यन्ति भवन्तो हितकारिणः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7002711069, "chapter_id": 22711, "verse_number": "८-२२-७०", "content_sanskrit": "नन्दिन्या गोश्च रुण्डाद्वै जाता म्लेच्छा भयानकाः ।\nगुरुण्डा जातयस्तेषां तास्तु तेषु सदा स्थिताः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7002711070, "chapter_id": 22711, "verse_number": "८-२२-७१", "content_sanskrit": "जित्वा तांश्च गुरुण्डान्वै कुरुध्वं राज्यमुत्तमम् ।\nइति श्रुत्वा हरिं नत्वा द्वीपेषु प्रययुर्मुदा ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7002711071, "chapter_id": 22711, "verse_number": "८-२२-७२", "content_sanskrit": "विकटान्वयसम्भूता गुरुण्डा वानराननाः ।\nवाणिज्यार्थमिहायाता गौरुण्डा बौद्धमार्गिणः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7002711072, "chapter_id": 22711, "verse_number": "८-२२-७३", "content_sanskrit": "ईशपुत्रमते संस्थास्तेषां हृदयमुत्तमम् ।\nसत्यव्रतं कामजितमक्रोधं सूर्यतत्परम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7002711073, "chapter_id": 22711, "verse_number": "८-२२-७४", "content_sanskrit": "यूयं तत्रोष्य कार्यं च नृणां कुरुत मा चिरम् ।\nइति श्रुत्वा तु ते देवाः कुर्युरार्चिकमादरात् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7002711074, "chapter_id": 22711, "verse_number": "८-२२-७५", "content_sanskrit": "नगर्य्या कलिकातायां स्थापयामासुरुद्यताः ।\nविकटे पश्चिमे द्वीपे तत्पत्नी विकटावती ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7002711075, "chapter_id": 22711, "verse_number": "८-२२-७६", "content_sanskrit": "अष्टकौशलमार्गेण राजमन्त्रं चकार ह ।\nतत्पतिस्तु पुलोमार्चिः कलिकातां पुरीं स्थितः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7002711076, "chapter_id": 22711, "verse_number": "८-२२-७७", "content_sanskrit": "विक्रमस्य गते राज्ये शतमष्टादशं कलौ ।\nचत्वारिंशं तथाब्दं च तदा राजा बभूव ह ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7002711077, "chapter_id": 22711, "verse_number": "८-२२-७८", "content_sanskrit": "तदन्वये सप्तनृपा गुरुण्डाश्च बभूविरे ।\nचतुष्षष्टिमितं वर्षं राज्यं कृत्वा लयं गताः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7002711078, "chapter_id": 22711, "verse_number": "८-२२-७९", "content_sanskrit": "गुरुण्डे चाष्टमे भूपे प्राप्ते न्यायेन शासति ।\nकलिपक्षो बलिर्दैत्यो मुरं नाम महासुरम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7002711079, "chapter_id": 22711, "verse_number": "८-२२-८०", "content_sanskrit": "आरुह्य प्रेषयामास देवदेशे महोत्तमे ।\nस मुरो वार्डिलं भूपं वशीकृत्य हृदि स्थितः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7002711080, "chapter_id": 22711, "verse_number": "८-२२-८१", "content_sanskrit": "आर्यधर्मविनाशाय तस्य बुद्धिं चकार ह ।\nमूर्तिसंस्थास्तदा देवा गत्वा यज्ञांशयोगिनम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7002711081, "chapter_id": 22711, "verse_number": "८-२२-८२", "content_sanskrit": "नमस्कृत्याब्रुवन्सर्वे यथा प्राप्तो मुरोऽसुरः ।\nज्ञात्वा शशाप कृष्णांशो गुरुण्डान्बौद्धमार्गिणः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7002711082, "chapter_id": 22711, "verse_number": "८-२२-८३", "content_sanskrit": "क्षयं यास्यन्ति ते सर्वे ये मुरस्य वशं गताः ।\nइत्युक्ते वचने तस्मिन्गुरुण्डा कालनोदिताः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7002711083, "chapter_id": 22711, "verse_number": "८-२२-८४", "content_sanskrit": "स्वसैन्यैश्च क्षयं जग्मुर्वर्षमात्रान्तरे खलाः ।\nसर्वे त्रिंशत्सहस्राश्च प्रययुर्यममन्दिरे ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7002711084, "chapter_id": 22711, "verse_number": "८-२२-८५", "content_sanskrit": "वाग्दण्डैस्स च भूपालो वार्डिलो नाशमाप्तवान् ।\nगुरुण्डो नवमः प्राप्तो भेकलो नाम वीर्यवान् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7002711085, "chapter_id": 22711, "verse_number": "८-२२-८६", "content_sanskrit": "न्यायेन कृतवान्राज्य द्वादशाब्दं प्रयत्नतः ।\nआर्यदेशे च तद्राज्यं बभूव न्यायशासति ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7002711086, "chapter_id": 22711, "verse_number": "८-२२-८७", "content_sanskrit": "लडिलो नाम विख्यातो गुरुण्डो दशमोहितः ।\nद्वात्रिंशाब्दं च तद्राज्यं कृतं तेनैव धर्मिणा ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7002711087, "chapter_id": 22711, "verse_number": "८-२२-८८", "content_sanskrit": "लडिले स्वर्गते प्राप्ते मकरन्दकुलोद्भवाः ।\nआर्याः प्राप्तास्तदा मौना हिमतुङ्गनिवासिनः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7002711088, "chapter_id": 22711, "verse_number": "८-२२-८९", "content_sanskrit": "बभ्रुवर्णाः सूक्ष्मनसो वर्तुला दीर्घमस्तकाः ।\nएवं लक्षाश्च सम्प्राप्ता देहल्यां बौद्धमागिणः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7002711089, "chapter_id": 22711, "verse_number": "८-२२-९०", "content_sanskrit": "आर्जिको नाम वै राजा तेषां तत्र बभूव ह ।\nतस्य पुत्रो देवकणो गङ्गोत्रगिरिमूर्द्धनि ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7002711090, "chapter_id": 22711, "verse_number": "८-२२-९१", "content_sanskrit": "द्वादशाब्दं तपो घोरं तेपे राज्यविवृद्धये ।\nतदा भगवती गङ्गा तपसा तस्य धीमतः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7002711091, "chapter_id": 22711, "verse_number": "८-२२-९२", "content_sanskrit": "स्वरूपं स्वेच्छया प्राप्य ब्रह्मलोकं जगाम ह ।\nकुबेरश्च तदागत्य दत्त्वा तस्मै महत्पदम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7002711092, "chapter_id": 22711, "verse_number": "८-२२-९३", "content_sanskrit": "आर्याणां मण्डलीकं च तत्रैवान्तरधीयत ।\nमण्डलीको देवकर्णो बभूव जनपालकः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7002711093, "chapter_id": 22711, "verse_number": "८-२२-९४", "content_sanskrit": "षष्ट्यब्दं च कृतं राज्यं तेन राज्ञा महीतले ।\nतदन्वयेऽष्टभूपाश्च बभूवुर्देवपूजकाः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7002711094, "chapter_id": 22711, "verse_number": "८-२२-९५", "content_sanskrit": "द्विशताब्दं पदं कृत्वा स्वर्गलोकमुपाययुः ।\nएकादशश्च यो मौनः पन्नगारिरिति श्रुतः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7002711095, "chapter_id": 22711, "verse_number": "८-२२-९६", "content_sanskrit": "चत्वारिंशच्च वर्षाणि राज्यं कृत्वा प्रयत्नतः ।\nस्वर्गलोकं गतो राजा पन्नगैर्मरणं गतः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7002711096, "chapter_id": 22711, "verse_number": "८-२२-९७", "content_sanskrit": "एवं च मौर्यजातीयैः कृतं राज्यं महीतले ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}]