[{"id": 2080376, "chapter_id": 2708, "verse_number": "१२-२१३-०x", "content_sanskrit": "गुरुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2080377, "chapter_id": 2708, "verse_number": "१२-२१३-१", "content_sanskrit": "चतुर्विधानि भूतानि स्थावराणि चराणि च।\nअव्यक्तप्रभवान्याहुरव्यक्तनिधनानि च।\nअव्यक्तलक्षणं विद्यादव्यक्तात्मात्मकं मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2080378, "chapter_id": 2708, "verse_number": "१२-२१३-२", "content_sanskrit": "यथाऽश्वत्थकणीकायामन्तर्भूतो महाद्रुमः।\nनिष्पन्नो दृश्यते व्यक्तमव्यक्तात्संभवस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2080379, "chapter_id": 2708, "verse_number": "१२-२१३-३", "content_sanskrit": "`आत्मानमनुसंयाति बुद्धिरव्यक्तजा तथा।\nतामन्वेति मनो यद्वल्लोहवर्मणि सन्निधौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2080380, "chapter_id": 2708, "verse_number": "१२-२१३-४", "content_sanskrit": "अभिद्रवत्ययस्कान्तमयोनिश्चेतनं यथा।\nस्वभावहेतुजा भावा यद्वदन्यदपीदृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2080381, "chapter_id": 2708, "verse_number": "१२-२१३-५", "content_sanskrit": "तद्वदव्यक्तजा भावाः कर्तुः कारणलक्षणाः।\nअचेतनाश्चेतयितुः कारणादभिसंगताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2080382, "chapter_id": 2708, "verse_number": "१२-२१३-६", "content_sanskrit": "न भूर्न खं द्यौर्भूतानि नर्षयो न सुरासुराः।\nनान्यदासीदृते जीवमासेदुर्न तु संहतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2080383, "chapter_id": 2708, "verse_number": "१२-२१३-७", "content_sanskrit": "सर्वं नित्यं सर्वगतं मनोहेतुत्वलक्षणम्।\nअज्ञानकर्म निर्दिष्टमेतत्कारणलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2080384, "chapter_id": 2708, "verse_number": "१२-२१३-८", "content_sanskrit": "तत्कारणेन संयुक्तं कार्यसंग्रहकारकम्।\nयेनैतद्वर्तते चक्रमनादिनिधनं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2080385, "chapter_id": 2708, "verse_number": "१२-२१३-९", "content_sanskrit": "`येन स्वभावसद्भावं हेतुभूता सकारणा।\nएवं प्राकृतविस्तारो ह्याश्रित्य पुरुषं परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2080386, "chapter_id": 2708, "verse_number": "१२-२१३-१०", "content_sanskrit": "अव्यक्तनाभं व्यक्तारं विकारपरिमण्डलम्।\nक्षेत्रज्ञाधिष्ठितं चक्रं स्निग्धाक्षं वर्तते ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2080387, "chapter_id": 2708, "verse_number": "१२-२१३-११", "content_sanskrit": "स्निग्धत्वात्तिलवत्सर्वं चक्रेऽस्मिन्पीड्यते जगत्।\nतिलपीडैरिवाक्रम्य भोगैरज्ञानसंभवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2080388, "chapter_id": 2708, "verse_number": "१२-२१३-१२", "content_sanskrit": "`प्राणेनायं हि शान्ते तु विरोधात्प्रतिपालनम्।\nदेहस्येषून्य आस्ते यः शुद्धोऽचिन्त्यः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2080389, "chapter_id": 2708, "verse_number": "१२-२१३-१३", "content_sanskrit": "भ्रामयन्नेषतो याति कालचक्रसमन्वितः।\nभूतानि मोहयन्नित्यं चक्रस्य च रयं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2080390, "chapter_id": 2708, "verse_number": "१२-२१३-१४", "content_sanskrit": "स्नेहद्रव्यसमायोगे क्षेत्रपाचं न वस्तुषु।\nतिलवत्पीडिते चक्रे ह्याधियन्त्रनिपीडिते।\nबहिश्चाधिष्ठिते यद्वज्ज्ञानिनां कर्मसंभवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2080391, "chapter_id": 2708, "verse_number": "१२-२१३-१५", "content_sanskrit": "कर्म तत्कुरुते तर्षादहंकारपरिग्रहम्।\nकार्यकारणसंयोगे स हेतुरुपपादितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2080392, "chapter_id": 2708, "verse_number": "१२-२१३-१६", "content_sanskrit": "`यथाऽऽकर्ण्य च तच्छिष्यस्तत्वज्ञानमनुत्तमम्।\nनात्येति कारणं कार्यं न कार्यं कारणं तथा।\nकार्याण्यमूनि करणे कालो भवति हेतुमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2080393, "chapter_id": 2708, "verse_number": "१२-२१३-१७", "content_sanskrit": "हेतुयुक्ताः प्रकृतयो विकाराश्च परस्परम्।\nअन्योन्यमभिवर्तन्ते पुरुषाधिष्ठिताः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2080394, "chapter_id": 2708, "verse_number": "१२-२१३-१८", "content_sanskrit": "सत्वरजस्तामसैर्भावैश्च्युतो हेतुबलान्वितः।\nक्षेत्रज्ञमेवानयाति पांसुर्वातेरितो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2080395, "chapter_id": 2708, "verse_number": "१२-२१३-१९", "content_sanskrit": "न च तैः स्पृश्यते भावैर्न ते तेन महात्मना।\nसरजस्कोऽरजस्कश्च स वै वायुर्भवेद्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2080396, "chapter_id": 2708, "verse_number": "१२-२१३-२०", "content_sanskrit": "तथैतदन्तरं विद्यात्सत्वक्षेत्रज्ञयोर्बुधः।\nअभ्यासात्स तथा युक्तो न गच्छेत्प्रकृतिं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2080397, "chapter_id": 2708, "verse_number": "१२-२१३-२१", "content_sanskrit": "संदेहमेतमुत्पन्नमच्छिनद्भगवानृषिः।\nतथा वार्तां समीक्षेत कृतलक्षणसंविदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2080398, "chapter_id": 2708, "verse_number": "१२-२१३-२२", "content_sanskrit": "बीजान्यग्न्युपदग्धानि नरो हन्ति यथा पुनः।\nज्ञानदग्धैस्तथा क्लेशैर्नात्मा संपद्यते पुनः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2080399, "chapter_id": 2708, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि त्रयोदशाधिकद्विशततमोऽध्यायः॥ २१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]