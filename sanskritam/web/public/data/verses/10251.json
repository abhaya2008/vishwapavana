[{"id": 6000251000, "chapter_id": 10251, "verse_number": null, "content_sanskrit": "अथ पञ्चपञ्चाशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000251001, "chapter_id": 10251, "verse_number": "१०-५५-१", "content_sanskrit": "इत्थं सोऽनुगृहीतोऽङ्ग कृष्णेनेक्ष्वाकुनन्दनः।\nतं परिक्रम्य सन्नम्य निश्चक्राम गुहामुखात्॥ १०/५५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.001.m4a", "display_order": 2, "topics": [{"text": "मुचुकुन्दः बदर्याश्रममससाद", "range": "१–४"}]}, {"id": 6000251002, "chapter_id": 10251, "verse_number": "१०-५५-२", "content_sanskrit": "स वीक्ष्य क्षुल्लकान् मर्त्यान् पशून् वीरुद्वनस्पतीन्।\nमत्वा कलियुगं प्राप्तं जगाम दिशमुत्तराम्॥ १०/५५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.002.m4a", "display_order": 3}, {"id": 6000251003, "chapter_id": 10251, "verse_number": "१०-५५-३", "content_sanskrit": "तपःश्रद्धायुतो वीरो निःसङ्गो मुक्तसंशयः।\nसमाधाय मनः कृष्णे प्राविशद् गन्धमादनम्॥ १०/५५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.003.m4a", "display_order": 4}, {"id": 6000251004, "chapter_id": 10251, "verse_number": "१०-५५-४", "content_sanskrit": "बदर्याश्रममासाद्य नरनारायणालयम्।\nसर्वद्वन्द्वसहः शान्तस्तपसाऽऽराधयद्धरिम्॥ १०/५५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.004.m4a", "display_order": 5}, {"id": 6000251005, "chapter_id": 10251, "verse_number": "१०-५५-५", "content_sanskrit": "भगवान् पुनराव्रज्य मधुरां यवनाहृतम्।\nहत्वा म्लेञ्छबलं निन्ये तदीयं द्वारकां धनम्॥ १०/५५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.005.m4a", "display_order": 6, "topics": [{"text": "रामकृष्णयोः जरासन्धेन सह युद्धम्", "range": "५–१७"}]}, {"id": 6000251006, "chapter_id": 10251, "verse_number": "१०-५५-६", "content_sanskrit": "नीयमाने धने गोभिर्नृभिश्चाच्युतचोदितैः।\nआजगाम जरासन्धस्‍त्रयोविंशत्यनीकपः॥ १०/५५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.006.m4a", "display_order": 7}, {"id": 6000251007, "chapter_id": 10251, "verse_number": "१०-५५-७", "content_sanskrit": "ततो राजा जरासन्धः कल्पान्तानलसन्निभः। निधाय मकरव्यूहं रथनागाश्वपत्तिमत्।\nअन्तश्चकार गोविन्दं व्यूहस्य निमिषान्तरे॥ १०/५५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.007.m4a", "display_order": 8}, {"id": 6000251008, "chapter_id": 10251, "verse_number": "१०-५५-८", "content_sanskrit": "ततो विलोक्य गोविन्दो वृक्षमुत्पाट्य रंहसा।\nगजान् रथान् हयान् युद्धे पोथयामास दुर्मदः॥ १०/५५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.008.m4a", "display_order": 9}, {"id": 6000251009, "chapter_id": 10251, "verse_number": "१०-५५-९", "content_sanskrit": "कृष्णेन हन्यमानास्ते वृक्षेण रिपुकुञ्जराः।\nपेतुर्गतासवो भूमौ वज्रनुन्ना इवाद्रयः॥ १०/५५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.009.m4a", "display_order": 10}, {"id": 6000251010, "chapter_id": 10251, "verse_number": "१०-५५-१०", "content_sanskrit": "रथाश्च रथिभिर्युक्ताः सतुरङ्गाः सचोदकाः।\nनिष्पिष्टा इव न क्‍वापि दृश्यन्ते कुरुसत्तम॥ १०/५५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.010.m4a", "display_order": 11}, {"id": 6000251011, "chapter_id": 10251, "verse_number": "१०-५५-११", "content_sanskrit": "रामस्तु मुष्टिनैवाजौ कुञ्जरान् मदशालिनः।\nजघान कुपितः शैलान् वज्रेणेव सुरेश्वरः॥ १०/५५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.011.m4a", "display_order": 12}, {"id": 6000251012, "chapter_id": 10251, "verse_number": "१०-५५-१२", "content_sanskrit": "राममुष्टिप्रहारेण विशीर्णाः स्यन्दना नृप।\nन व्यदृश्यन्त भूपृष्ठे चूर्णिताः शीर्णपर्णवत्॥ १०/५५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.012.m4a", "display_order": 13}, {"id": 6000251013, "chapter_id": 10251, "verse_number": "१०-५५-१३", "content_sanskrit": "यवनस्य धनं विश्वं गच्छन्तं द्वारकामनु।\nनिहत्य यादवान् विश्वांस्तद् गृहीत्वा जरासुतः॥ १०/५५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.013.m4a", "display_order": 14}, {"id": 6000251014, "chapter_id": 10251, "verse_number": "१०-५५-१४", "content_sanskrit": "अभ्यवर्तत सङ्ग्रामे रामकृष्णौ कुरूद्वह।\nविलोक्य वेगरभसं रिपुसैन्यस्य माधवौ॥ १०/५५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.014.m4a", "display_order": 15}, {"id": 6000251015, "chapter_id": 10251, "verse_number": "१०-५५-१५", "content_sanskrit": "तं चापतन्तमालोक्य सहितं सबलैर्नृपैः।\nकीर्यमाणौ शरौघेण वृष्ट्येव करिपोतकौ॥ १०/५५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.015.m4a", "display_order": 16}, {"id": 6000251016, "chapter_id": 10251, "verse_number": "१०-५५-१६", "content_sanskrit": "विरथौ विप्रहरणौ विवर्माणौ विसैनिकौ।\nमनुष्यचेष्टामापन्नौ राजन् दुद्रुवतुर्द्रुतम्॥ १०/५५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.016.m4a", "display_order": 17}, {"id": 6000251017, "chapter_id": 10251, "verse_number": "१०-५५-१७", "content_sanskrit": "विहाय वित्तं प्रचुरमभीतौ भीरुभीतवत्।\nपद्भ्यां पद्मपलाशाभ्यां चेरतुर्बहुयोजनम्॥ १०/५५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.017.m4a", "display_order": 18}, {"id": 6000251018, "chapter_id": 10251, "verse_number": "१०-५५-१८", "content_sanskrit": "पलायमानौ तौ दृष्ट्वा मागधः प्रहसन् बली।\nअन्वधावद् रथानीकैरीशयोरप्रमाणवित्॥ १०/५५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.018.m4a", "display_order": 19}, {"id": 6000251019, "chapter_id": 10251, "verse_number": "१०-५५-१९", "content_sanskrit": "प्रहृत्य दूरं विश्रान्तौ करवीरपुरे निशि।\nतावारुरुहतुर्वीरौ गोमन्तमुदिते रवौ॥ १०/५५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.019.m4a", "display_order": 20, "topics": [{"text": "कृष्णो भीत इव गोमन्तकपर्वतं ययौ", "range": "१९"}]}, {"id": 6000251020, "chapter_id": 10251, "verse_number": "१०-५५-२०", "content_sanskrit": "सिद्धचारणगन्धर्वविद्याधरनिषेवितम्।\nआरुह्य शैलं गोमन्तं कृष्णरामौ त्वरान्वितौ॥ १०/५५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.020.m4a", "display_order": 21}, {"id": 6000251021, "chapter_id": 10251, "verse_number": "१०-५५-२१", "content_sanskrit": "प्रवर्षणाख्यं तच्छृङ्गं यत्राब्दा नित्यवर्षिणः।\nतत्र तावासतू राजन् फलमूलाशनौ सुखम्॥ १०/५५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.021.m4a", "display_order": 22}, {"id": 6000251022, "chapter_id": 10251, "verse_number": "१०-५५-२२", "content_sanskrit": "जरासन्धस्तु तुष्टात्मा तावनुद्रुत्य माधवौ।\nरुरोध शैलं गोमन्तं महत्या सेनया वृतः॥ १०/५५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.022.m4a", "display_order": 23}, {"id": 6000251023, "chapter_id": 10251, "verse_number": "१०-५५-२३", "content_sanskrit": "स भूपालान् समाहूय स्वानुगान् युद्धदुर्मदान्।\nकलिङ्गं कुञ्जरपतिं सुराष्ट्राधिपतिं तथा॥ १०/५५/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.023.m4a", "display_order": 24, "topics": [{"text": "जरासन्धःसकलनृपतिभिः समेत्य काष्ठैः गोमन्तं ददाह", "range": "२३–३६"}]}, {"id": 6000251024, "chapter_id": 10251, "verse_number": "१०-५५-२४", "content_sanskrit": "जयद्रथं सिन्धुपतिं सोमदत्तं च कौरवम्।\nगान्धारराजं शकुनिं वैदर्भं रुग्मिमेव च॥ १०/५५/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.024.m4a", "display_order": 25}, {"id": 6000251025, "chapter_id": 10251, "verse_number": "१०-५५-२५", "content_sanskrit": "सुदक्षिणं च काम्बोजं विराटं मत्स्यभूपतिम्।\nएतानाज्ञापयामास पूर्वस्यां दिशि भूपतीन्॥ १०/५५/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.025.m4a", "display_order": 26}, {"id": 6000251026, "chapter_id": 10251, "verse_number": "१०-५५-२६", "content_sanskrit": "पाञ्चालराजं द्रुपदं दमघोषं च चेदिपम्।\nब्रह्मदत्तं च साल्वेशमेकलव्यं निषादपम्॥ १०/५५/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.026.m4a", "display_order": 27}, {"id": 6000251027, "chapter_id": 10251, "verse_number": "१०-५५-२७", "content_sanskrit": "बाह्लीकं च कुरुश्रेष्ठं युधामन्युं च दुर्जयान्।\nविन्दानुविन्दावावन्त्यौ काशिराजं च पौण्ड्रकम्॥ १०/५५/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.027.m4a", "display_order": 28}, {"id": 6000251028, "chapter_id": 10251, "verse_number": "१०-५५-२८", "content_sanskrit": "आज्ञापयामास नृपानेतान् वीरान् जरासुतः।\nगिरिं गोमन्तमारोढुं दक्षिणस्यां दिशि प्रभो॥ १०/५५/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.028.m4a", "display_order": 29}, {"id": 6000251029, "chapter_id": 10251, "verse_number": "१०-५५-२९", "content_sanskrit": "द्रुमं किम्पुरुषाधीशं दन्तवक्रं सहानुजम्।\nवीरं विदेहराजानं भूरिश्रवसमेव च॥ १०/५५/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.029.m4a", "display_order": 30}, {"id": 6000251030, "chapter_id": 10251, "verse_number": "१०-५५-३०", "content_sanskrit": "करूसेशं बृहच्चापं दशार्णं च शतध्वजम्।\nशैब्यं सुवीरराजानं दरदं च महारथम्॥ १०/५५/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.030.m4a", "display_order": 31}, {"id": 6000251031, "chapter_id": 10251, "verse_number": "१०-५५-३१", "content_sanskrit": "एतान् महीपतीन् राजा जरासन्धोऽमितद्युतिः।\nप्राह गोमन्तमारोढुं पश्चिमस्यां दिशि द्रुतम्॥ १०/५५/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.031.m4a", "display_order": 32}, {"id": 6000251032, "chapter_id": 10251, "verse_number": "१०-५५-३२", "content_sanskrit": "त्रिगर्तं च सुशर्माणं बलिनं वेणुदारिणम्।\nकुलिन्दं च महासत्त्वं केकयानपि भूपतीन्॥ १०/५५/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.032.m4a", "display_order": 33}, {"id": 6000251033, "chapter_id": 10251, "verse_number": "१०-५५-३३", "content_sanskrit": "शिशुपालं च भूपालं भीष्मकं चापि दुर्जयम्।\nपुरस्कृत्यारुरोहाशु कौबेर्यां मागधो दिशि॥ १०/५५/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.033.m4a", "display_order": 34}, {"id": 6000251034, "chapter_id": 10251, "verse_number": "१०-५५-३४", "content_sanskrit": "एवं गोमन्तमारुह्य सर्वर्तुफलपादपम्।\nविचिन्त्य तत्र सर्वत्राप्यधः शृृङ्गात् प्रवर्षणात्॥ १०/५५/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.034.m4a", "display_order": 35}, {"id": 6000251035, "chapter_id": 10251, "verse_number": "१०-५५-३५", "content_sanskrit": "चिच्छिदुः सकलान् वृक्षान् नापश्यत् राममाधवौ।\nगिरौ विलीनावाज्ञाय नाधिगम्य पदं नृप॥ १०/५५/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.035.m4a", "display_order": 36}, {"id": 6000251036, "chapter_id": 10251, "verse_number": "१०-५५-३६", "content_sanskrit": "ददाह गिरिमेधोभिः समन्तादग्निमुत्सृजन्।\nतत उत्पत्य तरसा दह्यमानात्तु तावुभौ॥ १०/५५/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.036.m4a", "display_order": 37}, {"id": 6000251037, "chapter_id": 10251, "verse_number": "१०-५५-३७", "content_sanskrit": "दशैकयोजनोत्तुङ्गान्निपेततुरधो भुवि।\nअलक्ष्यमाणौ रिपुणा सानुगेन यदूत्तमौ॥ १०/५५/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.037.m4a", "display_order": 38, "topics": [{"text": "कृष्णः अदृष्टः स्वपुरं ययौ", "range": "३७–४१"}]}, {"id": 6000251038, "chapter_id": 10251, "verse_number": "१०-५५-३८", "content_sanskrit": "स्वपुरं पुनरायातौ समुद्रपरिखां नृप।\nसोऽपि दग्धाविति मृषा मन्वानो बलकेशवौ॥ १०/५५/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.038.m4a", "display_order": 39}, {"id": 6000251039, "chapter_id": 10251, "verse_number": "१०-५५-३९", "content_sanskrit": "बलमाकृष्य सुमहन्मगधान् मागधो ययौ।\nअष्टादशे तु सङ्ग्रामे जित्वा यादवसत्तमौ॥ १०/५५/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.039.m4a", "display_order": 40}, {"id": 6000251040, "chapter_id": 10251, "verse_number": "१०-५५-४०", "content_sanskrit": "दृप्तः स्वराष्ट्रे न्यवसज्जितदिङ्मण्डलो नृप।\nमाधवौ तु महात्मानौ प्रविश्य द्वारकां पुरीम्॥ १०/५५/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.040.m4a", "display_order": 41}, {"id": 6000251041, "chapter_id": 10251, "verse_number": "१०-५५-४१", "content_sanskrit": "स्तूयमानौ दिवारात्रं सूतमागधबन्दिभिः।\nवृतावानन्दबहुलैर्बन्धुभिः सुखमूषतुः॥ १०/५५/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_055/BhP_10.055.041.m4a", "display_order": 42}, {"id": 6000251042, "chapter_id": 10251, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धे पञ्चपञ्चाशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]