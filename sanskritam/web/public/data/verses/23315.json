[{"id": 7003315000, "chapter_id": 23315, "verse_number": "२-१०-१", "content_sanskrit": "सनत्कुमार उवाच  ।\nभूय एव ममाचक्ष्व महिमानमुमापतेः ।\nभवभक्त महाप्राज्ञ भगवन्नंदिकेश्वर ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003315001, "chapter_id": 23315, "verse_number": "२-१०-२", "content_sanskrit": "शैलादिरुवाच  ।\nसनत्कुमार संक्षेपात्तव वक्ष्याम्यशेषतः ।\nमहिमानं महेशस्य भवस्य परमेष्ठिनः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003315002, "chapter_id": 23315, "verse_number": "२-१०-३", "content_sanskrit": "नास्य प्रकृतिबंधोऽभूद्बुद्धिबंधो न कश्चन ।\nन चाहंकारबंधश्च मनोबंधश्च नोऽभवत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003315003, "chapter_id": 23315, "verse_number": "२-१०-४", "content_sanskrit": "चित्तबन्धो न तस्याभूच्छ्रोत्रबंधो न चाभवत् ।\nन त्वचां चक्षुषां वापि बंधो जज्ञे कदाचन ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003315004, "chapter_id": 23315, "verse_number": "२-१०-५", "content_sanskrit": "जिह्वाबंधो न तस्याभूद्घ्राणबंधो न कश्चन ।\nपादबंधः पाणिबंधो वाग्बंधश्चैव सुव्रत ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003315005, "chapter_id": 23315, "verse_number": "२-१०-६", "content_sanskrit": "उपस्थेंद्रिय बंधश्च भूततन्मात्रबंधनम् ।\nनित्यशुद्धस्वभावेन नित्यबुद्धो निसर्गतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003315006, "chapter_id": 23315, "verse_number": "२-१०-७", "content_sanskrit": "नित्यमुक्त इति प्रोक्तो मुनिभिस्तत्त्ववेदिभिः ।\nअनादि मध्यनिष्ठस्य शिवस्य परमेष्ठिनः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003315007, "chapter_id": 23315, "verse_number": "२-१०-८", "content_sanskrit": "बुद्धिं सूते नियोगेन प्रकृतिः पुरुषस्य च ।\nअहंकारं प्रसूतेऽस्या बुद्धिस्तस्य नियोगतः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003315008, "chapter_id": 23315, "verse_number": "२-१०-९", "content_sanskrit": "अंतर्यामीति देहेषु प्रसिद्धस्य स्वयंभुवः ।\nइंद्रियाणि दशैकं च तन्मात्राणि च शासनात् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003315009, "chapter_id": 23315, "verse_number": "२-१०-१०", "content_sanskrit": "अहंकारोऽतिसंसूते शिवस्य परमेष्ठिनः ।\nतन्मात्राणि नियोगेन तस्य संसुक्ते प्रभो ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003315010, "chapter_id": 23315, "verse_number": "२-१०-११", "content_sanskrit": "महाभूतान्यशेषेण महादेवस्य धीमतः ।\nब्रह्मादीनां तृणांतं हि देहिनां देहसंगतिम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003315011, "chapter_id": 23315, "verse_number": "२-१०-१२", "content_sanskrit": "महाभूतान्यशेषाणि जनयंति शिवाज्ञया ।\nअध्यवस्यति सर्वार्थान्बुद्धिस्तस्याज्ञया विभोः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003315012, "chapter_id": 23315, "verse_number": "२-१०-१३", "content_sanskrit": "अंतर्यामीति देहेषु प्रसिद्धस्य स्वयंभुवः ।\nस्वभावसिद्धमैश्वर्यं स्वभावादेव भूतयः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003315013, "chapter_id": 23315, "verse_number": "२-१०-१४", "content_sanskrit": "तस्याज्ञया समस्तार्थानहंकारोऽतिमन्यते ।\nचित्तं चेतयते चापि मनः संकल्पयत्यपि ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003315014, "chapter_id": 23315, "verse_number": "२-१०-१५", "content_sanskrit": "श्रोत्रं श्रृणोति तच्छक्त्या शब्दस्पर्शादिकं च यत् ।\nशंभोराज्ञबलेनैव भवस्य परमेष्ठिनः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003315015, "chapter_id": 23315, "verse_number": "२-१०-१६", "content_sanskrit": "वचनं कुरुते वाक्यं नादानादि कदाचन ।\nशरीराणामशेषाणां तस्य देवस्य शासनात् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003315016, "chapter_id": 23315, "verse_number": "२-१०-१७", "content_sanskrit": "करोति पाणिरादानं न गत्यादि कदाचन ।\nसर्वेषामेव जंतूनां नियमादेव वेधसः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003315017, "chapter_id": 23315, "verse_number": "२-१०-१८", "content_sanskrit": "विहारं कुरुते पादो नोत्सर्गादि कदाचन ।\nसमस्तदेहिवृंदानां शिवस्यैव नियोगतः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003315018, "chapter_id": 23315, "verse_number": "२-१०-१९", "content_sanskrit": "उत्सर्गं कुरुते पायुर्न वदेत कदाचन ।\nजंतोर्जातस्य सर्वस्य परमेश्वरशानात् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003315019, "chapter_id": 23315, "verse_number": "२-१०-२०", "content_sanskrit": "आनंदं कुरुते शश्वदुपस्थं वचनाद्विभोः ।\nसर्वेषामेव भूतानामीश्वरस्यैव शासनात् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003315020, "chapter_id": 23315, "verse_number": "२-१०-२१", "content_sanskrit": "अवकाशमशेषाणां भूतानां संप्रयच्छति ।\nआकाशं सर्वदा तस्य परमस्यैव शासनात् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003315021, "chapter_id": 23315, "verse_number": "२-१०-२२", "content_sanskrit": "निर्देशेन शिवस्यैव भेदैः प्राणादिभिर्निजैः ।\nबिभर्त्ति सर्वभूतानां शरीराणि प्रभंजनः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003315022, "chapter_id": 23315, "verse_number": "२-१०-२३", "content_sanskrit": "निर्देशाद्देवदेवस्य सप्तस्कंधगतो मरुत् ।\nलोकयात्रां वहत्येव भेदैः स्वैरावहादिभिः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003315023, "chapter_id": 23315, "verse_number": "२-१०-२४", "content_sanskrit": "नागाद्यैः पंचभिर्भेदैः शरीरेषु प्रवर्तते ।\nअपदेशेन देवस्य परमस्य समीरणः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003315024, "chapter_id": 23315, "verse_number": "२-१०-२५", "content_sanskrit": "हव्यं वहति देवानां कव्यं कव्याशिनामपि ।\nपाकं च कुरुते वह्निः शंकरस्यैव शासनात् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003315025, "chapter_id": 23315, "verse_number": "२-१०-२६", "content_sanskrit": "भुक्तमाहारजातं यत्पचते देहिनां तथा ।\nउदरस्थः सदा वह्निर्विश्वेश्वरनियोगतः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003315026, "chapter_id": 23315, "verse_number": "२-१०-२७", "content_sanskrit": "संजीवयंत्यशेषाणि भूतान्यापस्तदाज्ञया ।\nअविलंघ्या हि सर्वेषामाज्ञा तस्य गरीयसी ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003315027, "chapter_id": 23315, "verse_number": "२-१०-२८", "content_sanskrit": "चराचराणि भूतानि बिभर्त्येव तदाज्ञया ।\nआज्ञया तस्य देवस्य देवदेवः पुरंदरः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003315028, "chapter_id": 23315, "verse_number": "२-१०-२९", "content_sanskrit": "जीवतां व्याधिभिः पीडां मृतानां यातनाशतैः ।\nविश्वंभरः सदाकालं लोकैः सर्वैरलंघ्यया ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003315029, "chapter_id": 23315, "verse_number": "२-१०-३०", "content_sanskrit": "देवान्पात्य सुरान् हंति त्रैलोक्यमखिलं स्थितः ।\nअधार्मिकाणां वै नाशं करोति शिवशासनात् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003315030, "chapter_id": 23315, "verse_number": "२-१०-३१", "content_sanskrit": "वरुणः सलिलैर्लोकान्संभावयति शासनात् ।\nमज्जयत्याज्ञया तस्य पाशैर्बध्नाति चासुरान् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003315031, "chapter_id": 23315, "verse_number": "२-१०-३२", "content_sanskrit": "पुण्यानुरपं सर्वेषां प्राणिनां संप्रयच्छति ।\nवित्तं वित्तेश्वरस्तस्य शासनात्परमोष्ठिनः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003315032, "chapter_id": 23315, "verse_number": "२-१०-३३", "content_sanskrit": "उदयास्तमये कुर्वन्कुरुते कालमाज्ञया ।\nआदित्यस्तस्य नित्यस्य सत्यस्यपरमात्मनः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003315033, "chapter_id": 23315, "verse_number": "२-१०-३४", "content_sanskrit": "पुष्पाण्यौषधिजातानि प्रह्लादयति च प्रजाः ।\nअमृतांशुः कलाधारः कालकालस्य शासनात् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003315034, "chapter_id": 23315, "verse_number": "२-१०-३५", "content_sanskrit": "आदित्या वसवो रुद्रा अश्विनौ मरुतस्तथा ।\nअन्याश्च देवताः सर्वास्तच्छासनविनिर्मिताः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003315035, "chapter_id": 23315, "verse_number": "२-१०-३६", "content_sanskrit": "गंधर्वा देवसंवाश्च सिद्धाः साध्याश्च चारणाः ।\nयक्षरक्षःपिशाचाश्च स्थिताः शास्त्रेषु वेधसः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003315036, "chapter_id": 23315, "verse_number": "२-१०-३७", "content_sanskrit": "ग्रहनक्षत्रताराश्च यज्ञा वेदास्तपांसि च ।\nऋषीणां च गणाः सर्वे शासनं तस्य धिष्ठिताः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003315037, "chapter_id": 23315, "verse_number": "२-१०-३८", "content_sanskrit": "कव्याशिनां गणाः सप्तसमुद्रा गिरिसिंधवः ।\nशासने तस्य वर्तन्ते काननानि सरांसि च ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003315038, "chapter_id": 23315, "verse_number": "२-१०-३९", "content_sanskrit": "कलाः काष्ठा निमेषाश्चमुहूर्ता दिवसाः क्षपाः ।\nऋत्वब्दपक्षमासाश्च नियोगात्तस्य धिष्ठिताः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003315039, "chapter_id": 23315, "verse_number": "२-१०-४०", "content_sanskrit": "युगमन्वंतराण्यस्य शंभोस्तिष्ठंति शासनात् ।\nपराश्चैवपरार्धाश्च कालभेदास्तथापरे ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003315040, "chapter_id": 23315, "verse_number": "२-१०-४१", "content_sanskrit": "देवानां जातयश्चाष्टौ तिरश्चां पंच जातयः ।\nमनुष्याश्च प्रवर्तंते देवदेवस्य धीमतः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003315041, "chapter_id": 23315, "verse_number": "२-१०-४२", "content_sanskrit": "जातानि भूतवृंदानि चतुर्दशसु योनिषु ।\nसर्वलोकनिषण्णानि तिष्ठंत्यस्यैव शासनात् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003315042, "chapter_id": 23315, "verse_number": "२-१०-४३", "content_sanskrit": "चतुर्दशसु लोकेषु स्थिता जाताः प्रजाः प्रभोः ।\nसर्वेश्वरस्य तस्यैव नियोगवशवर्तिनः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003315043, "chapter_id": 23315, "verse_number": "२-१०-४४", "content_sanskrit": "पातालानि समस्तानि भुवनान्यस्य शासनात् ।\nब्रह्मांडानि च शेषाणि तथा सावरणानि च ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003315044, "chapter_id": 23315, "verse_number": "२-१०-४५", "content_sanskrit": "वर्तमानानि सर्वाणि ब्रह्मांडानि तदाज्ञया ।\nवर्तंते सर्वभूताद्यैः समेतानि समंततः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003315045, "chapter_id": 23315, "verse_number": "२-१०-४६", "content_sanskrit": "अतीतान्यप्यसंख्यानि ब्रह्मांडानि तदाज्ञया ।\nप्रवृत्तानि पदार्थौघैः सहितानि समंततः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003315046, "chapter_id": 23315, "verse_number": "२-१०-४७", "content_sanskrit": "ब्रह्मांडानि भविष्यंति सह वस्तुभिरात्मक्तैः ।\nकरिष्यंति शिवस्याज्ञां सर्वैरावरणैः सह ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]