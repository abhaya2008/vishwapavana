[{"id": 50024989, "chapter_id": 11965, "verse_number": "1", "content_sanskrit": "ज्ञात्वैव प्रायः सर्वतो वैलक्षण्यं कस्मिंश्चिदेव सदृशे संशयं करोति। नह्यात्मनि ‘अहं देवदत्तो न वा’ इति कस्यचित् संशयो भवति। सामान्यतः सर्ववैलक्षण्ये ज्ञात एव घटत्वादिज्ञानम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024990, "chapter_id": 11965, "verse_number": "2", "content_sanskrit": "॥ भेदस्य धर्मिस्वरूपत्वनिरूपणोपसंहारः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50024991, "chapter_id": 11965, "verse_number": "3", "content_sanskrit": "अतो नान्योन्याश्रयता।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50024992, "chapter_id": 11965, "verse_number": "4", "content_sanskrit": "॥ शिष्टशङ्कापरिहारपूर्वकं भेदस्य युक्ततोपसंहारः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}]