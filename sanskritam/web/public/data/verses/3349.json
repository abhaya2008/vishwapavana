[{"id": 2108492, "chapter_id": 3349, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2108493, "chapter_id": 3349, "verse_number": "१", "content_sanskrit": "जाम्बूनदमयो भूत्वा मरीचिविकचोज्ज्वलः ।\nस चक्रं क्षुरपर्यन्तमपश्यदमृतान्तिके\t ॥ १॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2108494, "chapter_id": 3349, "verse_number": "२", "content_sanskrit": "परिभ्रमन्तमनिशं तीक्ष्णधारमयस्मयम् ।\nज्वलनार्कप्रभं घोरं च्छेदनं सोमहारिणाम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2108495, "chapter_id": 3349, "verse_number": "३", "content_sanskrit": "घोररूपं तदत्यर्थं यन्त्रं देवैः सुनिर्मितम् ।\nतस्यान्तरं स दृष्ट्वैव पर्यवर्तत खेचरः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2108496, "chapter_id": 3349, "verse_number": "४", "content_sanskrit": "प्रविवेश बलात् पक्षी वारिवेग इवार्णवः ।\nअरान्तरेणाभ्यपतत् सङ्क्षिप्याङ्गं क्षणेन ह \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2108497, "chapter_id": 3349, "verse_number": "५", "content_sanskrit": "अधश्चक्रस्य चैवात्र दीप्तानलसमद्युती ।\nविद्युज्जिह्वौ महाकायौ दीप्तास्यौ दीप्तलोचनौ\t ॥ ५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2108498, "chapter_id": 3349, "verse_number": "६", "content_sanskrit": "चक्षुर्विषौ महावीर्यौ नित्यं क्रुद्धौ तरस्विनौ ।\nरक्षार्थमेवामृतस्य ददर्श भुजगोत्तमौ \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2108499, "chapter_id": 3349, "verse_number": "७", "content_sanskrit": "सदा संरब्धनयनौ सदा चानिमिषेक्षणौ ।\nतयोरेकोऽपि यं पश्येत् स तूर्णं भस्मसाद् भवेत् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2108500, "chapter_id": 3349, "verse_number": "८", "content_sanskrit": "तयोश्चक्षूंषि रजसा सुपर्णस्तूर्णमावृणोत् ।\nअदृष्टपूर्वस्तौ  चापि सर्वतः पर्यकालयत्  \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2108501, "chapter_id": 3349, "verse_number": "९", "content_sanskrit": "तयोरङ्गे समाक्रम्य वैनतेयोऽन्तरिक्षगः ।\nआच्छिनत् तरसा मध्ये सोममभ्यद्रवत् ततः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2108502, "chapter_id": 3349, "verse_number": "१०", "content_sanskrit": "समुत्पाट्यामृतं तत्तु वैनतेयस्ततो बली ।\nउत्पपात जवेनैव यन्त्रमुन्मथ्य वीर्यवान् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2108503, "chapter_id": 3349, "verse_number": "११", "content_sanskrit": "अपीत्वैवामृतं पक्षी परिगृह्याशु वीर्यवान् ।\nआगच्छदपरिश्रान्त आच्छाद्यार्कप्रभां  खगः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2108504, "chapter_id": 3349, "verse_number": "१२", "content_sanskrit": "विष्णुना च तदाकाशे वैनतेयः समेयिवान् ।\nतस्य नारायणस्तुष्टस्तेनातुल्येन कर्मणा \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2108505, "chapter_id": 3349, "verse_number": "१३", "content_sanskrit": "तमुवाचाव्ययो देवो वरदोऽस्मीति खेचरम् ।\nस वव्रे तव तिष्ठेयमुपरीत्यन्तरिक्षगः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2108506, "chapter_id": 3349, "verse_number": "१४", "content_sanskrit": "उवाच चैनं भूयोऽपि नारायणमिदं वचः ।\nअजरश्चामृतश्च स्याममृतेन विनाऽप्यहम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2108507, "chapter_id": 3349, "verse_number": "१५", "content_sanskrit": "एवमस्त्विति तं विष्णुरुवाच विनतासुतम् ।\nप्रतिगृह्य वरौ तौ तु गरुडो विष्णुमब्रवीत् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2108508, "chapter_id": 3349, "verse_number": "१६", "content_sanskrit": "भवतोऽपि वरं दद्मि वृणोतु भगवानपि ।\nतं वव्रे वाहनं कृष्णो गरुत्मन्तं महाबलम्\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2108509, "chapter_id": 3349, "verse_number": "१७", "content_sanskrit": "ध्वजं च चक्रे भगवान् उपरि स्थास्यसीति तम् ।\nतथेत्येवाब्रवीत् पक्षी भगवन्तं सनातनम् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2108510, "chapter_id": 3349, "verse_number": "१८", "content_sanskrit": "अनुगम्य खगं त्विन्द्रो वज्रेणाङ्गे न्यपातयत् ।\nविहङ्गमं सुरान् जित्वा हरन्तममृतं बलात् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2108511, "chapter_id": 3349, "verse_number": "१९", "content_sanskrit": "तमुवाचेन्द्रमालोक्य गरुडः पततां वरः ।\nप्रहसन् श्लक्ष्णया वाचा तथा वज्रसमाहतः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2108512, "chapter_id": 3349, "verse_number": "२०", "content_sanskrit": "ऋषेर्मानं करिष्यामि वज्रं यस्यास्थिसम्भवम् ।\nवज्रस्य च करिष्यामि तव चैव शतक्रतो \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2108513, "chapter_id": 3349, "verse_number": "२१", "content_sanskrit": "एतत् पत्रं त्यजाम्येकं यस्यान्तं नोपलप्स्यसे ।\nन हि वज्रनिपातेन वेदना मेऽस्ति काचन\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2108514, "chapter_id": 3349, "verse_number": "२२", "content_sanskrit": "इत्येवमुक्त्वा गरुडः पत्रं त्वेकं व्यसर्जयत् ।\nतत्रैव सर्वभूतानि विस्मितान्यब्रुवंस्तदा \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2108515, "chapter_id": 3349, "verse_number": "२३", "content_sanskrit": "सुरूपं पत्रमालक्ष्य सुपर्णोऽयं भवत्विति ।\nत्रिधाकृत्वा तदा वज्रं गतं स्थानं स्वमेव हि \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2108516, "chapter_id": 3349, "verse_number": "२४", "content_sanskrit": "दृष्ट्वा तदद्भुतं चापि सहस्राक्षः पुरन्दरः ।\nखगो महदिदं भूतमिति मत्वाऽभ्यभाषत\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2108517, "chapter_id": 3349, "verse_number": "२५", "content_sanskrit": "बलं विज्ञातुमिच्छामि यत् ते परमनुत्तमम् ।\nसख्यं चानन्त्यमिच्छामि त्वया सह खगोत्तम \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2108518, "chapter_id": 3349, "verse_number": "२८", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि अष्टाविंशोऽध्यायः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2108519, "chapter_id": 3349, "verse_number": "१६", "content_sanskrit": "॥ आस्तीकपर्वणि षोडशोऽध्यायः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]