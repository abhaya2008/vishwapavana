[{"id": 7003281000, "chapter_id": 23281, "verse_number": "१-८४-१", "content_sanskrit": "सूत उवाच  ।\nउमामहेश्वरं वक्ष्ये व्रतमीश्वरभाषितम्  ।\nनरनार्यादिजंतूनां हिताय मुनिसत्तमाः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003281001, "chapter_id": 23281, "verse_number": "१-८४-२", "content_sanskrit": "पौर्णमास्याममावास्यां चतुर्दस्यष्टमीषु च  ।\nनक्तमब्दं प्रकुर्वीत हविष्यं पूजयेद्भवम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003281002, "chapter_id": 23281, "verse_number": "१-८४-३", "content_sanskrit": "उमामहेशप्रतिमां हेम्ना कृत्वा सुशोभनाम्  ।\nराजतीं वाथ वर्षांते प्रतिष्ठाप्य यथाविधि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003281003, "chapter_id": 23281, "verse_number": "१-८४-४", "content_sanskrit": "ब्राह्मणान् भोजयित्वा च दत्त्वा शक्त्या च दक्षिणाम्  ।\nरथाद्यैर्वापि देवेशं नीत्वा रुद्रालयं प्रति ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003281004, "chapter_id": 23281, "verse_number": "१-८४-५", "content_sanskrit": "सर्वातिशयसंयुक्तैश्छत्रचामरभूषणैः  ।\nनिवेदयेद्व्रतं चैव शिवाय परमेष्ठिने ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003281005, "chapter_id": 23281, "verse_number": "१-८४-६", "content_sanskrit": "स याति शिवासायुज्यं नारी देव्या यदि प्रभो  ।\nअष्टम्यां च चतुर्दश्यां नियता ब्रह्मचारिणी ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003281006, "chapter_id": 23281, "verse_number": "१-८४-७", "content_sanskrit": "वर्षमेकं न भुंजीत कन्या वा विधवापि वा  ।\nवर्षांते प्रतिमां कृत्वा पूर्वोक्तविधिना ततः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003281007, "chapter_id": 23281, "verse_number": "१-८४-८", "content_sanskrit": "प्रतिष्ठाप्य यथान्यायं दत्त्वा रुद्रालये पुनः  ।\nब्राह्मणान् भोजयित्वा च भवान्या सह मोदते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003281008, "chapter_id": 23281, "verse_number": "१-८४-९", "content_sanskrit": "या नार्येवं चरेदब्दं कृष्णामेकां चतुर्दशीम्  ।\nवर्षांते प्रतिमां कृत्वा येन केनापि वा द्विजाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003281009, "chapter_id": 23281, "verse_number": "१-८४-१०", "content_sanskrit": "पूर्वोक्तमखिलं कृत्वा भवान्या सह मोदते  ।\nअमावास्यां निराहारा भवेदब्दं सुयंत्रिता ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003281010, "chapter_id": 23281, "verse_number": "१-८४-११", "content_sanskrit": "शूलं च विधिना कृत्वा वर्षांते विनिवेदयेत्  ।\nस्नाप्येशानं यजेद्भक्त्या सहस्रैः कमलैः सितैः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003281011, "chapter_id": 23281, "verse_number": "१-८४-१२", "content_sanskrit": "राजतं कमलं चैव जांबूनदसुकर्णिकम्  ।\nदत्त्वा भवाय विप्रेभ्यः प्रदद्याद्दक्षिणामपि ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003281012, "chapter_id": 23281, "verse_number": "१-८४-१३", "content_sanskrit": "कामतोपि कृतं पापं भ्रूणहत्यादिकं च यत्  ।\nतत्सर्वं शूलदानेन भिंद्यान्नारी न संशयः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003281013, "chapter_id": 23281, "verse_number": "१-८४-१४", "content_sanskrit": "सायुज्यं चैवमाप्नोति भवान्या द्विजसत्तमाः  ।\nकुर्याद्यद्वा नरः सोपि रुद्रसायुज्यमाप्नुयात् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003281014, "chapter_id": 23281, "verse_number": "१-८४-१५", "content_sanskrit": "पौर्णमास्याममावास्यां वर्षमेकमतंद्रिता  ।\nउपवासरता नारी नरोपि द्विजसत्तमाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003281015, "chapter_id": 23281, "verse_number": "१-८४-१६", "content_sanskrit": "नियोगादेव तत्कार्यं भर्तॄणां द्विजसत्तमाः  ।\nजपं दानं तपः सर्वमस्वतंत्रा यतः स्त्रियः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003281016, "chapter_id": 23281, "verse_number": "१-८४-१७", "content_sanskrit": "वर्षांते सर्वगंधाढ्यां प्रतिमां संनिवेदयेत्  ।\nसा भवान्याश्च सायुज्यं सारूयं चापि सुव्रता ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003281017, "chapter_id": 23281, "verse_number": "१-८४-१८", "content_sanskrit": "लभते नात्र संदेहः सत्यंसत्यं वदाम्यहम्  ।\nकार्तिक्यां वा तु या नारी एकभक्तेन वर्तते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003281018, "chapter_id": 23281, "verse_number": "१-८४-१९", "content_sanskrit": "क्षमाहिंसादिनियमैः संयुक्ता ब्रह्मचारिणी  ।\nदद्यात्कृष्णतिलानां च भारमेकमतंद्रिया ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003281019, "chapter_id": 23281, "verse_number": "१-८४-२०", "content_sanskrit": "सघृतं सगुडं चैव ओदनं परमेष्ठिने  ।\nदत्त्वा च ब्राह्मणेभ्यश्च यथाविभवविस्तरम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003281020, "chapter_id": 23281, "verse_number": "१-८४-२१", "content_sanskrit": "अष्टम्यां च चतुर्दश्यामुपवासरता च सा  ।\nभवान्या मोदते सार्धं सारूप्यं प्राप्य सुव्रता ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003281021, "chapter_id": 23281, "verse_number": "१-८४-२२", "content_sanskrit": "क्षमा सत्यं दया दानं शौचमिंद्रियनिग्रहः  ।\nसर्वव्रतेष्वयं धर्मः सामान्यो रुद्रपूजनम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003281022, "chapter_id": 23281, "verse_number": "१-८४-२३", "content_sanskrit": "समासाद्वः प्रवक्ष्यामि प्रतिमासमनुक्रमात्  ।\nमार्गशीर्षकमासादि कार्तिक्यांतं यताक्रमम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003281023, "chapter_id": 23281, "verse_number": "१-८४-२४", "content_sanskrit": "व्रतं सुविपुलं पुण्यं नंदिना परिभाषितम्  ।\nमार्गशीर्षकमासेथ वृषं पूर्णांगमुत्तमम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003281024, "chapter_id": 23281, "verse_number": "१-८४-२५", "content_sanskrit": "अलंकृत्य यथान्यायं शिवाय विनिवेदयेत्  ।\nसा च सार्धं भवान्या वै मोदते नात्र संशयः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003281025, "chapter_id": 23281, "verse_number": "१-८४-२६", "content_sanskrit": "पुष्यमासे तु वै शूलं प्रतिष्ठाप्य निवेदयेत्  ।\nपूर्वोक्तमखिलं कृत्वा भवान्या सह मोदते ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003281026, "chapter_id": 23281, "verse_number": "१-८४-२७", "content_sanskrit": "माघमासे रथं कृत्वा सर्वलक्षणलक्षितम्  ।\nदद्यात्संपूज्य देवेशं ब्राह्मणांश्चैव भोजयेत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003281027, "chapter_id": 23281, "verse_number": "१-८४-२८", "content_sanskrit": "सा च देव्या महाभाग मोदते नात्र संशयः  ।\nफाल्गुने प्रतिमां कृत्वा हिरण्येन यथाविधि ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003281028, "chapter_id": 23281, "verse_number": "१-८४-२९", "content_sanskrit": "राजतेनापि ताम्रेण यथाविभवविस्तरम्  ।\nप्रतिष्ठाप्य समभ्यर्च्य स्थापयेच्छंकरालये ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003281029, "chapter_id": 23281, "verse_number": "१-८४-३०", "content_sanskrit": "सा च सार्धं महादेव्या मोदते नात्र संशयः  ।\nचैत्रे भवं कुमारं च भवानीं च यथाविधि ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003281030, "chapter_id": 23281, "verse_number": "१-८४-३१", "content_sanskrit": "ताम्राद्यैर्विधिवत्कृत्वा प्रतिष्ठाप्य यथाविधि  ।\nभवान्या मोदते सार्धं दत्त्वा रुद्राय शंभवे ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003281031, "chapter_id": 23281, "verse_number": "१-८४-३२", "content_sanskrit": "कृत्वालयं हि कौबेरं राजतं रजतेन वै  ।\nईश्वरोमासमायुक्तं गणेशैश्च समंततः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003281032, "chapter_id": 23281, "verse_number": "१-८४-३३", "content_sanskrit": "सर्वरत्नसमायुक्तं प्रतिष्ठाप्य यथाविधि  ।\nस्थापयेत्परमेशस्य भवस्यायतने शुभे ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003281033, "chapter_id": 23281, "verse_number": "१-८४-३४", "content_sanskrit": "वैशाखे वै चरेदेवं कैलासाख्यं व्रतोत्तमम्  ।\nकैलासपर्वतं प्राप्य भवान्या सह मोदते ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003281034, "chapter_id": 23281, "verse_number": "१-८४-३५", "content_sanskrit": "ज्येष्ठे मासि महादेवं लिंगमूर्तिमुमापतिम्  ।\nकृतांजलि पुटेनैव ब्रह्मणा विष्णुना तथा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003281035, "chapter_id": 23281, "verse_number": "१-८४-३६", "content_sanskrit": "मध्ये भवेन संयुक्तं लिंगमूर्ति द्विजोत्तमाः  ।\nहंसेन च वराहेण कृत्वा ताम्रादिभिः शुभाम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003281036, "chapter_id": 23281, "verse_number": "१-८४-३७", "content_sanskrit": "प्रतिष्ठाप्य यथान्यायं ब्राह्मणान् भोजयेत्ततः  ।\nशिवाय शिवमासाद्य शिवस्थाने यथाविधि ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003281037, "chapter_id": 23281, "verse_number": "१-८४-३८", "content_sanskrit": "ब्राह्मणैः सहितां स्थाप्य देव्याः सायुज्यमाप्नुयात्  ।\nआषाढे  च शुभे मासे गृहं कृत्वा सुशोभनम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003281038, "chapter_id": 23281, "verse_number": "१-८४-३९", "content_sanskrit": "पक्वेष्टकाभिर्विधिवद्यथाविभवविस्तरम्  ।\nसर्वबीजरसैश्चापि संपूर्णं सर्वशोभनैः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003281039, "chapter_id": 23281, "verse_number": "१-८४-४०", "content_sanskrit": "गृहोपकरणैश्चैव मुसलोलूखलादिभिः  ।\nदासीदासादिभिश्चैव शयनैरशनादिभिः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003281040, "chapter_id": 23281, "verse_number": "१-८४-४१", "content_sanskrit": "संपूर्णैश्च गृहं वस्त्रैराच्छाद्य च समंततः  ।\nदेवं घृतादिभिः स्नाप्य महादेवमुमापतिम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003281041, "chapter_id": 23281, "verse_number": "१-८४-४२", "content_sanskrit": "ब्राह्मणानां सहस्रं च भोजयित्वा यथाविधि  ।\nविद्याविनयसंपन्नं ब्राह्मणं वेदपारगम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003281042, "chapter_id": 23281, "verse_number": "१-८४-४३", "content_sanskrit": "प्रथमाश्रमिणं भक्त्या संपूज्य च यथाविधि  ।\nकन्यां सुमध्यमां यावत्कालजीवनसंयुताम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003281043, "chapter_id": 23281, "verse_number": "१-८४-४४", "content_sanskrit": "क्षेत्रं गोमिथुनं चैव तद्गृहे च निवेदयेत्  ।\nसायनैर्विविधैर्दिव्यैर्मेरुपर्वतसन्निभैः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003281044, "chapter_id": 23281, "verse_number": "१-८४-४५", "content_sanskrit": "गोलोकं समनुप्राप्य भवान्या सह मोदते  ।\nभवान्या सदृशीभूत्वा सर्वकल्पेषु साव्यया ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003281045, "chapter_id": 23281, "verse_number": "१-८४-४६", "content_sanskrit": "भवान्याश्चैव सायुज्यं लभते नात्र संशयः  ।\nसर्वधातुसमाकीर्णं विचित्रध्वजशोभितम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003281046, "chapter_id": 23281, "verse_number": "१-८४-४७", "content_sanskrit": "निवेदयीत शर्वाय श्रावणे तिलपर्वतम्  ।\nवितानध्वजवस्त्राद्यैर्धातुभिश्च निवेदयेत् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003281047, "chapter_id": 23281, "verse_number": "१-८४-४८", "content_sanskrit": "ब्राह्मणान् भोजयित्वा च पूर्वोक्तमखिलं भवेत्  ।\nकृत्वा भाद्रपदे मासि शोभनं शालिपर्वतम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003281048, "chapter_id": 23281, "verse_number": "१-८४-४९", "content_sanskrit": "वितानध्वजवस्त्राद्यैर्धातुभिश्च निवेदयेत्  ।\nब्राह्मणान् भोजयित्वा च दापयेच्च यथाविधि ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003281049, "chapter_id": 23281, "verse_number": "१-८४-५०", "content_sanskrit": "सा च सूर्यांशुसंकाशा भवान्या सह मोदते  ।\nकृत्वा चाश्वयुजे मासि विपुलं धान्यपर्वतम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003281050, "chapter_id": 23281, "verse_number": "१-८४-५१", "content_sanskrit": "सुवर्णवस्त्रसंयुक्तं दत्त्वा संपूज्य शंकरम्  ।\nब्राह्मणान् भोजयित्वा च पूर्वोक्तमखिलं भवेत् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003281051, "chapter_id": 23281, "verse_number": "१-८४-५२", "content_sanskrit": "सर्वधान्यसमायुक्तं सर्वबीजरसादिभिः  ।\nसर्वधातुसमायुक्तं सर्वरत्नोपशोभितम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003281052, "chapter_id": 23281, "verse_number": "१-८४-५३", "content_sanskrit": "श्रृंगैश्चतुर्भिः संयुक्तं वितानच्छत्रशोभितम्  ।\nगंधमाल्यैस्तथा धूपैश्चित्रैश्चापि सुशोभितम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003281053, "chapter_id": 23281, "verse_number": "१-८४-५४", "content_sanskrit": "विचित्रैर्नृत्यगेयैश्च शंखवीणादिभिस्तथा  ।\nब्रह्मघोषैर्महापुण्यं मंगलैश्च विशेषतः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003281054, "chapter_id": 23281, "verse_number": "१-८४-५५", "content_sanskrit": "महाध्वजाष्टसंयुक्तं विचित्रकुसुमोज्जवलम्  ।\nनगेन्द्रं मेरुनामानं त्रैलोक्याधारमुत्तमम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003281055, "chapter_id": 23281, "verse_number": "१-८४-५६", "content_sanskrit": "तस्य मूर्ध्नि शिवं कुर्यान्मध्यतो धातुनैव तु  ।\nदक्षिणे च यथान्यायं ब्रह्माणं च चतुर्मुखम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003281056, "chapter_id": 23281, "verse_number": "१-८४-५७", "content_sanskrit": "उत्तरे देवदेवेशं नारायणमनामयम्  ।\nइंद्रादिलोकपालांश्च कृत्वा भक्त्या यथाविधि ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003281057, "chapter_id": 23281, "verse_number": "१-८४-५८", "content_sanskrit": "प्रतिष्ठाप्य ततः स्नाप्य समभ्यर्च्य महेश्वरम्  ।\nदेवस्य दक्षिणे हस्ते शूलं त्रिदशपूजितम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003281058, "chapter_id": 23281, "verse_number": "१-८४-५९", "content_sanskrit": "वामे पाशं भवान्याश्च कमलं हेमभूषितम्  ।\nविष्णोश्च शंखं चक्रं च गदामब्जं प्रयत्नतः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003281059, "chapter_id": 23281, "verse_number": "१-८४-६०", "content_sanskrit": "ब्रह्मणश्चाक्षसूत्रं च कमंडलुमनुत्तमम्  ।\nइंद्रस्य वज्रमग्नेश्चशक्त्याख्यं परमायुधम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003281060, "chapter_id": 23281, "verse_number": "१-८४-६१", "content_sanskrit": "यमस्य दंडं निर्ऋतेः खड्गं निशिचरस्य तु  ।\nवरुणस्य महापाशं नागाख्यं रुद्रमद्भुतम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003281061, "chapter_id": 23281, "verse_number": "१-८४-६२", "content_sanskrit": "वायोर्यष्टिं कुबेरस्य गदां लोकप्रपूजिताम्  ।\nटंकं चेशानदेवस्य निवेद्यैवं क्रमेण च ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003281062, "chapter_id": 23281, "verse_number": "१-८४-६३", "content_sanskrit": "शिवस्य महतीं पूजां कृत्वा चरुसमन्विताम्  ।\nपूजयेत्सर्वदेवांश्च यथाविभवविस्तरम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003281063, "chapter_id": 23281, "verse_number": "१-८४-६४", "content_sanskrit": "ब्राह्मणान्भोजयित्वा च पूजां कृत्वा प्रयत्नतः  ।\nमहामेरुव्रतं कृत्वा महादेवाय दापयेत् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003281064, "chapter_id": 23281, "verse_number": "१-८४-६५", "content_sanskrit": "महामेरुमनुप्राप्य महा देव्या प्रमोदते  ।\nचिरं सायुच्यमाप्नोति महादेव्या न संशयः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003281065, "chapter_id": 23281, "verse_number": "१-८४-६६", "content_sanskrit": "कार्तिक्यामपि या नारी कृत्वा देवीमुमां शुभाम्  ।\nसर्वाभरण संपूर्णां सर्वलक्षणलक्षिताम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003281066, "chapter_id": 23281, "verse_number": "१-८४-६७", "content_sanskrit": "हेमताम्रादिभिश्चैव प्रतिष्ठाप्य विधानतः  ।\nदेवं च कृत्वा देवेशं सर्वलक्षणसंयुतम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003281067, "chapter_id": 23281, "verse_number": "१-८४-६८", "content_sanskrit": "तयोरग्रेहुताशं च स्रुवहस्तं पितामहम्  ।\nनारायणं च दातारं सर्वाभरणभूषितम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003281068, "chapter_id": 23281, "verse_number": "१-८४-६९", "content_sanskrit": "लोकपालैस्तथा सिद्धैः संवृतं स्थाप्य यत्नतः  ।\nरुद्रालये व्रतं तस्मै दापयेद्भक्तिपूर्वकम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003281069, "chapter_id": 23281, "verse_number": "१-८४-७०", "content_sanskrit": "सा भवान्यास्तनुं गत्वा भवेन सह मोदते  ।\nएकभक्तव्रतं पुण्यं प्रतिमासमनुक्रमात् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003281070, "chapter_id": 23281, "verse_number": "१-८४-७१", "content_sanskrit": "मार्गशीर्षकमासादिकार्तिकांतं प्रवर्तितम्  ।\nनरनार्यादिजंतूनां हिताय मुनिसत्तमाः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003281071, "chapter_id": 23281, "verse_number": "१-८४-७२", "content_sanskrit": "नरः कृत्वा व्रतं चैव शिवसायुज्यमाप्नुयात्  ।\nनारी देव्या न संदेहः शिवेन परिभाषितम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]