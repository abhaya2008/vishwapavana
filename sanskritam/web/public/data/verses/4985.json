[{"id": 2187433, "chapter_id": 4985, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2187434, "chapter_id": 4985, "verse_number": "१", "content_sanskrit": "पितामह महाप्राज्ञ पुण्डरीकाक्षमच्युतम् ।\nकर्तारमकृतं विष्णुं भूतानां प्रभवाप्ययम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2187435, "chapter_id": 4985, "verse_number": "२", "content_sanskrit": "नारायणं हृषीकेशं गोविन्दमपराजितम् ।\nतत्त्वेन भरतश्रेष्ठ श्रोतुमिच्छामि केशवम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2187436, "chapter_id": 4985, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2187437, "chapter_id": 4985, "verse_number": "३", "content_sanskrit": "श्रुतोऽयमर्थो रामस्य जामदग्न्यस्य जल्पतः ।\nनारदस्य च देवर्षेः कृष्णद्वैपायनस्य च\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2187438, "chapter_id": 4985, "verse_number": "४", "content_sanskrit": "असितो देवलस्तात वाल्मीकिश्च महातपाः ।\nमार्कण्डेयश्च गोविन्दे कथयत्यद्भुतं महत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2187439, "chapter_id": 4985, "verse_number": "५", "content_sanskrit": "केशवो भरतश्रेष्ठ भगवानीश्वरः प्रभुः ।\nपुरुषः सर्वमित्येव श्रूयते बहुधा विभुः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2187440, "chapter_id": 4985, "verse_number": "६", "content_sanskrit": "किं तु यानि विदुर्लोके ब्राह्मणाः शार्ङ्गधन्वनः ।\nमाहात्म्यानि महाबाहो शृणु तानि युधिष्ठिर\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2187441, "chapter_id": 4985, "verse_number": "७", "content_sanskrit": "यानि चाहुर्मनुष्येन्द्र ये पुराणविदो जनाः ।\nअशेषेण हि गोविन्दे कीर्तयिष्यामि तान्यहम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2187442, "chapter_id": 4985, "verse_number": "८", "content_sanskrit": "महाभूतानि भूतात्मा महात्मा पुरुषोत्तमः ।\nवायुर्ज्योतिस्तथा चापः खं गां चैवान्वकल्पयत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2187443, "chapter_id": 4985, "verse_number": "९", "content_sanskrit": "स दृष्ट्वा पृथिवीं चैव सर्वभूतेश्वरः प्रभुः ।\nअप्स्वेव शयनं चक्रे महात्मा पुरुषोत्तमः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2187444, "chapter_id": 4985, "verse_number": "१०", "content_sanskrit": "सर्वतेजोमयस्तस्मिन् शयानः शयने शुभे ।\nसोऽग्रजं सर्वभूतानां सङ्कर्षणमचिन्तयत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2187445, "chapter_id": 4985, "verse_number": "११", "content_sanskrit": "आश्रयं सर्वभूतानां मनसेति विशुश्रुम ।\nस धारयति भूतात्मा उभे भूतभविष्यती\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2187446, "chapter_id": 4985, "verse_number": "१२", "content_sanskrit": "प्रद्युम्नमसृजत् तस्मात् सर्वतेजःप्रकाशकम् ।\nअनिरुद्धस्ततो जज्ञे सर्वशक्तिर्महाद्युतिः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2187447, "chapter_id": 4985, "verse_number": "१३", "content_sanskrit": "अप्सु व्योमगतः श्रीमान् योगनिद्रामुपेयिवान् ।\nतस्मात् सञ्जज्ञिरे देवा ब्रह्मविष्णुमहेश्वराः ।\nलयस्थित्यन्तकर्माणस्त्रयस्ते सुमहौजसः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2187448, "chapter_id": 4985, "verse_number": "१४", "content_sanskrit": "ततस्तस्मिन् महाबाहो प्रादुर्भूते महात्मनि ।\nभास्करप्रतिमं दिव्यं नाभ्यां पद्ममजायत\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2187449, "chapter_id": 4985, "verse_number": "१५", "content_sanskrit": "स तत्र भगवान् देवः पुष्करे भासयन् दिशः ।\nब्रह्मा समभवत्तात सर्वभूतपितामहः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2187450, "chapter_id": 4985, "verse_number": "१६", "content_sanskrit": "तस्मिन्नपि महाबाहो प्रादुर्भूते महात्मनि ।\nतमसः पूर्वजो जज्ञे मधुर्नाम महासुरः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2187451, "chapter_id": 4985, "verse_number": "१७", "content_sanskrit": "तमुग्रमुग्रकर्माणमुग्रां बुद्धिं समास्थितम् ।\nब्रह्मणोपचितिं कुर्वन् जघान पुरुषोत्तमः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2187452, "chapter_id": 4985, "verse_number": "१८", "content_sanskrit": "तस्य तात वधात् सर्वे देवदानवमानवाः ।\nमधुसूदनमित्याहुर्ऋषभं सर्वसात्वताम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2187453, "chapter_id": 4985, "verse_number": "१९", "content_sanskrit": "ब्रह्मा तु ससृजे पुत्रान् मानसान् दक्षसप्तमान् ।\nमरीचिमत्र्यङ्गिरसौ पुलस्त्यं पुलहं क्रतुम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2187454, "chapter_id": 4985, "verse_number": "२०", "content_sanskrit": "मरीचिः कश्यपं तात पुत्रं चासृजदग्रजम् ।\nमानसं जनयामास तैजसं ब्रह्मसत्तमम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2187455, "chapter_id": 4985, "verse_number": "२१", "content_sanskrit": "अङ्गुष्ठादसृजद् ब्रह्मा मरीचेरपि पूर्वजम् ।\nसोऽभवद्भरतश्रेष्ठ दक्षो नाम प्रजापतिः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2187456, "chapter_id": 4985, "verse_number": "२२", "content_sanskrit": "तस्य पूर्वमजायन्त दश तिस्रश्च भारत ।\nप्रजापतेर्दुहितरस्तासां ज्येष्ठाभवद्दितिः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2187457, "chapter_id": 4985, "verse_number": "२३", "content_sanskrit": "सर्वधर्मविशेषज्ञः पुण्यकीर्तिर्महायशाः ।\nमारीचः कश्यपस्तात सर्वासामभवत् पतिः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2187458, "chapter_id": 4985, "verse_number": "२४", "content_sanskrit": "उत्पाद्य तु महाभागस्तासामवरजा दश ।\nददौ धर्माय धर्मज्ञो दक्ष एव प्रजापतिः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2187459, "chapter_id": 4985, "verse_number": "२५", "content_sanskrit": "धर्मस्य वसवः पुत्रा रुद्राश्चामिततेजसः ।\nविश्वेदेवाश्च साध्याश्च मरुत्वन्तश्च भारत\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2187460, "chapter_id": 4985, "verse_number": "२६", "content_sanskrit": "अपरास्तु यवीयस्यस्ताभ्योऽन्याः सप्तविंशतिः ।\nसोमस्तासां महाभागः सर्वासामभवत् पतिः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2187461, "chapter_id": 4985, "verse_number": "२७", "content_sanskrit": "इतरास्तु व्यजायन्त गन्धर्वांस्तुरगान् द्विजान् ।\nगाश्च किम्पुरुषान् मत्स्यानौद्भिदांश्च वनस्पतीन्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2187462, "chapter_id": 4985, "verse_number": "२८", "content_sanskrit": "आदित्यानदितिर्जज्ञे देवश्रेष्ठान् महाबलान् ।\nतेषां विष्णुर्वामनोऽभूद् गोविन्दश्चाभवत् प्रभुः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2187463, "chapter_id": 4985, "verse_number": "२९", "content_sanskrit": "तस्य विक्रमणादेव देवानां श्रीर्व्यवर्धत ।\nदानवाश्च पराभूता दैतेयी चासुरी प्रजा\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2187464, "chapter_id": 4985, "verse_number": "३०", "content_sanskrit": "विप्रचित्तिप्रधानांश्च दानवानसृजद् दनुः ।\nदितिस्तु सर्वानसुरान् महासत्त्वान् व्यजायत\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2187465, "chapter_id": 4985, "verse_number": "३१", "content_sanskrit": "ततः ससर्ज भगवान् मृत्युं लोकभयङ्करम् ।\nहर्तारं सर्वभूतानां ससर्ज च जनार्दनः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2187466, "chapter_id": 4985, "verse_number": "३२", "content_sanskrit": "अहोरात्रं च कालं च यथर्तु मधुसूदनः ।\nपूर्वाह्णं चापराह्णं च सर्वमेवान्वकल्पयत्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2187467, "chapter_id": 4985, "verse_number": "३३", "content_sanskrit": "बुद्ध्यापः सोऽसृजन्मेघांस्तथा स्थावरजङ्गमान् ।\nपृथिवीं सोऽसृजद् विश्वां सहितां भूरितेजसा\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2187468, "chapter_id": 4985, "verse_number": "३४", "content_sanskrit": "ततः कृष्णो महाबाहुः पुनरेव युधिष्ठिर ।\nब्राह्मणानां शतं श्रेष्ठं मुखादसृजत प्रभुः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2187469, "chapter_id": 4985, "verse_number": "३५", "content_sanskrit": "बाहुभ्यां क्षत्रियशतं वैश्यानामूरुतः शतम् ।\nपद्भ्यां शूद्रशतं चैव केशवो भरतर्षभ\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2187470, "chapter_id": 4985, "verse_number": "३६", "content_sanskrit": "स एवं चतुरो वर्णान् समुत्पाद्य महायशाः ।\nअध्यक्षं सर्वभूतानां धातारमकरोत् प्रभुः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2187471, "chapter_id": 4985, "verse_number": "३७", "content_sanskrit": "वेदविद्याविधातारं ब्रह्माणममितद्युतिम् ।\nभूतमातृगणाध्यक्षं विरूपाक्षं च सोऽसृजत्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2187472, "chapter_id": 4985, "verse_number": "३८", "content_sanskrit": "शासितारं च पापानां पितृणां समवर्तिनम् ।\nअसृजत् सर्वभूतात्मा निधिपं च धनेश्वरम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2187473, "chapter_id": 4985, "verse_number": "३९", "content_sanskrit": "यादसामसृजन्नाथं वरुणं च जलेश्वरम् ।\nवासवं सर्वदेवानामध्यक्षमकरोत् प्रभुः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2187474, "chapter_id": 4985, "verse_number": "४०", "content_sanskrit": "यावद्यावदभूच्छ्रद्धा देहं धारयितुं नृणाम् ।\nतावत्तावदजीवंस्ते नासीद्यमकृतं भयम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2187475, "chapter_id": 4985, "verse_number": "४१", "content_sanskrit": "न चैषां मैथुनो धर्मो बभूव भरतर्षभ ।\nसङ्कल्पादेव चैतेषामपत्यमुदपद्यत\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2187476, "chapter_id": 4985, "verse_number": "४२", "content_sanskrit": "तत्र त्रेतायुगे काले सङ्कल्पाज्जायते प्रजा ।\nन ह्यभून्मैथुनो धर्मस्तेषामपि जनाधिप\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2187477, "chapter_id": 4985, "verse_number": "४३", "content_sanskrit": "द्वापरे मैथुनो धर्मः प्रजानामभवन्नृप ।\nतथा कलियुगे राजन् द्वन्द्वमापेदिरे जनाः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2187478, "chapter_id": 4985, "verse_number": "४४", "content_sanskrit": "एष भूतपतिस्तात स्वध्यक्षश्च प्रकीर्तितः ।\nनिरध्यक्षांस्तु कौन्तेय कीर्तयिष्यामि तानपि\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2187479, "chapter_id": 4985, "verse_number": "४५", "content_sanskrit": "दक्षिणापथजन्मानः सर्वे तलवरान्ध्रकाः ।\nउत्साः पुलिन्दाः शबराश्चूचुपा मण्डपैः सह\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2187480, "chapter_id": 4985, "verse_number": "४६", "content_sanskrit": "उत्तरापथजन्मानः कीर्तयिष्यामि तानपि ।\nयौनकाम्बोजगान्धाराः किराता बर्बरैः सह\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2187481, "chapter_id": 4985, "verse_number": "४७", "content_sanskrit": "एते पापकृतस्तात चरन्ति पृथिवीमिमाम् ।\nश्वकाकबलगृध्राणां सधर्माणो नराधिप\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2187482, "chapter_id": 4985, "verse_number": "४८", "content_sanskrit": "नैते कृतयुगे तात चरन्ति पृथिवीमिमाम् ।\nत्रेताप्रभृति वर्तन्ते ते जना भरतर्षभ\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2187483, "chapter_id": 4985, "verse_number": "४९", "content_sanskrit": "ततस्तस्मिन् महाघोरे सन्ध्याकाले युगान्तिके ।\nराजानः समसज्जन्त समासाद्येतरेतरम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2187484, "chapter_id": 4985, "verse_number": "५०", "content_sanskrit": "ऐन्द्रं रूपं समास्थाय ह्यसुरेभ्यो चरन्महीम् ।\nस एव भगवान् देवो वेदित्वं च गता मही\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2187485, "chapter_id": 4985, "verse_number": "५१", "content_sanskrit": "एवम्भूते ..... सृष्टिर्नारसिंहादयः क्रमात् ।\nप्रादुर्भावाः स्मृता विष्णोर्जगतीरक्षणाय वै\t॥५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2187486, "chapter_id": 4985, "verse_number": "५२", "content_sanskrit": "एष कृष्णो महायोगी तत्तत्कार्यानुरूपणम् ।\nहिरण्यकशिपुं दैत्यं हिरण्याक्षं तथैव च\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2187487, "chapter_id": 4985, "verse_number": "५३", "content_sanskrit": "रावणं च महादैत्यं हत्वासौ पुरुषोत्तमः ।\nभूमेर्दुःखोपनाशार्थं ब्रह्मशक्रादिभिः स्तुतः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2187488, "chapter_id": 4985, "verse_number": "५४", "content_sanskrit": "आत्मनोऽङ्गान्महातेजा उद्बबर्ह जनार्दनः ।\nसितकृष्णौ महाराज केशौ हरिरुदारधीः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2187489, "chapter_id": 4985, "verse_number": "५५", "content_sanskrit": "वसुदेवस्य देवक्यामेष जात इहोत्तमः ।\nदेहवानिह विश्वात्मा सम्बन्धी ते जनार्दनः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2187490, "chapter_id": 4985, "verse_number": "५६", "content_sanskrit": "आविर्बभूव योगीन्द्रो मनोतीतो जगत्पतिः ।\nअचिन्त्यः पुरुषव्याघ्र नैव केवलमानुषः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2187491, "chapter_id": 4985, "verse_number": "५७", "content_sanskrit": "अव्यक्तादिविशेषान्तं परिमाणार्थसंयुतम् ।\nक्रीडा हरेरिदं सर्वं क्षरमित्येव धार्यताम्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2187492, "chapter_id": 4985, "verse_number": "५८", "content_sanskrit": "अक्षरं तत्परं नित्यं वैरूप्यं जगतो हरेः ।\nतद्विद्धि रूपमतुलममृतत्वं भवञ्जितम्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2187493, "chapter_id": 4985, "verse_number": "५९", "content_sanskrit": "तदेव कृष्णो दाशार्हः श्रीमान् श्रीवत्सलक्षणः ।\nन भूतसृष्टिसंस्थानं देहोऽस्य परमात्मनः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2187494, "chapter_id": 4985, "verse_number": "६०", "content_sanskrit": "देहवानिव यो विष्णुरसौ मायामयो हरिः ।\nआत्मनो लोकरक्षार्थं ध्याहि नित्यं सनातनम्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2187495, "chapter_id": 4985, "verse_number": "६१", "content_sanskrit": "अङ्गानि चतुरे वेदा मीमांसा न्यायविस्तरः ।\nइतिहासपुराणानि धर्माः स्वायम्भुवादयः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2187496, "chapter_id": 4985, "verse_number": "६२", "content_sanskrit": "य एनं प्रतिवर्तन्ते वेदान्तानि च सर्वशः ।\nभक्तिहीना न तैर्यान्ति नित्यमेनं कथञ्चन\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2187497, "chapter_id": 4985, "verse_number": "६३", "content_sanskrit": "सर्वभूतेषु भूतात्मा तत्तद् बुद्धिं समास्थितः ।\nतस्माद् बुद्धस्त्वमेवैनं ध्याहि नित्यमतन्द्रितः\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2187498, "chapter_id": 4985, "verse_number": "६४", "content_sanskrit": "एवमेष कुरुश्रेष्ठ प्रादुर्भावो महात्मनः ।\nदेवदेवर्षिराचष्ट नारदः सर्वलोकदृक्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2187499, "chapter_id": 4985, "verse_number": "६५", "content_sanskrit": "नारदोऽप्यथ कृष्णस्य परं मेने नराधिप ।\nशाश्वतत्वं महाबाहो यथावद्भरतर्षभ\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2187500, "chapter_id": 4985, "verse_number": "६६", "content_sanskrit": "एवमेष महाबाहुः केशवः सत्यविक्रमः ।\nअचिन्त्यः पुण्डरीकाक्षो नैष केवलमानुषः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2187501, "chapter_id": 4985, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे चतुस्त्रिंशोऽध्यायः ॥ ३४ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]