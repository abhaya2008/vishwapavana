[{"id": 7005616000, "chapter_id": 25616, "verse_number": "८९-१", "content_sanskrit": "घृताचलदानवर्णनम् ।\nअतः परं प्रवक्ष्यामि घृताचलमनुत्तमम् ।\nतेजोऽमृतमयं दिव्यं महापातकनाशनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005616001, "chapter_id": 25616, "verse_number": "८९-२", "content_sanskrit": "विशत्या घृतकुम्भानामुत्तमः स्याद्‌घृताचलः ।\nदशभिर्मध्यमः प्रोक्तः पञ्चभिस्त्वधमः स्मृतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005616002, "chapter_id": 25616, "verse_number": "८९-३", "content_sanskrit": "अल्पवित्तोऽपि यः कुर्य्याद्‌ द्वाभ्यामिह विधानतः ।\nविष्कम्भपर्वतास्तद्वच्चतुर्भागेन कल्पयेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005616003, "chapter_id": 25616, "verse_number": "८९-४", "content_sanskrit": "शालितण्डुलपात्राणि कुम्भोपरि निवेशयेत् ।\nकारयेत्संहतानुच्चान्‌ यथाशोभं विधानतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005616004, "chapter_id": 25616, "verse_number": "८९-५", "content_sanskrit": "वेष्टयेच्छुक्लवासोभिरिक्षुदण्डफलादिकैः ।\nधान्यपर्वतवच्छेषं विधानमिह पठ्यते ॥5॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005616005, "chapter_id": 25616, "verse_number": "८९-६", "content_sanskrit": "अधिवासनपूर्वञ्च तद्वद्धोमसुरार्चनम् ।\nप्रभातायां तु शर्वर्य्यां गुरवे तन्निवेदयेत् ।\nविष्कम्भपर्वतांस्तद्वत् ऋत्विग्‌भ्यः शान्तमानसः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005616006, "chapter_id": 25616, "verse_number": "८९-७", "content_sanskrit": "संयोगाद्‌घृतमुत्पन्नं यस्मादमृततेजसोः ।\nतस्मद्‌घृतार्चिर्विश्वात्मा प्रीयतामत्र शङ्करः ॥7॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005616007, "chapter_id": 25616, "verse_number": "८९-८", "content_sanskrit": "यस्मात्तेजोमयं ब्रह्म घृते तद्विद्‌ध्यवस्थितम् ।\nधृतपर्वतरूपेण तस्मात्त्वं पाहिनोऽनिशम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005616008, "chapter_id": 25616, "verse_number": "८९-९", "content_sanskrit": "अनेन विधिना दद्याद्‌घृताचलमनुत्तमम् ।\nमहापातकयुक्तोऽपि लोकमाप्नोति शाङ्करम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005616009, "chapter_id": 25616, "verse_number": "८९-१०", "content_sanskrit": "हंससारसयुक्तेन किङ्किणीजालमालिना ।\nविमानेनाप्सरोभिश्च सिद्धविद्याधरैर्वृतः ।\nविहरेत् पितृभिः सार्द्धं यावदाभूतसम्प्लवम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]