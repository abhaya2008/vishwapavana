[{"id": 40004604, "chapter_id": 8921, "verse_number": "1", "content_sanskrit": "एवं तु क्रुद्धया राजा राममात्रा सशोकया। श्रावितः परुषं वाक्यं चिन्तयामास दुःखितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40004605, "chapter_id": 8921, "verse_number": "2", "content_sanskrit": "चिन्तयित्वा स च नृपो मुमोह व्याकुलेन्द्रियः। अथ दीर्घीण कालेन संज्ञामाप परन्तपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40004606, "chapter_id": 8921, "verse_number": "3", "content_sanskrit": "स संज्ञामुपलभ्यैव दीर्घमुष्णं च निश्श्वसन्। कौसल्यां पार्श्वतो दृष्ट्वा पुन श्चिन्तामुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40004607, "chapter_id": 8921, "verse_number": "4", "content_sanskrit": "तस्य चिन्तयमानस्य प्रत्याभात्कर्म दुष्कृतम्। यदनेन कृतं पूर्वमज्ञानाच्छब्दवेधिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40004608, "chapter_id": 8921, "verse_number": "5", "content_sanskrit": "अमनास्तेन शोकेन रामशोकेन च प्रभुः। द्वाभ्यामपि महाराज श्शोकाभ्यामन्वतप्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40004609, "chapter_id": 8921, "verse_number": "6", "content_sanskrit": "दह्यामान स्सशोकाभ्यां कौसल्यामाह भूपतिः। वेपमानोऽञ्जलिं कृत्वा प्रसादार्थमवाङ्मुखः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40004610, "chapter_id": 8921, "verse_number": "7", "content_sanskrit": "प्रसादये त्वां कौसल्ये रचितोऽयं मयाऽञ्जलिः। वत्सला चानृशंसा च त्वं हि नित्यं परेष्वपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40004611, "chapter_id": 8921, "verse_number": "8", "content_sanskrit": "भर्ता तु खलु नारीणां गुणवान्निर्गुणोऽपि वा। धर्मं विमृशमानानां प्रत्यक्षं देवि दैवतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40004612, "chapter_id": 8921, "verse_number": "9", "content_sanskrit": "सा त्वं धर्मपरा नित्यं दृष्टलोक परावरा। नार्हसे विप्रियं वक्तुं दुखिःताऽपि सुदुःखितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40004613, "chapter_id": 8921, "verse_number": "10", "content_sanskrit": "तद्वाक्यं करुणं राज्ञः श्रुत्वा दीनस्य भाषितम्। कौसल्या व्यसृजद्बाष्पं प्रणालीव नवोदकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40004614, "chapter_id": 8921, "verse_number": "11", "content_sanskrit": "सा मूर्ध्निबध्वा रुदती राज्ञः पद्ममिवाञ्जलिम्। सम्भ्रमादब्रवीत् त्रस्ता त्वरमाणाक्षरं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40004615, "chapter_id": 8921, "verse_number": "12", "content_sanskrit": "प्रसीद शिरसा याचे भूमौ निपतितास्मि ते। याचितास्मि हता देव क्षन्तव्याऽहं न हि त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40004616, "chapter_id": 8921, "verse_number": "13", "content_sanskrit": "नैषा हि सा स्त्री भवति श्लाघनीयेन धीमता। उभयोर्लोकयोर्वीर पत्या या सम्साद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40004617, "chapter_id": 8921, "verse_number": "14", "content_sanskrit": "जानामि धर्मं धर्मज्ञ त्वां जाने सत्यवादिनम्। पुत्रशोकार्तया तत्तु मया किमपि भाषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40004618, "chapter_id": 8921, "verse_number": "15", "content_sanskrit": "शोको नाशयते धैर्यं शोको नाशयते श्रुतम्। शोको नाशयते सर्वं नास्ति शोकसमो रिपुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40004619, "chapter_id": 8921, "verse_number": "16", "content_sanskrit": "शक्य आपतित स्सोढुं प्रहारो रिपुहस्ततः। सोढुंमापतितश्शोकस्सुसूक्ष्मोऽपि न शक्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40004620, "chapter_id": 8921, "verse_number": "17", "content_sanskrit": "धर्मज्ञा श्श्रुतिमन्तोऽपि छिन्नधर्मार्थसंशयाः। यतयो वीर मुह्यन्ति शोकसम्मूढचेतसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40004621, "chapter_id": 8921, "verse_number": "18", "content_sanskrit": "वनवासाय रामस्य पञ्चरात्रोऽद्य गण्यते। य श्शोकहतहर्षायाः पञ्चवर्षोपमो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40004622, "chapter_id": 8921, "verse_number": "19", "content_sanskrit": "तं हि चिन्तयमानाया श्शोकोऽयं हृदि वर्धते। नदीनामिव वेगेन समुद्रसलिलं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40004623, "chapter_id": 8921, "verse_number": "20", "content_sanskrit": "एवं हि कथयन्त्यास्तु कौसल्यायाश्शुभं वचः। मन्दरश्मिरभूत्सूर्यो रजनी चाभ्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]