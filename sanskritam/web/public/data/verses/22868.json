[{"id": 7002868000, "chapter_id": 22868, "verse_number": "९-१५३-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nजलधेनुं प्रवक्ष्यामि प्रीयते दत्तया यया ।\nदेवदेवो हृषीकेशः पूजितः सर्वभावनः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002868001, "chapter_id": 22868, "verse_number": "९-१५३-२", "content_sanskrit": "जलकुंभं नरव्याघ्र स्थापयित्वा सुपूजितम् ।\nरत्नगर्भं तु तं कृत्वा ग्राम्यैर्धान्यै समन्वितम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002868002, "chapter_id": 22868, "verse_number": "९-१५३-३", "content_sanskrit": "सितवस्त्रयुगच्छन्नं दूर्वापल्लवशोभितम् ।\nकुष्ठमांसीपुरोशीरवालकामलकीयुतम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002868003, "chapter_id": 22868, "verse_number": "९-१५३-४", "content_sanskrit": "प्रियङ्गुपत्रसहितं सितयज्ञोपवीतिनम् ।\nसोपानक्तं च सच्छत्रं दर्भविष्टरसंस्थितम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002868004, "chapter_id": 22868, "verse_number": "९-१५३-५", "content_sanskrit": "चतुर्भिः संयुतं रौप्यं तिलपात्रैश्चतुर्दिशम् ।\nस्थगितं दधिपात्रेण घृतक्षौद्रवता मुखम ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002868005, "chapter_id": 22868, "verse_number": "९-१५३-६", "content_sanskrit": "सवत्सां च प्रतिष्ठाप्य गोमयेनोपशोभिताम् ।\nस्रग्दामपुच्छीं कुर्वीत ताम्रदोहनकान्विताम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002868006, "chapter_id": 22868, "verse_number": "९-१५३-७", "content_sanskrit": "ततः समभ्यर्च्य विभुं वासुदेवं सनातनम् ।\nपुष्पधूपोपहारैश्च यथाविभवमात्मनः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002868007, "chapter_id": 22868, "verse_number": "९-१५३-८", "content_sanskrit": "संकल्प्य जलधेनुं च कुंभं तमभिमंत्र्य च ।\nविष्णोर्वक्षसि या लक्ष्मीः स्वाहा या च विभावसोः ।\nसोमशक्रार्कशक्तिर्या धेनुरूपेण सास्तु मे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002868008, "chapter_id": 22868, "verse_number": "९-१५३-९", "content_sanskrit": "एवमामंत्र्य विधिवत्सफलां वत्सकान्विताम् ।\nभक्त्या संपूज्य गोविंदं जलशायिनमच्युतम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002868009, "chapter_id": 22868, "verse_number": "९-१५३-१०", "content_sanskrit": "सितवस्त्रधरः शांतो वीतरागो विमत्सरः ।\nदद्याद्विप्राय राजेन्द्र प्रीत्यर्थं जलशायिनः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002868010, "chapter_id": 22868, "verse_number": "९-१५३-११", "content_sanskrit": "शेषपर्यंकशयनः श्रीमाञ्छार्ङ्गविभूषितः ।\nजलशायी जगद्योनिः प्रीयतां मम केशवः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002868011, "chapter_id": 22868, "verse_number": "९-१५३-१२", "content_sanskrit": "इत्युच्चार्य जगन्नाथं विप्राय प्रति पाद्य ताम् ।\nतद्दिनं गोव्रतस्तिष्ठेच्छ्रद्धया परया युतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002868012, "chapter_id": 22868, "verse_number": "९-१५३-१३", "content_sanskrit": "अनेन विधिना दत्त्वा जलधेनुं जनाधिप ।\nसर्वभोगानवाप्नोति ये दिव्या ये च मानुषाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002868013, "chapter_id": 22868, "verse_number": "९-१५३-१४", "content_sanskrit": "शरीरारोग्यमतुलं प्रशमः सर्वकालिकः ।\nनृणां भवंति दत्तायां सर्वे कामा न संशयः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002868014, "chapter_id": 22868, "verse_number": "९-१५३-१५", "content_sanskrit": "अत्रापि श्रूयते भूप मुद्गले न महात्मना ।\nजातिस्मरेण यद्गीतमिहाभ्येत्य पुरा किल ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002868015, "chapter_id": 22868, "verse_number": "९-१५३-१६", "content_sanskrit": "स मुद्गलः पुरा विप्रो यमलोकगतो मुनिः ।\nददर्श यातनानेकाः पापकर्मकृतां नृणाम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002868016, "chapter_id": 22868, "verse_number": "९-१५३-१७", "content_sanskrit": "दीप्ताग्नितीक्ष्णयन्त्रस्थाः क्वाथतैलमयास्तथा ।\nउष्णक्षारनदीपाता भैरवाः पुरुषर्षभ ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002868017, "chapter_id": 22868, "verse_number": "९-१५३-१८", "content_sanskrit": "व्रणक्षारनिपातोथ कुम्भीपाकमहालयाः ।\nता दृष्ट्वा यातना विप्रश्चकार परमां कृपाम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002868018, "chapter_id": 22868, "verse_number": "९-१५३-१९", "content_sanskrit": "आह्लादं ते तदा जग्मुः पापास्तदनुकंपया ।\nतं दृष्ट्वा नारकाः केचित्स्थित्वा तदवलोकिनः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002868019, "chapter_id": 22868, "verse_number": "९-१५३-२०", "content_sanskrit": "तदवस्थं विलोक्याथ मुनिर्नारकमण्डलम् ।\nधर्मराजं स पप्रच्छ तेषां प्रशमकारणम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002868020, "chapter_id": 22868, "verse_number": "९-१५३-२१", "content_sanskrit": "तस्मै चाचष्ट राजेन्द्र तदा वैवस्वतो यमः ।\nआह्लादहेतुमधिकं नारकाणां नरोत्तम ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002868021, "chapter_id": 22868, "verse_number": "९-१५३-२२", "content_sanskrit": "दानानुभावात्सर्वेषां नारकाणां द्विजोत्तम ।\nसंप्रवृतोऽयमाह्लादः कारणं तच्छृणु ष्व मे ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002868022, "chapter_id": 22868, "verse_number": "९-१५३-२३", "content_sanskrit": "त्वयाभ्यर्च्य जगन्नाथं सर्वेशं जलशायिनम् ।\nजलधेनुः पुरा दत्ता विधिवद्विजपुङ्गव ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002868023, "chapter_id": 22868, "verse_number": "९-१५३-२४", "content_sanskrit": "तस्मात्वज्जन्मनोऽतीते तृतीये द्विज जन्मनि ।\nतस्य दानस्य ते व्युष्टिरियमाह्लाददायिनी ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002868024, "chapter_id": 22868, "verse_number": "९-१५३-२५", "content_sanskrit": "ये त्वां पश्यंति शृण्वंति ये च ध्यायंति मानवाः ।\nशृणोषि यांश्च विप्रेन्द्र यांश्च ध्यायसि पश्यसि ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002868025, "chapter_id": 22868, "verse_number": "९-१५३-२६", "content_sanskrit": "निवृत्तिः परमा तेषां सर्वाह्लादप्रदायिनी ।\nसद्यो भवति माऽत्र त्वं द्विजाते कुरु विस्मयम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002868026, "chapter_id": 22868, "verse_number": "९-१५३-२७", "content_sanskrit": "आह्लादहेतुजननं नास्ति विप्रेन्द्र तादृशम् ।\nजलधेनुर्यथा नृणां जन्मान्येकोनविंशतिम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002868027, "chapter_id": 22868, "verse_number": "९-१५३-२८", "content_sanskrit": "न दोषो न ज्वरो नार्तिर्न क्लमो द्विज जायते ।\nअपि जन्मसहस्रेऽपि जलधेनुप्रदायिनाम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002868028, "chapter_id": 22868, "verse_number": "९-१५३-२९", "content_sanskrit": "स त्वं गच्छ गृहीत्वार्धमस्मतो द्विजसत्तम ।\nयेषां समाश्रयः कृष्णे न नियम्या हि ते मया ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002868029, "chapter_id": 22868, "verse_number": "९-१५३-३०", "content_sanskrit": "कृष्णस्तु पूजितो यैस्तु ये कृष्णार्थमुपोषिताः ।\nयैश्च नित्यं स्मृतः कृष्णो न ते मद्विषयोपगाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002868030, "chapter_id": 22868, "verse_number": "९-१५३-३१", "content_sanskrit": "नमः कृष्णाच्युतानंत वासुदेवेत्युदीरितम् ।\nयैर्भा वभावितैर्विप्र न ते मद्विषयोपगाः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002868031, "chapter_id": 22868, "verse_number": "९-१५३-३२", "content_sanskrit": "दानं ददद्भिर्यैरुक्तमच्युतः प्रीयतामिति ।\nश्रद्धापुरःसरैर्विप्र न ते मद्विषयोपगाः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002868032, "chapter_id": 22868, "verse_number": "९-१५३-३३", "content_sanskrit": "स एव नाथः सर्वस्य तन्नियोगकरा वयम् ।\nजनसंयमनश्चाहमस्मत्संयमनो हरिः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002868033, "chapter_id": 22868, "verse_number": "९-१५३-३४", "content_sanskrit": "इत्थं निशम्य वचनं यमस्य वदतोऽखिलम् ।\nऊचुस्ते नारकाः सर्वे वह्निशस्त्रार्कभीरवः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002868034, "chapter_id": 22868, "verse_number": "९-१५३-३५", "content_sanskrit": "नमः कृष्णाय हरये विष्णवे जिष्णवे नमः ।\nहृषीकेशाय केशाय जगद्धात्रेऽच्युताय च ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002868035, "chapter_id": 22868, "verse_number": "९-१५३-३६", "content_sanskrit": "नमः पङ्कजनेत्राय नमः पङ्कजनाभये ।\nजनार्दनाय श्रीशाय श्रीभर्त्रे पीतवाससे ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002868036, "chapter_id": 22868, "verse_number": "९-१५३-३७", "content_sanskrit": "गोविंदाय नमो नित्यं नमश्चोदधिशायिने ।\nनमः कमलनेत्राय नृसिंहाय निनादिने ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002868037, "chapter_id": 22868, "verse_number": "९-१५३-३८", "content_sanskrit": "शार्ङ्गिणे शितखड्गाय शंखचक्रगदाभृते ।\nनमो वामनरूपाय क्रांतलोकत्रयाय च ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002868038, "chapter_id": 22868, "verse_number": "९-१५३-३९", "content_sanskrit": "वराहरूपाय तथा नमो यज्ञाङ्गधारिणे ।\nव्याप्ताशेषदिगंतायानंताय परमात्मने ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002868039, "chapter_id": 22868, "verse_number": "९-१५३-४०", "content_sanskrit": "वासुदेव नमस्तुभ्यं नमः कैटभसूदिने ।\nकेशवाय नमो राम नमस्तेस्तु महीधर ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002868040, "chapter_id": 22868, "verse_number": "९-१५३-४१", "content_sanskrit": "नमोऽस्तु वासुदेवाय ह्येवमुच्चारिते च तैः ।\nशस्त्राणि कुंठतां जग्मुरनलश्चापि शीतताम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002868041, "chapter_id": 22868, "verse_number": "९-१५३-४२", "content_sanskrit": "समभज्यंत वस्त्राणि समुत्पेतुरयोमुखाः ।\nसंशुष्का क्षारसरितः पतितः शाल्मलिद्रुमः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002868042, "chapter_id": 22868, "verse_number": "९-१५३-४३", "content_sanskrit": "प्रकाशस्तमसो जज्ञे नरकाद्भानुभिः सह ।\nववौ च युंजन्पवनोऽप्यसिपत्रवने ततः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002868043, "chapter_id": 22868, "verse_number": "९-१५३-४४", "content_sanskrit": "निरुत्साहा जडधियो बभूवुर्यमकिंकराः ।\nजाता गङ्गाम्बुवाहिन्यः पूयशौणितनिम्नगाः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002868044, "chapter_id": 22868, "verse_number": "९-१५३-४५", "content_sanskrit": "दिव्यः सुगंधि पवनो मनःप्रीतिकरस्तथा ।\nवेणुवीणास्वनयुताः शब्दाश्चासन्मनोरमाः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002868045, "chapter_id": 22868, "verse_number": "९-१५३-४६", "content_sanskrit": "तं तादृशमथालक्ष्य तदा वैवस्वतो यमः ।\nक्षीणपापत्रयांस्तांस्तु पाद्यार्घ्यैः समपूजयत् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002868046, "chapter_id": 22868, "verse_number": "९-१५३-४७", "content_sanskrit": "पूजयित्वा च तानाह कृष्णाय स कृतांजलिः ।\nसमाहितमतिर्भूत्वा धर्मराजो नरेश्वर ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002868047, "chapter_id": 22868, "verse_number": "९-१५३-४८", "content_sanskrit": "विष्णो देव जगद्धातर्जनार्दन जगत्पते ।\nप्रणामं येऽपि कुर्वन्ति तेषामपि नमोनमः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002868048, "chapter_id": 22868, "verse_number": "९-१५३-४९", "content_sanskrit": "अच्युतायाप्रमेयाय मायावामनरूपिणे ।\nप्रणामं येऽपि कुर्वन्ति तेषामपि नमो नमः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002868049, "chapter_id": 22868, "verse_number": "९-१५३-५०", "content_sanskrit": "नमस्ते वासुदेवाय धीमते पुण्यकीर्तये ।\nप्रणामं ये च कुर्वंति तेषामपि नमो नमः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002868050, "chapter_id": 22868, "verse_number": "९-१५३-५१", "content_sanskrit": "तस्य यज्ञवराहस्य विष्णोरमिततेजसः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002868051, "chapter_id": 22868, "verse_number": "९-१५३-५२", "content_sanskrit": "एवं स्तुत्वा हृषीकेशं धर्मराजस्य पश्यतः ।\nविमानवरमारुह्य नारकास्त्रिदिवं ययुः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002868052, "chapter_id": 22868, "verse_number": "९-१५३-५३", "content_sanskrit": "मुद्गलोऽपि महाबुद्धिर्दृष्ट्वैतदखिलं नृप ।\nजातिस्मरो भवद्विप्रः कण्वगोत्रे महामुनिः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002868053, "chapter_id": 22868, "verse_number": "९-१५३-५४", "content_sanskrit": "संस्मृत्य यमवाक्यानि विष्णोर्माहात्म्यमेव च ।\nजलधेनोस्तु माहात्म्यं संस्मृत्येदमगायत ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002868054, "chapter_id": 22868, "verse_number": "९-१५३-५५", "content_sanskrit": "अहो सुदुस्तरा विष्णोर्मायेयमतिगह्वरी ।\nयया मोहितचित्तस्तु न वेत्ति परमेश्वरम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002868055, "chapter_id": 22868, "verse_number": "९-१५३-५६", "content_sanskrit": "जीवो गच्छति कीटत्वं यूकामत्कुणयोनिताम् ।\nतस्माद्द्रुमलतादीनां योनिं तस्माच्च पक्षिणाम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002868056, "chapter_id": 22868, "verse_number": "९-१५३-५७", "content_sanskrit": "ततश्च पशुतां प्राप्य नरत्वमभिवांछति ।\nततो मनुष्यतां प्राप्य नरो योनिं कृतात्मनाम् ।\nतां प्राप्य च श्रियं परां नरो मायाविमोहितः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002868057, "chapter_id": 22868, "verse_number": "९-१५३-५८", "content_sanskrit": "दुस्तरापि सुसाध्या सा माया कृष्णस्य मोहिनी ।\nविद्यते सा मनोन्यस्ता मुधैव मधुसूदने ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002868058, "chapter_id": 22868, "verse_number": "९-१५३-५९", "content_sanskrit": "अवाप्यैवं च गार्हस्थ्यमवाप्यैवं च तत्परम् ।\nछिनत्ति वैष्णवीं मायां केशवार्पितमानसः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002868059, "chapter_id": 22868, "verse_number": "९-१५३-६०", "content_sanskrit": "अविरोधेन विषयान्भुञ्जन्विष्णुं समाश्रयेत्  ।\nभुक्त्वा नरस्तरत्येनां विष्णोर्मायां सुदुस्तराम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002868060, "chapter_id": 22868, "verse_number": "९-१५३-६१", "content_sanskrit": "ईदृग्बहुफला भक्तिः सर्वधातरि केशवे ।\nमायया तस्य देवस्य तां न कुर्वंति मोहिताः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002868061, "chapter_id": 22868, "verse_number": "९-१५३-६२", "content_sanskrit": "मुधैवोक्तं सुधापानं मुधा तद्धि विचेष्टितम् ।\nमुधैव जन्म तन्नष्टं यत्र नाराधितो हरिः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002868062, "chapter_id": 22868, "verse_number": "९-१५३-६३", "content_sanskrit": "आराधितो हि यः पुंसामैहिकामुष्मिकं फलम् ।\nददाति भगवान्देवः कस्तं न प्रतिपूजयेत् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002868063, "chapter_id": 22868, "verse_number": "९-१५३-६४", "content_sanskrit": "संवत्सरास्तथा मासा विफला दिवसाश्च ते ।\nनराणां विषयांधानां यैस्तु नाराधितो हरिः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002868064, "chapter_id": 22868, "verse_number": "९-१५३-६५", "content_sanskrit": "यो न वित्तर्द्धिविभवैर्न वासोभिर्न भूषणैः ।\nतुष्यते हृदयेनैव कस्तमीशं न पूजयेत् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002868065, "chapter_id": 22868, "verse_number": "९-१५३-६६", "content_sanskrit": "जलधेनोस्तु माहात्म्यं निशम्येदृग्विधं नराः ।\nनात्र यच्छंति तेषां वै विवेकः कुत्र तिष्ठति ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7002868066, "chapter_id": 22868, "verse_number": "९-१५३-६७", "content_sanskrit": "कर्मभूमौ हि मानुष्यं जन्मनामयुतैरपि ।\nस्वर्गापवर्गफलदं कदाचित्प्राप्यते नरैः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7002868067, "chapter_id": 22868, "verse_number": "९-१५३-६८", "content_sanskrit": "संप्राप्य च न यैर्विष्णुस्तोषितो जलधेनुना ।\nते जना भ्रष्टजन्मानो वंचितास्तस्य मायया ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7002868068, "chapter_id": 22868, "verse_number": "९-१५३-६९", "content_sanskrit": "ऊर्ध्वबाहुर्विरौम्येष दृष्टलोकद्वयोऽस्मि भोः ।\nआराधयध्वं गोविन्दं जलधेनुं प्रयच्छत ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7002868069, "chapter_id": 22868, "verse_number": "९-१५३-७०", "content_sanskrit": "दुःसहो नारको वह्निरविषह्या च यातना ।\nज्ञातं मयैतदालंब्य कृष्णं भवति निश्चलः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7002868070, "chapter_id": 22868, "verse_number": "९-१५३-७१", "content_sanskrit": "आदेशिको देशिको हि यममार्गे सुदुस्तरे ।\nविचिन्त्य तत्सत्यमेतन्मनः कृष्णे निवेश्यताम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7002868071, "chapter_id": 22868, "verse_number": "९-१५३-७२", "content_sanskrit": "इष्टेन किं क्रतुशतेन सुदुष्करेण क्लेशाधिकेन सुकृतैर्नियमैर्व्रतैश्च ।\nदत्ता द्विजाय पितृराजगृहं गतस्य ह्येकाऽपि गौर्जलमयी सुखमातनोति ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]