[{"id": 2105059, "chapter_id": 3265, "verse_number": "१५-३-१", "content_sanskrit": "वैशंपाय उवाच।\nएवं प्रयतमानानां वृष्णीनामन्धकैः सह।\nकालो गृहाणि सर्वेषां परिचक्राम नित्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2105060, "chapter_id": 3265, "verse_number": "१५-३-२", "content_sanskrit": "करालो विकटो मुण्डः पुरुषः कृष्णपिङ्गलः।\nगृहाण्यावेक्ष्य वृष्णीनां नादृश्यतं पुनः क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2105061, "chapter_id": 3265, "verse_number": "१५-३-३", "content_sanskrit": "तमघ्नन्त महेष्वासाः शरैः शतसहस्रशः।\nन चाशक्यत वेद्धुं स सर्वभूतात्ययस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2105062, "chapter_id": 3265, "verse_number": "१५-३-४", "content_sanskrit": "उत्पेदिरे महावाता दारुणाश्च दिनेदिने।\nवृष्ण्यन्धकविनाशाय बहवो रोमहर्षणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2105063, "chapter_id": 3265, "verse_number": "१५-३-५", "content_sanskrit": "विवृद्धमूषिका रथ्या विभिन्नमणिकास्तथा।\nकेशा नखाश्च सुप्तानामद्यन्ते मूषिकैर्निशि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2105064, "chapter_id": 3265, "verse_number": "१५-३-६", "content_sanskrit": "चीचीकूचीति वाशन्ति शारिका वृष्णिवेश्मसु।\nनोपशाम्यति शब्दस्य सदिवारात्रमेव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2105065, "chapter_id": 3265, "verse_number": "१५-३-७", "content_sanskrit": "अन्वकुर्वन्नुलूकानां सारसा विरुतं तथा।\nअजाः शिवानां विरुतमन्वकुर्वत भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2105066, "chapter_id": 3265, "verse_number": "१५-३-८", "content_sanskrit": "पाण्डुरा रक्तपादाश्च विहगाः कालचोदिताः।\nवृष्ण्यन्धकानां गेहेषु कपोता व्यचरंस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2105067, "chapter_id": 3265, "verse_number": "१५-३-९", "content_sanskrit": "व्यजायन्त खरा गोषु करभाश्वतरीषु च।\nशुनीष्वपि बिडालाश्च मूषिका नकुलीषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2105068, "chapter_id": 3265, "verse_number": "१५-३-१०", "content_sanskrit": "नापत्रपन्त पापानि कुर्वन्तो वृष्णयस्तदा।\nप्रार्दयन्ब्राह्मणांश्चापि पितॄन्देवांस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2105069, "chapter_id": 3265, "verse_number": "१५-३-११", "content_sanskrit": "गुरूंश्चाप्यवमन्यन्ते न तु रामजनार्दनौ।\nपत्न्यः पतीनुच्चरन्ति पत्नीश्चक पतयस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2105070, "chapter_id": 3265, "verse_number": "१५-३-१२", "content_sanskrit": "विभावसुः प्रज्वलितो वामं विपरिवर्तते।\nनीललोहितमञ्जिष्ठा विसृजन्नर्चिषः पृथक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2105071, "chapter_id": 3265, "verse_number": "१५-३-१३", "content_sanskrit": "उदयास्तमये नित्यं पुर्यां तस्यां दिवाकरः।\nव्यदृश्यतासकृत्पुंभिः कबन्धैः परिवारितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2105072, "chapter_id": 3265, "verse_number": "१५-३-१४", "content_sanskrit": "महानसेषु सिद्धेषु संस्कृतेऽतीवि भारत।\nआहार्यमाणे कृमयो व्यदृश्यन्त सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2105073, "chapter_id": 3265, "verse_number": "१५-३-१५", "content_sanskrit": "पुण्याहे वाच्यमाने तु जपत्सु च महात्मसु।\nअभिधावन्तः श्रूयन्ते न चादृश्यत कश्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2105074, "chapter_id": 3265, "verse_number": "१५-३-१६", "content_sanskrit": "परस्परं च नक्षत्रं हन्यमानं पुनःपुनः॥\nग्रहैरपश्यन्सर्वे ते नात्मनस्तु कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2105075, "chapter_id": 3265, "verse_number": "१५-३-१७", "content_sanskrit": "नदन्तं पाञ्चिजन्यं च वृष्णन्धकनिवेशने।\nसमन्तात्पर्यवाशन्त रासभा दारुणस्वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2105076, "chapter_id": 3265, "verse_number": "१५-३-१८", "content_sanskrit": "एवं पश्यन्हृषिकेशः संप्राप्तं कालपर्ययम्।\nत्रयोदश्याममावास्यां तान्दृष्ट्वा प्राब्रवीदिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2105077, "chapter_id": 3265, "verse_number": "१५-३-१९", "content_sanskrit": "चतुर्दशी पञ्चदशी कृतेयं राहुणा पुनः।\nप्राप्ते वै भारते युद्धे प्राप्ता चाद्य क्षंयाय नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2105078, "chapter_id": 3265, "verse_number": "१५-३-२०", "content_sanskrit": "विमृशन्नेव कालं तं परिचिन्त्य जनार्दनः।\nमेने प्राप्तं स षट्त्रिंशं वर्षं वै केशिसूदनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2105079, "chapter_id": 3265, "verse_number": "१५-३-२१", "content_sanskrit": "पुत्रशोकाभिसंतप्ता गान्धारी हतबान्धवा।\nयदनुव्याजहारार्ता तदिदं समुपागमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2105080, "chapter_id": 3265, "verse_number": "१५-३-२२", "content_sanskrit": "इदं च तदनुप्राप्तमब्रवीद्यद्युधिष्ठिरः।\nपुरा व्यूढेष्वनीकेषु दृष्ट्वेत्पातान्सुदारुणान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2105081, "chapter_id": 3265, "verse_number": "१५-३-२३", "content_sanskrit": "इत्युक्त्वा वासुदेवस्तु चिकीर्षुः सत्यमेव तत्।\nआज्ञापयामास तदा तीर्थयात्रामरिंदमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2105082, "chapter_id": 3265, "verse_number": "१५-३-२४", "content_sanskrit": "अघोषयन्त पुरुषास्तत्र केशवशासनात्।\nतीर्थयात्रा समुद्रे वः कार्येति पुरुषर्षभाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2105083, "chapter_id": 3265, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते मौसलपर्वणि तृतीयोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]