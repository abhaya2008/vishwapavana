[{"id": 2049936, "chapter_id": 2095, "verse_number": "७-२२-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2049937, "chapter_id": 2095, "verse_number": "७-२२-१", "content_sanskrit": "भारद्वाजेन भग्नेषु पाण्डवेषु महामृधे।\nपाञ्चालेषु च सर्वेषु कश्चिदन्योऽभ्यवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2049938, "chapter_id": 2095, "verse_number": "७-२२-२", "content_sanskrit": "आर्यां युद्धे मतिं कृत्वा क्षत्रियाणां यशस्करीम्।\nअसेवितां कापुरुषैः सेवितां पुरुषर्षभैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2049939, "chapter_id": 2095, "verse_number": "७-२२-३", "content_sanskrit": "स हि वीरोन्नतः शूरो यो भग्नेषु निवर्तते।\nअहो नासीत्पुमान्कश्चिद्दृष्ट्वा द्रोणं व्यवस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2049940, "chapter_id": 2095, "verse_number": "७-२२-४", "content_sanskrit": "जृम्भमाणमिव व्याघ्रं प्रभिन्नमिव कुञ्जरम्।\nत्यजन्तमाहवे प्राणान्सन्नद्धं चित्रयोधिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2049941, "chapter_id": 2095, "verse_number": "७-२२-५", "content_sanskrit": "महेष्वासं नरव्याघ्रं द्विषतां भयवर्धनम्।\nकृतज्ञं सत्यनिरतं दुर्योधनहितैषिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2049942, "chapter_id": 2095, "verse_number": "७-२२-६", "content_sanskrit": "भारद्वाजं तथाऽनीके दृष्ट्वा शूरमवस्थितम्।\nके शूराः सन्न्यवर्तन्त तन्ममाचक्ष्व सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2049943, "chapter_id": 2095, "verse_number": "७-२२-७x", "content_sanskrit": "सञ्चय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2049944, "chapter_id": 2095, "verse_number": "७-२२-७", "content_sanskrit": "तान्दृष्ट्वा चलितान्सङ्ख्ये प्रणुन्नान्द्रोणसायकैः।\nपाञ्चालान्पाण्वान्मात्स्यान्सृञ्जयांश्चेदिकेकयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2049945, "chapter_id": 2095, "verse_number": "७-२२-८", "content_sanskrit": "द्रोणचापविमुक्तेन शरौघेणाशु हारिणा।\nसिन्धोरिव महौधेन हियमाणान्यथा प्लवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2049946, "chapter_id": 2095, "verse_number": "७-२२-९", "content_sanskrit": "कौरवाः सिंहनादेन नानावाद्यस्वनेन च।\nरथद्विपनरांश्चैव सर्वतः समवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2049947, "chapter_id": 2095, "verse_number": "७-२२-१०", "content_sanskrit": "तान्पश्यन्सैन्यमध्यस्थो राजा स्वजनसम्वृतः।\nदुर्योधनोऽब्रवीत्कर्णं प्रहृष्टः प्रहसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2049948, "chapter_id": 2095, "verse_number": "७-२२-११x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2049949, "chapter_id": 2095, "verse_number": "७-२२-११", "content_sanskrit": "पश्य राधेय पाञ्चालान्प्रणुन्नान्द्रोणसायकैः।\nसिंहेनेव मृगान्वन्यांस्त्रासितान्दृढधन्वना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2049950, "chapter_id": 2095, "verse_number": "७-२२-१२", "content_sanskrit": "नैते जातु पुनर्युद्धमीहेयुरिति मे मतिः।\nयथा तु भग्ना द्रोणेन वातेनेव महाद्रुमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2049951, "chapter_id": 2095, "verse_number": "७-२२-१३", "content_sanskrit": "अर्द्यमानाः शरैरेते रुक्मपुङ्खैर्महात्मना।\nपथा नैकेन गच्छन्ति घूर्णमानास्ततस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2049952, "chapter_id": 2095, "verse_number": "७-२२-१४", "content_sanskrit": "सन्निरुद्धाश्च कौरव्यैर्द्रोणेन च महात्मना।\nएतेऽन्ये मण्डलीभूताः पावकेनेव कुञ्जराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2049953, "chapter_id": 2095, "verse_number": "७-२२-१५", "content_sanskrit": "भ्रमरैरिव चाविष्टा द्रोणस्य निशितैः शरैः।\nअन्योन्यं समलीयन्त पलायनपरायणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2049954, "chapter_id": 2095, "verse_number": "७-२२-१६", "content_sanskrit": "एष भीमो महाक्रोधी हीनः पाण्डवसृञ्जयैः।\nमदीयैरावृतो योधैः कर्ण नन्दयतीव माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2049955, "chapter_id": 2095, "verse_number": "७-२२-१७", "content_sanskrit": "व्यक्तं द्रोणमयं लोकमद्य पश्यति दुर्मतिः।\nनिराशो जीवितान्नूनमद्य राज्याच्च पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2049956, "chapter_id": 2095, "verse_number": "७-२२-१८x", "content_sanskrit": "कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2049957, "chapter_id": 2095, "verse_number": "७-२२-१८", "content_sanskrit": "नैष जातु महाबाहुर्जीवन्नाहवमुत्सृजेत्।\nन चेमान्पुरुषव्याघ्र सिंहनादान्सहिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2049958, "chapter_id": 2095, "verse_number": "७-२२-१९", "content_sanskrit": "न चापि पाण्डवा युद्धे भज्येरन्निति मे मतिः।\nशूराश्च बलवन्तश्च कृतास्त्रा युद्धदुर्मदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2049959, "chapter_id": 2095, "verse_number": "७-२२-२०", "content_sanskrit": "विषाग्निद्यूतसङ्क्लेशान्वनवासं च पाण्डवाः।\nस्मरमाणा न हास्यन्ति सङ्ग्राममिति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2049960, "chapter_id": 2095, "verse_number": "७-२२-२१", "content_sanskrit": "निवृत्तो हि महाबाहुरमितौजा वृकोदरः।\nवरान्वरान्हि कौन्तेयो रथोदारान्हनिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2049961, "chapter_id": 2095, "verse_number": "७-२२-२२", "content_sanskrit": "असिना धनुषा शक्या हयैर्नागैर्नरै स्थैः।\nआयसेन च दण्डेन व्रातान्व्रातान्हनिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2049962, "chapter_id": 2095, "verse_number": "७-२२-२३", "content_sanskrit": "तमेनमनुवर्तन्ते सात्यकिप्रमुखा रथाः।\nपाञ्चालाः केकया मास्त्याः पाश्डवाश्च विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2049963, "chapter_id": 2095, "verse_number": "७-२२-२४", "content_sanskrit": "शूराश्च बलवन्तश्च विक्रान्ताश्च महारथाः।\nविनिघ्नन्तश्च भीमेन संरब्धेनाभिचोदिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2049964, "chapter_id": 2095, "verse_number": "७-२२-२५", "content_sanskrit": "ते द्रोणमभिवर्तन्ते सर्वतः कुरुपुङ्गवाः।\nवृकोदरं परीप्सन्तः सूर्यमभ्रगणा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2049965, "chapter_id": 2095, "verse_number": "७-२२-२६", "content_sanskrit": "`समरेषु तु निर्दिष्टाः पाण्डवाः कृष्णबान्धवाः।\nपाञ्चालाः केकया मात्स्याः पाण्डवेयाश्च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2049966, "chapter_id": 2095, "verse_number": "७-२२-२७", "content_sanskrit": "शूराश्च बलवन्तश्च विक्रान्ताश्च महारथाः।\nहीमन्तः शत्रुमरणे निपुणाः पुण्यलक्षणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2049967, "chapter_id": 2095, "verse_number": "७-२२-२८", "content_sanskrit": "बहवः पार्थिवा राजंस्तेषां वशगता रणे।\nमावमंस्थाः पाण्डवांस्त्वं नारायणपुरोगमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2049968, "chapter_id": 2095, "verse_number": "७-२२-२९", "content_sanskrit": "एकायनगता ह्येते पीडयेयुर्यतव्रतम्।\nअरक्षमाणं शलभा यथा दीपं मुमूर्षवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2049969, "chapter_id": 2095, "verse_number": "७-२२-३०", "content_sanskrit": "असंशयं कृतास्त्राश्च पर्याप्ताश्चापि वारणे।\nअतिभारमहं मन्ये भारद्वाजे समाहितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2049970, "chapter_id": 2095, "verse_number": "७-२२-३१", "content_sanskrit": "ते शीघ्रमनुगच्छामो यत्र द्रोणो व्यवस्थितः।\nकोका इव महानागं मा वै हन्युर्यतव्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2049971, "chapter_id": 2095, "verse_number": "७-२२-३२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2049972, "chapter_id": 2095, "verse_number": "७-२२-३२", "content_sanskrit": "राधेयस्य वचः श्रुत्वा राजा दुर्योधनस्ततः।\nभ्रातृभिः सहितो राजन्प्रायाद्द्रोणरथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2049973, "chapter_id": 2095, "verse_number": "७-२२-३३", "content_sanskrit": "तत्रारावो महानासीदेकं द्रोणं जिघांसताम्।\nपाण्डवानां निवृत्तानां नानावर्णैर्हयोत्तमैः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2049974, "chapter_id": 2095, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि संशप्तकवधपर्वणि द्वादशदिवसयुद्धे द्वाविंशोऽध्यायः॥ २२ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-२२-१ अभ्यवर्तत किम्॥ ५-२२-३१ कोको वृकः॥ ५-२२-२२ द्वाविंशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]