[{"id": 7001371000, "chapter_id": 21371, "verse_number": "५-१८-१", "content_sanskrit": "सनत्कुमार उवाच ।\nवक्ष्येऽहं भारतं वर्षं हिमाद्रेश्चैव दक्षिणे ।\nउत्तरे तु समुद्रस्य भारती यत्र संसृतिः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001371001, "chapter_id": 21371, "verse_number": "५-१८-२", "content_sanskrit": "नवयोजनसाहस्रो विस्तारोऽस्य महामुने ।\nस्वर्गापवर्गयोः कर्मभूमिरेषा स्मृता बुधैः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001371002, "chapter_id": 21371, "verse_number": "५-१८-३", "content_sanskrit": "यतस्संप्राप्यते पुंभिस्स्वर्गो नरक एव च ।\nभारतस्यापि वर्षस्य नव भेदान्ब्रवीमि ते॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001371003, "chapter_id": 21371, "verse_number": "५-१८-४", "content_sanskrit": "इंद्रद्युम्नः कसेरुश्च ताम्रवर्णो गभस्तिमान् ।\nनागद्वीपस्तथा सौम्यो गन्धर्वस्त्वथ वारुणः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001371004, "chapter_id": 21371, "verse_number": "५-१८-५", "content_sanskrit": "अयं तु नवमस्तेषां द्वीपस्सागरसंभृतः ।\nयोजनानां सहस्रं तु द्वीपोऽयं दक्षिणोत्तरः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001371005, "chapter_id": 21371, "verse_number": "५-१८-६", "content_sanskrit": "पूर्वे किराता यस्य स्युर्दक्षिणे यवनाः स्थिताः ।\nपश्चिमे च तथा ज्ञेया उत्तरे हि तपस्विनः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001371006, "chapter_id": 21371, "verse_number": "५-१८-७", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्या मध्ये शूद्राश्च भूयशः ।\nइज्या युद्धपणा सेवा वर्तयन्तो व्यवस्थिताः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001371007, "chapter_id": 21371, "verse_number": "५-१८-८", "content_sanskrit": "महेंद्रो मलयस्सह्यः सुदामा चर्क्षपर्वतः ।\nविंध्यश्च पारियात्रश्च सप्तात्र कुलपर्वताः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001371008, "chapter_id": 21371, "verse_number": "५-१८-९", "content_sanskrit": "वेदस्मृतिपुराणाद्याः पारियात्रोद्भवा मुने ।\nसर्वपापहरा ज्ञेया दर्शनात्स्पर्शनादपि॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001371009, "chapter_id": 21371, "verse_number": "५-१८-१०", "content_sanskrit": "नर्मदा सुरसाद्याश्च सप्तान्याश्च सहस्रशः ।\nविंध्योद्भवा महानद्यस्सर्वपापहराश्शुभाः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001371010, "chapter_id": 21371, "verse_number": "५-१८-११", "content_sanskrit": "गोदावरी भीमरथी तापीप्रमुखनिम्नगाः ।\nगिरेर्विनिर्गता ऋक्षात्सद्यः पापभयापहाः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001371011, "chapter_id": 21371, "verse_number": "५-१८-१२", "content_sanskrit": "सह्यपादोद्भवा नद्यः कृष्णावेण्यादिकास्तथा ।\nकृतमाला ताम्रपर्णी प्रमुखा मलयोद्भवाः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001371012, "chapter_id": 21371, "verse_number": "५-१८-१३", "content_sanskrit": "त्रियामा चर्षिकुल्याद्या महेन्द्रप्रभवा स्मृताः ।\nऋषिकुल्या कुमार्य्याद्याः शुक्तिमत्पादसंभवाः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001371013, "chapter_id": 21371, "verse_number": "५-१८-१४", "content_sanskrit": "नानाजनपदास्तेषु मंडलेषु वसन्ति वै ।\nआसां पिबंति पानीयं सरत्सु विविधेषु च॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001371014, "chapter_id": 21371, "verse_number": "५-१८-१५", "content_sanskrit": "चत्वारि भारते वर्षे युगान्यासन्महामुने ।\nकृतादीनि न चान्येषु द्वीपेषु प्रभवंति हि॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001371015, "chapter_id": 21371, "verse_number": "५-१८-१६", "content_sanskrit": "दानानि चात्र दीयंते सुकृतैश्चात्र याज्ञिकैः ।\nतपस्तपंति यतयः परलोकार्थमादरात्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001371016, "chapter_id": 21371, "verse_number": "५-१८-१७", "content_sanskrit": "यतो हि कर्मभूरेषा जम्बूद्वीपे महामुने ।\nअत्रापि भारतं श्रेष्ठमतोऽन्या भोगभूमयः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001371017, "chapter_id": 21371, "verse_number": "५-१८-१८", "content_sanskrit": "कदाचिल्लभते मर्त्यस्सहस्रैर्मुनिसत्तम ।\nअत्र जन्मसहस्राणां मानुष्यं पुण्यसंचयैः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001371018, "chapter_id": 21371, "verse_number": "५-१८-१९", "content_sanskrit": "स्वर्गापवर्गास्पदमार्गभूते धन्यास्तु ते भारतभूमिभागे ।\nगायंति देवाः किल गीतकानि भवंति भूयः पुरुषास्सुरास्ते॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001371019, "chapter_id": 21371, "verse_number": "५-१८-२०", "content_sanskrit": "अवाप्य मानुष्यमयं कदाचिद्विहृत्य शंभोः परमात्मरूपे ।\nफलानि सर्वाणि तु कर्मजानि यास्याम्यहं तत्तनुतां हि तस्य॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001371020, "chapter_id": 21371, "verse_number": "५-१८-२१", "content_sanskrit": "आप्स्यंति धन्याः खलु ते मनुष्याः सुखैर्युताः कर्मणि सन्निविष्टाः ।\nजनुर्हि येषां खलु भारतेऽस्ति ते स्वर्गमोक्षोभयलाभवन्तः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001371021, "chapter_id": 21371, "verse_number": "५-१८-२२", "content_sanskrit": "लक्षयोजनविस्तारस्समस्तपरिमण्डलः ।\nजम्बूद्वीपो मया ख्यातः क्षारोदधिसुसंवृतः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001371022, "chapter_id": 21371, "verse_number": "५-१८-२३", "content_sanskrit": "संवेष्ट्य क्षारमुदधिं शतसाहस्रसम्मितम् ।\nततो हि द्विगुणो ब्रह्मन्प्लक्षद्वीपः प्रकीर्तितः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001371023, "chapter_id": 21371, "verse_number": "५-१८-२४", "content_sanskrit": "गोमंतश्चैव चन्द्रश्च नारदो दर्दुरस्तथा ।\nसोमकस्सुमनाश्शैलो वैभ्राजश्चैव सत्तमः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001371024, "chapter_id": 21371, "verse_number": "५-१८-२५", "content_sanskrit": "वर्षाचलेषु रम्येषु सहितास्सततं प्रजाः ।\nवसंति देवगंधर्वा वर्षेष्वेतेषु नित्यशः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001371025, "chapter_id": 21371, "verse_number": "५-१८-२६", "content_sanskrit": "नाधयो व्याधयो वापि जनानां तत्र कुत्रचित् ।\nदश वर्षसहस्राणि तत्र जीवंति मानवाः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001371026, "chapter_id": 21371, "verse_number": "५-१८-२७", "content_sanskrit": "अनुतप्ता शिखी चैव पापघ्नी त्रिदिवा कृपा ।\nअमृता सुकृता चैव सप्तैवात्र च निम्नगाः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001371027, "chapter_id": 21371, "verse_number": "५-१८-२८", "content_sanskrit": "क्षुद्रनद्यस्तथा शैलास्तत्र संति सहस्रशः ।\nताः पिबंति सुसंहृष्टा नदीर्जनपदास्तु ते॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001371028, "chapter_id": 21371, "verse_number": "५-१८-२९", "content_sanskrit": "न तत्रापि युगावस्था यथास्थानेषु सप्तसु ।\nत्रेतायुगसमः कालस्सर्वदैव महामुने॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001371029, "chapter_id": 21371, "verse_number": "५-१८-३०", "content_sanskrit": "विप्रक्षत्रियवैश्यास्ते शूद्राश्च मुनिसत्तम॥  ।\nकल्पवृक्षसमानस्तु तन्मध्ये सुमहातरुः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001371030, "chapter_id": 21371, "verse_number": "५-१८-३१", "content_sanskrit": "प्लक्षस्तन्नामसंज्ञो वै प्लक्षद्वीपो द्विजोत्तम ।\nइज्यते तत्र भगवाञ्छंकरो लोकशंकरः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001371031, "chapter_id": 21371, "verse_number": "५-१८-३२", "content_sanskrit": "हरिश्च भगवान्ब्रह्मा यन्त्रैर्मन्त्रैश्च वैदिकैः ।\nसंक्षेपेण तथा भूयश्शाल्मलिं त्वं निशामय॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001371032, "chapter_id": 21371, "verse_number": "५-१८-३३", "content_sanskrit": "सप्तवर्षाणि तत्रैव तेषां नामानि मे शृणु ।\nश्वेतोऽथ हरितश्चैव जीमूतो रोहितस्तथा॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001371033, "chapter_id": 21371, "verse_number": "५-१८-३४", "content_sanskrit": "वैकलो मानसश्चैव सुप्रभस्सप्तमो मुने ।\nशाल्मलेन तु वृक्षेण द्वीपः शाल्मलिसंज्ञकः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001371034, "chapter_id": 21371, "verse_number": "५-१८-३५", "content_sanskrit": "द्विगुणेन समुद्रेण सततं संवृतः स्थितः ।\nवर्षाभिव्यंजका नद्यस्तासां नामानि मे शृणु॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001371035, "chapter_id": 21371, "verse_number": "५-१८-३६", "content_sanskrit": "शुक्ला रक्ता हिरण्या च चन्द्रा शुभ्रा विमोचना ।\nनिवृत्तिः सप्तमी तासां पुण्यतोया सुशीतलाः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001371036, "chapter_id": 21371, "verse_number": "५-१८-३७", "content_sanskrit": "सप्तैव तानि वर्षाणि चतुर्वर्णायुतानि च ।\nभगवन्तं सदा शंभुं यजंते विविधैर्मखैः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001371037, "chapter_id": 21371, "verse_number": "५-१८-३८", "content_sanskrit": "देवानां तत्र सान्निध्यमतीव सुमनोरमे ।\nएष द्वीपस्समुद्रेण सुरोदेन समावृतः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001371038, "chapter_id": 21371, "verse_number": "५-१८-३९", "content_sanskrit": "द्विगुणेन कुशद्वीपः समंताद्बाह्यतः स्थितः ।\nवसंति तत्र दैतेया मनुजैस्सह दानवाः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001371039, "chapter_id": 21371, "verse_number": "५-१८-४०", "content_sanskrit": "तथैव देवगन्धर्वा यक्षाः किंपुरुषादयः ।\nवर्णास्तत्रैव चत्वारो निजानुष्ठानतत्पराः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001371040, "chapter_id": 21371, "verse_number": "५-१८-४१", "content_sanskrit": "तत्रैव च कुशद्वीपे ब्रह्माणं च जनार्द्दनम् ।\nयजंति च तथेशानं सर्वकामफलप्रदम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001371041, "chapter_id": 21371, "verse_number": "५-१८-४२", "content_sanskrit": "कुशेशयो हरिश्चैव द्युतिमान्पुष्पवांस्तथा ।\nमणिद्रुमो हेमशैलस्सप्तमो मन्दराचलः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001371042, "chapter_id": 21371, "verse_number": "५-१८-४३", "content_sanskrit": "नद्यश्च सप्त तासां तु नामानि शृणु तत्त्वतः ।\nधूतपापा शिवा चैव पवित्रा संमितिस्तथा॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001371043, "chapter_id": 21371, "verse_number": "५-१८-४४", "content_sanskrit": "विद्या दंभा मही चान्या सर्वपापहरास्त्विमाः ।\nअन्यास्सहस्रशस्संति शुभापो हेमवालुकाः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001371044, "chapter_id": 21371, "verse_number": "५-१८-४५", "content_sanskrit": "कुशद्वीपे कुशस्तम्बो घृतोदेन समावृतः ।\nक्रौञ्चद्वीपो महाभाग श्रूयतां चापरो महान्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001371045, "chapter_id": 21371, "verse_number": "५-१८-४६", "content_sanskrit": "द्विगुणेन समुद्रेण दधिमंडेन चावृतः ।\nवर्षाचला महाबुद्धे तेषां नामानि मे शृणु॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001371046, "chapter_id": 21371, "verse_number": "५-१८-४७", "content_sanskrit": "क्रौञ्चश्च वामनश्चैव तृतीयश्चांधकारकः ।\nदिवावृतिर्मनश्चैव पुण्डरीकश्च दुन्दुभिः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001371047, "chapter_id": 21371, "verse_number": "५-१८-४८", "content_sanskrit": "निवसंति निरातंका वर्षशैलेषु तेषु वै ।\nसर्वसौवर्णरम्येषु सुहृद्देवगणैः प्रजाः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001371048, "chapter_id": 21371, "verse_number": "५-१८-४९", "content_sanskrit": "ब्राह्मणाः क्षत्त्रिया वैश्याश्शूद्राश्चानुक्रमोदिताः ।\nसंति तत्र महानद्यस्सप्तान्यास्तु सहस्रशः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001371049, "chapter_id": 21371, "verse_number": "५-१८-५०", "content_sanskrit": "गौरी कुमुद्वती चैव सन्ध्या रात्रिर्मनोजवा ।\nशांतिश्च पुंडरीका च याः पिबन्ति पयश्शुभम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001371050, "chapter_id": 21371, "verse_number": "५-१८-५१", "content_sanskrit": "भगवान्पूज्यते तत्र योगरुद्रस्वरूपवान् ।\nदधिमण्डोदकश्चापि शाकद्वीपेन संवृतः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001371051, "chapter_id": 21371, "verse_number": "५-१८-५२", "content_sanskrit": "द्विगुणेनाद्रयस्सप्त तेषां नामानि मे शृणु ।\nपूर्वे तत्रोदयगिरिर्जलधारः परे यतः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001371052, "chapter_id": 21371, "verse_number": "५-१८-५३", "content_sanskrit": "पृष्ठतोऽस्तगिरिश्चैव ह्यविकेशश्च केसरी ।\nशाकस्तत्र महावृक्षस्सिद्धगंधर्वसेवितः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001371053, "chapter_id": 21371, "verse_number": "५-१८-५४", "content_sanskrit": "तत्र पुण्या जनपदाश्चातुर्वर्ण्यसमन्विताः ।\nनद्यश्चात्र महापुण्यास्सर्वपापभयापहाः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001371054, "chapter_id": 21371, "verse_number": "५-१८-५५", "content_sanskrit": "सुकुमारी कुमारी च नलिनी वेणुका तथा ।\nइक्षुश्च रेणुका चैव गभस्तिस्सप्तमी तथा॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001371055, "chapter_id": 21371, "verse_number": "५-१८-५६", "content_sanskrit": "अन्यास्सहस्रशस्तत्र क्षुद्रनद्यो महामुने ।\nमहीधरास्तथा संति शतशोऽथ सहस्रशः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001371056, "chapter_id": 21371, "verse_number": "५-१८-५७", "content_sanskrit": "धर्महानिर्न तेष्वस्ति स्वर्गादागत्य मानवाः ।\nवर्षेषु तेषु पृथिवीं विहरन्ति परस्परम्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001371057, "chapter_id": 21371, "verse_number": "५-१८-५८", "content_sanskrit": "शाकद्वीपे तु वै सूर्य्यः प्रीत्या जनपदैस्सदा ।\nयथोक्तैरिज्यते सम्यक्कर्मभिर्नियतात्मभिः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001371058, "chapter_id": 21371, "verse_number": "५-१८-५९", "content_sanskrit": "क्षीरोदेनावृतस्सोऽपि द्विगुणेन समंततः ।\nक्षीराब्धिस्सर्वतो व्यास पुष्कराख्येन संवृतः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001371059, "chapter_id": 21371, "verse_number": "५-१८-६०", "content_sanskrit": "द्विगुणेन महावर्षस्तत्र ख्यातोऽत्र मानसः ।\nयोजनानां सहस्राणि पंचैवोर्ध्वसमुच्छ्रितः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001371060, "chapter_id": 21371, "verse_number": "५-१८-६१", "content_sanskrit": "तानि चैव तु लक्षाणि सर्वतो वलयाकृति ।\nपुष्करद्वीपवलयो मध्येन विभजंति च॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001371061, "chapter_id": 21371, "verse_number": "५-१८-६२", "content_sanskrit": "तेनैव वलया कारा द्वीपवर्षसमाकृतिः ।\nदशवर्षसहस्राणि तत्र जीवंति मानवाः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001371062, "chapter_id": 21371, "verse_number": "५-१८-६३", "content_sanskrit": "निरामया वीतशोका रागद्वेषविवर्जिताः ।\nअधर्मो न मतस्तेषां न बंधवधकौ मुने॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001371063, "chapter_id": 21371, "verse_number": "५-१८-६४", "content_sanskrit": "सत्यानृते न तस्यास्तां सदैव वसतिस्सदा ।\nतुल्यवेषास्तु मनुजा हेमवर्णैकरूपिणः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001371064, "chapter_id": 21371, "verse_number": "५-१८-६५", "content_sanskrit": "वर्षश्चायं तु कालेय भौम स्वर्गोपमो मतः ।\nसर्वस्य सुखदः काले जरारोगविवर्जितः॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001371065, "chapter_id": 21371, "verse_number": "५-१८-६६", "content_sanskrit": "पुष्करे धातकीखण्डे महावीते महामुने॥  ।\nन्यग्रोधं पुष्करद्वीपे ब्रह्मणः स्थानमुत्तमम्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001371066, "chapter_id": 21371, "verse_number": "५-१८-६७", "content_sanskrit": "तस्मिन्निवसते ब्रह्मा पूज्यमानस्सुरासुरैः ।\nस्वादूदकेनांबुधिना पुष्करः परिवेष्टितः॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001371067, "chapter_id": 21371, "verse_number": "५-१८-६८", "content_sanskrit": "एवं द्वीपास्समुद्रैस्तु सप्त सप्तभिरावृताः ।\nद्वीपाश्चैव समुद्राश्च समाना द्विगुणैः परैः॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001371068, "chapter_id": 21371, "verse_number": "५-१८-६९", "content_sanskrit": "उक्तातिरिक्तता तेषां समुद्रेषु समानि वै ।\nपयांसि सर्वदाऽल्पत्वं जायते न कदाचन॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001371069, "chapter_id": 21371, "verse_number": "५-१८-७०", "content_sanskrit": "स्थालीस्थमग्निसंयोगादधःस्थं मुनिसत्तमः ।\nतथेन्दुवृद्धौ सलिलमूर्द्ध्वगं भवति ध्रुवम्॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001371070, "chapter_id": 21371, "verse_number": "५-१८-७१", "content_sanskrit": "उदयास्तमनेत्विंदोर्वर्द्धंत्यापो ह्रसन्ति च ।\nअतो न्यूनातिरिक्ताश्च पक्षयोः शुक्लकृष्णयोः॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001371071, "chapter_id": 21371, "verse_number": "५-१८-७२", "content_sanskrit": "अपां वृद्धिक्षयौ दृष्टौ शतशस्तु दशोत्तरम् ।\nसमुद्राणां मुनिश्रेष्ठो सर्वेषां कथितं तव॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001371072, "chapter_id": 21371, "verse_number": "५-१८-७३", "content_sanskrit": "भोजनं पुष्करद्वीपे प्रजास्सर्वाः सदैव हि ।\nखंडस्य कुर्वते विप्र तत्र स्वयमुपस्थितम्॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001371073, "chapter_id": 21371, "verse_number": "५-१८-७४", "content_sanskrit": "स्वांगदो यस्य पुरतो नास्ति लोकस्य संस्थितिः ।\nद्विगुणा हिरण्मयी भूमिस्सर्वजंतुविवर्जिता॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001371074, "chapter_id": 21371, "verse_number": "५-१८-७५", "content_sanskrit": "लोकालोकस्ततश्शैलस्सहस्राण्यचलो हि सः ।\nउच्छ्रयेण हि तावंति योजनायुतविस्तृतः॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001371075, "chapter_id": 21371, "verse_number": "५-१८-७६", "content_sanskrit": "तमश्चांडकटाहेन सेयमुर्वी महामुने ।\nपंचाशत्कोटिविस्तारा सद्वीपा समहीधरा॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001371076, "chapter_id": 21371, "verse_number": "५-१८-७७", "content_sanskrit": "आधारभूता सर्वेषां सर्वभूतगुणाधिका ।\nसेयं धात्री च कालेय सर्वेषां जगतामिला॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}]