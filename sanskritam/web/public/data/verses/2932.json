[{"id": 2090886, "chapter_id": 2932, "verse_number": "१३-६२-१", "content_sanskrit": "युधिष्ठिर उवाच।\nपित्र्यं वाऽप्यथवा दैवं दीयते यत्पितामह।\nएतदिच्छाम्यहं ज्ञातुं दत्तं केषु महाफलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2090887, "chapter_id": 2932, "verse_number": "१३-६२-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2090888, "chapter_id": 2932, "verse_number": "१३-६२-२", "content_sanskrit": "येषां दाराः प्रतीक्षन्ते सुवृष्टिमिव कर्षकाः।\nउच्छेषपरिशेषं हि तान्भोजय युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2090889, "chapter_id": 2932, "verse_number": "१३-६२-३", "content_sanskrit": "चारित्रनिरता राजन्ये कृशाः कृशवृत्तयः॥\nअर्थिनश्चोपगच्छन्ति तेषु दत्तं महाफलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2090890, "chapter_id": 2932, "verse_number": "१३-६२-४", "content_sanskrit": "तद्भक्तास्तद्गृहा राजंस्तद्बलास्तदपाश्रयाः।\nअर्थिनश्च भवन्त्यर्थे तेषु दत्तं महाफलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2090891, "chapter_id": 2932, "verse_number": "१३-६२-५", "content_sanskrit": "तस्करेभ्यः परेभ्यो वा हृतस्वा भयदुःखिताः।\nअर्थिनो भोक्तुमिच्छन्ति तेषु दत्तं महाफलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2090892, "chapter_id": 2932, "verse_number": "१३-६२-६", "content_sanskrit": "अकल्ककस्य विप्रस्य रौक्ष्यात्करकृतात्मनः।\nवटवो यस्य भिक्षन्ति तेभ्यो दत्तं महाफलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2090893, "chapter_id": 2932, "verse_number": "१३-६२-७", "content_sanskrit": "हृतस्वा हृतदाराश्च ये विप्रा देशसम्प्लवे।\nअर्थार्थमभिगच्छन्ति तेभ्यो दत्तं महाफलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2090894, "chapter_id": 2932, "verse_number": "१३-६२-८", "content_sanskrit": "व्रतोनो नियमस्थाश्च ये विप्राः श्रुतसम्मताः।\nतस्मपाप्त्यर्थमिच्छन्ति तेभ्यो दत्तं महाफलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2090895, "chapter_id": 2932, "verse_number": "१३-६२-९", "content_sanskrit": "अत्युत्क्रान्ताश्च धर्मेषु पाषण्डस्रमयेषु च।\nकृशप्राणाः कृशघनास्तेभ्यो दत्तं महाफलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2090896, "chapter_id": 2932, "verse_number": "१३-६२-१०", "content_sanskrit": "कृतसर्वस्वहरणा निर्दोषाः प्रभविष्णुभिः।\nस्पृहयन्ति च भुक्त्वाऽन्नं तेषुदत्तं महाफलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2090897, "chapter_id": 2932, "verse_number": "१३-६२-११", "content_sanskrit": "तपस्विनस्तपोनिष्ठास्तेषां भैक्षचराश्च ये।\nअर्थिनः किञ्चिदिच्छन्ति तेषु दत्तं महाफलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2090898, "chapter_id": 2932, "verse_number": "१३-६२-१२", "content_sanskrit": "महाफलविधिर्दाने श्रुतस्ते भरतर्षभ।\nनिरयं येन गच्छन्ति स्वर्गं चैव हि तत्छृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2090899, "chapter_id": 2932, "verse_number": "१३-६२-१३", "content_sanskrit": "`व्रतानां पारणार्थाय गुर्वर्थे यज्ञदक्षिणाम्।\nनिर्वेशार्थं च विद्वांसस्तेषां दत्तं महाफलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2090900, "chapter_id": 2932, "verse_number": "१३-६२-१४", "content_sanskrit": "पित्रोश्च रक्षणार्थाय पुत्रदारार्थमेव वा।\nमहाव्याधिविमोक्षार्थं तेषु दत्तं महाफलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2090901, "chapter_id": 2932, "verse_number": "१३-६२-१५", "content_sanskrit": "बालाः स्त्रियश्च वाञ्छन्ति सुभक्तं चाप्यसाधनाः।\nस्वर्गमायान्ति दत्त्वैषां निरयान्नोपयान्ति ते॥॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2090902, "chapter_id": 2932, "verse_number": "१३-६२-१६", "content_sanskrit": "गुर्वर्थमभयार्थं वा वर्जयित्वा युधिष्ठिर।\nयेऽनृतं कथयन्ति स्म ते वा निरयगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2090903, "chapter_id": 2932, "verse_number": "१३-६२-१७", "content_sanskrit": "परदाराभिहर्तारः परदाराभिमर्शिनः।\nपरदारप्रयोक्तास्ते वै निरयगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2090904, "chapter_id": 2932, "verse_number": "१३-६२-१८", "content_sanskrit": "ये परस्वापहर्तारः परस्वानां च नाशकाः।\nसूचकाश्च परेषां ये ते वा निरयगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2090905, "chapter_id": 2932, "verse_number": "१३-६२-१९", "content_sanskrit": "प्रपाणां च सभानां च संक्रमाणां च भारत।\nअगाराणां च भेत्तारो नरा निरयगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2090906, "chapter_id": 2932, "verse_number": "१३-६२-२०", "content_sanskrit": "अनाथां प्रमदां बालां वृद्धां भीतां तपस्विनीम्।\nवञ्चयन्ति नरा ये च ते वै निरयगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2090907, "chapter_id": 2932, "verse_number": "१३-६२-२१", "content_sanskrit": "वृत्तिच्छेदं गृहच्छेदं दारच्छेदं च भारत।\nमित्रच्छेदं तथाऽऽशायास्ते वै निरयगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2090908, "chapter_id": 2932, "verse_number": "१३-६२-२२", "content_sanskrit": "सूचकाः सेतुभेत्तारः परवृत्त्युपजीवकाः।\nअकृतज्ञाश्च मित्राणां ते वै निरयगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2090909, "chapter_id": 2932, "verse_number": "१३-६२-२३", "content_sanskrit": "पाषण्डा दूषकाश्चैव समयानां च दूषकाः।\nये प्रत्यवसिताश्चैव ते वै निरयगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2090910, "chapter_id": 2932, "verse_number": "१३-६२-२४", "content_sanskrit": "विषमव्यवहाराश्च विषमाश्चैव वृद्धिषु।\nलाभेषु विषमाश्चैव ते वै निरयगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2090911, "chapter_id": 2932, "verse_number": "१३-६२-२५", "content_sanskrit": "दूतसंव्यवहाराश्च निष्परीक्षाश्च मानवाः।\nप्राणिहिंसाप्रवृत्ताश्चि ते वै निरयगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2090912, "chapter_id": 2932, "verse_number": "१३-६२-२६", "content_sanskrit": "कृताशं कृतनिर्देशं कृतभक्तं कृतश्रमम्।\nभेदैर्ये व्यपकर्षन्ति ते वै निरयगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2090913, "chapter_id": 2932, "verse_number": "१३-६२-२७", "content_sanskrit": "पर्यश्नन्ति च ये दारानग्निभृत्यातिथींस्तथा।\nउत्सन्नपितृदेवेज्यास्ते वै निरयगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2090914, "chapter_id": 2932, "verse_number": "१३-६२-२८", "content_sanskrit": "वेदविक्रयिणश्चैव वेदानां चैव दूषकाः।\nवेदानां लेखकाश्चैव ते वै निरयगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2090915, "chapter_id": 2932, "verse_number": "१३-६२-२९", "content_sanskrit": "चातुराश्रम्यबाह्याश्च श्रुतिबाह्याश्च ये नराः।\nविकर्मभिश्च जीवन्ति ते वै निरयगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2090916, "chapter_id": 2932, "verse_number": "१३-६२-३०", "content_sanskrit": "केशविक्रयिका राजन्विषविक्रयिकाश्च ये।\nक्षीरविक्रयिकाश्चैव ते वै निरयगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2090917, "chapter_id": 2932, "verse_number": "१३-६२-३१", "content_sanskrit": "ब्राह्मणानां गवां चैव कन्यानां च युधिष्ठिर।\nयेऽन्तरायान्ति कार्येषु ते वै निरयगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2090918, "chapter_id": 2932, "verse_number": "१३-६२-३२", "content_sanskrit": "शस्त्रविक्रयिकाश्चैव कर्तारश्च युधिष्ठिर।\nशल्यानां धनुषां चैव ते वै निरयगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2090919, "chapter_id": 2932, "verse_number": "१३-६२-३३", "content_sanskrit": "शिलाभिः शङ्कुभिर्वाऽपि श्वर्भ्रैर्वा भरतर्षभ।\nये मार्गमनुरुन्धन्ति ते वै निरयगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2090920, "chapter_id": 2932, "verse_number": "१३-६२-३४", "content_sanskrit": "उपाध्यायांश्च भृत्यांश्च भक्तांश्च भरतर्षभ।\nये त्यजन्त्यविकारांस्त्रींस्ते वै निरयगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2090921, "chapter_id": 2932, "verse_number": "१३-६२-३५", "content_sanskrit": "अप्राप्तदमकाश्चैव नासानां वेधकाश्च ये।\nबन्धकाश्च पशूनां ये ते वै निरयगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2090922, "chapter_id": 2932, "verse_number": "१३-६२-३६", "content_sanskrit": "अगोप्तारश्च राजानो बलिषड्भागतस्कराः।\nसमर्थाश्चाप्यदातारस्ते वै निरयगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2090923, "chapter_id": 2932, "verse_number": "१३-६२-३७", "content_sanskrit": "क्षान्तान्दान्तांस्तथा प्राज्ञान्दीर्घकालं सहोषितान्।\nत्यजन्ति कृतकृत्या ये ते वै निरयगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2090924, "chapter_id": 2932, "verse_number": "१३-६२-३८", "content_sanskrit": "बालानामथ वृद्धानां दासानां चैव ये नराः।\nअदत्त्वा भक्षयन्त्यग्रे ते वै निरयगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2090925, "chapter_id": 2932, "verse_number": "१३-६२-३९", "content_sanskrit": "एते पूर्वं विनिर्दिष्टाः प्रोक्ता निरयगामिनः।\nभागिनः स्वर्गलोकस्य वक्ष्यामि भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2090926, "chapter_id": 2932, "verse_number": "१३-६२-४०", "content_sanskrit": "सर्वेष्वेव तु कार्येषु दैवपूर्वेषु भारत।\nहन्ति पुत्रान्पशून्कृत्स्नान्ब्राह्मणातिक्रमः कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2090927, "chapter_id": 2932, "verse_number": "१३-६२-४१", "content_sanskrit": "दानेन तपसा चैव सत्येन च युधिष्ठिर।\nये धर्ममनुवर्तन्ते ते नराः स्वर्गगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2090928, "chapter_id": 2932, "verse_number": "१३-६२-४२", "content_sanskrit": "शुश्रूषाभिस्तपोभिश्च विद्यामादाय भारत।\nये प्रतिग्रहनिःस्नेहास्ते नराः स्वर्गगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2090929, "chapter_id": 2932, "verse_number": "१३-६२-४३", "content_sanskrit": "भयात्पाषात्तथा बाधाद्दारिद्र्याद्व्याधिधर्षणात्।\nतत्कृते धनमीप्सन्ते ते नराः स्वर्गगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2090930, "chapter_id": 2932, "verse_number": "१३-६२-४४", "content_sanskrit": "क्षमावन्तश्च धीराश्च धर्मकार्येषु चोत्थिताः।\nमङ्गलाचारसम्पन्नाः पुरुषाः स्वर्गगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2090931, "chapter_id": 2932, "verse_number": "१३-६२-४५", "content_sanskrit": "निवृत्ता मधुमांसेभ्यः परदारेभ्य एव च।\nनिवृत्ताश्चैव मद्येभ्यस्ते नराः स्वर्गगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2090932, "chapter_id": 2932, "verse_number": "१३-६२-४६", "content_sanskrit": "आश्रमाणां च कर्तारः कुलानां चैव भारत।\nदेशानां नगराणां च ते नराः स्वर्गगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2090933, "chapter_id": 2932, "verse_number": "१३-६२-४७", "content_sanskrit": "वस्त्राभरणदातारो भक्ष्यपानान्नदास्तथा।\nकुटुम्बानां च भर्तारः पुरुषाः स्वर्गगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2090934, "chapter_id": 2932, "verse_number": "१३-६२-४८", "content_sanskrit": "सर्वहिंसानिवृत्ताश्च नराः सर्वसहाश्च ये।\nसर्वस्याश्रयभूताश्च ते नराः स्वर्गगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2090935, "chapter_id": 2932, "verse_number": "१३-६२-४९", "content_sanskrit": "मातरं पितरं चैव शुश्रुषन्ति जितेन्द्रियाः।\nभ्रातॄणां चैव सस्नेहास्ते नराः स्वर्गगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2090936, "chapter_id": 2932, "verse_number": "१३-६२-५०", "content_sanskrit": "आढ्याश्च बलवन्तश्च यौवनस्थाश्च भारत।\nये वै जितेन्द्रिया धीरास्ते नराः स्वर्गगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2090937, "chapter_id": 2932, "verse_number": "१३-६२-५१", "content_sanskrit": "अपराधिषु सस्नेहा मृदवो मृदुवत्सलाः।\nआराधनसुखाश्चापि पुरुषाः स्वर्गगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2090938, "chapter_id": 2932, "verse_number": "१३-६२-५२", "content_sanskrit": "सहस्रपरिवेष्टारस्तथैव च सहस्रदाः।\nत्रातारश्च सहस्राणां ते नराः स्वर्गगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2090939, "chapter_id": 2932, "verse_number": "१३-६२-५३", "content_sanskrit": "सुवर्णस्य च दातारो गवां च भरतर्षभ।\nयानानां वाहनानां च ते नराः स्वर्गगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2090940, "chapter_id": 2932, "verse_number": "१३-६२-५४", "content_sanskrit": "वैवाहिकानां द्रव्याणां प्रेष्याणां च युधिष्ठिर।\nदातारो वाससां चैव ते नराः स्वर्गगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2090941, "chapter_id": 2932, "verse_number": "१३-६२-५५", "content_sanskrit": "विहारावसथोद्यानकूपारामसभाप्रपा।\nवप्राणां चैव कर्तारस्ते नराः स्वर्गगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2090942, "chapter_id": 2932, "verse_number": "१३-६२-५६", "content_sanskrit": "निवेशनानां क्षेत्राणां वसतीनां च भारत।\nदातारः प्रार्थितानां च ते नराः स्वर्गगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2090943, "chapter_id": 2932, "verse_number": "१३-६२-५७", "content_sanskrit": "रसानां चाथ बीजानां धान्यानां च युधिष्ठिर।\nस्वयमुत्पाद्य दातारः पुरुषाः स्वर्गगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2090944, "chapter_id": 2932, "verse_number": "१३-६२-५८", "content_sanskrit": "यस्मिंस्तस्मिन्कुले जाता बहुपुत्राः शतायुषः।\nसानुक्रोशा जितक्रोधाः पुरुषाः स्वर्गगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2090945, "chapter_id": 2932, "verse_number": "१३-६२-५९", "content_sanskrit": "एतदुक्तममुत्रार्थं दैवं पित्र्यं च भारत।\nदानधर्मं च दानस्य यत्पूर्वमृषितिः कृतम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2090946, "chapter_id": 2932, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि द्विषष्टितमोऽध्यायः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]