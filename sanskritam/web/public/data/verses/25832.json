[{"id": 7005832000, "chapter_id": 25832, "verse_number": "१-१५-१", "content_sanskrit": "रुद्र उवाच ।\nसंसारसागराद्धोरान्मुच्यते किं जपन्प्रभो ।\nनरस्तन्मे परं जप्यं कथय त्वं जनार्द्दन ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005832001, "chapter_id": 25832, "verse_number": "१-१५-२", "content_sanskrit": "हरिरुवाच ।\nपरेश्वरं परं ब्रह्म परमात्मानमव्ययम् ।\nविष्णुं नामसहस्त्रेण स्तुवन्मुक्तो भवेन्नरः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005832002, "chapter_id": 25832, "verse_number": "१-१५-३", "content_sanskrit": "यत्पवित्रं परं जप्यं कथयामि वृषध्वज!।\nश्रृणुष्वावहितो भूत्वा सर्वपापविनाशनम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005832003, "chapter_id": 25832, "verse_number": "१-१५-४", "content_sanskrit": "ॐ वासुदेवो महाविष्णुर्वामनो वासवो वसुः ।\nबालचन्द्र निभो बालो बलभद्रो बलाधिपः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005832004, "chapter_id": 25832, "verse_number": "१-१५-५", "content_sanskrit": "बलिबन्धनकृद्वेधा वरेण्यो वेदवित्किविः ।\nवेदकर्त्ता वेदरूपो वेद्यो वेदपरिप्लुतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005832005, "chapter_id": 25832, "verse_number": "१-१५-६", "content_sanskrit": "वेदाङ्गवेत्ता वेदेशो बलाधारो बलार्दन।\nअविकारो वरेशश्च वरुणो वरुणाधिपः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005832006, "chapter_id": 25832, "verse_number": "१-१५-७", "content_sanskrit": "वीरहा च बृहद्वीरो वन्दितः परमेश्वरः ।\nआत्मा च परमात्मा च प्रत्यगात्मा वियत्परः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005832007, "chapter_id": 25832, "verse_number": "१-१५-८", "content_sanskrit": "पद्मनाभः पद्मनिधिः पद्महस्तो गदाधरः।\nपरमः परभूतश्च पुरुषोत्तम ईश्वरः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005832008, "chapter_id": 25832, "verse_number": "१-१५-९", "content_sanskrit": "पद्मजङ्घः पुण्डरीकः पद्ममालाधरः प्रियः ।\nपद्माक्षः पद्मगर्भश्च पर्जन्यः पद्मसंस्थितः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005832009, "chapter_id": 25832, "verse_number": "१-१५-१०", "content_sanskrit": "अपारः परमार्थश्च पराणां च परः प्रभुः ।\nपण्डितः पण्डितेड्यश्च पवित्रः पापमर्दकः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005832010, "chapter_id": 25832, "verse_number": "१-१५-११", "content_sanskrit": "शुद्धः प्रकाशरूपश्च पवित्रः परिरक्षकः ।\nपिपासावर्जितः पाद्यः पुरुषः प्रकृतिस्तथाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005832011, "chapter_id": 25832, "verse_number": "१-१५-१२", "content_sanskrit": "प्रधानं पृथिवीपद्मं पद्मनाभः प्रियप्रदः ।\nसर्वेशः सर्वगः सर्वः सर्ववित्सर्वदः सुरः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005832012, "chapter_id": 25832, "verse_number": "१-१५-१३", "content_sanskrit": "सर्वस्य जगतो धाम सर्वदर्शो च सर्भत्।\nसर्वानुग्रहकृद्देवः सर्वभूतहृदि स्थितः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005832013, "chapter_id": 25832, "verse_number": "१-१५-१४", "content_sanskrit": "सर्वपूज्यश्च सर्वाद्यः सर्वदेवनमस्कृतः ।\nसर्वस्य जगतो मूलं सकलो निष्कलोऽनलः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005832014, "chapter_id": 25832, "verse_number": "१-१५-१५", "content_sanskrit": "सर्वगोप्ता सर्वनिष्ठः सर्वकारणकारणम् ।\nसर्वध्येयः सर्वमित्रः सर्वदेस्ववरूपधृक् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005832015, "chapter_id": 25832, "verse_number": "१-१५-१६", "content_sanskrit": "सर्वाध्यक्षः सुराऽध्यक्ष सुरासुरनमस्कृतः ।\nदुष्टानां च सुराणां च सर्वदा घातकोऽन्तकः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005832016, "chapter_id": 25832, "verse_number": "१-१५-१७", "content_sanskrit": "सत्यपालश्च सन्नाभः सिद्धेशः सिद्धवन्दितः ।\nसिद्धसाध्यः सिद्धसिद्धः साध्यसिद्धो (सिद्धिसिद्ध) हृदीश्वरः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005832017, "chapter_id": 25832, "verse_number": "१-१५-१८", "content_sanskrit": "शरणं जगतश्चैव श्रेयः क्षेमस्तथैव च ।\nशुभकृच्छोभनः सौम्यः सत्यः सत्यपराक्रमः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005832018, "chapter_id": 25832, "verse_number": "१-१५-१९", "content_sanskrit": "सत्यस्थः सत्यसङ्कल्पः सत्यवित्सत्य (त्प) दसथ।\nधर्मो धर्म्मी च कर्मी च सर्वकर्म्मविवर्जितः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005832019, "chapter_id": 25832, "verse_number": "१-१५-२०", "content_sanskrit": "कर्म्मकर्त्ता च कर्मैव क्रिया कार्य्यं तथ च।\nश्रीपतिर्नृपतिः श्रीमान्सर्वस्य पतिरूर्जितः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005832020, "chapter_id": 25832, "verse_number": "१-१५-२१", "content_sanskrit": "सदेवानां पतिश्चैव वृष्णीनां पतिरीडितः ।\nपतिर्हिरण्यगर्भस्य त्रिपुरान्तपतिस्तथा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005832021, "chapter_id": 25832, "verse_number": "१-१५-२२", "content_sanskrit": "पशूनां च पतिः प्रायो वसूनां पतिरेव च ।\nपतिराखण्डलस्यैव वरूणस्य पतिस्तथा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005832022, "chapter_id": 25832, "verse_number": "१-१५-२३", "content_sanskrit": "वनस्पतीनां च पतिरनिलस्य पतिस्तथा ।\nअनलस्य पतिश्चैव यमस्य पतिरेव च ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005832023, "chapter_id": 25832, "verse_number": "१-१५-२४", "content_sanskrit": "कुबेरस्य पतिश्चैव नक्षत्राणां पतिस्तथा ।\nओषधीनां पतिश्चैव वृक्षाणां च पतिस्तथा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005832024, "chapter_id": 25832, "verse_number": "१-१५-२५", "content_sanskrit": "नागानां पतिरर्कस्य दक्षस्य पतिरेव च ।\nसुहृदां च पतिश्चैव नृपाणां च पतिस्तथा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005832025, "chapter_id": 25832, "verse_number": "१-१५-२६", "content_sanskrit": "गन्धर्वाणां पतिश्चैव असूनां पतिरुत्तमः ।\nपर्वतानां पतिश्चैव निम्नगानां पतिस्तथा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005832026, "chapter_id": 25832, "verse_number": "१-१५-२७", "content_sanskrit": "सुराणां च पतिः श्रेष्ठः कपिलस्य पतिस्तथ।\nलतानां च पतिश्चैव वीरुधां च पतिस्तथा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005832027, "chapter_id": 25832, "verse_number": "१-१५-२८", "content_sanskrit": "मुनीनां च पतिश्चैव सूर्य्यस्य पतिरुत्तमः ।\nपतिश्चन्द्रमसः श्रेष्ठः सुक्रस्य पतिरेव च ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005832028, "chapter_id": 25832, "verse_number": "१-१५-२९", "content_sanskrit": "ग्रहाणां च पतिश्चैव राक्षसानां पतिस्तथा ।\nकिन्नराणां पतिश्चैव द्विजानां पतिरुत्तमः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005832029, "chapter_id": 25832, "verse_number": "१-१५-३०", "content_sanskrit": "सरितां च पतिश्चैव समुद्राणां पतिस्तथा ।\nसरसां च पतिश्चैव भूतानां च पतिस्तथा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005832030, "chapter_id": 25832, "verse_number": "१-१५-३१", "content_sanskrit": "वेतालानां पतिश्चैव कूष्माण्डानां पतिस्तथा ।\nपक्षिणां च पतिः श्रेष्ठः पशूनां पतिरेव च ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005832031, "chapter_id": 25832, "verse_number": "१-१५-३२", "content_sanskrit": "महात्मा मंगलो मेयो मन्दरो मन्दरेश्वरः ।\nमेरुर्माता प्रमाणं च माधवो मलवर्जितः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005832032, "chapter_id": 25832, "verse_number": "१-१५-३३", "content_sanskrit": "मालाधरो महादेवो महादेवेन पूजितः ।\nमहाशान्तो महाभागो मधुसूदन एव च ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005832033, "chapter_id": 25832, "verse_number": "१-१५-३४", "content_sanskrit": "महावीर्य्यो महाप्राणो मार्कण्डेयर्षिवन्दितः ।\nमायात्मा मायया बद्धो मायया तु विवर्जितः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005832034, "chapter_id": 25832, "verse_number": "१-१५-३५", "content_sanskrit": "मुनिस्तुतो मुनिर्मैत्रो महाना (रा) सोहाहनुः।\nमहाबाहुर्महादान्तो मरणेन विवर्जितः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005832035, "chapter_id": 25832, "verse_number": "१-१५-३६", "content_sanskrit": "महावक्त्रो महात्मा च महाकायो महोर।\nमहापादो महाग्रीवो महामानी महामनाः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005832036, "chapter_id": 25832, "verse_number": "१-१५-३७", "content_sanskrit": "महागतिर्महाकीर्त्तिर्महारूपो महासुरः ।\nमधुश्च माधवश्चैव महादेवो महेश्वरः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005832037, "chapter_id": 25832, "verse_number": "१-१५-३८", "content_sanskrit": "मखेज्यो मखरूपी च माननीयो मखेश्र।\nमहावातो महाभागो महेशोऽतीतमानुषः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005832038, "chapter_id": 25832, "verse_number": "१-१५-३९", "content_sanskrit": "मानवश्च मनुश्चैव मानवानां प्रियंकरः ।\nमृगश्च मृगपूज्यश्च मृगाणां च पतिस्तथा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005832039, "chapter_id": 25832, "verse_number": "१-१५-४०", "content_sanskrit": "बुधस्य च पतिश्चैव पतिश्चैव बृहस्पतेः ।\nपतिः शनैश्चरस्यैव राहोः केतोः पतिस्तथा ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005832040, "chapter_id": 25832, "verse_number": "१-१५-४१", "content_sanskrit": "लक्ष्मणो लक्षणश्चैव लम्बौष्ठो ललिसतथा।\nनानालंकारसंयुक्तो नानाचन्दनचर्च्चितः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005832041, "chapter_id": 25832, "verse_number": "१-१५-४२", "content_sanskrit": "नानारसोज्जवलद्वक्त्रो नानापुष्पोपशोभितः ।\nरामो रमापतिश्चैव सभार्य्यः परमेश्वरः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005832042, "chapter_id": 25832, "verse_number": "१-१५-४३", "content_sanskrit": "रत्नदो रत्नहर्त्ता च रूपी रूपविवर्जत।\nमहारूपोग्ररूपश्च सौम्यरूपस्तथैव च ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005832043, "chapter_id": 25832, "verse_number": "१-१५-४४", "content_sanskrit": "नीलमेघनिभः शुद्धः कालमेघनिभस्तथा ।\nधूमवर्णः पतिवर्णो नानारूपो ह्यवर्णकः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005832044, "chapter_id": 25832, "verse_number": "१-१५-४५", "content_sanskrit": "विरूपो रूपदश्चैव शुक्लवर्णस्तथैव च ।\nसर्ववर्णो महायोगी यज्ञो (याज्यो) यज्ञकृदेव च ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005832045, "chapter_id": 25832, "verse_number": "१-१५-४६", "content_sanskrit": "सुवर्णवर्णवांश्चैव सुवर्णाख्यस्तथैव च सुवर्णावयवश्चैव सुवर्णः स्वर्णमेखलः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005832046, "chapter_id": 25832, "verse_number": "१-१५-४७", "content_sanskrit": "सुवर्णस्य प्रदाता च सुवर्णांशस्तथैव च ।\nसुवर्णस्य प्रियश्चैव सुवर्णाढ्यस्तथैव च ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005832047, "chapter_id": 25832, "verse_number": "१-१५-४८", "content_sanskrit": "सुपर्णी च महापर्णो सुपर्णस्य चकरण्।\nवैनतेयस्तथादित्य आदिरादिकरः शिवः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005832048, "chapter_id": 25832, "verse_number": "१-१५-४९", "content_sanskrit": "कारणं महतश्चैव प्रधानस्य च कारणम।\nबुद्धीनां कारणं चैव कारणं मनसस्तथा ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005832049, "chapter_id": 25832, "verse_number": "१-१५-५०", "content_sanskrit": "कारणं चैतसश्चैव अहंकारस्य कारणम् ।\nभूतानां कारणं तद्वत्कारणं च विभावसोः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005832050, "chapter_id": 25832, "verse_number": "१-१५-५१", "content_sanskrit": "आकाशकारणं तद्वत्पृथिव्याः कारणं परम् ।\nअण्डस्य कारणं चैव प्रकृतेः कारणं तथा ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7005832051, "chapter_id": 25832, "verse_number": "१-१५-५२", "content_sanskrit": "देहस्य कारणं चैव चक्षुषश्चैव कारणम् ।\nश्रोत्रस्य कारणं तद्वत्कारणं च त्वचस्तथा ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7005832052, "chapter_id": 25832, "verse_number": "१-१५-५३", "content_sanskrit": "जिह्वायाः कारणं चैव प्राणस्यैव च कारणम।\nहस्तयोः कारणं तद्वत्पादयोः कारणं तथा ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7005832053, "chapter_id": 25832, "verse_number": "१-१५-५४", "content_sanskrit": "वाचश्चकारणं तद्वत्पायोश्चैव तु कारणम् ।\nइन्द्रस्य कारणं चैव कुबेरस्य च कारणम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7005832054, "chapter_id": 25832, "verse_number": "१-१५-५५", "content_sanskrit": "यमस्य कारणं चैव ईशानस्य च कारणम् ।\nयक्षाणां कारणं चैव रक्षसां कारणं परम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7005832055, "chapter_id": 25832, "verse_number": "१-१५-५६", "content_sanskrit": "नृपाणां कारणं श्रेष्ठं धर्म्‌मस्यैव तु काम्।\nजन्तूनां कारणं चैव वसूनां कारणं परम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7005832056, "chapter_id": 25832, "verse_number": "१-१५-५७", "content_sanskrit": "मनूनां कारणं चैव पक्षिणां कारणं परम् ।\nमुनीनां कारणं श्रेष्ठ योगिनां कारणं परम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7005832057, "chapter_id": 25832, "verse_number": "१-१५-५८", "content_sanskrit": "सिद्धानां कारणं चैव यक्षाणां कारणं परम् ।\nकारणं किन्नराणां च गन्धर्वाणां च कारणम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7005832058, "chapter_id": 25832, "verse_number": "१-१५-५९", "content_sanskrit": "नदानां कारणं चैव नदीनां कारणं परम् ।\nकारणं च समुद्राणां वृक्षाणां कारणं तथा ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7005832059, "chapter_id": 25832, "verse_number": "१-१५-६०", "content_sanskrit": "कारणं वीरुधां चैव लोकानां कारणं तथा ।\nपाताल कारणं चैव देवानां कारणं तथा ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7005832060, "chapter_id": 25832, "verse_number": "१-१५-६१", "content_sanskrit": "सर्पाणां कारणं चैव श्रेयसां कारणं तथा ।\nपशूनां कारणं चैव सर्वेषां कारणं तथा ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7005832061, "chapter_id": 25832, "verse_number": "१-१५-६२", "content_sanskrit": "देहात्मा चेन्द्रियात्मा च आत्मा बुद्धिसथैव च।\nमनसश्च तथैवात्मा चात्माहंकारचेतसः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7005832062, "chapter_id": 25832, "verse_number": "१-१५-६३", "content_sanskrit": "जाग्रतः स्वपतश्चात्मा महदात्मा परस्तथा ।\nप्रधानस्य परात्मा च आकाशात्मा ह्यपां तथा ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7005832063, "chapter_id": 25832, "verse_number": "१-१५-६४", "content_sanskrit": "पृथिव्याः परमात्मा च रसस्यात्मा तथैव च ।\nगन्धस्य परमात्मा च रूपस्यात्मा परस्तथा ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7005832064, "chapter_id": 25832, "verse_number": "१-१५-६५", "content_sanskrit": "शब्दात्मा चैव वागात्मा स्पर्शात्मा पुरुषस्तथा ।\nश्रोत्रात्मा च त्वगात्मा च जिह्वायाः परमस्तथा ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7005832065, "chapter_id": 25832, "verse_number": "१-१५-६६", "content_sanskrit": "घ्राणात्मा चैव हस्तात्मा पादात्मा परमस्तथा ।\nउपस्थस्य तथैवात्मा पाय्वात्मा परमस्तथा ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7005832066, "chapter_id": 25832, "verse_number": "१-१५-६७", "content_sanskrit": "इन्द्रात्मा चैव ब्रह्मात्मा रुद्रा(शान्ता)त्मा च मनोस्थ।\nदक्षप्रजापतेरात्मा सत्या (स्त्रष्टा)त्मा परमस्तथा ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7005832067, "chapter_id": 25832, "verse_number": "१-१५-६८", "content_sanskrit": "ईशात्मा परमात्मा च रौद्रात्मा मोक्षविद्यतिः ।\nयत्नवांश्च तथा यत्नश्चर्म्मो खड्गीसुरान्तकः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7005832068, "chapter_id": 25832, "verse_number": "१-१५-६९", "content_sanskrit": "ह्रीप्रवर्त्तनशीलश्च यतीनां च हिते रत ।\nयतिरूपी च योगी च योगिध्येयो हरिः शितिः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7005832069, "chapter_id": 25832, "verse_number": "१-१५-७०", "content_sanskrit": "संविन्मेधा च कालश्च उष्मा वर्षा म(नतिस्तथा  ।\n> संवत्सरो मोक्षकरो मोहप्रध्वंसकस्तथा ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7005832070, "chapter_id": 25832, "verse_number": "१-१५-७१", "content_sanskrit": "मोहकर्त्ता च दुष्टानां माण्डव्यो वडवामुखः ।\nसंवर्त्तकः कालकर्त्ता च गौतमो भृगुरंगिराः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7005832071, "chapter_id": 25832, "verse_number": "१-१५-७२", "content_sanskrit": "अत्रिर्वसिष्ठः पुलहः पुलस्त्यः कुत्स एव ।\nयाज्ञवल्क्यो देवलश्च व्यासश्चैव पराशरः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7005832072, "chapter_id": 25832, "verse_number": "१-१५-७३", "content_sanskrit": "शर्म्मदश्चैव गांगेयो हृषीकेशो बृहच्छ्रवाः ।\nकेशवः क्लेशहन्ता च सुकर्णः कर्णवर्जितः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7005832073, "chapter_id": 25832, "verse_number": "१-१५-७४", "content_sanskrit": "नारायणो महाभागः प्राणस्य पतिरेव च ।\nअपानस्य पतिश्चैव व्यानस्य पतिरेव च ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7005832074, "chapter_id": 25832, "verse_number": "१-१५-७५", "content_sanskrit": "उदानस्य पतिः श्रेष्ठः समानस्य पतिस्तथा ।\nशब्दस्य च पतिः श्रेष्ठः स्पर्शस्य पतिरेव च ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7005832075, "chapter_id": 25832, "verse_number": "१-१५-७६", "content_sanskrit": "रूपाणां च पतिश्चाद्यः खङ्गपाणिर्हलायुधः ।\nचक्रपाणिः कुण्डली च श्रीवत्सांकस्तथैव च ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7005832076, "chapter_id": 25832, "verse_number": "१-१५-७७", "content_sanskrit": "प्रकृतिः कौस्तुभग्रीवः पीताम्बरधरस्तथा ।\nसुमुखो दुर्मुखश्चैव नखेन तु विवर्जितः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7005832077, "chapter_id": 25832, "verse_number": "१-१५-७८", "content_sanskrit": "अनन्तोऽनन्तरूपश्च सुनखः सुरसुन्दरः ।\nसुकलापो विभुर्जिष्णुर्भ्राजिष्णुश्चैषुधीस्तथा ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7005832078, "chapter_id": 25832, "verse_number": "१-१५-७९", "content_sanskrit": "हिरण्यकशिपोर्हन्ता हिरण्याक्षविमर्दकः ।\nनिहन्ता पूतनायाश्च भास्करान्तविनाशनः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7005832079, "chapter_id": 25832, "verse_number": "१-१५-८०", "content_sanskrit": "केशिनो दलनश्चैव मुष्टिकस्य विमर्दकः ।\nकंसदानवभेत्ता च चाणूरस्य प्रमर्दकः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7005832080, "chapter_id": 25832, "verse_number": "१-१५-८१", "content_sanskrit": "अरिष्टस्य निहंता च अक्रूरप्रिय एव च ।\nअक्रूरः क्रूररूपश्च अक्रूरप्रियवन्दितः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7005832081, "chapter_id": 25832, "verse_number": "१-१५-८२", "content_sanskrit": "भगहा भगवान् भानुस्तथा भागवतः स्वयम् ।\nउद्धवश्चोद्धवस्येशो ह्युद्धेवन विचिन्तितः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7005832082, "chapter_id": 25832, "verse_number": "१-१५-८३", "content_sanskrit": "चक्रधृक् चञ्चलश्चैव चलाचलविवर्जितः ।\nअहं कारोपमाश्चित्तं गगनं पृथिवी जलम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7005832083, "chapter_id": 25832, "verse_number": "१-१५-८४", "content_sanskrit": "वायुश्चक्षुस्तथा श्रोत्रं जिह्वा च घ्रमेव च।\nवाक्पाणिपादजवनः पायूपस्थस्तथैव च ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7005832084, "chapter_id": 25832, "verse_number": "१-१५-८५", "content_sanskrit": "शंकरश्चैव सर्वश्च क्षान्तिदः क्षान्तिकृन्नरः ।\nभक्तप्रियस्तता भर्त्ता भक्तिमान् भक्तिवर्द्धनः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7005832085, "chapter_id": 25832, "verse_number": "१-१५-८६", "content_sanskrit": "भक्तस्तुतो भक्तपरः कीर्त्तिदः कीर्त्तिवर्द्धनः ।\nकीर्त्तिर्दीप्तिः क्षमाकांतिर्भक्तश्चैव दया परा ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7005832086, "chapter_id": 25832, "verse_number": "१-१५-८७", "content_sanskrit": "दानं दाता च कर्त्ता च देवदेवप्रियः शुचिः ।\nशुचिमान्सुखदो मोक्षः कामश्चार्थः सहस्त्रपात् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7005832087, "chapter_id": 25832, "verse_number": "१-१५-८८", "content_sanskrit": "सहस्त्रशीर्षा वैद्यश्च मोक्षद्वारं तथैव च ।\nप्रजाद्वारं सहस्त्राक्षः सहस्त्रकर एव च ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7005832088, "chapter_id": 25832, "verse_number": "१-१५-८९", "content_sanskrit": "शुक्रश्च सुकिरीटी च सुग्रीवः कौस्तुभस्तथा ।\nप्रद्युम्नश्चानिरुद्धश्च हयग्रीवश्च शूकरः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7005832089, "chapter_id": 25832, "verse_number": "१-१५-९०", "content_sanskrit": "मत्स्यः परशुरामश्च प्रह्रादो बलिरेवच ।\nशरण्यश्चैव नित्यश्च बुद्धो मुक्तः शरीरभृत् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7005832090, "chapter_id": 25832, "verse_number": "१-१५-९१", "content_sanskrit": "खरदूषणहन्ता च रावणस्य प्रमर्दनः ।\nसीतापतिश्च वर्द्धिष्णुर्भरतश्च तथैव च ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7005832091, "chapter_id": 25832, "verse_number": "१-१५-९२", "content_sanskrit": "कुम्भेंद्रजिन्निहन्ता च कुम्भकर्परमर्दनः।\nनरांतकांतकश्चैव देवांतकविनाशनः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7005832092, "chapter_id": 25832, "verse_number": "१-१५-९३", "content_sanskrit": "दुष्टासुरनिहंता च शम्बरारिस्तथैव च ।\nनरकस्य निहन्ता च त्रिशीर्षस्य विनाशनः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7005832093, "chapter_id": 25832, "verse_number": "१-१५-९४", "content_sanskrit": "यमलार्जनभेत्ता च तपोहितकरस्तथा ।\nवादित्रं चैव वाद्यं च बुद्धश्चैव वरप्रदः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7005832094, "chapter_id": 25832, "verse_number": "१-१५-९५", "content_sanskrit": "सारः सारप्रियः सौरः कालहन्तानिकृन्तनः ।\nअगस्त्यो देवलश्चैव नारदो नारदप्रियः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7005832095, "chapter_id": 25832, "verse_number": "१-१५-९६", "content_sanskrit": "प्राणोऽपानस्तथा व्यानो रजः सत्त्वं तमः त्।\nउदानश्च समानश्च भेषजं च भिषक् तथा ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7005832096, "chapter_id": 25832, "verse_number": "१-१५-९७", "content_sanskrit": "कूटस्थः स्वच्छरूपश्च सर्वदेहविवर्जितः ।\nचक्षुरिन्द्रियहीनश्च वागिंद्रियविवर्जितः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7005832097, "chapter_id": 25832, "verse_number": "१-१५-९८", "content_sanskrit": "हस्तेंद्रियविहीनश्च पादाभ्यां च विवरजतः।\nपायूपस्थविहीनश्च महातपविवर्जितः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7005832098, "chapter_id": 25832, "verse_number": "१-१५-९९", "content_sanskrit": "प्रबोधेन विहीनश्च बुद्ध्या चैव विवर्जित।\nचेतसा विगतश्चैव प्राणेन च विवर्जितः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7005832099, "chapter_id": 25832, "verse_number": "१-१५-१००", "content_sanskrit": "अपानेन विहीनश्च व्यानेन च विवर्जित ।\nउदानेन विहीनश्च समानेन विवर्जितः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7005832100, "chapter_id": 25832, "verse_number": "१-१५-१०१", "content_sanskrit": "आकाशेन विहीनश्च वायुना परिवर्जितः ।\nअग्निना च विहीनश्च उदकेन विवर्जितः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7005832101, "chapter_id": 25832, "verse_number": "१-१५-१०२", "content_sanskrit": "पृथिव्या च विहीनश्च शब्देन च विवर्जितः ।\nस्पर्शेन च विहीनश्च सर्वरूपविवर्जितः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7005832102, "chapter_id": 25832, "verse_number": "१-१५-१०३", "content_sanskrit": "रागेण विगतश्चैव अघेन परिवर्जितः ।\nशोकेन रहितश्चैव वचसा परिवर्जितः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7005832103, "chapter_id": 25832, "verse_number": "१-१५-१०४", "content_sanskrit": "रजो विवर्जितश्चैव विकारैः षड्‌भिरेव च ।\nकामेन वर्जितश्चैव क्रोधेन परिवर्जितः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7005832104, "chapter_id": 25832, "verse_number": "१-१५-१०५", "content_sanskrit": "लोभेन विगतश्चैव दम्भेन च विवर्जितः ।\nसूक्ष्मश्चैव सुसूक्ष्मश्च स्थूलात्स्थूलतरस्तथा ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7005832105, "chapter_id": 25832, "verse_number": "१-१५-१०६", "content_sanskrit": "विशारदो बलाध्यक्षः सर्वस्य क्षोभकस्तथा ।\nप्रकृतेः क्षोभकश्चैव महतः क्षोभकस्तथा ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7005832106, "chapter_id": 25832, "verse_number": "१-१५-१०७", "content_sanskrit": "भूतानां क्षोभकश्चैव बुद्धेश्च क्षोमकस्तथा ।\nइन्द्रियाणां क्षोभकश्च विषयक्षोभकस्तथा ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7005832107, "chapter_id": 25832, "verse_number": "१-१५-१०८", "content_sanskrit": "ब्रह्मणः क्षोभकश्चैव रुद्रस्य क्षोभकस्तथा ।\nअगम्यश्चक्षुरादेश्च श्रोत्रागम्यस्तथैव च ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7005832108, "chapter_id": 25832, "verse_number": "१-१५-१०९", "content_sanskrit": "त्वचा न गम्यः कूर्म्मश्च जिह्वाऽग्राह्यस्तथै।\nघ्राणोन्द्रियागम्य एव वाचाऽग्राह्यस्तथैव च ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7005832109, "chapter_id": 25832, "verse_number": "१-१५-११०", "content_sanskrit": "अगम्यश्चैव पाणिभ्यां पदागम्यस्तथैव च ।\nअग्राह्यो मनसश्चैव बुद्ध्याऽग्राह्यो हरिस्तथा ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7005832110, "chapter_id": 25832, "verse_number": "१-१५-१११", "content_sanskrit": "अहं बुद्ध्या तथा ग्राह्यश्चेतसा ग्राह्यव च।\nशंखपाणिश्चाव्ययश्च गदापाणिस्तथैव च ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7005832111, "chapter_id": 25832, "verse_number": "१-१५-११२", "content_sanskrit": "शार्ङ्गपाणिश्च कृष्णश्च ज्ञानमूर्त्तिः परन्तप ।\nतपस्वी ज्ञानगम्यो हि ज्ञानी ज्ञानविदेव च ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7005832112, "chapter_id": 25832, "verse_number": "१-१५-११३", "content_sanskrit": "ज्ञेयश्च ज्ञेयहीनश्च ज्ञप्तिश्चैतन्रकः।\nभावो भाव्यो भवकरो भावनो भवनाशनः ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7005832113, "chapter_id": 25832, "verse_number": "१-१५-११४", "content_sanskrit": "गोविन्दो गोपतिर्गोपः सर्वगोपीसुखप्रदः ।\nगोपालो गोगतिश्चैव गोमतिर्गोधरस्तथा ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7005832114, "chapter_id": 25832, "verse_number": "१-१५-११५", "content_sanskrit": "उपेन्द्रश्च नृसिंहश्च शौरिश्चैव जनार्दन ।\nआरणेयो बृहद्भानुर्बृहद्दीप्तिस्तथैव च ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7005832115, "chapter_id": 25832, "verse_number": "१-१५-११६", "content_sanskrit": "दामोदरस्त्रिकालश्च कालज्ञः कालवर्जितः ।\nत्रिसन्ध्यो द्वापरं त्रेता प्रजाद्वारं त्रिविक्रमः ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7005832116, "chapter_id": 25832, "verse_number": "१-१५-११७", "content_sanskrit": "विक्रमो दण्ड(र) हस्तश्च ह्येकणड त्रिदण्डधृक्।\nसामभेदस्तथोपायः सामरूपी च सामगः ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7005832117, "chapter_id": 25832, "verse_number": "१-१५-११८", "content_sanskrit": "सामवेदोः ह्यथर्वश्च सुकृतः सुतरूपणः ।\nअथर्ववेदविच्चैव ह्यथर्वाचार्य्य एव च ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7005832118, "chapter_id": 25832, "verse_number": "१-१५-११९", "content_sanskrit": "ऋग्रूपी चैव ऋग्वेद ऋग्वेदेषु प्रतिष्ठित ।\nयजुर्वेत्ता यजुर्वेदो यजुर्वेदविदेकपात् ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7005832119, "chapter_id": 25832, "verse_number": "१-१५-१२०", "content_sanskrit": "बहुपाच्च सुपाच्चैव तथैव च सहस्त्रपात् ।\nचतुष्पाच्च द्विपाच्चैव स्मृतिर्न्यायो यमो बली ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7005832120, "chapter_id": 25832, "verse_number": "१-१५-१२१", "content_sanskrit": "सन्न्यासी चैव सन्नयासश्चतुराश्रम एव च ।\nब्रह्मचारी गृहस्थश्च वानप्रस्थश्च भिक्षुकः ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7005832121, "chapter_id": 25832, "verse_number": "१-१५-१२२", "content_sanskrit": "ब्राह्मणः क्षत्रियो वैश्यः शूद्रो वर्णसथव च।\nशीलदः शीलसम्पन्नो दुः शीलपरिवर्जितः ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7005832122, "chapter_id": 25832, "verse_number": "१-१५-१२३", "content_sanskrit": "मोक्षोऽध्यात्मसमाविष्टः स्तुतिः स्तोता च पूजकः ।\nपूज्यो वाक् करणं चैव वाच्यं चैव तु वाचकः ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7005832123, "chapter_id": 25832, "verse_number": "१-१५-१२४", "content_sanskrit": "वेत्ता व्याकरणं चैव वाक्यं चैव च वाक्यवित् ।\nवाक्यगम्यस्तीर्थवासी तीर्थस्तीर्थो च तीर्थवित् ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7005832124, "chapter_id": 25832, "verse_number": "१-१५-१२५", "content_sanskrit": "तीर्थादिभूतः सांख्यश्च निरुक्तं त्वधिदैवतम् ।\nप्रणवः प्रणवेशश्च प्रणवेन प्रवन्दितः ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7005832125, "chapter_id": 25832, "verse_number": "१-१५-१२६", "content_sanskrit": "प्रणवेन च लक्ष्यो वै गायत्री च गदर।\nशालग्रामनिवासी च शालग्रामस्तथैव च ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7005832126, "chapter_id": 25832, "verse_number": "१-१५-१२७", "content_sanskrit": "जलशायी योगशायी शेषशायी कुशेशयः ।\nमहीभर्त्ता च कार्य्यं च कारणं पृथिवीधरः ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7005832127, "chapter_id": 25832, "verse_number": "१-१५-१२८", "content_sanskrit": "प्रजापतिः शाश्वतश्च काम्यः कामयिता विराट् ।\nसम्राट् पूषा तथा स्वर्गो रथस्थः सारथिर्बलम् ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7005832128, "chapter_id": 25832, "verse_number": "१-१५-१२९", "content_sanskrit": "धनी धनप्रदो धन्यो यादवानां हिते रतः ।\nअर्जुनस्य प्रियश्चैव ह्यर्जुनो भीम एव च ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7005832129, "chapter_id": 25832, "verse_number": "१-१५-१३०", "content_sanskrit": "पराक्रमो दुर्विषहः सर्वशास्त्रविशारद ।\nसारस्वतो महाभीष्मः पारिजातहरस्तथा ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7005832130, "chapter_id": 25832, "verse_number": "१-१५-१३१", "content_sanskrit": "अमृतस्य प्रदाता च क्षीरोदः क्षीरमेव च ।\nइन्द्रात्मजस्तस्य गोप्ता गोवर्द्धनधरस्तथा ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7005832131, "chapter_id": 25832, "verse_number": "१-१५-१३२", "content_sanskrit": "कंसस्य नाशनस्तद्वद्धस्तिपो हस्तिनाशनः ।\nशिपिविष्टः प्रसन्नश्च सर्वलोकार्त्तिनाशनः ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7005832132, "chapter_id": 25832, "verse_number": "१-१५-१३३", "content_sanskrit": "मुद्रो मुद्रा करश्चैव सर्वमुद्राविवर्जित ।\nदेही देहस्थितश्चैव देहस्य च नियामकः ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7005832133, "chapter_id": 25832, "verse_number": "१-१५-१३४", "content_sanskrit": "श्रोत्रा श्रोत्रनियन्ता च श्रोतव्यः श्रवणं तथा ।\nत्वक्‌स्थितश्च स्पर्शयित्वा स्पृश्यं च स्पर्शनं तथा ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7005832134, "chapter_id": 25832, "verse_number": "१-१५-१३५", "content_sanskrit": "रूपद्रष्टा च चक्षुः स्थो नियन्ता चक्षुषस्थ।\nदृश्यं चैवतु जिह्वास्थो रसज्ञश्च नियामकः ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7005832135, "chapter_id": 25832, "verse_number": "१-१५-१३६", "content_sanskrit": "घ्राणस्थो घ्राणकृद्‌ घ्राता घ्राणेन्द्रियनियामकः ।\nवाक्‌स्थो वक्ता च वक्तव्यो वचनं वाङ्‌नियामकः ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7005832136, "chapter_id": 25832, "verse_number": "१-१५-१३७", "content_sanskrit": "प्राणिस्थः शिल्प कृच्छिल्पो हस्तयोश्च नियामकः ।\nपदव्यश्चैव गन्ता च गन्तव्यं गमनं तथा ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7005832137, "chapter_id": 25832, "verse_number": "१-१५-१३८", "content_sanskrit": "नियन्ता पादयोश्चैव पाद्यभाक्च विसर्गकृत् ।\nविसर्गस्य नियन्ता च ह्युपस्थस्थः सुखं तथा ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7005832138, "chapter_id": 25832, "verse_number": "१-१५-१३९", "content_sanskrit": "उपस्थस्य नियंता च तदानन्दकरश्च ह ।\nशत्रुघ्नः कार्त्तवीर्य्यश्च दत्तात्रेयस्तथैव च ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7005832139, "chapter_id": 25832, "verse_number": "१-१५-१४०", "content_sanskrit": "अलर्कस्य हितश्चैव कार्त्तवीर्य्यनकनतनः।\nकालनेमिर्महानेमिर्मेघो मेघपतिस्तथा ॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7005832140, "chapter_id": 25832, "verse_number": "१-१५-१४१", "content_sanskrit": "अन्नप्रदोऽन्नरूपी च ह्यन्नादोऽन्नप्रतकः।\nधूमकृद्धूमरूपश्च देवकीपुत्र उत्तमः ॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7005832141, "chapter_id": 25832, "verse_number": "१-१५-१४२", "content_sanskrit": "देवक्यानन्दनो नन्दो रोहिण्याः प्रिय च।\nवसुदेवप्रियश्चैव वसुदेवसुतस्तथा ॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 7005832142, "chapter_id": 25832, "verse_number": "१-१५-१४३", "content_sanskrit": "दुन्दुभिर्हासरूपश्च पुष्पहासस्तथैव च ।\nअट्टहासप्रियश्चैव सर्वाध्यक्षः क्षरोऽक्षरः ॥१४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 7005832143, "chapter_id": 25832, "verse_number": "१-१५-१४४", "content_sanskrit": "अच्युतश्चैव सत्येशः सत्यायाश्च प्रियो वरः ।\nरुक्मिण्याश्च पतिश्चैव रुक्मिण्या वल्लभस्तथा ॥१४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 7005832144, "chapter_id": 25832, "verse_number": "१-१५-१४५", "content_sanskrit": "गोपीनां वल्लभश्चैव पुण्यश्लोकश्च विश्रुतः ।\nवृषाकपिर्यमो गुह्यो मङ्गलश्च बुधस्तथा ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 7005832145, "chapter_id": 25832, "verse_number": "१-१५-१४६", "content_sanskrit": "राहुः केतुर्ग्रहो ग्राहो गजेन्द्रमुखमेलकः ।\nग्राहस्य विनिहन्ता च ग्रामणी रक्षकस्तथा ॥१४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 7005832146, "chapter_id": 25832, "verse_number": "१-१५-१४७", "content_sanskrit": "किन्नरश्चैव सिद्धश्च छन्दः स्वच्छन्द च।\nविश्वरूपो विशालाक्षो दैत्यसूदन एव च ॥१४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 7005832147, "chapter_id": 25832, "verse_number": "१-१५-१४८", "content_sanskrit": "अनन्तरूपो भूतस्थो देवदानवसंस्थितः ।\nसुषुप्तिस्थः सुषुप्तिश्च स्थानं स्थानान्त एव च ॥१४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 7005832148, "chapter_id": 25832, "verse_number": "१-१५-१४९", "content_sanskrit": "जगत्स्थश्चैव जागर्त्ता स्थानं जागरितं तथा ।\nस्वप्रस्थः स्वप्रवित्स्वप्नस्थानं स्वप्नस्तथैव च ॥१४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 7005832149, "chapter_id": 25832, "verse_number": "१-१५-१५०", "content_sanskrit": "जाग्रत्स्वप्नसुषुप्तैश्च विहीनो वै चतुर्क।\nविज्ञानं वेद्यरूपं च जीवो जीवयिता तथा ॥१५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 7005832150, "chapter_id": 25832, "verse_number": "१-१५-१५१", "content_sanskrit": "भुवनाधिपतिश्चैव भुवनानां नियामकः ।\nपातालवासी पातालं सर्वज्वरविनाशनः ॥१५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}, {"id": 7005832151, "chapter_id": 25832, "verse_number": "१-१५-१५२", "content_sanskrit": "परमानन्दरूपी च धर्म्माणां च प्रवर्तक।\nसुलभो दुर्लभश्चैव प्राणायामपरस्तथा ॥१५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 152}, {"id": 7005832152, "chapter_id": 25832, "verse_number": "१-१५-१५३", "content_sanskrit": "प्रत्याहारो धारकश्च प्रत्याहारकरस्तथा ।\nप्रभा कान्तिस्तथा ह्यर्च्चिः शुद्धस्फटिकसन्निभः ॥१५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 153}, {"id": 7005832153, "chapter_id": 25832, "verse_number": "१-१५-१५४", "content_sanskrit": "अग्राहश्चैव गौरश्च सर्वः शुचिरभिष्टुतः ।\nवषट्‌कारो वषड्‌ वौषट् स्वधा स्वाहा रतिस्तथा ॥१५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 154}, {"id": 7005832154, "chapter_id": 25832, "verse_number": "१-१५-१५५", "content_sanskrit": "पक्ता नन्दयिता भोक्ता बोद्धा भावयिता तथा ।\nज्ञानात्मा चैव देहात्मा भू(उ) मा सर्वेश्वरेश्वरः ॥१५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 155}, {"id": 7005832155, "chapter_id": 25832, "verse_number": "१-१५-१५६", "content_sanskrit": "नदी नन्दी च नन्दीशो भारतस्तरुनाशनः ।\nचक्रपः श्रीपतिश्चैव नृपाणां चक्रवर्त्तिनाम् ॥१५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 156}, {"id": 7005832156, "chapter_id": 25832, "verse_number": "१-१५-१५७", "content_sanskrit": "ईशश्च सर्वदेवानां द्वारकासंस्थितस्तथा ।\nपुष्करः पुष्कराध्यक्षः पुष्करद्वीप एव च ॥१५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 157}, {"id": 7005832157, "chapter_id": 25832, "verse_number": "१-१५-१५८", "content_sanskrit": "भरतो जनको जन्यः सर्वाकारवि वर्जितः ।\nनिराकारो निर्निमित्तो निरातंको निराश्रयः ॥१५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 158}, {"id": 7005832158, "chapter_id": 25832, "verse_number": "१-१५-१५९", "content_sanskrit": "इति नामसहस्त्रं ते वृषभध्वज कीर्त्तिम।\nदेवस्य विष्णोरीशस्य सर्वपापविनाशनम् ॥१५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 159}]