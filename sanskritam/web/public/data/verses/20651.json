[{"id": 7000651000, "chapter_id": 20651, "verse_number": "५-११०-१", "content_sanskrit": "श्रीराम उवाच ।\nअयमग्निशिखो नाम वह्निः शिवगणश्च वै ।\nस कथं तादृशो भूतस्तन्मे वद नमस्तव ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000651001, "chapter_id": 20651, "verse_number": "५-११०-२", "content_sanskrit": "शंभुरुवाच ।\nअयमासीत्पुरा कश्चित्क्षत्त्रियः क्रोधनः सदा ।\nनष्टभार्यो नष्टसेनो नष्टराष्ट्रोतिदुःखितः ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000651002, "chapter_id": 20651, "verse_number": "५-११०-३", "content_sanskrit": "लब्ध्वा लुलाय द्वितयं कृषिं चक्रे सहात्मजैः ।\nऋणेन महता युक्तः पुनश्चातीव दुःखितः ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000651003, "chapter_id": 20651, "verse_number": "५-११०-४", "content_sanskrit": "पुनश्च दुःखितो राजा सर्पेण सुतनाशनात् ।\nतथाभूतो महीपालस्तत्याज कृषिमप्युत ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000651004, "chapter_id": 20651, "verse_number": "५-११०-५", "content_sanskrit": "परित्यज्य सुतौ चापि त्यक्ताहारो रुरोद ह ।\nसुतावथ समागम्य प्राहतुः पितरं त्विदम् ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000651005, "chapter_id": 20651, "verse_number": "५-११०-६", "content_sanskrit": "किमर्थं रुद्यते तात नष्टो नायाति रोदनात् ।\nशरीरशोषणायाथ शोकस्तेऽद्य भविष्यति ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000651006, "chapter_id": 20651, "verse_number": "५-११०-७", "content_sanskrit": "शोकेन चक्षुषी नष्टे कंठो नष्टस्तथा तव ।\nअनुष्ठानं तथा नष्टं किमर्थं परितप्यसे ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000651007, "chapter_id": 20651, "verse_number": "५-११०-८", "content_sanskrit": "एको नष्टो न चायाति रक्ष पंचस्थितानसून् ।\nबहूनां रक्षणं पुण्यमाश्रितानां विशेषतः ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000651008, "chapter_id": 20651, "verse_number": "५-११०-९", "content_sanskrit": "अन्याश्रितममुं शत्रुं कथं शोचितुमर्हसि ।\nपितोवाच ।\nपुत्रः शत्रुः कथं पुत्रौ युवां शत्रू तथा च मे ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000651009, "chapter_id": 20651, "verse_number": "५-११०-१०", "content_sanskrit": "अत्यंतसुखिनं पुत्रं कथं शत्रुमभाषतम् ।\nसुतावूचतुः ।\nजायमानो हरेद्भार्यां वर्द्धमानो हरेद्धनम् ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000651010, "chapter_id": 20651, "verse_number": "५-११०-११", "content_sanskrit": "म्रियमाणस्तथा प्राणाञ्छत्रुत्वं किमतः परम् ।\nयत्सुखं च त्वया प्रोक्तं स्पर्शनालिंगनादिभिः ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000651011, "chapter_id": 20651, "verse_number": "५-११०-१२", "content_sanskrit": "दुःखोदर्कमिदं राजन्सर्वमेतद्वदामि ते ।\nप्रसूतिकाले पुत्रस्य भार्यानाशविचारणा ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000651012, "chapter_id": 20651, "verse_number": "५-११०-१३", "content_sanskrit": "जीवितायामथोपत्न्यामात्मनः सुखनाशनम् ।\nयोन्यशुद्धौ तु जातायां संयोगो नोपपद्यते ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000651013, "chapter_id": 20651, "verse_number": "५-११०-१४", "content_sanskrit": "आलिंगनपरे गाढं स्तन्येनांगं परिप्लुते ।\nतथापि यदि संयोगः शिशुरोदनताः स्त्रियाः ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000651014, "chapter_id": 20651, "verse_number": "५-११०-१५", "content_sanskrit": "दृढं शिशुगतं चित्तं ततो वैरस्यमेव च ।\nअथ चेत्पतितो डिंभो मध्ये मैथुनमुद्गतिः ॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000651015, "chapter_id": 20651, "verse_number": "५-११०-१६", "content_sanskrit": "रतिमध्ये तु विच्छेदे दुःखं किंचिदसन्निभम् ।\nसर्वकाले परिमिते कदाचिद्रतिसंभवः ॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000651016, "chapter_id": 20651, "verse_number": "५-११०-१७", "content_sanskrit": "तत्काले भोजनं नास्ति स्वापो नास्ति च भार्यया ।\nशिशूनां रक्षणे दुःखं व्याधितर्षग्रहादिभिः ॥१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000651017, "chapter_id": 20651, "verse_number": "५-११०-१८", "content_sanskrit": "तन्मतं यत्सुखं चित्रं यथांकारोहणं पितुः ।\nआलिंगनकृतं तात चुंबनादिकृतं तथा ॥१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000651018, "chapter_id": 20651, "verse_number": "५-११०-१९", "content_sanskrit": "अत्यन्तमधुरोक्त्यादि यत्सुखानि नरेश्वर ।\nरतिमध्ये विरामस्य कलां नार्हंति षोडशीम् ॥१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000651019, "chapter_id": 20651, "verse_number": "५-११०-२०", "content_sanskrit": "अन्यान्यपि च दुःखानि संति पुत्रे सहस्रशः ।\nअनेन त्वं किं क्रियसे इहामुत्र विरोधिना ॥२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000651020, "chapter_id": 20651, "verse_number": "५-११०-२१", "content_sanskrit": "त्यज शोकमिदं तस्मादावां पुत्रौ स्थिताविह ।\nश्रीराजोवाच ।\nत्यजामि शोकं दुर्वारं सर्वकार्यविरोधिनम् ॥२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000651021, "chapter_id": 20651, "verse_number": "५-११०-२२", "content_sanskrit": "आत्मनश्च हितं कार्यमिहामुत्र सुतौ मम ।\nपुरोधसं तु गच्छामि मम पूर्वं महागुरुम् ॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000651022, "chapter_id": 20651, "verse_number": "५-११०-२३", "content_sanskrit": "वसिष्ठं मुनिवर्यं च स दास्यति गतिं मम ।\nएवमुक्त्वा गतो विप्रं वाराणस्यां स्थितं गुरुम् ॥२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000651023, "chapter_id": 20651, "verse_number": "५-११०-२४", "content_sanskrit": "दंडवत्प्रणनामाथ मुनिना परिपूजितः ।\nआलिंगितशिरो घ्रातो दत्तासनपरिग्रहः ॥२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000651024, "chapter_id": 20651, "verse_number": "५-११०-२५", "content_sanskrit": "उक्तश्चागमनं किं ते किं कार्य्यं करवाणि वै ।\nराजोवाच ।\nगतिं प्रयच्छ मे विप्र संसारतरणाय हि ॥२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000651025, "chapter_id": 20651, "verse_number": "५-११०-२६", "content_sanskrit": "खिन्नोहं कर्मणा शश्वद्भवंतं शरणं गतः ।\nवसिष्ठ उवाच ।\nगतिं पश्य महालिंगं विश्वेश्वरमिति स्थितम् ॥२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000651026, "chapter_id": 20651, "verse_number": "५-११०-२७", "content_sanskrit": "एनं पूजय राजेंद्र देवदेवं पिनाकिनम् ।\nयमाराध्य पुरा शक्तिररुंधत्याः सुतो मुनिः ॥२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000651027, "chapter_id": 20651, "verse_number": "५-११०-२८", "content_sanskrit": "रक्षसा भक्षितश्चापि यमलोकं गतो न सः ।\nकिंचित्कालं गतः स्वर्गं ब्रह्मलोकमगादतः ॥२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000651028, "chapter_id": 20651, "verse_number": "५-११०-२९", "content_sanskrit": "ब्रह्मलोकाद्विष्णुलोके क्रीडन्नास्ते सुतो मम ।\nअमुं पश्य महाराज लुब्धकं वनचारिणम् ॥२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000651029, "chapter_id": 20651, "verse_number": "५-११०-३०", "content_sanskrit": "पूजयंतं हि विश्वेशं पत्रमात्रै स्वसंभृतैः ।\nशमीवृक्षस्य संभूतैस्तथा पूगप्रसूनकैः ॥३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000651030, "chapter_id": 20651, "verse_number": "५-११०-३१", "content_sanskrit": "कदंबकुसुमैरर्ककुसुमैर्यूथिकाभवैः ।\nएतैरन्यैर्महेशानं पूजयंतं विलोकय ॥३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000651031, "chapter_id": 20651, "verse_number": "५-११०-३२", "content_sanskrit": "इतोर्द्धयाममात्रेण मरिष्यति तदद्भुतम् ।\nअंतकाले समायाते लुब्धकोपि शिवाय वै ॥३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000651032, "chapter_id": 20651, "verse_number": "५-११०-३३", "content_sanskrit": "उपहारप्रदानाय दृष्टवान्पार्श्वतो घटम् ।\nतं चूतफलसंपूर्णं शुनोच्छिष्टं विगर्हितम् ॥३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000651033, "chapter_id": 20651, "verse_number": "५-११०-३४", "content_sanskrit": "संकल्पितोपहारस्य ह्यभावाल्लुब्धकस्तथा ।\nइदं जगौ शुभं वाक्यं लोकानां भक्तिसूचकम् ॥३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000651034, "chapter_id": 20651, "verse_number": "५-११०-३५", "content_sanskrit": "पुष्पाभावे हरिर्नेत्रं फलाभावेंगुलं रविः ।\nलिंगविस्रंसनेकं च जमदग्नि ऋषिस्तथा ॥३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000651035, "chapter_id": 20651, "verse_number": "५-११०-३६", "content_sanskrit": "लिंगपीठविभेदे च गात्रं निर्भिद्य दत्तवान् ।\nअन्यैर्माहैश्वरैरन्यत्साहसं परमं कृतम् ॥३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000651036, "chapter_id": 20651, "verse_number": "५-११०-३७", "content_sanskrit": "ममापि तत्तथा कार्य्यमन्यथा दोषभागहम् ।\nएतस्मिन्नंतरे कश्चिदुन्मत्तः शिवमभ्यगात् ॥३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000651037, "chapter_id": 20651, "verse_number": "५-११०-३८", "content_sanskrit": "अथ लुब्धकृतां पूजामाहृत्याभक्षयत्क्षणात् ।\nवमनं च तथा चक्रे शिवपीठेथ लुब्धकः ॥३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000651038, "chapter_id": 20651, "verse_number": "५-११०-३९", "content_sanskrit": "शिवापकारिणं चैनं हन्मि नो वेत्यचिंतयत् ।\nअथ स्वात्मवधायैव यत्नमास्थाय शंकरः ॥३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000651039, "chapter_id": 20651, "verse_number": "५-११०-४०", "content_sanskrit": "उन्मत्तेन यथोद्भुक्ता शिवपूजा मया कृता ।\nलिंगप्रावरणे ह्येषा तदहं मम देहिनः ॥४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000651040, "chapter_id": 20651, "verse_number": "५-११०-४१", "content_sanskrit": "प्रावृतिस्त्वगियं त्वद्य निर्म्मोक्तव्या मया द्रुतम् ।\nपूजाविमोचनायैतत्फलहानेर्गलं त्यजेत् ॥४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000651041, "chapter_id": 20651, "verse_number": "५-११०-४२", "content_sanskrit": "इत्थं संकल्प्य स तथा तीक्ष्णस्वधितिनाद्भुतम् ।\nचक्रे त्वचं दक्षपादं त्वचं च्छित्वा कटेरधः ॥४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000651042, "chapter_id": 20651, "verse_number": "५-११०-४३", "content_sanskrit": "वामपादं तथा चक्रे कटिपर्यंतमाशुच ।\nहृष्टश्चावेपितश्चैव तत ऊर्ध्वमथाच्छिनत् ॥४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000651043, "chapter_id": 20651, "verse_number": "५-११०-४४", "content_sanskrit": "करांसोदरहृत्कंठत्वचं निर्भिद्य लुब्धकः ।\nमस्तकस्य त्वचं चापि निर्बिभेद प्रहृष्टवान् ॥४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000651044, "chapter_id": 20651, "verse_number": "५-११०-४५", "content_sanskrit": "तयोरंतरतस्तस्माद्गात्रं निर्भिद्य वर्तुलम् ।\nछित्त्वांगुलि समादाय देवायार्पितवांस्त्वचम् ॥४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000651045, "chapter_id": 20651, "verse_number": "५-११०-४६", "content_sanskrit": "आरादेव तथा दिव्यरूपः स्वक्षश्चतुर्भुजः ।\nनानाभूषणसंयुक्तः स्थितो वियति शाङ्करः ॥४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000651046, "chapter_id": 20651, "verse_number": "५-११०-४७", "content_sanskrit": "अथ शैवाः समायाता दूताः शतसहस्रशः ।\nविचित्रमुकुटाकाराः सर्वाभरणभूषिताः ॥४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000651047, "chapter_id": 20651, "verse_number": "५-११०-४८", "content_sanskrit": "त्रिशूलपाणयः सर्वे शुद्धस्फटिकसंनिभाः ।\nचतुर्भुजाः सुरूपाश्च विमानवरसंस्थिताः ॥४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000651048, "chapter_id": 20651, "verse_number": "५-११०-४९", "content_sanskrit": "सर्वे सूर्यसमाः शांता रंभावत्प्रियया युताः ।\nसूनुपत्नीबलोत्साह विलासस्त्रीशतान्विताः ॥४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000651049, "chapter_id": 20651, "verse_number": "५-११०-५०", "content_sanskrit": "तेजसा सूर्यसदृशाः पुष्पवृष्टिमवाकिरन् ।\nतैराहूतो लुब्धकश्च नागच्छदवदच्च तान् ॥५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000651050, "chapter_id": 20651, "verse_number": "५-११०-५१", "content_sanskrit": "भार्याबंधुजनोपेतो गच्छेहमथवा न वा ।\nशैवास्तद्वचनं श्रुत्वा वाक्यमेतदथोचिरे ॥५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000651051, "chapter_id": 20651, "verse_number": "५-११०-५२", "content_sanskrit": "येन पुण्यं कृतं पापं तेन भोग्यं हि तत्फलम् ।\nलुब्धक उवाच ।\nअशौचानां च सर्वेषां धर्माणामेककर्तृकम् ॥५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000651052, "chapter_id": 20651, "verse_number": "५-११०-५३", "content_sanskrit": "माहेश्वराणां धर्माणां फलं च द्विबहुष्वपि ।\nएतस्मिन्नंतरे प्राप्तो वीरभद्रः शतार्भकः ॥५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000651053, "chapter_id": 20651, "verse_number": "५-११०-५४", "content_sanskrit": "नानाकोटिगणोपेतो एहि लुब्धकबंधुयुक् ।\nसर्वं त्वयोक्तं च तथा सभार्यो ज्ञातिबंधुयुक् ॥५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000651054, "chapter_id": 20651, "verse_number": "५-११०-५५", "content_sanskrit": "आरुह्येदं विमानं च शिवं गच्छ शिवं तु वः ।\nअथ तद्वचनात्प्राप्तः शिवलोकं विमानगः ॥५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000651055, "chapter_id": 20651, "verse_number": "५-११०-५६", "content_sanskrit": "वसिष्ठ उवाच ।\nदृष्टवानसि सर्वं त्वमीशपूजां समाचर ।\nविमुक्तपापबंधस्त्वं शिवलोकं गमिष्यसि ॥५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000651056, "chapter_id": 20651, "verse_number": "५-११०-५७", "content_sanskrit": "यदि राज्यं त्वया प्रार्थ्यं मार्जयेशां गणं नृप ।\nगोमयोदकलेपं च नित्यमेव समाचर ॥५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000651057, "chapter_id": 20651, "verse_number": "५-११०-५८", "content_sanskrit": "एतावता भूमिराज्यं ध्रुवं तव भविष्यति ।\nयावदायुश्च ते राज्यमंते शिवपदं भवेत् ॥५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000651058, "chapter_id": 20651, "verse_number": "५-११०-५९", "content_sanskrit": "नैतस्मिंस्तु भवेद्राज्यसंसिद्धिरनुमृत्युतः ।\nअतो देहांतरं प्राप्य शिवसेवाप्रभावतः ॥५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000651059, "chapter_id": 20651, "verse_number": "५-११०-६०", "content_sanskrit": "भविष्यति च ते राज्यं शिवभक्तिः स्थिरा तथा ।\nशंभुरुवाच ।\nअथ कृत्वा तथा पूजां मृतः स्वर्गं गतस्ततः ॥६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000651060, "chapter_id": 20651, "verse_number": "५-११०-६१", "content_sanskrit": "राजजन्मपुनः प्राप्य राज्यं चक्रे शिवेरतः ।\nकदाचिदथ देवस्य गृहमभ्यगमन्नृपः ॥६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000651061, "chapter_id": 20651, "verse_number": "५-११०-६२", "content_sanskrit": "नानादीपसमोपेतं मणिभिर्नागराडिव ।\nभटानामथ संमर्द एको दीपो पतन्नृपे ॥६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000651062, "chapter_id": 20651, "verse_number": "५-११०-६३", "content_sanskrit": "तदासौ कुपितो राजा दीपमादाय सत्वरम् ।\nदेवालयपुरे रम्ये न्यक्षिपत्कोपसंयुतः ॥६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000651063, "chapter_id": 20651, "verse_number": "५-११०-६४", "content_sanskrit": "दग्धं देवगृहं तेन एनश्च समपद्यत ।\nअथ तेन पुनस्तत्र दग्धं वेश्मगृहादिकम् ॥६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000651064, "chapter_id": 20651, "verse_number": "५-११०-६५", "content_sanskrit": "निर्मापयामास नृपो महेशानमथायजत् ।\nअथ मृत्युदिने प्राप्ते राजाराधितशंकरः ॥६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000651065, "chapter_id": 20651, "verse_number": "५-११०-६६", "content_sanskrit": "भस्मस्नायी भस्मशायी जपन्रुद्रं ममार ह ।\nशिवलोकं गतः सोयं वीरभद्रेण भाषितः ॥६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000651066, "chapter_id": 20651, "verse_number": "५-११०-६७", "content_sanskrit": "भव त्वं गणशार्दूलो ममवै परिचारकः ।\nशाङ्करान्मम निर्देशादानयस्व ममांतिकम् ॥६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000651067, "chapter_id": 20651, "verse_number": "५-११०-६८", "content_sanskrit": "शिरोहीनो भवांश्चापि ज्वालावक्त्रो भविष्यति ।\nसतूवाच महात्मानं वीरभद्रं गणेश्वरम् ॥६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000651068, "chapter_id": 20651, "verse_number": "५-११०-६९", "content_sanskrit": "चक्षुः श्रोत्रं तथा जिह्वा नासिकास्यं शिरोगणः ।\nएतैर्विना व्यवहृतिः कथं मे संभविष्यति ॥६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000651069, "chapter_id": 20651, "verse_number": "५-११०-७०", "content_sanskrit": "अभावे शिरसः किं वा मया पापं कृतं विभो ।\nवीरभद्र उवाच ।\nत्वयैव स्वीकृता पूर्वं देवी परमसुंदरी ॥७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000651070, "chapter_id": 20651, "verse_number": "५-११०-७१", "content_sanskrit": "महेशभवनं नित्यं चार्तुवर्णकरंगकैः ।\nस्वस्तिकं सर्वतोभद्रं नंद्यावर्तादिकं शुभम् ॥७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000651071, "chapter_id": 20651, "verse_number": "५-११०-७२", "content_sanskrit": "पद्ममुत्पलमांदोल पादो व्यजन चामरे ।\nत्रिशूलं शंखचक्रे च गदाधनुरथैव च ॥७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000651072, "chapter_id": 20651, "verse_number": "५-११०-७३", "content_sanskrit": "त्रिशूलं डमरुंखड्गं वृषं भृंगिरिटिं शिवम् ।\nतथाष्टपत्रं कमलमन्यद्यंत्रादिकं तथा ॥७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000651073, "chapter_id": 20651, "verse_number": "५-११०-७४", "content_sanskrit": "कल्पयंती प्रतिदिनं सेवते वृषभध्वजम् ।\nकदाचिदथ सा वेश्या देवसद्मन्युपस्थिता ॥७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000651074, "chapter_id": 20651, "verse_number": "५-११०-७५", "content_sanskrit": "राज्ञः कारांकिकः कश्चिद्देववेश्म समाविशत् ।\nअथ तां दृष्टवांस्तत्र स इदं वाक्यमुक्तवान् ॥७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000651075, "chapter_id": 20651, "verse_number": "५-११०-७६", "content_sanskrit": "काराङ्किक उवाच ।\nएकांतसंस्थिता वेश्या युवाहं स्थविरश्च न ।\nस्थविरं व्याधितं षंढमशक्तं धनवर्जितम् ॥७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000651076, "chapter_id": 20651, "verse_number": "५-११०-७७", "content_sanskrit": "अदीर्घमेहनं दीनं पुरुषं योषिदुत्सृजेत् ।\nअश्मश्रुलं मलच्छन्नं जडं दुर्गंधिदूषितम् ॥७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000651077, "chapter_id": 20651, "verse_number": "५-११०-७८", "content_sanskrit": "स्वल्पमव्यसनं नारी दूरतः परिवर्ज्जयेत् ।\nतस्मान्मे दीयतां वेश्ये मैथुनं जीवयाशु माम् ॥७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000651078, "chapter_id": 20651, "verse_number": "५-११०-७९", "content_sanskrit": "वेश्योवाच ।\nनियतः सर्वजातीनामिहामुत्र सुखप्रदः ।\nपातिव्रत्यं परो धर्म्मः स्त्रीणामिति हि शुश्रुम ॥७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000651079, "chapter_id": 20651, "verse_number": "५-११०-८०", "content_sanskrit": "यदधीना यदा वेश्या तदा नान्येन संगता ।\nपतिव्रतेति विख्याता तस्मात्तं परिपालयेत् ॥८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000651080, "chapter_id": 20651, "verse_number": "५-११०-८१", "content_sanskrit": "कारांकिक उवाच ।\nयदि चैवं मृतिः शीघ्रं भविष्यति न संशयः ।\nअथ राजांतिकं गत्वा राजानमिदमुक्तवान् ॥८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000651081, "chapter_id": 20651, "verse_number": "५-११०-८२", "content_sanskrit": "वेश्या वेश्यैव नो भार्या नेति वक्तुं च नोचितम् ।\nइत्थं राजानमुक्त्वाथ मंडं चैवारनालजम् ॥८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000651082, "chapter_id": 20651, "verse_number": "५-११०-८३", "content_sanskrit": "किंचिदादाय तस्यास्तु मंदिरं गतवानयम् ।\nनिद्रावसरमालोक्य प्रसृज्यच करं ततः ॥८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000651083, "chapter_id": 20651, "verse_number": "५-११०-८४", "content_sanskrit": "वस्त्रस्य विवरे तत्र मंडं चिक्षेप दुष्टधीः ।\nएवं कृत्वा ततो गत्वा राजानमिदमुक्तवान् ॥८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000651084, "chapter_id": 20651, "verse_number": "५-११०-८५", "content_sanskrit": "राजन्निर्गत्य गत्वाथ वेश्याग्र्यां तव योषितः ।\nउत्थापयित्वा वेश्यां तां सर्वांगं द्रष्टुमर्हसि ॥८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000651085, "chapter_id": 20651, "verse_number": "५-११०-८६", "content_sanskrit": "उन्मुक्तबंधमथवा वसनं पश्य यत्नतः ।\nवेश्यावेश्माथगतवान्राजा कारांकिकं वचः ॥८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000651086, "chapter_id": 20651, "verse_number": "५-११०-८७", "content_sanskrit": "इदमाह सनिद्रेयं पश्येमां यामि पश्यसि ।\nस तूवाच नृपं तत्र न मे युक्तमिदं नृप ॥८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000651087, "chapter_id": 20651, "verse_number": "५-११०-८८", "content_sanskrit": "तन्मातरं वा पितरं दर्शनाय नियोजय ।\nतद्दृष्टौ सर्वमेवेदं व्यक्तमाशु भविष्यति ॥८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000651088, "chapter_id": 20651, "verse_number": "५-११०-८९", "content_sanskrit": "आनीता ह्यथ राज्ञा तु माता वीक्षितुमुद्यता ।\nवचनात्तु नृपस्यैव वस्त्रं शोधयतीव सा ॥८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000651089, "chapter_id": 20651, "verse_number": "५-११०-९०", "content_sanskrit": "तत्रस्थितं मंडमथ विज्ञायांबा ह्यमर्दयत् ।\nमर्दनाद्वसनं क्लिन्नं किं तदित्याह पार्थिवः ॥९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000651090, "chapter_id": 20651, "verse_number": "५-११०-९१", "content_sanskrit": "न किंचिद्देव नो किंचिदिति वेश्याप्रसूरपि ।\nबहुवाक्येन राजाथ वसनं वीक्ष्य शंकया ॥९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000651091, "chapter_id": 20651, "verse_number": "५-११०-९२", "content_sanskrit": "शुक्रक्लिन्नमिदं वासः प्राहैतत्पश्यतामिति ।\nअथ दृष्ट्वा समीपस्थास्तथेत्यूचुर्वचो नृपम् ॥९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000651092, "chapter_id": 20651, "verse_number": "५-११०-९३", "content_sanskrit": "राजाथ स्वगृहं गत्वा दंडाध्यक्षमभाषत ।\nइदानीमेव वेश्यायाः शिरश्छिंध्यविचारयन् ॥९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000651093, "chapter_id": 20651, "verse_number": "५-११०-९४", "content_sanskrit": "दर्शनीयं शिरस्तस्या घटिकाभ्यंतरे मम ।\nदंडकश्च नृपोक्त्यास्यास्तथा कृत्वा ह्यदर्शयत् ॥९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000651094, "chapter_id": 20651, "verse_number": "५-११०-९५", "content_sanskrit": "वीरभद्र उवाच ।\nएवं कृतं त्वया पूर्वं प्राप्तं च फलमद्य ते ।\nज्वालयैव हि वक्ता त्वं श्रोता द्रष्टा च जिघ्रसि ॥९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000651095, "chapter_id": 20651, "verse_number": "५-११०-९६", "content_sanskrit": "रसं जानासि मतिमानतिक्रोधी भविष्यसि ।\nशंभुरुवाच ।\nएवं ज्वालामुखो जातो राजा माहेश्वरोऽक्षमी ॥९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000651096, "chapter_id": 20651, "verse_number": "५-११०-९७", "content_sanskrit": "तस्मात्तु क्षमिणा भाव्यं परत्रेह सुखेप्सुना ।\nय इदं शृणुयान्नित्यं पुण्याख्यानमनुत्तमम् ॥९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000651097, "chapter_id": 20651, "verse_number": "५-११०-९८", "content_sanskrit": "विमुक्तपापबंधश्च शिवलोके भविष्यति ॥९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}]