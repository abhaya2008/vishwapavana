[{"id": 5000615000, "chapter_id": 9615, "verse_number": "७-८०-१", "content_sanskrit": "एतदाख्याय रामाय महर्षिः कुम्भसम्भवः ।\nअस्यामेवापरं वाक्यं कथायामुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000615001, "chapter_id": 9615, "verse_number": "७-८०-२", "content_sanskrit": "ततः स दण्डः काकुत्स्थ बहुवर्षगणायुतम् ।\nअकरोत्तत्र दान्तात्मा राज्यं निहतकण्टकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000615002, "chapter_id": 9615, "verse_number": "७-८०-३", "content_sanskrit": "अथ काले तु कस्मिंश्चिद्राजा भार्गवमाश्रमम् ।\nरमणीयमुपाक्रामच्चैत्रे मासि मनोरमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000615003, "chapter_id": 9615, "verse_number": "७-८०-४", "content_sanskrit": "तत्र भार्गवकन्यां स रूपेणाप्रतिमां भुवि ।\nविचरन्तीं वनोद्देशे दण्डो ऽपश्यदनुत्तमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000615004, "chapter_id": 9615, "verse_number": "७-८०-५", "content_sanskrit": "स दृष्ट्वा तां सुदुर्मेधा अनङ्गशरपीडितः ।\nअभिगम्य सुसंविग्नां कन्यां वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000615005, "chapter_id": 9615, "verse_number": "७-८०-६", "content_sanskrit": "कुतस्त्वमसि सुश्रोणि कस्य वा ऽसि सुता शुभे ।\nपीडितो ऽहमनङ्गेन गच्छामि त्वां शुभानने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000615006, "chapter_id": 9615, "verse_number": "७-८०-७", "content_sanskrit": "तस्य त्वेवं ब्रुवाणस्य मोहोन्मत्तस्य कामिनः ।\nभार्गवी प्रत्युवाचेदं वचः सानुनयं नृपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000615007, "chapter_id": 9615, "verse_number": "७-८०-८", "content_sanskrit": "भार्गवस्य सुतां विद्धि देवस्याक्लिष्टकर्मणः ।\nअरजां नाम राजेन्द्र ज्येष्ठामाश्रमवासिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000615008, "chapter_id": 9615, "verse_number": "७-८०-९", "content_sanskrit": "मा मां स्पृश बलाद्राजन्कन्या पितृवशा ह्यहम् ।\nगुरुः पिता मे राजेन्द्र त्वं च शिष्यो महात्मनः ।\nव्यसनं सुमहत्क्रुद्धः स ते दद्यान्महातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000615009, "chapter_id": 9615, "verse_number": "७-८०-१०", "content_sanskrit": "यदि वान्यन्मया कार्यं धर्मदृष्टेन सत्पथा ।\nवरयस्व नरश्रेष्ठ पितरं मे महाद्युतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000615010, "chapter_id": 9615, "verse_number": "७-८०-११", "content_sanskrit": "अन्यथा तु फलं तुभ्यं भवेद्घोराभिसंहितम् ।\nक्रोधेन हि पिता मे ऽसौ त्रैलोक्यमपि निर्दहेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000615011, "chapter_id": 9615, "verse_number": "७-८०-१२", "content_sanskrit": "दास्यते चानवद्याङ्ग तव मा याचितः पिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000615012, "chapter_id": 9615, "verse_number": "७-८०-१३", "content_sanskrit": "एवं ब्रुवाणामरजां दण्डः कामवशं गतः ।\nप्रत्युवाच मदोन्मत्तः शिरस्याधाय चाञ्जलिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000615013, "chapter_id": 9615, "verse_number": "७-८०-१४", "content_sanskrit": "प्रसादं कुरु सुश्रोणि न कालं क्षेप्तुमर्हसि ।\nत्वत्कृते हि मम प्राणा विदीर्यन्ते वरानने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000615014, "chapter_id": 9615, "verse_number": "७-८०-१५", "content_sanskrit": "त्वां प्राप्य मे वधो वा स्याच्छापो वा यदि दारुणः ।\nभक्तं भजस्व मां भीरु भजमानं सुविह्वलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000615015, "chapter_id": 9615, "verse_number": "७-८०-१६", "content_sanskrit": "एवमुक्त्वा तु तां कन्यां दोर्भ्यां गृह्य बलाद्बली ।\nविस्फुरन्तीं यथाकामं मैथुनायोपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000615016, "chapter_id": 9615, "verse_number": "७-८०-१७", "content_sanskrit": "एतमर्थं महाघोरं दण्डः कृत्वा सुदारुणम् ।\nनगरं प्रययावाशु मधुमन्तमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000615017, "chapter_id": 9615, "verse_number": "७-८०-१८", "content_sanskrit": "अरजा ऽपि रुदन्ती सा आश्रमस्याविदूरतः ।\nप्रतीक्षन्ति सुसंत्रस्ता पितरं देवसन्निभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000615018, "chapter_id": 9615, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे ऽशीतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]