[{"id": 7003122000, "chapter_id": 23122, "verse_number": "४-५८-१", "content_sanskrit": "अथाष्टपञ्चाशात्तमोऽध्यायः ।\nनारायण उवाच ।\nबभूव दर्पः पृथ्व्याश्च सर्पाधाराऽहमेव च ।\nपृथृद्वारा च तद्दर्पं जघान चैव तत्प्रभुः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003122001, "chapter_id": 23122, "verse_number": "४-५८-२", "content_sanskrit": "बभूव दर्पः साविञ्या वेदमाताऽहमेव च ।\nकाले चकार तस्याश्च सपुत्राया अदर्शनम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003122002, "chapter_id": 23122, "verse_number": "४-५८-३", "content_sanskrit": "बभूव दर्पं गङ्गया अहं निवणिदेति च ।\nजह्नुद्वारा च तद्दर्प जहार जगतां पतिः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003122003, "chapter_id": 23122, "verse_number": "४-५८-४", "content_sanskrit": "जहार मनसादर्प दुर्गाद्वारा पुरा मुने ।\nविरजोपगतं कृष्णं भर्त्सयामास कोपतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003122004, "chapter_id": 23122, "verse_number": "४-५८-५", "content_sanskrit": "प्रविशन्तं रासगुहं गोपीभिर्विनिवारितम् ।\nदौवारिकाभिर्वेत्रैश्च ताडितं तं च दर्पतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003122005, "chapter_id": 23122, "verse_number": "४-५८-६", "content_sanskrit": "सुदाम्ना निजभक्तेन राधा शप्ता बभूव ह ।\nदेवेन सहसा ध्वस्ता गोलोकादागता धराम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003122006, "chapter_id": 23122, "verse_number": "४-५८-७", "content_sanskrit": "वृषभानुस्त्रियां जाता कलावत्यां च नारद ।\nकृष्णस्तदनुरौधेन कंसभीतिच्छलेन च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003122007, "chapter_id": 23122, "verse_number": "४-५८-८", "content_sanskrit": "समागतो नन्दगेहं तेनाहं नन्दनन्दनः ।\nसुदाम्नः शापवीच्छैदपालनार्थ जगत्पतिः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003122008, "chapter_id": 23122, "verse_number": "४-५८-९", "content_sanskrit": "पुनर्जगाम मथुरामित्याह कमलोद्भवः ।\nअस्यापरमभिप्रायं को वा जनाति नारद ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003122009, "chapter_id": 23122, "verse_number": "४-५८-१०", "content_sanskrit": "कथं जातः समायाते सथुरायाश्च गोकुलम् ।\nइत्येवं कथितं सर्वमपरं श्रूयतामिति ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003122010, "chapter_id": 23122, "verse_number": "४-५८-११", "content_sanskrit": "यथा जगाम मथुरां नन्दान्स नन्दनन्दनः ।\nशोकं नन्दो यशोदा च यथा संप्रप दैवतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003122011, "chapter_id": 23122, "verse_number": "४-५८-१२", "content_sanskrit": "यथा गोपाश्च गोप्यश्च गावो वृन्दावने वने ।\nवने वने का वन्यास्ते वन्या जानन्ति किंचन ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003122012, "chapter_id": 23122, "verse_number": "४-५८-१३", "content_sanskrit": "वनं रम्यं वन्यपदमपि त्यक्तवा वने वने ।\nश्मशाने वाऽश्मशाने वा बभ्राम भामिनी मुने ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003122013, "chapter_id": 23122, "verse_number": "४-५८-१४", "content_sanskrit": "ग्रमं त्यक्त्वा च बभ्रम चेतनाऽचेतना क्षणम् ।\nक्षणेन वर्जिता सा च प्रार्थयान्ती प्रतिक्षणम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003122014, "chapter_id": 23122, "verse_number": "४-५८-१५", "content_sanskrit": "क्षणं क्षणं सा श्वसिति चिन्तनं कुर्वती क्षणम् ।\nक्षणं विशन्ती तल्पे च क्षणम्त्थाय तिष्ठति ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]