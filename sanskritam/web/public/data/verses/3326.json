[{"id": 2107786, "chapter_id": 3326, "verse_number": "", "content_sanskrit": "शौनकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2107787, "chapter_id": 3326, "verse_number": "१", "content_sanskrit": "पुराणमखिलं तात पिता तेऽधीतवान्पुरा ।\nकच्चित्त्वमपि तत्सर्वं अधीतो रोमहर्षणे \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2107788, "chapter_id": 3326, "verse_number": "२", "content_sanskrit": "पुराणे हि कथा दिव्या आदिवंशाश्च धीमताम् ।\nकथ्यन्ते ताः पुराऽस्माभिः श्रुताः पूर्वं पितुस्तव\t ॥ २॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2107789, "chapter_id": 3326, "verse_number": "३", "content_sanskrit": "तत्र वंशमहं पूर्वं श्रोतुमिच्छामि भार्गवम् ।\nकथयस्व कथां पुण्यां कल्पाः स्मः श्रवणे तव \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2107790, "chapter_id": 3326, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2107791, "chapter_id": 3326, "verse_number": "४", "content_sanskrit": "यदधीतं सदा सम्यग् द्विजश्रेष्ठैर्महात्मभिः ।\nवैशम्पायनविप्राद्यैस्तैश्चापि कथितं तदा\t ॥ ४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2107792, "chapter_id": 3326, "verse_number": "५", "content_sanskrit": "यदधीतं च पित्रा मे सम्यक्चैव ततो मया ।\nतं तावच्छृणु यो देवैः सर्वैः साग्निमरुद्गणैः\t ॥ ५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2107793, "chapter_id": 3326, "verse_number": "६", "content_sanskrit": "पूजितः प्रवरो वंशो भार्गवः पृथुनन्दन ।\nइमं वंशं महद्दिव्यं भार्गवं ते महामुने\t ॥ ६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2107794, "chapter_id": 3326, "verse_number": "७", "content_sanskrit": "भृगुर्महर्षिर्भगवान् ब्रह्मणा वै स्वयम्भुवा ।\nवरुणस्य क्रतौ जातः पावकादिति नः श्रुतम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2107795, "chapter_id": 3326, "verse_number": "८", "content_sanskrit": "निगदामि कथायुक्तं पुराणाश्रयमद्भुतम् ।\nभृगोश्च दयितः पुत्रश्च्यवनो नाम भार्गवः\t ॥ ८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2107796, "chapter_id": 3326, "verse_number": "९", "content_sanskrit": "च्यवनस्यापि दायादः प्रमतिर्नाम धार्मिकः ।\nप्रमतेरप्यभूत्पुत्रो घृताच्यां रुरुरित्युत\t ॥ ९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2107797, "chapter_id": 3326, "verse_number": "१०", "content_sanskrit": "रुरोरपि सुतो जज्ञे शुनको वेदपारगः ।\nप्रमद्वरायां धर्मात्मा तव पूर्वः पितामहः\t ॥ १०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2107798, "chapter_id": 3326, "verse_number": "११", "content_sanskrit": "तपस्वी च यशस्वी च श्रुतवान् धर्मवित्तमः ।\nधर्मिष्ठः सत्यवादी च नियतो नियतेन्द्रियः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2107799, "chapter_id": 3326, "verse_number": "", "content_sanskrit": "शौनकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2107800, "chapter_id": 3326, "verse_number": "१२", "content_sanskrit": "सूतपुत्र यथा तस्य भार्गवस्य महात्मनः ।\nच्यवनत्वं कथं प्राप्तं तन्ममाचक्ष्व सुव्रत \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2107801, "chapter_id": 3326, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2107802, "chapter_id": 3326, "verse_number": "१३", "content_sanskrit": "भृगोस्सुदयिता भार्या पुलोमेत्यभिविश्रुता ।\nतस्यां गर्भः समभवद्भृगोर्वीर्यसमुद्भवः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2107803, "chapter_id": 3326, "verse_number": "१४", "content_sanskrit": "तस्मिन् गर्भे समुद्भूते पुलोमायां भृगूद्भव ।\nसमये समशीलिन्यां धर्मपत्न्यां यशस्विनः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2107804, "chapter_id": 3326, "verse_number": "१५", "content_sanskrit": "अभिषेकाय निष्क्रान्ते भृगौ धर्मभृतां वरे ।\nआश्रमं तस्य रक्षोऽथ पुलोमाभ्याजगाम ह\t ॥ १५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2107805, "chapter_id": 3326, "verse_number": "१६", "content_sanskrit": "तं प्रविश्याश्रमं दृष्ट्वा भृगोर्भार्यामनिन्दिताम् ।\nहृच्छयेन समाविष्टो विचेताः समपद्यत \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2107806, "chapter_id": 3326, "verse_number": "१७", "content_sanskrit": "अभ्यागतं तु तद्दृष्ट्वा पुलोमा चारुहासिनी ।\nन्यमन्त्रयत वन्येन फलमूलादिना तदा\t ॥ १७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2107807, "chapter_id": 3326, "verse_number": "१८", "content_sanskrit": "तां तु रक्षस्तदा ब्रह्मन् हृच्छयेन निपीडितः ।\nदृष्ट्वा हृष्टमना भूत्वा जिहीर्षुस्तामनिन्दिताम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2107808, "chapter_id": 3326, "verse_number": "१९", "content_sanskrit": "अथाग्निशरणेऽपश्यज्ज्वलितं जातवेदसम् ।\nतमपृच्छत्ततो रक्षः पावकं ज्वलितं तदा \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2107809, "chapter_id": 3326, "verse_number": "२०", "content_sanskrit": "शंस मे कस्य भार्येयमग्ने पृच्छ ऋतेन वै ।\nसत्यस्त्वमसि सत्यं वै वद पावक पृच्छतः\t ॥ २०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2107810, "chapter_id": 3326, "verse_number": "२१", "content_sanskrit": "मया हीयं वृता पूर्वं भार्यार्थे वरवर्णिनी ।\nपश्चात्त्विमां पिता प्रादाद्भृगवेऽनृतकारिणे \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2107811, "chapter_id": 3326, "verse_number": "२२", "content_sanskrit": "सेयं यदि वरारोहा भृगोर्भार्या रहोगता ।\nतथा सत्यं ममाख्याहि जिहीर्षाम्याश्रमादिमाम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2107812, "chapter_id": 3326, "verse_number": "२३", "content_sanskrit": "मन्युर्हि हृदयं मेऽद्य निर्दहन्निव तिष्ठति ।\nमत्पूर्वभार्यां यदिमां भृगुः प्राप सुमध्यमाम् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2107813, "chapter_id": 3326, "verse_number": "२४", "content_sanskrit": "तद्रक्ष एवमामन्त्र्य ज्वलितं जातवेदसम् ।\nशङ्कमानो भृगोर्भार्यां पुनः पुनरपृच्छत \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2107814, "chapter_id": 3326, "verse_number": "२५", "content_sanskrit": "त्वमग्ने सर्वभूतानामन्तर्वससि नित्यदा ।\nसाक्षिवत्पुण्यपापेषु सत्यं ब्रूहि कवे वचः\t ॥ २५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2107815, "chapter_id": 3326, "verse_number": "२६", "content_sanskrit": "मत्पूर्वभार्याऽपहृता भृगुणाऽनृतकारिणा ।\nसेयं यदि तथा मे त्वं सत्यमाख्यातुमर्हसि \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2107816, "chapter_id": 3326, "verse_number": "२८", "content_sanskrit": "श्रुत्वा त्वत्तो भृगोर्भार्यां हरिष्याम्यहमाश्रमात् ।\nजातवेदः पश्यतस्ते वद सत्यां गिरं मम \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2107817, "chapter_id": 3326, "verse_number": "२९", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा सप्तार्चिर्दुःखितो भृशम् ।\nभीतोऽनृताच्च शापाच्च भृगोरित्यब्रवीच्छनैः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2107818, "chapter_id": 3326, "verse_number": "२", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आदिपर्वणि पञ्चमोऽध्यायः ॥५॥\n॥ पौलोमपर्वणि द्वितीयोऽध्यायः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]