[{"id": 2207241, "chapter_id": 5417, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2207242, "chapter_id": 5417, "verse_number": "१", "content_sanskrit": "इत्युक्ते नृपतौ तस्मिन् व्यासेनाद्भुतकर्मणा ।\nवासुदेवो महातेजाः ततो वचनमाददे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2207243, "chapter_id": 5417, "verse_number": "२", "content_sanskrit": "तं नृपं दीनमनसं निहतज्ञातिबान्धवम् ।\nउपप्लुतमिवादित्यं सधूममिव पावकम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2207244, "chapter_id": 5417, "verse_number": "३", "content_sanskrit": "विषण्णमनसं पार्थं ज्ञात्वा वृष्णिकुलोद्वहः ।\nआश्वासयन् धर्मसुतं प्रवक्तुमुपचक्रमे\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2207245, "chapter_id": 5417, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2207246, "chapter_id": 5417, "verse_number": "४", "content_sanskrit": "सर्वं जिह्मं मृत्युपदममृतं ब्रह्मणः पदम् ।\nएतावान् ज्ञानविषयः किं प्रलापः करिष्यति\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2207247, "chapter_id": 5417, "verse_number": "५", "content_sanskrit": "नैव तेऽनुष्ठितं कर्म नैव ते शत्रवो जिताः ।\nकथं शत्रुं शरीरस्थमात्मनो नावबुद्ध्यसे\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2207248, "chapter_id": 5417, "verse_number": "६", "content_sanskrit": "अत्र ते वर्तयिष्यामि यथाधर्मं यथाश्रुतम् ।\nइन्द्रस्य सह वृत्रेण यथा युद्धमवर्तत\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2207249, "chapter_id": 5417, "verse_number": "७", "content_sanskrit": "वृत्रेण पृथिवी व्याप्ता पुरा किल नराधिप\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2207250, "chapter_id": 5417, "verse_number": "८", "content_sanskrit": "दृष्ट्वा च पृथिवीं व्याप्तां गन्धस्य विषये हते ।\nधराहरणनिर्गन्धो विषयः समपद्यत\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2207251, "chapter_id": 5417, "verse_number": "९", "content_sanskrit": "शतक्रतुश्चुकोपाथ गन्धस्य विषये हृते ।\nशतक्रतुरभिक्रुद्धः तत्र वज्रमवासृजत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2207252, "chapter_id": 5417, "verse_number": "१०", "content_sanskrit": "स वध्यमानो वज्रेण सलिले भूरितेजसा ।\nविवेश सहसाऽम्भांसि जग्राह विषयं ततः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2207253, "chapter_id": 5417, "verse_number": "११", "content_sanskrit": "व्याप्ते चाम्भसि वृत्रेण रसस्य विषये हृते ।\nशतक्रतुरभिक्रुद्धः तत्र वज्रमवासृजत्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2207254, "chapter_id": 5417, "verse_number": "१२", "content_sanskrit": "स वध्यमानो वज्रेण सलिले भूरितेजसा ।\nविवेश सहसा ज्योतिर्जग्राह विषयं ततः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2207255, "chapter_id": 5417, "verse_number": "१३", "content_sanskrit": "व्याप्ते ज्योतिषि वृत्रेण रूपस्य विषये हृते ।\nशतक्रतुरभिक्रुद्धः तत्र वज्रमवासृजत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2207256, "chapter_id": 5417, "verse_number": "१४", "content_sanskrit": "स वध्यमानो वज्रेण सुभृशं भूरितेजसा ।\nविवेश सहसा वायुं जग्राह विषयं ततः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2207257, "chapter_id": 5417, "verse_number": "१५", "content_sanskrit": "व्याप्ते वायौ च वृत्रेण स्पर्शस्य विषये हृते ।\nशतक्रतुरभिक्रुद्धः तत्र वज्रमवासृजत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2207258, "chapter_id": 5417, "verse_number": "१६", "content_sanskrit": "स वध्यमानो वज्रेण तस्मिन्नमिततेजसा ।\nआकाशमभिदुद्राव तं शक्रं विषयं ततः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2207259, "chapter_id": 5417, "verse_number": "१७", "content_sanskrit": "आकाशे वृत्रभूतेऽथ शब्दस्य विषये हृते ।\nशतक्रतुरभिक्रुद्धः तत्र वज्रमवासृजत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2207260, "chapter_id": 5417, "verse_number": "१८", "content_sanskrit": "स वध्यमानो वज्रेण तस्मादमिततेजसा ।\nविवेश सहसा शक्रं जग्राह विषयं ततः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2207261, "chapter_id": 5417, "verse_number": "१९", "content_sanskrit": "तस्य वृत्रगृहीतस्य मोहः समभवन्महान् ।\nरथन्तरेण तं साम्ना वसिष्ठः प्रत्यबोधयत्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2207262, "chapter_id": 5417, "verse_number": "२०", "content_sanskrit": "ततो वृत्रं शरीरस्थं जग्राह भरतर्षभ ।\nशतक्रतुरदृश्येन वज्रेणेतीह नः श्रुतम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2207263, "chapter_id": 5417, "verse_number": "२१", "content_sanskrit": "इदं धर्मरहस्यं तु शक्रेणोक्तं महर्षिषु ।\nऋषिभिश्च मम प्रोक्तं तन्निबोध नराधिप\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2207264, "chapter_id": 5417, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि वृत्रासुरवधनप्रकारकथनं नाम एकादशोऽध्यायः ॥११॥\nअश्वमेधपर्वणि एकादशोऽध्यायः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]