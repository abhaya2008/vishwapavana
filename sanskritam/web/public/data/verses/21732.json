[{"id": 7001732000, "chapter_id": 21732, "verse_number": "१-११८-१", "content_sanskrit": "सनातन उवाच ।\nअथ वक्ष्यामि विप्रेंद्र नवम्यास्ते व्रतानि वै ।\nयानि कृत्वा नरा लोके लभंते वांछितं फलम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001732001, "chapter_id": 21732, "verse_number": "१-११८-२", "content_sanskrit": "चैत्रस्य शुक्लपक्षे तु श्रीरामनवमीव्रतम् ।\nतत्रोपवासं विधिवच्छक्तो भक्तः समाचरेत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001732002, "chapter_id": 21732, "verse_number": "१-११८-३", "content_sanskrit": "अशक्तश्चैकभक्तं वै मध्याह्नोत्सवतः परम् ।\nविप्रान्संभोज्य मिष्टान्नै रामप्रीति सुमाचरेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001732003, "chapter_id": 21732, "verse_number": "१-११८-४", "content_sanskrit": "गोभूतिलहरिरण्याद्येर्वस्त्रालंकरणेस्तथा ।\nएव यः कुरुते भक्त्या श्रीरामनवमीव्रतम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001732004, "chapter_id": 21732, "verse_number": "१-११८-५", "content_sanskrit": "विधूय चेहपापानि व्रजेद्विष्णोः परं पदम् ।\nउक्तं मातृव्रतं चात्र भैरवेण समन्विताः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001732005, "chapter_id": 21732, "verse_number": "१-११८-६", "content_sanskrit": "स्रग्गंधवस्रनमनैवेद्यैश्चतुःष्टिस्तु योगिनीः ।\nअत्रैव भद्रकालो तु योगिनीनां महाबला ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001732006, "chapter_id": 21732, "verse_number": "१-११८-७", "content_sanskrit": "ब्राह्मणश्रेष्टः सर्वासामाधिपत्येऽभिषेचिता ।\nतस्मात्तां पूजयेच्चात्र सोपवासो जितेंद्रियः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001732007, "chapter_id": 21732, "verse_number": "१-११८-८", "content_sanskrit": "राधे नवम्यां दलयोश्चंडिकां यस्तु पूजयेत् ।\nविधिना स विमानेन देवतैः सह मोदते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001732008, "chapter_id": 21732, "verse_number": "१-११८-९", "content_sanskrit": "ज्येष्ठशुक्लनवम्यां तु सोपवासो नरोत्तमः ।\nउमां संपूज्य विधिवत्कुमारीर्भोजयेद्द्विजान् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001732009, "chapter_id": 21732, "verse_number": "१-११८-१०", "content_sanskrit": "स्वभक्त्या दक्षिणां दत्वा शाल्यन्नं पयसाऽश्नुयात् ।\nउमाव्रतमिदं विप्र यः कुर्याद्विधिवन्नरः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001732010, "chapter_id": 21732, "verse_number": "१-११८-११", "content_sanskrit": "स भुक्त्वेह वरान्भोगानंते स्वर्गगतिं लभेत् ।\nआषाढे मासि विप्रेंद्र यः कुर्यात्पक्षयोर्द्विज ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001732011, "chapter_id": 21732, "verse_number": "१-११८-१२", "content_sanskrit": "नक्तं चैंद्रीं समभ्यर्च्येदैरावतगतां सिताम् ।\nस भवेद्वैवलोके तु भोगभारग्देवयानगः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001732012, "chapter_id": 21732, "verse_number": "१-११८-१३", "content_sanskrit": "श्रावणे मासि विप्रेन्द्र यः कुर्यान्नक्तभोजनम् ।\nपक्षयोरुपवासं वा कौमारीं चंडिकां यजेत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001732013, "chapter_id": 21732, "verse_number": "१-११८-१४", "content_sanskrit": "एवं पापहरां गंधैः पुष्पैर्धूपैश्च दीपकैः ।\nनैवेद्यैर्विविधैश्चैव कुमारीभोजनैस्तथा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001732014, "chapter_id": 21732, "verse_number": "१-११८-१५", "content_sanskrit": "एवं यः कुरुते भक्त्या कौमारीव्रतमुत्तमम् ।\nस विमानेन गच्छेद्वै देवीलोकं सनातनम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001732015, "chapter_id": 21732, "verse_number": "१-११८-१६", "content_sanskrit": "भाद्रे तु नवमी शुक्ला नंदाह्वा परिकीर्तिता ।\nतस्यां यः पूजयेद्दुर्गां विधिवच्चोपचारकैः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001732016, "chapter_id": 21732, "verse_number": "१-११८-१७", "content_sanskrit": "सोऽश्वमेधफलं लब्ध्वा विष्णुलोके महीयते ।\nआश्विने शुक्लनवमी महापूर्वा प्रकीर्तिता ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001732017, "chapter_id": 21732, "verse_number": "१-११८-१८", "content_sanskrit": "अपराह्णे शमीपूजा कार्याऽस्यां प्राग्दिशि द्विज ।\nततो निशायां प्राग्यामे खङ्गं धनुरिषून्गदाम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001732018, "chapter_id": 21732, "verse_number": "१-११८-१९", "content_sanskrit": "शूलं शक्तिं च परशुं धुरिकां चर्म खेटकम् ।\nछत्रं ध्वजं गजं चाश्व गोवृषं पुस्तकं तुलाम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001732019, "chapter_id": 21732, "verse_number": "१-११८-२०", "content_sanskrit": "दंडं पाशं चक्रशंखौ गंधाद्यैरुपचारकैः ।\nसंपूज्य महिषं तत्र भद्रकाल्यै समालभेत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001732020, "chapter_id": 21732, "verse_number": "१-११८-२१", "content_sanskrit": "एवं बलिं विधायाथ भुक्त्वा पवान्नमेव च ।\nद्विजेभ्यो दक्षिणां दत्वा व्रतं तत्र समापयेत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001732021, "chapter_id": 21732, "verse_number": "१-११८-२२", "content_sanskrit": "एवं यः पूजयेद्दुर्गां नॄणां दुर्गतिनाशिनीम् ।\nइह भुक्त्वा वरान्भोगानंते स्वर्गतिमाप्नुयात् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001732022, "chapter_id": 21732, "verse_number": "१-११८-२३", "content_sanskrit": "कार्तिके शुक्लनवमी याऽक्षया सा प्रकीर्तता ।\nतस्यामश्वत्थमूले वै तर्प्पणं सम्यगाचरेत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001732023, "chapter_id": 21732, "verse_number": "१-११८-२४", "content_sanskrit": "देवानां च ऋषीणां च पितॄणां चापि नारद ।\nस्वशाखोक्तैस्तथा मंत्रैः सूर्यायार्घ्यं ततोऽर्पयेत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001732024, "chapter_id": 21732, "verse_number": "१-११८-२५", "content_sanskrit": "ततो द्विजान्भोजयित्वा मिष्टान्नेन मुनीश्वर ।\nस्वयं भुक्त्वा च विहरेद्द्विजेभ्यो दत्तदक्षिणः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001732025, "chapter_id": 21732, "verse_number": "१-११८-२६", "content_sanskrit": "एवं यः कुरुते भक्त्या जपदानं द्विजार्चनम् ।\nहोमं च सर्वमक्षय्यं भवेदिति विधेर्वयः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001732026, "chapter_id": 21732, "verse_number": "१-११८-२७", "content_sanskrit": "मार्गे तु शुक्लनवमी नंदिनी परिकीर्तिता ।\nतस्यामुपोषितो यस्तु जगदंबां प्रपूजयेत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001732027, "chapter_id": 21732, "verse_number": "१-११८-२८", "content_sanskrit": "गंधाद्यैः सोऽश्वमेधस्य फलभाङ्नात्र संशयः ।\nपौषे शुक्लनवम्यां तु महामायां प्रपूजयेत् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001732028, "chapter_id": 21732, "verse_number": "१-११८-२९", "content_sanskrit": "एकभक्तपरो विप्र वाजपेयफलाप्तये ।\nमाघमासे तु वा शुक्ला नवमी लोकपूजिता ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001732029, "chapter_id": 21732, "verse_number": "१-११८-३०", "content_sanskrit": "महानंदेति सा प्रोक्ता सदानंदकरी नृणाम् ।\nतस्यां स्नानं तथा दानं जपो होम उपोषणम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001732030, "chapter_id": 21732, "verse_number": "१-११८-३१", "content_sanskrit": "सर्वमक्षयतां याति नात्र कार्या विचारणा ।\nफाल्गुनामलपक्षस्य नवमी या द्विजोत्तम ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001732031, "chapter_id": 21732, "verse_number": "१-११८-३२", "content_sanskrit": "आनंदा सा महापुण्या सर्वपापहरा स्मृता ।\nसोपवासोऽर्चयेत्तत्र यस्त्वानंदां द्विजोत्तम ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001732032, "chapter_id": 21732, "verse_number": "१-११८-३३", "content_sanskrit": "स लभेद्वांछितान्कामान्सत्यं सत्यं मयोदितम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]