[{"id": 900008699, "chapter_id": 8694, "verse_number": "75.1", "content_sanskrit": "पूर्वत्र पृथगधिकरणीयाद्य सूत्रोक्तो..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900008700, "chapter_id": 8694, "verse_number": "75.2", "content_sanskrit": "अन्ये तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900008701, "chapter_id": 8694, "verse_number": "75.3", "content_sanskrit": "किं चेह किं जीवशब्देनानवच्छिन्नं शुद्धं ब्रह्म लक्ष्यते..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900008702, "chapter_id": 8694, "verse_number": "75.4", "content_sanskrit": "किं च गत्यादिशुद्धात्मनिष्ठमेव", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900008703, "chapter_id": 8694, "verse_number": "75.5", "content_sanskrit": "केचित्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}]