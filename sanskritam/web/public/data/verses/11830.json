[{"id": 50024109, "chapter_id": 11830, "verse_number": "1", "content_sanskrit": "अनन्तपारामितविक्रमेश प्रभो रमापारमनन्तपार। महागुणाढ्यापरिमेयसत्त्व रमालयाशेषमहा-गुणाढ्य॥ ७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024110, "chapter_id": 11830, "verse_number": "2", "content_sanskrit": "॥ भगवतः सर्ववर्णप्रतिपाद्यत्वसूचनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50024111, "chapter_id": 11830, "verse_number": "3", "content_sanskrit": "भा भा भा भा भा भा भा भा भा भा भा भा भा भा। भा भा भा भा भा भा भा भा भा भा भा भा भा भा॥ ७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50024112, "chapter_id": 11830, "verse_number": "4", "content_sanskrit": "॥ उपसंहारः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50024113, "chapter_id": 11830, "verse_number": "5", "content_sanskrit": "नैव परः केशवतः परमादस्मात् समश्च सुकेशवतः। 【पाठभेदः: BG—समश्च सुखकेशवतः।】 सोऽयं शपथवरो नः शश्वत् सन्धारितः सुशपथवरोऽनः॥ ७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50024114, "chapter_id": 11830, "verse_number": "6", "content_sanskrit": "कृष्णकथेयं यमिता सुखतीर्थेनोदिताऽनने 【पाठभेदः: BG—सुशतीर्थेनोदिताऽनने】 यं-यमिता। भक्तिमता परमेशे सर्वोद्रेकात् 【पाठभेदः: BG—सर्वोद्रेका】 सदानुताऽऽप रमेशे॥ ८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50024115, "chapter_id": 11830, "verse_number": "7", "content_sanskrit": "इति नारायणनामा सुखतीर्थसुपूजितः 【पाठभेदः: BG—इति नारायणनामाऽव कतीर्थं पूजितः】 सुरायण-ना मा। पूर्ण गुणैर्धिक पूर्णज्ञानेच्छाभक्तिभिः 【पाठभेदः: TRK—पूर्ण गुणैरधिक ज्ञानेच्छाभक्तिभिः】 स्वधिकपूर्ण॥ ८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50024116, "chapter_id": 11830, "verse_number": "8", "content_sanskrit": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचितं यमकभारतं सम्पूर्णम्॥ 【पाठभेदः: BG—॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचितं महाभारततात्पर्यं सम्पूर्णम्॥】", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}]