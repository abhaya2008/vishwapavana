[{"id": 2146003, "chapter_id": 4149, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2146004, "chapter_id": 4149, "verse_number": "१", "content_sanskrit": "राज्ञस्तु वचनं श्रुत्वा धर्मार्थसहितं हितम् ।\nकृष्णा दाशार्हमासीनमब्रवीच्छोककर्शिता\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2146005, "chapter_id": 4149, "verse_number": "२", "content_sanskrit": "सुता द्रुपदराजस्य स्वञ्चितायतमूर्धजा ।\nसम्पूज्य सहदेवं च सात्यकिं च महारथम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2146006, "chapter_id": 4149, "verse_number": "३", "content_sanskrit": "भीमसेनं च संशान्तं दृष्ट्वा परमदुर्मनाः ।\nअश्रुपूर्णेक्षणा वाक्यमुवाचेदं मनस्विनी\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2146007, "chapter_id": 4149, "verse_number": "४", "content_sanskrit": "विदितं ते महाबाहो धर्मज्ञ मधुसूदन ।\nयथा निकृतिमास्थाय भ्रंशिताः पाण्डवाः सुखात् ।\nधृतराष्ट्रस्य पुत्रेण सामात्येन जनार्दन \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2146008, "chapter_id": 4149, "verse_number": "५", "content_sanskrit": "यथा च सञ्जयो राज्ञा मन्त्रं रहसि श्रावितः ।\nयुधिष्ठिरेण दाशार्ह तच्चापि विदितं तव \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2146009, "chapter_id": 4149, "verse_number": "६", "content_sanskrit": "यथोक्तः सञ्जयश्चैव तच्च सर्वं श्रुतं त्वया\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2146010, "chapter_id": 4149, "verse_number": "७", "content_sanskrit": "पञ्च नस्तात दीयन्तां ग्रामा इति महाद्युते ।\nकुशस्थलं वृकस्थलं वासन्तीं वारणावतम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2146011, "chapter_id": 4149, "verse_number": "८", "content_sanskrit": "अवसानं महाबाहो किञ्चिदेकं च पञ्चमम् ।\nइति दुर्योधनो वाच्यः सुहृदश्चास्य केशव\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2146012, "chapter_id": 4149, "verse_number": "९", "content_sanskrit": "न चापि ह्यकरोद् वाक्यं श्रुत्वा कृष्ण सुयोधनः ।\nयुधिष्ठिरस्य दाशार्ह श्रीमतः सन्धिमिच्छतः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2146013, "chapter_id": 4149, "verse_number": "१०", "content_sanskrit": "अप्रदानेन राज्यस्य यदि कृष्ण सुयोधनः ।\nसन्धिमिच्छेन्न कर्तव्यं तत्र गत्वा कथञ्चन\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2146014, "chapter_id": 4149, "verse_number": "११", "content_sanskrit": "शक्ष्यन्ति हि महाबाहो पाण्डवाः सृञ्जयैः सह ।\nधार्तराष्ट्रबलं घोरं क्रुद्धं प्रतिसमासितुम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2146015, "chapter_id": 4149, "verse_number": "१२", "content_sanskrit": "न हि साम्ना न दानेन शक्योऽर्थस्तेषु कश्चन ।\nतस्मात् तेषु न कर्तव्या कृपा ते मधुसूदन\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2146016, "chapter_id": 4149, "verse_number": "१३", "content_sanskrit": "साम्ना दानेन वा कृष्ण ये न शाम्यन्ति शत्रवः ।\nक्षेप्तव्यास्ते तु दण्डेन जीवितं परिरक्षता\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2146017, "chapter_id": 4149, "verse_number": "१४", "content_sanskrit": "तस्मात् तेषु महान् दण्डः क्षेप्तव्यः क्षिप्रमच्युत ।\nत्वया चैव महाबाहो पाण्डवैः सह सृञ्जयैः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2146018, "chapter_id": 4149, "verse_number": "१५", "content_sanskrit": "एतत् समर्थं पार्थानां तव चैव यशस्करम् ।\nक्रियमाणं भवेत् कृष्ण क्षत्रस्य च सुखावहम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2146019, "chapter_id": 4149, "verse_number": "१६", "content_sanskrit": "क्षत्रियेण हि हन्तव्यः क्षत्रियो लोभमास्थितः ।\nअक्षत्रियो वा दाशार्ह स्वधर्ममनुतिष्ठता\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2146020, "chapter_id": 4149, "verse_number": "१७", "content_sanskrit": "अन्यत्र ब्राह्मणात् तात सर्वपापेष्ववस्थितम् ।\nगुरुर्हि सर्ववर्णानां ब्राह्मणः प्रसृताग्रभुक्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2146021, "chapter_id": 4149, "verse_number": "१८", "content_sanskrit": "यथाऽवध्ये भवेद् दोषो वध्यमाने जनार्दन ।\nस वध्यस्यावधे दोष इति धर्मविदो विदुः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2146022, "chapter_id": 4149, "verse_number": "१९", "content_sanskrit": "यथा त्वां न स्पृशेदेष दोषः कृष्ण तथा कुरु ।\nपाण्डवैः सह दाशार्ह सृञ्जयैश्च महाबल\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2146023, "chapter_id": 4149, "verse_number": "२०", "content_sanskrit": "पुनरुक्तं च वक्ष्यामि विस्रम्भेण जनार्दन ।\nका नु सीमन्तिनी मादृक् पृथिव्यामस्ति केशव\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2146024, "chapter_id": 4149, "verse_number": "२१", "content_sanskrit": "सुता द्रुपदराजस्य वेदिमध्यात् समुत्थिता ।\nधृष्टद्युम्नस्य भगिनी तव कृष्ण प्रिया सखी\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2146025, "chapter_id": 4149, "verse_number": "२२", "content_sanskrit": "आजमीढकुलं प्राप्ता स्नुषा पाण्डोर्महात्मनः ।\nमहिषी पाण्डुपुत्राणां पञ्चेन्द्रसमवर्चसाम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2146026, "chapter_id": 4149, "verse_number": "२३", "content_sanskrit": "सुता मे पञ्चभिर्वीरैः पञ्च जाता महारथाः ।\nअभिमन्युर्यथा कृष्ण तथा ते तव धर्मतः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2146027, "chapter_id": 4149, "verse_number": "२४", "content_sanskrit": "साऽहं केशग्रहं प्राप्ता परिक्लिष्टा सभां गता ।\nपश्यतां पाण्डुपुत्राणां त्वयि जीवति केशव\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2146028, "chapter_id": 4149, "verse_number": "२५", "content_sanskrit": "जीवत्सु पाण्डुपुत्रेषु पाञ्चालेष्वथ वृष्णिषु ।\nदासीभूताऽस्मि पापानां सभामध्ये व्यवस्थिता\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2146029, "chapter_id": 4149, "verse_number": "२६", "content_sanskrit": "निरमर्षेष्वचेष्टेषु प्रेक्षमाणेषु पाण्डुषु ।\nपाहि मामिति गोविन्द मनसा चिन्तितोऽस्मि मे\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2146030, "chapter_id": 4149, "verse_number": "२७", "content_sanskrit": "यत्र मां भगवन् राजा श्वशुरो वाक्यमब्रवीत् ।\nवरं वृणीष्व पाञ्चालि वरार्हाऽसि मता मम\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2146031, "chapter_id": 4149, "verse_number": "२८", "content_sanskrit": "अदासाः पाण्डवाः सन्तु सरथाः सायुधा इति ।\nमयोक्ते यत्र निर्मुक्ता वनवासाय केशव\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2146032, "chapter_id": 4149, "verse_number": "२९", "content_sanskrit": "एवंविधानां दुःखानामभिज्ञोऽसि जनार्दन ।\nत्राहि मां पुण्डरीकाक्ष सभर्तृज्ञातिबान्धवाम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2146033, "chapter_id": 4149, "verse_number": "३०", "content_sanskrit": "नन्वहं कृष्ण भीष्मस्य धृतराष्ट्रस्य चोभयोः ।\nस्नुषा भवामि धर्मेण साऽहं दासीकृताऽभवम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2146034, "chapter_id": 4149, "verse_number": "३१", "content_sanskrit": "धिक् पार्थस्य धनुष्मत्तां भीमसेनस्य धिग् बलम् ।\nयत्र दुर्योधनः कृष्ण मुहूर्तमपि जीवति\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2146035, "chapter_id": 4149, "verse_number": "३२", "content_sanskrit": "यदि तेऽहमनुग्राह्या यदि तेऽस्ति कृपा मयि ।\nधार्तराष्ट्रेषु वै कोपः सर्वः कृष्ण विधीयताम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2146036, "chapter_id": 4149, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2146037, "chapter_id": 4149, "verse_number": "३३", "content_sanskrit": "इत्युक्त्वा मृदुसम्भारं वृजिनाग्रं सुदर्शनम् ।\nसुनीलमसितापाङ्गी पुण्यगन्धाधिवासितम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2146038, "chapter_id": 4149, "verse_number": "३४", "content_sanskrit": "सर्वलक्षणसम्पन्नं महाभुजगवर्चसम् ।\nकेशपक्षं वरारोहा गृह्य सव्येन पाणिना\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2146039, "chapter_id": 4149, "verse_number": "३५", "content_sanskrit": "पद्माक्षी पुण्डरीकाक्षमुपेत्य गजगामिनी ।\nअश्रुपूर्णेक्षणा कृष्णा कृष्णं वचनमब्रवीत्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2146040, "chapter_id": 4149, "verse_number": "३६", "content_sanskrit": "अयं ते पुण्डरीकाक्ष दुःशासनकरोद्धृतः ।\nस्मर्तव्यः सर्वकालेषु परेषां सन्धिमिच्छताम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2146041, "chapter_id": 4149, "verse_number": "३७", "content_sanskrit": "यदि भीमार्जुनौ कृष्ण कृपणौ सन्धिकामुकौ ।\nपिता मे योत्स्यते वृद्धः सह पुत्रैर्महारथैः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2146042, "chapter_id": 4149, "verse_number": "३८", "content_sanskrit": "पञ्च चैव महावीर्याः पुत्रा मे मधुसूदन ।\nअभिमन्युं पुरस्कृत्य योत्स्यन्ते कुरुभिः सह\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2146043, "chapter_id": 4149, "verse_number": "३९", "content_sanskrit": "दुःशासनभुजं श्यामं सञ्छिन्नं पांसुकुण्ठितम् ।\nयद्यहं तु न पश्यामि का शान्तिर्हृदयस्य मे\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2146044, "chapter_id": 4149, "verse_number": "४०", "content_sanskrit": "त्रयोदश हि वर्षाणि प्रतीक्षन्त्या गतानि मे ।\nनिधाय हृदये मन्युं प्रदीप्तमिव पावकम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2146045, "chapter_id": 4149, "verse_number": "४१", "content_sanskrit": "विदीर्यते मे हृदयं भीमवाक्छल्यपीडितम् ।\nयोऽयमद्य महाबाहुर्धर्मं समनुपश्यति\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2146046, "chapter_id": 4149, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2146047, "chapter_id": 4149, "verse_number": "४२", "content_sanskrit": "इत्युक्त्वा बाष्पसन्नेन कण्ठेनायतलोचना ।\nरुरोद कृष्णा सोत्कण्ठं सुस्वरं बाष्पगद्गदम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2146048, "chapter_id": 4149, "verse_number": "४३", "content_sanskrit": "स्तनौ पीनायतश्रोणी सहितावभिवर्षती ।\nद्रवीभूतमिवात्युष्णं मुञ्चन्ती वारि नेत्रजम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2146049, "chapter_id": 4149, "verse_number": "४४", "content_sanskrit": "तामुवाच महाबाहुः केशवः परिसान्त्वयन्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2146050, "chapter_id": 4149, "verse_number": "४५", "content_sanskrit": "अचिराद् द्रक्ष्यसे कृष्णे रुदतीर्भरतस्त्रियः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2146051, "chapter_id": 4149, "verse_number": "४६", "content_sanskrit": "एवं ता भीरु रोत्स्यन्ति निहतज्ञातिबान्धवाः ।\nहतमित्रा हतबला येषां क्रुद्धाऽसि भामिनि\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2146052, "chapter_id": 4149, "verse_number": "४७", "content_sanskrit": "अहं च तत् करिष्यामि भीमार्जुनयमैः सह ।\nयुधिष्ठिरनियोगेन दैवाच्च विधिनिर्मितात्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2146053, "chapter_id": 4149, "verse_number": "४८", "content_sanskrit": "धार्तराष्ट्राः कालपक्वा न चेच्छृण्वन्ति मे वचः ।\nशेष्यन्ते निहता भूमौ श्वसृगालादनीकृताः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2146054, "chapter_id": 4149, "verse_number": "४९", "content_sanskrit": "चलेद्धि हिमवान् शैलो मेदिनी शकलीभवेत् ।\nद्यौः पतेच्च सनक्षत्रा न मे मोघं वचो भवेत्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2146055, "chapter_id": 4149, "verse_number": "५०", "content_sanskrit": "शुष्येत् तोयनिधिः कृष्णे न मे मोघं वचो भवेत्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2146056, "chapter_id": 4149, "verse_number": "५१", "content_sanskrit": "सत्यं ते प्रतिजानामि कृष्णे बाष्पो निगृह्यताम् ।\nहतामित्रान् श्रिया युक्तान् अचिराद् द्रक्ष्यसे पतीन्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2146057, "chapter_id": 4149, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि अशीतितमोऽध्यायः ॥८०॥\nभगवद्यानपर्वणि एकादशोऽध्यायः ॥११॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]