[{"id": 2131598, "chapter_id": 3843, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2131599, "chapter_id": 3843, "verse_number": "१", "content_sanskrit": "तस्यां रात्र्यां व्यतीतायां धर्मराजो युधिष्ठिरः ।\nउत्थायावश्यकार्याणि कृतवान् भ्रातृभिः सह ।\nततः सञ्चोदयामास सोऽर्जुनं मा(भ्रा)तृनन्दनम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2131600, "chapter_id": 3843, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2131601, "chapter_id": 3843, "verse_number": "२", "content_sanskrit": "दर्शयास्त्राणि कौन्तेय यैर्जिता दानवास्त्वया \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2131602, "chapter_id": 3843, "verse_number": "३", "content_sanskrit": "ततो धनञ्जयो राजन् देवैर्दत्तानि पाण्डवः ।\nअस्त्राणि तानि दिव्यानि दर्शयामास भारत\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2131603, "chapter_id": 3843, "verse_number": "४", "content_sanskrit": "यथान्यायं महातेजाः शौचं परममास्थितः ।\nनमस्कृत्य त्रिनेत्राय वासवाय च पाण्डवः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2131604, "chapter_id": 3843, "verse_number": "५", "content_sanskrit": "त्रिकूबरं समुद्रं च त्रिभिर्वंशैस्त्रिवेणुकम् ।\nपार्थिवं रथमास्थाय शोभमानो धनञ्जयः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2131605, "chapter_id": 3843, "verse_number": "६", "content_sanskrit": "दिव्येन संवृतस्तेन कवचेन सुवर्चसा ।\nधनुरादाय गाण्डीवं देवदत्तं स वारिजम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2131606, "chapter_id": 3843, "verse_number": "७", "content_sanskrit": "शोशुभ्यमानः कौन्तेय आनुपूर्व्यान्महाभुजः ।\nअस्त्राणि तानि दिव्यानि दर्शनायोपचक्रमे\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2131607, "chapter_id": 3843, "verse_number": "८", "content_sanskrit": "अथ प्रयोक्ष्यमाणेषु दिव्येष्वस्त्रेषु तेषु वै।\nसमाक्रान्ता मही पद्भ्यां समकम्पत सद्रुमा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2131608, "chapter_id": 3843, "verse_number": "९", "content_sanskrit": "क्षुभिताः सरितश्चैव तथैव च महोदधिः ।\nशैलाश्चापि व्यदीर्यन्त न ववौ च समीरणः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2131609, "chapter_id": 3843, "verse_number": "१०", "content_sanskrit": "न बभासे सहस्रांशुर्न जज्वाल च पावकः ।\nन वेदाः प्रतिभान्ति स्म द्विजातीनां कथञ्चन\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2131610, "chapter_id": 3843, "verse_number": "११", "content_sanskrit": "अन्तर्भूमिगता ये च प्राणिनो जनमेजय ।\nपीड्यमानाः समुत्थाय पाण्डवं पर्यवारयन् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2131611, "chapter_id": 3843, "verse_number": "१२", "content_sanskrit": "वेपमानाः प्राञ्जलयस्ते सर्वे विकृताननाः ।\nदह्यमानास्तदास्त्रैस्ते याचन्ति स्म धनञ्जयम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2131612, "chapter_id": 3843, "verse_number": "१३", "content_sanskrit": "ततो ब्रह्मर्षयश्चैव सिद्धा ये च महर्षयः ।\nजङ्गमानि च भूतानि सर्वाण्येवावतस्थिरे\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2131613, "chapter_id": 3843, "verse_number": "१४", "content_sanskrit": "देवर्षयश्च प्रवरास्तथैव च दिवौकसः ।\nयक्षराक्षसगन्धर्वास्तथैव च पतत्त्रिणः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2131614, "chapter_id": 3843, "verse_number": "", "content_sanskrit": "खेचराणि च भूतानि सर्वाण्येवावतस्थिरे ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2131615, "chapter_id": 3843, "verse_number": "१५", "content_sanskrit": "ततो पितामहश्चैव लोकपालाश्च सर्वशः ।\nभगवांश्च महादेवः सगणोऽभ्याययौ तदा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2131616, "chapter_id": 3843, "verse_number": "१६", "content_sanskrit": "ततो वायुर्महाराज दिव्यैर्माल्यैः सुगन्धिभिः ।\nअभितः पाण्डवं चित्रैरवचक्रे समन्ततः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2131617, "chapter_id": 3843, "verse_number": "१७", "content_sanskrit": "जगुश्च गाथा विविधा गन्धर्वाः सुरचोदिताः ।\nननृतुः सङ्घशश्चैव राजन्नप्सरसां गणाः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2131618, "chapter_id": 3843, "verse_number": "", "content_sanskrit": "देवतूर्याण्यवाद्यन्त रम्याणि मधुराणि च ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2131619, "chapter_id": 3843, "verse_number": "१८", "content_sanskrit": "तस्मिंश्च तादृशे काले नारदश्चोदितः सुरैः ।\nआगम्याह वचः पार्थं श्रवणीयमिदं नृप\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2131620, "chapter_id": 3843, "verse_number": "१९", "content_sanskrit": "अर्जुनार्जुन मा युङ्क्ष्व दिव्यान्यस्त्राणि भारत ।\nनैतानि निरधिष्ठाने प्रयुज्यन्ते कथञ्चन ।\nप्रयोगेषु महान् दोषो ह्यस्त्राणां कुरुनन्दन\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2131621, "chapter_id": 3843, "verse_number": "२०", "content_sanskrit": "एतानि रक्ष्यमाणानि धनञ्जय यथागमम् ।\nबलवन्ति सुखार्हाणि भविष्यन्ति न संशयः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2131622, "chapter_id": 3843, "verse_number": "२१", "content_sanskrit": "अरक्ष्यमाणान्येतानि त्रैलोक्यस्यापि पाण्डव ।\nभवन्ति स्म विनाशाय मैवं भूयः कृथाः क्वचित्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2131623, "chapter_id": 3843, "verse_number": "२२", "content_sanskrit": "अजातशत्रो त्वं चैव द्रक्ष्यसे तानि संयुगे।\nयोज्यमानानि पार्थेन द्विषतामवमर्दने\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2131624, "chapter_id": 3843, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2131625, "chapter_id": 3843, "verse_number": "२३", "content_sanskrit": "निवार्याथ ततः पार्थं सर्वे देवा यथागतम् ।\nजग्मुरन्ये च ये तत्र समाजग्मुर्नरर्षभ\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2131626, "chapter_id": 3843, "verse_number": "२४", "content_sanskrit": "तेषु सर्वेषु कौरव्य प्रतियातेषु पाण्डवाः ।\nतस्मिन्नेव वने हृष्टास्त ऊषुः सह कृष्णया\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2131627, "chapter_id": 3843, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2131628, "chapter_id": 3843, "verse_number": "१७०", "content_sanskrit": "सप्तत्यधिकशततमोऽध्यायः ॥ १७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2131629, "chapter_id": 3843, "verse_number": "१७", "content_sanskrit": "यक्षयुद्धपर्वणि सप्तदशोऽध्यायः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2131630, "chapter_id": 3843, "verse_number": "", "content_sanskrit": "॥ समाप्तं यक्षयुद्धपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]