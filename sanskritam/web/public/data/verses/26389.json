[{"id": 7006389000, "chapter_id": 26389, "verse_number": "२-४६-१", "content_sanskrit": "वैशम्पायन उवाच\nकस्यचित् त्वथ कालस्य स्मृत्वा गोपेषु सौहृदम् ।\nजगामैको व्रजं रामः कृष्णस्यानुमते स्थितः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006389001, "chapter_id": 26389, "verse_number": "२-४६-२", "content_sanskrit": "स गतस्तत्र रम्याणि ददर्श विपुलानि वै ।\nभुक्तपूर्वाण्यरण्यानि सरांसि सुरभीणि च ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006389002, "chapter_id": 26389, "verse_number": "२-४६-३", "content_sanskrit": "स प्रविष्टस्तु वेगेन तं व्रजं कृष्णपूर्वजः ।\nवन्येन रमणीयेन वेषेणालंकृतः प्रभुः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006389003, "chapter_id": 26389, "verse_number": "२-४६-४", "content_sanskrit": "स तानभाषत प्रीत्या यथापूर्वमरिंदमः ।\nगोपांस्तेनैव विधिना यथान्यायं यथावयः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006389004, "chapter_id": 26389, "verse_number": "२-४६-५", "content_sanskrit": "तथैव प्राह तान सर्वांस्तथैव परिहर्षयन् ।\nतथैव सह गोपीभिर्योजयन्मधुराः कथाः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006389005, "chapter_id": 26389, "verse_number": "२-४६-६", "content_sanskrit": "तमूचुः स्थविरा गोपाः प्रियं मधुरभाषिणः ।\nरामं रमयतां श्रेष्ठं प्रवासात् पुनरागतम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006389006, "chapter_id": 26389, "verse_number": "२-४६-७", "content_sanskrit": "स्वागतं ते महाबाहो यदूनां कुलनन्दन ।\nअद्य स्म निर्वृतास्तात यत् त्वां पश्यामहे वयम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006389007, "chapter_id": 26389, "verse_number": "२-४६-८", "content_sanskrit": "प्रीताश्चैव वयं वीर यत् त्वं पुनरिहागतः ।\nविख्यातस्त्रिषु लोकेषु रामः शत्रुभयंकरः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006389008, "chapter_id": 26389, "verse_number": "२-४६-९", "content_sanskrit": "वर्धनीया वयं वीर त्वया यादवनन्दन ।\nअथवा प्राणिनस्तात रमन्ते जन्मभूमिषु ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006389009, "chapter_id": 26389, "verse_number": "२-४६-१०", "content_sanskrit": "त्रिदशानां वयं मान्या ध्रुवमद्यामलानन ।\nये स्म दृष्टास्त्वया तात काङ्क्षमाणास्तवागमम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006389010, "chapter_id": 26389, "verse_number": "२-४६-११", "content_sanskrit": "दिष्ट्या ते निहता मल्लाः कंसश्च विनिपातितः ।\nउग्रसेनोऽभिषिक्तश्च माहात्म्येन जनेन वै ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006389011, "chapter_id": 26389, "verse_number": "२-४६-१२", "content_sanskrit": "समुद्रे च श्रुतोऽस्माभिस्तिमिना सह विग्रहः ।\nवधः पञ्चजनस्यैव जरासंधेन विग्रहः ।\nगोमन्ते च श्रुतोऽस्माभिः क्षत्रियैः सह विग्रहः। ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006389012, "chapter_id": 26389, "verse_number": "२-४६-१३", "content_sanskrit": "दरदस्य वधश्चैव जरासंधपराजयः ।\nतत्रायुधावतरणं श्रुत नः परमाहवे ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006389013, "chapter_id": 26389, "verse_number": "२-४६-१४", "content_sanskrit": "वधश्चैव शृगालस्य करवीरपुरोत्तमे ।\nतत्सुतस्याभिषेकश्च नागराणां च सान्त्वनम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006389014, "chapter_id": 26389, "verse_number": "२-४६-१५", "content_sanskrit": "मथुरायां प्रवेशश्च कीर्तनीयः सुरोत्तमैः ।\nप्रतिष्ठिता च वसुधा पार्थिवाश्च वशीकृताः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006389015, "chapter_id": 26389, "verse_number": "२-४६-१६", "content_sanskrit": "तव चागमनं दृष्ट्वा सभाग्याः स्म यथा पुरा ।\nतेन स्म परितुष्टा वै हृषिताश्च सबान्धवाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006389016, "chapter_id": 26389, "verse_number": "२-४६-१७", "content_sanskrit": "प्रत्युवाच ततो रामः सर्वांस्तानभितः स्थितान् ।\nयादवेष्वपि सर्वेषु भवन्तो मम बान्धवाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006389017, "chapter_id": 26389, "verse_number": "२-४६-१८", "content_sanskrit": "इहावयोर्गतं बाल्यमिह चैवावयो रतम् ।\nभवद्भिर्वर्द्धिताश्चैव यास्यामो विक्रियां कथम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006389018, "chapter_id": 26389, "verse_number": "२-४६-१९", "content_sanskrit": "गृहेषु भवतां भुक्तं गावश्च परिरक्षिताः ।\nअस्माकं बान्धवाः सर्वे भवन्तो बद्धसौहृदाः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006389019, "chapter_id": 26389, "verse_number": "२-४६-२०", "content_sanskrit": "ब्रुवत्येवं यथातत्त्वं गोपमध्ये हलायुधे ।\nसंहृष्टवदना भूयो बभूबुर्व्रजयोषितः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006389020, "chapter_id": 26389, "verse_number": "२-४६-२१", "content_sanskrit": "ततो वनान्तरगतो रेमे रामो महाबलः ।\nएतस्मिन्नन्तरे प्राप्ते रामाय विदितात्मने ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006389021, "chapter_id": 26389, "verse_number": "२-४६-२२", "content_sanskrit": "गोपालैर्देशकालज्ञैरुपानीयत वारुणी ।\nसोऽपिबत् पाण्डुराभ्राभस्तत्कालं ज्ञातिभिर्वृतः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006389022, "chapter_id": 26389, "verse_number": "२-४६-२३", "content_sanskrit": "वनान्तरगतो रामः पानं मदसमीरणम् ।\nउपनिन्युस्ततस्तस्मै वन्यानि विविधानि च ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006389023, "chapter_id": 26389, "verse_number": "२-४६-२४", "content_sanskrit": "प्रत्यग्ररमणीयानि पुष्पाणि च फलानि च ।\nमेध्यांश्च विविधान् गन्धान् भक्ष्यांश्च हृदयंगमान् ।\nसद्यो हृतानि पद्मानि विकचान्युत्पलानि च ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006389024, "chapter_id": 26389, "verse_number": "२-४६-२५", "content_sanskrit": "शिरसा चारुकेशैन किंचिदावृतमौलिना ।\nश्रवणैकावलम्बेन कुण्डलेन विराजता ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006389025, "chapter_id": 26389, "verse_number": "२-४६-२६", "content_sanskrit": "चन्दनार्द्रेण पीतेन वनमालावलम्बिना ।\nविबभावुरसा रामः कैलासेनेव मन्दरः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006389026, "chapter_id": 26389, "verse_number": "२-४६-२७", "content_sanskrit": "नीले वसानो वसने प्रत्यग्रजलदप्रभे ।\nरराज वपुषा शुभ्रस्तिमिरौघे यथा शशी ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006389027, "chapter_id": 26389, "verse_number": "२-४६-२८", "content_sanskrit": "लाङ्गलेनावसिक्तेन भुजगाभोगवर्तिना ।\nतथा भुजाग्रश्लिष्टेन मुसलेन च भास्वता ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006389028, "chapter_id": 26389, "verse_number": "२-४६-२९", "content_sanskrit": "स मत्तो बलिनां श्रेष्ठो रराजाघूर्णिताननः ।\nशैशिरीषु त्रियामासु यथा स्वेदालसः शशी ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006389029, "chapter_id": 26389, "verse_number": "२-४६-३०", "content_sanskrit": "रामस्तु यमुनामाह स्नातुमिच्छे महानदि ।\nएहि मामभिगच्छ त्वं रूपिणी सागरंगमे ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006389030, "chapter_id": 26389, "verse_number": "२-४६-३१", "content_sanskrit": "संकर्षणस्य मत्तोक्तां भारतीं परिभूय सा ।\nनाभ्यवर्तत तं देशं स्त्रीस्वभावेन मोहिता ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006389031, "chapter_id": 26389, "verse_number": "२-४६-३२", "content_sanskrit": "ततश्चुक्रोध बलवान् रामो मदसमीरितः ।\nचकार स हलं हस्ते कर्षणाधोमुखं बली ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006389032, "chapter_id": 26389, "verse_number": "२-४६-३३", "content_sanskrit": "तस्यामुपरि मेदिन्यां पेतुस्तामरसस्रजः ।\nमुमुचुः पुष्पकोशैश्च वासरेण्वरुणं जलम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006389033, "chapter_id": 26389, "verse_number": "२-४६-३४", "content_sanskrit": "स हलेनानताग्रेण कूले गृह्य महानदीम् ।\nचकर्ष यमुनां रामो न्युत्थितां वनितामिव ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006389034, "chapter_id": 26389, "verse_number": "२-४६-३५", "content_sanskrit": "सा विह्वलजलस्रोता ह्रदप्रस्थितसंचया ।\nव्यावर्तत नदी भीता हलमार्गानुसारिणी ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006389035, "chapter_id": 26389, "verse_number": "२-४६-३६", "content_sanskrit": "लाङ्गलादिष्टवर्त्मा सा वेगगा वक्रगामिनी ।\nसंकर्षणभयत्रस्ता योषेवाकुलतां गता ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006389036, "chapter_id": 26389, "verse_number": "२-४६-३७", "content_sanskrit": "पुलिनश्रोणिबिम्बौष्ठी मृदितैस्तोयताडितैः ।\nफेनमेखलसूत्रैश्च च्छिन्नैरम्बुदगामिनी ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006389037, "chapter_id": 26389, "verse_number": "२-४६-३८", "content_sanskrit": "तरङ्गविषमापीडा चक्रवाकोन्मुखस्तनी ।\nवेगगम्भीरवक्राङ्गी त्रस्तमीनविभूषणा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006389038, "chapter_id": 26389, "verse_number": "२-४६-३९", "content_sanskrit": "सितहंसेक्षणापाङ्गी काशक्षौमोच्छ्रिताम्बरा ।\nतीरजोद्भूतकेशान्ता जलस्खलितगामिनी ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006389039, "chapter_id": 26389, "verse_number": "२-४६-४०", "content_sanskrit": "लाङ्गलोल्लिखितापाङ्गी क्षुभिता सागरंगमा ।\nमत्तेव कुटिला नारी राजमार्गेण गच्छती ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006389040, "chapter_id": 26389, "verse_number": "२-४६-४१", "content_sanskrit": "कृष्यते सातिवेगेन स्रोतःस्खलितगामिनी ।\nउन्मार्गानीतमार्गा सा येन वृन्दावनं वनम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006389041, "chapter_id": 26389, "verse_number": "२-४६-४२", "content_sanskrit": "वृन्दावनस्य मध्येन सा नीता यमुना नदी ।\nरोरूयमाणेव खगैरन्विता तोयवासिभिः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006389042, "chapter_id": 26389, "verse_number": "२-४६-४३", "content_sanskrit": "सा यदा समतिक्रान्ता नदी वृन्दावनं वनम् ।\nतदा स्त्रीरूपिणी भूत्वा यमुना राममब्रवीत् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006389043, "chapter_id": 26389, "verse_number": "२-४६-४४", "content_sanskrit": "प्रसीद नाथ भीतास्मि प्रतिलोमेन कर्मणा ।\nविपरीतमिदं रूपं तोयं च मम जायते ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006389044, "chapter_id": 26389, "verse_number": "२-४६-४५", "content_sanskrit": "असत्यहं नदीमध्ये रौहिणेय त्वया कृता ।\nकर्षणेन महाबाहो स्वमार्गव्यभिचारिणी ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006389045, "chapter_id": 26389, "verse_number": "२-४६-४६", "content_sanskrit": "प्राप्तां मां सागरे पूर्वं सपत्न्यो वेगगर्विताः ।\nफेनहासैर्हसिष्यन्ति तोयव्यावृत्तगामिनीम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006389046, "chapter_id": 26389, "verse_number": "२-४६-४७", "content_sanskrit": "प्रसादं कुरु मे वीर याचे त्वां कृष्णपूर्वज ।\nसुप्रसन्नमना नित्यं भव त्वं सुरसत्तम ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006389047, "chapter_id": 26389, "verse_number": "२-४६-४८", "content_sanskrit": "कर्षणायुधकृष्टास्मि रोषोऽयं विनिवर्त्यताम् ।\nमूर्ध्ना गच्छामि चरणौ तवैषा लाङ्गलायुध ।\nमार्गमादिष्टमिच्छामि क्व गच्छामि महाभुज ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006389048, "chapter_id": 26389, "verse_number": "२-४६-४९", "content_sanskrit": "वैशम्पायन उवाच\nप्रणयावनतां दृष्ट्वा यमुनां लाङ्गलायुधः ।\nप्रत्युवाचार्णववधूं मदक्लान्त इद वचः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006389049, "chapter_id": 26389, "verse_number": "२-४६-५०", "content_sanskrit": "लाङ्गलादिष्टमार्गा त्वमिमं मे प्रियदर्शने ।\nदेशमम्बुप्रदानेन प्लावयस्वाखिलं शुभे ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006389050, "chapter_id": 26389, "verse_number": "२-४६-५१", "content_sanskrit": "एष ते सुभ्रु संदेशः कथितः सागरंगमे ।\nशान्तिं व्रज महाभागे गम्यतां च यथासुखम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006389051, "chapter_id": 26389, "verse_number": "२-४६-५२", "content_sanskrit": "यावत्स्थास्यति लोकोऽयं तावत्तिष्ठतु मे यशः।\nयमुनाकर्षणं दृष्ट्वा सर्वे ते व्रजवासिनः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006389052, "chapter_id": 26389, "verse_number": "२-४६-५३", "content_sanskrit": "साधु साध्विति रामाय प्रणामं चक्रिरे तदा ।\nतां विसृज्य महाभागा तांश्च सर्वान् व्रजौकसः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006389053, "chapter_id": 26389, "verse_number": "२-४६-५४", "content_sanskrit": "ततः संचिन्त्य मनसा रामः प्रहरतां वरः ।\nपुनः प्रतिजगामाशु मथुरां रोहिणीसुतः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006389054, "chapter_id": 26389, "verse_number": "२-४६-५५", "content_sanskrit": "स गत्वा मथुरां रामो भवनं मधुसूदनम् ।\nपरिवर्तमानं ददृशे पृथिव्याः सारमव्ययम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006389055, "chapter_id": 26389, "verse_number": "२-४६-५६", "content_sanskrit": "तथैवाध्वन्यवेषेण सोपश्लिष्टो जनार्दनम् ।\nप्रत्यग्रवनमालेन वक्षसाभिविराजता ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006389056, "chapter_id": 26389, "verse_number": "२-४६-५७", "content_sanskrit": "स दृष्ट्वा तूर्णमायान्तं रामं लाङ्गलधारिणम् ।\nसहसोत्थाय गोविन्दो ददावासनमुत्तमम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006389057, "chapter_id": 26389, "verse_number": "२-४६-५८", "content_sanskrit": "उपविष्टं तदा रामं पप्रच्छ कुशलं व्रजे ।\nबान्धवेषु च सर्वेषु गोषु चैव जनार्दनः ॥ ।५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006389058, "chapter_id": 26389, "verse_number": "२-४६-५९", "content_sanskrit": "प्रत्युवाच ततो रामो भ्रातरं साधुभाषिणम् ।\nसर्वत्र कुशलं कृष्ण येषां कुशलमिच्छसि ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006389059, "chapter_id": 26389, "verse_number": "२-४६-६०", "content_sanskrit": "ततस्तयोर्विचित्रार्थाः पौराण्यश्चाभवन् कथाः ।\nवसुदेवाग्रतः पुण्या रामकेशवयोस्तदा ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]