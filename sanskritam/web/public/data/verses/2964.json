[{"id": 2092288, "chapter_id": 2964, "verse_number": "१३-९४-१", "content_sanskrit": "युधिष्ठिर उवाच।\nयानीमानि बहिर्वेद्यां दानानि परिचक्षते।\nतेभ्यो विशिष्टं किं दानं मतं ते कुरुपुङ्गव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2092289, "chapter_id": 2964, "verse_number": "१३-९४-२", "content_sanskrit": "कौतूहलं हि परमं तत्र मे विद्यते प्रभो।\nदातारं दत्तमन्वेति यद्दानं तत्प्रचक्ष्व मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2092290, "chapter_id": 2964, "verse_number": "१३-९४-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2092291, "chapter_id": 2964, "verse_number": "१३-९४-३", "content_sanskrit": "अभयं सर्वभूतेभ्यो व्यसने चाप्यनुग्रहः।\nयच्चाभिलषितं दद्यात्तृषितायाभियाचते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2092292, "chapter_id": 2964, "verse_number": "१३-९४-४", "content_sanskrit": "भरणे पुत्रदाराणां तद्दानं श्रेष्ठमुच्यते।\nदत्तं दातारमन्वेति तद्दानं भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2092293, "chapter_id": 2964, "verse_number": "१३-९४-५", "content_sanskrit": "हिरण्यदानं गोदानं पृथिवीदानमेव च।\nएतानि वै पवित्राणि तारयन्त्यपि दुष्कृतात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2092294, "chapter_id": 2964, "verse_number": "१३-९४-६", "content_sanskrit": "एतानि पुरुषव्याघ्र साधुभ्यो देहि नित्यदा।\nदानानि हि नरं पापान्मोक्षयन्ति न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2092295, "chapter_id": 2964, "verse_number": "१३-९४-७", "content_sanskrit": "यद्यदिष्टतमं लोके यच्चास्य दयितं गृहे।\nतत्तद्गुणवते देयं तदेवाक्षयमिच्छता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2092296, "chapter_id": 2964, "verse_number": "१३-९४-८", "content_sanskrit": "प्रियाणि लभते नित्यं प्रियदः प्रियकृत्तथा।\nप्रियो भवति भूतानामिह चैव परत्र च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2092297, "chapter_id": 2964, "verse_number": "१३-९४-९", "content_sanskrit": "याचमानमभीमानादनासक्तमकिञ्चनम्।\nयो नार्चति यथाशक्ति स नृशंसो युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2092298, "chapter_id": 2964, "verse_number": "१३-९४-१०", "content_sanskrit": "अमित्रमपि चेद्दीनं शरणैषिणमागतम्।\nव्यसने योऽनुगृह्णाति स वै पुरुषसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2092299, "chapter_id": 2964, "verse_number": "१३-९४-११", "content_sanskrit": "कृशाय कृतविद्याय वृत्तिक्षीणाय सीदते।\nअपहन्यात्क्षुधां यस्तु न तेन पुरुषः समः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2092300, "chapter_id": 2964, "verse_number": "१३-९४-१२", "content_sanskrit": "क्रियानियमितान्साधुन्पुत्रदारैश्च कर्शितान्।\nअयाचमानान्कौन्तेय सर्वोपायैर्निमन्त्रयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2092301, "chapter_id": 2964, "verse_number": "१३-९४-१३", "content_sanskrit": "आशिषं ये न देवेषु न च मर्त्येषु कुर्वते।\nअर्हन्तो नित्यसत्वस्था यथालब्धोपजीविनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2092302, "chapter_id": 2964, "verse_number": "१३-९४-१४", "content_sanskrit": "आशीविषसमेभ्यश्च तेभ्यो रक्षस्व भारत।\nतान्युक्तैरुपजिज्ञास्य भोगैर्निर्वप रक्ष च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2092303, "chapter_id": 2964, "verse_number": "१३-९४-१५", "content_sanskrit": "कृतैरावसथैर्नित्यं सप्रेष्यैः सपरिच्छदैः।\nनिमन्त्रयेथाः कौरव्य सर्वभूतसुखावहैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2092304, "chapter_id": 2964, "verse_number": "१३-९४-१६", "content_sanskrit": "यदि ते प्रतिगृह्णीयुः श्रद्धापूतं युधिष्ठिर।\nकार्यमित्येव मन्वाना धार्मिकाः पुण्यकर्मिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2092305, "chapter_id": 2964, "verse_number": "१३-९४-१७", "content_sanskrit": "विद्यास्नाता व्रतस्नाता धर्ममाश्रित्य जीविनः।\nगूढस्वाध्यायतपसो ब्राह्म्णाः संशितव्रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2092306, "chapter_id": 2964, "verse_number": "१३-९४-१८", "content_sanskrit": "तेषु शुद्धेषु दान्तेषु स्वदारनिरतेषु च।\nयत्करिष्यसि कल्याणं तत्ते लोके युधाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2092307, "chapter_id": 2964, "verse_number": "१३-९४-१९", "content_sanskrit": "यथाऽग्निहोत्रं सुहुतं सायम्प्रातर्द्विजातिना।\nतथा भवति दत्तं वै विद्वद्भ्यो यत्कृतात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2092308, "chapter_id": 2964, "verse_number": "१३-९४-२०", "content_sanskrit": "एष ते विततो यज्ञः श्रद्धापूतः सदक्षिणः।\nविशिष्टः सर्वयज्ञेभ्यो ददतस्तात वर्तताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2092309, "chapter_id": 2964, "verse_number": "१३-९४-२१", "content_sanskrit": "निवापो दानसदृशः सदृशेषु युधिष्ठिर।\nनिवेदयन्पूजयन्वै तेष्वानृण्यं निगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2092310, "chapter_id": 2964, "verse_number": "१३-९४-२२", "content_sanskrit": "य एवं नैव कुप्यन्ते न लुभ्यन्ति तृणेष्वपि।\nत एव नः पूज्यतमा ये चापि प्रियवादिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2092311, "chapter_id": 2964, "verse_number": "१३-९४-२३", "content_sanskrit": "ये नो न बहुमन्यन्ते न प्रवर्तन्ति याचने।\nपुत्रवत्परिपाल्यास्ते नमस्तेभ्यस्तथाऽभयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2092312, "chapter_id": 2964, "verse_number": "१३-९४-२४", "content_sanskrit": "ऋत्विक्पुरोहिताचार्या मृदुधर्मपरा हि ये।\nक्षात्रेणापि हि संसृष्टं तेजः शाम्यति तेष्वपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2092313, "chapter_id": 2964, "verse_number": "१३-९४-२५", "content_sanskrit": "ईश्वरो बलवानस्मि राजाऽस्मीति युधिष्ठिर।\nब्राह्मणान्मास्म पर्यासीर्वासोभिरशनेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2092314, "chapter_id": 2964, "verse_number": "१३-९४-२६", "content_sanskrit": "यच्छोभार्थं बलार्तं वा वित्तमस्ति तवानघ।\nतेन ते ब्राह्मणाः पूज्याः स्वधर्ममनुतिष्ठता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2092315, "chapter_id": 2964, "verse_number": "१३-९४-२७", "content_sanskrit": "नमस्कार्यास्तथा विप्रा वर्तमाना यथातथम्।\nयथासुखं यथोत्साहं ललन्तु त्वयि पुत्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2092316, "chapter_id": 2964, "verse_number": "१३-९४-२८", "content_sanskrit": "को ह्यक्षयप्रसादानां सुहृदामल्पतोषिणाम्।\nवृत्तिमर्हत्युपक्षेप्तुं त्वदन्यः कुरुसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2092317, "chapter_id": 2964, "verse_number": "१३-९४-२९", "content_sanskrit": "यथाऽपत्याश्रयो धर्मः स्त्रीणां लोके सनातनः।\nसदैव सा गतिर्नान्या तथाऽस्माकं द्विजातयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2092318, "chapter_id": 2964, "verse_number": "१३-९४-३०", "content_sanskrit": "यदि नो ब्राह्मणास्तात संत्यजेयुरपूजिताः।\nपश्यन्तो दारुणं कर्म सततं क्षत्रिये स्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2092319, "chapter_id": 2964, "verse_number": "१३-९४-३१", "content_sanskrit": "अवेदानामकीर्तीनामलोकानामयज्विनाम्।\nकोनु स्याज्जीवितेनार्थस्तद्धिनो ब्राह्मणाश्रयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2092320, "chapter_id": 2964, "verse_number": "१३-९४-३२", "content_sanskrit": "अत्र ते वर्तयिष्यामि यथा धर्मं सनातनम्।\nराजन्यो ब्राह्मणान्राजन्पुरा परिचचार ह।\nवैश्यो राजन्यमित्येव शूद्रो वैश्यमिति श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2092321, "chapter_id": 2964, "verse_number": "१३-९४-३३", "content_sanskrit": "दूराच्छूद्रेणोपचर्यो ब्राह्मणोऽग्निरिव ज्वलन्।\nसंस्पर्शपरिचर्यसल्तु वैश्येन क्षत्रियेण च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2092322, "chapter_id": 2964, "verse_number": "१३-९४-३४", "content_sanskrit": "मृदुभावान्सत्यशीलान्सत्यधर्मानुपालकान्।\nआशीविषानिव क्रुद्धांस्तानुपाचरत द्विजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2092323, "chapter_id": 2964, "verse_number": "१३-९४-३५", "content_sanskrit": "अपरेषां परेषां च परेभ्यश्चापि ये परे।\nक्षत्रियाणां प्रतपतां तेजसा च बलेन च।\nब्राह्मणेष्वेव शाम्यन्ति तेजांसि च तपांसि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2092324, "chapter_id": 2964, "verse_number": "१३-९४-३६", "content_sanskrit": "न मे पिता प्रियतरो न त्वं तात तथा प्रियः।\nन मे पितुः पिता राजन्न चात्मा न च जीवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2092325, "chapter_id": 2964, "verse_number": "१३-९४-३७", "content_sanskrit": "त्वत्तश्च मे प्रियतरः पृथिव्यां नास्ति कश्चन।\nत्वत्तोऽपि मे प्रियतरा ब्राह्मणा भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2092326, "chapter_id": 2964, "verse_number": "१३-९४-३८", "content_sanskrit": "ब्रवीमि सत्यमेतच्च यथाऽहं पाण्डुनन्दन।\nतेन सत्येन गच्छेयं लोकान्यत्र स शान्तनुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2092327, "chapter_id": 2964, "verse_number": "१३-९४-३९", "content_sanskrit": "पश्येयं च सतां लोकाञ्छुचीन्ब्रह्मपुरस्कृतान्।\nतत्र मे तात गन्तव्यमह्नाय च चिराय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2092328, "chapter_id": 2964, "verse_number": "१३-९४-४०", "content_sanskrit": "सोहमेतादृशान्लोकान्दृष्ट्वा भरतसत्तम।\nयन्मे कृतं ब्राह्मणेषु न तप्ये तेन पार्थिव॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2092329, "chapter_id": 2964, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि चतुर्नवतितमोऽध्यायः॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]