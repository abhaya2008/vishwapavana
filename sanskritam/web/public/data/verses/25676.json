[{"id": 7005676000, "chapter_id": 25676, "verse_number": "१४९-१", "content_sanskrit": "सूत उवाच  ।\nसुरासुराणां सम्मर्दस्तस्मिन्नत्यन्तदारुणे  ।\nतुमुलोऽतिमहानासीत् सेनयोरुभयोरपि ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005676001, "chapter_id": 25676, "verse_number": "१४९-२", "content_sanskrit": "गर्जतां देवदैत्यानां शङ्खभेरीरवेण च  ।\nतुर्याणाञ्चैव निर्घोषैर्मातङ्गानाञ्च बृंहितैः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005676002, "chapter_id": 25676, "verse_number": "१४९-३", "content_sanskrit": "ह्रेषतां हयवृन्दानां रथनेमिस्वनेन च  ।\nज्याघोषेण च शूराणान् तुमुलोऽतिमहानभूत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005676003, "chapter_id": 25676, "verse_number": "१४९-४", "content_sanskrit": "समासाद्योभये सेने परस्पर जयैषिणाम्  ।\nरोषेणातिपरीतानान् त्यक्त जीवित चेतसाम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005676004, "chapter_id": 25676, "verse_number": "१४९-५", "content_sanskrit": "समासाद्य तु तेऽन्योन्यं प्रक्रमेण विलोमतः  ।\nरथेनासक्त पादातो रथेन चतुरङ्गमः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005676005, "chapter_id": 25676, "verse_number": "१४९-६", "content_sanskrit": "हस्ती पादाति संयुक्तो रथिना च क्वचिद्रथी  ।\nमातङ्गेनापरो हस्ती तुरङ्गैर्बहुभिर्गजः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005676006, "chapter_id": 25676, "verse_number": "१४९-७", "content_sanskrit": "पदातिरेको बहुभिर्गजैर्मत्तैश्च युज्यते  ।\nततः प्रासाशनि गदा भिन्दि पालपरश्वधैः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005676007, "chapter_id": 25676, "verse_number": "१४९-८", "content_sanskrit": "शक्तिभिः पट्टिशैः शूलैर्मुद्गरैः कड़पैर्गडैः  ।\nचक्रैश्च शङ्कुभिश्चैव तोमरैरङ्कुशैः स्थितैः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005676008, "chapter_id": 25676, "verse_number": "१४९-९", "content_sanskrit": "कर्णिकालीकनारा च वत्सदन्तार्द्धचन्द्रकैः  ।\nभल्लैश्च शतपत्रैश्च शुकतुण्डैश्च निर्म्मलैः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005676009, "chapter_id": 25676, "verse_number": "१४९-१०", "content_sanskrit": "वृष्टिरत्यद्भुताकारा गगने समदृश्यत  ।\nसम्प्रच्छाद्य दिशः सर्वास्तमोमयमिवाकरोत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005676010, "chapter_id": 25676, "verse_number": "१४९-११", "content_sanskrit": "न प्राज्ञायत तेऽन्योऽन्यं तस्मिंस्तमसि सङ्कुले  ।\nअलक्ष्यं विसृजन्तस्ते हेतिसङ्घातमुद्धतम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005676011, "chapter_id": 25676, "verse_number": "१४९-१२", "content_sanskrit": "पतितं सेनयोर्मध्ये निरीक्षन्ते परस्परम्  ।\nततो ध्वजैर्भुजैश्छत्रैः शिरोभिश्च सकुण्डलैः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005676012, "chapter_id": 25676, "verse_number": "१४९-१३", "content_sanskrit": "गजैस्तुरङ्गैः पादातैः पतद्भिः पतितैरपि  ।\nआकाशसरसोभ्रष्टैः पङ्कजैरिव भूस्तृता ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005676013, "chapter_id": 25676, "verse_number": "१४९-१४", "content_sanskrit": "भग्नदन्ता भिन्नकुम्भा श्छिन्नदीर्घमहाकराः  ।\nगजाः शैलनिभाः पेतुर्धरण्यां रुधिरस्रवाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005676014, "chapter_id": 25676, "verse_number": "१४९-१५", "content_sanskrit": "भग्नेषा दण्डचक्राक्षा रथाश्च शकलीकृता  ।\nपेतुः शकलतां यातास्तुरङ्गाश्च सहस्रशः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005676015, "chapter_id": 25676, "verse_number": "१४९-१६", "content_sanskrit": "ततोऽसृक् ह्रददुस्तारा पृथिवी समजायत  ।\nनद्यश्च रुधिरावर्ता हर्षदाः पिशिताशिनाम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005676016, "chapter_id": 25676, "verse_number": "१४९-१७", "content_sanskrit": "वेताला क्रीड़मभवत् तत् सङ्कुलरणाजिरम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]