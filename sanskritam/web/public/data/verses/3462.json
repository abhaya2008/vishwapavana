[{"id": 2114477, "chapter_id": 3462, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2114478, "chapter_id": 3462, "verse_number": "१", "content_sanskrit": "प्राणाधिकं भीमसेनं कृतविद्यं धनञ्जयम् ।\nदुर्योधनो लक्षयित्वा पर्यतप्यत दुर्मतिः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2114479, "chapter_id": 3462, "verse_number": "२", "content_sanskrit": "दुर्योधनश्च कर्णश्च शकुनिश्चापि सौबलः ।\nअनेकैरभ्युपायैस्तैर्जिघांसन्ति स्म पाण्डवान् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2114480, "chapter_id": 3462, "verse_number": "३", "content_sanskrit": "पाण्डवाश्चापि तत्सर्वं प्रतिचक्रुर्यथाबलम् ।\nउद्भावनमकुर्वाणा विदुरस्य मते स्थिताः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2114481, "chapter_id": 3462, "verse_number": "४", "content_sanskrit": "गुणैः समुदितान् दृष्ट्वा पौराः पाण्डुसुतांस्तदा ।\nकथयन्ति स्म ते भूयो देशेदेशे सभासु च\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2114482, "chapter_id": 3462, "verse_number": "५", "content_sanskrit": "प्रज्ञाचक्षुरचक्षुष्मान् धृतराष्ट्रो जनाधिपः ।\nअशक्तो राज्यकरणे स कथं धारयिष्यति \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2114483, "chapter_id": 3462, "verse_number": "६", "content_sanskrit": "राज्यं न प्राप्तवान् पूर्वं स कथं नृपतिर्भवेत् ।\nतथा भीष्मः शान्तनवः सत्यसन्धो महाव्रतः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2114484, "chapter_id": 3462, "verse_number": "७", "content_sanskrit": "प्रत्याख्याय पुरा राज्यं न स जातु ग्रहिष्यति ।\nते वयं पाण्डवज्येष्ठं तरुणं वृद्धदर्शनम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2114485, "chapter_id": 3462, "verse_number": "८", "content_sanskrit": "अभिषिञ्चाम साध्वद्य सत्यकारुण्यवेदिनम् ।\nपितामहं शान्तनवं धृतराष्ट्रं च धर्मवित् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2114486, "chapter_id": 3462, "verse_number": "९", "content_sanskrit": "सपुत्रं विविधैर्भोगैर्नियतं वासयिष्यति ।\nतेषां दुर्योधनः श्रुत्वा तानि वाक्यानि सर्वशः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2114487, "chapter_id": 3462, "verse_number": "१०", "content_sanskrit": "युधिष्ठिरानुरक्तानां पर्यतप्यत दुर्मतिः ।\nस तप्यमानो दुष्टात्मा तेषां वाचो न चक्षमे \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2114488, "chapter_id": 3462, "verse_number": "११", "content_sanskrit": "ईर्ष्यया मुह्यमानस्तु धृतराष्ट्रमुपाद्गवत् ।\nततो विरहितं दृष्ट्वा पितरं परिपूज्य सः ।\nपाण्डोर्वृत्तं पूर्वमुक्त्वा पश्चादिदमथाब्रवीत्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2114489, "chapter_id": 3462, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2114490, "chapter_id": 3462, "verse_number": "१२", "content_sanskrit": "श्रुता मे जल्पतां तात पौराणां चाशिवा गिरः ।\nत्वामनादृत्य भीष्मं च पतिमिच्छन्ति पाण्डवम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2114491, "chapter_id": 3462, "verse_number": "१३", "content_sanskrit": "सममेतच्च भीष्मस्य न स राज्यं चिकीर्षति ।\nअस्माकं तु परां पीडां चिकीर्षन्ति पुरे जनाः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2114492, "chapter_id": 3462, "verse_number": "१४", "content_sanskrit": "पितृतः प्राप्तवान् राज्यं पाण्डुरात्मगुणैः पुरा ।\nत्वमन्धगुणसंयोगात् प्राप्तं राज्यं न लब्धवान् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2114493, "chapter_id": 3462, "verse_number": "१५", "content_sanskrit": "स एष पाण्डोर्दायाद्यं यदि प्राप्नोति पाण्डवः ।\nतस्य पुत्रो ध्रुवं प्राप्तस्तस्य तस्यापि चापरः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2114494, "chapter_id": 3462, "verse_number": "१६", "content_sanskrit": "ते वयं राजवंशेन हीनाः सह सुतैरपि ।\nअविज्ञाता भविष्यामो लोकस्य जगतीपते \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2114495, "chapter_id": 3462, "verse_number": "१७", "content_sanskrit": "सततं निरयं प्राप्ताः परपिण्डोपजीविनः ।\nन भवाम यथा राजन् तथा शीघ्रं विधीयताम् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2114496, "chapter_id": 3462, "verse_number": "१८", "content_sanskrit": "अथ त्वमपि राजेन्द्र राजवंशो भविष्यसि ।\nयदि हि त्वं पुरा राज्ये भवानास्थापितो नृपः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2114497, "chapter_id": 3462, "verse_number": "१९", "content_sanskrit": "ध्रुवं लप्स्यामहे राज्यं वयमप्यवशेन ते ।\nस तथा कुरु कौरव्य रक्ष्या वंश्या यथा वयम् ।\nसम्प्राप्नुमः स्वयं राज्यं मन्त्रयस्व सहानुगैः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2114498, "chapter_id": 3462, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2114499, "chapter_id": 3462, "verse_number": "२०", "content_sanskrit": "धृतराष्ट्रस्तु पुत्रस्य श्रुत्वा वचनमीदृशम् ।\nमुहूर्तमिव सञ्चिन्त्य दुर्योधनमथाब्रवीत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2114500, "chapter_id": 3462, "verse_number": "२१", "content_sanskrit": "धर्मवृत्तः सदा पाण्डुः सुवृत्तो मयि गौरवात् ।\nसर्वेषु ज्ञातिषु तथा मदीयेषु विशेषतः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2114501, "chapter_id": 3462, "verse_number": "२२", "content_sanskrit": "नात्र किंचन जानाति भोजनानि चिकीर्षति ।\nनिवेदयति तत्सर्वं मयि धर्मभृतां वरः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2114502, "chapter_id": 3462, "verse_number": "२३", "content_sanskrit": "तस्य पुत्रो यथा पाण्डुस्तथा धर्मपरः सदा ।\nगुणवांल्लोकविख्यातो नगरे च प्रतिष्ठितः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2114503, "chapter_id": 3462, "verse_number": "२४", "content_sanskrit": "स तथा वर्तमानोऽसौ धर्मसूनुर्यथाऽनुजः ।\nराज्यमेष हि सम्प्राप्तः ससहायो विशेषतः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2114504, "chapter_id": 3462, "verse_number": "२५", "content_sanskrit": "ते तथा सत्कृतास्तात विषये पाण्डुना नराः ।\nकथं युधिष्ठिरस्यार्थे न नो हस्युः सबान्धवान् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2114505, "chapter_id": 3462, "verse_number": "२६", "content_sanskrit": "नैते विषयमिच्छेयुर्धर्मत्यागे विशेषतः ।\nते वयं कौरवेयाणामेतेषां च महात्मनाम् ।\nकथं न वाच्यतां तात गच्छेम जगतस्तथा\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2114506, "chapter_id": 3462, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2114507, "chapter_id": 3462, "verse_number": "२७", "content_sanskrit": "मध्यस्थः सततं भीष्मो द्रोणपुत्रो मयि ध्रुवः ।\nयतः पुत्रस्ततो द्रोणो भविता नात्र संशयः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2114508, "chapter_id": 3462, "verse_number": "२८", "content_sanskrit": "कृपः शारद्वतश्चैव यत एव वयं ततः ।\nभागिनेयं ततो द्रौणिं न त्यक्ष्यति कथञ्चन\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2114509, "chapter_id": 3462, "verse_number": "२९", "content_sanskrit": "क्षत्ता तु बन्धुरस्माकं प्रच्छन्नस्तु ततः परैः ।\nन चैकः स समर्थोऽस्मान् पाण्डवार्थे विबाधितुम् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2114510, "chapter_id": 3462, "verse_number": "३०", "content_sanskrit": "सुविस्रब्धान् पाण्डुसुतान् सह मात्रा विवासय ।\nवारणावतमद्यैव नात्र दोषो भविष्यति\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2114511, "chapter_id": 3462, "verse_number": "३१", "content_sanskrit": "विनिद्राकरणं घोरं हृदि शल्यमिवार्पितम् ।\nशोकपावकमुद्भूतं कर्मणा तेन नाशय\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2114512, "chapter_id": 3462, "verse_number": "१४१", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nएकचत्वारिंशत्यधिकशततमोऽध्यायः ॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2114513, "chapter_id": 3462, "verse_number": "८९", "content_sanskrit": "॥ इति सम्भवपर्वणि एकोननवतितमोऽध्यायः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2114514, "chapter_id": 3462, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]