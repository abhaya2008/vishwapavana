[{"id": 2081103, "chapter_id": 2724, "verse_number": "१२-२२९-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2081104, "chapter_id": 2724, "verse_number": "१२-२२९-१", "content_sanskrit": "यदिदं कर्म लोकेऽस्मिञ्शुभं वा यदि वाऽशुभम्।\nपुरुषं योजयत्येव फलयोगेन भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2081105, "chapter_id": 2724, "verse_number": "१२-२२९-२", "content_sanskrit": "कर्ता स्वित्तस्य पुरुष उताहो नेति संशयः।\nएतदिच्छामि तत्त्वेन त्वत्तः श्रोतुं पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2081106, "chapter_id": 2724, "verse_number": "१२-२२९-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2081107, "chapter_id": 2724, "verse_number": "१२-२२९-३", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nप्रह्लादस्य च संवादमिन्द्रस्य च युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2081108, "chapter_id": 2724, "verse_number": "१२-२२९-४", "content_sanskrit": "असक्तं धूतपाप्मानं कुले जातं बहुश्रुतम्।\nअस्तब्धमनहंकारं सत्वस्थं संयतेन्द्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2081109, "chapter_id": 2724, "verse_number": "१२-२२९-५", "content_sanskrit": "तुल्यनिन्दास्तुतिं दान्तं शून्यागारसमाकृतिम्।\nचराचराणां भूतानां विदितप्रभवाप्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2081110, "chapter_id": 2724, "verse_number": "१२-२२९-६", "content_sanskrit": "अक्रुध्यन्तमहृष्यन्तमप्रियेषु प्रियेषु च।\nकाञ्चने वाऽथ लोष्ठे वा उभयोः समदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2081111, "chapter_id": 2724, "verse_number": "१२-२२९-७", "content_sanskrit": "आत्मनि श्रेयसि ज्ञाने धीरं निश्चितनिश्चयम्॥\nपरावरज्ञं भूतानां सर्वज्ञं सर्वदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2081112, "chapter_id": 2724, "verse_number": "१२-२२९-८", "content_sanskrit": "`अव्यक्तात्मनि गोविन्दे वासुदेवे महात्मनि।\nहृदयेन समाविष्टं सर्वभावप्रियंकरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2081113, "chapter_id": 2724, "verse_number": "१२-२२९-९", "content_sanskrit": "भक्तं भागवतं नित्यं नारायणपरायणम्।\nध्यायन्तं परमात्मानं हिरण्यकशिपोः सुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2081114, "chapter_id": 2724, "verse_number": "१२-२२९-१०", "content_sanskrit": "शक्रः प्रह्लादमासीनमेकान्ते संयतेन्द्रियम्।\nबुभुत्समानस्तत्प्रज्ञामभिगम्येदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2081115, "chapter_id": 2724, "verse_number": "१२-२२९-११", "content_sanskrit": "यैः कैश्चित्संमतो लोके गुणैः स्यात्पुरुषो नृषु।\nभवत्यनपगान्सर्वांस्तान्गुणाँल्लक्षयामहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2081116, "chapter_id": 2724, "verse_number": "१२-२२९-१२", "content_sanskrit": "अथ ते लक्ष्यते बुद्धिः समा बालजनैरिह।\nआत्मानं मन्यमानः सञ्श्रेयः किमिह मन्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2081117, "chapter_id": 2724, "verse_number": "१२-२२९-१३", "content_sanskrit": "बद्धः पाशैश्च्युतः स्थानाद्द्विषतां वशमागतः।\nश्रिया विहीनः प्रह्लाद शोचितव्ये न शोचसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2081118, "chapter_id": 2724, "verse_number": "१२-२२९-१४", "content_sanskrit": "प्रज्ञालाभेन दैतेय उताहो धृतिमत्तथा।\nप्रह्लाद स्वस्थरूपोऽसि पश्यन्व्यसनमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2081119, "chapter_id": 2724, "verse_number": "१२-२२९-१५x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2081120, "chapter_id": 2724, "verse_number": "१२-२२९-१५", "content_sanskrit": "इति संचोदितस्तेन धीरो निश्चितनिश्चयः।\nउवाच श्लक्ष्णया वाचा स्वां प्रज्ञामनुवर्णयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2081121, "chapter_id": 2724, "verse_number": "१२-२२९-१६x", "content_sanskrit": "प्रह्लाद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2081122, "chapter_id": 2724, "verse_number": "१२-२२९-१६", "content_sanskrit": "प्रवृत्तिं च निवृत्तिं च भूतानां यो न बुध्यते।\nतस्य स्तम्भो भवेद्बाल्यान्नास्ति स्तंभोऽनुपश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2081123, "chapter_id": 2724, "verse_number": "१२-२२९-१७", "content_sanskrit": "`गहनं सर्वभूतानां ध्येयं नित्यं सनातनम्।\nअनिग्रहमनौपम्यं सर्वाकारं परात्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2081124, "chapter_id": 2724, "verse_number": "१२-२२९-१८", "content_sanskrit": "सर्वावरणसंभूतं तस्मादेतत्प्रवर्तते।\nतन्मया अपि संपश्य नानालक्षणलक्षिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2081125, "chapter_id": 2724, "verse_number": "१२-२२९-१९", "content_sanskrit": "स वै पाति जगत्स्रष्टा विष्णुरित्यभिशब्दितः।\nपुनर्दर्शति संप्राप्ते------सुरेश्चरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2081126, "chapter_id": 2724, "verse_number": "१२-२२९-२०", "content_sanskrit": "स्वभावात्संप्रवर्तन्ते निवर्तन्ते तथैव च।\nसर्वे भावास्तथा भावाः पुरुषार्थो न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2081127, "chapter_id": 2724, "verse_number": "१२-२२९-२१", "content_sanskrit": "पुरुषार्थस्य चाभावे नास्ति कश्चित्स्वकारकः।\nस्वयं च कुर्वतस्तस्य जातु मानो भवेदिह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2081128, "chapter_id": 2724, "verse_number": "१२-२२९-२२", "content_sanskrit": "यस्तु कर्तारमात्मानं मन्यते साध्वसाधु वा।\nतस्य दोषवती प्रज्ञा अतत्त्वज्ञेति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2081129, "chapter_id": 2724, "verse_number": "१२-२२९-२३", "content_sanskrit": "यदि स्यात्पुरुषः कर्ता शक्रात्मश्रेयसे ध्रुवम्।\nआरम्भास्तस्य सिद्ध्येयुर्न तु जातु पराभवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2081130, "chapter_id": 2724, "verse_number": "१२-२२९-२४", "content_sanskrit": "अनिष्टस्य हि निर्वृत्तिरनिवृत्तिः प्रियस्य च।\nलक्ष्यते यतमानानां पुरुषार्थस्ततः कुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2081131, "chapter_id": 2724, "verse_number": "१२-२२९-२५", "content_sanskrit": "अनिष्टस्याभिनिर्वृत्तिमिष्टसंवृतिमेव च।\nअप्रयत्नेन पश्यामः केषां चित्तत्स्वभावतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2081132, "chapter_id": 2724, "verse_number": "१२-२२९-२६", "content_sanskrit": "प्रतिरूपतराः केचिद्दृस्यन्ते बुद्धिमत्तराः।\nविरूपेभ्योऽल्पबुद्धिभ्यो लिप्समाना धनागमं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2081133, "chapter_id": 2724, "verse_number": "१२-२२९-२७", "content_sanskrit": "स्वभावप्रेरिताः सर्वे निविशन्ते गुणा यदा।\nशुभाशुभास्तदा तत्र तस्य किं मानकारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2081134, "chapter_id": 2724, "verse_number": "१२-२२९-२८", "content_sanskrit": "स्वभावादेव तत्सर्वमिति मे निश्चिता मतिः।\nआत्मप्रतिष्ठा प्रज्ञा वा मम नास्ति ततोऽन्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2081135, "chapter_id": 2724, "verse_number": "१२-२२९-२९", "content_sanskrit": "कर्मजं त्विह मन्यन्ते पलयोगं शुभाशुभम्।\nकर्मणां विषयं कृत्स्नमहं वक्ष्यामि तच्छृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2081136, "chapter_id": 2724, "verse_number": "१२-२२९-३०", "content_sanskrit": "यथा वेदयते कश्चिदोदनं पायसं ह्यदन्।\nएवं सर्वाणि कर्माणि स्वभावस्यैव लक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2081137, "chapter_id": 2724, "verse_number": "१२-२२९-३१", "content_sanskrit": "विकारानेव यो वेद न वेद प्रकृतिं पराम्।\nतस्य स्तंभोऽभवेद्बाल्यान्नास्ति स्तंभोऽनुपश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2081138, "chapter_id": 2724, "verse_number": "१२-२२९-३२", "content_sanskrit": "स्वभावभाविनो भावान्सर्वानेवेह निश्चये।\nबुद्ध्यमानस्य दर्पो वा मानो वा किं करिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2081139, "chapter_id": 2724, "verse_number": "१२-२२९-३३", "content_sanskrit": "वेद धर्मविधिं कृत्स्नं भूतानां चाप्यनित्यताम्।\nतस्माच्छक्र न शोचारि सर्वं ह्येवेदमन्तवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2081140, "chapter_id": 2724, "verse_number": "१२-२२९-३४", "content_sanskrit": "निर्ममो निरहंकारो निरीहो मुक्तबन्धनः।\nस्वस्थो व्यपेतः पश्यामि भूतानां प्रभवाप्ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2081141, "chapter_id": 2724, "verse_number": "१२-२२९-३५", "content_sanskrit": "कृतप्रज्ञस्य दान्तस्य वितृष्णाय निराशिषः।\nनायासो विद्यते शक्र पश्यतो योगवित्तया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2081142, "chapter_id": 2724, "verse_number": "१२-२२९-३६", "content_sanskrit": "प्रकृतौ च विकारे च न मे प्रीतिर्न च द्विषे।\nद्वेष्टारं च न पश्यामि यो ममाद्य विरुध्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2081143, "chapter_id": 2724, "verse_number": "१२-२२९-३७", "content_sanskrit": "नोर्ध्वं नावाङ्वतिर्यक्च न क्वचिच्छक्र कामये।\nन हि ज्ञेये न विज्ञाने नाज्ञाने विद्यतेऽन्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2081144, "chapter_id": 2724, "verse_number": "१२-२२९-३८x", "content_sanskrit": "शक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2081145, "chapter_id": 2724, "verse_number": "१२-२२९-३८", "content_sanskrit": "येनैषा लभ्यते प्रज्ञा येन शान्तिरवाप्यते।\nप्रब्रूहि तमुपायं मे सम्यक्प्रह्लाद पृच्छते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2081146, "chapter_id": 2724, "verse_number": "१२-२२९-३९x", "content_sanskrit": "प्रह्लाद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2081147, "chapter_id": 2724, "verse_number": "१२-२२९-३९", "content_sanskrit": "आर्जवेनाप्रमादेन प्रसादेनात्मवत्तया।\nगुरुशुश्रूषया शक्र पुरुषो लभते महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2081148, "chapter_id": 2724, "verse_number": "१२-२२९-४०", "content_sanskrit": "स्वभावाल्लभते प्रज्ञां शान्तिमेति स्वभावतः।\nस्वभावादेव तत्सर्वं यत्किंचिदनुपश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2081149, "chapter_id": 2724, "verse_number": "१२-२२९-४१", "content_sanskrit": "`नैवान्तरं विजानाति श्रुत्वा गुरुमुखात्ततः।\nवाक्यं वाक्यार्थविज्ञानमालोक्य मनसा यतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2081150, "chapter_id": 2724, "verse_number": "१२-२२९-४२", "content_sanskrit": "विवेकप्रत्ययापन्नमात्मानमनुपश्यति।\nविरज्यति ततो भीत्या परमेश्वरमृच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2081151, "chapter_id": 2724, "verse_number": "१२-२२९-४३", "content_sanskrit": "त्रातारं सर्वदुःखानां तत्सुखान्वेषणं ततः।\nकरोति सद्भिः संसर्गमलं सन्तः सुखाय वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2081152, "chapter_id": 2724, "verse_number": "१२-२२९-४४", "content_sanskrit": "सतां सकाशादाज्ञाय मार्गं लक्षणवत्तया।\nसर्वसङ्गविनिर्मुक्तः परमात्मानमृच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2081153, "chapter_id": 2724, "verse_number": "१२-२२९-४५", "content_sanskrit": "विषयेच्छाकृतो धर्मं सरजस्को भयावहः।\nधर्महानिमवाप्नोति क्रमात्तेन नरः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2081154, "chapter_id": 2724, "verse_number": "१२-२२९-४६", "content_sanskrit": "भक्तिहीनो भवत्येव परमात्मनि चाच्युत।\nवाचके वाऽपि च स्थानं न हन्त्येव विमोचितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2081155, "chapter_id": 2724, "verse_number": "१२-२२९-४७", "content_sanskrit": "सार्क्ष्ये चास्य रतिर्नित्यं संसारे च रतिर्भवेत्।\nतस्य नित्यमविज्ञानादात्माचैव न सिद्ध्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2081156, "chapter_id": 2724, "verse_number": "१२-२२९-४८", "content_sanskrit": "उन्मत्तवृत्तिर्भवति क्रमादेवं प्रवर्तते।\nआशौचं वर्धते नित्यं न शाम्यति कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2081157, "chapter_id": 2724, "verse_number": "१२-२२९-४९", "content_sanskrit": "विषये चान्वितस्यास्य मोक्षवाञ्छा न जायते।\nहेत्वाभासेषु संलीनः स्तौति वैषयिकान्गुणान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2081158, "chapter_id": 2724, "verse_number": "१२-२२९-५०", "content_sanskrit": "न शास्त्राणि शृणोत्येव मानदर्पसमन्वितः।\nस्वतःसिद्धं न भोगस्तं स्वतः सिद्धं न वेत्ति च।\nचिद्रूपधारणं चैव परसृष्टिमथाव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2081159, "chapter_id": 2724, "verse_number": "१२-२२९-५१", "content_sanskrit": "नानायोनिगतस्तेन भ्राम्यमाणः स्वकर्मभिः।\nतीर्णपारं न जानाति महामोहसमन्वितः।\nआचार्यसंश्रयाद्विद्याद्विनयं समुपागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2081160, "chapter_id": 2724, "verse_number": "१२-२२९-५२", "content_sanskrit": "अनुकूलेषु धर्मेषु चिनोत्येनं ततस्ततः।\nआचार्य इति च ख्यातस्तेनासौ बलवृत्रहन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2081161, "chapter_id": 2724, "verse_number": "१२-२२९-५३", "content_sanskrit": "नियतेनैव सद्भावस्तेन जन्मान्तरादिषु।\nकर्मसञ्चयतूलौघः क्षिप्यते ज्ञानवायुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2081162, "chapter_id": 2724, "verse_number": "१२-२२९-५४", "content_sanskrit": "एवं युक्तसमाचारः संसारविनिवर्तकः।\nअनुकूलवृत्तिं सततं छिनत्त्येव भृगुर्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2081163, "chapter_id": 2724, "verse_number": "१२-२२९-५५", "content_sanskrit": "येन चायं समापन्नं वैतृष्ण्यं नाधिगच्छति।\nअभ्यन्तरः स्मृतः शक्र तत्साम्यं परिवर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2081164, "chapter_id": 2724, "verse_number": "१२-२२९-५६", "content_sanskrit": "प्रथमं तत्कृतेनैव कर्मणा परिमृच्छति।\nद्वितीयं स्वप्नयोगं च कर्मणा परिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2081165, "chapter_id": 2724, "verse_number": "१२-२२९-५७", "content_sanskrit": "एतैरक्षैः समापन्नः प्रत्यक्षोऽसौ समास्थितः।\nसुपुप्त्याख्यस्तुरीयोसौ न च ह्यावरणान्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2081166, "chapter_id": 2724, "verse_number": "१२-२२९-५८", "content_sanskrit": "लोकवृत्त्या तमीशानं यजञ्जुह्वन्यमी भवेत्।\nआत्मन्यायासयोगेन निष्क्रियं स परात्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2081167, "chapter_id": 2724, "verse_number": "१२-२२९-५९", "content_sanskrit": "आयामे तां विजानाति मायैषा परमात्मनः।\nप्रातिभासिकसामान्याद्बुद्धेर्या संविदात्मिका॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2081168, "chapter_id": 2724, "verse_number": "१२-२२९-६०", "content_sanskrit": "स्फुलिङ्गसत्त्वसदृशादग्निभावो यथा भवेत्।\nशिशूनामेवमज्ञानामात्मभावोऽन्यथा स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2081169, "chapter_id": 2724, "verse_number": "१२-२२९-६१", "content_sanskrit": "साध्येऽप्यवस्तुभूताख्ये मित्रामित्रादयः कुतः।\nतदभावे तु शोकाद्या न वर्तन्ते सुरेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2081170, "chapter_id": 2724, "verse_number": "१२-२२९-६२", "content_sanskrit": "एवं बुध्यस्व भगवन्समबुद्धिं समन्वियात्।\nउपायमेतदाख्यातं मा वक्रं गच्छ देवप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2081171, "chapter_id": 2724, "verse_number": "१२-२२९-६३", "content_sanskrit": "ज्ञानेन पश्यते कर्म ज्ञानिनां न प्रवर्तकम्।\nयावदारब्धमस्येह तावन्नैवोपशाम्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2081172, "chapter_id": 2724, "verse_number": "१२-२२९-६४", "content_sanskrit": "तदन्ते तं प्रयात्येव न विद्वानिति मे मतिः।\nयदस्य वाचकं वक्ष्ये संस्मरे तद्भवेत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2081173, "chapter_id": 2724, "verse_number": "१२-२२९-६५", "content_sanskrit": "तेनतेन च भावेन अपायं तत्र पश्यति।\nस्थानभेदेषु वागेषा तालुसंस्था यथा तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2081174, "chapter_id": 2724, "verse_number": "१२-२२९-६६", "content_sanskrit": "तद्वदुद्धिगता ह्यर्था बुद्धिमात्मगतः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2081175, "chapter_id": 2724, "verse_number": "१२-२२९-६७", "content_sanskrit": "समस्तसंकल्पविशेषमुक्तं\nपरं पराणां परमं महात्मा।\nत्रय्यन्तविद्भिः परिगीयतेऽसौ\nविष्णुर्विभुर्वास्ति गुणो न नित्यम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2081176, "chapter_id": 2724, "verse_number": "१२-२२९-६८", "content_sanskrit": "वर्णेषु लोकेषु विशेषणेषु\nस वासुदेवो वसनान्महात्मा।ट\nगुणानुरूपं स च कर्मरूपं\nददाति सर्वस्य समस्तरूपम्।\nन संदृशे तिष्ठति रुपमस्य\nन चक्षुषा पश्यति कश्चिदेनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2081177, "chapter_id": 2724, "verse_number": "१२-२२९-६९", "content_sanskrit": "भक्त्या च धृत्या च समाहितात्मा\nज्ञानस्वरूपं परिपश्यतीह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2081178, "chapter_id": 2724, "verse_number": "१२-२२९-७०", "content_sanskrit": "वदन्ति तन्मे भगवान्ददौ स\nस एव शेषं मघवान्महात्मा।\nएवं ममोपायमवैहि शक्र\nतस्माल्लोको नास्ति मह्यं सदैव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2081179, "chapter_id": 2724, "verse_number": "१२-२२९-७१x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2081180, "chapter_id": 2724, "verse_number": "१२-२२९-७१", "content_sanskrit": "इत्युक्तो दैत्यपतिना शक्रो विस्मयमागमत्।\nप्रीतिमांश्च तदा राजंस्तद्वाक्यं प्रत्यपूजयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2081181, "chapter_id": 2724, "verse_number": "१२-२२९-७२", "content_sanskrit": "स तदाभ्यर्च्य दैत्येन्द्रं त्रैलोक्यपतिरीश्वरः।\nअसुरेन्द्रमुपामन्त्र्य जगाम स्वं निवेशनम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2081182, "chapter_id": 2724, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शन्तिपर्वणि मोक्षधर्मपर्वणि एकोनत्रिंशदधिकद्विशततमोऽध्यायः॥ २२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}]