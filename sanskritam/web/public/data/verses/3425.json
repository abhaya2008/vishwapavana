[{"id": 2112463, "chapter_id": 3425, "verse_number": "", "content_sanskrit": "भीष्मेण सत्यवतीं प्रति दीर्घतमसश्चरितकथनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2112464, "chapter_id": 3425, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2112465, "chapter_id": 3425, "verse_number": "१", "content_sanskrit": "तां तु लालपतीं दृष्ट्वा कृपणां पुत्रगृद्धिनीम् ।\nधर्मादपेतं ब्रुवतीं भीष्मो वचनमब्रवीत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2112466, "chapter_id": 3425, "verse_number": "२", "content_sanskrit": "क्षत्रधर्ममवेक्षस्व मा नः सर्वान् व्यनीनशः ।\nधारणेन व्रतस्याहुः क्षत्रियाः परमां द्युतिम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2112467, "chapter_id": 3425, "verse_number": "३", "content_sanskrit": "शन्तनोरपि सन्तानो यथा स्यात् पुनरेव हि ।\nक्षत्रधर्मं प्रवक्ष्यामि क्षत्रियाणां पुरातनम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2112468, "chapter_id": 3425, "verse_number": "४", "content_sanskrit": "श्रुत्वा तं प्रतिपद्येथाः प्राज्ञैः सह पुरोहितैः ।\nआपद्धर्मेषु कुशलैर्लोकतन्त्रमवेक्ष्य च \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2112469, "chapter_id": 3425, "verse_number": "५", "content_sanskrit": "जामदग्न्येन रामेण पितुर्वधममृष्यता ।\nपुरा परशुहस्तेन हेहयाधिपतिर्हतः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2112470, "chapter_id": 3425, "verse_number": "६", "content_sanskrit": "क्रुद्धेन च महाप्राज्ञे हेहयस्य महात्मनः ।\nशतानि दश बाहूनां निकृत्तान्यर्जुनस्य वै \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2112471, "chapter_id": 3425, "verse_number": "७", "content_sanskrit": "पुनश्च धनुरादाय महास्त्राणि विमुञ्चता ।\nनिर्दग्धं क्षत्रमेकेन रामेण जयता महीम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2112472, "chapter_id": 3425, "verse_number": "८", "content_sanskrit": "एवमुच्चावचैरस्त्रैर्भार्गवेण महात्मना ।\nत्रिः सप्तकृत्वो रोषेण कृता निःक्षत्रिया मही \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2112473, "chapter_id": 3425, "verse_number": "९", "content_sanskrit": "ततस्तद् वर्धितं क्षत्रं क्षत्रियाभिः समन्ततः ।\nउत्पादितान्यपत्यानि ब्राह्मणेभ्य इति श्रुतम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2112474, "chapter_id": 3425, "verse_number": "१०", "content_sanskrit": "पाणौ गृहीतः पुत्रेति वेदे च कथितं भृशम् ।\nधर्मं मनसि संस्थाप्य ब्राह्मणांस्ताः समभ्ययुः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2112475, "chapter_id": 3425, "verse_number": "११", "content_sanskrit": "लोकेऽप्याचरितो दृष्टः क्षत्रियाणां पुनर्भवः ।\nअथोचथ्य इति ख्यात आसीद् धीमान् महानृषिः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2112476, "chapter_id": 3425, "verse_number": "१२", "content_sanskrit": "भार्या च ममता नाम बभूवास्य महात्मनः ।\nउचथ्यस्य यवीयांस्तु पुरोधा यो दिवौकसाम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2112477, "chapter_id": 3425, "verse_number": "१३", "content_sanskrit": "बृहस्पतिर्महातेजा ममतां सोऽभ्यमन्यत ।\nउवाच ममता तं तु देवरं दैवतात् परम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2112478, "chapter_id": 3425, "verse_number": "१४", "content_sanskrit": "अन्तर्वत्न्यस्मि ते भ्रात्रा ज्येष्ठेन रमता मयि ।\nअयं च मे महाभाग कुक्षावेव बृहस्पते \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2112479, "chapter_id": 3425, "verse_number": "१५", "content_sanskrit": "औचथ्यो गर्भ आदत्ते षडङ्गं वेदमुत्तमम् ।\nअमोघरेतास्त्वं चापि नूनं भवितुमर्हसि ।\nतस्मादेवं गते कार्ये यथा युक्तं तथा कुरु\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2112480, "chapter_id": 3425, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2112481, "chapter_id": 3425, "verse_number": "१६", "content_sanskrit": "एवमुक्तस्तया सम्यग् बृहत्तेजा बृहस्पतिः ।\nकामात्मानं महात्माऽपि नात्मानं सोऽभ्यधारयत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2112482, "chapter_id": 3425, "verse_number": "१७", "content_sanskrit": "सम्बभूव ततः कामी तया सार्धमकामया ।\nउत्सृजन्तं तु तत्तेजो गर्भस्थो ह्यभ्यभाषत \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2112483, "chapter_id": 3425, "verse_number": "१८", "content_sanskrit": "कनीयस्तात नैवेह सम्भवो विद्यते द्वयोः ।\nअमोघशुक्लस्त्वं चापि पूर्वं चाहमिहागतः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2112484, "chapter_id": 3425, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2112485, "chapter_id": 3425, "verse_number": "१९", "content_sanskrit": "शशाप तं ततः क्रुद्ध एवमुक्तो बृहस्पतिः ।\nपुत्रं भ्रातुरुचथ्यस्य गर्भस्थं भगवान् ऋषिः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2112486, "chapter_id": 3425, "verse_number": "", "content_sanskrit": "बृहस्पतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2112487, "chapter_id": 3425, "verse_number": "२०", "content_sanskrit": "यस्मात् त्वमीदृशे काले सर्वभूतेप्सिते सति ।\nएवमात्थ वचस्तस्मात् तमो दीर्घं प्रवेक्ष्यसि \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2112488, "chapter_id": 3425, "verse_number": "२१", "content_sanskrit": "ततो दीर्घतमा नाम शापादृषिरजायत ।\nबृहस्पतेर्बृहत्कीर्तेर्बृहस्पतिरिवौजसा \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2112489, "chapter_id": 3425, "verse_number": "२२", "content_sanskrit": "जात्यन्धो वेदवित् प्राज्ञः पत्नीं लेभे स्वविद्यया ।\nतरुणीं रूपसम्पन्नां द्विषन्तीं नाम ब्राह्मणीम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2112490, "chapter_id": 3425, "verse_number": "२३", "content_sanskrit": "ऋषेरुचथ्यस्य महान् सन्तानकुलवृद्धये ।\nस पुत्रान् जनयामास गौतमादीन् महायशाः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2112491, "chapter_id": 3425, "verse_number": "२४", "content_sanskrit": "पुत्रलाभाच्च सा पत्नी न तुतोष पतिं तदा ।\nप्रद्विषन्तीं पतिर्भार्यां किं मां द्वेष्टीति चाब्रवीत्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2112492, "chapter_id": 3425, "verse_number": "", "content_sanskrit": "प्रद्विषन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2112493, "chapter_id": 3425, "verse_number": "२५", "content_sanskrit": "भार्याया भरणाद् भर्ता पालनाच्च पतिः स्मृतः ।\nअहं ते भरणं कृत्वा जात्यन्घं ससुता सदा ।\nनित्यकालं श्रमेणार्ता न भरेयं महातपः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2112494, "chapter_id": 3425, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2112495, "chapter_id": 3425, "verse_number": "२६", "content_sanskrit": "तस्यास्तद्वचनं श्रुत्वा ऋषिः कोपसमन्वितः ।\nप्रत्युवाच ततः पत्नीं प्रद्वेषीं ससुतां तदा ।\nनीयतां क्षत्रियगृहं धनार्थी त्वं भविष्यसि \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2112496, "chapter_id": 3425, "verse_number": "", "content_sanskrit": "पत्नी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2112497, "chapter_id": 3425, "verse_number": "२७", "content_sanskrit": "त्वया दत्तं धनं विप्र नेच्छेयं दुःखकारकम् ।\nयथेष्टं कुरु विप्रेन्द्र न भरेयं यथा पुरा\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2112498, "chapter_id": 3425, "verse_number": "", "content_sanskrit": "दीर्घतमाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2112499, "chapter_id": 3425, "verse_number": "२८", "content_sanskrit": "अद्यप्रभृति मर्यादा मया लोके प्रतिष्ठिता ।\nएक एव पतिः पत्न्या यावज्जीवं परायणम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2112500, "chapter_id": 3425, "verse_number": "२९", "content_sanskrit": "मृते जीवति वा तस्मिन् न परं प्राप्नुयान्नरम् ।\nअभिगम्य परं नारी पतिष्यति न संशयः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2112501, "chapter_id": 3425, "verse_number": "३०", "content_sanskrit": "अपतीनां तु नारीणामद्यप्रभृति पातकम् ।\nयद्यस्ति चेद् धनं सर्वं वृथाभोगा भवन्तु ताः ।\nअकीर्तिः परिवादाश्च नित्यं तासां भवन्त्विति \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2112502, "chapter_id": 3425, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2112503, "chapter_id": 3425, "verse_number": "३१", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा ब्राह्मणी भृशकोपिता ।\nगङ्गायां नीयतामेष पुत्रा इत्येवमब्रवीत्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2112504, "chapter_id": 3425, "verse_number": "३२", "content_sanskrit": "लोभमोहाभिभूतास्ते पुत्रास्तं गौतमादयः ।\nकाष्ठे समृद्धे प्रक्षिप्य गङ्गायां समवासृजन्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2112505, "chapter_id": 3425, "verse_number": "३३", "content_sanskrit": "न स्यादन्धश्च वृद्धश्च भर्तव्योऽयमिति स्म ते ।\nकर्मण्यथ ततः क्रूरे तेषां बुद्धिरजायत \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2112506, "chapter_id": 3425, "verse_number": "३४", "content_sanskrit": "चिन्तयित्वा ततः क्रूराः प्रतिजग्मुर्यथा गृहान् ।\nसोऽनुस्रोतस्तदा राजन् प्लवमानो मुनिस्तदा \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2112507, "chapter_id": 3425, "verse_number": "३५", "content_sanskrit": "जगाम सुबहून् देशान् अन्धस्तेनोडुपेन ह ।\nतं तु राजा बलिर्नाम सर्वधर्मविशारदः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2112508, "chapter_id": 3425, "verse_number": "३६", "content_sanskrit": "अपश्यन्मज्जनगतः स्रोतसाऽभ्याशमागतम् ।\nजग्राह चैनं धर्मात्मा बलिः सत्यपराक्रमः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2112509, "chapter_id": 3425, "verse_number": "३७", "content_sanskrit": "ज्ञात्वा चैनं वरं वव्रे पुत्रार्थी मनुजर्षभ ।\nतं पूजयित्वा राजर्षिर्विश्रान्तं मुनिमब्रवीत्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2112510, "chapter_id": 3425, "verse_number": "३८", "content_sanskrit": "सन्तानार्थं महाभाग भार्यायां मम मानद ।\nपुत्रान् धर्मार्थकुशलानुत्पादयितुमर्हसि \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2112511, "chapter_id": 3425, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2112512, "chapter_id": 3425, "verse_number": "३९", "content_sanskrit": "एवमुक्तः स तेजस्वी तं तथेत्युक्तवानृषिः ।\nतस्मै स राजा स्वां भार्यां सुदेष्णां प्राहिणोत् तदा \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2112513, "chapter_id": 3425, "verse_number": "४०", "content_sanskrit": "अन्धं वृद्धं तु तं मत्वा न सा देवी जगाम ह ।\nस्वां तु धात्रेयिकां तस्मै वृद्धाय प्राहिणोत् तदा \t॥ ४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2112514, "chapter_id": 3425, "verse_number": "४१", "content_sanskrit": "तस्यां कक्षीवदादीन् स शूद्रयोनावृषिर्वशी ।\nजनयामास धर्मात्मा पृत्रानेकादशैव तु \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2112515, "chapter_id": 3425, "verse_number": "४२", "content_sanskrit": "कक्षीवदादिकान् पुत्रान् साङ्गान् वेदानधीयतः ।\nउवाच तमृषिं राजा ममैत इति वीर्यवान्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2112516, "chapter_id": 3425, "verse_number": "४३", "content_sanskrit": "नेत्युवाच महर्षिस्तं ममैत इति चाब्रवीत् ।\nशूद्रयोनौ हि मे पुत्रा जाताः कक्षीवदादयः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2112517, "chapter_id": 3425, "verse_number": "४४", "content_sanskrit": "अन्धं वृद्धं च मां दृष्ट्वा सुदेष्णा महिषी तव ।\nप्राहिणोदवमानान्मे शूद्रां धात्रेयिकां स्वयम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2112518, "chapter_id": 3425, "verse_number": "४५", "content_sanskrit": "ततः प्रसादयामास पुनस्तमृषिसत्तमम् ।\nबलिः सुदेष्णां भार्यां च तस्मै तां प्राहिणोत् पुनः \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2112519, "chapter_id": 3425, "verse_number": "४६", "content_sanskrit": "तां स दीर्घतमाङ्गेषु स्पृष्ट्वा देवीमथाब्रवीत् ।\nभविष्यति कुमारस्ते तेजस्वी सत्यवागिति \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2112520, "chapter_id": 3425, "verse_number": "४७", "content_sanskrit": "तत्राङ्गो नाम राजर्षिः सुदेष्णायामजायत ।\nएवमन्ये महेष्वासा ब्राह्मणैः क्षत्रिया भुवि \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2112521, "chapter_id": 3425, "verse_number": "४८", "content_sanskrit": "जाताः परमधर्मज्ञा वीर्यवन्तो महाबलाः ।\nतस्माद् भरतवंशस्य पुनः सन्तानवृद्धये \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2112522, "chapter_id": 3425, "verse_number": "४९", "content_sanskrit": "हेतुं वक्ष्याम्यहं सम्यक् निर्दोषं नात्र संशयः ।\nब्राह्मणो गुणवान् कश्चिद् धनेनाप्युपमन्त्र्यताम् \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2112523, "chapter_id": 3425, "verse_number": "५०", "content_sanskrit": "विचित्रवीर्यभार्यायां यः समुत्पादयेत् प्रजाः ।\nएतच्छ्रुत्वा त्वमप्यत्र मातः कुरु यथेप्सितम् \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2112524, "chapter_id": 3425, "verse_number": "१०४", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nचतुरधिकशततमोऽध्यायः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2112525, "chapter_id": 3425, "verse_number": "४२", "content_sanskrit": "॥ इति सम्भवपर्वणि द्विपञ्चाशोऽध्यायः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2112526, "chapter_id": 3425, "verse_number": "", "content_sanskrit": "* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]