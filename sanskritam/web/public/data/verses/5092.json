[{"id": 2192467, "chapter_id": 5092, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2192468, "chapter_id": 5092, "verse_number": "१", "content_sanskrit": "मृगयां विचरन् कश्चिद्विजने जनकात्मजः ।\nवने ददर्श विप्रेन्द्रमृषिं वंशधरं भृगोः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2192469, "chapter_id": 5092, "verse_number": "२", "content_sanskrit": "तमासीनमुपासीनः प्रणम्य शिरसा मुनिम् ।\nपश्चादनुमतस्तेन पप्रच्छ वसुमानिदम्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2192470, "chapter_id": 5092, "verse_number": "३", "content_sanskrit": "भगवन् किमिदं श्रेयः प्रेत्य वापीह वा भवेत् ।\nपुरुषस्याध्रुवे देहे कामस्य वशवर्तिनः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2192471, "chapter_id": 5092, "verse_number": "४", "content_sanskrit": "सत्कृत्य परिपृष्टः सन् सुमहात्मा महातपाः ।\nनिजगादततस्तस्मै श्रेयस्करमिदं वचः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2192472, "chapter_id": 5092, "verse_number": "५", "content_sanskrit": "मनसोऽप्रतिकूलानि प्रेत्य चेह चवाञ्छसि ।\nभूतानां प्रतिकूलेभ्यो निवर्तस्व यतेन्द्रियः॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2192473, "chapter_id": 5092, "verse_number": "६", "content_sanskrit": "धर्मः सतां हितः पुंसां धर्मश्चैवाश्रयः सताम्।\nधर्माल्लोकास्त्रयस्तात प्रवृत्ताः सचराचराः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2192474, "chapter_id": 5092, "verse_number": "७", "content_sanskrit": "स्वादुकामुक कामानां वैतृष्ण्यं किं न गच्छसि ।\nमधु पश्यसि दुर्बुद्धे प्रपातं नानुपश्यसि॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2192475, "chapter_id": 5092, "verse_number": "८", "content_sanskrit": "यथा ज्ञाने परिचयः कर्तव्यस्तत्फलार्थिना।\nतथा धर्मे परिचयः कर्तव्यस्तत्फलार्थिना\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2192476, "chapter_id": 5092, "verse_number": "९", "content_sanskrit": "असता धर्मकामेन विशुद्धंकर्म दुष्करम् ।\nसता तु धर्मकामेन सुकरं कर्म दुष्करम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2192477, "chapter_id": 5092, "verse_number": "१०", "content_sanskrit": "वनेग्राम्यसुखाचारो यथा ग्राम्यस्तथैव सः ।\nग्रामे वनसुखाचारो यथा वनचरस्तथा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2192478, "chapter_id": 5092, "verse_number": "११", "content_sanskrit": "मनोवाक्कर्मके धर्मे कुरु श्रद्धां समाहितः ।\nनिवृत्तौ वा प्रवृत्तौवा सम्प्रधार्य गुणागुणान्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2192479, "chapter_id": 5092, "verse_number": "१२", "content_sanskrit": "नित्यं च बहु दातव्यं साधुभ्यश्चानसूयता ।\nप्रार्थितं व्रतशौचाभ्यांसत्कृतं देशकालयोः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2192480, "chapter_id": 5092, "verse_number": "१३", "content_sanskrit": "शुभेन विधिना लब्धमर्हाय प्रतिपादयेत्।\nक्रोधमुत्सृज्य दत्त्वा च नानुतप्येन्न कीर्तयेत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2192481, "chapter_id": 5092, "verse_number": "१४", "content_sanskrit": "अनृशंसः शुचिर्दान्तः सत्यवागार्जवे स्थितः।\nयोनिकर्मविशुद्धश्च पात्रं स्याद् वेदविद् द्विजः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2192482, "chapter_id": 5092, "verse_number": "१५", "content_sanskrit": "सत्कृताचैकपत्नी च जात्या योनिरिहेष्यते ।\nऋग्यजुःसामगो विद्वान् षट्कर्मा पात्रमुच्यते\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2192483, "chapter_id": 5092, "verse_number": "१६", "content_sanskrit": "स एव धर्मः सोऽधर्मस्तं तं प्रतिनरं भवेत् ।\nपात्रकर्मविशेषेण देशकालाववेक्ष्यच\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2192484, "chapter_id": 5092, "verse_number": "१७", "content_sanskrit": "लीलयाल्पं यथा गात्रात् प्रमृज्याद् रजसःपुमान् ।\nबहुयत्नेन महता पापनिर्हरणंतथा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2192485, "chapter_id": 5092, "verse_number": "१८", "content_sanskrit": "विरक्तस्ययथा सम्यग् घृतंभवति भेषजम् ।\nतथा निर्हृतदोषस्य प्रेत्यधर्मः सुखावहः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2192486, "chapter_id": 5092, "verse_number": "१९", "content_sanskrit": "मानसं सर्वभूतेषु वर्तते वै शुभाशुभे ।\nअशुभेभ्यः समाक्षिप्य शुभेष्वेवावतारयेत्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2192487, "chapter_id": 5092, "verse_number": "२०", "content_sanskrit": "सर्वं सर्वेण सर्वत्र क्रियमाणं च पूजय।\nस्वधर्मे यत्र रागस्ते कामं धर्मो विधीयताम्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2192488, "chapter_id": 5092, "verse_number": "२१", "content_sanskrit": "अधृतात्मन् धृतौ तिष्ठ दुर्बुद्धे बुद्धिमान् भव ।\nअप्रशान्त प्रशाम्य त्वमप्राज्ञ प्राज्ञवच्चर\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2192489, "chapter_id": 5092, "verse_number": "२२", "content_sanskrit": "तेजसाशक्यते प्राप्तुमुपायसहचारिणा ।\nइह च प्रेत्य च श्रेयस्तस्य मूलं धृतिः परा\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2192490, "chapter_id": 5092, "verse_number": "२३", "content_sanskrit": "राजर्षिरधृतिः स्वर्गात् पतितो हि महाभिषः।\nययातिः क्षीणपुण्यश्च धृत्या लोकानवाप्तवान्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2192491, "chapter_id": 5092, "verse_number": "२४", "content_sanskrit": "तपस्विनां धर्मवतांविदुषां चोपसेवनात् ।\nप्राप्स्यसे विपुलां बुद्धिं तथा श्रेयोऽभिपत्स्यसे\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2192492, "chapter_id": 5092, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2192493, "chapter_id": 5092, "verse_number": "२५", "content_sanskrit": "स तु स्वभावसम्पन्नस्तच्छ्रुत्वा मुनिभाषितम् ।\nविनिवर्त्यमनः कामाद्धर्मे बुद्धिं चकार ह\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2192494, "chapter_id": 5092, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे एकचत्वारिंशोत्तरशततमोऽध्यायः ॥१४१॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]