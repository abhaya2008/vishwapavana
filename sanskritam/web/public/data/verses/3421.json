[{"id": 2112246, "chapter_id": 3421, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2112247, "chapter_id": 3421, "verse_number": "१", "content_sanskrit": "चेदिराजसुतां ज्ञात्वा दाशराजेन वर्धिताम् ।\nविवाहं कारयामास शास्त्रमृष्टेन कर्मणा \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2112248, "chapter_id": 3421, "verse_number": "२", "content_sanskrit": "तदा विवाहे निर्वृत्ते स राजा शन्तनुस्ततः ।\nतां कन्यां रूपसम्पन्नां स्वगृहे सन्न्यवेशयत् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2112249, "chapter_id": 3421, "verse_number": "३", "content_sanskrit": "ततः शान्तनवो धीमान् सत्यवत्यामजायत ।\nपुत्रश्चित्राङ्गदो नाम बलवीर्यसमन्वितः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2112250, "chapter_id": 3421, "verse_number": "४", "content_sanskrit": "अथाऽपरं महेष्वासं सत्यवत्यां पुनः सुतम् ।\nविचित्रवीर्यं धर्मात्मा जनयामास वीर्यवान्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2112251, "chapter_id": 3421, "verse_number": "५", "content_sanskrit": "अप्राप्तवति तस्मिंश्च यौवनं भरतर्षभ ।\nस राजा शन्तनुर्धीमान् कालधर्ममुपेयिवान्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2112252, "chapter_id": 3421, "verse_number": "६", "content_sanskrit": "स्वर्याते शन्तनौ भीष्मश्चित्राङ्गदमरिन्दमम् ।\nस्थापयामास वै राज्ये सत्यवत्या मते स्थितः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2112253, "chapter_id": 3421, "verse_number": "७", "content_sanskrit": "स तु चित्राङ्गदो धीमान् सर्वांश्चिक्षेप पार्थिवान् ।\nमानुषं नहि मेने स कञ्चित् सदृशमात्मनः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2112254, "chapter_id": 3421, "verse_number": "८", "content_sanskrit": "तं क्षिपन्तं सुरांश्चैव मनुष्यानसुरांस्तथा ।\nगन्धर्वराजो बलावांस्तुल्यनामाऽभ्ययात् तदा \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2112255, "chapter_id": 3421, "verse_number": "", "content_sanskrit": "गन्धर्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2112256, "chapter_id": 3421, "verse_number": "९", "content_sanskrit": "त्वं वै सदृशनामाऽसि युद्धं देहि नृपात्मज ।\nनाम चान्यत् प्रगृह्णीष्व यदि युद्धं न दास्यसि \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2112257, "chapter_id": 3421, "verse_number": "१०", "content_sanskrit": "त्वयाऽहं युद्धमिच्छामि त्वत्सकाशात् तु नामतः ।\nआगतोऽस्मि वृथा भाष्यो न गच्छेन्नामतोऽन्यथा \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2112258, "chapter_id": 3421, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2112259, "chapter_id": 3421, "verse_number": "११", "content_sanskrit": "इत्युक्त्वा गर्जमानौ तौ हिरण्वत्तीरसङ्गतौ ।\nतेनास्य युद्धं सुमहत् कुरुक्षेत्रे बभूव ह \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2112260, "chapter_id": 3421, "verse_number": "११", "content_sanskrit": "नद्याः कूले हिरण्वत्याः समास्तिस्रोऽभवद् रणम् ।\nतयोर्बलवतोस्तत्र गन्धर्वकुरुमुख्ययोः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2112261, "chapter_id": 3421, "verse_number": "१२", "content_sanskrit": "तस्मिन् विमर्दे तुमुले नानाशस्त्रसमाकुले ।\nमायाधिकोऽवधीद् वीरं गन्धर्वः कुरुसत्तमम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2112262, "chapter_id": 3421, "verse_number": "१३", "content_sanskrit": "चित्राङ्गदं कुरुश्रेष्ठं विचित्रशरकार्मुकम् ।\nचित्राङ्गदो विनिर्जित्य दिवमाचक्रमे पुनः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2112263, "chapter_id": 3421, "verse_number": "१४", "content_sanskrit": "तस्मिंस्तु नृपशार्दूले निहते भूरिवर्चसि ।\nभीष्मः शान्तनवो धीमान् प्रेतकार्याण्यकारयत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2112264, "chapter_id": 3421, "verse_number": "१५", "content_sanskrit": "विचित्रवीर्यं च तदा बालमप्राप्तयौवनम् ।\nकुरुराज्ये महाबाहुरभ्यषिञ्चदनन्तरम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2112265, "chapter_id": 3421, "verse_number": "१६", "content_sanskrit": "विचित्रवीर्यस्तु तदा भीष्मस्य वचने स्थितः ।\nअन्वशासन्महाराज पितृपैतामहं पदम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2112266, "chapter_id": 3421, "verse_number": "१७", "content_sanskrit": "स धर्मशास्त्रकुशलो भीष्मं शान्तनवं नृपम् ।\nपूजयामास पूजार्हं स चैनं प्रत्यपालयत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2112267, "chapter_id": 3421, "verse_number": "४८", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nशततमोऽध्यायः ॥१००॥ ॥ इति सम्भवपर्वणि अष्टचत्वारिंशोऽध्यायः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2112268, "chapter_id": 3421, "verse_number": "", "content_sanskrit": "* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]