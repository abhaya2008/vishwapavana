[{"id": 2023128, "chapter_id": 1494, "verse_number": "३-१३२-०x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2023129, "chapter_id": 1494, "verse_number": "३-१३२-१", "content_sanskrit": "इह मर्त्यास्तनूस्त्यक्त्वा स्वर्गं गच्छन्ति भारत।\nमर्तुकामा नरा राजन्निहायान्ति सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2023130, "chapter_id": 1494, "verse_number": "३-१३२-२", "content_sanskrit": "एवमाशीः प्रयुक्ता हि दक्षेण यजता पुरा।\nइह ये वै मरिष्यन्ति ते वै स्वर्गजितो नराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2023131, "chapter_id": 1494, "verse_number": "३-१३२-३", "content_sanskrit": "एषा सरस्वती रम्या दिव्या चौघवती नदी।\nएतद्विनशनं नाम सरस्वत्या विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2023132, "chapter_id": 1494, "verse_number": "३-१३२-४", "content_sanskrit": "द्वारं निषादराष्ट्रस्य येषां दोषात्सरस्वती।\nप्रविष्टा पृथिवीं वीर मा निषादा हि मां विदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2023133, "chapter_id": 1494, "verse_number": "३-१३२-५", "content_sanskrit": "एष वै चमसोद्भेदो यत्र दृश्या सरस्वती।\nयत्रैनामभ्यवर्तन्त दिव्याः पुण्याः समुद्रगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2023134, "chapter_id": 1494, "verse_number": "३-१३२-६", "content_sanskrit": "एतत्सिन्धोर्महत्तीर्थं यत्रागस्त्यमरिंदम।\nलोपामुद्रा समागम्य भर्तारमवृणीत वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2023135, "chapter_id": 1494, "verse_number": "३-१३२-७", "content_sanskrit": "एतत्प्रकाशते तीर्थं प्रभासं भास्करद्युते।\nइन्द्रस्य दयितं पुण्यं पवित्रं पापनाशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2023136, "chapter_id": 1494, "verse_number": "३-१३२-८", "content_sanskrit": "एतद्विष्णुपदं नाम दृश्यते तीर्थमुत्तमम्।\nएषां रम्या विपाशा च नदी परमपावनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2023137, "chapter_id": 1494, "verse_number": "३-१३२-९", "content_sanskrit": "अत्र वै पुत्रशोकेन वसिष्ठो भगवानृषिः।\nबद्ध्वाऽत्मानं निपतितो विपाशः पुनरुत्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2023138, "chapter_id": 1494, "verse_number": "३-१३२-१०", "content_sanskrit": "काश्मीरमण्डलं चैतत्सर्वपुण्यमरिंदम।\nमहर्षिभिश्चाध्युषितं पश्येदं भ्रातृभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2023139, "chapter_id": 1494, "verse_number": "३-१३२-११", "content_sanskrit": "यत्रौत्तराणां सर्वेषामृषीणां नाहुषस्य च।\nअग्नेश्चैवात्र संवादः काश्यपश्य च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2023140, "chapter_id": 1494, "verse_number": "३-१३२-१२", "content_sanskrit": "एतद्द्वारं महाराज मानसस्य प्रकाशते।\nवर्षमस्य गिरेर्मध्ये रामेण श्रीमता कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2023141, "chapter_id": 1494, "verse_number": "३-१३२-१३", "content_sanskrit": "एष वातिकषण्डो वै प्रख्यातः सत्यविक्रमः।\nनात्यवर्तत यद्द्वारं विदेहादुत्तरं च यः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2023142, "chapter_id": 1494, "verse_number": "३-१३२-१४", "content_sanskrit": "इदमाश्चर्यमपरं देशेऽस्मिन्पुरुषर्षभ।\nक्षीणे युगे तु कौन्तेय शर्वस्य सह पार्षदैः।\nसहोमया च भवति दर्शनं कामरूपिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2023143, "chapter_id": 1494, "verse_number": "३-१३२-१५", "content_sanskrit": "अस्मिन्सरसि सत्रैर्वै चैत्रे मासि पिनाकिनम्।\nयजन्ते याजकाः सम्यक् परिवारं शुभार्थिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2023144, "chapter_id": 1494, "verse_number": "३-१३२-१६", "content_sanskrit": "अत्रोपस्पृश्य सरसि श्रद्दधानो जितेन्द्रियः।\nक्षीणपापः शुभाँल्लोकान्प्राप्नुते नात्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2023145, "chapter_id": 1494, "verse_number": "३-१३२-१७", "content_sanskrit": "एष उज्जानको नाम पावकिर्यत्र शान्तवान्।\nअरुन्धतीसहायश्च वसिष्ठो भगवानृषिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2023146, "chapter_id": 1494, "verse_number": "३-१३२-१८", "content_sanskrit": "ह्रदश्च कुशवानेष यत्र पद्मं कुशेशयम्।\nआश्रमश्चैव रुक्मिण्या यत्राशाम्यदकोपना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2023147, "chapter_id": 1494, "verse_number": "३-१३२-१९", "content_sanskrit": "समाधीनां समासस्तु पाण्डवेय श्रुतस्त्वया।\nतं द्रक्ष्यसि महाराज भृगुतुन्दं महागिरिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2023148, "chapter_id": 1494, "verse_number": "३-१३२-२०", "content_sanskrit": "वितस्तां पश्य राजेन्द्र सर्वपापप्रमोचनीम्।\nमहर्षिभिश्चाध्युषितां शीततोयां सुनिर्मलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2023149, "chapter_id": 1494, "verse_number": "३-१३२-२१", "content_sanskrit": "जलां चोपजलां चैव यमुनामभितो नदीम्।\nउशीनरो वै यत्रेष्ट्वा वासवादत्यरिच्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2023150, "chapter_id": 1494, "verse_number": "३-१३२-२२", "content_sanskrit": "तां देवसमितिं तस्य वासवश्च विशांपते।\nअभ्यागच्छन्नृपवरं ज्ञातुमग्निश्च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2023151, "chapter_id": 1494, "verse_number": "३-१३२-२३", "content_sanskrit": "जिज्ञासमानौ वरदौ महात्मानमुशीनरम्।\nइन्द्रः श्येनः कपोतोऽग्निर्भूत्वा यज्ञेऽभिजग्मतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2023152, "chapter_id": 1494, "verse_number": "३-१३२-२४", "content_sanskrit": "उरुं राज्ञः समासाद्य कपोतः श्येनजाद्भयात्।\nशरणार्थी तदा राजन्निलिल्ये भयपीडितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2023153, "chapter_id": 1494, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि द्वात्रिंशदधिकशततमोऽध्यायः ॥ १३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]