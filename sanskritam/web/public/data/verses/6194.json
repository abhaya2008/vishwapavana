[
  {
    "id": 16794001,
    "chapter_id": 6194,
    "verse_number": "4.1",
    "content_sanskrit": "ज्ञानेनाकाशकल्पेन धर्मान्यो गगनोपमान् ।\nज्ञेयाभिन्नेन सम्बुद्धस्तं वन्दे द्विपदां वरम् ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "base_unit_id": "MK_C04_K01"
  },
  {
    "id": 16794002,
    "chapter_id": 6194,
    "verse_number": "4.2",
    "content_sanskrit": "अस्पर्शयोगो वै नाम सर्वसत्त्वसुखो हितः ।\nअविवादोऽविरुद्धश्च देशितस्तं नमाम्यहम् ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "base_unit_id": "MK_C04_K02"
  },
  {
    "id": 16794003,
    "chapter_id": 6194,
    "verse_number": "4.3",
    "content_sanskrit": "भूतस्य जातिमिच्छन्ति वादिनः केचिदेव हि ।\nअभूतस्यापरे धीरा विवदन्तः परस्परम् ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "base_unit_id": "MK_C04_K03"
  },
  {
    "id": 16794004,
    "chapter_id": 6194,
    "verse_number": "4.4",
    "content_sanskrit": "भूतं न जायते किञ्चिदभूतं नैव जायते ।\nविवदन्तोऽद्वया ह्येवमजातिं ख्यापयन्ति ते ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "base_unit_id": "MK_C04_K04"
  },
  {
    "id": 16794005,
    "chapter_id": 6194,
    "verse_number": "4.5",
    "content_sanskrit": "ख्याप्यमानामजातिं तैरनुमोदामहे वयम् ।\nविवदामो न तैः सार्धमविवादं निबोधत ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "base_unit_id": "MK_C04_K05"
  },
  {
    "id": 16794006,
    "chapter_id": 6194,
    "verse_number": "4.6",
    "content_sanskrit": "अजातस्यैव धर्मस्य जातिमिच्छन्ति वादिनः ।\nअजातो ह्यमृतो धर्मो मर्त्यतां कथमेष्यति ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "base_unit_id": "MK_C04_K06"
  },
  {
    "id": 16794007,
    "chapter_id": 6194,
    "verse_number": "4.7",
    "content_sanskrit": "न भवत्यमृतं मर्त्यं न मर्त्यममृतं तथा ।\nप्रकृतेरन्यथाभावो न कथञ्चिद्भविष्यति ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "base_unit_id": "MK_C04_K07"
  },
  {
    "id": 16794008,
    "chapter_id": 6194,
    "verse_number": "4.8",
    "content_sanskrit": "स्वभावेनामृतो यस्य धर्मो गच्छति मर्त्यतात् ।\nकृतकेनामृतस्तस्य कथं स्थास्यति निश्चलः ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "base_unit_id": "MK_C04_K08"
  },
  {
    "id": 16794009,
    "chapter_id": 6194,
    "verse_number": "4.9",
    "content_sanskrit": "सांसिद्धिकी स्वाभाविकी सहजा अकृता च या ।\nप्रकृतिः सेति विज्ञेया स्वभावं न जहाति या ॥ ९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "base_unit_id": "MK_C04_K09"
  },
  {
    "id": 16794010,
    "chapter_id": 6194,
    "verse_number": "4.10",
    "content_sanskrit": "जरामरणनिर्मुक्ताः सर्वे धर्माः स्वभावतः ।\nजरामरणमिच्छन्तश्च्यवन्ते तन्मनीषया ॥ १० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "base_unit_id": "MK_C04_K10"
  },
  {
    "id": 16794011,
    "chapter_id": 6194,
    "verse_number": "4.11",
    "content_sanskrit": "कारणं यस्य वै कार्यं कारणं तस्य जायते ।\nजायमानं कथमजं भिन्नं नित्यं कथं च तत् ॥ ११ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "base_unit_id": "MK_C04_K11"
  },
  {
    "id": 16794012,
    "chapter_id": 6194,
    "verse_number": "4.12",
    "content_sanskrit": "कारणाद्यद्यनन्यत्वमतः कार्यमजं तव ।\nजायमानाद्धि वै कार्यात्कारणं ते कथं ध्रुवम् ॥ १२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "base_unit_id": "MK_C04_K12"
  },
  {
    "id": 16794013,
    "chapter_id": 6194,
    "verse_number": "4.13",
    "content_sanskrit": "अजाद्वै जायते यस्य दृष्टान्तस्तस्य नास्ति वै ।\nजाताच्च जायमानस्य न व्यवस्था प्रसज्यते ॥ १३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "base_unit_id": "MK_C04_K13"
  },
  {
    "id": 16794014,
    "chapter_id": 6194,
    "verse_number": "4.14",
    "content_sanskrit": "हेतोरादिः फलं येषामादिर्हेतुः फलस्य च ।\nहेतोः फलस्य चानादिः कथं तैरुपवर्ण्यते ॥ १४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "base_unit_id": "MK_C04_K14"
  },
  {
    "id": 16794015,
    "chapter_id": 6194,
    "verse_number": "4.15",
    "content_sanskrit": "हेतोरादिः फलं येषामादिर्हेतुः फलस्य च ।\nतथा जन्म भवेत्तेषां पुत्राज्जन्म पितुर्यथा ॥ १५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "base_unit_id": "MK_C04_K15"
  },
  {
    "id": 16794016,
    "chapter_id": 6194,
    "verse_number": "4.16",
    "content_sanskrit": "सम्भवे हेतुफलयोरेषितव्यः क्रमस्त्वया ।\nयुगपत्सम्भवे यस्मादसम्बन्धो विषाणवत् ॥ १६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "base_unit_id": "MK_C04_K16"
  },
  {
    "id": 16794017,
    "chapter_id": 6194,
    "verse_number": "4.17",
    "content_sanskrit": "फलादुत्पद्यमानः सन्न ते हेतुः प्रसिध्यति ।\nअप्रसिद्धः कथं हेतुः फलमुत्पादयिष्यति ॥ १७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "base_unit_id": "MK_C04_K17"
  },
  {
    "id": 16794018,
    "chapter_id": 6194,
    "verse_number": "4.18",
    "content_sanskrit": "यदि हेतोः फलात्सिद्धिः फलसिद्धिश्च हेतुतः ।\nकतरत्पूर्वनिष्पन्नं यस्य सिद्धिरपेक्षया ॥ १८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "base_unit_id": "MK_C04_K18"
  },
  {
    "id": 16794019,
    "chapter_id": 6194,
    "verse_number": "4.19",
    "content_sanskrit": "अशक्तिरपरिज्ञानं क्रमकोपोऽथ वा पुनः ।\nएवं हि सर्वथा बुद्धैरजातिः परिदीपिता ॥ १९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "base_unit_id": "MK_C04_K19"
  },
  {
    "id": 16794020,
    "chapter_id": 6194,
    "verse_number": "4.20",
    "content_sanskrit": "बीजाङ्कुराख्यो दृष्टान्तः सदा साध्यसमो हि सः ।\nन हि साध्यसमो हेतुः सिद्धौ साध्यस्य युज्यते ॥ २० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "base_unit_id": "MK_C04_K20"
  },
  {
    "id": 16794021,
    "chapter_id": 6194,
    "verse_number": "4.21",
    "content_sanskrit": "पूर्वापरापरिज्ञानमजातेः परिदीपकम् ।\nजायमानाद्धि वै धर्मात्कथं पूर्वं न गृह्यते ॥ २१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "base_unit_id": "MK_C04_K21"
  },
  {
    "id": 16794022,
    "chapter_id": 6194,
    "verse_number": "4.22",
    "content_sanskrit": "स्वतो वा परतो वापि न किञ्चिद्वस्तु जायते ।\nसदसत्सदसद्वापि न किञ्चिद्वस्तु जायते ॥ २२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "base_unit_id": "MK_C04_K22"
  },
  {
    "id": 16794023,
    "chapter_id": 6194,
    "verse_number": "4.23",
    "content_sanskrit": "हेतुर्न जायतेऽनादेः फलं चापि स्वभावतः ।\nआदिर्न विद्यते यस्य तस्य ह्यादिर्न विद्यते ॥ २३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "base_unit_id": "MK_C04_K23"
  },
  {
    "id": 16794024,
    "chapter_id": 6194,
    "verse_number": "4.24",
    "content_sanskrit": "प्रज्ञप्तेः सनिमित्तत्वमन्यथा द्वयनाशतः ।\nसङ्क्लेशस्योपलब्धेश्च परतन्त्रास्तिता मता ॥ २४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "base_unit_id": "MK_C04_K24"
  },
  {
    "id": 16794025,
    "chapter_id": 6194,
    "verse_number": "4.25",
    "content_sanskrit": "प्रज्ञप्तेः सनिमित्तत्वमिष्यते युक्तिदर्शनात् ।\nनिमित्तस्यानिमित्तत्वमिष्यते भूतदर्शनात् ॥ २५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "base_unit_id": "MK_C04_K25"
  },
  {
    "id": 16794026,
    "chapter_id": 6194,
    "verse_number": "4.26",
    "content_sanskrit": "चित्तं न संस्पृशत्यर्थं नार्थाभासं तथैव च ।\nअभूतो हि यतश्चार्थो नार्थाभासस्ततः पृथक् ॥ २६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "base_unit_id": "MK_C04_K26"
  },
  {
    "id": 16794027,
    "chapter_id": 6194,
    "verse_number": "4.27",
    "content_sanskrit": "निमित्तं न सदा चित्तं संस्पृशत्यध्वसु त्रिषु ।\nअनिमित्तो विपर्यासः कथं तस्य भविष्यति ॥ २७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "base_unit_id": "MK_C04_K27"
  },
  {
    "id": 16794028,
    "chapter_id": 6194,
    "verse_number": "4.28",
    "content_sanskrit": "तस्मान्न जायते चित्तं चित्तदृश्यं न जायते ।\nतस्य पश्यन्ति ये जातिं खे वै पश्यन्ति ते पदम् ॥ २८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "base_unit_id": "MK_C04_K28"
  },
  {
    "id": 16794029,
    "chapter_id": 6194,
    "verse_number": "4.29",
    "content_sanskrit": "अजातं जायते यस्मादजातिः प्रकृतिस्ततः ।\nप्रकृतेरन्यथाभावो न कथञ्चिद्भविष्यति ॥ २९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "base_unit_id": "MK_C04_K29"
  },
  {
    "id": 16794030,
    "chapter_id": 6194,
    "verse_number": "4.30",
    "content_sanskrit": "अनादेरन्तवत्त्वं च संसारस्य न सेत्स्यति ।\nअनन्तता चादिमतो मोक्षस्य न भविष्यति ॥ ३० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "base_unit_id": "MK_C04_K30"
  },
  {
    "id": 16794031,
    "chapter_id": 6194,
    "verse_number": "4.31",
    "content_sanskrit": "आदावन्ते च यन्नास्ति वर्तमानेऽपि तत्तथा ।\nवितथैः सदृशाः सन्तोऽवितथा इव लक्षिताः ॥ ३१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "base_unit_id": "MK_C04_K31"
  },
  {
    "id": 16794032,
    "chapter_id": 6194,
    "verse_number": "4.32",
    "content_sanskrit": "सप्रयोजनता तेषां स्वप्ने विप्रतिपद्यते ।\nतस्मादाद्यन्तवत्त्वेन मिथ्यैव खलु ते स्मृताः ॥ ३२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "base_unit_id": "MK_C04_K32"
  },
  {
    "id": 16794033,
    "chapter_id": 6194,
    "verse_number": "4.33",
    "content_sanskrit": "सर्वे धर्मा मृषा स्वप्ने कायस्यान्तर्निदर्शनात् ।\nसंवृतेऽस्मिन्प्रदेशे वै भूतानां दर्शनं कुतः ॥ ३३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "base_unit_id": "MK_C04_K33"
  },
  {
    "id": 16794034,
    "chapter_id": 6194,
    "verse_number": "4.34",
    "content_sanskrit": "न युक्तं दर्शनं गत्वा कालस्यानियमाद्गतौ ।\nप्रतिबुद्धश्च वै सर्वस्तस्मिन्देशे न विद्यते ॥ ३४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "base_unit_id": "MK_C04_K34"
  },
  {
    "id": 16794035,
    "chapter_id": 6194,
    "verse_number": "4.35",
    "content_sanskrit": "मित्राद्यैः सह संमन्त्र्य सम्बुद्धो न प्रपद्यते ।\nगृहीतं चापि यत्किञ्चित्प्रतिबुद्धो न पश्यति ॥ ३५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "base_unit_id": "MK_C04_K35"
  },
  {
    "id": 16794036,
    "chapter_id": 6194,
    "verse_number": "4.36",
    "content_sanskrit": "स्वप्ने चावस्तुकः कायः पृथगन्यस्य दर्शनात् ।\nयथा कायस्तथा सर्वं चित्तदृश्यमवस्तुकम् ॥ ३६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "base_unit_id": "MK_C04_K36"
  },
  {
    "id": 16794037,
    "chapter_id": 6194,
    "verse_number": "4.37",
    "content_sanskrit": "ग्रहणाज्जागरितवत्तद्धेतुः स्वप्न इष्यते ।\nतद्धेतुत्वात्तु तस्यैव सज्जागरितमिष्यते ॥ ३७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "base_unit_id": "MK_C04_K37"
  },
  {
    "id": 16794038,
    "chapter_id": 6194,
    "verse_number": "4.38",
    "content_sanskrit": "उत्पादस्याप्रसिद्धत्वादजं सर्वमुदाहृतम् ।\nन च भूतादभूतस्य सम्भवोऽस्ति कथञ्चन ॥ ३८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "base_unit_id": "MK_C04_K38"
  },
  {
    "id": 16794039,
    "chapter_id": 6194,
    "verse_number": "4.39",
    "content_sanskrit": "असज्जागरिते दृष्ट्वा स्वप्ने पश्यति तन्मयः ।\nअसत्स्वप्नेऽपि दृष्ट्वा च प्रतिबुद्धो न पश्यति ॥ ३९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "base_unit_id": "MK_C04_K39"
  },
  {
    "id": 16794040,
    "chapter_id": 6194,
    "verse_number": "4.40",
    "content_sanskrit": "नास्त्यसद्धेतुकमसत्सदसद्धेतुकं तथा ।\nसच्च सद्धेतुकं नास्ति सद्धेतुकमसत्कुतः ॥ ४० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "base_unit_id": "MK_C04_K40"
  },
  {
    "id": 16794041,
    "chapter_id": 6194,
    "verse_number": "4.41",
    "content_sanskrit": "विपर्यासाद्यथा जाग्रदचिन्त्यान्भूतवत्स्पृशेत् ।\nतथा स्वप्ने विपर्यासाद्धर्मांस्तत्रैव पश्यति ॥ ४१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "base_unit_id": "MK_C04_K41"
  },
  {
    "id": 16794042,
    "chapter_id": 6194,
    "verse_number": "4.42",
    "content_sanskrit": "उपलम्भात्समाचारादस्तिवस्तुत्ववादिनाम् ।\nजातिस्तु देशिता बुद्धैरजातेस्त्रसतां सदा ॥ ४२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "base_unit_id": "MK_C04_K42"
  },
  {
    "id": 16794043,
    "chapter_id": 6194,
    "verse_number": "4.43",
    "content_sanskrit": "अजातेस्त्रसतां तेषामुपलम्भाद्वियन्ति ये ।\nजातिदोषा न सेत्स्यन्ति दोषोऽप्यल्पो भविष्यति ॥ ४३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "base_unit_id": "MK_C04_K43"
  },
  {
    "id": 16794044,
    "chapter_id": 6194,
    "verse_number": "4.44",
    "content_sanskrit": "उपलम्भात्समाचारान्मायाहस्ती यथोच्यते ।\nउपलम्भात्समाचारादस्ति वस्तु तथोच्यते ॥ ४४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "base_unit_id": "MK_C04_K44"
  },
  {
    "id": 16794045,
    "chapter_id": 6194,
    "verse_number": "4.45",
    "content_sanskrit": "जात्याभासं चलाभासं वस्त्वाभासं तथैव च ।\nअजाचलमवस्तुत्वं विज्ञानं शान्तमद्वयम् ॥ ४५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "base_unit_id": "MK_C04_K45"
  },
  {
    "id": 16794046,
    "chapter_id": 6194,
    "verse_number": "4.46",
    "content_sanskrit": "एवं न जायते चित्तमेवं धर्मा अजाः स्मृताः ।\nएवमेव विजानन्तो न पतन्ति विपर्यये ॥ ४६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "base_unit_id": "MK_C04_K46"
  },
  {
    "id": 16794047,
    "chapter_id": 6194,
    "verse_number": "4.47",
    "content_sanskrit": "ऋजुवक्रादिकाभासमलातस्पन्दितं यथा ।\nग्रहणग्राहकाभासं विज्ञानस्पन्दितं तथा ॥ ४७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "base_unit_id": "MK_C04_K47"
  },
  {
    "id": 16794048,
    "chapter_id": 6194,
    "verse_number": "4.48",
    "content_sanskrit": "अस्पन्दमानमलातमनाभासमजं यथा ।\nअस्पन्दमानं विज्ञानमनाभासमजं तथा ॥ ४८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "base_unit_id": "MK_C04_K48"
  },
  {
    "id": 16794049,
    "chapter_id": 6194,
    "verse_number": "4.49",
    "content_sanskrit": "अलाते स्पन्दमाने वै नाभासा अन्यतोभुवः ।\nन ततोऽन्यत्र निःस्पन्दान्नालातं प्रविशन्ति ते ॥ ४९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "base_unit_id": "MK_C04_K49"
  },
  {
    "id": 16794050,
    "chapter_id": 6194,
    "verse_number": "4.50",
    "content_sanskrit": "न निर्गता अलातात्ते द्रव्यत्वाभावयोगतः ।\nविज्ञानेऽपि तथैव स्युराभासस्याविशेषतः ॥ ५० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "base_unit_id": "MK_C04_K50"
  },
  {
    "id": 16794051,
    "chapter_id": 6194,
    "verse_number": "4.51",
    "content_sanskrit": "विज्ञाने स्पन्दमाने वै नाभासा अन्यतोभुवः ।\nन ततोऽन्यत्र निःस्पन्दान्न विज्ञानं विशन्ति ते ॥ ५१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "base_unit_id": "MK_C04_K51"
  },
  {
    "id": 16794052,
    "chapter_id": 6194,
    "verse_number": "4.52",
    "content_sanskrit": "न निर्गतास्ते विज्ञानाद्द्रव्यत्वाभावयोगतः ।\nकार्यकारणताभावाद्यतोऽचिन्त्याः सदैव ते ॥ ५२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "base_unit_id": "MK_C04_K52"
  },
  {
    "id": 16794053,
    "chapter_id": 6194,
    "verse_number": "4.53",
    "content_sanskrit": "द्रव्यं द्रव्यस्य हेतुः स्यादन्यदन्यस्य चैव हि ।\nद्रव्यत्वमन्यभावो वा धर्माणां नोपपद्यते ॥ ५३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "base_unit_id": "MK_C04_K53"
  },
  {
    "id": 16794054,
    "chapter_id": 6194,
    "verse_number": "4.54",
    "content_sanskrit": "एवं न चित्तजा धर्माश्चित्तं वापि न धर्मजम् ।\nएवं हेतुफलाजातिं प्रविशन्ति मनीषिणः ॥ ५४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "base_unit_id": "MK_C04_K54"
  },
  {
    "id": 16794055,
    "chapter_id": 6194,
    "verse_number": "4.55",
    "content_sanskrit": "यावद्धेतुफलावेशस्तावद्धेतुफलोद्भवः ।\nक्षीणे हेतुफलावेशे नास्ति हेतुफलोद्भवः ॥ ५५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "base_unit_id": "MK_C04_K55"
  },
  {
    "id": 16794056,
    "chapter_id": 6194,
    "verse_number": "4.56",
    "content_sanskrit": "यावद्धेतुफलावेशः संसारस्तावदायतः ।\nक्षीणे हेतुफलावेशे संसारं न प्रपद्यते ॥ ५६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "base_unit_id": "MK_C04_K56"
  },
  {
    "id": 16794057,
    "chapter_id": 6194,
    "verse_number": "4.57",
    "content_sanskrit": "संवृत्या जायते सर्वं शाश्वतं नास्ति तेन वै ।\nसद्भावेन ह्यजं सर्वमुच्छेदस्तेन नास्ति वै ॥ ५७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "base_unit_id": "MK_C04_K57"
  },
  {
    "id": 16794058,
    "chapter_id": 6194,
    "verse_number": "4.58",
    "content_sanskrit": "धर्मा य इति जायन्ते जायन्ते ते न तत्त्वतः ।\nजन्म मायोपमं तेषां सा च माया न विद्यते ॥ ५८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "base_unit_id": "MK_C04_K58"
  },
  {
    "id": 16794059,
    "chapter_id": 6194,
    "verse_number": "4.59",
    "content_sanskrit": "यथा मायामयाद्बीजाज्जायते तन्मयोऽङ्कुरः ।\nनासौ नित्यो न चोच्छेदी तद्वद्धर्मेषु योजना ॥ ५९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "base_unit_id": "MK_C04_K59"
  },
  {
    "id": 16794060,
    "chapter_id": 6194,
    "verse_number": "4.60",
    "content_sanskrit": "नाजेषु सर्वधर्मेषु शाश्वताशाश्वताभिधा ।\nयत्र वर्णा न वर्तन्ते विवेकस्तत्र नोच्यते ॥ ६० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "base_unit_id": "MK_C04_K60"
  },
  {
    "id": 16794061,
    "chapter_id": 6194,
    "verse_number": "4.61",
    "content_sanskrit": "यथा स्वप्ने द्वयाभासं चित्तं चलति मायया ।\nतथा जाग्रद्द्वयाभासं चित्तं चलति मायया ॥ ६१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "base_unit_id": "MK_C04_K61"
  },
  {
    "id": 16794062,
    "chapter_id": 6194,
    "verse_number": "4.62",
    "content_sanskrit": "अद्वयं च द्वयाभासं चित्तं स्वप्ने न संशयः ।\nअद्वयं च द्वयाभासं तथा जाग्रन्न संशयः ॥ ६२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "base_unit_id": "MK_C04_K62"
  },
  {
    "id": 16794063,
    "chapter_id": 6194,
    "verse_number": "4.63",
    "content_sanskrit": "स्वप्नदृक्प्रचरन्स्वप्ने दिक्षु वै दशसु स्थितान् ।\nअण्डजान्स्वेदजान्वापि जीवान्पश्यति यान्सदा ॥ ६३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "base_unit_id": "MK_C04_K63"
  },
  {
    "id": 16794064,
    "chapter_id": 6194,
    "verse_number": "4.64",
    "content_sanskrit": "स्वप्नदृक्चित्तदृश्यास्ते न विद्यन्ते ततः पृथक् ।\nतथा तद्दृश्यमेवेदं स्वप्नदृक्चित्तमिष्यते ॥ ६४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "base_unit_id": "MK_C04_K64"
  },
  {
    "id": 16794065,
    "chapter_id": 6194,
    "verse_number": "4.65",
    "content_sanskrit": "चरञ्जागरिते जाग्रद्दिक्षु वै दशसु स्थितान् ।\nअण्डजान्स्वेदजान्वापि जीवान्पश्यति यान्सदा ॥ ६५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "base_unit_id": "MK_C04_K65"
  },
  {
    "id": 16794066,
    "chapter_id": 6194,
    "verse_number": "4.66",
    "content_sanskrit": "जाग्रच्चित्तेक्षणीयास्ते न विद्यन्ते ततः पृथक् ।\nतथा तद्दृश्यमेवेदं जाग्रतश्चित्तमिष्यते ॥ ६६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "base_unit_id": "MK_C04_K66"
  },
  {
    "id": 16794067,
    "chapter_id": 6194,
    "verse_number": "4.67",
    "content_sanskrit": "उभे ह्यन्योन्यदृश्ये ते किं तदस्तीति चोच्यते ।\nलक्षणाशून्यमुभयं तन्मते नैव गृह्यते ॥ ६७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "base_unit_id": "MK_C04_K67"
  },
  {
    "id": 16794068,
    "chapter_id": 6194,
    "verse_number": "4.68",
    "content_sanskrit": "यथा स्वप्नमयो जीवो जायते म्रियतेऽपि च ।\nतथा जीवा अमी सर्वे भवन्ति न भवन्ति च ॥ ६८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "base_unit_id": "MK_C04_K68"
  },
  {
    "id": 16794069,
    "chapter_id": 6194,
    "verse_number": "4.69",
    "content_sanskrit": "यथा मायामयो जीवो जायते म्रियतेऽपि च ।\nतथा जीवा अमी सर्वे भवन्ति न भवन्ति च ॥ ६९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "base_unit_id": "MK_C04_K69"
  },
  {
    "id": 16794070,
    "chapter_id": 6194,
    "verse_number": "4.70",
    "content_sanskrit": "यथा निर्मितको जीवो जायते म्रियतेऽपि च ।\nतथा जीवा अमी सर्वे भवन्ति न भवन्ति च ॥ ७० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70,
    "base_unit_id": "MK_C04_K70"
  },
  {
    "id": 16794071,
    "chapter_id": 6194,
    "verse_number": "4.71",
    "content_sanskrit": "न कश्चिज्जायते जीवः सम्भवोऽस्य न विद्यते ।\nएतत्तदुत्तमं सत्यं यत्र किञ्चिन्न जायते ॥ ७१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71,
    "base_unit_id": "MK_C04_K71"
  },
  {
    "id": 16794072,
    "chapter_id": 6194,
    "verse_number": "4.72",
    "content_sanskrit": "चित्तस्पन्दितमेवेदं ग्राह्यग्राहकवद्द्वयम् ।\nचित्तं निर्विषयं नित्यमसङ्गं तेन कीर्तितम् ॥ ७२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 72,
    "base_unit_id": "MK_C04_K72"
  },
  {
    "id": 16794073,
    "chapter_id": 6194,
    "verse_number": "4.73",
    "content_sanskrit": "योऽस्ति कल्पितसंवृत्या परमार्थेन नास्त्यसौ ।\nपरतन्त्राभिसंवृत्या स्यान्नास्ति परमार्थतः ॥ ७३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 73,
    "base_unit_id": "MK_C04_K73"
  },
  {
    "id": 16794074,
    "chapter_id": 6194,
    "verse_number": "4.74",
    "content_sanskrit": "अजः कल्पितसंवृत्या परमार्थेन नाप्यजः ।\nपरतन्त्राभिनिष्पत्त्या संवृत्या जायते तु सः ॥ ७४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 74,
    "base_unit_id": "MK_C04_K74"
  },
  {
    "id": 16794075,
    "chapter_id": 6194,
    "verse_number": "4.75",
    "content_sanskrit": "अभूताभिनिवेशोऽस्ति द्वयं तत्र न विद्यते ।\nद्वयाभावं स बुद्ध्वैव निर्निमित्तो न जायते ॥ ७५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 75,
    "base_unit_id": "MK_C04_K75"
  },
  {
    "id": 16794076,
    "chapter_id": 6194,
    "verse_number": "4.76",
    "content_sanskrit": "यदा न लभते हेतूनुत्तमाधममध्यमान् ।\nतदा न जायते चित्तं हेत्वभावे फलं कुतः ॥ ७६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 76,
    "base_unit_id": "MK_C04_K76"
  },
  {
    "id": 16794077,
    "chapter_id": 6194,
    "verse_number": "4.77",
    "content_sanskrit": "अनिमित्तस्य चित्तस्य यानुत्पत्तिः समाद्वया ।\nअजातस्यैव सर्वस्य चित्तदृश्यं हि तद्यतः ॥ ७७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 77,
    "base_unit_id": "MK_C04_K77"
  },
  {
    "id": 16794078,
    "chapter_id": 6194,
    "verse_number": "4.78",
    "content_sanskrit": "बुद्ध्वानिमित्ततां सत्यां हेतुं पृथगनाप्नुवन् ।\nवीतशोकं तथा काममभयं पदमश्नुते ॥ ७८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 78,
    "base_unit_id": "MK_C04_K78"
  },
  {
    "id": 16794079,
    "chapter_id": 6194,
    "verse_number": "4.79",
    "content_sanskrit": "अभूताभिनिवेशाद्धि सदृशे तत्प्रवर्तते ।\nवस्त्वभावं स बुद्ध्वैव निःसङ्गं विनिवर्तते ॥ ७९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 79,
    "base_unit_id": "MK_C04_K79"
  },
  {
    "id": 16794080,
    "chapter_id": 6194,
    "verse_number": "4.80",
    "content_sanskrit": "निवृत्तस्याप्रवृत्तस्य निश्चला हि तदा स्थितिः ।\nविषयः स हि बुद्धानां तत्साम्यमजमद्वयम् ॥ ८० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 80,
    "base_unit_id": "MK_C04_K80"
  },
  {
    "id": 16794081,
    "chapter_id": 6194,
    "verse_number": "4.81",
    "content_sanskrit": "अजमनिद्रमस्वप्नं प्रभातं भवति स्वयम् ।\nसकृद्विभातो ह्येवैष धर्मो धातुस्वभावतः ॥ ८१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 81,
    "base_unit_id": "MK_C04_K81"
  },
  {
    "id": 16794082,
    "chapter_id": 6194,
    "verse_number": "4.82",
    "content_sanskrit": "सुखमाव्रियते नित्यं दुःखं विव्रियते सदा ।\nयस्य कस्य च धर्मस्य ग्रहेण भगवानसौ ॥ ८२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 82,
    "base_unit_id": "MK_C04_K82"
  },
  {
    "id": 16794083,
    "chapter_id": 6194,
    "verse_number": "4.83",
    "content_sanskrit": "अस्ति नास्त्यस्ति नास्तीति नास्ति नास्तीति वा पुनः ।\nचलस्थिरोभयाभावैरावृणोत्येव बालिशः ॥ ८३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 83,
    "base_unit_id": "MK_C04_K83"
  },
  {
    "id": 16794084,
    "chapter_id": 6194,
    "verse_number": "4.84",
    "content_sanskrit": "कोट्यश्चतस्र एतास्तु ग्रहैर्यासां सदावृतः ।\nभगवानाभिरस्पृष्टो येन दृष्टः स सर्वदृक् ॥ ८४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 84,
    "base_unit_id": "MK_C04_K84"
  },
  {
    "id": 16794085,
    "chapter_id": 6194,
    "verse_number": "4.85",
    "content_sanskrit": "प्राप्य सर्वज्ञतां कृत्स्नां ब्राह्मण्यं पदमद्वयम् ।\nअनापन्नादिमध्यान्तं किमतः परमीहते ॥ ८५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 85,
    "base_unit_id": "MK_C04_K85"
  },
  {
    "id": 16794086,
    "chapter_id": 6194,
    "verse_number": "4.86",
    "content_sanskrit": "विप्राणां विनयो ह्येष शमः प्राकृत उच्यते ।\nदमः प्रकृतिदान्तत्वादेवं विद्वाञ्शमं व्रजेत् ॥ ८६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 86,
    "base_unit_id": "MK_C04_K86"
  },
  {
    "id": 16794087,
    "chapter_id": 6194,
    "verse_number": "4.87",
    "content_sanskrit": "सवस्तु सोपलम्भं च द्वयं लौकिकमिष्यते ।\nअवस्तु सोपलम्भं च शुद्धं लौकिकमिष्यते ॥ ८७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 87,
    "base_unit_id": "MK_C04_K87"
  },
  {
    "id": 16794088,
    "chapter_id": 6194,
    "verse_number": "4.88",
    "content_sanskrit": "अवस्त्वनुपलम्भं च लोकोत्तरमिति स्मृतम् ।\nज्ञानं ज्ञेयं च विज्ञेयं सदा बुद्धैः प्रकीर्तितम् ॥ ८८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 88,
    "base_unit_id": "MK_C04_K88"
  },
  {
    "id": 16794089,
    "chapter_id": 6194,
    "verse_number": "4.89",
    "content_sanskrit": "ज्ञाने च त्रिविधे ज्ञेये क्रमेण विदिते स्वयम् ।\nसर्वज्ञता हि सर्वत्र भवतीह महाधियः ॥ ८९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 89,
    "base_unit_id": "MK_C04_K89"
  },
  {
    "id": 16794090,
    "chapter_id": 6194,
    "verse_number": "4.90",
    "content_sanskrit": "हेयज्ञेयाप्यपाक्यानि विज्ञेयान्यग्रयाणतः ।\nतेषामन्यत्र विज्ञेयादुपलम्भस्त्रिषु स्मृतः ॥ ९० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 90,
    "base_unit_id": "MK_C04_K90"
  },
  {
    "id": 16794091,
    "chapter_id": 6194,
    "verse_number": "4.91",
    "content_sanskrit": "प्रकृत्याकाशवज्ज्ञेयाः सर्वे धर्मा अनादयः ।\nविद्यते न हि नानात्वं तेषां क्वचन किञ्चन ॥ ९१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 91,
    "base_unit_id": "MK_C04_K91"
  },
  {
    "id": 16794092,
    "chapter_id": 6194,
    "verse_number": "4.92",
    "content_sanskrit": "आदिबुद्धाः प्रकृत्यैव सर्वे धर्माः सुनिश्चिताः ।\nयस्यैवं भवति क्षान्तिः सोऽमृतत्वाय कल्पते ॥ ९२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 92,
    "base_unit_id": "MK_C04_K92"
  },
  {
    "id": 16794093,
    "chapter_id": 6194,
    "verse_number": "4.93",
    "content_sanskrit": "आदिशान्ता ह्यनुत्पन्नाः प्रकृत्यैव सुनिर्वृताः ।\nसर्वे धर्माः समाभिन्ना अजं साम्यं विशारदम् ॥ ९३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 93,
    "base_unit_id": "MK_C04_K93"
  },
  {
    "id": 16794094,
    "chapter_id": 6194,
    "verse_number": "4.94",
    "content_sanskrit": "वैशारद्यं तु वै नास्ति भेदे विचरतां सदा ।\nभेदनिम्नाः पृथग्वादास्तस्मात्ते कृपणाः स्मृताः ॥ ९४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 94,
    "base_unit_id": "MK_C04_K94"
  },
  {
    "id": 16794095,
    "chapter_id": 6194,
    "verse_number": "4.95",
    "content_sanskrit": "अजे साम्ये तु ये केचिद्भविष्यन्ति सुनिश्चिताः ।\nते हि लोके महाज्ञानास्तच्च लोको न गाहते ॥ ९५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 95,
    "base_unit_id": "MK_C04_K95"
  },
  {
    "id": 16794096,
    "chapter_id": 6194,
    "verse_number": "4.96",
    "content_sanskrit": "अजेष्वजमसङ्क्रान्तं धर्मेषु ज्ञानमिष्यते ।\nयतो न क्रमते ज्ञानमसङ्गं तेन कीर्तितम् ॥ ९६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 96,
    "base_unit_id": "MK_C04_K96"
  },
  {
    "id": 16794097,
    "chapter_id": 6194,
    "verse_number": "4.97",
    "content_sanskrit": "अणुमात्रेऽपि वैधर्म्ये जायमानेऽविपश्चितः ।\nअसङ्गता सदा नास्ति किमुतावरणच्युतिः ॥ ९७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 97,
    "base_unit_id": "MK_C04_K97"
  },
  {
    "id": 16794098,
    "chapter_id": 6194,
    "verse_number": "4.98",
    "content_sanskrit": "अलब्धावरणाः सर्वे धर्माः प्रकृतिनिर्मलाः ।\nआदौ बुद्धास्तथा मुक्ता बुध्यन्त इति नायकाः ॥ ९८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 98,
    "base_unit_id": "MK_C04_K98"
  },
  {
    "id": 16794099,
    "chapter_id": 6194,
    "verse_number": "4.99",
    "content_sanskrit": "क्रमते न हि बुद्धस्य ज्ञानं धर्मेषु तायिनः ।\nसर्वे धर्मास्तथा ज्ञानं नैतद्बुद्धेन भाषितम् ॥ ९९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 99,
    "base_unit_id": "MK_C04_K99"
  },
  {
    "id": 16794100,
    "chapter_id": 6194,
    "verse_number": "4.100",
    "content_sanskrit": "दुर्दर्शमतिगम्भीरमजं साम्यं विशारदम् ।\nबुद्ध्वा पदमनानात्वं नमस्कुर्मो यथाबलम् ॥ १०० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 100,
    "base_unit_id": "MK_C04_K100"
  }
]