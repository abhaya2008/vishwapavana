[{"id": 7002848000, "chapter_id": 22848, "verse_number": "९-१३३-१", "content_sanskrit": "युधिष्ठिर उवाच ।\nसंत्यज्यालिकुलालीढकुसुमानि मृदून्यपि ।\nदमनेन कथं लोकैः पूज्यंते नाकनायकाः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002848001, "chapter_id": 22848, "verse_number": "९-१३३-२", "content_sanskrit": "दोलांदोलनमाहात्म्यं रथयात्रामहोत्सवम् ।\nकथयस्वामलं प्राज्ञ यादवांभोजभास्कर ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002848002, "chapter_id": 22848, "verse_number": "९-१३३-३", "content_sanskrit": "श्रीकृष्ण उवाच ।\nपार्थार्थिजनसद्वृक्ष क्षांतिधाम धरापते ।\nयदेतद्भवता पृष्टं तच्छृणुष्व वदामि ते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002848003, "chapter_id": 22848, "verse_number": "९-१३३-४", "content_sanskrit": "पुरा सुराणामावासे मंदरे चारुकंदरे ।\nगन्धाधारी कुलालीढो जातो दमनकस्तरुः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002848004, "chapter_id": 22848, "verse_number": "९-१३३-५", "content_sanskrit": "तस्य गंधमनाघ्रेयमाघ्राय सुरयोषितः ।\nमदनोन्मादवशगा गायंति च हसंति च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002848005, "chapter_id": 22848, "verse_number": "९-१३३-६", "content_sanskrit": "ऋषयो नियमांस्त्यक्त्वा प्राद्रवंत गृहान्प्रति ।\nन वेदाध्ययने ध्याने रतिस्तेषां बभूव ह ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002848006, "chapter_id": 22848, "verse_number": "९-१३३-७", "content_sanskrit": "अपराधाद्विघटितं यद्बभूव प्रिये परम् ।\nमानसं मानिनीनां तु पुनर्गंधेन संधितम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002848007, "chapter_id": 22848, "verse_number": "९-१३३-८", "content_sanskrit": "गंधेनाकुलितं लोकं दृष्ट्वा ब्रह्मा तमब्रवीत् ।\nशमनिर्मितया वाचा रोषात्प्रस्फुरिताधरः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002848008, "chapter_id": 22848, "verse_number": "९-१३३-९", "content_sanskrit": "ब्रह्मोवाच ।\nजातस्त्वं लोकदमनान्नूनं दमनको मया ।\nजगद्वा घूर्णसे कस्मात्कर्म नैतत्तवोचितम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002848009, "chapter_id": 22848, "verse_number": "९-१३३-१०", "content_sanskrit": "यत्संतस्त्वनुमन्यंते सर्वा तिशयवर्जितम् ।\nतत्सेवेत नरः कर्म यत्रोद्वेगो न धीमताम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002848010, "chapter_id": 22848, "verse_number": "९-१३३-११", "content_sanskrit": "एकस्याप्यपकारं यः करोति स नराधमः ।\nबहूनामपकाराय सप्रवृतः किमुच्यते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002848011, "chapter_id": 22848, "verse_number": "९-१३३-१२", "content_sanskrit": "दृष्टार्थबाधकं कर्म न कर्तव्यं कथंचन ।\nअदृष्टं प्रति संदेहः सोस्माभिरनुमीयते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002848012, "chapter_id": 22848, "verse_number": "९-१३३-१३", "content_sanskrit": "ततः स्वयं प्रभजति दैवे पित्र्ये च कर्मणि ।\nभोगार्थे च त्रिभुवननिरादेयो भविष्यति ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002848013, "chapter_id": 22848, "verse_number": "९-१३३-१४", "content_sanskrit": "दमनक उवाच ।\nपुरुषादेवमारब्धं न क्रोधान्नार्थकार णात् ।\nस्वभाव एष मे ब्रह्मंस्त्वया सृष्टः पुरा विभो ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002848014, "chapter_id": 22848, "verse_number": "९-१३३-१५", "content_sanskrit": "या यस्य जंतोः प्रकृतिः शुभा वा यदि वेतरा ।\nस तस्यामेव रमते दुष्कृते सुकृते तथा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002848015, "chapter_id": 22848, "verse_number": "९-१३३-१६", "content_sanskrit": "तत्स्वभावप्रवृत्तस्य यदि शापस्त्वया मम ।\nप्रदत्तः किं करोम्येतन्न कृत्यमपराध्यति ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002848016, "chapter_id": 22848, "verse_number": "९-१३३-१७", "content_sanskrit": "युक्तियुक्तं वचः श्रुत्वा दमनेन समी रितम् ।\nप्रीतात्मा पद्मजः प्राह करोमि तव सत्प्रियम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002848017, "chapter_id": 22848, "verse_number": "९-१३३-१८", "content_sanskrit": "वसंते सहकारोत्थमंजरीपिंजरे जने ।\nपुष्पिताशोकशोभाढ्ये वने पुंस्कोकिला कुले ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002848018, "chapter_id": 22848, "verse_number": "९-१३३-१९", "content_sanskrit": "तस्मिन्काले सुरेशानां शिरांस्याक्रम्य लीलया ।\nस्थास्यसि त्वं दिनं चैकं यद्यस्य विहितं हितम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002848019, "chapter_id": 22848, "verse_number": "९-१३३-२०", "content_sanskrit": "ये त्वामारोपयिष्यंति दानमानपुरस्सराः ।\nसुराणां ते भविष्यंति सदैव सुखिनो नराः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002848020, "chapter_id": 22848, "verse_number": "९-१३३-२१", "content_sanskrit": "सर्वदैव शिवस्येष्टा पुण्या पापभयापहा ।\nप्रसिद्धिं यास्यति मधौ दमनाख्या चतुर्दशी ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002848021, "chapter_id": 22848, "verse_number": "९-१३३-२२", "content_sanskrit": "एवमुक्त्वा ययौ ब्रह्मा दमनो मंदरे गिरौ ।\nउवास वासिताशेषभुवनो गंधसम्पदा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002848022, "chapter_id": 22848, "verse_number": "९-१३३-२३", "content_sanskrit": "दिव्ये गिरौ गिरिसु तादयिताधिवासे रत्नांशुकच्छुरितकाञ्चनभूमिभागे ।\nशापं वरं च हृदये विनिवेश्य शंभोस्तत्रास्थितो दमनको दमितांतरात्मा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002848023, "chapter_id": 22848, "verse_number": "९-१३३-२४", "content_sanskrit": "श्रीकृष्ण उवाच ।\nधर्मराज निबोधेदमांदोलकमहोत्सवम् ।\nप्रवृत्तनरनारीकं पञ्चमोच्चारसुन्दरम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002848024, "chapter_id": 22848, "verse_number": "९-१३३-२५", "content_sanskrit": "सानंदं नंदनवने आर्द्रया सहितो यथा ।\nविस्मयस्मेरनयनो बभ्रामोद्वांतसौरभः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002848025, "chapter_id": 22848, "verse_number": "९-१३३-२६", "content_sanskrit": "उन्मादयन्वने पुण्ये विद्याधरगणान्बहून् ।\nवसंतर्तौ नृत्यमानान्मुरासुरशतार्चितः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002848026, "chapter_id": 22848, "verse_number": "९-१३३-२७", "content_sanskrit": "संतानपारिजातोत्थां बद्ध्वा स माधवीलताम् ।\nकश्चिदांदोलनं चक्रे समालिंग्य घनस्तनीम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002848027, "chapter_id": 22848, "verse_number": "९-१३३-२८", "content_sanskrit": "गीतमांदोलकारूढस्तद्गायंत्यमर स्त्रियः ।\nयेन चोत्पादयंति स्म मन्मथस्यापि मन्मथम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002848028, "chapter_id": 22848, "verse_number": "९-१३३-२९", "content_sanskrit": "तं दृष्ट्वाष्टापदनिभा भवानी प्राह शंकरम् ।\nकौतुकं मे समुत्पन्नं पश्येमाः शंकर प्रभो ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002848029, "chapter_id": 22848, "verse_number": "९-१३३-३०", "content_sanskrit": "आदोलकं मम कृते कारयस्व स्वलंकृतम् ।\nत्वया सहांदोलयेयं यथा चैते त्रिलोचन ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002848030, "chapter_id": 22848, "verse_number": "९-१३३-३१", "content_sanskrit": "तद्गौरीवचनं रम्यं श्रुत्वा गोवृषभध्वजः ।\nसद्दोलां कारयामास समाहूय महासुरान् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002848031, "chapter_id": 22848, "verse_number": "९-१३३-३२", "content_sanskrit": "स्तंभद्वयं रोपयित्वा इष्टापूर्तमयं दृढम् ।\nसत्यं चैवोपरिततं श्रेष्ठं काष्ठमकल्पयत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002848032, "chapter_id": 22848, "verse_number": "९-१३३-३३", "content_sanskrit": "वासुकिं दंडकस्थाने बद्ध्वा तांतवसप्रभम् ।\nतत्फणामंतरापीठं कृतवान्मणिमंडितम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002848033, "chapter_id": 22848, "verse_number": "९-१३३-३४", "content_sanskrit": "कृमिकार्पासकौशेयवस्त्रैः संवेष्टितं नवैः ।\nस्रग्दामालंबितप्रांतमणिमौक्तिकशेखरम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002848034, "chapter_id": 22848, "verse_number": "९-१३३-३५", "content_sanskrit": "रचयित्वा विचित्रां तां दोलां चैलाजिनोत्तराम् ।\nस सिद्धां सिद्धगुरवे गौरवेण न्यवेदयत् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002848035, "chapter_id": 22848, "verse_number": "९-१३३-३६", "content_sanskrit": "तत्रारूढस्तु यावत्स सौम्यसोमविभूषणः ।\nमंदरं दोलयामास पार्श्वस्थैः पार्षदैः सह ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002848036, "chapter_id": 22848, "verse_number": "९-१३३-३७", "content_sanskrit": "वामपार्श्वे तु विजया दक्षिणेन जया भवेत् ।\nचामराक्रांतबाहू ते तेनाश्लिष्टे न्यवीजताम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002848037, "chapter_id": 22848, "verse_number": "९-१३३-३८", "content_sanskrit": "आदोलयंत्या पार्वत्या सहितं स गदाक्षरम् ।\nयेन देवासुरस्त्रैणमासीदानंदनिर्भरम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002848038, "chapter_id": 22848, "verse_number": "९-१३३-३९", "content_sanskrit": "जगुर्गंधर्वपतयो ननृतुश्चाप्सरोगणाः ।\nउच्छलत्तालवाद्यानि वादयंति स्म चारणाः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002848039, "chapter_id": 22848, "verse_number": "९-१३३-४०", "content_sanskrit": "चेलुः कुलाचलाः सर्वे चुक्षुभुः सप्त सागराः ।\nववुर्वाताः सनिर्घाता देवे दोलां समास्थिते ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002848040, "chapter_id": 22848, "verse_number": "९-१३३-४१", "content_sanskrit": "आलोक्य व्याकुलं लोकं देवाः शक्रपुरोगमाः ।\nउपेत्य प्रणिपत्योचुः सर्वपापहरं परम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002848041, "chapter_id": 22848, "verse_number": "९-१३३-४२", "content_sanskrit": "उपारमस्व भगवन्भवतः क्रीडयानया ।\nजगद्व्यापद्यते देवे चलितः सागरश्च यत् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002848042, "chapter_id": 22848, "verse_number": "९-१३३-४३", "content_sanskrit": "गीर्वाणगीर्भिः संहृष्टः शंकरो लोकशंकरः ।\nसमुत्पपात दोलातः प्रहर्षोत्फुल्ललोचनः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002848043, "chapter_id": 22848, "verse_number": "९-१३३-४४", "content_sanskrit": "उवाच वचनं पार्थ सुरसार्थस्य पश्यतः ।\nसानुकंपं सुललितं विस्फुटार्थपदाक्षरम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002848044, "chapter_id": 22848, "verse_number": "९-१३३-४५", "content_sanskrit": "श्रीमहादेव उवाच ।\nअद्य प्रभृति ये दोलाक्रीडां पुष्करिणीतटे ।\nवसंते कारयिष्यंति मंडिते त्रिदशांगणे ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002848045, "chapter_id": 22848, "verse_number": "९-१३३-४६", "content_sanskrit": "नेत्रपट्टापटच्छन्नां पद्मरागविभूषि ताम् ।\nआतपत्रेण संयुक्तां विन्यस्तकनकांडकाम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002848046, "chapter_id": 22848, "verse_number": "९-१३३-४७", "content_sanskrit": "विचित्राभरणाभाभिराभासितदिगंतराम् ।\nतारकाशांतचित्रांगपुष्पमालामनोर माम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002848047, "chapter_id": 22848, "verse_number": "९-१३३-४८", "content_sanskrit": "मालां विद्याधराक्रातां प्रांतरोपितदर्पणाम् ।\nछत्रचामरसंछन्नां यथा शक्त्याप्यलंकृताम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002848048, "chapter_id": 22848, "verse_number": "९-१३३-४९", "content_sanskrit": "अग्निकार्यं ततः कृत्वा क्षिप्त्वा चैव दिशां बलिम् ।\nतस्यामारोपयेद्देवमिष्टहृष्टजनावृतः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002848049, "chapter_id": 22848, "verse_number": "९-१३३-५०", "content_sanskrit": "मूलमंत्रेण देवानां प्रोक्तं दोलाधिरोहणम् ।\nपार्श्वस्थो ब्राह्मणो विद्वान्पठेद्वा मंत्रमुत्तमम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002848050, "chapter_id": 22848, "verse_number": "९-१३३-५१", "content_sanskrit": "गंभीरांतरनिर्घोषैर्ललनानां च निस्वनैः ।\nस्तुतिमंगलशब्दैश्च पुष्पधूपाधिवासिताम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002848051, "chapter_id": 22848, "verse_number": "९-१३३-५२", "content_sanskrit": "एतस्मिन्नन्तरे नारीं दोहनाय निकुट्टकाम् ।\nप्रवेशयेत्कुंकुमाढ्यां क्रीडावर्णप्रियैः सह ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002848052, "chapter_id": 22848, "verse_number": "९-१३३-५३", "content_sanskrit": "सुवर्णशृंगिणा प्रोक्तं स्मितदंतांशुकर्बुरम् ।\nलगमानं जलं चांगे कस्य न स्यात्सुखप्रदम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002848053, "chapter_id": 22848, "verse_number": "९-१३३-५४", "content_sanskrit": "जलसंक्लिन्नवसनो रशनादाममंडितः ।\nकम्बुग्रीवोल्लसन्सर्वो बभूव गणिकागणः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002848054, "chapter_id": 22848, "verse_number": "९-१३३-५५", "content_sanskrit": "कुंकुमक्षोदतांबूलपुष्प मालाकुलो जनः ।\nतां विहाय जलक्रीडां नान्यस्यां विदधे मनः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002848055, "chapter_id": 22848, "verse_number": "९-१३३-५६", "content_sanskrit": "पीतशीतजलाघात ताडितोऽपि जनः सुखम् ।\nमन्यते नियतः कोपि प्रभावोऽयमनंगजः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002848056, "chapter_id": 22848, "verse_number": "९-१३३-५७", "content_sanskrit": "एवं ये तु गमिष्यंति नरा वर्त्मतया गतम् ।\nनीरुजस्ते भविष्यंति सुखिताः शरदां शतम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002848057, "chapter_id": 22848, "verse_number": "९-१३३-५८", "content_sanskrit": "पुत्रपौत्रसमा युक्ता धनधान्यसमायुताः ।\nविहृत्य सुखसंपत्तौ ततो यास्यंति मत्पुरम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002848058, "chapter_id": 22848, "verse_number": "९-१३३-५९", "content_sanskrit": "प्राप्ते वसंतसमये सुरसत्तमानामान्दोलनं सुरवराननुकुर्वते ये ।\nते प्राप्नुवंति भुवि जन्मतरोः फलानि दुःखार्णवात्कुलशतान्यपि तारयंति ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]