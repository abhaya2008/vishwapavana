[{"id": 2194941, "chapter_id": 5146, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2194942, "chapter_id": 5146, "verse_number": "१", "content_sanskrit": "विवस्वतो गच्छति पर्ययेण\nवोढुं भवांस्तं रथमेकचक्रम् ।\nआश्चर्यभूतं यदि तत्र किं चिद्\nदृष्टं त्वया शंसितुमर्हसि त्वम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2194943, "chapter_id": 5146, "verse_number": "", "content_sanskrit": "नागः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2194944, "chapter_id": 5146, "verse_number": "२", "content_sanskrit": "यस्य रश्मिसहस्रेषु शाखास्विव विहङ्गमाः ।\nवसन्त्याश्रित्य मुनयः संसिद्धा दैवतैः सह\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2194945, "chapter_id": 5146, "verse_number": "३", "content_sanskrit": "यतो वायुर्विनिःसृत्य सूर्यरश्म्याश्रितो महान् ।\nविजृम्भत्यम्बरे विप्र किमाश्चर्यतरं ततः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2194946, "chapter_id": 5146, "verse_number": "४", "content_sanskrit": "शुक्रो नामासितः पादो यस्य वारिधरोऽम्बरे ।\nतोयं सृजति वर्षासु किमाश्चर्यमतः परम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2194947, "chapter_id": 5146, "verse_number": "५", "content_sanskrit": "योऽष्टमासांस्तु शुचिना किरणेनोज्झितं पयः ।\nपर्यादत्ते पुनः काले किमाश्चर्यमतः परम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2194948, "chapter_id": 5146, "verse_number": "६", "content_sanskrit": "यस्य तेजोविशेषेषु नित्यमात्मा प्रतिष्ठितः ।\nयतो बीजं मही चेयं धार्यते सचराचरम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2194949, "chapter_id": 5146, "verse_number": "७", "content_sanskrit": "यत्र देवो महाबाहुः शाश्वतः परमोऽक्षरः ।\nअनादिनिधनो विप्र किमाश्चर्यमतः परम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2194950, "chapter_id": 5146, "verse_number": "८", "content_sanskrit": "आश्चर्याणामिवाश्चर्यमिदमेकं तु मे शृणु ।\nविमले यन्मया दृष्टमम्बरे सूर्यसंश्रयात्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2194951, "chapter_id": 5146, "verse_number": "९", "content_sanskrit": "पुरा मध्याह्नसमये लोकांस्तपति भास्करे ।\nप्रत्यादित्यप्रतीकाशः सर्वतः प्रत्यदृश्यत\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2194952, "chapter_id": 5146, "verse_number": "१०", "content_sanskrit": "स लोकांस्तेजसा सर्वान् स्वभासा निर्विभासयन् ।\nआदित्याभिमुखोऽभ्येति गगनं पाटयन्निव\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2194953, "chapter_id": 5146, "verse_number": "११", "content_sanskrit": "हुताहुतिरिव ज्योतिर्व्याप्य तेजोमरीचिभिः ।\nअनिर्देश्येन रूपेण द्वितीय इव भास्करः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2194954, "chapter_id": 5146, "verse_number": "१२", "content_sanskrit": "तस्याभिगमनप्राप्तौ हस्तो दत्तो विवस्वता ।\nतेनापि दक्षिणो हस्तो दत्तः प्रत्यर्चनार्थिना\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2194955, "chapter_id": 5146, "verse_number": "१३", "content_sanskrit": "ततो भित्त्वैव गगनं प्रविष्टो रविमण्डलम् ।\nएकीभूतं च तत्तेजः क्षणेनादित्यतां गतम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2194956, "chapter_id": 5146, "verse_number": "१४", "content_sanskrit": "तत्र नः संशयो जातस्तयोस्तेजःसमागमे ।\nअनयोः को भवेत् सूर्यो रथस्थो योऽयमागतः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2194957, "chapter_id": 5146, "verse_number": "१५", "content_sanskrit": "ते वयं जातसंदेहाः पर्यपृच्छामहे रविम् ।\nक एष दिवमाक्रम्य गतः सूर्य इवापरः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2194958, "chapter_id": 5146, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे पञ्चनत्युत्तरशततमोऽध्यायः ॥१९५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]