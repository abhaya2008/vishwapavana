[{"id": 2114037, "chapter_id": 3454, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2114038, "chapter_id": 3454, "verse_number": "१", "content_sanskrit": "कृतास्त्रान् धार्तराष्ट्रांश्च पाण्डुपुत्रांश्च भारत ।\nदृष्ट्वा द्रोणोऽब्रवीद् वाक्यं धृतराष्ट्रं जनेश्वरम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2114039, "chapter_id": 3454, "verse_number": "२", "content_sanskrit": "कृपस्य सोमदत्तस्य बाह्लीकस्य च धीमतः ।\nगाङ्गेयस्य च सान्निध्ये व्यासस्य विदुरस्य च \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2114040, "chapter_id": 3454, "verse_number": "३", "content_sanskrit": "राजन् सम्प्राप्तविद्यास्ते कुमाराः कुरुसत्तम ।\nते दर्शयेयुः स्वां शिक्षां राजन्ननुमते तव\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2114041, "chapter_id": 3454, "verse_number": "४", "content_sanskrit": "ततोऽब्रवीन्महाराजः प्रहष्टेनान्तरात्मना ।\nभारद्वाज महत्कर्म कृतं द्विजवर त्वया\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2114042, "chapter_id": 3454, "verse_number": "५", "content_sanskrit": "यदाऽनुमन्यसे कालं यस्मिन् देशे यथायथा ।\nतथा तथा विधानाय स्वयमाज्ञापयस्व माम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2114043, "chapter_id": 3454, "verse_number": "६", "content_sanskrit": "स्पृहयाम्यद्य निर्वेशं पुरुषाणां सचक्षुषाम् ।\nअस्त्रहेतोः समायुक्तान् ये मे द्रक्ष्यन्ति पुत्रकान् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2114044, "chapter_id": 3454, "verse_number": "७", "content_sanskrit": "सत्कार्यः क्षत्त आचार्यो ब्रवीति कुरु तत् तथा ।\nन हीदृशं प्रियं मेऽद्य भविता धर्मवत्सल\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2114045, "chapter_id": 3454, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2114046, "chapter_id": 3454, "verse_number": "८", "content_sanskrit": "ततो राजानमामन्त्र्य विदुरानुगतो बहिः ।\nभारद्वाजो महाप्रज्ञो ज्ञापयामास मेदिनीम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2114047, "chapter_id": 3454, "verse_number": "९", "content_sanskrit": "समामवृक्षं निर्गुल्मामुदक्प्रवणसंस्थिताम् ।\nतस्या भूमौ बलिं चक्रे तिथिनक्षत्रपूजिते\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2114048, "chapter_id": 3454, "verse_number": "१०", "content_sanskrit": "अवघुष्टं पुरे चापि तदर्थं भरतर्षभ ।\nरङ्गभूमिं सुविहितां शास्त्रदृष्टामकारयत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2114049, "chapter_id": 3454, "verse_number": "११", "content_sanskrit": "प्रेक्षागारं सुविहितं चक्रुस्तत्र च शिल्पिनः ।\nराज्ञां सर्वायुधोपेतं स्त्रीणां चैव नरर्षभ\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2114050, "chapter_id": 3454, "verse_number": "१२", "content_sanskrit": "मञ्चान् स्म कारयामासुर्यत्र जानपदा जनाः ।\nसचिवाश्च पुनर्मञ्चान् कारयामासुरुच्छ्रितान् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2114051, "chapter_id": 3454, "verse_number": "१३", "content_sanskrit": "तस्मिंस्तदाऽहनि प्राप्ते राजा ससचिवस्तदा ।\nसान्तःपुरः सहामात्यो व्यासस्यानुमते तदा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2114052, "chapter_id": 3454, "verse_number": "१४", "content_sanskrit": "भीष्मं प्रमुखतः कृत्वा कृपं चाचार्यसत्तमम् ।\nबाह्लीकं सोमदत्तं च भूरिश्रवसमेव च \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2114053, "chapter_id": 3454, "verse_number": "१५", "content_sanskrit": "कुरूनन्यांश्च सचिवानादाय नगराद् बहिः ।\nरङ्गभूमिं समासाद्य ब्राह्मणैः सहितो नृपः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2114054, "chapter_id": 3454, "verse_number": "१६", "content_sanskrit": "मुक्ताजालपरिक्षिप्तं वैदूर्यमणिभूषितम् ।\nशातकुम्भमयं दिव्यं प्रेक्षागारमुपारुहत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2114055, "chapter_id": 3454, "verse_number": "१७", "content_sanskrit": "गान्धारी च महाभागा कुन्ती च जयतां वर ।\nस्त्रियश्च सर्वा या राज्ञस्तासां च परिचारकाः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2114056, "chapter_id": 3454, "verse_number": "१८", "content_sanskrit": "हर्षादारुरुहुः कान्तं मेरुं देवस्त्रियो यथा ।\nब्राह्मणक्षत्रविट्च्छूद्रं सर्वं तत्र समागतम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2114057, "chapter_id": 3454, "verse_number": "१९", "content_sanskrit": "प्रवादकैश्च वादित्रैर्जनैः कोलाहलैरपि ।\nमहार्णव इव क्षुब्धः समाजः सोऽभवत् तदा\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2114058, "chapter_id": 3454, "verse_number": "२०", "content_sanskrit": "ततः शुक्लाम्बरधरः शुक्लयज्ञोपवीतवान् ।\nशुक्लकेशः सितश्मश्रुः शुक्लमाल्यानुलेपनः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2114059, "chapter_id": 3454, "verse_number": "२१", "content_sanskrit": "रङ्गमध्यं तदा द्रोणः सपुत्रः संविवेश ह ।\nनभो जलधरैर्वीतं साङ्गारक इवांशुमान् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2114060, "chapter_id": 3454, "verse_number": "२२", "content_sanskrit": "व्यासस्यानुमते चक्रे बलिं बलवतां वरः ।\nब्राह्मणांश्चापि शास्त्रज्ञान् वाचयामास मङ्गलैः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2114061, "chapter_id": 3454, "verse_number": "२३", "content_sanskrit": "सुवर्णमणिरत्नानि वस्त्राणि विविधानि च ।\nप्रददौ दक्षिणां राजा द्रोणाय च कृपाय च\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2114062, "chapter_id": 3454, "verse_number": "२४", "content_sanskrit": "अथ पुण्याहघोषस्य महतः समनन्तरम् ।\nविविशुर्विविधं गृह्य शस्त्रोपकरणं नृपाः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2114063, "chapter_id": 3454, "verse_number": "२५", "content_sanskrit": "ततो बद्धाङ्गुलित्राणा बद्धकक्ष्या महाबलाः ।\nबद्धतूणाः सधनुषो विविशुर्भरतर्षभाः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2114064, "chapter_id": 3454, "verse_number": "२६", "content_sanskrit": "अनुज्येष्ठं च ते तत्र युधिष्ठिरपुरोगमाः ।\nरङ्गमध्ये स्थितं द्रोणमभिवाद्य नरर्षभाः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2114065, "chapter_id": 3454, "verse_number": "२७", "content_sanskrit": "पूजां चक्रुर्यथान्यायं द्रोणस्य च कृपस्य च ।\nआशीर्भिश्च प्रयुक्ताभिः सर्वे संहृष्टमानसाः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2114066, "chapter_id": 3454, "verse_number": "२८", "content_sanskrit": "अभिवाद्य पुनः शस्त्रान् बलिपुष्पैः समन्वितान् ।\nरक्तचन्दनसम्मिश्रैः स्वयमर्चन्त कौरवाः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2114067, "chapter_id": 3454, "verse_number": "२९", "content_sanskrit": "सर्वे रक्ताम्बरधराः सर्वे वस्त्रविभूषणाः ।\nरक्तचन्दनदिग्धाश्च रक्तमाल्यानुरागिणः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2114068, "chapter_id": 3454, "verse_number": "३०", "content_sanskrit": "सर्वे रक्तपताकाश्च सर्वे रक्तान्तलोचनाः ।\nद्रोणेन समनुज्ञाता गृह्य शस्त्रं परन्तपाः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2114069, "chapter_id": 3454, "verse_number": "३१", "content_sanskrit": "धनूंषि पूर्वं सङ्गृह्य तप्तकाञ्चनभूषिताः ।\nसज्यानि विविधाकारैः शरैः सन्धाय कौरवाः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2114070, "chapter_id": 3454, "verse_number": "३२", "content_sanskrit": "ज्याघोषं तळघोषं च कृत्वा भूतान्यपूजयन् ।\nचक्रुरस्त्रं महावीर्याः कुमाराः परमाद्भुतम् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2114071, "chapter_id": 3454, "verse_number": "३३", "content_sanskrit": "केषाञ्चित् तरुमूलेषु शरा निपतिता नृप ।\nकेषाञ्चित् पुष्पमकुटे निपतन्ति स्म सायकाः \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2114072, "chapter_id": 3454, "verse_number": "३४", "content_sanskrit": "केचिल्लक्षितलक्ष्याणि बाणैराहितलक्षणैः ।\nविविधुर्लाघवोत्सृष्टैर्गुरूणि च लघूनि च \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2114073, "chapter_id": 3454, "verse_number": "३५", "content_sanskrit": "केचिच्छराक्षेपभयाच्छिरांस्यवननामिरे ।\nमनुजा हृष्टमनसो वीक्षाञ्चक्रुः सविस्मयाः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2114074, "chapter_id": 3454, "verse_number": "३६", "content_sanskrit": "ते स्म लक्ष्याणि बिभिदुर्बाणैर्नामाक्षराङ्कितैः ।\nविविधैर्लाघवोत्सृष्टैरुह्यन्तो वाजिभिर्द्रुतम् \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2114075, "chapter_id": 3454, "verse_number": "३७", "content_sanskrit": "तत्कुमारबलं तत्र गृहीतशरकार्मुकम् ।\nगन्धर्वनगराकारं प्रेक्षन्तो विस्मिता भवन् \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2114076, "chapter_id": 3454, "verse_number": "३८", "content_sanskrit": "सहसा चुक्रुशुस्तत्र शतशोऽथ सहस्रशः ।\nविस्मयोत्फुल्लनयनाः चाब्रुवन् साधुसाध्विति\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2114077, "chapter_id": 3454, "verse_number": "३९", "content_sanskrit": "कृत्वा धनुषि ते मार्गान् रथचर्यासु चासकृत् ।\nगजपृष्ठेऽश्वपृष्ठे च नियुद्धे च महाबलाः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2114078, "chapter_id": 3454, "verse_number": "४०", "content_sanskrit": "गृहीतखड्गचर्माणस्ततो भूयः प्रहारिणः ।\nशस्त्रमार्गान् यथोद्दिष्टांश्चेरुः सर्वासु भूमिषु\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2114079, "chapter_id": 3454, "verse_number": "४१", "content_sanskrit": "लाघवं सौष्ठवं शौर्यं स्थिरत्वं दृढमुष्टिताम् ।\nददृशुस्तत्र सर्वेषां प्रयोगान् खड्गचर्मणाम् \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2114080, "chapter_id": 3454, "verse_number": "४२", "content_sanskrit": "अथ तौ नित्यसंरुद्धौ सुयोधनवृकोदरौ ।\nअवतीर्णौ गदाहस्तौ सद्विशृङ्गाविवाचलौ\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2114081, "chapter_id": 3454, "verse_number": "४३", "content_sanskrit": "क्रूरप्रेक्षौ महाबाहू पौरुषे पर्यवस्थितौ ।\nबृहन्तौ वाशिताहेतोः समदाविव कुञ्जरौ\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2114082, "chapter_id": 3454, "verse_number": "४४", "content_sanskrit": "तौ प्रदक्षिणसव्यानि मण्डलानि महाबलौ ।\nचेरतुर्निर्मलगदौ समदौ वृषभाविव \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2114083, "chapter_id": 3454, "verse_number": "४५", "content_sanskrit": "धृतराष्ट्राय विदुरो गान्धार्यै च महामतिः ।\nन्यवेदयत तत् सर्वं कुमाराणां च चेष्टितम् \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2114084, "chapter_id": 3454, "verse_number": "१३३", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nत्रयस्त्रिंशदधिकशततमोऽध्यायः ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2114085, "chapter_id": 3454, "verse_number": "८१", "content_sanskrit": "॥ इति सम्भवपर्वणि एकाशीतितमोऽध्यायः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2114086, "chapter_id": 3454, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]