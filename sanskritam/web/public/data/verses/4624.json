[{"id": 2169341, "chapter_id": 4624, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2169342, "chapter_id": 4624, "verse_number": "१", "content_sanskrit": "ततः परानीकमिदं व्यूढमप्रतिमं सह ।\nसमीक्ष्य कर्णः पार्थानां धृष्टद्युम्नाभिरक्षितम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2169343, "chapter_id": 4624, "verse_number": "२", "content_sanskrit": "प्रययौ रथघोषेण सिंहनादरवेण च ।\nवादित्राणां च निनदैः कम्पयन्निव मेदिनीम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2169344, "chapter_id": 4624, "verse_number": "३", "content_sanskrit": "वेपमान इव क्रोधाद् युद्धशौण्डः परन्तपः ।\nप्रतिव्यूह्य महातेजा यथावद् भरतर्षभ\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2169345, "chapter_id": 4624, "verse_number": "४", "content_sanskrit": "व्यधमत् पाण्डवीं सेनामासुरीं मघवानिव ।\nयुधिष्ठिरं चाभिभवन्नपसव्यं चकार ह\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2169346, "chapter_id": 4624, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2169347, "chapter_id": 4624, "verse_number": "५", "content_sanskrit": "कथं सञ्जय राधेयः प्रत्यव्यूहत पाण्डवान् ।\nधृष्टद्युम्नमुखान् वीरान् भीमसेनाभिरक्षितान्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2169348, "chapter_id": 4624, "verse_number": "६", "content_sanskrit": "सर्वानेव महेष्वासानजय्यानमरैरपि\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2169349, "chapter_id": 4624, "verse_number": "७", "content_sanskrit": "के च प्रपक्षौ पक्षौ वा मम सैन्यस्य सञ्जय ।\nप्रविभज्य यथान्यायं कथं वा समवस्थिताः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2169350, "chapter_id": 4624, "verse_number": "८", "content_sanskrit": "कथं पाण्डुसुताश्चापि प्रत्यव्यूहन्त मामकान् ।\nकथं चैतन्महायुद्धं प्रावर्तत सुदारुणम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2169351, "chapter_id": 4624, "verse_number": "९", "content_sanskrit": "क्व च बीभत्सुरभवद् यत्कर्णोऽयाद् युधिष्ठिरम् ।\nको ह्यर्जुनस्य सान्निध्ये शक्तोऽभ्येतुं युधिष्ठिरम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2169352, "chapter_id": 4624, "verse_number": "१०", "content_sanskrit": "सर्वभूतानि यो ह्येकः खाण्डवे जितवान् पुरा ।\nकस्तमन्यत्र राधेयात् प्रतियुद्ध्येज्जिजीविषुः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2169353, "chapter_id": 4624, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2169354, "chapter_id": 4624, "verse_number": "११", "content_sanskrit": "शृणु व्यूहस्य रचनामर्जुनश्च यथा गतः ।\nपरिवार्य नृपं स्वं स्वं सङ्ग्रामश्चाभवद् यथा\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2169355, "chapter_id": 4624, "verse_number": "१२", "content_sanskrit": "कृपः शारद्वतो राजन् मागधाश्च तरस्विनः ।\nसात्वतः कृतवर्मा च दक्षिणं पक्षमाश्रिताः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2169356, "chapter_id": 4624, "verse_number": "१३", "content_sanskrit": "तेषां प्रपक्षे शकुनिरुलूकश्च महारथः ।\nसादिभिर्विमलप्रासैस्तवानीकमरक्षताम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2169357, "chapter_id": 4624, "verse_number": "१४", "content_sanskrit": "गान्धारिभिरसम्भ्रान्तैः पार्वतीयैश्च दुर्जयैः ।\nशलभानामिव व्रातैः पिशाचैरिव दुर्दृशैः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2169358, "chapter_id": 4624, "verse_number": "१५", "content_sanskrit": "चतुर्विंशत्सहस्राणि रथानामनिवर्तिनाम् ।\nसंशप्तका युद्धशौण्डा वामं पार्श्वमपालयन्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2169359, "chapter_id": 4624, "verse_number": "१६", "content_sanskrit": "समुच्चितास्तव सुतैः कृष्णार्जुनजिघांसवः ।\nतेषां प्रपक्षः काम्बोजाः शकाश्च यवनैः सह\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2169360, "chapter_id": 4624, "verse_number": "१७", "content_sanskrit": "निदेशात् सूतपुत्रस्य सरथाः साश्वपत्तयः ।\nआह्वयन्तोऽर्जुनं तस्थुः केशवं च महाबलम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2169361, "chapter_id": 4624, "verse_number": "१८", "content_sanskrit": "मध्येसेनामुखं कर्णो व्यवातिष्ठत दंसितः ।\nचित्रवर्माङ्गदस्रग्वी पालयन् वाहिनीमुखम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2169362, "chapter_id": 4624, "verse_number": "१९", "content_sanskrit": "रक्ष्यमाणः सुसंरब्धैः पुत्रैः शस्त्रभृतां वरः ।\nवाहिनीप्रमुखं वीरः सम्प्रकर्षन्नशोभत\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2169363, "chapter_id": 4624, "verse_number": "२०", "content_sanskrit": "अयोरत्निर्महासत्वो वैश्वानरसमद्युतिः ।\nमहाद्विपस्कन्धगतः पिङ्गाक्षः प्रियदर्शनः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2169364, "chapter_id": 4624, "verse_number": "२१", "content_sanskrit": "दुःशासनो वृतः सैन्यैः स्थितो व्यूहस्य पृष्ठतः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2169365, "chapter_id": 4624, "verse_number": "२२", "content_sanskrit": "तमन्वयान्महाराज स्वयं दुर्योधनो नृपः ।\nचित्राश्वैश्चित्रसन्नाहैः सोदर्यैरभिरक्षितः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2169366, "chapter_id": 4624, "verse_number": "२३", "content_sanskrit": "रक्ष्यमाणो महावीर्यैः सहितैर्मद्रकेकयैः ।\nअशोभत महाराज देवैरिव शतक्रतुः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2169367, "chapter_id": 4624, "verse_number": "२४", "content_sanskrit": "अश्वत्थामा कुरूणां च ये प्रवीरा महारथाः ।\nनित्यमत्ताश्च मातङ्गाः शूरैर्म्लेच्छैरधिष्ठिताः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2169368, "chapter_id": 4624, "verse_number": "२५", "content_sanskrit": "अन्वयुस्तद् रथानीकं क्षरन्त इव तोयदाः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2169369, "chapter_id": 4624, "verse_number": "२६", "content_sanskrit": "ते ध्वजैर्वैजयन्तीभिर्ज्वलद्भिः परमायुधैः ।\nसादिभिश्चास्थिता रेजुर्द्रुमवन्त इवाचलाः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2169370, "chapter_id": 4624, "verse_number": "२७", "content_sanskrit": "तेषां पदातिनागानां पादरक्षाः सहस्रशः ।\nपट्टिशासिधराः शूरा बभूवुरनिवर्तिनः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2169371, "chapter_id": 4624, "verse_number": "२८", "content_sanskrit": "सादिभिः स्यन्दनैर्नागैरधिकं समलङ्कृतैः ।\nस व्यूहराजो विबभौ देवासुरचमूपमः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2169372, "chapter_id": 4624, "verse_number": "२९", "content_sanskrit": "बार्हस्पत्यः सुविहितो नायकेन विपश्चिता ।\nनृत्यतीव महाव्यूहः परेषामादधद्भयम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2169373, "chapter_id": 4624, "verse_number": "३०", "content_sanskrit": "तस्य पक्षप्रपक्षेभ्यो निष्पतन्ति युयुत्सवः ।\nपत्त्यश्वरथमातङ्गाः प्रावृषीव बलाहकाः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2169374, "chapter_id": 4624, "verse_number": "३१", "content_sanskrit": "ततः सेनामुखे कर्णं दृष्ट्वा राजा युधिष्ठिरः ।\nधनञ्जयममित्रघ्नमेकवीरमुवाच ह\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2169375, "chapter_id": 4624, "verse_number": "३२", "content_sanskrit": "पश्यार्जुन महाव्यूहं कर्णेन विहितं रणे ।\nयुक्तं पक्षैः प्रपक्षैश्च परानीकं प्रकाशते\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2169376, "chapter_id": 4624, "verse_number": "३३", "content_sanskrit": "तदेतद्वै समालोक्य प्रत्यनीकं महाबलम् ।\nयथा नाभिभवत्यस्मांस्तथा नीतिर्विधीयताम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2169377, "chapter_id": 4624, "verse_number": "३४", "content_sanskrit": "एवमुक्तोऽर्जुनो राज्ञा प्राञ्जलिर्नृपमब्रवीत् ।\nयथा भवानाह तथा तत्सर्वं न तदन्यथा\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2169378, "chapter_id": 4624, "verse_number": "३५", "content_sanskrit": "यस्त्वस्य विहितो घातस्तं करिष्यामि भारत ।\nप्रधानवध एवास्य विनाशस्तं करोम्यहम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2169379, "chapter_id": 4624, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2169380, "chapter_id": 4624, "verse_number": "३६", "content_sanskrit": "तस्मात्त्वमेव राधेयं भीमसेनः सुयोधनम् ।\nवृषसेनं च नकुलः सहदेवोऽपि सौबलम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2169381, "chapter_id": 4624, "verse_number": "३७", "content_sanskrit": "दुःशासनं शतानीको हार्दिक्यं शिनिपुङ्गवः ।\nधृष्टद्युम्नस्तथा द्रौणिं स्वयं यास्याम्यहं कृपम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2169382, "chapter_id": 4624, "verse_number": "३८", "content_sanskrit": "द्रौपदेया धार्तराष्ट्रान् शिष्टान् सह शिखण्डिना ।\nते ते च तास्तानहितानस्माकं घ्नन्तु सोमकाः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2169383, "chapter_id": 4624, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2169384, "chapter_id": 4624, "verse_number": "३९", "content_sanskrit": "इत्युक्तो धर्मराजेन तथेत्युक्त्वा धनञ्जयः ।\nव्यादिदेश स्वसैन्यानि स्वयं चागाच्चमूमुखम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2169385, "chapter_id": 4624, "verse_number": "४०", "content_sanskrit": "अग्निर्वैश्वानरः पूर्वं ब्रह्मेन्दुः सप्तितां गतः ।\nतस्माद्यः प्रथमो जातस्तं देवा ब्राह्मणा विदुः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2169386, "chapter_id": 4624, "verse_number": "४१", "content_sanskrit": "अथ तं रथमायान्तं दृष्ट्वात्यद्भुतदर्शनम् ।\nउवाचाधिरथिं शल्यः पुनस्तं युद्धदुर्मदम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2169387, "chapter_id": 4624, "verse_number": "४२", "content_sanskrit": "अयं स रथ आयाति श्वेताश्वः कृष्णसारथिः ।\nनिघ्नन्नमित्रान् कौन्तेयो यं कर्ण परिपृच्छसि\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2169388, "chapter_id": 4624, "verse_number": "४३", "content_sanskrit": "श्रूयते तुमुलः शब्दो रथनेमिस्वनो महान् ।\nध्रुवमेतौ महात्मानौ वासुदेवधनञ्जयौ\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2169389, "chapter_id": 4624, "verse_number": "४४", "content_sanskrit": "एष रेणुः समुद्भूतो दिवमावृत्य तिष्ठति\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2169390, "chapter_id": 4624, "verse_number": "४५", "content_sanskrit": "चक्रनेमिप्रणुन्ना च कम्पते कर्ण मेदिनी ।\nप्रवात्येष महावायुरभितस्तव वाहिनीम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2169391, "chapter_id": 4624, "verse_number": "४६", "content_sanskrit": "क्रव्यादा व्याहरन्त्येते वेदयन्तो महद् भयम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2169392, "chapter_id": 4624, "verse_number": "४७", "content_sanskrit": "पश्य कर्ण महाघोरं भयदं लोमहर्षणम् ।\nकबन्धं मेघसङ्काशं भानुमावृत्य तिष्ठति\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2169393, "chapter_id": 4624, "verse_number": "४८", "content_sanskrit": "पश्य यूथैर्बहुविधैर्मृगाणां सर्वतोदिशम् ।\nबलिभिर्दृप्तशार्दूलैरादित्योऽभिनिरीक्ष्यते\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2169394, "chapter_id": 4624, "verse_number": "४९", "content_sanskrit": "पश्य कङ्काश्च गृध्रांश्च समवेतान् सहस्रशः ।\nस्थितानभिमुखान् घोरानन्योन्यमभिभाषतः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2169395, "chapter_id": 4624, "verse_number": "५०", "content_sanskrit": "रञ्जिताश्चामरायुक्तास्तव कर्ण महारथे ।\nप्रवराः प्रस्खलन्त्येते ध्वजश्चैव प्रकम्पते\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2169396, "chapter_id": 4624, "verse_number": "५१", "content_sanskrit": "सवेपथून् हयान् पश्य महाकायान् महाजवान् ।\nप्लवमानान् दर्शनीयानाकाशे गरुडानिव\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2169397, "chapter_id": 4624, "verse_number": "५२", "content_sanskrit": "ध्रुवमेषु निमित्तेषु भूमिमावृत्य पार्थिवाः ।\nस्वप्स्यन्ति निहताः कर्ण शतशोऽथ सहस्रशः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2169398, "chapter_id": 4624, "verse_number": "५३", "content_sanskrit": "शङ्खानां तुमुलः शब्दः श्रूयते लोमहर्षणः ।\nआनकानां च राधेय मृदङ्गानां च सर्वशः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2169399, "chapter_id": 4624, "verse_number": "५४", "content_sanskrit": "बाणशब्दान् बहुविधान् नराश्वरथनिस्वनान् ।\nज्यातळत्रेषुशब्दांश्च शृणु कर्म महात्मनाम्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2169400, "chapter_id": 4624, "verse_number": "५५", "content_sanskrit": "हेमरूप्यप्रमृष्टानां वाससः शिल्पिनिर्मिताः ।\nनानावर्णा रथे भान्ति श्वसनेन प्रकम्पिताः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2169401, "chapter_id": 4624, "verse_number": "५६", "content_sanskrit": "सहेमचन्द्रतारार्काः पताकाः किङ्किणीयुताः ।\nपश्य कर्णार्जुनस्यैताः सौदामिन्य इवाम्बरे ।\nविभ्राजन्ति रणे कर्ण विमाने देवता यथा\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2169402, "chapter_id": 4624, "verse_number": "५७", "content_sanskrit": "ध्वजाः कणकणायन्ते वातेनाभिसमीरिताः ।\nसपताका रथाश्चापि पाञ्चालानां महात्मनाम्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2169403, "chapter_id": 4624, "verse_number": "५८", "content_sanskrit": "एष ध्वजाग्रे पार्थस्य प्रेक्षमाणः समन्ततः ।\nदृश्यते वानरो भीमो द्विषतामघवर्धनः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2169404, "chapter_id": 4624, "verse_number": "५९", "content_sanskrit": "एतच्चक्रं गदा शार्ङ्गं शङ्खः कृष्णस्य धीमतः ।\nअत्यर्थं भ्राजते कृष्णे कौस्तुभस्तु मणिस्ततः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2169405, "chapter_id": 4624, "verse_number": "६०", "content_sanskrit": "एष शार्ङ्गगदापाणिर्वासुदेवोऽतिवीर्यवान् ।\nवाहयन्नेति तुरगान् पाण्डुरान् वातरंहसः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2169406, "chapter_id": 4624, "verse_number": "६१", "content_sanskrit": "एतत् कूजति गाण्डीवं विकृष्टं सव्यसाचिना ।\nएते हस्तवता मुक्ता घ्नन्त्यमित्रान् शिताः शराः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2169407, "chapter_id": 4624, "verse_number": "६२", "content_sanskrit": "विशालायतताम्राक्षैः पूर्णचन्द्रनिभाननैः ।\nएषा भूः कीर्यते राज्ञां शिरोभिरपलायिनाम्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2169408, "chapter_id": 4624, "verse_number": "६३", "content_sanskrit": "एते सुपरिघाकाराः पुण्यगन्धानुलेपनाः ।\nउद्यतायुधशौण्डानां पात्यन्ते सायुधा भुजाः\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2169409, "chapter_id": 4624, "verse_number": "६४", "content_sanskrit": "निरस्तनेत्रजिह्वान्त्रा वाजिनः सह सादिभिः ।\nपतिताः पात्यमानाश्च क्षितौ क्षीणाश्च शेरते\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2169410, "chapter_id": 4624, "verse_number": "६५", "content_sanskrit": "एते पर्वतशृङ्गाणां तुल्यरूपा हता द्विपाः ।\nसञ्छिन्नभिन्नाः पार्थेन प्रपतन्त्यद्रयो यथा\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2169411, "chapter_id": 4624, "verse_number": "६६", "content_sanskrit": "गन्धर्वनगराकारा रथा हतनरेश्वराः ।\nविमानानीव पुण्यानि स्वर्गिणां निपतन्त्यमी\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2169412, "chapter_id": 4624, "verse_number": "६७", "content_sanskrit": "व्याकुलीकृतमत्यर्थं पश्य सैन्यं किरीटिना ।\nनानामृगसहस्राणां यूथं केसरिणा यथा\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2169413, "chapter_id": 4624, "verse_number": "६८", "content_sanskrit": "घ्नन्त्येते पार्थिवान् वीराः पाण्डवाः समभिद्रुतान्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2169414, "chapter_id": 4624, "verse_number": "६९", "content_sanskrit": "पश्य कुन्तीसुतं वीरं बीभत्सुमपराजितम् ।\nप्रधर्षयितुमायान्तं कपिप्रवरकेतनम्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2169415, "chapter_id": 4624, "verse_number": "७०", "content_sanskrit": "नागाश्वरथपत्त्यौघान् तावकान् समभिघ्नतः ।\nध्वजाग्रं दृश्यते त्वस्य ज्याशब्दश्चापि श्रूयते\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2169416, "chapter_id": 4624, "verse_number": "७१", "content_sanskrit": "अद्य द्रष्टासि तं वीरं श्वेताश्वं कृष्णसारथिम् ।\nनिघ्नन्तं शात्रवान् सङ्खे यं कर्ण परिपृच्छसि\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2169417, "chapter_id": 4624, "verse_number": "७२", "content_sanskrit": "अद्य तौ पुरुषव्याघ्रौ लोहिताक्षौ परन्तपौ ।\nवासुदेवार्जुनौ कर्ण द्रष्टास्येकरथस्थितौ\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2169418, "chapter_id": 4624, "verse_number": "७३", "content_sanskrit": "सारथिर्यस्य वार्ष्णेयो गाण्डीवं यस्य कार्मुकम् ।\nतं चेद्धन्तासि राधेय त्वं नो राजा भविष्यसि\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2169419, "chapter_id": 4624, "verse_number": "७४", "content_sanskrit": "एष संशप्तकाहूतस्तानेवाभिमुखो गतः ।\nकरोति कदनं चैषा सङ्ग्रामे द्विषतां बली\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2169420, "chapter_id": 4624, "verse_number": "समाप्तिः", "content_sanskrit": "इति ब्रुवाणं मद्रेशं कर्णः प्राहातिमन्युमान्\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2169421, "chapter_id": 4624, "verse_number": "७६", "content_sanskrit": "पश्य संशप्तकैः क्रुद्धैः सर्वतः समभिद्रुतः ।\nएष सूर्य इवाम्भोदैश्छन्नः पार्थो न दृश्यते\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2169422, "chapter_id": 4624, "verse_number": "७७", "content_sanskrit": "एतदन्तोऽर्जुनः शल्य निमग्नः शोकसागरम्\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2169423, "chapter_id": 4624, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2169424, "chapter_id": 4624, "verse_number": "७८", "content_sanskrit": "वरुणं कोऽम्भसा हन्यादिन्धनेन च पावकम् ।\nको वानिलं निगृह्णीयात् पिबेद्वा को महार्णवम्\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2169425, "chapter_id": 4624, "verse_number": "७९", "content_sanskrit": "ईदृग्रूपमहं मन्ये पार्थस्य युधि निग्रहम् ।\nन हि शक्योऽर्जुनो जेतुं सेन्द्रैः सर्वैः सुरासुरैः\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2169426, "chapter_id": 4624, "verse_number": "८०", "content_sanskrit": "अथैवं परितोषस्ते वाचोक्त्वा सुमना भव ।\nन स शक्यो युधा जेतुमन्यं कुरु मनोरथम्\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2169427, "chapter_id": 4624, "verse_number": "८१", "content_sanskrit": "बाहुभ्यामुद्धरेद्भूमिं दहेत्क्रुद्ध इमाः प्रजाः ।\nपातयेत् त्रिदिवाद् देवान् योऽर्जुनं समरे जयेत्\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2169428, "chapter_id": 4624, "verse_number": "८२", "content_sanskrit": "पश्य कुन्तीसुतं वीरं भीममक्लिष्टकारिणम् ।\nप्रभासन्तं महाबाहुमेनं मेरुमिवाचलम्\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2169429, "chapter_id": 4624, "verse_number": "८३", "content_sanskrit": "अमर्षी नित्यसंरब्धश्चिरं वैरमनुस्मरन् ।\nएष भीमो जयप्रेप्सुर्युधि तिष्ठति वीर्यवान्\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2169430, "chapter_id": 4624, "verse_number": "८४", "content_sanskrit": "एष धर्मभृतां श्रेष्ठो धर्मराजो युधिष्ठिरः ।\nतिष्ठत्यसुकरः सङ्खे परैः परपुरञ्जयः\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2169431, "chapter_id": 4624, "verse_number": "८५", "content_sanskrit": "एतौ च पुरुषव्याघ्रावश्विनाविव सोदरौ ।\nनकुलः सहदेवश्च तिष्ठतो युधि दुर्जयौ\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2169432, "chapter_id": 4624, "verse_number": "८६", "content_sanskrit": "दृश्यन्त एते कार्ष्णेयाः पञ्च पञ्चाचला इव ।\nव्यवस्थिता योत्स्यमानाः सर्वेर्ऽजुनसमा युधि\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2169433, "chapter_id": 4624, "verse_number": "८७", "content_sanskrit": "एते द्रुपदपुत्राश्च धृष्टद्युम्नपुरोगमाः ।\nदीप्ताः सत्यजिता वीरास्तिष्ठन्ति परमौजसः\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2169434, "chapter_id": 4624, "verse_number": "८८", "content_sanskrit": "असाविन्द्र इवासह्यः सात्यकिः सात्वतां वरः ।\nयुयुत्सुरुपयात्यस्मान् कालान्तकयमोपमः\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2169435, "chapter_id": 4624, "verse_number": "समाप्तिः", "content_sanskrit": "इति संवदतोरेव तयोः पुरुषसिंहयोः ।\nते सेने समसज्जेतां गङ्गायमुनवद् भृशम्\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2169436, "chapter_id": 4624, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nशल्यसंवादो नाम चतुश्चत्वारिंशोऽध्यायः ॥४४॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}]