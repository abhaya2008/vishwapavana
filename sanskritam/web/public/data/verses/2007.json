[{"id": 2045231, "chapter_id": 2007, "verse_number": "६-५६-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2045232, "chapter_id": 2007, "verse_number": "६-५६-१", "content_sanskrit": "प्रभातायां च शर्वर्यां भीष्मः शान्तनस्तदा।\nअनीकान्यनुसंयाने व्यादिदेशाय भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2045233, "chapter_id": 2007, "verse_number": "६-५६-२", "content_sanskrit": "गारुडं च महाव्यूहं चक्रे शान्तनवस्तदा।\nपुत्राणां ते जयाकाङ्क्षी भीष्मः कुरुपितामहः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2045234, "chapter_id": 2007, "verse_number": "६-५६-३", "content_sanskrit": "गरुडस्य स्वयं तुण्डे पिता देवव्रतस्तव।\nचक्षुषी च भरज्वाजः कृतवर्मा च सात्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2045235, "chapter_id": 2007, "verse_number": "६-५६-४", "content_sanskrit": "अश्वत्थामा कृपश्चैव शिर आस्तां यशस्विनौ ।\nत्रैगर्त्तैरथ कैकेयैर्वाटधानैश्च संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2045236, "chapter_id": 2007, "verse_number": "६-५६-५", "content_sanskrit": "भूरिश्रवाः शलः शल्यो भगदत्तश्च मारिष ।\nमद्रकाः सिन्धुसौवीरास्तथा पाञ्चनदाश्च ये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2045237, "chapter_id": 2007, "verse_number": "६-५६-६", "content_sanskrit": "जयद्रथेन सहिता ग्रीवायां सन्निवेशिताः ।\nपृष्ठे दुर्योधनो राजा सोदर्यैः सानुगैर्वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2045238, "chapter_id": 2007, "verse_number": "६-५६-७", "content_sanskrit": "विन्दानुविन्दावावन्त्यौ काम्भोजश्च शकैः सह।\nपच्छमासन्महाराज शूरसेनाश्च सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2045239, "chapter_id": 2007, "verse_number": "६-५६-८", "content_sanskrit": "मागधाश्च कलिङ्गाश्च दासेरकगणैः सह ।\nदक्षिणं पक्षमासाद्य स्थिता व्यूहस्य दंशिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2045240, "chapter_id": 2007, "verse_number": "६-५६-९", "content_sanskrit": "काकरुशा विकुञ्चाश्च मुण्डाः कुण्डीवृषास्तथा।\nबृहद्वलेन सहिता वामं पार्श्वमवस्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2045241, "chapter_id": 2007, "verse_number": "६-५६-१०", "content_sanskrit": "व्यूढं दृष्ट्वा तु तत्सैन्यं सव्यसाची परंतपः।\nधृष्टद्युम्नेन सहितः प्रत्यव्यूहत संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2045242, "chapter_id": 2007, "verse_number": "६-५६-११", "content_sanskrit": "अर्धचन्द्रेण व्यूहेन व्यूहन्तमतिदारुणम् ।\nदक्षिणं शृङ्गमास्वय भिमसेनो व्यरोचत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2045243, "chapter_id": 2007, "verse_number": "६-५६-१२", "content_sanskrit": "नानासंस्त्रौपसंषत्रैर्नानादेश्यैर्नृपैर्वृतः ।\nतदन्येव विराटश्च द्रुपदश्च महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2045244, "chapter_id": 2007, "verse_number": "६-५६-१३", "content_sanskrit": "तदनन्तरमेवासीन्नीलो नीलायुधैः सह ।\nनीलादनन्तरश्चैव धृष्टकेतुर्महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2045245, "chapter_id": 2007, "verse_number": "६-५६-१४", "content_sanskrit": "चेदिकाशिकरूपेश्च पौरवैरपि संवृतः।\nधृष्टद्युम्नः शिखण्डी च पाञ्चालाश्च प्रभद्रकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2045246, "chapter_id": 2007, "verse_number": "६-५६-१५", "content_sanskrit": "मध्ये सैन्यस्य महतः स्थिता युद्धाय भारत।\nतत्रैव धर्मराजोऽपि गजानीकेन संवृतः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2045247, "chapter_id": 2007, "verse_number": "६-५६-१६", "content_sanskrit": "ततस्तु सात्यकी राजन्द्रौपद्याः पञ्च चात्मजाः ।\nअभिमन्युस्ततः शूर इरावांश्च ततः परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2045248, "chapter_id": 2007, "verse_number": "६-५६-१७", "content_sanskrit": "भैमसेनिस्ततो राजन्केकयाश्च महारथाः ।\nएते सर्वे महाराज वामं पार्श्वमुपाश्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2045249, "chapter_id": 2007, "verse_number": "६-५६-१८", "content_sanskrit": "सर्वस्य जगतो गोप्ता गोप्ता यस्य जनार्दनः।\n`तत्रानुरथिनां श्रेष्ठो वामश्रृङ्गे व्यवस्थितः।\nएवमेतं महाव्यूहं प्रत्यव्यूहन्त पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2045250, "chapter_id": 2007, "verse_number": "६-५६-१९", "content_sanskrit": "वधार्थं तव पुत्रामां तत्पक्षे ये च सङ्गताः ।\nततः प्रववृते युद्धं व्यतिषक्तरथद्विपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2045251, "chapter_id": 2007, "verse_number": "६-५६-२०", "content_sanskrit": "तावकानां परेषां च निघ्नतामितरेतरम् ।\nहयौघाश्च रथौघाश्व तत्र तत्र विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2045252, "chapter_id": 2007, "verse_number": "६-५६-२१", "content_sanskrit": "संपतन्तो व्यदृश्यन्त निघ्नन्तस्ते परस्परम् ।\nधावतां च रथोघानां निघ्नतां च पृथक् पृथक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2045253, "chapter_id": 2007, "verse_number": "६-५६-२२", "content_sanskrit": "बभूव तुमुलः शब्दो विमिश्रो दुन्दुभिस्वनैः ।\nदिवस्पृङ्वरवीराणां निघ्नतामितरेतरम् ।\nसंप्रहारे सुतुमुले तव तेषां च भारत ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2045254, "chapter_id": 2007, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि तृतीयदिवसयुद्धे षट्पञ्चाशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]