[{"id": 7003614000, "chapter_id": 23614, "verse_number": "१-२-१-१", "content_sanskrit": "श्रीमुनय ऊचुः ।\nदक्षिणार्णवतीरेषु यानि तीर्थानि पंच च ।\nतानि ब्रूहि विशालाक्ष वर्णयंत्यति तानि च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003614001, "chapter_id": 23614, "verse_number": "१-२-१-२", "content_sanskrit": "सर्वतीर्थफलं येषु नारदाद्य वदंति च ।\nतेषां चरितमाहात्म्यं श्रोतुमिच्छामहे वयम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003614002, "chapter_id": 23614, "verse_number": "१-२-१-३", "content_sanskrit": "उग्रश्रवा उवाच ।\nश्रृणुध्वचत्यद्भुतपुण्यसत्कथं कुमारनाथस्य महाप्रभावम् ।\nद्वैपायनो यन्मम चाह पूर्वं हर्षाबुरोमोद्गमचर्चितांगः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003614003, "chapter_id": 23614, "verse_number": "१-२-१-४", "content_sanskrit": "कुमारगीता गाथात्र श्रूयतां मुनिसत्तमाः ।\nया सर्वदेवैर्मुनिभिः पितृभिश्च प्रपूजिता ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003614004, "chapter_id": 23614, "verse_number": "१-२-१-५", "content_sanskrit": "मध्वाचारस्तं भतीर्थं यो निषेवेत मानवः ।\nनियतं तस्य वासः स्याद्ब्रह्मलोके यथा मम ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003614005, "chapter_id": 23614, "verse_number": "१-२-१-६", "content_sanskrit": "ब्रह्मलोकाद्विष्णुलोकस्तस्मादपि शिवस्य च ।\nपुत्राप्रियत्वात्तस्यापि गुहलोको महत्तमः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003614006, "chapter_id": 23614, "verse_number": "१-२-१-७", "content_sanskrit": "अत्राश्चर्यकथा या च फाल्गुनस्य पुरेरिता ।\nनारदेन मुनिश्रेष्ठास्तां वो वक्ष्यामि विस्तरात् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003614007, "chapter_id": 23614, "verse_number": "१-२-१-८", "content_sanskrit": "पुरा निमित्ते कस्मिंश्चित्करीटी मणिकूटतः ।\nसमुद्रे दक्षिणेऽभ्यागात्स्नातुं तीर्थानि पंच च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003614008, "chapter_id": 23614, "verse_number": "१-२-१-९", "content_sanskrit": "वर्जयंति सदा यानि भयात्तीर्थानि तापसाः ।\nकुमारेशस्य पूर्वं च तीर्थमस्ति मुनेः प्रियम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003614009, "chapter_id": 23614, "verse_number": "१-२-१-१०", "content_sanskrit": "स्तंभेशस्य द्वितीयं च सौभद्रस्य मुनेः प्रियम् ।\nबर्करेश्वरमन्यच्च पौलोमीप्रियमुत्तमम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003614010, "chapter_id": 23614, "verse_number": "१-२-१-११", "content_sanskrit": "चतुर्थं च महाकालं करंधम नृपप्रिययम् ।\nभरद्वाजस्य तीर्थं च सिद्धेशाख्यं हि पंचमम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003614011, "chapter_id": 23614, "verse_number": "१-२-१-१२", "content_sanskrit": "एतानि पंच तीर्थानि ददर्श कुरुपुंगवः ।\nतपस्विभिर्वर्जितानि महापुण्यानि तानि च ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003614012, "chapter_id": 23614, "verse_number": "१-२-१-१३", "content_sanskrit": "दृष्ट्वा पार्श्वे नारदीयानपृच्छत महामुनीन् ।\nतीर्थानीमानि रम्याणि प्रभावाद्भुतवंति च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003614013, "chapter_id": 23614, "verse_number": "१-२-१-१४", "content_sanskrit": "किमर्थं ब्रूत वर्ज्यंते सदैव ब्रह्मवादिभिः ।\nतापसा ऊचुः ।\nग्राहः पंच वसंत्येषु हरंति च तपोधनान् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003614014, "chapter_id": 23614, "verse_number": "१-२-१-१५", "content_sanskrit": "अत एतानि वर्ज्यंते तीर्थानि कुरुनंदन ।\nइति श्रुत्वा महाबाहुर्गमनाय मनो दधे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003614015, "chapter_id": 23614, "verse_number": "१-२-१-१६", "content_sanskrit": "ततस्तं तापसाः प्रोचुथंतुं नार्हसि फाल्गुन ।\nबहवो भक्षिता ग्राहै राजानो मुनयस्तथा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003614016, "chapter_id": 23614, "verse_number": "१-२-१-१७", "content_sanskrit": "तत्त्व द्वारशवर्षाणि तीर्थानामर्बुदेष्वपि ।\nस्नातः किमेतैस्तीर्थैस्ते मा पतंगव्रतो भव ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003614017, "chapter_id": 23614, "verse_number": "१-२-१-१८", "content_sanskrit": "अर्जुन उवाच ।\nयदुक्तं करुणासारैः सारं किं तदिहोच्यताम् ।\nधर्मार्थी मनुजो यश्च न स वार्यो महात्मभिः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003614018, "chapter_id": 23614, "verse_number": "१-२-१-१९", "content_sanskrit": "धर्मकामं हि मनुजं यो वारयति मंदधीः ।\nतदाश्रितस्य जगतो निःश्वासैर्भस्मसाद्भवेत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003614019, "chapter_id": 23614, "verse_number": "१-२-१-२०", "content_sanskrit": "यज्जीवितं चाचिरांशुसमानक्षणभंगुरम् ।\nतच्चेद्धर्मकृते याति यातु दोषोऽस्ति को ननु ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003614020, "chapter_id": 23614, "verse_number": "१-२-१-२१", "content_sanskrit": "जीवितं च धनं दाराः पुत्राः क्षेत्रगृहाणि च ।\nयान्ति येषआं धर्मकृते त एव भुवि मानवाः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003614021, "chapter_id": 23614, "verse_number": "१-२-१-२२", "content_sanskrit": "तापसा ऊचुः ।\nएवं ते ब्रुवतः पार्थ दीर्घमायुः प्रवर्धताम् ।\nसदा धर्मे रतिर्भूयाद्याहि स्वं कुरु वांछितम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003614022, "chapter_id": 23614, "verse_number": "१-२-१-२३", "content_sanskrit": "एवमुक्तः प्रणम्यैतानाशीर्भिरभिसंस्तुतः ।\nजगाम तानि तीर्थानि द्रष्टुं भरतसत्तमः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003614023, "chapter_id": 23614, "verse_number": "१-२-१-२४", "content_sanskrit": "ततः सौभद्रमासाद्य महर्षेस्तीर्थुमुत्तमम् ।\nविगाह्य तरसा वीरः स्नानं चक्रे परंतपः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003614024, "chapter_id": 23614, "verse_number": "१-२-१-२५", "content_sanskrit": "अथ तं पुरुषव्याघ्रमंतर्जलचरो महान् ।\nनिजग्राह जले ग्राहः कुंतीपुत्रं धनंजयम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003614025, "chapter_id": 23614, "verse_number": "१-२-१-२६", "content_sanskrit": "तमादायैव कौतेयो विस्फुरंतं जलेचरम् ।\nउदतिष्ठन्महाबाहुर्बलेन बलिनां वरः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003614026, "chapter_id": 23614, "verse_number": "१-२-१-२७", "content_sanskrit": "उद्धृतश्चैव तु ग्राहः सोऽर्जुनेन यशस्विना ।\nबभूव नारी कल्याणी सर्वाभरणभूषिता ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003614027, "chapter_id": 23614, "verse_number": "१-२-१-२८", "content_sanskrit": "दीप्यमानशिखा विप्रा दिव्यरूपा मनोरमा ।\nतदद्भुतं महद्दृष्ट्वा कुंतीपुत्रो धनंजयः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003614028, "chapter_id": 23614, "verse_number": "१-२-१-२९", "content_sanskrit": "तां स्त्रियं परमप्रीत इदं वचनमब्रवीत् ।\nका वै त्वमसि कल्याणि कुतो वा जलचारिणी ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003614029, "chapter_id": 23614, "verse_number": "१-२-१-३०", "content_sanskrit": "किमर्थं च महात्पापमिदं कृतवती ह्यसि ।\nनार्युवाच ।\nअप्सरा ह्यस्मि कौतेय देवारण्यनिवासिनी ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003614030, "chapter_id": 23614, "verse_number": "१-२-१-३१", "content_sanskrit": "इष्टा धनपतेर्नित्यं वर्चानाम महाबल ।\nमम सख्यश्चतस्रोऽन्याः सर्वाः कामगमाः शुभाः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003614031, "chapter_id": 23614, "verse_number": "१-२-१-३२", "content_sanskrit": "ताभिः सार्धं प्रयातास्मि देवराजनिवेशनात् ।\nततः पश्यामहे सर्वा ब्राह्मणं चानिकेतनम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003614032, "chapter_id": 23614, "verse_number": "१-२-१-३३", "content_sanskrit": "रूपवंतमधीयानमेकमेकांतचारिणम् ।\nतस्य वै तपसा वीर तद्वनं तेजसावृतम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003614033, "chapter_id": 23614, "verse_number": "१-२-१-३४", "content_sanskrit": "आदित्य इव तं देशं कृत्स्नमेवान्व भासयत् ।\nतस्य दृष्ट्वा तपस्तादृग्रूपं चाद्भुतदर्शनम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003614034, "chapter_id": 23614, "verse_number": "१-२-१-३५", "content_sanskrit": "अवतीर्णास्ति तं देशं तपोविघ्नचिकीर्षया ।\nअहं च सौरभेयी च सामेयी बुद्बुदालता ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003614035, "chapter_id": 23614, "verse_number": "१-२-१-३६", "content_sanskrit": "यौगपद्येन तं विप्रमभ्यगच्छाम भारत ।\nगायंत्यो ललमानाश्च लोभयंत्यश्च तं द्विजम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003614036, "chapter_id": 23614, "verse_number": "१-२-१-३७", "content_sanskrit": "स च नास्मासु कृतवान्मनोवीरः कथंचन ।\nनाकंपत महातेजाः स्थितस्तपसि निर्मले ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003614037, "chapter_id": 23614, "verse_number": "१-२-१-३८", "content_sanskrit": "सोऽशपत्कुपितोऽस्मासु ब्राह्मणः क्षत्रियर्षभ ।\nग्राहभूता जले यूयं भविष्यथ शतं समाः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003614038, "chapter_id": 23614, "verse_number": "१-२-१-३९", "content_sanskrit": "ततो वयं प्रव्यथिताः सर्वा भरतसत्तम ।\nआयाताः शरणं विप्रं तपोधनमकल्मषम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003614039, "chapter_id": 23614, "verse_number": "१-२-१-४०", "content_sanskrit": "रूपेण वयसा चैव कंदर्पेण च दर्पिताः ।\nअयुक्तं कृतवत्यः स्म क्षंतुमर्हसि नो द्विज ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003614040, "chapter_id": 23614, "verse_number": "१-२-१-४१", "content_sanskrit": "एष एव वधोऽस्माकं स पर्याप्तस्तपोधन ।\nयद्वयं शंसितात्मानं प्रलोब्धुं त्वामुपागताः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003614041, "chapter_id": 23614, "verse_number": "१-२-१-४२", "content_sanskrit": "अवध्याश्च स्त्रियः सृष्टा मन्यंते धर्मचिंतकाः ।\nतस्माद्धर्मेण धर्मज्ञ एष वादो मनीषिणाम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003614042, "chapter_id": 23614, "verse_number": "१-२-१-४३", "content_sanskrit": "शरणं च प्रपन्नानां शिष्टाः कुर्वंति पालनम् ।\nशरण्यं त्वां प्रपन्नाः स्मस्तस्मात्त्वं क्षंतुमर्हसि ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003614043, "chapter_id": 23614, "verse_number": "१-२-१-४४", "content_sanskrit": "एवमुक्तस्तु धर्मात्मा ब्राह्मणः शुभकर्मकृत् ।\nप्रसादं कृतवाञ्छूररविसोमसमप्रभः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003614044, "chapter_id": 23614, "verse_number": "१-२-१-४५", "content_sanskrit": "ब्राह्मण उवाच ।\nभवतीनां चरित्रेण परिमुह्यामि चेतसि ।\nअहो धार्ष्ट्यमहो मोहो यत्पापाय प्रवर्तनम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003614045, "chapter_id": 23614, "verse_number": "१-२-१-४६", "content_sanskrit": "मस्त कस्थायिनं मृत्युं यदि पश्येदयं जनः ।\nआहारोऽपि न रोचेत किमुताकार्यकारिता ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003614046, "chapter_id": 23614, "verse_number": "१-२-१-४७", "content_sanskrit": "आहो मानुष्यकं जन्म सर्वजन्मसु दुर्लभम् ।\nतृणवत्क्रियते कैश्चिद्योषिन्मूढैर्दुराधरैः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003614047, "chapter_id": 23614, "verse_number": "१-२-१-४८", "content_sanskrit": "तान्वयं समपृच्छामो जनिर्वः किंनिमित्ततः ।\nको वा लाभो विचार्यैतन्मनासा सह प्रोच्यताम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003614048, "chapter_id": 23614, "verse_number": "१-२-१-४९", "content_sanskrit": "न चैताः परिनिन्दामो जनिर्यार्भ्यः प्रवर्तते ।\nकेवलं तान्विनिंदामो ये च तासु निरर्गलाः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003614049, "chapter_id": 23614, "verse_number": "१-२-१-५०", "content_sanskrit": "यतः पद्मभुवा सृष्टं मिथुनं विश्ववृद्धये ।\nतत्तथा परिपाल्यं वै नात्र दोषोऽस्ति कश्चन ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003614050, "chapter_id": 23614, "verse_number": "१-२-१-५१", "content_sanskrit": "या बांधवैः प्रदत्ता स्याद्वह्निद्विजसमागमे ।\nगार्हस्थ्यपालनं धन्यं तया साकं हि सर्वदम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003614051, "chapter_id": 23614, "verse_number": "१-२-१-५२", "content_sanskrit": "यथाप्रकृति पुंयोमो यत्नेनापि परस्परम् ।\nसाध्यामानो गुणाय स्यादगुणायाप्यसाधितः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003614052, "chapter_id": 23614, "verse_number": "१-२-१-५३", "content_sanskrit": "एवं यत्नात्साध्यमानं स्वकं गार्हस्थ्यमुत्तमम् ।\nगुणाय महते भूयादगुणायाप्यसाधितम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003614053, "chapter_id": 23614, "verse_number": "१-२-१-५४", "content_sanskrit": "पुरे पंचमुखे द्वाःस्थ एकादशभटैर्युतः ।\nसाकं नार्या बह्वपत्यः स कथं स्यादचेतनः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003614054, "chapter_id": 23614, "verse_number": "१-२-१-५५", "content_sanskrit": "यश्चस्त्रिया समायोगः पंचयज्ञादिकर्मभिः ।\nविश्वोपकृतये सृष्टा मूढैर्हा साध्यतेऽन्यथा ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003614055, "chapter_id": 23614, "verse_number": "१-२-१-५६", "content_sanskrit": "अहो श्रृणुध्वं नो चेद्वः शुश्रूषा जायते शुभा ।\nतथापि बाहुमुद्धृत्य रोरूयामः श्रृणोति कः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003614056, "chapter_id": 23614, "verse_number": "१-२-१-५७", "content_sanskrit": "षड्धातुसारं तद्वीर्यं समानं परिहाय च ।\nविनिक्षेपे कुयोनौ तु तस्येदं प्रोक्तवान्यमः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003614057, "chapter_id": 23614, "verse_number": "१-२-१-५८", "content_sanskrit": "प्रथमं चौषधीद्रोग्धा आत्मद्रोग्धा ततः पुनः ।\nपितृद्रोग्धा विश्वद्रोग्धा यात्यंधं शाश्वतीः समाः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003614058, "chapter_id": 23614, "verse_number": "१-२-१-५९", "content_sanskrit": "मनुष्यं पितरो देवा मुनयो मानवास्तथा ।\nभृतानि चोपजीवंति तदर्थं नियतो भवेत् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003614059, "chapter_id": 23614, "verse_number": "१-२-१-६०", "content_sanskrit": "वचसा मनसा चैव जिह्वया करश्रोत्रकैः ।\nदांतमाहुर्हि सत्तीर्थं काकतीर्थमतः परम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003614060, "chapter_id": 23614, "verse_number": "१-२-१-६१", "content_sanskrit": "काकप्राये नरे यस्मिन्रमंते तामसा जनाः ।\nहंसोऽयमिति देवानां कोऽर्थस्तेन विचिंत्यताम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003614061, "chapter_id": 23614, "verse_number": "१-२-१-६२", "content_sanskrit": "एवंविधं हि विश्वस्य निर्माणं स्मरतोहृदि ।\nअपि कृते त्रिलोक्याश्च कथं पापे रमेन्मनः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003614062, "chapter_id": 23614, "verse_number": "१-२-१-६३", "content_sanskrit": "तदिदं चान्यमर्त्यानां शास्त्रदृष्टमहो स्त्रियः ।\nयमलोके मया दृष्टं मुह्ये प्रत्यक्षतः कथम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003614063, "chapter_id": 23614, "verse_number": "१-२-१-६४", "content_sanskrit": "भवतीषु च कः कोपो ये यदर्थे हि निर्मिताः ।\nते तमर्थं प्रकुर्वंति सत्यमस्तुभमेव च ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003614064, "chapter_id": 23614, "verse_number": "१-२-१-६५", "content_sanskrit": "शतं सहस्रं विश्वं च सर्वमक्षय वाचकम् ।\nपरिमाणं शतं त्वेव नैतदक्षय्यवाचकम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003614065, "chapter_id": 23614, "verse_number": "१-२-१-६६", "content_sanskrit": "यदा च वो ग्राहभूता गृह्णतीः पुरुषाञ्जले ।\nउत्कर्षति जलात्कश्चित्स्थले पुरुषसत्तमः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003614066, "chapter_id": 23614, "verse_number": "१-२-१-६७", "content_sanskrit": "तदा यूयं पुनः सर्वाः स्वं रूपं प्रतिपत्स्यथ ।\nअनृतं नोक्तपूर्वं मे हसतापि कदाचन ।\nकल्याणस्य सुपृक्तस्य शुद्धिस्तद्वद्वरा हि वः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003614067, "chapter_id": 23614, "verse_number": "१-२-१-६८", "content_sanskrit": "नार्युवाच ।\nततोभिवाद्य तं विप्रं कृत्वा चैव प्रदक्षिणम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003614068, "chapter_id": 23614, "verse_number": "१-२-१-६९", "content_sanskrit": "अचिंतयामापसृत्य तस्माद्देशात्सुदुःखिताः ।\nक्व नु नाम वयं सर्वाः कालेनाल्पेन तं नरम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003614069, "chapter_id": 23614, "verse_number": "१-२-१-७०", "content_sanskrit": "समागच्छेम यो नः स्वं रूपमापादयेत्पुनः ।\nता वयं चिंतयित्वेह मुहूर्तादिव भारत ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003614070, "chapter_id": 23614, "verse_number": "१-२-१-७१", "content_sanskrit": "दृष्टवत्यो महाभागं देवर्षिमथ नारदम् ।\nसर्वा दृष्टाः स्म तं दृष्ट्वा देवर्षिममितद्युतिम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003614071, "chapter_id": 23614, "verse_number": "१-२-१-७२", "content_sanskrit": "अभिवाद्य च तं पार्थ स्थिताः स्मो व्यथिताननाः ।\nस नोऽपृच्छद्दृःखमूलमुक्तवत्यो वयं च तम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003614072, "chapter_id": 23614, "verse_number": "१-२-१-७३", "content_sanskrit": "श्रुत्वा तच्च यथातत्त्वमिदं वचनमब्रवीत् ।\nदक्षिणे सागरेऽनूपे पंच तीर्थानि संतिवै ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003614073, "chapter_id": 23614, "verse_number": "१-२-१-७४", "content_sanskrit": "पुण्यानि रमणीयानि तानि गच्छत मा चिरम् ।\nतत्रस्थाः पुरुषव्याघ्रः पांडवो वो धनंजयः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003614074, "chapter_id": 23614, "verse_number": "१-२-१-७५", "content_sanskrit": "मोक्षयिष्यति शुद्धात्मा दुःखा दस्मान्न संशयः ।\nतस्य सर्वा वयं वीर श्रुत्वा वाक्यमिहागताः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003614075, "chapter_id": 23614, "verse_number": "१-२-१-७६", "content_sanskrit": "त्वमिदं सत्यवचनं कर्तुमर्हसि पांडव ।\nत्वद्विधानां हि साधूनां जन्म दीनोपकारकम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003614076, "chapter_id": 23614, "verse_number": "१-२-१-७७", "content_sanskrit": "श्रुत्वेति वचनं तस्याः सस्नौ तीर्थेष्वनुक्रमात् ।\nग्राहभूताश्चोज्जहार यथापूर्वाः स पांडवः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003614077, "chapter_id": 23614, "verse_number": "१-२-१-७८", "content_sanskrit": "ततः प्रणम्य ता वीरं प्रोच्यमाना जयाशिषः ।\nगंतुं कृताभिलाषाश्च प्राह पार्थो धनंजयः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003614078, "chapter_id": 23614, "verse_number": "१-२-१-७९", "content_sanskrit": "एष मे हृदि संदेहः सुदृढः परिवर्तते ।\nकस्माद्वोनारदमुनिरनुजज्ञे प्रवासितुम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003614079, "chapter_id": 23614, "verse_number": "१-२-१-८०", "content_sanskrit": "सर्वः कोऽप्यतिहीनोऽपि स्वपूज्यस्यार्थसाधकः ।\nस्वपूज्यतीर्थेष्वावासं प्रोक्तवान्नारदः कथम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003614080, "chapter_id": 23614, "verse_number": "१-२-१-८१", "content_sanskrit": "तथैव नवदुर्गासु सतीष्वतिबलासु च ।\nसिद्धेशे सिद्धगणपे चापि वोऽत्र स्थितिः कथम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003614081, "chapter_id": 23614, "verse_number": "१-२-१-८२", "content_sanskrit": "एकैक एषां शक्तो हि अपि देवान्निवारितुम् ।\nतीर्थसंरोधकारिण्यः सर्वा नावारयत्कथम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003614082, "chapter_id": 23614, "verse_number": "१-२-१-८३", "content_sanskrit": "इति चिंतयते मह्यं भृशं दोलायते मनः ।\nमहन्मे कौतुकं जातं सत्यं वा वक्तुमर्हथ ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003614083, "chapter_id": 23614, "verse_number": "१-२-१-८४", "content_sanskrit": "अप्सरस ऊचुः ।\nयोग्यं पृच्छसि कौन्तेय पुनः पश्योत्तरां दिशम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}]