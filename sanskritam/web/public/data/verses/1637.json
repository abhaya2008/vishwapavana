[{"id": 2029192, "chapter_id": 1637, "verse_number": "३-२७५-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2029193, "chapter_id": 1637, "verse_number": "३-२७५-१", "content_sanskrit": "प्राप्तमप्रतिमं दुःखं रामेण भरतर्षभ।\nरक्षसा जानकी तस्य हृता भार्या बलीयसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2029194, "chapter_id": 1637, "verse_number": "३-२७५-२", "content_sanskrit": "आश्रमाद्राक्षसेन्द्रेण रावणेन दुरात्मना।\nमायामास्थाय तरसा हत्वा गृध्रं जटायुषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2029195, "chapter_id": 1637, "verse_number": "३-२७५-३", "content_sanskrit": "प्रत्याजहार तां रामः सुग्रीवबलमाश्रितः।\nबद्ध्वा सेतुं समुद्रस्य दग्ध्वा लङ्कां शितैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2029196, "chapter_id": 1637, "verse_number": "३-२७५-४x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2029197, "chapter_id": 1637, "verse_number": "३-२७५-४", "content_sanskrit": "कस्मिन्नामः कुले जातः किंवीर्यः किंपराक्रमः।\nरावणः कस्य पुत्रो वा किं वैरं तस् तेन ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2029198, "chapter_id": 1637, "verse_number": "३-२७५-५", "content_sanskrit": "एतन्मे भगवन्सर्वं सम्यगाख्यातुमर्हसि।\n`त्वया प्रत्यक्षोदृष्टं यथासर्वमशेषतः।\nश्रोतुमिच्छामि चरितं रामस्याक्लिष्टकर्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2029199, "chapter_id": 1637, "verse_number": "३-२७५-६x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2029200, "chapter_id": 1637, "verse_number": "३-२७५-६", "content_sanskrit": "अजोनामाभवद्राजा महानिक्ष्वाकुवंशजः।\nतस् पुत्रो दशरथःशश्वत्स्वाध्यायवाञ्छुचिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2029201, "chapter_id": 1637, "verse_number": "३-२७५-७", "content_sanskrit": "अभवंस्तस्य चत्वारः पुत्रा धर्मार्थकोविदाः।\nरामलक्ष्मणशत्रुघ्ना भरतश्च महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2029202, "chapter_id": 1637, "verse_number": "३-२७५-८", "content_sanskrit": "रामस्य माता कौसल्या कैकेयी भरतस्य तु।\nसुतौ लक्ष्मणशत्रुघ्नौ सुमित्रायाः परंतपौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2029203, "chapter_id": 1637, "verse_number": "३-२७५-९", "content_sanskrit": "विदेहराजो जनकः सीता तस्यात्मजा विमो।\nयां चकार स्वयं त्वष्टा रामस्य महिषीं प्रियाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2029204, "chapter_id": 1637, "verse_number": "३-२७५-१०", "content_sanskrit": "एतद्रामस्य ते जन्म सीतायाश्च प्रकीर्तितम्।\nरावणस्यापि ते जन्म व्याख्यास्यामि रजनेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2029205, "chapter_id": 1637, "verse_number": "३-२७५-११", "content_sanskrit": "पितामहो रावणस्य साक्षाद्देवः प्रजापतिः।\nस्वयंभूः सर्वलोकानां प्रभुः स्रष्टा महातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2029206, "chapter_id": 1637, "verse_number": "३-२७५-१२", "content_sanskrit": "पुलस्त्यो नाम तस्यासीन्मानसो दयितः सुतः।\nतस्य वैश्रवणो नाम गवि पुत्रोऽभवत्प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2029207, "chapter_id": 1637, "verse_number": "३-२७५-१३", "content_sanskrit": "पितरं स समुत्सृज्य पितामहमुपस्थितः।\nतस्य कोपात्पिता राजन्ससर्जात्मानमात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2029208, "chapter_id": 1637, "verse_number": "३-२७५-१४", "content_sanskrit": "स जज्ञे विश्रवा नाम तस्यात्मार्धेन वै द्विजः।\nप्रतीकाराय सक्रोधस्ततो वैश्रवणस्य वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2029209, "chapter_id": 1637, "verse_number": "३-२७५-१५", "content_sanskrit": "पितामहस्तुप्रीतात्मा ददौ वैश्रवणस् ह।\nअमरत्वं धनेशत्वं लोकपालत्वमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2029210, "chapter_id": 1637, "verse_number": "३-२७५-१६", "content_sanskrit": "ईशानन तथा सख्यं पुत्रं च नलकूवरम्।\nराजधानीनिवेसं च लङ्कांरक्षोगणान्विताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2029211, "chapter_id": 1637, "verse_number": "३-२७५-१७", "content_sanskrit": "विमानं पुष्पकं नाम कामगं च ददौ प्रभुः।\nयक्षाणामाधिपत्यंच राजराजत्वमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2029212, "chapter_id": 1637, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि रामोपाख्यानपर्वणि पञ्चसप्तत्यधिकद्विशततमोऽध्यायः ॥ २७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]