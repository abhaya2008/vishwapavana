[{"id": 7001520000, "chapter_id": 21520, "verse_number": "१-१७-१", "content_sanskrit": "॥ वायुरुवाच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001520001, "chapter_id": 21520, "verse_number": "१-१७-२", "content_sanskrit": "आश्रमत्रयमुत्सृज्य प्राप्तस्तु परमाश्रमम् ।\nअतः संवत्सरस्यान्ते प्राप्य ज्ञानमनुत्तमम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001520002, "chapter_id": 21520, "verse_number": "१-१७-३", "content_sanskrit": "अनुज्ञाप्य गुरूंचैव विचरेत् पृथिवीमिमाम् ।\nसारभूतमुपासीत ज्ञानं यज्ज्ञेय साधकम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001520003, "chapter_id": 21520, "verse_number": "१-१७-४", "content_sanskrit": "इदं ज्ञानमिदं ज्ञेयमिति यस्तुषितश्चरेत्  ।\nअपि कल्पसहस्रायुर्न्नैव ज्ञेयमवाप्नुयात् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001520004, "chapter_id": 21520, "verse_number": "१-१७-५", "content_sanskrit": "त्यक्तसङ्गो जितकोधो लघ्वाहारो जितेन्द्रियः ।\nपिधाय बुद्ध्या द्वाराणि ध्याने ह्येवं मनो दधेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001520005, "chapter_id": 21520, "verse_number": "१-१७-६", "content_sanskrit": "शून्येष्वेवावकाशेषु गुहासु चवने तथा ।\nनदीनां पुलिने चैव नित्यं युक्तः सदा भवेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001520006, "chapter_id": 21520, "verse_number": "१-१७-७", "content_sanskrit": "वाग्दण्डः कर्मदण्डश्च मनोदण्डश्च ते त्रयः ।\nयस्यैते नियता दण्डाः स त्रिदण्डी व्यवस्थितः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001520007, "chapter_id": 21520, "verse_number": "१-१७-८", "content_sanskrit": "अवस्थितो ध्यानरतिर्जितेन्द्रियः शुभाशुभे हित्य च कर्मणी उभे  ।\nइदं शरीरं प्रविमुच्य शास्त्रतो न जायते म्रियते वा कदाचित् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001520008, "chapter_id": 21520, "verse_number": "१-१७-९", "content_sanskrit": "इति श्रीमहापुराणे वायुप्रोक्ते परमाश्रमप्राप्तिकथनं नाम सप्तदशोऽध्यायः ॥ १७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]