[{"id": 2039087, "chapter_id": 1855, "verse_number": "५-१००-०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2039088, "chapter_id": 1855, "verse_number": "५-१००-१", "content_sanskrit": "हिरण्यपुरमित्येतत्ख्यातं पुरवरं महत्।\nदैत्यानां दानवानां च मायाशतविचारिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2039089, "chapter_id": 1855, "verse_number": "५-१००-२", "content_sanskrit": "अनल्पेन प्रयत्नेन निर्मितं विश्वकर्मणा ।\nमयेन मनसा सृष्टं पातालतलमाश्रितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2039090, "chapter_id": 1855, "verse_number": "५-१००-३", "content_sanskrit": "अत्र मायासहस्राणि वविकुर्वाणा महौजसः ।\nदानवा निवसन्ति स्म शूरा दत्तवराः पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2039091, "chapter_id": 1855, "verse_number": "५-१००-४", "content_sanskrit": "नैते शक्रेण नान्येन यमेन वरुणेन वा।\nशक्यन्ते वशमानेतुं तथैव धनदेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2039092, "chapter_id": 1855, "verse_number": "५-१००-५", "content_sanskrit": "असुराः कालखञ्जाश्च तथा वुष्णुपदोद्भवाः ।\nनैर्ऋता यातुधानाश्च ब्रह्मपादोद्भवाश्च ये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2039093, "chapter_id": 1855, "verse_number": "५-१००-६", "content_sanskrit": "दंष्ट्रिणो भीमवेगाश्च वातवेगपराक्रमाः ।\nमायावीर्योपसंपन्ना निवसन्त्यत्र मातले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2039094, "chapter_id": 1855, "verse_number": "५-१००-७", "content_sanskrit": "निवातकवचा नाम दानवा युद्धदुर्मदाः ।\nजानासि च यथा शक्रो नैताञ्शक्रोति बाधितुं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2039095, "chapter_id": 1855, "verse_number": "५-१००-८", "content_sanskrit": "बहुशो मातले त्वं च तव पुत्रश्च गोमुखः ।\nनिर्भग्नो देवराजश्च सहपुत्रः शचीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2039096, "chapter_id": 1855, "verse_number": "५-१००-९", "content_sanskrit": "पश्य वेश्मानि रौक्माणि मातले राजतानि च ।\nकर्मणा विधियुक्तेन युक्तान्युपगतानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2039097, "chapter_id": 1855, "verse_number": "५-१००-१०", "content_sanskrit": "वैदूर्यमणिचित्राणि प्रवालरुचिराणि च ।\nअर्कस्फटिकशुभ्राणि वज्रसारोञ्ज्वलानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2039098, "chapter_id": 1855, "verse_number": "५-१००-११", "content_sanskrit": "पार्थिवानीव चाभास्ति पद्मरागमयानि च।\nशैलानीव च दृश्यन्ते दारवाणीव चाप्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2039099, "chapter_id": 1855, "verse_number": "५-१००-१२", "content_sanskrit": "सूर्यरूपाणि चाभान्ति दीप्ताग्निसदृशानि च ।\nमणिजालविचित्राणि प्रांशूनि निबिडानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2039100, "chapter_id": 1855, "verse_number": "५-१००-१३", "content_sanskrit": "नैतानि शक्यं निर्देष्टु रूपतो द्रव्यतस्तथा ।\nगुणतश्चैव सिद्धानि प्रमाणगुणवन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2039101, "chapter_id": 1855, "verse_number": "५-१००-१४", "content_sanskrit": "आक्रीडान्पश्य दैत्यानां तथैव शयनान्युत ।\nरत्नवन्ति महार्हाणि भाजनान्यासनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2039102, "chapter_id": 1855, "verse_number": "५-१००-१५", "content_sanskrit": "जलदाभांस्तथा शैलांस्तोयप्रस्रवणानि च ।\nकामपुष्पफलांश्चापि पादपान्कापचारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2039103, "chapter_id": 1855, "verse_number": "५-१००-१६", "content_sanskrit": "मातले कश्चिदत्रापि रुचिरस्ते वरो भवेत् ।\nअथवाऽन्यां दिशं भूमेर्गच्छाव यदि मन्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2039104, "chapter_id": 1855, "verse_number": "५-१००-१७", "content_sanskrit": "मातलिस्त्वब्रवीदेनं भाषमाणं तथाविधम् ।\nदेवर्षे नैव मे कार्यं विप्रियं त्रिदिवौकसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2039105, "chapter_id": 1855, "verse_number": "५-१००-१८", "content_sanskrit": "नित्यानुषक्तवैरा हि भ्रातरो देवदानवाः ।\nपरपक्षेण संबन्धं रोचयिष्याम्यहं कथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2039106, "chapter_id": 1855, "verse_number": "५-१००-१९", "content_sanskrit": "अन्यत्र साधु गच्छाव द्रष्टुं नार्हामि दानवान् ।\nजानामि तव चात्मानं हिंसात्मकमनं तथा ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2039107, "chapter_id": 1855, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि शततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]