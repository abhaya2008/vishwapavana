[{"id": 5000551000, "chapter_id": 9551, "verse_number": "७-१६-१", "content_sanskrit": "स जित्वा धनदं राम भ्रातरं राक्षसाधिपः ।\nमहासेनप्रसूतिं तद्ययौ शरवणं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000551001, "chapter_id": 9551, "verse_number": "७-१६-२", "content_sanskrit": "अथापश्यदृशग्रीवो रौक्मं शरवणं महत् ।\nगभस्तिजालसंवीतं द्वितीयमिव भास्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000551002, "chapter_id": 9551, "verse_number": "७-१६-३", "content_sanskrit": "स पर्वतं समारुह्य कञ्चिद्रम्यवनान्तरम् ।\nअपश्यत् पुष्पकं तत्र रामविष्टम्भितं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000551003, "chapter_id": 9551, "verse_number": "७-१६-४", "content_sanskrit": "विष्टब्धं पुष्पकं दृष्ट्वा ह्यगमं कामागं कृतम् ।\nअचिन्तयद्राक्षसेन्द्रः सचिवैस्तैः समावृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000551004, "chapter_id": 9551, "verse_number": "७-१६-५", "content_sanskrit": "किन्निमित्तं चेच्छया मे नेदं गच्छति पुष्पकम् ।\nपर्वतस्योपरिष्ठस्य कर्मेदं कस्यचिद्भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000551005, "chapter_id": 9551, "verse_number": "७-१६-६", "content_sanskrit": "ततो ऽब्रवीत्तदा राम मारीचो बुद्धिकोविदः ।\nनेदं निष्कारणं राजन्पुष्पकं यन्न गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000551006, "chapter_id": 9551, "verse_number": "७-१६-७", "content_sanskrit": "अथवा पुष्पकमिदं धनदान्नान्यवाहनम् ।\nअतो निष्पन्दमभवद्धनाध्यक्षविनाकृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000551007, "chapter_id": 9551, "verse_number": "७-१६-८", "content_sanskrit": "इति वाक्यान्तरे तस्य करालः कृष्णपिङ्गलः ।\nवामनो विकटो मुण्डी नन्दी प्रह्वभुजो बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000551008, "chapter_id": 9551, "verse_number": "७-१६-९", "content_sanskrit": "ततः पार्श्वमुपागम्य भवस्यानुचरो ऽब्रवीत् ।\nनन्दीश्वरो वचश्चेदं राक्षसेन्द्रमशङ्कितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000551009, "chapter_id": 9551, "verse_number": "७-१६-१०", "content_sanskrit": "निवर्तस्व दशग्रीव शैले क्रीडति शङ्करः ।\nसुपर्णनागयक्षाणां देवगन्धर्वरक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000551010, "chapter_id": 9551, "verse_number": "७-१६-११", "content_sanskrit": "सर्वेषामेव भूतानामगम्यः पर्वतः कृतः ।\nइति नन्दिवचः श्रुत्वा क्रोधात्कम्पितकुण्डलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000551011, "chapter_id": 9551, "verse_number": "७-१६-१२", "content_sanskrit": "रोषात्तु ताम्रनयनः पुष्पकादवरुह्य सः ।\nको ऽयं शङ्कर इत्युक्त्वा शैलमूलमुपागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000551012, "chapter_id": 9551, "verse_number": "७-१६-१३", "content_sanskrit": "सो ऽपश्यन्नन्दिनं तत्र देवस्यादूरतः स्थितम् ।\nदीप्तं शूलमवष्टभ्य द्वितीयमिव शङ्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000551013, "chapter_id": 9551, "verse_number": "७-१६-१४", "content_sanskrit": "तं दृष्ट्वा वानरमुखमवज्ञाय स राक्षसः ।\nप्रहासं मुमुचे तत्र सतोय इव तोयदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000551014, "chapter_id": 9551, "verse_number": "७-१६-१५", "content_sanskrit": "तं क्रुद्धो भगवान्नन्दी शङ्करस्यापरा तनुः ।\nअब्रवीत्तत्र तद्रक्षो दशाननमुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000551015, "chapter_id": 9551, "verse_number": "७-१६-१६", "content_sanskrit": "यस्माद्वानररूपं मामवज्ञाय दशानन ।\nअशनीपातसङ्काशमपहासं प्रमुक्तवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000551016, "chapter_id": 9551, "verse_number": "७-१६-१७", "content_sanskrit": "तस्मान्मद्रूपसम्पन्ना मद्वीर्यसमतेजसः ।\nउत्पत्स्यन्ति वधार्थं हि कुलस्य तव वानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000551017, "chapter_id": 9551, "verse_number": "७-१६-१८", "content_sanskrit": "नखदंष्ट्रायुधाः क्रूरा मनःसम्पातरंहसः ।\nयुद्धोन्मत्ता बलोद्रिक्ताः शैला इव विसर्पिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000551018, "chapter_id": 9551, "verse_number": "७-१६-१९", "content_sanskrit": "ते तव प्रबलं दर्पमुत्सेधं च पृथग्विधम् ।\nव्यपनेष्यन्ति सम्भूय सहामात्यसुतस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000551019, "chapter_id": 9551, "verse_number": "७-१६-२०", "content_sanskrit": "किं त्विदानीं मया शक्यं हन्तुं त्वां हे निशाचर ।\nन हन्तव्यो हतस्त्वं हि पूर्वमेव स्वकर्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000551020, "chapter_id": 9551, "verse_number": "७-१६-२१", "content_sanskrit": "इत्युदीरितवाक्ये तु देवे तस्मिन्महात्मनि ।\nदेवदुन्दुभयो नेदुः पुष्पवृष्टिश्च खाच्च्युता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000551021, "chapter_id": 9551, "verse_number": "७-१६-२२", "content_sanskrit": "अचिन्तयित्वा स तदा नन्दिवाक्यं महाबलः ।\nपर्वतं तु समासाद्य वाक्यमाह दशाननः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000551022, "chapter_id": 9551, "verse_number": "७-१६-२३", "content_sanskrit": "पुष्पकस्य गतिश्छिन्ना यत्कृते मम गच्छतः ।\nतमिमं शैलमुन्मूलं करोमि तव गोपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000551023, "chapter_id": 9551, "verse_number": "७-१६-२४", "content_sanskrit": "केन प्रभावेण भवो नित्यं क्रीडति राजवत् ।\nविज्ञातव्यं न जानीते भयस्थानमुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000551024, "chapter_id": 9551, "verse_number": "७-१६-२५", "content_sanskrit": "एवमुक्त्वा ततो राम भुजान्विक्षिप्य पर्वते ।\nतोलयामास तं शीघ्रं स शैलं समकम्पत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000551025, "chapter_id": 9551, "verse_number": "७-१६-२६", "content_sanskrit": "चालनात्पर्वतस्यैव गणा देवस्य कम्पिताः ।\nचचाल पार्वती चापि तदा ऽ ऽश्लिष्टा महेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000551026, "chapter_id": 9551, "verse_number": "७-१६-२७", "content_sanskrit": "ततो राम महादवो देवानां प्रवरो हरः ।\nपादाङ्गुष्ठेन तं शैलं पीडयामास लीलया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000551027, "chapter_id": 9551, "verse_number": "७-१६-२८", "content_sanskrit": "पीडितास्तु ततस्तस्य शैलस्याधोगता भुजाः ।\nविस्मिताश्चाभवंस्तत्र सचिवास्तस्य रक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000551028, "chapter_id": 9551, "verse_number": "७-१६-२९", "content_sanskrit": "रक्षसा तेन रोषाच्च भुजानां पीडनात्तदा ।\nमुक्तो विरावः सहसा त्रैलोक्यं येन कम्पितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000551029, "chapter_id": 9551, "verse_number": "७-१६-३०", "content_sanskrit": "मेनिरे वज्रनिष्पेषं तस्यामात्या युगक्षये ।\nतदा वर्त्मस्थचलिता देवा इन्द्रपुरोगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000551030, "chapter_id": 9551, "verse_number": "७-१६-३१", "content_sanskrit": "समुद्राश्चापि सङ्क्षुब्धाश्चलिताश्चापि पर्वताः ।\nयक्षा विद्याधराः सिद्धाः किमेतदिति चाब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000551031, "chapter_id": 9551, "verse_number": "७-१६-३२", "content_sanskrit": "अथ ते मन्त्रिणस्तस्य विक्रोशन्तमथाब्रुवन् ।\nतोषयस्व महादेवं नीलकण्ठमुमापतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000551032, "chapter_id": 9551, "verse_number": "७-१६-३३", "content_sanskrit": "तमृते शरणं नान्यं पश्यामो ऽत्र दशानन ।\nस्तुतिभिः प्रणतो भूत्वा तमेव शरणं व्रज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000551033, "chapter_id": 9551, "verse_number": "७-१६-३४", "content_sanskrit": "कृपालुः शङ्करस्तुष्टः प्रसादं ते विधास्यति ।\nएवमुक्तस्तदामात्यैस्तुष्टाव वृषभध्वजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000551034, "chapter_id": 9551, "verse_number": "७-१६-३५", "content_sanskrit": "सामभिर्विविधैः स्तोत्रैः प्रणम्य स दशाननः ।\nसंवत्सरसहस्रं तु रुदतो रक्षसो गतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000551035, "chapter_id": 9551, "verse_number": "७-१६-३६", "content_sanskrit": "ततः प्रीतो महादेवः शैलाग्रे विष्ठितः प्रभुः ।\nमुक्त्वा चास्य भुजान्राम प्राह वाक्यं दशाननम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000551036, "chapter_id": 9551, "verse_number": "७-१६-३७", "content_sanskrit": "प्रीतो ऽस्मि तव वीर्यस्य शौण्डार्याच्च दशानन ।\nशैलाक्रान्तेन यो मुक्तस्त्वया रावः सुदारुणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000551037, "chapter_id": 9551, "verse_number": "७-१६-३८", "content_sanskrit": "यस्माल्लोकत्रयं चैतद्रावितं भयमागतम् ।\nतस्मात्त्वं रावणो नाम नाम्ना राजन्भविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000551038, "chapter_id": 9551, "verse_number": "७-१६-३९", "content_sanskrit": "देवता मानुषा यक्षा ये चान्ये जगतीतले ।\nएवं त्वामभिधास्यन्ति रावणं लोकरावणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000551039, "chapter_id": 9551, "verse_number": "७-१६-४०", "content_sanskrit": "गच्छ पौलस्त्य विस्रब्धं पथा येन त्वमिच्छसि ।\nमया चैवाभ्यनुज्ञातो राक्षसाधिप गम्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000551040, "chapter_id": 9551, "verse_number": "७-१६-४१", "content_sanskrit": "एवमुक्तस्तु लङ्केशः शम्भुना स्वयमब्रवीत् ।\nप्रीतो यदि महादेव वरं मे देहि याचतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000551041, "chapter_id": 9551, "verse_number": "७-१६-४२", "content_sanskrit": "अवध्यत्वं मया प्राप्तं देवगन्धर्वदानवैः ।\nराक्षसैर्गुह्यकैर्नागैर्ये चान्ये बलवत्तराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000551042, "chapter_id": 9551, "verse_number": "७-१६-४३", "content_sanskrit": "मानुषान्न गणे देव स्वल्पास्ते मम सम्मताः ।\nदीर्घमायुश्च मे प्राप्तं ब्रह्मणस्त्रिपुरान्तक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000551043, "chapter_id": 9551, "verse_number": "७-१६-४४", "content_sanskrit": "वाञ्छितं चायुषः शेषं शस्त्रं त्वं च प्रयच्छ मे ।\nएवमुक्तस्ततस्तेन रावणेन स शङ्करः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000551044, "chapter_id": 9551, "verse_number": "७-१६-४५", "content_sanskrit": "ददौ खड्गं महादीप्तं चन्द्रहासमिति श्रुतम् ।\nआयुषश्चावशेषं च स्थित्वा भूतपतिस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000551045, "chapter_id": 9551, "verse_number": "७-१६-४६", "content_sanskrit": "दत्त्वोवाच ततः शम्भुर्नावज्ञेयमिदं त्वया ।\nअवज्ञातं यदि हि ते मामेवैष्यत्यसंशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000551046, "chapter_id": 9551, "verse_number": "७-१६-४७", "content_sanskrit": "एवं महेश्वरेणैव कृतनामा स रावणः ।\nअभिवाद्य महादेवमारुरोहाथ पुष्पकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000551047, "chapter_id": 9551, "verse_number": "७-१६-४८", "content_sanskrit": "ततो महीतले राम पर्यक्रामत रावणः ।\nक्षत्ऺित्रयान्सुमहावीर्यान्बाधमान इतस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000551048, "chapter_id": 9551, "verse_number": "७-१६-४९", "content_sanskrit": "केचित्तेजस्विनः शूराः क्षत्ऺित्रया युद्धदुर्मदाः ।\nतच्छासनमकुर्वन्तो विनेशुः सपरिच्छदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000551049, "chapter_id": 9551, "verse_number": "७-१६-५०", "content_sanskrit": "अपरे दुर्जयं रक्षो जानन्तः प्राज्ञसम्मताः ।\nजिताः स्म इत्यभाषन्त राक्षसं बलदर्पितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000551050, "chapter_id": 9551, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे षोडशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]