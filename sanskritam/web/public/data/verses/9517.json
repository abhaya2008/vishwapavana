[{"id": 5000517000, "chapter_id": 9517, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे दशाधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000517001, "chapter_id": 9517, "verse_number": "६-११०-१", "content_sanskrit": "रावणं निहतं श्रुत्वा राघवेण महात्मना।\nअन्तःपुराद् विनिष्पेतू राक्षस्यः शोककर्शिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000517002, "chapter_id": 9517, "verse_number": "६-११०-२", "content_sanskrit": "वार्यमाणाः सुबहुशो वेष्टन्त्यः क्षितिपांसुषु।\nविमुक्तकेश्यः शोकार्ता गावो वत्सहता इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000517003, "chapter_id": 9517, "verse_number": "६-११०-३", "content_sanskrit": "उत्तरेण विनिष्क्रम्य द्वारेण सह राक्षसैः।\nप्रविश्यायोधनं घोरं विचिन्वन्त्यो हतं पतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000517004, "chapter_id": 9517, "verse_number": "६-११०-४", "content_sanskrit": "आर्यपुत्रेति वादिन्यो हा नाथेति च सर्वशः।\nपरिपेतुः कबन्धाङ्कां महीं शोणितकर्दमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000517005, "chapter_id": 9517, "verse_number": "६-११०-५", "content_sanskrit": "ता बाष्पपरिपूर्णाक्ष्यो भर्तृशोकपराजिताः।\nकरिण्य इव नर्दन्त्यः करेण्वो हतयूथपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000517006, "chapter_id": 9517, "verse_number": "६-११०-६", "content_sanskrit": "ददृशुस्ता महाकायं महावीर्यं महाद्युतिम्।\nरावणं निहतं भूमौ नीलाञ्जनचयोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000517007, "chapter_id": 9517, "verse_number": "६-११०-७", "content_sanskrit": "ताः पतिं सहसा दृष्ट्वा शयानं रणपांसुषु।\nनिपेतुस्तस्य गात्रेषु च्छिन्ना वनलता इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000517008, "chapter_id": 9517, "verse_number": "६-११०-८", "content_sanskrit": "बहुमानात् परिष्वज्य काचिदेनं रुरोद ह।\nचरणौ काचिदालम्ब्य काचित् कण्ठेऽवलम्ब्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000517009, "chapter_id": 9517, "verse_number": "६-११०-९", "content_sanskrit": "उत्क्षिप्य च भुजौ काचिद् भूमौ सुपरिवर्तते।\nहतस्य वदनं दृष्ट्वा काचिन्मोहमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000517010, "chapter_id": 9517, "verse_number": "६-११०-१०", "content_sanskrit": "काचिदङ्के शिरः कृत्वा रुरोद मुखमीक्षती।\nस्नापयन्ती मुखं बाष्पैस्तुषारैरिव पङ्कजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000517011, "chapter_id": 9517, "verse_number": "६-११०-११", "content_sanskrit": "एवमार्ताः पतिं दृष्ट्वा रावणं निहतं भुवि।\nचुक्रुशुर्बहुधा शोकाद् भूयस्ताः पर्यदेवयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000517012, "chapter_id": 9517, "verse_number": "६-११०-१२", "content_sanskrit": "येन वित्रासितः शक्रो येन वित्रासितो यमः।\nयेन वैश्रवणो राजा पुष्पकेण वियोजितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000517013, "chapter_id": 9517, "verse_number": "६-११०-१३", "content_sanskrit": "गन्धर्वाणामृषीणां च सुराणां च महात्मनाम्।\nभयं येन रणे दत्तं सोऽयं शेते रणे हतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000517014, "chapter_id": 9517, "verse_number": "६-११०-१४", "content_sanskrit": "असुरेभ्यः सुरेभ्यो वा पन्नगेभ्योऽपि वा तथा।\nभयं यो न विजानाति तस्येदं मानुषाद् भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000517015, "chapter_id": 9517, "verse_number": "६-११०-१५", "content_sanskrit": "अवध्यो देवतानां यस्तथा दानवरक्षसाम्।\nहतः सोऽयं रणे शेते मानुषेण पदातिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000517016, "chapter_id": 9517, "verse_number": "६-११०-१६", "content_sanskrit": "यो न शक्यः सुरैर्हन्तुं न यक्षैर्नासुरैस्तथा।\nसोऽयं कश्चिदिवासत्त्वो मृत्युं मर्त्येन लम्भितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000517017, "chapter_id": 9517, "verse_number": "६-११०-१७", "content_sanskrit": "एवं वदन्त्यो रुरुदुस्तस्य ता दुःखिताः स्त्रियः।\nभूय एव च दुःखार्ता विलेपुश्च पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000517018, "chapter_id": 9517, "verse_number": "६-११०-१८", "content_sanskrit": "अशृण्वता तु सुहृदां सततं हितवादिनाम्।\nमरणायाहृता सीता राक्षसाश्च निपातिताः।\nएताः सममिदानीं ते वयमात्मा च पातितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000517019, "chapter_id": 9517, "verse_number": "६-११०-१९", "content_sanskrit": "ब्रुवाणोऽपि हितं वाक्यमिष्टो भ्राता विभीषणः।\nदृष्टं परुषितो मोहात् त्वयाऽऽत्मवधकांक्षिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000517020, "chapter_id": 9517, "verse_number": "६-११०-२०", "content_sanskrit": "यदि निर्यातिता ते स्यात् सीता रामाय मैथिली।\nन नः स्याद् व्यसनं घोरमिदं मूलहरं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000517021, "chapter_id": 9517, "verse_number": "६-११०-२१", "content_sanskrit": "वृत्तकामो भवेद् भ्राता रामो मित्रकुलं भवेत्।\nवयं चाविधवाः सर्वाः सकामा न च शत्रवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000517022, "chapter_id": 9517, "verse_number": "६-११०-२२", "content_sanskrit": "त्वया पुनर्नृशंसेन सीतां संरुन्धता बलात्।\nराक्षसा वयमात्मा च त्रयं तुल्यं निपातितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000517023, "chapter_id": 9517, "verse_number": "६-११०-२३", "content_sanskrit": "न कामकारः कामं वा तव राक्षसपुंगव।\nदैवं चेष्टयते सर्वं हतं दैवेन हन्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000517024, "chapter_id": 9517, "verse_number": "६-११०-२४", "content_sanskrit": "वानराणां विनाशोऽयं राक्षसानां च ते रणे।\nतव चैव महाबाहो दैवयोगादुपागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000517025, "chapter_id": 9517, "verse_number": "६-११०-२५", "content_sanskrit": "नैवार्थेन च कामेन विक्रमेण न चाज्ञया।\nशक्या दैवगतिर्लोके निवर्तयितुमुद्यता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000517026, "chapter_id": 9517, "verse_number": "६-११०-२६", "content_sanskrit": "विलेपुरेवं दीनास्ता राक्षसाधिपयोषितः।\nकुरर्य इव दुःखार्ता बाष्पपर्याकुलेक्षणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000517027, "chapter_id": 9517, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे दशाधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]