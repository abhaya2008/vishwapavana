[{"id": 2079184, "chapter_id": 2686, "verse_number": "१२-१९१-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2079185, "chapter_id": 2686, "verse_number": "१२-१९१-१", "content_sanskrit": "आचारस्य विधिं तात प्रोच्यमानं त्वयाऽनघ।\nश्रोतुमिच्छामि धर्मज्ञ सर्वज्ञो ह्यसि मे मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2079186, "chapter_id": 2686, "verse_number": "१२-१९१-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2079187, "chapter_id": 2686, "verse_number": "१२-१९१-२", "content_sanskrit": "दुराचारा दुर्विचेष्टा दुष्प्रज्ञाः प्रियसाहसाः।\nअसन्तस्त्वभिविख्याताः सन्तश्चाचारलक्षणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2079188, "chapter_id": 2686, "verse_number": "१२-१९१-३", "content_sanskrit": "पुरीषं यदि वा मूत्रं ये न कुवन्ति मानवाः।\nराजमार्गे गवां मध्ये धान्यमध्ये शिवालये।\nअग्न्यगारे तथा तीरे ये न कुर्वन्ति ते शुभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2079189, "chapter_id": 2686, "verse_number": "१२-१९१-४", "content_sanskrit": "शौचमावश्यकं कृत्वा देवतानां च तर्पणम्।\nधर्ममाहुर्मनुष्याणामुपस्पृश्य नदीं तरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2079190, "chapter_id": 2686, "verse_number": "१२-१९१-५", "content_sanskrit": "सूर्यं सदोपतिष्ठेन न स्वपेद्भास्करोदये।\nसायंप्रातर्जपेत्सन्ध्यां तिष्ठन्पूर्वां तथेतराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2079191, "chapter_id": 2686, "verse_number": "१२-१९१-६", "content_sanskrit": "पञ्चार्द्रो भोजनं भुञ्ज्यात्प्राद्भुखो मौनमास्थितः।\nन निन्द्यादन्नभक्ष्यांश्च स्वादुस्वादु च भक्षयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2079192, "chapter_id": 2686, "verse_number": "१२-१९१-७", "content_sanskrit": "नार्द्रपाणिः समुत्तिष्ठेन्नार्द्रपादः स्वपेन्निशि।\nदेवर्षिर्नारदः प्राह एतदाचारलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2079193, "chapter_id": 2686, "verse_number": "१२-१९१-८", "content_sanskrit": "शोचिष्केशमनड्वाहं देवगोष्ठं चतुष्पथम्।\nब्राह्मणं धार्मिकं चैव नित्यं कुर्यात्प्रदक्षिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2079194, "chapter_id": 2686, "verse_number": "१२-१९१-९", "content_sanskrit": "अतिथीनां च सर्वेषां प्रेष्याणां स्वजनस्य च।\nसामात्यं भोजनं भृत्यैः पुरुषस्य प्रशस्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2079195, "chapter_id": 2686, "verse_number": "१२-१९१-१०", "content_sanskrit": "सायंप्रातर्मनुष्याणामशनं वेदनिर्मितम्।\nनान्तरा भोजनं दृष्टमुपवासी तथा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2079196, "chapter_id": 2686, "verse_number": "१२-१९१-११", "content_sanskrit": "होमकाले तथ्ना जुह्वन्नृतुकाले तथा व्रजन्।\nअनन्यस्त्रीजनः प्राज्ञो ब्रह्मचारी तथा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2079197, "chapter_id": 2686, "verse_number": "१२-१९१-१२", "content_sanskrit": "अमृतं ब्राह्मणोच्छिष्टं जनन्या हृदयं कृतम्।\nतज्जनाः पर्युपासन्ते सत्यं सन्तः समासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2079198, "chapter_id": 2686, "verse_number": "१२-१९१-१३", "content_sanskrit": "लोष्टमदीं तृणच्छेदी नखखादी तु यो नरः।\nनित्योच्छिष्टः संकसुको नेहायुर्विन्दते महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2079199, "chapter_id": 2686, "verse_number": "१२-१९१-१४", "content_sanskrit": "यजुषा संस्कृतं मांसं निवृत्तो मांसभक्षणात्।\nभक्षयेन्न वृथामांसं पृष्ठमांसं च वर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2079200, "chapter_id": 2686, "verse_number": "१२-१९१-१५", "content_sanskrit": "स्वदेशे परदेशे वा अतिर्थि नोपवासयेत्।\nकाम्यकर्मफलं लब्ध्वा गुरूणामुपपादयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2079201, "chapter_id": 2686, "verse_number": "१२-१९१-१६", "content_sanskrit": "गुरूणामासनं देयं कर्तव्यं चाभिवादनम्।\nगुरूनभ्यर्च्य युज्येत आयुषा यशसा श्रिया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2079202, "chapter_id": 2686, "verse_number": "१२-१९१-१७", "content_sanskrit": "नेक्षेतादित्यमुद्यन्तं न च नग्नां परस्त्रियम्।\nमैथुनं सततं धर्म्यं गुह्ये चैव समाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2079203, "chapter_id": 2686, "verse_number": "१२-१९१-१८", "content_sanskrit": "तीर्थानां हृदयं तीर्थं शुचीनां हृदयं शुचिः।\nसर्वमार्यकृतं धर्म्यं वालसंस्पर्शनानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2079204, "chapter_id": 2686, "verse_number": "१२-१९१-१९", "content_sanskrit": "दर्शनेदर्शने नित्यं सुखप्रश्नमुदाहरेत्।\nसायं प्रातश्च विप्राणां प्रदिष्टमभिवादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2079205, "chapter_id": 2686, "verse_number": "१२-१९१-२०", "content_sanskrit": "देवगोष्ठे गवां मध्ये ब्राह्मणानां क्रियापथे।\nस्वाध्याये भोजने चैव दक्षिणं पाणिमुद्धरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2079206, "chapter_id": 2686, "verse_number": "१२-१९१-२१", "content_sanskrit": "सायं प्रातश्च विप्राणां पूजनं च यथाविधि।\nपण्यानां शोभते पण्यं कृषीणामृद्ध्यतां कृषिः।\nबहुकारं च सस्यानां वाह्ये वाहो गवां तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2079207, "chapter_id": 2686, "verse_number": "१२-१९१-२२", "content_sanskrit": "संपन्नं भोजने नित्यं पानीये तर्पणं तथा।\nसुशृतं पायसे ब्रूयाद्यवाग्वां कृसरे तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2079208, "chapter_id": 2686, "verse_number": "१२-१९१-२३", "content_sanskrit": "श्मश्रुकर्मणि संप्राप्ते क्षुते स्नानेऽथ भोजने।\nव्याधितानां च सर्वेषामायुष्ममभिनन्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2079209, "chapter_id": 2686, "verse_number": "१२-१९१-२४", "content_sanskrit": "प्रत्यादित्यं न मेहेत न पश्येदात्मनः शकृत्।\nसुतैः स्त्रिया च शयनं सह भोज्यं च वर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2079210, "chapter_id": 2686, "verse_number": "१२-१९१-२५", "content_sanskrit": "त्वंकारं नामधेयं च ज्येष्ठानां परिवर्जयेत्।\nअवराणां समानानामुभयं नैव दुष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2079211, "chapter_id": 2686, "verse_number": "१२-१९१-२६", "content_sanskrit": "हृदयं पापवृत्तानां पापमाख्याति वैकृतम्।\nज्ञानपूर्वं विनश्यन्ति गूहमाना महाजने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2079212, "chapter_id": 2686, "verse_number": "१२-१९१-२७", "content_sanskrit": "ज्ञानपूर्वकृतं पापं छादयन्त्यबहुश्रुताः।\nनैनं मनुष्याः पश्यन्ति पश्यन्त्येव दिवौकसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2079213, "chapter_id": 2686, "verse_number": "१२-१९१-२८", "content_sanskrit": "पापेनापिहितं पापं पापमेवानुवर्तते।\nधर्मेणापिहितो धर्मो धर्ममेवानुवर्तते।\nधार्मिकेण कृतो धर्मो धर्ममेवानुवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2079214, "chapter_id": 2686, "verse_number": "१२-१९१-२९", "content_sanskrit": "पापं कृतं न स्मरतीह मूढो\nविवर्तमानस्य तदेति कर्तुः।\nराहुर्यथा चन्द्रमुपैति चापि\nतथाऽबुधं पापमुपैति कर्म॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2079215, "chapter_id": 2686, "verse_number": "१२-१९१-३०", "content_sanskrit": "आशया संचितं द्रव्यं दुःखेनैवोपभुज्यते।\nतद्बुधा न प्रशंसन्ति मरणं न प्रतीक्षते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2079216, "chapter_id": 2686, "verse_number": "१२-१९१-३१", "content_sanskrit": "मानसं सर्वभूतानां धर्ममाहुर्मनीषिणः।\nतस्मात्सर्वेषु भूतेषु मनसा शिवमाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2079217, "chapter_id": 2686, "verse_number": "१२-१९१-३२", "content_sanskrit": "एक एव चरेद्धर्मं नास्ति धर्मे सहायता।\nकेवलं विधिमासाद्य सहायः किं करिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2079218, "chapter_id": 2686, "verse_number": "१२-१९१-३३", "content_sanskrit": "धर्मो योनिर्मनुष्याणां देवानाममृतं दिवि।\nप्रेत्यभावे सुखं धर्माच्न्छश्वत्तैरुपभुज्यते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2079219, "chapter_id": 2686, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि एकनवत्यधिकशततमोऽध्यायः॥ १९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]