[{"id": 7005909000, "chapter_id": 25909, "verse_number": "१-९२-१", "content_sanskrit": "रुद्रउवाच ।\nविष्णोर्ध्यानं पुनर्ब्रूहि शङ्खचक्रगदाध।\nयेन विज्ञातमात्रेण कृतकृत्यो भवेन्नरः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005909001, "chapter_id": 25909, "verse_number": "१-९२-२", "content_sanskrit": "हरिरुवाच ।\nप्रवक्ष्यामि हरेर्ध्यानं मायातन्त्रविमर्दकम।\nमूर्त्तामूर्तादिभेदेन तद्ध्यानं द्विविधं हर ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005909002, "chapter_id": 25909, "verse_number": "१-९२-३", "content_sanskrit": "अमूर्त्तं रुद्र कथितं हन्त मूर्त्तं ब्वीम्यहम्।\nसूर्य्यकोटिप्रतीकाशो जिष्णुर्भाजिष्णुरेकतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005909003, "chapter_id": 25909, "verse_number": "१-९२-४", "content_sanskrit": "कुन्दगोक्षीरधवलो हरिर्ध्येयो मुमुक्षुभिः ।\nविशालेन सुसौम्येन शङ्खेन च समन्वितः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005909004, "chapter_id": 25909, "verse_number": "१-९२-५", "content_sanskrit": "सहस्त्रादित्यतुल्येन ज्वालामालोग्ररूपिणा ।\nचक्रेण चान्वितः शान्तो गदाहस्तः शुभाननः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005909005, "chapter_id": 25909, "verse_number": "१-९२-६", "content_sanskrit": "किरीटेन महार्हेण रत्नप्रज्वलितेन ।\nसायुधः सर्वगो देवः सरोरुहधरस्तथा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005909006, "chapter_id": 25909, "verse_number": "१-९२-७", "content_sanskrit": "वनमालाधरः शुभ्रः समांसो हेमभूषणः ।\nसुवस्त्रः शुद्धदेहश्च सुकर्णः पद्मसंस्थितः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005909007, "chapter_id": 25909, "verse_number": "१-९२-८", "content_sanskrit": "हिरण्मयशरीरश्च चारुहारी शुभाङ्गदः।\nकेयूरेण समायुक्तो वनमालासमन्वितः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005909008, "chapter_id": 25909, "verse_number": "१-९२-९", "content_sanskrit": "श्रीवत्सकौस्तुभयुतो लक्ष्मीवन्द्येक्णान्वितः।\nअणिमादिगुणैर्युक्तः सृष्टिसंहारकारकः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005909009, "chapter_id": 25909, "verse_number": "१-९२-१०", "content_sanskrit": "मुनिध्येयोऽसुरध्येयो देवध्येयोऽतिसुन्दरः ।\nब्रह्मादिस्तम्बपर्य्यन्तभूतजातहृदिस्थितः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005909010, "chapter_id": 25909, "verse_number": "१-९२-११", "content_sanskrit": "सनातनोऽव्ययो मेध्यः सर्वानुग्रहकृत्पभुः।\nनारायणो महादेवः स्फुरन्मकरकुण्डलः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005909011, "chapter_id": 25909, "verse_number": "१-९२-१२", "content_sanskrit": "सन्तापनाशनोऽभ्यर्च्यो मङ्गल्यो दुष्टनाशनः ।\nसर्वात्मा सर्वरूपश्च सर्वगो ग्रहनाशनः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005909012, "chapter_id": 25909, "verse_number": "१-९२-१३", "content_sanskrit": "चार्वङ्गुलीयसंयुक्तः सुदीप्तनख एव च ।\nशरण्यः सुखकारी च सौम्यरूपो महेश्वरः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005909013, "chapter_id": 25909, "verse_number": "१-९२-१४", "content_sanskrit": "सर्वालङ्कारसंयुक्तश्चारुचन्दनचर्चितः ।\nसर्वदेवसमायुक्तः सर्वदेवप्रियङ्करः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005909014, "chapter_id": 25909, "verse_number": "१-९२-१५", "content_sanskrit": "सर्वलोकहितैषी च सर्वेशः सर्वभावनः ।\nआदित्यमण्डले संस्थो अग्निस्थो वारिसंस्थितः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005909015, "chapter_id": 25909, "verse_number": "१-९२-१६", "content_sanskrit": "वासुदेवो जगद्धाता ध्येयो विष्णुर्मुमुक्षुभिः ।\nवासुदेवोऽहमस्मीति आत्मा ध्येयो हरिहरिः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005909016, "chapter_id": 25909, "verse_number": "१-९२-१७", "content_sanskrit": "ध्यायन्त्येवं च ये विष्णुं ते यान्ति परमां गतिम् ।\nयाज्ञवल्क्यः पुरा ह्येवं ध्यात्वा विष्णुं सुरेश्वरम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005909017, "chapter_id": 25909, "verse_number": "१-९२-१८", "content_sanskrit": "धर्मोपदेशकर्त्तृत्वं संप्राप्यागात्परं पदम् ।\nतस्मात्त्वमपि देवेश ! विष्णुं चिन्तय शङ्कर ! ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005909018, "chapter_id": 25909, "verse_number": "१-९२-१९", "content_sanskrit": "विष्णुध्यानं पठेद्यस्तु प्राप्नोति परमां गतिम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]