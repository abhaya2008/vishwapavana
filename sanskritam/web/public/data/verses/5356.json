[{"id": 2204393, "chapter_id": 5356, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2204394, "chapter_id": 5356, "verse_number": "१", "content_sanskrit": "भगवन् मानुषेष्वेव मानुषाः समदर्शनाः ।\nचण्डाला इव दृश्यन्ते स्पर्शमात्रेण दूषकाः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2204395, "chapter_id": 5356, "verse_number": "२", "content_sanskrit": "नीचकर्मरता देव सर्वेषां मलहारकाः ।\nदुर्गताः क्लेशभूयिष्ठा विरूपा दुष्टचेतसः ।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2204396, "chapter_id": 5356, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2204397, "chapter_id": 5356, "verse_number": "३", "content_sanskrit": "तदहं ते प्रवक्ष्यामि त्वमेकाग्रमनाः शृणु\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2204398, "chapter_id": 5356, "verse_number": "४", "content_sanskrit": "ये पुरा मनुजा घोरा अतिमानयुता भृशम् ।\nआत्मसम्भावनायुक्ताः स्तब्धा दर्पसमन्विताः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2204399, "chapter_id": 5356, "verse_number": "५", "content_sanskrit": "प्रणामं न तु कुर्वन्ति गुरूणामपि पामराः ।\nये स्वधर्माश्रितं कालमतिमानान्न कुर्वते\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2204400, "chapter_id": 5356, "verse_number": "६", "content_sanskrit": "परान् सन्नामयन्त्येव अज्ञानात्मनि ये बलात् ।\nऋद्धियोगात् परान् नित्यमवमन्यन्ति मानवान् ।\nपानपाः सर्वभक्षाश्च परुषाः कटुका नराः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2204401, "chapter_id": 5356, "verse_number": "७", "content_sanskrit": "एवंयुक्तसमाचारा दण्डिता यमशासनैः ।\nकथञ्चित् प्राप्य मानुष्यं चण्डालाः सम्भवन्ति ते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2204402, "chapter_id": 5356, "verse_number": "८", "content_sanskrit": "नीचकर्मरताश्चैव सर्वेषां मलहारकाः ।\nपरेषां वन्दनपरास्ते भवन्त्यवमानिताः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2204403, "chapter_id": 5356, "verse_number": "९", "content_sanskrit": "विरूपाः पापयोनिस्थाः स्पर्शनादपि वर्जिताः ।\nकुवृत्तिमुपजीवन्ति भूत्वा ते रजकादयः ।\nपुराऽतिमानदोषात् तु भुञ्जते स्वकृतं फलम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2204404, "chapter_id": 5356, "verse_number": "१०", "content_sanskrit": "नान्यव्यवस्थारूपाणां चण्डालानपि बुद्धिमान् ।\nन च निन्देन्नातिकुप्येद् भुञ्जते स्वकृतं फलम् ।\nचण्डाला अपि तां जातिं शोचन्तः शुद्धिमाप्नुयुः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2204405, "chapter_id": 5356, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2204406, "chapter_id": 5356, "verse_number": "११", "content_sanskrit": "भगवन् मानुषाः केचिदाशापाशशतैर्वृताः ।\nपरेषां द्वारि तिष्ठन्ति प्रतिषिद्धाः प्रवेशने\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2204407, "chapter_id": 5356, "verse_number": "१२", "content_sanskrit": "द्रष्टुं ज्ञापयितुं चैव न लभन्ते च यत्नतः ।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2204408, "chapter_id": 5356, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2204409, "chapter_id": 5356, "verse_number": "१३", "content_sanskrit": "ये पुरा मानुषा देवि ऐश्वर्यस्थानसंयुताः ।\nसंविदं तु न कुर्वन्ति परैरैश्वर्यमोहिताः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2204410, "chapter_id": 5356, "verse_number": "१४", "content_sanskrit": "द्वाराणि न ददत्येव लोभमोहादिभिर्वृताः ।\nअवस्थामोहसंयुक्ताः स्वार्थमात्रपरायणाः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2204411, "chapter_id": 5356, "verse_number": "१५", "content_sanskrit": "सर्वभोगयुता वाऽपि सर्वेषां निष्फला भृशम् ।\nअपि शक्ता न कुर्युस्ते परानुग्रहकारणात्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2204412, "chapter_id": 5356, "verse_number": "१६", "content_sanskrit": "निर्दयाश्चैव निर्द्वारा भोगैश्वर्यगतिं प्रति ।\nएवंयुक्तसमाचाराः पुनर्जन्मनि शोभने\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2204413, "chapter_id": 5356, "verse_number": "१७", "content_sanskrit": "यदि चेन्मानुषं जन्म लभेरंस्ते तथाविधाः ।\nदुर्गता दुरवस्थाश्च कर्मव्याक्षेपसंयुताः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2204414, "chapter_id": 5356, "verse_number": "१८", "content_sanskrit": "अभिधावन्ति ते सर्वे तमर्थमभिवेदिनः ।\nराज्ञां वा राजमात्राणां द्वारि तिष्ठन्ति वारिताः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2204415, "chapter_id": 5356, "verse_number": "१९", "content_sanskrit": "कर्म विज्ञापितुं द्रष्टुं न लभन्ते कथञ्चन ।\nप्रवेष्टुमपि ते द्वारं बहिस्तिष्ठन्ति काङ्क्षया\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2204416, "chapter_id": 5356, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2204417, "chapter_id": 5356, "verse_number": "२०", "content_sanskrit": "भगवन् मानुषाः केचिन्मनुष्येषु बहुष्वपि ।\nसहसा नष्टसर्वस्वा भ्रष्टकोशपरिग्रहाः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2204418, "chapter_id": 5356, "verse_number": "२१", "content_sanskrit": "दृश्यन्ते मानुषाः केचिद् राजचोरोदकादिभिः ।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2204419, "chapter_id": 5356, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2204420, "chapter_id": 5356, "verse_number": "२२", "content_sanskrit": "ये पुरा मानुषा देवि आसुरं भावमाश्रिताः ।\nपरेषां वृत्तिनाशं तु कुर्वते द्वेषलोभतः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2204421, "chapter_id": 5356, "verse_number": "२३", "content_sanskrit": "उत्कोचनपराश्चैव पिशुनाश्च तथाविधाः ।\nपरद्रव्यहरा घोराश्चौर्याद्वाऽन्येन कर्मणा\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2204422, "chapter_id": 5356, "verse_number": "२४", "content_sanskrit": "निर्दया निरनुक्रोशाः परेषां वृत्तिनाशकाः ।\nनास्तिकाऽनृतभूयिष्ठाः परद्रव्यापहारिणः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2204423, "chapter_id": 5356, "verse_number": "२५", "content_sanskrit": "एवंयुक्तसमाचारा दण्डिता यमशासनैः ।\nनिरयस्थाश्चिरं कालं तत्र दुःखसमन्विताः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2204424, "chapter_id": 5356, "verse_number": "२६", "content_sanskrit": "यदि चेन्मानुषं जन्म लभेरंस्ते तथाविधाः ।\nतत्रस्थाः प्राप्नुवन्त्येव सहसा द्रव्यनाशनम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2204425, "chapter_id": 5356, "verse_number": "२७", "content_sanskrit": "कष्टं च प्राप्नुवन्त्येव कारणाकारणादपि ।\nनाशं विनाशं द्रव्याणामुपघातांश्च सर्वशः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2204426, "chapter_id": 5356, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2204427, "chapter_id": 5356, "verse_number": "२८", "content_sanskrit": "भगवन् मानुषाः केचिद् बान्धवैः सहसा पृथक् ।\nकारणाकारणादेव सहसा प्राणनाशनम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2204428, "chapter_id": 5356, "verse_number": "२९", "content_sanskrit": "शस्त्रेण वाऽन्यथा वाऽपि प्राप्नुवन्ति वधं नराः ।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2204429, "chapter_id": 5356, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2204430, "chapter_id": 5356, "verse_number": "३०", "content_sanskrit": "ये पुरा मनुजा देवि घोरकर्मरता नराः ।\nआसुराः प्रायशो मूर्खाः प्राणिहिंसाप्रिया भृशम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2204431, "chapter_id": 5356, "verse_number": "३१", "content_sanskrit": "निर्दयाः प्राणिहिंसायां तथा प्राणविघातकाः ।\nविश्वस्तघातकाश्चैव तथा सुप्तविघातकाः ।\nप्रायशोऽनृतभूयिष्ठा नास्तिका मांसभोजिनः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2204432, "chapter_id": 5356, "verse_number": "३२", "content_sanskrit": "एवंयुक्तसमाचाराः कालधर्मं गताः पुनः ।\nदण्डिता यमदण्डेन निरयस्थाश्चिरं प्रिये\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2204433, "chapter_id": 5356, "verse_number": "३३", "content_sanskrit": "तिर्यग्योनिं पुनः प्राप्य तत्र दुःखपरिक्षयात् ।\nयदि चेन्मानुषं जन्म लभेरंस्ते तथाविधाः ।\nतत्र ते प्राप्नुवन्त्येव वधबन्धान् यथातथा\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2204434, "chapter_id": 5356, "verse_number": "३४", "content_sanskrit": "आढ्या वा दुर्गता वाऽपि भुञ्जते स्वकृतं फलम् ।\nसुप्ता मत्ताश्च विश्वस्तास्तथा ते प्राप्नुवन्त्युत\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2204435, "chapter_id": 5356, "verse_number": "३५", "content_sanskrit": "प्राणबाधकृतं दुःखं बान्धवैः सहसा पृथक् ।\nपुत्रदारविनाशं वा शस्त्रेणान्येन वा वधम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2204436, "chapter_id": 5356, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2204437, "chapter_id": 5356, "verse_number": "३६", "content_sanskrit": "भगवन् मानुषाः केचिद् राजभिर्नीतिकोविदैः ।\nदण्ड्यन्ते मानुषे लोके मानुषाः सततं भुवि ।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2204438, "chapter_id": 5356, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2204439, "chapter_id": 5356, "verse_number": "३७", "content_sanskrit": "ये पुरा मनुजा देवि मनुजांश्चेतरांश्च वा ।\nक्लिष्टघातेन निघ्नन्ति प्राणान् प्राणिषु निर्दयाः ।\nआसुरा घोरकर्माणः क्रूरदण्डवधप्रियाः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2204440, "chapter_id": 5356, "verse_number": "३८", "content_sanskrit": "ये दण्डयन्त्यदण्ड्यांस्तु राजानः कोपमोहिताः ।\nहिंसाविहाराः पुरुषा मांसादा नास्तिकाः शुभे\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2204441, "chapter_id": 5356, "verse_number": "३९", "content_sanskrit": "केचित् स्त्रीपुरुषघ्नाश्च गुरुघ्नाश्च तथा प्रिये ।\nएवंयुक्तसमाचाराः प्राणिधर्मगताः पुनः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2204442, "chapter_id": 5356, "verse_number": "४०", "content_sanskrit": "दण्डिता यमदण्डेन निरयस्थाश्चिरं प्रिये ।\nपूर्वदेहकृतं कर्म भुञ्जते तदिह प्रजाः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2204443, "chapter_id": 5356, "verse_number": "४१", "content_sanskrit": "इहैव यत् कृतं कर्म तत् परत्र फलत्युत ।\nएषा व्यवस्थितिर्देवि मानुषेष्वेव दृश्यते\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2204444, "chapter_id": 5356, "verse_number": "४२", "content_sanskrit": "न ऋषीणां न देवानाममृतत्वात् तपोबलात् ।\nतैरेकेन शरीरेण भुज्यते कर्मणः फलम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2204445, "chapter_id": 5356, "verse_number": "४३", "content_sanskrit": "न तथा मानुषाणां स्यादन्तर्धाय भवेद्धि तत्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2204446, "chapter_id": 5356, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2204447, "chapter_id": 5356, "verse_number": "४४", "content_sanskrit": "किमर्थं मानुषा लोके दण्ड्यन्ते पृथिवीश्वरैः ।\nकृतापराधमुद्दिश्य हन्ता हर्ताऽयमित्युत\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2204448, "chapter_id": 5356, "verse_number": "४५", "content_sanskrit": "पुत्रार्थी पुत्रकामेष्ट्या इहैव लभते सुतान् ।\nतैरेव हि शरीरेण भुञ्जानाः कर्मणां फलम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2204449, "chapter_id": 5356, "verse_number": "४६", "content_sanskrit": "दृश्यन्ते मानुषे लोके तद् भवाननुमन्यते ।\nएतन्मे संशयस्थानं तन्मे त्वं छेत्तुमर्हसि\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2204450, "chapter_id": 5356, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2204451, "chapter_id": 5356, "verse_number": "४७", "content_sanskrit": "स्थाने संशयितं देवि तत्त्वं शृणु समाहिता ।\nकर्म कर्मफलं चेति युगपद् भुवि नेष्यते\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2204452, "chapter_id": 5356, "verse_number": "४८", "content_sanskrit": "यत्त्वयाऽभिहितं देवि हन्ता हर्ताऽयमित्यपि ।\nतेषां तत् पूर्वकं कर्म दण्ड्यते यत्र राजभिः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2204453, "chapter_id": 5356, "verse_number": "४९", "content_sanskrit": "दैहिकं दुष्कृतं तेषां हेतुर्भवति शासने ।\nअपराधापदेशेन राजा दण्डयति प्रजाः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2204454, "chapter_id": 5356, "verse_number": "५०", "content_sanskrit": "इह लोके व्यवस्थार्थं राजभिर्दण्डनं स्मृतम् ।\nउद्वेजनार्थं शेषाणामपराधं तमुद्दिशन्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2204455, "chapter_id": 5356, "verse_number": "५१", "content_sanskrit": "पुराकृतफलं दण्डो दण्ड्यमानस्य तद् ध्रुवम् ।\nप्रागेव च मया प्रोक्तं तत्र निःसंशया भव\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2204456, "chapter_id": 5356, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2204457, "chapter_id": 5356, "verse_number": "५२", "content_sanskrit": "भगवन् भुवि मर्त्यानां दण्डितानां नरेश्वरैः ।\nदण्डेनैव तु तेनेह पापनाशो भवेन्न वा\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2204458, "chapter_id": 5356, "verse_number": "५३", "content_sanskrit": "एतन्मया संशयितं तद् भवांश्छेत्तुमर्हति\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2204459, "chapter_id": 5356, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2204460, "chapter_id": 5356, "verse_number": "५३", "content_sanskrit": "स्थाने संशयितं देवि शृणु तत्त्वं समाहिता\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2204461, "chapter_id": 5356, "verse_number": "५४", "content_sanskrit": "ये नृपैर्दण्डिता भूमावपराधापदेशतः ।\nयमलोके न दण्ड्यन्ते तत्र ते यमदण्डनैः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2204462, "chapter_id": 5356, "verse_number": "५५", "content_sanskrit": "अदण्डिता वा ये मिथ्या मर्त्या वा दण्डिता भुवि ।\nतान् यमो दण्डयत्येव स हि वेद कृताकृतम् ।\nनातिक्रमेद् यमं कश्चित् कर्म कृत्वेह मानुषः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2204463, "chapter_id": 5356, "verse_number": "५६", "content_sanskrit": "राजा यमश्च कुर्वाते दण्डमात्रं तु शोभने ।\nउभाभ्यां यमराजभ्यां दण्डितोऽदण्डितोऽपि वा ।\nपश्चात् कर्मफलं भुङ्क्ते नरके मानुषेषु वा\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2204464, "chapter_id": 5356, "verse_number": "५७", "content_sanskrit": "नास्ति कर्मफलच्छेत्ता कश्चिल्लोकत्रयेऽपि च ।\nइति ते कथितं सर्वं निर्विशङ्का भव प्रिये\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2204465, "chapter_id": 5356, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2204466, "chapter_id": 5356, "verse_number": "५८", "content_sanskrit": "किमर्थं दुष्कृतं कृत्वा मानुषा भुवि नित्यशः ।\nपुनस्तत्कर्मनाशाय प्रायश्चित्तानि कुर्वते\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2204467, "chapter_id": 5356, "verse_number": "५९", "content_sanskrit": "सर्वपापहरं चेति हयमेधं वदन्ति च ।\nप्रायश्चित्तानि चान्यानि पापनाशाय कुर्वते ।\nतस्मान्मे संशयो जातस्त्वं तं च्छेत्तुमिहार्हसि\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2204468, "chapter_id": 5356, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2204469, "chapter_id": 5356, "verse_number": "६०", "content_sanskrit": "स्थाने संशयितं देवि शृणु तत्त्वं समाहिता ।\nसंशयो हि महानेव पूर्वेषां च मनीषिणाम्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2204470, "chapter_id": 5356, "verse_number": "६१", "content_sanskrit": "द्विधा तु क्रियते पापं सद्भिश्चासद्भिरेव च ।\nअभिसन्धाय वा नित्यमन्यथा वा यदृच्छया\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2204471, "chapter_id": 5356, "verse_number": "६२", "content_sanskrit": "केवलं चाभिसन्धाय संरम्भाच्च करोति यत् ।\nकर्मणस्तस्य नाशस्तु न कथञ्चन विद्यते\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2204472, "chapter_id": 5356, "verse_number": "६३", "content_sanskrit": "अभिसन्धिकृतस्येह नैव नाशोऽस्ति कर्मणः ।\nअश्वमेधसहस्रैर्वा प्रायश्चित्तशतैरपि\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2204473, "chapter_id": 5356, "verse_number": "६४", "content_sanskrit": "अन्यथा यत् कृतं पापं प्रमादाद्वा यदृच्छया ।\nप्रायश्चित्ताश्वमेधाभ्यां शोधनात् तु प्रणश्यति\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2204474, "chapter_id": 5356, "verse_number": "६५", "content_sanskrit": "लोकसंव्यवहारार्थं प्रायश्चित्तादिरिष्यते ।\nविद्ध्येवं पापके कार्ये निर्विशङ्का भव प्रिये\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2204475, "chapter_id": 5356, "verse_number": "समाप्तिः", "content_sanskrit": "इति ते कथितं देवि भूयः श्रोतुं किमिच्छसि\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2204476, "chapter_id": 5356, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2204477, "chapter_id": 5356, "verse_number": "६७", "content_sanskrit": "भगवन् देवदेवेश मानुषाश्चेतरा अपि ।\nम्रियन्ते बहुधा लोके कारणाकारणादपि ।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2204478, "chapter_id": 5356, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2204479, "chapter_id": 5356, "verse_number": "६८", "content_sanskrit": "ये पुरा मनुजा देवि कारणाकारणादपि ।\nयथाऽसुभिर्वियोज्यन्ते प्राणिनः प्राणिनिर्दयैः\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2204480, "chapter_id": 5356, "verse_number": "६९", "content_sanskrit": "तथैव ते प्राप्नुवन्ति यथैवात्मकृतं फलम् ।\nविषदस्तु विषेणैव शस्त्रैः शस्त्रेण घातकाः\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2204481, "chapter_id": 5356, "verse_number": "७०", "content_sanskrit": "एवमेव यथा लोके मानुषान् घ्नन्ति मानुषाः ।\nकारणेनैव ते तेन तथा स्वप्राणनाशनम् ।\nप्राप्नुवन्ति पुनर्देवि नास्ति तत्र विचारणा\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2204482, "chapter_id": 5356, "verse_number": "समाप्तिः", "content_sanskrit": "इति ते कथितं सर्वं पापकर्मफलं प्रिये ।\nभूयस्तव समासेन कथयिष्यामि तच्छृणु\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2204483, "chapter_id": 5356, "verse_number": "७२", "content_sanskrit": "सत्यं प्रमाणकरणं नित्यमव्यभिचारि च ।\nयैः पुरा मनुजैर्देवि यस्मिन् काले यथा कृतम्\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2204484, "chapter_id": 5356, "verse_number": "७३", "content_sanskrit": "येनैव कारणेनापि कर्म यत्तु शुभाशुभम् ।\nकर्मणः फलमात्रं तु तेनैव कारणेन तु\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2204485, "chapter_id": 5356, "verse_number": "७४", "content_sanskrit": "प्राप्नुवन्ति नराः प्रेत्य निःसन्देहं शुभाशुभम् ।\nइति सत्यं विजानीहि लोकतन्त्रविधिं प्रति\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2204486, "chapter_id": 5356, "verse_number": "७५", "content_sanskrit": "कर्म कृत्वा नरोऽभोक्ता स नास्ति दिवि वा भुवि ।\nग्रहीतुं च न शक्यं हि सदेवासुरमानुषैः\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2204487, "chapter_id": 5356, "verse_number": "७६", "content_sanskrit": "कर्मणा ग्रथितो लोक आदिप्रभृति वर्तते ।\nएतदुद्देशतः प्रोक्तं कर्मपाकफलं प्रिये\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2204488, "chapter_id": 5356, "verse_number": "७७", "content_sanskrit": "यदन्यच्च मया नोक्तं यस्मिंस्ते कर्मसङ्ग्रहे ।\nबुद्धितर्केण तत्सर्वं तथा वेदितुमर्हसि ।\nकथितं श्रोतुकामाया भूयः श्रोतुं किमिच्छसि\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2204489, "chapter_id": 5356, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nअनुशासनपर्वणि दानधर्मे उमामहेश्वरसंवादे चण्डालादियोन्यादिप्राप्तिनिमित्तकथनं नाम सप्ताधिकद्विशततमोऽध्यायः ॥२०७॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}]