[{"id": 7001037000, "chapter_id": 21037, "verse_number": "५-१९-१", "content_sanskrit": "एवमन्तर्जले विष्णुमभिष्टूय स यादवः ।\nअर्ज्जयामास सर्व्वेशं पुष्पैर्धूपैर्मनोरमैः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001037001, "chapter_id": 21037, "verse_number": "५-१९-२", "content_sanskrit": "परित्यक्तान्यविषयो मनस्तत्र निवेश्य सः ।\nब्रह्मभूते चिरं स्थित्वा विरराम समाधितः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001037002, "chapter_id": 21037, "verse_number": "५-१९-३", "content_sanskrit": "कृतकृत्यमिवात्मानं मन्यमानो महामतिः ।\nआजगाम रथं भूयो निगम्य यमुनाम्भसः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001037003, "chapter_id": 21037, "verse_number": "५-१९-४", "content_sanskrit": "राम-कृष्णौ च ददृशे यथापूर्व्वं रथे स्थितौ ।\nविस्मिताक्षस्तदाक्रू रस्तञ्च कृष्णोऽभ्यभाषत ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001037004, "chapter_id": 21037, "verse_number": "५-१९-५", "content_sanskrit": "नूनं ते दृष्टमाश्वर्य्यमक्रूर!यमुनाजले ।\nविस्मयोतूफूल्लनयनो भवान् संलक्ष्यते यतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001037005, "chapter_id": 21037, "verse_number": "५-१९-६", "content_sanskrit": "अन्तर्जले यदाश्वर्य्यं दृष्टं तत्र मयाच्युत!\nतदत्रापि हि पश्यामि मूत्तिंमत् पुरतः स्थितम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001037006, "chapter_id": 21037, "verse_number": "५-१९-७", "content_sanskrit": "जगदेतन्महाश्वर्य्य रूपं यस्य महात्मनः ।\nतेनाश्वर्य्यवरेणाहं भवता कृष्ण!सङ्गतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001037007, "chapter_id": 21037, "verse_number": "५-१९-८", "content_sanskrit": "तत् किमेतेन मथुरां व्रजामो मधुसूदन!\nबिभेमि कंसाद्धिग् जन्म परपिण्डोपजीविनाम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001037008, "chapter_id": 21037, "verse_number": "५-१९-९", "content_sanskrit": "इत्युक्त्वा चोदयामास तान् हयान् वातरंहसः ।\nसम्प्राप्तश्वातिसायाह्र सोऽक्रूरो मथुरां पुरीम्‌ ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001037009, "chapter_id": 21037, "verse_number": "५-१९-१०", "content_sanskrit": "विलोक्य मथुरां कृष्णं रामञ्चाह स यादवः ।\nपद्भयां यातं महावीर्य्यो रथेनैको विशाम्यहम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001037010, "chapter_id": 21037, "verse_number": "५-१९-११", "content_sanskrit": "गन्तव्यं वसुदेवस्य भवद्भयां न तथा गृहम् ।\nयुवयोर्हि कृते वृद्धः स कंसेन निरस्यते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001037011, "chapter_id": 21037, "verse_number": "५-१९-१२", "content_sanskrit": "इत्युत्तवा प्रविवेशाथ सोऽकूरो मथुरां पुरीम् ।\nप्रिवष्टौ रामकृष्णौ, च राजमार्गमुपागतौ ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001037012, "chapter_id": 21037, "verse_number": "५-१९-१३", "content_sanskrit": "स्त्रीभिर्नरैश्व सानन्दं लोचनैरभिवीक्षितौ ।\nजग्मतुलीलया वीरौ दृफ्तौ बालगजाविव ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001037013, "chapter_id": 21037, "verse_number": "५-१९-१४", "content_sanskrit": "भ्रममाणौ तु तौ दृष्ट्वा रजकं रङ्गकारकम् ।\nअयाचेतां सुरूपाणि वासांसि रुचिराननौ ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001037014, "chapter_id": 21037, "verse_number": "५-१९-१५", "content_sanskrit": "कंसस्य रजकः सोऽथ प्रसादारूढ़विस्मयः ।\nबहून्याक्षेपवाक्यानि प्राहोच्चै राम-केशवौ ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001037015, "chapter_id": 21037, "verse_number": "५-१९-१६", "content_sanskrit": "ततस्तलप्रहारेण कृष्णस्तस्य दुरात्मनः ।\nपातयामास कापेन रजकस्य शिरो भुवि ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001037016, "chapter_id": 21037, "verse_number": "५-१९-१७", "content_sanskrit": "हत्वादाय च वस्त्राणि पीतनीलाम्बरौ ततः ।\nकृष्ण-रामौ मुदा युक्तौ मालाकारगृहं गतौ ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001037017, "chapter_id": 21037, "verse_number": "५-१९-१८", "content_sanskrit": "विकाशिनेत्रयुगलौ मालाकारोऽतिविस्मितः ।\nएतौ कस्य कुतो वैतौ मैत्रेयाचिन्तयत् तदा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001037018, "chapter_id": 21037, "verse_number": "५-१९-१९", "content_sanskrit": "पीतनीलाम्बरधरौ तौ दृष्ट्वातिमनोहरौ ।\nस तर्कयामास तदा भुवं देवावुपागतौ ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001037019, "chapter_id": 21037, "verse_number": "५-१९-२०", "content_sanskrit": "विकाशिमुखपद्माभ्यां ताभ्यां पुष्पाणि याचितः ।\nभुवं विष्टभ्य हस्ताभ्यां पस्पर्श शिरसा महीम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001037020, "chapter_id": 21037, "verse_number": "५-१९-२१", "content_sanskrit": "प्रसादपरमौ नाथौ मम गेहमुपागतौ ।\nधन्योऽहमर्ज्जयिष्यामीत्याह तौ माल्यजीवकः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001037021, "chapter_id": 21037, "verse_number": "५-१९-२२", "content_sanskrit": "ततः प्रह्टश्टवदनस्तयोः पुष्पाणि कामतः ।\nचारूण्येतान्यथैतानि प्रददौ स विलोभयन ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001037022, "chapter_id": 21037, "verse_number": "५-१९-२३", "content_sanskrit": "पुनः पुनः प्रणम्यासौ मालाकारौ नरोत्तमौ ।\nददौ पुष्पाणि चारूणि गन्धवन्त्यमलानि च ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001037023, "chapter_id": 21037, "verse_number": "५-१९-२४", "content_sanskrit": "मालाकाराय कृष्णोऽपि प्रसन्नः प्रददौ वरान ।\nश्रीस्त्वां मतूसंश्रया भद्र! न कदाचित् प्रहास्तयि ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001037024, "chapter_id": 21037, "verse_number": "५-१९-२५", "content_sanskrit": "बलहानिर्न ते सौम्य! धनहानिस्थथैव च ।\nयावद्दिनानि तावज्व न नशिष्यति सन्ततिः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001037025, "chapter_id": 21037, "verse_number": "५-१९-२६", "content_sanskrit": "बुक्त्वा च विपुलान् भोगांस्तमन्ते मतूप्रसादजम् ।\nममानुस्मरणां प्राप्य दिव्यं लोकमवाप्स्यसि ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001037026, "chapter_id": 21037, "verse_number": "५-१९-२७", "content_sanskrit": "धर्म्मे मनश्व ते भद्र!सर्व्वकालं भविष्यति ।\nयुष्मत्सन्ततिजातानां दीर्घमायुर्भविष्यति ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001037027, "chapter_id": 21037, "verse_number": "५-१९-२८", "content_sanskrit": "नोपसर्गादिकं दोषं युष्मत्सन्ततिसम्भवः ।\nसम्प्राप्स्यति महाभाग!यावत् सूर्य्यो धरिष्यति ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001037028, "chapter_id": 21037, "verse_number": "५-१९-२९", "content_sanskrit": "इतुक्त्वा तदूगृहात् कृष्णो बलदेवसहायवान् ।\nनिर्ज्जगाम मुनिश्वेष्ठ! मालाकारेण पूजितः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]