[{"id": 2092747, "chapter_id": 2974, "verse_number": "१३-१०४-१", "content_sanskrit": "युधिष्ठिर उवाच।\nभूय एव कुरुश्रेष्ठ दानानां विधिमुत्तमम्।\nकथयस्व महाप्राज्ञ भूमिदानं विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2092748, "chapter_id": 2974, "verse_number": "१३-१०४-२", "content_sanskrit": "पृथिवीं क्षत्रियो दद्याद्ब्राह्मणायेष्टिकर्मिणे।\nविधिवत्प्रतिगृह्णीयान्न त्वन्यो दातुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2092749, "chapter_id": 2974, "verse_number": "१३-१०४-३", "content_sanskrit": "सर्ववर्णैस्तु यच्छक्यं प्रदातुं फलकाङ्क्षिभिः।\nवेदे वा यत्समाख्यातं तन्मे व्याख्यातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2092750, "chapter_id": 2974, "verse_number": "१३-१०४-४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2092751, "chapter_id": 2974, "verse_number": "१३-१०४-४", "content_sanskrit": "तुल्यनामानि देयानि त्रीणि तुल्यफलानि च।\nसर्वकामफलानीह गावः पृथ्वी सरस्वती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2092752, "chapter_id": 2974, "verse_number": "१३-१०४-५", "content_sanskrit": "यो ब्रूयाच्चापि शिष्याय धर्म्यां ब्राह्मीं सरस्वतीम्।\nपृथिवीगोप्रदानाभ्यां तुल्यं स फलमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2092753, "chapter_id": 2974, "verse_number": "१३-१०४-६", "content_sanskrit": "तथैव गाः प्रशंसन्ति न तु देयं ततः परम्।\nसन्निकृष्टफलास्ता हि लघ्वर्थाश्च युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2092754, "chapter_id": 2974, "verse_number": "१३-१०४-७", "content_sanskrit": "मातरः सर्वभूतानां गावः सर्वसुखप्रदाः।\nवृद्धिमाकाङ्क्षता नित्यं गावः कार्याः प्रदक्षिणाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2092755, "chapter_id": 2974, "verse_number": "१३-१०४-८", "content_sanskrit": "सन्ताड्या न तु पादेन गवां मध्ये न च व्रजेत्।\nमङ्गलायतनं देव्यस्तस्मात्पूज्याः सदैव गाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2092756, "chapter_id": 2974, "verse_number": "१३-१०४-९", "content_sanskrit": "प्रचोदनं देवकृतं गवां कर्मसु वर्तताम्।\nपूर्वमेवाक्षरं चान्यदभिधेयं ततः परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2092757, "chapter_id": 2974, "verse_number": "१३-१०४-१०", "content_sanskrit": "प्रचारे वा निवाते वा बुधो नोद्वेजयेत गाः।\nतृषिता ह्यभिवीक्षन्त्यो नरं हन्युः सबान्धवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2092758, "chapter_id": 2974, "verse_number": "१३-१०४-११", "content_sanskrit": "पितृसद्मानि सततं देवतायतनानि च।\nपूयन्ते शकृता यासां पूतं किमधिकं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2092759, "chapter_id": 2974, "verse_number": "१३-१०४-१२", "content_sanskrit": "घासमुष्टिं परगवे दद्यात्संवत्सरं तु यः।\nअकृत्वा स्वयमाहारं व्रतं तत्सार्वकामिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2092760, "chapter_id": 2974, "verse_number": "१३-१०४-१३", "content_sanskrit": "स हि पुत्रान्यशोऽर्थं च श्रियं चाप्यधिगच्छति।\nनाशयत्यशुभं चैव दुःस्वप्नं चाप्यपोहति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2092761, "chapter_id": 2974, "verse_number": "१३-१०४-१४x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2092762, "chapter_id": 2974, "verse_number": "१३-१०४-१४", "content_sanskrit": "देयाः किंलक्षणा गावः काश्चापि परिवर्जयेत्।\nकीदृशाय प्रदातव्या न देयाः कीदृशाय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2092763, "chapter_id": 2974, "verse_number": "१३-१०४-१५x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2092764, "chapter_id": 2974, "verse_number": "१३-१०४-१५", "content_sanskrit": "असद्वृत्ताय पापाय लुब्धायानृतवादिने।\nहव्यकव्यव्यपेताय न देया गौः कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2092765, "chapter_id": 2974, "verse_number": "१३-१०४-१६", "content_sanskrit": "भिक्षवे बहुपुत्राय श्रोत्रियायाहिताग्नये।\nदत्त्वा दशगवां दाता लोकानाप्नोत्यनुत्तमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2092766, "chapter_id": 2974, "verse_number": "१३-१०४-१७", "content_sanskrit": "`जुहोति यद्भोजयति यद्ददाति गवां रसैः।\nसर्वस्यैवांशभाग्दाता तन्निमित्तं प्रवर्तितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2092767, "chapter_id": 2974, "verse_number": "१३-१०४-१८", "content_sanskrit": "यश्चैव धर्मं कुरुते तस्य धर्मफलं च यत्।\nसर्वस्यैवांशभाग्दाता तन्निमित्तं प्रवृत्तयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2092768, "chapter_id": 2974, "verse_number": "१३-१०४-१९", "content_sanskrit": "यश्चैनमुत्पादयते यश्चैनं त्रायते भयात्।\nयश्चास्य कुरुते वृत्तिं सर्वे ते पितरस्त्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2092769, "chapter_id": 2974, "verse_number": "१३-१०४-२०", "content_sanskrit": "कल्मषं गुरुशुश्रूषा हन्ति मानो महद्यशः।\nअपुत्रतां त्रयः पुत्रा अवृत्तिं दश धेनवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2092770, "chapter_id": 2974, "verse_number": "१३-१०४-२१", "content_sanskrit": "वेदान्तनिष्ठस्य बहुश्रुतस्य\nप्रज्ञानतृप्तस्य जितेन्द्रियस्य।\nशिष्टस्य दान्तस्य यतस्य चैव\nभूतेषु नित्यं प्रियवादिनश्च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2092771, "chapter_id": 2974, "verse_number": "१३-१०४-२२", "content_sanskrit": "यः क्षुद्भयाद्वै न विकर्म कुर्या-\nन्मृदुश्च शान्तौ ह्यतिथिप्रियश्च।\nशुभे पात्रे ये गुणा गोप्रदाने\nतावान्दोषो ब्राह्मणस्वापहारे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2092772, "chapter_id": 2974, "verse_number": "१३-१०४-२३", "content_sanskrit": "सर्वावस्थं ब्राह्मणस्वापहारे\nदाराश्चैषां दूरतो वर्जनीयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2092773, "chapter_id": 2974, "verse_number": "१३-१०४-२४", "content_sanskrit": "`विप्रदारे परिहृते तद्धनेऽपहृते च तु।\nपरित्रायन्ति शक्तास्तु नमस्तेभ्यो मृताश्च ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2092774, "chapter_id": 2974, "verse_number": "१३-१०४-२५", "content_sanskrit": "न पालयन्ति निहतान्ये तान्वैवस्वतो यमः।\nदण्डयन्भर्सयन्नित्यं निरयेभ्यो न मुञ्चति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2092775, "chapter_id": 2974, "verse_number": "१३-१०४-२६", "content_sanskrit": "तथा गवां परित्राणे पीडने च शुभाशुभम्।\nविप्रगोषु विशेषेण रक्षितेषु गृहेषु वा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2092776, "chapter_id": 2974, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि चतुरधिकशततमोऽध्यायः॥ १०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]