[{"id": 5000583000, "chapter_id": 9583, "verse_number": "७-४८-१", "content_sanskrit": "लक्ष्मणस्य वचः श्रुत्वा दारुणं जनकात्मजा ।\nपरं विषादमागम्य वैदेही निपपात ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000583001, "chapter_id": 9583, "verse_number": "७-४८-२", "content_sanskrit": "सा मुहूर्तमिवासञ्ज्ञा बाष्पपर्याकुलेक्षणा ।\nलक्ष्मणं दीनया वाचा उवाच जनकात्मजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000583002, "chapter_id": 9583, "verse_number": "७-४८-३", "content_sanskrit": "मामिकेयं तनुर्नूनं सृष्टा दुःखाय लक्ष्मण ।\nधात्रा यस्यास्तथा मे ऽद्य दुःखमूर्तिः प्रदृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000583003, "chapter_id": 9583, "verse_number": "७-४८-४", "content_sanskrit": "किं नु पापं कृतं पूर्वं को वा दारैर्वियोजितः ।\nया ऽहं शुद्धसमाचारा त्यक्ता नृपतिना सती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000583004, "chapter_id": 9583, "verse_number": "७-४८-५", "content_sanskrit": "पुरा ऽहमाश्रमे वासं रामपादानुवर्तिनी ।\nअनुरुध्यापि सौमित्रे दुःखे च परिवर्तिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000583005, "chapter_id": 9583, "verse_number": "७-४८-६", "content_sanskrit": "सा कथं ह्याश्रमे सौम्य वत्स्यामि विजनीकृता ।\nआख्यास्यामि च कस्याहं दुःखं दुःखपरायणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000583006, "chapter_id": 9583, "verse_number": "७-४८-७", "content_sanskrit": "किं नु वक्ष्यामि मुनिषु कर्म वा सत्कृतं च किम् ।\nकस्मिंश्चित् कारणे त्यक्ता राघवेण महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000583007, "chapter_id": 9583, "verse_number": "७-४८-८", "content_sanskrit": "न खल्वद्यैव सौमित्रे जीवितं जाह्नवीजले ।\nत्यजेयं राजवंशस्तु भर्तुर्मे परिहास्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000583008, "chapter_id": 9583, "verse_number": "७-४८-९", "content_sanskrit": "यथाज्ञं कुरु सोमित्रे त्यज मां दुःखभागिनीम् ।\nनिदेशे स्थीयतां राज्ञः शृणु चेदं वचो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000583009, "chapter_id": 9583, "verse_number": "७-४८-१०", "content_sanskrit": "श्वश्रूणामविशेषेण प्राञ्जलिप्रग्रहेण च ।\nशिरसा ऽ ऽवन्द्य चरणौ कुशलं ब्रूहि पार्थिवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000583010, "chapter_id": 9583, "verse_number": "७-४८-११", "content_sanskrit": "शिरसा ऽभिनतो ब्रूयाः सर्वासामेव लक्ष्मण ।\nवक्तव्यश्चापि नृपतिर्धर्मेषु सुसमाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000583011, "chapter_id": 9583, "verse_number": "७-४८-१२", "content_sanskrit": "जानासि च यथा शुद्धा सीता तत्त्वेन राघव ।\nभक्त्या च परया युक्ता हिता च तव नित्यशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000583012, "chapter_id": 9583, "verse_number": "७-४८-१३", "content_sanskrit": "अहं त्यक्ता त्वया वीर अयशोभीरुणा जने ।\nयच्च ते वचनीयं स्यादपवादसमुत्थितम् ।\nमया च परिहर्तव्यं त्वं हि मे परमा गतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000583013, "chapter_id": 9583, "verse_number": "७-४८-१४", "content_sanskrit": "वक्तव्यश्चेति नृपतिर्धमेण सुसमाहितः ।\nयथा भ्रातृषु वर्तेथास्तथा पौरेषु नित्यदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000583014, "chapter_id": 9583, "verse_number": "७-४८-१५", "content_sanskrit": "परमो ह्येष धर्मस्ते तस्मात्कीर्तिरनुत्तमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000583015, "chapter_id": 9583, "verse_number": "७-४८-१६", "content_sanskrit": "यत्तु पौरजनो राजन्धर्मेण समवाप्नुयात् ।\nअहं तु नानुशोचामि स्वशरीरं नरर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000583016, "chapter_id": 9583, "verse_number": "७-४८-१७", "content_sanskrit": "यथापवादं पौराणां तथैव रघुनन्दन ।\nपतिर्हि देवता नार्याः पतिर्बन्धुः पतिर्गुरुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000583017, "chapter_id": 9583, "verse_number": "७-४८-१८", "content_sanskrit": "प्राणैरपि प्रियं तस्माद्भर्तुः कार्यं विशेषतः ।\nइति मद्वचनाद्रामो वक्तव्यो मम सङ्ग्रहः ।\nनिरीक्ष्य मा ऽद्य गच्छ त्वमृतुकालातिवर्तिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000583018, "chapter_id": 9583, "verse_number": "७-४८-१९", "content_sanskrit": "एवं ब्रुवन्त्यां सीतायां लक्ष्मणो दीनचेतनः ।\nशिरसा ऽ ऽवन्द्य धरणीं व्याहर्तुं न शशाक ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000583019, "chapter_id": 9583, "verse_number": "७-४८-२०", "content_sanskrit": "प्रदक्षिणं च तां कृत्वा रुदन्नेव महास्वनः ।\nध्यात्वा मुहूर्तं तामाह किं मां वक्ष्यसि शोभने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000583020, "chapter_id": 9583, "verse_number": "७-४८-२१", "content_sanskrit": "दृष्टपूर्वं न ते रूपं पादौ दृष्टौ तवानघे ।\nकथमत्र हि पश्यामि रामेण रहितां वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000583021, "chapter_id": 9583, "verse_number": "७-४८-२२", "content_sanskrit": "इत्युक्त्वा तां नमस्कृत्य पुनर्नावमुपारुहत् ।\nआरुह्य च पुनर्नावं नाविकं चाभ्यचोदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000583022, "chapter_id": 9583, "verse_number": "७-४८-२३", "content_sanskrit": "स गत्वा चोत्तरं तीरं शोकभारसमन्वितः ।\nसम्मूढ इव दुःखेन रथमध्यारुहद्द्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000583023, "chapter_id": 9583, "verse_number": "७-४८-२४", "content_sanskrit": "मुहुर्मुहुः परावृत्य दृष्ट्वा सीतामनाथवत् ।\nचेष्टन्तीं परतीरस्थां लक्ष्मणः प्रययावथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000583024, "chapter_id": 9583, "verse_number": "७-४८-२५", "content_sanskrit": "दूरस्थं रथमालोक्य लक्ष्मणं च मुहूर्मुहुः ।\nनिरीक्षमाणां तूद्विग्नां सीतां शोकः समाविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000583025, "chapter_id": 9583, "verse_number": "७-४८-२६", "content_sanskrit": "सा दुःखभारावनता यशस्विनी यशोधना नाथमपश्यती सती ।\nरुरोद सा बर्हिणनादिते वने महास्वनं दुःखपरायणा सती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000583026, "chapter_id": 9583, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे ऽष्टचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]