[{"id": 2190833, "chapter_id": 5062, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2190834, "chapter_id": 5062, "verse_number": "१", "content_sanskrit": "भ्रातरः पितरः पुत्रा ज्ञातयः सुहृदस्तथा ।\nअर्थहेतोर्हताः क्रूरैरस्माभिः पापबुद्धिभिः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2190835, "chapter_id": 5062, "verse_number": "२", "content_sanskrit": "येयमर्थोद्भवा तृष्णा कथमेतां पितामह ।\nनिवर्तयेम पापं हि तृष्णया कारिता वयम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2190836, "chapter_id": 5062, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2190837, "chapter_id": 5062, "verse_number": "३", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nगीतं विदेहराजेन माण्डव्यायानुपृच्छते\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2190838, "chapter_id": 5062, "verse_number": "४", "content_sanskrit": "सुसुखं बत जीवामि यस्य मे नास्ति किञ्चन ।\nमिथिलायां प्रदीप्तायां न मे दह्यति किञ्चन\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2190839, "chapter_id": 5062, "verse_number": "५", "content_sanskrit": "अर्थाः खलु समृद्धा हि बाढं दुःखं विजानताम् ।\nअसमृद्धास्त्वपि सदा मोहयन्त्यविचक्षणान्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2190840, "chapter_id": 5062, "verse_number": "६", "content_sanskrit": "यच्च कामसुखं लोके यच्च दिव्यं महत् सुखम् ।\nतृष्णाक्षयसुखस्यैते नार्हतः षोडशीं कलाम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2190841, "chapter_id": 5062, "verse_number": "७", "content_sanskrit": "यथैव शृङ्गं गोः काले वर्धमानस्य वर्धते ।\nतथैव तृष्णा वित्तेन वर्धमानेन वर्धते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2190842, "chapter_id": 5062, "verse_number": "८", "content_sanskrit": "किञ्चिदेव ममत्वेन यदा भवति कल्पितम् ।\nतदेव परितापाय नाशे सम्पद्यते पुनः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2190843, "chapter_id": 5062, "verse_number": "९", "content_sanskrit": "न कामाननुरुद्ध्येत दुःखं कामेषु वै रतिः ।\nप्राप्यार्थमुपयुञ्जीत धर्मे कामं विवर्जयेत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2190844, "chapter_id": 5062, "verse_number": "१०", "content_sanskrit": "विद्वान् सर्वेषु भूतेषु आत्मना सोपमो भवेत् ।\nकृतकृत्यो विशुद्धात्मा सर्वं त्यजति वै सह\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2190845, "chapter_id": 5062, "verse_number": "११", "content_sanskrit": "उभे सत्यानृते त्यक्त्वा शोकानन्दौ प्रियाप्रिये ।\nभयाभये च सन्त्यज्य सम्प्रशान्तो निरामयः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2190846, "chapter_id": 5062, "verse_number": "१२", "content_sanskrit": "या दुस्त्यजा दुर्मतिभिर्या न जीर्यति जीर्यतः ।\nयोऽसौ प्राणान्तिको रोगस्तां तृष्णां त्यजतः सुखम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2190847, "chapter_id": 5062, "verse_number": "१३", "content_sanskrit": "चारित्रमात्मनः पश्यंश्चन्द्रशुद्धमनामयम् ।\nधर्मात्मा लभते कीर्तिं प्रेत्य चेह यथासुखम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2190848, "chapter_id": 5062, "verse_number": "१४", "content_sanskrit": "राज्ञस्तद्वचनं श्रुत्वा प्रीतिमानभवद् द्विजः ।\nपूजयित्वा च तद्वाक्यं माण्डव्यो मोक्षमाश्रितः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2190849, "chapter_id": 5062, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे एकादशाधिकशततमोऽध्यायः ॥१११॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]