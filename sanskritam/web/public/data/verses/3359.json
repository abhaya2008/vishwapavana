[{"id": 2108813, "chapter_id": 3359, "verse_number": "", "content_sanskrit": "तक्षकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2108814, "chapter_id": 3359, "verse_number": "१", "content_sanskrit": "दष्टं यदि मयेह त्वं शक्तः किञ्चिच्चिकित्सितुम् ।\nततो दग्धं मया वृक्षमिमं जीवय काश्यप\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2108815, "chapter_id": 3359, "verse_number": "२", "content_sanskrit": "परं मन्त्रबलं यत् ते दर्शयस्व यतस्व च ।\nन्यग्रोधमेनं धक्ष्यामि पश्यतस्ते द्विजोत्तम \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2108816, "chapter_id": 3359, "verse_number": "", "content_sanskrit": "काश्यपः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2108817, "chapter_id": 3359, "verse_number": "३", "content_sanskrit": "दश नागेन्द्र वृक्षं त्वं यमेनमभिमन्यसे ।\nअहमेनं त्वया दग्धं जीवयिष्ये भुजङ्गम \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2108818, "chapter_id": 3359, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2108819, "chapter_id": 3359, "verse_number": "४", "content_sanskrit": "एवमुक्तः स नागेन्द्रः काश्यपेन महात्मना ।\nअदशद् वृक्षमभ्येत्य न्यग्रोधं पन्नगोत्तमः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2108820, "chapter_id": 3359, "verse_number": "५", "content_sanskrit": "स वृक्षस्तेन दष्टः सन् सद्य एव महाद्युते ।\nआशीविषविषोपेतः प्रजज्वाल समन्ततः\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2108821, "chapter_id": 3359, "verse_number": "६", "content_sanskrit": "तं दग्ध्वा स नगं नागः काश्यपं पुनरब्रवीत् ।\nकुरु यत्नं द्विजश्रेष्ठ जीवयैनं वनस्पतिम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2108822, "chapter_id": 3359, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2108823, "chapter_id": 3359, "verse_number": "७", "content_sanskrit": "भस्मीभूतं ततो वृक्षं पन्नगेन्द्रस्य तेजसा ।\nभस्म सर्वं समाहृत्य काश्यपो वाक्यमब्रवीत् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2108824, "chapter_id": 3359, "verse_number": "", "content_sanskrit": "काश्यपः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2108825, "chapter_id": 3359, "verse_number": "८", "content_sanskrit": "विद्याबलं पन्नगेन्द्र पश्य मेऽस्मिन् वनस्पतौ ।\nअहं सञ्जीवयाम्येनं पश्यतस्ते भुजङ्गम \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2108826, "chapter_id": 3359, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2108827, "chapter_id": 3359, "verse_number": "९", "content_sanskrit": "ततः स भगवान् विद्वान् काश्यपो द्विजसत्तमः ।\nभस्मराशीकृतं वृक्षं विद्यया समजीवयत् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2108828, "chapter_id": 3359, "verse_number": "१०", "content_sanskrit": "सहाङ्कुरं च कृतवान् विद्वान् पर्णद्वयान्वितम् ।\nपलाशिनं शाखिनं च तथा विटपिनं पुनः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2108829, "chapter_id": 3359, "verse_number": "११", "content_sanskrit": "तं दृष्ट्वा जीवितं वृक्षं काश्यपेन महात्मना ।\nउवाच तक्षको ब्रह्मन्नेतदत्यद्भुतं त्वयि \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2108830, "chapter_id": 3359, "verse_number": "१२", "content_sanskrit": "विप्रेन्द्र यद् विषं हन्या मम वा मद्विधस्य वा ।\nकं त्वमर्थमभिप्रेक्ष्य यासि तत्र द्विजोत्तम \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2108831, "chapter_id": 3359, "verse_number": "१३", "content_sanskrit": "यत् तेऽभिलषितं ब्रह्मन् फलं तस्मान्नृपोत्तमात् ।\nअहमेव प्रदास्यामि निवर्तस्व द्विजोत्तम\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2108832, "chapter_id": 3359, "verse_number": "१४", "content_sanskrit": "विप्रशापाभिभूते च क्षीणायुषि नराधिपे ।\nअटमानस्य ते विद्यासिद्धिः संशयिता भवेत्\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2108833, "chapter_id": 3359, "verse_number": "१५", "content_sanskrit": "ततो यशः प्रदीप्तं ते त्रिषु लोकेषु विश्रुतम् ।\nविरश्मिरिव तिग्मांशुरन्तर्धानमितो व्रजेत् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2108834, "chapter_id": 3359, "verse_number": "", "content_sanskrit": "काश्यपः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2108835, "chapter_id": 3359, "verse_number": "१६", "content_sanskrit": "धनार्थी याम्यहं तत्र तन्मे दिश भुजङ्गम ।\nततोऽहं विनिवर्तिष्ये गृहायोरगसत्तम \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2108836, "chapter_id": 3359, "verse_number": "", "content_sanskrit": "तक्षकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2108837, "chapter_id": 3359, "verse_number": "१७", "content_sanskrit": "यावद् धनं प्रार्थयसे तस्माद् राज्ञस्ततोऽधिकम् ।\nअहं तेऽद्य प्रदास्यामि निवर्तस्व द्विजोत्तम \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2108838, "chapter_id": 3359, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2108839, "chapter_id": 3359, "verse_number": "१८", "content_sanskrit": "तक्षकस्य वचः श्रुत्वा काश्यपो द्विजसत्तमः ।\nप्रदध्यौ सुमहातेजा राजानं प्रति बुद्धिमान् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2108840, "chapter_id": 3359, "verse_number": "१९", "content_sanskrit": "दिव्यज्ञानेन तेजस्वी ज्ञात्वा तं नृपतिं तदा ।\nक्षीणायुषं पाण्डवेयमपावर्तत काश्यपः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2108841, "chapter_id": 3359, "verse_number": "२०", "content_sanskrit": "लब्ध्वा वित्तं मुनिवरस्तक्षकाद् यावदीप्सितम् ।\nनिवृत्ते काश्यपे तस्मिन् समयेन महात्मनि \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2108842, "chapter_id": 3359, "verse_number": "२१", "content_sanskrit": "जगाम तक्षकस्तूर्णं नगरं नागसाह्वयम् ।\nअथ शुश्राव गच्छन् स तक्षको जगतीपतिम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2108843, "chapter_id": 3359, "verse_number": "२२", "content_sanskrit": "मन्त्रैर्विषहरैर्दिव्यै रक्ष्यमाणं प्रयत्नतः ।\nसञ्चिन्तयामास तदा मायायोगेन पार्थिवः\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2108844, "chapter_id": 3359, "verse_number": "२३", "content_sanskrit": "मया वञ्चयितव्योऽसौ क उपायो भवेदिति ।\nततस्तापसरूपेण प्राहिणोत् स भुजङ्गमान् ।\nफलपत्रोदकं गृह्य राज्ञे नागोऽथ तक्षकः\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2108845, "chapter_id": 3359, "verse_number": "", "content_sanskrit": "तक्षकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2108846, "chapter_id": 3359, "verse_number": "२४", "content_sanskrit": "गच्छध्वं यूयमव्यग्रा राजानं कार्यवत्तया ।\nफलपत्रोदकं नागाः प्रतिग्राहयितुं नृपम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2108847, "chapter_id": 3359, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2108848, "chapter_id": 3359, "verse_number": "२५", "content_sanskrit": "ते तक्षकसमादिष्टास्तथा चक्रुर्भुजङ्गमाः ।\nउपनिन्युस्तदा राज्ञे दर्भानापः फलानि च\t ॥ २५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2108849, "chapter_id": 3359, "verse_number": "२६", "content_sanskrit": "तच्च सर्वं स राजेन्द्रः प्रतिजग्राह वीर्यवान् ।\nश्रुत्वा तु तेषां कार्याणि गम्यतामित्युवाच तान् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2108850, "chapter_id": 3359, "verse_number": "२७", "content_sanskrit": "गतेषु तेषु नागेषु तापसच्छद्मरूपिषु ।\nअमात्यान् सुहृदश्चैव प्रोवाच स नराधिपः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2108851, "chapter_id": 3359, "verse_number": "२८", "content_sanskrit": "भक्षयन्तु भवन्तो वै फलानीमानि सर्वशः ।\nतापसैरुपनीतानि फलानि सहिता मया \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2108852, "chapter_id": 3359, "verse_number": "२९", "content_sanskrit": "ततो राजा ससचिवः फलान्यत्तुमियेष सः ।\nतद् गृहीतं फलं राज्ञा यदा कृमिरभूदणुः\t ॥ २९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2108853, "chapter_id": 3359, "verse_number": "३०", "content_sanskrit": "ह्रस्वकः कृष्णनयनस्ताम्रो वर्णेन शौनक ।\nस तं गृह्य नृपश्रेष्ठः सचिवानिदमब्रवीत् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2108854, "chapter_id": 3359, "verse_number": "३१", "content_sanskrit": "अस्तमभ्येति सविता विषादद्य न मे भयम् ।\nसत्यवागस्तु स मुनिः कृमिको मां दशत्वयम् \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2108855, "chapter_id": 3359, "verse_number": "३२", "content_sanskrit": "तक्षको नाम भूत्वा वै तथा परिहृतं भवेत् ।\nते चैनमन्ववर्तन्त मन्त्रिणः कालचोदिताः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2108856, "chapter_id": 3359, "verse_number": "३३", "content_sanskrit": "एवमुक्त्वा स राजेन्द्रो ग्रीवायां सन्निवेश्य ह ।\nकृमिं तं प्राहसत् तूर्णं मुमूर्षुर्नष्टचेतनः ।\nहसन्नेव च कोपेन तक्षकेणाभिवेष्टितः \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2108857, "chapter_id": 3359, "verse_number": "३८", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि अष्टत्रिंशोऽध्यायः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2108858, "chapter_id": 3359, "verse_number": "२६", "content_sanskrit": "॥ आस्तीकपर्वणि षड्विंशोऽध्यायः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]