[{"id": 2088559, "chapter_id": 2889, "verse_number": "१३-१९-१", "content_sanskrit": "`युधिष्ठिर उवाच।\nगरुडः पक्षिणां श्रेष्ठ इति पूर्वं पितामह।\nउक्तस्त्वया महाबाहो श्वेतवाहं प्रशंसता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2088560, "chapter_id": 2889, "verse_number": "१३-१९-२", "content_sanskrit": "अत्र कौतूहल इति श्रवणे जायते मतिः।\nकथं गरुत्मान्पक्षीणां श्रैष्ठ्यं प्राप परन्तप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2088561, "chapter_id": 2889, "verse_number": "१३-१९-३", "content_sanskrit": "सुपर्णो वैनतेयश्च केन शत्रुश्च भोगिनाम्।\nकिंवीर्यः किंबलश्चासौ वक्तुमर्हसि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2088562, "chapter_id": 2889, "verse_number": "१३-१९-४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2088563, "chapter_id": 2889, "verse_number": "१३-१९-४", "content_sanskrit": "वासुदेव महाबाहो देवकी सुप्रजास्त्वया।\nश्रुतं ते धर्मराजस्य मम हर्षविवर्धन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2088564, "chapter_id": 2889, "verse_number": "१३-१९-५", "content_sanskrit": "सुपर्णं शंस इत्येव मामाह कुरुनन्दनः।\nअस्य प्रवक्तुमिच्छामि त्वयाऽज्ञप्तो महाद्युते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2088565, "chapter_id": 2889, "verse_number": "१३-१९-६", "content_sanskrit": "त्वं हि शौरे महाबाहो सुपर्णः प्रोच्यसे पुरा।\nअनादिनिधने काले गरुडश्चासि केशव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2088566, "chapter_id": 2889, "verse_number": "१३-१९-७", "content_sanskrit": "तस्मात्पूर्वं प्रसाद्य त्वां धर्मपुत्राय धीमते।\nगरुडं पततांश्रेष्ठं वक्तुमिच्छामि माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2088567, "chapter_id": 2889, "verse_number": "१३-१९-८x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2088568, "chapter_id": 2889, "verse_number": "१३-१९-८", "content_sanskrit": "यथैव मां भवान्वेद तथा वेद युधिष्ठिरः।\nयथा च गरुडो जातस्तथाऽस्मै ब्रूहि तत्वतः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2088569, "chapter_id": 2889, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकोनविंशोऽध्यायः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]