[{"id": 7006221000, "chapter_id": 26221, "verse_number": "२-४९-१", "content_sanskrit": "जैमिनिरुवाच अथानुज्ञाय सगरो वसिष्ठमृषिसत्तमम् ।\nबलेन महता युक्तो विदर्भानभ्यवर्त्तत ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006221001, "chapter_id": 26221, "verse_number": "२-४९-२", "content_sanskrit": "ततो विदर्भराट्तस्मै स्वसुतां प्रीतिपूर्वकम् ।\nकेशिन्याख्यामनुपमामनुरूपां न्यवेदयत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006221002, "chapter_id": 26221, "verse_number": "२-४९-३", "content_sanskrit": "स तस्या राजशार्दूलो विधिवद्वह्निसाक्षिकम् ।\nशुभे मुहूर्ते केशिन्याः पार्णिं जग्राह भूमिपः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006221003, "chapter_id": 26221, "verse_number": "२-४९-४", "content_sanskrit": "स्थित्वा दिनानि कतिचिद्गृहे तस्यातिसत्कृतः ।\nविदर्भराज्ञा संमन्त्र्य ततो गन्तुं प्रजक्रमे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006221004, "chapter_id": 26221, "verse_number": "२-४९-५", "content_sanskrit": "अनुज्ञातस्ततस्तेन पारिबर्हैश्च सत्कृतः ।\nनिष्क्रम्य तत्पुराद्राजा शूरसेनानुपेयिवान् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006221005, "chapter_id": 26221, "verse_number": "२-४९-६", "content_sanskrit": "संभावितस्ततश्चैव यादवैर्मातृसोदरैः ।\nधनौघैस्तर्पितस्तैश्च मधुराया विनिर्ययौ ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006221006, "chapter_id": 26221, "verse_number": "२-४९-७", "content_sanskrit": "एवं स सगरो राजा विजित्य वसुधामिमाम् ।\nकरैश्च स नृपान्सर्वांश्चक्रे संकेतगानपि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006221007, "chapter_id": 26221, "verse_number": "२-४९-८", "content_sanskrit": "ततोऽनुमान्य नृपतीन्निजराज्याय सानुगान् ।\nअनुजज्ञे नरपतिः समस्ताननुयायिनः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006221008, "chapter_id": 26221, "verse_number": "२-४९-९", "content_sanskrit": "ततो बलेन महाता स्कन्धावारसमन्वितः ।\nशनैरपीडयन्देशान्स्वराज्यमुपजग्मिवान् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006221009, "chapter_id": 26221, "verse_number": "२-४९-१०", "content_sanskrit": "संभाव्यमानश्च मुहुरुपदाभिरनेकशः ।\nनानाजनपदैस्तूर्ममयोध्यां समुपागमत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006221010, "chapter_id": 26221, "verse_number": "२-४९-११", "content_sanskrit": "तदागमनमाज्ञाय नागरः सकलो जनः ।\nनगरीं तामलञ्चक्रे महोत्सवसमुत्सुकः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006221011, "chapter_id": 26221, "verse_number": "२-४९-१२", "content_sanskrit": "ततः सा नगरी सर्वा कृतकौतुकमङ्गला ।\nसिक्तसंमृष्टभूभागा पूर्णकुम्भशतावृता ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006221012, "chapter_id": 26221, "verse_number": "२-४९-१३", "content_sanskrit": "समुच्छ्रितध्वजशता पताकाभिरंलकृता ।\nसर्वत्रागरुधूपाञढ्या विचित्रकुसुमोज्ज्वला ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006221013, "chapter_id": 26221, "verse_number": "२-४९-१४", "content_sanskrit": "सद्रत्नतोरणोत्तुङ्गगोपुराट्टलभूषिता ।\nप्रसूनलाजवर्षैश्च स्वलङ्कृतमहापथा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006221014, "chapter_id": 26221, "verse_number": "२-४९-१५", "content_sanskrit": "महोत्सवसमायुक्ता प्रतिगेहमभूत्पुरी ।\nसंबूजिताशेषवास्तुदेवतागृहमालिनी ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006221015, "chapter_id": 26221, "verse_number": "२-४९-१६", "content_sanskrit": "दिक्चक्रजयिनो राज्ञः संदर्शनमुदान्वितैः ।\nपौरजानपदैर्त्दृष्टैः सर्वतः समलङ्कृता ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006221016, "chapter_id": 26221, "verse_number": "२-४९-१७", "content_sanskrit": "ततः प्रकृतयः सर्वे तथान्तः पुरवासिनः ।\nवारकाताकदबैश्च नगरीभिश्च सवृताः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006221017, "chapter_id": 26221, "verse_number": "२-४९-१८", "content_sanskrit": "अभ्याययुस्ततः सर्वे समत्य पुरवासिनः ।\nस तैः समेत्य नृपतिर्लब्धाशीर्वाद सक्त्क्रियः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006221018, "chapter_id": 26221, "verse_number": "२-४९-१९", "content_sanskrit": "बधिरीकृतदिक्चक्रो जयशब्देन भूरिणा ।\nनानावादित्रसंघोषमिश्रेण मधुरेण च ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006221019, "chapter_id": 26221, "verse_number": "२-४९-२०", "content_sanskrit": "सत्कृत्य तान्यथा योगं सहितस्तैर्मुदान्वितैः ।\nआनन्दयन्प्रजाः सर्वाः प्रविवेश पुरोत्तमम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006221020, "chapter_id": 26221, "verse_number": "२-४९-२१", "content_sanskrit": "वेदघोषैः सुमधुरैर्ब्राह्मणैरभिनन्दितः ।\nसंस्तूयमानः सुभृशं सूतमागधवन्दिभिः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006221021, "chapter_id": 26221, "verse_number": "२-४९-२२", "content_sanskrit": "जयशब्दैश्च परितो नानाजनपदेरितैः ।\nकलतालरवोन्मिश्रवीणावेणुतलस्वनैः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006221022, "chapter_id": 26221, "verse_number": "२-४९-२३", "content_sanskrit": "गायद्भिर्गायकजनैर्नृत्यद्भिर्गणिकाजनैः ।\nअन्वीयमानो विलसच्छ्वेतच्छत्रविराजितः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006221023, "chapter_id": 26221, "verse_number": "२-४९-२४", "content_sanskrit": "विकीर्यमाणः परितः सल्लाजकुसुमोत्करैः ।\nपुरीमयोध्यामविशत्स्वपुरीमिव वासवः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006221024, "chapter_id": 26221, "verse_number": "२-४९-२५", "content_sanskrit": "दृष्टिपूतेन गन्धेन ब्राह्मणानां च वर्त्मना ।\nजगाम मध्येनगरं गृहं श्रीमदलङ्कृतम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006221025, "chapter_id": 26221, "verse_number": "२-४९-२६", "content_sanskrit": "अवरुह्य ततो यानाद्भार्याभ्यां सहितो मुदा ।\nप्रविवेश गृहं मातुर्हृष्टपुष्टजनायुतम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006221026, "chapter_id": 26221, "verse_number": "२-४९-२७", "content_sanskrit": "पर्यङ्कस्थामुपागम्य मातरं विनयान्वितः ।\nतत्पादौ संस्पृशन्मूर्ध्ना प्रणाममकरोत्तदा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006221027, "chapter_id": 26221, "verse_number": "२-४९-२८", "content_sanskrit": "साभिनन्द्य तमाशीर्भिर्हर्षगद्गदया गिरा ।\nससंभ्रमं समुत्थाय पर्यष्वजत चात्मजम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006221028, "chapter_id": 26221, "verse_number": "२-४९-२९", "content_sanskrit": "सहर्षं बहुधाशीर्भिरभ्यनन्ददुभे स्नुषे ।\nस तां संभाव्य कथया तत्र स्थित्वा चिरादिव ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006221029, "chapter_id": 26221, "verse_number": "२-४९-३०", "content_sanskrit": "अनुज्ञातस्तया राजा निश्चक्राम तदालयात् ।\nततः सानुचरो राजा श्वेतव्यजनवीजितः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006221030, "chapter_id": 26221, "verse_number": "२-४९-३१", "content_sanskrit": "सुरराज इव श्रीमान्सभां समगमच्छनैः ।\nसंप्रविश्य सभां दिव्यामनेकनृपसेविताम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006221031, "chapter_id": 26221, "verse_number": "२-४९-३२", "content_sanskrit": "नत्वा गुरुजनं सर्वमाशीर्भिश्चाभिनन्दितः ।\nसिंहासने शुभे दिव्ये निषसाद नरेश्वरः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006221032, "chapter_id": 26221, "verse_number": "२-४९-३३", "content_sanskrit": "संसेव्यमानश्च नृपैर्नानाजनपदेश्वरैः ।\nनानाविधाः कथाः कुर्वन्स तत्र नृपसत्तमः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006221033, "chapter_id": 26221, "verse_number": "२-४९-३४", "content_sanskrit": "संप्रीयमामः सुतरामुवास सह बन्धुभिः ।\nप्रतिज्ञां पालयित्वैवं जितदिङ्मण्डलो नृपः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006221034, "chapter_id": 26221, "verse_number": "२-४९-३५", "content_sanskrit": "अन्वतिष्ठद्यन्थान्याय मर्थत्रयमुदारधीः ।\nस्वप्रभावजिताशेषवैरिर्दिङ्मण्डलाधिपः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006221035, "chapter_id": 26221, "verse_number": "२-४९-३६", "content_sanskrit": "एकातपत्रां पृथिवीमन्वशासद्वृषो यथा ।\nस्वर्यातस्य पितुः पूर्वं परिभावममर्षितः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006221036, "chapter_id": 26221, "verse_number": "२-४९-३७", "content_sanskrit": "स यां प्रतिज्ञामारूढस्तां सम्यक्परिपूर्य च ।\nसप्तद्वीपाब्धिनगरग्रामायतनमालिनीम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006221037, "chapter_id": 26221, "verse_number": "२-४९-३८", "content_sanskrit": "जित्वा शत्रूनशेषेण पालयामास मेदिनीम ।\nएवं गच्छति काले च वसिष्ठो भगवानृषिः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006221038, "chapter_id": 26221, "verse_number": "२-४९-३९", "content_sanskrit": "अभ्यजगाम तं भूयो द्रष्टुकामो जरेश्वरम् ।\nतमायान्तमतिप्रेक्ष्य मुनिवर्यं ससंभ्रमः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006221039, "chapter_id": 26221, "verse_number": "२-४९-४०", "content_sanskrit": "प्रत्युज्जगामार्घहस्तः सहितस्तैर्नपैर्नृपः ।\nअर्ध्यपाद्यादिभिः सम्यक्पूजयित्वा महामतिः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006221040, "chapter_id": 26221, "verse_number": "२-४९-४१", "content_sanskrit": "प्रणाममकरोत्तस्मै गुरुभक्तिसमन्वितः ।\nआशीर्भिर्वर्द्धयित्वा तं वसिष्ठः सगरं तदा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006221041, "chapter_id": 26221, "verse_number": "२-४९-४२", "content_sanskrit": "आस्यतामिति होवाच सह सर्वैर्नरेश्वरैः ।\nउपाविशत्ततो राजा काञ्चने परमासने ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006221042, "chapter_id": 26221, "verse_number": "२-४९-४३", "content_sanskrit": "मुनिना समनुज्ञातः सभार्यः सह राजभिः ।\nआपवस्तुनृपश्रेष्ठमुपासीनमुपह्वरे ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006221043, "chapter_id": 26221, "verse_number": "२-४९-४४", "content_sanskrit": "उवाच शृण्वतां राज्ञां शनैर्मृद्वक्षरं वचः ।\nवसिष्ठ उवाच कुशलं ननु ते राजन्वाह्येष्वाभ्यन्तरेषु च ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006221044, "chapter_id": 26221, "verse_number": "२-४९-४५", "content_sanskrit": "मन्त्रिष्वमात्यवर्गेषु राज्ये वा सकलेऽधुना ।\nदिष्ट्या च विजिताः सर्वे समग्रबलवाहनाः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006221045, "chapter_id": 26221, "verse_number": "२-४९-४६", "content_sanskrit": "अयत्नेनैव युद्धेषु भवता रिपवो हि यत् ।\nदिष्ट्यारूढप्रतिज्ञेन मम मानयता वचः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006221046, "chapter_id": 26221, "verse_number": "२-४९-४७", "content_sanskrit": "अरयस्त्यक्तधर्माणस्त्वया जीवविसर्जिताः ।\nतान्विजित्येतराञ्जेतुं पुनर्दिग्विजयेच्छया ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006221047, "chapter_id": 26221, "verse_number": "२-४९-४८", "content_sanskrit": "गतस्सवाहनबलस्त्वमित्यशृणवं वचः ।\nजितदिङ्मण्डलं भूयः श्रुत्वा त्वां नगरस्थितम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006221048, "chapter_id": 26221, "verse_number": "२-४९-४९", "content_sanskrit": "प्रीत्याहमागतो द्रष्टुमिदानीं राजसत्तम ।\nजैमिनिरुवाच वसिष्ठेनैवमुक्तस्तु सगरस्तालजङ्घजित् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006221049, "chapter_id": 26221, "verse_number": "२-४९-५०", "content_sanskrit": "कृताञ्जलिपुटो भूत्वा प्रत्युवाच महामुनिम् ।\nसगर उवाच कुशलं ननु सर्वत्र महर्षे नात्र संशयः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006221050, "chapter_id": 26221, "verse_number": "२-४९-५१", "content_sanskrit": "कल्याणाभिमुखाः सर्वे देवताश्च मुनेऽनिशम् ।\nभवान्ध्यायति कल्याणं मनसा यस्य संततम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006221051, "chapter_id": 26221, "verse_number": "२-४९-५२", "content_sanskrit": "तस्य मे चोपसर्गाश्च संभवन्ति कथं मुने ।\nभवतानुगृहीतोऽस्मि कृतार्थश्चाधुना कृतः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006221052, "chapter_id": 26221, "verse_number": "२-४९-५३", "content_sanskrit": "यन्मां द्रष्टुमिहायातः स्वयमेव भवान्गुरो ।\nयन्मह्यमाह भगवान्विपक्षविजयादिकम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006221053, "chapter_id": 26221, "verse_number": "२-४९-५४", "content_sanskrit": "तत्तथानुष्ठितं किं तु सर्वं भवदनुग्रहात् ।\nभवत्प्रसादतः सर्वं मन्ये प्राप्तं महीक्षिताम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006221054, "chapter_id": 26221, "verse_number": "२-४९-५५", "content_sanskrit": "अन्यथा मम का शक्तिः शत्रून्हन्तुं तथाविधान् ।\nअनल्पी कुरुते फल्यं यन्मे व्यवसितं भवान् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006221055, "chapter_id": 26221, "verse_number": "२-४९-५६", "content_sanskrit": "फलमल्पमपि प्रीत्यै स्यादगस्याधिरोपितुः ।\nजैमिनिरुवाच एवं संभावितः सम्यक्सगेरण महामुनिः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006221056, "chapter_id": 26221, "verse_number": "२-४९-५७", "content_sanskrit": "अभ्यनुज्ञाय तं भूयः प्रजागाम निजाश्रमम् ।\nवसिष्टे तु गते राजा सगरःप्रीतमानसः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006221057, "chapter_id": 26221, "verse_number": "२-४९-५८", "content_sanskrit": "अयोध्यायामभिवसन्प्रशशासाखिलां भुवम् ।\nभार्याभ्यां समुपेताभ्यां रूपशीलगुणादिभिः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006221058, "chapter_id": 26221, "verse_number": "२-४९-५९", "content_sanskrit": "बुभुजे विषयान्रम्यान्यथाकामं यथासुखम् ।\nसुमतिः केशिनी चोभे विकसद्वदनांबुजे ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006221059, "chapter_id": 26221, "verse_number": "२-४९-६०", "content_sanskrit": "रूपौदार्यगुणोपेते पीनवृत्तपयोधरे ।\nनीलकुञ्चितकेशाढ्ये सर्वाभरणभूषिते ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006221060, "chapter_id": 26221, "verse_number": "२-४९-६१", "content_sanskrit": "सर्वलक्षणसंपन्ने नवयौवनगोचरे ।\nप्रिये सन्निहिते तस्य नित्यं प्रियहिते रते ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006221061, "chapter_id": 26221, "verse_number": "२-४९-६२", "content_sanskrit": "स्वाचारभावचेष्टाभिर्जह्रतुस्तन्मनोऽनिशम् ।\nस चापि भरणोत्कर्षप्रतीतात्मा महीपतिः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006221062, "chapter_id": 26221, "verse_number": "२-४९-६३", "content_sanskrit": "रममाणो यथाकामं सह ताभ्यां पुरेऽवसत् ।\nअन्येषां भुवि राज्ञां तु राजशब्दो न चाप्यभूत् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006221063, "chapter_id": 26221, "verse_number": "२-४९-६४", "content_sanskrit": "गुणेन चाभवत्तस्य सगरस्य महात्मनः ।\nअल्पोऽपि धर्मः सततं यथा भवति मानसे ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006221064, "chapter_id": 26221, "verse_number": "२-४९-६५", "content_sanskrit": "रा५ तस्यार्थकामौ तु न तथा विपुलावपि ।\nअलुब्धमानसोर्ऽथं च भेजे धर्ममपीडयन् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006221065, "chapter_id": 26221, "verse_number": "२-४९-६६", "content_sanskrit": "तदर्थमेव राजेन्द्र कामं चापीडयंस्तयोः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]