[{"id": 2046720, "chapter_id": 2037, "verse_number": "६-८६-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2046721, "chapter_id": 2037, "verse_number": "६-८६-१", "content_sanskrit": "विरथं तं समासाद्य चित्रसेनं यशस्विनम् ।\nरथमारोपयामास विकर्णस्तनयस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2046722, "chapter_id": 2037, "verse_number": "६-८६-२", "content_sanskrit": "तस्मिंस्तथा वर्तमाने तुमुले संकुले भृशम्।\nभीष्मः शान्तनवस्तूर्णं युधिष्ठिरमुपाद्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2046723, "chapter_id": 2037, "verse_number": "६-८६-३", "content_sanskrit": "ततः सरथनागाश्वाः समकम्पन्त सृञ्जयाः ।\nमृत्योरास्यमनुप्राप्तं मेनिरे च युधिष्ठिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2046724, "chapter_id": 2037, "verse_number": "६-८६-४", "content_sanskrit": "युधिष्ठिरोऽपि कौरव्यो यमाभ्यां सहितः प्रभुः ।\nमहेष्वासं नरव्याघ्रं भीष्मं शान्तनवं ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2046725, "chapter_id": 2037, "verse_number": "६-८६-५", "content_sanskrit": "ततः शरसहस्राणि प्रमुञ्चन्पाण्डवो युधि ।\nभीष्मं संछादयामास यथा मेघो दिवाकरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2046726, "chapter_id": 2037, "verse_number": "६-८६-६", "content_sanskrit": "तेन सम्यक्प्रणीतानि शरजालानि मारिष ।\nप्रतिजग्राह गाङ्गयः शतशोऽथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2046727, "chapter_id": 2037, "verse_number": "६-८६-७", "content_sanskrit": "तथैव शरजालानि भीष्मोणास्तानि मारिष ।\nआकाशे समदृश्यन्त स्वगमानां व्रजा इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2046728, "chapter_id": 2037, "verse_number": "६-८६-८", "content_sanskrit": "निमेषार्धेन कौन्तेयं भीष्मः शान्तनवो युधि ।\nअदृश्यं समरे चक्रे शरजालेन भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2046729, "chapter_id": 2037, "verse_number": "६-८६-९", "content_sanskrit": "ततो युधिष्ठिरे राजा कौरव्यस्य महात्मनः ।\nनाराचं प्रेषयामास क्रुद्ध आशीविषोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2046730, "chapter_id": 2037, "verse_number": "६-८६-१०", "content_sanskrit": "असंप्राप्तं ततस्तं तु क्षुरप्रेण महारथः ।\nचच्छेद समरे राजन्भीष्मस्तस्य धनुश्च्युतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2046731, "chapter_id": 2037, "verse_number": "६-८६-११", "content_sanskrit": "तं तु च्छित्वा रणे भीष्मो नाराचं कलसंमितम् ।\nनजघ्ने कौरवेन्द्रस्य हयान्काञ्चनभूषणान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2046732, "chapter_id": 2037, "verse_number": "६-८६-१२", "content_sanskrit": "हताश्वं तु रथं त्यक्त्वा धर्मपुत्रो युधिष्ठिरः।\nआरुरोह रथं तूर्णं नकुलस्य महात्मनःक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2046733, "chapter_id": 2037, "verse_number": "६-८६-१३", "content_sanskrit": "यमावपि हि संक्रुद्धः समासाद्य रणे तदा ।\nशरैः संछादयामास भीष्मः परपुरंजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2046734, "chapter_id": 2037, "verse_number": "६-८६-१४", "content_sanskrit": "तौ तु दृष्ट्वा महाराज भीष्मबाणप्रपीडितौ।\nजगाम परमां चिन्तां भीष्मस्य वधकाङ्क्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2046735, "chapter_id": 2037, "verse_number": "६-८६-१५", "content_sanskrit": "ततो युधिष्ठिरो वश्यान्राज्ञस्तान्समचोदयत् ।\nभीष्मं शान्तनवं सर्वे निहतेति सुहृद्गणान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2046736, "chapter_id": 2037, "verse_number": "६-८६-१६", "content_sanskrit": "ततस्ते पार्थिवाः सर्वे श्रुत्वा पार्थस्य भाषितम् ।\nमहता रथवंशेन परिवव्रुः पितामहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2046737, "chapter_id": 2037, "verse_number": "६-८६-१७", "content_sanskrit": "स समन्तात्परिवृतः पिता देवव्रतस्तव।\nचिक्रीड धनुषा राजन्पातयानो महारथान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2046738, "chapter_id": 2037, "verse_number": "६-८६-१८", "content_sanskrit": "तं चरन्तं रणे पार्था ददृशुः कौरवं युधि।\nमृगमध्यं प्रविश्येव यथा सिंहशिशुं वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2046739, "chapter_id": 2037, "verse_number": "६-८६-१९", "content_sanskrit": "तर्जयानं रमे वीरांस्त्रासयानं च सायकैः ।\nदृष्ट्वा त्रेसुर्महाराज सिंहं मृगगणा इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2046740, "chapter_id": 2037, "verse_number": "६-८६-२०", "content_sanskrit": "रणे भारत सिंहस्य ददृशुः क्षत्रिया गतिम्।\nअग्नेर्वायुसहायस्य यथा कक्षं दिधक्षतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2046741, "chapter_id": 2037, "verse_number": "६-८६-२१", "content_sanskrit": "शिरांसि रथिनां भीष्मः पातयामास संयुगे।\nतालेभ्यः परिपक्वानि फलानि कुशलो नरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2046742, "chapter_id": 2037, "verse_number": "६-८६-२२", "content_sanskrit": "पतद्भिश्च महाराज शिरोभिर्धरणीतले।\nबभूव तुमुलः शब्दः पततामश्मनामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2046743, "chapter_id": 2037, "verse_number": "६-८६-२३", "content_sanskrit": "तस्मिन्सुतुमुले युद्धे वर्तमाने भयानके।\nसर्वेषामेव सैन्यानामासीद्व्यतिकरो महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2046744, "chapter_id": 2037, "verse_number": "६-८६-२४", "content_sanskrit": "भिन्नेषु तेषु व्यूहेषु क्षत्रिया इतरेतरम् ।\nएकमेकं समाहूय युद्धायैवावतस्थिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2046745, "chapter_id": 2037, "verse_number": "६-८६-२५", "content_sanskrit": "शिखण्डी तु समासाद्य भरतानां पितामहम् ।\nअभिदुद्राव वेगेन तिष्ठतिष्ठेति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2046746, "chapter_id": 2037, "verse_number": "६-८६-२६", "content_sanskrit": "अनादृत्य ततो भीष्मस्तं शिखण्डिनमाहवे ।\nप्रययौ सृञ्जयान्क्रुद्धः स्त्रीत्वं तस्य विचिन्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2046747, "chapter_id": 2037, "verse_number": "६-८६-२७", "content_sanskrit": "सृंजयास्तु ततो दृष्ट्वा हृष्टं भीष्म महारणे ।\nसिंहनादांश्च विविधांश्चक्रुः शङ्खविमिश्रितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2046748, "chapter_id": 2037, "verse_number": "६-८६-२८", "content_sanskrit": "ततः प्रववृते युद्धं व्यतिषक्तरथद्विपम् ।\nपश्चिमां दिशमासाद्य स्थिते सवितरि प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2046749, "chapter_id": 2037, "verse_number": "६-८६-२९", "content_sanskrit": "धृष्टद्युम्नोऽथ पाञ्चाल्यः सात्यकिश्च महारथः ।\nपीडयन्तौ भृशं सैन्यं शक्तितोमरवृष्टिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2046750, "chapter_id": 2037, "verse_number": "६-८६-३०", "content_sanskrit": "शस्त्रैश्च बहुभी राजञ्जघ्नतुस्तावकान्रणे ।\nते हन्यमानाः समरे तावका भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2046751, "chapter_id": 2037, "verse_number": "६-८६-३१", "content_sanskrit": "आर्यां युद्धे मतिं कृत्वा न त्यजन्ति स्म संयुगम्।\nयथोत्साहं तु समरे निजघ्नुस्तावका रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2046752, "chapter_id": 2037, "verse_number": "६-८६-३२", "content_sanskrit": "तत्राक्रन्दो महानासीत्तावकानां महात्मानाम् ।\nवध्यतां समरे राजन्पार्षतेन महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2046753, "chapter_id": 2037, "verse_number": "६-८६-३३", "content_sanskrit": "तं श्रुत्वा निनदं घोरं तावकानां महारथौ ।\nविन्दानुविन्दावावन्त्यौ पार्षतं प्रत्युपस्थितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2046754, "chapter_id": 2037, "verse_number": "६-८६-३४", "content_sanskrit": "तौ तस्य तुरगान्हत्वा त्वरमाणौ महारथौ ।\nछादयामासतुरुभौ शरवर्षेण पार्षतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2046755, "chapter_id": 2037, "verse_number": "६-८६-३५", "content_sanskrit": "अवप्लुत्याथ पाञ्चाल्यो रथात्तूर्णं महाबलः ।\nआरुरोहक रथं तूर्णं सात्यकेस्तु महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2046756, "chapter_id": 2037, "verse_number": "६-८६-३६", "content_sanskrit": "ततो युधिष्ठिरो राजा महत्या सेनया वृतः।\nआवन्त्यौ समरे क्रुद्धावभ्ययात्स परंतपौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2046757, "chapter_id": 2037, "verse_number": "६-८६-३७", "content_sanskrit": "तथैव तव पुत्रोऽपि सर्वोद्योगेन मारिष ।\nविन्दानुविन्दौ समरे परिवार्यावतस्थिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2046758, "chapter_id": 2037, "verse_number": "६-८६-३८", "content_sanskrit": "अर्जुनश्चापि संक्रुद्धः क्षत्रियान्क्षत्रियर्षभः ।\nअयोधयत संग्रामे वज्रपाणिरिवासुरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2046759, "chapter_id": 2037, "verse_number": "६-८६-३९", "content_sanskrit": "द्रोणास्तु समरे क्रुद्धः पुत्रस्य प्रियकृत्तव ।\nव्यधमत्सर्वपाञ्चालांस्तूलराशिमिवानलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2046760, "chapter_id": 2037, "verse_number": "६-८६-४०", "content_sanskrit": "दुर्योधनपुरोगास्तु पुत्रास्तव विशांपते ।\nपरिवार्य रणे भीष्मं युयुधुः पाण्डवैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2046761, "chapter_id": 2037, "verse_number": "६-८६-४१", "content_sanskrit": "ततो दुर्योधनो राजा लोहितायति भास्करे।\nअब्रवीत्तावकान्सर्वांस्त्वरध्वमिति भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2046762, "chapter_id": 2037, "verse_number": "६-८६-४२", "content_sanskrit": "युध्यतां तु तथा तेषां कुर्वतां कर्म दुष्करम्।\nअस्तं गिरिमथारूढे अप्रकाशति भास्करे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2046763, "chapter_id": 2037, "verse_number": "६-८६-४३", "content_sanskrit": "प्रावर्तत नदी घोरा शोणितौघतरङ्गिणी ।\nगोमायुगणसंकीर्णा क्षणेन क्षणदामुखे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2046764, "chapter_id": 2037, "verse_number": "६-८६-४४", "content_sanskrit": "शिवाभिरशिवाभिश्च रुवद्भिर्भैरवं रवम्।\nघोरमायोधनं जज्ञे भूतसङ्घैः समाकुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2046765, "chapter_id": 2037, "verse_number": "६-८६-४५", "content_sanskrit": "राक्षसाश्च पिशाचाश्च तथान्ये पिशिताशिनः ।\nसमन्ततो व्यदृश्यन्त शतशोऽथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2046766, "chapter_id": 2037, "verse_number": "६-८६-४६", "content_sanskrit": "अर्जुनोऽथ सुशर्मादीन्राज्ञस्तान्सपदानुगान्।\nविजित्य पृतनामध्ये ययौ स्वशिबिरं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2046767, "chapter_id": 2037, "verse_number": "६-८६-४७", "content_sanskrit": "युधिष्ठिरोऽपि कौरव्यो भ्रातृभ्यां सहितस्तथा।\nययौ स्वशिबिरं राजा निशायां सेनया वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2046768, "chapter_id": 2037, "verse_number": "६-८६-४८", "content_sanskrit": "भीमसेनोऽपि राजेन्द्र दुर्योधनमुखान्रथान् ।\nअवजित्य ततः सङ्ख्ये ययौ स्वशिबिरं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2046769, "chapter_id": 2037, "verse_number": "६-८६-४९", "content_sanskrit": "दुर्योधनोऽपि नृपतिः परिवार्य महारणे।\nभीष्मं शान्तनवं तूर्णं प्रयातः शिबिरं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2046770, "chapter_id": 2037, "verse_number": "६-८६-५०", "content_sanskrit": "द्रोणो द्रौणिः कृपः शल्यः कृतवर्मा च सात्वतः ।\nपरिवार्य चमूं सर्वाः प्रययुः शिबिरं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2046771, "chapter_id": 2037, "verse_number": "६-८६-५१", "content_sanskrit": "तथैव सात्यकी राजन्धृष्टद्युम्नश्च पार्षतः।\nपरिवार्य रणे योधान्ययतुः शिबिरं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2046772, "chapter_id": 2037, "verse_number": "६-८६-५२", "content_sanskrit": "एवमेते महाराज तावकाः पाण्डवैः सह।\nपर्यवर्तन्त सहिता निशाकाले परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2046773, "chapter_id": 2037, "verse_number": "६-८६-५३", "content_sanskrit": "ततः स्वशिबिरं गत्वा पाण्डवाः कुरवस्तथा ।\nन्यवसन्त महाराज पूजयन्तः परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2046774, "chapter_id": 2037, "verse_number": "६-८६-५४", "content_sanskrit": "रक्षां कृत्वा ततः शूरा न्यस्य गुल्मान्यथाविधि।\nअपनीय च शल्यानि स्नात्वा च विविधैर्जलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2046775, "chapter_id": 2037, "verse_number": "६-८६-५५", "content_sanskrit": "कृतस्वस्त्ययनाः सर्वे स्तूयमानाश्च बन्दिभिः ।\nगीतवादित्रशब्देन व्यक्रीडन्त यशस्विनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2046776, "chapter_id": 2037, "verse_number": "६-८६-५६", "content_sanskrit": "मुहूर्तादिव तत्सर्वमभवत्स्वर्गसन्निभम् ।\nन हि युद्धकथां कांचित्तत्राकुर्वन्महारथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2046777, "chapter_id": 2037, "verse_number": "६-८६-५७", "content_sanskrit": "ते प्रसुप्ते बले तत्र परिश्रान्तजने नृप ।\nहस्त्यश्वबहुले रात्रौ प्रेक्षणीये बभूवतुः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2046778, "chapter_id": 2037, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि सप्तमदिवसयुद्धे षडशीतितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]