[{"id": 2136913, "chapter_id": 3968, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2136914, "chapter_id": 3968, "verse_number": "१", "content_sanskrit": "अथ कन्याप्रदाने स तमेवार्थं विचिन्तयन् ।\nसमानिन्ये च तत् सर्वं भाण्डं वैवाहिकं नृपः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2136915, "chapter_id": 3968, "verse_number": "२", "content_sanskrit": "ततो वृद्धान् द्विजान् सर्वानृत्विजः सपुरोहितान् ।\nसमाहूय दिने पुण्ये प्रययौ सह कन्यया \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2136916, "chapter_id": 3968, "verse_number": "३", "content_sanskrit": "मेध्यारण्यं स गत्वा च द्युमत्सेनाश्रमं नृपः ।\nपद्भ्यामेव द्विजैः सार्धं राजर्षिं तमुपागमत् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2136917, "chapter_id": 3968, "verse_number": "४", "content_sanskrit": "तत्रापश्यन्महाभागं शा(सा)लवृक्षमुपाश्रितम् ।\nकौश्यां बृस्यां समासीनं चक्षुर्हीनं नृपं तदा \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2136918, "chapter_id": 3968, "verse_number": "५", "content_sanskrit": "स राजा तस्य राजर्षेः कृत्वा पूजां यथार्हतः ।\nवाचा सुनियतो भूत्वा चकारात्मनिवेदनम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2136919, "chapter_id": 3968, "verse_number": "६", "content_sanskrit": "तस्यार्घ्यमासनं चैव गां चावेद्य स धर्मवित् ।\nकिमागमनमित्येवं राजा राजानमब्रवीत् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2136920, "chapter_id": 3968, "verse_number": "७", "content_sanskrit": "तस्य सर्वमभिप्रायमितिकर्तव्यतां च ताम् ।\nसत्यवन्तं समुद्दिश्य सर्वमेव न्यवेदयत् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2136921, "chapter_id": 3968, "verse_number": "", "content_sanskrit": "अश्वपतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2136922, "chapter_id": 3968, "verse_number": "८", "content_sanskrit": "सावित्री नाम राजर्षे कन्येयं मम शोभना ।\nतां स्वधर्मेण धर्मज्ञ स्नुषार्थे त्वं गृहाण मे \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2136923, "chapter_id": 3968, "verse_number": "", "content_sanskrit": "द्युमत्सेनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2136924, "chapter_id": 3968, "verse_number": "९", "content_sanskrit": "च्युताः स्म राज्याद् वनवासमाश्रिता-\nश्चराम धर्मं नियतास्तपस्विनः ।\nकथं त्वनर्हा वनवासमाश्रमे\nनिवत्स्यते क्लेशमिमं सुता तव \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2136925, "chapter_id": 3968, "verse_number": "", "content_sanskrit": "अश्वपतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2136926, "chapter_id": 3968, "verse_number": "१०", "content_sanskrit": "सुखं च दुःखं च भवाभवात्मकं\nयथा विजानाति सुताहमेव च ।\nन मद्विधे युज्यति वाक्यमीदृशं\nविनिश्चयेनाभिगतोऽस्मि ते नृप \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2136927, "chapter_id": 3968, "verse_number": "११", "content_sanskrit": "आशां नार्हसि मे हन्तुं सौहृदात् प्रणतस्य च ।\nअभितश्चागतं प्रेम्णा प्रत्याख्यातुं न माऽर्हसि \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2136928, "chapter_id": 3968, "verse_number": "१२", "content_sanskrit": "अनुरूपो हि युक्तश्च त्वं ममाहं च वै तव ।\nस्नुषां प्रतीच्छ मे कन्यां भार्यां सत्यवतस्ततः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2136929, "chapter_id": 3968, "verse_number": "", "content_sanskrit": "द्युमत्सेनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2136930, "chapter_id": 3968, "verse_number": "१३", "content_sanskrit": "पूर्वमेवाभिलषितः सम्बन्धो मे त्वया सह ।\nभ्रष्टराज्यस्त्वहमिति तत एतद् विचारितम् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2136931, "chapter_id": 3968, "verse_number": "१४", "content_sanskrit": "अभिप्रायस्त्वयं यो मे पूर्वमेवाभिकाङ्क्षितः ।\nस निर्वर्ततु मेऽद्यैव काङ्क्षितो ह्यसि मेऽतिथिः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2136932, "chapter_id": 3968, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2136933, "chapter_id": 3968, "verse_number": "१५", "content_sanskrit": "ततः सर्वान् समानाय्य द्विजानाश्रमवासिनः ।\nयथाविधि समुद्वाहं कारयामासतुर्नृपौ \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2136934, "chapter_id": 3968, "verse_number": "१६", "content_sanskrit": "दत्त्वा सोऽश्वपतिः कन्यां यथार्हं सपरिच्छदम् ।\nययौ स्वमेव भवनं युक्तः परमया मुदा \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2136935, "chapter_id": 3968, "verse_number": "१७", "content_sanskrit": "सत्यवानपि तां भार्यां लब्ध्वा सर्वगुणान्विताम् ।\nमुमुदे सा च तं लब्ध्वा भर्तारं मनसेप्सितम् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2136936, "chapter_id": 3968, "verse_number": "१८", "content_sanskrit": "गते पितरि सर्वाणि संन्यस्याभरणानि सा ।\nजगृहे वल्कलान्येव वस्त्रं काषायमेव च \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2136937, "chapter_id": 3968, "verse_number": "१९", "content_sanskrit": "परिचारैर्गुणैश्चैव प्रश्रयेण दमेन च ।\nसर्वकामक्रियाभिश्च सर्वेषां तुष्टिमादधे \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2136938, "chapter_id": 3968, "verse_number": "२०", "content_sanskrit": "श्वश्रूं शरीरसत्कारैः सर्वैराच्छादनादिभिः ।\nश्वशुरं देवसत्कारैर्वाचः संयमनेन च \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2136939, "chapter_id": 3968, "verse_number": "२१", "content_sanskrit": "तथैव प्रियवादेन नैपुणेन शमेन च ।\nरहश्चैवोपचारेण भर्तारं पर्यतोषयत् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2136940, "chapter_id": 3968, "verse_number": "२२", "content_sanskrit": "एवं तत्राश्रमे तेषां तदा निवसतां सताम् ।\nकालस्तपस्यतां कश्चिदपाक्रामत भारत \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2136941, "chapter_id": 3968, "verse_number": "२३", "content_sanskrit": "सावित्र्या ग्लायमानायास्तिष्ठन्त्यास्तु दिवानिशम् ।\nनारदेन यदुक्तं तद्वाक्यं मनसि वर्तते \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2136942, "chapter_id": 3968, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि चतुरशीत्यधिकद्विशततमोऽध्यायः ॥२८४॥\nपतिव्रतामाहात्म्यपर्वणि सावित्र्युपाख्याने तृतीयोऽध्यायः ॥३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]