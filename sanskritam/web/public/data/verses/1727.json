[{"id": 2033697, "chapter_id": 1727, "verse_number": "४-५०-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2033698, "chapter_id": 1727, "verse_number": "४-५०-१", "content_sanskrit": "कृपस्य वचनं श्रुत्वा कर्णो राजन्युधांपतिः ।\nपुनः प्रोवाच संरब्धो गर्हयन्ब्राह्मणं कृपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2033699, "chapter_id": 1727, "verse_number": "४-५०-२x", "content_sanskrit": "कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2033700, "chapter_id": 1727, "verse_number": "४-५०-२", "content_sanskrit": "लक्षयाम्यहमाचार्यं भयाद्भक्तिं गतं रिपौ ।\nभीतेन हि न योद्धव्यमहं योत्स्ये धनञ्जयम् ॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2033701, "chapter_id": 1727, "verse_number": "४-५०-३", "content_sanskrit": "ननु वारुणमाग्नेयं याम्यं वायव्यमेव च।\nअस्त्रं ब्रह्मशिरश्चैव सत्वहीनस्य ते वृथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2033702, "chapter_id": 1727, "verse_number": "४-५०-४", "content_sanskrit": "मित्रकार्यं कृतमिदं पितापुत्रैर्महारथैः ।\nभर्तृपिण्डश्च निर्विष्टो यथेष्टं गन्तुमर्हथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2033703, "chapter_id": 1727, "verse_number": "४-५०-५", "content_sanskrit": "भिक्षां हरस्व नित्यं त्वं यज्ञाननुचरस्व च।\nआमन्त्रणानि भुङ्क्षाद्य माऽस्मान्युद्धेन भीषय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2033704, "chapter_id": 1727, "verse_number": "४-५०-६", "content_sanskrit": "भार्गवास्त्रं मया मुक्तं निर्दहेत्पृथिवीमिमाम्।\nकिं पुनः पाण्डुपुत्राणामेकमर्जुनमाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2033705, "chapter_id": 1727, "verse_number": "४-५०-७", "content_sanskrit": "आगमिष्यन्ति पदवीं मात्स्याः पाण्डवमाश्रिताः ।\nकीचकानां तु बलिनां शत्रुसेनावमर्दिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2033706, "chapter_id": 1727, "verse_number": "४-५०-८", "content_sanskrit": "तानहं निहनिष्यामि भवता गम्यतां गृहम् ।\nकिं वेदवादिनां कार्यं परस्नेहानुभाषिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2033707, "chapter_id": 1727, "verse_number": "४-५०-९", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा अश्वत्थामा प्रतापवान् ।\nउवाच वदतांश्रेष्ठो दुर्योधनमवेक्ष्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2033708, "chapter_id": 1727, "verse_number": "४-५०-१०", "content_sanskrit": "न च तावञ्जिता गावो न च सीमान्तरं गताः।\nन हास्तिनपुरं प्राप्तास्त्वं च कर्ण विकत्थसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2033709, "chapter_id": 1727, "verse_number": "४-५०-११", "content_sanskrit": "बहूनि धर्मशास्त्राणि पठन्ति द्विजसत्तमाः ।\nतेषु किंस्विदिदं दृष्टं द्यूते जीयेत यन्नृपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2033710, "chapter_id": 1727, "verse_number": "४-५०-१२", "content_sanskrit": "संग्रामान्विपुलाञ्जित्वा लब्धा च विपुलं धनम् ।\nविजित्य च महीं कृत्स्नां नेह कत्थन्ति पण्डिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2033711, "chapter_id": 1727, "verse_number": "४-५०-१३", "content_sanskrit": "पचत्यग्निरवाक्यस्तु तूष्णीं भाति दिवाकरः ।\nतूष्णीं धारयते लोकान्वसुधा सचराचरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2033712, "chapter_id": 1727, "verse_number": "४-५०-१४", "content_sanskrit": "चातुर्वर्ण्यस्य कर्माणि विहितानि महर्षिभिः ।\nधनं यैरधिगन्तव्यं यच्च कुर्वन्न दुष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2033713, "chapter_id": 1727, "verse_number": "४-५०-१५", "content_sanskrit": "अधीत्य ब्राह्मणो वेदान्याजयेत यजेत वा ।\nक्षत्रियो धनमाहृत्य यजेतैव न याजयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2033714, "chapter_id": 1727, "verse_number": "४-५०-१६", "content_sanskrit": "वैश्योऽधिगम्य वित्तानि वार्ताकर्माणि कारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2033715, "chapter_id": 1727, "verse_number": "४-५०-१७", "content_sanskrit": "शूद्रः शुश्रूषणं कुर्यात्रिषु वर्णेषु नित्यशः।\nवन्दनायोगविधिभिर्वैतसीं वृत्तिमाश्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2033716, "chapter_id": 1727, "verse_number": "४-५०-१८", "content_sanskrit": "वर्तमाना यथाशास्त्रं प्राप्य चापि महीमिमाम् ।\nप्रकुर्वन्ति महाभागा यज्ञान्सुविपुलानपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2033717, "chapter_id": 1727, "verse_number": "४-५०-१९", "content_sanskrit": "का जातिस्तेषु सूतेयं केऽपि मन्त्राः क्रियाश्च काः ।\nकेयं वर्णेषु या राज्ञो वक्तृभोक्तृनियन्तृषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2033718, "chapter_id": 1727, "verse_number": "४-५०-२०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2033719, "chapter_id": 1727, "verse_number": "४-५०-२०", "content_sanskrit": "दुर्योधनमभिप्रेक्ष्य कर्णं च कुरुसंसाद।\nअश्वत्थामा भृशं क्रुद्धो दुर्योधनमतर्जयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2033720, "chapter_id": 1727, "verse_number": "४-५०-२१", "content_sanskrit": "प्राप्य द्यूतेन को राज्यं क्षत्रियः स्तोष्टुर्महति ।\nतथा नृशंसरूपोयं धार्तराष्ट्रश्च निर्घृणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2033721, "chapter_id": 1727, "verse_number": "४-५०-२२", "content_sanskrit": "तथाऽधिगम्य वित्तानि को विकत्थेद्विचक्षणः ।\nनिकृत्या वञ्चनायोगैश्चरन्वैतंसिको यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2033722, "chapter_id": 1727, "verse_number": "४-५०-२३", "content_sanskrit": "कतमद्द्वैरथं युद्धं यत्राजैषीर्धनञ्जयम्।\nनकुलं सहदेवं वा धनं येषां त्वया हृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2033723, "chapter_id": 1727, "verse_number": "४-५०-२४", "content_sanskrit": "युधिष्ठिरो जितः कस्मिन्भीमश्च बलिनांवरः ।\nइन्द्रप्रस्थं त्वया कस्मिन्संग्रामे निर्जितं पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2033724, "chapter_id": 1727, "verse_number": "४-५०-२५", "content_sanskrit": "तथैव कतमद्युद्धं यस्मिन्कृष्णा जिता त्वया ।\nएकवस्त्रा सभां नीता क्षुद्रकर्मन्रजस्वला ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2033725, "chapter_id": 1727, "verse_number": "४-५०-२६", "content_sanskrit": "मूलमेषां महत्कृत्तं सारार्थी चन्दनं यथा।\nक्षुद्रं कर्म समास्थाय तत्र किं विदुरोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2033726, "chapter_id": 1727, "verse_number": "४-५०-२७", "content_sanskrit": "यथाशक्ति मनुष्याणाममर्षं लक्षयामहे।\nअन्येषामपि सत्वानामपि कीटपिपीलिकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2033727, "chapter_id": 1727, "verse_number": "४-५०-२८", "content_sanskrit": "द्रौपद्याः संपरिक्लेशं न क्षन्तुं पाण्डवोऽर्हति।\nक्षयाय धार्तराष्ट्राणां प्रादुर्भूतो धनञ्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2033728, "chapter_id": 1727, "verse_number": "४-५०-२९", "content_sanskrit": "त्वं पुनः पण्डितो भूत्वा ह्याचार्यं क्षेप्तुमिच्छसि।\nवैरान्तकरणो जिष्णुर्न नः शेषं करिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2033729, "chapter_id": 1727, "verse_number": "४-५०-३०", "content_sanskrit": "नैव देवा न गन्धर्वा नासुरा न च राक्षसाः।\nभयादिह न युद्ध्येरन्पाण्डुपुत्रेण धीमता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2033730, "chapter_id": 1727, "verse_number": "४-५०-३१", "content_sanskrit": "यं यमेकोपि संक्रुद्धः संग्रामे निपतिष्यति ।\nवृक्षं गरुडवद्वेगाद्विनिहत्यान्तमेष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2033731, "chapter_id": 1727, "verse_number": "४-५०-३२", "content_sanskrit": "त्वत्तो विशिष्टं वीर्येण धनुष्यमरराट्समम् ।\nवासुदेवसमं युद्धे तं पार्थं को न पूजयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2033732, "chapter_id": 1727, "verse_number": "४-५०-३३", "content_sanskrit": "देवं दैवेन युद्ध्येत मानुपेण च मानुपम् ।\nअस्त्रं ह्यस्त्रेण यो हन्यात्कोऽर्जुनेन समः पुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2033733, "chapter_id": 1727, "verse_number": "४-५०-३४", "content_sanskrit": "पुत्रादनवमः शिष्य इति धर्मविदो विदुः।\nएतेनापि निमित्तेन प्रियो द्रोणस्य पाण्डवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2033734, "chapter_id": 1727, "verse_number": "४-५०-३५", "content_sanskrit": "यथा त्वमकरोर्द्यूतमिन्द्रप्रस्थं यथाऽहरः ।\nयथाऽनैषीः सभां कृष्णां तथा युध्यस्व पाण्डवं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2033735, "chapter_id": 1727, "verse_number": "४-५०-३६", "content_sanskrit": "अयं ते मातुलः प्राज्ञः क्षत्रधर्मस्य कोविदः ।\nदुर्द्यूतदेवी गान्धारः शकुनिर्युद्ध्यतामिह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2033736, "chapter_id": 1727, "verse_number": "४-५०-३७", "content_sanskrit": "नाक्षान्क्षिपति गाण्डीवं न कृतं द्वापरं न च।\nज्वलतो निशितान्बाणांस्तांस्तान्क्षिपति गाण्डिवं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2033737, "chapter_id": 1727, "verse_number": "४-५०-३८", "content_sanskrit": "न हि गाण्डीवनिर्मुक्ता गृध्रपक्षाः सुतेजनाः ।\nनान्तरेष्ववतिष्ठन्ते गिरीणामपि दारणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2033738, "chapter_id": 1727, "verse_number": "४-५०-३९", "content_sanskrit": "अन्तकः पवनो मृत्युस्तथाऽग्निर्बडवामुखः ।\nकुर्युरेते क्वचिच्छेषं न तु क्रुद्धो धनञ्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2033739, "chapter_id": 1727, "verse_number": "४-५०-४०", "content_sanskrit": "यथा सभायां द्यूतं त्वं मातुलेन महाकरोः ।\nतथा युद्धस्व संग्रामे सौबलेन सुरक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2033740, "chapter_id": 1727, "verse_number": "४-५०-४१", "content_sanskrit": "युद्ध्यतां काममाचार्यो नाहं योत्स्ये धनञ्जयम् ।\nमत्स्यो ह्यस्माभिरायोध्यो यद्यागच्छेद्गवांपदम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2033741, "chapter_id": 1727, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि गोग्रहणपर्वणि पञ्चाशोऽध्यायः ॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]