[{"id": 7005959000, "chapter_id": 25959, "verse_number": "१-१४२-१", "content_sanskrit": "ब्रह्मोवाच । विंशादीन्पालयामास ह्यवतीर्णो हरिः प्रभुः ।\nदैत्यधर्मस्य नाशार्थं वेदधर्मादिगुप्तये ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005959001, "chapter_id": 25959, "verse_number": "१-१४२-२", "content_sanskrit": "मत्स्यादिकस्वरूपेण त्ववतारं करोत्यजः ।\nमत्स्यो भूत्वा हयग्रीवं दैत्यं हत्वाजिकण्टकम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005959002, "chapter_id": 25959, "verse_number": "१-१४२-३", "content_sanskrit": "वेदानानीय मन्वादीन्पालयामास केशवः ।\nमन्दरं धारयामास कूर्मो भूत्वा हिताय च ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005959003, "chapter_id": 25959, "verse_number": "१-१४२-४", "content_sanskrit": "क्षीरोदमथने वै द्यो देवो धन्वन्तरिर्ह्र्भूत् ।\nबिभ्रत्कमण्डलुं पूर्णममृतेन समुत्थितः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005959004, "chapter_id": 25959, "verse_number": "१-१४२-५", "content_sanskrit": "आयुर्वेदमथाष्टाङ्गं सुश्रुताय स उक्तवान ।\nअमृतं पाययामास स्त्रीरूपी च सुरान्हरिः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005959005, "chapter_id": 25959, "verse_number": "१-१४२-६", "content_sanskrit": "अवतीर्णो वराहोऽथ हिरण्याक्षं जघन ह ।\nपृथिवीं धारयामास पालयामास देवताः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005959006, "chapter_id": 25959, "verse_number": "१-१४२-७", "content_sanskrit": "नरसिंहोऽवर्तोर्णोऽथ हिरण्यकशिपुंरिपुम्। ।\nदैत्यान्निहतवान्वेदधर्मादीनभ्यपालयत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005959007, "chapter_id": 25959, "verse_number": "१-१४२-८", "content_sanskrit": "ततः परशुरामोऽभूज्जमदग्नेर्जगत्प्रभुः ।\nत्रिः सप्तकृत्वः पृथिवीं चक्रे निः क्षत्त्रियां हरिः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005959008, "chapter_id": 25959, "verse_number": "१-१४२-९", "content_sanskrit": "कार्तवीर्यं जघानाजौ कश्यपाय महीं ददौ ।\nयागं कृत्वा महाबाहुर्महेन्द्रे पर्वते स्थितः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005959009, "chapter_id": 25959, "verse_number": "१-१४२-१०", "content_sanskrit": "ततो रामो भविष्णुश्च चतुर्धा दुष्टर्मदनः ।\nपुत्रो दशरथाज्जज्ञे रामश्च भरतोऽनुजः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005959010, "chapter_id": 25959, "verse_number": "१-१४२-११", "content_sanskrit": "लक्ष्मणश्चाथ शत्रुघ्नो रामभार्या च जानक। ।\nरामश्च पितृसत्यार्थं मातृभ्यो हितमाचरन् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005959011, "chapter_id": 25959, "verse_number": "१-१४२-१२", "content_sanskrit": "शृङ्गवेरं चित्रकूटं दण्डकारण्यमागतः ।\nनासां शूर्पणखायाश्च च्छित्त्वाथ खरदूषणम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005959012, "chapter_id": 25959, "verse_number": "१-१४२-१३", "content_sanskrit": "हत्वा स राक्षसं सीतापहारिरजनीचरम् ।\nरावणं चानुजं तस्य लङ्कापुर्यां विभीषणम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005959013, "chapter_id": 25959, "verse_number": "१-१४२-१४", "content_sanskrit": "रक्षोराज्ये च संस्थाप्य सुग्रीवनुमन्मुखैः ।\nआरुह्य पुष्पकं सार्धं सीतया पतिभक्तया ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005959014, "chapter_id": 25959, "verse_number": "१-१४२-१५", "content_sanskrit": "लक्ष्मणेनानुकूलेन ह्ययोध्यां स्वपुरीं गतः ।\nराज्यं चकार देवादीन्पालयामास स प्रजाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005959015, "chapter_id": 25959, "verse_number": "१-१४२-१६", "content_sanskrit": "धर्मसंरक्षणं चक्रे ह्यश्वमेधादिकान्कतून् ।\nसा महीपतिना रेमे रामेणैव यथासुखम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005959016, "chapter_id": 25959, "verse_number": "१-१४२-१७", "content_sanskrit": "रावणस्य गृहे सीता स्थिता भेजे न रावणम। ।\nकर्मणा मनसा वाचा सा गता राघवं सदा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005959017, "chapter_id": 25959, "verse_number": "१-१४२-१८", "content_sanskrit": "पतिव्रता तु सा सीता ह्यनसूया यथैव तु ।\nपतिव्रताया माहात्म्यं शृणु त्वं कथयाम्यहम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005959018, "chapter_id": 25959, "verse_number": "१-१४२-१९", "content_sanskrit": "कौशिको ब्राह्मणः कुष्ठी प्रतिष्ठानेऽभवत्पुरा ।\nतं तथा व्याधितं भार्या पतिं देवमिवार्चयत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005959019, "chapter_id": 25959, "verse_number": "१-१४२-२०", "content_sanskrit": "निर्भर्त्सितापि भर्तारं तममन्यत दैवतम् ।\nभर्त्रोक्ता सानयद्वेश्यां शुल्कमादाय चाधिकम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005959020, "chapter_id": 25959, "verse_number": "१-१४२-२१", "content_sanskrit": "पथि सूले तदा प्रोतमचौरं चौरशङ्कया ।\nमाण्डव्यमतिदुः खार्तमन्धकारेऽथ स द्विजः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005959021, "chapter_id": 25959, "verse_number": "१-१४२-२२", "content_sanskrit": "पत्नीस्कन्धसमारूढश्चालयामास कौशिकः ।\nपादावमर्शणत्क्रुद्धो माण्डव्यस्तमुवाच ह ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005959022, "chapter_id": 25959, "verse_number": "१-१४२-२३", "content_sanskrit": "सूर्योदये मृतिस्तस्य येनाहं चालितः पदा ।\nतच्छ्रुत्वा प्राह तद्भार्या सूर्यो नोदयमेष्यति ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005959023, "chapter_id": 25959, "verse_number": "१-१४२-२४", "content_sanskrit": "ततः सूर्योदयाभावाद भवत्सततं निशा ।\nबहून्यब्दप्रमाणानि ततो देवा भयं ययुः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005959024, "chapter_id": 25959, "verse_number": "१-१४२-२५", "content_sanskrit": "ब्रह्माणं शरणं जग्मुस्तामूचे पद्मसम्भवः ।\nप्रशाम्यते तेजसैव तपस्तेजस्त्वनेन वै ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005959025, "chapter_id": 25959, "verse_number": "१-१४२-२६", "content_sanskrit": "पतिव्रताया माहात्म्यान्नोद्गच्छति दिवाकरः ।\nतस्य चानुदयाद्धानिर्मर्त्यानां भवतां तथा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005959026, "chapter_id": 25959, "verse_number": "१-१४२-२७", "content_sanskrit": "तस्मात्पतिव्रतामत्रेरनसूयां तपस्विनीम् ।\nप्रसादयत वै पत्नीं भानोरुदयकाम्यया ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005959027, "chapter_id": 25959, "verse_number": "१-१४२-२८", "content_sanskrit": "तैः सा प्रसादिता गत्वा ह्यनसूया पतिव्रता ।\nकृत्वादित्योदयं सा च तं भर्तारमजयत् ।\nपतिव्रतानसूयायाः सीताभूदधिका किल ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]