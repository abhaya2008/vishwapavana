[{"id": 2024889, "chapter_id": 1533, "verse_number": "३-१७१-०x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2024890, "chapter_id": 1533, "verse_number": "३-१७१-१", "content_sanskrit": "ततोऽहं स्तूयमानस्तु तत्रतत्र सुरपिभिः।\nअपश्यमुदधिं भीममपांपतिमथाव्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2024891, "chapter_id": 1533, "verse_number": "३-१७१-२", "content_sanskrit": "फेनवत्यः प्रकीर्णाश्च संहताश्च समुच्छिताः।\nऊर्मयश्चात्र दृश्यन्ते चलन्तइव पर्वताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2024892, "chapter_id": 1533, "verse_number": "३-१७१-३", "content_sanskrit": "नावः सहस्रशस्तत्र रत्नपूर्णाः समन्ततः।\n`नभसीव विमानानि विचरन्त्यो विरेजिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2024893, "chapter_id": 1533, "verse_number": "३-१७१-४", "content_sanskrit": "तिमिङ्गिलाः कच्छपाश् तथा तिमितिभिङ्गिलाः।\nमकराश्चात्र दृश्यन्ते जले मप्रा इवाद्रयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2024894, "chapter_id": 1533, "verse_number": "३-१७१-५", "content_sanskrit": "शङ्खानां च महबाणि मग्रान्यप्सु ममन्ततः।\nदृश्यन्ते स्म यथा रात्रौ तारास्तन्वभ्रमंवृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2024895, "chapter_id": 1533, "verse_number": "३-१७१-६", "content_sanskrit": "तथा सहस्रशस्तत्ररत्नसङ्घाः प्लवन्त्युत।\nवायुश् घृर्णते भीमस्तदद्भुतमिवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2024896, "chapter_id": 1533, "verse_number": "३-१७१-७", "content_sanskrit": "तमतीत्य महावेगं सर्वाम्भोनिधिमुत्तमम्।\nअपश्यं दानवाकीर्णं तद्दैत्यपुरमन्तिकात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2024897, "chapter_id": 1533, "verse_number": "३-१७१-८", "content_sanskrit": "तत्रैव मातलिस्तृणं निपात्य पृथिवीतले।\nदानवान्रथघोपेण तन्पुरं समुपाद्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2024898, "chapter_id": 1533, "verse_number": "३-१७१-९", "content_sanskrit": "रथघोषं तु तं श्रुत्वा स्तनयित्नोग्विम्बरे।\nमन्वाना देवराजं मामाविग्ना दानवाऽभवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2024899, "chapter_id": 1533, "verse_number": "३-१७१-१०", "content_sanskrit": "सर्वे संभ्रान्तमनसः शग्चापधराः स्थिताः।\nतथाऽसिशूलपरशुगदामुसलपाणयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2024900, "chapter_id": 1533, "verse_number": "३-१७१-११", "content_sanskrit": "ततो द्वाराणि पिदधुर्दानवास्त्रस्तचेतसः।\nसंविधाय पुरे रक्षां न स्म कश्चन दृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2024901, "chapter_id": 1533, "verse_number": "३-१७१-१२", "content_sanskrit": "ततः शङ्खमुपादाय देवदत्तं महास्वनम्।\nपरमां मुदमाश्रित्य प्राधमं तं शनैरहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2024902, "chapter_id": 1533, "verse_number": "३-१७१-१३", "content_sanskrit": "स तु शब्दो दिवं स्तब्ध्वा प्रतिशब्दमजीजनत्।\nवित्रेसुश्च निलिल्युश्च भूतानि सुमहान्त्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2024903, "chapter_id": 1533, "verse_number": "३-१७१-१४", "content_sanskrit": "ततो निवातकवचाः सर्व एव समन्ततः।\nदंशिता विविधैस्त्राणैर्विचित्रायुपाणयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2024904, "chapter_id": 1533, "verse_number": "३-१७१-१५", "content_sanskrit": "आयसैश्र महाशूलैर्गदाभिर्मुसलैरपि।\nपट्टसैः करवालैश्च रथचक्रैश्च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2024905, "chapter_id": 1533, "verse_number": "३-१७१-१६", "content_sanskrit": "शतघ्नीभिर्भुशुण्डीभिः खङ्गैश्चित्रैः स्वलंकृतैः।\nप्रगृहीतैर्दितेः पुत्राः प्रादुरासन्सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2024906, "chapter_id": 1533, "verse_number": "३-१७१-१७", "content_sanskrit": "ततो विचार्य बहुशो रथमार्गेषु तान्हयान्।\nप्राचोदयत्समे देशे मातलिर्भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2024907, "chapter_id": 1533, "verse_number": "३-१७१-१८", "content_sanskrit": "तेन तेषां प्रणुन्नानासाशुत्वाच्छीघ्रगामिनाम्।\nनान्वपश्यत्तदा कश्रित्तन्मेऽद्भुतमिवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2024908, "chapter_id": 1533, "verse_number": "३-१७१-१९", "content_sanskrit": "ततस्ते दानवास्तत्रयोधवातान्यनेकशः।\nविकृतस्वररूपाणि भृशं सर्वाण्यचोदयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2024909, "chapter_id": 1533, "verse_number": "", "content_sanskrit": "तेन शब्देन सहसा समुद्रे पर्वतोपमाः।\nआप्लवन्त गतैः सत्वैर्मत्स्याः शतसहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]