[
  {
    "id": 16793001,
    "chapter_id": 6193,
    "verse_number": "3.1",
    "content_sanskrit": "उपासनाश्रितो धर्मो जाते ब्रह्मणि वर्तते ।\nप्रागुत्पत्तेरजं सर्वं तेनासौ कृपणः स्मृतः ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "base_unit_id": "MK_C03_K01"
  },
  {
    "id": 16793002,
    "chapter_id": 6193,
    "verse_number": "3.2",
    "content_sanskrit": "अतो वक्ष्याम्यकार्पण्यमजाति समतां गतम् ।\nयथा न जायते किञ्चिज्जायमानं समन्ततः ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "base_unit_id": "MK_C03_K02"
  },
  {
    "id": 16793003,
    "chapter_id": 6193,
    "verse_number": "3.3",
    "content_sanskrit": "आत्मा ह्याकाशवज्जीवैर्घटाकाशैरिवोदितः ।\nघटादिवच्च सङ्घातैर्जातावेतन्निदर्शनम् ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "base_unit_id": "MK_C03_K03"
  },
  {
    "id": 16793004,
    "chapter_id": 6193,
    "verse_number": "3.4",
    "content_sanskrit": "घटादिषु प्रलीनेषु घटाकाशादयो यथा ।\nआकाशे सम्प्रलीयन्ते तद्वज्जीवा इहात्मनि ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "base_unit_id": "MK_C03_K04"
  },
  {
    "id": 16793005,
    "chapter_id": 6193,
    "verse_number": "3.5",
    "content_sanskrit": "यथैकस्मिन्घटाकाशे रजोधूमादिभिर्युते ।\nन सर्वे सम्प्रयुज्यन्ते तद्वज्जीवाः सुखादिभिः ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "base_unit_id": "MK_C03_K05"
  },
  {
    "id": 16793006,
    "chapter_id": 6193,
    "verse_number": "3.6",
    "content_sanskrit": "रूपकार्यसमाख्याश्च भिद्यन्ते तत्र तत्र वै ।\nआकाशस्य न भेदोऽस्ति तद्वज्जीवेषु निर्णयः ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "base_unit_id": "MK_C03_K06"
  },
  {
    "id": 16793007,
    "chapter_id": 6193,
    "verse_number": "3.7",
    "content_sanskrit": "नाकाशस्य घटाकाशो विकारावयवौ यथा ।\nनैवात्मनः सदा जीवो विकारावयवौ तथा ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "base_unit_id": "MK_C03_K07"
  },
  {
    "id": 16793008,
    "chapter_id": 6193,
    "verse_number": "3.8",
    "content_sanskrit": "यथा भवति बालानां गगनं मलिनं मलैः ।\nतथा भवत्यबुद्धानामात्मापि मलिनो मलैः ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "base_unit_id": "MK_C03_K08"
  },
  {
    "id": 16793009,
    "chapter_id": 6193,
    "verse_number": "3.9",
    "content_sanskrit": "मरणे सम्भवे चैव गत्यागमनयोरपि ।\nस्थितौ सर्वशरीरेषु चाकाशेनाविलक्षणः ॥ ९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "base_unit_id": "MK_C03_K09"
  },
  {
    "id": 16793010,
    "chapter_id": 6193,
    "verse_number": "3.10",
    "content_sanskrit": "सङ्घाताः स्वप्नवत्सर्व आत्ममायाविसर्जिताः ।\nआधिक्ये सर्वसाम्ये वा नोपपत्तिर्हि विद्यते ॥ १० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "base_unit_id": "MK_C03_K10"
  },
  {
    "id": 16793011,
    "chapter_id": 6193,
    "verse_number": "3.11",
    "content_sanskrit": "रसादयो हि ये कोशा व्याख्यातास्तैत्तिरीयके ।\nतेषामात्मा परो जीवः खं यथा सम्प्रकाशितः ॥ ११ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "base_unit_id": "MK_C03_K11"
  },
  {
    "id": 16793012,
    "chapter_id": 6193,
    "verse_number": "3.12",
    "content_sanskrit": "द्वयोर्द्वयोर्मधुज्ञाने परं ब्रह्म प्रकाशितम् ।\nपृथिव्यामुदरे चैव यथाकाशः प्रकाशितः ॥ १२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "base_unit_id": "MK_C03_K12"
  },
  {
    "id": 16793013,
    "chapter_id": 6193,
    "verse_number": "3.13",
    "content_sanskrit": "जीवात्मनोरनन्यत्वमभेदेन प्रशस्यते ।\nनानात्वं निन्द्यते यच्च तदेवं हि समञ्जसम् ॥ १३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "base_unit_id": "MK_C03_K13"
  },
  {
    "id": 16793014,
    "chapter_id": 6193,
    "verse_number": "3.14",
    "content_sanskrit": "जीवात्मनोः पृथक्त्वं यत्प्रागुत्पत्तेः प्रकीर्तितम् ।\nभविष्यद्वृत्त्या गौणं तन्मुख्यत्वं हि न युज्यते ॥ १४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "base_unit_id": "MK_C03_K14"
  },
  {
    "id": 16793015,
    "chapter_id": 6193,
    "verse_number": "3.15",
    "content_sanskrit": "मृल्लोहविस्फुलिङ्गाद्यैः सृष्टिर्या चोदितान्यथा ।\nउपायः सोऽवताराय नास्ति भेदः कथञ्चन ॥ १५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "base_unit_id": "MK_C03_K15"
  },
  {
    "id": 16793016,
    "chapter_id": 6193,
    "verse_number": "3.16",
    "content_sanskrit": "आश्रमास्त्रिविधा हीनमध्यमोत्कृष्टदृष्टयः ।\nउपासनोपदिष्टेयं तदर्थमनुकम्पया ॥ १६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "base_unit_id": "MK_C03_K16"
  },
  {
    "id": 16793017,
    "chapter_id": 6193,
    "verse_number": "3.17",
    "content_sanskrit": "स्वसिद्धान्तव्यवस्थासु द्वैतिनो निश्चिता दृढम् ।\nपरस्परं विरुध्यन्ते तैरयं न विरुध्यते ॥ १७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "base_unit_id": "MK_C03_K17"
  },
  {
    "id": 16793018,
    "chapter_id": 6193,
    "verse_number": "3.18",
    "content_sanskrit": "अद्वैतं परमार्थो हि द्वैतं तद्भेद उच्यते ।\nतेषामुभयथा द्वैतं तेनायं न विरुध्यते ॥ १८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "base_unit_id": "MK_C03_K18"
  },
  {
    "id": 16793019,
    "chapter_id": 6193,
    "verse_number": "3.19",
    "content_sanskrit": "मायया भिद्यते ह्येतन्नान्यथाजं कथञ्चन ।\nतत्त्वतो भिद्यमाने हि मर्त्यताममृतं व्रजेत् ॥ १९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "base_unit_id": "MK_C03_K19"
  },
  {
    "id": 16793020,
    "chapter_id": 6193,
    "verse_number": "3.20",
    "content_sanskrit": "अजातस्यैव भावस्य जातिमिच्छन्ति वादिनः ।\nअजातो ह्यमृतो भावो मर्त्यतां कथमेष्यति ॥ २० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "base_unit_id": "MK_C03_K20"
  },
  {
    "id": 16793021,
    "chapter_id": 6193,
    "verse_number": "3.21",
    "content_sanskrit": "न भवत्यमृतं मर्त्यं न मर्त्यममृतं तथा ।\nप्रकृतेरन्यथाभावो न कथञ्चिद्भविष्यति ॥ २१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "base_unit_id": "MK_C03_K21"
  },
  {
    "id": 16793022,
    "chapter_id": 6193,
    "verse_number": "3.22",
    "content_sanskrit": "स्वभावेनामृतो यस्य भावो गच्छति मर्त्यताम् ।\nकृतकेनामृतस्तस्य कथं स्थास्यति निश्चलः ॥ २२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "base_unit_id": "MK_C03_K22"
  },
  {
    "id": 16793023,
    "chapter_id": 6193,
    "verse_number": "3.23",
    "content_sanskrit": "भूततोऽभूततो वापि सृज्यमाने समा श्रुतिः ।\nनिश्चितं युक्तियुक्तं च यत्तद्भवति नेतरत् ॥ २३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "base_unit_id": "MK_C03_K23"
  },
  {
    "id": 16793024,
    "chapter_id": 6193,
    "verse_number": "3.24",
    "content_sanskrit": "नेह नानेति चाम्नायादिन्द्रो मायाभिरित्यपि ।\nअजायमानो बहुधा जायते मायया तु सः ॥ २४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "base_unit_id": "MK_C03_K24"
  },
  {
    "id": 16793025,
    "chapter_id": 6193,
    "verse_number": "3.25",
    "content_sanskrit": "सम्भूतेरपवादाच्च सम्भवः प्रतिषिध्यते ।\nको न्वेनं जनयेदिति कारणं प्रतिषिध्यते ॥ २५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "base_unit_id": "MK_C03_K25"
  },
  {
    "id": 16793026,
    "chapter_id": 6193,
    "verse_number": "3.26",
    "content_sanskrit": "स एष नेति नेतीति व्याख्यातं निह्नुते यतः ।\nसर्वमग्राह्यभावेन हेतुनाजं प्रकाशते ॥ २६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "base_unit_id": "MK_C03_K26"
  },
  {
    "id": 16793027,
    "chapter_id": 6193,
    "verse_number": "3.27",
    "content_sanskrit": "सतो हि मायया जन्म युज्यते न तु तत्त्वतः ।\nतत्त्वतो जायते यस्य जातं तस्य हि जायते ॥ २७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "base_unit_id": "MK_C03_K27"
  },
  {
    "id": 16793028,
    "chapter_id": 6193,
    "verse_number": "3.28",
    "content_sanskrit": "असतो मायया जन्म तत्त्वतो नैव युज्यते ।\nवन्ध्यापुत्रो न तत्त्वेन मायया वापि जायते ॥ २८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "base_unit_id": "MK_C03_K28"
  },
  {
    "id": 16793029,
    "chapter_id": 6193,
    "verse_number": "3.29",
    "content_sanskrit": "यथा स्वप्ने द्वयाभासं स्पन्दते मायया मनः ।\nतथा जाग्रद्द्वयाभासं स्पन्दते मायया मनः ॥ २९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "base_unit_id": "MK_C03_K29"
  },
  {
    "id": 16793030,
    "chapter_id": 6193,
    "verse_number": "3.30",
    "content_sanskrit": "अद्वयं च द्वयाभासं मनः स्वप्ने न संशयः ।\nअद्वयं च द्वयाभासं तथा जाग्रन्न संशयः ॥ ३० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "base_unit_id": "MK_C03_K30"
  },
  {
    "id": 16793031,
    "chapter_id": 6193,
    "verse_number": "3.31",
    "content_sanskrit": "मनोदृश्यमिदं द्वैतं यत्किञ्चित्सचराचरम् ।\nमनसो ह्यमनीभावे द्वैतं नैवोपलभ्यते ॥ ३१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "base_unit_id": "MK_C03_K31"
  },
  {
    "id": 16793032,
    "chapter_id": 6193,
    "verse_number": "3.32",
    "content_sanskrit": "आत्मसत्यानुबोधेन न सङ्कल्पयते यदा ।\nअमनस्तां तदा याति ग्राह्याभावे तदग्रहम् ॥ ३२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "base_unit_id": "MK_C03_K32"
  },
  {
    "id": 16793033,
    "chapter_id": 6193,
    "verse_number": "3.33",
    "content_sanskrit": "अकल्पकमजं ज्ञानं ज्ञेयाभिन्नं प्रचक्षते ।\nब्रह्म ज्ञेयमजं नित्यमजेनाजं विबुध्यते ॥ ३३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "base_unit_id": "MK_C03_K33"
  },
  {
    "id": 16793034,
    "chapter_id": 6193,
    "verse_number": "3.34",
    "content_sanskrit": "निगृहीतस्य मनसो निर्विकल्पस्य धीमतः ।\nप्रचारः स तु विज्ञेयः सुषुप्तेऽन्यो न तत्समः ॥ ३४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "base_unit_id": "MK_C03_K34"
  },
  {
    "id": 16793035,
    "chapter_id": 6193,
    "verse_number": "3.35",
    "content_sanskrit": "लीयते हि सुषुप्तौ तन्निगृहीतं न लीयते ।\nतदेव निर्भयं ब्रह्म ज्ञानालोकं समन्ततः ॥ ३५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "base_unit_id": "MK_C03_K35"
  },
  {
    "id": 16793036,
    "chapter_id": 6193,
    "verse_number": "3.36",
    "content_sanskrit": "अजमनिद्रमस्वप्नमनामकमरूपकम् ।\nसकृद्विभातं सर्वज्ञं नोपचारः कथञ्चन ॥ ३६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "base_unit_id": "MK_C03_K36"
  },
  {
    "id": 16793037,
    "chapter_id": 6193,
    "verse_number": "3.37",
    "content_sanskrit": "सर्वाभिलापविगतः सर्वचिन्तासमुत्थितः ।\nसुप्रशान्तः सकृज्ज्योतिः समाधिरचलोऽभयः ॥ ३७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "base_unit_id": "MK_C03_K37"
  },
  {
    "id": 16793038,
    "chapter_id": 6193,
    "verse_number": "3.38",
    "content_sanskrit": "ग्रहो न तत्र नोत्सर्गश्चिन्ता यत्र न विद्यते ।\nआत्मसंस्थं तदा ज्ञानमजाति समतां गतम् ॥ ३८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "base_unit_id": "MK_C03_K38"
  },
  {
    "id": 16793039,
    "chapter_id": 6193,
    "verse_number": "3.39",
    "content_sanskrit": "अस्पर्शयोगो वै नाम दुर्दर्शः सर्वयोगिणाम् ।\nयोगिनो बिभ्यति ह्यस्मादभये भयदर्शिनः ॥ ३९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "base_unit_id": "MK_C03_K39"
  },
  {
    "id": 16793040,
    "chapter_id": 6193,
    "verse_number": "3.40",
    "content_sanskrit": "मनसो निग्रहायत्तमभयं सर्वयोगिणाम् ।\nदुःखक्षयः प्रबोधश्चाप्यक्षया शान्तिरेव च ॥ ४० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "base_unit_id": "MK_C03_K40"
  },
  {
    "id": 16793041,
    "chapter_id": 6193,
    "verse_number": "3.41",
    "content_sanskrit": "उत्सेक उदधेर्यद्वत्कुशाग्रेणैकबिन्दुना ।\nमनसो निग्रहस्तद्वद्भवेदपरिखेदतः ॥ ४१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "base_unit_id": "MK_C03_K41"
  },
  {
    "id": 16793042,
    "chapter_id": 6193,
    "verse_number": "3.42",
    "content_sanskrit": "उपायेन निगृह्णीयाद्विक्षिप्तं कामभोगयोः ।\nसुप्रसन्नं लये चैव यथा कामो लयस्तथा ॥ ४२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "base_unit_id": "MK_C03_K42"
  },
  {
    "id": 16793043,
    "chapter_id": 6193,
    "verse_number": "3.43",
    "content_sanskrit": "दुःखं सर्वमनुस्मृत्य कामभोगान्निवर्तयेत् ।\nअजं सर्वमनुस्मृत्य जातं नैव तु पश्यति ॥ ४३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "base_unit_id": "MK_C03_K43"
  },
  {
    "id": 16793044,
    "chapter_id": 6193,
    "verse_number": "3.44",
    "content_sanskrit": "लये सम्बोधयेच्चित्तं विक्षिप्तं शमयेत्पुनः ।\nसकषायं विजानीयात्समप्राप्तं न चालयेत् ॥ ४४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "base_unit_id": "MK_C03_K44"
  },
  {
    "id": 16793045,
    "chapter_id": 6193,
    "verse_number": "3.45",
    "content_sanskrit": "नास्वादयेत्सुखं तत्र निःसङ्गः प्रज्ञया भवेत् ।\nनिश्चलं निश्चरच्चित्तमेकीकुर्यात्प्रयत्नतः ॥ ४५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "base_unit_id": "MK_C03_K45"
  },
  {
    "id": 16793046,
    "chapter_id": 6193,
    "verse_number": "3.46",
    "content_sanskrit": "यदा न लीयते चित्तं न च विक्षिप्यते पुनः ।\nअनिङ्गनमनाभासं निष्पन्नं ब्रह्म तत्तदा ॥ ४६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "base_unit_id": "MK_C03_K46"
  },
  {
    "id": 16793047,
    "chapter_id": 6193,
    "verse_number": "3.47",
    "content_sanskrit": "स्वस्थं शान्तं सनिर्वाणमकथ्यं सुखमुत्तमम् ।\nअजमजेन ज्ञेयेन सर्वज्ञं परिचक्षते ॥ ४७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "base_unit_id": "MK_C03_K47"
  },
  {
    "id": 16793048,
    "chapter_id": 6193,
    "verse_number": "3.48",
    "content_sanskrit": "न कश्चिज्जायते जीवः सम्भवोऽस्य न विद्यते ।\nएतत्तदुत्तमं सत्यं यत्र किञ्चिन्न जायते ॥ ४८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "base_unit_id": "MK_C03_K48"
  }
]