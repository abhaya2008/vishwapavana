[{"id": 2138170, "chapter_id": 3993, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2138171, "chapter_id": 3993, "verse_number": "१", "content_sanskrit": "कथं विराटनगरे मम पूर्वपितामहाः ।\nअज्ञातवासमुषिता दुर्योधनभयार्दिताः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2138172, "chapter_id": 3993, "verse_number": "२", "content_sanskrit": "पतिव्रता महाभागा सततं सत्यवादिनी ।\nद्रौपदी वा कथं ब्रह्मन्नज्ञातं दुःखमावसत्\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2138173, "chapter_id": 3993, "verse_number": "३", "content_sanskrit": "ते च ब्राह्मणमुख्याश्च सूताः पौरोगवैः सह ।\nअज्ञातवासमूषुस्ते कथं च परिचारकाः\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2138174, "chapter_id": 3993, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2138175, "chapter_id": 3993, "verse_number": "४", "content_sanskrit": "तदा सर्वान् वराँल्लब्ध्वा धर्मराजो युधिष्ठिरः ।\nगत्वाऽऽश्रमं ब्राह्मणेभ्यो ह्याचख्यौ सर्वमेव तत्\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2138176, "chapter_id": 3993, "verse_number": "५", "content_sanskrit": "कथयित्वा तु तत्सर्वं ब्राह्मणेभ्यो युधिष्ठिरः ।\nअरणीसहितं भाण्डं ब्राह्मणाय न्यवेदयत्\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2138177, "chapter_id": 3993, "verse_number": "६", "content_sanskrit": "धर्मेण तेऽभ्यनुज्ञाताः पाण्डवाः सत्यवादिनः ।\nअज्ञातवासं वत्स्यन्तः छन्ना वर्षं त्रयोदशम्\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2138178, "chapter_id": 3993, "verse_number": "७", "content_sanskrit": "उपोपविश्य विद्वांसः सहिताः संशितव्रताः ।\nये तद्भक्ता वसन्ति स्म वनवासे तपस्विनः\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2138179, "chapter_id": 3993, "verse_number": "८", "content_sanskrit": "तानब्रुवन् महात्मानः शिष्टाः प्राञ्जलयस्तदा ।\nअभ्यनुज्ञापयिष्यन्तः स्वनिवासं धृतव्रताः\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2138180, "chapter_id": 3993, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2138181, "chapter_id": 3993, "verse_number": "९", "content_sanskrit": "विदितं भवतां सर्वं धार्तराष्ट्रैर्यथा वयम् ।\nछद्मना हृतराज्याश्च निःस्वाश्च बहुशः कृताः\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2138182, "chapter_id": 3993, "verse_number": "१०", "content_sanskrit": "उषिताश्च वने वासं यथा द्वादश वत्सरान् ।\nभवद्भिरेव सहिता वन्याहारा द्विजोत्तमाः\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2138183, "chapter_id": 3993, "verse_number": "११", "content_sanskrit": "अज्ञातवाससमयं शेषं वर्षं त्रयोदशम् ।\nतद् वत्स्यामो वयं छन्नास्तदनुज्ञातुमर्हथ\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2138184, "chapter_id": 3993, "verse_number": "१२", "content_sanskrit": "सुयोधनश्च दुष्टात्मा कर्णश्च सहसौबलः ।\nजानन्तो विषमं कुर्युरस्मास्वत्यन्तवैरिणः\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2138185, "chapter_id": 3993, "verse_number": "१३", "content_sanskrit": "गुप्तकाराश्च म(य)त्ताश्च क्षये त्वस्य जनस्य च ।\nदुष्टात्मनां हि कस्तेषां प्राज्ञो वै विश्वसेद् भुवि\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2138186, "chapter_id": 3993, "verse_number": "१४", "content_sanskrit": "अपि नस्तद् भवेद् भूयो यद्वयं ब्राह्मणैः सह ।\nसमर्थास्तेषु राष्ट्रेषु स्वराज्यं स्थापयाम हि\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2138187, "chapter_id": 3993, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2138188, "chapter_id": 3993, "verse_number": "१५", "content_sanskrit": "इत्युक्त्वा दुःखमोहार्तः शुचिर्धर्मसुतस्तदा ।\nसम्मूर्च्छितोऽभवद् राजा सास्रकण्ठो युधिष्ठिरः\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2138189, "chapter_id": 3993, "verse_number": "१६", "content_sanskrit": "तस्मिन् सम्मूर्च्छिते भूरि भ्रातरश्चास्य सर्वशः ।\nशोकमापेदिरे तत्र दृष्ट्वा राजानमातुरम्\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2138190, "chapter_id": 3993, "verse_number": "१७", "content_sanskrit": "अथ धौम्योऽब्रवीद् वाक्यं महार्थं नृपतिं तदा\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2138191, "chapter_id": 3993, "verse_number": "१८", "content_sanskrit": "राजन् विद्वान् भवान् दान्तः सत्यसन्धो जितेन्द्रियः ।\nनैवंविधाः प्रमुह्यन्ति नराः कस्याञ्चिदापदि\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2138192, "chapter_id": 3993, "verse_number": "१९", "content_sanskrit": "देवैरप्यापदः प्राप्ताः छन्नैश्च बहुभिस्तदा ।\nतत्र तत्र सपत्नानां निग्रहार्थं महात्मभिः\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2138193, "chapter_id": 3993, "verse_number": "२०", "content_sanskrit": "इन्द्रेण निषधं प्राप्य गिरिप्रस्थाश्रये तदा ।\nछन्नेनोष्य कृतं कर्म द्विषतां बलनिग्रहे\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2138194, "chapter_id": 3993, "verse_number": "२१", "content_sanskrit": "दितिपुत्रैर्हृते राज्ये देवराजोऽपि दुःखितः ।\nब्रह्माणं तोषयिष्यंश्च ब्रह्मरूपं विधाय च\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2138195, "chapter_id": 3993, "verse_number": "२२", "content_sanskrit": "प्रसादाद् ब्रह्मणो राजन् दितेः पुत्रान् महाबलान् ।\nविजित्य तरसा शत्रून् पुनर्लोकानवाप ह\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2138196, "chapter_id": 3993, "verse_number": "२३", "content_sanskrit": "विष्णुनाऽश्मगिरिं प्राप्य तदाऽदित्यां निवत्स्यता ।\nगर्भे वधार्थं दैत्यानामज्ञातं चोषितं चिरम्\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2138197, "chapter_id": 3993, "verse_number": "२४", "content_sanskrit": "प्रोष्य वामनरूपेण प्रच्छन्नब्रह्मचारिणा ।\nबलेरथाहृतं राज्यं विक्रमैस्तच्च ते श्रुतम्\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2138198, "chapter_id": 3993, "verse_number": "२५", "content_sanskrit": "और्वेण वसता च्छन्नमूरौ ब्रह्मर्षिणा पुरा ।\nयत् कृतं तात लोकेषु तच्च सर्वं श्रुतं त्वया\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2138199, "chapter_id": 3993, "verse_number": "२६", "content_sanskrit": "अज्ञातं चापि धर्मज्ञ हरिणा वृत्रनिग्रहे ।\nवज्रं प्रविश्य शक्रस्य यत् कृतं तच्च ते श्रुतम्\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2138200, "chapter_id": 3993, "verse_number": "२७", "content_sanskrit": "हुताशनेन यच्चापः प्रविश्य च्छन्नमासता ।\nविबुधानां हितं कर्म कृतं तच्चापि ते श्रुतम्\t ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2138201, "chapter_id": 3993, "verse_number": "२८", "content_sanskrit": "तथा विवस्वता चापि च्छन्नेनोत्तमतेजसा ।\nनिर्दग्धा रिपवः सर्वे वसता भुवि वर्षशः\t ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2138202, "chapter_id": 3993, "verse_number": "२९", "content_sanskrit": "विष्णुना वसता चापि गृहे दशरथस्य च ।\nदशग्रीवो हतश्छन्नं संयुगे भीमकर्मणा\t ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2138203, "chapter_id": 3993, "verse_number": "३०", "content_sanskrit": "एवमेते महात्मानः प्रच्छन्नास्तत्र तत्र ह ।\nअजयन् शात्रवान् मुख्यांस्तथा त्वमपि जेष्यसि\t ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2138204, "chapter_id": 3993, "verse_number": "समाप्तिः", "content_sanskrit": "इति धौम्येन धर्मज्ञो वाक्यैः सम्परिहर्षितः ।\nशास्त्रबुद्धिः पुनर्भूत्वा व्यष्टम्भत युधिष्ठिरः\t ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2138205, "chapter_id": 3993, "verse_number": "३२", "content_sanskrit": "अथाब्रवीन्महाबाहुर्भीमसेनो महाबलः ।\nराजानं बलिनां श्रेष्ठो गिरा सम्परिहर्षयन्\t ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2138206, "chapter_id": 3993, "verse_number": "३३", "content_sanskrit": "अवेक्षय महाराज तव गाण्डीवधन्वना ।\nधर्मानुगतया बुद्ध्या न किञ्चित् साहसं कृतम्\t ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2138207, "chapter_id": 3993, "verse_number": "३४", "content_sanskrit": "सहदेवो मया नित्यं नकुलश्च निवारितः ।\nशक्तो विध्वंसने तेषां शत्रुघ्नौ भीमविक्रमौ\t ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2138208, "chapter_id": 3993, "verse_number": "३५", "content_sanskrit": "न वयं वर्त्म हास्यामो यस्मिन् योक्ष्यति नो भवान् ।\nतद्विधत्तां भवान् सर्वं क्षिप्रं जेष्यामहे परान्\t ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2138209, "chapter_id": 3993, "verse_number": "३६", "content_sanskrit": "इत्युक्तो भीमसेनेन धर्मराजो युधिष्ठिरः ।\nसुखोपविष्टो विद्वद्भिस्तापसैः संशितव्रतैः\t ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2138210, "chapter_id": 3993, "verse_number": "३७", "content_sanskrit": "ये तद्भक्त्याऽभवंस्तस्मिन् वनवासे तपस्विनः ।\nतानब्रवीन् महाप्राज्ञः शिष्टान् राजा कृताञ्जलिः\t ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2138211, "chapter_id": 3993, "verse_number": "३८", "content_sanskrit": "विदितं भवतां सर्वं धार्तराष्ट्रैर्यथा वयम् ।\nछद्मना हृतराज्याश्च निःस्वाश्च बहुशः कृताः\t ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2138212, "chapter_id": 3993, "verse_number": "३९", "content_sanskrit": "उषिताः स्मो वने कृच्छ्रे यत्नाद् द्वादश वत्सरान् ।\nअज्ञातचर्यां समये शेषं वर्षं त्रयोदशम्\t ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2138213, "chapter_id": 3993, "verse_number": "४०", "content_sanskrit": "तद्वत्स्यामः क्वचिच्छन्नास्तदनुज्ञापयामहे\t ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2138214, "chapter_id": 3993, "verse_number": "४१", "content_sanskrit": "इत्युक्ता धर्मराजेन ब्राह्मणाः परमाशिषः ।\nप्रयुज्यापृच्छ्य भरतान् यथास्वान् प्रययुर्गृहान्\t ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2138215, "chapter_id": 3993, "verse_number": "४२", "content_sanskrit": "सर्वे वेदविदो विप्रा यतयो मुनयस्तथा ।\nआशीरुक्त्वा यथान्यायं पुनर्दर्शनकाङ्क्षिणः\t ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2138216, "chapter_id": 3993, "verse_number": "४३", "content_sanskrit": "ते तद्भृत्याश्च सूदाश्च शिल्पिनः परिचारकाः ।\nअनुज्ञाप्य यथान्यायं पुनर्दर्शनभाषिणः\t ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2138217, "chapter_id": 3993, "verse_number": "४४", "content_sanskrit": "सह धौम्येन विद्वांसस्तथा ते पञ्च पाण्डवाः ।\nउत्थाय प्रययुर्वीराः कृष्णामादाय भारत\t ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2138218, "chapter_id": 3993, "verse_number": "४५", "content_sanskrit": "क्रोशमात्रमतिक्रम्य तस्माद् वासान्निमित्ततः ।\nश्वोभूते मनुजव्याघ्राश्छन्नवासार्थमुद्यताः\t ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2138219, "chapter_id": 3993, "verse_number": "४६", "content_sanskrit": "पृथक् शास्त्रविदः सर्वे सर्वे मन्त्रविशारदाः ।\nसन्धिविग्रहकालज्ञा मन्त्राय समुपाविशन्\t ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2138220, "chapter_id": 3993, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां विराटपर्वणि प्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2138221, "chapter_id": 3993, "verse_number": "", "content_sanskrit": "वैराटपर्वणि प्रथमोऽध्यायः ॥१॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]