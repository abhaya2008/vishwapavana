[{"id": 50014824, "chapter_id": 11544, "verse_number": "1", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50014825, "chapter_id": 11544, "verse_number": "2", "content_sanskrit": "नाभागोन्यस्ततः प्राज्ञो यं मत्वा भ्रातरः कविम्। यविष्ठं व्यभजन् दायं ब्रह्मचारिणमाह सः॥ ९/५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50014826, "chapter_id": 11544, "verse_number": "3", "content_sanskrit": "भ्रातरोऽभाङ्क्त किं मह्यं भजान पितरं तव। किं म आर्यास्तताभाङ्क्षुर्मा पुत्रक तदादृथाः॥ ९/५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50014827, "chapter_id": 11544, "verse_number": "4", "content_sanskrit": "इम अङ्गिरसः सत्रमासतेऽद्य सुमेधसः। षष्ठं षष्ठमुपेत्याहः कवे मुह्यन्ति कर्मणि॥ ९/५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50014828, "chapter_id": 11544, "verse_number": "5", "content_sanskrit": "तांस्त्वं शंसय सूक्ते द्वे वैश्वदेवे महात्मनः। ते स्वर्यन्तो धनं सत्रपरिशेषितमात्मनः॥ ९/५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50014829, "chapter_id": 11544, "verse_number": "6", "content_sanskrit": "दास्यान्त तेऽथ तान् गच्छ तथा स कृतवान् यथा। तस्मै दत्वा ययुः स्वर्गं ते सत्रपरिवेषणम्॥ ९/५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50014830, "chapter_id": 11544, "verse_number": "7", "content_sanskrit": "तं कश्चित् स्वीकरिष्यन्तं पुरुषः कृष्णदर्शनः। उवाचोत्तरतोऽभ्येत्य ममेदं वास्तुकं वसु॥ ९/५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50014831, "chapter_id": 11544, "verse_number": "8", "content_sanskrit": "ममेदमृषिभिर्दत्तमिति तर्हि स्म मानव। स्यान्नौ ते पितरि प्रश्नः स गतः पितरं तथा॥ ९/५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50014832, "chapter_id": 11544, "verse_number": "9", "content_sanskrit": "यज्ञवास्तुगतं सर्वमुच्छिष्टमृषयः क्वचित्। चक्रुर्हि भागं रुद्राय स देवः सर्वमर्हति॥ ९/५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50014833, "chapter_id": 11544, "verse_number": "10", "content_sanskrit": "नाभागस्तं प्रणम्याह तवेश किल वास्तुगम्। इत्याह मे पिता ब्रह्मन् शिरसा त्वां प्रसादये॥ ९/५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50014834, "chapter_id": 11544, "verse_number": "11", "content_sanskrit": "यत् ते पिताऽवदद् धर्मं त्वं च सत्यं६ प्रभाषसे। ददामि ते मन्त्रदृशो ज्ञानं ब्रह्म सनातनम्॥ ९/५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50014835, "chapter_id": 11544, "verse_number": "12", "content_sanskrit": "गृहाण द्रविणं दत्तं यत् सत्रपरिवेषितम्। इत्युक्त्वाऽन्तर्दधे रुद्रो भगवान् सत्यवत्सलः॥ ९/५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50014836, "chapter_id": 11544, "verse_number": "13", "content_sanskrit": "य एतद् संस्मरेत् प्रातः सायं च सुसमाहितः। कविर्भवति मन्त्रज्ञो गतिं चैति तथाऽऽत्मनः॥ ९/५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50014837, "chapter_id": 11544, "verse_number": "14", "content_sanskrit": "इति श्रीमद्भागवते नवमस्कन्धे पञ्चमोऽध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]