[{"id": 2196106, "chapter_id": 5180, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2196107, "chapter_id": 5180, "verse_number": "१", "content_sanskrit": "किं कर्तव्यं मनुष्येण लोकयात्राहितार्थिना ।\nकथं हि लोकयात्रां तु किंशीलश्च समाचरेत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2196108, "chapter_id": 5180, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2196109, "chapter_id": 5180, "verse_number": "२", "content_sanskrit": "देवे नारायणे भक्तिः शङ्करे साधुपूज्यता ।\nध्यानेनाथ जपः कार्यः स्वधर्मे शुचिचेतसा\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2196110, "chapter_id": 5180, "verse_number": "३", "content_sanskrit": "कायेन त्रिविधं कर्म वाचा चापि चतुर्विधम् ।\nमनसा त्रिविधं चैव दश कर्मपथांस्त्यजेत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2196111, "chapter_id": 5180, "verse_number": "४", "content_sanskrit": "प्राणातिपातं स्तैन्यं च परदारमथापि च ।\nत्रीणि पापानि कायेन सर्वतः परिवर्जयेत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2196112, "chapter_id": 5180, "verse_number": "५", "content_sanskrit": "असत्प्रलापं पारुष्यं पैशुन्यमनृतं तथा ।\nएतानि वाचा राजेन्द्र न जल्पेन्नानुचिन्तयेत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2196113, "chapter_id": 5180, "verse_number": "६", "content_sanskrit": "अनभिध्या परस्वेषु सर्वसत्त्वेषु सौहृदम् ।\nकर्मणां फलमस्तीति त्रिविधं मनसा चरेत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2196114, "chapter_id": 5180, "verse_number": "७", "content_sanskrit": "तस्माद् वाक्कायमनसा नाचरेदशुभं नरः ।\nशुभाशुभान्याचरन् हि तस्य तस्याश्नुते फलम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2196115, "chapter_id": 5180, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि\nदानधर्मे त्रिविधपापत्यागकथनं नाम एकत्रिंशोऽध्यायः ॥३१॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]