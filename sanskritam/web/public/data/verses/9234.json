[{"id": 5000234000, "chapter_id": 9234, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे अष्टात्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000234001, "chapter_id": 9234, "verse_number": "३-३८-१", "content_sanskrit": "कदाचिदप्यहं वीर्यात् पर्यटन् पृथिवीमिमाम्।\nबलं नागसहस्रस्य धारयन् पर्वतोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000234002, "chapter_id": 9234, "verse_number": "३-३८-२", "content_sanskrit": "नीलजीमूतसंकाशस्तप्तकाञ्चनकुण्डलः।\nभयं लोकस्य जनयन् किरीटी परिघायुधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000234003, "chapter_id": 9234, "verse_number": "३-३८-३", "content_sanskrit": "व्यचरन् दण्डकारण्यमृषिमांसानि भक्षयन्।\nविश्वामित्रोऽथ धर्मात्मा मद्वित्रस्तो महामुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000234004, "chapter_id": 9234, "verse_number": "३-३८-४", "content_sanskrit": "स्वयं गत्वा दशरथं नरेन्द्रमिदमब्रवीत्।\nअयं रक्षतु मां रामः पर्वकाले समाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000234005, "chapter_id": 9234, "verse_number": "३-३८-५", "content_sanskrit": "मारीचान्मे भयं घोरं समुत्पन्नं नरेश्वर।\nइत्येवमुक्तो धर्मात्मा राजा दशरथस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000234006, "chapter_id": 9234, "verse_number": "३-३८-६", "content_sanskrit": "प्रत्युवाच महाभागं विश्वामित्रं महामुनिम्।\nऊनद्वादशवर्षोऽयमकृतास्त्रश्च राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000234007, "chapter_id": 9234, "verse_number": "३-३८-७", "content_sanskrit": "कामं तु मम तत् सैन्यं मया सह गमिष्यति।\nबलेन चतुरङ्गेण स्वयमेत्य निशाचरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000234008, "chapter_id": 9234, "verse_number": "३-३८-८", "content_sanskrit": "वधिष्यामि मुनिश्रेष्ठ शत्रुं तव यथेप्सितम्।\nएवमुक्तः स तु मुनी राजानमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000234009, "chapter_id": 9234, "verse_number": "३-३८-९", "content_sanskrit": "रामान्नान्यद् बलं लोके पर्याप्तं तस्य रक्षसः।\nदेवतानामपि भवान् समरेष्वभिपालकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000234010, "chapter_id": 9234, "verse_number": "३-३८-१०", "content_sanskrit": "आसीत् तव कृतं कर्म त्रिलोकविदितं नृप।\nकाममस्ति महत् सैन्यं तिष्ठत्विह परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000234011, "chapter_id": 9234, "verse_number": "३-३८-११", "content_sanskrit": "बालोऽप्येष महातेजाः समर्थस्तस्य निग्रहे।\nगमिष्ये राममादाय स्वस्ति तेऽस्तु परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000234012, "chapter_id": 9234, "verse_number": "३-३८-१२", "content_sanskrit": "इत्येवमुक्त्वा स मुनिस्तमादाय नृपात्मजम्।\nजगाम परमप्रीतो विश्वामित्रः स्वमाश्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000234013, "chapter_id": 9234, "verse_number": "३-३८-१३", "content_sanskrit": "तं तथा दण्डकारण्ये यज्ञमुद्दिश्य दीक्षितम्।\nबभूवोपस्थितो रामश्चित्रं विस्फारयन् धनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000234014, "chapter_id": 9234, "verse_number": "३-३८-१४", "content_sanskrit": "अजातव्यञ्जनः श्रीमान् बालः श्यामः शुभेक्षणः।\nएकवस्त्रधरो धन्वी शिखी कनकमालया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000234015, "chapter_id": 9234, "verse_number": "३-३८-१५", "content_sanskrit": "शोभयन् दण्डकारण्यं दीप्तेन स्वेन तेजसा।\nअदृश्यत तदा रामो बालचन्द्र इवोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000234016, "chapter_id": 9234, "verse_number": "३-३८-१६", "content_sanskrit": "ततोऽहं मेघसंकाशस्तप्तकाञ्चनकुण्डलः।\nबली दत्तवरो दर्पादाजगामाश्रमान्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000234017, "chapter_id": 9234, "verse_number": "३-३८-१७", "content_sanskrit": "तेन दृष्टः प्रविष्टोऽहं सहसैवोद्यतायुधः।\nमां तु दृष्ट्वा धनुः सज्यमसम्भ्रान्तश्चकार ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000234018, "chapter_id": 9234, "verse_number": "३-३८-१८", "content_sanskrit": "अवजानन्नहं मोहाद् बालोऽयमिति राघवम्।\nविश्वामित्रस्य तां वेदिमभ्यधावं कृतत्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000234019, "chapter_id": 9234, "verse_number": "३-३८-१९", "content_sanskrit": "तेन मुक्तस्ततो बाणः शितः शत्रुनिबर्हणः।\nतेनाहं ताडितः क्षिप्तः समुद्रे शतयोजने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000234020, "chapter_id": 9234, "verse_number": "३-३८-२०", "content_sanskrit": "नेच्छता तात मां हन्तुं तदा वीरेण रक्षितः।\nरामस्य शरवेगेन निरस्तो भ्रान्तचेतनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000234021, "chapter_id": 9234, "verse_number": "३-३८-२१", "content_sanskrit": "पातितोऽहं तदा तेन गम्भीरे सागराम्भसि।\nप्राप्य संज्ञां चिरात् तात लङ्कां प्रति गतः पुरीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000234022, "chapter_id": 9234, "verse_number": "३-३८-२२", "content_sanskrit": "एवमस्मि तदा मुक्तः सहायास्ते निपातिताः।\nअकृतास्त्रेण रामेण बालेनाक्लिष्टकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000234023, "chapter_id": 9234, "verse_number": "३-३८-२३", "content_sanskrit": "तन्मया वार्यमाणस्तु यदि रामेण विग्रहम्।\nकरिष्यस्यापदां घोरां क्षिप्रं प्राप्य न शिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000234024, "chapter_id": 9234, "verse_number": "३-३८-२४", "content_sanskrit": "क्रीडारतिविधिज्ञानां समाजोत्सवदर्शिनाम्।\nरक्षसां चैव संतापमनर्थं चाहरिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000234025, "chapter_id": 9234, "verse_number": "३-३८-२५", "content_sanskrit": "हर्म्यप्रासादसम्बाधां नानारत्नविभूषिताम्।\nद्रक्ष्यसि त्वं पुरीं लङ्कां विनष्टां मैथिलीकृते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000234026, "chapter_id": 9234, "verse_number": "३-३८-२६", "content_sanskrit": "अकुर्वन्तोऽपि पापानि शुचयः पापसंश्रयात्।\nपरपापैर्विनश्यन्ति मत्स्या नागह्रदे यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000234027, "chapter_id": 9234, "verse_number": "३-३८-२७", "content_sanskrit": "दिव्यचन्दनदिग्धाङ्गान् दिव्याभरणभूषितान्।\nद्रक्ष्यस्यभिहतान् भूमौ तव दोषात् तु राक्षसान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000234028, "chapter_id": 9234, "verse_number": "३-३८-२८", "content_sanskrit": "हृतदारान् सदारांश्च दश विद्रवतो दिशः।\nहतशेषानशरणान् द्रक्ष्यसि त्वं निशाचरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000234029, "chapter_id": 9234, "verse_number": "३-३८-२९", "content_sanskrit": "शरजालपरिक्षिप्तामग्निज्वालासमावृताम्।\nप्रदग्धभवनां लङ्कां द्रक्ष्यसि त्वमसंशयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000234030, "chapter_id": 9234, "verse_number": "३-३८-३०", "content_sanskrit": "परदाराभिमर्शात् तु नान्यत् पापतरं महत्।\nप्रमदानां सहस्राणि तव राजन् परिग्रहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000234031, "chapter_id": 9234, "verse_number": "३-३८-३१", "content_sanskrit": "भव स्वदारनिरतः स्वकुलं रक्ष राक्षसान्।\nमानं वृद्धिं च राज्यं च जीवितं चेष्टमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000234032, "chapter_id": 9234, "verse_number": "३-३८-३२", "content_sanskrit": "कलत्राणि च सौम्यानि मित्रवर्गं तथैव च।\nयदीच्छसि चिरं भोक्तुं मा कृथा रामविप्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000234033, "chapter_id": 9234, "verse_number": "३-३८-३३", "content_sanskrit": "निवार्यमाणः सुहृदा मया भृशं\nप्रसह्य सीतां यदि धर्षयिष्यसि।\nगमिष्यसि क्षीणबलः सबान्धवो\nयमक्षयं रामशरास्तजीवितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000234034, "chapter_id": 9234, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे अष्टात्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]