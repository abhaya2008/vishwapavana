[{"id": 6000157000, "chapter_id": 10157, "verse_number": null, "content_sanskrit": "अथ चतुर्थाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000157001, "chapter_id": 10157, "verse_number": null, "content_sanskrit": "श्री शुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_004/BhP_08.004.001.m4a", "display_order": 2}, {"id": 6000157002, "chapter_id": 10157, "verse_number": "८-४-१", "content_sanskrit": "तदा देवर्षिगन्धर्वा ब्रह्मेशानपुरोगमाः।\nमुमुचुः कुसुमासारं शंसन्तः कर्म तद्धरेः॥ ८/४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_004/BhP_08.004.002.m4a", "display_order": 3, "topics": [{"text": "देवलशापेन ग्राहतां प्राप्तस्य हूहूनामकगन्धर्वस्य स्वस्वरूपप्रापणम्", "range": "१–५"}]}, {"id": 6000157003, "chapter_id": 10157, "verse_number": "८-४-२", "content_sanskrit": "नेदुर्दुन्दुभयो दिव्या गन्धर्वा ननृतुर्जगुः।\nऋषयश्चारणाः सिद्धास्तुष्टुवुः पुरुषोत्तमम्॥ ८/४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_004/BhP_08.004.003.m4a", "display_order": 4}, {"id": 6000157004, "chapter_id": 10157, "verse_number": "८-४-३", "content_sanskrit": "योऽसौ ग्राहः स वै सद्यः परमाश्चर्यरूपधृक्।\nमुक्तो देवलशापेन हूहूर्गन्धर्वसत्तमः॥ ८/४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_004/BhP_08.004.004.m4a", "display_order": 5}, {"id": 6000157005, "chapter_id": 10157, "verse_number": "८-४-४", "content_sanskrit": "प्रणम्य शिरसाऽधीशम् उत्तमश्लोकमव्ययम्।\nअगायत यशोधाम कीर्तन्यगुणसत्कथम्॥ ८/४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_004/BhP_08.004.005.m4a", "display_order": 6}, {"id": 6000157006, "chapter_id": 10157, "verse_number": "८-४-५", "content_sanskrit": "सोऽनुकम्पित ईशेन परिक्रम्य प्रणम्य तम्।\nलोकस्य पश्यतो लोकं स्वमगान्मुक्तकिल्बिषः॥ ८/४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_004/BhP_08.004.006.m4a", "display_order": 7}, {"id": 6000157007, "chapter_id": 10157, "verse_number": "८-४-६", "content_sanskrit": "गजेन्द्रो भगवत्स्पर्शाद् विमुक्तोऽज्ञानबन्धनात्।\nप्राप्तो भगवतो रूपं पीतवासाश्चतुर्भुजः॥ ८/४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_004/BhP_08.004.007.m4a", "display_order": 8, "topics": [{"text": "पूर्वमिन्द्रद्युम्ननाम्नो राज्ञः अगस्त्यशापाद्गजेन्द्रत्वं प्राप्तस्य भगवता तज्जन्मपरिहारपूर्वकं स्वपार्षदीकरणम्", "range": "६–१३"}]}, {"id": 6000157008, "chapter_id": 10157, "verse_number": "८-४-७", "content_sanskrit": "स वै पूर्वमभूद्राजा पाण्ड्यो द्रविडसत्तमः।\nइन्द्रद्युम्न इति ख्यातो विष्णुव्रतपरायणः॥ ८/४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_004/BhP_08.004.008.m4a", "display_order": 9}, {"id": 6000157009, "chapter_id": 10157, "verse_number": "८-४-८", "content_sanskrit": "स एकदाऽऽराधनकाल आत्मवान् गृहीतमौनव्रत ईश्वरं हरिम्।\nजटाधरस्तापस आप्लुतोऽच्युतं समर्चयामास कुलाचलाश्रयः॥ ८/४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_004/BhP_08.004.009.m4a", "display_order": 10}, {"id": 6000157010, "chapter_id": 10157, "verse_number": "८-४-९", "content_sanskrit": "यदृच्छया तत्र महायशा मुनिः समागमच्छिष्यगणैः परिश्रितः।\nतं वीक्ष्य तूष्णीमकृतार्हणादिकं रहस्युपासीनमृषिश्चुकोप ह॥ ८/४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_004/BhP_08.004.010.m4a", "display_order": 11}, {"id": 6000157011, "chapter_id": 10157, "verse_number": "८-४-१०", "content_sanskrit": "तस्मा इमं शापमदादसाधुरयं दुरात्माऽकृतबुद्धिरद्य।\nमद्धेलनात् प्राविशतां तमिस्रं यथा गजः स्तब्धमतिः सदोषः॥ ८/४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_004/BhP_08.004.011.m4a", "display_order": 12}, {"id": 6000157012, "chapter_id": 10157, "verse_number": null, "content_sanskrit": "श्री शुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_004/BhP_08.004.012.m4a", "display_order": 13}, {"id": 6000157013, "chapter_id": 10157, "verse_number": "८-४-११", "content_sanskrit": "एवं शप्त्वा गतोऽगस्त्यो भगवान् नृप सानुगः।\nइन्द्रद्युम्नोऽपि राजर्षिर्दिष्टं तदुपधारयन्॥ ८/४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_004/BhP_08.004.013.m4a", "display_order": 14}, {"id": 6000157014, "chapter_id": 10157, "verse_number": "८-४-१२", "content_sanskrit": "आपन्नः कौञ्जरीं योनिम् आत्मस्मृतिविनाशिनीम्।\nहर्यर्चनानुभावेन यद्गजत्वेऽप्यनुस्मृतिः॥ ८/४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_004/BhP_08.004.014.m4a", "display_order": 15}, {"id": 6000157015, "chapter_id": 10157, "verse_number": "८-४-१३", "content_sanskrit": "एवं विमोक्ष्य गजयूथपमब्जनाभस्तेनापि पारिषदतां गमितेन युक्तः।\nगन्धर्वसिद्धविबुधैरुपगीयमानकर्माऽद्भुतं स्वभवनं गरुडासनोऽगात्॥ ८/४/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_004/BhP_08.004.015.m4a", "display_order": 16}, {"id": 6000157016, "chapter_id": 10157, "verse_number": "८-४-१४", "content_sanskrit": "एवं महाराज तवेरितो मया कृष्णानुभावो गजराजमोक्षणम्।\nस्वर्ग्यं यशस्यं कलिकल्मषापहं दुःस्वप्ननाशं कुरुवर्य शृृण्वताम्॥ ८/४/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_004/BhP_08.004.016.m4a", "display_order": 17, "topics": [{"text": "हरिणा गजेन्द्रमोक्षकथापारायणस्य फलकथनम्", "range": "१४–२६"}]}, {"id": 6000157017, "chapter_id": 10157, "verse_number": "८-४-१५", "content_sanskrit": "अथानुकीर्तयन्त्येतच्छ्रेयस्कामा द्विजातयः।\nशुचयः प्रातरुत्थाय दुःस्वप्नाद्युपशान्तये॥ ८/४/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_004/BhP_08.004.017.m4a", "display_order": 18}, {"id": 6000157018, "chapter_id": 10157, "verse_number": "८-४-१६", "content_sanskrit": "इदमाह हरिः प्रीतो गजेन्द्रं कुरुसत्तम।\nशृृण्वतां सर्वभूतानां सर्वभूतमयो विभुः॥ ८/४/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_004/BhP_08.004.018.m4a", "display_order": 19}, {"id": 6000157019, "chapter_id": 10157, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_004/BhP_08.004.019.m4a", "display_order": 20}, {"id": 6000157020, "chapter_id": 10157, "verse_number": "८-४-१७", "content_sanskrit": "ये मां त्वां च सरश्चेदं गिरिकन्दरकाननम्।\nवेत्रकीचकवेणूनां गुल्मानि सुरपादपान्॥ ८/४/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_004/BhP_08.004.020.m4a", "display_order": 21}, {"id": 6000157021, "chapter_id": 10157, "verse_number": "८-४-१८", "content_sanskrit": "शृङ्गाणीमानि धिष्ण्यानि ब्रह्मणो मे शिवस्य च।\nक्षीरोदं मे प्रियं धाम श्वेतद्वीपं च भास्वरम्॥ ८/४/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_004/BhP_08.004.021.m4a", "display_order": 22}, {"id": 6000157022, "chapter_id": 10157, "verse_number": "८-४-१९", "content_sanskrit": "श्रीवत्सं कौस्तुभं मालां गदां कौमोदकीं मम।\nसुदर्शनं पाञ्चजन्यं सुपर्णं पतगेश्वरम्॥ ८/४/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_004/BhP_08.004.022.m4a", "display_order": 23}, {"id": 6000157023, "chapter_id": 10157, "verse_number": "८-४-२०", "content_sanskrit": "शेषं च मत्कलां सूक्ष्मां श्रियं देवीं मदाश्रयाम्।\nब्रह्माणं नारदमृषिं भवं प्रह्लादमेव च॥ ८/४/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_004/BhP_08.004.023.m4a", "display_order": 24}, {"id": 6000157024, "chapter_id": 10157, "verse_number": "८-४-२१", "content_sanskrit": "मत्स्यकूर्मवराहाद्यैरवतारैः कृतानि मे।\nकर्माण्यनन्तपुण्यानि सूर्यसोमहुताशनान्॥ ८/४/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_004/BhP_08.004.024.m4a", "display_order": 25}, {"id": 6000157025, "chapter_id": 10157, "verse_number": "८-४-२२", "content_sanskrit": "प्रणवं सत्यमव्यक्तं गोविप्रान् धर्ममक्षयम्।\nदाक्षायणीं धर्मपत्नीं सोमकश्यपयोरपि॥ ८/४/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_004/BhP_08.004.025.m4a", "display_order": 26}, {"id": 6000157026, "chapter_id": 10157, "verse_number": "८-४-२३", "content_sanskrit": "गङ्गां सरस्वतीं नन्दां कालिन्दीं सितवारणम्।\nध्रुवं ब्रह्मऋषीन् सप्त पुण्यश्लोकांश्च मानवान्॥ ८/४/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_004/BhP_08.004.026.m4a", "display_order": 27}, {"id": 6000157027, "chapter_id": 10157, "verse_number": "८-४-२४", "content_sanskrit": "उत्थायापररात्रान्ते प्रयताः सुसमाहिताः।\nस्मरन्ति मम रूपाणि मुच्यन्ते तेंऽहसोऽखिलात्॥ ८/४/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_004/BhP_08.004.027.m4a", "display_order": 28}, {"id": 6000157028, "chapter_id": 10157, "verse_number": "८-४-२५", "content_sanskrit": "ये मां स्तुवन्त्यनेनाङ्ग प्रतिबुध्य निशात्यये।\nतेषां प्राणात्यये चाहं ददामि विमलां मतिम्॥ ८/४/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_004/BhP_08.004.028.m4a", "display_order": 29}, {"id": 6000157029, "chapter_id": 10157, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_004/BhP_08.004.029.m4a", "display_order": 30}, {"id": 6000157030, "chapter_id": 10157, "verse_number": "८-४-२६", "content_sanskrit": "इत्यादिश्य हृषीकेशः प्राध्माय जलजोत्तमम्।\nहर्षयन् विबुधानीकमारुरोह खगाधिपम्॥ ८/४/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_004/BhP_08.004.030.m4a", "display_order": 31}, {"id": 6000157031, "chapter_id": 10157, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायाम् अष्टमस्कन्धे चतुर्थाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]