[{"id": 2077567, "chapter_id": 2644, "verse_number": "१२-१४९-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2077568, "chapter_id": 2644, "verse_number": "१२-१४९-१", "content_sanskrit": "अबुद्धिपूर्वं यत्पापं कुर्याद्भरतसत्तम।\nमुच्यते स कथं तस्मादेनसस्तद्ब्रवीहि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2077569, "chapter_id": 2644, "verse_number": "१२-१४९-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2077570, "chapter_id": 2644, "verse_number": "१२-१४९-२", "content_sanskrit": "अत्र ते वर्तयिष्यामि पुराणमृषिसंस्तुतम्।\nइन्द्रोतः शौनको विप्रो यदाह जनमेजयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2077571, "chapter_id": 2644, "verse_number": "१२-१४९-३", "content_sanskrit": "आसीद्राजा महावीर्यः पारिक्षिज्जनमेजयः।\nअबुद्धिजा ब्रह्महत्या तमागच्छन्महीपतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2077572, "chapter_id": 2644, "verse_number": "१२-१४९-४", "content_sanskrit": "ब्राह्मणाः सर्व एवैनं तत्यजुः सपुरोहिताः।\nस जगाम वनं राजा दह्यमानो दिवानिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2077573, "chapter_id": 2644, "verse_number": "१२-१४९-५", "content_sanskrit": "प्रजाभिः स परित्यक्तश्चकार कुशलं महत्।\nअतिवेलं तपस्तेपे दह्यमानः स मन्युना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2077574, "chapter_id": 2644, "verse_number": "१२-१४९-६", "content_sanskrit": "ब्रह्महत्यापनोदार्थमपृच्छद्ब्राह्मणान्बहून्।\nपर्यटन्पृथिवीं कृत्स्नां देशेदेशे नराधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2077575, "chapter_id": 2644, "verse_number": "१२-१४९-७", "content_sanskrit": "तत्रेतिहासं वक्ष्यामि धर्मस्यास्योपवृंहणम्।\nदह्यमानः पापकृत्या जगाम जनमेजयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2077576, "chapter_id": 2644, "verse_number": "१२-१४९-८", "content_sanskrit": "चरिष्यमाण इन्द्रोतं शौनकं संशितव्रतम्।\nसमासाद्योपजग्राह पादयोः परिपीडयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2077577, "chapter_id": 2644, "verse_number": "१२-१४९-९", "content_sanskrit": "ततो भीतो महाप्राज्ञो जगर्हे सुभृशं तदा।\nकर्ता पापस्य महतो भ्रूणहा किमिहागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2077578, "chapter_id": 2644, "verse_number": "१२-१४९-१०", "content_sanskrit": "किं तवास्मासु कर्तव्यं मा मां द्राक्षीः कथंचन।\nगच्छगच्छ न ते स्थानं प्रीणात्यस्मानिति ब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2077579, "chapter_id": 2644, "verse_number": "१२-१४९-११", "content_sanskrit": "रुधिरस्येव ते गन्धः शवस्येव च दर्शनम्।\nअशिवः शिवसंकाशो मृतो जीवन्निवाटसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2077580, "chapter_id": 2644, "verse_number": "१२-१४९-१२", "content_sanskrit": "अन्तर्भृत्युरशुद्धात्मा पापमेवानुचिन्तयन्।\nप्रबुध्यसे प्रस्वपिपि वर्तसे परमे सुखे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2077581, "chapter_id": 2644, "verse_number": "१२-१४९-१३", "content_sanskrit": "मोघं ते जीवितं राजन्परिक्लिष्टं च जीवसि।\nपापायैव हि सृष्टोऽसि कर्मणेह यवीयसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2077582, "chapter_id": 2644, "verse_number": "१२-१४९-१४", "content_sanskrit": "बहुकल्याणमिच्छन्त ईहन्ते पितरः सुतान्।\nतपसा दैवतेज्याभिर्वन्दनेन तितिक्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2077583, "chapter_id": 2644, "verse_number": "१२-१४९-१५", "content_sanskrit": "पितृवंशमिमं पश्य त्वत्कृते निधनं गतम्।\nनिरर्थाः सर्व एवैषामाशाबन्धास्त्वदाश्रयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2077584, "chapter_id": 2644, "verse_number": "१२-१४९-१६", "content_sanskrit": "यान्पूजयन्तो विन्दन्ति स्वर्गमायुर्यशः प्रजाः।\nतेषु ते संततं द्वेषो ब्राह्मणेषु निरर्थकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2077585, "chapter_id": 2644, "verse_number": "१२-१४९-१७", "content_sanskrit": "इमं लोकं विमुच्य त्वमवाङ्भूर्धा पतिष्यसि।\nअशाश्वतीः शाश्वतीश्च समाः पापेन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2077586, "chapter_id": 2644, "verse_number": "१२-१४९-१८", "content_sanskrit": "स्वाद्यमानो जन्तुशतैस्तीक्ष्णदंष्ट्रैरयोमुखैः।\nततश्च पुनरावृत्तः पापयोनिं गमिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2077587, "chapter_id": 2644, "verse_number": "१२-१४९-१९", "content_sanskrit": "यदिदं मन्यसे राजन्नायमस्ति कुतः परः।\nप्रतिस्मारयितारस्त्वां यमदूता यमक्षये॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2077588, "chapter_id": 2644, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि एकोनपञ्चाशदधिकशततमोऽध्यायः॥ १४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]