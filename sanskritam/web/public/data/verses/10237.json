[{"id": 6000237000, "chapter_id": 10237, "verse_number": null, "content_sanskrit": "अथ एकचत्वारिंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000237001, "chapter_id": 10237, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.001.m4a", "display_order": 2}, {"id": 6000237002, "chapter_id": 10237, "verse_number": "१०-४१-१", "content_sanskrit": "अथ कृष्णश्च रामश्च कृतशौचौ परन्तपौ।\nमल्लदुन्दुभिनिर्घोषं श्रुत्वा द्रष्टुमुपेयतुः॥ १०/४१/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.002.m4a", "display_order": 3, "topics": [{"text": "कुवलयापीडवधः", "range": "१–१८"}]}, {"id": 6000237003, "chapter_id": 10237, "verse_number": "१०-४१-२", "content_sanskrit": "रङ्गद्वारं समासाद्य तस्मिन् गजमवस्थितम्।\nअपश्यत् कुवलयापीडं कृष्णोऽम्बष्ठप्रचोदितम्॥ १०/४१/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.003.m4a", "display_order": 4}, {"id": 6000237004, "chapter_id": 10237, "verse_number": "१०-४१-३", "content_sanskrit": "बद्ध्वा परिकरं शौरिः समूह्य कुटिलालकान्।\nउवाच हस्तिपं वाचा मेघनादगभीरया॥ १०/४१/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.004.m4a", "display_order": 5}, {"id": 6000237005, "chapter_id": 10237, "verse_number": "१०-४१-४", "content_sanskrit": "अम्बष्ठाम्बष्ठ मार्गं नौ देह्यपक्राम माचिरम्।\nनो चेत् सकुञ्जरं त्वाऽद्य नयामि यमसादनम्॥ १०/४१/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.005.m4a", "display_order": 6}, {"id": 6000237006, "chapter_id": 10237, "verse_number": "१०-४१-५", "content_sanskrit": "एवं निर्भर्त्सितोऽम्बष्ठः कुपितः कोपितं गजम्।\nचोदयामास कृष्णाय कालान्तकयमोपमम्॥ १०/४१/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.006.m4a", "display_order": 7}, {"id": 6000237007, "chapter_id": 10237, "verse_number": "१०-४१-६", "content_sanskrit": "करीन्द्रस्तमभिद्रुत्य करेण तरसाऽग्रहीत्।\nकराद् विगलितः सोऽमुं निहत्याङ्घ्रिष्वलीयत॥ १०/४१/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.007.m4a", "display_order": 8}, {"id": 6000237008, "chapter_id": 10237, "verse_number": "१०-४१-७", "content_sanskrit": "संक्रुद्धस्तमचक्षाणो घ्राणदृष्टिः स केशवम्।\nपरामृशत् पुष्करेण स प्रसह्य विनिर्गतः॥ १०/४१/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.008.m4a", "display_order": 9}, {"id": 6000237009, "chapter_id": 10237, "verse_number": "१०-४१-८", "content_sanskrit": "पुच्छे प्रगृह्यातिबलं धनुषः पञ्चविंशतिम्।\nविचकर्ष यथा नागं सुपर्ण इव लीलया॥ १०/४१/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.009.m4a", "display_order": 10}, {"id": 6000237010, "chapter_id": 10237, "verse_number": "१०-४१-९", "content_sanskrit": "स पर्यावर्तमानेन सव्यदक्षिणतोऽच्युतः।\nबभ्राम भ्राम्यमाणेन गोवत्सेनेव बालकः॥ १०/४१/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.010.m4a", "display_order": 11}, {"id": 6000237011, "chapter_id": 10237, "verse_number": "१०-४१-१०", "content_sanskrit": "ततोऽभिमुखमभ्येत्य पाणिनाऽऽहत्य वारणम्।\nप्राद्रवन् यापयामास स्पृश्यमानः पदे पदे॥ १०/४१/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.011.m4a", "display_order": 12}, {"id": 6000237012, "chapter_id": 10237, "verse_number": "१०-४१-११", "content_sanskrit": "स धावन् क्रीडया भूमौ पतित्वा सहसोत्थितः।\nतं मत्वा पतितं क्रुद्धो दन्ताभ्यां सोऽहनत् क्षितिम्॥ १०/४१/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.012.m4a", "display_order": 13}, {"id": 6000237013, "chapter_id": 10237, "verse_number": "१०-४१-१२", "content_sanskrit": "स्वविक्रमे प्रतिहते कुञ्जरेन्द्रोऽत्यमर्षितः।\nचोद्यमानो महामात्रैः कृष्णमभ्यद्रवद् रुषा॥ १०/४१/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.013.m4a", "display_order": 14}, {"id": 6000237014, "chapter_id": 10237, "verse_number": "१०-४१-१३", "content_sanskrit": "तमापतन्तमासाद्य भगवान् मधुसूदनः।\nप्रगृह्य पाणिना हस्तं पातयामास भूतले॥ १०/४१/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.014.m4a", "display_order": 15}, {"id": 6000237015, "chapter_id": 10237, "verse_number": "१०-४१-१४", "content_sanskrit": "पतितस्य पदाऽऽक्रम्य मृगेन्द्र इव लीलया।\nदन्तमुत्पाट्य तेनेमं हस्तिपांश्चाहनद् हरिः॥ १०/४१/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.015.m4a", "display_order": 16}, {"id": 6000237016, "chapter_id": 10237, "verse_number": "१०-४१-१५", "content_sanskrit": "मृतकं द्विपमुत्सृज्य दन्तपाणी विरेजतुः। अंसन्यस्तविषाणासृङ्मदबिन्दुभिरङ्कितौ।\nविरूढस्वेदकणिकवदनाम्बुरुहावुभौ॥ १०/४१/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.016.m4a", "display_order": 17}, {"id": 6000237017, "chapter_id": 10237, "verse_number": "१०-४१-१६", "content_sanskrit": "वृतौ गोपैः कतिपयैर्बलदेवजनार्दनौ।\nरङ्गं विविशतू राजन् गजदन्तवरायुधौ॥ १०/४१/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.017.m4a", "display_order": 18}, {"id": 6000237018, "chapter_id": 10237, "verse_number": "१०-४१-१७", "content_sanskrit": "मल्लानामशनिर्नृणां नरवरः स्‍त्रीणां स्मरो मूर्तिमान्\nगोपानां स्वजनोऽसतां क्षितिभृतां शास्ता स्वपित्रोः शिशुः।\nमृत्युर्भोजपतेर्विधातृविहितस्तत्त्वं परं योगिनां\nवृष्णीनां च पतिः सदैव शुशुभे रङ्गेऽच्युतः साग्रजः॥ १०/४१/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.018.m4a", "display_order": 19}, {"id": 6000237019, "chapter_id": 10237, "verse_number": "१०-४१-१८", "content_sanskrit": "हतं कुवलयापीडं दृष्ट्वा तावपि दुर्जयौ।\nकंसो मनस्व्यपि तदा भृशमुद्विविजे नृप॥ १०/४१/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.019.m4a", "display_order": 20}, {"id": 6000237020, "chapter_id": 10237, "verse_number": "१०-४१-१९", "content_sanskrit": "तौ रेजतू रङ्गगतौ महाभुजौ विचित्रवेषाभरणस्रगम्बरौ।\nयथा नटावुत्तमवेषधारिणौ मनः क्षिपन्तौ प्रभया निरीक्षताम्॥ १०/४१/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.020.m4a", "display_order": 21, "topics": [{"text": "रङ्गप्रविष्टयो रामकेशवयोर्वर्णनम्", "range": "१९–३०"}]}, {"id": 6000237021, "chapter_id": 10237, "verse_number": "१०-४१-२०", "content_sanskrit": "निरीक्ष्य तावुत्तमपुरुषौ जना मञ्चस्थिता नागरराष्ट्रका नृप।\nप्रहर्षवेगोत्कलितेक्षणाननाः पपुर्न तृप्ता नयनैस्तदाननम्॥ १०/४१/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.021.m4a", "display_order": 22}, {"id": 6000237022, "chapter_id": 10237, "verse_number": "१०-४१-२१", "content_sanskrit": "पिबन्त इव चक्षुर्भ्यां लिहन्त इव जिह्वया।\nजिघ्रन्त इव नासाभ्यां श्लिष्यन्त इव बाहुभिः॥ १०/४१/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.022.m4a", "display_order": 23}, {"id": 6000237023, "chapter_id": 10237, "verse_number": "१०-४१-२२", "content_sanskrit": "ऊचुः परस्परं ते वै यथादृष्टं यथाश्रुतम्।\nतद्रूपगुणमाधुर्यप्रागल्भ्यस्मारिता इव॥ १०/४१/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.023.m4a", "display_order": 24}, {"id": 6000237024, "chapter_id": 10237, "verse_number": "१०-४१-२३", "content_sanskrit": "एतौ भगवतः साक्षाद् हरेर्नारायणस्य हि।\nअवतीर्णाविहांशेन वसुदेवस्य वेश्मनि॥ १०/४१/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.024.m4a", "display_order": 25}, {"id": 6000237025, "chapter_id": 10237, "verse_number": "१०-४१-२४", "content_sanskrit": "स एष किल देवक्यां जातो नीतश्च गोकुलम्।\nकालमेतं वसन् गूढो ववृधे नन्दवेश्मनि॥ १०/४१/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.025.m4a", "display_order": 26}, {"id": 6000237026, "chapter_id": 10237, "verse_number": "१०-४१-२५", "content_sanskrit": "पूतनाऽनेन नीताऽन्तं चक्रवातश्च दानवः।\nअर्जुनौ धेनुकः केशी गुह्यकोऽन्ये च तद्विधाः॥ १०/४१/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.026.m4a", "display_order": 27}, {"id": 6000237027, "chapter_id": 10237, "verse_number": "१०-४१-२६", "content_sanskrit": "गावः सपाला एतेन दावाग्नेः परिमोचिताः।\nकालियो दमितः सर्पः शक्रश्च विमदः कृतः॥ १०/४१/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.027.m4a", "display_order": 28}, {"id": 6000237028, "chapter_id": 10237, "verse_number": "१०-४१-२७", "content_sanskrit": "सप्ताहमेकहस्तेन धृतोऽद्रिप्रवरोऽमुना।\nवर्षवाताशनिभ्यश्च परित्रातं च गोकुलम्॥ १०/४१/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.028.m4a", "display_order": 29}, {"id": 6000237029, "chapter_id": 10237, "verse_number": "१०-४१-२८", "content_sanskrit": "गोप्योऽस्य नित्यमुदितहसितप्रेक्षणं मुखम्।\nपश्यन्त्यो विविधांस्तापांस्तरन्ति स्माश्रमं मुदा॥ १०/४१/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.029.m4a", "display_order": 30}, {"id": 6000237030, "chapter_id": 10237, "verse_number": "१०-४१-२९", "content_sanskrit": "वदन्त्यनेन वंशोऽयं यदोः सुबहुविश्रुतः।\nश्रियं यशो महत्त्वं च लप्स्यते परिरक्षितः॥ १०/४१/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.030.m4a", "display_order": 31}, {"id": 6000237031, "chapter_id": 10237, "verse_number": "१०-४१-३०", "content_sanskrit": "अयं चास्याग्रजः श्रीमान् रामः कमललोचनः।\nप्रलम्बो निहतो येन बहवो धेनुकादयः॥ १०/४१/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.031.m4a", "display_order": 32}, {"id": 6000237032, "chapter_id": 10237, "verse_number": "१०-४१-३१", "content_sanskrit": "जनेष्वेवं ब्रुवाणेषु तूर्येषु निनदत्सु च।\nकृष्णरामौ समाभाष्य चाणूरो वाक्यमब्रवीत्॥ १०/४१/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.032.m4a", "display_order": 33, "topics": [{"text": "तयोश्चाणूरेण सह भाषणम्", "range": "३१–४०"}]}, {"id": 6000237033, "chapter_id": 10237, "verse_number": "१०-४१-३२", "content_sanskrit": "हे नन्दसूनो हे राम भवन्तौ वीर्यसम्मतौ।\nनियुद्धकुशलौ श्रुत्वा राज्ञाऽऽहूतौ दिदृक्षुणा॥ १०/४१/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.033.m4a", "display_order": 34}, {"id": 6000237034, "chapter_id": 10237, "verse_number": "१०-४१-३३", "content_sanskrit": "प्रियं राज्ञः प्रकुर्वन्त्यः श्रेयो विन्दन्ति वै प्रजाः।\nमनसा कर्मणा वाचा विपरीतमतोऽन्यथा॥ १०/४१/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.034.m4a", "display_order": 35}, {"id": 6000237035, "chapter_id": 10237, "verse_number": "१०-४१-३४", "content_sanskrit": "नित्यं प्रमुदिता गोपा वत्सपालास्तथा स्फुटम्।\nवनेषु मल्लयुद्धेन क्रीडन्तश्चारयन्ति गाः॥ १०/४१/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.035.m4a", "display_order": 36}, {"id": 6000237036, "chapter_id": 10237, "verse_number": "१०-४१-३५", "content_sanskrit": "तस्माद् राज्ञः प्रियं यूयं वयं च करवामहे।\nभूतानि नः प्रसीदन्ति सर्वभूतमयो नृपः॥ १०/४१/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.036.m4a", "display_order": 37}, {"id": 6000237037, "chapter_id": 10237, "verse_number": "१०-४१-३६", "content_sanskrit": "तन्निशम्याब्रवीत् कृष्णो देशकालोचितं वचः।\nनियुद्धमात्मनोऽभीष्टं मन्यमानोऽभिनन्द्य च॥ १०/४१/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.037.m4a", "display_order": 38}, {"id": 6000237038, "chapter_id": 10237, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.038.m4a", "display_order": 39}, {"id": 6000237039, "chapter_id": 10237, "verse_number": "१०-४१-३७", "content_sanskrit": "प्रजा भोजपतेर्यूयं वयं चापि वनेचराः।\nकरवाम प्रियं नित्यं तन्नः परमनुग्रहः॥ १०/४१/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.039.m4a", "display_order": 40}, {"id": 6000237040, "chapter_id": 10237, "verse_number": "१०-४१-३८", "content_sanskrit": "बाला वयं तुल्यबलैः क्रीडिष्यामो यथोचितम्।\nभवेन्नियुद्धं माऽधर्मः स्पृशेन्मल्ल सभासदः॥ १०/४१/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.040.m4a", "display_order": 41}, {"id": 6000237041, "chapter_id": 10237, "verse_number": null, "content_sanskrit": "चाणूर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.041.m4a", "display_order": 42}, {"id": 6000237042, "chapter_id": 10237, "verse_number": "१०-४१-३९", "content_sanskrit": "न बालो न किशोरस्त्वं बलश्च बलिनां वरः।\nलीलयेभो हतो येन सहस्रद्विपसत्त्वभृत्॥ १०/४१/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.042.m4a", "display_order": 43}, {"id": 6000237043, "chapter_id": 10237, "verse_number": "१०-४१-४०", "content_sanskrit": "तस्माद् भवद्भ्यां बलिभिर्योद्धव्यं नानयोऽत्र वै।\nमयि विक्रम वार्ष्णेय बलेन सह मुष्टिकः॥ १०/४१/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_041/BhP_10.041.043.m4a", "display_order": 44}, {"id": 6000237044, "chapter_id": 10237, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे एकचत्वारिंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]