[{"id": 2185675, "chapter_id": 4942, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2185676, "chapter_id": 4942, "verse_number": "१", "content_sanskrit": "आनृशंस्यं विजानामि दर्शनेन सतां सदा ।\nनृशंसान्न विजानामि तेषां कर्म च भारत\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2185677, "chapter_id": 4942, "verse_number": "२", "content_sanskrit": "कण्टकान् कूपमग्निं च वर्जयन्ति यथा नराः ।\nतथा नृशंसकर्माणं वर्जयन्ति नरा नरम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2185678, "chapter_id": 4942, "verse_number": "३", "content_sanskrit": "नृशंसो ह्यधमो नित्यं प्रेत्य चेह च भारत ।\nतस्माद्ब्रवीहि कौरव्य तस्य धर्मविनिश्चयम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2185679, "chapter_id": 4942, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2185680, "chapter_id": 4942, "verse_number": "४", "content_sanskrit": "स्पृहास्यान्तर्हिता चैव विदितार्था च कर्मणा ।\nआक्रोष्टा क्रुश्यते चैव बन्धिता बध्यते च यः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2185681, "chapter_id": 4942, "verse_number": "५", "content_sanskrit": "दत्तानुकीर्तिर्विषमः क्षुद्रो नैकृतिकः शठः ।\nअसम्भोगी च मानी च तथा सङ्गी विकत्थनः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2185682, "chapter_id": 4942, "verse_number": "६", "content_sanskrit": "सर्वातिशङ्की परुषो बालिशः कृपणस्तथा ।\nवर्गप्रशंसी सततमाश्रमद्वेषसङ्करी\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2185683, "chapter_id": 4942, "verse_number": "७", "content_sanskrit": "हिंसाविहारी सततमविशेषगुणागुणः ।\nबह्वलीको मनस्वी च लुब्धोऽत्यर्थं नृशंसकृत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2185684, "chapter_id": 4942, "verse_number": "८", "content_sanskrit": "धर्मशीलं गुणोपेतं पाप इत्यवगच्छति ।\nआत्मशीलानुमानेन न विश्वसिति कस्यचित्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2185685, "chapter_id": 4942, "verse_number": "९", "content_sanskrit": "परेषां यत्र दोषः स्यात्तद् गुह्यं सम्प्रकाशयेत् ।\nसमानेष्वेव दोषेषु वृत्त्यर्थमुपघातयेत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2185686, "chapter_id": 4942, "verse_number": "१०", "content_sanskrit": "तथोपकारिणं चैव मन्यते वञ्चितं परम् ।\nदत्त्वापि च नयं काले सन्तरत्युपकारिणे\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2185687, "chapter_id": 4942, "verse_number": "११", "content_sanskrit": "भक्ष्यं भोज्यमथो लेह्यं यच्चान्यत् साधु भोजनम् ।\nप्रेक्षमाणेषु योऽश्नीयान्नृशंस इति तं विदुः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2185688, "chapter_id": 4942, "verse_number": "१२", "content_sanskrit": "ब्राह्मणेभ्यः प्रदायाग्रं यः सुहृद्भिः सहाश्नुते ।\nस प्रेत्य लभते स्वर्गमिह चानन्त्यमश्नुते\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2185689, "chapter_id": 4942, "verse_number": "१३", "content_sanskrit": "एष ते भरतश्रेष्ठ नृशंसः परिकीर्तितः ।\nसदा विवर्जनीयो वै पुरुषेण बुभूषता\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2185690, "chapter_id": 4942, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि आपद्धर्मे त्रिंशोऽध्यायः ॥ ३० ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]