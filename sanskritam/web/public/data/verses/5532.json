[{"id": 2212658, "chapter_id": 5532, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2212659, "chapter_id": 5532, "verse_number": "१", "content_sanskrit": "युधिष्ठिर महाबाहो यथाऽऽह कुरुनन्दनः ।\nधृतराष्ट्रो महात्मा त्वं तत् कुरुष्वाविचारयन्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2212660, "chapter_id": 5532, "verse_number": "२", "content_sanskrit": "अयं हि वृद्धो नृपतिर्हतपुत्रो विशेषतः ।\nनेदं कृच्छ्रं चिरगतः सहेदिति मतिर्मम\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2212661, "chapter_id": 5532, "verse_number": "३", "content_sanskrit": "गान्धारी सा महाभागा प्राज्ञा करुणवेदिनी ।\nपुत्रशोकं महाराज धैर्येणोद्वहते भृशम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2212662, "chapter_id": 5532, "verse_number": "४", "content_sanskrit": "अहमप्येतदेव त्वां ब्रवीमि कुरु मे वचः ।\nअनुज्ञां लभतां राजा मा वृथेह मरिष्यति\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2212663, "chapter_id": 5532, "verse_number": "", "content_sanskrit": "स्वस्थो भवत्ययं धीमान् वनेषु मधुगन्धिषु ।\n(राजर्षीणां पुराणानामनुयातु गतिं नृपः\t॥५॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2212664, "chapter_id": 5532, "verse_number": "६", "content_sanskrit": "राजर्षीणां हि सर्वेषामन्ते वनमुपाश्रयः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2212665, "chapter_id": 5532, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2212666, "chapter_id": 5532, "verse_number": "७", "content_sanskrit": "इत्युक्तः स ततो राजा व्यासेनाद्भुतकर्मणा ।\nप्रत्युवाच महातेजा धर्मराजो महामुनिम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2212667, "chapter_id": 5532, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2212668, "chapter_id": 5532, "verse_number": "८", "content_sanskrit": "भगवानेव नो मान्यो भगवानेव नो गुरुः ।\nभगवानस्य राज्यस्य कुलस्य च परायणम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2212669, "chapter_id": 5532, "verse_number": "९", "content_sanskrit": "अहं तु पुत्रो भगवन् पिता राजा गुरुश्च मे ।\nनिदेशवर्ती च पितुः पुत्रो भवति धर्मतः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2212670, "chapter_id": 5532, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2212671, "chapter_id": 5532, "verse_number": "१०", "content_sanskrit": "इत्युक्तः स तु तं प्राह व्यासो धर्मभृतां वरः ।\nयुधिष्ठिरं महातेजाः पुनरेव विशाम्पते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2212672, "chapter_id": 5532, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2212673, "chapter_id": 5532, "verse_number": "११", "content_sanskrit": "एवमेतन्महाबाहो यथा वदसि कौरव ।\nराजाऽयं वृद्धतां प्राप्तः प्रमाणे परमे स्थितः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2212674, "chapter_id": 5532, "verse_number": "१२", "content_sanskrit": "सोऽयं मयाऽभ्यनुज्ञातस्त्वया च पृथिवीपतिः ।\nकरोतु स्वमभिप्रायं माऽस्य विघ्नकरो भव\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2212675, "chapter_id": 5532, "verse_number": "१३", "content_sanskrit": "एष एव परो धर्मो राजर्षीणां युधिष्ठिर ।\nसमरे वा भवेन्मृत्युर्वने वा विधिपूर्वकम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2212676, "chapter_id": 5532, "verse_number": "१४", "content_sanskrit": "पित्राऽपि तव राजेन्द्र पाण्डुना पृथिवीक्षिता ।\nशिष्यभूतेन राजाऽयं गुरुवत् पर्युपासितः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2212677, "chapter_id": 5532, "verse_number": "१५", "content_sanskrit": "क्रतुभिर्दक्षिणाभिश्च रत्नपर्वतशोभितैः ।\nमहद्भिरिष्टं भोगाश्च भुक्ताः पुत्राश्च लालिताः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2212678, "chapter_id": 5532, "verse_number": "१६", "content_sanskrit": "अत्र संस्थं च विपुलं राज्यं विप्रोषिते त्वयि ।\nत्रयोदश समा भुङ्क्त दत्तं च विपुलं वसु\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2212679, "chapter_id": 5532, "verse_number": "१७", "content_sanskrit": "त्वया च पुरुषव्याघ्र गुरुशुषूषया नृप ।\nआराधितः सभृत्येन गान्धारी च यशस्विनी\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2212680, "chapter_id": 5532, "verse_number": "१८", "content_sanskrit": "अनुजानीहि पितरं समयोऽस्य तपोविधौ ।\nन मन्युर्विद्यते चास्य सुसूक्ष्मोऽपि युधिष्ठिर\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2212681, "chapter_id": 5532, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2212682, "chapter_id": 5532, "verse_number": "१९", "content_sanskrit": "एतावदुक्त्वा वचनम् अनुज्ञाप्य च पार्थिवम् ।\nतथाऽस्त्विति च तेनोक्तः कौन्तेयेन ययौ वनम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2212683, "chapter_id": 5532, "verse_number": "२०", "content_sanskrit": "गते भगवति व्यासे राजा पाण्डुसुतस्ततः ।\nप्रोवाच पितरं वृद्धं मन्दं मन्दमिवानतः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2212684, "chapter_id": 5532, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2212685, "chapter_id": 5532, "verse_number": "२१", "content_sanskrit": "यथाऽऽह भगवान् व्यासो यच्चापि भवतो मतम् ।\nयथाऽऽह च महेष्वासः कृपो विदुर एव च\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2212686, "chapter_id": 5532, "verse_number": "२२", "content_sanskrit": "युयुत्सुः सञ्जयश्चैव तत् कर्तास्म्यहमञ्जसा\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2212687, "chapter_id": 5532, "verse_number": "२३", "content_sanskrit": "सर्वे ते ह्यनुमान्या मे कुलस्यास्य हितैषिणः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2212688, "chapter_id": 5532, "verse_number": "२४", "content_sanskrit": "इदं तु याचे नृपते त्वामहं शिरसा नतः ।\nक्रियतां तावदाहारस्ततो गच्छाश्रमं प्रति\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2212689, "chapter_id": 5532, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nआश्रमवासिकपर्वणि धृतराष्ट्रस्य आश्रमवासनिश्चयो नाम अष्टमोऽध्यायः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2212690, "chapter_id": 5532, "verse_number": "", "content_sanskrit": "आश्रमवासपर्वणि अष्टमोऽध्यायः ॥८॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]