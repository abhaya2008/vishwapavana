[{"id": 6000177000, "chapter_id": 10177, "verse_number": null, "content_sanskrit": "अथ द्वितीयाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000177001, "chapter_id": 10177, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_002/BhP_09.002.001.m4a", "display_order": 2}, {"id": 6000177002, "chapter_id": 10177, "verse_number": "९-२-१", "content_sanskrit": "कथमेवङ्गुणो देशः केन वा भगवन् कृतः।\nप्रश्नमेनं समाचक्ष्व परं कौतूहलं हि नः॥ ९/२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_002/BhP_09.002.002.m4a", "display_order": 3, "topics": [{"text": "सुद्युम्नस्य स्‍त्रीत्वप्राप्तौ कारणनिरूपणम्", "range": "१–५"}]}, {"id": 6000177003, "chapter_id": 10177, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_002/BhP_09.002.003.m4a", "display_order": 4}, {"id": 6000177004, "chapter_id": 10177, "verse_number": "९-२-२", "content_sanskrit": "एकदा गिरिशं द्रष्टुमृषयस्तत्र सुव्रताः।\nदिशो वितिमिरा भासा कुर्वन्तस्तमुपागमन्॥ ९/२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_002/BhP_09.002.004.m4a", "display_order": 5}, {"id": 6000177005, "chapter_id": 10177, "verse_number": "९-२-३", "content_sanskrit": "तान् विलोक्याम्बिका देवी विवस्‍त्रा व्रीडिता भृशम्।\nभर्तुरङ्कात् समुत्थाय नीवीमाश्वथ पर्यधात्॥ ९/२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_002/BhP_09.002.005.m4a", "display_order": 6}, {"id": 6000177006, "chapter_id": 10177, "verse_number": "९-२-४", "content_sanskrit": "ऋषयोऽपि तयोर्वीक्ष्य प्रसङ्गं रममाणयोः।\nनिवृत्ताः प्रययुस्तस्मान्नरनारायणाश्रमम्॥ ९/२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_002/BhP_09.002.006.m4a", "display_order": 7}, {"id": 6000177007, "chapter_id": 10177, "verse_number": "९-२-५", "content_sanskrit": "तदैवं भगवानाह प्रियायाः प्रियकाम्यया।\nस्थानं यः प्रविशेदेतत् स वै योषिद् भवेदिति॥ ९/२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_002/BhP_09.002.007.m4a", "display_order": 8}, {"id": 6000177008, "chapter_id": 10177, "verse_number": "९-२-६", "content_sanskrit": "तत ऊर्ध्वं वनं तद् वै पुरुषा वर्जयन्ति हि।\nस चानुचरसंयुक्तो विचचार वनाद् वनम्॥ ९/२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_002/BhP_09.002.008.m4a", "display_order": 9, "topics": [{"text": "तस्यामिलायां सोमसुताद्बुधात्पुरूरवोनामकपुत्रोत्पत्तिः", "range": "६–८"}]}, {"id": 6000177009, "chapter_id": 10177, "verse_number": "९-२-७", "content_sanskrit": "अथ तामाश्रमाभ्याशे चरन्तीं प्रमदोत्तमाम्।\nस्‍त्रीभिः परिवृतां वीक्ष्य चकमे भगवान् बुधः॥ ९/२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_002/BhP_09.002.009.m4a", "display_order": 10}, {"id": 6000177010, "chapter_id": 10177, "verse_number": "९-२-८", "content_sanskrit": "साऽपि तं चकमे सुभ्रूः सोमराजसुतं पतिम्।\nस तस्यां जनयामास पुरूरवसमात्मजम्॥ ९/२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_002/BhP_09.002.010.m4a", "display_order": 11}, {"id": 6000177011, "chapter_id": 10177, "verse_number": "९-२-९", "content_sanskrit": "एवं स्‍त्रीत्वमनुप्राप्तः सुद्युम्नो मानवो नृपः।\nसस्मार स्वकुलाचार्यं वसिष्ठमिति शुश्रुम॥ ९/२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_002/BhP_09.002.011.m4a", "display_order": 12, "topics": [{"text": "ततः शङ्करप्रसादेन तस्याः पुनः मासपर्यायव्यवस्थया स्त्रीपुंस्त्वप्राप्तिः", "range": "९–१२"}]}, {"id": 6000177012, "chapter_id": 10177, "verse_number": "९-२-१०", "content_sanskrit": "स तस्य तां दशां दृष्ट्वा कृपया भृशपीडितः।\nसुद्युम्नस्याशयन् पुंस्त्वमुपाधावत शङ्करम्॥ ९/२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_002/BhP_09.002.012.m4a", "display_order": 13}, {"id": 6000177013, "chapter_id": 10177, "verse_number": "९-२-११", "content_sanskrit": "तुष्टः स तस्मै भगवान् ऋषये प्रीतिमावहन्।\nस्वां च वाचमृतां कुर्वन्निदमाह विशाम्पते॥ ९/२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_002/BhP_09.002.013.m4a", "display_order": 14}, {"id": 6000177014, "chapter_id": 10177, "verse_number": "९-२-१२", "content_sanskrit": "मासं पुमान् स भविता स्‍त्री मासं तपसा तव।\nइति व्यवस्थया कामं सुद्युम्नोऽवतु मेदिनीम्॥ ९/२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_002/BhP_09.002.014.m4a", "display_order": 15}, {"id": 6000177015, "chapter_id": 10177, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_002/BhP_09.002.015.m4a", "display_order": 16}, {"id": 6000177016, "chapter_id": 10177, "verse_number": "९-२-१३", "content_sanskrit": "आचार्यानुग्रहात् कामं लब्ध्वा पुंस्त्वं व्यवस्थया।\nपालयामास जगतीं नाभ्यनन्दन् स्म तं प्रजाः॥ ९/२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_002/BhP_09.002.016.m4a", "display_order": 17, "topics": [{"text": "सुद्युम्नस्य उत्कचादिपुत्रोत्पत्तिः", "range": "१३–१४"}]}, {"id": 6000177017, "chapter_id": 10177, "verse_number": "९-२-१४", "content_sanskrit": "तस्योत्कलो गयो राजन् विमलश्च सुतास्‍त्रयः।\nदक्षिणापथराजानो बभूवुर्धर्मवत्सलाः॥ ९/२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_002/BhP_09.002.017.m4a", "display_order": 18}, {"id": 6000177018, "chapter_id": 10177, "verse_number": "९-२-१५", "content_sanskrit": "ततः परिणतः काले प्रतिष्ठानपतिः प्रभुः।\nपुरूरवस उत्सृज्य गां पुत्राय गतो वनम्॥ ९/२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_002/BhP_09.002.018.m4a", "display_order": 19, "topics": [{"text": "पुरूरवसं प्रतिष्ठाननगरेऽभिषिच्य सुद्युम्नस्य तपोवनगमनम्", "range": "१५"}]}, {"id": 6000177019, "chapter_id": 10177, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां नवमस्कन्धस्य द्वितीयाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]