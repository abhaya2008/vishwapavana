[{"id": 7004019000, "chapter_id": 24019, "verse_number": "३-२-३०-१", "content_sanskrit": "व्यास उवाच ।\nपुरा त्रेतायुगे प्राप्ते वैष्णवांशो रघूद्वहः ।\nसूर्यवंशे समुत्पन्नो रामो राजीवलोचनः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004019001, "chapter_id": 24019, "verse_number": "३-२-३०-२", "content_sanskrit": "स रामो लक्ष्मणश्चैव काकपक्षधरावुभौ ।\nतातस्य वचनात्तौ तु विश्वामित्रमनुव्रतौ॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004019002, "chapter_id": 24019, "verse_number": "३-२-३०-३", "content_sanskrit": "यज्ञसंरक्षणार्थाय राज्ञा दत्तौ कुमारकौ ।\nधनुःशरधरौ वीरौ पितुर्वचनपालकौ॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004019003, "chapter_id": 24019, "verse_number": "३-२-३०-४", "content_sanskrit": "पथि प्रव्रजतो यावत्ताडकानाम राक्षसी ।\nतावदागम्य पुरतस्तस्थौ वै विघ्नकारणात्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004019004, "chapter_id": 24019, "verse_number": "३-२-३०-५", "content_sanskrit": "ऋषेरनुज्ञया रामस्ताडकां समघातयत् ।\nप्रादिशच्च धनुर्वेदविद्यां रामाय गाधिजः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004019005, "chapter_id": 24019, "verse_number": "३-२-३०-६", "content_sanskrit": "तस्य पादतलस्पर्शाच्छिला वासवयोगतः ।\nअहल्या गौतमवधूः पुनर्जाता स्वरूपिणी॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004019006, "chapter_id": 24019, "verse_number": "३-२-३०-७", "content_sanskrit": "विश्वामित्रस्य यज्ञे तु संप्रवृत्ते रघूत्तमः ।\nमारीचं च सुबाहुं च जघान परमेषुभिः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004019007, "chapter_id": 24019, "verse_number": "३-२-३०-८", "content_sanskrit": "ईश्वरस्य धनुर्भग्नं जनकस्य गृहे स्थितम् ।\nरामः पंचदशे वर्षे षड्वर्षां चैव मैथिलीम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004019008, "chapter_id": 24019, "verse_number": "३-२-३०-९", "content_sanskrit": "उपयेमे तदा राजन्रम्यां सीतामयोनिजाम् ।\nकृतकृत्यस्तदा जातः सीतां संप्राप्य राघवः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004019009, "chapter_id": 24019, "verse_number": "३-२-३०-१०", "content_sanskrit": "अयोध्यामगमन्मार्गे जामदग्न्यमवेक्ष्य च ।\nसंग्रामोऽभूत्तदा राजन्देवानामपि दुःसहः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004019010, "chapter_id": 24019, "verse_number": "३-२-३०-११", "content_sanskrit": "ततो रामं पराजित्य सीतया गृहमागतः ।\nततो द्वादशवर्षाणि रेमे रामस्तया सह॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004019011, "chapter_id": 24019, "verse_number": "३-२-३०-१२", "content_sanskrit": "एकविंशतिमे वर्षे यौवराज्यप्रदायकम् ।\nराजानमथ कैकेयी वरद्वयमयाच त॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004019012, "chapter_id": 24019, "verse_number": "३-२-३०-१३", "content_sanskrit": "तयोरेकेन रामस्तु ससीतः सहलक्ष्मणः ।\nजटाधरः प्रव्रजतां वर्षाणीह चतुर्दश॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004019013, "chapter_id": 24019, "verse_number": "३-२-३०-१४", "content_sanskrit": "भरतस्तु द्वितीयेन यौवराज्याधिपोस्तु मे ।\nमंथरावचनान्मूढा वरमेतमयाचत॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004019014, "chapter_id": 24019, "verse_number": "३-२-३०-१५", "content_sanskrit": "जानकीलक्ष्मणसखं रामं प्राव्राजयन्नृपः ।\nत्रिरात्रमुदकाहारश्चतुर्थेह्नि फलाशनः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004019015, "chapter_id": 24019, "verse_number": "३-२-३०-१६", "content_sanskrit": "पञ्चमे चित्रकूटे तु रामो वासमकल्पयत् ।\nतदा दशरथः स्वर्गं गतो राम इति ब्रुवन्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004019016, "chapter_id": 24019, "verse_number": "३-२-३०-१७", "content_sanskrit": "ब्रह्मशापं तु सफलं कृत्वा स्वर्गं जगाम किम् ।\nततो भरत शत्रुघ्नौ चित्रकूटे समागतौ॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004019017, "chapter_id": 24019, "verse_number": "३-२-३०-१८", "content_sanskrit": "स्वर्गतं पितरं राजन्रामाय विनिवेद्य च ।\nसांत्वनं भरतस्यास्य कृत्वा निवर्तनं प्रति॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004019018, "chapter_id": 24019, "verse_number": "३-२-३०-१९", "content_sanskrit": "ततो भरत शत्रुघ्नौ नंदिग्रामं समागतौ ।\nपादुकापूजनरतौ तत्र राज्यधरावुभौ॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004019019, "chapter_id": 24019, "verse_number": "३-२-३०-२०", "content_sanskrit": "अत्रिं दृष्ट्वा महात्मानं दण्डकारण्यमागमत ।\nरक्षोगणवधारम्भे विराधे विनिपातिते॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004019020, "chapter_id": 24019, "verse_number": "३-२-३०-२१", "content_sanskrit": "अर्द्धत्रयोदशे वर्षे पंचवट्यामुवास ह ।\nततो विरूपयामास शूर्पणखां निशाचरीम् ।\nवने विचरतरतस्य जानकीसहितस्य च॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004019021, "chapter_id": 24019, "verse_number": "३-२-३०-२२", "content_sanskrit": "आगतो राक्षसो घोरः सीतापहरणाय सः ।\nततो माघासिताष्टम्यां मुहूर्ते वृन्दसंज्ञके॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004019022, "chapter_id": 24019, "verse_number": "३-२-३०-२३", "content_sanskrit": "राघवाभ्यां विना सीतां जहार दश कन्धरः ।\nमारीचस्याश्रमं गत्वा मृगरूपेण तेन च॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004019023, "chapter_id": 24019, "verse_number": "३-२-३०-२४", "content_sanskrit": "नीत्वा दूरं राघवं च लक्ष्मणेन समन्वितम् ।\nततो रामो जघानाशु मारीचं मृगरू पिणम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004019024, "chapter_id": 24019, "verse_number": "३-२-३०-२५", "content_sanskrit": "पुनः प्राप्याश्रमं रामो विना सीतां ददर्श ह ।\nतत्रैव ह्रियमाणा सा चक्रंद कुररी यथा॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004019025, "chapter_id": 24019, "verse_number": "३-२-३०-२६", "content_sanskrit": "रामरामेति मां रक्ष रक्ष मां रक्षसा हृताम् ।\nयथा श्येनः क्षुधायु्क्तः क्रन्दंतीं वर्तिकां नयेत्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004019026, "chapter_id": 24019, "verse_number": "३-२-३०-२७", "content_sanskrit": "तथा कामवशं प्राप्तो राक्षसो जनकात्मजाम् ।\nनयत्येष जनकजां तच्छ्रुत्वा पक्षिराट् तदा॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004019027, "chapter_id": 24019, "verse_number": "३-२-३०-२८", "content_sanskrit": "युयुधे राक्षसेंद्रेण रावणेन हतोऽपतत् ।\nमाघासितनवम्यां तु वसंतीं रावणालये॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004019028, "chapter_id": 24019, "verse_number": "३-२-३०-२९", "content_sanskrit": "मार्गमाणौ तदा तौ तु भ्रातरौ रामलक्ष्मणौ॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004019029, "chapter_id": 24019, "verse_number": "३-२-३०-३०", "content_sanskrit": "जटायुषं तु दृष्ट्वैव ज्ञात्वा राक्षससंहृताम् ।\nसीतां ज्ञात्वा ततः पक्षी संस्कृतस्तेन भक्तितः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004019030, "chapter_id": 24019, "verse_number": "३-२-३०-३१", "content_sanskrit": "अग्रतः प्रययौ रामो लक्ष्मणस्तत्पदानुगः ।\nपंपाभ्याशमनुप्राप्य शबरीमनुगृह्य च॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004019031, "chapter_id": 24019, "verse_number": "३-२-३०-३२", "content_sanskrit": "तज्जलं समुपस्पृश्य हनुमद्दर्शनं कृतम् ।\nततो रामो हनुमता सह सख्यं चकार ह॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004019032, "chapter_id": 24019, "verse_number": "३-२-३०-३३", "content_sanskrit": "ततः सुग्रीवमभ्येत्य अहनद्वालिवानरम् ।\nप्रेषिता रामदेवेन हनुमत्प्रमुखाः प्रियाम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004019033, "chapter_id": 24019, "verse_number": "३-२-३०-३४", "content_sanskrit": "अंगुलीयकमादाय वायुसूनुस्तदागतः ।\nसंपातिर्दशमे मासि आचख्यौ वानराय ताम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004019034, "chapter_id": 24019, "verse_number": "३-२-३०-३५", "content_sanskrit": "ततस्तद्वचनादब्धिं पुप्लुवे शतयोजनम् ।\nहनुमान्निशि तस्यां तु लंकायां परितोऽचिनोत्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004019035, "chapter_id": 24019, "verse_number": "३-२-३०-३६", "content_sanskrit": "तद्रात्रिशेषे सीताया दर्शनं तु हनूमतः ।\nद्वादश्यां शिंशपावृक्षे हनुमान्पर्यवस्थितः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004019036, "chapter_id": 24019, "verse_number": "३-२-३०-३७", "content_sanskrit": "तस्यां निशायां जानक्या विश्वासायाह संकथाम् ।\nअक्षादिभिस्त्रयोदश्यां ततो युद्धमवर्त्तत॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004019037, "chapter_id": 24019, "verse_number": "३-२-३०-३८", "content_sanskrit": "ब्रह्मास्त्रेण त्रयोदश्यां बद्धः शक्रजिता कपिः ।\nदारुणानि च रूक्षाणि वाक्यानि राक्षसाधिपम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004019038, "chapter_id": 24019, "verse_number": "३-२-३०-३९", "content_sanskrit": "अब्रवीद्वायुसूनुस्तं बद्धो ब्रह्मास्त्रसंयुतः ।\nवह्निना पुच्छयुक्तेन लंकाया दहनं कृतम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004019039, "chapter_id": 24019, "verse_number": "३-२-३०-४०", "content_sanskrit": "पूर्णिमायां महेंद्राद्रौ पुनरागमनं कपेः ।\nमार्गशीर्षप्रतिपदः पंचभिः पथि वासरैः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004019040, "chapter_id": 24019, "verse_number": "३-२-३०-४१", "content_sanskrit": "पुनरागत्य वर्षेह्नि ध्वस्तं मधुवनं किल ।\nसप्तम्यां प्रत्यभिज्ञानदानं सर्वनिवेदनम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004019041, "chapter_id": 24019, "verse_number": "३-२-३०-४२", "content_sanskrit": "मणिप्रदानं सीतायाः सर्वं रामाय शंसयत् ।\nअष्टम्युत्तरफाल्गुन्यां मुहूर्ते विजयाभिधे॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004019042, "chapter_id": 24019, "verse_number": "३-२-३०-४३", "content_sanskrit": "मध्यं प्राप्ते सहस्रांशौ प्रस्थानं राघवस्य च ।\nरामः कृत्वा प्रतिज्ञां हि प्रयातुं दक्षिणां दिशम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004019043, "chapter_id": 24019, "verse_number": "३-२-३०-४४", "content_sanskrit": "तीर्त्वाहं सागरमपि हनिष्ये राक्षसेश्वरम् ।\nदक्षिणाशां प्रयातस्य सुग्रीवोऽथाभव त्सखा॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004019044, "chapter_id": 24019, "verse_number": "३-२-३०-४५", "content_sanskrit": "वासरैः सप्तभिः सिंधोस्तीरे सैन्यनिवेशनम् ।\nपौषशुक्लप्रतिपदस्तृतीयां यावदंबुधौ ।\nउपस्थानं ससैन्यस्य राघवस्य बभूव ह॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004019045, "chapter_id": 24019, "verse_number": "३-२-३०-४६", "content_sanskrit": "विभीषणश्चतुर्थ्यां तु रामेण सह संगतः ।\nसमुद्रतरणार्थाय पंचम्यां मंत्र उद्यतेः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004019046, "chapter_id": 24019, "verse_number": "३-२-३०-४७", "content_sanskrit": "प्रायोपवेशनं चक्रे रामो दिनचतुष्टयम् ।\nसमुद्राद्वरलाभश्च सहोपायप्रदर्शनः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004019047, "chapter_id": 24019, "verse_number": "३-२-३०-४८", "content_sanskrit": "सेतोर्दशम्यामारंभस्त्रयोदश्यां समापनम् ।\nचतुर्दश्यां सुवेलाद्रौ रामः सेनां न्यवे शयत्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004019048, "chapter_id": 24019, "verse_number": "३-२-३०-४९", "content_sanskrit": "पूर्णिमास्या द्वितीयायां त्रिदिनैः सैन्यतारणम् ।\nतीर्त्वा तोयनिधिं रामः शूरवानरसैन्यवान्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004019049, "chapter_id": 24019, "verse_number": "३-२-३०-५०", "content_sanskrit": "रुरोध च पुरीं लंकां सीतार्थं शुभलक्षणः ।\nतृतीयादिदशम्यंतं निवेशश्च दिनाष्टकः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004019050, "chapter_id": 24019, "verse_number": "३-२-३०-५१", "content_sanskrit": "शुकसारणयोस्तत्र प्राप्तिरेकादशीदिने ।\nपौषासिते च द्वादश्यां सैन्यसंख्यानमेव च॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004019051, "chapter_id": 24019, "verse_number": "३-२-३०-५२", "content_sanskrit": "शार्दूलेन कपींद्राणां सारासारोपवर्णनम् ।\nत्रयोदश्याद्यमांते च लंकायां दिवसैस्त्रिभिः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004019052, "chapter_id": 24019, "verse_number": "३-२-३०-५३", "content_sanskrit": "रावणः सैन्यसं ख्यानं रणोत्साहं तदाऽकरोत् ।\nप्रययावंगदो दौत्ये माघशुक्लाद्यवासरे॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004019053, "chapter_id": 24019, "verse_number": "३-२-३०-५४", "content_sanskrit": "सीतायाश्च तदा भर्तुर्मायामूर्धादिदर्शनम् ।\nमाघशुक्लद्वितीया यां दिनैः सप्तभिरष्टमीम्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004019054, "chapter_id": 24019, "verse_number": "३-२-३०-५५", "content_sanskrit": "रक्षसां वानराणां च युद्धमासीच्च संकुलम् ।\nमाघशुक्लनवम्यां तु रात्राविंद्रजिता रणे॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004019055, "chapter_id": 24019, "verse_number": "३-२-३०-५६", "content_sanskrit": "रामलक्ष्मणयोर्ना गपाशबंधः कृतः किल ।\nआकुलेषु कपीशेषु हताशेषु च सर्वशः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004019056, "chapter_id": 24019, "verse_number": "३-२-३०-५७", "content_sanskrit": "वायूपदेशाद्गरुडं सस्मार राघवस्तदा ।\nनागपाशविमोक्षार्थं दशम्यां गरु डोऽभ्यगात्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004019057, "chapter_id": 24019, "verse_number": "३-२-३०-५८", "content_sanskrit": "अवहारो माघशुक्लैस्यैकादश्यां दिनद्वयम् ।\nद्वादश्यामांजनेयेन धूम्राक्षस्य वधः कृतः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004019058, "chapter_id": 24019, "verse_number": "३-२-३०-५९", "content_sanskrit": "त्रयोदश्यां तु तेनैव निहतोऽकंपनो रणे ।\nमायासीतां दर्शयित्वा रामाय दशकंधरः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004019059, "chapter_id": 24019, "verse_number": "३-२-३०-६०", "content_sanskrit": "त्रासयामास च तदा सर्वान्सैन्यगतानपि ।\nमाघशुक्लचतुर्द्दश्यां यावत्कृष्णादिवासरम्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004019060, "chapter_id": 24019, "verse_number": "३-२-३०-६१", "content_sanskrit": "त्रिदिनेन प्रहस्तस्य नीलेन विहितो वधः ।\nमाघकृष्णद्वितीयायाश्चतुर्थ्यंतं त्रिभिर्दिनैः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004019061, "chapter_id": 24019, "verse_number": "३-२-३०-६२", "content_sanskrit": "रामेण तुमुले युद्धे रावणो द्रावितो रणात् ।\nपञ्चम्या अष्टमी यावद्रावणेन प्रबोधितः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004019062, "chapter_id": 24019, "verse_number": "३-२-३०-६३", "content_sanskrit": "कुंभकर्णस्तदा चक्रेऽभ्यवहारं चतुर्दिनम् ।\nकुम्भकर्णोकरोद्युद्धं नवम्यादिचतुर्दिनैः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004019063, "chapter_id": 24019, "verse_number": "३-२-३०-६४", "content_sanskrit": "रामेण निहतो युद्धे बहुवानरभक्षकः ।\nअमावास्यादिने शोकाऽभ्यवहारो बभूव ह॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004019064, "chapter_id": 24019, "verse_number": "३-२-३०-६५", "content_sanskrit": "फाल्गुनप्रतिपदादौ चतुर्थ्यंतैश्चतुर्दिनैः ।\nनरांतकप्रभृतयो निहताः पञ्च राक्षसाः॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004019065, "chapter_id": 24019, "verse_number": "३-२-३०-६६", "content_sanskrit": "पंचम्याः सप्तमीं यावदतिकायवधस्त्र्यहात् ।\nअष्टम्या द्वादशीं यावन्निहतो दिनपंचकात्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004019066, "chapter_id": 24019, "verse_number": "३-२-३०-६७", "content_sanskrit": "निकुम्भकुम्भौ द्वावेतौ मकराक्षश्चतुर्दिनैः ।\nफाल्गुनासितद्वितीयाया दिने वै शक्रजिज्जितः॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004019067, "chapter_id": 24019, "verse_number": "३-२-३०-६८", "content_sanskrit": "तृतीयादौ सप्तम्यंतदिनपञ्चकमेव च ।\nओषध्यानयवैयग्र्यादवहारो बभूव ह॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004019068, "chapter_id": 24019, "verse_number": "३-२-३०-६९", "content_sanskrit": "अष्टम्यां रावणो मायामैथिलीं हतवान्कुधीः ।\nशोकावेगात्तदा रामश्चक्रे सैन्यावधारणम्॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004019069, "chapter_id": 24019, "verse_number": "३-२-३०-७०", "content_sanskrit": "ततस्त्रयोदशीं यावद्दिनैः पंचभिरिंद्रजित् ।\nलक्ष्मणेन हतो युद्धे विख्यातबलपौरुषः॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004019070, "chapter_id": 24019, "verse_number": "३-२-३०-७१", "content_sanskrit": "चतुर्द्दश्यां दशग्रीवो दीक्षामापावहारतः ।\nअमावास्यादिने प्रागाद्युद्धाय दशकंधरः॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004019071, "chapter_id": 24019, "verse_number": "३-२-३०-७२", "content_sanskrit": "चैत्रशुक्लप्रतिपदः पंचमीदिनपंचके ।\nरावणो युध्यमानो ऽभूत्प्रचुरो रक्षसां वधः॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004019072, "chapter_id": 24019, "verse_number": "३-२-३०-७३", "content_sanskrit": "चैत्रशुक्लाष्टमीं यावत्स्यंदनाश्वादिसूदनम् ।\nचैत्रशुक्लनवम्यां तु सौमित्रेः शक्तिभेदने॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004019073, "chapter_id": 24019, "verse_number": "३-२-३०-७४", "content_sanskrit": "कोपाविष्टेन रामेण द्रावितो दशकंधरः ।\nविभीषणोपदेशेन हनुमद्युद्धमेव च॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004019074, "chapter_id": 24019, "verse_number": "३-२-३०-७५", "content_sanskrit": "द्रोणाद्रेरोषधीं नेतुं लक्ष्मणार्थमुपागतः ।\nविशल्यां तु समादाय लक्ष्मणं तामपाययत्॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004019075, "chapter_id": 24019, "verse_number": "३-२-३०-७६", "content_sanskrit": "दशम्यामवहारोऽभूद्रात्रौ युद्धं तु रक्षसाम् ।\nएकादश्यां तु रामाय रथो मातलिसारथिः॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004019076, "chapter_id": 24019, "verse_number": "३-२-३०-७७", "content_sanskrit": "प्राप्तो युद्धाय द्वादश्यां यावत्कृष्णां चतुर्दशीम् ।\nअष्टादशदिने रामो रावणं द्वैरथेऽवधीत्॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004019077, "chapter_id": 24019, "verse_number": "३-२-३०-७८", "content_sanskrit": "संस्कारा रावणादीनाममावा स्यादिनेऽभवन् ।\nसंग्रामे तुमुले जाते रामो जयमवाप्तवान्॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004019078, "chapter_id": 24019, "verse_number": "३-२-३०-७९", "content_sanskrit": "माघशुक्लद्वितीयादिचैत्रकृष्णचतुर्द्दशीम् ।\nसप्ताशीतिदिनान्येवं मध्ये पंवदशा हकम्॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004019079, "chapter_id": 24019, "verse_number": "३-२-३०-८०", "content_sanskrit": "युद्धावहारः संग्रामो द्वासप्ततिदिनान्यभूत् ।\nवैशाखादि तिथौ राम उवास रणभूमिषु ।\nअभिषिक्तो द्वितीयायां लंकाराज्ये विभी षणः॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004019080, "chapter_id": 24019, "verse_number": "३-२-३०-८१", "content_sanskrit": "सीताशुद्धिस्तृतीयायां देवेभ्यो वरलंभनम् ।\nदशरथस्यागमनं तत्र चैवानुमोदनम्॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004019081, "chapter_id": 24019, "verse_number": "३-२-३०-८२", "content_sanskrit": "हत्वा त्वरेण लंकेशं लक्ष्मणस्याग्रजो विभुः॥  ।\nगृहीत्वा जानकीं पुण्यां दुःखितां राक्षसेन तु॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004019082, "chapter_id": 24019, "verse_number": "३-२-३०-८३", "content_sanskrit": "आदाय परया प्रीत्या जानकीं स न्यवर्तत ।\nवैशाखस्य चतुर्थ्यां तु रामः पुष्पकमा श्रितः॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004019083, "chapter_id": 24019, "verse_number": "३-२-३०-८४", "content_sanskrit": "विहायसा निवृत्तस्तु भूयोऽयोध्यां पुरीं प्रति ।\nपूर्णे चतुर्दशे वर्षे पंचम्यां माधवस्य च॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004019084, "chapter_id": 24019, "verse_number": "३-२-३०-८५", "content_sanskrit": "भारद्वाजाश्रमे रामः सगणः समु पाविशत् ।\nनंदिग्रामे तु षष्ठ्यां स पुष्पकेण समागतः॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004019085, "chapter_id": 24019, "verse_number": "३-२-३०-८६", "content_sanskrit": "सप्तम्यामभिषिक्तोऽसौ भूयोऽयोध्यायां रघूद्वहः ।\nदशाहाधिकमासांश्च चतुर्दश हि मैथिली॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004019086, "chapter_id": 24019, "verse_number": "३-२-३०-८७", "content_sanskrit": "उवास रामरहिता रावणस्य निवेशने ।\nद्वाचत्वारिंशके वर्षे रामो राज्यमकारयत्॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004019087, "chapter_id": 24019, "verse_number": "३-२-३०-८८", "content_sanskrit": "सीतायास्तु त्रयस्त्रिंशद्वर्षाणि तु तदा भवन् ।\nस चतुर्दशवर्षांते प्रविष्टः स्वां पुरीं प्रभुः॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004019088, "chapter_id": 24019, "verse_number": "३-२-३०-८९", "content_sanskrit": "अयोध्यां नाम मुदितो रामो रावणदर्पहा ।\nभ्रातृभिः सहितस्तत्र रामो राज्यमकार यत्॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004019089, "chapter_id": 24019, "verse_number": "३-२-३०-९०", "content_sanskrit": "दशवर्षसहस्राणि दशवर्षशतानि च ।\nरामो राज्यं पालयित्वा जगाम त्रिदिवालयम्॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004019090, "chapter_id": 24019, "verse_number": "३-२-३०-९१", "content_sanskrit": "रामराज्ये तदा लोका हर्षनिर्भरमा नसाः ।\nबभूवुर्धनधान्याढ्याः पुत्रपौत्रयुता नराः॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004019091, "chapter_id": 24019, "verse_number": "३-२-३०-९२", "content_sanskrit": "कामवर्षी च पर्जन्यः सस्यानि गुणवंति च ।\nगावस्तु घटदोहिन्यः पादपाश्च सदा फलाः॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004019092, "chapter_id": 24019, "verse_number": "३-२-३०-९३", "content_sanskrit": "नाधयो व्याधयश्चैव रामराज्ये नराधिप ।\nनार्यः पतिव्रताश्चासन्पितृभक्तिपरा नराः॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004019093, "chapter_id": 24019, "verse_number": "३-२-३०-९४", "content_sanskrit": "द्विजा वेदपरा नित्यं क्षत्रिया द्विज सेविनः ।\nकुर्वते वैश्यवर्णाश्च भक्तिं द्विजगवां सदा॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004019094, "chapter_id": 24019, "verse_number": "३-२-३०-९५", "content_sanskrit": "न योनिसंकरश्चासीत्तत्र नाचारसंकरः ।\nन वंध्या दुर्भगा नारी काकवंध्या मृत प्रजा॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004019095, "chapter_id": 24019, "verse_number": "३-२-३०-९६", "content_sanskrit": "विधवा नैव काप्यासीत्सभर्तृका न लप्यते ।\nनावज्ञां कुर्वते केपि मातापित्रोर्गुरोस्तथा॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004019096, "chapter_id": 24019, "verse_number": "३-२-३०-९७", "content_sanskrit": "न च वाक्यं हि वृद्धानामुल्लं घयति पुण्यकृत् ।\nन भूमिहरणं तत्र परनारीपराङ्मुखाः॥ ९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004019097, "chapter_id": 24019, "verse_number": "३-२-३०-९८", "content_sanskrit": "नापवादपरो लोको न दरिद्रो न रोगभाक् ।\nन स्तेयो द्यूतकारी च मैरेयी पापिनो नहि॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004019098, "chapter_id": 24019, "verse_number": "३-२-३०-९९", "content_sanskrit": "न हेमहारी ब्रह्मघ्नो न चैव गुरुतल्पगः ।\nन स्त्रीघ्नो न च बालघ्नो न चैवानृतभाषणः॥ ९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004019099, "chapter_id": 24019, "verse_number": "३-२-३०-१००", "content_sanskrit": "न वृत्तिलोपकश्चासीत्कूट साक्षी न चैव हि ।\nन शठो न कृतघ्नश्च मलिनो नैव दृश्यते॥ १०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004019100, "chapter_id": 24019, "verse_number": "३-२-३०-१०१", "content_sanskrit": "सदा सर्वत्र पूज्यंते ब्राह्मणा वेदपारगाः ।\nनावैष्णवोऽव्रती राजन्राम राज्येऽतिविश्रुते॥ १०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004019101, "chapter_id": 24019, "verse_number": "३-२-३०-१०२", "content_sanskrit": "राज्यं प्रकुर्वतस्तस्य पुरोधा वदतां वरः ।\nवसिष्ठो मुनिभिः सार्द्धं कृत्वा तीर्थान्यनेकशः॥ १०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004019102, "chapter_id": 24019, "verse_number": "३-२-३०-१०३", "content_sanskrit": "आजगाम ब्रह्मपुत्रो महाभागस्तपोनिधिः ।\nरामस्तं पूजयामास मुनिभिः सहितं गुरुम्॥ १०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7004019103, "chapter_id": 24019, "verse_number": "३-२-३०-१०४", "content_sanskrit": "अभ्युत्थानार्घपाद्यैश्च मधुपर्कादिपूजया ।\nप्रपच्छ कुशलं रामं वसिष्ठो मुनिपुंगवः॥ १०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7004019104, "chapter_id": 24019, "verse_number": "३-२-३०-१०५", "content_sanskrit": "राज्ये चाश्वे गजे कोशे देशे सद्भ्रातृभृत्ययोः ।\nकुशलं वर्त्तते राम इति पृष्टे मुनेस्तदा॥ १०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7004019105, "chapter_id": 24019, "verse_number": "३-२-३०-१०६", "content_sanskrit": "राम उवाच ।\nसर्वत्र कुशलं मेऽद्य प्रसादाद्भवतः सदा ।\nपप्रच्छ कुशलं रामो वसिष्ठं मुनिपुंगवम्॥ १०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7004019106, "chapter_id": 24019, "verse_number": "३-२-३०-१०७", "content_sanskrit": "सर्वतः कुशली त्वं हि भार्यापुत्रसमन्वितः ।\nस सर्वं कथयामास यथा तीर्थान्यशेषतः॥ १०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7004019107, "chapter_id": 24019, "verse_number": "३-२-३०-१०८", "content_sanskrit": "सेवितानि धरापृष्ठे क्षेत्राण्यायतनानि च ।\nरामाय कथयामास सर्वत्र कुशलं तदा॥ १०८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7004019108, "chapter_id": 24019, "verse_number": "३-२-३०-१०९", "content_sanskrit": "ततः स विस्मयाविष्टो रामो राजीवलोचनः ।\nपप्रच्छ तीर्थमाहात्म्यं यत्तीर्थेषूत्तमोत्तमम्॥ १०९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}]