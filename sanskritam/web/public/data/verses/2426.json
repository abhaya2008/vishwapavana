[{"id": 2067814, "chapter_id": 2426, "verse_number": "९-४४-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2067815, "chapter_id": 2426, "verse_number": "९-४४-१", "content_sanskrit": "स शप्ता तेन क्रुद्धेन विश्वामित्रेण धीमता।\nतस्मिंस्तीर्थवरे शुभ्रं शोणितं समुपावहत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2067816, "chapter_id": 2426, "verse_number": "९-४४-२", "content_sanskrit": "अथाजग्मुस्ततो राजन्राक्षसास्तत्र भारत।\nतत्र ते शोणितं सर्वे पिबन्तः सुखमासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2067817, "chapter_id": 2426, "verse_number": "९-४४-३", "content_sanskrit": "तृप्ताश्च सुभृशं तेन सुखिता विगतज्वराः।\nनृत्यन्तश्च हसन्तश्च यथा स्वर्गजितस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2067818, "chapter_id": 2426, "verse_number": "९-४४-४", "content_sanskrit": "कस्यचित्त्वथ कालस्य ऋषयः सुतपोधनाः।\nतीर्थयात्रां समाजग्मुः सरस्वत्यां महीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2067819, "chapter_id": 2426, "verse_number": "९-४४-५", "content_sanskrit": "तेषु सर्वेषु तीर्थेषु स्वाप्लुत्य मुनिपुङ्गवाः।\nप्राप्य प्रीतिं परां चापि तपोलुप्धा विशारदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2067820, "chapter_id": 2426, "verse_number": "९-४४-६", "content_sanskrit": "प्रययुर्हि ततो राजन्येन तीर्थमसृग्वहम्।\nअथागम्य महाभागास्तत्तीर्थं दारुणं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2067821, "chapter_id": 2426, "verse_number": "९-४४-७", "content_sanskrit": "दृष्ट्वा तोयं सरस्वत्याः शोणितेन परिप्लुतम्।\nपीयमानं च रक्षोभिर्बहुभिर्नृपसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2067822, "chapter_id": 2426, "verse_number": "९-४४-८", "content_sanskrit": "तान्दृष्ट्वा राक्षसान्राजन्मुनयः संशितव्रताः।\nपरित्राणे सरस्वत्याः परं यत्नं प्रचक्रिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2067823, "chapter_id": 2426, "verse_number": "९-४४-९", "content_sanskrit": "ते तु सर्वे महाभागाः समागम्य महाव्रताः।\nआहूय सरितां श्रेष्ठामिदं वचनमब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2067824, "chapter_id": 2426, "verse_number": "९-४४-१०", "content_sanskrit": "कारणं ब्रूहि कल्याणि किमर्थं ते हृदो ह्ययम्।\nएवमग्राह्यतां यातः श्रुत्वाऽध्यास्यामहे वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2067825, "chapter_id": 2426, "verse_number": "९-४४-११", "content_sanskrit": "ततः सा सर्वमाचष्ट यथावृत्तं प्रवेपती।\nदुःखितामथ तां दृष्ट्वा ऊचुस्ते वै तपोधनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2067826, "chapter_id": 2426, "verse_number": "९-४४-१२", "content_sanskrit": "कारणं श्रुतमस्माभिः शापश्चैव श्रुतोऽनघे।\nकरिष्यन्ति तु यत्प्राप्तं सर्व एव तपोधनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2067827, "chapter_id": 2426, "verse_number": "९-४४-१३", "content_sanskrit": "एवमुक्त्वा सरिच्छ्रेष्ठामूचुस्तेऽथ परस्परम्।\nविमोचयामहे सर्वे शापादेतां सरस्वतीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2067828, "chapter_id": 2426, "verse_number": "९-४४-१४", "content_sanskrit": "ते सर्वे ब्राह्मणा राजंस्तपोभिर्नियमैस्तथा।\nउपवासैश्च विविधैर्यमैः कष्टव्रतैस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2067829, "chapter_id": 2426, "verse_number": "९-४४-१५", "content_sanskrit": "आराध्य पशुभर्तारं महादेवं जगत्पतिम्।\nमोक्षयामासुस्तां देवीं सरिच्छ्रेष्ठां सरस्वतीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2067830, "chapter_id": 2426, "verse_number": "९-४४-१६", "content_sanskrit": "तेषां तु सा प्रभावेण प्रकृतिस्था सरस्वती।\nप्रसन्नसलिला जज्ञे यथा पूर्वं तथैव हि।\nनिर्मुक्ता च सरिच्छ्रेष्ठा विबभौ सा यथा पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2067831, "chapter_id": 2426, "verse_number": "९-४४-१७", "content_sanskrit": "दृष्ट्वा तोयं सरस्वत्या मुनिभिस्तैस्तथा कृतम्।\nतानेव शरणं जग्मू राक्षसाः क्षुधितास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2067832, "chapter_id": 2426, "verse_number": "९-४४-१८", "content_sanskrit": "कृत्वाञ्जलिं ततो राजन्राक्षसाः क्षुधयाऽर्दिताः।\nऊचुस्तान्वै मुनीन्सर्वान्कृपायुक्तान्पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2067833, "chapter_id": 2426, "verse_number": "९-४४-१९", "content_sanskrit": "वयं च क्षुधिताश्चैव धर्माद्धीनाश्च शाश्वतात्।\nन च नः कामकारोऽयं यद्वयं पापकारिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2067834, "chapter_id": 2426, "verse_number": "९-४४-२०", "content_sanskrit": "युष्माकं चाप्रसादेन दुष्कृतेन च कर्मणा।\nपक्षोऽयं वर्धतेऽस्माकं यतः स्मो ब्रह्मराक्षसाः।\nयोषितां चैव पापेन योनिदोषकृतेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2067835, "chapter_id": 2426, "verse_number": "९-४४-२१", "content_sanskrit": "एवं हि वैश्यशूद्राणां क्षत्रियाणां तथैव च।\nये ब्राह्मणान्प्रद्विषन्ति ते भवन्तीह राक्षसाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2067836, "chapter_id": 2426, "verse_number": "९-४४-२२", "content_sanskrit": "`शक्तिमन्तोऽपि ये केचिदाश्रितानां च रक्षणम्।\nन कुर्वन्ति मनुष्यास्ते सम्भवन्तीह राक्षसाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2067837, "chapter_id": 2426, "verse_number": "९-४४-२३", "content_sanskrit": "आचार्यमृत्विजं चैव गुरुं वृद्वजनं तथा।\nप्रणिनो येऽवमन्यन्ते ते भवन्तीह राक्षसाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2067838, "chapter_id": 2426, "verse_number": "९-४४-२४", "content_sanskrit": "तत्कुरुध्वमिहास्माकं तारणं द्विजसत्तमाः।\nशक्ता भवन्तः सर्वेषां लोकानामपि तारणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2067839, "chapter_id": 2426, "verse_number": "९-४४-२५", "content_sanskrit": "तेषां तु वचनं श्रुत्वा तुष्टुवुस्तां महानदीम्।\nमोक्षार्थं रक्षसां तेषामूचुः प्रयतमानसाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2067840, "chapter_id": 2426, "verse_number": "९-४४-२६x", "content_sanskrit": "ऋषय ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2067841, "chapter_id": 2426, "verse_number": "९-४४-२६", "content_sanskrit": "क्षुतं कीटावपन्नं च यच्चोच्छिष्टाचितं भवेत्।\nसकेशमवधूतं च रुदितोपहतं च यत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2067842, "chapter_id": 2426, "verse_number": "९-४४-२७", "content_sanskrit": "श्वभिः संसृष्टमन्नं च भागोऽसौ रक्षसामिह।\nतस्माज्ज्ञात्वा सदा विद्वानेतान्यत्नाद्विवर्जयेत्।\nराक्षसान्नमसौ भुङ्क्ते यो भुङ्क्ते ह्यन्नमीदृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2067843, "chapter_id": 2426, "verse_number": "९-४४-२८", "content_sanskrit": "शोधयित्वा ततस्तीर्थमृषयस्ते तपोधनाः।\nमोक्षार्थं राक्षसानां च नदीं तां प्रत्यचोदयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2067844, "chapter_id": 2426, "verse_number": "९-४४-२९", "content_sanskrit": "महर्षीणां मतं ज्ञात्वा ततः सा सरितां वरा।\nअरुणामानयामास स्वां तनुं पुरुषर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2067845, "chapter_id": 2426, "verse_number": "९-४४-३०", "content_sanskrit": "तस्यान्तेराक्षसाः स्नात्वा तनूस्त्यक्त्वा दिवं गताः।\nअरुणायां महाराज ब्रह्मवध्यापहा हि सा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2067846, "chapter_id": 2426, "verse_number": "९-४४-३१", "content_sanskrit": "एतमर्थमभिज्ञाय देवराजः शतक्रतुः।\nतस्मिंस्तीर्थे वरे स्नात्वा विमुक्तः पाप्मना किल॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2067847, "chapter_id": 2426, "verse_number": "९-४४-३२x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2067848, "chapter_id": 2426, "verse_number": "९-४४-३२", "content_sanskrit": "किमर्थं भगवाञ्शक्रो ब्रह्मवध्यामवाप्तवान्।\nकथमस्मिंश्च तीर्थे वै आप्लुत्याकल्मषोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2067849, "chapter_id": 2426, "verse_number": "९-४४-३३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2067850, "chapter_id": 2426, "verse_number": "९-४४-३३", "content_sanskrit": "शृणुष्वैतदुपाख्यानं यथावृत्तं जनेश्वर।\nयथा बिभेद समयं नमुचेर्वासवः पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2067851, "chapter_id": 2426, "verse_number": "९-४४-३४", "content_sanskrit": "जमुचिर्वासवाद्भीतः सूर्यरश्मिं समाविशत्।\nतेनेन्द्रः सख्यमकरोत्समयं चेदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2067852, "chapter_id": 2426, "verse_number": "९-४४-३५", "content_sanskrit": "न चार्द्रेण न शुष्केण न रात्रौ नापि चाहनि।\nवधिष्याम्यसुरश्रेष्ठ सखे सत्येन ते शपे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2067853, "chapter_id": 2426, "verse_number": "९-४४-३६", "content_sanskrit": "एवं स कृत्वा समयं दृष्ट्वा नीहास्मीश्वरः।\nचिच्छेदास्य शिरो राजन्नपां फेनेन वासवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2067854, "chapter_id": 2426, "verse_number": "९-४४-३७", "content_sanskrit": "तच्छिरो नमुचेश्छिन्नं पृष्ठतः शक्रमन्वियात्।\nभोभो मित्रह पापेति ब्रुवाणं शक्रमन्तिकात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2067855, "chapter_id": 2426, "verse_number": "९-४४-३८", "content_sanskrit": "एवं स शिरसा तेन चोद्यमानः पुनः पुनः।\nपितामहाय सन्तप्त एतमर्थं न्यवेदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2067856, "chapter_id": 2426, "verse_number": "९-४४-३९", "content_sanskrit": "तमब्रवील्लोकगुरुररुणायां यथाविधि।\nइष्ट्वोपस्पृश देवेन्द्र तीर्थे पापभयापहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2067857, "chapter_id": 2426, "verse_number": "९-४४-४०", "content_sanskrit": "[एषा पुण्यजला शक्र कृता मुनिभिरेव तु।\nनिगूढमस्यागमनमिहासीत्पूर्वमेव तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2067858, "chapter_id": 2426, "verse_number": "९-४४-४१", "content_sanskrit": "ततोऽभ्येत्यारुणां देवीं प्लावयामास वारिणा।\nसरस्वत्यारुणायाश्च पुण्योऽयं सङ्गमो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2067859, "chapter_id": 2426, "verse_number": "९-४४-४२", "content_sanskrit": "इह त्वं यज देवेन्द्र दद दानान्यनेकशः।\nअत्राप्लुत्य सुघोरात्त्वं पातकाद्विप्रमोक्ष्यसे॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2067860, "chapter_id": 2426, "verse_number": "९-४४-४३", "content_sanskrit": "इत्युक्तः स सरस्वत्याः कुञ्जे वै जनमेजय।\nइष्ट्वा यथावद्बलभिदरुणायामुपास्पृशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2067861, "chapter_id": 2426, "verse_number": "९-४४-४४", "content_sanskrit": "स मुक्तः पाप्मना तेन ब्रह्मवध्याकृतेन च।\nजगाम संहृष्टमनास्त्रिदिवं त्रिदशेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2067862, "chapter_id": 2426, "verse_number": "९-४४-४५", "content_sanskrit": "शिरस्तच्चापि नमुचेस्तत्रैवाप्लुत्य भारत।\nलोकान्कामदुधात्प्राप्तमक्षयान्राजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2067863, "chapter_id": 2426, "verse_number": "९-४४-४६x", "content_sanskrit": "वैशपायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2067864, "chapter_id": 2426, "verse_number": "९-४४-४६", "content_sanskrit": "तत्राप्युपस्पृश्य बलो महात्मा\nदत्त्वा च दानानि पृथग्विधानि।\nअवाप्य धर्मं परमार्यकर्मा\nजगाम सोमस्य महत्सुतीर्थम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2067865, "chapter_id": 2426, "verse_number": "९-४४-४७", "content_sanskrit": "यत्रायजद्राजसूयेन सोमः\nसाक्षात्पुरा विधिवत्पार्थिवेन्द्र।\nअत्रिर्धीमान्ब्रह्मपुत्रो बभूव\nहोता यस्मिन्क्रतुमुख्ये महात्मा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2067866, "chapter_id": 2426, "verse_number": "९-४४-४८", "content_sanskrit": "यस्यान्तेऽभूत्सुमहद्दानवानां\nदैतेयानां राक्षसानां च देवैः।\nसङ्ग्रामो वै तारकाख्यः सुतीव्रो\nयत्र स्कन्दस्तारकाख्यं जघान॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2067867, "chapter_id": 2426, "verse_number": "९-४४-४९", "content_sanskrit": "सैनापत्यं लब्धवान्दैवतानां\nमहासेनो यत्र दैत्यान्तकर्ता।\nसाक्षाच्चैवं न्यवसत्कार्तिकेयः\nसदा कुमारो यत्र स प्लुक्षराजः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2067868, "chapter_id": 2426, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि ह्रदप्रवेशपर्वणि चतुश्चत्वारिंशोऽध्यायः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]