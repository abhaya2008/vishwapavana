[{"id": 7001446000, "chapter_id": 21446, "verse_number": "७-१-१९-१", "content_sanskrit": "ऋषय ऊचुः ।\nकथं दक्षस्य धर्मार्थं प्रवृत्तस्य दुरात्मनः ।\nमहेशः कृतवान् विघ्नमेतदिच्छाम वेदितुम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001446001, "chapter_id": 21446, "verse_number": "७-१-१९-२", "content_sanskrit": "वायुरुवाच ।\nविश्वस्य जगतो मातुरपि देव्यास्तपोबलात् ।\nपितृभावमुपागम्य मुदिते हिमवद्गिरौ॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001446002, "chapter_id": 21446, "verse_number": "७-१-१९-३", "content_sanskrit": "देवे ऽपि तत्कृतोद्वाहे हिमवच्छिखरालये ।\nसंकीडति तया सार्धं काले बहुतरे गते॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001446003, "chapter_id": 21446, "verse_number": "७-१-१९-४", "content_sanskrit": "वैवस्वते ऽंतरे प्राप्ते दक्षः प्राचेतसः स्वयम् ।\nअश्वमेधेन यज्ञेन यक्ष्यमाणो ऽन्वपद्यत॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001446004, "chapter_id": 21446, "verse_number": "७-१-१९-५", "content_sanskrit": "ततो हिमवतः पृष्ठे दक्षो वै यज्ञमाहरत् ।\nगंगाद्वारे शुभे देशे ऋषिसिद्धनिषेविते॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001446005, "chapter_id": 21446, "verse_number": "७-१-१९-६", "content_sanskrit": "तस्य तस्मिन्मखेदेवाः सर्वे शक्र पुरोगमाः ।\nगमनाय समागम्य बुद्धिमापेदिरे तदा॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001446006, "chapter_id": 21446, "verse_number": "७-१-१९-७", "content_sanskrit": "आदित्या वसवो रुद्रास्साध्यास्सह मरुद्गणैः ।\nऊष्मपाः सोमपाश्चैव आज्यपा धूमपास्तथा॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001446007, "chapter_id": 21446, "verse_number": "७-१-१९-८", "content_sanskrit": "अश्विनौ पितरश्चैव तथा चान्ये महर्षयः ।\nविष्णुना सहिताः सर्वे स्वागता यज्ञभागिनः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001446008, "chapter_id": 21446, "verse_number": "७-१-१९-९", "content_sanskrit": "दृष्ट्वा देवकुलं सर्वमीश्वरेण विनागतम् ।\nदधीचो मन्युनाविष्टो दक्षमेवमभाषत॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001446009, "chapter_id": 21446, "verse_number": "७-१-१९-१०", "content_sanskrit": "दधीच उवाच ।\nअप्रपूज्ये चैव पूजा पूज्यानां चाप्य पूजने ।\nनरः पापमवाप्नोति महद्वै नात्र संशयः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001446010, "chapter_id": 21446, "verse_number": "७-१-१९-११", "content_sanskrit": "असतां संमतिर्यत्र सतामवमतिस्तथा ।\nदंडो देवकृतस्तत्र सद्यः पतति दारुणः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001446011, "chapter_id": 21446, "verse_number": "७-१-१९-१२", "content_sanskrit": "एवमुक्त्वा तु विप्रर्षिः पुनर्दक्षमभाषत ।\nपूज्यं तु पशुभर्तारं कस्मान्नार्चयसे प्रभुम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001446012, "chapter_id": 21446, "verse_number": "७-१-१९-१३", "content_sanskrit": "दक्ष उवाच ।\nसंति मे बहवो रुद्राः शूलहस्ताः कपर्दिनः ।\nएकादशावस्थिता ये नान्यं वेद्मि महेश्वरम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001446013, "chapter_id": 21446, "verse_number": "७-१-१९-१४", "content_sanskrit": "दधीच उवाच ।\nकिमेभिरमरैरन्यैः पूजितैरध्वरे फलम् ।\nराजा चेदध्वरस्यास्य न रुद्रः पूज्यते त्वया॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001446014, "chapter_id": 21446, "verse_number": "७-१-१९-१५", "content_sanskrit": "ब्रह्मविष्णुमहेशानां स्रष्टा यः प्रभुरव्ययः ।\nब्रह्मादयः पिशाचांता यस्य कैंकर्यवादिनः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001446015, "chapter_id": 21446, "verse_number": "७-१-१९-१६", "content_sanskrit": "प्रकृतीनां परश्चैव पुरुषस्य च यः परः ।\nचिंत्यते योगविद्वद्भि ऋषिभिस्तत्त्वदर्शिभिः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001446016, "chapter_id": 21446, "verse_number": "७-१-१९-१७", "content_sanskrit": "अक्षरं परमं ब्रह्म ह्यसच्च सदसच्च यत् ।\nअनादिमध्यनिधनमप्रतर्क्यं सनातनम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001446017, "chapter_id": 21446, "verse_number": "७-१-१९-१८", "content_sanskrit": "यः स्रष्टा चैव संहर्ता भर्ता चैव महेश्वरः ।\nतस्मादन्यं न पश्यामि शंकरात्मानमध्वरे॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001446018, "chapter_id": 21446, "verse_number": "७-१-१९-१९", "content_sanskrit": "दक्ष उवाच ।\nएतन्मखेशस्य सुवर्णपात्रे हविः समस्तं विधिमंत्रपूतम् ।\nविष्णोर्नयाम्यप्रतिमस्य भागं प्रभोर्विभज्यावहनीयमद्य॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001446019, "chapter_id": 21446, "verse_number": "७-१-१९-२०", "content_sanskrit": "दधीच उवाच ।\nयस्मान्नाराधितो रुद्रस्सर्वदेवेश्वरेश्वरः ।\nतस्माद्दक्ष तवाशेषो यज्ञो ऽयं न भविष्यति॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001446020, "chapter_id": 21446, "verse_number": "७-१-१९-२१", "content_sanskrit": "इत्युक्त्वा वचनं क्रुद्धो दधीचो मुनिसत्तमः ।\nनिर्गम्य च ततो देशाज्जगाम स्वकमाश्रमम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001446021, "chapter_id": 21446, "verse_number": "७-१-१९-२२", "content_sanskrit": "निर्गते ऽपि मुनौ तस्मिन्देवा दक्षं न तत्यजुः ।\nअवश्यमनुभावित्वादनर्थस्य तु भाविनः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001446022, "chapter_id": 21446, "verse_number": "७-१-१९-२३", "content_sanskrit": "एतस्मिन्नेव काले तु ज्ञात्वैतत्सर्वमीश्वरात् ।\nदग्धुं दक्षाध्वरं विप्रा देवी देवमचोदयत्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001446023, "chapter_id": 21446, "verse_number": "७-१-१९-२४", "content_sanskrit": "देव्या संचोदितो देवो दक्षाध्वरजिघांसया ।\nससर्ज सहसा वीरं वीरभद्रं गणेश्वरम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001446024, "chapter_id": 21446, "verse_number": "७-१-१९-२५", "content_sanskrit": "सहस्रवदनं देवं सहस्रकमलेक्षणम् ।\nसहस्रमुद्गरधरं सहस्रशरपाणिकम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001446025, "chapter_id": 21446, "verse_number": "७-१-१९-२६", "content_sanskrit": "शूलटंकगदाहस्तं दीप्तकार्मुकधारिणम् ।\nचक्रवज्रधरं घोरं चंद्रार्धकृतशेखरम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001446026, "chapter_id": 21446, "verse_number": "७-१-१९-२७", "content_sanskrit": "कुलिशोद्योतितकरं तडिज्ज्वलितमूर्धजम् ।\nदंष्ट्राकरालं बिभ्राणं महावक्त्रं महोदरम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001446027, "chapter_id": 21446, "verse_number": "७-१-१९-२८", "content_sanskrit": "विद्युज्जिह्वं प्रलंबोष्ठं मेघसागरनिःस्वनम् ।\nवसानं चर्म वैयाघ्रं महद्रुधिरनिस्रवम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001446028, "chapter_id": 21446, "verse_number": "७-१-१९-२९", "content_sanskrit": "गण्डद्वितयसंसृष्टमण्डलीकृतकुण्डलम् ।\nवरामरशिरोमालावलीकलितशेखरम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001446029, "chapter_id": 21446, "verse_number": "७-१-१९-३०", "content_sanskrit": "रणन्नूपुरकेयूरमहाकनकभूषितम् ।\nरत्नसंचयसंदीप्तं तारहारावृतोरसम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001446030, "chapter_id": 21446, "verse_number": "७-१-१९-३१", "content_sanskrit": "महाशरभशार्दूलसिंहैः सदृशविक्रमम् ।\nप्रशस्तमत्तमातंगसमानगमनालसम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001446031, "chapter_id": 21446, "verse_number": "७-१-१९-३२", "content_sanskrit": "शंखचामरकुंदेन्दुमृणालसदृशप्रभम् ।\nसतुषारमिवाद्रीन्द्रं साक्षाज्जंगमतां गतम्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001446032, "chapter_id": 21446, "verse_number": "७-१-१९-३३", "content_sanskrit": "ज्वालामालापरिक्षिप्तं दीप्तमौक्तिकभूषणम् ।\nतेजसा चैव दीव्यंतं युगांत इव पावकम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001446033, "chapter_id": 21446, "verse_number": "७-१-१९-३४", "content_sanskrit": "स जानुभ्यां महीं गत्वा प्रणतः प्रांजलिस्ततः ।\nपार्श्वतो देवदेवस्य पर्यतिष्ठद्गणेश्वरः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001446034, "chapter_id": 21446, "verse_number": "७-१-१९-३५", "content_sanskrit": "मन्युना चासृजद्भद्रां भद्रकालीं महेश्वरीम् ।\nआत्मनः कर्मसाक्षित्वे तेन गंतुं सहैव तु॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001446035, "chapter_id": 21446, "verse_number": "७-१-१९-३६", "content_sanskrit": "तं दृष्ट्वावस्थितं वीरभद्रं कालाग्निसन्निभम् ।\nभद्रया सहितं प्राह भद्रमस्त्विति शंकरः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001446036, "chapter_id": 21446, "verse_number": "७-१-१९-३७", "content_sanskrit": "स च विज्ञापयामास सह देव्या महेश्वरम् ।\nआज्ञापय महादेव किं कार्यं करवाण्यहम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001446037, "chapter_id": 21446, "verse_number": "७-१-१९-३८", "content_sanskrit": "ततस्त्रिपुरहा प्राह हैमवत्याः प्रियेच्छया ।\nवीरभद्रं महाबाहुं वाचा विपुलनादया॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001446038, "chapter_id": 21446, "verse_number": "७-१-१९-३९", "content_sanskrit": "देवदेव उवाच ।\nप्राचेतसस्य दक्षस्य यज्ञं सद्यो विनाशय ।\nभद्रकाल्या सहासि त्वमेतत्कृत्यं गणेश्वर॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001446039, "chapter_id": 21446, "verse_number": "७-१-१९-४०", "content_sanskrit": "अहमप्यनया सार्धं रैभ्याश्रमसपीपतः ।\nस्थित्वा वीक्षे गणेशान विक्रमं तव दुःसहम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001446040, "chapter_id": 21446, "verse_number": "७-१-१९-४१", "content_sanskrit": "वृक्षा कनखले ये तु गंगाद्वारसमीपगाः ।\nसुवर्णशृंगस्य गिरेर्मेरुमंदरसंनिभाः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001446041, "chapter_id": 21446, "verse_number": "७-१-१९-४२", "content_sanskrit": "तस्मिन्प्रदेशे दक्षस्य युज्ञः संप्रति वर्तते ।\nसहसा तस्य यज्ञस्य विघातं कुरु मा चिरम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001446042, "chapter_id": 21446, "verse_number": "७-१-१९-४३", "content_sanskrit": "इत्युक्ते सति देवेन देवी हिमगिरीन्द्रजा ।\nभद्रं भद्रं च संप्रेक्ष्य वत्सं धेनुरिवौरसम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001446043, "chapter_id": 21446, "verse_number": "७-१-१९-४४", "content_sanskrit": "आलिंग्य च समाघ्राय मूर्ध्नि षड्वदनं यथा ।\nसस्मिता वचनं प्राह मधुरं मधुरं स्वयम्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001446044, "chapter_id": 21446, "verse_number": "७-१-१९-४५", "content_sanskrit": "देव्युवाच ।\nवत्स भद्र महाभाग महाबलपराक्रम ।\nमत्प्रियार्थं त्वमुत्पन्नो मम मन्युं प्रमार्जक॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001446045, "chapter_id": 21446, "verse_number": "७-१-१९-४६", "content_sanskrit": "यज्ञेश्वरमनाहूय यज्ञकर्मरतो ऽभवत् ।\nदक्षं वैरेण तं तस्माद्भिंधि यज्ञं गणेश्वर॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001446046, "chapter_id": 21446, "verse_number": "७-१-१९-४७", "content_sanskrit": "यज्ञलक्ष्मीमलक्ष्मीं त्वं भद्र कृत्वा ममाज्ञया ।\nयजमानं च तं हत्वा वत्स हिंसय भद्रया॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001446047, "chapter_id": 21446, "verse_number": "७-१-१९-४८", "content_sanskrit": "अशेषामिव तामाज्ञां शिवयोश्चित्रकृत्ययोः ।\nमूर्ध्नि कृत्वा नमस्कृत्य भद्रो गंतुं प्रचक्रमे॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001446048, "chapter_id": 21446, "verse_number": "७-१-१९-४९", "content_sanskrit": "अथैष भगवान्क्रुद्धः प्रेतावासकृतालयः ।\nवीरभद्रो महादेवो देव्या मन्युप्रमार्जकः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001446049, "chapter_id": 21446, "verse_number": "७-१-१९-५०", "content_sanskrit": "ससर्ज रोमकूपेभ्यो रोमजाख्यान्गणेश्वरान् ।\nदक्षिणाद्भुजदेशात्तु शतकोटिगविश्वरान्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001446050, "chapter_id": 21446, "verse_number": "७-१-१९-५१", "content_sanskrit": "पादात्तथोरुदेशाच्च पृष्ठात्पार्श्वान्मुखाद्गलात् ।\nगुह्याद्गुल्फाच्छिरोमध्यात्कंठादास्यात्तथोदरात्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001446051, "chapter_id": 21446, "verse_number": "७-१-१९-५२", "content_sanskrit": "तदा गणेश्वरैर्भद्रैर्भद्रतुल्यपराक्रमैः ।\nसंछादितमभूत्सर्वं साकाशविवरं जगत्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001446052, "chapter_id": 21446, "verse_number": "७-१-१९-५३", "content_sanskrit": "सर्वे सहस्रहस्तास्ते सहस्रायुधपाणयः ।\nरुद्रस्यानुचरास्सर्वे सर्वे रुद्रसमप्रभाः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001446053, "chapter_id": 21446, "verse_number": "७-१-१९-५४", "content_sanskrit": "शूलशक्तिगदाहस्ताष्टंकोपलशिलाधराः ।\nकालाग्निरुद्रसदृशास्त्रिनेत्राश्च जटाधराः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001446054, "chapter_id": 21446, "verse_number": "७-१-१९-५५", "content_sanskrit": "निपेतुर्भृशमाकाशे शतशस्सिंहवाहनाः ।\nविनेदुश्च महानादाञ्जलदा इव भद्रजाः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001446055, "chapter_id": 21446, "verse_number": "७-१-१९-५६", "content_sanskrit": "तैर्भद्रैर्भगवान्मद्रस्तथा परिवृतो बभौ ।\nकालानलशतैर्युक्तो यथांते कालभैरवः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001446056, "chapter_id": 21446, "verse_number": "७-१-१९-५७", "content_sanskrit": "तेषां मध्ये समारुह्य वृषेंद्रं वृषभध्वजः ।\nजगाम भगवान्भद्रश्शुभमभ्रं यथा भवः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001446057, "chapter_id": 21446, "verse_number": "७-१-१९-५८", "content_sanskrit": "तस्मिन्वृषभमारूढे भद्रे तु भसितप्रभः ।\nबभार मौक्तिकं छत्रं गृहीतसितचामरः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001446058, "chapter_id": 21446, "verse_number": "७-१-१९-५९", "content_sanskrit": "स तदा शुशुभे पार्श्वे भद्रस्य भसितप्रभः ।\nभगवानिव शैलेन्द्रः पार्श्वे विश्वजगद्गुरोः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001446059, "chapter_id": 21446, "verse_number": "७-१-१९-६०", "content_sanskrit": "सो ऽपि तेन बभौ भद्रः श्वेतचामरपाणिना ।\nबालसोमेन सौम्येन यथा शूलवरायुधः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001446060, "chapter_id": 21446, "verse_number": "७-१-१९-६१", "content_sanskrit": "दध्मौ शंखं सितं भद्रं भद्रस्य पुरतः शुभम् ।\nभानुकंपो महातेजा हेमरत्नैरलंकृतः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001446061, "chapter_id": 21446, "verse_number": "७-१-१९-६२", "content_sanskrit": "देवदुंदुभयो नेदुर्दिव्यसंकुलनिःस्वनाः ।\nववृषुश्शतशो मूर्ध्नि पुष्पवर्षं बलाहकाः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001446062, "chapter_id": 21446, "verse_number": "७-१-१९-६३", "content_sanskrit": "फुल्लानां मधुगर्भाणां पुष्पाणां गंधबंधवः ।\nमार्गानुकूलसंवाहा वबुश्च पथि मारुताः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001446063, "chapter_id": 21446, "verse_number": "७-१-१९-६४", "content_sanskrit": "ततो गणेश्वराः सर्वे मत्ता युद्धबलोद्धताः ।\nननृतुर्मुमुदुर्१ एदुर्जहसुर्जगदुर्जगुः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001446064, "chapter_id": 21446, "verse_number": "७-१-१९-६५", "content_sanskrit": "तदा भद्रगणांतःस्थो बभौ भद्रः स भद्रया ।\nयथा रुद्रगणांतः स्थस्त्र्यम्बकोंबिकया सह॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001446065, "chapter_id": 21446, "verse_number": "७-१-१९-६६", "content_sanskrit": "तत्क्षणादेव दक्षस्य यज्ञवाटं रण्मयम् ।\nप्रविवेश महाबाहुर्वीरभद्रो महानुगः॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001446066, "chapter_id": 21446, "verse_number": "७-१-१९-६७", "content_sanskrit": "ततस्तु दक्षप्रतिपादितस्य क्रतुप्रधानस्य गणप्रधानः ।\nप्रयोगभूमिं प्रविवेश भद्रो रुद्रो यथांते भुवनं दिधक्षुः॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}]