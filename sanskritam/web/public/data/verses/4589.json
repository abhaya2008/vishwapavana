[{"id": 2167046, "chapter_id": 4589, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2167047, "chapter_id": 4589, "verse_number": "१", "content_sanskrit": "श्रिया कुलेन यशसा तपसा च श्रुतेन च ।\nत्वामद्य सन्तो मन्यन्ते ययातिमिव नाहुषम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2167048, "chapter_id": 4589, "verse_number": "२", "content_sanskrit": "श्रुते महर्षिप्रतिमः कृतकृत्योऽसि पार्थिव ।\nपर्यवस्थापयात्मानं मा विषादे मनः कृथाः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2167049, "chapter_id": 4589, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2167050, "chapter_id": 4589, "verse_number": "३", "content_sanskrit": "दैवमेव परं मन्ये पौरुषं तु निरर्थकम् ।\nयत्र सालप्रतीकाशः कर्णोऽवध्यत संयुगे\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2167051, "chapter_id": 4589, "verse_number": "४", "content_sanskrit": "हत्वा यौधिष्ठिरं सैन्यं पाञ्चालांश्च महारथान् ।\nप्रताप्य शरवर्षेण दिशः सर्वा महारथः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2167052, "chapter_id": 4589, "verse_number": "५", "content_sanskrit": "मोहयित्वा रणे पार्थान् वज्रहस्त इवासुरान् ।\nकथं स निहतः शेते वातनुन्न इव द्रुमः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2167053, "chapter_id": 4589, "verse_number": "६", "content_sanskrit": "शोकस्यान्तं न पश्यामि पारं जलनिधेरिव ।\nचिन्ता मे वर्धते तीव्रा मुमूर्षा चोपजायते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2167054, "chapter_id": 4589, "verse_number": "७", "content_sanskrit": "कर्णस्य निधनं श्रुत्वा विजयं फल्गुनस्य च ।\nअश्रद्धेयमिदं मन्ये वधं कर्णस्य सञ्जय\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2167055, "chapter_id": 4589, "verse_number": "८", "content_sanskrit": "वज्रसारमयं नूनं हृदयं मम दुर्भिदम् ।\nयच्छ्रुत्वा पुरुषव्याघ्रं हतं कर्णं न दीर्यते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2167056, "chapter_id": 4589, "verse_number": "९", "content_sanskrit": "आयुर्नूनं सुदीर्घं मे विहितं दैवतैः पुरा ।\nयत्र कर्णं हतं श्रुत्वा जीवामीह सुदुःखितः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2167057, "chapter_id": 4589, "verse_number": "१०", "content_sanskrit": "धिग् जीवितमिदं चैव सुहृद्धीनस्य सञ्जय ।\nअद्य चाहं दशामेतां गतः सञ्जय कुत्सिताम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2167058, "chapter_id": 4589, "verse_number": "११", "content_sanskrit": "कृपणं वर्तयिष्यामि शोच्यः सर्वस्य मन्दधीः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2167059, "chapter_id": 4589, "verse_number": "१२", "content_sanskrit": "अहमेव पुरा भूत्वा सर्वलोकस्य सत्कृतः ।\nपरिभूतः पुनः सूत कथं शक्ष्यामि जीवितुम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2167060, "chapter_id": 4589, "verse_number": "१३", "content_sanskrit": "दुःखाद् दुःखतरं मन्ये प्राप्तवानस्मि सञ्जय ।\nभीष्मद्रोणवधेनैव कर्णस्य च महात्मनः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2167061, "chapter_id": 4589, "verse_number": "१४", "content_sanskrit": "नात्र शेषं प्रपश्यामि सूतपुत्रे हते युधि ।\nस हि पारो महानासीत् पुत्राणां मम सञ्जय\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2167062, "chapter_id": 4589, "verse_number": "१५", "content_sanskrit": "युद्धे विनिहतः शूरो विसृजन् सायकान् बहून् ।\nको नु मे जीवितेनार्थस्तमृते पुरुषर्षभम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2167063, "chapter_id": 4589, "verse_number": "१६", "content_sanskrit": "रथादाधिरथिर्नूनमपतत् सायकार्दितः ।\nपर्वतस्येव शिखरं वज्रपाताद् विदारितम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2167064, "chapter_id": 4589, "verse_number": "१७", "content_sanskrit": "स शेते पृथिवीं नूनं शोभयन् रुधिरोक्षितः ।\nमातङ्ग इव मत्तेन मातङ्गेन निपातितः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2167065, "chapter_id": 4589, "verse_number": "१८", "content_sanskrit": "यो बलं धार्तराष्ट्राणां पाण्डवानां यतो भयम् ।\nसोऽर्जुनेन हतः कर्णः प्रतिमानं धनुष्मताम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2167066, "chapter_id": 4589, "verse_number": "१९", "content_sanskrit": "स हि वीरो महेष्वासः पुत्राणामभयङ्करः ।\nशेते विनिहतः शूरः शक्रेणेव पुरा बलः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2167067, "chapter_id": 4589, "verse_number": "२०", "content_sanskrit": "पङ्गोरिवाध्वगमनं दरिद्रस्येव कामिता ।\nदुर्योधनस्य लोभश्च समान्येतानि सञ्जय\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2167068, "chapter_id": 4589, "verse_number": "२१", "content_sanskrit": "अन्यथा चिन्तितं कार्यमन्यथा तच्च जायते ।\nअहो नु बलवद् दैवं कालश्च दुरतिक्रमः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2167069, "chapter_id": 4589, "verse_number": "२२", "content_sanskrit": "पलायमानः कृपणो दीनात्मा दीनपौरुषः ।\nकच्चिन्न निहतः सूत पुत्रो दुःशासनो मम\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2167070, "chapter_id": 4589, "verse_number": "२३", "content_sanskrit": "कच्चिन्न नीचाचरितं कृतवांस्तात संयुगे ।\nपुत्रो दुर्योधनः सङ्खे न हतो मम सञ्जय\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2167071, "chapter_id": 4589, "verse_number": "२४", "content_sanskrit": "कच्चित् ते निहताः शूरा यथा ते क्षत्रिया हताः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2167072, "chapter_id": 4589, "verse_number": "२५", "content_sanskrit": "युधिष्ठिरस्य वचनं मा युद्धमिति सर्वदा ।\nदुर्योधनो नाभ्यगृह्णान्मूढः पथ्यमिवौषधम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2167073, "chapter_id": 4589, "verse_number": "२६", "content_sanskrit": "शरतल्पे शयानेन भीष्मेण सुमहात्मना ।\nपानीयं याचितः पार्थः सोऽविध्यन्मेदिनीतळम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2167074, "chapter_id": 4589, "verse_number": "२७", "content_sanskrit": "जलस्य धारां जनितां दृष्ट्वा तां पाण्डवेन च ।\nअब्रवीत् सुमहाबुद्धिस्तात संशाम्य पाण्डवैः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2167075, "chapter_id": 4589, "verse_number": "२८", "content_sanskrit": "प्रशमाद्धि भवेच्छ्रेयो मदन्तं युद्धमेव च ।\nभ्रातृभावेन पृथिवीं भुङ्क्ष्व पाण्डुसुतैः सह\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2167076, "chapter_id": 4589, "verse_number": "२९", "content_sanskrit": "अकुर्वन् वचनं तस्य नूनं शोचति पुत्रकः ।\nतदिदं समनुप्राप्तं वचनं दीर्घदर्शिनः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2167077, "chapter_id": 4589, "verse_number": "३०", "content_sanskrit": "अहं तु निहतामात्यो हतपुत्रश्च सञ्जय ।\nद्यूतेन कृच्छ्रमापन्नो लूनपक्ष इव द्विजः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2167078, "chapter_id": 4589, "verse_number": "३१", "content_sanskrit": "यथा गृहीत्वा शकुनिं पक्षौ लुप्त्वाऽथ सञ्जय ।\nविसर्जयन्ते संहृष्टाः क्रीडमानाः कुमारकाः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2167079, "chapter_id": 4589, "verse_number": "३२", "content_sanskrit": "लूनपक्षतया तस्य गमनं नोपपद्यते ।\nतथाऽहमपि सम्प्राप्तो लूनपक्ष इव द्विजः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2167080, "chapter_id": 4589, "verse_number": "३३", "content_sanskrit": "क्षीणः सर्वार्थहीनश्च निर्बन्धुर्ज्ञातिसङ्क्षये ।\nकां दिशं प्रतिपत्स्यामि दीनः शोकवशं गतः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2167081, "chapter_id": 4589, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2167082, "chapter_id": 4589, "verse_number": "३४", "content_sanskrit": "इत्येवं धृतराष्ट्रोऽथ विलप्य बहु दुःखितः ।\nप्रोवाच सञ्जयं भूयः शोकव्याकुललोचनः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2167083, "chapter_id": 4589, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2167084, "chapter_id": 4589, "verse_number": "३५", "content_sanskrit": "योऽजयत् सर्वकाम्भोजानम्बष्ठान् केकयैः सह ।\nगान्धारांश्च विदेहांश्च जित्वा कार्यार्थमाहवे\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2167085, "chapter_id": 4589, "verse_number": "३६", "content_sanskrit": "दुर्योधनस्य वृद्ध्यर्थं पृथिवीं योऽजयत् प्रभुः ।\nस जितः पाण्डवैः शूरैः समर्थैर्वीर्यशालिभिः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2167086, "chapter_id": 4589, "verse_number": "३७", "content_sanskrit": "तस्मिन् हते महेष्वासे कर्णे युधि किरीटिना ।\nके वीराः पर्यतिष्ठन्त तन्ममाचक्ष्व सञ्जय\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2167087, "chapter_id": 4589, "verse_number": "३८", "content_sanskrit": "कच्चिन्नैकः परित्यक्तः पाण्डवैर्निहतो रणे ।\nउक्तं त्वया पुरा सूत यथा शूरौ निपातितौ\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2167088, "chapter_id": 4589, "verse_number": "३९", "content_sanskrit": "भीष्ममप्रतियुध्यन्तं शिखण्डी सायकोत्तमैः ।\nपातयामास समरे सर्वशस्त्रभृतां वरम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2167089, "chapter_id": 4589, "verse_number": "", "content_sanskrit": "तथा द्रौपदिना द्रोणो न्यस्तसर्वायुधो युधि ।\n(धर्मराजवचः श्रुत्वा अश्वत्थामा हतस्त्विति\t॥४०॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2167090, "chapter_id": 4589, "verse_number": "४१", "content_sanskrit": "युक्तयोगो महेष्वासः शरैर्बहुभिराचितः ।\nनिहतः खड्गमुद्धृत्य धृष्टद्युम्नेन सञ्जय\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2167091, "chapter_id": 4589, "verse_number": "४२", "content_sanskrit": "अन्तरेण हतावेतौ च्छलेन च विशेषतः ।\nअश्रौषमहमेतद्वै भीष्मद्रोणौ निपातितौ\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2167092, "chapter_id": 4589, "verse_number": "४३", "content_sanskrit": "भीष्मद्रोणौ हि समरे न हन्याद् वज्रभृत् स्वयम् ।\nन्यायेन युध्यन् समरे तद्वै सत्यं ब्रवीमि ते\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2167093, "chapter_id": 4589, "verse_number": "४४", "content_sanskrit": "कर्णं त्वस्यन्तमस्त्राणि दिव्यानि च लघूनि च ।\nकथमिन्द्रोपमं सङ्खे मृत्युर्वीरं समस्पृशत्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2167094, "chapter_id": 4589, "verse_number": "४५", "content_sanskrit": "यस्य विद्युत्प्रभां शक्तिं दिव्यां कनकभूषणाम् ।\nप्रायच्छद् द्विषतां हन्त्रीं कुण्डलाभ्यां पुरन्दरः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2167095, "chapter_id": 4589, "verse_number": "४६", "content_sanskrit": "यस्य सर्पमुखो दिव्यः शरः काञ्चनभूषणः ।\nस शेते निहतः सङ्खे कर्णश्चारिनिषूदनः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2167096, "chapter_id": 4589, "verse_number": "४७", "content_sanskrit": "भीष्मद्रोणमुखान् वीरान् योऽवमत्य महारथान् ।\nजामदग्न्यान्महाघोरं ब्राह्ममस्त्रमशिक्षयत्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2167097, "chapter_id": 4589, "verse_number": "४८", "content_sanskrit": "यश्च द्रोणमुखान् दृष्ट्वा विमुखानर्दितान् शरैः ।\nसौभद्रस्य महाबाहुर्व्यधमत् कार्मुकं शरैः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2167098, "chapter_id": 4589, "verse_number": "४९", "content_sanskrit": "यश्च नागायुतप्राणं वातरंहसमच्युतम् ।\nविरथं सहसा कृत्वा भीमसेनमपाहसत्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2167099, "chapter_id": 4589, "verse_number": "५०", "content_sanskrit": "सहदेवं च निर्जित्य शरैः सन्नतपर्वभिः ।\nकृपया विरथं कृत्वा नावधीद्धर्मवित्तमः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2167100, "chapter_id": 4589, "verse_number": "५१", "content_sanskrit": "यश्च मायासहस्राणि ध्वंसयित्वा घटोत्कचम् ।\nरणोत्कटं राक्षसेन्द्रं शक्रशक्त्या निजघ्निवान्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2167101, "chapter_id": 4589, "verse_number": "५२", "content_sanskrit": "एतांश्च दिवसान् यस्य युद्धे भीतो धनञ्जयः ।\nनागमद् द्वैरथं वीरः स कथं निहतो रणे\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2167102, "chapter_id": 4589, "verse_number": "५३", "content_sanskrit": "रथभङ्गो न चेत् तस्य धनुर्ज्या न व्यशीर्यत ।\nन चेदस्त्राणि नष्टानि कथं स निहतः परैः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2167103, "chapter_id": 4589, "verse_number": "५४", "content_sanskrit": "को हि शक्तो रणे कर्णं विधून्वानं महद्धनुः ।\nविमुञ्चन्तं शरान् घोरान् दिव्यान्यस्त्राणि चाहवे\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2167104, "chapter_id": 4589, "verse_number": "५५", "content_sanskrit": "जेतुं पुरुषशार्दूलं शार्दूलमिव वेगितम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2167105, "chapter_id": 4589, "verse_number": "५६", "content_sanskrit": "ध्रुवमस्य धनुश्छिन्नं रथो वाऽभिगतो महीम् ।\nअस्त्राणि वा प्रणष्टानि यथा शंससि मे हतम्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2167106, "chapter_id": 4589, "verse_number": "५७", "content_sanskrit": "न ह्यन्यदनुपश्यामि कारणं तस्य पातने\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2167107, "chapter_id": 4589, "verse_number": "५८", "content_sanskrit": "न हन्यामर्जुनं यावत् तावत् पादौ न धावये ।\nइति यस्य महाघोरं व्रतमासीत् महात्मनः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2167108, "chapter_id": 4589, "verse_number": "५९", "content_sanskrit": "यस्माद् भीतो वने नित्यं धर्मराजो युधिष्ठिरः ।\nत्रयोदश समा निद्रां न लेभे पुरुषर्षभः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2167109, "chapter_id": 4589, "verse_number": "६०", "content_sanskrit": "यस्य वीर्यवतो वीर्यं समाश्रित्य महात्मनः ।\nमम पुत्रः सभां भार्यां पाण्डूनां नीतवान् बलात्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2167110, "chapter_id": 4589, "verse_number": "६१", "content_sanskrit": "तत्रापि च सभामध्ये पाण्डवानां स्म पश्यताम् ।\nदासभार्येति पाञ्चालीमब्रवीत् कुरुसन्निधौ\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2167111, "chapter_id": 4589, "verse_number": "६२", "content_sanskrit": "यश्च गाण्डीवमुक्तानां स्पर्शमुग्रमचिन्तयन् ।\nअपतिर्ह्यसि कृष्णेति ब्रुवन् पार्थानवैक्षत\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2167112, "chapter_id": 4589, "verse_number": "६३", "content_sanskrit": "यस्य नासीद् भयं पार्थात् सपुत्रात् सजनार्दनात् ।\nस्वबाहुबलमाश्रित्य मुहूर्तमपि सञ्जय\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2167113, "chapter_id": 4589, "verse_number": "६४", "content_sanskrit": "तस्य नाहं वधं मन्ये देवैरपि सवासवैः ।\nप्रतीपमभिधावद्भिः किं पुनस्तात पाण्डवैः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2167114, "chapter_id": 4589, "verse_number": "६५", "content_sanskrit": "न हि ज्यां संस्पृशानस्य तळत्रे चापि गृह्णतः ।\nपुमानाधिरथेः स्थातुं कश्चित् प्रमुखतोऽर्हति\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2167115, "chapter_id": 4589, "verse_number": "६६", "content_sanskrit": "अपि स्यान्मेदिनी हीना सूर्यसोमप्रभांशुभिः ।\nन वधः पुरुषेन्द्रस्य समरेष्वपलायिनः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2167116, "chapter_id": 4589, "verse_number": "६७", "content_sanskrit": "येन मन्दः सहायेन भ्रात्रा दुःशासनेन च ।\nब्रुवतो वासुदेवस्य प्रत्याख्यानमरोचयत्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2167117, "chapter_id": 4589, "verse_number": "६८", "content_sanskrit": "स नूनं वृषभस्कन्धं दृष्ट्वा कर्णं निपातितम् ।\nदुःशासनं च निहतं मन्ये शोचति पुत्रकः\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2167118, "chapter_id": 4589, "verse_number": "६९", "content_sanskrit": "हतं वैकर्तनं दृष्ट्वा द्वैरथे सव्यसाचिना ।\nजयतः पाण्डवांश्चापि किं स्विद् दुर्योधनोऽब्रवीत्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2167119, "chapter_id": 4589, "verse_number": "७०", "content_sanskrit": "दुर्मर्षणं च निहतं जयत्सेनं च संयुगे ।\nप्रभग्नं च बलं दृष्ट्वा वध्यमानं महारथैः\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2167120, "chapter_id": 4589, "verse_number": "७१", "content_sanskrit": "पराङ्मुखांश्च नृपतीन् पलायनपरायणान् ।\nविद्रुतान् रथिनो दृष्ट्वा मन्ये शोचति पुत्रकः\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2167121, "chapter_id": 4589, "verse_number": "७२", "content_sanskrit": "अनयश्चातिमानी च बालबुद्धिरमर्षणः ।\nहतोत्साहं बलं दृष्ट्वा किं स्विद् दुर्योधनोऽब्रवीत्\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2167122, "chapter_id": 4589, "verse_number": "७३", "content_sanskrit": "स्वयं वैरं महत् कृत्वा वार्यमाणः सुहृद्गणैः ।\nप्रधने हतभूयिष्ठे बले किं वाऽब्रवीदसौ\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2167123, "chapter_id": 4589, "verse_number": "७४", "content_sanskrit": "भ्रातरं निहतं दृष्ट्वा भीमसेनेन संयुगे ।\nरुधिरे पीयमाने च किंस्विद् दुर्योधनोऽब्रवीत्\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2167124, "chapter_id": 4589, "verse_number": "७५", "content_sanskrit": "सह गान्धारराजेन सभायां यदभाषत ।\nकर्णोर्ऽजुनं रणे हन्ता हते तस्मिन् किमब्रवीत्\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2167125, "chapter_id": 4589, "verse_number": "७६", "content_sanskrit": "द्यूतं कृत्वा पुरा हृष्टो वञ्चयित्वा च पाण्डवान् ।\nशकुनिः सौबलस्तात हते कर्णे किमब्रवीत्\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2167126, "chapter_id": 4589, "verse_number": "७७", "content_sanskrit": "कृतवर्मा महेष्वासः सात्वतानां महारथः ।\nहतं वैकर्तनं दृष्ट्वा हार्दिक्यः किमभाषत\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2167127, "chapter_id": 4589, "verse_number": "७८", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्या यस्य शिक्षामुपासते ।\nधनुर्वेदं चिकीर्षन्तो द्रोणपुत्रस्य धीमतः\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2167128, "chapter_id": 4589, "verse_number": "७९", "content_sanskrit": "दिव्यरूपेण सम्पन्नो दर्शनीयो महायशाः ।\nअश्वत्थामा हते कर्णे किमभाषत सञ्जय\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2167129, "chapter_id": 4589, "verse_number": "८०", "content_sanskrit": "आचार्यो यो धनुर्वेदे गौतमो रथसत्तमः ।\nस कृपस्तात तेजस्वी हते कर्णे किमब्रवीत्\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2167130, "chapter_id": 4589, "verse_number": "८१", "content_sanskrit": "मद्रराजो महेष्वासः शल्यस्तत्र किमब्रवीत् ।\nदृष्ट्वा विनिहतं कर्णं सारथ्ये रथिनां वरः\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2167131, "chapter_id": 4589, "verse_number": "८२", "content_sanskrit": "किमभाषत सौवीरो मद्राणामधिपो बली\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2167132, "chapter_id": 4589, "verse_number": "८३", "content_sanskrit": "दृष्टं तेन हि तत् सर्वं यथा कर्णो निपातितः\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2167133, "chapter_id": 4589, "verse_number": "८४", "content_sanskrit": "ये च केचन राजानः पृथिव्यां योद्धुमागताः ।\nवैकर्तनं हतं दृष्ट्वा कान्यभाषन्त सञ्जय\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2167134, "chapter_id": 4589, "verse_number": "८५", "content_sanskrit": "कर्णे विनिहते वीरे रथव्याघ्रे नरर्षभे ।\nको वा मुखमनीकानामासीत् सञ्जय भागशः\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2167135, "chapter_id": 4589, "verse_number": "८६", "content_sanskrit": "मद्रराजः कथं शल्यो नियुक्तो रथिनां वरः ।\nवैकर्तनस्य सारथ्ये तन्ममाचक्ष्व सञ्जय\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2167136, "chapter_id": 4589, "verse_number": "८७", "content_sanskrit": "केऽरक्षन् दक्षिणं चक्रं सूतपुत्रस्य संयुगे ।\nवामं चक्रं ररक्षुर्वा के वासन्नस्य पृष्ठतः\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2167137, "chapter_id": 4589, "verse_number": "८८", "content_sanskrit": "के कर्णं न जहुः शूराः के क्षुद्राः प्राद्रवन् भयात् ।\nकथं च वः समेतानां हतः कर्णो महारथः\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2167138, "chapter_id": 4589, "verse_number": "८९", "content_sanskrit": "पाण्डवाश्च कथं शूराः प्रत्युदीयुर्महारथाः ।\nसृजन्तः शरवर्षाणि वारिधारा इवाम्बुदाः\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2167139, "chapter_id": 4589, "verse_number": "९०", "content_sanskrit": "स च सर्पमुखो दिव्यो महेषुप्रवरस्तदा ।\nव्यर्थः कथं समभवत् तन्ममाचक्ष्व सञ्जय\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2167140, "chapter_id": 4589, "verse_number": "९१", "content_sanskrit": "मामकस्यास्य सैन्यस्य हतोत्साहस्य सञ्जय ।\nअवशेषं न पश्यामि अर्जुने मुदिते सति\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2167141, "chapter_id": 4589, "verse_number": "९२", "content_sanskrit": "तौ हि वीरौ महेष्वासौ मदर्थे त्यक्तजीवितौ ।\nभीष्मद्रोणौ हतौ श्रुत्वा को न्वर्थो जीवितेन मे\t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2167142, "chapter_id": 4589, "verse_number": "९३", "content_sanskrit": "पुनः पुनर्न मृष्यामि हतं कर्णञ्च पाण्डवैः ।\nयस्य बाह्वोर्बलं तुल्यं कुञ्जराणां शतैःशतैः\t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2167143, "chapter_id": 4589, "verse_number": "९४", "content_sanskrit": "द्रोणे हते च यद् वृत्तं कौरवाणां परैः सह ।\nसङ्ग्रामे नरवीराणां तन्ममाचक्ष्व सञ्जय\t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2167144, "chapter_id": 4589, "verse_number": "९५", "content_sanskrit": "यथा कर्णश्च कौन्तेयैः सह युद्धमयोजयत् ।\nयथा वा द्विषतां हन्ता हतो युद्धे तदुच्यताम्\t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2167145, "chapter_id": 4589, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nनवमोऽध्यायः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2167146, "chapter_id": 4589, "verse_number": "", "content_sanskrit": "* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}]