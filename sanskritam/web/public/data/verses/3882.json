[{"id": 2133655, "chapter_id": 3882, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2133656, "chapter_id": 3882, "verse_number": "१", "content_sanskrit": "इदमन्यच्छ्रूयतां ययातिर्नाहुषो राजा राज्यस्थः पौरजनावृत आसा- ञ्चक्रे । भो राजन् गुर्वर्थं भिक्षेयं समयादिति कश्चिद् ब्राह्मणो- ब्रवीत्, राजोवाच ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2133657, "chapter_id": 3882, "verse_number": "२", "content_sanskrit": "ब्रवीतु भगवान् समयमिति ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2133658, "chapter_id": 3882, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2133659, "chapter_id": 3882, "verse_number": "", "content_sanskrit": "विद्वेषणं परमं जीवलोके कुर्यान्नरः पार्थिव याच्यमानः ।\nतं त्वां पृच्छामि कथं तु राजन् दद्याद् भवान्दयितं च मेऽद्य ॥३", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2133660, "chapter_id": 3882, "verse_number": "", "content_sanskrit": "राजा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2133661, "chapter_id": 3882, "verse_number": "४", "content_sanskrit": "न चानुकीर्तयेदद्य दत्त्वा अयाच्यमर्थं न च संशृणोमि ।\nप्राप्यमर्थं च संश्रुत्य तं चापि दत्त्वा सुसुखी भवामि \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2133662, "chapter_id": 3882, "verse_number": "", "content_sanskrit": "ददामि ते रोहिणीनां सहस्रं प्रियो हि मे ब्राह्मणो याचमानः ।\nन मे मनः कुप्यति याचमाने दत्तं न शोचामि कदाचिदर्थम् ॥५", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2133663, "chapter_id": 3882, "verse_number": "६", "content_sanskrit": "इत्युक्त्वा ब्राह्मणाय राजा गोसहस्रं ददौ ।\nप्राप्तवांश्च गवां सहस्रं ब्राह्मण इति ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2133664, "chapter_id": 3882, "verse_number": "२८", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां व्संहितायां वैयासिक्यां वनपर्वणि त्र्यधिकद्विशततमोऽध्यायः ॥२०३॥\nमार्कण्डेयसमास्यापर्वणि अष्टाविंशोऽध्यायः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2133665, "chapter_id": 3882, "verse_number": "", "content_sanskrit": "* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]