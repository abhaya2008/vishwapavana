[{"id": 2032355, "chapter_id": 1700, "verse_number": "४-२३-०x", "content_sanskrit": "द्रौपद्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2032356, "chapter_id": 1700, "verse_number": "४-२३-१", "content_sanskrit": "अहं सैरन्ध्रिवेषेण वसन्ती राजवेश्मनि।\nवशगाऽस्मि सुदेष्णाया अक्षधूर्तस्य कारणात् ॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2032357, "chapter_id": 1700, "verse_number": "४-२३-२", "content_sanskrit": "विक्रियां पश्य मे तीव्रां राजपुत्र्याः परन्तप।\nआसे कालमुपासीना सर्वदुःखसहा पुनः ॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2032358, "chapter_id": 1700, "verse_number": "४-२३-३", "content_sanskrit": "अनित्याः खलु मर्त्यानामर्थाश्च व्यसनानि च।\nइति मत्वा प्रतीक्षामि भर्तॄणामुदयं पुनः ॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2032359, "chapter_id": 1700, "verse_number": "४-२३-४", "content_sanskrit": "चक्रवत्परिवर्तन्ते ह्यर्थाश्च व्यसनानि च ।\nइति कृत्वा प्रतीक्षामि भर्तॄणामुदयं पुनः ॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2032360, "chapter_id": 1700, "verse_number": "४-२३-५", "content_sanskrit": "य एव हेतुर्भवति पुरुषस्य जयावहः।\nपराजये च हेतुः स इति च प्रतिपालये ॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2032361, "chapter_id": 1700, "verse_number": "४-२३-६", "content_sanskrit": "दत्त्वा याचन्ति पुरुषा हत्वा हन्यन्त एव ते।\nपातयित्वा च पात्यन्ते परैरिति च मे श्रुतम् ॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2032362, "chapter_id": 1700, "verse_number": "४-२३-७", "content_sanskrit": "न दैवस्यातिभारोस्ति न चैवास्यातिवर्तनम्।\nइति चाप्यागमं भूयो दैवस्य प्रतिपालये ॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2032363, "chapter_id": 1700, "verse_number": "४-२३-८", "content_sanskrit": "स्थितं पूर्वं जलं यत्र न पुनस्तत्र तिष्ठति ।\nइति पर्यायमिच्छन्ति प्रतीक्षाम्युदयं पुनः ॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2032364, "chapter_id": 1700, "verse_number": "४-२३-९", "content_sanskrit": "दैवेन किल यस्यार्थः सुनीतोपि विपद्यते।\nसदा दैवागमे यत्नस्तेन कार्यो विजानता ॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2032365, "chapter_id": 1700, "verse_number": "४-२३-१०", "content_sanskrit": "किंनु मे वचनस्याद्य कथितस्य प्रयोजनम् ।\nपृच्छ मां दुःखितामेनामपृष्टाऽपि ब्रवीमि ते ॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2032366, "chapter_id": 1700, "verse_number": "४-२३-११", "content_sanskrit": "महिषी पाण्डुपुत्राणां दुहिता द्रुपदस्य च ।\nइमामवस्थां संप्राप्ता मदन्या का जिजीविषेत् ॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2032367, "chapter_id": 1700, "verse_number": "४-२३-१२", "content_sanskrit": "कुरून्परिहरन्सर्वान्पाञ्चालानपि भारत।\nपाण्डवेयांश्च संप्राप्तो मम शोको ह्यरिन्दम ॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2032368, "chapter_id": 1700, "verse_number": "४-२३-१३", "content_sanskrit": "भ्रातृभिः श्वशुरैः पुत्रैर्बहुभिः परिवारिता।\nएवं समुदिता नारी कान्वेयं दुःखभागिनी ॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2032369, "chapter_id": 1700, "verse_number": "४-२३-१४", "content_sanskrit": "नूनं बालतया धातुर्मया वै विप्रियं कृतम्।\nतस्य प्रभावाद्दुर्नीतं प्राप्ताऽस्मि भरतर्षभ ॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2032370, "chapter_id": 1700, "verse_number": "४-२३-१५", "content_sanskrit": "वर्णं विकारमपि मे पश्य पाण्डव यादृशम् ।\nईदृशो मे न तत्रासीद्दुःखे परमके पुरा ॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2032371, "chapter_id": 1700, "verse_number": "४-२३-१६", "content_sanskrit": "त्वमेव भीम जानीषे यन्मे पार्थ सुखं पुरा।\nसाऽहं दासीत्वमापन्ना न शान्तिं मनसा लभे॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2032372, "chapter_id": 1700, "verse_number": "४-२३-१७", "content_sanskrit": "तद्दैविकमिदं मन्ये यत्र पार्थो धनञ्जयः।\nभीमधन्वा महारङ्गे चास्ते शान्त इवानलः ॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2032373, "chapter_id": 1700, "verse_number": "४-२३-१८", "content_sanskrit": "अशक्या वेदितुं पार्थ प्राणिनां वै गतिर्नरैः ।\nविनिपातमिमं पश्य युष्माकमविचिन्तितम् ॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2032374, "chapter_id": 1700, "verse_number": "४-२३-१९", "content_sanskrit": "यस्या मम मुखप्रेक्षा यूयमिन्द्रसमाः सदा।\nसा प्रेक्ष्य मुखमन्यासामवराणां वरा सती ॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2032375, "chapter_id": 1700, "verse_number": "४-२३-२०", "content_sanskrit": "पश्य पाण्डव मेऽवस्थां यथा नार्हामि वै तथा ।\nयुष्मासु ध्रियमाणेषु पाञ्चालेषु च मानद ॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2032376, "chapter_id": 1700, "verse_number": "४-२३-२१", "content_sanskrit": "यस्याः सागरपर्यन्ता पृथिवी वशवर्तिनी।\nआसीत्साऽद्य सुदेष्णायाः पाञ्चाली वशवर्तिनी ॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2032377, "chapter_id": 1700, "verse_number": "४-२३-२२", "content_sanskrit": "यस्याः पुरश्चरा ह्यासन्पृष्ठतश्चानुगामिनः।\nसाहमद्य सुदेष्णायाः पुरः पश्चाच्च गामिनी ॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2032378, "chapter_id": 1700, "verse_number": "४-२३-२३", "content_sanskrit": "इदं तु दुःखं कौन्तेय ममासह्यं निबोध तत्।\nया न जातु स्वयं पिंषे गात्रोद्वर्तनमात्मनः ।\nअन्यत्र कुन्त्या भद्रं ते सा पिनष्म्यद्य चन्दनं ॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2032379, "chapter_id": 1700, "verse_number": "४-२३-२४", "content_sanskrit": "पश्य कौन्तेय पाणी मे नैवं वै भवतः पुरा।\nइत्यस्मै दर्शयामास किणवन्तौ करावुभौ ॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2032380, "chapter_id": 1700, "verse_number": "४-२३-२५", "content_sanskrit": "बिभेमि कुन्त्या या नाऽहं युष्माकं वा कदाचन।\nसाऽद्याग्रतो विराटस्य भीता तिष्ठामि किंकरी ॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2032381, "chapter_id": 1700, "verse_number": "४-२३-२६", "content_sanskrit": "किंनु वक्ष्यति सम्राण्मां वर्णकः सुकृतो न वा।\nनान्यपिष्टं विराटस्य चन्दनं किल रोचते ॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2032382, "chapter_id": 1700, "verse_number": "४-२३-२७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2032383, "chapter_id": 1700, "verse_number": "४-२३-२७", "content_sanskrit": "सा कीर्तयन्ती दुःखानि भीमसेनस्य भामिनी।\nरुरोद शनकैः कृष्णा भीमस्योरस्समाश्रिता ॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2032384, "chapter_id": 1700, "verse_number": "४-२३-२८", "content_sanskrit": "सा बाष्पकलया वाचा निश्वसन्ती पुनःपुनः ।\nहृदयं भीमसेनस्य घटयन्तीदमब्रवीत् ॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2032385, "chapter_id": 1700, "verse_number": "४-२३-२९", "content_sanskrit": "नाल्पं कृतं मया भीम देवानां किल्बिषं पुरा।\nअभाग्या या तु जीवामि मर्तव्ये सति पाण्डव ॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2032386, "chapter_id": 1700, "verse_number": "४-२३-३०", "content_sanskrit": "कीचकं चेन्न हन्यास्त्वं स्वात्मानं नाशयाम्यहम्।\nविषमालोड्य पास्यामि प्रवेक्ष्याम्यथवाऽनलम्।\nअभाग्याऽहमपुण्याऽहं नित्यदुःखा च विक्लवा ॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2032387, "chapter_id": 1700, "verse_number": "४-२३-३१", "content_sanskrit": "पापे निपतितायाश्च किं फलं जीवितेन मे।\nइत्यस्मै दर्शयामास किणबद्धौ करावुभौ ॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2032388, "chapter_id": 1700, "verse_number": "४-२३-३२", "content_sanskrit": "ततस्तस्याः करौ पीनौ किणबद्धौ वृकोदरः।\nमुखमानीय वेपन्त्या रुरोद परवीरहा ॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2032389, "chapter_id": 1700, "verse_number": "४-२३-३३", "content_sanskrit": "तौ गृहीत्वा च कौन्तेयो बाष्पमुत्सृज्य वीर्यवान् ।\nततः परमदुःखार्त इदं वचनमब्रवीत् ॥ ३२ ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2032390, "chapter_id": 1700, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि कीचकवधपर्वणि त्रयोविंशोऽध्यायः ॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]