[{"id": 2078052, "chapter_id": 2657, "verse_number": "१२-१६२-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2078053, "chapter_id": 2657, "verse_number": "१२-१६२-१", "content_sanskrit": "आनृशंस्यं विजानामि दर्शनेन सतां सदा।\nनृशंसान्न विजानामि तेषां कर्म च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2078054, "chapter_id": 2657, "verse_number": "१२-१६२-२", "content_sanskrit": "कण्टकान्कूपमग्निं च वर्जयन्ति यथा नराः।\nतथा नृशंसकर्माणं वर्जयन्ति नरा नरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2078055, "chapter_id": 2657, "verse_number": "१२-१६२-३", "content_sanskrit": "नृशंसो दह्यते व्यक्तं प्रेत्य चेह च भारत।\nतस्मात्त्वं ब्रूहि कौरव्य तस्य धर्मविनिश्चयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2078056, "chapter_id": 2657, "verse_number": "१२-१६२-४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2078057, "chapter_id": 2657, "verse_number": "१२-१६२-४", "content_sanskrit": "स्पृहाऽस्यान्तर्गता चैव विदितार्था च कर्मणाम्\nआक्रोष्टा क्रुश्यते चैव बन्धिता बध्यते स च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2078058, "chapter_id": 2657, "verse_number": "१२-१६२-५", "content_sanskrit": "दत्तानुकीर्तिर्विषमः क्षुद्रो नैकृतिकः शठः।\nअसंभोगी च मानी च तथा सङ्गी विकत्थनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2078059, "chapter_id": 2657, "verse_number": "१२-१६२-६", "content_sanskrit": "सर्वातिशङ्की पुरुषो बलीशः कृपणोऽथवा।\nवर्गप्रशंसीं सततमाश्रमद्वेपसंकरी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2078060, "chapter_id": 2657, "verse_number": "१२-१६२-७", "content_sanskrit": "हिंसाविकारी सततमविशेषगुणागुणः।\nबह्वलीको मनस्वी च लुब्धोऽत्यर्थं नृशंसकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2078061, "chapter_id": 2657, "verse_number": "१२-१६२-८", "content_sanskrit": "धर्मशीलं गुणोपेतं पाप इत्यवगच्छति।\nआत्मशीलोपमानेन न विश्वसिति कस्यचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2078062, "chapter_id": 2657, "verse_number": "१२-१६२-९", "content_sanskrit": "परेषां यत्र दोपः स्यात्तद्गुह्यं संप्रकाशयेत्।\nसमानेष्वेव दोपेषु वृत्त्यर्थमुपघातयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2078063, "chapter_id": 2657, "verse_number": "१२-१६२-१०", "content_sanskrit": "तथोपकारिणं चैव मन्यते वञ्चितं परम्।\nदत्त्वाऽपि च धनं काले संतपत्युपकारिणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2078064, "chapter_id": 2657, "verse_number": "१२-१६२-११", "content_sanskrit": "भक्ष्यं पेयमथालेह्यं यच्चान्यत्साधु भोजनम्।\nप्रेक्षमाणेषु योऽश्नीयान्नृशंसमिति तं वदेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2078065, "chapter_id": 2657, "verse_number": "१२-१६२-१२", "content_sanskrit": "ब्राह्मणेभ्यः प्रदायाग्रं यः सुहृद्भिः सहाश्नुते।\nस प्रेत्य लभते स्वर्गमिह चानन्त्यमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2078066, "chapter_id": 2657, "verse_number": "१२-१६२-१३", "content_sanskrit": "एष ते भरतश्रेष्ठ नृशंसः परिकीर्तितः।\nसदा विवर्जनीयो हि पुरुषेण बुभूषता॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2078067, "chapter_id": 2657, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि द्विषष्ट्यधिकशततमोऽध्यायः॥ १६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]