[{"id": 2098171, "chapter_id": 3101, "verse_number": "१३-२३१-१", "content_sanskrit": "उमोवाच।\nभगवन्देवदेवेश शूलपाणे वृषध्वज।\nश्रुतं मे परमं गुह्यं प्रसादात्ते वरप्रद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2098172, "chapter_id": 3101, "verse_number": "१३-२३१-२", "content_sanskrit": "श्रोतुं भूयोऽहमिच्छामि प्रजानां हितकारणात्।\nशुभाशुभमिति प्रोक्तं कर्म स्वस्वं समासतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2098173, "chapter_id": 3101, "verse_number": "१३-२३१-३", "content_sanskrit": "तन्मे विस्तरतो ब्रूहि शुभाशुभविधइं प्रति।\nअशुभं कीदृशं कर्म प्राणिनो यन्निपातयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2098174, "chapter_id": 3101, "verse_number": "१३-२३१-४", "content_sanskrit": "शुभं वापि कथं देव प्रजानामूर्ध्वदं भवेत्।\nएतन्मे वद देवेश श्रोतुकामाऽस्मि कीर्तय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2098175, "chapter_id": 3101, "verse_number": "१३-२३१-५x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2098176, "chapter_id": 3101, "verse_number": "१३-२३१-५", "content_sanskrit": "तदहं ते प्रवक्ष्यामि तत्सर्वं शृणु शोभने।\nसुकृतं दुष्कृतं चेति द्विविधं कर्मविस्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2098177, "chapter_id": 3101, "verse_number": "१३-२३१-६", "content_sanskrit": "तयोर्यद्दुष्कृतं कर्म तच्च सञ्जायते त्रिधा।\nमनसा कर्मणा वाचा बुद्धिमोहसमुद्भवात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2098178, "chapter_id": 3101, "verse_number": "१३-२३१-७", "content_sanskrit": "मनःपूर्वं तु वा कर्म वर्तते वाङ्मयं ततः।\nजायते वै क्रियायोगमनु चेष्टाक्रमः प्रिये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2098179, "chapter_id": 3101, "verse_number": "१३-२३१-८", "content_sanskrit": "अभिद्रोहोऽभ्यसूया च परार्थेषु च वै स्पृहा।\nशुभाशुभानां मर्त्यानां वर्तनं परिवारितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2098180, "chapter_id": 3101, "verse_number": "१३-२३१-९", "content_sanskrit": "धर्मकार्ये यदाऽश्रद्धा पापकर्मणि हर्षणम्।\nएवमाद्यशुभं कर्म मनसा पापमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2098181, "chapter_id": 3101, "verse_number": "१३-२३१-१०", "content_sanskrit": "अनृतं यच्च परुषमबद्धवचनं कटु।\nअसत्यं परिवादश्च पापमेतत्तु वाङ्मयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2098182, "chapter_id": 3101, "verse_number": "१३-२३१-११", "content_sanskrit": "अगम्यागमनं चैव परदारनिषेवणम्।\nवधबन्धपरिक्लेशैः परप्राणोपतापनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2098183, "chapter_id": 3101, "verse_number": "१३-२३१-१२", "content_sanskrit": "चौर्यं परेषां द्रव्याणां हरणं नाशनं तथा।\nअभक्ष्यभक्षणं चैव व्यसनेष्वविषङ्गता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2098184, "chapter_id": 3101, "verse_number": "१३-२३१-१३", "content_sanskrit": "दर्पात्स्तम्भाभिमानाच्च परेषामुपतापनम्।\nअकार्याणां च करणमशौचं पानसेवनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2098185, "chapter_id": 3101, "verse_number": "१३-२३१-१४", "content_sanskrit": "दौःशील्यं पापसम्पर्के साहाय्यं पापकर्मणि।\nअधर्म्यमयशस्यं च कार्यं तस्य निषेवणम्।\nएवमाद्यशुभं चान्यच्छारीरं पापमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2098186, "chapter_id": 3101, "verse_number": "१३-२३१-१५", "content_sanskrit": "मानसाद्वाङ्मयं पापं विशिष्टमिति लक्ष्यते।\nवाङ्मयादपि वै पापाच्छारीरं गण्यते बहु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2098187, "chapter_id": 3101, "verse_number": "१३-२३१-१६", "content_sanskrit": "एवं पापयुतं कर्म त्रिविधं पातयेन्नरम्।\nपरापकारजननमत्यन्तं पातकं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2098188, "chapter_id": 3101, "verse_number": "१३-२३१-१७", "content_sanskrit": "त्रिविधं तत्कृतं पापं कर्तारं पापकं नयेत्।\nपातकं चापि यत्कर्म कर्मणा बुद्धिपूर्वकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2098189, "chapter_id": 3101, "verse_number": "१३-२३१-१८", "content_sanskrit": "सापदेशमवश्यं तत्कर्तव्यमिति तत्कृतम्।\nकथञ्चित्तत्कृतमपि कर्ता तेन स लिप्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2098190, "chapter_id": 3101, "verse_number": "१३-२३१-१९", "content_sanskrit": "अवश्यं पापदेशेन प्रतिहृन्येत कारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2098191, "chapter_id": 3101, "verse_number": "१३-२३१-२०x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2098192, "chapter_id": 3101, "verse_number": "१३-२३१-२०", "content_sanskrit": "भगवन्पापकं कर्म यथा कृत्वा न लिप्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2098193, "chapter_id": 3101, "verse_number": "१३-२३१-२१x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2098194, "chapter_id": 3101, "verse_number": "१३-२३१-२१", "content_sanskrit": "यो नरोऽनपराधी च स्वात्मप्राणस्य रक्षणात्।\nशत्रुमुद्यतशस्त्रं वा पूर्वं तेन हतोपि वा।\nप्रतिहन्यान्नरो हिंस्यान्न स पापेन लिप्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2098195, "chapter_id": 3101, "verse_number": "१३-२३१-२२", "content_sanskrit": "चोरादधिकसंत्रस्तस्तत्प्रतीकारचेष्टया।\nयः प्रजघ्नन्नरो हन्यान्न स पापेन लिप्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2098196, "chapter_id": 3101, "verse_number": "१३-२३१-२३", "content_sanskrit": "ग्रामार्थं भर्तृपिण्डार्थं दीनानुग्रहकारणात्।\nवधबन्धपरिक्लेशान्कुर्वन्पापात्प्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2098197, "chapter_id": 3101, "verse_number": "१३-२३१-२४", "content_sanskrit": "दुर्भिक्षे चात्मवृत्त्यर्थमेकायतनगस्तथा।\nअकार्यं वाऽप्यभक्ष्यं वा कृत्वा पपान्न लिप्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2098198, "chapter_id": 3101, "verse_number": "१३-२३१-२५", "content_sanskrit": "विधिरेष गृहस्थानां प्रायेणैवोपदिश्यते।\nअवाच्यं वाऽप्यकार्यं वा देशकालवशेन तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2098199, "chapter_id": 3101, "verse_number": "१३-२३१-२६", "content_sanskrit": "बुद्धिपूर्व नरः कुर्वस्तत्प्रयोजनमात्रया।\nकिञ्चिद्वा लिप्यते पापैरथवा न च लिप्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2098200, "chapter_id": 3101, "verse_number": "१३-२३१-२७", "content_sanskrit": "एवं देवि विजानीहि नास्ति तत्र विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2098201, "chapter_id": 3101, "verse_number": "१३-२३१-२८x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2098202, "chapter_id": 3101, "verse_number": "१३-२३१-२८", "content_sanskrit": "भगवन्पानदोषांश्च पेयापेयत्वकारणम्।\nएतदिच्छाम्यहं श्रोतुं तन्मे वद महेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2098203, "chapter_id": 3101, "verse_number": "१३-२३१-२९x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2098204, "chapter_id": 3101, "verse_number": "१३-२३१-२९", "content_sanskrit": "हन्त ते कथयिष्यामि पानोत्पत्तिं शुचिस्मिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2098205, "chapter_id": 3101, "verse_number": "१३-२३१-३०", "content_sanskrit": "पुरा सर्वेऽभवन्मर्त्या बुद्धिमन्तो नयानुगाः।\nशुचयश्च शुभाचाराः सर्वे चोन्मनसः प्रिये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2098206, "chapter_id": 3101, "verse_number": "१३-२३१-३१", "content_sanskrit": "एवंभूते तदा लोके प्रेष्यकृन्न परस्परम्।\nप्रेष्याबावान्मनुष्याणां कर्मारम्भो ननाश ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2098207, "chapter_id": 3101, "verse_number": "१३-२३१-३२", "content_sanskrit": "उभयोर्लोकयोर्नाशं दृष्ट्वा कर्मक्षयात्प्रभुः।\nयज्ञकर्म कथं लोके वर्तेतेति पितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2098208, "chapter_id": 3101, "verse_number": "१३-२३१-३३", "content_sanskrit": "आज्ञापयत्सुरान्देवि मोहयस्वेति मानुषान्।\nतमसः सारमुद्धृत्य पानं बुद्धिप्रणाशनम्इ।\nन्यपातयन्मनुष्येषु पापदोषावहं प्रिये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2098209, "chapter_id": 3101, "verse_number": "१३-२३१-३४", "content_sanskrit": "तदाप्रभृति तत्पानान्मुमुहुर्मानवा भुवि।\nकार्याकार्यमजानन्तो वाच्यावाच्यं गुणागुणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2098210, "chapter_id": 3101, "verse_number": "१३-२३१-३५", "content_sanskrit": "केचिद्धसन्ति तत्पीत्वा प्रवदन्ति तथा परे।\nनृत्यन्ति मुदिताः केचिद्गायन्ति शुभाशुभान्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2098211, "chapter_id": 3101, "verse_number": "१३-२३१-३६", "content_sanskrit": "कलिं ते कुर्वतेऽभीष्टं प्रहरन्ति परस्परम्।\nक्वचिद्धावन्ति सहसा प्रस्खलन्ति पतन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2098212, "chapter_id": 3101, "verse_number": "१३-२३१-३७", "content_sanskrit": "अयुक्तं बहु भाषन्ते यत्र क्वचन शोभने।\nनग्ना विक्षिप्य गात्राणि नष्टज्ञाना इवासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2098213, "chapter_id": 3101, "verse_number": "१३-२३१-३८", "content_sanskrit": "एवं बहुविधान्भावान्कुर्वन्ति भ्रान्तचेतनाः।\nये पिबन्ति महामोहं पानं पापयुता नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2098214, "chapter_id": 3101, "verse_number": "१३-२३१-३९", "content_sanskrit": "धृतिं लज्जां च बुद्धिं च पानं पीतं प्रणाशयेत्।\nतस्मान्नराः सम्भवन्ति निर्लज्जा निरपत्रपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2098215, "chapter_id": 3101, "verse_number": "१३-२३१-४०", "content_sanskrit": "बुद्धिसत्वैः परिक्षीणास्तेजोहीना मलान्विताः।\nपीत्वापीत्वा तृषायुक्ताः पानपाः सम्भवन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2098216, "chapter_id": 3101, "verse_number": "१३-२३१-४१", "content_sanskrit": "पानकामाः पानकथाः पानकालाभिकाङ्क्षिणः।\nपानार्थं कर्मवश्यास्ते सम्भवन्ति नराधमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2098217, "chapter_id": 3101, "verse_number": "१३-२३१-४२", "content_sanskrit": "पानकामास्तृषायोगाद्बुद्धिसत्वपरिक्षयात्।\nपानदानां प्रेष्यकाराः पानपाः सहसाऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2098218, "chapter_id": 3101, "verse_number": "१३-२३१-४३", "content_sanskrit": "तदाप्रभृति वै लोके दीनैः पानवशैर्नरैः।\nकारयन्ति च कर्माणि बुद्धिमन्तस्तु पानपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2098219, "chapter_id": 3101, "verse_number": "१३-२३१-४४", "content_sanskrit": "कारुत्वमथ दासत्वं प्रेष्यतामेत्य पानपाः।\nसर्वकर्मकराश्चासन्पशुवद्रज्जुबन्धिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2098220, "chapter_id": 3101, "verse_number": "१३-२३१-४५", "content_sanskrit": "पानपस्तु सुरां पीत्वा तदा बुद्धिप्रणाशनात्।\nकार्याकार्यस्य चाज्ञानाद्यथेष्टकरणात्स्वयम्।\nविदुषामविधेयत्वात्पापमेवाभिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2098221, "chapter_id": 3101, "verse_number": "१३-२३१-४६", "content_sanskrit": "परिभूतो भवेल्लोके मद्यपो मित्रभेदकः।\nसर्वकालमशुद्धिं च सर्वभक्षस्तथा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2098222, "chapter_id": 3101, "verse_number": "१३-२३१-४७", "content_sanskrit": "विनष्टो ज्ञातिविद्वद्भ्यः सततं कलिभावगः।\nपरुषं कटुकं घोरं वाक्यं वदति सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2098223, "chapter_id": 3101, "verse_number": "१३-२३१-४८", "content_sanskrit": "गुरूनतिवदेन्मत्तः परदारान्प्रधर्षयेत्।\nसंविदं कुरुते शौण्डेर्न शृणोति हितं क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2098224, "chapter_id": 3101, "verse_number": "१३-२३१-४९", "content_sanskrit": "एवं बहुविधा दोषाः पानपे सन्ति शोभने।\nकेवलं नरकं यान्ति नास्ति तत्र विचारणा।\nतस्मात्तद्वर्जितं सद्भिः पानमात्महितैषिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2098225, "chapter_id": 3101, "verse_number": "१३-२३१-५०", "content_sanskrit": "यदि पानं न वर्जेरन्सन्तश्चारित्रकारणात्।\nभवेदेतज्जगत्सर्वममर्यादं च निष्क्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2098226, "chapter_id": 3101, "verse_number": "१३-२३१-५१", "content_sanskrit": "तस्माद्बुद्धेर्हि रक्षार्थं सद्भिः पानं विवर्जितम्।\nइति ते दुष्कृतं सर्वं कथितं त्रिविधं प्रिये॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2098227, "chapter_id": 3101, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकत्रिंशदधिकद्विशततमोऽद्यायः॥ २३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]