[{"id": 7005521000, "chapter_id": 25521, "verse_number": "२-३८-१", "content_sanskrit": "सुत उवाच ।\nएषा पुण्यतमा देवी देवगन्धर्वसेविता ।\nनर्मदा लोकविख्याता तीर्थानामुत्तमा नदी ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005521001, "chapter_id": 25521, "verse_number": "२-३८-२", "content_sanskrit": "तस्याः श्रृणुध्वं माहात्म्यं मार्कण्डेयेन भाषितम ।\nयुधिष्ठिराय तु शुभं सर्वपापप्रणाशनम ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005521002, "chapter_id": 25521, "verse_number": "२-३८-३", "content_sanskrit": "युधिष्ठिर उवाच ।\nश्रुतास्तु विविधा धर्मास्त्वत्प्रसादान्महामुने ।\nमाहात्म्यं च प्रयागस्य तीर्थानि विविधानि च ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005521003, "chapter_id": 25521, "verse_number": "२-३८-४", "content_sanskrit": "नर्मदा सर्वतीर्थानां मुख्यां हि भवतेरिता ।\nतस्यास्त्विदानी माहात्म्यं वक्तुमर्हसि सत्तम ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005521004, "chapter_id": 25521, "verse_number": "२-३८-५", "content_sanskrit": "मार्कण्डेय उवाच ।\nनर्मदा सरितां श्रेष्ठा रुद्रदेहाद विनिःसृता ।\nतारयेत सर्वभुतानि स्थावराणि चराणि च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005521005, "chapter_id": 25521, "verse_number": "२-३८-६", "content_sanskrit": "नर्मदायास्तु माहात्म्यं पुराणे यन्मया श्रुतम ।\nइदानीं तत प्रवक्ष्यामि श्रृणुष्वैकमनाः शुभम ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005521006, "chapter_id": 25521, "verse_number": "२-३८-७", "content_sanskrit": "पुण्या कनखले गंगा कुरुक्षेत्रे सरस्वती ।\nग्रामे वा यदि वारण्ये पुण्या सर्वत्र नर्मदा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005521007, "chapter_id": 25521, "verse_number": "२-३८-८", "content_sanskrit": "त्रिभिः सारस्वतं तोयं सप्ताहेन तु यामुनम ।\nसद्यः पुनाति गांगेयं दर्शनादेव नार्मदम ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005521008, "chapter_id": 25521, "verse_number": "२-३८-९", "content_sanskrit": "कलिंगदेशपश्चार्धे पर्वतेऽमरकण्टके ।\nपुण्या च त्रिषु लोकेषु रमणीया मनोरमा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005521009, "chapter_id": 25521, "verse_number": "२-३८-१०", "content_sanskrit": "सदेवसुरगन्धर्वा ऋषयश्च तपोधनाः ।\nतपस्तप्वा तु राजेन्द्र सिद्धिं तु परमां गताः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005521010, "chapter_id": 25521, "verse_number": "२-३८-११", "content_sanskrit": "तत्र स्नात्वा नरो राजन नियमस्थो जितेन्द्रियः ।\nउपोष्य रजनीमेकां कुलानां तारयेच्छतम ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005521011, "chapter_id": 25521, "verse_number": "२-३८-१२", "content_sanskrit": "योजनानां शतं साग्रं श्रुयते सरिदुत्तमा ।\nविस्तारेण तु राजेन्द्र योजनद्वयमायता ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005521012, "chapter_id": 25521, "verse_number": "२-३८-१३", "content_sanskrit": "षष्टितीर्थसहस्राणि षष्टिकोट्यस्तथैव च ।\nपर्वतस्य समन्तात तु तिष्ठन्त्यमरकण्टके ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005521013, "chapter_id": 25521, "verse_number": "२-३८-१४", "content_sanskrit": "ब्रह्माचारी शुचिर्भूत्वा जितक्रोधो जितेन्द्रियः ।\nसर्वहिंसानिवृत्तस्तु सर्वभूतहिते रतः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005521014, "chapter_id": 25521, "verse_number": "२-३८-१५", "content_sanskrit": "एवं सर्वसमाचारो यस्तु प्राणान समुत्सृजेत ।\nतस्य पुण्यफलं राजन श्रृणुष्वावहितो नृप ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005521015, "chapter_id": 25521, "verse_number": "२-३८-१६", "content_sanskrit": "शतवर्षसहस्त्राणि स्वर्गे मोदति पाण्डव ।\nअप्सरोगणसंकीर्णो दिव्यस्त्रीपरिवरितः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005521016, "chapter_id": 25521, "verse_number": "२-३८-१७", "content_sanskrit": "दिव्यगन्धानुलिप्तश्च दिव्यपुष्पोशोभितः ।\nक्रीडते देवलोकेक तु दैवतैः सह मोदते ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005521017, "chapter_id": 25521, "verse_number": "२-३८-१८", "content_sanskrit": "ततः स्वर्गात परिभ्रष्टो राजा भवति धार्मिकः ।\nगृहं तु लभते‍ऽसौ वै नानारत्‍नसमन्वितम ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005521018, "chapter_id": 25521, "verse_number": "२-३८-१९", "content_sanskrit": "स्तम्भैर्मणिमयैर्दिव्यैर्वज्रवैदुर्यभुषितम ।\nआलेख्यवाहनैः शुभ्रैर्द्रासीदाससमन्वितम ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005521019, "chapter_id": 25521, "verse_number": "२-३८-२०", "content_sanskrit": "राजराजेश्वरः श्रीमान सर्वस्त्रीजनवल्लभः ।\nजीवेद वर्षशतं साग्रं तत्र भोजसमन्वितः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005521020, "chapter_id": 25521, "verse_number": "२-३८-२१", "content_sanskrit": "अग्निप्रवेशेऽथ जले अथवाऽनशने कृते ।\nअनिवर्तिका गतिस्तस्य पवनस्याम्बरे यथा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005521021, "chapter_id": 25521, "verse_number": "२-३८-२२", "content_sanskrit": "पश्चिमे पर्वततटे सर्वपापविनाशनः ।\nह्रदो जलेश्वरो नाम त्रिषु लोकेषु विश्रुतः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005521022, "chapter_id": 25521, "verse_number": "२-३८-२३", "content_sanskrit": "तत्र पिण्डप्रदानेन संध्योपासनकर्मणा ।\nदशवर्षणि पितरस्तर्पिताः स्युनं संशयः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005521023, "chapter_id": 25521, "verse_number": "२-३८-२४", "content_sanskrit": "दक्षिणे नर्मदाकुले कपिलाख्यां महानदी ।\nसरलार्जुनसंच्छन्ना नातिदुरे व्यवस्थिता ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005521024, "chapter_id": 25521, "verse_number": "२-३८-२५", "content_sanskrit": "सा तु पुण्या महाभाग त्रिषु लोकेषु विश्रुता ।\nतत्र कोटिशतं साग्रं तीथांनां तु युधिष्ठिर ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005521025, "chapter_id": 25521, "verse_number": "२-३८-२६", "content_sanskrit": "तस्मिंस्तीर्थे तु ये वृक्षाः पतिताः कालपर्ययात ।\nनर्मदातोयसंस्पृष्टास्ते यान्ति परमां गतिम ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005521026, "chapter_id": 25521, "verse_number": "२-३८-२७", "content_sanskrit": "द्वितीया तु महाभागा विशल्यकरणी शुभा ।\nतत्र तीर्थे नरः स्नात्वा विशल्यो भवति क्षणात ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005521027, "chapter_id": 25521, "verse_number": "२-३८-२८", "content_sanskrit": "कपिला च विशल्या च श्रुयते राजसत्तम ।\nइश्वरेण पुरा प्रोक्ता लोकानां हितकाम्यया ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005521028, "chapter_id": 25521, "verse_number": "२-३८-२९", "content_sanskrit": "अनाशकं तु यः कुर्यात तस्मिस्तीर्थे नराधिप ।\nसर्वपापविशुद्धात्मा रुद्रलोकं स गच्छति ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005521029, "chapter_id": 25521, "verse_number": "२-३८-३०", "content_sanskrit": "तत्र स्नात्वा नरो राजन्नश्वमेधफलं लभेत ।\nये वसन्त्युत्तरे कुले रुद्रलोके वसन्ति ते ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005521030, "chapter_id": 25521, "verse_number": "२-३८-३१", "content_sanskrit": "सरस्वत्यां च गंगायां नर्मदायां युधिष्ठिर ।\nसमं स्नानं च दानं च यथा मे शंकरोऽब्रवीत ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005521031, "chapter_id": 25521, "verse_number": "२-३८-३२", "content_sanskrit": "परित्यजति यः प्रणान पर्वतेऽमरकण्टके ।\nवर्षकोटिशतं साग्रं रुद्रलोके महीयते ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005521032, "chapter_id": 25521, "verse_number": "२-३८-३३", "content_sanskrit": "नर्मदायां जलं पुण्यं फेनोर्मिसमलंकृतम ।\nपवित्रं शिरसावन्द्य सर्वपापैः प्रमुच्यते ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005521033, "chapter_id": 25521, "verse_number": "२-३८-३४", "content_sanskrit": "नर्मदा सर्वतः पुण्याः ब्रह्माहत्यापहारिणी ।\nअहोरात्रोपवासेन मुच्यते ब्रह्माहत्यया ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005521034, "chapter_id": 25521, "verse_number": "२-३८-३५", "content_sanskrit": "जालेश्वरं तीर्थवरं सर्वपापविनाशनम ।\nतत्र गत्वा नियमवान सर्वकामाँल्लभेन्नरः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005521035, "chapter_id": 25521, "verse_number": "२-३८-३६", "content_sanskrit": "चन्द्रसुर्योपरागे तु गत्वा ह्रामरकण्टकम ।\nअश्‍वमेधाद दशगुण पुण्यमाप्नोति मानवः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005521036, "chapter_id": 25521, "verse_number": "२-३८-३७", "content_sanskrit": "एष पुण्यो गिरिवरो देवगन्धर्वसेवितः ।\nनानाद्रुमलताकीर्णो नानापुष्पोशोभितः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005521037, "chapter_id": 25521, "verse_number": "२-३८-३८", "content_sanskrit": "तत्र संनिहितो राजन देव्या सह महेश्वरः ।\nब्रह्मा विष्णुस्तथा चेन्द्रो विद्याधरगणैः सहः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005521038, "chapter_id": 25521, "verse_number": "२-३८-३९", "content_sanskrit": "प्रदक्षिणं तु यः कुर्यात पर्वतं ह्मामरकण्ट कम ।\nपौण्डरीकस्य यज्ञस्य फलं प्राप्नोति मानवः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005521039, "chapter_id": 25521, "verse_number": "२-३८-४०", "content_sanskrit": "कावेरी नाम विपुला नदी कल्मषनाशिनी ।\nतत्र स्नात्वा महादेवमर्चयेद वृषभध्वजम ।\nसंगमे नर्मदायास्तु रुद्रलोके महियते ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]