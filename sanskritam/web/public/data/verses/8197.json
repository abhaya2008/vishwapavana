[{"id": 900000952, "chapter_id": 8197, "verse_number": "5.1", "content_sanskrit": "ऋतं पिवन्तौ सुकृतस्य लोके गुहां प्रविष्टौ परमे परार्द्ध", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900000953, "chapter_id": 8197, "verse_number": "5.2", "content_sanskrit": "यः सेतुरीजानानामक्षरं ब्रह्म यत् परम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900000954, "chapter_id": 8197, "verse_number": "5.3", "content_sanskrit": "आत्मानं रथिनं विद्धि शरीरं रथमेव च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900000955, "chapter_id": 8197, "verse_number": "5.4", "content_sanskrit": "इन्द्रियेभ्यः परार्था अर्थेभ्यश्व परं मनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900000956, "chapter_id": 8197, "verse_number": "5.5", "content_sanskrit": "एष सर्वेषु भूतेषु गूढोऽत्मा न प्रकाशते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900000957, "chapter_id": 8197, "verse_number": "5.6", "content_sanskrit": "यच्छेद् वामनसि प्राज्ञस्तद् यच्छेज्ज्ञान आत्मनि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900000958, "chapter_id": 8197, "verse_number": "5.7", "content_sanskrit": "उत्तिष्ठत जाग्रत प्राप्य वरान् निबोधत", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900000959, "chapter_id": 8197, "verse_number": "5.8", "content_sanskrit": "अशब्दमस्पर्शमरूपमव्ययं तथाऽरसं नित्यम- गन्धवच्च यत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900000960, "chapter_id": 8197, "verse_number": "5.9", "content_sanskrit": "नाचिकेतमुपाख्यानं मृत्युप्रोक्तं सनातनम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900000961, "chapter_id": 8197, "verse_number": "5.10", "content_sanskrit": "य इमं परमं गुह्यं श्रावयेद् ब्रह्मसंसदि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]