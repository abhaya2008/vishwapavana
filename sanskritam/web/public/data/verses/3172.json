[{"id": 2101067, "chapter_id": 3172, "verse_number": "१४-२८-१", "content_sanskrit": "ब्राह्मण उवाच।\nसंकल्पदंशमशकं शोकहर्षहिमातपम्।\nमोहान्धकारतिमिरं लोभव्याधिसरीसृपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2101068, "chapter_id": 3172, "verse_number": "१४-२८-२", "content_sanskrit": "विषयैकात्ययाध्वानं कामक्रोधकिरातकम्।\nतदतीत्य महादुर्गं प्रविष्टोस्मि महद्वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2101069, "chapter_id": 3172, "verse_number": "१४-२८-३x", "content_sanskrit": "ब्राह्मण्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2101070, "chapter_id": 3172, "verse_number": "१४-२८-३", "content_sanskrit": "क्व तद्वनं महाप्राज्ञ के वृक्षाः सरितश्च काः।\nकियन्तः पर्वताश्चैव कियत्यध्यनि तद्वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2101071, "chapter_id": 3172, "verse_number": "१४-२८-४x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2101072, "chapter_id": 3172, "verse_number": "१४-२८-४", "content_sanskrit": "नैतदस्ति पृथग्भावः किञ्चिनद्यत्ततः सुखम्।\nनैतदस्त्यपृथग्भावः किञ्चिद्दुःखतरं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2101073, "chapter_id": 3172, "verse_number": "१४-२८-५", "content_sanskrit": "तस्माद्ध्रस्वतरं नास्ति न ततोस्ति महत्तरम्।\nनास्ति तस्माद्दुःखतरं नास्त्यन्यत्तत्समं सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2101074, "chapter_id": 3172, "verse_number": "१४-२८-६", "content_sanskrit": "न तत्राविश्यि शोचन्ति न प्रहृष्यन्ति च द्विजाः।\nन च बिभ्यति केभ्यश्चिन्नैभ्यो बिभ्यति केचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2101075, "chapter_id": 3172, "verse_number": "१४-२८-७", "content_sanskrit": "तस्मिन्वने सप्त महाद्रुमाश्च\nफलानि सप्तातिथयश्च सप्त।\nसप्ताश्रमाः सप्त समाधयश्च\nदीक्षाश्च सप्तैतदरण्यरूपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2101076, "chapter_id": 3172, "verse_number": "१४-२८-८", "content_sanskrit": "पञ्चवर्णानि दिव्यानि पुष्पाणि च फलानि च।\nसृजन्तः पादपास्तत्र व्याप्य तिष्ठन्ति तद्वन्म्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2101077, "chapter_id": 3172, "verse_number": "१४-२८-९", "content_sanskrit": "सुवर्णानि द्विवर्णानि पुष्पाणि च फलानि च।\nसृजन्तः पादपास्तत्र व्याप्य तिष्ठन्ति तद्वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2101078, "chapter_id": 3172, "verse_number": "१४-२८-१०", "content_sanskrit": "`शङ्कराणि त्रिवर्णानि पुष्पाणि च फलानि च।\nसृजन्तः पादपास्तत्र व्याप्य तिष्ठन्ति तद्वनम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2101079, "chapter_id": 3172, "verse_number": "१४-२८-११", "content_sanskrit": "सुरभीणि द्विवर्णानि पुष्पाणि च फलानि च।\nसृजन्तः पादपास्तत्र व्याप्य तिष्ठन्ति तद्वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2101080, "chapter_id": 3172, "verse_number": "१४-२८-१२", "content_sanskrit": "सुरभीण्येकवर्णानि पुष्पाणि च फलानि च।\nसृजन्तः पादपास्तत्र व्याप्य तिष्ठन्ति तद्वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2101081, "chapter_id": 3172, "verse_number": "१४-२८-१३", "content_sanskrit": "बहून्यव्यक्तवर्णानि पुष्पाणि च फलानि च।\nविसृजन्तौ महावृक्षौ तद्वनं व्याप्य तिष्ठतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2101082, "chapter_id": 3172, "verse_number": "१४-२८-१४", "content_sanskrit": "एको वह्निः सुमना ब्राह्मणोत्र\nपञ्चेन्द्रियाणि समिधश्चात्र सन्ति।\nतेभ्यो वृक्षाःक सप्त फलन्ति दीक्षा\nगुणाः फलान्यतिथयः फलाशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2101083, "chapter_id": 3172, "verse_number": "१४-२८-१५", "content_sanskrit": "आतिथ्यं प्रतिगृह्णन्ति तत्र सप्त महर्षयः।\nअर्चितेषु प्रलीनेषु तेष्वन्यद्रोचते वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2101084, "chapter_id": 3172, "verse_number": "१४-२८-१६", "content_sanskrit": "प्रज्ञावृक्षं मोक्षफलं शान्तिच्छायासमन्वितम्।\nज्ञानाश्रयं तृप्तितोयमन्तःक्षेत्रज्ञभास्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2101085, "chapter_id": 3172, "verse_number": "१४-२८-१७", "content_sanskrit": "येऽधिगच्छन्ति तत्सन्तस्तेषां नास्ति पुनर्भवः।\nऊर्ध्वं चाधश्च तिर्यक्च तस्य नान्तोऽधिगम्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2101086, "chapter_id": 3172, "verse_number": "१४-२८-१८", "content_sanskrit": "सप्त स्त्रियस्तत्र चरन्ति सत्या-\nस्त्ववाङ्मुखा भानुमत्यो जनित्र्यः।\nऊर्ध्वं रसानाददते प्रजाभ्यः\nसर्वान्यथा नित्यमनित्यता च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2101087, "chapter_id": 3172, "verse_number": "१४-२८-१९", "content_sanskrit": "तत्रैव प्रतितिष्ठन्ति पुनस्तत्रोदयन्ति च।\nसप्त सप्तर्षयः सिद्धा वसिष्ठप्रमुखैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2101088, "chapter_id": 3172, "verse_number": "१४-२८-२०", "content_sanskrit": "यशो वर्चो भगश्चैव विजयः सिद्धतेजसः।\nएतमेवानुवर्तन्ते सप्त ज्योतींषि भास्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2101089, "chapter_id": 3172, "verse_number": "१४-२८-२१", "content_sanskrit": "ऋषयः पर्वताश्चैव सन्ति तत्र समासतः।\nनद्यश्च परितो वारि वहन्त्यो ब्रह्मिसम्भवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2101090, "chapter_id": 3172, "verse_number": "१४-२८-२२", "content_sanskrit": "नदीनां सङ्गमश्चैव वैताने समुपहरे।\nस्वात्मतृप्ता यतो यान्ति साक्षादेव पितामहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2101091, "chapter_id": 3172, "verse_number": "१४-२८-२३", "content_sanskrit": "कृशाशाः सुव्रताः शान्तास्तपसा दग्धकिल्बिषाः।\nआत्मन्यात्मानमावेश्य ब्राह्मणास्तमुपासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2101092, "chapter_id": 3172, "verse_number": "१४-२८-२४", "content_sanskrit": "शमिमप्यत्र शंसन्ति विद्यारण्यविदो जनाः।\nतदरण्यमभिप्रेत्य यथातत्वमजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2101093, "chapter_id": 3172, "verse_number": "१४-२८-२५", "content_sanskrit": "एतदेवेदृशं पुण्यमरण्यं ब्राह्मणा विदुः।\nविदित्वा चानुतिष्ठन्ति क्षेत्रज्ञेनानुदर्शिना॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2101094, "chapter_id": 3172, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि अष्टाविंशोऽध्यायः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]