[{"id": 50024486, "chapter_id": 11861, "verse_number": "1", "content_sanskrit": "॥ आजीगर्तिः शुनःशेपः। १-१६ इन्द्रः, १७-१९ अश्विनौ, २०-२२ उषाः। १-१० गायत्री, ११ पादनिचृद्गायत्री, १२-१५ गायत्री, १६ त्रिष्टुप्, १७-२२ गायत्री ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024487, "chapter_id": 11861, "verse_number": "2", "content_sanskrit": "आ व॒ इन्द्रं॒ क्रिविं॑ यथा वाज॒यन्त॑ः श॒तक्र॑तुम्। मंहि॑ष्ठं सिञ्च॒ इन्दु॑भिः॥ ३०/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50024488, "chapter_id": 11861, "verse_number": "3", "content_sanskrit": "श॒तं वा॒ यः शुची॑नां स॒हस्रं॑ वा॒ समा॑शिराम्। एदु॑ नि॒म्नं न री॑यते॥ ३०/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50024489, "chapter_id": 11861, "verse_number": "4", "content_sanskrit": "सं यन्मदा॑य शु॒ष्मिण॑ ए॒ना ह्य॑स्यो॒दरे॑। स॒मु॒द्रो न व्यचो॑ द॒धे॥ ३०/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50024490, "chapter_id": 11861, "verse_number": "5", "content_sanskrit": "अ॒यमु॑ ते॒ सम॑तसि क॒पोत॑ इव गर्भ॒धिम्। वच॒स्तच्चि॑न्न ओहसे॥ ३०/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50024491, "chapter_id": 11861, "verse_number": "6", "content_sanskrit": "स्तो॒त्रं रा॑धानां पते॒ गिर्वा॑हो वीर॒ यस्य॑ ते। विभू॑तिरस्तु सू॒नृता॑॥ ३०/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50024492, "chapter_id": 11861, "verse_number": "7", "content_sanskrit": "ऊ॒र्ध्वस्ति॑ष्ठा न ऊ॒तये॒ऽस्मिन्वाजे॑ शतक्रतो। सम॒न्येषु॑ ब्रवावहै॥ ३०/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50024493, "chapter_id": 11861, "verse_number": "8", "content_sanskrit": "योगे॑योगे त॒वस्त॑रं॒ वाजे॑वाजे हवामहे। सखा॑य॒ इन्द्र॑मू॒तये॑॥ ३०/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50024494, "chapter_id": 11861, "verse_number": "9", "content_sanskrit": "आ घा॑ गम॒द्यदि॒ श्रव॑त्सह॒स्रिणी॑भिरू॒तिभि॑ः। वाजे॑भि॒रुप॑ नो॒ हव॑म्॥ ३०/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50024495, "chapter_id": 11861, "verse_number": "10", "content_sanskrit": "अनु॑ प्र॒त्नस्यौक॑सो हु॒वे तु॑विप्र॒तिं नर॑म्। यं ते॒ पूर्वं॑ पि॒ता हु॒वे॥ ३०/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50024496, "chapter_id": 11861, "verse_number": "11", "content_sanskrit": "तं त्वा॑ व॒यं वि॑श्ववा॒रा शा॑स्महे पुरुहूत। सखे॑ वसो जरि॒तृभ्य॑ः॥ ३०/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50024497, "chapter_id": 11861, "verse_number": "12", "content_sanskrit": "अ॒स्माकं॑ शि॒प्रिणी॑नां॒ सोम॑पाः सोम॒पाव्ना॑म्। सखे॑ वज्रि॒न्सखी॑नाम्॥ ३०/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50024498, "chapter_id": 11861, "verse_number": "13", "content_sanskrit": "तथा॒ तद॑स्तु सोमपा॒ः सखे॑ वज्रि॒न्तथा॑ कृणु। यथा॑ त उ॒श्मसी॒ष्टये॑॥ ३०/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50024499, "chapter_id": 11861, "verse_number": "14", "content_sanskrit": "रे॒वती॑र्नः सध॒माद॒ इन्द्रे॑ सन्तु तु॒विवा॑जाः। क्षु॒मन्तो॒ याभि॒र्मदे॑म॥ ३०/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50024500, "chapter_id": 11861, "verse_number": "15", "content_sanskrit": "आ घ॒ त्वावा॒न्त्मना॒प्तः स्तो॒तृभ्यो॑ धृष्णविया॒नः। ऋ॒णोरक्षं॒ न च॒क्र्यो॑ः॥ ३०/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50024501, "chapter_id": 11861, "verse_number": "16", "content_sanskrit": "आ यद्दुव॑ः शतक्रत॒वा कामं॑ जरितॄ॒णाम्। ऋ॒णोरक्षं॒ न शची॑भिः॥ ३०/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50024502, "chapter_id": 11861, "verse_number": "17", "content_sanskrit": "शश्व॒दिन्द्र॒ः पोप्रु॑थद्भिर्जिगाय॒ नान॑दद्भि॒ः शाश्व॑सद्भि॒र्धना॑नि। स नो॑ हिरण्यर॒थं दं॒सना॑वा॒न्स न॑ः सनि॒ता स॒नये॒ स नो॑ऽदात्॥ ३०/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50024503, "chapter_id": 11861, "verse_number": "18", "content_sanskrit": "आश्वि॑ना॒वश्वा॑वत्ये॒षा या॑तं॒ शवी॑रया। गोम॑द्दस्रा॒ हिर॑ण्यवत्॥ ३०/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50024504, "chapter_id": 11861, "verse_number": "19", "content_sanskrit": "स॒मा॒नयो॑जनो॒ हि वां॒ रथो॑ दस्रा॒वम॑र्त्यः। स॒मु॒द्रे अ॑श्वि॒नेय॑ते॥ ३०/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50024505, "chapter_id": 11861, "verse_number": "20", "content_sanskrit": "न्य१॒॑घ्न्यस्य॑ मू॒र्धनि॑ च॒क्रं रथ॑स्य येमथुः। परि॒ द्याम॒न्यदी॑यते॥ ३०/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50024506, "chapter_id": 11861, "verse_number": "21", "content_sanskrit": "कस्त॑ उषः कधप्रिये भु॒जे मर्तो॑ अमर्त्ये। कं न॑क्षसे विभावरि॥ ३०/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50024507, "chapter_id": 11861, "verse_number": "22", "content_sanskrit": "व॒यं हि ते॒ अम॑न्म॒ह्यान्ता॒दा प॑रा॒कात्। अश्वे॒ न चि॑त्रे अरुषि॥ ३०/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50024508, "chapter_id": 11861, "verse_number": "23", "content_sanskrit": "त्वं त्येभि॒रा ग॑हि॒ वाजे॑भिर्दुहितर्दिवः। अ॒स्मे र॒यिं नि धा॑रय॥ ३०/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]