[{"id": 2072315, "chapter_id": 2525, "verse_number": "१२-३०-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2072316, "chapter_id": 2525, "verse_number": "१२-३०-१", "content_sanskrit": "ततो राजा पाण्डुसुतो नारदं प्रत्यभाषत।\nभगवञ्छ्रोतुमिच्छामि सुवर्णष्ठीविसंभवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2072317, "chapter_id": 2525, "verse_number": "१२-३०-२", "content_sanskrit": "एवमुक्तस्तु स मुनिर्धर्मराजेन नारदः।\nआचचक्षे यथावृत्तं सुवर्णष्ठीविनं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2072318, "chapter_id": 2525, "verse_number": "१२-३०-३x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2072319, "chapter_id": 2525, "verse_number": "१२-३०-३", "content_sanskrit": "एवमेतन्महाबाहो यथाऽयं केशवोऽब्रवीत्।\nकार्यस्यास्य तु यच्छेषं तत्ते वक्ष्यामि पृच्छतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2072320, "chapter_id": 2525, "verse_number": "१२-३०-४", "content_sanskrit": "अहं च पर्वतश्चैव स्वस्रीयो मे महाप्नुनिः।\nवस्तुकामावभिगतौ सृञ्जयं जयतां वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2072321, "chapter_id": 2525, "verse_number": "१२-३०-५", "content_sanskrit": "तत्रावां पूजितौ तेन विधिदृष्टेन कर्मणा।\nसर्वकामैः सुविहितौ निवसावोऽस्य वेश्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2072322, "chapter_id": 2525, "verse_number": "१२-३०-६", "content_sanskrit": "व्यतिक्रान्तासु वर्षासु समये गमनस्य च।\nपर्वतो मामुवाचेदं काले वचनमर्थवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2072323, "chapter_id": 2525, "verse_number": "१२-३०-७", "content_sanskrit": "आवामस्य नरेन्द्रस्य गृहे परमपूजितौ।\nउषितौ समये ब्रह्मंस्तद्विचिन्तय सांप्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2072324, "chapter_id": 2525, "verse_number": "१२-३०-८", "content_sanskrit": "ततोऽहमब्रुवं राजन्पर्वतं सुभदर्शनम्।\nसर्वमेतत्त्वयि विभो भागिनेयोपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2072325, "chapter_id": 2525, "verse_number": "१२-३०-९", "content_sanskrit": "वरेण च्छन्द्यतां राजा लभतां यद्यदिच्छति।\nआवयोस्तपसा सिद्धिं प्राप्नोतु यदि मन्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2072326, "chapter_id": 2525, "verse_number": "१२-३०-१०", "content_sanskrit": "तत आहूय राजानं सृञ्जयं जयतां वरम्।\nपर्वतोऽनुमतो वाक्यमुवाच कुरुपुङ्गव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2072327, "chapter_id": 2525, "verse_number": "१२-३०-११", "content_sanskrit": "प्रीतौ स्वो नृप सत्कारैर्भवदार्जवसंभृतैः।\nआवाभ्यामभ्यनुज्ञातो वरं नृवर चिन्तय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2072328, "chapter_id": 2525, "verse_number": "१२-३०-१२", "content_sanskrit": "देवानामविहिंसायां न भवेन्मानुषे क्षमम्।\nतद्गृहाण महाराज पूजार्हो नौ मतो भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2072329, "chapter_id": 2525, "verse_number": "१२-३०-१३x", "content_sanskrit": "सृञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2072330, "chapter_id": 2525, "verse_number": "१२-३०-१३", "content_sanskrit": "प्रीतौ भवन्तौ यदि मे कृतमेतावता मम।\nएष एव परो लाभो निर्वृत्तो मे महाफलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2072331, "chapter_id": 2525, "verse_number": "१२-३०-१४", "content_sanskrit": "तमेवंवादिनं भूयः पर्वतः प्रत्यभाषत।\nशृणु राजन्सुसंकल्पं यत्ते हृदि चिरं स्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2072332, "chapter_id": 2525, "verse_number": "१२-३०-१५", "content_sanskrit": "अभीप्ससि सुतं वीरं वीर्यवन्तं दृढव्रतम्।\nआयुष्मतं महाभागं देवराजसमद्युतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2072333, "chapter_id": 2525, "verse_number": "१२-३०-१६", "content_sanskrit": "भविष्यत्येष ते कामो न त्वायुष्मान्भविष्यति।\nदेवराजाभिभूत्यर्थं संकल्पो ह्ये ते हृदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2072334, "chapter_id": 2525, "verse_number": "१२-३०-१७", "content_sanskrit": "सुवर्णष्ठीवनाच्चैव स्वर्णष्ठीवी भविष्यति।\nरक्ष्यश्च देवराजात्स देवराजसमद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2072335, "chapter_id": 2525, "verse_number": "१२-३०-१८", "content_sanskrit": "तच्छ्रुत्वा सृञ्जयो वाक्यं पर्वतस्य महात्मनः।\nप्रसादयामास तदा नैतदेवं भवेदिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2072336, "chapter_id": 2525, "verse_number": "१२-३०-१९", "content_sanskrit": "आयुष्मान्मे भवेत्पुत्रो भवतोस्तपस मुन।\nन च तं पर्वतः किंचिदुवाचेन्द्रव्यपेक्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2072337, "chapter_id": 2525, "verse_number": "१२-३०-२०", "content_sanskrit": "तमहं नृपतिं दीनमब्रवं पुनरेव च।\nस्मर्तव्योऽस्मि महाराज दर्शयिष्यामि ते सुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2072338, "chapter_id": 2525, "verse_number": "१२-३०-२१", "content_sanskrit": "अहं ते दयितं पुत्रं प्रेतराजवशं गतम्।\nपुनर्दास्यामि तद्रूपं मा शुचः पृथिवीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2072339, "chapter_id": 2525, "verse_number": "१२-३०-२२", "content_sanskrit": "एवमुक्त्वा तु नृपतिं प्रयातौ स्वो यथेप्सितम्।\nसृञ्जयश्च यथाकामं प्रविवेश स्वमन्दिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2072340, "chapter_id": 2525, "verse_number": "१२-३०-२३", "content_sanskrit": "सृञ्जयस्याथ राजर्षेः कस्मिंश्चित्कालपर्यये।\nजज्ञे पुत्रो महावीर्यस्तेजसा प्रज्वलन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2072341, "chapter_id": 2525, "verse_number": "१२-३०-२४", "content_sanskrit": "ववृधे स यथाकालं सरसीव महोत्पलम्।\nबभूव काञ्चनष्ठीवी यथार्थं नाम तस्य तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2072342, "chapter_id": 2525, "verse_number": "१२-३०-२५", "content_sanskrit": "तदद्भुततमं लोके पप्रथे कुरुसत्तम।\nबुबुधे तच्च देवेन्द्रो वरदानं मनीषिणोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2072343, "chapter_id": 2525, "verse_number": "१२-३०-२६", "content_sanskrit": "ततः स्वाभिभवाद्भीतो बृहस्पतिमते स्थितः।\nकुमारस्यान्तरप्रेक्षी नित्यमेवाभ्यवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2072344, "chapter_id": 2525, "verse_number": "१२-३०-२७", "content_sanskrit": "चोदयामास तद्वज्रं दिव्यास्रं मूर्तिमत्स्थ्रितम्।\nव्याघ्रो भूत्वा जहीमं त्वं राजपुत्रमिति प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2072345, "chapter_id": 2525, "verse_number": "१२-३०-२८", "content_sanskrit": "प्रवृद्धः किल वीर्येण मामेषोऽभिभविष्यति।\nसृञ्जयस्य सुतो वज्र यथैनं पर्वतोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2072346, "chapter_id": 2525, "verse_number": "१२-३०-२९", "content_sanskrit": "एवमुक्तस्तु शक्रेण वज्रः परपुरंजयः।\nकुमारमन्तरप्रेक्षी नित्यमेवान्वपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2072347, "chapter_id": 2525, "verse_number": "१२-३०-३०", "content_sanskrit": "सृञ्जयोऽपि सुतं प्राप्य देवराजसमद्युतिम्।\nहृष्टः सान्तः पुरो राजा वननित्यो बभूव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2072348, "chapter_id": 2525, "verse_number": "१२-३०-३१", "content_sanskrit": "ततो भागीरथीतीरे कदाचिन्निर्जने वने।\nधात्रीद्वितीयो बालः स क्रीडार्थं पर्यधावत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2072349, "chapter_id": 2525, "verse_number": "१२-३०-३२", "content_sanskrit": "पञ्चवर्षकदेशीयो बालो नागेन्द्रविक्रमः।\nसहसोत्पतितं व्याघ्रमाससाद महाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2072350, "chapter_id": 2525, "verse_number": "१२-३०-३३", "content_sanskrit": "स बालस्तेन निष्पिष्टो वेपमानो नृपात्मजः।\nव्यसुः पपात मेदिन्यां ततो धात्री विचुक्रुशे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2072351, "chapter_id": 2525, "verse_number": "१२-३०-३४", "content_sanskrit": "हत्वा तु राजपुत्रं स तत्रैवान्तरधीयत।\nशार्दूलो देवराजस्य माययान्तर्हितस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2072352, "chapter_id": 2525, "verse_number": "१२-३०-३५", "content_sanskrit": "धात्र्यास्तु निनदं श्रुत्वा रुदत्याः परमार्तवत्।\nअभ्यधावत तं देशं स्वयमेव महीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2072353, "chapter_id": 2525, "verse_number": "१२-३०-३६", "content_sanskrit": "स ददर्श शयानं तं गतासुं पीतशोणितम्।\nकुमारं विगतानन्दं निशाकरमिव च्युतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2072354, "chapter_id": 2525, "verse_number": "१२-३०-३७", "content_sanskrit": "स तमुत्सङ्गमारोप्य परिपीडितवक्षसम्।\nपुत्रं रुधिरसंसिक्तं पर्यदेवयदातुरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2072355, "chapter_id": 2525, "verse_number": "१२-३०-३८", "content_sanskrit": "ततस्ता मातरस्तस्य रुदत्यः शोककर्शिताः।\nअभ्यधावन्त तं देशं यत्र राजा स सृञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2072356, "chapter_id": 2525, "verse_number": "१२-३०-३९", "content_sanskrit": "ततः स राजा सस्मार मामेव गतमानसः।\nतदाऽहं चिन्तनं ज्ञात्वा गतवांस्तस्य दर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2072357, "chapter_id": 2525, "verse_number": "१२-३०-४०", "content_sanskrit": "मयैतानि च वाक्यानि श्रावितः शोकलालसः।\nयानि ते यदुवीरेण कथितानि महीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2072358, "chapter_id": 2525, "verse_number": "१२-३०-४१", "content_sanskrit": "संजीवितश्चापि पुनर्वासवानुमते तदा।\nभवितव्यं तथा तच्च न तच्छक्यमतोऽन्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2072359, "chapter_id": 2525, "verse_number": "१२-३०-४२", "content_sanskrit": "तत ऊर्ध्वं कुमारस्तु स्वर्णष्ठीवी महायशाः।\nचित्तं प्रसादयामास पितृर्मातुश्च वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2072360, "chapter_id": 2525, "verse_number": "१२-३०-४३", "content_sanskrit": "कारयामास राज्यं च पितरि स्वर्गते नृप।\nवर्षाणां शतमेकं च सहस्रं भीमविक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2072361, "chapter_id": 2525, "verse_number": "१२-३०-४४", "content_sanskrit": "तत ईजे महायज्ञैर्बहुभिर्भूरिदक्षिणैः।\nतर्पयामास देवांश्च पितॄंश्चैव महाद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2072362, "chapter_id": 2525, "verse_number": "१२-३०-४५", "content_sanskrit": "उत्पाद्य च बहून्पुत्रान्कुलसतानकारिणः।\nकालेन महता राजन्कालधर्ममुपेयिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2072363, "chapter_id": 2525, "verse_number": "१२-३०-४६", "content_sanskrit": "स त्वं राजेन्द्र संजातं शोकमेकं निवर्तय।\nयथा त्वं केशवः प्राह व्यामश्च सुमहातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2072364, "chapter_id": 2525, "verse_number": "१२-३०-४७", "content_sanskrit": "पितृपैतामहं राज्यमास्थाय धुरमुद्वह।\nइष्ट्वा पुण्यैर्महायज्ञैरिष्टं लोकमवाप्स्यसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2072365, "chapter_id": 2525, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि त्रिंशोऽध्यायः॥ ३०॥*", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]