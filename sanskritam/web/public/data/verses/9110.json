[{"id": 5000110000, "chapter_id": 9110, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे त्रयस्त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000110001, "chapter_id": 9110, "verse_number": "२-३३-१", "content_sanskrit": "दत्त्वा तु सह वैदेह्या ब्राह्मणेभ्यो धनं बहु।\nजग्मतुः पितरं द्रष्टुं सीतया सह राघवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000110002, "chapter_id": 9110, "verse_number": "२-३३-२", "content_sanskrit": "ततो गृहीते प्रेष्याभ्यामशोभेतां तदायुधे।\nमालादामभिरासक्ते सीतया समलंकृते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000110003, "chapter_id": 9110, "verse_number": "२-३३-३", "content_sanskrit": "ततः प्रासादहर्म्याणि विमानशिखराणि च।\nअभिरुह्य जनः श्रीमानुदासीनो व्यलोकयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000110004, "chapter_id": 9110, "verse_number": "२-३३-४", "content_sanskrit": "न हि रथ्याः सुशक्यन्ते गन्तुं बहुजनाकुलाः।\nआरुह्य तस्मात् प्रासादाद् दीनाः पश्यन्ति राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000110005, "chapter_id": 9110, "verse_number": "२-३३-५", "content_sanskrit": "पदातिं सानुजं दृष्ट्वा ससीतं च जनास्तदा।\nऊचुर्बहुजना वाचः शोकोपहतचेतसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000110006, "chapter_id": 9110, "verse_number": "२-३३-६", "content_sanskrit": "यं यान्तमनुयाति स्म चतुरङ्गबलं महत्।\nतमेकं सीतया सार्धमनुयाति स्म लक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000110007, "chapter_id": 9110, "verse_number": "२-३३-७", "content_sanskrit": "ऐश्वर्यस्य रसज्ञः सन् कामानां चाकरो महान्।\nनेच्छत्येवानृतं कर्तुं वचनं धर्मगौरवात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000110008, "chapter_id": 9110, "verse_number": "२-३३-८", "content_sanskrit": "या न शक्या पुरा द्रष्टुं भूतैराकाशगैरपि।\nतामद्य सीतां पश्यन्ति राजमार्गगता जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000110009, "chapter_id": 9110, "verse_number": "२-३३-९", "content_sanskrit": "अङ्गरागोचितां सीतां रक्तचन्दनसेविनीम्।\nवर्षमुष्णं च शीतं च नेष्यत्याशु विवर्णताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000110010, "chapter_id": 9110, "verse_number": "२-३३-१०", "content_sanskrit": "अद्य नूनं दशरथः सत्त्वमाविश्य भाषते।\nनहि राजा प्रियं पुत्रं विवासयितुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000110011, "chapter_id": 9110, "verse_number": "२-३३-११", "content_sanskrit": "निर्गुणस्यापि पुत्रस्य कथं स्याद् विनिवासनम्।\nकिं पुनर्यस्य लोकोऽयं जितो वृत्तेन केवलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000110012, "chapter_id": 9110, "verse_number": "२-३३-१२", "content_sanskrit": "आनृशंस्यमनुक्रोशः श्रुतं शीलं दमः शमः।\nराघवं शोभयन्त्येते षड्गुणाः पुरुषर्षभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000110013, "chapter_id": 9110, "verse_number": "२-३३-१३", "content_sanskrit": "तस्मात् तस्योपघातेन प्रजाः परमपीडिताः।\nऔदकानीव सत्त्वानि ग्रीष्मे सलिलसंक्षयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000110014, "chapter_id": 9110, "verse_number": "२-३३-१४", "content_sanskrit": "पीडया पीडितं सर्वं जगदस्य जगत्पतेः।\nमूलस्येवोपघातेन वृक्षः पुष्पफलोपगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000110015, "chapter_id": 9110, "verse_number": "२-३३-१५", "content_sanskrit": "मूलं ह्येष मनुष्याणां धर्मसारो महाद्युतिः।\nपुष्पं फलं च पत्रं च शाखाश्चास्येतरे जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000110016, "chapter_id": 9110, "verse_number": "२-३३-१६", "content_sanskrit": "ते लक्ष्मण इव क्षिप्रं सपत्न्यः सहबान्धवाः।\nगच्छन्तमनुगच्छामो येन गच्छति राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000110017, "chapter_id": 9110, "verse_number": "२-३३-१७", "content_sanskrit": "उद्यानानि परित्यज्य क्षेत्राणि च गृहाणि च।\nएकदुःखसुखा राममनुगच्छाम धार्मिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000110018, "chapter_id": 9110, "verse_number": "२-३३-१८", "content_sanskrit": "समुद‍्धृतनिधानानि परिध्वस्ताजिराणि च।\nउपात्तधनधान्यानि हृतसाराणि सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000110019, "chapter_id": 9110, "verse_number": "२-३३-१९", "content_sanskrit": "रजसाभ्यवकीर्णानि परित्यक्तानि दैवतैः।\nमूषकैः परिधावद्भिरुद‍‍्बिलैरावृतानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000110020, "chapter_id": 9110, "verse_number": "२-३३-२०", "content_sanskrit": "अपेतोदकधूमानि हीनसम्मार्जनानि च।\nप्रणष्टबलिकर्मेज्यामन्त्रहोमजपानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000110021, "chapter_id": 9110, "verse_number": "२-३३-२१", "content_sanskrit": "दुष्कालेनेव भग्नानि भिन्नभाजनवन्ति च।\nअस्मत्त्यक्तानि कैकेयी वेश्मानि प्रतिपद्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000110022, "chapter_id": 9110, "verse_number": "२-३३-२२", "content_sanskrit": "वनं नगरमेवास्तु येन गच्छति राघवः।\nअस्माभिश्च परित्यक्तं पुरं सम्पद्यतां वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000110023, "chapter_id": 9110, "verse_number": "२-३३-२३", "content_sanskrit": "बिलानि दंष्ट्रिणः सर्वे सानूनि मृगपक्षिणः।\nत्यजन्त्वस्मद्भयाद्भीता गजाः सिंहा वनान्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000110024, "chapter_id": 9110, "verse_number": "२-३३-२४", "content_sanskrit": "अस्मत्त्यक्तं प्रपद्यन्तु सेव्यमानं त्यजन्तु च।\nतृणमांसफलादानां देशं व्यालमृगद्विजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000110025, "chapter_id": 9110, "verse_number": "२-३३-२५", "content_sanskrit": "प्रपद्यतां हि कैकेयी सपुत्रा सह बान्धवैः।\nराघवेण वयं सर्वे वने वत्स्याम निर्वृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000110026, "chapter_id": 9110, "verse_number": "२-३३-२६", "content_sanskrit": "इत्येवं विविधा वाचो नानाजनसमीरिताः।\nशुश्राव राघवः श्रुत्वा न विचक्रेऽस्य मानसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000110027, "chapter_id": 9110, "verse_number": "२-३३-२७", "content_sanskrit": "स तु वेश्म पुनर्मातुः कैलासशिखरप्रभम्।\nअभिचक्राम धर्मात्मा मत्तमातङ्गविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000110028, "chapter_id": 9110, "verse_number": "२-३३-२८", "content_sanskrit": "विनीतवीरपुरुषं प्रविश्य तु नृपालयम्।\nददर्शावस्थितं दीनं सुमन्त्रमविदूरतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000110029, "chapter_id": 9110, "verse_number": "२-३३-२९", "content_sanskrit": "प्रतीक्षमाणोऽभिजनं तदार्त-\nमनार्तरूपः प्रहसन्निवाथ।\nजगाम रामः पितरं दिदृक्षुः\nपितुर्निदेशं विधिवच्चिकीर्षुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000110030, "chapter_id": 9110, "verse_number": "२-३३-३०", "content_sanskrit": "तत्पूर्वमैक्ष्वाकसुतो महात्मा\nरामो गमिष्यन् नृपमार्तरूपम्।\nव्यतिष्ठत प्रेक्ष्य तदा सुमन्त्रं\nपितुर्महात्मा प्रतिहारणार्थम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000110031, "chapter_id": 9110, "verse_number": "२-३३-३१", "content_sanskrit": "पितुर्निदेशेन तु धर्मवत्सलो\nवनप्रवेशे कृतबुद्धिनिश्चयः।\nस राघवः प्रेक्ष्य सुमन्त्रमब्रवी-\nन्निवेदयस्वागमनं नृपाय मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000110032, "chapter_id": 9110, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे त्रयस्त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]