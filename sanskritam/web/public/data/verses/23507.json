[{"id": 7003507000, "chapter_id": 23507, "verse_number": "१४७-१", "content_sanskrit": "अथ गोनिष्क्रमणमाहात्म्यम् ।\nधरण्युवाच ।\nअत्याश्चर्यं श्रुतं ह्येतद्रुरुक्षेत्रसमुद्भवम् ।\nहृषीकेशस्य महिमा त्वया य उपवर्णितः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003507001, "chapter_id": 23507, "verse_number": "१४७-२", "content_sanskrit": "अन्यच्च यत्परं गुह्यं क्षेत्रं परमपावनम् ।\nवक्तुमर्हसि देवेश परं कौतूहलं मम ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003507002, "chapter_id": 23507, "verse_number": "१४७-३", "content_sanskrit": "श्रीवराह उवाच ।\nशृणु भूमे प्रयत्नेन कारणं परमं मम ।\nगुह्यमस्त्यपरं चैव हिमशृङ्ग शिलोच्चये ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003507003, "chapter_id": 23507, "verse_number": "१४७-४", "content_sanskrit": "गोनिष्क्रमणकं नाम गावो यत्र प्रतारिताः ।\nयथा निष्क्रमणं प्राप्य सुरभीणां वसुन्धरे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003507004, "chapter_id": 23507, "verse_number": "१४७-५", "content_sanskrit": "सप्ततिर्यत्र कल्पानि और्वो यत्र प्रजापतिः ।\nतपश्चचार परमं मम मायाबलान्वितः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003507005, "chapter_id": 23507, "verse_number": "१४७-६", "content_sanskrit": "तस्यैवं वर्त्तमानस्य याति काले महत्तरे ।\nएवं हि तप्यमानस्य सर्वलोकस्य संशयः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003507006, "chapter_id": 23507, "verse_number": "१४७-७", "content_sanskrit": "न वरं प्रार्थयत्येष लाभालाभसमन्वितः ।\nसूचकोऽपि न विद्येत बलिकर्मसु संयतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003507007, "chapter_id": 23507, "verse_number": "१४७-८", "content_sanskrit": "अथ दीर्घस्य कालस्य कश्चिद्ब्रह्मयतिस्तदा ।\nतपस्तपस्यति मुनौ तस्मिन्शैलोच्चये धरे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003507008, "chapter_id": 23507, "verse_number": "१४७-९", "content_sanskrit": "ईश्वरोऽपि महाभागे तत्पार्श्वं समुपागतः ।\nगोनिष्क्रमेति विख्याते तस्मिंस्तीर्थे महौजसि ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003507009, "chapter_id": 23507, "verse_number": "१४७-१०", "content_sanskrit": "तत्र त्वौर्वो महाभागे तप्यते समदर्शनः ।\nपद्मानां कारणादौर्वो गंगाद्वारमुपागतः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003507010, "chapter_id": 23507, "verse_number": "१४७-११", "content_sanskrit": "तन्निर्गतं ततो ज्ञात्वा और्वं सर्वे तपस्विनः ।\nमहेश्वरो महातेजाः सम्भ्रमात्समुपागतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003507011, "chapter_id": 23507, "verse_number": "१४७-१२", "content_sanskrit": "फलपुष्पसमाकीर्णा लक्ष्मीश्चैवोपजायते ।\nआश्रमं रूपसम्पन्नं फलपुष्पोपशोभितम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003507012, "chapter_id": 23507, "verse_number": "१४७-१३", "content_sanskrit": "तच्च वै भस्मसाद्भूतं  महारुद्रस्य तेजसा ।\nदग्ध्वा तं चाश्रमं पुण्यमौरवस्य सुमहत्प्रियम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003507013, "chapter_id": 23507, "verse_number": "१४७-१४", "content_sanskrit": "ईश्वरोऽपि ततः प्राप्तः शीघ्रमेव हिमालयम् ।\nएतस्मिन्नन्तरे देवि गृह्य पुष्पकरण्डकम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003507014, "chapter_id": 23507, "verse_number": "१४७-१५", "content_sanskrit": "आश्रमं समनुप्राप्त और्वोऽपि मुनिपुंगवः ।\nशान्तो दान्तः क्षमाशीलः सत्यव्रतपरायणः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003507015, "chapter_id": 23507, "verse_number": "१४७-१६", "content_sanskrit": "दृष्ट्वा स्वमाश्रमं दग्धं बहुपुष्पफलोदकम् ।\nमन्युना परमाविष्टो दुःखनेत्रपरिप्लुतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003507016, "chapter_id": 23507, "verse_number": "१४७-१७", "content_sanskrit": "उवाच क्रोधरक्ताक्षो वचनं निर्दहन्निव ।\nयेनैष चाश्रमो दग्धो बहुपुष्पफलोदकः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003507017, "chapter_id": 23507, "verse_number": "१४७-१८", "content_sanskrit": "सोऽपि दुःखेन सन्तप्तः सर्वलोकान्भ्रमिष्यति ।\nएवमौर्वेण दत्ते तु शापे तस्मिन्महौजसि ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003507018, "chapter_id": 23507, "verse_number": "१४७-१९", "content_sanskrit": "महाभयात्तु लोकानां न कश्चित्पर्यवारयत् ।\nतत्क्षणादेव देवेशि ईशोऽपि जगतो विभुः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003507019, "chapter_id": 23507, "verse_number": "१४७-२०", "content_sanskrit": "महादाहेन सन्तप्तः शम्भुर्देवीमुवाच ह ।\nऔर्वस्य तु तपो दृष्ट्वा भीतैर्देवैरुदाहृतम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003507020, "chapter_id": 23507, "verse_number": "१४७-२१", "content_sanskrit": "दह्यते स्म जगत्सर्वं स तु किञ्चिन्न चेच्छति ।\nको वा प्रति विधिस्तत्र यथा सर्वस्य सम्भवेत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003507021, "chapter_id": 23507, "verse_number": "१४७-२२", "content_sanskrit": "एवमुक्ते मया क्रोधादीक्षितस्तस्य चाश्रमः ।\nदग्धोऽभवत्क्षणेनैव वयं तस्माद्विनिर्गताः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003507022, "chapter_id": 23507, "verse_number": "१४७-२३", "content_sanskrit": "एतद्दुःखेन सन्तप्तो मन्युना च परिप्लुतः ।\nऔर्वः शशाप रोषेण तेन तप्ता वयं शिवे ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003507023, "chapter_id": 23507, "verse_number": "१४७-२४", "content_sanskrit": "ततोऽभ्रमद्विरूपाक्षः शं न प्राप्नोति कर्हिचित् ।\nअहं च परितप्तोऽस्मि आत्मत्वादीश्वरस्य च ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003507024, "chapter_id": 23507, "verse_number": "१४७-२५", "content_sanskrit": "तेन दाहेन सन्तप्तो न शक्नोमि विचेष्टितुम् ।\nपार्वत्या च ततः प्रोक्तः आवां नारायणं प्रति ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003507025, "chapter_id": 23507, "verse_number": "१४७-२६", "content_sanskrit": "गच्छावस्तस्य वाक्येन सुखं यत्र भविष्यति ।\nततो नारायणं गत्वा सह तेन तमौर्वकम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003507026, "chapter_id": 23507, "verse_number": "१४७-२७", "content_sanskrit": "विज्ञापयामो रुद्रस्य शापोऽयं विनिवर्त्तताम् ।\nसन्तप्ताः स्म वयं सर्वे तस्माच्छापं निवर्त्तय ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003507027, "chapter_id": 23507, "verse_number": "१४७-२८", "content_sanskrit": "और्वोऽप्युवाच नोक्तं मे अनृतं तु कदाचन ।\nसुरभीगणमानीय गत्वैतं स्नापयन्तु वै ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003507028, "chapter_id": 23507, "verse_number": "१४७-२९", "content_sanskrit": "रुद्रशापो निवृत्तः स्यात्तेनैव किल नान्यथा ।\nएतस्मिन्नन्तरे देवि मया गावोऽवतारिताः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003507029, "chapter_id": 23507, "verse_number": "१४७-३०", "content_sanskrit": "सप्तसप्ततिः कल्याणि सौरभेया महौजसः ।\nतेनाप्लावितदेहाश्च परां निर्वृतिमागताः  ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003507030, "chapter_id": 23507, "verse_number": "१४७-३१", "content_sanskrit": "तच्च गोनिष्क्रमं नाम तीर्थं परमपावनम् ।\nतत्र स्नानं तु कुर्वीत एकरात्रोषितो नरः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003507031, "chapter_id": 23507, "verse_number": "१४७-३२", "content_sanskrit": "गोलोकं च समासाद्य मोदते नात्र संशयः ।\nअथात्र मुञ्चते प्राणान्कृत्वा कर्म सुदुष्करम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003507032, "chapter_id": 23507, "verse_number": "१४७-३३", "content_sanskrit": "शंखचक्रगदायुक्तो मम लोके महीयते ।\nपंच धाराः पतन्त्यत्र मूले मूलवटस्य हि ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003507033, "chapter_id": 23507, "verse_number": "१४७-३४", "content_sanskrit": "तत्र स्नानं प्रकुर्वीत पंचरात्रोषितो नरः ।\nपंचानामपि यज्ञानां फलमाप्नोति मानवः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003507034, "chapter_id": 23507, "verse_number": "१४७-३५", "content_sanskrit": "अथात्र मुञ्चते प्राणान्कृत्वा कर्म सुदुष्करम् ।\nपंचयज्ञफलं भुक्त्वा मम लोकं प्रपद्यते ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003507035, "chapter_id": 23507, "verse_number": "१४७-३६", "content_sanskrit": "अस्ति पंचपदं नाम तस्मिन्क्षेत्रे परं मम ।\nमम पूर्वेण पार्श्वेण दृढाः पंच महाशिलाः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003507036, "chapter_id": 23507, "verse_number": "१४७-३७", "content_sanskrit": "मत्पूर्वां दिशमाश्रित्य तत्र ब्रह्मपदद्वयम् ।\nमध्ये तु तस्य कुण्डस्य शिला विस्तीर्णसंश्रिता ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003507037, "chapter_id": 23507, "verse_number": "१४७-३८", "content_sanskrit": "ऊर्द्ध्वं नालपरीणाहं तत्र विष्णुपदं मम ।\nतत्र स्नानं तु कुर्वीत पंचरात्रोषितो नरः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003507038, "chapter_id": 23507, "verse_number": "१४७-३९", "content_sanskrit": "यांति शुद्धांस्तु लोकांस्ते ये च भागवतप्रियाः ।\nअथात्र मुञ्चते प्राणान्युक्तः पञ्चपदे नरः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003507039, "chapter_id": 23507, "verse_number": "१४७-४०", "content_sanskrit": "विमुक्तः सर्वसंसारान्मम लोकं च गच्छति ।\nततो ब्रह्मपदं नाम क्षेत्रं गुह्यं परं मम ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003507040, "chapter_id": 23507, "verse_number": "१४७-४१", "content_sanskrit": "यत्र धारा पतत्येका पश्चिमां दिशमाश्रिता ।\nतत्र स्नानं तु कुर्वीत एकरात्रोषितो नरः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003507041, "chapter_id": 23507, "verse_number": "१४७-४२", "content_sanskrit": "ब्रह्मलोकमवाप्नोति ब्रह्मणा सह मोदते ।\nकौमुदस्य तु मासस्य शुक्लपक्षस्य द्वादशी ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003507042, "chapter_id": 23507, "verse_number": "१४७-४३", "content_sanskrit": "यज्ञानां वाजपेयानां फलं प्राप्नोति मानवः ।\nअथात्र मुंचते प्राणान्मम कर्मसु निष्ठितः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003507043, "chapter_id": 23507, "verse_number": "१४७-४४", "content_sanskrit": "वाजपेयफलं भुक्त्वा मम लोकं प्रपद्यते ।\nअस्ति कोटिवटं नाम तस्मिन् क्षेत्रे परं मम ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003507044, "chapter_id": 23507, "verse_number": "१४७-४५", "content_sanskrit": "पंचक्रोशं ततो गत्वा वायव्यां दिशि संस्थितः ।\nतत्र स्नानं तु कुर्वीत षष्ठकालोषितो नरः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003507045, "chapter_id": 23507, "verse_number": "१४७-४६", "content_sanskrit": "बहुयज्ञस्य कोटीनां फलं प्राप्नोति निष्कलम् ।\nअथात्र मुंचते प्राणान्भूमे कोटिवटे शुभे ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003507046, "chapter_id": 23507, "verse_number": "१४७-४७", "content_sanskrit": "यज्ञकोटिफलं भुक्त्वा मम कोटिं प्रपद्यते ।\nअस्ति विष्णुसरो नाम तस्मिन् क्षेत्रे परं मम ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003507047, "chapter_id": 23507, "verse_number": "१४७-४८", "content_sanskrit": "पूर्वोत्तरेण पार्श्वेन पंचक्रोशं न संशयः ।\nमत्सरः पद्मपत्राक्षि आगाधं परिसंस्थितम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003507048, "chapter_id": 23507, "verse_number": "१४७-४९", "content_sanskrit": "पंचक्रोशश्च विस्तारः पर्वतः परिमण्डलः ।\nतत्र भ्रमति यो भद्रे कुर्याच्चैव प्रदक्षिणम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003507049, "chapter_id": 23507, "verse_number": "१४७-५०", "content_sanskrit": "उपवासं त्रिरात्रं तु कृत्वा कर्म सुदुष्करम् ।\nयावन्ति भ्रममाणस्य पदानि ननु सुन्दरि ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003507050, "chapter_id": 23507, "verse_number": "१४७-५१", "content_sanskrit": "तावद्वर्षसहस्राणि ब्रह्मलोके महीयते ।\nअथाऽत्र मुंचते प्राणान्स्वकर्मपरिनिष्ठितः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003507051, "chapter_id": 23507, "verse_number": "१४७-५२", "content_sanskrit": "ब्रह्मलोकं समुत्सृज्य मम लोके महीयते ।\nतस्मिन् क्षेत्रे महाभागे आश्चर्यं शृणु सुन्दरि ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003507052, "chapter_id": 23507, "verse_number": "१४७-५३", "content_sanskrit": "गवां वै श्रूयते शब्दो मम कर्मसुखावहः ।\nअथात्र ज्येष्ठमासस्य शुक्लपक्षस्य द्वादशी ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003507053, "chapter_id": 23507, "verse_number": "१४७-५४", "content_sanskrit": "श्रूयते सुमहाञ्छब्दः स्वयमेतन्न संशयः ।\nएवं गोस्थलके पुण्ये महाभागवतः शुचिः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003507054, "chapter_id": 23507, "verse_number": "१४७-५५", "content_sanskrit": "करोति शुभकर्माणि शीघ्रं मुच्येत किल्बिषात् ।\nएवं तेन महाभागे  ईश्वरेण यशस्विनि ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003507055, "chapter_id": 23507, "verse_number": "१४७-५६", "content_sanskrit": "शापदाहो विनिर्मुक्तः सर्वैः सह मरुद्गणैः।\nएतद्गोस्थलकं नाम सर्वशान्तिकरं परम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003507056, "chapter_id": 23507, "verse_number": "१४७-५७", "content_sanskrit": "कथितं देवि कार्त्स्न्येन तवानुग्रहकाम्यया।\nएषोऽध्यायो महाभागे सर्वमङ्गलकारकः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003507057, "chapter_id": 23507, "verse_number": "१४७-५८", "content_sanskrit": "मम मार्गानुसाराणां मम च प्रीतिवर्द्धनः ।\nश्रेष्ठानां परमं श्रेष्ठं मङ्गलानां च मङ्गलम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003507058, "chapter_id": 23507, "verse_number": "१४७-५९", "content_sanskrit": "लाभानां परमो लाभो धर्माणां धर्म उत्तमः ।\nलभन्ते पठमाना वै मम मार्गानुसारिणः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003507059, "chapter_id": 23507, "verse_number": "१४७-६०", "content_sanskrit": "तेजः श्रियं च लक्ष्मीं च सर्वकामान्यशस्विनि ।\nयावन्ति चाक्षराणि स्युरत्राध्याये मनस्विनि ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003507060, "chapter_id": 23507, "verse_number": "१४७-६१", "content_sanskrit": "तावद्वर्षसहस्राणि मम लोके महीयते ।\nपतनं च न विद्येत पठमानो दिने दिने ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003507061, "chapter_id": 23507, "verse_number": "१४७-६२", "content_sanskrit": "तारितानि कुलान्येभिः सप्त सप्त च सप्त च ।\nपिशुनाय न दातव्यं न मूर्खाय शठाय च ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003507062, "chapter_id": 23507, "verse_number": "१४७-६३", "content_sanskrit": "देयं पुत्राय शिष्याय यश्च जानाति सेवितुम् ।\nएतन्मरणकाले तु न कदाचित्तु विस्मरेत् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003507063, "chapter_id": 23507, "verse_number": "१४७-६४", "content_sanskrit": "श्लोकं वा यदि वा पादं यदीच्छेत्परमां गतिम् ।\nतत्क्षेत्रं तु महाभागे पंचयोजनमण्डलम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003507064, "chapter_id": 23507, "verse_number": "१४७-६५", "content_sanskrit": "तिष्ठामि परया प्रीत्या दिशं पूर्वामुपाश्रितः ।\nपश्चिमेन वहेद्गङ्गां निष्कामेन वसुन्धरे ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003507065, "chapter_id": 23507, "verse_number": "१४७-६६", "content_sanskrit": "एवं रहस्यं गुह्यं च सर्वकर्मसुखावहम् ।\nएतत्ते परमं भद्रे गुह्यं धर्मसमन्वितम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003507066, "chapter_id": 23507, "verse_number": "१४७-६७", "content_sanskrit": "मम क्षेत्रं महाभागे यत्त्वया परिपृच्छितम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}]