[{"id": 2005927, "chapter_id": 1116, "verse_number": "१-११७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2005928, "chapter_id": 1116, "verse_number": "१-११७-१", "content_sanskrit": "ततः स मुनिशार्दूलस्तानुवाच तपोधनान्।\nदोषतः कं गमिष्यामि न हि मेऽन्योपराध्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2005929, "chapter_id": 1116, "verse_number": "१-११७-२", "content_sanskrit": "तं दृष्ट्वा रक्षिणस्तत्र तथा बहुतिथेऽहनि।\nन्यवेदयंस्तथा राज्ञे यथावृत्तं नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2005930, "chapter_id": 1116, "verse_number": "१-११७-३", "content_sanskrit": "राजा च तमृषिं श्रुत्वा निष्क्रम्य सह मन्त्रिभिः।\nप्रसादयामास तदा शूलस्थमृषिसत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2005931, "chapter_id": 1116, "verse_number": "१-११७-४x", "content_sanskrit": "प्रजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2005932, "chapter_id": 1116, "verse_number": "१-११७-४", "content_sanskrit": "यन्मयाऽपकृतं मोहादज्ञानादृषिसत्तम।\nप्रसादये त्वां तत्राहं न मे त्वं क्रोद्धुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2005933, "chapter_id": 1116, "verse_number": "१-११७-५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2005934, "chapter_id": 1116, "verse_number": "१-११७-५", "content_sanskrit": "एवमुक्तस्ततो राज्ञा प्रसादमकरोन्मुनिः।\nकृतप्रसादं राजा तं ततः समवतारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2005935, "chapter_id": 1116, "verse_number": "१-११७-६", "content_sanskrit": "अवतार्य च शूलाग्रात्तच्छूलं निश्चकर्ष ह।\nअशक्नुवंश्च निष्क्रष्टुं शूलं मूले स चिच्छिदे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2005936, "chapter_id": 1116, "verse_number": "१-११७-७", "content_sanskrit": "स तथान्तर्गतेनैव शूलेन व्यचरन्मुनिः।\nकण्ठपार्श्वान्तरस्थेन शङ्कुना मुनिराचत्।\nपुष्पभाजनधारी स्यादिति चिन्तापरोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2005937, "chapter_id": 1116, "verse_number": "१-११७-८", "content_sanskrit": "स चातितपसा लोकान्विजिग्ये दुर्लभान्परैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2005938, "chapter_id": 1116, "verse_number": "१-११७-९", "content_sanskrit": "अणीमाण्डव्य इति च ततो लोकेषु गीयते।\nस गत्वा सदनं विप्रो धर्मस्य परमार्थवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2005939, "chapter_id": 1116, "verse_number": "१-११७-१०", "content_sanskrit": "आसनस्थं ततो धर्मं दृष्ट्वोपालभत प्रभुम्।\nकिं नु तद्दुष्कृतं कर्म मया कृतमजानता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2005940, "chapter_id": 1116, "verse_number": "१-११७-११", "content_sanskrit": "यस्येयं फलनिर्वृत्तिरीदृश्यासादिता मया।\nशीघ्रमाचक्ष्व मे तत्त्वं पश्य मे तपसो बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2005941, "chapter_id": 1116, "verse_number": "१-११७-१२x", "content_sanskrit": "धर्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2005942, "chapter_id": 1116, "verse_number": "१-११७-१२", "content_sanskrit": "पतङ्गिकानां पुच्छेषु त्वयेषीका प्रवेशिता।\nकर्मणस्तस्य ते प्राप्तं फलमेतत्तपोधन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2005943, "chapter_id": 1116, "verse_number": "१-११७-१३", "content_sanskrit": "स्वल्पमेव यथा दत्तं दानं बहुगुणं भवेत्।\nअधर्म एवं विप्रर्षे बहुदुःखफलप्रदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2005944, "chapter_id": 1116, "verse_number": "१-११७-१४x", "content_sanskrit": "अणीमाण्डव्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2005945, "chapter_id": 1116, "verse_number": "१-११७-१४", "content_sanskrit": "कस्मिन्काले मया तत्तु कृतं ब्रूहि यथातथम्।\nतेनोक्तं धर्मराजेन बालभावे त्वया कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2005946, "chapter_id": 1116, "verse_number": "१-११७-१५x", "content_sanskrit": "अणीमाण्डव्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2005947, "chapter_id": 1116, "verse_number": "१-११७-१५", "content_sanskrit": "बालो हि द्वादशाद्वर्षाज्जन्मतो यत्करिष्यति।\nन भविष्यत्यधर्मोऽत्र न प्रज्ञास्यति वै दिशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2005948, "chapter_id": 1116, "verse_number": "१-११७-१६", "content_sanskrit": "अल्पेऽपराधेऽपि महान्मम दण्डस्त्वया धृतः।\nगरीयान्ब्राह्मणवधः सर्वभूतवधादपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2005949, "chapter_id": 1116, "verse_number": "१-११७-१७", "content_sanskrit": "शूद्रयोनावतो धर्म मानुषः संभविष्यसि।\nमर्यादां स्थापयाम्यद्य लोके कर्मफलोदयाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2005950, "chapter_id": 1116, "verse_number": "१-११७-१८", "content_sanskrit": "आ चतुर्दशकाद्वर्षान्न भविष्यति पातकम्।\nपरतः कुर्वतामेव दोष एव भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2005951, "chapter_id": 1116, "verse_number": "१-११७-१९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2005952, "chapter_id": 1116, "verse_number": "१-११७-१९", "content_sanskrit": "एतेन त्वपराधेन शापात्तस्य महात्मनः।\nधर्मो विदुररूपेण शूद्रयोनावजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2005953, "chapter_id": 1116, "verse_number": "१-११७-२०", "content_sanskrit": "धर्मे चार्थे च कुशलो लोभक्रोधविवर्जितः।\nदीर्घदर्शी शमपरः कुरूणां च हिते रतः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2005954, "chapter_id": 1116, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि सप्तदशाधिकशततमोऽध्यायः॥ ११७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]