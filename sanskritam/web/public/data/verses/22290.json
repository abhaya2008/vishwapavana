[{"id": 7002290000, "chapter_id": 22290, "verse_number": "३३५-१", "content_sanskrit": "अग्निरुवाच ।\nछन्दोऽत्र सिद्धं गाथा स्यात् पादे सर्व्वगुरौ तथा ।\nप्रस्तार आद्यगाथोनः परतुल्योऽथ पूर्व्वगः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002290001, "chapter_id": 22290, "verse_number": "३३५-२", "content_sanskrit": "नष्टमध्ये समेऽङ्कोनः समेऽर्द्ध विषमे गुरुः ।\nप्रतिलोमगुणं नाद्यं द्विरुद्दिष्टग एकनुत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002290002, "chapter_id": 22290, "verse_number": "३३५-३", "content_sanskrit": "सङ्ख्याद्विरर्द्धे रूपे तु शून्यं शून्ये द्विरीरितं ।\nतावदर्द्धे तद्गुणितं द्वि द्व्यूनञ्च तदन्ततः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002290003, "chapter_id": 22290, "verse_number": "३३५-४", "content_sanskrit": "परे पूर्णं परे पूर्णं मेरुप्रस्तारतो भवेत् ।\nनगसंख्या वृत्तसंख्या चाध्वाङ्गुलमधोद्र्धतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002290004, "chapter_id": 22290, "verse_number": "३३५-५", "content_sanskrit": "सङ्ख्यैव द्विगुणैकोना छन्दः सारोऽथमीरितः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}]