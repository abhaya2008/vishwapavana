[{"id": 2148370, "chapter_id": 4211, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2148371, "chapter_id": 4211, "verse_number": "१", "content_sanskrit": "केशवस्य तु तद् वाक्यं कर्णः श्रुत्वा हितं शुभम् ।\nअब्रवीदभिसम्पूज्य कृष्णं तं मधुसूदनम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2148372, "chapter_id": 4211, "verse_number": "२", "content_sanskrit": "जानन् मां किं महाबाहो सम्मोहयितुमिच्छसि ।\nयोऽयं पृथिव्याः कार्त्स्न्येन विनाशः समुपस्थितः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2148373, "chapter_id": 4211, "verse_number": "३", "content_sanskrit": "निमित्तं तत्र शकुनिरहं दुःशासनस्तथा ।\nदुर्योधनश्च नृपतिः धृतराष्ट्रसुतोऽभवत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2148374, "chapter_id": 4211, "verse_number": "४", "content_sanskrit": "असंशयमिदं कृष्ण महद् युद्धमुपस्थितम् ।\nपाण्डवानां कुरूणां च घोरं रुधिरकर्दमम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2148375, "chapter_id": 4211, "verse_number": "५", "content_sanskrit": "राजानो राजपुत्राश्च दुर्योधनवशानुगाः ।\nरणे शस्त्राग्निना दग्धाः प्राप्स्यन्ति यमसादनम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2148376, "chapter_id": 4211, "verse_number": "६", "content_sanskrit": "स्वप्ना हि बहवो घोरा दृश्यन्ते मधुसूदन ।\nनिमित्तानि च घोराणि तथोत्पाताः सुदारुणाः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2148377, "chapter_id": 4211, "verse_number": "७", "content_sanskrit": "पराजयं धार्तराष्ट्रे विजयं च युधिष्ठिरे ।\nशंसन्त इव वार्ष्णेय विविधा रोमहर्षणाः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2148378, "chapter_id": 4211, "verse_number": "८", "content_sanskrit": "प्राजापत्यं हि नक्षत्रं ग्रहस्तीक्ष्णो महाद्युतिः ।\nशनैश्चरः पीडयति पीडयन् प्राणिनोऽधिकम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2148379, "chapter_id": 4211, "verse_number": "९", "content_sanskrit": "कृत्वा चाङ्गारको वक्रं ज्येष्ठायां मधुसूदन ।\nअनूराधां प्रार्थयते मैत्रं संशमयन्निव\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2148380, "chapter_id": 4211, "verse_number": "१०", "content_sanskrit": "नूनं महद्भयं कृष्ण कुरूणां समुपस्थितम् ।\nविशेषेण हि वार्ष्णेय चित्रां पीडयते ग्रहः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2148381, "chapter_id": 4211, "verse_number": "११", "content_sanskrit": "सोमस्य लक्ष्म व्यावृत्तं राहुरर्कमुपेष्यति ।\nदिवश्चोल्काः पतन्त्येताः सनिर्घाताः सकम्पनाः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2148382, "chapter_id": 4211, "verse_number": "१२", "content_sanskrit": "निष्टनन्ति च मातङ्गा मुञ्चन्त्यश्रूणि वाजिनः ।\nपानीयं यवसं चापि नाभिनन्दन्ति माधव\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2148383, "chapter_id": 4211, "verse_number": "१३", "content_sanskrit": "प्रादुर्भूतेषु चैतेषु भयमाहुरुपस्थितम् ।\nनिमित्तेषु महाबाहो दारुणं प्राणिनाशनम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2148384, "chapter_id": 4211, "verse_number": "१४", "content_sanskrit": "अल्पे भुक्ते पुरीषं च प्रभूतमिह दृश्यते ।\nवाजिनां वारणानां च मनुष्याणां च केशव\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2148385, "chapter_id": 4211, "verse_number": "१५", "content_sanskrit": "धार्तराष्ट्रस्य सैन्येषु सर्वेषु मधुसूदन ।\nपराभवस्य तल्लिङ्गमिति प्राहुर्मनीषिणः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2148386, "chapter_id": 4211, "verse_number": "१६", "content_sanskrit": "प्रहृष्टं वाहनं कृष्ण पाण्डवानां प्रचक्षते ।\nप्रदक्षिणा मृगाश्चैव तत् तेषां जयलक्षणम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2148387, "chapter_id": 4211, "verse_number": "१७", "content_sanskrit": "अपसव्या मृगाश्चैव धार्तराष्ट्रस्य केशव ।\nवाचश्चाप्यशरीरिण्यः तत् पराभवलक्षणम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2148388, "chapter_id": 4211, "verse_number": "१८", "content_sanskrit": "मयूराः पुण्यशकुना हंससारसचातकाः ।\nजीवञ्जीवकसङ्घाश्चाप्यनुगच्छन्ति पाण्डवान्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2148389, "chapter_id": 4211, "verse_number": "१९", "content_sanskrit": "गृध्राः कङ्का बकाः श्येना यातुधानास्तथा वृकाः ।\nमक्षिकाणां च सङ्घाता अनुधावन्ति कौरवान्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2148390, "chapter_id": 4211, "verse_number": "२०", "content_sanskrit": "धार्तराष्ट्रस्य सैन्येषु भेरीणां नास्ति निस्वनः ।\nअनाहताः पाण्डवानां नदन्ति पटहाः किल\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2148391, "chapter_id": 4211, "verse_number": "२१", "content_sanskrit": "उदपानाश्च नर्दन्ति तथा गोवृषभा इव ।\nधार्तराष्ट्रस्य सैन्येषु तत् पराभवलक्षणम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2148392, "chapter_id": 4211, "verse_number": "२२", "content_sanskrit": "मांसशोणितवर्षं च वृष्टं देवेन माधव ।\nतथा गन्धर्वनगरं भानुमत् समुपस्थितम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2148393, "chapter_id": 4211, "verse_number": "२३", "content_sanskrit": "सप्राकारं सपरिघं सवप्रं चारुतोरणम् ।\nकृष्णश्च परिधिस्तत्र भानुमावृत्य तिष्ठति\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2148394, "chapter_id": 4211, "verse_number": "२४", "content_sanskrit": "उदयास्तमये सन्ध्ये वेदयाने महद्भयम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2148395, "chapter_id": 4211, "verse_number": "२५", "content_sanskrit": "एकपादाक्षिचरणा नर्दन्तो घोरदर्शनाः ।\nवाश्यन्ते पक्षिणो घोरं तत् पराभवलक्षणम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2148396, "chapter_id": 4211, "verse_number": "२६", "content_sanskrit": "शिवा च वाशते घोरं तत् पराभवलक्षणम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2148397, "chapter_id": 4211, "verse_number": "२७", "content_sanskrit": "कृष्णग्रीवाश्च शकुना रक्तपादा भयानकाः ।\nसन्ध्यामभिमुखा यान्ति तत् पराभवलक्षणम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2148398, "chapter_id": 4211, "verse_number": "२८", "content_sanskrit": "ब्राह्मणान् प्रथमं द्वेष्टि गुरूंश्च मधुसूदन ।\nभृत्यान् भक्तिमतश्चापि तत् पराभवलक्षणम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2148399, "chapter_id": 4211, "verse_number": "२९", "content_sanskrit": "पूर्वा दिग् लोहिताकारा शस्त्रवर्णा च दक्षिणा ।\nआम्रपत्रप्रतीकाशा पश्चिमा मधुसूदन\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2148400, "chapter_id": 4211, "verse_number": "३०", "content_sanskrit": "उत्तरा शङ्खवर्णाभा दिशो वर्णा उदाहृताः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2148401, "chapter_id": 4211, "verse_number": "३१", "content_sanskrit": "प्रदीप्ताश्च दिशः सर्वा धार्तराष्ट्रस्य माधव ।\nमहद्भयं वेदयन्ति तस्मिन्नुत्पातलक्षणे\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2148402, "chapter_id": 4211, "verse_number": "३२", "content_sanskrit": "सहस्रपादं प्रासादं स्वप्नान्ते तु युधिष्ठिरः ।\nअधिरोहन् मया दृष्टः सह भ्रातृभिरच्युत\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2148403, "chapter_id": 4211, "verse_number": "३३", "content_sanskrit": "श्वेतोष्णीषाश्च दृश्यन्ते सर्वे च मधुसूदन ।\nआसनानि च शुभ्राणि सर्वे ते शुक्लवाससः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2148404, "chapter_id": 4211, "verse_number": "३४", "content_sanskrit": "तव चापि मया कृष्ण स्वप्नान्ते रुधिराविला ।\nआन्त्रेण पृथिवी दृष्टा परिक्षिप्ता जनार्दन\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2148405, "chapter_id": 4211, "verse_number": "३५", "content_sanskrit": "अस्थिसञ्चयमारूढः चामितौजा युधिष्ठिरः ।\nसुवर्णपात्र्यां संहृष्टो भुक्तवान् घृतपायसम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2148406, "chapter_id": 4211, "verse_number": "३६", "content_sanskrit": "युधिष्ठिरो मया दृष्टो ग्रसमानो वसुन्धराम् ।\nत्वया दत्तामिमां व्यक्तं भोक्ष्यते स वसुन्धराम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2148407, "chapter_id": 4211, "verse_number": "३७", "content_sanskrit": "उच्चपर्वतमारूढो भीमकर्मा वृकोदरः ।\nगदापाणिर्नरव्याघ्रो वीक्षन्निव महीमिमाम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2148408, "chapter_id": 4211, "verse_number": "३८", "content_sanskrit": "क्षपयिष्यति नः सर्वान् स सुव्यक्तं महारणे\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2148409, "chapter_id": 4211, "verse_number": "३९", "content_sanskrit": "विदितं मे हृषीकेश यतो धर्मस्ततो जयः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2148410, "chapter_id": 4211, "verse_number": "४०", "content_sanskrit": "पाण्डरं गजमारूढो गाण्डीवी स धनञ्जयः ।\nत्वया सार्धं हृषीकेश श्रिया परमया ज्वलन्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2148411, "chapter_id": 4211, "verse_number": "४१", "content_sanskrit": "यूयं सर्वे वधिष्यध्वं तत्र मे नास्ति संशयः ।\nपार्थिवान् समरे कृष्ण दुर्योधनवशानुगान्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2148412, "chapter_id": 4211, "verse_number": "४२", "content_sanskrit": "नकुलः सहदेवश्च सात्यकिश्च महारथः ।\nशुद्धकेयूरकण्ठास्तु शुक्लमाल्याम्बरावृताः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2148413, "chapter_id": 4211, "verse_number": "४३", "content_sanskrit": "अधिरूढा नरव्याघ्र नरवाहनमुत्तमम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2148414, "chapter_id": 4211, "verse_number": "४४", "content_sanskrit": "त्रय एते महामात्राः पाण्डरच्छत्रवाससः ।\nश्वेतोष्णीषाश्च दृश्यन्ते सर्वे माधव पाण्डवाः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2148415, "chapter_id": 4211, "verse_number": "४५", "content_sanskrit": "धार्तराष्ट्रेषु सैन्येषु तान् विजानीहि केशव ।\nअश्वत्थामा कृपश्चैव कृतवर्मा च सात्वतः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2148416, "chapter_id": 4211, "verse_number": "४६", "content_sanskrit": "रक्तोष्णीषाश्च दृश्यन्ते सर्वे माधव कौरवाः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2148417, "chapter_id": 4211, "verse_number": "४७", "content_sanskrit": "उष्ट्रप्रयुक्तमारूढौ भीष्मद्रोणौ जनार्दन\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2148418, "chapter_id": 4211, "verse_number": "४८", "content_sanskrit": "मया सार्धं महाबाहो धार्तराष्ट्रेण वै विभो ।\nअगस्त्यकान्तां च दिशं प्रयाताः स्म जनार्दन\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2148419, "chapter_id": 4211, "verse_number": "४९", "content_sanskrit": "अचिरेणैव कालेन प्राप्स्यामो यमसादनम् ।\nअहं चान्ये च राजानो यच्च तत् क्षत्रमण्डलम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2148420, "chapter_id": 4211, "verse_number": "५०", "content_sanskrit": "गाण्डीवाग्निं प्रवेक्ष्याम इति मे नात्र संशयः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2148421, "chapter_id": 4211, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2148422, "chapter_id": 4211, "verse_number": "५१", "content_sanskrit": "उपस्थितविनाशेयं नूनमद्य वसुन्धरा ।\nयथा हि मे वचः कर्ण नोपैति हदयं तव\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2148423, "chapter_id": 4211, "verse_number": "५२", "content_sanskrit": "सर्वेषां तात भूतानां विनाशे समुपस्थिते ।\nअनयो नयसङ्काशो हृदयान्नापसर्पति\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2148424, "chapter_id": 4211, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2148425, "chapter_id": 4211, "verse_number": "५३", "content_sanskrit": "अपि त्वां कृष्ण पश्यामो जीवन्तोऽस्मान्महारणात् ।\nसमुत्तीर्णा महाबाहो वीरक्षयमहाह्रदात्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2148426, "chapter_id": 4211, "verse_number": "५४", "content_sanskrit": "अथवा सङ्गमः कृष्ण स्वर्गे नो भविता ध्रुवम् ।\nतत्रेदानीं समेष्यामः पुनः सार्धं त्वयाऽनघ\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2148427, "chapter_id": 4211, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2148428, "chapter_id": 4211, "verse_number": "५५", "content_sanskrit": "इत्युक्त्वा माधवं कर्णः परिष्वज्य निपीड्य तम् ।\nविसर्जितः केशवेन रथोपस्थादवातरत्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2148429, "chapter_id": 4211, "verse_number": "५६", "content_sanskrit": "ततः स्वरथमास्थाय जाम्बूनदविभूषितम् ।\nमहात्मा वै निववृते राधेयो दीनमानसः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2148430, "chapter_id": 4211, "verse_number": "५७", "content_sanskrit": "ततः शीघ्रतरं प्रायात् केशवः सहसात्यकिः ।\nपुनरुच्चारयन् वाणीं याहि याहीति सात्यकिम्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2148431, "chapter_id": 4211, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि द्विचत्वारिंशोत्तरशततमोऽध्यायः ॥१४२॥\nविवादपर्वणि चतुर्थोऽध्यायः ॥४॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]