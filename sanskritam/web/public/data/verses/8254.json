[{"id": 900002117, "chapter_id": 8254, "verse_number": "11.1", "content_sanskrit": "ॐ पूर्णमदः पूर्णमिदं पूर्णात्पूर्णमुदच्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900002118, "chapter_id": 8254, "verse_number": "11.2", "content_sanskrit": "ॐ खं ब्रह्म खं पुराणं वायुरं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900002119, "chapter_id": 8254, "verse_number": "11.3", "content_sanskrit": "त्रयाः प्राजापत्याः प्रजापतौ पितरि ब्रह्मचर्यमूषुर्देवा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900002120, "chapter_id": 8254, "verse_number": "11.4", "content_sanskrit": "एष प्रजापतिर्यद्धृदयमेतद् ब्रह्मैतत् सत्यं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900002121, "chapter_id": 8254, "verse_number": "11.5", "content_sanskrit": "तद्वैतदेतदेव तदास सत्यमेव स..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900002122, "chapter_id": 8254, "verse_number": "11.6", "content_sanskrit": "प्रजापतिरिति ब्रह्मा वेदेषूक्तो ह्यमुख्यतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900002123, "chapter_id": 8254, "verse_number": "11.7", "content_sanskrit": "आप एवेदमग्र आसुस्ता आपः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900002124, "chapter_id": 8254, "verse_number": "11.8", "content_sanskrit": "तदेतत् त्र्यक्षरं सत्यमिति स इत्येकमक्षरं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900002125, "chapter_id": 8254, "verse_number": "11.9", "content_sanskrit": "तद्यत्तत्सत्यमसौ स आदित्यो य एष ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900002126, "chapter_id": 8254, "verse_number": "11.10", "content_sanskrit": "य एष एतस्मिन् मण्डले पुरुषस्तस्य भूरिति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900002127, "chapter_id": 8254, "verse_number": "11.11", "content_sanskrit": "मनोमयोऽयं पुरुषो भाः सत्यस्तस्मिन्नन्तर्हृदये ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900002128, "chapter_id": 8254, "verse_number": "11.12", "content_sanskrit": "विद्युद्ब्रह्मेत्याहुर्विदानाद् विद्युत् ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900002129, "chapter_id": 8254, "verse_number": "11.13", "content_sanskrit": "वाचं धेनुमुपासीत तस्याश्चत्वारः स्तनाः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900002130, "chapter_id": 8254, "verse_number": "11.14", "content_sanskrit": "अयमग्निर्वैश्वानरो योऽयमन्तः पुरुषे येनेदमन्नं पच्यते ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900002131, "chapter_id": 8254, "verse_number": "11.15", "content_sanskrit": "यदा वै पुरुषोऽस्माल्लोकात्प्रैति स वायुमागच्छति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900002132, "chapter_id": 8254, "verse_number": "11.16", "content_sanskrit": "यदा वै पुरुषोऽस्माल्लोकात्प्रैति स वायुमागच्छति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900002133, "chapter_id": 8254, "verse_number": "11.17", "content_sanskrit": "एतद्वै परमं तपो यद् व्याधितस्तप्यते परमं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900002134, "chapter_id": 8254, "verse_number": "11.18", "content_sanskrit": "अन्नं ब्रह्मेत्येक आहुस्तन्न तथा पूयति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900002135, "chapter_id": 8254, "verse_number": "11.19", "content_sanskrit": "नासाधुना बाधयितुं शक्योऽसौ साधुनाऽपि वा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900002136, "chapter_id": 8254, "verse_number": "11.20", "content_sanskrit": "उक्थं प्राणो वा उक्थं प्राणो हीदं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900002137, "chapter_id": 8254, "verse_number": "11.21", "content_sanskrit": "भूमिरन्तरिक्षं द्यौरित्यष्टावक्षराण्यष्टाक्षरं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900002138, "chapter_id": 8254, "verse_number": "11.22", "content_sanskrit": "अथास्या एतदेव तुरीयं दर्शतं पदं परो रजा ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900002139, "chapter_id": 8254, "verse_number": "11.23", "content_sanskrit": "यः परोरजास्तपति स तुरीयपदेन प्रणवेन पद्यते ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900002140, "chapter_id": 8254, "verse_number": "11.24", "content_sanskrit": "सैषा गायत्र्येतस्मिंस्तुरीये दर्शते पदे परोरजसि प्रतिष्ठिता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900002141, "chapter_id": 8254, "verse_number": "11.25", "content_sanskrit": "प्राणानां रक्षणादेव गायत्री सा प्रकीर्तिता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900002142, "chapter_id": 8254, "verse_number": "11.26", "content_sanskrit": "तां हैतामेते सावित्रीमनुष्टुभमन्वाहुर्वागनुष्टुभेतद्वाचमनुब्रूम ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 900002143, "chapter_id": 8254, "verse_number": "11.27", "content_sanskrit": "स य इमान् त्रींल्लोकान् पूर्णान् प्रतिगृह्णीयात् ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 900002144, "chapter_id": 8254, "verse_number": "11.28", "content_sanskrit": "लोकस्थमनिरुद्धं च प्रद्युम्नं वेदगं तथा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 900002145, "chapter_id": 8254, "verse_number": "11.29", "content_sanskrit": "तस्या उपस्थानं गायत्र्यस्येकपदी द्विपदी त्रिपदी ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 900002146, "chapter_id": 8254, "verse_number": "11.30", "content_sanskrit": "एतद्ध वै तज्जनको वैदेहो बुडिलमाश्वतराश्विमुवाच ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 900002147, "chapter_id": 8254, "verse_number": "11.31", "content_sanskrit": "हिरण्मयेन पात्रेण सत्यस्यापिहितं मुखम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 900002148, "chapter_id": 8254, "verse_number": "11.32", "content_sanskrit": "पूषन्नकर्षे यम सूर्य प्राजापत्य व्यूहरश्मीन्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 900002149, "chapter_id": 8254, "verse_number": "11.33", "content_sanskrit": "योsसावसौ पुरुषः सोऽहमस्मि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 900002150, "chapter_id": 8254, "verse_number": "11.34", "content_sanskrit": "वायुरनिलममृतमथेदं भस्मान्तं शरीरम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 900002151, "chapter_id": 8254, "verse_number": "11.35", "content_sanskrit": "ॐ क्रतो स्मर कृतं स्मर ॐ क्रतो स्मर कृतं स्मर", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 900002152, "chapter_id": 8254, "verse_number": "11.36", "content_sanskrit": "अग्ने नय सुपथा राये अस्मान् विश्वानि देव वयुनानि विद्वान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]