[{"id": 2070019, "chapter_id": 2465, "verse_number": "१०-१७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2070020, "chapter_id": 2465, "verse_number": "१०-१७-१", "content_sanskrit": "हतेषु सर्वसैन्येषु सौप्तिकै तै रथैस्त्रिभिः।\nशोचन्युधिष्ठिरो राजा दाशार्हमिदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2070021, "chapter_id": 2465, "verse_number": "१०-१७-२", "content_sanskrit": "कथं नु कृष्ण पापेन क्षुद्रेण शठबुद्धिना।\nद्रौणिना निहताः सर्वे मम पुत्रा महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2070022, "chapter_id": 2465, "verse_number": "१०-१७-३", "content_sanskrit": "तथा कृतास्रविक्रान्ताः सङ्ग्रामेष्वपलायिनः।\nद्रुपदस्यात्मजाश्चैव द्रोणपुत्रेण पातिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2070023, "chapter_id": 2465, "verse_number": "१०-१७-४", "content_sanskrit": "यस्य द्रोणो महेष्वासो न प्रादादाहवे मुखम्।\nनिजघ्ने रथिनां श्रेष्ठं धृष्टद्युम्नं कथं नु सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2070024, "chapter_id": 2465, "verse_number": "१०-१७-५", "content_sanskrit": "किन्नु तेन कृतं कर्म तथायुक्तं नरर्षभ।\nयदेकः समरे सर्वानवधीन्नो गुरोः सुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2070025, "chapter_id": 2465, "verse_number": "१०-१७-६x", "content_sanskrit": "श्रीभगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2070026, "chapter_id": 2465, "verse_number": "१०-१७-६", "content_sanskrit": "नूनं स देवदेवानामीश्वरेश्वरमव्ययम्।\nजगाम शरणं द्रौणिरेकस्तेनावधीद्बहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2070027, "chapter_id": 2465, "verse_number": "१०-१७-७", "content_sanskrit": "प्रसन्नो हि महादेवो दद्यादमरतामपि।\nवीर्यं च गिरिशो दद्याद्येनेन्द्रमपि शातयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2070028, "chapter_id": 2465, "verse_number": "१०-१७-८", "content_sanskrit": "वेदाहं हि महादेवं तत्त्वेन भरतर्षभ।\nयानि चास्यपुराणानि कर्माणि विविधानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2070029, "chapter_id": 2465, "verse_number": "१०-१७-९", "content_sanskrit": "आदिरेष हि भूतानां मध्यमन्तश्च भारत।\nविचेष्टते जगच्चेदं सर्वमस्यैव कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2070030, "chapter_id": 2465, "verse_number": "१०-१७-१०", "content_sanskrit": "एवं सिसृक्षुर्भूतानि ददर्श प्रथमं विभुः।\nपितामहोऽब्रवीच्चैनं भूतानि सृज माचिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2070031, "chapter_id": 2465, "verse_number": "१०-१७-११", "content_sanskrit": "हरिकेशस्तथेत्युक्वा दीर्घदर्शी तदा प्रभुः।\nदीर्घकालं तपस्तेपे मग्नोऽम्भसि महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2070032, "chapter_id": 2465, "verse_number": "१०-१७-१२", "content_sanskrit": "सुमहान्तं ततः कालं प्रतीक्ष्यैनं पितामहः।\nस्रष्टारं सर्वभूतानां ससर्ज मनसाऽपरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2070033, "chapter_id": 2465, "verse_number": "१०-१७-१३", "content_sanskrit": "सोऽब्रवीद्वातरं दृष्ट्वा गिरिशं सुप्तमम्भसि।\nयदि मे नाग्रजोऽस्त्यन्यस्ततः स्रक्ष्याम्यहं प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2070034, "chapter_id": 2465, "verse_number": "१०-१७-१४", "content_sanskrit": "तमब्रवीत्पिता नास्ति त्वदन्यः पुरुषोऽग्रजः।\nस्थाणुरेष जले मग्नो विस्रब्धः कुरु वै प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2070035, "chapter_id": 2465, "verse_number": "१०-१७-१५", "content_sanskrit": "भूतान्यन्वसृजत्सप्त दक्षः क्षिप्रं प्रजापतिः।\nयैरिमं व्यकरोत्सर्वं भूतग्रामं चतुर्विधम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2070036, "chapter_id": 2465, "verse_number": "१०-१७-१६", "content_sanskrit": "ताः सृष्टमात्राः क्षुधिताः प्रजाः सर्वाः प्रजापतिम्।\nबिभक्षयिवो राजन्सहसा प्राद्रवंस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2070037, "chapter_id": 2465, "verse_number": "१०-१७-१७", "content_sanskrit": "स भक्ष्यमाणस्त्राणार्थी पितामहमुपाद्रवत्।\nआभ्यो मां भगवांस्त्रातु वृत्तिरासां विधीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2070038, "chapter_id": 2465, "verse_number": "१०-१७-१८", "content_sanskrit": "ततस्ताभ्यो ददावन्नमोषधीः स्थावराणि च।\nजङ्गमानि च भूतानि दुर्बलानि बलीयसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2070039, "chapter_id": 2465, "verse_number": "१०-१७-१९", "content_sanskrit": "विहितान्नाः प्रजास्तास्तु जग्मुस्तुष्टा यथागतम्।\nततो ववृधिरे राजन्प्रीतिमत्यः स्वयोनिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2070040, "chapter_id": 2465, "verse_number": "१०-१७-२०", "content_sanskrit": "भूतग्रामे विवृद्वे तु सृष्टे देवासुरे तदा।\nउदतिष्ठज्जलाज्ज्येष्ठः प्रजाश्चेमा ददर्श सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2070041, "chapter_id": 2465, "verse_number": "१०-१७-२१", "content_sanskrit": "बहुरूपाः प्रजाः सृष्टा विवृद्धाश्च स्वतेजसा।\nचुक्रोध बलवद्दृष्ट्वा लिङ्गं स्वं चाप्यविध्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2070042, "chapter_id": 2465, "verse_number": "१०-१७-२२", "content_sanskrit": "तत्प्रविद्धं तथा भूमौ तथैव प्रत्यतिष्ठत।\nतमुवाचाव्ययो ब्रह्मा वचोभिः शमयन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2070043, "chapter_id": 2465, "verse_number": "१०-१७-२३", "content_sanskrit": "किं कृतं सलिले शर्व चिरकालस्थितेन ते।\nकिमर्थं चेदमुत्पाद्य लिङ्गं भूमौ प्रवेशितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2070044, "chapter_id": 2465, "verse_number": "१०-१७-२४", "content_sanskrit": "सोऽब्रवीज्जातसंरम्भस्तथा लोकगुरुर्गुरुम्।\nप्रजाः सृष्टाः परेणेमाः किं करिष्याम्यनेन वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2070045, "chapter_id": 2465, "verse_number": "१०-१७-२५", "content_sanskrit": "प्रजाः सृष्टाः परेणेमाः प्रजार्थं मे पितामह।\nओषध्यः परिवर्तेरन्यथैवं सततं प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2070046, "chapter_id": 2465, "verse_number": "१०-१७-२६", "content_sanskrit": "एवमुक्त्वा स सक्रोधो जगाम विमना भवः।\nगिरेर्मुञ्जवतः पादं तपस्तप्तुं महातपाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2070047, "chapter_id": 2465, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सौप्तिकपर्वणि ऐषीकपर्वणि सप्तदशोऽध्यायः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]