[{"id": 7002575000, "chapter_id": 22575, "verse_number": "२-२१-१", "content_sanskrit": "सूत उवाच ।\nअथातो मंडलं वक्ष्ये पुराणेषु यथोदितम् ।\nयदधीना भवेत्सिद्धिस्तस्मात्कुर्यात्समाहितः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002575001, "chapter_id": 22575, "verse_number": "२-२१-२", "content_sanskrit": "देवाः पद्मासनस्थाश्च भविष्यंति वसंति च ।\nविनाब्जं नार्चयेद्देवीमर्चिते यक्षिणी हरेत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002575002, "chapter_id": 22575, "verse_number": "२-२१-३", "content_sanskrit": "अतो मंडलविच्छेदं यस्माद्दशगुणं भवेत् ।\nरजःसाध्ये शतगुणं केवले द्विगुणं फलम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002575003, "chapter_id": 22575, "verse_number": "२-२१-४", "content_sanskrit": "त्रिशतं वंदने साध्ये सहस्रं च रजोऽष्टकम् ।\nरजोभिः षोडशैर्बिंबं शतंशतमनंतकम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002575004, "chapter_id": 22575, "verse_number": "२-२१-५", "content_sanskrit": "यन्त्रे मणौ शालग्रामे प्रतिमायां विशेषतः ।\nमहालये महायोनौ रक्तलिंगे च साधिकम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002575005, "chapter_id": 22575, "verse_number": "२-२१-६", "content_sanskrit": "रजोयुक्तं लिखेद्यस्तु पूजाकार्ये विभूतये ।\nकरणादिफलं यस्मात्तस्मात्तत्परिवर्जयेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002575006, "chapter_id": 22575, "verse_number": "२-२१-७", "content_sanskrit": "चतुरस्रं नवं व्यूहं क्रौंचप्राणं चतु र्विधम् ।\nकामबीजं वज्रनाभं विघ्नराजं गजाह्वयम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002575007, "chapter_id": 22575, "verse_number": "२-२१-८", "content_sanskrit": "पारिजातं चंद्रबिंबं सूर्यकांतं च शेखरम् ।\nशतपत्रं सहस्रारं नवनाभं च मुष्टिकम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002575008, "chapter_id": 22575, "verse_number": "२-२१-९", "content_sanskrit": "पंचाब्जं चैव मैनाकं कामराजं च पुष्करम् ।\nअष्टास्रं चैव श्रीबिंबं षडस्रं त्र्यस्रमेव तु ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002575009, "chapter_id": 22575, "verse_number": "२-२१-१०", "content_sanskrit": "चत्वारिंशत्तथा पंचस्वाधिकं परिसंख्यया ।\nचतुरस्रं नवव्यूढं वैष्णवे यागकर्मणि ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002575010, "chapter_id": 22575, "verse_number": "२-२१-११", "content_sanskrit": "प्रशस्तं चापि गोमेधे क्रौंचं घ्राणं चतुर्विधम् ।\nसुभद्रं चाश्वमेधे च नरमेधे नरासनम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002575011, "chapter_id": 22575, "verse_number": "२-२१-१२", "content_sanskrit": "सर्वत्र सर्वतोभद्रं चतुरस्रं सुभद्रकम् ।\nकामराजं तथा त्र्यस्रमष्टास्रं च षडस्रकम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002575012, "chapter_id": 22575, "verse_number": "२-२१-१३", "content_sanskrit": "शक्तानां कामपक्षे च पंचसिंहासनं महत् ।\nध्यानाचले मेरुपृष्ठं मणिमुक्ताचलेष्वपि ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002575013, "chapter_id": 22575, "verse_number": "२-२१-१४", "content_sanskrit": "सहस्रं शतपत्रं च अन्नदाने तिलाचले ।\nहरिवल्लभं राजसूये सोमयागेषु शस्यते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002575014, "chapter_id": 22575, "verse_number": "२-२१-१५", "content_sanskrit": "प्रतिष्ठायां सुभद्रं च सर्वतोभद्रमेव च ।\nजलाशयप्रतिष्ठायां विघ्नराजं प्रशस्यते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002575015, "chapter_id": 22575, "verse_number": "२-२१-१६", "content_sanskrit": "घटप्रस्थापने चैव गजाह्वं तुरगासनम् ।\nशतपत्रं लक्षहोमे अयुते चतुरस्रकम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002575016, "chapter_id": 22575, "verse_number": "२-२१-१७", "content_sanskrit": "यस्य यज्ञस्य यद्बिंबं तत्तु तेनैव योजयेत् ।\nइतोऽन्यथा भवेद्दोषो विपरीतेष्वधोगतिः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002575017, "chapter_id": 22575, "verse_number": "२-२१-१८", "content_sanskrit": "द्विहस्ता चतुरस्रा च वेदिका परिकीर्तिता ।\nचतुरंगुलोच्छ्रायमिता षडंगुला ह्यथापि वा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002575018, "chapter_id": 22575, "verse_number": "२-२१-१९", "content_sanskrit": "षडंगुला नवव्यूहे वर्धयेद्यज्ञकोविदः ।\nएकांगुलसमुत्सेधः कर्तव्यस्सुसमाहितैः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002575019, "chapter_id": 22575, "verse_number": "२-२१-२०", "content_sanskrit": "क्रौंचप्राणे तुर्यहस्तं मुष्टिहस्तं समुच्छ्रितम् ।\nमध्यद्वये हीनकरं कनिष्ठं त्र्यंगुलाधिकम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002575020, "chapter_id": 22575, "verse_number": "२-२१-२१", "content_sanskrit": "कुर्याद्द्वित्रिक्रमाद्धीनमुच्छ्राये द्विजसत्तमाः ।\nपारिजातं चंद्रबिंबं सूर्यकांतं च शेखरम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002575021, "chapter_id": 22575, "verse_number": "२-२१-२२", "content_sanskrit": "ग्रहाणां पौष्टिके पक्षे बाह्यग्रामादिसाधने ।\nनियोजयेत्तत्रतत्र वेदिकाचक्रकत्रयम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002575022, "chapter_id": 22575, "verse_number": "२-२१-२३", "content_sanskrit": "प्रथमे मुष्टिहस्तः स्यात्संपूर्णे शेषमानकैः ।\nनवलाभे च पंचाब्जं करत्रयमुदाहृतम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002575023, "chapter_id": 22575, "verse_number": "२-२१-२४", "content_sanskrit": "शेषा चैव वरिष्ठा च लवली भित्ति वेदिका ।\nविज्ञेया द्विजशार्दूला यथाकाम्येषु योजयेत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002575024, "chapter_id": 22575, "verse_number": "२-२१-२५", "content_sanskrit": "अयथाव्यत्यये दोषस्तस्माद्यत्नेन साधयेत् ।\nदशहस्ते चाष्टहस्ते अष्टहस्ते च षोडशम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002575025, "chapter_id": 22575, "verse_number": "२-२१-२६", "content_sanskrit": "मुष्टिबाहुञ्च प्रादेशं वर्धयेत्षोडशांशके ।\nहस्तोत्सेधं च कर्तव्यं हीने हीनं च ह्रासयेत् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002575026, "chapter_id": 22575, "verse_number": "२-२१-२७", "content_sanskrit": "दर्पणाकारकं कुर्याद्यागके शांति कर्मणि ।\nहीनं कुर्यात्प्रयत्नेन वप्राकारं परिस्तवे ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002575027, "chapter_id": 22575, "verse_number": "२-२१-२८", "content_sanskrit": "निशारणैर्गोमयैश्च वेदिकां च प्रलेपयेत् ।\nस्वर्णरत्नमयैस्तोयैरभिषिच्य कुशोदकैः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002575028, "chapter_id": 22575, "verse_number": "२-२१-२९", "content_sanskrit": "हीनवीर्यगवानां च पुरीषं धेनुकं तथा ।\nकपिलायाश्च यत्नेन कुंडमंडललेपने ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002575029, "chapter_id": 22575, "verse_number": "२-२१-३०", "content_sanskrit": "वर्जयेत्सर्वयागेषु स्थंडिलेषु प्रयत्नतः ।\nविना सूत्रैः कीलके न मंडले नैव सूत्रयेत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002575030, "chapter_id": 22575, "verse_number": "२-२१-३१", "content_sanskrit": "तस्मात्प्रयत्नतः कार्यं यत्सूत्रं यच्च कीलकम् ।\nअर्कहस्तमितं सूत्रं मृदु लाक्षामयं तथा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002575031, "chapter_id": 22575, "verse_number": "२-२१-३२", "content_sanskrit": "पीतकार्यस्रजं चैव कीलकं स्वर्णनिर्मितम् ।\nरौप्यताम्रमयं कुर्याद्वैष्णवे यागकर्मणि ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002575032, "chapter_id": 22575, "verse_number": "२-२१-३३", "content_sanskrit": "गणनायके सुप्रशस्तं शैषेपामार्गमेव च ।\nग्रहपक्षे तथेशस्य कच्छपस्य द्विजोत्तमाः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002575033, "chapter_id": 22575, "verse_number": "२-२१-३४", "content_sanskrit": "षोडशे चार्कहस्ते च तत्र नेमियुतं भवेत् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]