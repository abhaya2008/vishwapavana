[{"id": 2019089, "chapter_id": 1399, "verse_number": "३-३७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2019090, "chapter_id": 1399, "verse_number": "३-३७-१", "content_sanskrit": "कस्यचित्त्वथ कालस्य धर्मराजो युधिष्ठिरः।\nसंस्मृत्य मुनिसंदेशमिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2019091, "chapter_id": 1399, "verse_number": "३-३७-२", "content_sanskrit": "विविक्ते विदितप्रज्ञमर्जुनं पुरुषर्षभ।\nसान्त्वपूर्वं स्मितं कृत्वापाणिना परिसंस्पृशन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2019092, "chapter_id": 1399, "verse_number": "३-३७-३", "content_sanskrit": "स मुहूर्तमिव ध्यात्वा वनवासमरिंदमः।\nधनंजयंधर्मराजो रहसीदमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2019093, "chapter_id": 1399, "verse_number": "३-३७-४", "content_sanskrit": "भीष्मे द्रोणे कृपे कर्णे द्रोणपुत्रे च भारत।\nधनुर्वेदश्चतुष्पाद एतेष्वद्य प्रतिष्ठितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2019094, "chapter_id": 1399, "verse_number": "३-३७-५", "content_sanskrit": "दैवं ब्राह्मं चासुरं च सप्रयोगचिकित्सितम्।\nसर्वास्त्राणां प्रयोगं च अभिजानन्ति कृत्स्नशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2019095, "chapter_id": 1399, "verse_number": "३-३७-६", "content_sanskrit": "ते सर्वे धृतराष्ट्रस्य पुत्रेण परिसान्त्विताः।\nसंविभक्ताश्च तुष्टाश्च गुरुवत्तेषु वर्तते।\nसर्वयोधेषु चैवास्य सदा प्रीतिरनुत्तमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2019096, "chapter_id": 1399, "verse_number": "३-३७-७", "content_sanskrit": "आचार्या मानितास्तुष्टाः शान्तिं व्यवहरन्न्युत।\nशक्तिं न हापयिष्यन्ति ते काले प्रतिपूजिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2019097, "chapter_id": 1399, "verse_number": "३-३७-८", "content_sanskrit": "अद्य चेयं मही कृत्स्ना दुर्याधनवशानुगा।\nसग्रामनगरा पार्थ ससागरवनाकरा ॥\nभवानेव प्रियोऽस्माकं त्वयि भारः समाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2019098, "chapter_id": 1399, "verse_number": "३-३७-१०", "content_sanskrit": "अत्र कृत्यं प्रपश्यामि प्राप्तकालमरिंदम।\nकृष्णद्वैपायनात्तात गृहीतोपनिषन्मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2019099, "chapter_id": 1399, "verse_number": "३-३७-११", "content_sanskrit": "गृहीतया तया सम्यग्जगत्सर्वं प्रकाशते।\nतेन त्वं ब्रह्मणा तात संयुक्तः सुसमाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2019100, "chapter_id": 1399, "verse_number": "३-३७-१२", "content_sanskrit": "देवतानां यथाकालं प्रसादं प्रतिपालय।\nतपसा योजयात्मानमुग्रेण भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2019101, "chapter_id": 1399, "verse_number": "३-३७-१३", "content_sanskrit": "धनुष्मान्कवची खङ्गी मुनिः साधुव्रते स्थितः।\nन कस्यचिद्ददन्मार्गं गच्छ तातोत्तरां दिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2019102, "chapter_id": 1399, "verse_number": "३-३७-१४", "content_sanskrit": "इनद्रे ह्यस्त्राणि दिव्यानि समस्तानि धनंजय।\nवृत्राद्भीतैर्बलं देवैस्तदा शक्रे समर्पितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2019103, "chapter_id": 1399, "verse_number": "३-३७-१५", "content_sanskrit": "तान्येकस्थानि सर्वाणि ततस्त्वं प्रतिपत्स्यसे।\n`अनेन ब्रह्मणा तात सर्वं संप्रतिपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2019104, "chapter_id": 1399, "verse_number": "३-३७-१६", "content_sanskrit": "शक्रमेव प्रपद्यस्व स तेऽस्त्राणि प्रदास्यति।\nदीक्षितोऽद्यैव गच्छ त्वं द्रष्टुं देवं पुरंदरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2019105, "chapter_id": 1399, "verse_number": "३-३७-१७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2019106, "chapter_id": 1399, "verse_number": "३-३७-१७", "content_sanskrit": "एवमुक्त्वा धर्मराजस्तमध्यापयत प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2019107, "chapter_id": 1399, "verse_number": "३-३७-१८", "content_sanskrit": "दीक्षितं विधिना तेन यतवाक्कायमानसम्।\nअनुजज्ञे तदा वीरं भ्राता भ्रातरमग्रजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2019108, "chapter_id": 1399, "verse_number": "३-३७-१९", "content_sanskrit": "निदेशाद्धर्मराजस्य द्रष्टुकामः पुरंदरम्।\nधनुर्गाण्डीवमादाय तथाऽक्षय्ये महेषुधी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2019109, "chapter_id": 1399, "verse_number": "३-३७-२०", "content_sanskrit": "कवची सतलत्राणो बद्धगोधाङ्गुलित्रवान्।\nहत्वाऽग्निं ब्राह्मणान्निष्कैः स्वस्तिवाच्य मह्यभुज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2019110, "chapter_id": 1399, "verse_number": "३-३७-२१", "content_sanskrit": "प्रातिष्ठत महाबाहुः प्रगृहीतशरासनः।\nवधाय धार्तराष्ट्राणां निःश्वस्योर्ध्वमुदैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2019111, "chapter_id": 1399, "verse_number": "३-३७-२२", "content_sanskrit": "तं दृष्ट्वा तत्रकौन्तेयं प्रगृहीतशरासनम्।\nअब्रुवन्ब्रह्मणाः सिद्धा भूतान्यन्तर्हितानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2019112, "chapter_id": 1399, "verse_number": "३-३७-२३", "content_sanskrit": "क्षिप्रमाप्नुहि कौन्तेय मनसा यद्यदिच्छसि।\nसंसाधयस्व कौन्तेय ध्रुवोस्तु विजयस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2019113, "chapter_id": 1399, "verse_number": "३-३७-२४", "content_sanskrit": "अब्रुवन्ब्राह्मणाः पार्थमिति कृत्वा जयाशिषः।\n`सिद्धचारणसङ्घाश्च गन्धर्वाश्च तमब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2019114, "chapter_id": 1399, "verse_number": "३-३७-२५", "content_sanskrit": "स्वस्तिव्रतमुपाधत्स्व सङ्कल्पस्तव सिद्ध्यताम्।\nमनोरथाश्च ते सर्वे समृद्ध्यन्तां महारथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2019115, "chapter_id": 1399, "verse_number": "३-३७-२६", "content_sanskrit": "एवमुक्तोऽभिवाद्यैतान्बद्धाञ्जलिपुटस्तथा।\nतपोयोगमनाः पार्थः पुरोहितमवन्दत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2019116, "chapter_id": 1399, "verse_number": "३-३७-२७", "content_sanskrit": "ततः प्रीतमना जिष्णुस्तावुभावभ्यवन्दत।\nसहोदरावतिरथौ युधिष्ठिरवृकोदरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2019117, "chapter_id": 1399, "verse_number": "३-३७-२८", "content_sanskrit": "तं क्लान्तमनसौ पूर्णमभिगम्य महारथौ।\nयमौ गाण्डीवधन्वानमभ्यवादयतामुभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2019118, "chapter_id": 1399, "verse_number": "३-३७-२९", "content_sanskrit": "अभिवाद्य तु तौ वीरावूचतुः पाकशासनिम्।\nअवाप्तव्यानि सर्वाणि दिव्यान्यस्त्राणि वासवात्। ३-३७-२९cअस्त्राण्याप्नुहि कौन्तेय मनसा यद्यदिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2019119, "chapter_id": 1399, "verse_number": "३-३७-३०", "content_sanskrit": "गिरो ह्यशिथिलाः सर्वा निर्दोषाः संमताः सताम्।\nत्वमेकः पाण्डवेष्वद्य संप्राप्तोसि धनञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2019120, "chapter_id": 1399, "verse_number": "३-३७-३१", "content_sanskrit": "न चाधर्मविदं देवा नासिद्धं नातपस्विनम्।\nद्रष्टुमिच्छन्ति कौन्तेय चलचित्तं शठं न च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2019121, "chapter_id": 1399, "verse_number": "३-३७-३२", "content_sanskrit": "रोरूयमाणः कटुकमीर्ष्यकः कटुकाक्षरः।\nशठकः श्लाघकः क्षेप्ता हन्ता च विचिकित्सिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2019122, "chapter_id": 1399, "verse_number": "३-३७-३३", "content_sanskrit": "विश्वस् हन्ता मायावी क्रोधनोऽनृतभाषिता।\nअत्याशी नास्तिकोऽदाता मित्रध्रुक्सर्वशङ्कितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2019123, "chapter_id": 1399, "verse_number": "३-३७-३४", "content_sanskrit": "आक्रोष्टा चातिमानी च रौद्रो लुब्धोऽथ लोलुपः।\nस्तेनश्च मद्यपश्चैव भ्रूणहा गुरुतल्पगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2019124, "chapter_id": 1399, "verse_number": "३-३७-३५", "content_sanskrit": "संभावितात्मा चात्यर्थं नृशंसः पुरुषश्च यः।\nनैते लोकानाप्नुवन्ति निर्लोकास्ते धनञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2019125, "chapter_id": 1399, "verse_number": "३-३७-३६", "content_sanskrit": "आनृशंस्यमनुक्रोशः सत्यं करुणवेदिता।\nदमः स्थितिर्धृतिर्धर्मः क्षमा कृत्यमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2019126, "chapter_id": 1399, "verse_number": "३-३७-३७", "content_sanskrit": "दया शमश्च धर्मश्च गुरुपूजा कृतज्ञता।\nमैत्रता द्विजभक्तिश्च वसन्ति त्वयि फल्गुन।\nव्यपेक्षा सर्वभूतेषु कृपा दानं मतिः स्मृतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2019127, "chapter_id": 1399, "verse_number": "३-३७-३८", "content_sanskrit": "तस्मात्कौरव्य शक्रेण समेष्यसि धनञ्जय।\nत्वादृशेन हि देवानां श्लाघनीयः समागमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2019128, "chapter_id": 1399, "verse_number": "३-३७-३९", "content_sanskrit": "सुहृदां सोदराणां च सर्वेषां भरतर्षभ।\nत्वं गतिः परमा तात वृत्रहा मरुतामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2019129, "chapter_id": 1399, "verse_number": "३-३७-४०", "content_sanskrit": "तस्मिंस्त्रयोदशे वर्षे भ्रातरः सुहृदश्च ते।\nसर्वे हिसंश्रयिष्यन्ति बाहुवीर्यं महाबल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2019130, "chapter_id": 1399, "verse_number": "३-३७-४१", "content_sanskrit": "स पार्थ पितरं गच्छ सहस्राक्षमरिन्दम।\nमुष्टिग्रहणमादत्स्व सर्वाण्यस्त्राणि वासवात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2019131, "chapter_id": 1399, "verse_number": "३-३७-४२", "content_sanskrit": "शतशृङ्गे महाबाहो मघवानिदमब्रवीत्।\nशृण्वतां सर्वभूतानां त्वामुपाघ्राय मूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2019132, "chapter_id": 1399, "verse_number": "३-३७-४३", "content_sanskrit": "विदितः सर्वभूतानां दिवं तात गमिष्यसि।\nप्राप्य पुण्यकृतां लोकान्रंस्यसे जयतांवर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2019133, "chapter_id": 1399, "verse_number": "३-३७-४४", "content_sanskrit": "मानितस्त्रिदशैः पार्थ विहृत्य सुसुखं दिवि।\nअवाप्यपरमास्त्राणि पृथिवीं पुनरेष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2019134, "chapter_id": 1399, "verse_number": "३-३७-४५", "content_sanskrit": "गुणांस्ते वासवस्तात खाण्डवं दहति त्वयि।\nशृण्वतां सर्वभूतानां पुनः पुनरभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2019135, "chapter_id": 1399, "verse_number": "३-३७-४६", "content_sanskrit": "तां प्रतिज्ञां नरश्रेष्ठ कर्तुमर्हसि वासवीम्।\nकंचिद्देशमितः प्राप्य तपोयोगमना भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2019136, "chapter_id": 1399, "verse_number": "३-३७-४७", "content_sanskrit": "कर्तुमर्हसि कौरव्य मघवद्वचनं हितम्।\nदीक्षित्वाऽद्यैव गच्छ त्वं द्रष्टाऽसि त्वं पुरन्दरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2019137, "chapter_id": 1399, "verse_number": "३-३७-४८", "content_sanskrit": "तौ परिष्वज्य बीभत्सुः कृष्णामामन्त्र्य चाप्युभौ।\nमनांस्यादाय सर्वेषां प्रयातः पुरुषर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2019138, "chapter_id": 1399, "verse_number": "३-३७-४९", "content_sanskrit": "तं तथा प्रस्थितं वीरं सिंहस्कन्धोरसं तदा।\nप्राञ्जलिः पाण्डवंकृष्णा देवानां कुर्वती नमः।\nवाग्भिः परमशुद्धाभिर्मङ्गलाभिरभाषत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2019139, "chapter_id": 1399, "verse_number": "३-३७-५०", "content_sanskrit": "नमो धात्रे विधात्रे च स्वस्ति गच्छ वनाद्वनम्।\n`धर्मस्त्वां जुषतां पार्थ भास्करश्च विभावसुः।\nब्रह्मा त्वां ब्राह्मणाश्चैव पालयन्तु धनञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2019140, "chapter_id": 1399, "verse_number": "३-३७-५१", "content_sanskrit": "ज्येष्ठापचायी ज्येष्ठस्य भ्रातुर्वचनमास्थितः।\nप्रपद्येथा वसूव्रुद्रानादित्यान्समरुद्गणान्।\nविश्वेदेवांस्तथा साध्याञ्शान्त्यर्थं भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2019141, "chapter_id": 1399, "verse_number": "३-३७-५२", "content_sanskrit": "स्वस्ति तेस्त्वान्तरिक्षेभ्यो दिव्येभ्यो भरतर्षभ।\nपार्थिवेभ्यश्च सर्वेभ्यो ये केचित्परिपन्थिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2019142, "chapter_id": 1399, "verse_number": "३-३७-५३", "content_sanskrit": "अवरोधाद्वने वासात्सर्वस्वहरणादपि।\nइदं दुःखतरं मन्ये पुत्रेभ्यश्च विवासनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2019143, "chapter_id": 1399, "verse_number": "३-३७-५४", "content_sanskrit": "मास्माकं क्षत्रियकुले जातुचित्पुनरुद्भवः।\nब्राह्मणेभ्यो नमस्यामि येषां नायुधजीविका ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2019144, "chapter_id": 1399, "verse_number": "३-३७-५५", "content_sanskrit": "इदं मे परमं दुःखं यः स पापः सुयोधनः।\nदृष्ट्वा मां गौरिति प्राह प्रहसन्राजसंसदि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2019145, "chapter_id": 1399, "verse_number": "३-३७-५६", "content_sanskrit": "तस्माद्दुःखादिदं दुःखं गरीय इतिमे मतिः।\nयत्तत्परिषदो मध्ये बह्वयुक्तमभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2019146, "chapter_id": 1399, "verse_number": "३-३७-५७", "content_sanskrit": "`ध्वंसितः स्वगृहेभ्यश्च राष्ट्राच्च भरतर्षभ।\nवने प्रतिष्ठितो भूत्वा सौहार्दादवतिष्ठसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2019147, "chapter_id": 1399, "verse_number": "३-३७-५८", "content_sanskrit": "जेता यः सर्वशत्रूणां यः पावकमतर्पयः।\nजनस्त्वां पश्यतीदानीं गच्छन्तं भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2019148, "chapter_id": 1399, "verse_number": "३-३७-५९", "content_sanskrit": "अस्मिन्नूनं महारण्ये भ्रातरः सुहृदश्च ते।\nत्वत्कथाः कथयिष्यन्ति चारणा ऋषयस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2019149, "chapter_id": 1399, "verse_number": "३-३७-६०", "content_sanskrit": "यत्ते कुन्ती महाबाहो जातस्यैच्छद्धनञ्जय।\nतत्तेऽस्तु सर्वं कौन्तेय यथा च स्वयमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2019150, "chapter_id": 1399, "verse_number": "३-३७-६१", "content_sanskrit": "`वसुदेवस्वसा देवी त्वामार्या पुनरागतम्।\nपश्यतु त्वां पृथा पार्थ सहस्राक्षमिवादितिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2019151, "chapter_id": 1399, "verse_number": "३-३७-६२", "content_sanskrit": "नूनं ते भ्रातरः सर्वे त्वत्कथाभिः प्रजागरे।\nरंस्यन्ते तव कर्माणि कीरत्यन्तः पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2019152, "chapter_id": 1399, "verse_number": "३-३७-६३", "content_sanskrit": "न च नः पार्थ भोगेषु न धने नोत जीविते।\nतुष्टिर्बुद्धिर्भवित्री वा त्वयि दीर्घप्रवासिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2019153, "chapter_id": 1399, "verse_number": "३-३७-६४", "content_sanskrit": "त्वयि नः पार्थ सर्वेषां सुखदुःखे प्रतिष्ठते।\nजीवितं मरणं चैव राज्यमैश्वर्यमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2019154, "chapter_id": 1399, "verse_number": "३-३७-६५", "content_sanskrit": "आपृष्टो नोसि कौन्तेय स्वस्ति प्राप्नुहि पाण्डव।\nकृतास्त्रं स्वस्तिमन्तं त्वां द्रक्ष्यामि पुनरागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2019155, "chapter_id": 1399, "verse_number": "३-३७-६६", "content_sanskrit": "बलवद्भिर्विरुद्धं न कार्यमेतत्त्वयाऽनघ।\nप्रयाह्यविघ्नेयैवाशु विजयाय महाबल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2019156, "chapter_id": 1399, "verse_number": "३-३७-६७", "content_sanskrit": "ह्रीः श्रीः कीर्तिर्धृतिः पुष्टिरुमा लक्ष्मीः सरस्वती।\nइमा वै तव पान्थस् पालयन्तु धनञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2019157, "chapter_id": 1399, "verse_number": "३-३७-६८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2019158, "chapter_id": 1399, "verse_number": "३-३७-६८", "content_sanskrit": "एवमुक्त्वाऽऽशिषः कृष्णा विरराम यशस्विनी।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2019159, "chapter_id": 1399, "verse_number": "३-३७-६९", "content_sanskrit": "ततःप्रदक्षिणं कृत्वा भ्रातॄन्धौम्यं च पाण्डवः।\nप्रातिष्ठत महाबाहुः प्रगृह्य रुचिरं धनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2019160, "chapter_id": 1399, "verse_number": "३-३७-७०", "content_sanskrit": "`शनैरिव दिशं वीर उदीचीं भरतर्षभ।\nसंहरंस्तरसा वृक्षाँल्लता वल्लीश्च भारत।\nअसज्जमानो वृक्षेषु जगाम सुमहाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2019161, "chapter_id": 1399, "verse_number": "३-३७-७१", "content_sanskrit": "तस्य मार्गादपाक्रामन्सर्वभूतानि गच्छतः।\nयुक्तस्यैन्द्रेण योगेन पराक्रान्तस्य शुष्मिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2019162, "chapter_id": 1399, "verse_number": "३-३७-७२", "content_sanskrit": "सोऽगच्छत्पर्वतांस्तात तपोधननिषेवितान्।\nदिव्यं हैमवतं पुण्यं देवजुष्टं परंतपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2019163, "chapter_id": 1399, "verse_number": "३-३७-७३", "content_sanskrit": "अगच्छत्पर्वतं पुण्यमेकाह्नैव महामनाः।\nमनोजवगतिर्भूत्वा योगयुक्तो यथाऽनिलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2019164, "chapter_id": 1399, "verse_number": "३-३७-७४", "content_sanskrit": "हिमवन्तमतिक्रम्य गन्धमादनमेव च।\nअत्यक्रामत्स दुर्गाणि दिवारात्रमतन्द्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2019165, "chapter_id": 1399, "verse_number": "३-३७-७५", "content_sanskrit": "इन्द्रिकीलं समासाद्य ततोऽतिष्ठद्धनंजयः।\n`गत्वा स षडहोरात्रान्सप्तमेऽहनि पाण्डवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2019166, "chapter_id": 1399, "verse_number": "३-३७-७६", "content_sanskrit": "प्रस्थेन्द्रकीलस्य शुभे तपोयोगपरोऽभवत्।\nऊर्ध्वबाहुर्न चाङ्गानि प्रास्पन्दयत किंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2019167, "chapter_id": 1399, "verse_number": "३-३७-७७", "content_sanskrit": "समाहितात्मा नियतः सहस्राक्षसुतोऽच्युतः।\nअन्तरिक्षे स शुश्राव तिष्ठेति स वचस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2019168, "chapter_id": 1399, "verse_number": "३-३७-७८", "content_sanskrit": "तच्छ्रुत्वा सर्वतो दृष्टिं चारयामास रपाण्डवः।\nअथापश्यत्सव्यसाची वृक्षमूले तपस्विनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2019169, "chapter_id": 1399, "verse_number": "३-३७-७९", "content_sanskrit": "ब्राह्म्या श्रिया दीप्यमानं पिङ्गलं जटिलं कृशम्।\nसोऽब्रवीदर्जुनं तत्रस्थितं दृष्ट्वा महातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2019170, "chapter_id": 1399, "verse_number": "३-३७-८०", "content_sanskrit": "कस्त्वं तातेह संप्राप्तो धनुष्मान्कवची शरी।\nनिबद्धाऽसितलत्राणः क्षत्रधर्ममनुव्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2019171, "chapter_id": 1399, "verse_number": "३-३७-८१", "content_sanskrit": "नेह शस्त्रेण कर्तव्यं शान्तानामेष आलयः।\nविनीतक्रोधहर्षाणां ब्राह्मणानां तपस्विनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2019172, "chapter_id": 1399, "verse_number": "३-३७-८२", "content_sanskrit": "नेहास्ति धनुषा कार्यं न संग्रामोऽत्र कर्हिचित्।\nनिक्षिपैतद्धनुस्तात प्राप्तोसि परमां गतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2019173, "chapter_id": 1399, "verse_number": "३-३७-८३", "content_sanskrit": "इत्यनन्तौजसं वीरं यथा चान्यं पृथग्जनम्।\nतथा हसन्निवाभीक्ष्णं ब्राह्मणोऽर्जुनमब्रवीत्। ३-३७८३c न चैनं चालयामास धैर्यात्सुधृतनिश्चयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2019174, "chapter_id": 1399, "verse_number": "३-३७-८४", "content_sanskrit": "तमुवाच ततः प्रीतः स द्विजः प्रहसन्निव।\nवरं वृणीष्व भद्रं ते शक्रोऽहमरिसूदन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2019175, "chapter_id": 1399, "verse_number": "३-३७-८५", "content_sanskrit": "एवमुक्तः सहस्राक्षं प्रत्युवाच धनंजयः।\nप्राञ्जलिः प्रणतो भूत्वा सूरः कुरुकुलोद्वहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2019176, "chapter_id": 1399, "verse_number": "३-३७-८६", "content_sanskrit": "ईप्सितो ह्येष वै कामो वरं चैनं प्रयच्छ मे।\nत्वत्तोऽद्य भगवन्नस्त्रंकृत्स्नमिच्छामि वेदितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2019177, "chapter_id": 1399, "verse_number": "३-३७-८७", "content_sanskrit": "प्रत्युवाच महेन्द्रस्तं प्रीतात्मा प्रहसन्निव।\nइह प्राप्तस्य किं कार्यमस्त्रैस्तव धनंजय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2019178, "chapter_id": 1399, "verse_number": "३-३७-८८", "content_sanskrit": "कामान्वृणीष्व लोकांस्त्वं प्राप्तोसि परमां गतिम्।\nएवमुक्तः प्रत्युवाच सहस्राक्षं धनंजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2019179, "chapter_id": 1399, "verse_number": "३-३७-८९", "content_sanskrit": "न लोभान्न पुनः कामान्न देवत्वं पुनः सुखम्।\nन च सर्वामरैश्वर्यं कामये त्रिदशाधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2019180, "chapter_id": 1399, "verse_number": "३-३७-९०", "content_sanskrit": "भ्रातॄंस्तान्विपिने त्यक्त्वा वैरमप्रतियात्य च।\nअकीर्तिं सर्वलोकेषु गच्छेयं शाश्वतीः समाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2019181, "chapter_id": 1399, "verse_number": "३-३७-९१", "content_sanskrit": "एवमुक्तः प्रत्युवाच वृत्रहा पाण्डुनन्दनम्।\nसान्त्वयञ्श्लक्ष्णया वाचा सर्वलोकनमस्कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2019182, "chapter_id": 1399, "verse_number": "३-३७-९२", "content_sanskrit": "यदा द्रक्ष्यसि भूतेशं त्र्यक्षं शूलधरं शिवम्।\nतदा दाताऽस्मि ते तात दिव्यान्यस्त्राणि सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2019183, "chapter_id": 1399, "verse_number": "३-३७-९३", "content_sanskrit": "क्रियतां दर्शने यत्नो देवस्य परमेष्ठिनः।\nदर्शनात्तस्य कौन्तेय संसिद्धः स्वर्गमेष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2019184, "chapter_id": 1399, "verse_number": "३-३७-९४", "content_sanskrit": "इत्युक्त्वा फल्गुनं शक्रो जगामादर्शनं पुनः।\nअर्जुनोप्यथ तत्रैव तस्थौ योगसमन्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2019185, "chapter_id": 1399, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारेत अरण्यपर्वणि अर्जुनाभिगमनपर्वणि सप्तत्रिंशोऽध्यायः ॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}]