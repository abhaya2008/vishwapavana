[{"id": 2077518, "chapter_id": 2641, "verse_number": "१२-१४६-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2077519, "chapter_id": 2641, "verse_number": "१२-१४६-१", "content_sanskrit": "ततः स लुब्धकः पश्यन्क्षुधयाऽपि परिप्लुतः।\nकपोतमग्निपतितं वाक्यं पुनरुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2077520, "chapter_id": 2641, "verse_number": "१२-१४६-२", "content_sanskrit": "किमीदृशं नृशंसेन मया कृतमबुद्धिना।\nभविष्यति हि मे नित्यं पातकं भुवि जीवतः।\nस विनिन्दंस्तथाऽऽत्मानं पुनः पुनरुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2077521, "chapter_id": 2641, "verse_number": "१२-१४६-३", "content_sanskrit": "धिङ्भामस्तु सुदुर्बुद्धिं सदा निकृतिनिश्चयम्।\nशुभं कर्म परित्यज्य सोऽहं शकुनिलुब्धकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2077522, "chapter_id": 2641, "verse_number": "१२-१४६-४", "content_sanskrit": "नृशंसस्य ममाद्यायं प्रत्यादेशो न संशयः।\nदत्तः स्वमांसं दहता कपोतेन महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2077523, "chapter_id": 2641, "verse_number": "१२-१४६-५", "content_sanskrit": "सोहं त्यक्ष्ये प्रियान्प्राणान्पुत्रान्दारान्विसृज्य च।\nउपदिष्टो हि मे धर्मः कपोतेनात्र धर्मिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2077524, "chapter_id": 2641, "verse_number": "१२-१४६-६", "content_sanskrit": "अद्यप्रभुति देहं स्वं सर्वभोगैर्विवर्जितम्।\nयथा स्वल्पं सरो ग्रीष्मे शोषयिष्याम्महं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2077525, "chapter_id": 2641, "verse_number": "१२-१४६-७", "content_sanskrit": "क्षुत्पिपासातपसहः कृशो ध्रमनिसन्ततः।\nउपवासैर्बहुविधैश्चरिष्ये पारलौकिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2077526, "chapter_id": 2641, "verse_number": "१२-१४६-८", "content_sanskrit": "अहो देहप्रदानेन दर्शिताऽतिथिपूजना।\nतस्माद्धर्मं चरिष्यामि धर्मो हि परमा गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2077527, "chapter_id": 2641, "verse_number": "१२-१४६-९", "content_sanskrit": "दृष्टो धर्मो हि धर्मिष्ठे यादृशो विहगोत्तमे।\nएवमुक्त्वा विनिश्चित्य रौद्रकर्मा स लुब्धकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2077528, "chapter_id": 2641, "verse_number": "१२-१४६-१०", "content_sanskrit": "महाप्रस्थानमाश्रित्य प्रययौ संशितव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2077529, "chapter_id": 2641, "verse_number": "१२-१४६-११", "content_sanskrit": "ततो यष्टिं शलाकां च धारकं पञ्जरं तथा।\nतां च बद्धां कपोतीं स प्रमुच्य विससर्ज ह॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2077530, "chapter_id": 2641, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि षट्चत्वारिंशदधिकशततमोऽध्यायः॥ १४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]