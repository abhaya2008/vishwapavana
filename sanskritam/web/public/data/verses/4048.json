[{"id": 2141214, "chapter_id": 4048, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2141215, "chapter_id": 4048, "verse_number": "१", "content_sanskrit": "अश्वत्थामा ततस्तत्र कर्णं सम्प्रेक्ष्य वीर्यवान् ।\nउवाच स्मयमानस्तु सूतपुत्रमरिन्दमम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2141216, "chapter_id": 4048, "verse_number": "२", "content_sanskrit": "कर्ण यत् तत् समामध्ये बह्वबद्धं विकत्थसे ।\nन मे युधि समोऽस्तीति तदिदं प्रत्युपस्थितम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2141217, "chapter_id": 4048, "verse_number": "३", "content_sanskrit": "एषोऽन्तक इव क्रुद्धः सर्वभूतावमर्दनः ।\nसङ्ग्रामशिरसो मध्ये जृम्भते केसरी यथा\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2141218, "chapter_id": 4048, "verse_number": "४", "content_sanskrit": "शूरोऽसि यदि सङ्ग्रामे दर्शयस्व सभां विना\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2141219, "chapter_id": 4048, "verse_number": "५", "content_sanskrit": "यद्यशक्तोऽसि वीरेण पार्थेनाद्भुतकर्मणा ।\nपुनरेव सभां गत्वा धार्तराष्ट्रेण धीमता\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2141220, "chapter_id": 4048, "verse_number": "६", "content_sanskrit": "मातुलं परिगृह्याशु मन्त्रयस्व यथायथम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2141221, "chapter_id": 4048, "verse_number": "७", "content_sanskrit": "एवमुक्तस्तदा कर्णः क्रोधादुद्वृत्तलोचनः ।\nद्रोणपुत्रमिदं वाक्यमुवाच कुरुसन्निधौ\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2141222, "chapter_id": 4048, "verse_number": "८", "content_sanskrit": "नाहं बिभेमि बीभत्सोर्न कृष्णाद् देवकीसुतात् ।\nपाण्डवेभ्योऽपि सर्वेभ्यः क्षत्रधर्ममनुव्रतः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2141223, "chapter_id": 4048, "verse_number": "९", "content_sanskrit": "सत्वाधिकानां पुंसां हि धनुर्वेदोपजीविनाम् ।\nगर्जनात् जायते दर्पः स्वरश्च न विषीदति\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2141224, "chapter_id": 4048, "verse_number": "१०", "content_sanskrit": "पश्यत्वाचार्यपुत्रो मामर्जुनेनापरं सह ।\nयुध्यमानं सुसंयुक्तं जयो वै मय्यवस्थितः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2141225, "chapter_id": 4048, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2141226, "chapter_id": 4048, "verse_number": "११", "content_sanskrit": "ततः प्रहस्य बीभत्सुः कौन्तेयः श्वेतवाहनः ।\nदिव्यमस्त्रं विकुर्वाणः प्रत्ययाद् रथसत्तमान्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2141227, "chapter_id": 4048, "verse_number": "१२", "content_sanskrit": "महामना मन्दबुद्धिः निःश्वसन् धृतराष्ट्रजः ।\nउवाच स महाबाहुं कर्णं दुर्योधनस्तदा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2141228, "chapter_id": 4048, "verse_number": "१३", "content_sanskrit": "न विद्म ह्यर्जुनं तत्र वसन्तं मात्स्यवेश्मनि ।\nतेनेदं कर्ण मत्स्यानामग्रहीष्म धनं बहु\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2141229, "chapter_id": 4048, "verse_number": "१४", "content_sanskrit": "इतः परं चेद् गच्छामो विसृजन्तो धनं बहु ।\nअयशो नातिवर्तेत लोकयोरुभयोरपि\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2141230, "chapter_id": 4048, "verse_number": "१५", "content_sanskrit": "न च युद्धात् परं नास्ति क्षत्रियाणां सुखावहम् ।\nतस्मात् पार्थेन सङ्ग्रामं कुर्महे न पलायनम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2141231, "chapter_id": 4048, "verse_number": "१६", "content_sanskrit": "एतावदुक्त्वा राजा वै ह्यभियानमियेष सः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2141232, "chapter_id": 4048, "verse_number": "१७", "content_sanskrit": "तानि पञ्चसहस्राणि वीराणां हि धनुष्मताम् ।\nअभ्यद्रवंस्तदा पार्थं शलभा इव पावकम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2141233, "chapter_id": 4048, "verse_number": "१८", "content_sanskrit": "वर्मिता वाजिनस्तत्र संवृताश्च पदातिभिः ।\nभीमरूपाश्च मातङ्गास्तोमराङ्कुशपाणिभिः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2141234, "chapter_id": 4048, "verse_number": "१९", "content_sanskrit": "अधिष्ठिताः सुसंयत्तैर्हस्तिशिक्षाविशारदैः ।\nअभ्यद्रवन्त सङ्क्रुद्धाः चापहस्तोद्यतायुधैः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2141235, "chapter_id": 4048, "verse_number": "२०", "content_sanskrit": "पञ्च चैनं रथोदग्राः सहिताः पर्यवारयन् ।\nद्रोणो भीष्मश्च कर्णश्च कुरुराजश्च वीर्यवान्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2141236, "chapter_id": 4048, "verse_number": "२१", "content_sanskrit": "अश्वत्थामा महाबाहुर्धनुर्वेदपरायणः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2141237, "chapter_id": 4048, "verse_number": "२२", "content_sanskrit": "कृपप्रभृतयश्चान्ये शकुनिर्धृतराष्ट्रजाः ।\nइषूंश्च सम्यगस्यन्तो जीमूता इव वार्षिकाः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2141238, "chapter_id": 4048, "verse_number": "२३", "content_sanskrit": "ते लाभमिव मन्वानाः प्रत्यगृह्णन् धनञ्जयम् ।\nशरौघानभिवर्षन्तो नादयन्तो दिशो दश\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2141239, "chapter_id": 4048, "verse_number": "२४", "content_sanskrit": "ततः प्रहस्य बीभत्सुः कौन्तेयः श्वेतवाहनः ।\nदिव्यमस्त्रं विकुर्वाणः प्रत्ययाद् रथसत्तमान्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2141240, "chapter_id": 4048, "verse_number": "२५", "content_sanskrit": "यथा रश्मिभिरादित्यः प्रच्छादयति मेदिनीम् ।\nतथा गाण्डीवविनिर्मुक्ताश्छादयन्ति शरा दिशः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2141241, "chapter_id": 4048, "verse_number": "२६", "content_sanskrit": "न रथानां न चाश्वानां न ध्वजानां न हस्तिनाम् ।\nअतिविद्धैः शितैर्बाणैरासीद् विद्धमनन्तरम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2141242, "chapter_id": 4048, "verse_number": "२७", "content_sanskrit": "दैवयोगाद्धि पार्थस्य हयानामुत्तरस्य च ।\nशिक्षाबलोपपन्नत्वादस्त्राणां वै पराक्रमात्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2141243, "chapter_id": 4048, "verse_number": "२८", "content_sanskrit": "ध्वजगाण्डीवयोश्चापि दैवीमायाकृतेति च ।\nइतस्ततश्च संयाने दूरे वाऽप्यथवाऽन्तिके\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2141244, "chapter_id": 4048, "verse_number": "२९", "content_sanskrit": "दुर्गे विषमजाते वा स्थले निम्ने तथा क्षितौ ।\nन च रुद्ध्येद् गतिस्तस्य रथस्य मनसो यथा\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2141245, "chapter_id": 4048, "verse_number": "३०", "content_sanskrit": "समरेषु तु विद्वांसस्तस्य तांस्तान् पराक्रमान् ।\nवीर्यमद्भुततमं दृष्ट्वा तथा पार्थस्य तद्बलम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2141246, "chapter_id": 4048, "verse_number": "३१", "content_sanskrit": "त्रेसुरेव परे भीताः पराङ्मुखरथा अपि\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2141247, "chapter_id": 4048, "verse_number": "३२", "content_sanskrit": "कालाग्निमिव बीभत्सुं निर्दहन्तमिव प्रजाः ।\nनारयः प्रेक्षितुं शेकुर्ज्वलन्तमिव पावकम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2141248, "chapter_id": 4048, "verse_number": "३३", "content_sanskrit": "तानि भिन्नान्यनीकानि रेजुरर्जुनमार्गणैः ।\nतिग्मांशोश्च वनाग्राणि व्याप्तानीव गभस्तिभिः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2141249, "chapter_id": 4048, "verse_number": "३४", "content_sanskrit": "अशोकानां वनानीव सञ्चितैः कुसुमैः शुभैः ।\nपार्थः संरञ्जयामास रुधिरेणाकुलं बलम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2141250, "chapter_id": 4048, "verse_number": "३५", "content_sanskrit": "सहस्रशोऽर्जुनशरैः छिन्नान्युच्चावचानि च ।\nछत्राणि च पताकाश्च खेऽभ्युवाह सदागतिः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2141251, "chapter_id": 4048, "verse_number": "३६", "content_sanskrit": "ये ह्यर्जुनबलत्रस्ताः परिपेतुर्दिशो दश ।\nरथाङ्गदेशमुत्सृज्य पार्थच्छिन्नयुगा हयाः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2141252, "chapter_id": 4048, "verse_number": "३७", "content_sanskrit": "निकृत्तपूर्वचरणास्ते निपेतुः शितैः शरैः ।\nशिरोभिः प्रथमं जग्मुर्मेदिनीं जघनैः पुनः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2141253, "chapter_id": 4048, "verse_number": "३८", "content_sanskrit": "मुखनखविषाणेषु दन्तवेष्टेषु च द्विपान् ।\nमर्मस्वन्येषु चाहत्य तथा जघ्ने गजोत्तमान्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2141254, "chapter_id": 4048, "verse_number": "३९", "content_sanskrit": "चक्षुर्नसिविषाणेषु पादेषूरःसु च द्विपान् ।\nमर्मस्वन्येषु चाहत्य पातयामास भूतळे\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2141255, "chapter_id": 4048, "verse_number": "४०", "content_sanskrit": "कौरवाणां गजानां च शरीरैर्गतचेतसाम् ।\nक्षणेन संवृता भूमिर्मेघैरिव नभःस्थलम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2141256, "chapter_id": 4048, "verse_number": "४१", "content_sanskrit": "अस्त्रैर्दिव्यैर्महाबाहुरर्जुनः प्रदहन्निव ।\nबडवामुखसम्भूतः कालाग्निरिव सर्वतः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2141257, "chapter_id": 4048, "verse_number": "४२", "content_sanskrit": "यथा युगान्तसमये सर्वं स्थावरजङ्गमम् ।\nकालपक्वमशेषेण धक्ष्यत्युग्रशिखः शिखी\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2141258, "chapter_id": 4048, "verse_number": "४३", "content_sanskrit": "तद्वत् पार्थोऽस्त्रतेजोभिर्धनुषो निस्वनेन च ।\nदैवाद् वीर्याच्च बीभत्सुस्तस्मिन् दौर्योधने बले\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2141259, "chapter_id": 4048, "verse_number": "४४", "content_sanskrit": "रणशक्तिममित्राणां प्रायेणोपनिनाय सः ।\nचेष्टां प्रायेण भूतानां रात्रिः प्राणभृतामिव\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2141260, "chapter_id": 4048, "verse_number": "४५", "content_sanskrit": "सोऽत्ययात् सहसा शत्रून् समरे वासवोपमः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2141261, "chapter_id": 4048, "verse_number": "४६", "content_sanskrit": "शीघ्रं दूरं दृढामोघमस्त्रमस्यातिमानुषम् ।\nदृष्ट्वा ते कौरवा भीता अतिमानुषविक्रमम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2141262, "chapter_id": 4048, "verse_number": "४७", "content_sanskrit": "खगयानाभिसंवीतैः संविष्टैः खगमैरिव ।\nअर्जुनेन समावव्रे लोहितप्रवणैः खगैः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2141263, "chapter_id": 4048, "verse_number": "४८", "content_sanskrit": "अर्जुनस्य विनिर्मुक्ताः शरा गाण्डीवधन्वनः ।\nतार्क्ष्यवेगा इवाकाशे न ससञ्जुः परात्मसु\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2141264, "chapter_id": 4048, "verse_number": "४९", "content_sanskrit": "वर्माणि सारथिश्चैव हेमजालानि वाजिनाम् ।\nकिरीटं सूर्यसङ्काशं वैयाघ्रमथ चर्म च\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2141265, "chapter_id": 4048, "verse_number": "५०", "content_sanskrit": "तथा सर्वाणि गात्राणि रथस्य द्विषतां शरैः ।\nनीहारेणेव भूतानि छन्नान्यथ चकाशिरे\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2141266, "chapter_id": 4048, "verse_number": "५१", "content_sanskrit": "सकृतेऽवकृतं शेकू रथमभ्यसितुं परे ।\nअनभ्यस्तः पुनस्तैर्हि रथः सोऽभिपपात तान्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2141267, "chapter_id": 4048, "verse_number": "५२", "content_sanskrit": "तच्छरा द्विः शरीरेषु यथा च न ससञ्जिरे ।\nद्विधानीकेषु बीभत्सोर्न ससञ्ज रथस्तथा\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2141268, "chapter_id": 4048, "verse_number": "५३", "content_sanskrit": "स तद्वत् क्षोभयामास विगाह्यारिबलं रथी ।\nअनन्तवेगो भुजगः क्रीडन्निव महार्णवे\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2141269, "chapter_id": 4048, "verse_number": "५४", "content_sanskrit": "अस्यतो नित्यमत्यर्थं सर्वघोषातिगस्तथा ।\nसन्नादः श्रूयते भूतैर्धनुषश्च किरीटिनः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2141270, "chapter_id": 4048, "verse_number": "५५", "content_sanskrit": "सञ्छिन्नास्तत्र मातङ्गा बाणैरल्पान्तरान्तरे ।\nसंस्यूतास्तत्र दृश्यन्ते मेघा इव गभस्तिभिः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2141271, "chapter_id": 4048, "verse_number": "५६", "content_sanskrit": "दिशोऽनुभ्रमतः सर्वाः सव्यं दक्षिणमस्यतः ।\nसततं दृश्यते युद्धे सायकासनमण्डलम्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2141272, "chapter_id": 4048, "verse_number": "५७", "content_sanskrit": "पतन्त्यरूपेषु यथा चक्षूंषि न कदाचन ।\nनालक्ष्येषु शराः पेतुस्तथा गाण्डीवधन्वनः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2141273, "chapter_id": 4048, "verse_number": "५८", "content_sanskrit": "मार्गो गजसहस्रस्य युगपन्मर्दतो वनम् ।\nकौन्तेयरथमार्गस्तु रणे घोरतरोऽभवत्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2141274, "chapter_id": 4048, "verse_number": "५९", "content_sanskrit": "नूनं पार्थजयैषित्वात् शक्रः सर्वामरेश्वरः ।\nहन्त्यस्मानिति मन्यन्ते पार्थेनैवार्दिताः परे\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2141275, "chapter_id": 4048, "verse_number": "६०", "content_sanskrit": "घ्नन्तमत्यर्थभीतास्ते मेनिरे सव्यसाचिनम् ।\nकालमर्जुनरूपेण ग्रसन्तमिव च प्रजाः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2141276, "chapter_id": 4048, "verse_number": "६१", "content_sanskrit": "कुरुसेनाशरीराणि पार्थेनानाहतान्यपि ।\nपेतुः पार्थहतानीव पार्थकर्मानुदर्शनात्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2141277, "chapter_id": 4048, "verse_number": "६२", "content_sanskrit": "ओषधीनां शिरांसीव कालपङ्क्तिसमन्वयात् ।\nअवनेमुः कुरूणां हि वीर्याण्यर्जुनजाद् भयात्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2141278, "chapter_id": 4048, "verse_number": "६३", "content_sanskrit": "बाह्वो रथान् स्फोटयते प्रध्माते शङ्खमर्जुनः ।\nचकार चार्जुनीकत्वं द्विमुखान् रुषितानपि\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2141279, "chapter_id": 4048, "verse_number": "६४", "content_sanskrit": "अर्जुनेनास्त्रभिन्नानि बलाग्राणि पुनः क्वचित् ।\nचक्रुर्लोहितधाराभिर्धरणीं लोहितोत्तराम्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2141280, "chapter_id": 4048, "verse_number": "६५", "content_sanskrit": "लोहितैर्वापि सम्पृक्तैः पांसुभिः पवनोद्धतैः ।\nतेनैव च समुद्धूतैः सूक्ष्मैर्लोहितबिन्दुभिः\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2141281, "chapter_id": 4048, "verse_number": "६६", "content_sanskrit": "लोहितार्द्रैः प्रहरणैर्निमग्ना लोहितोक्षिताः ।\nलोहितेषु निमग्नास्ते निहताश्च किरीटिना\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2141282, "chapter_id": 4048, "verse_number": "६७", "content_sanskrit": "बभूवुर्लोहितास्तत्र भृशमादित्यरश्मयः ।\nसार्कं नभः क्षणेनासीत् सन्ध्याभ्रमिव लोहितम्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2141283, "chapter_id": 4048, "verse_number": "६८", "content_sanskrit": "अप्यस्तं प्राप्य चादित्यो निवर्तेत न पाण्डवः ।\nनिवर्तेत नजित्वाऽरीन् इत्यजल्पन् विचक्षणाः\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2141284, "chapter_id": 4048, "verse_number": "६९", "content_sanskrit": "तान् सर्वान् समरे शूरान् पौरुषे पर्यवस्थितान् ।\nदिव्यैरस्त्रैरमेयात्मा सर्वानार्च्छद् धनुर्धरान्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2141285, "chapter_id": 4048, "verse_number": "७०", "content_sanskrit": "स तु द्रोणं त्रिसप्तत्या नाराचानां समर्पयत् ।\nअर्जुनो निशितैर्बाणैर्द्रोणमर्चन् महाबलः\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2141286, "chapter_id": 4048, "verse_number": "७१", "content_sanskrit": "अशीत्या शकुनिं चैव द्रौणिमप्याशु सप्तभिः ।\nदुःसहं दशभिर्बाणैरर्जुनः समविध्यत\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2141287, "chapter_id": 4048, "verse_number": "७२", "content_sanskrit": "दुःशासनं द्वादशभिः कृपं शारद्वतं त्रिभिः ।\nभीष्मं शान्तनवं षष्ट्या प्रत्यविध्यत् स्तनान्तरे\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2141288, "chapter_id": 4048, "verse_number": "७३", "content_sanskrit": "स कर्णं कर्णिनाऽविध्यत् स्फीतेन निशितेन च ।\nवासविर्द्विषतां मध्ये विव्याध परमेषुणा\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2141289, "chapter_id": 4048, "verse_number": "७४", "content_sanskrit": "तत् प्रभिन्नं बलं सर्वं कृत्वा वासवनन्दनः ।\nस कर्णं कर्णिनाऽविध्यत् स्फीतेन निशितेन च\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2141290, "chapter_id": 4048, "verse_number": "७५", "content_sanskrit": "स कर्णं सतनुत्राणं निर्भिद्य निशितः शरः ।\nअगच्छद् दारयन् भूमिं चोदितो दृढधन्विना\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2141291, "chapter_id": 4048, "verse_number": "७६", "content_sanskrit": "ततोऽस्य वाहान् व्यहनत् चतुर्भिश्च क्षुरेण तु ।\nसारथेश्च शिरः कायादपाहरदरिन्दमः\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2141292, "chapter_id": 4048, "verse_number": "७७", "content_sanskrit": "अर्धचन्द्रेण चिच्छेद चापं तस्य करे स्थितम्\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2141293, "chapter_id": 4048, "verse_number": "७८", "content_sanskrit": "तस्मिन् विद्धे महाभाग कर्णे सर्वास्त्रपारगे ।\nहताश्वसूते विरथे ततोऽनीकमभज्यत\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2141294, "chapter_id": 4048, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि षट्पञ्चाशोऽध्यायः ॥५६॥ गोग्रहणपर्वणि एकोनस्त्रिंशोऽध्यायः ॥२९॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}]