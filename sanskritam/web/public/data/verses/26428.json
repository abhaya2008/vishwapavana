[{"id": 7006428000, "chapter_id": 26428, "verse_number": "२-८८-१", "content_sanskrit": "जनमेजय उवाच\nमुनेऽन्धकवधः श्राव्यः श्रुतोऽयं खलु भो मया।\nशक्तिस्त्रयाणां लोकानां कृता देवेन धीमता ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006428001, "chapter_id": 26428, "verse_number": "२-८८-२", "content_sanskrit": "निकुम्भस्य हतं देहं द्वितीयं चक्रपाणिना ।\nयदर्थं च यथा चैव तद् भवान् वक्तुमर्हति ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006428002, "chapter_id": 26428, "verse_number": "२-८८-३", "content_sanskrit": "वैशम्पायन उवाच\nश्रद्दधानस्य राजेन्द्र वक्तव्यं भवतोऽनघ ।\nचरितं लोकनाथस्य हरेरमिततेजसः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006428003, "chapter_id": 26428, "verse_number": "२-८८-४", "content_sanskrit": "द्वारवत्यां निवसतो विष्णोरतुलतेजसः ।\nसमुद्रयात्रा सम्प्राप्ता तीर्थे पिण्डारके नृप ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006428004, "chapter_id": 26428, "verse_number": "२-८८-५", "content_sanskrit": "उग्रसेनो नरपतिर्वसुदेवश्च भारत ।\nनिक्षिप्तौ नगराध्यक्षौ शेषाः सर्वे विनिर्गताः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006428005, "chapter_id": 26428, "verse_number": "२-८८-६", "content_sanskrit": "पृथग्बलः पृथग्धीमाँल्लोकनाथो जनार्दनः ।\nगोष्ठ्यः पृथक्कुमाराणां नृदेवामिततेजसाम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006428006, "chapter_id": 26428, "verse_number": "२-८८-७", "content_sanskrit": "गणिकानां सहस्राणि निःसृतानि नराधिप ।\nकुमारैः सह वार्ष्णेयै रूपवद्भिः स्वलंकृतैः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006428007, "chapter_id": 26428, "verse_number": "२-८८-८", "content_sanskrit": "दैत्याधिवासं निर्जित्य यदुभिर्दृढविक्रमैः ।\nवेश्या निवेशिता वीर द्वारवत्यां सहस्रशः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006428008, "chapter_id": 26428, "verse_number": "२-८८-९", "content_sanskrit": "सामान्यास्ताः कुमाराणां क्रीडानार्यो महात्मनाम् ।\nइच्छाभोग्या गुणैरेव राजन्या वेषयोषितः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006428009, "chapter_id": 26428, "verse_number": "२-८८-१०", "content_sanskrit": "स्थितिरेषा हि भैमानां कृता कृष्णेन धीमता ।\nस्त्रीनिमित्तं भवेद् वैरं मा यदूनामिति प्रभो ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006428010, "chapter_id": 26428, "verse_number": "२-८८-११", "content_sanskrit": "रेवत्या चैकया सार्धं बलो रेमेऽनुकूलया ।\nचक्रवाकानुरागेण यदुश्रेष्ठः प्रतापवान् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006428011, "chapter_id": 26428, "verse_number": "२-८८-१२", "content_sanskrit": "कादम्बरीपानकलो भूषितो वनमालया ।\nचिक्रीड सागरजले रेवत्या सहितो बलः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006428012, "chapter_id": 26428, "verse_number": "२-८८-१३", "content_sanskrit": "षोडश स्त्रीसहस्राणि जले जलजलोचनः ।\nरमयामास गोविन्दो विश्वरूपेण सर्वदृक् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006428013, "chapter_id": 26428, "verse_number": "२-८८-१४", "content_sanskrit": "अहमिष्टा मया सार्द्धं जले वसति केशवः ।\nइति ता मेनिरे सर्वा रात्रौ नारायणस्त्रियः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006428014, "chapter_id": 26428, "verse_number": "२-८८-१५", "content_sanskrit": "सर्वाः सुरतचिह्नाङ्ग्यः सर्वाः सुरततर्पिताः ।\nमानमूहुश्च ताः सर्वा गोविन्दे बहुमानजम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006428015, "chapter_id": 26428, "verse_number": "२-८८-१६", "content_sanskrit": "अहमिष्टाहमिष्टेति स्निग्धे परिजने तदा ।\nनारायणस्त्रियः सर्वा मुदा शश्लाघिरे शुभाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006428016, "chapter_id": 26428, "verse_number": "२-८८-१७", "content_sanskrit": "करजद्विजचिह्नानि कुचाधरगतानि ताः ।\nदृष्ट्वा दृष्ट्वा जहृषिरे दर्पणे कमलेक्षणाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006428017, "chapter_id": 26428, "verse_number": "२-८८-१८", "content_sanskrit": "गोत्रमुद्दिश्य कृष्णस्य जगिरे कृष्णयोषितः ।\nपिबन्त्य इव कृष्णस्य नयनैर्वदनाम्बुजम् ॥ १८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006428018, "chapter_id": 26428, "verse_number": "२-८८-१९", "content_sanskrit": "कृष्णार्पितमनोदृष्ट्यः कान्ता नारायणस्त्रियः ।\nमनोहरतरा राजन्नभवन्नेकनिश्चयाः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006428019, "chapter_id": 26428, "verse_number": "२-८८-२०", "content_sanskrit": "एकार्पितमनोदृष्ट्यो नेर्ष्यां ताश्चक्रिरेऽङ्गनाः ।\nनारायणेन देवेन तर्प्यमाणमनोरथाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006428020, "chapter_id": 26428, "verse_number": "२-८८-२१", "content_sanskrit": "शिरांसि गर्वितान्यूहुः सर्वा निरवशेषतः ।\nवाल्लभ्यं केशवमयं वहन्त्यश्चारुदर्शनाः ॥  २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006428021, "chapter_id": 26428, "verse_number": "२-८८-२२", "content_sanskrit": "ताभिस्तु सह चिक्रीड सर्वाभिर्हरिरात्मवान् ।\nविश्वरूपेण विधिना समुद्रे विमले जले ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006428022, "chapter_id": 26428, "verse_number": "२-८८-२३", "content_sanskrit": "उवाह सर्वगन्धाढ्यं स्वच्छं वारि महोदधिः ।\nतोयं विलक्षणं मृष्टं वासुदेवस्य शासनात् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006428023, "chapter_id": 26428, "verse_number": "२-८८-२४", "content_sanskrit": "गुल्फदघ्नं जानुदघ्नमूरुदघ्नमथापि वा ।\nनार्यस्ताः स्तनदघ्नं वा जलं समभिकाङ्क्षितम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006428024, "chapter_id": 26428, "verse_number": "२-८८-२५", "content_sanskrit": "सिषिचुः केशवं पत्न्यो धारा इव महोदधिम् ।\nसिषेच ताश्च गोविन्दो मेघः फुल्ललता इव ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006428025, "chapter_id": 26428, "verse_number": "२-८८-२६", "content_sanskrit": "अवलम्ब्य पराः कण्ठे हरि हरिणलोचनाः ।\nउपगूहस्व मां वीर पतामीत्यब्रुवन् स्त्रियः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006428026, "chapter_id": 26428, "verse_number": "२-८८-२७", "content_sanskrit": "काश्चित् काष्ठमयैस्तेरुः प्लवैः सर्वाङ्गशोभनाः ।\nक्रौञ्चबर्हिणनागानामाकारसदृशैः स्त्रियः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006428027, "chapter_id": 26428, "verse_number": "२-८८-२८", "content_sanskrit": "मकराकृतिभिश्चान्या मीनाभैरपि चापराः ।\nबहुरूपाकृतिधरैः पुप्लुवुश्चापराः स्त्रियः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006428028, "chapter_id": 26428, "verse_number": "२-८८-२९", "content_sanskrit": "स्तनकुम्भैस्तथा तेरुः कुम्भैरिव तथापराः ।\nसमुद्रसलिले रम्ये हर्षयन्त्यो जनार्दनम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006428029, "chapter_id": 26428, "verse_number": "२-८८-३०", "content_sanskrit": "रराम सह रुक्मिण्या जले तस्मिन् मुदा युतः ।\nयेनैव कार्ययोगेन रमतेऽमरसत्तमः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006428030, "chapter_id": 26428, "verse_number": "२-८८-३१", "content_sanskrit": "तत् तदेव हि ताश्चकुर्मुदा नारायणस्त्रियः ।\nतनुवस्त्रावृतास्तन्व्यो लीलयन्त्यस्तथापराः ।\nचिक्रीडुर्वासुदेवस्य जले जलजलोचनाः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006428031, "chapter_id": 26428, "verse_number": "२-८८-३२", "content_sanskrit": "यस्या यस्यास्तु यो भावस्तां तां तेनैव केशवः ।\nअनुप्रविश्य भावज्ञो निनायात्मवशं वशी ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006428032, "chapter_id": 26428, "verse_number": "२-८८-३३", "content_sanskrit": "हृषीकेशोऽपि भगवान् हृषीकेशः सनातनः ।\nबभूव देशकालेन कान्तावशगतः प्रभुः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006428033, "chapter_id": 26428, "verse_number": "२-८८-३४", "content_sanskrit": "कुलशीलसमोऽस्माकं योग्योऽयमिति मेनिरे ।\nवंशरूपेण वर्तन्तमङ्गनास्ता जनार्दनम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006428034, "chapter_id": 26428, "verse_number": "२-८८-३५", "content_sanskrit": "तदा दाक्षिण्ययुक्तं तं स्मितपूर्वाभिभाषिणम् ।\nकृष्णं भार्याश्चकमिरे भक्त्या च बहु मेनिरे ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006428035, "chapter_id": 26428, "verse_number": "२-८८-३६", "content_sanskrit": "पृथग्गोष्ठ्यः कुमाराणां प्रकाशं स्त्रीगणैः सह ।\nअलंचक्रुर्जलं वीराः सागरस्य गुणाकराः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006428036, "chapter_id": 26428, "verse_number": "२-८८-३७", "content_sanskrit": "गीतनृत्यविधिज्ञानां तासां स्त्रीणां जनेश्वर ।\nतेजसाप्याहृतानां ते दाक्षिण्यात् तस्थिरे वशे ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006428037, "chapter_id": 26428, "verse_number": "२-८८-३८", "content_sanskrit": "शृण्वन्तश्चारुगीतानि तथा स्वभिनयान्यपि ।\nतूर्याण्युत्तमनारीणां मुमुहुर्यदुपुङ्गवाः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006428038, "chapter_id": 26428, "verse_number": "२-८८-३९", "content_sanskrit": "पञ्चचूडां ततः कृष्णः कौबेर्यश्च वराप्सराः ।\nमाहेन्द्रीश्चानयामास विश्वरूपेण हेतुना ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006428039, "chapter_id": 26428, "verse_number": "२-८८-४०", "content_sanskrit": "ताः प्रोवाचाप्रमेयात्मा सान्त्वयित्वा जगत्प्रभुः ।\nउत्थापयित्वा प्रणताः कृताञ्जलिपुटास्तथा ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006428040, "chapter_id": 26428, "verse_number": "२-८८-४१", "content_sanskrit": "क्रीडायुवत्यो भैमानां प्रविशध्वमशङ्किताः ।\nमत्प्रियार्थं वरारोहा रमयध्वं च यादवान् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006428041, "chapter_id": 26428, "verse_number": "२-८८-४२", "content_sanskrit": "दर्शयध्वं गुणान् सर्वान् नृत्यगीतै रहःसु च ।\nतथाभिनययोगेषु वाद्येषु विविधेषु च ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006428042, "chapter_id": 26428, "verse_number": "२-८८-४३", "content_sanskrit": "एवं कृते विधास्यामि श्रेयो वो मनसेप्सितम् ।\nमच्छरीरसमा ह्येते सर्वे निरवशेषतः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006428043, "chapter_id": 26428, "verse_number": "२-८८-४४", "content_sanskrit": "शिरसाज्ञां तु ताः सर्वाः प्रतिगृह्य हरेस्तदा ।\nक्रीडायुवत्यो विविशुर्भैमानामप्सरोवराः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006428044, "chapter_id": 26428, "verse_number": "२-८८-४५", "content_sanskrit": "ताभिः प्रविष्टमात्राभिर्द्योतितः स महार्णवः ।\nसौदामिनीभिर्नभसि घनवृन्दमिवानघ ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006428045, "chapter_id": 26428, "verse_number": "२-८८-४६", "content_sanskrit": "ता जले स्थलवत्स्थित्वा जगुश्चाप्यथ वादयन् ।\nचक्रुश्चाभिनयं सम्यक्स्वर्गावास इवाङ्गनाः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006428046, "chapter_id": 26428, "verse_number": "२-८८-४७", "content_sanskrit": "गन्धैर्माल्यैश्च ता दिव्यैर्वस्त्रैश्चायतलोचनाः ।\nहेलाभिर्हास्यभावैश्च जह्रुर्भैममनांसि ताः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006428047, "chapter_id": 26428, "verse_number": "२-८८-४८", "content_sanskrit": "कटाक्षैरिङ्गितैर्हास्यैः केलिरोषैः प्रसादितैः ।\nमनोऽनुकूलैर्भैमानां समाजह्रुर्मनांसि ताः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006428048, "chapter_id": 26428, "verse_number": "२-८८-४९", "content_sanskrit": "उत्क्षिप्योत्क्षिप्य चाकाशं वातस्कन्धान् बहूंश्च तान् ।\nमदिरावशगा भैमा मानयन्ति वराप्सराः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006428049, "chapter_id": 26428, "verse_number": "२-८८-५०", "content_sanskrit": "कृष्णोऽपि तेषां प्रीत्यर्थं विजह्रे वियतिं प्रभुः ।\nसर्वैः षोडशभिः सार्द्धं स्त्रीसहस्रैर्मुदान्वितः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006428050, "chapter_id": 26428, "verse_number": "२-८८-५१", "content_sanskrit": "प्रभावज्ञास्तु ते वीराः कृष्णस्यामिततेजसः ।\nन जग्मुर्विस्मयं भैमा गाम्भीर्यं परमास्थिताः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006428051, "chapter_id": 26428, "verse_number": "२-८८-५२", "content_sanskrit": "केचिद् रैवतकं गत्वा पुनरायान्ति भारत ।\nगृहान्यन्ये वनान्यन्ये काङ्क्षितान्यरिमर्दन ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006428052, "chapter_id": 26428, "verse_number": "२-८८-५३", "content_sanskrit": "अपेयः पेयसलिलः सागरश्चाभवत् तदा ।\nआज्ञया लोकनाथस्य विष्णोरतुलतेजसः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006428053, "chapter_id": 26428, "verse_number": "२-८८-५४", "content_sanskrit": "अधावन् स्थलवच्चापि जले जलजलोचनाः ।\nगृह्य हस्ते तथा नार्यो युक्तामज्जंस्तथापि च ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006428054, "chapter_id": 26428, "verse_number": "२-८८-५५", "content_sanskrit": "भक्ष्यभोज्यानि पेयानि चोष्यं लेह्यं तथैव च ।\nबहुप्रकारं मनसा ध्याते तेषां भवत्युत ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006428055, "chapter_id": 26428, "verse_number": "२-८८-५६", "content_sanskrit": "अम्लानमाल्यधारिण्यस्ताः स्त्रियस्ताननिन्दितान् ।\nरहःसु रमयांचक्रुः स्वर्गे देवरतानुगाः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006428056, "chapter_id": 26428, "verse_number": "२-८८-५७", "content_sanskrit": "नौभिर्गृहप्रकाराभिश्चिक्रीडुरपराजिताः ।\nस्नातानुलिप्तमुदिताः सायाह्नेऽन्धकवृष्णयः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006428057, "chapter_id": 26428, "verse_number": "२-८८-५८", "content_sanskrit": "आयताश्चतुरस्राश्च वृत्ताश्च स्वस्तिकास्तथा ।\nप्रासादा नौषु कौरव्य विहिता विश्वकर्मणा ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006428058, "chapter_id": 26428, "verse_number": "२-८८-५९", "content_sanskrit": "कैलासमन्दरच्छन्दा मेरुच्छन्दास्तथैव च ।\nतथा नानावयश्छन्दास्तथेहामृगरूपिणः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006428059, "chapter_id": 26428, "verse_number": "२-८८-६०", "content_sanskrit": "वैडूर्यतोरणैश्चित्राश्चित्राभिर्मणिभक्तिभिः ।\nमसारगल्वर्कमयैश्चित्रभक्तिशतैरपि ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006428060, "chapter_id": 26428, "verse_number": "२-८८-६१", "content_sanskrit": "आक्रीडगरुडच्छन्दाश्चित्राः कनकरीतिभिः ।\nक्रौञ्चच्छन्दाः शुकच्छन्दा गजच्छन्दास्तथापरे ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006428061, "chapter_id": 26428, "verse_number": "२-८८-६२", "content_sanskrit": "कर्णधारैर्गृहीतास्ता नावः कार्तस्वरोज्ज्वलाः ।\nसलिलं शोभयामासुः सागरस्य महोर्मिमत् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006428062, "chapter_id": 26428, "verse_number": "२-८८-६३", "content_sanskrit": "समुच्छ्रितः सितैः पोतैर्यानपात्रैस्तथैव च ।\nनौभिश्च झिल्लिकाभिश्च शुशुभे वरुणालयः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006428063, "chapter_id": 26428, "verse_number": "२-८८-६४", "content_sanskrit": "पुराण्याकाशगानीव गन्धर्वाणामितस्ततः ।\nवभ्रमुः सागरजले भैमयानानि सर्वतः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006428064, "chapter_id": 26428, "verse_number": "२-८८-६५", "content_sanskrit": "नन्दनच्छन्दयुक्तेषु यानपात्रेषु भारत ।\nनन्दनप्रतिमं सर्वं विहितं विश्वकर्मणा ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006428065, "chapter_id": 26428, "verse_number": "२-८८-६६", "content_sanskrit": "उद्यानानि सभावृक्षा दीर्घिकाः स्यन्दनानि च ।\nनिवेशितानि शिल्पानि तादृशान्येव सर्वथा ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006428066, "chapter_id": 26428, "verse_number": "२-८८-६७", "content_sanskrit": "स्वर्गच्छन्देषु चान्येषु समासात्स्वर्गसंनिभाः ।\nनारायणाज्ञया वीर विहिता विश्वकर्मणा ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006428067, "chapter_id": 26428, "verse_number": "२-८८-६८", "content_sanskrit": "वनेषु रुरुवुर्हृद्यं मधुरं चैव पक्षिणः ।\nमनोहरतरं चैव भैमानामतितेजसाम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006428068, "chapter_id": 26428, "verse_number": "२-८८-६९", "content_sanskrit": "देवलोकोद्भवाः श्वेता विलेपुः कोकिलास्तदा ।\nमधुराणि विचित्राणि यदूनां काङ्क्षितानि च ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006428069, "chapter_id": 26428, "verse_number": "२-८८-७०", "content_sanskrit": "चन्द्रांशुसमरूपेषु हर्म्यपृष्ठेषु बर्हिणः ।\nननृतुर्मधुरारावाः शिखण्डिगणसंवृताः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006428070, "chapter_id": 26428, "verse_number": "२-८८-७१", "content_sanskrit": "पताका यानपात्राणां सर्वाः पक्षिगणायुताः ।\nभ्रमरैरुपगीताश्च स्रग्दामासक्तवासिभिः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006428071, "chapter_id": 26428, "verse_number": "२-८८-७२", "content_sanskrit": "नारायणाज्ञया वृक्षाः पुष्पाणि मुमुचुर्भृशम् ।\nऋतवश्चारुरूपाणि विहायसि गतास्तथा ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006428072, "chapter_id": 26428, "verse_number": "२-८८-७३", "content_sanskrit": "ववौ मनोहरो वातो रतिखेदहरः सुखः ।\nरजोभिः सर्वपुष्पाणां पृक्तश्चन्दनशैत्यभृत् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006428073, "chapter_id": 26428, "verse_number": "२-८८-७४", "content_sanskrit": "शीतोष्णमिच्छतां तत्र बभूव वसुधापते ।\nवासुदेवप्रसादेन भैमानां क्रीडतां तदा ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006428074, "chapter_id": 26428, "verse_number": "२-८८-७५", "content_sanskrit": "न क्षुत्पिपासा न ग्लानिर्न चिन्ता शोक एव च।\nआविवेश तदा भैमान् प्रभावाच्चक्रपाणिनः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006428075, "chapter_id": 26428, "verse_number": "२-८८-७६", "content_sanskrit": "अप्रशान्तमहातूर्या गीतनृत्योपशोभिताः ।\nबभूवुः सागरक्रीडा भैमानामतितेजसाम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006428076, "chapter_id": 26428, "verse_number": "२-८८-७७", "content_sanskrit": "बहुयोजनविस्तीर्णं समुद्रं सलिलाशयम् ।\nरुद्धा चिक्रीडुरिन्द्राभा भैमाः कृष्णाभिरक्षिताः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006428077, "chapter_id": 26428, "verse_number": "२-८८-७८", "content_sanskrit": "परिच्छदस्यानुरूपं यानपात्रं महात्मनः ।\nनारायणस्य देवस्य विहितं विश्वकर्मणा ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006428078, "chapter_id": 26428, "verse_number": "२-८८-७९", "content_sanskrit": "रत्नानि यानि त्रैलोक्ये विशिष्टानि विशाम्पते ।\nकृष्णस्य तानि सर्वाणि यानपात्रेऽतितेजसः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006428079, "chapter_id": 26428, "verse_number": "२-८८-८०", "content_sanskrit": "पृथक्पृथङ्निवासाश्च स्त्रीणां कृष्णस्य भारत ।\nमणिवैडूर्यचित्रास्ताः कार्तस्वरविभूषिताः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006428080, "chapter_id": 26428, "verse_number": "२-८८-८१", "content_sanskrit": "सर्वर्तुकुसुमाकीर्णाः सर्वगन्धाधिवासिताः ।\nयदुसिंहैः शुभैर्जुष्टाः शकुनैः स्वर्गवासिभिः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}]