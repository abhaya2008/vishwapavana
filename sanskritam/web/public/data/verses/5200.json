[{"id": 2197525, "chapter_id": 5200, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2197526, "chapter_id": 5200, "verse_number": "१", "content_sanskrit": "श्रुतं नराणां चापल्यं परस्त्रीषु प्रजायताम् ।\nप्रमदानां तु चापल्ये दोषमिच्छामि वेदितुम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2197527, "chapter_id": 5200, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2197528, "chapter_id": 5200, "verse_number": "२", "content_sanskrit": "एकवर्णोऽपि दोषं तु गमनं पूर्वकालिकम् ।\nधाता च समनुज्ञातो विष्णुना तत्तथाऽकरोत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2197529, "chapter_id": 5200, "verse_number": "३", "content_sanskrit": "भगलिङ्गे महाप्राज्ञ पूर्वमेव प्रजापतिः ।\nससर्ज ताभ्यां संयोगमनुज्ञातश्चकार सः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2197530, "chapter_id": 5200, "verse_number": "४", "content_sanskrit": "अथ विष्णुप्रसादेन भगो दत्तवरः किल ।\nतेन चैव प्रसादेन सर्वांल्लोकानुपाश्नुते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2197531, "chapter_id": 5200, "verse_number": "५", "content_sanskrit": "तस्मात्तु पुरुषे दोषो ह्यधिको नात्र संशयः ।\nविना गर्भं सवर्णेषु न त्याज्या गमनात् स्त्रियः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2197532, "chapter_id": 5200, "verse_number": "६", "content_sanskrit": "प्रायश्चित्तं यथान्यायं दण्डं कुर्यात् स पण्डितः ।\nश्वभिर्वा दंशनं स्नानं सवनत्रितयं निशि\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2197533, "chapter_id": 5200, "verse_number": "७", "content_sanskrit": "भूमौ च भस्मशयनं दानं भोगविवर्जितम् ।\nदोषगौरवतः कालो द्रव्यगौरवमेव च ।\nमर्यादा स्थापिता पूर्वमिति तीर्थान्तरं गते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2197534, "chapter_id": 5200, "verse_number": "८", "content_sanskrit": "तद्योषितां तु दीर्घायो नास्ति दोषो व्यतिक्रमे ।\nभगस्तीर्थान्तरे शुद्धो विष्णोस्तु वचनादिह\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2197535, "chapter_id": 5200, "verse_number": "९", "content_sanskrit": "रक्ष्याश्चैवान्यसंवादैरन्यगेहाद् विचक्षणैः ।\nआसां शुद्धौ विशेषेण कर्मणां फलमश्नुते\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2197536, "chapter_id": 5200, "verse_number": "१०", "content_sanskrit": "नैता वाच्या न वै वध्या न क्लेश्याः शुभमिच्छता ।\nविष्णुप्रसादादित्येव भगस्तीर्थान्तरं गतः ।\nमासिमासि रजस्तासां दुष्कृतानपकर्षति\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2197537, "chapter_id": 5200, "verse_number": "११", "content_sanskrit": "स्त्रियस्तोषकरा नॄणां स्त्रियस्तुष्टिप्रदाः सदा ।\nपुत्रसेतुप्रतिष्ठाय स्त्रियो लोके महाद्युते\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2197538, "chapter_id": 5200, "verse_number": "५१", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि\nदानधर्मे दानधर्मे योषित्प्रभावकथनं नाम एकपञ्चाशोऽध्यायः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2197539, "chapter_id": 5200, "verse_number": "", "content_sanskrit": "* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]