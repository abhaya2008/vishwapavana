[{"id": 2046621, "chapter_id": 2035, "verse_number": "६-८४-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2046622, "chapter_id": 2035, "verse_number": "६-८४-१", "content_sanskrit": "ततो युधिष्ठिरो राजा मध्यं प्राप्ते दिवाकरे।\nश्रुतायुपमभिप्रेक्ष्य प्रेषयामास वाजिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2046623, "chapter_id": 2035, "verse_number": "६-८४-२", "content_sanskrit": "ततस्तु त्वरितो राजञ्श्रुतायुषमरिन्दमन् ।\nनिजघ्ने सायकैस्तीक्ष्णैर्नवभिर्नतपर्वभिःक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2046624, "chapter_id": 2035, "verse_number": "६-८४-३", "content_sanskrit": "स संवार्य रमे राजा प्रेषितान्धर्मसूनुना ।\nशरान्सप्त महेष्वासः कौन्तेयाया समार्षयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2046625, "chapter_id": 2035, "verse_number": "६-८४-४", "content_sanskrit": "ते तस्व कवचं भित्त्वा पपुः शोणितमाहवे।\nअसूनिव विचिन्वन्तो देहे तस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2046626, "chapter_id": 2035, "verse_number": "६-८४-५", "content_sanskrit": "पाण्डवस्तु भृशं क्रुद्धो विद्धस्तेन महात्मना ।\nरणे वराहकर्णेन राजानं हृद्यविध्यता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2046627, "chapter_id": 2035, "verse_number": "६-८४-६", "content_sanskrit": "अथापरेण भल्लेन केतुं तस्य महात्मनः ।\nरथश्रेष्ठो रथात्तूर्णं भूमौ पार्थो न्यपातयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2046628, "chapter_id": 2035, "verse_number": "६-८४-७", "content_sanskrit": "केतु निपतितं दृष्ट्वा श्रुतायुः स तु पार्थिवः ।\nपाण्डवं विशिखैतीक्ष्णै राजन्विव्याध सप्तभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2046629, "chapter_id": 2035, "verse_number": "६-८४-८", "content_sanskrit": "ततः क्रोघात्प्रजज्वल धर्मपुत्रो युधिष्ठिरः ।\nयथा युगान्ते भूतानि दिधक्षुरिव पावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2046630, "chapter_id": 2035, "verse_number": "६-८४-९", "content_sanskrit": "क्रुद्धं तु पाण्डवं दृष्ट्वा देवगन्धर्वराक्षसाः ।\nप्रविव्यधुर्महाराज व्याकुलं जाप्यभूज्जगत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2046631, "chapter_id": 2035, "verse_number": "६-८४-१०", "content_sanskrit": "सर्वेषां चैव भूतानामिदमासीन्मनोगतम् ।\nत्रींल्लोकान्म संक्रुद्धो नृपोऽयं धक्ष्यतीति वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2046632, "chapter_id": 2035, "verse_number": "६-८४-११", "content_sanskrit": "ऋष..... देवाश्च चक्रुः स्वस्त्ययनं महत्।\nलोकानां नृपाशान्त्यर्थं क्रोधिते पाण्डवे तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2046633, "chapter_id": 2035, "verse_number": "६-८४-१२", "content_sanskrit": "स च क्रोधसमाविष्टः सृक्विणी परिसंलिहन ।\nइवारात्सवपुर्घोरं युगान्तादित्यसन्निभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2046634, "chapter_id": 2035, "verse_number": "६-८४-१३", "content_sanskrit": "ततः सैन्यानि सर्वाणि तावकानि विशांपते ।\nनिराशान्यभवंस्तत्र जीवितं प्रति भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2046635, "chapter_id": 2035, "verse_number": "६-८४-१४", "content_sanskrit": "स तु धैर्येण तं कोपं सन्निवार्य महायशाः ।\nश्रुतायुषः प्रचिच्छेद मुष्टिदेशे महाधनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2046636, "chapter_id": 2035, "verse_number": "६-८४-१५", "content_sanskrit": "अथैनं छिन्नधन्वानं नाराचेन स्तनान्तरे ।\nनिर्बिभेद रणे राजा सर्वसैन्यस्य पश्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2046637, "chapter_id": 2035, "verse_number": "६-८४-१६", "content_sanskrit": "सत्वरं च रणे राजंस्तस्य वाहान्महात्मनः ।\nनिजघान शरैः क्षिप्रं सूतं च सुमहाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2046638, "chapter_id": 2035, "verse_number": "६-८४-१७", "content_sanskrit": "हताश्वं तु रथं त्यक्त्वा दृष्ट्वा राज्ञोऽस्य पौरुषम् ।\nविप्रदुद्राव वेगेन श्रुतायुः समरे तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2046639, "chapter_id": 2035, "verse_number": "६-८४-१८", "content_sanskrit": "तस्मिञ्जिते महेष्वासे धर्मपुत्रेण संयुगे।\nदुर्योधनबलं राजन्सर्वमासीत्पराङ्भुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2046640, "chapter_id": 2035, "verse_number": "६-८४-१९", "content_sanskrit": "एवं जित्वा महाराज धर्मपुत्रो युधिष्ठिरः ।\nव्यात्ताननो यथा कालस्तव सैन्यं जघान ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2046641, "chapter_id": 2035, "verse_number": "६-८४-२०", "content_sanskrit": "चेकितानस्तु वार्ष्णेयो गौतमं रथिनां वरम् ।\nप्रेक्षतां सर्वसैन्यानां छादयामास सायकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2046642, "chapter_id": 2035, "verse_number": "६-८४-२१", "content_sanskrit": "संनिवार्य शरांस्तांस्तु कृपः शारद्वतो युधि।\nचेकितानां रणे यत्तं राजन्विव्याध पत्रिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2046643, "chapter_id": 2035, "verse_number": "६-८४-२२", "content_sanskrit": "अथापरेण भल्लेन धनुश्चिच्छेद मारिष ।\nसारथिं चास्य समरे क्षिप्रहस्तो न्यपातयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2046644, "chapter_id": 2035, "verse_number": "६-८४-२३", "content_sanskrit": "अश्वांस्छास्यावधीद्राजन्नुभौ तौ पार्ष्णिसारथी ।\nअवप्लुत्य रथात्तूर्णं गदां जग्राह सात्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2046645, "chapter_id": 2035, "verse_number": "६-८४-२४", "content_sanskrit": "स तया वीरघातिन्या गदया गदिनां वरः ।\nगौतमस्य हयान्हत्वा सारथिं च न्यपातयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2046646, "chapter_id": 2035, "verse_number": "६-८४-२५", "content_sanskrit": "भूमिष्ठो गौतमस्तस्य शरांश्चिक्षेप षोडशक ।\nशरास्ते सात्वतं भित्त्वा प्राविशन्धरणीतलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2046647, "chapter_id": 2035, "verse_number": "६-८४-२६", "content_sanskrit": "चेकितानस्ततः क्रुद्धः पुनश्चिक्षेप तां गदाम् ।\nगौतमस्य वधाकाङ्क्षी वृत्रस्येव पुरन्दरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2046648, "chapter_id": 2035, "verse_number": "६-८४-२७", "content_sanskrit": "तामापतन्तीं विमलामश्यमगर्भां महागदाम्।\nशरैरनेकसाहस्त्रैर्वारयामास गौतमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2046649, "chapter_id": 2035, "verse_number": "६-८४-२८", "content_sanskrit": "चेकितानस्ततः खङ्गं क्रोधादुद्धृत्य भारत।\nलाघवं परमास्थाय गौतमं समुपाद्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2046650, "chapter_id": 2035, "verse_number": "६-८४-२९", "content_sanskrit": "गौतमोऽपि धनुस्त्यक्त्वा प्रगृह्यासिं सुसंयतः ।\nवेगेन महता राजंश्चेकितानमुपाद्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2046651, "chapter_id": 2035, "verse_number": "६-८४-३०", "content_sanskrit": "तावुभौ बलसंपन्नौ निस्त्रिंशवरधारिणौ ।\nनिस्त्रिंशाभ्यां सुतीक्ष्णाभ्यामन्योन्यं संततक्षतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2046652, "chapter_id": 2035, "verse_number": "६-८४-३१", "content_sanskrit": "निस्त्रिंशवेगाभिहतौ ततस्तौ पुरुषर्षभौ ।\nधरणीं समनुप्राप्तौ सर्वभूतनिषेविताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2046653, "chapter_id": 2035, "verse_number": "६-८४-३२", "content_sanskrit": "मूर्छयाऽभिपरीताङ्गौ व्यायामेन तु मोहितौ ।\nततोऽभ्यधावद्वेगेन भीमसेनः सुहृत्तया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2046654, "chapter_id": 2035, "verse_number": "६-८४-३३", "content_sanskrit": "चेकितानं तथाभूतं दृष्ट्वा समरदुर्मदः ।\nरथमारोपयच्चैनं सर्वसैकन्यस्य पश्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2046655, "chapter_id": 2035, "verse_number": "६-८४-३४", "content_sanskrit": "तथैव शकुनि शूरः स्यालस्तव विशांपतेक ।\nआरोपयद्रथं तूर्णं गौतमं रथिनां वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2046656, "chapter_id": 2035, "verse_number": "६-८४-३५", "content_sanskrit": "सौमदत्तिं ततः क्रुद्धो धृष्टकेतुर्महाबलः ।\nनवत्या सायकैः क्षिप्रं राजन्विव्याध वक्षसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2046657, "chapter_id": 2035, "verse_number": "६-८४-३६", "content_sanskrit": "सौमदत्तिरुरस्थैस्तैर्भृशं बाणैरशोभत ।\nमध्यंदिने महाराज रश्मिभिस्तपनो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2046658, "chapter_id": 2035, "verse_number": "६-८४-३७", "content_sanskrit": "भूरिश्रवास्तु समरे धृष्टकेतुं महारथम् ।\nहतसूतहयं चक्रे विरथं सायकोत्तमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2046659, "chapter_id": 2035, "verse_number": "६-८४-३८", "content_sanskrit": "विरथं तं समालोक्य हताश्वं हतसारथिम् ।\nमहता शरवर्षेण च्छादयामास संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2046660, "chapter_id": 2035, "verse_number": "६-८४-३९", "content_sanskrit": "स तु तं रथमुत्सृज्य धृष्टकेतुर्महामनाः ।\nआरुरोह ततो यानं शतानीकस्य मारिष ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2046661, "chapter_id": 2035, "verse_number": "६-८४-४०", "content_sanskrit": "चित्रसेनो विकर्णश्च राजन्दुर्मर्षणस्तथा।\nरथिनो हेमसन्नाहाः सौभद्रमभिदुद्रुवुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2046662, "chapter_id": 2035, "verse_number": "६-८४-४१", "content_sanskrit": "अभिमन्योस्ततस्तैस्तु घोरं युद्धमवर्तत।\nशरीरस्य यथा राजन्वातपित्तकफैस्त्रिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2046663, "chapter_id": 2035, "verse_number": "६-८४-४२", "content_sanskrit": "विरथांस्तव पुत्रांस्तु कृत्वा राजन्महाहवे ।\nन जघान नरव्याघ्रः स्मरन्भीमवचस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2046664, "chapter_id": 2035, "verse_number": "६-८४-४३", "content_sanskrit": "ततो राज्ञां बहुशतैर्गजाश्वरथयायिभिः ।\nसंवृतं समरे भीष्मं देवैरपि दुरासदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2046665, "chapter_id": 2035, "verse_number": "६-८४-४४", "content_sanskrit": "प्रयान्तं शीघ्रमुद्वीक्ष्य परित्रातुं सुतांस्तव ।\nअभिमन्युं समुद्दिश्य बालमेकं महारथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2046666, "chapter_id": 2035, "verse_number": "६-८४-४५", "content_sanskrit": "वासुदेवमुवाचेदं कौन्तेयः श्वेतवाहनः ।\nचोदयाश्वान्हृषीकेश यत्रैते बहुला रथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2046667, "chapter_id": 2035, "verse_number": "६-८४-४६", "content_sanskrit": "एते हि बहवः शूराः कृतास्त्रा युद्धदुर्मदाः।\nयथा हन्युर्न नः सेनां तथा माधव चोदय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2046668, "chapter_id": 2035, "verse_number": "६-८४-४७", "content_sanskrit": "एवमुक्तः स वार्ष्णेयः कौन्तेयेनामितौजसा ।\nरथं श्वेतहयैर्युक्तं प्रेषयामास संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2046669, "chapter_id": 2035, "verse_number": "६-८४-४८", "content_sanskrit": "निष्ठानको महानासीत्तव सैन्यस्य मारिष ।\nयदर्जुनो रणे क्रुद्धः संयातस्तावकान्प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2046670, "chapter_id": 2035, "verse_number": "६-८४-४९", "content_sanskrit": "समासाद्य तु कौन्तेयो राज्ञस्तान्भीष्मरक्षिणः ।\nसुशर्माणमथो राजन्निदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2046671, "chapter_id": 2035, "verse_number": "६-८४-५०", "content_sanskrit": "जानामि त्वां युधां श्रेष्ठमत्यन्तं पूर्ववैरिणम् ।\nअनयस्याद्य संप्राप्तं फलं पश्य सुदारुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2046672, "chapter_id": 2035, "verse_number": "६-८४-५१", "content_sanskrit": "अद्य ते दर्शयिष्यामि पूर्वप्रेतान्पितामहान् ।\nएवं संजल्पतस्तस्य बीभत्सोः शत्रुघातिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2046673, "chapter_id": 2035, "verse_number": "६-८४-५२", "content_sanskrit": "श्रुत्वापि परुषं वाक्यं सुशर्मा रथयूथपः ।\nन चैनमब्रवीत्किंचिच्छुभं वा यदि वाऽशुभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2046674, "chapter_id": 2035, "verse_number": "६-८४-५३", "content_sanskrit": "अभिगम्यार्जुनं वीरं राजभिर्बहुभिर्वृतः।\nपुरस्तात्पृष्ठतश्चैव पार्श्वतश्चैव सर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2046675, "chapter_id": 2035, "verse_number": "६-८४-५४", "content_sanskrit": "परिवार्यार्जुनं सङ्ख्ये तव पुत्रैर्महारथः ।\nशरैः संछादयामास मेघैरिव दिवाकरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2046676, "chapter_id": 2035, "verse_number": "", "content_sanskrit": "ततः प्रवृत्तः सुमहान्संग्रामः शोणितोदकः।\nतावकानां च समरे पाण्डवानां च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]