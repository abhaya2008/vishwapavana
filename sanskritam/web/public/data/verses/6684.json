[
  {
    "id": 20011549,
    "chapter_id": 6684,
    "verse_number": "12.1",
    "content_sanskrit": "भुक्तवन्तावथाऽगातां कुर्वाणाविष्टसङ्कथाः । हृषीकेशगुडाकेशौ शुद्धान्तास्थानमण्डपम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20011550,
    "chapter_id": 6684,
    "verse_number": "12.2",
    "content_sanskrit": "आख्यातां तत्र पर्यङ्कं सर्वरत्नविभूषितम् । फेनशुभ्रोपबर्हाढ्यं क्षीरसागरपाण्डरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20011551,
    "chapter_id": 6684,
    "verse_number": "12.3",
    "content_sanskrit": "अन्योन्यस्योपरि स्निग्धामदातां सुचिरं दृशम् । अपातामिव पीयूषमन्वभूतां परं सुखम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20011552,
    "chapter_id": 6684,
    "verse_number": "12.4",
    "content_sanskrit": "कथामृतानि चाऽधातां श्रोत्राञ्जलिपुटैर्मुहुः । उपास्थिषातां योषिद्भिर्धुतचामरपाणिभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20011553,
    "chapter_id": 6684,
    "verse_number": "12.5",
    "content_sanskrit": "आघ्रातां कौसुमान् गन्धानाघ्रासिष्टाश्च चन्दनम् । इष्टान्यन्योन्यमप्राष्टामन्योन्यं प्रत्यवोचताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20011554,
    "chapter_id": 6684,
    "verse_number": "12.6",
    "content_sanskrit": "श्रुत्वा कुशलिनः पार्थान् धर्मवाताश्विजन्मनः । अप्रेष्ट कुन्तीकृष्णे च दाशार्हप्रियवान्धवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20011555,
    "chapter_id": 6684,
    "verse_number": "12.7",
    "content_sanskrit": "आरोपयिषतोत्सङ्गं कुमारा दारिकास्तथा । आराधयिषताऽशेषाः कृष्णपत्न्यश्च जिष्णुना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20011556,
    "chapter_id": 6684,
    "verse_number": "12.8",
    "content_sanskrit": "तथाऽस्मायि वचोऽवाचि मधुरश्च किरीटिना । सरसेषु यथाऽङ्गेषु स्त्रीणां प्रारोहि कण्टकैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20011557,
    "chapter_id": 6684,
    "verse_number": "12.9",
    "content_sanskrit": "देवींनां चाटुकारेण प्रियंभावुकतांयता । तदा सपदि गोविन्दःकृतिनाऽऽराधि जिष्णुना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20011558,
    "chapter_id": 6684,
    "verse_number": "12.10",
    "content_sanskrit": "अद्राक्षुरविशेषेण कृष्णपार्थौ पुराङ्गनाः । वस्तु प्रकृतिकल्याणं नवमेव हि सर्वदा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20011559,
    "chapter_id": 6684,
    "verse_number": "12.11",
    "content_sanskrit": "यत्कृष्णार्जुनरक्तत्वं द्वारकासुन्दरीदृशाम् । प्रकृष्टमजनिष्टाऽदः कृष्णार्जुनविलोकने ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20011560,
    "chapter_id": 6684,
    "verse_number": "12.12",
    "content_sanskrit": "पार्थमालोकयन्तीनां रूपापहसितस्मरम् । शृङ्गारयोनयस्तासामुदपत्सन्त विभ्रमाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20011561,
    "chapter_id": 6684,
    "verse_number": "12.13",
    "content_sanskrit": "सखी कयाचिदाह्लायि हेतुमुक्त्वैव कञ्चन । सख्यौ कयाप्याह्लासातां सख्य आह्वासतान्यया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20011562,
    "chapter_id": 6684,
    "verse_number": "12.14",
    "content_sanskrit": "ऐक्षपातां कयाचित् स्वौ पीनोत्तुङ्गौ पयोधरौ । मृषा वदन्त्या यत्किञ्चित्सख्योऽहासिपताऽन्यया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20011563,
    "chapter_id": 6684,
    "verse_number": "12.15",
    "content_sanskrit": "कर्णभूषणयन्तीव विपुलायतमीक्षणम् । ऐक्षिष्ट पाण्डवं काचिद् दृशा तेनाऽलजिष्ट च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20011564,
    "chapter_id": 6684,
    "verse_number": "12.16",
    "content_sanskrit": "समवर्धिषतैकस्याश्वासा धृतस्तनांशुकाः । समैधिषत कस्याश्चिन्मुखेन्दौ स्वेदविन्दवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20011565,
    "chapter_id": 6684,
    "verse_number": "12.17",
    "content_sanskrit": "अवेपिषातामन्यस्याश्चलमुक्तावलीकुचौ । अकम्पिषाताञ्चैकस्या दोर्लते धृतकङ्कणे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20011566,
    "chapter_id": 6684,
    "verse_number": "12.18",
    "content_sanskrit": "गृहकर्मपराऽऽरब्ध गृहं प्रापत्त काचन । कयाचित् समयुक्षातां वियुक्ते शुकशारिके ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20011567,
    "chapter_id": 6684,
    "verse_number": "12.19",
    "content_sanskrit": "काचिदन्यामुपालब्ध तिष्ठमानां किरीटिने । विवृण्वती स्वगात्राणि नाऽस्थिताऽस्मै किल स्वयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20011568,
    "chapter_id": 6684,
    "verse_number": "12.20",
    "content_sanskrit": "असर्जि माला कस्याश्चित् करपल्लवयोर्द्वये । सखीमध्यगता काचित् पार्श्वे तस्याऽबुभूषत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20011569,
    "chapter_id": 6684,
    "verse_number": "12.21",
    "content_sanskrit": "अयंसताऽन्यया केशास्तत्र माला न्यधायि च । दोलंताभ्यामुदस्ताभ्यां दर्शयन्त्या पयोधरौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20011570,
    "chapter_id": 6684,
    "verse_number": "12.22",
    "content_sanskrit": "अघानि लीलापद्मेन कयाचित्सहसा सखी । अग्राहिषातामक्षौ च कयाचन यदृच्छया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20011571,
    "chapter_id": 6684,
    "verse_number": "12.23",
    "content_sanskrit": "अदर्शिषत चित्रस्थाः कयाचित्प्राप्य देवताः । नेत्राभ्यामनिमेषाभ्यां सकुतूहलया किल ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20011572,
    "chapter_id": 6684,
    "verse_number": "12.24",
    "content_sanskrit": "व्यजिहीर्षात् समं सख्या काचिदग्रे किरीटिनः । नखैस्ताम्बूलमच्छासीदन्याऽस्याऽच्छाद्य केतकम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20011573,
    "chapter_id": 6684,
    "verse_number": "12.25",
    "content_sanskrit": "मुखाम्भोजमजृम्भिष्ट कस्याश्चित्कान्तकर्णिकम् । कराम्बुजमयासीत्तदभासीदुभयं भृशम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20011574,
    "chapter_id": 6684,
    "verse_number": "12.26",
    "content_sanskrit": "रोमाञ्चपूर्णसौवर्णकलशप्रतिमस्तनी । 'अदर्शदर्शनीयाऽन्या पाण्डुसूनोरुरःस्थलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20011575,
    "chapter_id": 6684,
    "verse_number": "12.27",
    "content_sanskrit": "काचिद् व्यचैषीदुत्सङ्गमनैषीदपराऽर्भकम् । समाहार्षीत्कचानन्या कुमारस्याऽङ्कवर्तिनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20011576,
    "chapter_id": 6684,
    "verse_number": "12.28",
    "content_sanskrit": "स्तन्यं पिपांसुं प्राप्ताङ्कमदौषीदपरा शिशुम् । अपाययन्ती पार्थस्य पिपासन्ती मुखामृतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20011577,
    "chapter_id": 6684,
    "verse_number": "12.29",
    "content_sanskrit": "कादम्बशिशवे दातुमलावीदपरा बिसम् । व्यकारीच्चिकुरानन्या कराभ्यां कमनस्तनी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20011578,
    "chapter_id": 6684,
    "verse_number": "12.30",
    "content_sanskrit": "अचालिषुर्भ्रुवस्तासां मन्मथस्य धनुर्लताः । इषवो दृष्टयश्चापि फल्गुनं प्रत्यचारिषुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20011579,
    "chapter_id": 6684,
    "verse_number": "12.31",
    "content_sanskrit": "प्रद्युम्नप्रमुखाञ्श्रुत्वा कुमाराः पार्थमागतम् । अत्राजिषुरुपाघ्रातमूर्धानोऽनंसिषुश्च तम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20011580,
    "chapter_id": 6684,
    "verse_number": "12.32",
    "content_sanskrit": "वासुदेवोऽथ तद्वार्तां पर्यप्राक्षीत् पृथासुतम् । प्रवासवृत्तनिश्शेषं सोऽप्यवादीत्सकारणम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20011581,
    "chapter_id": 6684,
    "verse_number": "12.33",
    "content_sanskrit": "अत्रान्तरे सुभद्राख्या भगिनी रामकृष्णयोः । अश्रौषीदागतं पार्थं श्रुतं चिरदिदृक्षितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20011582,
    "chapter_id": 6684,
    "verse_number": "12.34",
    "content_sanskrit": "अभाङ्क्षीदाननं यस्याश्शशिमण्डलडम्बरम् । अच्छैत्सीच्च दिनारम्भजृंभिताम्भोजविभ्रमम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20011583,
    "chapter_id": 6684,
    "verse_number": "12.35",
    "content_sanskrit": "विकचेन्दीवरच्छायामरैक्ताञ्च विलोचने । दन्तभासस्तथाऽक्षौत्सु'स्सन्मुक्तामणिदीधितिम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20011584,
    "chapter_id": 6684,
    "verse_number": "12.36",
    "content_sanskrit": "श्रियं लोहितकस्योष्ठः कल्पवल्ल्योर्भुजे रुचाः । यस्या अलीनाश्चाऽमौषीदमोषिष्टाममोषिषुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20011585,
    "chapter_id": 6684,
    "verse_number": "12.37",
    "content_sanskrit": "अदेवीदलिकार्धेन्दुर्यस्या भ्रूलक्ष्मलेखया । अग्रहीष्टां कपोलौ च मणिदर्पणचातुरीम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20011586,
    "chapter_id": 6684,
    "verse_number": "12.38",
    "content_sanskrit": "विवर्धमानयोर्यस्या वीक्ष्य वक्षोजयोः श्रियम् । सद्यस्समकुचील्लक्ष्मीं नवकाञ्चनकुम्भयोः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20011587,
    "chapter_id": 6684,
    "verse_number": "12.39",
    "content_sanskrit": "ऐङ्खीत्किसलयाभिख्यामौङ्खीत् कोकनदश्रियम् । पाणिपादांशुकं यस्या कोमलस्निग्धलोहितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20011588,
    "chapter_id": 6684,
    "verse_number": "12.40",
    "content_sanskrit": "सूक्ष्मां रोमावलिं मध्यात् स्रवन्तीं कुचकुम्भयोः । यस्या नाभिहृदं पीत्वा कान्तिधारामिवाऽवमीत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20011589,
    "chapter_id": 6684,
    "verse_number": "12.41",
    "content_sanskrit": "अहयिष्टां श्रुती यस्या नयते पृथुनी सिते । सर्वलक्षणपूर्णाया जगताञ्च श्रुतिर्गुणाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20011590,
    "chapter_id": 6684,
    "verse_number": "12.42",
    "content_sanskrit": "अक्षणिष्टां यदीयोरू स्मरहस्तिकरश्रियम् । यस्याश्च जघनं दृष्ट्वा नाश्वसीन्मन्मथो रथः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20011591,
    "chapter_id": 6684,
    "verse_number": "12.43",
    "content_sanskrit": "सर्वास्वजागरीन्नित्यं प्रवृत्तिष्वलगीच्च या । सर्वान् साध्वेव चाऽगादीन्नेतरत् किञ्च नाऽगदीत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20011592,
    "chapter_id": 6684,
    "verse_number": "12.44",
    "content_sanskrit": "अश्वद्या पितरं नम्रा नम्रा मातरमश्वयीत् । बीजं सकलभद्राणां यस्याश्शीलमशिश्वियत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20011593,
    "chapter_id": 6684,
    "verse_number": "12.45",
    "content_sanskrit": "साऽथ गत्वा प्रियं दृष्ट्वा गवाक्षेण त्रपावती । प्रत्यक्षमिव कन्दर्पमकार्षीदिति चेतसि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20011594,
    "chapter_id": 6684,
    "verse_number": "12.46",
    "content_sanskrit": "अहो सएष कौन्तेयः पाण्डुपुत्रो धनञ्जयः । प्रौर्णावीदवलेपं यस्सर्वेषां पृथिवीभृताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20011595,
    "chapter_id": 6684,
    "verse_number": "12.47",
    "content_sanskrit": "प्रौर्णवीद्द्रुपदं बध्वा सोमकानाभयं यशः । दर्पं बार्हद्रथादीनां प्रौर्णवीच्च स्वयंवरे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20011596,
    "chapter_id": 6684,
    "verse_number": "12.48",
    "content_sanskrit": "अदिक्षद्दक्षिणामेष द्रोणाय द्रुपदं नृपम् । काकपक्षधरो धन्वी गृहीतं युधि निर्जितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20011597,
    "chapter_id": 6684,
    "verse_number": "12.49",
    "content_sanskrit": "अभिन्यविक्षत स्वान्तं द्रोणस्यैष यथा गुरोः । परिपूर्णगुणश्शिष्यो न कश्चिदपरस्तथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20011598,
    "chapter_id": 6684,
    "verse_number": "12.50",
    "content_sanskrit": "कर्णशल्यजरासन्धशिशुपालभुजौजसा । अस्पृक्षज्ज्या न चापार्तिं पाञ्चालपुटभेदने ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20011599,
    "chapter_id": 6684,
    "verse_number": "12.51",
    "content_sanskrit": "भुजाभ्यां त्वमुनोत्कृष्टा मौर्व्यारुक्षद्धनुश्शिरः । अरुक्षच्च शिरोऽमुष्य शिरोलक्षस्य पक्षिणः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20011600,
    "chapter_id": 6684,
    "verse_number": "12.52",
    "content_sanskrit": "अरिक्षदेष तत्राजौ कर्णप्रष्ठान् महारथान् । येऽमुं पुरस्तादाक्रुक्षन्नीर्ष्यामोहितमानसाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20011601,
    "chapter_id": 6684,
    "verse_number": "12.53",
    "content_sanskrit": "सर्वाण्ययं तदाऽकृक्षद् भुजतेजांसि भूभुजाम्' । कृष्णाकटाक्षांश्चाक्राक्षीदकार्षीदपि तन्मनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20011602,
    "chapter_id": 6684,
    "verse_number": "12.54",
    "content_sanskrit": "मन्ये तां सुकृतं कृष्णां लक्षभङ्गेन तत्र याम् । अवाप्सीदेष या चैनमताप्सीद्वीरमालया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20011603,
    "chapter_id": 6684,
    "verse_number": "12.55",
    "content_sanskrit": "एनं जामातरं प्राप्य यज्ञसेनोऽतृपद्ध्रुवम् । आसाद्य श्यालतामस्य धृष्टद्युम्नोऽपि सोऽदृपत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20011604,
    "chapter_id": 6684,
    "verse_number": "12.56",
    "content_sanskrit": "युधिष्ठिरादीन्मन्येहं भ्रातॄनप्यस्य तान् समान् । यैरेनेनैव साद्राप्सीद्येचादाप्सुस्तयैष वा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20011605,
    "chapter_id": 6684,
    "verse_number": "12.57",
    "content_sanskrit": "उपाघुक्षत वक्षश्रीरुपागूह च पार्षती । यस्यापि सुकृतैरेषोऽप्युपागूहिष्ट तज्जनैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20011606,
    "chapter_id": 6684,
    "verse_number": "12.58",
    "content_sanskrit": "दन्तच्छदमलिक्षातां वाग्द्रौपद्यावमुष्य यम् । एषोऽपि तं जनोऽलीढ पुण्यान्यकृत चेत्पुरा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20011607,
    "chapter_id": 6684,
    "verse_number": "12.59",
    "content_sanskrit": "इमे खलु दृशौ धन्ये ये मेऽद्राष्टामिमं प्रियम् । न तु धन्यौ स्तनावस्य न यावाश्लिक्षतामुरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20011608,
    "chapter_id": 6684,
    "verse_number": "12.60",
    "content_sanskrit": "अस्मिन्नतत सौन्दर्य माधुर्यं चातुरीमपि । स्रष्टाऽतनिष्ट चाशेषान् वीर्यशौर्यादिकान् गुणान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20011609,
    "chapter_id": 6684,
    "verse_number": "12.61",
    "content_sanskrit": "मुखमस्य त्रपा नूनमनूनेन्दुमविव्रजत् । कार्श्यञ्चास्य सवैवर्ण्यमत एवोदपीपदत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20011610,
    "chapter_id": 6684,
    "verse_number": "12.62",
    "content_sanskrit": "इति सञ्चिन्तय निष्क्रम्य सदनात् सा सखीवृता । ह्रीता दूरे स्थिता तत्र कटाक्षं समचूचुदत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20011611,
    "chapter_id": 6684,
    "verse_number": "12.63",
    "content_sanskrit": "अचुक्षुभन्मनस्तस्यास्सन्नद्धश्चित्तभूस्तदा । अतत्वरत्तरां रन्तुमक्षिद्वयमपप्रथत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20011612,
    "chapter_id": 6684,
    "verse_number": "12.64",
    "content_sanskrit": "अववेष्टत्तिरश्चीनं श्रवणाकल्पमुत्पलम् । अविवेष्टच कोष्णोऽस्या निश्वासोऽलकवल्लरीः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20011613,
    "chapter_id": 6684,
    "verse_number": "12.65",
    "content_sanskrit": "पयोधरद्वयं तस्या यद्द्वेयथुमशिश्रियत् । प्रियन्तं परिरब्धुं तत् किन्नु किञ्चिद्ददुद्रुवत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20011614,
    "chapter_id": 6684,
    "verse_number": "12.66",
    "content_sanskrit": "यौवनद्विपवक्षोजकुम्भदानलवानसौ । मुखचन्द्रसुधाबिन्दून् स्वेदलेशानसुस्रवत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "avatarnika": ""
  },
  {
    "id": 20011615,
    "chapter_id": 6684,
    "verse_number": "12.67",
    "content_sanskrit": "अदधन् पुलकास्तस्यास्तनूत्थास्स्वेदविप्रुषः । अधासिषुरमन्दाया मन्दारोद्यानवायवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "avatarnika": ""
  },
  {
    "id": 20011616,
    "chapter_id": 6684,
    "verse_number": "12.68",
    "content_sanskrit": "अचकामद् भृशं तस्यामिन्द्रसूनोर्विलोकनम् । अचकामन्विकाराश्च स्तम्भजृम्भाग्रतस्सराः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "avatarnika": ""
  },
  {
    "id": 20011617,
    "chapter_id": 6684,
    "verse_number": "12.69",
    "content_sanskrit": "जितेन रूपसम्पत्त्या मदनेन धनञ्जयः । अशशासद् गुडाकेशे मनः कुर्विति तां ध्रुवम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "avatarnika": ""
  },
  {
    "id": 20011618,
    "chapter_id": 6684,
    "verse_number": "12.70",
    "content_sanskrit": "यौवनं व्यरराजत्तामाविर्मदनलाञ्छनम् । स्फुटपुष्पं वसन्तस्य मुखं नवलतामिव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70,
    "avatarnika": ""
  },
  {
    "id": 20011619,
    "chapter_id": 6684,
    "verse_number": "12.71",
    "content_sanskrit": "अथाऽऽलुलोकत्तां पार्थः स्फुरन्तीमन्तरा सखीः । मध्ये जलदलेखानां पक्षतीन्दुकलामिव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71,
    "avatarnika": ""
  },
  {
    "id": 20011620,
    "chapter_id": 6684,
    "verse_number": "12.72",
    "content_sanskrit": "हृद्यानवद्यसर्वाङ्गी मुग्धसारङ्गलोचना । दृष्टा सा हृदये तस्य कन्दर्पं समदीदिपत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 72,
    "avatarnika": ""
  },
  {
    "id": 20011621,
    "chapter_id": 6684,
    "verse_number": "12.73",
    "content_sanskrit": "पाण्डुसूनुमनःकुण्डे पञ्चसायकपावकम् । कटाक्षेन्धननिक्षेपैरादिदीपदजस्रसा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 73,
    "avatarnika": ""
  },
  {
    "id": 20011622,
    "chapter_id": 6684,
    "verse_number": "12.74",
    "content_sanskrit": "पार्थाम्बुधिमबभ्राजत्सुभद्रामुखचन्द्रिका । तन्वती कम्पमुद्दामस्वेदशीकरसङ्कुलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 74,
    "avatarnika": ""
  },
  {
    "id": 20011623,
    "chapter_id": 6684,
    "verse_number": "12.75",
    "content_sanskrit": "स्वेदोदबिन्दवश्श्यामं पार्थस्याऽविभ्रजन्नुरः । शरद्गलितजीमूतमन्तरिक्षमिव ग्रहाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 75,
    "avatarnika": ""
  },
  {
    "id": 20011624,
    "chapter_id": 6684,
    "verse_number": "12.76",
    "content_sanskrit": "अवभासन् सुभद्राया गात्रयष्टिं यथोद्गताः । वपुस्तथैव रोमाञ्चा बीभत्सोप्यबीभसन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 76,
    "avatarnika": ""
  },
  {
    "id": 20011625,
    "chapter_id": 6684,
    "verse_number": "12.77",
    "content_sanskrit": "दृशावुदमीमीलत्सा पश्यन्ती पाण्डवं यथा । तां पश्यन्न परिस्पन्दे तथा सोऽप्युदमीमिलत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 77,
    "avatarnika": ""
  },
  {
    "id": 20011626,
    "chapter_id": 6684,
    "verse_number": "12.78",
    "content_sanskrit": "तां सोऽपिपीपडत्प्राप्तो गात्रैस्तं साऽप्यपीपिडत् । प्राप्तो जिजीवन् दृष्ट्या तु स तां तं सोऽप्यजीजिवत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 78,
    "avatarnika": ""
  },
  {
    "id": 20011627,
    "chapter_id": 6684,
    "verse_number": "12.79",
    "content_sanskrit": "पृच्छन् विकृतिहेतुं तं नाऽवभापत् किमप्यजः । नाऽवीभपत् सखी ताञ्च सतां ह्यविनयाङ्घयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 79,
    "avatarnika": ""
  },
  {
    "id": 20011628,
    "chapter_id": 6684,
    "verse_number": "12.80",
    "content_sanskrit": "अन्योन्यं प्रतिनिष्पन्दास्तौ प्रातिष्ठिपतां दृशः । अपीप्यतां मुहुस्ताश्च रूपामृतरसस्रुतीः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 80,
    "avatarnika": ""
  },
  {
    "id": 20011629,
    "chapter_id": 6684,
    "verse_number": "12.81",
    "content_sanskrit": "अन्योन्यसङ्गमोपायान् समचीक्लृपतां बहून् । शृङ्गारचेष्टाश्चानेकास्ताववीवृततां तदा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 81,
    "avatarnika": ""
  },
  {
    "id": 20011630,
    "chapter_id": 6684,
    "verse_number": "12.82",
    "content_sanskrit": "अवोचदच्युतः पार्थं केयं ते विक्रियेत्यथ । मा स्मैवमाख्यो मा हासीर्मामित्याख्यत्तमर्जुनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 82,
    "avatarnika": ""
  },
  {
    "id": 20011631,
    "chapter_id": 6684,
    "verse_number": "12.83",
    "content_sanskrit": "अवान्तरे रविर्भाभिरलिपल्लोहितीभवन् । द्वारकासौधशृङ्गाणि कनकद्रवकान्तिभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 83,
    "avatarnika": ""
  },
  {
    "id": 20011632,
    "chapter_id": 6684,
    "verse_number": "12.84",
    "content_sanskrit": "वर्धमानमनोज्ञाभं पश्यन्ती शशिनं प्रियम् । प्रायेणाऽऽतपसंक्लेशं निरास्थत कुमुद्वती ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 84,
    "avatarnika": ""
  },
  {
    "id": 20011633,
    "chapter_id": 6684,
    "verse_number": "12.85",
    "content_sanskrit": "वर्धिष्णुभिस्तटं वार्धिः कल्लोलैरासिचत्तराम् । इन्दुमाह्वदिवारावैरासन्नोदयमात्मजम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 85,
    "avatarnika": ""
  },
  {
    "id": 20011634,
    "chapter_id": 6684,
    "verse_number": "12.86",
    "content_sanskrit": "सान्द्रैश्चन्दनपङ्काभैः कल्लोलकरधारितैः । फेनैरलिपताऽऽत्मानं वेलाञ्चाऽऽलिप्त वारिधिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 86,
    "avatarnika": ""
  },
  {
    "id": 20011635,
    "chapter_id": 6684,
    "verse_number": "12.87",
    "content_sanskrit": "अनशद्रविरब्जिन्यश्शोकावेशादिवामुहन् । धातुधारेव चास्ताद्रेस्सन्ध्याभा सिन्धुनाश्लिषत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 87,
    "avatarnika": ""
  },
  {
    "id": 20011636,
    "chapter_id": 6684,
    "verse_number": "12.88",
    "content_sanskrit": "अशुभमन्दीपिकाः'पुर्या खेऽशोभिपत तारकाः । क्रमेण दिक्षु सर्वासु पर्यपप्तंस्तमांसि च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 88,
    "avatarnika": ""
  },
  {
    "id": 20011637,
    "chapter_id": 6684,
    "verse_number": "12.89",
    "content_sanskrit": "कुलायवृक्षानसरन् कूजन्तश्शकुनव्रजाः । अन्धकारा इव प्रीताः पतन्ति द्विषि पूषणि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 89,
    "avatarnika": ""
  },
  {
    "id": 20011638,
    "chapter_id": 6684,
    "verse_number": "12.90",
    "content_sanskrit": "कामोऽश्लिषद्विशालाक्षीरारन्प्रियगृहाणि ताः । रागेण चाऽध्वनोऽदर्शन्नन्धितास्तिमिरैरपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 90,
    "avatarnika": ""
  },
  {
    "id": 20011639,
    "chapter_id": 6684,
    "verse_number": "12.91",
    "content_sanskrit": "अपूर्वस्येव कार्यस्य द्रव्यस्य परमाणवः । खं व्यूढास्तमसोऽरौत्सुरघ्नन्वसुधामपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 91,
    "avatarnika": ""
  },
  {
    "id": 20011640,
    "chapter_id": 6684,
    "verse_number": "12.92",
    "content_sanskrit": "समपादि मुखं प्राच्याः पूगस्तबकधूसरम् । पूर्वाद्रिस्तनरुद्धेऽब्धिहृदीन्दौ तिष्ठति प्रिये ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 92,
    "avatarnika": ""
  },
  {
    "id": 20011641,
    "chapter_id": 6684,
    "verse_number": "12.93",
    "content_sanskrit": "रक्तोऽजनि निशानाथस्सुदृशां'हृदयैस्सह । अदीपि सह मारेण मानिनीचित्तवृत्तिना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 93,
    "avatarnika": ""
  },
  {
    "id": 20011642,
    "chapter_id": 6684,
    "verse_number": "12.94",
    "content_sanskrit": "अबोधि कुमुदं ज्योत्स्नां प्राप्य विद्यां मनो यथा । समपूरि चकोरश्च गृहीव धनसम्पदम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 94,
    "avatarnika": ""
  },
  {
    "id": 20011643,
    "chapter_id": 6684,
    "verse_number": "12.95",
    "content_sanskrit": "ध्वान्ते निशाविशालाक्षीकेशवेशविलम्बिनी । सीमन्तमुक्तामालेव प्रातावि नवचन्द्रिका ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 95,
    "avatarnika": ""
  },
  {
    "id": 20011644,
    "chapter_id": 6684,
    "verse_number": "12.96",
    "content_sanskrit": "उच्चावचानि रत्नानि विकिरन् वाहिनीपतिः । प्रत्युत्थितो द्विजाधीशं दृष्ट्वाऽऽप्यायीति नाऽद्भुतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 96,
    "avatarnika": ""
  },
  {
    "id": 20011645,
    "chapter_id": 6684,
    "verse_number": "12.97",
    "content_sanskrit": "आप्यायिष्ट मुखे सिन्धोःक्षुभ्यतः फेनसंहतीः । चन्द्रिकोद्गीर्यमाणेव प्रपीयाऽतितृषा गलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 97,
    "avatarnika": ""
  },
  {
    "id": 20011646,
    "chapter_id": 6684,
    "verse_number": "12.98",
    "content_sanskrit": "हरिभिन्नतमःकुम्भिकुम्भमुक्तामणिच्छटा । ज्योत्स्नोद्यानेष्वतायिष्ट तरुच्छिद्रावलिच्युता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 98,
    "avatarnika": ""
  },
  {
    "id": 20011647,
    "chapter_id": 6684,
    "verse_number": "12.99",
    "content_sanskrit": "द्यावापृथिव्योर्विंवरे तथाऽपूरिष्ट चन्द्रिका । यथाऽबुद्धाऽजनिष्टाऽब्धिर्दुग्धात्मेत्यखिलो जनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 99,
    "avatarnika": ""
  },
  {
    "id": 20011648,
    "chapter_id": 6684,
    "verse_number": "12.100",
    "content_sanskrit": "उदिते कुन्दभासीन्दौ कन्दर्पमणिदर्पणे । हृदयं तरलीकुर्वन् कामोऽदीपिष्ट कामिनाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 100,
    "avatarnika": ""
  },
  {
    "id": 20011649,
    "chapter_id": 6684,
    "verse_number": "12.101",
    "content_sanskrit": "कामिन्यलमकार्येका द्रागाकार्यप्रसाधिकाम् । धम्मिल्लभारः कस्याश्चिन्न्यस्तमालस्समस्कृत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 101,
    "avatarnika": ""
  },
  {
    "id": 20011650,
    "chapter_id": 6684,
    "verse_number": "12.102",
    "content_sanskrit": "प्राप्य कान्ताजनोऽदोहि कान्तानां मान्मथं रसम् । कान्तालोकोपि कान्तानां तमदुग्ध समागतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 102,
    "avatarnika": ""
  },
  {
    "id": 20011651,
    "chapter_id": 6684,
    "verse_number": "12.103",
    "content_sanskrit": "अरुद्ध काचिन्मुग्धाक्षी त्रपावेशवशंवदा । मोहिता पञ्चबाणेन प्रियस्य भुजपञ्जरे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 103,
    "avatarnika": ""
  },
  {
    "id": 20011652,
    "chapter_id": 6684,
    "verse_number": "12.104",
    "content_sanskrit": "अन्वतप्ताऽभिमानेन प्रियसन्नाऽनुपेयुषी । शशाङ्कबिम्बं पश्यन्ती दिवि काचन कामिनी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 104,
    "avatarnika": ""
  },
  {
    "id": 20011653,
    "chapter_id": 6684,
    "verse_number": "12.105",
    "content_sanskrit": "नूनं किञ्चित्तपोऽतप्त मन्दभाग्योऽप्ययञ्जनः । सत्कृत्य सकृदाह्वायि प्रियनाम्नाऽद्य यस्त्वया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 105,
    "avatarnika": ""
  },
  {
    "id": 20011654,
    "chapter_id": 6684,
    "verse_number": "12.106",
    "content_sanskrit": "सपत्न्येत्युदितः कश्चिदवागस्यादधोमुखः । दोषान्तरं हि दोषस्य प्रथमानस्य निह्नुतिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 106,
    "avatarnika": ""
  },
  {
    "id": 20011655,
    "chapter_id": 6684,
    "verse_number": "12.107",
    "content_sanskrit": "असस्मरत् कान्तजनस्य कान्ताः पुष्पायुधो रन्तुमतत्वरच्च । सेनाधिनाथेन मयूखबाणैर्निशाकृता लोकमतस्तरच्च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 107,
    "avatarnika": ""
  },
  {
    "id": 20011656,
    "chapter_id": 6684,
    "verse_number": "12.108",
    "content_sanskrit": "काञ्चिदूरुभुजपञ्जररुद्धां प्रेयसा मुखमधायि विधाय । मा स्म भावि वलयध्वनिनेति व्रीलितामकृत पाणिविधूर्तिम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 108,
    "avatarnika": ""
  },
  {
    "id": 20011657,
    "chapter_id": 6684,
    "verse_number": "12.109",
    "content_sanskrit": "अंशुकं शयनमेत्य मा वरः कृक्षदेतदिति नूतनोढया । पर्यधायि निबिडं सनिद्रया मन्दमन्मथरसा हि बालता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 109,
    "avatarnika": ""
  },
  {
    "id": 20011658,
    "chapter_id": 6684,
    "verse_number": "12.110",
    "content_sanskrit": "चुम्बन्त्यो नखरपदान्युरोजपृष्ठैर्गृह्णाना दशनपदानि चाऽधरोष्ठैः । श्लिष्यन्त्यः कृतसकलप्रतिप्रयोगाः कामिन्यो निपुणमरीरमन्नभीकान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 110,
    "avatarnika": ""
  },
  {
    "id": 20011659,
    "chapter_id": 6684,
    "verse_number": "12.111",
    "content_sanskrit": "स्मराभितप्तान् नवचन्दनार्द्रैरेकावलीमात्रमनोज्ञभूषैः । उरोजकुम्भैरुपगूह्य कान्तान् विलासिनीभिस्समनाहि रत्यै ॥",
    "padaccheda": "",
    "anvaya": "",
