[{"id": 7006053000, "chapter_id": 26053, "verse_number": "१-२३७-१", "content_sanskrit": "श्रीबगवानुवाच ।\nगीतासारं प्रवक्ष्यामि अर्जुनायोदितं पुरा ।\nअष्टाङ्गयोगयुक्तात्मा सर्ववेदान्तपारगः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006053001, "chapter_id": 26053, "verse_number": "१-२३७-२", "content_sanskrit": "आत्मलाभः परो नान्य अत्मदेहादिवरजितः ।\nहीनरूपादिदेहान्तः करणत्वादिलोचनः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006053002, "chapter_id": 26053, "verse_number": "१-२३७-३", "content_sanskrit": "बिज्ञानरहितः प्राणः सुषुप्तौ हि प्रतीयत ।\nनाहमात्मा च दुः खादिसंसारादिसमन्वयात् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006053003, "chapter_id": 26053, "verse_number": "१-२३७-४", "content_sanskrit": "विधूम इव दीप्तार्चिरादीप्त (दित्य) इव दप्तिमान् ।\nवैद्युतोऽग्निरिवाकाशे हृत्सङ्गे आत्मनात्मनि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006053004, "chapter_id": 26053, "verse_number": "१-२३७-५", "content_sanskrit": "श्रोत्रादीनि न पश्यन्ति स्वंस्वमात्मानमात्मना ।\nसर्वज्ञः सर्वदर्शो च क्षेत्रज्ञस्तानि पश्यन्ति ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006053005, "chapter_id": 26053, "verse_number": "१-२३७-६", "content_sanskrit": "यदा प्रकाशते ह्यात्मा पटे दीपो ज्वलन्निव ।\nज्ञानमुत्पद्यते पुंसां क्षयात्पापस्य कर्मणः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006053006, "chapter_id": 26053, "verse_number": "१-२३७-७", "content_sanskrit": "यथादर्शतलप्रख्ये पश्यत्यात्मानमात्मनि ।\nइन्द्रियाणीन्द्रियार्थांश्च महाभूतानि पञ्चकम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006053007, "chapter_id": 26053, "verse_number": "१-२३७-८", "content_sanskrit": "मनोबुद्धिरहङ्कारमव्यक्तं पुरुषं तथा ।\nप्रसंख्याय परंव्याप्तो विमुक्तो बन्धवैर्भवेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006053008, "chapter_id": 26053, "verse_number": "१-२३७-९", "content_sanskrit": "इन्द्रियग्राममखिलं मनसाभिनिवेश्य च ।\nमनश्चैवाप्यहङ्कारे प्रतिष्ठाप्य च पाण्डव ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006053009, "chapter_id": 26053, "verse_number": "१-२३७-१०", "content_sanskrit": "अहं कारं तथा बुद्धौ बुद्धिं च प्रकृतावपि ।\nप्रकृतिं पुरुषे स्थाप्य पुरुषं ब्रह्मणि न्यसेत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006053010, "chapter_id": 26053, "verse_number": "१-२३७-११", "content_sanskrit": "अहं बह्म परं ज्योतिः प्रसंख्याय विमुच्त ।\nनवद्वारमिदं गेहं तिसृणां?पञ्चसाक्षिकम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006053011, "chapter_id": 26053, "verse_number": "१-२३७-१२", "content_sanskrit": "क्षेत्रज्ञाधिष्ठितं विद्वान्यो वेद स वरः कविः ।\nअश्वमेधसहस्राणि वाजपेयशतानि च ।\nज्ञानयज्ञस्य सर्वाणि कलां नार्हन्ति षोच्शीम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}]