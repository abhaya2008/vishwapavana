[{"id": 2106216, "chapter_id": 3303, "verse_number": "१६-३२-१", "content_sanskrit": "कुन्त्युवाच।\nभगवञ्श्वशुरो मेऽसि दैवतस्यापि दैवतम्।\nस मे देवातिदेवस्त्वं शृणु सत्यां गिरं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2106217, "chapter_id": 3303, "verse_number": "१६-३२-२", "content_sanskrit": "तपस्वी कोपनो विप्रो दुर्वासा नाम मे पितुः।\nभिक्षामुपागतो भोक्तुं तमहं पर्यतोषयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2106218, "chapter_id": 3303, "verse_number": "१६-३२-३", "content_sanskrit": "शौचने त्वागसस्त्यागैः शुद्धेन मनसा तथा।\nकोपस्थानेष्वपि महत्स्वकुप्यन्न कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2106219, "chapter_id": 3303, "verse_number": "१६-३२-४", "content_sanskrit": "स प्रीतो वरदो मेऽभूत्कृतकृत्यो महामुनिः।\nअवश्यं ते ग्रहीतव्यमिति मां सोब्रवीद्वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2106220, "chapter_id": 3303, "verse_number": "१६-३२-५", "content_sanskrit": "ततः शापभयाद्विप्रमवोचं पुनरेव तम्।\nएवमस्त्विति च प्राह पुनरेव स मे द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2106221, "chapter_id": 3303, "verse_number": "१६-३२-६", "content_sanskrit": "धर्मस्य जननी भद्रे भवित्री त्वं शुभानने।\nवशे स्थास्यन्ति ते देवा यांस्त्वमावाहयिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2106222, "chapter_id": 3303, "verse_number": "१६-३२-७", "content_sanskrit": "इत्युक्त्वाऽन्तर्हितो विप्रस्ततोऽहं विस्मिताऽभवम्।\nन च सर्वास्ववस्थासु स्मृतिर्मे विप्रणश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2106223, "chapter_id": 3303, "verse_number": "१६-३२-८", "content_sanskrit": "अथ हर्म्यतलस्थाऽहं रविमुद्यन्तमीक्षती।\nसंस्मृत्य तदृषेर्वाक्यं स्पृहयन्ती दिवाकरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2106224, "chapter_id": 3303, "verse_number": "१६-३२-९", "content_sanskrit": "स्थिताऽहं बालभावेन तत्र दोषमबुद्ध्यती।\nअथ देवः सहस्रांशुर्मत्समीपगतोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2106225, "chapter_id": 3303, "verse_number": "१६-३२-१०", "content_sanskrit": "द्विधा कृत्वाऽऽत्मनो देहं भूमौ च गगनेऽपि च।\nतताप लोकानेकेन द्वितीयेनागमत्स माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2106226, "chapter_id": 3303, "verse_number": "१६-३२-११", "content_sanskrit": "स मामुवाच वेपन्तीं वरं मत्तो वृणीष्व ह।\nगम्यतामिति तं चाहं प्रणम्य सिरसाऽवदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2106227, "chapter_id": 3303, "verse_number": "१६-३२-१२", "content_sanskrit": "स मामुवाच तिग्मांशुर्वृथाऽऽह्वानं न मे क्षमम्।\nधक्ष्यामि त्वां च विप्रं च येन दत्तो वरस्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2106228, "chapter_id": 3303, "verse_number": "१६-३२-१३", "content_sanskrit": "तमहं रक्षती विप्रं शापादनपकारिणम्।\nपुत्रो मे त्वत्समो देव भवेदिति ततोऽब्रवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2106229, "chapter_id": 3303, "verse_number": "१६-३२-१४", "content_sanskrit": "ततो मां तेजसाऽऽविश्य मोहयित्वा च भानुमान्।\nउवाच भविता पुत्रस्तवेत्यभ्यगमद्दिवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2106230, "chapter_id": 3303, "verse_number": "१६-३२-१५", "content_sanskrit": "ततोऽहमन्तर्भवने पितुश्चित्तानुरक्षिणी।\nगूढोत्पन्नं सुतं बालं जले कर्णमवासृजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2106231, "chapter_id": 3303, "verse_number": "१६-३२-१६", "content_sanskrit": "नूनं तस्यैव देवस्य प्रसादात्पुनरेव तु।\nकन्याऽहमभवं विप्र यथा प्राह स मामृषिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2106232, "chapter_id": 3303, "verse_number": "१६-३२-१७", "content_sanskrit": "स मया सूढया पुत्रो ज्ञायमानोऽप्युपेक्षितः।\nतन्मां दहति विप्रर्षे यथा सुविदितं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2106233, "chapter_id": 3303, "verse_number": "१६-३२-१८", "content_sanskrit": "यदि पापमपापं वा यदेतद्विवृतं मया।\nतं द्रष्टुमिच्छामि भगवन्व्यपनेतुं त्वमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2106234, "chapter_id": 3303, "verse_number": "१६-३२-१९", "content_sanskrit": "यच्चास्य राज्ञो विदितं हृदिस्थं भवतोऽनघ।\nतं चायं लभतां काममद्यैव मुनिसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2106235, "chapter_id": 3303, "verse_number": "१६-३२-२०", "content_sanskrit": "इत्युक्तः प्रत्युवाचेदं व्यासो वेदविदांवरः।\nसाधु सर्वमिदं भाव्यमेवमेतद्यथाऽऽत्थ माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2106236, "chapter_id": 3303, "verse_number": "१६-३२-२१", "content_sanskrit": "अपराधश्च ते नास्ति कन्याभावं गता ह्यसि।\nदेवाश्चैश्वर्यवन्तो वै शरीराण्याविशन्ति वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2106237, "chapter_id": 3303, "verse_number": "१६-३२-२२", "content_sanskrit": "सन्ति देवनिकायाश्च संकल्पाज्जनयन्ति ये।\nवाचा दृष्ट्या तथा स्पर्शात्संघर्षेणेति पञ्चधा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2106238, "chapter_id": 3303, "verse_number": "१६-३२-२३", "content_sanskrit": "मनुष्यधर्मो दैवेन धर्मेण हि न दुष्यति।\nइति कुन्ति विजानीहि व्येतु ते मानसो ज्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2106239, "chapter_id": 3303, "verse_number": "१६-३२-२४", "content_sanskrit": "सर्वं बलवतां पथ्यं सर्वं बलवतां शुचि।\nसर्वं बलवतां धर्मः सर्वं बलवतां स्वकम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2106240, "chapter_id": 3303, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्रमवासिकपर्वणि पुत्रदर्शनपर्वणि द्वात्रिंशोऽध्यायः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]