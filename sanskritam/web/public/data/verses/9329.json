[{"id": 40020221, "chapter_id": 9329, "verse_number": "1", "content_sanskrit": "अथाब्रवीन्मुनिं रामः कथं ते भ्रातरो वने । कीदृशं तु तदा ब्रह्मंस्तपस्तेपुर्महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40020222, "chapter_id": 9329, "verse_number": "2", "content_sanskrit": "अगस्त्यस्त्वब्रवीत्तत्र रामं सुप्रीतमानसम् । तांस्तान्धर्मविधींस्तत्र भ्रातरस्ते समाविशन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40020223, "chapter_id": 9329, "verse_number": "3", "content_sanskrit": "कुम्भकर्णस्ततो यत्तो नित्यं धर्मपथे स्थितः । तताप ग्रीष्मकाले तु पञ्चाग्नीन्परितः स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40020224, "chapter_id": 9329, "verse_number": "4", "content_sanskrit": "मेघाम्बुसिक्तो वर्षासु वीरासनमसेवत । नित्यं च शिशिरे काले जलमध्यप्रतिश्रयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40020225, "chapter_id": 9329, "verse_number": "5", "content_sanskrit": "एवं वर्षसहस्राणि दश तस्यातिचक्रमुः । धर्मे प्रयतमानस्य सत्पथे निष्ठितस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40020226, "chapter_id": 9329, "verse_number": "6", "content_sanskrit": "विभीषणस्तु धर्मात्मा नित्यं धर्मपरः शुचिः । पञ्चवर्षसहस्राणि पादेनैकेन तस्थिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40020227, "chapter_id": 9329, "verse_number": "7", "content_sanskrit": "समाप्ते नियमे तस्य ननृतुश्चाप्सरोगणाः । पपात पुष्पवर्षं च क्षुभिताश्चापि देवताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40020228, "chapter_id": 9329, "verse_number": "8", "content_sanskrit": "पञ्चवर्षसहस्राणि सूर्यं चैवान्ववर्तत । तस्थौ चोर्ध्वशिरोबाहुः स्वाध्यायधृतमानसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40020229, "chapter_id": 9329, "verse_number": "9", "content_sanskrit": "एवं विभीषणस्यापि स्वर्गस्थस्येव नन्दने । दशवर्षसहस्राणि गतानि नियतात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40020230, "chapter_id": 9329, "verse_number": "10", "content_sanskrit": "दशवर्षसहस्रं तु निराहारो दशाननः । पूर्णे वर्षसहस्रे तु शिरश्चाग्नौ जुहाव सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40020231, "chapter_id": 9329, "verse_number": "11", "content_sanskrit": "एवं वर्षसहस्राणि नव तस्यातिचक्रमुः । शिरांसि नव चाप्यस्य प्रविष्टानि हुताशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40020232, "chapter_id": 9329, "verse_number": "12", "content_sanskrit": "अथ वर्षसहस्रे तु दशमे दशमं शिरः । छेत्तुकामे दशग्रीवे प्राप्तस्तत्र पितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40020233, "chapter_id": 9329, "verse_number": "13", "content_sanskrit": "पितामहस्तु सुप्रीतः सार्धं देवैरुपस्थितः । तव तावद्दशग्रीव प्रीतो ऽस्मीत्यभ्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40020234, "chapter_id": 9329, "verse_number": "14", "content_sanskrit": "शीघ्रं वरय धर्मज्ञ वरो यस्ते ऽभिकाङ्क्षितः । कं ते कामं करोम्यद्य न वृथा ते परिश्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40020235, "chapter_id": 9329, "verse_number": "15", "content_sanskrit": "अथाब्रवीदृशग्रीवः प्रहृष्टेनान्तरात्मना । प्रणम्य शिरसा देवं हर्षगद्गदया गिरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40020236, "chapter_id": 9329, "verse_number": "16", "content_sanskrit": "भगवन्प्राणिनां नित्यं नान्यत्र मरणाद्भयम् । नास्ति मृत्युसमः शत्रुरमरत्वमहं वृणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40020237, "chapter_id": 9329, "verse_number": "17", "content_sanskrit": "एवमुक्तस्तदा ब्रह्मा दशग्रीवमुवाच ह । नास्ति सर्वामरत्वं ते वरमन्यं वृणीष्व मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40020238, "chapter_id": 9329, "verse_number": "18", "content_sanskrit": "एवमुक्ते तदा राम ब्रह्मणा लोककर्तृणा । दशग्रीव उवाचेदं कृताञ्जलिरथाग्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40020239, "chapter_id": 9329, "verse_number": "19", "content_sanskrit": "सुपर्णनागयक्षाणां दैत्यदानवरक्षसाम् । अवध्यो ऽहं प्रजाध्यक्ष देवतानां च शाश्वत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40020240, "chapter_id": 9329, "verse_number": "20", "content_sanskrit": "नहि चिन्ता ममान्येषु प्राणिष्वमरपूजित । तृणभूता हि ते मन्ये प्राणिनो मानुषादयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40020241, "chapter_id": 9329, "verse_number": "21", "content_sanskrit": "एवमुक्तस्तु धर्मात्मा दशग्रीवेण रक्षसा । उवाच वचनं देवः सह देवैः पितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40020242, "chapter_id": 9329, "verse_number": "22", "content_sanskrit": "भविष्यत्येवमेतत्ते वचो राक्षसपुङ्गव । एवमुक्त्वा तु तं राम दशग्रीवं पितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40020243, "chapter_id": 9329, "verse_number": "23", "content_sanskrit": "शृणु चापि वरो भूयः प्रीतस्येह शुभो मम । हुतानि यानि शीर्षाणि पूर्वमग्नौ त्वयानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40020244, "chapter_id": 9329, "verse_number": "24", "content_sanskrit": "पुनस्तानि भविष्यन्ति तथैव तव राक्षस । वितरामीह ते सौम्य वरं चान्यं दुरासदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40020245, "chapter_id": 9329, "verse_number": "25", "content_sanskrit": "छन्दतस्तव रूपं च मनसा यद्यथेप्सितम् । भविष्यति न सन्देहो मद्वरात्तवराक्षस ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40020246, "chapter_id": 9329, "verse_number": "26", "content_sanskrit": "एवं पितामहोक्तस्य दशग्रीवस्य रक्षसः । अग्नौ हुतानि शीर्षाणि पुनस्तान्युत्थितानि वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40020247, "chapter_id": 9329, "verse_number": "27", "content_sanskrit": "एवमुक्त्वा तु तं राम दशग्रीवं पितामहः । विभीषणमथोवाच वाक्यं लोकपितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40020248, "chapter_id": 9329, "verse_number": "28", "content_sanskrit": "विभीषण त्वया वत्स धर्मसंहितबुद्धिना । परितुष्टो ऽस्मि धर्मात्मन्वरं वरय सुव्रत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40020249, "chapter_id": 9329, "verse_number": "29", "content_sanskrit": "विभीषणस्तु धर्मात्मा वचनं प्राह साञ्जलिः । वृतः सर्वगुणैर्नित्यं चन्द्रमा रश्मिभिर्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40020250, "chapter_id": 9329, "verse_number": "30", "content_sanskrit": "भगवन्कृतकृत्यो ऽहं यन्मे लोकगुरुः स्वयम् । प्रीतेन यदि दातव्यो वरो मे शृणु सुव्रत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40020251, "chapter_id": 9329, "verse_number": "31", "content_sanskrit": "परमापद्गतस्यापि धर्मे मम मतिर्भवेत् । अशिक्षितं च ब्रह्मास्त्रं भगवन्प्रतिभातु मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40020252, "chapter_id": 9329, "verse_number": "32", "content_sanskrit": "या या मे जायते बुद्धिर्येषु येष्वाश्रमेषु च । सा सा भवतु धर्मिष्ठा तं तु धर्मं च पालये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40020253, "chapter_id": 9329, "verse_number": "33", "content_sanskrit": "एष मे परमोदार वरः परमको मतः । नहि धर्माभिरक्तानां लोके किञ्चन दुर्लभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40020254, "chapter_id": 9329, "verse_number": "34", "content_sanskrit": "पुनः प्रजापतिः प्रीतो विभीषणमुवाच ह । धर्मिष्ठस्त्वं यथा वत्स तथा चैतद्भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40020255, "chapter_id": 9329, "verse_number": "35", "content_sanskrit": "यस्माद्राक्षसयोनौ ते जातस्यामित्रनाशन । नाधर्मे जायते बुद्धिरमरत्वं ददामि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40020256, "chapter_id": 9329, "verse_number": "36", "content_sanskrit": "इत्युक्त्वा कुम्भकर्णाय वरं दातुमुपस्थितम् । प्रजापतिं सुराः सर्वे वाक्यं प्राञ्जलयो ऽब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40020257, "chapter_id": 9329, "verse_number": "37", "content_sanskrit": "न तावत्कुम्भकर्णाय प्रदातव्यो वरस्त्वया । जानीषे हि यथा लोकांस्त्रासयत्येष दुर्मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40020258, "chapter_id": 9329, "verse_number": "38", "content_sanskrit": "नन्दने ऽप्सरसः सप्त महेन्द्रानुचरा दश । अनेन भक्षिता ब्रह्मन्नृषयो मानुषास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40020259, "chapter_id": 9329, "verse_number": "39", "content_sanskrit": "अलब्धवरपूर्वेण यत्कृतं राक्षसेन तु । तदेष वरलब्धः स्याद्भक्षयेद्भुवनत्रयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40020260, "chapter_id": 9329, "verse_number": "40", "content_sanskrit": "वरव्याजेन मोहो ऽस्मै दीयताममितप्रभ । लोकानां स्वस्ति चैवं स्याद्भवेदस्य च सन्नतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40020261, "chapter_id": 9329, "verse_number": "41", "content_sanskrit": "एवमुक्तः सुरैर्ब्रह्मा ऽचिन्तयत् पद्मसम्भवः । चिन्तिता चोपतस्थे ऽस्य पार्श्वं देवी सरस्वती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40020262, "chapter_id": 9329, "verse_number": "42", "content_sanskrit": "प्राञ्जलिः सा तु पार्श्वस्था प्राह वाक्यं सरस्वती । इयमस्म्यागता देव किं कार्यं करवाण्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 40020263, "chapter_id": 9329, "verse_number": "43", "content_sanskrit": "प्रजापतिस्तुं तां प्राप्तां प्राह वाक्यं सरस्वतीम् । वाणि त्वं राक्षसेन्द्रस्य भव या देवतेप्सिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 40020264, "chapter_id": 9329, "verse_number": "44", "content_sanskrit": "तथेत्युक्त्वा प्रविष्टा सा प्रजापतिरथाब्रवीत् । कुम्भकर्ण महाबाहो वरं वरय यो मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 40020265, "chapter_id": 9329, "verse_number": "45", "content_sanskrit": "कुम्भकर्णस्तु तद्वाक्यं श्रुत्वा वचनमब्रवीत् । स्वप्तुं वर्षाण्यनेकानि देवदेव ममेप्सितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 40020266, "chapter_id": 9329, "verse_number": "46", "content_sanskrit": "एवमस्त्विति तं चोक्त्वा प्रायाद्ब्रह्मा सुरैः समम् । देवी सरस्वती चैव राक्षसं तं जहौ पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 40020267, "chapter_id": 9329, "verse_number": "47", "content_sanskrit": "ब्रह्मणा सह देवेषु गतेषु च नभःस्थलम् । विमुक्तो ऽसौ सरस्वत्या स्वां सञ्ज्ञां च ततो गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 40020268, "chapter_id": 9329, "verse_number": "48", "content_sanskrit": "कुम्भकर्णस्तु दुष्टात्मा चिन्तयामास दुःखितः । ईदृशं किमिदं वाक्यं ममाद्य वदनाच्च्युतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 40020269, "chapter_id": 9329, "verse_number": "49", "content_sanskrit": "अहं व्यामोहितो देवैरिति मन्ये तदा ऽ ऽगतैः । एवं लब्धवराः सर्वे भ्रातरो दीप्ततेजसः । श्लेष्मातकवनं गत्वा तत्र ते न्यवसन्सुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]