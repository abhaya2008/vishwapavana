[{"id": 5000329000, "chapter_id": 9329, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे सप्तपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000329001, "chapter_id": 9329, "verse_number": "४-५७-१", "content_sanskrit": "शोकाद् भ्रष्टस्वरमपि श्रुत्वा वानरयूथपाः।\nश्रद्दधुर्नैव तद्वाक्यं कर्मणा तस्य शङ्किताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000329002, "chapter_id": 9329, "verse_number": "४-५७-२", "content_sanskrit": "ते प्रायमुपविष्टास्तु दृष्ट्वा गृध्रं प्लवंगमाः।\nचक्रुर्बुद्धिं तदा रौद्रां सर्वान् नो भक्षयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000329003, "chapter_id": 9329, "verse_number": "४-५७-३", "content_sanskrit": "सर्वथा प्रायमासीनान् यदि नो भक्षयिष्यति।\nकृतकृत्या भविष्यामः क्षिप्रं सिद्धिमितो गताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000329004, "chapter_id": 9329, "verse_number": "४-५७-४", "content_sanskrit": "एतां बुद्धिं ततश्चक्रुः सर्वे ते हरियूथपाः।\nअवतार्य गिरेः शृङ्गाद् गृध्रमाहाङ्गदस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000329005, "chapter_id": 9329, "verse_number": "४-५७-५", "content_sanskrit": "बभूवर्क्षरजो नाम वानरेन्द्रः प्रतापवान्।\nममार्यः पार्थिवः पक्षिन् धार्मिकौ तस्य चात्मजौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000329006, "chapter_id": 9329, "verse_number": "४-५७-६", "content_sanskrit": "सुग्रीवश्चैव वाली च पुत्रौ घनबलावुभौ।\nलोके विश्रुतकर्माभूद् राजा वाली पिता मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000329007, "chapter_id": 9329, "verse_number": "४-५७-७", "content_sanskrit": "राजा कृत्स्नस्य जगत इक्ष्वाकूणां महारथः।\nरामो दाशरथिः श्रीमान् प्रविष्टो दण्डकावनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000329008, "chapter_id": 9329, "verse_number": "४-५७-८", "content_sanskrit": "लक्ष्मणेन सह भ्रात्रा वैदेह्या सह भार्यया।\nपितुर्निदेशनिरतो धर्मं पन्थानमाश्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000329009, "chapter_id": 9329, "verse_number": "४-५७-९", "content_sanskrit": "तस्य भार्या जनस्थानाद् रावणेन हृता बलात्।\nरामस्य तु पितुर्मित्रं जटायुर्नाम गृध्रराट् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000329010, "chapter_id": 9329, "verse_number": "४-५७-१०", "content_sanskrit": "ददर्श सीतां वैदेहीं ह्रियमाणां विहायसा।\nरावणं विरथं कृत्वा स्थापयित्वा च मैथिलीम्।\nपरिश्रान्तश्च वृद्धश्च रावणेन हतो रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000329011, "chapter_id": 9329, "verse_number": "४-५७-११", "content_sanskrit": "एवं गृध्रो हतस्तेन रावणेन बलीयसा।\nसंस्कृतश्चापि रामेण जगाम गतिमुत्तमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000329012, "chapter_id": 9329, "verse_number": "४-५७-१२", "content_sanskrit": "ततो मम पितृव्येण सुग्रीवेण महात्मना।\nचकार राघवः सख्यं सोऽवधीत् पितरं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000329013, "chapter_id": 9329, "verse_number": "४-५७-१३", "content_sanskrit": "मम पित्रा निरुद्धो हि सुग्रीवः सचिवैः सह।\nनिहत्य वालिनं रामस्ततस्तमभिषेचयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000329014, "chapter_id": 9329, "verse_number": "४-५७-१४", "content_sanskrit": "स राज्ये स्थापितस्तेन सुग्रीवो वानरेश्वरः।\nराजा वानरमुख्यानां तेन प्रस्थापिता वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000329015, "chapter_id": 9329, "verse_number": "४-५७-१५", "content_sanskrit": "एवं रामप्रयुक्तास्तु मार्गमाणास्ततस्ततः।\nवैदेहीं नाधिगच्छामो रात्रौ सूर्यप्रभामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000329016, "chapter_id": 9329, "verse_number": "४-५७-१६", "content_sanskrit": "ते वयं दण्डकारण्यं विचित्य सुसमाहिताः।\nअज्ञानात् तु प्रविष्टाः स्म धरण्या विवृतं बिलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000329017, "chapter_id": 9329, "verse_number": "४-५७-१७", "content_sanskrit": "मयस्य मायाविहितं तद् बिलं च विचिन्वताम्।\nव्यतीतस्तत्र नो मासो यो राज्ञा समयः कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000329018, "chapter_id": 9329, "verse_number": "४-५७-१८", "content_sanskrit": "ते वयं कपिराजस्य सर्वे वचनकारिणः।\nकृतां संस्थामतिक्रान्ता भयात् प्रायमुपासिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000329019, "chapter_id": 9329, "verse_number": "४-५७-१९", "content_sanskrit": "क्रुद्धे तस्मिंस्तु काकुत्स्थे सुग्रीवे च सलक्ष्मणे।\nगतानामपि सर्वेषां तत्र नो नास्ति जीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000329020, "chapter_id": 9329, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे सप्तपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]