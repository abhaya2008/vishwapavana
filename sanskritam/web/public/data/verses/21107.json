[{"id": 7001107000, "chapter_id": 21107, "verse_number": "२-१-१८-१", "content_sanskrit": "ब्रह्मोवाच ।\nश्रुत्वा तथा स वृत्तांतं प्राक्तनं स्वं विनिंद्य च ।\nकांचिद्दिशं समालोक्य निर्ययौ दीक्षितांगजः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001107001, "chapter_id": 21107, "verse_number": "२-१-१८-२", "content_sanskrit": "कियच्चिरं ततो गत्वा यज्ञदत्तात्मजस्स हि ।\nदुष्टो गुणनिधिस्तस्थौ गतोत्साहो विसर्जितः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001107002, "chapter_id": 21107, "verse_number": "२-१-१८-३", "content_sanskrit": "चिंतामवाप महतीं क्व यामि करवाणि किम् ।\nनाहमभ्यस्तविद्योऽस्मि न चैवातिधनोऽस्म्यहम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001107003, "chapter_id": 21107, "verse_number": "२-१-१८-४", "content_sanskrit": "देशांतरे यस्य धनं स सद्यस्सुखमेधते ।\nभयमस्ति धने चौरात्स विघ्नस्सर्वतोभवः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001107004, "chapter_id": 21107, "verse_number": "२-१-१८-५", "content_sanskrit": "याजकस्य कुले जन्म कथं मे व्यसनं महत् ।\nअहो बलीयान्हि विधिर्भाविकर्मानुसंधयेत्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001107005, "chapter_id": 21107, "verse_number": "२-१-१८-६", "content_sanskrit": "भिक्षितुन्नाधिगच्छामि न मे परिचितिः क्वचित् ।\nन च पार्श्वे धनं किञ्चित्किमत्र शरणं भवेत्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001107006, "chapter_id": 21107, "verse_number": "२-१-१८-७", "content_sanskrit": "सदानभ्युदिते भानौ प्रसूर्मे मिष्टभोजनम् ।\nदद्यादद्यात्र कं याचे न चेह जननी मम॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001107007, "chapter_id": 21107, "verse_number": "२-१-१८-८", "content_sanskrit": "ब्रह्मोवाच ।\nइति चिंतयतस्तस्य बहुशस्तत्र नारद ।\nअति दीनं तरोर्मूले भानुरस्ताचलं गतः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001107008, "chapter_id": 21107, "verse_number": "२-१-१८-९", "content_sanskrit": "एतस्मिन्नेव समये कश्चिन्माहेश्वरो नरः ।\nसहोपहारानादाय नगराद्बहिरभ्यगात्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001107009, "chapter_id": 21107, "verse_number": "२-१-१८-१०", "content_sanskrit": "नानाविधान्महादिव्यान्स्वजनैः परिवारितः ।\nसमभ्यर्चितुमीशानं शिवरात्रावुपोषितः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001107010, "chapter_id": 21107, "verse_number": "२-१-१८-११", "content_sanskrit": "शिवालयं प्रविश्याथ स भक्तश्शिवसक्तधीः ।\nयथोचितं सुचित्तेन पूजयामास शंकरम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001107011, "chapter_id": 21107, "verse_number": "२-१-१८-१२", "content_sanskrit": "पक्वान्नगंधमाघ्राय यज्ञदत्तात्मजो द्विजः ।\nपितृत्यक्तो मातृहीनः क्षुधितः स तमन्वगात्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001107012, "chapter_id": 21107, "verse_number": "२-१-१८-१३", "content_sanskrit": "इदमन्नं मया ग्राह्यं शिवायोपकृतं निशि ।\nसुप्ते शैवजने दैवात्सर्वस्मिन्विविधं महत्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001107013, "chapter_id": 21107, "verse_number": "२-१-१८-१४", "content_sanskrit": "इत्याशामवलम्ब्याथ द्वारि शंभोरुपाविशत् ।\nददर्श च महापूजां तेन भक्तेन निर्मिताम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001107014, "chapter_id": 21107, "verse_number": "२-१-१८-१५", "content_sanskrit": "विधाय नृत्यगीतादि भक्तास्सुप्ताः क्षणे यदा ।\nनैवेद्यं स तदादातुं भर्गागारं विवेश ह॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001107015, "chapter_id": 21107, "verse_number": "२-१-१८-१६", "content_sanskrit": "दीपं मंदप्रभं दृष्ट्वा पक्वान्नवीक्षणाय सः ।\nनिजचैलांजलाद्वर्तिं कृत्वा दीपं प्रकाश्य च॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001107016, "chapter_id": 21107, "verse_number": "२-१-१८-१७", "content_sanskrit": "यज्ञदत्तात्मजस्सोऽथ शिवनैवेद्यमादरात् ।\nजग्राह सहसा प्रीत्या पक्वान्न वहुशस्ततः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001107017, "chapter_id": 21107, "verse_number": "२-१-१८-१८", "content_sanskrit": "ततः पक्वान्नमादाय त्वरितं गच्छतो बहिः ।\nतस्य पादतलाघातात्प्रसुप्तः कोप्यबुध्यत॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001107018, "chapter_id": 21107, "verse_number": "२-१-१८-१९", "content_sanskrit": "कोऽयं कोऽयं त्वरापन्नो गृह्यतां गृह्यता मसौ ।\nइति चुक्रोश स जनो गिरा भयमहोच्चया॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001107019, "chapter_id": 21107, "verse_number": "२-१-१८-२०", "content_sanskrit": "यावद्भयात्समागत्य तावत्स पुररक्षकैः ।\nपलायमानो निहतः क्षणादंधत्वमागतः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001107020, "chapter_id": 21107, "verse_number": "२-१-१८-२१", "content_sanskrit": "अभक्षयच्च नैवेद्यं यज्ञदत्तात्मजो मुने ।\nशिवानुग्रहतो नूनं भाविपुण्यबलान्न सः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001107021, "chapter_id": 21107, "verse_number": "२-१-१८-२२", "content_sanskrit": "अथ बद्धस्समागत्य पाशमुद्गरपाणिभिः ।\nनिनीषुभिः संयमनीं याम्यैस्स विकटैर्भटैः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001107022, "chapter_id": 21107, "verse_number": "२-१-१८-२३", "content_sanskrit": "तावत्पारिषदाः प्राप्ताः किंकि णीजालमालिनः ।\nदिव्यं विमानमादाय तं नेतुं शूलपाणयः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001107023, "chapter_id": 21107, "verse_number": "२-१-१८-२४", "content_sanskrit": "शिवगणा ऊचुः ।\nमुंचतैनं द्विजं याम्या गणाः परम धार्मिकम् ।\nदण्डयोग्यो न विप्रोऽसौ दग्धसर्वाघसंचयः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001107024, "chapter_id": 21107, "verse_number": "२-१-१८-२५", "content_sanskrit": "इत्याकर्ण्य वचस्ते हि यमराजगणास्ततः ।\nमहादेवगणानाहुर्बभूवुश्चकिता भृशम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001107025, "chapter_id": 21107, "verse_number": "२-१-१८-२६", "content_sanskrit": "शंभोर्गणानथालोक्य भीतैस्तैर्यमकिंकरैः ।\nअवादि प्रणतैरित्थं दुर्वृत्तोऽयं गणा द्विजः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001107026, "chapter_id": 21107, "verse_number": "२-१-१८-२७", "content_sanskrit": "यमगणा ऊचुः ।\nकुलाचारं प्रतीर्य्यैष पित्रोर्वाक्यपराङ्मुखः ।\nसत्यशौचपरिभ्रष्टस्संध्यास्नानविवर्जितः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001107027, "chapter_id": 21107, "verse_number": "२-१-१८-२८", "content_sanskrit": "आस्तां दूरेस्य कर्मान्यच्छिवनिर्माल्यलंघकः ।\nप्रत्यक्षतोऽत्र वीक्षध्वमस्पृश्योऽयं भवादृशाम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001107028, "chapter_id": 21107, "verse_number": "२-१-१८-२९", "content_sanskrit": "शिवनिर्माल्यभोक्तारश्शिवनिर्म्माल्यलंघकाः ।\nशिवनिर्माल्यदातारः स्पर्शस्तेषां ह्यपुण्यकृत्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001107029, "chapter_id": 21107, "verse_number": "२-१-१८-३०", "content_sanskrit": "विषमालोक्य वा पेयं श्रेयो वा स्पर्शनं परम् ।\nसेवितव्यं शिवस्वं न प्राणः कण्ठगतैरपि॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001107030, "chapter_id": 21107, "verse_number": "२-१-१८-३१", "content_sanskrit": "यूयं प्रमाणं धर्मेषु यथा न च तथा वयम् ।\nअस्ति चेद्धर्मलेशोस्य गणास्तं शृणुमो वयम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001107031, "chapter_id": 21107, "verse_number": "२-१-१८-३२", "content_sanskrit": "इत्थं तद्वाक्यमाकर्ण्य यामानां शिवकिंकराः ।\nस्मृत्वा शिवपदाम्भोजं प्रोचुः पारिषदास्तु तान्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001107032, "chapter_id": 21107, "verse_number": "२-१-१८-३३", "content_sanskrit": "शिवकिंकरा ऊचुः ।\nकिंकराश्शिवधर्मा ये सूक्ष्मास्ते तु भवादृशैः ।\nस्थूललक्ष्यैः कथं लक्ष्या लक्ष्या ये सूक्ष्मदृष्टिभिः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001107033, "chapter_id": 21107, "verse_number": "२-१-१८-३४", "content_sanskrit": "अनेनानेनसा कर्म यत्कृतं शृणुतेह तत् ।\nयज्ञदत्तात्मजेनाथ सावधानतया गणाः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001107034, "chapter_id": 21107, "verse_number": "२-१-१८-३५", "content_sanskrit": "पतंती लिंगशिरसि दीपच्छाया निवारिता ।\nस्वचैलांचलतोऽनेन दत्त्वा दीपदशां निशि॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001107035, "chapter_id": 21107, "verse_number": "२-१-१८-३६", "content_sanskrit": "अपरोपि परो धर्मो जातस्तत्रास्य किंकरः ।\nशृण्वतः शिवनामानि प्रसंगादपि गृह्णताम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001107036, "chapter_id": 21107, "verse_number": "२-१-१८-३७", "content_sanskrit": "भक्तेन विधिना पूजा क्रियमाणा निरीक्षिता ।\nउपोषितेन भूतायामनेनास्थितचेतसा॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001107037, "chapter_id": 21107, "verse_number": "२-१-१८-३८", "content_sanskrit": "शिवलोकमयं ह्यद्य गंतास्माभिस्सहैव तु ।\nकंचित्कालं महाभोगान्करिष्यति शिवानुगः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001107038, "chapter_id": 21107, "verse_number": "२-१-१८-३९", "content_sanskrit": "कलिंगराजो भविता ततो निर्धूतकल्मषः ।\nएष द्विजवरो नूनं शिवप्रियतरो यतः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001107039, "chapter_id": 21107, "verse_number": "२-१-१८-४०", "content_sanskrit": "अन्यत्किंचिन्न वक्तव्यं यूयं यात यथागतम् ।\nयमदूतास्स्वलोकं तु सुप्रसन्नेन चेतसा॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001107040, "chapter_id": 21107, "verse_number": "२-१-१८-४१", "content_sanskrit": "॥ ब्रह्मोवाच  ।\nइत्याकर्ण्य वचस्तेषां यमदूता मुनीश्वर ।\nयथागतं ययुस्सर्वे यमलोकं पराङ्मुखाः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001107041, "chapter_id": 21107, "verse_number": "२-१-१८-४२", "content_sanskrit": "सर्वं निवेदयामासुश्शमनाय गणा मुने ।\nतद्वृत्तमादितः प्रोक्तं शंभुदूतैश्च धर्मतः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001107042, "chapter_id": 21107, "verse_number": "२-१-१८-४३", "content_sanskrit": "॥ धर्मराज उवाच  ।\nसर्वे शृणुत मद्वाक्यं सावधानतया गणाः ।\nतदेव प्रीत्या कुरुत मच्छासनपुरस्सरम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001107043, "chapter_id": 21107, "verse_number": "२-१-१८-४४", "content_sanskrit": "ये त्रिपुण्ड्रधरा लोके विभूत्या सितया गणाः ।\nते सर्वे परिहर्तव्या नानेतव्याः कदाचन॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001107044, "chapter_id": 21107, "verse_number": "२-१-१८-४५", "content_sanskrit": "उद्धूलनकरा ये हि विभूत्या सितया गणाः ।\nते सर्वे परिहर्तव्या नानेतव्याः कदाचन॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001107045, "chapter_id": 21107, "verse_number": "२-१-१८-४६", "content_sanskrit": "शिववेषतया लोके येन केनापि हेतुना ।\nते सर्वे परिहर्तव्या नानेतव्याः कदाचन॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001107046, "chapter_id": 21107, "verse_number": "२-१-१८-४७", "content_sanskrit": "ये रुद्राक्षधरा लोके जटाधारिण एव ये ।\nते सवे परिहर्तव्या नानेतव्याः कदाचन॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001107047, "chapter_id": 21107, "verse_number": "२-१-१८-४८", "content_sanskrit": "उपजीवनहेतोश्च शिववेषधरा हि ये ।\nते सर्वे परिहर्तव्या नानेतव्याः कदाचन॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001107048, "chapter_id": 21107, "verse_number": "२-१-१८-४९", "content_sanskrit": "दंभेनापि च्छलेनापि शिववेषधरा हि ये ।\nते सर्वे परिहर्तव्या नानेतव्याः कदाचन॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001107049, "chapter_id": 21107, "verse_number": "२-१-१८-५०", "content_sanskrit": "एवमाज्ञापयामास स यमो निज किंकरान् ।\nतथेति मत्वा ते सर्वे तूष्णीमासञ्छुचिस्मिताः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001107050, "chapter_id": 21107, "verse_number": "२-१-१८-५१", "content_sanskrit": "॥ ब्रह्मोवाच  ।\nपार्षदैर्यमदूतेभ्यो मोचितस्त्विति स द्विजः ।\nशिवलोकं जगामाशु तैर्गणैश्शुचिमानसः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001107051, "chapter_id": 21107, "verse_number": "२-१-१८-५२", "content_sanskrit": "तत्र भुक्त्वाखिलान्भोगान्संसेव्य च शिवाशिवौ ।\nअरिंदमस्य तनयः कलिंगाधिपतेरभूत्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001107052, "chapter_id": 21107, "verse_number": "२-१-१८-५३", "content_sanskrit": "दम इत्यभिधानोऽभूच्छिवसेवापरायणः ।\nबालोऽपि शिशुभिः साकं शिवभक्तिं चकार सः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001107053, "chapter_id": 21107, "verse_number": "२-१-१८-५४", "content_sanskrit": "क्रमाद्राज्यमवापाथ पितर्युपरते युवा ।\nप्रीत्या प्रवर्तयामास शिवधर्मांश्च सर्वशः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001107054, "chapter_id": 21107, "verse_number": "२-१-१८-५५", "content_sanskrit": "नान्यं धर्मं स जानाति दुर्दमो भूपतिर्दमः ।\nशिवालयेषु सर्वेषु दीपदानादृते द्विजः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001107055, "chapter_id": 21107, "verse_number": "२-१-१८-५६", "content_sanskrit": "ग्रामाधीशान्समाहूय सर्वान्स विषयस्थितान् ।\nइत्थमाज्ञापयामास दीपा देयाश्शिवालये॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001107056, "chapter_id": 21107, "verse_number": "२-१-१८-५७", "content_sanskrit": "अन्यथा सत्यमेवेदं स मे दण्ड्यो भविष्यति ।\nदीप दानाच्छिवस्तुष्टो भवतीति श्रुतीरितम्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001107057, "chapter_id": 21107, "verse_number": "२-१-१८-५८", "content_sanskrit": "यस्ययस्याभितो ग्रामं यावतश्च शिवालयाः ।\nतत्रतत्र सदा दीपो द्योतनीयोऽविचारितम्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001107058, "chapter_id": 21107, "verse_number": "२-१-१८-५९", "content_sanskrit": "ममाज्ञाभंगदोषेण शिरश्छेत्स्याम्यसंशयम् ।\nइति तद्भयतो दीपा दीप्ताः प्रतिशिवालयम्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001107059, "chapter_id": 21107, "verse_number": "२-१-१८-६०", "content_sanskrit": "अनेनैव स धर्मेण यावज्जीवं दमो नृपः ।\nधर्मर्द्धिं महतीं प्राप्य कालधर्मवशं गतः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001107060, "chapter_id": 21107, "verse_number": "२-१-१८-६१", "content_sanskrit": "स दीपवासनायोगाद्बहून्दीपान्प्रदीप्य वै ।\nअलकायाः पतिरभूद्रत्नदीपशिखाश्रयः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001107061, "chapter_id": 21107, "verse_number": "२-१-१८-६२", "content_sanskrit": "एवं फलति कालेन शिवेऽल्पमपि यत्कृतम् ।\nइति ज्ञात्वा शिवे कार्यं भजनं सुसुखार्थिभिः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001107062, "chapter_id": 21107, "verse_number": "२-१-१८-६३", "content_sanskrit": "क्व स दीक्षितदायादः सर्वधर्मारतिः सदा ।\nशिवालये दैवयोगाद्यातश्चोरयितुं वसु ।\nस्वार्थदीपदशोद्योतलिंगमौलितमोहरः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001107063, "chapter_id": 21107, "verse_number": "२-१-१८-६४", "content_sanskrit": "कलिंगविषये राज्यं प्राप्तो धर्मरतिं सदा ।\nशिवालये समुद्दीप्य दीपान्प्राग्वासनोदयात्॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001107064, "chapter_id": 21107, "verse_number": "२-१-१८-६५", "content_sanskrit": "कैषा दिक्पालपदवी मुनीश्वर विलोकय ।\nमनुष्यधर्मिणानेन सांप्रतं येह भुज्यते॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001107065, "chapter_id": 21107, "verse_number": "२-१-१८-६६", "content_sanskrit": "इति प्रोक्तं गुणनिधेर्यज्ञदत्तात्मजस्य हि ।\nचरितं शिवसंतोषं शृण्वतां सर्वकामदम्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001107066, "chapter_id": 21107, "verse_number": "२-१-१८-६७", "content_sanskrit": "सर्वदेवशिवेनासौ सखित्वं च यथेयिवान् ।\nतदप्येकमना भूत्वा शृणु तात ब्रवीमि ते॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}]