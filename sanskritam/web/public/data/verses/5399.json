[{"id": 2206540, "chapter_id": 5399, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2206541, "chapter_id": 5399, "verse_number": "१", "content_sanskrit": "इत्युक्तवति वाक्यं तु कृष्णे देवकिनन्दने ।\nभीष्मं शान्तनवं भूयः पर्यपृच्छद् युधिष्ठिरः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2206542, "chapter_id": 5399, "verse_number": "२", "content_sanskrit": "निर्णये वा महाबुद्धे सर्वधर्मभृतांवर ।\nप्रत्यक्षं चागमो वापि किं तयोः कारणं भवेत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2206543, "chapter_id": 5399, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2206544, "chapter_id": 5399, "verse_number": "३", "content_sanskrit": "नास्त्यत्र संशयः कश्चिदिति मे वर्तते मतिः ।\nशृणु वक्ष्यामि ते प्राज्ञ सम्यक् त्वमनुपृच्छसि\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2206545, "chapter_id": 5399, "verse_number": "४", "content_sanskrit": "संशयः सुगमो राजन् निर्णयस्त्वत्र दुर्गमः ।\nदृष्टं श्रुतमनन्तं हि यत्र संशयदर्शनम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2206546, "chapter_id": 5399, "verse_number": "५", "content_sanskrit": "प्रत्यक्षं कारणं दृष्टं हेतुकाः प्राज्ञमानिनः ।\nनास्तीत्येवं व्यवस्यन्ति सत्यं संशयमेव च ।\nतदयुक्तं व्यवस्यन्ति बालाः पण्डितमानिनः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2206547, "chapter_id": 5399, "verse_number": "६", "content_sanskrit": "अथ चेन्मन्यसे चैकं कारणं किं भवेदिति ।\nशक्यं दीर्घेण कालेन युक्तेनातन्द्रितेन च ।\nप्राणयात्रामनेकां च कल्पयानेन भारत\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2206548, "chapter_id": 5399, "verse_number": "७", "content_sanskrit": "तत्परेणैव नान्येन शक्यं ह्येतत् तु कारणम् ।\nहेतूनामन्तमासाद्य विपुलं ज्ञानमुत्तमम् ।\nज्योतिः सर्वस्य लोकस्य विपुलं प्रतिपद्यते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2206549, "chapter_id": 5399, "verse_number": "८", "content_sanskrit": "तत्त्वेनागमनं राजन् हेत्वागमनं तथा ।\nअग्राह्यमनिबद्धं च वाचा सम्परिवर्जयेत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2206550, "chapter_id": 5399, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2206551, "chapter_id": 5399, "verse_number": "९", "content_sanskrit": "प्रत्यक्षं लोकतः सिद्धं लोकाश्चागमपूर्वकाः ।\nशिष्टाचारो बहुविधो ब्रूहि तन्मे पितामह\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2206552, "chapter_id": 5399, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2206553, "chapter_id": 5399, "verse_number": "१०", "content_sanskrit": "धर्मस्य ह्रियमाणस्य बलवद्भिर्दुरात्मभिः ।\nसंस्था यत्नैरपि कृता कालेन परिभिद्यते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2206554, "chapter_id": 5399, "verse_number": "११", "content_sanskrit": "अधर्मा धर्मरूपेण तृणैः कूपा इवावृताः ।\nततस्तैर्भिद्यते वृत्तं शृणु चैव युधिष्ठिर\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2206555, "chapter_id": 5399, "verse_number": "१२", "content_sanskrit": "अवृत्त्या ये च भिन्दन्ति श्रुतत्यागपरायणाः ।\nधर्मविद्वेषिणो मन्दा इत्युक्तास्ते न संशयः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2206556, "chapter_id": 5399, "verse_number": "१३", "content_sanskrit": "अतृप्यन्तस्तु साधूनां य एवागमबुद्धयः ।\nपरमित्येव सन्तुष्टास्तानुपास्व च पृच्छ च\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2206557, "chapter_id": 5399, "verse_number": "१४", "content_sanskrit": "कामार्थौ पृष्ठतः कृत्वा लोभमोहानुसारिणौ ।\nधर्म इत्येव सम्बुद्धास्तानुपास्व च पृच्छ च\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2206558, "chapter_id": 5399, "verse_number": "१५", "content_sanskrit": "न तेषां भिद्यते वृत्तं यज्ञस्वाध्यायकर्मभिः ।\nआचारः कारणं चैव धर्मश्चैव त्रयं पुनः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2206559, "chapter_id": 5399, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2206560, "chapter_id": 5399, "verse_number": "१६", "content_sanskrit": "पुनरेवेह मे बुद्धिः संशये परिमुह्यते ।\nअपारे मार्गमाणस्य परं तीरमपश्यतः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2206561, "chapter_id": 5399, "verse_number": "१७", "content_sanskrit": "वेदाः प्रत्यक्षमाचारः प्रमाणं तत् त्रयं यदि ।\nपृथक्त्वं लभ्यते चैषां धर्मश्चैकस्त्रयं कथम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2206562, "chapter_id": 5399, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2206563, "chapter_id": 5399, "verse_number": "१८", "content_sanskrit": "धर्मस्य ह्रियमाणस्य बलवद्भिर्दुरात्मभिः ।\nयद्येवं मन्यसे राजन् त्रिधा धर्मविचारणा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2206564, "chapter_id": 5399, "verse_number": "१९", "content_sanskrit": "एक एवेति जानीहि त्रिधा तस्य प्रदर्शनम् ।\nपृथक्त्वे चैव मे बुद्धिस्त्रयाणामपि वै तथा\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2206565, "chapter_id": 5399, "verse_number": "२०", "content_sanskrit": "उक्तो मार्गस्त्रयाणां च तत् तथैव समाचर ।\nजिज्ञासा तु न कर्तव्या धर्मेण परतर्किणा\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2206566, "chapter_id": 5399, "verse_number": "२१", "content_sanskrit": "सदैव भरतश्रेष्ठ मा ते भूदत्र संशयः ।\nअन्धो जड इवाशङ्को यद् ब्रवीमि तदाचर\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2206567, "chapter_id": 5399, "verse_number": "२२", "content_sanskrit": "अहिंसा सत्यमक्रोधो दानमेतच्चतुष्टयम् ।\nअजातशत्रो सेवस्व धर्म एष सनातनः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2206568, "chapter_id": 5399, "verse_number": "२३", "content_sanskrit": "ब्राह्मणेषु च वृत्तिर्या पितृपैतामहोचिता ।\nतामन्वेहि महाबाहो स्वर्गस्यैते हि देशिकाः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2206569, "chapter_id": 5399, "verse_number": "२४", "content_sanskrit": "प्रमाणमप्रमाणं वै यः कुर्यादबुधो नरः ।\nन स प्रमाणतामर्हो विवादजननो हि सः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2206570, "chapter_id": 5399, "verse_number": "२५", "content_sanskrit": "ब्राह्मणानेव सेवस्व सत्कृत्य बहुमन्य च ।\nएतेष्वेव त्विमे लोकाः कृत्स्ना इति निबोध तान्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2206571, "chapter_id": 5399, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे धर्माधर्मविचारो नाम पञ्चाशदुत्तरद्विशततमोऽध्यायः ॥२५०॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]