[{"id": 6000247000, "chapter_id": 10247, "verse_number": null, "content_sanskrit": "अथ एकपञ्चाशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000247001, "chapter_id": 10247, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.001.m4a", "display_order": 2}, {"id": 6000247002, "chapter_id": 10247, "verse_number": "१०-५१-१", "content_sanskrit": "मागधस्तु रणश्लाघी माधवेन पराजितः।\nजगाम शोणितपुरं बाणं द्रष्टुं बलेः सुतम्॥ १०/५१/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.002.m4a", "display_order": 3, "topics": [{"text": "बाणासुरं सहायं वरीतुं जरासन्धस्य शोणितपुरगमनम्", "range": "१"}]}, {"id": 6000247003, "chapter_id": 10247, "verse_number": "१०-५१-२", "content_sanskrit": "तं तथाऽऽयान्तमाकर्ण्य वृतराजन्यमण्डलम्।\nमित्रं पराजितं युद्धे विष्णुना दानवेश्वरः॥ १०/५१/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.003.m4a", "display_order": 4, "topics": [{"text": "तत्प्रेषिताभ्यां कुम्भाण्डकूपकर्णाभ्यां तन्मन्त्रिभ्यां सहागत्य मथुरां निरुध्य युद्धारम्भः", "range": "२–३०"}]}, {"id": 6000247004, "chapter_id": 10247, "verse_number": "१०-५१-३", "content_sanskrit": "अलङ्कृतैर्गजैरश्वैर्विचित्रस्यन्दनैर्भटैः।\nवारकान्ताकदम्बैश्च सूतमागधवन्दिभिः॥ १०/५१/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.004.m4a", "display_order": 5}, {"id": 6000247005, "chapter_id": 10247, "verse_number": "१०-५१-४", "content_sanskrit": "ध्वजैः पताकैश्छत्रैश्च माङ्गल्यैः पटहस्वनैः।\nसुवर्णतोरणैश्चित्रैर्दीपैः कलशदर्पणैः॥ १०/५१/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.005.m4a", "display_order": 6}, {"id": 6000247006, "chapter_id": 10247, "verse_number": "१०-५१-५", "content_sanskrit": "उपतस्थे जरासन्धं बाणो बाहुसहस्रवान्।\nतौ दृष्ट्वा परमस्निग्धौ परस्परमनोऽनुगौ॥ १०/५१/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.006.m4a", "display_order": 7}, {"id": 6000247007, "chapter_id": 10247, "verse_number": "१०-५१-६", "content_sanskrit": "पूजां चक्रतुरन्योन्यमन्योन्यप्रियकारिणौ।\nततोऽब्रवीज्जरासन्धो बाणमाभाष्य संसदि॥ १०/५१/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.007.m4a", "display_order": 8}, {"id": 6000247008, "chapter_id": 10247, "verse_number": "१०-५१-७", "content_sanskrit": "दानवेन्द्र निबोधेदं गोपेनाधर्मचारिणा।\nरात्रौ चौर्यप्रतापेन वञ्चितोऽस्मि दुरात्मना॥ १०/५१/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.008.m4a", "display_order": 9}, {"id": 6000247009, "chapter_id": 10247, "verse_number": "१०-५१-८", "content_sanskrit": "गृहीता बहवस्तुङ्गा मातङ्गा मदशालिनः।\nतुरङ्गमाश्च बहवो रथाश्च सपरिच्छदाः॥ १०/५१/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.009.m4a", "display_order": 10}, {"id": 6000247010, "chapter_id": 10247, "verse_number": "१०-५१-९", "content_sanskrit": "द्वन्द्वेन सज्जमानं मामिमे भूपा न सेहिरे।\nनिरुद्धस्तैरहं भूपैरेतैः समसुखासुखैः॥ १०/५१/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.010.m4a", "display_order": 11}, {"id": 6000247011, "chapter_id": 10247, "verse_number": "१०-५१-१०", "content_sanskrit": "त्वत्सन्निधिमिहायातः साहाय्यं कुरु मे प्रभो।\nइत्युक्तस्तं निजपुरं प्रवेश्य बलिनन्दनः॥ १०/५१/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.011.m4a", "display_order": 12}, {"id": 6000247012, "chapter_id": 10247, "verse_number": "१०-५१-११", "content_sanskrit": "स राजमण्डलायाशु कारयामास सत्क्रियाम्।\nभोजनस्नानशयनगन्धताम्बूलपूर्वकैः॥ १०/५१/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.012.m4a", "display_order": 13}, {"id": 6000247013, "chapter_id": 10247, "verse_number": "१०-५१-१२", "content_sanskrit": "अर्हणैरर्हयामास सराजन्यं जरासुतम्।\nतं भुक्तवन्तं विश्रान्तं दृष्टदर्शनकौतुकम्॥ १०/५१/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.013.m4a", "display_order": 14}, {"id": 6000247014, "chapter_id": 10247, "verse_number": "१०-५१-१३", "content_sanskrit": "अलङ्कृतं सह नृपैरासीनं काञ्चनासने।\nउवाच दानवपतिर्नृपानाभाष्य सादरम्॥ १०/५१/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.014.m4a", "display_order": 15}, {"id": 6000247015, "chapter_id": 10247, "verse_number": null, "content_sanskrit": "बाण उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.015.m4a", "display_order": 16}, {"id": 6000247016, "chapter_id": 10247, "verse_number": "१०-५१-१४", "content_sanskrit": "जरासन्ध निबोधेदं न मृषा कथ्यते मया। एते गजा इमे चाश्वा इदं राज्यमिमाः प्रजाः।\nत्वदधीनमिदं विश्वं यच्चान्यद् वस्तु विद्यते॥ १०/५१/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.016.m4a", "display_order": 17}, {"id": 6000247017, "chapter_id": 10247, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.017.m4a", "display_order": 18}, {"id": 6000247018, "chapter_id": 10247, "verse_number": "१०-५१-१५", "content_sanskrit": "इत्युक्त्वा प्रददौ तस्मै मागधाय बलेः सुतः।\nगजानां षष्टिसाहस्रं रथानां नियुतं तथा॥ १०/५१/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.018.m4a", "display_order": 19}, {"id": 6000247019, "chapter_id": 10247, "verse_number": "१०-५१-१६", "content_sanskrit": "प्रयुतं चतुरङ्गाणां मनोमारुतरंहसाम्।\nदानवानां प्रसिद्धानां मायासङ्ग्रामवेदिनाम्॥ १०/५१/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.019.m4a", "display_order": 20}, {"id": 6000247020, "chapter_id": 10247, "verse_number": "१०-५१-१७", "content_sanskrit": "त्रिशतं स्वात्मसाम्यानां ददौ बाणो बलेः सुतः।\nविचित्रशिबिकाच्छत्रव्यजनाकल्पवाससाम्॥ १०/५१/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.020.m4a", "display_order": 21}, {"id": 6000247021, "chapter_id": 10247, "verse_number": "१०-५१-१८", "content_sanskrit": "असङ्ख्यातं ददौ राजन् भाण्डशय्यासनादिकम्।\nकुम्भाण्डं कूपकर्णं च मन्त्रिणौ दैत्यसत्तमौ॥ १०/५१/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.021.m4a", "display_order": 22}, {"id": 6000247022, "chapter_id": 10247, "verse_number": "१०-५१-१९", "content_sanskrit": "आज्ञापयामास बाणः साहाय्यार्थं कुरूद्वह।\nक्‍व सुरासुरसङ्घातसंहारणपटुर्हरिः॥ १०/५१/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.022.m4a", "display_order": 23}, {"id": 6000247023, "chapter_id": 10247, "verse_number": "१०-५१-२०", "content_sanskrit": "कुम्भाण्डकूपकर्णौ क्‍व वराकौ बाणमन्त्रिणौ।\nअजानन्तो विष्णुशक्तिं भूपाला विनशिष्णवः॥ १०/५१/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.023.m4a", "display_order": 24}, {"id": 6000247024, "chapter_id": 10247, "verse_number": "१०-५१-२१", "content_sanskrit": "चक्रुर्भूयो रणोद्योगं मागधेन प्रचोदिताः।\nबाणेन समनुज्ञातो मागधः शोणितात् पुरात्॥ १०/५१/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.024.m4a", "display_order": 25}, {"id": 6000247025, "chapter_id": 10247, "verse_number": "१०-५१-२२", "content_sanskrit": "निर्गत्यानेकभूपालचतुरङ्गबलान्वितः।\nदिनैः कतिपयैर्भूयो मधुरामन्वपद्यत॥ १०/५१/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.025.m4a", "display_order": 26}, {"id": 6000247026, "chapter_id": 10247, "verse_number": "१०-५१-२३", "content_sanskrit": "सन्निरुध्य पुरद्वारं गोपुराट्टालतोरणैः।\nदीर्घिकोपवनोद्यानैरुपेतं सालभूषितम्॥ १०/५१/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.026.m4a", "display_order": 27}, {"id": 6000247027, "chapter_id": 10247, "verse_number": "१०-५१-२४", "content_sanskrit": "कुन्तैः कुठारैः कुद्दालैर्दण्डभारैश्च भूरिभिः।\nकर्षणस्थैश्च पाषाणैर्बभञ्ज परितः पुरम्॥ १०/५१/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.027.m4a", "display_order": 28}, {"id": 6000247028, "chapter_id": 10247, "verse_number": "१०-५१-२५", "content_sanskrit": "भज्यमाने वने तस्मिन् श्रुत्वा मागधमागतम्।\nसन्नाहभेरीः सन्नाद्य रामकृष्णावमर्षिणौ॥ १०/५१/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.028.m4a", "display_order": 29}, {"id": 6000247029, "chapter_id": 10247, "verse_number": "१०-५१-२६", "content_sanskrit": "रथाश्वकुञ्जरानीकैः सायुधैः सपरिच्छदैः।\nसात्यकिं कृतवर्माणमुग्रसेनं तथा गदम्॥ १०/५१/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.029.m4a", "display_order": 30}, {"id": 6000247030, "chapter_id": 10247, "verse_number": "१०-५१-२७", "content_sanskrit": "आहुकं वसुदेवं च पुरस्कृत्य महाबलौ।\nनिर्जग्मतुरसम्भ्रान्तौ दीप्तौ केसरिणौ यथा॥ १०/५१/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.030.m4a", "display_order": 31}, {"id": 6000247031, "chapter_id": 10247, "verse_number": "१०-५१-२८", "content_sanskrit": "मधुराया विनिर्गत्य कृष्णः कमललोचनः।\nपाञ्चजन्यं महाशङ्खं प्रदध्मौ रिपुभूषणम्॥ १०/५१/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.031.m4a", "display_order": 32}, {"id": 6000247032, "chapter_id": 10247, "verse_number": "१०-५१-२९", "content_sanskrit": "ततः प्रववृते युद्धं यदूनां क्षत्रियैः सह।\nकुम्भाण्डकूपकर्णौ च दानवौ बाणमन्त्रिणौ॥ १०/५१/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.032.m4a", "display_order": 33}, {"id": 6000247033, "chapter_id": 10247, "verse_number": "१०-५१-३०", "content_sanskrit": "दैत्यसैन्येन महता वृतौ मायाविशारदौ।\nयुयुधाते महावीर्यौ मायया वृष्णिभिः सह॥ १०/५१/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.033.m4a", "display_order": 34}, {"id": 6000247034, "chapter_id": 10247, "verse_number": "१०-५१-३१", "content_sanskrit": "स्वसैन्यं मायया क्लिष्टं दृष्ट्वा यादवसत्तमः। विज्ञानास्‍त्रेण तन्मायामपास्य निमिषान्तरे।\nसात्यकिं कृतवर्माणं चोवाचाहवलालसौ॥ १०/५१/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.034.m4a", "display_order": 35}, {"id": 6000247035, "chapter_id": 10247, "verse_number": "१०-५१-३२", "content_sanskrit": "आभ्यां भवन्तौ रणदुर्मदाभ्यां रणं सुघोरं कुरुतं रणप्रियौ।\nतावेवमुक्तौ कदनं भयानकं महाबलौ सम्प्रति चक्रतुर्नृप॥ १०/५१/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.035.m4a", "display_order": 36}, {"id": 6000247036, "chapter_id": 10247, "verse_number": "१०-५१-३३", "content_sanskrit": "चापेनैकेन गोविन्दः क्षत्रियैः शतसम्मितैः।\nयुयुधे न हि तच्चित्रं राजन् विश्वात्मनो हरेः॥ १०/५१/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.036.m4a", "display_order": 37}, {"id": 6000247037, "chapter_id": 10247, "verse_number": "१०-५१-३४", "content_sanskrit": "केचिद् हताः समापेतुः कुञ्जराश्छिन्नपुष्कराः।\nनिपेतुर्बहवो राजंस्तुरङ्गाः कृत्तकन्धराः॥ १०/५१/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.037.m4a", "display_order": 38}, {"id": 6000247038, "chapter_id": 10247, "verse_number": "१०-५१-३५", "content_sanskrit": "विशीर्णैरास्तृता पृथ्वी स्यन्दनैश्छिन्नबन्धनैः।\nभटाश्च रुधिराक्ताङ्गाश्छिन्नपादोरुबाहवः॥ १०/५१/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.038.m4a", "display_order": 39}, {"id": 6000247039, "chapter_id": 10247, "verse_number": "१०-५१-३६", "content_sanskrit": "पेतुः कृत्तमहामूलाः किंशुका इव पुष्पिताः।\nशार्ङ्गमुक्ताः शरगणाः कङ्कबर्हिणवाससः॥ १०/५१/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.039.m4a", "display_order": 40}, {"id": 6000247040, "chapter_id": 10247, "verse_number": "१०-५१-३७", "content_sanskrit": "तैलाक्ता नतपर्वाणः स्वर्णपुङ्खा अयोमुखाः।\nएकैकस्मिन् दश दश भटे चाश्वे शतं शतम्॥ १०/५१/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.040.m4a", "display_order": 41}, {"id": 6000247041, "chapter_id": 10247, "verse_number": "१०-५१-३८", "content_sanskrit": "रथे रथे च साहस्रमयुतं च गजे गजे।\nअदृश्यन्त परानीके तदद्भुतमिवाभवत्॥ १०/५१/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.041.m4a", "display_order": 42}, {"id": 6000247042, "chapter_id": 10247, "verse_number": "१०-५१-३९", "content_sanskrit": "तथा तैरर्द्यमानेषु चतुरङ्गेषु मागधः।\nरथेन क्रोडचिह्नेन बलभद्रमुपाद्रवत्॥ १०/५१/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.042.m4a", "display_order": 43}, {"id": 6000247043, "chapter_id": 10247, "verse_number": "१०-५१-४०", "content_sanskrit": "स पूर्ववैरं नृपतिः स्मरन् रुषा रथं महाकाञ्चनतालकूबरम्।\nआलक्ष्य दूरादधिगम्य रंहसा जरासुतः प्राह हलायुधं गदी॥ १०/५१/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.043.m4a", "display_order": 44, "topics": [{"text": "बलरामजरासन्धयोर्द्वन्द्वयुद्धम्", "range": "४०–५८"}]}, {"id": 6000247044, "chapter_id": 10247, "verse_number": "१०-५१-४१", "content_sanskrit": "आदत्स्व ते मुसलं राम तूर्णं येनाहितानिच्छसि जेतुमाहवे।\nबलं च बाह्वोस्तव दर्शयाशु मे यावद् गदां न प्रहराम्यहं त्वयि॥ १०/५१/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.044.m4a", "display_order": 45}, {"id": 6000247045, "chapter_id": 10247, "verse_number": "१०-५१-४२", "content_sanskrit": "इत्येवमुक्तो मगधेश्वरेण सङ्कर्षणोऽमर्षणविह्वलेक्षणः।\nआदाय घोरं मुसलं तटित्प्रभं दण्डं यथा सूर्यसुतो युगक्षये॥ १०/५१/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.045.m4a", "display_order": 46}, {"id": 6000247046, "chapter_id": 10247, "verse_number": "१०-५१-४३", "content_sanskrit": "आवर्तयित्वा मुसलं हलायुधः सहस्रकृत्वो रिपुदर्पहारिणम्।\nधूमाङ्कुरोद्गारिणमाशु तस्मै चिक्षेप राजन् व्यनदद्धरिर्यथा॥ १०/५१/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.046.m4a", "display_order": 47}, {"id": 6000247047, "chapter_id": 10247, "verse_number": "१०-५१-४४", "content_sanskrit": "रामबाहुविमुक्तेन मुसलेन जरासुतः।\nसाश्वसूते रथे क्षुण्णे क्षणेन व्यंसितः स्वयम्॥ १०/५१/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.047.m4a", "display_order": 48}, {"id": 6000247048, "chapter_id": 10247, "verse_number": "१०-५१-४५", "content_sanskrit": "ततः कालायसीं गुर्वीं गिरिकूटोपमां गदाम्।\nबिभ्रद् गुर्वीं पदा पृथ्वीं चालयन्नभ्यगाद् बलम्॥ १०/५१/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.048.m4a", "display_order": 49}, {"id": 6000247049, "chapter_id": 10247, "verse_number": "१०-५१-४६", "content_sanskrit": "तमापतन्तमालोक्य विरथं रोहिणीसुतः।\nतमेवाभ्यद्रवत् पद्भ्यां विसृज्य स्यन्दनं रणे॥ १०/५१/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.049.m4a", "display_order": 50}, {"id": 6000247050, "chapter_id": 10247, "verse_number": "१०-५१-४७", "content_sanskrit": "पश्यतां सर्वभूतानां मागधः क्रोधविह्वलः। आवर्तयन् गदां गुर्वीमयःसारमयीं दृढाम्।\nअभ्येत्य गदया रामं प्रजहार ननाद च॥ १०/५१/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.050.m4a", "display_order": 51}, {"id": 6000247051, "chapter_id": 10247, "verse_number": "१०-५१-४८", "content_sanskrit": "तां गदां पतितां वक्षस्यश्मकुट्टनिभां दृढाम्।\nवामेन जगृहे रामः स्वहस्तेन कुरूद्वह॥ १०/५१/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.051.m4a", "display_order": 52}, {"id": 6000247052, "chapter_id": 10247, "verse_number": "१०-५१-४९", "content_sanskrit": "विसृज्य स गदां तूर्णमुरसाऽऽहत्य मागधम्।\nजग्राहाश्लिष्य बलिनं बलवान् रोहिणीसुतः॥ १०/५१/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.052.m4a", "display_order": 53}, {"id": 6000247053, "chapter_id": 10247, "verse_number": "१०-५१-५०", "content_sanskrit": "बबन्ध पद्भ्यां जठरं मागधस्य हलायुधः।\nचकार कुक्षौ तत्कण्ठं ततस्तौ पेततुर्भुवि॥ १०/५१/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.053.m4a", "display_order": 54}, {"id": 6000247054, "chapter_id": 10247, "verse_number": "१०-५१-५१", "content_sanskrit": "तयोर्निपततो राजन् उपर्यासीद्धलायुधः।\nतं मागधः क्षणेनाधश्चकारामितविक्रमः॥ १०/५१/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.054.m4a", "display_order": 55}, {"id": 6000247055, "chapter_id": 10247, "verse_number": "१०-५१-५२", "content_sanskrit": "तत उत्थाय तौ वीरौ क्रोधसंरक्तलोचनौ।\nभूयो जगृहतुर्घोरौ मत्तौ द्वाविव कुञ्जरौ॥ १०/५१/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.055.m4a", "display_order": 56}, {"id": 6000247056, "chapter_id": 10247, "verse_number": "१०-५१-५३", "content_sanskrit": "तावुभौ परमक्रुद्धौ परस्परवधैषिणौ।\nउरसोरः समाहत्य भीमौ चकृषतू रणे॥ १०/५१/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.056.m4a", "display_order": 57}, {"id": 6000247057, "chapter_id": 10247, "verse_number": "१०-५१-५४", "content_sanskrit": "एवं धनुःशतशतं तावाकृष्य परस्परम्।\nनिकटस्थान् द्रुमान् शैलांश्चूर्णयामासतुर्नृप॥ १०/५१/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.057.m4a", "display_order": 58}, {"id": 6000247058, "chapter_id": 10247, "verse_number": "१०-५१-५५", "content_sanskrit": "तं विसृज्य जरासन्धो गदामादाय दुर्मदः। उदतिष्ठदमेयात्मा रामोऽपि बलिनां वरः।\nक्षणादादत्त मुसलं प्रहर्तुमुपचक्रमे॥ १०/५१/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.058.m4a", "display_order": 59}, {"id": 6000247059, "chapter_id": 10247, "verse_number": "१०-५१-५६", "content_sanskrit": "तं कामपालो मुसलेन मूर्ध्नि जत्रुण्यंसे भुजयोर्नाभिदेशे।\nशङ्खे च जानौ जठरे च वक्षस्यनेकशो वै प्रजहार युद्धे॥ १०/५१/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.059.m4a", "display_order": 60}, {"id": 6000247060, "chapter_id": 10247, "verse_number": "१०-५१-५७", "content_sanskrit": "तं मागधो वक्षसि कन्धरे च मुखे ललाटे चुबुके तथांऽसे।\nनाभौ नितम्बे च तथैव पार्श्वे समं स मानी प्रजहार रामम्॥ १०/५१/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.060.m4a", "display_order": 61}, {"id": 6000247061, "chapter_id": 10247, "verse_number": "१०-५१-५८", "content_sanskrit": "एवं प्रहरतोस्तत्र राममागधयोर्मृधे।\nराजानो रणसंविग्ना बभूवुर्भृशपीडिताः॥ १०/५१/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.061.m4a", "display_order": 62}, {"id": 6000247062, "chapter_id": 10247, "verse_number": "१०-५१-५९", "content_sanskrit": "क्रमेण ते विमनसो निवृत्तकदनोद्यमाः।\nआसन्नासन्ननिधनं मन्वाना मागधेश्वरम्॥ १०/५१/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.062.m4a", "display_order": 63}, {"id": 6000247063, "chapter_id": 10247, "verse_number": "१०-५१-६०", "content_sanskrit": "सात्यकिस्तु महातेजाः सङ्गरे बाणमन्त्रिणा।\nयुध्यमानस्‍त्रिभिर्बाणैः कुभाण्डेन समर्पितः॥ १०/५१/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.063.m4a", "display_order": 64}, {"id": 6000247064, "chapter_id": 10247, "verse_number": "१०-५१-६१", "content_sanskrit": "सोऽतिविद्धो महाबाहुः क्रुद्धः सर्प इव श्वसन्।\nआददे पञ्च नाराचान् कुम्भाण्डं हन्तुमाहवे॥ १०/५१/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.064.m4a", "display_order": 65}, {"id": 6000247065, "chapter_id": 10247, "verse_number": "१०-५१-६२", "content_sanskrit": "ततो हाहारवो जज्ञे सेनायां दैत्यमन्त्रिणः।\nसात्यकिस्तु महाबाहुराकृष्याकर्णमाशुगैः॥ १०/५१/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.065.m4a", "display_order": 66}, {"id": 6000247066, "chapter_id": 10247, "verse_number": "१०-५१-६३", "content_sanskrit": "विव्याध कुरुशार्दूल कुम्भाण्डं बाणमन्त्रिणम्।\nनाभौ कण्ठे ललाटे च हृदि मूर्ध्न्यपि दानवम्॥ १०/५१/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.066.m4a", "display_order": 67}, {"id": 6000247067, "chapter_id": 10247, "verse_number": "१०-५१-६४", "content_sanskrit": "अतिविद्धो रथोपस्थे निषसाद विचेतनः।\nतं विचेतनमालोक्य दुर्मनास्तस्य सारथिः॥ १०/५१/६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.067.m4a", "display_order": 68}, {"id": 6000247068, "chapter_id": 10247, "verse_number": "१०-५१-६५", "content_sanskrit": "अपोवाह रणात् तूर्णं रथेन भरतर्षभ।\nकूपकर्णस्तु दैतेयः प्रसक्तः कृतवर्मणा॥ १०/५१/६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.068.m4a", "display_order": 69}, {"id": 6000247069, "chapter_id": 10247, "verse_number": "१०-५१-६६", "content_sanskrit": "गतं कुम्भाण्डमालोक्य प्राप्तं च प्राणसंशयम्।\nविसृज्य कृतवर्माणमपायात् समराङ्गणात्॥ १०/५१/६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.069.m4a", "display_order": 70}, {"id": 6000247070, "chapter_id": 10247, "verse_number": "१०-५१-६७", "content_sanskrit": "तौ विसृज्य रणं दैत्यावनापृच्छ्य च भूपतिम्। अविसृष्टौ मागधेन हतशेषबलान्वितौ।\nदैत्यौ तेनैव मार्गेण जग्मतुः शोणितं पुरम्॥ १०/५१/६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_051/BhP_10.051.070.m4a", "display_order": 71, "topics": [{"text": "प्राणसंशयं प्राप्तयोः कुम्भाण्डकूपकर्णयोः जरासन्धमनापृच्छ्यैव पलायनम्", "range": "६७"}]}, {"id": 6000247071, "chapter_id": 10247, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्ध एकपञ्चाशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]