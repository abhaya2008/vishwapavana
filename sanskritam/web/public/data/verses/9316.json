[{"id": 5000316000, "chapter_id": 9316, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे चतुश्चत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000316001, "chapter_id": 9316, "verse_number": "४-४४-१", "content_sanskrit": "विशेषेण तु सुग्रीवो हनूमत्यर्थमुक्तवान्।\nस हि तस्मिन् हरिश्रेष्ठे निश्चितार्थोऽर्थसाधने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000316002, "chapter_id": 9316, "verse_number": "४-४४-२", "content_sanskrit": "अब्रवीच्च हनूमन्तं विक्रान्तमनिलात्मजम्।\nसुग्रीवः परमप्रीतः प्रभुः सर्ववनौकसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000316003, "chapter_id": 9316, "verse_number": "४-४४-३", "content_sanskrit": "न भूमौ नान्तरिक्षे वा नाम्बरे नामरालये।\nनाप्सु वा गतिसङ्गं ते पश्यामि हरिपुंगव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000316004, "chapter_id": 9316, "verse_number": "४-४४-४", "content_sanskrit": "सासुराः सहगन्धर्वाः सनागनरदेवताः।\nविदिताः सर्वलोकास्ते ससागरधराधराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000316005, "chapter_id": 9316, "verse_number": "४-४४-५", "content_sanskrit": "गतिर्वेगश्च तेजश्च लाघवं च महाकपे।\nपितुस्ते सदृशं वीर मारुतस्य महौजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000316006, "chapter_id": 9316, "verse_number": "४-४४-६", "content_sanskrit": "तेजसा वापि ते भूतं न समं भुवि विद्यते।\nतद् यथा लभ्यते सीता तत्त्वमेवानुचिन्तय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000316007, "chapter_id": 9316, "verse_number": "४-४४-७", "content_sanskrit": "त्वय्येव हनुमन्नस्ति बलं बुद्धिः पराक्रमः।\nदेशकालानुवृत्तिश्च नयश्च नयपण्डित ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000316008, "chapter_id": 9316, "verse_number": "४-४४-८", "content_sanskrit": "ततः कार्यसमासङ्गमवगम्य हनूमति।\nविदित्वा हनुमन्तं च चिन्तयामास राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000316009, "chapter_id": 9316, "verse_number": "४-४४-९", "content_sanskrit": "सर्वथा निश्चितार्थोऽयं हनूमति हरीश्वरः।\nनिश्चितार्थतरश्चापि हनूमान् कार्यसाधने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000316010, "chapter_id": 9316, "verse_number": "४-४४-१०", "content_sanskrit": "तदेवं प्रस्थितस्यास्य परिज्ञातस्य कर्मभिः।\nभर्त्रा परिगृहीतस्य ध्रुवः कार्यफलोदयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000316011, "chapter_id": 9316, "verse_number": "४-४४-११", "content_sanskrit": "तं समीक्ष्य महातेजा व्यवसायोत्तरं हरिम्।\nकृतार्थ इव संहृष्टः प्रहृष्टेन्द्रियमानसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000316012, "chapter_id": 9316, "verse_number": "४-४४-१२", "content_sanskrit": "ददौ तस्य ततः प्रीतः स्वनामाङ्कोपशोभितम्।\nअङ्गुलीयमभिज्ञानं राजपुत्र्याः परंतपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000316013, "chapter_id": 9316, "verse_number": "४-४४-१३", "content_sanskrit": "अनेन त्वां हरिश्रेष्ठ चिह्नेन जनकात्मजा।\nमत्सकाशादनुप्राप्तमनुद्विग्नानुपश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000316014, "chapter_id": 9316, "verse_number": "४-४४-१४", "content_sanskrit": "व्यवसायश्च ते वीर सत्त्वयुक्तश्च विक्रमः।\nसुग्रीवस्य च संदेशः सिद्धिं कथयतीव मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000316015, "chapter_id": 9316, "verse_number": "४-४४-१५", "content_sanskrit": "स तद् गृह्य हरिश्रेष्ठः कृत्वा मूर्ध्नि कृताञ्जलिः।\nवन्दित्वा चरणौ चैव प्रस्थितः प्लवगर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000316016, "chapter_id": 9316, "verse_number": "४-४४-१६", "content_sanskrit": "स तत् प्रकर्षन् हरिणां महद् बलं\nबभूव वीरः पवनात्मजः कपिः।\nगताम्बुदे व्योम्नि विशुद्धमण्डलः\nशशीव नक्षत्रगणोपशोभितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000316017, "chapter_id": 9316, "verse_number": "४-४४-१७", "content_sanskrit": "अतिबल बलमाश्रितस्तवाहं\nहरिवर विक्रम विक्रमैरनल्पैः।\nपवनसुत यथाधिगम्यते सा\nजनकसुता हनुमंस्तथा कुरुष्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000316018, "chapter_id": 9316, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे चतुश्चत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]