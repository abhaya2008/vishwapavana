[{"id": 40019544, "chapter_id": 9316, "verse_number": "1", "content_sanskrit": "अयोध्यांतुसमालोक्यचिन्तयामासराघवः । प्रियकामःप्रियंरामस्ततस्त्वरितविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40019545, "chapter_id": 9316, "verse_number": "2", "content_sanskrit": "चिन्तयित्वाततोदृष्टिंवानरेषुन्यपातयत् । उवाचधीमांस्तेजस्वीहनूमन्तंप्लवङ्गमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40019546, "chapter_id": 9316, "verse_number": "3", "content_sanskrit": "अयोध्यांत्वरितोगत्वाशीघ्रंप्लवगसत्तम । जानीहिकछचित्कुशलीजनोनृपतिमन्दिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40019547, "chapter_id": 9316, "verse_number": "4", "content_sanskrit": "शृङ्गबेरिपुरंप्राप्यगुहंगहनगोचरम् । निषादाधिपतिंब्रूहिकुशलंवचनान्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40019548, "chapter_id": 9316, "verse_number": "5", "content_sanskrit": "श्रुत्वातुमांकुशलिनमरोगंविगतज्वरम् । भविष्यतिगुहःप्रीतस्सममात्मसमस्सखा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40019549, "chapter_id": 9316, "verse_number": "6", "content_sanskrit": "अयोध्यायाश्चतेमार्गंप्रवृत्तिंभरतस्य च । निवेदयिष्यतिप्रीतोनिषादाधिपतिर्गुहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40019550, "chapter_id": 9316, "verse_number": "7", "content_sanskrit": "भरतस्तुत्वयावाच्यःकुशलंवचनान्मम । सिद्धार्थंशंसमांतस्मैसभार्यंसहलक्ष्मणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40019551, "chapter_id": 9316, "verse_number": "8", "content_sanskrit": "हरणंचापिवैदेह्यारावणेनबलीयसा । सुग्रीवेण च सम्वादंवालिनश्चवधंरणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40019552, "chapter_id": 9316, "verse_number": "9", "content_sanskrit": "मैथिल्यन्वेषणंचैवयथाचाधिगतात्वया । लङ्घयित्वामहातोयमापगापतिमव्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40019553, "chapter_id": 9316, "verse_number": "10", "content_sanskrit": "उपयानंसमुद्रस्यसागरस्य च दर्शनम् । यथा च कारितस्सेतूरावणश्चयथाहतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40019554, "chapter_id": 9316, "verse_number": "11", "content_sanskrit": "वरदानंमहेन्द्रेणब्रह्मणावरुणेन च । महादेवप्रसादाच्छपित्राममसमागमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40019555, "chapter_id": 9316, "verse_number": "12", "content_sanskrit": "उपयातं च मांसौम्य भरतायनिवेदय । सहराक्षसराजेनहरीणामीश्वरेण च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40019556, "chapter_id": 9316, "verse_number": "13", "content_sanskrit": "जित्वाशत्रुगणान्रामःप्राप्यचानुत्तमंयशः । उपायानंसमृद्धार्थस्सहमित्रैर्महाबलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40019557, "chapter_id": 9316, "verse_number": "14", "content_sanskrit": "एतच्छ्रुत्वायमाकारंभजतेभरतस्ततः । स च तेवेदितव्यःस्यात्सर्वंयच्छापिमांप्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40019558, "chapter_id": 9316, "verse_number": "15", "content_sanskrit": "ज्ञेयाःसर्वे च वृत्तान्ताःभरतस्येङ्गितानि च । तत्त्वेनमुखवर्णेनदृष्ट्याव्याभाषितेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40019559, "chapter_id": 9316, "verse_number": "16", "content_sanskrit": "सर्वकालसमृद्धंहिहस्त्यश्वरथसङ्कुलम् । पितृपैतामहंराज्यंकस्यनावर्तयेन्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40019560, "chapter_id": 9316, "verse_number": "17", "content_sanskrit": "सङ्गत्याभरत्श्रीमान् राज्येनार्थीस्वयंभवेत् । प्रशास्तुवसुधांसर्वामखिलांरघुनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40019561, "chapter_id": 9316, "verse_number": "18", "content_sanskrit": "तस्यबुद्धिं च विज्ञायव्यवसायं च वानर । यावन्नदूरंयाताःस्मक्षिप्रमागन्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40019562, "chapter_id": 9316, "verse_number": "19", "content_sanskrit": "इतिप्रतिसमादिष्टोहनूमान्मारुतात्मजः । मानुषःधारयनृपमयोध्यांत्वरितोययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40019563, "chapter_id": 9316, "verse_number": "20", "content_sanskrit": "अतोत्पपातवेगेनहनूमान्मारुतात्मजः । गरुत्मानिववेगेनजिघृक्षन्पन्नगोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40019564, "chapter_id": 9316, "verse_number": "21", "content_sanskrit": "लङ्घयित्वापितृपथंविहगेन्द्रालयंशुभम् । गङ्गायमुनयोर्भीमंसमतीत्यसमागमम् ॥ शृङ्गबेरपुरंप्राप्यगुहमासाद्यवीर्यवान् । स वाचाशुभयाहृष्टोहनुमानिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40019565, "chapter_id": 9316, "verse_number": "22", "content_sanskrit": "लङ्घयित्वापितृपथंविहगेन्द्रालयंशुभम् । गङ्गायमुनयोर्भीमंसमतीत्यसमागमम् ॥ शृङ्गबेरपुरंप्राप्यगुहमासाद्यवीर्यवान् । स वाचाशुभयाहृष्टोहनुमानिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40019566, "chapter_id": 9316, "verse_number": "23", "content_sanskrit": "सखातुतवकाकुत्स्थोरामस्सत्यपराक्रमः । ससीतस्सहसौमित्रिस्सत्वांकुशलमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40019567, "chapter_id": 9316, "verse_number": "24", "content_sanskrit": "पञ्चमीमद्यरजनीमुषित्वावचनान्मुनेः । भरद्वाजाभ्यनुज्ञातंद्रक्ष्यस्यद्यैवराघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40019568, "chapter_id": 9316, "verse_number": "25", "content_sanskrit": "एवमुक्त्वामहातेजास्सम्प्रहृष्टतनूरुहः । उत्पपातमहावेगाद्वेगवान्विचारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40019569, "chapter_id": 9316, "verse_number": "26", "content_sanskrit": "सोऽपश्यद्रामतीर्थं च नदींवालुकिनींतथा । वरूथींगोमतींचैवभीमंशालवनंतथा ॥ प्रजाश्चबहुसाहस्रीःस्फीतान्जनपदानपि ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40019570, "chapter_id": 9316, "verse_number": "27", "content_sanskrit": "सःगत्वादूरमध्वानंत्वरितःकपिकुञ्जरः ॥ आससादद्रुमान् फुल्लान्नन्दिग्रामसमीपगान् । स्त्रीभिस्सपुत्रैर्वृद्धैश्चरममाणैःस्वलङ्कृतैः । सुराधिपस्योपवनेयथाचैत्ररथेद्रुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40019571, "chapter_id": 9316, "verse_number": "28", "content_sanskrit": "सःगत्वादूरमध्वानंत्वरितःकपिकुञ्जरः ॥ आससादद्रुमान् फुल्लान्नन्दिग्रामसमीपगान् । स्त्रीभिस्सपुत्रैर्वृद्धैश्चरममाणैःस्वलङ्कृतैः । सुराधिपस्योपवनेयथाचैत्ररथेद्रुमान् ॥", "padaccheda": ""