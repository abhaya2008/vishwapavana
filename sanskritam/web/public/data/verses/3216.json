[{"id": 2102429, "chapter_id": 3216, "verse_number": "१४-७२-१", "content_sanskrit": "वैशम्पायन उवाच।\nएवमुक्तस्तु कृष्णेन धर्मपुत्रो युधिष्ठिरः।\nव्यासमामन्त्र्य् मेधावी ततो वाचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2102430, "chapter_id": 3216, "verse_number": "१४-७२-२", "content_sanskrit": "यदा कालं भवान्वेत्ति हयमेधस्य तत्त्वतः।\nदीक्षयस्व तदा मां त्वं त्वय्यायत्तो हि मे क्रुतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2102431, "chapter_id": 3216, "verse_number": "१४-७२-३x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2102432, "chapter_id": 3216, "verse_number": "१४-७२-३", "content_sanskrit": "अयं पैलोथ कौन्तेय याज्ञवल्क्यस्तथैव च।\nविधानं यद्यथा कालं तत्कर्तारौ न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2102433, "chapter_id": 3216, "verse_number": "१४-७२-४", "content_sanskrit": "चैत्र्यां हि पौर्णमास्यां तु तव दीक्षा भविष्यति।\nसम्भाराः सम्भ्रियन्तां च यज्ञार्थं पुरुषर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2102434, "chapter_id": 3216, "verse_number": "१४-७२-५", "content_sanskrit": "अश्वविद्याविदश्चैव सूता विप्राश्च तद्विदः।\nमेध्यमश्वं परीक्षन्तां तव यज्ञार्थसिद्धये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2102435, "chapter_id": 3216, "verse_number": "१४-७२-६", "content_sanskrit": "तमुत्सृज यथाशास्त्रं पृथिवीं सागराम्बराम्।\nसपर्येतु यशो नाम्ना तव पार्थिव वर्धयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2102436, "chapter_id": 3216, "verse_number": "१४-७२-७", "content_sanskrit": "इत्युक्तः स तथेत्युक्त्वा पाण्डवः पृथिवीपतिः।\nचकार सर्वं राजेन्द्र यथोक्तं ब्रह्मवादिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2102437, "chapter_id": 3216, "verse_number": "१४-७२-८", "content_sanskrit": "सम्भारश्चैव राजेन्द्र सर्वे सङ्कल्पितास्तता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2102438, "chapter_id": 3216, "verse_number": "१४-७२-९", "content_sanskrit": "स सम्भारान्समाहृत्य नृपो धर्मसुतस्तदा।\nन्यवेदयदमेयात्मा कृष्णद्वैपायनाय वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2102439, "chapter_id": 3216, "verse_number": "१४-७२-१०", "content_sanskrit": "ततोऽब्रवीन्महातेजा व्यासो धर्मात्मजं नृपम्।\nयथाकालं यथायोगं सज्जाः स्म तव दीक्षणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2102440, "chapter_id": 3216, "verse_number": "१४-७२-११", "content_sanskrit": "स्फ्यश्च कूर्चश्च सौवर्णो यच्चान्यदपि कौरव।\nयत्तु योग्यं भवेत्किञ्चिद्रौक्मं तत्क्रियतामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2102441, "chapter_id": 3216, "verse_number": "१४-७२-१२", "content_sanskrit": "अश्वश्चोत्सृज्यतामद्य पृथ्व्यामथ यथाक्रमम्।\nसुगुप्तं चरतां चापि यथाशास्त्रं यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2102442, "chapter_id": 3216, "verse_number": "१४-७२-१३x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2102443, "chapter_id": 3216, "verse_number": "१४-७२-१३", "content_sanskrit": "अयमश्वो यता ब्रह्मन्नुत्सृष्टः पृथिवीमिमाम्।\nचरिष्यति यथाकामं तत्र वै संविदीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2102444, "chapter_id": 3216, "verse_number": "१४-७२-१४", "content_sanskrit": "पृथिवीं पर्यटन्तं हि तुरगं कामचारिणम्।\nकः पालयेदिति मुने तद्भवान्वक्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2102445, "chapter_id": 3216, "verse_number": "१४-७२-१५", "content_sanskrit": "इत्युक्तः स तु राजेन्द्र कृष्णद्वैपायनोऽब्रवीत्।\nभीमसेनादवरजः श्रेष्ठः सर्वधनुष्मताम्।\nजिष्णुः सहिष्णुर्धृष्णुस्च स एनं पालयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2102446, "chapter_id": 3216, "verse_number": "१४-७२-१६", "content_sanskrit": "शक्तः स हि महीं जेतुं निवातकवचान्तकः।\nतस्मिन्ह्यस्त्राणि दिव्यानि दिव्यं संहननं तथा।\nदिव्यं धनश्चेषुधी च स एनमनुयास्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2102447, "chapter_id": 3216, "verse_number": "१४-७२-१७", "content_sanskrit": "स हि धर्मार्थकुशलः सर्वविद्याविशारदः।\nयथाशास्त्रं नृपश्रेष्ठ चारयिष्यति ते हयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2102448, "chapter_id": 3216, "verse_number": "१४-७२-१८", "content_sanskrit": "राजपुत्रो महाबाहुः श्यामो राजीवलोचनः।\nअभिमन्योः पिता वीरः स एनमनुयास्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2102449, "chapter_id": 3216, "verse_number": "१४-७२-१९", "content_sanskrit": "भीमसेनोपि तेजस्वी कौन्तेयोऽमितविक्रमः।\nसमर्थो रक्षितुं राष्ट्रं नकुलश्च विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2102450, "chapter_id": 3216, "verse_number": "१४-७२-२०", "content_sanskrit": "सहदेवस्तु कौरव्य समायास्यति बुद्धिमान्।\nकुटुम्बतन्त्रं विधिवत्सर्वमेव महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2102451, "chapter_id": 3216, "verse_number": "१४-७२-२१", "content_sanskrit": "स तु सर्वं यथान्यायमुक्त कुरुकुलोद्वहः।\nचकार फल्गुनं चापि संदिदेश हयं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2102452, "chapter_id": 3216, "verse_number": "१४-७२-२२x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2102453, "chapter_id": 3216, "verse_number": "१४-७२-२२", "content_sanskrit": "एह्यर्जुन त्वया वीर हयोऽयं परिपाल्यताम्।\nत्वमर्हो रक्षितुं ह्येनं नान्यः कश्चन मानवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2102454, "chapter_id": 3216, "verse_number": "१४-७२-२३", "content_sanskrit": "ये चापि त्वां महाबाहो प्रत्युद्यान्ति नराधिपाः।\nतैर्विग्रहो यथा न स्यात्तथा कार्यं त्वयाऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2102455, "chapter_id": 3216, "verse_number": "१४-७२-२४", "content_sanskrit": "आख्यातव्यश्च भता यज्ञोऽयं मम सर्वशः।\nपार्थिवेभ्यो महाबाहो समये गम्यतामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2102456, "chapter_id": 3216, "verse_number": "१४-७२-२५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2102457, "chapter_id": 3216, "verse_number": "१४-७२-२५", "content_sanskrit": "एवमुक्त्वा स धर्मात्मा भ्रातरं सव्यसाचिनम्।\nभीमं च नकुलं चैव पुरगुप्तौ समादधत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2102458, "chapter_id": 3216, "verse_number": "१४-७२-२६", "content_sanskrit": "कुटुम्बतन्त्रे च तदा सहदेवं युधांपतिम्।\nअनुमान्य महीपालं धृतराष्ट्रं युधिष्ठिरः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2102459, "chapter_id": 3216, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि द्विसप्ततितमोऽध्यायः॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]