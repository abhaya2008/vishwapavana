[{"id": 5000624000, "chapter_id": 9624, "verse_number": "७-८९-१", "content_sanskrit": "श्रुत्वा किम्पुरुषोत्पत्तिं लक्ष्मणो भरतस्तदा ।\nआश्चर्यमिति चाब्रूतामुभौ रामं जनेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000624001, "chapter_id": 9624, "verse_number": "७-८९-२", "content_sanskrit": "अथ रामः कथामेतां भूय एव महायशाः ।\nकथयामास धर्मात्मा प्रजापतिसुतस्य वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000624002, "chapter_id": 9624, "verse_number": "७-८९-३", "content_sanskrit": "सर्वास्ता विद्रुता दृष्ट्वा किन्नरीर्ऋषिसत्तमः ।\nउवाच रूपसम्पन्नां तां स्त्रियं प्रहसन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000624003, "chapter_id": 9624, "verse_number": "७-८९-४", "content_sanskrit": "सोमस्याहं सुदयितः सुतः सुरुचिरानने ।\nभजस्व मां वरारोहे भक्त्या स्निग्धेन चक्षुषा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000624004, "chapter_id": 9624, "verse_number": "७-८९-५", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा शून्ये स्वजनवर्जिते ।\nइला सुरुचिरप्रख्यं प्रत्युवाच महाग्रहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000624005, "chapter_id": 9624, "verse_number": "७-८९-६", "content_sanskrit": "अहं कामचरी सौम्य तवास्मि वशवर्तिनी ।\nप्रशाधि मां सोमसुत यथेच्छसि तथा कुरु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000624006, "chapter_id": 9624, "verse_number": "७-८९-७", "content_sanskrit": "तस्यास्तदद्भुतप्रख्यं श्रुत्वा हर्षमुपागतः ।\nस वै कामी सह तया रेमे चन्द्रमसः सुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000624007, "chapter_id": 9624, "verse_number": "७-८९-८", "content_sanskrit": "बुधस्य माधवो मासस्तामिलां रुचिराननाम् ।\nगतो रमयतो ऽत्यर्थं क्षणवत्तस्य कामिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000624008, "chapter_id": 9624, "verse_number": "७-८९-९", "content_sanskrit": "अथ मासे तु सम्पूर्णे पूर्णेन्दुसदृशाननः ।\nप्रजापतिसुतः श्रीमाञ्छयने प्रत्यबुध्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000624009, "chapter_id": 9624, "verse_number": "७-८९-१०", "content_sanskrit": "सो ऽपश्यत्सोमजं तत्र तपन्तं सलिलाशये ।\nऊर्ध्वबाहुं निरालम्बं तं राजा प्रत्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000624010, "chapter_id": 9624, "verse_number": "७-८९-११", "content_sanskrit": "भगवन्पर्वतं दुर्गं प्रविष्टो ऽस्मि सहानुगः ।\nन च पश्यामि तत्सैन्यं क्व नु ते मामका गताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000624011, "chapter_id": 9624, "verse_number": "७-८९-१२", "content_sanskrit": "तच्छ्रुत्वा तस्य राजर्षेर्नष्टसञ्ज्ञस्य भाषितम् ।\nप्रत्युवाच शुभं वाक्यं सान्त्वयन्परया गिरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000624012, "chapter_id": 9624, "verse_number": "७-८९-१३", "content_sanskrit": "अश्मवर्षेण महता भृत्यास्ते विनिपातिताः ।\nत्वं चाश्रमपदे सुप्तो वातवर्षभयार्दितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000624013, "chapter_id": 9624, "verse_number": "७-८९-१४", "content_sanskrit": "समाश्वसिहि भद्रं ते निर्भयो विगतज्वरः ।\nफलमूलाशनो वीर निवसेह यथासुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000624014, "chapter_id": 9624, "verse_number": "७-८९-१५", "content_sanskrit": "स राजा तेन वाक्येन प्रत्याश्वस्तो महामतिः ।\nप्रत्युवाच ततो वाक्यं दीनो भृत्यक्षयाद् भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000624015, "chapter_id": 9624, "verse_number": "७-८९-१६", "content_sanskrit": "त्यक्ष्याम्यहं स्वकं राज्यं नाहं भृत्यैर्विनाकृतः ।\nवर्तयेयं क्षणं ब्रह्मन्समनुज्ञातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000624016, "chapter_id": 9624, "verse_number": "७-८९-१७", "content_sanskrit": "सुतो धर्मपरो ब्रह्मञ्ज्येष्ठो मम महायशाः ।\nशशबिन्दुरिति ख्यातः स मे राज्यं प्रपत्स्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000624017, "chapter_id": 9624, "verse_number": "७-८९-१८", "content_sanskrit": "न हि शक्ष्याम्यहं हित्वा भृत्यदारान्सुखान्वितान् ।\nप्रतिवक्तुं महातेजः किञ्चिदप्यशुभं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000624018, "chapter_id": 9624, "verse_number": "७-८९-१९", "content_sanskrit": "तथा ब्रुवति राजेन्द्रे बुधः परममद्भुतम् ।\nसान्त्वपूर्वमथोवाच वासस्त इह रोचताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000624019, "chapter_id": 9624, "verse_number": "७-८९-२०", "content_sanskrit": "न सन्तापस्त्वया कार्यः कार्दमेय महाबल ।\nसंवत्सरोषितस्येह कारयिष्यामि ते हितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000624020, "chapter_id": 9624, "verse_number": "७-८९-२१", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा बुधस्याक्लिष्टकर्मणः ।\nवासाय विदधे बुद्धिं यदुक्तं ब्रह्मवादिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000624021, "chapter_id": 9624, "verse_number": "७-८९-२२", "content_sanskrit": "मासं स स्त्री तदा भूत्वा रमयत्यनिशं शुदा ।\nमासं पुरुषभावेन धर्मबुद्धिं चकार सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000624022, "chapter_id": 9624, "verse_number": "७-८९-२३", "content_sanskrit": "ततः सा नवमे मासि इला सोमसुतात्सुतम् ।\nजनयामास सुश्रोणी पुरूरवसमूर्जितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000624023, "chapter_id": 9624, "verse_number": "७-८९-२४", "content_sanskrit": "जातमात्रं तु सुश्रोणी पितुर्हस्ते न्यवेशयत् ।\nबुधस्य समवर्णभमिला पुत्रं महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000624024, "chapter_id": 9624, "verse_number": "७-८९-२५", "content_sanskrit": "बुधस्तु पुरुषीभूतं स वै संवत्सरान्तरम् ।\nकथाभी रमयामास धर्मयुक्ताभिरात्मवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000624025, "chapter_id": 9624, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे एकोननवतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]