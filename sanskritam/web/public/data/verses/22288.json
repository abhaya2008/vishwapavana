[{"id": 7002288000, "chapter_id": 22288, "verse_number": "३३३-१", "content_sanskrit": "अग्निरुवाच ।\nउपचित्रकं ससमनामथभोजभगामय ।\nद्रूतमध्या ततभगागथोननजयाः स्मृताः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002288001, "chapter_id": 22288, "verse_number": "३३३-२", "content_sanskrit": "वेगवती ससमगा भभभगोगथो स्मृता ।\nरुद्रविस्तारस्तोसभगासमजागोगथा स्मृता ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002288002, "chapter_id": 22288, "verse_number": "३३३-३", "content_sanskrit": "रजसागोगथोद्रोणौ गोगौ वै केतुमत्यपि ।\nआख्यानिकी ततजगागथोततजगागथ ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002288003, "chapter_id": 22288, "verse_number": "३३३-४", "content_sanskrit": "विपरीताख्यानिकी त्तौ जयगातौ जगोगथ ।\nसौमलौ गथलभभावौ भवेद्धरिणवल्लभा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002288004, "chapter_id": 22288, "verse_number": "३३३-५", "content_sanskrit": "लौवनौगाथनजजा यः स्यादपरक्रमं ।\nपुष्पिता ननवयानजजावोगथो रजौ ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002288005, "chapter_id": 22288, "verse_number": "३३३-६", "content_sanskrit": "वोजथो जवजवागौ मूले पनमती शिखा ।\nअष्टाविंशतिनागाभा त्रिशन्नागन्ततो युजि ।\nखञ्जा तद्विपरीता स्यात् समवृत्तं प्रदर्श्यते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]