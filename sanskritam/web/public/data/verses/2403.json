[{"id": 2066464, "chapter_id": 2403, "verse_number": "९-२१-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2066465, "chapter_id": 2403, "verse_number": "९-२१-१", "content_sanskrit": "पुत्रस्तु ते महाराज रथस्थो रथिनां वरः।\nदुरुत्सहो बभौ युद्धे यथा रुद्रः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2066466, "chapter_id": 2403, "verse_number": "९-२१-२", "content_sanskrit": "तस्य बाणसहस्रैस्तु प्रच्छन्ना ह्यभवन्मही।\nपरांश्च सिषिचे बाणैर्धाराभिरिव पर्वतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2066467, "chapter_id": 2403, "verse_number": "९-२१-३", "content_sanskrit": "न च सोऽस्ति पुमान्कश्चित्पाण्डवानां बलार्णवे।\nहयो गजो रथो वाऽपि यः स्याद्बाणैरविक्षतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2066468, "chapter_id": 2403, "verse_number": "९-२१-४", "content_sanskrit": "यं यं हि समरे योधं प्रपश्यामि विशाम्पते।\nस स बाणैश्चितोऽभूद्वै पुत्रेण तव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2066469, "chapter_id": 2403, "verse_number": "९-२१-५", "content_sanskrit": "यथा सैन्येन रजसा समुद्भूतेन वाहिनी।\nप्रत्यदृश्यत सञ्छन्ना तथा बाणैर्महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2066470, "chapter_id": 2403, "verse_number": "९-२१-६", "content_sanskrit": "बाणभूतामपश्याम पृथिवीं पृथिवीपते।\nदुर्योधनेन प्रकृतां क्षिप्रहस्तेन धन्विना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2066471, "chapter_id": 2403, "verse_number": "९-२१-७", "content_sanskrit": "तेषु योधसहस्रेषु तावकेषु परेषु च।\nनास्ति दुर्योधनसमः पुमानिति मतिर्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2066472, "chapter_id": 2403, "verse_number": "९-२१-८", "content_sanskrit": "तत्राद्भुतमपश्याम तव पुत्रस्य विक्रमम्।\nयदेकं सहिताः पार्था नाभ्यवर्तन्त भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2066473, "chapter_id": 2403, "verse_number": "९-२१-९", "content_sanskrit": "युधिष्ठिरं शतेनाजौ विव्याध भरतर्षभ।\nभीमसेनं च सप्तत्या सहदेवं च पञ्चभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2066474, "chapter_id": 2403, "verse_number": "९-२१-१०", "content_sanskrit": "नकुलं च चतुःषष्ट्या धृष्टद्युम्नं च पञ्चभिः।\nपञ्चभिर्द्रौपदेयांश्च त्रिभिर्विव्याध सात्यकिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2066475, "chapter_id": 2403, "verse_number": "९-२१-११", "content_sanskrit": "धनुश्चिच्छेद भल्लेन सहदेवस्य मारिष।\nतदपास्य धनुश्छिन्नं माद्रीपुत्रः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2066476, "chapter_id": 2403, "verse_number": "९-२१-१२", "content_sanskrit": "अभ्यद्रवत राजानं प्रगृह्यान्यन्महद्धनुः।\nततो दुर्योधनं सङ्ख्ये विव्याध दशभिः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2066477, "chapter_id": 2403, "verse_number": "९-२१-१३", "content_sanskrit": "नकुलस्तु ततो वीरो राजानं नवभिः शरैः।\nघोररूपैर्महेष्वासो विव्याध च ननाद च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2066478, "chapter_id": 2403, "verse_number": "९-२१-१४", "content_sanskrit": "सात्यकिश्चैव राजानं शरेणानतपर्वणा।\nद्रौपदेयास्त्रिसप्तत्या धर्मराजश्च पञ्चभिः।\nअशीत्या भीमसेनश्च शरै राजानमार्पयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2066479, "chapter_id": 2403, "verse_number": "९-२१-१५", "content_sanskrit": "समन्तात्कीर्यमाणस्तु बाणसङ्घैर्महात्मभिः।\nन चचाल महाराज सर्वसैन्यस्य पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2066480, "chapter_id": 2403, "verse_number": "९-२१-१६", "content_sanskrit": "लाघवात्सौष्ठवाच्चापि वीर्याच्चापि महात्मनः।\nअति सर्वाणि भूतानि ददृशुः सर्वपार्थिवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2066481, "chapter_id": 2403, "verse_number": "९-२१-१७", "content_sanskrit": "धार्तराष्ट्रा हि राजेन्द्र योधास्तु स्वल्पमन्तरम्।\nअपश्यमाना राजानं पर्यवर्तन्त दंशिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2066482, "chapter_id": 2403, "verse_number": "९-२१-१८", "content_sanskrit": "तेषामापततां घोरस्तुमुलः समपद्यत।\nक्षुब्धस्य हि समुद्रस्य प्रावृट्काले यथा स्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2066483, "chapter_id": 2403, "verse_number": "९-२१-१९", "content_sanskrit": "समासाद्य रणे ते तु राजानमपराजितम्।\nप्रत्युद्ययुर्महेष्वासाः पाण्डवानाततायिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2066484, "chapter_id": 2403, "verse_number": "९-२१-२०", "content_sanskrit": "भीमसेनं रणे क्रुद्धो द्रोणपुत्रो न्यवारयत्।\nतयोर्बाणैर्महाराज प्रमुक्तैः सर्वतोदिशम्।\nनाज्ञायन्त रणे वीरा न दिशः प्रदिशस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2066485, "chapter_id": 2403, "verse_number": "९-२१-२१", "content_sanskrit": "तावुभौ क्रूरकर्माणावुभौ भारतदुःसहौ।\nघोररूपमयुध्येतां कृतप्रतिकृतैषिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2066486, "chapter_id": 2403, "verse_number": "९-२१-२२", "content_sanskrit": "त्रासयन्तौ दिशः सर्वा ज्याक्षेपकठिनत्वचौ।\nशकुनिस्तु रणे वीरो युधिष्ठिरमपीडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2066487, "chapter_id": 2403, "verse_number": "९-२१-२३", "content_sanskrit": "तस्याश्वांश्चतुरो हत्वा सुबलस्य सुतो विभो।\nनादं चकार बलवत्सर्वसैन्यानि कम्पयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2066488, "chapter_id": 2403, "verse_number": "९-२१-२४", "content_sanskrit": "एतस्मिन्नन्तरे वीरं राजानमपराजितम्।\nअपोवाह रथेनाजौ सहदेवः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2066489, "chapter_id": 2403, "verse_number": "९-२१-२५", "content_sanskrit": "अथान्यं रथमास्थाय धर्मपुत्रो युधिष्ठिरः।\nशकुनिं नवभिर्विद्ध्वा पुनर्विव्याध पञ्चभिः।\nननाद च महानादं प्रवरः सर्वधन्विनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2066490, "chapter_id": 2403, "verse_number": "९-२१-२६", "content_sanskrit": "तद्युद्धमभवच्चित्रं घोररूपं च मारिष।\nप्रेक्षतां प्रीतिजननं सिद्धचारणसेवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2066491, "chapter_id": 2403, "verse_number": "९-२१-२७", "content_sanskrit": "उलूकस्तु महेष्वासं नकुलं युद्धदुर्मदम्।\nअभ्यवर्षदमेयात्मा शरवर्षैः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2066492, "chapter_id": 2403, "verse_number": "९-२१-२८", "content_sanskrit": "तथैव नकुलः शूरः सौबलस्य सुतं रणे।\nशरवर्षेण महता समन्तात्पर्यवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2066493, "chapter_id": 2403, "verse_number": "९-२१-२९", "content_sanskrit": "तौ तत्र समरे वीरौ कुलपुत्रौ महारथौ।\nयोधयन्तावपश्येतां कृतप्रतिकृतैषिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2066494, "chapter_id": 2403, "verse_number": "९-२१-३०", "content_sanskrit": "तथैव कृतवर्माणं शैनेयः शत्रुतापनः।\nयोधयञ्शुशुभे राजन्बलिं शक्र इवाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2066495, "chapter_id": 2403, "verse_number": "९-२१-३१", "content_sanskrit": "दुर्योधनो धनुश्छित्त्वा धृष्टद्युम्नस्य संयुगे।\nअथैनं छिन्नधन्वानं विव्याध निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2066496, "chapter_id": 2403, "verse_number": "९-२१-३२", "content_sanskrit": "धृष्टद्युम्नोऽपि समरे प्रगृह्य परमायुधम्।\nराजानं योधयामास पश्यतां सर्वधन्विनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2066497, "chapter_id": 2403, "verse_number": "९-२१-३३", "content_sanskrit": "तयोर्युद्धं महच्चासीत्सङ्ग्रामे भरतर्षभ।\nप्रभिन्नयोर्यथा सक्तं मत्तयोर्वनहस्तिनोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2066498, "chapter_id": 2403, "verse_number": "९-२१-३४", "content_sanskrit": "गौतमस्तु रणे क्रुद्धो द्रौपदेयान्महाबालान्।\nविव्याध बहुभिः शूरः शरैः सन्नतपर्वभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2066499, "chapter_id": 2403, "verse_number": "९-२१-३५", "content_sanskrit": "तस्य तैरभवद्युद्धमिन्द्रियैरिव देहिनः।\nघोररूपमसंवार्यं निर्मर्यादमवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2066500, "chapter_id": 2403, "verse_number": "९-२१-३६", "content_sanskrit": "ते च सम्पीडयामासुरिन्द्रियाणीव बालिशम्।\nस च तान्प्रतिसंरब्धः प्रत्ययोधयदाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2066501, "chapter_id": 2403, "verse_number": "९-२१-३७", "content_sanskrit": "एवं चित्रमभूद्युद्धं तस्य तैः सह भारत।\nउत्थायोत्थाय हि यथा देहिनामिन्द्रियैर्विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2066502, "chapter_id": 2403, "verse_number": "९-२१-३८", "content_sanskrit": "नराश्चैव नरैः सार्धं दन्तिनो दन्तिभिस्तथा।\nहया हयैः समासक्ता रथिनो रथिभिः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2066503, "chapter_id": 2403, "verse_number": "९-२१-३९", "content_sanskrit": "सङ्कुलं चाभवद्भूयो घोररूपं विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2066504, "chapter_id": 2403, "verse_number": "९-२१-४०", "content_sanskrit": "इदं चित्रमिदं घोरमिदं रौद्रमिति प्रभो।\nयुद्धान्यासन्महाराज घोरांणि च बहूनि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2066505, "chapter_id": 2403, "verse_number": "९-२१-४१", "content_sanskrit": "ते समासाद्य समरे परस्परमरिन्दमाः।\nव्यनदंश्चैव जघ्नुश्च समाताद्य महाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2066506, "chapter_id": 2403, "verse_number": "९-२१-४२", "content_sanskrit": "तेषां पत्रसमुद्भूतं रजस्तीव्रमदृश्यत।\nवातेन चोद्धतं राजन्धावद्भिश्चाश्वसादिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2066507, "chapter_id": 2403, "verse_number": "९-२१-४३", "content_sanskrit": "रथनेमिसमुद्भूतं निःश्वासैश्चापि दन्तिनाम्।\nरजः सन्ध्याभ्रकलिलं दिवाकरपथं ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2066508, "chapter_id": 2403, "verse_number": "९-२१-४४", "content_sanskrit": "रजसा तेन सम्पृक्तो भास्करो निष्प्रभः कृतः।\nसञ्छादिताऽभवद्भूमिस्ते च शूरा महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2066509, "chapter_id": 2403, "verse_number": "९-२१-४५", "content_sanskrit": "मुहूर्तादिव संवृत्तं नीरजस्कं समन्ततः।\nवीरशोणितसिक्तायां भूमौ भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2066510, "chapter_id": 2403, "verse_number": "९-२१-४६", "content_sanskrit": "उपाशाम्यत्ततस्तीव्रं तद्रजो घोरदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2066511, "chapter_id": 2403, "verse_number": "९-२१-४७", "content_sanskrit": "ततोऽपश्यमहं भूयो द्वन्द्वयुद्धानि भारत।\nयथाप्राणं यथाश्रेष्ठं मध्याह्ने वै सुदारुणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2066512, "chapter_id": 2403, "verse_number": "९-२१-४८", "content_sanskrit": "वर्मणां तत्र राजेन्द्र व्यदृश्यन्तोज्ज्वलाः प्रभाः।\nशब्दश्च तुमुलः सङ्ख्ये शराणां पततामभूत्\nमहावेणुवनस्येव दह्यमानस्य पर्वते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2066513, "chapter_id": 2403, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि शल्यवधपर्वणि अष्टादशदिवसयुद्धे एकविंशोऽध्यायः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]