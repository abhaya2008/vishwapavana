[{"id": 2020624, "chapter_id": 1432, "verse_number": "३-७०-०x", "content_sanskrit": "बृहदश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2020625, "chapter_id": 1432, "verse_number": "३-७०-१", "content_sanskrit": "स नदीः पर्वतांश्चैव वनानि च सरांसि च।\nअचिरेणातिचक्राम स्वेचरः खे चरन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2020626, "chapter_id": 1432, "verse_number": "३-७०-२", "content_sanskrit": "तथा प्रयाते तु रथे तदा भागस्वरिर्नृपः।\nउत्तरीयमधोपश्यद्धष्टं परपुरंजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2020627, "chapter_id": 1432, "verse_number": "३-७०-३", "content_sanskrit": "ततः स त्वरमाणस्तु पटे निपतिते तदा।\nग्रहीष्यामीति तं राजा नलमाह महामनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2020628, "chapter_id": 1432, "verse_number": "३-७०-४", "content_sanskrit": "निगृह्णीष्व महाबुद्धे हयानेतान्महाजवान्।\nवार्ष्णेयो यावदेनं मे पटमानयतामिह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2020629, "chapter_id": 1432, "verse_number": "३-७०-५", "content_sanskrit": "नलस्तं प्रत्युवाचाथ दूरे भ्रष्टः पटस्तव।\nयोजनं समतिक्रान्तो नाहर्तुं शक्यते पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2020630, "chapter_id": 1432, "verse_number": "३-७०-६", "content_sanskrit": "एवमुक्ते नलेनाथ नातिप्रीतमना नृपः।\nआससाद वने राजन्फलवन्तं बिभीतकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2020631, "chapter_id": 1432, "verse_number": "३-७०-७", "content_sanskrit": "तं दृष्ट्वा बाहुकं राजा त्वरमाणोऽभ्यभापत।\nममापि सूत पश्य त्वं संख्याने परमं बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2020632, "chapter_id": 1432, "verse_number": "३-७०-८", "content_sanskrit": "सर्वः सर्वं न जानाति सर्वज्ञो नास्ति कश्चन।\nनैकत्र परिनिष्ठाऽस्ति ज्ञानस्य पुरुषे क्वचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2020633, "chapter_id": 1432, "verse_number": "३-७०-९", "content_sanskrit": "वृक्षेऽस्मिन्यानि पर्णानि फलामेकं च बाहुक।\nपतितान्यपि यान्यत्रतत्रैकमधिकं कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2020634, "chapter_id": 1432, "verse_number": "३-७०-१०", "content_sanskrit": "एवपत्राधिकं चात्र फलमेकं च बाहुक।\nफलकोट्यपि पत्राणां द्वयोरपि च शाखयोः।\n`प्रवक्ष्यामि फलान्यत्र यानि संख्यास्यते भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2020635, "chapter_id": 1432, "verse_number": "३-७०-११", "content_sanskrit": "प्रचिनुह्यस्य शाखे द्वे याश्चाप्यन्याः प्रशाखिकाः।\nआभ्यां फलसहस्रे द्वे पञ्चोनं शतमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2020636, "chapter_id": 1432, "verse_number": "३-७०-१२", "content_sanskrit": "ततो रथादवप्लुत्य राजानं बाहुकोऽब्रवीत्।\nपरोक्षमिव मे राजन्कत्थसे शत्रुकर्शन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2020637, "chapter_id": 1432, "verse_number": "३-७०-१३", "content_sanskrit": "प्रत्यक्षमेतत्कर्ताऽस्मि शातयित्वा विभीतकम्।\nअथ ते गणिते राजन्द्विजामाम्यपरोक्षताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2020638, "chapter_id": 1432, "verse_number": "३-७०-१४", "content_sanskrit": "प्रत्यक्षं ते महाराज् गणयिष्ये विभीतकम्।\nअहं हि नाभिजानामि भवेदेव नवेति वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2020639, "chapter_id": 1432, "verse_number": "३-७०-१५", "content_sanskrit": "संख्यास्यामि फलान्यस्य पशय्तस्ते जनाधिप।\nमुहूर्तमपि वार्ष्णेयो रश्मीन्यच्छतु वाजिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2020640, "chapter_id": 1432, "verse_number": "३-७०-१६", "content_sanskrit": "तमब्रवीन्नृपः सूतं नायं कालो विलम्बितुम्।\nबाहुकस्त्वब्रवीदेनं परं यत्नं समास्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2020641, "chapter_id": 1432, "verse_number": "३-७०-१७", "content_sanskrit": "प्रतीक्षस्व मुहूर्तं त्वमथवा त्वरते भवान्।\nएष याति शिवः पन्था याहि वार्ष्णेयसारथिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2020642, "chapter_id": 1432, "verse_number": "३-७०-१८", "content_sanskrit": "अब्रवीदृतुपर्णस्तं सान्त्वयन्कुरुनन्दन।\nत्वभेव यन्ता नान्योस्ति पृथिव्यामपि बाहुक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2020643, "chapter_id": 1432, "verse_number": "३-७०-१९", "content_sanskrit": "त्वत्कृतेयातुमिच्छामि विदर्भान्हयकोविद।\nशरणं त्वांप्रपन्नोस्मि न विघ्नं कर्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2020644, "chapter_id": 1432, "verse_number": "३-७०-२०", "content_sanskrit": "कामं च ते करिष्यामि यन्मां वक्ष्यसि बाहुक।\nविदर्भान्यदि यात्वाऽद्य सूर्यं दर्शयितासि मे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2020645, "chapter_id": 1432, "verse_number": "३-७०-२१", "content_sanskrit": "अथाब्रवीद्बाहुकस्तं संख्यायच बिभीतकम्।\nततो विदर्भान्यास्यामि कुरुष्वैवं वचो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2020646, "chapter_id": 1432, "verse_number": "३-७०-२२", "content_sanskrit": "अकाम इव तं राजा गणयस्वेत्युवाच ह।\nएकदेशं च शाखायाः समादिष्टं मयाऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2020647, "chapter_id": 1432, "verse_number": "३-७०-२३", "content_sanskrit": "गणयस्वाश्वतत्वज्ञ ततस्त्वंप्रीतिमावह।\nसोऽवतीर्य रथात्तूर्णं शातयामास तं द्रुमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2020648, "chapter_id": 1432, "verse_number": "३-७०-२४", "content_sanskrit": "ततः स विस्मयाविष्टो राजानमिदमब्रवीत्।\nगणयित्वायथोक्तानि तावन्त्येव फलानि तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2020649, "chapter_id": 1432, "verse_number": "३-७०-२५", "content_sanskrit": "अत्युद्भुतमिदं राजन्दृष्टवानस्मि ते बलम्।\nश्रोतुमिच्छामि तां विद्यां ययैतज्ज्ञायते नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2020650, "chapter_id": 1432, "verse_number": "३-७०-२६", "content_sanskrit": "तमुवाच ततो राजा त्वरितो गमने नृप।\nविद्ध्यक्षहृदयज्ञं मां संख्याने च विशारदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2020651, "chapter_id": 1432, "verse_number": "३-७०-२७", "content_sanskrit": "बाहुकस्तमुवाचाथ देहि विद्याद्वयं च मे।\nमत्तोऽपि चाश्वहृदयं गृहाण पुरुपर्पभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2020652, "chapter_id": 1432, "verse_number": "३-७०-२८", "content_sanskrit": "ऋतुपर्णस्ततो राजा बाहुकं कार्यगौरवात्।\nहयज्ञानस्य लोभाच् तं तथेत्यब्रवीद्वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2020653, "chapter_id": 1432, "verse_number": "३-७०-२९", "content_sanskrit": "यथोक्तं त्वं गृहाणेदमक्षाणां हृदयं परम्।\nनिक्षेपो मेऽश्वहृदयं त्वयि तिष्ठतु बाहुक।\nएवमुक्त्वा ददौ विद्यामृतुपर्णो नलाय वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2020654, "chapter_id": 1432, "verse_number": "३-७०-३०", "content_sanskrit": "तस्याक्षहृदयज्ञस्य शरीरान्निःसृतः कलिः।\nकर्कोटकविषं तीक्ष्णं मुखात्सततमुद्वमन्।\nकलेस्तस्य तदार्तस्य शापाग्निः स विनिःसृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2020655, "chapter_id": 1432, "verse_number": "३-७०-३१", "content_sanskrit": "सातेन कर्शितो राजादीर्घकालमनात्मवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2020656, "chapter_id": 1432, "verse_number": "३-७०-३२", "content_sanskrit": "`तं भ्राम्तरूपं निःशोभं संक्लिष्टमकरोत्कलिः।\nततो विषविमुक्तात्मा स्वंरूपमकरोत्कलिः।\nतं शप्तुमैच्छत्कुपितो निषधाधिपतिर्नलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2020657, "chapter_id": 1432, "verse_number": "३-७०-३२", "content_sanskrit": "ततो विषविमुक्तात्मा स्वंरूपमकरोत्कलिः।\nतं शप्तुमैच्छत्कुपितो निषधाधिपतिर्नलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2020658, "chapter_id": 1432, "verse_number": "३-७०-३३", "content_sanskrit": "तमुवाच कलिर्भीतो वेपमानः कृताञ्जलिः।\nकोपं संयच्छ नृपते कीर्तिं दास्यामि ते पराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2020659, "chapter_id": 1432, "verse_number": "३-७०-३४", "content_sanskrit": "इन्द्रसेनस्य जननी कुपिता माऽशपत्पुरा।\nयदा त्वया परित्यक्ता ततोऽहं भृशपीडितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2020660, "chapter_id": 1432, "verse_number": "३-७०-३५", "content_sanskrit": "अवसं त्वयि राजेन्द्र सुदुःखभपराजित।\nविषेण नागराजस्य दह्यमानो दिवानिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2020661, "chapter_id": 1432, "verse_number": "३-७०-३६", "content_sanskrit": "शरणं त्वां प्रपन्नोस्मि शृणु चेदं वचो मम।\nये च त्वां मनुजा लोके कीर्तयिष्यन्त्यतन्द्रिताः।\nमत्प्रत्सूतं भयं तेषां न कदाचिद्भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2020662, "chapter_id": 1432, "verse_number": "३-७०-३७", "content_sanskrit": "`न तेषां मानसं किंचिच्छारीरं वाचिकं तथा।\nभविष्यति महाराज कीर्तयिष्यन्ति ये नलम्।\nभयार्तं शरणं यातं यदि मां त्वं न शप्स्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2020663, "chapter_id": 1432, "verse_number": "३-७०-३८", "content_sanskrit": "एवमुक्तो नलो राजा न्ययच्छत्कोपमात्मनः।\nततो बीतः कलिः क्षिप्रं प्रविवेश विभीतकम्।\nकलिस्त्वन्येन नो दृष्टः कथयन्नैषधेन वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2020664, "chapter_id": 1432, "verse_number": "३-७०-३९", "content_sanskrit": "ततो गतत्वरो राजा नैषधः परवीरहा।\nसंप्रनष्टे कलौ राजा संख्यायास्य फलान्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2020665, "chapter_id": 1432, "verse_number": "३-७०-४०", "content_sanskrit": "मुदा परमया युक्तस्तेजसाऽथ परेण वै।\nरथमारुह्य तेजस्वी प्रययौ जवनैर्हयैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2020666, "chapter_id": 1432, "verse_number": "३-७०-४१", "content_sanskrit": "बिभीतकश्चाप्रशस्तः संवृत्तः कलिसंश्रयात्।\n`ततः प्रभृतिराजेन्द्र लोकेऽस्मिन्पाण्डुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2020667, "chapter_id": 1432, "verse_number": "३-७०-४२", "content_sanskrit": "हयोत्तभानुत्पततो द्विजानिव पुनः पुनः।\nनलः संचोदयामास प्रहृष्टेनान्तरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2020668, "chapter_id": 1432, "verse_number": "३-७०-४३", "content_sanskrit": "विदर्भाभिमुखो राजा प्रययौ स महायशाः।\nनले तु समतिक्रान्ते कलिरप्यगमद्गृहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2020669, "chapter_id": 1432, "verse_number": "३-७०-४४", "content_sanskrit": "ततो गतज्वरो राजा नलोऽभूत्पृथिवीपतिः।\nविमुक्तः कलिना राजन्रूपमात्रवियोजितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2020670, "chapter_id": 1432, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि नलोपाख्यानपर्वणि सप्ततितमोऽध्यायः ॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]