[{"id": 900005120, "chapter_id": 8418, "verse_number": "5.1", "content_sanskrit": "तच्च निमित्तं भेदोऽत्र बाधित इति चेत्तर्हि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900005121, "chapter_id": 8418, "verse_number": "5.2", "content_sanskrit": "अन्यैरपि समवायस्याश्रितत्वादिव्यवहारे..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900005122, "chapter_id": 8418, "verse_number": "5.3", "content_sanskrit": "शरीरत्वहेतुरपि परस्पराननुसंहितभोगायतन-त्वेन विवक्षित इति न तत्रापि दोषः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900005123, "chapter_id": 8418, "verse_number": "5.4", "content_sanskrit": "किञ्च भेदत्वहेतोरविद्यानिवृत्तिरूपमोक्षात्मभेदे व्यभिचारश्च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900005124, "chapter_id": 8418, "verse_number": "5.5", "content_sanskrit": "ननु किं भेदः परमात्मप्रतियोगिकः साध्य उत..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900005125, "chapter_id": 8418, "verse_number": "5.6", "content_sanskrit": "अथवा प्रागवस्थायां येन भेदेन..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900005126, "chapter_id": 8418, "verse_number": "5.7", "content_sanskrit": "अथवा संसारसंसर्गाभावो मुक्तत्वम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900005127, "chapter_id": 8418, "verse_number": "5.8", "content_sanskrit": "एवं संसारिणो मुक्तत्वं स्यादिति कोऽर्थः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900005128, "chapter_id": 8418, "verse_number": "5.9", "content_sanskrit": "किञ्चेश्वरवचनैस्तस्य संसारिभेदानुभव एवानु-मीयते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900005129, "chapter_id": 8418, "verse_number": "5.10", "content_sanskrit": "अपर आह", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900005130, "chapter_id": 8418, "verse_number": "5.11", "content_sanskrit": "ननु संश्लिष्टोपाधित्वमनुसन्धाने प्रयोजकम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900005131, "chapter_id": 8418, "verse_number": "5.12", "content_sanskrit": "अत एव विमतानि शरीराणि देवदत्तस्यैव भोगायतनानि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900005132, "chapter_id": 8418, "verse_number": "5.13", "content_sanskrit": "वादावली–जयतीर्थमुनीन्द्रेण बालबोधाय निर्मितम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]