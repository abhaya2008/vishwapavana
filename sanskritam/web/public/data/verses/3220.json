[{"id": 2102545, "chapter_id": 3220, "verse_number": "१४-७६-१", "content_sanskrit": "एवं त्रिरात्रमभवत्तद्युद्धं भरतर्षभ।\nअर्जुनस्य नरेन्द्रेण वृत्रेणेव शतक्रतोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2102546, "chapter_id": 3220, "verse_number": "१४-७६-२", "content_sanskrit": "ततश्चतुर्थे दिवसे यज्ञदत्तो महाबलः।\nजहास सस्वनं हासं वाक्यं चेदमताब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2102547, "chapter_id": 3220, "verse_number": "१४-७६-३", "content_sanskrit": "अर्जुनार्जुन तिष्ठस्व न मे जीवन्विमोक्ष्यसे।\nत्वां निहत्य करिष्यामि पितुस्तोयं यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2102548, "chapter_id": 3220, "verse_number": "१४-७६-४", "content_sanskrit": "त्वया वृद्धो मम पिता भगदत्तः पितुः सखा।\nहतो वृद्धोऽपि बाधित्वा शिशुं मामद्य योधय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2102549, "chapter_id": 3220, "verse_number": "१४-७६-५", "content_sanskrit": "इत्येवमुक्त्वा संक्रुद्धो यज्ञदत्तो नराधिपः।\nप्रेषयामास कौरव्य वारणं पाण्डवं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2102550, "chapter_id": 3220, "verse_number": "१४-७६-६", "content_sanskrit": "सम्प्रेष्यमाणो नागेन्द्रो यज्ञदत्तेन धीमता।\nउत्पतिष्यन्निवाकाशमभिदुद्राव पाण्डवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2102551, "chapter_id": 3220, "verse_number": "१४-७६-७", "content_sanskrit": "अग्रहस्तसुमुक्तेन शीकरेण स नागराट्।\nसमौक्षति गुडाकेशं शैलं नील इवाम्बुदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2102552, "chapter_id": 3220, "verse_number": "१४-७६-८", "content_sanskrit": "स तेन प्रेषितो राज्ञा मेघवद्विनदन्मुहुः।\nमुखाडम्बरसंह्रादैरभ्यद्रवत फल्गुनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2102553, "chapter_id": 3220, "verse_number": "१४-७६-९", "content_sanskrit": "स नृत्यन्निव नागेन्द्रो यज्ञदत्तप्रचोदितः।\nआससाद द्रुतं राजन्कौरवाणां महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2102554, "chapter_id": 3220, "verse_number": "१४-७६-१०", "content_sanskrit": "तमायान्तमथालक्ष्य यज्ञदत्तस्य वारणम्।\nगाण्डीवमाश्रित्य बली न व्यकम्पत शत्रुहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2102555, "chapter_id": 3220, "verse_number": "१४-७६-११", "content_sanskrit": "चुक्रोध बलवच्चापि पाण्डवस्तस्य भूपतेः।\nकार्यविघ्नमनुस्मृत्यि पूर्ववैरं च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2102556, "chapter_id": 3220, "verse_number": "१४-७६-१२", "content_sanskrit": "ततस्तं वारणं क्रुद्धः शरजालेन पाण्डवः।\nनिवारयामास तदा वेलेव मकरालयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2102557, "chapter_id": 3220, "verse_number": "१४-७६-१३", "content_sanskrit": "स नागप्रवरः श्रीमानर्जुनेन निवारितः।\nतस्थौ शरैर्विनुन्नाङ्गः श्वाविच्छललितो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2102558, "chapter_id": 3220, "verse_number": "१४-७६-१४", "content_sanskrit": "निवारितं गजं दृष्ट्वा भगदत्तसुतो नृपः।\nउत्ससर्ज शितान्बाणानर्जुने क्रोधमूर्छितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2102559, "chapter_id": 3220, "verse_number": "१४-७६-१५", "content_sanskrit": "अर्जुनस्तु महाबाहुः शरैररिनिघातिभिः।\nवारयामास तान्बाणांस्तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2102560, "chapter_id": 3220, "verse_number": "१४-७६-१६", "content_sanskrit": "ततः पुनरभिक्रुद्धो राजा प्राग्ज्योतिषाधिपः।\nप्रेषयामास नागेन्द्रं बलवत्पर्वतोपमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2102561, "chapter_id": 3220, "verse_number": "१४-७६-१७", "content_sanskrit": "तमापतन्तं सम्प्रेक्ष्य बलवान्पाकशासनिः।\nनाराचमग्निसङ्काशं प्राहिणोद्वारणं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2102562, "chapter_id": 3220, "verse_number": "१४-७६-१८", "content_sanskrit": "स तेन वारणो राजन्मर्मस्वभिहतो भृशम्।\nपपात सहसा भूमौ वज्ररुग्ण इवाचलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2102563, "chapter_id": 3220, "verse_number": "१४-७६-१९", "content_sanskrit": "स पतञ्शुशुभे नागो धनंजयशराहतः।\nविशन्निव महाशैलो महीं वज्रप्रपीडितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2102564, "chapter_id": 3220, "verse_number": "१४-७६-२०", "content_sanskrit": "तस्मिन्निपतिते नागे यज्ञदत्तस्य पाण्डवः।\nतं न भेतव्यमित्याह ततो भूमिगतं नृपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2102565, "chapter_id": 3220, "verse_number": "१४-७६-२१", "content_sanskrit": "अब्रवीद्धि महातेजाः प्रस्थितं मां युधिष्ठिरः।\nराजानस्ते न हन्तव्या धनंजय कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2102566, "chapter_id": 3220, "verse_number": "१४-७६-२२", "content_sanskrit": "सर्वमेतन्नरव्याघ्र भवत्येतावता कृतम्।\nयोधाश्चापि न हन्तव्या धनंजय रणे त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2102567, "chapter_id": 3220, "verse_number": "१४-७६-२३", "content_sanskrit": "वक्तव्याश्चापि राजानः सर्वे सह सुहृज्जनैः।\nयुधिष्ठिरस्याश्वमेधो भवद्भिरनुभूयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2102568, "chapter_id": 3220, "verse_number": "१४-७६-२४", "content_sanskrit": "इति भ्रातृवचः श्रुत्वा न हन्मि त्वां नराधिप।\nउत्तिष्ठ न भयं तेऽस्ति स्वस्तिमान्गच्छ पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2102569, "chapter_id": 3220, "verse_number": "१४-७६-२५", "content_sanskrit": "आगच्छेथा महाराज परां चैत्रीमुपस्थिताम्।\nतदाऽश्वमेधो भविता धर्मिराजस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2102570, "chapter_id": 3220, "verse_number": "१४-७६-२६", "content_sanskrit": "एवमुक्तः स राजा तु भगदत्तात्मजस्तदा।\nतथेत्वेवाब्रवीद्वाक्यं पाण्डवेनाभिनिर्जितः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2102571, "chapter_id": 3220, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि षट्सप्ततितमोऽध्यायः॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]