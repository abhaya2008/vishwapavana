[{"id": 2108222, "chapter_id": 3341, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2108223, "chapter_id": 3341, "verse_number": "१", "content_sanskrit": "तं समुद्रमतिक्रम्य कद्रूर्विनतया सह ।\nन्यपतत्तुरगाभ्याशे नचिरादिव शीघ्रगा \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2108224, "chapter_id": 3341, "verse_number": "२", "content_sanskrit": "नागास्तु सहिताः कृत्वा कर्तव्यमिति तद्वचः ।\nनिस्स्नेहा वै दहेन्माता ह्यसम्प्राप्तमनोरथा\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2108225, "chapter_id": 3341, "verse_number": "३", "content_sanskrit": "सपत्नी न जयेदस्मान् तस्माज्जय्याद्य भामिनी ।\nकृष्णं पुच्छं करिष्यामस्तुरगस्य न संशयः\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2108226, "chapter_id": 3341, "verse_number": "४", "content_sanskrit": "तथेति गत्वा ते तस्य पुच्छे बाला इवास्थिताः ।\nएतस्मिन्नन्तरे ते तु सपत्न्यौ पणिते तदा\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2108227, "chapter_id": 3341, "verse_number": "५", "content_sanskrit": "जग्मतुः परया प्रीत्या परं पारं महोदधेः ।\nनिशाम्य च बहून् वालान् कृष्णान् पुच्छमुपाश्रितान्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2108228, "chapter_id": 3341, "verse_number": "६", "content_sanskrit": "विनतां विषण्णवदनां कद्रूर्दास्ये न्ययोजयत् ।\nततः सा विनता तस्मिन् पणितेन पराजिता\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2108229, "chapter_id": 3341, "verse_number": "७", "content_sanskrit": "अभवद् दुःखसन्तप्ता दासीभावे समास्थिता ।\nएतस्मिन्नन्तरे चैव गरुडः काल आगते \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2108230, "chapter_id": 3341, "verse_number": "८", "content_sanskrit": "विना मात्रा महातेजा विदार्याण्डमजायत ।\nअग्निराशिरिवोद्भासः समिद्धोऽतिभयङ्करः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2108231, "chapter_id": 3341, "verse_number": "९", "content_sanskrit": "प्रवृद्धः सहसा पक्षी महाकायो नभोगतः।\nतं दृष्ट्वा शरणं जग्मुः प्रजाः सर्वा विभावसुम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2108232, "chapter_id": 3341, "verse_number": "१०", "content_sanskrit": "प्रणिपत्याब्रुवंश्चैनमासीनं विश्वरूपिणम् ।\nमा त्वमग्ने प्रवर्धिष्ठाः कच्चिन्नो न दिधक्षसि ।\nअसौ हि राशिः सुमहान् समिद्धस्तव सर्पति \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2108233, "chapter_id": 3341, "verse_number": "", "content_sanskrit": "अग्निः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2108234, "chapter_id": 3341, "verse_number": "११", "content_sanskrit": "नैतदेवं यथा यूयं मन्यध्वमसुरार्दनाः ।\nगरुडो भगवानेष मम तुल्यः स्वतेजसा \t ॥ ११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2108235, "chapter_id": 3341, "verse_number": "१२", "content_sanskrit": "नागक्षयकरस्त्वेषः काश्यपेयो महाबलः ।\nदेवानां च हिते युक्तस्त्वहितो दैत्यरक्षसाम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2108236, "chapter_id": 3341, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2108237, "chapter_id": 3341, "verse_number": "१३", "content_sanskrit": "एवमुक्तास्ततो गत्वा गरुडं वाग्भिरस्तुवन् ।\nअदूरादभ्युपेत्यैनं गत्वा सर्षिगणास्तदा\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2108238, "chapter_id": 3341, "verse_number": "", "content_sanskrit": "देवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2108239, "chapter_id": 3341, "verse_number": "१५", "content_sanskrit": "त्वमृषिस्त्वं महाभागस्त्वं देवः पतगोत्तमः ।\nत्वं प्रभुस्तपनः सूर्यः परमेष्ठी प्रजापतिः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2108240, "chapter_id": 3341, "verse_number": "१६", "content_sanskrit": "त्वमिन्द्रस्त्वं हयमुखस्त्वं सर्वस्त्वं जगत्पतिः ।\nत्वं मुखं पद्मजो विप्रस्त्वमग्निः पवनस्तथा \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2108241, "chapter_id": 3341, "verse_number": "१७", "content_sanskrit": "त्वं विधाता च धाता च त्वं विष्णुः सुरसत्तमः ।\nत्वं महानभिभूः शश्वदमृतं त्वं महद्यशः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2108242, "chapter_id": 3341, "verse_number": "१८", "content_sanskrit": "त्वं प्रभास्त्वमभिप्रेतस्त्वं नस्त्राणमनुत्तमम् ।\nत्वं गतिः सततं त्वत्तः कथं नः प्राप्नुयाद् भयम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2108243, "chapter_id": 3341, "verse_number": "१९", "content_sanskrit": "बलोत्तमः साधुरदीनसत्त्वः\nसमृद्धिमान्दुष्प्रसहस्त्वमेव ।\nतपः श्रुतं सर्वमहीनकीर्तेः\nअनागतं चोपगतं च सर्वम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2108244, "chapter_id": 3341, "verse_number": "२०", "content_sanskrit": "त्वमुत्तमः सत्वमिदं चराचरं\nगभस्तिभिर्भानुरिवावभाससे ।\nसमाक्षिपन्भानुमतः प्रभां मुहुः\nत्वमन्ततः सर्वमिदं ध्रुवाध्रुवम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2108245, "chapter_id": 3341, "verse_number": "२१", "content_sanskrit": "दिवाकरः परिकुपितो यथा दहेत्\nप्रजास्तथा दहसि हुताशनप्रभः ।\nभयङ्करः प्रलय इवाग्निरुत्थितो\nविनाशयन् युगपरिवर्तनान्तकृत् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2108246, "chapter_id": 3341, "verse_number": "२२", "content_sanskrit": "खगेश्वरं शरणमुपस्थिता वयं\nमहौजसं वितिमिरदभ्रगोचरम् ।\nमहाबलं गरुडमुपेत्य खेचरं\nपरावरं वरदमजेयविक्रमम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2108247, "chapter_id": 3341, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2108248, "chapter_id": 3341, "verse_number": "२३", "content_sanskrit": "स्तवं श्रुत्वात्मनो देहं सुपर्णः प्रेक्ष्य च स्वयम् ।\nततस्संपरिहर्तुं स सर्वतः परिचक्रमे \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2108249, "chapter_id": 3341, "verse_number": "", "content_sanskrit": "सुपर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2108250, "chapter_id": 3341, "verse_number": "२४", "content_sanskrit": "न मे सर्वाणि भूतानि बिभियुर्देहदर्शनात् ।\nसमुद्विग्नानि रूपान्मे इति तेजस्समाहरत् \t॥२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2108251, "chapter_id": 3341, "verse_number": "२०", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि विंशोऽध्यायः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2108252, "chapter_id": 3341, "verse_number": "८", "content_sanskrit": "॥ आस्तीकपर्वणि अष्टमोऽध्यायः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]