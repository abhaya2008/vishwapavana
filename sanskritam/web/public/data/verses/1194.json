[{"id": 2009846, "chapter_id": 1194, "verse_number": "१-१९५-०x", "content_sanskrit": "ब्राह्मण्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2009847, "chapter_id": 1194, "verse_number": "१-१९५-१", "content_sanskrit": "नाहं गृह्णामि वस्ताता दृष्टीर्नास्मि रुषान्विता।\nअयं तु भार्गवो नूनमूरुजः कुपितोऽद्य वः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2009848, "chapter_id": 1194, "verse_number": "१-१९५-२", "content_sanskrit": "तेन चक्षूंषि वस्ताता व्यक्तं कोपान्महात्मना।\nस्मरता निहतान्बन्धूनादत्तानि न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2009849, "chapter_id": 1194, "verse_number": "१-१९५-३", "content_sanskrit": "गर्भानपि यदा यूयं भृगूणां घ्नत पुत्रकाः।\nतदायमूरुणा गर्भो मया वर्षशतं धृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2009850, "chapter_id": 1194, "verse_number": "१-१९५-४", "content_sanskrit": "षडङ्गश्चाखिलो वेद इमं गर्भस्थमेव ह।\nविवेश भृगुवंशस्य भूयः प्रियचिकीर्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2009851, "chapter_id": 1194, "verse_number": "१-१९५-५", "content_sanskrit": "सोऽयं पितृवधाद्व्यक्तं क्रोधाद्वो हन्तुमिच्छति।\nतेजसा तस्य दिव्येन चक्षूंषि मुषितानि वः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2009852, "chapter_id": 1194, "verse_number": "१-१९५-६", "content_sanskrit": "तमेव यूयं याचध्वमौर्वं मम सुतोत्तमम्।\nअयं वः प्रणिपातेन तुष्टो दृष्टीः प्रदास्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2009853, "chapter_id": 1194, "verse_number": "१-१९५-७x", "content_sanskrit": "वसिष्ठ उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2009854, "chapter_id": 1194, "verse_number": "१-१९५-७", "content_sanskrit": "एवमुक्तास्ततः सर्वे राजानस्ते तमूरुजम्।\nऊचुः प्रसीदेति तदा प्रसादं च चकार सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2009855, "chapter_id": 1194, "verse_number": "१-१९५-८", "content_sanskrit": "अनेनैव च विख्यातो नाम्ना लोकेषु सत्तमः।\nस और्व इति विप्रर्षिरूरुं भित्त्वा व्यजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2009856, "chapter_id": 1194, "verse_number": "१-१९५-९", "content_sanskrit": "चक्षूंषि प्रतिलभ्याथ प्रतिजग्मुस्ततो नृपाः।\nभार्गवस्तु मुनिर्मेने सर्वलोकपराभवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2009857, "chapter_id": 1194, "verse_number": "१-१९५-१०", "content_sanskrit": "स चक्रे तात लोकानां विनाशाय मतिं तदा।\nसर्वेषामेव कार्त्स्न्येन मनः प्रवणमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2009858, "chapter_id": 1194, "verse_number": "१-१९५-११", "content_sanskrit": "इच्छन्नपचितिं कर्तुं भृगूणां भृगुनन्दनः।\nसर्वलोकविनाशाय तपसा सहतैधितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2009859, "chapter_id": 1194, "verse_number": "१-१९५-१२", "content_sanskrit": "तापयामास ताँल्लोकान्सदेवासुरमानुषान्।\nतपसोग्रेण महता नन्दयिष्यन्पितामहान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2009860, "chapter_id": 1194, "verse_number": "१-१९५-१३", "content_sanskrit": "ततस्तं पितरस्तात विज्ञाय कुलनन्दनम्।\nपितृलोकादुपागम्य सर्व ऊचुरिदं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2009861, "chapter_id": 1194, "verse_number": "१-१९५-१४", "content_sanskrit": "और्व दृष्टः प्रभावस्ते तपसोग्रस्य पुत्रक।\nप्रसादं कुरु लोकानां नियच्छ क्रोधमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2009862, "chapter_id": 1194, "verse_number": "१-१९५-१५", "content_sanskrit": "नानीशैर्हि तदा तात भृगुभिर्भावितात्मभिः।\nवधो ह्युपेक्षितः सर्वैः क्षत्रियाणां विहिंसताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2009863, "chapter_id": 1194, "verse_number": "१-१९५-१६", "content_sanskrit": "आयुषा विप्रकृष्टेन यदा नः खेद आविशत्।\nतदाऽस्माभिर्वधस्तात क्षत्रियैरीप्सितः स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2009864, "chapter_id": 1194, "verse_number": "१-१९५-१७", "content_sanskrit": "निखातं यच्च वै वित्तं केनचिद्गृगुवेश्मनि।\nवैरायैव तदा न्यस्तं क्षत्रियान्कोपयिष्णुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2009865, "chapter_id": 1194, "verse_number": "१-१९५-१८", "content_sanskrit": "किं हि वित्तेन नः कार्यं स्वर्गेप्सूनां द्विजोत्तम।\nयदस्माकं धनाध्यक्षः प्रभूतं धनमाहरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2009866, "chapter_id": 1194, "verse_number": "१-१९५-१९", "content_sanskrit": "यदा तु मृत्युरादातुं न नः शक्नोति सर्वशः।\nतदाऽस्माभिरयं दृष्ट उपायस्तात संमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2009867, "chapter_id": 1194, "verse_number": "१-१९५-२०", "content_sanskrit": "आत्महा च पुमांस्तात न लोकाँल्लभते शुभान्।\nततोऽस्माभिः समीक्ष्यैवं नात्मनात्मा निपातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2009868, "chapter_id": 1194, "verse_number": "१-१९५-२१", "content_sanskrit": "न चैतन्नः प्रियं तात यदिदं कर्तुमिच्छसि।\nनियच्छेदं मनः पापात्सर्वलोकपराभवात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2009869, "chapter_id": 1194, "verse_number": "१-१९५-२२", "content_sanskrit": "मा वधीः क्षत्रियांस्तात न लोकान्सप्त पुत्रक।\nदूषयन्तं तपस्तेजः क्रोधमुत्पतितं जहि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2009870, "chapter_id": 1194, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि चैत्ररथपर्वणि पञ्चनवत्यधिकशततमोऽध्यायः॥ १९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]