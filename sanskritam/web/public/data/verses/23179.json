[{"id": 7003179000, "chapter_id": 23179, "verse_number": "४-११५-१", "content_sanskrit": "अथ पञ्चदशाधिकशततमोऽध्यायः ।\nनारायण उवाच ।\nअथ भीता रक्षकास्ते समूतुर्बाणमीश्वरम् ।\nस्कन्दं गणेशं दुर्गां च दण्डवत्प्रणिपत्य च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003179001, "chapter_id": 23179, "verse_number": "४-११५-२", "content_sanskrit": "रक्षका ऊचुः ।\nअहो दुष्टश्च कालोऽयमतीव दुरतिक्रमः ।\nस्वतन्त्रा बालिका प्रौढा पतिमिच्छति सांप्रतम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003179002, "chapter_id": 23179, "verse_number": "४-११५-३", "content_sanskrit": "असङ्गसंगमं नाथ साधूनां दुःखकारणम् ।\nसंसर्गजा गुणा दोषा भवन्ति सततं नृणाम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003179003, "chapter_id": 23179, "verse_number": "४-११५-४", "content_sanskrit": "चित्रलेखा स्वयं दूती समानीय परं वरम् ।\nरणशूरं महावीरं नृपेन्द्रं च महारथम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003179004, "chapter_id": 23179, "verse_number": "४-११५-५", "content_sanskrit": "युवानं व्याधिहीनं च कन्दर्पादपि सुन्दरम् ।\nसंभोगं कारयामास बुबुधे न दिवानिशम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003179005, "chapter_id": 23179, "verse_number": "४-११५-६", "content_sanskrit": "सांप्रतं तव कन्या साऽप्यूषागर्भवती सती ।\nकुलजा कुलयोश्चैव तप्ताङ्गारस्वरूपिणी ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003179006, "chapter_id": 23179, "verse_number": "४-११५-७", "content_sanskrit": "दौहित्रो वाऽपि दौहित्री बभुव सांप्रतं तव ।\nकन्यां पश्य महाप्रौढां नगरीं नागरान्विताम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003179007, "chapter_id": 23179, "verse_number": "४-११५-८", "content_sanskrit": "नखविक्षतसर्वाङ्गीं वराधीनां च चञ्चलाम् ।\nपुंसश्च सङ्गिरीं शश्वद्रहस्ये रतिसङ्गिनीम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003179008, "chapter_id": 23179, "verse_number": "४-११५-९", "content_sanskrit": "सस्मितां सकटाक्षां च च़ञ्चलेक्षणवीक्षताम् ।\nएवं श्रुत्वा लज्जितश्च बाणस्तत्र चुकोप ह ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003179009, "chapter_id": 23179, "verse_number": "४-११५-१०", "content_sanskrit": "युद्धाय च मतिं चक्रे वारितः शभुना भृशम् ।\nवारितश्च गणेशेन स्कन्देन शिवया तथा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003179010, "chapter_id": 23179, "verse_number": "४-११५-११", "content_sanskrit": "भैरव्या भद्रकाल्या च योगिनीभिश्च संततम् ।\nअष्टभिर्भैरवैश्चैव रुद्रैरेकादशात्मकैः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003179011, "chapter_id": 23179, "verse_number": "४-११५-१२", "content_sanskrit": "भूतैः प्रेतैश्च कूष्माण्डैर्वेतालैर्ब्रह्मराक्षसैः ।\nयोसीन्द्रैरपि सिद्धेन्द्रै रुद्रैश्चण्डादिभिस्तथा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003179012, "chapter_id": 23179, "verse_number": "४-११५-१३", "content_sanskrit": "कोटर्या प्रामदेव्या च यथा मात्रा हिताय च ।\nउवाच शंकरो बाणं मूढं पण्डितमानिनम् ।\nहितं सत्यं नीतिशास्त्रं परिणामसुखावहम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003179013, "chapter_id": 23179, "verse_number": "४-११५-१४", "content_sanskrit": "महादेव उवाच ।\nशृणु बाण प्रवक्ष्यामि कथामेतां पुरातनीम् ।\nभुवो भारावतरणे भारते स्वयमीश्वरः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003179014, "chapter_id": 23179, "verse_number": "४-११५-१५", "content_sanskrit": "निहत्य सर्वान्राजेन्द्रान्द्वारकायां विराजते ।\nयस्य लोमसु विश्वानि तस्य वासः सदीश्वरः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003179015, "chapter_id": 23179, "verse_number": "४-११५-१६", "content_sanskrit": "वासुदेव इति ख्यातः कथ्यते तेन कोविदैः ।\nधातुर्विधाता भगवांश्चक्रपाणिः स्वयं भुवि ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003179016, "chapter_id": 23179, "verse_number": "४-११५-१७", "content_sanskrit": "ब्रह्मविष्णुशिवादीनामीश्वरः प्रकृतेः परः ।\nनिर्गुणश्च निरीहश्च भक्तानुग्रहविग्रहः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003179017, "chapter_id": 23179, "verse_number": "४-११५-१८", "content_sanskrit": "परं ब्रह्म परं धाम परमात्मा च देहिनः ।\nयस्मिन्गते शवो जीवो संग्रामस्तेन संभवेत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003179018, "chapter_id": 23179, "verse_number": "४-११५-१९", "content_sanskrit": "शस्त्रविद्धो महाकाशो यथा मूढ दिशस्तथा ।\nतथाऽऽत्मा च निराकारो देही च ध्यानहेतुना ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003179019, "chapter_id": 23179, "verse_number": "४-११५-२०", "content_sanskrit": "तस्य पुत्रोऽनिरुद्धश्च महाबलपराक्रमः ।\nत्रैलोक्यमपि संहर्तुं क्षणेन च क्षमः स्वयम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003179020, "chapter_id": 23179, "verse_number": "४-११५-२१", "content_sanskrit": "सर्वे वेवाश्च दैत्याश्च बलवन्तो महारथाः ।\nते सर्वे चानिरुद्धस्य कलां नार्हन्ति षोडशीम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003179021, "chapter_id": 23179, "verse_number": "४-११५-२२", "content_sanskrit": "ययोरेव समं वित्तं ययोरेव समं बलम् ।\nतयोर्विवाहो मैत्री च न तु पुष्टविपुष्टयोः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003179022, "chapter_id": 23179, "verse_number": "४-११५-२३", "content_sanskrit": "बलिः पिता ते दैत्यानां सारभूतो महारथः ।\nक्षणेन येन नीतश्च सुतलं स हरेः कला ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003179023, "chapter_id": 23179, "verse_number": "४-११५-२४", "content_sanskrit": "सर्वे चांशकलाः पुंसः परिपूर्णतमस्य च ।\nवृन्दावनेश्वरस्यापि कृष्णस्य परमात्मनः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003179024, "chapter_id": 23179, "verse_number": "४-११५-२५", "content_sanskrit": "पार्वत्युवाच ।\nध्यायते ध्याननिष्ठश्च हृत्पद्मे च दिवानिश्म् ।\nब्रह्मा महेशः मेषश्च भगवन्तं सनातनम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003179025, "chapter_id": 23179, "verse_number": "४-११५-२६", "content_sanskrit": "दिनेशश्च गणेशश्च योगीन्द्राणां गुरोर्गुरुः ।\nध्यायते परमात्मानं भगवन्तं सनातनम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003179026, "chapter_id": 23179, "verse_number": "४-११५-२७", "content_sanskrit": "सनत्कुमारः कपिलो नरो नारायणस्तथा ।\nध्यायते हृदयाम्भोजे भगवन्तं स ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003179027, "chapter_id": 23179, "verse_number": "४-११५-२८", "content_sanskrit": "मनवश्च मुनीन्द्राश्च सिद्धेन्द्रा योगिनां वराः ।\nध्यानासाध्यं च ध्यायन्ते भगवन्तं स ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003179028, "chapter_id": 23179, "verse_number": "४-११५-२९", "content_sanskrit": "सर्वादिं सर्वबीजं च सर्वेशं च परात्परम् ।\nध्यायन्ते ज्ञानिनः सर्वे भगवन्तं स ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003179029, "chapter_id": 23179, "verse_number": "४-११५-३०", "content_sanskrit": "गणेश उवाच ।\nअभाग्यं च बलेश्चापि वैष्णवस्य महात्मनः ।\nमूढोऽयमीदृशः पुत्रः प्रह्लादस्य च धीमतः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003179030, "chapter_id": 23179, "verse_number": "४-११५-३१", "content_sanskrit": "स्कन्द उवाच ।\nअये भ्रातर्न श्रुता च हिरण्यकशिपोः कथा ।\nहिरण्याक्षस्य च मधोः कैटभस्य महात्मनः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003179031, "chapter_id": 23179, "verse_number": "४-११५-३२", "content_sanskrit": "पूर्वजास्तेऽपि ते दैत्या महाबलपराक्रमाः ।\nक्रमेण विष्णुना नीता लीलया यमसादनम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003179032, "chapter_id": 23179, "verse_number": "४-११५-३३", "content_sanskrit": "भगवान्यस्य संहर्ता स्वयं नारायणः प्रभुः ।\nतस्य को रक्षिता भ्रातर्निवर्तस्व शुभायच ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003179033, "chapter_id": 23179, "verse_number": "४-११५-३४", "content_sanskrit": "तेषां च वचनं श्रुत्वा तानुवाचासुरेश्वरः ।\nकोपरक्तास्यनयनो धनुष्पाणिर्यथाऽन्तकः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003179034, "chapter_id": 23179, "verse_number": "४-११५-३५", "content_sanskrit": "बाण उवाच ।\nशृणु मातः प्रवक्ष्यामि शृणु तात महेश्वर ।\nशृणु भ्रातर्गणपते शृणु भ्रातश्च कार्तिक ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003179035, "chapter_id": 23179, "verse_number": "४-११५-३६", "content_sanskrit": "शुभशुभं प्राक्तनेन प्राणिनां कर्मिणां तथा ।\nकृतकर्मातिरिक्तं च कार्य केषां च वर्तते ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003179036, "chapter_id": 23179, "verse_number": "४-११५-३७", "content_sanskrit": "नाप्राप्तकालो म्रियते विद्धः शरशतैरपि ।\nतृणाग्रेणापि संस्पृष्टः प्राप्तकालो न जीवति ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003179037, "chapter_id": 23179, "verse_number": "४-११५-३८", "content_sanskrit": "यस्माच्च यस्य निर्वाणं विधात्रा लिखितं पुरा ।\nतदेव नित्यं सत्यं च निषेकः केन वार्यते ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003179038, "chapter_id": 23179, "verse_number": "४-११५-३९", "content_sanskrit": "संग्रामे कातरो यो हि निष्फलं तस्य जीवनम् ।\nजयी यशस्च लभते मृतः स्वर्गं च गच्छति ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003179039, "chapter_id": 23179, "verse_number": "४-११५-४०", "content_sanskrit": "प्रविश्य कन्यां गृह्णाति नगरं शिवरक्षितम् ।\nपार्वत्या च गणेशेन युद्धेन बलिना तथा ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003179040, "chapter_id": 23179, "verse_number": "४-११५-४१", "content_sanskrit": "को वा गृह्णाति कन्यां च कस्य वा जीवितस्य च ।\nसगर्भा तव कन्येति सभायां रक्षको वदेत् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003179041, "chapter_id": 23179, "verse_number": "४-११५-४२", "content_sanskrit": "इति मे वज्रतुल्यं च श्रुतिकौटं परं वचः ।\nअतोऽनिरुद्वं हत्वा च घातयिष्यामि कन्यकाम् ।\nअन्यथा ज्वलदग्नौ च त्यक्ष्यामि च कलेवरम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003179042, "chapter_id": 23179, "verse_number": "४-११५-४३", "content_sanskrit": "कोटर्युवाच ।\nशृणु वत्स प्रवक्ष्यामि माताऽहं तेऽपि धर्मतः ।\nतुरन्तेनापि पृत्रेण पित्रोर्दुःर्ख पदे पदे ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003179043, "chapter_id": 23179, "verse_number": "४-११५-४४", "content_sanskrit": "कन्या परगृहीता साऽप्यन्यस्मै दातुमक्षमा ।\nश्रीकृष्णस्यापि पौत्राय प्रद्युम्नस्य सुताय च ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003179044, "chapter_id": 23179, "verse_number": "४-११५-४५", "content_sanskrit": "अनिरुद्धाय महते स्वेच्छया देहि कन्यकाम् ।\nपूतोऽसि भारते वर्षे सप्तभिः पितृभिः सह ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003179045, "chapter_id": 23179, "verse_number": "४-११५-४६", "content_sanskrit": "यौतुकं देहि सर्वस्वं यशसे महसे भुवि ।\nअन्यथा रणमध्ये च त्वां हनिष्यति माधवः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003179046, "chapter_id": 23179, "verse_number": "४-११५-४७", "content_sanskrit": "सुदशंनेन चकेण को वा त्वां रक्षितुं क्षमः ।\nकोटरीवचनं श्रुत्वा चुकोप दैत्यपुंगवः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003179047, "chapter_id": 23179, "verse_number": "४-११५-४८", "content_sanskrit": "प्रययौ रथमारुह्य यत्र पौत्रो हरेर्मुने ।\nस्कन्दः सेनापतिर्भूत्वा प्रययौ शंकराज्ञया ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003179048, "chapter_id": 23179, "verse_number": "४-११५-४९", "content_sanskrit": "बाणः स्वस्त्ययनं चक्रे गणेशश्च शिवः स्वयम् ।\nबाणं शुभाशिषं चक्रे पार्वती कोटरी तथा ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003179049, "chapter_id": 23179, "verse_number": "४-११५-५०", "content_sanskrit": "अष्टौ च भैरवाश्चैव रुद्राश्चैकादशैव ते ।\nसर्वे युद्धाय हन्तारो बभूवुः शस्त्रपाणयः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003179050, "chapter_id": 23179, "verse_number": "४-११५-५१", "content_sanskrit": "एतस्मिन्नन्तरे दूतोऽप्यनिरुद्धमुवाच ह ।\nपार्वत्या प्रेरितश्चैव बाणपत्न्या च सत्वरम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003179051, "chapter_id": 23179, "verse_number": "४-११५-५२", "content_sanskrit": "दूत उवाच ।\nअनिरुद्धोत्तिष्ठ भद्रं पार्वतीवचनं शृणु ।\nभव सांनाहिको वत्स कुरु युद्धं बहिर्भव ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003179052, "chapter_id": 23179, "verse_number": "४-११५-५३", "content_sanskrit": "भीतोषा रुदती त्रस्ता सस्मार पार्वतीं सतीम् ।\nरक्ष रक्ष महामाये मत्प्रणेश्वरमीप्सितम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003179053, "chapter_id": 23179, "verse_number": "४-११५-५४", "content_sanskrit": "अभेयेऽप्यभयं देहि संग्रामे घोरदारुणे ।\nत्वमेव जगतां माता स्नेहस्ते सर्वतः समः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003179054, "chapter_id": 23179, "verse_number": "४-११५-५५", "content_sanskrit": "अथानिरुद्धः संनाही शस्त्रपाणिर्बभूव ह ।\nऊषादत्तं रथं प्राप्य चकाराऽऽरोहणं मुदा ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003179055, "chapter_id": 23179, "verse_number": "४-११५-५६", "content_sanskrit": "बहिः संभूय शिबिराद्ददर्श बाणमीश्वरः ।\nसांनाहिकं शस्त्रपाणिं रक्तास्यलोचनं परम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003179056, "chapter_id": 23179, "verse_number": "४-११५-५७", "content_sanskrit": "दृष्ट्वाऽनिरुद्धं बाणश्च तमुवाच रुषाऽन्वितः ।\nघोरसंग्राममध्ये च विषोक्तिं प्रज्वलन्निव ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003179057, "chapter_id": 23179, "verse_number": "४-११५-५८", "content_sanskrit": "बाण उवाच ।\nअये वीर महादुष्ट नीतिशास्त्रविवर्जित ।\nचन्द्र वंशकुलाङ्गार पुण्यक्षेत्रेऽयशस्कर ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003179058, "chapter_id": 23179, "verse_number": "४-११५-५९", "content_sanskrit": "पिता ते शम्बरं हत्वा जग्राह तस्य कामिनीम् ।\nततो जातो भवनेव निरोधं स्वकुलक्षमम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003179059, "chapter_id": 23179, "verse_number": "४-११५-६०", "content_sanskrit": "पितामहो वासुदेवो मथुरायां च क्षत्रियः ।\nगोकुले वैश्यपुत्रश्च नाम्ना च नन्दनन्दनः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003179060, "chapter_id": 23179, "verse_number": "४-११५-६१", "content_sanskrit": "वृन्दावने च गोपस्य नन्दस्य पशुरक्षकः ।\nसाक्षाज्जारश्च गोपीनां दुष्टः परमलम्पटः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003179061, "chapter_id": 23179, "verse_number": "४-११५-६२", "content_sanskrit": "जघान पूतनां सद्यो नारीघाती ह्यधार्मिकः ।\nआगत्य मथुरां कुब्जां जघान मैथुनेन च ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003179062, "chapter_id": 23179, "verse_number": "४-११५-६३", "content_sanskrit": "दुर्बलं नरकं हत्वा स्त्रीसमूहं मनोहरम् ।\nजग्राह योनिलुब्धश्च स्वपुत्रमतिनिष्ठुरः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003179063, "chapter_id": 23179, "verse_number": "४-११५-६४", "content_sanskrit": "भीष्मकं मानवं जित्वा तत्पुत्रं चापि दुर्बलम् ।\nजग्राह कन्यकां तस्य देवयोग्यां च रुक्मिणीम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003179064, "chapter_id": 23179, "verse_number": "४-११५-६५", "content_sanskrit": "सत्राजितः सूर्यभृत्यो देवात्प्राप मणीश्वरम् ।\nघातयित्वा ह्युपायेन जग्राह मणिकन्यकाम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003179065, "chapter_id": 23179, "verse_number": "४-११५-६६", "content_sanskrit": "कुरुपाण्डवयुद्धं च कारयित्वा च दारुणम् ।\nयुधिष्ठिरस्य यज्ञे च शिशुपालं जघान सः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003179066, "chapter_id": 23179, "verse_number": "४-११५-६७", "content_sanskrit": "दन्तवक्त्रं च शाल्बं च जरासंधं च दारुणः ।\nसंजहार भुवो भूपसमूहमतिदारुणम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003179067, "chapter_id": 23179, "verse_number": "४-११५-६८", "content_sanskrit": "उपायान्नरकं हत्वा सर्वस्वं तज्जहार सः ।\nदुर्बलो राजभीतश्चसमुद्रं शरणं गतः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003179068, "chapter_id": 23179, "verse_number": "४-११५-६९", "content_sanskrit": "जित्वा च भ्रातरं शक्रं भार्याया वचनेन च ।\nजग्राह पारिजातं च पुष्पं च स्वर्गदुर्लभम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003179069, "chapter_id": 23179, "verse_number": "४-११५-७०", "content_sanskrit": "कंसं निहत्याधर्मिष्ठो भ्रातरं मातुरेव च ।\nजग्राह तस्य सर्वस्वं परं किं कथयामि ते ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003179070, "chapter_id": 23179, "verse_number": "४-११५-७१", "content_sanskrit": "जत्वा च भल्लुकं युद्धे जग्राह तस्य कन्यकाम् ।\nतत्पितुर्भगिनी कुन्ती चतुर्णां कामिनी भुवि ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003179071, "chapter_id": 23179, "verse_number": "४-११५-७२", "content_sanskrit": "द्रौपदी भ्रातृपत्नी च प़ञ्चानां कामिनी तथा ।\nगोष्ठीनो योनिलुब्धश्च शश्वत्परमलम्पटः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003179072, "chapter_id": 23179, "verse_number": "४-११५-७३", "content_sanskrit": "तज्ज्येष्ठो बरदेवश्च शश्वत्पिबति वारुणीम् ।\nयमुनां भ्रातृपत्नीं च करोत्याह्वानमीप्सितम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003179073, "chapter_id": 23179, "verse_number": "४-११५-७४", "content_sanskrit": "जहार भगिनीं तस्य कौःतेयः शक्रनन्दनः ।\nसुभद्रां मातुलसुतां संनिबोध कुलक्रमम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003179074, "chapter_id": 23179, "verse_number": "४-११५-७५", "content_sanskrit": "बाणस्य वचनं श्रुत्वा चुकोप कामनन्दनः ।\nउवाच परमार्थं च योग्यं प्रत्युत्तरं मुने ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003179075, "chapter_id": 23179, "verse_number": "४-११५-७६", "content_sanskrit": "अनिरुद्ध उवाच ।\nपिता मे कामदेवश्च ब्रह्मपुत्रः पुरा शुचिः ।\nयस्यास्त्रेण वशीभूतं त्रैलोक्यं सततं शृणु ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003179076, "chapter_id": 23179, "verse_number": "४-११५-७७", "content_sanskrit": "शिवकोपानलेनैव भस्मीभूतः स्वकर्मतः ।\nकृष्णस्य पुत्रोऽप्यधुना सर्वेषां परमात्मनः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003179077, "chapter_id": 23179, "verse_number": "४-११५-७८", "content_sanskrit": "पतिव्रता रतिर्माता पतिशोकेन सांप्रतम् ।\nशम्बरस्य गृहे तस्थौ हृता तेन बलेन च ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003179078, "chapter_id": 23179, "verse_number": "४-११५-७९", "content_sanskrit": "छायां मायावतीं दत्त्वा मायया शयनेन च ।\nरतिं स्वधर्म संरक्ष्य धर्मसाक्षी च तद्गृहे ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003179079, "chapter_id": 23179, "verse_number": "४-११५-८०", "content_sanskrit": "निहत्य शम्बरं शत्रुं गृहीत्वा स्वप्रियां सतीम् ।\nआजगाम द्वारकां च चन्द्रसुर्यौ च साक्षिणौ ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003179080, "chapter_id": 23179, "verse_number": "४-११५-८१", "content_sanskrit": "पितामहं वासुदेवं त्वं किं जानामि मूढवत् ।\nयं च सन्तोन जानन्ति वेदाश्चत्वार एव च ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003179081, "chapter_id": 23179, "verse_number": "४-११५-८२", "content_sanskrit": "वासुः सर्वनिवासश्च विश्वानि यस्य लोमसु ।\nतस्य देवः परं ब्रह्म वासुदेव इति स्मृतः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003179082, "chapter_id": 23179, "verse_number": "४-११५-८३", "content_sanskrit": "शंकरं पृच्छ साक्षाच्च यस्य भृत्योऽधुना भवान् ।\nकृष्णभृत्यस्य च बलेः पुत्रोऽसि किंकरात्मजः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003179083, "chapter_id": 23179, "verse_number": "४-११५-८४", "content_sanskrit": "गोकुले वैश्यपुत्रत्वं ब्रूहि त्वं ज्ञानदुर्बल ।\nभोजनं वेदविहितं शश्वत्क्षत्त्रियवैश्ययोः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003179084, "chapter_id": 23179, "verse_number": "४-११५-८५", "content_sanskrit": "द्रोणः प्रजापतिः श्रेष्ठा धरा तस्य प्रिया सती ।\nपुत्रं च तपसा लेभे परमात्मानमीश्वरम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003179085, "chapter_id": 23179, "verse_number": "४-११५-८६", "content_sanskrit": "द्रोणो नन्दो वैश्यराजो यशोदा सा धरा सती ।\nवृषभानसुता राधा सुदाम्नः शापकारणात् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003179086, "chapter_id": 23179, "verse_number": "४-११५-८७", "content_sanskrit": "त्रिंशत्कोटिं च गोपीनां गृहीत्वा भर्तुराज्ञया ।\nपुण्यं च भारतं क्षेत्रं गोलोकादाजगामसा ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003179087, "chapter_id": 23179, "verse_number": "४-११५-८८", "content_sanskrit": "ताभिः सार्ध स रेमे च स्वपत्नीभिर्मुदाऽन्वितः ।\nपाणिं जग्राह राधायाः स्वयं ब्रह्मा पुरोहितः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003179088, "chapter_id": 23179, "verse_number": "४-११५-८९", "content_sanskrit": "गोपकोटिश्च गोलोकादाजगाम् मृदाऽन्विता ।\nतेजसा हरितुल्यास्ते पार्षदप्रवरा हरेः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003179089, "chapter_id": 23179, "verse_number": "४-११५-९०", "content_sanskrit": "गोरक्षणं हरेरेव गोपवेषस्य चाऽऽत्मनः ।\nगोपानां शिशुरक्षार्थं मायेशस्यापि मायया ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003179090, "chapter_id": 23179, "verse_number": "४-११५-९१", "content_sanskrit": "पूतना बलिकन्या च भगिनी च तवासुर ।\nदृष्ट्वा च वामनं विन्ध्या चकार पुत्रमानसम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003179091, "chapter_id": 23179, "verse_number": "४-११५-९२", "content_sanskrit": "एवंभूतो यदि मम पुत्रो भवति सांप्रतम् ।\nस्तनं ददामि तनयं कृत्वा वक्षसि सुन्दरम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003179092, "chapter_id": 23179, "verse_number": "४-११५-९३", "content_sanskrit": "तस्याःपूर्णं मानसं च चकार भगवान्प्रभुः ।\nस्तनं दत्त्वा च गोलोकं ययौ सा रत्नयानतः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003179093, "chapter_id": 23179, "verse_number": "४-११५-९४", "content_sanskrit": "कुब्जा सा भगिनी पूर्वं रावणस्य दुरात्मनः ।\nश्रीरामं चकमे कामान्नाम्ना शूर्पणखा सती ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003179094, "chapter_id": 23179, "verse_number": "४-११५-९५", "content_sanskrit": "नासां चिच्छेद तस्याश्च लक्ष्मणो धार्मिकेश्वरः ।\nतपसा च वरं लेभे ब्रह्मणः प्रियमीश्वरम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003179095, "chapter_id": 23179, "verse_number": "४-११५-९६", "content_sanskrit": "तेन पुण्येन तंलब्ध्वा गोलोकं सा जगाम ह ।\nगोपी बभूव गोलोके कृष्णस्याऽऽलिङ्गनेन च ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003179096, "chapter_id": 23179, "verse_number": "४-११५-९७", "content_sanskrit": "नरको हरिवध्यश्च स्वपूर्वप्राक्तनेन च ।\nपाणिं जग्राह कन्यानां साक्षिणौ शशिभास्करौ ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003179097, "chapter_id": 23179, "verse_number": "४-११५-९८", "content_sanskrit": "भीष्मकन्या महालक्ष्मीः शीकृष्णस्य प्रिया सती ।\nवैकुण्ठादागता साध्वी ब्रह्मणोऽनृमतेन च ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003179098, "chapter_id": 23179, "verse_number": "४-११५-९९", "content_sanskrit": "सत्राजितस्य कन्या सा सत्यभामा वसुंधर ।\nददौ कृष्णाय राजा स तं मणिं यौतुकेन च ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003179099, "chapter_id": 23179, "verse_number": "४-११५-१००", "content_sanskrit": "भुवो भारावतरणहेतुना गमनं हरेः ।\nसंजहार भुवो भारं कुरुपाण्डवयुद्धतः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003179100, "chapter_id": 23179, "verse_number": "४-११५-१०१", "content_sanskrit": "शिशुपालो दन्तवक्त्रो जयो विजय एव च ।\nद्वारिणौ द्वारषट्के च वैकुण्ठे श्रीहरेरपि ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003179101, "chapter_id": 23179, "verse_number": "४-११५-१०२", "content_sanskrit": "कुमारशापात्पतितौ प्राप्य जन्मत्रयं ध्रुवम् ।\nहिरण्यकशिपुश्चैव तवैव पूर्वपूरुषः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003179102, "chapter_id": 23179, "verse_number": "४-११५-१०३", "content_sanskrit": "तस्य भ्राता हिरण्याक्षस्तेनैव वरुणो जितः ।\nहरिर्नृसिंहरूपेण तं जघानावलीलया ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003179103, "chapter_id": 23179, "verse_number": "४-११५-१०४", "content_sanskrit": "सूकरेण हतोऽन्यश्च पूर्वजन्मकथां शृणु ।\nद्वितीये जन्मनि पुरा रावणः कुम्भकर्णकः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003179104, "chapter_id": 23179, "verse_number": "४-११५-१०५", "content_sanskrit": "श्रीरामेण हतौ तौ द्वौ शेषजन्म कलौ तयोः ।\nश्रीकृष्णेन हतौ तौ द्वौ धर्मपुत्रावुभौ तथा ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003179105, "chapter_id": 23179, "verse_number": "४-११५-१०६", "content_sanskrit": "जरासंधश्च शाल्वश्च दुरात्मा कंस एव च ।\nप्राक्तनात्तस्य वध्यास्ते भुवो भारजिहीर्षया ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003179106, "chapter_id": 23179, "verse_number": "४-११५-१०७", "content_sanskrit": "मांधातुः सुतमध्ये च यवनश्चापि प्राक्तनात् ।\nलक्ष्मीश्वरस्य कृष्णस्य धनेन किं प्रयोजनमा ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003179107, "chapter_id": 23179, "verse_number": "४-११५-१०८", "content_sanskrit": "प्रतिज्ञया च सत्यायाः पुण्यकव्रतकारणात् ।\nपारिजातं समनीय चकार स्वात्मनो व्रतम् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003179108, "chapter_id": 23179, "verse_number": "४-११५-१०९", "content_sanskrit": "स्वयं जाम्बवती देवी दुर्गांशा भल्लुकात्मजा ।\nपाणिं जग्राह तस्याश्च तपसा भारते हरिः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003179109, "chapter_id": 23179, "verse_number": "४-११५-११०", "content_sanskrit": "कुन्त्याश्च क्षेत्रजाः पुत्राः केवलं भर्तुराज्ञया ।\nकलौ निषिद्धं त्रियुगे प्रसिद्धं पलपैतृकम् ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003179110, "chapter_id": 23179, "verse_number": "४-११५-१११", "content_sanskrit": "युधिष्ठिरो धर्मपुत्रो भीमश्च पवनात्मजः ।\nमहेन्द्रपुत्रो धर्मिष्ठः फाल्गुनो विजयी भुवि ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003179111, "chapter_id": 23179, "verse_number": "४-११५-११२", "content_sanskrit": "यस्मै पाशुपतं शंभुः प्रददौ च स्वयं पुरा ।\nअश्वमेधं गवालम्भं संन्यासं पलपैतृकम् ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003179112, "chapter_id": 23179, "verse_number": "४-११५-११३", "content_sanskrit": "देवरेण सुतोत्पत्तिं कलौ पञ्च विवर्जयेत् ।\nद्रौपद्याः पञ्च भर्तारः शंकरस्य वरेण च ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003179113, "chapter_id": 23179, "verse_number": "४-११५-११४", "content_sanskrit": "बलदेवः पुष्पमधु पूतं पिबति नित्यशः ।\nचकार यमुनाह्वानं स्नानार्थं धार्मिकः शुचिः ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003179114, "chapter_id": 23179, "verse_number": "४-११५-११५", "content_sanskrit": "सुभद्रां च ददौ कृष्णः फाल्गुनाय महात्मने ।\nकन्यकां मातुलानां च दाक्षिणात्यः परिग्रहः ॥११५", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003179115, "chapter_id": 23179, "verse_number": "४-११५-११६", "content_sanskrit": "देशेष्वन्येषु दोषोऽयमित्याह कमलोद्भवः ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}]