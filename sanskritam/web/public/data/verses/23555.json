[{"id": 7003555000, "chapter_id": 23555, "verse_number": "१९५-१", "content_sanskrit": "अथ यमलोकस्थपापिवर्णनम् ।\nनाचिकेत उवाच ।\nकथ्यमानं मया विप्राः शृण्वन्तु तपसि स्थिताः ।\nनमश्च तस्मै देवाय धर्मराजाय धीमते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003555001, "chapter_id": 23555, "verse_number": "१९५-२", "content_sanskrit": "संसारं तु यथाशक्ति कथ्यमानं निबोधत ।\nअसत्यवादिनो ये च जन्तुस्त्रीबालघातकाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003555002, "chapter_id": 23555, "verse_number": "१९५-३", "content_sanskrit": "तथा ब्रह्महणः पापा ये च विश्वासघातकाः ।\nये ये शठाः कृतघ्नाश्च लोलुपाः पारदारिकाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003555003, "chapter_id": 23555, "verse_number": "१९५-४", "content_sanskrit": "कन्यानां दूषका ये च ये च पापरता नराः ।\nवेदानां दूषकाश्चैव वेदमार्गविहिंसकाः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003555004, "chapter_id": 23555, "verse_number": "१९५-५", "content_sanskrit": "शूद्राणां याजकाश्चैव हाहाभूता द्विजातयः ।\nअयाज्ययाजकाश्चैव ये ये कुष्ठयुता नराः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003555005, "chapter_id": 23555, "verse_number": "१९५-६", "content_sanskrit": "सुरापो ब्रह्महा चैव यो द्विजो वीरघातकः ।\nतथा वार्धुषिका ये च जिह्मप्रेक्षाश्च ये नराः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003555006, "chapter_id": 23555, "verse_number": "१९५-७", "content_sanskrit": "मातृत्यागी पितृत्यागी यः स्वसाध्वीं परित्यजेत् ।\nगुरुद्वेषी दुराचारो दूताश्चाव्यक्तभाषिणः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003555007, "chapter_id": 23555, "verse_number": "१९५-८", "content_sanskrit": "गृहक्षेत्रहरा ये च सेतुबन्धविनाशकाः।\nअपुत्राश्चाप्यदाराश्च श्रद्धया च विवर्जिताः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003555008, "chapter_id": 23555, "verse_number": "१९५-९", "content_sanskrit": "अशौचा निर्दयाः पापा हिंसका व्रतभञ्जकाः ।\nसोमविक्रयिणश्चैव स्त्रीजितः सर्वविक्रयी ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003555009, "chapter_id": 23555, "verse_number": "१९५-१०", "content_sanskrit": "भूम्यामनृतवादी च वेदजीवी च यो द्विजः ।\nनक्षत्री च निमित्ती च चाण्डालाध्यापकस्तथा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003555010, "chapter_id": 23555, "verse_number": "१९५-११", "content_sanskrit": "सर्वमैथुनकर्ता च अगम्यागमने रतः ।\nमायिका रतिकाश्चैव तुलाधाराश्च ये नराः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003555011, "chapter_id": 23555, "verse_number": "१९५-१२", "content_sanskrit": "सर्वपापसुसङ्गाश्च चिन्तका येऽतिवैरिणः ।\nस्वाम्यर्थे न हता ये च ये च युद्धपराङ्मुखाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003555012, "chapter_id": 23555, "verse_number": "१९५-१३", "content_sanskrit": "परवित्तापहारी च राजघाती च यो नरः ।\nअशक्तः पापघोषश्च तथा ये ह्यग्निजीविनः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003555013, "chapter_id": 23555, "verse_number": "१९५-१४", "content_sanskrit": "शुश्रूषया च मुक्ता ये लिङ्गिनः पापकर्मिणः।\nपात्रकारी चक्रिणश्च नरा ये चाप्यधार्मिकाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003555014, "chapter_id": 23555, "verse_number": "१९५-१५", "content_sanskrit": "देवागारांश्च सत्राणि तीर्थविक्रयिणस्तथा ।\nव्रतविद्वेषिणो ये च तथाऽसद्वादिनो नराः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003555015, "chapter_id": 23555, "verse_number": "१९५-१६", "content_sanskrit": "मिथ्या च नखरोमाणि धारयन्ति च ये नराः ।\nकूटा वक्रस्वभावाश्च कूटशासनकारिणः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003555016, "chapter_id": 23555, "verse_number": "१९५-१७", "content_sanskrit": "अज्ञानादव्रती यश्च यश्चाश्रमबहिष्कृतः ।\nविप्रकीर्णप्रतिग्राही सूचकस्तीर्थनाशकः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003555017, "chapter_id": 23555, "verse_number": "१९५-१८", "content_sanskrit": "कलही च प्रतर्क्यश्च निष्ठुरश्च नराधमः ।\nएते चान्ये च बहवो ह्यनिर्दिष्टाः सहस्रशः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003555018, "chapter_id": 23555, "verse_number": "१९५-१९", "content_sanskrit": "स्त्रियो नराश्च गच्छन्ति यत्र तच्छृणुतामलाः ।\nकुर्वन्तीह यथा सर्वे तत्र गत्वा यमालये ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003555019, "chapter_id": 23555, "verse_number": "१९५-२०", "content_sanskrit": "तानि वै कथयिष्यामि श्रूयतां द्विजसत्तमाः ।\nवैशम्पायन उवाच ।\nएवं तस्य वचः श्रुत्वा सर्व एव तपोधनाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003555020, "chapter_id": 23555, "verse_number": "१९५-२१", "content_sanskrit": "पप्रच्छुर्विस्मयाविष्टा नाचिकेतमृषिं तदा ।\nऋषय ऊचुः ।\nत्वया सर्वं यथा दृष्टं ब्रूहि तत्र विदां वर ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003555021, "chapter_id": 23555, "verse_number": "१९५-२२", "content_sanskrit": "यथास्वरूपः कालोऽसौ येन सर्वं प्रवर्त्तते ।\nइह कर्माणि यः कृत्वा पुरुषो ह्यल्पचेतनः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003555022, "chapter_id": 23555, "verse_number": "१९५-२३", "content_sanskrit": "वारयेत्स तदा तं तु ब्रह्मलोके च स प्रभुः ।\nकल्पान्तं पच्यमानोऽपि दह्यमानोपि वा पुनः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003555023, "chapter_id": 23555, "verse_number": "१९५-२४", "content_sanskrit": "न नाशो हि शरीरस्य तस्मिन्देशे तपोधनाः ।\nयस्य यस्य हि यत्कर्म पच्यमानः पुनः पुनः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003555024, "chapter_id": 23555, "verse_number": "१९५-२५", "content_sanskrit": "अवश्यं चैव गन्तव्यं तस्य पार्श्वं पुनःपुनः ।\nन तु त्रासाद्द्विजः शक्तस्तत्र गन्तुं हि कश्चन ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003555025, "chapter_id": 23555, "verse_number": "१९५-२६", "content_sanskrit": "न गच्छन्ति च ये तत्र दानेन निगमेन च ।\nवैतरण्याश्च यद्रूपं किंतोयं च वहत्यसौ ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003555026, "chapter_id": 23555, "verse_number": "१९५-२७", "content_sanskrit": "रौरवो वा कथं विप्र किंरूपं कूटशाल्मलेः ।\nकीदृशा वा हि ते दूताः किं कार्याः किं पराक्रमाः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003555027, "chapter_id": 23555, "verse_number": "१९५-२८", "content_sanskrit": "किं च किंच तु कुर्वाणाः किंच किंच समाचरन् ।\nन चेतो लभते जन्तुच्छादितं पूर्वतेजसा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003555028, "chapter_id": 23555, "verse_number": "१९५-२९", "content_sanskrit": "धृतिं न लभते किंचित्तैस्तैर्दोषैः सुवासिताः ।\nदोषं सत्यमजानन्तस्तथा मोहेन मोहिताः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003555029, "chapter_id": 23555, "verse_number": "१९५-३०", "content_sanskrit": "बोद्धव्यं नावबुध्यन्ते गुणानां तु गुणोत्तरम् ।\nहाहाभूताश्च चिंतार्त्ताः सर्वदोषसमन्विताः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003555030, "chapter_id": 23555, "verse_number": "१९५-३१", "content_sanskrit": "परं परमजानन्तो रमन्ते कस्य मायया ।\nक्लिश्यन्ते बहवस्तत्र कृत्वा पापमचेतसः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003555031, "chapter_id": 23555, "verse_number": "१९५-३२", "content_sanskrit": "एतत्कथय वत्स त्वं यतः प्रत्यक्षदर्शिवान् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]