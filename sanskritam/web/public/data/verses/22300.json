[{"id": 7002300000, "chapter_id": 22300, "verse_number": "३४५-१", "content_sanskrit": "अग्निरुवाच ।\nशब्दार्थयोरलङ्कारो द्वावलङ्कुरुते समं ।\nएकत्र निहितो हारः स्तनं ग्रीवामिव त्रियाः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002300001, "chapter_id": 22300, "verse_number": "३४५-२", "content_sanskrit": "प्रशस्तिः कान्तिरौचित्यं संक्षेपो यावदर्थता ।\nअबिव्यक्तिरिति व्यक्तं षड्भेदास्तस्य जाग्रति ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002300002, "chapter_id": 22300, "verse_number": "३४५-३", "content_sanskrit": "प्रशस्तिः परवन्मर्म्मद्रवीकरणकर्म्मणः ।\nवाचो युक्तिर्द्विधा सा च प्रेमोक्तिस्तुतिभेदतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002300003, "chapter_id": 22300, "verse_number": "३४५-४", "content_sanskrit": "प्रेमोक्तिस्तुतिपर्य्यायौ प्रियोक्तिगुणकीर्त्तने ।\nकान्तिः सर्व्वमनोरुच्यवाच्यवाचकसङ्गतिः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002300004, "chapter_id": 22300, "verse_number": "३४५-५", "content_sanskrit": "यथा वस्तु तथा रीतिर्यथा वृत्तिस्तथा रसः ।\nउर्ज्जस्विमृदुसन्दर्भादौचित्यमुपजायते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002300005, "chapter_id": 22300, "verse_number": "३४५-६", "content_sanskrit": "संक्षेणो वाचकैरस्पैर्वहोरर्थस्य संग्रहः ।\nअन्यूनाधिकता शब्दवस्तुनोर्यावदर्थता ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002300006, "chapter_id": 22300, "verse_number": "३४५-७", "content_sanskrit": "प्रकटत्वमभिव्यक्तिः श्रुतिराक्षेप इत्यपि ।\nतस्या भेदौ श्रुतिस्तत्र शब्दं स्वार्थसमर्पणम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002300007, "chapter_id": 22300, "verse_number": "३४५-८", "content_sanskrit": "भवेन्नैमित्तिकी पारिभाषिकी द्विविधैव सा ।\nसङ्केतः परिभाषेति ततः स्यात् पारिभाषिकी ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002300008, "chapter_id": 22300, "verse_number": "३४५-९", "content_sanskrit": "मुख्यौपचारिकी चेति सा च सा च द्विधा द्विधा ।\nस्वाभिधेयस्खलद्वृत्तिरमुख्यार्थस्य वाचकः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002300009, "chapter_id": 22300, "verse_number": "३४५-१०", "content_sanskrit": "यया शब्दो निमित्तेन केनचित्सौपचारिकी ।\nसा च लाक्षणिकी गौणी लक्षणागुणयोगतः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002300010, "chapter_id": 22300, "verse_number": "३४५-११", "content_sanskrit": "अभिधेयाविनाभूता प्रतीतिर्ल्लक्षणोच्यते ।\nअभिधेयेन सम्बन्धात्सामीप्यात्समवायतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002300011, "chapter_id": 22300, "verse_number": "३४५-१२", "content_sanskrit": "वैपरीत्यात्क्रियायोगाल्लक्षणा पञ्चधा मता ।\nगौणीगुणानामानन्त्यादनन्ता तद्विवक्षया ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002300012, "chapter_id": 22300, "verse_number": "३४५-१३", "content_sanskrit": "अन्यधर्म्मस्ततोऽन्यत्र लोकसीमानुरोधिना ।\nसम्यगाधीयते यत्र स समाधिरिह स्मृतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002300013, "chapter_id": 22300, "verse_number": "३४५-१४", "content_sanskrit": "श्रुतेरलभ्यमानोऽर्थो यस्माद्भाति सचेतनः ।\nस आक्षएपो ध्वनिः स्याच्च ध्वनिना व्यज्यते यतः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002300014, "chapter_id": 22300, "verse_number": "३४५-१५", "content_sanskrit": "शब्देनार्थेन यत्रार्थः कृत्वा स्वयमुपार्जनम् ।\nप्रतिषेध इवेष्टस्य यो विशेषोऽभिधित्सया ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002300015, "chapter_id": 22300, "verse_number": "३४५-१६", "content_sanskrit": "तमाक्षेपं ब्रुवन्त्यत्र स्तुतं स्तोत्रमिदं पुनः ।\nअधिकारादपेतस्य वस्तुनोऽन्यस्य या स्तुतिः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002300016, "chapter_id": 22300, "verse_number": "३४५-१७", "content_sanskrit": "यत्रोक्तं गम्यते नार्थस्तत्समानविशेषणं ।\nसा समासोक्तिरुदिता सङ्क्षेपार्थतया बुधैः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002300017, "chapter_id": 22300, "verse_number": "३४५-१८", "content_sanskrit": "अपह्नुतिरपह्नुत्य किञ्चिदन्यार्थसूचनम् ।\nपर्य्यायोक्तं यदन्येन प्रकारेणाभिधीयते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002300018, "chapter_id": 22300, "verse_number": "३४५-१९", "content_sanskrit": "एषामेकंतमस्येव समाख्या ध्वनिरित्यतः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]