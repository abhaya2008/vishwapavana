[{"id": 7003001000, "chapter_id": 23001, "verse_number": "२-४८-१", "content_sanskrit": "नारद उवाच ।\nनारायण महाभाग नारायणपरायण ।\nनारायणांश भगवन्ब्रूहि नारायणीं कथाम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003001001, "chapter_id": 23001, "verse_number": "२-४८-२", "content_sanskrit": "श्रुतं सुरभ्युपाख्यानमतीव सुमनोहरम् ।\nगोप्यं सर्वपुराणेषु पुराविद्भिः प्रशंसितम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003001002, "chapter_id": 23001, "verse_number": "२-४८-३", "content_sanskrit": "अधुना श्रोतुमिच्छामि राधिकाख्यानमुत्तमम् ।\nतदुत्पत्तिं च तद्ध्यानं स्तोत्रं कवचमुत्तमम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003001003, "chapter_id": 23001, "verse_number": "२-४८-४", "content_sanskrit": "श्रीनारायण उवाच ।\nपुरा कैलासशिखरे भगवन्तं सनातनम् ।\nसिद्धेशं सिद्धिदं सर्वस्वरूपं शंकरं परम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003001004, "chapter_id": 23001, "verse_number": "२-४८-५", "content_sanskrit": "प्रफुल्लवदनं प्रीतं सस्मितं मुनिभिः स्तुतम् ।\nकुमाराय प्ररोचन्तं कृष्णस्य परमात्मनः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003001005, "chapter_id": 23001, "verse_number": "२-४८-६", "content_sanskrit": "रासोत्सवरसाख्यानं रासमण्डलवर्णनम् ।\nतदाख्यानावसाने च प्रस्तावावसरे सती ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003001006, "chapter_id": 23001, "verse_number": "२-४८-७", "content_sanskrit": "पप्रच्छ पार्वती स्फीता सस्मिता प्राणवल्लभम् ।\nस्तवनं कुर्वती भीता प्राणेशेन प्रसादिता  ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003001007, "chapter_id": 23001, "verse_number": "२-४८-८", "content_sanskrit": "प्रोवाच तं महादेवं महादेवी सुरेश्वरी ।\nअपूर्वं राधिकाख्यानं पुराणेषु सुदुर्लभम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003001008, "chapter_id": 23001, "verse_number": "२-४८-९", "content_sanskrit": "श्रीपार्वत्युवाच ।\nआगमं निखिलं नाथ श्रुतं सर्वमनुत्तमम् ।\nपाञ्चरात्रादिकं नीतिशास्त्रयोगं च योगिनाम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003001009, "chapter_id": 23001, "verse_number": "२-४८-१०", "content_sanskrit": "सिद्धानां सिद्धिशास्त्रं च नानातन्त्रं मनोहरम् ।\nभक्तानां भक्तिशास्त्रं च कृष्णस्य परमात्मनः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003001010, "chapter_id": 23001, "verse_number": "२-४८-११", "content_sanskrit": "देवीनामपि सर्वासां चरितं त्वन्मुखाम्बुजात् ।\nअधुना श्रोतुमिच्छामि राधिकाख्यानमुत्तमम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003001011, "chapter_id": 23001, "verse_number": "२-४८-१२", "content_sanskrit": "श्रुतौ श्रुतं प्रशस्तं च राधायाश्च समासतः ।\nत्वन्मुखात्काण्वशाखाया व्यासेनोक्तां वदाधुना ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003001012, "chapter_id": 23001, "verse_number": "२-४८-१३", "content_sanskrit": "आगमाख्यानकाले च भवता स्वीकृतं पुरा ।\nनहीश्वरव्याहृतिश्च मिथ्या भवितुमर्हति ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003001013, "chapter_id": 23001, "verse_number": "२-४८-१४", "content_sanskrit": "तदुत्पतिं   च तद्ध्यानं नाम्नो माहात्म्यमुत्तमम् ।\nपूजाविधानं चरितं स्तोत्रं कवचमुत्तमम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003001014, "chapter_id": 23001, "verse_number": "२-४८-१५", "content_sanskrit": "आराधनविधानं च पूजापद्धतिमीप्सिताम् ।\nसाम्प्रतं ब्रूहि भगवन्मां भक्तां भक्तवत्सल ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003001015, "chapter_id": 23001, "verse_number": "२-४८-१६", "content_sanskrit": "कथं न कथितं पूर्वमागमाख्यानकालतः ।\nपार्वतीवचनं श्रुत्वा नम्रवक्त्रो बभूव सः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003001016, "chapter_id": 23001, "verse_number": "२-४८-१७", "content_sanskrit": "पञ्चवक्त्रश्च भगवाञ्छुष्ककण्ठोष्ठतालुकः ।\nस्वसत्यभङ्गभीतश्च मौनीभूय विचिन्तयन् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003001017, "chapter_id": 23001, "verse_number": "२-४८-१८", "content_sanskrit": "सस्मार कृष्णं ध्यानेनाभीष्टदेवं कृपानिधिम् ।\nतदनुज्ञां च संप्राप्य स्वार्द्धाङ्गां तामुवाच सः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003001018, "chapter_id": 23001, "verse_number": "२-४८-१९", "content_sanskrit": "निषिद्धोऽहं भगवता कृष्णेन परमात्मना ।\nआगमारम्भसमये राधाख्यानप्रसंगतः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003001019, "chapter_id": 23001, "verse_number": "२-४८-२०", "content_sanskrit": "मदर्द्धांगस्वरूपा त्वं न मद्भिन्ना स्वरूपतः ।\nअतोऽनुज्ञां ददौ कृष्णो मह्यं वक्तुं महेश्वरि ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003001020, "chapter_id": 23001, "verse_number": "२-४८-२१", "content_sanskrit": "मदिष्टदेवकान्ताया राधायाश्चरितं सति ।\nअतीव गोपनीयं च सुखदं कृष्णभक्तिदम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003001021, "chapter_id": 23001, "verse_number": "२-४८-२२", "content_sanskrit": "जानामि तदहं दुर्गे सर्वं पूर्वापरं वरम् ।\nयज्जानामि रहस्यं च न तद्ब्रह्मा फणीश्वरः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003001022, "chapter_id": 23001, "verse_number": "२-४८-२३", "content_sanskrit": "न तत्सनत्कुमारश्च न च धर्मः सनातनः ।\nन देवेन्द्रो मुनींद्राश्च सिद्धेन्द्राः सिद्धपुङ्गवाः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003001023, "chapter_id": 23001, "verse_number": "२-४८-२४", "content_sanskrit": "मत्तो बलवती त्वं च प्राणांस्त्यक्तुं समुद्यता ।\nअतस्त्वां गोपनीयं च कथयामि सुरेश्वरि ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003001024, "chapter_id": 23001, "verse_number": "२-४८-२५", "content_sanskrit": "शृणु दुर्गे प्रवक्ष्यामि रहस्यं परमाद्भुतम् ।\nचरितं राधिकायाश्च दुर्लभं च सुपुण्यदम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003001025, "chapter_id": 23001, "verse_number": "२-४८-२६", "content_sanskrit": "पुरा वृन्दावने रम्ये गोलोके रासमण्डले ।\nशतशृंगैकदेशे च मालतीमल्लिकावने ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003001026, "chapter_id": 23001, "verse_number": "२-४८-२७", "content_sanskrit": "रत्नसिंहासने रम्ये तस्थौ तत्र जगत्पतिः ।\nस्वेच्छामयश्च भगवान्बभूव रमणोत्सुकः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003001027, "chapter_id": 23001, "verse_number": "२-४८-२८", "content_sanskrit": "रिरंसोस्तस्य जगतां पत्युस्तन्मल्लिकावने ।\nइच्छया च भवेत्सर्वं तस्य स्वेच्छामयस्य च ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003001028, "chapter_id": 23001, "verse_number": "२-४८-२९", "content_sanskrit": "एतस्मिन्नन्तरे दुर्गे द्विधारूपो बभूव सः ।\nदक्षिणांगं च श्रीकृष्णो वामार्द्धांगा च राधिका ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003001029, "chapter_id": 23001, "verse_number": "२-४८-३०", "content_sanskrit": "बभूव रमणी रम्या रासेशा रमणोत्सुका ।\nअमूल्यरत्नाभरणा रत्नसिंहासनस्थिता ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003001030, "chapter_id": 23001, "verse_number": "२-४८-३१", "content_sanskrit": "वह्निशुद्धांशुकाधाना कोटिपूर्णशशिप्रभा ।\nतप्तकाञ्चनवर्णाभा राजिता च स्वतेजसा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003001031, "chapter_id": 23001, "verse_number": "२-४८-३२", "content_sanskrit": "सस्मिता सुदती शुद्धा शरत्पद्मनिभानना ।\nबिभ्रती कबरीं रम्यां मालतीमाल्यमण्डिताम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003001032, "chapter_id": 23001, "verse_number": "२-४८-३३", "content_sanskrit": "रत्नमालां च दधती ग्रीष्मसूर्य्यसमप्रभाम् ।\nमुक्ताहारेण शुभ्रेण गंगाधारानिभेन च ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003001033, "chapter_id": 23001, "verse_number": "२-४८-३४", "content_sanskrit": "संयुक्तं वर्तुलोत्तुंगं सुमेरु गिरिसन्निभम् ।\nकठिनं सुन्दरं दृश्यं कस्तूरीपत्रचिह्नितम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003001034, "chapter_id": 23001, "verse_number": "२-४८-३५", "content_sanskrit": "मांगल्यं मंगलार्हं च स्तनयुग्मं च बिभ्रती ।\nनितम्बश्रोणिभारार्त्ता नवयौवनसुन्दरी ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003001035, "chapter_id": 23001, "verse_number": "२-४८-३६", "content_sanskrit": "कामातुरः सस्मितां तां ददर्श रसिकेश्वरः ।\nदृष्ट्वा कान्तां जगत्कान्तो बभूव रमणोत्सुकः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003001036, "chapter_id": 23001, "verse_number": "२-४८-३७", "content_sanskrit": "दृष्ट्वा चैनं सुकान्तं च सा दधार हरेः पुरः ।\nतेन राधा समाख्याता पुराविद्भिर्महेश्वरि ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003001037, "chapter_id": 23001, "verse_number": "२-४८-३८", "content_sanskrit": "राधा भजति तं कृष्णं स च तां च परस्परम् ।\nउभयोः सर्वसाम्यं च सदा सन्तो वदन्ति च ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003001038, "chapter_id": 23001, "verse_number": "२-४८-३९", "content_sanskrit": "भवनं धावनं रासे स्मरत्यालिंगनं जपन् ।\nतेन जल्पति संकेतं तत्र राधां स ईश्वरः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003001039, "chapter_id": 23001, "verse_number": "२-४८-४०", "content_sanskrit": "राशब्दोच्चारणाद्भक्तो राति मुक्तिं सुदुर्लभाम् ।\nधाशब्दोच्चारणाद्दुर्गे धावत्येव हरेः पदम्॥ ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003001040, "chapter_id": 23001, "verse_number": "२-४८-४१", "content_sanskrit": "कृष्णवामांशसम्भूता राधा रासेश्वरी पुरा ।\nतस्याश्चांशांशकलया बभूवुर्देवयोषितः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003001041, "chapter_id": 23001, "verse_number": "२-४८-४२", "content_sanskrit": "रा इत्यादानवचनो धा च निर्वाणवाचकः ।\nततोऽवाप्नोति मुक्तिं च तेन राधा प्रकीर्तिता ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003001042, "chapter_id": 23001, "verse_number": "२-४८-४३", "content_sanskrit": "बभूव गोपीसंघश्च राधाया लोमकूपतः ।\nश्रीकृष्णलोमकूपेभ्यो बभूवुः सर्वबल्लवाः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003001043, "chapter_id": 23001, "verse_number": "२-४८-४४", "content_sanskrit": "राधावामांशभागेन महालक्ष्मीर्बभूव सा ।\nतस्याधिष्ठातृदेवी सा गृहलक्ष्मीर्बभूव सा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003001044, "chapter_id": 23001, "verse_number": "२-४८-४५", "content_sanskrit": "चतुर्भुजस्य सा पत्नी देवी वैकुण्ठवासिनी ।\nतदंशा राजलक्ष्मीश्च राजसम्पत्प्रदायिनी ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003001045, "chapter_id": 23001, "verse_number": "२-४८-४६", "content_sanskrit": "तदंशा मर्त्यलक्ष्मीश्च गृहिणां च गृहे गृहे ।\nदीपाधिष्ठातृदेवी च सा चैव गृहदेवता ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003001046, "chapter_id": 23001, "verse_number": "२-४८-४७", "content_sanskrit": "स्वयं राधा कृष्णपत्नी कृष्णवक्षःस्थलस्थिता ।\nप्राणाधिष्ठातृदेवी च तस्यैव परमात्मनः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003001047, "chapter_id": 23001, "verse_number": "२-४८-४८", "content_sanskrit": "आब्रह्मस्तम्बपर्यन्तं सर्वं मिथ्यैव पार्वति ।\nभज सत्यं परं ब्रह्म राधेशं त्रिगुणात्परम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003001048, "chapter_id": 23001, "verse_number": "२-४८-४९", "content_sanskrit": "परं प्रधानं परमं परमात्मानमीश्वरम् ।\nसर्वाद्यं सर्वपूज्यं व निरीहं प्रकृतेः परम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003001049, "chapter_id": 23001, "verse_number": "२-४८-५०", "content_sanskrit": "स्वेच्छामयं नित्यरूपं भक्तानुग्रहविग्रहम् ।\nतद्भिन्नानां च देवानां प्राकृतं रूपमेव च ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003001050, "chapter_id": 23001, "verse_number": "२-४८-५१", "content_sanskrit": "तस्य प्राणाधिका राधा बहुसौभाग्यसंयुता ।\nमहाविष्णोः प्रसूः सा च मूलप्रकृतिरीश्वरी ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003001051, "chapter_id": 23001, "verse_number": "२-४८-५२", "content_sanskrit": "मानिनीं राधिकां सन्तः सेवन्ते नित्यशस्सदा ।\nसुलभं यत्पदाम्भोजं ब्रह्मादीनां सुदुर्लभम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003001052, "chapter_id": 23001, "verse_number": "२-४८-५३", "content_sanskrit": "स्वप्ने राधापदाम्भोजं नहि पश्यन्ति बल्लवाः ।\nस्वयं देवी हरेः क्रोडे छायारूपेण कामिनी ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003001053, "chapter_id": 23001, "verse_number": "२-४८-५४", "content_sanskrit": "स च द्वादशगोपानां रायाणप्रवरः प्रिये ।\nश्रीकृष्णांशश्च भगवान्विष्णुतुल्यपराक्रमः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003001054, "chapter_id": 23001, "verse_number": "२-४८-५५", "content_sanskrit": "सुदामशापात्सा देवी गोलोकादागता महीम् ।\nवृषभानुगृहे जाता तन्माता च कलावती ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]