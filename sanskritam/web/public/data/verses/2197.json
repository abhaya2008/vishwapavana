[{"id": 2054569, "chapter_id": 2197, "verse_number": "७-१२४-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2054570, "chapter_id": 2197, "verse_number": "७-१२४-१", "content_sanskrit": "किं तस्यां मम सेनायां नासन्केचिन्महारथाः।\nये तथा सात्यकिं यान्तं नैवाघ्नन्नाप्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2054571, "chapter_id": 2197, "verse_number": "७-१२४-२", "content_sanskrit": "एको हि समरे कर्म कृतवान्सत्यविक्रमः।\nशक्रतुल्यबलो युद्धे महेन्द्रो दानवेष्विव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2054572, "chapter_id": 2197, "verse_number": "७-१२४-३", "content_sanskrit": "अथवा शून्यमासीत्तद्येन यातः स सात्यकिः।\nहतभूयिष्ठमथवा येन यातः स सात्यकिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2054573, "chapter_id": 2197, "verse_number": "७-१२४-४", "content_sanskrit": "यत्कृतं वृष्णिवीरेण कर्म शंससि मे रणे।\nनैतदुत्सहते कर्तुं कर्म शक्रोऽपि सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2054574, "chapter_id": 2197, "verse_number": "७-१२४-५", "content_sanskrit": "अश्रद्धेयमचिन्त्यं च कर्म तस्य महात्मनः।\nवृष्ण्यन्धकप्रवीरस्य श्रुत्वा मे व्यथितं मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2054575, "chapter_id": 2197, "verse_number": "७-१२४-६", "content_sanskrit": "न सन्ति तस्मात्पुत्रा मे यथा सञ्जय भाषसे।\nएको वै बहुलाः सेनाः प्रामृद्गात्सत्यविक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2054576, "chapter_id": 2197, "verse_number": "७-१२४-७", "content_sanskrit": "कथं च युध्यमानानामपक्रान्ती महात्मनाम्।\nएको बहूनां शैनेयस्तन्ममाचक्ष्व सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2054577, "chapter_id": 2197, "verse_number": "७-१२४-८x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2054578, "chapter_id": 2197, "verse_number": "७-१२४-८", "content_sanskrit": "राजन्सेनासमुद्योगो रथनागाश्वपत्तिमान्।\nअतुल्यस्तव सेनायां युगान्तसदृशोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2054579, "chapter_id": 2197, "verse_number": "७-१२४-९", "content_sanskrit": "आहूतेषु समूहेषु तव सैन्यस्य मानद।\nनास्ति लोके समः कश्चित्समूह इति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2054580, "chapter_id": 2197, "verse_number": "७-१२४-१०", "content_sanskrit": "तत्रव देवास्त्वभाषन्त चारणाश्च समागताः।\nएतदन्ताः समूहा वै भविष्यन्ति महीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2054581, "chapter_id": 2197, "verse_number": "७-१२४-११", "content_sanskrit": "न च वै तादृशो व्यूह आसीत्कश्चिद्विशाम्पते।\nयादृग्जयद्रथवधे द्रोणेन विहितोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2054582, "chapter_id": 2197, "verse_number": "७-१२४-१२", "content_sanskrit": "`उद्धृता पृथिवी नूनं युद्धहेतोः समागतैः।\nइति तत्र जनाश्चाहुर्दृष्टा तां जनसंसदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2054583, "chapter_id": 2197, "verse_number": "७-१२४-१३", "content_sanskrit": "चण्डवातविभिन्नानां समुद्राणामिव स्वनः।\nरणेऽभवद्बलौघानामन्योन्यमभिधावताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2054584, "chapter_id": 2197, "verse_number": "७-१२४-१४", "content_sanskrit": "पार्थिवानां समेतानां बहून्यासन्नरोत्तम।\nत्वद्बले प्राण्डवानां च सहस्राणि शतानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2054585, "chapter_id": 2197, "verse_number": "७-१२४-१५", "content_sanskrit": "संरब्धानां प्रवीराणां समरे दृढकर्मणाम्।\nतत्रासीत्सुमहाशब्दस्तुमुलो रोमहर्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2054586, "chapter_id": 2197, "verse_number": "७-१२४-१६", "content_sanskrit": "`पाण़्डवानां कुरूणां च गर्जतामितरेतरम्।\nक्ष्वेलाः किलकिलाशब्दास्तत्रासन्वै सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2054587, "chapter_id": 2197, "verse_number": "७-१२४-१७", "content_sanskrit": "भेरीशब्दाश्च तुमुला बाणशब्दाश्च भारत।\nअन्योन्यं निघ्नतां चैव नराणां शुश्रुवे स्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2054588, "chapter_id": 2197, "verse_number": "७-१२४-१८", "content_sanskrit": "अथाक्रन्दन्भीसमेनो धृष्टद्युम्नश्च मारिष।\nनकुलः सहदेवश्च धर्मराजश्च पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2054589, "chapter_id": 2197, "verse_number": "७-१२४-१९", "content_sanskrit": "आगच्छत प्रहरत द्रुतं विपरिधावत।\nप्रविष्टावरिसेनां हि वीरौ माधवपाण्डवौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2054590, "chapter_id": 2197, "verse_number": "७-१२४-२०", "content_sanskrit": "यथा सुखेन गच्छेतां जयद्रथवधं प्रति।\nतथा प्रकुरुत क्षिप्रमिति सैन्यान्यचोदयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2054591, "chapter_id": 2197, "verse_number": "७-१२४-२१", "content_sanskrit": "तयोरभावे कुरवः कृतार्थाः स्युर्वयं जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2054592, "chapter_id": 2197, "verse_number": "७-१२४-२२", "content_sanskrit": "`यत्र यातौ महात्मानौ तूर्णं परपुरञ्जयौ।\nते यूयं सहिता भूत्वा तूर्णमेव बलार्णवम्।\nक्षोभयध्वं महावेगाः पवनः सागरं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2054593, "chapter_id": 2197, "verse_number": "७-१२४-२३", "content_sanskrit": "भीमसेनेन ते राजन्पाञ्चाल्येन च नोदिताः।\nआजघ्नुः कौरवान्सङ्ख्ये त्यक्त्वाऽसूनात्मनः प्रियान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2054594, "chapter_id": 2197, "verse_number": "७-१२४-२४", "content_sanskrit": "इच्छन्तो निधनं युद्धे शस्त्रैरुत्तमतेजसः।\nस्वर्गेप्सवो मित्रकार्ये नाभ्यनन्दन्त जीवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2054595, "chapter_id": 2197, "verse_number": "७-१२४-२५", "content_sanskrit": "तथैव तावका राजन्प्रार्थयन्तो महद्यशः।\nआर्यां युद्धे मतिं कृत्वा युद्धायैवावतस्थिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2054596, "chapter_id": 2197, "verse_number": "७-१२४-२६", "content_sanskrit": "तस्मिन्सुतुमुले युद्धे वर्तमाने भयावहे।\nजित्वा सर्वाणि सैन्यानि प्रायात्सात्यकिरर्जुनं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2054597, "chapter_id": 2197, "verse_number": "७-१२४-२७", "content_sanskrit": "कवचानां प्रभास्तत्र सूर्यरश्मिविराजिताः।\nदृष्टीः सङ्ख्ये सैनिकानां प्रतिजघ्नुः समन्ततः।\n`ध्वजशस्त्रप्रतिहता लोकान्समवदीपयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2054598, "chapter_id": 2197, "verse_number": "७-१२४-२८", "content_sanskrit": "चण्डवातोद्धतान्मेघान्विकिरन्रश्मिमानिव।\nतथा तव महत्सैन्यं तद्व्यरोचत तापयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2054599, "chapter_id": 2197, "verse_number": "७-१२४-२९", "content_sanskrit": "सम्प्रहृष्टः स सहसा तव सैन्यार्णवं प्रति।\nलोलयन्सर्वतो गत्वा समुद्रं मकरो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2054600, "chapter_id": 2197, "verse_number": "७-१२४-३०", "content_sanskrit": "तत्र राजन्महानासीत्सङ्ग्रामो भीतिवर्धनः।\nपाण्डवस्य महाबाहो तावकानां च दारुणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2054601, "chapter_id": 2197, "verse_number": "७-१२४-३१", "content_sanskrit": "रुद्रस्याक्रीडसङ्काशः संहारः सर्वदेहिनाम्।\nततः शब्दो महानासीत्प्रायाद्यत्र धनञ्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2054602, "chapter_id": 2197, "verse_number": "७-१२४-३२", "content_sanskrit": "तत्र स्म कदनं घोरं वर्तते पाण्डुपूर्वज।\nअर्जुनस्य महाबाहोस्तावकानां च धन्विनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2054603, "chapter_id": 2197, "verse_number": "७-१२४-३३", "content_sanskrit": "मध्ये भारतसैन्यस्य माधवस्य महारणे।\nद्रोणस्यापि परैः सार्धं व्यूहद्वारे सुदारुणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2054604, "chapter_id": 2197, "verse_number": "७-१२४-३४", "content_sanskrit": "एवमेष क्षयो वृत्तः पृथिव्यां पृथिवीपते।\nक्रुद्धेऽर्जुने तथा द्रोणे सात्वते च महारथे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2054605, "chapter_id": 2197, "verse_number": "७-१२४-३५", "content_sanskrit": "तथा प्रयतमानानां पाण्डवानां महात्मनाम्।\nदुर्योधनो महाराजन्व्यगाहत महद्बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2054606, "chapter_id": 2197, "verse_number": "७-१२४-३६", "content_sanskrit": "स सन्निपातस्तुमुलस्तेषां तस्य च भारत।\nअभवत्सर्वभूतानामभावकरणो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2054607, "chapter_id": 2197, "verse_number": "७-१२४-३७x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2054608, "chapter_id": 2197, "verse_number": "७-१२४-३७", "content_sanskrit": "तथा यातेषु सैन्येषु तथा कृच्छ्रगतः स्वयम्।\nकच्चिद्दुर्योधनः सूत नाकार्षीत्पृष्ठतो रणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2054609, "chapter_id": 2197, "verse_number": "७-१२४-३८", "content_sanskrit": "एकस्य च बहूनां च सन्निपातो महाहवे।\nविशेषतो नरपतेर्विषमः प्रतिभाति मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2054610, "chapter_id": 2197, "verse_number": "७-१२४-३९", "content_sanskrit": "सोऽत्यन्तसुखसंवृद्धो लक्ष्म्या लोकस्य चेश्वरः।\nएको बहून्समासाद्य कच्चिन्नासीत्पराङ्मुखः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2054611, "chapter_id": 2197, "verse_number": "७-१२४-४०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2054612, "chapter_id": 2197, "verse_number": "७-१२४-४०", "content_sanskrit": "राजन्सङ्ग्राममाश्चर्यं तव पुत्रस्य भारत।\nएकस्य बहुभिः सार्धं शृणुष्व गदतो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2054613, "chapter_id": 2197, "verse_number": "७-१२४-४१", "content_sanskrit": "दुर्योधनेन समरे पृतना पाण्डवी रणे।\nनलिनी द्वरिदेनेव समन्तात्प्रतिलोडिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2054614, "chapter_id": 2197, "verse_number": "७-१२४-४२", "content_sanskrit": "ततस्तां प्रहतां सेनां दृष्ट्वा पुत्रेण ते नृप।\nभीमसेनपुरोगास्तं पाञ्चालाः समुपाद्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2054615, "chapter_id": 2197, "verse_number": "७-१२४-४३", "content_sanskrit": "स भीमसेनं दशभिः शरैर्विव्याध पाण्डवम्।\nत्रिभिस्त्रिभिर्यमौ वीरौ धर्मराजं च सप्तभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2054616, "chapter_id": 2197, "verse_number": "७-१२४-४४", "content_sanskrit": "विराटद्रुपदौ षद्भिः शतेन च शिखण्डिनम्।\nधृष्टद्युम्नं च विंशत्या द्रौपदेयांस्त्रिभिस्त्रिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2054617, "chapter_id": 2197, "verse_number": "७-१२४-४५", "content_sanskrit": "शतशश्चापरान्योधान्सद्विपांश्च रथान्रणे।\nशरैरवचकर्तोग्रैः क्रुद्धोऽन्तक इव प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2054618, "chapter_id": 2197, "verse_number": "७-१२४-४६", "content_sanskrit": "न सन्दधद्विमुञ्चन्वा मण्डलीकृतकार्मुकः।\nअदृश्यत रिपून्निघ्नञ्छिक्षयाऽस्तबलेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2054619, "chapter_id": 2197, "verse_number": "७-१२४-४७", "content_sanskrit": "तस्य तान्निघ्नतः शत्रून्हेमपृष्ठं महद्धनुः।\nअजस्रं मण्डलीभूतं ददृशुः समरे जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2054620, "chapter_id": 2197, "verse_number": "७-१२४-४८", "content_sanskrit": "ततो युधिष्ठिरो राजा भल्लाभ्यामच्छिनद्धनुः।\nतव पुत्रस्य कौरव्य यतमानस्य संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2054621, "chapter_id": 2197, "verse_number": "७-१२४-४९", "content_sanskrit": "विव्याध चैनं दशभिः सम्यगस्तैः शरोत्तमैः।\nवर्म चाशु समासाद्य ते भित्त्वा क्षितिमाविशन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2054622, "chapter_id": 2197, "verse_number": "७-१२४-५०", "content_sanskrit": "ततः प्रमुदिताः पार्थाः परिवव्रुर्युधिष्ठिरम्।\nयथा वृत्रवधे देवाः पुरा शक्रं महर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2054623, "chapter_id": 2197, "verse_number": "७-१२४-५१", "content_sanskrit": "ततोऽन्यद्धनुरादाय तव पुत्रः प्रतापवान्।\nतिष्ठेतिष्ठेति राजानं ब्रुवन्पाण्डवमभ्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2054624, "chapter_id": 2197, "verse_number": "७-१२४-५२", "content_sanskrit": "तमायान्तमभिप्रेक्ष्य तव पुत्रं महामृधे।\nप्रत्युद्ययुः समुदिताः पाञ्चाला जयगृद्धिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2054625, "chapter_id": 2197, "verse_number": "७-१२४-५३", "content_sanskrit": "तान्द्रोणः प्रतिजग्राह परीप्सन्युधि पाण्डवम्।\nचण्डवातोद्धुतान्मेघान्गिरिरम्बुमुचो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2054626, "chapter_id": 2197, "verse_number": "७-१२४-५४", "content_sanskrit": "तत्र राजन्महानासीत्सङ्ग्रामो रोमहर्षणः।\nपाण्डवानां महाबाहो तावकानां च संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2054627, "chapter_id": 2197, "verse_number": "७-१२४-५५", "content_sanskrit": "रुद्रस्याक्रीडसदृशः संहारः सर्वदेहिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2054628, "chapter_id": 2197, "verse_number": "७-१२४-५६", "content_sanskrit": "ततः शब्दो महानासीद्यातो येन धनञ्जयः।\nअतीव सर्वशब्देभ्यो रोमहर्षकरः प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2054629, "chapter_id": 2197, "verse_number": "७-१२४-५७", "content_sanskrit": "अर्जुनस्य महाबाहो तावकानां च धन्विनाम्।\nमध्ये भारतसैन्यस्य माधवस्य महारणे।\nद्रोणस्यापि परैः सार्धं व्यूहद्वारे महारणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2054630, "chapter_id": 2197, "verse_number": "७-१२४-५८", "content_sanskrit": "एवमेष क्षयो वृत्तः पृथिव्यां पृथिवीपते।\nक्रुद्धेऽर्जुने तथा द्रोणे सात्वते च महारथे॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2054631, "chapter_id": 2197, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि जयद्रथवधपर्वणि चतुर्दशदिवसयुद्धे चतुर्विंशत्यधिकशततमोऽध्यायः॥ १२४ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१२४-९ अनीकेषु समूहेषु इति क.ख.पाठः॥ ५-१२४-३९ लक्ष्म्येति विशेषणे तृतीया॥ ५-१२४-१२५ चतुर्विंशत्यधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]