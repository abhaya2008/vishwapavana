[{"id": 2095633, "chapter_id": 3040, "verse_number": "१३-१७०-१", "content_sanskrit": "युधिष्ठिर उवाच।\nयद्वरं सर्वतीर्थानां तद्ब्रवीहि पितामह।\nयत्र चैव परं शौचं तन्मे व्याख्यातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2095634, "chapter_id": 3040, "verse_number": "१३-१७०-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2095635, "chapter_id": 3040, "verse_number": "१३-१७०-२", "content_sanskrit": "सर्वाणि खलु तीर्थानि गुणवन्ति मनीषिणः।\nयत्तु तीर्थं च शौचं च तन्मे शृणु समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2095636, "chapter_id": 3040, "verse_number": "१३-१७०-३", "content_sanskrit": "अगाधे विमले शुद्धे सत्यतीर्थे धृतिह्रदे।\nस्नातव्यं मानसे तीर्थे सत्वमालम्ब्य शाश्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2095637, "chapter_id": 3040, "verse_number": "१३-१७०-४", "content_sanskrit": "तीर्थशौचं तपो ज्ञानं मार्दवं सत्यमार्जवम्।\nअहिंसा सर्वभूतानामानृशंस्यं दमः शमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2095638, "chapter_id": 3040, "verse_number": "१३-१७०-५", "content_sanskrit": "निर्ममा निरहङ्कारा निर्द्वन्द्वा निष्परिग्रहाः।\nयोगिनस्तीर्थभूतास्ते तीर्थं परममुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2095639, "chapter_id": 3040, "verse_number": "१३-१७०-६", "content_sanskrit": "नारायणेऽथ रुद्रे वा भक्तिस्तीर्थं परं मतम्।\nशौचलक्षणमेतत्ते सर्वत्रैवान्ववेक्षतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2095640, "chapter_id": 3040, "verse_number": "१३-१७०-७", "content_sanskrit": "रजस्तमःसत्वमथो येषां निर्धूतमात्मना।\nतीर्थमाचारशुद्धिश्च स्वमार्गपरिमार्गणम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2095641, "chapter_id": 3040, "verse_number": "१३-१७०-८", "content_sanskrit": "सर्वत्यागेष्वभिरताः सर्वज्ञाः समदर्शिनः।\nशौचष्वेतेष्वभिरतास्ते तीर्थशुचयोऽपि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2095642, "chapter_id": 3040, "verse_number": "१३-१७०-९", "content_sanskrit": "नोदकक्लिन्नगात्रस्तु स्नात इत्यभिधीयते।\nस स्नातो यो दमस्नातः स बाह्याभ्यन्तरः शुचिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2095643, "chapter_id": 3040, "verse_number": "१३-१७०-१०", "content_sanskrit": "अदृष्टेष्वनपेक्षा ये प्राप्तेष्वर्थेषु निर्ममाः।\nशौचमेव परं तेषां येषां नोत्पद्यते स्पृहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2095644, "chapter_id": 3040, "verse_number": "१३-१७०-११", "content_sanskrit": "प्रज्ञानं शौचमेवेह शरीरस्य विशेषतः।\nतथा निष्किंचनत्वं च मनसश्च प्रसन्नता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2095645, "chapter_id": 3040, "verse_number": "१३-१७०-१२", "content_sanskrit": "वृत्तं शौचं महाशौचं तीर्थशौचमतः परम्।\nज्ञानोत्पन्नं च यच्छौचं तच्छौचं परमं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2095646, "chapter_id": 3040, "verse_number": "१३-१७०-१३", "content_sanskrit": "मनसा च प्रदीप्तेन ब्रह्मज्ञानजलेन च।\nस्नाता ये मानसे तीर्थे तज्ज्ञाः क्षेत्रज्ञदर्शनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2095647, "chapter_id": 3040, "verse_number": "१३-१७०-१४", "content_sanskrit": "समारोपितशौचस्तु नित्यं भवसमन्वितः।\nकेवलं गुणसम्पन्नः शुचिरेव नरः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2095648, "chapter_id": 3040, "verse_number": "१३-१७०-१५", "content_sanskrit": "शरीरस्थानि तीर्थानि प्रोक्तान्येतानि भारत।\nपृथिव्यां यानि तीर्थानि पुण्यानि शृणु तान्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2095649, "chapter_id": 3040, "verse_number": "१३-१७०-१६", "content_sanskrit": "शरीरस्य यथोद्देशः शरीरोपरि निर्मिताः।\nतथा पृथिव्या भागाश्च पुण्यानि सलिलानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2095650, "chapter_id": 3040, "verse_number": "१३-१७०-१७", "content_sanskrit": "कीर्तनाच्चैव तीर्थस्य स्नानाच्च पितृतर्पणात्।\nशोध्यं हि पातकं तीर्थे पूता यान्ति सुखं दिवम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2095651, "chapter_id": 3040, "verse_number": "१३-१७०-१८", "content_sanskrit": "परिग्रहाच्च साधूनां पृथिव्याश्चैव तेजसा।\nअतीव पुण्यभागास्ते सलिलस्य च तेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2095652, "chapter_id": 3040, "verse_number": "१३-१७०-१९", "content_sanskrit": "मनसश्च पृथिव्याश्च पुण्यास्तीर्थास्तथापरे।\nउभयोरेव यः स्नायात्स सिद्धिं शीघ्रमाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2095653, "chapter_id": 3040, "verse_number": "१३-१७०-२०", "content_sanskrit": "यथा फलं क्रियाहीनं क्रिया वा फलवर्जिता।\nनेह साधयते कार्यं समायुक्ता तु सिध्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2095654, "chapter_id": 3040, "verse_number": "१३-१७०-२१", "content_sanskrit": "एवं शरीरशौचेन तीर्थशौचेन चान्वितः।\nशुचिः सिद्धिमवाप्नोति द्विविधं शौचमुत्तमम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2095655, "chapter_id": 3040, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि सप्तत्यधिकशततमोऽध्यायः॥ १७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]