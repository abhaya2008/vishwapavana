[{"id": 2096806, "chapter_id": 3076, "verse_number": "१३-२०६-१", "content_sanskrit": "नारद उवाच।\nक्षणज्ञा देवदेवस्य श्रोतुकामा प्रियं हितम्।\nउमादेवी महादेवमपृच्छत्पुनरेव तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2096807, "chapter_id": 3076, "verse_number": "१३-२०६-२", "content_sanskrit": "भगवन्देवदेवेश सर्वदेवनमस्कृत।\nचतुर्मुखो वै भगवानभवत्केन हेतुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2096808, "chapter_id": 3076, "verse_number": "१३-२०६-३", "content_sanskrit": "भगवन्केन ते वक्त्रमैन्द्रमद्भुतदर्शनम्।\nउत्तरं चापि भगवन्पश्चिमं शुभदर्शनम्।\nदक्षिणं च मुखं रौद्रं केनोर्ध्वं जटिलावृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2096809, "chapter_id": 3076, "verse_number": "१३-२०६-४", "content_sanskrit": "यथादृशं महाभाग श्रोतुमिच्छामि कारणम्।\nएष मे संशयो देव तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2096810, "chapter_id": 3076, "verse_number": "१३-२०६-५x", "content_sanskrit": "महादेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2096811, "chapter_id": 3076, "verse_number": "१३-२०६-५", "content_sanskrit": "तदहं ते प्रवक्ष्यामि यत्त्वमिच्छसि भामिनि।\nपुराऽसुरो महाघोरौ लोकोद्वेगकरौ भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2096812, "chapter_id": 3076, "verse_number": "१३-२०६-६", "content_sanskrit": "सुन्दोपसुन्दनामानावासतुर्बलगर्वितौ।\nअशस्त्रवध्यौ बलिनौ परस्परहितैषिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2096813, "chapter_id": 3076, "verse_number": "१३-२०६-७", "content_sanskrit": "तयोरेव विनाशाय निर्मिता विश्वकर्मणा।\nसर्वतः सारमुद्धृत्य तिलशो लोकपूजिता।\nतिलोत्तमेति विख्याता अप्सराः सा बभूव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2096814, "chapter_id": 3076, "verse_number": "१३-२०६-८", "content_sanskrit": "देवकार्यं करिष्यन्ती हासभावसमन्विता।\nसा तपस्यन्तमागम्य रूपेणाप्रतिमा भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2096815, "chapter_id": 3076, "verse_number": "१३-२०६-९", "content_sanskrit": "मया बहुमता चेयं देवकार्यं करिष्यति।\nइति मत्वा तदा चाहं कुर्वन्तीं मां प्रदक्षिणम्।\nतथैव तां दिदृक्षुश्च चतुर्वक्त्रोऽभवं प्रिये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2096816, "chapter_id": 3076, "verse_number": "१३-२०६-१०", "content_sanskrit": "ऐन्द्रं मुखमिदं पूर्वं तपश्चर्यापरं सदा।\nदक्षिणं मे मुखं दिव्यं रौद्रं संहरति प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2096817, "chapter_id": 3076, "verse_number": "१३-२०६-११", "content_sanskrit": "लोककार्यपरं नित्यं पश्चिमं मे मुखं प्रिये।\nवेदानधीते सततमद्भुतं चोत्तरं मुखम्।\nएतत्ते सर्वमाख्यातं किं भूयः श्रोतुमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2096818, "chapter_id": 3076, "verse_number": "१३-२०६-१२x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2096819, "chapter_id": 3076, "verse_number": "१३-२०६-१२", "content_sanskrit": "भगवञ्श्रोतुमिच्छामि शूलपाणे वरप्रद।\nकिमर्थं नीलता कण्ठे भाति बर्हिनिभा तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2096820, "chapter_id": 3076, "verse_number": "१३-२०६-१३x", "content_sanskrit": "महेश्वर उवात।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2096821, "chapter_id": 3076, "verse_number": "१३-२०६-१३", "content_sanskrit": "एतत्ते कथयिष्यामि शृणु देवि समाहिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2096822, "chapter_id": 3076, "verse_number": "१३-२०६-१४", "content_sanskrit": "पुरा युगान्तरे यत्नादमृतार्थं सुरासुरैः।\nबलवद्भिर्विमथितश्चिरकालं महोदधिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2096823, "chapter_id": 3076, "verse_number": "१३-२०६-१५", "content_sanskrit": "रज्जुना नागराजेन मथ्यमाने महोदधौ।\nविषं तत्र समुद्भूतं सर्वलोकविनाशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2096824, "chapter_id": 3076, "verse_number": "१३-२०६-१६", "content_sanskrit": "तद्दृष्ट्वा विबुधाः सर्वे तदा विमनसोऽभवन्।\nग्रस्तं हि तन्मया देवि लोकानां हितकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2096825, "chapter_id": 3076, "verse_number": "१३-२०६-१७", "content_sanskrit": "तत्कृता नीलता चासीत्कण्ठे बर्हिनिभा शुभे।\nतदाप्रभृति चैवाहं नीलकण्ठ इति स्मृतः।\nएतत्ते सर्वमाख्यातं किं भूयः श्रोतुमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2096826, "chapter_id": 3076, "verse_number": "१३-२०६-१८x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2096827, "chapter_id": 3076, "verse_number": "१३-२०६-१८", "content_sanskrit": "नीलकण्ठ नमस्तेऽस्तु सर्वलोकसुखावह।\nबहूनामायुधानां त्वं पिनाकं धर्मुमिच्छसि।\nकिमर्थं देवदेवेश तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2096828, "chapter_id": 3076, "verse_number": "१३-२०६-१९x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2096829, "chapter_id": 3076, "verse_number": "१३-२०६-१९", "content_sanskrit": "शस्त्रागमं ते वक्ष्यामि शृणु धर्म्यं शुचिस्मिते।\nयुगान्तरे महादेवि कण्वो नाम महामुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2096830, "chapter_id": 3076, "verse_number": "१३-२०६-२०", "content_sanskrit": "स हि दिव्यां तपश्चर्यां कर्तुमेवोपचक्रमे।\nतथा तस्य तपो घोरं चरतः कालपर्ययात्।\nवल्मीकं पुनरुद्भूतं तस्यैव शिरसि प्रिये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2096831, "chapter_id": 3076, "verse_number": "१३-२०६-२१", "content_sanskrit": "वेणुर्वल्मीकसंयोगान्मूर्ध्नि तस्य बभूव ह।\nधरमाणश्च तत्सर्वं तपश्चर्यां तथाऽकरोत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2096832, "chapter_id": 3076, "verse_number": "१३-२०६-२२", "content_sanskrit": "तस्मै ब्रह्मा वरं दातुं जगाम तपसार्चितः।\nदत्त्वा तस्मै वरं देवो वेणुं दृष्ट्वा त्वचिन्तयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2096833, "chapter_id": 3076, "verse_number": "१३-२०६-२३", "content_sanskrit": "लोककार्यं समुद्दिश्य वेणुनाऽनेन भामिनि।\nचिन्तयित्वा तमादाय कार्मुकार्थे न्ययोजयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2096834, "chapter_id": 3076, "verse_number": "१३-२०६-२४", "content_sanskrit": "विष्णोर्मम च सामर्थ्यं ज्ञात्वा लोकपितामहः।\nधनुषी द्वे तदा प्रादाद्विष्णवे च ममैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2096835, "chapter_id": 3076, "verse_number": "१३-२०६-२५", "content_sanskrit": "पिनाकं नाम मे चापं शार्ङ्गं नाम हरेर्धनुः।\nतृतीयमवशेषेण गाण्डीवमभवद्धनुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2096836, "chapter_id": 3076, "verse_number": "१३-२०६-२६", "content_sanskrit": "तच्च सोमाय निर्दिश्य ब्रह्मा लोकं गतः पुनः।\nएतत्ते सर्वमाख्यातं शस्त्रागममनिन्दिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2096837, "chapter_id": 3076, "verse_number": "१३-२०६-२७x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2096838, "chapter_id": 3076, "verse_number": "१३-२०६-२७", "content_sanskrit": "भगवन्देवदेवेश पिनाकपरमप्रिय।\nवाहनेषु तथाऽन्येषु सत्सु भूतपते तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2096839, "chapter_id": 3076, "verse_number": "१३-२०६-२८", "content_sanskrit": "अयं तु वृषभः कस्माद्वाहनं स यथाऽभवत्।\nएष मे सशयो देव तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2096840, "chapter_id": 3076, "verse_number": "१३-२०६-२९x", "content_sanskrit": "महादेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2096841, "chapter_id": 3076, "verse_number": "१३-२०६-२९", "content_sanskrit": "तदहं ते प्रवक्ष्यामि वाहनं स यथाऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2096842, "chapter_id": 3076, "verse_number": "१३-२०६-३०", "content_sanskrit": "आदिसर्गे पुरा गावः श्वेतवर्णाः शुचिस्मिते।\nबलसंहनना गावो दर्पयुक्ताश्चरन्ति ताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2096843, "chapter_id": 3076, "verse_number": "१३-२०६-३१", "content_sanskrit": "अहं तु तप आतिष्ठं तस्मिन्काले शुभानने।\nएकपादश्चोर्ध्वबाहुर्लोकार्थं हिमवद्गिरौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2096844, "chapter_id": 3076, "verse_number": "१३-२०६-३२", "content_sanskrit": "गावो मे पार्श्वमागम्य दर्पोत्सिक्ताः समन्ततः।\nस्थानभ्रंशं तदा देवि चक्रिरे बहुशस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2096845, "chapter_id": 3076, "verse_number": "१३-२०६-३३", "content_sanskrit": "अपचारेण वै तासां मनःक्षोभोऽभवन्मम।\nतस्माद्दग्धा यदा गावो रोषाविष्टेन चेतसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2096846, "chapter_id": 3076, "verse_number": "१३-२०६-३४", "content_sanskrit": "तस्मिंस्तु व्यसने घोरे वर्तमाने पशून्प्रति।\nअनेन वृषभेणाहं शमितः सम्प्रसादनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2096847, "chapter_id": 3076, "verse_number": "१३-२०६-३५", "content_sanskrit": "तदाप्रभृति शान्ताश्च वर्णभेदत्वमागताः।\nश्वेतोऽयं वृषभो देवि पूर्वसंस्कारसंयुतः।\nवाहनत्वे ध्वजत्वे मे तदाप्रभृति योजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2096848, "chapter_id": 3076, "verse_number": "१३-२०६-३६", "content_sanskrit": "तस्मान्मे गोपतित्वं च देवैर्गोभिश्च कल्पितम्।\nप्रसन्नश्चाभवं देवि तदा गोपतितां गतः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2096849, "chapter_id": 3076, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि षडधिकद्विशततमोऽध्यायः॥ २०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]