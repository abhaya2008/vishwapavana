[{"id": 7005311000, "chapter_id": 25311, "verse_number": "८-२-१", "content_sanskrit": "प्रपद्ये देवमीशानं सर्वज्ञमपराजितम ।\nमहादेवं महात्मानं विश्वस्य जगतः पतिम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005311001, "chapter_id": 25311, "verse_number": "८-२-२", "content_sanskrit": "शक्तिरप्रतिघा यस्य ऐश्वर्यं चैव सर्वशः ।\nस्वामित्वं च विभुत्वं च स्वकृतानि प्रचक्षते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005311002, "chapter_id": 25311, "verse_number": "८-२-३", "content_sanskrit": "तस्मै देवाय सोमाय प्रणम्य प्रयतः शुचिः  ।\nपुराणाख्यानजिज्ञासोर्वदये स्कन्दोद्भवं शुभम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005311003, "chapter_id": 25311, "verse_number": "८-२-४", "content_sanskrit": "देहावतारो देवस्य रुद्रस्य परमात्मनः  ।\nप्राजापत्याभिषेकश्च हरणं शिरसस्तथा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005311004, "chapter_id": 25311, "verse_number": "८-२-५", "content_sanskrit": "दर्शनं षट्कुलीयानां चक्रस्य च विसर्जनम्  ।\nनैमिशस्योद्भवश्चैव सत्त्रस्य च समापनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005311005, "chapter_id": 25311, "verse_number": "८-२-६", "content_sanskrit": "ब्रह्मणश्चागमस्तत्र तपसश्चरणं तथा ।\nशर्वस्य दर्शनं चैव देव्याश्चैव समुद्भवः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005311006, "chapter_id": 25311, "verse_number": "८-२-७", "content_sanskrit": "सत्या विवादश्च तथा दक्षशापस्तथैव च  ।\nमेनायां च यथोत्पत्तिर्यथा देव्याः स्वयंवरम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005311007, "chapter_id": 25311, "verse_number": "८-२-८", "content_sanskrit": "देवानां वरदानं च वसिष्ठस्य च धीमतः  ।\nपराशरस्य चोत्पत्तिर्व्यासस्य च महात्मनः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005311008, "chapter_id": 25311, "verse_number": "८-२-९", "content_sanskrit": "वसिष्ठकौशिकाभ्यां च वैरोद्भवसमापनम्  ।\nवाराणस्याश्च शून्यत्वं क्षेत्रमाहात्म्यवर्णनम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005311009, "chapter_id": 25311, "verse_number": "८-२-१०", "content_sanskrit": "रुद्रस्य चात्र सांनिध्यं नन्दिनश्चाप्यनुग्रहः  ।\nगणानां दर्शनं चैव कथनं चाप्यशेषतः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005311010, "chapter_id": 25311, "verse_number": "८-२-११", "content_sanskrit": "कालीव्याहरणं चैव तपश्चरणमेव च  ।\nसोमनन्दिसमाख्यानं वरदानं तथैव च ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005311011, "chapter_id": 25311, "verse_number": "८-२-१२", "content_sanskrit": "गौरीत्वं पुत्रलम्भश्च देव्या उत्पत्तिरेव च  ।\nकौशिक्या भूतमातृत्वं सिंहाश्च रथिनस्तथा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005311012, "chapter_id": 25311, "verse_number": "८-२-१३", "content_sanskrit": "गौर्याश्च निलयो विन्ध्ये विन्ध्यसूर्यसमागमः ।\nअगस्त्यस्य च माहात्म्यं वधः सुन्दनिसुन्दयोः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005311013, "chapter_id": 25311, "verse_number": "८-२-१४", "content_sanskrit": "निसुम्भसुम्भनिर्याणं महिषस्य वधस्तथा  ।\nअभिषेकश्च कौशिक्या वरदानमथापि च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005311014, "chapter_id": 25311, "verse_number": "८-२-१५", "content_sanskrit": "अन्धकस्य तथोत्पत्तिः पृथिव्याश्चैव बन्धनम्  ।\nहिरण्याक्षवधश्चैव हिरण्यकशिपोस्तथा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005311015, "chapter_id": 25311, "verse_number": "८-२-१६", "content_sanskrit": "बलिसंयमनं चैव देव्याः समय एव च  ।\nदेवानां गमनं चैव अर्दूतत्वमेव च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005311016, "chapter_id": 25311, "verse_number": "८-२-१७", "content_sanskrit": "देवानां वरदानं च शुक्रस्य च विसर्जनम्  ।\nसुतस्य च तथोत्पत्तिर्देव्याश्चान्धकदर्शनम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005311017, "chapter_id": 25311, "verse_number": "८-२-१८", "content_sanskrit": "शैलादिदैत्यसंमर्दो देव्याश्च शतरूपता  ।\nआर्यावरप्रदानं च शैलादिस्तव एव च ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005311018, "chapter_id": 25311, "verse_number": "८-२-१९", "content_sanskrit": "देवस्यागमनं चैव वृत्तस्य कथनं तथा  ।\nपतिव्रतायाश्चाख्यानं गुरुशुश्रूषणस्य च ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005311019, "chapter_id": 25311, "verse_number": "८-२-२०", "content_sanskrit": "आख्यानं पञ्चचूडायास्तेजसश्चाप्यधृष्यता  ।\nदूतस्यागमनं चैव संवादोऽथ विसर्जनम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005311020, "chapter_id": 25311, "verse_number": "८-२-२१", "content_sanskrit": "अन्धकासुरसंवादो मन्दरागमनं तथा ।\nगणानामागमश्चैव संख्यानश्रवणं तथा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005311021, "chapter_id": 25311, "verse_number": "८-२-२२", "content_sanskrit": "निग्रहश्चान्धकस्याथ युद्धेन महता तथा  ।\nशरीरार्धप्रदानं च शोकसुतसंग्रहः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005311022, "chapter_id": 25311, "verse_number": "८-२-२३", "content_sanskrit": "भस्मसोमोद्भवश्चैव श्मशानवसतिस्तथा  ।\nरुद्रस्य नीलकण्ठत्वं तथायतनवर्णनम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005311023, "chapter_id": 25311, "verse_number": "८-२-२४", "content_sanskrit": "उत्पत्तिर्यक्षराजस्य कुबेरस्य च धीमतः ।\nनिग्रहो भुजगेन्द्राणां शिखरस्य च पातनम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005311024, "chapter_id": 25311, "verse_number": "८-२-२५", "content_sanskrit": "त्रैलोक्यस्य सशक्रस्य वशीकरणमेव च  ।\nदेवसेनाप्रदानं च सेनापत्याभिषेचनम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005311025, "chapter_id": 25311, "verse_number": "८-२-२६", "content_sanskrit": "नारदस्यागमश्चैव तारकप्रेषितस्य ह ।\nवधश्च तारकस्योग्रो यात्रा भद्रवटस्य च ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005311026, "chapter_id": 25311, "verse_number": "८-२-२७", "content_sanskrit": "महिषस्य वधश्चैव क्रौञ्चस्य च निबर्हणम्  ।\nशक्तेरुद्धरणं चैव तारकस्य वधः शुभः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005311027, "chapter_id": 25311, "verse_number": "८-२-२८", "content_sanskrit": "देवासुरभयोत्पत्तिस्त्रैपुरं युद्धमेव च  ।\nप्रह्लादविग्रहश्चैव कृतघ्नाख्यानमेव च  ।\nमहाभाग्यं ब्राह्मणानां विस्तरेण प्रकीर्त्यते ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005311028, "chapter_id": 25311, "verse_number": "८-२-२९", "content_sanskrit": "एतज्ज्ञात्वा यथावद्धि कुमारानुचरो भवेत्  ।\nबलवान्मतिसम्पन्नः पुत्रं चाप्नोति संमतम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]