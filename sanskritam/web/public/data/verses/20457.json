[{"id": 7000457000, "chapter_id": 20457, "verse_number": "३-४-१", "content_sanskrit": "ऋषय ऊचुः ।\nमेरोरथोत्तरं पश्चात्पूर्वमाचक्ष्व सूततः ।\nनिखिलेन महाबुद्ध माल्यवंतं च पर्वतम्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000457001, "chapter_id": 20457, "verse_number": "३-४-२", "content_sanskrit": "सूत उवाच ।\nदक्षिणेन तु नीलस्य मेरोः पार्श्वे तथोत्तरे ।\nउत्तराः कुरवो विप्राः पुण्याः सिद्धनिषेविताः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000457002, "chapter_id": 20457, "verse_number": "३-४-३", "content_sanskrit": "तत्र वृक्षा मधुफला नित्यपुष्पफलोपगाः ।\nपुष्पाणि च सुगंधीनि रसवंति फलानि च॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000457003, "chapter_id": 20457, "verse_number": "३-४-४", "content_sanskrit": "सर्वकामफलास्तत्र केचिद्वृत्या द्विजोत्तमाः ।\nअपरे क्षीरिणो नाम वृक्षास्तत्र द्विजोत्तमाः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000457004, "chapter_id": 20457, "verse_number": "३-४-५", "content_sanskrit": "प्रक्षरंति सदा क्षीरं तत्र सर्वेऽमृतोपमम् ।\nवस्त्राणि च प्रसूयंते फलेष्वाभरणानि च॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000457005, "chapter_id": 20457, "verse_number": "३-४-६", "content_sanskrit": "सर्वा मणिमयी भूमिः सूक्ष्मकांचनवालुका ।\nसर्वर्तुसुखसंस्पर्शा निष्फलाश्च तपोधनाः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000457006, "chapter_id": 20457, "verse_number": "३-४-७", "content_sanskrit": "देवलोकच्युताः सर्वे जायंते तत्र मानवाः ।\nशुक्लाभिजनसंपन्नाः सर्वसुप्रियदर्शनाः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000457007, "chapter_id": 20457, "verse_number": "३-४-८", "content_sanskrit": "मिथुनानि च जायंते स्त्रियश्चाप्सरसोपमाः ।\nतेषां ते क्षीरिणां क्षीरं पिबंत्यमृतसंनिभम्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000457008, "chapter_id": 20457, "verse_number": "३-४-९", "content_sanskrit": "मिथुनं जायते काले समंताच्च प्रवर्द्धते ।\nतुल्यरूपगुणोपेतं समवेशं तथैव च॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000457009, "chapter_id": 20457, "verse_number": "३-४-१०", "content_sanskrit": "एकमेवानुरूपं च चक्रवाकसमं द्विजाः ।\nनिरामयाश्च ते लोका नित्यं मुदितमानसाः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000457010, "chapter_id": 20457, "verse_number": "३-४-११", "content_sanskrit": "दशवर्षसहस्राणि दशवर्षशतानि च ।\nजीवंति ते महाभागा न चान्योन्यं जहत्युत॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000457011, "chapter_id": 20457, "verse_number": "३-४-१२", "content_sanskrit": "भारुंडा नाम शकुनास्तीक्ष्णतुंडा महाबलाः ।\nतान्निर्हरंतीहमृतान्दरीषु प्रक्षिपंति च॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000457012, "chapter_id": 20457, "verse_number": "३-४-१३", "content_sanskrit": "उत्तराःकुरवो विप्रा व्याख्यातास्ते समासतः ।\nमेरुपार्श्वमहं पूर्वं प्रवक्ष्यामि यथातथम्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000457013, "chapter_id": 20457, "verse_number": "३-४-१४", "content_sanskrit": "तस्य मूर्द्धाभिषेकस्तु भद्राश्वस्य तपोधनाः ।\nभद्रशालवनं यत्र कालाम्राश्च महाद्रुमाः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000457014, "chapter_id": 20457, "verse_number": "३-४-१५", "content_sanskrit": "कालाम्रास्तु महाभागा नित्यंपुष्पफलाः शुभाः ।\nद्रुमाश्च योजनोत्सेधाः सिद्धचारणसेविताः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000457015, "chapter_id": 20457, "verse_number": "३-४-१६", "content_sanskrit": "तत्र ते पुरुषाः श्वेतास्तेजोयुक्तमहाबलाः ।\nस्त्रियः कुमुदवर्णाश्च सुंदर्यः प्रियदर्शनाः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000457016, "chapter_id": 20457, "verse_number": "३-४-१७", "content_sanskrit": "चंद्रवर्णाश्चतुर्वर्णाः पूर्णचंद्रनिभाननाः ।\nचंद्रशीतलगात्राश्च नृत्यगीतविशारदाः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000457017, "chapter_id": 20457, "verse_number": "३-४-१८", "content_sanskrit": "दशवर्षसहस्राणि तत्रायुर्द्विजसत्तमाः ।\nकालाम्ररसपीतास्ते नित्यं संस्थितयौवनाः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000457018, "chapter_id": 20457, "verse_number": "३-४-१९", "content_sanskrit": "दक्षिणेन तु नीलस्य निषधस्योत्तरेण तु ।\nसुदर्शनो नाम महान्जंबूवृक्षः सनातनः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000457019, "chapter_id": 20457, "verse_number": "३-४-२०", "content_sanskrit": "सर्वकामफलः पुण्यः सिद्धचारणसेवितः ।\nतस्य नाम्ना समाख्यातो जंबूद्वीपः सनातनः॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000457020, "chapter_id": 20457, "verse_number": "३-४-२१", "content_sanskrit": "योजनानां सहस्रं च शतं च द्विजसत्तमाः ।\nतथा माल्यवतः शृंगे पूर्वे पूर्वानुगांतकाः॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000457021, "chapter_id": 20457, "verse_number": "३-४-२२", "content_sanskrit": "योजनानां सहस्राणि पंचाशन्माल्यवान्द्विजाः ।\nमहारजतसंकाशा जायंते तत्र मानवाः॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000457022, "chapter_id": 20457, "verse_number": "३-४-२३", "content_sanskrit": "ब्रह्मलोकच्युताः सर्वे सर्वे च ब्रह्मवादिनः ।\nतपस्तप्यंति ते दिव्यं भवंति ह्यूर्ध्वरेतसः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000457023, "chapter_id": 20457, "verse_number": "३-४-२४", "content_sanskrit": "रक्षणार्थं तु भूतानां प्रविशंति दिवाकरम् ।\nषष्टिस्तानि सहस्राणि षष्टिरेव शतानि च॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000457024, "chapter_id": 20457, "verse_number": "३-४-२५", "content_sanskrit": "अरुणस्याग्रतो यांति परिवार्य दिवाकरम् ।\nषष्टिवर्षसहस्राणि षष्टिरेव शतानि च॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000457025, "chapter_id": 20457, "verse_number": "३-४-२६", "content_sanskrit": "आदित्यतापतप्तास्ते विशंति शशिमंडलम्॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]