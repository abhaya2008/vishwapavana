[{"id": 2048361, "chapter_id": 2066, "verse_number": "६-११५-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2048362, "chapter_id": 2066, "verse_number": "६-११५-१", "content_sanskrit": "कथं शान्तनवो भीष्मो दशमेऽहनि सञ्जय।\nअयुध्यत महावीर्यः पाण्डवैः सह सृज्जयैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2048363, "chapter_id": 2066, "verse_number": "६-११५-२", "content_sanskrit": "कुरवश्च कथं युद्धे पाण्डवान्प्रत्यवारयन्।\nआचक्ष्व मे महायुद्धं भीष्मस्याहवशोभिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2048364, "chapter_id": 2066, "verse_number": "६-११५-३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2048365, "chapter_id": 2066, "verse_number": "६-११५-३", "content_sanskrit": "कुरवः पाण्डवैः सार्धं यदयुध्यन्त भारत।\nयथा च तदभूद्युद्धं तत्तु वक्ष्यामि सांप्रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2048366, "chapter_id": 2066, "verse_number": "६-११५-४", "content_sanskrit": "गमिताः परलोकाय परमास्त्रैः किरीटिना ।\nअहन्यहनि संप्राप्ते तावकानां महारथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2048367, "chapter_id": 2066, "verse_number": "६-११५-५", "content_sanskrit": "यथाप्रतिज्ञं कौरव्यः स चापि समितिंजयः ।\nपार्थानामकरोद्भीष्मः सततं समिति क्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2048368, "chapter_id": 2066, "verse_number": "६-११५-६", "content_sanskrit": "कुरुभिः सहितं भीष्मं युध्यमानं परंतप ।\nअर्जुनं च सपाञ्चाल्यं दृष्ट्वा संशयिता जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2048369, "chapter_id": 2066, "verse_number": "६-११५-७", "content_sanskrit": "दशमेऽहनि तस्मिंस्तु भीष्मार्जुनसमागमे ।\nअवर्तत महारौद्रः सततं समिति क्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2048370, "chapter_id": 2066, "verse_number": "६-११५-८", "content_sanskrit": "तस्मिन्नयुतशो राजन्भूयशश्च परंतपः ।\nभीष्मः शान्तनवो योधाञ्जघान परामास्त्रवित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2048371, "chapter_id": 2066, "verse_number": "६-११५-९", "content_sanskrit": "येषामज्ञातकल्पानि नामगोत्राणि पार्थिव ।\nते हतास्तत्र भीष्मेण शूराः सर्वेऽनिवर्तिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2048372, "chapter_id": 2066, "verse_number": "६-११५-१०", "content_sanskrit": "दशाहानि तथा तप्त्वा भीष्मः पाण्डववाहिनीम् ।\nनिरविद्यत धर्मात्मा जीविते स परंतपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2048373, "chapter_id": 2066, "verse_number": "६-११५-११", "content_sanskrit": "स क्षिप्रं वधमन्विच्छन्नात्मनोऽभिसुखं रणे।\nन हन्यां मानवश्रेष्ठान्संग्रामेऽभिमुखानिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2048374, "chapter_id": 2066, "verse_number": "६-११५-१२", "content_sanskrit": "चिन्तयित्वा महाबाहुः पिता देवव्रतस्तव ।\nअभ्याशस्थं महाराज पाण्डवं वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2048375, "chapter_id": 2066, "verse_number": "६-११५-१३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2048376, "chapter_id": 2066, "verse_number": "६-११५-१३", "content_sanskrit": "युधिष्ठिर महाप्राज्ञ सर्वशास्त्रविशारद ।\nशृणुष्व वचनं तात धर्म्यं स्वर्ग्यं च जल्पतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2048377, "chapter_id": 2066, "verse_number": "६-११५-१४", "content_sanskrit": "निर्विष्णोऽस्मि भृशं तात देहेनानेन भारत ।\nघ्नतश्च मे गतः कालः सुबहून्प्राणिनो रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2048378, "chapter_id": 2066, "verse_number": "६-११५-१५", "content_sanskrit": "तस्मात्पार्थं पुरोधाय पाञ्चालान्सृज्जयांस्तथा ।\nमद्वधे क्रियतां यत्नो मम चेदिच्छसि प्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2048379, "chapter_id": 2066, "verse_number": "६-११५-१६x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2048380, "chapter_id": 2066, "verse_number": "६-११५-१६", "content_sanskrit": "तस्य तन्मतमाज्ञाय पाण्डवः सत्यदर्शनः ।\nभीष्मं प्रति ययौ राजा संग्रामे सह सृञ्जयैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2048381, "chapter_id": 2066, "verse_number": "६-११५-१७", "content_sanskrit": "धृष्टद्युम्नस्ततो राजन्पाण्डवश्च युधिष्ठिरः ।\nश्रुत्वा भीष्मस्य तां वाचं चोदयामासतुर्बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2048382, "chapter_id": 2066, "verse_number": "६-११५-१८", "content_sanskrit": "अभिद्रवध्यं युद्ध्यध्वं भीष्मं जयत संयुगे ।\nरक्षिताः सत्यसन्धेन जिष्णुना रिपुजिष्णुना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2048383, "chapter_id": 2066, "verse_number": "६-११५-१९", "content_sanskrit": "अयं चापि महेष्वासः पार्षतो वाहिनीपतिः ।\nभीमसेनश्च समरे पालयिष्यति वो ध्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2048384, "chapter_id": 2066, "verse_number": "६-११५-२०", "content_sanskrit": "मा वो भीष्माद्भयं किंचिदस्त्वद्य युधि सृञ्जयाः।\nध्रुवं भीष्मं विजेष्यामः पुरस्कृत्य शिखण्डिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2048385, "chapter_id": 2066, "verse_number": "६-११५-२१", "content_sanskrit": "ते तथा समयं कृत्वा दशमेऽहनि पाण्डवाः।\nब्रह्मलोकपरा भूत्वा संजग्मुः क्रोधमूर्च्छिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2048386, "chapter_id": 2066, "verse_number": "६-११५-२२", "content_sanskrit": "शिखण्डिनं पुरस्कृत्य पाण्डवं च धनञ्जयम् ।\nभीष्मस्य पातने यत्नं परमं ते समास्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2048387, "chapter_id": 2066, "verse_number": "६-११५-२३", "content_sanskrit": "ततस्त्व सुतादिष्टा नानाजनपदेश्वराः।\nद्रोणेन सहपुत्रेण सहसेना महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2048388, "chapter_id": 2066, "verse_number": "६-११५-२४", "content_sanskrit": "दुःशासनश्च बलवान्सह सर्वैः सहोदरैः ।\nभीष्मं समरमध्यस्थं पालयांचक्रिरे तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2048389, "chapter_id": 2066, "verse_number": "६-११५-२५", "content_sanskrit": "ततस्तु तावकाः शूराः पुरस्कृत्य महाव्रतम्।\nशिखण्डिप्रमुखान्पार्थान्योधयन्ति स्म संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2048390, "chapter_id": 2066, "verse_number": "६-११५-२६", "content_sanskrit": "चेदिभिस्तु सपाञ्चालैः सहितो वानरध्वजः ।\nययौ शान्तनवं भीष्मं पुरस्कृत्य शिखण्डिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2048391, "chapter_id": 2066, "verse_number": "६-११५-२७", "content_sanskrit": "द्रोणपुत्रं शिनेर्नप्ता धृष्टकेतुस्तु पौरवम् ।\nअभिमन्युः सहामात्यं दुर्योधमयोधयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2048392, "chapter_id": 2066, "verse_number": "६-११५-२८", "content_sanskrit": "विराटस्तु सहानीकः सहसेनं जयद्रथम् ।\nवृद्धक्षत्रस्य दायादमाससाद परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2048393, "chapter_id": 2066, "verse_number": "६-११५-२९", "content_sanskrit": "मद्रराजं महेष्वासं सहसैन्यं युधिष्ठिरः ।\nभीमसेनोऽभिगुप्तस्तु नागानीकमुपाद्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2048394, "chapter_id": 2066, "verse_number": "६-११५-३०", "content_sanskrit": "अप्रधृष्यमनावार्यं सर्वशस्त्रभृतां वरम् ।\nद्रोणं प्रति ययौ यत्तः पाञ्चाल्यः सह सोदरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2048395, "chapter_id": 2066, "verse_number": "६-११५-३१", "content_sanskrit": "कर्णिकारध्वजं चैव सिंहकैतुररिंदमः ।\nप्रत्युज्जगाम सौभद्रं राजपुत्रो बृहद्बलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2048396, "chapter_id": 2066, "verse_number": "६-११५-३२", "content_sanskrit": "शिखण्डिनं च पुत्रास्ते पाण्डवं च धनञ्जयम् ।\nराजभिः समरे पार्थमभिपेतुर्जिघांसवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2048397, "chapter_id": 2066, "verse_number": "६-११५-३३", "content_sanskrit": "तस्मिन्नतिमहाभीमे सेनयोर्वै पराक्रमे ।\nसंप्रधावत्स्वनीकेषु मेदिनी समकम्पत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2048398, "chapter_id": 2066, "verse_number": "६-११५-३४", "content_sanskrit": "तान्यनीकान्यनीकेषु समयुध्यन्त भारत ।\nतावकानां परेषां च दृष्ट्वा शान्तनवं रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2048399, "chapter_id": 2066, "verse_number": "६-११५-३५", "content_sanskrit": "ततस्तेषां प्रयततामन्योन्यमभिधावताम् ।\nप्रादुरासीन्महाशब्दो दिक्षु सर्वासु भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2048400, "chapter_id": 2066, "verse_number": "६-११५-३६", "content_sanskrit": "शङ्खदुन्दुभिघोषश्च वारणानां च बृंहितैः ।\nसिंहनादश्च सैन्यानां दारुणः समपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2048401, "chapter_id": 2066, "verse_number": "६-११५-३७", "content_sanskrit": "सा च सर्वनरेन्द्राणां चन्द्रार्कसदृशी प्रभा ।\nहाराङ्गदकिरीटेषु निष्प्रभा समपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2048402, "chapter_id": 2066, "verse_number": "६-११५-३८", "content_sanskrit": "रजोमेघास्तु संजज्ञुः शस्त्रविद्युद्भिरावृताः ।\nधनुषां चापि निर्घोषो दारुणः समपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2048403, "chapter_id": 2066, "verse_number": "६-११५-३९", "content_sanskrit": "बाणशङ्खप्रणादाश्च भेरीणां च महास्वनाः ।\nरथघोषश्च संजज्ञे सेनयोरुभयोरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2048404, "chapter_id": 2066, "verse_number": "६-११५-४०", "content_sanskrit": "प्रासशक्त्यृष्टिसङ्घैश्च बाणौघैश्च समाकुलम् ।\nनिष्प्रकाशमिवाकाशं सेनयोः समपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2048405, "chapter_id": 2066, "verse_number": "६-११५-४१", "content_sanskrit": "अन्योन्यं रथिनः पेतुर्वाजिनश्च महाहवे ।\nकुञ्जरान्कुञ्जरा जघ्नुः पादातांश्च पदातयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2048406, "chapter_id": 2066, "verse_number": "६-११५-४२", "content_sanskrit": "तत्रासीत्सुमहद्युद्धं कुरूणां पाण्डवैः सह।\nभीष्महेतोर्नरव्याघ्र श्येनयोरामिषे यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2048407, "chapter_id": 2066, "verse_number": "६-११५-४३", "content_sanskrit": "तयोः समागमो घोरो बभूव युधि भारत।\nअन्योन्यस्य वधार्थाय जिगीषूणां महाहवे ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2048408, "chapter_id": 2066, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि दशमदिवसयुद्धे पञ्चादशाधिकशततमोऽध्यायः ॥\nMahabharata - Bhishma Parva - Chapter Footnotes\n६-११५-१० निरविद्यत निर्वेदं जगाम ॥ ६-११५-१४ निर्विण्यो विरक्तः ॥ ६-११५-२१ ब्रह्मलोकपराः बृहत्त्वान्महान्तं लोकं प्रति यतमानाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]