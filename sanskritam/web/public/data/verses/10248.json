[{"id": 6000248000, "chapter_id": 10248, "verse_number": null, "content_sanskrit": "अथ द्विपञ्चाशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "topics": [{"text": "जरासन्धं मौलौ गृहीत्वा मुसलेन हन्तुमिच्छता बलरामेण ‘त्वयाऽयं न वध्यः’ इत्यशरीरवाणीं श्रुत्वा विसर्जनम्", "range": null}, {"text": "श्रीशुक उवाच–", "range": null}]}, {"id": 6000248001, "chapter_id": 10248, "verse_number": "१०-५२-१", "content_sanskrit": "बाणसेनां गतां दृष्ट्वा शस्‍त्रौघेण भृशार्दिताः।\nराजपुत्रा विमनसो बभूवुर्नृपसत्तम॥ १०/५२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.001.m4a", "display_order": 2}, {"id": 6000248002, "chapter_id": 10248, "verse_number": "१०-५२-२", "content_sanskrit": "गतां च दानवीं सेनां श्रान्तांश्च धरणीपतीन्।\nदृष्ट्वा कृष्णं च युद्ध्यन्तं रामस्य ववृधे बलम्॥ १०/५२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.002.m4a", "display_order": 3}, {"id": 6000248003, "chapter_id": 10248, "verse_number": "१०-५२-३", "content_sanskrit": "स मागधं गृहीत्वाऽऽजौ मौलौ वामेन पाणिना।\nप्रहर्तुमैच्छच्छिरसि मुसलेन हलायुधः॥ १०/५२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.003.m4a", "display_order": 4}, {"id": 6000248004, "chapter_id": 10248, "verse_number": "१०-५२-४", "content_sanskrit": "ततोऽन्तरिक्षे घनघोषघर्घरां शुश्राव वाणीं विशदाशरीरिणीम्।\nन राम वध्यो भवता जरासुतः सुखी निवर्तस्व रणादिति स्फुटम्॥ १०/५२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.004.m4a", "display_order": 5}, {"id": 6000248005, "chapter_id": 10248, "verse_number": "१०-५२-५", "content_sanskrit": "वचस्तदाकर्ण्य हलायुधो बली विसृज्य चास्थाय रथं रणाङ्गणात्।\nन्यवर्तत ब्रह्मर्षिसिद्धसङ्घैरभिष्टुतो मागधसूतवन्दिभिः॥ १०/५२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.005.m4a", "display_order": 6}, {"id": 6000248006, "chapter_id": 10248, "verse_number": "१०-५२-६", "content_sanskrit": "जरासुतः सम्प्रति नम्रकन्धरो नृपैश्च युद्धाभिजितैः समन्वितः।\nहतावशिष्टाल्पबलेन संवृतो निवृत्तयुद्धः प्रययौ स्वकं पुरम्॥ १०/५२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.006.m4a", "display_order": 7, "topics": [{"text": "पराजितस्य जरासन्धस्य स्वपुरगमनम्", "range": "६"}]}, {"id": 6000248007, "chapter_id": 10248, "verse_number": "१०-५२-७", "content_sanskrit": "गोविन्दस्तु महातेजाः सपत्नाञ्छरसञ्चयैः।\nआच्छाद्य भूपान् विद्राव्य हत्वा च सुबहून् रणे॥ १०/५२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.007.m4a", "display_order": 8}, {"id": 6000248008, "chapter_id": 10248, "verse_number": "१०-५२-८", "content_sanskrit": "संस्तूयमानः सन्तुष्टैः सूतमागधवन्दिभिः।\nब्राह्मणैश्च महाविद्यैः स्तोत्रं कुर्वद्भिरुच्चकैः॥ १०/५२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.008.m4a", "display_order": 9}, {"id": 6000248009, "chapter_id": 10248, "verse_number": "१०-५२-९", "content_sanskrit": "अन्वीयमानो भगवान् प्राविशन्मधुरां पुरीम्।\nहृष्टपुष्टजनाकीर्णां तुङ्गप्राकारतोरणाम्॥ १०/५२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.009.m4a", "display_order": 10}, {"id": 6000248010, "chapter_id": 10248, "verse_number": "१०-५२-१०", "content_sanskrit": "चलत्कदलिकोपेतां दीपाङ्कुरविराजिताम्।\nप्रविशन् राजमार्जेण स्‍त्रीभिः प्रासादसंस्थितैः॥ १०/५२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.010.m4a", "display_order": 11}, {"id": 6000248011, "chapter_id": 10248, "verse_number": "१०-५२-११", "content_sanskrit": "पुष्पैश्च लाजाञ्जलिभिः कीर्यमाणो व्यराजत।\nउपायनानि दिव्यानि पुष्पस्रगनुलेपनान्॥ १०/५२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.011.m4a", "display_order": 12}, {"id": 6000248012, "chapter_id": 10248, "verse_number": "१०-५२-१२", "content_sanskrit": "प्रियङ्करा माधवाभ्यामुपाजह्रुः पुरौकसः।\nएवं स राजमार्गेण गत्वा यादवसत्तमः॥ १०/५२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.012.m4a", "display_order": 13}, {"id": 6000248013, "chapter_id": 10248, "verse_number": "१०-५२-१३", "content_sanskrit": "सभां प्रविश्य विपुलामुपविश्य वरासने।\nरामेण सहितो वीरः शैनेयेन च धीमता॥ १०/५२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.013.m4a", "display_order": 14}, {"id": 6000248014, "chapter_id": 10248, "verse_number": "१०-५२-१४", "content_sanskrit": "पूजितो यदुभिर्विप्रैर्दिवि शक्र इवामरैः।\nतत्रासीनैर्बुद्धिमद्भिर्यदुवृद्धैर्महात्मभिः॥ १०/५२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.014.m4a", "display_order": 15}, {"id": 6000248015, "chapter_id": 10248, "verse_number": "१०-५२-१५", "content_sanskrit": "उग्रसेनोद्धवमुखैरक्रूरप्रमुखैर्हरिः।\nसमाभाष्याभ्यनुज्ञातः सङ्कर्षणसहायवान्॥ १०/५२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.015.m4a", "display_order": 16}, {"id": 6000248016, "chapter_id": 10248, "verse_number": "१०-५२-१६", "content_sanskrit": "द्रष्टुकामो महादुर्गं गोमन्तं पर्वतोत्तमम्।\nनिर्गम्य मधुरां प्रातर्दक्षिणाभिमुखो ययौ॥ १०/५२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.016.m4a", "display_order": 17, "topics": [{"text": "शत्रुं विजित्य स्वपुरीं प्राप्तस्य कृष्णस्य दुर्गान्वेषणार्थं रामेण सह गोमन्तगमनम्", "range": "१६"}]}, {"id": 6000248017, "chapter_id": 10248, "verse_number": "१०-५२-१७", "content_sanskrit": "स रामानुगतः श्रीमानुत्तीर्य यमुनां हरिः।\nदेशान् बहूनतिक्रम्य पर्वतान् सरितो गिरौ॥ १०/५२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.017.m4a", "display_order": 18}, {"id": 6000248018, "chapter_id": 10248, "verse_number": "१०-५२-१८", "content_sanskrit": "गच्छन् क्‍वचिद् वनोद्देशे वृक्षमूलनिवासिनम्।\nददर्श कञ्चन मुनिं जटामण्डलमण्डितम्॥ १०/५२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.018.m4a", "display_order": 19}, {"id": 6000248019, "chapter_id": 10248, "verse_number": "१०-५२-१९", "content_sanskrit": "चीरकृष्णाजिनधरं कमण्डलुविराजितम्।\nसमाधौ समुपाविष्टं तेजसा भास्करोपमम्॥ १०/५२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.019.m4a", "display_order": 20}, {"id": 6000248020, "chapter_id": 10248, "verse_number": "१०-५२-२०", "content_sanskrit": "फलमूलकृताहारं वृतं शिष्यशतैर्मुनिम्।\nदृष्ट्वा परमसन्तुष्टौ रामकृष्णौ जगत्पती॥ १०/५२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.020.m4a", "display_order": 21, "topics": [{"text": "मध्येमार्गं परशुरामदर्शनम्", "range": "२०"}]}, {"id": 6000248021, "chapter_id": 10248, "verse_number": "१०-५२-२१", "content_sanskrit": "प्रणामं चक्रतुर्वीरौ यथान्यायमतन्द्रितौ।\nइदं चोवाच भगवान् कृष्णस्तं मुनिपुङ्गवम्॥ १०/५२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.021.m4a", "display_order": 22}, {"id": 6000248022, "chapter_id": 10248, "verse_number": "१०-५२-२२", "content_sanskrit": "नमस्ते भार्गव श्रीमन् जामदग्न्य तपोधन।\nरामकृष्णौ स्मृतावावां क्‍वचित् ते श्रवणं गतौ॥ १०/५२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.022.m4a", "display_order": 23}, {"id": 6000248023, "chapter_id": 10248, "verse_number": "१०-५२-२३", "content_sanskrit": "इत्युक्तस्तेन धर्मात्मा वासुदेवेन भार्गवः।\nनिरीक्ष्य माधवौ प्राह प्रीत्युत्फुल्लमुखेक्षणः॥ १०/५२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.023.m4a", "display_order": 24}, {"id": 6000248024, "chapter_id": 10248, "verse_number": "१०-५२-२४", "content_sanskrit": "स्वागतं ते यदुश्रेष्ठ साग्रजाय महात्मने।\nजाने त्वां यदुषूत्पन्नं भगवन्तमधोक्षजम्॥ १०/५२/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.024.m4a", "display_order": 25}, {"id": 6000248025, "chapter_id": 10248, "verse_number": "१०-५२-२५", "content_sanskrit": "कार्याणां कारणं पूर्वं जगतामादिपूरुषम्।\nनमस्ते पुण्डरीकाक्ष विश्वलोकैककारण॥ १०/५२/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.025.m4a", "display_order": 26}, {"id": 6000248026, "chapter_id": 10248, "verse_number": "१०-५२-२६", "content_sanskrit": "किमर्थमिह सम्प्राप्तौ भवन्तौ विश्ववन्दितौ।\nइत्युक्तौ जामदग्न्येन प्राहतू रामकेशवौ॥ १०/५२/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.026.m4a", "display_order": 27}, {"id": 6000248027, "chapter_id": 10248, "verse_number": "१०-५२-२७", "content_sanskrit": "गोमन्तं द्रष्टुमिच्छावो दुर्गहेतोरिति प्रभो।\nतदाकर्ण्याब्रवीद् रामो जामदग्न्योे जनार्दनम्॥ १०/५२/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.027.m4a", "display_order": 28}, {"id": 6000248028, "chapter_id": 10248, "verse_number": "१०-५२-२८", "content_sanskrit": "एवमस्तु महाबाहो गोमन्तं गच्छ साग्रजः।\nकरवीरपुरं नाम तन्मूले परिपालितम्॥ १०/५२/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.028.m4a", "display_order": 29}, {"id": 6000248029, "chapter_id": 10248, "verse_number": "१०-५२-२९", "content_sanskrit": "सृगालवासुदेवेन स युवां न सहिष्यति।\nतं हत्वा समरे शैलं गोमन्तं साध्ववाप्स्यथ॥ १०/५२/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.029.m4a", "display_order": 30}, {"id": 6000248030, "chapter_id": 10248, "verse_number": "१०-५२-३०", "content_sanskrit": "इत्युक्तौ तेन रामेण जामदग्न्येन माधवौ।\nतमनुज्ञाप्य सर्वज्ञं जग्मतुर्दक्षिणामुखे॥ १०/५२/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.030.m4a", "display_order": 31}, {"id": 6000248031, "chapter_id": 10248, "verse_number": "१०-५२-३१", "content_sanskrit": "तौ तथा यदुशार्दूलौ गच्छन्तौ दक्षिणापथम्।\nददर्शतुश्च गोमन्तमभ्रङ्कषमहाद्रुमम्॥ १०/५२/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.031.m4a", "display_order": 32}, {"id": 6000248032, "chapter_id": 10248, "verse_number": "१०-५२-३२", "content_sanskrit": "करवीरपुरं चैव तन्मूले तुङ्गतोरणम्।\nदृष्ट्वा विचित्रप्राकारं हर्म्यप्रासादगोपुरम्॥ १०/५२/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.032.m4a", "display_order": 33}, {"id": 6000248033, "chapter_id": 10248, "verse_number": "१०-५२-३३", "content_sanskrit": "शङ्खमाध्मापयामास शङ्खचक्रगदाधरः।\nतस्य शङ्खध्वनिं श्रुत्वा भूपालः क्रोधविह्वलः॥ १०/५२/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.033.m4a", "display_order": 34}, {"id": 6000248034, "chapter_id": 10248, "verse_number": "१०-५२-३४", "content_sanskrit": "सृगालवासुदेवाख्यः प्रत्यगाद् यदुनन्दनौ।\nसोऽभ्येत्य बहुपादातितुरङ्गरथकुञ्जरः॥ १०/५२/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.034.m4a", "display_order": 35}, {"id": 6000248035, "chapter_id": 10248, "verse_number": "१०-५२-३५", "content_sanskrit": "अभ्यवर्षच्छरौघेण छादयन्निव माधवौ।\nतदनीकमनाधृष्यं दृष्ट्वा यादवसत्तमौ॥ १०/५२/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.035.m4a", "display_order": 36}, {"id": 6000248036, "chapter_id": 10248, "verse_number": "१०-५२-३६", "content_sanskrit": "योधयामासतुर्वीरौ द्वावेवाजौ पदातिनौ।\nसैन्यं च बाणपूगेन व्यथितं भृशविह्वलम्॥ १०/५२/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.036.m4a", "display_order": 37}, {"id": 6000248037, "chapter_id": 10248, "verse_number": "१०-५२-३७", "content_sanskrit": "दृष्ट्वा सृगालभूपालस्तावधावदमर्षणः। तमायान्तमभिप्रेक्ष्य रथिनं धृतकार्मुकः।\nन्यवारयद् वासुदेवो वेलेव वरुणालयम्॥ १०/५२/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.037.m4a", "display_order": 38}, {"id": 6000248038, "chapter_id": 10248, "verse_number": "१०-५२-३८", "content_sanskrit": "तावुभौ परमक्रुद्धौ वासुदेवौ महाबलौ।\nयुयुधाते तथाऽन्योन्यमन्योन्यवधकाङ्क्षिणौ॥ १०/५२/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.038.m4a", "display_order": 39}, {"id": 6000248039, "chapter_id": 10248, "verse_number": "१०-५२-३९", "content_sanskrit": "स तथाविद्यमानस्य वासुदेवस्य सङ्गरे।\nशिरो जहार गोविन्दः क्षणेन मुकुटोज्ज्वलम्॥ १०/५२/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.039.m4a", "display_order": 40, "topics": [{"text": "तदाज्ञां गृहीत्वा गच्छता श्रीकृष्णेन करवीरपुरे श्रृगालवासुदेवस्य वधः", "range": "३९"}]}, {"id": 6000248040, "chapter_id": 10248, "verse_number": "१०-५२-४०", "content_sanskrit": "ततस्तत्सैनिकाः सर्वे हतशेषाः कुरूद्वह।\nकृष्णेन स्वामिनि हते दुद्रुवुः सर्वतोदिशम्॥ १०/५२/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.040.m4a", "display_order": 41}, {"id": 6000248041, "chapter_id": 10248, "verse_number": "१०-५२-४१", "content_sanskrit": "ततस्तौ रामगोविन्दौ करवीरपुरं महत्।\nप्रविश्य पूजितौ विप्रैर्वणिग्भिश्च यथा प्रियः॥ १०/५२/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.041.m4a", "display_order": 42}, {"id": 6000248042, "chapter_id": 10248, "verse_number": "१०-५२-४२", "content_sanskrit": "तद्गजाश्वरथानीककोशादिधनसञ्चयम्।\nमधुरां प्रेषयामास तदीयैर्भृत्यपूरुषैः॥ १०/५२/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_052/BhP_10.052.042.m4a", "display_order": 43}, {"id": 6000248043, "chapter_id": 10248, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धे द्विपञ्चाशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]