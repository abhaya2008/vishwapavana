[{"id": 7004311000, "chapter_id": 24311, "verse_number": "५-३-५-१", "content_sanskrit": "युधिष्ठिर उवाच ।\nआश्चर्यमेतदखिलं कथितं भो द्विजोत्तम ।\nविस्मयं परमापन्ना ऋषिसंघा मया सह॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004311001, "chapter_id": 24311, "verse_number": "५-३-५-२", "content_sanskrit": "अहो भगवती पुण्या नर्मदेयमयोनिजा ।\nरुद्रदेहाद्विनिष्क्रान्ता महापापक्षयंकरी॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004311002, "chapter_id": 24311, "verse_number": "५-३-५-३", "content_sanskrit": "सप्तकल्पक्षये प्राप्ते त्वयेयं सह सुव्रत ।\nन मृता च महाभागा किमतः पुण्यमुत्तमम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004311003, "chapter_id": 24311, "verse_number": "५-३-५-४", "content_sanskrit": "के ते कल्पाः समुद्दिष्टाः सप्त कल्पक्षयंकराः ।\nन मृता चेदियं देवी त्वं चैव ऋषिपुंगव॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004311004, "chapter_id": 24311, "verse_number": "५-३-५-५", "content_sanskrit": "अपक्षिगणसंघाते जगत्येकार्णवीकृते ।\nकीदृग्रूपः समभवन्महादेवो युगक्षये॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004311005, "chapter_id": 24311, "verse_number": "५-३-५-६", "content_sanskrit": "कथं संहरते विश्वं कथं चास्ते महार्णवे ।\nकथं च सृजते विश्वं कथं धारयते प्रजाः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004311006, "chapter_id": 24311, "verse_number": "५-३-५-७", "content_sanskrit": "कीदृग्रूपा भवेद्देवी सरिदेकार्णवीकृते ।\nकिमर्थं नर्मदा प्रोक्ता रेवती च कथं स्मृता॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004311007, "chapter_id": 24311, "verse_number": "५-३-५-८", "content_sanskrit": "अञ्जनेति किमर्थं वा किमर्थं सुरसेति च ।\nमन्दाकिनी किमर्थं च शोणश्चेति कथं भवेत्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004311008, "chapter_id": 24311, "verse_number": "५-३-५-९", "content_sanskrit": "त्रिकूटेति किमर्थं वा किमर्थं वालुवाहिनी ।\nकोटिकोट्यो हि तीर्थानां प्रविष्टा या महार्णवम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004311009, "chapter_id": 24311, "verse_number": "५-३-५-१०", "content_sanskrit": "कियत्यः सरितां कोट्यो नर्मदां समुपासते ।\nयज्ञोपवीतैरृषिभिर्देवताभिस्तथैव च॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004311010, "chapter_id": 24311, "verse_number": "५-३-५-११", "content_sanskrit": "विभक्तेयं किमर्थं च श्रूयते मुनिसत्तम ।\nवैष्णवीति पुराणज्ञैः किमर्थमिह चोच्यते॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004311011, "chapter_id": 24311, "verse_number": "५-३-५-१२", "content_sanskrit": "केषु स्थानेषु तीर्थेषु पूजनीया सरिद्वरा ।\nतीर्थानि च पृथग्ब्रूहि यत्र संनिहितो हरः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004311012, "chapter_id": 24311, "verse_number": "५-३-५-१३", "content_sanskrit": "यत्प्रमाणा च सा देवी या रुद्रेण विनिर्मिता ।\nकीदृशानि च कर्माणि रुद्रेण कथितानि ते॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004311013, "chapter_id": 24311, "verse_number": "५-३-५-१४", "content_sanskrit": "कथं म्लेच्छसमाकीर्णो देशोऽयं द्विजसत्तम ।\nएतदाचक्ष्व मां ब्रह्मन्मार्कण्डेय महामते॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004311014, "chapter_id": 24311, "verse_number": "५-३-५-१५", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nशृण्वन्तु ऋषयः सर्वे त्वं च तात युधिष्ठिर ।\nपुराणं नर्मदायां तु कथितं च त्रिशूलिना॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004311015, "chapter_id": 24311, "verse_number": "५-३-५-१६", "content_sanskrit": "वायोः सकाशाच्च मया तेनापि च महेश्वरात् ।\nअशक्यत्वान्मनुष्याणां संक्षिप्तमृषिभिः पुरा॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004311016, "chapter_id": 24311, "verse_number": "५-३-५-१७", "content_sanskrit": "मायूरं प्रथमं तात कौर्म्यं च तदनन्तरम् ।\nपुरं तथा कौशिकं च मात्स्यं द्विरदमेव च॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004311017, "chapter_id": 24311, "verse_number": "५-३-५-१८", "content_sanskrit": "वाराहं यन्मया दृष्टं वैष्णवं चाष्टमं परम् ।\nन्यग्रोधाख्यमतः चासीदाकाङ्क्षं पुनरुत्तमम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004311018, "chapter_id": 24311, "verse_number": "५-३-५-१९", "content_sanskrit": "पद्मं च तामसं चैव संवर्तोद्वर्तमेव च ।\nमहाप्रलयमित्याहुः पुराणे वेदचिन्तकाः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004311019, "chapter_id": 24311, "verse_number": "५-३-५-२०", "content_sanskrit": "एतत्संक्षेपतः सर्वं संक्षिप्तं तैर्महात्मभिः ।\nविभक्तं च चतुर्भागैर्ब्रह्माद्यैश्च महर्षिभिः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004311020, "chapter_id": 24311, "verse_number": "५-३-५-२१", "content_sanskrit": "तदहं सम्प्रवक्ष्यामि पुराणार्थविशारद ।\nसप्त कल्पा महाघोरा यैरियं न मृता सरित्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004311021, "chapter_id": 24311, "verse_number": "५-३-५-२२", "content_sanskrit": "आ जङ्गमं तमोभूतमप्रज्ञातमलक्षणम् ।\nनष्टचन्द्रार्ककिरणमासीद्भूतविवर्जितम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004311022, "chapter_id": 24311, "verse_number": "५-३-५-२३", "content_sanskrit": "तमसोऽतो महानाम्ना पुरुषः स जगद्गुरुः ।\nचचार तस्मिन्नेकाकी व्यक्ताव्यक्तः सनातनः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004311023, "chapter_id": 24311, "verse_number": "५-३-५-२४", "content_sanskrit": "स चौंकारमयोऽतीतो गायत्रीमसृजद्द्विजः ।\nस तया सार्द्धमीशानश्चिक्रीड पुरुषो विराट्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004311024, "chapter_id": 24311, "verse_number": "५-३-५-२५", "content_sanskrit": "स्वदेहादसृजद्विश्वं पञ्चभूतात्मसंज्ञितम् ।\nक्रीडन्समसृजद्विश्वं पञ्चभूतात्मसंज्ञितम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004311025, "chapter_id": 24311, "verse_number": "५-३-५-२६", "content_sanskrit": "क्रीडन् सृजद्विराट्संज्ञः सबीजं च हिरण्मयम् ।\nतच्चाण्डमभवद्दिव्यं द्वादशादित्यसन्निभम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004311026, "chapter_id": 24311, "verse_number": "५-३-५-२७", "content_sanskrit": "तद्भित्त्वा पुरुषो जज्ञे चतुर्वक्त्रः पितामहः ।\nसोऽसृजद्विश्वमेवं तु सदेवासुरमानुषम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004311027, "chapter_id": 24311, "verse_number": "५-३-५-२८", "content_sanskrit": "सतिर्यक्पशुपक्षीकं स्वेदाण्डजजरायुजम् ।\nएतदण्डं पुराणेषु प्रथमं परिकीर्तितम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004311028, "chapter_id": 24311, "verse_number": "५-३-५-२९", "content_sanskrit": "पूर्वकल्पे नृपश्रेष्ठ क्रीडन्त्या परमेष्ठिना ।\nउमया सह रुद्रस्य क्रीडतश्चार्णवीकृतः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004311029, "chapter_id": 24311, "verse_number": "५-३-५-३०", "content_sanskrit": "हर्षाज्जज्ञे शुभा कन्या उमायाः स्वेदसंभवा ।\nशर्वस्योरःस्थलाज्जज्ञे उमा कुचविमर्दनात्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004311030, "chapter_id": 24311, "verse_number": "५-३-५-३१", "content_sanskrit": "स्वेदाद्विजज्ञे महती कन्या राजीवलोचना ।\nद्वितीयः संभवो यस्या रुद्रदेहाद्युधिष्ठिर॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004311031, "chapter_id": 24311, "verse_number": "५-३-५-३२", "content_sanskrit": "सा परिभ्रमते लोकान् सदेवासुरमानवान् ।\nत्रैलोक्योन्मादजननी रूपेणऽप्रतिमा तदा॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004311032, "chapter_id": 24311, "verse_number": "५-३-५-३३", "content_sanskrit": "तां दृष्ट्वा देवदैत्येन्द्रा मोहिता लभते कथम् ।\nमृगयन्ति स्म तां कन्यामितश्चेतश्च भारत॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004311033, "chapter_id": 24311, "verse_number": "५-३-५-३४", "content_sanskrit": "हावभावविलासैश्च मोहयत्यखिलं जगत् ।\nभ्रमते दिव्यरूपा सा विद्युत्सौदामिनी यथा॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004311034, "chapter_id": 24311, "verse_number": "५-३-५-३५", "content_sanskrit": "मेघमध्ये स्थिता भाभिः सर्वयोषिदनुत्तमा ।\nततो रुद्रं सुराः सर्वे दैत्याश्च सह दानवैः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004311035, "chapter_id": 24311, "verse_number": "५-३-५-३६", "content_sanskrit": "वरयन्ति स्म तां कन्यां कामेनाकुलिता भृशम् ।\nततोऽब्रवीन्महादेवो देवदानवयोर्द्वयोः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004311036, "chapter_id": 24311, "verse_number": "५-३-५-३७", "content_sanskrit": "बलेन तेजसा चैव ह्यधिको यो भविष्यति ।\nस इमां प्राप्स्यते कन्यां नान्यथा वै सुरोत्तमाः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004311037, "chapter_id": 24311, "verse_number": "५-३-५-३८", "content_sanskrit": "ततो देवासुराः सर्वे कन्यां वै समुपागमन् ।\nअहमेनां ग्रहीष्यामि अहमेनामिति ब्रुवन्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004311038, "chapter_id": 24311, "verse_number": "५-३-५-३९", "content_sanskrit": "पश्यतामेव सर्वेषां सा कन्यान्तरधीयत ।\nपुनस्तां ददृशुः सर्वे योजनान्तरधिष्ठिताम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004311039, "chapter_id": 24311, "verse_number": "५-३-५-४०", "content_sanskrit": "जग्मुस्ते त्वरिताः सर्वे यत्र सा समदृश्यत ।\nत्रिभिश्चतुर्भिश्च तथा योजनैर्दशभिः पुनः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004311040, "chapter_id": 24311, "verse_number": "५-३-५-४१", "content_sanskrit": "धिष्ठितां समपश्यंस्ते सर्वे मातंगगामिनीम् ।\nयोजनानां शतैर्भूयः सहस्रैश्चाप्यधिष्ठिताम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004311041, "chapter_id": 24311, "verse_number": "५-३-५-४२", "content_sanskrit": "तथा शतसहस्रेण लघुत्वात्समदृश्यत ।\nअग्रतः पृष्ठतश्चैव दिशासु विदिशासु च॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004311042, "chapter_id": 24311, "verse_number": "५-३-५-४३", "content_sanskrit": "तां पश्यन्ति वरारोहामेकधा बहुधा पुनः ।\nदिव्यवर्षसहस्रं तु भ्रामितास्ते तया पुरा॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004311043, "chapter_id": 24311, "verse_number": "५-३-५-४४", "content_sanskrit": "न चावाप्ता तु सा कन्या महादेवाङ्गसंभवा ।\nसहोमया ततो देवो जहासोच्चैः पुनःपुनः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004311044, "chapter_id": 24311, "verse_number": "५-३-५-४५", "content_sanskrit": "गणास्तालकसंपातैर्नृत्यन्ति च मुदान्विताः ।\nअकस्माद्दृश्यते कन्या शंकरस्य समीपगा॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004311045, "chapter_id": 24311, "verse_number": "५-३-५-४६", "content_sanskrit": "तां दृष्ट्वा विस्मयापन्ना देवा यान्ति पराङ्मुखाः ।\nतस्याश्चक्रे ततो नाम स्वयमेव पिनाकधृक्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004311046, "chapter_id": 24311, "verse_number": "५-३-५-४७", "content_sanskrit": "नर्म चैभ्यो ददे यस्मात्तत्कृतैश्चेष्टितैः पृथक् ।\nभविष्यसि वरारोहे सरिच्छ्रेष्ठा तु नर्मदा॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004311047, "chapter_id": 24311, "verse_number": "५-३-५-४८", "content_sanskrit": "स्वरूपमास्थितो देवः प्राप हास्यं यतो भुवि ।\nनर्मदा तेन चोक्तेयं सुशीतलजला शिवा॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004311048, "chapter_id": 24311, "verse_number": "५-३-५-४९", "content_sanskrit": "सप्तकल्पक्षये जाते यदुक्तं शंभुना पुरा ।\nन मृता तेन राजेन्द्र नर्मदा ख्यातिमागता॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004311049, "chapter_id": 24311, "verse_number": "५-३-५-५०", "content_sanskrit": "ततस्तामददात्कन्यां शीलवतीं सुशोभनाम् ।\nमहार्णवाय देवेशः सर्वभूतपतिः प्रभुः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004311050, "chapter_id": 24311, "verse_number": "५-३-५-५१", "content_sanskrit": "ततः सा ऋक्षशैलेन्द्रात्फेनपुञ्जाट्टहासिनी ।\nविवेश नर्मदा देवी समुद्रं सरितां पतिम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004311051, "chapter_id": 24311, "verse_number": "५-३-५-५२", "content_sanskrit": "एवं ब्राह्मे पुरा कल्पे समुद्भूतेयमीश्वरात् ।\nमात्स्ये कल्पे मया दृष्टा समाख्याता मया शृणु॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]