[{"id": 2027423, "chapter_id": 1590, "verse_number": "३-२२८-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2027424, "chapter_id": 1590, "verse_number": "३-२२८-१", "content_sanskrit": "तस्मिञ्जाते महासत्त्वे महासेने महाबले।\nसमुत्तस्थुर्महोत्पाता घोररूपाः पृथग्विधाः ॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2027425, "chapter_id": 1590, "verse_number": "३-२२८-२", "content_sanskrit": "स्त्रीपुंसोर्विपरीतं च तथा द्वन्द्वानि यानि च।\nग्रहा दीप्ता दिशः खं च ररास च मही भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2027426, "chapter_id": 1590, "verse_number": "३-२२८-३", "content_sanskrit": "ऋषयश्च महाघोरान्दृष्ट्वोत्पातान्समन्ततः।\nअकुर्वञ्शान्तिमुद्विग्ना लोकानां लोकभावनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2027427, "chapter_id": 1590, "verse_number": "३-२२८-४", "content_sanskrit": "निवसन्ति वने ये तु तस्मिंश्चैत्ररथे जनाः।\nतेऽब्रुवन्नेष नोऽनर्थः पावकेनाहृतो महान्।\nसंगम्य षड्भिः पत्नीभिः सप्तर्षीणामिति स्म ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2027428, "chapter_id": 1590, "verse_number": "३-२२८-५", "content_sanskrit": "अपरे गरुडीमाहुस्तयाऽनर्थोऽयमाहृतः।\nयैर्दृष्टा सा तदा देवी तस्या रूपेण गच्छती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2027429, "chapter_id": 1590, "verse_number": "३-२२८-६", "content_sanskrit": "न तु तत्स्वाहया कर्म कृतंजानाति वै जनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2027430, "chapter_id": 1590, "verse_number": "३-२२८-७", "content_sanskrit": "सुपर्णी तु वचः श्रुत्वा ममायं तनयस्त्विति।\nउपगम्य शनैः स्कन्दमाहाहं जननी तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2027431, "chapter_id": 1590, "verse_number": "३-२२८-८", "content_sanskrit": "अथ सप्तर्षयः श्रुत्वा जातं पुत्रं महौजसम्।\nतत्यजुः षट् तदा पत्नीर्विना देवीमरुन्धतीम्।\nषड्भिरेव तदा जातमाहुस्तद्वनवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2027432, "chapter_id": 1590, "verse_number": "३-२२८-९", "content_sanskrit": "सप्तर्षीनाह च स्वाहा मम पुत्रोऽयमित्युत।\nअहं हेतुर्नैतदेवमिति राजन्पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2027433, "chapter_id": 1590, "verse_number": "३-२२८-१०", "content_sanskrit": "विश्वामित्रस्तु कृत्वेष्टिं सप्तर्षीणां महामुनिः।\nपावकं कामसंतप्तमदृष्टः पृष्ठतोऽन्वगात्।\nतत्तेन निखिलं सर्वमवबुध्य यथातथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2027434, "chapter_id": 1590, "verse_number": "३-२२८-११", "content_sanskrit": "विश्वामित्रस्तु प्रथमं कुमारं शरणं गतः।\nस्तवं दिव्यं संप्रचक्रे महासेनस् चापि सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2027435, "chapter_id": 1590, "verse_number": "३-२२८-१२", "content_sanskrit": "मङ्गलानि च सर्वाणि कौमाराणि त्रयोदश।\nजातकर्मादिकास्तस् क्रियाश्चक्रे महामुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2027436, "chapter_id": 1590, "verse_number": "३-२२८-१३", "content_sanskrit": "पड्वक्रस्य तु मांहात्म्यं कुक्कुटस्य तु साधनम्।\nशक्त्या देव्याः साधनं च तथा पारिषदामषि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2027437, "chapter_id": 1590, "verse_number": "३-२२८-१४", "content_sanskrit": "विश्वामित्रश्चकारैतत्कर्म लोकहिताय वै।\nतस्मादृषिः कुमारस् विश्वामित्रोऽभवत्प्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2027438, "chapter_id": 1590, "verse_number": "३-२२८-१५", "content_sanskrit": "अन्वजानाच्च स्वाहाया रूपान्यत्वं महामुनिः।\nअब्रवीच्च मुनीन्सर्वाननापराध्यन्ति वै स्त्रियः।\nश्रुत्वा तु तत्वतस्तस्मात्ते पत्नीः सर्वतोत्यजन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2027439, "chapter_id": 1590, "verse_number": "३-२२८-१६x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2027440, "chapter_id": 1590, "verse_number": "३-२२८-१६", "content_sanskrit": "स्कन्दं श्रुत्वा तदा देवा वासवं सहिताऽब्रुवन्।\nअविषह्यं वलं स्कन्दं जहि शक्राशु माचिर् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2027441, "chapter_id": 1590, "verse_number": "३-२२८-१७", "content_sanskrit": "यदि वा न निहंस्येनमद्येन्द्रोऽयं भविष्यति।\nत्रैलोक्यं सन्निगृह्यास्मांस्त्वां च शक्र महाबला ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2027442, "chapter_id": 1590, "verse_number": "३-२२८-१८", "content_sanskrit": "स तानुवाच व्यथितो वालोऽयं सुमहाबलः।\nस्रष्टारमपि लोकानां युधि विक्रम्य नाशयेत्।\n[न बालमुत्सहे हन्तुमिति शक्रः प्रभाषते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2027443, "chapter_id": 1590, "verse_number": "३-२२८-१९", "content_sanskrit": "तेऽब्रुवन्नास्ति ते वीर्यं यत एवं प्रभासे।]\nसर्वास्त्वद्याभिगच्छन्तु स्कन्दं लोकस्य मातरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2027444, "chapter_id": 1590, "verse_number": "३-२२८-२०", "content_sanskrit": "कामवीर्या घ्नन्तु चैनं तथेत्युक्त्वा च ता ययुः।\nतमप्रतिबलं दृष्ट्वा विषण्णवदनास्तु ताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2027445, "chapter_id": 1590, "verse_number": "३-२२८-२१", "content_sanskrit": "अशक्योऽयंविचिन्त्यैवं तमेव शरणं ययुः।\nऊचुश्चैनं त्वमस्माकं पुत्रोऽस्माभिर्धृतंजगत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2027446, "chapter_id": 1590, "verse_number": "३-२२८-२२", "content_sanskrit": "अभिनन्द्य ततः सर्वाः प्रस्नुताः स्नेहविक्लबाः।\n[तासां तद्वचनं श्रुत्वा पातुकामः स्तनान्प्रभुः] ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2027447, "chapter_id": 1590, "verse_number": "३-२२८-२३", "content_sanskrit": "ताः संपूज्य महासेनःकामांश्चासां प्रदाय सः।\nअपश्यदग्निमायान्तं पितरं बलिनां बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2027448, "chapter_id": 1590, "verse_number": "३-२२८-२४", "content_sanskrit": "स तु संपूजितस्तेन सह मातृगणेन ह।\nपरिवार्य महासेनं रक्षमाणः स्थितः शिवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2027449, "chapter_id": 1590, "verse_number": "३-२२८-२५", "content_sanskrit": "सर्वासां या तु मातॄणां नारी क्रोधसमुद्भवा।\nधात्री स्वपुत्रवत्स्कन्दं शूलहस्ताऽभ्यरक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2027450, "chapter_id": 1590, "verse_number": "३-२२८-२६", "content_sanskrit": "लोहितस्योदधेः कन्या क्रूरा लोहितभोजना।\nपरिष्वज्य महासेनं पुत्रवत्पर्यरक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2027451, "chapter_id": 1590, "verse_number": "३-२२८-२७", "content_sanskrit": "अग्निर्भूत्वा नैगमेयश्छागवक्रो बहुप्रजः।\nरमयामास शैलस्तं बालं क्रीडनकैरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2027452, "chapter_id": 1590, "verse_number": "३-२२८-२८", "content_sanskrit": "ब्रहाः सोपग्रहाश्चैव ऋषयो मातरस्तथा।\nहुताशनमुखाश्चैव दृप्ताः पारिषदां गणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2027453, "chapter_id": 1590, "verse_number": "३-२२८-२९", "content_sanskrit": "एते चान्ये च बहवो घोरास्त्रिदिववासिनः।\nपरिवार्य महासेनं स्थिता मातृगणैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2027454, "chapter_id": 1590, "verse_number": "३-२२८-३०", "content_sanskrit": "संदिग्धं विजयं दृष्ट्वा विजयेप्सुः सुरेश्वरः।\nआरुह्यैरावतस्कन्धं प्रययौ दैवतैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2027455, "chapter_id": 1590, "verse_number": "३-२२८-३१", "content_sanskrit": "आदाय वज्रं बवान्सर्वैर्देवगणैर्वृतः।\nविजिघांसुर्महासेनमिन्द्रस्तूर्णतरं ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2027456, "chapter_id": 1590, "verse_number": "३-२२८-३२", "content_sanskrit": "`इन्द्रस्तस्य महावेगं दृष्ट्वाऽद्भुतपराक्रमम्।\nविस्मितश्चाभवद्राजन्देवानीकमचोदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2027457, "chapter_id": 1590, "verse_number": "३-२२८-३३", "content_sanskrit": "उग्रं तं च महानादं देवानीकं महाप्रभम्।\nविचित्रध्वजसन्नाहं नानावाहनकार्मुकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2027458, "chapter_id": 1590, "verse_number": "३-२२८-३४", "content_sanskrit": "प्रवराम्बरसंवीतं श्रिया जुष्टमलंकृतम्।\nविजिघांसुं तमायान्तं कुमारः शक्रमन्वयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2027459, "chapter_id": 1590, "verse_number": "३-२२८-३५", "content_sanskrit": "वियत्पतिः स शक्रस्तु द्रुतमायान्महाबलः।\nसंहर्पयन्देवसेनां जिघांसुः पावकात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2027460, "chapter_id": 1590, "verse_number": "३-२२८-३६", "content_sanskrit": "संपूज्यमानस्त्रिदशैस्तथैव परमर्षिभिः।\nसमीपमथ संप्राप्तो वह्निपुत्रस्य वासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2027461, "chapter_id": 1590, "verse_number": "३-२२८-३७", "content_sanskrit": "सिंहनादं ततश्चक्रे देवेशः सहितैः सुरैः।\nगुहोऽपिशब्दं तं श्रुत्वा व्यनदात्सागरो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2027462, "chapter_id": 1590, "verse_number": "३-२२८-३८", "content_sanskrit": "तस्य शब्देन महता समुद्धूतोदधिप्रभम्।\nवभ्राम तत्रतत्रैव दैवसैन्यमचेतनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2027463, "chapter_id": 1590, "verse_number": "३-२२८-३९", "content_sanskrit": "जिधांसूनुपसंप्राप्तान्देवान्दृष्ट्वा सपावकिः।\nविससर्ज मुखात्क्रुद्धः प्रवृद्धाः पावकार्चिषः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2027464, "chapter_id": 1590, "verse_number": "३-२२८-४०", "content_sanskrit": "अदहद्देवसैन्यानि वेपमानानि भूतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2027465, "chapter_id": 1590, "verse_number": "३-२२८-४१", "content_sanskrit": "ते प्रदीप्तशिरोदेहाः प्रदीप्तायुधवाहनाः।\nप्रच्युताः सहसा भान्ति चित्रास्तारागणा इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2027466, "chapter_id": 1590, "verse_number": "३-२२८-४२", "content_sanskrit": "दह्यमानाः प्रपन्नास्ते शरणं पावकात्मजम्।\nदेवा वज्रधरं त्यक्त्वाततः शानतिमुपागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2027467, "chapter_id": 1590, "verse_number": "३-२२८-४३", "content_sanskrit": "त्यक्तो देवैस्ततः स्कन्दे वज्रं शक्रो न्यपातयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2027468, "chapter_id": 1590, "verse_number": "३-२२८-४४", "content_sanskrit": "तद्विसृष्टं जघानाशु पर्श्वं स्कन्दस्य दक्षिणम्।\nविभेद च महाराज पार्श्वं तस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2027469, "chapter_id": 1590, "verse_number": "३-२२८-४५", "content_sanskrit": "वज्रप्रहारात्स्कन्दस्य संजातः पुरुषोऽपरः।\nयुवा काञ्चनसन्नाहः शक्तिधृग्दिव्यकुण्डलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2027470, "chapter_id": 1590, "verse_number": "३-२२८-४६", "content_sanskrit": "यद्वज्रविशनाज्जातो विशाखस्तेन सोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2027471, "chapter_id": 1590, "verse_number": "३-२२८-४७", "content_sanskrit": "तं जातमपरं दृष्ट्वा कालानलसमद्युतिम्।\nभयादिनद्रस्तुत तं स्कन्दं प्राञ्जलिः शरणं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2027472, "chapter_id": 1590, "verse_number": "३-२२८-४८", "content_sanskrit": "तस्याभयंददौ स्कन्दः सहसैन्यस् सत्तम।\nततः प्रहृष्टास्त्रिदशा वादित्राण्यभ्यवादयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2027473, "chapter_id": 1590, "verse_number": "३-२२८-४९", "content_sanskrit": "स्कन्दपारिषदान्धोराञ्छृणुष्वाद्भुतदर्शनान्।\nवज्रप्हहारात्स्कन्दस्य जज्ञुस्तत्र कुमारकाः।\nये हरन्ति शिशूञ्जातान्गर्भस्थाश्चैव दारुणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2027474, "chapter_id": 1590, "verse_number": "३-२२८-५०", "content_sanskrit": "वज्रप्रहारात्कन्याश्च जज्ञिरेऽस् महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2027475, "chapter_id": 1590, "verse_number": "३-२२८-५१", "content_sanskrit": "कुमारान्स विशखं च पुत्रत्वे समकल्पयत्।\nस भूत्वा भगवान्सङ्ख्ये रक्षंश्छागमुखस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2027476, "chapter_id": 1590, "verse_number": "३-२२८-५२", "content_sanskrit": "वृतः कन्यागणैः सर्वैरात्मीयैः सह पुत्रकैः।\nमातृणां प्रेषितानां च भद्रशाखश्चकोमलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2027477, "chapter_id": 1590, "verse_number": "३-२२८-५३", "content_sanskrit": "ततः कुमारं संजातं स्कन्दमाहुर्जना भुवि।\nरुद्रमग्निमुखां स्वाहां प्रदेशेषु महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2027478, "chapter_id": 1590, "verse_number": "३-२२८-५४", "content_sanskrit": "यजन्ति पुत्रकामाश्च पुत्रिणश्च सदा जनाः।\nयास्तास्त्वजनयत्कन्यास्तपो नाम हुताशनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2027479, "chapter_id": 1590, "verse_number": "३-२२८-५५", "content_sanskrit": "किं करोमीति ताः स्कन्दं संप्राप्ताः समभाषयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2027480, "chapter_id": 1590, "verse_number": "३-२२८-५६", "content_sanskrit": "भवेम सर्वलोकस्य मातरो वयमुत्तमाः।\nप्रसादात्तव पूज्याश्च प्रियमेतत्कुरुष्व नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2027481, "chapter_id": 1590, "verse_number": "३-२२८-५७", "content_sanskrit": "सोऽब्रवीद्बाढमित्येवं भविष्यध्वं पृथिग्विधाः।\nशिवाश्चैवाशिवाश्चैव पुनःपुनःरुदारधीः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2027482, "chapter_id": 1590, "verse_number": "३-२२८-५८", "content_sanskrit": "`अग्निर्भूत्वा ततश्चैनं छागवक्रो बहुप्रजः।\nरमयामास शैलस्थं बलं क्रीडनकैरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2027483, "chapter_id": 1590, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि मार्कण्डेयसमास्यापर्वणि अष्टाविंशत्यधिकद्विशततमोऽध्यायः ॥ २२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]