    "avatarnika": ""
  },
  {
    "id": 20010807,
    "chapter_id": 6677,
    "verse_number": "5.47",
    "content_sanskrit": "पीतपुष्परसक्षीबभृङ्गातिक्राणहारिणा । हरिचन्दनशीतेन नन्दनेनोपशोभितम् ॥",
