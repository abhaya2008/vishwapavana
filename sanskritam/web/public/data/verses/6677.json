    "avatarnika": ""
  },
  {
    "id": 20010806,
    "chapter_id": 6677,
    "verse_number": "5.46",
    "content_sanskrit": "कल्याणवीणाप्रकाणमग्नगीर्वाणकामिना । मञ्जुप्रक्वणवीणावदमरेन्दुमुखीमता ॥",
