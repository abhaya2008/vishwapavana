    "chapter_id": 6677,
    "verse_number": "5.48",
    "content_sanskrit": "पणैरिव वसूरव्याविशयैरखिलैर्युतम् । निर्दुःखसुखसंपन्नैः पुण्यकृद्भिरधिष्ठितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20010809,
    "chapter_id": 6677,
    "verse_number": "5.49",
    "content_sanskrit": "निष्प्रमादास्तपस्यन्तो निर्मदास्सम्मदप्रदम् । हर्तारस्सुरसद्मामी तपोभिर्मुनयो ध्रुवम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
