    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20010826,
    "chapter_id": 6677,
    "verse_number": "5.66",
    "content_sanskrit": "विद्ययानन्दथुं प्राप्तं परनिर्भयवेपथुम् । यज्ञान् प्रयतैः कुर्वाणमयाच्ञोपार्जितैर्धनैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "avatarnika": ""
  },
  {
    "id": 20010827,
    "chapter_id": 6677,
    "verse_number": "5.67",
    "content_sanskrit": "विश्वरङ्णकरं विश्वैस्तीर्थानां धूतकल्मपम् । प्रश्नानां परिहर्तारं सूक्ष्माणापि धीमताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "avatarnika": ""
  },
  {
    "id": 20010828,
    "chapter_id": 6677,
    "verse_number": "5.68",
    "content_sanskrit": "निधिन्तोषस्य निस्तृष्णमस्वप्नं तुल्यपाण्धिना । लोकोत्तराभिरापन्नं कृतिभिः कीर्तिमुत्तमाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "avatarnika": ""
  },
  {
    "id": 20010829,
    "chapter_id": 6677,
    "verse_number": "5.69",
    "content_sanskrit": "स्थितिज्ञं सर्वशास्त्राणां सामोद्गीतिविशारदम् । सोमपीतिपवित्रास्यं वपापक्तिविचक्षणम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "avatarnika": ""
  },
  {
    "id": 20010830,
    "chapter_id": 6677,
    "verse_number": "5.70",
    "content_sanskrit": "मतिमानर्जुनो दृष्ट्वा महर्षिं प्रजहर्ष तम् । वृष्ट्युन्मुखमिवांभोदं मयूरस्सार्वचेष्टितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70,
    "avatarnika": ""
  },
  {
    "id": 20010831,
    "chapter_id": 6677,
    "verse_number": "5.71",
    "content_sanskrit": "हस्ताभ्यां हेतिगर्भाभ्यामुद्यताभ्यां कृताञ्जलिः । इज्यापरं कृतव्रज्यस्स ववन्दे'सह द्विजैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71,
    "avatarnika": ""
  },
  {
    "id": 20010832,
    "chapter_id": 6677,
    "verse_number": "5.72",
    "content_sanskrit": "यथाविधि कृतेत्यन्तमातिथेयोतिथिं मुनिः । ध्यानविज्ञातमाराध्य पप्रच्छोपात्तविष्टरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 72,
    "avatarnika": ""
  },
  {
    "id": 20010833,
    "chapter_id": 6677,
    "verse_number": "5.73",
    "content_sanskrit": "पौरवं पाण्डुपुत्रं त्वां वेद्मि धर्मात्मजानुजम् । धर्म्या विदधतं कृत्यास्सत्यरक्षाकरक्रियम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 73,
    "avatarnika": ""
  },
  {
    "id": 20010834,
    "chapter_id": 6677,
    "verse_number": "5.74",
    "content_sanskrit": "वृकोदरादयो यूयं गुरोरिच्छां महीभृतः । कच्चित् सदानुवर्तध्वे सर्वे सौभ्रात्रकाम्यया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 74,
    "avatarnika": ""
  },
  {
    "id": 20010835,
    "chapter_id": 6677,
    "verse_number": "5.75",
    "content_sanskrit": "कच्चित्प्रजानां रक्षायै यतध्वे यूयमन्वहम् । अपमन्त्रभिदास्सर्वप्रतिपक्षक्षिपक्षमाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 75,
    "avatarnika": ""
  },
  {
    "id": 20010836,
    "chapter_id": 6677,
    "verse_number": "5.76",
    "content_sanskrit": "चिन्ताभिः कार्यजातानां पूजाभिर्मुखजन्मनाम् । कथाभिश्चादिराजानां कालं नयथ कच्चन ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 76,
    "avatarnika": ""
  },
  {
    "id": 20010837,
    "chapter_id": 6677,
    "verse_number": "5.77",
    "content_sanskrit": "वर्णाश्रमाश्रया शेषधर्मस्थापनया यशः । बहुवित्तप्रदाभिश्च लभध्वेकच्चिदुज्वलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 77,
    "avatarnika": ""
  },
  {
    "id": 20010838,
    "chapter_id": 6677,
    "verse_number": "5.78",
    "content_sanskrit": "गृहेषु गृहिणां स्वेषु कुरुध्वे कच्चिदासनाम् । निशितायुधसंघातहतनिश्शेषकण्टकाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 78,
    "avatarnika": ""
  },
  {
    "id": 20010839,
    "chapter_id": 6677,
    "verse_number": "5.79",
    "content_sanskrit": "कच्चित् प्रजा न बाधन्ते रोगाः प्रच्छर्दिकादयः । राष्ट्रे चतुर्णां भ्रातृणां कुशलं तव कच्चन ? ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 79,
    "avatarnika": ""
  },
  {
    "id": 20010840,
    "chapter_id": 6677,
    "verse_number": "5.80",
    "content_sanskrit": "कोशान् पूरयत द्रव्यैर्दत्त्वा भुक्त्वा च कच्चन । अभ्यूषखादिकाद्या वः क्रीडा धिन्वन्ति कच्चन ? ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 80,
    "avatarnika": ""
  },
  {
    "id": 20010841,
    "chapter_id": 6677,
    "verse_number": "5.81",
    "content_sanskrit": "कामयेच्छसि भोजिं त्वं कां वा लपसि शायिकाम् । शुश्रूषसे कथां कां वा वद वत्स धनञ्जय ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 81,
    "avatarnika": ""
  },
  {
    "id": 20010842,
    "chapter_id": 6677,
    "verse_number": "5.82",
    "content_sanskrit": "इति पृच्छन्तमाह स्म कौशिकं कुरुनन्दनः । स्मितज्योत्स्नापरिक्षिप्तमुखशीतांशुमण्डलः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 82,
    "avatarnika": ""
  },
  {
    "id": 20010843,
    "chapter_id": 6677,
    "verse_number": "5.83",
    "content_sanskrit": "इच्छाम्यहं फलादीनां भोजिं पर्णे च शायिकाम् । पुण्यां कथाञ्च शुश्रूषे त्वयोक्तामृषिकुञ्जर ! ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 83,
    "avatarnika": ""
  },
  {
    "id": 20010844,
    "chapter_id": 6677,
    "verse_number": "5.84",
    "content_sanskrit": "राज्ये च सर्वत्रेदानीं तेषां कुशलमेव नः । सुप्रसन्नो भवानेवं येषां' कुशिकनन्दन ! ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 84,
    "avatarnika": ""
  },
  {
    "id": 20010845,
    "chapter_id": 6677,
    "verse_number": "5.85",
    "content_sanskrit": "पीनोरुस्तनकम्राणां राज्ञा भूत्वा पुरा किल । वारवारिरुहाक्षीणां निर्विष्टा शायिका त्वया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 85,
    "avatarnika": ""
  },
  {
    "id": 20010846,
    "chapter_id": 6677,
    "verse_number": "5.86",
    "content_sanskrit": "ब्रह्मर्षीणामशेषाणां त्वमर्हस्यग्रसारिकाम् । अतितीव्रं तपस्तप्त्वा तपसा किं न लभ्यते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 86,
    "avatarnika": ""
  },
  {
    "id": 20010847,
    "chapter_id": 6677,
    "verse_number": "5.87",
    "content_sanskrit": "परश्शतैर्मखैरिष्ट्वा पराजितशतक्रतुः । धारयस्यमरेभ्यस्त्वं न पुरोडाशभक्षिकाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 87,
    "avatarnika": ""
  },
  {
    "id": 20010848,
    "chapter_id": 6677,
    "verse_number": "5.88",
    "content_sanskrit": "तवोदपादि यज्ञेषु सुराणां सोमपायिका । ओजस्विनो यया मत्तास्ते सपत्नानतापयन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 88,
    "avatarnika": ""
  },
  {
    "id": 20010849,
    "chapter_id": 6677,
    "verse_number": "5.89",
    "content_sanskrit": "विशङ्कुं द्विषतां माञ्च वसिष्ठानामजीवनिः । अस्त्विति त्वद्वचोमृत्युस्सद्यस्तेषामजायत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 89,
    "avatarnika": ""
  },
  {
    "id": 20010850,
    "chapter_id": 6677,
    "verse_number": "5.90",
    "content_sanskrit": "कच्चित् प्रीणाति वो वारि स्नानीयं वानसैन्धवम् । दानीयातिथिशेषञ्च फलमूलादिभोजनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 90,
    "avatarnika": ""
  },
  {
    "id": 20010851,
    "chapter_id": 6677,
    "verse_number": "5.91",
    "content_sanskrit": "वीनां रुतानि शृण्वन्त: पश्यन्तो गमनानि च । हरिणानां वने कच्चिद्रमध्वे मुनयस्सदा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 91,
    "avatarnika": ""
  },
  {
    "id": 20010852,
    "chapter_id": 6677,
    "verse_number": "5.92",
    "content_sanskrit": "शीतनिर्झरिणीवारिपानमूलादिभोजनम् । सुखाकरोति वः पत्नीरपत्यानि च कञ्चन ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 92,
    "avatarnika": ""
  },
  {
    "id": 20010853,
    "chapter_id": 6677,
    "verse_number": "5.93",
    "content_sanskrit": "इध्मप्रव्रश्चनाः कच्चित् कुठारास्तोषयन्ति वः । ईषत्परुषपाषाणपर्यन्तकृततेजनाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 93,
    "avatarnika": ""
  },
  {
    "id": 20010854,
    "chapter_id": 6677,
    "verse_number": "5.94",
    "content_sanskrit": "नवपल्लवसंघातसुकुमारोत्तरच्छदाः । शयनीसन्ति वः कच्चिदुपला विपुलास्समाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 94,
    "avatarnika": ""
  },
  {
    "id": 20010855,
    "chapter_id": 6677,
    "verse_number": "5.95",
    "content_sanskrit": "अनारतपयस्सेकवर्धिष्णुच्छदसंश्रयैः । आबद्धवृत्तयो वृक्षैश्श्रिता वः कच्चिदालयाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 95,
    "avatarnika": ""
  },
  {
    "id": 20010856,
    "chapter_id": 6677,
    "verse_number": "5.96",
    "content_sanskrit": "शाखाकरचलत्पत्रव्यजवातैर्हृतक्लमाः । अधीध्वे निगमान् कच्चित् सुहृद्भिरवनीरुहैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 96,
    "avatarnika": ""
  },
  {
    "id": 20010857,
    "chapter_id": 6677,
    "verse_number": "5.97",
    "content_sanskrit": "तृणं बहुलमश्नत्यः पीनोध्न्यः पीवरैर्वहैः । कच्चित् सवनमाहेय्यो गोचरेषु चरन्ति वः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 97,
    "avatarnika": ""
  },
  {
    "id": 20010858,
    "chapter_id": 6677,
    "verse_number": "5.98",
    "content_sanskrit": "सर्वत शुभमित्युक्त्वा सर्षिसंघो विसृज्य तम् । सन्ध्याविध्यर्थमुत्तस्थौ विश्वामित्रोथ गाथिनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 98,
    "avatarnika": ""
  },
  {
    "id": 20010859,
    "chapter_id": 6677,
    "verse_number": "5.99",
    "content_sanskrit": "शोभनेनावतारेण 'जलाधारमवातरन् । वेदोक्तं च विधिं कृत्स्नं विदधुस्तत्र तापसाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 99,
    "avatarnika": ""
  },
  {
    "id": 20010860,
    "chapter_id": 6677,
    "verse_number": "5.100",
    "content_sanskrit": "क्षिप्यमाणो मृगव्याधरानाय इव मेचकः । कृत्स्नं चकार नीरन्ध्रमन्धकारस्तपोवनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 100,
    "avatarnika": ""
  },
  {
    "id": 20010861,
    "chapter_id": 6677,
    "verse_number": "5.101",
    "content_sanskrit": "मुनीनां कृत्तिकाखानान् कर्तुकामा इवाखनन् । तपोवनभुवं क्रोडाः स्वदंष्ट्राशिखराखनैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 101,
    "avatarnika": ""
  },
  {
    "id": 20010862,
    "chapter_id": 6677,
    "verse_number": "5.102",
    "content_sanskrit": "इङ्गुदीतैलमुद्धृत्य तैलोदङ्केन भाजनात् । मुनयः पर्णशालासु तेन दीपानदीपयन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 102,
    "avatarnika": ""
  },
  {
    "id": 20010863,
    "chapter_id": 6677,
    "verse_number": "5.103",
    "content_sanskrit": "गावस्सुदोहास्तत्रासन्नीषदापं समित्कुशम् । दारु चादुर्लभं भूरि तापसैरग्निहोतृभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 103,
    "avatarnika": ""
  },
  {
    "id": 20010864,
    "chapter_id": 6677,
    "verse_number": "5.104",
    "content_sanskrit": "तवाहुतहविर्गन्धमाघ्रायातृप्यदर्जुनः । तस्य ह्याघ्रातृभिर्मर्त्यैरीषद्भवमकल्मषैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 104,
    "avatarnika": ""
  },
  {
    "id": 20010865,
    "chapter_id": 6677,
    "verse_number": "5.105",
    "content_sanskrit": "सुदानमतिथिभ्योभूत् फलमूलञ्च तापसैः । स्वादीयस्सुलभं भूरि सलिलं चामृतोपमम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 105,
    "avatarnika": ""
  },
  {
    "id": 20010866,
    "chapter_id": 6677,
    "verse_number": "5.106",
    "content_sanskrit": "ईषत्पात्रंकरैस्त्यक्त्वा छदान् दुर्भाजनंकरान् । पलाशपत्रैः पात्राणि रचयन्ति स्म तापसाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 106,
    "avatarnika": ""
  },
  {
    "id": 20010867,
    "chapter_id": 6677,
    "verse_number": "5.107",
    "content_sanskrit": "सत्कारस्ससम्पूर्णरसैर्मूलफलादिभिः । ससुहृद्भृत्यमानर्च कौरवं कौशिकस्ततः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 107,
    "avatarnika": ""
  },
  {
    "id": 20010868,
    "chapter_id": 6677,
    "verse_number": "5.108",
    "content_sanskrit": "चतुर्वर्गाश्रयामिष्टां लोकशास्त्रविशारदः । भुक्तवन्तंमुपासीनं कथाभिरधिनोन्मुनिम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 108,
    "avatarnika": ""
  },
  {
    "id": 20010869,
    "chapter_id": 6677,
    "verse_number": "5.109",
    "content_sanskrit": "सुपर्यङ्ककरैर्बद्धे पर्यङ्के पल्लवैर्नवैः । मन्दानिलपरिष्वक्तस्सुष्वाप सुखमर्जुनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 109,
    "avatarnika": ""
  },
  {
    "id": 20010870,
    "chapter_id": 6677,
    "verse_number": "5.110",
    "content_sanskrit": "प्रभातायां पुना रात्रावृषयः कौशिकादयः । तीर्थस्नानाय गच्छन्तस्साहाय्यासन् किरीटिनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 110,
    "avatarnika": ""
  },
  {
    "id": 20010871,
    "chapter_id": 6677,
    "verse_number": "5.111",
    "content_sanskrit": "ते तमूचुर्गमिष्यन्तो धन्वी गच्छ त्वमग्रतः । दुर्गेषु हि पथिष्वेवमस्माभिस्सभयं भवम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 111,
    "avatarnika": ""
  },
  {
    "id": 20010872,
    "chapter_id": 6677,
    "verse_number": "5.112",
    "content_sanskrit": "दोर्दण्डकृतकोदण्डं काण्डीरं त्वां पुरस्सरम् । अनीक्षमाणैस्स्वस्माभिर्वने दुरभयं भवम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 112,
    "avatarnika": ""
  },
  {
    "id": 20010873,
    "chapter_id": 6677,
    "verse_number": "5.113",
    "content_sanskrit": "स तानवददित्युक्तस्सति युष्मदनुग्रहे । अद्य पालयितुं युष्मान् मयेषत्कुशलं भवम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 113,
    "avatarnika": ""
  },
  {
    "id": 20010874,
    "chapter_id": 6677,
    "verse_number": "5.114",
    "content_sanskrit": "प्रस्थातुमेष नः कालस्समाहर्तुं परिच्छदान् । समयोयमियं वेला बन्धुं वल्कसमित्कुशम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 114,
    "avatarnika": ""
  },
  {
