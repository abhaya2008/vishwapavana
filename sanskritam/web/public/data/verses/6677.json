    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20010811,
    "chapter_id": 6677,
    "verse_number": "5.51",
    "content_sanskrit": "वटवो विजनं गत्वा दीव्यन्त्येते तृणादिभिः । जिगीषवः पुरोडाशफलादिग्लहलोलुपाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20010812,
    "chapter_id": 6677,
    "verse_number": "5.52",
    "content_sanskrit": "उत्तालकुन्तलाः कन्या मुनीनामुत्पयोधराः । वृषभोपसरार्हा वा माहेयीरिह पश्यत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20010813,
    "chapter_id": 6677,
    "verse_number": "5.53",
    "content_sanskrit": "अन्योन्योपहवं साधु कुर्वन्तोऽत्रर्षिपुत्रकाः । विडंबनामयं यज्ञमार्त्विजीना वितन्वते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20010814,
    "chapter_id": 6677,
    "verse_number": "5.54",
    "content_sanskrit": "इत्थं स कथयन्नेव विपुलं वेत्रविष्टरम् । अध्यासीनं ददर्शाग्रे विश्वामित्रं महामुनिम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20010815,
    "chapter_id": 6677,
    "verse_number": "5.55",
    "content_sanskrit": "महीपालचरं सार्धं वसिष्ठेन कृताहवम् । ब्रह्मर्षिभूयमापन्नं तपोभिरतिदारुणैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20010816,
    "chapter_id": 6677,
    "verse_number": "5.56",
    "content_sanskrit": "हुम्फारवकृताह्वायवत्सप्रातर्ह्ववाश्रवात् । स्तनैःस्नुवद्भिाराहावे पयःपीत्वोपसेदुषीः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20010817,
    "chapter_id": 6677,
    "verse_number": "5.57",
    "content_sanskrit": "वात्सल्येन प्रपश्यन्तं सौरभेयीस्तृणाङ्कुरान् । ताभ्यो दत्तेति जल्पन्तं शिष्यानासनवर्तिनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20010818,
    "chapter_id": 6677,
    "verse_number": "5.58",
    "content_sanskrit": "घातं सकललोकानां कर्तुमीशं तपोनिधिम् । सर्वरक्षोवधस्यैकहेतुं दाशरथेर्गुरुम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20010819,
    "chapter_id": 6677,
    "verse_number": "5.59",
    "content_sanskrit": "अकृतक्रतुसन्तानविघातं यातुभिर्भयात् । घनेन तपसा दीप्रं कृशैरपघनैर्युतम् ॥",
