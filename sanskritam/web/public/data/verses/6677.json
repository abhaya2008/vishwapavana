    "avatarnika": ""
  },
  {
    "id": 20010763,
    "chapter_id": 6677,
    "verse_number": "5.3",
    "content_sanskrit": "भुक्तार्द्रशष्पग्रासानां पीतनिर्झरपाथसाम् । विहारैरेणपोतानां परितोऽतिमनोहरम् ॥",
