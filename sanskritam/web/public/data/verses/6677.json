    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20010825,
    "chapter_id": 6677,
    "verse_number": "5.65",
    "content_sanskrit": "अनुप्त्रिमैः फलैर्मूलैश्शाकैश्च कृतजीवनम् । पक्त्रिमैर्देवतादीनामतिथीनाञ्चपूजकम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
