  {
    "id": 20010804,
    "chapter_id": 6677,
    "verse_number": "5.44",
    "content_sanskrit": "रम्यकादंबनिक्वाणै रमणीयालिनिक्वणैः । चारुचक्राह्वयक्वाणैर्बकादिक्वणवर्जितैः ॥",
