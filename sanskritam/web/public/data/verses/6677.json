    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20010810,
    "chapter_id": 6677,
    "verse_number": "5.50",
    "content_sanskrit": "एते गुर्वग्नि'होत्रास्रा समजोदजदक्षिणाः । दण्डिनः प्रमदाविष्टाः क्रीडन्त्यृषिकुमारकाः ॥",
