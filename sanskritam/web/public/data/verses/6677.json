    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20010764,
    "chapter_id": 6677,
    "verse_number": "5.4",
    "content_sanskrit": "संसारजं मुनिवरैरातपोत्थञ्च पादपैः । पूर्णं नुदद्भिस्सन्तापं देहभाजां महत्तमैः ॥",
