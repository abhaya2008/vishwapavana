    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20010786,
    "chapter_id": 6677,
    "verse_number": "5.26",
    "content_sanskrit": "मुनयो न शपन्तेत्र निग्राहस्ते भवत्विति । कञ्चिदत्यपराधेषि समग्रं दधतो दमम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20010787,
    "chapter_id": 6677,
    "verse_number": "5.27",
    "content_sanskrit": "पान्थानह क्षुधा पात्तप्रग्राहेणोपगच्छतः । नीवारान्नादिभिक्षामिर्मुनिपत्न्योऽर्चयन्त्यमूः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20010788,
    "chapter_id": 6677,
    "verse_number": "5.28",
    "content_sanskrit": "उत्तरादिपरिग्राहस्तुतिशास्त्रादिकोविदाः । यज्ञविद्याः पठन्त्यत्र क्वचित् केचिन्महर्षयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20010789,
    "chapter_id": 6677,
    "verse_number": "5.29",
    "content_sanskrit": "कम्पितान् प्लवगाप्लावैः पतगालिकृताप्लवान् । महीरुहान् महोच्छ्रायान् पश्यतेह समन्ततः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20010790,
    "chapter_id": 6677,
    "verse_number": "5.30",
    "content_sanskrit": "अत्रानवग्रहस्फीतखगारावारवैर्द्रुमाः । स्तुवन्तीवानवग्राहकरान् देवान् दिवंगताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20010791,
    "chapter_id": 6677,
    "verse_number": "5.31",
    "content_sanskrit": "यथार्जयति वित्तानि तुलाप्रग्राहभृद्वणिक् । तथा धिनोति संयत्तस्तपांसीह मुनिव्रजः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20010792,
    "chapter_id": 6677,
    "verse_number": "5.32",
    "content_sanskrit": "गुरुवाक्यैरमी रुद्धाः प्रग्राहैरिव वाजिनः । चमूरुचर्मप्रवरान् दधाना भान्ति वर्णिनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20010793,
    "chapter_id": 6677,
    "verse_number": "5.33",
    "content_sanskrit": "कुर्वन्त्यमी परिभवं वह्नेरेव न केवलम् । तेजसा तापसाः किन्तु परिभावं रवेरपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20010794,
    "chapter_id": 6677,
    "verse_number": "5.34",
    "content_sanskrit": "समिद्धोमपरा दण्डैर्वरपुष्पग्रहार्थिनः । वर्णिनो नमयन्त्येते विटपाग्राणि भूरुहाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20010795,
    "chapter_id": 6677,
    "verse_number": "5.35",
    "content_sanskrit": "यज्ञस्य साधनान्येते निर्वाग्विस्तरपाटवाः । बध्नन्ति प्रस्तरादीनि प्राज्ञा मुनिकुमारकाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20010796,
    "chapter_id": 6677,
    "verse_number": "5.36",
    "content_sanskrit": "निश्चयादागमार्थानामनघमोदरा इमे । धन्याः खल्वृषयो मूलफलादिविघसाशिनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20010797,
    "chapter_id": 6677,
    "verse_number": "5.37",
    "content_sanskrit": "'केचिदत्र मरुद्वासास्तपस्यन्ति महर्षयः । अपरे सलिलन्यादाः पर्णाश्मनिघसाः परे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20010798,
    "chapter_id": 6677,
    "verse_number": "5.38",
    "content_sanskrit": "केचित् सुधीरास्तासोढहिमवातातपव्यथाः । एकाङ्गुष्ठेन भूपृष्ठे तिष्ठन्तीहोर्ध्वबाहवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
