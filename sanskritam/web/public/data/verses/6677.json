    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20010765,
    "chapter_id": 6677,
    "verse_number": "5.5",
    "content_sanskrit": "अरण्यशालिनिश्चायैर्बहुभिर्भूषिताजिरम् । शिष्य'चक्रपरिक्षिप्तैरुपाध्यायैरलंकृतम् ॥",
