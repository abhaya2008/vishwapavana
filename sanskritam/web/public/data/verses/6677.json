    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20010770,
    "chapter_id": 6677,
    "verse_number": "5.10",
    "content_sanskrit": "नवश्यामलशष्पालीनिगारोद्गारदक्षिणैः । रोमन्थायितुमासीनैः कुरङ्गै राजिताजिरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20010771,
    "chapter_id": 6677,
    "verse_number": "5.11",
    "content_sanskrit": "जितरुद्रजटाभारैर्विशालकपिलोन्नतैः । क्वचिन्नीवारधान्यानामुत्कारैरुपशोभितम् ॥",
