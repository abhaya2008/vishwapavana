    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20010820,
    "chapter_id": 6677,
    "verse_number": "5.60",
    "content_sanskrit": "नृपतेः परिघाकारं यद्बभूव भुजद्वयम् । कृशं तदा कृशोपघ्नं 'तद्दधानं तदायतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20010821,
    "chapter_id": 6677,
    "verse_number": "5.61",
    "content_sanskrit": "द्विपां स्तंबघनं चम्वास्तंबघ्नमपि बर्हिषाम् । अन्तर्घणादिदेशज्ञं खड्गग्रहकिणाङ्कितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20010822,
    "chapter_id": 6677,
    "verse_number": "5.62",
    "content_sanskrit": "उपप्रघ्राणमासीनं निषण्णान् प्रघणे मृगान् । कण्डूयमानमेकेन पवित्राङ्केन पाणिना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20010823,
    "chapter_id": 6677,
    "verse_number": "5.63",
    "content_sanskrit": "न्यस्योद्घनेषु दारुणि कृन्तद्भिस्समिधस्तथा । द्रुघणैस्संवृतं शिष्यैर्वेदपाठपरायणैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20010824,
    "chapter_id": 6677,
    "verse_number": "5.64",
    "content_sanskrit": "निघस्याधस्तरूद्घस्य निविष्टं कुट्टिमे समे । संघेन तापसोद्घानां भक्तिप्रह्वेण सेवितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
