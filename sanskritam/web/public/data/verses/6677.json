    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20010766,
    "chapter_id": 6677,
    "verse_number": "5.6",
    "content_sanskrit": "खगसारङ्गसंरावसन्द्रावसुमनोहरम् । दामश्रायपवित्रर्षिभावापहृतकल्मषम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20010767,
    "chapter_id": 6677,
    "verse_number": "5.7",
    "content_sanskrit": "गंभीरशब्दविश्रावजातप्रस्रावपावनैः । अग्निहोत्रगवीयूथैर्महर्षीणां परिष्कृतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20010768,
    "chapter_id": 6677,
    "verse_number": "5.8",
    "content_sanskrit": "पूर्णं वायूल्लसच्छाखाहस्तोन्नायविचक्षणैः । नटैरिव प्रनृत्यद्भिर्द्रुमैः कुसुमभूषितैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20010769,
    "chapter_id": 6677,
    "verse_number": "5.9",
    "content_sanskrit": "अग्निहोत्रगवीनायक्रीडालोलैरलंकृतम् । कुशाभिलावनिष्पावकुशलैश्चर्षिदारकैः ॥",
