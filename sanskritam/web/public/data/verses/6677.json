    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20010772,
    "chapter_id": 6677,
    "verse_number": "5.12",
    "content_sanskrit": "संस्तावमिव गायद्भिर्द्विजैर्मधुरमन्वितम् । लतातरुच्युतानेकपुष्पप्रस्तारपूरितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20010773,
    "chapter_id": 6677,
    "verse_number": "5.13",
    "content_sanskrit": "शुचिविस्तारवद्वल्कवसनर्धिबभृज्जनम् । घृष्टविष्टारपंक्त्यादिच्छन्दोभेदज्ञपण्डितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20010774,
    "chapter_id": 6677,
    "verse_number": "5.14",
    "content_sanskrit": "किञ्चिदुच्चलतावृक्षकुसुमोद्ग्राहकोविदैः । अलंकृतमृषिस्त्रैणैर्बाहूत्क्षेपस्फुटस्तनैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20010775,
    "chapter_id": 6677,
    "verse_number": "5.15",
    "content_sanskrit": "संग्राहोढारिरक्ताक्तनखरैरिव योद्धृभिः । स्थिरशाखाग्रभाक्पुष्पैः किंशुकैरुपशोभितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20010776,
    "chapter_id": 6677,
    "verse_number": "5.16",
    "content_sanskrit": "अवघ्नतीभिर्नीवारानुलूखलबिले कृतान् । तापसीभिस्सहुंकारं पर्यायेण परिष्कृतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20010777,
    "chapter_id": 6677,
    "verse_number": "5.17",
    "content_sanskrit": "द्यूतज्ञैरपि शाराणां परिणायानकर्तृभिः । लोकशास्त्रगतन्यायविशेषेषु विशारदैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20010778,
    "chapter_id": 6677,
    "verse_number": "5.18",
    "content_sanskrit": "वराप्सरोविशायेपि निस्पृहैस्तपसि स्थितैः । मुनिसंघैः क्वचिद्दीप्तं पुष्णद्भिर्ब्रह्मवर्चसम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20010779,
    "chapter_id": 6677,
    "verse_number": "5.19",
    "content_sanskrit": "उर्वश्यादिद्युवेश्यानामुपशायफलन्तपः । तन्वद्भिरग्निसंकाशैर्मण्डितं मुनिभिः क्वचित् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20010780,
    "chapter_id": 6677,
    "verse_number": "5.20",
    "content_sanskrit": "पुष्पप्रचायं भूमिष्ठैः कुर्वद्भिः खर्वशाखिनाम् । मुनीनां सुकुमारीकैः कुमारैर्भूषितं क्वचित् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20010781,
    "chapter_id": 6677,
    "verse_number": "5.21",
    "content_sanskrit": "सेकसंवर्ध्यमानेषु वामनेष्वपि शाखिषु । मुनिशापभिया चोरैर्मुक्तस्वादुफलोचयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20010782,
    "chapter_id": 6677,
    "verse_number": "5.22",
    "content_sanskrit": "तदाश्रमपदं दृष्ट्वा सन्तुष्टः पाकशासनः । सुहृन्निकायमालोक्य प्रविशन्निदमब्रवीत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20010783,
    "chapter_id": 6677,
    "verse_number": "5.23",
    "content_sanskrit": "निकायेस्मिन् महर्षीणां निकार्यं पश्यत द्विजाः । काये मलनिकायेऽलं विरक्तानां तपस्यताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20010784,
    "chapter_id": 6677,
    "verse_number": "5.24",
    "content_sanskrit": "आकाङ्क्षयन्नग्निचित्यामृष्टे हृदयदर्पणे । वेदान्तव्यवहारीभिस्तत्त्वं तत्पश्यतां वरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20010785,
    "chapter_id": 6677,
    "verse_number": "5.25",
    "content_sanskrit": "वेदाक्षरण्यश्रीयीनाश्शारिकामिलिताश्शुकाः । संरावणममी कुर्वन्त्यृषिपुत्रैस्सुशिक्षिताः ॥",
