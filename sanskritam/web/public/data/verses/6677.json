    "avatarnika": ""
  },
  {
    "id": 20010805,
    "chapter_id": 6677,
    "verse_number": "5.45",
    "content_sanskrit": "आकरैः स्वर्णपद्मानां विकासिभिरुपेतया । रमणीयं पवित्रञ्च गङ्गया सिन्धुमुख्यया ॥",
