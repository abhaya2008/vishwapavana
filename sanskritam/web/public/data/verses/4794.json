[{"id": 2179211, "chapter_id": 4794, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2179212, "chapter_id": 4794, "verse_number": "१", "content_sanskrit": "अत्रैवोदाहरन्तीममितिहासं पुरातनम् ।\nतापसैः सह संवादं शक्रस्य भरतर्षभ\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2179213, "chapter_id": 4794, "verse_number": "२", "content_sanskrit": "केचिद् गृहान् परित्यज्य वनमभ्यगमन् द्विजाः ।\nअजातश्मश्रवो मन्दाः कुले जाताः प्रवव्रजुः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2179214, "chapter_id": 4794, "verse_number": "३", "content_sanskrit": "धर्मोऽयमिति मन्वाना ब्रह्मचर्ये व्यवस्थिताः ।\nत्यक्त्वा गृहान् पितॄंश्चैव तानिन्द्रोऽन्वकृपायत\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2179215, "chapter_id": 4794, "verse_number": "४", "content_sanskrit": "तानाबभाषे भगवान् पक्षी भूत्वा हिरण्मयः ।\nसुदुष्करं मनुष्यैश्च यत् कृतं विघसाशिभिः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2179216, "chapter_id": 4794, "verse_number": "५", "content_sanskrit": "पुण्यं च बत कर्मैषां प्रशस्तं चैव जीवितम् ।\nसंसिद्धास्ते गतिं मुख्यां प्राप्ता धर्मपरायणाः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2179217, "chapter_id": 4794, "verse_number": "", "content_sanskrit": "ऋषयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2179218, "chapter_id": 4794, "verse_number": "६", "content_sanskrit": "अहो बतायं शकुनिर्विघसाशान् प्रशंसति ।\nअस्मान्नूनमयं शास्ति वयं हि विघसाशिनः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2179219, "chapter_id": 4794, "verse_number": "", "content_sanskrit": "शकुनिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2179220, "chapter_id": 4794, "verse_number": "७", "content_sanskrit": "नाहं युष्मान् प्रशंसामि पङ्कदिग्धान् रजस्वलान् ।\nउच्छिष्टभोजिनो मन्दानन्ये वै विघसाशिनः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2179221, "chapter_id": 4794, "verse_number": "", "content_sanskrit": "ऋषयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2179222, "chapter_id": 4794, "verse_number": "८", "content_sanskrit": "दृढं श्रेयः परमिति वयमेवाभ्युपास्महे ।\nशकुने ब्रूहि यच्छ्रेयो भृशं वै श्रद्दधाम ते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2179223, "chapter_id": 4794, "verse_number": "", "content_sanskrit": "शकुनिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2179224, "chapter_id": 4794, "verse_number": "९", "content_sanskrit": "यदि मां नाभिशङ्कध्वं विभज्यात्मानमात्मना ।\nततोऽहं वः प्रवक्ष्यामि याथातथ्यं हितं वचः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2179225, "chapter_id": 4794, "verse_number": "", "content_sanskrit": "ऋषयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2179226, "chapter_id": 4794, "verse_number": "१०", "content_sanskrit": "शृणुमस्ते वचस्तात पन्थानो विदितास्तव ।\nनियोगे चैव धर्मात्मन् स्थातुमिच्छाम शाधि नः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2179227, "chapter_id": 4794, "verse_number": "", "content_sanskrit": "शकुनिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2179228, "chapter_id": 4794, "verse_number": "११", "content_sanskrit": "चतुष्पदां गौः प्रवरा लोहानां काञ्चनं वरम् ।\nशब्दानां प्रवरो मन्त्रो ब्राह्मणो द्विपदां वरः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2179229, "chapter_id": 4794, "verse_number": "१२", "content_sanskrit": "मन्त्रोऽयं जातकर्मादि ब्राह्मणस्य विधीयते ।\nजीवतो यो यथाकालं श्मशाननिधनादिति\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2179230, "chapter_id": 4794, "verse_number": "१३", "content_sanskrit": "कर्माणि वैदिकान्यस्य स्वर्ग्यः पन्थास्त्वनुत्तमः ।\nअथ सर्वाणि कर्माणि मन्त्रसिद्धानि चक्षते\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2179231, "chapter_id": 4794, "verse_number": "१४", "content_sanskrit": "आम्नायदृढवादीनि तथा सिद्धिरिहेष्यते ।\nमासार्धमासा ऋतव आदित्यशशितारकम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2179232, "chapter_id": 4794, "verse_number": "१५", "content_sanskrit": "ईहन्ते सर्वभूतानि तदृतं कर्मसङ्गिनाम् ।\nसिद्धिक्षेत्रमिदं पुण्यमयमेवाश्रमो महान्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2179233, "chapter_id": 4794, "verse_number": "१६", "content_sanskrit": "अथ ये कर्म निन्दन्तो मनुष्याः कापथं गताः ।\nमूढानामर्थहीनानां तेषामेनस्तु विद्यते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2179234, "chapter_id": 4794, "verse_number": "१७", "content_sanskrit": "देववंशान् पितृवंशान् ब्रह्मवंशांश्च शाश्वतान् ।\nसन्त्यज्य मूढा वर्तन्ते ततो यान्त्यश्रुतीपथम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2179235, "chapter_id": 4794, "verse_number": "१८", "content_sanskrit": "एतद् वोऽस्तु तपो युक्तं ददानीत्यृषिचोदितम् ।\nतस्मात् तदध्यवसतस्तपस्वि तप उच्यते\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2179236, "chapter_id": 4794, "verse_number": "१९", "content_sanskrit": "देवंशान् पितृवंशान् ब्रह्मवंशांश्च शाश्वतान् ।\nसंविभज्य गुरोश्चर्यां तद् वै दुष्करमुच्यते\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2179237, "chapter_id": 4794, "verse_number": "२०", "content_sanskrit": "देवा वै दुष्करं कृत्वा विभूतिं परमां गताः ।\nतस्माद् गार्हस्थ्यमुद्वोढुं दुष्करं प्रब्रवीमि वः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2179238, "chapter_id": 4794, "verse_number": "२१", "content_sanskrit": "तपः श्रेष्ठं प्रजानां हि मूलमेतन्न संशयः ।\nकुटुम्बविधिनानेन यस्मिन् सर्वं प्रतिष्ठितम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2179239, "chapter_id": 4794, "verse_number": "२२", "content_sanskrit": "एतद् विदुस्तपो विप्रा द्वन्द्वातीता विमत्सराः ।\nएतस्माद् वनमध्ये तु लोकेषु तप उच्यते\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2179240, "chapter_id": 4794, "verse_number": "२३", "content_sanskrit": "दुराधर्षं पदं चैव गच्छन्ति विघसाशिनः ।\nसायंप्रातर्विभज्यान्नं स्वकुटुम्बे यथाविधि\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2179241, "chapter_id": 4794, "verse_number": "२४", "content_sanskrit": "दत्वातिथिभ्यो देवेभ्यः पितृभ्यः स्वजनस्य च ।\nअवशिष्टानि येऽश्नन्ति तानाहुर्विघसाशिनः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2179242, "chapter_id": 4794, "verse_number": "२५", "content_sanskrit": "तस्मात् स्वधर्ममास्थाय सुव्रताः सत्यवादिनः ।\nलोकस्य गुरवो भूत्वा ते भवन्त्यनुपस्कृताः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2179243, "chapter_id": 4794, "verse_number": "२६", "content_sanskrit": "तस्मात् स्वधर्ममास्थाय सुव्रताः सत्यवादिनः ।\nलोकस्य गुरवो भूत्वा ते भवन्त्यनुपस्कृताः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2179244, "chapter_id": 4794, "verse_number": "२७", "content_sanskrit": "त्रिदिवं प्राप्य शक्रस्य स्वर्गलोके विमत्सराः ।\nवसन्ति शाश्वतीर्वर्षा जना दुष्करकारिणः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2179245, "chapter_id": 4794, "verse_number": "२८", "content_sanskrit": "ततस्ते तद् वचः श्रुत्वा तस्य धर्मार्थसंहितम् ।\nउत्सृज्य नास्तिकगतिं गार्हस्थ्यं धर्ममाश्रिताः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2179246, "chapter_id": 4794, "verse_number": "२९", "content_sanskrit": "तस्मात् त्वमपि दुर्धर्षं धैर्यमालम्ब्य शाश्वतम् ।\nप्रशाधि पृथिवीं कृत्स्नां हतामित्रां नरोत्तम\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2179247, "chapter_id": 4794, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे एकादशोऽध्यायः ॥ ११ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]