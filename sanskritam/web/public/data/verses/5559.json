[{"id": 2213494, "chapter_id": 5559, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2213495, "chapter_id": 5559, "verse_number": "१", "content_sanskrit": "तच्छ्रुत्वा विविधं तस्य राजर्षेः परिदेवितम् ।\nपुनर्नवीकृतः शोको गान्धार्या जनमेजय\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2213496, "chapter_id": 5559, "verse_number": "२", "content_sanskrit": "कुन्त्या द्रुपदपुत्र्याश्च सुभद्रायास्तथैव च ।\nतासां च वरनारीणां वधूनां कौरवस्य च\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2213497, "chapter_id": 5559, "verse_number": "३", "content_sanskrit": "पुत्रशोकसमाविष्टा गान्धारी त्विदमब्रवीत् ।\nश्वशुरं बद्धनयना देवी प्राञ्जलिरुत्थिता\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2213498, "chapter_id": 5559, "verse_number": "४", "content_sanskrit": "लोकान्तरगतान् पुत्रानयं काङ्क्षति मानद ।\nतच्चास्य मानसं ज्ञातं भगवंस्तपसा त्वया\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2213499, "chapter_id": 5559, "verse_number": "५", "content_sanskrit": "षोडशेमानि वर्षाणि गतानि मुनिपुङ्गव ।\nअस्य राज्ञो हतान् पुत्रान् शोचतो न शमो विभो\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2213500, "chapter_id": 5559, "verse_number": "६", "content_sanskrit": "पुत्रशोकसमाविष्टो निःश्वसन् ह्येष भूमिपः ।\nन शेते वसतीः सर्वा धृतराष्ट्रो महामुने\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2213501, "chapter_id": 5559, "verse_number": "७", "content_sanskrit": "लोकानन्यान् समर्थोसि स्प्रष्टुं सर्वांस्तपोबलात् ।\nकिमु लोकान्तरगतान् राज्ञो दर्शयितुं सुतान्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2213502, "chapter_id": 5559, "verse_number": "८", "content_sanskrit": "इयं च द्रौपदी कृष्णा हतज्ञातिसुता भृशम् ।\nशोचत्यतीव सर्वासां स्नुषाणां दयिता स्नुषा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2213503, "chapter_id": 5559, "verse_number": "९", "content_sanskrit": "तथा कृष्णस्य भगिनी सुभद्रा भद्रभाषिणी ।\nसौभद्रवधसन्तप्ता भृशं शोचति भामिनी\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2213504, "chapter_id": 5559, "verse_number": "१०", "content_sanskrit": "इयं च भूरिश्रवसो भार्या परमसम्मता ।\nभर्तृव्यसनशोकार्ता भृशं शोचति भामिनी\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2213505, "chapter_id": 5559, "verse_number": "११", "content_sanskrit": "यस्यास्तु श्वशुरो धीमान् बाह्लिकः स कुरूद्वहः ।\nनिहतः सोमदत्तश्च पित्रा सह महारणे\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2213506, "chapter_id": 5559, "verse_number": "१२", "content_sanskrit": "श्रीमतोस्य महाबुद्धेः सङ्ग्रामेष्वपलायिनः ।\nपुत्रस्य ते पुत्रशतं निहतं यद् रणाजिरे\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2213507, "chapter_id": 5559, "verse_number": "१३", "content_sanskrit": "तस्य भार्याशतमिदं दुःखशोकसमाहतम् ।\nपुनःपुनर्वर्धयानं शोकं राज्ञो ममैव च ।\nहताहारेण महता मामुपास्ते महामुने\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2213508, "chapter_id": 5559, "verse_number": "१४", "content_sanskrit": "ये च शूरा महात्मानः श्वशुरा मे महारथाः ।\nसोमदत्तप्रभृतयः का नु तेषां गतिः प्रभो\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2213509, "chapter_id": 5559, "verse_number": "१५", "content_sanskrit": "तव प्रसादाद् भगवन् विशोकोऽयं महीपतिः ।\nकुर्यात् कालमहं चेयं वधूस्तव महामुने\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2213510, "chapter_id": 5559, "verse_number": "१६", "content_sanskrit": "इत्युक्तवत्यां गान्धार्यां कुन्ती व्रतकृशानना ।\nप्रच्छन्नजातं पुत्रं तं सस्मारादित्यसन्निभम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2213511, "chapter_id": 5559, "verse_number": "१७", "content_sanskrit": "तामृषिर्वरदो व्यासो दूरश्रवणदर्शनः ।\nअपश्यद् दुःखितां देवीं मातरं सव्यसाचिनः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2213512, "chapter_id": 5559, "verse_number": "१८", "content_sanskrit": "तामुवाच ततो व्यासो यत्ते कार्यं विवक्षितम् ।\nतद् ब्रूहि त्वं महाभागे यत्ते मनसि वर्तते\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2213513, "chapter_id": 5559, "verse_number": "१९", "content_sanskrit": "श्वशुराय ततः कुन्ती प्रणम्य शिरसा तदा ।\nउवाच वाक्यं सव्रीडा विवृण्वाना पुरातनम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2213514, "chapter_id": 5559, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्रमवासिकपर्वणि\nगान्धारीवचनं नाम पञ्चत्रिंशोऽध्यायः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2213515, "chapter_id": 5559, "verse_number": "", "content_sanskrit": "पुत्रदर्शनपर्वणि द्वितीयोऽध्यायः ॥२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]