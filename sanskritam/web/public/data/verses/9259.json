[{"id": 40017199, "chapter_id": 9259, "verse_number": "1", "content_sanskrit": "स्वबलंव्यथितंदृष्टवातुमुलंरोमहर्षणम् । भ्रातृ़ंश्चनिहतान् दृष्टवाशक्रतुल्यपराक्रमान् ॥ पितृव्यौचापिसनृदृश्यसमरेसन्निघादितौ । युद्धोन्मत्तं च मत्तं च भ्रातरौराक्षसर्षभौ ॥ चुकोप च महातेजाब्रह्मदत्तवरोयुधि । अतिकायोऽद्रिसङ्काशोदेवदानवदर्पहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40017200, "chapter_id": 9259, "verse_number": "2", "content_sanskrit": "स्वबलंव्यथितंदृष्टवातुमुलंरोमहर्षणम् । भ्रातृ़ंश्चनिहतान् दृष्टवाशक्रतुल्यपराक्रमान् ॥ पितृव्यौचापिसनृदृश्यसमरेसन्निघादितौ । युद्धोन्मत्तं च मत्तं च भ्रातरौराक्षसर्षभौ ॥ चुकोप च महातेजाब्रह्मदत्तवरोयुधि । अतिकायोऽद्रिसङ्काशोदेवदानवदर्पहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40017201, "chapter_id": 9259, "verse_number": "3", "content_sanskrit": "स्वबलंव्यथितंदृष्टवातुमुलंरोमहर्षणम् । भ्रातृ़ंश्चनिहतान् दृष्टवाशक्रतुल्यपराक्रमान् ॥ पितृव्यौचापिसनृदृश्यसमरेसन्निघादितौ । युद्धोन्मत्तं च मत्तं च भ्रातरौराक्षसर्षभौ ॥ चुकोप च महातेजाब्रह्मदत्तवरोयुधि । अतिकायोऽद्रिसङ्काशोदेवदानवदर्पहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40017202, "chapter_id": 9259, "verse_number": "4", "content_sanskrit": "स भास्करसहस्रस्यसङ्घातमिवभास्वरम् । रथमास्थायशक्रारिरभिदुद्राववानरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40017203, "chapter_id": 9259, "verse_number": "5", "content_sanskrit": "स विस्फार्यमहाचापंकिरीटीमृष्टकुण्डलः । नामविश्रावयामासननाद च महास्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40017204, "chapter_id": 9259, "verse_number": "6", "content_sanskrit": "तेनसिंहप्रणादेननामविश्रावणेन च । ज्याशब्देन च भीमेनत्रासयामासवानरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40017205, "chapter_id": 9259, "verse_number": "7", "content_sanskrit": "तेदृष्टवादेहमाहात्म्यंकुम्भकर्णोऽयमुथतितः । भयार्तावानरास्सर्वेसंश्रयन्तेपरस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40017206, "chapter_id": 9259, "verse_number": "8", "content_sanskrit": "तेतस्यरूपमालोक्ययथाविष्टोस्त्रिविक्रमे । भयाद्वानरयूधास्तेविद्रवन्तिततस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40017207, "chapter_id": 9259, "verse_number": "9", "content_sanskrit": "तेऽतिकायंसमासाद्यवानरामूढचेतसः । शरण्यंशरणंजग्मुर्लक्ष्मणाग्रजमाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40017208, "chapter_id": 9259, "verse_number": "10", "content_sanskrit": "तोऽतिकायंकाकुत्स्थोरथस्थंपर्वतोपमम् । ददर्शधवनिनंदूराद्गर्जन्तंकालमेघवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40017209, "chapter_id": 9259, "verse_number": "11", "content_sanskrit": "स तंदृष्टवामहात्मानंराघवस्तुविसिस्मिये । वानरान् सान्त्वयित्वा च विभीषणमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40017210, "chapter_id": 9259, "verse_number": "12", "content_sanskrit": "कोऽसौपर्वतसङ्काशोधनुष्मान्हरिलोचनः । युक्तेहयसहस्रेणविशालेस्यन्दनेस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40017211, "chapter_id": 9259, "verse_number": "13", "content_sanskrit": "य एषनिशितैश्शूलैस्सुतीक्णैःप्रासमुद्गरैः । अर्चिष्मद्भिर्वृतोभातिभूतैरिवमहेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40017212, "chapter_id": 9259, "verse_number": "14", "content_sanskrit": "कालजिह्वाप्रकाशाभिर्यएषोऽतिविराजते । आवृतोरथशक्तीभिर्विद्युद्भिरिवतोयदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40017213, "chapter_id": 9259, "verse_number": "15", "content_sanskrit": "धनूंषिचास्यसज्जानिहेमपृष्ठानिसर्वशः । शोभयन्तिरथश्रेष्ठंशक्रचापमिवाम्बरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40017214, "chapter_id": 9259, "verse_number": "16", "content_sanskrit": "क एषरक्षश्शार्दूलोरणभूमिविराजयन् । अभ्येतिरथिनांश्रेष्ठोरथेनादित्यतेजसा ॥ ध्वजशृङ्गप्रतिष्ठेनराहुणाभिविराजते । सूर्यरमशिनिभैर्बाणैर्दिशो दश विराजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40017215, "chapter_id": 9259, "verse_number": "17", "content_sanskrit": "क एषरक्षश्शार्दूलोरणभूमिविराजयन् । अभ्येतिरथिनांश्रेष्ठोरथेनादित्यतेजसा ॥ ध्वजशृङ्गप्रतिष्ठेनराहुणाभिविराजते । सूर्यरमशिनिभैर्बाणैर्दिशो दश विराजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40017216, "chapter_id": 9259, "verse_number": "18", "content_sanskrit": "त्रिणतंमेघसन्नादंहेमपृष्ठमलङ्कृतम् । शतक्रतुधनुःप्रख्यंधनुश्चास्यविराजते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40017217, "chapter_id": 9259, "verse_number": "19", "content_sanskrit": "स ध्वजस्सपताकश्चसानुकर्षोमहारथः । चतुस्सादिसमायुक्तोमेघस्तनितानि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40017218, "chapter_id": 9259, "verse_number": "20", "content_sanskrit": "विंशतिर्दशचाष्टौ च तूण्योऽस्यरथमास्थिताः । कार्मुकानि च भीमानिज्याश्चकाञ्चनपिङ्गळाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40017219, "chapter_id": 9259, "verse_number": "21", "content_sanskrit": "द्वौ च खडगौरथगतौपार्श्वस्थौपार्श्वशोभितौ । चतुर्हस्तत्सरुयुतौव्यक्तहस्तदशायतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40017220, "chapter_id": 9259, "verse_number": "22", "content_sanskrit": "रक्तगण्ठगुणोधीरोमहापर्वतसन्निभः । कालःकालमहावक्त्रोमेघस्थइवभास्करः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40017221, "chapter_id": 9259, "verse_number": "23", "content_sanskrit": "काञ्चनाङ्गदनद्धाभ्यांभूजाभ्यामेषशोभते । शृङ्गाभ्यामिवतुङ्गाभ्यांहिमवान् पर्वतोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40017222, "chapter_id": 9259, "verse_number": "24", "content_sanskrit": "कुण्डलाभ्यांतुयस्यैतद्भतध्भातिशुभेक्ष । पुनर्वस्वन्तरगतंपूर्णंभिंबमिवैंदवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40017223, "chapter_id": 9259, "verse_number": "25", "content_sanskrit": "आचक्ष्वमेमहाबाहोत्वमेनंराक्षसोत्तमम् । यंदृष्टवावानरास्सर्वेभयार्ताविद्रुतादिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40017224, "chapter_id": 9259, "verse_number": "26", "content_sanskrit": "स पृष्टोराजपुत्रेणरामेणामिततेजसा । आचचक्षेमहातेजारघवायविभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40017225, "chapter_id": 9259, "verse_number": "27", "content_sanskrit": "दशग्रीवोमहातेजाराजावैश्रवणानुजः । भीमकर्मामहोत्साहोरावणोराक्षसाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40017226, "chapter_id": 9259, "verse_number": "28", "content_sanskrit": "तस्यासीद्वीर्यवान्पुत्रोरावणप्रतिमोरणे । वृद्धसेवीश्रुतिधरस्सर्वास्त्रविदुषांवरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40017227, "chapter_id": 9259, "verse_number": "29", "content_sanskrit": "अश्वपृष्ठेरथेनागेखडगेधनुषिकर्षणे । भेदेसान्त्वे च दाने च नयेमन्त्रे च सम्मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40017228, "chapter_id": 9259, "verse_number": "30", "content_sanskrit": "यस्यबाहूसमाश्रित्यलङ्कावसतिनिर्भया । तनयंधान्यमालिन्याअतिकायमिमंविदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40017229, "chapter_id": 9259, "verse_number": "31", "content_sanskrit": "एतेनाराधितोब्रह्मोतपसाभावितात्मना । अस्त्राणिचाप्यवाप्तानिरिपवश्चपराजिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40017230, "chapter_id": 9259, "verse_number": "32", "content_sanskrit": "सुरासुरैरवध्यत्वंदत्तमस्मैस्वयम्भुवा । एतच्चकवचंदिव्यंरधश्चैषोऽरभास्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40017231, "chapter_id": 9259, "verse_number": "33", "content_sanskrit": "एतेनशतशोदेवादानवाश्चपराजिताः । रक्षितानि च रक्षांसियक्षाश्चापिनिषूदिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40017232, "chapter_id": 9259, "verse_number": "34", "content_sanskrit": "वज्रंविष्टम्भितंयेनबाणैरिन्द्रस्यधीमतः । पाशस्सलिलराजस्यरणेप्रतिहतस्तथा ॥ एषोऽतिकायोबलवान्राक्षसानामथर्षभः । रावणस्यतोधीमान्देवदानवदर्पहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40017233, "chapter_id": 9259, "verse_number": "35", "content_sanskrit": "वज्रंविष्टम्भितंयेनबाणैरिन्द्रस्यधीमतः । पाशस्सलिलराजस्यरणेप्रतिहतस्तथा ॥ एषोऽतिकायोबलवान्राक्षसानामथर्षभः । रावणस्यतोधीमान्देवदानवदर्पहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40017234, "chapter_id": 9259, "verse_number": "36", "content_sanskrit": "तदस्मिन्क्रियतांयत्नःक्षिप्रंपुरुषपुंगव । पुरावानरसैन्यानिक्ष्यंनयतिसायकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40017235, "chapter_id": 9259, "verse_number": "37", "content_sanskrit": "ततोतिकायोबलवान्प्रविश्यहरिवाहिनीम् । विष्फारयामासधनुर्ननाद च पुनःपुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40017236, "chapter_id": 9259, "verse_number": "38", "content_sanskrit": "तंभीमवपुषंदृष्टवारथस्थंरथिनांवरम् । अभिपेतुर्महात्मानोयेप्रधानावनौकसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40017237, "chapter_id": 9259, "verse_number": "39", "content_sanskrit": "कुमुदोद्विविदोमैन्दोनीलश्शरभएव च । पादपैर्गिरिशृङ्गैश्चयुगपत्समभिद्रवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40017238, "chapter_id": 9259, "verse_number": "40", "content_sanskrit": "तेषांवृक्षांश्चशैलांश्चशरैःकाञ्चनभूषणैः । अतिकायोमहातेजाश्चिच्छेदास्त्रविदांवरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40017239, "chapter_id": 9259, "verse_number": "41", "content_sanskrit": "तांश्चैवसर्वान् स हरीन् शरैस्सर्वायसैर्बली । विव्याथाभिमुखस्सङ्ख्येभीमकायोनिशाचर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40017240, "chapter_id": 9259, "verse_number": "42", "content_sanskrit": "तेऽर्दितांबाणवर्षेणभिन्नगात्राःप्लवङ्गमाः । न शेकुरतिकायस्यप्रतिकर्तुंमहारणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 40017241, "chapter_id": 9259, "verse_number": "43", "content_sanskrit": "तत् त्सैन्यंहरिवीराणांत्रासयामासराक्षसः । मृगयूथमिवक्रुद्धोहरिर्यौवनदर्पितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 40017242, "chapter_id": 9259, "verse_number": "44", "content_sanskrit": "सराक्षसेन्द्रोहरिसैन्यमध्येनायुध्यमानंनिजघानकञ्चित् । उपेत्यरामंसधम: कलापी स गर्वितंवाक्यमिदंबभाषे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 40017243, "chapter_id": 9259, "verse_number": "45", "content_sanskrit": "रथेस्थितोहंशरचापपाणिर्नप्राकृतंकञ्चनयोधयामि । यस्यास्तिकश्चिद्व्यवसाययुक्तोददातुमेक्षिप्रमिहाद्ययुद्धम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 40017244, "chapter_id": 9259, "verse_number": "46", "content_sanskrit": "तत्तस्यवाक्यंब्रुवतोनिशम्यचुकोपसौमित्रिरमित्रहन्ता । अमृष्यमाणश्चसमुत्पपातजग्राहचापं च ततस्स्मयित्वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 40017245, "chapter_id": 9259, "verse_number": "47", "content_sanskrit": "क्रुद्धस्सौमित्रिरुत्पत्यतूणादाक्षिप्यसायकम् । पुरस्तादतिकायस्यविचकर्षमहद्धनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 40017246, "chapter_id": 9259, "verse_number": "48", "content_sanskrit": "पूरयन् स महींशैलानाकाशंसागरंदिशः । ज्याशब्दोलक्ष्मणस्योग्रस्त्रासयन् रजनीचरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 40017247, "chapter_id": 9259, "verse_number": "49", "content_sanskrit": "सौमित्रेश्चापनिर्घोषंश्रुत्वाप्रतिभयंतदा । विसिष्मियेमहातेजाराक्षसेन्द्रात्मजोबली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 40017248, "chapter_id": 9259, "verse_number": "50", "content_sanskrit": "अथातिकायःकुपितोदृष्टवालक्ष्मणमुत्थितम् । आदायनिशितंबाणमिदंवचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 40017249, "chapter_id": 9259, "verse_number": "51", "content_sanskrit": "बालस्त्वमसिसौमित्रेविक्रमेष्वविचक्षणः । गच्छकिंकालसदृशंमांयोधयतुमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 40017250, "chapter_id": 9259, "verse_number": "52", "content_sanskrit": "न हिमद्बाहुसृष्टानामस्त्राणाहिमवानपि । सोढुमुत्सहतेवेगमन्तरिक्षमथोमही ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 40017251, "chapter_id": 9259, "verse_number": "53", "content_sanskrit": "सुखप्रसुप्तंकालाग्निंविबोधयितुमिच्छसि । न्यस्यचापंनिवर्तस्वमाप्राणान् जहिमद्गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 40017252, "chapter_id": 9259, "verse_number": "54", "content_sanskrit": "अथवात्वंप्रतिष्टब्धो न निवर्तितुमिच्छसि । तिष्ठप्राणान् परित्यज्यगमिष्यसियमक्ष्यम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 40017253, "chapter_id": 9259, "verse_number": "55", "content_sanskrit": "पश्यमेनिशितान्बाणानरिदर्पनिषूदनान् । ईश्वरायुधसङ्काशांस्तप्तकाञ्चनभूषणान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 40017254, "chapter_id": 9259, "verse_number": "56", "content_sanskrit": "एषतेसर्पसंकाशोबाणःपास्यतिशोणितम् । मृगराजइवक्रुद्धोनागराजस्यशोणितम् ॥ इत्येवमुक्त्वासंक्रुद्धश्शरंधनुषिसंदधे ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 40017255, "chapter_id": 9259, "verse_number": "57", "content_sanskrit": "श्रुत्वातिकायस्यवचस्सरोषंसगर्वितंसम्यतिराजपुत्रः । स सञ्चुकोपातिबलोमनस्वीरुवाचवाक्यं च ततोमहार्थम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 40017256, "chapter_id": 9259, "verse_number": "58", "content_sanskrit": "न वाक्यमात्रेणभवान् प्रधानो न कत्थनात्सत्पुरुषाभवन्ति । मयिस्थितेधन्विनिबाणपाणौनिदर्शयस्वात्मबलंदुरात्मन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 40017257, "chapter_id": 9259, "verse_number": "59", "content_sanskrit": "कर्मणासूचयात्मानं न विकत्थितुमर्हसि । पौरुषेणतुयोयुक्तस्सतुशूरइतिस्मृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 40017258, "chapter_id": 9259, "verse_number": "60", "content_sanskrit": "सर्वायुधसमायुक्तोधन्वीत्वंरथमास्थितः । शरैर्वायदिवाप्यस्त्रैर्दर्शयस्वपराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 40017259, "chapter_id": 9259, "verse_number": "61", "content_sanskrit": "ततश्शिरस्तेनिशितैःपातयिष्याम्यहंशरैः । मारुतःकालसम्पक्वंवृन्तात्ताळफलंयथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 40017260, "chapter_id": 9259, "verse_number": "62", "content_sanskrit": "अद्यतेमामकाबाणास्तप्तकाञ्चनभूषणाः । पास्यन्तिरुधिरंगात्राद्बाणशल्यान्तरोत्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 40017261, "chapter_id": 9259, "verse_number": "63", "content_sanskrit": "बालोऽयमितिविज्ञाय न मावज्ञातुमर्हसि । बालोवायदिवावृद्धोमृत्युंजानीहिसंयुगे ॥ बालेनविष्णुनालोकास्त्रयःक्रान्तास्त्रिविक्रमैः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 40017262, "chapter_id": 9259, "verse_number": "64", "content_sanskrit": "लक्ष्मणस्यवचश्श्रुत्वाहेतुमत्परमार्थवत् ॥ अतिकायःप्रचुक्रोधबाणंचोत्तममाददे ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 40017263, "chapter_id": 9259, "verse_number": "65", "content_sanskrit": "ततोविद्याधराभूतादेवादैत्यामहर्षयः ॥ गुह्यकाश्चमहात्मानस्तद्युद्धंद्रष्टुमागमन् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 40017264, "chapter_id": 9259, "verse_number": "66", "content_sanskrit": "तोऽतिकायःकुपितश्चापमारोप्यसायकम् ॥ लक्ष्मणायप्रचिक्षेपसङ्क्षिपन्निवचाम्बरम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 40017265, "chapter_id": 9259, "verse_number": "67", "content_sanskrit": "तमापतन्तंनिशितंशरमाशीविषोपमम् ॥ अर्धचन्द्रेणचिच्छेदलक्ष्मणःपरवीरहा ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 40017266, "chapter_id": 9259, "verse_number": "68", "content_sanskrit": "तंनिकृत्तंशरंदृष्टवाकृत्तभोगमिवोरगम् ॥ अतिकायोभृशंक्रुद्धःपञ्चबाणान् समाददे ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 40017267, "chapter_id": 9259, "verse_number": "69", "content_sanskrit": "तान्शरान् सम्प्रचिक्षेपलक्ष्मणायनिशाचरः ॥ तानप्राप्तान् शरैस्तीक्ष्णैश्चिच्छेदभरतानुजः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 40017268, "chapter_id": 9259, "verse_number": "70", "content_sanskrit": "सतान् छित्त्वाशितैर्बाणैर्लक्ष्मणःपरवीरहा ॥ आददेनिशितंबाणंज्वलन्तमिवतेजसा ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 40017269, "chapter_id": 9259, "verse_number": "71", "content_sanskrit": "तमादायधनुश्श्रेष्ठेयोजयामासलक्ष्मणः ॥ विचकर्ष च वेगेनविससर्ज च वीर्यवान् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 40017270, "chapter_id": 9259, "verse_number": "72", "content_sanskrit": "पूर्णायतविसृषेनशरेणनतपर्वणा ॥ ललाटेराक्षसश्रेष्ठमाजघान स वीर्यवान् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 40017271, "chapter_id": 9259, "verse_number": "73", "content_sanskrit": "सललाटेशरोमग्नस्तस्यभीमस्यरक्षसः ॥ ददृशेशोणितेनाक्तःपन्नगेन्द्रइवाचले ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 40017272, "chapter_id": 9259, "verse_number": "74", "content_sanskrit": "राक्षसःप्रचकम्पे च लक्ष्मणेषुप्रपीडितः ॥ रुद्रबाणहतंघोरंयथात्रिपुरगोपुरम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 40017273, "chapter_id": 9259, "verse_number": "75", "content_sanskrit": "चिन्तयामासचाश्वास्यविमृश्य च महाबलः ॥ साधुबाणनिपातेनश्लाघनीयोऽसिमेरिपुः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 40017274, "chapter_id": 9259, "verse_number": "76", "content_sanskrit": "विधायैवंविनम्यास्यंनियम्य च भुजावुभौ ॥ स रथोपस्थमास्थायरथेनप्रचचार ह ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 40017275, "chapter_id": 9259, "verse_number": "77", "content_sanskrit": "कंत्रीन्पञ्चसप्तेतिसायन्राक्षसर्षभः ॥ आददेसन्दधेचापिविचकर्षोत्ससर्ज च ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 40017276, "chapter_id": 9259, "verse_number": "78", "content_sanskrit": "तेबाणाःकालसङ्काशाराक्षसेन्द्रधुनुश्च्युताः ॥ हेमपुङ्खारविप्रख्याश्चक्रुर्दीप्तमिवाम्बरम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 40017277, "chapter_id": 9259, "verse_number": "79", "content_sanskrit": "तस्तान्राक्षसोत्सृष्टान्शरौघान्राघवानुजः ॥ असम्ब्रान्तःप्रचिच्छेदनिशितैर्बहुभिश्शरैः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 40017278, "chapter_id": 9259, "verse_number": "80", "content_sanskrit": "तान् शरान्युधिसम्प्रेक्ष्यनिकृत्तान्रावणात्मजः ॥ चुकोपत्रिदशेन्द्रारिर्जग्राहनिशितंशरम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 40017279, "chapter_id": 9259, "verse_number": "81", "content_sanskrit": "ससन्धायमहातेजास्तंबाणंसहसोत्सृजत् ॥ तेनस्सौमित्रिमायान्तमाजघानस्तनान्तरे ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 40017280, "chapter_id": 9259, "verse_number": "82", "content_sanskrit": "अतिकायेनसौमित्रिस्ताडितोयुधिवक्षसि ॥ सुस्रावरुधिरंतीव्रंमदंमत्तइवद्विपः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 40017281, "chapter_id": 9259, "verse_number": "83", "content_sanskrit": "सचकारतदात्मानंविशल्यंसहसाविभुः ॥ जग्राह च शरंतीक्ष्णमस्त्रेणापिचसन्दधे ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 40017282, "chapter_id": 9259, "verse_number": "84", "content_sanskrit": "आग्नेयेनतदाऽस्त्रेणयोजयामाससायकम् ॥ स जज्वालतदाबाणोधनुष्यस्यमहात्मनः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 40017283, "chapter_id": 9259, "verse_number": "85", "content_sanskrit": "अतिकायोतितेजस्वीसौरमस्त्रंसमादधे ॥ तेनबाणंभुजङ्गाभंहेमपुङ्खमयोजयत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 40017284, "chapter_id": 9259, "verse_number": "86", "content_sanskrit": "तदस्त्रंज्वलितंघोरंलक्ष्मणश्शरमाहितम् ॥ अतिकायायचिक्षेपकालदण्डमिवान्तकः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 40017285, "chapter_id": 9259, "verse_number": "87", "content_sanskrit": "आग्नेयेनाभिसंयुक्तंदृष्टवाबाणंनिशाचरः ॥ उत्ससर्जतदाबाणंदीप्तंसूर्यास्त्रयोजितम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 40017286, "chapter_id": 9259, "verse_number": "88", "content_sanskrit": "तावुभावम्बरेबाणावन्योन्यमभिजघ्नतुः ॥ तेजसासंप्रदीप्ताग्रौक्रुद्धाविवभुजंगमौ ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 40017287, "chapter_id": 9259, "verse_number": "89", "content_sanskrit": "तावन्योन्यंविनिर्दह्यपेततुर्धरणीतले ॥ निरर्चिषौभस्मकृतौ न भ्राजेतेशरोत्तमौ । तावुभौदीप्यमानौस्म न भ्राजेतेमहीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 40017288, "chapter_id": 9259, "verse_number": "90", "content_sanskrit": "तावन्योन्यंविनिर्दह्यपेततुर्धरणीतले ॥ निरर्चिषौभस्मकृतौ न भ्राजेतेशरोत्तमौ । तावुभौदीप्यमानौस्म न भ्राजेतेमहीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 40017289, "chapter_id": 9259, "verse_number": "91", "content_sanskrit": "ततोऽतिकायस्सङ्कृद्धस्त्वस्त्रमैषीकमुत्सृजत् । तत्प्रचिच्छेदसौमित्रिरस्त्रमैन्द्रेणवीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 40017290, "chapter_id": 9259, "verse_number": "92", "content_sanskrit": "ऐषीकंनिहतंदृष्टवारुषितोरावणात्मजः । याम्येनार्स्तेणसङ्कृद्धोयोजयामाससायकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 40017291, "chapter_id": 9259, "verse_number": "93", "content_sanskrit": "ततस्तदस्त्रंचिक्षेपलक्ष्मणायनिशाचरः । वायव्येनतदस्त्रेणनिजघान स लक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 40017292, "chapter_id": 9259, "verse_number": "94", "content_sanskrit": "अथैनंशरधाराभिर्धाराभिरिवतोयदः । अभ्यवर्षत्सुसङ्कृद्धोलक्ष्मणोरावणात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 40017293, "chapter_id": 9259, "verse_number": "95", "content_sanskrit": "तेऽतिकायंसमासाद्यकवचेवज्रभूषिते । भग्नाग्रशल्यास्सहसापेतुर्बाणामहीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 40017294, "chapter_id": 9259, "verse_number": "96", "content_sanskrit": "तान्मोघानभिसम्प्रेक्ष्यलक्ष्मणःपरवीरहा । अभ्यवर्षन्महेषूणांसहस्रेणमहायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 40017295, "chapter_id": 9259, "verse_number": "97", "content_sanskrit": "स वृष्यमाणोबाणौघैरतिकायोमहाबलः । अवध्यकवचस्सङ्ख्येराक्षसोनैवविव्यथे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 40017296, "chapter_id": 9259, "verse_number": "98", "content_sanskrit": "शरंचाशीविषाकारंलक्ष्मणायव्यपासृजत् । स तेनविद्धस्सौमित्रिर्मर्मदेशेशरेण ह ॥ मुहूर्तमात्रंनिस्संज्ञोह्यभवच्छत्रुतापनः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 40017297, "chapter_id": 9259, "verse_number": "99", "content_sanskrit": "ततःस्संज्ञामुपालभ्यचतुर्भिस्सायकोत्तमैः ॥ निजघानहयान्सङ्ख्येसारथिं च महाबलः । ध्वजस्योन्मथनंकृत्वाशरवर्षैररिन्दमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 40017298, "chapter_id": 9259, "verse_number": "100", "content_sanskrit": "ततःस्संज्ञामुपालभ्यचतुर्भिस्सायकोत्तमैः ॥ निजघानहयान्सङ्ख्येसारथिं च महाबलः । ध्वजस्योन्मथनंकृत्वाशरवर्षैररिन्दमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 40017299, "chapter_id": 9259, "verse_number": "101", "content_sanskrit": "असम्भ्रान्तस्ससौमित्रिस्तान्शरानभिलक्षितान् । मुमोचलक्ष्मणोबाणान्वधार्थंतस्यरक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 40017300, "chapter_id": 9259, "verse_number": "102", "content_sanskrit": "न शशाकरुजंकर्तुंयुधितस्यनरोत्तमः । अथैनमभ्युपागम्यवायुर्वाक्यमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 40017301, "chapter_id": 9259, "verse_number": "103", "content_sanskrit": "ब्रह्मदत्तवरोह्येषअवध्यकवचावृतः । ब्राह्मेणास्त्रेणभ्निथ्येनमेषवध्योहिनान्यथा ॥ अवध्यएषह्यन्येषामस्त्राणांकवचीबली ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 40017302, "chapter_id": 9259, "verse_number": "104", "content_sanskrit": "ततस्तुवायोर्वचनंनिशम्यसौमित्रिरिन्द्रप्रतिमानवीर्यः । समाददेबाणममोघवेगंतद्ब्राह्ममस्त्रंसहसानियोज्य ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 40017303, "chapter_id": 9259, "verse_number": "105", "content_sanskrit": "नियुज्यमानेसौमित्रिणाबाणवरेशिताग्रे । दिशश्चचन्द्रर्कमहाग्रहाश्चनभश्चतत्रासचचालचोर्वी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 40017304, "chapter_id": 9259, "verse_number": "106", "content_sanskrit": "तंब्रह्मणोऽस्त्रेणनियुज्यचापेशरंसुपुङ्खंयमदूतकल्पम् । सौमित्रिरिन्द्रारिसुतस्यतस्यससर्जबाणंयुधिवज्रकल्पम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 40017305, "chapter_id": 9259, "verse_number": "107", "content_sanskrit": "तंलक्ष्मणोत्सृष्टममोघवेगंसमापतन्तंज्यलनप्रकाशम् । सुपर्णवज्रोत्तमचित्रपुङ्खंतदाऽतिकायस्समरेददर्श ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 40017306, "chapter_id": 9259, "verse_number": "108", "content_sanskrit": "तंप्रेक्षमाणस्सहसाऽतिकायोजघानबाणैर्निशितैरनेकैः । स सायकस्तस्यसुपर्णवेगस्तदातिकायस्यजगामपार्श्वम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 40017307, "chapter_id": 9259, "verse_number": "109", "content_sanskrit": "तमागतंप्रेक्ष्यतदातिकायोबाणंप्रदीप्तान्तककालकल्पम् । जघानक्त्यृष्टिगदाकुठारैशूलैर्हुलैश्चाप्यविपन्नचेता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 40017308, "chapter_id": 9259, "verse_number": "110", "content_sanskrit": "तान्यायुधान्यद्भुतविग्रहाणिमोघानिकृत्वा स शरोऽग्निदीप्तः । प्रगृह्यतस्यैवकिरीटजुष्टम् ततोऽतिकायस्यशिरोजहार ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 40017309, "chapter_id": 9259, "verse_number": "111", "content_sanskrit": "तछचिरस्सशिरस्त्राणंलक्ष्मणेषुप्रपीडितम् । पपातसहसाभूमौशृङ्गंहिमवतोयथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 40017310, "chapter_id": 9259, "verse_number": "112", "content_sanskrit": "तंभूमौनिपतितंदृष्टवाविक्षिप्तभूषणम् बभूवुर्व्यथितास्सर्वेहतशेषानिशाचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 40017311, "chapter_id": 9259, "verse_number": "113", "content_sanskrit": "तेविषण्णमुखादीनाःप्रहारजनितश्रमाः । विनेदुरुच्चैर्बहवस्सहसाविस्वरैस्स्वरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 40017312, "chapter_id": 9259, "verse_number": "114", "content_sanskrit": "ततस्तेत्वरितंयातानिरपेक्षानिशाचराः । पुरीमभिमुखाभीताद्रवन्तोनायकेहते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 40017313, "chapter_id": 9259, "verse_number": "115", "content_sanskrit": "प्रहर्षयुक्ताबहवस्तुवानराःप्रबुद्दपद्मप्रतिमाननास्तदा । अपूजयन्लक्ष्मणविष्टभागिनंहतेरिपौभीमबलेदुरासदे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}]