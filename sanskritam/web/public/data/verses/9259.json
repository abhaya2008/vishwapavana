[{"id": 5000259000, "chapter_id": 9259, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे द्विषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000259001, "chapter_id": 9259, "verse_number": "३-६२-१", "content_sanskrit": "सीतामपश्यन् धर्मात्मा शोकोपहतचेतनः।\nविललाप महाबाहू रामः कमललोचनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000259002, "chapter_id": 9259, "verse_number": "३-६२-२", "content_sanskrit": "पश्यन्निव च तां सीतामपश्यन्मन्मथार्दितः।\nउवाच राघवो वाक्यं विलापाश्रयदुर्वचम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000259003, "chapter_id": 9259, "verse_number": "३-६२-३", "content_sanskrit": "त्वमशोकस्य शाखाभिः पुष्पप्रियतरा प्रिये।\nआवृणोषि शरीरं ते मम शोकविवर्धनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000259004, "chapter_id": 9259, "verse_number": "३-६२-४", "content_sanskrit": "कदलीकाण्डसदृशौ कदल्या संवृतावुभौ।\nऊरू पश्यामि ते देवि नासि शक्ता निगूहितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000259005, "chapter_id": 9259, "verse_number": "३-६२-५", "content_sanskrit": "कर्णिकारवनं भद्रे हसन्ती देवि सेवसे।\nअलं ते परिहासेन मम बाधावहेन वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000259006, "chapter_id": 9259, "verse_number": "३-६२-६", "content_sanskrit": "विशेषेणाश्रमस्थाने हासोऽयं न प्रशस्यते।\nअवगच्छामि ते शीलं परिहासप्रियं प्रिये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000259007, "chapter_id": 9259, "verse_number": "३-६२-७", "content_sanskrit": "आगच्छ त्वं विशालाक्षि शून्योऽयमुटजस्तव।\nसुव्यक्तं राक्षसैः सीता भक्षिता वा हृतापि वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000259008, "chapter_id": 9259, "verse_number": "३-६२-८", "content_sanskrit": "न हि सा विलपन्तं मामुपसम्प्रैति लक्ष्मण।\nएतानि मृगयूथानि साश्रुनेत्राणि लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000259009, "chapter_id": 9259, "verse_number": "३-६२-९", "content_sanskrit": "शंसन्तीव हि मे देवीं भक्षितां रजनीचरैः।\nहा ममार्ये क्व यातासि हा साध्वि वरवर्णिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000259010, "chapter_id": 9259, "verse_number": "३-६२-१०", "content_sanskrit": "हा सकामाद्य कैकेयी देवि मेऽद्य भविष्यति।\nसीतया सह निर्यातो विना सीतामुपागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000259011, "chapter_id": 9259, "verse_number": "३-६२-११", "content_sanskrit": "कथं नाम प्रवेक्ष्यामि शून्यमन्तःपुरं मम।\nनिर्वीर्य इति लोको मां निर्दयश्चेति वक्ष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000259012, "chapter_id": 9259, "verse_number": "३-६२-१२", "content_sanskrit": "कातरत्वं प्रकाशं हि सीतापनयनेन मे।\nनिवृत्तवनवासश्च जनकं मिथिलाधिपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000259013, "chapter_id": 9259, "verse_number": "३-६२-१३", "content_sanskrit": "कुशलं परिपृच्छन्तं कथं शक्ष्ये निरीक्षितुम्।\nविदेहराजो नूनं मां दृष्ट्वा विरहितं तया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000259014, "chapter_id": 9259, "verse_number": "३-६२-१४", "content_sanskrit": "सुताविनाशसंतप्तो मोहस्य वशमेष्यति।\nअथवा न गमिष्यामि पुरीं भरतपालिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000259015, "chapter_id": 9259, "verse_number": "३-६२-१५", "content_sanskrit": "स्वर्गोऽपि हि तया हीनः शून्य एव मतो मम।\nतन्मामुत्सृज्य हि वने गच्छायोध्यापुरीं शुभाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000259016, "chapter_id": 9259, "verse_number": "३-६२-१६", "content_sanskrit": "न त्वहं तां विना सीतां जीवेयं हि कथंचन।\nगाढमाश्लिष्य भरतो वाच्यो मद्वचनात् त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000259017, "chapter_id": 9259, "verse_number": "३-६२-१७", "content_sanskrit": "अनुज्ञातोऽसि रामेण पालयेति वसुंधराम्।\nअम्बा च मम कैकेयी सुमित्रा च त्वया विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000259018, "chapter_id": 9259, "verse_number": "३-६२-१८", "content_sanskrit": "कौसल्या च यथान्यायमभिवाद्या ममाज्ञया।\nरक्षणीया प्रयत्नेन भवता सूक्तचारिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000259019, "chapter_id": 9259, "verse_number": "३-६२-१९", "content_sanskrit": "सीतायाश्च विनाशोऽयं मम चामित्रसूदन।\nविस्तरेण जनन्या मे विनिवेद्यस्त्वया भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000259020, "chapter_id": 9259, "verse_number": "३-६२-२०", "content_sanskrit": "इति विलपति राघवे तु दीने\nवनमुपगम्य तया विना सुकेश्या।\nभयविकलमुखस्तु लक्ष्मणोऽपि\nव्यथितमना भृशमातुरो बभूव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000259021, "chapter_id": 9259, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे द्विषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]