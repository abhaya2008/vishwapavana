[{"id": 5000224000, "chapter_id": 9224, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे अष्टाविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000224001, "chapter_id": 9224, "verse_number": "३-२८-१", "content_sanskrit": "निहतं दूषणं दृष्ट्वा रणे त्रिशिरसा सह।\nखरस्याप्यभवत् त्रासो दृष्ट्वा रामस्य विक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000224002, "chapter_id": 9224, "verse_number": "३-२८-२", "content_sanskrit": "स दृष्ट्वा राक्षसं सैन्यमविषह्यं महाबलम्।\nहतमेकेन रामेण दूषणस्त्रिशिरा अपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000224003, "chapter_id": 9224, "verse_number": "३-२८-३", "content_sanskrit": "तद‍्बलं हतभूयिष्ठं विमनाः प्रेक्ष्य राक्षसः।\nआससाद खरो रामं नमुचिर्वासवं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000224004, "chapter_id": 9224, "verse_number": "३-२८-४", "content_sanskrit": "विकृष्य बलवच्चापं नाराचान् रक्तभोजनान्।\nखरश्चिक्षेप रामाय क्रुद्धानाशीविषानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000224005, "chapter_id": 9224, "verse_number": "३-२८-५", "content_sanskrit": "ज्यां विधुन्वन् सुबहुशः शिक्षयास्त्राणि दर्शयन्।\nचचार समरे मार्गान् शरै रथगतः खरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000224006, "chapter_id": 9224, "verse_number": "३-२८-६", "content_sanskrit": "स सर्वाश्च दिशो बाणैः प्रदिशश्च महारथः।\nपूरयामास तं दृष्ट्वा रामोऽपि सुमहद् धनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000224007, "chapter_id": 9224, "verse_number": "३-२८-७", "content_sanskrit": "स सायकैर्दुर्विषहैर्विस्फुलिङ्गैरिवाग्निभिः।\nनभश्चकाराविवरं पर्जन्य इव वृष्टिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000224008, "chapter_id": 9224, "verse_number": "३-२८-८", "content_sanskrit": "तद् बभूव शितैर्बाणैः खररामविसर्जितैः।\nपर्याकाशमनाकाशं सर्वतः शरसंकुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000224009, "chapter_id": 9224, "verse_number": "३-२८-९", "content_sanskrit": "शरजालावृतः सूर्यो न तदा स्म प्रकाशते।\nअन्योन्यवधसंरम्भादुभयोः सम्प्रयुध्यतोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000224010, "chapter_id": 9224, "verse_number": "३-२८-१०", "content_sanskrit": "ततो नालीकनाराचैस्तीक्ष्णाग्रैश्च विकर्णिभिः।\nआजघान रणे रामं तोत्रैरिव महाद्विपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000224011, "chapter_id": 9224, "verse_number": "३-२८-११", "content_sanskrit": "तं रथस्थं धनुष्पाणिं राक्षसं पर्यवस्थितम्।\nददृशुः सर्वभूतानि पाशहस्तमिवान्तकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000224012, "chapter_id": 9224, "verse_number": "३-२८-१२", "content_sanskrit": "हन्तारं सर्वसैन्यस्य पौरुषे पर्यवस्थितम्।\nपरिश्रान्तं महासत्त्वं मेने रामं खरस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000224013, "chapter_id": 9224, "verse_number": "३-२८-१३", "content_sanskrit": "तं सिंहमिव विक्रान्तं सिंहविक्रान्तगामिनम्।\nदृष्ट्वा नोद्विजते रामः सिंहः क्षुद्रमृगं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000224014, "chapter_id": 9224, "verse_number": "३-२८-१४", "content_sanskrit": "ततः सूर्यनिकाशेन रथेन महता खरः।\nआससादाथ तं रामं पतङ्ग इव पावकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000224015, "chapter_id": 9224, "verse_number": "३-२८-१५", "content_sanskrit": "ततोऽस्य सशरं चापं मुष्टिदेशे महात्मनः।\nखरश्चिच्छेद रामस्य दर्शयन् हस्तलाघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000224016, "chapter_id": 9224, "verse_number": "३-२८-१६", "content_sanskrit": "स पुनस्त्वपरान् सप्त शरानादाय मर्मणि।\nनिजघान रणे क्रुद्धः शक्राशनिसमप्रभान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000224017, "chapter_id": 9224, "verse_number": "३-२८-१७", "content_sanskrit": "ततः शरसहस्रेण राममप्रतिमौजसम्।\nअर्दयित्वा महानादं ननाद समरे खरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000224018, "chapter_id": 9224, "verse_number": "३-२८-१८", "content_sanskrit": "ततस्तत्प्रहतं बाणैः खरमुक्तैः सुपर्वभिः।\nपपात कवचं भूमौ रामस्यादित्यवर्चसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000224019, "chapter_id": 9224, "verse_number": "३-२८-१९", "content_sanskrit": "स शरैरर्पितः क्रुद्धः सर्वगात्रेषु राघवः।\nरराज समरे रामो विधूमोऽग्निरिव ज्वलन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000224020, "chapter_id": 9224, "verse_number": "३-२८-२०", "content_sanskrit": "ततो गम्भीरनिर्ह्रादं रामः शत्रुनिबर्हणः।\nचकारान्ताय स रिपोः सज्यमन्यन्महद्धनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000224021, "chapter_id": 9224, "verse_number": "३-२८-२१", "content_sanskrit": "सुमहद् वैष्णवं यत् तदतिसृष्टं महर्षिणा।\nवरं तद् धनुरुद्यम्य खरं समभिधावत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000224022, "chapter_id": 9224, "verse_number": "३-२८-२२", "content_sanskrit": "ततः कनकपुङ्खैस्तु शरैः संनतपर्वभिः।\nचिच्छेद रामः संक्रुद्धः खरस्य समरे ध्वजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000224023, "chapter_id": 9224, "verse_number": "३-२८-२३", "content_sanskrit": "स दर्शनीयो बहुधा विच्छिन्नः काञ्चनो ध्वजः।\nजगाम धरणीं सूर्यो देवतानामिवाज्ञया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000224024, "chapter_id": 9224, "verse_number": "३-२८-२४", "content_sanskrit": "तं चतुर्भिः खरः क्रुद्धो रामं गात्रेषु मार्गणैः।\nविव्याध हृदि मर्मज्ञो मातङ्गमिव तोमरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000224025, "chapter_id": 9224, "verse_number": "३-२८-२५", "content_sanskrit": "स रामो बहुभिर्बाणैः खरकार्मुकनिःसृतैः।\nविद्धो रुधिरसिक्ताङ्गो बभूव रुषितो भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000224026, "chapter_id": 9224, "verse_number": "३-२८-२६", "content_sanskrit": "स धनुर्धन्विनां श्रेष्ठः संगृह्य परमाहवे।\nमुमोच परमेष्वासः षट् शरानभिलक्षितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000224027, "chapter_id": 9224, "verse_number": "३-२८-२७", "content_sanskrit": "शिरस्येकेन बाणेन द्वाभ्यां बाह्वोरथार्पयत् ।\nत्रिभिश्चन्द्रार्धवक्त्रैश्च वक्षस्यभिजघान ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000224028, "chapter_id": 9224, "verse_number": "३-२८-२८", "content_sanskrit": "ततः पश्चान्महातेजा नाराचान् भास्करोपमान्।\nजघान राक्षसं क्रुद्धस्त्रयोदश शिलाशितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000224029, "chapter_id": 9224, "verse_number": "३-२८-२९", "content_sanskrit": "रथस्य युगमेकेन चतुर्भिः शबलान् हयान्।\nषष्ठेन च शिरः संख्ये चिच्छेद खरसारथेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000224030, "chapter_id": 9224, "verse_number": "३-२८-३०", "content_sanskrit": "त्रिभिस्त्रिवेणून् बलवान् द्वाभ्यामक्षं महाबलः।\nद्वादशेन तु बाणेन खरस्य सशरं धनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000224031, "chapter_id": 9224, "verse_number": "३-२८-३१", "content_sanskrit": "छित्त्वा वज्रनिकाशेन राघवः प्रहसन्निव।\nत्रयोदशेनेन्द्रसमो बिभेद समरे खरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000224032, "chapter_id": 9224, "verse_number": "३-२८-३२", "content_sanskrit": "प्रभग्नधन्वा विरथो हताश्वो हतसारथिः।\nगदापाणिरवप्लुत्य तस्थौ भूमौ खरस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000224033, "chapter_id": 9224, "verse_number": "३-२८-३३", "content_sanskrit": "तत् कर्म रामस्य महारथस्य\nसमेत्य देवाश्च महर्षयश्च।\nअपूजयन् प्राञ्जलयः प्रहृष्टा-\nस्तदा विमानाग्रगताः समेताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000224034, "chapter_id": 9224, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे अष्टाविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]