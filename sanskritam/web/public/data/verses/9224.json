[{"id": 40015425, "chapter_id": 9224, "verse_number": "1", "content_sanskrit": "तत्तुमाल्यवतोवाक्यंहितमुक्तंदशाननः । नमर्षयतिदुष्टात्माकालस्यवशमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40015426, "chapter_id": 9224, "verse_number": "2", "content_sanskrit": "नबद् ध्वाभ्रुकुटींवक्त्रेक्रोधस्यवशमागतः । अमर्षात्परिवृत्ताक्षोमाल्यवन्तमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40015427, "chapter_id": 9224, "verse_number": "3", "content_sanskrit": "हितबुध्यायदहितंवचःपरुषमुच्यते । परपक्षंप्रनिश्यैवनैतच्च्रोत्रगतंमम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40015428, "chapter_id": 9224, "verse_number": "4", "content_sanskrit": "मानुषंकृपणंराममेकंशाखामृगाश्रयम् । समर्थंमन्यसेकेनत्यक्तंपित्रावनालयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40015429, "chapter_id": 9224, "verse_number": "5", "content_sanskrit": "रक्षसामीश्वरंमांचदेवानांचभयङ्करम् । हीनंमांमन्यसेकेनह्यहीनंसर्वविक्रमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40015430, "chapter_id": 9224, "verse_number": "6", "content_sanskrit": "वीरद्वेषेणवाशङ्केपक्षपातेनवारिपोः । त्वयाहंपरुषाण्युक्तःपरप्रोत्साहनेनवा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40015431, "chapter_id": 9224, "verse_number": "7", "content_sanskrit": "प्रभवन्तंपदस्थंहिपरुषंकोऽभिभाषते । पण्डितश्शास्त्रतत्त्वज्ञोविनाप्रोत्साहनाद्रिपोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40015432, "chapter_id": 9224, "verse_number": "8", "content_sanskrit": "आनीयचवनासतीतांपद्महीनामिवश्रियम् । किमर्थंप्रतिदास्यामिराघवस्यभयादहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40015433, "chapter_id": 9224, "verse_number": "9", "content_sanskrit": "वृतंवानरकोटीभिस्ससुग्रीवंसलक्ष्मणम् । पश्यकैश्चिदहोभिस्त्वंराघवंनिहतंमया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40015434, "chapter_id": 9224, "verse_number": "10", "content_sanskrit": "द्वन्द्वेयस्यनतिष्ठन्तिदैवतान्यपिसंयुगे । सकस्माद्रावणोयुद्धेभयमाहारयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40015435, "chapter_id": 9224, "verse_number": "11", "content_sanskrit": "द्विधाभज्येयमप्येवंननमेयंतुकस्यचित् । एषमेसहजोदोषस्स्वभावोदुरतिक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40015436, "chapter_id": 9224, "verse_number": "12", "content_sanskrit": "यदितावत्समुद्रेतुसेतुर्बद्धोयदृच्छया । रामेणविस्मयःकोऽत्रयेवमेभयमागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40015437, "chapter_id": 9224, "verse_number": "13", "content_sanskrit": "सतुतीर्त्वार्णवंरामस्सहवानरसेनया । प्रतिजानामितेसत्यंनजीवन्प्रतियास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40015438, "chapter_id": 9224, "verse_number": "14", "content_sanskrit": "एवंब्रुवाणंसंरब्धंरुष्टंविज्ञायरावणम् । व्रीळितोमाल्यवान्वाक्यंनोत्तरंप्रत्यपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40015439, "chapter_id": 9224, "verse_number": "15", "content_sanskrit": "जयाशिषाचराजानंवर्धयित्वायथोचितम् । माल्यवानभ्यनुज्ञातोजगामस्वंनिवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40015440, "chapter_id": 9224, "verse_number": "16", "content_sanskrit": "रावणस्तुसहामात्योमन्त्रयित्वाविमृश्यच । लङ्कायामतुलांगुप्तिंकारयामासराक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40015441, "chapter_id": 9224, "verse_number": "17", "content_sanskrit": "व्यादिदेशसपूर्वस्यांप्रहस्तंद्वारिराक्षसम् । दक्षिणस्यांमहावीर्यौमहापार्श्वमहादरौ ॥ पश्चिमायामथोद्वारिपुत्रमिन्द्रजितंतदा । व्यादिदेशमयामायंबहूभीराक्षसैर्भहुभिर्वृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40015442, "chapter_id": 9224, "verse_number": "18", "content_sanskrit": "व्यादिदेशसपूर्वस्यांप्रहस्तंद्वारिराक्षसम् । दक्षिणस्यांमहावीर्यौमहापार्श्वमहादरौ ॥ पश्चिमायामथोद्वारिपुत्रमिन्द्रजितंतदा । व्यादिदेशमयामायंबहूभीराक्षसैर्भहुभिर्वृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40015443, "chapter_id": 9224, "verse_number": "19", "content_sanskrit": "उतरस्यांपुरद्वारिव्यादिश्यशुकसारणौ । स्वयंचात्रगमिष्यामिमन्त्रिणस्तानुवाचह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40015444, "chapter_id": 9224, "verse_number": "20", "content_sanskrit": "राक्षसांतुविरूपाक्षंमहावीर्यपराक्रमम् । मध्यमेऽस्थापयद्गुल्मेबहुभिस्सहराक्षसैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40015445, "chapter_id": 9224, "verse_number": "21", "content_sanskrit": "एवंविधानंलङ्कायांकृत्वाराक्षसपुङ्गवः । कृतकृत्यमिवात्मानंमन्यतेकालचोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40015446, "chapter_id": 9224, "verse_number": "22", "content_sanskrit": "विसर्जयामासततस्समन्त्रिणोविधानमाज्ञाप्यपुरस्यपुष्कलम् । जयाशिषामन्त्रिगणेनपूजितोविवेशचाऽन्तःपुरमृद्धिमन्महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]