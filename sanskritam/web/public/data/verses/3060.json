[{"id": 2096408, "chapter_id": 3060, "verse_number": "१३-१९०-१", "content_sanskrit": "[विभावसुरुवाच।\nसलिलस्याञ्जलिं पूर्णमक्षताश्च धृतोत्तराः।\nसोमस्योत्तिष्ठमानस्य तज्जलं चाक्षतांश्च तान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2096409, "chapter_id": 3060, "verse_number": "१३-१९०-२", "content_sanskrit": "स्थितो ह्यभिमुखो मर्त्यः पौर्णमास्यां बलिं हरेत्।\nअग्निकार्यं कृतं तेन हुताश्चास्याग्नयस्त्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2096410, "chapter_id": 3060, "verse_number": "१३-१९०-३", "content_sanskrit": "वनस्पतिं च यो हन्यादमावास्यामबुद्धिमान्।\nअपि ह्येकेन पत्रेण लिप्यते ब्रह्महत्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2096411, "chapter_id": 3060, "verse_number": "१३-१९०-४", "content_sanskrit": "दन्तकाष्ठं तु यः खादेदमावास्यामबुद्धिमान्।\nहिंसितश्चन्द्रमा**** पितरश्चोद्विजन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2096412, "chapter_id": 3060, "verse_number": "१३-१९०-५", "content_sanskrit": "हव्यं न तस्य देवाश्च प्रतिगृह्णन्ति पर्वसु।\nकुप्यन्ते पितरश्चास्य कुले वंशोऽस्य हीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2096413, "chapter_id": 3060, "verse_number": "१३-१९०-६x", "content_sanskrit": "श्रीरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2096414, "chapter_id": 3060, "verse_number": "१३-१९०-६", "content_sanskrit": "प्रकीर्णं भाजनं यत्र भिन्नभाण्डमथासनम्।\nयोषितश्चैव हन्यन्ते कश्मलोपहते गृहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2096415, "chapter_id": 3060, "verse_number": "१३-१९०-७", "content_sanskrit": "देवताः पितरश्चैव उत्सवे पर्वणीषु वा।\nनिराशाः प्रतिगच्छन्ति कश्मलोपहताद्गृहात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2096416, "chapter_id": 3060, "verse_number": "१३-१९०-८x", "content_sanskrit": "अङ्गिरा उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2096417, "chapter_id": 3060, "verse_number": "१३-१९०-८", "content_sanskrit": "यस्तु संवत्सरं पूर्णं दद्याद्दीपं करञ्जके।\nसुवर्चलामूलहस्तः प्रजा तस्य विवर्धते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2096418, "chapter_id": 3060, "verse_number": "१३-१९०-९x", "content_sanskrit": "गार्ग्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2096419, "chapter_id": 3060, "verse_number": "१३-१९०-९", "content_sanskrit": "आतीथ्यं सततं कुर्याद्दीपं दद्यात्प्रतिश्रये।\nवर्जयानो दिवास्वापं न च मांसानि भक्षयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2096420, "chapter_id": 3060, "verse_number": "१३-१९०-१०", "content_sanskrit": "गोब्राह्मणं न हिंस्याच्च पुष्कराणि च कीर्तयेत्।\nएत श्रेष्ठतमो धर्मः सरहस्यो महाफलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2096421, "chapter_id": 3060, "verse_number": "१३-१९०-११", "content_sanskrit": "अपि क्रतुशतैरिष्ट्वा क्षयं गच्छति तद्धविः।\nन तु क्षीयन्ति ते धर्माः श्रद्दधानैः प्रयोजिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2096422, "chapter_id": 3060, "verse_number": "१३-१९०-१२", "content_sanskrit": "इदं च परमं गुह्यं सरहस्यं निबोधत।\nश्राद्धकल्पे च दैवे च तैर्थिके पर्वणीषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2096423, "chapter_id": 3060, "verse_number": "१३-१९०-१३", "content_sanskrit": "रजस्वला च या नारी श्वित्रिकाऽपुत्रिका च या।\nएताभिश्चक्षुषा दृष्टं हविर्नाश्नन्ति देवताः।\nपितरश्च न तुष्यन्ति वर्षाण्यपि त्रयोदश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2096424, "chapter_id": 3060, "verse_number": "१३-१९०-१४", "content_sanskrit": "शुक्लवासाः शुचिर्भूत्वा ब्राह्मणान्स्वस्ति वाचयेत्।\nकीर्तयेद्भारतं चैव तथा स्यादक्षयं हविः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2096425, "chapter_id": 3060, "verse_number": "१३-१९०-१५x", "content_sanskrit": "धौम्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2096426, "chapter_id": 3060, "verse_number": "१३-१९०-१५", "content_sanskrit": "भिन्नभाण्डं च खट्वां च कुक्कुटं शुनकं तथा।\nअप्रशस्तानि सर्वाणि यश्च वृक्षो गृहेरुहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2096427, "chapter_id": 3060, "verse_number": "१३-१९०-१६", "content_sanskrit": "भिन्नभाण्डे कलिं प्राहुः खट्वायां तु धनक्षयः।\nकुक्कुटे शुनके चैव हविर्नाश्नन्ति देवताः।\nवृक्षमूले ध्रुवं सत्वं तस्माद्वृक्षं न रोपयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2096428, "chapter_id": 3060, "verse_number": "१३-१९०-१७x", "content_sanskrit": "जमदग्निरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2096429, "chapter_id": 3060, "verse_number": "१३-१९०-१७", "content_sanskrit": "यो यजेदश्वमेधेन वाजपेयशतेन ह।\nअवाक्शिरा वा लम्बेत सत्रं वा स्फीतमाहरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2096430, "chapter_id": 3060, "verse_number": "१३-१९०-१८", "content_sanskrit": "न यस्य हृदयं शुद्धं नरकं स ध्रुवं व्रजेत्।\nतुल्यं यज्ञश्च सत्यं च हृदयस्य च शुद्धता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2096431, "chapter_id": 3060, "verse_number": "१३-१९०-१९", "content_sanskrit": "शुद्धेन मनसा दत्त्वा सक्तुप्रस्थं द्विजातये।\nब्रह्मलोकमनुप्राप्तः पर्याप्तं तन्निदर्शनम्॥] ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2096432, "chapter_id": 3060, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि नवत्यधिकशततमोऽध्यायः॥ १९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]