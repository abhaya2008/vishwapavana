[{"id": 2035400, "chapter_id": 1765, "verse_number": "५-१०-०x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2035401, "chapter_id": 1765, "verse_number": "५-१०-१", "content_sanskrit": "सर्वं व्याप्तमिदं देवा वृत्रेण जगदव्ययम्।\nन ह्यस्य सदृशं किञ्चित्प्रतिघाताय यद्भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2035402, "chapter_id": 1765, "verse_number": "५-१०-२", "content_sanskrit": "समर्थो ह्यभवं पूर्वमसमर्थोऽस्मि सांप्रतम्।\nकथं नु कार्यं भद्रं वो दुर्धर्षः स हि मे मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2035403, "chapter_id": 1765, "verse_number": "५-१०-३", "content_sanskrit": "तेजस्वी च महात्मा च युद्धे चामितविक्रमः ।\nग्रसेत्रिभुवनं सर्वं सदेवासुरमानुषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2035404, "chapter_id": 1765, "verse_number": "५-१०-४", "content_sanskrit": "तस्माद्विनिश्चयमिमं शृणुध्वं त्रिदिवौकसः।\nविष्णोः क्षयमुपागम्य समेत्य च महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2035405, "chapter_id": 1765, "verse_number": "५-१०-५", "content_sanskrit": "तेन संमन्त्र्य वेत्स्यामो वधोपायं दुरात्मनः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2035406, "chapter_id": 1765, "verse_number": "५-१०-५x", "content_sanskrit": "शल्य उवाच।\nएवमुक्ते मघवता देवाः शर्षिगणास्तदा।\nशरण्यं शरमं देवं जग्मुर्विष्णुं महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2035407, "chapter_id": 1765, "verse_number": "५-१०-६", "content_sanskrit": "ऊचुश्च सर्वे देवेशं विष्णुं वृत्रभयार्दिताः।\nत्रयो लोकास्त्वया क्रान्तास्त्रिभिर्विक्रमणैः पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2035408, "chapter_id": 1765, "verse_number": "५-१०-७", "content_sanskrit": "अमृतं चाहृतं विष्णो दैत्याश्च निहता रणे।\nबलिं बद्ध्वा महादैत्यं शक्रो देवाधिपः कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2035409, "chapter_id": 1765, "verse_number": "५-१०-८", "content_sanskrit": "त्वं प्रभुः सर्वदेवानां त्वया सर्वमिदं ततम्।\nत्वं हि देवो महादेव सर्वलोकनमस्कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2035410, "chapter_id": 1765, "verse_number": "५-१०-९", "content_sanskrit": "गतिर्भव त्वं देवानां सेन्द्राणाममरोत्तम।\nजगद्व्याप्तमिदं सर्वं वृत्रेणासुरसूदन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2035411, "chapter_id": 1765, "verse_number": "५-१०-१०x", "content_sanskrit": "विष्णुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2035412, "chapter_id": 1765, "verse_number": "५-१०-१०", "content_sanskrit": "अवश्यं करणीयं मे भवतां हितमुत्तमम्।\nतस्मादुपायं वक्ष्यामि यथाऽसौ नभविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2035413, "chapter_id": 1765, "verse_number": "५-१०-११", "content_sanskrit": "गच्छध्वं सर्षिगन्धर्वा यत्रासौ विश्वरूपधृक्।\nसाम तस्य प्रयुञ्जध्वं तत एनं विजेष्यथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2035414, "chapter_id": 1765, "verse_number": "५-१०-१२", "content_sanskrit": "भविष्यति जयो देवाः शक्रस्य मम तेजसा ।\nअदृश्यश्च प्रवेक्ष्यामि वज्रे ह्यस्यायुधोत्तमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2035415, "chapter_id": 1765, "verse_number": "५-१०-१३", "content_sanskrit": "गच्छध्वमृषिभिः सार्धं गन्धर्वैश्च सुरोत्तमाः ।\nवृत्रस्य सह शक्रेण सन्धिं कुरुत माचिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2035416, "chapter_id": 1765, "verse_number": "५-१०-१४x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2035417, "chapter_id": 1765, "verse_number": "५-१०-१४", "content_sanskrit": "एवमुक्ते तु देवेन ऋषयस्त्रिदशास्तथा ।\nययुः समेत्य सहिताः शक्रं कृत्वा पुरःसरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2035418, "chapter_id": 1765, "verse_number": "५-१०-१५", "content_sanskrit": "समीपमेत्य च यदा सर्व एव महौजसः।\nतं तेजसा प्रज्वलितं प्रतपन्तं दिशो दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2035419, "chapter_id": 1765, "verse_number": "५-१०-१६", "content_sanskrit": "ग्रसन्तमिव लोकांस्त्रीन्सूर्याचन्द्रमसौ यथा।\nददृशुस्ते ततो वृत्रं शक्रेण सह देवताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2035420, "chapter_id": 1765, "verse_number": "५-१०-१७", "content_sanskrit": "ऋषयोऽथ ततोऽभ्येत्य वृत्रमूचुः प्रियं वचः।\nव्याप्तं जगदिदं सर्वं तेजसा तव दुर्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2035421, "chapter_id": 1765, "verse_number": "५-१०-१८", "content_sanskrit": "न च शक्नोषि निर्जेषुं वासवं बलिनां वर।\nयुध्यतोश्चापि वां कालो व्यतीतः सुमहानिह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2035422, "chapter_id": 1765, "verse_number": "५-१०-१९", "content_sanskrit": "पीड्यन्ते च प्रजाः सर्वाः सदेवासुरमानुषाः ।\nसख्यं भवतु ते वृत्र शक्रेण सह नित्यदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2035423, "chapter_id": 1765, "verse_number": "५-१०-२०", "content_sanskrit": "अवाप्स्यसि सुखं त्वं च शक्रलोकांश्च शाश्वतान्।\nऋषिवाक्यं निशम्याथ वृत्रःस तु महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2035424, "chapter_id": 1765, "verse_number": "५-१०-२१", "content_sanskrit": "उवाच तानृषीन्सर्वान्प्रणम्य शिरसाऽसुरः ।\nसर्वे यूयं महाभागा गन्धर्वाश्चैव सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2035425, "chapter_id": 1765, "verse_number": "५-१०-२२", "content_sanskrit": "यद्ब्रूथ तच्छ्रुतं सर्वं ममापि श्रृणुतानघाः।\nसन्धिः कथं वै भविता मम शक्रस्य चोभयोः ।\nतेजसोर्हि द्वयोर्देवाः सख्यं वै भविता कथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2035426, "chapter_id": 1765, "verse_number": "५-१०-२३x", "content_sanskrit": "ऋषय ऊचुः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2035427, "chapter_id": 1765, "verse_number": "५-१०-२३", "content_sanskrit": "सकृत्सतां सङ्गतमीप्सितव्यं\nततः परं भविता भव्यमेव।\nनातिक्रामेत्सत्पुरुषेण सङ्गतं\nतस्मात्सतां संगतमीप्सितव्यम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2035428, "chapter_id": 1765, "verse_number": "५-१०-२४", "content_sanskrit": "दृढं सतां सङ्गतं चापि नित्यं\nब्रूयाच्चार्थं ह्यर्थकृच्छ्रेषु धीराः ।\nमहार्थवत्सत्पुरुषेण सङ्गतं\nतस्मात्सन्तं न जिघांसेत धीरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2035429, "chapter_id": 1765, "verse_number": "५-१०-२५", "content_sanskrit": "इन्द्रः सतां संमतश्च निवासश्च महात्मनाम्।\nसत्यवादी ह्यनिन्द्यश्च धर्मवित्सूक्ष्मनिश्चयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2035430, "chapter_id": 1765, "verse_number": "५-१०-२६", "content_sanskrit": "तेन ते सह शक्रेण सन्धिर्भवतु नित्यदा।\nएवं विश्वासमागच्छ मा ते भूद्बुद्धिरन्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2035431, "chapter_id": 1765, "verse_number": "५-१०-२७x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2035432, "chapter_id": 1765, "verse_number": "५-१०-२७", "content_sanskrit": "महर्षिवचनं श्रुत्वा तानुवाच महाद्युतिः।\nअवश्यं भगवन्तो मे माननीयास्तपस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2035433, "chapter_id": 1765, "verse_number": "५-१०-२८", "content_sanskrit": "ब्रवीमि यदहं देवास्तत्सर्वं क्रियते यदि।\nततः सर्वं करिष्यामि यदूचुर्मां दिवौकसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2035434, "chapter_id": 1765, "verse_number": "५-१०-२९", "content_sanskrit": "न शुष्केण न चाद्रेण नाश्मना न च दारुणा ।\nन शस्त्रेण न चास्त्रेण न दिवा न तथा निशि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2035435, "chapter_id": 1765, "verse_number": "५-१०-३०", "content_sanskrit": "वध्यो भवेयं विप्रेन्द्राः शक्रस्य सह दैवतैः ।\nएवं मे रोचते सन्धिः शक्रेण सह नित्यदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2035436, "chapter_id": 1765, "verse_number": "५-१०-३१", "content_sanskrit": "बाढमित्येव ऋषयस्तमूचुर्भरतर्षभ।\nएवं वृत्ते तु सन्धाने वृत्रः प्रमुदितोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2035437, "chapter_id": 1765, "verse_number": "५-१०-३२", "content_sanskrit": "` ततः सन्धिं मिथः कृत्वा ऋषयो दीप्ततेजसः।\nशक्रस्य सह वृत्रेण पुनर्जग्मुर्यथागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2035438, "chapter_id": 1765, "verse_number": "५-१०-३३", "content_sanskrit": "युक्तः सदाऽभवच्चापि शक्रो हर्षसमन्वितः।\nवृत्रस्य वधसंयुक्तानुपायानन्वचिन्तयत् ॥ ५-१०-३४a` अभिसन्धिर्महेन्द्रस्य सन्धिकर्मणि यः कृतः।\nऋषिभिस्त्वीरितं यच्च महेन्द्रस्तदनुस्मरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2035439, "chapter_id": 1765, "verse_number": "५-१०-३५", "content_sanskrit": "छिद्रान्वेषी समुद्विग्नः सदा वसति देवराट्।\nस कदाचिन्समुद्रान्ते समपश्यन्महासुरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2035440, "chapter_id": 1765, "verse_number": "५-१०-३६", "content_sanskrit": "सन्ध्याकाल उपावृत्ते मुहूर्ते चातिदारुणे।\nततः संचिन्त्य भगवान्वरदानं महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2035441, "chapter_id": 1765, "verse_number": "५-१०-३७", "content_sanskrit": "सन्ध्येयं वर्तते रौद्रा न रात्रिर्दिवसं न च।\nवृत्रश्चावश्यवध्योऽयं मम सर्वहरो रिपुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2035442, "chapter_id": 1765, "verse_number": "५-१०-३८", "content_sanskrit": "यदि वृत्रं न हन्म्यद्य वञ्चयित्वा महासुरम्।\nमहाबलं महाकायं न मे श्रेयो भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2035443, "chapter_id": 1765, "verse_number": "५-१०-३९", "content_sanskrit": "एवं संचिन्तयन्नेव शक्रो विष्णुमनुस्मरन्।\nअथ फेनं तदाऽपश्यत् समुद्रे पर्वतोपमप् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2035444, "chapter_id": 1765, "verse_number": "५-१०-४०", "content_sanskrit": "नायं युष्को न चाद्रोऽयं न च शस्त्रमिदं तथा।\nएनं क्षेप्स्यामि वृत्रस्य क्षणादेव नशिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2035445, "chapter_id": 1765, "verse_number": "५-१०-४१", "content_sanskrit": "सवज्रमथ फेनं तं क्षिप्रं वृत्रे निसृष्टवान्।\nप्रविश्य फेनं तं विष्णुरथ वृत्रं व्यनाशयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2035446, "chapter_id": 1765, "verse_number": "५-१०-४२", "content_sanskrit": "निहते तु ततो वृत्रे दिशो वितिमिराऽभवन्।\nप्रववौ च शिवो वायुः प्रजाश्च जहृषुस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2035447, "chapter_id": 1765, "verse_number": "५-१०-४३", "content_sanskrit": "ततो देवाः सगन्धर्वा यक्षरक्षोमहोरगाः ।\nऋषयश्च महेन्द्रं तमस्तुवन्विविधैः स्तवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2035448, "chapter_id": 1765, "verse_number": "५-१०-४४", "content_sanskrit": "नमस्कृतः सर्वभूतैः सर्वभूतान्यसान्त्वयत्।\nहत्वा शत्रुं प्रहृष्टात्मा वासवः सह दैवतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2035449, "chapter_id": 1765, "verse_number": "५-१०-४५", "content_sanskrit": "विष्णुं त्रिभुवनश्रेष्ठं पूजयामास धर्मवित्।\nततो हते महावीर्ये वृत्रे देवभयङ्करे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2035450, "chapter_id": 1765, "verse_number": "५-१०-४६", "content_sanskrit": "अनृतेनाभिभूतोऽभूच्छक्रः परमदुर्मनाः ।\nत्रैशीर्षयाऽभिभूतश्च स पूर्वं ब्रह्महत्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2035451, "chapter_id": 1765, "verse_number": "५-१०-४७", "content_sanskrit": "` महादेवस्य भूतैश्च स पुनर्ब्रह्महा इति।\nआक्रुष्टो निर्भयैर्भूयो व्रीडितो बलवृत्रहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2035452, "chapter_id": 1765, "verse_number": "५-१०-४८", "content_sanskrit": "सोऽन्तमाश्रित्य लोकानां नष्टसंज्ञो विचेतनः।\nन प्राज्ञायत देवेन्द्रस्त्वभिभूतः स्वकर्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2035453, "chapter_id": 1765, "verse_number": "५-१०-४९", "content_sanskrit": "प्रतिच्छन्नोऽवसच्चाप्सु चेष्टमान इवोरगः ।\nततः प्रनष्टे देवेन्द्रे ब्रह्महत्या भयार्दिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2035454, "chapter_id": 1765, "verse_number": "५-१०-५०", "content_sanskrit": "भूमिः प्रध्वस्तसंकाशा निर्वृक्षा शुष्ककानना ।\nविच्छिन्नस्रोतसो नद्यः सरांस्यनुदकानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2035455, "chapter_id": 1765, "verse_number": "५-१०-५१", "content_sanskrit": "संक्षोभश्चापि सत्वानामनावृष्टिकृतोऽभवत्।\nदेवाश्चापि भृशं त्रस्तास्तथा सर्वे महर्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2035456, "chapter_id": 1765, "verse_number": "५-१०-५२", "content_sanskrit": "अराजकं जगत्सर्वमभिभूतमुपद्रवैः।\nततो भीताऽभवन्देवाः को नो राजा भवेदिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2035457, "chapter_id": 1765, "verse_number": "५-१०-५३", "content_sanskrit": "दिवि देवर्षयश्चापि देवराजविनाकृताः।\nन स्म कश्चन देवानां राज्ये वै कुरुते मतिम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2035458, "chapter_id": 1765, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि सेनोद्योगपर्वणि दशमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]