[{"id": 7003948000, "chapter_id": 23948, "verse_number": "३-१-११-१", "content_sanskrit": "श्रीसूत उवाच ।\nपापनाशे नरः स्नात्वा सर्वपापनिबर्हणे ।\nततः सीतासरो गच्छेत्स्नातुं नियमपूर्वकम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003948001, "chapter_id": 23948, "verse_number": "३-१-११-२", "content_sanskrit": "यानि कानि च पुण्यानि ब्रह्मांडांतर्गतानि वै ।\nतानि गंगादितीर्थानि स्वपापपरिशुद्धये॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003948002, "chapter_id": 23948, "verse_number": "३-१-११-३", "content_sanskrit": "सीतासरसि वर्तंते महापातकनाशने ।\nक्षेत्राण्यपि महार्हाणि काश्यादीनि दिवानिशम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003948003, "chapter_id": 23948, "verse_number": "३-१-११-४", "content_sanskrit": "सीतासरोत्र सेवंते स्वस्वकल्मषशांतये ।\nतस्याः सरसि संगीतगुणेनाकृष्य बालिशः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003948004, "chapter_id": 23948, "verse_number": "३-१-११-५", "content_sanskrit": "पंचाननोऽपि वसते पंचपातकनाशनः ।\nतदेतत्तीर्थमागत्य स्नात्वा वै श्रद्धया सह ।\nपुरंदरः पुरा विप्रा मुमुचे ब्रह्महत्यया॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003948005, "chapter_id": 23948, "verse_number": "३-१-११-६", "content_sanskrit": "ऋषय ऊचुः ।\nब्रह्महत्या कथमभूद्वासवस्य पुरा मुने ।\nसीतासरसि स्नानात्कथं मुक्तोऽभवत्तया॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003948006, "chapter_id": 23948, "verse_number": "३-१-११-७", "content_sanskrit": "श्रीसूत उवाच ।\nकपालाभरणोनाम राक्षसोऽभूत्पुरा द्विजाः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003948007, "chapter_id": 23948, "verse_number": "३-१-११-८", "content_sanskrit": "अवध्यः सर्वदेवानां सोऽभवद्ब्रह्मणो वरात् ।\nशवभक्षणनामा तु तस्यासीन्मंत्रिसत्तमः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003948008, "chapter_id": 23948, "verse_number": "३-१-११-९", "content_sanskrit": "अक्षौहिणीशतं तस्य हयेभरथसंकुलम् ।\nअस्ति तस्य पुरं चापि वैजयंतमिति श्रुतम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003948009, "chapter_id": 23948, "verse_number": "३-१-११-१०", "content_sanskrit": "वसत्यस्मिन्पुरे सोऽयं कपालाभरणो बली ।\nशवभक्षं समाहूय बभाषे मंत्रिणं द्विजाः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003948010, "chapter_id": 23948, "verse_number": "३-१-११-११", "content_sanskrit": "शवभक्ष महावीर्य मंत्रशास्त्रेषु कोविद ।\nवयं देवपुरीं गत्वा विनिर्जित्य सुरान्रणे॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003948011, "chapter_id": 23948, "verse_number": "३-१-११-१२", "content_sanskrit": "शक्रस्य भवने रम्ये स्थास्यामस्सैनिकैः सह ।\nरमावो नंदने तस्य रंभाद्यप्सरसां गणैः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003948012, "chapter_id": 23948, "verse_number": "३-१-११-१३", "content_sanskrit": "कपालाभरणस्येदं निशम्य वचनं तदा ।\nशवभक्षोऽब्रवीद्विप्रा वचस्तत्र तथास्त्विति॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003948013, "chapter_id": 23948, "verse_number": "३-१-११-१४", "content_sanskrit": "ततः कपालाभरणः पुत्रं दुर्मेधसं बली ।\nप्रतिष्ठाप्य पुरे शूरं सेनया परिवारितः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003948014, "chapter_id": 23948, "verse_number": "३-१-११-१५", "content_sanskrit": "युयुत्सुरमरैः साकं प्रययावमरावतीम् ।\nगजाश्वरथपादातैरुद्धतै रेणुसंचयैः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003948015, "chapter_id": 23948, "verse_number": "३-१-११-१६", "content_sanskrit": "शोषयञ्जलधीन्सिंधूंश्चूर्णयन्पर्वतानपि ।\nनिःसाणध्वनिना विप्रा नादयन्रोदसी तथा॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003948016, "chapter_id": 23948, "verse_number": "३-१-११-१७", "content_sanskrit": "अश्वानां हेषितरवैर्गजानामपि बृंहितैः ।\nरथनेमिस्वनैरुग्रैः सिंहनादैः पदातिनाम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003948017, "chapter_id": 23948, "verse_number": "३-१-११-१८", "content_sanskrit": "श्रोत्राणि दिग्गजानां च वितन्वन्बधिराणि सः ।\nअगमद्देवनगरीं युयुत्सुरमरैः सह॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003948018, "chapter_id": 23948, "verse_number": "३-१-११-१९", "content_sanskrit": "तत इन्द्रादयो देवाः सेनाकलकलध्वनिम् ।\nश्रुत्वाभिनिर्य्ययुः पुर्या युद्धाभिमनसो द्विजाः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003948019, "chapter_id": 23948, "verse_number": "३-१-११-२०", "content_sanskrit": "ततो युद्धं समभवद्देवानां राक्षसैः सह ।\nअदृष्टपूर्वं जगति तथैवाश्रुतपूर्वकम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003948020, "chapter_id": 23948, "verse_number": "३-१-११-२१", "content_sanskrit": "तत इन्द्रादयो देवा राक्षसाञ्जघ्नुराहवे ।\nराक्षसाश्च सुराञ्जघ्नुः समरे विजिगीषवः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003948021, "chapter_id": 23948, "verse_number": "३-१-११-२२", "content_sanskrit": "द्वन्द्वयुद्धं च समभूदन्योन्यं सुररक्षसाम् ।\nकपालाभरणेनाजौ युयुधे बलवृत्रहा॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003948022, "chapter_id": 23948, "verse_number": "३-१-११-२३", "content_sanskrit": "यमेन शवभक्षश्च वरुणेन च कौशिकः ।\nकुबेरो रुधिराक्षेण युयुधे ब्राह्मणोत्तमाः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003948023, "chapter_id": 23948, "verse_number": "३-१-११-२४", "content_sanskrit": "मांसप्रियो मद्यसेवी क्रूरदृष्टिर्भयावहः ।\nचत्वार एते विक्रांताः कपालाभरणानुजाः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003948024, "chapter_id": 23948, "verse_number": "३-१-११-२५", "content_sanskrit": "अश्विभ्यामग्निवायुभ्यां युद्धे युयुधिरे मिथः ।\nततो यमो महावीर्यः कालदण्डेन वेगवान्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003948025, "chapter_id": 23948, "verse_number": "३-१-११-२६", "content_sanskrit": "शवभक्षं निहत्याजावनयद्यमसादनम् ।\nतस्य चाक्षौहिणीस्त्रिंशन्निजघ्ने समरे यमः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003948026, "chapter_id": 23948, "verse_number": "३-१-११-२७", "content_sanskrit": "वरुणः कौशिकस्याजौ प्रासेन प्राहरच्छिरः ।\nकुबेरो रुधिराक्षस्य कुन्तेनाभ्यहरच्छिरः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003948027, "chapter_id": 23948, "verse_number": "३-१-११-२८", "content_sanskrit": "अश्विभ्यामग्निवायुभ्यां कपालाभरणानुजाः ।\nनिहताः समरे विप्राः प्रययुर्यमसादनम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003948028, "chapter_id": 23948, "verse_number": "३-१-११-२९", "content_sanskrit": "अक्षौहिणीशतं चापि देवेन्द्रेण मृधे द्विजाः ।\nयामार्द्धेन हतं युद्धे प्रययौ यमसादनम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003948029, "chapter_id": 23948, "verse_number": "३-१-११-३०", "content_sanskrit": "ततः कपालाभरणः प्रेक्ष्य सेनां निजां हताम् ।\nचापमादाय निशिताञ्छरांश्चापि महाजवान्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003948030, "chapter_id": 23948, "verse_number": "३-१-११-३१", "content_sanskrit": "अभ्ययात्समरे शक्रं तिष्ठतिष्ठेति चाब्रवीत् ।\nततः शक्रस्य शिरसि व्यधमच्छरपंचकैः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003948031, "chapter_id": 23948, "verse_number": "३-१-११-३२", "content_sanskrit": "तानप्राप्तान्प्रचिच्छेद शरैर्युद्धे स वृत्रहा ।\nततः शूलं समादाय कपालाभरणो मृधे॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003948032, "chapter_id": 23948, "verse_number": "३-१-११-३३", "content_sanskrit": "देवेंद्राय प्रचिक्षेप तं शक्त्या निजघान सः ।\nततः कपालाभरणः शतहस्तायतां गदाम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003948033, "chapter_id": 23948, "verse_number": "३-१-११-३४", "content_sanskrit": "आयसीं पंचसाहस्रतुलाभारेणनिर्मिताम् ।\nआददे समरे शक्रं वक्षोदेशे जघान च॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003948034, "chapter_id": 23948, "verse_number": "३-१-११-३५", "content_sanskrit": "ततः स मूर्च्छितः शक्रो रथोपस्थ उपाविशत् ।\nमृतसंजीविनीं विद्यां जपित्वाथ बृहस्पतिः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003948035, "chapter_id": 23948, "verse_number": "३-१-११-३६", "content_sanskrit": "पुलोमजापतिं युद्धे समजीवयदद्भुतम् ।\nऐरावतं तदारुह्य कपालाभरणांतिकम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003948036, "chapter_id": 23948, "verse_number": "३-१-११-३७", "content_sanskrit": "आजगाम शचीभर्ता प्रहर्तुं कुलिशेन तम् ।\nएकप्रहारेण तदा महेंद्रः पाकशासनः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003948037, "chapter_id": 23948, "verse_number": "३-१-११-३८", "content_sanskrit": "कपालाभरणं युद्धे वज्रेण सरथाश्वकम् ।\nसचापं सध्वजं चैव सतूणीरं सवर्मकम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003948038, "chapter_id": 23948, "verse_number": "३-१-११-३९", "content_sanskrit": "चूर्णयामास कुपितस्तिलशः कणशस्तथा ।\nहते तस्मिन्महावीरे कपालाभरणे रणे॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003948039, "chapter_id": 23948, "verse_number": "३-१-११-४०", "content_sanskrit": "सुखं सर्वस्य लोकस्य बभूव चिरदुःखिनः ।\nराक्षसस्य वधोत्पन्ना ब्रह्महत्या पुरंदरम् ।\nअन्वधावत्तदा भीमा नादयंती दिशो दश॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003948040, "chapter_id": 23948, "verse_number": "३-१-११-४१", "content_sanskrit": "ऋषय ऊचुः ।\nन विप्रो राक्षसः सूत कपालाभरणो मुने ।\nतत्कथं ब्रह्महत्येंद्रं तद्वधात्समुपाद्रवत्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003948041, "chapter_id": 23948, "verse_number": "३-१-११-४२", "content_sanskrit": "श्रीसूत उवाच ।\nवक्ष्यामि परमं गुह्यं मुनींद्राः परमाद्भुतम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003948042, "chapter_id": 23948, "verse_number": "३-१-११-४३", "content_sanskrit": "शृणुत श्रद्धया यूयं समाधाय स्वमानसम् ।\nपुरा विंध्यप्रदेशेषु त्रिवक्रो नाम राक्षसः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003948043, "chapter_id": 23948, "verse_number": "३-१-११-४४", "content_sanskrit": "तस्य भार्या गुणोपेता सौंदर्यगुणशालिनी ।\nसुशीला नाम सुश्रोणी सर्वलक्षणलक्षिता॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003948044, "chapter_id": 23948, "verse_number": "३-१-११-४५", "content_sanskrit": "सा कदाचिन्मनोज्ञांगी सुवेषा चारुहासिनी ।\nविंध्यपादवनोद्देशे विचचार विलासिनी॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003948045, "chapter_id": 23948, "verse_number": "३-१-११-४६", "content_sanskrit": "तस्मिन्वने शुचिर्नाम वर्ततेस्म महामुनिः ।\nतपसमाधिसंयुक्तो वेदाध्ययनतत्परः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003948046, "chapter_id": 23948, "verse_number": "३-१-११-४७", "content_sanskrit": "तस्याश्रमसमीपं तु सा ययौ वरवर्णिनी ।\nतां दृष्ट्वा स मुनिर्धैर्यं मुमोचानंगपीडितः ।\nतामासाद्य वरारोहां बभाषे मुनिसत्तमः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003948047, "chapter_id": 23948, "verse_number": "३-१-११-४८", "content_sanskrit": "शुचिरुवाच ।\nललने स्वागतं तेऽस्तु कस्य भार्या शुचिस्मिते॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003948048, "chapter_id": 23948, "verse_number": "३-१-११-४९", "content_sanskrit": "किमागमनकृत्यं ते वनेऽस्मिन्नतिभीषणे ।\nश्रांतासि त्वं वरारोहे वसास्मिन्नुटजे मम॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003948049, "chapter_id": 23948, "verse_number": "३-१-११-५०", "content_sanskrit": "तथोक्ता सा तु सुश्रोणी तं मुनिं प्रत्यभाषत ।\nत्रिवक्ररक्षोभार्याहं सुशीला नामतो मुने॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003948050, "chapter_id": 23948, "verse_number": "३-१-११-५१", "content_sanskrit": "पुष्पावचयकामेन वनमेतत्समागता ।\nअपुत्राहं मुने भर्त्रा प्रेरिता पुत्रमिच्छता॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003948051, "chapter_id": 23948, "verse_number": "३-१-११-५२", "content_sanskrit": "शुचिं मुनिं समाराध्य तस्मात्पुत्रमवाप्नुहि ।\nइति प्रतिसमादिष्टा पतिना त्वां समागता॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003948052, "chapter_id": 23948, "verse_number": "३-१-११-५३", "content_sanskrit": "पुत्रमुत्पादय त्वं मे कृपां कुरु मुने मयि ।\nएवमुक्तः स तु शुचिः सुशीलां तामभाषत॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003948053, "chapter_id": 23948, "verse_number": "३-१-११-५४", "content_sanskrit": "शुचिरुवाच ।\nत्वां दृष्ट्वा मम च प्रीतिः सुशीले विद्यतेऽधुना ।\nमनोरथमहांभोधिं त्वमापूरय मामकम्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003948054, "chapter_id": 23948, "verse_number": "३-१-११-५५", "content_sanskrit": "इत्युक्त्वा स मुनिस्तत्र तया रेमे दिनत्रयम् ।\nतामुवाच मुनिः प्रीतः सुशालां सुन्दराकृतिम्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003948055, "chapter_id": 23948, "verse_number": "३-१-११-५६", "content_sanskrit": "तवोदरे महावीर्यः कपालाभरणाभिधः ।\nभविष्यति चिरं राज्यं पालयिष्यति मेदिनीम्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003948056, "chapter_id": 23948, "verse_number": "३-१-११-५७", "content_sanskrit": "सहस्रं वत्सरान्वत्सस्तपसा प्रीणयन्विधिम् ।\nपुरंदरं विनान्येभ्यो देवेभ्यो नास्य वध्यता॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003948057, "chapter_id": 23948, "verse_number": "३-१-११-५८", "content_sanskrit": "ईदृशस्ते सुतो भूयादिंद्रतुल्यपराक्रमः ।\nइत्युक्त्वा स मुनिर्नारीं काशीं शिवपुरीं ययौ॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003948058, "chapter_id": 23948, "verse_number": "३-१-११-५९", "content_sanskrit": "सुशीला सापि सुषुवे कपालाभरणं सुतम् ।\nतं जघान मृधे शक्रो वज्रेण मुनिपुंगवाः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003948059, "chapter_id": 23948, "verse_number": "३-१-११-६०", "content_sanskrit": "शुचेर्बीजसमुद्भूतं तमिंद्रो न्यवधीद्यतः ।\nततः पुरंदरः शक्रो जगृहे ब्रह्महत्यया॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003948060, "chapter_id": 23948, "verse_number": "३-१-११-६१", "content_sanskrit": "धावति स्म तदा शक्रः सर्वांल्लोकान्भयाकुलः ।\nधावंतमनुधावंती ब्रह्महत्या तमन्वगात्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003948061, "chapter_id": 23948, "verse_number": "३-१-११-६२", "content_sanskrit": "अनुद्रुतो हि विप्रेंद्राः शक्रोऽयं ब्रह्महत्यया ।\nपितामहसदः प्राप संतप्तहृदयो भृशम्॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003948062, "chapter_id": 23948, "verse_number": "३-१-११-६३", "content_sanskrit": "न्यवेदयद्ब्रह्महत्यां ब्रह्मणे स पुरंदरः ।\nभगवंल्लोकनाथेयं ब्रह्महत्याति भीषणा॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003948063, "chapter_id": 23948, "verse_number": "३-१-११-६४", "content_sanskrit": "बाधते मां प्रजानाथ तस्या नाशं ब्रवीहि मे ।\nपुरंदरेणैवमुक्तो ब्रह्मा प्राह दिवस्पतिम्॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003948064, "chapter_id": 23948, "verse_number": "३-१-११-६५", "content_sanskrit": "ब्रह्मोवाच ।\nसीताकुण्डं प्रयाहींद्र गंधमादनपर्वते ।\nसीताकुण्डस्य तीरे त्वं इष्ट्वा यागैः सदाशिवम्॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003948065, "chapter_id": 23948, "verse_number": "३-१-११-६६", "content_sanskrit": "तस्मिन्सरसि च स्नायाः सर्वपापहरे शुभे ।\nततः पूतो भवेश्शक्र बह्महत्याविमोचितः॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003948066, "chapter_id": 23948, "verse_number": "३-१-११-६७", "content_sanskrit": "देवलोकं पुनर्यायाः सर्वदुःखविवर्जितः ।\nसर्वपापहरं पुण्यं सीताकुण्डं विमुक्तिदम्॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003948067, "chapter_id": 23948, "verse_number": "३-१-११-६८", "content_sanskrit": "महापातकसंघानां नाशकं परमामृतम् ।\nसर्वदुःखप्रशमनं सर्वदारिद्र्यनाशनम्॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003948068, "chapter_id": 23948, "verse_number": "३-१-११-६९", "content_sanskrit": "धनधान्यप्रदं शुद्धं वैकुण्ठादिपदप्रदम् ।\nतस्मात्तत्र कुरुष्वेष्टिं सीतासरसि वृत्रहन्॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003948069, "chapter_id": 23948, "verse_number": "३-१-११-७०", "content_sanskrit": "इत्युक्तः सुरराजोऽसौ प्रययौ गंधमादनम् ।\nप्राप्य सीतासरो विप्राः स्नात्वेष्ट्वा च तदंतिके॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003948070, "chapter_id": 23948, "verse_number": "३-१-११-७१", "content_sanskrit": "प्रययौ स्वपुरीं भूयो ब्रह्महत्याविमोचितः ।\nएवं प्रभावं तत्तीर्थं सीतायाः कुण्डमुत्तमम्॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003948071, "chapter_id": 23948, "verse_number": "३-१-११-७२", "content_sanskrit": "राघवप्रत्ययार्थं हि प्रविश्य हुतवाहनम् ।\nसंनिधौ सर्वदेवानां मैथिली जनकात्मजा॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003948072, "chapter_id": 23948, "verse_number": "३-१-११-७३", "content_sanskrit": "विनिर्गता पुनर्वह्नेः स्थिता सर्वांगशोभना ।\nनिर्ममे लोकरक्षार्थं स्वनाम्ना तीर्थमुत्तमम्॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003948073, "chapter_id": 23948, "verse_number": "३-१-११-७४", "content_sanskrit": "तत्र सस्नौ स्वयं सीता तेन सीतासरः स्मृतम् ।\nतत्र यो मानवः स्नाति सर्वान्कामांल्लभेत सः॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003948074, "chapter_id": 23948, "verse_number": "३-१-११-७५", "content_sanskrit": "तस्मिन्नुपस्पृश्य नरो द्विजेंद्रा दत्त्वा च दानानि पृथग्विधानि ।\nकृत्वा च यज्ञान्बहुदक्षिणाभिर्लोकं प्रयायात्परमेश्वरस्य॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003948075, "chapter_id": 23948, "verse_number": "३-१-११-७६", "content_sanskrit": "युष्माकमेवं प्रथितं मुनींद्राः सीतासरो वैभवमेतदुक्तम् ।\nशृण्वन्पठन्वै तदिहैव भोगान्भुक्त्वा परत्रापि सुखं लभेत॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}]