[{"id": 2013506, "chapter_id": 1278, "verse_number": "२-१९-१", "content_sanskrit": "कृष्ण उवाच॥\nकस्यचित्त्वथ कालस्य पुनरेव महातपाः।\nमगधेषुपजक्राम भगवांश्चण्डकौशिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2013507, "chapter_id": 1278, "verse_number": "२-१९-२", "content_sanskrit": "तस्याऽऽगमनसंहृष्टः सामात्यः सपुरः सरः।\nसभार्यः सह पुत्रेण निर्जगाम बृहद्रथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2013508, "chapter_id": 1278, "verse_number": "२-१९-३", "content_sanskrit": "पाद्यार्घ्याचमनीयैस्तमर्चयामास भारत।\nस नृपो राज्यसहितं पुत्रं तस्मै न्यवेदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2013509, "chapter_id": 1278, "verse_number": "२-१९-४", "content_sanskrit": "प्रतिगृह्य च तां पूजां पार्थिवाद्भगवानृषिः।\nउवाच मागधं राजन्प्रहृष्टेनान्तरात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2013510, "chapter_id": 1278, "verse_number": "२-१९-५", "content_sanskrit": "सर्वमेतन्मया ज्ञातं राजन्दिव्येन चक्षुषा।\nपुत्रस्तु शृणु राजेन्द्र यादृशोऽयं भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2013511, "chapter_id": 1278, "verse_number": "२-१९-६", "content_sanskrit": "अस्य रूपं च सत्वं च बलमूर्जितमेव च।\nएष श्रिया समुदितः पुत्रस्तव न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2013512, "chapter_id": 1278, "verse_number": "२-१९-७", "content_sanskrit": "प्रापयिष्यति तत्सर्वं विक्रमेण समन्वितः।\nअस्य वीर्यवतो वीर्यं नानुयास्यन्ति पार्थिवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2013513, "chapter_id": 1278, "verse_number": "२-१९-८", "content_sanskrit": "पततो वैनतेयस्य गतिमन्ये यथा खगाः।\nविनाशमुपयास्यन्ति ये चास्य परिपन्थिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2013514, "chapter_id": 1278, "verse_number": "२-१९-९", "content_sanskrit": "देवैरपि विसृष्टानि शस्त्राण्यस्य महीपते।\nन रुजं जनयिष्यन्ति गिरेरिव नदीरयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2013515, "chapter_id": 1278, "verse_number": "२-१९-१०", "content_sanskrit": "सर्वमूर्धाभिषिक्तानामेव मूर्ध्नि ज्वलिष्यति।\nप्रभाहरोऽयं सर्वेषां ज्योतिषामिव भास्करः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2013516, "chapter_id": 1278, "verse_number": "२-१९-११", "content_sanskrit": "एनमासाद्य राजानः समृद्धबलवाहनाः।\nविनाशमुपयास्यन्ति शलभा इव पावकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2013517, "chapter_id": 1278, "verse_number": "२-१९-१२", "content_sanskrit": "एष श्रियः समुदिताः सर्वराज्ञां ग्रहीष्यति।\nवर्षास्विवोदीर्णजला नदीर्नदनदीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2013518, "chapter_id": 1278, "verse_number": "२-१९-१३", "content_sanskrit": "एष धारयित सम्यक्चातुर्वर्ण्यं महाबलः।\nशुभां शुभवतीं स्फीतां सर्वसस्यधरां धराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2013519, "chapter_id": 1278, "verse_number": "२-१९-१४", "content_sanskrit": "अस्याज्ञावशगाः सर्वे भविष्यन्ति नराधिपाः।\nसर्वभूतात्मभूतस्य वायोरिव शरीरिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2013520, "chapter_id": 1278, "verse_number": "२-१९-१५", "content_sanskrit": "एष रुद्रं महादेवं त्रिपुरान्तकरं हरम्।\nसर्वलोकेष्वतिबलः साक्षाद्द्रक्ष्यति मागधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2013521, "chapter_id": 1278, "verse_number": "२-१९-१६", "content_sanskrit": "एवं ब्रुवन्नेव मुनिः स्वकार्यमिव चिन्तयन्।\nविसर्जयामास नृपं बृहद्रथमथारिहन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2013522, "chapter_id": 1278, "verse_number": "२-१९-१७", "content_sanskrit": "प्रविश्य नगरीं चापि ज्ञातिसम्बन्धिभिर्वृतः।\nअभिषिच्य जरासन्धं मगधाधिपतिस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2013523, "chapter_id": 1278, "verse_number": "२-१९-१८", "content_sanskrit": "बृहद्रथो नरपतिः परां निर्वृतिमाययौ।\nअभिषिक्ते जरासन्धे तदा राजा बृहद्रथः।\nपत्नीद्वयेनानुगतस्तपोवनचरोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2013524, "chapter_id": 1278, "verse_number": "२-१९-१९", "content_sanskrit": "ततो वनस्थे पितरि मातृभ्यां सह भारत।\nजरासन्धः स्ववीर्येण पार्थिवानकरोद्वशे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2013525, "chapter_id": 1278, "verse_number": "२-१९-२०", "content_sanskrit": "अथ दीर्घस्य कालस्य तपोवनचरो नृपः।\nसभार्यः स्वर्गमगमत्तपस्तप्त्वा बृहद्रथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2013526, "chapter_id": 1278, "verse_number": "२-१९-२१", "content_sanskrit": "जरासन्धोऽपि नृपतिर्यथोक्तं कौशिकेन तत्।\nवरप्रदानमखिलं प्राप्य राज्यमपालयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2013527, "chapter_id": 1278, "verse_number": "२-१९-२२", "content_sanskrit": "हते चैव मया कंसे सहंसडिभिके तदा।\nजरासन्धस्य दुहिता रोदते पार्श्वतः पितुः।\nजातो वै वैरनिर्बन्धो मयासीत्तत्र भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2013528, "chapter_id": 1278, "verse_number": "२-१९-२३", "content_sanskrit": "भ्रामयित्वा शतगुणमेकोनं येन भारत।\nगदा क्षिप्ता बलवता मागधेन गिरिव्रजात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2013529, "chapter_id": 1278, "verse_number": "२-१९-२४", "content_sanskrit": "तिष्ठतो मथुरायां वै कुत्स्नस्याद्भुतकर्मणः।\nएकोनयोजनशते सा पपात गदा शुभा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2013530, "chapter_id": 1278, "verse_number": "२-१९-२५", "content_sanskrit": "दृष्ट्वा पौरैस्तदा सम्यग्गदा चैव निवेदिता।\nगदावसानं तत्ख्यातं मथुरायाः समीपतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2013531, "chapter_id": 1278, "verse_number": "२-१९-२६", "content_sanskrit": "तस्यास्तां हंसडिभिकावशस्त्रनिधनावुभौ।\nमन्त्रे मतिमतां श्रेष्ठौ नीतिशास्त्रे विशारदौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2013532, "chapter_id": 1278, "verse_number": "२-१९-२७", "content_sanskrit": "यौ तौ मया ते कथितौ पूर्वमेव महाबलौ।\nत्रयस्त्रयाणां लोकानां पर्याप्ता इति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2013533, "chapter_id": 1278, "verse_number": "२-१९-२८", "content_sanskrit": "एवमेष तदा वीर बलिभिः कुकुरान्धकैः।\nवृष्णिभिश्च महाराज नीतिहेतोरुपेक्षितः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2013534, "chapter_id": 1278, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि मन्त्रपर्वणि एकोनविंशोऽध्यायः॥ १९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]