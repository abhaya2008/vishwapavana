[{"id": 2192804, "chapter_id": 5102, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2192805, "chapter_id": 5102, "verse_number": "१", "content_sanskrit": "ऐश्वर्यं वा महत् प्राप्य धनं वा भरतर्षभ।\nदीर्घमायुरवाप्याथ कथं मृत्युमतिक्रमेत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2192806, "chapter_id": 5102, "verse_number": "२", "content_sanskrit": "तपसा वा सुमहता कर्मणा वा श्रुतेन वा ।\nरसायनप्रयोगैर्वा कैर्नोपैति जरान्तकौ\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2192807, "chapter_id": 5102, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2192808, "chapter_id": 5102, "verse_number": "३", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nभिक्षोः पञ्चशिखस्येह संवादं जनकस्य च\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2192809, "chapter_id": 5102, "verse_number": "४", "content_sanskrit": "वैदेहोजनको राजा महर्षिं वेदवित्तमम् ।\nपर्यपृच्छत् पञ्चशिखं छिन्नधर्मार्थसंशयम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2192810, "chapter_id": 5102, "verse_number": "५", "content_sanskrit": "केन वृत्तेन भगवन्नतिक्रामेज्जरान्तकौ ।\nतपसा वाथ बुद्ध्या वा कर्मणा वा श्रुतेन वा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2192811, "chapter_id": 5102, "verse_number": "६", "content_sanskrit": "एवमुक्तः स वैदेहं प्रत्युवाच परोक्षवित् ।\nनिवृत्तिर्नैतयोरस्ति नानिवृत्तिः कथञ्चन॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2192812, "chapter_id": 5102, "verse_number": "७", "content_sanskrit": "न ह्यहानि निवर्तन्ते न मासा न पुनः क्षपाः ।\nसोऽयं प्रपद्यतेऽध्वानं चिराय ध्रुवमध्रुवः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2192813, "chapter_id": 5102, "verse_number": "८", "content_sanskrit": "सर्वभूतसमुच्छेदः स्रोतसेवोह्यतेसदा ।\nउह्यमानं निमज्जन्तमप्लवेकालसागरे॥\nजरामृत्युमहाग्राहे न कश्चिदभिपद्यते॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2192814, "chapter_id": 5102, "verse_number": "९", "content_sanskrit": "नैवास्य भविता कश्चिन्नासौ भवति कस्यचित् ।\nपथि सङ्गतमेवेदं दारैरन्यैश्च बन्धुभिः॥\nनायमत्यन्तसंवासो लब्धपूर्वो हि केनचित्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2192815, "chapter_id": 5102, "verse_number": "१०", "content_sanskrit": "क्षिप्यन्ते तेन तेनैव निष्टनन्तः पुनः पुनः ।\nकालेन जाता जाता हि वायुनेवाभ्रसञ्चयाः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2192816, "chapter_id": 5102, "verse_number": "११", "content_sanskrit": "जरामृत्यू हि भूतानां खादितारौ वृकाविव ।\nबलिनां दुर्बलानां च ह्रस्वानां महतामपि\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2192817, "chapter_id": 5102, "verse_number": "१२", "content_sanskrit": "एवम्भूतेषु भूतेषु नित्यभूताध्रुवेषु च ।\nकथं हृष्येत जातेषु मृतेषु च कथं ज्वरेत्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2192818, "chapter_id": 5102, "verse_number": "", "content_sanskrit": "कुतोऽहमागतः कोऽस्मि क्व गमिष्यामि कस्य वा ।\nकस्मिन् स्थितः क्व भविता कस्मात् किमनुशोचसि\t॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2192819, "chapter_id": 5102, "verse_number": "१४", "content_sanskrit": "द्रष्टा स्वर्गस्य न ह्यस्ति तथैव नरकस्य च।\nआगमांस्त्वनतिक्रम्य दद्याच्चैव यजेत च\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2192820, "chapter_id": 5102, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे एकपञ्चाशोत्तरशततमोऽध्यायः ॥१५१॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]