[{"id": 2129341, "chapter_id": 3783, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2129342, "chapter_id": 3783, "verse_number": "१", "content_sanskrit": "अस्मिन् किल स्वयं राजन्निष्टवान् वै प्रजापतिः ।\nसत्रमिष्टीकृतं नाम पुरा वर्षसहस्रिकम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2129343, "chapter_id": 3783, "verse_number": "२", "content_sanskrit": "अम्बरीषश्च नाभाग इष्टवान् यमुनामनु ।\nयज्ञैश्च तपसा चैव परां सिद्धिमवाप ह\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2129344, "chapter_id": 3783, "verse_number": "३", "content_sanskrit": "देशो नाहुषयज्ञस्य अयं पुण्यतमो नृप ।\nयत्रेष्ट्वा दशपद्मानि सदस्येभ्योऽतिसृष्टवान्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2129345, "chapter_id": 3783, "verse_number": "४", "content_sanskrit": "सार्वभौमस्य कौन्तेय ययातेरमितद्युतेः ।\nस्पर्धमानस्य शक्रेण पश्येदं यज्ञवांस्त्विह\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2129346, "chapter_id": 3783, "verse_number": "५", "content_sanskrit": "पश्य नानाविधाकारैरग्निभिर्निचितं महीम् ।\nमज्जन्तीमिव चाक्रान्तां ययातेर्नृप कर्मभिः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2129347, "chapter_id": 3783, "verse_number": "६", "content_sanskrit": "एषा शम्येकपात्रा सा शकटं चैतदुत्तमम् ।\nपश्य रामह्रदानेतान् पश्य नारायणाश्रमान् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2129348, "chapter_id": 3783, "verse_number": "७", "content_sanskrit": "एतदार्चीकपुत्रस्य योगैर्विचरतो महीम् ।\nउपसर्पणमुर्वीश प्रख्यातममितौजसः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2129349, "chapter_id": 3783, "verse_number": "८", "content_sanskrit": "अत्रानुवंश्याः पठिताः शृणु मे कुरुनन्दन ।\nउलूखलैराभरणैः पिशाची यदभाषत\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2129350, "chapter_id": 3783, "verse_number": "९", "content_sanskrit": "युगन्धरे दधि प्राश्य उषित्वा चाच्युतस्थले ।\nतद्वद् भूतलये स्नात्वा सपुत्रा वस्तुमिच्छसि\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2129351, "chapter_id": 3783, "verse_number": "१०", "content_sanskrit": "एकरात्रमुषित्वेह द्वितीयं यदि वत्स्यसि ।\nएतद्धि मे दिवावृत्तं रात्रौ वृत्तमतोऽन्यथा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2129352, "chapter_id": 3783, "verse_number": "११", "content_sanskrit": "अत्राद्याभिनिवत्स्यामः क्षपां भरतसत्तम ।\nद्वारमेतत् तु कौन्तेय कुरुक्षेत्रस्य भारत \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2129353, "chapter_id": 3783, "verse_number": "१२", "content_sanskrit": "अत्रैव नाहुषो राजा राजन् क्रतुभिरिष्टवान् ।\nययातिर्बहुरत्नाढ्यो यत्रेन्द्रो मुदमाप्तवान्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2129354, "chapter_id": 3783, "verse_number": "१३", "content_sanskrit": "एतत् प्लक्षवटं नाम यमुनातीर्थमुच्यते ।\nएतद्वै नाकपृष्ठस्य द्वारमाहुर्मनीषिणः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2129355, "chapter_id": 3783, "verse_number": "१४", "content_sanskrit": "यत्र सारस्वतैर्यज्ञैरीजानाः परमर्षयः ।\nयूपोलूखलिनस्तत्र गच्छन्त्यवभृथप्लवम् ।\nअत्रोपस्पृश्य राजेन्द्र सर्वपापैः प्रमुच्यते \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2129356, "chapter_id": 3783, "verse_number": "१५", "content_sanskrit": "अत्र वै भरतो राजा राजन् क्रतुभिरिष्टवान् ।\nअसकृत् कृष्णसारङ्गं धर्मेणावाप्य मेदिनीम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2129357, "chapter_id": 3783, "verse_number": "१६", "content_sanskrit": "अत्रैव पुरुषव्याघ्र मरुत्तः सत्रमुत्तमम् ।\nचक्रे देवर्षिमुख्येन संवर्तेनाभिपालितः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2129358, "chapter_id": 3783, "verse_number": "१७", "content_sanskrit": "अत्रोपस्पृश्य राजेन्द्र सर्वाल्लँोकान् प्रपश्यसि ।\nपूयसे दुष्कृताच्चैव समुपस्पृश्य भारत\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2129359, "chapter_id": 3783, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2129360, "chapter_id": 3783, "verse_number": "१८", "content_sanskrit": "तत्र सभ्रातृकः स्नात्वा स्तूयमानो महर्षिभिः ।\nलोमशं पाण्डवश्रेष्ठ इदं वचनमब्रवीत् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2129361, "chapter_id": 3783, "verse_number": "१९", "content_sanskrit": "सर्वाल्लँोकान् प्रपश्यामि तपसा सत्यविक्रम ।\nइहस्थः पाण्डवश्रेष्ठं पश्यामि श्वेतवाहनम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2129362, "chapter_id": 3783, "verse_number": "२०", "content_sanskrit": "एवमेतन्महाबाहो पश्यन्ति परमर्षयः ।\nइह स्नात्वा तपोयुक्ताः त्रील्लँोकान् सचराचरान्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2129363, "chapter_id": 3783, "verse_number": "२१", "content_sanskrit": "सरस्वतीमिमां पुण्यां पुण्यैकशरणान्विताम् ।\nअत्र स्नात्वा नरश्रेष्ठ धूतपाप्मा भविष्यसि\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2129364, "chapter_id": 3783, "verse_number": "२२", "content_sanskrit": "इह सारस्वतैर्यज्ञैरिष्टवन्तः सुरर्षयः ।\nऋषयश्चैव कौन्तेय तथा राजर्षयोऽपि च\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2129365, "chapter_id": 3783, "verse_number": "२३", "content_sanskrit": "वेदिः प्रजापतेरेषा समन्तात् पञ्चयोजना ।\nकुरोश्च यज्ञशीलस्य क्षेत्रमेतन्महात्मनः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2129366, "chapter_id": 3783, "verse_number": "८१", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि पञ्चविंशोत्तरशततमोऽध्यायः ॥१२५॥\n॥ तीर्थयात्रापर्वणि एकाशीतितमोऽध्यायः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]