[{"id": 5000030000, "chapter_id": 9030, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000030001, "chapter_id": 9030, "verse_number": "१-३०-१", "content_sanskrit": "अथ तौ देशकालज्ञौ राजपुत्रावरिंदमौ ।\nदेशे काले च वाक्यज्ञावब्रूतां कौशिकं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000030002, "chapter_id": 9030, "verse_number": "१-३०-२", "content_sanskrit": "भगवञ्छ्रोतुमिच्छावो यस्मिन् काले निशाचरौ ।\nसंरक्षणीयौ तौ ब्रूहि नातिवर्तेत तत्क्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000030003, "chapter_id": 9030, "verse_number": "१-३०-३", "content_sanskrit": "एवं ब्रुवाणौ काकुत्स्थौ त्वरमाणौ युयुत्सया ।\nसर्वे ते मुनयः प्रीताः प्रशशंसुर्नृपात्मजौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000030004, "chapter_id": 9030, "verse_number": "१-३०-४", "content_sanskrit": "अद्यप्रभृति षड्रात्रं रक्षतां राघवौ युवाम् ।\nदीक्षां गतो ह्येष मुनिर्मौनित्वं च गमिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000030005, "chapter_id": 9030, "verse_number": "१-३०-५", "content_sanskrit": "तौ तु तद्वचनं श्रुत्वा राजपुत्रौ यशस्विनौ ।\nअनिद्रं षडहोरात्रं तपोवनमरक्षताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000030006, "chapter_id": 9030, "verse_number": "१-३०-६", "content_sanskrit": "उपासांचक्रतुर्वीरौ यत्तौ परमधन्विनौ ।\nररक्षतुर्मुनिवरं विश्वामित्रमरिंदमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000030007, "chapter_id": 9030, "verse_number": "१-३०-७", "content_sanskrit": "अथ काले गते तस्मिन् षष्ठेऽहनि तदागते ।\nसौमित्रिमब्रवीद् रामो यत्तो भव समाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000030008, "chapter_id": 9030, "verse_number": "१-३०-८", "content_sanskrit": "रामस्यैवं ब्रुवाणस्य त्वरितस्य युयुत्सया ।\nप्रजज्वाल ततो वेदिः सोपाध्यायपुरोहिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000030009, "chapter_id": 9030, "verse_number": "१-३०-९", "content_sanskrit": "सदर्भचमसस्रुक्का स समित्कुसुमोच्चया ।\nविश्वामित्रेण सहिता वेदिर्जज्वाल सर्त्विजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000030010, "chapter_id": 9030, "verse_number": "१-३०-१०", "content_sanskrit": "मन्त्रवच्च यथान्यायं यज्ञोऽसौ सम्प्रवर्तते ।\nआकाशे च महाञ्छ्ब्दः प्रादुरासीद् भयानकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000030011, "chapter_id": 9030, "verse_number": "१-३०-११", "content_sanskrit": "आवार्य गगनं मेघो यथा प्रावृषि दृश्यते ।\nतथा मायां विकुर्वाणौ राक्षसावभ्यधावताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000030012, "chapter_id": 9030, "verse_number": "१-३०-१२", "content_sanskrit": "मारीचश्च सुबाहुश्च तयोरनुचरास्तथा ।\nआगम्य भीमसंकाशा रुधिरौघानवासृजन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000030013, "chapter_id": 9030, "verse_number": "१-३०-१३", "content_sanskrit": "ताम् तेन रुधिरौघेण वेदीं वीक्ष्य समुक्षिताम् ।\nसहसाभिद्रुतो रामस्तानपश्यत् ततो दिवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000030014, "chapter_id": 9030, "verse_number": "१-३०-१४", "content_sanskrit": "तावापतन्तौ सहसा दृष्ट्वा राजीवलोचनः ।\nलक्ष्मणं त्वभिसम्प्रेक्ष्य रामो वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000030015, "chapter_id": 9030, "verse_number": "१-३०-१५", "content_sanskrit": "पश्य लक्ष्मण दुर्वृत्तान् राक्षसान् पिशिताशनान् ।\nमानवास्त्रसमाधूताननिलेन यथा घनान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000030016, "chapter_id": 9030, "verse_number": "१-३०-१६", "content_sanskrit": "करिष्यामि न संदेहो नोत्सहे हन्तुमीदृशान् ।\nइत्युक्त्वा वचनं रामश्चापे संधाय वेगवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000030017, "chapter_id": 9030, "verse_number": "१-३०-१७", "content_sanskrit": "मानवं परमोदारमस्त्रं परमभास्वरम् ।\nचिक्षेप परमक्रुद्धो मारीचोरसि राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000030018, "chapter_id": 9030, "verse_number": "१-३०-१८", "content_sanskrit": "स तेन परमास्त्रेण मानवेन समाहतः ।\nसम्पूर्णं योजनशतं क्षिप्तः सागरसम्प्लवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000030019, "chapter_id": 9030, "verse_number": "१-३०-१९", "content_sanskrit": "विचेतनं विघूर्णन्तं शीतेषुबलपीडितम् ।\nनिरस्तं दृश्य मारीचं रामो लक्ष्मणमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000030020, "chapter_id": 9030, "verse_number": "१-३०-२०", "content_sanskrit": "पश्य लक्ष्मण शीतेषुं मानवं मनुसंहितम् ।\nमोहयित्वा नयत्येनं न च प्राणैर्वियुज्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000030021, "chapter_id": 9030, "verse_number": "१-३०-२१", "content_sanskrit": "इमानपि वधिष्यामि निर्घृणान् दुष्टचारिणः ।\nराक्षसान् पापकर्मस्थान् यज्ञघ्नान् रुधिराशनान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000030022, "chapter_id": 9030, "verse_number": "१-३०-२२", "content_sanskrit": "इत्युक्त्वा लक्ष्मणं चाशु लाघवं दर्शयन्निव ।\nविगृह्य सुमहच्चास्त्रमाग्नेयं रघुनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000030023, "chapter_id": 9030, "verse_number": "१-३०-२३", "content_sanskrit": "सुबाहूरसि चिक्षेप स विद्धः प्रापतद् भुवि ।\nशेषान् वायव्यमादाय निजघान महायशाः ।\nराघवः परमोदारो मुनीनां मुदमावहन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000030024, "chapter_id": 9030, "verse_number": "१-३०-२४", "content_sanskrit": "स हत्वा राक्षसान् सर्वान् यज्ञघ्नान् रघुनन्दनः ।\nऋषिभिः पूजितस्तत्र यथेन्द्रो विजये पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000030025, "chapter_id": 9030, "verse_number": "१-३०-२५", "content_sanskrit": "अथ यज्ञे समाप्ते तु विश्वामित्रो महामुनिः ।\nनिरीतिका दिशो दृष्ट्वा काकुत्स्थमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000030026, "chapter_id": 9030, "verse_number": "१-३०-२६", "content_sanskrit": "कृतार्थोऽस्मि महाबाहो कृतं गुरुवचस्त्वया ।\nसिद्धाश्रममिदं सत्यं कृतं वीर महायशः ।\nस हि रामं प्रशस्यैवं ताभ्यां संध्यामुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000030027, "chapter_id": 9030, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]