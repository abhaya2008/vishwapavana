[{"id": 7000397000, "chapter_id": 20397, "verse_number": "२-६९-१", "content_sanskrit": "मातलिरुवाच ।\nअथ धर्माः शिवेनोक्ताः शिवधर्मागमोत्तमाः ।\nज्ञेया बहुविधास्ते च कर्मयोगप्रभेदतः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000397001, "chapter_id": 20397, "verse_number": "२-६९-२", "content_sanskrit": "हिंसादिदोषनिर्मुक्ताः क्लेशायासविवर्जिताः ।\nसर्वभूतहिताः शुद्धाः सूक्ष्मायासा महत्फलाः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000397002, "chapter_id": 20397, "verse_number": "२-६९-३", "content_sanskrit": "अनंतशाखाकलिताः शिवमूलैकसंश्रिताः ।\nज्ञानध्यानसुपुष्पाढ्याः शिवधर्माः सनातनाः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000397003, "chapter_id": 20397, "verse_number": "२-६९-४", "content_sanskrit": "धारयंति शिवं यस्माद्धार्यते शिवभाषितैः ।\nशिवधर्माः स्मृतास्तस्मात्संसारार्णवतारकाः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000397004, "chapter_id": 20397, "verse_number": "२-६९-५", "content_sanskrit": "तथाऽहि सा क्षमा सत्यं ह्रीः श्रद्धेन्द्रियसंयमः ।\nदानमिज्यातपोदानं दशकं धर्मसाधनम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000397005, "chapter_id": 20397, "verse_number": "२-६९-६", "content_sanskrit": "अथ व्यस्तैः समस्तैर्वा शिवधर्मैरनुष्ठितैः ।\nशिवैकरस्य संप्राप्तैर्गतिरेकैव कल्पिता॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000397006, "chapter_id": 20397, "verse_number": "२-६९-७", "content_sanskrit": "यथा भूः सर्वभूतानां स्थानं साधारणं स्मृतम् ।\nतत्तथा शिवभक्तानां तुल्यं शिवपुरंस्मृतम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000397007, "chapter_id": 20397, "verse_number": "२-६९-८", "content_sanskrit": "यथेह सर्वभूतानां भोगाः सातिशयाः स्मृताः ।\nनानापुण्यविशेषेण भोगाः शिवपुरे तथा॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000397008, "chapter_id": 20397, "verse_number": "२-६९-९", "content_sanskrit": "शुभाशुभफलं चापि भुज्यते सर्वदेहिभिः ।\nशिवधर्मस्य चैकस्य फलं तत्रोपभुज्यते॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000397009, "chapter_id": 20397, "verse_number": "२-६९-१०", "content_sanskrit": "यस्य यादृग्भवेत्पुण्यं श्रद्धापात्रविशेषतः ।\nभोगाः शिवपुरे तस्य ज्ञेयाः सातिशयाः शुभाः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000397010, "chapter_id": 20397, "verse_number": "२-६९-११", "content_sanskrit": "स्थानप्राप्तिः परं तुल्या भोगाः शांतिमयाः स्थिताः ।\nकुर्यात्पुण्यं महत्तस्मान्महाभोगजिगीषया॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000397011, "chapter_id": 20397, "verse_number": "२-६९-१२", "content_sanskrit": "सर्वातिशयमेवैकं भावितं च सुरोत्तमैः ।\nआत्मभोगाधिपत्यं स्याच्छिवः सर्वजगत्पतिः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000397012, "chapter_id": 20397, "verse_number": "२-६९-१३", "content_sanskrit": "केचित्तत्रैव मुच्यंते ज्ञानयोगरता नराः ।\nआवर्तंते पुनश्चान्ये संसारे भोगतत्पराः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000397013, "chapter_id": 20397, "verse_number": "२-६९-१४", "content_sanskrit": "तस्माद्विमुक्तिमिच्छंस्तु भोगासक्तिं च वर्जयेत् ।\nविरक्तः शांतचित्तात्मा शिवज्ञानमवाप्नुयात्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000397014, "chapter_id": 20397, "verse_number": "२-६९-१५", "content_sanskrit": "ये चापीशान्यहृदया यजंतीशं प्रसंगतः ।\nतेषामपि ददातीशः स्थानं भावानुरूपतः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000397015, "chapter_id": 20397, "verse_number": "२-६९-१६", "content_sanskrit": "तत्रार्चयंति ये रुद्रं सकृदुच्छिन्नकल्मषाः ।\nतेषां पिशाचलोकेषु भोगानीशः प्रयच्छति॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000397016, "chapter_id": 20397, "verse_number": "२-६९-१७", "content_sanskrit": "संतप्ता दुःखभारेण म्रियंते सर्वदेहिनः ।\nअन्नदः पुण्यदः प्रोक्तः प्राणदश्चापि सर्वदः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000397017, "chapter_id": 20397, "verse_number": "२-६९-१८", "content_sanskrit": "तस्मादन्नप्रदानेन सर्वदानफलं लभेत् ।\nत्रैलोक्ये यानि रत्नानि भोगस्त्रीवाहनानि च॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000397018, "chapter_id": 20397, "verse_number": "२-६९-१९", "content_sanskrit": "अन्नदानप्रदः सर्वमिहामुत्र फलं लभेत् ।\nयस्यान्नपानपुष्टांगः कुरुते पुण्यसंचयम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000397019, "chapter_id": 20397, "verse_number": "२-६९-२०", "content_sanskrit": "अन्नप्रदातुस्तस्यार्धं कर्तुश्चार्धं न संशयः ।\nधर्मार्थकाममोक्षाणां देहः परमसाधनम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000397020, "chapter_id": 20397, "verse_number": "२-६९-२१", "content_sanskrit": "स्थितिस्तस्यान्नपानाभ्यामतस्तत्सर्वसाधनम् ।\nअन्नं प्रजापतिः साक्षादन्नं विष्णुः शिवः स्वयम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000397021, "chapter_id": 20397, "verse_number": "२-६९-२२", "content_sanskrit": "तस्मादन्नसमं दानं न भूतं न भविष्यति ।\nत्रयाणामपि लोकानामुदकं जीवनं स्मृतम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000397022, "chapter_id": 20397, "verse_number": "२-६९-२३", "content_sanskrit": "पवित्रमुदकं दिव्यं शुद्धं सर्वरसायनम् ।\nअन्नपानाश्व गो वस्त्र शय्या सूत्रासनानि च॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000397023, "chapter_id": 20397, "verse_number": "२-६९-२४", "content_sanskrit": "प्रेतलोके प्रशस्तानि दानान्यष्टौ विशेषतः ।\nएवं दानविशेषेण धर्मराजपुरं नरः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000397024, "chapter_id": 20397, "verse_number": "२-६९-२५", "content_sanskrit": "यस्माद्याति सुखेनैव तस्माद्धर्मं समाचरेत् ।\nये पुनः क्रूरकर्माणः पापादानविवर्जिताः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000397025, "chapter_id": 20397, "verse_number": "२-६९-२६", "content_sanskrit": "भुंजते दारुणं दुःखं नरके नृपनंदन ।\nतथा सुखं प्रभुंजंति दानकर्तार एव तु॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000397026, "chapter_id": 20397, "verse_number": "२-६९-२७", "content_sanskrit": "तेषां तु संभवेत्सौख्यं कर्मयोगरतात्मनाम् ।\nअप्रमेयगुणैर्दिव्यैर्विमानैः सर्वकामकैः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000397027, "chapter_id": 20397, "verse_number": "२-६९-२८", "content_sanskrit": "असंख्यैस्तत्पुरं व्याप्तं प्राणिनामुपकारकैः ।\nसहस्रसोमदिव्यं वा सूर्यतेजः समप्रभम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000397028, "chapter_id": 20397, "verse_number": "२-६९-२९", "content_sanskrit": "रुद्रलोकमिति प्रोक्तमशेषगुणसंयुतम् ।\nसर्वेषां शिवभक्तानां तत्पुरं परिकीर्तितम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000397029, "chapter_id": 20397, "verse_number": "२-६९-३०", "content_sanskrit": "रुद्रक्षेत्रे मृतानां च जंगमस्थावरात्मनाम् ।\nअप्येकदिवसं भक्त्या यः पूजयति शंकरम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000397030, "chapter_id": 20397, "verse_number": "२-६९-३१", "content_sanskrit": "सोपि याति शिवस्थानं किं पुनर्बहुशोर्चयन् ।\nवैष्णवा विष्णुभक्ताश्च विष्णुध्यानपरायणाः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000397031, "chapter_id": 20397, "verse_number": "२-६९-३२", "content_sanskrit": "तेपि गच्छंति वैकुंठे समीपं देवचक्रिणः ।\nब्रह्मवादी च धर्मात्मा ब्रह्मलोकं प्रयाति सः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000397032, "chapter_id": 20397, "verse_number": "२-६९-३३", "content_sanskrit": "पुण्यकर्ता सुपुण्येन पुण्यलोकं प्रयाति च ।\nतस्मादीशे सदा भक्तिं भावयेदात्मनात्मनि॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000397033, "chapter_id": 20397, "verse_number": "२-६९-३४", "content_sanskrit": "हरौ वापि महाराज युक्तात्मा ज्ञानवान्स्वयम् ।\nतस्मात्सर्वविचारेण भावदोषविचारतः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000397034, "chapter_id": 20397, "verse_number": "२-६९-३५", "content_sanskrit": "एवं विष्णुप्रभावेण विशिष्टेनापि कर्मणा ।\nनरः स्थानमवाप्येतदेशभावानुरूपतः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000397035, "chapter_id": 20397, "verse_number": "२-६९-३६", "content_sanskrit": "इत्येतदपरं प्रोक्तं श्रीमच्छिवपुरं महत् ।\nदेहिनां कर्मनिष्ठानां पुनरावर्त्तकं स्मृतम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000397036, "chapter_id": 20397, "verse_number": "२-६९-३७", "content_sanskrit": "ऊर्ध्वं शिवपुराज्ज्ञेयं वैष्णवं लोकमुत्तमम् ।\nवैष्णवा मानवा यांति विष्णुध्यानपरायणाः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000397037, "chapter_id": 20397, "verse_number": "२-६९-३८", "content_sanskrit": "ब्राह्मणा ब्रह्मलोकं तु सदाचारा नरोत्तमाः ।\nप्रयांति यज्विनः सर्वे पुरीं तां तत्त्वकोविदाः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000397038, "chapter_id": 20397, "verse_number": "२-६९-३९", "content_sanskrit": "ऐंद्रं लोकं तथा यांति क्षत्रिया युद्धशालिनः ।\nअन्ये च पुण्यकर्त्तारः पुण्यलोकान्प्रयांति ते॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]