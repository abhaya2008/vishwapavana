[{"id": 2071091, "chapter_id": 2497, "verse_number": "१२-२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2071092, "chapter_id": 2497, "verse_number": "१२-२-१", "content_sanskrit": "स एवमुक्तस्तु तदा नारदो वदतांवरः।\nकथयामास तत्सर्वं यथा शप्तः स सूतजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2071093, "chapter_id": 2497, "verse_number": "१२-२-२x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2071094, "chapter_id": 2497, "verse_number": "१२-२-२", "content_sanskrit": "एवमेतन्महाबाहो यथा वदसि भारत।\nन कर्णार्जुनयोः किंचिदविषह्यं भवेद्रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2071095, "chapter_id": 2497, "verse_number": "१२-२-३", "content_sanskrit": "गुह्यमेतत्तु देवानां कथयिष्यामि ते नृप।\nतन्निबोध महाबाहो यथावृत्तमिदं पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2071096, "chapter_id": 2497, "verse_number": "१२-२-४", "content_sanskrit": "क्षत्रं स्वर्गं कथं गच्छेच्छस्त्रपूतमिति प्रभो।\nसंघर्षजननस्तस्मात्कन्यागर्भो विसर्जितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2071097, "chapter_id": 2497, "verse_number": "१२-२-५", "content_sanskrit": "स बालस्तेजसा युक्तः सूतपुत्रत्वमागतः।\nचकाराङ्गिरसां श्रेष्ठे धनुर्वेदं गुरौ तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2071098, "chapter_id": 2497, "verse_number": "१२-२-६", "content_sanskrit": "स बलं भीमसेनस्य फल्गुनस्यास्त्रलाघवम्।\nबुद्धिं च तव राजेन्द्र यमयोर्विनयं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2071099, "chapter_id": 2497, "verse_number": "१२-२-७", "content_sanskrit": "सख्यं च वासुदेवेन बाल्ये गाण्डीवधन्वनः।\nराजानामनुरागं च चिन्तयानो व्यदह्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2071100, "chapter_id": 2497, "verse_number": "१२-२-८", "content_sanskrit": "स सख्यमगमद्बाल्ये राज्ञा दुर्योधनेन च।\nयुष्माभिर्नित्यसंघृष्टो दैवाच्चापि स्वभावतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2071101, "chapter_id": 2497, "verse_number": "१२-२-९", "content_sanskrit": "विद्याधिकमथालक्ष्य धनुर्वेदे धनञ्जयम्।\nद्रोणं रहस्युपागम्य कर्णो वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2071102, "chapter_id": 2497, "verse_number": "१२-२-१०", "content_sanskrit": "ब्रह्मास्त्रं वेत्तुमिच्छामि सरहस्यनिवर्तनम्।\nअर्जुनेन समो युद्धे भवेयमिति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2071103, "chapter_id": 2497, "verse_number": "१२-२-११", "content_sanskrit": "समः पुत्रेषु च स्नेहः शिष्येषु च तव ध्रुवम्।\nत्वत्प्रसादान्न मा ब्रूयुरकृतास्त्रं विचक्षणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2071104, "chapter_id": 2497, "verse_number": "१२-२-१२", "content_sanskrit": "द्रोणस्तथोक्तः कर्णेन सापेक्षः फल्गुनं प्रति।\nदौरात्म्यं चैव कर्णस्य विदित्वा तमुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2071105, "chapter_id": 2497, "verse_number": "१२-२-१३", "content_sanskrit": "ब्रह्मास्त्रं ब्राह्मणो विद्याद्यथावच्चरितव्रतः।\nक्षत्रियो वा तपस्वी यो नान्यो विद्यात्कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2071106, "chapter_id": 2497, "verse_number": "१२-२-१४", "content_sanskrit": "इत्युक्तोऽङ्गिरसां श्रेष्ठमामन्त्र्य प्रतिपूज्य च।\nजगाम सहसा राजन्महेन्द्रं पर्वतं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2071107, "chapter_id": 2497, "verse_number": "१२-२-१५", "content_sanskrit": "स तु राममुपागम्य शिरसाऽभिप्रणम्य च।\nब्राह्मणो भार्गवोऽस्मीति गौरवेणाभ्यवन्दत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2071108, "chapter_id": 2497, "verse_number": "१२-२-१६", "content_sanskrit": "रामस्तं प्रतिजग्राह पृष्ट्वा गोत्रादि सर्वशः।\nउष्यतां स्वागतं चेति प्रीतिमांश्चाभवद्भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2071109, "chapter_id": 2497, "verse_number": "१२-२-१७", "content_sanskrit": "तत्र कर्णस्य वसतो महेन्द्रे स्वर्गसंमिते।\nगन्धर्वै राक्षसैर्यक्षैर्देवैश्चासीत्समागमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2071110, "chapter_id": 2497, "verse_number": "१२-२-१८", "content_sanskrit": "स तत्रेष्वस्त्रमकरोद्भृगुश्रेष्ठाद्यथाविधि।\nप्रियश्चाभवदत्यर्थं देवदानवरक्षसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2071111, "chapter_id": 2497, "verse_number": "१२-२-१९", "content_sanskrit": "स कदाचित्समुद्रान्ते विचरन्नाश्रमान्तिके।\nएकः खङ्गधनुष्पाणिः परिचक्राम सूतजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2071112, "chapter_id": 2497, "verse_number": "१२-२-२०", "content_sanskrit": "सोऽग्निहोत्रप्रसक्तस्य कस्यचिद्ब्रह्मवादिनः।\nजघानाज्ञानतः पार्थ होमधेनुं यदृच्छया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2071113, "chapter_id": 2497, "verse_number": "१२-२-२१", "content_sanskrit": "तदज्ञानकृतं मत्वा ब्राह्मणाय न्यवेदयत्।\nकर्णः प्रसादयंश्चैनमिदमित्यब्रवीद्वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2071114, "chapter_id": 2497, "verse_number": "१२-२-२२", "content_sanskrit": "अबुद्धिपूर्वं भगवन्धेनुरेषा हता तव।\nमया तत्र प्रसादं मे कुरुष्वेति पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2071115, "chapter_id": 2497, "verse_number": "१२-२-२३", "content_sanskrit": "तं स विप्रोऽब्रवीत्क्रुद्धो वाचा निर्भर्त्सयन्निव।\nदुराचार वधार्हस्त्वं फलं प्राप्स्यसि दुर्मते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2071116, "chapter_id": 2497, "verse_number": "१२-२-२४", "content_sanskrit": "येन विस्पर्धसे नित्यं यदर्थं घटसेऽनिशम्।\nयुध्यतस्तेन ते पाप भूमिश्चक्रं ग्रसिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2071117, "chapter_id": 2497, "verse_number": "१२-२-२५", "content_sanskrit": "ततश्चक्रे महीग्रस्ते मूर्धानं ते विचेष्टतः।\nपातयिष्यति विक्रम्य शत्रुर्गच्छ नराधम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2071118, "chapter_id": 2497, "verse_number": "१२-२-२६", "content_sanskrit": "यथेयं गौर्हता मूढ प्रमत्तस्य त्वया मम।\nप्रमत्तस्यैव मे वाचा शिरस्ते पातयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2071119, "chapter_id": 2497, "verse_number": "१२-२-२७", "content_sanskrit": "शप्तः प्रसादयामास कर्णस्तं द्विजसत्तमम्।\nगोभिर्धनैश्च रत्नैश्च स चैनं पुनरब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2071120, "chapter_id": 2497, "verse_number": "१२-२-२८", "content_sanskrit": "नेदमव्याहृतं कुर्याद्ब्रह्मलोकेऽपि केवलम्।\nगच्छ वा तिष्ठ वा यद्वा कार्यं यत्तत्समाचर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2071121, "chapter_id": 2497, "verse_number": "१२-२-२९", "content_sanskrit": "इत्युक्तो ब्राह्मणेनाथ कर्णो दैन्यादधोमुखः।\nराममभ्यागमद्भीतस्तदेव मनसा स्मरन्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2071122, "chapter_id": 2497, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि द्वितीयोऽध्यायः॥ २॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]