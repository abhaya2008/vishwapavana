[{"id": 7000802000, "chapter_id": 20802, "verse_number": "६-१४५-१", "content_sanskrit": "श्रीमहादेव उवाच ।\nततो गच्छेः महत्तीर्थे संगमेश्वरमुत्तमम् ।\nयत्र हस्तिमती पुण्या साभ्रमत्या हि संगता॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000802001, "chapter_id": 20802, "verse_number": "६-१४५-२", "content_sanskrit": "शापं कौडिन्यमुनितः प्राप्य शुष्काभवन्नदी ।\nबहिश्चर्येति नाम्ना वै लोके ख्यातिमुपागता॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000802002, "chapter_id": 20802, "verse_number": "६-१४५-३", "content_sanskrit": "तत्तीर्थं संप्रवक्ष्यामि पुण्यं त्रैलोक्यविश्रुतम् ।\nसर्वपापहरं पुण्यं त्रैलोक्ये चापि विश्रुतम्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000802003, "chapter_id": 20802, "verse_number": "६-१४५-४", "content_sanskrit": "यत्र तीर्थे नरः स्नात्वा दृष्ट्वा देवं महेश्वरम् ।\nमुच्यते सर्वपापेभ्यो रुद्रलोकं प्रगच्छति॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000802004, "chapter_id": 20802, "verse_number": "६-१४५-५", "content_sanskrit": "शृणु देवि प्रवक्ष्यामि एतच्छापस्य कारणम् ।\nयथैह शुष्करूपा हि जाता शापस्य कारणात्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000802005, "chapter_id": 20802, "verse_number": "६-१४५-६", "content_sanskrit": "यत्र साभ्रमती पुण्या गंगा नाम महानदी ।\nतत्र हस्तिमती नाम गंगया सह संगता॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000802006, "chapter_id": 20802, "verse_number": "६-१४५-७", "content_sanskrit": "तत्रारब्धं च मुनिना तपो वै परमं महत् ।\nएवं बहुगते काले ऋषिणा परमात्मना॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000802007, "chapter_id": 20802, "verse_number": "६-१४५-८", "content_sanskrit": "आराधितो हृषीकेशो नारायणनिरंजनः ।\nतस्यास्तटे तु देवेशि वर्षाणि च बहून्यपि॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000802008, "chapter_id": 20802, "verse_number": "६-१४५-९", "content_sanskrit": "गतानि च विशेषेण मुनेस्तस्य तु पार्वति ।\nकदाचिद्दैवयोगाच्च वर्षाकालः समागतः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000802009, "chapter_id": 20802, "verse_number": "६-१४५-१०", "content_sanskrit": "नदी तत्र तु संपूर्णा कालयोगेन सुव्रते ।\nतत्कौंडिन्येन ऋषिणा स्थानं त्यक्तं तदा निशि॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000802010, "chapter_id": 20802, "verse_number": "६-१४५-११", "content_sanskrit": "रात्रौ दुःखं महज्जातं हाहेति करुणो रुदन् ।\nकिं कर्तव्यमिति ध्यायन्नतिचिंतापरोऽभवत्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000802011, "chapter_id": 20802, "verse_number": "६-१४५-१२", "content_sanskrit": "आश्रमो हि महादिव्यो ऋषिणैव समायुतः ।\nस गतो वारियोगेन हस्तिमत्यां सुरोत्तमे॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000802012, "chapter_id": 20802, "verse_number": "६-१४५-१३", "content_sanskrit": "फलानि चैव मूलानि पुस्तकानि बहून्यपि ।\nतानि तस्यां गतान्येव वारियोगेन सुंदरि॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000802013, "chapter_id": 20802, "verse_number": "६-१४५-१४", "content_sanskrit": "स कौंडिन्यो ऋषिश्रेष्ठः शशाप तां नदीं किल ।\nउदकेन विना त्वं च भविष्यसि कलौ युगे॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000802014, "chapter_id": 20802, "verse_number": "६-१४५-१५", "content_sanskrit": "एवं स दत्त्वा वै शापं हस्तिमत्या महेश्वरि ।\nगतोऽसौ विप्रप्रवरो विष्णुलोकं सनातनम्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000802015, "chapter_id": 20802, "verse_number": "६-१४५-१६", "content_sanskrit": "अद्यापि वर्तते तीर्थं संगमेश्वरसंज्ञकम् ।\nयं दृष्ट्वा मुच्यते पापी ब्रह्महत्यादि पातकात्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]