[{"id": 900008329, "chapter_id": 8627, "verse_number": "8.1", "content_sanskrit": "ॐ अन्तस्तद्धर्मोपदेशात् ॐ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900008330, "chapter_id": 8627, "verse_number": "8.2", "content_sanskrit": "यद्वा यदि ब्रह्मशब्दादानन्दमयो ब्रह्म..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900008331, "chapter_id": 8627, "verse_number": "8.3", "content_sanskrit": "अत्रान्तस्स्थः किमिन्द्रादिः किं वा विष्णुरिति चिन्ता..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900008332, "chapter_id": 8627, "verse_number": "8.4", "content_sanskrit": "सूर्य एवान्तस्स्थः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900008333, "chapter_id": 8627, "verse_number": "8.5", "content_sanskrit": "यद्वा वरुणलिङ्गस्यान्ते ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900008334, "chapter_id": 8627, "verse_number": "8.6", "content_sanskrit": "सिद्धान्तस्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900008335, "chapter_id": 8627, "verse_number": "8.7", "content_sanskrit": "किञ्च ‘‘इन्द्रं मित्रं वरुणमग्निमाहुः’’..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900008336, "chapter_id": 8627, "verse_number": "8.8", "content_sanskrit": "यदि च श्रुतिलिङ्गयोरनुग्रहायाभेदस्तर्हि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900008337, "chapter_id": 8627, "verse_number": "8.9", "content_sanskrit": "तत्राद्यद्वितीयौ प्रथमसूत्रेण निरस्तौ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900008338, "chapter_id": 8627, "verse_number": "8.10", "content_sanskrit": "अन्ये तु ‘‘य एषोऽन्तरादित्ये हिरण्मयः पुरुषो दृश्यते ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900008339, "chapter_id": 8627, "verse_number": "8.11", "content_sanskrit": "केचित्तु इदमेव वाक्यमुदाहृत्यैवमेव च पूर्वपक्षयित्वा..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900008340, "chapter_id": 8627, "verse_number": "8.12", "content_sanskrit": "नीरूपेऽपि च रूपादि यद्युपास्त्यर्थमुच्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900008341, "chapter_id": 8627, "verse_number": "8.13", "content_sanskrit": "यच्चोपादानं ब्रह्म ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900008342, "chapter_id": 8627, "verse_number": "8.14", "content_sanskrit": "यच्चोक्तं सविशेषनिरूपणं मोक्षसाधननिर्विशेषज्ञानार्थमिति तन्न", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900008343, "chapter_id": 8627, "verse_number": "8.15", "content_sanskrit": "किञ्च सविशेषज्ञानं निर्विशेषज्ञानस्य न तावद्दृष्टद्वारा हेतुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900008344, "chapter_id": 8627, "verse_number": "8.16", "content_sanskrit": "नापि सविशेषध्यानं निर्विशेषज्ञानार्थमिति द्वितीयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900008345, "chapter_id": 8627, "verse_number": "8.17", "content_sanskrit": "टीकाक्षरार्थस्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]