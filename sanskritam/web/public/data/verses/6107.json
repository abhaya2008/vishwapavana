[
  {
    "id": 16707001,
    "chapter_id": 6107,
    "verse_number": "1.1",
    "content_sanskrit": "उशन्ह वै वाजश्रवसः सर्ववेदसं ददौ । तस्य ह नचिकेता नाम पुत्र आस ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "base_unit_id": "Ka_C01_S01_V01"
  },
  {
    "id": 16707002,
    "chapter_id": 6107,
    "verse_number": "1.2",
    "content_sanskrit": "तꣳ ह कुमारꣳ सन्तं दक्षिणासु नीयमानासु श्रद्धाविवेश सोऽमन्यत ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "base_unit_id": "Ka_C01_S01_V02"
  },
  {
    "id": 16707003,
    "chapter_id": 6107,
    "verse_number": "1.3",
    "content_sanskrit": "पीतोदका जग्धतृणादुग्धदोहा निरिन्द्रियाः ।\nअनन्दा नाम ते लोकास्तान्स गच्छति ता ददत् ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "base_unit_id": "Ka_C01_S01_V03"
  },
  {
    "id": 16707004,
    "chapter_id": 6107,
    "verse_number": "1.4",
    "content_sanskrit": "स होवाच पितरं तत कस्मै मां दास्यसीति द्वितीयं तृतीयं तं होवाच मृत्यवे त्वा ददामीति ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "base_unit_id": "Ka_C01_S01_V04"
  },
  {
    "id": 16707005,
    "chapter_id": 6107,
    "verse_number": "1.5",
    "content_sanskrit": "बहूनामेमि प्रथमो बहूनामेमि मध्यमः ।\nकिं स्विद्यमस्य कर्तव्यं यन्मयाद्य करिष्यति ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "base_unit_id": "Ka_C01_S01_V05"
  },
  {
    "id": 16707006,
    "chapter_id": 6107,
    "verse_number": "1.6",
    "content_sanskrit": "अनुपश्य यथा पूर्वे प्रतिपश्य तथा परे ।\nसस्यमिव मर्त्यः पच्यते सस्यमिवाजायते पुनः ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "base_unit_id": "Ka_C01_S01_V06"
  },
  {
    "id": 16707007,
    "chapter_id": 6107,
    "verse_number": "1.7",
    "content_sanskrit": "वैश्वानरः प्रविशति अतिथिर्ब्राह्मणो गृहान् ।\nतस्यैतां शान्तिं कुर्वन्ति हर वैवस्वतोदकम् ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "base_unit_id": "Ka_C01_S01_V07"
  },
  {
    "id": 16707008,
    "chapter_id": 6107,
    "verse_number": "1.8",
    "content_sanskrit": "आशाप्रतीक्षे सङ्गतं सूनृतां च इष्टापूर्ते पुत्रपशूंश्च सर्वान् ।\nएतद्वृङ्क्ते पुरुषस्याल्पमेधसो यस्यानश्नन्वसति ब्राह्मणो गृहे ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "base_unit_id": "Ka_C01_S01_V08"
  },
  {
    "id": 16707009,
    "chapter_id": 6107,
    "verse_number": "1.9",
    "content_sanskrit": "तिस्रो रात्रीर्यदवात्सीर्गृहे मे अनश्नन्ब्रह्मन्नतिथिर्नमस्यः ।\nनमस्तेऽस्तु ब्रह्मन्स्वस्ति मेऽस्तु तस्मात्प्रति त्रीन्वरान्वृणीष्व ॥ ९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "base_unit_id": "Ka_C01_S01_V09"
  },
  {
    "id": 16707010,
    "chapter_id": 6107,
    "verse_number": "1.10",
    "content_sanskrit": "शान्तसङ्कल्पः सुमना यथा स्याद्वीतमन्युर्गौतमो माभिमृत्यो ।\nत्वत्प्रसृष्टं माभिवदेत्प्रतीत एतत्त्रयाणां प्रथमं वरं वृणे ॥ १० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "base_unit_id": "Ka_C01_S01_V10"
  },
  {
    "id": 16707011,
    "chapter_id": 6107,
    "verse_number": "1.11",
    "content_sanskrit": "यथा पुरस्ताद्भविता प्रतीत औद्दालकिरारुणिर्मत्प्रसृष्टः ।\nसुखं रात्रीः शयिता वीतमन्युस्त्वां ददृशिवान्मृत्युमुखात्प्रमुक्तम् ॥ ११ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "base_unit_id": "Ka_C01_S01_V11"
  },
  {
    "id": 16707012,
    "chapter_id": 6107,
    "verse_number": "1.12",
    "content_sanskrit": "स्वर्गे लोके न भयं किञ्चनास्ति न तत्र त्वं न जरया बिभेति ।\nउभे तीर्त्वा अशनायापिपासे शोकातिगो मोदते स्वर्गलोके ॥ १२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "base_unit_id": "Ka_C01_S01_V12"
  },
  {
    "id": 16707013,
    "chapter_id": 6107,
    "verse_number": "1.13",
    "content_sanskrit": "स त्वमग्निं स्वर्ग्यमध्येषि मृत्यो प्रब्रूहि तं श्रद्दधानाय मह्यम् ।\nस्वर्गलोका अमृतत्वं भजन्त एतद्द्वितीयेन वृणे वरेण ॥ १३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "base_unit_id": "Ka_C01_S01_V13"
  },
  {
    "id": 16707014,
    "chapter_id": 6107,
    "verse_number": "1.14",
    "content_sanskrit": "प्र ते ब्रवीमि तदु मे निबोध स्वर्ग्यमग्निं नचिकेतः प्रजानन् ।\nअनन्तलोकाप्तिमथो प्रतिष्ठां विद्धि त्वमेतं निहितं गुहायाम् ॥ १४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "base_unit_id": "Ka_C01_S01_V14"
  },
  {
    "id": 16707015,
    "chapter_id": 6107,
    "verse_number": "1.15",
    "content_sanskrit": "लोकादिमग्निं तमुवाच तस्मै या इष्टका यावतीर्वा यथा वा ।\nस चापि तत्प्रत्यवदद्यथोक्तमथास्य मृत्युः पुनरेवाह तुष्टः ॥ १५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "base_unit_id": "Ka_C01_S01_V15"
  },
  {
    "id": 16707016,
    "chapter_id": 6107,
    "verse_number": "1.16",
    "content_sanskrit": "तमब्रवीत्प्रीयमाणो महात्मा वरं तवेहाद्य ददामि भूयः ।\nतवैव नाम्ना भवितायमग्निः सृङ्कां चेमामनेकरूपां गृहाण ॥ १६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "base_unit_id": "Ka_C01_S01_V16"
  },
  {
    "id": 16707017,
    "chapter_id": 6107,
    "verse_number": "1.17",
    "content_sanskrit": "त्रिणाचिकेतस्त्रिभिरेत्य सन्धिं त्रिकर्मकृत्तरति जन्ममृत्यू ।\nब्रह्मजज्ञं देवमीड्यं विदित्वा निचाय्येमां शान्तिमत्यन्तमेति ॥ १७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "base_unit_id": "Ka_C01_S01_V17"
  },
  {
    "id": 16707018,
    "chapter_id": 6107,
    "verse_number": "1.18",
    "content_sanskrit": "त्रिणाचिकेतस्त्रयमेतद्विदित्वा य एवं विद्वांश्चिनुते नाचिकेतम् ।\nस मृत्युपाशान्पुरतः प्रणोद्य शोकातिगो मोदते स्वर्गलोके ॥ १८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "base_unit_id": "Ka_C01_S01_V18"
  },
  {
    "id": 16707019,
    "chapter_id": 6107,
    "verse_number": "1.19",
    "content_sanskrit": "एष तेऽग्निर्नचिकेतः स्वर्ग्यो यमवृणीथा द्वितीयेन वरेण ।\nएतमग्निं तवैव प्रवक्ष्यन्ति जनासस्तृतीयं वरं नचिकेतो वृणीष्व ॥ १९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "base_unit_id": "Ka_C01_S01_V19"
  },
  {
    "id": 16707020,
    "chapter_id": 6107,
    "verse_number": "1.20",
    "content_sanskrit": "येयं प्रेते विचिकित्सा मनुष्ये अस्तीत्येके नायमस्तीति चैके ।\nएतद्विद्यामनुशिष्टस्त्वयाहं वराणामेष वरस्तृतीयः ॥ २० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "base_unit_id": "Ka_C01_S01_V20"
  },
  {
    "id": 16707021,
    "chapter_id": 6107,
    "verse_number": "1.21",
    "content_sanskrit": "देवैरत्रापि विचिकित्सितं पुरा न हि सुविज्ञेयमणुरेष धर्मः ।\nअन्यं वरं नचिकेतो वृणीष्व मा मोपरोत्सीरति मा सृजैनम् ॥ २१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "base_unit_id": "Ka_C01_S01_V21"
  },
  {
    "id": 16707022,
    "chapter_id": 6107,
    "verse_number": "1.22",
    "content_sanskrit": "देवैरत्रापि विचिकित्सितं किल त्वं च मृत्यो यन्न सुज्ञेयमात्थ ।\nवक्ता चास्य त्वादृगन्यो न लभ्यो नान्यो वरस्तुल्य एतस्य कश्चित् ॥ २२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "base_unit_id": "Ka_C01_S01_V22"
  },
  {
    "id": 16707023,
    "chapter_id": 6107,
    "verse_number": "1.23",
    "content_sanskrit": "शतायुषः पुत्रपौत्रान्वृणीष्व बहून्पशून्हस्तिहिरण्यमश्वान् ।\nभूमेर्महदायतनं वृणीष्व स्वयं च जीव शरदो यावदिच्छसि ॥ २३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "base_unit_id": "Ka_C01_S01_V23"
  },
  {
    "id": 16707024,
    "chapter_id": 6107,
    "verse_number": "1.24",
    "content_sanskrit": "एतत्तुल्यं यदि मन्यसे वरं वृणीष्व वित्तं चिरजीविकां च ।\nमहाभूमौ नचिकेतस्त्वमेधि कामानां त्वा कामभाजं करोमि ॥ २४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "base_unit_id": "Ka_C01_S01_V24"
  },
  {
    "id": 16707025,
    "chapter_id": 6107,
    "verse_number": "1.25",
    "content_sanskrit": "ये ये कामा दुर्लभा मर्त्यलोके सर्वान्कामांश्छन्दतः प्रार्थयस्व ।\nइमा रामाः सरथाः सतूर्या न हीदृशा लम्भनीया मनुष्यैः ।\nआभिर्मत्प्रत्ताभिः परिचारयस्व नचिकेतो मरणं मानुप्राक्षीः ॥ २५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "base_unit_id": "Ka_C01_S01_V25"
  },
  {
    "id": 16707026,
    "chapter_id": 6107,
    "verse_number": "1.26",
    "content_sanskrit": "श्वोभावा मर्त्यस्य यदन्तकैतत्सर्वेन्द्रियाणां जरयन्ति तेजः ।\nअपि सर्वं जीवितमल्पमेव तवैव वाहास्तव नृत्यगीते ॥ २६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "base_unit_id": "Ka_C01_S01_V26"
  },
  {
    "id": 16707027,
    "chapter_id": 6107,
    "verse_number": "1.27",
    "content_sanskrit": "न वित्तेन तर्पणीयो मनुष्यो लप्स्यामहे वित्तमद्राक्ष्म चेत्त्वा ।\nजीविष्यामो यावदीशिष्यसि त्वं वरस्तु मे वरणीयः स एव ॥ २७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "base_unit_id": "Ka_C01_S01_V27"
  },
  {
    "id": 16707028,
    "chapter_id": 6107,
    "verse_number": "1.28",
    "content_sanskrit": "अजीर्यताममृतानामुपेत्य जीर्यन्मर्त्यः क्वधःस्थः प्रजानन् ।\nअभिध्यायन्वर्णरतिप्रमोदानतिदीर्घे जीविते को रमेत ॥ २८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "base_unit_id": "Ka_C01_S01_V28"
  },
  {
    "id": 16707029,
    "chapter_id": 6107,
    "verse_number": "1.29",
    "content_sanskrit": "यस्मिन्निदं विचिकित्सन्ति मृत्यो यत्साम्पराये महति ब्रूहि नस्तत् ।\nयोऽयं वरो गूढमनुप्रविष्टो नान्यं तस्मान्नचिकेता वृणीते ॥ २९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "base_unit_id": "Ka_C01_S01_V29"
  },
  {
    "id": 16707030,
    "chapter_id": 6107,
    "verse_number": "1.30",
    "content_sanskrit": "अन्यच्छ्रेयोऽन्यदुतैव प्रेयस्ते उभे नानार्थे पुरुषं सिनीतः ।\nतयोः श्रेय आददानस्य साधु भवति हीयतेऽर्थाद्य उ प्रेयो वृणीते ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "base_unit_id": "Ka_C01_S02_V01"
  },
  {
    "id": 16707031,
    "chapter_id": 6107,
    "verse_number": "1.31",
    "content_sanskrit": "श्रेयश्च प्रेयश्च मनुष्यमेतस्तौ सम्परीत्य विविनक्ति धीरः ।\nश्रेयो हि धीरोऽभि प्रेयसो वृणीते प्रेयो मन्दो योगक्षेमाद्वृणीते ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "base_unit_id": "Ka_C01_S02_V02"
  },
  {
    "id": 16707032,
    "chapter_id": 6107,
    "verse_number": "1.32",
    "content_sanskrit": "स त्वं प्रियान्प्रियरूपांश्च कामानभिध्यायन्नचिकेतोऽत्यस्राक्षीः ।\nनैतां सृङ्कां वित्तमयीमवाप्तो यस्यां मज्जन्ति बहवो मनुष्याः ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "base_unit_id": "Ka_C01_S02_V03"
  },
  {
    "id": 16707033,
    "chapter_id": 6107,
    "verse_number": "1.33",
    "content_sanskrit": "दूरमेते विपरीते विषूची अविद्या या च विद्येति ज्ञाता ।\nविद्याभीप्सिनं नचिकेतसं मन्ये न त्वा कामा बहवोऽलोलुपन्त ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "base_unit_id": "Ka_C01_S02_V04"
  },
  {
    "id": 16707034,
    "chapter_id": 6107,
    "verse_number": "1.34",
    "content_sanskrit": "अविद्यायामन्तरे वर्तमानाः स्वयं धीराः पण्डितंमन्यमानाः ।\nदन्द्रम्यमाणाः परियन्ति मूढा अन्धेनैव नीयमाना यथान्धाः ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "base_unit_id": "Ka_C01_S02_V05"
  },
  {
    "id": 16707035,
    "chapter_id": 6107,
    "verse_number": "1.35",
    "content_sanskrit": "न साम्परायः प्रतिभाति बालं प्रमाद्यन्तं वित्तमोहेन मूढम् ।\nअयं लोको नास्ति पर इति मानी पुनः पुनर्वशमापद्यते मे ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "base_unit_id": "Ka_C01_S02_V06"
  },
  {
    "id": 16707036,
    "chapter_id": 6107,
    "verse_number": "1.36",
    "content_sanskrit": "श्रवणायापि बहुभिर्यो न लभ्यः शृण्वन्तोऽपि बहवो यं न विद्युः ।\nआश्चर्यो वक्ता कुशलोऽस्य लब्धा आश्चर्यो ज्ञाता कुशलानुशिष्टः ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "base_unit_id": "Ka_C01_S02_V07"
  },
  {
    "id": 16707037,
    "chapter_id": 6107,
    "verse_number": "1.37",
    "content_sanskrit": "न नरेणावरेण प्रोक्त एष सुविज्ञेयो बहुधा चिन्त्यमानः ।\nअनन्यप्रोक्ते गतिरत्र नास्ति अणीयान्ह्यतर्क्यमणुप्रमाणात् ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "base_unit_id": "Ka_C01_S02_V08"
  },
  {
    "id": 16707038,
    "chapter_id": 6107,
    "verse_number": "1.38",
    "content_sanskrit": "नैषा तर्केण मतिरापनेया प्रोक्तान्येनैव सुज्ञानाय प्रेष्ठ ।\nयां त्वमापः सत्यधृतिर्बतासि त्वादृङ् नो भूयान्नचिकेतः प्रष्टा ॥ ९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "base_unit_id": "Ka_C01_S02_V09"
  },
  {
    "id": 16707039,
    "chapter_id": 6107,
    "verse_number": "1.39",
    "content_sanskrit": "जानाम्यहं शेवधिरित्यनित्यं न ह्यध्रुवैः प्राप्यते हि ध्रुवं तत् ।\nततो मया नाचिकेतश्चितोऽग्निरनित्यैर्द्रव्यैः प्राप्तवानस्मि नित्यम् ॥ १० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "base_unit_id": "Ka_C01_S02_V10"
  },
  {
    "id": 16707040,
    "chapter_id": 6107,
    "verse_number": "1.40",
    "content_sanskrit": "कामस्याप्तिं जगतः प्रतिष्ठां क्रतोरनन्त्यमभयस्य पारम् ।\nस्तोममहदुरुगायं प्रतिष्ठां दृष्ट्वा धृत्या धीरो नचिकेतोऽत्यस्राक्षीः ॥ ११ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "base_unit_id": "Ka_C01_S02_V11"
  },
  {
    "id": 16707041,
    "chapter_id": 6107,
    "verse_number": "1.41",
    "content_sanskrit": "तं दुर्दर्शं गूढमनुप्रविष्टं गुहाहितं गह्वरेष्ठं पुराणम् ।\nअध्यात्मयोगाधिगमेन देवं मत्वा धीरो हर्षशोकौ जहाति ॥ १२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "base_unit_id": "Ka_C01_S02_V12"
  },
  {
    "id": 16707042,
    "chapter_id": 6107,
    "verse_number": "1.42",
    "content_sanskrit": "एतच्छ्रुत्वा सम्परिगृह्य मर्त्यः प्रवृह्य धर्म्यमणुमेतमाप्य ।\nस मोदते मोदनीयं हि लब्ध्वा विवृतं सद्म नचिकेतसं मन्ये ॥ १३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "base_unit_id": "Ka_C01_S02_V13"
  },
  {
    "id": 16707043,
    "chapter_id": 6107,
    "verse_number": "1.43",
    "content_sanskrit": "अन्यत्र धर्मादन्यत्राधर्मादन्यत्रास्मात्कृताकृतात् ।\nअन्यत्र भूताच्च भव्याच्च यत्तत्पश्यसि तद्वद ॥ १४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "base_unit_id": "Ka_C01_S02_V14"
  },
  {
    "id": 16707044,
    "chapter_id": 6107,
    "verse_number": "1.44",
    "content_sanskrit": "सर्वे वेदा यत्पदमामनन्ति तपांसि सर्वाणि च यद्वदन्ति ।\nयदिच्छन्तो ब्रह्मचर्यं चरन्ति तत्ते पदं सङ्ग्रहेण ब्रवीम्योमित्येतत् ॥ १५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "base_unit_id": "Ka_C01_S02_V15"
  },
  {
    "id": 16707045,
    "chapter_id": 6107,
    "verse_number": "1.45",
    "content_sanskrit": "एतद्ध्येवाक्षरं ब्रह्म एतद्ध्येवाक्षरं परम् ।\nएतद्ध्येवाक्षरं ज्ञात्वा यो यदिच्छति तस्य तत् ॥ १६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "base_unit_id": "Ka_C01_S02_V16"
  },
  {
    "id": 16707046,
    "chapter_id": 6107,
    "verse_number": "1.46",
    "content_sanskrit": "एतदालम्बनं श्रेष्ठमेतदालम्बनं परम् ।\nएतदालम्बनं ज्ञात्वा ब्रह्मलोके महीयते ॥ १७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "base_unit_id": "Ka_C01_S02_V17"
  },
  {
    "id": 16707047,
    "chapter_id": 6107,
    "verse_number": "1.47",
    "content_sanskrit": "न जायते म्रियते वा विपश्चिन्नायं कुतश्चिन्न बभूव कश्चित् ।\nअजो नित्यः शाश्वतोऽयं पुराणो न हन्यते हन्यमाने शरीरे ॥ १८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "base_unit_id": "Ka_C01_S02_V18"
  },
  {
    "id": 16707048,
    "chapter_id": 6107,
    "verse_number": "1.48",
    "content_sanskrit": "हन्ता चेन्मन्यते हन्तुं हतश्चेन्मन्यते हतम् ।\nउभौ तौ न विजानीतो नायं हन्ति न हन्यते ॥ १९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "base_unit_id": "Ka_C01_S02_V19"
  },
  {
    "id": 16707049,
    "chapter_id": 6107,
    "verse_number": "1.49",
    "content_sanskrit": "अणोरणीयान्महतो महीयानात्मास्य जन्तोर्निहितो गुहायाम् ।\nतमक्रतुः पश्यति वीतशोको धातुप्रसादान्महिमानमात्मनः ॥ २० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "base_unit_id": "Ka_C01_S02_V20"
  },
  {
    "id": 16707050,
    "chapter_id": 6107,
    "verse_number": "1.50",
    "content_sanskrit": "आसीनो दूरं व्रजति शयानो याति सर्वतः ।\nकस्तं मदामदं देवं मदन्यो ज्ञातुमर्हति ॥ २१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "base_unit_id": "Ka_C01_S02_V21"
  },
  {
    "id": 16707051,
    "chapter_id": 6107,
    "verse_number": "1.51",
    "content_sanskrit": "अशरीरं शरीरेषु अनवस्थेष्ववस्थितम् ।\nमहान्तं विभुमात्मानं मत्वा धीरो न शोचति ॥ २२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "base_unit_id": "Ka_C01_S02_V22"
  },
  {
    "id": 16707052,
    "chapter_id": 6107,
    "verse_number": "1.52",
    "content_sanskrit": "नायमात्मा प्रवचनेन लभ्यो न मेधया न बहुना श्रुतेन ।\nयमेवैष वृणुते तेन लभ्यस्तस्यैष आत्मा विवृणुते तनूंस्वाम् ॥ २३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "base_unit_id": "Ka_C01_S02_V23"
  },
  {
    "id": 16707053,
    "chapter_id": 6107,
    "verse_number": "1.53",
    "content_sanskrit": "नाविरतो दुश्चरितान्नाशान्तो नासमाहितः ।\nनाशान्तमानसो वापि प्रज्ञानेनैनमाप्नुयात् ॥ २४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "base_unit_id": "Ka_C01_S02_V24"
  },
  {
    "id": 16707054,
    "chapter_id": 6107,
    "verse_number": "1.54",
    "content_sanskrit": "यस्य ब्रह्म च क्षत्रं च उभे भवत ओदनः ।\nमृत्युर्यस्योपसेचनं क इत्था वेद यत्र सः ॥ २५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "base_unit_id": "Ka_C01_S02_V25"
  },
  {
    "id": 16707055,
    "chapter_id": 6107,
    "verse_number": "1.55",
    "content_sanskrit": "ऋतं पिबन्तौ सुकृतस्य लोके गुहां प्रविष्टौ परमे परार्धे ।\nछायातपौ ब्रह्मविदो वदन्ति पञ्चाग्नयो ये च त्रिणाचिकेताः ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "base_unit_id": "Ka_C01_S03_V01"
  },
  {
    "id": 16707056,
    "chapter_id": 6107,
    "verse_number": "1.56",
    "content_sanskrit": "यः सेतुरीजानानामक्षरं ब्रह्म यत्परम् ।\nअभयं तितीर्षतां पारं नाचिकेतं शकेमहि ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "base_unit_id": "Ka_C01_S03_V02"
  },
  {
    "id": 16707057,
    "chapter_id": 6107,
    "verse_number": "1.57",
    "content_sanskrit": "आत्मानं रथिनं विद्धि शरीरं रथमेव तु ।\nबुद्धिं तु सारथिं विद्धि मनः प्रग्रहमेव च ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "base_unit_id": "Ka_C01_S03_V03"
  },
  {
    "id": 16707058,
    "chapter_id": 6107,
    "verse_number": "1.58",
    "content_sanskrit": "इन्द्रियाणि हयानाहुर्विषयांस्तेषु गोचरान् ।\nआत्मेन्द्रियमनोयुक्तं भोक्तेत्याहुर्मनीषिणः ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "base_unit_id": "Ka_C01_S03_V04"
  },
  {
    "id": 16707059,
    "chapter_id": 6107,
    "verse_number": "1.59",
    "content_sanskrit": "यस्त्वविज्ञानवान्भवत्ययुक्तेन मनसा सदा ।\nतस्येन्द्रियाण्यवश्यानि दुष्टाश्वा इव सारथेः ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "base_unit_id": "Ka_C01_S03_V05"
  },
  {
    "id": 16707060,
    "chapter_id": 6107,
    "verse_number": "1.60",
    "content_sanskrit": "यस्तु विज्ञानवान्भवति युक्तेन मनसा सदा ।\nतस्येन्द्रियाणि वश्यानि सदश्वा इव सारथेः ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "base_unit_id": "Ka_C01_S03_V06"
  },
  {
    "id": 16707061,
    "chapter_id": 6107,
    "verse_number": "1.61",
    "content_sanskrit": "यस्त्वविज्ञानवान्भवत्यमनस्कः सदाशुचिः ।\nन स तत्पदमाप्नोति संसारं चाधिगच्छति ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "base_unit_id": "Ka_C01_S03_V07"
  },
  {
    "id": 16707062,
    "chapter_id": 6107,
    "verse_number": "1.62",
    "content_sanskrit": "यस्तु विज्ञानवान्भवति समनस्कः सदा शुचिः ।\nस तु तत्पदमाप्नोति यस्माद्भूयो न जायते ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "base_unit_id": "Ka_C01_S03_V08"
  },
  {
    "id": 16707063,
    "chapter_id": 6107,
    "verse_number": "1.63",
    "content_sanskrit": "विज्ञानसारथिर्यस्तु मनःप्रग्रहवान्नरः ।\nसोऽध्वनः पारमाप्नोति तद्विष्णोः परमं पदम् ॥ ९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "base_unit_id": "Ka_C01_S03_V09"
  },
  {
    "id": 16707064,
    "chapter_id": 6107,
    "verse_number": "1.64",
    "content_sanskrit": "इन्द्रियेभ्यः परा ह्यर्था अर्थेभ्यश्च परं मनः ।\nमनसस्तु परा बुद्धिर्बुद्धेरात्मा महान्परः ॥ १० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "base_unit_id": "Ka_C01_S03_V10"
  },
  {
    "id": 16707065,
    "chapter_id": 6107,
    "verse_number": "1.65",
    "content_sanskrit": "महतः परमव्यक्तमव्यक्तात्पुरुषः परः ।\nपुरुषान्न परं किञ्चित्सा काष्ठा सा परा गतिः ॥ ११ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "base_unit_id": "Ka_C01_S03_V11"
  },
  {
    "id": 16707066,
    "chapter_id": 6107,
    "verse_number": "1.66",
    "content_sanskrit": "एष सर्वेषु भूतेषु गूढोऽत्मा न प्रकाशते ।\nदृश्यते त्वग्न्यया बुद्ध्या सूक्ष्मया सूक्ष्मदर्शिभिः ॥ १२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "base_unit_id": "Ka_C01_S03_V12"
  },
  {
    "id": 16707067,
    "chapter_id": 6107,
    "verse_number": "1.67",
    "content_sanskrit": "यच्छेद्वाङ्मनसी प्राज्ञस्तद्यच्छेज्ज्ञान आत्मनि ।\nज्ञानमात्मनि महति नियच्छेत्तद्यच्छेच्छान्त आत्मनि ॥ १३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "base_unit_id": "Ka_C01_S03_V13"
  },
  {
    "id": 16707068,
    "chapter_id": 6107,
    "verse_number": "1.68",
    "content_sanskrit": "उत्तिष्ठत जाग्रत प्राप्य वरान्निबोधत ।\nक्षुरस्य धारा निशिता दुरत्यया दुर्गं पथस्तत्कवयो वदन्ति ॥ १४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "base_unit_id": "Ka_C01_S03_V14"
  },
  {
    "id": 16707069,
    "chapter_id": 6107,
    "verse_number": "1.69",
    "content_sanskrit": "अशब्दमस्पर्शमरूपमव्ययं तथारसं नित्यमगन्धवच्च यत् ।\nअनाद्यनन्तं महतः परं ध्रुवं निचाय्य तं मृत्युमुखात्प्रमुच्यते ॥ १५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "base_unit_id": "Ka_C01_S03_V15"
  },
  {
    "id": 16707070,
    "chapter_id": 6107,
    "verse_number": "1.70",
    "content_sanskrit": "नाचिकेतमुपाख्यानं मृत्युप्रोक्तं सनातनम् ।\nउक्त्वा श्रुत्वा च मेधावी ब्रह्मलोके महीयते ॥ १६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70,
    "base_unit_id": "Ka_C01_S03_V16"
  },
  {
    "id": 16707071,
    "chapter_id": 6107,
    "verse_number": "1.71",
    "content_sanskrit": "य इमं परमं गुह्यं श्रावयेद्ब्रह्मसंसदि । प्रयतः श्राद्धकाले वा तदानन्त्याय कल्पते ॥\nतदानन्त्याय कल्पत इति ॥ १७ ॥",
