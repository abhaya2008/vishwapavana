[{"id": 2128139, "chapter_id": 3745, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2128140, "chapter_id": 3745, "verse_number": "१", "content_sanskrit": "धनञ्जयेन चाप्युक्तं यत् तच्छृणु युधिष्ठिर ।\nभ्रातरं मे योजयेस्त्वं तीर्थपुण्येन पाण्डवम् ।\nभ्रातरं मेऽनुजैः सार्धं योजयेर्धर्म्यया धिया\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2128141, "chapter_id": 3745, "verse_number": "२", "content_sanskrit": "त्वं हि धर्मान् परान् वेत्थ तपांसि च तपोधन ।\nश्रीमतां चापि जानासि धर्मं राज्ञां सनातनम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2128142, "chapter_id": 3745, "verse_number": "३", "content_sanskrit": "स भवान् यत् परं वेद पावनं पुरुषान् प्रति ।\nतेन संयोजयेथास्त्वं तीर्थपुण्येन पाण्डवम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2128143, "chapter_id": 3745, "verse_number": "४", "content_sanskrit": "यथा तीर्थानि गच्छेत गाश्च दद्यात् स पार्थिवः ।\nतथा सर्वात्मना कार्यमिति मां विजयोऽब्रवीत् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2128144, "chapter_id": 3745, "verse_number": "५", "content_sanskrit": "भवता चानुगुप्तोऽसौ चरेत् तीर्थानि सर्वशः ।\nरक्षोभ्यो रक्षितव्यश्च दुर्गेषु विषमेषु च \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2128145, "chapter_id": 3745, "verse_number": "६", "content_sanskrit": "दधीचिरिव देवेन्द्रं यथा चाप्यङ्गिरा रविम् ।\nतथा रक्षस्व कौन्तेयं राक्षसेभ्यो द्विजोत्तम \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2128146, "chapter_id": 3745, "verse_number": "७", "content_sanskrit": "यातुधाना हि बहवो राक्षसाः पर्वतोपमाः ।\nत्वया हि गुप्तान् कौन्तेयान् नातिवर्तेयुरन्तिकात्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2128147, "chapter_id": 3745, "verse_number": "८", "content_sanskrit": "सोऽहमिन्द्रस्य वचनान्नियोगादर्जुनस्य च ।\nरक्षमाणो भयेभ्यस्त्वां चरिष्यामि त्वया सह\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2128148, "chapter_id": 3745, "verse_number": "९", "content_sanskrit": "द्विस्तीर्थानि मया पूर्वं दृष्टानि कुरुनन्दन ।\nइदं तृतीयं द्रक्ष्यामि तान्येव भवता सह \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2128149, "chapter_id": 3745, "verse_number": "१०", "content_sanskrit": "इयं राजर्षिभिर्याता पुण्यकृद्भिर्युधिष्ठिर ।\nमन्वादिभिर्महाराज तीर्थयात्रा शुभावहा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2128150, "chapter_id": 3745, "verse_number": "११", "content_sanskrit": "नानृजुर्नाकृतात्मा च नावैद्यो न च पापकृत् ।\nस्नाति तीर्थेषु कौरव्य न च वक्रमतिर्नरः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2128151, "chapter_id": 3745, "verse_number": "१२", "content_sanskrit": "त्वं तु धर्मरतिर्नित्यं धर्मज्ञः सत्यसङ्गरः ।\nविमुक्तः सर्वपापेभ्यो भूय एव भविष्यसि\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2128152, "chapter_id": 3745, "verse_number": "१३", "content_sanskrit": "यथा भगीरथो राजा राजानश्च गयादयः ।\nयथा ययातिः कौन्तेय तथा त्वमपि पाण्डव\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2128153, "chapter_id": 3745, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2128154, "chapter_id": 3745, "verse_number": "१४", "content_sanskrit": "न हर्षात् सम्प्रपश्यामि वाक्यस्यास्योत्तरं मुने ।\nस्मरेद्धि देवराजो यं किं नामाभ्यधिकं ततः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2128155, "chapter_id": 3745, "verse_number": "१५", "content_sanskrit": "भवता सङ्गमो यस्य भ्राता चैव धनञ्जयः ।\nवासवः स्मरते यस्य को नामाभ्यधिकस्ततः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2128156, "chapter_id": 3745, "verse_number": "१६", "content_sanskrit": "यच्च मां भगवानाह तीर्थानां दर्शनं प्रति ।\nधौम्यस्य वचनादेषा बुद्धिः पूर्वं कृतैव मे \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2128157, "chapter_id": 3745, "verse_number": "१७", "content_sanskrit": "तद्यदा मन्यसे दृष्ट्वा गमने तीर्थदर्शने ।\nतदैव गन्तास्मि दृढमेष मे निश्चयः परः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2128158, "chapter_id": 3745, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2128159, "chapter_id": 3745, "verse_number": "१८", "content_sanskrit": "गमने कृतबुद्धिं तं पाण्डवं लोमशोऽब्रवीत् ।\nलघुर्भव महाराज ततः स्वैरं गमिष्यसि\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2128160, "chapter_id": 3745, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2128161, "chapter_id": 3745, "verse_number": "१९", "content_sanskrit": "भिक्षाभुजो निवर्तन्तां ब्राह्मणा यतयश्च ये ।\nये चाप्यनुगताः पौरा राजभक्तिपुरस्कृताः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2128162, "chapter_id": 3745, "verse_number": "२०", "content_sanskrit": "धृतराष्ट्रं महाराजमभिगच्छन्तु चैव ते ।\nस दास्यति यथाकालमुचिता यस्य या भृतिः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2128163, "chapter_id": 3745, "verse_number": "२१", "content_sanskrit": "स चेद् यथोचितां वृत्तिं न दद्यान्मनुजेश्वरः ।\nअस्मत्प्रियहितार्थाय पाञ्चालो वः प्रदास्यति\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2128164, "chapter_id": 3745, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2128165, "chapter_id": 3745, "verse_number": "२२", "content_sanskrit": "ततो भूयिष्ठशः पौरा गुरुभारसमाहिताः ।\nविप्राश्च यतयो युक्ता जग्मुर्नागपुरं प्रति\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2128166, "chapter_id": 3745, "verse_number": "२३", "content_sanskrit": "तान् सर्वान् धर्मराजस्य प्रेम्णा राजाऽम्बिकासुतः ।\nप्रतिजग्राह विधिवद् धनैश्च समतर्पयत्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2128167, "chapter_id": 3745, "verse_number": "२४", "content_sanskrit": "ततः कुन्तीसुतो राजा लघुभिर्ब्राह्मणैः सह ।\nलोमशेन च सुप्रीतः त्रिरात्रं काम्यकेऽवसत्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2128168, "chapter_id": 3745, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nवनपर्वणि सप्ताशीतितमोऽध्यायः ॥८७॥\n॥ तीर्थयात्रापर्वणि त्रिचत्वारिंशोऽध्यायः ॥४३॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]