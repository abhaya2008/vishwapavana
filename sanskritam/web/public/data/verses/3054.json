[{"id": 2096137, "chapter_id": 3054, "verse_number": "१३-१८४-१", "content_sanskrit": "भीष्म उवाच।\nएवमुक्तः स भगवान्मैत्रेयं प्रत्यभाषत।\nदिष्ट्यैतत्त्वं विजानासि दिष्ट्या ते बुद्धिरीदृशी?", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2096138, "chapter_id": 3054, "verse_number": "१३-१८४-२", "content_sanskrit": "लोको ह्ययं गुणानेव भूयिष्ठं सम्प्रशंसति।\nरूपमानो वयोमानो धनविद्यामदस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2096139, "chapter_id": 3054, "verse_number": "१३-१८४-३", "content_sanskrit": "दिष्ट्या नाभिभवन्ति त्वां दैवस्तेऽयमनुग्रहः।\nतत्ते बहुगुणं दानं वर्तयिष्यामि तच्छृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2096140, "chapter_id": 3054, "verse_number": "१३-१८४-४", "content_sanskrit": "यानीहागमशास्त्राणि याश्च काश्चित्प्रिवृत्तयः।\nतानि वेदं पुरस्कृत्य प्रवृत्तानि यथाक्रमम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2096141, "chapter_id": 3054, "verse_number": "१३-१८४-५", "content_sanskrit": "अहं दानं प्रशंसामि भवानपि तपःश्रुतेः।\nतपः पवित्रं वेदस्य तपः स्वर्गस्य साधनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2096142, "chapter_id": 3054, "verse_number": "१३-१८४-६", "content_sanskrit": "तपसा महदाप्नोति विद्यया चेति नः श्रुतम्।\nतपसैव चापनुदेद्यच्चान्यदपि दुष्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2096143, "chapter_id": 3054, "verse_number": "१३-१८४-७", "content_sanskrit": "यद्यद्धि किञ्चित्सन्धाय पुरुषस्तप्यते तपः।\nसर्वमेतदवाप्नोति ब्राह्मणो वेदपारगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2096144, "chapter_id": 3054, "verse_number": "१३-१८४-८", "content_sanskrit": "दुरन्वयं दुष्प्रधर्षं दुरापं दुरतिक्रमम्।\nसर्वं वै तपसाऽभ्योति तपो हि बलवत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2096145, "chapter_id": 3054, "verse_number": "१३-१८४-९", "content_sanskrit": "सुरापः स्वर्णहारी च भ्रूणहा गुरुतल्पगः।\nतपसा तरते सर्वमेनसश्च प्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2096146, "chapter_id": 3054, "verse_number": "१३-१८४-१०", "content_sanskrit": "सर्वो वैद्यस्तु चक्षुष्मानपि यादृशतादृशः।\nतपस्विनं तथैवाहुस्ताभ्यां कार्यं सतां मतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2096147, "chapter_id": 3054, "verse_number": "१३-१८४-११", "content_sanskrit": "सर्वे पूज्याः श्रुतधनास्तथैव च तपस्विनः।\nदानप्रदाः सुखं प्रेत्य प्राप्नुवन्तीह च श्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2096148, "chapter_id": 3054, "verse_number": "१३-१८४-१२", "content_sanskrit": "इमं च ब्रह्मलोकं च लोकं च बलवत्तरम्।\nअन्नदानैः सुकृतिनः प्रतिपद्यन्ति लौकिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2096149, "chapter_id": 3054, "verse_number": "१३-१८४-१३", "content_sanskrit": "पूजिताः पूजयन्त्येते मानिता मानयन्ति च।\nस दाता यत्र यत्रैति सर्वतः सम्प्रणूयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2096150, "chapter_id": 3054, "verse_number": "१३-१८४-१४", "content_sanskrit": "अकर्ता चैव कर्ता च लभते यस्य यादृशम्।\nयदि चोर्ध्वं यद्यधो वा स्वान्लोकानभियास्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2096151, "chapter_id": 3054, "verse_number": "१३-१८४-१५", "content_sanskrit": "प्राप्स्यसि त्वन्नपानानि यानि दास्यसि कर्हिचित्।\nमेधाव्यसि कुले जातः श्रुतवाननृशंसवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2096152, "chapter_id": 3054, "verse_number": "१३-१८४-१६", "content_sanskrit": "कौमारदारो व्रतवान्मैत्रेय निरतो भव।\n[एतद्गृहाण प्रथमं प्रशस्तं गृहमेधिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2096153, "chapter_id": 3054, "verse_number": "१३-१८४-१७", "content_sanskrit": "यो भर्ता वासितातुष्टो भर्तुस्तुष्टा च वासिता।\nयस्मिन्नेवं कुले सर्वं कल्याणं तत्र वर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2096154, "chapter_id": 3054, "verse_number": "१३-१८४-१८", "content_sanskrit": "अद्भिर्गात्रान्मलमिव तमोऽग्निप्रभया यथा।]\nदानेन तपसा चैव विष्णोरभ्यर्चनेन च।\n`ब्राह्मणः स महाभाग तरेत्संसारसागरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2096155, "chapter_id": 3054, "verse_number": "१३-१८४-१९", "content_sanskrit": "स्वकर्मशुद्धसत्त्वानां तपोभिर्निर्मलात्मनाम्।\nविद्यया गतमोहानां तारणाय हरिः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2096156, "chapter_id": 3054, "verse_number": "१३-१८४-२०", "content_sanskrit": "तदर्चनपरो नित्यं तद्भक्तस्तं नमस्कुरु।\nतद्भक्ता न विनश्यन्ति ह्यष्टाक्षरपरायणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2096157, "chapter_id": 3054, "verse_number": "१३-१८४-२१", "content_sanskrit": "प्रणवोपासनपराः परमार्थिपरास्त्विह।\nएतैः पावय चात्मानं सर्वपापमपोह्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2096158, "chapter_id": 3054, "verse_number": "१३-१८४-२२", "content_sanskrit": "स्वस्ति प्राप्नुहि मैत्रेय गृहान्साधु व्रजाम्यहम्।\nएतन्मनसि कर्तव्यं श्रेय एवं भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2096159, "chapter_id": 3054, "verse_number": "१३-१८४-२३", "content_sanskrit": "तं प्रणम्याथ मैत्रेयः कृत्वा चापि प्रदक्षिणम्।\nस्वस्ति प्राप्नोतु भगवानित्युवाच कृताञ्जलिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2096160, "chapter_id": 3054, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि चतुरशीत्यधिकशततमोऽध्यायः॥ १८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]