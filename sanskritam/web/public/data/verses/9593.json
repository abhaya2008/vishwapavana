[{"id": 5000593000, "chapter_id": 9593, "verse_number": "७-५८-१", "content_sanskrit": "एवं ब्रुवति रामे तु लक्ष्मणः परवीरहा ।\nप्रत्युवाच महात्मानं ज्वलन्तमिव तेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000593001, "chapter_id": 9593, "verse_number": "७-५८-२", "content_sanskrit": "महदद्भुतमाश्चर्यं विदेहस्य पुरातनम् ।\nनिर्वृत्तं राजशार्दूल वसिष्ठस्य निमेस्सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000593002, "chapter_id": 9593, "verse_number": "७-५८-३", "content_sanskrit": "निमिस्तु क्षत्रियः शूरो विशेषेण च दीक्षितः ।\nन क्षमां कृतवान्राजा वसिष्ठस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000593003, "chapter_id": 9593, "verse_number": "७-५८-४", "content_sanskrit": "एवमुक्तस्तु तेनायं श्रीमान् क्षत्रियपुङ्गवः ।\nउवाच लक्ष्मणं वाक्यं सर्वशास्त्रविशारदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000593004, "chapter_id": 9593, "verse_number": "७-५८-५", "content_sanskrit": "रामो रमयतां श्रेष्ठो भ्रातरं दीप्ततेजसम् ।\nन सर्वत्र क्षमा वीर पुरुषेषु प्रदृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000593005, "chapter_id": 9593, "verse_number": "७-५८-६", "content_sanskrit": "सौमित्रे दुःसहो रोषो यथा क्षान्तो ययातिना ।\nसत्त्वानुगं पुरस्कृत्य तन्निबोध समाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000593006, "chapter_id": 9593, "verse_number": "७-५८-७", "content_sanskrit": "नहुषस्य सुतो राजा ययातिः पौरवर्धनः ।\nतस्य भार्याद्वयं सौम्य रूपेणाप्रतिमं भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000593007, "chapter_id": 9593, "verse_number": "७-५८-८", "content_sanskrit": "एका तु तस्य राजर्षेर्नाहुषस्य पुरस्कृता ।\nशर्मिष्ठा नाम दैतेयी दुहिता वृषपर्वणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000593008, "chapter_id": 9593, "verse_number": "७-५८-९", "content_sanskrit": "अन्या तूशनसः पत्नी ययातेः पुरुषर्षभ ।\nन तु सा दयिता राज्ञो देवयानी सुमध्यमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000593009, "chapter_id": 9593, "verse_number": "७-५८-१०", "content_sanskrit": "तयोः पुत्रौ तु सम्भूतौ रूपवन्तौ समाहितौ ।\nशर्मिष्ठा ऽजनयत्पूरुं देवयानी यदुं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000593010, "chapter_id": 9593, "verse_number": "७-५८-११", "content_sanskrit": "पूरुस्तु दयितो राज्ञो गुणैर्मातृकृतेन च ।\nततो दुःखसमाविष्टो यदुर्मातरमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000593011, "chapter_id": 9593, "verse_number": "७-५८-१२", "content_sanskrit": "भार्गवस्य कुले जाता देवस्याक्लिष्टकर्मणः ।\nसहसे हृद्गतं दुःखमवमानं च दुःसहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000593012, "chapter_id": 9593, "verse_number": "७-५८-१३", "content_sanskrit": "आवां च सहितौ देवि प्रविशाव हुताशनम् ।\nराजा तु रमतां सार्धं दैत्यपुत्र्या बहुक्षपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000593013, "chapter_id": 9593, "verse_number": "७-५८-१४", "content_sanskrit": "यदि वा सहनीयं ते मामनुज्ञातुमर्हसि ।\nक्षम त्वं न क्षमिष्ये ऽहं मरिष्यामि न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000593014, "chapter_id": 9593, "verse_number": "७-५८-१५", "content_sanskrit": "पुत्रस्य भाषितं श्रुत्वा परमार्तस्य रोदतः ।\nदेवयानी तु सङ्क्रुद्धा सस्मार पितरं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000593015, "chapter_id": 9593, "verse_number": "७-५८-१६", "content_sanskrit": "इङ्गितं तदभिज्ञाय दुहितुर्भार्गवस्तदा ।\nआगतस्त्वरितं तत्र देवयानी तु यत्र सा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000593016, "chapter_id": 9593, "verse_number": "७-५८-१७", "content_sanskrit": "दृष्ट्वा चाप्रकृतिस्थां तामप्रहृष्टामचेतनाम् ।\nपिता दुहितरं वाक्यं किमेतदिति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000593017, "chapter_id": 9593, "verse_number": "७-५८-१८", "content_sanskrit": "पृच्छन्तमसकृत्तं वै भार्गवं दीप्ततेजसम् ।\nदेवयानी तु सङ्क्रुद्धा पितरं वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000593018, "chapter_id": 9593, "verse_number": "७-५८-१९", "content_sanskrit": "अहमग्निं विषं तीक्ष्णमपो वा मुनिसत्तम ।\nभक्षयिष्ये प्रवेक्ष्यामि न तु शक्ष्यामि जीवितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000593019, "chapter_id": 9593, "verse_number": "७-५८-२०", "content_sanskrit": "न मां त्वमवजानीषे दुःखितामवमानिताम् ।\nवृक्षस्यावज्ञया ब्रह्मंश्छिद्यन्ते वृक्षजीविनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000593020, "chapter_id": 9593, "verse_number": "७-५८-२१", "content_sanskrit": "अवज्ञया च राजर्षिः परिभूय च भार्गव ।\nमय्यवज्ञां प्रयुङ्क्ते हि न च मां बहु मन्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000593021, "chapter_id": 9593, "verse_number": "७-५८-२२", "content_sanskrit": "तस्यास्तद्वचनं श्रुत्वा कोपेनाभिपरिप्लुतः ।\nव्याहर्तुमुपचक्राम भार्गवो नहुषात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000593022, "chapter_id": 9593, "verse_number": "७-५८-२३", "content_sanskrit": "यस्मान्मामवजानीषे नाहुष त्वं दुरात्मवान् ।\nजरया परया जीर्णः शैथिल्यमुपयास्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000593023, "chapter_id": 9593, "verse_number": "७-५८-२४", "content_sanskrit": "एवमुक्त्वा दुहितरं समाश्वास्य च भार्गवः ।\nपुनर्जगाम ब्रह्मर्षिर्भवनं स्वं महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000593024, "chapter_id": 9593, "verse_number": "७-५८-२५", "content_sanskrit": "स एवमुक्त्वा द्विजपुङ्गवाग्र्यः सुतां समाश्वास्य च देवयानीम् ।\nपुनर्ययौ सूर्यसमानतेजा दत्त्वा च शापं नहुषात्मजाय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000593025, "chapter_id": 9593, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे ऽष्टपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]