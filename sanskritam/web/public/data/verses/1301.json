[{"id": 2014567, "chapter_id": 1301, "verse_number": "२-४२-१", "content_sanskrit": "वैशम्पायन उवाच॥\nगाङ्गेयेनैवमुक्तस्तु शिशुपालश्चुकोप तम्।\nक्रुद्धं सुनीथं दृष्ट्वाऽथ सहदेवोऽब्रवीत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2014568, "chapter_id": 1301, "verse_number": "२-४२-२", "content_sanskrit": "मतिपूर्वमिदं सर्वं चेदिराज मया कृतम्।\nतन्मे निगदतस्तत्त्वं कारणादत्र मे शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2014569, "chapter_id": 1301, "verse_number": "२-४२-३", "content_sanskrit": "स पार्थिवानां सर्वेषां गुरुः कृष्णोऽपरो न हि।\nतस्मादभ्यर्चितोऽस्माभिः सर्वे संमन्तुमर्हथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2014570, "chapter_id": 1301, "verse_number": "२-४२-४", "content_sanskrit": "यो वा सहते कश्चिद्राज्ञां सबलवाहनः।\nक्षिप्रं युद्धाय निर्यातु तस्य मूर्ध्न्याहितं पदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2014571, "chapter_id": 1301, "verse_number": "२-४२-५", "content_sanskrit": "एवमुक्तो मया हेतुरुत्तरं प्रब्रवीतु मे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2014572, "chapter_id": 1301, "verse_number": "२-४२-५x", "content_sanskrit": "वैशम्पायन उवाच॥\nततो न व्याजहारैषां कश्चिद्बुद्धिमतां सताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2014573, "chapter_id": 1301, "verse_number": "२-४२-६", "content_sanskrit": "मानिनां बलिनां राज्ञां मध्ये सन्दर्शिते पदे।\nएवमुक्ते सुनीथस्य सहदेवेन केशवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2014574, "chapter_id": 1301, "verse_number": "२-४२-७", "content_sanskrit": "स्वभावरक्ते नयने कोपाद्रक्ततरे कृते।\nतस्य कोपं समुद्भूतं ज्ञात्वा भीष्मः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2014575, "chapter_id": 1301, "verse_number": "२-४२-८", "content_sanskrit": "आचचक्षे पुनस्तस्मै कृष्णस्यैवोत्तरान्गुणान्।\nस सुनीथं समामन्त्र्य तांश्च सर्वान्महीक्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2014576, "chapter_id": 1301, "verse_number": "२-४२-९", "content_sanskrit": "उवाच वदतां श्रेष्ठं इदं मतिमतां वरः।\nसहदेवेन राजानो यदुक्तं केशवं प्रति।\nतत्तथेति विजानीध्वं भूयश्चात्र विबोधत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2014577, "chapter_id": 1301, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि अर्घाहरणपर्वणि द्विचत्वारिंशोऽध्यायः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]