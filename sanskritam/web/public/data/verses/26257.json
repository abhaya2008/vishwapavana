[{"id": 7006257000, "chapter_id": 26257, "verse_number": "३-११-१", "content_sanskrit": "अगस्त्य उवाच कथं भण्डासुरो जातः कथं वा त्रिपुरांबिका ।\nकथं बभञ्ज तं संख्ये तत्सर्वं वद विस्तरात् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006257001, "chapter_id": 26257, "verse_number": "३-११-२", "content_sanskrit": "हयग्रीव उवाच पुरा दाक्षायणीं त्यक्त्वा पितुर्यज्ञविनाशनम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006257002, "chapter_id": 26257, "verse_number": "३-११-३", "content_sanskrit": "आत्मानमात्मना पश्यञ्ज्ञानानन्दरसात्मकः ।\nउपास्यमानो मुनिभिरद्वन्द्वगुणलक्षणः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006257003, "chapter_id": 26257, "verse_number": "३-११-४", "content_sanskrit": "गङ्गाकूले हिमवतः पर्यन्ते प्रविवेश ह ।\nसापि शङ्करमा राध्य चिरकालं मनस्विनी ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006257004, "chapter_id": 26257, "verse_number": "३-११-५", "content_sanskrit": "योगेन स्वां तनुं त्यक्त्वा सुतासीद्धिमभूभृतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006257005, "chapter_id": 26257, "verse_number": "३-११-६", "content_sanskrit": "स शैलो नारदाच्छ्रुत्वा रुद्राणीति स्वकन्याकाम् ।\nतस्य शुश्रूषणार्थाय स्थापयामास चान्तिके ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006257006, "chapter_id": 26257, "verse_number": "३-११-७", "content_sanskrit": "एतस्मिन्नन्तरे देवास्तारकेण हि पीडिताः ।\nब्रह्मणोक्ताः समाहूय मदनं चेदमब्रुवन् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006257007, "chapter_id": 26257, "verse_number": "३-११-८", "content_sanskrit": "सर्गादौ भगवान्ब्रह्म सृजमानोऽखिलाः प्रजाः ।\nन निर्वृतिरभूत्तस्य कदाचिदपि मानसे ।\nतपश्चचार सुचिरं मनोवाक्कायकर्मभिः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006257008, "chapter_id": 26257, "verse_number": "३-११-९", "content_sanskrit": "ततः प्रसन्नो भगवान्सलक्ष्मीको जनार्दनः ।\nवरेण च्छन्दयामास वरदः सर्वदेहिनाम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006257009, "chapter_id": 26257, "verse_number": "३-११-१०", "content_sanskrit": "ब्रह्मोवाच ।\nयदि तुष्टोऽसि भगवन्ननायासेन वै जगत् ।\nचराचरयुतं चैतत्सृजामि त्वत्प्रसादतः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006257010, "chapter_id": 26257, "verse_number": "३-११-११", "content_sanskrit": "एवमुक्तो विधात्रा तु महाल क्ष्मीमुदैक्षत ।\nतदा प्रादुरभूस्त्वं हि जगन्मोहनरूपधृक् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006257011, "chapter_id": 26257, "verse_number": "३-११-१२", "content_sanskrit": "तवायुधार्थं दत्तं च पुष्पबाणेक्षुकार्मुकम् ।\nविजयत्वमजेयत्वं प्रादा त्प्रमुदितो हरिः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006257012, "chapter_id": 26257, "verse_number": "३-११-१३", "content_sanskrit": "असौ सृजति भूतानि कारणेन स्वकर्मणा ।\nसाक्षिभूतः स्वजनतो भवान्भजतु निर्वृन्तिम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006257013, "chapter_id": 26257, "verse_number": "३-११-१४", "content_sanskrit": "एष दत्तवरो ब्रह्मा त्वयि विन्यस्य तद्भरम् ।\nमनसो निर्वृतिं प्राप्य वर्ततेऽद्यापि मन्मथ ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006257014, "chapter_id": 26257, "verse_number": "३-११-१५", "content_sanskrit": "अमोघं बलवीर्यं ते न ते मोघः पराक्रमः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006257015, "chapter_id": 26257, "verse_number": "३-११-१६", "content_sanskrit": "सुकुमाराण्यमोघानि कुसुमास्त्राणि ते सदा ।\nब्रह्मदत्तवरोऽयं हि तारको नाम दानवः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006257016, "chapter_id": 26257, "verse_number": "३-११-१७", "content_sanskrit": "बाधते सकलांल्लोकानस्मानपि विशेषतः ।\nशिवपुत्रादृतेऽन्यत्र न भयं तस्य विद्यते ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006257017, "chapter_id": 26257, "verse_number": "३-११-१८", "content_sanskrit": "त्वां विनास्मिन्महाकार्ये न कश्चित्प्रवदेदपि ।\nस्वकराच्च भवेत्कार्यं भवतो नान्यतः क्वचित् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006257018, "chapter_id": 26257, "verse_number": "३-११-१९", "content_sanskrit": "आत्म्यैक्यधयाननिरतः शिवो गौर्या समन्वितः ।\nहिमाचलतले रम्ये वर्तते मुनिभिर्वृतः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006257019, "chapter_id": 26257, "verse_number": "३-११-२०", "content_sanskrit": "तं नियोजय गौर्यां तु जनिष्यति च तत्सुतः ।\nईषत्कार्यमिदं कृत्वा त्रायस्वास्मान्महाबल ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006257020, "chapter_id": 26257, "verse_number": "३-११-२१", "content_sanskrit": "एवमभ्यर्थितो देवैः स्तूयमानो मुहुर्मुहुः ।\nजगामात्मविनाशाय यतो हिमवतस्तटम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006257021, "chapter_id": 26257, "verse_number": "३-११-२२", "content_sanskrit": "किमप्याराधयान्तं तु ध्यानसंमीलितेक्षणम् ।\nददर्शेशानमासीनं कुसुमषुरुदायुधः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006257022, "chapter_id": 26257, "verse_number": "३-११-२३", "content_sanskrit": "एतस्मिन्नन्तरे तत्र हिमवत्तनया शिवम् ।\nआरिराधयिषुश्चा गाद्बिभ्राणा रूपमद्भुतम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006257023, "chapter_id": 26257, "verse_number": "३-११-२४", "content_sanskrit": "समेत्य शम्भुं गिरिजां गन्धपुष्पोपहारकैः ।\nशुश्रूषणपरां तत्र ददर्शातिबलः स्मरः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006257024, "chapter_id": 26257, "verse_number": "३-११-२५", "content_sanskrit": "अदृश्यः सर्वभूतानान्नातिदूरेऽस्य संस्थितः ।\nसुमनोमार्गणैरग्र्यैस्स विव्याध महेश्वरम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006257025, "chapter_id": 26257, "verse_number": "३-११-२६", "content_sanskrit": "विस्मृत्य स हि कार्याणि बाणविद्धोऽन्तिके स्थिताम् ।\nगौरीं विलोकयामास मन्मथाविष्टचेतनः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006257026, "chapter_id": 26257, "verse_number": "३-११-२७", "content_sanskrit": "धृतिमालंब्य तु पुनः किमेतदिति चिन्तयन् ।\nददर्शाग्रे तु सन्नद्धं मन्मथं कुसुमायुधम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006257027, "chapter_id": 26257, "verse_number": "३-११-२८", "content_sanskrit": "तं दृष्ट्वा कुपितः शूली त्रैलोक्यदहनक्षमः ।\nतार्तीयं चक्षुरुन्मील्य ददाह मकरध्वजम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006257028, "chapter_id": 26257, "verse_number": "३-११-२९", "content_sanskrit": "शिवेनैवमवज्ञाता दुःखिता शैलकन्यका ।\nअनुज्ञया ततः पित्रोस्तपः कर्तुमगाद्वनम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006257029, "chapter_id": 26257, "verse_number": "३-११-३०", "content_sanskrit": "अथ तद्भस्म संवीक्ष्य चित्रकर्मा गणेश्वरः ।\nतद्भस्मना तु पुरुषं चित्राकारं चकार सः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006257030, "chapter_id": 26257, "verse_number": "३-११-३१", "content_sanskrit": "तं विचित्रतनुं रुद्रो ददर्शाग्रे तु पूरुषम् ।\nतत्क्षणाज्जात जीवोऽभून्मूर्तिमानिव मन्मथः ।\nमहाबलोऽतितेजस्वी मध्याह्नार्कसमप्रभः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006257031, "chapter_id": 26257, "verse_number": "३-११-३२", "content_sanskrit": "तं चित्रकर्मा बाहुभ्यां समालिङ्ग्य मुदान्वितः ।\nस्तुहि वाल महादेवं स तु सर्वार्थसिद्धिदः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006257032, "chapter_id": 26257, "verse_number": "३-११-३३", "content_sanskrit": "इत्युक्त्वा शतरुद्रीयमुपादिशदमेयधीः ।\nननाम शतशो रुद्रं शतरुद्रियमाजपन् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006257033, "chapter_id": 26257, "verse_number": "३-११-३४", "content_sanskrit": "ततः प्रसन्नो भगवान्महादेवो वृषध्वजः ।\nवरेण च्छन्दयामास वरं वव्रे स बालकः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006257034, "chapter_id": 26257, "verse_number": "३-११-३५", "content_sanskrit": "प्रतिद्वन्द्विबलार्थं तु मद्बलेनोपयोक्ष्यति ।\nतदस्त्रशस्त्रमुख्यानि वृथा कुर्वन्तु नो मम ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006257035, "chapter_id": 26257, "verse_number": "३-११-३६", "content_sanskrit": "तथेति तत्प्रतिश्रुत्य विचार्य किमपि प्रभुः ।\nषष्टिवर्षसहस्राणि राज्यमस्मै ददौ पुनः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006257036, "chapter_id": 26257, "verse_number": "३-११-३७", "content_sanskrit": "एतद्दृष्ट्वा तु चरितं धाता भण्डिति भण्डिति ।\nयदुवाच ततो नाम्ना भण्डो लोकेषु कथ्यते ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]