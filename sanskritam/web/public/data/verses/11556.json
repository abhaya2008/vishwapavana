[{"id": 50015505, "chapter_id": 11556, "verse_number": "1", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50015506, "chapter_id": 11556, "verse_number": "2", "content_sanskrit": "पूरोर्वंशं प्रवक्ष्यामि यत्र जातोऽसि भारत। यत्र राजर्षयो वंश्या ब्रह्मवंश्याश्च जज्ञिरे॥ ९/१७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50015507, "chapter_id": 11556, "verse_number": "3", "content_sanskrit": "जनमेजयोऽभवत् पूरोः प्रचिन्वांस्तत्सुतस्ततः। प्रवीरोऽथ नमस्युर्वै तस्माच्चारुपदोऽभवत्॥ ९/१७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50015508, "chapter_id": 11556, "verse_number": "4", "content_sanskrit": "तस्य सुद्युरभूत् पुत्रस्तस्माद् बहुगवस्ततः। शंयातिस्तस्य हंयाती रौद्राश्वस्तत्सुतः स्मृतः॥ ९/१७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50015509, "chapter_id": 11556, "verse_number": "5", "content_sanskrit": "ऋतेयुस्तस्य कक्षेयुः स्थण्डिलेयुः कृतेयुकः। जलेयुः सन्तनेयुश्च धर्मसत्यव्रतेयवः॥ ९/१७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50015510, "chapter_id": 11556, "verse_number": "6", "content_sanskrit": "दशैतेऽप्सरसः पुत्रा वनेयुश्चावमः स्मृतः। घृताच्यामिन्द्रियाणीव मुख्यस्य जगदात्मनः॥ ९/१७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50015511, "chapter_id": 11556, "verse_number": "7", "content_sanskrit": "ऋतेयो रन्तिनारोऽभूत् त्रयस्तस्यात्मजा नृप। सुमतिर्ध्रुवोऽप्रतिरथः कण्वोऽप्रतिरथात्मजः॥ ९/१७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50015512, "chapter_id": 11556, "verse_number": "8", "content_sanskrit": "तस्य मेधातिथिस्तस्मात् प्रस्कण्वाद्या द्विजातयः। पुत्रोऽभूत् सुमते रैभ्यो दुष्यन्तस्तत्सुतो मतः॥ ९/१७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50015513, "chapter_id": 11556, "verse_number": "9", "content_sanskrit": "दुष्यन्तो मृगयां यातः कण्वाश्रमपदं गतः। तत्रासीनां स्वप्रभया मण्डयन्तीं रमामिव॥ ९/१७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50015514, "chapter_id": 11556, "verse_number": "10", "content_sanskrit": "विलोक्य मुमुहे सद्यो देवमायामिव स्त्रियम्। बभाषे तां वरारोहां भटैः कतिपयैर्वृतः॥ ९/१७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50015515, "chapter_id": 11556, "verse_number": "11", "content_sanskrit": "तद्दर्शनप्रमुदितः सन्निवृत्तपरिश्रमः। पप्रच्छ कामसन्तप्तः प्रहसन् श्लक्ष्णया गिरा॥ ९/१७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50015516, "chapter_id": 11556, "verse_number": "12", "content_sanskrit": "का त्वं कमलगर्भाभे कस्यासि हृदयङ्गमे। किं वा चिकार्षितं त्वत्र भवत्या निर्जने वने॥ ९/१७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50015517, "chapter_id": 11556, "verse_number": "13", "content_sanskrit": "व्यक्तं राजन्यतनयां वेदम्यहं त्वां सुमध्यमे। न हि चेतः पौरवाणामधर्मे रमते क्वचित्॥ ९/१७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50015518, "chapter_id": 11556, "verse_number": "14", "content_sanskrit": "शकुन्तळोवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50015519, "chapter_id": 11556, "verse_number": "15", "content_sanskrit": "विश्वामित्रात्मजैवाहं त्यक्ता मेनकया वने। वेदैतद् भगवान् कण्वो वीर किं करवाम ते॥ ९/१७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50015520, "chapter_id": 11556, "verse_number": "16", "content_sanskrit": "आस्यतामरविन्दाक्ष गृह्यतामर्हणं च नः। भुज्यतां सन्ति नीवारा उष्यतां यदि रोचते॥ ९/१७/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50015521, "chapter_id": 11556, "verse_number": "17", "content_sanskrit": "दुष्यन्त उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50015522, "chapter_id": 11556, "verse_number": "18", "content_sanskrit": "उपपन्नमिदं सुभ्रु जातायाः कुशिकान्वये। स्वयं हि वृणुते राज्ञां कन्यकाः सदृशं वरम्॥ ९/१७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50015523, "chapter_id": 11556, "verse_number": "19", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50015524, "chapter_id": 11556, "verse_number": "20", "content_sanskrit": "ओमित्युक्ते यथाधर्ममुपयेमे शकुन्तळाम्। गान्धर्वविधिना राजा देशकालविधानवित्॥ ९/१७/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50015525, "chapter_id": 11556, "verse_number": "21", "content_sanskrit": "अमोघवीर्यो राजर्षिर्महिष्यां वीर्यमादधे। श्वोभूते स्वपुरं यातः कालेनासूत सा सुतम्॥ ९/१७/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50015526, "chapter_id": 11556, "verse_number": "22", "content_sanskrit": "कण्वः कुमारस्य वने चक्रे समुदिताः क्रियाः। बद्ध्वा मृगेन्द्रांस्तरसा क्राडति स्म स बालकः॥ ९/१७/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50015527, "chapter_id": 11556, "verse_number": "23", "content_sanskrit": "तं दुरत्ययविक्रान्तमादाय प्रमदोत्तमा। हरेरंशांशसम्भूतं भर्तुरन्तिकमागमत्॥ ९/१७/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50015528, "chapter_id": 11556, "verse_number": "24", "content_sanskrit": "यदा न जगृहे राजा भार्यापुत्रावनिन्दितौ। शृण्वतां सर्वभूतानां खे वागाहाशरीरिणी॥ ९/१७/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50015529, "chapter_id": 11556, "verse_number": "25", "content_sanskrit": "माता भस्त्रा पितुः पुत्रो यस्माज्जातः स एव सः। भरस्व पुत्रं दौष्यन्तिं मावमंस्थाः शकुन्तळाम्॥ ९/१७/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50015530, "chapter_id": 11556, "verse_number": "26", "content_sanskrit": "रेतोधाः पुत्रं नयति नरदेव यमक्षयम्। त्वं चास्य धाता गर्भस्य सत्यमाह शकुन्तळा॥ ९/१७/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50015531, "chapter_id": 11556, "verse_number": "27", "content_sanskrit": "पितर्युपरते सोऽभूच्चक्रवर्ती महायशाः। महिमा गीयते तस्य हरेरंशभुवो भुवि॥ ९/१७/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50015532, "chapter_id": 11556, "verse_number": "28", "content_sanskrit": "चक्रं दक्षिणहस्तेऽस्य पदम्कोशश्च पादयोः। ईजे महाभिषेकेण सोऽभिषिक्तोऽधिराट् प्रभुः॥ ९/१७/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50015533, "chapter_id": 11556, "verse_number": "29", "content_sanskrit": "पञ्चपञ्चाशतैर्मेध्यैर्गङ्गायामनु वाजिभिः। दीर्घतमसं पुरोधाय यमुनायामनु प्रभुः॥ ९/१७/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50015534, "chapter_id": 11556, "verse_number": "30", "content_sanskrit": "अष्टसप्तति मेध्याश्वान् बबन्ध प्रददे वसु। भरतस्य तु दौष्यन्तेरग्निः साचीगुणे चितः॥ ९/१७/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50015535, "chapter_id": 11556, "verse_number": "31", "content_sanskrit": "सहस्रं वद्वशो यस्मिन् ब्राह्मणा गा विभेजिरे। त्रयस्त्रिंशच्छतं ह्यश्वान् बद्ध्वा विस्मापयन् नृपान्। दौष्यन्तिरत्यगान्मायां देवानां पुरुमायया॥ ९/१७/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50015536, "chapter_id": 11556, "verse_number": "32", "content_sanskrit": "मृगान् शुक्ल्दतः कृष्णान् हिरण्येन परिष्कृतान्। अदात् कर्मणि मष्णारे नियुतानि चतुर्दश॥ ९/१७/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50015537, "chapter_id": 11556, "verse_number": "33", "content_sanskrit": "भरतस्य महत्कर्म न पूर्वे नापरे नृपाः। नोदायुर्नैव प्राप्स्यन्ति बाहुभ्यां त्रिदिवं यथा॥ ९/१७/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50015538, "chapter_id": 11556, "verse_number": "34", "content_sanskrit": "किरातहूणान् यवनानन्ध्रान् कङ्कान् कषान् शकान्। अब्रह्मण्यान् नृपांश्चाहन् म्लेच्छान् दिग्विजयेऽखिलान्॥ ९/१७/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50015539, "chapter_id": 11556, "verse_number": "35", "content_sanskrit": "जित्वा पुराऽसुरान् देवा येन स्वौकांसि भेजिरे। देवस्त्रियो रसां नीताः पणिभिः पुनराहरत्॥ ९/१७/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50015540, "chapter_id": 11556, "verse_number": "36", "content_sanskrit": "सर्वकामान् दुदुहतुः प्रजानां तस्य रोदसी। समास्त्रिनवसाहस्रीर्दिक्षु चक्रमवर्तयत्॥ ९/१७/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50015541, "chapter_id": 11556, "verse_number": "37", "content_sanskrit": "स सम्राट् लोकपालानामैश्वर्यमधिराट्श्रियम्। चक्रं चास्खलितं प्राणान् मृषेत्युपरराम ह॥ ९/१७/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50015542, "chapter_id": 11556, "verse_number": "38", "content_sanskrit": "तस्यासन् नृप वैदर्भ्यः पत्नयस्त्रिस्रः सुसम्मताः। जघ्नुस्त्यागभयात् पुत्रान् नानुरूपा इतीरिते॥ ९/१७/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50015543, "chapter_id": 11556, "verse_number": "39", "content_sanskrit": "तस्यैवं वितथे वंशे तदर्थं यजतः सुतम्। मरुत्स्तोमेन मरुतो भरद्वाजमुपाददुः॥ ९/१७/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50015544, "chapter_id": 11556, "verse_number": "40", "content_sanskrit": "अन्तर्वत्नया भ्रातृपत्नया मैथुनाय बृहस्पतिः। प्रवृत्तो वारितो गर्भं शप्त्वा वीर्यमवासृजत्॥ ९/१७/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50015545, "chapter_id": 11556, "verse_number": "41", "content_sanskrit": "तं त्यक्तुकामां ममतां भर्तृत्यागविशङ्किताम्। नामनिर्वचनं तस्य श्लोकमेतं जगुः सुराः॥ ९/१७/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50015546, "chapter_id": 11556, "verse_number": "42", "content_sanskrit": "मूढे भर द्वाजमिमं भरद् वाजं बृहस्पतेः। त्राता तु दुःखात् पितरौ भरद्वाजस्ततस्त्वयम्॥ ९/१७/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50015547, "chapter_id": 11556, "verse_number": "43", "content_sanskrit": "चोद्यमाना सुरैरेवं मत्वा तं देवमात्मजम्। व्यसृजन्मरुतोऽबिभ्रन् दत्तोऽयं वितथेऽन्वये॥ ९/१७/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50015548, "chapter_id": 11556, "verse_number": "44", "content_sanskrit": "इति श्रीमद्भागवते नवमस्कन्धे सप्तदशोऽध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]