[{"id": 7004454000, "chapter_id": 24454, "verse_number": "५-३-१४८-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nततो गच्छेन्महीपाल तीर्थमङ्गारकं शिवम् ।\nउत्तरे नर्मदाकूले सर्वपापक्षयंकरम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004454001, "chapter_id": 24454, "verse_number": "५-३-१४८-२", "content_sanskrit": "चतुर्थ्यङ्गारकदिने संकल्प्य कृतनिश्चयः ।\nस्नायादस्तं गते सूर्ये सन्ध्योपासनतत्परः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004454002, "chapter_id": 24454, "verse_number": "५-३-१४८-३", "content_sanskrit": "पूजयेल्लोहितं भक्त्या गन्धमाल्यविभूषणैः ।\nसंस्थाप्यस्थण्डिले देवं रक्तचन्दनचर्चितम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004454003, "chapter_id": 24454, "verse_number": "५-३-१४८-४", "content_sanskrit": "अङ्गारकायेति नमः कर्णिकायां प्रपूजयेत् ।\nकुजाय भूमिपुत्राय रक्ताङ्गाय सुवाससे॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004454004, "chapter_id": 24454, "verse_number": "५-३-१४८-५", "content_sanskrit": "हरकोपोद्भवायेति स्वेदजायातिबाहवे ।\nसर्वकामप्रदायेति पूर्वादिषु दलेषु च॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004454005, "chapter_id": 24454, "verse_number": "५-३-१४८-६", "content_sanskrit": "एवं सम्पूज्य विधिवद्दद्यादर्घ्यं विधानतः ।\nभूमिपुत्र महावीर्य स्वेदोद्भव पिनाकिनः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004454006, "chapter_id": 24454, "verse_number": "५-३-१४८-७", "content_sanskrit": "अङ्गारक महातेजा लोहिताङ्ग नमोऽस्तु ते ।\nकरकं वारिसंयुक्तं शालितंदुलपूरितम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004454007, "chapter_id": 24454, "verse_number": "५-३-१४८-८", "content_sanskrit": "सहिरण्यं सवस्त्रं च मोदकोपरि संस्थितम् ।\nब्राह्मणाय निवेद्यं तत्कुजो मे प्रीयतामिति॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004454008, "chapter_id": 24454, "verse_number": "५-३-१४८-९", "content_sanskrit": "अर्घं दत्त्वा विधानेन रक्तचन्दनवारिणा ।\nरक्तपुष्पसमाकीर्णं तिलतंदुलमिश्रितम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004454009, "chapter_id": 24454, "verse_number": "५-३-१४८-१०", "content_sanskrit": "कृत्वा ताम्रमये पात्रे मण्डले वर्तुले शुभे ।\nकृत्वा शिरसि तत्पात्रं जानुभ्यां धरणीं गतः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004454010, "chapter_id": 24454, "verse_number": "५-३-१४८-११", "content_sanskrit": "मन्त्रपूतं महाभाग दद्यादर्घ्यं विचक्षणः ।\nततो भुञ्जीत मौनेन क्षारतिलाम्लवर्जितम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004454011, "chapter_id": 24454, "verse_number": "५-३-१४८-१२", "content_sanskrit": "स्निग्धं मृदुसमधुरमात्मनः श्रेय इच्छता ।\nएवं चतुर्थे सम्प्राप्ते चतुर्थ्यङ्गारके नृप॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004454012, "chapter_id": 24454, "verse_number": "५-३-१४८-१३", "content_sanskrit": "सौवर्णं कारयेद्देवं यथाशक्ति सुरूपिणम् ।\nस्थापयेत्ताम्रके पात्रे गुडपीठसमन्विते॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004454013, "chapter_id": 24454, "verse_number": "५-३-१४८-१४", "content_sanskrit": "गन्धपुष्पादिभिर्देवं पूजयेद्गुडसंस्थितम् ।\nईशान्यां स्थापयेद्देवं गुडतोयसमन्वितम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004454014, "chapter_id": 24454, "verse_number": "५-३-१४८-१५", "content_sanskrit": "कासारेण तथाग्नेय्यां स्थापयेत्करकं परम् ।\nरक्ततन्दुलसंमिश्रं नैरृत्यां वायुगोचरे॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004454015, "chapter_id": 24454, "verse_number": "५-३-१४८-१६", "content_sanskrit": "स्थापयेन्मोदकैः सार्धं चतुर्थं करकं बुधः ।\nसूत्रेण वेष्टितग्रीवं गन्धमाल्यैरलंकृतम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004454016, "chapter_id": 24454, "verse_number": "५-३-१४८-१७", "content_sanskrit": "शङ्खतूर्यनिनादेन जयशब्दादिमङ्गलैः ।\nरक्ताम्बरधरं विप्रं रक्तमाल्यानुलेपनम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004454017, "chapter_id": 24454, "verse_number": "५-३-१४८-१८", "content_sanskrit": "वेदिमध्यगतं वापि महदासनसंस्थितम् ।\nसुरूपं सुभगं शान्तं सर्वभूतहिते रतम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004454018, "chapter_id": 24454, "verse_number": "५-३-१४८-१९", "content_sanskrit": "वेदविद्याव्रतस्नातं सर्वशास्त्रविशारदम् ।\nपूजयित्वा यथान्यायं वाचयेत्पाण्डुनन्दन॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004454019, "chapter_id": 24454, "verse_number": "५-३-१४८-२०", "content_sanskrit": "रक्तां गां च ततो दद्याद्रक्तेनानडुहा सह ।\nप्रीयतां भूमिजो देवः सर्वदैवतपूजितः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004454020, "chapter_id": 24454, "verse_number": "५-३-१४८-२१", "content_sanskrit": "विप्रं प्रदक्षिणीकृत्य पत्नीपुत्रसमन्वितः ।\nपितृमातृसुहृत्सार्द्धं क्षमाप्य च विसर्जयेत्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004454021, "chapter_id": 24454, "verse_number": "५-३-१४८-२२", "content_sanskrit": "एवं कृतस्य तस्याथ तस्मिंस्तीर्थे विशेषतः ।\nयत्पुण्यं फलमुद्दिष्टं तत्ते सर्वं वदाम्यहम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004454022, "chapter_id": 24454, "verse_number": "५-३-१४८-२३", "content_sanskrit": "सप्त जन्मानि राजेन्द्र सुरूपः सुभगो भवेत् ।\nतीर्थस्यास्य प्रभावेन नात्र कार्या विचारणा॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004454023, "chapter_id": 24454, "verse_number": "५-३-१४८-२४", "content_sanskrit": "अकामो वा सकामो वा तत्र तीर्थे मृतो नरः ।\nअङ्गारकपुरं याति देवगन्धर्वपूजितः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004454024, "chapter_id": 24454, "verse_number": "५-३-१४८-२५", "content_sanskrit": "उपभुज्य यथान्यायं दिव्यान्भोगाननुत्तमान् ।\nइह मानुष्यलोके वै राजा भवति धार्मिकः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004454025, "chapter_id": 24454, "verse_number": "५-३-१४८-२६", "content_sanskrit": "सुरूपः सुभगश्चैव सर्वव्याधिविवर्जितः ।\nजीवेद्वर्षशतं साग्रं सर्वलोकनमस्कृतः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]