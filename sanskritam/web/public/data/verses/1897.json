[{"id": 2040504, "chapter_id": 1897, "verse_number": "५-१४२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2040505, "chapter_id": 1897, "verse_number": "५-१४२-१", "content_sanskrit": "कर्णस्य वचनं श्रुत्वा केशवः परवीरहा।\nउवाच प्रहसन्वाक्यं स्मितपूर्वमिदं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2040506, "chapter_id": 1897, "verse_number": "५-१४२-२x", "content_sanskrit": "श्रीभगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2040507, "chapter_id": 1897, "verse_number": "५-१४२-२", "content_sanskrit": "अपि त्वां न लभेत्कर्ण राज्यलम्भोपपादनम् ।\nमया दत्तां हि पृथिवीं न प्रशासितुमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2040508, "chapter_id": 1897, "verse_number": "५-१४२-३", "content_sanskrit": "ध्रुवो जयः पाण्डवानामितीदं\nन संशयः कश्चन विद्यतेऽत्र।\nजयध्वजो दृश्यते पाण्डवस्य\nसमुच्छ्रितो वानरराज उग्रः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2040509, "chapter_id": 1897, "verse_number": "५-१४२-४", "content_sanskrit": "दिव्या माया विहिता भौमनेन\nसमुच्छ्रिता इन्द्रकेतुप्रकाशाः ।\nदिव्यानि भूतानि जयावहानि\nदृश्यन्ति चैवात्र भयानकानि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2040510, "chapter_id": 1897, "verse_number": "५-१४२-५", "content_sanskrit": "न सञ्जते शैलवनस्पतिभ्य\nऊर्ध्वं तिर्यग्योजनमात्ररूपः ।\nश्रीमान्ध्वजः कर्ण धनञ्जयस्य\nसमुच्छ्रितः पावकतुल्यरूपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2040511, "chapter_id": 1897, "verse_number": "५-१४२-६", "content_sanskrit": "यदा द्रक्ष्यसि सङ्ग्रामे श्वेताश्वं कृष्णसारथिम् ।\nऐन्द्रमस्त्रं विकुर्वाणमुभे चाप्यग्निमारुते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2040512, "chapter_id": 1897, "verse_number": "५-१४२-७", "content_sanskrit": "गाण्डीवस्य च निर्घोषं विस्फूर्जितमिवाशनेः।\nन तदा भविता त्रेता न कृतं द्वापरं न च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2040513, "chapter_id": 1897, "verse_number": "५-१४२-८", "content_sanskrit": "यदा द्रक्ष्यसि सङ्ग्रामे कुन्तीपुत्रं युधिष्ठिरम् ।\nजपहोमसमायुक्तं स्वां रक्षन्तं महाचमूम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2040514, "chapter_id": 1897, "verse_number": "५-१४२-९", "content_sanskrit": "आदित्यमिव दुर्धर्षं तपन्तं शत्रुवाहिनीम् ।\nन तदा भविता त्रेता न कृतं द्वापरं न च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2040515, "chapter_id": 1897, "verse_number": "५-१४२-१०", "content_sanskrit": "यदा द्रक्ष्यसि सङ्ग्रामे भीमसेनं महाबलम् ।\nदुःशासनस्य रुधिरं पीत्वा नृत्यन्तमाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2040516, "chapter_id": 1897, "verse_number": "५-१४२-११", "content_sanskrit": "प्रभिन्नमिव मातङ्गं प्रतिद्विरदघातिनम् ।\nन तदा भविता त्रेता न कृतं द्वापरं न च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2040517, "chapter_id": 1897, "verse_number": "५-१४२-१२", "content_sanskrit": "यदा द्रक्ष्यसि सङ्ग्रामे द्रोणं शान्तनवं कृपम् ।\nसुयोधनंच राजानं सैन्धवं च जयद्रथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2040518, "chapter_id": 1897, "verse_number": "५-१४२-१३", "content_sanskrit": "युद्धायापततस्तूर्णं वारितान्सव्यसाचिना।\nन तदा भविता त्रेता न कृतं द्वापरं न च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2040519, "chapter_id": 1897, "verse_number": "५-१४२-१४", "content_sanskrit": "यदा द्रक्ष्यसि सङ्ग्रामे माद्रीपुत्रौ महाबलौ ।\nवाहिनीं धार्तराष्ट्राणां क्षोभयन्तौ गजाविव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2040520, "chapter_id": 1897, "verse_number": "५-१४२-१५", "content_sanskrit": "विगाढे शस्त्रसंपाते परवीररथारुजौ ।\nन तदा भविता त्रेता न कृतं द्वापरं न च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2040521, "chapter_id": 1897, "verse_number": "५-१४२-१६", "content_sanskrit": "ब्रूयाः कर्ण इतो गत्वा द्रोणं शान्तनवं कृपम् ।\nसौम्योऽयं वर्तते मासः सुप्रापयवसेन्धनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2040522, "chapter_id": 1897, "verse_number": "५-१४२-१७", "content_sanskrit": "सर्वौषधिवनस्फीतः फलवानल्पमक्षिकः ।\nनिष्पङ्को रसवत्तोयो नात्युष्णशिशिरः सुखः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2040523, "chapter_id": 1897, "verse_number": "५-१४२-१८", "content_sanskrit": "सप्तमाच्चापि दिवसादमावास्या भविष्यति।\nसङ्ग्रामो युज्यतां तस्यां तामाहुः शक्रदेवताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2040524, "chapter_id": 1897, "verse_number": "५-१४२-१९", "content_sanskrit": "तथा राज्ञो वदेः सर्वान्ये युद्धायाभ्युपागताः।\nयद्वो मनीषितं तद्वै सर्वं संपादयाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2040525, "chapter_id": 1897, "verse_number": "", "content_sanskrit": "राजानो राजपुत्राश्च दुर्योधनवशानुगाः ।\nप्राप्य शस्त्रेण निधनं प्राप्स्यन्ति गतिमुत्तमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]