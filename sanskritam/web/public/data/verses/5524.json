[{"id": 2212374, "chapter_id": 5524, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2212375, "chapter_id": 5524, "verse_number": "१", "content_sanskrit": "देशान्तरगते विप्रे संयुक्ते कालधर्मणा ।\nशरीरनाशे सम्प्राप्ते कथं प्रेतविकल्पना ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2212376, "chapter_id": 5524, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2212377, "chapter_id": 5524, "verse_number": "२", "content_sanskrit": "श्रूयतामाहिताग्नेषु तथाभूतस्य संस्क्रिया ।\nपालाशवृन्तैः प्रतिमा कर्तव्या कल्पचोदिता ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2212378, "chapter_id": 5524, "verse_number": "३", "content_sanskrit": "त्रीणि षष्टिशतान्याहुरस्थीन्यस्य नराधिप ।\nतेषां विकल्पना कार्या यथाशास्त्रविनिश्चयम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2212379, "chapter_id": 5524, "verse_number": "४", "content_sanskrit": "अशीत्यर्धं शिरसि च ग्रीवायां दश एव च ।\nबाह्वोश्चापि शतं दद्यात् अङ्गुलीषु पुनर्दश ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2212380, "chapter_id": 5524, "verse_number": "५", "content_sanskrit": "उरसि त्रिंशतं दद्याज्जठरे चापि विंशतिः ।\nवृषणे द्वादशार्धं तु शिश्ने चाष्टार्धमेव च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2212381, "chapter_id": 5524, "verse_number": "६", "content_sanskrit": "दद्यात्तु शतमूर्वोस्तु षष्ट्यर्धं जानुजङ्घयोः ।\nदश दद्याच्चरणयोरेषा प्रेतस्य निष्कृतिः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2212382, "chapter_id": 5524, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2212383, "chapter_id": 5524, "verse_number": "७", "content_sanskrit": "विशेषतीर्थं सर्वेषामशक्तानामनुग्रहात् ।\nभक्तानां तारणार्थं वै वक्तुमर्हसि धर्मतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2212384, "chapter_id": 5524, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2212385, "chapter_id": 5524, "verse_number": "८", "content_sanskrit": "प्रवरं सर्वतीर्थानां सत्यं गायन्ति सामगाः ।\nसत्यस्य वचनं तीर्थमहिंसा तीर्थमुच्यते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2212386, "chapter_id": 5524, "verse_number": "९", "content_sanskrit": "तपस्तीर्थं दया तीर्थं शीलं तीर्थं युधिष्ठिर ।\n(अल्पसन्तोषणं तीर्थं नारी तीर्थं पतिव्रता ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2212387, "chapter_id": 5524, "verse_number": "१०", "content_sanskrit": "सन्तुष्टो ब्राह्मणस्तीर्थं ज्ञानं वा तीर्थमुच्यते ।\nमद्भक्तः सततं तीर्थं शङ्करस्य विशेषतः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2212388, "chapter_id": 5524, "verse_number": "११", "content_sanskrit": "यतयस्तीर्थमित्येवं विद्वांसस्तीर्थमुच्यते ।)\nशरण्यपुरुषस्तीर्थमभयं तीर्थमुच्यते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2212389, "chapter_id": 5524, "verse_number": "", "content_sanskrit": "(विद्याविनीतकस्तीर्थं धर्मवक्ता विशेषतः ॥१२॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2212390, "chapter_id": 5524, "verse_number": "१३", "content_sanskrit": "त्रैलोक्येऽस्मिन् निरुद्विग्नो न बिभेमि कुतश्चन ।\nन दिवा यदि वा रात्रावुद्वेगः शूद्रलङ्घनात् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2212391, "chapter_id": 5524, "verse_number": "१४", "content_sanskrit": "न भयं देवदैतेभ्यो रक्षोभ्यश्चैव मे नृप ।\nशूद्रवक्त्राच्च्युताद् ब्राह्माद्भयं तु मम सर्वदा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2212392, "chapter_id": 5524, "verse_number": "१५", "content_sanskrit": "तस्मात् सप्रणवं शूद्रो मन्नामापि न कीर्तयेत् ।\nप्रणवं हि परं लोके ब्रह्म ब्रह्मविदो विदुः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2212393, "chapter_id": 5524, "verse_number": "१६", "content_sanskrit": "द्विजशुश्रूषणं धर्मः शूद्राणां भक्तितो मयि ।\nतेन गच्छन्ति ते स्वर्गं चिन्तयन्तो हि मां सदा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2212394, "chapter_id": 5524, "verse_number": "१७", "content_sanskrit": "द्विजशुश्रूषया शूद्रः परं श्रेयोऽधिगच्छति ।\nद्विजशुश्रूषणादन्यन्नास्ति शूद्रस्य निष्कृतिः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2212395, "chapter_id": 5524, "verse_number": "१८", "content_sanskrit": "रागो द्वेषश्च मोहश्च पारुष्यं चानृशंसता ।\nशाठ्यं च दीर्घवैरित्वमतिमानमनार्जवम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2212396, "chapter_id": 5524, "verse_number": "१९", "content_sanskrit": "अनृतं चापवादश्च पैशुन्यमतिलोभता ।\nहिंसा स्तेयो मृषावादो वञ्चना द्वेषलोभता ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2212397, "chapter_id": 5524, "verse_number": "२०", "content_sanskrit": "अबुद्धिता च नास्तिक्यं भयमालस्यमेव च ।\nअशौचं चाकृतज्ञत्वं डम्भता स्तम्भ एव च ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2212398, "chapter_id": 5524, "verse_number": "२१", "content_sanskrit": "निकृतिश्चाप्यविज्ञानं जातके शूद्रमाविशेत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2212399, "chapter_id": 5524, "verse_number": "२२", "content_sanskrit": "दृष्ट्वा पितामहः शूद्रमभिभूतं तु तामसैः ।\nद्विजशुश्रूषणं धर्मं शूद्राणां तु प्रयुक्तवान् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2212400, "chapter_id": 5524, "verse_number": "२३", "content_sanskrit": "नश्यन्ति तामसा भावाः शूद्रस्य द्विजभक्तितः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2212401, "chapter_id": 5524, "verse_number": "२४", "content_sanskrit": "पत्रं पुष्पं फलं तोयं यो मे भक्त्या प्रयच्छति ।\nतदहं भक्त्युपहृतं मूर्ध्ना गृह्णामि शूद्रतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2212402, "chapter_id": 5524, "verse_number": "२५", "content_sanskrit": "अन्त्यजो वाऽपि यः कश्चित् सर्वपापसमन्वितः ।\nयदि मां सततं ध्यायेत् सर्वपापैः प्रमुच्यते ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2212403, "chapter_id": 5524, "verse_number": "२६", "content_sanskrit": "विद्याविनयसम्पन्ना ब्राह्मणा वेदपारगाः ।\nमयि भक्तिं न कुर्वन्ति चण्डालसदृशा हि ते ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2212404, "chapter_id": 5524, "verse_number": "२७", "content_sanskrit": "वृथा दत्तं वृथा जप्तं वृथा चेष्टं वृथा हुतम् ।\nवृथाऽऽतिथ्यं च तत् तस्य यो न भक्तो मम द्विजः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2212405, "chapter_id": 5524, "verse_number": "२८", "content_sanskrit": "यत् कृतं च हुतं चापि यदिष्टं दत्तमेव च ।\nअभक्तिमत्कृतं सर्वं राक्षसा एव भुञ्जते ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2212406, "chapter_id": 5524, "verse_number": "२९", "content_sanskrit": "स्थावरे जङ्गमे वाऽपि सर्वभूतेषु पाण्डव ।\nसमत्वेन यदा कुर्यान्मद्भक्तो मित्रशत्रुषु ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2212407, "chapter_id": 5524, "verse_number": "३०", "content_sanskrit": "आनृशंस्यमहिंसा च दमः सत्यं तथाऽऽर्जवम् ।\nअद्रोहश्चैव भूतानां मद्रतानां व्रतं नृप ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2212408, "chapter_id": 5524, "verse_number": "३१", "content_sanskrit": "नम इत्येव यो ब्रूयान्मद्भक्तं श्रद्धयाऽन्वितः ।\nतस्याक्षयो भवेल्लोकः श्वपाकस्यापि पाण्डव ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2212409, "chapter_id": 5524, "verse_number": "३२", "content_sanskrit": "किं पुनर्ये यजन्ते मां याजका विधिपूर्वकम् ।\nमद्भक्ता मद्गतप्राणाः कथयन्तश्च मां सदा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2212410, "chapter_id": 5524, "verse_number": "३३", "content_sanskrit": "बहुवर्षसहस्राणि तपस्तप्यति यो नरः ।\nनासौ पदमवाप्नोति मद्भक्तैर्यदवाप्यते ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2212411, "chapter_id": 5524, "verse_number": "३४", "content_sanskrit": "मामेव तस्माद् राजेन्द्र ध्याहि नित्यमतन्द्रितः ।\nअवाप्स्यसि ततः सिद्धिं द्रक्ष्यसे च परं पदम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2212412, "chapter_id": 5524, "verse_number": "३५", "content_sanskrit": "अपार्थकं प्रभाषन्ते शूद्रा भागवता इति ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2212413, "chapter_id": 5524, "verse_number": "", "content_sanskrit": "न शूद्रा भगवद्भक्ता विप्रा भागवताः स्मृताः ।\n(सर्ववर्णेषु ते शूद्रा ये ह्यभक्ता जनार्दने ॥३६॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2212414, "chapter_id": 5524, "verse_number": "३७", "content_sanskrit": "द्वादशाक्षरतत्त्वज्ञः चतुर्व्यूहविभागवित् ।\nअच्छिद्रपञ्चकालज्ञः स वै भागवतः स्मृतः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2212415, "chapter_id": 5524, "verse_number": "३८", "content_sanskrit": "ऋग्वेदेनैव होता च यजुषाऽध्वर्युरेव च ।\nसामवेदेन चोद्गाता पुण्येनाभिष्टुवन्ति माम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2212416, "chapter_id": 5524, "verse_number": "३९", "content_sanskrit": "अथर्वशिरसा चैव नित्यमाथर्वणा द्विजाः ।\nस्तुवन्ति सततं ये मां ते वै भागवताः स्मृताः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2212417, "chapter_id": 5524, "verse_number": "४०", "content_sanskrit": "वेदाधीनाः सदा यज्ञा यज्ञाधीनास्तु देवताः ।\nदेवता ब्राह्मणाधीनास्तस्माद् विप्रास्तु देवताः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2212418, "chapter_id": 5524, "verse_number": "४१", "content_sanskrit": "अनाश्रित्योच्छ्रयं नास्ति मुख्यमाश्रयमाश्रयेत् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2212419, "chapter_id": 5524, "verse_number": "४२", "content_sanskrit": "रुद्रं समाश्रिता देवा रुद्रो ब्रह्माणमाश्रितः ।\nब्रह्मा मामाश्रितो राजन् नाहं कञ्चिदुपाश्रितः  ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2212420, "chapter_id": 5524, "verse_number": "४३", "content_sanskrit": "ममाश्रयो न कश्चित्तु सर्वेषामाश्रयो ह्यहम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2212421, "chapter_id": 5524, "verse_number": "४४", "content_sanskrit": "एवमेतन्मया प्रोक्तं रहस्यमिदमुत्तमम् ।\nधर्मप्रियस्य ते राजन् नित्यमेवं समाचर ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2212422, "chapter_id": 5524, "verse_number": "४५", "content_sanskrit": "इदं पवित्रमाख्यानं पुण्यं वेदैश्च सम्मितम् ।\nयः पठेन्मामकं धर्ममहन्यहनि पाण्डव ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2212423, "chapter_id": 5524, "verse_number": "४६", "content_sanskrit": "धर्मो विवर्धते तस्य बुद्धिश्चापि प्रसीदति ।\nपापक्षयमुपेत्यैवं कल्याणं च विवर्धते ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2212424, "chapter_id": 5524, "verse_number": "४७", "content_sanskrit": "एतत्पुण्यं पवित्रं च पापनाशनमुत्तमम् ।\nश्रोतव्यं श्रद्धया युक्तैः श्रोत्रियैश्च विशेषतः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2212425, "chapter_id": 5524, "verse_number": "४८", "content_sanskrit": "श्रावयेद् यस्त्विदं भक्त्या प्रयतोऽथ शृणोति वा ।\nस गच्छेन्मम सायुज्यं नात्र कार्या विचारणा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2212426, "chapter_id": 5524, "verse_number": "४९", "content_sanskrit": "यश्चेदं श्रावयेच्छ्राद्धे मद्भक्तो मत्परायणः ।\nपितरस्तस्य तृप्यन्ति यावदाभूतसम्प्लवम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2212427, "chapter_id": 5524, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2212428, "chapter_id": 5524, "verse_number": "५०", "content_sanskrit": "श्रुत्वा भागवतान् धर्मान् साक्षाद् विष्णोर्जगद्गुरोः ।\nप्रहृष्टमनसो भूत्वा चिन्तयन्तोऽद्भुताः कथाः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2212429, "chapter_id": 5524, "verse_number": "५१", "content_sanskrit": "ऋषयः पाण्डवाश्चैव प्रणेमुस्तं जनार्दनम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2212430, "chapter_id": 5524, "verse_number": "५२", "content_sanskrit": "पूजयामास गोविन्दं धर्मपुत्रः पुनः पुनः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2212431, "chapter_id": 5524, "verse_number": "५३", "content_sanskrit": "देवा ब्रह्मर्षयः सिद्धा गन्धर्वाप्सरसस्तथा ।\nभूता यक्षा ग्रहाश्चैव गुह्यका भुजगास्तथा ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2212432, "chapter_id": 5524, "verse_number": "५४", "content_sanskrit": "वालखिल्या महात्मानो योगिनस्तत्त्वदर्शिनः ।\nतथा भागवताश्चापि पञ्चकालमुपासकाः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2212433, "chapter_id": 5524, "verse_number": "५५", "content_sanskrit": "कौतूहलसमायुक्ता भगवद्भक्तिमागताः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2212434, "chapter_id": 5524, "verse_number": "५६", "content_sanskrit": "श्रुत्वा तु परमं पुण्यं वैष्णवं धर्मशासनम् ।\nविमुक्तपापाः पूतास्ते संवृत्तास्तत्क्षणेन तु ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2212435, "chapter_id": 5524, "verse_number": "५७", "content_sanskrit": "प्रणम्य शिरसा विष्णुं प्रतिनन्द्य च ताः कथाः ।\nद्रष्टारो द्वारकायां वै वयं सर्वे जगद्गुरुम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2212436, "chapter_id": 5524, "verse_number": "समाप्तिः", "content_sanskrit": "इति प्रहृष्टमनसो ययुर्देवगणैः सह ।\nसर्वे ऋषिगणा राजन् ययुः स्वं स्वं निवेशनम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2212437, "chapter_id": 5524, "verse_number": "५९", "content_sanskrit": "गतेषु तेषु सर्वेषु केशवः केशिहा तदा ।\nसस्मार दारुकं राजन् स च सात्यकिना सह ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2212438, "chapter_id": 5524, "verse_number": "६०", "content_sanskrit": "समीपस्थोऽभवत्सूतो याहि देवेति चाब्रवीत् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2212439, "chapter_id": 5524, "verse_number": "६१", "content_sanskrit": "ततो विषण्णवदनाः पाण्डवाः पुरुषोत्तमम् ।\nअञ्जलिं मूर्ध्नि सन्धाय नेत्रैरश्रुपरिप्लुतैः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2212440, "chapter_id": 5524, "verse_number": "६२", "content_sanskrit": "पिबन्तः सततं कृष्णं नोचुरार्ततरास्तदा ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2212441, "chapter_id": 5524, "verse_number": "६३", "content_sanskrit": "कृष्णोऽपि भगवान् देवः पृथामामन्त्र्य चार्तवत् ।\nधृतराष्ट्रं च गान्धारीं विदुरं द्रौपदीं तथा ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2212442, "chapter_id": 5524, "verse_number": "६४", "content_sanskrit": "कृष्णद्वैपायनं व्यासमृषीनन्यांश्च मन्त्रिणः ।\nसुभद्रामात्मजयुतामुत्तरां स्पृश्य पाणिना ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2212443, "chapter_id": 5524, "verse_number": "६५", "content_sanskrit": "निर्गत्य वेश्मनस्तस्मादारुरोह महारथम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2212444, "chapter_id": 5524, "verse_number": "६६", "content_sanskrit": "वाजिभिः शैब्यसुग्रीवमेघपुष्पव(ब)लाहकैः ।\nयुक्तं तु ध्वजभूतेन पतगेन्द्रेण धीमता ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2212445, "chapter_id": 5524, "verse_number": "६७", "content_sanskrit": "अन्वारुरोह चाप्येनं प्रेम्णा राजा युधिष्ठिरः ।\nअपास्य चाशु यन्तारं दारुकं सूतसत्तमम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2212446, "chapter_id": 5524, "verse_number": "६८", "content_sanskrit": "अभीशून् प्रतिजग्राह स्वयं कुरुपतिस्तदा ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2212447, "chapter_id": 5524, "verse_number": "६९", "content_sanskrit": "उपारुह्यार्जुनश्चापि चामरव्यजनं शुभम् ।\nरुग्मदण्डं बृहन्मूर्ध्नि दुधावाशु प्रदक्षिणम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2212448, "chapter_id": 5524, "verse_number": "७०", "content_sanskrit": "छत्रं शतशलाकं च दिव्यमाल्योपशोभितम् ।\nवैडूर्यमणिदण्डं च चामीकरविभूषितम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2212449, "chapter_id": 5524, "verse_number": "७१", "content_sanskrit": "दधार तरसा भीमश्छत्रं तच्छार्ङ्गधन्वनः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2212450, "chapter_id": 5524, "verse_number": "७२", "content_sanskrit": "भीमसेनोऽर्जुनश्चैव यमावप्यरिसूदनौ ।\nमाद्रीपुत्रौ तदा राजन् कृष्णस्याप्यरिसूदनौ ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2212451, "chapter_id": 5524, "verse_number": "७३", "content_sanskrit": "पृष्ठतोऽनुययुः कृष्णं मा शब्द इति हर्षितौ ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2212452, "chapter_id": 5524, "verse_number": "७४", "content_sanskrit": "त्रियोजने व्यतीते तु परिष्वज्य च पाण्डवान् ।\nविसृज्य कृष्णस्तान् सर्वान् प्रणतान् द्वारकां ययौ ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2212453, "chapter_id": 5524, "verse_number": "७५", "content_sanskrit": "तदा प्रणम्य गोविन्दं तदाप्रभृति पाण्डवाः ।\nकपिलाद्यानि दानानि ददुर्धर्मपरायणाः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2212454, "chapter_id": 5524, "verse_number": "७६", "content_sanskrit": "मधुसूदनवाक्यानि स्मृत्वा स्मृत्वा पुनः पुनः ।\nमनसा पूजयामासुर्हृदयस्थानि पाण्डवाः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2212455, "chapter_id": 5524, "verse_number": "७७", "content_sanskrit": "युधिष्ठिरस्तु धर्मात्मा हृदि कृत्वा जनार्दनम् ।\nतद्भक्तस्तन्मना युक्तस्तद्याजी तत्परोऽभवत् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2212456, "chapter_id": 5524, "verse_number": "७८", "content_sanskrit": "एवमेतत् पुरावृत्तं वैष्णवं धर्मशासनम् ।\nमया ते कथितं राजन् पवित्रं पापनाशनम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2212457, "chapter_id": 5524, "verse_number": "७९", "content_sanskrit": "तच्छृणुष्व महाराज विष्णुप्रोक्तं कुरूद्वह ।\nतेन गच्छसि नान्येन तद् विष्णोः परमं पदम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2212458, "chapter_id": 5524, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nआश्वमेधिकपर्वणि वैष्णवधर्मशास्त्रे सर्वधर्मकथनानन्तरं श्रीकृष्णस्य द्वारावतीप्रवेशवर्णनं नाम अष्टादशोत्तरशततमोऽध्यायः ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2212459, "chapter_id": 5524, "verse_number": "", "content_sanskrit": "॥ समाप्तम् आश्वमेधिकपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2212460, "chapter_id": 5524, "verse_number": "", "content_sanskrit": "॥ श्री मध्वेशार्पणमस्तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}]