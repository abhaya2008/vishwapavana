[{"id": 2001205, "chapter_id": 1015, "verse_number": "१-१६-०x", "content_sanskrit": "शौनक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2001206, "chapter_id": 1015, "verse_number": "१-१६-१", "content_sanskrit": "सौते त्वं कथयस्वेमां विस्तरेण कथां पुनः।\nआस्तीकस्य कवेःसाधोः शुश्रूषा परमा हिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2001207, "chapter_id": 1015, "verse_number": "१-१६-२", "content_sanskrit": "मधुरं कथ्यते सौम्य श्लक्ष्णाक्षरपदं त्वया।\nप्रीयामहे भृशं तात पितेवेदं प्रभाषसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2001208, "chapter_id": 1015, "verse_number": "१-१६-३", "content_sanskrit": "अस्मच्छुश्रूषणे नित्यं पिता हि निरतस्तव।\nआचष्टैतद्यथाऽऽक्यानं पिता तेत्वं तथा वद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2001209, "chapter_id": 1015, "verse_number": "१-१६-४x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2001210, "chapter_id": 1015, "verse_number": "१-१६-४", "content_sanskrit": "आयुष्मन्निदमाख्यानमास्तीकं कथयामि ते।\nयथाश्रुतं कथयतः सकाशाद्वै पितुर्मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2001211, "chapter_id": 1015, "verse_number": "१-१६-५", "content_sanskrit": "पुरा देवयुगे ब्रह्मन्प्रजापतिसुते शुभे।\nआस्तां भगिन्यौ रूपेण समुपेतेऽद्भुतेऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2001212, "chapter_id": 1015, "verse_number": "१-१६-६", "content_sanskrit": "ते भार्ये कश्यपस्यास्तां कद्रूश्च विनता च ह।\nप्रादात्ताभ्यां वरं प्रीतः प्रजापतिसमः पतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2001213, "chapter_id": 1015, "verse_number": "१-१६-७", "content_sanskrit": "कश्यपो धर्मपत्नीभ्यां मुदा परमया युतः।\nवरातिसर्गं श्रुत्वैवं कश्यपादुत्तमं च ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2001214, "chapter_id": 1015, "verse_number": "१-१६-८", "content_sanskrit": "हर्षादप्रतिमां प्रीतिं प्रापतुः स्म वरस्त्रियौ।\nवव्रे कद्रूः सुतान्नागान्सहस्रं तुल्यवर्चसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2001215, "chapter_id": 1015, "verse_number": "१-१६-९", "content_sanskrit": "द्वौ पुत्रौ विनता वव्रे कद्रूपुत्राधिकौ बले।\nतेजसा वपुषा चैव विक्रमेणाधिकौ च तौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2001216, "chapter_id": 1015, "verse_number": "१-१६-१०", "content_sanskrit": "तस्यै भर्ता वरं प्रादादीदृसौ ते भविष्यतः।\nएवमस्त्विति तं चाह कश्यपं विनता तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2001217, "chapter_id": 1015, "verse_number": "१-१६-११", "content_sanskrit": "यथावत्प्रार्थितं लब्ध्वा वरं तुष्टाभवत्तदा।\nकृतकृत्या तु विनता लब्ध्वा वीर्याधिकौ सुतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2001218, "chapter_id": 1015, "verse_number": "१-१६-१२", "content_sanskrit": "कद्रूश्च लब्ध्वा पुत्राणां सहस्रं तुल्यवर्चसाम्।\nधार्यौ प्रयत्नतो गर्भावित्युक्त्वा स महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2001219, "chapter_id": 1015, "verse_number": "१-१६-१३", "content_sanskrit": "ते भार्ये वरसंतुष्टे कश्यपो वनमाविशत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2001220, "chapter_id": 1015, "verse_number": "१-१६-१३x", "content_sanskrit": "सौतुरिवाच।\nकालेन महता कद्रूरण्डानां दशतीर्दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2001221, "chapter_id": 1015, "verse_number": "१-१६-१४", "content_sanskrit": "जनयामास विप्रेन्द्र द्वे चाण्डे विनता तदा।\nतयोरण्डानि निदधुः प्रहृष्टाः परिचारिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2001222, "chapter_id": 1015, "verse_number": "१-१६-१५", "content_sanskrit": "सोपस्वेदेषु भाण्डेषु पञ्चवर्षशतानि च।\nततः पञ्चशते काले कद्रूपुत्रा विनिःसृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2001223, "chapter_id": 1015, "verse_number": "१-१६-१६", "content_sanskrit": "अण्डाभ्यां विनतायास्तु मिथुनं न व्यदृश्यत।\nततः पुत्रार्थिनी देवी व्रीडिता च तपस्विनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2001224, "chapter_id": 1015, "verse_number": "१-१६-१७", "content_sanskrit": "अण्डं बिभेद विनता तत्र पुत्रमपश्यत।\nपूर्वार्धकायसंपन्नमितरेणाप्रकाशता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2001225, "chapter_id": 1015, "verse_number": "१-१६-१८", "content_sanskrit": "स पुत्रः क्रोधसंरब्धः शशापैनामिति श्रुतिः।\nयोऽहमेवं कृतो मातस्त्वया लोभपरीतया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2001226, "chapter_id": 1015, "verse_number": "१-१६-१९", "content_sanskrit": "शरीरेणासमग्रेण तस्माद्दासी भविष्यसि।\nपञ्च वर्षशतान्यस्या यया विस्पर्धसे सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2001227, "chapter_id": 1015, "verse_number": "१-१६-२०", "content_sanskrit": "एष च त्वां सुतो मातर्दासीत्वान्मोचयिष्यति।\nयद्येनमपि मातस्त्वं मामिवाण्डविभेदनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2001228, "chapter_id": 1015, "verse_number": "१-१६-२१", "content_sanskrit": "न करिष्यस्यनङ्गं वा व्यङ्गं वापि तपस्विनम्।\nप्रतिपालयितव्यस्ते जन्मकालोऽस्य धीरया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2001229, "chapter_id": 1015, "verse_number": "१-१६-२२", "content_sanskrit": "विशिष्टं बलमीप्सन्त्या पञ्चवर्षशतात्परः।\nएवं शप्त्वा ततः पुत्रो विनतामन्तरिक्षगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2001230, "chapter_id": 1015, "verse_number": "१-१६-२३", "content_sanskrit": "अरुणोऽदृश्यत ब्रह्मन्प्रभातसमये तदा।\nउद्यन्नथ सहस्रांशुर्दृष्ट्वा तमरुणं प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2001231, "chapter_id": 1015, "verse_number": "१-१६-२४", "content_sanskrit": "स्वतेजसा प्रज्वलन्तमात्मनः समतेजसम्।\nसारथ्ये कल्पयामास प्रीयमाणस्तमोनुदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2001232, "chapter_id": 1015, "verse_number": "१-१६-२५", "content_sanskrit": "सोऽपि तं रथमारुह्य भानोरमिततेजसः।\nसर्वलोकप्रदीपस्य ह्यमरोऽप्यरुणोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2001233, "chapter_id": 1015, "verse_number": "१-१६-२६", "content_sanskrit": "गरुडोऽपि यथाकालं जज्ञे पन्नगभोजनः।\nस जातमात्रो विनतां परित्यज्य खमाविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2001234, "chapter_id": 1015, "verse_number": "१-१६-२७", "content_sanskrit": "आदास्यन्नात्मनो भोज्यमन्नं विहितमस्य यत्।\nविधात्रा भृगुशार्दूल क्षुधितः पतगेश्वरः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2001235, "chapter_id": 1015, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वाणि आस्तीकपर्वणि षोडशोऽध्यायः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]