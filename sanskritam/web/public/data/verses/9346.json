[{"id": 40020972, "chapter_id": 9346, "verse_number": "1", "content_sanskrit": "कैलासं लङ्घयित्वाथ दशग्रीवः स रावणः । आससाद महातेजा इन्द्रलोकं निशाचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40020973, "chapter_id": 9346, "verse_number": "2", "content_sanskrit": "तस्य राक्षससैन्यस्य समन्तादुपयास्यतः । देवलोकं ययौ शब्दो मथ्यमानार्णवोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40020974, "chapter_id": 9346, "verse_number": "3", "content_sanskrit": "श्रुत्वा तु रावणं प्राप्तमिन्द्रश्चलित आसनात् । अब्रवीत्तत्र तान् देवान् सर्वानेव समागतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40020975, "chapter_id": 9346, "verse_number": "4", "content_sanskrit": "आदित्यान्सवसून्रुद्रान्विश्वान्साध्यान्मरुद्गणान् । सज्जीभवत युद्धार्थं रावणस्य दुरात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40020976, "chapter_id": 9346, "verse_number": "5", "content_sanskrit": "एवमुक्तास्तु शक्रेण देवाः शक्रसमा युधि । सन्नह्य सुमहासत्त्वा युद्धश्रद्धासमन्विताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40020977, "chapter_id": 9346, "verse_number": "6", "content_sanskrit": "स तु दीनः परित्रस्तो महेन्द्रो रावणं प्रति । विष्णोः समीपमागत्य वाक्यमेतदुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40020978, "chapter_id": 9346, "verse_number": "7", "content_sanskrit": "विष्णो कथं करिष्यामि महावीर्यपराक्रमः । असौ हि बलवद्रक्षो युद्धार्थमभिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40020979, "chapter_id": 9346, "verse_number": "8", "content_sanskrit": "वरप्रदानाद्बलवान्न खल्वन्येन हेतुना । तत्तु सत्यवचः कार्यं यदुक्तं पद्मयोनिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40020980, "chapter_id": 9346, "verse_number": "9", "content_sanskrit": "तद्यथा नमुचिर्वृत्रो बलिर्नरकशम्बरौ । त्वद्बलं समवष्टभ्य मया दग्धास्तथा कुरु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40020981, "chapter_id": 9346, "verse_number": "10", "content_sanskrit": "नह्यन्यो देवदेवेश त्वामृते मधुसूदन । गतिः परायणं नास्ति त्रैलोक्ये सचराचरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40020982, "chapter_id": 9346, "verse_number": "11", "content_sanskrit": "त्वं हि नारायणः श्रीमान्पद्मनाभः सनातनः । त्वयेमे स्थापिता लोकाः शक्रश्चाहं सुरेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40020983, "chapter_id": 9346, "verse_number": "12", "content_sanskrit": "त्वया सृष्टमिदं सर्वं त्रैलोक्यं सचराचरम् । त्वामेव भगवन्सर्वे प्रविशन्ति युगक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40020984, "chapter_id": 9346, "verse_number": "13", "content_sanskrit": "तदाचक्ष्व यथा तत्त्वं देवदेव मम स्वयम् । अपि चक्रसहायस्त्वं योत्स्यसे रावणं प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40020985, "chapter_id": 9346, "verse_number": "14", "content_sanskrit": "एवमुक्तः स शक्रेण देवो नारायणः प्रभुः । अब्रवीन्न परित्रासः कर्तव्यः श्रूयतां च मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40020986, "chapter_id": 9346, "verse_number": "15", "content_sanskrit": "न तावदेष दुष्टात्मा शक्यो जेतुं सुरासुरैः । हन्तुं चापि समासाद्य वरदानेन दुर्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40020987, "chapter_id": 9346, "verse_number": "16", "content_sanskrit": "सर्वथा तु महत्कर्म करिष्यति बलोत्कटः । राक्षसः पुत्रसहितो दृष्टमेतन्निसर्गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40020988, "chapter_id": 9346, "verse_number": "17", "content_sanskrit": "यत्तु मां त्वमभाषिष्ठ युद्ध्यस्वेति सुरेश्वर । नाहं तं प्रतियोत्स्यामि रावणं राक्षसं युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40020989, "chapter_id": 9346, "verse_number": "18", "content_sanskrit": "नाहत्वा समरे शत्रुं विष्णुः प्रतिनिवर्तते । दुर्लभश्चैव कामो ऽद्य वरगुप्ताद्धि रावणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40020990, "chapter_id": 9346, "verse_number": "19", "content_sanskrit": "प्रतिजाने च देवेन्द्र त्वत्समीपे शतक्रतो । भविता ऽस्मि यथा ऽस्याहं रक्षसो मृत्युकारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40020991, "chapter_id": 9346, "verse_number": "20", "content_sanskrit": "अहमेव निहन्ता ऽस्मि रावणं सपुरःसरम् । देवता नन्दयिष्यामि ज्ञात्वा कालमुपागतम् । एतत्ते कथितं तत्त्वं देवराज शचीपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40020992, "chapter_id": 9346, "verse_number": "21", "content_sanskrit": "युद्ध्यस्व विगतत्रासः सर्वैः सार्धं महाबल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40020993, "chapter_id": 9346, "verse_number": "22", "content_sanskrit": "यामि ज्ञात्वा कालमुपागतम् । ततो रुद्राः सहादित्या वसवो मरुतो ऽश्वनौ । सन्नद्धा निर्ययुस्तूर्णं राक्षसानभितः पुरात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40020994, "chapter_id": 9346, "verse_number": "23", "content_sanskrit": "एतस्मिन्नन्तरे नादः शुश्रुवे रजनीक्षये । तस्य रावणसैन्यस्य प्रयुद्धस्य समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40020995, "chapter_id": 9346, "verse_number": "24", "content_sanskrit": "ते प्रयुद्धा महावीर्या ह्यन्योन्यमभिवीक्ष्य वै । सङ्ग्राममेवाभिमुखा ह्यभवर्तन्त हृष्टवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40020996, "chapter_id": 9346, "verse_number": "25", "content_sanskrit": "ततो दैवतसैन्यनां सङ्क्षोभः समजायत । तदक्षयं महासैन्यं दृष्ट्वा समरमूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40020997, "chapter_id": 9346, "verse_number": "26", "content_sanskrit": "ततो युद्धं समभवेद्देवदानवरक्षसाम् । घोरं तुमुलनिर्ह्रादं नानाप्रहरणोद्यतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40020998, "chapter_id": 9346, "verse_number": "27", "content_sanskrit": "एतस्मिन्नन्तरे शूरा राक्षसा घोरदर्शनाः । युद्धार्थं समवर्तन्त सचिवा रावणस्य ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40020999, "chapter_id": 9346, "verse_number": "28", "content_sanskrit": "मारीचश्च प्रहस्तश्च महापार्श्वमहोदरौ । अकम्पनो निकुम्भश्च शुकः सारण एव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40021000, "chapter_id": 9346, "verse_number": "29", "content_sanskrit": "संह्लादो धूमकेतुश्च महादंष्ट्रो घटोदरः । जम्बुमाली महाह्रादो विरूपाक्षश्च राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40021001, "chapter_id": 9346, "verse_number": "30", "content_sanskrit": "सुप्तघ्नो यज्ञकोपश्च दुर्मुखो दूषणः खरः । त्रिशिराः करवीराक्षः सूर्यशत्रुश्च राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40021002, "chapter_id": 9346, "verse_number": "31", "content_sanskrit": "महाकायो ऽतिकायश्च देवान्तकनरान्तकौ । एतैः सर्वैः परिवृतो महावीर्यो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40021003, "chapter_id": 9346, "verse_number": "32", "content_sanskrit": "रावणस्यार्यकः सैन्यं सुमाली प्रविवेश ह । स दैवतगणान्सर्वान्नानाप्रहरणैः शितैः । व्यध्वंसयत्सुसङ्क्रुद्धो वायुर्जलधरानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40021004, "chapter_id": 9346, "verse_number": "33", "content_sanskrit": "तद्दैवतबलं राम हन्यमानं निशाचरैः । प्रणुन्नं सर्वतो दिग्भ्यः सिंहनुन्ना मृगा इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40021005, "chapter_id": 9346, "verse_number": "34", "content_sanskrit": "एतस्मिन्नन्तरे शूरो वसूनामष्टमो वसुः । सावित्र इति विख्यातः प्रविवेश रणाजिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40021006, "chapter_id": 9346, "verse_number": "35", "content_sanskrit": "तथा ऽ ऽदित्यौ महावीर्यौ त्वष्टा पूषा च दंशितौ । निंर्भयौ सह सैन्येन तदा प्राविशतां रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40021007, "chapter_id": 9346, "verse_number": "36", "content_sanskrit": "ततो युद्धं समभवत्सुराणां सह राक्षसैः । क्रुद्धानां रक्षसां कीर्तिं समरेष्वनिवर्तिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40021008, "chapter_id": 9346, "verse_number": "37", "content_sanskrit": "ततस्ते राक्षसाः सर्वे विबुधान्समरे स्थितान् । नानाप्रहरणैर्घोरैर्जघ्नुः शतसहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40021009, "chapter_id": 9346, "verse_number": "38", "content_sanskrit": "देवाश्च राक्षसान्घोरान्महाबलपराक्रमान् । समरे विमलैः शस्त्रैरुपनिन्युर्यमक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40021010, "chapter_id": 9346, "verse_number": "39", "content_sanskrit": "एतस्मिन्नन्तरे राम सुमाली नाम राक्षसः । नानाप्रहरणैः क्रुद्धस्तत्सैन्यं सो ऽभ्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40021011, "chapter_id": 9346, "verse_number": "40", "content_sanskrit": "स दैवतबलं सर्वं नानाप्रहणैः शितैः । व्यध्वंसयत सङ्क्रुद्धो वायुर्जलधरं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40021012, "chapter_id": 9346, "verse_number": "41", "content_sanskrit": "ते महाबाणवर्षैश्च शूलप्रासैः सुदारुणैः । हन्यमानाः सुराः सर्वे न व्यतिष्ठन्त संहताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40021013, "chapter_id": 9346, "verse_number": "42", "content_sanskrit": "ततो विद्राव्यमाणेषु दैवतेषु सुमालिना । वसूनामष्टमः क्रुद्धः सावित्रो वै व्यवस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 40021014, "chapter_id": 9346, "verse_number": "43", "content_sanskrit": "संवृतः स्वैरथानीकैः प्रहरन्तं निशाचरम् । विक्रमेण महातेजा वारयामास संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 40021015, "chapter_id": 9346, "verse_number": "44", "content_sanskrit": "ततस्तयोर्महायुद्धमभवद्रोमहर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 40021016, "chapter_id": 9346, "verse_number": "45", "content_sanskrit": "सुमालिनो वसोश्चैव समरेष्वनिवर्तिनोः । ततस्तस्य महाबाणैर्वसुना सुमहात्मना । निहतः पन्नगरथः क्षणेन विनिपातितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 40021017, "chapter_id": 9346, "verse_number": "46", "content_sanskrit": "हत्वा तु संयुगे तस्य रथं बाणशतैश्चितम् । गदां तस्य वधार्थाय वसुर्जग्राह पाणिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 40021018, "chapter_id": 9346, "verse_number": "47", "content_sanskrit": "ततः प्रगृह्य दीप्ताग्रां कालदण्डोपमां गदाम् । तां मूर्ध्नि पातयामास सावित्रो वै सुमालिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 40021019, "chapter_id": 9346, "verse_number": "48", "content_sanskrit": "सा तस्योपरि चोल्काभा पतन्तीव बभौ गदा । इन्द्रप्रमुक्ता गर्जन्ती गिराविव महाशनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 40021020, "chapter_id": 9346, "verse_number": "49", "content_sanskrit": "तस्य नैवास्थि न शिरो न मांसं ददृशे तदा । गदया भस्मतां नीतं निहतस्य रणाजिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 40021021, "chapter_id": 9346, "verse_number": "50", "content_sanskrit": "तं दृष्ट्वा निहतं सङ्ख्ये राक्षसास्ते समन्ततः । व्यद्रवन्सहिताः सर्वे क्रोशमानाः परस्परम् । विद्राव्यमाणा वसुना राक्षसा नावतस्थिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]