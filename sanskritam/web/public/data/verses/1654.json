[{"id": 2029912, "chapter_id": 1654, "verse_number": "३-२९२-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2029913, "chapter_id": 1654, "verse_number": "३-२९२-१", "content_sanskrit": "स हत्वा रावयणं क्षुद्रं राक्षसेनद्रं सुरद्विषम्।\nबभूव हृष्टः ससुहृद्रामः सौमित्रिणा सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2029914, "chapter_id": 1654, "verse_number": "३-२९२-२", "content_sanskrit": "ततो हते दशग्रीवे देवाः सर्षिपुरोगमाः।\nआशीर्भिर्जययुक्ताभिरानर्चुस्तं महाभुजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2029915, "chapter_id": 1654, "verse_number": "३-२९२-३", "content_sanskrit": "रामं कमलपत्राक्षं तुष्टुवुः सर्वदेवताः।\nगन्धर्वाः पुष्पवर्षैश्च वाग्भिश्च त्रिदशालयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2029916, "chapter_id": 1654, "verse_number": "३-२९२-४", "content_sanskrit": "पूजयित्वा रणे रामं प्रतिजग्मुर्यथागतम्।\nतन्महोत्सवसंकाशमासीदाकाशमच्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2029917, "chapter_id": 1654, "verse_number": "३-२९२-५", "content_sanskrit": "ततो हत्वा दशग्रीवं लङ्कां रामो महायशाः।\nविभीषणाय प्रददौ प्रभुः परपुरंजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2029918, "chapter_id": 1654, "verse_number": "३-२९२-६", "content_sanskrit": "ततः सीतां पुरस्कृत्य विभीषणपुरस्कृताम्।\nअविन्ध्यो नाम सुप्रज्ञो वृद्धामात्यो विनिर्ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2029919, "chapter_id": 1654, "verse_number": "३-२९२-७", "content_sanskrit": "उवाच च महात्मानं काकुत्स्थं दैन्यमास्थितम्।\nप्रतीच्छ देवीं सद्वृत्तां महात्मञ्जानकीमिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2029920, "chapter_id": 1654, "verse_number": "३-२९२-८", "content_sanskrit": "एतच्छ्रुत्वा वचस्तस्मादवतीर्य रथोत्तमात्।\nबाष्पेणापिहितां सीतां ददर्शेक्ष्वाकुनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2029921, "chapter_id": 1654, "verse_number": "३-२९२-९", "content_sanskrit": "तां दृष्ट्वा चारुसर्वाङ्गीं यानस्थां शोककर्शिताम्।\nमलोपचितसर्वाङ्गीं जटिलां कृष्णवाससम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2029922, "chapter_id": 1654, "verse_number": "३-२९२-१०", "content_sanskrit": "उवाच रामो वैदेहीं परामर्शविशङ्कितः।\n`लक्षयित्वेङ्गितं सर्वं प्रियं तस्यै निवेद्य सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2029923, "chapter_id": 1654, "verse_number": "३-२९२-११", "content_sanskrit": "गच्छ वैदेहि मुक्ता त्वं यत्कार्यं तनमया कृतम्।\nमामासाद्यपतिं भद्रे न त्वं राक्षसवेश्मनि।\nजरां व्रजेथा इतिमे निहतोसौ निशाचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2029924, "chapter_id": 1654, "verse_number": "३-२९२-१२", "content_sanskrit": "कथं ह्यस्मद्विधो जातु जानन्धर्मविनिश्चयम्।\nपरहस्तगतां नारीं मुहूर्तमपि धारयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2029925, "chapter_id": 1654, "verse_number": "३-२९२-१३", "content_sanskrit": "सुवृत्तामसुवृत्तां वाऽप्यहं त्वामद्य मैथिलि।\nनोत्सहे परिभोगाय श्वावलीढं हविर्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2029926, "chapter_id": 1654, "verse_number": "३-२९२-१४", "content_sanskrit": "ततः सा सहसा बाला तच्छ्रुत्वा दारुणं वचः।\nपपात देवी व्यथिता निकृत्ता कदली यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2029927, "chapter_id": 1654, "verse_number": "३-२९२-१५", "content_sanskrit": "योप्यस्या हर्षसंभूतो मुखरागः पुराऽभवत्।\nक्षणेन सपुनर्नष्टो निःश्वासादिव दर्पणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2029928, "chapter_id": 1654, "verse_number": "३-२९२-१६", "content_sanskrit": "ततस्ते हरयः सर्वे तच्छ्रुत्वा रामभाषितम्।\nगतासुकल्पा निश्चेष्टा बभूवुः सहलक्ष्मणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2029929, "chapter_id": 1654, "verse_number": "३-२९२-१७", "content_sanskrit": "ततो देवो विशुद्धात्मा विमानेन चतुर्मुखः।\nपद्मयोनिर्जगत्स्रष्टा दर्शयामास राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2029930, "chapter_id": 1654, "verse_number": "३-२९२-१८", "content_sanskrit": "शक्रश्चाग्निश्च वायुश्चयमो वरुण एव च।\nयक्षाधिपश्च भगवांस्तथा सप्तर्षयोऽमलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2029931, "chapter_id": 1654, "verse_number": "३-२९२-१९", "content_sanskrit": "राजा दशरथश्चैव दिव्यभास्वरमूर्तिमान्।\nविमानेन महार्हेण हंसयुक्तेन भास्वता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2029932, "chapter_id": 1654, "verse_number": "३-२९२-२०", "content_sanskrit": "ततोऽन्तरिक्षं तत्सर्वंदेवगन्धर्वसंकुलम्।\nशुशुभे तारकाचित्रं शरदीव नभस्तलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2029933, "chapter_id": 1654, "verse_number": "३-२९२-२१", "content_sanskrit": "तत उत्थाय वैदेही तेषां मध्ययशस्विनी।\nउवाच वाक्यं कल्याणी रामं पृथुलवक्षसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2029934, "chapter_id": 1654, "verse_number": "३-२९२-२२", "content_sanskrit": "राजपुत्र न ते कोपं करोमि विदिताहि मे।\nगतिः स्त्रीणां नराणां च शृणु चदं वचो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2029935, "chapter_id": 1654, "verse_number": "३-२९२-२३", "content_sanskrit": "अन्तश्चरतिभूतानां मातरिश्वा सदागतिः।\nस मे विमुञ्चतु प्राणान्यदि पापं चराम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2029936, "chapter_id": 1654, "verse_number": "३-२९२-२४", "content_sanskrit": "अग्निरापस्तथाऽऽकाशं पृथिवी वायुरेव च।\nविमुञ्चन्तु मम प्राणान्यदि पापं चराम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2029937, "chapter_id": 1654, "verse_number": "३-२९२-२५", "content_sanskrit": "यथाऽहं त्वदृतेवीर नान्यंस्वप्नेऽप्यचिन्तयम्।\nतथा मे देव निर्दिष्टस्त्वमेव हि पतिर्भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2029938, "chapter_id": 1654, "verse_number": "३-२९२-२६", "content_sanskrit": "ततोऽन्तरिक्षे वागारीत्सुभगा लोकसाक्षिणी।\nपुण्यासंहर्षणी तेषां वानराणां महात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2029939, "chapter_id": 1654, "verse_number": "३-२९२-२७x", "content_sanskrit": "वायुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2029940, "chapter_id": 1654, "verse_number": "३-२९२-२७", "content_sanskrit": "बोभो राघव सत्यं वै वायुरस्मि सदागतिः।\nअपापा मैथिली राजन्संगच्छसहभार्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2029941, "chapter_id": 1654, "verse_number": "३-२९२-२८x", "content_sanskrit": "अग्निरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2029942, "chapter_id": 1654, "verse_number": "३-२९२-२८", "content_sanskrit": "अहमन्तःशरीरस्थो भूतानां रघुनन्दन।\nसुसूक्ष्ममपि काकुत्स्थ मैथिलीनापराध्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2029943, "chapter_id": 1654, "verse_number": "३-२९२-२९x", "content_sanskrit": "वरुण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2029944, "chapter_id": 1654, "verse_number": "३-२९२-२९", "content_sanskrit": "रसावै मत्प्रसूता हि भूतदेहेषु राघव।\nअहंवै त्वां प्रब्रवीमि मैथिली प्रतिगृह्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2029945, "chapter_id": 1654, "verse_number": "३-२९२-३०x", "content_sanskrit": "यम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2029946, "chapter_id": 1654, "verse_number": "३-२९२-३०", "content_sanskrit": "`धर्मोऽहमस्मि काकुत्स्थ साक्षी लोकस्य कर्मणाम्।\nशुभाशुभानां सीतेयमपापा प्रतिगृह्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2029947, "chapter_id": 1654, "verse_number": "३-२९२-३१x", "content_sanskrit": "ब्र्हमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2029948, "chapter_id": 1654, "verse_number": "३-२९२-३१", "content_sanskrit": "पुत्र नैतदिहाश्चर्यं त्वयि राजर्षिधर्मणि।\nसाधो सद्वृत्त काकुत्स्थ शृणु चेदं वचो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2029949, "chapter_id": 1654, "verse_number": "३-२९२-३२", "content_sanskrit": "शत्रुरेष त्वया वीर देवगनधर्वभोगिनाम्।\nयक्षाणां दानवानां च महर्षीणां च पातितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2029950, "chapter_id": 1654, "verse_number": "३-२९२-३३", "content_sanskrit": "अवध्यः सर्वभूतानां मत्प्रसादात्पुराऽभवत्।\nकस्माच्चित्कारणात्पापः कंचित्कालमुपेक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2029951, "chapter_id": 1654, "verse_number": "३-२९२-३४", "content_sanskrit": "वधार्थमात्मनस्तेन हृता सीता दुरात्मना।\nनलकूबरशापेन रक्षा चास्याः कृता मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2029952, "chapter_id": 1654, "verse_number": "३-२९२-३५", "content_sanskrit": "यदि ह्यकामामासेवेत्स्तरियमन्यामपि ध्रुवम्।\nशतधाऽस्य फलेन्मूर्धा इत्युक्तः सोभवत्पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2029953, "chapter_id": 1654, "verse_number": "३-२९२-३६", "content_sanskrit": "नात्रशङ्का त्वया कार्या प्रतीच्छेमां महामते।\nकृतं त्वया महत्कार्यं देवानाममितप्रभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2029954, "chapter_id": 1654, "verse_number": "३-२९२-३७x", "content_sanskrit": "दशरथ उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2029955, "chapter_id": 1654, "verse_number": "३-२९२-३७", "content_sanskrit": "प्रीतोस्मि वत्स भद्रं ते पिता दशरथोस्मि ते।\nअनुजानामि राज्यं च प्रशाधि पुरुषोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2029956, "chapter_id": 1654, "verse_number": "३-२९२-३८x", "content_sanskrit": "राम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2029957, "chapter_id": 1654, "verse_number": "३-२९२-३८", "content_sanskrit": "अभिवादयेत्वां राजेन्द्र यदि त्वं जनको मम।\nगमिष्यामि पुरीं रम्यामयोध्यां शासनात्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2029958, "chapter_id": 1654, "verse_number": "३-२९२-३९x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2029959, "chapter_id": 1654, "verse_number": "३-२९२-३९", "content_sanskrit": "तमुवाच पिता भूयः प्रहृष्टो भरतर्षभ।\nगच्छायोध्यां प्रशाधि त्वंराम रक्तान्तलोचन।\nसंपूर्णानीहवर्षाणि चतुर्दश महाद्युते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2029960, "chapter_id": 1654, "verse_number": "३-२९२-४०", "content_sanskrit": "ततो देवान्नमस्कृत्य मुहृद्भिरभिनन्दितः।\nमहेन्द्रइव पौलोम्या भार्यया स समेयिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2029961, "chapter_id": 1654, "verse_number": "३-२९२-४१", "content_sanskrit": "ततो वरं ददौ तस्मै ह्यविन्ध्याय परंतपः।\nत्रिजटां चार्थमानाभ्यां योजयामास राक्षसीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2029962, "chapter_id": 1654, "verse_number": "३-२९२-४२", "content_sanskrit": "तमुवाच ततो ब्रह्मा देवैः शक्रषुरोगमैः।\nकौसल्यामातरिष्टांस्ते वरानद्य ददानि कान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2029963, "chapter_id": 1654, "verse_number": "३-२९२-४३", "content_sanskrit": "वव्रेरामः स्थितिं धर्मे शत्रुभिश्चापराजयम्।\nराक्षसैर्निहतानां च वानराणां समुद्भवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2029964, "chapter_id": 1654, "verse_number": "३-२९२-४४", "content_sanskrit": "ततस्ते ब्रह्मणा प्रोक्ते तथेतिवचने तदा।\nसमुत्तस्थुर्महाराज वानरा लब्धचेतसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2029965, "chapter_id": 1654, "verse_number": "३-२९२-४५", "content_sanskrit": "सीता चापि महाभागा वरं हनुमते ददौ।\nरामकीर्त्या समं पुत्र जीवितं ते भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2029966, "chapter_id": 1654, "verse_number": "३-२९२-४६", "content_sanskrit": "दिव्यास्त्वामुपभोगाश्च मत्प्रसादकृताः सदा।\nउपस्थास्यन्ति हनुमन्निति स्म हरिलोचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2029967, "chapter_id": 1654, "verse_number": "३-२९२-४७", "content_sanskrit": "ततस्ते प्रेक्षमाणानां तेपामक्लिष्टकर्मणाम्।\nअन्तर्धानं ययुर्देवाः सर्वे शक्रपुरोगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2029968, "chapter_id": 1654, "verse_number": "३-२९२-४८", "content_sanskrit": "दृष्ट्वा रामं तु जानक्या संगतं शक्रसारथिः।\nउवाच परमप्रीतसुहृन्मध्य इदं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2029969, "chapter_id": 1654, "verse_number": "३-२९२-४९", "content_sanskrit": "देवगन्धर्वयक्षाणां मानुषासुरभोगिनाम्।\nअपनीतं त्वया दुःखमिदं सत्यपराक्रम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2029970, "chapter_id": 1654, "verse_number": "३-२९२-५०", "content_sanskrit": "सदेवासुरगनधर्वा यक्षराक्षसपन्नगाः।\nकथयिष्यन्ति लोकास्त्वां यावद्भूमिर्धरिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2029971, "chapter_id": 1654, "verse_number": "३-२९२-५१", "content_sanskrit": "इत्येवमुक्त्वाऽनुज्ञाप्यरामं शस्त्रभृतांवरम्।\nसंपूज्यापाक्रमत्तेन रथेनादित्यवर्चसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2029972, "chapter_id": 1654, "verse_number": "३-२९२-५२", "content_sanskrit": "ततःसीतां पुरस्कृत्य रामः सौमित्रिणा सह।\nसुग्रीवप्रमुखैश्चैव सहितः सर्ववानरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2029973, "chapter_id": 1654, "verse_number": "३-२९२-५३", "content_sanskrit": "विधाय रक्षां लङ्कायां विभीषणपुरस्कृतः।\nसंततार पुनस्तेन सेतुना मकरालयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2029974, "chapter_id": 1654, "verse_number": "३-२९२-५४", "content_sanskrit": "पुष्पकेण विसानन खेचरेण विराजता।\nकामगेन यथामुख्यैरमात्यैः संवृतो वसी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2029975, "chapter_id": 1654, "verse_number": "३-२९२-५५", "content_sanskrit": "ततस्तीरे समुद्रस्यं यत्रशिश्य स पार्थिवः।\nतत्रैवोवास धर्मात्मा सहितः सर्ववानरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2029976, "chapter_id": 1654, "verse_number": "३-२९२-५६", "content_sanskrit": "अथैनान्राघवः काले समानीयाभिपूज्य च।\nविसर्जयामास तदा रत्नैः संतोष्य सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2029977, "chapter_id": 1654, "verse_number": "३-२९२-५७", "content_sanskrit": "गतेषु वानरेन्द्रेषु गोपुच्छर्क्षेषु तेषु च।\nसुग्रीवसहितो रामः किष्किन्दां पुनरागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2029978, "chapter_id": 1654, "verse_number": "३-२९२-५८", "content_sanskrit": "विभीषणेनानुगतः सुग्रीवसहितस्तदा।\nपुष्पकेण विमानेन वैदेह्या दर्शयन्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2029979, "chapter_id": 1654, "verse_number": "३-२९२-५९", "content_sanskrit": "किष्किन्धां तु समासाद्यरामः प्रहरतांवरः।\nअङ्गदं कृतकर्माणं यौवराज्येऽभ्यषेचयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2029980, "chapter_id": 1654, "verse_number": "३-२९२-६०", "content_sanskrit": "ततस्तैरेव सहितो रामः सौमित्रिणा सह।\nयथागतेन मार्गेण प्रययौ स्वपुरं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2029981, "chapter_id": 1654, "verse_number": "३-२९२-६१", "content_sanskrit": "अयोध्यां स समासाद्यपुरीं राष्ट्रपतिस्ततः।\nभरताय हनूमन्तं दूतं प्रास्थापयद्द्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2029982, "chapter_id": 1654, "verse_number": "३-२९२-६२", "content_sanskrit": "लक्षयित्वेङ्गितं सर्वंप्रियं तस्मै निवेद्य वै।\nवायुपुत्रे पुनः प्राप्ते नन्दिग्राममुपाविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2029983, "chapter_id": 1654, "verse_number": "३-२९२-६३", "content_sanskrit": "सतत्रमलदिग्धाङ्गं भरतं चीरवाससम्।\n`नन्दिग्रामगतंरामः सशत्रुघ्नं सराघवः।\nअग्रतःपादुके कृत्वा ददर्शासीनमासने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2029984, "chapter_id": 1654, "verse_number": "३-२९२-६४", "content_sanskrit": "समेत्यभरतेनाथ शत्रुघ्नेन च वीर्यवान्।\nराघवः सहसौमित्रिर्मुमुदे भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2029985, "chapter_id": 1654, "verse_number": "३-२९२-६५", "content_sanskrit": "ततो भरतशत्रुघ्नौ समेतौ गुरुणा तदा।\nवैदेह्या दर्शनेनोभौ प्रहर्षं समवापतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2029986, "chapter_id": 1654, "verse_number": "३-२९२-६६", "content_sanskrit": "तस्मै तद्भरतो राज्यमागतायातिसत्कृतम्।\nन्यासं निर्यातयामास युक्तः परमया मुदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2029987, "chapter_id": 1654, "verse_number": "३-२९२-६७", "content_sanskrit": "ततस्तं वैष्णवे शूरं नक्षत्रेऽभिजितेऽहनि।\nवसिष्ठो वामदेवश्च सहितावभ्यषिञ्चताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2029988, "chapter_id": 1654, "verse_number": "३-२९२-६८", "content_sanskrit": "सोभिषिक्तः कपिश्रेष्ठं सुग्रीवं ससुहृज्जनम्।\nविभीषणं च पौलस्त्यमन्वजानाद्गृहान्प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2029989, "chapter_id": 1654, "verse_number": "३-२९२-६९", "content_sanskrit": "अभ्यर्च्य विविधै रत्नैः प्रीतियुक्तौ मुदा युतौ।\nसमाधायेतिकर्तव्यं दुःखेन विससर्ज ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2029990, "chapter_id": 1654, "verse_number": "३-२९२-७०", "content_sanskrit": "पुष्पकं च विमानं तत्पूजयित्वा स राघवः।\nप्रादाद्वैश्रवणायैव प्रीत्या स रघुनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2029991, "chapter_id": 1654, "verse_number": "३-२९२-७१", "content_sanskrit": "ततो देवर्षिसहितः सरितं गोमतीमनु।\nशताश्वमेधानाजह्रे जारूथ्यान्स निरर्गलान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2029992, "chapter_id": 1654, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि रामोपाख्यानपर्वणि द्विनवत्यधिकद्विशततमोऽध्यायः ॥ २९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}]