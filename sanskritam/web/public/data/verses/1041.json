[{"id": 2002049, "chapter_id": 1041, "verse_number": "१-४२-०x", "content_sanskrit": "शृङ्ग्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2002050, "chapter_id": 1041, "verse_number": "१-४२-१", "content_sanskrit": "यद्येतत्साहसं तात यदि वा दुष्कृतं कृतम्।\nप्रियं वाप्यप्रियं वा ते वागुक्ता न मृषा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2002051, "chapter_id": 1041, "verse_number": "१-४२-२", "content_sanskrit": "नैवान्यथेदं भविता पितरेष ब्रवीमि ते।\nनाहं मृषा ब्रवीम्येवं स्वैरेष्वपि कुतः शपन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2002052, "chapter_id": 1041, "verse_number": "१-४२-३x", "content_sanskrit": "शमीक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2002053, "chapter_id": 1041, "verse_number": "१-४२-३", "content_sanskrit": "जानाम्युग्रप्रभावं त्वां तात सत्यगिरं तथा।\nनानृतं चोक्तपूर्वं ते नैतन्मिथ्या भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2002054, "chapter_id": 1041, "verse_number": "१-४२-४", "content_sanskrit": "पित्रा पुत्रो वयस्थोऽपि सततं वाच्य एव तु।\nयथा स्याद्गुणसंयुक्तः प्राप्नुयाच्च महद्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2002055, "chapter_id": 1041, "verse_number": "१-४२-५", "content_sanskrit": "किं पुनर्बाल एव त्वं तपसा भावितः सदा।\nवर्धते चेत्प्रभवतां कोपोऽतीव महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2002056, "chapter_id": 1041, "verse_number": "१-४२-६", "content_sanskrit": "उत्सीदेयुरिमे लोकाः क्षणा चास्य प्रतिक्रिया।\nसोऽहं पश्यामि वक्तव्यं त्वयि धर्मभृतां वर।\nपुत्रत्वं बालतां चैव तवावेक्ष्य च साहसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2002057, "chapter_id": 1041, "verse_number": "१-४२-७", "content_sanskrit": "स त्वं शमपरो भूत्वा वन्यमाहारमाचरन्।\nचर क्रोधमिमं हित्वा नैवं धर्मं प्रहास्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2002058, "chapter_id": 1041, "verse_number": "१-४२-८", "content_sanskrit": "क्रोधो हि धर्मं हरति यतीनां दुःखसंचितम्।\nततो धर्मविहीनानां गतिरिष्टा न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2002059, "chapter_id": 1041, "verse_number": "१-४२-९", "content_sanskrit": "शम एव यतीनां हि क्षमिणां सिद्धिकारकः।\nक्षमावतामयं लोकः परश्चैव क्षमावताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2002060, "chapter_id": 1041, "verse_number": "१-४२-१०", "content_sanskrit": "तस्माच्चरेथाः सततं क्षमाशीलो जितेन्द्रियः।\nक्षमया प्राप्स्यसे लोकान्ब्रह्मणः समनन्तरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2002061, "chapter_id": 1041, "verse_number": "१-४२-११", "content_sanskrit": "मया तु शममास्थाय यच्छक्यं कर्तुमद्य वै।\nतत्करिष्याम्यहं तात प्रेपयिष्ये नृपाय वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2002062, "chapter_id": 1041, "verse_number": "१-४२-१२", "content_sanskrit": "मम पुत्रेण शप्तोऽसि बालेनाकृतबुद्धिना।\nममेमां धर्षणां त्वत्तः प्रेक्ष्य राजन्नमर्षिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2002063, "chapter_id": 1041, "verse_number": "१-४२-१३x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2002064, "chapter_id": 1041, "verse_number": "१-४२-१३", "content_sanskrit": "एवमादिश्य शिष्यं स प्रेषयामास सुव्रतः।\nपरिक्षिते नृपतये दयापन्नो महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2002065, "chapter_id": 1041, "verse_number": "१-४२-१४", "content_sanskrit": "संदिश्य कुशलप्रश्नं कार्यवृत्तान्तमेव च।\nशिष्यं गौरमुखं नाम शीलवन्तं समाहितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2002066, "chapter_id": 1041, "verse_number": "१-४२-१५", "content_sanskrit": "सोऽभिगम्य ततः शीघ्रं नरेन्द्रं कुरुवर्धनम्।\nविवेश भवनं राज्ञः पूर्वं द्वास्थैर्निवेदितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2002067, "chapter_id": 1041, "verse_number": "१-४२-१६", "content_sanskrit": "पूजितस्तु नरेन्द्रेण द्विजो गौरमुखस्तदा।\nआचख्यौ च परिश्रान्तो राज्ञः सर्वमशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2002068, "chapter_id": 1041, "verse_number": "१-४२-१७", "content_sanskrit": "शमीकवचनं घोरं यथोक्तं मन्त्रिसन्निधौ।\nशमीको नाम राजेन्द्र वर्तते विषये तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2002069, "chapter_id": 1041, "verse_number": "१-४२-१८", "content_sanskrit": "ऋषिः परमधर्मात्मा दान्तः शान्तो महातपाः।\nतस्य त्वया नरव्याघ्र सर्पः प्राणैर्वियोजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2002070, "chapter_id": 1041, "verse_number": "१-४२-१९", "content_sanskrit": "अवसक्तो धनुष्कोट्या स्कन्धे मौनान्वितस्य च।\nक्षान्तवांस्तव तत्कर्म पुत्रस्तस्य न चक्षमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2002071, "chapter_id": 1041, "verse_number": "१-४२-२०", "content_sanskrit": "तेन शप्तोऽसि राजेन्द्र पितुरज्ञातमद्य वै।\nतक्षकः सप्तरात्रेण मृत्युस्तव भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2002072, "chapter_id": 1041, "verse_number": "१-४२-२१", "content_sanskrit": "तत्र रक्षां कुरुष्वेति पुनः पुनरथाब्रवीत्।\nतदन्यथा न शक्यं च कर्तुं केनचिदप्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2002073, "chapter_id": 1041, "verse_number": "१-४२-२२", "content_sanskrit": "न हि शक्नोति संयन्तुं पुत्रं कोपसमन्वितम्।\nततोऽहं प्रेषितस्तेन तव राजन्हितार्थिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2002074, "chapter_id": 1041, "verse_number": "१-४२-२३x", "content_sanskrit": "सातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2002075, "chapter_id": 1041, "verse_number": "१-४२-२३", "content_sanskrit": "इति श्रुत्वा वचो घोरं स राजा कुरुनन्दनः।\nपर्यतप्यत तत्पापं कृत्वा राजा महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2002076, "chapter_id": 1041, "verse_number": "१-४२-२४", "content_sanskrit": "तं च मौनव्रतं श्रुत्वा वने मुनिवरं तदा।\nभूय एवाभवद्राजा शोकसंतप्तमानसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2002077, "chapter_id": 1041, "verse_number": "१-४२-२५", "content_sanskrit": "अनुक्रोशात्मतां तस्य शमीकस्यावधार्य च।\nपर्यतप्यत भूयोपि कृत्वा तत्किल्बिषं मुनेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2002078, "chapter_id": 1041, "verse_number": "१-४२-२६", "content_sanskrit": "न हि मृत्युं तथा राजा श्रुत्वा वै सोऽन्वतप्यत।\nअशोचदमरप्रख्यो यथा कृत्वेह कर्म तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2002079, "chapter_id": 1041, "verse_number": "१-४२-२७", "content_sanskrit": "ततस्तं प्रेषयामास राजा गौरमुखं तदा।\nभूयः प्रसादं भगवान्करोत्विह ममेति वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2002080, "chapter_id": 1041, "verse_number": "१-४२-२८", "content_sanskrit": "श्रुत्वा तु वचनं राज्ञो मुनिर्गौरमुखस्तदा।\nसमनुज्ञाप्य वेगेन प्रजगामाश्रमं गुरोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2002081, "chapter_id": 1041, "verse_number": "१-४२-२९", "content_sanskrit": "तस्मिंश्च गतमात्रेऽथ राजा गौरमुखे तदा।\nमन्त्रिभिर्मन्त्रयामास सह संविग्नमानसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2002082, "chapter_id": 1041, "verse_number": "१-४२-३०", "content_sanskrit": "संमन्त्र्य मन्त्रिभिश्चैव स तथा मन्त्रतत्त्ववित्।\nप्रासादं कारयामास एकस्तम्भं सुरक्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2002083, "chapter_id": 1041, "verse_number": "१-४२-३१", "content_sanskrit": "रक्षां च विदधे तत्र भिषजश्चौषधानि च।\nब्राह्मणान्मन्त्रसिद्धांश्च सर्वतो वै न्ययोजयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2002084, "chapter_id": 1041, "verse_number": "१-४२-३२", "content_sanskrit": "राजकार्याणि तत्रस्थः सर्वाण्येवाकरोच्च सः।\nमन्त्रिभिः सह धर्मज्ञः समन्तात्परिरक्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2002085, "chapter_id": 1041, "verse_number": "१-४२-३३", "content_sanskrit": "न चैनं कश्चिदारूढं लभते राजसत्तमम्।\nवातोऽपि निश्चरंस्तत्र प्रवेशे विनिवार्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2002086, "chapter_id": 1041, "verse_number": "१-४२-३४", "content_sanskrit": "प्राप्ते च दिवसे तस्मिन्सप्तमे द्विजसत्तमः।\nकाश्यपोऽभ्यागमद्विद्वांस्तं राजानं चिकित्सितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2002087, "chapter_id": 1041, "verse_number": "१-४२-३५", "content_sanskrit": "श्रुतं हि तेन तदभूद्यथा तं राजसत्तमम्।\nतक्षकः पन्नगश्रेष्ठो नेष्यते यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2002088, "chapter_id": 1041, "verse_number": "१-४२-३६", "content_sanskrit": "तं दष्टं पन्नगेन्द्रेण करिष्येऽहमपज्वरम्।\nतत्र मेऽर्थश्च धर्मश्च भवितेति विचिन्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2002089, "chapter_id": 1041, "verse_number": "१-४२-३७", "content_sanskrit": "तं ददर्श स नागेन्द्रस्तक्षकः काश्यपं पथि।\nगच्छन्तमेकमनसं द्विजो भूत्वा वयोऽतिगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2002090, "chapter_id": 1041, "verse_number": "१-४२-३८", "content_sanskrit": "तमब्रवीत्पन्नगेन्द्रः काश्यपं मुनिपुंगवम्।\nक्व भवांस्त्वरितो याति किंच कार्यं चिकीर्षति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2002091, "chapter_id": 1041, "verse_number": "१-४२-३९x", "content_sanskrit": "काश्यप उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2002092, "chapter_id": 1041, "verse_number": "१-४२-३९", "content_sanskrit": "नृपं कुरुकुलोत्पन्नं परिक्षितमरिंदमम्।\nतक्षकः पन्नगश्रेष्ठस्तेजसाऽध्य प्रधक्ष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2002093, "chapter_id": 1041, "verse_number": "१-४२-४०", "content_sanskrit": "तं दष्टं पन्नगेन्द्रेण तेनाग्निसमतेजसम्।\nपाण्डवानां कुलकरं राजानममितौजसम्। १-४२-४oc गच्छामित्वरितं सौम्य सद्यः कर्तुमपज्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2002094, "chapter_id": 1041, "verse_number": "१-४२-४१", "content_sanskrit": "विज्ञातविषविद्योऽहं ब्राह्मणो लोकपूजितः।\nअस्मद्गुरुकटाक्षेण कल्योऽहं विषनाशने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2002095, "chapter_id": 1041, "verse_number": "१-४२-४२x", "content_sanskrit": "तक्षक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2002096, "chapter_id": 1041, "verse_number": "१-४२-४२", "content_sanskrit": "अहं स तक्षको ब्रह्मंस्तं धक्ष्यामि महीपतिम्।\nनिवर्तस्व न शक्तस्त्वं मया दष्टं चिकित्सितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2002097, "chapter_id": 1041, "verse_number": "१-४२-४३x", "content_sanskrit": "काश्यप उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2002098, "chapter_id": 1041, "verse_number": "१-४२-४३", "content_sanskrit": "अहं तं नृपतिं गत्वा त्वया दष्टमपज्वरम्।\nकरिष्यामीति मे बुद्धिर्विद्याबलसमन्विता॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2002099, "chapter_id": 1041, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि आस्तीकपर्वणि द्विचत्वारिंशोऽध्यायः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]