[{"id": 7000274000, "chapter_id": 20274, "verse_number": "१-२८-१", "content_sanskrit": "भीष्म उवाच ।\nपादपानां विधिं ब्रह्मन्यथावद्विस्तराद्वद ।\nविधिना येन कर्त्तव्यं पादपारोपणं बुधैः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000274001, "chapter_id": 20274, "verse_number": "१-२८-२", "content_sanskrit": "ये च लोकाः स्मृता येषां तानिदानीं वदस्व मे ।\nपुलस्त्य उवाच ।\nपादपानां विधिं वक्ष्ये तथैवोद्यानभूमिषु॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000274002, "chapter_id": 20274, "verse_number": "१-२८-३", "content_sanskrit": "तटाकविधिवत्सर्वं समाप्य जगतीश्वर ।\nऋत्विङ्मंडपसंभारमाचार्यं चापि तद्विधं॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000274003, "chapter_id": 20274, "verse_number": "१-२८-४", "content_sanskrit": "पूजयेद्ब्राह्मणांस्तद्वद्धेमवस्त्रानुलेपनैः ।\nसर्वौषध्युदकैः सिक्तान्दध्यक्षतविभूषितान्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000274004, "chapter_id": 20274, "verse_number": "१-२८-५", "content_sanskrit": "वृक्षान्माल्यैरलंकृत्य वासोभिरभिवेष्टयेत् ।\nसूच्या सौवर्णया कार्यं सर्वेषां कर्णवेधनं॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000274005, "chapter_id": 20274, "verse_number": "१-२८-६", "content_sanskrit": "अंजनं चापि दातव्यं तद्वद्धेमशलाकया ।\nफलानि सप्त चाष्टौ वा कालधौतानि कारयेत्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000274006, "chapter_id": 20274, "verse_number": "१-२८-७", "content_sanskrit": "प्रत्येकं सर्ववृक्षाणां वेद्यांतान्यधिवासयेत् ।\nधूपोत्र गुग्गुलुः श्रेष्ठस्ताम्रपात्रेष्वधिष्ठितान्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000274007, "chapter_id": 20274, "verse_number": "१-२८-८", "content_sanskrit": "सप्तधान्यस्थितान्कृत्वा वस्त्रगंधानुलेपनैः ।\nकुंभान्सर्वेषु वृक्षेषु स्थापयित्वावनीश्वर॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000274008, "chapter_id": 20274, "verse_number": "१-२८-९", "content_sanskrit": "पूजयित्वा दिनांते च कृत्वा बलिनिवेदनम् ।\nयथावल्लोकपालानामिंद्रादीनां विधानतः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000274009, "chapter_id": 20274, "verse_number": "१-२८-१०", "content_sanskrit": "वनस्पतेरधिवास एवं कार्यो द्विजातिभिः ।\nततः शुक्लांबरधरान्सौवर्णकृतमेखलान्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000274010, "chapter_id": 20274, "verse_number": "१-२८-११", "content_sanskrit": "सकांस्यदोहां सौवर्णशृंगाभ्यामतिशालिनीं ।\nपयस्विनीं वृक्षमध्यादुत्सृजेद्गामुदङ्मुखीम्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000274011, "chapter_id": 20274, "verse_number": "१-२८-१२", "content_sanskrit": "ततोभिषेकमंत्रेण वाद्यमंगलगीतकैः ।\nऋग्यजुःसाममंत्रैश्च वारुणैरभितस्तदा॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000274012, "chapter_id": 20274, "verse_number": "१-२८-१३", "content_sanskrit": "तैरेव कुंभैः स्नपनं कुर्युर्ब्राह्मणपुंगवाः ।\nस्नातः शुक्लांबरधरो यजमानोभिपूजयेत्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000274013, "chapter_id": 20274, "verse_number": "१-२८-१४", "content_sanskrit": "गोभिर्विभवतः सर्वानृत्विजः ससमाहितान् ।\nहेमसूत्रैः सकटकैरंगुलीयैः पवित्रकैः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000274014, "chapter_id": 20274, "verse_number": "१-२८-१५", "content_sanskrit": "वासोभिः शयनीयैश्च तथोपस्करपादुकैः ।\nक्षीराभिषेचनं कुर्याद्यावद्दिनचतुष्टयम्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000274015, "chapter_id": 20274, "verse_number": "१-२८-१६", "content_sanskrit": "होमश्च सर्पिषा कार्यो यवैः कृष्णतिलैरपि ।\nपलाशसमिधः शस्ताश्चतुर्थेऽह्नि तथोत्सवः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000274016, "chapter_id": 20274, "verse_number": "१-२८-१७", "content_sanskrit": "दक्षिणा च पुनस्तद्वद्देया तत्रापि शक्तितः ।\nयद्यदिष्टतमं किचित्तत्तद्दद्यादमत्सरी॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000274017, "chapter_id": 20274, "verse_number": "१-२८-१८", "content_sanskrit": "आचार्ये द्विगुणं दत्त्वा प्रणिपत्य क्षमापयेत् ।\nअनेन विधिना यस्तु कुर्याद्वृक्षोत्सवं बुधः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000274018, "chapter_id": 20274, "verse_number": "१-२८-१९", "content_sanskrit": "सर्वान्कामानवाप्नोति पदं चानन्तमश्नुते ।\nयश्चैवमपि राजेन्द्र वृक्षं संस्थापयेद्बुधः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000274019, "chapter_id": 20274, "verse_number": "१-२८-२०", "content_sanskrit": "सोपि स्वर्गे वसेद्राजन्यावदिंद्रायुतत्रयम् ।\nभूतान्भव्यांश्च मनुजांस्तारयेद्रोमसंमितान्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000274020, "chapter_id": 20274, "verse_number": "१-२८-२१", "content_sanskrit": "परमां सिद्धिमाप्नोति पुनरावृत्तिदुर्लभाम् ।\nय इदं शृणुयान्नित्यं श्रावयेद्वापि मानवः॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000274021, "chapter_id": 20274, "verse_number": "१-२८-२२", "content_sanskrit": "सोपि संपूज्यते देवैर्ब्रह्मलोके महीयते ।\nअपुत्रस्य च पुत्रित्वं पादपा एव कुर्वते॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000274022, "chapter_id": 20274, "verse_number": "१-२८-२३", "content_sanskrit": "तीर्थेषु पिंडदानादीन्रोपकाणां ददंति ते ।\nयत्नेनापि च राजेंद्र अश्वत्थारोपणं कुरु॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000274023, "chapter_id": 20274, "verse_number": "१-२८-२४", "content_sanskrit": "स ते पुत्रसहस्रस्य कृत्यमेकः करिष्यति ।\nधनी चाश्वत्थवृक्षेण अशोकः शोकनाशनः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000274024, "chapter_id": 20274, "verse_number": "१-२८-२५", "content_sanskrit": "प्लक्षो यज्ञप्रदः प्रोक्तः क्षीरी चायुःप्रदः स्मृतः ।\nजंबुकी कन्यकादात्री भार्यादा दाडिमी तथा॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000274025, "chapter_id": 20274, "verse_number": "१-२८-२६", "content_sanskrit": "अश्वत्थो रोगनाशाय पलाशो ब्रह्मदस्तथा ।\nप्रेतत्वं जायते पुंसो रोपयेद्यो विभीतकम्॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000274026, "chapter_id": 20274, "verse_number": "१-२८-२७", "content_sanskrit": "अंकोले कुलवृद्धिस्तु खादिरेणाप्यरोगिता ।\nनिंबप्ररोहकाणां तु नित्यं तुष्येद्दिवाकरः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000274027, "chapter_id": 20274, "verse_number": "१-२८-२८", "content_sanskrit": "श्रीवृक्षे शंकरो देवः पाटलायां तु पार्वती ।\nशिंशपायामप्सरसः कुंदे गंधर्वसत्तमाः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000274028, "chapter_id": 20274, "verse_number": "१-२८-२९", "content_sanskrit": "तिंतिडीके दासवर्गा वंजुले दस्यवस्तथा ।\nपुण्यप्रदः श्रीप्रदश्च चंदनः पनसस्तथा॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000274029, "chapter_id": 20274, "verse_number": "१-२८-३०", "content_sanskrit": "सौभाग्यदश्चंपकश्च करीरः पारदारिकः ।\nअपत्यनाशकस्तालो बकुलः कुलवर्द्धनः॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000274030, "chapter_id": 20274, "verse_number": "१-२८-३१", "content_sanskrit": "बहुभार्या नारिकेला द्राक्षा सर्वांगसुंदरी ।\nरतिप्रदा तथा कोली केतकी शत्रुनाशिनी॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000274031, "chapter_id": 20274, "verse_number": "१-२८-३२", "content_sanskrit": "एवमादि नगाश्चान्ये ये नोक्तास्तेपि दायकाः ।\nप्रतिष्ठां ते गमिष्यंति यैस्तु वृक्षाः प्ररोपिताः॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]