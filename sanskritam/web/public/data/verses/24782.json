[{"id": 7004782000, "chapter_id": 24782, "verse_number": "६-२४४-१", "content_sanskrit": "पैजवन उवाच ।\nएतान्भेदान्मम ब्रूहि विस्तरेण तपोधन ।\nत्वद्वाक्यामृतपानेन तृषा नैव प्रशाम्यति ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004782001, "chapter_id": 24782, "verse_number": "६-२४४-२", "content_sanskrit": "गालव उवाच ।\nशृणु विस्तरतो भेदान्पुराणोक्तान्वदामि ते ।\nयाञ्छ्रुत्वा मुच्यतेऽवश्यं मनुजः सर्वकिल्बिषात् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004782002, "chapter_id": 24782, "verse_number": "६-२४४-३", "content_sanskrit": "पूर्वं तु केशवः पूज्यो द्वितीयो मधुसूदनः ।\nसंकर्षणस्तृतीयस्तु ततो दामोदरः स्मृतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004782003, "chapter_id": 24782, "verse_number": "६-२४४-४", "content_sanskrit": "पंचमो वासुदेवाख्यः षष्ठः प्रद्युम्नसंज्ञकः ।\nसप्तमो विष्णुरुक्तश्चाष्टमो माधव एव च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004782004, "chapter_id": 24782, "verse_number": "६-२४४-५", "content_sanskrit": "नवमोऽनंतमूर्त्तिश्च दशमः पुरुषोत्तमः ।\nअधोक्षजस्ततः पश्चाद्द्वादशस्तु जनार्दनः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004782005, "chapter_id": 24782, "verse_number": "६-२४४-६", "content_sanskrit": "त्रयोदशस्तु गोविंदश्चतुर्दशस्त्रिविक्रमः ।\nश्रीधरश्च पंचदशो हृषीकेशस्तु षोडशः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004782006, "chapter_id": 24782, "verse_number": "६-२४४-७", "content_sanskrit": "नृसिंहस्तु सप्तदशो विश्वयोनिस्ततः परम् ।\nवामनश्च ततः प्रोक्त स्ततो नारायणः स्मृतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004782007, "chapter_id": 24782, "verse_number": "६-२४४-८", "content_sanskrit": "पुंडरीकाक्ष उक्तस्तु ह्युपेंद्रश्च ततः परम् ।\nहरिस्त्रयोविंशतिमः कृष्णश्चांत्य उदाहृतः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004782008, "chapter_id": 24782, "verse_number": "६-२४४-९", "content_sanskrit": "शालिग्रामस्य भेदांश्च मयोक्तास्तव शूद्रज ।\nमूर्तिभेदास्तथा प्रोक्ता एत एव महाधन ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004782009, "chapter_id": 24782, "verse_number": "६-२४४-१०", "content_sanskrit": "मूर्त्तयस्तिथिनान्म्यः स्युरेकादश्यः सदैव हि ।\nसंवत्सरेण पूज्यंते चतुर्विंश तिमूर्तयः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004782010, "chapter_id": 24782, "verse_number": "६-२४४-११", "content_sanskrit": "देवावताराश्च तथा चतुर्विंशतिसंख्यकाः ।\nमासा मार्गशिराद्याश्च मासार्द्धाः पक्षसंज्ञकाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004782011, "chapter_id": 24782, "verse_number": "६-२४४-१२", "content_sanskrit": "अधीशसहितान्नित्यं पूजयन्भक्तिमान्भवेत् ।\nचतुर्विंशतिसंज्ञं च चतुष्टयमुदाहृतम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004782012, "chapter_id": 24782, "verse_number": "६-२४४-१३", "content_sanskrit": "एतच्चतुष्टयं नृणां धर्मकामार्थमोक्षदम् ।\nयः शृणोति नरो भक्त्तया पठेद्वापि समाहितः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004782013, "chapter_id": 24782, "verse_number": "६-२४४-१४", "content_sanskrit": "भूतसर्गस्य गोप्ताऽसौ हरिस्तस्य प्रसीदति ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004782014, "chapter_id": 24782, "verse_number": "६-२४४-१५", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां षष्ठे नागरखण्डे हाटकेश्वरक्षेत्रमाहात्म्य शेषशाय्युपाख्याने ब्रह्मनारदसंवादे चातुर्मास्यमाहात्म्ये शालिग्रामशिलासुमूर्त्त्युत्पत्तिवर्णनंनाम चतुश्चत्वारिंशदुत्तरद्वि शततमोध्यायः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]