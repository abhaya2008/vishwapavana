[{"id": 2074793, "chapter_id": 2580, "verse_number": "१२-८५-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2074794, "chapter_id": 2580, "verse_number": "१२-८५-१", "content_sanskrit": "कथंस्विदिह राजेन्द्र पालयन्पार्थिवः प्रजाः।\nप्रैति धर्मं विशेषेण कीर्तिमाप्नोति शाश्वतीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2074795, "chapter_id": 2580, "verse_number": "१२-८५-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2074796, "chapter_id": 2580, "verse_number": "१२-८५-२", "content_sanskrit": "व्यवहारेण शुद्धेन प्रजापालनतत्परः।\nप्राप्य धर्मं च कीर्ति च लोकानाप्नोत्यसौ शुचिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2074797, "chapter_id": 2580, "verse_number": "१२-८५-३x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2074798, "chapter_id": 2580, "verse_number": "१२-८५-३", "content_sanskrit": "कीदृशव्यवहारं तु कैश्च व्यवहरेन्नृपः।\nएतत्पृष्टो महाप्राज्ञ यथावद्वक्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2074799, "chapter_id": 2580, "verse_number": "१२-८५-४", "content_sanskrit": "ये चैव पूर्वकथिता गुणास्ते पुरुषं प्रति।\nनैकस्मिन्पुरुषे ह्येते विद्यन्त इति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2074800, "chapter_id": 2580, "verse_number": "१२-८५-५x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2074801, "chapter_id": 2580, "verse_number": "१२-८५-५", "content_sanskrit": "एवमेतन्महाप्राज्ञ यथा वदसि बुद्धिमन्।\nदुर्लभः पुरुषः कश्चिदेभिर्युक्तो गुणैः शुभैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2074802, "chapter_id": 2580, "verse_number": "१२-८५-६", "content_sanskrit": "किंतु संक्षेपतः शीलं प्रयत्नेनेह दुर्लभम्।\nवक्ष्यामि तु यथाऽमात्यान्यादृशांश्च करिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2074803, "chapter_id": 2580, "verse_number": "१२-८५-७", "content_sanskrit": "चतुरो ब्राह्मणान्वैद्यान्प्रगल्भान्स्नातकाञ्शुचीन्।\nक्षत्रियान्दश चाष्टौ च बलिनः शस्त्रपाणिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2074804, "chapter_id": 2580, "verse_number": "१२-८५-८", "content_sanskrit": "वैश्यान्वित्तेन संपन्नानेकविंशतिसङ्ख्यया।\nत्रींश्च शूद्रान्विनीतांश्च शुचीन्कर्मणि पूर्वके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2074805, "chapter_id": 2580, "verse_number": "१२-८५-९", "content_sanskrit": "अष्टाभिश्च गुणैर्युक्तं सूतं पौराणिकं तथा।\nपञ्चाशद्वर्षवयसं प्रगल्भमनसूयकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2074806, "chapter_id": 2580, "verse_number": "१२-८५-१०", "content_sanskrit": "श्रुतिस्मृतिसमायुक्तं विनीतं समदर्शिनम्।\nकार्ये विवदमानानां शक्तमर्थेष्वलोलुपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2074807, "chapter_id": 2580, "verse_number": "१२-८५-११", "content_sanskrit": "वर्जितं चैव व्यसनैः सुघोरैः सप्तभिर्भृशम्।\nअष्टानां मन्त्रिणां मध्ये मन्त्रं राजोपधारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2074808, "chapter_id": 2580, "verse_number": "१२-८५-१२", "content_sanskrit": "ततः संप्रेषयेद्राष्ट्रे राष्ट्रीयाय च दर्शयेत्।\nअनेन व्यवहारेण द्रष्टव्यास्ते प्रजाः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2074809, "chapter_id": 2580, "verse_number": "१२-८५-१३", "content_sanskrit": "न चापि गूढं द्रव्यं ते ग्राह्यं कार्योपघातकम्।\nकार्ये खलु विपन्ने त्वां यो धर्मस्तं च पीडयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2074810, "chapter_id": 2580, "verse_number": "१२-८५-१४", "content_sanskrit": "विद्रवेच्चैव राष्ट्रं ते श्येनात्पक्षिगणा इव।\nपरिस्रवेच्च सततं नौर्विशीर्णेव सागरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2074811, "chapter_id": 2580, "verse_number": "१२-८५-१५", "content_sanskrit": "प्रजाः पालयतोऽसम्यगधर्मेणेह भूपतेः।\nहार्दं भयं संभवति स्वर्गश्चस्य विरुध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2074812, "chapter_id": 2580, "verse_number": "१२-८५-१६", "content_sanskrit": "अथ यो धर्मतः पाति राजाऽमात्योऽथवाऽऽत्मजः।\nधर्मासने सन्नियुक्तो धर्ममूले नरर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2074813, "chapter_id": 2580, "verse_number": "१२-८५-१७", "content_sanskrit": "`स्वर्गं याति महीपालो नियुक्तैः सचिवैः सह।\nकार्येष्वधिकृताः सम्यगकुर्वन्तो नृपानुगाः।\nआत्मानं पुरतः कृत्वा यान्त्यधः सह पार्थिवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2074814, "chapter_id": 2580, "verse_number": "१२-८५-१८", "content_sanskrit": "बलात्कृतानां वलिभिः कृपणं बहुजल्पताम्।\nनाथो वै भूमिपो नित्यमनाथानां नृणां भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2074815, "chapter_id": 2580, "verse_number": "१२-८५-१९", "content_sanskrit": "ततः साक्षिबलं साधु द्वैधवादकृतं भवेत्।\nअसाक्षिकमनाथं वा परीक्ष्यं तद्विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2074816, "chapter_id": 2580, "verse_number": "१२-८५-२०", "content_sanskrit": "अपराधानुरूपं च दण्डं पापेषु धारयेत्।\nवियोजयेद्धनैर्ऋद्धानधनानथ बन्धनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2074817, "chapter_id": 2580, "verse_number": "१२-८५-२१", "content_sanskrit": "विनयेच्चापि दुर्वृत्तान्प्रहारैरपि पार्थिवः।\nसान्त्वेनोपप्रदानेन शिष्टांश्च परिपालयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2074818, "chapter_id": 2580, "verse_number": "१२-८५-२२", "content_sanskrit": "राज्ञो वधं चिकीर्षेद्यस्तस्य चित्रो वधो भवेत्।\nआदीपकस्य स्तेनस्य वर्णसंकरिकस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2074819, "chapter_id": 2580, "verse_number": "१२-८५-२३", "content_sanskrit": "सम्यक्प्रणयतो दण्डं भूमिपस्य विशांपते।\nयुक्तस्य वा नास्त्यधर्मो धर्म एव हि शाश्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2074820, "chapter_id": 2580, "verse_number": "१२-८५-२४", "content_sanskrit": "कामकारेण दण्डं तु यः कुर्यादविचक्षणः।\nस इहाकीर्तिसंयुक्तो मृतो नरकमृच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2074821, "chapter_id": 2580, "verse_number": "१२-८५-२५", "content_sanskrit": "न परस्य प्रवादेन परेषां दण्डमर्पयेत्।\nआगमानुगमं कृत्वा बध्नीयान्मोक्षयीत वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2074822, "chapter_id": 2580, "verse_number": "१२-८५-२६", "content_sanskrit": "न तु हन्यान्नृपो जातु दूतं कस्यांचिदापदि।\nदूतस्य हन्ता निरयमाविशेत्सचिवैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2074823, "chapter_id": 2580, "verse_number": "१२-८५-२७", "content_sanskrit": "यथोक्तवादिनं दूतं क्षत्रधर्मरतो नृपः।\nयो हन्यात्पितरस्तस्य भ्रूणहत्यामवाप्नुयुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2074824, "chapter_id": 2580, "verse_number": "१२-८५-२८", "content_sanskrit": "कुलीनः शीलसंपन्नो वाग्मी दक्षः प्रियंवदः।\nयथोक्तवादीस्मृतिमान्दूतः स्यात्सप्तभिर्गुणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2074825, "chapter_id": 2580, "verse_number": "१२-८५-२९", "content_sanskrit": "एतैरेव गुणैर्युक्तः प्रतीहारोऽस्य रक्षिता।\nशिरोरक्षश्च भवति गुणैरेतैः समन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2074826, "chapter_id": 2580, "verse_number": "१२-८५-३०", "content_sanskrit": "धर्मशास्त्रार्थतत्त्वज्ञः सांधिविग्रहिको भवेत्।\nमतिमान्धृतिमान्ह्रीमान्रहस्यविनिगूहिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2074827, "chapter_id": 2580, "verse_number": "१२-८५-३१", "content_sanskrit": "कुलीनः सत्वसंपन्नः शुक्लोऽमात्यः प्रशस्यते।\nएतैरेव गुणैर्युक्तस्तथा सेनापतिर्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2074828, "chapter_id": 2580, "verse_number": "१२-८५-३२", "content_sanskrit": "व्यूहयन्त्रायुधानां च तत्त्वज्ञो विक्रमान्वितः।\nवर्षशीतोष्णवातानां सहिष्णुः पररन्ध्रवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2074829, "chapter_id": 2580, "verse_number": "१२-८५-३३", "content_sanskrit": "विश्वासयेत्परांश्चैव विश्वसेच्च न कस्यचित्।\nपुत्रेष्वपि हि राजेन्द्र विश्वासो न प्रशस्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2074830, "chapter_id": 2580, "verse_number": "१२-८५-३४", "content_sanskrit": "एतच्छास्त्रार्थतत्त्वं तु मयाऽऽख्यातं तवानघ।\nअविश्वासो नरेन्द्राणां गुह्यं परममुच्यते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2074831, "chapter_id": 2580, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि पञ्चाशीतितमोऽध्यायः॥ ८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]