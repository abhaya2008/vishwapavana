[{"id": 6000242000, "chapter_id": 10242, "verse_number": null, "content_sanskrit": "अथ षट्चत्वारिंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000242001, "chapter_id": 10242, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_046/BhP_10.046.001.m4a", "display_order": 2}, {"id": 6000242002, "chapter_id": 10242, "verse_number": "१०-४६-१", "content_sanskrit": "ततस्ताः कृष्णसन्देशैर्व्यपेतविरहामयाः।\nउद्धवं पूजयाञ्चक्रुर्ज्ञात्वा स्निग्धमधोक्षजे॥ १०/४६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_046/BhP_10.046.002.m4a", "display_order": 3, "topics": [{"text": "उद्धवकृतं गोपीस्तवनम्", "range": "१–११"}]}, {"id": 6000242003, "chapter_id": 10242, "verse_number": "१०-४६-२", "content_sanskrit": "उवास कतिचिन्मासान् गोपीनां विनुदन् शुचः।\nकृष्णलीलाकथा गायन् रमयामास गोकुलम्॥ १०/४६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_046/BhP_10.046.003.m4a", "display_order": 4}, {"id": 6000242004, "chapter_id": 10242, "verse_number": "१०-४६-३", "content_sanskrit": "यावन्त्यहानि नन्दस्य व्रजेऽवात्सीत् स उद्धवः।\nव्रजौकसां क्षणप्रायाण्यासन् कृष्णस्य वार्तया॥ १०/४६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_046/BhP_10.046.004.m4a", "display_order": 5}, {"id": 6000242005, "chapter_id": 10242, "verse_number": "१०-४६-४", "content_sanskrit": "सरिद्वनगिरिद्रोणीर्वीक्षन् कुसुमितान् द्रुमान्।\nकृष्णं संस्मारयन् रेमे हरिदासो व्रजौकसाम्॥ १०/४६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_046/BhP_10.046.005.m4a", "display_order": 6}, {"id": 6000242006, "chapter_id": 10242, "verse_number": "१०-४६-५", "content_sanskrit": "दृष्ट्वैवमादि गोपीनां कृष्णावेशात्मविक्लवम्।\nउद्धवः परमप्रीतस्ता नमस्यन्निदं जगौ॥ १०/४६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_046/BhP_10.046.006.m4a", "display_order": 7}, {"id": 6000242007, "chapter_id": 10242, "verse_number": null, "content_sanskrit": "उद्धव उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_046/BhP_10.046.007.m4a", "display_order": 8}, {"id": 6000242008, "chapter_id": 10242, "verse_number": "१०-४६-६", "content_sanskrit": "एताः परं तनुभृतां भुवि गोपवध्वो गोविन्द एवमखिलात्मनि रूढभावाः।\nवाञ्छन्ति यद् भवधियो मुनयो वयं च किं ब्रह्मजन्मभिरनन्तकथा न यत्र॥ १०/४६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_046/BhP_10.046.008.m4a", "display_order": 9}, {"id": 6000242009, "chapter_id": 10242, "verse_number": "१०-४६-७", "content_sanskrit": "क्‍वेमाः स्‍त्रियो वनचरा व्यभिचारशीलाः कृष्णे क्‍व चैष परमात्मनि रूढभावः।\nनन्वीश्वरोऽनुभजतोऽविदुषोऽपि साक्षाच्छ्रेयस्तनोत्यगदराज इवोपयुक्तः॥ १०/४६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_046/BhP_10.046.009.m4a", "display_order": 10}, {"id": 6000242010, "chapter_id": 10242, "verse_number": "१०-४६-८", "content_sanskrit": "नायं श्रियो ननु नितान्तरतेः प्रसादः स्वर्योषितां च ललिताङ्गरुचां कुतोऽन्याः।\nरासोत्सवेऽस्य भुजदण्डगृहीतकण्ठलब्धाशिषां य उदगाद् व्रजवल्लवीनाम्॥ १०/४६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_046/BhP_10.046.010.m4a", "display_order": 11}, {"id": 6000242011, "chapter_id": 10242, "verse_number": "१०-४६-९", "content_sanskrit": "आसामहो चरणरेणुजुषामहं स्यां वृन्दावने किमपि गुल्मलतौषधीनाम्।\nया दुस्त्यजं स्वजनमार्यपथं च हित्वा भेजुर्मुकुन्दपदवीं श्रुतिभिर्विमृग्याम्॥ १०/४६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_046/BhP_10.046.011.m4a", "display_order": 12}, {"id": 6000242012, "chapter_id": 10242, "verse_number": "१०-४६-१०", "content_sanskrit": "या वै श्रियाऽर्चितमजादिभिराप्तकामैर्योगेश्वरैरपि यदात्मनि रासगोष्ठ्याम्।\nकृष्णस्य तद्भगवतश्चरणारविन्दं न्यस्य स्तनेषु विजहुः परिरभ्य तापम्॥ १०/४६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_046/BhP_10.046.012.m4a", "display_order": 13}, {"id": 6000242013, "chapter_id": 10242, "verse_number": "१०-४६-११", "content_sanskrit": "वन्दे नन्दव्रजस्‍त्रीणां पादरेणुमभीक्ष्णशः।\nयासां हरिकथोद्गीतं पुनाति भुवनत्रयम्॥ १०/४६/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_046/BhP_10.046.013.m4a", "display_order": 14}, {"id": 6000242014, "chapter_id": 10242, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_046/BhP_10.046.014.m4a", "display_order": 15}, {"id": 6000242015, "chapter_id": 10242, "verse_number": "१०-४६-१२", "content_sanskrit": "अथ गोपीरनुज्ञाप्य यशोदां नन्दमेव च।\nगोपानामन्त्र्य दाशार्हो यास्यन्नारुरुहे रथम्॥ १०/४६/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_046/BhP_10.046.015.m4a", "display_order": 16, "topics": [{"text": "उद्धवस्य मधुरागमनञ्च", "range": "१२–१७"}]}, {"id": 6000242016, "chapter_id": 10242, "verse_number": "१०-४६-१३", "content_sanskrit": "तं निर्गतं समासाद्य नानोपायनपाणयः।\nनन्दादयोऽनुरागेण प्रावोचन्नश्रुलोचनाः॥ १०/४६/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_046/BhP_10.046.016.m4a", "display_order": 17}, {"id": 6000242017, "chapter_id": 10242, "verse_number": "१०-४६-१४", "content_sanskrit": "मनसो वृत्तयो नः स्युः कृष्णपादाम्बुजाश्रयाः।\nवाचोऽभिधायिनीर्नाम्नां कायस्तत्प्रवणादिषु॥ १०/४६/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_046/BhP_10.046.017.m4a", "display_order": 18}, {"id": 6000242018, "chapter_id": 10242, "verse_number": "१०-४६-१५", "content_sanskrit": "कर्मभिर्भ्राम्यमाणानां यत्र क्‍वापीश्वरेच्छया।\nमङ्गलाचरितैर्दानै रतिर्नः कृष्ण ईश्वरे॥ १०/४६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_046/BhP_10.046.018.m4a", "display_order": 19}, {"id": 6000242019, "chapter_id": 10242, "verse_number": "१०-४६-१६", "content_sanskrit": "एवं सभाजितो गोपैः कृष्णभक्त्या नराधिप।\nउद्धवः पुनरागच्छन्मधुरां कृष्णपालिताम्॥ १०/४६/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_046/BhP_10.046.019.m4a", "display_order": 20}, {"id": 6000242020, "chapter_id": 10242, "verse_number": "१०-४६-१७", "content_sanskrit": "कृष्णाय प्रणिपत्याह भक्त्युद्रेकं व्रजौकसाम्।\nवासुदेवाय रामाय राज्ञे चोपायनान्यदात्॥ १०/४६/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_046/BhP_10.046.020.m4a", "display_order": 21}, {"id": 6000242021, "chapter_id": 10242, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे षट्चत्वारिंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]