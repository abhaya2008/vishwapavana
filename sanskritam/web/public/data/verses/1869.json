[{"id": 2039467, "chapter_id": 1869, "verse_number": "५-११४-०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2039468, "chapter_id": 1869, "verse_number": "५-११४-१", "content_sanskrit": "अथाह गालवं दीनं सुपर्णः पततां वरः।\nनिर्मितं वह्निना भूमौ वायुना शोधितं तथा।\nयस्माद्धिरण्मयं सर्वं हिरण्यं तेन चोच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2039469, "chapter_id": 1869, "verse_number": "५-११४-२", "content_sanskrit": "धत्ते धारयते चेदमतस्मात्कारणाद्धनम् ।\nतदेतत्रिषु लोकेषु धनं तिष्ठति शाश्वतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2039470, "chapter_id": 1869, "verse_number": "५-११४-३", "content_sanskrit": "नित्यं प्रोष्ठपदाभ्यां च शुक्रे धनपतौ तथा।\nमनुष्येभ्यः समादत्ते शुक्रश्चित्तार्जितं धनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2039471, "chapter_id": 1869, "verse_number": "५-११४-४", "content_sanskrit": "अजैकपादहिर्बुध्न्यौ रक्ष्येते धनदेन च।\nएवं न शक्यते लब्धुमलब्धव्यं द्विजर्षभ ।\nऋते च धनमश्वानां नावाप्तिर्विद्यते तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2039472, "chapter_id": 1869, "verse_number": "५-११४-५", "content_sanskrit": "स त्वं याचात्र राजानं कंचिद्राजर्षिवंशजम् ।\nअपीड्य राजा पौरान्हि यो नौ कुर्यात्कृतार्थिनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2039473, "chapter_id": 1869, "verse_number": "५-११४-६", "content_sanskrit": "अस्ति सोमान्ववाये मे जातः कश्चिन्नृपः सखा ।\nअभिगच्छावहे तं वै तस्यास्ति विभवो भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2039474, "chapter_id": 1869, "verse_number": "५-११४-७", "content_sanskrit": "ययातिर्नाम राजर्षिर्नोहुषः सत्यविक्रमः ।\nस दास्यति मया चोक्तो भवता चार्थितः स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2039475, "chapter_id": 1869, "verse_number": "५-११४-८", "content_sanskrit": "विभवश्चास्य सुमहानासीद्धनपतेरिव ।\nएवं गुरुधनं विद्वन्दानेनैव विशोधय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2039476, "chapter_id": 1869, "verse_number": "५-११४-९", "content_sanskrit": "तथा तौ कथयन्तौ च चिन्तयन्तौ च यत्क्षमम्।\nप्रतिष्ठाने नरपतिं ययातिं प्रत्युपस्थितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2039477, "chapter_id": 1869, "verse_number": "५-११४-१०", "content_sanskrit": "प्रतिगृह्य च सत्कारैरर्घ्यपाद्यादिकं वरम् ।\nपृष्टश्चागमने हेतुमुवाच विनतासुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2039478, "chapter_id": 1869, "verse_number": "५-११४-११", "content_sanskrit": "अयं मे नाहुष सखा गालवस्तपसो निधिः ।\nविश्वामित्रस्य शिष्योऽभूद्वर्षाण्ययुतशो नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2039479, "chapter_id": 1869, "verse_number": "५-११४-१२", "content_sanskrit": "सोऽयं तेनाभ्यनुज्ञात उपकारेप्सया द्विजः।\nतमाह भगवान्किं ते ददानि गुरुदक्षिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2039480, "chapter_id": 1869, "verse_number": "५-११४-१३", "content_sanskrit": "असकृत्तेन चोक्तेन किंचिदागतमन्युना ।\nअयमुक्तः प्रयच्छेति जानता विभवं लघु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2039481, "chapter_id": 1869, "verse_number": "५-११४-१४", "content_sanskrit": "एकतःश्यामकर्णानां शुभ्राणां शुद्धजन्मनाम् ।\nअष्टौ शतानि मे देहि हयानां चन्द्रवर्चसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2039482, "chapter_id": 1869, "verse_number": "५-११४-१५", "content_sanskrit": "गुर्वर्थो दीयतामेव यदि गालव मन्यसे ।\nइत्येवमाह सक्रोधो विश्वामित्रस्तपोधनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2039483, "chapter_id": 1869, "verse_number": "५-११४-१६", "content_sanskrit": "सोऽयं शोकेन महता तप्यमानो द्विजर्षभः ।\nअशक्तः प्रतिकर्तुं तद्भवन्तं शरणं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2039484, "chapter_id": 1869, "verse_number": "५-११४-१७", "content_sanskrit": "प्रतिगृह्य नरव्याघ्र त्वत्तो भिक्षां गतव्यथः ।\nकृत्वाऽऽपवर्गं गुरवे चरिष्यति महत्तपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2039485, "chapter_id": 1869, "verse_number": "५-११४-१८", "content_sanskrit": "तपसः संविभागेन भवन्तमपि योक्ष्यते।\nस्वेन राजर्षितपसा पूर्णं त्वां पूरयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2039486, "chapter_id": 1869, "verse_number": "५-११४-१९", "content_sanskrit": "यावन्ति रोमाणि हये भवन्तीह नरेश्वर ।\nतावन्तो वाजिनो लोकान्प्राप्नुवन्ति महीपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2039487, "chapter_id": 1869, "verse_number": "५-११४-२०", "content_sanskrit": "पात्रं प्रतिग्रहस्यायं दातुं पात्रं तथा भवान् ।\nशङ्खे क्षीरमिवासक्तं भवत्वेतत्तथोपमम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2039488, "chapter_id": 1869, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि चतुर्दशाधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]