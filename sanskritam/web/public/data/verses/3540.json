[{"id": 2117984, "chapter_id": 3540, "verse_number": "", "content_sanskrit": "वैशम्पयानः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2117985, "chapter_id": 3540, "verse_number": "१", "content_sanskrit": "सोऽपरान्तेषु तीर्थानि पुण्यान्यायतनानि च ।\nसर्वाणि चानुपूर्व्येण जगामामितविक्रमः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2117986, "chapter_id": 3540, "verse_number": "२", "content_sanskrit": "समुद्रे पश्चिमे यानि तीर्थान्यायतनानि च ।\nतानि गत्वा स सर्वाणि प्रभासमुपजग्मिवान् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2117987, "chapter_id": 3540, "verse_number": "३", "content_sanskrit": "चिन्तयामास रात्रौ तु गदेन कथिताः कथाः ।\nसुभद्रायाश्च माधुर्यरूपसम्पद्गुणानि च \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2117988, "chapter_id": 3540, "verse_number": "४", "content_sanskrit": "प्राप्तुं तां चिन्तयामास कोऽत्रोपायो भवेदिति ।\nवेषवैकृतमापन्नः परिव्राजकरूपधृक्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2117989, "chapter_id": 3540, "verse_number": "५", "content_sanskrit": "कुकुरान्धकवृष्णीनामज्ञातो वेषधारणात् ।\nभ्रममाणश्चरन् भैक्षं परिव्राजकवेषधृक् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2117990, "chapter_id": 3540, "verse_number": "६", "content_sanskrit": "येन केनाप्युपायेन प्रविश्य च गृहं महत् ।\nदृष्ट्वा सुभद्रां कृष्णस्य भगिनीमेकसुन्दरीम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2117991, "chapter_id": 3540, "verse_number": "७", "content_sanskrit": "वासुदेवमतं ज्ञात्वा करिष्यामि हितं शुभम् ।\nएवं विनिश्चयं कृत्वा दीक्षितो वै तदाऽभवत् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2117992, "chapter_id": 3540, "verse_number": "८", "content_sanskrit": "त्रिदण्डी मुण्डितः कुण्डी अक्षमालाङ्गुलीयकः ।\nयोगभारवहः पार्थो वटवृक्षस्य कोटरम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2117993, "chapter_id": 3540, "verse_number": "९", "content_sanskrit": "प्रविशन्नेव बीभत्सुश्चिन्तयामास केशवम् ।\nकेशवश्चिन्तितं ज्ञात्वा दिव्यज्ञानेन दृष्टवान्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2117994, "chapter_id": 3540, "verse_number": "१०", "content_sanskrit": "शयानः शयने धन्ये सत्यभामासहायवान् ।\nकेशवः सहसा राजन् जहास च ननन्द च \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2117995, "chapter_id": 3540, "verse_number": "११", "content_sanskrit": "पुनः पुनः सत्यभामा चाब्रवीत् पुरुषोत्तमम् ।\nभगवंश्चिन्तयाऽऽविष्टः शयने शयितः सुखम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2117996, "chapter_id": 3540, "verse_number": "१२", "content_sanskrit": "भवान् बहुप्रकारेण जहास च पुनःपुनः ।\nश्रोतव्यं यदि वा कृष्ण प्रसादो यदि चेन्मयि ।\nवक्तुमर्हसि लोकेश तच्छ्रोतुं कामये ह्यहम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2117997, "chapter_id": 3540, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2117998, "chapter_id": 3540, "verse_number": "१३", "content_sanskrit": "पितृष्वसायाः पुत्रो मे भीमसेनानुजोऽर्जुनः ।\nतीर्थयात्रां गतः पार्थः कारणात् समयात् तदा \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2117999, "chapter_id": 3540, "verse_number": "१४", "content_sanskrit": "तीर्थयात्रासमाप्तौ तु निवृत्तो निशि भारतः ।\nसुभद्रां चिन्तयानस्तु तदर्थे चापि मां पुनः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2118000, "chapter_id": 3540, "verse_number": "१५", "content_sanskrit": "चिन्तयन्नेव तां भद्रे यतिरूपधरोऽभवत् ।\nयतिरूपप्रतिच्छन्नो द्वारकां प्राप्य माधवीम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2118001, "chapter_id": 3540, "verse_number": "१६", "content_sanskrit": "येन केनाप्युपायेन द्वष्ट्वा तु वरवर्णिनीम् ।\nवासुदेवमतं ज्ञात्वा प्रयतिष्ये मनोरथम् \t॥ १६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2118002, "chapter_id": 3540, "verse_number": "१७", "content_sanskrit": "एवं व्यवसितः पार्थो यतिलिङ्गेन पाण्डवः ।\nछायायां वटवृक्षस्य वृष्टिं वर्षति वासवे\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2118003, "chapter_id": 3540, "verse_number": "१८", "content_sanskrit": "योगभारं वहन्नेव मानसं दुःखमाप्तवान् ।\nईदृशं मां विजानाति माधवो यदि मां स्मरन् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2118004, "chapter_id": 3540, "verse_number": "१९", "content_sanskrit": "किञ्चिद् व्याजमवष्टभ्य यायात् कतिपयैर्जनैः ।\nतद्भावं प्रविचिन्त्यैव हसितं मे सुलोचने ।\nनास्त्यन्यन्मा विशङ्केथाः शपे सत्येन मे शुभे\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2118005, "chapter_id": 3540, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2118006, "chapter_id": 3540, "verse_number": "२०", "content_sanskrit": "भ्रातरं वोऽभिपश्येति सत्यभामामुदीर्य सः ।\nतत उत्थाय शयनात् प्रस्थितो मधुसूदनः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2118007, "chapter_id": 3540, "verse_number": "२१", "content_sanskrit": "प्रभासं समनुप्राप्तं बीभत्सुमपराजितम् ।\nतीर्थान्यनुचरन्तं च शुश्राव मधुसूदनः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2118008, "chapter_id": 3540, "verse_number": "२२", "content_sanskrit": "चारणानां तु वचनादेकाकी स जनार्दनः ।\nततोऽभ्यगच्छत् कौन्तेयमज्ञातोऽन्येन माधवः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2118009, "chapter_id": 3540, "verse_number": "२३", "content_sanskrit": "ददृशाते तदाऽन्योन्यं प्रभासे कृष्णपाण्डवौ ।\nतावन्योन्यं समाश्लिष्य पृष्ट्वा च कुशलं पथि \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2118010, "chapter_id": 3540, "verse_number": "२४", "content_sanskrit": "आस्तां प्रियसखायौ तौ नरनारयणावृषी ।\nततोऽर्जुनं वासुदेवस्तत्कार्यं पर्यपृच्छत ।\nकिमर्थं पाण्डवेमानि तीर्थान्यनुचरस्युत \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2118011, "chapter_id": 3540, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2118012, "chapter_id": 3540, "verse_number": "२५", "content_sanskrit": "तथाऽर्जुनो यथावृत्तं सर्वमाख्यातवांस्तदा ।\nश्रुत्वा चोवाच वार्ष्णेयस्त्वेवमेतदिति प्रभो \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2118013, "chapter_id": 3540, "verse_number": "२६", "content_sanskrit": "तौ विहृत्य यथान्यायं प्रभासे कृष्णपाण्डवौ ।\nमहीधरं रैवतकं वासायैवाभिजग्मतुः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2118014, "chapter_id": 3540, "verse_number": "२७", "content_sanskrit": "पूर्वमेव तु कृष्णस्य वचनात् तु महीधरम् ।\nपुरुषाः समलञ्चक्रुरुपजह्रुश्च भोजनम् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2118015, "chapter_id": 3540, "verse_number": "२८", "content_sanskrit": "प्रतिगृह्यार्जुनः सर्वमुपभुज्य च पाण्डवः ।\nसहैव वासुदेवेन दृष्टवान् नटनर्तकान् \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2118016, "chapter_id": 3540, "verse_number": "२९", "content_sanskrit": "अभ्यनुज्ञातवांत्सर्वानर्चयित्वा तु पाण्डवः ।\nसत्कृतं शयनं दिव्यमभ्यगच्छत् सहाच्युतः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2118017, "chapter_id": 3540, "verse_number": "३०", "content_sanskrit": "स कथां कथयन्नेव निद्रया जनमेजय ।\nकौन्तेयोऽपि हृतस्तस्मिन् शयने सत्यविक्रमः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2118018, "chapter_id": 3540, "verse_number": "३१", "content_sanskrit": "मधुरेण स गीतेन वीणाशब्देन चानघ ।\nप्रबोध्यमानो बुबुधे स्तुतिभिर्मङ्गलैस्तथा \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2118019, "chapter_id": 3540, "verse_number": "३२", "content_sanskrit": "स कृत्वाऽवश्यकार्याणि वार्ष्णेयेनाभिनन्दितः ।\nवार्ष्णेयं समनुज्ञाय ततो वासमरोचयत् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2118020, "chapter_id": 3540, "verse_number": "३३", "content_sanskrit": "तथेत्युक्त्वा वासुदेवो भोजनं वै शशास ह ।\nयतिरूपधरं पार्थं विसृज्य सहसा हरिः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2118021, "chapter_id": 3540, "verse_number": "३४", "content_sanskrit": "रथेन काञ्चनाङ्गेन द्वारकामभिजग्मिवान् ।\nअलङ्कृता द्वारका तु बभूव जनमेजय \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2118022, "chapter_id": 3540, "verse_number": "३५", "content_sanskrit": "दिदृक्षवश्च गोविन्दं द्वारकावासिनो जनाः ।\nनरेन्द्रमार्गमाजग्मुस्तूर्यैः शतसहस्रशः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2118023, "chapter_id": 3540, "verse_number": "३६", "content_sanskrit": "क्षणार्धमपि वार्ष्णेया गोविन्दविरहाक्षमाः ।\nकौतूहलसमाविष्टा भृशमुत्प्रेक्ष्य संस्थिताः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2118024, "chapter_id": 3540, "verse_number": "३७", "content_sanskrit": "अवलोकाय नारीणां सहस्राणि शतानि च ।\nभोजवृष्ण्यन्धकानां च समवायो महानभूत् \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2118025, "chapter_id": 3540, "verse_number": "३८", "content_sanskrit": "स तथा सत्कृतः सर्वैर्भोजवृष्ण्यन्धकात्मजैः ।\nअभिवाद्याभिवाद्यांश्च सर्वैश्च प्रतिनन्दितः \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2118026, "chapter_id": 3540, "verse_number": "३९", "content_sanskrit": "कुमारैः सर्वशो वीरः सत्कारेणाभिवादितः ।\nसमानवयसः सर्वानाश्लिष्य स पुनःपुनः \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2118027, "chapter_id": 3540, "verse_number": "४०", "content_sanskrit": "कृष्णः स्वभवनं रम्यं प्रविवेश महाद्युतिः ।\nप्रवासादागतं देव्यः सर्वाः कृष्णमपूजयन् \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2118028, "chapter_id": 3540, "verse_number": "२१९", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nएकोनविंशत्यधिकद्विशततमोऽध्यायः ॥२१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2118029, "chapter_id": 3540, "verse_number": "५", "content_sanskrit": "॥ इति अर्जुनवनवासपर्वणि पञ्चमोऽध्यायः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]