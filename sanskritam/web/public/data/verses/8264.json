[{"id": 900002388, "chapter_id": 8264, "verse_number": "9.1", "content_sanskrit": "अधीहि भगव इति होपससाद सनत्कुमारं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900002389, "chapter_id": 8264, "verse_number": "9.2", "content_sanskrit": "वाग्वाव नाम्नो भूयसी वाग्वा ऋग्वेदं विज्ञापयति यजुर्वेदं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900002390, "chapter_id": 8264, "verse_number": "9.3", "content_sanskrit": "मनो वाव वाचो भूयो यथा वै द्वे वाऽऽमलके ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900002391, "chapter_id": 8264, "verse_number": "9.4", "content_sanskrit": "सङ्कल्पो वाव मनसो भूयान् यदा वै सङ्कल्पयतेऽथ ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900002392, "chapter_id": 8264, "verse_number": "9.5", "content_sanskrit": "चित्तं वाव सङ्कल्पाद् भूयो यदा चेतयतेऽथ ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900002393, "chapter_id": 8264, "verse_number": "9.6", "content_sanskrit": "ध्यानं वाव चित्ताद्भूयो ध्यायतीव पृथिवी ध्यायतीव ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900002394, "chapter_id": 8264, "verse_number": "9.7", "content_sanskrit": "विज्ञानं वाव ध्यानाद्भूयो विज्ञानेन वा ऋग्वेदं विजानाति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900002395, "chapter_id": 8264, "verse_number": "9.8", "content_sanskrit": "बलं वाव विज्ञानाद्भूयोऽपीह शतं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900002396, "chapter_id": 8264, "verse_number": "9.9", "content_sanskrit": "अन्नं वाव बलाद् भूयस्तस्माद्यद्यपि ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900002397, "chapter_id": 8264, "verse_number": "9.10", "content_sanskrit": "आपो वावान्नाद् भूयस्यस्तस्माद्यदा सुवृष्टिर्न भवति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900002398, "chapter_id": 8264, "verse_number": "9.11", "content_sanskrit": "तेजो वावाद्भ्यो भूयस्तद्वा एतद्वायुमागृह्याकाशमभितपति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900002399, "chapter_id": 8264, "verse_number": "9.12", "content_sanskrit": "आकाशो वाव तेजसो भूयानाकाशे वै ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900002400, "chapter_id": 8264, "verse_number": "9.13", "content_sanskrit": "स्मरो वा आकाशाद्भूयांस्तस्माद्यद्यपि ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900002401, "chapter_id": 8264, "verse_number": "9.14", "content_sanskrit": "आशा वाव स्मराद् भूयस्याशेद्धो वै ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900002402, "chapter_id": 8264, "verse_number": "9.15", "content_sanskrit": "प्राणो वा आशाया भूयान् यथा वा अरा नाभौ समर्पिता ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900002403, "chapter_id": 8264, "verse_number": "9.16", "content_sanskrit": "सर्वे त्वेते दशोत्तराः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900002404, "chapter_id": 8264, "verse_number": "9.17", "content_sanskrit": "अथातः सम्भूतिः परमाद् विद्या विद्यायाः प्राणः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900002405, "chapter_id": 8264, "verse_number": "9.18", "content_sanskrit": "नामादिमारुतान्तेषु देवेष्वेभ्यश्च भेदतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900002406, "chapter_id": 8264, "verse_number": "9.19", "content_sanskrit": "उषादिमारुतान्तेषु समः समगुणोऽपि सन्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900002407, "chapter_id": 8264, "verse_number": "9.20", "content_sanskrit": "नामादिप्राणपर्यन्ताः सप्तम्यर्थाः प्रकीर्तिताः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900002408, "chapter_id": 8264, "verse_number": "9.21", "content_sanskrit": "न ह्यन्यदन्यदित्येव ध्यातं स्यात् पुरुषार्थदम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900002409, "chapter_id": 8264, "verse_number": "9.22", "content_sanskrit": "अचेतनमयोग्यं च तथैवातात्त्विकं क्वचित्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900002410, "chapter_id": 8264, "verse_number": "9.23", "content_sanskrit": "यथाऽज्ञस्यापि राज्ञस्तु भोजनं क्लृप्तमिष्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900002411, "chapter_id": 8264, "verse_number": "9.24", "content_sanskrit": "अभिमानिव्यपदेशस्तु विशेषानुगतिभ्याम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900002412, "chapter_id": 8264, "verse_number": "9.25", "content_sanskrit": "ओषधयः संवदन्ते सोमेन सह राज्ञा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900002413, "chapter_id": 8264, "verse_number": "9.26", "content_sanskrit": "न देवानामति व्रतं शतात्मा न जीवति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 900002414, "chapter_id": 8264, "verse_number": "9.27", "content_sanskrit": "द्यावापृथिवी जनयन्नभिव्रताऽऽप ओषधीर्वनिनानि यज्ञिया", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 900002415, "chapter_id": 8264, "verse_number": "9.28", "content_sanskrit": "अचेतनं चेतनेभ्यो दैवतेभ्यश्च चेतनाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 900002416, "chapter_id": 8264, "verse_number": "9.29", "content_sanskrit": "दुर्घटा शक्तिरपि हि पिशाचानां हि दृश्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 900002417, "chapter_id": 8264, "verse_number": "9.30", "content_sanskrit": "हृदयज्ञो भगवत्तत्त्वज्ञः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 900002418, "chapter_id": 8264, "verse_number": "9.31", "content_sanskrit": "'अस्थिरस्मरणं चित्तं स्थिरसंस्मरण स्मरः' इति शब्दनिर्णये", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 900002419, "chapter_id": 8264, "verse_number": "9.32", "content_sanskrit": "अन्नं ज्ञानरसान्नं च बाह्यमन्नमिति द्विधा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 900002420, "chapter_id": 8264, "verse_number": "9.33", "content_sanskrit": "उत्तरोत्तरमेतद्धि वाय्वन्ताभिमतं सदा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 900002421, "chapter_id": 8264, "verse_number": "9.34", "content_sanskrit": "एष तु वा अतिवदति यः सत्येनातिवदति सोऽहं भगवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 900002422, "chapter_id": 8264, "verse_number": "9.35", "content_sanskrit": "यदा वै विजानात्यथ सत्यं वदति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 900002423, "chapter_id": 8264, "verse_number": "9.36", "content_sanskrit": "यदा वै मनुतेऽथ विजानाति नामत्वा विजानाति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 900002424, "chapter_id": 8264, "verse_number": "9.37", "content_sanskrit": "यदा वै श्रद्दधात्यथ मनुते नाश्रद्दधन्मनुते ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 900002425, "chapter_id": 8264, "verse_number": "9.38", "content_sanskrit": "यदा वै करोत्यथ निस्तिष्ठति नाकृत्वा निस्तिष्ठति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 900002426, "chapter_id": 8264, "verse_number": "9.39", "content_sanskrit": "यो वै भूमा तत्सुखं नाल्पे सुखमस्ति भूमैव सुखं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 900002427, "chapter_id": 8264, "verse_number": "9.40", "content_sanskrit": "यत्र नान्यत् पश्यति नान्यच्छृणोति नान्यद्विजानाति स भूमा..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 900002428, "chapter_id": 8264, "verse_number": "9.41", "content_sanskrit": "स एवाधस्तात् स उपरिष्टात् स पश्चात् स पुरस्तात् ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 900002429, "chapter_id": 8264, "verse_number": "9.42", "content_sanskrit": "तस्य ह वा एतस्यैवं पश्यत एवं मन्वानस्यैवं विजानत ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 900002430, "chapter_id": 8264, "verse_number": "9.43", "content_sanskrit": "न च 'भूमानं भगवो विजिज्ञासे\"..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 900002431, "chapter_id": 8264, "verse_number": "9.44", "content_sanskrit": "आत्मरतिः स्वराडित्यादि ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 900002432, "chapter_id": 8264, "verse_number": "9.45", "content_sanskrit": "नच मुक्तेभ्यः प्राणादिकमुत्पद्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 900002433, "chapter_id": 8264, "verse_number": "9.46", "content_sanskrit": "इदं नामातिसामीप्यात् सर्वं पूर्णगुणत्वतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 900002434, "chapter_id": 8264, "verse_number": "9.47", "content_sanskrit": "स्त्रीगुणाः पुन्गुणाश्चैव नपुंसकगुणा अपि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 900002435, "chapter_id": 8264, "verse_number": "9.48", "content_sanskrit": "गुरोर्विद्याहृतिर्या तु स आहार इति स्मृतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]