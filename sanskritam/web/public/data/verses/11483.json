[{"id": 50012028, "chapter_id": 11483, "verse_number": "1", "content_sanskrit": "तस्यां स पाञ्चजन्यां वै विष्णुमायोपबृंहितः। हर्यश्वसञ्ज्ञानयुतं पुत्रानजनयद् विभुः॥ ६/५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50012029, "chapter_id": 11483, "verse_number": "2", "content_sanskrit": "अपृथग्धर्मशीलास्ते सर्वे दाक्षायणा नृप। पित्रा प्रोक्ताः प्रजासर्गे प्रतीचीं प्रययुर्दिशम्॥ ६/५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50012030, "chapter_id": 11483, "verse_number": "3", "content_sanskrit": "तत्र नारायणसरस्तीर्थं सिन्धुसमुद्रयोः। सङ्गमो यत्र सुमहन्मुनिसिद्धनिषेवितम्॥ ६/५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50012031, "chapter_id": 11483, "verse_number": "4", "content_sanskrit": "तदुपस्पर्शनादेव विनिर्धूतमलाशयाः। धर्मे पारमहंस्ये च प्रोत्पन्नमतयोऽप्युत॥ ६/५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50012032, "chapter_id": 11483, "verse_number": "5", "content_sanskrit": "तेपिरे१ तप एवोग्रं पित्रादेशेन यन्त्रिताः। प्रजाविवृद्धये यत्तान् देवर्षिस्तान् ददर्श ह॥ ६/५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50012033, "chapter_id": 11483, "verse_number": "6", "content_sanskrit": "उवाच वाचं हर्यश्वाः कथं स्रक्ष्यथ वै प्रजाः। अदृष्ट्वाऽन्तं भुवो यूयं बालिशा बत बालकाः॥ ६/५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50012034, "chapter_id": 11483, "verse_number": "7", "content_sanskrit": "तथैकपुरुषं राज्यं बिलं चादृष्टनिर्गमम्। बहुरूपां स्त्रियं चापि पुमांसं पुंश्चलीपतिम्॥ ६/५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50012035, "chapter_id": 11483, "verse_number": "8", "content_sanskrit": "नदीमुभयतोवाहां पञ्चपञ्चाद्भुतं गृहम्। क्वचिद्धंसं चित्रकथं क्षुरान्तं च स्वयं भ्रमिम्॥ ६/५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50012036, "chapter_id": 11483, "verse_number": "9", "content_sanskrit": "कथं स्वपितुरादेशमविद्वांसो विपश्चितः। अनुरूपमविज्ञाय अहो सर्गं करिष्यथ॥ ६/५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50012037, "chapter_id": 11483, "verse_number": "10", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50012038, "chapter_id": 11483, "verse_number": "11", "content_sanskrit": "तन्निशम्याथ हर्यश्वा औत्पत्तिकमनीषया। वाचः कूटं च देवर्षेः स्वयं विममृशुर्धिया॥ ६/५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50012039, "chapter_id": 11483, "verse_number": "12", "content_sanskrit": "भूः क्षेत्रं बीजसञ्ज्ञस्य यदनादिनिबन्धनम्। अदृष्ट्वा तस्य निर्वाणं किमसत्कर्मभिर्भवेत्॥ ६/५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50012040, "chapter_id": 11483, "verse_number": "13", "content_sanskrit": "एक एवेश्वरस्तुर्यो भगवान् स्वाश्रयः परः। तमदृष्ट्वाऽभवं पुंसः किमसत्कर्मभिर्भवेत्॥ ६/५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50012041, "chapter_id": 11483, "verse_number": "14", "content_sanskrit": "पुमान् नापैति यद् गत्वा बिलं स्वर्गगतो यथा। प्रत्यग्धामाविद इह किमसत्कर्मभिर्भवेत्॥ ६/५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50012042, "chapter_id": 11483, "verse_number": "15", "content_sanskrit": "नानारूपाऽऽत्मनो बुद्धिः स्वैरिणीव गुणान्विता। तन्निष्ठामगतस्येह किमसत्कर्मभिर्भवेत्॥ ६/५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50012043, "chapter_id": 11483, "verse_number": "16", "content_sanskrit": "तत्सङ्गभ्रंशितैश्वर्यं संसरन्तं कुभार्यवत्। तद्गतीरबुधस्येह किमसत्कर्मभिर्भवेत्॥ ६/५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50012044, "chapter_id": 11483, "verse_number": "17", "content_sanskrit": "सृष्ट्यप्ययकरीं मायां वेलाकूलान्तवेगिताम्। मत्तस्य तदविज्ञानात् किमसत्कर्मभिर्भवेत्॥ ६/५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50012045, "chapter_id": 11483, "verse_number": "18", "content_sanskrit": "पञ्चविंशतितत्त्वानां पुरुषोऽद्भुतदर्शनः। अध्यात्ममबुधस्येह किमसत्कर्मभिर्भवेत्॥ ६/५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50012046, "chapter_id": 11483, "verse_number": "19", "content_sanskrit": "ऐश्वरं शास्त्रमुत्सृज्य बन्धमोक्षानुदर्शनम्। विविक्तपदमज्ञात्वा किमसत्कर्मभिर्भवेत्॥ ६/५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50012047, "chapter_id": 11483, "verse_number": "20", "content_sanskrit": "कालचक्रं भ्रमिं तीक्ष्णं सर्वं निष्कषयज्जगत्। स्वतन्त्रमबुधस्येह किमसत्कर्मभिर्भवेत्॥ ६/५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50012048, "chapter_id": 11483, "verse_number": "21", "content_sanskrit": "शास्त्रस्य पितुरादेशं यो न वेद निवर्तकम्। कथं तदनुरूपाय गुणविस्रम्भ्युपक्रमेत्॥ ६/५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50012049, "chapter_id": 11483, "verse_number": "22", "content_sanskrit": "इति व्यवसिता राजन् हर्यश्वा एकमेधसः। प्रययुस्तं परिक्रम्य पन्थानमनिवर्तकम्॥ ६/५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50012050, "chapter_id": 11483, "verse_number": "23", "content_sanskrit": "स्वरब्रह्मणि निर्भाते हृषीकेशपदाम्बुजे। अखण्डं चित्तमावेश्य लोकाननुचरन्मुनिः॥ ६/५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50012051, "chapter_id": 11483, "verse_number": "24", "content_sanskrit": "नाशं निशम्य पुत्राणां नारदाच्छीलशालिनाम्। अन्वतप्यत कः शोचन् सुप्रजास्त्वं शुचां पदम्॥ ६/५/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50012052, "chapter_id": 11483, "verse_number": "25", "content_sanskrit": "स भूयः पाञ्चजन्यायामजेन परिसान्त्वितः। पुत्रानजनयद् दक्षः शबळाश्वान् सहस्रिणः॥ ६/५/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50012053, "chapter_id": 11483, "verse_number": "26", "content_sanskrit": "तेऽपि पित्रा समादिष्टाः प्रजासर्गे धृतव्रताः। नारायणसरो जग्मुर्यत्र सिद्धास्तु पूर्वजाः॥ ६/५/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50012054, "chapter_id": 11483, "verse_number": "27", "content_sanskrit": "तदुपस्पर्शनादेव विनिर्धूतमलाशयाः। जपन्तो ब्रह्म परमं तेपुस्तत्र महत् तपः॥ ६/५/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50012055, "chapter_id": 11483, "verse_number": "28", "content_sanskrit": "अब्भक्षाः कतिचिन्मासान् कतिचिद् वायुभोजनाः। आराधयन् मन्त्रमिममभ्यसन्त इडस्पतिम्॥ ६/५/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50012056, "chapter_id": 11483, "verse_number": "29", "content_sanskrit": "ॐ नमो नारायणाय पुरुषाय महात्मने। विशुद्धसत्त्वधिष्ण्याय महाहंसाय धीमहि॥ ६/५/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50012057, "chapter_id": 11483, "verse_number": "30", "content_sanskrit": "इति तानपि राजेन्द्र प्रजासर्गधियो मुनिः। उपेत्य नारदः प्राह वाचः कूटानि पूर्ववत्॥ ६/५/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50012058, "chapter_id": 11483, "verse_number": "31", "content_sanskrit": "दाक्षायणाः संशृणुत गदतो निगमं मम। अन्विच्छतानुपदवीं भ्रातॄणां भ्रातृवत्सलाः॥ ६/५/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50012059, "chapter_id": 11483, "verse_number": "32", "content_sanskrit": "भ्रातॄणां प्रायणं भ्राता योऽनुतिष्ठति धर्मवित्। स पुण्यबन्धुः पुरुषो मरुद्भिः सह मोदते॥ ६/५/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50012060, "chapter_id": 11483, "verse_number": "33", "content_sanskrit": "एतावदुक्त्वा प्रययौ नारदोऽमोघदर्शनः। तेऽपि चान्वगमन्मार्गं भ्रातॄणामेव मारिष॥ ६/५/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50012061, "chapter_id": 11483, "verse_number": "34", "content_sanskrit": "सध्रीचीनं प्रतीचीनं परस्यानुपथं गताः। नाद्यापि ते निवर्तन्ते पश्चिमा यामिनीरिव॥ ६/५/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50012062, "chapter_id": 11483, "verse_number": "35", "content_sanskrit": "एतस्मिन् काल उत्पातान् बहून् पश्यन् प्रजापतिः। पूर्ववन्नारदकृतं पुत्रनाशमथाशृणोत्॥ ६/५/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50012063, "chapter_id": 11483, "verse_number": "36", "content_sanskrit": "चुक्रोध नारदायासौ पुत्रशोकविमूर्च्छितः। देवर्षिमुपलभ्याह रोषाद् विष्फुरिताधरः॥ ६/५/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50012064, "chapter_id": 11483, "verse_number": "37", "content_sanskrit": "दक्ष उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50012065, "chapter_id": 11483, "verse_number": "38", "content_sanskrit": "अहो असाधो साधूनां साधुलिङ्गेन नस्त्वया। असाध्वकार्यर्भकाणां भिक्षोर्मार्गः प्रदर्शितः॥ ६/५/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50012066, "chapter_id": 11483, "verse_number": "39", "content_sanskrit": "ऋणैस्त्रिभिरमुक्तानाममीमांसितकर्मणाम्। विघातः श्रेयसः पाप लोकयोरुभयोः कृतः॥ ६/५/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50012067, "chapter_id": 11483, "verse_number": "40", "content_sanskrit": "एवं त्वं निरनुक्रोशो बालानां मतिभिद्धरेः। पार्षदमध्ये चरसि यशोहानिरपत्रपः॥ ६/५/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50012068, "chapter_id": 11483, "verse_number": "41", "content_sanskrit": "ननु भागवता नित्यं भूतानुग्रहकातराः। ऋते त्वां सौहृदघ्नं वै वैरङ्करमवैरिणाम्॥ ६/५/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50012069, "chapter_id": 11483, "verse_number": "42", "content_sanskrit": "नेत्थं पुंसो विरागः स्यात् त्वया केवलिना विना। मन्यसे यद्युपशमं स्नेहपाशनिकृन्तनम्॥ ६/५/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50012070, "chapter_id": 11483, "verse_number": "43", "content_sanskrit": "नानुभूय न जानाति पुमान् विषयतीक्ष्णताम्। निर्विद्यते स्वयं तस्मान्न तथा भिन्नधीः परैः॥ ६/५/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50012071, "chapter_id": 11483, "verse_number": "44", "content_sanskrit": "यन्नस्त्वं कर्मबद्धानां साधूनां गृहमेधिनाम्। कृतवानसि दुर्मर्षं विप्रियं तच्च मर्षितम्॥ ६/५/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 50012072, "chapter_id": 11483, "verse_number": "45", "content_sanskrit": "तन्तुकृत्तनयानां त्वमभद्रमचरः पुनः। तस्माल्लोकेषु ते मूढ न भवेद् भ्रमतः पदम्॥ ६/५/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 50012073, "chapter_id": 11483, "verse_number": "46", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 50012074, "chapter_id": 11483, "verse_number": "47", "content_sanskrit": "प्रतिजग्राह तद् बाढं नारदः साधुसम्मतः। एतावान् साधुवादो हि तितिक्षेतेश्वरः स्वयम्॥ ६/५/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 50012075, "chapter_id": 11483, "verse_number": "48", "content_sanskrit": "इति श्रीमद्भागवते षष्ठस्कन्धे पञ्चमोऽध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]