[{"id": 7000299000, "chapter_id": 20299, "verse_number": "१-५३-१", "content_sanskrit": "द्विज उवाच ।\nतुलाधारस्य चरितं प्रभावमतुलं प्रभो ।\nवक्तुमर्हस्यशेषेण यदि मय्यस्त्यनुग्रहः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000299001, "chapter_id": 20299, "verse_number": "१-५३-२", "content_sanskrit": "श्रीभगवानुवाच ।\nसत्यभावादलोभाच्च दद्याद्यो वै त्वमत्सरात् ।\nनित्यं यज्ञशतं तस्य सुनिष्पन्नं सुदक्षिणम्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000299002, "chapter_id": 20299, "verse_number": "१-५३-३", "content_sanskrit": "सत्येनोदयते सूरो वाति वातस्तथैव च ।\nन लंघयेत्समुद्रस्तु वेलां कूर्मो धरां तथा॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000299003, "chapter_id": 20299, "verse_number": "१-५३-४", "content_sanskrit": "सत्येन लोकास्तिष्ठंति सर्वे च वसुधाधराः ।\nसत्याद्भ्रष्टोथ यः सत्वोप्यधोवासी भवेद्ध्रुवम्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000299004, "chapter_id": 20299, "verse_number": "१-५३-५", "content_sanskrit": "सत्यवाचिरतोथस्तु सत्यकार्यरतः सदा ।\nसशरीरेण स्वर्लोकमागत्याच्युततां व्रजेत्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000299005, "chapter_id": 20299, "verse_number": "१-५३-६", "content_sanskrit": "सत्येन मुनयः सर्वे मां च गत्वा स्थिरं गताः ।\nसत्याद्युधिष्ठिरो राजा सशरीरो दिवं गतः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000299006, "chapter_id": 20299, "verse_number": "१-५३-७", "content_sanskrit": "सर्वशत्रुगणं जित्वा लोको धर्मेण पालितः ।\nअकरोच्च मखं शुद्धं राजसूयं सुदुर्लभम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000299007, "chapter_id": 20299, "verse_number": "१-५३-८", "content_sanskrit": "चतुरशीतिसहस्राणि ब्राह्मणानां च नित्यशः ।\nभोजयेद्रुक्मपात्रेषु राजोपकरणेषु च॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000299008, "chapter_id": 20299, "verse_number": "१-५३-९", "content_sanskrit": "भोजयित्वोपकरणांस्तेभ्यो दत्वा विसर्जयेत् ।\nयदभीष्टं द्विजातीनामतोन्यद्दापयेद्धनम्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000299009, "chapter_id": 20299, "verse_number": "१-५३-१०", "content_sanskrit": "अदरिद्रं ततो ज्ञात्वा द्विजव्यूहं परित्यजेत् ।\nतथैव स्नातकानां तु सहस्राणि तु षोडश ।\nनित्यं संभोजयेद्राजा सत्येनैव विमत्सरः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000299010, "chapter_id": 20299, "verse_number": "१-५३-११", "content_sanskrit": "अतिष्ठंत गृहे पूर्वं चिरं तस्य जिगीषया ।\nजितं तेन जगत्सर्वं प्राणानुग्रहकारणात्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000299011, "chapter_id": 20299, "verse_number": "१-५३-१२", "content_sanskrit": "सत्येन चासुरो राजा बलिरिंद्रो भविष्यति ।\nपातालस्थस्य तस्यैव भूयस्तिष्ठामि वेश्मनि॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000299012, "chapter_id": 20299, "verse_number": "१-५३-१३", "content_sanskrit": "निरंतरं च तिष्ठामि स्वांते पुण्यैककर्मणः ।\nयद्वा पुरा मया बद्धो दैत्ययोनेर्विमोक्षणात्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000299013, "chapter_id": 20299, "verse_number": "१-५३-१४", "content_sanskrit": "तलं चैवामरत्वं हि शक्रत्वं प्रददाम्यहम् ।\nहरिश्चंद्रो नृपस्सत्यात्सवाहनपरिच्छदः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000299014, "chapter_id": 20299, "verse_number": "१-५३-१५", "content_sanskrit": "स्वशरीरेण शुद्धेन सत्यलोके प्रतिष्ठितः ।\nराजानो बहवश्चान्ये ये च सिद्धा महर्षयः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000299015, "chapter_id": 20299, "verse_number": "१-५३-१६", "content_sanskrit": "ज्ञानिनो यतयश्चैव सर्वे सत्येऽच्युताऽभवन् ।\nतस्मात्सत्यरतो लोके संसारोद्धरणक्षमः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000299016, "chapter_id": 20299, "verse_number": "१-५३-१७", "content_sanskrit": "तुलाधारो महात्मा वै सत्यवाक्ये प्रतिष्ठितः ।\nलोके तत्सदृशो नास्ति सत्यवाक्यस्य कारणात्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000299017, "chapter_id": 20299, "verse_number": "१-५३-१८", "content_sanskrit": "अश्वमेधसहस्रेण सत्यं तु तुलया धृतम् ।\nअश्वमेधसहस्राद्धि सत्यमेव विशिष्यते॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000299018, "chapter_id": 20299, "verse_number": "१-५३-१९", "content_sanskrit": "सर्वं सत्याद्भवेत्साध्यं सत्यो हि दुरतिक्रमः ।\nसत्यवाक्येन सा धेनुर्बहुला स्वर्गगामिनी॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000299019, "chapter_id": 20299, "verse_number": "१-५३-२०", "content_sanskrit": "सर्वं राष्ट्रं समाधाय पुनरावृत्तिदुर्लभा ।\nतथायं सर्वदा साक्षी मृषा नास्ति कदाचन॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000299020, "chapter_id": 20299, "verse_number": "१-५३-२१", "content_sanskrit": "बह्वर्घमल्पमर्घं च क्रयविक्रयणे सुधीः ।\nसत्यवाक्यं प्रशस्तं च विशेषात्साक्षिणो भवेत्॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000299021, "chapter_id": 20299, "verse_number": "१-५३-२२", "content_sanskrit": "साक्षिणः सत्यमुक्त्वा च अक्षयं स्वर्गमाययुः ।\nवावदूकः सभां प्राप्य सत्यं वदति वाक्पतिः॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000299022, "chapter_id": 20299, "verse_number": "१-५३-२३", "content_sanskrit": "स याति ब्रह्मणो गेहं यज्ञैरन्यैश्च दुर्लभम् ।\nसभायां यो वदेत्सत्यमश्वमेधफलं लभेत्॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000299023, "chapter_id": 20299, "verse_number": "१-५३-२४", "content_sanskrit": "लोभाद्द्वेषान्मृषोक्त्वा च रौरवं नरकं व्रजेत् ।\nसर्वसाक्षी तुलाधारो जनानां शूर एव च॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000299024, "chapter_id": 20299, "verse_number": "१-५३-२५", "content_sanskrit": "विशेषाल्लोभसंत्यागान्नाके निर्जरतां व्रजेत् ।\nकश्चिच्छूद्रो महाभागो न लोभे वर्तते क्वचित्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000299025, "chapter_id": 20299, "verse_number": "१-५३-२६", "content_sanskrit": "वृत्तिश्शाकेन दुःखेन तथा शिलोंछतो भृशम् ।\nजर्जरं वस्त्रयुग्मं च करौ पात्रे च सर्वदा॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000299026, "chapter_id": 20299, "verse_number": "१-५३-२७", "content_sanskrit": "सदापि लाभविरहो न परस्वं गृहीतवान् ।\nतस्य जिज्ञासयैवाहं गृहीत्वा वस्त्रयुग्मकम्॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000299027, "chapter_id": 20299, "verse_number": "१-५३-२८", "content_sanskrit": "अवकोटे नदीतीरे स्थितस्संस्थाप्य सादरम् ।\nस दृष्ट्वा वस्त्रयुग्मं तन्न लोभे कुरते मनः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000299028, "chapter_id": 20299, "verse_number": "१-५३-२९", "content_sanskrit": "इतरस्य परिज्ञाय तत्क्षांत्या स्वगृहं ययौ ।\nततो विचिंतयित्वा तु हृदा स्वल्पमिति द्विज॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000299029, "chapter_id": 20299, "verse_number": "१-५३-३०", "content_sanskrit": "उदुंबरं हेमगर्भं मया तत्रैव पातितम् ।\nकिंकरे च नदीतीरे विकोणे जनवर्जिते॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000299030, "chapter_id": 20299, "verse_number": "१-५३-३१", "content_sanskrit": "तस्य यातस्य देशे तु दृष्टं तेन तदद्भुतम् ।\nअलं विधानमेतत्तु कृत्रिमं चोपलक्ष्यते॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000299031, "chapter_id": 20299, "verse_number": "१-५३-३२", "content_sanskrit": "ग्रहणे वाधुना चास्य अलोभं नष्टमेव मे ।\nअस्यैव रक्षणे कष्टमहंकारपदं त्विदम्॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000299032, "chapter_id": 20299, "verse_number": "१-५३-३३", "content_sanskrit": "यतो लोभस्ततो लाभो लाभाल्लोभः प्रवर्तते ।\nलोभग्रस्तस्य पुंसश्च शाश्वतो निरयो भवेत्॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000299033, "chapter_id": 20299, "verse_number": "१-५३-३४", "content_sanskrit": "यदि नो विगुणं वित्तं यदा वेश्मनि तिष्ठति ।\nतदा मे दारपुत्राणामुन्मादो ह्युपपद्यते॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000299034, "chapter_id": 20299, "verse_number": "१-५३-३५", "content_sanskrit": "उन्मादात्कामसंजात विकारान्मतिविभ्रमः ।\nभ्रमान्मोहोप्यहंकारः क्रोधलोभावतः परं॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000299035, "chapter_id": 20299, "verse_number": "१-५३-३६", "content_sanskrit": "एषां प्रचुरभावाच्च तपः क्षयं गमिष्यति ।\nक्षीणे तपसि वर्तंते पंकाश्चित्तप्रमोहकाः॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000299036, "chapter_id": 20299, "verse_number": "१-५३-३७", "content_sanskrit": "तैश्च शृंखलयोगैश्च बद्धो नैवोद्धृतिं व्रजेत् ।\nएतद्विमृश्य शूद्रोऽसौ परित्यज्य गृहं गतः॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000299037, "chapter_id": 20299, "verse_number": "१-५३-३८", "content_sanskrit": "स्वस्था देवा मुदा तत्र साधुसाध्विति चाब्रुवन् ।\nनिर्ग्रंथिरूपमादाय तस्यांतिक गृहं तथा॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000299038, "chapter_id": 20299, "verse_number": "१-५३-३९", "content_sanskrit": "गत्वाहं दैवसंवादमवदं भूतवर्तनम् ।\nततोभ्यासप्रसंगाच्च जनानां च परिप्लवात्॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000299039, "chapter_id": 20299, "verse_number": "१-५३-४०", "content_sanskrit": "तस्य योषा तदागत्य पप्रच्छ दैवकारणम् ।\nततोहमवदं तस्य यद्वा चेतोगतं द्रुतम्॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000299040, "chapter_id": 20299, "verse_number": "१-५३-४१", "content_sanskrit": "निभृतोथ निनादस्य कारणं कथितं मया ।\nहृद्गतं पतिना तेद्य विधिना दत्तमज्ञवत्॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000299041, "chapter_id": 20299, "verse_number": "१-५३-४२", "content_sanskrit": "परित्यक्तं महाभागे पुनर्नास्तीह ते वसु ।\nयावज्जीवति दौर्विध्यं तस्य भोक्ता न संशयः॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000299042, "chapter_id": 20299, "verse_number": "१-५३-४३", "content_sanskrit": "गच्छ मातर्गृहं शून्यमलब्धं तत्प्रपृच्छतम् ।\nश्रुत्वा तद्वै शिवं सा च वचनं पत्युरंतिके॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000299043, "chapter_id": 20299, "verse_number": "१-५३-४४", "content_sanskrit": "गत्वा प्रोवाच दुर्वृत्तं तच्छ्रुत्वा विस्मयं गतः ।\nस विचिंत्य तया सार्धमागतोसौ ममांतिकम्॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000299044, "chapter_id": 20299, "verse_number": "१-५३-४५", "content_sanskrit": "निभृतं मामुवाचेदं क्षपणत्वं च कीर्तय ।\nक्षपणक उवाच ।\nचाक्षुषं चिरसंशुद्धं हेलया तृणवत्कथम्॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000299045, "chapter_id": 20299, "verse_number": "१-५३-४६", "content_sanskrit": "त्वया त्यक्तं यतस्तात नास्ति भाग्यमकंटकम् ।\nऐश्वर्यमतुलं शौर्यं शीर्यते भावुकं पुनः॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000299046, "chapter_id": 20299, "verse_number": "१-५३-४७", "content_sanskrit": "स्वबंधूनां महद्दुःखमाजन्ममरणांतिकम् ।\nद्रक्ष्यसे चात्मना नित्यं मृतानां या गतिर्ध्रुवम्॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000299047, "chapter_id": 20299, "verse_number": "१-५३-४८", "content_sanskrit": "तस्मात्तद्गृह्यतां तूर्णं भुंक्ष्व भोग्यमकंटकम् ।\nऐश्वर्यमतुलं शौर्यं लोकानां विस्मयं वरम्॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000299048, "chapter_id": 20299, "verse_number": "१-५३-४९", "content_sanskrit": "शूद्र उवाच ।\nन मे वित्ते स्पृहा चास्ति धनं संसार वागुरा ।\nतद्विधौ पतितो मर्त्यो न पुनर्मोक्षकं व्रजेत्॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000299049, "chapter_id": 20299, "verse_number": "१-५३-५०", "content_sanskrit": "शृणु वित्तस्य यद्दोषमिहलोके परत्र च ।\nभयं चोराच्च ज्ञातिभ्यो राजभ्यस्तत्करादपि॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000299050, "chapter_id": 20299, "verse_number": "१-५३-५१", "content_sanskrit": "सर्वे जिघांसवो मर्त्याः पशुमत्स्यविविष्किराः ।\nतथा धनवतां नित्यं कथमर्थास्सुखावहाः॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000299051, "chapter_id": 20299, "verse_number": "१-५३-५२", "content_sanskrit": "प्राणस्यांतकरो ह्यर्थस्साधको दुरितस्य च ।\nकालादीनां प्रियं गेहं निदानं दुर्गतेः परम्॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000299052, "chapter_id": 20299, "verse_number": "१-५३-५३", "content_sanskrit": "क्षपणक उवाच ।\nयस्यार्थास्तस्य मित्राणि यस्यार्थास्तस्य बांधवाः ।\nकुलं शीलं च पांडित्यं रूपं भोग्यं यशः सुखम्॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000299053, "chapter_id": 20299, "verse_number": "१-५३-५४", "content_sanskrit": "धनेन तु विहीनस्य पुत्रदारोज्झितस्य च ।\nकथं मित्रं कथं धर्मं दीनानां जन्मनः कथं॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000299054, "chapter_id": 20299, "verse_number": "१-५३-५५", "content_sanskrit": "सत्वादिक्रतुकार्यं च पुष्करिण्युपकारकं ।\nदानं नाकस्य सोपानं निःस्वस्य च न सिद्ध्यति॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000299055, "chapter_id": 20299, "verse_number": "१-५३-५६", "content_sanskrit": "व्रतकार्यस्य रक्षा च धर्मादिश्रवणं भृशम् ।\nपितृयज्ञादितीर्थं च निर्वित्तस्य न सिद्ध्यति॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000299056, "chapter_id": 20299, "verse_number": "१-५३-५७", "content_sanskrit": "तथा रोगप्रतीकारः पथ्यमौषधसंचयं ।\nरक्षणं विग्रहश्चैव शत्रूणां विजयो ध्रुवम्॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000299057, "chapter_id": 20299, "verse_number": "१-५३-५८", "content_sanskrit": "स्त्रीणां च जन्मना वार्ता वसुयोगेन लभ्यते ।\nभूतभव्यप्रवृत्तानां सुकृतं दुष्कृतं च यत्॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000299058, "chapter_id": 20299, "verse_number": "१-५३-५९", "content_sanskrit": "तस्माद्बहुधनं यस्य तस्य भोग्यं यदृच्छया ।\nस्वर्गं वितरणादेव लप्स्यसे ह्यचिरादितः॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000299059, "chapter_id": 20299, "verse_number": "१-५३-६०", "content_sanskrit": "शूद्र उवाच ।\nअकामाच्च व्रतं सर्वमक्रोधात्तीर्थसेवनम् ।\nदया जप्यसमा शुद्धं संतोषो धनमेव च॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000299060, "chapter_id": 20299, "verse_number": "१-५३-६१", "content_sanskrit": "अहिंसा परमा सिद्धिः शिलोंछवृत्तिरुत्तमा ।\nशाकाहारः सुधातुल्य उपवासः परंतप॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000299061, "chapter_id": 20299, "verse_number": "१-५३-६२", "content_sanskrit": "संतोषो मे महाभोग्यं महादानं वराटकम् ।\nमातृवत्परदाराश्च परद्रव्याणि लोष्ठवत्॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000299062, "chapter_id": 20299, "verse_number": "१-५३-६३", "content_sanskrit": "परदारा भुजंगाभाः सर्वयज्ञ इदं मम ।\nतस्मादेनं न गृह्णामि सत्यं सत्यं गुणाकर॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000299063, "chapter_id": 20299, "verse_number": "१-५३-६४", "content_sanskrit": "प्रक्षालनाद्धि पंकस्य दूरादस्पर्शनं वरं ।\nइत्युक्ते तु नरश्रेष्ठ पुष्पवर्षं पपात ह॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000299064, "chapter_id": 20299, "verse_number": "१-५३-६५", "content_sanskrit": "मूर्ध्रिदेशे तनौ तस्य सर्वदेवेरितं द्विज ।\nदेवदुंदुभयो नेदुर्नृत्यंत्यप्सरसां गणाः॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000299065, "chapter_id": 20299, "verse_number": "१-५३-६६", "content_sanskrit": "जगुर्गंधर्वपतयो विमानं चापतद्दिवः ।\nऊचुर्देवगणास्तत्र विमानमिदमारुह॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000299066, "chapter_id": 20299, "verse_number": "१-५३-६७", "content_sanskrit": "सत्यलोकं समासाद्य भुंक्ष्व भोग्यं महेंद्रवत् ।\nसंख्या तेनापि वर्तेत भोग्यकालस्य धार्मिक॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000299067, "chapter_id": 20299, "verse_number": "१-५३-६८", "content_sanskrit": "इत्युक्तेषु च देवेषु शूद्रो वचनमब्रवीत् ।\nकथं निर्ग्रंथकस्यास्य ज्ञानं चेष्टास्य भाषणम्॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000299068, "chapter_id": 20299, "verse_number": "१-५३-६९", "content_sanskrit": "किं वा हरिहरौ ब्रह्मा किं वा शक्रो बृहस्पतिः ।\nकिं वा मच्छलनादेव साक्षाद्धर्म इहागतः॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000299069, "chapter_id": 20299, "verse_number": "१-५३-७०", "content_sanskrit": "इत्युक्ते क्षपणश्चासौ स्मितो वचनमब्रवीत् ।\nविज्ञातुं चैव वो धर्ममहं विष्णुरिहागतः॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000299070, "chapter_id": 20299, "verse_number": "१-५३-७१", "content_sanskrit": "विमानेन दिवं गच्छ सकुटुंबो महामुने ।\nमत्प्रसादाच्च युष्माकं सदैव नवयौवनम्॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000299071, "chapter_id": 20299, "verse_number": "१-५३-७२", "content_sanskrit": "भविष्यति महाप्राज्ञ भाग्यानंत्यं प्रलप्स्यथ ।\nदिव्याभरणसंयुक्ता दिव्यवस्त्रोपशोभिताः॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000299072, "chapter_id": 20299, "verse_number": "१-५३-७३", "content_sanskrit": "गतास्ते सहसा नाकं सर्वैर्बंधुजनैर्वृताः ।\nएवं द्विजवरश्रेष्ठ लोभत्यागाद्ययुर्दिवम्॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000299073, "chapter_id": 20299, "verse_number": "१-५३-७४", "content_sanskrit": "तुलाधारस्तथाधीमान्सत्यधर्म प्रतिष्ठितः ।\nये न जानाति तद्वृत्तं देशांतरसमुद्भवम्॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000299074, "chapter_id": 20299, "verse_number": "१-५३-७५", "content_sanskrit": "तुलाधारसमो नास्ति सुरलोके प्रतिष्ठितः ।\nतस्मात्त्वमपि भूदेव समं गत्वा दिवं व्रज॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000299075, "chapter_id": 20299, "verse_number": "१-५३-७६", "content_sanskrit": "य इदं शृणुयान्मर्त्यः सर्वधर्मप्रतिष्ठितः ।\nजन्मजन्मार्जितं पापं तत्क्षणात्तस्य नश्यति॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000299076, "chapter_id": 20299, "verse_number": "१-५३-७७", "content_sanskrit": "सकृत्पठनमात्रेण सर्वयज्ञफलं लभेत् ।\nलोकानां पुरतो विप्र देवानामर्च्यतां व्रजेत्॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}]