[{"id": 2075213, "chapter_id": 2591, "verse_number": "१२-९६-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2075214, "chapter_id": 2591, "verse_number": "१२-९६-१", "content_sanskrit": "नाधर्मेण महीं जेतुं लिप्सेत जगतीपतिः।\nअधर्मविजयं लब्ध्वा को नु मन्येत भूमिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2075215, "chapter_id": 2591, "verse_number": "१२-९६-२", "content_sanskrit": "अधर्मयुक्तो विजयो ह्यध्रुवोऽस्वर्ग्य एव च।\nपातयत्येव राजानं महीं च भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2075216, "chapter_id": 2591, "verse_number": "१२-९६-३", "content_sanskrit": "विशीर्णकवचं चैव तवास्मीति च वादिनम्।\nकृताञ्जलिं न्यस्तशस्त्रं गृहीत्वा न विहिंसयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2075217, "chapter_id": 2591, "verse_number": "१२-९६-४", "content_sanskrit": "बलेन विजितो यश्च न तं युध्येत भूमिपः।\nसंवत्सरं विप्रणयेत्तस्माज्जातः पुनर्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2075218, "chapter_id": 2591, "verse_number": "१२-९६-५", "content_sanskrit": "नार्वाक्संवत्सरात्कन्या प्रष्टव्या विक्रमाहृता।\nएवमेव धनं सर्वं यच्चान्यत्सहसा हृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2075219, "chapter_id": 2591, "verse_number": "१२-९६-६", "content_sanskrit": "न तु वध्ये धनं तिष्ठेत्पिबेयुर्ब्राह्मणाः पयः।\nयुञ्जीरन्नप्यनडुहः क्षन्तव्यं वा पुनर्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2075220, "chapter_id": 2591, "verse_number": "१२-९६-७", "content_sanskrit": "राज्ञा राजैव योद्धव्यस्तथा धर्मो विधीयते।\nनान्यो राजानमभ्यस्येदराजन्यः कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2075221, "chapter_id": 2591, "verse_number": "१२-९६-८", "content_sanskrit": "अनीकयोः संहतयोर्यदीयाद्ब्राह्मणोऽन्तरा।\nशान्तिमिच्छन्नुभयतो न योद्धव्यं तदा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2075222, "chapter_id": 2591, "verse_number": "१२-९६-९", "content_sanskrit": "मर्यादां शाश्वतीं भिन्द्याद्ब्राह्मणं योऽभिलङ्घयेत्।\nअथ चेल्लङ्घयेदेव मर्यादां क्षत्रियब्रुवः।\nअसङ्ख्येपतदूर्ध्वं स्यादनादेयश्च संसदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2075223, "chapter_id": 2591, "verse_number": "१२-९६-१०", "content_sanskrit": "यस्तु धर्मविलोपेन मर्यादाभेदनेन च।\nतां वृत्तिं नानुवर्तेत विजिगीषुर्महीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2075224, "chapter_id": 2591, "verse_number": "१२-९६-११", "content_sanskrit": "धर्मलब्धाद्धि विजयाल्लाभः कोऽभ्यधिको भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2075225, "chapter_id": 2591, "verse_number": "१२-९६-१२", "content_sanskrit": "सहसा न्याय्यभूतानि क्षिप्रमेव प्रसादयेत्।\nसान्त्वेन भोगदानेन स राज्ञां परमो नयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2075226, "chapter_id": 2591, "verse_number": "१२-९६-१३", "content_sanskrit": "भुज्यमाना ह्यभोगेन स्वराष्ट्रादभितापिताः।\nअमित्रान्पर्युपासीरन्व्यसनौघप्रतीक्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2075227, "chapter_id": 2591, "verse_number": "१२-९६-१४", "content_sanskrit": "अमित्रोपग्रहं चास्य ते कुर्युः क्षिप्रमापदि।\nसंतुष्टाः सर्वतो राजन्राजव्यसनकाङ्क्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2075228, "chapter_id": 2591, "verse_number": "१२-९६-१५", "content_sanskrit": "नामित्रो विनिकर्तव्यो नातिच्छेद्यः कथंचन।\nजीवितं ह्यप्यतिच्छिन्नः संत्यजेदेकदा नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2075229, "chapter_id": 2591, "verse_number": "१२-९६-१६", "content_sanskrit": "अल्पेनापि च संयुक्तस्तुष्यते नापराधितः।\nशुद्धं जीवितमेवापि तादृशो बहुमन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2075230, "chapter_id": 2591, "verse_number": "१२-९६-१७", "content_sanskrit": "यस्य स्फीतो जनपदः संपन्नः प्रियराजकः।\nसंतुष्टभृत्यसचिवो दृढमूलः स पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2075231, "chapter_id": 2591, "verse_number": "१२-९६-१८", "content_sanskrit": "ऋत्विक्पुरोहिताचार्या ये चान्ये श्रुतसत्तमाः।\nपूजार्हाः पूजिता यस्य स वै लोकविदुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2075232, "chapter_id": 2591, "verse_number": "१२-९६-१९", "content_sanskrit": "एतेनैव च वृत्तेन महीं प्राप सुरोत्तमः।\nअन्येऽपि चैव विजयं विजिगीषन्ति पार्थिवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2075233, "chapter_id": 2591, "verse_number": "१२-९६-२०", "content_sanskrit": "भूमिवर्जं धनं राजा जित्वा राजन्महाहवे।\nअपि चान्नोषधीः शश्वदाजहार प्रतर्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2075234, "chapter_id": 2591, "verse_number": "१२-९६-२१", "content_sanskrit": "अग्रिहोत्राग्निशेषं च हविर्भोजनमेव च।\nआजहार दिवोदासस्ततो विप्रकृतोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2075235, "chapter_id": 2591, "verse_number": "१२-९६-२२", "content_sanskrit": "सराजकानि राष्ट्राणि नाभागो दक्षिणां ददौ।\nअन्यत्र श्रोत्रियस्वाच्च तापसार्थाच्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2075236, "chapter_id": 2591, "verse_number": "१२-९६-२३", "content_sanskrit": "उच्चावचानि वित्तानि धर्मज्ञानां युधिष्ठिर।\nआसन्राज्ञां पुराणानां सर्वं तन्मम रोचते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2075237, "chapter_id": 2591, "verse_number": "१२-९६-२४", "content_sanskrit": "सर्वविद्यातिरेकेण जयमिच्छेन्महीपतिः।\nन मायया न दम्भेन य इच्छेद्भूतिमात्मनः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2075238, "chapter_id": 2591, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि षण्णवतितमोऽध्यायः॥ ९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]