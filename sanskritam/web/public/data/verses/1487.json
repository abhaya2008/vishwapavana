[{"id": 2022896, "chapter_id": 1487, "verse_number": "३-१२५-०x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2022897, "chapter_id": 1487, "verse_number": "३-१२५-१", "content_sanskrit": "ततः श्रुत्वा तु शर्यातिर्वयस्थं च्यवनं कृतम्।\nसुहृष्टः सेनया सार्धमुपायाद्भार्गवाश्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2022898, "chapter_id": 1487, "verse_number": "३-१२५-२", "content_sanskrit": "च्यवनं च सुकन्यां च दृष्ट्वा देवसुताविव।\nरेमे सभार्यः शर्यातिः कृत्स्नां प्राप्य महीमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2022899, "chapter_id": 1487, "verse_number": "३-१२५-३", "content_sanskrit": "ऋषिणा सत्कृतस्तेन सभार्यः पृथिवीपतिः।\nउपोपविष्टः कल्याणीः कथाश्चक्रे मनोरमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2022900, "chapter_id": 1487, "verse_number": "३-१२५-४", "content_sanskrit": "अथैनं भार्गवो राजन्नुवाच परिसान्त्वयन्।\nयाजयिष्यामि राजंस्त्वां संभारानुपकल्पय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2022901, "chapter_id": 1487, "verse_number": "३-१२५-५", "content_sanskrit": "ततः परमसंहृष्टः शर्यातिरवनीपतिः।\nच्यवनस्य महाराज तद्वाक्यं प्रत्यपूजयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2022902, "chapter_id": 1487, "verse_number": "३-१२५-६", "content_sanskrit": "प्रशस्तेऽहनि यज्ञीये सर्वकामसमृद्धिमत्।\nकारयामास शर्यातिर्यज्ञायतनमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2022903, "chapter_id": 1487, "verse_number": "३-१२५-७", "content_sanskrit": "तत्रैनं च्यवनो राजन्याजयामास भार्गवः।\nअद्भुतानि च तत्रासन्यानि तानि निबोध मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2022904, "chapter_id": 1487, "verse_number": "३-१२५-८", "content_sanskrit": "अगृह्णाच्च्यवनः सोममश्विनोर्देवयोस्तदा।\nतमिन्द्रो वारयामास गृह्णानं स तयोर्ग्रहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2022905, "chapter_id": 1487, "verse_number": "३-१२५-९x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2022906, "chapter_id": 1487, "verse_number": "३-१२५-९", "content_sanskrit": "उभावेतौ न सोमार्हौ नासत्याविति मे मतिः।\nभिषजौ दिवि देवानां कर्मणा तेन नार्हतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2022907, "chapter_id": 1487, "verse_number": "३-१२५-१०x", "content_sanskrit": "च्यवन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2022908, "chapter_id": 1487, "verse_number": "३-१२५-१०", "content_sanskrit": "मावमंस्था महात्मानौ रूपद्रविणवत्तरौ।\nयौ चक्रतुर्मां मधवन्वृन्दारकमिवाजरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2022909, "chapter_id": 1487, "verse_number": "३-१२५-११", "content_sanskrit": "ऋते त्वां विबुधांश्चान्यान्कथं वै नार्हतः सवम्।\nअश्विनावपि देवेन्द्र देवौ विद्धि पुरंदर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2022910, "chapter_id": 1487, "verse_number": "३-१२५-१२x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2022911, "chapter_id": 1487, "verse_number": "३-१२५-१२", "content_sanskrit": "चिकित्सकौ कर्मकरौ कामरूपसमन्वितौ।\nलोके चरन्तौ मर्त्यानां कथं सोममिहार्हतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2022912, "chapter_id": 1487, "verse_number": "३-१२५-१३x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2022913, "chapter_id": 1487, "verse_number": "३-१२५-१३", "content_sanskrit": "एतदेव तदा वाक्यमाम्रेडयति वासवे।\nअनादृत्यततः शक्रं ग्रहं जग्राह भार्गवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2022914, "chapter_id": 1487, "verse_number": "३-१२५-१४", "content_sanskrit": "ग्रहीष्यन्तं तु तं सोममश्विनोरुत्तमं तदा।\nसमीक्ष्य बलभिद्देव इदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2022915, "chapter_id": 1487, "verse_number": "३-१२५-१५", "content_sanskrit": "आभ्यामर्ताय सोमं त्वं ग्रहीष्यसि यदि स्वयम्।\nवज्रं ते प्रहरिष्यामि घोररूपमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2022916, "chapter_id": 1487, "verse_number": "३-१२५-१६", "content_sanskrit": "एवमुक्तः स्मयन्निन्द्रमभिवीक्ष्यस भार्गवः।\nजग्राह विधिवत्सोममश्विभ्यामुत्तमं ग्रहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2022917, "chapter_id": 1487, "verse_number": "३-१२५-१७", "content_sanskrit": "ततोऽस्मै प्राहरद्वज्रं घोररूपं शचीपतिः।\nतस्य प्रहरतो बाहुं स्तम्भयामास भार्गवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2022918, "chapter_id": 1487, "verse_number": "३-१२५-१८", "content_sanskrit": "तं स्तम्भयित्वा च्यवनो जुहुवे मन्त्रतोऽनलम्।\nकृत्यार्थी सुमहातेजा देवं हिंसितुमुद्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2022919, "chapter_id": 1487, "verse_number": "३-१२५-१९", "content_sanskrit": "ततः कृत्याऽथ संजज्ञे मुनेस्तस्य तपोबलात्।\nमदो नाम महावीर्यो बृहत्कायो महासुरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2022920, "chapter_id": 1487, "verse_number": "३-१२५-२०", "content_sanskrit": "शरीरं यस् निर्देष्टुमशक्यं तु सुरासुरैः।\nतस्यास्यमभवद्धोरं तीक्ष्णाग्रदशनं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2022921, "chapter_id": 1487, "verse_number": "३-१२५-२१", "content_sanskrit": "हनुरेका स्थिता त्वस्य भूमावेका दिवं गता।\nचतस्रश्चायता दंष्ट्रा योजनानां शतंशतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2022922, "chapter_id": 1487, "verse_number": "३-१२५-२२", "content_sanskrit": "इतरे तस्य दशना बभूवुर्दशयोजनाः।\nप्रासादशिखराकाराः शूलाग्रसमदर्शनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2022923, "chapter_id": 1487, "verse_number": "३-१२५-२३", "content_sanskrit": "बाहू परिघसंकाशावायतावयुतं समौ।\nनेत्रे रविशशिप्रख्ये वक्रं कालाग्निसंनिभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2022924, "chapter_id": 1487, "verse_number": "३-१२५-२४", "content_sanskrit": "लेलिहञ्जिह्वया वक्रं विद्युच्चपललोलया।\nव्यात्ताननो घोरदृष्टिर्ग्रसन्निव जगद्बलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2022925, "chapter_id": 1487, "verse_number": "३-१२५-२५", "content_sanskrit": "स भक्षयिष्यन्संक्रुद्धः शतक्रतुमुपाद्रवत्।\nमहता घोररूपेण लोकाञ्शब्देन नादयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2022926, "chapter_id": 1487, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि प़्चविंशत्यधिकशततमोऽध्यायः ॥ १२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]