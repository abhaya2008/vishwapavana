[{"id": 2007657, "chapter_id": 1148, "verse_number": "१-१४९-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2007658, "chapter_id": 1148, "verse_number": "१-१४९-१", "content_sanskrit": "द्रोणेन वैरं द्रुपदो न सुष्वाप स्मरंस्तदा।\nक्षात्रेण वै बलेनास्य नाऽशशंसे पराजयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2007659, "chapter_id": 1148, "verse_number": "१-१४९-२", "content_sanskrit": "हीनं विदित्वा चात्मानं ब्राह्मेणापि बलेन च।\nद्रुपदोऽमर्षणाद्राजा कर्मसिद्धान्द्विजोत्तमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2007660, "chapter_id": 1148, "verse_number": "१-१४९-३", "content_sanskrit": "अन्विच्छन्परिचक्राम ब्राह्मणावसथान्बहून्।\nनास्ति श्रेष्ठं ममापत्यं धिग्बन्धूनिति च ब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2007661, "chapter_id": 1148, "verse_number": "१-१४९-४", "content_sanskrit": "निश्वासपरमो ह्यासीद्द्रोणं प्रतिचिकीर्षया।\nन सन्ति मम मित्राणि लोकेऽस्मिन्नास्ति वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2007662, "chapter_id": 1148, "verse_number": "१-१४९-५", "content_sanskrit": "पुत्रजन्म परीप्सन्वै पृथिवीमन्वयादिमाम्।\nप्रभावशिक्षाविनयाद्द्रोणस्यास्त्रबलेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2007663, "chapter_id": 1148, "verse_number": "१-१४९-६", "content_sanskrit": "कर्तुं प्रयतमानो वै न शशाक पराजयम्।\nअभितः सोऽथ कल्माषीं गङ्गातीरे परिभ्रमन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2007664, "chapter_id": 1148, "verse_number": "१-१४९-७", "content_sanskrit": "ब्राह्मणावसथं पुण्यमाससाद महीपतिः।\nतत्र नास्नातकः कश्चिन्न चासीदव्रतो द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2007665, "chapter_id": 1148, "verse_number": "१-१४९-८", "content_sanskrit": "तथैव तौ महाभागौ सोऽपश्यच्छंसितव्रतौ।\nयाजोपयाजौ ब्रह्मर्षी भ्रातरौ पृषतात्मजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2007666, "chapter_id": 1148, "verse_number": "१-१४९-९", "content_sanskrit": "संहिताध्ययने युक्तौ गोत्रतश्चापि काश्यपौ।\nअरण्ये युक्तरूपौ तौ ब्राह्मणावृषिसत्तमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2007667, "chapter_id": 1148, "verse_number": "१-१४९-१०", "content_sanskrit": "स उपामन्त्रयामास सर्वकामैरतन्द्रितः।\nबुद्ध्वा तयोर्बलं बुद्धिं कनीयांसमुपह्वरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2007668, "chapter_id": 1148, "verse_number": "१-१४९-११", "content_sanskrit": "प्रपेदे छन्दयन्कामैरुपयाजं धृतव्रतम्।\nगुरुशुश्रूषणे युक्तः प्रियकृत्सर्वकामदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2007669, "chapter_id": 1148, "verse_number": "१-१४९-१२", "content_sanskrit": "पाद्येनासनदानेन तथाऽर्घ्येण फलैश्च तम्।\nअर्हयित्वा यथान्यायमुपयाजोऽब्रवीत्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2007670, "chapter_id": 1148, "verse_number": "१-१४९-१३", "content_sanskrit": "येन कार्यविशेषेण त्वमस्मानभिकाङ्क्षसे।\nकृतश्चायं समुद्योगस्तद्ब्रवीतु भवानिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2007671, "chapter_id": 1148, "verse_number": "१-१४९-१४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2007672, "chapter_id": 1148, "verse_number": "१-१४९-१४", "content_sanskrit": "स बुद्ध्वा प्रीतिसंयुक्तमृषीणामुत्तमं तदा।\nउवाच छन्दयन्कामैर्द्रुपदः स तपस्विनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2007673, "chapter_id": 1148, "verse_number": "१-१४९-१५", "content_sanskrit": "येन मे कर्मणा ब्रह्मन्पुत्रः स्याद्द्रोणमृत्येव।\nउपयाज चरस्वैतत्प्रदास्यामि धनं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2007674, "chapter_id": 1148, "verse_number": "१-१४९-१६x", "content_sanskrit": "उपयाज उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2007675, "chapter_id": 1148, "verse_number": "१-१४९-१६", "content_sanskrit": "नाहं फलार्थी द्रुपद योऽर्थी स्यात्तत्र गम्यताम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2007676, "chapter_id": 1148, "verse_number": "१-१४९-१६x", "content_sanskrit": "वैशम्पायन उवाच।\nप्रत्याख्यातस्तु तेनैवं स वै सज्जनसंनिधौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2007677, "chapter_id": 1148, "verse_number": "१-१४९-१७", "content_sanskrit": "आराधयिष्यन्द्रुपदः स तं पर्यचरत्तदा।\nततः संवत्सरस्यान्ते द्रुपदं द्विजसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2007678, "chapter_id": 1148, "verse_number": "१-१४९-१८", "content_sanskrit": "उपयाजोऽब्रवीद्वाक्यं काले मधुरया गिरा।\nज्येष्ठो भ्राता न मेऽत्याक्षीद्विचरन्विजने वने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2007679, "chapter_id": 1148, "verse_number": "१-१४९-१९", "content_sanskrit": "अपरिज्ञातशौचायां भूमौ निपतितं फलम्।\nतदपश्यमहं भ्रातुरसांप्रतमनुव्रजन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2007680, "chapter_id": 1148, "verse_number": "१-१४९-२०", "content_sanskrit": "विमर्शं हि फलादाने नायं कुर्यात्कथंचन।\nनापश्यत्फलं दृष्ट्वा दोषांस्तस्याऽऽनुबन्धिकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2007681, "chapter_id": 1148, "verse_number": "१-१४९-२१", "content_sanskrit": "विविनक्ति न शौचार्थी सोऽन्यत्रापि कथं भवेत्।\nसंहिताध्ययनस्यान्ते पञ्चयज्ञान्निरूप्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2007682, "chapter_id": 1148, "verse_number": "१-१४९-२२", "content_sanskrit": "भैक्षमुञ्छेन सहितं भुञ्जानस्तु तदा तदा।\nकीर्तयत्येव राजर्षे भोजनस्य रसं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2007683, "chapter_id": 1148, "verse_number": "१-१४९-२३", "content_sanskrit": "संहिताध्ययनं कुर्वन्वने गुरुकुले वसन्।\nभैक्षमुच्छिष्टमन्येषां भुङ्क्ते स्म सततं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2007684, "chapter_id": 1148, "verse_number": "१-१४९-२४", "content_sanskrit": "कीर्तयन्गुणमन्नानामथ प्रीतो मुहुर्मुहुः।\nएवं फलार्थिनस्त्समान्मन्येऽहं तर्कचक्षुषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2007685, "chapter_id": 1148, "verse_number": "१-१४९-२५", "content_sanskrit": "तं वै गच्छेह नृपते त्वां स संयाजयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2007686, "chapter_id": 1148, "verse_number": "१-१४९-२६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2007687, "chapter_id": 1148, "verse_number": "१-१४९-२६", "content_sanskrit": "उपयाजवचः श्रुत्वा याजस्याश्रममभ्यगात्।\nजुगुप्समानो नृपतिर्मनसेदं विचिन्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2007688, "chapter_id": 1148, "verse_number": "१-१४९-२७", "content_sanskrit": "भृशं संपूज्य पूजार्हमृषिं याजमुवाच ह।\nगोशतानि ददान्यष्टौ याज याजय मां विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2007689, "chapter_id": 1148, "verse_number": "१-१४९-२८", "content_sanskrit": "द्रोणवैरान्तरे तप्तं विषण्णं शरणागतम्।\nब्रह्मबन्धुप्रणिहितं न क्षत्रं क्षत्रियो जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2007690, "chapter_id": 1148, "verse_number": "१-१४९-२९", "content_sanskrit": "तस्माद्द्रोणभयार्तं मां भवांस्त्रातुमिहार्हति।\nयेन मे कर्मणा ब्रह्मन्पुत्रः स्याद्द्रोणमृत्यवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2007691, "chapter_id": 1148, "verse_number": "१-१४९-३०", "content_sanskrit": "अर्जुनस्यापि वै भार्या भवेद्या वरवर्णिनी।\nस हि ब्रह्मविदां श्रेष्ठो ब्राह्मे क्षात्रेऽप्यनुत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2007692, "chapter_id": 1148, "verse_number": "१-१४९-३१", "content_sanskrit": "ततो द्रोणस्तु माऽजैषीत्सखिविग्रहकारणात्।\nक्षत्रियो नास्ति तुल्योऽस्य पृथिव्यां कश्चिदग्रणीः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2007693, "chapter_id": 1148, "verse_number": "१-१४९-३२", "content_sanskrit": "भारताचार्यमुख्यस्य भारद्वाजस्य धीमतः।\nद्रोणस्य शरजालानि रिपुदेहहराणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2007694, "chapter_id": 1148, "verse_number": "१-१४९-३३", "content_sanskrit": "षडरत्नि धनुश्चास्य खड्गमप्रतिम तथा।\nस हि ब्राह्मणवेषेण क्षात्रं वेगमसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2007695, "chapter_id": 1148, "verse_number": "१-१४९-३४", "content_sanskrit": "प्रतिहन्ति महेष्वासो भारद्वाजो महामनाः।\nकार्तवीर्यसमो ह्येष खट्वाङ्गप्रतिमो रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2007696, "chapter_id": 1148, "verse_number": "१-१४९-३५", "content_sanskrit": "क्षत्रोच्छेदाय विहितो जामदग्न्य इवास्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2007697, "chapter_id": 1148, "verse_number": "१-१४९-३६", "content_sanskrit": "सहितं क्षत्रवेगेन ब्रह्मवेगेन सांप्रतम्।\nउपपन्नं हि मन्येऽहं भारद्वाजं यशस्विनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2007698, "chapter_id": 1148, "verse_number": "१-१४९-३७", "content_sanskrit": "नेषवस्तमपाकुर्युर्न च प्रासा न चासयः।\nब्राह्मं तस्य महातेजो मन्त्राहुतिहुतं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2007699, "chapter_id": 1148, "verse_number": "१-१४९-३८", "content_sanskrit": "तस्य ह्यस्त्रबलं घोरमप्रसह्यं परैर्भुवि।\nशत्रून्समेत्य जयति क्षत्रं ब्रह्मपुरस्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2007700, "chapter_id": 1148, "verse_number": "१-१४९-३९", "content_sanskrit": "ब्रह्मक्षत्रे च सहिते ब्रह्मतेजो विशिष्यते।\nसोऽहं क्षत्रबलाद्दीनो ब्रह्मतेजः प्रपेदिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2007701, "chapter_id": 1148, "verse_number": "१-१४९-४०", "content_sanskrit": "द्रोणाद्विशिष्टमासाद्य भवन्तं ब्रह्मवित्तमम्।\nद्रोणान्तकमहं पुत्रं लभेयं युधि दुर्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2007702, "chapter_id": 1148, "verse_number": "१-१४९-४१", "content_sanskrit": "द्रोणमृत्युर्यथा मेऽद्य पुत्रो जायेत वीर्यवान्।\nतत्कर्म कुरु मे याज निर्वपाम्यर्बुद्धं गवाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2007703, "chapter_id": 1148, "verse_number": "१-१४९-४२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2007704, "chapter_id": 1148, "verse_number": "१-१४९-४२", "content_sanskrit": "तथेत्युक्त्वा तुं तं याजो यज्ञार्थमुपकल्पयन्।\nगुर्वर्थ इति चाकाममुपयाजमचोदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2007705, "chapter_id": 1148, "verse_number": "१-१४९-४३", "content_sanskrit": "द्रुपदं च महाराजमिदं वचनमब्रवीत्।\nमा भैस्त्वं संप्रदास्यामि कर्मणा भवतः सुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2007706, "chapter_id": 1148, "verse_number": "१-१४९-४४", "content_sanskrit": "क्षिप्रमुत्तिष्ठ चाव्यग्रः संभारानुपकल्पय।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2007707, "chapter_id": 1148, "verse_number": "१-१४९-४४x", "content_sanskrit": "वैशम्पायन उवाच।\nएवमुक्त्वा प्रतिज्ञाय कर्म चास्याददे मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2007708, "chapter_id": 1148, "verse_number": "१-१४९-४५", "content_sanskrit": "ब्राह्मणो द्विपदां श्रेष्ठो यथाविधि कथाक्रमम्।\nयाजो द्रोणविनाशाय याजयामास तं नृपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2007709, "chapter_id": 1148, "verse_number": "१-१४९-४६", "content_sanskrit": "गुर्वर्थेऽयोजयत्कर्म याजस्यापि समीपतः।\nततस्तस्य नरेन्द्रस्य उपयाजो महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2007710, "chapter_id": 1148, "verse_number": "१-१४९-४७", "content_sanskrit": "आचव्यौ कर्म वैतानं तथा पुत्रफलाय वै।\nइह पुत्रो महावीर्यो महातेजा महाबलः।\nइष्यते यद्विधो राजन्भविता स तथाविधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2007711, "chapter_id": 1148, "verse_number": "१-१४९-४८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2007712, "chapter_id": 1148, "verse_number": "१-१४९-४८", "content_sanskrit": "भारद्वाजस्य हन्तारं सोऽभिसन्धाय पार्थिवः।\nआजहेऽथ तदा राजन्द्रुपदः कर्म सिद्धये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2007713, "chapter_id": 1148, "verse_number": "१-१४९-४९", "content_sanskrit": "ब्राह्मणो द्विपदां श्रेष्ठो जुहाव च यथाविधि।\nकौसवी नाम तस्यासीद्या वै तां पुत्रगृद्धिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2007714, "chapter_id": 1148, "verse_number": "१-१४९-५०", "content_sanskrit": "सौत्रामणिं तथा पत्नीं ततः कालेऽभ्ययात्तदा।\nयाजस्तु सवनस्यान्ते देवीमाह्वापयत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2007715, "chapter_id": 1148, "verse_number": "१-१४९-५१", "content_sanskrit": "प्रेहि मां राज्ञि पृषति मिथुनं त्वामुपस्थितम्।\nकुमारश्च कुमारी च पितृवंशविवृद्धये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2007716, "chapter_id": 1148, "verse_number": "१-१४९-५२x", "content_sanskrit": "पृषत्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2007717, "chapter_id": 1148, "verse_number": "१-१४९-५२", "content_sanskrit": "नालिप्तं वै मम मुखं पुण्यान्गन्धान्बिभर्मि च।\nन पत्नी तेऽस्मि सूत्यर्थे तिष्ठ याज मम प्रिये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2007718, "chapter_id": 1148, "verse_number": "१-१४९-५३x", "content_sanskrit": "याज उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2007719, "chapter_id": 1148, "verse_number": "१-१४९-५३", "content_sanskrit": "याजेन श्रपितं हव्यमुपयाजेन मन्त्रितम्।\nकथं कामं न संदध्यात्पृषति प्रेहि तिष्ठ वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2007720, "chapter_id": 1148, "verse_number": "१-१४९-५४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2007721, "chapter_id": 1148, "verse_number": "१-१४९-५४", "content_sanskrit": "एवमुक्त्वा तु याजेन हुते हविषि संस्कृते।\nउत्तस्थौ पावकात्तस्मात्कुमारो देवसंनिभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2007722, "chapter_id": 1148, "verse_number": "१-१४९-५५", "content_sanskrit": "ज्वालावर्णो घोररूपः किरीटी वर्म धारयन्।\nवीरः सखङ्गः सशरो धनुष्मान्स नदन्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2007723, "chapter_id": 1148, "verse_number": "१-१४९-५६", "content_sanskrit": "सोऽभ्यरोहद्रथवरं तेन च प्रययौ तदा।\nजातमात्रे कुमारे च वाक्किलान्तर्हिताब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2007724, "chapter_id": 1148, "verse_number": "१-१४९-५७", "content_sanskrit": "एष शिष्यश्च मृत्युश्च भारद्वाजस्य जायते।\nभयापहो राजपुत्रः पाञ्चालानां यशस्करः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2007725, "chapter_id": 1148, "verse_number": "१-१४९-५८", "content_sanskrit": "राज्ञः शोकापहो जात एष द्रोणवधाय हि।\nइत्यवोचन्महद्भूतमदृश्यं खेचरं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2007726, "chapter_id": 1148, "verse_number": "१-१४९-५९", "content_sanskrit": "ततः प्रणेदुः पाञ्चालाः प्रहृष्टाः साधुसाध्विति।\nद्वितीयायां च होत्रायां हुते हविषि मन्त्रिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2007727, "chapter_id": 1148, "verse_number": "१-१४९-६०", "content_sanskrit": "कुमारी चापि पाञ्चाली वेदिमध्यात्समुत्थिता।\nप्रत्याख्याते पृषत्या च याजके भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2007728, "chapter_id": 1148, "verse_number": "१-१४९-६१", "content_sanskrit": "पुनः कुमारी पाञ्चाली सुभगा वेदिमध्यगा।\nअन्तर्वेद्यां समुद्भूता कन्या सा सुमनोहरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2007729, "chapter_id": 1148, "verse_number": "१-१४९-६२", "content_sanskrit": "श्यामा पद्मपलाशाक्षी नीलकुञ्चितमूर्धजा।\nमानुषं विग्रहं कृत्वा साक्षाच्छ्रीरिव वर्णिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2007730, "chapter_id": 1148, "verse_number": "१-१४९-६३", "content_sanskrit": "ताम्रतुङ्गनखी सुभ्रूश्चारुपीनपयोधरा।\nनीलोत्पलसमो गन्धो यस्याः क्रोशात्प्रधावति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2007731, "chapter_id": 1148, "verse_number": "१-१४९-६४", "content_sanskrit": "या बिभर्ति परं रूपं यस्या नास्त्युपमा भुवि।\nदेवदानवयक्षाणामीप्सिता वरवर्णिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2007732, "chapter_id": 1148, "verse_number": "१-१४९-६५", "content_sanskrit": "तां चापि जातां सुश्रोणीं वागुवाचाशरीरिणी।\nसर्वयोषिद्वरा कृष्णा क्षयं क्षत्रस्य नेष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2007733, "chapter_id": 1148, "verse_number": "१-१४९-६६", "content_sanskrit": "सुरकार्यमियं काले करिष्यति सुमध्यमा।\nअस्या हेतोः क्षत्रियाणां महदुत्पत्स्यते भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2007734, "chapter_id": 1148, "verse_number": "१-१४९-६७", "content_sanskrit": "तच्छ्रुत्वा सर्वपाञ्चालाः प्रणेदुः सिंहसङ्घवत्।\nन चैनान्हर्षसंपन्नानियं सेहे वसुन्धरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2007735, "chapter_id": 1148, "verse_number": "१-१४९-६८", "content_sanskrit": "तथा तु मिथुनं जज्ञे द्रुपदस्य महात्मनः।\nकुमारश्च कुमारी च मनोज्ञौ तौ नरर्षभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2007736, "chapter_id": 1148, "verse_number": "१-१४९-६९", "content_sanskrit": "श्रिया परमया युक्तौ क्षात्रेण वपुषा तथा।\nतौ दृष्ट्वा पृषती याजं प्रपेदे सा सुतार्थिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2007737, "chapter_id": 1148, "verse_number": "१-१४९-७०", "content_sanskrit": "न वै मदन्यां जननीं जानीयातामिमाविति।\nतथेत्युवाच तां याजो राज्ञः प्रियचिकीर्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2007738, "chapter_id": 1148, "verse_number": "१-१४९-७१", "content_sanskrit": "तयोस्तु नामनी चक्रुर्द्विजाः संपूर्णमानसाः।\nधृष्टत्वादप्रधृष्यत्वात् द्युम्नाद्युत्संभवादपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2007739, "chapter_id": 1148, "verse_number": "१-१४९-७२", "content_sanskrit": "धृष्टद्युम्नः कुमारोऽयं द्रुपद्सय भवत्विति।\nकृष्णेत्येवाभवत्कन्या कृष्णा भूत्सा हि वर्णतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2007740, "chapter_id": 1148, "verse_number": "१-१४९-७३", "content_sanskrit": "तथा तन्मिथुनं जज्ञे द्रुपदस्य महामखे।\nवैदिकाध्ययने पारं धृष्टद्युम्नो गतस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2007741, "chapter_id": 1148, "verse_number": "१-१४९-७४", "content_sanskrit": "धृष्टद्युम्नं तु पाञ्चाल्यमानीय स्वं निवेशनम्।\nउपाकरोदस्त्रहेतोर्भारद्वाजः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2007742, "chapter_id": 1148, "verse_number": "१-१४९-७५", "content_sanskrit": "अमोक्षणीयं दैवं हि भावि मत्वा महामतिः।\nतथा तत्कृतवान्द्रोण आत्मकीर्त्यनुरक्षणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2007743, "chapter_id": 1148, "verse_number": "१-१४९-७६", "content_sanskrit": "सर्वास्त्राणि स तु क्षिप्रमाप्तवान्परया धिया॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2007744, "chapter_id": 1148, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि ऊनपञ्चाशदधिकशततमोऽध्यायः॥ १४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}]