[{"id": 7003218000, "chapter_id": 23218, "verse_number": "१-२१-१", "content_sanskrit": "सूत उवाच  ।\nब्रह्माणमग्रतः कृत्वा ततः स गरुडध्वजः  ।\nअतीतैश्च भविष्यैश्च वर्तमानैस्तथैव च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003218001, "chapter_id": 23218, "verse_number": "१-२१-२", "content_sanskrit": "नामभिश्छांदसैश्चैव इदं स्तोत्रमुदीरयत्  ।\nविष्णुरुवाच  ।\nनमस्तुभ्यं भगवते सुव्रतानंततेजसे ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003218002, "chapter_id": 23218, "verse_number": "१-२१-३", "content_sanskrit": "नमः क्षेत्राधिपतये बीजिने शूलिने नमः  ।\nसुमेंढ्रायार्च्यमेंढ्राय दंडिने रूक्षरेतसे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003218003, "chapter_id": 23218, "verse_number": "१-२१-४", "content_sanskrit": "नमो ज्येष्ठाय श्रेष्ठाय पूर्वाय प्रथमाय च  ।\nनमो मान्याय पूज्याय सद्योजाताय वै नमः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003218004, "chapter_id": 23218, "verse_number": "१-२१-५", "content_sanskrit": "गह्वराय घटेशाय व्योमचीरांबराय च  ।\nनमस्ते ह्यस्मदादीनां भूतानां प्रभवे नमः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003218005, "chapter_id": 23218, "verse_number": "१-२१-६", "content_sanskrit": "वेदानां प्रभवे चैव स्मृतीनां प्रभवे नमः  ।\nप्रभवे कर्मदानानां द्रव्याणां प्रभवे नमः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003218006, "chapter_id": 23218, "verse_number": "१-२१-७", "content_sanskrit": "नमो योगस्य प्रभवे सांख्यस्य प्रभवे नमः  ।\nनमो ध्रुवनिबद्धानामृषीणां प्रभवे नमः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003218007, "chapter_id": 23218, "verse_number": "१-२१-८", "content_sanskrit": "ऋक्षाणां प्रभवे तुभ्यं ग्रहाणां प्रभवे नमः  ।\nवैद्युताशनिमेघानां गर्जितप्रभवे नमः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003218008, "chapter_id": 23218, "verse_number": "१-२१-९", "content_sanskrit": "महोदधीनां प्रभवे द्वीपानां प्रभवे नमः  ।\nअद्रीणां प्रभवे चैव वर्षाणां प्रभवे नमः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003218009, "chapter_id": 23218, "verse_number": "१-२१-१०", "content_sanskrit": "नमो नदीनां प्रभवे नदानां प्रभवे नमः  ।\nमहौषधीनां प्रभवे वृक्षाणां प्रभवे नमः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003218010, "chapter_id": 23218, "verse_number": "१-२१-११", "content_sanskrit": "धर्मवृक्षाय धर्माय स्थितीनां प्रभवे नमः  ।\nप्रभवे च परार्धस्य परस्य प्रभवे नमः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003218011, "chapter_id": 23218, "verse_number": "१-२१-१२", "content_sanskrit": "नमो रसानां प्रभवे रत्नानां प्रभवे नमः  ।\nक्षणानां प्रभवे चैव लवानां प्रभवे नमः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003218012, "chapter_id": 23218, "verse_number": "१-२१-१३", "content_sanskrit": "अहोरात्रार्धमासानां मासानां प्रभवे नमः  ।\nऋतूनां प्रभवे तुभ्यं संख्यायाः प्रभवे नमः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003218013, "chapter_id": 23218, "verse_number": "१-२१-१४", "content_sanskrit": "प्रभवे चापरार्धस्य परार्धप्रभवे नमः  ।\nनमः पुराणप्रभवे सर्गाणां प्रभवे नमः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003218014, "chapter_id": 23218, "verse_number": "१-२१-१५", "content_sanskrit": "मन्वंतराणां प्रभवे योगस्य प्रभवे नमः  ।\nचतुर्विधस्य सर्गस्य प्रभवेऽनंतचक्षुषे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003218015, "chapter_id": 23218, "verse_number": "१-२१-१६", "content_sanskrit": "कल्पोदयनिबंधानां वातानां प्रभवे नमः  ।\nनमो विश्वस्य प्रभवे ब्रह्माधिपतये नमः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003218016, "chapter_id": 23218, "verse_number": "१-२१-१७", "content_sanskrit": "विद्यानां प्रभवे चैव विद्याधिपतये नमः  ।\nनमो व्रताधिपतये व्रतानां प्रभवे नमः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003218017, "chapter_id": 23218, "verse_number": "१-२१-१८", "content_sanskrit": "मंत्राणां प्रभवे तुभ्यं मंत्राधिपतये नमः ।\nपितॄणां पतये चैव पशूनां पतये नमः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003218018, "chapter_id": 23218, "verse_number": "१-२१-१९", "content_sanskrit": "वाग्वृषाय नमस्तुभ्यं पुराणवृषभाय च  ।\nनमः पशूनां पतये गोवृषेन्द्रध्वजाय च ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003218019, "chapter_id": 23218, "verse_number": "१-२१-२०", "content_sanskrit": "प्रजापतीनां पतये सिद्धीनां पतये नमः  ।\nदैत्यदानवसंघानां रक्षसां पतये नमः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003218020, "chapter_id": 23218, "verse_number": "१-२१-२१", "content_sanskrit": "गंधर्वाणां च पतये यक्षाणां पतये नमः  ।\nगरुडोरगसर्पाणां पक्षिणां पतये नमः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003218021, "chapter_id": 23218, "verse_number": "१-२१-२२", "content_sanskrit": "सर्वगुह्यपिशाचानां गुह्याधिपतये नमः  ।\nगोकर्णाय च गोप्त्रे च शंकुकर्णाय वै नमः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003218022, "chapter_id": 23218, "verse_number": "१-२१-२३", "content_sanskrit": "वराहायाप्रमेयाय ऋक्षाय विरजाय च  ।\nनमो सुराणां पतये गणानां पतये नमः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003218023, "chapter_id": 23218, "verse_number": "१-२१-२४", "content_sanskrit": "अंभसां पतये चैव ओजसां पतये नमः  ।\nनमोस्तु लक्ष्मीपतये श्रीपाय क्षितिपाय च ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003218024, "chapter_id": 23218, "verse_number": "१-२१-२५", "content_sanskrit": "बलाबलसमूहाय अक्षोभ्यक्षोभणाय च  ।\nदीप्तश्रृंगैकश्रृंगाय वृषभाय ककुद्मिने ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003218025, "chapter_id": 23218, "verse_number": "१-२१-२६", "content_sanskrit": "नमः स्थैर्याय वपुषे तेजसानुव्रताय च  ।\nअतीताय भविष्याय वर्तमानाय वै नमः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003218026, "chapter_id": 23218, "verse_number": "१-२१-२७", "content_sanskrit": "सुवर्चसे च वीर्याय शूराय ह्यजिताय च  ।\nवरदाय वरेण्याय पुरुषाय महात्मने ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003218027, "chapter_id": 23218, "verse_number": "१-२१-२८", "content_sanskrit": "नमो भूताय भव्याय महते प्रभवाय च  ।\nजनाय च नमस्तुभ्यं तपसे वरदाय च ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003218028, "chapter_id": 23218, "verse_number": "१-२१-२९", "content_sanskrit": "अणवे महते चैव नमः सर्वगताय च  ।\nनमो बंधाय मोक्षाय स्वर्गाय नरकाय च ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003218029, "chapter_id": 23218, "verse_number": "१-२१-३०", "content_sanskrit": "नमो भवाय देवाय इज्याय याजकाय च  ।\nप्रत्युदीर्णाय दीप्ताय तत्त्वायातिगुणाय च ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003218030, "chapter_id": 23218, "verse_number": "१-२१-३१", "content_sanskrit": "नमः पाशाय शस्त्राय नमस्त्वाभरणाय च  ।\nहुताय उपहूताय प्रहुतप्राशिताय च ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003218031, "chapter_id": 23218, "verse_number": "१-२१-३२", "content_sanskrit": "नमोस्त्विष्टाय पूर्ताय अग्निष्टोमद्विजाय च  ।\nसदस्याय नमश्चैव दक्षिणावभृथाय च ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003218032, "chapter_id": 23218, "verse_number": "१-२१-३३", "content_sanskrit": "अहिंसायाप्रलोभाय पशुमंत्रौषधाय च  ।\nनमः पुष्टिप्रदानाय सुशीलाय सुशीलिने ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003218033, "chapter_id": 23218, "verse_number": "१-२१-३४", "content_sanskrit": "अतीताय भविष्याय वर्तमानाय ते नमः  ।\nसुवर्चसे च वीर्याय शूराय ह्यजिताय च ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003218034, "chapter_id": 23218, "verse_number": "१-२१-३५", "content_sanskrit": "वरदाय वरेण्याय पुरुषाय महात्मने  ।\nनमो भूताय भव्याय महते चाभयाय च ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003218035, "chapter_id": 23218, "verse_number": "१-२१-३६", "content_sanskrit": "जरासिद्ध नमस्तुभ्यमयसे वरदाय च  ।\nअधरे महते चैव नमः सस्तुपताय च ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003218036, "chapter_id": 23218, "verse_number": "१-२१-३७", "content_sanskrit": "नमश्चेंद्रियपत्राणां लेलिहानाय स्रग्विणे  ।\nविश्वाय विश्वरूपाय विश्वतः शिरसे नमः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003218037, "chapter_id": 23218, "verse_number": "१-२१-३८", "content_sanskrit": "सर्वतः पाणिपादाय रुद्रायाप्रतिमाय च  ।\nनमो हव्याय कव्याय हव्यवाहाय वै नमः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003218038, "chapter_id": 23218, "verse_number": "१-२१-३९", "content_sanskrit": "नमः सिद्धाय मेध्याय इष्टायेज्यापराय च  ।\nसुवीराय सुघोराय अक्षोभ्यक्षोभणाय च ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003218039, "chapter_id": 23218, "verse_number": "१-२१-४०", "content_sanskrit": "सुप्रजाय सुमेधाय दीप्ताय भास्कराय च  ।\nनमो बुद्धाय शुद्धाय विस्तृताय मताय च ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003218040, "chapter_id": 23218, "verse_number": "१-२१-४१", "content_sanskrit": "नमः स्थूलाय सूक्ष्माय दृश्यादृश्याय सर्वशः  ।\nवर्षते ज्वलते चैव वायवे शिशिराय च ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003218041, "chapter_id": 23218, "verse_number": "१-२१-४२", "content_sanskrit": "नमस्ते वक्रकेशाय ऊरुवक्षःशिखाय च  ।\nनमो नमः सुवर्णाय तपनीयनिभाय च ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003218042, "chapter_id": 23218, "verse_number": "१-२१-४३", "content_sanskrit": "विरूपाक्षाय लिंगाय पिंगलाय महौजसे  ।\nवृष्टिघ्नाय नमश्चैव नमः सौम्येक्षणाय च ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003218043, "chapter_id": 23218, "verse_number": "१-२१-४४", "content_sanskrit": "नमो धूम्राय श्वेताय कृष्णाय लोहिताय च ।\nपिशिताय पिशंगाय पीताय च निषंगिणे ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003218044, "chapter_id": 23218, "verse_number": "१-२१-४५", "content_sanskrit": "नमस्ते सविशेषाय निर्विशेषाय वै नमः ।\nनम ईज्याय पूज्याय उपजीव्याय वै नमः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003218045, "chapter_id": 23218, "verse_number": "१-२१-४६", "content_sanskrit": "नमः क्षेम्याय वृद्धाय वत्सलाय नमोनमः  ।\nनमो भूताय सत्याय सत्यासत्याय वै नमः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003218046, "chapter_id": 23218, "verse_number": "१-२१-४७", "content_sanskrit": "नमो वै पद्मवर्णाय मृत्युघ्नाय च मृत्यवे  ।\nनमो गौराय श्यामाय कद्रवे लोहिताय च ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003218047, "chapter_id": 23218, "verse_number": "१-२१-४८", "content_sanskrit": "महासंध्याभ्रवर्णाय चारुदीप्ताय दीक्षिणे  ।\nनमः कमलहस्ताय दिग्वासाय कपर्दिने ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003218048, "chapter_id": 23218, "verse_number": "१-२१-४९", "content_sanskrit": "अप्रमाणाय सर्वाय अव्ययायामराय च  ।\nनमो रूपाय गंधाय शाश्वतायाक्षताय च ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003218049, "chapter_id": 23218, "verse_number": "१-२१-५०", "content_sanskrit": "पुरस्ताद्बृंहते चैव विभ्रांताय कृताय च  ।\nदुर्गमाय महेशाय क्रोधाय कपिलाय च ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003218050, "chapter_id": 23218, "verse_number": "१-२१-५१", "content_sanskrit": "तर्क्यातर्क्यशरीराय बलिने रंहसाय च  ।\nसिकत्याय प्रवाह्याय स्थिताय प्रसृताय च ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003218051, "chapter_id": 23218, "verse_number": "१-२१-५२", "content_sanskrit": "सुमेधसे कुलालाय नमस्ते शशिखंडिने  ।\nचित्राय चित्रवेषाय चित्रवर्णाय मेधसे ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003218052, "chapter_id": 23218, "verse_number": "१-२१-५३", "content_sanskrit": "चेकितानाय तुष्टाय नमस्ते निहिताय च  ।\nनमः क्षांताय दांताय वज्रसंहननाय च ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003218053, "chapter_id": 23218, "verse_number": "१-२१-५४", "content_sanskrit": "रक्षोघ्नाय विषघ्नाय शितिकंठोर्ध्वमन्यवे   ।\nलेलिहाय कृतांताय तिग्मायुधधराय च ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003218054, "chapter_id": 23218, "verse_number": "१-२१-५५", "content_sanskrit": "प्रमोदाय संमोदाय यतिवेद्याय ते नमः  ।\nअनामयाय सर्वाय महाकालाय वै नमः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003218055, "chapter_id": 23218, "verse_number": "१-२१-५६", "content_sanskrit": "प्रणवप्रणवेशाय भगनेत्रांतकाय च  ।\nमृगव्याधाय दक्षाय दक्षयज्ञांतकाय च ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003218056, "chapter_id": 23218, "verse_number": "१-२१-५७", "content_sanskrit": "सर्वभूतात्मभूताय सर्वेशाति शयाय च  ।\nपुरघ्नाय सुशस्त्राय धन्विनेऽथ परश्वधे ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003218057, "chapter_id": 23218, "verse_number": "१-२१-५८", "content_sanskrit": "पूषदंतविनाशाय भगनेत्रांतकाय च  ।\nकामदाय वरिष्ठाय कामांगदहनाय च ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003218058, "chapter_id": 23218, "verse_number": "१-२१-५९", "content_sanskrit": "रंगे करालवक्राय नागेंद्रवदनाय च  ।\nदैत्यानामंतकेशाय दैत्याक्रंदकराय च ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003218059, "chapter_id": 23218, "verse_number": "१-२१-६०", "content_sanskrit": "हिमघ्नाय च तीक्ष्णाय आर्द्रचर्मधराय च  ।\nश्मशानरतिनित्याय नमोस्तूल्मुकधारिणे ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003218060, "chapter_id": 23218, "verse_number": "१-२१-६१", "content_sanskrit": "नमस्ते प्राणपालाय मुंडमालाधराय च  ।\nप्रहीणशोकैर्विविधैर्भूतैः परिवृताय च ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003218061, "chapter_id": 23218, "verse_number": "१-२१-६२", "content_sanskrit": "नरनारीशरीराय देव्याः प्रियकराय च  ।\nजटिने मुंडिने चैव व्यालयज्ञोपवीतिने ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003218062, "chapter_id": 23218, "verse_number": "१-२१-६३", "content_sanskrit": "नमोऽस्तु नृत्यशीलाय उपनृत्यप्रियाय च  ।\nमन्यवे गीतशीलाय मुनिभिर्गायते नमः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003218063, "chapter_id": 23218, "verse_number": "१-२१-६४", "content_sanskrit": "कटकटाय तिग्माय अप्रियाय प्रियाय च  ।\nविभीषणाय भीष्माय भगप्रमथनाय च ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003218064, "chapter_id": 23218, "verse_number": "१-२१-६५", "content_sanskrit": "सिद्धसंघानुगीताय महाभागाय वै नमः  ।\nनमो मुक्ताट्टहासाय क्ष्वेडितास्फोटिताय च ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003218065, "chapter_id": 23218, "verse_number": "१-२१-६६", "content_sanskrit": "नर्दते कूर्दते चैव नमः प्रमुदितात्मने  ।\nनमो मॄडाय श्वसते धावतेऽधिष्ठिते नमः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003218066, "chapter_id": 23218, "verse_number": "१-२१-६७", "content_sanskrit": "ध्यायते जृंभते चैव रुदते द्रवते नमः  ।\nवल्गते क्रीडते चैव लंबोदरशरीरिणे ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003218067, "chapter_id": 23218, "verse_number": "१-२१-६८", "content_sanskrit": "नमोऽकृत्याय कृत्याय मुंडाय कीकटाय च  ।\nनम उन्मत्तदेहाय किंकिणीकाय वै नमः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003218068, "chapter_id": 23218, "verse_number": "१-२१-६९", "content_sanskrit": "नमो विकृतवेषाय क्रूरायामर्षणाय च  ।\nअप्रमेयाय गोप्त्रे च दीप्तायानिर्गुणाय च ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003218069, "chapter_id": 23218, "verse_number": "१-२१-७०", "content_sanskrit": "वामप्रियाय वामाय चूडामणिधराय च  ।\nनमस्तोकाय तनवे गुणैरप्रमिताय च ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003218070, "chapter_id": 23218, "verse_number": "१-२१-७१", "content_sanskrit": "नमो गुण्याय गुह्याय अगम्यगमनाय च  ।\nलोकधात्री त्वियं भूमिः पादौ सज्जनसेवितौ ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003218071, "chapter_id": 23218, "verse_number": "१-२१-७२", "content_sanskrit": "सर्वेषां सिद्धियोगानामधिष्ठानं तवोदरम्  ।\nमध्येऽन्तरिक्षं विस्तीर्णं तारागणविभूषितम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003218072, "chapter_id": 23218, "verse_number": "१-२१-७३", "content_sanskrit": "स्वातेः पथ इवाभाति श्रीमान् हारस्तवोरसि  ।\nदिशो दशभुजास्तुभ्यं केयूरांगदभूषिताः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003218073, "chapter_id": 23218, "verse_number": "१-२१-७४", "content_sanskrit": "विस्तीर्णपरिणाहश्च नीलांजनचयोपमः  ।\nकंठस्ते शोभते श्रीमान् हेमसूत्रविभूषितः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003218074, "chapter_id": 23218, "verse_number": "१-२१-७५", "content_sanskrit": "दंष्ट्राकरालं दुर्धर्षमनौपम्यं मुखं तथा  ।\nपद्ममालाकृतोष्णीषं शिरो द्यौः शोभतेऽधिकम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003218075, "chapter_id": 23218, "verse_number": "१-२१-७६", "content_sanskrit": "दीप्तिः सूर्ये वपुश्चंद्रे स्थैर्यं शैलेऽनिले बलम्  ।\nऔष्ण्यमग्नौ तथा शैत्यमप्सु शब्दोऽम्बरे तथा ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003218076, "chapter_id": 23218, "verse_number": "१-२१-७७", "content_sanskrit": "अक्षरांतरनिष्पंदाद्गुणानेतान्विदुर्बुधाः  ।\nजपो जप्यो महादेवो महायोगोमहेश्वरः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003218077, "chapter_id": 23218, "verse_number": "१-२१-७८", "content_sanskrit": "पुरेशयो गुहावासी खेचरो रजनीचरः  ।\nतपोनिधिर्गुहगुरुर्नंदनो नंदवर्धनः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003218078, "chapter_id": 23218, "verse_number": "१-२१-७९", "content_sanskrit": "हयशीर्षा पयोधाता विधाता भूतभावनः  ।\nबोद्धव्यो बोधिता नेता दुर्धर्षो दुष्प्रकंपनः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003218079, "chapter_id": 23218, "verse_number": "१-२१-८०", "content_sanskrit": "बृहद्रथो भीमकर्मा बृहत्कीर्तिर्धनंजयः  ।\nघंटाप्रियो ध्वजी छत्री पिनाकी ध्वजिनीपतिः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003218080, "chapter_id": 23218, "verse_number": "१-२१-८१", "content_sanskrit": "कवची पाट्टिशी खङ्गी धनुर्हस्तः परमश्वधी  ।\nअघस्मरोऽनघः शूरो देवराजोऽरिमर्दनः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003218081, "chapter_id": 23218, "verse_number": "१-२१-८२", "content_sanskrit": "त्वां प्रसाद्य पुरास्माभिर्द्विषंतो निहता युधि  ।\nअग्निः सदार्णवांभस्त्वं पिबन्नपि न तृप्यसे ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003218082, "chapter_id": 23218, "verse_number": "१-२१-८३", "content_sanskrit": "क्रोधाकारः प्रसन्नात्मा कामदः कामगः प्रियः  ।\nब्रह्मचारि चागाधश्च ब्रह्मण्यः शिष्टपूजितः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003218083, "chapter_id": 23218, "verse_number": "१-२१-८४", "content_sanskrit": "देवानामक्षयः कोशस्त्वया यज्ञः प्रकल्पितः  ।\nहव्यं तवेदं वहति वेदोक्तं हव्यवाहनः  ।\nप्रीति त्वयि महादेव वयं प्रीति भवामहे ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003218084, "chapter_id": 23218, "verse_number": "१-२१-८५", "content_sanskrit": "भवानीशोऽनादिमांस्त्वं च सर्वलोकानां त्वं ब्रह्मकर्तादिसर्गः  ।\nसांख्याः प्रकृतेः परमं त्वां विदित्वा क्षीणध्यानास्त्वाममृत्युं विशंति ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003218085, "chapter_id": 23218, "verse_number": "१-२१-८६", "content_sanskrit": "योगाश्च त्वां ध्यायिनो नित्यसिद्धं ज्ञात्वा योगान् संत्यजन्ते पुनस्तान्  ।\nये चाप्यन्ये त्वां प्रसन्ना विशुद्धाः स्वकर्मभिस्ते दिव्यभोगा भवंति ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003218086, "chapter_id": 23218, "verse_number": "१-२१-८७", "content_sanskrit": "अप्रसंख्येयतत्त्वस्य यथा विद्मः स्वशक्तितः  ।\nकीर्तितं तव माहात्म्यमपारस्य महात्मनः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003218087, "chapter_id": 23218, "verse_number": "१-२१-८८", "content_sanskrit": "शिवो नो भव सर्वत्र योऽसि सोऽसि नमोऽस्तु ते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003218088, "chapter_id": 23218, "verse_number": "१-२१-८९", "content_sanskrit": "सूत उवाच  ।\nय इदं कीर्तयेद्भक्त्या ब्रह्मनारायणस्तवम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003218089, "chapter_id": 23218, "verse_number": "१-२१-९०", "content_sanskrit": "श्रावयेद्वा द्विजान् विद्वान् श्रृणुयाद्वा समाहितः  ।\nअश्वमेधायुतं कृत्वा यत्फलं तदवाप्नुयात् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003218090, "chapter_id": 23218, "verse_number": "१-२१-९१", "content_sanskrit": "पापाचारोऽपि यो मर्त्यः श्रृणुयाच्छिवसन्निधौ  ।\nजपेद्वापि विनिर्मुक्तो ब्रह्मलोकं स गच्छति ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003218091, "chapter_id": 23218, "verse_number": "१-२१-९२", "content_sanskrit": "श्राद्धे वा दैविके कार्ये यज्ञे वावभृथांतिके  ।\nकीर्तयेद्वा सतां मध्ये स याति ब्रह्मणोंतिकम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}]