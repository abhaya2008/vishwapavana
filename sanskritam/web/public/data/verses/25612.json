[{"id": 7005612000, "chapter_id": 25612, "verse_number": "८५-१", "content_sanskrit": "गुडपर्वतदानवर्णनम् ।\nईश्वर उवाच ।\nअतः परं प्रवक्ष्यामि गुडपर्वतमुत्तमम् ।\nयत्प्रदानान्नरः स्वर्गमाप्नोति सुरपुजितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005612001, "chapter_id": 25612, "verse_number": "८५-२", "content_sanskrit": "उत्तमो दशभिर्भारैर्मध्यमः पञ्चभिर्मतः ।\nत्रिभिर्भारैः कनिष्ठः स्यात्तदर्धेनाल्पवित्तवान् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005612002, "chapter_id": 25612, "verse_number": "८५-३", "content_sanskrit": "तद्वदामन्त्रणं पूजां हेमवृक्षसुरार्चनम् ।\nविष्कम्भपर्वतास्तद्वत्सरांसि वनदेवताः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005612003, "chapter_id": 25612, "verse_number": "८५-४", "content_sanskrit": "होमजागरणं तद्वल्लोकपालाधिवासनम् ।\nधान्यपर्वतवत् कुर्यादिमं मन्त्रमुदीरयेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005612004, "chapter_id": 25612, "verse_number": "८५-५", "content_sanskrit": "यथा देवेषु विश्वात्मा प्रवरोऽयं जनार्दनः ।\nसामवेदस्तु वेदानां महादेवस्तु योगिनाम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005612005, "chapter_id": 25612, "verse_number": "८५-६", "content_sanskrit": "प्रणवः सर्वमन्त्राणां नारीणां पार्वती यथा ।\nतथा रसानां प्रवरः सदैवेक्षुरसोमतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005612006, "chapter_id": 25612, "verse_number": "८५-७", "content_sanskrit": "मम तस्मात्‌ परां लक्ष्मी गुडपर्वत! देहि वै ।\nयस्मात्‌ सौभाग्यदायिन्या भ्राता त्वं गुडपर्वता ।\nनिवासश्चापि पार्वत्यास्तस्माच्छान्तिं प्रयच्छ मे ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005612007, "chapter_id": 25612, "verse_number": "८५-८", "content_sanskrit": "अनेन विधिना यस्तु दद्याद्‌गुडमयं गिरिम् ।\nपूज्यमानः सगन्धर्वै गौरीलोके महीयते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005612008, "chapter_id": 25612, "verse_number": "८५-९", "content_sanskrit": "ततः कल्पशतान्ते तु सप्तद्वीपाधिपो भवेत् ।\nआयुरारोग्यसम्पन्नः शत्रुभिश्चापराजितः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]