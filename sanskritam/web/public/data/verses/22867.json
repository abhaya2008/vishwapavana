[{"id": 7002867000, "chapter_id": 22867, "verse_number": "९-१५२-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nअथातः संप्रवक्ष्यामि धेनूनां कल्पना नृप ।\nविशेषविधिना याश्च देयाः कामानभीप्सुभिः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002867001, "chapter_id": 22867, "verse_number": "९-१५२-२", "content_sanskrit": "कामं यद्दीयते दानं समग्रं तत्सुखावहम् ।\nअसमग्रं तु दोषाय भवतीह परत्र च ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002867002, "chapter_id": 22867, "verse_number": "९-१५२-३", "content_sanskrit": "तस्मान्न दक्षिणाहीनं विधानविकलं तथा ।\nदेयं दानं महाराज समग्रफलकाम्यया ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002867003, "chapter_id": 22867, "verse_number": "९-१५२-४", "content_sanskrit": "अन्यथा दीयमानं तदहंकाराय केवलम् ।\nप्रत्यक्षं चार्थहानिः स्यान्न वा तत्फलदं भवेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002867004, "chapter_id": 22867, "verse_number": "९-१५२-५", "content_sanskrit": "तिलधेनुं प्रवक्ष्यामि शृणु पार्थिवसत्तम ।\nवाराहेण पुरा प्रोक्तां महापातकनाशिनीम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002867005, "chapter_id": 22867, "verse_number": "९-१५२-६", "content_sanskrit": "यां दत्त्वा ब्रह्महा गोघ्नः पितृहा गुरुतल्पगः ।\nअगारदाही गरदः सर्वपापरतोपि वा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002867006, "chapter_id": 22867, "verse_number": "९-१५२-७", "content_sanskrit": "महापातकयुक्तश्च संयुक्तश्चोपपातकैः ।\nमुच्यते ह्यखिलैः पापैः स्वर्गलोकं च गच्छति ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002867007, "chapter_id": 22867, "verse_number": "९-१५२-८", "content_sanskrit": "अनुलिप्ते महीपृष्ठे कृष्णाजिनसमावृते ।\nधेनुं तिलमयीं कृत्वा दर्भानास्तीर्य सर्वतः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002867008, "chapter_id": 22867, "verse_number": "९-१५२-९", "content_sanskrit": "तिलाः श्वेतास्तिलाः कृष्णास्तिला गोमूत्रवर्णकाः ।\nतिलानां च विचित्राणां धेनुं सर्वां च कारयेत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002867009, "chapter_id": 22867, "verse_number": "९-१५२-१०", "content_sanskrit": "द्रोणस्य वत्सकं कुर्याच्चतुराढकिकां च गाम् ।\nस्वर्णशृंगीं रौप्यखुरां गन्धवर्णवतीं तथा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002867010, "chapter_id": 22867, "verse_number": "९-१५२-११", "content_sanskrit": "कार्या शर्करया जिह्वा गुडेनास्यं च कम्बलः ।\nइक्षुपादां ताम्रपृष्ठीं शुक्तिमुक्ताफलेक्षणाम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002867011, "chapter_id": 22867, "verse_number": "९-१५२-१२", "content_sanskrit": "प्रशस्तपत्रश्रवणां फलदंतवतीं शुभाम् ।\nस्रग्दामपुच्छां कुर्वीत नव नीतस्तनान्विताम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002867012, "chapter_id": 22867, "verse_number": "९-१५२-१३", "content_sanskrit": "सितवस्त्रशिरालम्बां सितसर्षपरोमिकाम् ।\nफलैर्मनोहरैरन्नैर्मणिमुक्ताफलान्विताम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002867013, "chapter_id": 22867, "verse_number": "९-१५२-१४", "content_sanskrit": "ईदृक्संस्थानसम्पन्नां कृत्वा श्रद्धासमन्वितः ।\nकांस्योपदोहनां दद्यात्पर्वकाले समागते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002867014, "chapter_id": 22867, "verse_number": "९-१५२-१५", "content_sanskrit": "या लक्ष्मीः सर्वभूतानां या वै देवेष्ववस्थिता ।\nधेनुरूपेण सा देवी मम पापं व्यपोहतु ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002867015, "chapter_id": 22867, "verse_number": "९-१५२-१६", "content_sanskrit": "ततः प्रदक्षिणां कृत्वा पूजयित्वा प्रणम्य च ।\nसदक्षिणा मया तुभ्यं दत्तेत्युक्त्वा विसर्जयेत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002867016, "chapter_id": 22867, "verse_number": "९-१५२-१७", "content_sanskrit": "अनेन विधिना दत्त्वा तिलधेनुं नराधिप ।\nसर्वपापविनिर्मुक्तो परं ब्रह्माधिगच्छति ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002867017, "chapter_id": 22867, "verse_number": "९-१५२-१८", "content_sanskrit": "यश्च गृह्णाति विधिवद्दीयमानां प्रमोदते ।\nदीयमानां प्रशंसंति ये च संहृष्टमानसाः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002867018, "chapter_id": 22867, "verse_number": "९-१५२-१९", "content_sanskrit": "तेपि दोषविनिर्मुक्ता ब्रह्मलोकं व्रजंति ते ।\nप्रशांताय सुशीलाय वेदव्रतरताय च ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002867019, "chapter_id": 22867, "verse_number": "९-१५२-२०", "content_sanskrit": "धेनुं तिलमयीं दत्त्वा न शोचति कृताकृते ।\nत्रिरात्रं यस्तिलाहारस्तिलधेनुप्रदो भवेत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002867020, "chapter_id": 22867, "verse_number": "९-१५२-२१", "content_sanskrit": "एकाहमथ वा राजन्न युच्छेदन्तरात्मना ।\nदानाद्विशुद्धिः पापस्य तस्य पुण्यवतो नृप ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002867021, "chapter_id": 22867, "verse_number": "९-१५२-२२", "content_sanskrit": "चान्द्रायणादभ्यधिकं कथितं तिलभक्षणम् ।\nबालत्वे चैव यत्पापं यौवने वार्द्धके तथा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002867022, "chapter_id": 22867, "verse_number": "९-१५२-२३", "content_sanskrit": "वाचा कृतं तु मनसा कर्मणा यच्च संचितम् ।\nउदकष्ठीवने चैव नग्नस्नानेन यद्भवेत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002867023, "chapter_id": 22867, "verse_number": "९-१५२-२४", "content_sanskrit": "मुशलेनोद्यते नापि लंबिते ब्राह्मणे तथा ।\nवृषलीगमने चैव गुरुदाराभिगामिनि ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002867024, "chapter_id": 22867, "verse_number": "९-१५२-२५", "content_sanskrit": "सुरापानेन यत्पापमभक्ष्यस्य च भक्षणात् ।\nतत्सर्वं विलयं याति तिलधेनुप्रदायिनाम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002867025, "chapter_id": 22867, "verse_number": "९-१५२-२६", "content_sanskrit": "यममार्गे महाघोरे नदी वैतरणी स्मृता ।\nवालुकायाः स्थलं चैव पच्यते यत्र पापिनः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002867026, "chapter_id": 22867, "verse_number": "९-१५२-२७", "content_sanskrit": "यत्र लोहमुखाः काका यत्र श्वानो भयावहाः ।\nनिकृत्य पापिनां मांसं भक्षयंति बुभुक्षिताः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002867027, "chapter_id": 22867, "verse_number": "९-१५२-२८", "content_sanskrit": "असिपत्रवनं चैव लोहकंटकशाल्मलीम् ।\nएतान्सर्वानतिक्रम्य ततो यमपुरं व्रजेत् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002867028, "chapter_id": 22867, "verse_number": "९-१५२-२९", "content_sanskrit": "विमाने कांचने दिव्ये मणिरत्नविभूषिते ।\nतत्रारुह्य नरश्रेष्ठो गच्छते परमाङ्गतिम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002867029, "chapter_id": 22867, "verse_number": "९-१५२-३०", "content_sanskrit": "गुणहीने न दातव्या न दातव्या धनेश्वरे ।\nकुण्डे गोले च लुब्धे च न च देया कदापि सा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002867030, "chapter_id": 22867, "verse_number": "९-१५२-३१", "content_sanskrit": "एका एकस्य दातव्या मुनिभिः कथितं पुरा ।\nअरण्ये नैमिषे पार्थ नारदेन निवेदितम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002867031, "chapter_id": 22867, "verse_number": "९-१५२-३२", "content_sanskrit": "तत्तेहं संप्रवक्ष्यामि सम्यक्फलसहस्रदम् ।\nइदं पुण्यं पवित्रं च माङ्गल्यं कीर्तिवर्धनम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002867032, "chapter_id": 22867, "verse_number": "९-१५२-३३", "content_sanskrit": "विप्राणां श्रावयेच्छ्राद्धे अनन्तफलमश्नुते ।\nबहुभ्यो न प्रदेयानि गौर्गृहं शयनं स्त्रियः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002867033, "chapter_id": 22867, "verse_number": "९-१५२-३४", "content_sanskrit": "विभज्यमानान्येतानि दातारं पातयंत्यधः ।\nसा तु विक्रयमापन्ना दहत्यासप्तमं कुलम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002867034, "chapter_id": 22867, "verse_number": "९-१५२-३५", "content_sanskrit": "अस्या दानप्रभावेन विमानं सर्वकामिकम् ।\nसमारुह्य नरो याति यत्र देवो हरिः स्वयम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002867035, "chapter_id": 22867, "verse_number": "९-१५२-३६", "content_sanskrit": "एषा चैव प्रदातव्या प्रयतेनान्तरात्मना ।\nपौर्णमास्यां च माघस्य कार्तिक्यां चैव भारत ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002867036, "chapter_id": 22867, "verse_number": "९-१५२-३७", "content_sanskrit": "चन्द्रसूर्योपरागे तु विषुवे अयने तथा ।\nषडशीतिमुखे चैव व्यतीपाते तु सर्वदा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002867037, "chapter_id": 22867, "verse_number": "९-१५२-३८", "content_sanskrit": "वैशाख्यां मार्गशीर्ष्यां वा गजच्छायासु चैव हि ।\nएषा ते कथिता पार्थ तिलधेनुर्मयानघ ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002867038, "chapter_id": 22867, "verse_number": "९-१५२-३९", "content_sanskrit": "यावंति धेनो रोमणि गात्रेषु नृपपुङ्गव ।\nतावद्वर्षसहस्राणि तदा स्वर्गे महीयते ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002867039, "chapter_id": 22867, "verse_number": "९-१५२-४०", "content_sanskrit": "यश्च गृह्णाति विधिवद्दीयमानां च पश्यति ।\nअनुमोदयते चैव ते सर्वे स्वर्गगामिनः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002867040, "chapter_id": 22867, "verse_number": "९-१५२-४१", "content_sanskrit": "धेनुं धनाधिपतयो मगधोद्भवेन मानेन ये तिलमयीं चतुराढकेन ।\nकृत्वा यथोक्तरचनां कृतचारुवत्सां यच्छंति ते भुवि भवंति विमुक्तपापाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002867041, "chapter_id": 22867, "verse_number": "९-१५२-४२", "content_sanskrit": "प्रतिगृह्णामि देवि त्वां कुटुंबभरणाय च ।\nकामं देया दयास्मभ्यं धेनो त्वं सर्वदा ह्यसि ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]