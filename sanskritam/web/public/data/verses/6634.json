    "avatarnika": ""
  },
  {
    "id": 20006164,
    "chapter_id": 6634,
    "verse_number": "4.35",
    "content_sanskrit": "वनस्पतिस्कन्धनिषण्णबालप्रवालहस्ताः प्रमदा इवात्र । पुष्पेक्षणैलम्भितलोचकैर्वा मधुव्रतव्रातवृतैर्व्रतत्यः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20006165,
    "chapter_id": 6634,
    "verse_number": "4.36",
    "content_sanskrit": "विहगाः कदम्बसुरभाविह गाः कलयन्तनुक्षणमनेकलयम् । भ्रमयन्नुपैति मुहुरभ्रमयं पवनश्च धूतनवनीपवनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20006166,
    "chapter_id": 6634,
    "verse_number": "4.37",
    "content_sanskrit": "विद्वद्भिरागमपरैर्विवृतं कथञ्चिच्छ्रुत्वापि दुर्ग्रहमनिश्चितधीभिरन्यैः । श्रेयान्द्विजातिरिव हन्तुमघानि दक्षं गूठार्थमेष निधिमन्त्रगणं बिभर्ति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20006167,
    "chapter_id": 6634,
    "verse_number": "4.38",
    "content_sanskrit": "बिम्बोष्ठं बहु मनुते तुरङ्गवक्त्रश्चुम्बन्तं मुखमिह किंनरं प्रियायाः । श्लिष्यन्तंमुहुरितरोऽपि तं निजस्त्रीमुत्तुङ्गस्तनभरभङ्गभीरुमध्याम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20006168,
    "chapter_id": 6634,
    "verse_number": "4.39",
    "content_sanskrit": "यदेतदस्यानुतटं विभाति वनं ततानेकतमालतालम् । न पुष्पितात्र स्थगितार्करस्मावनान्तताने कतमा लतालम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20006169,
    "chapter_id": 6634,
    "verse_number": "4.40",
    "content_sanskrit": "दन्तोज्ज्वलासु विमलोपलमेखलान्ताः सद्रत्नचित्रकटकासु बृहन्नितम्बाः । अस्मिन्भजन्ति घनकोमलगण्डशैला नार्योऽनुरूपमधिवासमधित्यकासु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20006170,
    "chapter_id": 6634,
    "verse_number": "4.41",
    "content_sanskrit": "अनतिचिरोज्झितस्य जलदेन चिरस्थितबुद्ध्युदयस्य पयसोऽनुकृतिम् । विरलविकीर्णवज्रशकला सकलामिह विदधाति धौतकलधौतमही ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20006171,
    "chapter_id": 6634,
    "verse_number": "4.42",
    "content_sanskrit": "वर्जयन्त्या जनैः संगमेकान्ततस्तर्कयन्त्या सुखं सङ्गमे कान्ततः । योषयैष स्मरासन्नतापाङ्गया सेव्यतेऽनेकया संन्नतापङ्गया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20006172,
    "chapter_id": 6634,
    "verse_number": "4.43",
    "content_sanskrit": "संकीर्णकीचकवनस्खलितैकवालविच्छेदकातरधियश्चलितुं चमर्यः । अस्मिन्मृदुश्वसनगर्भतदीयरन्ध्रर्यत्स्वनश्रुतिसुखादिव नोत्सहन्ते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20006173,
    "chapter_id": 6634,
    "verse_number": "4.44",
    "content_sanskrit": "मुक्तं मुक्तागौरमिह क्षीरमिवाभ्रैर्वापीष्वन्तर्लीनमहानीलदलासु । शस्त्रीश्यामैरंशुभिराशु द्रुतमम्भश्छायामच्छामृच्छति नीलीसलिलस्य ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20006174,
    "chapter_id": 6634,
    "verse_number": "4.45",
    "content_sanskrit": "या न ययौ प्रियमन्यवधूभ्यः सारतरागमना यतमानम् । तेन सहेत बिभर्ति रसः स्त्री सा रतरागमनायतानाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20006175,
    "chapter_id": 6634,
    "verse_number": "4.46",
    "content_sanskrit": "भिन्नेषुरत्नकिरणैः किरणेष्विहेन्दोरुच्चावचैरुपगतेषु सहस्रसंख्यां । दोषापि नूनमहिमांशुरसौ किलेति व्याकोशकोकनदतां दधते नलिन्यः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20006176,
    "chapter_id": 6634,
    "verse_number": "4.47",
    "content_sanskrit": "अपशङ्कमङ्कपरिवर्तनोचिताश्चलिताः पुरः पतिमुपेतुमात्मजाः । अनुरोदितीव करुणेन पत्त्रिणां विरुतेन वत्सलतययैष निम्नगाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20006177,
    "chapter_id": 6634,
    "verse_number": "4.48",
    "content_sanskrit": "मधुकरविटपानमितास्तरुपङ्क्तीर्बिभ्रतःऽस्य विटपानमिताः । परिपाकपिशङ्गलतारजसा रोधश्चकास्ति कपिशं गलता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20006178,
    "chapter_id": 6634,
    "verse_number": "4.49",
    "content_sanskrit": "प्राग्भागतः पतदिहेदमुपत्यकासु शृङ्गारितायतमहेभकराभमम्भः । संलक्ष्यतेविविधरत्नकरानुविद्धमूर्ध्वप्रसारितसुराधिपचापचारु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20006179,
    "chapter_id": 6634,
    "verse_number": "4.50",
    "content_sanskrit": "दधाति च विकसद्विचित्रकल्पद्रुमकुसुमैरभिगुम्फितानिवैताः । क्षणमलघुविलम्बिपिच्छदाम्नः शिखरशिखाः शिखिशेखरानमुष्य ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20006180,
    "chapter_id": 6634,
    "verse_number": "4.51",
    "content_sanskrit": "सवधूकाः सुखिनोऽस्मन्ननवरतममन्दरामतामरसदृशः । नासेवन्ते रसवन्नवरतममन्दरागतामरसदृशः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20006181,
    "chapter_id": 6634,
    "verse_number": "4.52",
    "content_sanskrit": "आच्छाद्य पुष्पपटमेव महान्तमन्तरावर्तिभिर्गृहकपोतशिरोधराभैः । शस्वङ्गानि धूमरुचिमागुरवीं दधानैर्धूपायतीव पटलैर्नीरदानाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20006182,
    "chapter_id": 6634,
    "verse_number": "4.53",
    "content_sanskrit": "अन्योन्यव्यतिकरचारुभिर्विचित्रैरत्रस्यन्नवमणिर्जन्मभिर्मयूखैः । विस्मेरान्गगनसदः करोत्यमुष्मिन्नाकाशेरचितमभित्ति चित्रकर्म ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20006183,
    "chapter_id": 6634,
    "verse_number": "4.54",
    "content_sanskrit": "समीरशिशिरः शिरःसुवसता सता जवनिका निकानसुखिनाम् । बिभर्तिजनयन्नयं मुदमपामपायधवला वलाहकततीः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20006184,
    "chapter_id": 6634,
    "verse_number": "4.55",
    "content_sanskrit": "मैर्त्त्र्यादिचित्तपरिकर्मविदो विधाय क्लेशप्रहाणमिह लब्धसबीजयोगाः । ख्यातिं चसत्त्वपुरुषान्यतयाधिगम्य वाञ्चन्ति तामपि समाधिभृतः निरोद्धुम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20006185,
    "chapter_id": 6634,
    "verse_number": "4.56",
    "content_sanskrit": "मरकतमयमेदिनीषु भानोस्तरुविटपान्तरपातिनो मयूखाः । अवनतशितिकण्ठकण्ठलक्ष्मीमिह दधति श्फुरिताणुरेणुजालाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20006186,
    "chapter_id": 6634,
    "verse_number": "4.57",
    "content_sanskrit": "या बिभर्ति कलवल्लकीगुणस्वानमानमतिकालिमालया । नात्र कान्तमुपगीतया तया स्वानमानमति कालिमालया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20006187,
    "chapter_id": 6634,
    "verse_number": "4.58",
    "content_sanskrit": "सायं शशाङ्गकिरणाहतचन्द्रकान्तनिस्यन्दिनीरनिकरेण कृताभिषेकाः । अर्कोपलोल्लसितवह्निभिरह्नि तप्तास्तीव्रं महाव्रतमिवात्र चरनति वप्राः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20006188,
    "chapter_id": 6634,
    "verse_number": "4.59",
    "content_sanskrit": "एतस्मिन्नधिकपयःश्रियं वहन्त्यः संक्षोभं पवनभुवा जवेन नीताः । वाल्मीकेररहितरामलक्ष्मणानां साधर्म्यं दधति गिरां महासरस्यः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20006189,
    "chapter_id": 6634,
    "verse_number": "4.60",
    "content_sanskrit": "इह मुहुर्मुदितैः कलभै रवः प्रतिदिशं क्रियते कलभैरवः । स्फुरति चानुवनं चमरीचयः कनकरत्नभुवां च मरीचयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20006190,
    "chapter_id": 6634,
    "verse_number": "4.61",
    "content_sanskrit": "त्वक्साररन्ध्रपरिपूरणलब्धगीतिरस्मिन्नसौ मृदितपक्ष्मलरल्लकाङ्गः । कस्तूरिकामृगविमर्दसुगन्धिरेति रागीव सक्तिमधिकां विषयेषु वायुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20006191,
    "chapter_id": 6634,
    "verse_number": "4.62",
    "content_sanskrit": "प्रीत्यै यूनां व्यवहिततपनाः प्रौढद्वान्तं दिनमिह जलदाः । दोषामन्यं विदधाति सुरतक्रीडायासश्रमपटवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20006192,
    "chapter_id": 6634,
    "verse_number": "4.63",
    "content_sanskrit": "भग्ने निवासोऽयमिहास्य पुष्पैः सदानतः येन विषाणि नागः । तीव्राणि तेनोज्झति कोपितोऽसौ ससानतोयेन विषाणि नागः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20006193,
    "chapter_id": 6634,
    "verse_number": "4.64",
    "content_sanskrit": "प्रालेयशीतलमचलेश्वरमीश्वरोऽपि सान्द्रभचर्मवसनावरणाधिशेते । सर्वर्तुनिवृत्तिकरे निवसन्नुपैति न द्वन्द्वदुःखमिह किञ्चिदकिञ्चनोऽपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20006194,
    "chapter_id": 6634,
    "verse_number": "4.65",
    "content_sanskrit": "नवनगवनलेखाश्यामध्याभिराभिः स्फटिककटकभूमिनाटयत्येष शैलः । अहिपरिकरभाजो भास्मनैरङ्गरागैरधिगतधवलिम्नः शूलपाणेरभिख्याम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20006195,
