[
  {
    "id": 20006130,
    "chapter_id": 6634,
    "verse_number": "4.1",
    "content_sanskrit": "निशवासधूमं सहरत्नभार्भित्त्वोत्थितं भूमिमिवोरगाणां । नीलोपलस्यूतविचित्रधातुमसौ गिरिं रैवतकं ददर्श ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20006131,
    "chapter_id": 6634,
    "verse_number": "4.2",
    "content_sanskrit": "गुर्वीरजस्रं दृषदः समन्तादुपर्युपर्यम्बुमुचांवितानैः । विन्ध्यायमानं दिवसस्य भर्तुमार्गं पुना रोद्धुमिवोन्नमद्भिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20006132,
    "chapter_id": 6634,
    "verse_number": "4.3",
    "content_sanskrit": "क्रान्तं रुचा श्यामलिताभिरामंलताभिरामन्त्रितषट्पदाभिः । श्रितं शिलाश्यामलताभिरामं लताभिरामनत्रितषट्पदाभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20006133,
    "chapter_id": 6634,
    "verse_number": "4.4",
    "content_sanskrit": "सहस्रसंख्यैर्गगनं पादैर्भुवं व्याप्य वितिष्ठमानम् । विलोचनस्थानगतोष्णरश्मिनिशाकरं साधु हिरण्यगर्भम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20006134,
    "chapter_id": 6634,
    "verse_number": "4.5",
    "content_sanskrit": "क्वचिज्जलापायविपाण्डुराणि धौतोत्तरीयप्रतिमच्छवीनि । अभ्राणिबिभ्रामुमाङ्गसङ्गविभक्तभस्मानमिव स्मरारिम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20006135,
    "chapter_id": 6634,
    "verse_number": "4.6",
    "content_sanskrit": "छायां निजस्त्रीचटुलालसानां मदेन किञ्चिच्चटुलालसानाम् । कुर्वाणमुत्पिञ्जलजातपत्रैर्विहङ्गमानां जलजातपत्रै ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20006136,
    "chapter_id": 6634,
    "verse_number": "4.7",
    "content_sanskrit": "स्कन्धाधिरूढोज्ज्वलनीलकण्ठानुर्वीरुहः श्लिष्टतनूनहीन्द्रैः । प्रनर्तितानेकलताभुजाग्रान्रुद्राननेकानिव धारयन्तम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20006137,
    "chapter_id": 6634,
    "verse_number": "4.8",
    "content_sanskrit": "विलम्बिनीलोत्पलकर्णपूरा कपोलभित्तीरिव लोध्रगौरीः । नवोलपालङ्कृतसैकताभाः शुचीरपःशैवलनीर्दधानम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20006138,
    "chapter_id": 6634,
    "verse_number": "4.9",
    "content_sanskrit": "राजीवराजीवशलोलभृङ्गं मुष्णान्तमुष्णं ततिभिस्तरूणाम् । कान्तालकान्ता ललनाः सुराणां रक्षोभिरक्षेभितमुद्वहन्तम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20006139,
    "chapter_id": 6634,
    "verse_number": "4.10",
    "content_sanskrit": "मुदे मुरारेरमरैः सुमेरोरानीय यस्योपचितस्य शृङ्गैः । भवन्ति नोद्दामगिरां कवीनामुच्छ्रायसौन्दर्यगुणा मृषोद्याः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20006140,
    "chapter_id": 6634,
    "verse_number": "4.11",
    "content_sanskrit": "यतः परार्घ्यानि भृतान्यनूनै प्रस्थैर्मुहुर्भूरिभिरुच्चिखानि । आढ्यादिवप्रापणिकादजस्रं जग्राह रत्नान्यमितानि लोकः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20006141,
    "chapter_id": 6634,
    "verse_number": "4.12",
    "content_sanskrit": "अखिध्यतासन्नमुदग्रतापं रविं दधानेऽप्यरविन्दधाने । भृङ्गावलिर्यस्यतटे निपीतरसा नमत्तामरसा न मत्ता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20006142,
    "chapter_id": 6634,
    "verse_number": "4.13",
    "content_sanskrit": "यत्राधिरूढेनमहीरुहोच्चैरुन्निद्रपुष्पाक्षिसहस्रभाजा । सुराधिपाधिष्ठितहस्तिमल्ललीलां दधौ राजतगण्डशैलः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20006143,
    "chapter_id": 6634,
    "verse_number": "4.14",
    "content_sanskrit": "विभिन्नवर्णागरुडाग्रजेन सूर्यस्यरथ्याः परितः स्फुरन्त्या । रत्नैः पुनर्यत्र रुचं स्वामानिन्यिरे वंशकरीरनीलैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20006144,
    "chapter_id": 6634,
    "verse_number": "4.15",
    "content_sanskrit": "यत्रोज्झिताभिर्मुहुरम्बुवाहैः समुन्नमद्भिर्न समुन्नमद्भि । वनं बबाधे विषपावकोत्था विपन्नगानामविपन्नगानाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20006145,
    "chapter_id": 6634,
    "verse_number": "4.16",
    "content_sanskrit": "फलद्भिरुष्णांशुकराभिमर्शात्कर्शानवं धाम पतङ्गकान्तैः । शशंस यः पात्रगुणाद्गुणानां संक्रान्तिमाक्रान्तगुणातिरेकाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20006146,
    "chapter_id": 6634,
    "verse_number": "4.17",
    "content_sanskrit": "दृषटोऽपि शैलः स मुहुर्मुरारेरपूर्ववद्विस्मयमाततान । क्षणेक्षमे यन्नवतामुपैति तदेवरूपं रमणीयतायाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20006147,
    "chapter_id": 6634,
    "verse_number": "4.18",
    "content_sanskrit": "उच्चारणज्ञेऽथगिरादधानमुच्चा रणत्पक्षिगणास्तटीस्तम् । उत्कं धरं द्रष्टुमवेक्ष्य शौरिणुत्कन्धरं दारुक इत्युवाच ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20006148,
    "chapter_id": 6634,
    "verse_number": "4.19",
    "content_sanskrit": "आच्छादितायतददिगम्बरमुच्चकैर्गामाक्रम्यसंस्थितमुदग्रविशालशृङ्गम् । मूर्ध्निस्खलत्तुहिनदीधितिकोटिमेनमुद्वीक्ष्य को भुवि न विस्मयते नगेशम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20006149,
    "chapter_id": 6634,
    "verse_number": "4.20",
    "content_sanskrit": "उदयतिविततर्ःध्वरशमिरज्जावहिमरुचौ हिमधाम्नि याति चास्तम् । वहतिगिरिरयं विलम्बिधणटाद्वयपरिवारितवारणेन्द्रलीलाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20006150,
    "chapter_id": 6634,
    "verse_number": "4.21",
    "content_sanskrit": "वहति यः परितः कनकस्थलीः सहरिता लसमाननवांशुकः । अचलेषभवानिव राजते स हरितालसमाननवांशुकः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20006151,
    "chapter_id": 6634,
    "verse_number": "4.22",
    "content_sanskrit": "पाश्चात्यभागमिह सानुषु सन्निषण्णाः पश्यन्ति शान्तमलसान्द्रतरांशुजालम् । संपूर्णलब्धललनालापनोपमानमुत्सङ्गसह्गिहरिणमस्य मृगाङ्गमूर्तेः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20006152,
    "chapter_id": 6634,
    "verse_number": "4.23",
    "content_sanskrit": "कृत्वापुंवत्पादमुच्चैर्भृगुभ्यो मूर्ध्नि ग्राव्णां जर्जरा निर्झरौघाः । कुर्वन्ति द्यामुत्पतन्तः स्मरार्तस्वर्लोकस्त्रीगात्रनिर्णमत्र ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20006153,
    "chapter_id": 6634,
    "verse_number": "4.24",
    "content_sanskrit": "स्थगयन्त्यमूः शामितचातकार्तस्वरा जलदास्तडित्तुलितकान्तकार्तस्वराः । जगतीरिहस्फुरितचारुचामीकराः सवितुः कचित्कपिशयन्ति चामी कराः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20006154,
    "chapter_id": 6634,
    "verse_number": "4.25",
    "content_sanskrit": "उत्क्षिप्तमुच्छ्रितसितांशुकरावलम्बैरुत्तम्भितोडुभिरतिवतरां शिरोभिः । श्रद्धेयनिर्झरजलव्यपदेशमस्य विष्वक्तटेषु पतति स्फुटमन्तरीक्षम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20006155,
    "chapter_id": 6634,
    "verse_number": "4.26",
    "content_sanskrit": "एकत्रस्फटिकतटांशुभिन्ननीरा नीलाश्मद्युतिभिदुराम्भसोऽपरत्र । कालिन्दीजलजनितश्रियः श्रयन्ते वैदग्धीमिह सरितः सुरापगायाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20006156,
    "chapter_id": 6634,
    "verse_number": "4.27",
    "content_sanskrit": "इतस्ततःऽस्मिन्विलसन्ति मेरोः समानवप्रेमणिसानुरागाः । स्त्रियशच पत्यौ सुरसुन्दरीभिः समा नवप्रेमणिसानुरागाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20006157,
    "chapter_id": 6634,
    "verse_number": "4.28",
    "content_sanskrit": "उच्चैमहारजतराजिविराजितासौ दुर्वर्णभित्तिरिह सान्द्रसुधासवर्णा । अभ्येति भस्मपरिपाण्डुरितस्मरारेरुद्वह्निलोचनललामललाटलीलाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20006158,
    "chapter_id": 6634,
    "verse_number": "4.29",
    "content_sanskrit": "अयमतिजरठाः प्रकामगुर्वीरलघुविलम्बिपयोधरोपरुद्धाः । सततमसुगतामगम्यरूपाः परिणतदिक्करिकास्तटीर्बिभर्ति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20006159,
    "chapter_id": 6634,
    "verse_number": "4.30",
    "content_sanskrit": "धूमाकारं दधति पुरः सौवर्णे वर्णेनाग्नेः सदृशि तटे पश्यामी । श्यामीभूताः कुसुमसमूहोऽलीनां लीनामालीमिह तरवो बिभ्राणाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20006160,
    "chapter_id": 6634,
    "verse_number": "4.31",
    "content_sanskrit": "व्योमस्पृशः प्रथयता कलधौतभित्तीरुन्निद्रपुष्पचणचम्पकपिङ्गभासः । सौमेरवीमधिगतेन नितम्बशोभामेतेन भारतमिलावृतवद्विभाति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20006161,
    "chapter_id": 6634,
    "verse_number": "4.32",
    "content_sanskrit": "रुचिरचित्रतनूरुहशालिभिर्विचलितैः परितः प्रियकव्रजैः । विवधरत्नमयैरभिबात्यसाववयवैरिव जङ्गमतां गतैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20006162,
    "chapter_id": 6634,
    "verse_number": "4.33",
    "content_sanskrit": "कुशशयैरत्र जलाशयोषिता मुदारमन्ते कलभाविकस्वरैः । प्रगीयते सिद्धगणैश्च योषितामुदारम कलभाविकस्वरैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
