  {
    "id": 20006163,
    "chapter_id": 6634,
    "verse_number": "4.34",
    "content_sanskrit": "आसादितस्य तमसा नियतेर्नियोगादाकाङ्क्षतःपुनरपक्रमणेन कालम् । पत्युस्त्वषामिह महौषधयः कलत्रस्थानं परैननभिभूतममूर्वहन्ति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
