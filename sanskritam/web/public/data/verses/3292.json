[{"id": 2105910, "chapter_id": 3292, "verse_number": "१६-२१-१", "content_sanskrit": "वैशम्पायन उवाच।\nततस्तत्र मुनिश्रेष्ठा राजानं द्रष्टुमभ्ययुः।\nनारदः पर्वतश्चैव देवलश्च महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2105911, "chapter_id": 3292, "verse_number": "१६-२१-२", "content_sanskrit": "द्वैपायनः सशिष्यश्च सिद्धाश्चान्ये मनीषिणः।\nशतयूपश्च राजर्षिर्वृद्धः परमधार्मिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2105912, "chapter_id": 3292, "verse_number": "१६-२१-३", "content_sanskrit": "तेषां कुन्ती महाराज पूजां चक्रे यथाविधि।\nते चापि तुतुषुस्तस्यास्तापसाः परिचर्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2105913, "chapter_id": 3292, "verse_number": "१६-२१-४", "content_sanskrit": "तत्र धर्म्याः कथास्तात चक्रुस्ते परमर्षयः।\nरमयन्तो महात्मानं धृतराष्ट्रं जनाधिपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2105914, "chapter_id": 3292, "verse_number": "१६-२१-५", "content_sanskrit": "कथान्तरे तु कस्मिंश्चिद्देवर्षिर्नारदस्ततः।\nकथामिमामकथयत्सर्वप्रत्यक्षदर्शिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2105915, "chapter_id": 3292, "verse_number": "१६-२१-६x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2105916, "chapter_id": 3292, "verse_number": "१६-२१-६", "content_sanskrit": "पुरा प्रजापतिसमो राजाऽऽसीदकुतोभयः।\nसहस्रचित्यि इत्युक्तः शतयूपपितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2105917, "chapter_id": 3292, "verse_number": "१६-२१-७", "content_sanskrit": "स पुत्रे राज्यमासज्ज्यि ज्येष्ठे परमधार्मिके।\nसहस्रचित्यो धर्मात्मा प्रविवेश वनं नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2105918, "chapter_id": 3292, "verse_number": "१६-२१-८", "content_sanskrit": "स गत्वा तपसः पारं दीप्तस्य वसुधाधिपः।\nपुरंदरस्य संस्थानं प्रतिपेदे महाद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2105919, "chapter_id": 3292, "verse_number": "१६-२१-९", "content_sanskrit": "दृष्टपूर्वः स बहुशो राजन्सम्पतता मया।\nमहेन्द्रसदने राजा तपसा दग्धकिल्बिषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2105920, "chapter_id": 3292, "verse_number": "१६-२१-१०", "content_sanskrit": "तथा शैलालयो राजा भगत्तपितामहः।\nतपोबलेनैव नृपो महेन्द्रसदनं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2105921, "chapter_id": 3292, "verse_number": "१६-२१-११", "content_sanskrit": "तथा पृषध्रो राजाऽऽसीद्राजन्वज्रधरोपमः।\nस चापि तपसा लेभे नाकपृष्ठमितो गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2105922, "chapter_id": 3292, "verse_number": "१६-२१-१२", "content_sanskrit": "अस्मिन्नरण्ये नृपते मांधातुरपि चात्मजः।\nपुरुकुत्सो नृपः सिद्धिं महतीं समवाप्तवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2105923, "chapter_id": 3292, "verse_number": "१६-२१-१३", "content_sanskrit": "भार्या समभवद्यस्य नर्मदा सरितां वरा।\nसोस्मिन्नरण्ये नृपतिस्तपस्तप्त्वा दिवं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2105924, "chapter_id": 3292, "verse_number": "१६-२१-१४", "content_sanskrit": "शशलोमा च राजाऽऽसीद्राजन्परमधार्मिकः।\nसम्यगस्मिन्वने तप्त्वा ततो दिवमवाप्तवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2105925, "chapter_id": 3292, "verse_number": "१६-२१-१५", "content_sanskrit": "द्वैपायनप्रसादाच्च त्वमपीदं तपोवनम्।\nराजन्नवाप्य दुष्प्रापां सिद्धिमग्र्यां गमिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2105926, "chapter_id": 3292, "verse_number": "१६-२१-१६", "content_sanskrit": "त्वं चापि राजशार्दूल तपसोन्ते श्रिया वृतः।\nगान्धारीसहितो गन्ता गतिं तेषां महात्मनां", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2105927, "chapter_id": 3292, "verse_number": "१६-२१-१७", "content_sanskrit": "पाण्डुः स्मरति ते नित्यं बलहन्तुः समीपगः।\nत्वां सदैव महाराज श्रेयसा स च योक्ष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2105928, "chapter_id": 3292, "verse_number": "१६-२१-१८", "content_sanskrit": "तव शुश्रूषया चैव गान्धार्याश्च यशस्विनी।\nभर्तुः सलोकतां कुन्ती गमिष्यति वधूस्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2105929, "chapter_id": 3292, "verse_number": "१६-२१-१९", "content_sanskrit": "युधिष्ठिरस्य जननी स हि धर्मः सनातनः।\nवयमेतत्प्रपश्यामो नृपते दिव्यवक्षुषाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2105930, "chapter_id": 3292, "verse_number": "१६-२१-२०", "content_sanskrit": "प्रवेक्ष्यति महात्मानं विदुरश्च युधिष्ठिरम्।\nसंजयस्तदनुध्यानादितः स्वर्गमवाप्स्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2105931, "chapter_id": 3292, "verse_number": "१६-२१-२१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2105932, "chapter_id": 3292, "verse_number": "१६-२१-२१", "content_sanskrit": "एतच्छ्रुत्वा कौरवेन्द्रो महात्मा\nसार्धं पत्न्या प्रीतिमान्सम्बभूव।\nविद्वान्वाक्यं नारदस्य प्रशस्य\nचक्रे पूजां चातुलां नारदाय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2105933, "chapter_id": 3292, "verse_number": "१६-२१-२२", "content_sanskrit": "ततः सर्वे नारदं विप्रसङ्घाः\nसम्पूजयामासुरतीव राजन्।\nराज्ञः प्रीत्या धृतराष्ट्रस्य ते वै\nपुनःपुनः सम्प्रहृष्टास्तदानीम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2105934, "chapter_id": 3292, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्रमवासिकपर्वणि आश्रमवासपर्वणि एकविंशोऽध्यायः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]