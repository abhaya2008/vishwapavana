[{"id": 7003509000, "chapter_id": 23509, "verse_number": "१४९-१", "content_sanskrit": "अथ द्वारकामाहात्म्यम् ।\nसूत उवाच ।\nश्रीस्तुतस्वामिमाहात्म्यं श्रुत्वा धर्मपरायणा।\nपरितुष्टमना देवी वाक्यमेतदुवाच ह ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003509001, "chapter_id": 23509, "verse_number": "१४९-२", "content_sanskrit": "धरण्युवाच।\nएतच्छ्रुत्वा तु माहात्म्यं देव देववर प्रभो ।\nमम चित्तस्य परमा जाता शान्तिरनुत्तमा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003509002, "chapter_id": 23509, "verse_number": "१४९-३", "content_sanskrit": "नाराचधारावरणासिधारी सुररिपुवधकारी धरणीधरः।\nधृतशङ्खगदाब्जचक्रपाणिः स्वयमिह शास्त्रमुदावहत्प्रधानम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003509003, "chapter_id": 23509, "verse_number": "१४९-४", "content_sanskrit": "एवं हि गुणमाहात्म्यं स्तुतस्वामिनि मच्छ्रुतम् ।\nअस्माच्चेदं परं श्रेष्ठं तन्मे वद कृपानिधे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003509004, "chapter_id": 23509, "verse_number": "१४९-५", "content_sanskrit": "श्रीवराह उवाच ।\nएवं भूमे वरं श्रेष्ठे फुल्लपंकजमालिनि ।\nकथयिष्यामि चान्यत्ते गुह्यं पापभयापहम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003509005, "chapter_id": 23509, "verse_number": "१४९-६", "content_sanskrit": "द्वापरं युगमासाद्य यादवानां कुलोद्वहः ।\nशौरीति तत्र विख्यातो भविष्यति पिता मम ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003509006, "chapter_id": 23509, "verse_number": "१४९-७", "content_sanskrit": "द्वारकेति च विख्याता पुरी तत्र स्थिताऽभवत् ।\nया च देवपुरी रम्या विश्वकर्मविनिर्मिता ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003509007, "chapter_id": 23509, "verse_number": "१४९-८", "content_sanskrit": "पंचयोजनविस्तारा दशयोजनमायता ।\nवसाम्यत्र वरारोहे शतपञ्चसमास्तथा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003509008, "chapter_id": 23509, "verse_number": "१४९-९", "content_sanskrit": "भारावतरणं कृत्वा देवानां सुमहत्प्रियम् ।\nपुनरप्यागमिष्यामि स्वर्लोकं प्रति सुन्दरि ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003509009, "chapter_id": 23509, "verse_number": "१४९-१०", "content_sanskrit": "भविष्यति वरारोहे ईश्वरः सदृशो मम ।\nदुर्वासा इति विख्यातः शपिष्यति कुलं मम ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003509010, "chapter_id": 23509, "verse_number": "१४९-११", "content_sanskrit": "तस्य शापाभिसन्तापाद्द्वारकावासिनो धरे ।\nवृष्ण्यन्धकाश्च भोजाश्च गमिष्यन्ति यमक्षयम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003509011, "chapter_id": 23509, "verse_number": "१४९-१२", "content_sanskrit": "चन्द्रपाण्डुरसंकाशो वनमाली हलायुधः ।\nहलेनाकृष्य नगरं समुद्रं गमयिष्यति ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003509012, "chapter_id": 23509, "verse_number": "१४९-१३", "content_sanskrit": "नारायणवचः श्रुत्वा धर्मकामा वसुन्धरा ।\nउभौ तौ चरणौ गृह्य पुनः पप्रच्छ माधवी ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003509013, "chapter_id": 23509, "verse_number": "१४९-१४", "content_sanskrit": "धरण्युवाच ।\nलोकनाथोऽसि सर्वेषां देव मायाकरण्डक ।\nशपिष्यति कथं तत्र दुर्वासास्तद्वदस्व मे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003509014, "chapter_id": 23509, "verse_number": "१४९-१५", "content_sanskrit": "श्रीवराह उवाच ।\nतत्र जाम्बवती नाम मम पत्नी भविष्यति ।\nरूपयौवनसम्पन्ना मम भोगसमन्विता ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003509015, "chapter_id": 23509, "verse_number": "१४९-१६", "content_sanskrit": "तस्याः पुत्रो महाभागो रूपयौवनदर्पितः ।\nसांब इत्यभिविख्यातो ममैव सततं प्रियः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003509016, "chapter_id": 23509, "verse_number": "१४९-१७", "content_sanskrit": "तेनैव क्रीडमानेन कृत्वा गर्भमतथ्यतः  ।\nस पृष्टः परमश्रेष्ठ ऋषिरेषा प्रसोष्यति ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003509017, "chapter_id": 23509, "verse_number": "१४९-१८", "content_sanskrit": "पुत्रकामा त्वियं बाला मुने तत्प्रब्रवीहि मे ।\nसाम्बोऽयमिति च ज्ञात्वा स मुनिः कोपमूर्च्छितः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003509018, "chapter_id": 23509, "verse_number": "१४९-१९", "content_sanskrit": "उवाच तर्हि ते गर्भान्मुसलं कुलनाशनम् ।\nयेन वृष्ण्यन्धकाः सर्वे गमिष्यन्ति यमक्षयम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003509019, "chapter_id": 23509, "verse_number": "१४९-२०", "content_sanskrit": "श्रुत्वा दुर्वाससः शापं ते च सर्वे कुमारकाः ।\nशापेन सन्तप्तधियो मामूचुर्भयसंयुताः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003509020, "chapter_id": 23509, "verse_number": "१४९-२१", "content_sanskrit": "ततस्तानागतान्दृष्ट्वा कुमारान् पृष्टवानहम् ।\nते च मामब्रुवन्सर्वे यथावृत्तं समुत्सुकाः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003509021, "chapter_id": 23509, "verse_number": "१४९-२२", "content_sanskrit": "तच्च तेषां वचः श्रुत्वा प्रोक्तवानस्मि तच्छृणु ।\nभविष्यति न सन्देहो दुर्वासा यदुवाच ह ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003509022, "chapter_id": 23509, "verse_number": "१४९-२३", "content_sanskrit": "एवं ते कथितं भूमे वृष्ण्यादेः शापकारणम् ।\nतत्र स्थानानि मे भूमे कथ्यमानानि मे शृणु ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003509023, "chapter_id": 23509, "verse_number": "१४९-२४", "content_sanskrit": "द्वारकायां महाभागे वैष्णवानां सुखावहे ।\nअस्ति पंचसरो नाम गुह्यं क्षेत्रं परं मम ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003509024, "chapter_id": 23509, "verse_number": "१४९-२५", "content_sanskrit": "समुद्रतीरमुत्सृज्य मम कर्मसुखावहम् ।\nतत्र स्नानं तु कुर्वीत षष्ठकालोषितो नरः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003509025, "chapter_id": 23509, "verse_number": "१४९-२६", "content_sanskrit": "मोदते नाकपृष्ठे तु अप्सरोगणसंकुले ।\nअथात्र मुंचते प्राणान्क्षेत्रे पंचसरे मम ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003509026, "chapter_id": 23509, "verse_number": "१४९-२७", "content_sanskrit": "देवलोकं समुत्सृज्य मम लोके महीयते ।\nप्लक्षो वै तत्र सुश्रोणि शतशाखो महाद्रुमः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003509027, "chapter_id": 23509, "verse_number": "१४९-२८", "content_sanskrit": "सुफलैः शोभनैः कुम्भाकृतिभिर्बहुभिः फलैः ।\nबहवस्तत्र गच्छन्ति लाभलौल्येन मानवाः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003509028, "chapter_id": 23509, "verse_number": "१४९-२९", "content_sanskrit": "फलं न लभते कश्चिन्मुक्त्वा भागवतं नरम् ।\nलभन्ते ये फलं तत्र मुक्ताः पापेन कर्मणा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003509029, "chapter_id": 23509, "verse_number": "१४९-३०", "content_sanskrit": "ते लभन्ते परां सिद्धिं मम कर्मणि संस्थिताः ।\nप्रभासमिति विख्यातं तस्मिंस्तीर्थे परे मम ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003509030, "chapter_id": 23509, "verse_number": "१४९-३१", "content_sanskrit": "मनुजा यं न पश्यन्ति रागलोभसमन्विताः ।\nतत्र स्नानं प्रकुर्वीत पंचभक्तोषितो नरः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003509031, "chapter_id": 23509, "verse_number": "१४९-३२", "content_sanskrit": "मोदते सप्तद्वीपेषु गुह्यानि च स गच्छति ।\nअथ चेन्मुंचते प्राणान्प्रभाते गतकिल्बिषः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003509032, "chapter_id": 23509, "verse_number": "१४९-३३", "content_sanskrit": "सर्वसंगं परित्यज्य मम लोकं स गच्छति ।\nतत्राश्चर्यं महाभागे कथ्यमानं मया शृणु ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003509033, "chapter_id": 23509, "verse_number": "१४९-३४", "content_sanskrit": "प्रभासे यत्र शृण्वन्ति सागरे न म (ग) रं प्रति ।\nमकरास्तत्र दृश्यंते भ्रममाणा इतस्ततः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003509034, "chapter_id": 23509, "verse_number": "१४९-३५", "content_sanskrit": "न किंचिदपराध्यन्ति स्नायमाना जले ततः ।\nअथात्र प्रक्षिपेत्पिण्डान्प्रसन्ने सलिले नरः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003509035, "chapter_id": 23509, "verse_number": "१४९-३६", "content_sanskrit": "असम्प्राप्ते च गृह्णन्ति एवमेतन्न संशयः ।\nपापकर्मरतस्यापि न गृह्णन्ति जलं प्रति ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003509036, "chapter_id": 23509, "verse_number": "१४९-३७", "content_sanskrit": "धर्मात्मनां च गृह्णन्ति पिण्डमेव न संशयः ।\nपञ्चपिण्डमिति ख्यातं तस्मिन्गुह्यं परं मम ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003509037, "chapter_id": 23509, "verse_number": "१४९-३८", "content_sanskrit": "अगाधस्याप्यपारस्य क्रोशविस्तार एव च ।\nतत्राभिषकं कुर्वीत पञ्चकालोषितो नरः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003509038, "chapter_id": 23509, "verse_number": "१४९-३९", "content_sanskrit": "मोदते शक्रलोके स एवमेतन्न संशयः ।\nअथात्र मुञ्चते प्राणान्पञ्चकुण्डे यशस्विनि ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003509039, "chapter_id": 23509, "verse_number": "१४९-४०", "content_sanskrit": "शक्रलोकं परित्यज्य मम लोकं स गच्छति ।\nतत्राश्चर्यं महाभागे कथ्यमानं मया शृणु ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003509040, "chapter_id": 23509, "verse_number": "१४९-४१", "content_sanskrit": "न पश्येत्पापकर्मा वै शुभकर्मैव पश्यति ।\nचतुर्विंशतिद्वादश्यां मध्याह्ने च दिवाकरे ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003509041, "chapter_id": 23509, "verse_number": "१४९-४२", "content_sanskrit": "रौप्यं सुवर्णकं पद्मं दृश्यते नात्र संशयः ।\nक्षेत्रं संगमनं नाम तस्मिंस्तीर्थे परं मम ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003509042, "chapter_id": 23509, "verse_number": "१४९-४३", "content_sanskrit": "चतुर्धाराः पतन्त्यत्र मणिपूरगिरिं श्रिताः ।\nतत्राभिषेकं कुर्वीत चतुर्भक्तोषितो नरः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003509043, "chapter_id": 23509, "verse_number": "१४९-४४", "content_sanskrit": "वैखानसेषु लोकेषु मोदते नाऽत्र संशयः ।\nअथात्र मुंचते प्राणान्मम् भक्तिपरायणः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003509044, "chapter_id": 23509, "verse_number": "१४९-४५", "content_sanskrit": "त्यक्त्वा वैखानसाँल्लोकान्मम लोकं स गच्छति ।\nतत्रापि परमाश्चर्यं कथ्यमानं शृणुष्व मे ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003509045, "chapter_id": 23509, "verse_number": "१४९-४६", "content_sanskrit": "दृश्यन्ते यानि कुण्डेषु मणिपूरगिरौ तथा ।\nप्रक्षीयमाणे पापे तु  नयते तज्जलं भुवि ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003509046, "chapter_id": 23509, "verse_number": "१४९-४७", "content_sanskrit": "स्नायमानेषु पापेषु न पतेत्तद्यथा पुरा ।\nहंसकुण्डेति विख्यातं तस्मिन्क्षेत्रे परे मम ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003509047, "chapter_id": 23509, "verse_number": "१४९-४८", "content_sanskrit": "धारा चैका पतत्यत्र मणिपूरगिरौ श्रिता ।\nतत्राभिषेकं कुर्वीत षष्ठकालोषितो नरः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003509048, "chapter_id": 23509, "verse_number": "१४९-४९", "content_sanskrit": "मुक्तसंगो महाभागे मोदते वरुणालये ।\nअथाऽत्र मुंचते प्राणान् हंसकुण्डे वरानने ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003509049, "chapter_id": 23509, "verse_number": "१४९-५०", "content_sanskrit": "वारुणं लोकमुत्सृज्य मम लोके महीयते ।\nतत्राश्चर्यं प्रवक्ष्यामि हंसकुण्डे यशस्विनि ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003509050, "chapter_id": 23509, "verse_number": "१४९-५१", "content_sanskrit": "शुद्धाः पश्यन्ति मनुजाः पापकर्मा न पश्यति ।\nचतुर्विंशतिद्वादश्यां मध्याह्ने च दिवाकरे ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003509051, "chapter_id": 23509, "verse_number": "१४९-५२", "content_sanskrit": "हंसाश्चैवात्र दृश्यन्ते चन्द्रकुन्दसमप्रभाः ।\nहंसान्पश्यति यस्तत्र भ्रममाणानितस्ततः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003509052, "chapter_id": 23509, "verse_number": "१४९-५३", "content_sanskrit": "लभन्ते ते परां सिद्धिं धरे नास्त्यत्र संशयः ।\nकदम्बमिति विख्यातं तस्मिन्क्षेत्रे परं मम ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003509053, "chapter_id": 23509, "verse_number": "१४९-५४", "content_sanskrit": "वृष्णयो यत्र वै शुद्धाः संप्राप्ताश्च ममालयम् ।\nतत्राभिषेकं कुर्वीत चतुःकालोषितो नरः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003509054, "chapter_id": 23509, "verse_number": "१४९-५५", "content_sanskrit": "मोदते ऋषिलोकेषु पुण्यात्मा वै न संशयः ।\nअथात्र मुञ्चते प्राणान्कृत्वा कर्म सुदुष्करम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003509055, "chapter_id": 23509, "verse_number": "१४९-५६", "content_sanskrit": "ऋषिलोकं परित्यज्य मम लोकं प्रपद्यते ।\nतत्राश्चर्यं महाभागे कथ्यमानं शृणुष्व मे ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003509056, "chapter_id": 23509, "verse_number": "१४९-५७", "content_sanskrit": "कदम्बात्पतते धारा तत्र पूर्वविनिःसृता ।\nस कदम्बो महाभागे माघमासस्य द्वादशी ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003509057, "chapter_id": 23509, "verse_number": "१४९-५८", "content_sanskrit": "पुष्पाणि वै प्रकटयत्युदयस्थे दिवाकरे ।\nये वा लभन्ते तत्पुष्पं मम मार्गानुसारिणः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003509058, "chapter_id": 23509, "verse_number": "१४९-५९", "content_sanskrit": "ते लभन्ते परां सिद्धिमेवमेतन्न संशयः ।\nचक्रतीर्थमिति ख्यातं तस्मिन्क्षेत्रे परं मम ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003509059, "chapter_id": 23509, "verse_number": "१४९-६०", "content_sanskrit": "पंच धाराः पतन्त्यत्र मणिपूरसमाश्रिताः ।\nतत्राभिषेकं कुर्वीत पंचकालोषितो नरः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003509060, "chapter_id": 23509, "verse_number": "१४९-६१", "content_sanskrit": "दशवर्षसहस्राणि स्वर्गलोके स मोदते ।\nअथात्र मुंचते प्राणाँल्लोभमोहविवर्जितः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003509061, "chapter_id": 23509, "verse_number": "१४९-६२", "content_sanskrit": "सर्वान्स्वर्गान्समुत्सृज्य मम लोकं स गच्छति।\nतत्राश्चर्यं प्रवक्ष्यामि कथ्यमानं शृणुष्व मे ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003509062, "chapter_id": 23509, "verse_number": "१४९-६३", "content_sanskrit": "अन्यथैतन्न पश्यन्ति मम कर्मपरायणाः ।\nचतुर्विंशतिद्वादश्यामर्द्धरात्रे यशस्विनि ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003509063, "chapter_id": 23509, "verse_number": "१४९-६४", "content_sanskrit": "श्रूयते तत्र निर्घोषो मनःकर्णसुखावहः ।\nसुगन्धो वहते वायुर्बहुमाल्यसमन्वितः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003509064, "chapter_id": 23509, "verse_number": "१४९-६५", "content_sanskrit": "दुर्ल्लभः पापिनां चैव सुलभः पुण्यकर्मिणाम्।\nतस्य चोत्तरपार्श्वेन अशोकश्च महाद्रुमः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003509065, "chapter_id": 23509, "verse_number": "१४९-६६", "content_sanskrit": "पुष्प्यते सोऽथ तत्रापि सूर्ये चाभ्युदिते सति ।\nये तत्र लभते पुष्पं मम मार्गानुसारिणः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003509066, "chapter_id": 23509, "verse_number": "१४९-६७", "content_sanskrit": "ते लभन्ते परां सिद्धिं एवं भूमे न संशयः ।\nअस्ति रैवतकं नाम तस्मिन् क्षेत्रे परं मम ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003509067, "chapter_id": 23509, "verse_number": "१४९-६८", "content_sanskrit": "सर्वलोकेषु विख्यातं यत्र विक्रीडितं मया ।\nबहुगुल्मलताकीर्णं बहुपुष्पैश्च शोभितम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003509068, "chapter_id": 23509, "verse_number": "१४९-६९", "content_sanskrit": "बहुवर्णशिलापङ्क्तिर्गुहाश्चापि दिशो दश ।\nवाप्यश्च कन्दराश्चैव देवानामपि दुर्ल्लभाः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003509069, "chapter_id": 23509, "verse_number": "१४९-७०", "content_sanskrit": "तत्राभिषेकं कुर्वीत षष्ठकालोषितो नरः ।\nगच्छेत्तु सोमलोकं तु कृतकृत्यो न संशयः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003509070, "chapter_id": 23509, "verse_number": "१४९-७१", "content_sanskrit": "अथात्र मुंचते प्राणान्मम कर्मसु निष्ठितः ।\nसोमलोकं समुत्सृज्य मम लोकं प्रपद्यते ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003509071, "chapter_id": 23509, "verse_number": "१४९-७२", "content_sanskrit": "तत्राश्चर्यं महाभागे कथ्यमानं मया शृणु ।\nपश्यन्ति मनुजाः सर्वे धर्मकामा न संशयः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003509072, "chapter_id": 23509, "verse_number": "१४९-७३", "content_sanskrit": "पतन्ति सर्ववृक्षाणां पत्राणि सुबहून्यपि ।\nएकं चापि न दृश्येत प्रसन्नं याति तज्जलम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003509073, "chapter_id": 23509, "verse_number": "१४९-७४", "content_sanskrit": "स च पूर्वेण पार्श्वेन शोभते वै महाद्रुमः ।\nअपरो मम पार्श्वेन देवानामपि दुर्ल्लभः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003509074, "chapter_id": 23509, "verse_number": "१४९-७५", "content_sanskrit": "पंचक्रोशसुविस्तारः शोभते वै महाद्रुमः ।\nपद्मैश्चैवोत्पलैश्छन्नं सुगन्धिकुसुमैः सह ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003509075, "chapter_id": 23509, "verse_number": "१४९-७६", "content_sanskrit": "बहुमत्स्यजलाकीर्णं सर्वतस्तु फलान्वितम् ।\nशिलातलागुहाच्छन्नं सुगन्धिकुसुमैः सह॥ ७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003509076, "chapter_id": 23509, "verse_number": "१४९-७७", "content_sanskrit": "तत्राभिषेकं कुर्वीत अष्टभक्तोषितो नरः ।\nमोदते नन्दने दिव्ये अप्सरोभिः समन्विते ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003509077, "chapter_id": 23509, "verse_number": "१४९-७८", "content_sanskrit": "अत्राश्चर्यं महाभागे कथ्यमानं मया शृणु ।\nपश्यन्ति मनुजाः सर्वे धर्मकामा न संशयः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003509078, "chapter_id": 23509, "verse_number": "१४९-७९", "content_sanskrit": "मध्याह्ने च पुनः पूर्णश्चार्द्धरात्रे समो वहेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003509079, "chapter_id": 23509, "verse_number": "१४९-८०", "content_sanskrit": "वर्द्धते क्षीयते चैव यथैव च महोदधिः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003509080, "chapter_id": 23509, "verse_number": "१४९-८१", "content_sanskrit": "तस्य पश्चिमपार्श्वे तु बिल्वश्चैव महाद्रुमः ।\nचतुर्विंशतिद्वादश्यां स पुष्यति च निष्कलम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003509081, "chapter_id": 23509, "verse_number": "१४९-८२", "content_sanskrit": "पश्येत्तु शुभकर्मा च पापकर्मा न पश्यति ।\nदृश्यते च महाभागे अस्तमेते दिवाकरे ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003509082, "chapter_id": 23509, "verse_number": "१४९-८३", "content_sanskrit": "यस्तत्र लभते पुष्पं मम मार्गानुसारकः ।\nस लभेत परां सिद्धिमेवं भूमे न संशयः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003509083, "chapter_id": 23509, "verse_number": "१४९-८४", "content_sanskrit": "विष्णुसंक्रमणं नाम तस्मिन्क्षेत्रे परे मम ।\nविद्धोऽस्मि यत्र व्याधेन स्वमूर्त्तिं चास्थितः पुनः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003509084, "chapter_id": 23509, "verse_number": "१४९-८५", "content_sanskrit": "तत्र कुंडं महाभागे मणिपूरगिरा श्रुतम् ।\nधारा चैका पतत्यत्र लाभालाभविवर्जितः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003509085, "chapter_id": 23509, "verse_number": "१४९-८६", "content_sanskrit": "सूर्यलोकं समुत्सृज्य मम लोके महीयते ।\nतत्राश्चर्यं प्रवक्ष्यामि विष्णुं शत्रुगणेश्वरम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003509086, "chapter_id": 23509, "verse_number": "१४९-८७", "content_sanskrit": "पापिनां यस्तु दुर्दर्शः सुदृश्यः पुण्यचारिणाम् ।\nतस्य दक्षिणपार्श्वेन अश्वत्थो वै महाद्रुमः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003509087, "chapter_id": 23509, "verse_number": "१४९-८८", "content_sanskrit": "चतुर्विंशतिद्वादश्यां मध्याह्ने तु दिवाकरे ।\nफलते स यथान्यायं सर्वभागवतप्रियम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003509088, "chapter_id": 23509, "verse_number": "१४९-८९", "content_sanskrit": "उच्चश्चैव विशालश्च मनोज्ञश्चैव शीतलः ।\nये लभंते फलं तत्र मम मार्गानुसारिणः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003509089, "chapter_id": 23509, "verse_number": "१४९-९०", "content_sanskrit": "ते लभन्ते परां सिद्धिमेवमेतन्न संशयः ।\nतस्मिन् क्षेत्रे महाभागे तिष्ठामि चोत्तरामुखः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003509090, "chapter_id": 23509, "verse_number": "१४९-९१", "content_sanskrit": "सर्वभागवतप्रीतिं समुद्रतटमाश्रितः ।\nअहं रामेण सहितः सा चाप्येकादशी शुभा ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003509091, "chapter_id": 23509, "verse_number": "१४९-९२", "content_sanskrit": "त्रयस्तत्रैव तिष्ठामो द्वारकायां यशस्विनि ।\nतस्मिन् क्षेत्रे महाभागे त्रयो मोदामहे वयम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003509092, "chapter_id": 23509, "verse_number": "१४९-९३", "content_sanskrit": "त्रिंशद्योजनविस्तारः सर्वतस्तु दिशो दश ।\nतत्र गत्वा वरारोहे ये मां द्रक्ष्यन्ति भक्तितः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003509093, "chapter_id": 23509, "verse_number": "१४९-९४", "content_sanskrit": "अदीर्घेणैव कालेन प्राप्नुवंति परां गतिम् ।\nआख्यानानां महाख्यानं शान्तीनां शान्तिरुत्तमा ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003509094, "chapter_id": 23509, "verse_number": "१४९-९५", "content_sanskrit": "धर्माणां परमो धर्मो द्युतीनां परमा द्युतिः ।\nलाभानां परमो लाभः क्रियाणां परमा क्रिया ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003509095, "chapter_id": 23509, "verse_number": "१४९-९६", "content_sanskrit": "श्रुतीनां परमं श्रेष्ठं तपसा च परं तपः ।\nएतन्मरणकालेऽपि मा कदाचित्तु विस्मरेत् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003509096, "chapter_id": 23509, "verse_number": "१४९-९७", "content_sanskrit": "यदीच्छेत्परमां सिद्धिं मम लोकं स गच्छति ।\nय एतत्पठते भद्रे कल्यमुत्थाय मानवः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003509097, "chapter_id": 23509, "verse_number": "१४९-९८", "content_sanskrit": "सकुल्यास्तारितास्तेन सप्त सप्त च सप्त च।\nएतत्ते कथितं भद्रे द्वारकायाः सुनिश्चयम् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003509098, "chapter_id": 23509, "verse_number": "१४९-९९", "content_sanskrit": "उचितेनोपचारेण किमन्यत्परिपृच्छति ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}]