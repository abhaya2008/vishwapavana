[{"id": 2170248, "chapter_id": 4637, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2170249, "chapter_id": 4637, "verse_number": "१", "content_sanskrit": "एतस्मिन्नन्तरे कृष्णः पार्थं वचनमब्रवीत् ।\nदर्शयन्निव कौन्तेयं धर्मराजं युधिष्ठिरम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2170250, "chapter_id": 4637, "verse_number": "२", "content_sanskrit": "एष पाण्डव ते भ्राता धार्तराष्ट्रैर्महाबलैः ।\nजिघांसुभिर्महेष्वासैर्द्रुतं पार्थानुसार्यते\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2170251, "chapter_id": 4637, "verse_number": "३", "content_sanskrit": "तथानुयान्ति संरब्धाः पाञ्चाला युद्धदुर्मदाः ।\nयुधिष्ठिरं महात्मानं परीप्सन्तो महाजवाः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2170252, "chapter_id": 4637, "verse_number": "४", "content_sanskrit": "एष दुर्योधनः पार्थ रथानीकेन दंसितः ।\nराजा सर्वस्य लोकस्य राजानमनुधावति\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2170253, "chapter_id": 4637, "verse_number": "५", "content_sanskrit": "जिघांसुः पुरुषव्याघ्रं भ्रातृभिः सहितो बली ।\nआशीविषसमस्पर्शैः सर्वयुद्धविशारदैः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2170254, "chapter_id": 4637, "verse_number": "६", "content_sanskrit": "एते जिघृक्षवो यान्ति द्विपाश्वरथपत्तयः ।\nयुधिष्ठिरं धार्तराष्ट्रा रत्नोत्तममिवार्थिनः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2170255, "chapter_id": 4637, "verse_number": "७", "content_sanskrit": "पश्य सात्वतभीमाभ्यां निरुद्धाधिष्ठिताः पुनः ।\nजिहीर्षवोऽमृतं दैत्याः शक्राग्निभ्यामिवावशाः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2170256, "chapter_id": 4637, "verse_number": "८", "content_sanskrit": "एते बहुत्वात् त्वरिताः पुनर्गच्छन्ति पाण्डवम् ।\nसमुद्रमिव वार्योघाः प्रावृट्काले महारथाः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2170257, "chapter_id": 4637, "verse_number": "९", "content_sanskrit": "नदन्तः सिंहनादांश्च धमन्तश्चापि वारिजान् ।\nबलवन्तो महेष्वासा विधून्वन्तो धनूंषि च\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2170258, "chapter_id": 4637, "verse_number": "१०", "content_sanskrit": "मृत्योर्मुखगतं मन्ये कुन्तीपुत्रं युधिष्ठिरम् ।\nहुतमग्नौ च मन्येऽहं दुर्योधनवशं गतम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2170259, "chapter_id": 4637, "verse_number": "११", "content_sanskrit": "यथायुक्तमनीकं हि धार्तराष्ट्रस्य पाण्डव ।\nनास्य शक्रोऽपि मुच्येत सम्प्राप्तो बाणगोचरम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2170260, "chapter_id": 4637, "verse_number": "१२", "content_sanskrit": "दुर्योधनस्य शूरस्य द्रौणेः शारद्वतस्य च ।\nकर्णस्य चेषुवेगो वै पर्वतानपि दारयेत्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2170261, "chapter_id": 4637, "verse_number": "१३", "content_sanskrit": "दुर्योधनस्य शूरस्य शरौघान् शीघ्रमस्यतः ।\nसङ्क्रुद्धस्यान्तकस्येव को वेगं संसहेद् रणे\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2170262, "chapter_id": 4637, "verse_number": "१४", "content_sanskrit": "कर्णेन च कृतो राजा विमुखः शत्रुतापनः ।\nबलवाँल्लघुहस्तश्च कृती युद्धविशारदः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2170263, "chapter_id": 4637, "verse_number": "१५", "content_sanskrit": "राधेयः पाण्डवश्रेष्ठं शक्तः पीडयितुं रणे ।\nसहितो धृतराष्ट्रस्य पुत्रैः शूरो महात्मभिः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2170264, "chapter_id": 4637, "verse_number": "१६", "content_sanskrit": "तस्यैवं युध्यमानस्य सङ्ग्रामे संयतात्मनः ।\nअन्यैरपि च पार्थस्य हृतं वर्म महारथैः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2170265, "chapter_id": 4637, "verse_number": "१७", "content_sanskrit": "उपवासकृशो राजा भृशं भरतसत्तम ।\nब्राह्मे बले स्थितो ह्येष न क्षत्रेऽतिबले विभो\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2170266, "chapter_id": 4637, "verse_number": "१८", "content_sanskrit": "न जीवति महाराजो मन्ये पार्थ युधिष्ठिरः ।\nयद् भीमसेनः सहते सिंहनादममर्षणः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2170267, "chapter_id": 4637, "verse_number": "१९", "content_sanskrit": "नर्दतां धार्तराष्ट्राणां पुनः पुनररिन्दम ।\nधमतां च महाशङ्खान् सङ्ग्रामे जितकाशिनाम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2170268, "chapter_id": 4637, "verse_number": "२०", "content_sanskrit": "युधिष्ठिरं पाण्डवेयं हतेति भरतर्षभ ।\nसञ्चोदयत्यसौ कर्णो धार्तराष्ट्रान् महाबलान्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2170269, "chapter_id": 4637, "verse_number": "२१", "content_sanskrit": "स्थूणाकर्णेन्द्रजालेन पार्थ पाशुपतेन च ।\nप्रच्छादयन्तो राजानमनुयान्ति महारथाः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2170270, "chapter_id": 4637, "verse_number": "२२", "content_sanskrit": "आतुरो मे मतो राजा सन्निषेव्यश्च भारत\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2170271, "chapter_id": 4637, "verse_number": "२३", "content_sanskrit": "यथैनमनुवर्तन्ते पाञ्चालाः सह पाण्डवैः ।\nत्वरमाणास्त्वराकाले सर्वशस्त्रभृतां वराः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2170272, "chapter_id": 4637, "verse_number": "२४", "content_sanskrit": "मज्जन्तमिव पाताळे बलिनोऽप्युज्जिहीर्षवः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2170273, "chapter_id": 4637, "verse_number": "२५", "content_sanskrit": "न केतुर्दृश्यते राज्ञः कर्णेन निहतः शरैः ।\nपश्यतोर्यमयोः पार्थ सात्यकेश्च शिखण्डिनः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2170274, "chapter_id": 4637, "verse_number": "२६", "content_sanskrit": "धृष्टद्युम्नस्य भीमस्य शतानीकस्य वा विभो ।\nपाञ्चालानां च सर्वेषां चेदीनां चैव भारत\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2170275, "chapter_id": 4637, "verse_number": "२७", "content_sanskrit": "एष कर्णो रणे पार्थ पाण्डवानामनीकिनीम् ।\nशरैर्विध्वंसयति वै नलिनीमिव कुञ्जरः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2170276, "chapter_id": 4637, "verse_number": "२८", "content_sanskrit": "एते द्रवन्ति रथिनस्त्वदीयाः पाण्डुनन्दन ।\nपश्य पश्य यथा पार्थ गच्छन्त्येते महारथाः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2170277, "chapter_id": 4637, "verse_number": "२९", "content_sanskrit": "एते भारत मातङ्गाः कर्णेनाभिहता रणे ।\nआर्तनादान् विकुर्वाणा विद्रवन्ति दिशो दश\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2170278, "chapter_id": 4637, "verse_number": "३०", "content_sanskrit": "रथानां द्रवतां वृन्दं पश्य पार्थ समन्ततः ।\nद्राव्यमाणं रणे चैव कर्णेनामित्रकर्शिना\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2170279, "chapter_id": 4637, "verse_number": "३१", "content_sanskrit": "हस्तिकक्ष्यां रणे पश्य चरन्तीं तत्र तत्र ह ।\nरथस्थं सूतपुत्रस्य केतुं केतुमतां वर\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2170280, "chapter_id": 4637, "verse_number": "३२", "content_sanskrit": "असौ धावति राधेयो भीमसेनरथं प्रति ।\nकिरन् शरशतानीव विनिघ्नंस्तव वाहिनीम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2170281, "chapter_id": 4637, "verse_number": "३३", "content_sanskrit": "एतान् पश्य च पाञ्चालान् द्राव्यमाणान् समन्ततः ।\nशक्रेणेव यथा दैत्यान् हन्यमानान् महाहवे\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2170282, "chapter_id": 4637, "verse_number": "३४", "content_sanskrit": "एष कर्णो रणे जित्वा पाञ्चालान् पाण्डुसृञ्जयान् ।\nदिशो विप्रेक्षते सर्वास्त्वदर्थमिति मे मतिः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2170283, "chapter_id": 4637, "verse_number": "३५", "content_sanskrit": "पश्य पार्थ धनुः श्रेष्ठं विकर्षन् साधु शोभते ।\nशत्रून् जित्वा यथा शक्रो देवसङ्घैः समावृतः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2170284, "chapter_id": 4637, "verse_number": "३६", "content_sanskrit": "एते नदन्ति कौरव्या दृष्ट्वा कर्णस्य विक्रमम् ।\nत्रासयन्तो रणे पार्थान् सृञ्जयांश्च सहस्रशः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2170285, "chapter_id": 4637, "verse_number": "३७", "content_sanskrit": "एष सर्वात्मना पाण्डून् त्रासयित्वा महारणे ।\nअभिभाषति राधेयः सर्वसैन्यानि मानदः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2170286, "chapter_id": 4637, "verse_number": "३८", "content_sanskrit": "अभिद्रवत भद्रं वो द्रुतं द्रवत कौरवाः ।\nयथा जीवन्न वः कश्चिन्मुच्यते युधि सृञ्जयः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2170287, "chapter_id": 4637, "verse_number": "३९", "content_sanskrit": "तथा कुरुत संयत्ता वयं यास्याम पृष्ठतः ।\nएवमुक्त्वाऽनुयात्येव पृष्ठतो विकिरन् शरैः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2170288, "chapter_id": 4637, "verse_number": "४०", "content_sanskrit": "पश्य कर्णं रणे पार्थ श्वेतच्छविविराजितम् ।\nउदयं पर्वतं यद्वत् शशाङ्केनोपशोभितम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2170289, "chapter_id": 4637, "verse_number": "४१", "content_sanskrit": "पूर्णचन्द्रनिकाशेन मूर्ध्नि च्छत्रेण भारत ।\nध्रियमाणेन समरे तथा शतशलाकिना\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2170290, "chapter_id": 4637, "verse_number": "४२", "content_sanskrit": "एष त्वां प्रेक्षते कर्णः सकटाक्षं विशाम्पते ।\nउत्तमं रथमास्थाय ध्रुवमेष्यति संयुगे\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2170291, "chapter_id": 4637, "verse_number": "४३", "content_sanskrit": "पश्य ह्येनं महाबाहो विधुन्वानं महद्धनुः ।\nशरांश्चाशीविषाकारान् विसृजन्तं महाबलम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2170292, "chapter_id": 4637, "verse_number": "४४", "content_sanskrit": "असौ निवृत्तो राधेयो दृश्यते वानरध्वज ।\nप्रार्थयन् समरं पार्थ त्वया सह परन्तप ।\nवधाय चात्मनोऽभ्येति प्रदीपं शलभो यथा\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2170293, "chapter_id": 4637, "verse_number": "४५", "content_sanskrit": "कर्णमेकाकिनं दृष्ट्वा रथानीकेन भारत ।\nरिरक्षिषुः सुसंयत्तो धार्तराष्ट्रोऽभिवर्तते\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2170294, "chapter_id": 4637, "verse_number": "४६", "content_sanskrit": "सर्वैः सहैभिर्दुष्टात्मा वध्य एष प्रयत्नतः ।\nत्वया यशश्च राज्यं च सुखं चोत्तममिच्छता\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2170295, "chapter_id": 4637, "verse_number": "४७", "content_sanskrit": "अदीनयोर्विश्रुतयोर्युवयोर्योत्स्यमानयोः ।\nदेवासुरे पार्थ मृधे देवदानवयोरिव\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2170296, "chapter_id": 4637, "verse_number": "४८", "content_sanskrit": "त्वां च दृष्ट्वातिसंरब्धं कर्णं च भरतर्षभ ।\nअसौ दुर्योधनः क्रुद्धो नोत्तरं प्रतिपद्यते\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2170297, "chapter_id": 4637, "verse_number": "४९", "content_sanskrit": "आत्मानं च कृतात्मानं समीक्ष्य भरतर्षभ ।\nकृतागसं च राधेयं धर्मात्मनि युधिष्ठिरे\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2170298, "chapter_id": 4637, "verse_number": "५०", "content_sanskrit": "प्रतिपद्यस्व राधेयं प्राप्तकालमनन्तरम् ।\nआर्यां युद्धे मतिं कृत्वा प्रत्येहि रथयूथपम्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2170299, "chapter_id": 4637, "verse_number": "५१", "content_sanskrit": "पञ्च ह्येतानि मुख्यानां रथानां रथसत्तम ।\nशतान्यायान्ति वेगेन बलिनां भीमतेजसाम्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2170300, "chapter_id": 4637, "verse_number": "५२", "content_sanskrit": "पञ्च नागसहस्राणि द्विगुणा वाजिनस्तथा ।\nअभिसंहत्य कौन्तेय पदातिप्रयुतानि च\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2170301, "chapter_id": 4637, "verse_number": "५३", "content_sanskrit": "अन्योन्यरक्षितं वीर बलं त्वामभिवर्तते ।\nद्रोणपुत्रं पुरस्कृत्य तच्छीघ्रं संनिषूदय\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2170302, "chapter_id": 4637, "verse_number": "५४", "content_sanskrit": "सूतपुत्रे महेष्वासे दर्शयात्मानमात्मना ।\nउत्तमं यत्नमास्थाय प्रत्येहि भरतर्षभ\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2170303, "chapter_id": 4637, "verse_number": "५५", "content_sanskrit": "असौ कर्णः सुसंरब्धः पाञ्चालानभिधावति ।\nकेतुमस्य हि पश्यामि धृष्टद्युम्नरथं प्रति\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2170304, "chapter_id": 4637, "verse_number": "५६", "content_sanskrit": "समुच्छेत्स्यति पाञ्चालानिति मन्ये परन्तप\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2170305, "chapter_id": 4637, "verse_number": "५७", "content_sanskrit": "आचक्षे तु प्रियं पार्थ तवेदं भरतर्षभ ।\nराजा जीवति कौरव्यो धर्मपुत्रो युधिष्ठिरः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2170306, "chapter_id": 4637, "verse_number": "५८", "content_sanskrit": "असौ भीमो महाबाहुः सन्निवृत्तश्चमूमुखे ।\nवृतः सृञ्जयसैन्येन सात्वतेन च भारत\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2170307, "chapter_id": 4637, "verse_number": "५९", "content_sanskrit": "वध्यन्त एते समरे कौरवा निशितैः शरैः ।\nभीमसेनेन कौन्तेय पाञ्चालैश्च महात्मभिः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2170308, "chapter_id": 4637, "verse_number": "६०", "content_sanskrit": "सेना हि धार्तराष्ट्रस्य विमुखा चाभवद् रणात् ।\nविप्रधावति वेगेन भीमस्य निहता शरैः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2170309, "chapter_id": 4637, "verse_number": "६१", "content_sanskrit": "विपन्नसस्येव मही रुधिरेण समुक्षिता ।\nकौरवी भरतश्रेष्ठ सेना कृपणदर्शना\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2170310, "chapter_id": 4637, "verse_number": "६२", "content_sanskrit": "निवृत्तं पश्य कौन्तेय भीमसेनं युधाम्पतिम् ।\nआशीविषमिव क्रुद्धं द्रावयन्तं वरूथिनीम्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2170311, "chapter_id": 4637, "verse_number": "६३", "content_sanskrit": "पीतरक्तासितसितास्ताराचन्द्रार्कमण्डिताः ।\nपताका विप्रकीर्यन्ते छत्राण्येतानि चार्जुन\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2170312, "chapter_id": 4637, "verse_number": "६४", "content_sanskrit": "सौवर्णा राजताश्चैव तैजसाश्च पृथग्विधाः ।\nकेतवो विनिपात्यन्ते हस्त्यश्वं च विशीर्यते\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2170313, "chapter_id": 4637, "verse_number": "६५", "content_sanskrit": "रथेभ्यः प्रपतन्त्येते रथिनो विगतासवः ।\nनानावर्णैर्हता बाणैः पाञ्चालैरपलायिभिः\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2170314, "chapter_id": 4637, "verse_number": "६६", "content_sanskrit": "समनुष्यान् गजानश्वान् रथांश्चैव धनञ्जय ।\nसमाद्रवन्ति पाञ्चाला धार्तराष्ट्रांस्तरस्विनः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2170315, "chapter_id": 4637, "verse_number": "६७", "content_sanskrit": "मृद्नन्ति च नरव्याघ्रा भीमसेनव्यपाश्रयात् ।\nबलं परेषां दुर्धर्षं त्यक्त्वा प्राणानरिन्दम\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2170316, "chapter_id": 4637, "verse_number": "६८", "content_sanskrit": "एते नदन्ति पाञ्चाला धमन्त्यपि च वारिजान् ।\nअभिद्रवन्ति च रणे निघ्नन्तः सायकैः परान्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2170317, "chapter_id": 4637, "verse_number": "६९", "content_sanskrit": "पश्य सैषां च माहात्म्यं पाञ्चाला हि परन्तप ।\nधार्तराष्ट्रान् विनिघ्नन्ति क्रुद्धाः सिंहा इव द्विपान्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2170318, "chapter_id": 4637, "verse_number": "७९", "content_sanskrit": "शस्त्रमाच्छिद्य शत्रूणां सायुधानां निरायुधाः ।\nतेनैवैतानमोघास्त्रा निघ्नन्ति च नदन्ति च\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2170319, "chapter_id": 4637, "verse_number": "७१", "content_sanskrit": "शिरांस्येतानि पात्यन्ते शत्रूणां बाहवोऽपि च ।\nरथनागहया वीरा यशस्याः सर्व एव च\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2170320, "chapter_id": 4637, "verse_number": "७२", "content_sanskrit": "सर्वतश्चाभिपन्नैषा धार्तराष्ट्री महाचमूः ।\nपाञ्चालैर्मानसादेत्य हंसैर्गङ्गेव वेगितैः\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2170321, "chapter_id": 4637, "verse_number": "७३", "content_sanskrit": "सुभृशं च पराक्रान्ताः पाञ्चालानां निवारणे ।\nकृपकर्णादयो वीरा ऋषभाणामिवर्षभाः\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2170322, "chapter_id": 4637, "verse_number": "७४", "content_sanskrit": "सुनिर्भग्नांश्च भीमास्त्रैर्धार्तराष्ट्रान् महारथान् ।\nधृष्टद्युम्नमुखा वीरा घ्नन्ति शत्रून् सहस्रशः\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2170323, "chapter_id": 4637, "verse_number": "७५", "content_sanskrit": "पाञ्चालेष्वभिभूतेषु द्विषद्भिरपभीर्नदन् ।\nशत्रुपक्षमवस्कन्द्य शरानस्यति मारुतिः\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2170324, "chapter_id": 4637, "verse_number": "७६", "content_sanskrit": "विषण्णभूयिष्ठरथा धार्तराष्ट्री महाचमूः\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2170325, "chapter_id": 4637, "verse_number": "७७", "content_sanskrit": "रथाश्चैते सुवित्रस्ता भीमसेनभयार्दिताः\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2170326, "chapter_id": 4637, "verse_number": "७८", "content_sanskrit": "पश्य भीमेन नाराचैश्छिन्ना नागाः पतन्त्यमी ।\nवज्रिवज्राहतानीव शिखराणि महीभृताम्\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2170327, "chapter_id": 4637, "verse_number": "७९", "content_sanskrit": "भीमसेनस्य निर्विद्धा बाणैः सन्नतपर्वभिः ।\nस्वान्यनीकानि मृद्नन्तो द्रवन्त्येते महागजाः\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2170328, "chapter_id": 4637, "verse_number": "८०", "content_sanskrit": "अभिजानीहि भीमस्य सिंहनादं दुरुत्सहम् ।\nनदतोऽर्जुन सङ्ग्रामे वीरस्य जितकाशिनः\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2170329, "chapter_id": 4637, "verse_number": "८१", "content_sanskrit": "एष नैषादिरभ्येति द्विपमुख्येन पाण्डवम् ।\nजिघांसुस्तोमरैः क्रुद्धो दण्डपाणिरिवान्तकः\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2170330, "chapter_id": 4637, "verse_number": "८२", "content_sanskrit": "सतोमरावस्य भुजौ छिन्नौ भीमेन गर्जतः ।\nतीक्ष्णैरग्निशिखाप्रख्यैर्नाराचैर्दशभिर्हतः\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2170331, "chapter_id": 4637, "verse_number": "८३", "content_sanskrit": "हत्वैनं पुनरायाति नागानन्यान् प्रहारिणः ।\nपश्य नीलाम्बुदनिभान् महामात्रैरधिष्ठितान्\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2170332, "chapter_id": 4637, "verse_number": "८४", "content_sanskrit": "शक्तितोमरनाराचैर्विनिघ्नन्तं वृकोदरम्\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2170333, "chapter_id": 4637, "verse_number": "८५", "content_sanskrit": "सप्त सप्त च नागांस्तान् वैजयन्तीश्च सध्वजाः ।\nनिहत्य निशितैर्बाणैश्छिन्नाः पार्थाग्रजेन ते\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2170334, "chapter_id": 4637, "verse_number": "८६", "content_sanskrit": "दशभिर्दशभिश्चैके नाराचैर्निहता गजाः\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2170335, "chapter_id": 4637, "verse_number": "८७", "content_sanskrit": "न चासौ धार्तराष्ट्राणां श्रूयते निनदस्तथा ।\nपुरन्दरसमे क्रुद्धे निवृत्ते भरतर्षभे\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2170336, "chapter_id": 4637, "verse_number": "८८", "content_sanskrit": "अक्षोहिण्यस्तथा तिस्रो धार्तराष्ट्रस्य संहताः ।\nक्रुद्धेन नरसिंहेन भीमसेनेन वारिताः\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2170337, "chapter_id": 4637, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2170338, "chapter_id": 4637, "verse_number": "८९", "content_sanskrit": "भीमसेनेन तत्कर्म कृतं दृष्ट्वा सुदुष्करम् ।\nअर्जुनो व्यधमत् शिष्टानहितान्निशितैः शरैः\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2170339, "chapter_id": 4637, "verse_number": "९०", "content_sanskrit": "ते वध्यमानाः समरे संशप्तकगणाः प्रभो ।\nशक्रस्यातिथितां गत्वा विशोका ह्यभवन् मुदा\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2170340, "chapter_id": 4637, "verse_number": "९१", "content_sanskrit": "पार्थश्च पुरुषव्याघ्रः शरैः सन्नतपर्वभिः ।\nजघान धार्तराष्ट्रस्य चतुर्विधबलां चमूम्\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2170341, "chapter_id": 4637, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nकृष्णवाक्यं नाम सप्तपञ्चाशोऽध्यायः ॥५७॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}]