[{"id": 6000096000, "chapter_id": 10096, "verse_number": null, "content_sanskrit": "भगवद्बादरायणप्रणीतं श्रीमद्भागवतम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000096001, "chapter_id": 10096, "verse_number": null, "content_sanskrit": "अथ प्रथमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2, "topics": [{"text": "तस्य आग्नीध्रादिपुत्रोत्पत्तिः", "range": "३"}]}, {"id": 6000096002, "chapter_id": 10096, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.001.m4a", "display_order": 3}, {"id": 6000096003, "chapter_id": 10096, "verse_number": "५-१-१", "content_sanskrit": "प्रियव्रतो भागवत आत्मारामः कथं मुने।\nगृहेऽरमत यन्मूलः कर्मबन्धः पराभवः॥ ५/१/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.002.m4a", "display_order": 4, "topics": [{"text": "पूर्वस्मिन् स्कन्धे मनुपुत्रस्योत्तानपादस्य कथा तद्वंशावलिश्चोक्ते। तज्ज्येष्ठभ्रातुः प्रियव्रतस्य कथा", "range": "१–१०"}]}, {"id": 6000096004, "chapter_id": 10096, "verse_number": "५-१-२", "content_sanskrit": "न नूनं मुक्तसङ्गानां तादृशानां महामुने।\nगृहेष्वभिनिवेशोऽयं पुंसां भवितुमर्हति॥ ५/१/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.003.m4a", "display_order": 5}, {"id": 6000096005, "chapter_id": 10096, "verse_number": "५-१-३", "content_sanskrit": "महतां खलु विप्रर्षे उत्तमश्लोकपादयोः।\nछायानिर्वृतचित्तानां न कुटुम्बे स्पृहा मतिः॥ ५/१/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.004.m4a", "display_order": 6}, {"id": 6000096006, "chapter_id": 10096, "verse_number": "५-१-४", "content_sanskrit": "संशयोऽयं महान् ब्रह्मन् दारागारसुतादिषु।\nसक्तस्य यत्सिद्धिरभूत्कृष्णे च मतिरच्युता॥ ५/१/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.005.m4a", "display_order": 7}, {"id": 6000096007, "chapter_id": 10096, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.006.m4a", "display_order": 8}, {"id": 6000096008, "chapter_id": 10096, "verse_number": "५-१-५", "content_sanskrit": "बाढमुक्तं भगवत उत्तमश्लोकस्य श्रीमच्चरणारविन्दमकरन्दरस आदित आवेशितचेतसो भागवत-पारमहंस्यदयितः कथञ्चिदन्तरायविहतां स्वां शिवतमां पदवीं न प्रायेण हि हिन्वन् आस्ते॥ ५/१/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.007.m4a", "display_order": 9}, {"id": 6000096009, "chapter_id": 10096, "verse_number": null, "content_sanskrit": "यर्हि वाव स राजपुत्रः प्रियव्रतः परमभागवतो नारदस्य चरणोपसेवयाञ्जसाऽवगतपरमार्थसत्तत्त्वो ब्रह्मसत्रेण दीक्षिष्यमाणोऽवनितलपरिपालनायाम्नातप्रवरगुणगणैकान्तभाजनतया स्वपित्रोपा-मन्त्रितो भगवति वासुदेव एवाव्यवधानसमाधियोगेन समावेशितसकलकारकक्रियाकलापो नैवाभ्यनन्दत्॥ ५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.008.m4a", "display_order": 10}, {"id": 6000096010, "chapter_id": 10096, "verse_number": "५-१-६", "content_sanskrit": "यदपि तदप्रत्याम्नातव्यं तदधिकरण आत्मनोऽन्यस्मादसतो यदा पराभवमन्वीक्षमाणः॥ ५/१/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.009.m4a", "display_order": 11}, {"id": 6000096011, "chapter_id": 10096, "verse_number": "५-१-७", "content_sanskrit": "अथ ह भगवानादिदेव एतस्य गुणविसर्गस्य परिबृंहणानुध्यानेन व्यवसितसकलजगदभिप्राय आत्मयोनिरखिलनिगमनिजजनपरिवेष्टितः स्वभवनादवततार॥ ५/१/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.010.m4a", "display_order": 12}, {"id": 6000096012, "chapter_id": 10096, "verse_number": "५-१-८", "content_sanskrit": "तत्र तत्र गगनतल उडुपतिरिव विमानावलिभिरनुपथममरपरिवृढैरभिपूज्यमानः पथि पथि च वरूथशः सिद्धगन्धर्वसाध्यचारणमुनिगणैरुपगीयमानो गन्धमादनद्रोणीमवभासयन्नुपससर्प॥ ५/१/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.011.m4a", "display_order": 13}, {"id": 6000096013, "chapter_id": 10096, "verse_number": "५-१-९", "content_sanskrit": "तत्र ह वा एनं देवर्षिः हंसयानेन पितरं भगवन्तं हिरण्यगर्भमुपलम्भमानः सहसैव सह पितापुत्राभ्यां अवहिताञ्जलिरुपतस्थे॥ ५/१/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.012.m4a", "display_order": 14}, {"id": 6000096014, "chapter_id": 10096, "verse_number": "५-१-१०", "content_sanskrit": "भगवानपि भारत तदुपनीतार्हणः सूक्तवाकेनअतितरामुदितगुणगणावतारसुविजयः प्रियव्रत-मादिपुरुषस्तं सदयहासावलोक इति होवाच॥ ५/१/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.013.m4a", "display_order": 15}, {"id": 6000096015, "chapter_id": 10096, "verse_number": null, "content_sanskrit": "ब्रह्मोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.014.m4a", "display_order": 16}, {"id": 6000096016, "chapter_id": 10096, "verse_number": "५-१-११", "content_sanskrit": "निबोध तातेदमृतं ब्रवीमि माऽसूयितुं देवमर्हस्यमेयम्।\nअहं भवस्ते तत एष महर्षिर्वहाम सर्वे विवशा यस्य दिष्टम्॥ ५/१/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.015.m4a", "display_order": 17}, {"id": 6000096017, "chapter_id": 10096, "verse_number": "५-१-१२", "content_sanskrit": "न तस्य कश्चित्तपसा विद्यया वा न योगवीर्येण मनीषया वा।\nनैवार्थधर्मैः परतः स्वतो वा कृतं विहन्तुं तनुभृद्विभूयात्॥ ५/१/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.016.m4a", "display_order": 18}, {"id": 6000096018, "chapter_id": 10096, "verse_number": "५-१-१३", "content_sanskrit": "भवाय नाशाय च कर्म कर्तुं शोकाय मोहाय सदा भयाय।\nसुखाय दुःखाय च देहयोगमव्यक्तदिष्टं जनताऽङ्ग धत्ते॥ ५/१/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.017.m4a", "display_order": 19}, {"id": 6000096019, "chapter_id": 10096, "verse_number": "५-१-१४", "content_sanskrit": "यद्वाचि तन्त्यां गुणकर्मनामभिः स्वदामभिर्वत्स वयं सुयोजिताः।\nसर्वे वहामो बलिमीश्वराय प्रोता नसीव द्विपदे चतुष्पदः॥ ५/१/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.018.m4a", "display_order": 20}, {"id": 6000096020, "chapter_id": 10096, "verse_number": "५-१-१५", "content_sanskrit": "ईशावसृष्टं ह्यवरुन्ध्महेऽङ्ग दुःखं सुखं वा गुणकर्मसङ्गात्।\nआस्थाय यत्तद्यदयुङ्क्त नाथश्चक्षुष्मताऽन्धा इव नीयमानाः॥ ५/१/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.019.m4a", "display_order": 21}, {"id": 6000096021, "chapter_id": 10096, "verse_number": "५-१-१६", "content_sanskrit": "मुक्तोऽपि तावद्बिभृयात्स्वदेहमारब्धमश्नन्नभिमानशून्यः।\nयथोपयातं प्रतियातनिद्रः किन्त्वन्यदेहाय गुणान्न वृङ्क्ते॥ ५/१/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.020.m4a", "display_order": 22}, {"id": 6000096022, "chapter_id": 10096, "verse_number": "५-१-१७", "content_sanskrit": "भयं प्रमत्तस्य वनेष्वपि स्याद्यतो वसन्ते सह षट्‌सपत्नाः।\nजितेन्द्रियस्यात्मरतेर्बुधस्य गृहाश्रमः किन्नु करोत्यवद्यम्॥ ५/१/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.021.m4a", "display_order": 23}, {"id": 6000096023, "chapter_id": 10096, "verse_number": "५-१-१८", "content_sanskrit": "यः षट्‌सपत्नान्विजिगीषमाणो गृहेषु निर्विद्य यतेत पूर्वम्।\nयुध्येत दुर्गाश्रित ऊर्जितारीन् क्षीणेषु कामं विचरेद्विपश्चित्॥ ५/१/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.022.m4a", "display_order": 24}, {"id": 6000096024, "chapter_id": 10096, "verse_number": "५-१-१९", "content_sanskrit": "त्वं त्वब्जनाभाङ्घ्रिसरोजकोशदुर्गाश्रितो निर्जितषट्‌सपत्नः।\nभुङ्‌क्ष्वेह भोगान् पुरुषातिसृष्टान् विमुक्तसङ्गः प्रकृतिं भजस्व॥ ५/१/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.023.m4a", "display_order": 25}, {"id": 6000096025, "chapter_id": 10096, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.024.m4a", "display_order": 26}, {"id": 6000096026, "chapter_id": 10096, "verse_number": "५-१-२०", "content_sanskrit": "इति समभिहितो महाभागवतो भगवतस्‍त्रिभुवनगुरोरनुशासनमात्मनो लघुतयाऽवनतशिरोधरो बाढमिति सबहुमानमुवाह॥ ५/१/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.025.m4a", "display_order": 27, "topics": [{"text": "राज्यमनिच्छतः प्रियव्रतस्य ब्रह्मण आदेशेन राज्याङ्गीकरणम्", "range": "२०–२५"}]}, {"id": 6000096027, "chapter_id": 10096, "verse_number": "५-१-२१", "content_sanskrit": "भगवानपि मनुना यथावदुपकल्पितापचितिः प्रियव्रतनारदयोरनिमिषमभिसमीक्षमाणयोरात्म-समवस्थानं वाङ्मनसोः क्षयमव्यवहितमगमत्॥ ५/१/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.026.m4a", "display_order": 28}, {"id": 6000096028, "chapter_id": 10096, "verse_number": "५-१-२२", "content_sanskrit": "मनुरपि परेणैवेत्थं समभिसन्धितमनोरथः सुरर्षिवरानुमतेनात्मजमखिलधरामण्डलस्थितिगुप्तय आस्थायातिविषयविषमविषजलाशयादुपरराम॥ ५/१/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.027.m4a", "display_order": 29}, {"id": 6000096029, "chapter_id": 10096, "verse_number": "५-१-२३", "content_sanskrit": "इति ह वाव स जगतीपतिरीश्वरेच्छयाधिनिवेशितकर्माधिकारोऽखिलजगद्बन्धध्वंसनपरानुभावस्य भगवत आदिपुरुषस्याङ्घ्रियुगलानवरतध्यानानुभावेन परिरन्धितकषायाशयावदातोऽपि मानवर्धनो महतां महीतलमनुशशास॥ ५/१/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.028.m4a", "display_order": 30}, {"id": 6000096030, "chapter_id": 10096, "verse_number": "५-१-२४", "content_sanskrit": "अथ च दुहितरं प्रजापतेर्विश्वकर्मण उपयेमे बर्हिष्मतीं नाम।\nतस्यामु ह वा आत्मजानात्म-समानशीलगुणकर्मरूपवीर्योदारान् दश भावयाम्बभूव।\nकन्यां यवीयसीमूर्जस्वतीं नाम॥ ५/१/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.029.m4a", "display_order": 31}, {"id": 6000096031, "chapter_id": 10096, "verse_number": "५-१-२५", "content_sanskrit": "आग्नीध्र-इध्मजिह्व-यज्विबाहु-महावीर-हिरण्यरेतस्-घृतपृष्ठ-सवन-मेधातिथि-वीतिहोत्र-कवय इति सर्व एवाग्निनामानः॥ ५/१/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.030.m4a", "display_order": 32}, {"id": 6000096032, "chapter_id": 10096, "verse_number": "५-१-२६", "content_sanskrit": "एतेषां कविर्महावीरः सवन इति त्रय आसन्नूर्ध्वरेतसः।\nत आत्मविद्यायामर्भकभावादारभ्य कृतपरिचयाः पारमहंस्यमेवाश्रममभजन्॥ ५/१/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.031.m4a", "display_order": 33, "topics": [{"text": "तेन भूमण्डले सप्तकृत्वः प्रदक्षिणीकरणेन जम्ब्वादिसप्तद्वीपान् सप्तवारिधींश्च परिकल्प्य आग्नीध्रादिभ्यः सप्तभ्यः पुत्रेभ्यो दानम्", "range": "२६–३४"}]}, {"id": 6000096033, "chapter_id": 10096, "verse_number": "५-१-२७", "content_sanskrit": "तस्मिन्नु ह वा उपशमशीलाः परमऋषयः सकलजीवनिकायावासस्य भगवतो वासुदेवस्य संसारभीतानां शरणभूतस्य श्रीमच्चरणारविन्दाविरतस्मृतिविगलितपरमभक्तियोगानुभावेन परिभावितान्तर्हृदयाधिगते भगवति सर्वेषां भूतानामात्मभूते प्रत्यगात्मन्येव तादात्म्यमविशेषेण समीयुः॥ ५/१/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.032.m4a", "display_order": 34}, {"id": 6000096034, "chapter_id": 10096, "verse_number": "५-१-२८", "content_sanskrit": "अन्यस्यामपि भार्यायां त्रयः पुत्रा आसन्।\nउत्तमस्तापसो रैवत इति मन्वन्तराधिपतयः॥ ५/१/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.033.m4a", "display_order": 35}, {"id": 6000096035, "chapter_id": 10096, "verse_number": "५-१-२९", "content_sanskrit": "एवमुपशमायनेषु स्वतनयेष्वथ जगतीपतिर्जगतीमर्बुदान्येकादशपरिवत्सराणामव्याहताखिल- पुरुषकारसारभूतदोर्दण्डयुगलापीडितकोदण्डमौर्वीगुणस्तनितविरमितधर्मप्रतिपक्षो बर्हिष्मत्यां चानुदिनमेधमानप्रमोदप्रसरणपोषणव्रीडाप्रमुषितहासावलोकरुचिरक्ष्वेलनादिभिः पराभूयमान-विवेकोऽनवबुध्यमान इव महामना बुभुजे॥ ५/१/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.034.m4a", "display_order": 36}, {"id": 6000096036, "chapter_id": 10096, "verse_number": "५-१-३०", "content_sanskrit": "यावदवभासयति सुरगिरिमनुपर्याक्रमन् भगवानादित्यो वसुधातलमर्धेनैव प्रतपति अर्धेनैवाच्छादयति तदा हि भगवदुपासनोपचितातिपुरुषप्रभावस्तदनभिनन्दन्समजवेन रथेन ज्योतिर्मयेन रजनीमपि दिनं करिष्यामीति सप्तकृत्वस्तरणिमनुपर्याक्रामत्स द्वितीय इव पतङ्गः॥ ५/१/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.035.m4a", "display_order": 37}, {"id": 6000096037, "chapter_id": 10096, "verse_number": "५-१-३१", "content_sanskrit": "या वा इह तद्रथचरणनेमिकृतपरिखास्ताः सप्त सिन्धव आसन् यत एव कृताः सप्त भुवो द्वीपाः॥ ५/१/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.036.m4a", "display_order": 38}, {"id": 6000096038, "chapter_id": 10096, "verse_number": "५-१-३२", "content_sanskrit": "जम्बू-प्लक्ष-शाल्मलि-कुश-क्रौञ्च-शाक-पुष्करसंज्ञाः तेषां परिमाणं पूर्वस्मात् पूर्वस्मादुत्तरोत्तरे यथासङ्ख्यं द्विगुणेन बहिः समन्तत उपक्लृप्ताः॥ ५/१/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.037.m4a", "display_order": 39}, {"id": 6000096039, "chapter_id": 10096, "verse_number": "५-१-३३", "content_sanskrit": "लवणोद-इक्षुरसोद-सुरोद-घृतोद-क्षीरोद-दधिमण्डोद-शुद्धोदाः सप्तजलधयः सप्तद्वीपपरिखा अभ्यन्तरद्वीपसमाना एकैकशो यथानुपूर्वं सप्तस्वपि बहिर्द्वीपेषु पृथक् पृथक् परित उपकल्पिताः।\nतेषु जम्ब्वादिषु बर्हिष्मतीपतिरनुवृत्तानात्मजान् आग्नीध्र-इध्मजिह्व-यज्विबाहु-हिरण्यरेतो-घृतपृष्ठ-मेधातिथि-वीतिहोत्रसञ्ज्ञान् यथासङ्ख्यमेकैकस्मिन्नेकमेकमेवाधिपतिं विदधे॥ ५/१/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.038.m4a", "display_order": 40}, {"id": 6000096040, "chapter_id": 10096, "verse_number": "५-१-३४", "content_sanskrit": "दुहितरमूर्जस्वतीं नामोशनसे प्रायच्छद्यस्यामासीद्देवयानीनाम काव्यसुता॥ ५/१/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.039.m4a", "display_order": 41}, {"id": 6000096041, "chapter_id": 10096, "verse_number": "५-१-३५", "content_sanskrit": "नैवंविधः पुरुषकार उरुक्रमस्य पुंसां तदङ्घ्रिरजसा जितषड्गुणानाम्।\nचित्रं विदूरविगतः सकृदाददीत यन्नामधेयमधुना स जहाति बन्धम्॥ ५/१/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.040.m4a", "display_order": 42}, {"id": 6000096042, "chapter_id": 10096, "verse_number": "५-१-३६", "content_sanskrit": "स एवमपरिमितबलपराक्रम एकदा तु देवर्षिचरणानुसेवयाऽनुपतितगुणविसर्गसंसर्गेणानिवृत्त-मिवात्मानं मन्यमान आत्तनिर्वेद इदमाह॥ ५/१/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.041.m4a", "display_order": 43}, {"id": 6000096043, "chapter_id": 10096, "verse_number": "५-१-३७", "content_sanskrit": "अहो असाध्वनुष्ठितं यदभिनिवेशितोऽहमिन्द्रियैरविद्याविरचितविषमविषयान्धकूपे तदलमलं मनुष्यवनिताविनोदमृगं मां धिग्धिगिति गर्हयाञ्चकार॥ ५/१/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.042.m4a", "display_order": 44}, {"id": 6000096044, "chapter_id": 10096, "verse_number": "५-१-३८", "content_sanskrit": "परदेवताप्रसादाधिगतात्मप्रत्यवमर्शनपरिनिर्वृतः स्वपुत्रेभ्य इमां गां यथादायं विभज्य भुक्तभोगां च महिषीं मृतकमिव स ह महाविभूतिमपहाय स्वयं निहितनिर्वेदो हृदि गृहीतरुचिरहरिविहारानुभावो भगवतो नारदस्य पदवीमनुससार॥ ५/१/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.043.m4a", "display_order": 45}, {"id": 6000096045, "chapter_id": 10096, "verse_number": null, "content_sanskrit": "तस्य ह वा एते श्लोकाः।\nप्रियव्रतकृतं कर्म को नु कुर्याद्विनेश्वरम्। यो नेमिनिम्नैरकरोच्छायां घ्नन्सप्तवारिधीन् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.044.m4a", "display_order": 46}, {"id": 6000096046, "chapter_id": 10096, "verse_number": "५-१-४०", "content_sanskrit": "भूसंस्थानं कृतं येन सरिद्गिरिवनादिभिः।\nसीमा च भूतनिर्वृत्यै द्वीपे द्वीपे विभागशः॥ ५/१/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.045.m4a", "display_order": 47, "topics": [{"text": "प्रियव्रतस्य वैशिष्‍ट्यसंग्रहः", "range": "३९–४१"}]}, {"id": 6000096047, "chapter_id": 10096, "verse_number": "५-१-४१", "content_sanskrit": "भौमं दिव्यं मानुषं च महित्वं योगकर्मजम्।\nयश्चक्रे निरयौपम्यं पुरुषानुजनप्रियः॥ ५/१/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_001/BhP_05.001.046.m4a", "display_order": 48}, {"id": 6000096048, "chapter_id": 10096, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां पञ्चमस्कन्धे प्रथमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]