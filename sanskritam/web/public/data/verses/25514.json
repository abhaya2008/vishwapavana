[{"id": 7005514000, "chapter_id": 25514, "verse_number": "२-३१-१", "content_sanskrit": "कथं देवेन रुद्रेण शंकरेणामितौजसा ।\nकपालं ब्रह्माणः पुर्ण स्थापितं देहजं भुवि ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005514001, "chapter_id": 25514, "verse_number": "२-३१-२", "content_sanskrit": "सुत उवाच ।\nश्रृणुध्वमृषयः पुण्यां कथां पापप्रणाशिनीम ।\nमाहाम्त्यं देवदेवस्य महादेवस्य धीमतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005514002, "chapter_id": 25514, "verse_number": "२-३१-३", "content_sanskrit": "पुरा पितामहं देवं मेरुश्रुगे महर्षयः ।\nप्रोचुः प्रणम्य लोकादिं किमेकं तत्त्वमव्ययम ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005514003, "chapter_id": 25514, "verse_number": "२-३१-४", "content_sanskrit": "स मायया महेशस्य मोहितो लोकसम्भवः ।\nअविज्ञाय परं भावं स्वात्मानं प्राह धर्षिणम ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005514004, "chapter_id": 25514, "verse_number": "२-३१-५", "content_sanskrit": "अहं धाता जगद्योनिः स्वयम्भुरेकः इश्वरः ।\nअनादिमप्तरं ब्रह्मा मामभ्यर्च्य विमुच्यते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005514005, "chapter_id": 25514, "verse_number": "२-३१-६", "content_sanskrit": "अहं हि सर्वदेवानां प्रवर्तननिवर्तकः ।\nन विद्यते चाभ्यधिको मत्तो लोकेषु कश्‍चन ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005514006, "chapter_id": 25514, "verse_number": "२-३१-७", "content_sanskrit": "तस्यैवं मन्यमानस्य जज्ञे नारायणांशजः ।\nप्रोवाच प्रहसन वाक्यं रोषताम्रविलोचनः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005514007, "chapter_id": 25514, "verse_number": "२-३१-८", "content_sanskrit": "किं कारणमिंद ब्रह्मान वर्तते तव साम्प्रतम ।\nअज्ञानयोगयुक्तस्य न त्वेतदुचितं तव ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005514008, "chapter_id": 25514, "verse_number": "२-३१-९", "content_sanskrit": "अहं धाता हि लोकानां यज्ञो नारायणः प्रभुः ।\nन मामृतेऽस्य जगतो जीवनं सर्वदा क्वचित ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005514009, "chapter_id": 25514, "verse_number": "२-३१-१०", "content_sanskrit": "अहमेव परं ज्योतिरहमेव परा गतिः ।\nमत्प्रेरितेन भवता सृष्टं भुवनमण्डलम ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005514010, "chapter_id": 25514, "verse_number": "२-३१-११", "content_sanskrit": "एवं विवदतोर्मोहात परस्परजयैषिणोः ।\nआजग्मुर्यत्र तौ देवौ वेदाश्चत्वार एव हि ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005514011, "chapter_id": 25514, "verse_number": "२-३१-१२", "content_sanskrit": "अन्वीक्ष्य देव ब्रह्माणं यज्ञात्मानं चं संस्थितम ।\nप्रोचुः संविग्नहृदया याथात्म्यं परमेष्ठिन ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005514012, "chapter_id": 25514, "verse_number": "२-३१-१३", "content_sanskrit": "ऋग्वेद उवाच ।\nयस्यान्त स्थानि भूतानि यस्मात सर्वं प्रवर्तते ।\nयदाहुस्तत्परं तत्त्वं स देवः स्यान्महेश्वरः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005514013, "chapter_id": 25514, "verse_number": "२-३१-१४", "content_sanskrit": "यजुर्वेद उवाच ।\nयो यज्ञॆरखिलैरीशो योगेन च समर्च्यते ।\nयमाहुरीश्वरम देवं स देवः स्यात पिनाकधृक ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005514014, "chapter_id": 25514, "verse_number": "२-३१-१५", "content_sanskrit": "सामवेद उवाच ।\nयेनेदं भ्राम्यते चक्रं यदाकाशान्तरं शिवम ।\nयोगिभिर्विद्यते तत्त्वं महादेवः स शंकरः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005514015, "chapter_id": 25514, "verse_number": "२-३१-१६", "content_sanskrit": "अथर्ववेद उवाच ।\nयं प्रपश्यन्ति योगेशं यजन्तो यतयः परम ।\nमहेशं पुरुषं रुद्रं स देवो भगवान भवः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005514016, "chapter_id": 25514, "verse_number": "२-३१-१७", "content_sanskrit": "एवं स भगवान ब्रह्मा वेदानामीरितं शुभम ।\nश्रुत्वाह प्रहसह वाक्य विश्वात्मापि विमोहितः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005514017, "chapter_id": 25514, "verse_number": "२-३१-१८", "content_sanskrit": "कथं तत्परमं ब्रह्मा सर्वसंगविवर्जितम ।\nरमते भार्यया सार्धं प्रमथैश्चातिगर्वितैः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005514018, "chapter_id": 25514, "verse_number": "२-३१-१९", "content_sanskrit": "इतिरितेऽथ भगवान प्रणवात्मा सनातनः ।\nअमूतो मूर्तिमान भूत्वा वचः प्राह पितामहम ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005514019, "chapter_id": 25514, "verse_number": "२-३१-२०", "content_sanskrit": "प्रणव उवाच ।\nन ह्रोष भगवान पत्‍न्या स्वात्मनो व्यतिरिक्तिया ।\nकदाचिद रमते रुद्रस्तादृषो हि महेश्वरः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005514020, "chapter_id": 25514, "verse_number": "२-३१-२१", "content_sanskrit": "अयं स भगवानीशः स्वयंज्योतिः सनातनः ।\nस्वानन्दभुता कथिता देवी नागन्तुका शिवा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005514021, "chapter_id": 25514, "verse_number": "२-३१-२२", "content_sanskrit": "इत्येकमुक्तेपि तदा यज्ञमूर्तेरजस्य च ।\nनाज्ञानमगमन्नाशमीश्वरस्यैव मायया ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005514022, "chapter_id": 25514, "verse_number": "२-३१-२३", "content_sanskrit": "तदन्तरे महाज्योतिर्विरिज्जो विश्वभावनाः ।\nप्रापश्यददभुतं दिव्यं पुरयन गगनान्तरम ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005514023, "chapter_id": 25514, "verse_number": "२-३१-२४", "content_sanskrit": "तन्मध्यसंस्थं विमलं मण्डलं तेजोसोज्ज्वलम ।\nव्योममध्यगतं दिव्यं प्रादुरासीद द्विजोत्तमाः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005514024, "chapter_id": 25514, "verse_number": "२-३१-२५", "content_sanskrit": "स दृष्टा वदनं दिव्यं मूर्धिं लोकपितामहः ।\nतेन तन्मण्डलं घोरमालोकदनिन्दितम ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005514025, "chapter_id": 25514, "verse_number": "२-३१-२६", "content_sanskrit": "प्रजज्वालातिकोपेन ब्रह्माणः पंचमं शिरः ।\nक्षणाददृश्यत महान पुरुषोः नीललोहितः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005514026, "chapter_id": 25514, "verse_number": "२-३१-२७", "content_sanskrit": "त्रिशुलपिंगलो देवो नागयज्ञोपवीतवान ।\nतं प्राह भगवान ब्रह्मा शंकर नीललोहितम ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005514027, "chapter_id": 25514, "verse_number": "२-३१-२८", "content_sanskrit": "जानमि भवतः पुर्वं ललाटादेव शंकर ।\nप्रादुर्भावं महेशानं मामेव शरणं व्रज ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005514028, "chapter_id": 25514, "verse_number": "२-३१-२९", "content_sanskrit": "श्रुत्वा सगर्ववचनं पद्मयोनेरथेश्वरः ।\nप्राहिणोत पुरुषं कालं भैरवं लोकदाहकम ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005514029, "chapter_id": 25514, "verse_number": "२-३१-३०", "content_sanskrit": "स कृत्वा सुमहद युद्धं ब्रह्माण कालभैरवः ।\nचकर्त तस्य वदनं विरित्र्चस्याथ पंचमम ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005514030, "chapter_id": 25514, "verse_number": "२-३१-३१", "content_sanskrit": "निकृत्तवदनो देवो ब्रह्मा देवेन शम्भुना ।\nममार चेशयोगेन जीवितं प्राप विश्वसृक ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005514031, "chapter_id": 25514, "verse_number": "२-३१-३२", "content_sanskrit": "अथानुपश्यद गिरिशं मण्डलान्तरसंस्थितम ।\nसमासीनं महादेव्या महादेव सनातनम ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005514032, "chapter_id": 25514, "verse_number": "२-३१-३३", "content_sanskrit": "भुजगंराजवलयं चन्द्रावयवभुषणम ।\nकोटिसुर्यप्रतीकाश जटाजुटविराजितम ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005514033, "chapter_id": 25514, "verse_number": "२-३१-३४", "content_sanskrit": "शार्दुलचर्मवसनं दिव्यमालासमन्वितम ।\nत्रिशुलपाणिं दुष्प्रेक्ष्यं योगिनं भूतिभुषणम ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005514034, "chapter_id": 25514, "verse_number": "२-३१-३५", "content_sanskrit": "यमन्तरा योगनिष्ठाः प्रपश्यन्ति हृदीश्‍वरम ।\nतमादिदेवं ब्रह्माणं महादेवं ददर्श ह ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005514035, "chapter_id": 25514, "verse_number": "२-३१-३६", "content_sanskrit": "यस्य सा परमा देवी शक्तिराकशसंस्थिता ।\nसोऽनन्तैश्वर्ययोगात्मा महेशो दृश्यतो किल ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005514036, "chapter_id": 25514, "verse_number": "२-३१-३७", "content_sanskrit": "यस्याशेषजगद बीजं विलयं याति मोहनम ।\nसकृत्प्रणाममात्रेण स रुद्रः खलु दुश्यते ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005514037, "chapter_id": 25514, "verse_number": "२-३१-३८", "content_sanskrit": "योऽथ नाचरनिरतान स्वभक्तानेव केवलम ।\nविमोचयति लोकानां नायको दृश्यते किल ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005514038, "chapter_id": 25514, "verse_number": "२-३१-३९", "content_sanskrit": "यस्य वेदविदः शान्ता निर्द्वन्द्वा ब्रहमचारिणः ।\nविदन्ति विमलं रुपं स शम्भर्दृश्यते किल ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005514039, "chapter_id": 25514, "verse_number": "२-३१-४०", "content_sanskrit": "यस्य ब्रह्मादयो देवा ऋषयो ब्रह्मावादिनः ।\nअर्चयन्ति सदा लिंग विश्‍वेशः खलु दृश्यते ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005514040, "chapter_id": 25514, "verse_number": "२-३१-४१", "content_sanskrit": "यस्याशेशजगद बीजं विलयं याति मोहनम ।\nसकृत्प्रणाममात्रेण स रुद्रः खलु दृश्यते ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005514041, "chapter_id": 25514, "verse_number": "२-३१-४२", "content_sanskrit": "विद्यासहायो भगवान यस्यासौ मण्डलान्तरम ।\nहिरण्यगर्भपुत्रोऽसर्वीश्वरो दृश्यते किल ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005514042, "chapter_id": 25514, "verse_number": "२-३१-४३", "content_sanskrit": "यस्याशेषजगत्सूतिर्विज्ञानतनुरिश्वरी ।\nन मुत्र्चति सदा पार्श्व शंकरोऽसावदृश्यत ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005514043, "chapter_id": 25514, "verse_number": "२-३१-४४", "content_sanskrit": "पुष्पं वा यादि वा पंत्र यत्पादयुगले जलम ।\nदत्वा तरति संसारं रुद्रोऽसौ दृश्यते किल ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005514044, "chapter_id": 25514, "verse_number": "२-३१-४५", "content_sanskrit": "तत्संनिधाने सकलं नियच्छति सनातनः ।\nकालः किल स योगात्मा कालकालो हि दृश्यते ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005514045, "chapter_id": 25514, "verse_number": "२-३१-४६", "content_sanskrit": "जीवनं सर्वलोकानां त्रिलोकस्यैव भूषणम ।\nसोमः स दृश्यते देवः सोमो यस्य विभुषणम ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005514046, "chapter_id": 25514, "verse_number": "२-३१-४७", "content_sanskrit": "देव्या सह सदा साक्षाद यस्य योगः स्वभावतः ।\nगीयते परमा मुक्तिः स योगी दृश्यते किल ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005514047, "chapter_id": 25514, "verse_number": "२-३१-४८", "content_sanskrit": "योगिनो योगतत्त्वज्ञा वियोगाभिमुखाऽनिशम ।\nयोगं ध्यायन्ति देव्याऽसौ स योगी दृश्यते किल ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005514048, "chapter_id": 25514, "verse_number": "२-३१-४९", "content_sanskrit": "सोऽनुवीक्ष महादेव महादेव्या सनतनम ।\nवरासने समासीनमवाप परमा स्मृतिम ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005514049, "chapter_id": 25514, "verse_number": "२-३१-५०", "content_sanskrit": "लब्ध्वा माहेश्वरी दिव्यां संस्मृतिं भगवानजः ।\nतोषयामास वरदं सोमं सोमविभुषणम ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005514050, "chapter_id": 25514, "verse_number": "२-३१-५१", "content_sanskrit": "ब्रह्मोवाच ।\nनमो देवाय महते महादेव्यै नमो नमः ।\nनमः शिवाय शान्ताय शिवायै शान्तये नमः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7005514051, "chapter_id": 25514, "verse_number": "२-३१-५२", "content_sanskrit": "ओं नमो ब्रह्माणे तुभ्यं विद्यायै ते नमो नमः ।\nनमो मूलप्रकृतमहेशाय नमो नमः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7005514052, "chapter_id": 25514, "verse_number": "२-३१-५३", "content_sanskrit": "नमो विज्ञानदेहाय चिन्तायै ते नमो नमः ।\nनमस्ते कालकालाय इश्वरायै नमो नमः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7005514053, "chapter_id": 25514, "verse_number": "२-३१-५४", "content_sanskrit": "नमो नमोऽस्तु रुद्राय रुद्राण्यै ते नमो नमः ।\nनमो नमस्ते कामाय मायायै च नमो नमः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7005514054, "chapter_id": 25514, "verse_number": "२-३१-५५", "content_sanskrit": "नियन्त्रे सर्वकार्याणां क्षोभिकायैः नमो नमः ।\nनमोऽस्तु ते प्रकृतये नमो नारायणायच च ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7005514055, "chapter_id": 25514, "verse_number": "२-३१-५६", "content_sanskrit": "योगदायै नमस्तुभ्यं योगिनां गुरवे नमः ।\nनमः संसारनाशाय संसारोत्पत्तये नमः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7005514056, "chapter_id": 25514, "verse_number": "२-३१-५७", "content_sanskrit": "नित्यानन्दाय विभवे नमोऽस्त्वानन्दमूर्तये ।\nनमः कार्यविहिनाय विश्वप्रकृतये नमः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7005514057, "chapter_id": 25514, "verse_number": "२-३१-५८", "content_sanskrit": "ओंकारमूर्तये तुभ्यं तदन्तः संस्थिताय च ।\nनमस्ते व्योमसंस्थाय व्योमशक्त्यै नमो नमः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7005514058, "chapter_id": 25514, "verse_number": "२-३१-५९", "content_sanskrit": "इति सोमाष्तकेनेशं प्रणनाम पितामहः ।\nपपात दण्डवत भूमौ गृणन वै शतरुद्रियम ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7005514059, "chapter_id": 25514, "verse_number": "२-३१-६०", "content_sanskrit": "अथ देवो महादेवः प्रणतार्तिहरो हरः ।\nप्रोवाचोत्थाप्य हस्ताभ्यां प्रीतोऽस्मि तव साम्प्रतम ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7005514060, "chapter_id": 25514, "verse_number": "२-३१-६१", "content_sanskrit": "दत्त्वासौ परमं योगमैश्वर्यमतुलं महत ।\nप्रोवाचाग्रे स्थितं देवं नीललोहितमीश्वरम ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7005514061, "chapter_id": 25514, "verse_number": "२-३१-६२", "content_sanskrit": "एष ब्रह्मास्य जगतः सम्पुज्यः प्रथमः सुतः ।\nआत्मनो रक्षणीयस्ते गुरुर्ज्येष्ठः पिता तव ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7005514062, "chapter_id": 25514, "verse_number": "२-३१-६३", "content_sanskrit": "अयं पुराणपुरुषो न हन्तव्यस्त्वयानघ ।\nस्ययोगैर्श्वर्यमाहात्म्यान्मामेव शरणं गतः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7005514063, "chapter_id": 25514, "verse_number": "२-३१-६४", "content_sanskrit": "अयं च यज्ञो भगवान सगर्वो भवतानघ ।\nशासितव्यो विरित्र्चस्य धारणीयं शिरस्त्वया ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7005514064, "chapter_id": 25514, "verse_number": "२-३१-६५", "content_sanskrit": "ब्रह्माहत्यापनोदार्थ व्रतं लोकाय दर्शयन ।\nचरस्व सततं भिक्षां संस्थापय सुरद्विजान ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7005514065, "chapter_id": 25514, "verse_number": "२-३१-६६", "content_sanskrit": "इत्येतदुक्त्वा वचनं भगवान परमेश्वरः ।\nस्थानं स्वाभाविकं दिव्य ययौ तप्तरमं पदम ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7005514066, "chapter_id": 25514, "verse_number": "२-३१-६७", "content_sanskrit": "ततः स भगवानीशः कपर्दी नीललोहितः ।\nग्राहयामास वदनं ब्रह्माणः कालभैरवम ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7005514067, "chapter_id": 25514, "verse_number": "२-३१-६८", "content_sanskrit": "चर त्वं पापनाशार्थं व्रतं लोकहितावहम ।\nकपालहस्तो भगवान भिक्षां गृह्णातु सर्वतः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7005514068, "chapter_id": 25514, "verse_number": "२-३१-६९", "content_sanskrit": "उक्त्वैवं प्राहिणोत कन्यां ब्रह्माहत्यामिति श्रुताम ।\nदंष्टाकरालवदनां ज्वालामालविभुषणाम ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7005514069, "chapter_id": 25514, "verse_number": "२-३१-७०", "content_sanskrit": "यावद वाराणसीं दिव्यां पूरीमेष गमिष्यति ।\nतावत त्वं भीषणे कालमनुगच्छ त्रिलोचनम ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7005514070, "chapter_id": 25514, "verse_number": "२-३१-७१", "content_sanskrit": "एवमाभाष्य कालाग्निं प्राह देवो महेश्वरः ।\nअटस्व निखिलं लोकं भिक्षार्थी मन्नियोगतः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7005514071, "chapter_id": 25514, "verse_number": "२-३१-७२", "content_sanskrit": "यदा द्रक्ष्यसि देवेशं नारायणमनामयम ।\nतदासौ वक्ष्यति स्पष्टमुपायं पापशोधनम ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7005514072, "chapter_id": 25514, "verse_number": "२-३१-७३", "content_sanskrit": "स देवदेवतावाक्यमाकर्ण्य भगवान हरः ।\nकपालपाणिर्विश्वात्मा चचार भुवनत्रयम ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7005514073, "chapter_id": 25514, "verse_number": "२-३१-७४", "content_sanskrit": "आस्थाय विकृतं वेषं दीप्यमानं स्वतेजसा ।\nश्रीमत पवित्रमतुलं जटाजुटविराजितम ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7005514074, "chapter_id": 25514, "verse_number": "२-३१-७५", "content_sanskrit": "कोटिसुर्यप्रतीकाशैः प्रमथैश्चतिगर्वितैः ।\nभाति कालग्निनयनो महादेवः समावृतः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7005514075, "chapter_id": 25514, "verse_number": "२-३१-७६", "content_sanskrit": "पीत्वा तदमृतं दिव्यमानन्दं परमेष्ठिनः ।\nलीलाविलासबहुलो लोकानागच्छतीश्वरः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7005514076, "chapter_id": 25514, "verse_number": "२-३१-७७", "content_sanskrit": "तं दृष्टा कालवदनं शंकरं कालभैरवम ।\nरुपलावण्यसम्पन्नं नारीकुलमगादनु ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7005514077, "chapter_id": 25514, "verse_number": "२-३१-७८", "content_sanskrit": "गायन्ति विविधं गीतं नृत्यन्ति पुरतः प्रभोः ।\nसस्मितं प्रेक्ष्य वदनं चक्रुर्भ्रुभंगमेव च ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7005514078, "chapter_id": 25514, "verse_number": "२-३१-७९", "content_sanskrit": "स देवदानवादीनां देशानभ्येत्य शुलधृक ।\nजगाम विष्णोर्भवनं यत्रास्ते मधुसुदनः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7005514079, "chapter_id": 25514, "verse_number": "२-३१-८०", "content_sanskrit": "निरीक्ष्य दिव्यभवनं शंकरो लोकशंकरः ।\nसहैव भुतप्रवरैः प्रवेष्टमुपचक्रमे ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7005514080, "chapter_id": 25514, "verse_number": "२-३१-८१", "content_sanskrit": "अविज्ञाय परं भावं दिव्यं तत्पारमेश्वरम ।\nन्यवारयत त्रिशुलांक द्वारपालो महाबलः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7005514081, "chapter_id": 25514, "verse_number": "२-३१-८२", "content_sanskrit": "शंखचक्रगदापाणिः पीतवासा महाभुजः ।\nविष्वक्सेन इति ख्यातो विष्णोरंशसमुद्भवः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7005514082, "chapter_id": 25514, "verse_number": "२-३१-८३", "content_sanskrit": "अथैनं शंकरगणो युयुधे विष्णुसम्भवम ।\nभीषणो भैरवादेशात कालवेग इति श्रुतः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7005514083, "chapter_id": 25514, "verse_number": "२-३१-८४", "content_sanskrit": "विजित्यं तं कालवेगं क्रोधसंरक्तलोचनः ।\nरुद्रायाभिमुखं रौद्रं चिक्षेप च सुदर्शनम ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7005514084, "chapter_id": 25514, "verse_number": "२-३१-८५", "content_sanskrit": "अथ देवो महादेवस्त्रिपुरारिस्त्रुशुलभृत ।\nतमापतन्तं सावज्ञमालोकयदमित्रजित ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7005514085, "chapter_id": 25514, "verse_number": "२-३१-८६", "content_sanskrit": "तदन्तरे महदभृतं युगान्तदहनोपमम ।\nशुलेनोरसि निभिद्य पातयामास तं भुवि ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7005514086, "chapter_id": 25514, "verse_number": "२-३१-८७", "content_sanskrit": "स शुलभिहतोऽत्यर्थ त्यक्त्वा स्वं परमं बलम ।\nतत्याज जीवित दृष्टा मृत्त्युं व्याधिहतां इव ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7005514087, "chapter_id": 25514, "verse_number": "२-३१-८८", "content_sanskrit": "निहत्य विष्णुपुरुषं सार्धं; प्रमथपुंगवैः ।\nविवेश चान्तरगृहं समादान कलेवरम ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7005514088, "chapter_id": 25514, "verse_number": "२-३१-८९", "content_sanskrit": "निरीक्ष्य जगतो हेतुमीश्वरं भगवान हरिः ।\nशिरो ललाटात सम्भिद्य रक्तधारामपातयत ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7005514089, "chapter_id": 25514, "verse_number": "२-३१-९०", "content_sanskrit": "गृहाण भगवान भिक्षां मदीयाममितद्युते ।\nन विद्यतेऽनाभ्युदिता तव त्रिपुरमर्दन ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7005514090, "chapter_id": 25514, "verse_number": "२-३१-९१", "content_sanskrit": "न सम्पुर्ण कपालं तद ब्रह्माणः परमेष्ठिनः ।\nदिव्यं वर्षसहस्त्रं तु सा च धारा प्रवाहिताः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7005514091, "chapter_id": 25514, "verse_number": "२-३१-९२", "content_sanskrit": "अथाब्रवीत कालरुद्रं हरिर्नारायणः प्रभुः ।\nसंस्तुयं वैदिकैर्मन्त्रैब्रहुमानपुरः सरम ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7005514092, "chapter_id": 25514, "verse_number": "२-३१-९३", "content_sanskrit": "किमर्थमेतद वदनं ब्रह्माणो भवता धृतम ।\nप्रोवाच वृत्तमखिलं भगवान परमेश्वरः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7005514093, "chapter_id": 25514, "verse_number": "२-३१-९४", "content_sanskrit": "समाहुय हृषीकेशो ब्रह्माहत्यामथाच्युतः ।\nप्रार्थयामास देवेशो विमुत्र्चेति त्रिशुलिनम ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7005514094, "chapter_id": 25514, "verse_number": "२-३१-९५", "content_sanskrit": "न तत्याजाथ सा पार्श्व व्याहृतापि मुरारिणा ।\nचिरं ध्यात्वा जगद्योनिः शंकरं प्राह सर्ववित ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7005514095, "chapter_id": 25514, "verse_number": "२-३१-९६", "content_sanskrit": "व्रजस्व भगवन दिव्यां पुरीं वाराणसीं शुभाम ।\nयत्राखिलजगदद्दोषं क्षिप्रं नाशयतीश्वरः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7005514096, "chapter_id": 25514, "verse_number": "२-३१-९७", "content_sanskrit": "ततः सर्वाणि गुह्मानि तीर्थान्यायतनानि च ।\nजगाम लीलया देवो लोकानां हितकाम्यया ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7005514097, "chapter_id": 25514, "verse_number": "२-३१-९८", "content_sanskrit": "संस्तुयमानः प्रमथैर्महायोगैरितस्ततः ।\nनृत्यमानो महायोगी हस्तन्यस्तकलेवरः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7005514098, "chapter_id": 25514, "verse_number": "२-३१-९९", "content_sanskrit": "तमभ्यधावद भगवान हरिर्नारायणः स्वयम ।\nअथास्थायापरं रुपं नृत्यदर्शनलालसः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7005514099, "chapter_id": 25514, "verse_number": "२-३१-१००", "content_sanskrit": "निरीक्षणामाणो गोविन्दं वृषेन्द्राकिंतशासनः ।\nसस्मितोऽनन्तयोगात्मा नृत्याति स्म पुनः पुनः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7005514100, "chapter_id": 25514, "verse_number": "२-३१-१०१", "content_sanskrit": "अथ सानुचरो रुद्रः सहारिर्धर्मवाहनः ।\nभेजे महदेवपुरीं वाराणसीमति श्रुताम ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7005514101, "chapter_id": 25514, "verse_number": "२-३१-१०२", "content_sanskrit": "प्रविष्टमात्रे देवेशे ब्रह्माहत्या कपर्दिने ।\nहा हेत्युक्त्वा सनादं सा पातालं प्राप दुःखिता ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7005514102, "chapter_id": 25514, "verse_number": "२-३१-१०३", "content_sanskrit": "प्रविश्य परमं स्थानं कपालं ब्रह्माणो हरः ।\nगणनामग्रतो देवः स्थापयामास शंकरः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7005514103, "chapter_id": 25514, "verse_number": "२-३१-१०४", "content_sanskrit": "स्थापयित्वा महादेवो ददौ तत्त्व कलेवरम ।\nउक्त्वा सजीवमस्त्वीशी विष्णवे स घृणानिधिः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7005514104, "chapter_id": 25514, "verse_number": "२-३१-१०५", "content_sanskrit": "ये स्मरन्ति ममाजस्त्रं कापालं वेषमुत्तमम ।\nतेषा विनश्यति क्षिप्रामिहामुत्र च पातकम ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7005514105, "chapter_id": 25514, "verse_number": "२-३१-१०६", "content_sanskrit": "आगम्य तीर्थप्रवरे स्नानं कृत्वा विधानतः ।\nतर्पयित्वा तत परं ज्ञानं ददामि परमं पदम ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7005514106, "chapter_id": 25514, "verse_number": "२-३१-१०७", "content_sanskrit": "इतीदमुक्त्वा भगवान समलिंगं जनार्दनम ।\nसहैव प्रमथेशानैः क्षणादन्तरधीयत ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7005514107, "chapter_id": 25514, "verse_number": "२-३१-१०८", "content_sanskrit": "स लब्ध्वा भगवान कृष्णो विष्वक्सेनं त्रिशुलिंनः ।\nस्वं देशमगमत तुर्ण गृहीत्वा परमं वपुः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7005514108, "chapter_id": 25514, "verse_number": "२-३१-१०९", "content_sanskrit": "एतद व कथितं पुण्यं महापाकनाशनमः ।\nकपालमोचनं तीर्थं स्थाणोः प्रियकरं शुभम ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7005514109, "chapter_id": 25514, "verse_number": "२-३१-११०", "content_sanskrit": "य इमं पठतेऽध्यायं ब्राह्मणानां समीपतः ।\nवाचिकैर्मानसैः पापैः कायिकैश्च विमुच्यते ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}]