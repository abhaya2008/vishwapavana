[{"id": 7006285000, "chapter_id": 26285, "verse_number": "३-३९-१", "content_sanskrit": "अगस्त्य उवाच अनाद्यनन्तमव्यक्तं व्यक्तानामादिकारणम् ।\nआनन्दबोधैकरसं तन्महन्मन्महे महः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006285001, "chapter_id": 26285, "verse_number": "३-३९-२", "content_sanskrit": "अश्वानन महाप्राज्ञ वेदवेदान्तवित्तम ।\nश्रुतमेतन्महापुण्यं ललिताख्यानमुत्तमम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006285002, "chapter_id": 26285, "verse_number": "३-३९-३", "content_sanskrit": "सर्वपूज्या त्वया प्रोक्ता त्रिपुरा परदेवता ।\nपाशाङ्कुशधनुर्बाण परिष्कृतचतुर्भुजा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006285003, "chapter_id": 26285, "verse_number": "३-३९-४", "content_sanskrit": "तस्या मन्त्रमिति प्रोक्तं श्रीचक्रं चक्रूषणम् ।\nनवावरणमीशानी श्रीपरस्याधिदैवतम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006285004, "chapter_id": 26285, "verse_number": "३-३९-५", "content_sanskrit": "काञ्चीपुरे पवित्रेऽस्मिन्महीमण्डलमण्डले ।\nकेयं विभाति कल्याणी कामाक्षीत्यभिविश्रुता ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006285005, "chapter_id": 26285, "verse_number": "३-३९-६", "content_sanskrit": "द्विभुजा विविधोल्लासविलसत्तनुवल्लरी ।\nअदृष्टपूर्वसैन्दर्या परज्योतिर्मयी परा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006285006, "chapter_id": 26285, "verse_number": "३-३९-७", "content_sanskrit": "सूत उवाच अगस्त्येनैवमुक्तः सन्परानन्दादृतेक्षणः ।\nध्यायंस्तच्च परं तेजो हयग्रीवो महामनाः ।\nइति ध्यात्वा नमस्कृत्य तमगस्त्यमथाब्रवीत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006285007, "chapter_id": 26285, "verse_number": "३-३९-८", "content_sanskrit": "हयग्रीव उवाच रहस्यं संप्रवक्ष्यामि लोपामुद्रापते शृणु ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006285008, "chapter_id": 26285, "verse_number": "३-३९-९", "content_sanskrit": "आद्या याणुतरा सा स्याच्चित्परा त्वादिकारणम् ।\nअन्ताख्येति तथा प्रोक्ता स्वरूपात्तत्त्वचिन्तकैः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006285009, "chapter_id": 26285, "verse_number": "३-३९-१०", "content_sanskrit": "द्वितीयाभूत्ततः शुद्धपराद्विभुजसंयुता ।\nदक्षहस्ते योगमुद्रां वामहस्ते तु पुस्तकम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006285010, "chapter_id": 26285, "verse_number": "३-३९-११", "content_sanskrit": "बिभ्रती हिमकुन्देन्दुमुक्तासमवपुर्द्युतिः ।\nपरापरा तृतीया स्याद्बा लार्कायुतसंमिता ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006285011, "chapter_id": 26285, "verse_number": "३-३९-१२", "content_sanskrit": "सर्वाभरणसंयुक्ता दशहस्तधृताम्बुजा ।\nवामोरुन्यस्तहस्ता वा किरीटार्धेन्दुभूषणा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006285012, "chapter_id": 26285, "verse_number": "३-३९-१३", "content_sanskrit": "पश्चाच्चतुर्भुजा जाता सा परा त्रिपुरारुणा ।\nपाशाङ्कुशेक्षुकोदण्डपञ्चबाणलसत्करा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006285013, "chapter_id": 26285, "verse_number": "३-३९-१४", "content_sanskrit": "ललिता सैव कामाक्षी काञ्च्यां व्यक्तिमुपागता ।\nसरस्वतीरमागौर्यस्तामेवाद्यामुपासते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006285014, "chapter_id": 26285, "verse_number": "३-३९-१५", "content_sanskrit": "नेत्रद्वयं महेशस्य काशीकाञ्जीपुरद्वयम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006285015, "chapter_id": 26285, "verse_number": "३-३९-१६", "content_sanskrit": "विख्यातं वैष्णवं क्षेत्रं शिवसांनिध्य कारकम् ।\nकाञ्चीक्षेत्रे पुरा धाता सर्वलोकपितामहः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006285016, "chapter_id": 26285, "verse_number": "३-३९-१७", "content_sanskrit": "श्रीदेवीदर्शनायैव तपस्तेपे सुदुष्करम् ।\nआत्मैकध्यानयुक्तस्य तस्यव्रतवतो मुने ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006285017, "chapter_id": 26285, "verse_number": "३-३९-१८", "content_sanskrit": "प्रादुरासीत्पुरो लक्ष्मीः पद्महस्ता परात्परा ।\nपद्मासने च तिष्ठन्ती विष्णुना जिष्णुना सह ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006285018, "chapter_id": 26285, "verse_number": "३-३९-१९", "content_sanskrit": "सर्वशृङ्गारवेषाढ्या सर्वाभरणभूषिता ।\nसिंहासनेश्वरी ख्याता सर्वलोकैकरक्षिणी ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006285019, "chapter_id": 26285, "verse_number": "३-३९-२०", "content_sanskrit": "तां दृष्ट्वाद्भुतसैन्दर्यां परज्योतिर्मयीं पराम् ।\nआदिलक्ष्मीमिति ख्यातां सर्वेषां हृदये स्थिताम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006285020, "chapter_id": 26285, "verse_number": "३-३९-२१", "content_sanskrit": "यामाहुस्त्रिपुरामेव ब्रह्मविष्णवीशमातरम् ।\nकामाक्षीति प्रसिद्धां तामस्तौ षीत्पुर्मभक्तिमान् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006285021, "chapter_id": 26285, "verse_number": "३-३९-२२", "content_sanskrit": "ब्रह्मोवाच ।\nजय देवि जगन्मातर्जय त्रिपुरसुन्दरि ।\nजय श्रीनाथसहजे जय श्रीसर्वमङ्गले ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006285022, "chapter_id": 26285, "verse_number": "३-३९-२३", "content_sanskrit": "जय श्रीकरुणाराशे जय शृङ्गारनायिके ।\nजयजयेधिकसिद्धेशि जय योगीन्द्रवन्दिते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006285023, "chapter_id": 26285, "verse_number": "३-३९-२४", "content_sanskrit": "जयजय जगदम्ब नित्यरूपे जयजय सन्नुतलोकसौख्यदात्रि ।\nजयजय हिमशैलकीर्तनीये जयजय शङ्करकामवामनेत्रि ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006285024, "chapter_id": 26285, "verse_number": "३-३९-२५", "content_sanskrit": "जगज्जन्मस्थितिध्वंसपिधानानुग्रहान्मुहुः ।\nया करोति स्वसङ्कल्पात्तस्यै देव्यै नमोनमः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006285025, "chapter_id": 26285, "verse_number": "३-३९-२६", "content_sanskrit": "वर्णाश्रमाणां सांकर्यकारिणः पापिनो जनान् ।\nनिहन्त्याद्यातितीक्ष्णास्त्रैस्तस्यै देव्यैदृ ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006285026, "chapter_id": 26285, "verse_number": "३-३९-२७", "content_sanskrit": "नागमैश्च न वेदैश्च न शास्त्रैर्न च योगिभिः ।\nदेद्या या च स्वसंवेद्या तस्यै देव्यै नमोनमः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006285027, "chapter_id": 26285, "verse_number": "३-३९-२८", "content_sanskrit": "रहस्याम्नायवेदान्तैस्तत्त्वविद्भिर्मुनीश्वरैः ।\nपरं ब्रह्मेति या ख्याता तस्यैदृ ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006285028, "chapter_id": 26285, "verse_number": "३-३९-२९", "content_sanskrit": "हृदयस्थापि सर्वेषां या न केनापि दृश्यते ।\nसूक्ष्मविज्ञानरूपायैदृ ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006285029, "chapter_id": 26285, "verse_number": "३-३९-३०", "content_sanskrit": "ब्रह्मा विष्णुश्च रुद्रश्च ईश्वरश्च सदाशिवः ।\nयद्ध्यानैकपरा नित्यं तस्यैदृ ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006285030, "chapter_id": 26285, "verse_number": "३-३९-३१", "content_sanskrit": "यच्चरणभक्ता इन्द्राद्या यदाज्ञामेव बिभ्रति ।\nसाम्राज्यसंपदीशायै तस्यैदृ ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006285031, "chapter_id": 26285, "verse_number": "३-३९-३२", "content_sanskrit": "वेदा निःश्वसितं यस्या वीक्षितं भूतपञ्चकम् ।\nस्मितं चराचरं विश्वं तस्यैदृ ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006285032, "chapter_id": 26285, "verse_number": "३-३९-३३", "content_sanskrit": "सहस्रशीर्षा भोगीन्द्रो धरित्रीं तु यदाज्ञया ।\nधत्ते सर्वजनाधारां तस्यैदृ ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006285033, "chapter_id": 26285, "verse_number": "३-३९-३४", "content_sanskrit": "ज्वलत्यग्निस्तपत्यर्केवातो वाति यदाज्ञया ।\nज्ञानशक्तिस्वरूपायै तस्यैदृ ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006285034, "chapter_id": 26285, "verse_number": "३-३९-३५", "content_sanskrit": "पञ्चविंशतितत्त्वानि मायाकञ्चुकपञ्चकम् ।\nयन्मयं मुनयः प्राहुस्तस्यैदृ ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006285035, "chapter_id": 26285, "verse_number": "३-३९-३६", "content_sanskrit": "शिवशक्तीश्वराश्चैव शुद्धबोधः सदाशिवः ।\nयदुन्मेषविभेदाः स्युस्तस्यैदृ ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006285036, "chapter_id": 26285, "verse_number": "३-३९-३७", "content_sanskrit": "गुरुर्मन्त्रो देवता च तथा प्राणाश्च पञ्चधा ।\nया विराजति चिद्रूपा तस्यैदृ ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006285037, "chapter_id": 26285, "verse_number": "३-३९-३८", "content_sanskrit": "सर्वात्मनामन्तरात्मा परमान्दरूपिणी ।\nश्रीविद्येति स्मृता वा तु तस्यैदृ ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006285038, "chapter_id": 26285, "verse_number": "३-३९-३९", "content_sanskrit": "दर्शनानि च सर्वाणि यदङ्गानि विदुर्बुधाः ।\nतत्तन्नियमयूपायै तस्यै देव्यै नमोनमः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006285039, "chapter_id": 26285, "verse_number": "३-३९-४०", "content_sanskrit": "या भाति सर्वलोकेषु मणिमन्त्रौष धात्मना ।\nतत्त्वोपदेशरूपायै तस्यैदृ ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006285040, "chapter_id": 26285, "verse_number": "३-३९-४१", "content_sanskrit": "देशकालपदार्थात्मा यद्यद्वस्तु यथा तथा ।\nतत्तद्रूपेण या भाति तस्यैदृ ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006285041, "chapter_id": 26285, "verse_number": "३-३९-४२", "content_sanskrit": "हे प्रतिभटाकारा कल्याणगुणशालिनी ।\nविश्वोत्तीर्णेति चाख्याता तस्यैदृ ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006285042, "chapter_id": 26285, "verse_number": "३-३९-४३", "content_sanskrit": "इति स्तुत्वा महादेवीं धाता लोकपितामहः ।\nभूयोभूयो नमस्कृत्य सहसा शरणं गतः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006285043, "chapter_id": 26285, "verse_number": "३-३९-४४", "content_sanskrit": "सन्तुष्टा सा तदा देवी ब्रह्माणं प्रेक्ष्य संनतम् ।\nवरदा सर्वलोकानां वृणीष्व वरमित्यशात् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006285044, "chapter_id": 26285, "verse_number": "३-३९-४५", "content_sanskrit": "ब्रह्मोवाच ।\nभक्त्या त्वद्दर्शनेनैव कृतार्थोऽस्मि न संशयः ।\nतथापि प्रार्थये किञ्चिल्लोकानुग्रहकाम्यया ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006285045, "chapter_id": 26285, "verse_number": "३-३९-४६", "content_sanskrit": "कर्मभूमौ तु लोकेऽस्मिन्प्रायो मूढा इमे जनाः ।\nतेषामनुग्रहार्थाय नित्यं कुर्वत्र संनिधिम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006285046, "chapter_id": 26285, "verse_number": "३-३९-४७", "content_sanskrit": "तथेति तस्य तं कामं पूरयामास वेधसः ।\nअथ धाता पुनस्तस्या देव्या वासमकल्पयत् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006285047, "chapter_id": 26285, "verse_number": "३-३९-४८", "content_sanskrit": "श्रीदेवीसोदरं नत्वा पुण्डरीकाक्षमच्युतम् ।\nतत्सांनिध्यं सदा काञ्च्यां प्रार्थयामास चादृतः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006285048, "chapter_id": 26285, "verse_number": "३-३९-४९", "content_sanskrit": "ततस्तथा करिष्यामीत्यब्रवीत्तं जनार्दनः ।\nअथ तुष्टो जगद्धाता पुनः प्राह महेश्वरीम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006285049, "chapter_id": 26285, "verse_number": "३-३९-५०", "content_sanskrit": "शिवोऽप्यत्रैव सांनिध्यं तव प्रीत्या करोत्विति ।\nअथ श्रीत्रिपुरादक्षभागात्कामेश्वरः परः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006285050, "chapter_id": 26285, "verse_number": "३-३९-५१", "content_sanskrit": "ईशानःसर्वविद्या नामीश्वरः सर्वदेहिनाम् ।\nआविरासीन्महादेवः साक्षाच्छृङ्गारनायकः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006285051, "chapter_id": 26285, "verse_number": "३-३९-५२", "content_sanskrit": "ततः पुनः श्रीकामाक्षीभालनेत्रकटाक्षतः ।\nकाचिद्बाला प्रादुरासीन्महागौरा महोज्ज्वला ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006285052, "chapter_id": 26285, "verse_number": "३-३९-५३", "content_sanskrit": "सर्वशृङ्गारवेषाढ्या महालावण्यशेवधिः ।\nअथ श्रीपुण्डरीकाक्षो ब्रह्मणा सह सादरम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006285053, "chapter_id": 26285, "verse_number": "३-३९-५४", "content_sanskrit": "कारयामास कल्याणमादिस्त्रीपुंसयोस्तयोः ।\nआखण्डलादयो देवा वसुरुद्रादिदेवताः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006285054, "chapter_id": 26285, "verse_number": "३-३९-५५", "content_sanskrit": "मार्कण्डेयादिमुनयो वसिष्ठादिमुनीश्वराः ।\nयोगीन्द्राः सनकाद्याश्च नारदाद्याः सुरर्षयः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006285055, "chapter_id": 26285, "verse_number": "३-३९-५६", "content_sanskrit": "वामदेवप्रभृतयो जीवन्मुक्ताः शुकादयः ।\nयक्षकिन्नर गन्धर्वसिद्धविद्याधरोरगाः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006285056, "chapter_id": 26285, "verse_number": "३-३९-५७", "content_sanskrit": "गणाग्रणीर्महाशास्ता दुर्गाद्याश्चैव मातरः ।\nया यास्तु देवताः प्रोक्तास्ताः सर्वाः परमेश्वरीम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006285057, "chapter_id": 26285, "verse_number": "३-३९-५८", "content_sanskrit": "भद्रासनविमानस्था नेमुः प्राञ्जलयस्तदा ।\nमनसा निर्मितं धात्रा मध्ये नगरमद्भुतम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006285058, "chapter_id": 26285, "verse_number": "३-३९-५९", "content_sanskrit": "मन्दिरं परमेशान्या मनोहरतमं शुभम् ।\nश्रीमता वासुदेवेन सोदरेम महेश्वरः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006285059, "chapter_id": 26285, "verse_number": "३-३९-६०", "content_sanskrit": "तत्रोदवोढतां गौरीमुपाग्नि भगवान्भवः ।\nदेवदुन्दुभयो नेदुः पुष्पवृष्टिः पपात ह ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006285060, "chapter_id": 26285, "verse_number": "३-३९-६१", "content_sanskrit": "दम्पत्योर्जगतां पत्योः पाणिग्रहणमङ्गलम् ।\nको वा वर्णयितुं शक्तो यदि जिह्वासहस्रवान् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006285061, "chapter_id": 26285, "verse_number": "३-३९-६२", "content_sanskrit": "आदिश्रीमन्दिरस्यास्य वायुभागे महेशितुः ।\nविस्तृतं भुवनश्रेष्ठं कल्पितं परमेष्ठिना ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006285062, "chapter_id": 26285, "verse_number": "३-३९-६३", "content_sanskrit": "श्रीगृहस्याग्निभागे तु विचित्रं विष्णुमन्दिरम् ।\nइत्थं ता देवतास्तत्र तिस्रः सन्निहिताः सदा ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006285063, "chapter_id": 26285, "verse_number": "३-३९-६४", "content_sanskrit": "तदा प्रदक्षिणीकृत्य तत्परौ दम्पती तु तौ ।\nप्राप्तौ सभावनागारं तदा विधिजनार्दनौ ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006285064, "chapter_id": 26285, "verse_number": "३-३९-६५", "content_sanskrit": "समागम्य च सभ्यानां समास्तानांयथाविधि ।\nसंस्कारं वैदिकैर्मन्त्रैः कथयामासतुर्मुदा ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006285065, "chapter_id": 26285, "verse_number": "३-३९-६६", "content_sanskrit": "आद्यादिलक्ष्मीः सर्वेषां पुरतः श्रीपरेश्वरी ।\nविरञ्चिं दक्षिणेनाक्ष्णा वामेन हरिमैक्षत ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006285066, "chapter_id": 26285, "verse_number": "३-३९-६७", "content_sanskrit": "का नाम वाणी मा नाम कमला ते उभे ततः ।\nप्रादुर्भूते प्रभापुञ्जे पञ्जरान्त इव स्थिते ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006285067, "chapter_id": 26285, "verse_number": "३-३९-६८", "content_sanskrit": "श्रीदेवतानमच्छीर्षबद्धाञ्जलिपुटावुभौ ।\nजय कामाक्षिकामाक्षीत्यूचतुस्तां प्रणेमतुः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006285068, "chapter_id": 26285, "verse_number": "३-३९-६९", "content_sanskrit": "मूर्ते च गङ्गायमुने तत्र सेवार्थमागते ।\nतिस्रः कोट्योर्ऽधकोटी च या यास्तीर्थाधिदेवताः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006285069, "chapter_id": 26285, "verse_number": "३-३९-७०", "content_sanskrit": "सेवार्थं त्रिपुरांबा यास्तास्ताः सर्वाः समागताः ।\nतदा कराभ्यामादाय चामरे भारतीश्रियौ ।\nश्रीदेवीमुपतस्थाते वीजयन्त्यौ यथोचितम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006285070, "chapter_id": 26285, "verse_number": "३-३९-७१", "content_sanskrit": "अनर्घ्यरत्नखचितकिङ्किणीचितदोर्लते ।\nआदिश्रीनयनोत्पन्ने ते उभे भारतीश्रियौ ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006285071, "chapter_id": 26285, "verse_number": "३-३९-७२", "content_sanskrit": "संवीक्ष्य सर्वजनता विशेषेण विसिस्मिये ।\nतदा प्रभृति कल्याणी कामाक्षीत्यभिधामियात् ।\nतदुच्चारणमात्रेण श्रीदेवी शं प्रयच्छति ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006285072, "chapter_id": 26285, "verse_number": "३-३९-७३", "content_sanskrit": "कामाक्षीति त्रयो वर्णाः सर्वमङ्गलहेतवः ।\nअथ सा जगदीशानी वेदवेदाङ्गपारगे ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006285073, "chapter_id": 26285, "verse_number": "३-३९-७४", "content_sanskrit": "विधौ नित्यं निषीदेति संदिदेश सरस्वतीम् ।\nसापि वाणीश्वरी गङ्गाहस्तनिक्षिप्तचामरा ।\nपश्यतां सर्वदेवानां विधातुर्मुखमाविशत् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006285074, "chapter_id": 26285, "verse_number": "३-३९-७५", "content_sanskrit": "इन्दिरा च महालक्ष्म्या संदिष्टा तुष्टया तथा ।\nयथोचितनिवासाय विष्णोर्वक्षस्थलं मुदा ।\nतदाज्ञां शिरसा धृत्वा रमा विष्णुश्च भक्तितः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006285075, "chapter_id": 26285, "verse_number": "३-३९-७६", "content_sanskrit": "तावुभौ दंपती नत्वा महात्रिपुरसुन्दरीम् ।\nप्रार्थयामासतुर्भूयस्तदावरणदेवताम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006285076, "chapter_id": 26285, "verse_number": "३-३९-७७", "content_sanskrit": "तथास्त्विति वरं दत्त्वा ताभ्यां त्रिपुरसुन्दरम् ।\nतदावरणदेवत्वं प्राप्तौ पद्माच्युतौ तदा ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006285077, "chapter_id": 26285, "verse_number": "३-३९-७८", "content_sanskrit": "स्वपीठोत्तरमास्थाप्य दक्षिणे स्थितवान्स्वयम् ।\nअथोवाच महागौरीं त्वमन्यद्रूपमाचर ।\nतत्र यातो महागौर्याः प्रतिबिंबो मनोहरः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006285078, "chapter_id": 26285, "verse_number": "३-३९-७९", "content_sanskrit": "चकासद्दिव्यदेहेन महागौरीसमाकृतिः ।\nतरुणारुणराजाभसैन्दर्यचरणद्वयः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006285079, "chapter_id": 26285, "verse_number": "३-३९-८०", "content_sanskrit": "क्वणत्कङ्कणमञ्जीरतित्तिरीकृतपीठकः ।\nविद्युदुल्लासितस्वानमनोज्ञमणिमेखलः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006285080, "chapter_id": 26285, "verse_number": "३-३९-८१", "content_sanskrit": "रत्नकङ्कणकेयूरविराजितभुजद्वयः ।\nमुक्तावैदूर्यमाणिक्य निबद्धवरबन्धनः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006285081, "chapter_id": 26285, "verse_number": "३-३९-८२", "content_sanskrit": "विभ्राजमानो मध्येन वलित्रितयशोभितः ।\nजाह्नवीसरिदावर्तशोभिनाभीविभूषितः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006285082, "chapter_id": 26285, "verse_number": "३-३९-८३", "content_sanskrit": "पाटीरपङ्ककर्पूरकुङ्कुमालङ्कृतस्तनः ।\nआमुक्तमुक्तालङ्कारभासुरस्तनकुञ्चुकः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006285083, "chapter_id": 26285, "verse_number": "३-३९-८४", "content_sanskrit": "विनोदेन कटीदेशलंबमानसुशृङ्खलः ।\nमाणिक्यशकलाबद्धमुद्रिकाभिरलङ्कृतः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006285084, "chapter_id": 26285, "verse_number": "३-३९-८५", "content_sanskrit": "दक्षहस्तांबुजासक्तस्निग्धोज्जवलमनोहरः ।\nआभात्याप्रपदीनस्रग्दिव्याकल्पकदंबकैः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006285085, "chapter_id": 26285, "verse_number": "३-३९-८६", "content_sanskrit": "दीप्तभूषणरत्नांशुराजिराजितदिङ्मुखः ।\nतप्तहाटकसंकॢप्तरत्नग्रीबोपशोभितः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006285086, "chapter_id": 26285, "verse_number": "३-३९-८७", "content_sanskrit": "माङ्गल्यसूत्ररत्नांशुशोणिमाधरकन्धरः ।\nपालीवतंसमाणिक्यताटङ्कपरिभूषितः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006285087, "chapter_id": 26285, "verse_number": "३-३९-८८", "content_sanskrit": "जपाविद्रुमलावण्यललिताधरपल्लवः ।\nदाडिमीफलबीजाभदन्तपङ्क्तिविराजितः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006285088, "chapter_id": 26285, "verse_number": "३-३९-८९", "content_sanskrit": "मन्दमन्दस्मितोल्लासिकपोलफलकोमलः ।\nऔपम्यरहितोदारनासामणिमनोहरः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7006285089, "chapter_id": 26285, "verse_number": "३-३९-९०", "content_sanskrit": "विलसत्तिलपुष्पश्रीविमलोन्नत नासिकः ।\nईषदुन्मेषमधुरनीलोत्पलविलोचनः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7006285090, "chapter_id": 26285, "verse_number": "३-३९-९१", "content_sanskrit": "नवप्रसूनचापश्रीललितभ्रूविकाशकः ।\nअर्द्धेन्दुतुलितो भाले पूर्णेन्दुरुचिराननः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7006285091, "chapter_id": 26285, "verse_number": "३-३९-९२", "content_sanskrit": "सांद्रसौरभसंपन्नकस्तूरीतिलकोज्ज्वलः ।\nमत्तालिमालाविलसदलकाढ्यमुखांबुजः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7006285092, "chapter_id": 26285, "verse_number": "३-३९-९३", "content_sanskrit": "पारिजातप्रसूनस्रग्वाहिधम्मिल्लबन्धनः ।\nअत्यर्थरत्नखचितमुकुटाञ्चितमस्तकः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7006285093, "chapter_id": 26285, "verse_number": "३-३९-९४", "content_sanskrit": "सर्वलावण्यवसतिर्भवनं विभ्रमाश्रियः ।\nशिवो विष्णुश्च तत्रत्याः समस्ताश्च महाजनाः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7006285094, "chapter_id": 26285, "verse_number": "३-३९-९५", "content_sanskrit": "बिंबस्य तस्य देव्याश्च अभेदं जगृहुस्तदा ।\nअथ तर्हि महेशानी स्वतन्त्रा प्रविवेश ह ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7006285095, "chapter_id": 26285, "verse_number": "३-३९-९६", "content_sanskrit": "अग्रतः सर्बदेवानामाश्रयेण प्रपश्यताम् ।\nबिम्बं कृत्वात्मना बिम्बे संप्रविश्य स्थितां च ताम् ।\nदृष्ट्वा भूयो नमस्कृत्य पुनः प्रार्थितवान्विधिः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7006285096, "chapter_id": 26285, "verse_number": "३-३९-९७", "content_sanskrit": "पूर्णब्रह्मे महाशक्ते महात्रिपुरसुन्दरि ।\nश्रीकामाक्षीति विख्याते नमस्तुभ्यं दिनेदिने ।\nकिञ्चिद्विज्ञापयाम्यद्य शृणु तत्कृपया मम ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7006285097, "chapter_id": 26285, "verse_number": "३-३९-९८", "content_sanskrit": "अत्रैव तु महागौर्या महेशस्योभयोरपि ।\nश्रीदेवि नित्यकल्याणि विवाहः प्रतिवत्सरम् ।\nकर्तव्यो जगतामृद्धसेवायै च दिवौकसाम् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7006285098, "chapter_id": 26285, "verse_number": "३-३९-९९", "content_sanskrit": "भूलोकेऽस्मिन्महादेवि विमूढा जनता अपि ।\nतां दृष्ट्वा भक्तितो नत्वा प्रयान्तु परमां गतिम् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7006285099, "chapter_id": 26285, "verse_number": "३-३९-१००", "content_sanskrit": "तथेत्याकाशवाण्या तु ददौ तस्यौत्तरं परा ।\nविससर्ज च सर्वांस्तान्स्वनिकेतनिवृत्तये ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7006285100, "chapter_id": 26285, "verse_number": "३-३९-१०१", "content_sanskrit": "तदद्भुततमं शीलं स्मृत्वा स्मृत्वा मुहुर्मुहुः ।\nतां नमस्कृत्य ते सर्वे ततो जगमुर्यथागतम् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7006285101, "chapter_id": 26285, "verse_number": "३-३९-१०२", "content_sanskrit": "पितामहस्तु हृष्टात्मा मुकुन्देन शिवेन च ।\nसार्धं श्रीमन्दिरे तत्र मन्त्रोपेतां निवेश्य च ।\nआराध्य वैदिकैः स्तोत्रैः साष्टाङ्गं प्रणनाम सः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7006285102, "chapter_id": 26285, "verse_number": "३-३९-१०३", "content_sanskrit": "अथाकाशगिरा देवी ब्रह्माणमिदमब्रवीत् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7006285103, "chapter_id": 26285, "verse_number": "३-३९-१०४", "content_sanskrit": "विष्णुं शिवं च स्वस्थाने समाधाय समाहितः ।\nप्रतिसंवत्सरं तत्र सेवां कुरुदृढाशय ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7006285104, "chapter_id": 26285, "verse_number": "३-३९-१०५", "content_sanskrit": "स्वयंव्यक्तमिह श्रीशमित्रेशांबासमन्वितम् ।\nश्रीकामगिरिपीठं तु साक्षाच्छ्रीपुरमध्यगम् ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7006285105, "chapter_id": 26285, "verse_number": "३-३९-१०६", "content_sanskrit": "वामभागे वृतं लक्ष्यं विष्णुनान्यत्र सेविनम् ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7006285106, "chapter_id": 26285, "verse_number": "३-३९-१०७", "content_sanskrit": "चिदानन्दाकाररूपं सर्वपीठाधिदैवतम् ।\nअदृश्यमूर्तिमव्यक्तमादधार यथा विधि ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7006285107, "chapter_id": 26285, "verse_number": "३-३९-१०८", "content_sanskrit": "श्रीमनोज्ञे सुनक्षत्रे दलानां हीरकोरकैः ।\nअर्चिष्मद्भिरप्रधृष्यैर्ल्लोकानामभिवृद्धये ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7006285108, "chapter_id": 26285, "verse_number": "३-३९-१०९", "content_sanskrit": "इदानीं त्वं तदभ्यर्च्य यधाविधि विधे मुदा ।\nमण्डलं त्वखिलं कृत्वा निजलोकं हि पालय ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7006285109, "chapter_id": 26285, "verse_number": "३-३९-११०", "content_sanskrit": "इत्युक्तो भगवान्ब्रह्मा तथा कृत्वा तदीरितम् ।\nनिक्षिप्य हृदि तां देवीं निजं धाम जगाम सः ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7006285110, "chapter_id": 26285, "verse_number": "३-३९-१११", "content_sanskrit": "इति ते तत्त्वतः प्रोक्तं कामाक्षीशीलमद्भुतम् ।\nसाक्षादेवमहालक्ष्मीमिमां विद्धि घटोद्भव ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7006285111, "chapter_id": 26285, "verse_number": "३-३९-११२", "content_sanskrit": "य इदं शृणुयान्नित्यं यश्चापि प्रयतः पठेत् ।\nतस्य भुक्तिश्च मुक्तिश्च करस्था नात्र संशयः ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7006285112, "chapter_id": 26285, "verse_number": "३-३९-११३", "content_sanskrit": "बृहस्पतिसमो बुद्ध्या सर्वविद्याधिपो भवेत् ।\nआदिर्नारायणः श्रीमान्भगवान्भक्तवत्सलः ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7006285113, "chapter_id": 26285, "verse_number": "३-३९-११४", "content_sanskrit": "तपसा तोषितः पूर्वं मया च चिरकालतः ।\nसारूप्यमुक्तिं कृपया दत्त्वा पुत्राय मे प्रभुः ।\nमहात्रिपुरसुन्दर्या महात्म्यं समुपादिशत् ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7006285114, "chapter_id": 26285, "verse_number": "३-३९-११५", "content_sanskrit": "ततस्तस्मादहं किञ्चिद्वेद्मि वक्ष्ये न चान्यथा ।\nरहस्यमन्त्रं संवक्ष्येशृणु तं त्वं समाहितः ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7006285115, "chapter_id": 26285, "verse_number": "३-३९-११६", "content_sanskrit": "न ब्रह्मा न च विष्णुर्वा न रुद्रश्च त्रयोऽप्यमी ।\nमोहिता मायया यस्यास्तुरीयस्तु स चेश्वरः ।\nसदाशिवो न जानाति कथं प्राकृतदेवताः ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7006285116, "chapter_id": 26285, "verse_number": "३-३९-११७", "content_sanskrit": "सदाशिवस्तु सर्वात्मा सच्चिदानन्दविग्रहः ।\nअकर्तुमन्यथा कर्तुं कर्तुमस्या अनुग्रहात् ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7006285117, "chapter_id": 26285, "verse_number": "३-३९-११८", "content_sanskrit": "सदा कश्चित्तदेवाहं मन्यमानो महेश्वरः ।\nतन्मायामोहितो भूत्वा त्ववशः शवतामगात् ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7006285118, "chapter_id": 26285, "verse_number": "३-३९-११९", "content_sanskrit": "सैव कारणमेतेषामुत्पत्तौ च लयेऽपि च ।\nकश्चिदत्र विशेषोऽस्ति वक्तव्यांशोऽपि तं शृणु ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7006285119, "chapter_id": 26285, "verse_number": "३-३९-१२०", "content_sanskrit": "ब्रह्मादीनां त्रयाणां च तुरीयस्त्वीश्वरः प्रभुः ।\nचतुर्णामपि सर्वेषामादि कर्ता सदाशिवः ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7006285120, "chapter_id": 26285, "verse_number": "३-३९-१२१", "content_sanskrit": "एतद्रहस्यं कथितं तस्याश्चरितमद्भुतम् ।\nभूय एव प्रवक्ष्यामि सावधानमनाः शृणु ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}]