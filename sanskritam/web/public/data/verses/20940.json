[{"id": 7000940000, "chapter_id": 20940, "verse_number": "१-२-१", "content_sanskrit": "श्रीपराशर उवाच ।\nअविकाराय शुद्धाय नित्याय परमात्मने ।\nसदैकरूपरूपाय विष्णवे सर्वजिष्णवे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000940001, "chapter_id": 20940, "verse_number": "१-२-२", "content_sanskrit": "नमो हिरण्यगर्भाय हरये शंकराय च ।\nवासुदेवाय ताराय सर्गस्थित्यन्तकारिणे ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000940002, "chapter_id": 20940, "verse_number": "१-२-३", "content_sanskrit": "एकानेकस्वरूपाय स्थूलसूक्ष्मात्मने नमः ।\nअव्यक्तव्यक्तरूपाय विष्णवे मुक्तिहेतवे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000940003, "chapter_id": 20940, "verse_number": "१-२-४", "content_sanskrit": "सर्गस्थितिविनाशानां जगतो यो जगन्मयः ।\nमूलभूतो नमस्तस्मै विष्णवे परमात्मने ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000940004, "chapter_id": 20940, "verse_number": "१-२-५", "content_sanskrit": "आधारभूतं विश्वस्याप्यणीयांसमयीयसाम् ।\nप्रणम्य सर्वभूतस्थमच्युतं पुरुषोत्तमम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000940005, "chapter_id": 20940, "verse_number": "१-२-६", "content_sanskrit": "ज्ञानस्वरूपमत्यन्तनिर्मलं परमार्थतः ।\nतमेवार्थस्वरूपेण भ्रान्तिदर्शनतः स्थितम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000940006, "chapter_id": 20940, "verse_number": "१-२-७", "content_sanskrit": "विष्णुं ग्रसिष्णुं विश्वस्य स्थितौ सर्गे तथा प्रभुम् ।\nप्रणम्य जगतामीशमजमक्षयमव्ययम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000940007, "chapter_id": 20940, "verse_number": "१-२-८", "content_sanskrit": "कथयामि यथापूर्व दक्षाद्यैर्मुनिसत्तमैः ।\nपृष्ट प्रोवाच भगवानब्जयोनिः पितामहः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000940008, "chapter_id": 20940, "verse_number": "१-२-९", "content_sanskrit": "तैश्चौक्तं पुरुकुत्साय भूभुजे निर्मदातटे ।\nसारस्वताय तेनापि मह्मं सारस्वतेन च ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000940009, "chapter_id": 20940, "verse_number": "१-२-१०", "content_sanskrit": "परः पराणां परमः परमात्मात्मसंस्थितः ।\nरूपवर्णादिनिर्देशविशेषणविवर्जितः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000940010, "chapter_id": 20940, "verse_number": "१-२-११", "content_sanskrit": "अपक्षयविनाशाभ्यां परिणामर्धिजन्मभिः ।\nवर्जितः शक्यते वक्तुंयः सदास्तीति केवलम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000940011, "chapter_id": 20940, "verse_number": "१-२-१२", "content_sanskrit": "सर्वत्रासौ समस्तं च वसत्यत्रेति वै यतः ।\nततः स वासुदेवेति विद्वद्भिः परिपठ्यते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000940012, "chapter_id": 20940, "verse_number": "१-२-१३", "content_sanskrit": "तद्‌ब्रह्म परंमं नित्यमजमक्षयमव्ययम् ।\nएकस्वरूपं तु सदा हेयाभावाच्च निर्मलम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000940013, "chapter_id": 20940, "verse_number": "१-२-१४", "content_sanskrit": "तदेव सर्वमेवैतद्‌व्यक्ताव्यक्तस्वरूपवत् ।\nतथा पुरुषरूपेण कालरूपेण च स्थितम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000940014, "chapter_id": 20940, "verse_number": "१-२-१५", "content_sanskrit": "परस्य ब्रह्मणो रूपं पुरुषः प्रथमं द्विज ।\nव्यक्ताव्यक्ते तथैवान्ये रूपे कालस्तथा परम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000940015, "chapter_id": 20940, "verse_number": "१-२-१६", "content_sanskrit": "प्रधानपुरुषव्यक्तकालानां परमं हि यत् ।\nपश्यन्ति सूरयः शुद्धं तद्विष्णोः परमं पदम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000940016, "chapter_id": 20940, "verse_number": "१-२-१७", "content_sanskrit": "प्रधानपुरुषव्यक्तकालास्तु प्रविभागशः ।\nरूपाणि स्थितिसर्गान्तव्यक्तिसद्भावहेतवः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000940017, "chapter_id": 20940, "verse_number": "१-२-१८", "content_sanskrit": "व्यक्तं विष्णुस्तथाव्यक्तं पुरुषः काल एव च ।\nक्रीडतो बालकस्येव चेष्टां तस्य निशामय ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000940018, "chapter_id": 20940, "verse_number": "१-२-१९", "content_sanskrit": "अव्यक्तं कारणं यत्तत्प्रधानमृषिसत्तमैः ।\nप्रोच्यते प्रकृतिः सूक्ष्मा नित्यं सदसदात्मकम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000940019, "chapter_id": 20940, "verse_number": "१-२-२०", "content_sanskrit": "अक्षय्यं नान्यदाधारममेयमजरं ध्रुवम् ।\nशब्दस्पर्शविहीनं तद्रूपादिभिरसंहितम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000940020, "chapter_id": 20940, "verse_number": "१-२-२१", "content_sanskrit": "त्रिगुणं तज्जगद्योनिरनादिप्रभवाप्ययम् ।\nतेनाग्रे सर्वमेवासीद्व्‌यांत्पं वै प्रलयादनु ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000940021, "chapter_id": 20940, "verse_number": "१-२-२२", "content_sanskrit": "वेदवादविदो विद्दन्नियता ब्रह्मवादिनः ।\nपठन्ति चैतमेवार्थ प्रधानप्रतिपादकम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000940022, "chapter_id": 20940, "verse_number": "१-२-२३", "content_sanskrit": "नाहो न रात्रिर्न नभो न भूमि- र्नासीत्ममोज्योतिरभूच्च नान्यत् ।\nश्रोत्रादिबुद्धयानुपलभ्यमेकं प्राधानिकं ब्रह्म पुमांस्तदासीत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000940023, "chapter_id": 20940, "verse_number": "१-२-२४", "content_sanskrit": "विष्णोः स्वरूपात्मरतो हि ते द्वे रूपे प्रधानं पुरुषश्च विप्र ।\nतस्यैव तेऽन्येन धूते वियुक्ते रूपांन्तरं तद्‌द्विज कालसंज्ञम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000940024, "chapter_id": 20940, "verse_number": "१-२-२५", "content_sanskrit": "प्रकृतौ संस्थितं व्यक्तमतीतप्रलये तु यत् ।\nतस्मात्प्राकृतसंज्ञोऽयमुच्यते प्रतिसत्र्चरः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000940025, "chapter_id": 20940, "verse_number": "१-२-२६", "content_sanskrit": "अनादिर्भगवान्कालो नान्तोऽस्य द्विज विद्यते ।\nअव्युच्छिन्नास्ततस्त्वेते सर्गस्थित्यन्तसंयमाः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000940026, "chapter_id": 20940, "verse_number": "१-२-२७", "content_sanskrit": "गुणसाम्ये ततस्तस्मिन्पृथक्पूंसि व्यवस्थिते ।\nकालस्वरूपं तद्विष्णोर्मैत्रेय परिवर्त्तते ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000940027, "chapter_id": 20940, "verse_number": "१-२-२८", "content_sanskrit": "ततस्तु तप्तरं ब्रह्मं परमात्मा जगन्मयः ।\nसर्वगः सर्वभूतेशः सर्वात्मा परमेश्वरः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000940028, "chapter_id": 20940, "verse_number": "१-२-२९", "content_sanskrit": "प्रधानपुरुषौ चापि प्रविश्यात्मेच्छया हरिः ।\nक्षोभयामास सम्प्राप्ते सर्गकाले व्ययाव्ययौ ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000940029, "chapter_id": 20940, "verse_number": "१-२-३०", "content_sanskrit": "यथा सन्निधिमात्रेण गन्धः क्षोभाय जायते ।\nमनसो नोपकर्तृत्वात्तथाऽसौ परमेश्वरः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000940030, "chapter_id": 20940, "verse_number": "१-२-३१", "content_sanskrit": "स एव क्षोभको ब्रह्मन् क्षोभ्यश्र्च पुरुषोत्तमः ।\nस संकोचविकासाभ्यां प्रधानत्वेऽपिच स्थितः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000940031, "chapter_id": 20940, "verse_number": "१-२-३२", "content_sanskrit": "विकासाणुस्वरूपैश्च ब्रह्मरूपादिभिस्तथा ।\nव्यक्तस्वरूपश्च तथा विष्णुः सर्वेश्वरेश्वरः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000940032, "chapter_id": 20940, "verse_number": "१-२-३३", "content_sanskrit": "गुणसाम्यात्ततस्तस्मात्क्षेत्रज्ञाधिष्ठितान्मुने ।\nगुणव्यत्र्जनसम्भूतिः सर्गकाले द्विजोत्तम ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000940033, "chapter_id": 20940, "verse_number": "१-२-३४", "content_sanskrit": "प्रधानतत्त्वमुद्भतं महान्तं तत्समावृणोत् ।\nसात्विको राजसश्चैव तामसश्च त्रिधा महान् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000940034, "chapter_id": 20940, "verse_number": "१-२-३५", "content_sanskrit": "प्रधानतत्वेन समं त्वचा बीजमिवावृतम् ।\nवैकारिकस्तैजसश्च भूतादिश्चैव तामस्वः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000940035, "chapter_id": 20940, "verse_number": "१-२-३६", "content_sanskrit": "त्रिविधोऽयमहंकारो महत्तत्त्वादजायत ।\nभूतेन्द्रियाणां हेतुस्स त्रिगुणत्वान्महामुने ।\nयथा प्रधानेन महान्महता स तथावृतः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000940036, "chapter_id": 20940, "verse_number": "१-२-३७", "content_sanskrit": "भूतादिस्तु विकुर्वाणः शब्दतन्मात्रकं ततः ।\nससर्ज शब्दतन्मात्रादाकाशं शब्दलक्षणम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000940037, "chapter_id": 20940, "verse_number": "१-२-३८", "content_sanskrit": "शब्दमात्रं तथाकाशं भूतादिः स समावृणोत् ।\nआकाशस्तु विकुर्वाणः स्पर्शमात्रं ससर्ज ह ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000940038, "chapter_id": 20940, "verse_number": "१-२-३९", "content_sanskrit": "बलवानभवद्वायुस्तस्य स्पर्शो गुणो मतः ।\nआकाशं शब्दमात्रं तु स्पर्शमात्रं समावृणोत् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000940039, "chapter_id": 20940, "verse_number": "१-२-४०", "content_sanskrit": "ततो वायुर्विकुर्णाणो रूपमात्रं ससर्ज ह ।\nज्योतिरुत्पद्यते वायोस्तद्रूपगुणमुच्यते ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000940040, "chapter_id": 20940, "verse_number": "१-२-४१", "content_sanskrit": "स्पर्शमात्रं तु वै वायू रूपमात्रं समावृणोत् ।\nज्योतिश्चापि विकृर्वाणं रसमात्रं ससर्ज ह ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000940041, "chapter_id": 20940, "verse_number": "१-२-४२", "content_sanskrit": "सम्भवन्ति ततोऽम्भांसि रसाधाराणि तानि च र  ।\nरसमात्राणि चाम्भांसि रूपमात्रं समावृणोत् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000940042, "chapter_id": 20940, "verse_number": "१-२-४३", "content_sanskrit": "विकुर्वाणानि चाम्भांसि गन्धमात्रं ससर्जिरे ।\nसंघातो जायते तस्मात्तस्य गन्धो गुणो मतः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000940043, "chapter_id": 20940, "verse_number": "१-२-४४", "content_sanskrit": "तस्मिंस्तस्मिंस्तु तन्मात्रं तेन तन्मात्रता स्मृता ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000940044, "chapter_id": 20940, "verse_number": "१-२-४५", "content_sanskrit": "तन्मात्राण्यविशेषाणि अविशेषास्ततो हि ते ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000940045, "chapter_id": 20940, "verse_number": "१-२-४६", "content_sanskrit": "न शान्ता नापि घोरास्ते न मूढाश्चाविशेषिणः ।\nभूततन्मात्रसर्गोऽयमहकांरात्तु तामसात् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000940046, "chapter_id": 20940, "verse_number": "१-२-४७", "content_sanskrit": "तैजसानीन्द्रीयाण्याहूर्देवा वैकारिका दश ।\nएकादशं मनश्चात्र देवा वैकारिकाः स्मृताः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000940047, "chapter_id": 20940, "verse_number": "१-२-४८", "content_sanskrit": "त्वक् चक्षुर्नासिका जिह्वा श्रोत्रमत्र च पत्र्चमम् ।\nशब्दादीनामवाप्त्यर्थं बुद्धीयुक्तानि वै द्विज ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000940048, "chapter_id": 20940, "verse_number": "१-२-४९", "content_sanskrit": "पायूपस्थौ करौ पादौ वाक् च मैत्रेय पत्र्चमी ।\nविसर्गशिल्पगत्युक्ति कर्म तेषां च कथ्यते ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000940049, "chapter_id": 20940, "verse_number": "१-२-५०", "content_sanskrit": "आकाशवायुतेजांसि सलिलं पृथिवी तथा ।\nशब्दादिभिर्गुणैर्ब्रह्मन्संयुक्तान्युत्तरोत्तरैः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000940050, "chapter_id": 20940, "verse_number": "१-२-५१", "content_sanskrit": "शान्ता घोराश्च मूढाश्च विशेषास्तेन ते स्मृताः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000940051, "chapter_id": 20940, "verse_number": "१-२-५२", "content_sanskrit": "नानावीर्याः पृथग्भूतास्ततस्ते संहतिं विना ।\nनाशक्रुवन्प्रजाः स्त्रष्टुमसमागम्य कृत्स्त्रशः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000940052, "chapter_id": 20940, "verse_number": "१-२-५३", "content_sanskrit": "समेत्यान्योन्यसंयोगं परस्परसमाश्रयाः ।\nएकसंघातलक्ष्याश्च सम्प्राप्यैक्यमशेषतः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000940053, "chapter_id": 20940, "verse_number": "१-२-५४", "content_sanskrit": "पुरुषाधिष्ठितताच्च प्रधानानुग्रहेण च महदाद्या विशेषान्ता ह्माण्डमुत्पादयन्ति ते ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000940054, "chapter_id": 20940, "verse_number": "१-२-५५", "content_sanskrit": "तत्क्रमेण विवृद्धं सज्जलबुदबुदवत्समम् ।\nभूतेभ्योऽण्डं महाबुद्धें महत्तदुदकेशयम् ।\nप्राकृतं ब्रह्मरूपयस्य विष्णोः स्थानमनुत्तमम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000940055, "chapter_id": 20940, "verse_number": "१-२-५६", "content_sanskrit": "तत्राव्यक्तस्वरूपोऽसौ व्यक्तरूपो जगत्पतिः ।\nविष्णुर्ब्रह्मस्वरूपेण स्वयमेव व्यवस्थितः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000940056, "chapter_id": 20940, "verse_number": "१-२-५७", "content_sanskrit": "मेरुरुल्बमभूत्तस्य जरायुश्च महीधराः ।\nगर्भोदकं समुद्राश्च तस्यासन्सुमहात्मनः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000940057, "chapter_id": 20940, "verse_number": "१-२-५८", "content_sanskrit": "साद्रिद्वीपसमुद्राश्च सज्योतिर्लोकसंग्रहः ।\nतस्मिन्नण्डेऽभवद्विप्र सदेवासुरमानुषः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000940058, "chapter_id": 20940, "verse_number": "१-२-५९", "content_sanskrit": "वारिवह्‌न्यनिलाकाशैस्ततो भूतादिना बहिः ।\nवृतं दशगुणैरण्डं भूतादिर्महता तथा ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000940059, "chapter_id": 20940, "verse_number": "१-२-६०", "content_sanskrit": "अव्यक्तेनावृतो ब्रह्मांस्तैः सर्वोः सहितो महान् ।\nएभिरावरणैरण्डं सप्तभिः प्राकृतैर्वृतम् ।\nनारिकेलफलस्यान्तर्बीजं बाह्मदलैरिव ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000940060, "chapter_id": 20940, "verse_number": "१-२-६१", "content_sanskrit": "जुषन रजो गुणं तत्र स्वयं विश्वेश्वरो हरिः ।\nब्रह्मा भूत्वास्य जगतो विसृष्टौ सम्प्रवर्त्तते ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000940061, "chapter_id": 20940, "verse_number": "१-२-६२", "content_sanskrit": "सृष्टं च पात्यनुयुगं यावत्कल्पविकल्पना ।\nसत्त्वभृद्भगवान्विष्णुरप्रमेयपराक्रमः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000940062, "chapter_id": 20940, "verse_number": "१-२-६३", "content_sanskrit": "तमोद्रेकी चा कल्पान्ते रुद्ररूपी जनार्दनः ।\nमैत्रेयाखिलभूतानि भक्षयत्यतिदारुणः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000940063, "chapter_id": 20940, "verse_number": "१-२-६४", "content_sanskrit": "भक्षयित्वा च भूतानि जगत्येकार्णवीकृते ।\nनागपर्यंकशयने शेते च परमेश्वरः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000940064, "chapter_id": 20940, "verse_number": "१-२-६५", "content_sanskrit": "प्रबुद्धश्च पुनः सृष्टिं करोति ब्रह्मरूपधृक् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000940065, "chapter_id": 20940, "verse_number": "१-२-६६", "content_sanskrit": "सृष्टिस्थित्यन्तकरणीं ब्रह्मविष्णुशिवात्मिकाम् ।\nस संज्ञां याति भगवानेक एव जनार्दनः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000940066, "chapter_id": 20940, "verse_number": "१-२-६७", "content_sanskrit": "स्त्रष्टा सृजाति चात्मानं विष्णुः पाल्यंच पाति च ।\nउपसंह्रियते चान्ते संहर्ता च स्वयं प्रभुः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000940067, "chapter_id": 20940, "verse_number": "१-२-६८", "content_sanskrit": "पृथिव्यापस्तथा तेजो वायुराकाश एव च ।\nसर्वोन्द्रियान्तः करणं पुरुषाख्यं हि यज्जगत् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000940068, "chapter_id": 20940, "verse_number": "१-२-६९", "content_sanskrit": "स एव सर्वभूतात्मा विश्वरूपो यतोऽव्ययः ।\nसर्गादिकं तु तस्यैव भूतस्थमुपकारकम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000940069, "chapter_id": 20940, "verse_number": "१-२-७०", "content_sanskrit": "स एव सृज्यः स च सर्गकर्ता स एव पात्यत्ति च पाल्यते च ।\nब्रह्माद्यवस्थाभिरशेषमूर्ति र्विष्णुर्वरिष्ठो वरदो वरेण्यः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}]