[{"id": 2011170, "chapter_id": 1227, "verse_number": "१-२२८-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2011171, "chapter_id": 1227, "verse_number": "१-२२८-१", "content_sanskrit": "एवं संप्राप्य राज्यं तदिन्द्रप्रस्थे तपोधन।\nअत ऊर्ध्वं नरव्याघ्राः किमकुर्वत पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2011172, "chapter_id": 1227, "verse_number": "१-२२८-२", "content_sanskrit": "सर्व एव महात्मानः सर्वे मम पितामहाः।\nद्रौपदी धर्मपत्नी च कथं तानन्ववर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2011173, "chapter_id": 1227, "verse_number": "१-२२८-३", "content_sanskrit": "कथमासुश्च कृष्णायामेकस्यां ते नरर्षभाः।\nवर्तमाना महाभागा नाभिद्यन्त परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2011174, "chapter_id": 1227, "verse_number": "१-२२८-४", "content_sanskrit": "श्रोतुमिच्छाम्यहं तत्र विस्तरेण यथातथम्।\nतेषां चेष्टितमन्योन्यं युक्तानां कृष्णया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2011175, "chapter_id": 1227, "verse_number": "१-२२८-५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2011176, "chapter_id": 1227, "verse_number": "१-२२८-५", "content_sanskrit": "धृतराष्ट्राभ्यनुज्ञाता इन्द्रप्रस्थं प्रविश्य तत्।\nरेमिरे पुरुषव्याघ्राः कृष्णया सह पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2011177, "chapter_id": 1227, "verse_number": "१-२२८-६", "content_sanskrit": "प्राप्य राज्यं महातेजाः सत्यसन्धो युधिष्ठिरः।\nपालयामास धर्मेण पृथिवीं भ्रातृभिः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2011178, "chapter_id": 1227, "verse_number": "१-२२८-७", "content_sanskrit": "जितारयो महात्मानः सत्यधर्मपरायणाः।\nएवं पुरमिदं प्राप्य तत्रोषुः पाण्डुनन्दनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2011179, "chapter_id": 1227, "verse_number": "१-२२८-८", "content_sanskrit": "कुर्वाणाः पौरकार्याणि सर्वाणि भरतर्षभाः।\nआसांचक्रुर्महार्हेषु पार्थिवेष्वासनेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2011180, "chapter_id": 1227, "verse_number": "१-२२८-९", "content_sanskrit": "तेषु तत्रोपविष्टेषु पाण्डवेषु महात्मसु।\nआययौ धर्मराजं तु द्रष्टुकामोऽथ नारदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2011181, "chapter_id": 1227, "verse_number": "१-२२८-१०", "content_sanskrit": "पथा नक्षत्रजुष्टेन सुपर्णाचरितेन च।\nचन्द्रसूर्यप्रकाशेन सेवितेन महर्षिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2011182, "chapter_id": 1227, "verse_number": "१-२२८-११", "content_sanskrit": "नभस्स्थलेन दिव्येन दुर्लभेनातपस्विनाम्।\nभूतार्चितो भूतधरां राष्ट्रमन्दिरभूषिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2011183, "chapter_id": 1227, "verse_number": "१-२२८-१२", "content_sanskrit": "अवेक्षमाणो द्युतिमानाजगाम महातपाः।\nसर्ववेदान्तगो विप्रः सर्ववेदाङ्गपारगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2011184, "chapter_id": 1227, "verse_number": "१-२२८-१३", "content_sanskrit": "परेण तपसा युक्तो ब्राह्मेण तपसा वृतः।\nनये नीतौ च निस्तो विश्रुतश्च महामुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2011185, "chapter_id": 1227, "verse_number": "१-२२८-१४", "content_sanskrit": "परात्परतरं प्राप्तो धर्मान्समभिजग्मिवान्।\nभावितात्मा गतरजाः शान्तो मृदुर्ऋजुर्दिवजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2011186, "chapter_id": 1227, "verse_number": "१-२२८-१५", "content_sanskrit": "धर्मेणाधिगतः सर्वैर्देवदानवमानुषैः।\nक्षीणकर्मसु पापेषु भूतेषु विविधेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2011187, "chapter_id": 1227, "verse_number": "१-२२८-१६", "content_sanskrit": "सर्वथा कृतमर्यादो वेदेषु विविधेषु च।\nशतशः सोमपा यज्ञे पुण्ये पुण्यकृदग्निचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2011188, "chapter_id": 1227, "verse_number": "१-२२८-१७", "content_sanskrit": "ऋक्सामयजुषां वेत्ता न्यायदृग्धर्मकोविदः।\nऋजुरारोहबान्वृद्धो भूयिष्ठपथिकोऽनघः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2011189, "chapter_id": 1227, "verse_number": "१-२२८-१८", "content_sanskrit": "श्लक्ष्णया शिखयोपेतः संपन्नः परमत्विषा।\nअवदाते च सूक्ष्मे च दिव्ये च रचिते शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2011190, "chapter_id": 1227, "verse_number": "१-२२८-१९", "content_sanskrit": "महेन्द्रदत्ते महती बिभ्रत्परमवाससी।\nजाम्बूनदमये दिव्ये गण्डूपदमुखे नवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2011191, "chapter_id": 1227, "verse_number": "१-२२८-२०", "content_sanskrit": "अग्न्यर्कसदृशे दिव्ये धारयन्कुण्डले शुभे।\nराजतच्छत्रमुच्छ्रित्य चित्रं परमवर्चसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2011192, "chapter_id": 1227, "verse_number": "१-२२८-२१", "content_sanskrit": "प्राप्य दुष्प्रापमन्येन ब्रह्मवर्चसमुत्तमम्।\nभवने भूमिपालस्य बृहस्पतिरिवाप्लुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2011193, "chapter_id": 1227, "verse_number": "१-२२८-२२", "content_sanskrit": "संहितायां च सर्वेषां स्थितस्योपस्थितस्य च।\nद्विपदस्य च धर्मस्य क्रमधर्मस्य पारगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2011194, "chapter_id": 1227, "verse_number": "१-२२८-२३", "content_sanskrit": "गाधा सामानुसामज्ञः साम्नां परमवल्गुनाम्।\nआत्मनः सर्वमोक्षिभ्यः कृतिमान्कृत्यवित्सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2011195, "chapter_id": 1227, "verse_number": "१-२२८-२४", "content_sanskrit": "यजुर्धर्मैर्बहुविधैर्मतो मतिमतां वरः।\nविदितार्थः समश्चैव च्छेत्ता निगमसंशयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2011196, "chapter_id": 1227, "verse_number": "१-२२८-२५", "content_sanskrit": "अर्थनिर्वचने नित्यं संशयच्छिदसंशयः।\nप्रकृत्या धर्मकुशलो दाता धर्मविशारदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2011197, "chapter_id": 1227, "verse_number": "१-२२८-२६", "content_sanskrit": "लोपेनागमधर्मेण संक्रमेण च वृत्तिषु।\nएकशब्दांश्च नानार्थानेकार्थांश्च पृथक्कृतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2011198, "chapter_id": 1227, "verse_number": "१-२२८-२७", "content_sanskrit": "पृथगर्थाभिधानांश्च प्रयोगानन्ववेक्षिता।\nप्रमाणभूतो लोकेषु सर्वाधिकरणेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2011199, "chapter_id": 1227, "verse_number": "१-२२८-२८", "content_sanskrit": "सर्ववर्णविकारेषु नित्यं कुशलपूजितः।\nस्वरेऽस्वरे च विविधे वृत्तेषु विविधेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2011200, "chapter_id": 1227, "verse_number": "१-२२८-२९", "content_sanskrit": "समस्थानेषु सर्वेषु समाम्नायेषु धातुषु।\nउद्देश्यानां समाख्याता सर्वमाख्यातमुद्दिशन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2011201, "chapter_id": 1227, "verse_number": "१-२२८-३०", "content_sanskrit": "अभिसन्धिषु तत्त्वज्ञः पदान्यङ्गान्यनुस्मरन्।\nकालधर्मेण निर्दिष्टं यथार्थं च विचारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2011202, "chapter_id": 1227, "verse_number": "१-२२८-३१", "content_sanskrit": "चिकीर्षितं च यो वेत्ता यथा लोकेन संवृतम्।\nविभाषितं च समयं भाषितं हृदयंगमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2011203, "chapter_id": 1227, "verse_number": "१-२२८-३२", "content_sanskrit": "आत्मने च परस्मै च स्वरसंस्कारयोगवित्।\nएषां स्वराणां ज्ञाता च बोद्धा प्रवचनः स्वराट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2011204, "chapter_id": 1227, "verse_number": "१-२२८-३३", "content_sanskrit": "विज्ञाता चोक्तवाक्यानामेकतां बहुतां तथा।\nबोद्धा हि परमार्थांश्च विविधांश्च व्यतिक्रमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2011205, "chapter_id": 1227, "verse_number": "१-२२८-३४", "content_sanskrit": "अभेदतश्च बहुशो बहुशश्चापि भेदतः।\nवक्ता विविधवाक्यानां नानादेशसमीक्षिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2011206, "chapter_id": 1227, "verse_number": "१-२२८-३५", "content_sanskrit": "पञ्चागमांश्च विविधानादेशांश्च समीक्षिता।\nनानार्थकुशलस्तत्र तद्धितेषु च कृत्स्नशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2011207, "chapter_id": 1227, "verse_number": "१-२२८-३६", "content_sanskrit": "परिभूषयिता वाचां वर्णतः स्वरतोऽर्थतः।\nप्रत्ययं च समाख्याता नियतं प्रतिधातुकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2011208, "chapter_id": 1227, "verse_number": "१-२२८-३७", "content_sanskrit": "पञ्च चाक्षरजातानि स्वरसंज्ञानि यानि च।\nतमागतमृषिं दृष्ट्वा प्रत्युद्गम्याभिवाद्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2011209, "chapter_id": 1227, "verse_number": "१-२२८-३८", "content_sanskrit": "आसनं रुचिरं तस्मै प्रददौ स युधिष्ठिरः।\nकृष्णाजिनोत्तरे तस्मिन्नुपविष्टो महानृषिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2011210, "chapter_id": 1227, "verse_number": "१-२२८-३९", "content_sanskrit": "देवर्षेरुपविष्टस्य स्वयमर्ध्यं यथाविधि।\nप्रादाद्युधिष्ठिरो धीमान्राज्यं तस्मै न्यवेदयत्।\nप्रतिगृह्य तु तां पूजामृषिः प्रीतमनास्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2011211, "chapter_id": 1227, "verse_number": "१-२२८-४०", "content_sanskrit": "आशीर्भिर्वर्धयित्वा च तमुवाचास्यतामिति।\nनिषसादाभ्यनुज्ञातस्ततो राजा युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2011212, "chapter_id": 1227, "verse_number": "१-२२८-४१", "content_sanskrit": "प्रेषयामास कृष्णायै भगवन्तमुपस्थितम्।\nश्रुत्वैतद्द्रौपदी चापि शुचिर्भूत्वा समाहिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2011213, "chapter_id": 1227, "verse_number": "१-२२८-४२", "content_sanskrit": "जगाम तत्र यत्रास्ते नारदः पाण्डवैः सह।\nतस्याभिवाद्य चरणौ देवर्षेर्धर्मचारिणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2011214, "chapter_id": 1227, "verse_number": "१-२२८-४३", "content_sanskrit": "कृताञ्जलिः सुसंवीता स्थिताऽथ द्रुपदात्मजा।\nतस्याश्चापि स धर्मात्मा सत्यवागृषिसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2011215, "chapter_id": 1227, "verse_number": "१-२२८-४४", "content_sanskrit": "आशिषो विविधाः प्रोच्य राजपुत्र्यास्तु नारदः।\nगम्यतामिति होवाच भगवांस्तामनिन्दिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2011216, "chapter_id": 1227, "verse_number": "१-२२८-४५", "content_sanskrit": "गतायामथ कृष्णायां युधिष्ठिरपुरोगमान्।\nविविक्ते पाण्डवान्सर्वानुवाच भगवानृषिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2011217, "chapter_id": 1227, "verse_number": "१-२२८-४६", "content_sanskrit": "पाञ्चाली भवतामेका धर्मपत्नी यशस्विनी।\nयथा वो नात्र भेदः स्यात्तथा नीतिर्विधीयतां॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2011218, "chapter_id": 1227, "verse_number": "१-२२८-४७", "content_sanskrit": "सुन्दोपसुन्दौ हि पुरा भ्रातरौ सहितावुभौ।\nआस्तामवध्यावन्येषां त्रिषु लोकेषु विश्रुतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2011219, "chapter_id": 1227, "verse_number": "१-२२८-४८", "content_sanskrit": "एकराज्यावेकगृहावेकशय्यासनाशनौ।\nतिलोत्तमायास्तौ हेतोरन्योन्यमभिजघ्नतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2011220, "chapter_id": 1227, "verse_number": "१-२२८-४९", "content_sanskrit": "रक्ष्यतां सौहृदं तस्मादन्योन्यप्रीतिभावकम्।\nयथा वो नात्र भेदः स्यात्तत्कुरुष्व युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2011221, "chapter_id": 1227, "verse_number": "१-२२८-५०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2011222, "chapter_id": 1227, "verse_number": "१-२२८-५०", "content_sanskrit": "सुन्दोपसुन्दावसुरौ कस्य पुत्रौ महामुने।\nउत्पन्नश्च कथं भेदः कथं चान्योन्यमघ्नताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2011223, "chapter_id": 1227, "verse_number": "१-२२८-५१", "content_sanskrit": "अप्सरा देवकन्या वै कस्य चैषा तिलोत्तमा।\nयस्याः कामेन संमत्तौ जघ्नतुस्तौ परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2011224, "chapter_id": 1227, "verse_number": "१-२२८-५२", "content_sanskrit": "एतत्सर्वं यथा वृत्तं विस्तरेण तपोधन।\nश्रोतुमिच्छामहे ब्रह्मन्परं कौतूहलं हि मे॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2011225, "chapter_id": 1227, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि विदुरागमनराज्यलाभपर्वणि अष्टाविंशत्यधिकद्विशततमोऽध्यायः॥ २२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]