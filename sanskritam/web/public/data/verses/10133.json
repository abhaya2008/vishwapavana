[{"id": 6000133000, "chapter_id": 10133, "verse_number": null, "content_sanskrit": "अथ चतुर्दशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000133001, "chapter_id": 10133, "verse_number": null, "content_sanskrit": "परीक्षिदुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.001.m4a", "display_order": 2}, {"id": 6000133002, "chapter_id": 10133, "verse_number": "६-१४-१", "content_sanskrit": "रजस्तमस्स्वभावस्य ब्रह्मन् वृत्रस्य पाप्मनः।\nनारायणे भगवति कथमासीद् दृढा रतिः॥ ६/१४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.002.m4a", "display_order": 3, "topics": [{"text": "आसुरजातेरपि वृत्रस्य तादृशभगवज्ज्ञानप्राप्तिकारणं किमिति परीक्षिता पृष्टेन शुकेन तत्कथनार्थं तस्य प्राग्जन्मनि चित्र-केतुत्वात्तच्चरित्रकथनम्", "range": "१–१३"}]}, {"id": 6000133003, "chapter_id": 10133, "verse_number": "६-१४-२", "content_sanskrit": "देवानां शुद्धसत्त्वानामृषीणां चामलात्मनाम्।\nभक्तिर्मुकुन्दचरणे न प्रायेणोपजायते॥ ६/१४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.003.m4a", "display_order": 4}, {"id": 6000133004, "chapter_id": 10133, "verse_number": "६-१४-३", "content_sanskrit": "रजोभिस्समसङ्ख्याताः पार्थिवैरिह जन्तवः।\nतेषां ये केचनेहन्ते श्रेयो वै मनुजादयः॥ ६/१४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.004.m4a", "display_order": 5}, {"id": 6000133005, "chapter_id": 10133, "verse_number": "६-१४-४", "content_sanskrit": "प्रायो मुमुक्षवस्तेषां केचनेह द्विजोत्तमाः।\nमुमुक्षूणां सहस्रेषु कश्चिन्मुच्येत सिध्यति॥ ६/१४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.005.m4a", "display_order": 6}, {"id": 6000133006, "chapter_id": 10133, "verse_number": "६-१४-५", "content_sanskrit": "मुक्तानामपि सिद्धानां नारायणपरायणः।\nसुदुर्लभः प्रशान्तात्मा कोटिष्वपि महामुने॥ ६/१४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.006.m4a", "display_order": 7}, {"id": 6000133007, "chapter_id": 10133, "verse_number": "६-१४-६", "content_sanskrit": "वृत्रस्तु स कथं पापः सर्वलोकोपतापनः।\nइत्थं दृढमतिः कृष्ण आसीत् सङ्ग्राम उल्बणे॥ ६/१४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.007.m4a", "display_order": 8}, {"id": 6000133008, "chapter_id": 10133, "verse_number": "६-१४-७", "content_sanskrit": "अत्र नः संशयो भूयान् श्रोतुं कौतूहलं प्रभो।\nयः पौरुषेण समरे सहस्राक्षमतोषयत्॥ ६/१४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.008.m4a", "display_order": 9}, {"id": 6000133009, "chapter_id": 10133, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.009.m4a", "display_order": 10}, {"id": 6000133010, "chapter_id": 10133, "verse_number": "६-१४-८", "content_sanskrit": "परीक्षितोऽथ सम्प्रश्नं भगवान् बादरायणिः।\nनिशम्य श्रद्धधानस्य प्रतिनन्द्य वचोऽब्रवीत्॥ ६/१४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.010.m4a", "display_order": 11}, {"id": 6000133011, "chapter_id": 10133, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.011.m4a", "display_order": 12}, {"id": 6000133012, "chapter_id": 10133, "verse_number": "६-१४-९", "content_sanskrit": "शृृणुष्वावहितो राजन्नितिहासं पुरातनम्।\nश्रुतं द्वैपायनमुखान्नारदाद्देवलादपि॥ ६/१४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.012.m4a", "display_order": 13}, {"id": 6000133013, "chapter_id": 10133, "verse_number": "६-१४-१०", "content_sanskrit": "आसीद् राजा सार्वभौमः शूरसेनेषु वै नृप।\nचित्रकेतुरिति ख्यातो यस्यासीत् कामधुङ् मही॥ ६/१४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.013.m4a", "display_order": 14}, {"id": 6000133014, "chapter_id": 10133, "verse_number": "६-१४-११", "content_sanskrit": "तस्य भार्यासहस्राणां सहस्राणि दशाभवन्।\nसान्तानिकश्चापि नृपो न लेभे तासु सन्ततिम्॥ ६/१४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.014.m4a", "display_order": 15}, {"id": 6000133015, "chapter_id": 10133, "verse_number": "६-१४-१२", "content_sanskrit": "रूपौदार्यवयोजन्मविद्यैश्वर्यश्रियादिभिः।\nसम्पन्नस्य गुणैस्सर्वैश्चिन्ता वन्ध्यापतेरभूत्॥ ६/१४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.015.m4a", "display_order": 16}, {"id": 6000133016, "chapter_id": 10133, "verse_number": "६-१४-१३", "content_sanskrit": "न तस्य सम्पदः सर्वा महिष्यो वामलोचनाः।\nसार्वभौमस्य भूश्चेयं नाभूवन् प्रीतिहेतवः॥ ६/१४/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.016.m4a", "display_order": 17}, {"id": 6000133017, "chapter_id": 10133, "verse_number": "६-१४-१४", "content_sanskrit": "तस्यैकदा तु भवनमङ्गिरा भगवान् ऋषिः।\nलोकाननुचरन्नेतानुपागच्छद्यदृच्छया॥ ६/१४/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.017.m4a", "display_order": 18, "topics": [{"text": "पुत्राभावेन दूयमानस्य चित्रकेतोः अङ्गिरोनामकऋषिणा त्वाष्ट्रेष्टिकरणेन पुत्रप्राप्तिः", "range": "१४–३२"}]}, {"id": 6000133018, "chapter_id": 10133, "verse_number": "६-१४-१५", "content_sanskrit": "तं पूजयित्वा विधिवत्प्रत्युत्थानार्हणादिभिः।\nकृतातिथ्यमुपासीदत् सुखासीनं समाहितः॥ ६/१४/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.018.m4a", "display_order": 19}, {"id": 6000133019, "chapter_id": 10133, "verse_number": "६-१४-१६", "content_sanskrit": "महर्षिस्तमुपासीनं प्रश्रयावनतं क्षितौ।\nप्रतिपूज्य महाराज समाभाष्येदमब्रवीत्॥ ६/१४/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.019.m4a", "display_order": 20}, {"id": 6000133020, "chapter_id": 10133, "verse_number": null, "content_sanskrit": "अङ्गिरा उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.020.m4a", "display_order": 21}, {"id": 6000133021, "chapter_id": 10133, "verse_number": "६-१४-१७", "content_sanskrit": "अपि तेऽनामयं स्वस्ति प्रकृतीनां तथाऽऽत्मनः।\nयथा प्रकृतिभिर्गुप्तः पुमान् राजा च सप्तभिः॥ ६/१४/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.021.m4a", "display_order": 22}, {"id": 6000133022, "chapter_id": 10133, "verse_number": "६-१४-१८", "content_sanskrit": "आत्मानं प्रकृतिष्वद्धा निधाय श्रेय आप्नुयात्।\nराज्ञस्तथा प्रकृतयो नरदेवाहितादयः॥ ६/१४/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.022.m4a", "display_order": 23}, {"id": 6000133023, "chapter_id": 10133, "verse_number": "६-१४-१९", "content_sanskrit": "अपि दाराः सुतामात्या भृत्याः श्रेण्योऽथ मन्त्रिणः।\nपौरा जानपदा भूपा आत्मा च वशवर्तिनः॥ ६/१४/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.023.m4a", "display_order": 24}, {"id": 6000133024, "chapter_id": 10133, "verse_number": "६-१४-२०", "content_sanskrit": "यस्यात्माऽनुवशश्चेत् स्यात् सर्वे तद्वशगा इमे।\nलोकाः सपाला यच्छन्ति सर्वे बलिमतन्द्रिताः॥ ६/१४/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.024.m4a", "display_order": 25}, {"id": 6000133025, "chapter_id": 10133, "verse_number": "६-१४-२१", "content_sanskrit": "आत्मनः प्रीतयेऽप्यात्मा परतः स्वत एव वा।\nलक्षयेऽलब्धकामं त्वां चिन्तया शबलं मुखम्॥ ६/१४/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.025.m4a", "display_order": 26}, {"id": 6000133026, "chapter_id": 10133, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.026.m4a", "display_order": 27}, {"id": 6000133027, "chapter_id": 10133, "verse_number": "६-१४-२२", "content_sanskrit": "एवं विकल्पितो राजन् विदुषा मुनिनाऽपि सः।\nप्रश्रयावनतोऽभ्याह प्रजाकामस्ततो मुनिम्॥ ६/१४/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.027.m4a", "display_order": 28}, {"id": 6000133028, "chapter_id": 10133, "verse_number": null, "content_sanskrit": "चित्रकेतुरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.028.m4a", "display_order": 29}, {"id": 6000133029, "chapter_id": 10133, "verse_number": "६-१४-२३", "content_sanskrit": "भगवन् किं न विदितं तपोज्ञानसमाधिभिः।\nयोगिनां ध्वस्तपापानां बहिरन्तः शरीरिषु॥ ६/१४/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.029.m4a", "display_order": 30}, {"id": 6000133030, "chapter_id": 10133, "verse_number": "६-१४-२४", "content_sanskrit": "तथाऽपि पृच्छतो ब्रूयां ब्रह्मन्नात्मनि चिन्तितम्।\nभवतो विदुषश्चापि चोदितस्त्वदनुज्ञया॥ ६/१४/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.030.m4a", "display_order": 31}, {"id": 6000133031, "chapter_id": 10133, "verse_number": "६-१४-२५", "content_sanskrit": "लोकपालैरपि प्रार्थ्याः साम्राज्यैश्वर्यसम्पदः।\nन नन्दयन्त्यप्रजं मां क्षुत्तृट्क्षाममिवापरे॥ ६/१४/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.031.m4a", "display_order": 32}, {"id": 6000133032, "chapter_id": 10133, "verse_number": "६-१४-२६", "content_sanskrit": "तन्नः पाहि महाभाग पूर्वैः सह गतं तमः।\nयथा तरेम दुस्तारं प्रजया तद् विधेहि नः॥ ६/१४/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.032.m4a", "display_order": 33}, {"id": 6000133033, "chapter_id": 10133, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.033.m4a", "display_order": 34}, {"id": 6000133034, "chapter_id": 10133, "verse_number": "६-१४-२७", "content_sanskrit": "इत्यर्थितः स भगवान् कृपालुर्ब्रह्मणः सुतः।\nश्रपयित्वा चरुं त्वाष्ट्रं त्वष्टारमयजद् विभुः॥ ६/१४/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.034.m4a", "display_order": 35}, {"id": 6000133035, "chapter_id": 10133, "verse_number": "६-१४-२८", "content_sanskrit": "ज्येष्ठा श्रेष्ठा च या राज्ञो महिषीणाञ्च भारत।\nनाम्ना कृतद्युतिस्तस्यै यज्ञोच्छिष्टमदाद् विभुः॥ ६/१४/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.035.m4a", "display_order": 36}, {"id": 6000133036, "chapter_id": 10133, "verse_number": "६-१४-२९", "content_sanskrit": "अथाऽह नृपतिं राजन् भवितैकस्तवाऽत्मजः।\nहर्षशोकप्रदस्तुभ्यमिति ब्रह्मसुतो ययौ॥ ६/१४/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.036.m4a", "display_order": 37}, {"id": 6000133037, "chapter_id": 10133, "verse_number": "६-१४-३०", "content_sanskrit": "साऽपि तत्प्राशनादेव चित्रकेतोरधारयत्।\nगर्भं कृतद्युतिर्देवी कृत्तिकाऽग्नेरिवात्मजम्॥ ६/१४/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.037.m4a", "display_order": 38}, {"id": 6000133038, "chapter_id": 10133, "verse_number": "६-१४-३१", "content_sanskrit": "तस्या अनुदिनं गर्भः शुक्लपक्ष इवोडुपः।\nववृधे शूरसेनस्य तेजसा शनकैर्नृप॥ ६/१४/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.038.m4a", "display_order": 39}, {"id": 6000133039, "chapter_id": 10133, "verse_number": "६-१४-३२", "content_sanskrit": "अथ काल उपावृत्ते कुमारः समजायत।\nजनयन् शूरसेनानां शृृण्वतां परमां मुदम्॥ ६/१४/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.039.m4a", "display_order": 40}, {"id": 6000133040, "chapter_id": 10133, "verse_number": "६-१४-३३", "content_sanskrit": "स राजा सुकुमारस्य स्नातः शुचिरलङ्कृतः।\nवाचयित्वाऽऽशिषो विप्रैः कारयामास जातकम्॥ ६/१४/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.040.m4a", "display_order": 41, "topics": [{"text": "सापत्नमातृदत्तविषभक्षणेन तस्य शिशोर्मरणम्", "range": "३३–४३"}]}, {"id": 6000133041, "chapter_id": 10133, "verse_number": "६-१४-३४", "content_sanskrit": "तेभ्यो हिरण्यं रजतं वासांस्याभरणानि च।\nग्रामान् हयान् गजान् प्रादाद् धेनूनामर्बुदानि षट्॥ ६/१४/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.041.m4a", "display_order": 42}, {"id": 6000133042, "chapter_id": 10133, "verse_number": "६-१४-३५", "content_sanskrit": "ववर्ष कामानन्येषां पर्जन्य इव देहिनाम्।\nधन्यं यशस्यमायुष्यं कुमारस्य महात्मनः॥ ६/१४/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.042.m4a", "display_order": 43}, {"id": 6000133043, "chapter_id": 10133, "verse_number": "६-१४-३६", "content_sanskrit": "कृच्छ्रलब्धेऽस्य राजर्षेस्तनयेऽनुदिनं पितुः।\nयथा निःस्वस्य कृच्छ्राप्ते धने स्नेहोऽन्ववर्धत॥ ६/१४/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.043.m4a", "display_order": 44}, {"id": 6000133044, "chapter_id": 10133, "verse_number": "६-१४-३७", "content_sanskrit": "मातुस्त्वतितरां पुत्रे स्नेहो मोहसमुद्भवः।\nकृतद्युतेः सपत्नीनां प्रजाकामज्वरोऽभवत्॥ ६/१४/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.044.m4a", "display_order": 45}, {"id": 6000133045, "chapter_id": 10133, "verse_number": "६-१४-३८", "content_sanskrit": "चित्रकेतोरतिप्रीतिः यथादारे प्रजावति।\nन तथाऽन्येषु सञ्जज्ञे बालं लालयतोऽन्वहम्॥ ६/१४/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.045.m4a", "display_order": 46}, {"id": 6000133046, "chapter_id": 10133, "verse_number": "६-१४-३९", "content_sanskrit": "ताः पर्यतप्यन्नात्मानं गर्हयन्त्योऽभ्यसूयया।\nअनपत्येन दुःखेन राज्ञश्चानादरेण च॥ ६/१४/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.046.m4a", "display_order": 47}, {"id": 6000133047, "chapter_id": 10133, "verse_number": "६-१४-४०", "content_sanskrit": "धिगप्रजां स्‍त्रियं पापां पत्युश्चागृहसम्मताम्।\nसप्रजाभिः सपत्नीभिर्दासीमिव तिरस्कृताम्॥ ६/१४/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.047.m4a", "display_order": 48}, {"id": 6000133048, "chapter_id": 10133, "verse_number": "६-१४-४१", "content_sanskrit": "दासीनां को नु सन्तापः स्वामिनः परिचर्यया।\nअभीक्ष्णं लब्धमानानां दास्या दासीव दुर्भगाः॥ ६/१४/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.048.m4a", "display_order": 49}, {"id": 6000133049, "chapter_id": 10133, "verse_number": "६-१४-४२", "content_sanskrit": "एवं सन्दह्यमानानां सपत्न्याः पुत्रसम्पदा।\nराज्ञोऽसम्मतवृत्तीनां विद्वेषो बलवानभूत्॥ ६/१४/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.049.m4a", "display_order": 50}, {"id": 6000133050, "chapter_id": 10133, "verse_number": "६-१४-४३", "content_sanskrit": "विद्वेषान्नष्टमतयः स्‍त्रियो दारुणचेतसः।\nगरं ददुः कुमाराय विद्वेषात् नृपतिं प्रति॥ ६/१४/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.050.m4a", "display_order": 51}, {"id": 6000133051, "chapter_id": 10133, "verse_number": "६-१४-४४", "content_sanskrit": "कृतद्युतिरजानन्ती सपत्नीनामघं महत्।\nसुप्त एवेति सञ्चिन्त्य निरीक्ष्य व्यचरद् गृहे॥ ६/१४/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.051.m4a", "display_order": 52, "topics": [{"text": "तेन चित्रकेतोः शोकाधिगमः", "range": "४४–६०"}]}, {"id": 6000133052, "chapter_id": 10133, "verse_number": "६-१४-४५", "content_sanskrit": "शयानं सुचिरं बालमुपधार्य मनीषिणी।\nपुत्रमानय मे भद्रे इति धात्रीमचोदयत्॥ ६/१४/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.052.m4a", "display_order": 53}, {"id": 6000133053, "chapter_id": 10133, "verse_number": "६-१४-४६", "content_sanskrit": "सा शयानमुपव्रज्य दृष्ट्वा चोत्तारलोचनम्।\nप्राणेन्द्रियात्मभिस्त्यक्तं हताऽस्मीत्यपतद् भुवि॥ ६/१४/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.053.m4a", "display_order": 54}, {"id": 6000133054, "chapter_id": 10133, "verse_number": "६-१४-४७", "content_sanskrit": "तस्यास्तदाकर्ण्य भृशातुरस्वरं घ्नन्त्याः कराभ्यामुर उच्चकैरपि।\nप्रविश्य राज्ञी त्वरयाऽऽत्मजान्तिकं ददर्श बालं सहसा मृतं सुतम्॥ ६/१४/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.054.m4a", "display_order": 55}, {"id": 6000133055, "chapter_id": 10133, "verse_number": "६-१४-४८", "content_sanskrit": "पपात भूमौ परिवृद्धया शुचा मुमोह विभ्रष्टशिरोरुहाम्बरा।\nततो नृपान्तःपुरवर्तिनो जना नराश्च नार्यश्च निशम्य रोदनम्।\nआगत्य तुल्यव्यसनाः सुदुःखितास्ताश्च व्यलीकं रुरुदुः कृतागसः॥ ६/१४/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.055.m4a", "display_order": 56}, {"id": 6000133056, "chapter_id": 10133, "verse_number": "६-१४-४९", "content_sanskrit": "श्रुत्वा मृतं पुत्रमलक्षितान्तकं विनष्टदृष्टिः प्रपतन् स्खलन् पथि।\nस्नेहानुबन्धैधितया शुचा भृशं विमूर्छितोऽनुप्रकृतिर्द्विजैर्वृतः॥ ६/१४/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.056.m4a", "display_order": 57}, {"id": 6000133057, "chapter_id": 10133, "verse_number": "६-१४-५०", "content_sanskrit": "पपात बालस्य स पादमूले मृतस्य विस्रस्तशिरोरुहाम्बरः।\nदीर्घं श्वसन् बाष्पकलोपरोधतो निरुद्धकण्ठो न शशाक भाषितुम्॥ ६/१४/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.057.m4a", "display_order": 58}, {"id": 6000133058, "chapter_id": 10133, "verse_number": "६-१४-५१", "content_sanskrit": "पतिं निरीक्ष्योरुशुचाऽर्पितं तदा मृतं च बालं सुतमेकसन्ततिम्।\nजनस्य राज्ञी प्रकृतेश्च हृद्रुजं सती दधाना विललाप चित्रधा॥ ६/१४/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.058.m4a", "display_order": 59}, {"id": 6000133059, "chapter_id": 10133, "verse_number": "६-१४-५२", "content_sanskrit": "स्तनद्वयं कुङ्कुमपङ्कमण्डितं निषिञ्चती साञ्जनबाष्पबिन्दुभिः।\nविकीर्य केशान् विगलत्स्रजः सुतं शुशोच चित्रं कुररीव दुष्करम्॥ ६/१४/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.059.m4a", "display_order": 60}, {"id": 6000133060, "chapter_id": 10133, "verse_number": "६-१४-५३", "content_sanskrit": "अहो विधातस्त्वमतीव बालिशो यस्त्वात्मसृष्ट्यप्रतिरूपमीहसे।\nपरे तु जीवत्यपरस्य या मृतिः विपर्ययश्चेत् त्वमसि ध्रुवं परः॥ ६/१४/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.060.m4a", "display_order": 61}, {"id": 6000133061, "chapter_id": 10133, "verse_number": "६-१४-५४", "content_sanskrit": "न हि क्रमश्चेदिह मृत्युजन्मनोः शरीरिणामस्तु तदात्मकर्मभिः।\nयः स्नेहपाशो निजसर्गवृद्धये स्वयं कृतस्ते तमिमं विवृश्चसि॥ ६/१४/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.061.m4a", "display_order": 62}, {"id": 6000133062, "chapter_id": 10133, "verse_number": "६-१४-५५", "content_sanskrit": "त्वं तात नार्हसि च मां कृपणामनाथां त्यक्तुं विचक्ष्व पितरं तव शोकतप्तम्।\nअञ्जस्तरेम भवताऽप्रजदुस्तरं यद् ध्वान्तं न याह्यकरुणेन यमेन दूरम्॥ ६/१४/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.062.m4a", "display_order": 63}, {"id": 6000133063, "chapter_id": 10133, "verse_number": "६-१४-५६", "content_sanskrit": "उत्तिष्ठ तात त इमे शिशवो वयस्यास्त्वामाह्वयन्ति नृपनन्दन संविहर्तुम्।\nसुप्तश्चिरं ह्यशनया च भवान् परीतो भुङ्‌क्ष्व स्तनं पिब शुचो हर नः स्वकानाम्॥ ६/१४/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.063.m4a", "display_order": 64}, {"id": 6000133064, "chapter_id": 10133, "verse_number": "६-१४-५७", "content_sanskrit": "नाहं तनूज ददृशे हतमङ्गला ते मुग्धस्मितं मुदितवीक्षणमाननाब्जम्।\nकिं वा गतोऽस्यपुनरन्वयमन्यलोकं नीतोऽघृणेन न शृृणोमि कला गिरस्ते॥ ६/१४/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.064.m4a", "display_order": 65}, {"id": 6000133065, "chapter_id": 10133, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.065.m4a", "display_order": 66}, {"id": 6000133066, "chapter_id": 10133, "verse_number": "६-१४-५८", "content_sanskrit": "विलपन्त्यां मृतं पुत्रमिति चित्रविलापनैः।\nचित्रकेतुर्भृशं तप्तो मुक्तकण्ठो रुरोद ह॥ ६/१४/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.066.m4a", "display_order": 67}, {"id": 6000133067, "chapter_id": 10133, "verse_number": "६-१४-५९", "content_sanskrit": "तयोर्विलपतोः सर्वे दम्पत्योस्तदनुव्रताः।\nरुरुदुः स्म नरा नार्यः सर्वमासीदचेतनम्॥ ६/१४/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.067.m4a", "display_order": 68}, {"id": 6000133068, "chapter_id": 10133, "verse_number": "६-१४-६०", "content_sanskrit": "एवं कश्मलमापन्नं नष्टसंज्ञमनायकम्।\nज्ञात्वाऽङ्गिरो नाम मुनिराजगाम सनारदः॥ ६/१४/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_014/BhP_06.014.068.m4a", "display_order": 69}, {"id": 6000133069, "chapter_id": 10133, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां षष्ठस्कन्धे चतुर्दशाध्यायः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}]