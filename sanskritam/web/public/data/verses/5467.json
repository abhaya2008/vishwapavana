[{"id": 2209127, "chapter_id": 5467, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2209128, "chapter_id": 5467, "verse_number": "१", "content_sanskrit": "कथयन्नेव तु तदा वासुदेवः प्रतापवान् ।\nमहाभारतयुद्धं तत् कथान्ते पितुरग्रतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2209129, "chapter_id": 5467, "verse_number": "२", "content_sanskrit": "अभिमन्योर्वधं वीरः सोऽत्यक्रामत भारत ।\nअप्रियं वसुदेवस्य मा भूदिति महामनाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2209130, "chapter_id": 5467, "verse_number": "३", "content_sanskrit": "मा दौहित्रवधं श्रुत्वा वसुदेवो महात्ययम् ।\nदुःखशोकाभिसन्तप्तो भवेदिति महाद्युतिः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2209131, "chapter_id": 5467, "verse_number": "४", "content_sanskrit": "सुभद्रा तु तमुत्क्रान्तमात्मजस्य वधं रणे ।\nआचक्ष्व कृष्ण सौभद्रवधमित्यपतद् भुवि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2209132, "chapter_id": 5467, "verse_number": "५", "content_sanskrit": "तामपश्यन्निपतितां वसुदेवः क्षितौ तदा ।\nतथैव च पपातोर्व्यां सोऽपि दुःखेन मूर्छितः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2209133, "chapter_id": 5467, "verse_number": "६", "content_sanskrit": "ततः स दौहित्रवधाद् दुःखशोकसमन्वितः ।\nवसुदेवो महाराज कृष्णं वाक्यमथाब्रवीत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2209134, "chapter_id": 5467, "verse_number": "", "content_sanskrit": "वसुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2209135, "chapter_id": 5467, "verse_number": "७", "content_sanskrit": "ननु त्वं पुण्डरीकाक्ष सत्यवाग् भुवि विश्रुतः ।\nयद् दौहित्रवधं मेऽद्य न ख्यापयसि शत्रुहन् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2209136, "chapter_id": 5467, "verse_number": "८", "content_sanskrit": "त्वद् भागिनेयनिधनं तत्त्वेनाचक्ष्व मे विभो ।\nसदृशाक्षस्तव कथं शत्रुभिर्निहतो रणे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2209137, "chapter_id": 5467, "verse_number": "९", "content_sanskrit": "दुष्करं बत वार्ष्णेय कालेऽप्राप्ते नृभिः सदा ।\nयत्र मे हृदयं दुःखात् शतधा न विदीर्यते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2209138, "chapter_id": 5467, "verse_number": "१०", "content_sanskrit": "किमब्रवीत् त्वां सङ्ग्रामे सुभद्रां मातरं प्रति ।\nमां चापि पुण्डरीकाक्ष चपलाक्षः प्रियो मम ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2209139, "chapter_id": 5467, "verse_number": "११", "content_sanskrit": "आहवं पृष्ठतः कृत्वा क्वचिन्न निहतः परैः ।\nकच्चिद् दुःखेन गोविन्द तेनाजौ विमुखः कृतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2209140, "chapter_id": 5467, "verse_number": "१२", "content_sanskrit": "स हि कृष्ण महातेजाः श्लाघमानो ममाग्रतः ।\nबालभावेन विजयमात्मनोऽकथयत् प्रभुः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2209141, "chapter_id": 5467, "verse_number": "१३", "content_sanskrit": "कच्चिन्न निकृतो बाणैर्दोणकर्णकृपादिभिः ।\nधरण्यां निहतः शेते तन्ममाचक्ष्व केशव ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2209142, "chapter_id": 5467, "verse_number": "१४", "content_sanskrit": "स हि भीष्मं तथा द्रोणं कर्णं च रथिनां वरम् ।\nस्पर्धते स्म रणे नित्यं दुहितुः पुत्रको मम ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2209143, "chapter_id": 5467, "verse_number": "१५", "content_sanskrit": "एवंविधं बहु तदा विलपन्तं सुदुःखितम् ।\nपितरं दुःखिततरो गोविन्दो वाक्यमब्रवीत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2209144, "chapter_id": 5467, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2209145, "chapter_id": 5467, "verse_number": "१६", "content_sanskrit": "न तेन विहितं वक्त्रं कृतं सङ्ग्राममूर्धनि ।\nन पृष्ठतः कृतश्चापि सङ्ग्रामस्तेन दुस्तरः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2209146, "chapter_id": 5467, "verse_number": "१७", "content_sanskrit": "निहत्य पृथिवीपालान् शतशोऽथ सहस्रशः ।\nवेदितो द्रोणकर्णाभ्यां दौःशासनिवशं गतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2209147, "chapter_id": 5467, "verse_number": "१८", "content_sanskrit": "एको ह्येकेन सततं युध्यमानो यदि प्रभो ।\nस हि शक्यो न सङ्ग्रामे निहन्तुमपि वज्रिणा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2209148, "chapter_id": 5467, "verse_number": "१९", "content_sanskrit": "समाहूते तु सङ्ग्रामे पार्थे संशप्तकैस्तदा ।\nपरिवार्य तु सङ्क्रुद्धैः स द्रोणादिभिराहवे ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2209149, "chapter_id": 5467, "verse_number": "२०", "content_sanskrit": "ततः शत्रुक्षयं कृत्वा सुमहान्तं रणे पितः ।\nदौहित्रस्तव वार्ष्णेय दौःशासनिवशं गतः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2209150, "chapter_id": 5467, "verse_number": "२१", "content_sanskrit": "व्यक्तं च स गतः स्वर्गं जहि शोकं महामते ।\nन हि व्यसनमासाद्य सीदेयुः सुनराः क्वचित् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2209151, "chapter_id": 5467, "verse_number": "२२", "content_sanskrit": "द्रोणकर्णप्रभृतयो येन प्रतिसमाहिताः ।\nरणे महेन्द्रप्रतिमः स कथं नाप्नुयाद् दिवम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2209152, "chapter_id": 5467, "verse_number": "२३", "content_sanskrit": "स शोकं जहि दुर्धर्ष मा च मन्युवशं गमः ।\nशस्त्रपूतां हि स गतिं गतः परमदुर्जयः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2209153, "chapter_id": 5467, "verse_number": "२४", "content_sanskrit": "तस्मिंस्तु निहते पुत्रे सुभद्रेयं स्वसा मम ।\nदुःखार्ता च पृथां प्राप्य कुररीव ननाद ह ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2209154, "chapter_id": 5467, "verse_number": "२५", "content_sanskrit": "द्रौपदीं च समासाद्य पर्यपृच्छत् सुदुःखिता ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2209155, "chapter_id": 5467, "verse_number": "", "content_sanskrit": "सुभद्रा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2209156, "chapter_id": 5467, "verse_number": "२६", "content_sanskrit": "आर्ये क्व दारकाः सर्वे द्रष्टुमिच्छामि तानहम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2209157, "chapter_id": 5467, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2209158, "chapter_id": 5467, "verse_number": "२७", "content_sanskrit": "अस्यास्तु वचनं श्रुत्वा सर्वास्ताः कुरुयोषितः ।\nभुजाभ्यां परिगृह्यैनां चुक्रुशुः परमार्तवत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2209159, "chapter_id": 5467, "verse_number": "२८", "content_sanskrit": "उत्तरां चाब्रवीद् भद्रां भद्रे भर्ता क्व ते गतः ।\nक्षिप्रमागमनं मह्यं तस्य त्वं वेदयस्व ह ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2209160, "chapter_id": 5467, "verse_number": "२९", "content_sanskrit": "ननु नामास्मि वैराटि श्रुत्वा मम गिरं सदा ।\nभवनान्निष्पतत्याशु कस्मान्नाभ्येति ते पतिः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2209161, "chapter_id": 5467, "verse_number": "३०", "content_sanskrit": "अभिमन्यो कुशलिनो मातुलास्ते महारथाः ।\nकुशलं चाब्रुवन् सर्वे त्वां युयुत्सुमिहागतम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2209162, "chapter_id": 5467, "verse_number": "३१", "content_sanskrit": "आचक्ष्व मेऽद्य सङ्ग्रामं यथापूर्वमरिन्दम ।\nकस्मादेवं विलपतीं नाद्य वै प्रतिभाषसे ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2209163, "chapter_id": 5467, "verse_number": "३२", "content_sanskrit": "एवमादि तु वार्ष्णेय्याः तदाऽस्याः परिदेवितम् ।\nश्रुत्वा पृथा सुदुःखार्ता शनैर्वाक्यमथाब्रवीत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2209164, "chapter_id": 5467, "verse_number": "", "content_sanskrit": "पृथा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2209165, "chapter_id": 5467, "verse_number": "३३", "content_sanskrit": "सुभद्रे वासुदेवेन तथा सात्यकिना रणे ।\nपित्रा च पालितो बालः स गतः कालधर्मणा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2209166, "chapter_id": 5467, "verse_number": "३४", "content_sanskrit": "ईदृशो मर्त्यभावोऽयं मा शुचो यदुनन्दिनि ।\nपुत्रो हि तव दुर्धर्षः सम्प्राप्तः परमां गतिम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2209167, "chapter_id": 5467, "verse_number": "३५", "content_sanskrit": "कुले महति जाताऽसि क्षत्रियाणां महात्मनाम् ।\nमा शुचश्चपलाक्षि त्वं पुण्डरीकनिभेक्षणम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2209168, "chapter_id": 5467, "verse_number": "३६", "content_sanskrit": "उत्तरां त्वमवेक्षस्व गर्भिणीं मा शुचः शुभे ।\nपुत्रमेषा हि तस्याशु जनयिष्यति भामिनी ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2209169, "chapter_id": 5467, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2209170, "chapter_id": 5467, "verse_number": "३७", "content_sanskrit": "एवं तु सान्त्वयित्वैनां कुन्ती यदुकुलोद्वहाम् ।\nविहाय शोकं दुर्धर्ष श्राद्धमस्याप्यकल्पयत् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2209171, "chapter_id": 5467, "verse_number": "३८", "content_sanskrit": "समनुज्ञाप्य धर्मज्ञं राजानं भीममेव च ।\nयमौ यमोपमौ चैव ददौ दानान्यनेकशः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2209172, "chapter_id": 5467, "verse_number": "३९", "content_sanskrit": "ततः प्रदाय बह्वीर्गा ब्राह्मणेभ्यो यदूद्वह ।\nसमहृष्यत वार्ष्णेयी वैराटीं चाब्रवीदिदम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2209173, "chapter_id": 5467, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2209174, "chapter_id": 5467, "verse_number": "४०", "content_sanskrit": "वैराटि नेह सन्तापस्त्वया कार्यो यशस्विनि ।\nभर्तारं प्रति सुश्रोणि गर्भस्थं रक्ष मे शिशुम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2209175, "chapter_id": 5467, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2209176, "chapter_id": 5467, "verse_number": "४१", "content_sanskrit": "एवमुक्त्वा ततः कुन्ती विरराम महाद्युते ।\nतामनुज्ञाप्य चेहेमां सुभद्रां पुनरानयम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2209177, "chapter_id": 5467, "verse_number": "४२", "content_sanskrit": "एवं स निधनं प्राप्तो दौहित्रस्तव मानद ।\nसन्तापं त्यज दुर्धर्ष मा च शोके मनः कृथाः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2209178, "chapter_id": 5467, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि वसुदेवशोकहरणं नाम एकषष्टितमोऽध्यायः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]