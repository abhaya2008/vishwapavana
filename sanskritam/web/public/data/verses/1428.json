[{"id": 2020494, "chapter_id": 1428, "verse_number": "३-६६-०x", "content_sanskrit": "सुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2020495, "chapter_id": 1428, "verse_number": "३-६६-१", "content_sanskrit": "विदर्भराजो धर्मात्मा भीमो भीमपराक्रमः।\nसुतेयं तस्य कल्याणी दमयन्तीति विश्रुता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2020496, "chapter_id": 1428, "verse_number": "३-६६-२", "content_sanskrit": "राजा तु नैषधो नाम वीरसेनसुतो नलः।\nभार्येयं तस्य कल्याणी पुण्यश्लोकस्य धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2020497, "chapter_id": 1428, "verse_number": "३-६६-३", "content_sanskrit": "स द्यूतेन जितो भ्रात्रा हृतराज्यो महामनाः।\nदमयन्त्या गतः सार्धं न प्राज्ञायत कस्यचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2020498, "chapter_id": 1428, "verse_number": "३-६६-४", "content_sanskrit": "ते वयं दमयन्त्यर्थे चरामः पृथिवीमिमाम्।\nसेयमासादिता बाला तव देवि निवेशने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2020499, "chapter_id": 1428, "verse_number": "३-६६-५", "content_sanskrit": "अस्या रूपेण सदृशी मानुषी न हि विद्यते।\nअस्या ह्येष भ्रुवोर्मध्ये सहजः पिप्लुरुत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2020500, "chapter_id": 1428, "verse_number": "३-६६-६", "content_sanskrit": "श्यामायाः पद्मसंकाशो लक्षितोऽन्तर्हितो मया।\nमलेन संवृतोह्यस्याश्छन्नोऽभ्रेणेव चन्द्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2020501, "chapter_id": 1428, "verse_number": "३-६६-७", "content_sanskrit": "चिह्नभूतो विभूत्यर्थमयं धात्रा विनिर्मितः।\nप्रतिपत्कलुषेवेन्दोर्लेखा नातिविराजते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2020502, "chapter_id": 1428, "verse_number": "३-६६-८", "content_sanskrit": "न चास्या नश्यते रूपं वपुर्मलसमाचितम्।\nअसंस्कृतमपि व्यक्तं भाति काञ्चनसन्निभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2020503, "chapter_id": 1428, "verse_number": "३-६६-९", "content_sanskrit": "अनेन वपुषा बाला पिप्लुनाऽनेन सूचिता।\nलक्षितेयं मया देवी पिहितोऽग्निरिवोष्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2020504, "chapter_id": 1428, "verse_number": "३-६६-१०x", "content_sanskrit": "बृहदश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2020505, "chapter_id": 1428, "verse_number": "३-६६-१०", "content_sanskrit": "तच्छ्रुत्वा वचनं तस्य सुदेवस्य विशांपते।\nसुनन्दा शोधयामास पिप्लुप्रच्छादनं मलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2020506, "chapter_id": 1428, "verse_number": "३-६६-११", "content_sanskrit": "स मलेनापकृष्टन पिप्लुस्तस्या व्यरोचत।\nदमयन्त्या यथा व्यभ्रे नभसीव निशाकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2020507, "chapter_id": 1428, "verse_number": "३-६६-१२", "content_sanskrit": "पिप्लुं दृष्ट्वा सुनन्दा च राजमाता च भारत।\nरुदन्त्यौ तां परिष्वज्यमुहूर्तमिव तस्थतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2020508, "chapter_id": 1428, "verse_number": "३-६६-१३", "content_sanskrit": "उत्सृज्य बाष्पं शनकै राजमातेदमब्रवीत्।\nभगिन्या दुहिता मेऽसि पिप्लुनानेन सूचिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2020509, "chapter_id": 1428, "verse_number": "३-६६-१४", "content_sanskrit": "अहं च तव माता च राजन्यस्य महात्मनः।\nसुते दशार्णाधिपतेः सुदाम्नश्चारुदर्शने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2020510, "chapter_id": 1428, "verse_number": "३-६६-१५", "content_sanskrit": "भीमस्य राज्ञः सा दत्ता वीरबाहोरहं पुनः।\nत्वं तु जाता मया दृष्टा दशार्णेषु पितुर्गृहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2020511, "chapter_id": 1428, "verse_number": "३-६६-१६", "content_sanskrit": "यथैव ते पितुर्गेहं तथेदमपि भामिति।\nयथैव च ममैश्वर्यं दमयन्ति तथा तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2020512, "chapter_id": 1428, "verse_number": "३-६६-१७", "content_sanskrit": "तां प्रहृष्टेन मनसा दमयन्ती विशांपते।\nप्रणम्य मातुर्भगिनीमिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2020513, "chapter_id": 1428, "verse_number": "३-६६-१८", "content_sanskrit": "अज्ञायमानाऽपिसती सुखमस्म्युषिता त्वयि।\nसर्वकामैः सुविहिता रक्ष्यमाणा सदा त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2020514, "chapter_id": 1428, "verse_number": "३-६६-१९", "content_sanskrit": "सुखात्सुखतरो वासो भविष्यति न संशयः।\nचिरविप्रोषितां मातर्मामनुज्ञातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2020515, "chapter_id": 1428, "verse_number": "३-६६-२०", "content_sanskrit": "दारकौ च हि मे नीतौ वसतस्तत्र बालकौ।\nपित्रा विहीनौ शोकार्तौ मया चैव कथं नु तौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2020516, "chapter_id": 1428, "verse_number": "३-६६-२१", "content_sanskrit": "यदि चापि प्रियं किंचिन्मयि कर्तुमिहेच्छसि।\nविदर्भान्यातुमिच्छामि शीघ्रं मे यानमादिश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2020517, "chapter_id": 1428, "verse_number": "३-६६-२२", "content_sanskrit": "बाढमित्येव तामुक्त्वा हृष्ट्वा मातृष्वसा नृप।\nगुप्तां बलेन महता पुत्रस्यानुमते ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2020518, "chapter_id": 1428, "verse_number": "३-६६-२३", "content_sanskrit": "प्रास्थापयद्राजमाता श्रीमतीं नरवाहिना।\nयानेन भरतश्रेष्ठ स्वन्नपानपरिच्छदाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2020519, "chapter_id": 1428, "verse_number": "३-६६-२४", "content_sanskrit": "ततः सा नचिरादेव विदर्भानगमच्छुभा।\nतां तु बन्धुजनः सर्वः प्रहृष्टः समपूजयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2020520, "chapter_id": 1428, "verse_number": "३-६६-२५", "content_sanskrit": "सर्वान्कुशलिनो दृष्ट्वा बान्धवान्दारकौ च तौ।\nमातरं पितरं चोभौ सर्वं चैव सखीजनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2020521, "chapter_id": 1428, "verse_number": "३-६६-२६", "content_sanskrit": "देवताः पूजयामास ब्राह्मणांश्च यशस्विनी।\nपरेण विधिना देवी दमयन्ती विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2020522, "chapter_id": 1428, "verse_number": "३-६६-२७", "content_sanskrit": "अतर्पयत्सुदेवं च गोसहस्रेण पार्थिवः।\nप्रीतो दृष्ट्वैव तनयां ग्रामेण द्रविणेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2020523, "chapter_id": 1428, "verse_number": "३-६६-२८", "content_sanskrit": "सा व्युष्टा रजनीं तत्रपितुर्वेश्मनि भामिनी।\nविश्रान्ता मातरं राजन्निदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2020524, "chapter_id": 1428, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि नलोपाख्यानपर्वणि षट्षष्टितमोऽध्यायः ॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]