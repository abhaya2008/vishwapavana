[{"id": 2159166, "chapter_id": 4450, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2159167, "chapter_id": 4450, "verse_number": "१", "content_sanskrit": "शिबिमौशीनरं चापि मृतं सृञ्जय शुश्रुम ।\nय इमां पृथिवीं सर्वां चर्मवत् पर्यवेष्टयत् ।\nसाद्रिद्वीपार्णववनां रथघोषेण नादयन्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2159168, "chapter_id": 4450, "verse_number": "२", "content_sanskrit": "स शिबिर्यश अन्विच्छन् मुख्यः सर्वसपत्नजित्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2159169, "chapter_id": 4450, "verse_number": "३", "content_sanskrit": "यज्ञैर्बहुविधैरिष्टं तेनापर्याप्तदक्षिणैः ।\nअविहिंस्य जनानन्यानवाप वसु पुष्कळम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2159170, "chapter_id": 4450, "verse_number": "४", "content_sanskrit": "सर्वमूर्धावसिक्तानां सम्मतः सोऽभवद् युधि ।\nअयजच्चाश्वमेधैर्यो विजित्य पृथिवीमिमाम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2159171, "chapter_id": 4450, "verse_number": "५", "content_sanskrit": "निरर्गलांसजारूथ्यान् निष्ककोटिं सहस्रशः ।\nबिभर्ति दक्षिणा यस्य गङ्गायाः स्रोत आवृणोत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2159172, "chapter_id": 4450, "verse_number": "६", "content_sanskrit": "हस्त्यश्वपशुभिर्धान्यैर्मृगैर्गोजाविभिस्तथा ।\nविविधैः पृथिवीं पूर्णां शिबिर्ब्राह्मणसात्करोत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2159173, "chapter_id": 4450, "verse_number": "८", "content_sanskrit": "यावन्त्यो वर्षतो धारा यावन्त्यो दिवि तारकाः ।\nतावतीरददाद् गा वै शिबिरौशीनरोऽध्वरे\t॥७॥\nयावत्यः सिकता गाङ्ग्यो यथा मेरौ महोपलाः ।\nउदन्वति च यावन्ति रत्नानि प्राणिनोऽपि च\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2159174, "chapter_id": 4450, "verse_number": "९", "content_sanskrit": "नोद्यन्तारं धुरं तस्य किञ्चिदन्यं प्रजापतिः ।\nभूतं भव्यं भविष्यं वा ह्यध्यगच्छन्नरेश्वरम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2159175, "chapter_id": 4450, "verse_number": "१०", "content_sanskrit": "तस्यासन् विविधा यज्ञाः सर्वकामैः समन्विताः ।\nहेमयूपासनगृहा हेमप्राकारतोरणाः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2159176, "chapter_id": 4450, "verse_number": "११", "content_sanskrit": "शुचिस्वाद्वन्नपानाश्च ब्राह्मणाः प्रयुतायुताः ।\nनानाभक्ष्योच्चयतटाः पयोदधिमधुह्रदाः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2159177, "chapter_id": 4450, "verse_number": "१२", "content_sanskrit": "तस्यासन् यज्ञवाटेषु नद्यः शुभ्रान्नपर्वताः ।\nपिबताश्नत खादध्वमिति यत्रोच्यते जनैः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2159178, "chapter_id": 4450, "verse_number": "१३", "content_sanskrit": "तस्मै प्रादाद् वरान् रुद्रः तुष्टः पुण्येन कर्मणा ।\nअक्षयं च ददौ वित्तं श्रद्धां कीर्तिं ततोऽव्ययाम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2159179, "chapter_id": 4450, "verse_number": "१४", "content_sanskrit": "यथार्थमेवं भूतानां प्रियत्वं स्वर्गमुत्तमम् ।\nएताँल्लब्ध्वा वरानिष्टान् शिबिः काले दिवं गतः ।\nस चेन्ममार सृञ्जय चतुर्भद्रतरस्त्वया\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2159180, "chapter_id": 4450, "verse_number": "१५", "content_sanskrit": "पुत्रात् पुण्यतरस्तुभ्यं मा पुत्रमनुतप्यथाः ।\nअयज्वानमदक्षिण्यमधिचैत्येत्युदाहरत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2159181, "chapter_id": 4450, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां द्रोणपर्वणि पञ्चपञ्चाशत्तमोऽध्यायः ॥ ५५ ॥\nअभिमन्युवधपर्वणि चतुर्विंशोऽध्यायः ॥ २४ ॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]