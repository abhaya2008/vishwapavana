[{"id": 7001894000, "chapter_id": 21894, "verse_number": "७३-१", "content_sanskrit": "मार्कण्डेय उवाच ।\nमन्वन्तरे तृतीयेऽस्मिन् औत्तमस्य प्रजापतेः ।\nदेवानिन्द्रमृषीन् भूपान् निबोध गदतो मम ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001894001, "chapter_id": 21894, "verse_number": "७३-२", "content_sanskrit": "स्वधामानस्तथा देवा यथानामानुकारिणः ।\nसत्याख्यश्च द्वितीयोऽन्यस्त्रिदशानां तथा गणः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001894002, "chapter_id": 21894, "verse_number": "७३-३", "content_sanskrit": "तृतीये तु गणे देवाः शिवाख्या मुनिसत्तम ।\nशिवाः स्वरूपतस्ते तु श्रुताः पापप्रणाशनाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001894003, "chapter_id": 21894, "verse_number": "७३-४", "content_sanskrit": "प्रतर्दनाख्यश्च गणो देवानां मुनिसत्तम ।\nचतुर्थस्तत्र कथित औत्तमस्यान्तरे मनोः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001894004, "chapter_id": 21894, "verse_number": "७३-५", "content_sanskrit": "वशवर्तिनः पञ्चमेऽपि देवास्तत्र गणे द्विज ।\nयथाख्यातस्वरूपास्तु सर्व एव महामुने ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001894005, "chapter_id": 21894, "verse_number": "७३-६", "content_sanskrit": "एते देवगणाः पञ्च स्मृता यज्ञभुजस्तथा ।\nमन्वन्तरे मनुश्रेष्ठे सर्वे द्वादशका गणाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001894006, "chapter_id": 21894, "verse_number": "७३-७", "content_sanskrit": "तेषामिन्द्रो महाभागस्त्रैलोक्ये स गुरुर्भवेत् ।\nशतं क्रतूनामाहृत्य सुशान्तिर्नाम नामतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001894007, "chapter_id": 21894, "verse_number": "७३-८", "content_sanskrit": "यस्योपसर्गनाशाय नामाक्षरविभूषिता ।\nअद्यापि मानवैर्गाथा गीयते तु महीतले ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001894008, "chapter_id": 21894, "verse_number": "७३-९", "content_sanskrit": "शुशान्तिर्देवराट् कान्तः शुशान्तिं स प्रयच्छति ।\nसहितः शिवसत्याद्यैस्तथैव वशवर्तिभिः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001894009, "chapter_id": 21894, "verse_number": "७३-१०", "content_sanskrit": "अजः परशुचिर्दिव्यो महाबलपराक्रमः ।\nपुत्रस्तस्य मनोरासन् विख्यातास्त्रिदशोपमाः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001894010, "chapter_id": 21894, "verse_number": "७३-११", "content_sanskrit": "तत्सूतिसम्भवैर्भूमिः पालिताभून्नरेश्वरैः ।\nयावन्मन्वन्तर तस्य मनोरुत्तमतेजसः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001894011, "chapter_id": 21894, "verse_number": "७३-१२", "content_sanskrit": "चतुर्युगानां संख्याता साधिका ह्येकसप्ततिः ।\nकृतत्रेतादिसंज्ञानां यान्युक्तानि युगे मया ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001894012, "chapter_id": 21894, "verse_number": "७३-१३", "content_sanskrit": "स्वतेजसा हि तपसो वरिष्ठस्य महात्मनः ।\nतनयाश्चान्तरे तस्मिन् सप्त सप्तर्षयोऽभवन् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001894013, "chapter_id": 21894, "verse_number": "७३-१४", "content_sanskrit": "तृतीयमेतत्कथितं तव मन्वन्तरं मया ।\nतामसस्य चतुर्थन्तु मनोरन्तरमुच्यते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001894014, "chapter_id": 21894, "verse_number": "७३-१५", "content_sanskrit": "वियोनिजन्मनो यस्य यशसा द्योतितं जगत् ।\nजन्म तस्य मनोर्ब्रह्मन् ! श्रुयतां गदतो मम ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001894015, "chapter_id": 21894, "verse_number": "७३-१६", "content_sanskrit": "अतीन्द्रियमशेषाणां मनूनाञ्चरितन्तथा ।\nतथा जन्मापि विज्ञेयं प्रभावश्च महात्मनाम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]