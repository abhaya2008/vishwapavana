[{"id": 2099510, "chapter_id": 3128, "verse_number": "१३-२५८-१", "content_sanskrit": "वायुरुवाच।\nशृणु मूढ गुणान्कांश्चिद्ब्राह्मणानां महात्मनाम्।\nये त्वया कीर्तिता राजंस्तेभ्योऽथ ब्राह्मणो वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2099511, "chapter_id": 3128, "verse_number": "१३-२५८-२", "content_sanskrit": "त्यक्त्वा महीत्वं भूमिस्तु स्पर्धया काश्यपस्य ह।\nनाशं जगाम तां विप्रो व्यस्तम्ययत कश्यपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2099512, "chapter_id": 3128, "verse_number": "१३-२५८-३", "content_sanskrit": "अक्षया ब्राह्मणा राजन्दिवि चेह च नित्यदा।\nअपिबत्तेजसा ह्यापः स्वयमेवाङ्गिराः पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2099513, "chapter_id": 3128, "verse_number": "१३-२५८-४", "content_sanskrit": "स ताः पिबञ्शीरमिव नातृप्यत महातपाः।\nअपूरयन्महौघेन महीं सर्वां च पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2099514, "chapter_id": 3128, "verse_number": "१३-२५८-५", "content_sanskrit": "तस्मिन्नहं च क्रुद्धे वै जगत्त्यक्त्वा ततो भयात्।\nव्यतिष्ठमग्निहोत्रे च चिरमङ्गिरसो भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2099515, "chapter_id": 3128, "verse_number": "१३-२५८-६", "content_sanskrit": "अथ शप्तश्च भगवान्गौतमेन पुरंदरः।\nअहल्यां कामयानो वै धर्मार्थं च न हिंसितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2099516, "chapter_id": 3128, "verse_number": "१३-२५८-७", "content_sanskrit": "तथा समुद्रो नृपते पूर्णो दृष्टश्च वारिणा।\nब्राह्मणैरभिशप्तश्च बभूव लवणोदकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2099517, "chapter_id": 3128, "verse_number": "१३-२५८-८", "content_sanskrit": "सुवर्णवर्णो निर्धूमः सङ्गतोर्ध्वशिखः कविः।\nक्रुद्धेनाङ्गिरसा शप्तो गुणैरेतैर्विवर्जितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2099518, "chapter_id": 3128, "verse_number": "१३-२५८-९", "content_sanskrit": "महतश्चूर्णितान्पश्य ये हासन्त महोदधिम्।\nसुवर्णिधारिणा नित्यमवशप्ता द्विजातिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2099519, "chapter_id": 3128, "verse_number": "१३-२५८-१०", "content_sanskrit": "सम्मतत्वं द्विजातिभ्यः श्रेष्ठं विद्धि नराधिप।\nगर्भस्थान्ब्राह्मणाञ्शश्वन्नमस्यति किल प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2099520, "chapter_id": 3128, "verse_number": "१३-२५८-११", "content_sanskrit": "दण्डकानां महद्राज्यं ब्राह्मणेन विनाशितम्।\nतालजङ्घं महाक्षत्रमौर्वेणैकेन नाशितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2099521, "chapter_id": 3128, "verse_number": "१३-२५८-१२", "content_sanskrit": "त्वया च विपुलं राज्यं बलं धर्मं श्रुतं तथा।\nदत्तात्रेयप्रसादेन प्रप्तं परमदुर्लभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2099522, "chapter_id": 3128, "verse_number": "१३-२५८-१३", "content_sanskrit": "अग्निं त्वं यजसे नित्यं कस्माद्ब्राह्मणमर्जन।\nस हि सर्वस्य लोकस्य हव्यवाट् किं न वेत्सि तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2099523, "chapter_id": 3128, "verse_number": "१३-२५८-१४", "content_sanskrit": "अथवा ब्राह्मणश्रेष्ठमनुभूतानुपालकम्।\nकर्तारं जवलोकस्य कस्माज्जानन्विमुह्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2099524, "chapter_id": 3128, "verse_number": "१३-२५८-१५", "content_sanskrit": "तथा प्रजापतिर्ब्राह्मा अव्यक्तप्रभवोऽव्ययः।\nयेनेदं विपुलं विश्वं जनितं स्थावरं चरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2099525, "chapter_id": 3128, "verse_number": "१३-२५८-१६", "content_sanskrit": "अण्डजातं तु ब्रह्माणं केचिदिच्छिन्त्यपण्डिताः।\nअण्डाद्भिन्नाद्बभुः शैला दिशोंऽभः पृथिवी दिवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2099526, "chapter_id": 3128, "verse_number": "१३-२५८-१७", "content_sanskrit": "दृष्टवानेतदेवं हि कथं जायेदजो हि सः।\nस्थानमाकाशमण्डं तु यस्माज्जातः पितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2099527, "chapter_id": 3128, "verse_number": "१३-२५८-१८", "content_sanskrit": "तिष्ठेत्कथमिति ब्रूयान्न किञ्चिद्धि तदा भवेत्।\nअहङ्कार इति प्रोक्तः सर्वतेजोगतः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2099528, "chapter_id": 3128, "verse_number": "१३-२५८-१९", "content_sanskrit": "नास्त्यन्तमस्ति तु ब्रह्मा स राजा लोकभावनः।\nइत्युक्तः स तदा तूष्णीमभूद्वायुस्तमब्रवीत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2099529, "chapter_id": 3128, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि अष्टपञ्चाशदधिकद्विशततमोऽध्यायः॥ २५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]