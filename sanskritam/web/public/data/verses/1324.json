[{"id": 2015412, "chapter_id": 1324, "verse_number": "२-६५-१", "content_sanskrit": "शिशुपाल उवाच।\nस मे बहुमतो राजा जरासन्धो महाबलः।\nयोऽनेन युद्धं नेयेष दाक्षोऽयमिति संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2015413, "chapter_id": 1324, "verse_number": "२-६५-२", "content_sanskrit": "केशवेन कृतं कर्म जरासन्धवधे तदा।\nभीमसेनार्जुनाभ्यां च कस्तत्साध्विति मन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2015414, "chapter_id": 1324, "verse_number": "२-६५-३", "content_sanskrit": "उद्वारेण प्रविष्टेन छद्मना ब्रह्मवादिना।\nदृष्टः प्रभावः कृष्णेन जरासन्धस्य भूपतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2015415, "chapter_id": 1324, "verse_number": "२-६५-४", "content_sanskrit": "येन धर्मात्मनाऽऽत्मानं ब्रह्मण्यमभिजानता।\nप्रेषितं पाद्यमस्मै तद्दातुमग्रे दूरात्मने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2015416, "chapter_id": 1324, "verse_number": "२-६५-५", "content_sanskrit": "भुज्यतामिति तेनोक्ताः कृष्णबीमधनञ्जयाटः।\nजरासन्धेन कौरव्य कृष्णेन विकृतं कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2015417, "chapter_id": 1324, "verse_number": "२-६५-६", "content_sanskrit": "यद्ययं जगतः कर्ता यथैनं मूर्ख मन्यसे।\nकस्मान्न ब्राह्मणं सम्यगात्मानमवगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2015418, "chapter_id": 1324, "verse_number": "२-६५-७", "content_sanskrit": "इदं त्वाश्चर्यभूतं मे यदिभे पाण्डवास्त्वया।\nअपकृष्टाः सतां मार्गान्मन्यन्ते तच्च साध्विति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2015419, "chapter_id": 1324, "verse_number": "२-६५-८", "content_sanskrit": "अथवा नैतदाश्चर्यं येषां त्वमसि भारत।\nस्त्रीसधर्मा च वृद्धश्च सर्वार्थानां प्रदर्शकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2015420, "chapter_id": 1324, "verse_number": "२-६५-९x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2015421, "chapter_id": 1324, "verse_number": "२-६५-९", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा रूक्षं रूक्षाक्षरं बहु।\nचकोप बलिनां श्रेष्ठो भीमसेनः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2015422, "chapter_id": 1324, "verse_number": "२-६५-१०", "content_sanskrit": "तथा पद्मप्रतीकाशे स्वभावायतविस्तृते।\nभूयः क्रोधाभिताम्राक्षे रक्ते नेत्रे बभूवतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2015423, "chapter_id": 1324, "verse_number": "२-६५-११", "content_sanskrit": "त्रिशिखां भ्रकुटीं चास्य ददृशुः सर्वपार्थिवाः।\nललाटस्थां त्रिकूटस्थां गङ्गां त्रिपथगामिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2015424, "chapter_id": 1324, "verse_number": "२-६५-१२", "content_sanskrit": "दन्तान्सन्दशतस्तस्य कोपाद्ददृशुराननम्।\nयुगान्ते सर्वभूतानि कालस्येव जिघत्सतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2015425, "chapter_id": 1324, "verse_number": "२-६५-१३", "content_sanskrit": "उत्पतन्तं तु वेगेन जग्राहैनं मनस्विन्।\nभीष्म एव महाबाहुर्महासेनमिवेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2015426, "chapter_id": 1324, "verse_number": "२-६५-१४", "content_sanskrit": "तस्व भीमस्य भीष्मेण वार्यमाणस्य भारत।\nगुरुणा विविधैर्वाक्यैः क्रोधः प्रशममागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2015427, "chapter_id": 1324, "verse_number": "२-६५-१५", "content_sanskrit": "नातिचक्राम भीष्मस्य स हि वाक्यमरिन्दमः।\nसमुद्वृत्तो घनापाये वेलामिव महोदधिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2015428, "chapter_id": 1324, "verse_number": "२-६५-१६", "content_sanskrit": "शिशुपालस्तु सङ्क्रुद्धे भीमसेने जनाधिप।\nनाकम्पत तदा वीरः पौरुषे व्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2015429, "chapter_id": 1324, "verse_number": "२-६५-१७", "content_sanskrit": "उत्पतन्तं तु वेगेन पुनः पुनररिन्दमः।\nन स तं चिन्तयामास सिंहः क्रुद्धो मृगं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2015430, "chapter_id": 1324, "verse_number": "२-६५-१८", "content_sanskrit": "प्रहसंश्चाब्रवीद्वाक्यं चेदिराजः प्रतापवान्।\nभीमसेनमभिक्रुद्धं दृष्ट्वा भीमपराक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2015431, "chapter_id": 1324, "verse_number": "२-६५-१९", "content_sanskrit": "मुञ्चैनं भीष्म पश्यन्तु यावदेनं नराधिपः।\nमत्प्रभावविनिर्दग्धं पतङ्गमिव वह्निना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2015432, "chapter_id": 1324, "verse_number": "२-६५-२०", "content_sanskrit": "ततश्चेदिपतेर्वाक्यं श्रुत्वा तत्कुरुसत्तमः।\nभीमसेनमुवाचेदं भीष्मे मतिमतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2015433, "chapter_id": 1324, "verse_number": "२-६५-२१", "content_sanskrit": "नैषा चेदिपतेर्बुद्धिर्यत्त्वामाह्वयतेऽच्युतम्।\nभीमसेन महाबाहो कृष्णस्यैव विनिश्चयः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2015434, "chapter_id": 1324, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि शिशुपालवधपर्वणि पञ्चषष्टितमोऽध्यायः॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]