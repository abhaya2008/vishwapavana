[{"id": 7003980000, "chapter_id": 23980, "verse_number": "३-१-४३-१", "content_sanskrit": "श्रीसूत उवाच ।\nअथेदानीं प्रवक्ष्यामि रामनाथस्य वैभवम् ।\nयच्छ्रुत्वा सर्वपापेभ्यो मु्च्यते मानवो भुवि॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003980001, "chapter_id": 23980, "verse_number": "३-१-४३-२", "content_sanskrit": "रामप्रतिष्ठितं लिंगं यः पश्यति नरः सकृत् ।\nस नरो मुक्तिमाप्नोति शिवसायुज्यरूपिणीम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003980002, "chapter_id": 23980, "verse_number": "३-१-४३-३", "content_sanskrit": "दशवर्षैस्तु यत्पुण्यं क्रियते तु कृते युगे ।\nत्रेतायामेकवर्षेण तत्पुण्यं साध्यते नृभिः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003980003, "chapter_id": 23980, "verse_number": "३-१-४३-४", "content_sanskrit": "द्वापरे तच्च मासेन तद्दिनेन कलौ युगे ।\nतत्फलं कोटिगुणितं निमिषे निमिषे नृणाम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003980004, "chapter_id": 23980, "verse_number": "३-१-४३-५", "content_sanskrit": "निःसंदेहं भवेदेवं रामनाथविलोकिनाम् ।\nरामेश्वर महालिंगे तीर्थानि सकलान्यपि॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003980005, "chapter_id": 23980, "verse_number": "३-१-४३-६", "content_sanskrit": "विद्यंते सर्वदेवाश्च मुनयः पितरस्तथा ।\nएककालद्विकालं वा त्रिकालं सर्वदैव वा॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003980006, "chapter_id": 23980, "verse_number": "३-१-४३-७", "content_sanskrit": "ये स्मरंति महादेवं रामनाथं विमुक्तिदम् ।\nकीर्तयंत्यथवा विप्रास्ते विमुक्ताघपंजराः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003980007, "chapter_id": 23980, "verse_number": "३-१-४३-८", "content_sanskrit": "सच्चिदानंदमद्वैतं सांबं रुद्रं प्रयांति वै ।\nरामेश्वराख्यं यल्लिंगं रामचन्द्रेण पूजि तम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003980008, "chapter_id": 23980, "verse_number": "३-१-४३-९", "content_sanskrit": "यस्य स्मरणमात्रेण यमपीडापि नो भवेत् ।\nरामेश्वरमहालिंगं येऽर्चयंति सकृन्नराः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003980009, "chapter_id": 23980, "verse_number": "३-१-४३-१०", "content_sanskrit": "न मानुषास्ते विज्ञेयाः किं तु रुद्रा न संशयः ।\nरामेश्वरमहालिंगं नार्चितं येन भक्तितः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003980010, "chapter_id": 23980, "verse_number": "३-१-४३-११", "content_sanskrit": "चिरकालं स संसारे संसरेद्दुःखसंकुले ।\nरामेश्वरमहालिंगं ये पश्यंति सकृन्नराः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003980011, "chapter_id": 23980, "verse_number": "३-१-४३-१२", "content_sanskrit": "किं दानैः किं व्रतैस्तेषां किं तपोभिः किमध्वरैः ।\nरामेश्वरमहालिंगं यो न चिंतयति क्षणम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003980012, "chapter_id": 23980, "verse_number": "३-१-४३-१३", "content_sanskrit": "अज्ञानी स च पापी स्यात्स मूको बधिरस्तथा ।\nस जडोंऽधश्च विज्ञेयश्छिद्रं तस्य सदा भवेत्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003980013, "chapter_id": 23980, "verse_number": "३-१-४३-१४", "content_sanskrit": "धनक्षेत्रसुतादीनां तस्य हानिस्तथा भवेत् ।\nरामेश्वरमहालिंगे सकृद्दृष्टे मुनीश्वराः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003980014, "chapter_id": 23980, "verse_number": "३-१-४३-१५", "content_sanskrit": "किं काश्या गयया किं वा प्रयागेणापि किं फलम् ।\nदुर्लभं प्राप्य मानुष्यं मानवा यत्र भूतले॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003980015, "chapter_id": 23980, "verse_number": "३-१-४३-१६", "content_sanskrit": "रामनाथमहालिंगं नमस्यंत्यर्चयंति च॥  ।\nजन्म तेषां हि सफलं ते कृतार्थाश्च नेतरे॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003980016, "chapter_id": 23980, "verse_number": "३-१-४३-१७", "content_sanskrit": "रामेश्वरमहालिंगे पूजिते वा स्मृतेपि वा ।\nविष्णुना ब्रह्मणा किं वा शक्रेणाप्यखिलामरैः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003980017, "chapter_id": 23980, "verse_number": "३-१-४३-१८", "content_sanskrit": "रामनाथमहालिंगं भक्तियुक्ताश्च ये नराः ।\nतेषां प्रणामस्मरणपूजायुक्तास्तु ये नराः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003980018, "chapter_id": 23980, "verse_number": "३-१-४३-१९", "content_sanskrit": "न ते पश्यंति दुःखानि नैव यांति यमालयम् ।\nब्रह्महत्यासहस्राणि सुरापानायुतानि च॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003980019, "chapter_id": 23980, "verse_number": "३-१-४३-२०", "content_sanskrit": "दृष्टे रामेश्वरे देवे विलयं यांति कृत्स्नशः ।\nये वांछंति सदा भोगं राज्यं च त्रिदशालये॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003980020, "chapter_id": 23980, "verse_number": "३-१-४३-२१", "content_sanskrit": "रामे श्वरमहालिंगं ते नमंतु सकृन्मुदा ।\nयानि कानि च पापानि जन्मकोटिकृतान्यपि॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003980021, "chapter_id": 23980, "verse_number": "३-१-४३-२२", "content_sanskrit": "तानि रामेश्वरे दृष्टे विलयं यांति सर्वदा ।\nसंपर्कात्कौतुकाल्लोभाद्भयाद्वापि च संस्मरन्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003980022, "chapter_id": 23980, "verse_number": "३-१-४३-२३", "content_sanskrit": "रामेश्वरमहालिंगं नेहामुत्र च दुःखभाक् ।\nरामेश्वरमहालिंगं कीर्तयन्नर्चयन्नपि॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003980023, "chapter_id": 23980, "verse_number": "३-१-४३-२४", "content_sanskrit": "अवश्यं रुद्रसारूप्यं लभते नात्र संशयः ।\nयथैधांसि समिद्धोऽग्निर्भस्मसात्कुरुते क्षणात्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003980024, "chapter_id": 23980, "verse_number": "३-१-४३-२५", "content_sanskrit": "तथा पापानि सर्वाणि रामेश्वरविलोकनात् ।\nरामेश्वरमहालिंगभक्तिरष्टविधा स्मृता॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003980025, "chapter_id": 23980, "verse_number": "३-१-४३-२६", "content_sanskrit": "तद्भक्तजनवात्सल्यं तत्पूजापरितोषणम् ।\nस्वयं तत्पूजनं भक्त्या तदर्थे देहचेष्टितम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003980026, "chapter_id": 23980, "verse_number": "३-१-४३-२७", "content_sanskrit": "तन्माहात्म्यकथानां च श्रवणेष्वादरस्तथा ।\nस्वरनेत्रशरीरेषु विकारस्फुरणं तथा॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003980027, "chapter_id": 23980, "verse_number": "३-१-४३-२८", "content_sanskrit": "रामेश्वरमहालिंगस्मरणं संततं तथा ।\nरामेश्वरमहालिंगमाश्रित्यैवोपजीवनम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003980028, "chapter_id": 23980, "verse_number": "३-१-४३-२९", "content_sanskrit": "एवमष्टविधा भक्तिर्यस्मिन्म्लेच्छेऽपिविद्यते ।\nस एव मुक्तिक्षेत्राणां दायभाक्परिकीर्त्यते॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003980029, "chapter_id": 23980, "verse_number": "३-१-४३-३०", "content_sanskrit": "भक्त्या त्वनन्यया मुक्तिर्ब्रह्मज्ञानेन निश्चिता ।\nवेदांतशास्त्रश्रवणाद्यतीनामूर्ध्वरेतसाम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003980030, "chapter_id": 23980, "verse_number": "३-१-४३-३१", "content_sanskrit": "सा च मुक्तिर्विना ज्ञानदर्शनश्रवणोद्भवम् ।\nयत्राश्रमं विना विप्रा विरक्तिं च विना तथा॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003980031, "chapter_id": 23980, "verse_number": "३-१-४३-३२", "content_sanskrit": "सर्वेषां चैव वर्णानामखिलाश्रमिणामपि ।\nरामेश्वरमहालिंगदर्शनादेव केवलात्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003980032, "chapter_id": 23980, "verse_number": "३-१-४३-३३", "content_sanskrit": "अपुनर्भवदा मुक्तिर्भ विष्यत्यविलंबिता ।\nकृमिकीटाश्च देवाश्च मुनयश्च तपोधनाः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003980033, "chapter_id": 23980, "verse_number": "३-१-४३-३४", "content_sanskrit": "तुल्या रामेश्वरक्षेत्रे रामनाथप्रसादतः ।\nपापं कृतं मयानेकमिति मा क्रियतां भयम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003980034, "chapter_id": 23980, "verse_number": "३-१-४३-३५", "content_sanskrit": "मा गर्वः क्रियतां पुण्यं मयाकारीति वा जनैः ।\nरामेश्वरमहालिंगे सांबरुद्रे विलोकिते॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003980035, "chapter_id": 23980, "verse_number": "३-१-४३-३६", "content_sanskrit": "न न्यूना नाधिकाश्च स्युः किं तु सर्वे जनाः समाः ।\nरामेश्वरमहालिंगं यः पश्यति सभक्तिकम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003980036, "chapter_id": 23980, "verse_number": "३-१-४३-३७", "content_sanskrit": "न तेन तुल्यतामेति चतुर्वेद्यपि भूतले ।\nरामेश्वरमहालिंगे भक्तो यः श्वपचोऽपि सन्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003980037, "chapter_id": 23980, "verse_number": "३-१-४३-३८", "content_sanskrit": "तस्मै दानानि देयानि नान्यस्मै च त्रयीविदे ।\nया गतिर्योगयुक्तानां मुनीनामूर्ध्वरेतसाम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003980038, "chapter_id": 23980, "verse_number": "३-१-४३-३९", "content_sanskrit": "सा गतिः सर्वजंतूनां रामेश्वरविलोकिनाम् ।\nरामनाथशिवक्षेत्रे ये वसंति नरा द्विजाः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003980039, "chapter_id": 23980, "verse_number": "३-१-४३-४०", "content_sanskrit": "ते सर्वे पञ्चवक्त्राः स्युश्चंद्रालंकृतमस्तकाः ।\nनागाभरणसंयुक्तास्तथैव वृषभध्वजाः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003980040, "chapter_id": 23980, "verse_number": "३-१-४३-४१", "content_sanskrit": "त्रिनेत्रा भस्मदिग्धांगाः कपालाकृतिशेखराः ।\nसाक्षात्सांबा महादेवा भवेयुर्नात्र संशयः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003980041, "chapter_id": 23980, "verse_number": "३-१-४३-४२", "content_sanskrit": "रामनाथशिवक्षेत्रं ये व्रजंति नरा मुदा ।\nपदेपदेऽश्वमेधानां प्राप्नुयुः सुकृतानि ते॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003980042, "chapter_id": 23980, "verse_number": "३-१-४३-४३", "content_sanskrit": "रामसेतुं समाश्रित्य रामनाथस्य तुष्टये ।\nददाति ग्राममेकं यो ब्राह्मणाय सभक्तिकम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003980043, "chapter_id": 23980, "verse_number": "३-१-४३-४४", "content_sanskrit": "तेन भूः सकला दत्ता सशैलवनकानना ।\nपत्रं पुष्पं फलं तोयं रामनाथाय यो नरः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003980044, "chapter_id": 23980, "verse_number": "३-१-४३-४५", "content_sanskrit": "भक्त्या ददाति तं रक्षेद्रामनाथो ह्यहर्निशम् ।\nरामनाथमहालिंगे सांबे कारुणिके शिवे॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003980045, "chapter_id": 23980, "verse_number": "३-१-४३-४६", "content_sanskrit": "अत्यंतदुर्लभा भक्तिस्तत्पूजाप्यतिदुर्लभा ।\nस्तोत्रं च दुर्लभं प्रोक्तं स्मरणं चातिदुर्लभम्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003980046, "chapter_id": 23980, "verse_number": "३-१-४३-४७", "content_sanskrit": "रामनाथेश्वरं लिंगं महादेवं त्रिलोचनम् ।\nशरणं ये प्रपद्यंते भक्तियुक्तेन चेतसा॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003980047, "chapter_id": 23980, "verse_number": "३-१-४३-४८", "content_sanskrit": "लाभस्तेषां जयस्तेषा मिह लोके परत्र च ।\nरामनाथमहालिंगविषया यस्य शेमुषी॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003980048, "chapter_id": 23980, "verse_number": "३-१-४३-४९", "content_sanskrit": "दिवारात्रं च भवति स वै धन्यतरो भुवि ।\nरामनाथेश्वरं लिंगं यो न पूजयते शिवम्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003980049, "chapter_id": 23980, "verse_number": "३-१-४३-५०", "content_sanskrit": "नायं भुक्तेश्च मुक्तेश्च राज्यानामपि भाजनम् ।\nरामेश्वरमहालिंगं यः पूजयति भक्तितः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003980050, "chapter_id": 23980, "verse_number": "३-१-४३-५१", "content_sanskrit": "भुक्तिमुक्त्योश्च राज्यानामसौ परमभाजनम् ।\nरामनाथार्चनसमं नाधिकं पुण्यमस्ति वै॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003980051, "chapter_id": 23980, "verse_number": "३-१-४३-५२", "content_sanskrit": "रामनाथेश्वरं लिंगं द्वेष्टि यो मोहमास्थितः ।\nब्रह्महत्यायुतं तेन कृतं नरककारणम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003980052, "chapter_id": 23980, "verse_number": "३-१-४३-५३", "content_sanskrit": "तत्संभाषणमात्रेण मानवो नरकं व्रजेत् ।\nरामनाथपरा देवा रामनाथपरा मखाः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003980053, "chapter_id": 23980, "verse_number": "३-१-४३-५४", "content_sanskrit": "रामनाथपराः सर्वे तस्माद न्यन्न विद्यते ।\nअतः सर्वं परित्यज्य रामनाथं समाश्रयेत्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003980054, "chapter_id": 23980, "verse_number": "३-१-४३-५५", "content_sanskrit": "रामनाथमहालिंगं शरणं याति चेन्नरः ।\nदौर्मत्यं तस्य नास्त्येव शिवलोकं च यास्यति॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003980055, "chapter_id": 23980, "verse_number": "३-१-४३-५६", "content_sanskrit": "सर्वयज्ञतपोदानतीर्थस्नानेषु यत्फलम् ।\nतत्फलं कोटिगुणितं रामनाथस्य सेवया॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003980056, "chapter_id": 23980, "verse_number": "३-१-४३-५७", "content_sanskrit": "रामनाथेश्वरं लिंगं चिंतयन्घटिका द्वयम् ।\nकुलैकवंशमुद्धृत्य शिवलोके महीयते॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003980057, "chapter_id": 23980, "verse_number": "३-१-४३-५८", "content_sanskrit": "दिनमेकं तु यः पश्येद्रामनाथं महेश्वरम् ।\nइहैव धनवान्भूत्वा सोंऽते रुद्रश्च जायते॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003980058, "chapter_id": 23980, "verse_number": "३-१-४३-५९", "content_sanskrit": "यः स्मरेत्प्रातरुत्थाय रामनाथं महेश्वरम् ।\nअनेनैव शरीरेण स शिवो वर्तते भुवि॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003980059, "chapter_id": 23980, "verse_number": "३-१-४३-६०", "content_sanskrit": "रामनाथमहालिंगद्रष्टुर्दर्शनमात्रतः ।\nअन्येषां प्राणिनां पापं तत्क्षणादेव नश्यति॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003980060, "chapter_id": 23980, "verse_number": "३-१-४३-६१", "content_sanskrit": "रामनाथेश्वरं लिंगं मध्याह्ने यस्तु पश्यति ।\nसुरापानसहस्राणि तस्य नश्यंति तत्क्षणात्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003980061, "chapter_id": 23980, "verse_number": "३-१-४३-६२", "content_sanskrit": "सायंकाले पश्यति यो रामनाथं सभक्तिकम् ।\nगुरुस्त्रीगमनोत्पन्नपातकं तस्य नश्यति॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003980062, "chapter_id": 23980, "verse_number": "३-१-४३-६३", "content_sanskrit": "सायंकाले महास्तोत्रैः स्तौति रामेश्वरं तु यः ।\nस्वर्णस्तेयसहस्राणि तस्य नश्यंति तत्क्षणात्॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003980063, "chapter_id": 23980, "verse_number": "३-१-४३-६४", "content_sanskrit": "स्नानं च धनुषः कोटौ रामनाथस्य दर्शनम् ।\nइति लभ्येत वै पुंसां किं गंगाजलसेवया॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003980064, "chapter_id": 23980, "verse_number": "३-१-४३-६५", "content_sanskrit": "रामनाथमहालिंगसेवया यन्न लभ्यते ।\nतदन्यद्धर्मजालेन नैव लभ्येत कर्हिचित्॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003980065, "chapter_id": 23980, "verse_number": "३-१-४३-६६", "content_sanskrit": "रामनाथं महालिगं यः कदापि न पश्यति ।\nसंकरः स तु विज्ञेयो न पितुर्बीजसंभवः॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003980066, "chapter_id": 23980, "verse_number": "३-१-४३-६७", "content_sanskrit": "रामनाथेतिशब्दं यस्त्रिः पठेत्प्रातरुत्थितः ।\nतस्य पूर्वदिनोत्पन्नपातकं नश्यति क्षणात्॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003980067, "chapter_id": 23980, "verse_number": "३-१-४३-६८", "content_sanskrit": "रामनाथे महालिंगे भक्तरक्षणदीक्षिते ।\nभोजने विद्यमानेऽपि याचनाः किं प्रयास्यथ॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003980068, "chapter_id": 23980, "verse_number": "३-१-४३-६९", "content_sanskrit": "रामनाथमहालिंगे प्रसन्ने करुणानिधौ ।\nनश्यंति सकलाः क्लेशा यथा सूर्योदये हिमम्॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003980069, "chapter_id": 23980, "verse_number": "३-१-४३-७०", "content_sanskrit": "प्राणोत्क्रमणवेलायां रामनाथं स्मरेद्यदि ।\nजन्मनेऽसौ न कल्पेत भूयः शंकरतामियात्॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003980070, "chapter_id": 23980, "verse_number": "३-१-४३-७१", "content_sanskrit": "रामनाथ महादेव मां रक्ष करुणानिधे ।\nइति यः सततं ब्रूयात्कलिनासौ न बाध्यते॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003980071, "chapter_id": 23980, "verse_number": "३-१-४३-७२", "content_sanskrit": "रामनाथ जगन्नाथ धूर्जटे नीललोहित ।\nइति यः सततं ब्रूयाद्बाध्यतेऽसौ न मायया॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003980072, "chapter_id": 23980, "verse_number": "३-१-४३-७३", "content_sanskrit": "नीलकण्ठ महादेव रामेश्वरसदाशिव ।\nइति ब्रुवन्सदा जंतुर्नैव कामेन बाध्यते॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003980073, "chapter_id": 23980, "verse_number": "३-१-४३-७४", "content_sanskrit": "रामेश्वर यमाराते कालकूटविषादन ।\nइतीरयञ्जनो नित्यं न क्रोधेन प्रपीड्यते॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003980074, "chapter_id": 23980, "verse_number": "३-१-४३-७५", "content_sanskrit": "रामनाथालयं यस्तु दारुभिः कुरुते नरः ।\nस पुमान्स्वर्गमाप्नोति त्रिकोटिकुलसंयुतः॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003980075, "chapter_id": 23980, "verse_number": "३-१-४३-७६", "content_sanskrit": "इष्टकाभिस्तु यः कुर्यात्स वैकुण्ठमवाप्नुयात् ।\nशिलाभिः कुरुते यस्तु स गच्छेद्ब्रह्मणः पदम्॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003980076, "chapter_id": 23980, "verse_number": "३-१-४३-७७", "content_sanskrit": "स्फटिकादिशिलाभेदैः कुर्वन्नस्यालयं जनः ।\nशिवलोकमवाप्नोति विमानवरमास्थितः॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003980077, "chapter_id": 23980, "verse_number": "३-१-४३-७८", "content_sanskrit": "रामनाथालयं ताम्रैः कुर्वन्भक्तिपुरःसरम् ।\nशिवसामीप्यमाप्नोति शिवस्यार्द्धासनस्थितः॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003980078, "chapter_id": 23980, "verse_number": "३-१-४३-७९", "content_sanskrit": "रामेश्वरालयं रूप्यैः कुर्वन्वै मानवो मुदा ।\nशिवसारूप्यमाप्नोति शिववन्मोदते सदा॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003980079, "chapter_id": 23980, "verse_number": "३-१-४३-८०", "content_sanskrit": "रामनाथालयं हेम्ना यः करोति सभक्तिकम् ।\nस नरो मुक्तिमाप्नोति शिवसायुज्यरूपिणीम्॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003980080, "chapter_id": 23980, "verse_number": "३-१-४३-८१", "content_sanskrit": "रामनाथालयं हेम्ना धनाढ्यः कुरुते नरः ।\nमृदा दरिद्रः कुरुते तयोः पुण्यं समं स्मृतम्॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003980081, "chapter_id": 23980, "verse_number": "३-१-४३-८२", "content_sanskrit": "रामनाथमहालिंगस्नानकाले द्विजोत्तमाः ।\nत्रिसंध्यं गेयनृत्ते च मुखवाद्यैश्च काहलम्॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003980082, "chapter_id": 23980, "verse_number": "३-१-४३-८३", "content_sanskrit": "वाद्यान्यन्यानि कुरुते यः पुमान्भक्तिपूर्वकम् ।\nस महापातकैर्मुक्तो रुद्रलोके महीयते॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003980083, "chapter_id": 23980, "verse_number": "३-१-४३-८४", "content_sanskrit": "योभिषेकस्य समये रामनाथस्य शूलिनः ।\nरुद्राध्यायं च चमकं तथा पुरुषसूक्तकम्॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003980084, "chapter_id": 23980, "verse_number": "३-१-४३-८५", "content_sanskrit": "त्रिसुपर्णं पंचशांतिं पावमान्यादिकं तथा ।\nजपेत्प्रीतियुतो विप्रा नरकं न समश्नुते॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003980085, "chapter_id": 23980, "verse_number": "३-१-४३-८६", "content_sanskrit": "गवां क्षीरेण दध्ना च पंचगव्यैर्घृतैस्तथा ।\nरामनाथमहालिंगस्नानं नरकनाशनम्॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003980086, "chapter_id": 23980, "verse_number": "३-१-४३-८७", "content_sanskrit": "रामनाथमहालिंगं घृतेन स्नापयेच्च यः ।\nकल्पजन्मार्जितं पापं तत्क्षणादेव नश्यति॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003980087, "chapter_id": 23980, "verse_number": "३-१-४३-८८", "content_sanskrit": "रामनाथमहालिंगं गोक्षीरैः स्नापयन्नरः ।\nकुलैकविंशमुत्तार्य शिवलोके महीयते॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003980088, "chapter_id": 23980, "verse_number": "३-१-४३-८९", "content_sanskrit": "रामनाथमहालिंगं दध्ना संस्नापयन्नरः ।\nसर्वपापविनिर्मुक्तो विष्णुलोके महीयते॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003980089, "chapter_id": 23980, "verse_number": "३-१-४३-९०", "content_sanskrit": "अभ्यंगं तिलतैलेन रामेश्वरशिवस्य यः ।\nकरोति हि सकृद्भक्त्या स कुबेरगृहे वसेत्॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003980090, "chapter_id": 23980, "verse_number": "३-१-४३-९१", "content_sanskrit": "रामनाथमहालिंगे स्नानमिक्षुरसेन यः ।\nसकृदप्याचरेद्भ क्त्या चन्द्रलोकं समश्नुते॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003980091, "chapter_id": 23980, "verse_number": "३-१-४३-९२", "content_sanskrit": "लिकुचाम्ररसोत्पन्नसारेण स्नापयन्नरः ।\nरामनाथमहालिंगं पितृलोकं समश्नुते॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003980092, "chapter_id": 23980, "verse_number": "३-१-४३-९३", "content_sanskrit": "नालिकेरजलैः स्नानं रामनाथमहेश्वरे ।\nब्रह्महत्यादिपापानां नाशनं परिकीर्तितम्॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003980093, "chapter_id": 23980, "verse_number": "३-१-४३-९४", "content_sanskrit": "रामनाथमहालिंगं रंभापक्वैर्विमर्दयन् ।\nविनाश्य सकलं पापं वायुलोके मही यते॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003980094, "chapter_id": 23980, "verse_number": "३-१-४३-९५", "content_sanskrit": "वस्त्रपूतेन तोयेन रामनाथं महेश्वरम् ।\nस्नापयन्वारुणं लोकमाप्नोति द्विजसत्तमाः॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003980095, "chapter_id": 23980, "verse_number": "३-१-४३-९६", "content_sanskrit": "चंदनोदकधाराभी रामनाथं महेश्वरम् ।\nस्नापयेत्पुरुषो विप्रा गांधर्वं लोकमाप्नुयात्॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003980096, "chapter_id": 23980, "verse_number": "३-१-४३-९७", "content_sanskrit": "पुष्पवासिततोयेन हेमसंपृक्तवारिणा ।\nपद्मवासिततोयेन स्नानाद्रामेश्वरस्य तु॥ ९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003980097, "chapter_id": 23980, "verse_number": "३-१-४३-९८", "content_sanskrit": "महेंद्रासनमारुह्य तेनैव सह मोदते ।\nपाटलोत्पलकल्हारपुन्नागकरवीरकैः॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003980098, "chapter_id": 23980, "verse_number": "३-१-४३-९९", "content_sanskrit": "वासितैर्वारिभिर्विप्रा रामेश्वरमहेश्वरम् ।\nअभिषिच्य महद्भिश्च पातकैः स विमुच्यते॥ ९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003980099, "chapter_id": 23980, "verse_number": "३-१-४३-१००", "content_sanskrit": "यानि चान्यानि पुष्पाणि सुरभीणि महांति च ।\nतद्गंधवासितैस्तोयैरभिषिच्य दयानिधिम्॥ १०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003980100, "chapter_id": 23980, "verse_number": "३-१-४३-१०१", "content_sanskrit": "रामेश्वरमहालिंगं शिवलोके महीयते ।\nएलाकर्पूरलामज्जवासितैः शुद्धवारिभिः॥ १०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003980101, "chapter_id": 23980, "verse_number": "३-१-४३-१०२", "content_sanskrit": "रामेश्वरमहालिंगमभिषिच्य विशुद्धधीः ।\nआग्नेयं लोकमासाद्य सर्वाकामा न्समश्नुते॥ १०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003980102, "chapter_id": 23980, "verse_number": "३-१-४३-१०३", "content_sanskrit": "रामनाथाभिषेकार्थं मृद्धटान्यः प्रयच्छति ।\nइह लोके शतायुः स्यात्सर्वकाम समृद्धिमान्॥ १०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003980103, "chapter_id": 23980, "verse_number": "३-१-४३-१०४", "content_sanskrit": "ताम्रकुंभप्रदानेन देवेंद्रत्वमवा प्नुयात् ।\nरौप्यकुंभप्रदानेन ब्रह्मलोकं समश्नुते॥ १०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003980104, "chapter_id": 23980, "verse_number": "३-१-४३-१०५", "content_sanskrit": "हेमकुंभप्रदानेन शिवलोके महीयते ।\nरत्नकुंभप्रदानेन शिवसामीप्यमश्नुते॥ १०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003980105, "chapter_id": 23980, "verse_number": "३-१-४३-१०६", "content_sanskrit": "रामनाथाभिषेकार्थं नैवेद्यार्थमपि द्विजाः ।\nयो गां पयस्विनीं दद्यात्सोऽश्वमेधफलं लभेत्॥ १०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003980106, "chapter_id": 23980, "verse_number": "३-१-४३-१०७", "content_sanskrit": "प्राप्नोति शिववेषं च देहांते शिवलोकभाक् ।\nरामसेतौ धनुष्कोटौ रामनाथेत्युदीर्य यः॥ १०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003980107, "chapter_id": 23980, "verse_number": "३-१-४३-१०८", "content_sanskrit": "यत्र क्वाप्याचरेत्स्नानं सेतुस्नानफलं लभेत् ।\nसुधाप्रलिप्तं यः कुर्याद्रामनाथशिवालयम्॥ १०८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003980108, "chapter_id": 23980, "verse_number": "३-१-४३-१०९", "content_sanskrit": "तत्पुण्यं गदितुं नाहं शक्तो वर्षशतादपि ।\nनवीकरोति यो मर्त्यो रामनाथशिवालयम्॥ १०९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003980109, "chapter_id": 23980, "verse_number": "३-१-४३-११०", "content_sanskrit": "कर्तुः शतगुणं ज्ञेयं तस्य पुण्यफलं द्विजाः ।\nछिन्नं भिन्नं च यः सम्यग्रामनाथशिवालयम्॥ ११० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003980110, "chapter_id": 23980, "verse_number": "३-१-४३-१११", "content_sanskrit": "करोति भक्त्या पुरुषो ब्रह्महत्यायुतं दहेत् ।\nरामनाथस्य पुरतो दीपानारोपयन्मुदा॥ १११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003980111, "chapter_id": 23980, "verse_number": "३-१-४३-११२", "content_sanskrit": "अविद्यापटलं भित्त्वा याति ब्रह्म सनातनम् ।\nघृतं तैलं तथा मुद्गाञ्छर्करास्तंडुलान्गुडान्॥ ११२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003980112, "chapter_id": 23980, "verse_number": "३-१-४३-११३", "content_sanskrit": "प्रयच्छन्रामनाथाय देवेंद्रपदमश्नुते ।\nरामनाथमहालिंगदर्शनादर्चनात्स्मृतेः॥ ११३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003980113, "chapter_id": 23980, "verse_number": "३-१-४३-११४", "content_sanskrit": "स्पर्शनादपि पापानि विलयं यांति तत्क्षणात् ।\nरामनाथाय यो दद्यान्महाघंटां च दर्पणम्॥ ११४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003980114, "chapter_id": 23980, "verse_number": "३-१-४३-११५", "content_sanskrit": "विमानशतसं भोगैश्चिरं शिवपुरे वसेत् ।\nभेरीमृदंगपटह निःसाणमुरजादिकम्॥ ११५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003980115, "chapter_id": 23980, "verse_number": "३-१-४३-११६", "content_sanskrit": "वंशकांस्यादिवादित्रं तथा वाद्यांतराणि च ।\nप्रयच्छन्रामनाथाय महादे वाय सादरम्॥ ११६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7003980116, "chapter_id": 23980, "verse_number": "३-१-४३-११७", "content_sanskrit": "स विमानैर्महाभोगैर्वाद्यघोषसमन्वितैः ।\nअनेकयुगपर्यंतं शिवलोके महीयते॥ ११७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7003980117, "chapter_id": 23980, "verse_number": "३-१-४३-११८", "content_sanskrit": "रामनाथं समुद्दिश्य यद्दत्तं स्वल्प मादरात् ।\nतदनंतफलं दातुः परत्र भवति ध्रुवम्॥ ११८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7003980118, "chapter_id": 23980, "verse_number": "३-१-४३-११९", "content_sanskrit": "रामेश्वरे महाक्षेत्रे रामनाथस्य सन्निधौ ।\nवसन्मुक्तिमवाप्नोति पुनरावृत्तिवर्जिताम्॥ ११९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7003980119, "chapter_id": 23980, "verse_number": "३-१-४३-१२०", "content_sanskrit": "आयुः प्रयाति त्वरितं त्वरितं याति यौवनम् ।\nत्वरितं संपदो यांति दारपुत्रादयस्तथा॥ १२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7003980120, "chapter_id": 23980, "verse_number": "३-१-४३-१२१", "content_sanskrit": "राजादिभिर्धनं बाध्यं गृहक्षेत्रादिकं तथा ।\nसर्वं च क्षणिकं विप्रा गृहोपकरणादिकम्॥ १२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7003980121, "chapter_id": 23980, "verse_number": "३-१-४३-१२२", "content_sanskrit": "तस्मात्सर्वं परित्यज्य संसारस्योपलालनम् ।\nरामेश्वरमहालिंगमापन्नार्तिहरं नृणाम्॥ १२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7003980122, "chapter_id": 23980, "verse_number": "३-१-४३-१२३", "content_sanskrit": "श्रोतव्यं कीर्तितव्यं च स्मर्तव्यं च मनीषिभिः ।\nरामेश्वराय देवाय यो वै ग्रामान्प्रयच्छति॥ १२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7003980123, "chapter_id": 23980, "verse_number": "३-१-४३-१२४", "content_sanskrit": "स हि प्रारब्धदेहांते शिव एव प्रजा यते ।\nपात्राणामुत्तमं पात्रं रामनाथो महेश्वरः॥ १२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7003980124, "chapter_id": 23980, "verse_number": "३-१-४३-१२५", "content_sanskrit": "तस्मै दत्त्वा द्विजाः सत्यमनंतं सुखमश्नुते ।\nरामनाथमहालिंगदर्शनावधि पातकम्॥ १२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7003980125, "chapter_id": 23980, "verse_number": "३-१-४३-१२६", "content_sanskrit": "दत्त्वा तस्मै जनः किंचित्सार्वभौमो भवेद्ध्रुवम् ।\nतालवृंतं ध्वजं छत्रं चंदनं गुग्गुलुं तथा॥ १२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7003980126, "chapter_id": 23980, "verse_number": "३-१-४३-१२७", "content_sanskrit": "ताम्रकांस्यादिरजतहेमरत्नमयान्ध टान् ।\nप्रयच्छंत्यभिषेकार्थं रामनाथस्य ये नराः॥ १२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7003980127, "chapter_id": 23980, "verse_number": "३-१-४३-१२८", "content_sanskrit": "भूमंडलाधिपतयो जायंते ते भवांतरे ।\nरामनाथस्य पूजार्थं पुष्पाण्युत्पादयंति ये॥ १२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7003980128, "chapter_id": 23980, "verse_number": "३-१-४३-१२९", "content_sanskrit": "अश्वमेधादियागानां फलान्यद्धाप्नुवंति ते ।\nरामेश्वरे महालिंगे पूजिते नमिते स्मृते॥ १२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7003980129, "chapter_id": 23980, "verse_number": "३-१-४३-१३०", "content_sanskrit": "श्रुते दृष्टे च विप्रेंद्रा दुर्लभं नास्ति किंचन ।\nरामनाथमहालिंगं सेवितुं यः पुमान्व्रजेत्॥ १३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7003980130, "chapter_id": 23980, "verse_number": "३-१-४३-१३१", "content_sanskrit": "तं दृष्ट्वा भयमाप्नोति तस्य पापौघ आशु वै ।\nरामनाथो महादेवो दृष्टो यदि भवेन्नृभिः॥ १३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7003980131, "chapter_id": 23980, "verse_number": "३-१-४३-१३२", "content_sanskrit": "किंवेदैः किमु वा शास्त्रैः किं वा तीर्थनिषेवणैः ।\nचंदनं कुंकुमं कोष्ठं कस्तूरीं गुग्गुलुं तथा॥ १३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7003980132, "chapter_id": 23980, "verse_number": "३-१-४३-१३३", "content_sanskrit": "मृगनाभिं च सरलं दद्याद्रामेश्वराय यः ।\nस भूमाविह जायेत धनाढ्यो वेदपारगः॥ १३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7003980133, "chapter_id": 23980, "verse_number": "३-१-४३-१३४", "content_sanskrit": "मुक्ताभरणवस्त्राणि महार्हाणि ददाति यः ।\nरामनाथाय देवाय नासौ दौर्गत्यमाप्नुयात्॥ १३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7003980134, "chapter_id": 23980, "verse_number": "३-१-४३-१३५", "content_sanskrit": "रामनाथमहालिंगं गंगातोयैः समाहृतैः ।\nयोऽभिषिंचत्यसौ पूज्यः शिवस्यापि न संशयः॥ १३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7003980135, "chapter_id": 23980, "verse_number": "३-१-४३-१३६", "content_sanskrit": "यावन्न याति मरणं यावन्नाक्रमते जरा ।\nयावन्नेंद्रियवैकल्यं तावदेव द्विजोत्तमाः॥ १३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7003980136, "chapter_id": 23980, "verse_number": "३-१-४३-१३७", "content_sanskrit": "तावदेव महादेवो रामनाथो मुमुक्षुभिः ।\nवन्द्यः पूज्यश्च मंतव्यः स्तुत्यश्च सततं शिवः॥ १३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7003980137, "chapter_id": 23980, "verse_number": "३-१-४३-१३८", "content_sanskrit": "रामेश्वरमहालिंगपूजातुल्यो न विद्यते ।\nधर्मः सर्वपुराणेषु सर्वशास्त्रेषु वै तथा॥ १३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7003980138, "chapter_id": 23980, "verse_number": "३-१-४३-१३९", "content_sanskrit": "रामनाथेश्वरं देवं महाकारुणिकं प्रभुम् ।\nभक्त्या भजंति ये नित्यं ते भूलोके सुखान्विताः॥ १३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7003980139, "chapter_id": 23980, "verse_number": "३-१-४३-१४०", "content_sanskrit": "भुक्त्वा भोगान्बहुसुखान्पुत्रदारयुता भृशम् ।\nएतच्छरीरपातांते मुक्तिं यास्यंति शाश्वतीम्॥ १४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7003980140, "chapter_id": 23980, "verse_number": "३-१-४३-१४१", "content_sanskrit": "श्रीसूत उवाच ।\nएवं वः कथितं विप्रा रामनाथस्य वै भवम् ।\nयस्त्वेतच्छृणुयान्नित्यं पठते च सभक्तिकम्॥ १४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7003980141, "chapter_id": 23980, "verse_number": "३-१-४३-१४२", "content_sanskrit": "स रामनाथसेवायाः फलमाप्नोत्यनुत्तमम् ।\nधनुष्कोटिमहातीर्थस्नानपुण्यं च यास्यति॥ १४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}]