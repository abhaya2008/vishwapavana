[{"id": 6000227000, "chapter_id": 10227, "verse_number": null, "content_sanskrit": "अथ एकत्रिंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000227001, "chapter_id": 10227, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.001.m4a", "display_order": 2}, {"id": 6000227002, "chapter_id": 10227, "verse_number": "१०-३१-१", "content_sanskrit": "इत्थं भगवतो गोप्यः श्रुत्वा वाचः सुपेशलाः।\nजहुर्विरहजं तापं तत्सङ्गोपचिताशिषः॥ १०/३१/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.002.m4a", "display_order": 3, "topics": [{"text": "श्रीकृष्णस्य गोपिकाभिस्सह रासक्रीडावर्णनम्, जलक्रीडा च", "range": "१–२६"}]}, {"id": 6000227003, "chapter_id": 10227, "verse_number": "१०-३१-२", "content_sanskrit": "तत्रारभत गोविन्दो रासक्रीडामनुव्रतैः।\nस्‍त्रीरत्नैरन्वितः प्रीतैरन्योन्याबद्धबाहुभिः॥ १०/३१/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.003.m4a", "display_order": 4}, {"id": 6000227004, "chapter_id": 10227, "verse_number": "१०-३१-३", "content_sanskrit": "रासोत्सवः सम्प्रवृत्तो गोपीमण्डलमण्डितः। योगेश्वरेण कृष्णेन तासां मध्ये द्वयोर्द्वयोः।\nप्रविष्टेन गृहीतानां कण्ठे स्वनिकटं स्‍त्रियः॥ १०/३१/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.004.m4a", "display_order": 5}, {"id": 6000227005, "chapter_id": 10227, "verse_number": "१०-३१-४", "content_sanskrit": "यन्मन्येरत नभस्तावद् विमानशतसङ्कुलम्।\nदिवौकसां सदाराणामौत्सुक्यनिभृतात्मनाम्॥ १०/३१/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.005.m4a", "display_order": 6}, {"id": 6000227006, "chapter_id": 10227, "verse_number": "१०-३१-५", "content_sanskrit": "ततो दुन्दुभयो नेदुः खात् पेतुः पुष्पवृष्टयः।\nजगुर्गन्धर्वपतयः सस्‍त्रीकास्तद्यशोऽमलम्॥ १०/३१/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.006.m4a", "display_order": 7}, {"id": 6000227007, "chapter_id": 10227, "verse_number": "१०-३१-६", "content_sanskrit": "वलयानां नूपुराणां किङ्किणीनां च योषिताम्।\nसप्रियाणामभूच्छब्दस्तुमुलो रासमण्डले॥ १०/३१/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.007.m4a", "display_order": 8}, {"id": 6000227008, "chapter_id": 10227, "verse_number": "१०-३१-७", "content_sanskrit": "तत्रापि शुशुभे ताभिर्भगवान् देवकीसुतः।\nमध्ये मणीनां हैमानां महामरकतो यथा॥ १०/३१/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.008.m4a", "display_order": 9}, {"id": 6000227009, "chapter_id": 10227, "verse_number": "१०-३१-८", "content_sanskrit": "पादन्यासैर्भुजविधुतिभिः सुस्मितैर्भ्रूविलासैः भज्यन्मध्यैश्चलकुचपटैः कुण्डलैर्गण्डलोलैः।\nस्विद्यन्मुख्यः कबररशनाग्रन्थयः कृष्णवध्वो गायन्त्यस्तं तडित इव ता मेघचक्रे विरेजुः॥ १०/३१/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.009.m4a", "display_order": 10}, {"id": 6000227010, "chapter_id": 10227, "verse_number": "१०-३१-९", "content_sanskrit": "उच्चैर्जगुः कृतमदा रक्तकण्ठ्यो रतिप्रियाः।\nकृष्णाभिमर्शमुदिता यद्गीतेनेदमावृतम्॥ १०/३१/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.010.m4a", "display_order": 11}, {"id": 6000227011, "chapter_id": 10227, "verse_number": "१०-३१-१०", "content_sanskrit": "काचित् समं मुकुन्देन स्वरजातीरमिश्रिताः। उन्निन्ये पूजिता तेन प्रीयता साधु साध्विति।\nतदेव ध्रुवमुन्निन्ये तस्यै मानं च बह्वदात्॥ १०/३१/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.011.m4a", "display_order": 12}, {"id": 6000227012, "chapter_id": 10227, "verse_number": "१०-३१-११", "content_sanskrit": "काचिद् रासपरिश्रान्ता पार्श्वस्थस्य गदाभृतः।\nजग्राह बाहुना स्कन्धं स्रवत्कबरमल्लिका॥ १०/३१/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.012.m4a", "display_order": 13}, {"id": 6000227013, "chapter_id": 10227, "verse_number": "१०-३१-१२", "content_sanskrit": "तत्रैकांसगतं बाहुं कृष्णस्योत्पलसौरभम्।\nचन्दनालिप्तमाघ्राय हृष्टरोमा चुचुम्ब ह॥ १०/३१/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.013.m4a", "display_order": 14}, {"id": 6000227014, "chapter_id": 10227, "verse_number": "१०-३१-१३", "content_sanskrit": "कस्याश्चिन्नाट्यविक्षिप्तकुण्डलत्विषभूषितम्।\nगण्डं गण्डे सन्दधत्या आदात् ताम्बूलचर्वितम्॥ १०/३१/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.014.m4a", "display_order": 15}, {"id": 6000227015, "chapter_id": 10227, "verse_number": "१०-३१-१४", "content_sanskrit": "नृत्यती गायती काचित् कूजन्नूपुरमेखला।\nपार्श्वस्थाच्युतहस्ताब्जं श्रान्ताऽधात् स्तनयोः शिवम्॥ १०/३१/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.015.m4a", "display_order": 16}, {"id": 6000227016, "chapter_id": 10227, "verse_number": "१०-३१-१५", "content_sanskrit": "गोप्यो लब्ध्वाऽच्युतं कान्तं श्रिय एकान्तवल्लभम्।\nगृहीतकण्ठ्यस्तद्दोर्भ्यां गायन्त्यस्तं विजह्रिरे॥ १०/३१/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.016.m4a", "display_order": 17}, {"id": 6000227017, "chapter_id": 10227, "verse_number": "१०-३१-१६", "content_sanskrit": "कर्णोत्पलालकविटङ्ककपोलघर्मवक्त्रश्रियो वलयनूपुरघोषवाद्यैः।\nगोप्यः समं भगवता ननृतुः स्म केशस्रस्तस्रजो भ्रमरगायकरासगोष्ठ्याम्॥ १०/३१/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.017.m4a", "display_order": 18}, {"id": 6000227018, "chapter_id": 10227, "verse_number": "१०-३१-१७", "content_sanskrit": "एवं परिष्वङ्गकराभिमर्शस्निग्धेक्षणोद्दामविलासहासैः।\nरेमे रमेशो व्रजकामिनीभिर्यथा स्वतन्त्रः प्रतिघं विडम्बयन्॥ १०/३१/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.018.m4a", "display_order": 19}, {"id": 6000227019, "chapter_id": 10227, "verse_number": "१०-३१-१८", "content_sanskrit": "तदङ्गसङ्गप्रमदाकुलेन्द्रियाः केशान् दुकूलं कुचपट्टिकां वा।\nत्यक्तुं पतिं वोढुमलं व्रजस्‍त्रियो विस्रस्तमाल्याभरणाः कुरूद्वह॥ १०/३१/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.019.m4a", "display_order": 20}, {"id": 6000227020, "chapter_id": 10227, "verse_number": "१०-३१-१९", "content_sanskrit": "कृष्णविक्रीडितं वीक्ष्य व्यमुह्यन्त सुरस्‍त्रियः।\nकामार्दिताः शशाङ्कश्च सगणो विस्मितोऽभवत्॥ १०/३१/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.020.m4a", "display_order": 21}, {"id": 6000227021, "chapter_id": 10227, "verse_number": "१०-३१-२०", "content_sanskrit": "कृत्वा तावन्तमात्मानं यावतीर्गोपयोषितः।\nरराम भगवांस्ताभिरात्मारामोऽपि लीलया॥ १०/३१/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.021.m4a", "display_order": 22}, {"id": 6000227022, "chapter_id": 10227, "verse_number": "१०-३१-२१", "content_sanskrit": "तासां रतिविहारेण श्रान्तानां वदनानि सः।\nप्रामृजत् करुणः प्रेम्णा शन्तमेनाङ्ग पाणिना॥ १०/३१/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.022.m4a", "display_order": 23}, {"id": 6000227023, "chapter_id": 10227, "verse_number": "१०-३१-२२", "content_sanskrit": "गोप्यः स्फुरन्मकरकुण्डलकुन्तलत्विड्गण्डश्रिया सुरतहासनिरीक्षणेन।\nमानं दधत्य ऋषभस्य जगुः कृतानि पुण्यानि तत्कररुहस्पर्शप्रमोदाः॥ १०/३१/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.023.m4a", "display_order": 24}, {"id": 6000227024, "chapter_id": 10227, "verse_number": "१०-३१-२३", "content_sanskrit": "ताभिर्ययौ श्रममपोहितुमङ्गसङ्गध्वस्तस्रजः सुकुचकुङ्कुमरञ्जिता याः।\nगन्धर्वपालिभिरनुद्रुत आविशद् वाः श्रान्तो गजीभिरिभराडिव भिन्नसेतुः॥ १०/३१/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.024.m4a", "display_order": 25}, {"id": 6000227025, "chapter_id": 10227, "verse_number": "१०-३१-२४", "content_sanskrit": "सोऽन्तर्जले युवतिभिः परिषिच्यमानः प्रेमेक्षितप्रहसिताभिरभिष्टुताङ्गः।\nवैमानिकैः कुसुमवर्षिभिरीड्यमानो रेमे स्वयं स्वरतिरत्र गजेन्द्रलीलः॥ १०/३१/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.025.m4a", "display_order": 26}, {"id": 6000227026, "chapter_id": 10227, "verse_number": "१०-३१-२५", "content_sanskrit": "ततश्च कृष्णोपवने जलस्थलप्रसूनगन्धानिलजुष्टदिक्तटे।\nचचार भृङ्गप्रमदागणावृतो यथा मदच्युद् द्विरदः करेणुभिः॥ १०/३१/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.026.m4a", "display_order": 27}, {"id": 6000227027, "chapter_id": 10227, "verse_number": "१०-३१-२६", "content_sanskrit": "एवं शशाङ्कांशुविराजिता निशाः स सत्यकामोऽनुरताबलागणः।\nसिषेव आत्मन्यवरुद्धसौभगः सर्वाः शरत्काव्यकथारसाश्रयाः॥ १०/३१/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.027.m4a", "display_order": 28}, {"id": 6000227028, "chapter_id": 10227, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.028.m4a", "display_order": 29}, {"id": 6000227029, "chapter_id": 10227, "verse_number": "१०-३१-२७", "content_sanskrit": "संस्थापनाय धर्मस्य प्रशमायेतरस्य च।\nअवतीर्णो हि भगवानंशेन जगदीश्वरः॥ १०/३१/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.029.m4a", "display_order": 30, "topics": [{"text": "राज्ञः शुकस्य उत्तरम्", "range": "२७–४०"}]}, {"id": 6000227030, "chapter_id": 10227, "verse_number": "१०-३१-२८", "content_sanskrit": "स कथं धर्मसेतूनां वक्ता कर्ताऽभिरक्षिता।\nप्रतीपमाचरद् ब्रह्मन् परदाराभिमर्शनम्॥ १०/३१/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.030.m4a", "display_order": 31}, {"id": 6000227031, "chapter_id": 10227, "verse_number": "१०-३१-२९", "content_sanskrit": "आत्मारामो यदुपतिः कृतवान् वै जुगुप्सितम्।\nकिमभिप्राय एतं नः संशयं छिन्धि सुव्रत॥ १०/३१/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.031.m4a", "display_order": 32}, {"id": 6000227032, "chapter_id": 10227, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.032.m4a", "display_order": 33}, {"id": 6000227033, "chapter_id": 10227, "verse_number": "१०-३१-३०", "content_sanskrit": "धर्मव्यतिक्रमो दृष्ट ईश्वराणां च साहसम्।\nतेजीयसां न दोषाय वह्नेः सर्वभुजो यथा॥ १०/३१/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.033.m4a", "display_order": 34}, {"id": 6000227034, "chapter_id": 10227, "verse_number": "१०-३१-३१", "content_sanskrit": "नैतत् समाचरेज्जातु मनसाऽपि ह्यनीश्वरः।\nनश्यत्याश्वाचरन् मौढ्याद् यथा रुद्रोऽपिबद् विषम्॥ १०/३१/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.034.m4a", "display_order": 35}, {"id": 6000227035, "chapter_id": 10227, "verse_number": "१०-३१-३२", "content_sanskrit": "ईश्वराणां वचः सत्यं तथैवाचरितं क्‍वचित्।\nतेषां यत् स्ववचोऽयुक्तं बुद्धिमान् नैतदाचरेत्॥ १०/३१/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.035.m4a", "display_order": 36}, {"id": 6000227036, "chapter_id": 10227, "verse_number": "१०-३१-३३", "content_sanskrit": "कुशलाचरितेनैषामिह चार्थो न विद्यते।\nविपर्ययेण चानर्थो निरहङ्कारिणां प्रभो॥ १०/३१/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.036.m4a", "display_order": 37}, {"id": 6000227037, "chapter_id": 10227, "verse_number": "१०-३१-३४", "content_sanskrit": "किमुताखिलसत्वानां तिर्यङ्मर्त्यदिवौकसाम्।\nईशितुश्चेशितव्यानां कुशलाकुशलान्वयः॥ १०/३१/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.037.m4a", "display_order": 38}, {"id": 6000227038, "chapter_id": 10227, "verse_number": "१०-३१-३५", "content_sanskrit": "यत्पादपङ्कजपरागनिषेवतृप्ता योगप्रभावविधुताखिलकर्मबन्धाः।\nस्वैरं चरन्ति मुनयोऽपि न नह्यमानास्तस्येच्छयाऽऽत्तवपुषः कुत एव बन्धः॥ १०/३१/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.038.m4a", "display_order": 39}, {"id": 6000227039, "chapter_id": 10227, "verse_number": "१०-३१-३६", "content_sanskrit": "गोपीनां तत्पतीनां च सर्वेषामपि देहिनाम्।\nयोऽन्तश्चरति सोऽध्यक्ष एष क्रीडनदेहभाक्॥ १०/३१/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.039.m4a", "display_order": 40}, {"id": 6000227040, "chapter_id": 10227, "verse_number": "१०-३१-३७", "content_sanskrit": "अनुग्रहाय भक्तानां मानुषं देहमाश्रितः।\nभजते तादृशीं क्रीडां यां श्रुत्वा तत्परो भवेत्॥ १०/३१/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.040.m4a", "display_order": 41}, {"id": 6000227041, "chapter_id": 10227, "verse_number": "१०-३१-३८", "content_sanskrit": "नासूयन् नृप कृष्णाय मोहितास्तस्य मायया।\nमन्यमानाः स्वपार्श्वस्थान् स्वान् स्वान् दारान् व्रजौकसः॥ १०/३१/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.041.m4a", "display_order": 42}, {"id": 6000227042, "chapter_id": 10227, "verse_number": "१०-३१-३९", "content_sanskrit": "ब्रह्मरात्र उपावृत्ते वासुदेवानुमोदिताः।\nअनिच्छन्त्यो ययुर्गोप्यः स्वगृहान् भगवत्प्रियाः॥ १०/३१/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.042.m4a", "display_order": 43}, {"id": 6000227043, "chapter_id": 10227, "verse_number": "१०-३१-४०", "content_sanskrit": "विक्रीडितं व्रजवधूभिरिदं च विष्णोः श्रद्धान्वितोऽनुशृणुयादथ वर्णयेद् यः।\nभक्तिं परां भगवति प्रतिलभ्य कामं हृद्रोगमाश्वपहिनोत्यचिरेण धीरः॥ १०/३१/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_031/BhP_10.031.043.m4a", "display_order": 44}, {"id": 6000227044, "chapter_id": 10227, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे एकत्रिंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]