[{"id": 7003169000, "chapter_id": 23169, "verse_number": "४-१०५-१", "content_sanskrit": "अथ पञ्चाधिकशततमोऽध्यायः ।\nनारायण उवाच ।\nअथ वैदर्भराजेन्द्रो महाबलपराक्रम् ।\nविदर्भदेशे पुण्याश्च सत्यशीलश्च भीष्मकः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003169001, "chapter_id": 23169, "verse_number": "४-१०५-२", "content_sanskrit": "राजा नारायणांशश्च दाता च सर्वसंपदाम् ।\nधर्मिष्ठस्च गरीयांश्च वरिष्ठश्टापि पूजितः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003169002, "chapter_id": 23169, "verse_number": "४-१०५-३", "content_sanskrit": "तस्य कन्या महालक्ष्मी रुक्मिणी योषितां वरा ।\nअतीव सुन्दरी रम्या रमा रामासु पूजिता ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003169003, "chapter_id": 23169, "verse_number": "४-१०५-४", "content_sanskrit": "नवयौवनसंपन्ना रत्नाभरणभूषिता ।\nतप्तकाञ्चनवर्णाभा तेजसोज्ज्वलिता सती ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003169004, "chapter_id": 23169, "verse_number": "४-१०५-५", "content_sanskrit": "शुद्धसत्त्वस्वरूपा सा सत्यशीला पतिव्रता ।\nशान्ता दान्ता नितान्ता चाप्यनन्तगुणशालिनी ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003169005, "chapter_id": 23169, "verse_number": "४-१०५-६", "content_sanskrit": "इन्द्राणी वरुणानी च चन्द्रनारी च रोहिणी ।\nकुबेरपत्नी सूर्यस्त्री स्वाहा शान्ता कलावती ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003169006, "chapter_id": 23169, "verse_number": "४-१०५-७", "content_sanskrit": "अन्यासु रमणीयासु श्रेष्ठा च सुमनोहरा ।\nरुक्मिण्या भीष्मकन्यायाः कलां नार्हति षोडशीम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003169007, "chapter_id": 23169, "verse_number": "४-१०५-८", "content_sanskrit": "तां दृष्ट्वा राजराजेन्द्रो वालक्रीडारतां पराम् ।\nबालां सुशोभां कुर्वन्तीं यथाऽभ्रेषु विधोः कलाम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003169008, "chapter_id": 23169, "verse_number": "४-१०५-९", "content_sanskrit": "शरत्पूर्णेन्दुशोभाढ्यां शरत्कमललोचनाम् ।\nविवाहयोग्यां युवतीं लज्जानम्राननां शुभम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003169009, "chapter_id": 23169, "verse_number": "४-१०५-१०", "content_sanskrit": "सहसा चिन्तितो धर्मो धर्मशीलश्च सुव्रतः ।\nसुतां पप्रच्छ पुत्रांश्च ब्राह्मणांश्च पुरोहितान् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003169010, "chapter_id": 23169, "verse_number": "४-१०५-११", "content_sanskrit": "कं वृणोमि सुतार्ध च वराहं प्रवरं वरम् ।\nमुनिपुत्रं देवपुत्रं राजेन्द्रसुतमीप्सितम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003169011, "chapter_id": 23169, "verse_number": "४-१०५-१२", "content_sanskrit": "विवाहयोग्या कन्या मे वर्धमाना मनोहरा ।\nशीघ्रं पश्य वरं याग्यं नवयौवनसंस्थितम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003169012, "chapter_id": 23169, "verse_number": "४-१०५-१३", "content_sanskrit": "धर्मशीलं सत्यसंधं नारायणपरायणम् ।\nमहाकुलप्रसूतं च सर्वत्रैव प्रतिष्ठितम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003169013, "chapter_id": 23169, "verse_number": "४-१०५-१४", "content_sanskrit": "करोषि राजपुत्रं चेद्रणशास्त्रविशारदम् ।\nमहारथं प्रतापार्हं रणमूर्ध्नि च सुस्थिरम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003169014, "chapter_id": 23169, "verse_number": "४-१०५-१५", "content_sanskrit": "करोषि देवपुत्रं चेद्देवं गुणयुतं तथा ।\nकरोषि मुनिपुत्रं चेच्चतुर्वेदविशारदम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003169015, "chapter_id": 23169, "verse_number": "४-१०५-१६", "content_sanskrit": "वावदूकं विचारज्ञं सिद्धान्तेषु नितान्तकम् ।\nनृपेन्द्रवचनं श्रुत्वा तमुवाच मुनेः सुतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003169016, "chapter_id": 23169, "verse_number": "४-१०५-१७", "content_sanskrit": "गोतमस्य शतानन्दो वेदवेदाङ्गपारगः ।\nआप्तः प्रवक्ता विज्ञश्च धर्मी कुलपुरोहितः ।\nपृथिव्यां सर्वतत्त्वज्ञो निष्णातः सर्वकर्मसु ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003169017, "chapter_id": 23169, "verse_number": "४-१०५-१८", "content_sanskrit": "शतानन्द उवाच ।\nराजेन्द्र त्वं च धर्मज्ञो धर्मशास्त्रविशारदः ।\nपृर्वाख्यानं च वेदोक्तं कथयामि निशामय ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003169018, "chapter_id": 23169, "verse_number": "४-१०५-१९", "content_sanskrit": "भुवो भारावतरणे स्वयं नारायणो भुवि ।\nवसुदेवसुतः श्रीमान्परिबूर्णतमः प्रभुः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003169019, "chapter_id": 23169, "verse_number": "४-१०५-२०", "content_sanskrit": "विधातुश्च विधाता च ब्रह्मेशशेषवन्दितः ।\nज्योतिःस्वरूपः परमो भक्तानुग्रहविग्रहः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003169020, "chapter_id": 23169, "verse_number": "४-१०५-२१", "content_sanskrit": "परमात्मा च सर्वेषां प्राणिनां प्रकृतेः परः ।\nनिर्लिप्तश्च निरीहप्तश्च साक्षी च सर्वकर्मणाम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003169021, "chapter_id": 23169, "verse_number": "४-१०५-२२", "content_sanskrit": "राजेन्द्र तस्मै कन्यां च परिपूर्णतमाय च ।\nदत्त्वा यास्यसि गोलोकं पितॄणां शतकैः सह ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003169022, "chapter_id": 23169, "verse_number": "४-१०५-२३", "content_sanskrit": "लभ सारूप्यमुक्तिं च कन्या दत्त्वां परत्र च ।\nइहैव सर्वपूज्यश्च भव विश्वगुरोर्गुरुः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003169023, "chapter_id": 23169, "verse_number": "४-१०५-२४", "content_sanskrit": "सर्वस्वं दक्षिणां दत्त्वा महालक्ष्मीं च रुक्मिणीम् ।\nसमर्पणं कुरुविभो कुरुष्व जन्मखण्डनम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003169024, "chapter_id": 23169, "verse_number": "४-१०५-२५", "content_sanskrit": "विधाता निखितो राजन्संबन्धः सर्वसंमतः ।\nद्वारकानगरे कृष्णं शीघ्रं प्रस्थापय द्विजम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003169025, "chapter_id": 23169, "verse_number": "४-१०५-२६", "content_sanskrit": "कृत्वा शुभक्षणं तूर्ण सर्वेषामपि संमतम् ।\nआनीय परमात्मानं भक्तानुग्रहविग्रहम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003169026, "chapter_id": 23169, "verse_number": "४-१०५-२७", "content_sanskrit": "ध्यानानुरोधहेतुं च नित्यदेहमनुत्तमम् ।\nदृष्टिमात्रात्कुरु नृप स्वजन्मकर्मखण्डनम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003169027, "chapter_id": 23169, "verse_number": "४-१०५-२८", "content_sanskrit": "यं न जानन्ति चत्वारो वेदाः संतश्च देवताः ।\nसिद्धेन्द्राश्च मुनीन्द्राश्च देवा ब्रह्मादयस्तथा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003169028, "chapter_id": 23169, "verse_number": "४-१०५-२९", "content_sanskrit": "ध्यायन्ते ध्यानपूताश्च योगिनो न विदन्ति यम् ।\nसरस्वती जडीभूता वेदाः शास्त्राणियानि च ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003169029, "chapter_id": 23169, "verse_number": "४-१०५-३०", "content_sanskrit": "सहस्रवक्त्रः शेषश्च पञ्चवक्त्रः सदाशिवः ।\nचतुर्मुखो जगद्धाता कुमारः कार्तिकस्तथा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003169030, "chapter_id": 23169, "verse_number": "४-१०५-३१", "content_sanskrit": "ऋषयो मुनयश्चैव भक्ताः परमवैष्णवाः ।\nअक्षमाः स्तवने यस्य ध्यानासाध्यश्च योगिनाम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003169031, "chapter_id": 23169, "verse_number": "४-१०५-३२", "content_sanskrit": "बालकोऽहं महाराज तद्गुणं कथयामि किम् ।\nशतानन्दवचः श्रुत्वा प्रफुल्लवदनो नृपः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003169032, "chapter_id": 23169, "verse_number": "४-१०५-३३", "content_sanskrit": "आनिङ्गनं ददौ तस्मै समुत्थाय जवेन च ।\nनानारत्नं मुवर्ण च वस्त्रं च रत्नभूषणम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003169033, "chapter_id": 23169, "verse_number": "४-१०५-३४", "content_sanskrit": "ददौ तस्मै प्रदानं च प्रसादसुमुखो नृपः ।\nगजेन्द्र तुरगं श्रेष्ठं रथं च मणिनिर्मितम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003169034, "chapter_id": 23169, "verse_number": "४-१०५-३५", "content_sanskrit": "रत्नसिहासनं रम्यं धनं च विपुलं तथा ।\nभूमिं च सर्वसस्याढ्यां शश्वद्वृष्टिकरीं शुभाम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003169035, "chapter_id": 23169, "verse_number": "४-१०५-३६", "content_sanskrit": "अकृष्टसाध्यां पूज्यां च ग्रामं सर्वप्रशंसितम् ।\nएतस्मिन्नन्तरे रुक्मिश्चुकोप नृपनन्दनः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003169036, "chapter_id": 23169, "verse_number": "४-१०५-३७", "content_sanskrit": "कम्पितोऽधर्मयुक्तश्च रक्तास्यो रक्तलोचनः ।\nउवाच पितरं व्रिप्रं सभायामस्थिरस्तदा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003169037, "chapter_id": 23169, "verse_number": "४-१०५-३८", "content_sanskrit": "उत्याय तिष्ठन्पुरतः सर्वेषां च सभासदाम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003169038, "chapter_id": 23169, "verse_number": "४-१०५-३९", "content_sanskrit": "रुक्मिरुवाच ।\nश्रृणु राजेन्द्र वचनं हितं तथयं प्रशंसितम् ।\nत्यज वाक्यं भिक्षुकाणां लोभिनां क्रोधिनामहो ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003169039, "chapter_id": 23169, "verse_number": "४-१०५-४०", "content_sanskrit": "नर्तकानां च वैश्यानां भट्टानामर्थिनामपि ।\nकायस्थानां च भिक्षूणामसत्यं वचनं सदा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003169040, "chapter_id": 23169, "verse_number": "४-१०५-४१", "content_sanskrit": "घटकानां नाटकानां स्त्रीलुब्धाना च कामिनाम् ।\nदरिद्राणां च मूर्खाणां स्तुतिपूर्व वचः सदा ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003169041, "chapter_id": 23169, "verse_number": "४-१०५-४२", "content_sanskrit": "निहत्य कालयवनं राजेन्द्रं दूरतो भिया ।\nउवायेन महाबाहो लब्धं कृष्णेन तद्धनम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003169042, "chapter_id": 23169, "verse_number": "४-१०५-४३", "content_sanskrit": "द्वारकाया धनी कृष्णो यवनस्य धनेन च ।\nजरासंधभयेनैव समुद्राभ्यन्तरे गृही ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003169043, "chapter_id": 23169, "verse_number": "४-१०५-४४", "content_sanskrit": "जरासंधशतं चैव क्षणेनैव च लीलया ।\nक्षमोऽहं हन्तुमेकाकी राज्ञश्चान्यस्य का कथा ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003169044, "chapter_id": 23169, "verse_number": "४-१०५-४५", "content_sanskrit": "दुर्वाससश्च शिष्योऽहं रणशास्त्रविशारदः ।\nध्रुवं भीष्मक तेनैव विश्वं संहर्तुमीश्वरः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003169045, "chapter_id": 23169, "verse_number": "४-१०५-४६", "content_sanskrit": "मत्समः पर्शुरामश्च शिशुपालश्च मत्समः ।\nसखा च बलवाञ्छूरः स्वर्गं जेतुं स च क्षमः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003169046, "chapter_id": 23169, "verse_number": "४-१०५-४७", "content_sanskrit": "महेन्द्रं सगणं जेतुमहमीशः क्षणेन च ।\nजित्वा युद्धे जरासंधं दुर्बलं योगिनं नृप ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003169047, "chapter_id": 23169, "verse_number": "४-१०५-४८", "content_sanskrit": "अहंकारयुतः कृष्णो पीरं स्वं मन्यते धिया ।\nयद्यायास्यति मद्ग्रामं विवाहं कर्तुमीप्सितम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003169048, "chapter_id": 23169, "verse_number": "४-१०५-४९", "content_sanskrit": "ध्रुवं प्रस्थापयिष्यामि क्षणेन यममन्दिरम् ।\nअहो नन्दस्य वैश्यस्य तस्मै गोरक्षकाय च ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003169049, "chapter_id": 23169, "verse_number": "४-१०५-५०", "content_sanskrit": "साक्षाज्जाराय गोपीनां गोपालोच्छिष्टभोजिने ।\nकरोषि कन्यास्वीकारं देवयोग्यां च रुक्मिणीम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003169050, "chapter_id": 23169, "verse_number": "४-१०५-५१", "content_sanskrit": "दातुमिच्छसि वाक्येन भिङुकस्य द्विजस्य च ।\nराजेन्द्र बुद्धिहीनोऽसि वचनाद्वद्ग(दुर्ब) लस्य च ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003169051, "chapter_id": 23169, "verse_number": "४-१०५-५२", "content_sanskrit": "मा राजपुत्रो माशूरो म कुलीनश्च मा शुचिः ।\nमा दाता मा धनाढ्यश्च मा योग्यो मा जितेन्द्रियः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003169052, "chapter_id": 23169, "verse_number": "४-१०५-५३", "content_sanskrit": "कन्यां देहि सुपुत्राय शिशुपालाय भूमिप ।\nबलेन रुद्रतुष्टाय राजेन्द्रतनयाय च ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003169053, "chapter_id": 23169, "verse_number": "४-१०५-५४", "content_sanskrit": "निमन्त्रणं कुरु नृप नानादेशभवान्नृपान् ।\nबान्धवांश्च मुनीन्द्रांश्च पत्रद्वारा त्वरान्वितः  ५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003169054, "chapter_id": 23169, "verse_number": "४-१०५-५५", "content_sanskrit": "अङ्गं कलिङ्गं मगधं सौराष्ट्रं वल्कलं वरम् ।\nराटं वरेन्द्रं वङ्गं च गुर्जरटिं च पठेरम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003169055, "chapter_id": 23169, "verse_number": "४-१०५-५६", "content_sanskrit": "महाराष्ट्रं विराटं च मुद्गलं च मुरङ्गकम् ।\nभल्लकं गल्लकं खर्व दुर्गं प्रस्थापय द्विजम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003169056, "chapter_id": 23169, "verse_number": "४-१०५-५७", "content_sanskrit": "घृतकुल्यासहस्रं च मधुकुल्यासहस्रकम् ।\nदधिकुल्यासहस्रं च दुग्धकुल्यासहस्रकम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003169057, "chapter_id": 23169, "verse_number": "४-१०५-५८", "content_sanskrit": "तैलकुल्यापञ्चशतं गुडकुल्याद्विलक्षकम् ।\nशर्कराणां राशिशतं मिष्टान्नानां चतुर्गुणम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003169058, "chapter_id": 23169, "verse_number": "४-१०५-५९", "content_sanskrit": "यवगोधूमचूर्णानां पिष्टराशिशतं शतम् ।\nपृथुकानां राशिलक्षमन्नानां च चतुर्गुणम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003169059, "chapter_id": 23169, "verse_number": "४-१०५-६०", "content_sanskrit": "गवां लक्षं छेदनं च हरिणानां द्विलक्षकम् ।\nचतुर्लक्षं शशानां च कूर्माणां च तथा कुरु ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003169060, "chapter_id": 23169, "verse_number": "४-१०५-६१", "content_sanskrit": "दशलक्षं छागलानां भेटानां तच्चतुर्गुणम् ।\nपर्वणि ग्रामदेव्यै च बलिं देहि च भक्तितः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003169061, "chapter_id": 23169, "verse_number": "४-१०५-६२", "content_sanskrit": "एतेषां पक्वमांसं च भोजनार्थ च कारय ।\nपरिपूर्ण व्यञ्जनानां सामग्रीं कुरु भूमिप ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003169062, "chapter_id": 23169, "verse_number": "४-१०५-६३", "content_sanskrit": "अथ श्रुत्वा च तद्वाक्यं राजेन्द्रः सपुरोहितः ।\nचकार मन्त्रणां तूर्ण निर्जने मन्त्रिणा सह ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003169063, "chapter_id": 23169, "verse_number": "४-१०५-६४", "content_sanskrit": "द्विजं प्रस्थापयामास द्वारकां योग्यमीप्सितम् ।\nकृत्वा च शुभलग्नं च सर्वेषामभिवाञ्छितम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003169064, "chapter_id": 23169, "verse_number": "४-१०५-६५", "content_sanskrit": "राजा संभृतसंभारो बभूव सत्वरं मृदा ।\nनिमन्त्रणं च सर्वत्र चकार च सुताज्ञया ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003169065, "chapter_id": 23169, "verse_number": "४-१०५-६६", "content_sanskrit": "विप्रः सुधर्मां संप्राप्य नृपैर्देवैश्च वेष्टिताम् ।\nप्रददी पत्रिकां भद्रामुग्रसेनाय भूभृते ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003169066, "chapter_id": 23169, "verse_number": "४-१०५-६७", "content_sanskrit": "प्रफुल्लवदनो राजा श्रुत्वा पत्रं सुमङ्गलम् ।\nसुवर्णानां सहस्रं च ब्राह्मणेभ्यो ददौ मुदा ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003169067, "chapter_id": 23169, "verse_number": "४-१०५-६८", "content_sanskrit": "दुंदुभिं वादयामास द्वारकायां च सर्वतः ।\nदेवान्मुनीन्नृपांश्चैव ज्ञातिवर्गाश्च बान्धवान् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003169068, "chapter_id": 23169, "verse_number": "४-१०५-६९", "content_sanskrit": "भट्टांश्च भिक्षुकांश्चैव भोजयामास सादरम् ।\nश्रीकृष्णस्य सृवेषं च कारयामास भूपतिः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003169069, "chapter_id": 23169, "verse_number": "४-१०५-७०", "content_sanskrit": "अतीव रम्यमतुलं त्रेषु लोकेषु दुल्रभम् ।\nयात्रां च कारयामास जगतां प्रवरं वरम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003169070, "chapter_id": 23169, "verse_number": "४-१०५-७१", "content_sanskrit": "वेदमन्त्रेण रम्येण माहेन्द्रे सुमनोहरे ।\nआदौ ब्रह्मा रथस्थश्च सावित्र्या सहितो ययौ ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003169071, "chapter_id": 23169, "verse_number": "४-१०५-७२", "content_sanskrit": "रथस्यश्च महाहृष्टो भवान्या च भवः स्वयम् ।\nशेषश्चापि दिनेशश्च गणेशश्चापि कार्तिकः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003169072, "chapter_id": 23169, "verse_number": "४-१०५-७३", "content_sanskrit": "महेन्द्रश्चतथा चन्द्रो वरुणः पवनस्तथा ।\nकुबेरश्च यमो वह्निरीशानोऽपि ययौ मुदा ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003169073, "chapter_id": 23169, "verse_number": "४-१०५-७४", "content_sanskrit": "देवानां च त्रिकोट्यश्च मुनीनां षष्टिकोटयः ।\nराजेन्द्राणां त्रिलक्षं च श्वेतच्छत्रं त्रिलक्षकम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003169074, "chapter_id": 23169, "verse_number": "४-१०५-७५", "content_sanskrit": "उग्रसेनो बभौ राजा नक्षत्रेषु यथा शशी ।\nययौ प्रसन्नवदनः कुण्डिनाभिमुखो बली ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003169075, "chapter_id": 23169, "verse_number": "४-१०५-७६", "content_sanskrit": "रत्ननिर्माणयानेन बलदेवो महाबलः ।\nवसुदेवश्चोद्धवश्च नन्दोऽक्रूरश्च सात्यकिः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003169076, "chapter_id": 23169, "verse_number": "४-१०५-७७", "content_sanskrit": "गोपाला यादवेन्द्राश्च चन्द्रवंश्याश्च ते ययुः ।\nधृतराष्ट्रसुताः सर्वे दुर्योधनपुलोगमाः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003169077, "chapter_id": 23169, "verse_number": "४-१०५-७८", "content_sanskrit": "युधिष्ठिरस्तथा भीमः फाल्गुनो नकुलस्तथा ।\nसहदेवश्च यानैश्च प्रययुः पञ्च पाण्डवाः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003169078, "chapter_id": 23169, "verse_number": "४-१०५-७९", "content_sanskrit": "भीष्मो द्रोणश्च कर्णश्चाप्यश्वत्थामा महाबलः ।\nकृपाचार्यश्च शकुनिः शल्यश्चप्रययौ मुदा ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003169079, "chapter_id": 23169, "verse_number": "४-१०५-८०", "content_sanskrit": "भटानां च त्रिकोट्यश्च विप्राणां शतकोटयः ।\nसंन्यासिनां सहस्रं च यतीनां ब्रह्मचारिणाम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003169080, "chapter_id": 23169, "verse_number": "४-१०५-८१", "content_sanskrit": "द्विसहस्रं जितक्रोधाश्चावधूतास्तथैव च ।\nउत्पलानां सहस्रं च सहस्रं पुष्पकारिणाम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003169081, "chapter_id": 23169, "verse_number": "४-१०५-८२", "content_sanskrit": "नानाशिर्पकराश्चैव विचित्रं चित्रमेव च ।\nलक्षं च वाद्यभाण्डानां नर्तकानां च लक्षकम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003169082, "chapter_id": 23169, "verse_number": "४-१०५-८३", "content_sanskrit": "गन्धर्वाणां गायकानां लक्षमेव तु नारद ।\nतत्र कल्पे भक्त्येव गन्धर्वश्चोपबर्हणः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003169083, "chapter_id": 23169, "verse_number": "४-१०५-८४", "content_sanskrit": "पञ्चाशत्कामिनीभिश्च त्वमेव तेषु मध्यगः ।\nविद्याधरीणां लक्षं च लक्षमप्सरसां तथा ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003169084, "chapter_id": 23169, "verse_number": "४-१०५-८५", "content_sanskrit": "किन्नराणां त्रिलक्षं चगन्धर्वाणां त्रिलक्षकम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}]