[{"id": 2022048, "chapter_id": 1459, "verse_number": "३-९७-०x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2022049, "chapter_id": 1459, "verse_number": "३-९७-१", "content_sanskrit": "इल्वलस्तान्विदित्वा तु महर्षिसहितान्नृपान्।\nउपस्थितान्सहामात्यो विषयान्ते ह्यपूजयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2022050, "chapter_id": 1459, "verse_number": "३-९७-२", "content_sanskrit": "तेषां ततोऽसुरश्रेष्ठस्त्वातिथ्यमकरोत्तदा।\nसुसंस्कृतेन कौरव्य भ्रात्रा वातापिना तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2022051, "chapter_id": 1459, "verse_number": "३-९७-३", "content_sanskrit": "ततो राजर्षयः सर्वे विषण्णा गतचेतसः।\nवातापिं संस्कृतं दृष्ट्वा मेषभूतं महासुरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2022052, "chapter_id": 1459, "verse_number": "३-९७-४", "content_sanskrit": "अथाब्रवीदगस्त्यस्तान्राजर्षीनृषिसत्तमः।\nविषादो वो न कर्तव्यो ह्यहं भोक्ष्ये महासुरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2022053, "chapter_id": 1459, "verse_number": "३-९७-५", "content_sanskrit": "धुर्यासनमथासाद्य निषसाद महानृषिः।\nतं पर्यवेषद्दैत्येन्द्र इल्वलः प्रहसन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2022054, "chapter_id": 1459, "verse_number": "३-९७-६", "content_sanskrit": "अगस्त्य एव कृत्स्नं तु वातापिं बुभुजे ततः।\n`बह्वन्नाशापि ते मेऽस्तीत्यवदद्भक्षयन्स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2022055, "chapter_id": 1459, "verse_number": "३-९७-७", "content_sanskrit": "भुक्तवत्यसुरोऽह्वानमकरोत्तस्य चेल्वलः।\n`वातापे प्रतिबुध्यस्व दर्शयन्बलतेजसी।\nतपसा दुर्जयो यावदेष त्वां नातिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2022056, "chapter_id": 1459, "verse_number": "३-९७-८", "content_sanskrit": "ततस्तस्योदरं भेत्तुं वातापिर्वेगमाहरत्।\nतमबुध्यत तेजस्वी कुम्भयोनिर्महातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2022057, "chapter_id": 1459, "verse_number": "३-९७-९", "content_sanskrit": "स वीर्यात्तपसोग्रस्तु ननर्द भगवानृषिः।\nएष जीर्णोसि वातापे मया लोकस्य शान्तये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2022058, "chapter_id": 1459, "verse_number": "३-९७-१०", "content_sanskrit": "इत्युक्त्वा स्वकराग्रेण उदरं समताडयत्।\nत्रिरेवं प्रतिसंरब्धस्तेजसा प्रज्वलन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2022059, "chapter_id": 1459, "verse_number": "३-९७-११", "content_sanskrit": "ततो वायुः प्रादुरभूदधस्तस्य महात्मनः।\nशब्देन महता तात गर्जन्निव यथा घनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2022060, "chapter_id": 1459, "verse_number": "३-९७-१२", "content_sanskrit": "वातापे निष्क्रमस्वेति पुनः पुनरुवाच ह।\nतं प्रहस्याब्रवीद्राजन्नगस्त्यो मुनिसत्तमः।\nकुतो निष्क्रमितुं शक्तो मया जीर्णस्तु सोसुरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2022061, "chapter_id": 1459, "verse_number": "३-९७-१३", "content_sanskrit": "इल्वलस्तु विषण्णोऽभूद्दृष्ट्वा जीर्णं महासुरम्।\nप्राञ्जलिश्च सहामात्यैरिदं वचनमब्रवीत्।\nकिमर्थमुपयाताः स्थ ब्रूत किं करवाणि वः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2022062, "chapter_id": 1459, "verse_number": "३-९७-१४", "content_sanskrit": "प्रत्युवाच ततोऽगस्त्यः प्रहसन्निल्वलं तदा।\nईशोस्यसुर विद्मस्त्वां वयं सर्वे धनेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2022063, "chapter_id": 1459, "verse_number": "३-९७-१५", "content_sanskrit": "एते च नातिधनिनो धनाशा महती मम।\nयथाशक्त्यविहिंस्यान्यान्संविभागं प्रयच्छ नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2022064, "chapter_id": 1459, "verse_number": "३-९७-१६", "content_sanskrit": "ततोऽवमत्य तमृषिमिल्वलो वाक्यमब्रवीत्।\nदित्सितं यदि वेत्सि त्वंततो दास्यामि ते वसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2022065, "chapter_id": 1459, "verse_number": "३-९७-१७x", "content_sanskrit": "अगस्त्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2022066, "chapter_id": 1459, "verse_number": "३-९७-१७", "content_sanskrit": "गवां दशसहस्राणि राज्ञामेकैकशोऽसुर।\nतावदेव सुवर्णस्य दित्सितं ते महासुर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2022067, "chapter_id": 1459, "verse_number": "३-९७-१८", "content_sanskrit": "मह्यं ततो वै द्विगुणं रथश्चैव हिरण्मयः।\nमनोजवौ वाजिनौ च दित्सितं ते महासुर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2022068, "chapter_id": 1459, "verse_number": "३-९७-१९x", "content_sanskrit": "`लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2022069, "chapter_id": 1459, "verse_number": "३-९७-१९", "content_sanskrit": "उल्वलस्तु मुनिं प्राह सर्वमस्ति यथाऽऽत्थ माम्।\nसर्वमेतत्प्रदास्यामि हिरण्यं गाश्च यद्धनम्।\nरथं तु यदवोचो मां नैतं विद्म हिरण्मयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2022070, "chapter_id": 1459, "verse_number": "३-९७-२०x", "content_sanskrit": "आगस्त्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2022071, "chapter_id": 1459, "verse_number": "३-९७-२०", "content_sanskrit": "न मे वागनृता काचिदुक्तपूर्वा महाऽसुर।\nविज्ञायतां रथः साधु व्यक्तमस्ति हिरण्मयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2022072, "chapter_id": 1459, "verse_number": "३-९७-२१x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2022073, "chapter_id": 1459, "verse_number": "३-९७-२१", "content_sanskrit": "विज्ञायमानः स रथः कौन्तेयासीद्धिरण्मयः।\nततः प्रव्यथितो दैत्यो ददावभ्यधिकं वसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2022074, "chapter_id": 1459, "verse_number": "३-९७-२२", "content_sanskrit": "विवाजी च सुवाजी च तस्मिन्युक्तौ रथे हयौ।\nऊहतुः स वसूनाशु तावगस्त्याश्रमं प्रति।\nसर्वान्राज्ञः सहागस्त्यान्निमेषादिव भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2022075, "chapter_id": 1459, "verse_number": "३-९७-२३", "content_sanskrit": "`इल्वलस्त्वनुगम्यैनमगस्त्यं हन्तुमैच्छत।\nभस्म चक्रे महातेजा हुङ्कारेण महाऽसुरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2022076, "chapter_id": 1459, "verse_number": "३-९७-२४", "content_sanskrit": "अगस्त्येनाभ्यनुज्ञाता जग्मू राजर्षयस्तदा।\nकृतवांश् मुनिः सर्वं लोपामुद्राचिकीर्षितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2022077, "chapter_id": 1459, "verse_number": "३-९७-२५x", "content_sanskrit": "लोपामुद्रोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2022078, "chapter_id": 1459, "verse_number": "३-९७-२५", "content_sanskrit": "कृतवानसि तत्सर्वं भगवन्मम काङ्क्षितम्।\nउत्पादय सकृन्मह्यमपत्यं वीर्यवत्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2022079, "chapter_id": 1459, "verse_number": "३-९७-२६x", "content_sanskrit": "अगस्त्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2022080, "chapter_id": 1459, "verse_number": "३-९७-२६", "content_sanskrit": "तुष्टोऽहमस्मि कल्याणि तव वृत्तेन शोभने।\nविचारणामपत्ये तु तव वक्ष्यामि तां शृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2022081, "chapter_id": 1459, "verse_number": "३-९७-२७", "content_sanskrit": "सहस्रं तेऽस्तु पुत्राणआं शतं वा तत्समं तव।\nदश वा शततुल्याः स्युरेको वाऽपि सहस्रजित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2022082, "chapter_id": 1459, "verse_number": "३-९७-२८x", "content_sanskrit": "लोपामुद्रोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2022083, "chapter_id": 1459, "verse_number": "३-९७-२८", "content_sanskrit": "सहस्रसंमितः पुत्र एकोप्यस्तु तपोधन।\nएको हि बहुभिः श्रेयान्विद्वान्साधुरसाधुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2022084, "chapter_id": 1459, "verse_number": "३-९७-२९", "content_sanskrit": "स तथेति प्रतिज्ञाय तया समगमन्मुनिः।\nसमये समशीलिन्या श्रद्धावान्श्रद्दधानया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2022085, "chapter_id": 1459, "verse_number": "३-९७-३०", "content_sanskrit": "तत आधाय गर्भं तमगमद्वनमेव सः।\nतस्मिन्वनगते गर्भो ववृधे सप्त शारदान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2022086, "chapter_id": 1459, "verse_number": "३-९७-३१", "content_sanskrit": "सप्तमेऽब्दे गते चापि प्राच्यवत्स महाकविः।\nज्वलन्निव प्रभावेन दृढस्युर्नाम भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2022087, "chapter_id": 1459, "verse_number": "३-९७-३२", "content_sanskrit": "साङ्गोपनिषदान्वेदाञ्जपन्नेव महातपाः।\nतस्य पुत्रोऽभवदृषेः स तेजस्वी महानृषिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2022088, "chapter_id": 1459, "verse_number": "३-९७-३३", "content_sanskrit": "स बाल एवतेजस्वी पितुस्तस्य निवेशने।\nइध्मानां भारमाजह्रे इध्मवाहस्ततोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2022089, "chapter_id": 1459, "verse_number": "३-९७-३४", "content_sanskrit": "तथायुक्तं तु तं दृष्ट्वा मुमुदे स मुनिस्तदा।\nएवं स जनयामास भारतापत्यमुत्तमम्।\nलेभिरे पितरश्चास्य लोकान्राजन्यथेप्सितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2022090, "chapter_id": 1459, "verse_number": "३-९७-३५", "content_sanskrit": "अगस्त्यस्याश्रमश्चायमत ऊर्ध्वं विशांपते।\nख्यातो भुवि महाराज तेजसा तस्य धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2022091, "chapter_id": 1459, "verse_number": "३-९७-३६", "content_sanskrit": "प्राह्लादिरेवं वातापिर्ब्रह्मघ्नो दुष्टचेतनः।\nएवं विनाशितो राजन्नगस्त्येन महात्मना।\nतस्यायमाश्रमो राजन्रमणीयैर्गुणैर्युतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2022092, "chapter_id": 1459, "verse_number": "३-९७-३७", "content_sanskrit": "एषा भागीरथी पुण्या देवगन्धर्वसेविता।\nवातेरिता पताकेव विराजति नभस्तले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2022093, "chapter_id": 1459, "verse_number": "३-९७-३८", "content_sanskrit": "प्रतार्यमाणा कूटेषु यथा निम्नेषु नित्यशः।\nशिलातलेषु संत्रस्ता पन्नगेन्द्रवधूरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2022094, "chapter_id": 1459, "verse_number": "", "content_sanskrit": "दक्षिणां वै दिशं सर्वां प्लावयन्ती च मातृवत्।\nपूर्वं शंभोर्जटाभ्रष्टा समुद्रमहिषी प्रिया।\nअस्यां नद्यां मुपुण्यायां यथेष्टमवगाह्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]