[{"id": 7002842000, "chapter_id": 22842, "verse_number": "९-१२७-१", "content_sanskrit": "युधिष्ठिर उवाच ।\nतडागोत्सर्जने देव विधिं विधिविदां वर ।\nकथयस्व महाभाग मम देवकिनंदन ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002842001, "chapter_id": 22842, "verse_number": "९-१२७-२", "content_sanskrit": "वापीकूपोदकानाञ्च के मंत्राः परिकीर्तिताः ।\nके ऋत्विजोत्र के यूपाः कर्तव्याः कुण्डमण्डपे ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002842002, "chapter_id": 22842, "verse_number": "९-१२७-३", "content_sanskrit": "दानं किमत्र निर्दिष्टं बलयः के प्रकीर्तिताः ।\nकस्मिन्काले कथं कुर्यादित्येतत्सकलं वद ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002842003, "chapter_id": 22842, "verse_number": "९-१२७-४", "content_sanskrit": "श्रीकृष्ण उवाच ।\nसाधुसाधु महाबाहो यन्मां त्वं परिपृच्छसि ।\nतडागवापीकूपानामुत्सर्गं कथयामि ते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002842004, "chapter_id": 22842, "verse_number": "९-१२७-५", "content_sanskrit": "निष्पन्ने बद्धपालीके सर्वोद्भेदविवर्जिते ।\nसोपानपंक्तिसहिते पाषाणैः सर्वतश्चिते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002842005, "chapter_id": 22842, "verse_number": "९-१२७-६", "content_sanskrit": "तस्मिन्सलिलसंपूर्णे कार्तिके वा विशेषतः ।\nतडागस्य विधिः कार्यः स्थिरनक्षत्रयोगतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002842006, "chapter_id": 22842, "verse_number": "९-१२७-७", "content_sanskrit": "मुनयः केचिदिच्छंति व्यतीते चोत्तरायणे ।\nन कालनियमो ह्यत्र प्रमाणं सलिलं यतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002842007, "chapter_id": 22842, "verse_number": "९-१२७-८", "content_sanskrit": "तडागपालशीर्षे तु मंडलं कारयेच्छुभम् ।\nदशद्वादशहस्तं च चतुर्द्वारं सुविस्तृतम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002842008, "chapter_id": 22842, "verse_number": "९-१२७-९", "content_sanskrit": "तोरणानि तु चत्वारि चतुर्दिक्षु विचक्षणैः ।\nअश्वत्थोदुंबरप्लक्षवटशाखामयानि च ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002842009, "chapter_id": 22842, "verse_number": "९-१२७-१०", "content_sanskrit": "नानावर्णास्तु परितः पताकाः परिकल्पयेत् ।\nमध्ये महाध्वजः कार्यः पञ्चवर्णः सुशोभनः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002842010, "chapter_id": 22842, "verse_number": "९-१२७-११", "content_sanskrit": "चतुर्हस्ता भवेद्वेदी मध्ये पञ्चकराथ वा ।\nयजमानप्रमाणेन मध्ये यूपेन शोभिता ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002842011, "chapter_id": 22842, "verse_number": "९-१२७-१२", "content_sanskrit": "कदंबाश्वत्थपालाशवैकंकतमयः शुभः ।\nब्राह्मणस्यास्य निर्दिष्टो यूपः श्रुतिविचक्षणैः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002842012, "chapter_id": 22842, "verse_number": "९-१२७-१३", "content_sanskrit": "न्यग्रोधबिल्वजः प्रोक्तः क्षत्रियाणां च खादिरः ।\nवैश्यस्योदुंबरमयो मध्वर्जुनसमुद्भवः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002842013, "chapter_id": 22842, "verse_number": "९-१२७-१४", "content_sanskrit": "बिभीतकोदुंबरजः शाकशाल्मलिसंभवः ।\nशूद्रस्य यूपो निर्दिष्टः सारदारुमयोऽथ वा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002842014, "chapter_id": 22842, "verse_number": "९-१२७-१५", "content_sanskrit": "लोकपालाष्टकं तत्र रजसा च विलेखयेत् ।\nब्रह्माविष्णुश्च रुद्रश्च कमला चाम्बिका तथा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002842015, "chapter_id": 22842, "verse_number": "९-१२७-१६", "content_sanskrit": "सावित्री सहिता कार्या पुष्पधूपैरथार्चयेत् ।\nकुर्यात्कुंडानि चत्वारि चतुर्दिक्षु विचक्षणः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002842016, "chapter_id": 22842, "verse_number": "९-१२७-१७", "content_sanskrit": "मेखलात्रययुक्तानि हस्तमात्राणि सर्वतः ।\nहेमालंकारिणः कार्या होतारः षोडशाष्ट वा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002842017, "chapter_id": 22842, "verse_number": "९-१२७-१८", "content_sanskrit": "अहतांबरसंवीताः स्रक्चन्दनविभूषिताः ।\nस्थापकाश्चात्र विहिता वेदवेदाङ्गपारगाः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002842018, "chapter_id": 22842, "verse_number": "९-१२७-१९", "content_sanskrit": "इतिहासपुराणज्ञाः प्रियवाचोऽनसूयकाः ।\nमृन्मयानि च पात्राणि ताम्राणि स्रुक्स्रुवं तथा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002842019, "chapter_id": 22842, "verse_number": "९-१२७-२०", "content_sanskrit": "व्यंजनानि च कार्याणि होमार्थं समिधस्तिलाः ।\nग्रहयज्ञविधानेन होमः कार्यो विजानता ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002842020, "chapter_id": 22842, "verse_number": "९-१२७-२१", "content_sanskrit": "वेद्याधिवासितानां च सुराणां होम इष्यते ।\nवारुणैस्तु तथा मंत्रैर्होतव्यं पुष्टिवर्द्धनम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002842021, "chapter_id": 22842, "verse_number": "९-१२७-२२", "content_sanskrit": "इन्द्रादिलोकपालानां पूर्वादिक्रमयोगतः ।\nबलिं दद्याच्च तल्लिङ्गैर्मन्त्रैस्सर्वार्थसिद्धये ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002842022, "chapter_id": 22842, "verse_number": "९-१२७-२३", "content_sanskrit": "द्वारेषु कलशान्दद्यात्सहिरण्यान्सपल्लवान् ।\nअश्वत्थपल्लवैः कार्याः शुभाश्चन्दनमालिकाः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002842023, "chapter_id": 22842, "verse_number": "९-१२७-२४", "content_sanskrit": "सौवर्णं कारयेत्कूर्मं ताम्रेण मकरं तथा ।\nरजतेन तथा मत्स्यं त्रपुणा दर्दुरं तथा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002842024, "chapter_id": 22842, "verse_number": "९-१२७-२५", "content_sanskrit": "शिशुमारजलौकाञ्च रजतेनैव कारयेत् ।\nसर्वानपि यथास्थानं ताम्रपात्र्यां निधापयेत् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002842025, "chapter_id": 22842, "verse_number": "९-१२७-२६", "content_sanskrit": "एषा प्रतिष्ठा नामेति मन्त्रेणामंत्रयेच्च तान् ।\nयूपप्रतिष्ठा कर्तव्या वेदोक्तविधिना ततः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002842026, "chapter_id": 22842, "verse_number": "९-१२७-२७", "content_sanskrit": "कुंकुमेन समालभ्य पुष्पैर्धूपैः समर्चयेत् ।\nवस्त्रयुग्मेन संपूज्य नैवेद्यादि यथाक्रमम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002842027, "chapter_id": 22842, "verse_number": "९-१२७-२८", "content_sanskrit": "ततो द्विजातिप्रवरः श्रपयित्वा चरुं नवम् ।\nततश्चाग्न्याहुतीर्दद्याद्भूर्भुवःस्वरिति क्रमात् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002842028, "chapter_id": 22842, "verse_number": "९-१२७-२९", "content_sanskrit": "ततश्चावाहयेद्देवं वरुणं सरितां पतिम् ।\nवादित्रघोषैगीतैश्च गन्धमाल्यानुलेपनैः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002842029, "chapter_id": 22842, "verse_number": "९-१२७-३०", "content_sanskrit": "श्वेतेनैव तु वस्त्रेण शिरोवेष्टं तु कारयेत् ।\nआदाय ताम्रपात्रीं तु ब्रह्मघोषपुरःसरः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002842030, "chapter_id": 22842, "verse_number": "९-१२७-३१", "content_sanskrit": "अप्रमाणं जलं गत्वा वरुणाय निवेदयेत् ।\nत्वं वरुण इति मंत्रेण जल मध्ये प्रवाहयेत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002842031, "chapter_id": 22842, "verse_number": "९-१२७-३२", "content_sanskrit": "यच्चान्यद्वस्त्रबीजानि तत्सर्वं मज्जयेज्जले ।\nतारयेच्च ततो धेनुं दक्षिणाया उदग्व्रजेत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002842032, "chapter_id": 22842, "verse_number": "९-१२७-३३", "content_sanskrit": "गोशिरोवेष्टनं कुर्यात्सति वस्त्रे तु बुद्धिमान् ।\nलांगलस्याग्रमादाय अवतीर्य ततो जलम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002842033, "chapter_id": 22842, "verse_number": "९-१२७-३४", "content_sanskrit": "ज्ञातिभिः सहितः कर्ता सभार्यश्चावगाहयेत् ।\nततोऽवतीर्य सलिलाद्दत्त्वा गां ब्राह्मणाय ताम् ।\nशक्त्या च दक्षिणां दद्यादेवं विप्रान्विसर्जयेत् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002842034, "chapter_id": 22842, "verse_number": "९-१२७-३५", "content_sanskrit": "सामान्यं सर्वभूतेभ्यो मया दत्तमिदं जलम् ।\nएवं जलाञ्जलिं क्षिप्त्वा पूजयेज्जलमातरः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002842035, "chapter_id": 22842, "verse_number": "९-१२७-३६", "content_sanskrit": "तोष्याः कर्मकराः सर्वे कुद्दालानि च पूजयेत् ।\nअवारितं तु दातव्यं मन्त्रपूर्वं दिनत्रयम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002842036, "chapter_id": 22842, "verse_number": "९-१२७-३७", "content_sanskrit": "एकाहं च यथाशक्त्या वित्तशाठ्यं न कारयेत् ।\nगोसहस्रं तदर्धं वा तस्यार्धमथवापि वा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002842037, "chapter_id": 22842, "verse_number": "९-१२७-३८", "content_sanskrit": "शतमर्धशतं वापि पञ्चविंशतिमेव च ।\nतासामभावे गां दद्यात्सवत्सां कांस्यदोहनाम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002842038, "chapter_id": 22842, "verse_number": "९-१२७-३९", "content_sanskrit": "एष राजंस्तडागस्य विधिस्ते परिकीर्तितः ।\nवापीकूपविधानं च कथयामि तथा परम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002842039, "chapter_id": 22842, "verse_number": "९-१२७-४०", "content_sanskrit": "कुण्डमण्डपसंभारभूषणाच्छादनादिकम् ।\nतडागविधिवत्कुर्याद्यूपगोतरणादिकम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002842040, "chapter_id": 22842, "verse_number": "९-१२७-४१", "content_sanskrit": "अकालमूलान्कलशान्वापीकोणेषु दापयेत् ।\nतीर्थोदकसमायुक्तान्सितचन्दनचर्चितान् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002842041, "chapter_id": 22842, "verse_number": "९-१२७-४२", "content_sanskrit": "सितवासोयुगच्छन्नान्समाल्यान्रत्नगर्भिणः ।\nश्रपयित्वा चरुं तत्र यावन्मात्रो यथाविधि ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002842042, "chapter_id": 22842, "verse_number": "९-१२७-४३", "content_sanskrit": "चतस्र आहुतीर्दद्याद्भूर्भुवः स्वरिति क्रमात् ।\nग्रहहोमं प्रकुर्वीत शांतिपुष्टिविवर्द्धनम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002842043, "chapter_id": 22842, "verse_number": "९-१२७-४४", "content_sanskrit": "वरुणाय बलिं दद्याल्लोकपालेभ्य एव च ।\nवारुणानि च सूक्तानि पठेयुर्द्धिजसत्तमाः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002842044, "chapter_id": 22842, "verse_number": "९-१२७-४५", "content_sanskrit": "वेदीमध्ये मंडलं च पद्ममत्र प्रशस्यते ।\nतन्मध्ये पूजये च्छंभुं ब्रह्माणं केशवं तथा ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002842045, "chapter_id": 22842, "verse_number": "९-१२७-४६", "content_sanskrit": "मत्स्यकमठमण्डूकान्वेद्या मध्येऽधिवासयेत् ।\nमित्रमित्रोऽसि भूतानां धनदो धनकांक्षिणाम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002842046, "chapter_id": 22842, "verse_number": "९-१२७-४७", "content_sanskrit": "वैद्यो रोगाभिभूतानां शरण्यः शरणार्थिनाम् ।\nअनेनैव हि मंत्रेण वरुणाय विसर्जयेत् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002842047, "chapter_id": 22842, "verse_number": "९-१२७-४८", "content_sanskrit": "आदौ चावाहयेद्देवमनेनैव विशेषतः ।\nनमस्ते विश्वगुप्ताय नमो विष्णो अपांपते ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002842048, "chapter_id": 22842, "verse_number": "९-१२७-४९", "content_sanskrit": "सान्निध्यं कुरु देवेश समुद्रे यद्वदत्र वै ।\nततस्तु दक्षिणा देया ब्राह्मणानां नराधिप ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002842049, "chapter_id": 22842, "verse_number": "९-१२७-५०", "content_sanskrit": "गौः स्थापकाय दातव्या भोजनं चानिवारितम् ।\nसर्वेषामेव दातव्यमेष पौराणिको विधिः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002842050, "chapter_id": 22842, "verse_number": "९-१२७-५१", "content_sanskrit": "शराया आगतं तोयं सामुद्रं प्रथमं स्मृतम् ।\nनिपाने वा तडागे वा संस्थितं तद्भवेच्छुचि ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002842051, "chapter_id": 22842, "verse_number": "९-१२७-५२", "content_sanskrit": "वापीकूपतडागे वा स्थितं तु प्रथमं जलम् ।\nअपेयं तु भवेत्सर्वं तज्जलं सूतिकासमम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002842052, "chapter_id": 22842, "verse_number": "९-१२७-५३", "content_sanskrit": "समुद्रोऽपि हि कौंतेय देवयोनिरपांपतिः ।\nकुशाग्रेणापि रभसा न स्पृष्टव्यस्त्वसंस्कृतः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002842053, "chapter_id": 22842, "verse_number": "९-१२७-५४", "content_sanskrit": "अग्निश्च तेजो मृडयाथ देहे रेतोधा विष्णुरमृतस्य नाभिः ।\nएवं ब्रुवन्पांडव सत्यवाक्यं ततोवगाहेत पतिं नदीनाम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002842054, "chapter_id": 22842, "verse_number": "९-१२७-५५", "content_sanskrit": "वैष्णवे मासि संप्राप्ते नक्षत्रे वारुणे तथा ।\nअर्घ्यं प्रदद्याद्भक्त्या तु तस्मिन्काले महोदधेः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002842055, "chapter_id": 22842, "verse_number": "९-१२७-५६", "content_sanskrit": "स्नात्वा तु विधिवन्मंत्रैः सागरे तु समाहितः ।\nफलमूलाक्षतैर्भक्ष्यैस्तथार्घ्यं संप्रकल्पयेत् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002842056, "chapter_id": 22842, "verse_number": "९-१२७-५७", "content_sanskrit": "अपि जन्मसहस्रं तु यत्पापं कुरुते नरः ।\nमुच्यते सर्वपापेभ्यः स्नात्वा तु लवणांभसि ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002842057, "chapter_id": 22842, "verse_number": "९-१२७-५८", "content_sanskrit": "विधिज्ञेन तु कर्तव्यं ब्राह्मणेन यथाविधि ।\nकर्ता कारयिता चैव उभौ तु स्वर्गगामिनौ ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002842058, "chapter_id": 22842, "verse_number": "९-१२७-५९", "content_sanskrit": "विधिं त्वेनमजानानो यः कुर्यादर्थमोहितः ।\nकर्ता कारयिता चैव उभौ नरकगामिनौ ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002842059, "chapter_id": 22842, "verse_number": "९-१२७-६०", "content_sanskrit": "यो न कारयते शांतिं तडागाद्येषु कर्मसु ।\nतस्य तन्निष्फलं सर्वमुप्तं बीजमिवोषरे ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002842060, "chapter_id": 22842, "verse_number": "९-१२७-६१", "content_sanskrit": "सर्वरत्नमयं दिव्यं चन्द्रार्कसदृशप्रभम् ।\nविमानं तेजसा युक्तमारोहेत्पुण्यकर्मकृत् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002842061, "chapter_id": 22842, "verse_number": "९-१२७-६२", "content_sanskrit": "कश्चित्पिबति तत्तोयं निपानस्थं ततोऽञ्जलिम् ।\nब्राह्मणो वा यतिर्गौर्वा येन कर्ता न सीदति ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002842062, "chapter_id": 22842, "verse_number": "९-१२७-६३", "content_sanskrit": "उत्सृष्टे कृतकृत्यस्तु सुहृत्कुर्यान्महोत्सवम् ।\nमहाभोज्यं महोत्सर्गं यजमानो दिनाष्टकम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002842063, "chapter_id": 22842, "verse_number": "९-१२७-६४", "content_sanskrit": "कारकाः कर्मणो वापि सूत्रधारादयो नराः ।\nइष्टापूर्तेन धर्मेण तेऽपि स्वर्गं प्रयांति हि ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002842064, "chapter_id": 22842, "verse_number": "९-१२७-६५", "content_sanskrit": "खन्यमाने महीभागे प्राणिनो ये क्षयं गताः ।\nचित्रे वा देवकूटार्थे ते सर्वे त्रिदिवं गताः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002842065, "chapter_id": 22842, "verse_number": "९-१२७-६६", "content_sanskrit": "धेनोस्तु रोमकूपाणि यावन्तीह नरोत्तम ।\nतावद्वर्षसहस्राणि वर्षकोटिशतानि च ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7002842066, "chapter_id": 22842, "verse_number": "९-१२७-६७", "content_sanskrit": "कोटिर्युगसहस्राणां स्वर्गे तिष्ठेत्तडागकृत् ।\nचेत्तस्यपितरः केचिन्नरकं समुपागताः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7002842067, "chapter_id": 22842, "verse_number": "९-१२७-६८", "content_sanskrit": "तांस्तु तारयते सर्वानात्मानं च महीपते ।\nआस्फोटयंति पितरो वल्गंति प्रपितामहाः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7002842068, "chapter_id": 22842, "verse_number": "९-१२७-६९", "content_sanskrit": "अपि नः स कुले जातो यस्तडागं करिष्यति ।\nसर्वस्वेनापि कौंतेय भूमिष्ठमुदकं कुरु ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7002842069, "chapter_id": 22842, "verse_number": "९-१२७-७०", "content_sanskrit": "कुलानि तारयेत्सप्त यत्र गौर्वितृषी भवेत् ।\nएवं वर्षशतेनापि कृत्तिका विहरीवने ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7002842070, "chapter_id": 22842, "verse_number": "९-१२७-७१", "content_sanskrit": "मासं चेतागृहे कोटिक्षणध्वंसिधनस्य हि ।\nतडागं देवभवनं वापीवृक्षोघनच्छदः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7002842071, "chapter_id": 22842, "verse_number": "९-१२७-७२", "content_sanskrit": "चतुर्थकं फलं प्राप्तं कारितेऽस्मिंश्चतुष्टये ।\nयथा मातुः समाचष्टे पुत्रः शीलं स्वकैर्गुणैः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7002842072, "chapter_id": 22842, "verse_number": "९-१२७-७३", "content_sanskrit": "तथा स्वादेन च जलं कर्तुः सर्वं शुभाशुभम् ।\nअतः शुभागतं द्रव्यं तडागादिषु लापयेत् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7002842073, "chapter_id": 22842, "verse_number": "९-१२७-७४", "content_sanskrit": "धन्यस्य पांथाः संप्राप्य तडागं वृक्षमंडितम् ।\nपीत्वापः पादपतले विश्रमंति रमंति च ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7002842074, "chapter_id": 22842, "verse_number": "९-१२७-७५", "content_sanskrit": "मारुतोद्भूतवीच्यग्रैः करैः कमलमंडितम् ।\nअभ्यागताय सुधिया तडागाद्यं प्रकल्पितम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7002842075, "chapter_id": 22842, "verse_number": "९-१२७-७६", "content_sanskrit": "सामान्यं सर्वभूतेभ्यो येन भूमिगतं जलम् ।\nतारितं कारितं तेन सुपुत्रेण कुलद्वयम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7002842076, "chapter_id": 22842, "verse_number": "९-१२७-७७", "content_sanskrit": "मूर्तं स्वभावतः सिद्धमिष्टं मन्त्रप्रदर्शितम् ।\nइष्टापूर्ते कृते राजन्कृतकृत्यः पुमान्भवेत् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7002842077, "chapter_id": 22842, "verse_number": "९-१२७-७८", "content_sanskrit": "उन्नता वाथ निम्ना वा कीर्तिर्येन प्रकाशिता ।\nतेन त्रैलोक्य चन्द्रेण जननी पार्थ पुत्रिणी ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7002842078, "chapter_id": 22842, "verse_number": "९-१२७-७९", "content_sanskrit": "त्रितयं निघ्नतां नेयं त्रितयं चोन्नतिं पराम् ।\nतडागमथ यो भूमौ देव देवालयंकृती ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7002842079, "chapter_id": 22842, "verse_number": "९-१२७-८०", "content_sanskrit": "यः कारयति लोकेऽस्मिन्कीर्तिस्तस्यामला भवेत् ।\nस जीवति स एवैकः स भवेदजरामरः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7002842080, "chapter_id": 22842, "verse_number": "९-१२७-८१", "content_sanskrit": "उपेतानामपि दिवं स निबन्धविधायिनाम् ।\nआस्त एव निरातंकं तस्य कीर्तिमयं वपुः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7002842081, "chapter_id": 22842, "verse_number": "९-१२७-८२", "content_sanskrit": "तावत्स्वर्गे स रमते यावत्कीर्तिरनश्वरा ।\nतावत्त्विलायामध्यास्ते सुकृती वैबुधं पदम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7002842082, "chapter_id": 22842, "verse_number": "९-१२७-८३", "content_sanskrit": "हंसास्यक्षिप्तनील्यग्रं पद्मिनीखण्डमण्डितम् ।\nपीयमानं महाग्रामैर्धन्याः पश्यंति स्वं सरः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7002842083, "chapter_id": 22842, "verse_number": "९-१२७-८४", "content_sanskrit": "घटैरञ्जलिभिर्वक्त्रैर्यस्य वाटीपुटैर्जलम् ।\nपिबंति जंतवः सर्वे किमन्यत्तस्य वर्ण्यते ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7002842084, "chapter_id": 22842, "verse_number": "९-१२७-८५", "content_sanskrit": "तडागं नगरोपांते धन्यस्य किल जायते ।\nउभयोरर्थसंसिद्धिर्दृष्टा कर्तुर्जनस्य च ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7002842085, "chapter_id": 22842, "verse_number": "९-१२७-८६", "content_sanskrit": "येषां देवकुलं तत्तु निष्पद्येत सरस्तटे ।\nअभीष्टदेवतायुक्तं तेषां पार्थ किमुच्यते ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7002842086, "chapter_id": 22842, "verse_number": "९-१२७-८७", "content_sanskrit": "न भवंतीष्टिका यावद्द्रोणी वा भूमिसन्निभा ।\nस्वर्गे महीयते तावत्कारको देववेश्मनः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7002842087, "chapter_id": 22842, "verse_number": "९-१२७-८८", "content_sanskrit": "भोग्यस्थाने कृतः कूपः सुस्वादुसलिलस्तथा ।\nदृढरज्जुसमायुक्तः पुनात्यासप्तमं कुलम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7002842088, "chapter_id": 22842, "verse_number": "९-१२७-८९", "content_sanskrit": "यस्य स्वादुजलं कूपे पिबंति सततं जनाः ।\nकिं तेन न कृतं पुण्यं सवसत्त्वोपकारिणा ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7002842089, "chapter_id": 22842, "verse_number": "९-१२७-९०", "content_sanskrit": "यः प्रासादान्रचयति शुभान्देवतानां तडागे कीर्तिस्तस्य भ्रमति विपुला वंशमार्गानुयाता ।\nदिव्यान्भोगान्भजति च सदा कारकश्चाप्रमेयान्भुक्त्वा सौख्यं पुनरपि च भवेच्चक्रवर्ती पृथिव्याम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7002842090, "chapter_id": 22842, "verse_number": "९-१२७-९१", "content_sanskrit": "तेषां तडागानि बहूदकानि कूपाश्च यूपाश्च प्रतिश्रयाश्च ।\nअन्नप्रदानं मधुरा च वाणी यमस्य ते निर्वचनी भवंति ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}]