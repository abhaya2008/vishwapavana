[{"id": 2188373, "chapter_id": 5004, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2188374, "chapter_id": 5004, "verse_number": "१", "content_sanskrit": "अस्ति कश्चिद् यदि विभो सदारो नियतो गृहे ।\nअतीतसर्वसंसारः सर्वद्वन्द्वविवर्जितः ।\nतं मे ब्रूहि महाप्राज्ञ दुर्लभः पुरुषो महान् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2188375, "chapter_id": 5004, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2188376, "chapter_id": 5004, "verse_number": "२", "content_sanskrit": "शृणु राजन् यथावृत्तं यन्मां त्वं पृष्टवानसि ।\nइतिहासमिमं शुद्धं संसारभयभेषजम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2188377, "chapter_id": 5004, "verse_number": "३", "content_sanskrit": "देवलो नाम विप्रर्षिः सर्वशास्त्रार्थकोविदः ।\nक्रियावान् धार्मिको नित्यं देवब्राह्मणपूजकः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2188378, "chapter_id": 5004, "verse_number": "४", "content_sanskrit": "सुता सुवर्चला नाम तस्य कल्याणलक्षणा ।\nनातिह्रस्वा नातिकृशा नातिदीर्घा यशस्विनी\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2188379, "chapter_id": 5004, "verse_number": "५", "content_sanskrit": "अस्याः पतिः कुतो वेति ब्राह्मणः श्रोत्रियः परः ।\nविद्वान् विप्रो ह्यकूटुम्बः प्रियवादी महातपाः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2188380, "chapter_id": 5004, "verse_number": "६", "content_sanskrit": "इत्येवं चिन्तयानं तं रहस्याह सुवर्चला \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2188381, "chapter_id": 5004, "verse_number": "७", "content_sanskrit": "अन्धाय मां महाप्राज्ञ देह्यनन्धाय वै पितः ।\nएवं स्मर सदा विद्वन् ममेदं प्रार्थितं मुने\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2188382, "chapter_id": 5004, "verse_number": "", "content_sanskrit": "पिता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2188383, "chapter_id": 5004, "verse_number": "८", "content_sanskrit": "न शक्यं प्रार्थितं वत्से त्वयाऽद्य प्रतिभाति मे ।\nअन्धतानन्धता चेति विकारो मम जायते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2188384, "chapter_id": 5004, "verse_number": "९", "content_sanskrit": "उन्मत्तेवाशुभं वाक्यं भाषसे शुभलोचने\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2188385, "chapter_id": 5004, "verse_number": "", "content_sanskrit": "सुवर्चला", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2188386, "chapter_id": 5004, "verse_number": "१०", "content_sanskrit": "नाहमुन्मत्तभूताऽद्य बुद्धिपूर्वं ब्रवीमि ते ।\nविद्यते चोत्पतिस्तादृक् स मां भरति वेदवित्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2188387, "chapter_id": 5004, "verse_number": "११", "content_sanskrit": "येभ्यस्त्वं मन्यसे दातुं मामिहानय तान् द्विजान् ।\nतादृशं तं पतिं तेषु वरयिष्ये यथातथम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2188388, "chapter_id": 5004, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2188389, "chapter_id": 5004, "verse_number": "१२", "content_sanskrit": "तथेति चोक्त्वा तां कन्यामृषिः शिष्यानुवाच ह ।\nब्राह्मणान् वेदसम्पन्नान् योनिगोत्रविशोधितान्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2188390, "chapter_id": 5004, "verse_number": "१३", "content_sanskrit": "मातृतः पितृतः शुद्धान् शुद्धानाचरतः शुभान् ।\nअरोगान् बुद्धिसम्पन्नान् शीलसत्वगुणान्वितान्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2188391, "chapter_id": 5004, "verse_number": "१४", "content_sanskrit": "असङ्कीर्णांश्च गोत्रेषु वेदव्रतसमन्वितान् ।\nब्राह्मणान् स्नातकान् शीघ्रं मातापितृसमन्वितान् ।\nनिवेष्टुकामान् कन्यां मे दृष्ट्वाऽऽनयत शिष्यकाः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2188392, "chapter_id": 5004, "verse_number": "१५", "content_sanskrit": "तच्छ्रुत्वा त्वरिताः शिष्या ह्याश्रमेषु ततस्ततः ।\nग्रामेषु च ततो गत्वा ब्राह्मणेभ्यो न्यवेदयन्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2188393, "chapter_id": 5004, "verse_number": "१६", "content_sanskrit": "ऋषेः प्रभावं मत्वा ते कन्यायाश्च द्विजोत्तमाः ।\nअनेकमुनयो राजन् सम्प्राप्ता देवलाश्रमम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2188394, "chapter_id": 5004, "verse_number": "१७", "content_sanskrit": "अनुमान्य यथान्यायं मुनीन् मुनिकुमारकान् ।\nअभ्यर्च्य विधिवत् तत्र कन्या प्राह पिता महान् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2188395, "chapter_id": 5004, "verse_number": "१८", "content_sanskrit": "एतेऽपि मुनयो वत्से स्वपुत्रैकमता इह ।\nवेदवेदाङ्गसम्पन्नाः कुलीनाः शीलसम्मताः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2188396, "chapter_id": 5004, "verse_number": "१९", "content_sanskrit": "येऽमी तेषु वरं भद्रे त्वमिच्छसि महाव्रतम् ।\nतं कुमारं वृणीष्वाद्य तस्मै दास्याम्यहं शुभे\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2188397, "chapter_id": 5004, "verse_number": "२०", "content_sanskrit": "तथेति चोक्त्वा कल्याणी तप्तहेमनिभा तदा ।\nसर्वलक्षणसम्पन्ना वाक्यमाह यशस्विनी\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2188398, "chapter_id": 5004, "verse_number": "२१", "content_sanskrit": "विप्राणां समितीर्दृष्ट्वा प्रणिपत्य तपोधनान् ।\nयद्यस्ति समितौ विप्रो ह्यन्धोऽनन्धः स मे वरः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2188399, "chapter_id": 5004, "verse_number": "२२", "content_sanskrit": "तत् श्रुत्वा मुनयस्तत्र वीक्षमाणाः परस्परम् ।\nनोचुर्विप्रा महाभागाः कन्यां मत्त्वा ह्यवेदिकाम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2188400, "chapter_id": 5004, "verse_number": "२३", "content_sanskrit": "कुत्सयित्वा मुनिं तत्र मनसा मुनिसत्तमाः ।\nयथागतं ययुः क्रुद्धा नानादेशनिवासिनः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2188401, "chapter_id": 5004, "verse_number": "२४", "content_sanskrit": "कन्या च संस्थिता तत्र पितृवेश्मनि भामिनी\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2188402, "chapter_id": 5004, "verse_number": "२५", "content_sanskrit": "ततः कदाचिद् ब्रह्मण्यो विद्वान् न्यायविशारदः ।\nऊहापोहविधानज्ञो ब्रह्मवर्चसमन्वितः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2188403, "chapter_id": 5004, "verse_number": "२६", "content_sanskrit": "वेदविद् वेदतत्वज्ञः क्रियाकल्पविशारदः ।\nआत्मतत्वविभागज्ञः पितृमान् गुणसागरः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2188404, "chapter_id": 5004, "verse_number": "२७", "content_sanskrit": "श्वेतकेतुरिति ख्यातः श्रुत्वा वृत्तान्तमादरात् ।\nकन्यार्थं देवलं चापि शीघ्रं तत्रागतोऽभवत्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2188405, "chapter_id": 5004, "verse_number": "२८", "content_sanskrit": "उद्दालकसुतं दृष्ट्वा श्वेतकेतुं महाव्रतम् ।\nयथान्यायं च सम्पूज्य देवलः प्रत्यभाषत \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2188406, "chapter_id": 5004, "verse_number": "२९", "content_sanskrit": "कन्ये एष महाभाग प्राप्तो ऋषिकुमारकः ।\nवरयैनं महाप्राज्ञं वेदवेदाङ्गपारगम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2188407, "chapter_id": 5004, "verse_number": "३०", "content_sanskrit": "तच्छ्रुत्वा कुपिता कन्या ऋषिपुत्रमुदैक्षत ।\nतां कन्यामाह विप्रर्षिः सोऽहं भद्रे समागतः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2188408, "chapter_id": 5004, "verse_number": "३१", "content_sanskrit": "अन्धोऽहमत्र तत्त्वं हि तथा मन्ये च सर्वदा ।\nविशालनयनं विद्धि तथा मां हीनसंशयम् \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2188409, "chapter_id": 5004, "verse_number": "३२", "content_sanskrit": "येनेदं वीक्षते नित्यं वृणोति स्पृशतेऽथवा ।\nघ्रायते वक्ति सततं येनेदं सार्यते पुनः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2188410, "chapter_id": 5004, "verse_number": "३३", "content_sanskrit": "येनेदं मन्यते तत्त्वं येन बुध्यति वा पुनः ।\nन चक्षुर्विद्यते ह्येषः स वै भूतान्ध उच्यते \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2188411, "chapter_id": 5004, "verse_number": "३४", "content_sanskrit": "यस्मिन् प्रवर्तते चेदं पश्यन् शृण्वन् स्पृशन्नपि ।\nजिघ्रंश्च रसयंस्तद्वद् वर्तते येन चक्षुषा \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2188412, "chapter_id": 5004, "verse_number": "३५", "content_sanskrit": "तन्मे नास्ति ततो ह्यन्धो वृणु भद्रेऽद्य मामतः ।\nलोकदृष्ट्या करोमीह नित्यनैमित्तिकादिकम् \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2188413, "chapter_id": 5004, "verse_number": "३६", "content_sanskrit": "आत्मदृष्ट्या च तत्सर्वं विलिप्यामि च नित्यशः ।\nस्थितोऽहं निर्भरः शान्तः कार्यकारणभावनः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2188414, "chapter_id": 5004, "verse_number": "३७", "content_sanskrit": "अविद्यया तरन् मृत्युं विद्यया तं तथाऽमृतम् ।\nयथाप्राप्तं तु सन्दृश्य वसामीह विमत्सरः ।\nक्रीते व्यवसितं भद्रे भर्ताऽहं ते वृणीष्व माम् \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2188415, "chapter_id": 5004, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2188416, "chapter_id": 5004, "verse_number": "३८", "content_sanskrit": "ततः सुवर्चला दृष्ट्वा प्राह तं द्विजसत्तमम् ।\nमनसाऽपि वृतो विद्वन् शेषकर्ता पिता मम ।\nवृणीष्व पितरं मह्यमेष वेदविधिक्रमः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2188417, "chapter_id": 5004, "verse_number": "३९", "content_sanskrit": "तद् विज्ञाय पिता तस्या देवलो मुनिसत्तमः ।\nश्वेतकेतुं च सम्पूज्य तथैवोद्दालकेन तम् \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2188418, "chapter_id": 5004, "verse_number": "४०", "content_sanskrit": "मुनीनामग्रतः कन्यां प्रददौ जलपूर्वकम् ।\nउदाहरन्ति वै तत्र श्वेतकेतुं निरीक्ष्य तम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2188419, "chapter_id": 5004, "verse_number": "४१", "content_sanskrit": "हृत्पुण्डरीकनिलयः सर्वभूतात्मको हरिः ।\nश्वेतकेतुस्वरूपेण स्थितोऽसौ मधुसूदनः \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2188420, "chapter_id": 5004, "verse_number": "४२", "content_sanskrit": "प्रीयतां माधवो देवः पत्नी चेयं सुता मम ।\nप्रतिपादयामि ते कन्यां सहधर्मचरीं शुभाम् ।\nइत्युक्त्वा प्रददौ तस्मै देवलो मुनिपुङ्गवः \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2188421, "chapter_id": 5004, "verse_number": "४३", "content_sanskrit": "प्रतिगृह्य च तां कन्यां श्वेतकेतुर्महायशाः ।\nउपयम्य यथान्यायमत्र कृत्वा यथाविधि\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2188422, "chapter_id": 5004, "verse_number": "४४", "content_sanskrit": "समाप्य तन्त्रं मुनिभिर्वैवाहिकमनुत्तमम् ।\nस गार्हस्थ्ये वसन् धीमान् भार्यां तामिदमब्रवीत्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2188423, "chapter_id": 5004, "verse_number": "४५", "content_sanskrit": "यानि चोक्तानि वेदेषु तत्सर्वं कुरु शोभने ।\nमया सह यथान्यायं सहधर्मचरी मम\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2188424, "chapter_id": 5004, "verse_number": "४६", "content_sanskrit": "अहमित्येव भावेन स्थितस्त्वमतथैव च ।\nतस्मात् कर्माणि कुर्वीथाः कुर्यां ते च ततः परम् \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2188425, "chapter_id": 5004, "verse_number": "४७", "content_sanskrit": "न ममेति च भावेन ज्ञानाग्निनिलयेन च ।\nअनन्तरं तथा कुर्यास्तानि कर्माणि भस्मसात् \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2188426, "chapter_id": 5004, "verse_number": "४८", "content_sanskrit": "एवं त्वया च कर्तव्यं सर्वदा दुर्भगा मया ।\nयद्यदाचरति श्रेष्ठस्तत्तदेवेतरो जनः ।\nतस्माल्लोकस्य सिद्ध्यर्थं कर्तव्यं चात्मसिद्धये \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2188427, "chapter_id": 5004, "verse_number": "४९", "content_sanskrit": "उक्त्वैवं स महाप्राज्ञः सर्वज्ञानैकभाजनः ।\nपुत्रानुत्पाद्य तस्यां च यज्ञैः सन्तर्प्य देवताः \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2188428, "chapter_id": 5004, "verse_number": "५०", "content_sanskrit": "आत्मयोगपरो नित्यं निर्द्वन्द्वो निष्परिग्रहः ।\nभार्यां तां सदृशीं प्राप्य बुद्धिं क्षेत्रज्ञयोरिव \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2188429, "chapter_id": 5004, "verse_number": "५१", "content_sanskrit": "लोकमन्यमनुप्राप्तौ भार्या भर्ता तथैव च ।\nसाक्षिभूतौ जगत्यस्मिंश्चरमाणौ मुदाऽन्वितौ\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2188430, "chapter_id": 5004, "verse_number": "५२", "content_sanskrit": "ततः कदाचिद् भर्तारं श्वेतकेतुं सुवर्चला ।\nपप्रच्छ को भवानत्र ब्रूहि मे तद् द्विजोत्तम\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2188431, "chapter_id": 5004, "verse_number": "५३", "content_sanskrit": "तामाह भगवान् वाग्मी तया ज्ञातो न संशयः ।\nद्विजोत्तमेति मामुक्त्वा पुनः कमनुपृच्छसि\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2188432, "chapter_id": 5004, "verse_number": "५४", "content_sanskrit": "सा तमाह महात्मानं पृच्छामि हृदि शायिनम् ।\nतच्छ्रुत्वा प्रत्युवाचैनां स न वक्ष्यति भामिनि\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2188433, "chapter_id": 5004, "verse_number": "५५", "content_sanskrit": "नामगोत्रसमायुक्तमात्मानं मन्यसे यदि ।\nतन्मिथ्या गोत्रसद्भावे वर्तते देहबन्धनम् \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2188434, "chapter_id": 5004, "verse_number": "५६", "content_sanskrit": "अहमित्येष भावोऽत्र त्वयि चापि समाहितः ।\nत्वमप्यहमहं सर्वमहमित्येव वर्तते ।\nनात्र तत्परमार्थं वै किमर्थमनुपृच्छसि \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2188435, "chapter_id": 5004, "verse_number": "५७", "content_sanskrit": "ततः प्रहस्य सा हृष्टा भर्तारं धर्मचारिणी ।\nउवाच वचनं काले स्मयमाना तदा नृप\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2188436, "chapter_id": 5004, "verse_number": "५८", "content_sanskrit": "किमनेकप्रकारेण विरोधेन प्रयोजनम् ।\nक्रियाकलापैर्ब्रह्मर्षे ज्ञाननष्टोऽसि सर्वदा\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2188437, "chapter_id": 5004, "verse_number": "", "content_sanskrit": "श्वेतकेतुरुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2188438, "chapter_id": 5004, "verse_number": "५९", "content_sanskrit": "यद्यदाचरति श्रेष्ठस्तत्तदेवेतरो जनः ।\nवर्तते तेन लोकोऽयं सङ्कीर्णश्च भविष्यति \t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2188439, "chapter_id": 5004, "verse_number": "६०", "content_sanskrit": "सङ्कीर्णे च तथा धर्मे वर्णः सङ्करमेति च ।\nसङ्करे च प्रवृत्ते तु मात्स्यो न्यायः प्रवर्तते \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2188440, "chapter_id": 5004, "verse_number": "६१", "content_sanskrit": "तदनिष्टं हरेर्भद्रे धातुरस्य महात्मनः ।\nपरमेश्वरसङ्क्रीडा लोकसृष्टिरियं शुभे \t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2188441, "chapter_id": 5004, "verse_number": "६२", "content_sanskrit": "यावत् पांसव उद्दिष्टास्तावत्योऽस्य विभूतयः ।\nतावत्यश्चैव मायास्तु तावत्योऽस्याश्च शक्तयः \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2188442, "chapter_id": 5004, "verse_number": "६३", "content_sanskrit": "एवं सुगह्वरे युक्तो यत्र मे तद्भवाभवम् ।\nछित्वा ज्ञानासिना गच्छेत् स विद्वान् स च मे प्रियः ।\nसोऽहमेव न सन्देहः प्रतिज्ञा इति तस्य वै\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2188443, "chapter_id": 5004, "verse_number": "६४", "content_sanskrit": "ये मूढास्ते दुरात्मानो धर्मसङ्करकारकाः ।\nमर्यादाभेदका नीचा नरके यान्ति जन्तवः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2188444, "chapter_id": 5004, "verse_number": "६५", "content_sanskrit": "आसुरीं योनिमापन्ना इति देवानुशासनम् \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2188445, "chapter_id": 5004, "verse_number": "६६", "content_sanskrit": "भगवत्या तथा लोके रक्षितव्यं न संशयः ।\nमर्यादालोकरक्षार्थमेवमस्मि तथा स्थितः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2188446, "chapter_id": 5004, "verse_number": "", "content_sanskrit": "सुवर्चला", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2188447, "chapter_id": 5004, "verse_number": "६७", "content_sanskrit": "शब्दः कोऽत्र इति ख्यातस्तथार्थं च महामुने ।\nआकृत्या पतयो ब्रूहि लक्षणेन पृथक् पृथक् \t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2188448, "chapter_id": 5004, "verse_number": "६८", "content_sanskrit": "व्यत्ययेन च वर्णानां परिवादिकृतो हि यः ।\nस शब्द इति विज्ञेयस्तन्निपातोऽर्थ उच्यते \t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2188449, "chapter_id": 5004, "verse_number": "", "content_sanskrit": "सुवर्चला", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2188450, "chapter_id": 5004, "verse_number": "६९", "content_sanskrit": "शब्दार्थयोर्हि सम्बन्धस्त्वनयोरस्ति वा न वा ।\nतन्मे ब्रूहि यथा तत्त्वं शब्दस्थानेऽर्थ एव चेत् \t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2188451, "chapter_id": 5004, "verse_number": "", "content_sanskrit": "श्वेतकेतुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2188452, "chapter_id": 5004, "verse_number": "७०", "content_sanskrit": "शब्दार्थयोर्न चैवास्ति सम्बन्धोऽत्यन्त एव हि ।\nपुष्करे च यथा तोयं तथाऽस्मीति च वेत्थ तत् \t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2188453, "chapter_id": 5004, "verse_number": "", "content_sanskrit": "सुवर्चला", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2188454, "chapter_id": 5004, "verse_number": "७१", "content_sanskrit": "अर्थे स्थितिर्हि शब्दस्य नान्यथा च स्थितिर्भवेत् ।\nविद्यते चेन्महाप्राज्ञ विनाऽर्थं ब्रूहि सत्तम\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2188455, "chapter_id": 5004, "verse_number": "", "content_sanskrit": "श्वेतकेतुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2188456, "chapter_id": 5004, "verse_number": "७२", "content_sanskrit": "स संसर्गोऽतिमात्रस्तु वाचकत्वेन वर्तते ।\nअस्ति चेद्वर्तते नित्यं विकारोच्चारणेन वै \t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2188457, "chapter_id": 5004, "verse_number": "", "content_sanskrit": "सुवर्चला", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2188458, "chapter_id": 5004, "verse_number": "७३", "content_sanskrit": "शब्दस्थानोऽत्र इत्युक्तस्तथाऽर्थ इति मे कृतम् ।\nअर्थास्थितो न तिष्ठेच्च विरूढमिह भाषितम् \t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2188459, "chapter_id": 5004, "verse_number": "", "content_sanskrit": "श्वेतकेतुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2188460, "chapter_id": 5004, "verse_number": "७४", "content_sanskrit": "न विकूलोऽत्र कथितो नाकाशं हि विना जगत् ।\nसम्बन्धस्तत्र नास्त्येव तद्वदित्येष मन्यताम् \t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2188461, "chapter_id": 5004, "verse_number": "", "content_sanskrit": "सुवर्चला", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2188462, "chapter_id": 5004, "verse_number": "७५", "content_sanskrit": "सदाऽहङ्कारशब्दोऽयं व्यक्तमात्मनि संश्रितः ।\nन वाचस्तत्र वर्तन्ते इति मिथ्या भविष्यति \t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2188463, "chapter_id": 5004, "verse_number": "", "content_sanskrit": "श्वेतकेतुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2188464, "chapter_id": 5004, "verse_number": "७६", "content_sanskrit": "अहंशब्दो ह्यहंभावो नात्मभावे शुभव्रते ।\nन वर्तते परेऽचिन्त्ये वाचः सगुणलक्षणाः \t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2188465, "chapter_id": 5004, "verse_number": "", "content_sanskrit": "सुवर्चला", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2188466, "chapter_id": 5004, "verse_number": "७७", "content_sanskrit": "अहं गात्रैकतःश्यामा भवानपि तथैव च ।\nतन्मे ब्रूहि यथान्यायमेवं चेन्मुनिसत्तम \t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2188467, "chapter_id": 5004, "verse_number": "", "content_sanskrit": "श्वेतकेतुरुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2188468, "chapter_id": 5004, "verse_number": "७८", "content_sanskrit": "मृण्मये हि घटे भावस्तादृग्भाव इहेष्यते ।\nअयं भावः परेऽचिन्त्ये ह्यात्मभावो यथा च मृत् \t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2188469, "chapter_id": 5004, "verse_number": "७९", "content_sanskrit": "अहं त्वमेतदित्येव परे सङ्कल्पनाम या ।\nतस्माद् वाचो न वर्तन्त इति नैव विरुद्ध्यते \t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2188470, "chapter_id": 5004, "verse_number": "८०", "content_sanskrit": "तस्माद् वाचो न वर्तन्ते इति नैव विरुद्ध्यते ।\nतस्माद् वामेन वर्तन्ते मनसा भीरु सर्वशः \t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2188471, "chapter_id": 5004, "verse_number": "८१", "content_sanskrit": "संसर्गे सति सम्बन्धात् तद्विकारं भविष्यति ।\nअनाकाशगतं सर्वं विकारे च सदा गतम् \t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2188472, "chapter_id": 5004, "verse_number": "८२", "content_sanskrit": "तद् ब्रह्म परमं शुद्धमनौपम्यं न शक्यते ।\nन दृश्यते तथा तच्च दृश्यते च मतिर्मम\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2188473, "chapter_id": 5004, "verse_number": "", "content_sanskrit": "सुवर्चला", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2188474, "chapter_id": 5004, "verse_number": "८३", "content_sanskrit": "निर्विकारं ह्यमूर्तिं च निरयं सर्वगं तथा ।\nदृश्यते च वियन्नित्यं दृगात्मा तेन दृश्यते \t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2188475, "chapter_id": 5004, "verse_number": "", "content_sanskrit": "श्वेतकेतुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2188476, "chapter_id": 5004, "verse_number": "८४", "content_sanskrit": "त्वचा स्पृशति वै वाहुमाकाशस्थं पुनः पुनः ।\nतत्स्थं गन्धं तथाघ्राति ज्योतिः पश्यति चक्षुषा\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2188477, "chapter_id": 5004, "verse_number": "८५", "content_sanskrit": "तमोरश्मिगणश्चैव मेघजालं तथैव च ।\nवर्षं तारागणं चैव नाकाशं दृश्यते पुनः\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2188478, "chapter_id": 5004, "verse_number": "८६", "content_sanskrit": "आकाशस्याप्यथाकाशं सद्रूपमिति निश्चितम् ।\nतदर्थे कल्पिता ह्येते तत्सत्यो विष्णुरेव च ।\nयानि नामानि गौणानि ह्युपचारात् परात्मनि \t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2188479, "chapter_id": 5004, "verse_number": "८७", "content_sanskrit": "न चक्षुषा न मनसा न चान्येन परो विभुः ।\nचिन्त्यते सूक्ष्मया बुद्ध्या वाचा वक्तुं न शक्यते\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2188480, "chapter_id": 5004, "verse_number": "८८", "content_sanskrit": "एतत्प्रपन्नमखिलं तस्मिन् सर्वं प्रतिष्ठितम् ।\nमहाघटोऽल्पकश्चैव यथा मह्यां प्रतिष्ठितौ \t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2188481, "chapter_id": 5004, "verse_number": "८९", "content_sanskrit": "न च स्त्री न पुमांश्चैव यथैव न नपुंसकः ।\nकेवलज्ञानमात्रं तत् तस्मिन् सर्वं प्रतिष्ठितम् \t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2188482, "chapter_id": 5004, "verse_number": "९०", "content_sanskrit": "भूमिसंस्थानयोगेन वस्तुसंस्थानयोगतः ।\nरसभेदा यथा तोये प्रकृत्यामात्मनस्तथा \t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2188483, "chapter_id": 5004, "verse_number": "९१", "content_sanskrit": "तद्वाक्यस्मरणान्नित्यं तृप्तिं वारि पिबन्निव ।\nप्राप्नोति ज्ञानमखिलं तेन तत्सुखमेधते \t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2188484, "chapter_id": 5004, "verse_number": "", "content_sanskrit": "सुवर्चला", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2188485, "chapter_id": 5004, "verse_number": "९२", "content_sanskrit": "अनेन साध्यं किं स्याद्वै शब्देनेति मतिर्मम ।\nवेदगम्यः परोऽचिन्त्य इति पौराणिका विदुः \t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2188486, "chapter_id": 5004, "verse_number": "९३", "content_sanskrit": "निरर्थको यथा लोके तद्वत्स्यादिति मे मतिः ।\nनिरीक्ष्यैवं यथान्यायं वक्तुमर्हसि मेऽनघ \t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2188487, "chapter_id": 5004, "verse_number": "", "content_sanskrit": "श्वेतकेतुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2188488, "chapter_id": 5004, "verse_number": "९४", "content_sanskrit": "वेदगम्यं परं शुद्धमिति सत्या परा श्रुतिः ।\nव्यावृत्त्या नैतदित्याह तूपलिङ्गे च वर्तते \t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2188489, "chapter_id": 5004, "verse_number": "९५", "content_sanskrit": "निरर्थको न चैवास्ति शब्दो लौकिक उत्तमे ।\nअनन्वयाः स्मृताः शब्दा निरर्था इति लौकिकैः \t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2188490, "chapter_id": 5004, "verse_number": "९६", "content_sanskrit": "गृह्यन्ते तद्वदित्येव न वर्तन्ते परात्मनि ।\nअगोचरत्वं वचसां युक्तमेवं तथा शुभे \t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2188491, "chapter_id": 5004, "verse_number": "९७", "content_sanskrit": "साधनस्योपदेशाच्च ह्युपायस्य च सूचनात् ।\nउपलक्षणयोगेन व्यावृत्त्या च प्रदर्शनात् ।\nवेदगम्यः परः शुद्ध इति मे धीयते मतिः \t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2188492, "chapter_id": 5004, "verse_number": "९८", "content_sanskrit": "अध्यात्मध्यानसम्भूतमभूतं भूतवत् स्फुटम् ।\nज्ञानं विद्धि शुभाचारे तेन यान्ति परां गतिम् \t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2188493, "chapter_id": 5004, "verse_number": "१००", "content_sanskrit": "नानारूपवदस्यैवमैश्वर्यं दृश्यते शुभे ।\nन वायुस्तं न सूर्यस्तं नाग्निस्तत्तु परं पदम् \t॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2188494, "chapter_id": 5004, "verse_number": "१०१", "content_sanskrit": "अनेन पूर्णमेतद्धि हृदि भूतिमिहेष्यते ।\nएतावदात्मविज्ञानमेतावद् यदहं स्मृतम् ।\nआवयोर्न च सत्वे वै तस्मादज्ञानबन्धनम्\t॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2188495, "chapter_id": 5004, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2188496, "chapter_id": 5004, "verse_number": "१०२", "content_sanskrit": "एवं सुवर्चला हृष्टा प्रोक्ता भर्त्रा यथार्थवत् ।\nपरिचर्यमाणा ह्यनिशं तत्वबुद्धिसमन्विता\t॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2188497, "chapter_id": 5004, "verse_number": "१०३", "content_sanskrit": "भर्ता च तामनुप्रेक्ष्य नित्यनैमित्तिकान्वितः ।\nपरमात्मनि गोविन्दे वासुदेवे महात्मनि\t॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2188498, "chapter_id": 5004, "verse_number": "१०५", "content_sanskrit": "समाधाय च कर्माणि तन्मयत्वेन भावितः ।\nकालेन महता राजन् यस्मात् त्वं परिपृच्छसि\nगार्हस्थ्यं च समास्थाय गतौ जायापती परम्\t॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2188499, "chapter_id": 5004, "verse_number": "", "content_sanskrit": "॥ इति इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे त्रिपञ्चाशोऽध्यायः॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}]