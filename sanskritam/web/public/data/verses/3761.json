[{"id": 2128630, "chapter_id": 3761, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2128631, "chapter_id": 3761, "verse_number": "१", "content_sanskrit": "ते तं दृष्ट्वा हयं राजन् सम्प्रहृष्टतनूरुहाः ।\nअनादृत्य महात्मानं कपिलं कालचोदिताः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2128632, "chapter_id": 3761, "verse_number": "२", "content_sanskrit": "सङ्क्रुद्धाः समधावन्त वाजिग्रहणकाङ्क्षिणः\nततः क्रुद्धो महाभागः कपिलो मुनिसत्तमः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2128633, "chapter_id": 3761, "verse_number": "३", "content_sanskrit": "वासुदेवेति यं प्राहुः कपिलं मुनिपुङ्गवम् ।\nस चक्षुर्विवृतं कृत्वा तेजस्तेषु समुत्सृजन् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2128634, "chapter_id": 3761, "verse_number": "४", "content_sanskrit": "ददाह सुमहातेजा मन्दबुद्धीन् स सागरान् ।\nषष्टिं तानि सहस्राणि युगपन्मुनिसत्तमः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2128635, "chapter_id": 3761, "verse_number": "५", "content_sanskrit": "तान् दृष्ट्वा भस्मसाद्भूतान् नारदः सुमहातपाः ।\nसगरान्तिकमासाद्य तच्च तस्मै न्यवेदयत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2128636, "chapter_id": 3761, "verse_number": "६", "content_sanskrit": "स तच्छ्रुत्वा वचो राजा घोरं मुनिमुखोद्गतम् ।\nमुहूर्तं विमना भूत्वा स्थाणोर्वाक्यमचिन्तयत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2128637, "chapter_id": 3761, "verse_number": "७", "content_sanskrit": "स पुत्रनिधनोद्भूतदुःखेन समभिप्लुतः ।\nआत्मानमात्मनाऽऽश्चास्य हयमेवान्वचिन्तयत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2128638, "chapter_id": 3761, "verse_number": "८", "content_sanskrit": "अंशुमन्तं समाहूय असमञ्जसुतं तदा ।\nपौत्रं भरतशार्दूल इदं वचनमब्रवीत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2128639, "chapter_id": 3761, "verse_number": "९", "content_sanskrit": "षष्टिस्तानि सहस्राणि पुत्राणाममितौजसाम् ।\nकापिलं तेज असाद्य मत्कृते निधनं गताः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2128640, "chapter_id": 3761, "verse_number": "१०", "content_sanskrit": "तव चापि पिता तात परित्यक्तो मयाऽनघ ।\nधर्मं संरक्षमाणेन पौराणां हितकाम्यया \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2128641, "chapter_id": 3761, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2128642, "chapter_id": 3761, "verse_number": "११", "content_sanskrit": "किमर्थं राजशार्दूलः सगरः पुत्रमात्मजम् ।\nत्यक्तवान् दुस्त्यजं वीरं तन्मे ब्रूहि तपोधन\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2128643, "chapter_id": 3761, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2128644, "chapter_id": 3761, "verse_number": "१२", "content_sanskrit": "असमञ्ज इति ख्यातः सगरस्य सुतोऽभवत् ।\nयं शैब्या जनयामास पौराणां स हि दारकान्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2128645, "chapter_id": 3761, "verse_number": "१३", "content_sanskrit": "क्रीडतः सहसाऽऽसाद्य तत्रतत्र महीपते ।\nचूडासु क्रोशतो गृह्य नद्यां चिक्षेप वै बलात्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2128646, "chapter_id": 3761, "verse_number": "१४", "content_sanskrit": "ततः पौराः समाजग्मुर्भयशोकपरिप्लुताः ।\nसगरं चाप्ययाचन्त सर्वे प्राञ्जलयः स्थिताः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2128647, "chapter_id": 3761, "verse_number": "१५", "content_sanskrit": "त्वं नस्त्राता महाराज परचक्रादिभिर्भयात् ।\nअसमञ्जभयाद् घोरादस्मांस्त्रातुं त्वमर्हसि\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2128648, "chapter_id": 3761, "verse_number": "१६", "content_sanskrit": "पौराणां वचनं श्रुत्वा घोरं नृपतिसत्तमः ।\nमुहूर्तं विमना भूत्वा सचिवानिदमब्रवीत् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2128649, "chapter_id": 3761, "verse_number": "१७", "content_sanskrit": "असमञ्जः कुमारोऽद्य नगराद् विप्रवास्यताम् ।\nयदि वो मत्प्रियं कार्यमेतच्छीघ्रं विधीयताम् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2128650, "chapter_id": 3761, "verse_number": "१८", "content_sanskrit": "एवमुक्ता नरेन्द्रेण सचिवास्ते नराधिप ।\nयथोक्तं त्वरिताश्चक्रुर्यथाऽऽज्ञापितवान् नृपः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2128651, "chapter_id": 3761, "verse_number": "१९", "content_sanskrit": "एतत् ते सर्वमाख्यातं यथा पुत्रो महात्मना ।\nपौराणां विप्रिये तिष्ठन् सगरेण विवासितः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2128652, "chapter_id": 3761, "verse_number": "२०", "content_sanskrit": "अंशुमांस्तु महेष्वासो यदुक्तः सगरेण ह ।\nतत् ते सर्वं प्रवक्ष्यामि कीर्त्यमानं निबोध मे \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2128653, "chapter_id": 3761, "verse_number": "", "content_sanskrit": "सगरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2128654, "chapter_id": 3761, "verse_number": "२१", "content_sanskrit": "त्यागात् तव पितुश्चापि शेषाणां निधनेन च ।\nअलाभेन तथाऽश्वस्य परितप्स्यामि पुत्रक ।\nसुतानामश्वनाशाच्च मनो मे तात मोहितम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2128655, "chapter_id": 3761, "verse_number": "२२", "content_sanskrit": "तस्माद् दुःखाभिसन्तप्तं यज्ञविघ्नाच्च मोहितम् ।\nहयस्यानयनात् पौत्र नरकान्मां समुद्धर\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2128656, "chapter_id": 3761, "verse_number": "२३", "content_sanskrit": "अंशुमानेवमुक्तस्तु सगरेण महात्मना ।\nजगाम दुःखात् तं देशं यत्र वै दारिता मही \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2128657, "chapter_id": 3761, "verse_number": "२४", "content_sanskrit": "स तु तेनैव मार्गेण समुद्रं प्रविवेश ह ।\nअपश्यच्च महात्मानं कपिलं तुरगं च तम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2128658, "chapter_id": 3761, "verse_number": "२५", "content_sanskrit": "दृष्ट्वा तं तेजसां राशिं पुराणमृषिसत्तमम् ।\nप्रणम्य शिरसा भूमौ कार्यंर् तस्मै न्यवेदयत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2128659, "chapter_id": 3761, "verse_number": "२६", "content_sanskrit": "ततः प्रीतो महातेजाः कपिलोंऽशुमतोऽभवत् ।\nउवाच चैनं धर्मात्मा वरदोऽस्मीति भारत\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2128660, "chapter_id": 3761, "verse_number": "२७", "content_sanskrit": "स वव्रे तुरगं तत्र प्रथमं यज्ञकारणात् ।\nद्वितीयमुदकं वव्रे पितॄणां पावनेप्सया \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2128661, "chapter_id": 3761, "verse_number": "२८", "content_sanskrit": "तमुवाच महातेजाः कपिलो मुनिपुङ्गवः ।\nददानि तव भद्रं ते यद्यत् प्रार्थयसेऽनघ \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2128662, "chapter_id": 3761, "verse_number": "२९", "content_sanskrit": "त्वयि क्षमा च धर्मश्च सत्यं चापि प्रतिष्ठितम् ।\nत्वया कृतार्थः सगरः पुत्रवांश्च त्वया पिता \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2128663, "chapter_id": 3761, "verse_number": "३०", "content_sanskrit": "तव चैव प्रभावेण स्वर्गं यास्यन्ति सागराः ।\nशलभत्वं गता ह्येते मम क्रोधहुताशने \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2128664, "chapter_id": 3761, "verse_number": "३२", "content_sanskrit": "पौत्रश्च ते त्रिपथगां त्रिदिवादानयिष्यति ।\nपावनार्थं सागराणां तोषयित्वा महेश्वरम् \t॥३१॥\nहयं नयस्व भद्रं ते याज्ञियं नरपुङ्गव ।\nयज्ञः समाप्यतां तस्य सगरस्य महात्मनः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2128665, "chapter_id": 3761, "verse_number": "३३", "content_sanskrit": "अंशुमानेवमुक्तस्तु कपिलेन महात्मना ।\nआजगाम हयं गृह्य यज्ञवाटं महात्मनः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2128666, "chapter_id": 3761, "verse_number": "३४", "content_sanskrit": "सोऽभिवाद्य पितुः पादौ सगरस्य महात्मनः ।\nमूर्ध्नि तेनाप्युपाघ्रातः तस्मै सर्वं न्यवेदयत्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2128667, "chapter_id": 3761, "verse_number": "३५", "content_sanskrit": "यथा दृष्टं श्रुतं चापि सागराणां क्षयं तथा ।\nतं चास्मै हयमाचष्ट यज्ञवाटमुपागतम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2128668, "chapter_id": 3761, "verse_number": "३६", "content_sanskrit": "तच्छ्रुत्वा सगरो राजा पुत्रजं दुःखमत्यजत् ।\nअंशुमन्तं च सम्पूज्य समापयत तं क्रतुम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2128669, "chapter_id": 3761, "verse_number": "३७", "content_sanskrit": "समाप्तयज्ञः सगरो देवैः सर्वैः सभाजितः ।\nपुत्रत्वे कल्पयामास समुद्रं वरुणालयम् \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2128670, "chapter_id": 3761, "verse_number": "३८", "content_sanskrit": "प्रशास्य सुचिरं कालं राज्यं राजीवलोचनः ।\nपौत्रे भारं समावेश्य जगाम त्रिदिवं नृपः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2128671, "chapter_id": 3761, "verse_number": "३९", "content_sanskrit": "अंशुमानपि धर्मात्मा महीं सागरमेखलाम् ।\nप्रशशास महाराज यथैवास्य पितामहः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2128672, "chapter_id": 3761, "verse_number": "४०", "content_sanskrit": "तस्य पुत्रः समभवद् दिलीपो नाम धर्मवित् ।\nतस्मिन् राज्यं समाधाय अंशुमानपि स्वर्गतः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2128673, "chapter_id": 3761, "verse_number": "४१", "content_sanskrit": "दिलीपस्तु ततः श्रुत्वा पितॄणां निधनं महत् ।\nपर्यतप्यत दुःखेन गतिं तेषां विचिन्तयन्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2128674, "chapter_id": 3761, "verse_number": "४२", "content_sanskrit": "गङ्गावतरणे यत्नं महान्तं चाकरोन्नृपः ।\nन चावतारयामास चेष्टमानो यथाबलम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2128675, "chapter_id": 3761, "verse_number": "४३", "content_sanskrit": "तस्य पुत्रः समभवत् श्रीमान् धर्मपरायणः ।\nभगीरथ इति ख्यातः सत्यवागनसूयकः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2128676, "chapter_id": 3761, "verse_number": "४४", "content_sanskrit": "अभिषिच्य तु तं राज्ये दिलीपो वनमाश्रितः ।\nभगीरथं महात्मानं सत्यधर्मपरायणम् \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2128677, "chapter_id": 3761, "verse_number": "४५", "content_sanskrit": "तपस्सिद्धिसमायोगात् स राजा मनुजाधिप ।\nवनाज्जगाम त्रिदिवं कालयोगेन भारत\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2128678, "chapter_id": 3761, "verse_number": "५९", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nवनपर्वणि त्र्यधिकशततमोऽध्यायः ॥१०३॥\n॥ तीर्थयात्रापर्वणि एकोनषष्टितमोऽध्यायः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2128679, "chapter_id": 3761, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]