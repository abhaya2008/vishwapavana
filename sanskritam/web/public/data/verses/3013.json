[{"id": 2094205, "chapter_id": 3013, "verse_number": "१३-१४३-१", "content_sanskrit": "भीष्म उवाच।\nअत्रैवोदाहरन्तीममितिहासं पुरातनम्।\nयद्वृत्तं तीर्थयात्रायां शपथं प्रति तच्छृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2094206, "chapter_id": 3013, "verse_number": "१३-१४३-२", "content_sanskrit": "पुष्करार्थं कृतं स्तैन्यं पुरा भरतसत्तम।\nराजर्षिभिर्महाराज तथैव च द्विजर्षिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2094207, "chapter_id": 3013, "verse_number": "१३-१४३-३", "content_sanskrit": "पुरा प्रभासे ऋषयः समग्राः\nसमेता वै मन्त्रममन्त्रयन्त।\nचराम सर्वां पृथिवीं पुण्यतीर्थां\nतन्नः कामं हन्त गच्छाम सर्वे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2094208, "chapter_id": 3013, "verse_number": "१३-१४३-४", "content_sanskrit": "शुक्रोऽङ्गिराश्चैव कविश्च विद्वां-\nस्तथा ह्यगस्त्यो नारदपर्वतौ च।\nभृगुर्वसिष्ठः कश्यपो गौतमश्च\nविश्वामित्रो जमदग्निश्च राजन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2094209, "chapter_id": 3013, "verse_number": "१३-१४३-५", "content_sanskrit": "ऋषिस्तथा गालवोऽथाष्टकश्च\nभरद्वाजोऽरुन्धती वालखिल्याः।\nशिबिर्दिलीपो नहुषोऽम्बरीषो\nराजा ययातिर्धुन्धुमारोऽथ पूरुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2094210, "chapter_id": 3013, "verse_number": "१३-१४३-६", "content_sanskrit": "जग्मुः पुरस्कृत्य महानुभावं\nशतक्रतुं वृत्रहणं नरेन्द्राः।\nतीर्थानि सर्वाणि परिभ्रमन्तो\nमाघ्यां ययुः कौशिकीं पुण्यतीर्थाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2094211, "chapter_id": 3013, "verse_number": "१३-१४३-७", "content_sanskrit": "सर्वेषु तीर्थेष्ववधूतपापा\nजग्मुस्ततो ब्रह्मसरः सुपुण्यम्।\nदेवस्य तीर्थे जलमग्निकल्पा\nविगाह्य ते भुक्तबिसप्रसूनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2094212, "chapter_id": 3013, "verse_number": "१३-१४३-८", "content_sanskrit": "केचिद्बिसान्यखनंस्तत्र राजन्न-\nन्ये मृणालान्यखनंस्तत्र विप्राः।\nअथापश्यन्पुष्करं ते ह्रियन्तं\nह्रदादगस्त्येन समुद्धृतं तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2094213, "chapter_id": 3013, "verse_number": "१३-१४३-९", "content_sanskrit": "नानाह सर्वानृषिमुख्यानगस्त्यः\nकेनाहृतं पुष्करं मे सुजातम्।\nयुष्माञ्शङ्के पुष्करं दीयतां मे\nन वै भवन्तो हर्तुमर्हन्ति पद्मम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2094214, "chapter_id": 3013, "verse_number": "१३-१४३-१०", "content_sanskrit": "शृणोमि कालो हिंसते धर्मवीर्यं\nसेयं प्राप्ता वर्तते धर्मपीडा।\nपुराऽधर्मो वर्तते नेह याव-\nत्तावद्गच्छामः सुरलोकं चिराय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2094215, "chapter_id": 3013, "verse_number": "१३-१४३-११", "content_sanskrit": "पुरा वेदान्ब्राह्मणा ग्राममध्ये\nघुष्टस्वरा वृषलान्श्रावयन्ति।\nपुरा राजा व्यवहारानधर्मा-\nन्पश्यत्यहं परलोकं व्रजामि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2094216, "chapter_id": 3013, "verse_number": "१३-१४३-१२", "content_sanskrit": "पुरा राजा प्रत्यवरान्गरीयसो\nमंस्यत्यथैनमनुयास्यन्ति सर्वे।\nधर्मोत्तरं यावदिदं न वर्तते\nतावद्व्रजामि परलोकं चिराय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2094217, "chapter_id": 3013, "verse_number": "१३-१४३-१३", "content_sanskrit": "पुरा प्रपश्यामि परेण मर्त्या-\nन्बलीयसा दुर्बलान्भुज्यमानान्।\nतस्माद्यास्यामि परलोकं चिराय\nन ह्युत्सहे द्रष्टुमीदृङ्नृलोके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2094218, "chapter_id": 3013, "verse_number": "१३-१४३-१४", "content_sanskrit": "तमाहुरार्ता ऋषयो महर्षिं\nन ते वयं पुष्करं चोरयामः।\nमिथ्याभिशंसा भवता न कार्या\nशपाम तीक्ष्णैः शपथैर्महर्षे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2094219, "chapter_id": 3013, "verse_number": "१३-१४३-१५", "content_sanskrit": "ते निश्चितास्तत्र महर्षयस्तु\nसम्पश्यन्तो धर्ममेतं नरेन्द्राः।\nततोऽशपन्त शपथान्पर्ययेण\nसहैव ते पार्थिव पुत्रपौत्रैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2094220, "chapter_id": 3013, "verse_number": "१३-१४३-१६x", "content_sanskrit": "भृगुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2094221, "chapter_id": 3013, "verse_number": "१३-१४३-१६", "content_sanskrit": "प्रत्याक्रोशेदिहाक्रुष्टस्ताडितः प्रतिताडयेत्।\nखादेच्च पृष्ठमांसानि यस्ते हरति पुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2094222, "chapter_id": 3013, "verse_number": "१३-१४३-१७x", "content_sanskrit": "वसिष्ठ उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2094223, "chapter_id": 3013, "verse_number": "१३-१४३-१७", "content_sanskrit": "अस्वाध्यायपरो लोके श्वानं च परिकर्षतु।\nपुरे च भिक्षुर्भवतु यस्ते हरति पुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2094224, "chapter_id": 3013, "verse_number": "१३-१४३-१८x", "content_sanskrit": "कश्यप उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2094225, "chapter_id": 3013, "verse_number": "१३-१४३-१८", "content_sanskrit": "सर्वत्र सर्वं पणतु न्यासे लोभं करोतु च।\nकूटसाक्षित्वमभ्येतु यस्ते हरति पुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2094226, "chapter_id": 3013, "verse_number": "१३-१४३-१९x", "content_sanskrit": "गौतम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2094227, "chapter_id": 3013, "verse_number": "१३-१४३-१९", "content_sanskrit": "जीवत्वहङ्कृतो बुद्ध्या विषमेणासमेन सः।\nकर्षको मत्सरी चास्तु यस्ते हरति पुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2094228, "chapter_id": 3013, "verse_number": "१३-१४३-२०x", "content_sanskrit": "अङ्गिरा उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2094229, "chapter_id": 3013, "verse_number": "१३-१४३-२०", "content_sanskrit": "अशुचिर्ब्रह्मकूटोस्तु श्वानं च परिकर्षतु।\nब्रह्महाऽनिकृतिश्चास्तु यस्ते हरति पुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2094230, "chapter_id": 3013, "verse_number": "१३-१४३-२१x", "content_sanskrit": "धुन्धुमार उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2094231, "chapter_id": 3013, "verse_number": "१३-१४३-२१", "content_sanskrit": "अकृतज्ञस्तु मित्राणां शूद्रायां च प्रजायतु।\nएकः सम्पन्नमश्नातु यस्ते हरति पुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2094232, "chapter_id": 3013, "verse_number": "१३-१३२-२२x", "content_sanskrit": "पुरूरवा उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2094233, "chapter_id": 3013, "verse_number": "१३-१४३-२२", "content_sanskrit": "चिकित्सायां प्रचरतु भार्यया चैव पुष्यतु।\nश्वशुरात्तस्य वृत्तिः स्याद्यस्ते हरति पुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2094234, "chapter_id": 3013, "verse_number": "१३-१४३-२३x", "content_sanskrit": "दिलीप उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2094235, "chapter_id": 3013, "verse_number": "१३-१४३-२३", "content_sanskrit": "उदपानप्लवे ग्रामे ब्राह्मणो वृषलीपतिः।\nतस्य लोकान्स व्रजतु यस्ते हरति पुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2094236, "chapter_id": 3013, "verse_number": "१३-१४३-२४x", "content_sanskrit": "शुक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2094237, "chapter_id": 3013, "verse_number": "१३-१४३-२४", "content_sanskrit": "वृथा मांसं समश्नातु दिवा गच्छतु मैथुनम्।\nप्रेष्यो भवतु राज्ञश्च यस्ते हरति पुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2094238, "chapter_id": 3013, "verse_number": "१३-१४३-२५x", "content_sanskrit": "जमदग्निरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2094239, "chapter_id": 3013, "verse_number": "१३-१४३-२५", "content_sanskrit": "अनध्यायेष्वधीयीत मित्रं श्राद्धे च भोजयेत्।\nश्राद्धे शूद्रस्य चाश्नीयाद्यस्ते हरति पुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2094240, "chapter_id": 3013, "verse_number": "१३-१४३-२६x", "content_sanskrit": "शिबिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2094241, "chapter_id": 3013, "verse_number": "१३-१४३-२६", "content_sanskrit": "अनाहिताग्निर्मियतां यज्ञे विघ्नं करोतु च।\nतपस्विभिर्विरुध्येच्च यस्ते हरति पुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2094242, "chapter_id": 3013, "verse_number": "१३-१४३-२७x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2094243, "chapter_id": 3013, "verse_number": "१३-१४३-२७", "content_sanskrit": "अनृतौ व्रतनियतायां भार्यायां स प्रजायतु।\nनिराकरोतु वेदांश्च यस्ते हरति पुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2094244, "chapter_id": 3013, "verse_number": "१३-१४३-२८x", "content_sanskrit": "नहुष उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2094245, "chapter_id": 3013, "verse_number": "१३-१४३-२८", "content_sanskrit": "अतिथिर्गृहसंस्थोऽस्तु कामवृत्तस्तु दीक्षितः।\nविद्यां प्रयच्छतु भृतो यस्ते हरति पुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2094246, "chapter_id": 3013, "verse_number": "१३-१४३-२९x", "content_sanskrit": "अम्बरीष उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2094247, "chapter_id": 3013, "verse_number": "१३-१४३-२९", "content_sanskrit": "नृशंसस्त्यक्तधर्मोऽस्तु स्त्रीषु ज्ञातिषु गोषु च।\nनिहन्तु ब्राह्मणं चापि यस्ते हरति पुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2094248, "chapter_id": 3013, "verse_number": "१३-१४३-३०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2094249, "chapter_id": 3013, "verse_number": "१३-१४३-३०", "content_sanskrit": "गृहज्ञानी बहिःशास्त्रं पठतां विस्वरं पदम्।\nगरीयसोऽवजानातु यस्ते हरति पुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2094250, "chapter_id": 3013, "verse_number": "१३-१४३-३१x", "content_sanskrit": "नाभाग उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2094251, "chapter_id": 3013, "verse_number": "१३-१४३-३१", "content_sanskrit": "अनृतं भाषतु सदा सद्भिश्चैव विरुध्यतु।\nशुल्केन ददतु कन्यां यस्ते हरपि पुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2094252, "chapter_id": 3013, "verse_number": "१३-१४३-३२x", "content_sanskrit": "कविरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2094253, "chapter_id": 3013, "verse_number": "१३-१४३-३२", "content_sanskrit": "पदा च गां संस्पृशतु सूर्यं च प्रति मेहतु।\nशरणागतं संत्यजतु यस्ते हरति पुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2094254, "chapter_id": 3013, "verse_number": "१३-१४३-३३x", "content_sanskrit": "विश्वामिइत्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2094255, "chapter_id": 3013, "verse_number": "१३-१४३-३३", "content_sanskrit": "करोतु भृतकोऽवर्षां राज्ञश्चास्तु पुरोहितः।\nऋत्विगस्तु ह्ययाज्यस्य यस्ते हरति पुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2094256, "chapter_id": 3013, "verse_number": "१३-१४३-३४x", "content_sanskrit": "पर्वत उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2094257, "chapter_id": 3013, "verse_number": "१३-१४३-३४", "content_sanskrit": "ग्रामे चाधिकृतः सोऽस्तु खरयानेन गच्छतु।\nशुनः कर्षतु वृत्त्यर्थे यस्ते हरति पुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2094258, "chapter_id": 3013, "verse_number": "१३-१४३-३५x", "content_sanskrit": "भरद्वाज उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2094259, "chapter_id": 3013, "verse_number": "१३-१४३-३५", "content_sanskrit": "सर्वपापसमादानं नृशंसे चानृते च यत्।\nतत्तस्यास्तु सदा पापं यस्ते हरति पुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2094260, "chapter_id": 3013, "verse_number": "१३-१४३-३६x", "content_sanskrit": "अष्टक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2094261, "chapter_id": 3013, "verse_number": "१३-१४३-३६", "content_sanskrit": "स राजास्त्वकृतप्रज्ञः कामवृत्तश्च पापकृत्।\nअधर्मेणाभिशास्तूर्वीं यस्ते हरति पुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2094262, "chapter_id": 3013, "verse_number": "१३-१४३-३७x", "content_sanskrit": "गालव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2094263, "chapter_id": 3013, "verse_number": "१३-१४३-३७", "content_sanskrit": "पापिष्ठेभ्यो ह्यनर्घार्हः स नरोऽस्तु स्वपापकृत्।\nदत्त्वा दानं कीर्तयतु यस्ते हरति पुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2094264, "chapter_id": 3013, "verse_number": "१३-१४३-३८x", "content_sanskrit": "अरुन्धत्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2094265, "chapter_id": 3013, "verse_number": "१३-१४३-३८", "content_sanskrit": "श्वश्र्वाऽपवादं वदतु भर्तुर्भवतु दुर्मनाः।\nएका स्वादु समश्नातु या ते हरति पुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2094266, "chapter_id": 3013, "verse_number": "१३-१४३-३९x", "content_sanskrit": "वालखिल्या ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2094267, "chapter_id": 3013, "verse_number": "१३-१४३-३९", "content_sanskrit": "एकपादेन वृत्त्यर्थं ग्रामद्वारे स तिष्ठतु।\nधर्मज्ञस्त्यक्तधर्मास्तु यस्ते हरति पुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2094268, "chapter_id": 3013, "verse_number": "१३-१४३-४०x", "content_sanskrit": "पशुसख उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2094269, "chapter_id": 3013, "verse_number": "१३-१४३-४०", "content_sanskrit": "अग्निहोत्रमनादृत्य स सुखं स्वपतु द्विजः।\nपरिव्राट् कामवृत्तोस्तु यस्ते हरति पुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2094270, "chapter_id": 3013, "verse_number": "१३-१४३-४१x", "content_sanskrit": "सुरभ्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2094271, "chapter_id": 3013, "verse_number": "१३-१४३-४१", "content_sanskrit": "वालजेन निदानेन कांस्यं भवतु दोहनम्।\nदुह्येत परवत्सेन या ते हरति पुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2094272, "chapter_id": 3013, "verse_number": "१३-१४३-४२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2094273, "chapter_id": 3013, "verse_number": "१३-१४३-४२", "content_sanskrit": "ततस्तु तैः शपथैः शप्यमानै-\nर्नानाविधैर्बहुभिः कौरवेन्द्र।\nसहस्राक्षो देवराट् सम्प्रहृष्टः\nसमीक्ष्य तं कोपनं विप्रमुख्यम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2094274, "chapter_id": 3013, "verse_number": "१३-१४३-४३", "content_sanskrit": "यथाब्रवीन्मघवा प्रत्ययं स्वं\nस्वयं समागत्य तमृषिं जातरोषम्।\nब्रह्मर्षिदेवर्षिनृपर्षिमध्ये\nयं तं निबोधेह ममाद्य राजन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2094275, "chapter_id": 3013, "verse_number": "१३-१४३-४४x", "content_sanskrit": "शक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2094276, "chapter_id": 3013, "verse_number": "१३-१४३-४४", "content_sanskrit": "अध्वर्यवे दुहितरं ददातु\nछन्दोगे वाऽऽचरितब्रह्मचर्ये।\nअथर्वणं वेदमधीत्य विप्रः\nस्नायीत यः पुष्करमाददाति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2094277, "chapter_id": 3013, "verse_number": "१३-१४३-४५", "content_sanskrit": "सर्वान्वेदानधीयीत पुण्यशीलोऽस्तु धार्मिकः।\nब्रह्मणः सदनं यातु यस्ते हरति पुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2094278, "chapter_id": 3013, "verse_number": "१३-१४३-४६x", "content_sanskrit": "अगस्त्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2094279, "chapter_id": 3013, "verse_number": "१३-१४३-४६", "content_sanskrit": "आशीर्वादस्त्वया प्रोक्तः शपथो बलसूदन।\nदीयतां पुष्करं मह्यमेष धर्मः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2094280, "chapter_id": 3013, "verse_number": "१३-१४३-४७x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2094281, "chapter_id": 3013, "verse_number": "१३-१४३-४७", "content_sanskrit": "न मया भगवँल्लोभाद्धृतं पुष्करमद्य वै।\nधर्मांस्तु श्रोतुकामेन हृतं न क्रोद्धुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2094282, "chapter_id": 3013, "verse_number": "१३-१४३-४८", "content_sanskrit": "धर्मश्रुतिसमुत्कर्षो धर्मसेतुरनामयः।\nआर्षो वै शाश्वतो नित्यमव्ययोऽयं मया श्रुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2094283, "chapter_id": 3013, "verse_number": "१३-१४३-४९", "content_sanskrit": "तदिदं गृह्यतां विद्वन्पुष्करं द्विजसत्तम।\nअतिक्रमं मे भगवन्क्षन्तुमर्हस्यनिन्दित॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2094284, "chapter_id": 3013, "verse_number": "१३-१४३-५०", "content_sanskrit": "इत्युक्तः स महेन्द्रेण तपस्वी कोपनो भृशम्।\nजग्राह पुष्करं धीमान्प्रसन्नश्चाभवन्मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2094285, "chapter_id": 3013, "verse_number": "१३-१४३-५१", "content_sanskrit": "प्रययुस्ते ततो भूयस्तीर्थानि वनगोचराः।\nपुण्येषु तीर्थेषु तथा गात्राण्याप्लावयन्त ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2094286, "chapter_id": 3013, "verse_number": "१३-१४३-५२", "content_sanskrit": "आख्यानं य इदं युक्तः पठेत्वर्वणिपर्वणि।\nन मूर्खं जनयेत्पुत्रं न भवेच्च निराकृतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2094287, "chapter_id": 3013, "verse_number": "१३-१४३-५३", "content_sanskrit": "न तमापत्स्पृशेत्काचिद्विज्वरो न जरावहः।\nविरजाः श्रेयसा युक्तः प्रेत्य स्वर्गमवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2094288, "chapter_id": 3013, "verse_number": "१३-१४३-५४", "content_sanskrit": "यश्च शास्त्रमधीयीत ऋषिभिः परिपालितम्।\nस गच्छेद्ब्रह्मणो लोकमव्ययं च नरोत्तम॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2094289, "chapter_id": 3013, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि त्रिचत्वारिंशदधिकशततमोऽध्यायः॥ १४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}]