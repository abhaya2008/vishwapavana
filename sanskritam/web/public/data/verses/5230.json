[{"id": 2198856, "chapter_id": 5230, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2198857, "chapter_id": 5230, "verse_number": "१", "content_sanskrit": "नहुषस्तु ततः श्रुत्वा च्यवनं तं तथागतम् ।\nत्वरितः प्रययौ तत्र सहामात्यपुरोहितः\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2198858, "chapter_id": 5230, "verse_number": "२", "content_sanskrit": "शौचं कृत्वा यथान्यायं प्राञ्जलिः प्रयतो नृपः ।\nआत्मानमाचचक्षे च च्यवनाय महात्मने\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2198859, "chapter_id": 5230, "verse_number": "३", "content_sanskrit": "अर्चयामास तं चापि तस्य राज्ञः पुरोहितः ।\nसत्यव्रतं महाभागं देवकल्पं विशाम्पते\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2198860, "chapter_id": 5230, "verse_number": "", "content_sanskrit": "नहुषः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2198861, "chapter_id": 5230, "verse_number": "४", "content_sanskrit": "करवाणि प्रियं किं ते तन्मे व्याख्यातुमर्हसि ।\nसर्वं कर्तास्मि भगवन् यद्यपि स्यात् सुदुष्करम्\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2198862, "chapter_id": 5230, "verse_number": "", "content_sanskrit": "च्यवनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2198863, "chapter_id": 5230, "verse_number": "५", "content_sanskrit": "श्रमेण महता युक्ताः कैवर्ता मत्स्यजीविनः ।\nमम मूल्यं प्रयच्छैभ्यो मत्स्यानां विक्रयैः सह\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2198864, "chapter_id": 5230, "verse_number": "", "content_sanskrit": "नहुषः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2198865, "chapter_id": 5230, "verse_number": "६", "content_sanskrit": "सहस्रं दीयतां मूल्यं निषादेभ्यः पुरोहित ।\nनिष्क्रयार्थं भगवतो यथाह भृगुनन्दनः\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2198866, "chapter_id": 5230, "verse_number": "", "content_sanskrit": "च्यवनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2198867, "chapter_id": 5230, "verse_number": "७", "content_sanskrit": "सहस्रं नाहमर्हामि किं वा त्वं मन्यसे नृप ।\nसदृशं दीयतां मूल्यं स्वबुद्ध्या निश्चयं कुरु\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2198868, "chapter_id": 5230, "verse_number": "", "content_sanskrit": "नहुषः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2198869, "chapter_id": 5230, "verse_number": "८", "content_sanskrit": "सहस्राणां शतं क्षिप्रं निषादेभ्यः प्रदीयताम् ।\nस्यादेतत्तु भवेन्मूल्यं किं वान्यन्मन्यते भवान्\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2198870, "chapter_id": 5230, "verse_number": "", "content_sanskrit": "च्यवनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2198871, "chapter_id": 5230, "verse_number": "९", "content_sanskrit": "नाहं शतसहस्रेण निमेयः पार्थिवर्षभ ।\nदीयतां सदृशं मूल्यममात्यैः सह चिन्तय\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2198872, "chapter_id": 5230, "verse_number": "", "content_sanskrit": "नहुषः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2198873, "chapter_id": 5230, "verse_number": "१०", "content_sanskrit": "कोटिः प्रदीयतां मूल्यं निषादेभ्यः पुरोहित ।\nयदेतदपि नौपम्यमतो भूयः प्रदीयताम्\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2198874, "chapter_id": 5230, "verse_number": "", "content_sanskrit": "च्यवनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2198875, "chapter_id": 5230, "verse_number": "११", "content_sanskrit": "राजन् नार्हाम्यहं कोटिं भूयो वापि महाद्युते ।\nसदृशं दीयतां मूल्यं ब्राह्मणैः सह चिन्तय\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2198876, "chapter_id": 5230, "verse_number": "", "content_sanskrit": "नहुषः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2198877, "chapter_id": 5230, "verse_number": "१२", "content_sanskrit": "अर्धराज्यं समग्रं वा निषादेभ्यः प्रदीयताम् ।\nएतन्मूल्यमहं मन्ये किं वान्यन्मन्यसे द्विज\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2198878, "chapter_id": 5230, "verse_number": "", "content_sanskrit": "च्यवनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2198879, "chapter_id": 5230, "verse_number": "१३", "content_sanskrit": "अर्धराज्यं समग्रं वा नाहमर्हामि पार्थिव ।\nसदृशं दीयतां मूल्यमृषिभिः सह चिन्त्यताम्\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2198880, "chapter_id": 5230, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2198881, "chapter_id": 5230, "verse_number": "१४", "content_sanskrit": "महर्षेर्वचनं श्रुत्वा नहुषो दुःखकर्शितः ।\nस चिन्तयामास तदा सहामात्यपुरोहितः\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2198882, "chapter_id": 5230, "verse_number": "१५", "content_sanskrit": "तत्र त्वन्यो वनचरः कश्चिन्मूलफलाशनः ।\nनहुषस्य समीपस्थो गविजातोऽभवन्मुनिः\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2198883, "chapter_id": 5230, "verse_number": "१६", "content_sanskrit": "स समाभाष्य राजानमब्रवीद् द्विजसत्तमः ।\nतोषयिष्याम्यहं विप्रं यथा तुष्टो भविष्यति\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2198884, "chapter_id": 5230, "verse_number": "१७", "content_sanskrit": "नाहं मिथ्यावचो ब्रूयां स्वैरेष्वपि कुतोऽन्यथा ।\nभवतो यदहं ब्रूयां तत् कार्यमविशङ्कया\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2198885, "chapter_id": 5230, "verse_number": "", "content_sanskrit": "नहुषः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2198886, "chapter_id": 5230, "verse_number": "१८", "content_sanskrit": "ब्रवीतु भगवान्मूल्यं महर्षेः सदृशं भृगोः ।\nपरित्रायस्व मामस्माद् विषयं च कुलं च मे\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2198887, "chapter_id": 5230, "verse_number": "१९", "content_sanskrit": "हन्याद्धि भगवान् क्रुद्धस्त्रैलोक्यमपि केवलम् ।\nकिं पुनर्मां तपोहीनं बाहुवीर्यपरायणम्\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2198888, "chapter_id": 5230, "verse_number": "२०", "content_sanskrit": "अगाधेऽम्भसि मग्नस्य सामात्यस्य सहर्त्विजः ।\nप्लवो भव महर्षे त्वं कुरु मूल्यविनिश्चयम्\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2198889, "chapter_id": 5230, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2198890, "chapter_id": 5230, "verse_number": "२१", "content_sanskrit": "नहुषस्य वचः श्रुत्वा गविजातः प्रतापवान् ।\nउवाच हर्षयन् सर्वानमात्यान् पार्थिवं च तम्\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2198891, "chapter_id": 5230, "verse_number": "२२", "content_sanskrit": "अनर्घेया महाराज द्विजा वर्णमहत्तमाः ।\nगावश्च पृथिवीपाल गौर्मूल्यं परिकल्प्यताम्\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2198892, "chapter_id": 5230, "verse_number": "२३", "content_sanskrit": "नहुषस्तु ततः श्रुत्वा महर्षेर्वचनं नृप ।\nहर्षेण महता युक्तः सहामात्यपुरोहितः\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2198893, "chapter_id": 5230, "verse_number": "२४", "content_sanskrit": "अभिगम्य भृगोः पुत्रं च्यवनं संशितव्रतम् ।\nइदं प्रोवाच नृपते वाचा सन्तर्पयन्निव\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2198894, "chapter_id": 5230, "verse_number": "२५", "content_sanskrit": "उत्तिष्ठोत्तिष्ठ विप्रर्षे गवा क्रीतोऽसि भार्गव ।\nएतन्मूल्यमहं मन्ये तव धर्मभृतां वर\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2198895, "chapter_id": 5230, "verse_number": "", "content_sanskrit": "च्यवनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2198896, "chapter_id": 5230, "verse_number": "२६", "content_sanskrit": "उत्तिष्ठाम्येष राजेन्द्र सम्यक् क्रीतोऽस्मि तेऽनघ ।\nगोभिस्तुल्यं न पश्यामि धनं किञ्चिदिहाच्युत\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2198897, "chapter_id": 5230, "verse_number": "२७", "content_sanskrit": "कीर्तनं श्रवणं दानं दर्शनं चापि पार्थिव ।\nगवां प्रशस्यते वीर सर्वपापहरं शिवम्\t ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2198898, "chapter_id": 5230, "verse_number": "२८", "content_sanskrit": "गावो लक्ष्म्याः सदा मूलं गोषु पाप्मा न विद्यते ।\nअन्नमेव सदा गावो देवानां परमं हविः\t ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2198899, "chapter_id": 5230, "verse_number": "२९", "content_sanskrit": "स्वाहाकारवषट्कारौ गोषु नित्यं प्रतिष्ठितौ ।\nगावो यज्ञप्रणेत्र्यो वै तथा यज्ञस्य ता मुखम्\t ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2198900, "chapter_id": 5230, "verse_number": "३०", "content_sanskrit": "अमृतं ह्यक्षयं दिव्यं क्षरन्ति च वहन्ति च ।\nअमृतायतनं चैताः सर्वलोकनमस्कृताः\t ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2198901, "chapter_id": 5230, "verse_number": "३१", "content_sanskrit": "तेजसा वपुषा चैव गावो वह्निसमा भुवि ।\nगावो हि सुमहत्तेजः प्राणिनां च सुखप्रदाः\t ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2198902, "chapter_id": 5230, "verse_number": "३२", "content_sanskrit": "निविष्टं गोकुलं यत्र श्वासं मुञ्चति निर्भयम् ।\nविराजयति तं देशं पाप्मानं चापकर्षति\t ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2198903, "chapter_id": 5230, "verse_number": "३३", "content_sanskrit": "गावः स्वर्गस्य सोपानं गावः स्वर्गेऽपि पूजिताः ।\nगावः कामदुघा देव्यो नान्यत् किञ्चित्परं स्मृतम्\t ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2198904, "chapter_id": 5230, "verse_number": "३४", "content_sanskrit": "इत्येतद् गोषु मे प्रोक्तं माहात्म्यं पार्थिवर्षभ ।\nगुणैकदेशवचनं शक्यं पारायणं न तु\t ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2198905, "chapter_id": 5230, "verse_number": "", "content_sanskrit": "निषादाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2198906, "chapter_id": 5230, "verse_number": "३५", "content_sanskrit": "दर्शनं कथनं चैव सहास्माभिः कृतं मुने ।\nसतां सप्तपदं मित्रं प्रसादं नः कुरु प्रभो\t ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2198907, "chapter_id": 5230, "verse_number": "३६", "content_sanskrit": "हवींषि सर्वाणि यथा ह्युपभुङ्क्ते हुताशनः ।\nएवं त्वमपि धर्मात्मन् पुरुषाग्निः प्रतापवान्\t ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2198908, "chapter_id": 5230, "verse_number": "३७", "content_sanskrit": "प्रसादयामहे विद्वन् भवन्तं प्रणता वयम् ।\nअनुग्रहार्थमस्माकमियं गौः प्रतिगृह्यताम्\t ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2198909, "chapter_id": 5230, "verse_number": "", "content_sanskrit": "च्यवनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2198910, "chapter_id": 5230, "verse_number": "३८", "content_sanskrit": "कृपणस्य च यच्चक्षुर्मुनेराशीविषस्य च ।\nनरं समूलं दहति कक्षमग्निरिव ज्वलन्\t ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2198911, "chapter_id": 5230, "verse_number": "३९", "content_sanskrit": "प्रतिगृह्णामि वो धेनुं कैवर्ता मुक्तकिल्बिषाः ।\nदिवं गच्छत वै क्षिप्रं मत्स्यैर्जालोद्धृतैः सह\t ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2198912, "chapter_id": 5230, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2198913, "chapter_id": 5230, "verse_number": "४०", "content_sanskrit": "ततस्तस्य प्रसादात् ते महर्षेर्भावितात्मनः ।\nनिषादास्तेन वाक्येन सह मत्स्यैर्दिवं ययुः\t ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2198914, "chapter_id": 5230, "verse_number": "४१", "content_sanskrit": "ततः स राजा नहुषो विस्मितः प्रेक्ष्य धीवरान् ।\nआरोहमाणांस्त्रिदिवं मत्स्यांश्च भरतर्षभ\t ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2198915, "chapter_id": 5230, "verse_number": "४२", "content_sanskrit": "ततस्तौ गविजश्चैव च्यवनश्च भृगूद्वहः ।\nवराभ्यामनुरूपाभ्यां छन्दयामासतुर्नृपम्\t ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2198916, "chapter_id": 5230, "verse_number": "४३", "content_sanskrit": "ततो राजा महावीर्यो नहुषः पृथिवीपतिः ।\nपरमित्यब्रवीत् प्रीतस्तदा भरतसत्तम\t ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2198917, "chapter_id": 5230, "verse_number": "४४", "content_sanskrit": "ततो जग्राह धर्मे स स्थितिमिन्द्रनिभो नृपः ।\nतथेति चोदितः प्रीतस्तावृषी प्रत्यपूजयत्\t ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2198918, "chapter_id": 5230, "verse_number": "४५", "content_sanskrit": "समाप्तदीक्षश्च्यवनस्ततोऽगच्छत् स्वमाश्रमम् ।\nगविजश्च महातेजाः स्वमाश्रमपदं ययौ\t ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2198919, "chapter_id": 5230, "verse_number": "४६", "content_sanskrit": "निषादाश्च दिवं जग्मुस्ते च मत्स्या जनाधिप ।\nनहुषोऽपि वरं लब्ध्वा प्रविवेश पुरं स्वकम्\t ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2198920, "chapter_id": 5230, "verse_number": "४७", "content_sanskrit": "एतत्ते कथितं तात यन्मां त्वं परिपृच्छसि ।\nदर्शने यादृशः स्नेहः संवासे च युधिष्ठिर\t ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2198921, "chapter_id": 5230, "verse_number": "४८", "content_sanskrit": "महाभाग्यं गवां चैव तथा धर्मविनिश्चयम् ।\nकिं भूयः कथ्यतां वीर किं ते हृदि विवक्षितम्\t ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2198922, "chapter_id": 5230, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nअनुशासनपर्वणि दानधर्मे च्यवनक्रयणं नाम एकाशीतितमोऽध्यायः ॥८१॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}]