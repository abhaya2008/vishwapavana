[{"id": 2008547, "chapter_id": 1165, "verse_number": "१-१६६-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2008548, "chapter_id": 1165, "verse_number": "१-१६६-१", "content_sanskrit": "प्रबुद्धास्ते हिडिम्बाया रूपं दृष्ट्वातिमानुषम्।\nविस्मिताः पुरुषव्याघ्रा बभूवुः पृथया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2008549, "chapter_id": 1165, "verse_number": "१-१६६-२", "content_sanskrit": "ततः कुन्ती समीक्ष्यैनां विस्मिता रूपसंपदा।\nउवाच मधुरं वाक्यं सान्त्वपूर्वमिदं शैनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2008550, "chapter_id": 1165, "verse_number": "१-१६६-३", "content_sanskrit": "कस्य त्वं सुरगर्भाभे कावाऽसि वरवर्णिनि।\nकेन कार्येण संप्राप्ता कुतश्चागमनं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2008551, "chapter_id": 1165, "verse_number": "१-१६६-४", "content_sanskrit": "यदि वाऽस्य वनस्य त्वं देवता यदि वाऽप्सराः।\nआचक्ष्व मम तत्सर्वं किमर्थं चेह तिष्ठसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2008552, "chapter_id": 1165, "verse_number": "१-१६६-५x", "content_sanskrit": "हिडिम्बोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2008553, "chapter_id": 1165, "verse_number": "१-१६६-५", "content_sanskrit": "यदेतत्पश्यसि वनं नीलमेघनिं महत्।\nनिवासो राक्षसस्यैष हिडिम्बस्य ममैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2008554, "chapter_id": 1165, "verse_number": "१-१६६-६", "content_sanskrit": "तस्य मां राक्षसेन्द्रस्य भगिनीं विद्दि भामिनि।\nभ्रात्रा संप्रेषितामार्ये त्वां सपुत्रां जिघांसता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2008555, "chapter_id": 1165, "verse_number": "१-१६६-७", "content_sanskrit": "क्रूरबुद्धेरहं तस्य वचनादागता त्विह।\nअद्राक्षं नवहेमाभं तव पुत्रं महाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2008556, "chapter_id": 1165, "verse_number": "१-१६६-८", "content_sanskrit": "ततोऽहं सर्वभूतानां भावे विचरता शुभे।\nचोदिता तव पुत्रार्थं मन्मथेन वशानुगा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2008557, "chapter_id": 1165, "verse_number": "१-१६६-९", "content_sanskrit": "ततो वृतो मया भर्ता तव पुत्रो महाबलः।\nअपनेतुं च यतितो न चैव शकितो मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2008558, "chapter_id": 1165, "verse_number": "१-१६६-१०", "content_sanskrit": "चिरायमाणां मां ज्ञात्वा ततः स पुरुषादकः।\nस्वयमेवागतो हन्तुमिमान्सर्वांस्तवात्मजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2008559, "chapter_id": 1165, "verse_number": "१-१६६-११", "content_sanskrit": "स तेन मम कान्तेन तव पुत्रेण धीमता।\nबलादितो विनिष्पिष्य व्यपनीतो महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2008560, "chapter_id": 1165, "verse_number": "१-१६६-१२", "content_sanskrit": "विकर्षन्तौ महावेगौ गर्जमानौ परस्परम्।\nपश्यैवं युधि विक्रान्तावेतौ च नरराक्षसौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2008561, "chapter_id": 1165, "verse_number": "१-१६६-१३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2008562, "chapter_id": 1165, "verse_number": "१-१६६-१३", "content_sanskrit": "तस्याः श्रुत्वैव वचनमुत्पपात युधिष्ठिरः।\nअर्जुनो नकुलश्चैव सहदेवश्च वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2008563, "chapter_id": 1165, "verse_number": "१-१६६-१४", "content_sanskrit": "तौ ते ददृशुरासक्तौ विकर्षन्तौ परस्परम्।\nकाङ्क्षमाणौ जयं चैव सिंहाविव बलोत्कटौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2008564, "chapter_id": 1165, "verse_number": "१-१६६-१५", "content_sanskrit": "अथान्योन्यं समाश्लिष्य विकर्षन्तौ पुनःपुनः।\nदावाग्निधूमसदृशं चक्रतुः पार्थिवं रजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2008565, "chapter_id": 1165, "verse_number": "१-१६६-१६", "content_sanskrit": "वसुधारेणुसंवीतौ वसुधाधरसन्निभौ।\nबभ्राजतुर्यथा शैलौ नीहारेणाभिसंवृतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2008566, "chapter_id": 1165, "verse_number": "१-१६६-१७", "content_sanskrit": "राक्षसेन तदा भीमं क्लिश्यमानं निरीक्ष्य च।\nउवाचेदं वचः पार्थः प्रहसञ्छनकैरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2008567, "chapter_id": 1165, "verse_number": "१-१६६-१८", "content_sanskrit": "भीम माभैर्महाबाहो न त्वां बुध्यामहे वयम्।\nसमेतं भीमरूपेण रक्षसा श्रमकर्शिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2008568, "chapter_id": 1165, "verse_number": "१-१६६-१९", "content_sanskrit": "साहाय्येऽस्मि स्थितः पार्थ पातयिष्यामि राक्षसम्।\nनकुलः सहदेवश्च मातरं गोपयिष्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2008569, "chapter_id": 1165, "verse_number": "१-१६६-२०x", "content_sanskrit": "भीम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2008570, "chapter_id": 1165, "verse_number": "१-१६६-२०", "content_sanskrit": "उदासीनो निरीक्षस्व न कार्यः संभ्रमस्त्वया।\nन जात्वयं पुनर्जीवेन्मद्बाह्वन्तरमागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2008571, "chapter_id": 1165, "verse_number": "१-१६६-२१", "content_sanskrit": "भुजयोरन्तरं प्राप्तो भीमसेनस्य राक्षसः।\nअमृत्वा पार्थवीर्येण मृतो मा भूदिति ध्वनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2008572, "chapter_id": 1165, "verse_number": "१-१६६-२२", "content_sanskrit": "अयमस्मांस्तु नो हन्याज्जातु पार्थ राक्षसः।\nजीवन्तं न प्रमोक्ष्यामि मा भैषीर्भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2008573, "chapter_id": 1165, "verse_number": "१-१६६-२३x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2008574, "chapter_id": 1165, "verse_number": "१-१६६-२३", "content_sanskrit": "पूर्वरात्रे प्रयुक्तोऽसि भीम क्रूरेण रक्षसा।\nक्षपा व्युष्टा न चेदानीं समाप्तोसीन्महारणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2008575, "chapter_id": 1165, "verse_number": "१-१६६-२४", "content_sanskrit": "किमेनन चिरं भीम जीवता पापरक्षसा।\nगन्तव्ये न चिरं स्थातुमिह शक्यमरिन्दम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2008576, "chapter_id": 1165, "verse_number": "१-१६६-२५", "content_sanskrit": "पुरा संरज्यते प्राची पुरा सन्ध्या प्रवर्तते।\nरौद्रे मुहूर्ते रक्षांसि प्रबलानि भवन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2008577, "chapter_id": 1165, "verse_number": "१-१६६-२६", "content_sanskrit": "त्वरस्व भीम मा क्रीड जहि रक्षो विभीषणम्।\nपुरा विकुरुते मायां भुजयोः सारमर्पय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2008578, "chapter_id": 1165, "verse_number": "१-१६६-२७", "content_sanskrit": "माहात्म्यमात्मनो वेत्थ नराणां हितकाम्यया।\nरक्षो जहि यथा शक्रः पुरा वृत्रं महाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2008579, "chapter_id": 1165, "verse_number": "१-१६६-२८", "content_sanskrit": "अथवा मन्यसे भारं त्वमिमं राक्षसं युधि।\nआतिष्ठे तव साहाय्यं शीघ्रमेव तु हन्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2008580, "chapter_id": 1165, "verse_number": "१-१६६-२९", "content_sanskrit": "अथवा त्वहमेवैनं हनिष्यामि वृकोदर।\nकृतकर्मा परिश्रान्तः साधु तावदुपारम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2008581, "chapter_id": 1165, "verse_number": "१-१६६-३०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2008582, "chapter_id": 1165, "verse_number": "१-१६६-३०", "content_sanskrit": "अर्जुनेनैवमुक्तस्तु भीमो रोषाज्ज्वलन्निव।\nबलमाहारयामास यद्वायोर्जगतः क्षये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2008583, "chapter_id": 1165, "verse_number": "१-१६६-३१", "content_sanskrit": "ततस्तस्याम्बुदाभस्य भीमो रोषात्तु रक्षसः।\nअत्क्षिप्याभ्रामयद्देहं तूर्णं शतगुणं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2008584, "chapter_id": 1165, "verse_number": "१-१६६-३२", "content_sanskrit": "इति चोवाच संक्रुद्धो भ्रामयन्राक्षसीं तनुम्।\nभीमसेनो महाबाहुरभिगर्जन्मुहुर्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2008585, "chapter_id": 1165, "verse_number": "१-१६६-३३x", "content_sanskrit": "भीम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2008586, "chapter_id": 1165, "verse_number": "१-१६६-३३", "content_sanskrit": "नरमांसैर्वृथा पुष्टो वृथा वृद्धो वृथामतिः।\nवृथामरणमर्हस्त्वं वृथाद्य न भविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2008587, "chapter_id": 1165, "verse_number": "१-१६६-३४", "content_sanskrit": "क्षेममद्य करिष्यामि यथा वनमकण्टकम्।\nन पुनर्मानुषान्हत्वा भक्षयिष्यसि राक्षस॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2008588, "chapter_id": 1165, "verse_number": "१-१६६-३५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2008589, "chapter_id": 1165, "verse_number": "१-१६६-३५", "content_sanskrit": "इत्युक्त्वा भीमसेनस्तं निष्पिष्य धरणीतले।\nबाहुभ्यामवपीड्याशु पशुमारममारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2008590, "chapter_id": 1165, "verse_number": "१-१६६-३६", "content_sanskrit": "स मार्यमाणो भीमेन ननाद विपुलं स्वनम्।\nपूरयंस्तद्वनं सर्वं जलार्द्रे इव दुन्दुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2008591, "chapter_id": 1165, "verse_number": "१-१६६-३७", "content_sanskrit": "बाहुभ्यां योक्त्रयित्वा तं बलवान्पाण्डुनन्दनः।\nसमुद्धाम्य शिरश्चास्य सग्रीवं तदपाहरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2008592, "chapter_id": 1165, "verse_number": "१-१६६-३८", "content_sanskrit": "ततो भित्त्वा शिरश्चास्य सग्रीवं तदुदाक्षिपत्।\nतस्य निष्कर्णनयनं निर्जिह्वं रुधिरोक्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2008593, "chapter_id": 1165, "verse_number": "१-१६६-३९", "content_sanskrit": "प्राविद्धं भीमसेनेन शिरो विदशनं बभौ।\nप्रसारितभुजोद्धृष्टो भिन्नमांसत्वगन्तरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2008594, "chapter_id": 1165, "verse_number": "१-१६६-४०", "content_sanskrit": "कबन्धभूतस्तत्रासीद्दनुर्वज्रहतो तथा।\nहिडिम्बं निहतं दृष्ट्वा संहृष्टास्ते तरस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2008595, "chapter_id": 1165, "verse_number": "१-१६६-४१", "content_sanskrit": "हिडिम्बा सा च संप्रेक्ष्य निहतं राक्षसं रणे।\nअदृश्याश्चैव ये स्वस्स्थाः समेताः सर्षिचारणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2008596, "chapter_id": 1165, "verse_number": "१-१६६-४२", "content_sanskrit": "पूजयन्ति स्म तं हृष्टाः साधुसाध्विति पाण्डवम्।\nभ्रातरश्चापि संहृष्टा युधिष्ठिरपुरोगमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2008597, "chapter_id": 1165, "verse_number": "१-१६६-४३", "content_sanskrit": "अपूजयन्नरव्याघ्रं भीमसेनमरिन्दमम्।\nअभिपूज्य महात्मानं भीमं भीमपराक्रमम्।\nपुनरेवार्जुनो वाक्यमुवाचेदं वृकोदरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2008598, "chapter_id": 1165, "verse_number": "१-१६६-४४", "content_sanskrit": "अदूरे नगरं मन्ये वनादस्मादहं विभो।\nशीघ्रं गच्छाम भद्रं ते न नो विद्यात्सुयोधनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2008599, "chapter_id": 1165, "verse_number": "१-१६६-४५", "content_sanskrit": "ततः सर्वे तथेत्युक्त्वा मात्रा सह महारथाः।\nप्रययुः पुरुषव्याघ्रा हिडिम्बा चैव राक्षसी॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2008600, "chapter_id": 1165, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि हिडिम्बवधपर्वमि षट्षष्ट्यधिकशततमोऽध्यायः॥ १६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]