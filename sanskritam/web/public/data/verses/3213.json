[{"id": 2102348, "chapter_id": 3213, "verse_number": "१४-६९-१", "content_sanskrit": "वैशम्पायन उवाच।\nसैवं विलप्य करुणं सोन्मादेव तपस्विनी।\nउत्तरा न्यपतद्भूमौ कृपणा पुत्रगृद्धिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2102349, "chapter_id": 3213, "verse_number": "१४-६९-२", "content_sanskrit": "तां तु दृष्ट्वा निपतितां हतपुत्रपरिच्छदाम्।\nचुक्रोश कुन्ती दुःखार्ता सर्वाश्च भरतास्त्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2102350, "chapter_id": 3213, "verse_number": "१४-६९-३", "content_sanskrit": "मुहूर्तमिव राजेन्द्र पाण्डवानां निवेशनम्।\nअप्रेक्षणीयमभवदार्तस्वनविनादितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2102351, "chapter_id": 3213, "verse_number": "१४-६९-४", "content_sanskrit": "सा मुहूर्तं च राजेन्द्र पुत्रशोकाभिपीडिता।\nकश्मलाभिहता वीर वैराटी त्वभवत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2102352, "chapter_id": 3213, "verse_number": "१४-६९-५", "content_sanskrit": "प्रतिलभ्य तु सा संज्ञामुत्तरा भरतर्षभ।\nअङ्कमारोप्य तं पुत्रमिदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2102353, "chapter_id": 3213, "verse_number": "१४-६९-६", "content_sanskrit": "धर्मज्ञस्य सुतः संस्त्वं न धर्ममवबुध्यसे।\nयस्त्वं वृष्णिप्रवीरस्य कुरुषे नाभिवादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2102354, "chapter_id": 3213, "verse_number": "१४-६९-७", "content_sanskrit": "पुत्र गत्वा मम वचो ब्रूयास्त्वं पितरं त्विदम्।\nदुर्मरं प्राणिनां वीर काले प्राप्ते कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2102355, "chapter_id": 3213, "verse_number": "१४-६९-८", "content_sanskrit": "याऽहं त्वया विनाऽद्येह पत्या पुत्रेण चैव ह।\nमरणं नाभिगच्छामि हतस्वस्तिरकिञ्चना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2102356, "chapter_id": 3213, "verse_number": "१४-६९-९", "content_sanskrit": "अथवा धर्मराज्ञाऽहमनुज्ञाता महाभुजः।\nभक्षयिष्ये विषं घोरं प्रवेक्ष्ये वा हुताशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2102357, "chapter_id": 3213, "verse_number": "१४-६९-१०", "content_sanskrit": "अथवा दुर्भरं तात यदिदं मे सहस्रधा।\nपतिपुत्रविहीनाया हृदयं न विदीर्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2102358, "chapter_id": 3213, "verse_number": "१४-६९-११", "content_sanskrit": "उत्तिष्ठ पुत्र पस्येमां दुःखितां प्रपितामहीम्।\nआर्तामुपप्लुतां दीनां निमग्नां शोकसागरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2102359, "chapter_id": 3213, "verse_number": "१४-६९-१२", "content_sanskrit": "आर्यां च पश्य पाञ्चालीं सात्वतीं च तपस्विनीम्।\nमां च पश्य सुदुःखार्तां व्याधविद्धां मृगीमिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2102360, "chapter_id": 3213, "verse_number": "१४-६९-१३", "content_sanskrit": "उत्तिष्ठ पश्य वदनं लोकनाथस्य धीमतः।\nपुण्डरीकपलाशाक्षं पुरेव चपलेक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2102361, "chapter_id": 3213, "verse_number": "१४-६९-१४", "content_sanskrit": "एवं विप्रलपन्तीं तु दृष्ट्वा निपतितां पुनः।\nउत्तरां तां स्त्रियः सर्वाः पुनरुत्थापयन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2102362, "chapter_id": 3213, "verse_number": "१४-६९-१५", "content_sanskrit": "उत्थाय च पुनर्धैर्यात्तदा मत्स्यपतेः सुता।\nप्राञ्जलिः पुण्डरीकाक्षं भूमावेवाभ्यवादयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2102363, "chapter_id": 3213, "verse_number": "१४-६९-१६", "content_sanskrit": "श्रुत्वा स तस्या विपुलं विलापं पुरुषर्षभः।\nउपस्पृश्य ततः कृष्णो ब्रह्मास्त्रं प्रत्यसंहरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2102364, "chapter_id": 3213, "verse_number": "१४-६९-१७", "content_sanskrit": "प्रतिजज्ञे च दाशार्हस्तस्य जीवितमच्युतः।\nअब्रवीच्च विशुद्धात्मा सर्वं विश्रावयज्जगत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2102365, "chapter_id": 3213, "verse_number": "१४-६९-१८", "content_sanskrit": "न ब्रवीम्युत्तरे मिथ्या सत्यमेतद्भविष्यति।\nएष संजीवयाम्येनं पश्यतां सर्वदेहिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2102366, "chapter_id": 3213, "verse_number": "१४-६९-१९", "content_sanskrit": "नोक्तपूर्वं मया मिथ्या स्वैरेष्वपि कदाचन।\nन च युद्धात्परावृत्तस्तथा संजीवतामयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2102367, "chapter_id": 3213, "verse_number": "१४-६९-२०", "content_sanskrit": "यथा मे दयितो धर्मो ब्राह्मणश्च विशेषतः।\nअभिमन्योः सुतो जातो मृतो जीवत्वयं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2102368, "chapter_id": 3213, "verse_number": "१४-६९-२१", "content_sanskrit": "यथाऽहं नाभिजानामि विजये तु कदाचन।\nविरोधं तेन सत्येन मृतो जीवत्वयं शिशुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2102369, "chapter_id": 3213, "verse_number": "१४-६९-२२", "content_sanskrit": "यथा सत्यं च धर्मश्च मयि नित्यं प्रतिष्ठितौ।\nतथा मृतः शिशुरयं जीवतादभिमन्युजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2102370, "chapter_id": 3213, "verse_number": "१४-६९-२३", "content_sanskrit": "यथा कंसश्च केशी च धर्मेण निहतौ मया।\nतेन सत्येन बालोऽयं पुनः संजीवतामिह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2102371, "chapter_id": 3213, "verse_number": "१४-६९-२४", "content_sanskrit": "इत्युक्त्वा वासुदेवोऽथ तं बालं भरतर्षभ।\n`पादेन कमलाभेन ब्रह्मरुद्रार्चितेन च।\nपस्पर्श पुण्डरीकाक्ष आपादतलमस्तकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2102372, "chapter_id": 3213, "verse_number": "१४-६९-२५", "content_sanskrit": "स्पृष्टमात्रस्तु कृष्णेन स बालो भरतर्षभ।\nशनैःशनैर्महाराज प्रापद्यत स चेतनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2102373, "chapter_id": 3213, "verse_number": "१४-६९-२६", "content_sanskrit": "शनैःशनैर्महाराज प्रास्पन्दत सचेतनः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2102374, "chapter_id": 3213, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि एकोनसप्ततितमोऽध्यायः॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]