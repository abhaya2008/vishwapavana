[{"id": 7001909000, "chapter_id": 21909, "verse_number": "८८-१", "content_sanskrit": "ऋषिरुवाच ।\nचण्डे च निहते दैत्ये मुण्डे च विनिपातिते ।\nबहुलेषु च सैन्येषु क्षयितेष्वसुरेश्वरः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001909001, "chapter_id": 21909, "verse_number": "८८-२", "content_sanskrit": "ततः कोपपराधीनचेताः शुम्भः प्रतापवान् ।\nउद्योगं सर्वसैन्यानां दैत्यानामादिदेश ह ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001909002, "chapter_id": 21909, "verse_number": "८८-३", "content_sanskrit": "अद्य सर्वबलैर्दैत्याः षडशीतिरुदायुधाः ।\nकम्बूनां चतुरशीतिर्निर्यान्तु स्वबलैर्वृताः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001909003, "chapter_id": 21909, "verse_number": "८८-४", "content_sanskrit": "कोटिवीर्याणि पञ्चाशदसुराणां कुलानि वै ।\nशतं कुलानि धौम्राणां निर्गच्छन्तु ममाज्ञया ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001909004, "chapter_id": 21909, "verse_number": "८८-५", "content_sanskrit": "कालका दौर्हृदा मौर्याः कालकेयास्तथासुराः ।\nयुद्धाय सज्जा निर्यान्तु आज्ञया त्वरिता मम ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001909005, "chapter_id": 21909, "verse_number": "८८-६", "content_sanskrit": "इत्याज्ञाप्यासुरपतिः शुम्भो भैरवशासनः ।\nनिर्जगाम महासैन्यसहस्रैर्बहुभिर्वृतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001909006, "chapter_id": 21909, "verse_number": "८८-७", "content_sanskrit": "आयान्तं चण्डिका दृष्ट्वा तत्सैन्यमतिभिषणम् ।\nज्यास्वनैः पूरयामास धरणीगगनान्तरम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001909007, "chapter_id": 21909, "verse_number": "८८-८", "content_sanskrit": "स च सिंहो महानादमतीव कृतवान् नृप ।\nघण्टास्वनेन तन्नादमम्बिका चाप्यबृंहयत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001909008, "chapter_id": 21909, "verse_number": "८८-९", "content_sanskrit": "धनुर्ज्यासिंहघण्टानां नादापूरितदिङ्मुखा ।\nनिनादैर्भोषणैः काली जिग्ये विस्तारितानना ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001909009, "chapter_id": 21909, "verse_number": "८८-१०", "content_sanskrit": "तं निनादमुपश्रुत्य दैत्यसैन्यैश्चतुर्दिशम् ।\nदेवी सिंहस्तथा काली सरोषैः परिवारिताः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001909010, "chapter_id": 21909, "verse_number": "८८-११", "content_sanskrit": "वामे शिवेन एवं दक्षे गणेशेन परिवृताः सप्तमातृकाः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001909011, "chapter_id": 21909, "verse_number": "८८-१२", "content_sanskrit": "ब्राह्मी मातृका ।\nकौमारी मातृका ।\nएतस्मिन्नन्तरे भूप विनाशाय सुरद्विषाम् ।\nभवायामरसिंहानामतिवीर्यबलान्विताः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001909012, "chapter_id": 21909, "verse_number": "८८-१३", "content_sanskrit": "ब्रह्मेशगुहविष्णूनां तथेन्द्रस्य च शक्तयः ।\nशरीरेभ्यो विनिष्क्रम्य तद्रूपैश्चण्डिकां ययुः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001909013, "chapter_id": 21909, "verse_number": "८८-१४", "content_sanskrit": "यस्य देवस्य यद्रूपं यथाभूषणवाहनम् ।\nतद्वदेव हि तच्छक्तिरसुरान् योद्धुमाययौ ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001909014, "chapter_id": 21909, "verse_number": "८८-१५", "content_sanskrit": "हंसयुक्तविमानाग्रे साक्षसूत्रकमण्डलुः ।\nआयाता ब्रह्मणः शक्तिर्ब्रह्माणी साभिधीयते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001909015, "chapter_id": 21909, "verse_number": "८८-१६", "content_sanskrit": "माहेश्वरी वृषारूढा त्रिशूलवरधारिणी ।\nमहाहिवलया प्राप्ता चन्द्रलेखाविभूषणा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001909016, "chapter_id": 21909, "verse_number": "८८-१७", "content_sanskrit": "कौमारी शक्तिहस्ता च मयूरवरवाहना ।\nयोद्धुमभ्याययौ दैत्यानम्बिका गुहरूपिणी ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001909017, "chapter_id": 21909, "verse_number": "८८-१८", "content_sanskrit": "तथैव वैष्णावी शक्तिर्गरुडोपरि संस्थिता ।\nशङ्खचक्रगदाशार्ङ्गखड्गहस्ताभ्युपाययौ ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001909018, "chapter_id": 21909, "verse_number": "८८-१९", "content_sanskrit": "जज्ञे वाराहमतुलं रूपं या बिभ्रती हरेः ।\nशक्तिः साप्यायौ तत्र वाराहीं बिभ्रती तनुम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001909019, "chapter_id": 21909, "verse_number": "८८-२०", "content_sanskrit": "नारसिंही नृसिंहस्य बिभ्रती सदृशं वपुः ।\nप्राप्ता तत्र सटाक्षेपक्षिप्तनक्षत्रसंहतिः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001909020, "chapter_id": 21909, "verse_number": "८८-२१", "content_sanskrit": "वज्रहस्ता तथैवैन्द्री गजराजोपरि स्थिता ।\nप्राप्ता सहस्रनयना यथा शक्रस्तथैव सा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001909021, "chapter_id": 21909, "verse_number": "८८-२२", "content_sanskrit": "ततः परिवृतस्ताभिरीशानो देवशक्तिभिः ।\nहन्यन्तामसुराः शीघ्रं मम प्रीत्याऽह चण्डिकाम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001909022, "chapter_id": 21909, "verse_number": "८८-२३", "content_sanskrit": "ततो देवोशरीरात्तु विनिष्क्रान्तातिभीषणा ।\nचण्डिकाशक्तिरत्युग्रा शिवाशतनिनादिनी ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001909023, "chapter_id": 21909, "verse_number": "८८-२४", "content_sanskrit": "सा चाह धूम्रजटिलमीशानमपराजिता ।\nदूत त्वं गच्छ भगवन् पार्श्वं शुम्भनिशुम्भयोः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001909024, "chapter_id": 21909, "verse_number": "८८-२५", "content_sanskrit": "ब्रूहि शुम्भं निशुम्भं च दानवावतिगर्वितौ ।\nये चान्ये दानवास्तत्र युद्धाय समुपस्थिताः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001909025, "chapter_id": 21909, "verse_number": "८८-२६", "content_sanskrit": "त्रैलोक्यमिन्द्रो लभतां देवाः सन्तु हविर्भुजः ।\nयूयं प्रयात पातालं यदि जीवितुमिच्छथ ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001909026, "chapter_id": 21909, "verse_number": "८८-२७", "content_sanskrit": "बलावलेपादथ चेद्भवन्तो युद्धकाङ्क्षिणः ।\nतदागच्छत तृप्यन्तु मच्छिवाः पिशितेन वः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001909027, "chapter_id": 21909, "verse_number": "८८-२८", "content_sanskrit": "यतो नियुक्तो दौत्येन तया देव्या शिवः स्वयम् ।\nशिवदूतीति लोकेऽस्मिंस्ततः सा ख्यातिमागता ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001909028, "chapter_id": 21909, "verse_number": "८८-२९", "content_sanskrit": "तेऽपि श्रुत्वा वचो देव्याः शर्वाख्यातं महासुराः ।\nअमर्षापूरिता जग्मुर्यत्र कात्यायनी स्थिता ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001909029, "chapter_id": 21909, "verse_number": "८८-३०", "content_sanskrit": "ततः प्रथममेवाग्रे शरशक्त्यृष्टिवृष्टिभिः ।\nववर्षुरुद्धतामर्षास्तां देवीममरारयः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001909030, "chapter_id": 21909, "verse_number": "८८-३१", "content_sanskrit": "सा च तान् प्रहितान् बाणाञ्छूलशक्तिपरश्वधान् ।\nचिच्छेद लीलयाऽध्मातधनुर्मुक्तैर्महेषुभिः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001909031, "chapter_id": 21909, "verse_number": "८८-३२", "content_sanskrit": "तस्याग्रतस्तथा काली शूलपातविदारितान् ।\nखट्वाङ्गपोथितांश्चारीन् कुर्वती व्यचरत्तदा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001909032, "chapter_id": 21909, "verse_number": "८८-३३", "content_sanskrit": "कमण्डलुजलाक्षेपहतवीर्यान् हतौजसः ।\nब्रह्माणी चाकरोच्छत्रून् येन येन स्म धावति ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001909033, "chapter_id": 21909, "verse_number": "८८-३४", "content_sanskrit": "माहेश्वरी त्रिशूलेन तथा चक्रेण वैष्णवी ।\nदैत्याञ्जघान कौमारी तथा शक्त्यातिकोपना ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001909034, "chapter_id": 21909, "verse_number": "८८-३५", "content_sanskrit": "ऐन्द्रीकुलिशपातेन शतशो दैत्यदानवाः ।\nपेतुर्विदारिताः पृथ्व्यां रुधिरौघप्रवर्षिणः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001909035, "chapter_id": 21909, "verse_number": "८८-३६", "content_sanskrit": "तुण्डप्रहारविध्वस्ता दंष्ट्राग्रक्षतवक्षसः ।\nवाराहमूर्त्या न्यपतंश्चक्रेण च विदारिताः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001909036, "chapter_id": 21909, "verse_number": "८८-३७", "content_sanskrit": "नखैर्विदारितांश्चान्यान् भक्षयन्ती महासुरान् ।\nनारसिंही चचाराजौ नादापूर्णदिगन्तरा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001909037, "chapter_id": 21909, "verse_number": "८८-३८", "content_sanskrit": "चण्डाट्टहासैरसुराः शिवदूत्यभिदूषिताः ।\nपेतुः पृथिव्यां पतितांस्तांश्चखादाथ सा तदा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001909038, "chapter_id": 21909, "verse_number": "८८-३९", "content_sanskrit": "इति मातृगणं क्रुद्धं मर्दयन्तं महासुरान् ।\nदृष्ट्वाभ्युपायैर्विविधैर्नेशुर्देवारिसैनिकाः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001909039, "chapter_id": 21909, "verse_number": "८८-४०", "content_sanskrit": "पलायनपरान् दृष्ट्वा दैत्यान् मातृगणार्दितान् ।\nयोद्धुमभ्याययौ क्रुद्धो रक्तबीजो महासुरः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001909040, "chapter_id": 21909, "verse_number": "८८-४१", "content_sanskrit": "रक्तबिन्दुर्यदा भूमौ पतत्यस्य शरीरतः ।\nसमुत्पतति मेदिन्यां तत्प्रमाणो महासुरः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001909041, "chapter_id": 21909, "verse_number": "८८-४२", "content_sanskrit": "युयुधे स गदापाणिपरिन्द्रशक्त्या महासुरः ।\nततश्चैन्द्री स्ववज्रेण रक्तबीजमताडयत् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001909042, "chapter_id": 21909, "verse_number": "८८-४३", "content_sanskrit": "कुलिशेनाहतस्याशु बहु सुस्राव शोणितम् ।\nसमुत्तस्थुस्ततो योधास्तद्रूपास्तत्पराक्रमाः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001909043, "chapter_id": 21909, "verse_number": "८८-४४", "content_sanskrit": "यावन्तः पतितास्तस्य शरीराद्रक्तबिन्दवः ।\nतावन्तः पुरुषा जातास्तद्वीर्यबलविक्रमाः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001909044, "chapter_id": 21909, "verse_number": "८८-४५", "content_sanskrit": "ते चापि युयुधुस्तत्र पुरुषा रक्तसम्भवाः ।\nसमं मातृभिरत्युग्रशस्त्रपातातिभीषणम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001909045, "chapter_id": 21909, "verse_number": "८८-४६", "content_sanskrit": "पुनश्च वज्रपातेन क्षतमस्य शिरो यदा ।\nववाह रक्तं पुरुषास्ततो जाताः सहस्रशः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001909046, "chapter_id": 21909, "verse_number": "८८-४७", "content_sanskrit": "वैष्णवी समरे चैनं चक्रेणाभिजघान ह ।\nगदया ताडयामास ऐन्द्री तमसुरेश्वरम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001909047, "chapter_id": 21909, "verse_number": "८८-४८", "content_sanskrit": "वेष्णावीचक्रभिन्नस्य रुधिरस्रावसम्भवैः ।\nसहस्रशौ जगद्व्याप्तं तत्प्रमाणैर्महासुरैः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001909048, "chapter_id": 21909, "verse_number": "८८-४९", "content_sanskrit": "शक्त्या जघान कौमारी वाराही च तथासिना ।\nमाहेश्वरी त्रिशूलेन रक्तबीजं महासुरम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001909049, "chapter_id": 21909, "verse_number": "८८-५०", "content_sanskrit": "स चापि गदया दैत्यः सर्वा एवाहनत् पृथक् ।\nमातः कोपसमाविष्टो रक्तबीजो महासुरः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001909050, "chapter_id": 21909, "verse_number": "८८-५१", "content_sanskrit": "तस्याहतस्य बहुधा शक्तिशूलादिभिर्भुवि ।\nपपात यो वै रक्तौघस्तेनासञ्छतशोऽसुराः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001909051, "chapter_id": 21909, "verse_number": "८८-५२", "content_sanskrit": "तैश्चासुरासृक्सम्भूतैरसुरैः सकलं जगत् ।\nव्याप्तमासीत्ततो देवा भयमाजग्मुरुत्तमम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001909052, "chapter_id": 21909, "verse_number": "८८-५३", "content_sanskrit": "तान् विषण्णान् सुरान् दृष्ट्वा चण्डिका प्राह सत्वरा ।\nउवाच कालीं चामुण्डे विस्तीर्णं वदनं कुरु ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001909053, "chapter_id": 21909, "verse_number": "८८-५४", "content_sanskrit": "मच्छस्त्रपातसम्भूतान् रक्तबिन्दून् महासुरान् ।\nरक्तबिन्दोः प्रतीच्छ त्वं वक्त्रेणानेन वेगिना ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001909054, "chapter_id": 21909, "verse_number": "८८-५५", "content_sanskrit": "भक्षयन्ती चर रणे तदुत्पन्नान् महासुरान् ।\nएवमेष क्षयं दैत्यः क्षीणरक्तो गमिष्यति ।\nभक्ष्यमाणास्त्वया चोग्रा न चोत्पत्स्यन्ति चापरे ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001909055, "chapter_id": 21909, "verse_number": "८८-५६", "content_sanskrit": "ऋषिरुवाच ।\nइत्युक्त्वा तां ततो देवी शूलेनाभिजघान तम् ।\nमुखेन काली जगृहे रक्तबीजस्य शोणितम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001909056, "chapter_id": 21909, "verse_number": "८८-५७", "content_sanskrit": "ततोऽसावाजघानाथ गदया तत्र चण्डिकाम् ।\nन चास्या वेदनां चक्रे गदापातोऽल्पिकामपि ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001909057, "chapter_id": 21909, "verse_number": "८८-५८", "content_sanskrit": "तस्याहतस्य देहात्तु बहु सुस्राव शोणितम् ।\nयतस्ततः स्ववक्त्रेण चामुण्डा सम्प्रतीच्छति ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001909058, "chapter_id": 21909, "verse_number": "८८-५९", "content_sanskrit": "मुखे समुद्गता येऽस्या रक्तपातान्महासुराः ।\nतांश्चखादाथ चामुण्डा पपौ तस्य च शोणितम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001909059, "chapter_id": 21909, "verse_number": "८८-६०", "content_sanskrit": "देवी शूलेन चक्रेण बाणैरसिभिरृष्टिभिः ।\nजघान रक्तबीजं तं चामुण्डापीतशोणितम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001909060, "chapter_id": 21909, "verse_number": "८८-६१", "content_sanskrit": "स पपात महीपृष्ठे शस्त्रसंहतितो हतः ।\nनीरक्तश्च महीपाल रक्तबीजो महासुरः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001909061, "chapter_id": 21909, "verse_number": "८८-६२", "content_sanskrit": "ततस्ते हर्षमतुलमवापुस्त्रिदशा नृप ।\nतेषां मातृगणो जातो ननर्तासृङ्मदोद्धतः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]