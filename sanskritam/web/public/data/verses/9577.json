[{"id": 5000577000, "chapter_id": 9577, "verse_number": "७-४२-१", "content_sanskrit": "स विसृज्य ततो रामः पुष्पकं हेमभूषितम् ।\nप्रविवेश महाबाहुरशोकवनिकां तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000577001, "chapter_id": 9577, "verse_number": "७-४२-२", "content_sanskrit": "चन्दनागुरुचूतैश्च तुङ्गकालेयकैरपि ।\nदेवदारुवनैश्चापि समन्तादुपशोभिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000577002, "chapter_id": 9577, "verse_number": "७-४२-३", "content_sanskrit": "चम्पकाशोकपुन्नागमधूकपनसासनैः ।\nशोभितां पारिजातैश्च विधूमज्वलनप्रभैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000577003, "chapter_id": 9577, "verse_number": "७-४२-४", "content_sanskrit": "लोध्रनीपार्जुनैर्नागैः सप्तपर्णातिमुक्तकैः ।\nमन्दारकदलीगुल्मलताजालसमावृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000577004, "chapter_id": 9577, "verse_number": "७-४२-५", "content_sanskrit": "प्रियङ्गुभिः कदम्बैश्च तथा च वकुलैरपि ।\nजम्बूभिर्दाडिमैश्चैव कोविदारैश्च शोभिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000577005, "chapter_id": 9577, "verse_number": "७-४२-६", "content_sanskrit": "सर्वदा कुसुमै रम्यैः फलवद्भिर्मनोरमैः ।\nदिव्यगन्धरसोपेतैस्तरुणाङ्कुरपल्लवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000577006, "chapter_id": 9577, "verse_number": "७-४२-७", "content_sanskrit": "तथैव तरुभिर्दिव्यैः शिल्पिभिः परिकल्पितैः ।\nचारुपल्लवपुष्पाढ्यैर्मत्तभ्रमरसङ्कुलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000577007, "chapter_id": 9577, "verse_number": "७-४२-८", "content_sanskrit": "कोकिलैर्भृङ्गराजैश्च नानावर्णैश्च पक्षिभिः ।\nशोभितां शतशश्चित्रां चूतवृक्षावतंसकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000577008, "chapter_id": 9577, "verse_number": "७-४२-९", "content_sanskrit": "शातकुम्भनिभाः केचित्केचिदग्निशिखोपमाः ।\nनीलाञ्जननिभाश्चान्ये भान्ति तत्रत्यपादपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000577009, "chapter_id": 9577, "verse_number": "७-४२-१०", "content_sanskrit": "सुरभीणि च पुष्पाणि माल्यानि विविधानि च ।\nदीर्घिका विविधाकाराः पूर्णाः परमवारिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000577010, "chapter_id": 9577, "verse_number": "७-४२-११", "content_sanskrit": "माणिक्यकृतसोपानाः स्फाटिकान्तरकुट्टिमाः ।\nफुल्लपद्मोत्पलवनाश्चक्रवाकोपशोभिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000577011, "chapter_id": 9577, "verse_number": "७-४२-१२", "content_sanskrit": "दात्यूहशुकसङ्घुष्टा हंससारसनादिताः ।\nतरुभिः पुष्पवद्भिश्च तीरजैरुपशोभिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000577012, "chapter_id": 9577, "verse_number": "७-४२-१३", "content_sanskrit": "प्राकारैर्विविधाकारैः शोभिताश्च शिलातलैः ।\nतत्रैव च वनोद्देशे वैडूर्यमणिसन्निभैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000577013, "chapter_id": 9577, "verse_number": "७-४२-१४", "content_sanskrit": "शाद्वलैः परमोपेतां पुष्पितद्रुमकाननाम् ।\nतत्र सङ्घर्षजातानां वृक्षाणां पुष्पशालिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000577014, "chapter_id": 9577, "verse_number": "७-४२-१५", "content_sanskrit": "प्रस्तराः पुष्पशबला नभस्तारागणैरिव ।\nनन्दनं हि यथेन्द्रस्य ब्राह्मं चैत्ररथं यथा ।\nतथाभूतं हि रामस्य काननं सन्निवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000577015, "chapter_id": 9577, "verse_number": "७-४२-१६", "content_sanskrit": "बह्वासनगृहोपेतां लतागृहसमावृताम् ।\nअशोकवनिकां स्फीतां प्रविश्य रघुनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000577016, "chapter_id": 9577, "verse_number": "७-४२-१७", "content_sanskrit": "आसने च शुभाकारे पुष्पप्रकरभूषिते ।\nकुशास्तरणसंस्तीर्णे रामः सन्निषसाद ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000577017, "chapter_id": 9577, "verse_number": "७-४२-१८", "content_sanskrit": "सीतामादायं हस्तेन मधुमैरेयकं शुचि ।\nपाययामास काकुत्स्थः शचीमिव पुरन्दरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000577018, "chapter_id": 9577, "verse_number": "७-४२-१९", "content_sanskrit": "मांसानि च समृष्टानि फलानि विविधानि च ।\nरामस्याभ्यवहारार्थं किङ्करास्तूर्णमाहरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000577019, "chapter_id": 9577, "verse_number": "७-४२-२०", "content_sanskrit": "उपानृत्यंश्च राजानं नृत्यगीतविशारदाः ।\nबालाश्च रूपवत्यश्च स्त्रियः पानवशानुगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000577020, "chapter_id": 9577, "verse_number": "७-४२-२१", "content_sanskrit": "मनोभिरामा रामास्ता रामो रमयतां वरः ।\nरमयामास धर्मात्मा नित्यं परमभूषितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000577021, "chapter_id": 9577, "verse_number": "७-४२-२२", "content_sanskrit": "स तया सीतया सार्धमासीनो विरराज ह ।\nअरुन्धत्या सहासीनो वसिष्ठ इव तेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000577022, "chapter_id": 9577, "verse_number": "७-४२-२३", "content_sanskrit": "एवं रामो मुदा युक्तः सीतां सुरसुतोपमाम् ।\nरमयामास वैदेहीमहन्यहनि देववत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000577023, "chapter_id": 9577, "verse_number": "७-४२-२४", "content_sanskrit": "तथा तयोर्विहरतोः सीताराघवयोश्चिरम् ।\nअत्यक्रामच्छुभः कालः शैशिरो भोगदः सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000577024, "chapter_id": 9577, "verse_number": "७-४२-२५", "content_sanskrit": "दशवर्षसहस्राणि गतानि सुमहात्मनोः ।\nप्राप्तयोर्विविधान्भोगानतीतः शिशिरागमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000577025, "chapter_id": 9577, "verse_number": "७-४२-२६", "content_sanskrit": "पूर्वाह्णे धर्मकार्याणि कृत्वा धर्मेण धर्मवित् ।\nशेषं दिवसभागार्धमन्तःपुरगतो ऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000577026, "chapter_id": 9577, "verse_number": "७-४२-२७", "content_sanskrit": "सीतापि देवकार्याणि कृत्वा पौर्वाह्णिकानि वै ।\nश्वश्रूणामकरोत्पूजां सर्वासामविशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000577027, "chapter_id": 9577, "verse_number": "७-४२-२८", "content_sanskrit": "अभ्यगच्छत्ततो रामं विचित्राभरणाम्बरा ।\nत्रिविष्टपे सहस्राक्षमुपविष्टं यथा शची ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000577028, "chapter_id": 9577, "verse_number": "७-४२-२९", "content_sanskrit": "दृष्ट्वा तु राघवः पत्नीं कल्याणेन समन्विताम् ।\nप्रहर्षमतुलं लेभे साधु साध्विति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000577029, "chapter_id": 9577, "verse_number": "७-४२-३०", "content_sanskrit": "अब्रवीच्च वरारोहां सीतां सुरसुतोपमाम् ।\nअपत्यलाभो वैदेहि त्वयि मे समुपस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000577030, "chapter_id": 9577, "verse_number": "७-४२-३१", "content_sanskrit": "किमिच्छसि वरारोहे कामः किं क्रियतां तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000577031, "chapter_id": 9577, "verse_number": "७-४२-३२", "content_sanskrit": "स्मितं कृत्वा तु वैदेही रामं वाक्यमथाब्रवीत् ।\nतपोवनानि पुण्यानि द्रष्टुमिच्छामि राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000577032, "chapter_id": 9577, "verse_number": "७-४२-३३", "content_sanskrit": "गङ्गातीरोपविष्टानामृषीणामुग्रतेजसाम् ।\nफलमूलाशिनां देव पादमूलेषु वर्तितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000577033, "chapter_id": 9577, "verse_number": "७-४२-३४", "content_sanskrit": "एष मे परमः कामो यन्मूलफलभोजिनाम् ।\nअप्येकरात्रं काकुत्स्थ निवसेयं तपोवने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000577034, "chapter_id": 9577, "verse_number": "७-४२-३५", "content_sanskrit": "तथेति च प्रतिज्ञातं रामेणाक्लिष्टकर्मणा ।\nविस्रब्धा भव वैदेहि श्वो गमिष्यस्यसंशयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000577035, "chapter_id": 9577, "verse_number": "७-४२-३६", "content_sanskrit": "एवमुक्त्वा तु काकुत्स्थो मैथिलीं जनकात्मजाम् ।\nमध्यकक्षान्तरं रामो निर्जगाम सुहृद्वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000577036, "chapter_id": 9577, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे द्विचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]