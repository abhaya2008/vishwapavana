[{"id": 2040583, "chapter_id": 1899, "verse_number": "५-१४४-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2040584, "chapter_id": 1899, "verse_number": "५-१४४-१", "content_sanskrit": "असिद्धानुनये कृष्णे कुरुभ्यः पाण्डवान्गते।\nअभिगम्य पृथां क्षत्ता शनैः शोचन्निवाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2040585, "chapter_id": 1899, "verse_number": "५-१४४-२", "content_sanskrit": "जानासि मे जीवपुत्री भावं नित्यमविग्रहे ।\nक्रोशतो नच गृह्णीते वचनं मे सुयोधनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2040586, "chapter_id": 1899, "verse_number": "५-१४४-३", "content_sanskrit": "उपपन्नो ह्यसौ राजा चेदिपाञ्चालकेकयैः ।\nभीमार्जुनाभ्यां कृष्णेन युयुधानयमैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2040587, "chapter_id": 1899, "verse_number": "५-१४४-४", "content_sanskrit": "उपप्लाव्ये निविष्टोऽपि धर्ममेव युधिष्ठिरः।\nकाङ्क्षते ज्ञातिसौहार्दाद्बलवान्दुर्बलो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2040588, "chapter_id": 1899, "verse_number": "५-१४४-५", "content_sanskrit": "राजा तु धृतराष्ट्रोऽयं वयोवृद्धो न शाम्यति।\nमत्तः पुत्रमदेनैव विधर्मे पथि वर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2040589, "chapter_id": 1899, "verse_number": "५-१४४-६", "content_sanskrit": "जयद्रथस्य कर्णस्य तथा दुःशासनस्य च।\nसौबलस्य च दुर्बुद्ध्या मिथो भेदः प्रपत्स्यते ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2040590, "chapter_id": 1899, "verse_number": "५-१४४-७", "content_sanskrit": "अधर्मेम हि धर्मिष्ठं ह्रियते राज्यमीदृशम्।\nयेषां तेषामयं धर्मः सानुबन्धो भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2040591, "chapter_id": 1899, "verse_number": "५-१४४-८", "content_sanskrit": "क्रियमाणे बलाद्धर्मे कुरुभिः को न संज्वरेत्।\nअसाम्ना केशवे याते समुद्योक्ष्यन्ति पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2040592, "chapter_id": 1899, "verse_number": "५-१४४-९", "content_sanskrit": "ततः कुरूणामनयो भविता वीरनाशनः।\nचिन्तयन्न लभे निद्रामहःसु च निशासु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2040593, "chapter_id": 1899, "verse_number": "५-१४४-१०", "content_sanskrit": "श्रुत्वा तु कुन्ती तद्वाक्यमर्थकामेन भाषितम्।\nसा निःश्वसन्ती दुःखार्ता मनसा विममर्श ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2040594, "chapter_id": 1899, "verse_number": "५-१४४-११", "content_sanskrit": "धिगस्त्वर्थं यत्कृतेयं सुमहाञ्ज्ञातिसंक्षयः।\nवर्त्स्यते सुहृदां चैव युद्धेऽस्मिन्वै पराभवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2040595, "chapter_id": 1899, "verse_number": "५-१४४-१२", "content_sanskrit": "पाण्डवाश्चेदिपञ्चाला यादवाश्च समागताः।\nभारतैः सह योत्स्यन्ति किं नु दुःखमतःपरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2040596, "chapter_id": 1899, "verse_number": "५-१४४-१३", "content_sanskrit": "पश्ये दोषं ध्रुवं युद्धे तथाऽयुद्धे पराभवम् ।\nअधनस्य मृतं श्रेयो न हि ज्ञातिक्षयो जयः।\nइति मे चिन्तयन्त्या वै हृदि दुःखं प्रवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2040597, "chapter_id": 1899, "verse_number": "५-१४४-१४", "content_sanskrit": "पितामहः शान्तनव आचार्यश्च युधां पतिः।\nकर्णश्च धार्तराष्ट्रार्थं वर्धयन्ति भयं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2040598, "chapter_id": 1899, "verse_number": "५-१४४-१५", "content_sanskrit": "नाचार्यः कामवाञ्शिष्यैद्रौणोयुद्ध्येत जातुचित्।\nपाण्डवेषु कथं हार्दं कुर्यान्न च पितामहः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2040599, "chapter_id": 1899, "verse_number": "५-१४४-१६", "content_sanskrit": "अयं त्वेको वृथादृष्टिर्धार्तराष्ट्रस्य दुर्मतेः।\nमोहानुवर्ती सततं पापो द्वेष्टि च पाण्डवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2040600, "chapter_id": 1899, "verse_number": "५-१४४-१७", "content_sanskrit": "महत्यनर्थे निर्बन्धी बलवांश्च विशेषतः।\nकर्णः सदा पाण्डवानां तन्मे दहति संप्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2040601, "chapter_id": 1899, "verse_number": "५-१४४-१८", "content_sanskrit": "आशंसे त्वद्य कर्णस्य मनोऽहं पाण्डवान्प्रति ।\nग्रसादयितुमासाद्य दर्शयन्ती यथातथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2040602, "chapter_id": 1899, "verse_number": "५-१४४-१९", "content_sanskrit": "तोषितो भगवान्यत्र दुर्वासा मे वरं ददौ ।\nआह्वानं मन्त्रसंयुक्तं वसन्त्याः पितृवेश्मनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2040603, "chapter_id": 1899, "verse_number": "५-१४४-२०", "content_sanskrit": "साहमन्तःपुरे राज्ञः कुन्तिभोजपुरस्कृता ।\nचिन्तयन्ती बहुविधं हृदयेन विदूयता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2040604, "chapter_id": 1899, "verse_number": "५-१४४-२१", "content_sanskrit": "बलाबलं च मन्त्राणां ब्राह्मणस्य च वाग्बलम् ।\nस्त्रीभावाद्बालभावाच्च चिन्तयन्ती पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2040605, "chapter_id": 1899, "verse_number": "५-१४४-२२", "content_sanskrit": "धात्र्या विस्रब्धया गुप्ता सखीजनवृता तदा।\nदोषं परिहरन्ती च पितुश्चारित्र्यरक्षिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2040606, "chapter_id": 1899, "verse_number": "५-१४४-२३", "content_sanskrit": "कथं नु सुकृतं मे स्यान्नापराधवती कथम्।\nभवेयमिति संचिन्त्य ब्राह्मणं तं नमस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2040607, "chapter_id": 1899, "verse_number": "५-१४४-२४", "content_sanskrit": "कौतूहलात्तु तं लब्धा बालिश्यादाचरं तदा।\nकन्या सती देवमर्कमासादयमहं ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2040608, "chapter_id": 1899, "verse_number": "५-१४४-२५", "content_sanskrit": "योऽसौ कानीनगर्भो मे पुत्रवत्परिरक्षितः ।\nकस्मान्न कुर्याद्वचनं पथ्यं भ्रातृहितं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2040609, "chapter_id": 1899, "verse_number": "५-१४४-२६", "content_sanskrit": "इति कुन्ती विनिश्चित्य कार्यनिश्चयमुत्तमम् ।\nकार्यार्थमभिनिश्चित्य ययौ भागीरथीं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2040610, "chapter_id": 1899, "verse_number": "५-१४४-२७", "content_sanskrit": "आत्मजस्य ततस्तस्य घृणिनः सत्यसङ्गिनः ।\nगङ्गातीरे पृथापश्यञ्जपस्थानमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2040611, "chapter_id": 1899, "verse_number": "५-१४४-२८", "content_sanskrit": "प्राङ्मुखस्योर्ध्वबाहोः सा पर्यतिष्ठत पृष्ठतः।\nजप्यावसानं कार्यार्थं प्रतीक्षन्ती तपस्विनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2040612, "chapter_id": 1899, "verse_number": "५-१४४-२९", "content_sanskrit": "अतिष्ठत्सूर्यतापार्ता कर्णस्योत्तरवाससि।\nकौरव्यपत्नी वार्ष्णेयी मद्ममालेव शुष्यती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2040613, "chapter_id": 1899, "verse_number": "५-१४४-३०", "content_sanskrit": "आपृष्ठतापाञ्जप्त्वा स परिवृत्त्य यतव्रतः ।\nदृष्ट्वा कुन्तीमुपातिष्ठदभिवाद्य कृताञ्जलिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2040614, "chapter_id": 1899, "verse_number": "५-१४४-३१", "content_sanskrit": "यथान्यायं महातेजा मानी धर्मभृतां वरः ।\nउत्स्मयन्प्रणतः प्राह कुन्तीं वैकर्तनो वृषः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2040615, "chapter_id": 1899, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि चतुश्चत्वारिंशदधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]