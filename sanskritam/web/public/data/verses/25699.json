[{"id": 7005699000, "chapter_id": 25699, "verse_number": "१७२-१", "content_sanskrit": "विष्णोः प्रादुर्भाव वर्णनम् ।\nमत्स्य उवाच ।\nविष्णुत्वं श्रृणु विष्णोश्च हरित्वञ्च कृते युगे ।\nवैकुण्ठत्वञ्च देवेषु कृष्णत्वं मानुषेषु च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005699001, "chapter_id": 25699, "verse_number": "१७२-२", "content_sanskrit": "ईश्वरस्य हितस्यैषा कर्म्मणां गहनागतिः ।\nसम्प्रत्यतीतान् भव्यांश्च श्रृणु राजन्! यथातथम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005699002, "chapter_id": 25699, "verse_number": "१७२-३", "content_sanskrit": "अव्यक्तो व्यक्तलिङ्गस्थो य एष भगवान् प्रभुः ।\nनारायणोह्यनन्तात्मा प्रभवोऽव्यय एव च ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005699003, "chapter_id": 25699, "verse_number": "१७२-४", "content_sanskrit": "एष नारायणो भूत्वा हरिरासीत् सनातनः ।\nब्रह्मा वायुश्च सोमश्च धर्म्मः शक्रो बृहस्पतिः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005699004, "chapter_id": 25699, "verse_number": "१७२-५", "content_sanskrit": "अदितेरपि पुत्रत्वं समेत्य रविनन्दन! ।\nएष विष्णुरितिख्यात इन्द्रस्यावरजो विभुः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005699005, "chapter_id": 25699, "verse_number": "१७२-६", "content_sanskrit": "प्रसादजं ह्यस्य विभोरदित्याः पुत्रकारणम् ।\nवधार्थं सुरशत्रूणां दैत्यदानवरक्षसाम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005699006, "chapter_id": 25699, "verse_number": "१७२-७", "content_sanskrit": "प्रधानात्मा पुरा ह्येष ब्रह्माणमसृजत् प्रभुः ।\nसोऽसृजत् पूर्वपुरुषः पुराकल्पे प्रजापतीन् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005699007, "chapter_id": 25699, "verse_number": "१७२-८", "content_sanskrit": "असृजन्मानवांस्तत्र ब्रह्मवंशाननुत्तमान् ।\nतेभ्योऽभवन्महात्मभ्यो बहुधा ब्रह्म शाश्वतम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005699008, "chapter_id": 25699, "verse_number": "१७२-९", "content_sanskrit": "एतदाश्चर्यभूतस्य विष्णोः कर्मानुकीर्तनम् ।\nकीर्तनीयस्य लोकेषु कीर्त्यमानं निबोध मे ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005699009, "chapter_id": 25699, "verse_number": "१७२-१०", "content_sanskrit": "वृत्ते वृत्रवधे तत्र वर्तमाने कृते युगे ।\nआसीत्त्रैलोक्य विख्यातः सङ्ग्रामस्तारकामयः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005699010, "chapter_id": 25699, "verse_number": "१७२-११", "content_sanskrit": "यत्र ते दानवा घोराः सर्वे सङ्ग्रामदुर्जयाः ।\nघ्नन्तिदेवगणान् सर्वान् सयक्षोरगराक्षसान् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005699011, "chapter_id": 25699, "verse_number": "१७२-१२", "content_sanskrit": "ते वध्यमाना विमुखाः क्षीणप्रहरणा रणे ।\nत्रातारं मनसा जग्मुर्देवं नारायणं प्रभुः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005699012, "chapter_id": 25699, "verse_number": "१७२-१३", "content_sanskrit": "एतस्मिन्नन्तरे मेघा निर्वाणाङ्गारवर्चसः ।\nसार्कचन्द्रग्रहगणं छादयन्तोः नभस्तलम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005699013, "chapter_id": 25699, "verse_number": "१७२-१४", "content_sanskrit": "वेणुर्विद्युद् गणोपेता घोरनिह्राद कारिणः ।\nअन्योन्य- वेगाम्भिहताः प्रववुः सप्त मारुताः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005699014, "chapter_id": 25699, "verse_number": "१७२-१५", "content_sanskrit": "दीप्त तोयाशनिघनैर्वज्रवेगानलानिलैः ।\nरवैः सुघोरैरुत्पातैर्दह्यमानमिवाम्बरम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005699015, "chapter_id": 25699, "verse_number": "१७२-१६", "content_sanskrit": "तत उल्कासहस्राणि निपेतुः खगतान्यपि ।\nदिव्यानि च विमानानि प्रपतन्त्युत्पतन्ति च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005699016, "chapter_id": 25699, "verse_number": "१७२-१७", "content_sanskrit": "चतुर्युगान्ते पर्याये लोकानां यद्भयं भवेत् ।\nअरूपवन्ति रूपाणि तस्मिन्नुत्पात लक्षणे ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005699017, "chapter_id": 25699, "verse_number": "१७२-१८", "content_sanskrit": "जातञ्च निष्प्रभं सर्वं न प्राज्ञायत किञ्चन ।\nतिमिरौघपरिक्षिप्ता न रेजुश्च दिशो दश ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005699018, "chapter_id": 25699, "verse_number": "१७२-१९", "content_sanskrit": "विवेश रूपिणी काली कालमेघावगुण्ठिता ।\nद्यौर्न भात्यभिभूतार्का घोरेण तमसा वृता ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005699019, "chapter_id": 25699, "verse_number": "१७२-२०", "content_sanskrit": "तान् घनौघान् सतिमिरान् दोर्भ्यामाक्षिप्य स प्रभुः ।\nवपुः सर्वं दर्शयामास दिव्यं कृष्णवपुर्हरिः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005699020, "chapter_id": 25699, "verse_number": "१७२-२१", "content_sanskrit": "बलाहकाञ्जनमिमं बलाहकतनूरुहम् ।\nतेजसा वपुषा चैव कृष्णं कृष्णमिवाचलम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005699021, "chapter_id": 25699, "verse_number": "१७२-२२", "content_sanskrit": "दीप्ता पीताम्बरधरं तप्तकाञ्चन भूषणम् ।\nधूमान्धकारवपुषं युगान्ताग्निमिवोत्थितम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005699022, "chapter_id": 25699, "verse_number": "१७२-२३", "content_sanskrit": "चतुर्द्विगुणपीनांसं किरीटच्छन्नमूर्द्धजम् ।\nबभौ चामीरप्रख्यै रायुधैरुपशोभितम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005699023, "chapter_id": 25699, "verse_number": "१७२-२४", "content_sanskrit": "चन्द्रार्क किरणोद्योतं गिरिकूटमिवोच्छ्रितम् ।\nनन्दकानन्दितकरं शराशी विष धारिणम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005699024, "chapter_id": 25699, "verse_number": "१७२-२५", "content_sanskrit": "शक्तिचित्रफलोदग्र शङ्ख चक्र गदाधरम् ।\nविष्णुशैलं क्षमामूलं श्रीवृक्षं शार्ङ्गधन्विनम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005699025, "chapter_id": 25699, "verse_number": "१७२-२६", "content_sanskrit": "त्रिदशोदारफलदं स्वर्गस्त्रीचारुपल्लवम् ।\nसर्वलोकमनः कान्तं सर्वसत्वमनोहरम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005699026, "chapter_id": 25699, "verse_number": "१७२-२७", "content_sanskrit": "नानाविमानविटपन्तोयदाम्बु मधुस्रवम् ।\nविद्याहङ्कारसाराद्यं महाभूत प्ररोहणम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005699027, "chapter_id": 25699, "verse_number": "१७२-२८", "content_sanskrit": "विशेषपत्रैर्निचितं ग्रहनक्षत्र पुष्पितम् ।\nदैत्यलोकमहास्कन्धं मर्त्यलोके प्रकाशितम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005699028, "chapter_id": 25699, "verse_number": "१७२-२९", "content_sanskrit": "सागराकारनिर्हादं रसातल महाश्रयम् ।\nमृगेन्द्रपाशैर्विततं पक्षजन्तु निषेवितम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005699029, "chapter_id": 25699, "verse_number": "१७२-३०", "content_sanskrit": "शीलार्थ चारु गन्धाढ्यं सर्वलोकमहाद्रुमम् ।\nअव्यक्तानन्तसलिलं व्यक्ताहङ्कारफेनिलम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005699030, "chapter_id": 25699, "verse_number": "१७२-३१", "content_sanskrit": "महाभूततरङ्गौघं ग्रहनक्षत्र बुद्बुदम् ।\nविमानगरुतव्याप्तं तोयदाडम्बरा कुलम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005699031, "chapter_id": 25699, "verse_number": "१७२-३२", "content_sanskrit": "जन्तुमत्सजनाकीर्णं शैल शङ्ख कुलैर्युतम् ।\nत्रैगुण्यविषयावर्तं सर्वलोक तिमिङ्गिलम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005699032, "chapter_id": 25699, "verse_number": "१७२-३३", "content_sanskrit": "वीरवृक्षलतागुल्मं भुजगोत्कृष्ट शैवलम् ।\nद्वादशार्कमहाद्वीपं रुद्रैकादश पत्तनम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005699033, "chapter_id": 25699, "verse_number": "१७२-३४", "content_sanskrit": "वस्वष्ट पर्वतोपेतं त्रैलोक्याम्भो महोदधिम् ।\nसन्ध्या सङ्ख्योर्मि सलिलं सुपर्णानिल सेवितम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005699034, "chapter_id": 25699, "verse_number": "१७२-३५", "content_sanskrit": "दैत्यरक्षोगणग्राहं यक्षोरग झषाकुलम् ।\nपितामहमहावीर्य्यं सर्वस्त्री रत्नशोभितम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005699035, "chapter_id": 25699, "verse_number": "१७२-३६", "content_sanskrit": "श्रीर्कीर्तिकान्तिलक्ष्मीभिर्नदीभिरुपशोभितम् ।\nकालयोगि महापर्व प्रलयोत्पत्ति वेगिनम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005699036, "chapter_id": 25699, "verse_number": "१७२-३७", "content_sanskrit": "तन्तु योगमहापारं नारायणमहार्णवम् ।\nदेवाधिदेवं वरदं भक्तानां भक्ति वत्सलम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005699037, "chapter_id": 25699, "verse_number": "१७२-३८", "content_sanskrit": "अनुग्रहकरं देवं प्रशान्तिकरणं शुभम् ।\nहर्यश्वरथसंयुक्ते सुपर्णध्वजसेविते ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005699038, "chapter_id": 25699, "verse_number": "१७२-३९", "content_sanskrit": "ग्रहचन्द्रार्करचिते मन्दराक्ष-वरावृते ।\nअनन्तरश्मिभिर्युक्ते विस्तीर्णे मेरुगह्वरे ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005699039, "chapter_id": 25699, "verse_number": "१७२-४०", "content_sanskrit": "तारकाचित्रकुसुमे ग्रहनक्षत्रबन्धुरे ।\nभयेष्वभयदं व्योम्नि देवा दैत्यपराजिताः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005699040, "chapter_id": 25699, "verse_number": "१७२-४१", "content_sanskrit": "ददृशुस्तेस्थितं देवं दिव्ये लोकमये रथे ।\nते कृताञ्जलयः सर्वे देवाः शक्रपुरोगमाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005699041, "chapter_id": 25699, "verse_number": "१७२-४२", "content_sanskrit": "जयशब्दं पुरस्कृत्य शरण्यं शरणङ्गताः ।\nस तेषां ताङ्गिरं श्रुत्वा विष्णुर्दैवत दैवतम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005699042, "chapter_id": 25699, "verse_number": "१७२-४३", "content_sanskrit": "मनश्चक्रे विनाशाय दानवानां महामृधे ।\nआकाशे तु स्थितो विष्णुरुत्तमं वपुरास्थितः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005699043, "chapter_id": 25699, "verse_number": "१७२-४४", "content_sanskrit": "उवाच देवताः सर्वाः सप्रतिज्ञमिदं वचः ।\nशान्तिं व्रजत भद्रं वो मा भैष्ट मरुताङ्गणाः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005699044, "chapter_id": 25699, "verse_number": "१७२-४५", "content_sanskrit": "जिता मे दानवाः सर्वे त्रैलोक्यं परिगृह्यताम् ।\nते तस्य सत्यसन्धस्य विष्णोर्वाक्येन तोषिताः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005699045, "chapter_id": 25699, "verse_number": "१७२-४६", "content_sanskrit": "देवाः प्रीतिं समाजग्मुः प्राश्यामृतमनुत्तमम् ।\nततस्तमः संहृतं तद्विनेशुश्च बलाहकाः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005699046, "chapter_id": 25699, "verse_number": "१७२-४७", "content_sanskrit": "प्रववुश्च शिवा वाताः प्रशान्ताश्च दिशो दश ।\nशुद्धप्रभाणि ज्योतींषि सोमञ्चक्रुः प्रदक्षिणम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005699047, "chapter_id": 25699, "verse_number": "१७२-४८", "content_sanskrit": "न विग्रहं ग्रहाश्चक्रुः प्रशान्ताश्चापि सिन्धवः ।\nविरजस्का भवन्मार्गा नाकवर्गादयस्त्रयः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005699048, "chapter_id": 25699, "verse_number": "१७२-४९", "content_sanskrit": "यथार्थमूहुः सरितो नापि चुक्षुभिरेऽर्णवाः ।\nआसंश्छुभानीन्द्रियाणि नराणामन्तरात्मसु ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005699049, "chapter_id": 25699, "verse_number": "१७२-५०", "content_sanskrit": "महर्षयो वीतशोका वेदानुच्चैरधीयत ।\nयज्ञेषु च हविः पाकं शिवमाप च पावकः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005699050, "chapter_id": 25699, "verse_number": "१७२-५१", "content_sanskrit": "प्रवृत्तधर्माः संवृत्ता लोका मुदितमानसाः ।\nविष्णोर्दत्तप्रतिज्ञस्य श्रुत्वारि-निधने गिरम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]