[{"id": 7000332000, "chapter_id": 20332, "verse_number": "२-४-१", "content_sanskrit": "सूत उवाच ।\nगतेषु तेषु गोलोकं वैष्णवं तमसः परम् ।\nशिवशर्मा महाप्राज्ञः कनिष्ठं वाक्यमब्रवीत्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000332001, "chapter_id": 20332, "verse_number": "२-४-२", "content_sanskrit": "ब्राह्मण उवाच ।\nसोमशर्मन्महाप्राज्ञ त्वं पितुर्भक्तितत्परः ।\nअमृतस्य महाकुंभं रक्ष दत्तं मयाधुना॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000332002, "chapter_id": 20332, "verse_number": "२-४-३", "content_sanskrit": "तीर्थयात्रां प्रयास्यामि अनया भार्यया सह ।\nएवमस्तु महाभाग करिष्ये रक्षणं शुभम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000332003, "chapter_id": 20332, "verse_number": "२-४-४", "content_sanskrit": "कुंभं दत्वा स मेधावी तस्य हस्ते महात्मनः ।\nदशवर्षप्रमाणं तु तपस्तेपे निरंतरम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000332004, "chapter_id": 20332, "verse_number": "२-४-५", "content_sanskrit": "कुंभं रक्षति धर्मात्मा दिवारात्रमतंद्रितः ।\nपुनः स हि समायातः शिवशर्मा महायशाः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000332005, "chapter_id": 20332, "verse_number": "२-४-६", "content_sanskrit": "मायां कृत्वा महाप्राज्ञो भार्यया सह तं सुतम् ।\nकुष्ठरोगातुरो भूत्वा तस्य भार्या च तादृशी॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000332006, "chapter_id": 20332, "verse_number": "२-४-७", "content_sanskrit": "मांसपिंडोपमौ जातौ द्वावेतौ मायया कृतौ ।\nसंनिधिं तस्य घोरस्य विप्रस्य सोमशर्मणः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000332007, "chapter_id": 20332, "verse_number": "२-४-८", "content_sanskrit": "समागतौ हि तौ दृष्ट्वा सर्वतो हि सुदुःखितौ ।\nकृपया परयाविष्टः सोमशर्मा महायशाः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000332008, "chapter_id": 20332, "verse_number": "२-४-९", "content_sanskrit": "तयोः पादं नमस्कृत्य भक्त्या नमितकंधरः ।\nभवादृशौ न पश्यामि तपसाभिसमन्वितम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000332009, "chapter_id": 20332, "verse_number": "२-४-१०", "content_sanskrit": "गुणव्रातैः सुपुण्यैश्च किमिदं वर्तितं त्वयि ।\nदासवद्देवताः सर्वा वर्तंते सर्वदा तव॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000332010, "chapter_id": 20332, "verse_number": "२-४-११", "content_sanskrit": "आदेशं प्राप्य विप्रेंद्र आकृष्टास्तेजसा तव ।\nतवांगे केन पापेन गदोयं वेदनान्वितः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000332011, "chapter_id": 20332, "verse_number": "२-४-१२", "content_sanskrit": "संजातो ब्राह्मणश्रेष्ठ तन्मे कथय कारणम् ।\nइयं पुण्यवती माता महापुण्या पतिव्रता॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000332012, "chapter_id": 20332, "verse_number": "२-४-१३", "content_sanskrit": "या हि भर्तृप्रसादेन त्रैलोक्यं कर्तुमिच्छति ।\nसा कथं दुःखमाप्नोति किं नास्ति तपसः फलम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000332013, "chapter_id": 20332, "verse_number": "२-४-१४", "content_sanskrit": "रागद्वेषौ परित्यज्य विविधेनापि कर्मणा ।\nया च शुश्रूषते कांतं देववद्गुरुवत्सला॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000332014, "chapter_id": 20332, "verse_number": "२-४-१५", "content_sanskrit": "सा कथं दुःखमाप्नोति कुष्ठरोगं सुदुःखदम् ।\nशिवशर्मोवाच ।\nमा शुचस्त्वं महाभाग भुज्यते कर्मजं फलम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000332015, "chapter_id": 20332, "verse_number": "२-४-१६", "content_sanskrit": "नरेण कर्मयुक्तेन पापपुण्यमयेन हि ।\nशोधनं च कुरुष्व त्वमुभयो रोगयुक्तयोः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000332016, "chapter_id": 20332, "verse_number": "२-४-१७", "content_sanskrit": "शुश्रूषणं महाभाग यदि पुण्यमिहेच्छसि ।\nएवमुक्ते शुभे वाक्ये सोमशर्मा महायशाः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000332017, "chapter_id": 20332, "verse_number": "२-४-१८", "content_sanskrit": "शुश्रूषां वा करिष्यामि युवयोः पुण्ययुक्तयोः ।\nमया पापेन दुष्टेन कृपणेन द्विजोत्तम॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000332018, "chapter_id": 20332, "verse_number": "२-४-१९", "content_sanskrit": "किं कर्तव्यमिहाद्यैव यो गुरुं न हि पूजयेत् ।\nएवमाभाष्य दुःखाद्वा तयोर्दुःखेन दुःखितः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000332019, "chapter_id": 20332, "verse_number": "२-४-२०", "content_sanskrit": "श्लेष्ममूत्रपुरीषं च उभयोः पर्यशोधयत् ।\nपादप्रक्षालनं चक्रे अंगसंवाहनं तथा॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000332020, "chapter_id": 20332, "verse_number": "२-४-२१", "content_sanskrit": "स्नानस्थानादिकं सोपि तयोर्भक्त्यान्वितः स्वयम् ।\nद्वावेतौ हि गुरू विप्रः सोमशर्मा महायशाः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000332021, "chapter_id": 20332, "verse_number": "२-४-२२", "content_sanskrit": "तीर्थं नयति धर्मात्मा स्कंधमारोप्य सत्तमः ।\nद्वावेतौ हि स्वहस्तेन स्नापयित्वा तु मंगलैः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000332022, "chapter_id": 20332, "verse_number": "२-४-२३", "content_sanskrit": "सुमंत्रैर्वेदविच्चैव स्नानस्य विधिपूर्वकम् ।\nतर्पणं च पितॄणां तु देवतानां तु पूजनम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000332023, "chapter_id": 20332, "verse_number": "२-४-२४", "content_sanskrit": "द्वाभ्यामपि स धर्मात्मा स कारयति नित्यशः ।\nस्वयं होमं ददात्यग्नौ पचत्यन्नमनुत्तमम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000332024, "chapter_id": 20332, "verse_number": "२-४-२५", "content_sanskrit": "संज्ञापयति सुप्रीतौ द्वावेतौ च महागुरू ।\nशय्यासने च तौ विप्रः प्रस्वापयति नित्यशः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000332025, "chapter_id": 20332, "verse_number": "२-४-२६", "content_sanskrit": "वस्त्रपुष्पादिकं सर्वं ताभ्यां नित्यं प्रयच्छति ।\nतांबूलं बहुगंधाढ्यमुभयोरर्पयेत्स तु॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000332026, "chapter_id": 20332, "verse_number": "२-४-२७", "content_sanskrit": "सोमशर्मा महाभागस्ताभ्यामपि च पूरयेत् ।\nमूलं पयः सुभक्ष्याद्यं नित्यमेव ददात्यसौ॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000332027, "chapter_id": 20332, "verse_number": "२-४-२८", "content_sanskrit": "तयोस्तु वांछितं नित्यं सोमशर्मा महायशाः ।\nअनेन क्रमयोगेन नित्यमेव प्रसादयेत्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000332028, "chapter_id": 20332, "verse_number": "२-४-२९", "content_sanskrit": "सोमशर्मा सुधर्मात्मा पितरौ परिपूजयेत् ।\nसोमशर्माणमाहूय पिता कुत्सति निष्ठुरः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000332029, "chapter_id": 20332, "verse_number": "२-४-३०", "content_sanskrit": "निंदितैर्निष्ठुरैर्वाक्यैस्ताडयेन्मुनिसन्निधौ ।\nकृतकार्ये कृते पुण्ये नित्यमेव सुते पुनः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000332030, "chapter_id": 20332, "verse_number": "२-४-३१", "content_sanskrit": "न कृतं शोभनं मह्यं त्वयैव कुलपांसन ।\nएवं नानाविधैर्वाक्यैर्निष्ठुरैर्दुःखदायकैः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000332031, "chapter_id": 20332, "verse_number": "२-४-३२", "content_sanskrit": "अताडयद्दंडघातैः शिवशर्मा सदातुरः ।\nएवं कृतेपि धर्मात्मा नैव कुप्यति कर्हिचित्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000332032, "chapter_id": 20332, "verse_number": "२-४-३३", "content_sanskrit": "मनसा वचसा चैव कर्मणा त्रिविधेन च ।\nसंतुष्टः सर्वदा सोपि पितरं परिपूजयेत्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000332033, "chapter_id": 20332, "verse_number": "२-४-३४", "content_sanskrit": "तद्वत्स सोमशर्मा वै मातरं च दिनेदिने ।\nयज्ज्ञात्वा शिवशर्मा च चरितं स्वीयमीक्षते॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000332034, "chapter_id": 20332, "verse_number": "२-४-३५", "content_sanskrit": "अमृतं मत्कृते चापि आनीतं विष्णुशर्मणा ।\nपुण्ययुक्तः स धर्मात्मा पितृभक्तिपरः सदा॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000332035, "chapter_id": 20332, "verse_number": "२-४-३६", "content_sanskrit": "एवं बहुतिथे काले शतसंख्ये गते सति ।\nशिवशर्मा पितस्यैव भक्तिं दृष्ट्वा विचिंत्य वै॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000332036, "chapter_id": 20332, "verse_number": "२-४-३७", "content_sanskrit": "मया वै पूर्वमित्युक्तं सुपुत्रं यज्ञसंज्ञकम् ।\nमातृखंडानिमान्पुत्र यत्र तत्र क्षिपस्व हि॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000332037, "chapter_id": 20332, "verse_number": "२-४-३८", "content_sanskrit": "मद्वाक्यं पालितं तेन कृता न मातरि कृपा ।\nएतत्स्वल्पतरं दुःखं निर्जीवे घातमिच्छतः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000332038, "chapter_id": 20332, "verse_number": "२-४-३९", "content_sanskrit": "साहसं तु कृतं तेन पुत्रेण वेदशर्मणा ।\nअस्याधिकमहं मन्ये यतोऽयं चलते न च॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000332039, "chapter_id": 20332, "verse_number": "२-४-४०", "content_sanskrit": "निमेषमात्रमेवापि साहसं कारयेत्पुनः ।\nअपरं सत्यसंपन्नं प्रभावं तपसः पुनः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000332040, "chapter_id": 20332, "verse_number": "२-४-४१", "content_sanskrit": "नित्यं समाराधनेपि अधिकं चास्य दृश्यते ।\nतस्मादस्य परीक्षा च समये तपसः कृता॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000332041, "chapter_id": 20332, "verse_number": "२-४-४२", "content_sanskrit": "भक्तिभावात्तथा सत्यान्नैव पुत्रः प्रणश्यति ।\nमायया च निजांगेऽपि कुष्ठरोगो निदर्शितः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000332042, "chapter_id": 20332, "verse_number": "२-४-४३", "content_sanskrit": "श्लेष्ममूत्रमलानां च घृणां नैव करोति च ।\nव्रणान्विशोधयेन्नित्यं स्वहस्तेन महायशाः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000332043, "chapter_id": 20332, "verse_number": "२-४-४४", "content_sanskrit": "पादसंवाहनं दद्याच्छौचं चैव महामतिः ।\nदुःसहं वचनं मह्यं दारुणं सहते सदा॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000332044, "chapter_id": 20332, "verse_number": "२-४-४५", "content_sanskrit": "भर्त्सने ताडने चैव सदाभीष्टप्रवाचकः ।\nएवं दुःखसमाचारो मम पुत्रो महामतिः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000332045, "chapter_id": 20332, "verse_number": "२-४-४६", "content_sanskrit": "दुःखानां सागरं मन्ये बहुक्लेशैस्तु क्लेशितः ।\nअपनेष्याम्यहं दुःखं विष्णोश्चैव प्रसादतः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000332046, "chapter_id": 20332, "verse_number": "२-४-४७", "content_sanskrit": "विचार्य मनसा विप्रः शिवशर्मा महामतिः ।\nपुनर्मायां चकाराथ कुंभादपहृतं पयः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000332047, "chapter_id": 20332, "verse_number": "२-४-४८", "content_sanskrit": "पश्चात्तं च समाहूय सोमशर्माणमब्रवीत् ।\nतव हस्ते मया दत्तममृतं व्याधिनाशनम्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000332048, "chapter_id": 20332, "verse_number": "२-४-४९", "content_sanskrit": "तन्मे शीघ्रं प्रयच्छस्व यथा पानं करोम्यहम् ।\nयेन नीरुग्भवाम्यद्य प्रसादाद्विष्णुशर्मणः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000332049, "chapter_id": 20332, "verse_number": "२-४-५०", "content_sanskrit": "एवमुक्ते तदा वाक्ये ऋषिणा शिवशर्मणा ।\nसमुत्थाय त्वरायुक्तः सोमशर्मा कमंडलुम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000332050, "chapter_id": 20332, "verse_number": "२-४-५१", "content_sanskrit": "तं च रिक्तं ततो दृष्ट्वा ह्यमृतेन विना कृतम् ।\nकस्य पापस्य वै कर्म केन मे विप्रियं कृतम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000332051, "chapter_id": 20332, "verse_number": "२-४-५२", "content_sanskrit": "इति चिंतापरो भूत्वा सोमशर्मा सुदुःखितः ।\nपितुरग्रे च वृत्तांतं कथयिष्याम्यहं यदा॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000332052, "chapter_id": 20332, "verse_number": "२-४-५३", "content_sanskrit": "ततः कोपं प्रयास्येत गुरुर्मे व्याधिपीडितः ।\nसुचिरं चिंतयित्वा तु सोमशर्मा महामतिः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000332053, "chapter_id": 20332, "verse_number": "२-४-५४", "content_sanskrit": "यदि मे सत्यमस्तीति गुरुशुश्रूषणं यदि ।\nतपस्तप्तं मयापूर्वं निर्व्यलीकेन चेतसा॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000332054, "chapter_id": 20332, "verse_number": "२-४-५५", "content_sanskrit": "दमशौचादिभिः सत्यं धर्ममेव प्रपालितम् ।\nतदा घटोऽमृतयुतो भवत्वेष न संशयः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000332055, "chapter_id": 20332, "verse_number": "२-४-५६", "content_sanskrit": "यावदेव महाभागश्चिंतयित्वा विलोकयेत् ।\nतावच्चामृतपूर्णस्तु पुनरेवाभवद्घटः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000332056, "chapter_id": 20332, "verse_number": "२-४-५७", "content_sanskrit": "तं दृष्ट्वा हर्षसंयुक्तः सोमशर्मा महायशाः ।\nगत्वा गुरुं नमस्कृत्य कुंभमादाय सत्वरम्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000332057, "chapter_id": 20332, "verse_number": "२-४-५८", "content_sanskrit": "गृहाण त्वं पितश्चेमं पयः कुंभं समागतम् ।\nपानं कुरु महाभाग गदान्मुक्तो भवाचिरम्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000332058, "chapter_id": 20332, "verse_number": "२-४-५९", "content_sanskrit": "एतद्वाक्यं महापुण्यं सत्यधर्मार्थकं पुनः ।\nशिवशर्मा सुतस्यापि श्रुत्वा च मधुराक्षरम्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000332059, "chapter_id": 20332, "verse_number": "२-४-६०", "content_sanskrit": "हर्षेण महताविष्ट इदं वचनमब्रवीत्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]