[{"id": 2051998, "chapter_id": 2149, "verse_number": "७-७६-०x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2051999, "chapter_id": 2149, "verse_number": "७-७६-१", "content_sanskrit": "षड्रथान्धार्तराष्ट्रस्य मन्यसे यान्बलाधिकान्।\nतेषां वीर्यं ममार्धेन न तुल्यमिति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2052000, "chapter_id": 2149, "verse_number": "७-७६-२", "content_sanskrit": "अस्त्रमस्त्रेण सर्वेषामेतेषां मधुसूदन।\nमया द्रक्ष्यसि निर्भिन्नं जयद्रथवधैषिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2052001, "chapter_id": 2149, "verse_number": "७-७६-३", "content_sanskrit": "द्रोणस्य मिषतश्चाहं सगणस्य विपश्चितः।\nमूर्धानं सिन्धुराजस्य पातयिष्यामि भूतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2052002, "chapter_id": 2149, "verse_number": "७-७६-४", "content_sanskrit": "यदि साध्याश्च रुद्राश्च वसवश्च सहाश्विनः।\nमरुतश्च सहेन्द्रेण विश्वेदेवाः सहेश्वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2052003, "chapter_id": 2149, "verse_number": "७-७६-५", "content_sanskrit": "पितरः सहगन्धर्वाः सुपर्णाः सागराद्रयः।\nद्यौर्वियत्पृथिवी चेयं दिशश्च सदिगीश्वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2052004, "chapter_id": 2149, "verse_number": "७-७६-६", "content_sanskrit": "ग्राम्यारण्यानि भूतानि स्थावराणि चराणि च।\nत्रातारः सिन्धुराजस्य भवन्ति मधुसूदन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2052005, "chapter_id": 2149, "verse_number": "७-७६-७", "content_sanskrit": "तथापि बाणैर्निहतं श्वो द्रष्टासि रणे मया।\nसत्येन च शपे कृष्ण तथैवायुधमालभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2052006, "chapter_id": 2149, "verse_number": "७-७६-८", "content_sanskrit": "यस्य गोप्ता महेष्वासो द्रोणः पापस्य दुर्मतेः।\nतमेव प्रथमं द्रोणमभियास्यामि केशव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2052007, "chapter_id": 2149, "verse_number": "७-७६-९", "content_sanskrit": "तस्मिन्युद्धमिदं बद्धं मन्यते स सुयोधनः।\nतस्मात्तस्यैव सेनाग्रं भित्त्वा यास्यामि सैन्धवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2052008, "chapter_id": 2149, "verse_number": "७-७६-१०", "content_sanskrit": "द्रष्टासि श्वो महेष्वासान्नाराचैस्तिग्मतेजितैः।\nशृङ्गाणीव गिरेर्वज्रैर्दार्यमाणान्मया युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2052009, "chapter_id": 2149, "verse_number": "७-७६-११", "content_sanskrit": "नरनागाश्वदेहेभ्यो विस्रविष्यति शोणितम्।\nपतद्ध्यः पतितेभ्यश्च विभिन्नेभ्यः शितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2052010, "chapter_id": 2149, "verse_number": "७-७६-१२", "content_sanskrit": "गाण्डीवप्रेषिता बाणा मनोऽनिलसमा जवे।\nनृनागाश्वान्विदेहासून्कर्तारश्च सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2052011, "chapter_id": 2149, "verse_number": "७-७६-१३", "content_sanskrit": "शक्राद्भीष्मात्कृपाद्द्रोणाद्देवाद्रुद्राच्च यन्मया।\nउपात्तमस्त्रं घोरं तद्दष्टारोऽत्र नरा युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2052012, "chapter_id": 2149, "verse_number": "७-७६-१४", "content_sanskrit": "ब्राह्मेणास्त्रेण चास्त्राणि हन्यमानानि संयुगे।\nमया द्रष्टाऽसि सर्वेषां सैन्धवस्याभिरक्षिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2052013, "chapter_id": 2149, "verse_number": "७-७६-१५", "content_sanskrit": "शरवेगसमुत्कृत्तै राज्ञां केशव मूर्धभिः।\nआस्तीर्यमाणां पृथिवीं द्रष्टाऽसि श्वो मया युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2052014, "chapter_id": 2149, "verse_number": "७-७६-१६", "content_sanskrit": "क्रव्यादांस्तर्पयिष्यामि द्रावयिष्यामि शात्रवान्।\nसुहृदो नन्दयिष्यामि प्रमथिष्यामि सैन्धवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2052015, "chapter_id": 2149, "verse_number": "७-७६-१७", "content_sanskrit": "बह्वागस्कृत्कुसंबन्धी पापदेशसमुद्भवः।\nमया सैन्धवको राजा हतः स्वाञ्शोचयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2052016, "chapter_id": 2149, "verse_number": "७-७६-१८", "content_sanskrit": "सर्वे क्षीरान्नभोक्तारः पापाचारा रणाजिरे।\nमया सराजका बाणैर्हता नश्यन्ति सैन्धवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2052017, "chapter_id": 2149, "verse_number": "७-७६-१९", "content_sanskrit": "तथा प्रभाते कर्ताऽस्मि यथा कृष्ण सुयोधनः।\nनान्यं धनुर्धरं लोके मंस्यते मत्समं युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2052018, "chapter_id": 2149, "verse_number": "७-७६-२०", "content_sanskrit": "`गाण्डीवं च धनुर्दिव्यं योद्धारं च धनञ्जम्।\nयन्तारं च हृषीकेशं कोऽतिवर्तेत संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2052019, "chapter_id": 2149, "verse_number": "७-७६-२१", "content_sanskrit": "तव प्रसादाद्भगवन्किंनावाप्तं रणे मम।\nअविषह्यं हृषीकेश किं जानन्मां विगर्हसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2052020, "chapter_id": 2149, "verse_number": "७-७६-२२", "content_sanskrit": "यथा लक्ष्म स्थिरं चन्द्रे समुद्रे च यथा जलम्।\nएवमेतां प्रतिज्ञां मे सत्यां विद्धि जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2052021, "chapter_id": 2149, "verse_number": "७-७६-२३", "content_sanskrit": "मावमंस्था ममास्त्राणि मावमंस्थाश्च गाण्डिवम्।\nमावमंस्था बलं बाह्वोर्मावमंस्था धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2052022, "chapter_id": 2149, "verse_number": "७-७६-२४", "content_sanskrit": "गाण्डीवं च धनुर्दिव्यं योद्धा चाहं नरर्षभ।\nत्वं च यन्ता हृषीकेश किन्नु स्यादजितं मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2052023, "chapter_id": 2149, "verse_number": "७-७६-२५", "content_sanskrit": "यथाभियाय सङ्ग्रमं न जितो वै जयामि च।\nतेन सत्येन सङ्ग्रामे हतं विद्धि जयद्रथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2052024, "chapter_id": 2149, "verse_number": "७-७६-२६", "content_sanskrit": "`त्वं च माधव सर्वं तत्तथा प्रतिविधास्यसि।\nयथा रिपूणां मिषतां प्रमथिष्यामि सैन्धवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2052025, "chapter_id": 2149, "verse_number": "७-७६-२७", "content_sanskrit": "ध्रुवं वै ब्राह्मणे सत्यं ध्रुवा साधुषु सन्नतिः।\nश्रीर्ध्रुवाऽपि च दक्षेषु ध्रुवो नारायणे जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2052026, "chapter_id": 2149, "verse_number": "७-७६-२८x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2052027, "chapter_id": 2149, "verse_number": "७-७६-२८", "content_sanskrit": "एवमुक्त्वा हृषीकेशं स्वयमात्मानमात्मना।\nसन्दिदेशार्जुनो नर्दन्वासविः केशवं प्रभुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2052028, "chapter_id": 2149, "verse_number": "७-७६-२९", "content_sanskrit": "यथा प्रभातां रजनीं कल्पितः स्याद्रथोत्तमः।\nतथा कार्यं त्वया कृष्ण प्रतिज्ञा स्याद्यथा ध्रुवा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2052029, "chapter_id": 2149, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि प्रतिज्ञापर्वणि षट्सप्ततितमोऽध्यायः॥ ७६ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-७६-९ तस्मिन् द्रोणे। युद्धं बद्धमिव बद्धं एकान्तजयेन स्थिरीकृतम् ॥ ५-७६-७६ षट्सप्ततितमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]