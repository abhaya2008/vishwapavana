[{"id": 2088636, "chapter_id": 2893, "verse_number": "१३-२३-१", "content_sanskrit": "`भीष्य उवाच।\nश्रुत्वा तु वचनं मातुः क्रुद्धायास्ते भुजङ्गमाः।\nकृच्छ्रेणैवान्वमोदन्त केचिद्धित्वा दिशो गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2088637, "chapter_id": 2893, "verse_number": "१३-२३-२", "content_sanskrit": "ये प्रतस्थुर्दिशस्तत्र क्रुद्धा तानशपद्भृशम्।\nभुजङ्गमानां माताऽसौ कद्रूर्वैरकरी तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2088638, "chapter_id": 2893, "verse_number": "१३-२३-३", "content_sanskrit": "उत्पत्स्यति हि राजन्यः पाण्डवो जनमेजयः।\nचतुर्थो धन्विनां श्रेष्ठात्कुन्तीपुत्राद्धनञ्जयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2088639, "chapter_id": 2893, "verse_number": "१३-२३-४", "content_sanskrit": "स सर्पसत्रमाहर्ता क्रुद्धः कुरुकुलोद्वहः।\nतस्मिन्सत्रेऽग्निना युष्मान्पञ्चत्वमुपनेष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2088640, "chapter_id": 2893, "verse_number": "१३-२३-५", "content_sanskrit": "एवं क्रुद्धाऽशपन्माता पन्नगान्धर्मचारिणः।\nगुरोः परित्यागकृतं नैतदन्यद्भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2088641, "chapter_id": 2893, "verse_number": "१३-२३-६", "content_sanskrit": "एवं शप्ता दिशः प्राप्ताः पन्नगा धर्मचारिणः।\nविहाय मातरं क्रुद्धा गता वैरकरीं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2088642, "chapter_id": 2893, "verse_number": "१३-२३-७", "content_sanskrit": "तत्र ये वृजिनं तस्या अनापन्ना भुजङ्गमाः।\nते तस्य वाजिनो वाला बभूवुरसितप्रभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2088643, "chapter_id": 2893, "verse_number": "१३-२३-८", "content_sanskrit": "तान्दृष्ट्वा वालधिस्थांश्च पुत्रान्कद्रूरथाब्रवीत्।\nविनतामथ संहृष्टा हयोसौ दृश्यतामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2088644, "chapter_id": 2893, "verse_number": "१३-२३-९", "content_sanskrit": "एकवर्णो न वा भद्रे पणो नौ सुव्यवस्थितः।\nउतकादुत्तरन्तं तं हयं चैव च भामिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2088645, "chapter_id": 2893, "verse_number": "१३-२३-१०", "content_sanskrit": "सा त्ववक्रमतिर्देवी विनता जिह्मगामिनीम्।\nअब्रवीद्भगिनीं किञ्चिद्विहसन्तीव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2088646, "chapter_id": 2893, "verse_number": "१३-२३-११", "content_sanskrit": "हन्त पश्याव गच्छावः सुकृतो नौ पणः शुभे।\nदासी वा ते भविष्यामि त्वं वा दासी भविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2088647, "chapter_id": 2893, "verse_number": "१३-२३-१२", "content_sanskrit": "एवं स्थिरं पणं कृत्वा हयं ते तं ददर्शतुः।\nकृत्वा साक्षिणमात्मानं भगिन्यौ कुरुसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2088648, "chapter_id": 2893, "verse_number": "१३-२३-१३", "content_sanskrit": "सा दृष्ट्वैव हयं मन्दं विनता शोककर्शिता।\nश्वेतं चन्द्रांशुवालं तं कालवालं मनोजवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2088649, "chapter_id": 2893, "verse_number": "१३-२३-१४", "content_sanskrit": "तत्र सा व्रीलिता वाक्यं विनता साश्रुबिन्दुका।\nउवाच कालवालोऽयं तुरगो विजितं त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2088650, "chapter_id": 2893, "verse_number": "१३-२३-१५", "content_sanskrit": "दासी मां प्रेषय स्वार्थे यथा कामवशां शुभे।\nदास्यश्च कामकारा हि भर्तृणां नात्र संशयः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2088651, "chapter_id": 2893, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि त्रयोविंशोऽध्यायः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]