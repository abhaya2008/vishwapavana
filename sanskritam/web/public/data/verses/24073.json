[{"id": 7004073000, "chapter_id": 24073, "verse_number": "४-२२-१", "content_sanskrit": "शिवशर्मोवाच ।\nध्रुवाख्यानमिदं रम्यं महापातकनाशनम् ।\nमहाश्चर्यकरं पुण्यं श्रुत्वा तृप्तोस्मि भो गणौ ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004073001, "chapter_id": 24073, "verse_number": "४-२२-२", "content_sanskrit": "अगस्त्य उवाच ।\nइत्थं यावद्द्विजो ब्रूते विमानं वायुवेगगम् ।\nतावत्प्राप महर्लोकं स्वर्लोकात्परमाद्भुतम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004073002, "chapter_id": 24073, "verse_number": "४-२२-३", "content_sanskrit": "द्विजोऽथ लोकं संवीक्ष्य सर्वतो महसा वृतम् ।\nतौ गणौ प्रत्युवाचेदं कोयं लोको मनोहरः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004073003, "chapter_id": 24073, "verse_number": "४-२२-४", "content_sanskrit": "तावूचतुस्ततो विप्रं निशामय महामते ।\nअयं स हि महर्लोकः स्वर्लोकात्परमाद्भुतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004073004, "chapter_id": 24073, "verse_number": "४-२२-५", "content_sanskrit": "कल्पायुषो वसंत्यत्र तपसा धूतकल्मषाः ।\nविष्णुस्मरण संक्षीण समस्तक्लेशसंचयाः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004073005, "chapter_id": 24073, "verse_number": "४-२२-६", "content_sanskrit": "निर्व्याजप्रणिधानेन दृष्ट्वा तेजोमयं जगत् ।\nमहायोगसमायुक्ता वसंत्यत्र सुरोत्तमाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004073006, "chapter_id": 24073, "verse_number": "४-२२-७", "content_sanskrit": "इत्थं कथां कथयतोर्भगवद्गणयोः प्रिये ।\nक्षणार्धेन विमानं तज्जनलोकं निनायतान् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004073007, "chapter_id": 24073, "verse_number": "४-२२-८", "content_sanskrit": "निवसंत्यमला यत्र मानसा बह्मणः सुताः ।\nसनंदनाद्या योगींद्राः सर्वे ते ह्यूर्ध्वरेतसः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004073008, "chapter_id": 24073, "verse_number": "४-२२-९", "content_sanskrit": "अन्ये तु योगिनो ये वै ह्यस्खलद्ब्रह्मचारिणः ।\nसर्वद्वंद्वविनिर्मुक्तास्ते वसंत्यतिनिर्मलाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004073009, "chapter_id": 24073, "verse_number": "४-२२-१०", "content_sanskrit": "जनलोकात्तपोलोकस्तेषां लोचनगोचरः ।\nकृतस्तेन विमानेन मनोवेगेन गच्छता ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004073010, "chapter_id": 24073, "verse_number": "४-२२-११", "content_sanskrit": "वैराजा यत्र ते देवा वसेयुर्दाहवर्जिताः ।\nवासुदेवे मनो येषां वासुदेवार्पितक्रियाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004073011, "chapter_id": 24073, "verse_number": "४-२२-१२", "content_sanskrit": "तपसा तोष्य गोविंदमभिलाषविवर्जिताः ।\nतपोलोकमिमं प्राप्य वसंति विजितेंद्रियाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004073012, "chapter_id": 24073, "verse_number": "४-२२-१३", "content_sanskrit": "शिलोंछ वृत्तया ये वै दंतोलूखलिकाश्च ये ।\nअश्मकुट्टाश्च मुनयः शीर्णपर्णाशिनश्च ये ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004073013, "chapter_id": 24073, "verse_number": "४-२२-१४", "content_sanskrit": "ग्रीष्मे पंचाग्नितपसो वर्षासु स्थंडिलेशयाः ।\nहेमंतशिशिरार्धे ये क्षपंति सलिले क्षपाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004073014, "chapter_id": 24073, "verse_number": "४-२२-१५", "content_sanskrit": "कुशाग्रनीरविप्रूषस्तृषिता यतयोऽपिबन् ।\nवाताशिनोतिक्षुधिताः पादाग्रांगुष्ठ भूस्पृशः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004073015, "chapter_id": 24073, "verse_number": "४-२२-१६", "content_sanskrit": "ऊर्ध्वदोषो रविदृशस्त्वेकांघ्रि स्थाणु निश्चलाः ।\nये वै दिवा निरुच्छ्वासा मासोच्छ्वासाश्च ये पुनः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004073016, "chapter_id": 24073, "verse_number": "४-२२-१७", "content_sanskrit": "मासोपवासव्रतिनश्चातुर्मास्य व्रताश्च ये ।\nऋत्वंततोयपाना ये षण्मासोपवासकाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004073017, "chapter_id": 24073, "verse_number": "४-२२-१८", "content_sanskrit": "ये च वर्षनिमेषा वै वर्षधारांबु तर्षकाः ।\nये च स्थाणूपमां प्राप्ता मृगकंडूति सौख्यदाः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004073018, "chapter_id": 24073, "verse_number": "४-२२-१९", "content_sanskrit": "जटाटवी कोटरांतः कृतनीडांडजाश्च ये ।\nप्ररूढवामलूरांगाः स्नायुनद्धास्थिसंचयाः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004073019, "chapter_id": 24073, "verse_number": "४-२२-२०", "content_sanskrit": "लताप्रतानैः परितो वेष्टितावयवाश्च ये ।\nसस्यानि च प्ररूढानि यदंगेषु चिरस्थिति ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004073020, "chapter_id": 24073, "verse_number": "४-२२-२१", "content_sanskrit": "इत्यादि सुतपः क्लिष्टवर्ष्माणो ये तपोधनाः ।\nब्रह्मायुषस्तपोलोके ते वसंत्यकुतोभयाः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004073021, "chapter_id": 24073, "verse_number": "४-२२-२२", "content_sanskrit": "यावदित्थं स पुण्यात्मा शृणोति गणयोर्मुखात् ।\nतावन्नेत्रातिथीभूतः सत्यलोको महोज्ज्वलः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004073022, "chapter_id": 24073, "verse_number": "४-२२-२३", "content_sanskrit": "त्वरावंतौ गणौ तत्र विमानादवरुह्य तौ ।\nस्रष्टारं सर्वलोकानां तेन सार्धं प्रणेमतुः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004073023, "chapter_id": 24073, "verse_number": "४-२२-२४", "content_sanskrit": "ब्रह्मोवाच ।\nगणावसौ द्विजो धीमान्वेदवेदांगपारगः ।\nस्मृत्युक्ताचारचंचुश्च प्रतीपः पापकर्मसु ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004073024, "chapter_id": 24073, "verse_number": "४-२२-२५", "content_sanskrit": "अयि द्विज महाप्राज्ञ जाने त्वां शिवशर्मक ।\nसाधूकृतं त्वया वत्स सुतीर्थप्राणमोक्षणात् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004073025, "chapter_id": 24073, "verse_number": "४-२२-२६", "content_sanskrit": "सत्वरं गत्वरं सर्वं यच्चैतद्भवतेक्षितम् ।\nदैनंदिनप्रलयतः सृजामि च पुनः पुनः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004073026, "chapter_id": 24073, "verse_number": "४-२२-२७", "content_sanskrit": "आ वैराजं प्रतिपदमुपसंहरते हरः ।\nका कथा मशकाभानां नृणां मरणधर्मिणाम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004073027, "chapter_id": 24073, "verse_number": "४-२२-२८", "content_sanskrit": "चतुर्षु भूतग्रामेषु ह्येक एव गुणो नृणाम् ।\nतस्मिन्वै भारते वर्षे कर्मभूमौ महीयसि ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004073028, "chapter_id": 24073, "verse_number": "४-२२-२९", "content_sanskrit": "चपलानि विनिर्जित्येंद्रियाणि मनसा सह ।\nविहाय वैरिणं लोभं विष्वग्गुणगणस्य च ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004073029, "chapter_id": 24073, "verse_number": "४-२२-३०", "content_sanskrit": "धर्मवंशहरं काममर्थसंचयहारिणम् ।\nजरापलितकर्तारं विनिष्कृत्य विचारतः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004073030, "chapter_id": 24073, "verse_number": "४-२२-३१", "content_sanskrit": "जित्वा क्रोधरिपुं धैर्यात्तपसो यशसः श्रियः ।\nशरीरस्यापि हर्तारं नेतारं तामसीं गतिम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004073031, "chapter_id": 24073, "verse_number": "४-२२-३२", "content_sanskrit": "सदा मदं परित्यज्य प्रमादैकपदप्रदम् ।\nप्रमादैकशरण्यं च संपदां विनिवर्तकम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004073032, "chapter_id": 24073, "verse_number": "४-२२-३३", "content_sanskrit": "सर्वत्र लघुता हेतुमहंकारं विहाय च ।\nदूषणारोपणे यत्नं कुर्वाणं सज्जनेष्वपि ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004073033, "chapter_id": 24073, "verse_number": "४-२२-३४", "content_sanskrit": "हित्वा मोहं महाद्रोहरोपणं मतिघातिनम् ।\nअत्यंतमंधीकरणमंधतामिस्रदर्शकम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004073034, "chapter_id": 24073, "verse_number": "४-२२-३५", "content_sanskrit": "श्रुतिस्मृतिपुराणोक्तं परिक्षुण्णं महाजनैः ।\nधर्मसोपानमारुह्य यदिहायांति हेलया ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004073035, "chapter_id": 24073, "verse_number": "४-२२-३६", "content_sanskrit": "कर्मभूमिं समीहंते सर्वे स्वर्गौकसो द्विज ।\nयत्तत्रार्जितभोक्तारः पदेषूच्चावचेष्वमी ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004073036, "chapter_id": 24073, "verse_number": "४-२२-३७", "content_sanskrit": "नार्यावर्तसुमो देशो न काशी सदृशी पुरी ।\nन विश्वेश समं लिंगं क्वापि बह्मांडमंडले ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004073037, "chapter_id": 24073, "verse_number": "४-२२-३८", "content_sanskrit": "संति स्वर्गा बहुविधाः सुखेतर विवर्जिता ।\nसुकृतैकफलाः सर्वे युक्ताः सर्वसमृद्धिभिः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004073038, "chapter_id": 24073, "verse_number": "४-२२-३९", "content_sanskrit": "स्वर्लोकादधिकं रम्यं नहि ब्रह्मांडगोलके ।\nसर्वे यतंते स्वर्गाय तपोदानव्रतादिभिः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004073039, "chapter_id": 24073, "verse_number": "४-२२-४०", "content_sanskrit": "स्वर्लोकादपिरम्याणि पातालानीति नारदः ।\nप्राह स्वर्गसदां मध्ये पातालेभ्यः समागतः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004073040, "chapter_id": 24073, "verse_number": "४-२२-४१", "content_sanskrit": "आह्लादकारिणः शुभ्रा मणयो यत्र सुप्रभाः ।\nनागांगाभरणप्रोताः पातालं केन तत्समम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004073041, "chapter_id": 24073, "verse_number": "४-२२-४२", "content_sanskrit": "दैत्यदानवकन्याभिरितश्चेतश्च शोभिते ।\nपाताले कस्य न प्रीतिर्विमुक्तस्यापि जायते ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004073042, "chapter_id": 24073, "verse_number": "४-२२-४३", "content_sanskrit": "दिवार्करश्मयस्तत्र प्रभां तन्वंति नातपम् ।\nशशिनश्च न शीताय निशि द्योताय केवलम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004073043, "chapter_id": 24073, "verse_number": "४-२२-४४", "content_sanskrit": "यत्र न ज्ञायते कालो गतोपि दनुजादिभिः ।\nवनानि नद्यो रम्याणि सदंभांसि सरांसि च ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004073044, "chapter_id": 24073, "verse_number": "४-२२-४५", "content_sanskrit": "कलाः पुंस्को किलालापाः सुचैलानि शुचीनि च ।\nभूषणान्यतिरम्याणि गंधाद्यमनुलेपनम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004073045, "chapter_id": 24073, "verse_number": "४-२२-४६", "content_sanskrit": "वीणावेणुमृदंगादि निस्वनाः श्रुतिहारिणः ।\nहाटकेशं महालिंगं यत्र वै सर्वकामदम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004073046, "chapter_id": 24073, "verse_number": "४-२२-४७", "content_sanskrit": "एतान्यन्यानि रम्याणि भोग्योग्यानि दानवैः ।\nदैत्योरगैश्च भुज्यंते पातालांतरगोचरैः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004073047, "chapter_id": 24073, "verse_number": "४-२२-४८", "content_sanskrit": "पातालेभ्योपि वै रम्यं द्विज वर्षमिलावृतम् ।\nरत्नसानुं समाश्रित्य परितः परिसंस्थितम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004073048, "chapter_id": 24073, "verse_number": "४-२२-४९", "content_sanskrit": "सदा सुकृतिनो यत्र सर्वभोगभुजो द्विज ।\nनवयौवनसंपन्ना नित्यं यत्र मृगीदृशः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004073049, "chapter_id": 24073, "verse_number": "४-२२-५०", "content_sanskrit": "भोगभूमिरियं प्रोक्ता श्रेयो विनिमयार्जिता ।\nभुज्यते त्वद्विधैर्लोकैस्तीर्थाभित्यक्त देहकैः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004073050, "chapter_id": 24073, "verse_number": "४-२२-५१", "content_sanskrit": "अक्लीबभाषिभिश्चापि पुत्रक्षेत्राद्यहीनकैः ।\nपरोपकारसंक्षीणसुखायुर्धनसंचयैः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004073051, "chapter_id": 24073, "verse_number": "४-२२-५२", "content_sanskrit": "संति द्वीपा ह्यनेका वै पारावारांतरस्थिताः ।\nजंबूद्वीपसमो द्वीपो न क्वापि जगतीतले ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004073052, "chapter_id": 24073, "verse_number": "४-२२-५३", "content_sanskrit": "तत्रापि नववर्षाणि भारतं तत्र चोत्तमम् ।\nकर्मभूमिरियं प्रोक्ता देवानामपिदुर्लभा ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004073053, "chapter_id": 24073, "verse_number": "४-२२-५४", "content_sanskrit": "अष्टौ किंपुरुषादीनि देवभोग्यानि तानि तु ।\nतेषु स्वर्गात्समागत्य रमंते त्रिदिवौकसः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004073054, "chapter_id": 24073, "verse_number": "४-२२-५५", "content_sanskrit": "योजनानां सहस्राणि नवविस्तारतस्त्विदम् ।\nभारतं प्रथमं वर्षं मेरोर्दक्षिणतः स्थितम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004073055, "chapter_id": 24073, "verse_number": "४-२२-५६", "content_sanskrit": "तत्रापि हिमविंध्याद्रेरंतरं पुण्यदं परम् ।\nगंगायमुनयोर्मध्ये ह्यंतर्वेदी भुवः पराः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004073056, "chapter_id": 24073, "verse_number": "४-२२-५७", "content_sanskrit": "कुरुक्षेत्रं हि सर्वेषां क्षेत्राणामधिकं ततः ।\nततोपि नैमिषारण्यं स्वर्गसाधनमुत्तमम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004073057, "chapter_id": 24073, "verse_number": "४-२२-५८", "content_sanskrit": "नैमिषारण्यतोपीह सर्वस्मिन्क्षितिमंडले ।\nसर्वेभ्योपि हि तीर्थेभ्यस्तीर्थराजो विशिष्यते ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004073058, "chapter_id": 24073, "verse_number": "४-२२-५९", "content_sanskrit": "स्वर्गदोमोक्षदश्चैव सर्वकामफलप्रदः ।\nप्रयागस्तन्महत्क्षेत्रं तीर्थराज इति स्मृतः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004073059, "chapter_id": 24073, "verse_number": "४-२२-६०", "content_sanskrit": "यागाः सर्वे मया पूर्वं तुलया विधृता द्विज ।\nतच्च तीर्थवरं रम्यं कामिकं कामपूरणात ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004073060, "chapter_id": 24073, "verse_number": "४-२२-६१", "content_sanskrit": "दृष्ट्वा प्रकृष्टयागेभ्यः पुष्टेभ्यो दक्षिणादिभिः ।\nप्रयागमिति तन्नाम कृतं हरिहरादिभिः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004073061, "chapter_id": 24073, "verse_number": "४-२२-६२", "content_sanskrit": "नाममात्रस्मृतेर्यस्य प्रयागस्य त्रिकालतः ।\nस्मर्तुः शरीरे नो जातु पापं वसति कुत्रचित् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004073062, "chapter_id": 24073, "verse_number": "४-२२-६३", "content_sanskrit": "संति तीर्थान्यनेकानि पापत्राणकराणि च ।\nन शक्तान्यधिकं दातुं कृतैनः परिशुद्धितः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004073063, "chapter_id": 24073, "verse_number": "४-२२-६४", "content_sanskrit": "जन्मांतरेष्वसंख्येषु यः कृतः पापसंचयः ।\nदुष्प्रणोद्यो हि नितरां व्रतैर्दानैस्तपोजपैः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004073064, "chapter_id": 24073, "verse_number": "४-२२-६५", "content_sanskrit": "स तीर्थराजगमनोद्यतस्य शुभजन्मनः ।\nअंगेषु वेपतेऽत्यंतं द्रुमो वातहतो यथा ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004073065, "chapter_id": 24073, "verse_number": "४-२२-६६", "content_sanskrit": "ततः क्रांतार्धमार्गस्य प्रयाग दृढचेतसः ।\nपुंसः शरीरान्निर्यातुमपेक्षेत पदांतरम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004073066, "chapter_id": 24073, "verse_number": "४-२२-६७", "content_sanskrit": "भाग्यान्नेत्रातिथीभूते तीर्थराजे महात्मनः ।\nपलायते द्रुततरं तमः सूर्योदये यथा ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004073067, "chapter_id": 24073, "verse_number": "४-२२-६८", "content_sanskrit": "सप्तधातुमयी भूततनौ पापानि यानि वै ।\nकेशेषु तानि तिष्ठंति वपनाद्यांति तान्यपि ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004073068, "chapter_id": 24073, "verse_number": "४-२२-६९", "content_sanskrit": "एवं निष्कलुषीभूय ततः स्नायात्सितासिते ।\nयंयं काममभिध्यायंस्तं तमाप्नोति नान्यथा ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004073069, "chapter_id": 24073, "verse_number": "४-२२-७०", "content_sanskrit": "पुण्यराशिं च विपुलं पुण्यान्भोगान्यथेप्सितान् ।\nस्वर्गं प्राप्नोति तत्पुण्यान्निष्कामो मोक्षमाप्नुयात् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004073070, "chapter_id": 24073, "verse_number": "४-२२-७१", "content_sanskrit": "स्नायाद्योभिलषन्मोक्षं कामानन्यान्विहाय च ।\nसोपि मोक्षमवाप्नोति कामदात्तीर्थराजतः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004073071, "chapter_id": 24073, "verse_number": "४-२२-७२", "content_sanskrit": "तीर्थराजं परित्यज्य योऽन्यस्मात्काममिच्छति ।\nभारताख्ये महावर्षे स कामं नाप्नुयात्स्फुटम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004073072, "chapter_id": 24073, "verse_number": "४-२२-७३", "content_sanskrit": "सत्यलोके प्रयागे च नांतरं वेद्म्यहं द्विज ।\nतत्र ये शुभकर्माणस्ते मल्लोकनिवासिनः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004073073, "chapter_id": 24073, "verse_number": "४-२२-७४", "content_sanskrit": "तीर्थाभिलाषिभिर्मर्त्यैस्सेव्यं तीर्थांतरं नहि ।\nअन्यत्र भूमिवलये तीर्थराजात्प्रया गतः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004073074, "chapter_id": 24073, "verse_number": "४-२२-७५", "content_sanskrit": "यथांतरं द्विजश्रेष्ठ भूपेत्वितरसेवके ।\nदृष्टांतमात्रं कथितं प्रयागेतर तीर्थयोः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004073075, "chapter_id": 24073, "verse_number": "४-२२-७६", "content_sanskrit": "यथाकथंचित्तीर्थेऽस्मिन्प्राणत्यागं करोति यः ।\nतस्यात्मघातदोषो न प्राप्नुयादीप्सितान्यपि ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004073076, "chapter_id": 24073, "verse_number": "४-२२-७७", "content_sanskrit": "यस्य भाग्यवतश्चात्र तिष्ठंत्यस्थीन्यपि द्विज ।\nन तस्य दुःखलेशोपि क्वापि जन्मनि जायते ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004073077, "chapter_id": 24073, "verse_number": "४-२२-७८", "content_sanskrit": "ब्रह्महत्यादि पापानां प्रायश्चित्तं चिकीर्षुणा ।\nप्रयागं विधिवत्सेव्यं द्विजवाक्यान्न संशयः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004073078, "chapter_id": 24073, "verse_number": "४-२२-७९", "content_sanskrit": "किं बहूक्तेन विप्रेंद्र महोदयमभीप्सुना ।\nसेव्यं सितासितं तीर्थं प्रकृष्टं जगतीतले ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004073079, "chapter_id": 24073, "verse_number": "४-२२-८०", "content_sanskrit": "प्रयागतोपि तीर्थेशात्सर्वेषु भुवनेष्वपि ।\nअनायासेन वै मुक्तिः काश्यां देहावसानतः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004073080, "chapter_id": 24073, "verse_number": "४-२२-८१", "content_sanskrit": "प्रयागादपि वै रम्यमविमुक्तं न संशयः ।\nयत्र विश्वेश्वरः साक्षात्स्वयं समधितिष्ठति ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004073081, "chapter_id": 24073, "verse_number": "४-२२-८२", "content_sanskrit": "अविमुक्तान्महाक्षेत्राद्विश्वेश समधिष्ठितात् ।\nन च किंचित्क्वचिद्रम्यमिह ब्रह्मांडगोलके ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004073082, "chapter_id": 24073, "verse_number": "४-२२-८३", "content_sanskrit": "अविमुक्तमिदं क्षेत्रमपि ब्रह्मांडमध्यगम् ।\nब्रह्मांडमध्ये न भवेत्पंचक्रोशप्रमाणतः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004073083, "chapter_id": 24073, "verse_number": "४-२२-८४", "content_sanskrit": "यथायथा हि वर्धेत जलमेकार्णवस्य च ।\nतथातथोन्नयेदीशस्तत्क्षेत्रं प्रलयादपि ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004073084, "chapter_id": 24073, "verse_number": "४-२२-८५", "content_sanskrit": "क्षेत्रमेतत्त्रिशूलाग्रे शूलिनस्तिष्ठति द्विज ।\nअंतरिक्षेन भूमिष्ठं नेक्षंते मूढबुद्धयः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004073085, "chapter_id": 24073, "verse_number": "४-२२-८६", "content_sanskrit": "सदा कृतयुगं चात्र महापर्वसदाऽत्र वै ।\nन ग्रहाऽस्तोदयकृतो दोषो विश्वेश्वराश्रमे ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004073086, "chapter_id": 24073, "verse_number": "४-२२-८७", "content_sanskrit": "सदा सौम्यायनं तत्र सदा तत्र महोदयः ।\nसदैव मंगलं तत्र यत्र विश्वेश्वरस्थितिः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004073087, "chapter_id": 24073, "verse_number": "४-२२-८८", "content_sanskrit": "यथाभूमितले विप्र पुर्यः संति सहस्रशः ।\nतथा काशी न मंतव्या क्वापि लोकोत्तरात्वियम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004073088, "chapter_id": 24073, "verse_number": "४-२२-८९", "content_sanskrit": "मया सृष्टानि विप्रेंद्र भुवनानि चतुर्दश ।\nअस्याः पुर्या विनिर्माता स्वयं विश्वेश्वरः प्रभुः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004073089, "chapter_id": 24073, "verse_number": "४-२२-९०", "content_sanskrit": "पुरा यमस्तपस्तप्त्वा बहुकालं सुदुष्करम् ।\nत्रैलोक्याधिकृतिं प्राप्तस्त्यक्त्वा वाराणसीं पुरीम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004073090, "chapter_id": 24073, "verse_number": "४-२२-९१", "content_sanskrit": "चराचरस्य सर्वस्य यानि कर्माणि तानि वै ।\nगोचरे चित्रगुप्तस्य काशीवासिकृतादृते ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004073091, "chapter_id": 24073, "verse_number": "४-२२-९२", "content_sanskrit": "प्रवेशो यमदूतानां न कदाचिद्द्विजोत्तम ।\nमध्ये काशीपुरी क्वापि रक्षिणस्तत्र तद्गणाः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004073092, "chapter_id": 24073, "verse_number": "४-२२-९३", "content_sanskrit": "स्वयं नियंता विश्वेशस्तत्र काश्यां तनुत्यजाम् ।\nतत्रापि कृतपापानां नियंता कालभैरवः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004073093, "chapter_id": 24073, "verse_number": "४-२२-९४", "content_sanskrit": "तत्र पापं न कर्तव्यं दारुणा रुद्रयातना ।\nअहो रुद्रपिशाचत्वं नरकेभ्योपि दुःसहम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004073094, "chapter_id": 24073, "verse_number": "४-२२-९५", "content_sanskrit": "पापमेव हि कर्तव्यं मतिरस्ति यदीदृशी ।\nसुखेनान्यत्र कर्तव्यं मही ह्यस्ति महीयसी ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004073095, "chapter_id": 24073, "verse_number": "४-२२-९६", "content_sanskrit": "अपि कामातुरो जंतुरेकां रक्षति मातरम् ।\nअपि पापकृता काशी रक्ष्या मोक्षार्थिनैकिका ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004073096, "chapter_id": 24073, "verse_number": "४-२२-९७", "content_sanskrit": "परापवादशीलेन परदाराभिलाषिणा ।\nतेन काशी न संसेव्या क्व काशी निरयः क्व सः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004073097, "chapter_id": 24073, "verse_number": "४-२२-९८", "content_sanskrit": "अभिलष्यंति ये नित्यं धनं चात्र प्रतिग्रहैः ।\nपरस्वं कपटैर्वापि काशी सेव्या न तैर्नरैः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004073098, "chapter_id": 24073, "verse_number": "४-२२-९९", "content_sanskrit": "परपीडाकरं कर्म काश्यां नित्यं विवर्जयेत् ।\nतदेव चेत्किमत्र स्यात्काशीवासो दुरात्मनाम् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004073099, "chapter_id": 24073, "verse_number": "४-२२-१००", "content_sanskrit": "त्यक्त्वा वैश्वेश्वरीं भक्तिं येऽन्यदेवपरायणाः ।\nसर्वथा तैर्न वस्तव्या राजधानी पिनाकिनः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004073100, "chapter_id": 24073, "verse_number": "४-२२-१०१", "content_sanskrit": "अर्थार्थिनस्तु ये विप्र ये च कामार्थिनो नराः ।\nअविमुक्तं न तैः सेव्यं मोक्षक्षेत्रमिदं यतः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004073101, "chapter_id": 24073, "verse_number": "४-२२-१०२", "content_sanskrit": "शिवनिंदापरा ये च वेदनिंदा पराश्च ये ।\nवेदाचारप्रतीपा ये सेव्या वाराणसी न तैः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004073102, "chapter_id": 24073, "verse_number": "४-२२-१०३", "content_sanskrit": "परद्रोहधियो ये च परेर्ष्याकारिणश्च ये ।\nपरोपतापिनो ये वै तेषां काशी न सिद्धये ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7004073103, "chapter_id": 24073, "verse_number": "४-२२-१०४", "content_sanskrit": "मनसापि न ये काशीमभिनंदंति दुर्धियः ।\nतेषां निर्वाणवार्तापि दूरे दुर्वृत्तचेतसाम् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7004073104, "chapter_id": 24073, "verse_number": "४-२२-१०५", "content_sanskrit": "ज्ञानेन न विना मोक्षः क्वचिदस्तीह भूतले ।\nतज्ज्ञानं न व्रतैर्लभ्यमपि चांद्रायणादिभिः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7004073105, "chapter_id": 24073, "verse_number": "४-२२-१०६", "content_sanskrit": "तुलापुरुषमुख्यैश्च दानैश्च श्रद्धयान्वितैः ।\nदेशकाले च विधिना पात्रेभ्यः प्रतिपादितैः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7004073106, "chapter_id": 24073, "verse_number": "४-२२-१०७", "content_sanskrit": "न यमैर्ब्रह्मचर्याद्यैर्नियमैर्नार्चनादिभि ।\nशरीरशोषणैरुग्रैर्न तपोभिर्द्विजोत्तम ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7004073107, "chapter_id": 24073, "verse_number": "४-२२-१०८", "content_sanskrit": "न महामंत्रजप्यैश्च गुरुभिः प्रतिपादितैः ।\nन स्वाध्यायैर्यथोक्तैश्च नाग्निशुश्रूषणैः परैः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7004073108, "chapter_id": 24073, "verse_number": "४-२२-१०९", "content_sanskrit": "न सेवया गुरूणां च न श्राद्धैर्देवतार्चनैः ।\nन नानातीर्थयात्राभिर्ज्ञानं समधिगम्यते ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7004073109, "chapter_id": 24073, "verse_number": "४-२२-११०", "content_sanskrit": "न योगेन विना ज्ञानं योगस्तत्त्वार्थशीलनम् ।\nगुरूपदिष्टमार्गेण सदाभ्यासवशेन च ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7004073110, "chapter_id": 24073, "verse_number": "४-२२-१११", "content_sanskrit": "तस्यांतराया बहवः सुदूरश्रवणादयः ।\nअतो न प्राप्यते ज्ञानं योगादेकेन जन्मना ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7004073111, "chapter_id": 24073, "verse_number": "४-२२-११२", "content_sanskrit": "विना तपो जपाद्यैश्च विना योगेन सुव्रत ।\nनिःश्रेयो लभ्यते काश्यामिहैकेनैव जन्मना ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7004073112, "chapter_id": 24073, "verse_number": "४-२२-११३", "content_sanskrit": "त्वया शुद्धधिया काश्यां यच्छ्रेयः समुपार्जितम् ।\nतच्छ्रेयसोप्युदर्कस्ते महानस्ति द्विजोत्तम ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7004073113, "chapter_id": 24073, "verse_number": "४-२२-११४", "content_sanskrit": "उक्तेति विररामाजः शृण्वतोर्गणयोस्तयोः ।\nसोपि प्रमुदितश्चाभूच्छिवशर्मा महामनाः ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}]