[{"id": 7000723000, "chapter_id": 20723, "verse_number": "६-६६-१", "content_sanskrit": "नारदौवाच ।\nयमस्याराधनं ब्रूहि मद्धितार्थं सुरोत्तम ।\nकथं न गम्यते देव नरेण नरकांतरे॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000723001, "chapter_id": 20723, "verse_number": "६-६६-२", "content_sanskrit": "श्रूयते यमलोके तु सदा वैतरणी नदी ।\nअनाधृष्यात्वपारा च दुस्तरा बहुशोणिता॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000723002, "chapter_id": 20723, "verse_number": "६-६६-३", "content_sanskrit": "दुस्तरा सर्वभूतानां सा कथं सुतरा भवेत् ।\nभयमेतन्महादेव यमलोकं प्रति प्रभो॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000723003, "chapter_id": 20723, "verse_number": "६-६६-४", "content_sanskrit": "तस्य निर्मोचनार्थाय ब्रूहि कृत्यमशेषतः ।\nभगवन्देवदेवेश कृपां कृत्वा ममोपरि॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000723004, "chapter_id": 20723, "verse_number": "६-६६-५", "content_sanskrit": "महादेव उवाच ।\nद्वारवत्यां पुरा विप्र स्नातोऽहं लवणांभसि ।\nददृशे मुनिमायांतं मुद्गलं नाम वाडव॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000723005, "chapter_id": 20723, "verse_number": "६-६६-६", "content_sanskrit": "ज्वलंतमिवचादित्यं तपसा द्योततांगकम् ।\nमां प्रणम्य मुनिः प्राह मुद्गलो विस्मयान्वितः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000723006, "chapter_id": 20723, "verse_number": "६-६६-७", "content_sanskrit": "मुद्गल उवाच ।\nअकस्मान्मूर्च्छितो देव पतितोऽस्मि धरातले ।\nप्रज्वलंति ममांगानि गृहीतो यमकिंकरैः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000723007, "chapter_id": 20723, "verse_number": "६-६६-८", "content_sanskrit": "बलादाकृष्यमाणोऽहं पुरुषओंगुष्ठमात्रकः ।\nबद्धो यमभटैर्गाढं नीतोऽस्मि शमनांतिकम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000723008, "chapter_id": 20723, "verse_number": "६-६६-९", "content_sanskrit": "क्षणात्सभायां पश्यामि यमं पिंगललोचनम् ।\nकृष्णमुखं महारौद्रं मृत्युव्याधिशतान्वितम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000723009, "chapter_id": 20723, "verse_number": "६-६६-१०", "content_sanskrit": "वातपित्त श्लेष्मदोषैर्मूर्तिमद्भिस्तु सेवितम् ।\nकायशोषज्वरातंक स्फोटिका लूतकादिभिः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000723010, "chapter_id": 20723, "verse_number": "६-६६-११", "content_sanskrit": "ज्वालांगमर्दशीर्षार्ति भगंदर बलक्षयैः ।\nकंठमालाक्षिरोगैश्च मूत्रकृच्छ्रज्वरव्रणैः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000723011, "chapter_id": 20723, "verse_number": "६-६६-१२", "content_sanskrit": "विमूर्च्छिका गलग्राह हृद्रोगैर्भूततस्करैः ।\nइत्थं बहुविधै रौद्रैर्नानारूपैर्भयंकरैः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000723012, "chapter_id": 20723, "verse_number": "६-६६-१३", "content_sanskrit": "कपालशिरोहस्तैश्च संग्रामे नरके तथा ।\nराक्षसैर्दानवैर्घोरैरुपविष्टैः पुरः स्थितैः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000723013, "chapter_id": 20723, "verse_number": "६-६६-१४", "content_sanskrit": "धर्माधिकारिभिश्चात्र चित्रगुप्तादि लेखकैः ।\nव्याघ्र सिंह वराहैश्च शिखासर्पैः सुदुर्द्धरैः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000723014, "chapter_id": 20723, "verse_number": "६-६६-१५", "content_sanskrit": "वृश्चिकैर्दंष्ट्रिभिर्भूतैः कीटकैर्मत्कुणादिभिः ।\nवृक चित्रादि शुनकैः कंकैर्गृध्रैश्च जंबुकैः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000723015, "chapter_id": 20723, "verse_number": "६-६६-१६", "content_sanskrit": "तस्करैर्भूतदारिद्रैर्मारिभिर्डाकिनीग्रहैः ।\nमुक्तकेशैः श्वासकासैर्भ्रुकुटी कुटिलाननैः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000723016, "chapter_id": 20723, "verse_number": "६-६६-१७", "content_sanskrit": "बृहत्प्रतापैर्नोभीतैः शासकैः पापकर्मणाम् ।\nयमः सभायां शुशुभे सेव्यमानः परिग्रहैः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000723017, "chapter_id": 20723, "verse_number": "६-६६-१८", "content_sanskrit": "भीमाटविकजीवैश्च यथा व्यालांजनो गिरिः ।\nततो विश्वेश्वरः प्राह समयः किंकरान्प्रति॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000723018, "chapter_id": 20723, "verse_number": "६-६६-१९", "content_sanskrit": "नामभ्रांतैर्भवद्भिश्च समानीतः कथं मुनिः ।\nभीमकस्यात्मजो ग्रामे कौंडिन्ये मुद्गलाभिधः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000723019, "chapter_id": 20723, "verse_number": "६-६६-२०", "content_sanskrit": "क्षीणायुः क्षत्रियः सोऽस्ति आनेयो मुच्यतामसौ ।\nश्रुत्वैतत्ते गतास्तस्मादायाताः पुनरेव ते॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000723020, "chapter_id": 20723, "verse_number": "६-६६-२१", "content_sanskrit": "धर्मराजं पुनः प्राहुः सर्वे ते यमकिंकराः ।\nतत्रास्माभिर्गतैर्देही क्षीणायुर्नोपलक्षितः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000723021, "chapter_id": 20723, "verse_number": "६-६६-२२", "content_sanskrit": "यम उवाच ।\nकिं कारणमदृश्यास्ते प्रायेण भवतां नराः ।\nसुकृता द्वादशीयैस्तु ख्याता वैतरणी नदी॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000723022, "chapter_id": 20723, "verse_number": "६-६६-२३", "content_sanskrit": "उज्जयिन्यां प्रयागे वा यमुनायां च ये मृताः ।\nतिलहस्तिहिरण्यादि दत्तं यैस्तु गवाह्निकम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000723023, "chapter_id": 20723, "verse_number": "६-६६-२४", "content_sanskrit": "दूता ऊचुः ।\nतद्व्रतं कीदृशं ब्रह्मन्ब्रूहि सर्वमशेषतः ।\nकिं तत्र देव कर्त्तव्यं पुरुषैस्तवतोषदम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000723024, "chapter_id": 20723, "verse_number": "६-६६-२५", "content_sanskrit": "येन कृता नरश्रेष्ठ द्वादशी कृष्णपक्षजा ।\nउपवासे च तेनैव कथं पापात्प्रमुच्यते॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000723025, "chapter_id": 20723, "verse_number": "६-६६-२६", "content_sanskrit": "तद्व्रतं केन विधिना कर्त्तव्यं च यथा वद ।\nसुप्रसन्नेन वक्तव्यं दयां कृत्वा दयानिधे॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000723026, "chapter_id": 20723, "verse_number": "६-६६-२७", "content_sanskrit": "श्रीमुद्गल उवाच ।\nदूतानां वचनं श्रुत्वा उवाच मधुरं तदा ।\nसर्वं वदामि भो दूता यथादृष्टं यथाश्रुतम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000723027, "chapter_id": 20723, "verse_number": "६-६६-२८", "content_sanskrit": "यम उवाच ।\nमार्गशीर्षादि मासे तु या इमाः कृष्णपक्षजाः ।\nतासु पूर्वासु विधिवद्दूता वैतरणीव्रतम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000723028, "chapter_id": 20723, "verse_number": "६-६६-२९", "content_sanskrit": "प्रतिमासं च कर्त्तव्यं यावद्वर्षं भवेद्ध्रुवम् ।\nयां तु कृत्वा तु भो दूता मुच्यते नात्र संशयः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000723029, "chapter_id": 20723, "verse_number": "६-६६-३०", "content_sanskrit": "उपवासस्य नियमः कर्त्तव्यो विष्णु तुष्टिदः ।\nअद्य मे देवदेवेश उपवासो भविष्यति॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000723030, "chapter_id": 20723, "verse_number": "६-६६-३१", "content_sanskrit": "द्वादश्यां पूज्य गोविंदं भक्तिभावसमन्वितम् ।\nस्वप्नेंद्रियस्य वैकल्याद्भोजनं यच्च मैथुनम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000723031, "chapter_id": 20723, "verse_number": "६-६६-३२", "content_sanskrit": "तत्सर्वं क्षम मे देव कृपां कृत्वा ममोपरि ।\nएवं वै नियमं कृत्वा मध्याह्ने तीर्थमाव्रजेत्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000723032, "chapter_id": 20723, "verse_number": "६-६६-३३", "content_sanskrit": "मृद्गोमय तिलान्नीत्वा गंतव्यं विधिपूर्वकम् ।\nस्नानं तत्र प्रकर्तव्यं व्रतसंपूर्णहेतवे॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000723033, "chapter_id": 20723, "verse_number": "६-६६-३४", "content_sanskrit": "अश्वक्रांतेति मंत्रेण स्नानं कुर्याद्विशेषतः ।\nअश्वक्रांते रथक्रांते विष्णुक्रांते वसुंधरे॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000723034, "chapter_id": 20723, "verse_number": "६-६६-३५", "content_sanskrit": "मृत्तिके हर मे पापं यन्मया पूर्वसंचितम् ।\nतया हतेन पापेन सर्वपापैः प्रमुच्यते॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000723035, "chapter_id": 20723, "verse_number": "६-६६-३६", "content_sanskrit": "काश्यां चैव तु संभूतास्तिला वै विष्णुरूपिणः ।\nतिलस्नानेन गोविंदः सर्वं पापं व्यपोहति॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000723036, "chapter_id": 20723, "verse_number": "६-६६-३७", "content_sanskrit": "विष्णुदेहोद्भवा देवि महापापापहारिणी ।\nसर्वं पापं हर त्वं वै सर्वेषां हि नमोऽस्तु ते॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000723037, "chapter_id": 20723, "verse_number": "६-६६-३८", "content_sanskrit": "तुलसीपत्रकं धृत्वा नामोच्चारणपूर्वकम् ।\nस्नानं सुकृतिभिः प्रोक्तं कर्तव्यं विधिपूर्वकम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000723038, "chapter_id": 20723, "verse_number": "६-६६-३९", "content_sanskrit": "एवं स्नात्वा समुत्तीर्य परिधाय सुवाससी ।\nतर्पयित्वा पितॄन्देवांस्ततो विष्णोस्तु पूजनम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000723039, "chapter_id": 20723, "verse_number": "६-६६-४०", "content_sanskrit": "संस्थाप्य चाव्रणं कुंभं पंचपल्लवसंयुतम् ।\nपंचरत्नसमोपेतं दिव्यस्रग्गंधवासितम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000723040, "chapter_id": 20723, "verse_number": "६-६६-४१", "content_sanskrit": "जलपूर्णं सद्रव्यंच ताम्रपात्रसमन्वितम् ।\nतत्रस्थं श्रीधरं देवं देवदेवं तपोनिधिम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000723041, "chapter_id": 20723, "verse_number": "६-६६-४२", "content_sanskrit": "पूर्णेन विधिना राजन्कुर्यात्पूजां गरीयसीम् ।\nमृद्गोमयादिरचितं मंडलं कारयेच्छुभम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000723042, "chapter_id": 20723, "verse_number": "६-६६-४३", "content_sanskrit": "तंडुलैः शुक्लधौतैश्च अश्मपिष्टैश्च कारयेत् ।\nधर्मराजः प्रकर्त्तव्यो हस्ताद्यव यवान्वितः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000723043, "chapter_id": 20723, "verse_number": "६-६६-४४", "content_sanskrit": "नदीं वैतरणीं ताम्रां स्थापयित्वा तदग्रतः ।\nपूजयेच्च पृथक्सम्यक्समावाहनपूर्वकम्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000723044, "chapter_id": 20723, "verse_number": "६-६६-४५", "content_sanskrit": "आवाहयामि देवेशं यमं वै विश्वरूपिणम् ।\nइहाभ्येहि महाभाग सान्निध्यं कुरु केशव॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000723045, "chapter_id": 20723, "verse_number": "६-६६-४६", "content_sanskrit": "इदं पाद्यं श्रियः कांत सोपविष्टं हरे प्रभो ।\nविश्वोद्यानरतो नित्यं कृपां कुरु ममोपरि॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000723046, "chapter_id": 20723, "verse_number": "६-६६-४७", "content_sanskrit": "भूतिदाय नमः पादावशोकाय च जानुनी ।\nउरू नमः शिवायेति विश्वमूर्ते नमः कटिम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000723047, "chapter_id": 20723, "verse_number": "६-६६-४८", "content_sanskrit": "कंदर्पाय नमो मेढ्रमादित्याय फलं तथा ।\nदामोदराय जठरं वासुदेवाय वै स्तनौ॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000723048, "chapter_id": 20723, "verse_number": "६-६६-४९", "content_sanskrit": "श्रीधराय मुखं केशान्केशवायेति वै नमः ।\nपृष्ठं शार्ङ्गधरायेति चरणौ वरदाय च॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000723049, "chapter_id": 20723, "verse_number": "६-६६-५०", "content_sanskrit": "स्वनाम्ना शंखचक्रासिगदापरशुपाणये ।\nसर्वात्मने नमस्तुभ्यं शिर इत्यभिधीयते॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000723050, "chapter_id": 20723, "verse_number": "६-६६-५१", "content_sanskrit": "मत्स्यं कूर्मं च वाराहं नारसिंहं च वामनम् ।\nरामं रामं च कृष्णं च बुधं कल्किं नमोऽस्तु ते॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000723051, "chapter_id": 20723, "verse_number": "६-६६-५२", "content_sanskrit": "सर्वपापौघनाशार्थं पूजयामि नमो नमः ।\nएभिश्च सर्वशो मंत्रैर्विष्णुं ध्यात्वा प्रपूजयेत्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000723052, "chapter_id": 20723, "verse_number": "६-६६-५३", "content_sanskrit": "धर्मराज नमस्तेऽस्तु धर्मराज नमोऽस्तु ते ।\nदक्षिणाशापते तुभ्यं नमो महिषवाहन॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000723053, "chapter_id": 20723, "verse_number": "६-६६-५४", "content_sanskrit": "चित्रगुप्त नमस्तुभ्यं विचित्राय नमोनमः ।\nनरकार्तिप्रशांत्यर्थं कामान्यच्छ ममेप्सितान्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000723054, "chapter_id": 20723, "verse_number": "६-६६-५५", "content_sanskrit": "यमाय धर्मराजाय मृत्यवे चांतकाय च ।\nवैवस्वताय कालाय सर्वभूतक्षयाय च॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000723055, "chapter_id": 20723, "verse_number": "६-६६-५६", "content_sanskrit": "वृकोदराय चित्राय चित्रगुप्ताय वै नमः ।\nनीलाय चैव दध्नाय नित्यं कुर्यान्नमो नमः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000723056, "chapter_id": 20723, "verse_number": "६-६६-५७", "content_sanskrit": "एवं द्वादशभिः पूज्यो नामभिर्धर्मराट्प्रभुः ।\nवैतरणी सुदुःपारे पापघ्नि सर्वकामदे॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000723057, "chapter_id": 20723, "verse_number": "६-६६-५८", "content_sanskrit": "इहाभ्येहि महाभागे गृहाणार्घं मया कृतम् ।\nयमद्वारपथे घोरे ख्याता वैतरणी नदी॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000723058, "chapter_id": 20723, "verse_number": "६-६६-५९", "content_sanskrit": "तस्यामुद्धरणार्थाय जन्ममृत्युजरातिगा ।\nया दुस्तरा दुष्कृतिभिः सर्वप्राणिभयापहा॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000723059, "chapter_id": 20723, "verse_number": "६-६६-६०", "content_sanskrit": "यस्यां भयात्प्रमज्जंति प्राणिनो यातनापराः ।\nतर्तुकामस्तु तां घोरं जया देवि नमोनमः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000723060, "chapter_id": 20723, "verse_number": "६-६६-६१", "content_sanskrit": "तस्यां देवाधितिष्ठंति या सा वैतरणी नदी ।\nसा चापि पूजिता भक्त्या प्रीत्यर्थं केशवस्य च॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000723061, "chapter_id": 20723, "verse_number": "६-६६-६२", "content_sanskrit": "यस्यास्तटे प्रविशंति ऋषयः पितरस्तथा ।\nसा चापि सिंधुरूपेण पूजिता पापहारिका॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000723062, "chapter_id": 20723, "verse_number": "६-६६-६३", "content_sanskrit": "तरीतुं तां प्रदास्यामि सर्वपापविमुक्तये ।\nपुण्यार्थं संप्रवक्ष्यामि तुभ्यं वैतरणी नदीम्॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000723063, "chapter_id": 20723, "verse_number": "६-६६-६४", "content_sanskrit": "मयासि पूजिता भक्त्या प्रीत्यर्थं केशवस्य च ।\nकृष्णकृष्णजगन्नाथ संसारादुद्धरस्व माम्॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000723064, "chapter_id": 20723, "verse_number": "६-६६-६५", "content_sanskrit": "नामग्रहणमात्रेण सर्वं पापं हरस्व मे ।\nयज्ञोपवीतं परमं कारितं नवतंतुभिः॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000723065, "chapter_id": 20723, "verse_number": "६-६६-६६", "content_sanskrit": "प्रतिगृह्णीष्व देवेश प्रीतो यच्छ ममेप्सितम् ।\nइदं तव च तांबूलं यथाशक्त्या सुशोभनम्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000723066, "chapter_id": 20723, "verse_number": "६-६६-६७", "content_sanskrit": "प्रतिगृह्णीष्व देवेश मामुद्धर भवार्णवात् ।\nपंचवर्ती प्रदीपोऽयं देवेशारार्तिकं तव॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000723067, "chapter_id": 20723, "verse_number": "६-६६-६८", "content_sanskrit": "मोहांधकारद्युमणे भक्तियुक्तो भवार्तिहृत् ।\nपरमान्नं सुपक्वान्नं समस्तरससंयुतम्॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000723068, "chapter_id": 20723, "verse_number": "६-६६-६९", "content_sanskrit": "निवेदितं मया भक्त्या भगवन्प्रतिगृह्यताम् ।\nद्वादशाक्षरमंत्रेण यथासंख्य जपेन च॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000723069, "chapter_id": 20723, "verse_number": "६-६६-७०", "content_sanskrit": "प्रीयतां मे श्रियःकांतः प्रीतो यच्छतु वांछितम् ।\nपंच गावः समुत्पन्ना मथ्यमाने महोदधौ॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000723070, "chapter_id": 20723, "verse_number": "६-६६-७१", "content_sanskrit": "तासां मध्ये तु या नंदा तस्यै धेन्वै नमोनमः ।\nगां संपूज्य विधानेन अर्घ्यं दद्यात्समाहितः॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000723071, "chapter_id": 20723, "verse_number": "६-६६-७२", "content_sanskrit": "सर्वकामदुघे देवि सर्वांतकनिवारिणी ।\nआरोग्यं संततिं दीर्घां देहि नंदिनि मे सदा॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000723072, "chapter_id": 20723, "verse_number": "६-६६-७३", "content_sanskrit": "पूजिता च वसिष्ठेन विश्वामित्रेण धीमता ।\nकपिले हर मे पापं यन्मया पूर्वसंचितम्॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000723073, "chapter_id": 20723, "verse_number": "६-६६-७४", "content_sanskrit": "गावो ममाग्रतः संतु गावो मे संतु पृष्ठतः ।\nनाके मामुपतिष्ठंतु हेमशृंगी पयोमुचः॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000723074, "chapter_id": 20723, "verse_number": "६-६६-७५", "content_sanskrit": "सुरभ्यः सौरभेयाश्च सरितः सागरा यथा ।\nसर्वदेवमये देवि सुभद्रे भक्तवत्सले॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000723075, "chapter_id": 20723, "verse_number": "६-६६-७६", "content_sanskrit": "एवं संपूज्य विधिवद्दद्याद्गोषु गवाह्निकम् ।\nसौरभेयः सर्वहिताः पवित्राः पापनाशनाः॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000723076, "chapter_id": 20723, "verse_number": "६-६६-७७", "content_sanskrit": "प्रतिगृह्णंतु मे ग्रासं गावस्त्रैलोक्यमातरः ।\nगंगदायै नमो भूत्यै सर्वपापप्रहाणये॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000723077, "chapter_id": 20723, "verse_number": "६-६६-७८", "content_sanskrit": "अनेनैव तु मंत्रेण गदां वैधारयेद्बुधः ।\nपं नमः पद्मनाभाय पद्मं वै धारयेत्सुधीः॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000723078, "chapter_id": 20723, "verse_number": "६-६६-७९", "content_sanskrit": "चं चक्ररूपिणे विष्णो धारणं चक्रजं स्मृतम् ।\nशं शंखरूपिणे तुभ्यं नमोऽस्तु सुखकारिणे॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000723079, "chapter_id": 20723, "verse_number": "६-६६-८०", "content_sanskrit": "मंत्रेणानेन वै दूता धारणं शंखजं स्मृतम् ।\nचतुर्णामायुधानां तु धारणं मुनिभिः स्मृतम्॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000723080, "chapter_id": 20723, "verse_number": "६-६६-८१", "content_sanskrit": "अग्निहोत्रं यथा नित्यं वेदस्याध्ययनं तथा ।\nब्राह्मणस्य तथैवेदं तप्तमुद्रादि धारणम्॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000723081, "chapter_id": 20723, "verse_number": "६-६६-८२", "content_sanskrit": "चंदनेन सुगंधेन गोपिकाचंदनेन तु ।\nधारणं च विशेषेण ब्राह्मणैर्वेदपारगैः॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000723082, "chapter_id": 20723, "verse_number": "६-६६-८३", "content_sanskrit": "चांडालोऽपि भवेच्छुद्धो धारणाच्च न संशयः ।\nऊर्ध्वं पुंड्रमृजुं सौम्यं सचिह्नं धारयेद्यदि॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000723083, "chapter_id": 20723, "verse_number": "६-६६-८४", "content_sanskrit": "स चांडालोऽपि शुद्धात्मा पूज्य एव सदा द्विजैः ।\nचांडालानां गृहे दूतास्तुलसी यत्र दृश्यते॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000723084, "chapter_id": 20723, "verse_number": "६-६६-८५", "content_sanskrit": "तत्रत्या तुलसी ग्राह्या भक्तिभावेन चेतसा॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}]