[{"id": 2020844, "chapter_id": 1437, "verse_number": "३-७५-०x", "content_sanskrit": "बृहदश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2020845, "chapter_id": 1437, "verse_number": "३-७५-१", "content_sanskrit": "अथ तां व्युषितो रात्रिं नलो राजा स्वलंकृतः।\nवैदर्भ्या सहितः काल्यं ददर्श वसुधाधिपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2020846, "chapter_id": 1437, "verse_number": "३-७५-२", "content_sanskrit": "ततोऽभिवादयामास प्रयतः श्वशुरं नलः।\nततो नु दमयन्ती च ववन्दे पितरं शुभा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2020847, "chapter_id": 1437, "verse_number": "३-७५-३", "content_sanskrit": "तं भीमः प्रतिजग्राह पुत्रवत्परया मुदा।\nयथार्हं पूजयित्वा च समाश्वासयत प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2020848, "chapter_id": 1437, "verse_number": "३-७५-४", "content_sanskrit": "नलेन सहितां तत्रदमयन्तीं पतिव्रताम्।\n`अनुजग्राह महता सत्कारेण क्षितीश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2020849, "chapter_id": 1437, "verse_number": "३-७५-५", "content_sanskrit": "तामर्हणां नलो राजा प्रतिगृह्य यथाविधि।\nपरिचर्यां स्वकां तस्मै यथावत्प्रत्यवेदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2020850, "chapter_id": 1437, "verse_number": "३-७५-६", "content_sanskrit": "ततो बभूव नमरे सुमहान्हर्षजः स्वनः।\nजनस्य संप्रहृष्टस्य नलं दृष्ट्वा तथाऽऽगतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2020851, "chapter_id": 1437, "verse_number": "३-७५-७", "content_sanskrit": "अशोभयच्च नगरीं पताकाध्वजमालिनीम्।\nसिक्ताः सुमृष्टपुष्पाढ्या राजमार्गाः स्वलंकृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2020852, "chapter_id": 1437, "verse_number": "३-७५-८", "content_sanskrit": "द्वारिद्वारि च पौराणां पुष्पभङ्गः प्रकल्पितः।\nअर्चितानि च सर्वाणि देवतायतनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2020853, "chapter_id": 1437, "verse_number": "३-७५-९", "content_sanskrit": "ऋतुपर्णोऽपिशुश्राव बाहुकच्छद्मिनं नलम्।\nदमयन्त्या समायुक्तं जहृषे च नराधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2020854, "chapter_id": 1437, "verse_number": "३-७५-१०", "content_sanskrit": "तमानाय्य नलं राजा क्षमयामास पार्थिवः।\nस च तं क्षमयामास हेतुभिर्बुद्धिसंमितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2020855, "chapter_id": 1437, "verse_number": "३-७५-११", "content_sanskrit": "स सत्कृतोमहीपालो नैषधं विस्मिताननः।\nदिष्ट्या समेतो दारैः स्वैर्भवानित्यभ्यनन्दत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2020856, "chapter_id": 1437, "verse_number": "३-७५-१२", "content_sanskrit": "कच्चित्तु नापराधं ते कृतवानस्मि नैषध।\nअज्ञातवासे वसतो मद्गृहेवसुधाधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2020857, "chapter_id": 1437, "verse_number": "३-७५-१३", "content_sanskrit": "यदि वाऽबुद्धिपूर्वाणि यदि बुद्ध्याऽपि कानिचित्।\nमया कृतान्यकार्याणि तानि त्वं क्षन्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2020858, "chapter_id": 1437, "verse_number": "३-७५-१४x", "content_sanskrit": "नल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2020859, "chapter_id": 1437, "verse_number": "३-७५-१४", "content_sanskrit": "न मेऽपराधं कृतवांस्त्वं स्वल्पमपि पार्थिव।\nकृतेऽपि च न मे कोपः क्षन्तव्यं हि मया तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2020860, "chapter_id": 1437, "verse_number": "३-७५-१५", "content_sanskrit": "पूर्वं ह्यापि सखा मेऽसि संबन्धी च जनाधिप।\nअत ऊर्ध्वं तु भूयस्त्वं प्रीतिमाहर्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2020861, "chapter_id": 1437, "verse_number": "३-७५-१६", "content_sanskrit": "सर्वकामैः सुविहितैः सुखमस्म्युषितस्त्वयि।\nन तथा स्वगृहेराजन्यथा तव गृहे सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2020862, "chapter_id": 1437, "verse_number": "३-७५-१७", "content_sanskrit": "इदं चैव हयज्ञानं त्वदीयं मयि तिष्ठति।\nतदुपाकर्तुमिच्छामि मन्यसे यदि पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2020863, "chapter_id": 1437, "verse_number": "३-७५-१८", "content_sanskrit": "एवमुक्त्वा ददौ विद्यामृतुपर्णाय नैषधः।\nस च तां प्रतिजग्राह विधिदृष्टेन क्रमणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2020864, "chapter_id": 1437, "verse_number": "३-७५-१९", "content_sanskrit": "गृहीत्वा चाश्वहृदयं प्रीतो भागस्वरिर्नृप।\nनिषधाधिपतेश्चापि दत्ताऽक्षहृदयं नृपः।\nसूतमन्यमुपादाय ययौ स्वपुरमेव ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2020865, "chapter_id": 1437, "verse_number": "३-७५-२०", "content_sanskrit": "ऋतुपर्णे गते राजन्नलो राजा विशांपते।\nनगरे कुण्डिने कालं नातिदीर्गमिवावसत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2020866, "chapter_id": 1437, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वयणि नलोपाख्यानपर्वणि पञ्चसप्ततितमोऽध्यायः ॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]