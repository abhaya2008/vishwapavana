[{"id": 2094796, "chapter_id": 3028, "verse_number": "१३-१५८-१", "content_sanskrit": "युधिष्ठिर उवाच।\nब्राह्मणस्वानि ये मन्दा हरन्ति भरतर्षभ।\nनृशंसकारिणो योनिं कां ते गच्छन्ति मानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2094797, "chapter_id": 3028, "verse_number": "१३-१५८-२x", "content_sanskrit": "भीष्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2094798, "chapter_id": 3028, "verse_number": "१३-१५८-२", "content_sanskrit": "पातकानां परं ह्येतद्ब्रह्मस्वहरणं बलात्।\nसान्वयास्ते विनश्यन्ति चण्डालाः प्रेत्य चेह च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2094799, "chapter_id": 3028, "verse_number": "१३-१५८-३", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनमम्।\nचण्डालस्य च संवादं क्षत्रबन्धोश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2094800, "chapter_id": 3028, "verse_number": "१३-१५८-४x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2094801, "chapter_id": 3028, "verse_number": "१३-१५८-४", "content_sanskrit": "वृद्धरूपोऽसि चण्डाल बालवच्च विचेष्टसे।\nश्वखराणां रजःसेवी कस्मादुद्विजसे गवाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2094802, "chapter_id": 3028, "verse_number": "१३-१५८-५", "content_sanskrit": "साधुभिर्गर्हितं कर्म चण्डालस्य विधीयते।\nकस्माद्गोरजसा ध्वस्तमङ्गं तोयेन सिञ्चसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2094803, "chapter_id": 3028, "verse_number": "१३-१५८-६x", "content_sanskrit": "चण्डाल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2094804, "chapter_id": 3028, "verse_number": "१३-१५८-६", "content_sanskrit": "ब्राह्मणस्य गवां राजन्प्रयान्तीनां रजः पुरा।\nसोममुद्ध्वंसयामास तं सोममपिबन्द्विजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2094805, "chapter_id": 3028, "verse_number": "१३-१५८-७", "content_sanskrit": "भृत्यानामपि राज्ञस्तु रजसा ध्वंसितं मखे।\nतत्पानाच्च द्विजाः सर्वे क्षिप्रं नरकमाविशन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2094806, "chapter_id": 3028, "verse_number": "१३-१५८-८", "content_sanskrit": "दीक्षितश्च स राजाऽपि क्षिप्रं नरकमाविशत्।\nसह तैर्याजकैः सर्वैर्ब्रह्मस्वमुपजीव्य तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2094807, "chapter_id": 3028, "verse_number": "१३-१५८-९", "content_sanskrit": "येऽपि तत्रापिबन्क्षीरं घृतं दधि च मानवाः।\nब्राह्मणाः सहराजन्याः सर्वे नरकमाविशन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2094808, "chapter_id": 3028, "verse_number": "१३-१५८-१०", "content_sanskrit": "जघ्नुस्ताः पयसा पुत्रांस्तथा पौत्रान्विधूय तान्।\nपशूनवेक्षमाणश्च साधुवृत्तेन दंपती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2094809, "chapter_id": 3028, "verse_number": "१३-१५८-११", "content_sanskrit": "अहं तत्रावसं राजन्ब्रह्मचारी जितेन्द्रियः।\nतासां मे रजसा ध्वस्तं भैक्षमासीन्नराधिप", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2094810, "chapter_id": 3028, "verse_number": "१३-१५८-१२", "content_sanskrit": "चण्डालोऽहं ततो राजन्भुक्त्वा तदभवं नृप।\nब्रह्मस्वहारी न नृपः सोऽप्रतिष्ठां गतिं ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2094811, "chapter_id": 3028, "verse_number": "१३-१५८-१३", "content_sanskrit": "तस्माद्धरेन्न विप्रस्वं कदाचिदपि किञ्चन।\nन पश्येन्नानुमोदेच्च न हर्तुं किञ्चिदाहरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2094812, "chapter_id": 3028, "verse_number": "१३-१५८-१४", "content_sanskrit": "ब्रह्मस्वं रजसा ध्वस्तं भुक्त्वा मां पश्य यादृशम्।\nतस्मात्सोमोऽप्यविक्रेयः पुरुषेण विपश्चिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2094813, "chapter_id": 3028, "verse_number": "१३-१५८-१५", "content_sanskrit": "एतद्धि धनमुत्कृष्टं द्विजानामविशेषतः।\nविक्रयं त्विह सोमस्य गर्हयन्ति मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2094814, "chapter_id": 3028, "verse_number": "१३-१५८-१६", "content_sanskrit": "ये चैनं क्रीणते तात ये च विक्रीणते जनाः।\nते तु वैवस्वतं प्राप्य रौरवं यान्ति सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2094815, "chapter_id": 3028, "verse_number": "१३-१५८-१७", "content_sanskrit": "सोमं तु रजसा ध्वस्तं विक्रीणन्विधिपूर्वकम्।\nश्रोत्रियो वार्धुषी भूत्वा नचिरं स विनश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2094816, "chapter_id": 3028, "verse_number": "१३-१५८-१८", "content_sanskrit": "नरकं त्रिंशतं प्राप्य स्वविष्ठामुपजीवति।\nब्रह्मस्वहारी नरकान्यातनाश्चानुभूय तु।\nमलेषु च कृमिर्भूत्वा श्वविष्ठामुपजीवती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2094817, "chapter_id": 3028, "verse_number": "१३-१५८-१९", "content_sanskrit": "श्वचर्यामतिमानं च सखिदारेषु विप्लवम्।\nतुलयाधारयद्धर्मो ह्यतिमानोऽतिरिच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2094818, "chapter_id": 3028, "verse_number": "१३-१५८-२०", "content_sanskrit": "म्लानं मां विकलं पश्य विवर्णं हरिणं कृशम्।\nअतिमानेनि मां पश्य पापां गतिमुपागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2094819, "chapter_id": 3028, "verse_number": "१३-१५८-२१", "content_sanskrit": "अहं वै विपुले तात कुले दनसमन्विते।\nपौराणे जन्मनि विभो ज्ञानविज्ञानपारगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2094820, "chapter_id": 3028, "verse_number": "१३-१५८-२२", "content_sanskrit": "अभवं तत्र जानानो ह्येतान्दोषान्मदात्सदा।\nसंरब्ध एव भूतानां पृष्ठमांसमभक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2094821, "chapter_id": 3028, "verse_number": "१३-१५८-२३", "content_sanskrit": "सोऽहं वै विदितः सर्वैर्दूरगो वनिनो वने।\nसाधूनां परिभावेप्सुर्विप्राणां गर्वितो धनैः।\nइमामवस्थां सम्प्राप्तः पश्य कालस्य पर्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2094822, "chapter_id": 3028, "verse_number": "१३-१५८-२४", "content_sanskrit": "आदीप्तमिव चैलान्तं भ्रमरैरिव चार्दितम्।\nधावमानं सुसंरब्दं फश्य मां रजसाऽन्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2094823, "chapter_id": 3028, "verse_number": "१३-१५८-२५", "content_sanskrit": "स्वाध्यायैस्तु महात्पापं हरन्ति गृहमेधिनः।\nदानैः पृथग्विधैश्चापि विप्रजात्यां मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2094824, "chapter_id": 3028, "verse_number": "१३-१५८-२६", "content_sanskrit": "तथा पापकृतं विप्रमाश्रमस्तं महीपते।\nसर्वसङ्गविनिर्मुक्तं छन्दांस्युत्तारयन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2094825, "chapter_id": 3028, "verse_number": "१३-१५८-२७", "content_sanskrit": "अहं हि पापयोन्यां वै प्रसूतः क्षत्रियर्षभ।\nनिश्चयं नाधिगच्छामि कथं मुच्येयमित्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2094826, "chapter_id": 3028, "verse_number": "१३-१५८-२८", "content_sanskrit": "जातिस्मरत्वं च मम केनचित्पूर्वकर्मणा।\nशुभने येन मोक्षं वै प्राप्तुमिच्छाम्यहं नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2094827, "chapter_id": 3028, "verse_number": "१३-१५८-२९", "content_sanskrit": "त्वमिमं सम्प्रपन्नाय संशयं ब्रूहि पृच्छते।\nचण्डालत्वात्कथमहं मुच्येयमिति सत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2094828, "chapter_id": 3028, "verse_number": "१३-१५८-३०x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2094829, "chapter_id": 3028, "verse_number": "१३-१५८-३०", "content_sanskrit": "चण्डाल प्रतिजानीहि येन मोक्षमवाप्स्यसि।\nब्राह्मणार्थे त्यजन्प्राणान्गतिमिष्टामवाप्स्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2094830, "chapter_id": 3028, "verse_number": "१३-१५८-३१", "content_sanskrit": "दत्त्वा शरीरं क्रव्याद्भ्यो रणाग्नौ द्विजहेतुकम्।\nहित्वा प्राणान्प्रमोक्षस्ते नान्यथा मोक्षमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2094831, "chapter_id": 3028, "verse_number": "१३-१५८-३२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2094832, "chapter_id": 3028, "verse_number": "१३-१५८-३२", "content_sanskrit": "इत्युक्तः स तदा तेन ब्रह्मस्वार्थे परन्तप।\nहित्वा रणमुखे प्राणान्गतिमिष्टामवाप ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2094833, "chapter_id": 3028, "verse_number": "१३-१५८-३३", "content_sanskrit": "तस्माद्रक्ष्यं त्वया पुत्र ब्रह्मस्वं भरतर्षभ।\nयदीच्छसि महाबाहो शाश्वतीं गतिमात्मनः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2094834, "chapter_id": 3028, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि अष्टपञ्चाशदधिकशततमोऽध्यायः॥ १५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]