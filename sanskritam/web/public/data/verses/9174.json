[{"id": 5000174000, "chapter_id": 9174, "verse_number": "२-९७-१", "content_sanskrit": "सुसंरब्धं तु सौमित्रिं लक्ष्मणं क्रोधमूर्च्छितम्।\nरामस्तु परिसान्त्व्याथ वचनं चेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000174001, "chapter_id": 9174, "verse_number": "२-९७-२", "content_sanskrit": "किमत्र धनुषा कार्यमसिना वा सचर्मणा।\nमहेष्वासे महाप्राज्ञे भरते स्वयमागते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000174002, "chapter_id": 9174, "verse_number": "२-९७-३", "content_sanskrit": "पितु: सत्यं प्रतिश्रुत्य हत्वा भरतमागतम्।\nकिं करिष्ऺयामि राज्येन सापवादेन लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000174003, "chapter_id": 9174, "verse_number": "२-९७-४", "content_sanskrit": "यद्द्रव्यं बान्धवानां वा मित्राणां वा क्षये भवेत्।\nनाहं तत् प्रतिगृह्णीयां भक्षान् विषकृतानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000174004, "chapter_id": 9174, "verse_number": "२-९७-५", "content_sanskrit": "धर्ममर्थं च कामं च पृथिवीं चापि लक्ष्मण।\nइच्छामि भवतामर्थे एतत् प्रतिश्रृणोमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000174005, "chapter_id": 9174, "verse_number": "२-९७-६", "content_sanskrit": "भ्रातऽणां सङ्ग्रहार्थं च सुखार्थं चापि लक्ष्मण।\nराज्यमप्यहमिच्छामि सत्येनायुधमालभे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000174006, "chapter_id": 9174, "verse_number": "२-९७-७", "content_sanskrit": "नेयं मम मही सौम्य दुर्ल्लभा सागराम्बरा।\nनहीच्छेयमधर्मेण शक्रत्वमपि लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000174007, "chapter_id": 9174, "verse_number": "२-९७-८", "content_sanskrit": "यद्विना भरतं त्वां च शत्रुघ्नं चापि मानद।\nभवेन्मम सुखं किञ्चिद्भस्म तत् कुरुतां शिखी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000174008, "chapter_id": 9174, "verse_number": "२-९७-९", "content_sanskrit": "मन्येऽहमागतोऽयोध्यां भरतो भ्रातृवत्सल:।\nमम प्राणात् प्रियतर: कुलधर्ममनुस्मरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000174009, "chapter_id": 9174, "verse_number": "२-९७-१०", "content_sanskrit": "श्रुत्वा प्रव्राजितं मां हि जटावल्कलधारिणम्।\nजानक्या सहितं वीर त्वया च पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000174010, "chapter_id": 9174, "verse_number": "२-९७-११", "content_sanskrit": "स्नेहेनाक्रान्तहृदय: शोकेनाकुलितेन्द्रिय:।\nद्रष्टुमभ्यागतो ह्येष भरतो नान्यथा गत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000174011, "chapter_id": 9174, "verse_number": "२-९७-१२", "content_sanskrit": "अम्बां च कैकयीं रुष्य परुषं चाप्रियं वदन्।\nप्रसाद्य पितरं श्रीमान् राज्यं मे दातुमागत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000174012, "chapter_id": 9174, "verse_number": "२-९७-१३", "content_sanskrit": "प्राप्तकालं यदेषोऽस्मान् भरतो द्रष्टुमिच्छति।\nअस्मासु मनसाप्येष नाप्रियं किञ्चिदाचरेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000174013, "chapter_id": 9174, "verse_number": "२-९७-१४", "content_sanskrit": "विप्रियं कृतपूर्वं ते भरतेन कदा नु किम्।\nईदृशं वा भयं तेऽद्य भरतं योऽत्र शङ्कसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000174014, "chapter_id": 9174, "verse_number": "२-९७-१५", "content_sanskrit": "नहि ते निष्ठुरं वाच्यो भरतो नाप्रियं वच:।\nअहं ह्यप्रियमुक्त: स्यां भरतस्याप्रिये कृते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000174015, "chapter_id": 9174, "verse_number": "२-९७-१६", "content_sanskrit": "कथं नु पुत्रा: पितरं हन्यु: कस्याञ्चिदापदि।\nभ्राता वा भ्रातरं हन्यात् सौमित्रे प्राणमात्मन: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000174016, "chapter_id": 9174, "verse_number": "२-९७-१७", "content_sanskrit": "यदि राज्यस्य हेतोस्त्वमिमां वाचं प्रभाषसे।\nवक्ष्यामि भरतं दृष्ट्वा राज्यमस्मै प्रदीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000174017, "chapter_id": 9174, "verse_number": "२-९७-१८", "content_sanskrit": "उच्यमानोऽपि भरतो मया लक्ष्मण तत्त्वत:।\nराज्यमस्मै प्रयच्छेति बाढमित्येव वक्ष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000174018, "chapter_id": 9174, "verse_number": "२-९७-१९", "content_sanskrit": "तथोक्तो धर्मशीलेन भ्रात्रा तस्य हिते रत:।\nलक्ष्मण: प्रविवेशेव स्वानि गात्राणि लज्जया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000174019, "chapter_id": 9174, "verse_number": "२-९७-२०", "content_sanskrit": "तद्वाक्यं लक्ष्मण: श्रुत्वा व्रीडित: प्रत्युवाच ह।\nत्वां मन्ये द्रष्टुमायात: पिता दशरथ: स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000174020, "chapter_id": 9174, "verse_number": "२-९७-२१", "content_sanskrit": "व्रीडितं लक्ष्मणं दृष्ट्वा राघव: प्रत्युवाच ह।\nएष मन्ये महाबाहुरिहास्मान् द्रष्टुमागत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000174021, "chapter_id": 9174, "verse_number": "२-९७-२२", "content_sanskrit": "अथवा नौ ध्रुवं मन्ये मन्यमान: सुखोचितौ।\nवनवासमनुध्याय गृहाय प्रतिनेष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000174022, "chapter_id": 9174, "verse_number": "२-९७-२३", "content_sanskrit": "इमां वाप्येष वैदेहीमत्यन्तसुखसेविनीम्।\nपिता मे राघव: श्रीमान् वनादादाय यास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000174023, "chapter_id": 9174, "verse_number": "२-९७-२४", "content_sanskrit": "एतौ तौ सम्प्रकाशेते गोत्रवन्तौ मनोरमौ।\nवायुवेगसमौ वीर जवनौ तुरगोत्तमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000174024, "chapter_id": 9174, "verse_number": "२-९७-२५", "content_sanskrit": "स एष सुमहाकाय: कम्पते वाहिनीमुखे।\nनाग: शत्रुञ्जयो नाम वृद्धस्तातस्य धीमत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000174025, "chapter_id": 9174, "verse_number": "२-९७-२६", "content_sanskrit": "न तु पश्यामि तच्छत्ऺत्रं पाण्डरं लोकसत्कृतम्।\nपितुर्दिव्यं महाबाहो संशयो भवतीह मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000174026, "chapter_id": 9174, "verse_number": "२-९७-२७", "content_sanskrit": "प्रथममर्धमुत्तरार्धेन योजनीयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000174027, "chapter_id": 9174, "verse_number": "२-९७-२८", "content_sanskrit": "अवतीर्य्य तु सालाग्रात्तस्मात्स समितिञ्जय:।\nलक्ष्मण: प्राञ्जलिर्भूत्वा तस्थौ रामस्य पार्श्वत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000174028, "chapter_id": 9174, "verse_number": "२-९७-२९", "content_sanskrit": "भरतेनापि सन्दिष्टा सम्मर्दो न भवेदिऺति।\nसमन्तात्तस्य शैलस्य सेना वासमकल्पयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000174029, "chapter_id": 9174, "verse_number": "२-९७-३०", "content_sanskrit": "अध्यर्द्धमिक्ष्वाकुचमूर्योजनं पर्वतस्य सा।\nपार्श्वे न्यविशदावृत्य गजवाजिरथाकुला ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000174030, "chapter_id": 9174, "verse_number": "२-९७-३१", "content_sanskrit": "सा चित्रकूटे भरतेन सेना धर्मं पुरस्कृत्य विधूय दर्प्पम्।\nप्रसादनार्थं रघुनन्दनस्य विराजते नीतिमता प्रणीता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000174031, "chapter_id": 9174, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदयोध्याकाण्डे सप्तनवतितम: सर्ग: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]