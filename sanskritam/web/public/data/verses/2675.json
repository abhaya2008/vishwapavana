[{"id": 2078864, "chapter_id": 2675, "verse_number": "१२-१८०-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2078865, "chapter_id": 2675, "verse_number": "१२-१८०-१", "content_sanskrit": "कुतः सृष्टमिदं सर्वं जगत्स्थावरजङ्गमम्।\nप्रलये च किमभ्येति तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2078866, "chapter_id": 2675, "verse_number": "१२-१८०-२", "content_sanskrit": "ससागरः सगगनः सशैलः सबलाहकः।\nसभूमिः साग्निपवनो लोकोऽयं केन निर्मितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2078867, "chapter_id": 2675, "verse_number": "१२-१८०-३", "content_sanskrit": "कथं सृष्टानि भूतानि कथं वर्णविभक्तयः।\nशोचाशौचं कथं तेषां धर्माधर्मावथो कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2078868, "chapter_id": 2675, "verse_number": "१२-१८०-४", "content_sanskrit": "कीदृशो जीवतां जीवः क्व वा गच्छन्ति ये मृताः।\nअस्माल्लोकादमुं लोकं सर्वं शंसतु नो भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2078869, "chapter_id": 2675, "verse_number": "१२-१८०-५x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2078870, "chapter_id": 2675, "verse_number": "१२-१८०-५", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nभृगुणाऽभिहितं श्रेष्ठं भरद्वाजाय पृच्छते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2078871, "chapter_id": 2675, "verse_number": "१२-१८०-६", "content_sanskrit": "कैलासशिखरे दृष्ट्वा दीप्यमानमिवौजसा।\nभृगुं महर्षिमासीनं भरद्वाजोऽन्वपृच्छत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2078872, "chapter_id": 2675, "verse_number": "१२-१८०-७", "content_sanskrit": "ससागरः सगगनः शशैलः सवलाहकः।\nसभूमिः साग्निपवनो लोकोऽयं केन निर्मितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2078873, "chapter_id": 2675, "verse_number": "१२-१८०-८", "content_sanskrit": "कथं सृष्टानि भूतानि कथं वर्णविभक्तयः।\nशौचाशौचं कथं तेषां धर्माधर्मावथो कथम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2078874, "chapter_id": 2675, "verse_number": "१२-१८०-९", "content_sanskrit": "कीदृशो जीवतां जीवः क्व वा गच्छन्ति ये मृताः।\nपरलोकमिमं चापि सर्वं शंसितृमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2078875, "chapter_id": 2675, "verse_number": "१२-१८०-१०", "content_sanskrit": "एवं स भगवान्पृष्टो भरद्वाजेन संशयम्।\nब्रह्मर्पिर्ब्रह्मसंकाशः सर्वं तस्मै ततोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2078876, "chapter_id": 2675, "verse_number": "१२-१८०-११x", "content_sanskrit": "भृगुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2078877, "chapter_id": 2675, "verse_number": "१२-१८०-११", "content_sanskrit": "`नारायणो जगन्मूर्तिरन्तरात्मा सनातनः।\nकूटस्थोऽक्षर अव्यक्तो निर्लेपो व्यापकः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2078878, "chapter_id": 2675, "verse_number": "१२-१८०-१२", "content_sanskrit": "प्रकृतेः परतो नित्यमिन्द्रियैरप्यगोतरः।\nस सिसृक्षुः सहस्रांशादसृजत्पुरुषं प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2078879, "chapter_id": 2675, "verse_number": "१२-१८०-१३", "content_sanskrit": "मानसो नाम यः पूर्वो विश्रुतो वै महर्षिभिः।\nअनादिनिधनो देवस्तथाऽभेद्योऽदजरामरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2078880, "chapter_id": 2675, "verse_number": "१२-१८०-१४", "content_sanskrit": "अव्यक्त इति विख्यातः शाश्वतोऽथाक्षयोऽव्ययः।\nयतः सृष्टानि भूतानि तिष्ठन्ति च म्रियन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2078881, "chapter_id": 2675, "verse_number": "१२-१८०-१५", "content_sanskrit": "सोऽसृजत्प्रथमं देवो महान्तं नाम नामतः।\nमहान्ससर्जाहंकारं स चापि भगवानथ।\nआकाशमिति विख्यातं सर्वभूतधरः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2078882, "chapter_id": 2675, "verse_number": "१२-१८०-१६", "content_sanskrit": "आकाशादभवद्वारि सलिलादग्निमारुतौ।\nअग्निमारुतसंयोगात्ततः समभवन्मही॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2078883, "chapter_id": 2675, "verse_number": "१२-१८०-१७", "content_sanskrit": "ततस्ते गेमयं दिव्यं पद्मं सृष्टं स्वयंभुवा।\nतस्मात्पद्मात्समभवद्ब्रह्मा वेदमयो निधिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2078884, "chapter_id": 2675, "verse_number": "१२-१८०-१८", "content_sanskrit": "अहंकार इति ख्यातः सर्वभूतात्मभूतकृत्।\nब्रह्मा वै स महातेजा य एते पञ्चधातवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2078885, "chapter_id": 2675, "verse_number": "१२-१८०-१९", "content_sanskrit": "शैलास्तस्यास्थिसंज्ञास्तु मेदो मांसं च मेदिनी।\nसमुद्रास्तस्य रुधिरमाकाशमुदरं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2078886, "chapter_id": 2675, "verse_number": "१२-१८०-२०", "content_sanskrit": "पवनश्चैव निःश्वासस्तेजोऽग्निर्निम्नगाः सिराः।\nदिवाकरश्च सोमश्च नयने तस्य विश्रुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2078887, "chapter_id": 2675, "verse_number": "१२-१८०-२१", "content_sanskrit": "नभश्चोर्ध्वं शिरस्तस्य क्षितिः पादौ भुजौ दिशः।\nदुर्विज्ञेयो ह्यनन्तात्मा सिद्धैरपि न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2078888, "chapter_id": 2675, "verse_number": "१२-१८०-२२", "content_sanskrit": "स एष भगवान्विष्णुरनन्त इति विश्रुतः।\nसर्वभूतात्मभूतस्थो दुर्विज्ञेयोऽकृतात्माभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2078889, "chapter_id": 2675, "verse_number": "१२-१८०-२३", "content_sanskrit": "अहंकारस्य यः स्रष्टा सर्वभूतोद्भवाय वै।\nयतः समभवद्विश्वं पृष्टोऽहं यदिह त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2078890, "chapter_id": 2675, "verse_number": "१२-१८०-२४x", "content_sanskrit": "भरद्वाज उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2078891, "chapter_id": 2675, "verse_number": "१२-१८०-२४", "content_sanskrit": "गगनस्य दिशां चैव भूतलस्यानिलस्य च।\nकान्यत्र परिमाणानि संशयं छिन्धि मेऽर्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2078892, "chapter_id": 2675, "verse_number": "१२-१८०-२५x", "content_sanskrit": "भृगुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2078893, "chapter_id": 2675, "verse_number": "१२-१८०-२५", "content_sanskrit": "अनन्तमेतदाकाशं सिद्धचारणसेवितम्।\nरम्यं नानाश्रयाकीर्णं यस्यान्तो नाधिगम्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2078894, "chapter_id": 2675, "verse_number": "१२-१८०-२६", "content_sanskrit": "ऊर्ध्वं गतेरधस्तात्तु चन्द्रादित्यौ न दृश्यतः।\nतत्र देवाः स्वयं दीप्ताः सूर्यभासोऽग्निवर्चसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2078895, "chapter_id": 2675, "verse_number": "१२-१८०-२७", "content_sanskrit": "ते चाप्यन्तं न पश्यन्ति नभसः प्रथितौजसः।\nदुर्गमत्वादनन्तत्वादिति वै विद्धि मानद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2078896, "chapter_id": 2675, "verse_number": "१२-१८०-२८", "content_sanskrit": "उपर्युपरि तैर्देवैः प्रज्वलद्भिः स्वयंप्रभैः।\nनिरुद्धमेतदाकाशमप्रमेयं सुरैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2078897, "chapter_id": 2675, "verse_number": "१२-१८०-२९", "content_sanskrit": "पृथिव्यन्ते समुद्रास्तु समुद्रान्ते तमः स्मृतम्।\nतप्नसोऽन्ते जलं प्राहुर्जलस्यान्तेऽग्निरेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2078898, "chapter_id": 2675, "verse_number": "१२-१८०-३०", "content_sanskrit": "रसातलान्ते सलिलं जलान्ते पन्नगाधिपाः।\nतदन्ते पुनराकाशमाकाशान्ते पुनर्जलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2078899, "chapter_id": 2675, "verse_number": "१२-१८०-३१", "content_sanskrit": "एवमन्तं हि नभसः प्रमाणं सलिलस्य च।\nअग्निमारुतयोश्चैव दुर्ज्ञेयं दैवतैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2078900, "chapter_id": 2675, "verse_number": "१२-१८०-३२", "content_sanskrit": "अग्निमारुततोयानां वर्णाः क्षितितलस्य च।\nआकाशसदृशा ह्येते भिद्यन्तेऽतत्वदर्शनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2078901, "chapter_id": 2675, "verse_number": "१२-१८०-३३", "content_sanskrit": "पठन्ति चैव मुनयः शास्त्रेषु विविधेषु च।\nत्रैलोक्यसागरे चैव प्रमाणं विहितं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2078902, "chapter_id": 2675, "verse_number": "१२-१८०-३४", "content_sanskrit": "अदृश्यत्वादगम्यत्वात्कः प्रमाणमुदाहरेत्।\nसिद्धानां देवतानां च यदा परिमिता गतिः।\nतदा गौणमनन्तस्य नामानन्तेति विश्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2078903, "chapter_id": 2675, "verse_number": "१२-१८०-३५", "content_sanskrit": "नामधेयानुरूपस्य मानसस्य महात्मनः।\nयदा तु र्दिव्यं यद्रूपं ह्रसते वर्धते पुनः।\nकोऽन्यस्तद्वेदितुं शक्तो योपि स्यात्तद्विधोऽपरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2078904, "chapter_id": 2675, "verse_number": "१२-१८०-३६", "content_sanskrit": "ततः पुष्करतः सृष्टः सर्वज्ञो मूर्तिमान्प्रभुः।\nब्रह्मा धर्ममयः पूर्वः प्रजापतिरनुत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2078905, "chapter_id": 2675, "verse_number": "१२-१८०-३७x", "content_sanskrit": "भरद्वाज उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2078906, "chapter_id": 2675, "verse_number": "१२-१८०-३७", "content_sanskrit": "पुष्कराद्यदि संभूतो ज्येष्ठं भवति पुष्करम्।\nब्रह्माणं पूर्वजं चाह भवान्संदेह एव मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2078907, "chapter_id": 2675, "verse_number": "१२-१८०-३८x", "content_sanskrit": "भृगुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2078908, "chapter_id": 2675, "verse_number": "१२-१८०-३८", "content_sanskrit": "मानसस्येह या मूर्तिर्ब्रह्मत्वं समुपागता।\nतस्यासनविधानार्थं पृथिवी पद्ममुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2078909, "chapter_id": 2675, "verse_number": "१२-१८०-३९", "content_sanskrit": "कर्णिकां तस्य पद्मस्य मेरुर्गगमुच्छ्रितः।\nतस्य मध्ये स्थितो लोकान्सृजते जगतः प्रभुः।\nमानसांश्च तथा देवान्भूतानि विविधानि च॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2078910, "chapter_id": 2675, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि अशीत्यधिकशततमोऽध्यायः॥ १८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]