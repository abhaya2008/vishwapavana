[{"id": 7003694000, "chapter_id": 23694, "verse_number": "१-४-२-१", "content_sanskrit": "नंदिकेश्वर उवाच ।\nस्थानं त्वया मुने पृष्टमस्ति माहेश्वराग्रणि ।\nचराचराणां सर्वेषां भूतानामपि शर्मणे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003694001, "chapter_id": 23694, "verse_number": "१-४-२-२", "content_sanskrit": "प्रकल्पितं हि देवेन तत्तत्कर्मानुगुण्यतः ।\nशरीरभाजां जननं तासुतास्वपि योनिषु ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003694002, "chapter_id": 23694, "verse_number": "१-४-२-३", "content_sanskrit": "त्वया शुश्रुषितं तेषां हिताय महते ह्यलम् ।\nअन्यथा संसृतेर्हानिः कल्पकोटिशतैर्नहि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003694003, "chapter_id": 23694, "verse_number": "१-४-२-४", "content_sanskrit": "स्वल्पैर्हि कर्मभिर्ज्ञानैरपि प्राप्ता पुनःपुनः ।\nघटीयंत्रनयाज्जन्ममरणे नैव शाम्यतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003694004, "chapter_id": 23694, "verse_number": "१-४-२-५", "content_sanskrit": "कथं नु विरतो देही गर्भमोकसमागमात् ।\nविश्रांतये प्रकल्पेत विशुद्धज्ञानतो विना ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003694005, "chapter_id": 23694, "verse_number": "१-४-२-६", "content_sanskrit": "प्रदेशाः कथिताः पूर्वं प्रसंगवशतो मया ।\nऋषिभेदादिकं तेषु निवासः कृत्तिवाससः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003694006, "chapter_id": 23694, "verse_number": "१-४-२-७", "content_sanskrit": "केचित्तीरेषु गंगायाः केचित्सारस्वते तटे ।\nकालिंदीतीरयोरन्ये कतिचिच्छोणरोधसि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003694007, "chapter_id": 23694, "verse_number": "१-४-२-८", "content_sanskrit": "अपरे नर्मदातीरे परे गोदावरीतटे ।\nकतिचिद्गोमतीतीरेष्वन्ये हैमवतीतटे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003694008, "chapter_id": 23694, "verse_number": "१-४-२-९", "content_sanskrit": "समुद्रपार्श्वेष्वितरं द्वीपेष्वन्ये सरस्वताम् ।\nमुखेषु केचित्सिंधूनां संभेदेष्वपि केचन ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003694009, "chapter_id": 23694, "verse_number": "१-४-२-१०", "content_sanskrit": "कृष्णवेणीतटे केचित्तुंगभद्रांतिके परे ।\nउपवेण्यां कतिपये परे शक्त्यापगांतिके ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003694010, "chapter_id": 23694, "verse_number": "१-४-२-११", "content_sanskrit": "कावेरीतीर इतरे केचिद्वेगवतीतटे ।\nअन्ये तु ताम्रपर्ण्याश्च कतिचिन्मुरलातटे ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003694011, "chapter_id": 23694, "verse_number": "१-४-२-१२", "content_sanskrit": "केचिदैरावतीतीरे त्वितरे यातुकांक्षिके ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003694012, "chapter_id": 23694, "verse_number": "१-४-२-१३", "content_sanskrit": "कन्यातटेषु कतिचित्कतिचित्कुमारीतीरे परे च तमसावरुणांतिकेन्ये ।\nमंदाकिनीसविधयोरितरे परेऽपि शिप्रातटे परिसरेषु परे सरय्वाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003694013, "chapter_id": 23694, "verse_number": "१-४-२-१४", "content_sanskrit": "विपाशाभ्याश इतरे शतद्रुतितटे परे ।\nचर्मण्वत्युपकंठेऽन्ये केचिद्भीमरथीतटे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003694014, "chapter_id": 23694, "verse_number": "१-४-२-१५", "content_sanskrit": "केचिद्बिंदुसरोभ्यर्णे परे पंपासरस्तटे ।\nअभ्यर्णकेपि भैरव्याः कतिचित्कौशिकीतटे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003694015, "chapter_id": 23694, "verse_number": "१-४-२-१६", "content_sanskrit": "अपरे मालिनीतीरे परे गंधवतीतटे ।\nकतिचिन्मानसोपांते केचिदच्छोदरोधसि ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003694016, "chapter_id": 23694, "verse_number": "१-४-२-१७", "content_sanskrit": "इंद्रद्युम्नसरस्यन्य एके तु मणिकर्णिके ।\nपरे तु वरदातीरे ताप्यां कतिचनापरे ।\nपातालगंगासविधे शरावत्यंतिके परे ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003694017, "chapter_id": 23694, "verse_number": "१-४-२-१८", "content_sanskrit": "लोहित्याकूलयोः केचित्कतिचित्कालमातटे ।\nवितस्तोपांतिके त्वन्ये चंद्रभागांतिके परे ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003694018, "chapter_id": 23694, "verse_number": "१-४-२-१९", "content_sanskrit": "सुरलोपांतिके केचित्पयोष्णीतीरयोः परे ।\nकेचिन्मधुमतीतीरे केचनानु पिनाकिनीम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003694019, "chapter_id": 23694, "verse_number": "१-४-२-२०", "content_sanskrit": "उक्तं वाराणसीक्षेत्रं क्रोशपंचकपावनम् ।\nदेवस्तत्राविमुक्ताख्यो विशालाक्ष्या समर्चितः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003694020, "chapter_id": 23694, "verse_number": "१-४-२-२१", "content_sanskrit": "कपालमोचनं यत्र यत्रास्ते कालभैरवः ।\nमृतानां यत्र रुद्रत्वं काशीं विद्धि हि तां मुने ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003694021, "chapter_id": 23694, "verse_number": "१-४-२-२२", "content_sanskrit": "गयाप्रयागावपि ते कथितौ सर्वसिद्धिदौ ।\nयत्र पिंडप्रदानेन तुष्यंति पितरः किल ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003694022, "chapter_id": 23694, "verse_number": "१-४-२-२३", "content_sanskrit": "आकर्णितं च केदारं यस्मिन्महिषरूपधृक् ।\nदेवोपि च हतो देव्या सर्वश्रेयस्करो नृणाम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003694023, "chapter_id": 23694, "verse_number": "१-४-२-२४", "content_sanskrit": "सर्वसिद्धिकरं पुंसां क्षेत्रं बदरिकाश्रमम् ।\nयत्रास्ते त्र्यंबको देव्या नरनारायणार्चितः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003694024, "chapter_id": 23694, "verse_number": "१-४-२-२५", "content_sanskrit": "श्रुतं हि नैमिषं क्षेत्रं त्वया यत्र महेश्वरः ।\nदेवदेवाभिधः पुण्यो देवी सारंगधारिणी ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003694025, "chapter_id": 23694, "verse_number": "१-४-२-२६", "content_sanskrit": "अमरेशमिति स्थानं प्रोक्तं सर्वार्थसाधकम् ।\nओंकारनामा तत्रेशश्चंडिकाख्या महेश्वरी ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003694026, "chapter_id": 23694, "verse_number": "१-४-२-२७", "content_sanskrit": "पुष्कराख्यं महास्थानं श्रुतं ते कथितं मया ।\nयत्र देवो रुजोगंधिः पुरुहूता महेश्वरी ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003694027, "chapter_id": 23694, "verse_number": "१-४-२-२८", "content_sanskrit": "आषाढीनाम ते स्थानं पावनं कथितं मया ।\nआषाढेशो हरस्तत्र रतीशा परमेश्वरी ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003694028, "chapter_id": 23694, "verse_number": "१-४-२-२९", "content_sanskrit": "दंडिमुंडी समाख्यं च स्थानं ते कथितं मया ।\nयत्र मुंडी महादेवो दंडिका परमेश्वरी ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003694029, "chapter_id": 23694, "verse_number": "१-४-२-३०", "content_sanskrit": "लाकुलंनाम ते स्थानं संशुद्धं कथितं मया ।\nलाकुलीशो हरो यस्मिन्ननंगा सर्वमंगला ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003694030, "chapter_id": 23694, "verse_number": "१-४-२-३१", "content_sanskrit": "भारभूतिरिति स्थानं भवतोऽभिहितं मया ।\nयत्र भाराभिधः शंभुर्भूत्याख्या भूधरात्मजा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003694031, "chapter_id": 23694, "verse_number": "१-४-२-३२", "content_sanskrit": "अरालकेश्वरं नाम स्थानं ते कथितं मया ।\nयत्र सूक्ष्माभिधः शूली सूक्ष्माख्या शैलनंदिनी ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003694032, "chapter_id": 23694, "verse_number": "१-४-२-३३", "content_sanskrit": "गयानाम महाक्षेत्रं तव प्रस्तावितं मया ।\nमंगलाख्या शिवा यत्र शंकरः प्रपितामहः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003694033, "chapter_id": 23694, "verse_number": "१-४-२-३४", "content_sanskrit": "कुरुक्षेत्रमिति स्थानं भवते विनिवेदितम् ।\nयत्र स्थाणुप्रिया देवी देवः स्थाणुसमाह्वयः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003694034, "chapter_id": 23694, "verse_number": "१-४-२-३५", "content_sanskrit": "उक्तं कनखलंनाम मया ते स्थानमुत्तमम् ।\nउग्रो यत्र पुरारातिरुग्रा गिरिवरात्मजा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003694035, "chapter_id": 23694, "verse_number": "१-४-२-३६", "content_sanskrit": "तालकाख्यं महाक्षेत्रं मार्कंडेय मयोदितम् ।\nदेवी स्वायंभुवी यत्र स्वयंभूः परमेश्वरः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003694036, "chapter_id": 23694, "verse_number": "१-४-२-३७", "content_sanskrit": "अट्टहासमिति प्रोक्तं महास्थानं मया तव ।\nयत्रार्कः पूजयित्वेशमासीत्पूर्णमनोरथः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003694037, "chapter_id": 23694, "verse_number": "१-४-२-३८", "content_sanskrit": "कृत्तिवासाभिधं क्षेत्रमुक्तं ते वेदवित्तम ।\nयः कैलासादपि श्लाघ्यो निवासः कृत्तिवाससः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003694038, "chapter_id": 23694, "verse_number": "१-४-२-३९", "content_sanskrit": "भ्रमरांबिकया देव्या महेशो मल्लिकार्जुनः ।\nश्रीशैले सृष्टिसिद्धयर्थं पूजितः परमेष्ठिना ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003694039, "chapter_id": 23694, "verse_number": "१-४-२-४०", "content_sanskrit": "सुवर्णमुखरीतीरे कालहस्तीति शंकरः ।\nव्यासेनाराधितो भृंगमुखरालकयांबया ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003694040, "chapter_id": 23694, "verse_number": "१-४-२-४१", "content_sanskrit": "कांच्यामेकाम्रमूलस्थः कामाक्ष्या कामशासनः ।\nतपस्यंत्याभिसंश्लिष्टो वलयेनांकितोऽभवत् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003694041, "chapter_id": 23694, "verse_number": "१-४-२-४२", "content_sanskrit": "अस्ति व्याघ्रपुरंनाम तिल्लिकाननमध्यगम् ।\nयत्र नृत्यंतमीशानं पर्युपास्ते पतंजलिः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003694042, "chapter_id": 23694, "verse_number": "१-४-२-४३", "content_sanskrit": "श्वेतारण्यमिति स्थानमुक्तं तव मया पुरा ।\nभग्नमैरावतो दंतं भेजे यत्र शिवार्चनात् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003694043, "chapter_id": 23694, "verse_number": "१-४-२-४४", "content_sanskrit": "सेतुबंधमिति स्थानमवोचं तत्र राघवः ।\nरामनाथाख्यया देवमंहोघ्नं प्रत्यतिष्ठिपत् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003694044, "chapter_id": 23694, "verse_number": "१-४-२-४५", "content_sanskrit": "गतप्रत्याह्वय स्थानं विद्यते वृषभध्वजः ।\nयत्र जंबूतरोर्मूले जगद्रक्षार्थमाश्रितः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003694045, "chapter_id": 23694, "verse_number": "१-४-२-४६", "content_sanskrit": "मणिमुक्तानदीमन्वक्क्षेत्रे वृद्धाचलाह्वये ।\nनित्यं सन्निहितो देव इत्याकर्णित एव ते ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003694046, "chapter_id": 23694, "verse_number": "१-४-२-४७", "content_sanskrit": "श्रीमन्मध्यार्जुनंनाम श्रुतं स्थानमनुत्तमम् ।\nयस्मिन्वरप्रदो नित्यं गौरीसहचरो हरः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003694047, "chapter_id": 23694, "verse_number": "१-४-२-४८", "content_sanskrit": "आस्थितं सोमनाथेन सोमतीर्थं त्वया श्रुतम् ।\nयत्र त्यक्तवतां देहं न भूयो भवबंधनम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003694048, "chapter_id": 23694, "verse_number": "१-४-२-४९", "content_sanskrit": "आकर्णितं हि भवता क्षेत्रं सिद्धवटाह्वयम् ।\nयत्र सिद्धाः समर्चंति ज्योतिर्लिंगमनुत्तमम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003694049, "chapter_id": 23694, "verse_number": "१-४-२-५०", "content_sanskrit": "अश्रावि खलु ते क्षेत्रं कमलालयसंज्ञकम् ।\nवल्मीकेशार्चनाल्लेभे यत्र श्रीर्जीविता हरेः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003694050, "chapter_id": 23694, "verse_number": "१-४-२-५१", "content_sanskrit": "श्रुतवानसि कंकाद्रिं यत्र संनिहितो हरः ।\nइदानीमप्युपासाते मोक्षाय ब्रह्मकेशवौ ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003694051, "chapter_id": 23694, "verse_number": "१-४-२-५२", "content_sanskrit": "श्रीमद्द्रोणपुरं वेत्सि यस्मिन्कलियुगक्षये ।\nनौकामारूढवानब्धौ क्षुभिते पार्वतीपतिः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003694052, "chapter_id": 23694, "verse_number": "१-४-२-५३", "content_sanskrit": "श्रुतं ब्रह्मपुरंनाम क्षेत्रं यत्रेंद्रजित्पुरा ।\nआर्यपुष्करिणीतीरे स्थापयामास धूर्जटिम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003694053, "chapter_id": 23694, "verse_number": "१-४-२-५४", "content_sanskrit": "श्रीकोटिकाख्यं ज्ञानाभिक्षेत्रं यत्रेंदुशेखरः ।\nसमाराधयतां पुंसां पापकोटीर्व्यपोहति ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003694054, "chapter_id": 23694, "verse_number": "१-४-२-५५", "content_sanskrit": "आकर्णितं च गोकर्णं शिवं यत्संनिधानतः ।\nआरिराधयिषुः स्वर्गं जामदग्न्यो न कांक्षति ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003694055, "chapter_id": 23694, "verse_number": "१-४-२-५६", "content_sanskrit": "त्रिपुरांतकमुक्तं ते क्षेत्रं यत्र त्रियंबकः ।\nनिराकरोति निरयाद्भयं दृष्टवतां नृणाम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003694056, "chapter_id": 23694, "verse_number": "१-४-२-५७", "content_sanskrit": "उक्तं कालांजनं क्षेत्रं यद्वासी कालकंधरः ।\nनिर्वापयति भक्तानां घोरसंसारसंज्वरम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003694057, "chapter_id": 23694, "verse_number": "१-४-२-५८", "content_sanskrit": "प्रियालवणमाख्यातं क्षेत्रं यत्रांबिकापतिः ।\nपयोर्थिने पयःसिंधुं विततारोपमन्यवे ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003694058, "chapter_id": 23694, "verse_number": "१-४-२-५९", "content_sanskrit": "क्षेत्रं प्रभासमुक्तं ते यत्र खंडेंदुशेखरः ।\nपूजितः शौरिसीरिभ्यां दत्तवानक्षयं फलम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003694059, "chapter_id": 23694, "verse_number": "१-४-२-६०", "content_sanskrit": "वेदारण्यं विजानीषे यस्मिन्प्रमथनायकः ।\nअभ्यर्थितोऽभून्मोक्षार्थं दक्षेण प्राक्कृतागसा ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003694060, "chapter_id": 23694, "verse_number": "१-४-२-६१", "content_sanskrit": "हेमकूटं त्वमश्रौषीः स्थानं विषमचक्षुषः ।\nपुंसां तपस्यतां यत्र पुनर्जननतो न भीः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003694061, "chapter_id": 23694, "verse_number": "१-४-२-६२", "content_sanskrit": "क्षेत्रं वेणुवनंनाम विद्यते पापनाशनम् ।\nयत्र वंशलतागर्भाज्जातो मुक्तामणिः शिवा ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003694062, "chapter_id": 23694, "verse_number": "१-४-२-६३", "content_sanskrit": "जालंधरमिति स्थानमंधकारेस्त्वया श्रुतम् ।\nलेभे गणपतां तत्र तपस्याभिर्जलंधरः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003694063, "chapter_id": 23694, "verse_number": "१-४-२-६४", "content_sanskrit": "ज्वालामुखमिति स्थानमज्ञासीः कथितं मया ।\nयत्र ज्वालामुखी देवी कालरुद्रमपूजयत् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003694064, "chapter_id": 23694, "verse_number": "१-४-२-६५", "content_sanskrit": "अस्ति भद्रवटोनाम क्षेत्रमुक्तं श्रुतं त्वया ।\nत्र्यंबकं यत्र हेरंबः संपदे पर्यपूजयत् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003694065, "chapter_id": 23694, "verse_number": "१-४-२-६६", "content_sanskrit": "न्यग्रोधारण्यमुक्तं ते यत्रोग्रो निर्ममे किल ।\nउच्चंडतांडवं काल्या साकं संघर्षमेयिवान् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003694066, "chapter_id": 23694, "verse_number": "१-४-२-६७", "content_sanskrit": "गंधमादनसंज्ञं तत्क्षेत्रमाकर्णितं त्वया ।\nआंजनेयेन रचितं यत्र मृत्युंजयार्चनम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003694067, "chapter_id": 23694, "verse_number": "१-४-२-६८", "content_sanskrit": "गोपर्वतमिति स्थानं शंभोः प्रख्यापितं मया ।\nयत्र पाणिनिना लेभे वैयाकरणिकाग्र्यता ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003694068, "chapter_id": 23694, "verse_number": "१-४-२-६९", "content_sanskrit": "वीरकोष्ठमिति क्षेत्रस्थानं नन्ववधारितम् ।\nयत्र प्रचेतसा लेभे तपसा कविमुख्यता ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003694069, "chapter_id": 23694, "verse_number": "१-४-२-७०", "content_sanskrit": "महातीर्थमिति प्रोक्तं जानीषे यत्र शंभुना ।\nअध्यापितास्सुपर्वाणः सर्वेऽपि द्रुहिणादयः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003694070, "chapter_id": 23694, "verse_number": "१-४-२-७१", "content_sanskrit": "मयूरपुरमुक्तं ते क्षेत्रं माहेश्वरं मया ।\nलेभे यत्र व्रतस्थेन ह्रादिनी वज्रपाणिना ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003694071, "chapter_id": 23694, "verse_number": "१-४-२-७२", "content_sanskrit": "श्रीसुंदरमिति क्षेत्रमुक्तं वेगवती तटे ।\nकलावपि युगे यस्मिन्देवदेवेन दीप्यते ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003694072, "chapter_id": 23694, "verse_number": "१-४-२-७३", "content_sanskrit": "कुंभकोणमिति स्थानं शंभोर्वेत्सि हि यत्र सा ।\nगंगापि माघे सान्निध्यं कुरुते स्वाघशांतये ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003694073, "chapter_id": 23694, "verse_number": "१-४-२-७४", "content_sanskrit": "अनुगोदावरीतीरं त्र्यंबकंनाम ते श्रुतम् ।\nशक्तिं यत्र गुहो लेभे तारकासुरघातिनीम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003694074, "chapter_id": 23694, "verse_number": "१-४-२-७५", "content_sanskrit": "श्रीपाटलं व्याघ्रपुरमाख्यातं वेदवित्तम ।\nत्रिशंकुना जातिशुद्ध्यै यत्र गंगाधरोर्चितः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003694075, "chapter_id": 23694, "verse_number": "१-४-२-७६", "content_sanskrit": "क्षेत्रं कदंबपुर्य्याख्यं भवता चावधारितम् ।\nत्वत्कृते यत्र शूलेन कृतांतं शम्भुरक्षिणोत् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003694076, "chapter_id": 23694, "verse_number": "१-४-२-७७", "content_sanskrit": "अविनाशाख्यमुक्तं ते क्षेत्रं यत्र वृषध्वजः ।\nसान्निध्यं पडिकण्ठाय विततार प्रसेदिवान् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003694077, "chapter_id": 23694, "verse_number": "१-४-२-७८", "content_sanskrit": "रक्तैकाननमाख्यातं मया क्षेत्रं तवानघ ।\nमित्रावरुणयोर्यत्र रुद्रोऽजनि वरप्रदः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003694078, "chapter_id": 23694, "verse_number": "१-४-२-७९", "content_sanskrit": "श्रीहाटकेश्वरं क्षेत्रं पातालस्थं त्वया श्रुतम् ।\nयत्र वैरोचनिर्देवं स्वपदप्राप्तयेर्चति ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003694079, "chapter_id": 23694, "verse_number": "१-४-२-८०", "content_sanskrit": "वेत्सि शंभोः प्रियावासं कैलासं नित्यसेवकः ।\nयत्र यक्षेश्वरस्त्र्यक्षमयर्चयति भक्तितः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003694080, "chapter_id": 23694, "verse_number": "१-४-२-८१", "content_sanskrit": "स्थानानि खंडपरशोरित्युक्तानि मया पुरा ।\nत्वयाप्यवधृतान्येव किं भूयः श्रोतुमिच्छसि ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003694081, "chapter_id": 23694, "verse_number": "१-४-२-८२", "content_sanskrit": "इत्यूचिवानेष शिलादनंदनो मुनेर्मृकण्डोस्तनयं मुनीश्वरम् ।\nभक्त्या नमंतं पदयोः करेण पस्पर्श मौलौ करुणारसार्द्रः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003694082, "chapter_id": 23694, "verse_number": "१-४-२-८३", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां प्रथमे माहेश्वरखण्डेऽरुणाचलमाहात्म्य उत्तरार्धे महीमण्डलस्थविविधशिवक्षेत्रवर्णनंनाम द्वितीयोऽध्यायः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}]