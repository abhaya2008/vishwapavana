[{"id": 2128598, "chapter_id": 3760, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2128599, "chapter_id": 3760, "verse_number": "१", "content_sanskrit": "एतच्छ्रुत्वाऽन्तरिक्षाद्वै स राजा राजसत्तमः ।\nयथोक्तं तच्चकाराथ श्रद्दधद् भरतर्षभ\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2128600, "chapter_id": 3760, "verse_number": "२", "content_sanskrit": "षष्टिः पुत्रसहस्राणि तस्याप्रतिमतेजसः ।\nरुद्रप्रसादाद्राजर्षेः समजायन्त पार्थिव\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2128601, "chapter_id": 3760, "verse_number": "३", "content_sanskrit": "ते घोराः क्रूरकर्माण आकाशे परिसर्पिणः ।\nबहुत्वाच्चावजानन्तः सर्वाल्लँोकान् सहामरान्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2128602, "chapter_id": 3760, "verse_number": "४", "content_sanskrit": "त्रिदशांश्चाप्यबाधन्त तथा गन्धर्वराक्षसान् ।\nसर्वाणि चैव भूतानि शूराः समरशालिनः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2128603, "chapter_id": 3760, "verse_number": "५", "content_sanskrit": "वध्यमानास्तदा लोकाः सागरैर्मन्दबुद्धिभिः ।\nब्रह्माणं शरणं जग्मुः सहिताः सर्वदैवतैः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2128604, "chapter_id": 3760, "verse_number": "६", "content_sanskrit": "तानुवाच महाभागः सर्वलोकपितामहः ।\nगच्छध्वं त्रिदशाः सर्वे लोकैः सार्धं यथागतम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2128605, "chapter_id": 3760, "verse_number": "७", "content_sanskrit": "नातिदीर्घेण कालेन सागराणां क्षयो महान् ।\nभविष्यति महाघोरः स्वकृतैः कर्मभिः सुराः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2128606, "chapter_id": 3760, "verse_number": "८", "content_sanskrit": "एवमुक्तास्तु ते देवा लोकाश्च मनुजोत्तम ।\nपितामहमनुज्ञाप्य विप्रजग्मुर्यथागतम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2128607, "chapter_id": 3760, "verse_number": "९", "content_sanskrit": "ततः काले बहुतिथे व्यतीते मनुजेश्वर ।\nदीक्षितः सगरो राजा हयमेधेन वीर्यवान् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2128608, "chapter_id": 3760, "verse_number": "१०", "content_sanskrit": "तस्याश्वो व्यचरद् भूमिं पुत्रैः सुपरिरक्षितः ।\nसर्वैरेव महोत्साहैः स्वच्छन्दप्रचरो नृप\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2128609, "chapter_id": 3760, "verse_number": "११", "content_sanskrit": "समुद्रं स समासाद्य निस्तोयं भीमदर्शनम् ।\nरक्ष्यमाणः प्रयत्नेन तत्रैवान्तरधीयत \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2128610, "chapter_id": 3760, "verse_number": "१२", "content_sanskrit": "ततस्ते सागरास्तात हृतं ज्ञात्वा हयोत्तमम् ।\nआगम्य पितुराचख्युरदृश्यं तुरगोत्तमम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2128611, "chapter_id": 3760, "verse_number": "१३", "content_sanskrit": "तेनोक्ता दिक्षु सर्वासु पुत्रा मार्गत वाजिनम् ।\nससमुद्रवनद्वीपां विचिन्वन्तो वसुन्धराम् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2128612, "chapter_id": 3760, "verse_number": "१४", "content_sanskrit": "ततस्ते पितुराज्ञाय दिक्षु सर्वासु तं हयम् ।\nअमार्गन्त महाराज संचेरुः पृथिवीतळम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2128613, "chapter_id": 3760, "verse_number": "१५", "content_sanskrit": "ततस्ते सागराः सर्वे समासाद्य परस्परम् ।\nनाध्यगच्छन्त तुरगमश्वहर्तारमेव च \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2128614, "chapter_id": 3760, "verse_number": "१६", "content_sanskrit": "आगम्य पितरं चोचुः ततः प्राञ्जलयोऽग्रतः ।\nस्थिताः सर्वे महीपाल सागराः सहितास्तदा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2128615, "chapter_id": 3760, "verse_number": "१७", "content_sanskrit": "ससमुद्रवनद्वीपा सनदीनदकन्दरा ।\nसपर्वतवनोद्देशा निखिलेन मही नृप \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2128616, "chapter_id": 3760, "verse_number": "१८", "content_sanskrit": "अस्माभिर्विचिता राजन् शासनात् तव पार्थिव ।\nन चाश्वमधिगच्छामो नाश्वहर्तारमेव वा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2128617, "chapter_id": 3760, "verse_number": "१९", "content_sanskrit": "श्रुत्वा तु वचनं तेषां स राजा क्रोधमूर्च्छितः ।\nउवाच वचनं सर्वान् तदा दैववशान्नृप \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2128618, "chapter_id": 3760, "verse_number": "२०", "content_sanskrit": "अनागमाय गच्छध्वं भूयो मार्गत वाजिनम् ।\nयाज्ञियं तं विना ह्यश्वं नागन्तव्यं हि पुत्रकाः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2128619, "chapter_id": 3760, "verse_number": "२१", "content_sanskrit": "प्रतिगृह्य तु सन्देशं पितुस्ते सगरात्मजाः ।\nभूय एव महीं कृत्स्नां विचेतुमुपचक्रमुः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2128620, "chapter_id": 3760, "verse_number": "२२", "content_sanskrit": "अथापश्यन्त ते वीराः पृथिवीं तु विदारिताम् ।\nसमुद्रे पृथिवीपाल पदमार्गं च वाजिनः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2128621, "chapter_id": 3760, "verse_number": "२३", "content_sanskrit": "समासाद्य बिलं तच्चाप्यखनन् सगरात्मजाः ।\nकुद्दालैर्मुसलैश्चैव समुद्रं यत्नमास्थिताः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2128622, "chapter_id": 3760, "verse_number": "२४", "content_sanskrit": "स खन्यमानः सहितैः सागरैर्वरुणालयः ।\nअगच्छत् परमामार्तिं दार्यमाणः समन्ततः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2128623, "chapter_id": 3760, "verse_number": "२५", "content_sanskrit": "असुरोरगरक्षांसि सत्त्वानि विविधानि च ।\nआर्तनादमकुर्वन्त वध्यमानानि सागरैः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2128624, "chapter_id": 3760, "verse_number": "२६", "content_sanskrit": "भिन्नशीर्षा विदेहाश्च भिन्नजान्वस्थिमस्तकाः ।\nप्राणिनः समदृश्यन्त शतशोऽथ सहस्रशः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2128625, "chapter_id": 3760, "verse_number": "२७", "content_sanskrit": "एवं तु खनतां तेषां समुद्रं मकरालयम् ।\nव्यतीतः सुमहान् कालो न चाश्वः समदृश्यत\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2128626, "chapter_id": 3760, "verse_number": "२८", "content_sanskrit": "ततः पूर्वोत्तरे देशे समुद्रस्य विशाम्पते ।\nविदार्य पाताळमुखं सङ्क्रुद्धाः सगरात्मजाः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2128627, "chapter_id": 3760, "verse_number": "२९", "content_sanskrit": "अपश्यन्त हयं तत्र विचरन्तं महीतळे ।\nकपिलं च महात्मानं तेजोराशिमनुत्तमम् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2128628, "chapter_id": 3760, "verse_number": "३०", "content_sanskrit": "तेजसा दीप्यमानं तं ज्वालाभिरिव पावकम् ।\nदृष्ट्वा हि हृषिताः सर्वे बभूवुः सगरात्मजाः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2128629, "chapter_id": 3760, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nवनपर्वणि द्व्यधिकशततमोऽध्यायः ॥१०२॥\n॥ तीर्थयात्रापर्वणि अष्टपञ्चाशोऽध्यायः ॥५८॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]