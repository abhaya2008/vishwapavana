[{"id": 2022136, "chapter_id": 1461, "verse_number": "३-९९-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2022137, "chapter_id": 1461, "verse_number": "३-९९-१", "content_sanskrit": "भूय एवाहमिच्छामि महर्षेस्तस्य धीमतः।\nकर्मणां विस्तरं श्रोतुमगस्त्यस्य द्विजात्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2022138, "chapter_id": 1461, "verse_number": "३-९९-२x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2022139, "chapter_id": 1461, "verse_number": "३-९९-२", "content_sanskrit": "शृणु राजन्कथां दिव्यामद्भुतामतिमानुषीम्।\nअगस्त्यस्य महाराज प्रभावममितौजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2022140, "chapter_id": 1461, "verse_number": "३-९९-३", "content_sanskrit": "आसन्कृतयुगे घोरा दानवा युद्धदुर्मदाः।\nकालकेया इतिख्याता गणाः परमदारुणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2022141, "chapter_id": 1461, "verse_number": "३-९९-४", "content_sanskrit": "ते तु वृत्रं समाश्रित्य नानाप्रहरणोद्यताः।\nसमन्तात्पर्यधावन्त महेन्द्रप्रमुखान्सुरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2022142, "chapter_id": 1461, "verse_number": "३-९९-५", "content_sanskrit": "ततो वृत्रवधे यत्नमकुर्वंस्त्रिदशाः पुरा।\nपुरंदरं पुरस्कृत्य ब्रह्माणमुपतस्थिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2022143, "chapter_id": 1461, "verse_number": "३-९९-६", "content_sanskrit": "कृताञ्जलींस्तु तान्सर्वान्परमेष्ठीत्युवाच ह।\nविदितं मे सुराः सर्वं यद्वः कार्यं चिकीर्षितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2022144, "chapter_id": 1461, "verse_number": "३-९९-७", "content_sanskrit": "तमुपायं प्रवक्ष्यामि यथा वृत्रं वधिष्यथ।\nदधीच इतिविख्यातो महानृषिरुदारधीः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2022145, "chapter_id": 1461, "verse_number": "३-९९-८", "content_sanskrit": "तं गत्वा सहिताः सर्वेवरं वै संप्रयाचत।\nस वो दास्यति धर्मात्मा सुप्रीतेनान्तरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2022146, "chapter_id": 1461, "verse_number": "३-९९-९", "content_sanskrit": "स वाच्यः सहितैः सर्वैर्भवद्भिर्जयकाङ्क्षिभिः।\nस्वान्यस्थीनि प्रयच्छेति त्रैलोक्यस् हिताय वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2022147, "chapter_id": 1461, "verse_number": "३-९९-१०", "content_sanskrit": "स शरीरं समुत्सृज्य स्वान्यस्थीनि प्रदास्यति।\nतस्यास्थिभिर्महाघोरं वज्रं संस्क्रियतां दृढम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2022148, "chapter_id": 1461, "verse_number": "३-९९-११", "content_sanskrit": "महच्छत्रुहणं घोरं ष़डश्चं भीमनिःस्वनम्।\nतेन वज्रेण वै वृत्रं वधिष्यति शतक्रतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2022149, "chapter_id": 1461, "verse_number": "३-९९-१२", "content_sanskrit": "एतद्वः सर्वमाख्यातं तस्माच्छीघ्रं विधीयताम्।\nएवमुक्तास्ततो देवा अनुज्ञाप्य पितामहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2022150, "chapter_id": 1461, "verse_number": "३-९९-१३", "content_sanskrit": "नारायणं पुरस्कृत्य दधीचस्याश्रमं ययुः।\nसरस्वत्याः परे पारे नानाद्रुमलतावृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2022151, "chapter_id": 1461, "verse_number": "३-९९-१४", "content_sanskrit": "षट्पदोद्गीतनिनदैर्विघुष्टं सामगैरिव।\nपुंस्कोकिलरवोन्मिश्रं जीवंजीवकनादितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2022152, "chapter_id": 1461, "verse_number": "३-९९-१५", "content_sanskrit": "महिषैश्च वराहैश्च सृमरैश्चमरैरपि।\nतत्र तत्रानुचरितं शार्दूलभयवर्जितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2022153, "chapter_id": 1461, "verse_number": "३-९९-१६", "content_sanskrit": "करेणुभिर्वारणैश्च प्रभिन्नकरटामुखैः।\nसरोवगाढैः क्रीडद्भिः समन्तादनुनादितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2022154, "chapter_id": 1461, "verse_number": "३-९९-१७", "content_sanskrit": "सिंहव्याघ्रैर्महानादान्नदद्भिरनुनादितम्।\nअपरैश्चापि संलीनैर्गुहाकन्दरशायिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2022155, "chapter_id": 1461, "verse_number": "३-९९-१८", "content_sanskrit": "तेषु तेष्ववकाशेषु शोभितं सुमनोरमम्।\nत्रिविष्टपसमप्रख्यं दधीचाश्रममागमन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2022156, "chapter_id": 1461, "verse_number": "३-९९-१९", "content_sanskrit": "तत्रापश्यन्दधीचं ते दिवाकरसमद्युतिम्।\nजाज्वल्यमानं वपुषा यथा साक्षात्पितामहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2022157, "chapter_id": 1461, "verse_number": "३-९९-२०", "content_sanskrit": "तस्य पादौ सुरा राजन्नभिवाद्य प्रणम्य च।\nअयाचन्त वरं सर्वे यथोक्तं परमेष्ठिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2022158, "chapter_id": 1461, "verse_number": "३-९९-२१", "content_sanskrit": "ततो दधीचः परमप्रतीतः\nसुरोत्तमांस्तानिदमभ्युवाच।\nकरोमि यद्वो हितमद्य देवाः\nस्वं चापि देहंस्वयमुत्सृजामि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2022159, "chapter_id": 1461, "verse_number": "३-९९-२२", "content_sanskrit": "स एवमुक्त्वा द्विपदांवरिष्ठः\nप्राणान्वशी स्वान्सहसोत्ससर्ज।\nततः सुरास्ते जगृहुः परासो-\nरस्थीनि तस्याथ यथोपदेशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2022160, "chapter_id": 1461, "verse_number": "३-९९-२३", "content_sanskrit": "प्रहृष्टरूपाश्च जयाय देवा-\nस्त्वष्टारमागम् तमर्थमूचुः।\nत्वष्टा तु तेषां वचनं निशम्य\nप्रहृष्टरूपः प्रयतः प्रयत्नात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2022161, "chapter_id": 1461, "verse_number": "३-९९-२४", "content_sanskrit": "चकार वज्रं भृशमुग्ररूपं\nकृत्वा च शक्रं स उवाच हृष्टः।\nअनेन वज्रप्रवरेण देव\nभस्मीकुरुष्वाद्य सुरारिमुग्रम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2022162, "chapter_id": 1461, "verse_number": "३-९९-२५", "content_sanskrit": "ततो हतारिः सगणः सुखं वै\nप्रशाधिकृत्स्नं त्रिदिवं दिविष्ठः।\nत्वष्ट्रा तथोक्तस्तु पुरंदरस्त-\nद्वज्रं प्रहृष्टः प्रयतो ह्यगृह्नात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2022163, "chapter_id": 1461, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि एकोनशततमोऽध्यायः ॥ ९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]