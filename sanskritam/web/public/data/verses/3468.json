[{"id": 2114793, "chapter_id": 3468, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2114794, "chapter_id": 3468, "verse_number": "१", "content_sanskrit": "विदुरस्य सुहृत् कश्चित् खनकः कुशलः क्कचित् ।\nविविक्ते पाण्डवान् राजन्निदं वचनमब्रवीत् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2114795, "chapter_id": 3468, "verse_number": "२", "content_sanskrit": "प्रहितो विदुरेणास्मि खनकः कुशलो भृशम् ।\nपाण्डवानां प्रियं कार्यमिति किं करवाणि वः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2114796, "chapter_id": 3468, "verse_number": "३", "content_sanskrit": "प्रच्छन्नं विदुरेणोक्तः श्रेयस्कामोऽस्मि पाण्डवान् ।\nप्रतिपादय विश्वासादिति किं करवाणि वः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2114797, "chapter_id": 3468, "verse_number": "४", "content_sanskrit": "किञ्च त्वं विदुरेणोक्तो म्लेच्छवाचाऽसि पाण्डव ।\nत्वया च तत् तथेत्युक्तमेतदाश्वासकारणम् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2114798, "chapter_id": 3468, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2114799, "chapter_id": 3468, "verse_number": "५", "content_sanskrit": "उवाच तं सत्यधृतिः कुन्तीपुत्रो युधिष्ठिरः ।\nअभिजानामि सौम्य त्वां सुहृदं विदुरस्य वै\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2114800, "chapter_id": 3468, "verse_number": "६", "content_sanskrit": "प्रथमाप्तं प्रियं भक्तं सदा प्रियहितैषिणम् ।\nन विद्यते कवेः किञ्चिदविज्ञातं प्रयोजनम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2114801, "chapter_id": 3468, "verse_number": "७", "content_sanskrit": "यथा कविस्तथा नस्त्वं निर्विशेषा वयं त्वयि ।\nभवितास्मो यथा तस्य पालयास्मान् यथा कविः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2114802, "chapter_id": 3468, "verse_number": "८", "content_sanskrit": "इदं शरणमाग्नेयं मदर्थमिति मे मतिः ।\nपुरोचनेन विहितं धार्तराष्ट्रस्य शासनात् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2114803, "chapter_id": 3468, "verse_number": "९", "content_sanskrit": "स पापः कोशवांश्चैव ससहायश्च दुर्मतिः ।\nअस्मानपि च दुष्टात्मा नित्यकालं प्रबाधते \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2114804, "chapter_id": 3468, "verse_number": "१०", "content_sanskrit": "स भवान् मोक्षयत्वस्मानुत्पन्नाद् वै हुताशनात् ।\nअस्मास्विह च दग्धेषु सकामः स्यात् सुयोधनः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2114805, "chapter_id": 3468, "verse_number": "११", "content_sanskrit": "समृद्धमायुधागारमिदं तस्य दुरात्मनः ।\nप्रवातं निष्प्रतीकारमाश्रित्येह कृतं महत् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2114806, "chapter_id": 3468, "verse_number": "१२", "content_sanskrit": "इदं तदशुभं नूनं तस्य कर्म चिकीर्षितम् ।\nप्रागेव विदुरो वेद तेनास्मान् पूर्वमुक्तवान् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2114807, "chapter_id": 3468, "verse_number": "१३", "content_sanskrit": "सेयमापदनुप्राप्रा क्षत्ता यां दृष्टवान् पुरा ।\nपुरोचनस्याविदितमस्मांस्त्वं विप्रमोचय \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2114808, "chapter_id": 3468, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2114809, "chapter_id": 3468, "verse_number": "१४", "content_sanskrit": "स तथेति प्रतिश्रुत्य खनको यत्नमास्थितः ।\nपरिखामुत्किरन् नाम चकार सुमहाबिलम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2114810, "chapter_id": 3468, "verse_number": "१५", "content_sanskrit": "चक्रे स वेश्मनस्तस्य मध्ये नातिमहन्मुखम् ।\nकवाटयुक्तमज्ञातं समं भूम्याश्च भारत \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2114811, "chapter_id": 3468, "verse_number": "१५", "content_sanskrit": "पुरोचनभयाच्चैव व्यदधात् संवृतं मुखम् ।\nस च तस्मिन् गृहद्वारि वसत्यशुभधीः सदा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2114812, "chapter_id": 3468, "verse_number": "१६", "content_sanskrit": "ततस्ते सायुधाः सर्वे वसन्ति स्म क्षपां नृप ।\nदिवा चरन्ति मृगयां पाण्डवेया वनाद् वनम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2114813, "chapter_id": 3468, "verse_number": "१७", "content_sanskrit": "विश्वस्तवदविश्वस्ता वञ्चयन्तः पुरोचनम् ।\nअतुष्टास्तुष्टवद् राजन्नूषुः परमदुःखिताः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2114814, "chapter_id": 3468, "verse_number": "१८", "content_sanskrit": "न चैनानन्वबुध्यन्त नरा नगरवासिनः ।\nअन्यत्र विदुरामात्यात् तस्मात् खनकसत्तमात् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2114815, "chapter_id": 3468, "verse_number": "१४७", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nसप्तचत्वारिंशत्यधिकशततमोऽध्यायः ॥१४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2114816, "chapter_id": 3468, "verse_number": "५", "content_sanskrit": "॥ इति जतुगृहदाहपर्वणि पञ्चमोऽध्यायः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2114817, "chapter_id": 3468, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]