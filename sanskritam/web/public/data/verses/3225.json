[{"id": 2102736, "chapter_id": 3225, "verse_number": "१४-८१-१", "content_sanskrit": "वैशम्पायन उवाच।\nप्रायोपविष्टे नृपतौ मणलूरेश्वरे तदा।\nपितृशोकसमाविष्टे सह मात्रा परंतप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2102737, "chapter_id": 3225, "verse_number": "१४-८१-२", "content_sanskrit": "उलूपी चिन्तयामास तदा संजीवनं मणिम्।\nस चोपातिष्ठत तदा पन्नगानां परायणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2102738, "chapter_id": 3225, "verse_number": "१४-८१-३", "content_sanskrit": "तं गृहीत्वा तु कौरव्य नागराजपतेः सुता।\nमनःप्रह्लादनीं वाचं सैनिकानामथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2102739, "chapter_id": 3225, "verse_number": "१४-८१-४", "content_sanskrit": "उत्तिष्ठ मा शुचः पुत्र नैव जिष्णुस्त्वया हतः।\nअजेयः पुरुषैरेष तथा देवैः सवासवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2102740, "chapter_id": 3225, "verse_number": "१४-८१-५", "content_sanskrit": "मया तु मोहनी नाम मायैषा सम्प्रदर्शिता।\nप्रियार्थं पुरुषेन्द्रस्य पितुस्तेऽद्य यशस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2102741, "chapter_id": 3225, "verse_number": "१४-८१-६", "content_sanskrit": "जिज्ञासुर्ह्येष पुत्रस्य बलस्य तव कौरव।\nसङ्ग्रामे युद्ध्यतो राजन्नागतः परवीरहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2102742, "chapter_id": 3225, "verse_number": "१४-८१-७", "content_sanskrit": "तस्मादसि मया पुत्र युद्धाय परिचोदितः।\nमा पापमात्मनः पुत्र शङ्केथा ह्यण्वपि प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2102743, "chapter_id": 3225, "verse_number": "१४-८१-८", "content_sanskrit": "ऋषिरेष महानात्मा पुराणः शाश्वतोऽक्षरः।\nनैनं शक्तो हि सङ्ग्रामे जेतुं शक्रोऽपि पुत्रक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2102744, "chapter_id": 3225, "verse_number": "१४-८१-९", "content_sanskrit": "अयं तु मे मणिर्दिव्यः समानीतो विशांपते।\nमृतान्मृतान्पन्नगेन्द्रान्यो जीवयति नित्यदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2102745, "chapter_id": 3225, "verse_number": "१४-८१-१०", "content_sanskrit": "एनमस्योरसि त्वं च स्थापयस्व पितुः प्रभो।\nसंजीवितं तदा पार्थं स त्वं द्रष्टासि पाण्डवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2102746, "chapter_id": 3225, "verse_number": "१४-८१-११", "content_sanskrit": "इत्युक्तः स्थापयामास तस्योरसि मणिं तदा।\nपार्थस्यामिततेजाः स पितुः स्नेहादपापकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2102747, "chapter_id": 3225, "verse_number": "१४-८१-१२", "content_sanskrit": "तस्मिन्न्यस्ते मणौ वीरो जिष्णुरुज्जीवितः प्रभुः।\nचिरसुप्त हवोत्तस्थौ मृष्टलोहितलोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2102748, "chapter_id": 3225, "verse_number": "१४-८१-१३", "content_sanskrit": "तमुत्थितं महात्मानं लब्धसंज्ञं मनस्विनम्।\nसमीक्ष्य पितरं स्वस्थं ववन्दे बभ्रुवाहनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2102749, "chapter_id": 3225, "verse_number": "१४-८१-१४", "content_sanskrit": "उत्थिते पुरुषव्याघ्रे पुनर्लक्ष्मीवति प्रभो।\nदिव्याः सुमनसः पुण्या ववृषे पाकशासनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2102750, "chapter_id": 3225, "verse_number": "१४-८१-१५", "content_sanskrit": "अनाहता दुन्दुभयो विनेदुर्मघनिःस्वनाः।\nसाधुसाध्विति चाकाशे बभूव सुमहान्स्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2102751, "chapter_id": 3225, "verse_number": "१४-८१-१६", "content_sanskrit": "उत्थाय च महाबाहुः पर्याश्वस्तो धनंजयः॥\nबभ्रुवाहनमालिङ्ग्य समाजिघ्रत मूर्धनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2102752, "chapter_id": 3225, "verse_number": "१४-८१-१७", "content_sanskrit": "ददर्श चापि दूरेऽस्य मातरं शोककर्शिताम्।\nउलूप्या सह तिष्ठन्तीं ततोऽपृच्छद्धनंजयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2102753, "chapter_id": 3225, "verse_number": "१४-८१-१८", "content_sanskrit": "किमिदं लक्ष्यते सर्वं शोकविस्मयहर्षवत्।\nरणाजिरममित्रघ्न यदि जानासि शंस मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2102754, "chapter_id": 3225, "verse_number": "१४-८१-१९", "content_sanskrit": "जननी च किमर्थं ते रणभूमिमुपागता।\nनागेन्द्रदुहिता चेयमुलूपी किमिहागता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2102755, "chapter_id": 3225, "verse_number": "१४-८१-२०", "content_sanskrit": "जानाम्यहमिदं युद्धं त्वया मद्वचनात्कृतम्।\nस्त्रीणामागमने हेतुमहमिच्छामि वेदितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2102756, "chapter_id": 3225, "verse_number": "१४-८१-२१", "content_sanskrit": "तमुवाच तथा पृष्टो मणलूरपतिस्तदा।\nप्रसाद्य शिरसा विद्वानुलूपी पृच्छ्यतामिति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2102757, "chapter_id": 3225, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि एकाशीतितमोऽध्यायः॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]