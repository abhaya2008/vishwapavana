[{"id": 2018592, "chapter_id": 1389, "verse_number": "३-२७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2018593, "chapter_id": 1389, "verse_number": "३-२७-१", "content_sanskrit": "ततो वनगताः पार्थाः सायाह्ने सह कृष्णया।\nउपविष्टाः कथाश्चक्रुर्दुःखशोकपरायणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2018594, "chapter_id": 1389, "verse_number": "३-२७-२", "content_sanskrit": "प्रिया च दर्शनीया च पण्डिता च पतिव्रता।\nअथ कृष्णा धर्मराजमिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2018595, "chapter_id": 1389, "verse_number": "३-२७-३x", "content_sanskrit": "द्रौपद्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2018596, "chapter_id": 1389, "verse_number": "३-२७-३", "content_sanskrit": "न नूनं तस्य पापस्य दुःखमस्मासु किंचन।\nविद्यते धार्तराष्ट्रस्य नृशंसस्य दुरात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2018597, "chapter_id": 1389, "verse_number": "३-२७-४", "content_sanskrit": "यस्त्वां राजन्मया सार्धमजिनैः प्रतिवासितम्।\nवनं प्रस्थाप्य दुष्टात्मा नान्वतप्यत दुर्मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2018598, "chapter_id": 1389, "verse_number": "३-२७-५", "content_sanskrit": "आयसं हृदयं नूनं तस्य दुष्कृतकर्मणः।\nयस्त्वां धर्मपरं श्रेष्ठं रूक्षाण्यश्रावयत्तदा।\n`वचनान्यपरोक्षाणि दुर्वाच्यानि च संसदि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2018599, "chapter_id": 1389, "verse_number": "३-२७-६", "content_sanskrit": "सुखोचितमदुःखार्हं दुरात्मा ससुहृद्गणः।\nईदृशं दुःखमानीय मोदते पापपूरुषः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2018600, "chapter_id": 1389, "verse_number": "३-२७-७", "content_sanskrit": "चतुर्णामेव पापानामस्रं न पतितं तदा।\nत्वयि भारत निष्क्रान्ते वनायाजिनवाससि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2018601, "chapter_id": 1389, "verse_number": "३-२७-८", "content_sanskrit": "दुर्योधनस्य कर्णस्य शकुनेश्च दुरात्मनः।\nदुर्भ्रातुस्तस्य चोग्रस्य राजन्दुःखशासनस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2018602, "chapter_id": 1389, "verse_number": "३-२७-९", "content_sanskrit": "इतरेषां तु सर्वेषां कुरूणां कुरुसत्तम।\nदुःखेनाभिपरीतानां नेत्रेभ्यः प्रापतज्जलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2018603, "chapter_id": 1389, "verse_number": "३-२७-१०", "content_sanskrit": "इदं च शयनं दृष्ट्वा यच्चासीत्ते पुरातनम्।\nशोचामित्वां महाराजदुःखानर्हंसुखोचितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2018604, "chapter_id": 1389, "verse_number": "३-२७-११", "content_sanskrit": "दान्तं यच्च सभामध्य आसनं रत्नभूषितम्।\nदृष्ट्वा कुशबृशीं चेमां शोको मां दारयत्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2018605, "chapter_id": 1389, "verse_number": "३-२७-१२", "content_sanskrit": "यदपश्यं सभायां त्वां राजभिः परिवारितम्।\nतच्च राजन्नपश्यन्त्याः का सान्तिर्हृदयस्यमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2018606, "chapter_id": 1389, "verse_number": "३-२७-१३", "content_sanskrit": "या त्वाऽह्रं चन्दनादिग्धमपश्यं सूर्यवर्चसम्।\nसा त्वां पङ्कमलादिग्धं दृष्ट्वा मुह्यामि भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2018607, "chapter_id": 1389, "verse_number": "३-२७-१४", "content_sanskrit": "या त्वाऽहं कौशिकैर्वस्त्रैः शुभ्रैराच्छादितं पुरा।\nदृष्टवत्यस्मिराजेनद्र साऽद्य पश्यामि चीरिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2018608, "chapter_id": 1389, "verse_number": "३-२७-१५", "content_sanskrit": "यच्च तद्रुक्मपात्रीभिर्ब्राह्मणेभ्यः सहस्रशः।\nह्रियते ते गृहादन्नं संस्कृतंसार्वकामिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2018609, "chapter_id": 1389, "verse_number": "३-२७-१६", "content_sanskrit": "यतीनामगृहाणां ते तथैव गृहमेधिनाम्।\nदीयते भोजनं राजन्नतीव गुणवत्प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2018610, "chapter_id": 1389, "verse_number": "३-२७-१७", "content_sanskrit": "सत्कृतानि सहस्राणि सर्वकामैः पुरा गृहे।\nसर्वकामैः सुविहितैर्यदपूजयथा द्विजान्।\nतच्च राजन्नपश्यन्त्याः का शान्तिर्हृदयस्य मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2018611, "chapter_id": 1389, "verse_number": "३-२७-१८", "content_sanskrit": "यत्ते भ्रातॄन्महाराज युवानो मृष्टकुण्डलाः।\nअभोजयन्त मृष्टान्नैः सूदाः परमसंस्कृतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2018612, "chapter_id": 1389, "verse_number": "३-२७-१९", "content_sanskrit": "सर्वांस्तानद्य पश्यामि वने वन्येन जीविनः।\nअदुःखार्हान्मनुष्येन्द्र नोपशाम्यति मे मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2018613, "chapter_id": 1389, "verse_number": "३-२७-२०", "content_sanskrit": "भीमसेनमिमं चापि दुःखितं वनवासिनम्।\nध्यायतः किं न मन्युस्ते प्राप्ते काले विवर्धते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2018614, "chapter_id": 1389, "verse_number": "३-२७-२१", "content_sanskrit": "भीमसेनं हि कर्माणि स्वयं कुर्वाणमच्युतम्।\nसुखार्हं दुःखितं दृष्ट्वा कस्माद्राजन्नुपेक्षसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2018615, "chapter_id": 1389, "verse_number": "३-२७-२२", "content_sanskrit": "सत्कृतं विविधैर्यानैर्वस्त्रैरुच्चावचैस्तथा।\nतं ते वनगतं दृष्ट्वा कस्मान्मन्युर्न वर्धते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2018616, "chapter_id": 1389, "verse_number": "३-२७-२३", "content_sanskrit": "अयं कुरून्रणे सर्वान्हन्तुमुत्सहते प्रभुः।\nत्वत्प्रतिज्ञां प्रतीक्षंस्तु सहतेऽयं वृकोदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2018617, "chapter_id": 1389, "verse_number": "३-२७-२४", "content_sanskrit": "योऽर्जुनेनार्जुनस्तुल्यो द्विबाहुर्बहुबाहुना।\nशरातिसर्गे शीघ्रत्वात्कालान्तकयमोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2018618, "chapter_id": 1389, "verse_number": "३-२७-२५", "content_sanskrit": "यस् शस्त्रप्रतापेन प्रणताः सर्वपार्थिवाः।\nयज्ञे तव महाराज ब्राह्मणानुपतस्थिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2018619, "chapter_id": 1389, "verse_number": "३-२७-२६", "content_sanskrit": "तमिमं पुरुषव्याघ्रं पूजितं देवदानवैः।\nध्यायन्तमर्जुनं दृष्ट्वा कस्माद्राजन्न कुप्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2018620, "chapter_id": 1389, "verse_number": "३-२७-२७", "content_sanskrit": "दृष्ट्वा वनगतं पार्थमदुःखार्हं सुखोचितम्।\nन च तेवर्धते मन्युस्तेन मुह्यामि भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2018621, "chapter_id": 1389, "verse_number": "३-२७-२८", "content_sanskrit": "यो देवांश्च मनुष्यांश्च सर्पांश्चैकरथोऽजयत्।\nतं ते वनगतं दृष्ट्वा कस्मान्मन्युर्न वर्धते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2018622, "chapter_id": 1389, "verse_number": "३-२७-२९", "content_sanskrit": "यो यानैरद्भुताकारैर्हयैर्नागैश्च संवृतः।\nप्रसह्य वित्तान्यादत्त पार्थिवेभ्यः परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2018623, "chapter_id": 1389, "verse_number": "३-२७-३०", "content_sanskrit": "क्षिपत्येकेन वेगेन पञ्चबाणशतानि यः।\nतं ते वनगतं दृष्ट्वा कस्मान्मन्युर्न वर्धते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2018624, "chapter_id": 1389, "verse_number": "३-२७-३१", "content_sanskrit": "श्यामं बृहन्तं तरुणं चर्मिणामुत्तमं रणे।\nनकुलं ते वने दृष्ट्वा कस्मान्मन्युर्न वर्धते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2018625, "chapter_id": 1389, "verse_number": "३-२७-३२", "content_sanskrit": "दर्शनीयं च शूरं च माद्रीपुत्रं युधिष्ठिर। ३-२७-३२bसहदेवं वने दृष्ट्वा कस्मात्क्षमसि पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2018626, "chapter_id": 1389, "verse_number": "३-२७-३३", "content_sanskrit": "नकुलं सहदेवं च दृष्ट्वा ते दुःखितावुभौ।\nअदुःखार्हौ मनुष्येन्द्र कस्मान्मन्युर्न वर्धते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2018627, "chapter_id": 1389, "verse_number": "३-२७-३४", "content_sanskrit": "द्रुपदस्य कुले जातां स्नुषां पाण्डोर्महात्मनः।\nधृष्टद्युम्नस्य भगिनीं वीरपत्नीमनुव्रताम्।\nमां वै वनगतां दृष्ट्वा कस्मात्क्षमसि पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2018628, "chapter_id": 1389, "verse_number": "३-२७-३५", "content_sanskrit": "नूनं च तव नैवास्ति मन्युर्भरतसत्तम।\nयत्ते भ्रातॄंश्च मां चैव दृष्ट्वा नव्यथते मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2018629, "chapter_id": 1389, "verse_number": "३-२७-३६", "content_sanskrit": "न निर्मन्युःक्षत्रियोऽस्ति लोके निर्वचनं स्मृतम्।\nतदद्य त्वयि पश्यामि क्षत्रिये विपरीतवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2018630, "chapter_id": 1389, "verse_number": "३-२७-३७", "content_sanskrit": "यो न दर्शयते तेजः क्षत्रियः काल आगते।\nसर्वभूतानि तं पार्थ सदा परिभवन्त्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2018631, "chapter_id": 1389, "verse_number": "३-२७-३८", "content_sanskrit": "तत्त्वया न क्षमा कार्या शत्रून्प्रति कथंचन।\nतेजसैव हि ते शक्या निहन्तुं नात्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2018632, "chapter_id": 1389, "verse_number": "३-२७-३९", "content_sanskrit": "तथैव यः क्षमाकाले क्षत्रियो नोपशाम्यति।\nअप्रियः सर्वभूतानां सोमुत्रेह च नश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2018633, "chapter_id": 1389, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि अर्जुनाभिगमनपर्वणि सप्तविंशोऽध्यायः ॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]