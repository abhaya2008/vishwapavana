[{"id": 2001612, "chapter_id": 1029, "verse_number": "१-३०-०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2001613, "chapter_id": 1029, "verse_number": "१-३०-१", "content_sanskrit": "स्पष्टमात्रा तु पद्भ्यां सा गरुडेन बलीयसा।\nअभज्यत तरोः शाखा भग्नां चैकामधारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2001614, "chapter_id": 1029, "verse_number": "१-३०-२", "content_sanskrit": "तां भङ्क्त्वा स महाशाखां स्मयमानो विलोकयन्।\nअथात्रं लम्बतोऽपश्यद्वालखिल्यानधोमुखान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2001615, "chapter_id": 1029, "verse_number": "१-३०-३", "content_sanskrit": "ऋषयो ह्यत्र लम्बन्ते न हन्यामिति तानृषीन्।\nतपोरतांल्लम्बमानान्ब्रह्मर्षीनभिवीक्ष्य सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2001616, "chapter_id": 1029, "verse_number": "१-३०-४", "content_sanskrit": "हन्यादेतान्संपतन्ती शाखेत्यथ विचिन्त्य सः।\nनखैर्दृढतरं वीरः संगृह्य गजकच्छपौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2001617, "chapter_id": 1029, "verse_number": "१-३०-५", "content_sanskrit": "स तद्विनाशसंत्रासादभिपत्य स्वगाधिपः।\nशाखामास्येन जग्राह तेषामेवान्ववेक्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2001618, "chapter_id": 1029, "verse_number": "१-३०-६", "content_sanskrit": "अतिदैवं तु तत्तस्य कर्म दृष्ट्वा महर्षयः।\nविस्मयोत्कम्पहृदया नाम चक्रुर्महाखगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2001619, "chapter_id": 1029, "verse_number": "१-३०-७", "content_sanskrit": "गुरुं भारं समासाद्योड्डीन एष विहङ्गमः।\nगरुडस्तु खगश्रेष्ठस्तस्मात्पन्नगभोजनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2001620, "chapter_id": 1029, "verse_number": "१-३०-८", "content_sanskrit": "ततः शनैः पर्यपतत्पक्षैः शैलान्प्रकम्पयन्।\nएवं सोऽभ्यपतद्देशान्बहून्सगजकच्छपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2001621, "chapter_id": 1029, "verse_number": "१-३०-९", "content_sanskrit": "दयार्थं वालखिल्यानां न च स्थानमविन्दत।\nस गत्वा पर्वतश्रेष्ठं गन्धमादनमञ्जसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2001622, "chapter_id": 1029, "verse_number": "१-३०-१०", "content_sanskrit": "ददर्श कश्यपं तत्र पितरं तपसि स्थितम्।\nददर्श तं पिता चापि दिव्यरूपं विहङ्गमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2001623, "chapter_id": 1029, "verse_number": "१-३०-११", "content_sanskrit": "तेजोवीर्यबलोपेतं मनोमारुतरंहसम्।\nशैलशृङ्गप्रतीकाशं ब्रह्मदण्डमिवोद्यतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2001624, "chapter_id": 1029, "verse_number": "१-३०-१२", "content_sanskrit": "अचिन्त्यमनभिध्येयं सर्वभूतभयंकरम्।\nमहावीर्यधरं रौद्रं साक्षादग्निमिवोद्यतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2001625, "chapter_id": 1029, "verse_number": "१-३०-१३", "content_sanskrit": "अप्रधृष्यमजेयं च देवदानवराक्षसैः।\nभेत्तारं गिरिशृङ्गाणां समुद्रजलशोषणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2001626, "chapter_id": 1029, "verse_number": "१-३०-१४", "content_sanskrit": "लोकसंलोडनं घोरं कृतान्तसमदर्शनम्।\nतमागतमभिप्रेक्ष्य भगवान्कश्यपस्तदा।\nविदित्वा चास्यं संकल्पमिदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2001627, "chapter_id": 1029, "verse_number": "१-३०-१५x", "content_sanskrit": "कश्यप उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2001628, "chapter_id": 1029, "verse_number": "१-३०-१५", "content_sanskrit": "पुत्र मा साहसं कार्षीर्मा सद्यो लप्स्यसे व्यथाम्।\nमा त्वां दहेयुः संक्रुद्धा वालखिल्या मरीचिपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2001629, "chapter_id": 1029, "verse_number": "१-३०-१६x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2001630, "chapter_id": 1029, "verse_number": "१-३०-१६", "content_sanskrit": "ततः प्रसादयामास कश्यपः पुत्रकारणात्।\nवालखिल्यान्महाभागांस्तपसा हतकल्मषान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2001631, "chapter_id": 1029, "verse_number": "१-३०-१७x", "content_sanskrit": "कश्यप उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2001632, "chapter_id": 1029, "verse_number": "१-३०-१७", "content_sanskrit": "प्रजाहितार्थमारम्भो गरुडस्य तपोधनाः।\nचिकीर्षति महत्कर्म तदनुज्ञातुमर्हथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2001633, "chapter_id": 1029, "verse_number": "१-३०-१८x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2001634, "chapter_id": 1029, "verse_number": "१-३०-१८", "content_sanskrit": "एवमुक्ता भगवता मुनयस्ते समभ्ययुः।\nमुक्त्वा शाखां गिरिं पुण्यं हिमवन्त तपोऽर्थिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2001635, "chapter_id": 1029, "verse_number": "१-३०-१९", "content_sanskrit": "ततस्तेष्वपयातेषु पितरं विनतासुतः।\nशाखाव्याक्षिप्तवदनः पर्यपृच्छत कश्यपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2001636, "chapter_id": 1029, "verse_number": "१-३०-२०", "content_sanskrit": "भगवन्क्व विमुञ्चामि तरोः शाखामिमामहम्।\nवर्जितं मानुषैर्देशमाख्यातु भगवान्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2001637, "chapter_id": 1029, "verse_number": "१-३०-२१x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2001638, "chapter_id": 1029, "verse_number": "१-३०-२१", "content_sanskrit": "ततो निःपुरुषं शैलं हिमसंरुद्धकन्दरम्।\nअगम्यं मनसाप्यन्यैस्तस्याचख्यौ स कश्यपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2001639, "chapter_id": 1029, "verse_number": "१-३०-२२", "content_sanskrit": "तं पर्वतं महाकुक्षिमुद्दिश्य स महाखगः।\nजवेनाभ्यपतत्तार्क्ष्यः सशाखागजकच्छपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2001640, "chapter_id": 1029, "verse_number": "१-३०-२३", "content_sanskrit": "न तां वध्री परिणहेच्छतचर्मा महातनुम्।\nशाखिनो महतीं शाखां यां प्रगृह्य ययौ खगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2001641, "chapter_id": 1029, "verse_number": "१-३०-२४", "content_sanskrit": "स ततः शतसाहस्रं योजनान्तरमागतः।\nकालेन नातिमहता गरुडः पतगेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2001642, "chapter_id": 1029, "verse_number": "१-३०-२५", "content_sanskrit": "स तं गत्वा क्षणेनैव पर्वतं वचनात्पितुः।\nअमुञ्चन्महतीं शाखां सस्वनं तत्र खेचरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2001643, "chapter_id": 1029, "verse_number": "१-३०-२६", "content_sanskrit": "पक्षानिलहतश्चास्य प्राकम्पत स शैलराट्।\nमुमोच पुष्पवर्षं च समागलितपादप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2001644, "chapter_id": 1029, "verse_number": "१-३०-२७", "content_sanskrit": "शृङ्गाणि च व्यशीर्यन्त गिरेस्तस्य समन्ततः।\nमणिकाञ्चनचित्राणि शोभयन्ति महागिरिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2001645, "chapter_id": 1029, "verse_number": "१-३०-२८", "content_sanskrit": "शाखिनो बहवश्चापि शाखयाऽभिहतास्तया।\nकाञ्चनैः कुसुमैर्भान्ति विद्युत्वन्त इवाम्बुदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2001646, "chapter_id": 1029, "verse_number": "१-३०-२९", "content_sanskrit": "ते हेमविकचा भूमौ युताः पर्वतधातुभिः।\nव्यराजञ्छाखिनस्तत्र सूर्यांशुप्रतिरञ्जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2001647, "chapter_id": 1029, "verse_number": "१-३०-३०", "content_sanskrit": "ततस्तस्य गिरेः शृङ्गमास्थाय स खगोत्तमः।\nभक्षयामास गरुडस्तावुभौ गजकच्छपौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2001648, "chapter_id": 1029, "verse_number": "१-३०-३१", "content_sanskrit": "तावुभौ भक्षयित्वा तु स तार्क्ष्यः कूर्मकुञ्जरौ।\nततः पर्वतकूटाग्रादुत्पपात महाजवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2001649, "chapter_id": 1029, "verse_number": "१-३०-३२", "content_sanskrit": "प्रावर्तन्ताथ देवानामुत्पाता भयशंसिनः।\nइन्द्रस्य वज्रं दयितं प्रजज्वाल भयात्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2001650, "chapter_id": 1029, "verse_number": "१-३०-३३", "content_sanskrit": "सधूमा न्यपतत्सार्चिर्दिवोल्का नभसश्च्युता।\nतथा वसूनां रुद्राणामादित्यानां च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2001651, "chapter_id": 1029, "verse_number": "१-३०-३४", "content_sanskrit": "साध्यानां मरुतां चैव ये चान्ये देवतागणाः।\nस्वं स्वं प्रहरणं तेषां परस्परमुपाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2001652, "chapter_id": 1029, "verse_number": "१-३०-३५", "content_sanskrit": "अभूतपूर्वं संग्रामे तदा देवासुरेऽपि च।\nववुर्वाताः सनिर्घाताः पेतुरुल्काः सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2001653, "chapter_id": 1029, "verse_number": "१-३०-३६", "content_sanskrit": "निरभ्रमेव चाकाशं प्रजगर्ज महास्वनम्।\nदेवानामपि यो देवः सोऽप्यवर्षत शोणितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2001654, "chapter_id": 1029, "verse_number": "१-३०-३७", "content_sanskrit": "मम्लुर्माल्यानि देवानां नेशुस्तेजांसि चैव हि।\nउत्पातमेघा रौद्राश्च ववृषुः शोणितं बहु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2001655, "chapter_id": 1029, "verse_number": "१-३०-३८", "content_sanskrit": "रजांसि मुकुटान्येषामुत्थितानि व्यधर्षयन्।\nततस्त्राससमुद्विग्नः सह देवैः शतक्रतुः।\nउत्पातान्दारुणान्पश्यन्नित्युवाच बृहस्पतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2001656, "chapter_id": 1029, "verse_number": "१-३०-३९", "content_sanskrit": "किमर्थं भगवन्घोरा उत्पाताः सहसोत्थिताः।\nन च शत्रुं प्रपश्यामि युधि यो नः प्रधर्षयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2001657, "chapter_id": 1029, "verse_number": "१-३०-४०x", "content_sanskrit": "बृहस्पतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2001658, "chapter_id": 1029, "verse_number": "१-३०-४०", "content_sanskrit": "तवापराधाद्देवेन्द्र प्रमादाच्च शतक्रतो।\nतपसा वालखिल्यानां महर्षीणां महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2001659, "chapter_id": 1029, "verse_number": "१-३०-४१", "content_sanskrit": "कश्यपस्य मुनेः पुत्रो विनतायाश्च खेचरः।\nहर्तुं सोममभिप्राप्तो बलवान्कामरूपधृक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2001660, "chapter_id": 1029, "verse_number": "१-३०-४२", "content_sanskrit": "समर्थो बलिनां श्रेष्ठो हर्तुं सोमं विहंगमः।\nसर्वं संभावयाम्यस्मिन्नसाध्यमपि साधयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2001661, "chapter_id": 1029, "verse_number": "१-३०-४३x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2001662, "chapter_id": 1029, "verse_number": "१-३०-४३", "content_sanskrit": "श्रुत्वैतद्वचनं शक्रः प्रोवाचामृतरक्षिणः।\nमहावीर्यबलः पक्षी हर्तुं सोममिहोद्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2001663, "chapter_id": 1029, "verse_number": "१-३०-४४", "content_sanskrit": "युष्मान्संबोधयाम्येष गृहीत्वावरणायुधान्।\nपरिवार्यामृतं सर्वे यूयं मद्वचनादिह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2001664, "chapter_id": 1029, "verse_number": "१-३०-४५", "content_sanskrit": "रक्षध्वं विबुधा वीरा यथा न स हरेद्बलात्।\nअतुलं हि बलं तस्य बृहस्पतिरुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2001665, "chapter_id": 1029, "verse_number": "१-३०-४६x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2001666, "chapter_id": 1029, "verse_number": "१-३०-४६", "content_sanskrit": "तच्छ्रुत्वा विबुधा वाक्यं विस्मिता यत्नमास्थिताः।\nपरिवार्यामृतं तस्थूर्वज्री चेन्द्रः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2001667, "chapter_id": 1029, "verse_number": "१-३०-४७", "content_sanskrit": "धारयन्तो विचित्राणि काञ्चनानि मनस्विनः।\nकवचानि महार्हाणि वैदूर्यविकृतानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2001668, "chapter_id": 1029, "verse_number": "१-३०-४८", "content_sanskrit": "चर्माण्यपि च गात्रेषु भानुमन्ति दृढानि च।\nविविधानि च शस्त्राणि घोररूपाण्यनेकशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2001669, "chapter_id": 1029, "verse_number": "१-३०-४९", "content_sanskrit": "शिततीक्ष्णाग्रधाराणि समुद्यम्य सुरोत्तमः।\nसविस्फुलिङ्गज्वालानि सधूमानि च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2001670, "chapter_id": 1029, "verse_number": "१-३०-५०", "content_sanskrit": "चक्राणि परघांश्चैव त्रिशूलानि परश्वधान्।\nशक्तीश्च विविधास्तीक्ष्णाः करवालांश्च निर्मलान्।\nस्वदेहरूपाण्यादाय गदाश्चोग्रप्रदर्शनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2001671, "chapter_id": 1029, "verse_number": "१-३०-५१", "content_sanskrit": "तैः शस्त्रैर्भानुमद्भिस्ते दिव्याभरणभूषिताः।\nभानुमन्तः सुरगणास्तस्थुर्विगतकल्मषाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2001672, "chapter_id": 1029, "verse_number": "१-३०-५२", "content_sanskrit": "अनुपमबलवीर्यतेजसो\nधृतमनसः परिरक्षणेऽमृतस्य।\nअसुरपुरविदारणाः सुरा\nज्वलनसमिद्धवपुःप्रकाशिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2001673, "chapter_id": 1029, "verse_number": "१-३०-५३", "content_sanskrit": "इति समरवरं सुराः स्थितास्ते\nपरिघसहस्रशतैः समाकुलम्।\nविगलितमिव चाम्बरान्तरं\nतपनमरीचिविकाशितं बभासे॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2001674, "chapter_id": 1029, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि आस्तीकपर्वणि त्रिंशोऽध्यायः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]