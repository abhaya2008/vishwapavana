[{"id": 2105743, "chapter_id": 3284, "verse_number": "१६-१३-१", "content_sanskrit": "अर्जुन उवाच।\nभीम ज्येष्ठो गुरुर्मे त्वं नातोऽन्यद्वमुक्तुमुत्सहे।\nधृताराष्ट्रस्तु राजर्षिः सर्वथा मानमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2105744, "chapter_id": 3284, "verse_number": "१६-१३-२", "content_sanskrit": "न स्मरन्त्यपराद्धानि स्मरन्ति सुकृतान्यपि।\nअसंभिन्नार्थमर्यादाः साधवः पुरुषोत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2105745, "chapter_id": 3284, "verse_number": "१६-१३-३", "content_sanskrit": "इति तस्य वचः श्रुत्वा फल्गुनस्य महात्मनः।\nविदुरं प्राह धर्मात्मा कुन्तीपुत्रो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2105746, "chapter_id": 3284, "verse_number": "१६-१३-४", "content_sanskrit": "इदं मद्वचनात्क्षत्तः कौरवं ब्रूहि पार्थिवम्।\nयावदिच्छति पुत्राणां दातुं तावद्ददाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2105747, "chapter_id": 3284, "verse_number": "१६-१३-५", "content_sanskrit": "भीष्मादीनां च सर्वेषां सुहृदामुपकारिणाम्।\nमम कोशादिति विभो मा भूद्भीमः सुदुर्मनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2105748, "chapter_id": 3284, "verse_number": "१६-१३-६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2105749, "chapter_id": 3284, "verse_number": "१६-१३-६", "content_sanskrit": "इत्युक्त्वा धर्मराजस्तमर्जुनं प्रत्यपूजयत्।\nभीमसेनः कटाक्षेण वीक्षांचक्रे धनंजयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2105750, "chapter_id": 3284, "verse_number": "१६-१३-७", "content_sanskrit": "ततः स विदुरं धीमान्वाक्यमाह युधिष्ठिरः।\nन भीमसेन कोपं स नृपतिः कर्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2105751, "chapter_id": 3284, "verse_number": "१६-१३-८", "content_sanskrit": "परिक्लिष्टो हि भीमस्तु हिमवृष्ट्यातपादिभिः।\nदुःखैर्बहुविधैर्धीमानरण्ये विदितं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2105752, "chapter_id": 3284, "verse_number": "१६-१३-९", "content_sanskrit": "किंतु मद्वचनाद्ब्रूहि राजानं भरतर्षभम्॥\nयद्यदिच्छसि यावच्च गृह्यतां मद्गृहादिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2105753, "chapter_id": 3284, "verse_number": "१६-१३-१०", "content_sanskrit": "यन्मात्सर्यमयं भीमः करोति भृशदुःखितः।\nन तन्मनसि कर्तव्यमिति वाच्यः स पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2105754, "chapter_id": 3284, "verse_number": "१६-१३-११", "content_sanskrit": "यन्ममास्ति धनं किञ्चिदर्जुनस्य च वेश्मनि।\nतस्य स्वामी महाराज इति वाच्यः स पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2105755, "chapter_id": 3284, "verse_number": "१६-१३-१२", "content_sanskrit": "ददातु राजा विप्रेभ्यो यथेष्टं क्रियतां व्ययः।\nपुत्राणां सुहृदां चैव गच्छत्वानृण्यमद्य सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2105756, "chapter_id": 3284, "verse_number": "१६-१३-१३", "content_sanskrit": "इदं चापि शरीरं मे तवायत्तं जनाधिप।\nधनानि चेति विद्धि त्वं क्षत्तर्नास्त्यत्र संशयः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2105757, "chapter_id": 3284, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्रमवासिकपर्वणि आश्रमवासपर्वणि त्रयोदशोऽध्यायः॥। १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]