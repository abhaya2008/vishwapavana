[{"id": 2091914, "chapter_id": 2956, "verse_number": "१३-८६-१", "content_sanskrit": "भीष्म उवाच।\nनहुषस्तु ततः श्रुत्वा च्यवनं तं तथाऽऽगतम्।\nत्वरितः प्रययौ तत्रि सहामात्यपुरोहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2091915, "chapter_id": 2956, "verse_number": "१३-८६-२", "content_sanskrit": "शौचं कृत्वा यथान्यायं प्राञ्जलिः प्रयतो नृपः।\nआत्मानमाचचक्षे च च्यवनाय महात्मने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2091916, "chapter_id": 2956, "verse_number": "१३-८६-३", "content_sanskrit": "अर्चयामास तं चापि तस्य राज्ञः पुरोहितः।\nसत्यव्रतं महात्मानं देवकल्पं विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2091917, "chapter_id": 2956, "verse_number": "१३-८६-४x", "content_sanskrit": "नहुष उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2091918, "chapter_id": 2956, "verse_number": "१३-८६-४", "content_sanskrit": "करवाणि प्रियं किं ते तन्मे ब्रूहि द्विजोत्तम।\nसर्वं कर्ताऽस्मि भगवन्यद्यपि स्यात्सुदुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2091919, "chapter_id": 2956, "verse_number": "१३-८६-५x", "content_sanskrit": "च्यवन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2091920, "chapter_id": 2956, "verse_number": "१३-८६-५", "content_sanskrit": "श्रमेणि महता युक्ताः कैवर्ता मत्स्यजीविनः।\nमम मूल्यं प्रयच्छैभ्यो मत्स्यानां विक्रयैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2091921, "chapter_id": 2956, "verse_number": "१३-८६-६x", "content_sanskrit": "नहुष उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2091922, "chapter_id": 2956, "verse_number": "१३-८६-६", "content_sanskrit": "सहस्रं दीयतां मूल्यं निषादेभ्यः पुरोहित।\nनिष्क्रयार्थे भगवतो यथाऽऽह भृगुनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2091923, "chapter_id": 2956, "verse_number": "१३-८६-७x", "content_sanskrit": "च्यवन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2091924, "chapter_id": 2956, "verse_number": "१३-८६-७", "content_sanskrit": "आत्ममूल्यं च वक्तव्यं न तल्लोकः प्रशंसति।\nतस्मादहं प्रवक्ष्यामि न चात्मस्तुतिम्मवृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2091925, "chapter_id": 2956, "verse_number": "१३-८६-८", "content_sanskrit": "सहस्रं नाहमर्हामि किं वा त्वं मन्यसे नृप।\nसदृशं दीयतां मूल्यं स्वबुद्ध्या निश्चयं कुरु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2091926, "chapter_id": 2956, "verse_number": "१३-८६-९x", "content_sanskrit": "नहुष उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2091927, "chapter_id": 2956, "verse_number": "१३-८६-९", "content_sanskrit": "सहस्राणां शतं विप्र निषोदेभ्यः प्रदीयताम्।\nस्यादिदं भगवन्मूल्यं किं वाऽन्यन्मन्यते भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2091928, "chapter_id": 2956, "verse_number": "१३-८६-१०x", "content_sanskrit": "च्यवन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2091929, "chapter_id": 2956, "verse_number": "१३-८६-१०", "content_sanskrit": "नाहं शतसहस्रेण निमेयः पार्थिवर्षभ।\nदीयतां सदृशं मूल्यममात्यैः सह चिन्तय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2091930, "chapter_id": 2956, "verse_number": "१३-८६-११x", "content_sanskrit": "नहुष उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2091931, "chapter_id": 2956, "verse_number": "१३-८६-११", "content_sanskrit": "कोटिः प्रदीयतां मूल्यं निषादेभ्यः पुरोहित।\nयदेतदपि नो मूल्यमतो भूयः प्रदीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2091932, "chapter_id": 2956, "verse_number": "१३-८६-१२x", "content_sanskrit": "च्यवन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2091933, "chapter_id": 2956, "verse_number": "१३-८६-१२", "content_sanskrit": "राजन्नार्हाम्यहं कोटिं भूयो वाऽपि महाद्युते।\nसदृशं दीयतां मूल्यं ब्राह्मणैः सह चिन्तय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2091934, "chapter_id": 2956, "verse_number": "१३-८६-१३x", "content_sanskrit": "नहुष उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2091935, "chapter_id": 2956, "verse_number": "१३-८६-१३", "content_sanskrit": "अर्दं राज्यं समग्रं वा निषादेभ्यः प्रदीयताम्।\nएतत्तुल्यमहं मन्ये किं वाऽन्यन्मन्यसे द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2091936, "chapter_id": 2956, "verse_number": "१३-८६-१४x", "content_sanskrit": "च्यवन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2091937, "chapter_id": 2956, "verse_number": "१३-८६-१४", "content_sanskrit": "अर्धं राज्यं समग्रं च मूल्यं नार्हामि पार्थिव।\nसदृशं दीयतां मूल्यमृषिभिः सह चिन्त्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2091938, "chapter_id": 2956, "verse_number": "१३-८६-१५x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2091939, "chapter_id": 2956, "verse_number": "१३-८६-१५", "content_sanskrit": "महर्षेर्वचनं श्रुत्वा नहुषो दुःखकर्शितः।\nस चिन्तयामास तदा सहामात्यपुरोहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2091940, "chapter_id": 2956, "verse_number": "१३-८६-१६", "content_sanskrit": "तत्र त्वन्यो वनचरः कश्चिन्मूलफलाशनः।\nनहुषस्य समीपस्थो गविजातोऽभवन्मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2091941, "chapter_id": 2956, "verse_number": "१३-८६-१७", "content_sanskrit": "स तमाभाष्य राजानमब्रवीद्द्विजसत्तमः।\nतोषयिष्याम्यहं क्षिप्तं यथा तुष्टो भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2091942, "chapter_id": 2956, "verse_number": "१३-८६-१८", "content_sanskrit": "नाहं मिथ्यावचो ब्रूयां खैरेष्वपि कुतोऽन्यथा।\nभवतो यदहं ब्रयां तत्कार्यमविशङ्कया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2091943, "chapter_id": 2956, "verse_number": "१३-८६-१९x", "content_sanskrit": "नहुष उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2091944, "chapter_id": 2956, "verse_number": "१३-८६-१९", "content_sanskrit": "व्रवीतु भगवान्मूल्यं महर्षेः सदृशं भृगोः।\nपरित्रायस्व मामस्मद्विषयं च कुलं च मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2091945, "chapter_id": 2956, "verse_number": "१३-८६-२०", "content_sanskrit": "हन्याद्धि भगवान्क्रुद्धस्त्रैलोक्यमपि केवलम्।\nकिं पुनर्मां तपोहीनं बाहुवीर्यपरायणम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2091946, "chapter_id": 2956, "verse_number": "१३-८६-२१", "content_sanskrit": "अगाधाम्भसि मग्नस्य सामात्यस्य सऋत्विजः।\nप्लवो भव महर्षे त्वं कुरु मूल्यविनिश्चयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2091947, "chapter_id": 2956, "verse_number": "१३-८६-२२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2091948, "chapter_id": 2956, "verse_number": "१३-८६-२२", "content_sanskrit": "नहुषस्य वचः श्रुत्वा गविजातः प्रतापवान्।\nउवाच हर्षयन्सर्वानमात्यान्पार्थिवं च तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2091949, "chapter_id": 2956, "verse_number": "१३-८६-२३", "content_sanskrit": "`ब्राह्मणानां गवां चैव कुलमेकं द्विधा कृतम्।\nएकत्र मन्त्रास्तिष्ठन्ति हविरन्यत्र तिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2091950, "chapter_id": 2956, "verse_number": "१३-८६-२४", "content_sanskrit": "अनर्घेया महाराज द्विजा वर्णेषु चोत्तमाः।\nगावश्च पुरुषव्याग्र गौर्मूल्यं परिकल्प्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2091951, "chapter_id": 2956, "verse_number": "१३-८६-२५", "content_sanskrit": "नहुषस्तु ततः श्रुत्वा महर्षेर्वचनं नृप।\nहर्षेण महता युक्तः सहामात्यपुरोहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2091952, "chapter_id": 2956, "verse_number": "१३-८६-२६", "content_sanskrit": "अभिगम्य भृगोः पुत्रं च्यवनं संशितव्रतम्।\nइदं प्रोवाच नृपते वाचा सन्तर्पयन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2091953, "chapter_id": 2956, "verse_number": "१३-८६-२७", "content_sanskrit": "उत्तिष्ठोत्तिष्ठ विप्रर्षे गवा क्रीतोसि भार्गव।\nएतन्मूल्यमहं मन्ये तव धर्मभृतांवर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2091954, "chapter_id": 2956, "verse_number": "१३-८६-२८x", "content_sanskrit": "च्यवन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2091955, "chapter_id": 2956, "verse_number": "१३-८६-२८", "content_sanskrit": "उत्तिष्ठाम्येष राजेन्द्र सम्यक् क्रीतोस्मि तेऽनघ।\nगोभिस्तुल्यं न पश्यामि धनं किञ्चिदिहाच्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2091956, "chapter_id": 2956, "verse_number": "१३-८६-२९", "content_sanskrit": "कीर्तनं श्रवणं दानं दर्शनं चापि पार्थिव।\nगवां प्रशस्यते वीर सर्वपापहरं शिवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2091957, "chapter_id": 2956, "verse_number": "१३-८६-३०", "content_sanskrit": "गावो लक्ष्म्याः सदा मूलं गोषु पाप्मा न विद्यते।\nअन्नमेव सदा गावो देवानां परमं हविः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2091958, "chapter_id": 2956, "verse_number": "१३-८६-३१", "content_sanskrit": "स्वाहाकारवषट्कारौ गोषु नित्यं प्रतिष्ठितौ।\nगावो यज्ञस्य नेत्र्यो वै तथा यज्ञस्य ता मुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2091959, "chapter_id": 2956, "verse_number": "१३-८६-३२", "content_sanskrit": "अमृतं ह्यव्ययं दिव्यं क्षरन्ति च वहन्ति च।\nअमृतायतनं चैताः सर्वलोकनमस्कृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2091960, "chapter_id": 2956, "verse_number": "१३-८६-३३", "content_sanskrit": "तेजसा वपुषा चैव गावो वह्निसमा भुवि।\nगावो हि सुमहत्तेजः प्राणिनां च सुखप्रदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2091961, "chapter_id": 2956, "verse_number": "१३-८६-३४", "content_sanskrit": "निविष्टं गोकुलं यत्र श्वासं मुञ्चति निर्भयम्।\nविराजयति तं देशं पापं चास्यापकर्षति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2091962, "chapter_id": 2956, "verse_number": "१३-८६-३५", "content_sanskrit": "गावः स्वर्गस्य सोपानं गावः स्वर्गेऽपि पूजिताः।\nगावः कामदुहोदेव्यो नान्यत्किञ्चित्परं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2091963, "chapter_id": 2956, "verse_number": "१३-८६-३६", "content_sanskrit": "इत्येतद्गोषु मे प्रोक्तं महात्म्यं भरतर्षभ।\nगुणैकदेशवचनं शक्यं पारायणं न तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2091964, "chapter_id": 2956, "verse_number": "१३-८६-३७x", "content_sanskrit": "निषादा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2091965, "chapter_id": 2956, "verse_number": "१३-८६-३७", "content_sanskrit": "दर्शनं कथनं चैव सहास्माभिः कृतं मुने।\nसतां साप्तपदं मैत्रं प्रसादं न कुरु प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2091966, "chapter_id": 2956, "verse_number": "१३-८६-३८", "content_sanskrit": "हवींषि सर्वाणि यथा ह्युपभुङ्क्ते हुताशनः।\nएवं त्वमपि धर्मात्मन्पुरुषाग्निः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2091967, "chapter_id": 2956, "verse_number": "१३-८६-३९", "content_sanskrit": "प्रसादयामहे विद्वन्भवन्तं प्रणता वयम्।\nअनुग्रहार्थमस्माकमियं गौः प्रतिगृह्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2091968, "chapter_id": 2956, "verse_number": "१३-८६-४०", "content_sanskrit": "`अत्यन्तापदि शक्तानां परित्राणं हि कुर्वताम्।\nया गतिर्विदिता त्वद्य नरके शरणं भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2091969, "chapter_id": 2956, "verse_number": "१३-८६-४०x", "content_sanskrit": "च्यवन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2091970, "chapter_id": 2956, "verse_number": "१३-८६-४१", "content_sanskrit": "कृपणस्य च यच्चक्षुर्मुनेराशीविषस्य च।\nनरं समूलं दहति कक्षमग्निरिव ज्वलन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2091971, "chapter_id": 2956, "verse_number": "१३-८६-४२", "content_sanskrit": "प्रतिगृह्णामि वो धेनुं कैवर्ता मुक्तकिल्बिषाः।\nदिवं गच्छत वै क्षिप्रं मत्स्यैर्जालोद्धृतैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2091972, "chapter_id": 2956, "verse_number": "१३-८६-४३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2091973, "chapter_id": 2956, "verse_number": "१३-८६-४३", "content_sanskrit": "ततस्तस्य प्रभावात्ते महर्षेर्भावितात्मनः।\nनिषादास्तेन वाक्येन सह मत्स्यैर्दिवं ययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2091974, "chapter_id": 2956, "verse_number": "१३-८६-४४", "content_sanskrit": "ततः स राजा नहुषो विस्मितः प्रेक्ष्य धीवरान्।\nआरोहमाणांस्त्रिदिवं मत्स्यांश्च भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2091975, "chapter_id": 2956, "verse_number": "१३-८६-४५", "content_sanskrit": "ततस्तौ गविजश्चैव च्यवनश्च भृगूद्वहः।\nवराभ्यामनुरूपाभ्यां छन्दयामासतुर्नृपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2091976, "chapter_id": 2956, "verse_number": "१३-८६-४६", "content_sanskrit": "ततो राजा महावीर्यो नहुषः पृथिवीपतिः।\nपरमित्यब्रवीत्प्रीतस्तदा भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2091977, "chapter_id": 2956, "verse_number": "१३-८६-४७", "content_sanskrit": "ततो जग्राह धर्मे स स्थितिमिन्द्रनिभो नृपः।\nतथेति चोदितः प्रीतस्तावृषी प्रत्यपूजयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2091978, "chapter_id": 2956, "verse_number": "१३-८६-४८", "content_sanskrit": "समाप्तदीक्षश्च्यवनस्ततोऽगच्छत्स्वमाश्रमम्।\nगविजश्च महातेजाः स्वमाश्रमपदं ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2091979, "chapter_id": 2956, "verse_number": "१३-८६-४९", "content_sanskrit": "निषादाश्च दिवं जग्मुस्ते च मत्स्या जनाधिप।\nनहुषोपि वरं लब्ध्वा प्रविवेश स्वकं पुरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2091980, "chapter_id": 2956, "verse_number": "१३-८६-५०", "content_sanskrit": "एतत्ते कथितं तात यन्मां त्वं परिपृच्छसि।\nदर्शने यादृशः स्नेहः संवासे वा युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2091981, "chapter_id": 2956, "verse_number": "१३-८६-५१", "content_sanskrit": "महाभाग्यं गवां चैव तता धर्मविनिश्चयम्।\nकिं भूयः कथ्यतां वीर किं ते हृदि विवक्षितम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2091982, "chapter_id": 2956, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि षडशीतितमोऽध्यायः॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]