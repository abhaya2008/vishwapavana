[{"id": 5000557000, "chapter_id": 9557, "verse_number": "७-२२-१", "content_sanskrit": "स तस्य तु महानादं श्रुत्वा वैवस्वतः प्रभुः ।\nशत्रुं विजयिनं मेने स्वबलस्य च सङ्क्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000557001, "chapter_id": 9557, "verse_number": "७-२२-२", "content_sanskrit": "स हि योधान्हतान्मत्वा क्रोधसंरक्तलोचनः ।\nअब्रवीत्त्वरितं सूतं रथो ऽयमुपनीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000557002, "chapter_id": 9557, "verse_number": "७-२२-३", "content_sanskrit": "तस्य सूतस्तदा दिव्यमुपस्थाप्य महारथम् ।\nस्थितः स च महातेजा ह्यध्यारोहत तं रथम् ।\nप्राशमुद्गरहस्तश्च मृत्युस्तस्याग्रतः स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000557003, "chapter_id": 9557, "verse_number": "७-२२-४", "content_sanskrit": "येन सङ्क्षिप्यते सर्वं त्रैलोक्यमिदमव्ययम् ।\nकालदण्डस्तु पार्श्वस्थो मूर्तिमानस्य चाभवत् ।\nयमप्रहरणं दिव्यं तेजसा ज्वलदग्निमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000557004, "chapter_id": 9557, "verse_number": "७-२२-५", "content_sanskrit": "तस्य पार्श्वेषु निच्छिद्राः कालपाशाः प्रतिष्ठिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000557005, "chapter_id": 9557, "verse_number": "७-२२-६", "content_sanskrit": "पावकस्पर्शसङ्काशः स्थितो मूर्तश्च मुद्गरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000557006, "chapter_id": 9557, "verse_number": "७-२२-७", "content_sanskrit": "ततो लोकत्रयं क्षुब्धमकम्पन्त दिवौकसः ।\nकालं दृष्ट्वा तथा क्रुद्धं सर्वलोकभयावहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000557007, "chapter_id": 9557, "verse_number": "७-२२-८", "content_sanskrit": "ततः प्रचोदयन्सूतस्तानश्वान्रुचिरप्रभान् ।\nप्रययौ भीमसन्नादो यत्र रक्षःपतिः स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000557008, "chapter_id": 9557, "verse_number": "७-२२-९", "content_sanskrit": "मुहूर्तेन यमं ते तु हया हरिहयोपमाः ।\nप्रापयन्मनसस्तुल्या यत्र तत्प्रस्तुतं रणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000557009, "chapter_id": 9557, "verse_number": "७-२२-१०", "content_sanskrit": "दृष्ट्वा तथैव विकृतं रथं मृत्युसमन्वितम् ।\nसचिवा राक्षसेन्द्रस्य सहसा विप्रदुद्रुवुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000557010, "chapter_id": 9557, "verse_number": "७-२२-११", "content_sanskrit": "लघुसत्त्वतया ते हि नष्टसञ्ज्ञा भयार्दिताः ।\nनेह योद्धुं समर्थाः स्म इत्युक्त्वा प्रययुर्दिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000557011, "chapter_id": 9557, "verse_number": "७-२२-१२", "content_sanskrit": "स तु तं तादृशं दृष्ट्वा रथं लोकभयावहम् ।\nनाक्षुभ्यत दशग्रीवो न चापि भयमाविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000557012, "chapter_id": 9557, "verse_number": "७-२२-१३", "content_sanskrit": "स तु रावणमासाद्य व्यसृजच्छक्तितोमरान् ।\nयमो मर्माणि सङ्क्रुद्धो रावणस्योपकृन्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000557013, "chapter_id": 9557, "verse_number": "७-२२-१४", "content_sanskrit": "रावणस्तु ततः स्वस्थः शरवर्षं मुमोच ह ।\nतस्मिन्वैवस्वतरथे तोयवर्षमिवाम्बुदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000557014, "chapter_id": 9557, "verse_number": "७-२२-१५", "content_sanskrit": "ततो महाशक्तिशरैः पात्यमानैर्महोरसि (पात्यमानो) ।\nनाशक्नोत्प्रतिकर्तुं स राक्षसः शल्यपीडितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000557015, "chapter_id": 9557, "verse_number": "७-२२-१६", "content_sanskrit": "एवं नानाप्रहरणैर्यमेनामित्रकर्षिणा ।\nसप्तरात्रं कृतः सङ्ख्ये विसञ्ज्ञो विमुखो रिपुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000557016, "chapter_id": 9557, "verse_number": "७-२२-१७", "content_sanskrit": "तदासीत्तुमुलं युद्धं यमराक्षसयोर्द्वयोः ।\nजयमाकाङ्क्षतोर्वीर समरेष्वनिवर्तिनोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000557017, "chapter_id": 9557, "verse_number": "७-२२-१८", "content_sanskrit": "ततो देवाः सगन्धर्वाः सिद्धाश्च परमर्षयः ।\nप्रजापतिं पुरस्कृत्य समेतास्तद्रणाजिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000557018, "chapter_id": 9557, "verse_number": "७-२२-१९", "content_sanskrit": "संवर्त इव लोकानां क्रुध्यतोरभवत्तदा ।\nराक्षसानां च मुख्यस्य प्रेतानामीश्वरस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000557019, "chapter_id": 9557, "verse_number": "७-२२-२०", "content_sanskrit": "राक्षसेन्द्रो ऽपि विस्फार्य चापमिन्द्राशनिप्रभम् ।\nनिरन्तरमिवाकाशं कुर्वन्बाणांस्ततो ऽसृजत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000557020, "chapter_id": 9557, "verse_number": "७-२२-२१", "content_sanskrit": "मृत्युं चतुर्भिर्विशिखैः सूतं सप्तभिरार्दयत् ।\nयमं शतसहस्रेण शीघ्रं मर्मस्वताडयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000557021, "chapter_id": 9557, "verse_number": "७-२२-२२", "content_sanskrit": "ततः क्रुद्धस्य वदनाद्यमस्य समजायत ।\nज्वालामाली सनिःश्वासः सधूमः कोपपावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000557022, "chapter_id": 9557, "verse_number": "७-२२-२३", "content_sanskrit": "तदाश्चर्यमथो दृष्ट्वा देवदानवसन्निधौ ।\nप्रहर्षितौ सुसंरब्धौ मृत्युकालौ बभूवतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000557023, "chapter_id": 9557, "verse_number": "७-२२-२४", "content_sanskrit": "ततो मृत्युः क्रुद्धतरो वैवस्वतमभाषत ।\nमुञ्च मां समरे यावद्धन्मीमं पापराक्षसम् ।\nनैषा रक्षो भवेदद्य मर्यादा हि निसर्गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000557024, "chapter_id": 9557, "verse_number": "७-२२-२५", "content_sanskrit": "हिरण्यकशिपुः श्रीमान्नमुचिः शम्बरस्तथा ।\nविसन्धिर्धूमकेतुश्च बलिर्वैरोचनो ऽपि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000557025, "chapter_id": 9557, "verse_number": "७-२२-२६", "content_sanskrit": "दम्भुर्दैत्यमहाराजो वृत्रो बाणस्तथैव च ।\nराजर्षयः शास्त्रविदो गन्धर्वाः समहोरगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000557026, "chapter_id": 9557, "verse_number": "७-२२-२७", "content_sanskrit": "ऋषयः पन्नगा दैत्या यक्षाश्चाप्यप्सरोगणाः ।\nयुगान्तपरिवर्ते च पृथिवी समहार्णवा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000557027, "chapter_id": 9557, "verse_number": "७-२२-२८", "content_sanskrit": "क्षयं नीता महाराज सपर्वतसरिद्द्रुमा ।\nएते चान्ये च बहवो बलवन्तो दुरासदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000557028, "chapter_id": 9557, "verse_number": "७-२२-२९", "content_sanskrit": "विनिपन्ना मया दृष्टाः किमुतायं निशाचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000557029, "chapter_id": 9557, "verse_number": "७-२२-३०", "content_sanskrit": "मुञ्चं मां साधु धर्मज्ञ यावदेनं निहन्म्यहम् ।\nनहि कश्चिन्मया दृष्टो बलवानपि जीवति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000557030, "chapter_id": 9557, "verse_number": "७-२२-३१", "content_sanskrit": "बलं मम न खल्वेतन्मर्यादैषा निसर्गतः ।\nस दृष्टो न मया कालं मुहुर्तमापि जीवति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000557031, "chapter_id": 9557, "verse_number": "७-२२-३२", "content_sanskrit": "तस्यैवं वचनं श्रुत्वा धर्मराजः प्रतापवान् ।\nअब्रवीत्तत्र तं मुत्युं त्वं तिष्ठैनं निहन्म्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000557032, "chapter_id": 9557, "verse_number": "७-२२-३३", "content_sanskrit": "ततः संरक्तनयनः क्रुद्धो वैवस्वतः प्रभुः ।\nकालदण्डममोघं तु तोलयामास पाणिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000557033, "chapter_id": 9557, "verse_number": "७-२२-३४", "content_sanskrit": "यस्य पार्श्वेषु निखिला कालपाशाः प्रतिष्ठिताः ।\nपावकाशनिसङ्काशो मुद्गरो मूर्तिमान्स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000557034, "chapter_id": 9557, "verse_number": "७-२२-३५", "content_sanskrit": "दर्शनादेव यः प्राणान्प्राणिनामपकर्षति ।\nकिं पुनः स्पृश्यमानस्य पात्यमानस्य वा पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000557035, "chapter_id": 9557, "verse_number": "७-२२-३६", "content_sanskrit": "स ज्वालापरिवारस्तु निर्दहन्निव राक्षसम् ।\nतेन स्पृष्टो बलवता महाप्रहरणो ऽस्फुरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000557036, "chapter_id": 9557, "verse_number": "७-२२-३७", "content_sanskrit": "ततो विदुद्रुवुः सर्वे तस्मात्रस्ता रणाजिरे ।\nसुराश्च क्षुभिताः सर्वे दृष्ट्वा दण्डोद्यतं यमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000557037, "chapter_id": 9557, "verse_number": "७-२२-३८", "content_sanskrit": "तस्मिन्प्रहर्तुकामे तु यमे दण्डेन रावणम् ।\nयमं पितामहः साक्षाद्दर्शयित्वेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000557038, "chapter_id": 9557, "verse_number": "७-२२-३९", "content_sanskrit": "वैवस्वत महाबाहो न खल्वमितविक्रम ।\nन हन्तव्यस्त्वया तेन दण्डेनैव निशाचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000557039, "chapter_id": 9557, "verse_number": "७-२२-४०", "content_sanskrit": "वरः खलु मयैतस्मै दत्तस्त्रिदशपुङ्गव ।\nस त्वया नानृतः कार्यो यन्मया व्याहृतं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000557040, "chapter_id": 9557, "verse_number": "७-२२-४१", "content_sanskrit": "यो हि मामनृतं कुर्याद्देवो वा मानुषो ऽपि वा ।\nत्रैलोक्यमनृतं तेन कृतं स्यान्नात्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000557041, "chapter_id": 9557, "verse_number": "७-२२-४२", "content_sanskrit": "क्रुद्धेन विप्रमुक्तो ऽयं निर्विशेषं प्रियाप्रिये ।\nप्रजाः संहरते रौद्रो लोकत्रयभयावहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000557042, "chapter_id": 9557, "verse_number": "७-२२-४३", "content_sanskrit": "अमोघो ह्येष सर्वेषां प्राणिनाममितप्रभः ।\nकालदण्डो मया सृष्टः पूर्वं मृत्युपुरस्कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000557043, "chapter_id": 9557, "verse_number": "७-२२-४४", "content_sanskrit": "तन्न खल्वेष ते सौम्य पात्यो रावणमूर्धनि ।\nनह्यस्मिन्पतिते कश्चिन्मुहूर्तमपि जीवति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000557044, "chapter_id": 9557, "verse_number": "७-२२-४५", "content_sanskrit": "यदि ह्यन्मिन्निपतिते न म्रियेतैष राक्षसः ।\nम्रियते वा दशग्रीवस्तदाप्युभयतो ऽनृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000557045, "chapter_id": 9557, "verse_number": "७-२२-४६", "content_sanskrit": "तन्निवर्तय लङ्केशं द्दण्डमेतं समुद्यतम् ।\nसत्यं च मां कुरुष्वाद्य लोकांस्त्वं यद्यवेक्षसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000557046, "chapter_id": 9557, "verse_number": "७-२२-४७", "content_sanskrit": "एवमुक्तस्तु धर्मात्मा प्रत्युवाच यमस्तदा ।\nएष व्यावर्तितो दण्डः प्रभविष्णुर्हि नो भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000557047, "chapter_id": 9557, "verse_number": "७-२२-४८", "content_sanskrit": "किं न्विदानीं मया शक्यं कर्तुं रणगतेन हि ।\nन मया यद्ययं शक्यो हन्तुं वरपुरस्कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000557048, "chapter_id": 9557, "verse_number": "७-२२-४९", "content_sanskrit": "एष तस्मात्प्रणश्यामि दर्शनादस्य रक्षसः ।\nइत्युक्त्वा सरथः साश्वस्तत्रैवान्तरधीयत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000557049, "chapter_id": 9557, "verse_number": "७-२२-५०", "content_sanskrit": "दशग्रीवस्तु तं जित्वा नाम विश्राव्य चात्मनः ।\nआरुह्य पुष्पकं भूयो निष्क्रान्तो यमसादनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000557050, "chapter_id": 9557, "verse_number": "७-२२-५१", "content_sanskrit": "स तु वैवस्वतो देवैः सह ब्रह्मपुरोगमैः ।\nजगाम त्रिदिवं हृष्टो नारदश्च महामुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000557051, "chapter_id": 9557, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे द्वाविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]