[{"id": 2062378, "chapter_id": 2329, "verse_number": "८-५०-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2062379, "chapter_id": 2329, "verse_number": "८-५०-१", "content_sanskrit": "द्रौणिर्युधिष्ठिरं दृष्ट्वा शैनेयेनाभिरक्षितम्।\nद्रौपदेयैस्तथा शूरैरभ्यवर्तत हृष्टवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2062380, "chapter_id": 2329, "verse_number": "८-५०-२", "content_sanskrit": "किरन्निषुगणान्घोरान्हेमपुङ्खाञ्शिलाशितान्।\nदर्शयन्विविधान्मार्गाञ्शिक्षया लघुहस्तवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2062381, "chapter_id": 2329, "verse_number": "८-५०-३", "content_sanskrit": "खं पुरयञ्शरैस्तीक्ष्णैर्वेगवद्भिः समन्ततः।\nयुधिष्ठिरस्य समरे दिशः सर्वाः समावृणोत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2062382, "chapter_id": 2329, "verse_number": "८-५०-४", "content_sanskrit": "भारद्वाजशरैश्छन्नं न प्राज्ञायत किञ्चन।\nबाणभूतमभूत्सर्वमायोधनशिरो महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2062383, "chapter_id": 2329, "verse_number": "८-५०-५", "content_sanskrit": "बाणजालं दिविष्ठं तत्स्वर्णपुङ्खविभूषितम्।\nशुशुभे भरतश्रेष्ठ विमानमिव विष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2062384, "chapter_id": 2329, "verse_number": "८-५०-६", "content_sanskrit": "तेन च्छन्ने रणे राजन्बाणजालेन भास्वता।\nअभ्रच्छायेव सजज्ञे हृतरश्मिस्तमोनुदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2062385, "chapter_id": 2329, "verse_number": "८-५०-७", "content_sanskrit": "तदद्भुतमपश्याम बाणभूते नभस्थले।\nन स्म सम्पतते भूतं द्रौणेर्दृष्ट्वा पराक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2062386, "chapter_id": 2329, "verse_number": "८-५०-८", "content_sanskrit": "सात्यकिर्यतमानस्तु धर्मराजस्तु पाण़्डवः।\nतथेतराणि सैन्यानि न स्म चक्रुः पराक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2062387, "chapter_id": 2329, "verse_number": "८-५०-९", "content_sanskrit": "लाघवं द्रोणपुत्रस्य दृष्ट्वा तत्र महारथाः।\nव्यस्मयन्त महाराज न चैनं प्रत्युदीक्षितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2062388, "chapter_id": 2329, "verse_number": "८-५०-१०", "content_sanskrit": "शेकुस्ते सर्वराजानस्तपन्तमिव भास्करम्।\nवध्यमाने ततः सैन्ये द्रौपदेया महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2062389, "chapter_id": 2329, "verse_number": "८-५०-११", "content_sanskrit": "सात्यकिर्धर्मराजश्च पाञ्चालाश्चापि सङ्गताः।\nत्यक्त्वा मृत्युभयं घोरं द्रौणायनिभुपाद्रवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2062390, "chapter_id": 2329, "verse_number": "८-५०-१२", "content_sanskrit": "सात्यकिः सप्तविंशत्या द्रौणिं विद्ध्वा शिलीमुखैः।\nपुनर्विव्याध नाराचैः सप्तभिः स्वर्णभूषितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2062391, "chapter_id": 2329, "verse_number": "८-५०-१३", "content_sanskrit": "युधिष्ठिरस्त्रिसप्तत्या प्रतिविन्ध्यश्च सप्तभिः।\nश्रुतकर्मा त्रिभिर्वाणैः श्रुतकीर्तिश्च सप्तभिः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2062392, "chapter_id": 2329, "verse_number": "८-५०-१४", "content_sanskrit": "सुतसोमस्तु नवभिः शतानीकश्च सप्तभिः।\nअन्ये च वहवः शूरा विव्यधुस्तं समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2062393, "chapter_id": 2329, "verse_number": "८-५०-१५", "content_sanskrit": "स तु क्रुद्धस्ततो राजन्नाशीविप इव श्वसन्।\nसात्यकिं पञ्चविंशत्या प्राविध्यत शिलीमुखैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2062394, "chapter_id": 2329, "verse_number": "८-५०-१६", "content_sanskrit": "श्रुतकीर्तिं च नवभिः सुतसोमं च पञ्चभिः।\nअष्टभिः श्रुतकर्माणं प्रतिबिन्ध्यं त्रिभिः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2062395, "chapter_id": 2329, "verse_number": "८-५०-१७", "content_sanskrit": "शतानीकं च नवभिर्धर्मपुत्रं च पञ्चभिः।\nतथेतरांस्ततः शूरान्द्वाभ्यां द्वाभ्यामताडयत्।\nश्रुतकीर्तेस्तथा चापं चिच्छेद निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2062396, "chapter_id": 2329, "verse_number": "८-५०-१८", "content_sanskrit": "अथान्यद्वनुरादाय श्रुतकीर्तिर्महारथः।\nद्रौणायनिं त्रिभिर्विद्व्वा विव्याधान्यैः शितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2062397, "chapter_id": 2329, "verse_number": "८-५०-१९", "content_sanskrit": "ततो द्रौणिर्महाराज शरवर्षेण भारिष।\nछादयामास तत्सैन्यं समन्ताद्भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2062398, "chapter_id": 2329, "verse_number": "८-५०-२०", "content_sanskrit": "ततः पुनरमेयात्मा धर्मराजस्य कार्मुकम्।\nद्रौणिश्चिच्छेद विहसन्विव्याध च शरैस्त्रिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2062399, "chapter_id": 2329, "verse_number": "८-५०-२१", "content_sanskrit": "ततो धर्मसुतो राजन्प्रगृह्यान्यन्महद्धनुः।\nद्रोणपुत्रं त्रिपष्टxx ततु बाह्वोरुरसि चार्पययत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2062400, "chapter_id": 2329, "verse_number": "८-५०-२२", "content_sanskrit": "सात्यकिस्तु ततः क्रुद्धो द्रौणेः प्रहरतो रणे।\nअर्धचन्द्रेणतीक्ष्णेन धनुश्छित्त्वाऽनदद्भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2062401, "chapter_id": 2329, "verse_number": "८-५०-२३", "content_sanskrit": "छिन्नधन्वा ततो द्रौणिः शक्त्या शक्तिमतां वरः।\nसारथिं पातयामास शैनेयस्य रथाद्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2062402, "chapter_id": 2329, "verse_number": "८-५०-२४", "content_sanskrit": "अथान्यद्वनुरादाय द्रोणपुत्रः प्रतापवान्।\nशैनेयं शरवर्षेण च्छादयामास भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2062403, "chapter_id": 2329, "verse_number": "८-५०-२५", "content_sanskrit": "तस्याश्वाः प्रद्रुताः सङ्ख्ये पतिते रथसारथौ।\nतत्रतत्रैव धावन्तः समदृश्यन्त भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2062404, "chapter_id": 2329, "verse_number": "८-५०-२६", "content_sanskrit": "युधिष्ठिरपुरोगास्तु द्रौणिं शस्त्रभृतां वरम्।\nअभ्यवर्षन्त वेगेन विसृजन्तः शिताञ्छरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2062405, "chapter_id": 2329, "verse_number": "८-५०-२७", "content_sanskrit": "सहसा पततस्तान्वै क्रुद्वरूपान्परन्तपः।\nप्रहसन्प्रतिजग्राह द्रोणपुत्रो महारणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2062406, "chapter_id": 2329, "verse_number": "८-५०-२८", "content_sanskrit": "ततः शरशतज्वालः सेनाकक्षं महारणे।\nद्रौणिर्ददाह समरे कक्षमग्निरिवोत्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2062407, "chapter_id": 2329, "verse_number": "८-५०-२९", "content_sanskrit": "तद्बलं पाण्डुपुत्रस्य द्रोणपुत्रप्रतापितम्।\nचुक्षुभे भरतश्रेष्ठ तस्मिन्नेव चमूमुखे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2062408, "chapter_id": 2329, "verse_number": "८-५०-३०", "content_sanskrit": "तद्बलं पाण्डवेयस्य द्रोणपुत्रः शरार्चिषा।\nतापयन्भरतश्रेष्ठ गभस्तिभिरिवांशुमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2062409, "chapter_id": 2329, "verse_number": "८-५०-३१", "content_sanskrit": "तत्पच्यमानं मर्षेण ब्राह्मणस्य च सायकैः।\nक्षुभ्यते पाण्डवं सैन्यं तिमिनेव नदीमुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2062410, "chapter_id": 2329, "verse_number": "८-५०-३२", "content_sanskrit": "दृष्ट्वा चैव महाराज द्रोणपुत्रपराक्रमम्।\nसर्वान्दुर्योधनः पार्थान्हतान्युद्वेऽभ्यमन्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2062411, "chapter_id": 2329, "verse_number": "८-५०-३३", "content_sanskrit": "युधिष्ठिरस्तु त्वरितो द्रौणिं पीड्य महारथम्।\nअब्रवीद्द्रोणपुत्रं स रोषामर्षसमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2062412, "chapter_id": 2329, "verse_number": "८-५०-३४", "content_sanskrit": "`जानामि त्वां युधि श्रेष्ठ वीर्यवन्तं बलान्वितम्।\nकृतास्त्रं कृतिनं चैव तथा लघुपराक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2062413, "chapter_id": 2329, "verse_number": "८-५०-३५", "content_sanskrit": "बलमेतद्भवान्सर्वं पार्षते यदि दर्सयेत्।\nततस्त्वां बलवन्तं च कृतविद्यं च विद्महे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2062414, "chapter_id": 2329, "verse_number": "८-५०-३६", "content_sanskrit": "न हि वै पार्पतं दृष्ट्वा समरे शत्रुसूदनम्।\nभवेत्तव बलं किञ्चिद्ब्रवीमि त्वां न तु द्विजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2062415, "chapter_id": 2329, "verse_number": "८-५०-३७", "content_sanskrit": "नैव नाम तव प्रीतिर्नैव नाम कृतज्ञता।\nयतस्त्वं पुरुषव्याघ्र मामेवाद्य जिघांससि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2062416, "chapter_id": 2329, "verse_number": "८-५०-३८", "content_sanskrit": "ब्राह्मणेन तपः कार्यं शमश्च दमएव च।\nक्षत्रियेण धनुर्नाभ्यं स भवान्ब्राह्मणब्रुवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2062417, "chapter_id": 2329, "verse_number": "८-५०-३९", "content_sanskrit": "मिषतस्ते महावाहो युधि जेष्यामि कौरवान्।\nकुरुष्व समरे कर्म ब्रह्मबन्धे यथेष्टतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2062418, "chapter_id": 2329, "verse_number": "८-५०-४०", "content_sanskrit": "एवमुक्तो महाराज द्रोणपुत्रः सयन्निव।\nयुक्त तत्त्वं च सञ्चिन्त्य नोत्तरं किञ्चिदब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2062419, "chapter_id": 2329, "verse_number": "८-५०-४१", "content_sanskrit": "अनुक्त्वा च ततः किञ्चिच्छरवर्षेण पाण्डवम्।\nछादयामास समरे क्रुद्धोऽन्तक इव प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2062420, "chapter_id": 2329, "verse_number": "८-५०-४२", "content_sanskrit": "स च्छाद्यमानस्तु तदा द्रोणपुत्रेण मारिष।\nपार्थोऽपयातः शीघ्रं वै प्रगृह्य महतीं चमूम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2062421, "chapter_id": 2329, "verse_number": "८-५०-४३", "content_sanskrit": "अपयाते ततस्तस्मिन्धर्मपुत्रे युधिष्ठिरे।\nद्रोणपुत्रः स्थितो राजन्प्रत्यादेशान्महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2062422, "chapter_id": 2329, "verse_number": "८-५०-४४", "content_sanskrit": "ततो युधिष्ठिरो राजंस्त्यक्त्वा द्रौणिं महाहवे।\nप्रययौ तावकं सैन्यं युक्तः क्रुराय कर्मणे॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2062423, "chapter_id": 2329, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि सप्तदशदिवसयुद्धे पञ्चाशोऽध्यायः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]