[{"id": 900010019, "chapter_id": 8765, "verse_number": "1.1", "content_sanskrit": "शुद्धं प्रमाणं स मे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900010020, "chapter_id": 8765, "verse_number": "1.2", "content_sanskrit": "कर्मविजय", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900010021, "chapter_id": 8765, "verse_number": "1.3", "content_sanskrit": "य इज्यते विधीशानशक्रपूर्वैस्सदा मखैः । रमाप्रणयिने तस्मै सर्वयज्ञभुजे नमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900010022, "chapter_id": 8765, "verse_number": "1.4", "content_sanskrit": "कर्मनिर्णय", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900010023, "chapter_id": 8765, "verse_number": "1.5", "content_sanskrit": "पृष्टेनागम एवादौ वक्तव्यस्साध्यसिद्धय", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900010024, "chapter_id": 8765, "verse_number": "1.6", "content_sanskrit": "कर्तृत्वात्सगुणं ब्रह्म पुरुषं पुरुषर्षभम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900010025, "chapter_id": 8765, "verse_number": "1.7", "content_sanskrit": "वेदवाक्यस्य तु वाचनिकार्थं विना नैवान्यो युज्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900010026, "chapter_id": 8765, "verse_number": "1.8", "content_sanskrit": "स्यात्कर्मविजयप्रीतो गुरुहृद्गानगो हरिः । दद्यात्सुज्ञानभक्ती स्वे विरक्तिं विषयेषु च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900010027, "chapter_id": 8765, "verse_number": "1.9", "content_sanskrit": "कर्मनामा तु भगवान् फलकर्तृत्वतो हरिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900010028, "chapter_id": 8765, "verse_number": "1.10", "content_sanskrit": "बुद्धिपूर्वं सर्वकर्तृत्वात् सर्वज्ञत्वादयो युक्ताः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900010029, "chapter_id": 8765, "verse_number": "1.11", "content_sanskrit": "नाहं कर्ता हरिः कर्ता तत्पूजा कर्म चाखिलम् । तथापि मत्कृता पूजा तत्प्रसादेन नान्यथा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]