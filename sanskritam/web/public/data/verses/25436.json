[{"id": 7005436000, "chapter_id": 25436, "verse_number": "१-६-१", "content_sanskrit": "अथ पृथिव्युद्धारः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005436001, "chapter_id": 25436, "verse_number": "१-६-२", "content_sanskrit": "श्रीकूर्म उवाच ।\nआसीदेकार्णवं घोरमविभागं तमोमयम् ।\nशान्तवातादिकं सर्वं न प्रज्ञायत किञ्चन ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005436002, "chapter_id": 25436, "verse_number": "१-६-३", "content_sanskrit": "एकार्णवे तदा तस्मिन् नष्टे स्थावरजङ्गमे ।\nतदा समभवद् ब्रह्मा सहस्त्राक्षः सहस्त्रपात् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005436003, "chapter_id": 25436, "verse_number": "१-६-४", "content_sanskrit": "सहस्त्रशीर्षा पुरुषो रुक्मवर्णोह्यतीन्द्रियः ।\nब्रह्मा नारायणाख्यस्तु सुष्वाप सलिले तदा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005436004, "chapter_id": 25436, "verse_number": "१-६-५", "content_sanskrit": "इमं चोदाहरन्त्यत्र श्लोकं नारायणं प्रति ।\nब्रह्मस्वरूपिणं देवं जगतः प्रभवाव्ययम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005436005, "chapter_id": 25436, "verse_number": "१-६-६", "content_sanskrit": "आपो नारा इति प्रोक्ता नाम्ना पूर्वमिति श्रुतिः ।\nअयनं तस्य ता यस्मात् तेन नारायणः स्मृतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005436006, "chapter_id": 25436, "verse_number": "१-६-७", "content_sanskrit": "तुल्यं युगसहस्त्रस्य नैशं कालमुपास्य सः ।\nशर्वर्यन्ते प्रकुरुते ब्रह्मत्वं सर्गकारणात् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005436007, "chapter_id": 25436, "verse_number": "१-६-८", "content_sanskrit": "ततस्तु सलिले तस्मिन् विज्ञायान्तर्गतां महीम् ।\nअनुमानात् तदुद्धारं कर्त्तुकामः प्रजापतिः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005436008, "chapter_id": 25436, "verse_number": "१-६-९", "content_sanskrit": "जलक्रीडासु रुचिरं वाराहं रुपमास्थितः ।\nअधृष्यं मनसाप्यन्यैर्वाङ्‌मयं ब्रह्मसंज्ञितम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005436009, "chapter_id": 25436, "verse_number": "१-६-१०", "content_sanskrit": "पृथिव्युद्धरणार्थाय प्रविश्य च रसातलम् ।\nदंष्ट्रयाऽभ्युज्जहारैनामात्माधारो धराधरः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005436010, "chapter_id": 25436, "verse_number": "१-६-११", "content_sanskrit": "दृष्ट्वा दंष्ट्राग्रविन्यस्तां पृथिवीं प्रथितपौरुषम् ।\nअस्तुवञ्जनलोकस्थाः सिद्धा ब्रह्मर्षयो हरिम् ॥६.१०ऋषय ऊचुः ।\nनमस्ते देवदेवाय ब्रह्मणे परमेष्ठिने ।\nपुरुषाय पुराणाय शाश्वताय जयाय च ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005436011, "chapter_id": 25436, "verse_number": "१-६-१२", "content_sanskrit": "नमः स्वयंभुवे तुभ्यं स्त्रष्ट्रे सर्वार्थवेदिने ।\nनमो हिरण्यगर्भाय वेधसे परमात्मने ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005436012, "chapter_id": 25436, "verse_number": "१-६-१३", "content_sanskrit": "नमस्ते वासुदेवाय विष्णवे विश्वयोनये ।\nनारायणाय देवाय देवानां हितकारिणे ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005436013, "chapter_id": 25436, "verse_number": "१-६-१४", "content_sanskrit": "नमोऽस्तु ते चतुर्वक्त्रे शार्ङ्गचक्रासिधारिणे ।\nसर्वभूतात्मभूताय कूटस्थाय नमो नमः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005436014, "chapter_id": 25436, "verse_number": "१-६-१५", "content_sanskrit": "नमो वेदरहस्याय नमस्ते वेदयोनये ।\nनमो बुद्धाय शुद्धाय नमस्ते ज्ञानरूपिणे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005436015, "chapter_id": 25436, "verse_number": "१-६-१६", "content_sanskrit": "नमोऽस्त्वानन्दरूपाय साक्षिणे जगतां नमः ।\nअनन्तायाप्रमेयाय कार्याय करणाय च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005436016, "chapter_id": 25436, "verse_number": "१-६-१७", "content_sanskrit": "नमस्ते पञ्चबूताय पञ्चभूतात्मने नमः ।\nनमो मूलप्रकृतये मायारूपाय ते नमः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005436017, "chapter_id": 25436, "verse_number": "१-६-१८", "content_sanskrit": "नमोऽस्तु ते वराहाय नमस्ते मत्स्यरूपिणे ।\nनमो योगाधिगम्याय नमः सकर्षणाय ते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005436018, "chapter_id": 25436, "verse_number": "१-६-१९", "content_sanskrit": "नमस्त्रिमूर्तये तुभ्यं त्रिधाम्ने दिव्यतेजसे ।\nनमः सिद्धाय पूज्याय गुणत्रयविभागिने ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005436019, "chapter_id": 25436, "verse_number": "१-६-२०", "content_sanskrit": "तमोऽस्त्वादित्यवर्णाय नमस्ते पद्मयोनये ।\nनमोऽमूर्त्ताय मूर्ताय माधवाय नमो नमः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005436020, "chapter_id": 25436, "verse_number": "१-६-२१", "content_sanskrit": "त्वयैव सृष्टमखिलं त्वय्येव लयमेष्यति ।\nपालयैतज्जगत् सर्वं त्राता त्वं शरणं गतिः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005436021, "chapter_id": 25436, "verse_number": "१-६-२२", "content_sanskrit": "इत्थं स भगवान् विष्णुः सनकाद्यैरभिष्टुतः ।\nप्रसादमकरोत् तेषां वराहवपुरीश्वरः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005436022, "chapter_id": 25436, "verse_number": "१-६-२३", "content_sanskrit": "ततः संस्थानमानीय पृथिवीं पृथिवीधरः ।\nमुमोच रूपं मनसा धारयित्वा प्रजापतिः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005436023, "chapter_id": 25436, "verse_number": "१-६-२४", "content_sanskrit": "तस्योपरि जलौघस्य महतो नौरिव स्थिता ।\nविततत्वाच्च देहस्य न मही याति संप्लवम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005436024, "chapter_id": 25436, "verse_number": "१-६-२५", "content_sanskrit": "पृथिवीं तु समीकृत्य पृथिव्यां सोऽचिनोद् गिरीन् ।\nप्राक्‌सर्गदग्धानखिलांस्ततः सर्गेऽदधन्मनः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005436025, "chapter_id": 25436, "verse_number": "१-६-२६", "content_sanskrit": "श्रीकूर्मपुराणे षट्साहस्त्र्यां संषष्ठोऽध्यायः॥६॥॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]