[{"id": 2103256, "chapter_id": 3239, "verse_number": "१४-९५-१", "content_sanskrit": "नमेजय उवाच।\nकोसौ नकुलरूपेण शिरसा काञ्चनेन वै।\nप्राह मानुषवद्वाचमेतत्पृष्टो वदस्व मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2103257, "chapter_id": 3239, "verse_number": "१४-९५-२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2103258, "chapter_id": 3239, "verse_number": "१४-९५-२", "content_sanskrit": "एतत्पूर्वं न पृष्टोऽहं न चास्माभिः प्रभाषितम्।\nश्रूयतां नकुलो योसौ यथा वाक्तस्य मानुषी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2103259, "chapter_id": 3239, "verse_number": "१४-९५-३", "content_sanskrit": "श्राद्धं संकल्पयामास जमदग्निः पुरा किल।\nहोमधेनुस्तमागाच्च स्वयमेव दुदोह ताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2103260, "chapter_id": 3239, "verse_number": "१४-९५-४", "content_sanskrit": "तत्पयः स्थपयामास नवे भाण्डे दृढे शुचौ।\nक्रोधो नकुलरूपेण पिठरं पर्यकर्षयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2103261, "chapter_id": 3239, "verse_number": "१४-९५-५", "content_sanskrit": "जिज्ञासुस्तमृषिश्रेष्टं किं कुर्याद्विप्रिये कृते।\nइति सञ्चिन्त्य दुर्मेधा धर्षयामास तत्पयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2103262, "chapter_id": 3239, "verse_number": "१४-९५-६", "content_sanskrit": "तमाज्ञाय मुनिः क्रोधं नैवास्य स चुकोप ह।\nस तु क्रोधस्ततो राजन्ब्राह्मणीं मूर्तिमास्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2103263, "chapter_id": 3239, "verse_number": "१४-९५-७", "content_sanskrit": "जितोस्मीति भृगुश्रेष्ठ भृगवो ह्यतिरोषणाः।\nलोके मिथ्याप्रवादोयं यत्त्वयाऽस्मि विनिर्जितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2103264, "chapter_id": 3239, "verse_number": "१४-९५-८", "content_sanskrit": "वशे स्थितोऽहं त्वय्यह्य क्षमावति महात्मनि।\nबिभेमि तपसः साधो प्रसादं कुरु मे प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2103265, "chapter_id": 3239, "verse_number": "१४-९५-९x", "content_sanskrit": "जमदग्निरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2103266, "chapter_id": 3239, "verse_number": "१४-९५-९", "content_sanskrit": "साक्षाद्दृष्टोसि मे क्रध गच्छ त्वं विगतज्वरः।\nन त्वयापकृतं मेऽद्य न च मे मन्युरस्ति वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2103267, "chapter_id": 3239, "verse_number": "१४-९५-१०", "content_sanskrit": "यान्समुद्दिश्य संकल्पः पयसोस्य कृतो मया।\nपितरस्ते महाभागास्तेभ्यो बुद्ध्यस्व गम्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2103268, "chapter_id": 3239, "verse_number": "१४-९५-११", "content_sanskrit": "इत्युक्तो जातसंत्रासस्तत्रैवान्तरधीयत।\nपितॄणामभिषङ्गाच्च नकुलत्वमुपागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2103269, "chapter_id": 3239, "verse_number": "१४-९५-१२", "content_sanskrit": "स तान्प्रसादयामास शापस्यान्तो भवेदिति।\nतैश्चाप्युक्तः क्षिपन्धर्मं सापस्यान्तमवाप्स्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2103270, "chapter_id": 3239, "verse_number": "१४-९५-१३", "content_sanskrit": "तैश्चोक्तो यज्ञियान्देशान्धर्मारण्यं तथैव च।\nजुगुप्समानो धावन्स तं यज्ञं समुपासदत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2103271, "chapter_id": 3239, "verse_number": "१४-९५-१४", "content_sanskrit": "धर्मपुत्रमथाक्षिप्य सक्तुप्रस्थेन तेन सः।\nमुक्तः सापात्ततः क्रोधो धर्मो ह्यासीद्युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2103272, "chapter_id": 3239, "verse_number": "१४-९५-१५", "content_sanskrit": "एवमेतत्तदा वृत्तं यज्ञे तस्य महात्मनः।\nपश्यतां चापि नस्तत्र नकुलोऽन्तर्हितस्तदा। ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2103273, "chapter_id": 3239, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि पञ्चनवतितमोऽध्यायः॥ ९५ ॥ समाप्तमनुगीतापर्व। -------", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]