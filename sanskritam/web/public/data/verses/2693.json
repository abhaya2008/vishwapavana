[{"id": 2079582, "chapter_id": 2693, "verse_number": "१२-१९८-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2079583, "chapter_id": 2693, "verse_number": "१२-१९८-१", "content_sanskrit": "किमुत्तरं तदा तौ स्म चक्रतुस्तस्य भाषिते।\nब्राह्मणो वाऽथवा राजा तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2079584, "chapter_id": 2693, "verse_number": "१२-१९८-२", "content_sanskrit": "अथवा तौ गतौ तत्र यदेतत्कीर्तितं त्वया।\nसंवादो वा तयोः कोऽभूत्किं वा तौ तत्र चक्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2079585, "chapter_id": 2693, "verse_number": "१२-१९८-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2079586, "chapter_id": 2693, "verse_number": "१२-१९८-३", "content_sanskrit": "तथेत्येवं प्रतिश्रुत्य धर्मं संपूज्य जापकः।\nयमं कालं च मृत्युं च स्वर्गं संपूज्य चार्हतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2079587, "chapter_id": 2693, "verse_number": "१२-१९८-४", "content_sanskrit": "पूर्वं ये चापरे तत्र समेता ब्राह्मणर्षभाः।\nसर्वान्संपूज्य शिरसा राजानं सोऽब्रवीद्द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2079588, "chapter_id": 2693, "verse_number": "१२-१९८-५", "content_sanskrit": "फलेनानेन संयुक्तो राजर्षे गच्छ मुख्यताम्।\nभवता चाभ्यनुज्ञातो जपेयं भूय एव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2079589, "chapter_id": 2693, "verse_number": "१२-१९८-६", "content_sanskrit": "वरश्च मम पूर्वं हि दत्तो देव्या महाबल।\nश्रद्धा ते जपतो नित्यं भवत्विति विशांपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2079590, "chapter_id": 2693, "verse_number": "१२-१९८-७x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2079591, "chapter_id": 2693, "verse_number": "१२-१९८-७", "content_sanskrit": "यद्येवं सफला सिद्धिः श्रद्धा च जपितुं तव।\nगच्छ विप्र मया सार्धं जापकं फलमाप्नुहि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2079592, "chapter_id": 2693, "verse_number": "१२-१९८-८x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2079593, "chapter_id": 2693, "verse_number": "१२-१९८-८", "content_sanskrit": "कृतः प्रयत्नः सुमहान्सर्वेषां सन्निधाविह।\nसह तुल्यफलावावां गच्छावो यत्र नौ गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2079594, "chapter_id": 2693, "verse_number": "१२-१९८-९x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2079595, "chapter_id": 2693, "verse_number": "१२-१९८-९", "content_sanskrit": "व्यवसायं तयोस्तत्र विदित्वा त्रिदशेश्वरः।\nसह देवैरुपययौ लोकपालैस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2079596, "chapter_id": 2693, "verse_number": "१२-१९८-१०", "content_sanskrit": "साध्याश्च विश्वे मरुतो वाक्यानि सुमहान्ति च।\nनद्यः शैलाः समुद्राश्च तीर्थानि विविधानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2079597, "chapter_id": 2693, "verse_number": "१२-१९८-११", "content_sanskrit": "तपांसि संयोगविधिर्वेदास्तोभाः सरस्वती।\nनारदः पर्वतश्चैव विश्वावसुर्हहाहुहूः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2079598, "chapter_id": 2693, "verse_number": "१२-१९८-१२", "content_sanskrit": "गन्धर्वश्चित्रसेनश्च परिवारगणैर्युतः।\nनागाः सिद्धाश्च मुनयो देवदेवः प्रजापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2079599, "chapter_id": 2693, "verse_number": "१२-१९८-१३", "content_sanskrit": "`आजगाम च देवेशो ब्रह्मा वेदमयोऽव्ययः।\nविष्णुः सहस्रशीर्षश्च देवोऽचिन्त्यः समागमत्।\nअवाद्यन्तान्तरिक्षे च भेर्यस्तूर्याणि वा विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2079600, "chapter_id": 2693, "verse_number": "१२-१९८-१४", "content_sanskrit": "पुष्पवर्षाणि दिव्यानि तत्र तेषां महात्मनाम्।\nननृतुश्चाप्सरः सङ्घास्तत्रतत्र समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2079601, "chapter_id": 2693, "verse_number": "१२-१९८-१५", "content_sanskrit": "अथ स्वर्गस्तथा रूपी ब्राह्मणं वाक्यमब्रवीत्।\nसंसिद्धस्त्वं महाभाग त्वं च सिद्धस्तथा नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2079602, "chapter_id": 2693, "verse_number": "१२-१९८-१६x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2079603, "chapter_id": 2693, "verse_number": "१२-१९८-१६", "content_sanskrit": "अथ तौ सहितौ राजन्नन्योन्यस्य विधानतः।\nविषयप्रतिसंहारमुभावेव प्रचक्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2079604, "chapter_id": 2693, "verse_number": "१२-१९८-१७", "content_sanskrit": "प्राणापानौ तथोदानं समानं व्यानमेव च।\nएवं तौ मनसि स्थाप्य दधतुः प्राणयोर्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2079605, "chapter_id": 2693, "verse_number": "१२-१९८-१८", "content_sanskrit": "उपस्थितकृतौ तौ च नासिकाग्रमधो भ्रुवोः।\nभ्रुकुट्याक्ष्णोश्च मनसा शनैर्धारयतस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2079606, "chapter_id": 2693, "verse_number": "१२-१९८-१९", "content_sanskrit": "निश्चेष्टाभ्यां शरीराभ्यां स्थिरदृष्टी समाहितौ।\nजितासनौ समाधाय र्मूर्धन्यात्मानमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2079607, "chapter_id": 2693, "verse_number": "१२-१९८-२०", "content_sanskrit": "तालुदेशमथोद्दाल्य ब्राह्मणस्य महात्मनः।\nज्योतिर्ज्वाला सुमहती जगाम त्रिदिवं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2079608, "chapter_id": 2693, "verse_number": "१२-१९८-२१", "content_sanskrit": "हाहाकारस्तथा दिक्षु सर्वासु सुमहानभूत्।\nतज्ज्योतिः स्तूयमानं स्म ब्रह्माणं प्राविशत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2079609, "chapter_id": 2693, "verse_number": "१२-१९८-२२", "content_sanskrit": "ततः स्वागतमित्याह तत्तेजः प्रपितामहः।\nप्रादेशमात्रं पुरुषं प्रत्युद्गम्य विशांपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2079610, "chapter_id": 2693, "verse_number": "१२-१९८-२३", "content_sanskrit": "भूयश्चैवापरं प्राह वचनं मधुरं स्मयन्।\nजापकैस्तुल्यफलता योगानां नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2079611, "chapter_id": 2693, "verse_number": "१२-१९८-२४", "content_sanskrit": "योगस्य तावदेतेभ्यः प्रत्यक्षं फलदर्शनम्।\nजापकानां विशिष्टं तु प्रत्युत्थानं समाहितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2079612, "chapter_id": 2693, "verse_number": "१२-१९८-२५", "content_sanskrit": "उष्यतां मयि चेत्युक्त्वा व्याददे स ततो मुखम्।\nअथास्यं प्रविवेशास्य ब्राह्मणो विगतज्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2079613, "chapter_id": 2693, "verse_number": "१२-१९८-२६", "content_sanskrit": "राजाऽप्येतेन विधिना भगवन्तं पितामहम्।\nयथैव द्विजशार्दूलस्तथैव प्राविशत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2079614, "chapter_id": 2693, "verse_number": "१२-१९८-२७", "content_sanskrit": "स्वयंभुवमथो देवा अभिवाद्य ततोऽब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2079615, "chapter_id": 2693, "verse_number": "१२-१९८-२८", "content_sanskrit": "जापकार्थमयं यत्नो यदर्थं वयमागताः।\nकृतपूजाविमौ तुल्यौ त्वया तुल्यफलान्वितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2079616, "chapter_id": 2693, "verse_number": "१२-१९८-२९", "content_sanskrit": "योगजापकयोस्तुल्यं फलं सुमहदद्य वै।\nसर्वांल्लोकानतिक्रम्य गच्छेतां यत्र वाञ्छितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2079617, "chapter_id": 2693, "verse_number": "१२-१९८-३०x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2079618, "chapter_id": 2693, "verse_number": "१२-१९८-३०", "content_sanskrit": "महास्मृतिं पठेद्यस्तु तथैवानुस्मृतिं शुभाम्।\nतावप्येतेन विधिना गच्छेतां मत्सलोकताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2079619, "chapter_id": 2693, "verse_number": "१२-१९८-३१", "content_sanskrit": "यश्च योगे भवेद्भक्तः सोऽपि नास्त्यत्र संशयः।\nविधिनानेन देहान्ते मम लोकानवाप्नुयात्।\nसाधये गम्यतां चैव यथा स्थानानि सिद्धये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2079620, "chapter_id": 2693, "verse_number": "१२-१९८-३२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2079621, "chapter_id": 2693, "verse_number": "१२-१९८-३२", "content_sanskrit": "इत्युक्त्वा स तदा देवस्तत्रैवान्तरधीयत।\nआमन्त्र्य च ततो देवा ययुः स्वंस्वं निवेशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2079622, "chapter_id": 2693, "verse_number": "१२-१९८-३३", "content_sanskrit": "ते च सर्वे महात्मानो धर्मं सत्कृत्य तत्र वै।\nपृष्ठतोऽनुययू राजन्सर्वे सुप्रीतचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2079623, "chapter_id": 2693, "verse_number": "१२-१९८-३४", "content_sanskrit": "एतत्फलं जापकानां गतिश्चैषा प्रकीर्तिता।\nयथाश्रुतं महाराज किं भूयः श्रोतुमिच्छसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2079624, "chapter_id": 2693, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि अष्टनवत्यधिकशततमोऽध्यायः॥ १९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]