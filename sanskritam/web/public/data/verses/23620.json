[{"id": 7003620000, "chapter_id": 23620, "verse_number": "१-२-७-१", "content_sanskrit": "अर्जुन उवाच ।\nमहीसागरमाहात्म्यमद्भुतं कीर्तितं त्वया ।\nविस्मयः परमो मह्यं प्रहर्षश्चोपजायते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003620001, "chapter_id": 23620, "verse_number": "१-२-७-२", "content_sanskrit": "तदहं विस्तराच्छ्रोतुमिदमिच्छामि नारद ।\nकस्य यज्ञे मही ग्लाना वह्नितापाभितापिता ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003620002, "chapter_id": 23620, "verse_number": "१-२-७-३", "content_sanskrit": "नारद उवाच ।\nमहादाख्यानमाख्यास्ये यथा जाता महीनदी ।\nश्रृण्वन्नेतां कथां पुण्यां पुण्यमाप्स्यसि पांडव ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003620003, "chapter_id": 23620, "verse_number": "१-२-७-४", "content_sanskrit": "पुराभूद्भूपतिर्भूमाविन्द्रद्युम्न इति श्रुतः ।\nवदान्यः सर्वधर्मज्ञो मान्यो मानयिता प्रभुः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003620004, "chapter_id": 23620, "verse_number": "१-२-७-५", "content_sanskrit": "उचितज्ञो विवेकस्य निवासो गुणसागरः ।\nन तदस्ति धरापृष्ठे नगरं ग्रामपत्तनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003620005, "chapter_id": 23620, "verse_number": "१-२-७-६", "content_sanskrit": "तदीयपूर्तधर्मस्य चिह्नेन न यदंकितम् ।\nकन्यादानानि बहुधा ब्राह्मेण विधिना व्यधात् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003620006, "chapter_id": 23620, "verse_number": "१-२-७-७", "content_sanskrit": "भूपालोऽसौ ददौ दानमासहस्राद्धनार्थिनाम् ।\nदशमीदिवसे रात्रौ गजपृष्ठेन दुन्दुभिः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003620007, "chapter_id": 23620, "verse_number": "१-२-७-८", "content_sanskrit": "ताड्यते तत्पुरे प्रातः कार्यमेकादशीव्रतम् ।\nयज्वना तेन भूपेन विच्छिन्नं सोमपायिनाम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003620008, "chapter_id": 23620, "verse_number": "१-२-७-९", "content_sanskrit": "स्वरणैरास्तृता दर्भैर्द्व्यंगुलोत्सेधिता मही ।\nगंगायां सिकता धारा वर्षतो दिवि तारकाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003620009, "chapter_id": 23620, "verse_number": "१-२-७-१०", "content_sanskrit": "शक्या गणयितुं प्राज्ञैस्तदीयं सुकृतं न तु ।\nईदृशैः सुकृतैरेष तेनैव वपुषा नृपः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003620010, "chapter_id": 23620, "verse_number": "१-२-७-११", "content_sanskrit": "धाम प्रजापतेः प्राप्तो विमानेन कुरूद्वह ।\nबुभुजे स तदा भोगान्दुर्लभानमरैरपि ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003620011, "chapter_id": 23620, "verse_number": "१-२-७-१२", "content_sanskrit": "अथ कल्पशतस्यांते व्यतीते तं महीपतिम् ।\nप्राह प्रजापतिः सेवावसरायातमात्मनः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003620012, "chapter_id": 23620, "verse_number": "१-२-७-१३", "content_sanskrit": "ब्रह्मोवाच ।\nइंद्रद्युम्न द्रुतं गच्छ धरापृष्ठं नृपोत्तम ।\nन स्तातव्यं मदीयेद्य लोके क्षणमपि त्वया ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003620013, "chapter_id": 23620, "verse_number": "१-२-७-१४", "content_sanskrit": "इंद्रद्युम्न उवाच ।\nकस्माद्ब्रह्मन्नितो भूमौ मां प्रेषयसि सम्प्रति ।\nसति पुण्ये मदीये तु बहुले वद कारणम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003620014, "chapter_id": 23620, "verse_number": "१-२-७-१५", "content_sanskrit": "ब्रह्मोवाच ।\nन पुण्यं केवलं राजन्गुप्तं स्वर्गस्य साधकम् ।\nविना निष्कल्मषां कीर्ति त्रिलोकीतलविस्तृताम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003620015, "chapter_id": 23620, "verse_number": "१-२-७-१६", "content_sanskrit": "तव कीर्तिसमुच्छेदः सांप्रतं वसुधातले ।\nसंजातश्चिरकालेन गत्वा तां कुरु नूतनाम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003620016, "chapter_id": 23620, "verse_number": "१-२-७-१७", "content_sanskrit": "यदि वांछा महीपाल मम धामनि संस्थितौ ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003620017, "chapter_id": 23620, "verse_number": "१-२-७-१८", "content_sanskrit": "इन्द्रद्युम्न उवाच ।\nमदीयं सुकृतं ब्रह्मन्कथं भूमौ भवेदिति ।\nकिं कर्तव्यं मया नैतन्मम चेतसि तिष्ठति ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003620018, "chapter_id": 23620, "verse_number": "१-२-७-१९", "content_sanskrit": "ब्रह्मोवाच ।\nबलवानेष भूपाल कालः कलयति स्वयम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003620019, "chapter_id": 23620, "verse_number": "१-२-७-२०", "content_sanskrit": "ब्रह्मांडान्यपि मां चैव गणना का भवादृशाम् ।\nतदेतदेव मन्येऽहं तव भूपाल सांप्रतम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003620020, "chapter_id": 23620, "verse_number": "१-२-७-२१", "content_sanskrit": "यत्कीर्तिमात्मनो व्यक्तिं नीत्वाभ्येहि पुनर्दिवम् ।\nशुश्रुवानिति वाचं स ब्रह्मणः पृथिवीपतिः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003620021, "chapter_id": 23620, "verse_number": "१-२-७-२२", "content_sanskrit": "पश्यतिस्म तथात्मानं महीतलमुपागतम् ।\nकांपिल्यनगरे भूयः पप्रच्छात्मानमात्मना ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003620022, "chapter_id": 23620, "verse_number": "१-२-७-२३", "content_sanskrit": "नगरं स तदा देशमप्राक्षीदिति विस्मितः ।\nजना ऊचुः ।\nन जानीमो वयं भूपमिंद्रद्युम्नं न तत्पुरम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003620023, "chapter_id": 23620, "verse_number": "१-२-७-२४", "content_sanskrit": "यत्त्वं पृच्छसि भो भद्र कञ्चित्पृच्छ चिरायुषम् ।\nइन्द्रद्युम्न उवाच ।\nकः संप्रति धरापृष्ठे चिरायुः प्रथितो जनाः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003620024, "chapter_id": 23620, "verse_number": "१-२-७-२५", "content_sanskrit": "पृथिवीजयराज्येस्मिन्यत्र प्रबूत मा चिरम् ।\nजना ऊचुः ।\nश्रूयते नैमिषारण्ये सप्तकल्पस्मरो मुनिः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003620025, "chapter_id": 23620, "verse_number": "१-२-७-२६", "content_sanskrit": "मार्कंडेय इति ख्यातस्तं गत्वा पृच्छ संशयम् ।\nतथोपदिष्टस्तैर्गत्वा तत्र तं मुनिपुंगवम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003620026, "chapter_id": 23620, "verse_number": "१-२-७-२७", "content_sanskrit": "निशम्य प्रणिपत्याह नृपः स्वहृदयस्थितम् ।\nइंद्रद्युम्न उवाच ।\nचिरायुर्भगवान्भूमौ विश्रुतः सांप्रतं ततः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003620027, "chapter_id": 23620, "verse_number": "१-२-७-२८", "content_sanskrit": "पृच्छाम्यहं भवान्वेत्ति इंद्रद्युम्नं नृपं न वा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003620028, "chapter_id": 23620, "verse_number": "१-२-७-२९", "content_sanskrit": "श्रीमार्कंडेय उवाच ।\nसप्तकल्पान्तरे नाभूत्कोपींद्रद्युम्नसंज्ञितः ।\nभूपाल किमहं वच्मि तवान्यत्पृच्छ संशयम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003620029, "chapter_id": 23620, "verse_number": "१-२-७-३०", "content_sanskrit": "स निराशस्तदाकर्ण्य वचो भूपोग्निसाधने ।\nसमुद्योगं तदा चक्रे तं दृष्ट्वाह तदा मुनिः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003620030, "chapter_id": 23620, "verse_number": "१-२-७-३१", "content_sanskrit": "मार्कंडेय उवाच ।\nमा साहसमिदं कार्षीर्भद्र वाचं श्रृणुष्व मे ।\nएति जीवंतमानंदो नरं वर्षशतादपि ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003620031, "chapter_id": 23620, "verse_number": "१-२-७-३२", "content_sanskrit": "तत्करोमि प्रतीकारं तव दुःखोपशांतये ।\nश्रृणु भद्र ममास्तीह बको मित्रं चिरंतनः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003620032, "chapter_id": 23620, "verse_number": "१-२-७-३३", "content_sanskrit": "नाडीजंघ इति ख्यातः स त्वा ज्ञास्यत्यसंशयम् ।\nतस्मादेहि द्रुतं यावदावां तत्र व्रजावहे ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003620033, "chapter_id": 23620, "verse_number": "१-२-७-३४", "content_sanskrit": "परोपकारैकफलं जीवितं हि महात्मनाम् ।\nयदि ज्ञास्यत्यसंदिग्धमिंद्रद्युम्नं स वक्ष्यति ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003620034, "chapter_id": 23620, "verse_number": "१-२-७-३५", "content_sanskrit": "तौ प्रस्थिताविति तदा विप्रेंद्रनृपपुंगवौ ।\nहिमाचलं प्रति प्रीतौ नाडीजंघालयं प्रति ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003620035, "chapter_id": 23620, "verse_number": "१-२-७-३६", "content_sanskrit": "बकोऽथ मित्रं स्वं वीक्ष्य चिरकालादुपागतम् ।\nमार्कंडेयं ययौ प्रीत्युत्कंठितः सम्मुखं द्विजैः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003620036, "chapter_id": 23620, "verse_number": "१-२-७-३७", "content_sanskrit": "कृतसंविदभूत्पूर्वं कुशलस्वागतादिना ।\nपप्रच्छानंतरं कार्यं वदागमनकारणम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003620037, "chapter_id": 23620, "verse_number": "१-२-७-३८", "content_sanskrit": "मार्कंडेयोथ तं प्राह बकं प्रस्तुतमीप्सितम् ।\nइंद्रद्युम्नं भवान्वेत्ति भूपालं पृथिवीतले ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003620038, "chapter_id": 23620, "verse_number": "१-२-७-३९", "content_sanskrit": "एतस्य मम मित्रस्य तेन ज्ञातेन कारणम् ।\nनो वायं त्यजति प्राणान्पुरा वह्निप्रवेशनात् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003620039, "chapter_id": 23620, "verse_number": "१-२-७-४०", "content_sanskrit": "एतस्य प्राणरक्षार्थं ब्रूहि जानासि चेन्नृपम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003620040, "chapter_id": 23620, "verse_number": "१-२-७-४१", "content_sanskrit": "नडीजंघ उवाच ।\nचतुर्दश स्मराम्यस्मि कल्पान्विप्रेंद्र सांप्रतम् ।\nआस्तां तद्दर्शनं वार्तामपि वा न स्मराम्यहम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003620041, "chapter_id": 23620, "verse_number": "१-२-७-४२", "content_sanskrit": "इंद्रद्युम्नो महीपालः कोऽपि नासीन्महीतले ।\nएतावन्मात्रमेवाहं जानामि द्विजपुंगव ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003620042, "chapter_id": 23620, "verse_number": "१-२-७-४३", "content_sanskrit": "नारद उवाच ।\nततः स विस्मयाविष्टस्तस्यायुरिति शुश्रुवान् ।\nपप्रच्छ राजा को हेतुर्दानस्य तपसोऽथ वा ।\nयदायुरीदृशं दीर्घं संजातमिति विस्मितः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003620043, "chapter_id": 23620, "verse_number": "१-२-७-४४", "content_sanskrit": "नाडीजंघ उवाच ।\nघृतकंबलमाहात्म्यान्मम देवस्य शूलिनः ।\nदीर्घमायुरिदं विप्र शापाद्बकवपुः श्रृणु ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003620044, "chapter_id": 23620, "verse_number": "१-२-७-४५", "content_sanskrit": "पुरा जन्मन्यहं बालो ब्राह्मणस्याभवं भुवि ।\nपाराशर्यसगोत्रस्य विश्वरूपस्य सन्मुनेः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003620045, "chapter_id": 23620, "verse_number": "१-२-७-४६", "content_sanskrit": "बालको बक इत्येवं प्रतीतोऽतिप्रियः पितुः ।\nचपलोऽतीव बालत्वे निसर्गादेव भद्रक ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003620046, "chapter_id": 23620, "verse_number": "१-२-७-४७", "content_sanskrit": "अथ मारकतं लिंगं देवतावसरात्पितुः ।\nचापल्याद्वालभावाच्चापहृत्य निहितं मया ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003620047, "chapter_id": 23620, "verse_number": "१-२-७-४८", "content_sanskrit": "घृतस्य कुंभे संक्रांतौ मकरस्योत्तरायणे ।\nअथ प्रातर्व्यतीतायां निशि यावत्पिता मम ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003620048, "chapter_id": 23620, "verse_number": "१-२-७-४९", "content_sanskrit": "निर्माल्यापनयं चक्रे तावच्छून्यं शिवालयम् ।\nनिशम्य कांदिशीको मां पप्रच्छ मधुरस्वरम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003620049, "chapter_id": 23620, "verse_number": "१-२-७-५०", "content_sanskrit": "वत्स क्व नु त्वया लिंगं नूनं विनिहितं वद ।\nदास्यामि वांछितं यत्ते भक्ष्यमन्यत्तवेप्सितम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003620050, "chapter_id": 23620, "verse_number": "१-२-७-५१", "content_sanskrit": "ततो मया बालभावाद्भक्ष्यलुब्धेन तत्पितुः ।\nघृतकुंभांतराकृष्य भद्रलिंगं समर्पितम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003620051, "chapter_id": 23620, "verse_number": "१-२-७-५२", "content_sanskrit": "अथ काले तु संप्राप्ते प्रमीतोऽहं नृपालये ।\nजातो जातिस्मारस्तावदानर्ताधिपतेः सुतः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003620052, "chapter_id": 23620, "verse_number": "१-२-७-५३", "content_sanskrit": "घृतकंबलमाहात्म्यान्मकरस्थे दिवाकरे ।\nअपि बाल्यादवज्ञानात्संयोगाद्घृतलिंगयोः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003620053, "chapter_id": 23620, "verse_number": "१-२-७-५४", "content_sanskrit": "ततः संस्थापितं लिंगं प्राग्जन्म स्मरता मया ।\nततः प्रभृति लिंगानि घृतेनाच्छादयाम्यहम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003620054, "chapter_id": 23620, "verse_number": "१-२-७-५५", "content_sanskrit": "पितृपैतामहं प्राप्य राज्यं शक्त्यनुरूपतः ।\nततः प्रसन्नो भगवान्पार्वतीपतिराह माम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003620055, "chapter_id": 23620, "verse_number": "१-२-७-५६", "content_sanskrit": "पूर्वजन्मनि तुष्टोऽहं घृतकंबलपूजया ।\nप्रयच्छाम्यस्मि त राज्यमधुनाभिमतं वृणु ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003620056, "chapter_id": 23620, "verse_number": "१-२-७-५७", "content_sanskrit": "ततो मया वृतः प्रादाद्गाणपत्यं मदीप्सितम् ।\nकैलासे मां शिवो नित्यं संतुष्टः प्राह चेति च ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003620057, "chapter_id": 23620, "verse_number": "१-२-७-५८", "content_sanskrit": "तेनैव हि शरिरेण प्रणतं पुरतः स्थितम् ।\nअद्यप्रभृति संक्रांतौ मकरस्यापरोपि यः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003620058, "chapter_id": 23620, "verse_number": "१-२-७-५९", "content_sanskrit": "घृतेन पूजां कर्तासौ भावी मम गणः स्फुटम् ।\nइत्युक्त्वा मां शिवो भद्र गणकोटीश्वरं व्यधात् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003620059, "chapter_id": 23620, "verse_number": "१-२-७-६०", "content_sanskrit": "प्रतीपपालकंनाम संस्थितं शिवशासनम् ।\nततः कामादिभिः षड्भिः पदैश्चंक्रमणात्मिकाम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003620060, "chapter_id": 23620, "verse_number": "१-२-७-६१", "content_sanskrit": "निसर्गचपलां प्राप्य भ्रमरीमिव तां श्रियम् ।\nनैवालमभवं तस्या धारणे दैवयोगतः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003620061, "chapter_id": 23620, "verse_number": "१-२-७-६२", "content_sanskrit": "विचचार तदा मत्तः किलाहं वारणो यथा ।\nकृत्याकृत्यविचारेण विमुक्तोऽतीव गर्वितः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003620062, "chapter_id": 23620, "verse_number": "१-२-७-६३", "content_sanskrit": "विद्यामभिजनं लक्ष्मीं प्राप्य नीचनरो यथा ।\nआपदां पात्रतामेति सिंधूनामिव सागरः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003620063, "chapter_id": 23620, "verse_number": "१-२-७-६४", "content_sanskrit": "अथ काले व्यतिक्रांते कियन्मात्रे यदृच्छया ।\nविचरन्नगमं शैलं हिमानीरुद्धकंदरम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003620064, "chapter_id": 23620, "verse_number": "१-२-७-६५", "content_sanskrit": "तपस्यति मुनिस्तत्र गालवो भार्यया सह ।\nसदैव तीव्रतपसा कृशो धमनिसंततः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003620065, "chapter_id": 23620, "verse_number": "१-२-७-६६", "content_sanskrit": "ब्राह्मणस्य हि देहोयं नैवैहिकफलप्रियः ।\nकृच्छ्राय तपसे चेह प्रेत्यानंतसुखाय च ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003620066, "chapter_id": 23620, "verse_number": "१-२-७-६७", "content_sanskrit": "तस्य भार्याऽतिरूपेण विजिग्ये विश्ववर्णिनी ।\nतन्वी श्यामा मृगाक्षी सा पीनोन्नतपयोधरा ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003620067, "chapter_id": 23620, "verse_number": "१-२-७-६८", "content_sanskrit": "हंसगद्गदसंभाषा मत्तमातंगगामिनी ।\nविस्तीर्णजघना मध्ये क्षामा दीर्घशिरोरुहा ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003620068, "chapter_id": 23620, "verse_number": "१-२-७-६९", "content_sanskrit": "निम्ननाभिर्विधात्रैषा निर्मिता संदिदृक्षुणा ।\nविकीर्णमिव सौंदर्यमेकपात्रमिव स्थितम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003620069, "chapter_id": 23620, "verse_number": "१-२-७-७०", "content_sanskrit": "ततोऽविनीतस्तां वीक्ष्य भद्र गालववल्लभाम् ।\nअहमासं शरव्रातैस्ताडितः पुष्पधन्विना ।\nविवेकिनोऽपि मुनयस्तावदेव विवेकिनः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003620070, "chapter_id": 23620, "verse_number": "१-२-७-७१", "content_sanskrit": "यावन्न हरिणाक्षीणामपांगविवरेक्षिताः ।\nमया व्यवसितं चित्ते तदानीं तां जिहीर्षुणा ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003620071, "chapter_id": 23620, "verse_number": "१-२-७-७२", "content_sanskrit": "इति चेति हरिष्यामि तपसा रक्षितां मुनेः ।\nअस्याः कृते यदि शपेन्मुनिस्तत्र पराभवः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003620072, "chapter_id": 23620, "verse_number": "१-२-७-७३", "content_sanskrit": "मम भावी भवेदेषा भार्या मृत्युरुतापि मे ।\nतस्माच्छिष्यो भवाम्यस्य शुश्रूषानिरतो मुनेः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003620073, "chapter_id": 23620, "verse_number": "१-२-७-७४", "content_sanskrit": "प्राप्यांतरं हरिष्यामि नास्य योग्येयमंगना ।\nइति व्यवस्य विद्यार्थिमूर्तिमास्थाय गालवम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003620074, "chapter_id": 23620, "verse_number": "१-२-७-७५", "content_sanskrit": "नमस्कृत्य वचोऽवोचमिति भाव्यर्थनोदितः ।\nतथा मतिस्तथा मित्रं व्यवसायस्तथा नृणाम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003620075, "chapter_id": 23620, "verse_number": "१-२-७-७६", "content_sanskrit": "भवेदवश्यं तद्भावि यथा पुंभिः पुरा कृतम् ।\nविवेकवैराग्ययुतो भगवंस्त्वासमुपस्थितः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003620076, "chapter_id": 23620, "verse_number": "१-२-७-७७", "content_sanskrit": "शिष्योऽहं भवता पाठ्यं कर्णधारं महामुनिम् ।\nअपारपारदं विष्णुं विप्रमूर्तिमुपाश्रितम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003620077, "chapter_id": 23620, "verse_number": "१-२-७-७८", "content_sanskrit": "नमस्ये चेतनं ब्रह्मा प्रत्यक्षं गालवाख्यया ।\nअविद्याकृष्णसर्पेण दष्टं तद्विषपीडितम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003620078, "chapter_id": 23620, "verse_number": "१-२-७-७९", "content_sanskrit": "उपदेशमहामंत्रैर्मां जांगुलिक जीवय ।\nमहामोहमहा वृक्षो हृद्यावापसमुत्थितः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003620079, "chapter_id": 23620, "verse_number": "१-२-७-८०", "content_sanskrit": "त्वद्वाक्यतीक्ष्णधारेण कुठारेण क्षयं व्रजेत् ।\nअपवर्गपथव्यापी मूढसंसर्गसेचनः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003620080, "chapter_id": 23620, "verse_number": "१-२-७-८१", "content_sanskrit": "छिद्यतां सूत्रधारेण विद्यापरशुनाधुना ।\nभजामि तव शिष्योऽहं वरिवस्यापरश्चिरम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003620081, "chapter_id": 23620, "verse_number": "१-२-७-८२", "content_sanskrit": "समिद्दर्भान्मूलफलं दारूणि जलमेव च ।\nआहरिष्येऽनुगृह्णीष्व विनीतं मामुपस्थितम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003620082, "chapter_id": 23620, "verse_number": "१-२-७-८३", "content_sanskrit": "इत्थं पुरा बकाभिख्यं बकवृत्तिमुपाश्रितम् ।\nतदाऽर्जवे कृतमतिरनुजग्राह मां मुनिः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003620083, "chapter_id": 23620, "verse_number": "१-२-७-८४", "content_sanskrit": "ततोऽतीव विनीतोऽहं भूत्वा तं ब्राह्मणीयुतम् ।\nविश्वासनाय सुदृढं तोषयामि दिनेदिने ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003620084, "chapter_id": 23620, "verse_number": "१-२-७-८५", "content_sanskrit": "स च जानन्मुनिः पत्नीं पात्रभूतामविश्वसन् ।\nस्त्रीचरित्रविदंके तां विधाय स्वपिति द्विजः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003620085, "chapter_id": 23620, "verse_number": "१-२-७-८६", "content_sanskrit": "अथान्यस्मिन्दिने साभूद्ब्राह्मण्यथ रजस्वला ।\nतद्दूरशायिनी रात्रौ विश्वासान्मे तपस्विनी ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003620086, "chapter_id": 23620, "verse_number": "१-२-७-८७", "content_sanskrit": "इदमन्तरमित्यंतर्विचिंत्याहं प्रहर्षितः ।\nमलिम्लुचाकृतिर्भूत्वा निशीथे तामथाहरम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003620087, "chapter_id": 23620, "verse_number": "१-२-७-८८", "content_sanskrit": "विललाप तदा बाला ह्रियमाणा मयोच्चकैः ।\nमैवं मैवमिति ज्ञात्वा मां स्वरेणाब्रवीन्मुनिम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003620088, "chapter_id": 23620, "verse_number": "१-२-७-८९", "content_sanskrit": "बकवृत्तिरयं दुष्टो धर्मकंचुकमाश्रितः ।\nहरते मां दुराचारस्तस्मात्त्वं त्राहि गालव ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003620089, "chapter_id": 23620, "verse_number": "१-२-७-९०", "content_sanskrit": "तव शिष्यः पुरा भूत्वा कोप्वेषोद्य मलिम्लुचः ।\nमां जिहीर्षति तद्रक्ष शरण्य शरणं भव ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003620090, "chapter_id": 23620, "verse_number": "१-२-७-९१", "content_sanskrit": "तद्वाक्यसमकालं स प्रबुद्धो गालवो मुनिः ।\nतिष्ठतिष्ठेति मामुक्त्वा गतिस्तम्भं व्यधान्मम ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003620091, "chapter_id": 23620, "verse_number": "१-२-७-९२", "content_sanskrit": "ततश्चित्राकृतिरहं स्तम्भितो मुनिनाऽभवम् ।\nव्रीडितं प्रविशामीव स्वांगानि किल लज्जया ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003620092, "chapter_id": 23620, "verse_number": "१-२-७-९३", "content_sanskrit": "ततः प्रकुपितः प्राह मामभ्येत्याथ गालवः ।\nतद्वज्रदुःसहं वाक्यं येनाहमभवं बकः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003620093, "chapter_id": 23620, "verse_number": "१-२-७-९४", "content_sanskrit": "गालव उवाच ।\nबकवृत्तिमुपाश्रित्य वंचितोऽहं यतस्त्वया ।\nतस्माद्बकस्त्वं भविता चिरकालं नराधम ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003620094, "chapter_id": 23620, "verse_number": "१-२-७-९५", "content_sanskrit": "इति शप्तोऽहमभवं मुनिनाऽधर्ममाश्रितः ।\nपरदारोपसेवार्थमनर्थमिममागतः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003620095, "chapter_id": 23620, "verse_number": "१-२-७-९६", "content_sanskrit": "न हीदृशमनायुष्यं लोके किंचन विद्यते ।\nयादृशं पुरुषस्येह परदारोपसेवनम् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003620096, "chapter_id": 23620, "verse_number": "१-२-७-९७", "content_sanskrit": "ततः सती सा मत्स्पर्शदूषितांगी तपस्विनी ।\nमया विमुक्ता स्नात्वा मां तथैवानुशशाप ह ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003620097, "chapter_id": 23620, "verse_number": "१-२-७-९८", "content_sanskrit": "एवं ताभ्यामहं शप्तो ह्यश्वत्थपर्णवद्भयात् ।\nकंपमानः प्रणम्योभाववोचं तत्र दम्पती ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003620098, "chapter_id": 23620, "verse_number": "१-२-७-९९", "content_sanskrit": "गणोऽहमीश्वरस्यैव दुर्विनीततरो युवाम् ।\nनिरोधमेवं कुरुतं भगवंतावनुग्रहम् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003620099, "chapter_id": 23620, "verse_number": "१-२-७-१००", "content_sanskrit": "वाचि क्षुरो नावनीतं हृदयं हि द्विजन्मनाम् ।\nप्रकुप्यंति प्रसीदंति क्षणेनापि प्रसादिताः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003620100, "chapter_id": 23620, "verse_number": "१-२-७-१०१", "content_sanskrit": "त्वयि विप्रतिपन्नस्य त्वमेव शरणं मम ।\nभूमौ स्खलितपादानां भूमिरेवावलंबनम् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003620101, "chapter_id": 23620, "verse_number": "१-२-७-१०२", "content_sanskrit": "गणाधिपत्यमपि मे जातं परिभवास्पदम् ।\nविषदंता हि जायन्ते दुर्विनीतस्य सम्पदः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003620102, "chapter_id": 23620, "verse_number": "१-२-७-१०३", "content_sanskrit": "विदुरेष्यद्धियाऽपायं परतोऽन्ये विवेकिनः ।\nनैवोभयं विदुर्नीचा विनाऽनुभवमात्मनः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003620103, "chapter_id": 23620, "verse_number": "१-२-७-१०४", "content_sanskrit": "दुर्वीनीतः श्रियं प्राप्य विद्यामैश्वर्यमेव वा ।\nन तिष्ठति चिरं स्थाने यथाहं मदगर्वितः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003620104, "chapter_id": 23620, "verse_number": "१-२-७-१०५", "content_sanskrit": "विद्यामदो धनमदस्तृतीयोऽभिजनो मदः ।\nएते मदा मदांधानामेत एव सतां दमाः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003620105, "chapter_id": 23620, "verse_number": "१-२-७-१०६", "content_sanskrit": "नोदर्कशालिनी बुद्धिर्येषामविजितात्मनाम् ।\nतैः श्रियश्चपला वाच्यं नीयंते मादृशैर्जनैः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003620106, "chapter_id": 23620, "verse_number": "१-२-७-१०७", "content_sanskrit": "तत्प्रसीद मुनिश्रेष्ठ शापांतं मेऽधुना कुरु ।\nदुर्विनीतेष्वपि सदा क्षमाचारा हि साधवः ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003620107, "chapter_id": 23620, "verse_number": "१-२-७-१०८", "content_sanskrit": "इत्थं वचसि विज्ञप्ते विनीतेनापि वै मया ।\nप्रसादप्रवणो भूत्वा शापांतं मे तदा व्यधात् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003620108, "chapter_id": 23620, "verse_number": "१-२-७-१०९", "content_sanskrit": "गालव उवाच ।\nछन्नकीर्तिसमुद्धारसहायस्त्वं भविष्यसि ।\nयदेन्द्रद्युम्नभूपस्य तदा मोक्षमवाप्स्यसि ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003620109, "chapter_id": 23620, "verse_number": "१-२-७-११०", "content_sanskrit": "इत्यहं मुनिशापेन तदाप्रभृति पर्वते ।\nहिमाचले बको भूत्वा काश्यपेयो वसामि च ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003620110, "chapter_id": 23620, "verse_number": "१-२-७-१११", "content_sanskrit": "राज्यं चिरायुरिति मे घृतकम्बलस्य जातिस्मरत्वमधुनापि तथानु भावान् ।\nशापाद्बकत्वमभवन्मुनिगालवस्य तद्भद्र सर्वमुदितं भवताद्य पृष्टम् ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}]