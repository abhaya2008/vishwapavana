[{"id": 2184097, "chapter_id": 4908, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2184098, "chapter_id": 4908, "verse_number": "१", "content_sanskrit": "इमे जना नरश्रेष्ठ प्रशंसन्ति सदा भुवि ।\nधर्मस्य शीलमेवादौ ततो मे संशयो महान्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2184099, "chapter_id": 4908, "verse_number": "२", "content_sanskrit": "यदि तच्छक्यमस्माभिर्ज्ञातुं धर्मभृतांवर ।\nश्रोतुमिच्छामि तत् सर्वं यथैतदुपलभ्यते\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2184100, "chapter_id": 4908, "verse_number": "३", "content_sanskrit": "कथं नु प्राप्यते शीलं श्रोतुमिच्छामि भारत ।\nकिंलक्षणं च तत् प्रोक्तं ब्रूहि मे वदतांवर\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2184101, "chapter_id": 4908, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2184102, "chapter_id": 4908, "verse_number": "४", "content_sanskrit": "पुरा दुर्योधनेनेह धृतराष्ट्राय मानद ।\nआख्यातं तप्यमानेन श्रियं दृष्ट्वा तवागताम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2184103, "chapter_id": 4908, "verse_number": "५", "content_sanskrit": "इन्द्रप्रस्थे महाराज तव सभ्रातृकस्य ह ।\nसभायां चावहसनं तत् सर्वं शृणु भारत\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2184104, "chapter_id": 4908, "verse_number": "६", "content_sanskrit": "भवतस्तां सभां दृष्ट्वा समृद्धिं चाप्यनुत्तमाम् ।\nदुर्योधनस्तदासीनः सर्वं पित्रे न्यवेदयत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2184105, "chapter_id": 4908, "verse_number": "७", "content_sanskrit": "श्रुत्वा च धृतराष्ट्रोऽपि दुर्योधनवचस्तदा ।\nअब्रवीत् कर्णसहितं दुर्योधनमिदं वचः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2184106, "chapter_id": 4908, "verse_number": "८", "content_sanskrit": "किमर्थं तप्यसे पुत्र श्रोतुमिच्छामि तत्त्वतः ।\nश्रुत्वा त्वामनुनेष्यामि यदि सम्यग् भविष्यसि\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2184107, "chapter_id": 4908, "verse_number": "९", "content_sanskrit": "यथा त्वं महदैश्वर्यं प्राप्तः परपुरञ्जय ।\nकिङ्करा भ्रातरः सर्वे मित्राः सम्बन्धिनस्तथा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2184108, "chapter_id": 4908, "verse_number": "१०", "content_sanskrit": "आच्छादयसि प्रावारानश्नासि पिशितोदनम् ।\nआजानेया वहन्ति त्वां कस्माच्छोचसि पुत्रक\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2184109, "chapter_id": 4908, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2184110, "chapter_id": 4908, "verse_number": "११", "content_sanskrit": "दश तानि सहस्राणि स्नातकानां महात्मनाम् ।\nभुञ्जते रुग्मपात्रीषु युधिष्ठिरनिवेशने\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2184111, "chapter_id": 4908, "verse_number": "१२", "content_sanskrit": "दृष्ट्वा च तां सभां दिव्यां दिव्यपुष्पफलान्विताम् ।\nअश्वांस्तित्तिरिकल्माषान् रत्नानि विविधानि च\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2184112, "chapter_id": 4908, "verse_number": "१३", "content_sanskrit": "दृष्ट्वा तां पाण्डवेयानामृद्धिमिन्द्रोपमां शुभाम् ।\nअमित्राणां सुमहतीमनुशोचामि मानद\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2184113, "chapter_id": 4908, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2184114, "chapter_id": 4908, "verse_number": "१४", "content_sanskrit": "यदीच्छसि श्रियं तात यादृशी तां युधिष्ठिरे ।\nविशिष्टां वा नरव्याघ्र शीलवान् भव पुत्रक\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2184115, "chapter_id": 4908, "verse_number": "१५", "content_sanskrit": "शीलेन हि त्रयो लोकाः शक्या जेतुं न संशयः ।\nनहि किञ्चिदसाध्यं वै लोके शीलवतां भवेत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2184116, "chapter_id": 4908, "verse_number": "१६", "content_sanskrit": "एकरात्रेण मान्धाता त्र्यहेण जनमेजयः ।\nसप्तरात्रेण नाभागः पृथिवीं प्रतिपेदिवान्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2184117, "chapter_id": 4908, "verse_number": "१७", "content_sanskrit": "एते हि पार्थिवाः सर्वे शीलवन्तो दमान्विताः ।\nअतस्तेषां गुणक्रीता वसुधा स्वयमागमत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2184118, "chapter_id": 4908, "verse_number": "१८", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nनारदेन पुरा प्रोक्तं शीलमाश्रित्य भारत\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2184119, "chapter_id": 4908, "verse_number": "१९", "content_sanskrit": "प्रह्लादेन हृतं राज्यं महेन्द्रस्य महात्मनः ।\nशीलमाश्रित्य दैत्येन त्रैलोक्यं च वशीकृतम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2184120, "chapter_id": 4908, "verse_number": "२०", "content_sanskrit": "ततो बृहस्पतिं शक्रः प्राञ्जलिः समुपस्थितः ।\nउवाच च महाप्राज्ञः श्रेय इच्छामि वेदितुम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2184121, "chapter_id": 4908, "verse_number": "२१", "content_sanskrit": "ततो बृहस्पतिस्तस्मै ज्ञानं नैश्रेयसं परम् ।\nकथयामास भगवान् देवेन्द्राय कुरूद्वह\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2184122, "chapter_id": 4908, "verse_number": "२२", "content_sanskrit": "एतावच्छ्रेय इत्येव बृहस्पतिरभाषत ।\nइन्द्रस्तु भूयः पप्रच्छ क्व विशेषो भवेदिति\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2184123, "chapter_id": 4908, "verse_number": "", "content_sanskrit": "बृहस्पतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2184124, "chapter_id": 4908, "verse_number": "२३", "content_sanskrit": "विशेषोऽस्ति महांस्तात भार्गवस्य महात्मनः ।\nतत्रागमय भद्रं ते भूय एव पुरन्दर\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2184125, "chapter_id": 4908, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2184126, "chapter_id": 4908, "verse_number": "२४", "content_sanskrit": "आत्मनस्तु ततः श्रेयो भार्गवात् सुमहायशाः ।\nज्ञानमागमयत् प्रीत्या पुनः स परमद्युतिः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2184127, "chapter_id": 4908, "verse_number": "२५", "content_sanskrit": "तेनापि समनुज्ञातो भार्गवेण महात्मना ।\nश्रेयोऽस्तीति पुनर्भूयः शुक्रमाह शतक्रतुः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2184128, "chapter_id": 4908, "verse_number": "२६", "content_sanskrit": "भार्गवस्त्वाह धर्मज्ञः प्रह्लादस्य महात्मनः ।\nज्ञानमस्ति विशेषेण ततो हृष्टश्च सोऽभवत्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2184129, "chapter_id": 4908, "verse_number": "२७", "content_sanskrit": "स ततो ब्राह्मणो भूत्वा प्रह्लादं पाकशासनः ।\nसृत्वा प्रोवाच मेधावी श्रेय इच्छामि वेदितुम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2184130, "chapter_id": 4908, "verse_number": "२८", "content_sanskrit": "प्रह्लादस्त्वब्रवीद् विप्रं क्षणो नास्ति द्विजर्षभ ।\nत्रैलोक्यराज्ये सक्तस्य ततो नोपदिशामि ते\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2184131, "chapter_id": 4908, "verse_number": "२९", "content_sanskrit": "ब्राह्मणस्त्वब्रवीद् वाक्यं कस्मिन् काले क्षणो भवेत् ।\nततोपदिष्टमिच्छामि यद्यत् कार्यान्तरं भवेत्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2184132, "chapter_id": 4908, "verse_number": "३०", "content_sanskrit": "ततः प्रीतोऽभवद् राजा प्रह्लादो ब्रह्मवादिने ।\nतथेत्युक्त्वा शुभे काले ज्ञानतत्त्वं ददौ तदा\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2184133, "chapter_id": 4908, "verse_number": "३१", "content_sanskrit": "ब्राह्मणोऽपि यथान्यायं गुरुवृत्तिमनुत्तमाम् ।\nचकार सर्वभावेन यद्वत् स मनसेच्छति\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2184134, "chapter_id": 4908, "verse_number": "३२", "content_sanskrit": "पृष्टश्च तेन बहुशः प्राप्तं कथमरिन्दम ।\nत्रैलोक्यराज्यं धर्मज्ञ कारणं तद् ब्रवीहि मे\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2184135, "chapter_id": 4908, "verse_number": "", "content_sanskrit": "प्रह्लादः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2184136, "chapter_id": 4908, "verse_number": "३३", "content_sanskrit": "नासूयामि द्विजश्रेष्ठ राजास्मीति कदाचन ।\nकाम्यानि वदतां तात संयच्छामि वहामि च\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2184137, "chapter_id": 4908, "verse_number": "३४", "content_sanskrit": "ते विस्रब्धाः प्रभाषन्ते संयच्छन्ति च मां सदा ।\nतेषु कार्यपथे सक्तं शुश्रूषुमनसूयकम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2184138, "chapter_id": 4908, "verse_number": "३५", "content_sanskrit": "धर्मात्मानं जितक्रोधं संयतं संयतेन्द्रियम् ।\nसमाचिन्वन्ति शास्तारः क्षौद्रं मध्विव मक्षिकाः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2184139, "chapter_id": 4908, "verse_number": "३६", "content_sanskrit": "सोऽहं वाचा प्रहृष्टानां रसानामवलेहिता ।\nस्वजात्यानधितिष्ठामि नक्षत्राणीव चन्द्रमाः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2184140, "chapter_id": 4908, "verse_number": "३७", "content_sanskrit": "एतत् पृथिव्याममृतमेतच्चक्षुरनुत्तमम् ।\nयद् ब्राह्मणमुखे कव्यमेतच्छ्रुत्वा प्रवर्तते\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2184141, "chapter_id": 4908, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2184142, "chapter_id": 4908, "verse_number": "३८", "content_sanskrit": "एतावच्छ्रेय इत्याह प्रह्लादो ब्रह्मवादिनम् ।\nशुश्रूषितस्तेन तदा दैत्येन्द्रो वाक्यमब्रवीत्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2184143, "chapter_id": 4908, "verse_number": "३९", "content_sanskrit": "यथावद् गुरुवृत्त्या ते प्रीतोऽस्मि द्विजसत्तम ।\nवरं वृणीष्व भद्रं ते प्रदातास्मि न संशयः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2184144, "chapter_id": 4908, "verse_number": "४०", "content_sanskrit": "कृतमित्येव दैत्येन्द्रमुवाच स च वै द्विजः ।\nप्रह्लादस्त्वब्रवीत् प्रीतो गृह्यतां वरमित्युत\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2184145, "chapter_id": 4908, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2184146, "chapter_id": 4908, "verse_number": "४१", "content_sanskrit": "यदि राजन् प्रसन्नस्त्वं मम चेच्छसि चेद्धितम् ।\nभवतः शीलमिच्छामि प्राप्तुमेष वरो मम\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2184147, "chapter_id": 4908, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2184148, "chapter_id": 4908, "verse_number": "४२", "content_sanskrit": "ततः प्रीतश्च दैत्येन्द्रो भयं चास्याभवन्महत् ।\nवरे प्रदिष्टे विप्रेण नाल्पतेजायमित्युत\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2184149, "chapter_id": 4908, "verse_number": "४३", "content_sanskrit": "एवमस्त्विति तं प्राह प्रह्रादो विस्मितस्तदा ।\nउपाकृत्य तु विप्राय वरं दुःखान्वितोऽभवत्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2184150, "chapter_id": 4908, "verse_number": "४४", "content_sanskrit": "दत्ते वरे गते विप्रे चिन्ताऽऽसीन्महती ततः ।\nप्रह्लादस्य महाराज निश्चयं नच जग्मिवान्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2184151, "chapter_id": 4908, "verse_number": "४५", "content_sanskrit": "तस्य चिन्तयतस्तात छायाभूतं महाद्युते ।\nतेजो विग्रहवत् तात शरीरमजहात् तदा\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2184152, "chapter_id": 4908, "verse_number": "४६", "content_sanskrit": "तमपृच्छन्महाकायं प्रह्लादः को भवानिति ।\nप्रत्याह ननु शीलोऽस्मि त्यक्तो गच्छाम्यहं त्वया\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2184153, "chapter_id": 4908, "verse_number": "४७", "content_sanskrit": "तस्मिन् द्विजवरे राजन् वत्स्याम्यहमनिन्दितम् ।\nयोऽसौ शिष्यत्वमागम्य त्वयि नित्यं समाहितः ।\nइत्युक्त्वाऽन्तर्हितं तद् वै शक्रं चान्वविशत् प्रभो\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2184154, "chapter_id": 4908, "verse_number": "४८", "content_sanskrit": "तस्मिंस्तेजसि याते तु तादृग्रूपस्ततोऽपरः ।\nशरीरान्निःसृतस्तस्य को भवानिति चाब्रवीत्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2184155, "chapter_id": 4908, "verse_number": "४९", "content_sanskrit": "धर्मं प्रह्लाद मां विद्धि यत्रासौ द्विजसत्तमः ।\nतत्र यास्यामि दैत्येन्द्र यतः शीलं ततो ह्यहम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2184156, "chapter_id": 4908, "verse_number": "५०", "content_sanskrit": "ततोऽपरो महाराज प्रज्वलन्निव तेजसा ।\nशरीरान्निःसृतस्तस्य प्रह्लादस्य महात्मनः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2184157, "chapter_id": 4908, "verse_number": "५१", "content_sanskrit": "को भवानिति पृष्टश्च तमाह स महाद्युतिः ।\nसत्यमस्म्यसुरेन्द्राग्र्य यास्येऽहं धर्ममन्विह\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2184158, "chapter_id": 4908, "verse_number": "५२", "content_sanskrit": "तस्मिन्ननुगते धर्मं पुरुषे पुरुषोऽपरः ।\nनिश्चक्राम ततस्तस्मात् पृष्टश्चाह महात्मना ।\nवृत्तं प्रह्लाद मां विद्धि यतः सत्यं ततो ह्यहम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2184159, "chapter_id": 4908, "verse_number": "५३", "content_sanskrit": "तस्मिन् गते महाश्वेतः शरीरात् तस्य निर्ययौ ।\nपृष्टश्चाह बलं विद्धि यतो वृत्तमहं ततः ।\nइत्युक्त्वा च ययौ तत्र यतो वृत्तं नराधिप\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2184160, "chapter_id": 4908, "verse_number": "५४", "content_sanskrit": "ततः प्रभामयी देवी शरीरात् तस्य निर्ययौ ।\nतामपृच्छत् स दैत्येन्द्रः सा श्रीरित्येवमब्रवीत्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2184161, "chapter_id": 4908, "verse_number": "५५", "content_sanskrit": "उषितास्मि सुखं वीर त्वयि सत्यपराक्रमे ।\nत्वया त्यक्ता गमिष्यामि बलं यत्र ततो ह्यहम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2184162, "chapter_id": 4908, "verse_number": "५६", "content_sanskrit": "ततो भयं प्रादुरासीत् प्रह्लादस्य महात्मनः ।\nअपृच्छत च तां भूयः क्व यासि कमलालये\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2184163, "chapter_id": 4908, "verse_number": "५७", "content_sanskrit": "त्वं हि सत्यव्रता देवी लोकस्य परमेश्वरी ।\nकश्चासौ ब्राह्मणश्रेष्ठस्तत्त्वमिच्छामि वेदितुम्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2184164, "chapter_id": 4908, "verse_number": "", "content_sanskrit": "श्रीः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2184165, "chapter_id": 4908, "verse_number": "५८", "content_sanskrit": "स शक्रो ब्रह्मचारी च यस्त्वया चोपशिक्षितः ।\nत्रैलोक्ये तु यदैश्वर्यं तत् तेनापहृतं प्रभो\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2184166, "chapter_id": 4908, "verse_number": "५९", "content_sanskrit": "शीलेन हि त्वया लोकाः सर्वे धर्मज्ञ निर्जिताः ।\nतद् विज्ञाय महेन्द्रेण तव शीलं हृतं प्रभो\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2184167, "chapter_id": 4908, "verse_number": "६०", "content_sanskrit": "धर्मः सत्यं तथा वृत्तं बलं चैव तथा ह्यहम् ।\nशीलमूला महाप्राज्ञ सदा नास्त्यत्र संशयः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2184168, "chapter_id": 4908, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2184169, "chapter_id": 4908, "verse_number": "६१", "content_sanskrit": "एवमुक्त्वा गता तु श्रीस्ते च सर्वे युधिष्ठिर ।\nदुर्योधनस्तु पितरं भूय एवाब्रवीदिदम्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2184170, "chapter_id": 4908, "verse_number": "६२", "content_sanskrit": "शीलस्य तत्त्वमिच्छामि वेत्तुं कौरवनन्दन ।\nप्राप्यते च यथा शीलं तमुपायं वदस्व मे\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2184171, "chapter_id": 4908, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2184172, "chapter_id": 4908, "verse_number": "६३", "content_sanskrit": "सोपायं पूर्वमुद्दिष्टं प्रह्लादेन महात्मना ।\nसङ्क्षेपतस्तु शीलस्य शृणु प्राप्तिं नराधिप\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2184173, "chapter_id": 4908, "verse_number": "६४", "content_sanskrit": "अद्रोहः सर्वभूतेषु कर्मणा मनसा गिरा ।\nअनुग्रहश्च दानं च शीलमेतत् प्रशस्यते\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2184174, "chapter_id": 4908, "verse_number": "६५", "content_sanskrit": "यदन्येषां हितं न स्यादात्मनः कर्म पौरुषम् ।\nअपत्रपेत वा येन न तत् कुर्यात् कथञ्चन\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2184175, "chapter_id": 4908, "verse_number": "६६", "content_sanskrit": "तत्तु कर्म तथा कुर्याद् येन श्लाघेत संसदि ।\nएतच्छीलं समासेन कथितं कुरुसत्तम\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2184176, "chapter_id": 4908, "verse_number": "६७", "content_sanskrit": "यद्यप्यशीला नृपते प्राप्नुवन्ति क्वचिच्छ्रियम् ।\nन भुञ्जते चिरं तात समूलाश्च पतन्ति ते\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2184177, "chapter_id": 4908, "verse_number": "६८", "content_sanskrit": "एतद् विदित्वा तत्त्वेन शीलवान् भव पुत्रक ।\nयदीच्छसि श्रियं तात सुविशिष्टां युधिष्ठिरात्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2184178, "chapter_id": 4908, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2184179, "chapter_id": 4908, "verse_number": "६९", "content_sanskrit": "एतत् कथितवान् पुत्रे धृतराष्ट्रो नराधिप ।\nएतत् कुरुष्व कौन्तेय ततः प्राप्स्यसि तत्फलम्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2184180, "chapter_id": 4908, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे पञ्चविंशाधिकशततमोध्यायः ॥ १२५ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}]