[{"id": 6000018000, "chapter_id": 10018, "verse_number": null, "content_sanskrit": "अथ अष्‍टादशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000018001, "chapter_id": 10018, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.001.m4a", "display_order": 2}, {"id": 6000018002, "chapter_id": 10018, "verse_number": "१-१८-१", "content_sanskrit": "यौ वै द्रौण्यस्‍त्रविप्लुष्‍टो न मातुरुदरे मृतः।\nअनुग्रहाद्भगवतः कृष्णस्याद्भुतकर्मणः॥ १/१८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.002.m4a", "display_order": 3, "topics": [{"text": "एकदा मृगयार्थं वनं गतेन क्षुत्पिपासार्दितेन परीक्षिता शमीकमुनेराश्रमं प्रविश्य पानीययाचनेऽपि मुनेः समाधिस्थतया तस्माद् जलम् अलभमानेन कोपात्तदंसे मृतसर्पनिक्षेपपूर्वकं स्वपुरगमनम्", "range": "१–३०"}]}, {"id": 6000018003, "chapter_id": 10018, "verse_number": "१-१८-२", "content_sanskrit": "ब्रह्मशापोत्थिताद्यस्तु तक्षकात्प्राणविप्लवे।\nन सम्मुमोहोरुभयाद्भगवत्यर्पिताशयः॥ १/१८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.003.m4a", "display_order": 4}, {"id": 6000018004, "chapter_id": 10018, "verse_number": "१-१८-३", "content_sanskrit": "उत्सृज्य सर्वतः सङ्गं विज्ञानार्जितसंस्थितिः।\nवैयासकेर्जहौ शिष्यो गङ्गायां स्वकलेवरम्॥ १/१८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.004.m4a", "display_order": 5}, {"id": 6000018005, "chapter_id": 10018, "verse_number": "१-१८-४", "content_sanskrit": "नोत्तमश्लोकवार्तानां जुषतां तत्कथामृतम्।\nस्यात्सम्भ्रमोऽन्तकालेऽपि स्मरतां तत्पदाम्बुजम्॥ १/१८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.005.m4a", "display_order": 6}, {"id": 6000018006, "chapter_id": 10018, "verse_number": "१-१८-५", "content_sanskrit": "तावत्कलिर्न प्रभवेत्प्रविष्‍टोऽपीह सर्वतः।\nयावदीशो महानुर्व्यामाभिमन्यव एकराट्॥ १/१८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.006.m4a", "display_order": 7}, {"id": 6000018007, "chapter_id": 10018, "verse_number": "१-१८-६", "content_sanskrit": "यस्मिन्नहनि यर्ह्येव भगवानुत्ससर्ज गाम्।\nतदैवेहानुवृत्तोऽसावधर्मप्रभवः कलिः॥ १/१८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.007.m4a", "display_order": 8}, {"id": 6000018008, "chapter_id": 10018, "verse_number": "१-१८-७", "content_sanskrit": "नानुद्वेष्‍टि कलिं सम्राट् सारङ्ग इव सारभुक्।\nकुशलान्याशु सिध्यन्ति नेतराणि कृतानि यत्॥ १/१८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.008.m4a", "display_order": 9}, {"id": 6000018009, "chapter_id": 10018, "verse_number": "१-१८-८", "content_sanskrit": "किन्तु बालेषु शूरेण कलिना शूरभीरुणा।\nअप्रमत्तः प्रमत्तेषु यो वृको नृषु वर्तते॥ १/१८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.009.m4a", "display_order": 10}, {"id": 6000018010, "chapter_id": 10018, "verse_number": "१-१८-९", "content_sanskrit": "उपवर्णितमेतद्वः पुण्यं पारीक्षितं मया।\nवासुदेवकथोपेतम् आख्यानं यदपृच्छथ॥ १/१८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.010.m4a", "display_order": 11}, {"id": 6000018011, "chapter_id": 10018, "verse_number": "१-१८-१०", "content_sanskrit": "या याः कथा भगवतः कथनीयोरुकर्मणः।\nगुणकर्माश्रया पुम्भिः सेव्यास्तास्ता बुभूषुभिः॥ १/१८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.011.m4a", "display_order": 12}, {"id": 6000018012, "chapter_id": 10018, "verse_number": null, "content_sanskrit": "ऋषय ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.012.m4a", "display_order": 13}, {"id": 6000018013, "chapter_id": 10018, "verse_number": "१-१८-११", "content_sanskrit": "सूत जीव समाः सौम्य शाश्‍वतीर्विशदं यशः।\nयस्त्वं शंसति कृष्णस्य मर्त्यानाममृतं हि नः॥ १/१८/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.013.m4a", "display_order": 14}, {"id": 6000018014, "chapter_id": 10018, "verse_number": "१-१८-१२", "content_sanskrit": "कर्मण्यस्मिन्ननाश्‍वास्ये धूमधूम्रात्मनां भवान्।\nआपाययति गोविन्दपादपद्मासवं मधु॥ १/१८/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.014.m4a", "display_order": 15}, {"id": 6000018015, "chapter_id": 10018, "verse_number": "१-१८-१३", "content_sanskrit": "तुलयाम लवेनापि न स्वर्गं नापुनर्भवम्।\nभगवत्सङ्गिसङ्गस्य मर्त्यानां किमुताशिषः॥ १/१८/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.015.m4a", "display_order": 16}, {"id": 6000018016, "chapter_id": 10018, "verse_number": "१-१८-१४", "content_sanskrit": "को नाम तृप्येद्रसवित् कथायां महत्तमैकान्तपरायणस्य।\nनान्तं गुणानामगुणस्य जग्मुर्योगेश्‍वरा ये भवपाद्ममुख्याः॥ १/१८/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.016.m4a", "display_order": 17}, {"id": 6000018017, "chapter_id": 10018, "verse_number": "१-१८-१५", "content_sanskrit": "ततो भवान्वै भगवत्प्रधानो महत्तमैकान्तपरायणस्य।\nहरेरुदारं चरितं विशुद्धं शुश्रूषतां नो वितनोतु विद्वन्॥ १/१८/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.017.m4a", "display_order": 18}, {"id": 6000018018, "chapter_id": 10018, "verse_number": "१-१८-१६", "content_sanskrit": "तन्नः परं पुण्यमसंवृतार्थमाख्यानमत्यद्भुतयोगनिष्‍ठम्।\nआख्याह्यनन्ताचरितोपपन्नं पारीक्षितं भागवताभिरामम्॥ १/१८/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.018.m4a", "display_order": 19}, {"id": 6000018019, "chapter_id": 10018, "verse_number": "१-१८-१७", "content_sanskrit": "स वै महाभागवतः परीक्षित् येनापवर्गाख्यमदभ्रबुद्धिः।\nज्ञानेन वैयासकिशब्दितेन भेजे खगेन्द्रध्वजपादमूलम्॥ १/१८/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.019.m4a", "display_order": 20}, {"id": 6000018020, "chapter_id": 10018, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.020.m4a", "display_order": 21}, {"id": 6000018021, "chapter_id": 10018, "verse_number": "१-१८-१८", "content_sanskrit": "अहो वयं जन्मभृतो महात्मन् वृद्धानुवृत्त्याऽपि विलोमजाताः।\nदौष्कुल्यमाधिं विधुनोति शीघ्रं महत्तमानामभिधानयोगः॥ १/१८/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.021.m4a", "display_order": 22}, {"id": 6000018022, "chapter_id": 10018, "verse_number": "१-१८-१९", "content_sanskrit": "कुतः पुनर्गुणतो नाम तस्य महत्तमैकान्तपरायणस्य।\nयोऽनन्तशक्‍तिर्भगवाननन्तो महद्गुणत्वाद्यमनन्तमाहुः॥ १/१८/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.022.m4a", "display_order": 23}, {"id": 6000018023, "chapter_id": 10018, "verse_number": "१-१८-२०", "content_sanskrit": "एतावताऽलं ननु सूचितेन गुणैरसाम्येऽनतिशायनेऽस्य।\nहित्वेतरान्प्रार्थयतो विभूतिर्यस्याङ्घ्रिरेणुं जुषतेऽनभीप्सोः॥ १/१८/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.023.m4a", "display_order": 24}, {"id": 6000018024, "chapter_id": 10018, "verse_number": "१-१८-२१", "content_sanskrit": "अथापि यत्पादनखावसृष्‍टं जगद्विरिञ्चोपहृतार्हणाम्भः।\nसेशं पुनात्यन्यतमो मुकुन्दात्को नाम लोके भगवत्पदार्थः॥ १/१८/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.024.m4a", "display_order": 25}, {"id": 6000018025, "chapter_id": 10018, "verse_number": "१-१८-२२", "content_sanskrit": "यत्रानुरक्‍ताः सहसैव धीरा व्यपोह्य देहादिषु सङ्गमूढम्।\nव्रजन्ति तत्पारमहंस्यसत्यं यस्मिन्नहिंसोपरमश्‍च धर्मः॥ १/१८/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.025.m4a", "display_order": 26}, {"id": 6000018026, "chapter_id": 10018, "verse_number": "१-१८-२३", "content_sanskrit": "अहं हि पृष्‍टोऽस्य गुणान्भवद्भिराचक्ष आत्मावगमोऽत्र यावान्।\nनभः पतन्त्यात्मसमं पतत्रिणस्तथा समं विष्णुगतिं विपश्‍चितः॥ १/१८/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.026.m4a", "display_order": 27}, {"id": 6000018027, "chapter_id": 10018, "verse_number": "१-१८-२४", "content_sanskrit": "एकदा धनुरुद्यम्य विचरन्मृगयां वने।\nमृगाननुगतः श्रान्तः क्षुधितस्तृषितो भृशम्॥ १/१८/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.027.m4a", "display_order": 28}, {"id": 6000018028, "chapter_id": 10018, "verse_number": "१-१८-२५", "content_sanskrit": "जलाशयमचक्षाणः प्रविवेश स आश्रमम्।\nददर्श मुनिमासीनं शान्तं मीलितलोचनम्॥ १/१८/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.028.m4a", "display_order": 29}, {"id": 6000018029, "chapter_id": 10018, "verse_number": "१-१८-२६", "content_sanskrit": "प्रतिरुद्धेन्द्रियप्राणमनोबुद्धिमुपारतम्।\nस्थानत्रयात्परं प्राप्‍तं ब्रह्मभूतमविक्रियम्॥ १/१८/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.029.m4a", "display_order": 30}, {"id": 6000018030, "chapter_id": 10018, "verse_number": "१-१८-२७", "content_sanskrit": "विप्रकीर्णजटाछन्नं रौरवेणाजिनेन च।\nविशुष्यत्तालुरुदकं तथाभूतमयाचत॥ १/१८/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.030.m4a", "display_order": 31}, {"id": 6000018031, "chapter_id": 10018, "verse_number": "१-१८-२८", "content_sanskrit": "अलब्धतृणभूम्यादिरसंप्राप्‍तार्घ्यसूनृतः।\nअवज्ञातमिवाऽत्मानं मन्यमानश्‍चुकोप ह॥ १/१८/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.031.m4a", "display_order": 32}, {"id": 6000018032, "chapter_id": 10018, "verse_number": "१-१८-२९", "content_sanskrit": "अभूतपूर्वः सहसा क्षुत्तृड्भ्यामर्दितात्मनः।\nब्राह्मणं प्रत्यभूद्ब्रह्मन्मत्सरो मन्युरेव च॥ १/१८/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.032.m4a", "display_order": 33}, {"id": 6000018033, "chapter_id": 10018, "verse_number": "१-१८-३०", "content_sanskrit": "स तु ब्रह्मऋषेरंसे गतासुमुरगं रुषा।\nविनिर्गच्छन्धनुष्कोट्या निधाय पुरमागमत्॥ १/१८/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.033.m4a", "display_order": 34}, {"id": 6000018034, "chapter_id": 10018, "verse_number": "१-१८-३१", "content_sanskrit": "एष किं निभृताशेषकरणो मीलितेक्षणः।\nमुधा समाधिराहोस्वित् किन्नः स्यात्क्षत्रबन्धुभिः॥ १/१८/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.034.m4a", "display_order": 35, "topics": [{"text": "तच्छ्रवणरुष्‍टेन मुनिसुतेन परीक्षिते तत्सप्‍तमेऽहनि तक्षकदंशनप्रकारकशापदानम्", "range": "३१–३७"}]}, {"id": 6000018035, "chapter_id": 10018, "verse_number": "१-१८-३२", "content_sanskrit": "तस्य पुत्रोऽतितेजस्वी विहरन्बालकोऽर्भकैः।\nराज्ञाऽघं प्रापितं तातं श्रुत्वा तत्रेदमब्रवीत्॥ १/१८/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.035.m4a", "display_order": 36}, {"id": 6000018036, "chapter_id": 10018, "verse_number": "१-१८-३३", "content_sanskrit": "अहो अधर्मः पालानां पृथ्व्या बलिभुजामिव।\nस्वामिन्यघं यद्दासानां द्वारपानां शुनामिव॥ १/१८/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.036.m4a", "display_order": 37}, {"id": 6000018037, "chapter_id": 10018, "verse_number": "१-१८-३४", "content_sanskrit": "ब्राह्मणैः क्षत्रबन्धुर्हि द्वारपालो निरूपितः।\nस कथं तद्गृहे द्वाःस्थः सभाण्डं भोक्‍तुमर्हसि॥ १/१८/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.037.m4a", "display_order": 38}, {"id": 6000018038, "chapter_id": 10018, "verse_number": "१-१८-३५", "content_sanskrit": "कृष्णे गते भगवति शास्तर्युत्पथगामिनाम्।\nतान् भिन्नसेतूनद्याहं शास्मि पश्यत मे बलम्॥ १/१८/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.038.m4a", "display_order": 39}, {"id": 6000018039, "chapter_id": 10018, "verse_number": "१-१८-३६", "content_sanskrit": "इत्युक्‍त्वा रोषताम्राक्षो वयस्यान् ऋषिबालकान्।\nकौशिक्यप उपस्पृश्य वाग्वज्रं विससर्ज ह॥ १/१८/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.039.m4a", "display_order": 40}, {"id": 6000018040, "chapter_id": 10018, "verse_number": "१-१८-३७", "content_sanskrit": "इतो लङ्घितमर्यादं तक्षकः सप्‍तमेऽहनि।\nधक्ष्यति स्म कुलाङ्गारं चोदितो मे पितृद्रुहम्॥ १/१८/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.040.m4a", "display_order": 41}, {"id": 6000018041, "chapter_id": 10018, "verse_number": "१-१८-३८", "content_sanskrit": "ततोऽभ्येत्याश्रमं बालो गले सर्पकलेवरम्।\nपितरं वीक्ष्य दुःखार्तो मुक्‍तकण्ठो रुरोद ह॥ १/१८/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.041.m4a", "display_order": 42, "topics": [{"text": "समाध्युपरतेन मुनिना स्वपुत्रदत्तशापं ज्ञात्वाऽनुतापाधिगमः", "range": "३८–५०"}]}, {"id": 6000018042, "chapter_id": 10018, "verse_number": "१-१८-३९", "content_sanskrit": "स वा आङ्गिरसो ब्रह्मन्श्रुत्वा सुतविलापितम्।\nउन्मील्य शनकैर्नेत्रे दृष्‍ट्वा चांसे मृतोरगम्॥ १/१८/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.042.m4a", "display_order": 43}, {"id": 6000018043, "chapter_id": 10018, "verse_number": "१-१८-४०", "content_sanskrit": "विसृज्य पुत्रं पप्रच्छ वत्स कस्माद्विरोदिषि।\nकेन वा ते विप्रकृतमित्युक्‍तः स न्यवेदयत्॥ १/१८/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.043.m4a", "display_order": 44}, {"id": 6000018044, "chapter_id": 10018, "verse_number": "१-१८-४१", "content_sanskrit": "निशम्य शप्‍तमतदर्हं नरेन्द्रं स ब्राह्मणो नात्मजमभ्यनन्दत्।\nअहो बतांहो महदज्ञ ते कृतमल्पीयसि द्रोह उरुश्रमो धृतः॥ १/१८/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.044.m4a", "display_order": 45}, {"id": 6000018045, "chapter_id": 10018, "verse_number": "१-१८-४२", "content_sanskrit": "न वै नृभिर्नरदेवोऽपराध्यः तं शप्‍तुमर्हस्यविपक्‍वबुद्धे।\nयत्तेजसा दुर्विषहेण गुप्‍ता विन्दन्ति भद्राण्यकुतोभयाः प्रजाः॥ १/१८/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.045.m4a", "display_order": 46}, {"id": 6000018046, "chapter_id": 10018, "verse_number": "१-१८-४३", "content_sanskrit": "अरक्ष्यमाणे नरदेवनाम्नि रथाङ्गपाणावयमङ्ग लोकः।\nतदा हि चोरप्रचुरो विनङ्क्षत्यरक्ष्यमाणो विवरूथवत्क्षणात्॥ १/१८/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.046.m4a", "display_order": 47}, {"id": 6000018047, "chapter_id": 10018, "verse_number": "१-१८-४४", "content_sanskrit": "तदद्य नः पापमुपैत्यनन्वयं यन्नष्‍टनाथस्य पशोर्विलुम्पकाः।\nपरस्परं घ्नन्ति शपन्ति वृञ्जते पशून् स्‍त्रियोऽर्थान्पुरुदस्यवो जनाः॥ १/१८/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.047.m4a", "display_order": 48}, {"id": 6000018048, "chapter_id": 10018, "verse_number": "१-१८-४५", "content_sanskrit": "तदार्यधर्मश्‍च विलीयते नृणां वर्णाश्रमाचारयुतस्‍त्रयीमयः।\nततोऽर्थकामाभिनिवेशितात्मनां शुनां कपीनामिव वर्णसङ्करः॥ १/१८/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.048.m4a", "display_order": 49}, {"id": 6000018049, "chapter_id": 10018, "verse_number": "१-१८-४६", "content_sanskrit": "धर्मपालो नरपतिः स तु सम्राट् बृहच्छ्रवाः। साक्षान्महाभागवतो राजर्षिर्हयमेधयाट्।\nक्षुत्तृट्च्छ्रमान्वितो दीनो नैवास्मच्छापमर्हति॥ १/१८/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.049.m4a", "display_order": 50}, {"id": 6000018050, "chapter_id": 10018, "verse_number": "१-१८-४७", "content_sanskrit": "अपापेषु स्वभृत्येषु बालेनापक्‍वबुद्धिना।\nपापं कृतं तद्भगवान्सर्वात्मा क्षन्तुमर्हति॥ १/१८/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.050.m4a", "display_order": 51}, {"id": 6000018051, "chapter_id": 10018, "verse_number": "१-१८-४८", "content_sanskrit": "तिरस्कृता विप्रलब्धाः शप्‍ताः क्षिप्‍ता हता अपि।\nनास्य तत्प्रतिकुर्वन्ति तद्भक्‍ताः प्रभवोऽपि हि॥ १/१८/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.051.m4a", "display_order": 52}, {"id": 6000018052, "chapter_id": 10018, "verse_number": "१-१८-४९", "content_sanskrit": "इति पुत्रकृताघेन सोऽनुतप्‍तो महामुनिः।\nस्वयं विप्रकृतो राज्ञा नैवाघं तदचिन्तयत्॥ १/१८/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.052.m4a", "display_order": 53}, {"id": 6000018053, "chapter_id": 10018, "verse_number": "१-१८-५०", "content_sanskrit": "साधवः प्रायशो लोके परैर्द्वन्द्वेषु योजिताः।\nन व्यथन्ति न हृष्यन्ति यत आत्माऽगुणाश्रयः॥ १/१८/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_018/BhP_01.018.053.m4a", "display_order": 54}, {"id": 6000018054, "chapter_id": 10018, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां प्रथमस्कन्धे अष्‍टादशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]