[{"id": 7001639000, "chapter_id": 21639, "verse_number": "१-२५-१", "content_sanskrit": "सनक उवाच ।\nवर्णाश्रमाचारविधिं प्रवक्ष्यामि विशेषतः ।\nश्रृणुष्व तन्मुनिश्रेष्ट सावधानेन चेतसा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001639001, "chapter_id": 21639, "verse_number": "१-२५-२", "content_sanskrit": "यः स्वधर्मं परित्यज्य परधर्मं समाचरेत् ।\nपाषंडः स हि विज्ञेयः सर्वधर्मबहिष्कृतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001639002, "chapter_id": 21639, "verse_number": "१-२५-३", "content_sanskrit": "गर्भाधानादिसंस्काराः कार्या मंत्रविधानतः ।\nस्त्रीणाममंत्रतः कार्या यथाकालं यथाविधि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001639003, "chapter_id": 21639, "verse_number": "१-२५-४", "content_sanskrit": "सीमंतकर्म प्रथमं चतुर्थे मासि शस्यते ।\nषष्टे वा सत्पमे वापि अष्टमे वापि कारयेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001639004, "chapter_id": 21639, "verse_number": "१-२५-५", "content_sanskrit": "जाते पुत्रे पिता स्नात्वा सचैलं जातकर्म च ।\nकुर्य्याच्च नांदीश्राद्धं च स्वस्तिवाचनपूर्वकम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001639005, "chapter_id": 21639, "verse_number": "१-२५-६", "content_sanskrit": "हेम्ना वा रजतेनापि वृद्धिश्राद्धं प्रकल्पयेत् ।\nअन्नेन कारयेद्यस्तु स चंडाल समो भवेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001639006, "chapter_id": 21639, "verse_number": "१-२५-७", "content_sanskrit": "कृत्वाभ्युदयिकं श्राद्धं पिता पुत्रस्य वाग्यतः ।\nकुर्वीत नामनिर्द्देशं सूतकांते यथाविधि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001639007, "chapter_id": 21639, "verse_number": "१-२५-८", "content_sanskrit": "अस्पष्टमर्थहीनं च ह्यतिगुर्वक्षरान्वितम् ।\nन दद्यान्नाम विप्रेन्द तथा च विषमाक्षरम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001639008, "chapter_id": 21639, "verse_number": "१-२५-९", "content_sanskrit": "तृतीयवर्षे चौलं च पंचमे षष्टसम्मिते ।\nसत्पमे चाष्टमे वापि कुर्याद् गृह्योक्तमार्गतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001639009, "chapter_id": 21639, "verse_number": "१-२५-१०", "content_sanskrit": "दैवयोगादतिक्रांते गर्भाधानादिकर्मणि ।\nकर्तव्यः पादकृच्छ्रो वै चौले त्वर्द्धं प्रकल्पयेत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001639010, "chapter_id": 21639, "verse_number": "१-२५-११", "content_sanskrit": "गर्भाष्टमेऽष्टमे वाब्दे बटुकस्योपनायनम् ।\nआषोडशाब्दपर्यंतं गौणं कालमुशंति च ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001639011, "chapter_id": 21639, "verse_number": "१-२५-१२", "content_sanskrit": "गर्भैकादशमेऽब्दे तु राजन्यस्योपनायनम् ।\nआद्वाविंशाब्दपर्यंतं कालमाहुर्विपश्चितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001639012, "chapter_id": 21639, "verse_number": "१-२५-१३", "content_sanskrit": "वैश्वोपनयनं प्रोक्तं गर्भाद्द्वादशमे तथा ।\nचतुर्विंशाब्दपर्यंतं गौणमाहुर्मनीषिणः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001639013, "chapter_id": 21639, "verse_number": "१-२५-१४", "content_sanskrit": "एतत्कालावधेर्यस्य द्विजस्यातिक्रमो भवेत् ।\nसावित्रीपतितं विद्यात्तं तु नैवालपेत्कदा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001639014, "chapter_id": 21639, "verse_number": "१-२५-१५", "content_sanskrit": "द्विजोपनयने विप्र मुख्यकालव्यतिक्रमे ।\nद्वादशाब्दं चरेत्कृच्छ्रं पश्चाज्चांद्रायणं तथा ।\nसांतपनद्वयं चैव कृत्वा कर्म समाचरेत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001639015, "chapter_id": 21639, "verse_number": "१-२५-१६", "content_sanskrit": "अन्यथा पतितं विद्यात्कर्त्तापि ब्रह्महा भवेत् ।\nर्मौजी विप्रस्य विज्ञेया धनुर्ज्या क्षत्त्रियस्य तु ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001639016, "chapter_id": 21639, "verse_number": "१-२५-१७", "content_sanskrit": "आवी वैश्यस्य विज्ञेया श्रूयतामजिने तथा ।\nविप्रस्य चोक्तमैणेयं रौरवं क्षत्रियस्य तु ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001639017, "chapter_id": 21639, "verse_number": "१-२५-१८", "content_sanskrit": "आजं वेश्यस्य विज्ञेयं दंडान्वक्ष्ये यथाक्रमम् ।\nपालाशं ब्राह्मणस्योक्तं नृपस्यौदुम्बरं तथा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001639018, "chapter_id": 21639, "verse_number": "१-२५-१९", "content_sanskrit": "बैल्वं वैश्यस्य विज्ञेय तत्प्रमाणं श्रृणुष्व मे ।\nविप्रस्य केशमानं स्यादाललाटं नृपस्य च ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001639019, "chapter_id": 21639, "verse_number": "१-२५-२०", "content_sanskrit": "नासाग्रसंमितं दण्डं वैश्यस्याहुर्विपश्चितः ।\nतथा वासांसि वक्ष्यामि विप्रादीनां यथाक्रमम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001639020, "chapter_id": 21639, "verse_number": "१-२५-२१", "content_sanskrit": "कषायं चैव मांजिष्टं हारिद्रं च प्रकीर्तितम् ।\nउपनीतो द्विजो विप्र परिचर्यापरो गुरोः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001639021, "chapter_id": 21639, "verse_number": "१-२५-२२", "content_sanskrit": "वेदग्रहणपर्यंतं निवसेद्गुरुवेश्मनि ।\nप्रातः स्नायी भवेद्वर्णी समित्कुशफलादिकान् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001639022, "chapter_id": 21639, "verse_number": "१-२५-२३", "content_sanskrit": "गुर्वर्थमाहरेन्नित्यं कल्ये कल्ये मुनीश्वर ।\nयज्ञोपवीतमजिनं दंडं च मुनिसत्तम ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001639023, "chapter_id": 21639, "verse_number": "१-२५-२४", "content_sanskrit": "नष्टे भ्रष्टे नवं मंत्राद्धृत्वा भ्रष्टं जले क्षिपेत् ।\nवर्णिनो वर्त्तनं प्राहुर्भिक्षान्नेनैव केवलम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001639024, "chapter_id": 21639, "verse_number": "१-२५-२५", "content_sanskrit": "भिक्षा च श्रोत्रियागारादाहरेत्प्रयतेंद्रियः ।\nभवत्पूर्वं ब्राह्मणस्य भवन्मध्यं नृपस्य च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001639025, "chapter_id": 21639, "verse_number": "१-२५-२६", "content_sanskrit": "भवदत्यं विशः प्रोक्तं भिक्षाहरणकं वचः ।\nसांयप्रातर्वह्निकार्यं यथाचारं जितेंद्रियः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001639026, "chapter_id": 21639, "verse_number": "१-२५-२७", "content_sanskrit": "कुर्यात्प्रतिदिनं वर्णीं ब्रह्मयज्ञं च तर्पणम् ।\nअग्निकार्यपरित्यागी पतितः प्रोच्यते बुधैः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001639027, "chapter_id": 21639, "verse_number": "१-२५-२८", "content_sanskrit": "ब्रह्मयज्ञविहीनश्च ब्रह्महा परिकीर्तितः ।\nदेवताभ्यर्च्चनं कुर्याच्छुश्रूषानुपदं गुरोः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001639028, "chapter_id": 21639, "verse_number": "१-२५-२९", "content_sanskrit": "भिक्षान्नं भोजयेन्नित्यं नैकान्नाशी कदाचन ।\nआनीयानिन्द्यविप्राणां गृहाद्भिक्षां जितेंद्रियः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001639029, "chapter_id": 21639, "verse_number": "१-२५-३०", "content_sanskrit": "निवेद्य गुरवेऽश्रीयाद्वाग्यतस्तदनुज्ञया ।\nमधुस्त्रीमांसलवणं ताम्बूलं दंतधावनम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001639030, "chapter_id": 21639, "verse_number": "१-२५-३१", "content_sanskrit": "उच्छिष्टभोजनं चैव दिवास्वापं च वर्जयेत् ।\nछत्रपादुक गंधांश्च तथा माल्यानुलेपनम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001639031, "chapter_id": 21639, "verse_number": "१-२५-३२", "content_sanskrit": "जलकेलिं नृत्यगीतवाद्यं तु परिवर्जयेत् ।\nपरिवादं चोपतापं विप्रलापं तथांजनम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001639032, "chapter_id": 21639, "verse_number": "१-२५-३३", "content_sanskrit": "पाषण्ड जनसंयोगं शूद्रसंगं च वर्जयेत् ।\nअभिवादनशीलः स्याद् वृद्धेषु च यथाक्रमम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001639033, "chapter_id": 21639, "verse_number": "१-२५-३४", "content_sanskrit": "ज्ञानवृद्धास्तपोवृद्धा वयोवृद्धा इति त्रयः ।\nआध्यात्मिकादिदुःखानि निवारयति यो गुरुः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001639034, "chapter_id": 21639, "verse_number": "१-२५-३५", "content_sanskrit": "वेदशास्त्रोपदेशेन तं पूर्वमभिवादयेत् ।\nअसावहमिति ब्रूयाद्दिजो वै ह्यभिवादने ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001639035, "chapter_id": 21639, "verse_number": "१-२५-३६", "content_sanskrit": "नाभिवाद्याश्च विप्रेण क्षत्रियाद्याः कथंचन ।\nनास्तिकं भिन्नमर्यादं कृतन्घं ग्रामयाजकम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001639036, "chapter_id": 21639, "verse_number": "१-२५-३७", "content_sanskrit": "स्तेनं च कितवं चैव कदाचिन्नाभिवादयेत् ।\nपाषण्डं पतितं व्रात्यं तथा नक्षत्रजीविनम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001639037, "chapter_id": 21639, "verse_number": "१-२५-३८", "content_sanskrit": "तथा पातकिनं चैव कदाचिन्नाभिवादयेत् ।\nउन्मत्तं च शठं धूर्त्तं धावन्तमशुचिं तथा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001639038, "chapter_id": 21639, "verse_number": "१-२५-३९", "content_sanskrit": "अभ्यक्तशिरसं चैव जपन्तं नाभिवादयेत् ।\nविवादशीलिनं चंडं वमंतं जलमध्यगम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001639039, "chapter_id": 21639, "verse_number": "१-२५-४०", "content_sanskrit": "भिक्षान्नधारिणं चैव शयानं नाभिवादयेत् ।\nभर्तृघ्नी पुष्पिणीं जारां सूतिकां गर्भपातिनीम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001639040, "chapter_id": 21639, "verse_number": "१-२५-४१", "content_sanskrit": "कृतन्घीं च तथा चंडीं कदाचिन्नाभिवादयेत् ।\nसभायां यज्ञशालायां देवतायतनेष्वपि ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001639041, "chapter_id": 21639, "verse_number": "१-२५-४२", "content_sanskrit": "प्रत्येकं तु नमस्कारो हंति पुण्यं पुराकृतम् ।\nश्राद्धं व्रतं तथा दानं देवताभ्यार्चनं तथा ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001639042, "chapter_id": 21639, "verse_number": "१-२५-४३", "content_sanskrit": "यज्ञं च तर्पणं चैव कुर्वंतं नाभिवादयेत् ।\nकृतेऽभिवादने यस्तु न कुर्यात्प्रतिवादनम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001639043, "chapter_id": 21639, "verse_number": "१-२५-४४", "content_sanskrit": "नाभिवाद्यः स विज्ञेयो यया शूद्रस्तथैव सः ।\nप्रक्षाल्य पादावाचम्य गुरोरभिमुखः सदा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001639044, "chapter_id": 21639, "verse_number": "१-२५-४५", "content_sanskrit": "तस्य पादौ च संगृह्य अधीयीत विचक्षणः ।\nअष्टकासु चतुर्दश्यां प्रतिपत्पर्वणोस्तथा ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001639045, "chapter_id": 21639, "verse_number": "१-२५-४६", "content_sanskrit": "महाभरण्यां विप्रेद्रं श्रवणद्वादशीदिने ।\nभाद्रपदापरपक्षे द्वितीयायां तथैव च ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001639046, "chapter_id": 21639, "verse_number": "१-२५-४७", "content_sanskrit": "माघस्य शुक्लसप्तम्यां नवम्यामाश्विनस्य च ।\nपरिवेषं गते सूर्ये श्रोत्रिये गृहमागते ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001639047, "chapter_id": 21639, "verse_number": "१-२५-४८", "content_sanskrit": "बंधिते ब्रह्मणे चैव प्रवृद्धकलहे तथा ।\nसंध्यायां गर्जिते मेघे ह्यकाले परिवर्षणे ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001639048, "chapter_id": 21639, "verse_number": "१-२५-४९", "content_sanskrit": "उल्काशनिप्रपाते च तथा विप्रेऽवमानिते ।\nमन्वादिषु च देवर्षे युगादिषु चतुर्ष्वपि ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001639049, "chapter_id": 21639, "verse_number": "१-२५-५०", "content_sanskrit": "नाधीयीत द्विजः कश्चित्सर्वकर्मफलोत्सुकः ।\nतृतीया प्राधवे शुक्ला भाद्रे कृष्णा त्रयोदशी ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001639050, "chapter_id": 21639, "verse_number": "१-२५-५१", "content_sanskrit": "कार्त्तिके नवमी शुद्धा माघे पंचदशी तिथिः ।\nएता युगाद्याः कथिता दत्तस्याक्षयकारिकाः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001639051, "chapter_id": 21639, "verse_number": "१-२५-५२", "content_sanskrit": "मन्वादींश्च प्रवक्ष्यामि श्रृणुष्व सुसमाहितः ।\nअक्षयुक्छुक्लनवमी कार्तिके द्वादशी सिता ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001639052, "chapter_id": 21639, "verse_number": "१-२५-५३", "content_sanskrit": "तृतीया चैत्रमासस्य तथा भाद्रपदस्य च ।\nआषाढशुक्लदशमी सिता माघस्य सप्तमी ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001639053, "chapter_id": 21639, "verse_number": "१-२५-५४", "content_sanskrit": "श्रावणस्याष्टमी कृष्णा तथाषाढी च पूर्णमा ।\nफाल्गुनस्य त्वमावास्या पौषस्यैकादशी सिता ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001639054, "chapter_id": 21639, "verse_number": "१-२५-५५", "content_sanskrit": "कार्तिकी फाल्गुनी चैत्रीं ज्यैष्ठी पंचदशी सिता ।\nमन्वादयः समाख्याता दत्तस्याक्षयकारिकाः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001639055, "chapter_id": 21639, "verse_number": "१-२५-५६", "content_sanskrit": "द्विजैः श्रद्धं चकर्त्तव्यं मन्वादिषु युगादिषु ।\nश्राद्धे निमंत्रिते चैवग्रहणे चंद्रसूर्ययोः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001639056, "chapter_id": 21639, "verse_number": "१-२५-५७", "content_sanskrit": "अयनद्वितये चैव तथा भूकंपने मुने ।\nगलग्रहे दुर्द्दिने च नाधीयीत कदाचन ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001639057, "chapter_id": 21639, "verse_number": "१-२५-५८", "content_sanskrit": "एवमादिषु सर्वेषु अनध्यायेषु नारद ।\nअधीयतां सुमूढानांप्रजांप्रज्ञांयशः श्रियम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001639058, "chapter_id": 21639, "verse_number": "१-२५-५९", "content_sanskrit": "आयुष्यं बलमारोग्यं निकृंतति यमः स्वयम् ।\nअनध्याये तु योऽधीते तं विद्याद्वब्रह्मघातकम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001639059, "chapter_id": 21639, "verse_number": "१-२५-६०", "content_sanskrit": "न तं संभाषयेद्विप्रन तेन सह संवसेत् ।\nकुंडगोलकयोः केचिज्जडादीनां च नारद ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001639060, "chapter_id": 21639, "verse_number": "१-२५-६१", "content_sanskrit": "वदंति चोपनयनं तत्पुत्रादिषु केचन ।\nअनधीत्य तु यो वेदमन्त्रय कुरुते श्रमम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001639061, "chapter_id": 21639, "verse_number": "१-२५-६२", "content_sanskrit": "शूद्रतुल्यः स विज्ञेयो नरकस्य प्रियोऽतिथिः ।\nअनधीतश्रुतिर्विप्र आचार प्रतिपद्यते ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001639062, "chapter_id": 21639, "verse_number": "१-२५-६३", "content_sanskrit": "नाचारफलमान्पोति यथा शूद्रस्तथैव सः ।\nनित्यं नैमित्तिकं काम्यं यच्चान्यत्कर्म वैदिकम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001639063, "chapter_id": 21639, "verse_number": "१-२५-६४", "content_sanskrit": "अनधीतस्य विप्रस्य सर्वं भवति निष्फलम् ।\nशब्दब्रह्ममयो विष्णुर्‌वेदः साक्षाद्धारि स्मृकतः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001639064, "chapter_id": 21639, "verse_number": "१-२५-६५", "content_sanskrit": "वेदाध्यायी ततो विप्रः सर्वान्कामानवाप्नुयात् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]