[{"id": 6000039000, "chapter_id": 10039, "verse_number": null, "content_sanskrit": "अथ नवमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000039001, "chapter_id": 10039, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_009/BhP_03.009.001.m4a", "display_order": 2}, {"id": 6000039002, "chapter_id": 10039, "verse_number": "३-९-१", "content_sanskrit": "सत्सेवनीयो बत पूरुवंशो यल्लोकपालो भगवत्प्रधानः।\nबभूविथेहाजितकीर्तिमालां पदे पदे नूतनयस्यभीक्ष्णम्॥ ३/९/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_009/BhP_03.009.002.m4a", "display_order": 3, "topics": [{"text": "मैत्रेयेण विदुरप्रश्नानाम् उत्तरदानोपक्रमः", "range": "१–१०"}]}, {"id": 6000039003, "chapter_id": 10039, "verse_number": "३-९-२", "content_sanskrit": "सोऽहं नृणां क्षुल्लसुखाय दुःखं महद्गतानां विरमाय तुभ्यम्।\nप्रवर्तये भागवतं पुराणं यदाह साक्षाद् भगवान् ऋषिभ्यः॥ ३/९/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_009/BhP_03.009.003.m4a", "display_order": 4}, {"id": 6000039004, "chapter_id": 10039, "verse_number": "३-९-३", "content_sanskrit": "आसीनमुर्व्यां भगवन्तमाद्यं सङ्कर्षणं देवमकुण्ठसत्त्वम्।\nविवित्सवस्तत्त्वमतः परस्य कुमारमुख्या मुनयोऽन्वपृच्छन्॥ ३/९/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_009/BhP_03.009.004.m4a", "display_order": 5}, {"id": 6000039005, "chapter_id": 10039, "verse_number": "३-९-४", "content_sanskrit": "स्वमेव धिष्ण्यं बहु मानयन्तं यं वासुदेवाभिधमामनन्ति।\nप्रत्यग्धृताक्षाम्बुजकोशमीषदुन्मीलयन्तं विबुधोदयाय॥ ३/९/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_009/BhP_03.009.005.m4a", "display_order": 6}, {"id": 6000039006, "chapter_id": 10039, "verse_number": "३-९-५", "content_sanskrit": "स्वर्धुन्युदारैः स्वजटाकलापैरुपस्पृशन्त्यश्चरणोपधानम्।\nपद्मं यदर्चन्त्यहिराजकन्याः सप्रेम नानाबलिभिर्वरार्हाः॥ ३/९/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_009/BhP_03.009.006.m4a", "display_order": 7}, {"id": 6000039007, "chapter_id": 10039, "verse_number": "३-९-६", "content_sanskrit": "मुहुर्गृणन्त्यो वचसाऽनुरागस्खलत्पदेनास्य कृतानि तज्ज्ञाः।\nकिरीटसाहस्रमणिप्रवेकप्रद्योतितोद्दामफणासहस्रम्॥ ३/९/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_009/BhP_03.009.007.m4a", "display_order": 8}, {"id": 6000039008, "chapter_id": 10039, "verse_number": "३-९-७", "content_sanskrit": "प्रोक्तं किलैतद् भगवत्तमेन निवृत्तिधर्माभिरताय तेन।\nसनत्कुमाराय स चाह पृष्टः सांख्यायनायाङ्ग धृतव्रताय॥ ३/९/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_009/BhP_03.009.008.m4a", "display_order": 9}, {"id": 6000039009, "chapter_id": 10039, "verse_number": "३-९-८", "content_sanskrit": "साङ्ख्यायनः पारमहंस्यमुख्यो विवक्षमाणो भगवद्विभूतीः।\nजगाद सोऽस्मद्गुरवेऽन्विताय पराशरायाथ बृहस्पतेश्च॥ ३/९/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_009/BhP_03.009.009.m4a", "display_order": 10}, {"id": 6000039010, "chapter_id": 10039, "verse_number": "३-९-९", "content_sanskrit": "प्रोवाच मह्यं स दयालुरुक्तो मुनिः पुलस्त्येन पुराणमाद्यम्।\nसोऽहं तवैतत् कथयामि वत्स श्रद्धालवे नित्यमनुव्रताय॥ ३/९/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_009/BhP_03.009.010.m4a", "display_order": 11}, {"id": 6000039011, "chapter_id": 10039, "verse_number": "३-९-१०", "content_sanskrit": "उदप्लुतं विश्वमिदं तदासीद् यन्निद्रयाऽमीलितदृङ् न्यमीलयत्।\nअहीन्द्रतल्पेऽधिशयान एकः कृतक्षणः स्वात्मरतावनीहः॥ ३/९/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_009/BhP_03.009.011.m4a", "display_order": 12}, {"id": 6000039012, "chapter_id": 10039, "verse_number": "३-९-११", "content_sanskrit": "सोऽन्तःशरीरेऽर्पितभूतसूक्ष्मः कालात्मिकां शक्तिमुदीरयाणः।\nउवास तस्मिन् सलिले पदे स्वे यथाऽनलो दारुणि रुद्धवीर्यः॥ ३/९/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_009/BhP_03.009.012.m4a", "display_order": 13, "topics": [{"text": "अण्डोदके शेषभोगे शयानेन श्रीनारायणेन स्वनाभावुद्भूतपद्मोत्पादनपूर्वकं तत्र चतुर्मुखसर्जनम्", "range": "११–१७"}]}, {"id": 6000039013, "chapter_id": 10039, "verse_number": "३-९-१२", "content_sanskrit": "चतुर्युगानां च सहस्रमप्सु स्वपंस्तयोदीरितया स्वशक्त्या।\nकालाख्ययाऽऽसादितकर्मतन्त्रो लोकानपीमान् ददृशे स्वदेहे॥ ३/९/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_009/BhP_03.009.013.m4a", "display_order": 14}, {"id": 6000039014, "chapter_id": 10039, "verse_number": "३-९-१३", "content_sanskrit": "तस्यात्मसूक्ष्माभिनिविष्टदृष्टेरन्तर्गतोऽर्थो रजसाऽतनीयान्।\nगुणेन कालानुगतेन विद्धः शुष्यंस्तदाऽभिद्यत नाभिदेशात्॥ ३/९/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_009/BhP_03.009.014.m4a", "display_order": 15}, {"id": 6000039015, "chapter_id": 10039, "verse_number": "३-९-१४", "content_sanskrit": "स पद्मकोशः सहसोदतिष्ठत् कालेन कर्मप्रतिबोधितेन।\nस्वरोचिषा तत् सलिलं विशालं विद्योतयन्नर्क इवात्मयोनिः॥ ३/९/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_009/BhP_03.009.015.m4a", "display_order": 16}, {"id": 6000039016, "chapter_id": 10039, "verse_number": "३-९-१५", "content_sanskrit": "तल्लोकपद्मं स उ एव विष्णुः प्रावीविशत् सर्वगुणावभासम्।\nतस्मिन् स्वयं वेदमयो विधाता स्वयम्भुवं यं प्रवदन्ति सोऽभूत्॥ ३/९/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_009/BhP_03.009.016.m4a", "display_order": 17}, {"id": 6000039017, "chapter_id": 10039, "verse_number": "३-९-१६", "content_sanskrit": "तस्यां स चाम्भोरुहकर्णिकायाम् अवस्थितो लोकमपश्यमानः।\nपरिक्रमन् व्योम्नि विवृत्तनेत्रश्चत्वारि भेजेऽनुदिशं मुखानि॥ ३/९/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_009/BhP_03.009.017.m4a", "display_order": 18}, {"id": 6000039018, "chapter_id": 10039, "verse_number": "३-९-१७", "content_sanskrit": "तस्माद् युगान्तश्वसनावघूर्णमहोर्मिचक्रात् सलिलाद् विरूढम्।\nअथाश्रितः कञ्जमु लोकतन्त्रं नात्मानमद्धाऽविददादिदेवः॥ ३/९/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_009/BhP_03.009.018.m4a", "display_order": 19}, {"id": 6000039019, "chapter_id": 10039, "verse_number": "३-९-१८", "content_sanskrit": "क एष योऽसावहमब्जपृष्ठ एतत् कुतो वाऽब्जमनन्यदप्सु।\nअस्ति ह्यधस्तादिह किञ्चनैतदधिष्ठितं यत्र सता नु भाव्यम्॥ ३/९/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_009/BhP_03.009.019.m4a", "display_order": 20, "topics": [{"text": "ब्रह्मणा स्वोत्पादकस्य परिज्ञानाय तपश्चचरणम्", "range": "१८–२१"}]}, {"id": 6000039020, "chapter_id": 10039, "verse_number": "३-९-१९", "content_sanskrit": "स इत्थमुद्वीक्ष्य तदब्जनालनालीभिरन्तर्जलमाविवेश।\nनार्वाग्गतस्तत्खरनालनालीः स वै विचिन्वंस्तदविन्दताजः॥ ३/९/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_009/BhP_03.009.020.m4a", "display_order": 21}, {"id": 6000039021, "chapter_id": 10039, "verse_number": "३-९-२०", "content_sanskrit": "तमस्यपारे विदुरात्मसर्गं विचिन्वतोऽभूत् सुमहांस्‍त्रिनेमिः।\nयो देहभाजां भयमीरयाणः परिक्षिणोत्यायुरजस्य हेतिः॥ ३/९/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_009/BhP_03.009.021.m4a", "display_order": 22}, {"id": 6000039022, "chapter_id": 10039, "verse_number": "३-९-२१", "content_sanskrit": "ततो निवृत्त्याऽप्रतिलब्धकाष्ठः स्वधिष्ण्यमास्थाय पुनः स देवः।\nशनैर्जितश्वासनिवृत्तचित्तो न्यषीददारूढसमाधियोगः॥ ३/९/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_009/BhP_03.009.022.m4a", "display_order": 23}, {"id": 6000039023, "chapter_id": 10039, "verse_number": "३-९-२२", "content_sanskrit": "कालेन सोऽजः पुरुषायुषाभिप्रवृद्धयोगेन विरूढबोधः।\nस्वयं तदन्तर्हृदयेऽवभातम् अपश्यतापश्यत यन्न पूर्वम्॥ ३/९/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_009/BhP_03.009.023.m4a", "display_order": 24, "topics": [{"text": "ततो वर्षशतावसाने शेषशायिनो नारायणस्य स्वहृदये निरीक्षणम्", "range": "२२–३३"}]}, {"id": 6000039024, "chapter_id": 10039, "verse_number": "३-९-२३", "content_sanskrit": "मृणालगौरायतशेषभोगपर्यङ्क एकं पुरुषं शयानम्।\nफणासहस्रायुतमूर्धरत्नद्युभिर्हतध्वान्तयुगान्ततोये॥ ३/९/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_009/BhP_03.009.024.m4a", "display_order": 25}, {"id": 6000039025, "chapter_id": 10039, "verse_number": "३-९-२४", "content_sanskrit": "प्रेक्षां क्षिपन्तं हरितोपलाद्रेः सन्ध्याभ्रनीवेरुरुरुक्ममूर्ध्नः।\nरत्नोदधेरोषधिसौमनस्यवनस्रजो वेणुभुजाङ्घ्रिपाङ्घ्रेः॥ ३/९/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_009/BhP_03.009.025.m4a", "display_order": 26}, {"id": 6000039026, "chapter_id": 10039, "verse_number": "३-९-२५", "content_sanskrit": "आयामतो विस्तरतः समानदेहेन लोकत्रयसंग्रहेण।\nविचित्रदिव्याभरणांशुकानां कृतश्रियोपाश्रितदिव्यवेषम्॥ ३/९/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_009/BhP_03.009.026.m4a", "display_order": 27}, {"id": 6000039027, "chapter_id": 10039, "verse_number": "३-९-२६", "content_sanskrit": "पुंसां स्वकामाय विविक्तमार्गैरभ्यर्चतां कामदुघाङ्घ्रिपद्मम्।\nप्रदर्शयन्तं कृपया नखेन्दुमयूखभिन्नाङ्गुलिचारुपत्रम्॥ ३/९/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_009/BhP_03.009.027.m4a", "display_order": 28}, {"id": 6000039028, "chapter_id": 10039, "verse_number": "३-९-२७", "content_sanskrit": "मुखेन लोकार्तिहरस्मितेन परिस्फुरत्कुण्डलमण्डितेन।\nशोणायितेनाधरबिम्बभासा प्रत्यर्हयन्तं सुनसेन सुभ्र्वा॥ ३/९/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_009/BhP_03.009.028.m4a", "display_order": 29}, {"id": 6000039029, "chapter_id": 10039, "verse_number": "३-९-२८", "content_sanskrit": "कदम्बकिञ्जल्कपिशङ्गवाससा स्वलङ्कृतं मेखलया नितम्बे।\nहारेण चानन्तधनेन वत्स श्रीवत्सवक्षःस्थलवल्लभेन॥ ३/९/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_009/BhP_03.009.029.m4a", "display_order": 30}, {"id": 6000039030, "chapter_id": 10039, "verse_number": "३-९-२९", "content_sanskrit": "परार्घ्यकेयूरमणिप्रवेकपर्यस्तदोर्दण्डसहस्रशाखम्।\nअव्यक्तमूलं भुवनाङ्घ्रिपेन्द्रमहीन्द्रभोगैरधिवीतवल्कम्॥ ३/९/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_009/BhP_03.009.030.m4a", "display_order": 31}, {"id": 6000039031, "chapter_id": 10039, "verse_number": "३-९-३०", "content_sanskrit": "चराचरौको भगवन्महीध्रमहीन्द्रबन्धुं सलिलोपगूढम्।\nकिरीटसाहस्रहिरण्यशृृङ्गम् आविर्भवत्कौस्तुभरत्नगर्भम्॥ ३/९/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_009/BhP_03.009.031.m4a", "display_order": 32}, {"id": 6000039032, "chapter_id": 10039, "verse_number": "३-९-३१", "content_sanskrit": "निवीतमाम्नायमधुव्रतश्रिया स्वकीर्तिमय्या वनमालया हरिम्।\nसूर्येन्दुवाय्वग्न्यगमत्त्रिधामभिः परिक्रमत्प्राधनिकैर्दुरासदम्॥ ३/९/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_009/BhP_03.009.032.m4a", "display_order": 33}, {"id": 6000039033, "chapter_id": 10039, "verse_number": "३-९-३२", "content_sanskrit": "तर्ह्येव तन्नाभिसरःसरोजम् आत्मानमम्भः श्वसनं वियच्च।\nददर्श देवो जगतो विधाता नातः परं लोकविसर्गदृष्टिः॥ ३/९/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_009/BhP_03.009.033.m4a", "display_order": 34}, {"id": 6000039034, "chapter_id": 10039, "verse_number": "३-९-३३", "content_sanskrit": "स्वकर्मबीजं रजसोपरक्तः प्रजाः सिसृक्षन्नियदेव दृष्ट्वा।\nअस्तौद् विसर्गाभिमुखस्तमीशमव्यक्तवर्त्मन्यभिवेशितात्मा॥ ३/९/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_009/BhP_03.009.034.m4a", "display_order": 35}, {"id": 6000039035, "chapter_id": 10039, "verse_number": null, "content_sanskrit": "इति श्रीमद्भागवते वैयासिक्यां संहितायां तृतीयस्कन्धे नवमाध्यायः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]