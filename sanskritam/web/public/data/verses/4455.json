[{"id": 2159276, "chapter_id": 4455, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2159277, "chapter_id": 4455, "verse_number": "१", "content_sanskrit": "ययातिं नाहुषं चापि मृतं सृञ्जय शुश्रुम ।\nय इमां पृथिवीं जित्वा ससमुद्रां सपर्वताम्\nशम्याप्रासेन निर्माय वेदीः सन्नतदक्षिणाः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2159278, "chapter_id": 4455, "verse_number": "२", "content_sanskrit": "ईजानः क्रतुभिः पुण्यैः पर्यगच्छत् प्रदक्षिणम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2159279, "chapter_id": 4455, "verse_number": "३", "content_sanskrit": "इष्ट्वा क्रतुसहस्रेण हयमेधशतेन च ।\nपौण्डरीकसहस्रेण वाजपेयशतेन च\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2159280, "chapter_id": 4455, "verse_number": "४", "content_sanskrit": "अतिरात्रसहस्रेण चातुर्मास्यैश्च कामतः ।\nअग्निष्टोमैश्च विविधैः सत्रैर्नित्याप्तदक्षिणैः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2159281, "chapter_id": 4455, "verse_number": "५", "content_sanskrit": "अब्राह्मणानां वित्तं यत् पृथिव्यामस्ति किञ्चन ।\nतत् सर्वं परिसङ्ख्याय स तद् ब्राह्मणसात् करोत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2159282, "chapter_id": 4455, "verse_number": "६", "content_sanskrit": "सरस्वती पुण्यतमा नदीनां\nतथा समुद्राः सरितोऽद्रयश्च ।\nईजानाय पुण्यतमाय राज्ञे\nघृतं पयो दुदुहुर्नाहुषाय\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2159283, "chapter_id": 4455, "verse_number": "७", "content_sanskrit": "व्यूढे देवासुरे युद्धे जित्वा दैत्यान् सदानवान् ।\nवर्णेभ्यो व्यभजत् सर्वां चतुर्भ्यः पृथिवीमिमाम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2159284, "chapter_id": 4455, "verse_number": "८", "content_sanskrit": "यज्ञैर्बहुविधैरिष्ट्वा प्रजामुत्पाद्य चोत्तमाम् ।\nदेवयान्यां चौशनस्यां शर्मिष्ठायां च धर्मतः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2159285, "chapter_id": 4455, "verse_number": "९", "content_sanskrit": "देवारण्येषु रम्येषु विजहार सहप्रियः ।\nआत्मनः कामचारेण द्वितीय इव वासवः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2159286, "chapter_id": 4455, "verse_number": "१०", "content_sanskrit": "यदा नाध्यगमच्छान्तिं कामानां सर्वधर्मवित् ।\nततो गाथामिमां गीत्वा सदारः प्राविशद् वनम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2159287, "chapter_id": 4455, "verse_number": "११", "content_sanskrit": "यत् पृथिव्यां व्रीहियवं हिरण्यं पशवः स्त्रियः ।\nनालमेकस्य तत् सर्वं सन्तोषं परमं सुखम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2159288, "chapter_id": 4455, "verse_number": "१२", "content_sanskrit": "एवं कामान् परित्यज्य ययातिर्धृतिमानथ ।\nपूरुं राज्ये प्रतिष्ठाप्य प्रविष्टो वनमीश्वरः\nस चेन्ममार सृञ्जय चतुर्भद्रतरस्त्वया\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2159289, "chapter_id": 4455, "verse_number": "१३", "content_sanskrit": "पुत्रात् पुण्यतमस्तुभ्यं मा पुत्रमनुतप्यथाः ।\nअयज्वानमदक्षिण्यमधिचैत्येत्युदाहरत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2159290, "chapter_id": 4455, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि षष्टितमोऽध्यायः ॥ ६० ॥\nअभिमन्युवधपर्वणि एकोनत्रिंशोऽध्यायः ॥ २९ ॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]