[{"id": 7001720000, "chapter_id": 21720, "verse_number": "१-१०६-१", "content_sanskrit": "ब्रह्मोवाच ।\nश्रृणु वत्स मरीचे त्वं पुराणं कूर्मसंज्ञकम् ।\nलक्ष्मीकल्पानुचरितं यत्र कूर्मवपुर्हरिः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001720001, "chapter_id": 21720, "verse_number": "१-१०६-२", "content_sanskrit": "धर्मार्थकाममोक्षाणां माहात्म्यं च पृथक्पृथक् ।\nइंद्रद्युम्नप्रसंगेन प्राहर्षिभ्यो दयान्वितः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001720002, "chapter_id": 21720, "verse_number": "१-१०६-३", "content_sanskrit": "तत्सप्तदशसाहस्रं सुचतुः संहितं शुभम् ।\nयत्र ब्राह्माः पुरा प्रोक्ता धर्मा नानाविधा मुने ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001720003, "chapter_id": 21720, "verse_number": "१-१०६-४", "content_sanskrit": "नाननाकथाप्रसंगेन नृणां सद्गतिदायकाः ।\nतत्र पूर्वविभागे तु पुराणोपक्रमः पुरा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001720004, "chapter_id": 21720, "verse_number": "१-१०६-५", "content_sanskrit": "लक्ष्मींद्रद्युम्नसंवादः कूर्म्मर्षिगणसंकथा ।\nवर्णाश्रमाचारकथा जगदुत्पत्तिकीर्तनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001720005, "chapter_id": 21720, "verse_number": "१-१०६-६", "content_sanskrit": "कालसंख्या समासेन लयांते स्तवनं विभोः ।\nततः संक्षेपतः सर्गः शांकरं चरितं तथा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001720006, "chapter_id": 21720, "verse_number": "१-१०६-७", "content_sanskrit": "सहस्रनाम पार्वत्या योगस्य च निरूपणम् ।\nभृगुवंशसमाख्यानं ततः स्वायम्भुवस्य च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001720007, "chapter_id": 21720, "verse_number": "१-१०६-८", "content_sanskrit": "देवादीनां समुत्पत्तिर्दक्षयज्ञाहतिस्ततः ।\nदक्षसृष्टिकथा पश्चात्कश्यपान्वयकीर्तनम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001720008, "chapter_id": 21720, "verse_number": "१-१०६-९", "content_sanskrit": "आत्रेयवंशकथनं कृष्णस्यं चरितं शुभम् ।\nमार्तंडकृष्णसंवादो व्यासपाण्डवसंकथा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001720009, "chapter_id": 21720, "verse_number": "१-१०६-१०", "content_sanskrit": "युगधर्मानुकथनं व्यासजैमिनिकीर्तनम् ।\nवाराणस्याश्च माहात्म्यं प्रयागस्य ततः परम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001720010, "chapter_id": 21720, "verse_number": "१-१०६-११", "content_sanskrit": "त्रैलोक्यवर्णनं चैव वेदशाखानिरूपणम् ।\nउत्तरेऽस्या विभागे तु पुरा गीतैश्वरी ततः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001720011, "chapter_id": 21720, "verse_number": "१-१०६-१२", "content_sanskrit": "व्यासगीता ततः प्रोक्ता नानाधर्मप्रबोधिनी ।\nनानाविधानां तीर्थानां माहात्म्यं च पृथक् ततः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001720012, "chapter_id": 21720, "verse_number": "१-१०६-१३", "content_sanskrit": "प्रतिसर्गप्रकथनं ब्राह्मीयं संहिता स्मृता ।\nअतः परं भागवतीसंहितार्थ निरूपणम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001720013, "chapter_id": 21720, "verse_number": "१-१०६-१४", "content_sanskrit": "कथिता यत्र वर्णानां पृथक्वृत्तिरुदाहृता ।\nपादऽस्याः प्रथमे प्रोक्ता ब्राह्मणानां व्यवस्थितिः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001720014, "chapter_id": 21720, "verse_number": "१-१०६-१५", "content_sanskrit": "सदा चागत्मिका वत्स भोगसौख्यविवर्द्धनी ।\nद्वितीये क्षत्त्रियाणां तु वृत्तिः सम्यक्प्रकीर्तिता ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001720015, "chapter_id": 21720, "verse_number": "१-१०६-१६", "content_sanskrit": "यया त्वाश्रितया पापं विधूयेह व्रजेद्दिवम् ।\nतृतीये वैश्यजातीनां वृत्तिरुक्ता चतुर्विधा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001720016, "chapter_id": 21720, "verse_number": "१-१०६-१७", "content_sanskrit": "यया चरितया सम्यग्लभे गतिमुत्तमाम् ।\nचतुर्थेऽस्यास्तथा पादे शूद्रवृत्तिरुदाहृता ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001720017, "chapter_id": 21720, "verse_number": "१-१०६-१८", "content_sanskrit": "यया संतुष्यति श्रीशो नृणां श्रेयोविवर्द्धनः ।\nपंचमेऽस्यास्ततः पादे वृत्तिः संकरजोदिता ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001720018, "chapter_id": 21720, "verse_number": "१-१०६-१९", "content_sanskrit": "यया चरितयाप्नोति भाविनीं गतिमुत्तमाम् ।\nइत्येषा पंचपद्युक्ता द्वितीया संहिता मुने ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001720019, "chapter_id": 21720, "verse_number": "१-१०६-२०", "content_sanskrit": "तृतीयात्रोदिता सौरी नॄणां कार्यविधायिनी ।\nषोढा षट्कर्मसिर्द्धि बोधयन्ती च कामिनाम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001720020, "chapter_id": 21720, "verse_number": "१-१०६-२१", "content_sanskrit": "चतुर्थीवैष्णवो नाम मोक्षदा परिकीर्तिता ।\nचतुष्पदी द्विजातीनां साक्षाद्ब्रह्मस्वरूरिणी ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001720021, "chapter_id": 21720, "verse_number": "१-१०६-२२", "content_sanskrit": "ताः क्रमात्षट्चतुर्द्वीषुसाहस्राः परिकीर्तिताः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001720022, "chapter_id": 21720, "verse_number": "१-१०६-२३", "content_sanskrit": "एतत्कूर्मपुराणं तु चतुर्वर्गफलप्रदम् ।\nपठतां श्रृण्वतां नॄणां सर्वोत्कृष्टगतिप्रदम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001720023, "chapter_id": 21720, "verse_number": "१-१०६-२४", "content_sanskrit": "लिखित्वैतत्तु यो भक्त्या हेमकूर्मसमन्वितम् ।\nब्राह्मणायायने दद्यात्स याति परमां गतिम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]