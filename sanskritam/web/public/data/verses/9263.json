rder": 60}, {"id": 40017541, "chapter_id": 9263, "verse_number": "61", "content_sanskrit": "तेषांभुजपरामर्शव्यामृष्टपरिघाशनि ॥ राक्षसानांबलंश्रेष्ठंभूयस्तरमशोभत ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 40017542, "chapter_id": 9263, "verse_number": "62", "content_sanskrit": "तत्रोन्मत्ताइवोत्पेतुर्हरयोऽथयुयुत्सवः ॥ तरुशैलैरभिघ्नन्तोमुष्टिभिश्चनिशाचरान् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 40017543, "chapter_id": 9263, "verse_number": "63", "content_sanskrit": "तथैवापततांतेषांकपीनामसिभिशशितैः ॥ शिरांसिसहसाजह्रूराक्षसाभीमदर्शना ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 40017544, "chapter_id": 9263, "verse_number": "64", "content_sanskrit": "दशनैर्हतकर्णाश्चमुष्टिनिष्कीर्णमस्तकाः ॥ शिलाप्रहारभग्नाङ्गाविचेरुस्तत्रराक्षसाः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 40017545, "chapter_id": 9263, "verse_number": "65", "content_sanskrit": "तथैवाप्यपरेतेषांकपीनामभिलक्षिता ॥ प्रवीरानभितोजघ्नुर्घोररूपानिशाचराः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 40017546, "chapter_id": 9263, "verse_number": "66", "content_sanskrit": "घ्नन्तमन्यंजघानान्यःपातयन्तमपातयत् ॥ गर्हमाणंजगर्हेऽन्योदशन्तमपरोऽदशत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 40017547, "chapter_id": 9263, "verse_number": "67", "content_sanskrit": "देहीत्यन्योददात्यन्योददामीत्यपरःपुनः ॥ किंक्लेशयसितिष्ठेतितत्रान्योन्यंबभाषिरे ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 40017548, "chapter_id": 9263, "verse_number": "68", "content_sanskrit": "विप्रलम्भितवस्त्रं च विमुक्तकवचायुधम् ॥ समुद्यतमहाप्रासंयष्टिशूलासिसङ्कुलम् । प्रावर्ततमहारौद्रंयुद्धंवानररक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 40017549, "chapter_id": 9263, "verse_number": "69", "content_sanskrit": "विप्रलम्भितवस्त्रं च विमुक्तकवचायुधम् ॥ समुद्यतमहाप्रासंयष्टिशूलासिसङ्कुलम् । प्रावर्ततमहारौद्रंयुद्धंवानररक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 40017550, "chapter_id": 9263, "verse_number": "70", "content_sanskrit": "वानरान्दशसप्तेतिराक्षसाजघ्नुराहवे । राक्षसान्दशसप्तेतिवानराश्चाभ्यपातयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}]