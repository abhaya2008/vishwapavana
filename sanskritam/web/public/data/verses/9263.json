[{"id": 5000263000, "chapter_id": 9263, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे षट्षष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000263001, "chapter_id": 9263, "verse_number": "३-६६-१", "content_sanskrit": "तं तथा शोकसंतप्तं विलपन्तमनाथवत्।\nमोहेन महता युक्तं परिद्यूनमचेतसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000263002, "chapter_id": 9263, "verse_number": "३-६६-२", "content_sanskrit": "ततः सौमित्रिराश्वस्य मुहूर्तादिव लक्ष्मणः।\nरामं सम्बोधयामास चरणौ चाभिपीडयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000263003, "chapter_id": 9263, "verse_number": "३-६६-३", "content_sanskrit": "महता तपसा चापि महता चापि कर्मणा।\nराज्ञा दशरथेनासील्लब्धोऽमृतमिवामरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000263004, "chapter_id": 9263, "verse_number": "३-६६-४", "content_sanskrit": "तव चैव गुणैर्बद्धस्त्वद्वियोगान्महीपतिः।\nराजा देवत्वमापन्नो भरतस्य यथा श्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000263005, "chapter_id": 9263, "verse_number": "३-६६-५", "content_sanskrit": "यदि दुःखमिदं प्राप्तं काकुत्स्थ न सहिष्यसे।\nप्राकृतश्चाल्पसत्त्वश्च इतरः कः सहिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000263006, "chapter_id": 9263, "verse_number": "३-६६-६", "content_sanskrit": "आश्वसिहि नरश्रेष्ठ प्राणिनः कस्य नापदः।\nसंस्पृशन्त्यग्निवद् राजन् क्षणेन व्यपयान्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000263007, "chapter_id": 9263, "verse_number": "३-६६-७", "content_sanskrit": "दुःखितो हि भवाँल्लोकांस्तेजसा यदि धक्ष्यते।\nआर्ताः प्रजा नरव्याघ्र क्व नु यास्यन्ति निर्वृतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000263008, "chapter_id": 9263, "verse_number": "३-६६-८", "content_sanskrit": "लोकस्वभाव एवैष ययातिर्नहुषात्मजः।\nगतः शक्रेण सालोक्यमनयस्तं समस्पृशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000263009, "chapter_id": 9263, "verse_number": "३-६६-९", "content_sanskrit": "महर्षिर्यो वसिष्ठस्तु यः पितुर्नः पुरोहितः।\nअह्ना पुत्रशतं जज्ञे तथैवास्य पुनर्हतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000263010, "chapter_id": 9263, "verse_number": "३-६६-१०", "content_sanskrit": "या चेयं जगतो माता सर्वलोकनमस्कृता।\nअस्याश्च चलनं भूमेर्दृश्यते कोसलेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000263011, "chapter_id": 9263, "verse_number": "३-६६-११", "content_sanskrit": "यौ धर्मौ जगतो नेत्रौ यत्र सर्वं प्रतिष्ठितम्।\nआदित्यचन्द्रौ ग्रहणमभ्युपेतौ महाबलौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000263012, "chapter_id": 9263, "verse_number": "३-६६-१२", "content_sanskrit": "सुमहान्त्यपि भूतानि देवाश्च पुरुषर्षभ।\nन दैवस्य प्रमुञ्चन्ति सर्वभूतानि देहिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000263013, "chapter_id": 9263, "verse_number": "३-६६-१३", "content_sanskrit": "शक्रादिष्वपि देवेषु वर्तमानौ नयानयौ।\nश्रूयेते नरशार्दूल न त्वं शोचितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000263014, "chapter_id": 9263, "verse_number": "३-६६-१४", "content_sanskrit": "मृतायामपि वैदेह्यां नष्टायामपि राघव।\nशोचितुं नार्हसे वीर यथान्यः प्राकृतस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000263015, "chapter_id": 9263, "verse_number": "३-६६-१५", "content_sanskrit": "त्वद्विधा नहि शोचन्ति सततं सर्वदर्शनाः।\nसुमहत्स्वपि कृच्छ्रेषु रामानिर्विण्णदर्शनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000263016, "chapter_id": 9263, "verse_number": "३-६६-१६", "content_sanskrit": "तत्त्वतो हि नरश्रेष्ठ बुद्ध्या समनुचिन्तय।\nबुद्ध्या युक्ता महाप्राज्ञा विजानन्ति शुभाशुभे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000263017, "chapter_id": 9263, "verse_number": "३-६६-१७", "content_sanskrit": "अदृष्टगुणदोषाणामध्रुवाणां तु कर्मणाम्।\nनान्तरेण क्रियां तेषां फलमिष्टं च वर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000263018, "chapter_id": 9263, "verse_number": "३-६६-१८", "content_sanskrit": "मामेवं हि पुरा वीर त्वमेव बहुशोक्तवान्।\nअनुशिष्याद्धि को नु त्वामपि साक्षाद् बृहस्पतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000263019, "chapter_id": 9263, "verse_number": "३-६६-१९", "content_sanskrit": "बुद्धिश्च ते महाप्राज्ञ देवैरपि दुरन्वया।\nशोकेनाभिप्रसुप्तं ते ज्ञानं सम्बोधयाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000263020, "chapter_id": 9263, "verse_number": "३-६६-२०", "content_sanskrit": "दिव्यं च मानुषं चैवमात्मनश्च पराक्रमम्।\nइक्ष्वाकुवृषभावेक्ष्य यतस्व द्विषतां वधे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000263021, "chapter_id": 9263, "verse_number": "३-६६-२१", "content_sanskrit": "किं ते सर्वविनाशेन कृतेन पुरुषर्षभ।\nतमेव तु रिपुं पापं विज्ञायोद्धर्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000263022, "chapter_id": 9263, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे षट्षष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]