_url": null, "display_order": 21}, {"id": 40017502, "chapter_id": 9263, "verse_number": "22", "content_sanskrit": "ज्वलनेनपरीतानितोरणानिचकाशिरे । विद्युद्भिरिवनद्धानिमेघजालानिघर्मगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40017503, "chapter_id": 9263, "verse_number": "23", "content_sanskrit": "ज्वलनेनपरीतानिनिपेतुर्भवनान्वथ । वज्रिवज्रहतानीवशिखराणिमहागिरेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40017504, "chapter_id": 9263, "verse_number": "24", "content_sanskrit": "विमानेषुप्रसुस्ताश्चदह्यमानावराङ्गनाः । त्यक्ताभरणसर्वाङ्गाहाहेत्युच्चैर्विचुक्रुशुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40017505, "chapter_id": 9263, "verse_number": "25", "content_sanskrit": "तत्रचाग्निपरीतानिनिपेतुर्भवनान्यपि । वज्रिवज्रहतानीवशिखराणिमहागिरेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40017506, "chapter_id": 9263, "verse_number": "26", "content_sanskrit": "तानिनिर्दह्यमानानिदूरतःप्रचकाशिरे । हिमवच्छिखराणीवदीप्तौषदिवनानिच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40017507, "chapter_id": 9263, "verse_number": "27", "content_sanskrit": "हर्म्याग्रैर्दह्यमानैश्चज्वालाप्रज्वलितैरपि । रात्रौसादृश्यतेलङ्कापुष्पितैरिवकिंशुकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40017508, "chapter_id": 9263, "verse_number": "28", "content_sanskrit": "हस्त्यध्यक्षैर्गजैर्मुक्तेर्मुक्सैश्चैवतुरङ्गमैः । बभूवलङ्कालोकान्तेभ्रान्तग्राहइवार्णवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40017509, "chapter_id": 9263, "verse_number": "29", "content_sanskrit": "अश्वंमुक्तंगजोदृष्टवाक्वचिद्भीतोऽपसर्पति । भीतोभीतंगजंदृष्टवाक्वचिदश्वोनिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40017510, "chapter_id": 9263, "verse_number": "30", "content_sanskrit": "लङ्कायांदह्यमानायांशुशुभे स महार्णवः । छायासंसक्तसलिलोलोहितोदइवार्णवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40017511, "chapter_id": 9263, "verse_number": "31", "content_sanskrit": "साबभूवमुहूर्तेनहरिभिर्दीपितापुरी । लोकस्यास्यक्ष्येघोरेप्रदीप्तेववसुन्दरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40017512, "chapter_id": 9263, "verse_number": "32", "content_sanskrit": "नारीजनस्यधूमेनव्याप्तस्योच्चैर्विनेदुषः । स्वनोज्वलनतप्तस्यशुश्रुवेशतयोजनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40017513, "chapter_id": 9263, "verse_number": "33", "content_sanskrit": "प्रदग्धकायानपरान् राक्षसान्निर्गतान् बहिः । सहसाभ्युत्पतन्तिस्महरयोऽथयुयुत्सवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40017514, "chapter_id": 9263, "verse_number": "34", "content_sanskrit": "उद्घुष्टंवानराणां च राक्षसानां च निस्स्वनः । दिशोदशसमुद्रं च पृथिवींचान्वनादयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40017515, "chapter_id": 9263, "verse_number": "35", "content_sanskrit": "विशल्यौतुमहात्मानौतावुभौरामलक्ष्मणौ । असम्भ्रान्तौजगृहतुस्तदोभौधनुषीवरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40017516, "chapter_id": 9263, "verse_number": "36", "content_sanskrit": "ततोविस्फारयानस्यरामस्यधनुरुत्तमम् । बभूवतुमुलश्शब्दोराक्षसानांभयावहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40017517, "chapter_id": 9263, "verse_number": "37", "content_sanskrit": "अशोभततदारामोधनुर्विष्फारयन् महत् । भगवानिवसङ्कृद्धोभवोवेदमयंधनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40017518, "chapter_id": 9263, "verse_number": "38", "content_sanskrit": "उद्घुष्टंवानराणां च राक्षसानां च निस्स्वनम् । ज्याशब्दस्तावुभौशब्दावतिरामस्यशुश्रुवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40017519, "chapter_id": 9263, "verse_number": "39", "content_sanskrit": "वानरोद्घुष्टघोषश्चराक्षसानां च निस्स्वनः । ज्याशब्दश्चापिरामस्यत्रयंव्याप्यदिशोदश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40017520, "chapter_id": 9263, "verse_number": "40", "content_sanskrit": "तस्यकार्मुकमुक्सैश्चशरैस्तत्पुरगोपुरम् । कैलासशृङ्गप्रतिमंविशीर्णमपतद्भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40017521, "chapter_id": 9263, "verse_number": "41", "content_sanskrit": "ततोरामशरान् दृष्टवाविमानेषुगृहेषु च । सन्नाहोराक्षसेन्द्राणांतुमुलस्समपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40017522, "chapter_id": 9263, "verse_number": "42", "content_sanskrit": "तेषांसन्नह्यमानानांसिंहनादं च कुर्वताम् । शर्वरीराक्षसेन्द्राणांरौद्रीवसमपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 40017523, "chapter_id": 9263, "verse_number": "43", "content_sanskrit": "आदिष्टावानरेन्द्रास्तेसुग्रीवेणमहात्मना । आसन्नद्वारमासाद्ययुध्यध्वंप्लवगर्षभाः ॥ यश्चवोवितथंकुर्वात्तत्रतत्रव्यवस्थितः । स हन्तव्योहिसंफ्लुत्यराजशासनदूषकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 40017524, "chapter_id": 9263, "verse_number": "44", "content_sanskrit": "आदिष्टावानरेन्द्रास्तेसुग्रीवेणमहात्मना । आसन्नद्वारमासाद्ययुध्यध्वंप्लवगर्षभाः ॥ यश्चवोवितथंकुर्वात्तत्रतत्रव्यवस्थितः । स हन्तव्योहिसंफ्लुत्यराजशासनदूषकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 40017525, "chapter_id": 9263, "verse_number": "45", "content_sanskrit": "तेषुवानरमुखेषुदीप्तोल्कोज्ज्वलपाणिषु । स्थितेषुद्वारमासाद्यरावणंमन्युराविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 40017526, "chapter_id": 9263, "verse_number": "46", "content_sanskrit": "तस्यजृम्भितविक्षेपाद्व्यामिश्रावैदिशोदश । रूपवानिवरुद्रस्यमन्युर्गात्रेष्वदृश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 40017527, "chapter_id": 9263, "verse_number": "47", "content_sanskrit": "स निकुम्भं च कुम्भं च कुम्भकर्णात्मजावुभौ । प्रेषयामाससङ्कृद्धोराक्षससैर्बहुभिस्सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 40017528, "chapter_id": 9263, "verse_number": "48", "content_sanskrit": "यूपाक्षश्शोणिताक्षश्चप्रजङ्घःकम्पनस्तथा । निर्ययुःकौम्भकर्णिभ्यांसहरावणशासनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 40017529, "chapter_id": 9263, "verse_number": "49", "content_sanskrit": "शशासचैवतान् सर्वान्राक्षसान् सुमहाबलान् । राक्षसागच्छताद्यैवसिंहनादं च नादयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 40017530, "chapter_id": 9263, "verse_number": "50", "content_sanskrit": "ततस्तुचोदितास्तेनराक्षसाज्वलितायुधाः । लङ्कायानिर्ययुर्वीराःप्रणदन्तःपुनःपुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 40017531, "chapter_id": 9263, "verse_number": "51", "content_sanskrit": "रक्षसांभूषणस्थाभिर्भाभिस्स्वाभिश्चसर्वशः । चक्रुस्तेसप्रभंव्योमहरयश्चाग्निभिस्सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 40017532, "chapter_id": 9263, "verse_number": "52", "content_sanskrit": "तत्रताराधिपस्याभाताराणां च तथैव च । तयोराभरणासा च बलयोर्द्यामभासयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 40017533, "chapter_id": 9263, "verse_number": "53", "content_sanskrit": "चन्द्राभाभूषणाभा च गृहाणांसागरःपुनः । हरिराक्षससैन्यानिभ्राजयामाससर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 40017534, "chapter_id": 9263, "verse_number": "54", "content_sanskrit": "तत्रचोर्ध्वंप्रदीप्तानांगृहाणांसागरःपुनः । भाभिस्संसक्तसलिलश्चलोर्मिश्शुशुभेऽधिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 40017535, "chapter_id": 9263, "verse_number": "55", "content_sanskrit": "पताकाध्वजसंसक्तमुत्तमासिपरश्वधम् । भीमाश्वरथमातङ्गंनानापततिसमाकुलम् ॥ दीप्तशूलगदाखडगप्रासतोमरकार्मुकम् । तद्राक्षसबलंघोरभीमंविक्रमपौरुषम् ॥ ददृशेज्वलितप्रासंकिङ्किणीशतनादितम् । हेमजालाचितभुजंव्यावेष्टितपरश्वथम् ॥ व्याघूर्णितमहाशस्त्रंबाणसंसक्तकार्मुकम् । गन्धमाल्यमधूत्सेकसम्मोदितमहानिलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 40017536, "chapter_id": 9263, "verse_number": "56", "c