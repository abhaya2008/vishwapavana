[{"id": 6000209000, "chapter_id": 10209, "verse_number": null, "content_sanskrit": "अथ त्रयोदशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000209001, "chapter_id": 10209, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.001.m4a", "display_order": 2}, {"id": 6000209002, "chapter_id": 10209, "verse_number": "१०-१३-१", "content_sanskrit": "ततश्च पौगण्डवयः श्रितौ व्रजे बभूवतुस्तौ पशुपालसम्मतौ।\nगाश्चारयन्तौ सखिभिः समं पदैर्वृन्दावनं पुण्यमतीव चक्रतुः॥ १०/१३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.002.m4a", "display_order": 3, "topics": [{"text": "कृष्णबलरामाभ्यां गोचारणम्", "range": "१–१९"}]}, {"id": 6000209003, "chapter_id": 10209, "verse_number": "१०-१३-२", "content_sanskrit": "तन्माधवो वेणुमुदीरयन् वृतो गोपैर्गृणद्भिः स्वयशो बलान्वितः।\nपशून् पुरस्कृत्य पशव्यमाविशद् विहर्तुकामः कुसुमाकरं वनम्॥ १०/१३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.003.m4a", "display_order": 4}, {"id": 6000209004, "chapter_id": 10209, "verse_number": "१०-१३-३", "content_sanskrit": "तन्मञ्जुघोषालिमृगद्विजाकुलं महन्मनःप्रख्यपयःसरस्वता।\nवातेन जुष्टं शतपत्रगन्धिना निरीक्ष्य रन्तुं भगवान् मनो दधे॥ १०/१३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.004.m4a", "display_order": 5}, {"id": 6000209005, "chapter_id": 10209, "verse_number": "१०-१३-४", "content_sanskrit": "स तत्र तत्रारुणपल्लवश्रिया फलप्रसूनोरुभरेण पादयोः।\nस्पृशच्छिखान् वीक्ष्य वनस्पतीन् मुदा स्मयन्निवाहाग्रजमादिपूरुषः॥ १०/१३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.005.m4a", "display_order": 6}, {"id": 6000209006, "chapter_id": 10209, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.006.m4a", "display_order": 7}, {"id": 6000209007, "chapter_id": 10209, "verse_number": "१०-१३-५", "content_sanskrit": "अहो अमी देववरामरार्चितं पदाम्बुजं ते सुमनःफलार्हणम्।\nनमन्त्युपादाय शिखाभिरात्मनस्तमोपहत्यै तरुजन्म यत्कृतम्॥ १०/१३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.007.m4a", "display_order": 8}, {"id": 6000209008, "chapter_id": 10209, "verse_number": "१०-१३-६", "content_sanskrit": "एतेऽलिनस्तव यशोऽखिललोकतीर्थं गायन्त आदिपुरुषानुपथं भजन्ते।\nप्रायो अमी मुनिगणा भवदीयमुख्या गूढं वनेऽपि न जहत्यमरात्मदैवम्॥ १०/१३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.008.m4a", "display_order": 9}, {"id": 6000209009, "chapter_id": 10209, "verse_number": "१०-१३-७", "content_sanskrit": "नृत्यन्त्यमी शिखिन ईड्य मुदा हरिण्यः कुर्वन्ति गोप्य इव ते प्रियमीक्षणेन।\nसूक्तैश्च कोकिलगणा गृहमागताय धन्या वनौकस इयान् हि सतां निसर्गः॥ १०/१३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.009.m4a", "display_order": 10}, {"id": 6000209010, "chapter_id": 10209, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.010.m4a", "display_order": 11}, {"id": 6000209011, "chapter_id": 10209, "verse_number": "१०-१३-८", "content_sanskrit": "एवं वृन्दावनं कृष्णः श्रीमत् प्रीतमनाः पशून्।\nरेमे सञ्चारयन्नद्रेः सरिद्रोधस्सु सानुगः॥ १०/१३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.011.m4a", "display_order": 12}, {"id": 6000209012, "chapter_id": 10209, "verse_number": "१०-१३-९", "content_sanskrit": "क्‍वचिद् गायति गायत्सु मदान्धालिष्वनुव्रतैः।\nउपगीयमानचरितः सखिसङ्कर्षणान्वितः॥ १०/१३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.012.m4a", "display_order": 13}, {"id": 6000209013, "chapter_id": 10209, "verse_number": "१०-१३-१०", "content_sanskrit": "क्‍वचिच्च कलहंसानामनु कूजति कूजितम्।\nअभिनृत्यति नृत्यन्तं बर्हिणं हासयन्क्‍वचित्॥ १०/१३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.013.m4a", "display_order": 14}, {"id": 6000209014, "chapter_id": 10209, "verse_number": "१०-१३-११", "content_sanskrit": "मेघगम्भीरया वाचा नामभिर्दूरगान् पशून्।\nक्‍वचिदाह्वयति प्रीत्या गोगोपालमनोज्ञया॥ १०/१३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.014.m4a", "display_order": 15}, {"id": 6000209015, "chapter_id": 10209, "verse_number": "१०-१३-१२", "content_sanskrit": "चकोरक्रौञ्चचक्राह्वभारद्वाजालिबर्हिणाम्।\nअनुरौति स्म सत्त्वानां भीतवद् व्याघ्रसिंहयोः॥ १०/१३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.015.m4a", "display_order": 16}, {"id": 6000209016, "chapter_id": 10209, "verse_number": "१०-१३-१३", "content_sanskrit": "क्‍वचित् क्रीडापरिश्रान्तं गोपोत्सङ्गोपबर्हणम्।\nस्वयं विश्रामयत्यार्यं पादसंवाहनादिभिः॥ १०/१३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.016.m4a", "display_order": 17}, {"id": 6000209017, "chapter_id": 10209, "verse_number": "१०-१३-१४", "content_sanskrit": "नृत्यतो गायतो वाऽपि वल्गतो युध्यतो मिथः।\nगृहीतहस्तौ गोपालान् हसन्तौ प्रशशंसतुः॥ १०/१३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.017.m4a", "display_order": 18}, {"id": 6000209018, "chapter_id": 10209, "verse_number": "१०-१३-१५", "content_sanskrit": "क्‍वचित् पल्लवतल्पेषु नियुद्धश्रमकर्शितः।\nवृक्षमूलाश्रयः शेते गोपोत्सङ्गोपबर्हणः॥ १०/१३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.018.m4a", "display_order": 19}, {"id": 6000209019, "chapter_id": 10209, "verse_number": "१०-१३-१६", "content_sanskrit": "पादसंवाहनं चक्रुः केचित् तस्य महात्मनः।\nअपरे हतपाप्मानो व्यजनैः समवीजयन्॥ १०/१३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.019.m4a", "display_order": 20}, {"id": 6000209020, "chapter_id": 10209, "verse_number": "१०-१३-१७", "content_sanskrit": "अन्ये तदनुरूपाणि मनोज्ञानि महात्मनः।\nगायन्ति स्म महाराज स्नेहक्लिन्नधियः शनैः॥ १०/१३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.020.m4a", "display_order": 21}, {"id": 6000209021, "chapter_id": 10209, "verse_number": "१०-१३-१८", "content_sanskrit": "एवं निगूढात्ममतिः स्वमायया गोपात्मजत्वं चरितैर्विडम्बयन्।\nरेमे रमालालितपादपल्लवो ग्राम्यैः समं ग्राम्यवदीशचेष्टितम्॥ १०/१३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.021.m4a", "display_order": 22}, {"id": 6000209022, "chapter_id": 10209, "verse_number": "१०-१३-१९", "content_sanskrit": "धन्येयमद्य धरणी तृणवीरुधस्तत्पादस्पृशो द्रुमलताः करजाभिमृष्टाः।\nनद्योऽद्रयः खगमृगाः सदयावलोकैर्गोप्योऽन्तरेण भुजयोरपि यत्स्पृहा श्रीः॥ १०/१३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.022.m4a", "display_order": 23}, {"id": 6000209023, "chapter_id": 10209, "verse_number": "१०-१३-२०", "content_sanskrit": "श्रीदामा नाम गोपालो रामकेशवयोः सखा।\nसुबलाशोककृष्णाद्यान् गोपान् प्रेम्णेदमब्रवीत्॥ १०/१३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.023.m4a", "display_order": 24, "topics": [{"text": "बलरामेण रासभरूपिणो धेनुकासुरस्य वधः", "range": "२०–४६"}]}, {"id": 6000209024, "chapter_id": 10209, "verse_number": "१०-१३-२१", "content_sanskrit": "राम राम महासत्त्व कृष्ण दुष्टनिबर्हण।\nइतोऽविदूरे सुमहद्वनं तालालिसङ्कुलम्॥ १०/१३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.024.m4a", "display_order": 25}, {"id": 6000209025, "chapter_id": 10209, "verse_number": "१०-१३-२२", "content_sanskrit": "फलानि तत्र भूरीणि पतन्ति पतितानि च।\nसन्ति किन्त्ववरुद्धानि धेनुकेन दुरात्मना॥ १०/१३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.025.m4a", "display_order": 26}, {"id": 6000209026, "chapter_id": 10209, "verse_number": "१०-१३-२३", "content_sanskrit": "सोऽतितीव्रोऽसुरो राम हे कृष्ण खररूपधृक्।\nआत्मतुल्यबलैरन्यैर्ज्ञातिभिर्बहुभिर्वृतः॥ १०/१३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.026.m4a", "display_order": 27}, {"id": 6000209027, "chapter_id": 10209, "verse_number": "१०-१३-२४", "content_sanskrit": "तस्मात् कृतनराहाराद् भीतैर्नृभिरमित्रहन्।\nन सेव्यते पशुगणैः पक्षिसङ्घैर्विवर्जितम्॥ १०/१३/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.027.m4a", "display_order": 28}, {"id": 6000209028, "chapter_id": 10209, "verse_number": "१०-१३-२५", "content_sanskrit": "विद्यन्तेऽभुक्तपूर्वाणि फलानि सुरभीणि च।\nएष वै सुरभिर्गन्धो विषूचीनो विगृह्यते॥ १०/१३/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.028.m4a", "display_order": 29}, {"id": 6000209029, "chapter_id": 10209, "verse_number": "१०-१३-२६", "content_sanskrit": "प्रयच्छ तानि नः कृष्ण गन्धलोभितचेतसाम्।\nवाञ्छाऽऽसीन्महती राम गम्यतां यदि रोचते॥ १०/१३/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.029.m4a", "display_order": 30}, {"id": 6000209030, "chapter_id": 10209, "verse_number": "१०-१३-२७", "content_sanskrit": "एवं सुहृद्वचः श्रुत्वा सुहृत्प्रियचिकीर्षया।\nप्रहस्य जग्मतुर्गोपैर्वृतं तालवनं प्रभू॥ १०/१३/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.030.m4a", "display_order": 31}, {"id": 6000209031, "chapter_id": 10209, "verse_number": "१०-१३-२८", "content_sanskrit": "बलः प्रविश्य बाहुभ्यां तालान् सम्परिकम्पयन्।\nफलानि पातयामास मतङ्गज इवौजसा॥ १०/१३/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.031.m4a", "display_order": 32}, {"id": 6000209032, "chapter_id": 10209, "verse_number": "१०-१३-२९", "content_sanskrit": "फलानां पततां शब्दं निशम्यासुररासभः।\nअभ्यधावत् क्षितितलं सनगं परिकम्पयन्॥ १०/१३/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.032.m4a", "display_order": 33}, {"id": 6000209033, "chapter_id": 10209, "verse_number": "१०-१३-३०", "content_sanskrit": "समेत्य तरसाऽऽवृत्य द्वाभ्यां पद्भ्यां बलं बली।\nनिहत्योरसि काशब्दं मुञ्चन् पर्यचरद् बलम्॥ १०/१३/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.033.m4a", "display_order": 34}, {"id": 6000209034, "chapter_id": 10209, "verse_number": "१०-१३-३१", "content_sanskrit": "पुनरासाद्य संरब्ध उपक्रोष्टुं पराक् स्थितः।\nचरणावपरौ राजन् बलाय प्राहिणोद् रुषा॥ १०/१३/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.034.m4a", "display_order": 35}, {"id": 6000209035, "chapter_id": 10209, "verse_number": "१०-१३-३२", "content_sanskrit": "स तं गृहीत्वाऽथ पदोर्भ्रामयित्वैकपाणिना।\nचिक्षेप तृणराजाग्रे भ्रामणत्यक्तजीवितम्॥ १०/१३/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.035.m4a", "display_order": 36}, {"id": 6000209036, "chapter_id": 10209, "verse_number": "१०-१३-३३", "content_sanskrit": "तेनाहतो महातालः पतमानो बृहच्छिराः।\nपार्श्वस्थं कम्पयन् भग्नः स चान्यं सोऽपि चापरम्॥ १०/१३/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.036.m4a", "display_order": 37}, {"id": 6000209037, "chapter_id": 10209, "verse_number": "१०-१३-३४", "content_sanskrit": "बलस्य लीलयोत्सृष्टखरदेहहताहताः।\nतालाश्चकम्पिरे सर्वे महावातेरिता इव॥ १०/१३/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.037.m4a", "display_order": 38}, {"id": 6000209038, "chapter_id": 10209, "verse_number": "१०-१३-३५", "content_sanskrit": "नैतच्चित्रं भगवति ह्यनन्ते जगदीश्वरे।\nओतप्रोतमिदं यस्मिन् तन्तुष्वङ्ग यथा पटः॥ १०/१३/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.038.m4a", "display_order": 39}, {"id": 6000209039, "chapter_id": 10209, "verse_number": "१०-१३-३६", "content_sanskrit": "ततः कृष्णं च रामं च ज्ञातयो धेनुकस्य ये।\nक्रोष्टारोऽभ्यद्रवन् सर्वे संरब्धा हतबान्धवाः॥ १०/१३/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.039.m4a", "display_order": 40}, {"id": 6000209040, "chapter_id": 10209, "verse_number": "१०-१३-३७", "content_sanskrit": "तांस्तानापततः कृष्णो रामश्च नृप लीलया।\nगृहीतपश्चाच्चरणान् प्राहिणोत् तृणराजसु॥ १०/१३/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.040.m4a", "display_order": 41}, {"id": 6000209041, "chapter_id": 10209, "verse_number": "१०-१३-३८", "content_sanskrit": "फलप्रकरसङ्कीर्णा दैत्यदेहैर्गतासुभिः।\nरराज भूः सतालाग्रैर्घनैरिव नभस्तलम्॥ १०/१३/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.041.m4a", "display_order": 42}, {"id": 6000209042, "chapter_id": 10209, "verse_number": "१०-१३-३९", "content_sanskrit": "तयोस्तत् सुमहत्कर्म निशाम्य विबुधादयः।\nमुमुचुः पुष्पवर्षाणि चक्रुर्वाद्यानि तुष्टुवुः॥ १०/१३/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.042.m4a", "display_order": 43}, {"id": 6000209043, "chapter_id": 10209, "verse_number": "१०-१३-४०", "content_sanskrit": "अथ तालफलान्यादन् मनुष्या गतसाध्वसाः।\nतृणं च पशवश्चेरुर्हतधेनुककानने॥ १०/१३/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.043.m4a", "display_order": 44}, {"id": 6000209044, "chapter_id": 10209, "verse_number": "१०-१३-४१", "content_sanskrit": "कृष्णः कमलपत्राक्षः पुण्यश्रवणकीर्तनः।\nस्तूयमानोऽनुगैर्गोपैः साग्रजो व्रजमाव्रजत्॥ १०/१३/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.044.m4a", "display_order": 45}, {"id": 6000209045, "chapter_id": 10209, "verse_number": "१०-१३-४२", "content_sanskrit": "तं गोरजश्छुरितकुन्तलबद्धबर्हवन्यप्रसूनरुचिरेक्षणचारुहासम्।\nवेणुं क्‍वणन्तमनुगैरुपगीतकीर्तिं गोप्यो दिदृक्षितदृशोऽभ्यगमन् समेताः॥ १०/१३/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.045.m4a", "display_order": 46}, {"id": 6000209046, "chapter_id": 10209, "verse_number": "१०-१३-४३", "content_sanskrit": "पीत्वा मुकुन्दमुखसारघमक्षिभृङ्गैस्तापं जहुर्विरहजं व्रजयोषितोऽह्नि।\nतत्सत्कृतिं समधिगम्य विवेश गोष्ठं सव्रीडहासविगमो यदपाङ्गमोक्षः॥ १०/१३/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.046.m4a", "display_order": 47}, {"id": 6000209047, "chapter_id": 10209, "verse_number": "१०-१३-४४", "content_sanskrit": "तदा यशोदारोहिण्यौ पुत्रयोः पुत्रवत्सले।\nयथाकालं यथाकामं व्यधत्तां परमाशिषः॥ १०/१३/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.047.m4a", "display_order": 48}, {"id": 6000209048, "chapter_id": 10209, "verse_number": "१०-१३-४५", "content_sanskrit": "विगताध्वश्रमौ तत्र मज्जनोन्मर्दनादिभिः।\nनीवीं वसित्वा रुचिरां दिव्यस्रग्गन्धमण्डितौ॥ १०/१३/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.048.m4a", "display_order": 49}, {"id": 6000209049, "chapter_id": 10209, "verse_number": "१०-१३-४६", "content_sanskrit": "जनन्युपहृतं प्राश्य स्वाद्वन्नमुपलालितौ।\nसंविश्य मृदुशय्यायां सुखं सुषुपतुर्व्रजे॥ १०/१३/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.049.m4a", "display_order": 50}, {"id": 6000209050, "chapter_id": 10209, "verse_number": "१०-१३-४७", "content_sanskrit": "एवं स भगवान् कृष्णो वृन्दावनचरः क्‍वचित्।\nययौ राममृते राजन् कालिन्दीं सखिभिर्वृतः॥ १०/१३/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.050.m4a", "display_order": 51, "topics": [{"text": "कालियविषदूषितकालिन्दीजलपानमृतानां गवां गोपानां च कृष्णेनोज्जीवनम्", "range": "४७–५२"}]}, {"id": 6000209051, "chapter_id": 10209, "verse_number": "१०-१३-४८", "content_sanskrit": "अथ गावश्च गोपाश्च निदाघातपपीडिताः।\nदुष्टं जलं पपुस्तस्यास्तृषार्ता विषदूषितम्॥ १०/१३/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.051.m4a", "display_order": 52}, {"id": 6000209052, "chapter_id": 10209, "verse_number": "१०-१३-४९", "content_sanskrit": "विषाम्भस्तदुपस्पृश्य दैवोपहतचेतसः।\nनिपेतुर्व्यसवः सर्वे मूर्छिता वै कुरूद्वह॥ १०/१३/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.052.m4a", "display_order": 53}, {"id": 6000209053, "chapter_id": 10209, "verse_number": "१०-१३-५०", "content_sanskrit": "वीक्ष्य तान् वै तथाभूतान् कृष्णो योगेश्वरेश्वरः।\nईक्षयाऽमृतवर्षिण्या स्वनाथान् समजीवयत्॥ १०/१३/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.053.m4a", "display_order": 54}, {"id": 6000209054, "chapter_id": 10209, "verse_number": "१०-१३-५१", "content_sanskrit": "ते सम्प्रतीतस्मृतय उत्थाय च जलान्तिकात्।\nआसन् सुविस्मिताः सर्वे वीक्षमाणाः परस्परम्॥ १०/१३/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.054.m4a", "display_order": 55}, {"id": 6000209055, "chapter_id": 10209, "verse_number": "१०-१३-५२", "content_sanskrit": "अन्वमंसत तद् राजन् गोविन्दानुग्रहेक्षितम्।\nपीत्वा विषं परेतस्य पुनरुत्थानमात्मनः॥ १०/१३/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_013/BhP_10.013.055.m4a", "display_order": 56}, {"id": 6000209056, "chapter_id": 10209, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे त्रयोदशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]