[{"id": 2025122, "chapter_id": 1539, "verse_number": "३-१७७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2025123, "chapter_id": 1539, "verse_number": "३-१७७-१", "content_sanskrit": "तस्यां रात्र्यां व्यतीतायां धर्मराजो युधिष्ठिरः।\nउत्थायावश्यकार्याणि कृतवान्भ्रातृभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2025124, "chapter_id": 1539, "verse_number": "३-१७७-२", "content_sanskrit": "ततः संचोदयामास सोऽर्जुनं मातृनन्दनम्।\nदर्शयास्त्राणि कौन्तेय यैर्जिता दानवास्त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2025125, "chapter_id": 1539, "verse_number": "३-१७७-३", "content_sanskrit": "ततो धनंजयो राजन्देवैर्दत्तानि पाण्डवः।\nअस्त्राणि तानि दिव्यानि दर्शयामास भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2025126, "chapter_id": 1539, "verse_number": "३-१७७-४", "content_sanskrit": "यथान्यायं महातेजाः शौचं परममास्थितः।\n`नमस्कृत्य त्रिनेत्राय वासवाय च पाण्डवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2025127, "chapter_id": 1539, "verse_number": "३-१७७-५", "content_sanskrit": "गिरिकूबरपादाक्षं शुभवेणु त्रिवेणुमत्।\nपार्थिवं रथमास्थाय शोभमानो धनंजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2025128, "chapter_id": 1539, "verse_number": "३-१७७-६", "content_sanskrit": "दिव्येन संवृतस्तेन कवचेन सुवर्चसा।\nधनुरादाय गाण्डीवं देवदत्तं स वारिजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2025129, "chapter_id": 1539, "verse_number": "३-१७७-७", "content_sanskrit": "शोशुभ्यमानः कौन्तेय आनुपूर्व्यान्महाभुजः।\nअस्त्राणि तानि दिव्यानि दर्शनायोपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2025130, "chapter_id": 1539, "verse_number": "३-१७७-८", "content_sanskrit": "अथ प्रयोक्ष्यमाणेषु दिव्येष्वस्त्रेषु तेषु वै।\nसमाक्रान्ता मही पद्भ्यां समकम्पत सद्रुमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2025131, "chapter_id": 1539, "verse_number": "३-१७७-९", "content_sanskrit": "क्षुभिताः सरितश्चैव तथैव च महोदधिः।\nशैलाश्चापि व्यदीर्यन्त न ववौ च समीरणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2025132, "chapter_id": 1539, "verse_number": "३-१७७-१०", "content_sanskrit": "न बभासे सहस्रांशुर्न जज्वाल च पावकः।\nन वेदाः प्रतिभान्ति स्म द्विजातीनां कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2025133, "chapter_id": 1539, "verse_number": "३-१७७-११", "content_sanskrit": "अन्तर्भूमिगता ये च प्राणिनो जनमेजय।\nपीड्यमानाः समुत्थाय पाण्डवं पर्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2025134, "chapter_id": 1539, "verse_number": "३-१७७-१२", "content_sanskrit": "वेपमानाः प्राञ्जलयस्ते सर्वे विकृताननाः।\nदह्यमानास्तदाऽस्त्रैस्ते याचन्ति स्म धनंजयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2025135, "chapter_id": 1539, "verse_number": "३-१७७-१३", "content_sanskrit": "ततो ब्रह्मर्षयश्चैव सिद्धा ये च महर्षयः।\nजङ्गमानि च भूतानि सर्वाण्येवावतस्थिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2025136, "chapter_id": 1539, "verse_number": "३-१७७-१४", "content_sanskrit": "देवर्षयश्च प्रवरास्तथैव च दिवौकसः।\nयक्षराक्षसगन्धर्वास्तथैव च पतत्रिणः।\nखेचराणि च भूतानि सर्वाण्येवावतस्थिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2025137, "chapter_id": 1539, "verse_number": "३-१७७-१५", "content_sanskrit": "ततः पितामहश्चैव लोकपालाश्च सर्वशः।\nभगवांश्च महादेवः सगणोऽभ्याययौ तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2025138, "chapter_id": 1539, "verse_number": "३-१७७-१६", "content_sanskrit": "ततो वायुर्महाराज दिव्यैर्माल्यैः समन्वितः।\nअभितः पाण्डवंचित्रैरवचक्रे समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2025139, "chapter_id": 1539, "verse_number": "३-१७७-१७", "content_sanskrit": "जगुश्च गाथा विविधा गन्धर्वाः सुरचोदिताः।\nननृतुः सङ्घशश्चैव राजन्नप्सरसां गणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2025140, "chapter_id": 1539, "verse_number": "३-१७७-१८", "content_sanskrit": "तस्मिंश्च तादृशे काले नारदश्चोदितः सुरैः।\nआगम्याह वचः पार्थं श्रवणीयमिदं नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2025141, "chapter_id": 1539, "verse_number": "३-१७७-१९", "content_sanskrit": "अर्जुनार्जुन मा युङ्क्ष दिव्यान्यस्त्राणि भारत।\nनैतानि निरधिष्ठाने प्रयुज्यन्ते कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2025142, "chapter_id": 1539, "verse_number": "३-१७७-२०", "content_sanskrit": "अधिष्ठाने न वाऽनार्तः प्रयुञ्जीत कदाचन।\nप्रयोगेषु महान्दोषो ह्यस्त्राणां कुरुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2025143, "chapter_id": 1539, "verse_number": "३-१७७-२१", "content_sanskrit": "एतानि रक्ष्यमाणानि धनंजय यथागमम्।\nबलवन्ति सुखार्हाणि भविष्यन्ति न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2025144, "chapter_id": 1539, "verse_number": "३-१७७-२२", "content_sanskrit": "अरक्ष्यमाणान्येतानि त्रैलोक्यस्यापि पाण्डव।\nभवन्ति स्म विनाशाय मैवं भूयः कृथाः क्वचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2025145, "chapter_id": 1539, "verse_number": "३-१७७-२३", "content_sanskrit": "अजातशत्रो त्वं चैव द्रक्ष्यसे तानि संयुगे।\nयोज्यमानानि पार्थे नद्विषतामवमर्दने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2025146, "chapter_id": 1539, "verse_number": "३-१७७-२४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2025147, "chapter_id": 1539, "verse_number": "३-१७७-२४", "content_sanskrit": "निवार्याथ ततः पार्थं सर्वे देवा यथागतम्।\nजग्मुरन्ये च ये तत्र रसमाजग्मुर्नरर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2025148, "chapter_id": 1539, "verse_number": "३-१७७-२५", "content_sanskrit": "तेषु सर्वेषु कौरव्य प्रतियातेषु पाण्डवाः।\nतस्मिननेव वने हृष्टास्त ऊषुः सह कृष्णया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2025149, "chapter_id": 1539, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि निवातकवचयुद्धपर्वणि सप्तमप्तत्यधिकशततमोऽध्यायः ॥ १७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]