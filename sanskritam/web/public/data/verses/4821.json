[{"id": 2180427, "chapter_id": 4821, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2180428, "chapter_id": 4821, "verse_number": "१", "content_sanskrit": "श्रोतुमिच्छामि भगवन् विस्तरेण महामुने ।\nराजधर्मान् द्विजश्रेष्ठ चातुर्वर्ण्यस्य चाखिलान्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2180429, "chapter_id": 4821, "verse_number": "२", "content_sanskrit": "आपत्सु च यथा नीतिर्विधातव्या महीक्षिता ।\nधर्म्यमालम्ब्य पन्थानं विजयेयं कथं महीम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2180430, "chapter_id": 4821, "verse_number": "३", "content_sanskrit": "प्रायश्चित्तकथा ह्येषा भक्ष्याभक्ष्यविवर्जिता ।\nकौतूहलानुप्रवणा हर्षं जनयतीव मे\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2180431, "chapter_id": 4821, "verse_number": "४", "content_sanskrit": "धर्मचर्या च राज्यं च नित्यमेव विरुद्ध्यते ।\nयेन मुह्यति मे चेतश्चिन्तयानस्य नित्यशः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2180432, "chapter_id": 4821, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2180433, "chapter_id": 4821, "verse_number": "५", "content_sanskrit": "तमुवाच महातेजा व्यासो वेदविदांवरः ।\nनारदं समभिप्रेक्ष्य सर्वं जानन् पुरातनम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2180434, "chapter_id": 4821, "verse_number": "६", "content_sanskrit": "श्रोतुमिच्छसि चेद् धर्मानखिलेन युधिष्ठिर ।\nप्रैहि भीष्मं महाबाहो वृद्धं कुरुपितामहम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2180435, "chapter_id": 4821, "verse_number": "७", "content_sanskrit": "स ते सर्वरहस्येषु संशयान् मनसि स्थितान् ।\nछेत्ता भागीरथीपुत्रः सर्वज्ञः सर्वधर्मवित्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2180436, "chapter_id": 4821, "verse_number": "८", "content_sanskrit": "जनयामास यं देवी दिव्या त्रिपथगा नदी ।\nसाक्षाद् ददर्श यो देवान् सर्वान् शक्रपुरोगमान्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2180437, "chapter_id": 4821, "verse_number": "९", "content_sanskrit": "बृहस्पतिपुरोगांश्च देवर्षीनसकृत् प्रभुः ।\nतोषयित्वोपचारेण राजनीतिमधीतवान्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2180438, "chapter_id": 4821, "verse_number": "१०", "content_sanskrit": "उशना वेद यच्छास्त्रं यच्च देवगुरुर्द्विजः ।\nतच्च सर्वं सवैयाख्यं प्राप्तवान् कुरुसत्तमः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2180439, "chapter_id": 4821, "verse_number": "११", "content_sanskrit": "भार्गवाच्च्यवनाच्चापि वेदानङ्गोपबृंहितान् ।\nप्रतिपेदे महाबुद्धिवर्सिष्ठाच्च यतव्रतात्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2180440, "chapter_id": 4821, "verse_number": "१२", "content_sanskrit": "पितामहसुतं ज्येष्ठं कुमारं दीप्ततेजसम् ।\nअध्यात्मगतितत्त्वज्ञमुपाशिक्षत यः पुरा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2180441, "chapter_id": 4821, "verse_number": "१३", "content_sanskrit": "मार्कण्डेयमुखात् कृत्स्नं यतिधर्ममवाप्तवान् ।\nरामादस्त्राणि शक्राच्च प्राप्तवान् भरतर्षभ\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2180442, "chapter_id": 4821, "verse_number": "१४", "content_sanskrit": "मृत्युरात्मेच्छया यस्य जातस्य मनुजेष्वपि ।\nतथाऽनपत्यस्य सतः पुण्यश्लोका दिवि श्रुताः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2180443, "chapter_id": 4821, "verse_number": "१५", "content_sanskrit": "यस्य ब्रह्मर्षयः पुण्या नित्यमासन् सभासदः ।\nयस्य नाविदितं किञ्चिज्ज्ञानज्ञेयेषु विद्यते\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2180444, "chapter_id": 4821, "verse_number": "१६", "content_sanskrit": "स ते वक्ष्यति धर्मज्ञः सूक्ष्मधर्मार्थतत्त्ववित् ।\nतमभ्येहि पुरा प्राणान् स विमुञ्चति धर्मवित्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2180445, "chapter_id": 4821, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2180446, "chapter_id": 4821, "verse_number": "१७", "content_sanskrit": "एवमुक्तस्तु कौन्तेयो दीर्घप्रज्ञो महाद्युतिः ।\nउवाच वदतां श्रेष्ठं व्यासं सत्यवतीसुतम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2180447, "chapter_id": 4821, "verse_number": "१८", "content_sanskrit": "वैशसं सुमहत् कृत्वा ज्ञातीनां लोमहर्षणम् ।\nआगस्कृत् सर्वलोकस्य पृथिवीनाशकारकः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2180448, "chapter_id": 4821, "verse_number": "१९", "content_sanskrit": "घातयित्वा तमेवाजौ छलेनाजिह्मयोधिनम् ।\nउपसम्प्रष्टुमर्हामि तमहं केन हेतुना\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2180449, "chapter_id": 4821, "verse_number": "२०", "content_sanskrit": "ततस्तं नृपतिश्रेष्ठं चातुर्वर्ण्यहितेप्सया ।\nपुनराह महाबाहुर्यदुश्रेष्ठो महाद्युतिः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2180450, "chapter_id": 4821, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2180451, "chapter_id": 4821, "verse_number": "२१", "content_sanskrit": "नेदानीमतिनिर्बन्धं शोके कर्तुमिहार्हसि ।\nयदाह भगवान् व्यासस्तत् कुरुष्व नृपोत्तम\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2180452, "chapter_id": 4821, "verse_number": "२२", "content_sanskrit": "ब्राह्मणास्त्वां महाबाहो भ्रातरश्च महौजसः ।\nपर्जन्यमिव घर्मार्ता आशंसाना उपासते\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2180453, "chapter_id": 4821, "verse_number": "२३", "content_sanskrit": "हतशिष्टाश्च राजानः कृत्स्नं चैव समागतम् ।\nचातुर्वर्ण्यं महाराज राष्ट्रं ते कुरुजाङ्गलम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2180454, "chapter_id": 4821, "verse_number": "२४", "content_sanskrit": "प्रियार्थमपि चैतेषां ब्राह्मणानां महात्मनाम् ।\nनियोगादस्य च गुरोर्व्यासस्यामिततेजसः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2180455, "chapter_id": 4821, "verse_number": "२५", "content_sanskrit": "सुहृदां चास्मदादीनां द्रौपद्याश्च परन्तप ।\nकुरु प्रियममित्रघ्न लोकस्य च हितं कुरु\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2180456, "chapter_id": 4821, "verse_number": "२६", "content_sanskrit": "एवमुक्तस्तु कृष्णेन राजा राजीवलोचनः ।\nहितार्थं सर्वलोकस्य समुत्तस्थौ महातपाः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2180457, "chapter_id": 4821, "verse_number": "२७", "content_sanskrit": "सोऽनुनीतो नरव्याघ्रो विष्टरश्रवसा स्वयम् ।\nद्वैपायनेन च तथा देवस्थानेन जिष्णुना\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2180458, "chapter_id": 4821, "verse_number": "२८", "content_sanskrit": "एतैश्चान्यैश्च बहुभिरनुनीतो युधिष्ठिरः ।\nव्यजहान्मानसं दुःखं सन्तापं च महामनाः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2180459, "chapter_id": 4821, "verse_number": "२९", "content_sanskrit": "श्रुतवाक्यः श्रुतनिधिः श्रुतश्रव्यविशारदः ।\nव्यवस्य मनसः शान्तिमगच्छत् पाण्डुनन्दनः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2180460, "chapter_id": 4821, "verse_number": "३०", "content_sanskrit": "स तैः परिवृतो राजा नक्षत्रैरिव चन्द्रमाः ।\nधृतराष्ट्रं पुरस्कृत्य स्वपुरं प्रविवेश ह\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2180461, "chapter_id": 4821, "verse_number": "३१", "content_sanskrit": "प्रविविक्षुः स धर्मज्ञः कुन्तीपुत्रो युधिष्ठिरः ।\nअर्चयामास देवांश्च ब्राह्मणांश्च सहस्रशः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2180462, "chapter_id": 4821, "verse_number": "३२", "content_sanskrit": "ततो रथं नवं शुभ्रं कम्बळाजिनसंवृतम् ।\nयुक्तं षोडशभिर्गोभिः पाण्डरैः शुभलक्षणैः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2180463, "chapter_id": 4821, "verse_number": "३३", "content_sanskrit": "मन्त्रैरभ्यर्चितः पुण्यैः स्तूयमानो महर्षिभिः ।\nआरुरोह यथा देवः सोमोऽमृतमयं रथम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2180464, "chapter_id": 4821, "verse_number": "३४", "content_sanskrit": "जग्राह रश्मीन् कौन्तेयो भीमो भीमपराक्रमः ।\nअर्जुनः पाण्डरं छत्रं धारयामास भानुमत्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2180465, "chapter_id": 4821, "verse_number": "३५", "content_sanskrit": "ध्रियमाणं तु तच्छत्रं पाण्डरस्तस्य मूर्धनि ।\nशुशुभे तारकाराजसितमभ्रमिवाम्बरे\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2180466, "chapter_id": 4821, "verse_number": "३६", "content_sanskrit": "चामरव्यजने चास्य वीरौ जगृहतुस्तदा ।\nचन्द्ररिश्मप्रभे शुभ्रे माद्रीपुत्रावलङ्कृते\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2180467, "chapter_id": 4821, "verse_number": "३७", "content_sanskrit": "ते पञ्च रथमास्थाय भ्रातरः समलङ्कृताः ।\nभूतानीव समस्तानि राजन् ददृशिरे तदा\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2180468, "chapter_id": 4821, "verse_number": "३८", "content_sanskrit": "आस्थाय तु रथं शुभ्रं युक्तमश्वैर्महाजवैः ।\nअन्वयात् पृष्ठतो राजन् युयुत्सुः पाण्डवाग्रजम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2180469, "chapter_id": 4821, "verse_number": "३९", "content_sanskrit": "रथं हेममयं शुभ्रं सैन्यसुग्रीवयोजितम् ।\nसह सात्यकिना कृष्णः समास्थायान्वयात् कुरून्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2180470, "chapter_id": 4821, "verse_number": "४०", "content_sanskrit": "नरयानेन तु ज्येष्ठः पिता पार्थस्य भारत ।\nअग्रतो धर्मराजस्य गान्धारीसहितो ययौ\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2180471, "chapter_id": 4821, "verse_number": "४१", "content_sanskrit": "कुरुस्त्रियश्च ताः सर्वाः कुन्ती कृष्णा च द्रौपदी ।\nयानैरुच्चावचैर्जग्मुर्विदुरेण पुरस्कृताः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2180472, "chapter_id": 4821, "verse_number": "४२", "content_sanskrit": "ततो रथाश्च बहुला नागाश्च समलङ्कृताः ।\nपादाताश्च हयाश्चैव पृष्ठतः समनुव्रजन्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2180473, "chapter_id": 4821, "verse_number": "४३", "content_sanskrit": "ततो वैतालिकैः सूतैर्मागधैश्च सुभाषितैः ।\nस्तूयमानो ययौ राजा नगरं नागसाह्वयम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2180474, "chapter_id": 4821, "verse_number": "४४", "content_sanskrit": "तत् प्रयाणं महाबाहोर्बभूवाप्रतिमं भुवि ।\nआकुलाकुलमुत्क्रुष्टं हृष्टपुष्टजनान्वितम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2180475, "chapter_id": 4821, "verse_number": "४५", "content_sanskrit": "अभियाने तु पार्थस्य नरैर्नगरवासिभिः ।\nनगरं राजमार्गश्च यथावत् समलङ्कृतम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2180476, "chapter_id": 4821, "verse_number": "४६", "content_sanskrit": "पाण्डरेण च माल्येन पताकाभिश्च वेदिभिः ।\nसंवृतो राजमार्गश्च धूपनैश्च सुधूपितः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2180477, "chapter_id": 4821, "verse_number": "४७", "content_sanskrit": "अथ चूर्णैश्च गन्धानां नानापुष्पैः प्रियङ्गुभिः ।\nमाल्यदामभिरासक्तैः राजवेश्माभिसंवृतम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2180478, "chapter_id": 4821, "verse_number": "४८", "content_sanskrit": "कुम्भाश्च नगरद्वारि वारिपूर्णा दृढा नवाः ।\nकन्याः सुमनसश्छागाः स्थापितास्तत्र तत्र ह\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2180479, "chapter_id": 4821, "verse_number": "४९", "content_sanskrit": "तथा स्वलङ्कृतद्वारं नगरं पाण्डुनन्दनः ।\nस्तूयमानः शुभैर्वाक्यैः प्रविवेश सुहृद्वृतः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2180480, "chapter_id": 4821, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे अष्टत्रिंशोऽध्यायः ॥ ३८ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]