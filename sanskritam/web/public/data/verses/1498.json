[{"id": 2023281, "chapter_id": 1498, "verse_number": "३-१३६-०x", "content_sanskrit": "अष्टावक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2023282, "chapter_id": 1498, "verse_number": "३-१३६-१", "content_sanskrit": "अत्रोग्रसेनसमितेषु राजन्\nसमागतेष्वप्रतिमेषु राजसु।\nन मे विवित्सान्तरमस्ति वादिनां\nमहाजने हंसविवादिनामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2023283, "chapter_id": 1498, "verse_number": "३-१३६-२", "content_sanskrit": "न मोक्ष्यसे वै वदमानो निमज्जन्\nजलं प्रपन्नः सरितामिवाधनः।\nहुताशनस्येव समिद्धतेजसः\nस्थिरो भवस्वेह ममाद्य वन्दिन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2023284, "chapter_id": 1498, "verse_number": "३-१३६-३x", "content_sanskrit": "वन्द्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2023285, "chapter_id": 1498, "verse_number": "३-१३६-३", "content_sanskrit": "व्याघ्रं शयानं प्रति मा प्रबोध\nआशीविषं सृक्विणी संलिहानम्।\nपदा हतस्येह शिरोभिहत्य\nनादष्टो वै मोक्ष्यसे तन्निबोध ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2023286, "chapter_id": 1498, "verse_number": "३-१३६-४", "content_sanskrit": "यो वै दर्पात्संहननोपपन्नः\nसुदुर्बलः पर्वतमाविहन्ति।\nतस्यैव पाणिः सनखो विदीर्यते\nन चैव शैलस्य हि दृश्यते व्रणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2023287, "chapter_id": 1498, "verse_number": "३-१३६-५x", "content_sanskrit": "अष्टावक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2023288, "chapter_id": 1498, "verse_number": "३-१३६-५", "content_sanskrit": "सर्वे राज्ञो मैथिलस्य मैनाकस्येव पर्वताः।\nनिकृष्टभूता राजानो वत्सा ह्यनडुहो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2023289, "chapter_id": 1498, "verse_number": "३-१३६-६", "content_sanskrit": "यथा महेन्द्रः प्रवरः सुराणां\nनदीषु गङ्गा प्रवरा यथैव।\nतथा नृपाणां प्रवरस्त्वमेको\nवन्दिं समभ्यानय मत्सकाशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2023290, "chapter_id": 1498, "verse_number": "३-१३६-७x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2023291, "chapter_id": 1498, "verse_number": "३-१३६-७", "content_sanskrit": "एवमष्टावक्रः समितौ हि गर्ज-\nञ्जातक्रोधो वन्दिनमाह राजन्।\nउक्ते वाक्ये चोत्तरं मे ब्रवीहि\nवाक्यस्य चाप्युत्तरं ते ब्रवीमि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2023292, "chapter_id": 1498, "verse_number": "३-१३६-८x", "content_sanskrit": "वन्द्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2023293, "chapter_id": 1498, "verse_number": "३-१३६-८", "content_sanskrit": "एक एवाग्निर्बहुधा समिध्यते\nएकः सूर्यः सर्वमिदं विभाति।\nएकोऽवीरो देवराजोऽरिहन्ता\nयमः पितृणामीश्वरश्चैक एव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2023294, "chapter_id": 1498, "verse_number": "३-१३६-९x", "content_sanskrit": "अष्टावक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2023295, "chapter_id": 1498, "verse_number": "३-१३६-९", "content_sanskrit": "द्वाविन्द्राग्नी चरतो वै सखायौ\nद्वौ देवर्षी नारदपर्वतौ च।\nद्वावश्विनौ द्वे रथस्यापि चक्रे\nभार्यापती द्वौ विहितौ विधात्रा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2023296, "chapter_id": 1498, "verse_number": "३-१३६-१०x", "content_sanskrit": "वन्द्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2023297, "chapter_id": 1498, "verse_number": "३-१३६-१०", "content_sanskrit": "त्रिः सूयते कर्मणा वै प्रजेयं\nत्रयो युक्ता वाजपेयं वहन्ति।\nअध्वर्यवस्त्रिसवनानि तन्वते\nत्रयो लोकास्त्रीणि ज्योतींषि चाहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2023298, "chapter_id": 1498, "verse_number": "३-१३६-११x", "content_sanskrit": "अष्टावक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2023299, "chapter_id": 1498, "verse_number": "३-१३६-११", "content_sanskrit": "चतुष्टयं ब्राह्मणानां निकेतं\nचत्वारो वर्णा यज्ञमिमं वहन्ति।\nदिशश्चतस्रो वर्णचतुष्टयं च\nचतुष्पदा गौरपि शश्वदुक्ता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2023300, "chapter_id": 1498, "verse_number": "३-१३६-१२x", "content_sanskrit": "वन्द्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2023301, "chapter_id": 1498, "verse_number": "३-१३६-१२", "content_sanskrit": "पञ्चाग्नयः पञ्चपदा च पङ्क्ति-\nर्यज्ञाः पञ्चैवाप्यथ पञ्चेनद्रियाणि।\nदृष्ट्वा वेदे पञ्चचूडाप्सराश्च\nलोके ख्यातं पञ्चनदं च पुण्यम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2023302, "chapter_id": 1498, "verse_number": "३-१३६-१३x", "content_sanskrit": "अष्टावक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2023303, "chapter_id": 1498, "verse_number": "३-१३६-१३", "content_sanskrit": "षडाधाने दक्षिणामाहुरेके\nषट् चैवेमे ऋतवः कालचक्रम्।\nषडिन्द्रियाण्युत षट् कृत्तिकाश्च\nषट् साद्यस्काः सर्ववेदेषु दृष्टाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2023304, "chapter_id": 1498, "verse_number": "३-१३६-१४x", "content_sanskrit": "वन्द्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2023305, "chapter_id": 1498, "verse_number": "३-१३६-१४", "content_sanskrit": "सप्त ग्राम्याः पशवः सप्त वन्याः\nसप्त च्छन्दांसि क्रतुमेकं वहन्ति।\nसप्तर्षयः सप्त चाप्यर्हणानि\nसप्तन्त्री प्रथिता चैव वीणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2023306, "chapter_id": 1498, "verse_number": "३-१३६-१५x", "content_sanskrit": "अष्टावक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2023307, "chapter_id": 1498, "verse_number": "३-१३६-१५", "content_sanskrit": "अष्टौ शाणाः शतमानं वहन्ति\nतथाष्टपादः शरभः सिंहघाती।\nअष्टौ वसूञ्शुश्रुम देवतासु\nयूपश्चाष्टास्रिर्विहितः सर्वयज्ञे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2023308, "chapter_id": 1498, "verse_number": "३-१३६-१६x", "content_sanskrit": "वन्द्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2023309, "chapter_id": 1498, "verse_number": "३-१३६-१६", "content_sanskrit": "नवैवोक्ताः सामिधेन्यः पितॄणां\nतथा प्राहुर्नवयोगं विसर्गम्।\nनवाक्षरा बृहती संप्रदिष्टा\nनवैव योगो गणनामेति शश्वत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2023310, "chapter_id": 1498, "verse_number": "३-१३६-१७x", "content_sanskrit": "अष्टावक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2023311, "chapter_id": 1498, "verse_number": "३-१३६-१७", "content_sanskrit": "दिशो दशोक्ताः पुरुषस्य लोके\nसहस्रमाहुर्दशपूर्णं शतानि।\nदशैव मासान्बिभ्रति भर्गवत्यो\nदशैरका दशदाशा दशार्हाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2023312, "chapter_id": 1498, "verse_number": "३-१३६-१८x", "content_sanskrit": "वन्द्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2023313, "chapter_id": 1498, "verse_number": "३-१३६-१८", "content_sanskrit": "एकादशैकादशिनः पशूना-\nमेकादशैवात्र भवन्ति यूपाः।\nएकादश प्राणभृतां विकारा\nएकादशोक्ता दिवि देवेषु रुद्राः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2023314, "chapter_id": 1498, "verse_number": "३-१३६-१९x", "content_sanskrit": "अष्टावक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2023315, "chapter_id": 1498, "verse_number": "३-१३६-१९", "content_sanskrit": "संवत्सरं द्वादशमासमाहु-\nर्जगत्याः पादो द्वादशैवाक्षराणि।\nद्वादशाहः प्राकृतो यज्ञ उक्तो\nद्वादशादित्यान्कथयन्तीह घीराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2023316, "chapter_id": 1498, "verse_number": "३-१३६-२०x", "content_sanskrit": "वन्द्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2023317, "chapter_id": 1498, "verse_number": "३-१३६-२०", "content_sanskrit": "त्रयोदशी तिथिरुक्ता महोग्रा\nत्रयोदशद्वीपवती मही च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2023318, "chapter_id": 1498, "verse_number": "३-१३६-२०x", "content_sanskrit": "लोमश उवाच।\nएतावदुक्त्वा विरराम वन्दी\nश्लोकस्यार्धं व्याजहाराष्टवक्रः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2023319, "chapter_id": 1498, "verse_number": "३-१३६-२०x", "content_sanskrit": "अष्टावक्र उवाच। त्रयोदशाहानि ससार केशी\nत्रयोदशादीन्यतिच्छन्दांसि चाहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2023320, "chapter_id": 1498, "verse_number": "३-१३६-२१x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2023321, "chapter_id": 1498, "verse_number": "३-१३६-२१", "content_sanskrit": "ततो महानुदतिष्ठन्निनाद-\nस्तूष्णींभूतं सूतपुत्रं निशम्य।\nअधोमुखं ध्यानपरं तदानी-\nमष्टावक्रं चाप्युदीर्यन्तमेव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2023322, "chapter_id": 1498, "verse_number": "३-१३६-२२", "content_sanskrit": "तस्मिंस्तथा संकुले वर्तमाने\nस्फीते यज्ञे जनकस्योत राज्ञः।\nअष्टावक्रं पूजयन्तोऽभ्युपेयु-\nर्विप्राः सर्वे प्राञ्जलयः प्रतीताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2023323, "chapter_id": 1498, "verse_number": "३-१३६-२३x", "content_sanskrit": "अष्टावक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2023324, "chapter_id": 1498, "verse_number": "३-१३६-२३", "content_sanskrit": "अनेनैव ब्राह्मणाः शुश्रुवांसो\nवादे जित्वा सलिले मज्जिताः प्राक्।\nतानेव धर्मानयमद्य वन्दी\nप्राप्नोतु गृह्याशु निमज्जयैनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2023325, "chapter_id": 1498, "verse_number": "३-१३६-२४x", "content_sanskrit": "वन्द्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2023326, "chapter_id": 1498, "verse_number": "३-१३६-२४", "content_sanskrit": "अहं पुत्रो वरुणस्योत राज्ञ-\nस्तत्रास सत्रं द्वादशवार्षिकं वै।\nसत्रेण ते जनक तुल्यकालं\nतदर्थं ते प्रहिता मे द्विजाग्र्याः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2023327, "chapter_id": 1498, "verse_number": "३-१३६-२५", "content_sanskrit": "ते तु सर्वे वरुणस्योत यज्ञं\nद्रष्टुं गता इम आयान्ति भूयः।\nअष्टावक्रं पूजये पूजनीयं\nयस्य हेतोर्जनितारं समेष्ये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2023328, "chapter_id": 1498, "verse_number": "३-१३६-२६x", "content_sanskrit": "अष्टावक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2023329, "chapter_id": 1498, "verse_number": "३-१३६-२६", "content_sanskrit": "विप्राः समुद्राम्भसि मज्जिता ये\nवाचा जिता मेधया वा विदानाः।\nतां मेधया वाचमथोज्जहार\nयथा वाचमवचिन्वन्ति सन्तः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2023330, "chapter_id": 1498, "verse_number": "३-१३६-२७", "content_sanskrit": "अग्निर्दहञ्जातवेदाः सतां, गृहान्\nविसर्जयंस्तेजसा न स्म धाक्षीत्।\nबालेषु पुत्रेषु कृपणं वदत्सु\nतथा वाचमवचिन्वन्ति सन्तः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2023331, "chapter_id": 1498, "verse_number": "३-१३६-२८", "content_sanskrit": "श्लेष्मातकी क्षीणवर्चाः शृणोषि\nउताहो त्वां स्तुतयो मादयन्ति।\nहस्तीव त्वं स्तुतयो मादयन्ति।\nन मामिकां वाचमिमां शृणोषि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2023332, "chapter_id": 1498, "verse_number": "३-१३६-२९x", "content_sanskrit": "जनक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2023333, "chapter_id": 1498, "verse_number": "३-१३६-२९", "content_sanskrit": "शृणोमि वाचं तव दिव्यरूपा-\nममानुषीं दिव्यरूपोऽसि साक्षात्।\nअजैषीर्यद्वन्द्विनं त्वं विवादे\nनिसृष्ट एष तव कामोऽद्य वन्दी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2023334, "chapter_id": 1498, "verse_number": "३-१३६-३०x", "content_sanskrit": "अष्टावक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2023335, "chapter_id": 1498, "verse_number": "३-१३६-३०", "content_sanskrit": "नानन जीवता कश्चिदर्थो मे वन्दिना नृप।\nपिता यद्यस्य वरुणो मज्जयैनं जलाशये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2023336, "chapter_id": 1498, "verse_number": "३-१३६-३१x", "content_sanskrit": "वन्द्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2023337, "chapter_id": 1498, "verse_number": "३-१३६-३१", "content_sanskrit": "अहं पुत्रो वरुणस्योत राज्ञो\nन मे भयं विद्यते मज्जितस्य।\nइमं मुहूर्तं पितरं द्रक्ष्यतेऽय-\nमष्टावक्रश्चिरनष्टं कहोळम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2023338, "chapter_id": 1498, "verse_number": "३-१३६-३२x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2023339, "chapter_id": 1498, "verse_number": "३-१३६-३२", "content_sanskrit": "ततस्ते पूजिता विप्रा वरुणेन महात्मना।\nउदतिष्ठंस्ततः सर्वे जनकस्य समीपतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2023340, "chapter_id": 1498, "verse_number": "३-१३६-३३x", "content_sanskrit": "कहोळ उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2023341, "chapter_id": 1498, "verse_number": "३-१३६-३३", "content_sanskrit": "इत्यर्थमिच्छन्ति सुताञ्जना जननकर्मणा।\nयदहं नाशकं कर्तुं तत्पुत्रः कृतवान्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2023342, "chapter_id": 1498, "verse_number": "३-१३६-३४", "content_sanskrit": "उताबलस्य क्लवानुत बालस्य पण्डितः।\nउत वाऽविदुषो विद्वान्पुत्रो जनक जायते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2023343, "chapter_id": 1498, "verse_number": "३-१३६-३५x", "content_sanskrit": "वन्द्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2023344, "chapter_id": 1498, "verse_number": "३-१३६-३५", "content_sanskrit": "शितेन ते परशुना स्वयमेवान्तको नृप।\nशिरांस्यपाहरन्नाजौ रिपूणां भद्रमस्तु ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2023345, "chapter_id": 1498, "verse_number": "३-१३६-३६", "content_sanskrit": "महदैक्थ्यं गीयते साम चाग्र्यं\nसम्यक्सोमः पीयते चात्र सत्रे।\nशुचीन्भागान्प्रतिजगृहुश्च हृष्टाः\nसाक्षाद्देवा जनकस्येह राज्ञः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2023346, "chapter_id": 1498, "verse_number": "३-१३६-३७x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2023347, "chapter_id": 1498, "verse_number": "३-१३६-३७", "content_sanskrit": "समुत्थितेष्वथ सर्वेषु राजन्\nविप्रेषु तेष्वधिकं सुप्रभेषु।\nअनुज्ञातो जनकेनाथ राज्ञा\nविवेश तोयं सागरस्योत वन्दी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2023348, "chapter_id": 1498, "verse_number": "३-१३६-३८", "content_sanskrit": "अष्टावक्रः पितरं पूजयित्वा\nसंपूजितो ब्राह्मणैस्तैर्यथावत्।\nप्रत्याजगामाश्रममेव चाग्र्यं\nजित्वा वन्दिं सहितो मातुलेन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2023349, "chapter_id": 1498, "verse_number": "३-१३६-३९", "content_sanskrit": "ततोऽष्टावक्रं मातुरथान्तिके पिता\nनदीं समङ्गां शीघ्रमिमां विशस्व।\nप्रोवाच चैनं स तथा विवेश\nसमैरङ्गैश्चापि बभूव पुण्या", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2023350, "chapter_id": 1498, "verse_number": "३-१३६-४०", "content_sanskrit": "नदी समङ्गा च बभूव पुण्या\nयस्यां स्नातो मुच्यते किल्बिषाद्धि।\nत्वमप्येनां स्नानपानावगाहैः\nसभ्रातृकः सहभार्यो विशश्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2023351, "chapter_id": 1498, "verse_number": "३-१३६-४१", "content_sanskrit": "अत्र कौन्तेय सहितो भ्रातृभिस्त्वं\nसुखोषितः सह विप्रैः प्रतीतः।\nपुण्यान्यन्यानि शुचिकर्मैकभक्ति-\nर्मया सार्धं चरितास्याजमीढ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2023352, "chapter_id": 1498, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि षट्त्रिंशदधिकशततमोऽध्यायः ॥ १३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]