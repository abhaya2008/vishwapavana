[{"id": 2039265, "chapter_id": 1861, "verse_number": "५-१०६-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2039266, "chapter_id": 1861, "verse_number": "५-१०६-१", "content_sanskrit": "अनर्थे जातिनिर्बन्धं परार्थे लोभमोहितम्।\nअनार्यकेष्वभिरतं मरणे कृतनिश्चयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2039267, "chapter_id": 1861, "verse_number": "५-१०६-२", "content_sanskrit": "ज्ञातीनां दुःखकर्तारं बन्धूनां शोकवर्धनम् ।\nसुहृदां क्लेशदातारं द्विषतां हर्षवर्धनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2039268, "chapter_id": 1861, "verse_number": "५-१०६-३", "content_sanskrit": "कथं नैनं विमार्गस्थं वारयन्तीह बान्धवाः।\nसौहृदाद्वा सुहृत्स्निग्धो भगवान्वा पितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2039269, "chapter_id": 1861, "verse_number": "५-१०६-४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2039270, "chapter_id": 1861, "verse_number": "५-१०६-४", "content_sanskrit": "उक्तं भगवता वाक्यमुक्तं भीष्मेण यत्क्षमम्।\nउक्तं बहुविधं चैव नारदेनापि तच्छृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2039271, "chapter_id": 1861, "verse_number": "५-१०६-५x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2039272, "chapter_id": 1861, "verse_number": "५-१०६-५", "content_sanskrit": "दुर्लभो वै सुहृच्छ्रोता दुर्लभश्च हितः सुहृत्।\nतिष्ठते हि सुह्यद्यत्र न बन्धुस्तत्र तिष्ठते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2039273, "chapter_id": 1861, "verse_number": "५-१०६-६", "content_sanskrit": "श्रोतव्यमपि पश्यापि सुहृदां कुरुनन्दन।\nन कर्तव्यश्च निर्बन्धो निर्बन्धो हि सुदारुणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2039274, "chapter_id": 1861, "verse_number": "५-१०६-७", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nयथा निर्बन्धतः प्राप्तो गालवेन पराजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2039275, "chapter_id": 1861, "verse_number": "५-१०६-८", "content_sanskrit": "विश्वामित्रं तपस्यन्तं धर्मो जिज्ञासया पुरा ।\nअभ्यगच्छत्स्वयं भूत्वा वसिष्ठो भगवानृषिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2039276, "chapter_id": 1861, "verse_number": "५-१०६-९", "content_sanskrit": "सप्तर्षीणामन्यतमं वेषमास्थाय भारत।\nबभुक्षुः क्षुधितो राजन्नाश्रमं कौशिकस्य तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2039277, "chapter_id": 1861, "verse_number": "५-१०६-१०", "content_sanskrit": "विश्वामित्रोऽथ संभ्रान्तः श्रपयामास वै चरुम् ।\nपरमान्नस्य यत्नेन न च तं प्रत्यपालयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2039278, "chapter_id": 1861, "verse_number": "५-१०६-११", "content_sanskrit": "अन्नं तेन यदा भुक्तमन्यैर्दत्तं तपस्विभिः ।\nअथ गृह्णान्नमत्युष्णं विश्वामित्रोऽप्युपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2039279, "chapter_id": 1861, "verse_number": "५-१०६-१२", "content_sanskrit": "भुक्तं मे तिष्ठ तावत्त्वमित्युक्त्वा भगवान्ययौ ।\nविश्वामित्रस्ततो राजन्स्थित एव महाद्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2039280, "chapter_id": 1861, "verse_number": "५-१०६-१३", "content_sanskrit": "भक्तं प्रगृह्य मूर्ध्ना वै बाहुभ्यां संशितव्रतः ।\nस्थितः स्थाणुरिवाभ्याशे निश्चेष्टो मारुताशनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2039281, "chapter_id": 1861, "verse_number": "५-१०६-१४", "content_sanskrit": "तस्य शुश्रूषणे यत्नमकरोद्गालवो मुनिः ।\nगौरवाद्बहुमानाच्च हार्देन प्रियकाम्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2039282, "chapter_id": 1861, "verse_number": "५-१०६-१५", "content_sanskrit": "अथ वर्षशते पूर्णे धर्मः पुनरुपागमत्।\nवासिष्ठं वेषमास्थाय कौशिकं भोजनेप्सया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2039283, "chapter_id": 1861, "verse_number": "५-१०६-१६", "content_sanskrit": "स दृष्ट्वा शिरसा भक्तं ध्रियमाणं महर्षिणा ।\nतिष्ठता वायुभक्षेण विश्वामित्रेण धीमता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2039284, "chapter_id": 1861, "verse_number": "५-१०६-१७", "content_sanskrit": "प्रतिगृह्य ततो धर्मस्तथैवोष्णं तथा नवम् ।\nभुक्त्वा प्रीतोस्मि विप्रर्षे तमुक्त्वा स मुनिर्गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2039285, "chapter_id": 1861, "verse_number": "५-१०६-१८", "content_sanskrit": "क्षत्रभावादपगतो ब्राह्मणत्वमुपागतः।\nधर्मस्य वचनात्प्रीतो विश्वामित्रस्तथाऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2039286, "chapter_id": 1861, "verse_number": "५-१०६-१९", "content_sanskrit": "विश्वामित्रस्तु शिष्यस्य गालवस्य तपस्विनः ।\nशुश्रूषया च भक्त्या च प्रीतिमानित्युवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2039287, "chapter_id": 1861, "verse_number": "५-१०६-२०", "content_sanskrit": "अनुज्ञातो मया वत्स यथेष्टं गच्छ गवालव।\nइत्युक्तः प्रत्युवाचेदं गालवो मुनिसत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2039288, "chapter_id": 1861, "verse_number": "५-१०६-२१", "content_sanskrit": "प्रीतो मधुरया वाचा विश्वामित्रं महाद्युतिम् ।\nदक्षिणाः काः प्रयच्छामि भवते गुरुकर्मणि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2039289, "chapter_id": 1861, "verse_number": "५-१०६-२२", "content_sanskrit": "दक्षिणाभिरुपेतं हि कर्म सिद्ध्यति मानद।\nदक्षिणानां हि दाता वै अपवर्गेण युज्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2039290, "chapter_id": 1861, "verse_number": "५-१०६-२३", "content_sanskrit": "स्वर्गे क्रतुफलं तद्धि दक्षिणा शान्तिरुच्यते।\nकिमाहरामि गुर्वर्थं ब्रवीतु भगवानिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2039291, "chapter_id": 1861, "verse_number": "५-१०६-२४", "content_sanskrit": "स जानानस्तु भगवान्खिन्नं शुश्रूषणेन वै।\nविश्वामित्रस्तमसकृद्गच्छ गच्छेत्यचोदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2039292, "chapter_id": 1861, "verse_number": "५-१०६-२५", "content_sanskrit": "असकृद्गच्छगच्छेति विश्वामित्रेण भाषितः ।\nकिं ददानीति बहुशो गालवः प्रत्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2039293, "chapter_id": 1861, "verse_number": "५-१०६-२६", "content_sanskrit": "निर्बन्धतस्तु बहुशो गालवस्य तपस्विनः।\nकिंचिदागतसंरम्भो विश्वामित्रोऽब्रवीदिदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2039294, "chapter_id": 1861, "verse_number": "५-१०६-२७", "content_sanskrit": "एकतःश्यामकर्णानां हयानां चन्द्रवर्चसाम्।\nअष्टौ शतानि मे देहि गच्छ गालव मा चिरम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2039295, "chapter_id": 1861, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि षडधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]