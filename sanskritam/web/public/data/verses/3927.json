[{"id": 2135168, "chapter_id": 3927, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2135169, "chapter_id": 3927, "verse_number": "१", "content_sanskrit": "वर्तमानेषु पार्थेषु वने तेषु महात्मसु ।\nधार्तराष्ट्रा महेष्वासाः किमकुर्वत सत्तमाः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2135170, "chapter_id": 3927, "verse_number": "२", "content_sanskrit": "कर्णो वैकर्तनश्चापि शकुनिश्च महाबलः ।\nभीष्मद्रोणकृपाश्चैव तन्मे शंसितुमर्हसि \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2135171, "chapter_id": 3927, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2135172, "chapter_id": 3927, "verse_number": "३", "content_sanskrit": "एवं गतेषु पार्थेषु विसृष्टे च सुयोधने ।\nआगते हास्तिनपुरं मोक्षिते पाण्डुनन्दनैः ।\nभीष्मोऽब्रवीन्महाराज धार्तराष्ट्रमिदं वचः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2135173, "chapter_id": 3927, "verse_number": "४", "content_sanskrit": "उक्तं तात यथा पूर्वं गच्छतस्ते तपोवनम् ।\nगमनं मे न रुचितं मद्वचो न कृतं च ते \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2135174, "chapter_id": 3927, "verse_number": "५", "content_sanskrit": "ततः प्राप्तं त्वया वीर ग्रहणं शत्रुभिर्बलात् ।\nमोक्षितश्चासि धर्मज्ञैः पाण्डवैर्न च लज्जसे \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2135175, "chapter_id": 3927, "verse_number": "६", "content_sanskrit": "प्रत्यक्षं तव गान्धारे ससैन्यस्य विशाम्पते ।\nसूतपुत्रो भयाद् भीतो गन्धर्वाणां तदा रणात् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2135176, "chapter_id": 3927, "verse_number": "", "content_sanskrit": "क्रोशतस्तव राजेन्द्र ससैन्यस्य नृपात्मज ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2135177, "chapter_id": 3927, "verse_number": "", "content_sanskrit": "व्यपयातः पृष्ठतस्तान् प्रेक्षमाणः पुनः पुनः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2135178, "chapter_id": 3927, "verse_number": "७", "content_sanskrit": "दृष्टस्ते विक्रमश्चैव पाण्डवानां महात्मनाम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2135179, "chapter_id": 3927, "verse_number": "८", "content_sanskrit": "कर्णस्य च महाबाहो सूतपुत्रस्य दर्मतेः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2135180, "chapter_id": 3927, "verse_number": "९", "content_sanskrit": "न चापि पादभाक् कर्णः पाण्डवानां नृपोत्तम ।\nधनुर्वेदे च शौर्ये च धर्मे वा धर्मवत्सल \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2135181, "chapter_id": 3927, "verse_number": "१०", "content_sanskrit": "तस्मादहं क्षमं मन्ये पाण्डवैस्तैर्महात्मभिः ।\nसन्धिं सन्धिविदां श्रेष्ठ कुलस्यास्य विवृद्धये \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2135182, "chapter_id": 3927, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2135183, "chapter_id": 3927, "verse_number": "११", "content_sanskrit": "एवमुक्तश्च भीष्मेण धार्तराष्ट्रो जनेश्वरः ।\nप्रहस्य सहसा राजन् विप्रतस्थे ससौबलः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2135184, "chapter_id": 3927, "verse_number": "१२", "content_sanskrit": "तं तु प्रस्थितमाज्ञाय कर्णदुःशासनादयः ।\nअनुजग्मुर्महेष्वासा धार्तराष्ट्रं महाबलम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2135185, "chapter_id": 3927, "verse_number": "१३", "content_sanskrit": "तांस्तु सम्प्रस्थितान् दृष्ट्वा भीष्मः कुरुपितामहः ।\nलज्जयाऽधोमुखो राजन् जगाम स्वं निवेशनम् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2135186, "chapter_id": 3927, "verse_number": "१४", "content_sanskrit": "गते भीष्मे महाराज धार्तराष्ट्रो जनेश्वरः ।\nपुनरागम्य तं देशममन्त्रयत मन्त्रिभिः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2135187, "chapter_id": 3927, "verse_number": "१५", "content_sanskrit": "किमस्माकं भवेच्छ्रेयः किं कार्यमवशिष्यते ।\nकथं च सुकृतं तत् स्यान्मन्त्रयामोऽद्य यद् हितम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2135188, "chapter_id": 3927, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2135189, "chapter_id": 3927, "verse_number": "१६", "content_sanskrit": "दुर्योधन निबोधेदं यत् त्वां वक्ष्यामि कौरव ।\nश्रुत्वा वाचं तथा सर्वं कर्तुमर्हस्यरिन्दम \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2135190, "chapter_id": 3927, "verse_number": "", "content_sanskrit": "तवाद्य पृथिवी वीर निःसपत्ना नृपोत्तम ।\nतां पालय यथा शक्रो हतशत्रुर्महामनाः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2135191, "chapter_id": 3927, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2135192, "chapter_id": 3927, "verse_number": "१७", "content_sanskrit": "एवमुक्तस्तु कर्णेन कर्णं राजाऽब्रवीत् पुनः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2135193, "chapter_id": 3927, "verse_number": "१८", "content_sanskrit": "दुर्लभं तस्य किं नाम यस्य त्वं पुरषर्षभ ।\nसहायश्चानुरक्तश्च मदर्थं च समुद्यतः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2135194, "chapter_id": 3927, "verse_number": "१९", "content_sanskrit": "अभिप्रायश्च(स्तु)मे कश्चित् तं वै शृणु यथातथम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2135195, "chapter_id": 3927, "verse_number": "", "content_sanskrit": "राजसूयं पाण्डवस्य दृष्ट्वा क्रतुवरं महत् ।\nमम स्पृहा समुत्पन्ना तां सम्पादय सूतज ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2135196, "chapter_id": 3927, "verse_number": "", "content_sanskrit": "वैशम्पायनः-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2135197, "chapter_id": 3927, "verse_number": "२०", "content_sanskrit": "एवमुक्तस्ततः कर्णो राजानमिदमब्रवीत् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2135198, "chapter_id": 3927, "verse_number": "२१", "content_sanskrit": "तवाद्य पृथिवीपाला वश्याः सर्वे नृपोत्तम ।\nआहूयन्तां द्विजवराः सम्भाराश्च यथाविधि \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2135199, "chapter_id": 3927, "verse_number": "२२", "content_sanskrit": "सम्भ्रियन्तां कुरुश्रेष्ठ यज्ञोपकरणानि च ।\nऋत्विजश्च समाहूता यथोक्ता वेदपारगाः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2135200, "chapter_id": 3927, "verse_number": "२३", "content_sanskrit": "क्रियां कुर्वन्तु हे राजन् यथाशास्त्रमरिन्दम \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2135201, "chapter_id": 3927, "verse_number": "२४", "content_sanskrit": "बह्वन्नपानसंयुक्तः सुसमृद्धगुणान्वितः ।\nप्रवर्ततां महायज्ञस्तवापि वसुधाधिप \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2135202, "chapter_id": 3927, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2135203, "chapter_id": 3927, "verse_number": "२५", "content_sanskrit": "एवमुक्तस्तु कर्णेन धार्तराष्ट्रो विशाम्पते ।\nपुरोहितं समानाय्य इदं वचनमब्रवीत् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2135204, "chapter_id": 3927, "verse_number": "", "content_sanskrit": "राजसूयं क्रतुवरं समाप्तवरदक्षिणम् ।\nआहर त्वं मम कृते यथान्यायं यथाक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2135205, "chapter_id": 3927, "verse_number": "", "content_sanskrit": "वैशम्पायनः-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2135206, "chapter_id": 3927, "verse_number": "२६", "content_sanskrit": "स एवमुक्तो नृपतिमुवाच द्विजसत्तमः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2135207, "chapter_id": 3927, "verse_number": "२७", "content_sanskrit": "ब्राह्मणैः सहितो धीमान् ये तत्रासन् समागताः ।\nन स शक्यः कुरुश्रेष्ठे जीवमाने युधिष्ठिरे \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2135208, "chapter_id": 3927, "verse_number": "२८", "content_sanskrit": "आहर्तुं कौरवश्रेष्ठ कुले तव नृपोत्तम ।\nदीर्घायुर्जीवति च वै धृतराष्ट्रः पिता नृप \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2135209, "chapter_id": 3927, "verse_number": "२९", "content_sanskrit": "अतश्चापि विरुद्धस्ते क्रतुरेष नृपोत्तम \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2135210, "chapter_id": 3927, "verse_number": "३०", "content_sanskrit": "अस्ति त्वन्यन्महत्सत्रं राजसूयसमं प्रभो ।\nतेन त्वं यज राजेन्द्र शृणु चेदं वचो मम \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2135211, "chapter_id": 3927, "verse_number": "३१", "content_sanskrit": "य इमे पृथिवीपालाः करदास्तव पार्थिव ।\nते करान् सम्प्रयच्छन्तु सुवर्णं च कृताकृतम् \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2135212, "chapter_id": 3927, "verse_number": "३२", "content_sanskrit": "तेन ते क्रियतामद्य लाङ्गलं नृपसत्तम ।\nयज्ञवाटस्य ते भूमिः कृष्यतां तेन भारत \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2135213, "chapter_id": 3927, "verse_number": "३३", "content_sanskrit": "तत्र यज्ञो नृपश्रेष्ठ प्रभूतान्नः सुसंस्कृतः ।\nप्रवर्ततां यथान्यायं सर्वतो ह्यनिवारितः \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2135214, "chapter_id": 3927, "verse_number": "३४", "content_sanskrit": "एष ते वैष्णवो नाम यज्ञः सत्पुरुषोचितः ।\nएतेन नेष्टवान् कश्चिदृते विष्णुं पुरातनम् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2135215, "chapter_id": 3927, "verse_number": "३५", "content_sanskrit": "राजसूयं क्रतुश्रेष्ठं स्पर्धत्येष महाक्रतुः ।\nअस्माकं रोचते चैषः श्रेयश्च तव भारत \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2135216, "chapter_id": 3927, "verse_number": "३६", "content_sanskrit": "निर्विघ्नश्च भवत्येष सफला स्यात्स्पृहा तव ।\nतस्मादेष महाबाहो तव यज्ञः प्रवर्तताम् \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2135217, "chapter_id": 3927, "verse_number": "३७", "content_sanskrit": "एवमुक्तस्तु तैर्विप्रैर्धार्तराष्ट्रो महीपतिः ।\nकर्णं च सौबलं चैव भ्रातॄंश्चैवेदमब्रवीत् \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2135218, "chapter_id": 3927, "verse_number": "३८", "content_sanskrit": "रोचते मे वचः कृत्स्नं ब्राह्मणानां न संशयः ।\nरोचते यदि युष्माकं तस्मात् प्रब्रूत माचिरम् \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2135219, "chapter_id": 3927, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2135220, "chapter_id": 3927, "verse_number": "३९", "content_sanskrit": "एवमुक्तास्तु ते सर्वे तथेत्यूचुर्नराधिपम् ।\nसन्दिदेश ततो राजा व्यापारस्थान् यथाक्रमम् \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2135221, "chapter_id": 3927, "verse_number": "४०", "content_sanskrit": "हलस्य करणे चापि व्यादिष्टाः सर्वशिल्पिनः ।\nयथोक्तं च नृपश्रेष्ठ कृतं सर्वं यथाक्रमम् \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2135222, "chapter_id": 3927, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि चतुश्चत्वारिंशदधिकद्विशततमोऽध्यायः ॥२४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2135223, "chapter_id": 3927, "verse_number": "", "content_sanskrit": "प्रायोप्रवेशपर्वणि दुर्योधनयज्ञसमारम्भे नवमोऽध्यायः ॥९॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]