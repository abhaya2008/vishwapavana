[{"id": 2074349, "chapter_id": 2570, "verse_number": "१२-७५-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2074350, "chapter_id": 2570, "verse_number": "१२-७५-१", "content_sanskrit": "यया वृत्त्या महीपालो विवर्धयति मानवान्।\nपुण्यांश्च लोकाञ्जयति तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2074351, "chapter_id": 2570, "verse_number": "१२-७५-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2074352, "chapter_id": 2570, "verse_number": "१२-७५-२", "content_sanskrit": "दानशीलो भवेद्राजा यज्ञशीलश्च भारत।\nउपवासतपः शीलः प्रजानां पालने रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2074353, "chapter_id": 2570, "verse_number": "१२-७५-३", "content_sanskrit": "सर्वाश्चैव प्रजा नित्यं राजा धर्मेण पालयन्।\nउत्थानेन प्रदानेन पूजयेच्चापि धार्मिकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2074354, "chapter_id": 2570, "verse_number": "१२-७५-४", "content_sanskrit": "राज्ञा हि पूजितो धर्मस्ततः सर्वत्र पूज्यते।\nयद्यदाचरते राजा तत्प्रजानां स्म रोचते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2074355, "chapter_id": 2570, "verse_number": "१२-७५-५", "content_sanskrit": "नित्यमुद्यतदण्डश्च भवेन्मृत्युरिवारिषु।\nनिहन्यात्सर्वतो दस्यून्न राज्ञो दस्युषु क्षमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2074356, "chapter_id": 2570, "verse_number": "१२-७५-६", "content_sanskrit": "यं हि धर्मं चरन्तीह प्रजा राज्ञा सुरक्षिताः।\nचतुर्थं तस्य धर्मस्य राजा भागं च विन्दति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2074357, "chapter_id": 2570, "verse_number": "१२-७५-७", "content_sanskrit": "यदधीते यद्ददाति यञ्जुहोति यदर्चति।\nराजा चतुर्थभाक्तस्य प्रजा धर्मेण पालयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2074358, "chapter_id": 2570, "verse_number": "१२-७५-८", "content_sanskrit": "यद्राष्ट्रोऽकुशलं किंचिद्राज्ञो रक्षयतः प्रजाः।\nचतुर्थं तस्य पापस्य राजा भारत विन्दति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2074359, "chapter_id": 2570, "verse_number": "१२-७५-९", "content_sanskrit": "अप्याहुः सर्वमेवेति भूयोऽर्धमिति निश्चयः।\nकर्मणा पृथिवीपाल नृशंसोऽनृतवागपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2074360, "chapter_id": 2570, "verse_number": "१२-७५-१०", "content_sanskrit": "तादृशात्किल्बिपाद्राजा शृणु येन प्रमुच्यते।\nप्रत्याहर्तुमशक्यं स्याद्धनं चोरैर्हृतं यदि।\nतत्स्वकोशात्प्रदेयं स्यादशक्तेनोपजीवतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2074361, "chapter_id": 2570, "verse_number": "१२-७५-११", "content_sanskrit": "सर्ववर्णैः सदा रक्ष्यं ब्रह्मस्वं ब्राह्मणा यथा।\nन स्थेयं विषये तेन योऽपकुर्याद्द्विजातिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2074362, "chapter_id": 2570, "verse_number": "१२-७५-१२", "content_sanskrit": "ब्रह्मस्वे रक्ष्यमाणे तु सर्वं भवति रक्षितम्।\nतेषां प्रसादे निर्वृत्ते कृतकृत्यो भवेन्नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2074363, "chapter_id": 2570, "verse_number": "१२-७५-१३", "content_sanskrit": "पर्जन्यमिव भूतानि महाद्रुममिव द्विजाः।\nनरास्तमुपजीवन्ति नृपं सर्वार्थसाधकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2074364, "chapter_id": 2570, "verse_number": "१२-७५-१४", "content_sanskrit": "न हि कामात्मना राज्ञा सततं शठबुद्धिना।\nनृशंनेनातिलुब्धेन शक्यं पालयितुं प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2074365, "chapter_id": 2570, "verse_number": "१२-७५-१५x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2074366, "chapter_id": 2570, "verse_number": "१२-७५-१५", "content_sanskrit": "नाहं राज्यसुखान्वेषी राज्यमिच्छाम्यपि क्षणम्।\nधर्मार्थं रोचये राज्यं धर्मश्चात्र न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2074367, "chapter_id": 2570, "verse_number": "१२-७५-१६", "content_sanskrit": "तदल मम राज्येन यत्र धर्मो न विद्यते।\nवनमेव गमिष्यामि तस्माद्धर्मचिकीर्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2074368, "chapter_id": 2570, "verse_number": "१२-७५-१७", "content_sanskrit": "तत्र मेध्येष्वरण्येषु न्यस्तदण्डो जितेन्द्रियः।\nधर्ममाराधयिष्यामि मुनिर्मूलफलाशनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2074369, "chapter_id": 2570, "verse_number": "१२-७५-१८x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2074370, "chapter_id": 2570, "verse_number": "१२-७५-१८", "content_sanskrit": "वेदाहं तव या बुद्धिरानृशंस्येऽगुणैव सा।\nन च नित्यानृशंसेन शक्यं राज्यमुपासितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2074371, "chapter_id": 2570, "verse_number": "१२-७५-१९", "content_sanskrit": "सदैव त्वां मृदुप्रज्ञमत्यार्यमतिधार्मिकम्।\nक्लीबं धर्मघृणायुक्तं न लोको बहुमन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2074372, "chapter_id": 2570, "verse_number": "१२-७५-२०", "content_sanskrit": "राजधर्ममवेक्षस्व पितृपैतामहोचितम्।\nनैतद्राज्ञामथो वृत्तं यथा त्वं स्थातुमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2074373, "chapter_id": 2570, "verse_number": "१२-७५-२१", "content_sanskrit": "न हि वैक्लव्यसंसृष्टमानृशंस्यमिहास्थितः।\nप्रजापालनसंभूतं प्राप्तो धर्मफलं ह्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2074374, "chapter_id": 2570, "verse_number": "१२-७५-२२", "content_sanskrit": "न ह्येतामाशिषं पाण्डुर्न च कुन्त्यभ्यभाषत।\n`विचित्रवीर्यो धर्मात्मा चित्रवीर्यो नराधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2074375, "chapter_id": 2570, "verse_number": "१२-७५-२३", "content_sanskrit": "शन्तनुश्च महीपालः सर्वक्षत्रस्य पूजितः।\nतवैतां प्राज्ञतां तात यथा चरसि मेधया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2074376, "chapter_id": 2570, "verse_number": "१२-७५-२४", "content_sanskrit": "शौर्यं बलं च सत्यं च पिता तव सदाऽब्रवीत्।\nमहत्त्वं बलमौदार्यं भवतः कुन्त्ययाचत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2074377, "chapter_id": 2570, "verse_number": "१२-७५-२५", "content_sanskrit": "नित्यं स्वाहा स्वधा नित्यं चोभे मानुषदैवते।\nपुत्रेष्वाशासते नित्यं पितरो दैवतानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2074378, "chapter_id": 2570, "verse_number": "१२-७५-२६", "content_sanskrit": "दानमध्ययनं यज्ञं प्रजानां परिपालनम्।\nधर्म्यमेतदधर्म्यं वा जन्मनैवाभ्यजायथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2074379, "chapter_id": 2570, "verse_number": "१२-७५-२७", "content_sanskrit": "कुले धुरि च युक्तानां वहतां भारमीदृशम्।\nसीदतामपि कौन्तेय कीर्तिर्न परिहीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2074380, "chapter_id": 2570, "verse_number": "१२-७५-२८", "content_sanskrit": "समन्ततो विनीतो यो वहत्यस्खलितो हि सः।\nनिर्दोषकर्मवचनात्सिद्धिः कर्मण एव सा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2074381, "chapter_id": 2570, "verse_number": "१२-७५-२९", "content_sanskrit": "नैकान्ते विनिपातेऽपि विहरेदिह कश्चन।\nधर्मी गृही वा राजा वा ब्रह्मचार्यथवा द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2074382, "chapter_id": 2570, "verse_number": "१२-७५-३०", "content_sanskrit": "अल्पं हि सारभूयिष्ठं यत्कर्मोदारमेव तत्।\nकृतमेवाकृताच्छ्रेयो न पापीयोऽस्य कर्मणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2074383, "chapter_id": 2570, "verse_number": "१२-७५-३१", "content_sanskrit": "यदा कुलीनो धर्मज्ञः प्राप्नोत्यैश्वर्यमुत्तमम्।\nयोगक्षेमस्तदा राज्ञः कुशलायैव कल्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2074384, "chapter_id": 2570, "verse_number": "१२-७५-३२", "content_sanskrit": "दानेनान्यं बलेनान्यमन्यं सूनृतया गिरा।\nसर्वतः प्रतिगृह्णीयाद्राज्यं प्राप्येह धार्मिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2074385, "chapter_id": 2570, "verse_number": "१२-७५-३३", "content_sanskrit": "यं हि वैद्याः कुले जाता ह्यवृत्तिभयपीडिताः।\nप्राप्य तृप्ताः प्रतिष्ठन्ति धर्मः कोऽभ्यधिकस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2074386, "chapter_id": 2570, "verse_number": "१२-७५-३४x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2074387, "chapter_id": 2570, "verse_number": "१२-७५-३४", "content_sanskrit": "किं न्वतः परमं स्वर्ग्यं का ततः प्रीतिरुत्तमा।\nकिं ततः परमैश्वर्यं ब्रूहि मे यदि पश्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2074388, "chapter_id": 2570, "verse_number": "१२-७५-३५x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2074389, "chapter_id": 2570, "verse_number": "१२-७५-३५", "content_sanskrit": "यस्मिन्भयार्दिताः सन्तः क्षेमं विन्दन्त्यपि क्षणम्।\nस स्वर्गजित्तमोऽस्माकं सत्यमेतद्ब्रवीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2074390, "chapter_id": 2570, "verse_number": "१२-७५-३६", "content_sanskrit": "त्वमेव प्रीतिमांस्तस्मात्कुरूणां कुरुसत्तम।\nभव राजा जय स्वर्गं सतो रक्षाऽसतो जहि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2074391, "chapter_id": 2570, "verse_number": "१२-७५-३७", "content_sanskrit": "अनु त्वां तात जीवन्तु सुहृदः साधुभिः सह।\nपर्जन्यमिव भूतानि स्वादुद्रुममिव द्विजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2074392, "chapter_id": 2570, "verse_number": "१२-७५-३८", "content_sanskrit": "धृष्टं शूरं प्रहर्तारमनृशंसं जितेन्द्रियम्।\nवत्सलं संविभक्तारमुपजीवन्तु बान्धवाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2074393, "chapter_id": 2570, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि पञ्चसप्ततितमोऽध्यायः॥ ७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]