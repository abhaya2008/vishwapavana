[{"id": 6000006000, "chapter_id": 10006, "verse_number": null, "content_sanskrit": "अथ षष्‍ठाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000006001, "chapter_id": 10006, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.001.m4a", "display_order": 2}, {"id": 6000006002, "chapter_id": 10006, "verse_number": "१-६-१", "content_sanskrit": "एवं निशम्य भगवान् देवर्षेर्जन्म कर्म च।\nभूयः पप्रच्छ तं ब्रह्मन् व्यासः सत्यवतीसुतः॥ १/६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.002.m4a", "display_order": 3}, {"id": 6000006003, "chapter_id": 10006, "verse_number": null, "content_sanskrit": "व्यास उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.003.m4a", "display_order": 4}, {"id": 6000006004, "chapter_id": 10006, "verse_number": "१-६-२", "content_sanskrit": "भिक्षुभिर्विप्रवसिते विज्ञानादेष्‍ट्रृभिस्तव।\nवर्तमानो वयस्याद्ये ततः किमकरोद्भवान्॥ १/६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.004.m4a", "display_order": 5}, {"id": 6000006005, "chapter_id": 10006, "verse_number": "१-६-३", "content_sanskrit": "स्वायम्भुव कया वृत्त्या वर्तितं ते परं वयः।\nकथं वेदमुदस्राक्षीः काले प्राप्‍ते कलेवरम्॥ १/६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.005.m4a", "display_order": 6}, {"id": 6000006006, "chapter_id": 10006, "verse_number": "१-६-४", "content_sanskrit": "प्राक्‍कल्पविषयामेतां स्मृतिं ते सुरसत्तम।\nन ह्येव व्यवधात्काल एष सर्वनिराकृतिः॥ १/६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.006.m4a", "display_order": 7}, {"id": 6000006007, "chapter_id": 10006, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.007.m4a", "display_order": 8}, {"id": 6000006008, "chapter_id": 10006, "verse_number": "१-६-५", "content_sanskrit": "भिक्षुभिर्विप्रवसिते विज्ञानादेष्‍टृभिर्मम।\nवर्तमानो वयस्याद्ये तत एतदकार्षम्॥ १/६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.008.m4a", "display_order": 9, "topics": [{"text": "स्वमातुर्मरणानन्तरं महाटवीं प्रविष्‍टस्य नारदस्य भगवद्ध्याने भगवता हृद्यपरोक्षीभूय पुनरन्तर्धानम्", "range": "५–२९"}]}, {"id": 6000006009, "chapter_id": 10006, "verse_number": "१-६-६", "content_sanskrit": "एकात्मजा मे जननी योषिन्मूढा च किङ्करी।\nमय्यात्मजेऽनन्यगतौ चक्रे स्नेहानुबन्धनम्॥ १/६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.009.m4a", "display_order": 10}, {"id": 6000006010, "chapter_id": 10006, "verse_number": "१-६-७", "content_sanskrit": "साऽस्वतन्त्रा न कल्यासीद्योगक्षेमं ममेच्छती।\nईशस्य हि वशे लोको योषा दारुमयी यथा॥ १/६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.010.m4a", "display_order": 11}, {"id": 6000006011, "chapter_id": 10006, "verse_number": "१-६-८", "content_sanskrit": "अहं च तद्ब्रह्मकुल ऊषिवांस्तदपेक्षया।\nदिग्देशकालव्युत्पन्नो बालकः पञ्चहायनः॥ १/६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.011.m4a", "display_order": 12}, {"id": 6000006012, "chapter_id": 10006, "verse_number": "१-६-९", "content_sanskrit": "एकदा निर्गतां गेहाद्दुहन्तीं निशि गां पथि।\nसर्पोऽदशत्पदा स्पृष्‍टः कृपणां कालचोदितः॥ १/६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.012.m4a", "display_order": 13}, {"id": 6000006013, "chapter_id": 10006, "verse_number": "१-६-१०", "content_sanskrit": "तदा तदहमीशस्य भक्‍तानां समभीप्सितम्।\nअनुग्रहं मन्यमानः प्रातिष्‍ठं दिशमुत्तराम्॥ १/६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.013.m4a", "display_order": 14}, {"id": 6000006014, "chapter_id": 10006, "verse_number": "१-६-११", "content_sanskrit": "स्फीतान् जनपदांस्तत्र पुरग्रामव्रजाकरान्।\nखेटान् पट्टनवाटीश्‍च वनान्युपवनानि च॥ १/६/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.014.m4a", "display_order": 15}, {"id": 6000006015, "chapter_id": 10006, "verse_number": "१-६-१२", "content_sanskrit": "विचित्रधातुचित्राद्रीनिभभग्नभुजद्रुमान्।\nजलाशयांश्छिवजलान्नलिनीः सुरसेविताः॥ १/६/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.015.m4a", "display_order": 16}, {"id": 6000006016, "chapter_id": 10006, "verse_number": "१-६-१३", "content_sanskrit": "चित्रस्वनैः पत्ररथैर्विभ्रमद्भ्रमरश्रियः।\nनलवेणुशरस्तम्बकुशकीचकगह्वरम्॥ १/६/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.016.m4a", "display_order": 17}, {"id": 6000006017, "chapter_id": 10006, "verse_number": "१-६-१४", "content_sanskrit": "एक एवातियातोऽहमद्राक्षं विपिनं महत्।\nघोरं प्रतिभयाकारं व्यालोलूकशिवाजिरम्॥ १/६/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.017.m4a", "display_order": 18}, {"id": 6000006018, "chapter_id": 10006, "verse_number": "१-६-१५", "content_sanskrit": "परिश्रान्तेन्द्रियात्माऽहं तृट्‌परीतो बुभुक्षितः।\nस्नात्वा पीत्वा ह्रदे नद्या उपस्पृष्‍टो गतश्रमः॥ १/६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.018.m4a", "display_order": 19}, {"id": 6000006019, "chapter_id": 10006, "verse_number": "१-६-१६", "content_sanskrit": "तस्मिन्निर्मनुजेऽरण्ये पिप्‍पलोपस्थ आश्रितः।\nआत्मनात्मानमात्मस्थं यथाश्रुतमचिन्तयम्॥ १/६/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.019.m4a", "display_order": 20}, {"id": 6000006020, "chapter_id": 10006, "verse_number": "१-६-१७", "content_sanskrit": "स्वप्नो मायाग्रहः शय्या जाग्रदाभास आत्मनः।\nनामरूपक्रियावृत्तिः संविच्छास्‍त्रं परं पदम्॥ १/६/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.020.m4a", "display_order": 21}, {"id": 6000006021, "chapter_id": 10006, "verse_number": "१-६-१८", "content_sanskrit": "नेन्द्रियार्थं च न स्वप्नं न सुप्‍तं न मनोरथम्।\nन निरोधं चानुगच्छेच्चित्रं तद्भगवत्पदम्॥ १/६/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.021.m4a", "display_order": 22}, {"id": 6000006022, "chapter_id": 10006, "verse_number": "१-६-१९", "content_sanskrit": "स एको भगवानग्रे क्रीडिष्यन्निदमात्मनः।\nसृष्‍ट्वा विहृत्य तज्‍जग्ध्वा उदास्ते केवलः पुनः॥ १/६/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.022.m4a", "display_order": 23}, {"id": 6000006023, "chapter_id": 10006, "verse_number": "१-६-२०", "content_sanskrit": "ध्यायतश्‍चरणाम्भोजं भावनिर्वृतचेतसः।\nउत्कण्ठाश्रुकलाक्षस्य हृद्यासीन्मे शनैर्हरिः॥ १/६/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.023.m4a", "display_order": 24}, {"id": 6000006024, "chapter_id": 10006, "verse_number": "१-६-२१", "content_sanskrit": "प्रेमातिभारनिर्भिन्नपुलकाङ्गोऽतिनिर्वृतः।\nआनन्दसंप्लवे लीनो नापश्यमुभयं मुने॥ १/६/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.024.m4a", "display_order": 25}, {"id": 6000006025, "chapter_id": 10006, "verse_number": "१-६-२२", "content_sanskrit": "रूपं भगवतो यत्तन्मनःकान्तं सुखावहम्।\nअपश्यन्सहसोत्तस्थौ कैवल्याद्दुर्मना इव॥ १/६/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.025.m4a", "display_order": 26}, {"id": 6000006026, "chapter_id": 10006, "verse_number": "१-६-२३", "content_sanskrit": "दिदृक्षुस्तदहं भूयः प्रणिधाय मनो हृदि।\nवीक्षमाणोऽपि नापश्यमवितृप्‍त इवातुरः॥ १/६/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.026.m4a", "display_order": 27}, {"id": 6000006027, "chapter_id": 10006, "verse_number": "१-६-२४", "content_sanskrit": "एवं यतन्तं विजने मामाहागोचरो गिराम्।\nगम्भीरश्लक्ष्णया वाचा शुचः प्रशमयन्निव॥ १/६/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.027.m4a", "display_order": 28}, {"id": 6000006028, "chapter_id": 10006, "verse_number": "१-६-२५", "content_sanskrit": "हन्तास्मिञ्जन्मनि भवान्न मां द्रष्‍टुमिहार्हति।\nअविपक्‍वकषायाणां दुर्दर्शोऽहं कुयोगिनाम्॥ १/६/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.028.m4a", "display_order": 29}, {"id": 6000006029, "chapter_id": 10006, "verse_number": "१-६-२६", "content_sanskrit": "सकृद्यद्दर्शितं रूपमेतत्कामाय तेऽनघ।\nमत्कामः शनकैः साधु सर्वान्मुञ्चति हृच्छ्रयान्॥ १/६/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.029.m4a", "display_order": 30}, {"id": 6000006030, "chapter_id": 10006, "verse_number": "१-६-२७", "content_sanskrit": "सत्सेवया दीर्घया वै जाता मयि दृढा मतिः।\nहित्वाऽवद्यमिमं लोकं गन्ता मज्जनतामसि॥ १/६/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.030.m4a", "display_order": 31}, {"id": 6000006031, "chapter_id": 10006, "verse_number": "१-६-२८", "content_sanskrit": "मतिर्मयि निबद्धेयं न विपद्येत कर्हिचित्।\nप्रजासर्गनिरोधेऽपि स्मृतिश्‍च मदनुग्रहात्॥ १/६/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.031.m4a", "display_order": 32}, {"id": 6000006032, "chapter_id": 10006, "verse_number": "१-६-२९", "content_sanskrit": "एतावदुक्‍त्वोपरराम तन्महद्भूतं नभोलिङ्गमलिङ्गमीश्‍वरम्।\nअहं ‍च तस्मै महतां महीयसे शीर्ष्णावनामं विदधेऽनुकम्पितः॥ १/६/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.032.m4a", "display_order": 33}, {"id": 6000006033, "chapter_id": 10006, "verse_number": "१-६-३०", "content_sanskrit": "नामान्यनन्तस्य गतत्रपः पठन् गुह्यानि भद्राणि कृतानि च स्मरन्।\nगां पर्यटंस्तुष्‍टमना गतस्पृहः कालं प्रतीक्षन्नपटो विमत्सरः॥ १/६/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.033.m4a", "display_order": 34, "topics": [{"text": "तद्देहं त्यक्तवतस्तस्य कल्पान्तरे चतुर्मुखान्नारदत्वेन जननम्", "range": "३०–४०"}]}, {"id": 6000006034, "chapter_id": 10006, "verse_number": "१-६-३१", "content_sanskrit": "एवं कृष्णमतेर्ब्रह्मन्नसक्‍तस्यामलात्मनः।\nकालः प्रादुरभूत्काले तडित् सौदामिनी यथा॥ १/६/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.034.m4a", "display_order": 35}, {"id": 6000006035, "chapter_id": 10006, "verse_number": "१-६-३२", "content_sanskrit": "एवं मयि प्रयुञ्जाने शुद्धां भागवतीं तनुम्।\nप्रारब्धकर्मनिर्वाणो न्यपतत्पाञ्चभौतिकः॥ १/६/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.035.m4a", "display_order": 36}, {"id": 6000006036, "chapter_id": 10006, "verse_number": "१-६-३३", "content_sanskrit": "कल्पान्त इदमादाय शयानेऽम्भस्युदन्वतः।\nशिशयिष्णोरनुप्राणं विवेशान्तरहं विभोः॥ १/६/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.036.m4a", "display_order": 37}, {"id": 6000006037, "chapter_id": 10006, "verse_number": "१-६-३४", "content_sanskrit": "सहस्रयुगपर्यन्त उत्थायेदं सिसृक्षतः।\nमरीचिमिश्रा ऋषयः प्राणोभ्योऽहं च जज्ञिरे॥ १/६/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.037.m4a", "display_order": 38}, {"id": 6000006038, "chapter_id": 10006, "verse_number": "१-६-३५", "content_sanskrit": "अन्तर्बहिश्‍च लोकांस्‍त्रीन्पर्येम्यस्कन्दितव्रतः।\nअनुग्रहान्महाविष्णोरविघातगतिः क्‍वचित्॥ १/६/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.038.m4a", "display_order": 39}, {"id": 6000006039, "chapter_id": 10006, "verse_number": "१-६-३६", "content_sanskrit": "देवदत्तामिमां वीणां स्वरब्रह्मविभूषिताम्।\nमूर्च्छयित्वा हरिकथां गायमानश्‍चराम्यहम्॥ १/६/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.039.m4a", "display_order": 40}, {"id": 6000006040, "chapter_id": 10006, "verse_number": "१-६-३७", "content_sanskrit": "प्रगायतश्‍च वीर्याणि तीर्थपादः प्रियश्रवाः।\nआहूत इव मे शीघ्रं दर्शनं याति चेतसि॥ १/६/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.040.m4a", "display_order": 41}, {"id": 6000006041, "chapter_id": 10006, "verse_number": "१-६-३८", "content_sanskrit": "एतदातुरचित्तानां मात्रास्पर्शेच्छया मुहुः।\nभवसिन्धुप्लवो दृष्‍टो हरिचर्यानुवर्णनम्॥ १/६/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.041.m4a", "display_order": 42}, {"id": 6000006042, "chapter_id": 10006, "verse_number": "१-६-३९", "content_sanskrit": "यमादिभिर्याेगपथैः कामलोभहतो मुहुः।\nमुकुन्दसेवया यद्वत्तथाऽऽत्माऽद्धा न शाम्यति॥ १/६/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.042.m4a", "display_order": 43}, {"id": 6000006043, "chapter_id": 10006, "verse_number": "१-६-४०", "content_sanskrit": "सर्वं तदिदमाख्यातं यत्पृष्‍टोऽहं त्वयाऽनघ।\nजन्मकर्मरहस्यं मे भवतश्‍चात्मतोषणम्॥ १/६/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.043.m4a", "display_order": 44}, {"id": 6000006044, "chapter_id": 10006, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.044.m4a", "display_order": 45}, {"id": 6000006045, "chapter_id": 10006, "verse_number": "१-६-४१", "content_sanskrit": "एवं सम्भाष्य भगवान्नारदो वासवीसुतम्।\nआमन्त्र्य वीणां रणयन्ययौ यादृच्छिको यतिः॥ १/६/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.045.m4a", "display_order": 46, "topics": [{"text": "नारदेन व्यासं प्रत्येतत्कथाकथनानन्तरं तस्मादाश्रमान्निर्गमनम्", "range": "४१–४२"}]}, {"id": 6000006046, "chapter_id": 10006, "verse_number": "१-६-४२", "content_sanskrit": "अहो देवर्षिर्धन्योऽयं यः कीर्तिं शार्ङ्गधन्वनः।\nगायन् माध्व्या गिरा तन्त्र्या रमयत्यातुरं जगत्॥ १/६/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_006/BhP_01.006.046.m4a", "display_order": 47}, {"id": 6000006047, "chapter_id": 10006, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां प्रथमकन्धे षष्‍ठाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]