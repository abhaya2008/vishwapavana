[{"id": 2117642, "chapter_id": 3532, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2117643, "chapter_id": 3532, "verse_number": "१", "content_sanskrit": "महासुरस्यान्ववाये हिरण्यकशिपोः पुरा ।\nनिकुम्भो नाम दैत्येन्द्रः तेजसा बलवानभूत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2117644, "chapter_id": 3532, "verse_number": "२", "content_sanskrit": "तस्य पुत्रौ महावीयौं जातौ भीमपराक्रमौ ।\nसहान्योन्येन भुञ्जाते विनाऽन्योन्यं न गच्छताम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2117645, "chapter_id": 3532, "verse_number": "३", "content_sanskrit": "अन्योन्यस्य प्रियकरावन्योन्यस्य प्रियंवदौ ।\nएकशीलसमाचारौ द्विधैवैकोऽभवच्च यौ \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2117646, "chapter_id": 3532, "verse_number": "४", "content_sanskrit": "तौ विवृद्धौ महावीर्यौ कार्येष्वप्येकनिष्ठितौ ।\nत्रैलोक्यविजये यत्तौ समास्थायैकनिश्चयम् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2117647, "chapter_id": 3532, "verse_number": "५", "content_sanskrit": "दीक्षां कृत्वा गतौ विन्ध्यं तत्रोग्रं तेपतुस्तपः ।\nतौ तु दीर्घेण कालेन तपोयुक्तौ बभूवतुः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2117648, "chapter_id": 3532, "verse_number": "६", "content_sanskrit": "क्षुत्पिपासापरिश्रान्तौ जटावल्कलधारिणौ ।\nमलोपचितसर्वाङ्गो वायुभक्षौ बभूवतुः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2117649, "chapter_id": 3532, "verse_number": "७", "content_sanskrit": "आत्ममांसानि जुह्वन्तौ पादाङ्गुष्ठाग्रविष्ठितौ ।\nऊर्ध्वबाहू ह्यनिमिषौ दीर्घकालं धृतव्रतौ \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2117650, "chapter_id": 3532, "verse_number": "८", "content_sanskrit": "तयोस्तपःप्रभावेण दीर्घकालं प्रतापितः ।\nधूमं प्रमुमुचे विन्ध्यस्तदद्भुतमिवाभवत् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2117651, "chapter_id": 3532, "verse_number": "९", "content_sanskrit": "ततो देवा भवन् भीता उग्रं दृष्ट्वा तयोस्तपः ।\nततस्तपोविघातार्थं देवा विघ्नानि चक्रिरे \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2117652, "chapter_id": 3532, "verse_number": "१०", "content_sanskrit": "रत्नैः प्रलोभयामासुः स्त्रीभिश्चोभौ पुनः पुनः ।\nन च तौ चक्रतुर्भङ्गं व्रतस्य तु महाव्रतौ\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2117653, "chapter_id": 3532, "verse_number": "११", "content_sanskrit": "अथ मायां पुनर्देवास्तयोश्चक्रुर्महात्मनोः ।\nभगिन्यो मातरो भार्यास्तयोः परिजनास्तथा\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2117654, "chapter_id": 3532, "verse_number": "१२", "content_sanskrit": "परिपात्यमाना वित्रस्ताः शूलहस्तेन रक्षसा ।\nस्रस्ताभरणकेशान्ता एकान्तभ्रष्टवाससः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2117655, "chapter_id": 3532, "verse_number": "१३", "content_sanskrit": "अभिभाष्य तु ताः सर्वास्तौ त्राहीति पुनः पुनः ।\nयदा क्षोभं न गच्छेतामार्तिं वैकतरस्तयोः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2117656, "chapter_id": 3532, "verse_number": "१४", "content_sanskrit": "ततः स्त्रियस्ताः सन्त्रस्ताः सर्वमन्तरधीयत ।\nततः पितामहः साक्षादभिगम्य महासुरौ \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2117657, "chapter_id": 3532, "verse_number": "१५", "content_sanskrit": "वरेण च्छन्दयामास सर्वलोकपितामहः ।\nततः सुन्दोपसुन्दौ तौ भ्रातरौ दृढविक्रमौ \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2117658, "chapter_id": 3532, "verse_number": "१६", "content_sanskrit": "दृष्ट्वा पितामहं देवमुभौ तौ प्राञ्जली तदा ।\nऊचतुश्च प्रभुं देवं ततस्तौ सहितौ तदा \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2117659, "chapter_id": 3532, "verse_number": "१७", "content_sanskrit": "आवयोस्तपसाऽनेन यदि प्रीतः पितामहः ।\nमायाविदावस्त्रविदौ बलिनौ कामरूपिणौ ।\nउभावप्यमरौ स्यावः प्रसन्नो यदि नौ प्रभुः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2117660, "chapter_id": 3532, "verse_number": "", "content_sanskrit": "पितामहः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2117661, "chapter_id": 3532, "verse_number": "१८", "content_sanskrit": "ऋतेऽमरत्वादन्यद् वः सर्वमुक्तं भविष्यति ।\nअन्यद् वृणीतां मृत्योश्च विधानममरैः सह ।\nकरिष्यामीदमिति यन्महदप्युत्थितं तपः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2117662, "chapter_id": 3532, "verse_number": "", "content_sanskrit": "सुन्दोपसुन्दौ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2117663, "chapter_id": 3532, "verse_number": "१९", "content_sanskrit": "आवयोर्हेतुना केन नामरत्वं विधीयते \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2117664, "chapter_id": 3532, "verse_number": "", "content_sanskrit": "पितामहः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2117665, "chapter_id": 3532, "verse_number": "२०", "content_sanskrit": "त्रैलोक्यविजयार्थाय भवद्भ्यामास्थितं तपः ।\nहेतुनाऽनेन दैत्येन्द्रौ न वां कामं करोम्यहम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2117666, "chapter_id": 3532, "verse_number": "", "content_sanskrit": "सुन्दोपसुन्दौ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2117667, "chapter_id": 3532, "verse_number": "२१", "content_sanskrit": "त्रिषु लोकेषु यद्भूतं सर्वं स्थावरजङ्गमम् ।\nसर्वस्मान्नौ भयं न स्याद् ऋतेऽन्योन्यात् पितामह \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2117668, "chapter_id": 3532, "verse_number": "", "content_sanskrit": "पितामहः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2117669, "chapter_id": 3532, "verse_number": "२२", "content_sanskrit": "यत् प्रार्थितं यथोक्तं तत् काममेव ददामि वाम् ।\nमृत्योर्विधानमेतच्च यथावद् वां भविष्यति \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2117670, "chapter_id": 3532, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2117671, "chapter_id": 3532, "verse_number": "२३", "content_sanskrit": "ततः पितामहो दत्त्वा वरमेतत् तदा तयोः ।\nनिवर्त्य तपसस्तौ च ब्रह्मलोकं जगाम ह \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2117672, "chapter_id": 3532, "verse_number": "२४", "content_sanskrit": "लब्ध्वा वरं यथान्यायं दैत्येन्द्रावपि तावुभौ ।\nअवध्यौ सर्वलोकस्य स्वयमेवावनिं गतौ \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2117673, "chapter_id": 3532, "verse_number": "२५", "content_sanskrit": "तौ तु लब्धवरौ दृष्ट्वा कृतकामौ महासुरौ ।\nसर्वः सुहृज्जनस्ताभ्यां प्रहर्षमुपजग्मिवान् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2117674, "chapter_id": 3532, "verse_number": "२६", "content_sanskrit": "ततस्तौ तु जटा भित्त्वा मौलिनौ सम्बभूवतुः ।\nमहार्हाभरणोपेतौ विरजाम्बरधारिणौ \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2117675, "chapter_id": 3532, "verse_number": "२७", "content_sanskrit": "अकालकौमुदीं चैवं चक्रतुः सर्वकामिनीः ।\nदैत्येन्द्रौ परमप्रीतौ तयोश्चैव सुहृज्जने \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2117676, "chapter_id": 3532, "verse_number": "२८", "content_sanskrit": "भक्ष्यतां भुज्यतां नित्यं रम्यतां गीयतामिति ।\nपीयतां दीयतां चेति वाच आसन् गृहे गृहे \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2117677, "chapter_id": 3532, "verse_number": "२९", "content_sanskrit": "तत्र तत्र महानादैरुद्घृष्टतळनादितैः ।\nहृष्टं प्रमुदितं सर्वं दैत्यानामभवत् पुरम् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2117678, "chapter_id": 3532, "verse_number": "३०", "content_sanskrit": "तैस्तैर्विहारैर्बहुभिर्दैत्येन्द्राणां महौजसाम् ।\nसमाः सङ्क्रीडतां तेषामहरेकमिवाभवत्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2117679, "chapter_id": 3532, "verse_number": "२११", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nएकादशाधिकद्विशततमोऽध्यायः ॥२११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2117680, "chapter_id": 3532, "verse_number": "३", "content_sanskrit": "॥ इति राज्यलाभपर्वणि तृतीयोऽध्यायः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2117681, "chapter_id": 3532, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]