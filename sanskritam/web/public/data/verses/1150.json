[{"id": 2007769, "chapter_id": 1150, "verse_number": "१-१५१-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2007770, "chapter_id": 1150, "verse_number": "१-१५१-१", "content_sanskrit": "धृतराष्ट्रस्तु राजन्द्रे यदा कौरवनन्दनम्।\nयुधिष्ठिरं विजानन्वै समर्थं राज्यरक्षणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2007771, "chapter_id": 1150, "verse_number": "१-१५१-२", "content_sanskrit": "यौवराज्याभिषेकार्थममन्त्रयत मन्त्रिभिः।\nते तु बुद्ध्वान्वतप्यन्त धृतराष्ट्रात्मजास्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2007772, "chapter_id": 1150, "verse_number": "१-१५१-३", "content_sanskrit": "ततः संवत्सरस्यान्ते यौवराज्याय पार्थिव।\nस्थापितो धृतराष्ट्रेण पाण्डुपुत्रो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2007773, "chapter_id": 1150, "verse_number": "१-१५१-४", "content_sanskrit": "ततोऽदीर्घेण कालेन कुन्तीपुत्रो युधिष्ठिरः।\nपितुरन्तर्दधे कीर्तिं शीलवृत्तसमाधिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2007774, "chapter_id": 1150, "verse_number": "१-१५१-५", "content_sanskrit": "असियुद्धे गदायुद्धे रथयुद्धे च पाण्डवः।\nसंकर्षणादशिक्षद्वै शश्वच्छिक्षां वृकोदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2007775, "chapter_id": 1150, "verse_number": "१-१५१-६", "content_sanskrit": "समाप्तशिक्षो भीमस्तु द्युमत्सेनसमो बले।\nपराक्रमेण संपन्नो भ्रातॄणामचरद्वशे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2007776, "chapter_id": 1150, "verse_number": "१-१५१-७", "content_sanskrit": "प्रगाढदृढमुष्टित्वे लाघवे वेधने तथा।\nक्षुरनाराचभल्लानां विपाठानां च तत्त्ववित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2007777, "chapter_id": 1150, "verse_number": "१-१५१-८", "content_sanskrit": "ऋजुवक्रविशालानां प्रयोक्ता फाल्गुनोऽभवत्।\nलाघवे सौष्ठवे चैव नान्यः कश्चन विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2007778, "chapter_id": 1150, "verse_number": "१-१५१-९", "content_sanskrit": "बीभत्सुसदृशो लोक इति द्रोणो व्यवस्थितः।\nततोऽब्रवीद्गुडाकेशं द्रोणः कौरवसंसदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2007779, "chapter_id": 1150, "verse_number": "१-१५१-१०", "content_sanskrit": "अगस्त्यस्य धनुर्वेदे शिष्यो मम गुरुः पुरा।\nअग्निवेश्य इति ख्यातस्तस्य शिष्योऽस्मि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2007780, "chapter_id": 1150, "verse_number": "१-१५१-११", "content_sanskrit": "तीर्थात्तीर्थं गमयितुमहमेतत्समुद्यतः।\nतपसा यन्मया प्राप्तममोघमशनिप्रभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2007781, "chapter_id": 1150, "verse_number": "१-१५१-१२", "content_sanskrit": "अस्त्रं ब्रह्मशिरो नाम यद्दहेत्पृथिवीमपि।\nददता गुरुणा चोक्तं न मनुष्येष्विदंत्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2007782, "chapter_id": 1150, "verse_number": "१-१५१-१३", "content_sanskrit": "भारद्वाज विमोक्तव्यमल्पवीर्येषु संयुगे।\nयद्यदन्तर्हितं भूतं किंचिद्युद्ध्येत्त्वया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2007783, "chapter_id": 1150, "verse_number": "१-१५१-१४", "content_sanskrit": "महातेजस्त्वमेतेन हन्याः शस्त्रेण संयुगे।\nत्वया प्राप्तमिदं वीर दिव्यं नान्योऽर्हति त्विदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2007784, "chapter_id": 1150, "verse_number": "१-१५१-१५", "content_sanskrit": "समयस्तु त्वया रक्ष्यो मुनिसृष्टो विशांपते।\nआचार्यदक्षिणां देहि ज्ञातिग्रामस्य पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2007785, "chapter_id": 1150, "verse_number": "१-१५१-१६", "content_sanskrit": "ददानीति प्रतिज्ञाते फाल्गुनेनाब्रवीद्गुरुः।\nयुद्धेऽहं प्रतियोद्धव्यो युध्यमानस्त्वयाऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2007786, "chapter_id": 1150, "verse_number": "१-१५१-१७", "content_sanskrit": "तथेति च प्रतिज्ञाय द्रोणाय कुरुपुङ्गवः।\nउपसंगृह्य चरणावुपतस्थे विनीतवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2007787, "chapter_id": 1150, "verse_number": "१-१५१-१८", "content_sanskrit": "द्रोणो जगाद वचनं समालिङ्ग्य तु फाल्गुनम्।\nयन्मयोक्तं पुरा पार्थ तव लोके नरं क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2007788, "chapter_id": 1150, "verse_number": "१-१५१-१९", "content_sanskrit": "सदृशं कारये नैव सर्वप्रहरणे युधि।\nतत्कृतं च मया सम्यक्तव तुल्यो न वर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2007789, "chapter_id": 1150, "verse_number": "१-१५१-२०", "content_sanskrit": "देवा युधि न शक्तास्त्वां योद्धुं दैत्या न दानवाः।\nनाहं त्वत्तो विशिष्टोऽस्मि किं पुनर्मानवा रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2007790, "chapter_id": 1150, "verse_number": "१-१५१-२१", "content_sanskrit": "एकस्तवाधिको लोके यो हि वृष्णिकुलोद्भवः।\nकृष्णः कमलपत्राक्षः कंसकालियसूदनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2007791, "chapter_id": 1150, "verse_number": "१-१५१-२२", "content_sanskrit": "स जेता सर्वलोकानां सर्वप्रहरणायुधः।\nनैतावता ते पार्थाहं भवाम्यनृतवागिह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2007792, "chapter_id": 1150, "verse_number": "१-१५१-२३", "content_sanskrit": "तदधीनं जगत्सर्वं तत्प्रलीनं तदुद्भवम्।\nतत्पदं न विजानन्ति ब्रह्मेशानादयोऽपि वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2007793, "chapter_id": 1150, "verse_number": "१-१५१-२४", "content_sanskrit": "तन्नाभिप्रभवो ब्रह्मा सर्वभूतानि निर्ममे।\nस एव कर्ता भोक्ता च संहर्ता च जगन्मयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2007794, "chapter_id": 1150, "verse_number": "१-१५१-२५", "content_sanskrit": "स एव भूतं भव्यं च भवच्च पुरुषः परः।\nनित्यः सर्वगतः स्थाणुरचलोऽयं सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2007795, "chapter_id": 1150, "verse_number": "१-१५१-२६", "content_sanskrit": "प्रादुर्भवति योगात्मा पालनार्थं स लीलया।\nतत्तुल्यो हि न जायेत न जातो न जनिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2007796, "chapter_id": 1150, "verse_number": "१-१५१-२७", "content_sanskrit": "स हि मातुलजोऽभूत्ते चराचरगुरुः पिता।\nको हि तं जेतुमीहेत जानन्नात्महितं नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2007797, "chapter_id": 1150, "verse_number": "१-१५१-२८", "content_sanskrit": "श्यालश्च ते सखा चासौ तस्य त्वं प्राणवल्लभः।\nस्नेहमभ्यधिकं तस्य तव सख्यमवस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2007798, "chapter_id": 1150, "verse_number": "१-१५१-२९", "content_sanskrit": "न तेन भवतो युद्धं भविता नर्मतोऽपि वा।\nअपिचार्थे तव पुरा शक्रेण किल चोदितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2007799, "chapter_id": 1150, "verse_number": "१-१५१-३०", "content_sanskrit": "गोकुले वर्धमानस्तु नन्दगोपस्य कारणात्।\nममांशः पाण्डवो लोके पृथिव्यां पुरुषोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2007800, "chapter_id": 1150, "verse_number": "१-१५१-३१", "content_sanskrit": "कौन्तेयावरजः श्रीमानर्जुनो नाम वीर्यवान्।\nभुवो भारापहरणे साहाय्यं ते करिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2007801, "chapter_id": 1150, "verse_number": "१-१५१-३२", "content_sanskrit": "तदर्थमभयं देहि पाहि चास्मत्कृते प्रभो।\nइत्युक्तः पुण्डरीकाक्षस्तदा शक्रेण फल्गुन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2007802, "chapter_id": 1150, "verse_number": "१-१५१-३३", "content_sanskrit": "तमुवाच ततः श्रीमाञ्शङ्खचक्रगदाधरः।\nजानामि पाण्डवे वंशे जातं पार्थं पितृष्वसुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2007803, "chapter_id": 1150, "verse_number": "१-१५१-३४", "content_sanskrit": "पुत्रं परमधर्मिष्ठं सर्वशस्त्रभृतां वरम्।\nपालयामि त्वदंशं तं सर्वलोकमहाभुजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2007804, "chapter_id": 1150, "verse_number": "१-१५१-३५", "content_sanskrit": "आवयोः सख्यसदृशं न च लोके भविष्यति।\nयस्तद्भक्तः समद्भक्तो यस्तं द्वेष्टि स मामपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2007805, "chapter_id": 1150, "verse_number": "१-१५१-३६", "content_sanskrit": "यन्मे वित्तं तु तत्तस्य तं विनाहं न जीवये।\nइति पार्थ पुरा शक्रमाह सर्वेश्वरो हरिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2007806, "chapter_id": 1150, "verse_number": "१-१५१-३७", "content_sanskrit": "तस्मात्तवापि सदृशस्तं विनाभ्यधिकः पुमान्।\nन चेह भविता लोके तमेव शरणं व्रज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2007807, "chapter_id": 1150, "verse_number": "१-१५१-३८", "content_sanskrit": "शरण्यः सर्वभूतानां देवदेवो जनार्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2007808, "chapter_id": 1150, "verse_number": "१-१५१-३९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2007809, "chapter_id": 1150, "verse_number": "१-१५१-३९", "content_sanskrit": "तथेति च प्रतिज्ञाय द्रोणाय कुरुपुङ्गवः।\nउपसंगृह्य चरणौ युधिष्ठिरवशोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2007810, "chapter_id": 1150, "verse_number": "१-१५१-४०", "content_sanskrit": "स्वभावादगमच्छब्दो महीं सागरमेखलाम्।\nअर्जुनस्य समो लोके नास्ति कश्चिद्धनुर्धरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2007811, "chapter_id": 1150, "verse_number": "१-१५१-४१", "content_sanskrit": "गदायुद्धेऽसियुद्धे च रथयुद्धे च पाण्डवः।\nपारगश्च धनुर्युद्धे बभूवाथ धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2007812, "chapter_id": 1150, "verse_number": "१-१५१-४२", "content_sanskrit": "नीतिमान्सकलां नीतिं विबुधाधिपतेस्तदा।\nअस्त्रे शस्त्रे च शास्त्रे च रथनागाश्वकर्मणि।\nअवाप्य सहदेवोऽपि भ्रातॄणां ववृते वशे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2007813, "chapter_id": 1150, "verse_number": "१-१५१-४३", "content_sanskrit": "द्रोणेनैवं विनीतश्च भ्रातॄणां नकुलः प्रियः।\nचित्रयोधी समाख्यातो बभूवातिरथोदितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2007814, "chapter_id": 1150, "verse_number": "१-१५१-४४", "content_sanskrit": "त्रिवर्षकृतयज्ञस्तु गन्धर्वाणामुपप्लवे।\nअर्जुनप्रमुखैः पार्थैः सौवीरः समरे हतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2007815, "chapter_id": 1150, "verse_number": "१-१५१-४५", "content_sanskrit": "न शशाक वशे कर्तुं यं पाण्डुरपि वीर्यवान्।\nसोऽर्जुनेन वशं नीतो राजासीद्यवनाधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2007816, "chapter_id": 1150, "verse_number": "१-१५१-४६", "content_sanskrit": "अतीव बलसंपन्नः सदा मानि कुरून्प्रति।\nविपुलो नाम सौवीरः शस्तः पार्थेन धीमता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2007817, "chapter_id": 1150, "verse_number": "१-१५१-४७", "content_sanskrit": "दत्तामित्र इति ख्यातं सङ्ग्रामे कृतनिश्चयम्।\nसुमित्रं नाम सौवीरमर्जुनोऽदमयच्छरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2007818, "chapter_id": 1150, "verse_number": "१-१५१-४८", "content_sanskrit": "भीमसेनसहायश्च रथानामयुतं च सः।\nअर्जुनः समरे प्राच्यान्सर्वानेकरथोऽजयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2007819, "chapter_id": 1150, "verse_number": "१-१५१-४९", "content_sanskrit": "तथैवैकरथो गत्वा दक्षिणामजयद्दिशम्।\nधनौघं प्रापयामास कुरुराष्ट्रं धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2007820, "chapter_id": 1150, "verse_number": "१-१५१-५०", "content_sanskrit": "यतः पञ्चदशे वर्षे सर्वमेतच्चकार सः।\nतं दृष्ट्वा धार्तराष्ट्राणां ततो भयमजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2007821, "chapter_id": 1150, "verse_number": "१-१५१-५१", "content_sanskrit": "यः सर्वान्धृतराष्ट्रस्य पुत्रान्विप्रचकार ह।\nभीमसेनो महाबाहुर्बलाद्बलवतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2007822, "chapter_id": 1150, "verse_number": "१-१५१-५२", "content_sanskrit": "अदुष्टभावं तं दोषैर्जगृहुर्दोषबुद्धयः।\nधार्तराष्ट्रास्तथा सर्वे भयाद्भीमस्य कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2007823, "chapter_id": 1150, "verse_number": "१-१५१-५३", "content_sanskrit": "तं दृष्ट्वा कर्मभिः पार्थान्सर्वानागतलक्षणान्।\nबलाद्बहुगुणांस्तेभ्यो बिभियुर्दोषबुद्धयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2007824, "chapter_id": 1150, "verse_number": "१-१५१-५४", "content_sanskrit": "एवं सर्वे महात्मानः पाण्डवा मनुजोत्तमाः।\nपरराष्ट्राणि निर्जित्य स्वराष्ट्रं ववृधुः पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2007825, "chapter_id": 1150, "verse_number": "१-१५१-५५", "content_sanskrit": "ततो बलमतिख्यातं विज्ञाय दृढधन्विनाम्।\nदूषितः सहसा भावो धृतराष्ट्रस्य पाण्डुषु।\nस चिन्तापरमो राजा न निद्रामलभन्निशि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2007826, "chapter_id": 1150, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि एकपञ्चाशदधिकशततमोऽध्यायः॥ १५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]