[{"id": 5000049000, "chapter_id": 9049, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे एकोनपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000049001, "chapter_id": 9049, "verse_number": "१-४९-१", "content_sanskrit": "अफलस्तु ततः शक्रो देवानग्निपुरोगमान्।\nअब्रवीत् त्रस्तनयनः सिद्धगन्धर्वचारणान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000049002, "chapter_id": 9049, "verse_number": "१-४९-२", "content_sanskrit": "कुर्वता तपसो विघ्नं गौतमस्य महात्मनः।\nक्रोधमुत्पाद्य हि मया सुरकार्यमिदं कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000049003, "chapter_id": 9049, "verse_number": "१-४९-३", "content_sanskrit": "अफलोऽस्मि कृतस्तेन क्रोधात् सा च निराकृता।\nशापमोक्षेण महता तपोऽस्यापहृतं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000049004, "chapter_id": 9049, "verse_number": "१-४९-४", "content_sanskrit": "तन्मां सुरवराः सर्वे सर्षिसङ्घाः सचारणाः।\nसुरकार्यकरं यूयं सफलं कर्तुमर्हथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000049005, "chapter_id": 9049, "verse_number": "१-४९-५", "content_sanskrit": "शतक्रतोर्वचः श्रुत्वा देवाः साग्निपुरोगमाः।\nपितृदेवानुपेत्याहुः सर्वे सह मरुद्‍गणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000049006, "chapter_id": 9049, "verse_number": "१-४९-६", "content_sanskrit": "अयं मेषः सवृषणः शक्रो ह्यवृषणः कृतः।\nमेषस्य वृषणौ गृह्य शक्रायाशु प्रयच्छत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000049007, "chapter_id": 9049, "verse_number": "१-४९-७", "content_sanskrit": "अफलस्तु कृतो मेषः परां तुष्टिं प्रदास्यति।\nभवतां हर्षणार्थं च ये च दास्यन्ति मानवाः।\nअक्षयं हि फलं तेषां यूयं दास्यथ पुष्कलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000049008, "chapter_id": 9049, "verse_number": "१-४९-८", "content_sanskrit": "अग्नेस्तु वचनं श्रुत्वा पितृदेवाः समागताः।\nउत्पाट्य मेषवृषणौ सहस्राक्षे न्यवेशयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000049009, "chapter_id": 9049, "verse_number": "१-४९-९", "content_sanskrit": "तदाप्रभृति काकुत्स्थ पितृदेवाः समागताः।\nअफलान् भुञ्जते मेषान् फलैस्तेषामयोजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000049010, "chapter_id": 9049, "verse_number": "१-४९-१०", "content_sanskrit": "इन्द्रस्तु मेषवृषणस्तदाप्रभृति राघव।\nगौतमस्य प्रभावेण तपसा च महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000049011, "chapter_id": 9049, "verse_number": "१-४९-११", "content_sanskrit": "तदागच्छ महातेज आश्रमं पुण्यकर्मणः।\nतारयैनां महाभागामहल्यां देवरूपिणीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000049012, "chapter_id": 9049, "verse_number": "१-४९-१२", "content_sanskrit": "विश्वामित्रवचः श्रुत्वा राघवः सहलक्ष्मणः।\nविश्वामित्रं पुरस्कृत्य आश्रमं प्रविवेश ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000049013, "chapter_id": 9049, "verse_number": "१-४९-१३", "content_sanskrit": "ददर्श च महाभागां तपसा द्योतितप्रभाम्।\nलोकैरपि समागम्य दुर्निरीक्ष्यां सुरासुरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000049014, "chapter_id": 9049, "verse_number": "१-४९-१४", "content_sanskrit": "प्रयत्नान्निर्मितां धात्रा दिव्यां मायामयीमिव।\nधूमेनाभिपरीतांगीं दीप्तामग्निशिखामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000049015, "chapter_id": 9049, "verse_number": "१-४९-१५", "content_sanskrit": "सतुषारावृतां साभ्रां पूर्णचन्द्रप्रभामिव।\nमध्येऽम्भसो दुराधर्षां दीप्तां सूर्यप्रभामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000049016, "chapter_id": 9049, "verse_number": "१-४९-१६", "content_sanskrit": "सा हि गौतमवाक्येन दुर्निरीक्ष्या बभूव ह।\nत्रयाणामपि लोकानां यावद् रामस्य दर्शनम्।\nशापस्यान्तमुपागम्य तेषां दर्शनमागता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000049017, "chapter_id": 9049, "verse_number": "१-४९-१७", "content_sanskrit": "राघवौ तु तदा तस्याः पादौ जगृहतुर्मुदा।\nस्मरन्ती गौतमवचः प्रतिजग्राह सा हि तौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000049018, "chapter_id": 9049, "verse_number": "१-४९-१८", "content_sanskrit": "पाद्यमर्घ्यं तथाऽऽतिथ्यं चकार सुसमाहिता।\nप्रतिजग्राह काकुत्स्थो विधिदृष्टेन कर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000049019, "chapter_id": 9049, "verse_number": "१-४९-१९", "content_sanskrit": "पुष्पवृष्टिर्महत्यासीद् देवदुन्दुभिनिःस्वनैः।\nगन्धर्वाप्सरसां चैव महानासीत् समुत्सवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000049020, "chapter_id": 9049, "verse_number": "१-४९-२०", "content_sanskrit": "साधु साध्विति देवास्तामहल्यां समपूजयन्।\nतपोबलविशुद्धाङ्गीं गौतमस्य वशानुगाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000049021, "chapter_id": 9049, "verse_number": "१-४९-२१", "content_sanskrit": "गौतमोऽपि महातेजा अहल्यासहितः सुखी।\nरामं सम्पूज्य विधिवत् तपस्तेपे महातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000049022, "chapter_id": 9049, "verse_number": "१-४९-२२", "content_sanskrit": "रामोऽपि परमां पूजां गौतमस्य महामुनेः।\nसकाशाद् विधिवत् प्राप्य जगाम मिथिलां ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000049023, "chapter_id": 9049, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे एकोनपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]