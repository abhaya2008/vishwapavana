[{"id": 40008748, "chapter_id": 9049, "verse_number": "1", "content_sanskrit": "पुरा राम महाबाहो महाबलपराक्रम। रूपमासीन्ममा चिन्त्यं त्रिषु लोकेषु विश्रुतम् ॥ यथा सोमस्य शक्रस्य सूर्यस्य च यथा वपुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40008749, "chapter_id": 9049, "verse_number": "2", "content_sanskrit": "सोऽहं रूपमिदं कृत्वा लोकवित्रासनं महत् ॥ ऋषीन्वनगतान्राम त्रासयामि ततस्ततः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40008750, "chapter_id": 9049, "verse_number": "3", "content_sanskrit": "ततस्स्थूलशिरा नाम महर्षिः कोपितो मया ॥ सञ्चिन्वन्विविधं वन्यं रूपेणानेन धर्षितः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40008751, "chapter_id": 9049, "verse_number": "4", "content_sanskrit": "तेनाहमुक्तः प्रेक्ष्यैवं घोरशापाभिधायिना ॥ एतदेव नृशंसं ते रूपमस्तु विगर्हितम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40008752, "chapter_id": 9049, "verse_number": "5", "content_sanskrit": "स मया याचितः क्रुद्धश्शापस्योन्तो भवेदिति ॥ अभिशापकृतस्येति तेनेदं भाषितं वचः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40008753, "chapter_id": 9049, "verse_number": "6", "content_sanskrit": "यदा छित्त्वा भुजौ रामस्त्वां दहेद्विजने वने ॥ तदा त्वं प्राप्स्यसे रूपं स्वमेव विपुलं शुभम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40008754, "chapter_id": 9049, "verse_number": "7", "content_sanskrit": "श्रिया विराजितं पुत्रं दनोस्त्वं विद्धि लक्ष्मण ॥ इन्द्रकोपादिदं रूपं प्राप्तमेवं रणाजिरे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40008755, "chapter_id": 9049, "verse_number": "8", "content_sanskrit": "अहं हि तपसोग्रेण पितामहमतोषयम् ॥ दीर्घमायुस्स मे प्रादात्ततो मां विभ्रमोऽस्पृशत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40008756, "chapter_id": 9049, "verse_number": "9", "content_sanskrit": "दीर्घमायुर्मया प्राप्तं किं मे शक्रः करिष्यति ॥ इत्येवं बुद्धिमास्थाय रणे शक्रमधर्षयम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40008757, "chapter_id": 9049, "verse_number": "10", "content_sanskrit": "तस्य बाहुप्रयुक्तेन वज्रेण शतपर्वणा ॥ सक्थिनी चैव मूर्धा च शरीरे सम्प्रवेशितम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40008758, "chapter_id": 9049, "verse_number": "11", "content_sanskrit": "स मया याच्यमानस्सन्नानयद्यमसादनम् ॥ पितामहवचस्सत्यं तदस्त्विति ममाब्रवीत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40008759, "chapter_id": 9049, "verse_number": "12", "content_sanskrit": "अनाहारः कथं शक्तो भग्नसक्थिशिरोमुखः ॥ वज्रेणाभिहतः कालं सुदीर्घमपि जीवितुम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40008760, "chapter_id": 9049, "verse_number": "13", "content_sanskrit": "एवमुक्तस्तु मे शक्रो बाहू योजनमायतौ ॥ प्रादादास्यं च मे कुक्षौ तीक्ष्णदंष्ट्रमकल्पयत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40008761, "chapter_id": 9049, "verse_number": "14", "content_sanskrit": "सोऽहं भुजाभ्यां दीर्घाभ्यां संकृष्यास्मिन्वने चरान् ॥ सिंहव्दिपमृगव्याघ्रान् भक्षयामि समन्ततः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40008762, "chapter_id": 9049, "verse_number": "15", "content_sanskrit": "स तु मामब्रवीदिन्द्रो यदा रामस्सलक्ष्मणः ॥ छेत्स्यते समरे बाहू तदा स्वर्गं गमिष्यसि।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40008763, "chapter_id": 9049, "verse_number": "16", "content_sanskrit": "अनेन वपुषा राम वनेऽस्मिन्राजसत्तम ॥ यद्यत्पश्यामि सर्वस्य ग्रहणं साधु रोचये।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40008764, "chapter_id": 9049, "verse_number": "17", "content_sanskrit": "अवश्यं ग्रहणं रामो मन्येऽहं समुपैष्यति ॥ इमां बुद्धिं पुरस्कृत्य देहन्यासकृतश्रमः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40008765, "chapter_id": 9049, "verse_number": "18", "content_sanskrit": "स त्वं रामोऽसि भद्रं ते नाहमन्येन राघव ॥ शक्यो हन्तुं यथातत्त्वमेवमुक्तं महर्षिणा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40008766, "chapter_id": 9049, "verse_number": "19", "content_sanskrit": "अहं हि मतिसाचिव्यं करिष्यामि नरर्षभ ॥ मित्रं चैवोपदेक्ष्यामि युवाभ्यां संस्कृतोऽग्निना।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40008767, "chapter_id": 9049, "verse_number": "20", "content_sanskrit": "एवमुक्तस्तु धर्मात्मा दनुना तेन राघवः ॥ इदं जगाद वचनं लक्ष्मणस्योपशृण्वतः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40008768, "chapter_id": 9049, "verse_number": "21", "content_sanskrit": "रावणेन हृता भार्या मम सीता यशस्स्विनी ॥ निष्क्रान्तस्य जनस्थानात्सहभ्रात्रा यथासुखम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40008769, "chapter_id": 9049, "verse_number": "22", "content_sanskrit": "नाममात्रं तु जानामि न रूपं तस्य रक्षसः ॥ निवासं वा प्रभावं वा वयं तस्य न विद्महे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40008770, "chapter_id": 9049, "verse_number": "23", "content_sanskrit": "शोकार्तानामनाथानामेवं विपरिधावताम् ॥ कारुण्यं सदृशं कर्तुमुपकारे च वर्तताम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40008771, "chapter_id": 9049, "verse_number": "24", "content_sanskrit": "काष्ठान्यादाय शुष्काणि काले भग्नानि कुञ्जरैः ॥ धक्ष्यामस्त्वां वयं वीर श्वभ्रे महति कल्पिते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40008772, "chapter_id": 9049, "verse_number": "25", "content_sanskrit": "स त्वं सीतां समाचक्ष्व येन वा यत्र वा हृता ॥ कुरु कल्याणमत्यर्थं यदि जानासि तत्त्वतः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40008773, "chapter_id": 9049, "verse_number": "26", "content_sanskrit": "एवमुक्तस्तु रामेण वाक्यं दनुरनुत्तमम् ॥ प्रोवाच कुशलो वक्तुं वक्तारमपि राघवम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40008774, "chapter_id": 9049, "verse_number": "27", "content_sanskrit": "दिव्यमस्ति न मे ज्ञानं नाभिजानामि मैथिलीम् ॥ यस्तां ज्ञास्यति तं वक्ष्ये दग्धस्स्वं रूपमास्थितः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40008775, "chapter_id": 9049, "verse_number": "28", "content_sanskrit": "अदग्धस्य तु विज्ञातुं शक्तिरस्ति न मे प्रभो ॥ राक्षसं तं महावीर्यं सीता येन हृता तव।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40008776, "chapter_id": 9049, "verse_number": "29", "content_sanskrit": "विज्ञानं हि मम भ्रष्टं शापदोषेण राघव ॥ स्वकृतेन मया प्राप्तं रूपं लोकविगर्हितम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40008777, "chapter_id": 9049, "verse_number": "30", "content_sanskrit": "किं तु यावन्न यात्यस्तं सविता श्रान्तवाहनः ॥ तावन्मामवटे क्षिप्त्वा दह राम यथाविधि।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40008778, "chapter_id": 9049, "verse_number": "31", "content_sanskrit": "दग्धस्त्वयाहमवटे न्यायेन रघुनन्धन ॥ वक्ष्यामि तमहं वीर यस्तं ज्ञास्यति राक्षसम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40008779, "chapter_id": 9049, "verse_number": "32", "content_sanskrit": "तेन सख्यं च कर्तव्यं न्याय्यवृत्तेन राघव ॥ कल्पयिष्यति ते प्रीतस्साहाय्यं लघुविक्रमः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40008780, "chapter_id": 9049, "verse_number": "33", "content_sanskrit": "न हि तस्यास्त्यविज्ञातं त्रिषु लेकेषु राघव ॥ सर्वान्परिसृतो लोकान्पुरासौ कारणान्तरे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]