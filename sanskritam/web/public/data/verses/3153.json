[{"id": 2100408, "chapter_id": 3153, "verse_number": "१४-९-१", "content_sanskrit": "इन्द्र उवाच।\nकच्चित्सुखं स्वपिषि त्वं बृहस्पते\nकच्चिन्मनोज्ञाः परिचारकास्ते।\nकच्चिद्देवानां सुखकामोसि विप्र\nकच्चिद्देवास्त्वां परिपालयन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2100409, "chapter_id": 3153, "verse_number": "१४-९-२x", "content_sanskrit": "बृहस्पतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2100410, "chapter_id": 3153, "verse_number": "१४-९-२", "content_sanskrit": "सुखं शये शयने देवराज\nतथा मनोज्ञाः परिचारका मे।\nतथा देवानां सुखकामोस्मि नित्यं\nदेवाश्च मां सुभृशं पालयन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2100411, "chapter_id": 3153, "verse_number": "१४-९-३x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2100412, "chapter_id": 3153, "verse_number": "१४-९-३", "content_sanskrit": "कुतो दुःखं मानसं देहजं वा\nपाण्डुर्विवर्णश्च कुतस्त्वमद्य।\nआचक्ष्व मे ब्राह्मण यावदेता-\nन्निहन्मि सर्वांस्तव दुःखकर्तॄन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2100413, "chapter_id": 3153, "verse_number": "१४-९-४x", "content_sanskrit": "बृहस्पतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2100414, "chapter_id": 3153, "verse_number": "१४-९-४", "content_sanskrit": "मरुत्तमाहुर्मघवन्यक्ष्यमाणं\nमहायज्ञेनोत्तमदक्षिणेन।\nसंवर्तो याजयतीति मे श्रुतं\nतदिच्छामि न स तं याजयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2100415, "chapter_id": 3153, "verse_number": "१४-९-५x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2100416, "chapter_id": 3153, "verse_number": "१४-९-५", "content_sanskrit": "सर्वान्कामाननुयातोसि विप्र\nत्वं देवानां मन्त्रयसे पुरोधाः।\nउभौ च ते जरामृत्यू व्यतीतौ\nकिं संवर्तस्तव कर्ताऽद्य विप्र॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2100417, "chapter_id": 3153, "verse_number": "१४-९-६x", "content_sanskrit": "बृहस्पतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2100418, "chapter_id": 3153, "verse_number": "१४-९-६", "content_sanskrit": "देवैः सह त्वमसुरान्सम्प्रणुद्य\nजिघांससे चाप्युत सानुबन्धान्।\nयंयं समृद्धं पश्यसि तत्रतत्र\nदुःखं सपत्नेषु समृद्धिभावः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2100419, "chapter_id": 3153, "verse_number": "१४-९-७", "content_sanskrit": "अतोस्मि देवेन्द्र विवर्णरूपः\nसपत्नो मे वर्धते तन्निशम्य।\nसर्वोपायैर्मघवन्संनियच्छ\nसंवर्तं वा पार्थिवं वा मरुत्तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2100420, "chapter_id": 3153, "verse_number": "१४-९-८x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2100421, "chapter_id": 3153, "verse_number": "१४-९-८", "content_sanskrit": "एहि गच्छ प्रहितो जातवेदो\nबृहस्पतिं परिदातुं मरुत्ते।\nअयं वै त्वां याजयिता बृहस्पति-\nस्तथाऽमरं चैव करिष्यतीति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2100422, "chapter_id": 3153, "verse_number": "१४-९-९x", "content_sanskrit": "अग्निरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2100423, "chapter_id": 3153, "verse_number": "१४-९-९", "content_sanskrit": "अहं गच्छामि तव शक्राद्य दूतो\nबृहस्पतिं परिदातुं मरुत्ते।\nवाचं सत्यां पुरुहूतस्य कर्तुं\nबृहस्पतेश्चापचितिं चिकीर्षुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2100424, "chapter_id": 3153, "verse_number": "१४-९-१०x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2100425, "chapter_id": 3153, "verse_number": "१४-९-१०", "content_sanskrit": "ततः प्रायाद्धूमकेतुर्महात्मा\nवनस्पतीन्वीरुधश्चावमृद्गन्।\nकामाद्धिमान्ते परिवर्तमानः\nकाष्ठातिगो मातरिश्वेव नर्दन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2100426, "chapter_id": 3153, "verse_number": "१४-९-११x", "content_sanskrit": "मरुत उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2100427, "chapter_id": 3153, "verse_number": "१४-९-११", "content_sanskrit": "आश्वर्यमद्य पश्यामि रूपिणं वह्निमागतम्।\nआसनं सलिलं पाद्यं गां चोपानय वै मुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2100428, "chapter_id": 3153, "verse_number": "१४-९-१२x", "content_sanskrit": "अग्निरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2100429, "chapter_id": 3153, "verse_number": "१४-९-१२", "content_sanskrit": "आसनं सलिलं पाद्यं प्रतिनन्दामि तेऽनघ।\nइन्द्रेण तु समादिष्टं विद्धि मां दूतमागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2100430, "chapter_id": 3153, "verse_number": "१४-९-१३x", "content_sanskrit": "मरुत उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2100431, "chapter_id": 3153, "verse_number": "१४-९-१३", "content_sanskrit": "कच्चिच्छ्रीमान्देवराजः सुखी च\nकच्चिच्चास्मान्प्रीयते धूमकेतो।\nकच्चिद्देवा अस्य वशे यथाव-\nत्प्रब्रूहि त्वं मम कार्त्स्न्येन देव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2100432, "chapter_id": 3153, "verse_number": "१४-९-१४x", "content_sanskrit": "अग्निरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2100433, "chapter_id": 3153, "verse_number": "१४-९-१४", "content_sanskrit": "शक्रो भृशं सुसुखी पार्थिवेन्द्र\nप्रातिं चेच्छत्यजरां वै त्वया सः।\nदेवाश्च सर्वे वशगास्तस्य राज-\nन्संदेशं त्वं शृणु मे देवराज्ञः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2100434, "chapter_id": 3153, "verse_number": "१४-९-१५", "content_sanskrit": "यदर्थं मां प्राहिणोत्त्वत्सकाशं\nबृहस्पतिं परिदातुं मरुत्ते।\nअयं गुरुर्याजयतां नृप त्वां\nमर्त्यं सन्तममरं त्वां करोतु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2100435, "chapter_id": 3153, "verse_number": "१४-९-१६x", "content_sanskrit": "मरुत उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2100436, "chapter_id": 3153, "verse_number": "१४-९-१६", "content_sanskrit": "संवर्तोऽयं याजयिता द्विजो मां\nबृहस्पतेरञ्जलिरेष तस्य।\nन चैवासौ याजयित्वा महेन्द्रं\nमर्त्यं सन्तं याजयन्नद्य शोभेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2100437, "chapter_id": 3153, "verse_number": "१४-९-१७x", "content_sanskrit": "अग्निरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2100438, "chapter_id": 3153, "verse_number": "१४-९-१७", "content_sanskrit": "ये वै लोका देवलोके महान्तः\nसम्प्राप्स्यसे तान्देवराजप्रसादात्।\nत्वां चेदसौ याजयेद्वै बृहस्पति-\nर्नूनं स्वर्गं त्वं जयेः कीर्तियुक्तः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2100439, "chapter_id": 3153, "verse_number": "१४-९-१८", "content_sanskrit": "तथा लोका मानुषा ये च दिव्याः\nप्रजापतेश्चापि ये वै महान्तः।\nतेते जिता देवराज्यं च कृत्स्नं\nबृहस्पतिर्याजयेच्चेन्नरेन्द्र॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2100440, "chapter_id": 3153, "verse_number": "१४-९-१९x", "content_sanskrit": "संवर्त उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2100441, "chapter_id": 3153, "verse_number": "१४-९-१९", "content_sanskrit": "मा स्मैव त्वं पुनरागाः कथंचि-\nद्बृहस्पतिं परिदातुं मरुत्ते।\nमा त्वां धक्ष्ये चक्षुषा दारुणेन\nसंक्रुद्धोऽहं पावक त्वं निबोधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2100442, "chapter_id": 3153, "verse_number": "१४-९-२०x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2100443, "chapter_id": 3153, "verse_number": "१४-९-२०", "content_sanskrit": "ततो देवानगमद्धूमकेतु-\nदीहाद्भीतो व्यथितोऽश्वत्थपर्णवत्।\nतं वै दृष्ट्वा प्राह शक्रो महात्मा\nबृहस्पतेः सन्निधौ हव्यवाहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2100444, "chapter_id": 3153, "verse_number": "१४-९-२१", "content_sanskrit": "यस्त्वं गतः प्रहितो जातवेदो\nबृहस्पतिं परिदातुं मरुत्ते।\nतत्किं प्राह स नृपो यक्ष्यमाणः\nकच्चिद्वचः प्रतिगृह्णाति तच्च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2100445, "chapter_id": 3153, "verse_number": "१४-९-२२x", "content_sanskrit": "अग्निरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2100446, "chapter_id": 3153, "verse_number": "१४-९-२२", "content_sanskrit": "न ते वाचं रोचयते मरुत्तो\nबृहस्पतेरञ्जलिं प्राहिणोत्सः।\nसंवर्तो मां याजयितेत्युवाच\nपुनः पुनः स मया याच्यमानः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2100447, "chapter_id": 3153, "verse_number": "१४-९-२३", "content_sanskrit": "उवाचेदं मानुषा ये च दिव्या।\nप्रजापतेर्ये च लोका महान्तः।\nतांश्चेल्लभेयं संविदं तेन कृत्वा\nतथापि नेच्छेयमिति प्रतीतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2100448, "chapter_id": 3153, "verse_number": "१४-९-२४x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2100449, "chapter_id": 3153, "verse_number": "१४-९-२४", "content_sanskrit": "पुनर्गत्वा पार्थिवं त्वं समेत्य\nवाक्यं मदीयं प्रापय स्वार्थयुक्तम्।\nपुनर्यद्युक्तो न करिष्यते वच-\nस्त्वत्तो वज्रं सम्प्रहर्तास्मि तस्मै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2100450, "chapter_id": 3153, "verse_number": "१४-९-२५x", "content_sanskrit": "अग्निरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2100451, "chapter_id": 3153, "verse_number": "१४-९-२५", "content_sanskrit": "गन्धर्वराड्यात्वयं तत्र दूतो\nबिभेम्यहं वासव तत्र गन्तुम्।\nसंरब्धो मामब्रवीत्तीक्ष्णरोषः\nसंवर्तो वाक्यं चरितब्रह्मचर्यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2100452, "chapter_id": 3153, "verse_number": "१४-९-२६", "content_sanskrit": "यद्यागच्छेः पुनरेवं कथंचि-\nद्बृहस्पतिं परिदातुं मरुत्ते।\nदहेयं त्वां चक्षुषा दारुणेन\nसंक्रुद्ध इत्येतदवैहि शक्र॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2100453, "chapter_id": 3153, "verse_number": "१४-९-२७x", "content_sanskrit": "शक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2100454, "chapter_id": 3153, "verse_number": "१४-९-२७", "content_sanskrit": "त्वमेवान्यान्दहसे जातवेदो\nन हि त्वदन्यो विद्यते भस्मकर्ता।\nत्वत्संस्पर्शात्सर्वलोको बिभेति\nअश्रद्धेयं वदसे हव्यवाह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2100455, "chapter_id": 3153, "verse_number": "१४-९-२८x", "content_sanskrit": "अग्निरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2100456, "chapter_id": 3153, "verse_number": "१४-९-२८", "content_sanskrit": "दिवं देवेन्द्र पृथिवीं च सर्वां\nसंवेष्टयेस्त्वं स्वबलेनैव शक्र।\nएवंविधस्येह सतस्तवासौ\nकथं वृत्रस्त्रिदिवं प्राग्जहार॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2100457, "chapter_id": 3153, "verse_number": "१४-९-२९x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2100458, "chapter_id": 3153, "verse_number": "१४-९-२९", "content_sanskrit": "नगण्डिकाकारयोगं करेऽणुं\nन चारिसोमं प्रपिबामि वह्ने।\nन क्षीणशक्तौ प्रहारामि वज्रं\nको मे सुखाय प्रहरेत मर्त्यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2100459, "chapter_id": 3153, "verse_number": "१४-९-३०", "content_sanskrit": "प्रव्रजयेयं कालकेयान्पृथिव्या-\nमपाकर्षन्दानवानन्तरिक्षात्।\nदिवः प्रह्लादमवसानमानयं\nको मेऽसुखाय प्रहरेत मानवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2100460, "chapter_id": 3153, "verse_number": "१४-९-३१x", "content_sanskrit": "अग्निरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2100461, "chapter_id": 3153, "verse_number": "१४-९-३१", "content_sanskrit": "यत्र शर्यातिं च्यवनो याजयिष्य-\nन्सहाश्विभ्यां सोममगृह्णदेकः।\nतं त्वं क्रुद्धः प्रत्यषेधीः पुरस्ता-\nच्छर्यातियज्ञं स्म तं महेन्द्र॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2100462, "chapter_id": 3153, "verse_number": "१४-९-३२", "content_sanskrit": "वज्रं गृहीत्वा च पुरन्दर त्वं\nसम्प्राहार्षीश्च्यवनस्यातिघोरम्।\nस ते विप्रः सह वज्रेणि बाहु-\nमपागृह्णात्तपसा जातमन्युः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2100463, "chapter_id": 3153, "verse_number": "१४-९-३३", "content_sanskrit": "ततो रोषात्सर्वतो घोररूपं\nसपत्नं ते जनयामास भूयः।\nमदं नाम्ना चासुरं विश्वरूपं\nयं त्वं दृष्ट्वा चक्षुषी संन्यमीलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2100464, "chapter_id": 3153, "verse_number": "१४-९-३४", "content_sanskrit": "हनुरेका जगतीस्था तथैका\nदिवं गता महतो दानवस्य।\nसहस्रं दन्तानां शतयोजनानां\nसुतीक्ष्णानां घोररूपं बभूव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2100465, "chapter_id": 3153, "verse_number": "१४-९-३५", "content_sanskrit": "वृत्ताः स्थूला रजतस्तम्भवर्णा\nदंष्ट्राश्चतस्रो द्वे शते योजनानाम्।\nस त्वां दन्तान्विदशन्नभ्यधाव-\nज्जिघांसया शूलमुद्यम्य घोरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2100466, "chapter_id": 3153, "verse_number": "१४-९-३६", "content_sanskrit": "तं नापश्यस्त्वं तदा घोररूपं\nसर्वे वै त्वां ददृशुर्दर्शनीयम्।\nयस्माद्भीतः प्राञ्जलिस्त्वं महर्षि-\nमागच्छेथाः शरणं दानवघ्न॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2100467, "chapter_id": 3153, "verse_number": "१४-९-३७", "content_sanskrit": "क्षात्राद्बलाद्ब्रह्मबलं गरीयो\nन ब्रह्मतः किञ्चिदन्यद्गरीयः।\nसोहं जानन्ब्रह्मतेजो यथाव-\nन्न संवर्त गन्तुमिच्छामि शक्र॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2100468, "chapter_id": 3153, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अश्वमेधपर्वणि नवमोऽध्यायः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]