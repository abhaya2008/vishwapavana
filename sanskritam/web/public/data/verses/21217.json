[{"id": 7001217000, "chapter_id": 21217, "verse_number": "२-४-१०-१", "content_sanskrit": "ब्रह्मोवाच ।\nनिवार्य वीरभद्रं तं कुमारः परवीरहा ।\nसमैच्छत्तारकवधं स्मृत्वा शिवपदाम्बुजौ॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001217001, "chapter_id": 21217, "verse_number": "२-४-१०-२", "content_sanskrit": "जगर्जाथ महातेजाः कार्तिकेयो महाबलः ।\nसन्नद्धः सोऽभवत्क्रुद्ध सैन्येन महता वृतः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001217002, "chapter_id": 21217, "verse_number": "२-४-१०-३", "content_sanskrit": "तदा जयजयेत्युक्तं सर्वैर्देर्वेर्गणै स्तथा ।\nसंस्तुतो वाग्भिरिष्टाभिस्तदैव च सुरर्षिभिः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001217003, "chapter_id": 21217, "verse_number": "२-४-१०-४", "content_sanskrit": "तारकस्य कुमारस्य संग्रामोऽतीव दुस्सहः ।\nजातस्तदा महाघोरस्सर्वभूत भयंकरः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001217004, "chapter_id": 21217, "verse_number": "२-४-१०-५", "content_sanskrit": "शक्तिहस्तौ च तौ वीरौ युयुधाते परस्परम् ।\nसर्वेषां पश्यतां तत्र महाश्चर्यवतां मुने॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001217005, "chapter_id": 21217, "verse_number": "२-४-१०-६", "content_sanskrit": "शक्तिनिर्भिन्नदेहौ तौ महासाधनसंयुतौ ।\nपरस्परं वंचयंतौ सिंहाविव महाबलौ॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001217006, "chapter_id": 21217, "verse_number": "२-४-१०-७", "content_sanskrit": "वैतालिकं समाश्रित्य तथा खेचरकं मतम् ।\nपापं तं च समाश्रित्य शक्त्या शक्तिं विजघ्नतुः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001217007, "chapter_id": 21217, "verse_number": "२-४-१०-८", "content_sanskrit": "एभिर्मंत्रैर्महावीरौ चक्रतुर्युद्धमद्भुतम् ।\nअन्योन्यं साधकौ भूत्वा महाबलपराक्रमौ॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001217008, "chapter_id": 21217, "verse_number": "२-४-१०-९", "content_sanskrit": "महाबलं प्रकुर्वतौ परस्परवधैषिणौ ।\nजघ्नतुश्शक्तिधाराभी रणे रणविशारदौ॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001217009, "chapter_id": 21217, "verse_number": "२-४-१०-१०", "content_sanskrit": "मूर्ध्नि कंठे तथा चोर्वोर्जान्वोश्चैव कटीतटे ।\nवक्षस्युरसि पृष्ठे च चिच्छिदुश्च परस्परम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001217010, "chapter_id": 21217, "verse_number": "२-४-१०-११", "content_sanskrit": "तदा तौ युध्यमानौ च हन्तुकामौ महाबलौ ।\nवल्गन्तौ वीरशब्दैश्च नानायुद्धविशारदौ॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001217011, "chapter_id": 21217, "verse_number": "२-४-१०-१२", "content_sanskrit": "अभवन्प्रेक्षकास्सर्वे देवा गंधर्वकिन्नराः ।\nऊचुः परस्परं तत्र कोस्मिन्युद्धे विजेष्यते॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001217012, "chapter_id": 21217, "verse_number": "२-४-१०-१३", "content_sanskrit": "तदा नभोगता वाणी जगौ देवांश्च सांत्वयन् ।\nअसुरं तारकं चात्र कुमारोऽयं हनिष्यति॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001217013, "chapter_id": 21217, "verse_number": "२-४-१०-१४", "content_sanskrit": "मा शोच्यतां सुरैः सर्वै सुखेन स्थीयतामिति ।\nयुष्मदर्थं शंकरो हि पुत्ररूपेण संस्थितः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001217014, "chapter_id": 21217, "verse_number": "२-४-१०-१५", "content_sanskrit": "श्रुत्वा तदा तां गगने समीरितां वाचं शुभां सप्रमथेस्समावृतः ।\nनिहंतुकामः सुखितः कुमारको दैत्याधिपं तारकमाश्वभूत्तदा॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001217015, "chapter_id": 21217, "verse_number": "२-४-१०-१६", "content_sanskrit": "शक्त्या तया महाबाहुराजघानस्तनांतरे ।\nकुमारः स्म रुषाविष्टस्तारकासुरमोजसा॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001217016, "chapter_id": 21217, "verse_number": "२-४-१०-१७", "content_sanskrit": "तं प्रहारमनादृत्य तारको दैत्यपुंगवः ।\nकुमारं चापि संक्रुद्धस्स्वशक्त्या संजघान सः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001217017, "chapter_id": 21217, "verse_number": "२-४-१०-१८", "content_sanskrit": "तेन शक्तिप्रहारेण शांकरिर्मूच्छि तोऽभवत् ।\nमुहूर्ताच्चेतनां प्राप स्तूयमानो महर्षिभिः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001217018, "chapter_id": 21217, "verse_number": "२-४-१०-१९", "content_sanskrit": "यथा सिंहो मदोन्मत्तो हंतुकामस्तथासुरम् ।\nकुमारस्तारकं शक्त्या स जघान प्रतापवान्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001217019, "chapter_id": 21217, "verse_number": "२-४-१०-२०", "content_sanskrit": "एवं परस्परं तौ हि कुमारश्चापि तारकः ।\nयुयुधातेऽतिसंरब्धौ शक्तियुद्धविशारदौ॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001217020, "chapter_id": 21217, "verse_number": "२-४-१०-२१", "content_sanskrit": "अभ्यासपरमावास्तामन्योन्यं विजिगीषया ।\nपदातिनौ युध्यमान्नौ चित्ररूपौ तरस्विनौ॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001217021, "chapter_id": 21217, "verse_number": "२-४-१०-२२", "content_sanskrit": "विविधैर्घातपुंजैस्तावन्योन्यं विनि जघ्नतुः ।\nनानामार्गान्प्रकुर्वन्तौ गर्जंतौ सुपराक्रमौ॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001217022, "chapter_id": 21217, "verse_number": "२-४-१०-२३", "content_sanskrit": "अवलोकपरास्सर्वे देवगंधर्वकिन्नराः ।\nविस्मयं परमं जग्मुर्नोचुः किंचन तत्र ते॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001217023, "chapter_id": 21217, "verse_number": "२-४-१०-२४", "content_sanskrit": "न ववौ पवमानश्च निष्प्रभोऽभूद्दिवाकरः ।\nचचाल वसुधा सर्वा सशैलवनकानना॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001217024, "chapter_id": 21217, "verse_number": "२-४-१०-२५", "content_sanskrit": "एतस्मिन्नंतरे तत्र हिमालयमुखा धराः ।\nस्नेहार्दितास्तदा जग्मुः कुमारं च परीप्सवः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001217025, "chapter_id": 21217, "verse_number": "२-४-१०-२६", "content_sanskrit": "ततस्स दृष्ट्वा तान्सर्वान्भयभीतांश्च शांकरिः ।\nपर्वतान्गिरिजापुत्रो बभाषे परिबोधयन्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001217026, "chapter_id": 21217, "verse_number": "२-४-१०-२७", "content_sanskrit": "कुमार उवाच ।\nमा खिद्यतां महाभागा मा चिंतां कुर्वतां नगाः ।\nघातयाम्यद्य पापिष्ठं सर्वेषां वः प्रपश्य ताम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001217027, "chapter_id": 21217, "verse_number": "२-४-१०-२८", "content_sanskrit": "एवं समाश्वास्य तदा पर्वतान्निर्जरान्गणान् ।\nप्रणम्य गिरिजां शंभुमाददे शक्तिमुत्प्रभाम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001217028, "chapter_id": 21217, "verse_number": "२-४-१०-२९", "content_sanskrit": "तं तारकं हंतुमनाः करशक्तिर्महाप्रभुः ।\nविरराज महावीरः कुमारश्शंभुबालकः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001217029, "chapter_id": 21217, "verse_number": "२-४-१०-३०", "content_sanskrit": "शक्त्या तया जघानाथ कुमारस्तारकासुरम् ।\nतेजसाढ्यश्शंकरस्य लोकक्लेशकरं च तम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001217030, "chapter_id": 21217, "verse_number": "२-४-१०-३१", "content_sanskrit": "पपात सद्यस्सहसा विशीर्णांगोऽसुरः क्षितौ ।\nतारकाख्यो महावीरस्सर्वासुरगणाधिपः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001217031, "chapter_id": 21217, "verse_number": "२-४-१०-३२", "content_sanskrit": "कुमारेण हतस्सोतिवीरस्स खलु तारकः ।\nलयं ययौ च तत्रैव सर्वेषां पश्यतां मुने॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001217032, "chapter_id": 21217, "verse_number": "२-४-१०-३३", "content_sanskrit": "तथा तं पतितं दृष्ट्वा तारकं बलवत्तरम् ।\nन जघान पुनर्वीरस्स गत्वा व्यसुमाहवे॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001217033, "chapter_id": 21217, "verse_number": "२-४-१०-३४", "content_sanskrit": "हते तस्मिन्महादैत्ये तारकाख्ये महाबले ।\nक्षयं प्रणीता बहवोऽसुरा देवगणैस्तदा॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001217034, "chapter_id": 21217, "verse_number": "२-४-१०-३५", "content_sanskrit": "केचिद्भीताः प्रांजलयो बभूवुस्तत्र चाहवे ।\nछिन्नभिन्नांगकाः केचिन्मृता दैत्यास्सहस्रशः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001217035, "chapter_id": 21217, "verse_number": "२-४-१०-३६", "content_sanskrit": "केचिज्जाताः कुमारस्य शरणं शरणार्थिनः ।\nवदन्तः पाहि पाहीति दैत्याः सांजलयस्तदा॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001217036, "chapter_id": 21217, "verse_number": "२-४-१०-३७", "content_sanskrit": "कियंतश्च हतास्तत्र कियंतश्च पलायिताः ।\nपलायमाना व्यथिता स्ताडिता निर्ज्जरैर्गणैः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001217037, "chapter_id": 21217, "verse_number": "२-४-१०-३८", "content_sanskrit": "सहस्रशः प्रविष्टास्ते पाताले च जिजीषवः ।\nपलायमानास्ते सर्वे भग्नाशा दैन्यमागताः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001217038, "chapter_id": 21217, "verse_number": "२-४-१०-३९", "content_sanskrit": "एवं सर्वं दैत्यसैन्यं भ्रष्टं जातं मुनीश्वर ।\nन केचित्तत्र संतस्थुर्गणदेवभयात्तदा॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001217039, "chapter_id": 21217, "verse_number": "२-४-१०-४०", "content_sanskrit": "आसीन्निष्कंटकं सर्वं हते तस्मिन्दुरात्मनि ।\nते देवाः सुखमापन्नास्सर्वे शक्रादयस्तदा॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001217040, "chapter_id": 21217, "verse_number": "२-४-१०-४१", "content_sanskrit": "एवं विजयमापन्नं कुमारं निखिलास्सुराः ।\nबभूवुर्युगपद्धृष्टास्त्रिलोकाश्च महासुखा॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001217041, "chapter_id": 21217, "verse_number": "२-४-१०-४२", "content_sanskrit": "तदा शिवोऽपि तं ज्ञात्वा विजयं कार्तिकस्य च ।\nतत्राजगाम स मुदा सगणः प्रियया सह॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001217042, "chapter_id": 21217, "verse_number": "२-४-१०-४३", "content_sanskrit": "स्वात्मजं स्वांकमारोप्य कुमारं सूर्यवर्चसम् ।\nलालयामास सुप्रीत्या शिवा च स्नेहसंकुला॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001217043, "chapter_id": 21217, "verse_number": "२-४-१०-४४", "content_sanskrit": "हिमालयस्तदागत्य स्वपुत्रैः परिवारितः ।\nसबंधुस्सानुगश्शंभुं तुष्टाव च शिवां गुहम्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001217044, "chapter_id": 21217, "verse_number": "२-४-१०-४५", "content_sanskrit": "ततो देवगणास्सर्वे मुनयस्सिद्धचारणाः ।\nतुष्टुवुश्शांकरिं शंभुं गिरिजां तुषितां भृशम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001217045, "chapter_id": 21217, "verse_number": "२-४-१०-४६", "content_sanskrit": "पुष्पवृष्टिं सुमहतीं चक्रुश्चोपसुरास्तदा ।\nजगुर्गंधर्वपतयो ननृतुश्चाप्सरोगणाः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001217046, "chapter_id": 21217, "verse_number": "२-४-१०-४७", "content_sanskrit": "वादित्राणि तथा नेदुस्तदानीं च विशेषतः ।\nजयशब्दो नमः शब्दो बभूवोच्चैर्मुहुर्मुहुः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001217047, "chapter_id": 21217, "verse_number": "२-४-१०-४८", "content_sanskrit": "ततो मयाच्युतश्चापि संतुष्टोभूद्विशेषतः ।\nशिवं शिवां कुमारं च संतुष्टाव समादरात्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001217048, "chapter_id": 21217, "verse_number": "२-४-१०-४९", "content_sanskrit": "कुमारमग्रतः कृत्वा हरिकेन्द्रमुखास्सुराः ।\nचक्रुर्नीराजनं प्रीत्या मुनयश्चापरे तथा॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001217049, "chapter_id": 21217, "verse_number": "२-४-१०-५०", "content_sanskrit": "गीतवादित्रघोषेण ब्रह्मघोषेण भूयसा ।\nतदोत्सवो महानासीत्कीर्तनं च विशेषतः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001217050, "chapter_id": 21217, "verse_number": "२-४-१०-५१", "content_sanskrit": "गीतवाद्यैस्सुप्रसन्नैस्तथा साञ्जलिभिर्मुने ।\nस्तूयमानो जगन्नाथस्सर्वैर्दैवैर्गणैरभूत॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001217051, "chapter_id": 21217, "verse_number": "२-४-१०-५२", "content_sanskrit": "ततस्स भगवान्रुद्रो भवान्या जगदंबया ।\nसर्वैः स्तुतो जगामाथ स्वगिरिं स्वगणैर्वृतः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]