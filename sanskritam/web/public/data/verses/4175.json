[{"id": 2147061, "chapter_id": 4175, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2147062, "chapter_id": 4175, "verse_number": "१", "content_sanskrit": "एवमुक्तस्तदा तेन विश्वामित्रेण धीमता ।\nनास्ते न शेते नाहारं कुरुते गालवस्तदा\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2147063, "chapter_id": 4175, "verse_number": "२", "content_sanskrit": "त्वगस्थिभूतो हरिणः चिन्ताशोकपरायणः ।\nशोचमानोऽतिमात्रं स दह्यमानश्च मन्युना\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2147064, "chapter_id": 4175, "verse_number": "३", "content_sanskrit": "गालवो दुःखितो दुःखाद् विललाप सुयोधन\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2147065, "chapter_id": 4175, "verse_number": "", "content_sanskrit": "गालवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2147066, "chapter_id": 4175, "verse_number": "४", "content_sanskrit": "कुतः पुष्णानि मित्राणि कुतोऽर्थाः सञ्चयः कुतः ।\nहयानां चन्द्रशुभ्राणां शतान्यष्टौ कुतो मम\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2147067, "chapter_id": 4175, "verse_number": "५", "content_sanskrit": "कुतो मे भोजने श्रद्धा सुखश्रद्धा कुतश्च मे ।\nश्रद्धा मे जीवितस्यापि किं फलं जीवितेन मे\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2147068, "chapter_id": 4175, "verse_number": "६", "content_sanskrit": "अहं पारं समुद्रस्य पृथिव्या वा परात् परम् ।\nगत्वाऽऽत्मानं विमुञ्चामि किं फलं जीवितस्य मे\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2147069, "chapter_id": 4175, "verse_number": "७", "content_sanskrit": "अधनस्याकृतार्थस्य त्यक्तस्य विविधैः फलैः ।\nऋणं धारयमाणस्य कुतः सुखमनीहया\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2147070, "chapter_id": 4175, "verse_number": "८", "content_sanskrit": "सुहृदां हि धनं भुक्त्वा कृत्वा प्रणयमीप्सितम् ।\nप्रतिकर्तुमशक्तस्य जीवितान्मरणं वरम्\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2147071, "chapter_id": 4175, "verse_number": "९", "content_sanskrit": "प्रतिश्रुत्य करिष्येऽति कर्तव्यं तदकुर्वतः ।\nमिथ्यावचनदग्धस्य इष्टापूर्तं प्रणश्यति\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2147072, "chapter_id": 4175, "verse_number": "१०", "content_sanskrit": "न रूपमनृतस्यास्ति नानृतस्यास्ति सन्ततिः ।\nनानृतस्याधिपत्यं च कुत एव गतिः शुभा\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2147073, "chapter_id": 4175, "verse_number": "११", "content_sanskrit": "कुतः कृतघ्नस्य यशः कुतः स्थानं कुतः सुखम् ।\nअश्रद्धेयः कृतघ्नो हि कृतघ्ने नास्ति निष्कृतिः\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2147074, "chapter_id": 4175, "verse_number": "१२", "content_sanskrit": "न जीवत्यधनः पापः कुतः पापस्य सा घृणा ।\nपापो ध्रुवमवाप्नोति विनाशं नाशयन् कृतम्\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2147075, "chapter_id": 4175, "verse_number": "१३", "content_sanskrit": "सोऽहं पापः कृतघ्नश्च कृपणश्चानृतोऽपि च ।\nगुरोर्यः कृतकार्यः सन् तत् करोमि न भाषितम्\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2147076, "chapter_id": 4175, "verse_number": "१४", "content_sanskrit": "सोऽहं प्राणान् विमोक्ष्यामि कृत्वा यत्नमनुत्तमम् ।\nअर्थिता न मया काचित् कृतपूर्वा दिवौकसाम्\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2147077, "chapter_id": 4175, "verse_number": "१५", "content_sanskrit": "मानयन्ति च मां सर्वे त्रिदशा यज्ञसंस्तरे\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2147078, "chapter_id": 4175, "verse_number": "१६", "content_sanskrit": "अहं तु विबुधश्रेष्ठं देवं त्रिभुवनेश्वरम् ।\nविष्णुं गच्छाम्यहं कृष्णं गतिं गतिमतां वरम्\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2147079, "chapter_id": 4175, "verse_number": "१७", "content_sanskrit": "भोगा यस्मात् प्रवर्तन्ते प्राप्य सर्वान् सुरासुरान् ।\nप्रयतो द्रष्टुमिच्छामि कृष्णं योगिनमव्ययम्\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2147080, "chapter_id": 4175, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2147081, "chapter_id": 4175, "verse_number": "१८", "content_sanskrit": "एवमुक्ते सखा तस्य गरुडो विनतासुतः ।\nदर्शयामास तं प्राह संहृष्टः प्रियकाम्यया\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2147082, "chapter_id": 4175, "verse_number": "", "content_sanskrit": "गरुडः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2147083, "chapter_id": 4175, "verse_number": "१९", "content_sanskrit": "सुहृद्भवान् मम मतः सुहृदां च मतः सुहृत् ।\nईप्सितेनाभिलाषेण योक्तव्यो विभवे सति\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2147084, "chapter_id": 4175, "verse_number": "२०", "content_sanskrit": "विभवश्चास्ति मे विप्र वासवावरजो द्विज ।\nपूर्वमुक्तस्त्वदर्थं च कृतः कामश्च तेन मे\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2147085, "chapter_id": 4175, "verse_number": "२१", "content_sanskrit": "स भवानेतु गच्छाव नयिष्ये त्वां यथेप्सितम् ।\nदेशं पारं पृथिव्या वा गच्छ गालव माचिरम्\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2147086, "chapter_id": 4175, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि षडधिकशततमोऽध्यायः ॥१०६॥ भगवद्यानपर्वणि सप्तत्रिंशोऽध्यायः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]