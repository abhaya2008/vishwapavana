[{"id": 50013158, "chapter_id": 11506, "verse_number": "1", "content_sanskrit": "नारद उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50013159, "chapter_id": 11506, "verse_number": "2", "content_sanskrit": "अथ दैत्यसुताः सर्वे श्रुत्वा तदनुवर्णितम्। जगृहुर्निरवद्यत्वान्नैव गुर्वनुशिक्षितम्॥ ७/८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50013160, "chapter_id": 11506, "verse_number": "3", "content_sanskrit": "अथाचार्यसुतस्तेषां बुद्धिमेकान्तसंस्थिताम्। आलक्ष्य भीतस्त्वरितो राज्ञ आवेदयद् यथा॥ ७/८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50013161, "chapter_id": 11506, "verse_number": "4", "content_sanskrit": "श्रुत्वा तदप्रियं दैत्यो दुस्सहं तनयानयम्। कोपावेशचलद्गात्रः पुत्रं हन्तुं मनो दधे॥ ७/८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50013162, "chapter_id": 11506, "verse_number": "5", "content_sanskrit": "क्षिप्त्वा परुषया वाचा प्रह्लादमतदर्हणम्। आहेक्षमाणः पापेन तिरश्चीनेन चक्षुषा॥ ७/८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50013163, "chapter_id": 11506, "verse_number": "6", "content_sanskrit": "प्रश्रयावनतं दान्तं बद्धाञ्जलिमवस्थितम्। सर्पः पदाऽऽहत इव श्वसन् प्रकृतिदारुणः॥ ७/८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50013164, "chapter_id": 11506, "verse_number": "7", "content_sanskrit": "हे दुर्विनीत मन्दात्मन् कुलभेदकराधम। स्तब्धं मच्छासनोद्वृत्तं नेष्ये त्वाऽद्य यमक्षयम्॥ ७/८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50013165, "chapter_id": 11506, "verse_number": "8", "content_sanskrit": "क्रुद्धस्य यस्य कम्पन्ते त्रयो लोकाः सहेश्वराः। तस्य मेऽभिहितं मूढ शासनं किम्बलोऽत्यगाः॥ ७/८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50013166, "chapter_id": 11506, "verse_number": "9", "content_sanskrit": "प्रह्लाद उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50013167, "chapter_id": 11506, "verse_number": "10", "content_sanskrit": "न केवलं मे भवतश्च राजन् स वै बलं बलिनां चापरेषाम्। परावरेऽमी स्थिरजङ्गमा ये ब्रह्मादयो येन वशं प्रणीताः॥ ७/८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50013168, "chapter_id": 11506, "verse_number": "11", "content_sanskrit": "स ईश्वरः काल उरुक्रमोऽसावोजस्सहस्सत्त्वबलेन्द्रियात्मा। स एव विश्वं परमः स्वशक्तिभिः सृजत्यवत्यत्ति गुणत्रयेशः॥ ७/८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50013169, "chapter_id": 11506, "verse_number": "12", "content_sanskrit": "जह्यासुरं भावमिमं स्वभावतः समं मनो धत्स्व न सन्ति विद्विषः। ऋतेऽजितादात्मन उत्पथस्थितात् तद् विद्ध्यनन्तस्य महत् समर्हणम्॥ ७/८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50013170, "chapter_id": 11506, "verse_number": "13", "content_sanskrit": "दस्यून् पुरं षण्णविजित्य लुम्पतो मन्यन्त एके स्वजिता दिशो दश। जितात्मनो ज्ञस्य समस्य देहिनां साधोः स्वमोहप्रभवाः कुतः परे॥ ७/८/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50013171, "chapter_id": 11506, "verse_number": "14", "content_sanskrit": "हिरण्यकशिपुरुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50013172, "chapter_id": 11506, "verse_number": "15", "content_sanskrit": "व्यक्तं त्वं मर्तुकामोऽसि योऽतिमात्रं विकत्थसे। मुमूर्षूणां हि मन्दात्मन् ननु स्युर्विप्लुता गिरः॥ ७/८/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50013173, "chapter_id": 11506, "verse_number": "16", "content_sanskrit": "यस्त्वया मन्दभाग्योक्तो मदन्यो जगदीश्वरः। क्वासौ यदि स सर्वत्र स्तम्भे कस्मात् न दृश्यते॥ ७/८/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50013174, "chapter_id": 11506, "verse_number": "17", "content_sanskrit": "सोऽहं विकत्थमानस्य शिरः कायाद्धरामि ते। गोपायेत हरिस्त्वाऽद्य यस्ते शरणमीप्सितः॥ ७/८/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50013175, "chapter_id": 11506, "verse_number": "18", "content_sanskrit": "नारद उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50013176, "chapter_id": 11506, "verse_number": "19", "content_sanskrit": "एवं दुरुक्तैर्मुहुरर्दयन् रुषा सुतं महाभागवतं महासुरः। खळ्गं प्रगृह्योत्पतितो वरासनात् स्तम्भं बभञ्जातिबलः स्वमुष्टिना॥ ७/८/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50013177, "chapter_id": 11506, "verse_number": "20", "content_sanskrit": "तदैव तस्मिन् निनदो विभीषणो बभूव येनाण्डकटाहमस्फुटत्। यं वै स्वधिष्ण्योपगतं ह्यजादयः श्रुत्वा स्वधामाप्ययमङ्ग मेनिरे॥ ७/८/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50013178, "chapter_id": 11506, "verse_number": "21", "content_sanskrit": "अभिक्रमन् पुत्रवधेप्सुरोजसा निशम्य निर्ह्रादमपूर्वमद्भुतम्। अन्तः सभायां न ददर्श तत्पदं वितत्रसुर्येन सुरारियूथपाः॥ ७/८/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50013179, "chapter_id": 11506, "verse_number": "22", "content_sanskrit": "सत्यं विधातुं निजभृत्यभाषितं व्याप्तिं च भूतेष्वखिलेषु चात्मनः। अदृश्यतात्यद्भुतरूपमुद्वहन् स्तम्भे सभायां न मृगं न मानुषम्॥ ७/८/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50013180, "chapter_id": 11506, "verse_number": "23", "content_sanskrit": "स सत्वमेवं परितो विपश्यन् स्तम्भस्य मध्यादनु निर्जिहानम्। नायं मृगो नाप्यमृगो विचित्रमहो किमेतन्नृमृगेन्द्ररूपम्॥ ७/८/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50013181, "chapter_id": 11506, "verse_number": "24", "content_sanskrit": "मीमांसमानस्य समुत्थितोऽग्रतो नृसिंहरूपं तदलं भयानकम्। प्रतप्तचामीकरचण्डलोचनं स्फुरत्सटाकेसरजृम्भिताननम्॥ ७/८/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50013182, "chapter_id": 11506, "verse_number": "25", "content_sanskrit": "कराळदंष्ट्रं करवाळचञ्चलं क्षुरान्तजिह्वं भ्रुकुटीमुखोद्बणम्। स्तब्धोर्ध्वकर्णं गिरिकन्दराद्भुतव्यात्तास्यनासं हनुभेदभीषणम्॥ ७/८/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50013183, "chapter_id": 11506, "verse_number": "26", "content_sanskrit": "दिविस्पृशत्कायमदीर्घपीवरग्रीवोरुवक्षस्स्थलमल्पमध्यमम्। चन्द्रांशुगौरैश्छुरितं तनूरुहैर्विश्वग्भुजानीकशतैर्नखायुधम्॥ ७/८/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50013184, "chapter_id": 11506, "verse_number": "27", "content_sanskrit": "दुरासदं सर्वनिजेतरायुधप्रवेकविद्रावितदैत्यदानवम्। प्रायेण मेऽयं हरिणौरसारिणा वधः स्मृतोऽनेन समुद्यतस्य किम्॥ ७/८/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50013185, "chapter_id": 11506, "verse_number": "28", "content_sanskrit": "एवं विमृश्याभ्यपतद् गदायुधो नदन् नृसिंहं प्रति दैत्यकुञ्जरः। अलक्षितोऽग्नौ पतितः पतङ्गमो यथा नृसिंहौजसि सोऽसुरस्तथा॥ ७/८/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50013186, "chapter_id": 11506, "verse_number": "29", "content_sanskrit": "न तद् विचित्रं खलु सत्वधामनि स्वतेजसाऽंशेन पुराऽपिबत् तमः। ततोऽभिपद्याभ्यहनन्महासुरो रुषा नृसिंहं गदयोरुवेगया॥ ७/८/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50013187, "chapter_id": 11506, "verse_number": "30", "content_sanskrit": "तं विक्रमन्तं सगदं गदाधरो महोरगं ताक्र्ष्यसुतो यथाऽग्रहीत्। स तस्य हस्तोत्कलितस्तदाऽसुरो विक्रीडितो यद्वदहिर्गरुत्मतः॥ ७/८/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50013188, "chapter_id": 11506, "verse_number": "31", "content_sanskrit": "असाध्वमन्यन्त हतौजसोऽमरा घनच्छदा भारत सर्वधिष्ण्यपाः। तं मन्यमानो निजवीर्यशङ्कितं यद्धस्तमुक्तो नृहरेर्महासुरः॥ ७/८/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50013189, "chapter_id": 11506, "verse_number": "32", "content_sanskrit": "पुनस्तमासज्जत खळ्गचर्मणी प्रगृह्य वेगेन जितश्रमो मृधे। तं श्येनवेगं शतचन्द्रचर्मभिश्चरन्तमच्छिद्रमुपर्यधो हरिः॥ ७/८/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50013190, "chapter_id": 11506, "verse_number": "33", "content_sanskrit": "कृत्वाऽट्टहासं खरकेसरोद्बणो निमीलिताक्षं जगृहे महाजवः। विष्वक् स्फुरन्तं ग्रहणातुरं हरिर्व्याळो यथाऽऽखुं कुलिशाक्षतत्वचम्॥ ७/८/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50013191, "chapter_id": 11506, "verse_number": "34", "content_sanskrit": "द्वार्यूरवापात्य ददार लीलया नखैर्यथाऽहिं गरुडो महाविषम्। संरम्भदुष्प्रेक्ष्यकराळलोचनो व्यात्ताननान्तं विलिहन् स्वजिह्वया॥ ७/८/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50013192, "chapter_id": 11506, "verse_number": "35", "content_sanskrit": "असृग्वसाक्तारुणकेसराननो यथाऽन्त्रमाली द्विपहत्यया हरिः। नखाङ्कुरोत्पाटितहृत्सरोरुहं विसृज्य तस्यानुचरानुदायुधान्॥ ७/८/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50013193, "chapter_id": 11506, "verse_number": "36", "content_sanskrit": "अहन् समन्तान्नखशस्त्रपाणिभिर्दोर्दण्डयूथानुपथान् सहस्रशः। सटावधूता जलदाः परापतन् ग्रहाश्च तद्दृष्टिविमुष्टरोचिषः॥ ७/८/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50013194, "chapter_id": 11506, "verse_number": "37", "content_sanskrit": "अम्भोधयः श्वासहता विचुक्षुभुर्निर्ह्रादभीता दिगिभा जहुर्दिशः। द्यौस्तत्सटाक्षिप्तविमानसङ्कुला प्रोत्सर्पत क्ष्मा च पदाऽतिपीडिता॥ ७/८/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50013195, "chapter_id": 11506, "verse_number": "38", "content_sanskrit": "शैलाः समुत्पेतुरमुष्य रंहसा तत्तेजसा खं ककुभो न रेजिरे। ततः सभायामुपविष्टमुत्तमे नृपासने सम्भृततेजसं विभुम्॥ ७/८/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50013196, "chapter_id": 11506, "verse_number": "39", "content_sanskrit": "अलक्षितद्वैरथमत्यमर्षणं प्रचण्डवक्त्रं न बभाज कश्चन॥ ७/८/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50013197, "chapter_id": 11506, "verse_number": "40", "content_sanskrit": "निशाम्य लोकत्रयमस्तकज्वरं तमादिदैत्यं हरिणा हतं मृधे। प्रहर्षवेगोत्कलितानना मुहुः प्रसूनवर्षैर्ववृषुः सुरस्त्रियः॥ ७/८/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50013198, "chapter_id": 11506, "verse_number": "41", "content_sanskrit": "तदा विमानावलिभिर्नभस्तळं दिदृक्षतां सङ्कुलमास नाकिनाम्। सुरानका दुन्दुभयश्च जघ्निरे गन्धर्वमुख्या ननृतुर्जगुः स्त्रियः॥ ७/८/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50013199, "chapter_id": 11506, "verse_number": "42", "content_sanskrit": "त उपव्रज्य विबुधा ब्रह्मेन्द्रगिरिशादयः। ऋषयः पितरः सिद्धा विद्याधरमहोरगाः॥ ७/८/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50013200, "chapter_id": 11506, "verse_number": "43", "content_sanskrit": "मनवः प्रजानां पतयो गन्धर्वाप्सरचारणाः। यक्षाः किम्पुरुषास्तात वैताळाः सहकिन्नराः॥ ७/८/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50013201, "chapter_id": 11506, "verse_number": "44", "content_sanskrit": "ते विष्णुपार्षदाः सर्वे सुनन्दकुमुदादयः। मूर्ध्नि बद्धाञ्जलिपुटा आसीनं तीव्रतेजसम्। ईडिरे नरशार्दूलं नातिदूरचराः पृथक्॥ ७/८/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 50013202, "chapter_id": 11506, "verse_number": "45", "content_sanskrit": "ब्रह्मोवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 50013203, "chapter_id": 11506, "verse_number": "46", "content_sanskrit": "नतोऽस्म्यनन्ताय दुरन्तशक्तये विचित्रवीर्याय पवित्रकर्मणे। विश्वस्य सर्गस्थितिसंयमान् गुणैः स्वलीलया सन्दधतेऽव्ययात्मने॥ ७/८/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 50013204, "chapter_id": 11506, "verse_number": "47", "content_sanskrit": "रुद्र उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 50013205, "chapter_id": 11506, "verse_number": "48", "content_sanskrit": "कोपकालो युगान्तस्ते हतोऽयमसुरोऽल्पकः। तत्सुतं पाह्यनुसृतं भक्तं ते भक्तवत्सल॥ ७/८/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 50013206, "chapter_id": 11506, "verse_number": "49", "content_sanskrit": "इन्द्र उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 50013207, "chapter_id": 11506, "verse_number": "50", "content_sanskrit": "प्रत्यानीताः परम भवता त्रायता नः स्वभागा। दैत्याक्रान्तं हृदयकमलं त्वद्गृहं प्रत्यबोधि॥ ७/८/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 50013208, "chapter_id": 11506, "verse_number": "51", "content_sanskrit": "कालग्रस्तं कियदिदमहो नाथ शुश्रूषतां ते। मुक्तिस्तेषां न हि बहुमता नारसिंहापरैः किम्॥ ७/८/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 50013209, "chapter_id": 11506, "verse_number": "52", "content_sanskrit": "ऋषय ऊचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 50013210, "chapter_id": 11506, "verse_number": "53", "content_sanskrit": "त्वं नस्तपः परममात्थ यदात्मतेजो येनेदमादिपुरुषात्मगतं समस्तम्। तद् विप्रलुप्तममुनाऽद्य शरण्यपाल रक्षागृहीतवपुषा पुनरन्वमंस्थाः॥ ७/८/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 50013211, "chapter_id": 11506, "verse_number": "54", "content_sanskrit": "पितर ऊचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 50013212, "chapter_id": 11506, "verse_number": "55", "content_sanskrit": "श्राद्धानि नोऽधिबुभुजे प्रसभं तनूजैर्दत्तानि तीर्थसमयेऽपि तिलाम्बुमान्त। तस्योदरान्नखविदीर्णवपाद् य आर्च्छत् तस्मै नमो नृहरयेऽखिलकर्मगोप्त्रे॥ ७/८/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 50013213, "chapter_id": 11506, "verse_number": "56", "content_sanskrit": "सिद्धा ऊचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 50013214, "chapter_id": 11506, "verse_number": "57", "content_sanskrit": "यो नो गतिं योगसिद्धामसाधुरहार्षीद् योगतपोबलेन। नानादर्पं तं नखैर्निर्ददार तस्मै तुभ्यं प्रणमामो नृसिंह॥ ७/८/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 50013215, "chapter_id": 11506, "verse_number": "58", "content_sanskrit": "विद्याधरा ऊचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 50013216, "chapter_id": 11506, "verse_number": "59", "content_sanskrit": "विद्यां पृथग्धारणयाऽनुरुद्धां न्यषेधदज्ञो बलदृप्तवीर्यः। स येन सङ्खे पशुवद्धतस्तं महानृसिंहं प्रणताः स्म नित्यम्॥ ७/८/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 50013217, "chapter_id": 11506, "verse_number": "60", "content_sanskrit": "नागा ऊचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 50013218, "chapter_id": 11506, "verse_number": "61", "content_sanskrit": "येन पापेन रत्नानि स्त्रीरत्नानि हृतानि नः। तद्वक्षःपाटनेनासां दत्तानन्द नमोऽस्तु ते॥ ७/८/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 50013219, "chapter_id": 11506, "verse_number": "62", "content_sanskrit": "मनव ऊचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 50013220, "chapter_id": 11506, "verse_number": "63", "content_sanskrit": "मनवो वयं तव निदेशकारिणो दितिजेन देव परिभूतसेतवः। भवता खलः समुपसंहृतः प्रभो करवाम ते किमनुशाधि किङ्करान्॥ ७/८/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 50013221, "chapter_id": 11506, "verse_number": "64", "content_sanskrit": "प्रजापतय ऊचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 50013222, "chapter_id": 11506, "verse_number": "65", "content_sanskrit": "प्रजेशा वयं ते परेशाभिसृष्टा न येन प्रजा वै सृजामो निषिद्धाः। स एष त्वया भिन्नवक्षा नु शेते जगन्मङ्गळं सत्वमूर्तेऽवतारः॥ ७/८/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 50013223, "chapter_id": 11506, "verse_number": "66", "content_sanskrit": "गन्धर्वा ऊचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 50013224, "chapter_id": 11506, "verse_number": "67", "content_sanskrit": "वयं विभो ते नटनाट्यगायका येनात्मसाद् वीर्यबलौजसा कृताः। स एष नीतो भवता दशामिमां किमुत्पथस्थः कुशलाय कल्पते॥ ७/८/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 50013225, "chapter_id": 11506, "verse_number": "68", "content_sanskrit": "चारणा ऊचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 50013226, "chapter_id": 11506, "verse_number": "69", "content_sanskrit": "हरे तवाङ्घ्रिपङ्कजं भवापवर्गमाश्रिताः। य एष साधुहृच्छ्रयस्त्वयाऽसुरः समापितः॥ ७/८/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 50013227, "chapter_id": 11506, "verse_number": "70", "content_sanskrit": "यक्षा ऊचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 50013228, "chapter_id": 11506, "verse_number": "71", "content_sanskrit": "वयमनुचरमुख्याः कर्मभिस्ते मनोज्ञैरिह च दितिसुतेन प्रापिता वाहकत्वम्। स तु जनपरितापं तत्कृतं जानता ते नरहर उपनीतः पञ्चतां पञ्चविंश॥ ७/८/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 50013229, "chapter_id": 11506, "verse_number": "72", "content_sanskrit": "किम्पुरुषा ऊचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 50013230, "chapter_id": 11506, "verse_number": "73", "content_sanskrit": "वयं किम्पुरुषास्त्वं तु महापुरुष ईश्वरः। अयं कापुरुषो नष्टो धिक्कृतः साधुभिर्यतः॥ ७/८/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 50013231, "chapter_id": 11506, "verse_number": "74", "content_sanskrit": "वेताळा ऊचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 50013232, "chapter_id": 11506, "verse_number": "75", "content_sanskrit": "सभासु सत्रेषु तवामलं यशो गीत्वा सपर्यां महतीं लभामहे। यस्तान् व्यनैषीद् भृशमेष दुर्जनो दिष्ट्या हतस्ते भगवन् यथाऽऽमयः॥ ७/८/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 50013233, "chapter_id": 11506, "verse_number": "76", "content_sanskrit": "किन्नरा ऊचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 50013234, "chapter_id": 11506, "verse_number": "77", "content_sanskrit": "वयमीश किन्नरगणास्तवानुगा दितिजेन विष्टिममुनाऽद्य कारिताः। भवता हरे स व्रजिनोऽपसादितो नरसिंह नाथ विभवाय नो भव॥ ७/८/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 50013235, "chapter_id": 11506, "verse_number": "78", "content_sanskrit": "विष्णुपार्षदा ऊचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 50013236, "chapter_id": 11506, "verse_number": "79", "content_sanskrit": "अद्यैतद्धरिनररूपमद्भुतं ते दृष्टं नः शरणद सर्वलोकशर्म। सोऽयं ते विधिकर ईश विप्रशापात् तस्येदं निधनमनुग्रहाय विद्मः॥ ७/८/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 50013237, "chapter_id": 11506, "verse_number": "80", "content_sanskrit": "इति श्रीमद्भागवते सप्तमस्कन्धेऽष्टमोऽध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}]