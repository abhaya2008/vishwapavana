[{"id": 2058767, "chapter_id": 2267, "verse_number": "७-१९४-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2058768, "chapter_id": 2267, "verse_number": "७-१९४-१", "content_sanskrit": "ततो द्रोणे हते राजन्कुरवः शस्त्रपीडिताः।\nहतप्रवीरा विध्वस्ता भृशं शोकपरायणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2058769, "chapter_id": 2267, "verse_number": "७-१९४-२", "content_sanskrit": "उदीर्णांश्च परान्दृष्ट्वा हर्षमाणान्पुनः पुनः।\nअश्रुपूर्णेक्षणास्त्रस्ता दीनास्त्वासन्विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2058770, "chapter_id": 2267, "verse_number": "७-१९४-३", "content_sanskrit": "विचेतसो हतोत्साहाः कश्मलाभिहतौजसः।\nआर्तस्वरेण महता पुत्रं ते पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2058771, "chapter_id": 2267, "verse_number": "७-१९४-४", "content_sanskrit": "वेषण्णवदना दीना वीक्षमाणा दिशो दश।\nअश्रुकण्ठा यथा दैत्या हिरण्याक्षे पुरा हते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2058772, "chapter_id": 2267, "verse_number": "७-१९४-५", "content_sanskrit": "स तैः परिवृतो राजा त्रस्तैः क्षुद्रमृगैरिव।\nअशक्नुवन्नवस्थातुमपायात्तनयस्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2058773, "chapter_id": 2267, "verse_number": "७-१९४-६", "content_sanskrit": "क्षुत्पिपासापरिम्लानास्ते योधास्तव भारत।\nआदित्येनेव सन्तप्ता भृशं विमनसोऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2058774, "chapter_id": 2267, "verse_number": "७-१९४-७", "content_sanskrit": "भास्करस्येव पतनं समुद्रस्येव शोषणम्।\nविपर्यासं यथा मेरोर्वासवस्येव निर्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2058775, "chapter_id": 2267, "verse_number": "७-१९४-८", "content_sanskrit": "अप्रेक्षणीयं तद्दृष्ट्वा भारद्वाजस्य पातनम्।\nत्रस्तरूपतरा राजन्कौरवाः प्राद्रवन्भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2058776, "chapter_id": 2267, "verse_number": "७-१९४-९", "content_sanskrit": "गान्धारराजः शकुनिस्त्रस्तस्त्रस्ततरैः सह।\nहतं रुक्मरथं श्रुत्वा प्राद्रवत्सहितो रथैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2058777, "chapter_id": 2267, "verse_number": "७-१९४-१०", "content_sanskrit": "वरूथिनीं वेगवतीं विद्रुतां सपताकिनीम्।\nपरिगृह्य महासेनां सूतपुत्रोऽपयाद्भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2058778, "chapter_id": 2267, "verse_number": "७-१९४-११", "content_sanskrit": "रथनागाश्वकलिलां पुरस्कृत्य तु वाहिनीम्।\nमद्राणामीश्वरः शल्यो वीक्षमाणोऽपयाद्भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2058779, "chapter_id": 2267, "verse_number": "७-१९४-१२", "content_sanskrit": "हतप्रवीरैर्भूयिष्ठैर्ध्वजैर्बहुपताकिभिः।\nवृतः शारद्वतोऽगच्छत्कष्टङ्कष्टमिति ब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2058780, "chapter_id": 2267, "verse_number": "७-१९४-१३", "content_sanskrit": "भोजनीकेन शिष्टेन कलिङ्गारट्टबाह्लिकैः।\nकृतवर्मा वृतो राजन्प्रायात्सुजवनैर्हयैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2058781, "chapter_id": 2267, "verse_number": "७-१९४-१४", "content_sanskrit": "पदातिगणसंयुक्तस्त्रस्तो राजन्भयार्दितः।\nउलूकः प्राद्रवत्तत्र दृष्ट्वा द्रोणं निपातितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2058782, "chapter_id": 2267, "verse_number": "७-१९४-१५", "content_sanskrit": "दर्शनीयो युवा चैव शौर्येण कृतलक्षणः।\nदुःशासनो भृशोद्विग्नः प्राद्रवद्गजसंवृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2058783, "chapter_id": 2267, "verse_number": "७-१९४-१६", "content_sanskrit": "रथानामयुतं गृह्य त्रिसाहस्रं च दन्तिनाम्।\nवृषसेनो ययौ तूर्णं दृष्ट्वा द्रोणं निपातितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2058784, "chapter_id": 2267, "verse_number": "७-१९४-१७", "content_sanskrit": "गजाश्वरथसंयुक्तो वृतश्चैव पदातिभिः।\nदुर्योधनो महाराज प्रायात्तत्र महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2058785, "chapter_id": 2267, "verse_number": "७-१९४-१८", "content_sanskrit": "संशप्तकगणाद्गृह्य हतशेषान्किरीटिना।\nसुशर्मा प्राद्रावद्राजन्दृष्ट्वा द्रोणं निपातितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2058786, "chapter_id": 2267, "verse_number": "७-१९४-१९", "content_sanskrit": "गजान्रथान्समारुह्य व्युदस्य च हयाञ्जनाः।\nप्राद्रवन्सर्वतः सङ्ख्ये दृष्ट्वा रुक्मरथं हतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2058787, "chapter_id": 2267, "verse_number": "७-१९४-२०", "content_sanskrit": "त्वरयन्तः पितॄनन्ये भ्रातॄनन्येऽथ मातुलान्।\nपुत्रानन्ये वयस्यांश्च प्राद्रवन्कुरवस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2058788, "chapter_id": 2267, "verse_number": "७-१९४-२१", "content_sanskrit": "चोदयन्तश्च सैन्यानि स्वस्त्रीयांश्च तथाऽपरे।\nसम्बन्धिनस्तथाऽन्ये च प्राद्रवन्त दिशो दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2058789, "chapter_id": 2267, "verse_number": "७-१९४-२२", "content_sanskrit": "प्रकीर्णकेशा विध्वस्ता न द्वावेकत्र धावतः।\nनेदमस्तीति मन्वाना हतोत्साहा हतौजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2058790, "chapter_id": 2267, "verse_number": "७-१९४-२३", "content_sanskrit": "उत्सृज्य कवचानन्ये प्राद्रवंस्तावका विभो।\nअन्योन्यं ते समाक्रोशन्यैनिका भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2058791, "chapter_id": 2267, "verse_number": "७-१९४-२४", "content_sanskrit": "तिष्ठतिष्ठेति न च ते स्वयं तत्रावतस्थिरे।\nधुर्यानुन्मुच्य च रथाद्धतसूतात्स्वलङ्कृतान्।\nअधिरुह्य हयान्योधाः क्षिप्रं पद्भिरचोदयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2058792, "chapter_id": 2267, "verse_number": "७-१९४-२५", "content_sanskrit": "द्रमाणे तथा सैन्ये त्रस्तरूपे हतौजसि।\nप्रतिस्रोत इव ग्राहो द्रोणपुत्रः परानियात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2058793, "chapter_id": 2267, "verse_number": "७-१९४-२६", "content_sanskrit": "तस्यासीत्सुमहद्युद्धं शिखण्डिप्रमुखैर्गणैः।\nप्रभद्रकैश्च पाञ्चालैश्चेदिभिश्च सकेकयैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2058794, "chapter_id": 2267, "verse_number": "७-१९४-२७", "content_sanskrit": "हत्वा बहुविधाः सेनाः पाण्डूनां युद्धदुर्मदः।\nकथञ्चित्सङ्कटान्मुक्तो मत्तद्विरदविक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2058795, "chapter_id": 2267, "verse_number": "७-१९४-२८", "content_sanskrit": "द्रवमाणं बलं दृष्ट्वा पलायनकृतक्षणम्।\nदुर्योधनं समासाद्य द्रोणपुत्रोऽब्रवीदिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2058796, "chapter_id": 2267, "verse_number": "७-१९४-२९", "content_sanskrit": "किमियं द्रवते सेना त्रस्तरूपेव भारत।\nद्रवमाणां च राजेन्द्र नावस्थापयसे रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2058797, "chapter_id": 2267, "verse_number": "७-१९४-३०", "content_sanskrit": "त्वं चापि न यथा पूर्वं प्रकृतिस्थो नराधिप।\nकर्णप्रभृतयश्चेमे नावतिष्ठन्ति पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2058798, "chapter_id": 2267, "verse_number": "७-१९४-३१", "content_sanskrit": "अन्येष्वपि च युद्धेषु नैव सेनाऽद्रवत्तदा।\nकच्चित्क्षेमं महाबाहो तव सैन्यस्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2058799, "chapter_id": 2267, "verse_number": "७-१९४-३२", "content_sanskrit": "कस्पिन्निदं हते राजन्रथसिंहे बलं तव।\nएतामवस्थां संप्राप्तं तन्ममाचक्ष्व कौरव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2058800, "chapter_id": 2267, "verse_number": "७-१९४-३३", "content_sanskrit": "तत्तु दुर्योधनः श्रुत्वा द्रोणपुत्रस्य भाषितम्।\nघोरमप्रियमाख्यातुं नाशक्नोत्पार्थिवर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2058801, "chapter_id": 2267, "verse_number": "७-१९४-३४", "content_sanskrit": "भिन्ना नौरिव ते पुत्रो मग्नः शोकमहार्णवे।\nबाष्पेणापिहितो दृष्ट्वा द्रोणपुत्रं रथे स्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2058802, "chapter_id": 2267, "verse_number": "७-१९४-३५", "content_sanskrit": "ततः शारद्वतं राजा सव्रीडमिदमब्रवीत्।\nशंसात्र भद्रं ते सर्वं यथा सैन्यमिदं द्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2058803, "chapter_id": 2267, "verse_number": "७-१९४-३६", "content_sanskrit": "अथ शारद्वतो राजन्नार्तिमार्च्छन्पुनःपुनः।\nशशंस द्रोणपुत्राय यथा द्रोणो निपातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2058804, "chapter_id": 2267, "verse_number": "७-१९४-३७x", "content_sanskrit": "कृप उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2058805, "chapter_id": 2267, "verse_number": "७-१९४-३७", "content_sanskrit": "वयं द्रोणं पुरस्कृत्य पृथिव्यां प्रवरं रथम्।\nप्रावर्तयाम सङ्ग्रामं पाञ्चालैरेव केवलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2058806, "chapter_id": 2267, "verse_number": "७-१९४-३८", "content_sanskrit": "ततः प्रवृत्ते सङ्ग्रमे विमिश्राः कुरुसोमकाः।\nअन्योन्यमभिगर्जन्तः शस्त्रैर्देहानपातयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2058807, "chapter_id": 2267, "verse_number": "७-१९४-३९", "content_sanskrit": "वर्तमाने तथा युद्धे क्षीयमाणेषु संयुगे।\nधार्तराष्ट्रेषु सङ्क्रुद्धः पिता तेऽस्त्रमुदैरयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2058808, "chapter_id": 2267, "verse_number": "७-१९४-४०", "content_sanskrit": "ततो द्रोणो ब्राह्ममस्त्रं विकुर्वाणो नरर्षभः।\nव्यहनच्छात्रवान्भल्लैः शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2058809, "chapter_id": 2267, "verse_number": "७-१९४-४१", "content_sanskrit": "पाण्डवाः केकया मात्स्याः पाञ्चालाश्च विशेषतः।\nसङ्ख्ये द्रोणरथं प्राप्य व्यनशन्कालचोदिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2058810, "chapter_id": 2267, "verse_number": "७-१९४-४२", "content_sanskrit": "सहस्रं नरसिंहानां द्विसाहस्रं च दन्तिनाम्।\nद्रोणो ब्रह्मास्त्रयोगेन प्रेषयामास मृत्यवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2058811, "chapter_id": 2267, "verse_number": "७-१९४-४३", "content_sanskrit": "आकर्णपलितश्यामो वयसाऽशीतिपञ्चकः।\nरणे पर्यचरद्द्रोणो वृद्धः षोडशवर्षवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2058812, "chapter_id": 2267, "verse_number": "७-१९४-४४", "content_sanskrit": "क्लिश्यमानेषु सैन्येषु वध्यमानेषु राजसु।\nअमर्षवशमापन्नाः पाञ्चाला विमुखाऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2058813, "chapter_id": 2267, "verse_number": "७-१९४-४५", "content_sanskrit": "तेषु किञ्चित्प्रभग्नेषु विमुखेषु सपत्नजित्।\nदिव्यमस्त्रं विकुर्वाणो बभूवार्क इवोदितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2058814, "chapter_id": 2267, "verse_number": "७-१९४-४६", "content_sanskrit": "स मध्यं प्राप्य पाण्डूनां शररश्मिः प्रतापवान्।\nमध्यं गत इवादित्यो दुष्प्रेक्ष्यस्ते पिताऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2058815, "chapter_id": 2267, "verse_number": "७-१९४-४७", "content_sanskrit": "ते दह्यमाना द्रोणेन सूर्येणेव विराजता।\nदग्धवीर्या निरुत्साहा बभूवुर्गतचेतसाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2058816, "chapter_id": 2267, "verse_number": "७-१९४-४८", "content_sanskrit": "तान्दृष्ट्वा पीडितान्बाणैर्द्रोणेन मधुसूदनः।\nजयैषी पाण्डुपुत्राणामिदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2058817, "chapter_id": 2267, "verse_number": "७-१९४-४९", "content_sanskrit": "नैष जातु नरैः शक्यो जेतुं शस्त्रभृतां वरः।\nअपि वृत्रहणा सङ्ख्ये रथयूथपयूथपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2058818, "chapter_id": 2267, "verse_number": "७-१९४-५०", "content_sanskrit": "ते यूयं धर्ममुत्सृज्य जयं रक्षत पाण्डवाः।\nयथा वः संयुगे सर्वान्न हन्याद्रुक्मवाहनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2058819, "chapter_id": 2267, "verse_number": "७-१९४-५१", "content_sanskrit": "अश्वत्थाम्नि हते नैष युध्येदिति मतिर्मम।\nहतं तं संयुगे कश्चिदाख्यात्वस्मै मृषा नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2058820, "chapter_id": 2267, "verse_number": "७-१९४-५२", "content_sanskrit": "एतन्नारोचयद्वाक्यं कुन्तीपुत्रो धनञ्जयः।\nअरोचयंस्तु सर्वेऽन्ये कृच्छ्रेण तु युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2058821, "chapter_id": 2267, "verse_number": "७-१९४-५३", "content_sanskrit": "भीमसेनस्तु सव्रीडमब्रवीत्पितरं तव।\nअश्वत्थामा हत इति तं नाबुध्यत ते पिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2058822, "chapter_id": 2267, "verse_number": "७-१९४-५४", "content_sanskrit": "स शङ्कमानस्तन्मिथ्या धर्मराजमपृच्छत।\nहतं वाऽप्यहतं वाऽऽजौ त्वां पिता पुत्रवत्सलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2058823, "chapter_id": 2267, "verse_number": "७-१९४-५५", "content_sanskrit": "तमतथ्यभये मग्नो जये सक्तो युधिष्ठिरः।\nअश्वत्थामानमायोधे हतं दृष्ट्वा महागजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2058824, "chapter_id": 2267, "verse_number": "७-१९४-५६", "content_sanskrit": "भीमेन गिरिवर्ष्माणं मालवस्येन्द्रवर्मणः।\nउपसृत्य तदा द्रोणमुच्चैरिदमुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2058825, "chapter_id": 2267, "verse_number": "७-१९४-५७", "content_sanskrit": "यस्यार्थे शस्त्रमादत्से यमवेक्ष्य च जीवसि।\nपुत्रस्ते दयितो नित्यं सोश्वत्थामा निपातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2058826, "chapter_id": 2267, "verse_number": "७-१९४-५८", "content_sanskrit": "शेते विनिहतो भूमौ वने सिंहशिशुर्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2058827, "chapter_id": 2267, "verse_number": "७-१९४-५९", "content_sanskrit": "जानन्नप्यनृतस्याथ दोषान्स द्विजसत्तमम्।\nअव्यक्तमब्रवीद्राजा हतः कुञ्जर इत्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2058828, "chapter_id": 2267, "verse_number": "७-१९४-६०", "content_sanskrit": "स त्वां निहतमाक्रन्दे श्रुत्वा सन्तापतापितः।\nनियम्य दिव्यान्यस्त्राणि नायुध्यत यथा पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2058829, "chapter_id": 2267, "verse_number": "७-१९४-६१", "content_sanskrit": "तं दृष्ट्वा परमोद्विग्नं शोकातुरमचेतसम्।\nपाञ्चालराजस्य सुतः क्रुरकर्मा समाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2058830, "chapter_id": 2267, "verse_number": "७-१९४-६२", "content_sanskrit": "तं दृष्ट्वा परमोद्विग्नं शोकातुरमचेतसम्।\nदिव्यान्यस्त्राण्यथोत्सृज्य रणे प्रायमुपाविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2058831, "chapter_id": 2267, "verse_number": "७-१९४-६३", "content_sanskrit": "ततोऽस्य केशान्सव्येन गृहीत्वा पाणिना तदा।\nपार्षतः क्रोशमानानां वीराणामच्छिनच्छिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2058832, "chapter_id": 2267, "verse_number": "७-१९४-६४", "content_sanskrit": "न हन्तव्यो न हन्तव्य इति ते सर्वतोऽब्रुवन्।\nतथैव चार्जुनो वाहादवरुह्यैनमाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2058833, "chapter_id": 2267, "verse_number": "७-१९४-६५", "content_sanskrit": "उद्यम्य त्वरितो बाहुं ब्रुवाणश्च पुनःपुनः।\nजीवन्तमानयाचार्यं मावधीरिति धर्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2058834, "chapter_id": 2267, "verse_number": "७-१९४-६६", "content_sanskrit": "तथा निवार्यमाणेन कौरवैरर्जुनेन च।\nहत एव नृशंसेन पिता तव नरर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2058835, "chapter_id": 2267, "verse_number": "७-१९४-६७", "content_sanskrit": "सैनिकाश्च ततः सर्वे प्राद्रवन्त भयार्दिताः।\nवयं चापि निरुत्साहा हते पितरि तेऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2058836, "chapter_id": 2267, "verse_number": "७-१९४-६८x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2058837, "chapter_id": 2267, "verse_number": "७-१९४-६८", "content_sanskrit": "तच्छ्रुत्वा द्रोणपुत्रस्तु निधनं पितुराहवे।\nक्रोधमाहारयत्तीव्रं दण्डाहत इवोरगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2058838, "chapter_id": 2267, "verse_number": "७-१९४-६९", "content_sanskrit": "ततः क्रुद्धो रणे द्रौणिर्भृशं जज्वाल मारिष।\nयथेन्धनं महत्प्राप्य प्राज्वलद्धव्यवाहनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2058839, "chapter_id": 2267, "verse_number": "७-१९४-७०", "content_sanskrit": "तलं तलेन निष्पिष्य दन्तैर्दन्तानुपास्पृशत्।\nनिःश्वसन्नुरगो यद्वल्लोहिताक्षोऽभवत्तदा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2058840, "chapter_id": 2267, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि नारायणास्त्रमोक्षपर्वणि पञ्चदशदिवसयुद्धे चतुर्नवत्यधिकशततमोऽध्यायः॥ १९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}]