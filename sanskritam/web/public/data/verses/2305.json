[{"id": 2061044, "chapter_id": 2305, "verse_number": "८-२६-०x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2061045, "chapter_id": 2305, "verse_number": "८-२६-१", "content_sanskrit": "तेजसोऽर्धं सुरा दत्त्वा शङ्कराय महात्मने।\nपशुत्वमपि चोपेत्य विश्वकर्माणमव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2061046, "chapter_id": 2305, "verse_number": "८-२६-२", "content_sanskrit": "ऊचुः सर्वे समाभाष्य रथः सङ्कल्प्यतामिति।\nविश्वकर्माऽपि सञ्चिन्त्य रथं दिव्यमकल्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2061047, "chapter_id": 2305, "verse_number": "८-२६-३", "content_sanskrit": "समेतां पृथिवीं देवी विशालां पुरमालिनीम्।\nसपर्वतवनद्वीपां चक्रे भूतधरां रथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2061048, "chapter_id": 2305, "verse_number": "८-२६-४", "content_sanskrit": "ईषां नक्षत्रवंशं च छत्रं मेरुमहागिरिम्।\nअनेकद्रुसञ्छन्नं रत्नाकरमनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2061049, "chapter_id": 2305, "verse_number": "८-२६-५", "content_sanskrit": "हिमवन्तं च विन्ध्यं च नानाद्रुमलताकुलम्।\nअवस्करं प्रतिष्ठानं कल्पयामास वै तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2061050, "chapter_id": 2305, "verse_number": "८-२६-६", "content_sanskrit": "अस्तंगिरिमधिष्ठानं नानाद्विजगणायुतम्।\nचकार भगवांस्त्वष्टा उदयं रथकूबरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2061051, "chapter_id": 2305, "verse_number": "८-२६-७", "content_sanskrit": "मीननक्रझषावासं दानवालयमुत्तमम्।\nसमुद्रमक्षं विदधे पत्तनाकरशोभितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2061052, "chapter_id": 2305, "verse_number": "८-२६-८", "content_sanskrit": "चक्रं चक्रे चन्द्रमसं तारकागणमण्डितम्।\nदिवाकरं चाप्यपरं चक्रं चक्रेंऽशुमालिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2061053, "chapter_id": 2305, "verse_number": "८-२६-९", "content_sanskrit": "गङ्गां सरस्वतीं तूणीं चक्रे विश्वकृदव्ययः।\nअलङ्कारा रथस्यासन्नापगाः सरितस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2061054, "chapter_id": 2305, "verse_number": "८-२६-१०", "content_sanskrit": "त्रीनग्नीन्मन्त्रवच्चक्रे रथस्याथ त्रिवेणुकम्।\nअनुकर्षान्रथे दीप्तान्वरूथांश्चापि तारकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2061055, "chapter_id": 2305, "verse_number": "८-२६-११", "content_sanskrit": "ओषधीर्वीरुधश्चैव घण्टाजालं च भानुमत्।\nअलञ्चकार च रथं मासपक्षर्तुभिर्विभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2061056, "chapter_id": 2305, "verse_number": "८-२६-१२", "content_sanskrit": "अहोरात्रैः कलाभिश्च काष्ठाभिरयनैस्तथा।\nद्यां युगं युगपर्वाणि संवर्तकबलाहरकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2061057, "chapter_id": 2305, "verse_number": "८-२६-१३", "content_sanskrit": "शम्यां धृतिं च मेधां च स्थितिं सन्नतिमेव च।\nऋघ्वेदं सामवेदं च धुर्यावश्वावकल्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2061058, "chapter_id": 2305, "verse_number": "८-२६-१४", "content_sanskrit": "पृष्ठाश्वौ तु यजुर्वेदः कल्पितोऽथर्वणस्तथा।\nअश्वानां चाप्यलङ्कारं विदधे पदसञ्चयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2061059, "chapter_id": 2305, "verse_number": "८-२६-१५", "content_sanskrit": "सिनीवालीमनुमतिं कुहूं राकां च सुप्रभाम्।\nयोक्ताणि चक्रे चाश्वानां कूश्माण्डांश्चापि पन्नगान्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2061060, "chapter_id": 2305, "verse_number": "८-२६-१६", "content_sanskrit": "तालपृष्ठोऽथ नहुषः कार्कोटकधनञ्जयौ।\nइतरे चाभवन्नागा हयानां वाहबन्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2061061, "chapter_id": 2305, "verse_number": "८-२६-१७", "content_sanskrit": "अभीशवः षडङ्गानि कल्पितानि महीपते।\nओङ्कारः कल्पितस्तस्य प्रतोदो विश्वकर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2061062, "chapter_id": 2305, "verse_number": "८-२६-१८", "content_sanskrit": "यज्ञाः सर्वे पृथक्लृप्ता रथाङ्गानि च भागशः।\nअधिष्ठानं मनश्चासीत्परिरथ्या सरस्वती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2061063, "chapter_id": 2305, "verse_number": "८-२६-१९", "content_sanskrit": "नानावर्णानि शस्त्राणि पताकाः पवनेरिताः।\nविद्युदिन्द्रधनुर्युक्तं रथं दीप्त्या व्यदीपयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2061064, "chapter_id": 2305, "verse_number": "८-२६-२०", "content_sanskrit": "वर्म योद्धुं च विहितं नमो ग्रहगणाकुलम्।\nअभेद्यं भानुमच्चित्रं कालचक्रपरिक्षतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2061065, "chapter_id": 2305, "verse_number": "८-२६-२१", "content_sanskrit": "एवमस्मिन्महाराज कल्पिते रथसत्तमे।\nत्वष्ट्रा मनुजशार्दूल द्विषतां भयवर्धने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2061066, "chapter_id": 2305, "verse_number": "८-२६-२२", "content_sanskrit": "स्वान्यायुधानि दिव्यानि न्यदधाच्छङ्करो रथे।\nध्वजयष्टिं वियत्कृत्वा स्थापयामास गोवृषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2061067, "chapter_id": 2305, "verse_number": "८-२६-२३", "content_sanskrit": "ब्रह्मदण़्डः कालदम्डो रुद्रदण्डश्च ते ज्वराः।\nपरिष्कारा र्थस्यासन्समन्ताद्दिशमुद्धताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2061068, "chapter_id": 2305, "verse_number": "८-२६-२४", "content_sanskrit": "विचित्रमृतुभिः षड्भिः कृत्वा संवत्सरं धनुः।\nछायामेवात्मनश्चक्रे धनुर्ज्यामक्षयां ध्रुवाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2061069, "chapter_id": 2305, "verse_number": "८-२६-२५", "content_sanskrit": "कालो हि भगवान्रुद्रस्तच्च संवत्सरं धनुः।\nतस्माद्रौद्री कालरात्री ज्या कृता धनुषो जरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2061070, "chapter_id": 2305, "verse_number": "८-२६-२६", "content_sanskrit": "ततो रथे रथाश्वांस्तानृषयः समयोजयन्।\nएकैकशः सुसंहृष्टानादाय सुधृतव्रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2061071, "chapter_id": 2305, "verse_number": "८-२६-२७", "content_sanskrit": "दक्षिणस्यां धुरि कृत ऋग्वेदो मन्त्रपारगैः।\nसव्यतः सामवेदश्च युक्तो राजन्महर्षिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2061072, "chapter_id": 2305, "verse_number": "८-२६-२८", "content_sanskrit": "पार्ष्ठिदक्षिणतो युक्तो यजुर्वेदः सुरद्विजैः।\nइतरस्यां तथा पार्ष्ठ्यां युक्तो राजन्नथर्वणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2061073, "chapter_id": 2305, "verse_number": "८-२६-२९", "content_sanskrit": "एवं ते वाजिनो युक्ता यज्ञविद्भिस्तथा रथे।\nअशोभन्त तथा युक्ता यथैवाध्वरमध्यगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2061074, "chapter_id": 2305, "verse_number": "८-२६-३०", "content_sanskrit": "कल्पयित्वा रथं दिव्यं ततो बाणमकल्पयत्।\nचिन्तयित्वा हरिं विष्णुमव्ययं यज्ञवाहनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2061075, "chapter_id": 2305, "verse_number": "८-२६-३१", "content_sanskrit": "शरं सङ्कल्पयाञ्चक्रे विश्वकर्मा महामनाः।\nतस्य वाजांश्च पुङ्खं च कल्पयामास वै तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2061076, "chapter_id": 2305, "verse_number": "८-२६-३२", "content_sanskrit": "पुण्यगन्धवहं राजञ्श्वसनं राजसत्तम।\nअग्नीषोमौ शरमुखे कल्पयामास वै तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2061077, "chapter_id": 2305, "verse_number": "८-२६-३३", "content_sanskrit": "अग्नीषोमात्मकं कृत्स्नमुच्यते वैष्णवं जगत्।\nविष्णुरात्मा भगवतो भवस्यामिततेजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2061078, "chapter_id": 2305, "verse_number": "८-२६-३४", "content_sanskrit": "तस्माद्धनुर्ज्यासंस्पर्शं स विषेहे शरस्य वै।\nतस्मिञ्शरे तीक्ष्णमन्युममुञ्चद्दुःसहं प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2061079, "chapter_id": 2305, "verse_number": "८-२६-३५", "content_sanskrit": "भृग्वङ्गिरोमन्युभवः क्रोधाग्निरतिदुःसहः।\nस नीललोहितो धूम्रः कृत्तिवासा भयानकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2061080, "chapter_id": 2305, "verse_number": "८-२६-३६", "content_sanskrit": "आदित्यायुतसङ्काशस्तेजोज्वालावृतो भवः।\nदुश्चर्यच्यावको जेता हन्ता ब्रह्मद्विषां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2061081, "chapter_id": 2305, "verse_number": "८-२६-३७", "content_sanskrit": "तस्याङ्गानि समाश्रित्य स्थितं विश्वमिदं जगत्।\nजङ्गमाजङ्गमं राजञ्छुशुभेऽद्भुतदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2061082, "chapter_id": 2305, "verse_number": "८-२६-३८", "content_sanskrit": "दृष्टा तु तं रथं दिव्यं कवची स शरासनी।\nआददे स शरं दिव्यं सोमविष्ण्वग्निवायुजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2061083, "chapter_id": 2305, "verse_number": "८-२६-३९", "content_sanskrit": "तमादाय महादेवस्त्रासयन्दैत्यदानवान्।\nआरुरोह तदा यत्तः कम्पयन्निव रोदसी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2061084, "chapter_id": 2305, "verse_number": "८-२६-४०", "content_sanskrit": "महर्षिभिः स्तूयमानो वन्द्यमानश्च वन्दिभिः।\nउपनृत्तश्चाप्सरसां गणैर्नृत्तविशारदैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2061085, "chapter_id": 2305, "verse_number": "८-२६-४१", "content_sanskrit": "स शोभमानो वरदः खङ्गी बाणी शरासनी।\nहसन्निवाब्रवीद्देवः सारथिः को भवेदिति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2061086, "chapter_id": 2305, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि षड्विंशोऽध्यायः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]