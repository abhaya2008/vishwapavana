[{"id": 2075456, "chapter_id": 2597, "verse_number": "१२-१०२-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2075457, "chapter_id": 2597, "verse_number": "१२-१०२-१", "content_sanskrit": "जयिन्याः कानि रूपाणि भवन्ति भरतर्षभ।\nपृतनायाः प्रशस्तानि तानि चेच्छामि वेदितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2075458, "chapter_id": 2597, "verse_number": "१२-१०२-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2075459, "chapter_id": 2597, "verse_number": "१२-१०२-२", "content_sanskrit": "जयिन्या यानि रूपाणि भवन्ति भरतर्षभ।\nपृतनायाः प्रशस्तानि तानि वक्ष्यामि सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2075460, "chapter_id": 2597, "verse_number": "१२-१०२-३", "content_sanskrit": "दैवे पूर्वं प्रकुपिते मानुषे कालचोदिते।\nतद्विद्व अऽनुपस्यन्ति ज्ञानदीर्घेण चक्षुषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2075461, "chapter_id": 2597, "verse_number": "१२-१०२-४", "content_sanskrit": "प्रायश्चित्तविधिं चात्र जपहोमांश्च तद्विदः।\nमङ्गल नि च कुर्वन्ति शमयन्त्यहितानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2075462, "chapter_id": 2597, "verse_number": "१२-१०२-५", "content_sanskrit": "उदीणानसो योधा वाहनानि च भारत।\nयस्यां भवन्ति सेनायां ध्रुवं तस्या जयो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2075463, "chapter_id": 2597, "verse_number": "१२-१०२-६", "content_sanskrit": "अन्वेव वायवो यान्ति तथैवेन्द्रधनूंषि च।\nअनुप्लवन्ते मेघाश्च तथाऽऽदित्यस्य रश्मयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2075464, "chapter_id": 2597, "verse_number": "१२-१०२-७", "content_sanskrit": "गोमायवश्चातुलोमबला गृध्राश्च सर्वशः।\nअर्हयेयुर्यदा सेनां तदा सिद्धिरनुत्तमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2075465, "chapter_id": 2597, "verse_number": "१२-१०२-८", "content_sanskrit": "प्रसन्नभाः पावकश्चोर्ध्वरश्मिः\nप्रदक्षिणावर्तशिखो विधूमः।\nपुण्या गन्धाश्चाहुतीनां भवन्ति\nजयस्यैतद्भाविनो रूपमाहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2075466, "chapter_id": 2597, "verse_number": "१२-१०२-९", "content_sanskrit": "गम्भीरशब्दाश्च महास्वनाश्च\nशङ्ख्याश्च भेर्यश्च नदन्ति यत्र।\nयुयुत्सवश्चाप्रतीपा भवन्ति\nजयस्यैतद्भाविनो रूपमाहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2075467, "chapter_id": 2597, "verse_number": "१२-१०२-१०", "content_sanskrit": "इष्टा मृगाः पृष्ठतो वामतश्च\nसंप्रस्थितानां च गमिष्यतां च।\nजिघांसतां दक्षिणाः सिद्धिमाहु\nर्ये त्वग्रतस्ते प्रतिषेधयन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2075468, "chapter_id": 2597, "verse_number": "१२-१०२-११", "content_sanskrit": "माङ्गल्यशब्दाञ्शकुना वदन्ति\nहंसाः क्रौञ्चाः शतपत्राश्च चाषाः।\nहृष्टा योधाः सत्ववन्तो भवन्ति\nजयस्यैतद्भाविनो रूपमाहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2075469, "chapter_id": 2597, "verse_number": "१२-१०२-१२", "content_sanskrit": "शस्त्रैर्यन्त्रैः कवचैः केतुभिश्च\nसुभानुभिर्मुखवर्णैश्च यूनाम्।\nभ्राजिष्मती दुष्प्रतिवीक्षणीया\nयेषां चमूस्तेऽभिभवन्ति शत्रून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2075470, "chapter_id": 2597, "verse_number": "१२-१०२-१३", "content_sanskrit": "शुश्रूषवश्चानभिमानिनश्च\nपरस्परं सौहृदमास्थिताश्च।\nयेषां योधाः शौर्यमनुष्ठिताश्च\nजयस्यैतद्भाविनो रुपमाहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2075471, "chapter_id": 2597, "verse_number": "१२-१०२-१४", "content_sanskrit": "शब्दाः स्पर्शास्तथा गन्धा विचरन्ति मनः प्रियाः।\nधैर्यं चाविशते योधान्विजयस्य मुखं च तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2075472, "chapter_id": 2597, "verse_number": "१२-१०२-१५", "content_sanskrit": "शब्दो वामः प्रस्थितस्य दक्षिणः प्रविविक्षतः।\nपश्चात्संसाधयत्यर्थं पुरस्ताच्च निषेधति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2075473, "chapter_id": 2597, "verse_number": "१२-१०२-१६", "content_sanskrit": "संहत्य महतीं सेनां चतुरङ्गां युधिष्ठिर।\nसाम्नैव वर्तयेः पूर्वं प्रसतेथास्ततो युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2075474, "chapter_id": 2597, "verse_number": "१२-१०२-१७", "content_sanskrit": "जघन्य एष विजयो यद्युद्धे सामभाषणम्।\nयादृच्छिको युधि जयो दैवेनेति विचारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2075475, "chapter_id": 2597, "verse_number": "१२-१०२-१८", "content_sanskrit": "आपगेव महावेगा त्रस्ता इव महामृगाः।\nदुर्निवार्यतमा चैव प्रभग्ना महती चमूः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2075476, "chapter_id": 2597, "verse_number": "१२-१०२-१९", "content_sanskrit": "भग्ना इत्येव भज्यन्ते विद्वांसोऽपि न कारणम्।\nउदारसारा महती रुरुसंघोपमा चमूः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2075477, "chapter_id": 2597, "verse_number": "१२-१०२-२०", "content_sanskrit": "परस्परज्ञाः संहृष्टास्त्यक्तप्राणाः सुनिश्चिताः।\nअपि पञ्चत्रतै शूरा निघ्नन्ति परवाहिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2075478, "chapter_id": 2597, "verse_number": "१२-१०२-२१", "content_sanskrit": "अपि वा पञ्चषट्सप्तसंहिताः कृतनिश्चयाः।\nक्ललीनाः पूजिताः सम्यग्विजयन्तीह शात्रवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2075479, "chapter_id": 2597, "verse_number": "१२-१०२-२२", "content_sanskrit": "सन्निपातो न मन्तव्यः शक्ये सति कथंचन।\nसान्त्वभेदप्रदानानां युद्धमुत्तरमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2075480, "chapter_id": 2597, "verse_number": "१२-१०२-२३", "content_sanskrit": "संसर्पेण हि सेनाया भयं भीरून्प्रबाधते।\nवज्रादिय प्रज्वलितादियं स्वित्क्षपयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2075481, "chapter_id": 2597, "verse_number": "१२-१०२-२४", "content_sanskrit": "अमिप्रयातां समितिं ज्ञात्वा ये प्रतियान्त्यथ।\nतेषां सन्दन्ति गात्राणि योधानां विवयस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2075482, "chapter_id": 2597, "verse_number": "१२-१०२-२५", "content_sanskrit": "विषयो व्यथते राजन्सर्वः सस्थाणुजङ्गमः।\nअस्त्रप्रतापतप्तानां मज्जाः सीदन्ति देहिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2075483, "chapter_id": 2597, "verse_number": "१२-१०२-२६", "content_sanskrit": "तेषां सान्त्वं क्रूरमिश्रं प्रणेतव्यं पुनः पुनः।\nसंपीड्यमाना हि परैर्योगमायान्ति सर्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2075484, "chapter_id": 2597, "verse_number": "१२-१०२-२७", "content_sanskrit": "आन्तराणां च भेदार्थं चरानभ्यवचारयेत्।\nयश्च तस्मात्परो राजा तेन संधिः प्रशस्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2075485, "chapter_id": 2597, "verse_number": "१२-१०२-२८", "content_sanskrit": "न हि तस्यान्यथा पीडा शक्या कर्तुं तथाविधा।\nयथा सार्धममित्रेण सर्वतः प्रतिबाधनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2075486, "chapter_id": 2597, "verse_number": "१२-१०२-२९", "content_sanskrit": "क्षमा वै साधुमायाति न ह्यसाधून्क्षमा सदा।\nक्षमायाश्चाक्षमायाश्च पार्थ विद्धि प्रयोजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2075487, "chapter_id": 2597, "verse_number": "१२-१०२-३०", "content_sanskrit": "विजित्य क्षममाणस्य यशो राज्ञो विवर्धते।\nमहापराधे ह्यप्यस्मिन्विश्वसन्त्यपि शत्रवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2075488, "chapter_id": 2597, "verse_number": "१२-१०२-३१", "content_sanskrit": "मन्यन्ते कर्षयित्वा तु क्षमा साध्वीति शाम्बराः।\nअसंतप्तं तु यद्दारु प्रत्येति प्रकृतिं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2075489, "chapter_id": 2597, "verse_number": "१२-१०२-३२", "content_sanskrit": "नैतत्प्रशंसन्त्याचार्या न चैतत्साधु दर्शनम्।\nअक्रोधेनाविनाशेन नियन्तव्याः स्वपुत्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2075490, "chapter_id": 2597, "verse_number": "१२-१०२-३३", "content_sanskrit": "द्वेष्यो भवति भूतानामुग्रो राजा युधिष्ठिर।\nमृदुमप्यवमन्यन्ते तस्मादुभयभाग्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2075491, "chapter_id": 2597, "verse_number": "१२-१०२-३४", "content_sanskrit": "प्रहरिष्यन्प्रियं ब्रूयात्प्रहरन्नपि भारत।\nप्रहृत्य च प्रियं ब्रूयाच्छोचन्निव रुदन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2075492, "chapter_id": 2597, "verse_number": "१२-१०२-३५", "content_sanskrit": "न मे प्रिया ये स्म हताः संप्रहृष्टाः परेऽपि च।\nन च कत्थनमेवाग्र्यमुच्यमानं पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2075493, "chapter_id": 2597, "verse_number": "१२-१०२-३६", "content_sanskrit": "अहो जीवितमाकाङ्क्षेन्नेदृशो वधमर्हति।\nसुदुर्लभाः सुपुरुषाः संग्रामेष्वपलायिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2075494, "chapter_id": 2597, "verse_number": "१२-१०२-३७", "content_sanskrit": "कृतं ममाप्रियं तेन येनायं निहतो मृधे।\nइति वाचा वदन्हन्तृन्पूजयेत रहोगतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2075495, "chapter_id": 2597, "verse_number": "१२-१०२-३८", "content_sanskrit": "हन्तॄणां च हतानां च पूजां कुर्याद्यथार्थतः।\nक्रोशेद्बाहुं प्रगृह्यापि चिकीर्षञ्जनसंग्रहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2075496, "chapter_id": 2597, "verse_number": "१२-१०२-३९", "content_sanskrit": "एवं सर्वास्ववस्थासु सान्त्वपूर्वं समाचरेत्।\nप्रियो भवति भूतानां धर्मज्ञो वीतभीर्नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2075497, "chapter_id": 2597, "verse_number": "१२-१०२-४०", "content_sanskrit": "विश्वासं चात्र गच्छन्ति सर्वभूतानि भारत।\nविश्वस्तः शक्यते भोक्तुं यथाकालं समुत्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2075498, "chapter_id": 2597, "verse_number": "१२-१०२-४१", "content_sanskrit": "तस्माद्विश्वासयेद्राजा सर्वभूतान्यमायया।\nसर्वतः परिरक्षेच्च यो महीं भोक्तुमिच्छति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2075499, "chapter_id": 2597, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि द्व्यधिकशततमोऽध्यायः॥ १०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]