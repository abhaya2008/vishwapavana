[{"id": 40018762, "chapter_id": 9294, "verse_number": "1", "content_sanskrit": "सतुमोहात्सुसङ्क्रुद्धःकृतान्तबलचोदितः । क्रोधसंरक्तनयनोरावणंसूतमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40018763, "chapter_id": 9294, "verse_number": "2", "content_sanskrit": "हीनवीर्यमिवाशक्तंपौरुषेणविवर्जितम् । भीरुंलघुमिवासत्त्वंविहीनमिवतेजसा ॥ विमुक्तमिवमायाभिरस्त्रैरिवबहिष्कृतम् । मामवज्ञायदुर्बुद्धेस्वयाबुद्ध्याविचेष्टसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40018764, "chapter_id": 9294, "verse_number": "3", "content_sanskrit": "हीनवीर्यमिवाशक्तंपौरुषेणविवर्जितम् । भीरुंलघुमिवासत्त्वंविहीनमिवतेजसा ॥ विमुक्तमिवमायाभिरस्त्रैरिवबहिष्कृतम् । मामवज्ञायदुर्बुद्धेस्वयाबुद्ध्याविचेष्टसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40018765, "chapter_id": 9294, "verse_number": "4", "content_sanskrit": "किमर्थंमामवज्ञायमच्छन्दमनवेक्ष्य च । त्वयाशत्रुसमक्षंमेरथोऽयमपवाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40018766, "chapter_id": 9294, "verse_number": "5", "content_sanskrit": "त्वयाद्यहिममानार्य चिरकालसमार्जितम् । यशोवीर्यं च तेजश्चप्रत्ययश्चविनाशितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40018767, "chapter_id": 9294, "verse_number": "6", "content_sanskrit": "प्रख्यातवीर्यस्यरञ्जनीयस्यविक्रमैः । पश्यतोयुद्धलुब्धोऽहंकृतंकापुरुषस्त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40018768, "chapter_id": 9294, "verse_number": "7", "content_sanskrit": "यस्त्वंरथमिदंमोहान्नचेद्वहसिदुर्मते । सत्योऽप्रतितर्कोमेपरेणत्वमुपस्कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40018769, "chapter_id": 9294, "verse_number": "8", "content_sanskrit": "न हितद्विद्यतेकर्मसुहृदोहितकाङ्क्षिणः । रिपूणांसदृशंत्वेतद्यतत्त्वयैतदनुष्ठितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40018770, "chapter_id": 9294, "verse_number": "9", "content_sanskrit": "निवर्तयरथंशीघ्रंयावन्नापैतिमेरिपुः । यदिवाध्युषितोऽसित्वंस्मर्यतेयदिमेगुणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40018771, "chapter_id": 9294, "verse_number": "10", "content_sanskrit": "एवंपुरुषमुक्तस्तुहितबुद्धिबुद्धिना । अब्रवीद्रावणंसूतोहितंसानुनयंवचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40018772, "chapter_id": 9294, "verse_number": "11", "content_sanskrit": "न भीतोऽस्मि न मूढोऽस्मिनोपजप्तोऽस्मिशत्रुभिः । न प्रमत्तो न निःस्नेहोविस्मृता न च सत्क्रिया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40018773, "chapter_id": 9294, "verse_number": "12", "content_sanskrit": "मयातुहितकामेवयशश्चपरिरक्षता । स्नेहप्रसन्नमनसाहितमित्यप्रियंकृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40018774, "chapter_id": 9294, "verse_number": "13", "content_sanskrit": "नास्मिन्नर्थेमहाराज त्वंमांप्रियहितेरतम् । कश्चिल्लघुरिवानार्योदोषतोगन्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40018775, "chapter_id": 9294, "verse_number": "14", "content_sanskrit": "श्रूयतांप्रतिदास्यामियन्निमित्तंमयारथः । नदीवेगइवामंभोभिेसंयुगेविनिवर्तितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40018776, "chapter_id": 9294, "verse_number": "15", "content_sanskrit": "श्रमंतवावगच्छामिमहतारणकर्मणा । न हितेवीर्यसौमुख्यंप्रकर्षंवोपधारये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40018777, "chapter_id": 9294, "verse_number": "16", "content_sanskrit": "रथोद्वहनखिन्नाश्चभग्नामेरथवाजिनः । दीनाघर्मपरिश्रान्तागावोवर्षहताइव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40018778, "chapter_id": 9294, "verse_number": "17", "content_sanskrit": "निमित्तानि च भूयिष्ठंयानिप्रादुर्भवन्तिनः । तेषुतेष्वभिपन्नेषुलक्ष्याम्यप्रदक्षिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40018779, "chapter_id": 9294, "verse_number": "18", "content_sanskrit": "देशकालौ च विज्ञेयौलक्षणानीङ्गितानि च । दैन्यंहर्षश्चखेदश्चरथिनश्चबलाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40018780, "chapter_id": 9294, "verse_number": "19", "content_sanskrit": "स्थलनिम्नानिभूमेश्चसमानिविषमाणि च । युद्धकालश्चविज्ञेयःपरस्यान्तरदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40018781, "chapter_id": 9294, "verse_number": "20", "content_sanskrit": "उपयानापयाने च स्थानंप्रत्यपसर्पणम् । सर्वमेतद्रथस्थेनज्ञेयंरथकुटुम्भिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40018782, "chapter_id": 9294, "verse_number": "21", "content_sanskrit": "तवविश्रामहेतोस्तुतथैषांरथवाजिनाम् । रौद्रंवर्जयताखेदंक्षमंकृतमिदंमया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40018783, "chapter_id": 9294, "verse_number": "22", "content_sanskrit": "स्वेच्छयान मयावीररथोऽयमपवाहितः । भर्तृस्नेहपरीतेनमयेदंयत्कृतंप्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40018784, "chapter_id": 9294, "verse_number": "23", "content_sanskrit": "आज्ञापययथातत्त्वंवक्ष्यस्यरिनिषूदन । तत्करिष्याम्यहंवीरगतानृण्येनचेतसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40018785, "chapter_id": 9294, "verse_number": "24", "content_sanskrit": "सन्तुष्टस्तेनवाक्येनरावणस्तस्यसारथेः । प्रशस्यैनंबहुविधंयुद्धलुब्धोऽब्रवीदिदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40018786, "chapter_id": 9294, "verse_number": "25", "content_sanskrit": "रथंशीघ्रमिदंसूतराघवाभिमुखंनय । नाहत्वासमरेशत्रून्निवर्तिष्यतिरावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40018787, "chapter_id": 9294, "verse_number": "26", "content_sanskrit": "एवमुक्त्वाततस्तुष्टोरावणोराक्षसेश्वरः । ददौतस्यशुभंह्येकंहस्ताभरणमुत्तमम् ॥ श्रुत्वारावणवाक्यानिसारथिस्सन्यवर्तत ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]