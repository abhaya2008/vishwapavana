[{"id": 5000294000, "chapter_id": 9294, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे द्वाविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000294001, "chapter_id": 9294, "verse_number": "४-२२-१", "content_sanskrit": "वीक्षमाणस्तु मन्दासुः सर्वतो मन्दमुच्छ्वसन्।\nआदावेव तु सुग्रीवं ददर्शानुजमग्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000294002, "chapter_id": 9294, "verse_number": "४-२२-२", "content_sanskrit": "तं प्राप्तविजयं वाली सुग्रीवं प्लवगेश्वरम्।\nआभाष्य व्यक्तया वाचा सस्नेहमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000294003, "chapter_id": 9294, "verse_number": "४-२२-३", "content_sanskrit": "सुग्रीव दोषेण न मां गन्तुमर्हसि किल्बिषात्।\nकृष्यमाणं भविष्येण बुद्धिमोहेन मां बलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000294004, "chapter_id": 9294, "verse_number": "४-२२-४", "content_sanskrit": "युगपद् विहितं तात न मन्ये सुखमावयोः।\nसौहार्दं भ्रातृयुक्तं हि तदिदं जातमन्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000294005, "chapter_id": 9294, "verse_number": "४-२२-५", "content_sanskrit": "प्रतिपद्य त्वमद्यैव राज्यमेषां वनौकसाम्।\nमामप्यद्यैव गच्छन्तं विद्धि वैवस्वतक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000294006, "chapter_id": 9294, "verse_number": "४-२२-६", "content_sanskrit": "जीवितं च हि राज्यं च श्रियं च विपुलां तथा।\nप्रजहाम्येष वै तूर्णमहं चागर्हितं यशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000294007, "chapter_id": 9294, "verse_number": "४-२२-७", "content_sanskrit": "अस्यां त्वहमवस्थायां वीर वक्ष्यामि यद् वचः।\nयद्यप्यसुकरं राजन् कर्तुमेव त्वमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000294008, "chapter_id": 9294, "verse_number": "४-२२-८", "content_sanskrit": "सुखार्हं सुखसंवृद्धं बालमेनमबालिशम्।\nबाष्पपूर्णमुखं पश्य भूमौ पतितमङ्गदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000294009, "chapter_id": 9294, "verse_number": "४-२२-९", "content_sanskrit": "मम प्राणैः प्रियतरं पुत्रं पुत्रमिवौरसम्।\nमया हीनमहीनार्थं सर्वतः परिपालय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000294010, "chapter_id": 9294, "verse_number": "४-२२-१०", "content_sanskrit": "त्वमप्यस्य पिता दाता परित्राता च सर्वशः।\nभयेष्वभयदश्चैव यथाहं प्लवगेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000294011, "chapter_id": 9294, "verse_number": "४-२२-११", "content_sanskrit": "एष तारात्मजः श्रीमांस्त्वया तुल्यपराक्रमः।\nरक्षसां च वधे तेषामग्रतस्ते भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000294012, "chapter_id": 9294, "verse_number": "४-२२-१२", "content_sanskrit": "अनुरूपाणि कर्माणि विक्रम्य बलवान् रणे।\nकरिष्यत्येष तारेयस्तेजस्वी तरुणोऽङ्गदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000294013, "chapter_id": 9294, "verse_number": "४-२२-१३", "content_sanskrit": "सुषेणदुहिता चेयमर्थसूक्ष्मविनिश्चये।\nऔत्पातिके च विविधे सर्वतः परिनिष्ठिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000294014, "chapter_id": 9294, "verse_number": "४-२२-१४", "content_sanskrit": "यदेषा साध्विति ब्रूयात् कार्यं तन्मुक्तसंशयम्।\nनहि तारामतं किंचिदन्यथा परिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000294015, "chapter_id": 9294, "verse_number": "४-२२-१५", "content_sanskrit": "राघवस्य च ते कार्यं कर्तव्यमविशङ्कया।\nस्यादधर्मो ह्यकरणे त्वां च हिंस्यादमानितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000294016, "chapter_id": 9294, "verse_number": "४-२२-१६", "content_sanskrit": "इमां च मालामाधत्स्व दिव्यां सुग्रीव काञ्चनीम्।\nउदारा श्रीः स्थिता ह्यस्यां सम्प्रजह्यान्मृते मयि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000294017, "chapter_id": 9294, "verse_number": "४-२२-१७", "content_sanskrit": "इत्येवमुक्तः सुग्रीवो वालिना भ्रातृसौहृदात्।\nहर्षं त्यक्त्वा पुनर्दीनो ग्रहग्रस्त इवोडुराट् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000294018, "chapter_id": 9294, "verse_number": "४-२२-१८", "content_sanskrit": "तद्वालिवचनाच्छान्तः कुर्वन् युक्तमतन्द्रितः।\nजग्राह सोऽभ्यनुज्ञातो मालां तां चैव काञ्चनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000294019, "chapter_id": 9294, "verse_number": "४-२२-१९", "content_sanskrit": "तां मालां काञ्चनीं दत्त्वा दृष्ट्वा चैवात्मजं स्थितम्।\nसंसिद्धः प्रेत्यभावाय स्नेहादङ्गदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000294020, "chapter_id": 9294, "verse_number": "४-२२-२०", "content_sanskrit": "देशकालौ भजस्वाद्य क्षममाणः प्रियाप्रिये।\nसुखदुःखसहः काले सुग्रीववशगो भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000294021, "chapter_id": 9294, "verse_number": "४-२२-२१", "content_sanskrit": "यथा हि त्वं महाबाहो लालितः सततं मया।\nन तथा वर्तमानं त्वां सुग्रीवो बहु मन्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000294022, "chapter_id": 9294, "verse_number": "४-२२-२२", "content_sanskrit": "नास्यामित्रैर्गतं गच्छेर्मा शत्रुभिररिंदम।\nभर्तुरर्थपरो दान्तः सुग्रीववशगो भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000294023, "chapter_id": 9294, "verse_number": "४-२२-२३", "content_sanskrit": "न चातिप्रणयः कार्यः कर्तव्योऽप्रणयश्च ते।\nउभयं हि महादोषं तस्मादन्तरदृग् भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000294024, "chapter_id": 9294, "verse_number": "४-२२-२४", "content_sanskrit": "इत्युक्त्वाथ विवृत्ताक्षः शरसम्पीडितो भृशम्।\nविवृतैर्दशनैर्भीमैर्बभूवोत्क्रान्तजीवितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000294025, "chapter_id": 9294, "verse_number": "४-२२-२५", "content_sanskrit": "ततो विचुक्रुशुस्तत्र वानरा हतयूथपाः।\nपरिदेवयमानास्ते सर्वे प्लवगसत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000294026, "chapter_id": 9294, "verse_number": "४-२२-२६", "content_sanskrit": "किष्किन्धा ह्यद्य शून्या च स्वर्गते वानरेश्वरे।\nउद्यानानि च शून्यानि पर्वताः काननानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000294027, "chapter_id": 9294, "verse_number": "४-२२-२७", "content_sanskrit": "हते प्लवगशार्दूले निष्प्रभा वानराः कृताः।\nयस्य वेगेन महता काननानि वनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000294028, "chapter_id": 9294, "verse_number": "४-२२-२८", "content_sanskrit": "पुष्पौघेणानुबद्‍ध्यन्ते करिष्यति तदद्य कः।\nयेन दत्तं महद् युद्धं गन्धर्वस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000294029, "chapter_id": 9294, "verse_number": "४-२२-२९", "content_sanskrit": "गोलभस्य महाबाहोर्दश वर्षाणि पञ्च च।\nनैव रात्रौ न दिवसे तद् युद्धमुपशाम्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000294030, "chapter_id": 9294, "verse_number": "४-२२-३०", "content_sanskrit": "ततः षोडशमे वर्षे गोलभो विनिपातितः।\nतं हत्वा दुर्विनीतं तु वाली दंष्ट्राकरालवान्।\nसर्वाभयंकरोऽस्माकं कथमेष निपातितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000294031, "chapter_id": 9294, "verse_number": "४-२२-३१", "content_sanskrit": "हते तु वीरे प्लवगाधिपे तदा\nप्लवङ्गमास्तत्र न शर्म लेभिरे।\nवनेचराः सिंहयुते महावने\nयथा हि गावो निहते गवां पतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000294032, "chapter_id": 9294, "verse_number": "४-२२-३२", "content_sanskrit": "ततस्तु तारा व्यसनार्णवप्लुता\nमृतस्य भर्तुर्वदनं समीक्ष्य सा।\nजगाम भूमिं परिरभ्य वालिनं\nमहाद्रुमं छिन्नमिवाश्रिता लता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000294033, "chapter_id": 9294, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे द्वाविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]