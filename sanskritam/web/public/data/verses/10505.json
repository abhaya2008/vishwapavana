[{"id": 50001650, "chapter_id": 10505, "verse_number": "1", "content_sanskrit": "ऋतं पिबन्तौ सुकृतस्य लोके गुहां प्रविष्टौ परमे परार्द्धे। छायातपौ ब्रह्मविदो वदन्ति पञ्चाग्नयो ये च त्रिनाचिकेताः॥१/३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50001651, "chapter_id": 10505, "verse_number": "2", "content_sanskrit": "यः सेतुरीजानानामक्षरं ब्रह्म यत् परम्। अभयं तितीर्षतां पारं नाचिकेतं शकेमसि ॥१/३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50001652, "chapter_id": 10505, "verse_number": "3", "content_sanskrit": "आत्मानꣳ रथिनं विद्धि शरीरꣳ रथमेव च। बुद्धिं तु सारथिं विद्धि मनः प्रग्रहमेव च॥ १/३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50001653, "chapter_id": 10505, "verse_number": "4", "content_sanskrit": "इन्द्रियाणि हयानाहुर्विषयाꣳस्तेषु गोचरान्। आत्मेन्द्रियमनोयुक्तं भोक्तेत्याहुर्मनीषिणः॥ १/३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50001654, "chapter_id": 10505, "verse_number": "5", "content_sanskrit": "यस्त्वविज्ञानवान् भवत्ययुक्तेन मनसा सदा। तस्येन्द्रियाण्यवश्यानि दुष्टाश्वा इव सारथेः॥ १/३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50001655, "chapter_id": 10505, "verse_number": "6", "content_sanskrit": "यस्तु विज्ञानवान् भवति युक्तेन मनसा सदा। तस्येन्द्रियाणि वश्यानि सदश्वा इव सारथेः॥ १/३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50001656, "chapter_id": 10505, "verse_number": "7", "content_sanskrit": "यस्त्वविज्ञानवान् भवत्यमनस्कः सदाऽशुचिः। न स तत् पदमाप्नोति सꣳसारं चाधिगच्छति॥१/३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50001657, "chapter_id": 10505, "verse_number": "8", "content_sanskrit": "यस्तु विज्ञानवान् भवति समनस्कः सदा शुचिः। स तु तत् पदमाप्नोति यस्माद् भूयो न जायते॥ १/३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50001658, "chapter_id": 10505, "verse_number": "9", "content_sanskrit": "विज्ञानसारथिर्यस्तु मनःप्रग्रहवान् नरः। सोऽध्वनः पारमाप्नोति तद् विष्णोः परमं पदम्॥१/३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50001659, "chapter_id": 10505, "verse_number": "10", "content_sanskrit": "इन्द्रियेभ्यः परा ह्यर्था अर्थेभ्यश्च परं मनः। मनसस्तु परा बुद्धिर्बुद्धेरात्मा महान् परः॥१/३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50001660, "chapter_id": 10505, "verse_number": "11", "content_sanskrit": "महतः परमव्यक्तमव्यक्तात् पुरुषः परः। पुरुषान्न परः किञ्चित् सा काष्ठा सा परा गतिः॥ १/३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50001661, "chapter_id": 10505, "verse_number": "12", "content_sanskrit": "एष सर्वेषु भूतेषु गूढोत्मा न प्रकाशते। दृश्यते त्वग्र्यया बुद्ध्या सूक्ष्मया सूक्ष्मदर्शिभिः॥१/३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50001662, "chapter_id": 10505, "verse_number": "13", "content_sanskrit": "यच्छेद् वाङ् मनसी प्राज्ञस्तद् यच्छेज्ज्ञान आत्मनि। ज्ञानमात्मनि महति नियच्छेच्छान्त आत्मनि॥१/३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50001663, "chapter_id": 10505, "verse_number": "14", "content_sanskrit": "उत्तिष्ठत जाग्रत प्राप्य वरान् निबोधत। क्षुरस्य धारा निशिता दुरत्यया दुर्गं पथस्तत् कवयो वदन्ति॥१/३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50001664, "chapter_id": 10505, "verse_number": "15", "content_sanskrit": "अशब्दमस्पर्शमरूपमव्ययं तथाऽरसं नित्यमगन्धवच्च यत्। अनाद्यनन्तं महतः परं ध्रुवं निचाय्य तं मृत्युमुखात् प्रमुच्यते॥ १/३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50001665, "chapter_id": 10505, "verse_number": "16", "content_sanskrit": "नाचिकेतमुपाख्यानं मृत्युप्रोक्तꣳ सनातनम्। उक्त्वा श्रुत्वा च मेधावी ब्रह्मलोके महीयते॥१/३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50001666, "chapter_id": 10505, "verse_number": "17", "content_sanskrit": "य इमं परमं गुह्यं श्रावयेद् ब्रह्मसꣳसदि। प्रयतः श्राद्धकाले वा तदानन्त्याय कल्पते तदानन्त्याय कल्पत इति॥ १/३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50001667, "chapter_id": 10505, "verse_number": "18", "content_sanskrit": "॥ इति प्रथमाध्यायस्य तृतीया वल्ली॥ ॥ इति प्रथमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50001668, "chapter_id": 10505, "verse_number": "19", "content_sanskrit": "॥ द्वितीयोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]