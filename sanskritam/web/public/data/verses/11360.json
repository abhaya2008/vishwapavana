[{"id": 50006645, "chapter_id": 11360, "verse_number": "1", "content_sanskrit": "सूत उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50006646, "chapter_id": 11360, "verse_number": "2", "content_sanskrit": "एवं निशम्य भगवान् देवर्षेर्जन्म कर्म च। भूयः पप्रच्छ तं ब्रह्मन् व्यासः सत्यवतीसुतः॥ १/६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50006647, "chapter_id": 11360, "verse_number": "3", "content_sanskrit": "श्रीव्यास उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50006648, "chapter_id": 11360, "verse_number": "4", "content_sanskrit": "भिक्षुभिर्विप्रवसिते विज्ञानादेष्टृभिस्तव। वर्तमानो वयस्याद्ये ततः किमकरोद्भवान्॥ १/६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50006649, "chapter_id": 11360, "verse_number": "5", "content_sanskrit": "स्वायम्भुव कया वृत्त्या वर्तितं ते परं वयः। कथं वेदमुदस्राक्षीः काले प्राप्ते कळेबरम्॥ १/६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50006650, "chapter_id": 11360, "verse_number": "6", "content_sanskrit": "प्राक्कल्पविषयामेतां स्मृतिं ते सुरसत्तम। न ह्येव व्यवधात् काल एष सर्वनिराकृतिः॥ १/६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50006651, "chapter_id": 11360, "verse_number": "7", "content_sanskrit": "श्रीनारद उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50006652, "chapter_id": 11360, "verse_number": "8", "content_sanskrit": "भिक्षुभिर्विप्रवसिते विज्ञानादेष्टृभिर्मम। वर्तमानो वयस्याद्ये तत एतदकार्षम्॥ १/६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50006653, "chapter_id": 11360, "verse_number": "9", "content_sanskrit": "एकात्मजा मे जननी योषिन्मूढा च किङ्करी। मय्यात्मजेऽनन्यगतौ चक्रे स्नेहानुबन्धनम्॥ १/६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50006654, "chapter_id": 11360, "verse_number": "10", "content_sanskrit": "साऽस्वतन्त्रा न कल्पासीद् योगक्षेमं ममेच्छती। ईशस्य हि वशे लोको योषा दारुमयी यथा॥ १/६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50006655, "chapter_id": 11360, "verse_number": "11", "content_sanskrit": "अहं च तद्ब्रह्मकुल ऊषिवांस्तदपेक्षया। दिग्देशकालाव्युत्पन्नो बालकः पञ्चहायनः॥ १/६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50006656, "chapter_id": 11360, "verse_number": "12", "content_sanskrit": "एकदा निर्गतां गेहाद् दुहन्तीं निशि गां पथि। सर्पोऽदशत् पदा स्पृष्टः करुणां कालचोदितः॥ १/६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50006657, "chapter_id": 11360, "verse_number": "13", "content_sanskrit": "तदा तदहमीशस्य भक्तानां समभीप्सितम्। अनुग्रहं मन्यमानः प्रातिष्ठं दिशमुत्तराम्॥ १/६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50006658, "chapter_id": 11360, "verse_number": "14", "content_sanskrit": "स्फीतान् जनपदांस्तत्र पुरग्रामव्रजाकरान्। खेटान् पट्टनवाटीश्च वनान्युपवनानि च॥ १/६/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50006659, "chapter_id": 11360, "verse_number": "15", "content_sanskrit": "विचित्रधातुचित्राद्रीनिभभग्नभुजद्रुमान्। जलाशयांश्छिवजलान् नळिनीः सुरसेविताः॥ १/६/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50006660, "chapter_id": 11360, "verse_number": "16", "content_sanskrit": "चित्रस्वनैः पत्ररथैर्विभ्रमद्भ्रमरश्रियः। नळवेणुशरस्तम्बकुशकीचकगह्वरान्॥ १/६/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50006661, "chapter_id": 11360, "verse_number": "17", "content_sanskrit": "एक एवातियातोऽहमद्राक्षं विपिनं महत्। घोरं प्रतिभयाकारं व्याळोलूकशिवाजिरम्॥ १/६/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50006662, "chapter_id": 11360, "verse_number": "18", "content_sanskrit": "परिश्रान्तेन्द्रियात्माऽहं तृट्परीतो बुभुक्षितः। स्नात्वा पीत्वा ह्रदे नद्या उपस्पृष्टो गतश्रमः॥ १/६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50006663, "chapter_id": 11360, "verse_number": "19", "content_sanskrit": "तस्मिन् निर्मनुजेऽरण्ये पिप्पलोपस्थ आश्रितः। आत्मनाऽऽत्मानमात्मस्थं यथाश्रुतमचिन्तयम्॥ १/६/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50006664, "chapter_id": 11360, "verse_number": "20", "content_sanskrit": "स्वप्नो मायाग्रहः शय्या जाग्रदाभास आत्मनः। नामरूपक्रियावृत्तिः संविच्छास्त्रं परं पदम्॥ १/६/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50006665, "chapter_id": 11360, "verse_number": "21", "content_sanskrit": "नेन्द्रियार्थं न च स्वप्नं न सुप्तं न मनोरथम्। न निरोधं चानुगच्छेच्चित्रं तद्भगवत्पदम्॥ १/६/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50006666, "chapter_id": 11360, "verse_number": "22", "content_sanskrit": "स एको भगवानग्रे क्रीडिष्यन्निदमात्मनः। सृष्ट्वा विहृत्य तज्जग्ध्वा उदास्ते केवलः पुनः॥ १/६/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50006667, "chapter_id": 11360, "verse_number": "23", "content_sanskrit": "ध्यायतश्चरणाम्भोजं भावनिर्वृतचेतसः। उत्कण्ठाश्रुकळाक्षस्य हृद्यासीन्मे शनैर्हरिः॥ १/६/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50006668, "chapter_id": 11360, "verse_number": "24", "content_sanskrit": "प्रेमातिभारनिर्भिण्णपुळकाङ्गोऽतिनिर्वृतः। आनन्दसम्प्लवे लीनो नापश्यमुभयं मुने॥ १/६/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50006669, "chapter_id": 11360, "verse_number": "25", "content_sanskrit": "रूपं भगवतो यत्तन्मनःकान्तं सुखावहम्। अपश्यन् सहसोत्तस्थौ कैवल्याद्दुर्मना इव॥ १/६/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50006670, "chapter_id": 11360, "verse_number": "26", "content_sanskrit": "दिदृक्षुस्तदहं भूयः प्रणिधाय मनो हृदि। वीक्षमाणोऽपि नापश्यमवितृप्त इवातुरः॥ १/६/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50006671, "chapter_id": 11360, "verse_number": "27", "content_sanskrit": "एवं यतन्तं विजने मामाहागोचरो गिराम्। गम्भीरश्लक्ष्णया वाचा शुचः प्रशमयन्निव॥ १/६/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50006672, "chapter_id": 11360, "verse_number": "28", "content_sanskrit": "हन्तास्मिन् जन्मनि भवान् न मां द्रष्टुमिहार्हति। अविपक्वकषायाणां दुर्दर्शोऽहं कुयोगिनाम्॥ १/६/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50006673, "chapter_id": 11360, "verse_number": "29", "content_sanskrit": "सकृद्यद्दर्शितं रूपमेतत् कामाय तेऽनघ। मत्कामः शनकैः साधु सर्वान् मुञ्चति हृच्छ्रयान्॥ १/६/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50006674, "chapter_id": 11360, "verse_number": "30", "content_sanskrit": "सत्सेवया दीर्घया वै जाता मयि दृढा मतिः। हित्वाऽवद्यमिमं लोकं गन्ता मज्जनतामसि॥ १/६/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50006675, "chapter_id": 11360, "verse_number": "31", "content_sanskrit": "मतिर्मयि निबद्धेयं न विपद्येत कर्हिचित्। प्रजासर्गनिरोधेऽपि स्मृतिश्च मदनुग्रहात्॥ १/६/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50006676, "chapter_id": 11360, "verse_number": "32", "content_sanskrit": "एतावदुक्त्वोपरराम तन्महद्भूतं नभोलिङ्गमलिङ्गमीश्वरम्। अहं च तस्मै महतां महीयसे शीर्ष्णाऽवनामं विदधेऽनुकम्पितः॥ १/६/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50006677, "chapter_id": 11360, "verse_number": "33", "content_sanskrit": "नामान्यनन्तस्य गतत्रपः पठन् गुह्यानि भद्राणि कृतानि च स्मरन्। गां पर्यटंस्तुष्टमना गतस्पृहः कालं प्रतीक्षन्नपटो विमत्सरः॥ १/६/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50006678, "chapter_id": 11360, "verse_number": "34", "content_sanskrit": "एवं कृष्णमतेर्ब्रह्मन्नसक्तस्यामलात्मनः। कालः प्रादुरभूत् काले तटित् सौदामिनी यथा॥ १/६/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50006679, "chapter_id": 11360, "verse_number": "35", "content_sanskrit": "एवं मयि प्रयुञ्जाने शुद्धां भागवतीं तनुम्। प्रारब्धकर्मनिर्वाणो न्यपतत् पाञ्चभौतिकः॥ १/६/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50006680, "chapter_id": 11360, "verse_number": "36", "content_sanskrit": "कल्पान्त इदमादाय शयानेऽम्भस्युदन्वतः। शिशयिष्णोरनुप्राणं विवेशान्तरहं विभोः॥ १/६/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50006681, "chapter_id": 11360, "verse_number": "37", "content_sanskrit": "सहस्रयुगपर्यन्त उत्थायेदं सिसृक्षतः। मरीचिमिश्रा ऋषयः प्राणेभ्योऽहं च जज्ञिरे॥ १/६/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50006682, "chapter_id": 11360, "verse_number": "38", "content_sanskrit": "अन्तर्बहिश्च लोकांस्त्रीन् पर्येम्यस्कन्दितव्रतः। अनुग्रहान्महाविष्णोरविघातगतिः क्वचित्॥ १/६/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50006683, "chapter_id": 11360, "verse_number": "39", "content_sanskrit": "देवदत्तामिमां वीणां स्वरब्रह्मविभूषिताम्। मूर्च्छयित्वा हरिकथां गायमानश्चराम्यहम्॥ १/६/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50006684, "chapter_id": 11360, "verse_number": "40", "content_sanskrit": "प्रगायतश्च वीर्याणि तीर्थपादः प्रियश्रवाः। आहूत इव मे शीघ्रं दर्शनं याति चेतसि॥ १/६/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50006685, "chapter_id": 11360, "verse_number": "41", "content_sanskrit": "एतद्ध्यातुरचित्तानां मात्रास्पर्शेच्छया मुहुः। भवसिन्धुप्लवो दृष्टो हरिचर्यानुवर्णनम्॥ १/६/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50006686, "chapter_id": 11360, "verse_number": "42", "content_sanskrit": "यमादिभिर्योगपथैः कामलोभहतो मुहुः। मुकुन्दसेवया यद्वत् तथात्माऽद्धा न शाम्यति॥ १/६/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50006687, "chapter_id": 11360, "verse_number": "43", "content_sanskrit": "सर्वं तदिदमाख्यातं यत्पृष्टोऽहं त्वयाऽनघ। जन्मकर्मरहस्यं मे भवतश्चात्मतोषणम्॥ १/६/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50006688, "chapter_id": 11360, "verse_number": "44", "content_sanskrit": "सूत उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 50006689, "chapter_id": 11360, "verse_number": "45", "content_sanskrit": "एवं सम्भाष्य भगवान् नारदो वासवीसुतम्। आमन्त्र्य वीणां रणयन् ययौ यादृच्छिको यतिः॥ १/६/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 50006690, "chapter_id": 11360, "verse_number": "46", "content_sanskrit": "अहो देवर्षिर्धन्योऽयं यः कीर्तिं शार्ङ्गधन्वनः। गायन् माध्व्या गिरा तन्त्र्या रमयत्यातुरं जगत्॥ १/६/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 50006691, "chapter_id": 11360, "verse_number": "47", "content_sanskrit": "॥ इति श्रीमद्भागवते प्रथमस्कन्धे षष्ठोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]