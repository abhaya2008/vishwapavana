[{"id": 2127203, "chapter_id": 3728, "verse_number": "", "content_sanskrit": "बृहदश्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2127204, "chapter_id": 3728, "verse_number": "१", "content_sanskrit": "सर्वं विकारं दृष्ट्वा तु पुण्यश्लोकस्य धीमतः ।\nआगत्य केशिनी क्षिप्रं दमयन्त्यै न्यवेदयत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2127205, "chapter_id": 3728, "verse_number": "२", "content_sanskrit": "दमयन्ती ततो भूयः प्रेषयामास केशिनीम् ।\nमातुःसकाशं दुःखार्ता नळशङ्कासमुत्सुका \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2127206, "chapter_id": 3728, "verse_number": "३", "content_sanskrit": "परीक्षितो मे बहुशो बाहुको नळशङ्कया ।\nरूपे मे संशयस्त्वेकः स्वयमिच्छामि वेदितुम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2127207, "chapter_id": 3728, "verse_number": "४", "content_sanskrit": "स वा प्रवेश्यतां मातर्मां वाऽनुज्ञातुमर्हसि ।\nविदितं वाऽथवाऽज्ञातं पितुर्मे संविधीयताम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2127208, "chapter_id": 3728, "verse_number": "५", "content_sanskrit": "एवमुक्ता तु वैदर्भ्या सा देवी भीममब्रवीत् ।\nदुहितुस्तमभिप्रायमन्वजानाच्च पार्थिवः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2127209, "chapter_id": 3728, "verse_number": "६", "content_sanskrit": "सा वै पित्राऽभ्यनुज्ञाता मात्रा च कुरुनन्दन ।\nनळं प्रवेशयामास यत्र तस्याः प्रतिश्रयः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2127210, "chapter_id": 3728, "verse_number": "७", "content_sanskrit": "तां च दृष्ट्वैव सहसा दमयन्तीं नळो नृपः ।\nआविष्टो दुःखशोकाभ्यां बभूवाश्रुपरिप्लुतः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2127211, "chapter_id": 3728, "verse_number": "८", "content_sanskrit": "ततः काषायवसना जटिला मलपङ्किनी ।\nदमयन्ती महाराज बाहुकं वाक्यमब्रवीत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2127212, "chapter_id": 3728, "verse_number": "९", "content_sanskrit": "दृष्टपूर्वस्त्वया कश्चिद् धर्मज्ञो नाम बाहुक ।\nसुप्तामुत्सृज्य विपिने गतो यः पुरुषः स्त्रियम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2127213, "chapter_id": 3728, "verse_number": "१०", "content_sanskrit": "अनागसीं प्रियां भार्यां विपिने शोककर्शिताम् ।\nअपहाय तां को गच्छेत् पुण्यश्लोकादृते नळात्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2127214, "chapter_id": 3728, "verse_number": "११", "content_sanskrit": "किंनु तस्य मया बाल्यादपराद्धं महीपतेः ।\nयो मामुत्सृज्य विपिने गतवान् निद्रया हृताम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2127215, "chapter_id": 3728, "verse_number": "१२", "content_sanskrit": "साक्षाद् देवानपाहाय वृतो यः स मया किल ।\nअनुव्रतां पतिप्राणां पुत्रिणीं त्यक्तवान् कथम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2127216, "chapter_id": 3728, "verse_number": "१३", "content_sanskrit": "अग्नौ पाणिगृहीतां च हंसानां वचने स्थिताम् ।\nभरिष्यामीति सत्यं च प्रतिश्रुत्य क्व तद्गतम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2127217, "chapter_id": 3728, "verse_number": "", "content_sanskrit": "बृहदश्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2127218, "chapter_id": 3728, "verse_number": "१४", "content_sanskrit": "दमयन्त्या ब्रुवन्त्यास्तु सर्वमेतदरिन्दम ।\nशोकजं वारि नेत्राभ्यामत्युष्णं प्रास्रवद् बहु\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2127219, "chapter_id": 3728, "verse_number": "१५", "content_sanskrit": "अतीव कृष्णताराभ्यां रक्ताभ्यां सलिलं तु तत् ।\nपरिस्रवन्नळो दृष्ट्वा शोकार्त इदमब्रवीत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2127220, "chapter_id": 3728, "verse_number": "", "content_sanskrit": "नळः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2127221, "chapter_id": 3728, "verse_number": "१६", "content_sanskrit": "मम राज्यं प्रनष्टं यन्नाहं तत् कृतवान् स्वयम् ।\nकलिनाऽपकृतं भीरु यच्च त्वामहमत्यजम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2127222, "chapter_id": 3728, "verse_number": "१७", "content_sanskrit": "त्वया तु धर्मकृच्छ्रे तु शापेनाभिहतः पुरा ।\nवनस्थया दुःखितया शोचन्त्या मां विवाससम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2127223, "chapter_id": 3728, "verse_number": "१८", "content_sanskrit": "स मच्छरीरे त्वच्छापाद् दह्यमानोऽवसत् कलिः ।\nत्वच्छापदग्धः सततमग्नाविव समाहितः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2127224, "chapter_id": 3728, "verse_number": "१९", "content_sanskrit": "मम च व्यवसायेन तपसा चैव निर्जितः ।\nदुःखस्यान्तेन चानेन भवितव्यं हि शोभने\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2127225, "chapter_id": 3728, "verse_number": "२०", "content_sanskrit": "विमुच्य मां गतः पापः ततोऽहमिह चागतः ।\nत्वदर्थं विपुलश्रोणि न हि मेऽन्यत् प्रयोजनम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2127226, "chapter_id": 3728, "verse_number": "२१", "content_sanskrit": "कथं नु नारी भर्तारमनुरक्तमनुव्रतम् ।\nउत्सृज्य वरयेदन्यं यथा त्वं भीरु कर्हिचित् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2127227, "chapter_id": 3728, "verse_number": "२२", "content_sanskrit": "दूताश्चरन्ति पृथिवीं कृत्स्नां नृपतिशासनात् ।\nभैमी किलाद्य भर्तारं द्वितीयं वरयिष्यति\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2127228, "chapter_id": 3728, "verse_number": "२३", "content_sanskrit": "स्वैरवृत्त्या यथाकाममनुरूपमिवात्मनः ।\nश्रुत्वैव चैवं त्वरितो भार्गस्वरिरुपस्थितः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2127229, "chapter_id": 3728, "verse_number": "२४", "content_sanskrit": "दमयन्ती तु तच्छ्रुत्वा नळस्य परिदेवितम् ।\nप्राञ्जलिर्वेपमाना च भीता वचनमब्रवीत्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2127230, "chapter_id": 3728, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nवनपर्वणि सप्ततितमोऽध्यायः ॥७०॥ तीर्थयात्रापर्वणि षड्विंशोऽध्यायः ॥२६॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]