[{"id": 7006494000, "chapter_id": 26494, "verse_number": "३-३३-१", "content_sanskrit": "वाराहावतारस्य उपक्रमः जनमेजय उवाच प्रादुर्भावः पुराणेषु विष्णोरमिततेजसः ।\nसतां कथयतां विप्र वाराह इति नः श्रुतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006494001, "chapter_id": 26494, "verse_number": "३-३३-२", "content_sanskrit": "न जानतेऽस्य चरितं न विधिं नैव विस्तरम् ।\nन कर्म गुणवद्भावं न हेतुं न मनीषितम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006494002, "chapter_id": 26494, "verse_number": "३-३३-३", "content_sanskrit": "किमात्मको वराहोऽसौ का मूर्तिः कास्य देवता ।\nकिमाचारः किं प्रभावः किं वा तेन पुरा कृतम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006494003, "chapter_id": 26494, "verse_number": "३-३३-४", "content_sanskrit": "एतन्मे संशयत्वेन वाराहं श्रुतिविस्तरम् ।\nयज्ञार्थं च समेतानां द्विजातीनां महात्मनाम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006494004, "chapter_id": 26494, "verse_number": "३-३३-५", "content_sanskrit": "वैशम्पायन उवाच एतत् ते कथयिष्यामि पुराणं ब्रह्मसम्मितम् ।\nनानाश्रुतिसमायुक्तं कृष्णद्वैपायनेरितम् ।\nमहावराहचरितं कृष्णस्याद्भुतकर्मणः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006494005, "chapter_id": 26494, "verse_number": "३-३३-६", "content_sanskrit": "यथा नारायणो राजन् वाराहं वपुरास्थितः ।\nदंष्ट्र्या गां समुद्रस्थामुज्जहारारिसूदनः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006494006, "chapter_id": 26494, "verse_number": "३-३३-७", "content_sanskrit": "छान्दसीभिरुदाराभिः श्रुतिभिः समलङ्कृतः ।\nशुचिः प्रयत्नवान् भूत्वा निबोध जनमेजय ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006494007, "chapter_id": 26494, "verse_number": "३-३३-८", "content_sanskrit": "इदं पुराणं परमं पुण्यं वेदैश्च सम्मितम् ।\nनानाश्रुतिसमायुक्तं नास्तिकाय न कीर्तयेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006494008, "chapter_id": 26494, "verse_number": "३-३३-९", "content_sanskrit": "पुराणमेतदखिलं सांख्यं योगं तथैव च ।\nकार्त्स्न्येन विधिना प्रोक्तं योऽस्यार्थं ज्ञास्यते पुमान्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006494009, "chapter_id": 26494, "verse_number": "३-३३-१०", "content_sanskrit": "विश्वेदेवास्तथा साध्या रुद्रादित्यास्तथाश्विनौ ।\nप्रजानां पतयश्चैव सप्त चैव महर्षयः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006494010, "chapter_id": 26494, "verse_number": "३-३३-११", "content_sanskrit": "मनःसंकल्पजाश्चैव पूर्वजाश्च महर्षयः ।\nवसवोऽप्सरसश्चैव गन्धर्वा यक्षराक्षसाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006494011, "chapter_id": 26494, "verse_number": "३-३३-१२", "content_sanskrit": "दैत्याः पिशाचा नागाश्च भूतानि विविधानि च ।\nब्राह्मणाः क्षत्रिया वैश्याः शूद्रा म्लेच्छादयो भुवि ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006494012, "chapter_id": 26494, "verse_number": "३-३३-१३", "content_sanskrit": "चतुष्पदानि सर्वाणि तिर्यग्योनिगतानि च ।\nजङ्गमानि च सत्त्वानि यच्चान्यज्जीवसंज्ञितम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006494013, "chapter_id": 26494, "verse_number": "३-३३-१४", "content_sanskrit": "पूर्णे युगसहस्रान्ते ब्राह्मेऽहनि तथागते ।\nनिर्वाणे सर्वभूतानां सर्वोत्पातसमुद्भवे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006494014, "chapter_id": 26494, "verse_number": "३-३३-१५", "content_sanskrit": "हिरण्यरेतास्त्रिशिखस्ततो भूत्वा वृषाकपिः ।\nशिखाभिर्विविधाँल्लोकान् संशोषयति देहिनः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006494015, "chapter_id": 26494, "verse_number": "३-३३-१६", "content_sanskrit": "दह्यमानास्ततस्तस्य तेजोराशिभिरग्रतः ।\nविवर्णवर्णा दग्धाङ्गा हतार्चिष्मद्भिराननैः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006494016, "chapter_id": 26494, "verse_number": "३-३३-१७", "content_sanskrit": "साङ्गोपनिषदा वेदा इतिहासपुरोगमाः ।\nसर्वविद्याश्रयाश्चैव सत्यधर्मपरायणाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006494017, "chapter_id": 26494, "verse_number": "३-३३-१८", "content_sanskrit": "ब्रह्माणमग्रतः कृत्वा छन्दतो विश्वतोमुखम् ।\nसर्वे देवगणाश्चैव त्रयस्त्रिंशच्च कोटयः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006494018, "chapter_id": 26494, "verse_number": "३-३३-१९", "content_sanskrit": "तस्मिन्नहनि सम्प्राप्ते तं हंसं महदक्षरम् ।\nप्रविशन्ति महायोगं हरिं नारायणं प्रभुम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006494019, "chapter_id": 26494, "verse_number": "३-३३-२०", "content_sanskrit": "तेषां भूयः प्रविष्टानां निधनोत्पत्तिरुच्यते ।\nयथा सूर्यस्य सततमुदयास्तमयाविह ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006494020, "chapter_id": 26494, "verse_number": "३-३३-२१", "content_sanskrit": "पूर्णे युगसहस्रान्ते कल्पो निःशेष उच्यते ।\nतस्मिञ्जीवकृतं सर्वं निःशेषमवतिष्ठते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006494021, "chapter_id": 26494, "verse_number": "३-३३-२२", "content_sanskrit": "संहृत्य लोकान् सर्वान् स सदेवासुरपन्नगान् ।\nकृत्वाऽऽत्मगर्भे भगवानास्त एको जगद्गुरुः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006494022, "chapter_id": 26494, "verse_number": "३-३३-२३", "content_sanskrit": "यः स्रष्टा सर्वभूतानां कल्पान्तेषु पुनः पुनः ।\nअव्यक्तः शाश्वतो देवस्तस्य सर्वमिदं जगत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006494023, "chapter_id": 26494, "verse_number": "३-३३-२४", "content_sanskrit": "नष्टार्ककिरणे लोके चन्द्ररश्मिविवर्जिते ।\nत्यक्तभूताग्निपवने क्षीणयज्ञवषट्क्रिये ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006494024, "chapter_id": 26494, "verse_number": "३-३३-२५", "content_sanskrit": "अपक्षिगणसंघाते सर्वप्राण्यचरे पथि ।\nअमर्यादाकुले रौद्रे सर्वतस्तमसावृते ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006494025, "chapter_id": 26494, "verse_number": "३-३३-२६", "content_sanskrit": "अदृश्ये सर्वलोकेऽस्मिन्नभावे सर्वकर्मणाम् ।\nप्रशान्ते सर्वसम्पाते नष्टे वैरपरिग्रहे ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006494026, "chapter_id": 26494, "verse_number": "३-३३-२७", "content_sanskrit": "गते स्वभावसंस्थानं लोके नारायणात्मके ।\nपरमेष्ठी हृषीकेशः शयनायोपचक्रमे ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006494027, "chapter_id": 26494, "verse_number": "३-३३-२८", "content_sanskrit": "पीतवासा लोहिताक्षः कृष्णो जीमूतसंनिभः ।\nशिखासहस्रविकचं जटाभारं समुद्वहन् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006494028, "chapter_id": 26494, "verse_number": "३-३३-२९", "content_sanskrit": "श्रीवत्सकलिलं पुण्यं रक्तचन्दनभूषितम् ।\nवक्षो बिभ्रन्महाबाहुः सविद्युदिव तोयदः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006494029, "chapter_id": 26494, "verse_number": "३-३३-३०", "content_sanskrit": "पुण्डरीकसहस्रस्य मालास्य शुशुभे तदा ।\nपत्नी चैव स्वयं लक्ष्मीर्देहमावृत्य तिष्ठति ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006494030, "chapter_id": 26494, "verse_number": "३-३३-३१", "content_sanskrit": "ततः स्वपिति धर्मात्मा सर्वलोकपितामहः ।\nकिमप्यमितविक्रान्तो निद्रायोगमुपागतः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006494031, "chapter_id": 26494, "verse_number": "३-३३-३२", "content_sanskrit": "ततो वर्षसहस्रे तु पूर्णे स पुरुषोत्तमः ।\nस्वयमेव विभुर्भूत्वा बुध्यते विबुधाधिपः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006494032, "chapter_id": 26494, "verse_number": "३-३३-३३", "content_sanskrit": "ततश्चिन्तयते भूयः सृष्टिं लोकस्य लोककृत् ।\nपितृदेवासुरनरान् पारमेष्ठ्येन कर्मणा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006494033, "chapter_id": 26494, "verse_number": "३-३३-३४", "content_sanskrit": "ततश्चिन्तयते कार्यं देवेषु समितिंजयः ।\nसम्भवं सर्वलोकस्य विदधाति स वाक्पतिः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006494034, "chapter_id": 26494, "verse_number": "३-३३-३५", "content_sanskrit": "कर्ता चैव विकर्ता च संहर्ता च प्रजापतिः ।\nधाता विधाता च तथा संयमो नियमो यमः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006494035, "chapter_id": 26494, "verse_number": "३-३३-३६", "content_sanskrit": "नारायणपरा देवा नारायणपराः क्रियाः ।\nनारायणपरो यज्ञो नारायणपरा श्रुतिः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006494036, "chapter_id": 26494, "verse_number": "३-३३-३७", "content_sanskrit": "नारायणपरो मोक्षो नारायणपरा गतिः ।\nनारायणपरो धर्मो नारायणपरः क्रतुः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006494037, "chapter_id": 26494, "verse_number": "३-३३-३८", "content_sanskrit": "नारायणपरं ज्ञानं नारायणपरं तपः ।\nनारायणपरं सत्यं नारायणपरं पदम् ।\nनागयणपरो देवो न भूतो न भविष्यति ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006494038, "chapter_id": 26494, "verse_number": "३-३३-३९", "content_sanskrit": "स्वयंभूरिति विज्ञेयः स ब्रह्मा भुवनाधिपः ।\nस वायुरिति विज्ञेय एष यज्ञः सनातनः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006494039, "chapter_id": 26494, "verse_number": "३-३३-४०", "content_sanskrit": "सदसच्च स विज्ञेयः स यज्ञः स प्रजाकरः ।\nयद् वेदितव्यं त्रिदशैस्तदेष परिविन्दति ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006494040, "chapter_id": 26494, "verse_number": "३-३३-४१", "content_sanskrit": "यच्च वेद्यं भगवतो देवा अपि न तद् विदुः ।\nप्रजानां पतयः सप्त ऋषयश्च सहामरैः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006494041, "chapter_id": 26494, "verse_number": "३-३३-४२", "content_sanskrit": "नास्यान्तमधिगच्छन्ति ततोऽनन्त इति श्रुतिः ।\nयदस्य परमं रूपं तत्र पश्यन्ति देवताः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006494042, "chapter_id": 26494, "verse_number": "३-३३-४३", "content_sanskrit": "प्रादुर्भावेषु सम्भूतं यत् तदर्चन्ति देवताः ।\nयन्न दर्शितवान् देवः कस्तदन्वेष्टुमर्हति ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006494043, "chapter_id": 26494, "verse_number": "३-३३-४४", "content_sanskrit": "ग्रामणीः सर्वभूतानामग्निमारुतयोर्गतिः ।\nतेजसस्तपसश्चैव निधानममृतस्य च॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006494044, "chapter_id": 26494, "verse_number": "३-३३-४५", "content_sanskrit": "चतुराश्रमवर्णेषु चातुर्होत्रफलाशनः ।\nचतुःसागरपर्यन्तश्चतुर्युगविवर्तकः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006494045, "chapter_id": 26494, "verse_number": "३-३३-४६", "content_sanskrit": "तदेष संहृत्य जगत् कृत्वा गर्भस्थमात्मनः ।\nमुमोचाण्डं महायोगी धृतं वर्षसहस्रिकम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006494046, "chapter_id": 26494, "verse_number": "३-३३-४७", "content_sanskrit": "सुरासुरद्विजभुजगाप्सरोगणैर्महौषधिक्षितिधरयक्षगुह्यकैः ।\nप्रजापतिः श्रुतिधर रक्षसां कुलं तदासृजज्जगदिदमात्मना प्रभुः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]