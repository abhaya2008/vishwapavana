[{"id": 7000543000, "chapter_id": 20543, "verse_number": "५-२-१", "content_sanskrit": "शेष उवाच ।\nअथ तद्दर्शनोत्कण्ठा विह्वलीकृतचेतसा ।\nपुनः पुनः स्मृतो भ्राता भरतो धार्मिकाग्रणीः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000543001, "chapter_id": 20543, "verse_number": "५-२-२", "content_sanskrit": "उवाच च हनूमंतं बलवंतं समीरजम् ।\nप्रस्फुरद्दशनव्याज चन्द्रकांतिहतांधकः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000543002, "chapter_id": 20543, "verse_number": "५-२-३", "content_sanskrit": "शृणु वीर हनूमंस्त्वं मद्गिरं भ्रातृनोदिताम् ।\nचिरंतनवियोगेन गद्गदीकृतविह्वलाम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000543003, "chapter_id": 20543, "verse_number": "५-२-४", "content_sanskrit": "गच्छ तं भ्रातरं वीर समीरणतनूद्भव ।\nमद्वियोगकृशां यष्टिं वपुषो बिभ्रतं हठात् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000543004, "chapter_id": 20543, "verse_number": "५-२-५", "content_sanskrit": "यो वल्कलं परीधत्ते जटां धत्ते शिरोरुहे ।\nफलानां भक्षणमपि न कुर्याद्विरहातुरः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000543005, "chapter_id": 20543, "verse_number": "५-२-६", "content_sanskrit": "परस्त्री यस्य मातेव लोष्टवत्कांचनं पुनः ।\nप्रजाः पुत्रानिवोद्रक्षेद्बांधवो मम धर्मवित् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000543006, "chapter_id": 20543, "verse_number": "५-२-७", "content_sanskrit": "मद्वियोगजदुःखाग्निज्वालादग्धकलेवरम् ।\nमदागमनसंदेश पयोवृष्ट्याशु सिंचतम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000543007, "chapter_id": 20543, "verse_number": "५-२-८", "content_sanskrit": "सीतया सहितं रामं लक्ष्मणेन समन्वितम् ।\nसुग्रीवादिकपींद्रैश्च रक्षोभिः सबिभीषणैः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000543008, "chapter_id": 20543, "verse_number": "५-२-९", "content_sanskrit": "प्राप्तं निवेदय सुखात्पुष्पकासनसंस्थितम् ।\nयेन मे सोऽनुजः शीघ्रं सुखमेति मदागमात् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000543009, "chapter_id": 20543, "verse_number": "५-२-१०", "content_sanskrit": "इति श्रुत्वा ततो वाक्यं रघुवीरस्य धीमतः ।\nजगाम भरतावासं नंदिग्रामं निदेशकृत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000543010, "chapter_id": 20543, "verse_number": "५-२-११", "content_sanskrit": "गत्वा स नंदिग्रामं तु मंत्रिवृद्धैः सुसंयतम् ।\nभरतं भ्रातृविरहक्लिन्नं धीमान्ददर्श ह ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000543011, "chapter_id": 20543, "verse_number": "५-२-१२", "content_sanskrit": "कथयंतं मंत्रिवृद्धान्रामचंद्रकथानकम् ।\nतदीय पदापाथोज मकरंदसुनिर्भरः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000543012, "chapter_id": 20543, "verse_number": "५-२-१३", "content_sanskrit": "नमश्चकार भरतं धर्मं मूर्तियुतं किल ।\nविधात्रा सकलांशेन सत्त्वेनैव विनिर्मितम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000543013, "chapter_id": 20543, "verse_number": "५-२-१४", "content_sanskrit": "तं दृष्ट्वा भरतः शीघ्रं प्रत्युत्थाय कृतांजलि ।\nस्वागतं चेति होवाच रामस्य कुशलं वद ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000543014, "chapter_id": 20543, "verse_number": "५-२-१५", "content_sanskrit": "इत्येवं वदतस्तस्य भुजो दक्षिणतोऽस्फुरत् ।\nहृदयाच्च गतः शोको हर्षास्रैः पूरिताननः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000543015, "chapter_id": 20543, "verse_number": "५-२-१६", "content_sanskrit": "विलोक्य तादृशं भूपं प्रत्युवाच कपीश्वरः ।\nनिकटे हि पुरः प्राप्तं विद्धि रामं सलक्ष्मणम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000543016, "chapter_id": 20543, "verse_number": "५-२-१७", "content_sanskrit": "रामागमनसंदेशामृतसिक्तकलेवरः ।\nप्रापयद्धर्षपूरं हि सहस्रास्यो न वेद्म्यहम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000543017, "chapter_id": 20543, "verse_number": "५-२-१८", "content_sanskrit": "जगाद मम तन्नास्ति यत्तुभ्यं दीयते मया ।\nदासोऽस्मि जन्मपर्यंतं रामसंदेशहारकः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000543018, "chapter_id": 20543, "verse_number": "५-२-१९", "content_sanskrit": "वसिष्ठोऽपि गृहीत्वार्घ्यं मंत्रिवृद्धाः सुहर्षिताः ।\nजग्मुस्ते रामचंद्रं च हनुमद्दर्शिताध्वना ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000543019, "chapter_id": 20543, "verse_number": "५-२-२०", "content_sanskrit": "दृष्ट्वा दूरात्समायांतं रामचंद्रं मनोरमम् ।\nपुष्पकासनमध्यस्थं ससीतं सहलक्ष्मणम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000543020, "chapter_id": 20543, "verse_number": "५-२-२१", "content_sanskrit": "रामोऽपि दृष्ट्वा भरतं पादचारेण संगतम् ।\nजटावल्कलकौपीन परिधानसमन्वितम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000543021, "chapter_id": 20543, "verse_number": "५-२-२२", "content_sanskrit": "अमात्यान्भ्रातृवेषेण समवेषाञ्जटाधरान् ।\nनित्यं तपः क्लिष्टतया कृशरूपान्ददर्श ह ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000543022, "chapter_id": 20543, "verse_number": "५-२-२३", "content_sanskrit": "रामोऽपि चिंतयामास दृष्ट्वा वै तादृशं नृपम् ।\nअहो दशरथस्यायं राजराजस्य धीमतः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000543023, "chapter_id": 20543, "verse_number": "५-२-२४", "content_sanskrit": "पुत्रः पदातिरायाति जटावल्कलवेषभृत् ।\nन दुःखं तादृशं मेऽन्यद्वनमध्यगतस्य हि ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000543024, "chapter_id": 20543, "verse_number": "५-२-२५", "content_sanskrit": "यादृशं मद्वियोगेन चैतस्य परिवर्त्तते ।\nअहो पश्यत मे भ्राता प्राणात्प्रियतमः सखा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000543025, "chapter_id": 20543, "verse_number": "५-२-२६", "content_sanskrit": "श्रुत्वा मां निकटे प्राप्तं मंत्रिवृद्धैः सुहर्षितैः ।\nद्रष्टुं मां भरतोऽभ्येति वसिष्ठेन समन्वितः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000543026, "chapter_id": 20543, "verse_number": "५-२-२७", "content_sanskrit": "इति ब्रुवन्नरपतिः पुष्पकान्नभसोंऽगणात् ।\nबिभीषणहनूमद्भ्यां लक्ष्मणेन कृतादरः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000543027, "chapter_id": 20543, "verse_number": "५-२-२८", "content_sanskrit": "यानादवतताराशु विरहात्क्लिन्नमानसः ।\nभ्रातर्भ्रातः पुनर्भ्रातर्भ्रातर्भ्रातर्वदन्मुहुः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000543028, "chapter_id": 20543, "verse_number": "५-२-२९", "content_sanskrit": "दृष्ट्वा समुत्तीर्णमिमं रामचंद्रं सुरैर्युतम् ।\nभरतो भ्रातृविरहक्लिन्नं धीमान्ददर्श ह ।\nहर्षाश्रूणि प्रमुंचंश्च दंडवत्प्रणनाम ह ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000543029, "chapter_id": 20543, "verse_number": "५-२-३०", "content_sanskrit": "रघुनाथोऽपि तं दृष्ट्वा दंडवत्पतितं भुवि ।\nउत्थाप्य जगृहे दोर्भ्यां हर्षालोकसमन्वितः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000543030, "chapter_id": 20543, "verse_number": "५-२-३१", "content_sanskrit": "उत्थापितोऽपि हि भृशं नोदतिष्ठद्रुदन्मुहुः ।\nरामचंद्रपदांभोजग्रहणासक्तबाहुभृत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000543031, "chapter_id": 20543, "verse_number": "५-२-३२", "content_sanskrit": "भरत उवाच ।\nदुराचारस्य दुष्टस्य पापिनो मे कृपां कुरु ।\nरामचंद्र महाबाहो कारुण्यात्करुणानिधे ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000543032, "chapter_id": 20543, "verse_number": "५-२-३३", "content_sanskrit": "यस्ते विदेहजा पाणिस्पर्शं क्रूरममन्यत ।\nस एव चरणो राम वने बभ्राम मत्कृते ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000543033, "chapter_id": 20543, "verse_number": "५-२-३४", "content_sanskrit": "इत्युक्त्वाश्रुमुखो दीनः परिरभ्य पुनः पुनः ।\nप्रांजलिः पुरतस्तस्थौ हर्षविह्वलिताननः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000543034, "chapter_id": 20543, "verse_number": "५-२-३५", "content_sanskrit": "रघुनाथस्तमनुजं परिष्वज्य कृपानिधिः ।\nप्रणम्य च महामंत्रिमुख्यानापृच्छ्य सादरम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000543035, "chapter_id": 20543, "verse_number": "५-२-३६", "content_sanskrit": "भरतेन समं भ्रात्रा पुष्पकासनमास्थितः ।\nसीतां ददर्श भरतो भ्रातृपत्नीमनिंदिताम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000543036, "chapter_id": 20543, "verse_number": "५-२-३७", "content_sanskrit": "अनसूयामिवात्रेः किं लोपामुद्रां घटोद्भुवः ।\nपतिव्रतां जनकजाममन्यतननाम च ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000543037, "chapter_id": 20543, "verse_number": "५-२-३८", "content_sanskrit": "मातः क्षमस्व यदघं मया कृतमबुद्धिना ।\nत्वत्सदृश्यः पतिपराः सर्वेषां साधुकारिकाः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000543038, "chapter_id": 20543, "verse_number": "५-२-३९", "content_sanskrit": "जानक्यापि महाभागा देवरं वीक्ष्य सादरम् ।\nआशीर्भिरभियुज्याथ समपृच्छदनामयम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000543039, "chapter_id": 20543, "verse_number": "५-२-४०", "content_sanskrit": "विमानवरमारूढास्ते सर्वे नभसोंऽगणे ।\nक्षणादालोकयांचक्रे निकटे स्वपितुः पुरीम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]