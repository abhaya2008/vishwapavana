[{"id": 7003038000, "chapter_id": 23038, "verse_number": "३-१८-१", "content_sanskrit": "नारद उवाच ।\nनारायण महाभाग वेदवेदांगपारग ।\nपृच्छामि त्वामहं किंचिदतिसन्देहवान्यतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003038001, "chapter_id": 23038, "verse_number": "३-१८-२", "content_sanskrit": "सुतस्य त्रिदशेशस्य शंकरस्य महात्मनः ।\nविघ्ननिघ्नस्य यद्विघ्नमीश्वरस्य कथं प्रभो ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003038002, "chapter_id": 23038, "verse_number": "३-१८-३", "content_sanskrit": "परिपूर्णतमः श्रीमान्परमात्मा परात्परः ।\nगोलोकनाथः स्वांशेन पार्वतीतनयः स्वयम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003038003, "chapter_id": 23038, "verse_number": "३-१८-४", "content_sanskrit": "अहो भगवतस्तस्य मस्तकच्छेदनं विभो ।\nग्रहदृष्ट्या ग्रहेशस्य कथं मे वक्तुमर्हसि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003038004, "chapter_id": 23038, "verse_number": "३-१८-५", "content_sanskrit": "नारायण उवाच ।\nसावधानं शृणु ब्रह्मन्नितिहासं पुरातनम् ।\nविघ्नेशस्य बभूवेदं विघ्नं येन च नारद ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003038005, "chapter_id": 23038, "verse_number": "३-१८-६", "content_sanskrit": "एकदा शंकरः सूर्य्यं जघान परमष्टधा ।\nसुमालिमालिहन्तारं शूलेन बहुवत्सलः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003038006, "chapter_id": 23038, "verse_number": "३-१८-७", "content_sanskrit": "श्रीसूर्य्योऽमोघशूलेनाशनितुल्येन तेजसा ।\nजहौ स चेतनां सद्यो रथाच्च निपपात ह ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003038007, "chapter_id": 23038, "verse_number": "३-१८-८", "content_sanskrit": "ददर्श कश्यपः पुत्रं मृतमुत्तानलोचनम् ।\nकृत्वा वक्षसि तं शोकाद्विललाप भृशं मुहुः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003038008, "chapter_id": 23038, "verse_number": "३-१८-९", "content_sanskrit": "हाहाकारं सुराश्चक्रुर्विलेपुर्भयकातराः ।\nअन्धीभूतं जगत्सर्वं बभूव तमसा वृतम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003038009, "chapter_id": 23038, "verse_number": "३-१८-१०", "content_sanskrit": "निष्प्रभं तनयं दृष्ट्वा चाशपत्कश्यपः शिवम् ।\nतपस्वी ब्रह्मणः पौत्रः प्रज्वन्ब्रह्मतेजसा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003038010, "chapter_id": 23038, "verse_number": "३-१८-११", "content_sanskrit": "मत्पुत्रस्य यथा वक्षश्छिन्नं शूलेन तेऽद्य वै ।\nत्वत्पुत्रस्य शिरश्छिन्नं भविष्यति न संशयः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003038011, "chapter_id": 23038, "verse_number": "३-१८-१२", "content_sanskrit": "शिवश्च गलितक्रोधः क्षणेनैवाशुतोषकः ।\nब्रह्मज्ञानेन तत्पूर्णं जीवयामास तत्क्षणात् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003038012, "chapter_id": 23038, "verse_number": "३-१८-१३", "content_sanskrit": "ब्रह्मविष्णुमहेशानामंशश्च त्रिगुणात्मकः ।\nसूर्य्यश्च चेतनां प्राप्य समुत्तस्थौ पितुः पुरः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003038013, "chapter_id": 23038, "verse_number": "३-१८-१४", "content_sanskrit": "ननाम पितरं भक्त्या शंकरं भक्तवत्सलः ।\nविज्ञाय शम्भोः शापं च कश्यपं स चुकोप ह ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003038014, "chapter_id": 23038, "verse_number": "३-१८-१५", "content_sanskrit": "विषयान्नैव जग्राह कोपेनैवमुवाच ह ।\nविषयांश्च परित्यज्य भजे श्रीकृष्णमीश्वरम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003038015, "chapter_id": 23038, "verse_number": "३-१८-१६", "content_sanskrit": "सर्वं तुच्छमनित्यं च नश्वरं चेश्वरं विना ।\nविहाय मङ्गलं सत्यं विद्वान्नेच्छेदमंगलम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003038016, "chapter_id": 23038, "verse_number": "३-१८-१७", "content_sanskrit": "देवैश्च प्रेरितो ब्रह्मा समागत्य ससम्भ्रमः ।\nबोधयित्वा रविं तत्र युयोज विषयेष्वजः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003038017, "chapter_id": 23038, "verse_number": "३-१८-१८", "content_sanskrit": "तस्मै दत्त्वाऽऽशिषश्शम्भुर्ब्रह्मा च स्वालयं मुदा ।\nजगाम कश्यपश्चैव स्वराशिं रविरेव च ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003038018, "chapter_id": 23038, "verse_number": "३-१८-१९", "content_sanskrit": "अथ माली सुमाली च व्याधिग्रस्तौ बभूवतुः ।\nश्वित्रौ गलितसर्वांगौ शक्तिहीनौ हतप्रभौ ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003038019, "chapter_id": 23038, "verse_number": "३-१८-२०", "content_sanskrit": "तावुवाच स्वयं ब्रह्मा युवां च भजतां रविम् ।\nसूर्य्यकोपेन मलिनौ युवामेवं हतप्रभौ ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003038020, "chapter_id": 23038, "verse_number": "३-१८-२१", "content_sanskrit": "सूर्य्यस्य कवचं स्तोत्रं सर्वपूजाविधिं विधिः ।\nजगाम कथयित्वा तौ ब्रह्मलोकं सनातनः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003038021, "chapter_id": 23038, "verse_number": "३-१८-२२", "content_sanskrit": "ततस्तौ पुष्करं गत्वा सिषेवाते रविं मुने ।\nस्नात्वा त्रिकालं भक्त्या च जपन्तौ मन्त्रमुत्तमम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003038022, "chapter_id": 23038, "verse_number": "३-१८-२३", "content_sanskrit": "ततः सूर्य्याद्वरं प्राप्य निजरूपौ बभूवतुः ।\nइत्येवं कथितं सर्वं किं भयः श्रोतुमिच्छसि ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]