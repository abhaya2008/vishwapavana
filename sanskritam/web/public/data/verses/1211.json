[{"id": 2010444, "chapter_id": 1211, "verse_number": "१-२१२-०x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2010445, "chapter_id": 1211, "verse_number": "१-२१२-१", "content_sanskrit": "मा भूद्राजंस्तव तापो मनस्थः\nपञ्चानां भार्या दुहिता ममेति।\nमातुरेषा प्रार्थिता स्यात्तदानीं\nपञ्चानां भार्या दुहिता ममेति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2010446, "chapter_id": 1211, "verse_number": "१-२१२-२", "content_sanskrit": "याजोपयाजौ धर्मरतौ तपोभ्यां\nतौ चक्रतुः पञ्चपतित्वमस्याः।\nतत्पञ्चभिः पाण्डुसुतैरवाप्ता\nभार्या कृष्णा मोदतां वै कुलं ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2010447, "chapter_id": 1211, "verse_number": "१-२१२-३", "content_sanskrit": "लोके नान्यो विद्यते त्वद्विशिष्टः\nसर्वारीणामप्रधृष्योऽसि राजन्।\nभूयस्त्विदं शृणु मे त्वं विशोको\nयथाऽऽगतं पञ्चपत्नीत्वमस्याः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2010448, "chapter_id": 1211, "verse_number": "१-२१२-४", "content_sanskrit": "एषा नालायनी पूर्वं मौद्गल्यं स्थविरं पतिम्।\nआराधयामास तदा कुष्ठिनं तमनिन्दिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2010449, "chapter_id": 1211, "verse_number": "१-२१२-५", "content_sanskrit": "त्वगस्थिभूतं कटुकं लोलमीर्ष्युं सुकोपनम्।\nसुगन्धेतरगन्धाढ्यं वलीपलितमूर्धजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2010450, "chapter_id": 1211, "verse_number": "१-२१२-६", "content_sanskrit": "स्थविरं विकृताकारं शीर्यमाणनखत्वचम्।\nउच्छिष्टमुपभुञ्जाना पर्युपास्ते महामुनिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2010451, "chapter_id": 1211, "verse_number": "१-२१२-७", "content_sanskrit": "ततः कदाचिदङ्गुष्ठो भुञ्जानस्य व्यशीर्यत।\nअन्नादुद्धृत्य तच्चान्नमुपभुङ्क्तेऽविशङ्किता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2010452, "chapter_id": 1211, "verse_number": "१-२१२-८", "content_sanskrit": "तेन तस्याः प्रसन्नेन कामव्याहारिणा तदा।\nवरं वृणीष्वेत्यसकृदुक्ता वव्रे वरं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2010453, "chapter_id": 1211, "verse_number": "१-२१२-९x", "content_sanskrit": "मौद्गल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2010454, "chapter_id": 1211, "verse_number": "१-२१२-९", "content_sanskrit": "नाहं वृद्धो न कटुको नेर्व्यावान्नैव कोपनः।\nन च दुर्गन्धवदनो न कृशो न च लोलुपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2010455, "chapter_id": 1211, "verse_number": "१-२१२-१०", "content_sanskrit": "कथं त्वां रमयामीह कथं त्वां वासयाम्यहम्।\nवद कल्याणि भद्रं ते यथा त्वं मनसेच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2010456, "chapter_id": 1211, "verse_number": "१-२१२-११x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2010457, "chapter_id": 1211, "verse_number": "१-२१२-११", "content_sanskrit": "सा तमक्लिष्टकर्माणं वरदं सर्वकामदम्।\nभर्तारमनवद्याङ्गी प्रसन्नं प्रत्युवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2010458, "chapter_id": 1211, "verse_number": "१-२१२-१२x", "content_sanskrit": "नालायन्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2010459, "chapter_id": 1211, "verse_number": "१-२१२-१२", "content_sanskrit": "पञ्चधा प्रविभक्तात्मा भगवांल्लोकविश्रुतः।\nरमय त्वमचिन्त्यात्मन्पुनश्चैकत्वमागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2010460, "chapter_id": 1211, "verse_number": "१-२१२-१३", "content_sanskrit": "तां तथेत्यब्रवीद्धीमान्महर्षिर्वै महातपाः।\nस पञ्चधा तु भूत्वा तां रमयामास सर्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2010461, "chapter_id": 1211, "verse_number": "१-२१२-१४", "content_sanskrit": "नालायनीं सुकेशान्तां मौद्गल्यश्चारुहासिनीम्।\nआश्रमेष्वधिकं चापि पूज्यमानो महर्षिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2010462, "chapter_id": 1211, "verse_number": "१-२१२-१५", "content_sanskrit": "स चचार यथाकामं कामरूपवपुः पुनः।\nयदा ययौ दिवं चापि तत्र देवर्षिभिः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2010463, "chapter_id": 1211, "verse_number": "१-२१२-१६", "content_sanskrit": "चचार सोऽमृताहारः सुरलोके चचार ह।\nपूज्यमानस्तथा शच्या शक्रस्य भवनेष्वपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2010464, "chapter_id": 1211, "verse_number": "१-२१२-१७", "content_sanskrit": "महेन्द्रसेनया सार्धं पर्यधावद्रिरंसया।\nसूर्यस्य च रथं दिव्यमारुह्य भगवान्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2010465, "chapter_id": 1211, "verse_number": "१-२१२-१८", "content_sanskrit": "पर्युपेत्य पुनर्मेरु मेरौ वासमरोचयत्।\nआकाशगङ्गामाप्लुत्य तया सह तपोधनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2010466, "chapter_id": 1211, "verse_number": "१-२१२-१९", "content_sanskrit": "रश्मिजालेषु चन्द्रस्य उवाच च यथाऽनिलः।\nगिरिरूपधरो योगी स महर्षिस्तदा पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2010467, "chapter_id": 1211, "verse_number": "१-२१२-२०", "content_sanskrit": "तत्प्रभावेन सा तस्य मध्ये जज्ञे महानदी।\nयदा पुष्पाकुलः सालः संजज्ञे भगवानृषिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2010468, "chapter_id": 1211, "verse_number": "१-२१२-२१", "content_sanskrit": "लतात्वमनुसंपेदे तमेवाभ्यनुवेष्टती।\nपुपोष च वपुर्यस्य तस्य तस्यानुगं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2010469, "chapter_id": 1211, "verse_number": "१-२१२-२२", "content_sanskrit": "सा पुपोष समं भर्त्रा स्कन्धेनापि चचार ह।\nततस्तस्य च तस्याश्च तुल्या प्रीतिरवर्धत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2010470, "chapter_id": 1211, "verse_number": "१-२१२-२३", "content_sanskrit": "तथा सा भगवांस्तस्याः प्रसादादृषिसत्तमः।\nविरराम च सा चैव दैवयोगेन भामिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2010471, "chapter_id": 1211, "verse_number": "१-२१२-२४", "content_sanskrit": "स च तां तपसा देवीं रमयामास योगतः।\nएकपत्नी तथा भूत्वा सदैवाग्रे यशस्विनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2010472, "chapter_id": 1211, "verse_number": "१-२१२-२५", "content_sanskrit": "अरुन्धतीव सीतेव बभूवातिपतिव्रता।\nदमयन्त्याश्च मातुः स विशेषमधिकं ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2010473, "chapter_id": 1211, "verse_number": "१-२१२-२६", "content_sanskrit": "एतत्तथ्यं महाराज मा ते भूद्बुद्धिरन्यथा।\nसा वै नालायनी जज्ञे दैवयोगेन केनचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2010474, "chapter_id": 1211, "verse_number": "१-२१२-२७", "content_sanskrit": "राजंस्तवात्मजा कृष्णा वेद्यां तेजस्विनी शुभा।\nतस्मिंस्तस्या मनः सक्तं न चचाल कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2010475, "chapter_id": 1211, "verse_number": "१-२१२-२८", "content_sanskrit": "तथा प्रणिहितो ह्यात्मा तस्यास्तस्मिन्द्विजोत्तमे॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2010476, "chapter_id": 1211, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि वैवाहिकपर्वणि द्वादशाधिकद्विशततमोऽध्यायः॥ २१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]