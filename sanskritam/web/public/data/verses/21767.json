[{"id": 7001767000, "chapter_id": 21767, "verse_number": "२-२८-१", "content_sanskrit": "काष्ठीलोवाच ।\nराक्षसं धावमानं तु कालांतकयमोपमम् ।\nदृष्ट्वा सा राक्षसी प्राह भर्तारं मम शंकिता ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001767001, "chapter_id": 21767, "verse_number": "२-२८-२", "content_sanskrit": "प्रक्षिपस्वानलप्रख्यां शक्तिं हेमविभूषिताम् ।\nममायं पंचतां यातु दिगंबररिपुप्रिय ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001767002, "chapter_id": 21767, "verse_number": "२-२८-३", "content_sanskrit": "तस्या वाक्यान्मम पतिः पौरुषे तु व्यवस्थितः ।\nमुमोच विपुलां शक्तिं रक्षोवक्षस्थल प्रति ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001767003, "chapter_id": 21767, "verse_number": "२-२८-४", "content_sanskrit": "ज्वलंती ज्वलनप्रख्या द्योतयंती दिशो दश ।\nदिव्यांशुतीक्ष्ण वक्त्राता किंकिणीशतनादिता ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001767004, "chapter_id": 21767, "verse_number": "२-२८-५", "content_sanskrit": "रक्तचंदनलिप्तांगी रक्तवस्त्रोपशोभिता ।\nहृदि तस्य निपत्यासौ शक्तिर्विप्रकरच्युता ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001767005, "chapter_id": 21767, "verse_number": "२-२८-६", "content_sanskrit": "कृत्वा भस्मावशेषं तु राक्षसं गगनं ययौ ।\nपातयित्वा स्वभर्तारं विप्रहस्तेन राक्षसी ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001767006, "chapter_id": 21767, "verse_number": "२-२८-७", "content_sanskrit": "कृतकृत्यमिवात्मानं मेने हृष्टतनूरुहा ।\nअथोवाच द्विजं हृष्टा राक्षसी शुभलोचनम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001767007, "chapter_id": 21767, "verse_number": "२-२८-८", "content_sanskrit": "एहि कांत गुहां रम्यां प्रविश त्वं यदृच्छया ।\nभुंक्ष्व भोगान्मया सार्द्धं ये दिव्या ये च मानुषाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001767008, "chapter_id": 21767, "verse_number": "२-२८-९", "content_sanskrit": "तथेति प्राणनाथो मे प्राहहृष्टवपुस्तदा ।\nततः सादाय मे कांतं स्वां प्रविष्टा गुहां मुदा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001767009, "chapter_id": 21767, "verse_number": "२-२८-१०", "content_sanskrit": "असंवीक्ष्यैव तद्भस्म भर्तृदेहसमुद्भवम् ।\nकुचाभ्यामुन्नताभ्यां सा मद्भर्तारमपीडयत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001767010, "chapter_id": 21767, "verse_number": "२-२८-११", "content_sanskrit": "दर्शयामास तां तन्वीं कुमारीं शयने स्थिताम् ।\nइयं तेनासितापांगी बिम्बोष्ठी कांचनप्रभा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001767011, "chapter_id": 21767, "verse_number": "२-२८-१२", "content_sanskrit": "भार्यार्थे समुपानीता वाराणस्या द्विजोत्तम ।\nयस्याः सीमां न लंघंति पातकानि ह्यशेषतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001767012, "chapter_id": 21767, "verse_number": "२-२८-१३", "content_sanskrit": "शक्तिक्षेत्रं च तां प्राहुः पुण्यं पापक्षयंकरम् ।\nया गृहं त्रिपुरारेश्च पञ्चगव्यूतिसंस्थिता ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001767013, "chapter_id": 21767, "verse_number": "२-२८-१४", "content_sanskrit": "यस्यां मृताः पुनर्मर्त्या गर्भवासं विशंति न ।\nस त्वमस्या गृहं पित्र्यं पुनर्नय सुलोचनाम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001767014, "chapter_id": 21767, "verse_number": "२-२८-१५", "content_sanskrit": "इमानि तव रत्नानि शयनान्यासनानि च ।\nमया सह समस्तानि विक्रीणीहि निजेच्छया ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001767015, "chapter_id": 21767, "verse_number": "२-२८-१६", "content_sanskrit": "त्वदर्थे राक्षसो घोरो मया ब्रह्मन्निषूदितः ।\nमुग्धया तव रूपेण प्रेषितो यमसादनम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001767016, "chapter_id": 21767, "verse_number": "२-२८-१७", "content_sanskrit": "तस्मान्ममोपिरि विभो कृत्वा विश्वासमात्मना ।\nभजस्व मां विशालाक्ष भक्तां वै कामरूपिणीम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001767017, "chapter_id": 21767, "verse_number": "२-२८-१८", "content_sanskrit": "एतच्छ्रुत्वा तु वचनं भर्ता मे चारुलोचने ।\nराक्षस्याः कामतप्तायाः कुमार्याः सन्निधौ शुभे ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001767018, "chapter_id": 21767, "verse_number": "२-२८-१९", "content_sanskrit": "उवाच राक्षसीं तां तु सशंको मधुरं वचः ।\nसुभगे नीतिशास्त्रेषु विश्वस्तव्या न योषितः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001767019, "chapter_id": 21767, "verse_number": "२-२८-२०", "content_sanskrit": "कौमारं या पतिं हन्ति सा कथं मां न हिंसति ।\nमत्तो रूपाधिकं मत्वा परं पुरुषलंपटा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001767020, "chapter_id": 21767, "verse_number": "२-२८-२१", "content_sanskrit": "सोऽहं विश्वासभावेन विश्वस्तस्ते वरानने ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001767021, "chapter_id": 21767, "verse_number": "२-२८-२२", "content_sanskrit": "अद्य वाथ परेद्युर्वा पक्षे मासेऽथ वत्सरे ।\nव्यापादय यथेच्छं वा त्वां प्रपन्नोऽस्मि भामिनि ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001767022, "chapter_id": 21767, "verse_number": "२-२८-२३", "content_sanskrit": "एवमेव त्वया कार्यं नाद्य चोपकृतं तव ।\nआत्मा ते सर्वथा देयः प्रतीकारस्य हेतवे ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001767023, "chapter_id": 21767, "verse_number": "२-२८-२४", "content_sanskrit": "मदर्थे निहतो भर्ता त्वया निःशंकया यतः ।\nततोऽहं नोत्तरं वच्मि परं किंचित्सुलोचने ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001767024, "chapter_id": 21767, "verse_number": "२-२८-२५", "content_sanskrit": "तच्छ्रुत्वा वचनं तस्य मद्भर्तुः साब्रवीदिदम् ।\nविश्वस्तहिंसनं ब्रह्मन् ब्रह्महत्या समं भवेत् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001767025, "chapter_id": 21767, "verse_number": "२-२८-२६", "content_sanskrit": "यद्येवं राक्षसीं क्रूरां मन्यसे पतिघातिनीम् ।\nपतिं तथापि गर्हेयं विश्वस्तं घातये कथम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001767026, "chapter_id": 21767, "verse_number": "२-२८-२७", "content_sanskrit": "सूक्ष्मा हि धर्मस्य गतिर्न ज्ञायेत कथंचन ।\nकेनापि कुत्रचिद्देवदैत्यराक्षसकादिना ।\nकेचिन्मनुष्याः पटवो धर्मसूक्ष्मत्वचिंतने ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001767027, "chapter_id": 21767, "verse_number": "२-२८-२८", "content_sanskrit": "येऽनित्येन शरीरेण नैष्कर्म्यं साधयंत्युत ।\nश्रूयते च पुराणेषु किंचिदत्र निगद्यते ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001767028, "chapter_id": 21767, "verse_number": "२-२८-२९", "content_sanskrit": "धर्मस्यैवानुकूल्येन विष्णुना प्रभविष्णुना ।\nदशावतारग्रहणे दुःखं प्राप्तमनेकधा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001767029, "chapter_id": 21767, "verse_number": "२-२८-३०", "content_sanskrit": "क्व सीतार्थं श्रीनिवासो रामो लक्ष्मणसंयुतः ।\nविलापं कुरुते नागपाशबन्धादिकर्मसु ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001767030, "chapter_id": 21767, "verse_number": "२-२८-३१", "content_sanskrit": "क्व देवदेवो वसुदेवसूनुर्विज्ञानरूपो निखलप्रपंची ।\nहा कष्टमित्यस्रदृगादिचेष्टः पार्थोग्रसनादिकभृत्यकृत्यः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001767031, "chapter_id": 21767, "verse_number": "२-२८-३२", "content_sanskrit": "ईशस्य कृत्यं द्विज दुर्विभाव्यं धर्मानुकूल्येन समास्थितस्य ।\nव्यासः स्वयं वेदविभागकर्त्ता पाराशरिस्तत्त्वदृगिज्यमूर्तिः ।\nकन्यात्वविध्वसकवीर्यजन्मा कानीनसंज्ञोऽनुजदारगामी ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001767032, "chapter_id": 21767, "verse_number": "२-२८-३३", "content_sanskrit": "परिवेत्ता च दिधिषूः शन्तनुः स्वःसरित्पत्तिः ।\nदिधिषू तनयः साक्षाद्वसुः स्त्रीवादमृत्युभाक् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001767033, "chapter_id": 21767, "verse_number": "२-२८-३४", "content_sanskrit": "ये गोलकसुताः कुण्डाः पांडवाः समयोनिगाः ।\nतेषां संकीर्तनं पुण्यं पवित्रं पापनाशनम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001767034, "chapter_id": 21767, "verse_number": "२-२८-३५", "content_sanskrit": "यं ध्यायंति स्मरंत्यद्धा योगमूर्तिः सनातनः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001767035, "chapter_id": 21767, "verse_number": "२-२८-३६", "content_sanskrit": "विष्णुर्वेश्यासमासक्तः प्रह्लादाद्युपदेशकृत् ।\nश्रीनृसिंहोऽसुरध्वंसी देवदेवाधिदैवतम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001767036, "chapter_id": 21767, "verse_number": "२-२८-३७", "content_sanskrit": "संसारवासनाध्वंसी देवदेवाधिदैवतम् ।\nसंसारवासनाध्वंसी स्वर्णाक्षभवनस्थितिः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001767037, "chapter_id": 21767, "verse_number": "२-२८-३८", "content_sanskrit": "जामदग्न्यः स्वयं सिद्धस्तपसा दग्धकिल्बिषः ।\nईश्वरः क्षत्रसंहारभ्रूणहत्यादिकर्मकृत् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001767038, "chapter_id": 21767, "verse_number": "२-२८-३९", "content_sanskrit": "स्वयमेवर्षभो योगी लोकशिक्षापरो द्विजः ।\nलोकग्लानिकरो जातः कुर्वन्धर्मानुरोधतः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001767039, "chapter_id": 21767, "verse_number": "२-२८-४०", "content_sanskrit": "नारदो नारदो भूयो भूयो भूयोऽपि नारदः ।\nनारायणपरो नारो नरो नरहितोऽमरः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001767040, "chapter_id": 21767, "verse_number": "२-२८-४१", "content_sanskrit": "गौतमो गौतमो विप्र गोपचेष्टापरायणः ।\nवेदबाह्यार्थसंयुक्तशास्त्री वेदोपकार कृत् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001767041, "chapter_id": 21767, "verse_number": "२-२८-४२", "content_sanskrit": "वसुष्ठश्चोर्वशीजातोऽगस्त्योऽपि स्वयमीश्वरौ ।\nयेन लोकोपकारार्थं वासिष्ठं शास्त्रमुत्तमम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001767042, "chapter_id": 21767, "verse_number": "२-२८-४३", "content_sanskrit": "कृतं यस्मिन्पुराणानि वेदाः साम्यत्वमागताः ।\nयः स्वयं रामचन्द्रस्य गुरुः सर्वेश्वरस्य च ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001767043, "chapter_id": 21767, "verse_number": "२-२८-४४", "content_sanskrit": "स कथं गाधिजाशप्तस्तिर्यग्योनिमुपागमत् ।\nयो दमित्वा विभुर्विंध्यं वातापिं सागरं स्थितः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001767044, "chapter_id": 21767, "verse_number": "२-२८-४५", "content_sanskrit": "स कथं मृतकादाता दुष्करं समुपासते ।\nयो विधिः कर्मसाक्ष्यादिवन्द्यो मान्यः पितामहः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001767045, "chapter_id": 21767, "verse_number": "२-२८-४६", "content_sanskrit": "मोहिनीमोहितो देहमुत्ससर्ज कथं स च ।\nयः शिवः शिवदः साक्षात्प्रकृतीशः परात्परः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001767046, "chapter_id": 21767, "verse_number": "२-२८-४७", "content_sanskrit": "स कथं देवपत्नीगः श्मशानाशुभचेष्टितः ।\nतस्माद्द्विज सदाचारो निषेव्यो विधिना विधिः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001767047, "chapter_id": 21767, "verse_number": "२-२८-४८", "content_sanskrit": "तमहंभावनायुक्तो नो हेयाद्यो विदां वरः ।\nस शांतिमाप्नुयादग्र्यां धम्यामुभयसंस्थिताम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001767048, "chapter_id": 21767, "verse_number": "२-२८-४९", "content_sanskrit": "आपवर्ग्यः स्मृतो धर्मो धनं धर्मैकसाधनम् ।\nतन्मया साधितो धर्मः सर्वोत्तमधनात्मना ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001767049, "chapter_id": 21767, "verse_number": "२-२८-५०", "content_sanskrit": "श्रृणु विप्रात्र धर्मस्य गतिं सूक्ष्मां वदाम्यहम् ।\nयदा समागतो भर्ता मम कन्यां समाहरन् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001767050, "chapter_id": 21767, "verse_number": "२-२८-५१", "content_sanskrit": "त्वां पश्यन् निजकर्मस्थं कोऽपि दोषो न तस्य वै ।\nमया पृष्टः कथं नाम कन्येयं समुपाहृता ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001767051, "chapter_id": 21767, "verse_number": "२-२८-५२", "content_sanskrit": "तदा तेन मृषा वाक्यमुक्तं मद्भक्षणार्थकम् ।\nतन्निशम्याह मां बद्धा स्वयं चास्थानि दर्शनात् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001767052, "chapter_id": 21767, "verse_number": "२-२८-५३", "content_sanskrit": "ये वदंति च दांपत्ये भार्या मोक्षविरोधिनी ।\nन ते तत्त्वदृशो ज्ञेया न सा भार्या विरोधिनी ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001767053, "chapter_id": 21767, "verse_number": "२-२८-५४", "content_sanskrit": "भार्या समुद्धरेत्पापात्पतंतं निरये पतिम् ।\nसा भार्यान्या कर्मवल्लीरूपा संसारदायीनी ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001767054, "chapter_id": 21767, "verse_number": "२-२८-५५", "content_sanskrit": "पापं किमत्र तन्मत्तः सम्यक्छृणु स्वयं वर ।\nअलीकं नैव वक्तव्यं प्राणैः कंठगतैरपि ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001767055, "chapter_id": 21767, "verse_number": "२-२८-५६", "content_sanskrit": "सत्यमेवाचरेत्सत्ये साक्षाद्धर्मे व्यवस्थितः ।\nसत्ये समास्थितो ब्रह्मा सत्ये सन्तः समास्थिताः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001767056, "chapter_id": 21767, "verse_number": "२-२८-५७", "content_sanskrit": "सत्ये समास्थितं विश्वं सर्वदा सचराचरम् ।\nसत्यं ब्रूयादिति वचो वेदांतेषु प्रगीयते ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001767057, "chapter_id": 21767, "verse_number": "२-२८-५८", "content_sanskrit": "सत्यं ब्रह्मस्वरूपं हि तत्सत्यमभिधीमहि ।\nसत्यं तु सर्वदा विप्र मंगलं मंगलप्रदम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001767058, "chapter_id": 21767, "verse_number": "२-२८-५९", "content_sanskrit": "असत्यमात्मक्षयदं सद्यः प्रत्ययकारकम् ।\nस्त्रीषु सत्यं न वक्तव्यं तत्रापि श्रृणु कारणम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001767059, "chapter_id": 21767, "verse_number": "२-२८-६०", "content_sanskrit": "निधिं स्त्रियै न कथयेदित्यादौ दोषवारणम् ।\nउक्तं तद्धर्मजनकं धर्मसूक्ष्मत्वदर्शकम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001767060, "chapter_id": 21767, "verse_number": "२-२८-६१", "content_sanskrit": "कुशा द्विजा जलं वह्निर्वेदा भूकालदिक्सुराः ।\nसाक्ष्ये यत्र विवाहेषु दांपत्यं तदुदीरितम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001767061, "chapter_id": 21767, "verse_number": "२-२८-६२", "content_sanskrit": "समंगीकरणं कर्म विवाहे तु विधीयते ।\nस्त्रीपुंसोर्द्विजसंस्कारे निर्दिष्टं गुरुशिष्ययोः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001767062, "chapter_id": 21767, "verse_number": "२-२८-६३", "content_sanskrit": "तस्मात्परस्परं ज्ञेयो गुरुशिष्यौ वधूवरौ ।\nनानयोरणुमात्रोऽपि भेदो बोध्यो विजानता ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001767063, "chapter_id": 21767, "verse_number": "२-२८-६४", "content_sanskrit": "तत्तत्कर्मानुरूपत्वात्प्राधान्यस्त्रीनियोज्ययोः ।\nक्वचिद्व्यत्ययदोषश्चेद्दैवमेवात्र कारणम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001767064, "chapter_id": 21767, "verse_number": "२-२८-६५", "content_sanskrit": "दैवाधीनं जगत्सर्वं सदेवासुरमानुषम् ।\nदैवं तत्पूर्वजन्मानि संचिताः कर्मवासनाः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001767065, "chapter_id": 21767, "verse_number": "२-२८-६६", "content_sanskrit": "प्राप्तं निषेवन्नन्योन्यं वर्तते कामकारकम् ।\nशुभं वाप्यशुभं विप्र तं तु शांतं विदुर्बुधाः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001767066, "chapter_id": 21767, "verse_number": "२-२८-६७", "content_sanskrit": "शांतः सत्यसमाचारो जंतुर्लोकप्रतारकः ।\nएवमादि विदित्वा तु नायं भर्ता निपातितः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001767067, "chapter_id": 21767, "verse_number": "२-२८-६८", "content_sanskrit": "कन्यात्वध्वंसकात्पापात्पूतो मदुपकारतः ।\nगतिं प्रयातः कृतिनां त्वद्धस्तविनिपातितः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001767068, "chapter_id": 21767, "verse_number": "२-२८-६९", "content_sanskrit": "मया तूपकृतं पत्ये जानंत्या धर्मसूक्ष्मताम् ।\nत्वत्प्राणरक्षणे धर्मो ममाभूद्द्विजसत्तम ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001767069, "chapter_id": 21767, "verse_number": "२-२८-७०", "content_sanskrit": "तेन धर्मेण किं प्राप्तमिति सम्यङ्निबोध मे ।\nराक्षसीं योनिमापन्ना राक्षसस्य प्रिया ह्यहम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001767070, "chapter_id": 21767, "verse_number": "२-२८-७१", "content_sanskrit": "कामरूपा ब्राह्मणी तु संजाता धर्मकारणात् ।\nधर्मकामदुघा धेनुः संतोषो नंदनं वनम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001767071, "chapter_id": 21767, "verse_number": "२-२८-७२", "content_sanskrit": "विद्या मोक्षकरी प्रोक्ता तृष्णा वैतरणी नदी ।\nवैतरण्यां पतन्भर्ता मयोद्धृत इहाभवत् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001767072, "chapter_id": 21767, "verse_number": "२-२८-७३", "content_sanskrit": "अस्याश्चोपकृतं विप्र वर्णोत्तमनिवेशनात् ।\nइयं त्वसंगिनी भार्या भविष्यति पितुर्गृहे ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001767073, "chapter_id": 21767, "verse_number": "२-२८-७४", "content_sanskrit": "अहं तवास्याश्च सदा रक्षिका धर्मबोधिनी ।\nमत्संगमात्पूर्वमेव या भार्या विप्र तेऽभवत् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001767074, "chapter_id": 21767, "verse_number": "२-२८-७५", "content_sanskrit": "इयं त्वत्संगिनी भार्या भविष्यति वरानना ।\nसापि तिर्यग्गतिं प्राप्य मुच्यते मदनुग्रहात् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001767075, "chapter_id": 21767, "verse_number": "२-२८-७६", "content_sanskrit": "अहं पुरा भवेऽभूवं रमणी लोकसुन्दरी ।\nकंदलीति च विख्याता तनयौर्वमुनेर्द्विज ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001767076, "chapter_id": 21767, "verse_number": "२-२८-७७", "content_sanskrit": "तपः प्रभावात्संजाता यमला मिथुनंधरा ।\nपुरुषो मे सहभवो दमितो धर्मकारणात् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001767077, "chapter_id": 21767, "verse_number": "२-२८-७८", "content_sanskrit": "तेनैवौर्वेण शिष्टाहं दत्ता दुर्वाससे भवम् ।\nतं पतिं प्राप्य विप्रेंद्र प्राक्कर्मवशागा ह्यहम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001767078, "chapter_id": 21767, "verse_number": "२-२८-७९", "content_sanskrit": "कलहाभिरता पत्या शप्ता भस्मत्वमागता ।\nकिंचित्पापावशेषेण राक्षसीं योनिमागता ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001767079, "chapter_id": 21767, "verse_number": "२-२८-८०", "content_sanskrit": "तत्र योनौ मया लब्धो भर्तायं राक्षसाधिपः ।\nगोभिलो नाम तेजस्वी स त्वया विनिपातितः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001767080, "chapter_id": 21767, "verse_number": "२-२८-८१", "content_sanskrit": "शोपोऽस्य पूर्ववयसिबभूव द्विजसत्तम ।\nकस्याश्चिद्राजकन्यायाः स्त्रियाऽऽरब्धा मृतिस्तव ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001767081, "chapter_id": 21767, "verse_number": "२-२८-८२", "content_sanskrit": "अहं तु राक्षसीभावरहिता पूर्वकर्मणः ।\nशुभस्य बलमापन्ना जाता तव सहायिनी ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001767082, "chapter_id": 21767, "verse_number": "२-२८-८३", "content_sanskrit": "दुःखिताहं कृता भर्त्रा कुमार्याहरणात्पुरा ।\nभार्याथ पापिना ब्रह्मंस्तेन व्यापादितो मया ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7001767083, "chapter_id": 21767, "verse_number": "२-२८-८४", "content_sanskrit": "विश्वस्तो हि यतस्त्वं वै मम सर्वेण चेतसा ।\nततस्त्वां गोपयिष्यामि सर्वभावेन कामुक ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7001767084, "chapter_id": 21767, "verse_number": "२-२८-८५", "content_sanskrit": "एष ते शपथः सत्यः पंचभूतोपसाक्षिकः ।\nकृत्स्नस्य पुरुषस्येह सन्निधौ व्याहृतो मया ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7001767085, "chapter_id": 21767, "verse_number": "२-२८-८६", "content_sanskrit": "न करोषि द्विजश्रेष्ठ संविदं ह्यन्यथा क्वचित् ।\nमद्वाक्ये भवता स्थेयं सर्वकृत्येषु मानद ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7001767086, "chapter_id": 21767, "verse_number": "२-२८-८७", "content_sanskrit": "एतच्छ्रुत्वा तु वचनं राक्षस्या परिभाषितम् ।\nप्रतिपेदे वचः सर्वं यत्कृतं हि तया तदा ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7001767087, "chapter_id": 21767, "verse_number": "२-२८-८८", "content_sanskrit": "ततः सा राक्षसी सर्वं संप्रगृह्य गुहाधनम् ।\nकरेणुरूपिणी भूत्वा पृष्ठे कृत्वा पतिं मम ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7001767088, "chapter_id": 21767, "verse_number": "२-२८-८९", "content_sanskrit": "तया सह विशालाक्ष्या रत्नावल्या मुदान्विता ।\nययावाकाशमार्गेण काशीमभि मुलोचने ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}]