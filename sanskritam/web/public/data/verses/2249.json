[{"id": 2057699, "chapter_id": 2249, "verse_number": "७-१७६-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2057700, "chapter_id": 2249, "verse_number": "७-१७६-१", "content_sanskrit": "यत्तद्वैकर्तनः कर्णो राक्षसश्च घटोत्कचः।\nनिशीथे समसज्जेतां तद्युद्धमभवत्कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2057701, "chapter_id": 2249, "verse_number": "७-१७६-२", "content_sanskrit": "कीदृशं चाभवद्रूपं तस्य घोरस्य रक्षसः।\nयेन वैकर्तनः कर्णः सङ्ग्रामे तेन निर्जितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2057702, "chapter_id": 2249, "verse_number": "७-१७६-३", "content_sanskrit": "रथश्च कीदृशस्तस्य मायाः सर्वायुधानि च।\nकिम्प्रमाणा हयास्तस्य रथकेतुर्धनुस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2057703, "chapter_id": 2249, "verse_number": "७-१७६-४", "content_sanskrit": "कीदृशं वर्म चैवास्य शिरस्त्राणं च कीदृशम्।\nपृष्टस्त्वमेतदाचक्ष्व कुशलो ह्यसि सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2057704, "chapter_id": 2249, "verse_number": "७-१७६-५x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2057705, "chapter_id": 2249, "verse_number": "७-१७६-५", "content_sanskrit": "लोहितोक्षो महाकायस्ताम्रास्यो निम्नितोदरः।\nऊर्ध्वरोमा हरिश्मश्रुः शङ्कुकर्णो महाहनुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2057706, "chapter_id": 2249, "verse_number": "७-१७६-६", "content_sanskrit": "आकर्णदारितास्यश्च तीक्ष्णदंष्ट्रः करालवान्।\nसुदीर्घताम्रजिह्वोष्ठो लम्बभ्रूः स्थूलनासिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2057707, "chapter_id": 2249, "verse_number": "७-१७६-७", "content_sanskrit": "नीलाङ्गो लोहितग्रीवो गिरिवर्ष्मा भयङ्करः।\nमहाकायो महाबाहुर्महाशीर्षो महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2057708, "chapter_id": 2249, "verse_number": "७-१७६-८", "content_sanskrit": "विकृतः परुषस्पर्शो विकचोद्वृद्धपिण्डकः।\nस्थूलस्फिग्गूढनाभिश्च शिथिलोपचयो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2057709, "chapter_id": 2249, "verse_number": "७-१७६-९", "content_sanskrit": "तथैव हस्ताभरणी महामायोऽङ्गदी तथा।\nउरसाऽधारयन्निष्कमग्निमालां यथाऽचलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2057710, "chapter_id": 2249, "verse_number": "७-१७६-१०", "content_sanskrit": "तस्य हेममयं चित्रं बहुरूपाङ्गशभितम्।\nतोरणप्रतिमं शुभ्रं किरीटं मूर्ध्न्यशोभत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2057711, "chapter_id": 2249, "verse_number": "७-१७६-११", "content_sanskrit": "कुण्डले बालसूर्याभे मालां हेममयीं शुभाम्।\nधारयन्विपुलं कांस्यं कवचं च महाप्रभम्।\nताराजालनिभं राजन्पूर्णचन्द्रसमप्रभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2057712, "chapter_id": 2249, "verse_number": "७-१७६-१२", "content_sanskrit": "कण्ठसूत्रं महच्चापि तपनीयमधारयत्।\nस तेन विभ्राजत वै सविद्युदिव तोयदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2057713, "chapter_id": 2249, "verse_number": "७-१७६-१३", "content_sanskrit": "किङ्किणीशतनिर्घोपं रक्तध्वजपताकिनम्।\nऋक्षचर्मावनद्वाङ्गं नल्वमात्रं महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2057714, "chapter_id": 2249, "verse_number": "७-१७६-१४", "content_sanskrit": "सर्वायुधवरोपेतमास्थितं ध्वजमालिनम्।\nअष्टचक्रसमायुक्तं मेघगम्भीरनिःस्वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2057715, "chapter_id": 2249, "verse_number": "७-१७६-१५", "content_sanskrit": "मत्तमातङ्गसङ्काशा लोहिताक्षा विभीपणाः।\nकालवर्णासमायुक्ता बलवन्तः शतं हयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2057716, "chapter_id": 2249, "verse_number": "७-१७६-१६", "content_sanskrit": "वहन्तो राक्षसं घोरं वालवन्तो जितश्रमाः।\nविपुलाभिः सटाभिस्ते हेषमाणा मुहुर्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2057717, "chapter_id": 2249, "verse_number": "७-१७६-१७", "content_sanskrit": "मुखैर्नानाविधाकारैर्वगवन्तो हयोत्तमाः।\nरथेऽस्य युक्ता गकर्जन्तोऽवहंस्ते राक्षसाधिपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2057718, "chapter_id": 2249, "verse_number": "७-१७६-१८", "content_sanskrit": "राक्षसोऽस्य विरूपाक्षः सूतो दीप्तास्यकुण्डलः।\n`घोररूपो महाकायः करालो विकृताननः।\nरश्मिभिः सूर्यरश्म्याह्वैः सञ्जग्राह हयान्रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2057719, "chapter_id": 2249, "verse_number": "७-१७६-१९", "content_sanskrit": "स तेन सहितस्तस्थावरुणेन यथा रविः।\nसंसक्त इव चाभ्रेण यथाऽद्रिर्महता महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2057720, "chapter_id": 2249, "verse_number": "७-१७६-२०", "content_sanskrit": "दिवस्पृक्सुमहान्केतुः स्यन्दनेऽस्य समुच्छ्रितः।\nरक्तोत्तमाङ्गः क्रव्यादो गृध्रः परमभीषणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2057721, "chapter_id": 2249, "verse_number": "७-१७६-२१", "content_sanskrit": "वासवाशनिनिर्घोषं दृढज्यमतिविक्षिपन्।\nव्यक्तं किष्कुपरीणाहं द्वादशारत्नि कार्मुकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2057722, "chapter_id": 2249, "verse_number": "७-१७६-२२", "content_sanskrit": "रथाक्षमात्रैरिपुभिः सर्वाः प्रच्छादयन्दिशः।\nतस्यां वीरापहारिण्यां निशायां कर्णमभ्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2057723, "chapter_id": 2249, "verse_number": "७-१७६-२३", "content_sanskrit": "तस्य विक्षिपतश्चापं रथे विष्टभ्य तिष्ठतः।\nअश्रूयत धनुर्घोषो विस्फूर्जितमिवाशनेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2057724, "chapter_id": 2249, "verse_number": "७-१७६-२४", "content_sanskrit": "तेन वित्रास्यमानानि तव सैन्यानि भारत।\nसमकम्पन्त सर्वाणि सिन्धोरिव महोर्मयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2057725, "chapter_id": 2249, "verse_number": "७-१७६-२५", "content_sanskrit": "तमापतन्तं सम्प्रेक्ष्य विरूपाक्षं विभीषणम्।\nउत्स्मयन्निव राधेयस्त्वरमाणोऽभ्यवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2057726, "chapter_id": 2249, "verse_number": "७-१७६-२६", "content_sanskrit": "ततः कर्णोऽभ्ययादेनमस्यन्नस्यन्तमन्तिकात्।\nमातङ्ग इव मातङ्गं यूथर्षभमिवर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2057727, "chapter_id": 2249, "verse_number": "७-१७६-२७", "content_sanskrit": "स सन्निपातस्तुमुलस्तयोरासीद्विशाम्पते।\nकर्णराक्षसयो राजन्निन्द्रशम्बरयोरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2057728, "chapter_id": 2249, "verse_number": "७-१७६-२८", "content_sanskrit": "तौ प्रगृह्य महावेगे धनुषी भीमनिःस्वने।\nप्राच्छादयेतामन्योन्यं तक्षमाणौ महेषुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2057729, "chapter_id": 2249, "verse_number": "७-१७६-२९", "content_sanskrit": "ततः पूर्णायतोत्सृष्टैरिषुभिर्नतपर्वभिः।\nन्यवारयेतामन्योन्यं कांस्ये निर्भिद्य वर्मणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2057730, "chapter_id": 2249, "verse_number": "७-१७६-३०", "content_sanskrit": "तौ नखैरिव शार्दूलौ दन्तैरिव महाद्विपौ।\nरथशक्तिभिरन्योन्यं विशिखैश्च ततक्षतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2057731, "chapter_id": 2249, "verse_number": "७-१७६-३१", "content_sanskrit": "सञ्छिन्दन्तौ च गात्राणि सन्दधानौ च सायकान्।\nदहन्तौ च शरोल्काभिर्दुष्प्रेक्ष्यौ च बभूवतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2057732, "chapter_id": 2249, "verse_number": "७-१७६-३२", "content_sanskrit": "तौ तु विक्षतसर्वाङ्गौ रुधिरौघपरिप्लुतौ।\nविभ्राजेतां यथा वारि स्रवन्तौ गैरिकाचलौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2057733, "chapter_id": 2249, "verse_number": "७-१७६-३३", "content_sanskrit": "तौ शराग्रविनुन्नाङ्गौ निर्भिन्दन्तौ परस्परम्।\nनाकम्पयेतामन्योन्यं यतमानौ महाद्युती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2057734, "chapter_id": 2249, "verse_number": "७-१७६-३४", "content_sanskrit": "तत्प्रवृत्तं निशायुद्धं चिरं सममिवाभवत्।\nप्राणयोर्दीव्यतो राजन्कर्णराक्षसयोर्मृधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2057735, "chapter_id": 2249, "verse_number": "७-१७६-३५", "content_sanskrit": "तस्य सन्दधतस्तीक्ष्णाञ्छरांश्चासक्तमस्यतः।\nधनुर्घोषेण वित्रस्ताः स्वे परे च तदाऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2057736, "chapter_id": 2249, "verse_number": "७-१७६-३६", "content_sanskrit": "घटोत्कचं यदा कर्णो विशेषयति नो नृप।\nततः प्रादुष्करोद्दिव्यमस्त्रमस्त्रविदां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2057737, "chapter_id": 2249, "verse_number": "७-१७६-३७", "content_sanskrit": "कर्णेन सन्धितं दृष्ट्वा दिव्यमस्त्रं घटोत्कचः।\nप्रादुश्चक्रे महामायां राक्षसीं पाण्डुनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2057738, "chapter_id": 2249, "verse_number": "७-१७६-३८", "content_sanskrit": "शूलमुद्गरधारिण्या शैलपादपहस्तया।\nरक्षसां घोररूपाणां महत्या सेनया वृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2057739, "chapter_id": 2249, "verse_number": "७-१७६-३९", "content_sanskrit": "तमुद्यतमहाचापं दृष्ट्वा ते व्यथिता नृपाः।\nभूतान्तकमिवायान्तं कालदण्डोग्रधारिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2057740, "chapter_id": 2249, "verse_number": "७-१७६-४०", "content_sanskrit": "घटोत्कचप्रयुक्तेन सिंहनादेन भीषिताः।\nप्रसुस्रुवुर्गजा मूत्रं विव्यधुश्च नरा भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2057741, "chapter_id": 2249, "verse_number": "७-१७६-४१", "content_sanskrit": "ततोऽश्मवृष्टिरत्युग्रा महत्यासीत्समन्ततः।\nअर्धरात्रेऽधिकबलैर्विमुक्ता रक्षसां बलैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2057742, "chapter_id": 2249, "verse_number": "७-१७६-४२", "content_sanskrit": "आयसानि च चक्राणि भुशुण़्ड्यः शक्तितोमराः।\nपतन्त्यविरलाः शूलाः शतघ्न्यः पट्टसास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2057743, "chapter_id": 2249, "verse_number": "७-१७६-४३", "content_sanskrit": "तदुग्रमतिरौद्रं च दृष्ट्वा युद्धं नराधिप।\nपुत्राश्च तव योधाश्च व्यथिता विप्रदुद्रुवुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2057744, "chapter_id": 2249, "verse_number": "७-१७६-४४", "content_sanskrit": "तत्रैकोऽस्तबलश्लाघी कर्णो मानी न विव्यथे।\nव्यधमच्च शरैर्मायां तां घटोत्कचनिर्मिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2057745, "chapter_id": 2249, "verse_number": "७-१७६-४५", "content_sanskrit": "मायायां तु प्रहीणायाममर्षाच्च घटोत्कचः।\nविससर्ज शरान्धोरान्सूत पुत्रं त आविशन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2057746, "chapter_id": 2249, "verse_number": "७-१७६-४६", "content_sanskrit": "ततस्ते रुधिराभ्यक्ता भित्त्वा कर्णं महाहवे।\nविविशुर्धरणीं बाणाः सङ्क्रुद्धा इव पन्नगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2057747, "chapter_id": 2249, "verse_number": "७-१७६-४७", "content_sanskrit": "सूतपुत्रस्तु सङ्क्रद्धो लघुहस्तः प्रतापवान्।\nघटोत्कचमतिक्रम्य बिभेद दशभिः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2057748, "chapter_id": 2249, "verse_number": "७-१७६-४८", "content_sanskrit": "घटोत्कचो विनिर्भिन्नः सूतपुत्रेण मर्मसु।\nचक्रं दिव्यं सहस्रारमगृह्णाद्व्यथितो भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2057749, "chapter_id": 2249, "verse_number": "७-१७६-४९", "content_sanskrit": "क्षुरान्तं बालसूर्याभं मणिरत्नविभूषितम्।\nचिक्षेपाधिरथेः क्रुद्धो भैमसेनिर्जिघांसया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2057750, "chapter_id": 2249, "verse_number": "७-१७६-५०", "content_sanskrit": "प्रविद्वमतिवेगेन विक्षिप्तं कर्णसायकैः।\nअभाग्यस्येव सङ्कल्पस्तन्मोघमपतद्भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2057751, "chapter_id": 2249, "verse_number": "७-१७६-५१", "content_sanskrit": "घटोत्कचस्तु सङ्क्रुद्धो दृष्ट्वा चक्रं निपातितम्।\nकर्णं प्राच्छादयद्बाणैः स्वर्भानुरिव भास्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2057752, "chapter_id": 2249, "verse_number": "७-१७६-५२", "content_sanskrit": "सूतपुत्रस्त्वसम्भ्रान्तो रुद्रोपेन्द्रेन्द्रविक्रमः।\nघटोत्कचरथं तूर्णं छादयामास पत्रिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2057753, "chapter_id": 2249, "verse_number": "७-१७६-५३", "content_sanskrit": "घटोत्कचेन क्रुद्धेन गदा हेमाङ्गदा तदा।\nक्षिप्ता भ्राम्य शरैः साऽपि कर्णेनाभ्याहताऽपतत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2057754, "chapter_id": 2249, "verse_number": "७-१७६-५४", "content_sanskrit": "ततोऽन्तरिक्षमुत्पत्य कालमेघ इवोन्नदन्।\nप्रववर्ष महाकायो द्रुमवर्षं नभस्तलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2057755, "chapter_id": 2249, "verse_number": "७-१७६-५५", "content_sanskrit": "ततो मायाविनं कर्णो भीमसेनसुतं दिवि।\nमार्गणैरभिविव्याध घनं सूर्य इवांशुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2057756, "chapter_id": 2249, "verse_number": "७-१७६-५६", "content_sanskrit": "तस्य सर्वान्हयान्हत्वा सञ्छिद्य शतधा रथम्।\nअभ्यवर्षच्छरैः कर्णः पर्जन्य इव वृष्टिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2057757, "chapter_id": 2249, "verse_number": "७-१७६-५७", "content_sanskrit": "न चास्यासीदनिर्भिन्नं गात्रे द्व्यङ्गुलमन्तरम्।\nसोऽदृश्यत मुहूर्तेन श्वाविच्छललितो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2057758, "chapter_id": 2249, "verse_number": "७-१७६-५८", "content_sanskrit": "न हयान्न रथं तस्य न ध्वजं न घटोत्कचम्।\nदृष्टवन्तः स्म समरे शरौघैरभिसंवृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2057759, "chapter_id": 2249, "verse_number": "७-१७६-५९", "content_sanskrit": "स तु कर्णस्य तद्दिव्यमस्त्रमस्त्रेण शातयन्।\nमायायुद्धेन मायावी सूतपुत्रमयोधयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2057760, "chapter_id": 2249, "verse_number": "७-१७६-६०", "content_sanskrit": "सोऽयोधयत्तदा कर्णं मायया लाघवेन च।\nअलक्ष्यमाणानि दिवि शरजालानि चापतन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2057761, "chapter_id": 2249, "verse_number": "७-१७६-६१", "content_sanskrit": "भैमसेनिर्महामायो मायया कुरुसत्तम।\nविचचार महाकायो मोहयन्निव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2057762, "chapter_id": 2249, "verse_number": "७-१७६-६२", "content_sanskrit": "स तु कृत्वा विरूपाणि वदनान्यशुभानि च।\nअग्रसत्सूतपुत्रस्य दिव्यान्यस्त्राणि मायया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2057763, "chapter_id": 2249, "verse_number": "७-१७६-६३", "content_sanskrit": "पुनश्चापि महाकायः सञ्छिन्नः शतधा रणे।\nगतसत्वो निरुत्साहः पतितः खाद्व्यदृश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2057764, "chapter_id": 2249, "verse_number": "७-१७६-६४", "content_sanskrit": "तं हतं मन्यमानाः स्म प्राणदन्कुरुपुङ्गवाः।\nअथ देहैर्नवैरन्यैर्दिक्षु सर्वास्वदृश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2057765, "chapter_id": 2249, "verse_number": "७-१७६-६५", "content_sanskrit": "पुनश्चापि महाकायः शतशीर्षः शतोदरः।\nव्यदृश्यत महाबाहुर्मैनाक इव पर्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2057766, "chapter_id": 2249, "verse_number": "७-१७६-६६", "content_sanskrit": "अङ्गुष्ठमात्रो भूत्वा च पुनरेव स राक्षसः।\nसागरोर्मिरिवोद्वूतस्तिर्यगूर्ध्वमवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2057767, "chapter_id": 2249, "verse_number": "७-१७६-६७", "content_sanskrit": "वसुधां दारयित्वा च पुनरप्यु न्यमज्जत।\nअदृश्यत तदा तत्र पुनरुन्मज्जितोऽन्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2057768, "chapter_id": 2249, "verse_number": "७-१७६-६८", "content_sanskrit": "सोऽवतीर्य पुनस्तस्थौ रथे हेमपरिष्कृते।\nक्षितिं खं च दिशश्चैव माययाऽभ्येत्य दंशितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2057769, "chapter_id": 2249, "verse_number": "७-१७६-६९", "content_sanskrit": "गत्वा कर्णरथाभ्याशं व्यचरत्कुण्डलाननः।\nप्राह वाक्यमसम्भ्रान्तः सूतपुत्रं विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2057770, "chapter_id": 2249, "verse_number": "७-१७६-७०", "content_sanskrit": "तिष्ठेदानीं क्व मे जीवन्सूतपुत्र गमिष्यसि।\nयुद्धश्रद्धामहं तेऽद्य विनेष्यामि रमाजिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2057771, "chapter_id": 2249, "verse_number": "७-१७६-७१", "content_sanskrit": "इत्युक्त्वा रोषताम्राक्षं रक्षः क्रूरपराक्रमम्।\nउत्पपातान्तरिक्षं च जहास च सुविस्तरम्।\nकर्णमभ्यहनच्चैव गजेन्द्रमिव केसरी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2057772, "chapter_id": 2249, "verse_number": "७-१७६-७२", "content_sanskrit": "रथाक्षमात्रेरिषुभिरभ्यवर्षद्धटोत्कचः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2057773, "chapter_id": 2249, "verse_number": "७-१७६-७३", "content_sanskrit": "शरवृष्टिं च तां कर्णो दूरात्प्राप्तामशातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2057774, "chapter_id": 2249, "verse_number": "७-१७६-७४", "content_sanskrit": "दृष्ट्वा च विहतां मायां कर्णेन भरतर्षभ।\nघटोत्कचस्ततो मायां ससर्जान्तर्हितः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2057775, "chapter_id": 2249, "verse_number": "७-१७६-७५", "content_sanskrit": "सोऽभवद्गिरिरत्युच्चः शिखरैस्तरुसङ्कटैः।\nशूलप्रासासिमुसलजलप्रस्रवणो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2057776, "chapter_id": 2249, "verse_number": "७-१७६-७६", "content_sanskrit": "तमञ्जनचयप्रख्यं कर्णो दृष्ट्वा महीधरम्।\nप्रपातैरायुधान्युग्राण्युद्वहन्तं न चुक्षुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2057777, "chapter_id": 2249, "verse_number": "७-१७६-७७", "content_sanskrit": "स्मयन्निव ततः कर्णो दिव्यमस्त्रमुदैरयत्।\nततः सोऽस्रेण शैलेन्द्रो विक्षिप्तो वै व्यनश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2057778, "chapter_id": 2249, "verse_number": "७-१७६-७८", "content_sanskrit": "ततः स तोयदो भूत्वा नीलः सेन्द्रायुधो दिवि।\nअश्मवृष्टिभिरत्युग्रः सूतपुत्रमवाकिरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2057779, "chapter_id": 2249, "verse_number": "७-१७६-७९", "content_sanskrit": "अथ सन्धाय वायव्यमस्त्रमस्त्रविदां वरः।\nव्यधमत्कालमेघं तं कर्णो वैकर्तनो वृषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2057780, "chapter_id": 2249, "verse_number": "७-१७६-८०", "content_sanskrit": "स मार्गणगणैः कर्णो दिशः प्रच्छाद्य सर्वशः।\nजघानास्त्रं महाराज घटोत्कचसमीरितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2057781, "chapter_id": 2249, "verse_number": "७-१७६-८१", "content_sanskrit": "ततः प्रहस्य समरे भैमसेनिर्महाबलः।\nप्रादुश्चक्रे महामायां कर्णं प्रति महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2057782, "chapter_id": 2249, "verse_number": "७-१७६-८२", "content_sanskrit": "स दृष्ट्वा पुनरायान्तं रथेन रथिनां वरम्।\nघटोत्कचमसम्भ्रान्तं राक्षसैर्बहुभिर्वृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2057783, "chapter_id": 2249, "verse_number": "७-१७६-८२", "content_sanskrit": "सिंहशार्दूलसदृशैर्मत्तमातङ्गविक्रमैः।\nगजस्थैश्च रथस्थैश्च वाजिपृष्ठगतैस्तथा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2057784, "chapter_id": 2249, "verse_number": "७-१७६-८३", "content_sanskrit": "नानाशस्त्रधरैर्घोरैर्नानाकवचभूषणैः॥\nवृतं घटोत्कचं क्रूरैर्मरुद्भिरिव वासवम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2057785, "chapter_id": 2249, "verse_number": "७-१७६-८४", "content_sanskrit": "दृष्ट्वा कर्णो महेष्वासो योधयामास राक्षसम्॥\nघटोत्कचस्ततः कर्णं विद्धा पञ्चभिराशुगैः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2057786, "chapter_id": 2249, "verse_number": "७-१७६-८५", "content_sanskrit": "ननाद भैरवं नादं भीषयन्सर्वपार्थिवान्॥\nभूयश्चाञ्जलिकेनाथ स मार्गणगणं महत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2057787, "chapter_id": 2249, "verse_number": "७-१७६-८६", "content_sanskrit": "कर्णहस्तस्थितं चापं चिच्छेदाशु घटोत्कचः॥\nअथान्यद्धनुरादाय दृढं भारसहं महत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2057788, "chapter_id": 2249, "verse_number": "७-१७६-८७", "content_sanskrit": "विचकर्ष बलात्कर्ण इन्द्रायुधमिवोच्छ्रितम्॥\nततः कर्णो महाराज प्रेषयामास सायकान्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2057789, "chapter_id": 2249, "verse_number": "७-१७६-८८", "content_sanskrit": "सुवर्णपुङ्खाञ्छत्रुघ्नान्खेचरान्राक्षसान्प्रति॥\nतद्बाणैरर्दितं यूथं रक्षसां पीनवक्षसाम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2057790, "chapter_id": 2249, "verse_number": "७-१७६-८९", "content_sanskrit": "सिंहेनेवार्दितं वन्यं गजानामाकुलं कुलम्॥\nविधम्य राक्षसान्बाणैः साश्वसूतगजान्विभुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2057791, "chapter_id": 2249, "verse_number": "७-१७६-९०", "content_sanskrit": "ददाह भगवान्वह्निर्भूतानीव युगक्षये॥\nस हत्वा राक्षसीं सेनां शुशुभे सूतनन्दनः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2057792, "chapter_id": 2249, "verse_number": "७-१७६-९१", "content_sanskrit": "पुरेव त्रिपुरं दग्ध्वा दिवि देवो महेश्वरः॥\nतेषु राजसहस्रेषु पाण्डवेयेषु मारिष।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2057793, "chapter_id": 2249, "verse_number": "७-१७६-९२", "content_sanskrit": "नैनं निरीक्षितुमपि कश्चिच्छक्नोति पार्थिव॥\nऋते घटोत्कचाद्राजन्राक्षसेन्द्रान्महाबलात्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2057794, "chapter_id": 2249, "verse_number": "७-१७६-९३", "content_sanskrit": "भीमवीर्यबलोपेतात्क्रुद्ध्द्वैवस्वतादिव॥\nतस्य क्रुद्धस्य नेत्राभ्यां पावकः समजायत।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2057795, "chapter_id": 2249, "verse_number": "७-१७६-९४", "content_sanskrit": "महोल्काभ्यां यथा राजन्सार्जिषः स्नेहबिन्दवः॥\nतलं तलेन संहत्य सन्दश्य दशनच्छदम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2057796, "chapter_id": 2249, "verse_number": "७-१७६-९५", "content_sanskrit": "रथमास्थाय च पुनर्मायया निर्मितं तदा॥\nयुक्तं गजनिभैर्वाहैः पिशाचवदनैः खरैः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2057797, "chapter_id": 2249, "verse_number": "७-१७६-९६", "content_sanskrit": "स सूतमब्रवीत्क्रुद्धः सूतपुत्राय मां वह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2057798, "chapter_id": 2249, "verse_number": "७-१७६-९७", "content_sanskrit": "स ययौ घोररूपेण रथेन रथिनां वरः।\nद्वैरथं सूतपुत्रेण पुनरेव विशाम्पते॥\nस चिक्षेप पुनः क्रुद्धः सुतपुत्राय राक्षसः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2057799, "chapter_id": 2249, "verse_number": "७-१७६-९८", "content_sanskrit": "अष्टचक्रां महाघोरामशनिं रुद्रनिर्मिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2057800, "chapter_id": 2249, "verse_number": "७-१७६-९९", "content_sanskrit": "द्वियोजनसमुत्सेधां योजनायामविस्तराम्।\nआयसीं निचितां शूलैः कदम्बमिव केशरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2057801, "chapter_id": 2249, "verse_number": "७-१७६-१००", "content_sanskrit": "तामवप्लुत्य जग्राह कर्णो न्यस्य महद्धनुः।\nचिक्षेप चैनां तस्यैव स्यन्दनात्सोऽवपुप्लुवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2057802, "chapter_id": 2249, "verse_number": "७-१७६-१०१", "content_sanskrit": "साश्वसूतध्वजं यानं भस्म कृत्वा महाप्रभा।\nविवेश वसुधां भित्त्वा सुरास्तत्र विसिस्मियुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2057803, "chapter_id": 2249, "verse_number": "७-१७६-१०२", "content_sanskrit": "कर्णं तु सर्वभूतानि पूजयामासुरञ्जसा।\nयदप्लुत्य जग्राह देवसृष्टां महाशनिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2057804, "chapter_id": 2249, "verse_number": "७-१७६-१०३", "content_sanskrit": "एवं कृत्वा रणे कर्ण आरुरोह रथं पुनः।\nततो मुमोच नाराचान्सूतपुत्रः परन्तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2057805, "chapter_id": 2249, "verse_number": "७-१७६-१०४", "content_sanskrit": "अशक्यं कर्तुमन्येन सर्वभूतेषु मानद।\nयदकार्षीत्तदा कर्णः सङ्ग्रामे भीमदर्शने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2057806, "chapter_id": 2249, "verse_number": "७-१७६-१०५", "content_sanskrit": "स हन्यमानो नाराचैर्धाराभिरिव पर्वतः।\nगन्धर्वनगराकारः पुनरन्तरधीयत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2057807, "chapter_id": 2249, "verse_number": "७-१७६-१०६", "content_sanskrit": "एवं स वै महाकायो मायया लाघवेन च।\nअस्त्राणि तानि दिव्यानि जघान रिपुसूदनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2057808, "chapter_id": 2249, "verse_number": "७-१७६-१०७", "content_sanskrit": "निहन्यमानेष्वस्त्रेषु मायया तेन रक्षसा।\nअसम्भ्रान्तस्तदा कर्णस्तद्रक्षः प्रत्ययुध्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2057809, "chapter_id": 2249, "verse_number": "७-१७६-१०८", "content_sanskrit": "ततः क्रुद्धो महाराज भैमसेनिर्महाबलः।\nचकार बहुधाऽऽत्मानं भीषयाणो महारथान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2057810, "chapter_id": 2249, "verse_number": "७-१७६-१०९", "content_sanskrit": "ततो दिग्भ्यः समापेतुः सिंहव्याघ्रतरक्षवः।\nअग्निजिह्वाश्च भुजगा विहगाश्चाप्ययोमुखाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2057811, "chapter_id": 2249, "verse_number": "७-१७६-११०", "content_sanskrit": "स कीर्यमाणो विशिखैः कर्णचापच्युतैः शरैः।\nनागराडिव दुष्प्रेक्ष्यस्तत्रैवान्तरधीयत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2057812, "chapter_id": 2249, "verse_number": "७-१७६-१११", "content_sanskrit": "राक्षसाश्च पिशाचाश्च यातुधानास्तथैव च।\nशालावृकाश्च बहवो वृकाश्च विकृताननाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2057813, "chapter_id": 2249, "verse_number": "७-१७६-११२", "content_sanskrit": "ते कर्णं क्षपयिष्यन्तः सर्वतः समुपाद्रवन्।\nअथैनं वाग्भिरुग्राभिस्त्रासयाञ्चिक्रिरे तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2057814, "chapter_id": 2249, "verse_number": "७-१७६-११३", "content_sanskrit": "उद्यतैर्बहुभिर्घोरैरायुधैः शोणितोक्षितैः।\nतेषामनेकैरेकैकं कर्णो विव्याध सायकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2057815, "chapter_id": 2249, "verse_number": "७-१७६-११४", "content_sanskrit": "प्रतिहत्य तु तां मायां दिव्येनास्त्रेण राक्षसीम्।\nआजघान हयानस्य शरैः सन्नतपर्वभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2057816, "chapter_id": 2249, "verse_number": "७-१७६-११५", "content_sanskrit": "ते भग्ना विक्षताङ्गाश्च भिन्नपृष्ठाश्च सायकैः।\nवसुधामन्वपद्यन्त पश्यतस्तस्य रक्षसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2057817, "chapter_id": 2249, "verse_number": "७-१७६-११६", "content_sanskrit": "स भग्नमायो हैडिम्बिः कर्णं वैकर्तनं तदा।\nएष ते विदधे मृत्युमित्युक्त्वान्तरधीयत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2057818, "chapter_id": 2249, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि घटोत्कचवधपर्वणि चतुर्दशरात्रियुद्धे षट्सप्तत्यधिकशततमोऽध्यायः॥ १७६ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१७६-५ निम्नितोदरः निम्नितं पृष्ठवंशसंलग्नमशनहीनस्येवोदरं यस्येत्यर्थः॥ ५-१७६-६ करालवान् उन्नतदन्तचतुष्कः॥ ५-१७६-८ विकचश्चासावुद्वृपिण्डो दृढाङ्गः को मूर्धा यस्य स विकचोद्वृद्धपिण्डकः। शिथिलोपचयः स्फिक्प्रदेशे एव शिथिलः श्लथ उपचयो वृद्धिर्यस्य॥ ५-१७६-१३ नल्वो हस्तचतुःशतम्॥ ५-१७६-२९ विष्कुर्हस्तस्तन्मितः परीणाहो विस्तारो यस्य। अरत्निर्निरष्टमांशः करः॥ ५-१७६-३० रथः स्यन्दनदेहयोरिति कोशाद्देहानुकूलशक्तिमद्भिरिति वा॥ ५-१७६-३५ तस्य घटोत्कचस्या। आसक्तमन्योन्यसंसक्तं यथास्यात्तथाशरानस्यतः॥ ५-१७६-९४ उल्काभ्यां सजर्रसमिश्रोल्मुकाभ्याम्। ततो हि दीप्तस्य सर्जरसस्य कणाः सस्नेहत्वात्सार्चिष एव पतन्तीति प्रसिद्धम्॥ ५-१७६-१७६ षट्सप्तत्यधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}]