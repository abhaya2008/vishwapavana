[{"id": 7002121000, "chapter_id": 22121, "verse_number": "१६६-१", "content_sanskrit": "वर्णधर्मादिकथनं ।\nपुष्कर उवाच ।\nवेदस्मार्तं प्रवक्ष्यामि धर्मं वै पञ्चधा स्मृतं ।\nवर्णत्वमेकमाश्रित्य योऽधिकारः प्रवर्तते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002121001, "chapter_id": 22121, "verse_number": "१६६-२", "content_sanskrit": "वर्णधर्मः स विज्ञेयो यथोपनयनन्त्रिषु ।\nयस्त्वाश्रमं समाश्रित्य पदार्थः संविधीयते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002121002, "chapter_id": 22121, "verse_number": "१६६-३", "content_sanskrit": "उक्त आश्रमधर्मस्तु भिन्नपिण्डादिको यथा ।\nउभयेन निमित्तेन यो विधिः सम्प्रवर्तते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002121003, "chapter_id": 22121, "verse_number": "१६६-४", "content_sanskrit": "नैमित्तिकः स विज्ञेयः प्रायश्चित्तविधिर्यथा ।\nब्रह्मचारी गृही चापि वानप्रस्थो यतिर्नृप ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002121004, "chapter_id": 22121, "verse_number": "१६६-५", "content_sanskrit": "उक्त आश्रमधर्मस्तु धर्मः स्यात्पञ्चधा परः ।\nषाड्गुण्यस्याभिधाने यो दृष्टार्थः स उदाहृतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002121005, "chapter_id": 22121, "verse_number": "१६६-६", "content_sanskrit": "स त्रेधा मन्त्रयागाद्यदृष्टार्थ इति मानवाः ।\nउभयार्थो व्यवहारस्तु दण्डधारणमेव च ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002121006, "chapter_id": 22121, "verse_number": "१६६-७", "content_sanskrit": "तुल्यार्थानां विकल्पः स्याद्यागमूलः प्रकीर्तितः ।\nवेदे तु विहितो धर्मः स्मृतौ तादृश एव च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002121007, "chapter_id": 22121, "verse_number": "१६६-८", "content_sanskrit": "अनुवादं स्मृतिः सूते कार्यार्थमिति मानवाः ।\nगुणार्थः परिसङ्ख्यार्थो वानुवादो विशेषतः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002121008, "chapter_id": 22121, "verse_number": "१६६-९", "content_sanskrit": "विशेषदृष्ट एवासौ फलार्थ इति मानवाः ।\nस्यादष्टचत्वारिंशद्भिः संस्कारैर्ब्रह्मलोकगः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002121009, "chapter_id": 22121, "verse_number": "१६६-१०", "content_sanskrit": "गर्भाधानं पुंसवनं सीमन्तोन्नयनः ततः ।\nजातकर्म नामकृतिरन्नप्राशनचूडकं ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002121010, "chapter_id": 22121, "verse_number": "१६६-११", "content_sanskrit": "संस्कारश्चोपनयनं वेदव्रतचतुष्टयं ।\nस्नानं स्वधर्मचारिण्या योगः स्याद्यज्ञपञ्चकं ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002121011, "chapter_id": 22121, "verse_number": "१६६-१२", "content_sanskrit": "देवयज्ञः पितृयज्ञो मनुष्यभूतयज्ञकौ ।\nब्रह्मयज्ञः सप्तपाकयज्ञसंस्थाः पुरोऽष्टकाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002121012, "chapter_id": 22121, "verse_number": "१६६-१३", "content_sanskrit": "पार्वणश्राद्धं श्रावण्याग्रहायणी च चैत्र्यपि ।\nआश्वयुजी सप्तहविर्यज्ञसंस्थास्ततः स्मृताः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002121013, "chapter_id": 22121, "verse_number": "१६६-१४", "content_sanskrit": "अग्न्याधेयमग्निहोत्रं दर्शः स्यात्पशुबन्धकः ।\nचातुर्मास्याग्रहायेष्टिर्निरूढः पशुबन्धकः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002121014, "chapter_id": 22121, "verse_number": "१६६-१५", "content_sanskrit": "सौत्रामणिसप्तसोमसंस्थाग्निष्टोम आदितः ।\nअत्यग्निष्टोम उक्थश्च षोडशी वाजपेयकः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002121015, "chapter_id": 22121, "verse_number": "१६६-१६", "content_sanskrit": "अतिरात्रास्तथा स्तोम अष्टौ चात्मगुणास्ततः ।\nदया क्षमानसूया च अनायासोऽथ मङ्गलं ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002121016, "chapter_id": 22121, "verse_number": "१६६-१७", "content_sanskrit": "अकार्पण्यास्पृहाशौचं यस्यैते स परं व्रजेत् ।\nप्रचारे मैथुने चैव प्रस्रावे दन्तधावने ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002121017, "chapter_id": 22121, "verse_number": "१६६-१८", "content_sanskrit": "स्नानभोजनकाले च पट्सु मौनं समाचरेत् ।\nपुनर्दानं पृथक्पानमाज्येन यपसा निशि ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002121018, "chapter_id": 22121, "verse_number": "१६६-१९", "content_sanskrit": "दन्तच्छेदनमुष्णं च सप्त शक्तुषु वर्जयेत् ।\nस्नात्वा पुष्पं न गृह्णीयाद्देवायोग्यन्तदीरितं ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002121019, "chapter_id": 22121, "verse_number": "१६६-२०", "content_sanskrit": "अन्यगोत्रोप्यसम्बद्धः प्रेतस्याग्निन्ददाति यः ।\nपिण्डञ्चोदकदानञ्च स दशाहं समापयेत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002121020, "chapter_id": 22121, "verse_number": "१६६-२१", "content_sanskrit": "उदकञ्च तृणं भस्म द्वारम्पन्थास्तथैव च ।\nएभिरन्तरितं कृत्वा पङ्क्तिदोषो न विद्यते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002121021, "chapter_id": 22121, "verse_number": "१६६-२२", "content_sanskrit": "पञ्च प्राणाहुतीर्दद्यादनामाङ्गुष्ठयोगतः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]