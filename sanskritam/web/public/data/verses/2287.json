[{"id": 2060151, "chapter_id": 2287, "verse_number": "८-८-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2060152, "chapter_id": 2287, "verse_number": "८-८-१", "content_sanskrit": "सैनापत्यं तु सम्प्राप्य कर्णो वैकर्तनस्तदा।\nतथोक्तश्च स्वयं राज्ञा स्निग्धं भ्रातृसमं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2060153, "chapter_id": 2287, "verse_number": "८-८-२", "content_sanskrit": "हितश्च प्रियकामश्च मम पुत्रस्य नित्यशः।\nअकरोत्किं महाप्राज्ञस्तन्ममाचक्ष्व स़ञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2060154, "chapter_id": 2287, "verse_number": "८-८-३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2060155, "chapter_id": 2287, "verse_number": "८-८-३", "content_sanskrit": "कर्णस्य मतमाज्ञाय पुत्रास्ते भरतर्षभ।\nयोगमाज्ञापयामासुर्नन्दितूर्यपुरःसरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2060156, "chapter_id": 2287, "verse_number": "८-८-४", "content_sanskrit": "महत्यपररात्रे च तव सैन्यस्य मारिष।\nयोगो योग इति ह्याशु प्रादुरासीन्महास्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2060157, "chapter_id": 2287, "verse_number": "८-८-५", "content_sanskrit": "कल्पतां नागमुख्यानां रथानां च वरुथिनाम्।\nसन्नह्यतां नराणां च वाजिनां च विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2060158, "chapter_id": 2287, "verse_number": "८-८-६", "content_sanskrit": "क्रोशतां चैव योधानां त्वरितानां परस्परम्।\nबभूव तुमुलः शब्दो दिवस्पृक्सुमहांस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2060159, "chapter_id": 2287, "verse_number": "८-८-७", "content_sanskrit": "ततः श्वेतपताकेन बलाकावर्णवाजिना।\nहेमपृष्ठेन धनुषा नागकक्षेण केतुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2060160, "chapter_id": 2287, "verse_number": "८-८-८", "content_sanskrit": "तूणीरशतपूर्णेन सगदेन वरूथिना।\nशतघ्नीकिङ्किणीशक्तिशूलतोमरधारिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2060161, "chapter_id": 2287, "verse_number": "८-८-९", "content_sanskrit": "कार्मुकैरुपपन्नेन विमलादित्यवर्चसा।\nरथेनाभिपताकेन सुतपुत्रो ह्यदृश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2060162, "chapter_id": 2287, "verse_number": "८-८-१०", "content_sanskrit": "ध्मापयन्वारिजं राजन्हेमजालविभूषिन्तम्।\nविध्रुन्वानो महच्चापं कार्तस्वरविभूषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2060163, "chapter_id": 2287, "verse_number": "८-८-११", "content_sanskrit": "दृष्ट्वा कर्णं महेष्वासं रथस्थं रथिनां वरम्।\nभानुमन्तमिवोद्यन्तं तमो घ्नन्तं दुरासदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2060164, "chapter_id": 2287, "verse_number": "८-८-१२", "content_sanskrit": "न भीष्मव्यसनं केचिन्नापि द्रोणस्य मारिष।\nनान्येषां पुरुषव्याघ्र मेनिरे तत्र कौरवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2060165, "chapter_id": 2287, "verse_number": "८-८-१३", "content_sanskrit": "ततस्तु त्वरयन्योधाञ्शङ्खशब्देन मारिष।\nकर्णो निष्कर्षयामास कौरवाणां महद्बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2060166, "chapter_id": 2287, "verse_number": "८-८-१४", "content_sanskrit": "व्यूहं व्यूह्य महेष्वासो मकरं शत्रुतापनः।\nप्रत्युद्ययौ तथा कर्णः पाण्डवान्विजिगीषया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2060167, "chapter_id": 2287, "verse_number": "८-८-१५", "content_sanskrit": "मकरस्य तु तुण्डे वै कर्णो राजन्व्यवस्थितः।\nनेत्राभ्यां शकुनिः शूर उलूकश्च महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2060168, "chapter_id": 2287, "verse_number": "८-८-१६", "content_sanskrit": "द्रोणपुत्रस्तु शिरसि ग्रीवायां सर्वसोदराः।\nमध्येदुर्योधनो राजा बलेन महता वृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2060169, "chapter_id": 2287, "verse_number": "८-८-१७", "content_sanskrit": "वामपादे तु राजेन्द्र कृतवर्मा व्यवस्थितः।\nनारायणबलैर्युक्तो गोपालैर्युद्धदुर्मदैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2060170, "chapter_id": 2287, "verse_number": "८-८-१८", "content_sanskrit": "पादे तु दक्षिणे राजन्गौतमः सत्यविक्रमः।\nत्रिगर्तैः सुमहेष्वासैर्दाक्षिणात्यैश्च संवृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2060171, "chapter_id": 2287, "verse_number": "८-८-१९", "content_sanskrit": "अनुपादे तु यो वामस्तत्र शल्यो व्यवस्थितः।\nमहत्या सेनया सार्धं मद्रदेशसमुत्थया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2060172, "chapter_id": 2287, "verse_number": "८-८-२०", "content_sanskrit": "दक्षिणे तु महाराज सुषेणः सत्यसङ्गरः।\nवृतो रथमहस्रेण दन्तिनां च त्रिभिः शतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2060173, "chapter_id": 2287, "verse_number": "८-८-२१", "content_sanskrit": "पुच्छे ह्यास्तां महावीर्यौ भ्रातरौ पार्थिवौ तदा।\nचित्रश्च चित्रसेनश्च महत्या सेनया वृतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2060174, "chapter_id": 2287, "verse_number": "८-८-२२", "content_sanskrit": "तथा प्रयाते राजेन्द्र कर्णे नरवरोत्तमे।\nधनञ्जयमभिपेक्ष्य धर्मराजोऽब्रवीदिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2060175, "chapter_id": 2287, "verse_number": "८-८-२३", "content_sanskrit": "पश्य पार्थ यथा सेना धार्तराष्ट्रीह संयुगे।\nकर्णेन विहिता वीर गुप्ता वीरैर्महारथैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2060176, "chapter_id": 2287, "verse_number": "८-८-२४", "content_sanskrit": "हतवीरतमा ह्येषा धार्तराष्ट्री महाचमूः।\nफल्गुशेषा महाबाहो तृणैस्तुल्या मता मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2060177, "chapter_id": 2287, "verse_number": "८-८-२५", "content_sanskrit": "एको ह्यत्र महेष्वासः सूतपुत्रो विराजते।\nसदेवासुरगन्धर्वैः सकिन्नरमहोरगैः।\nचराचरैस्त्रिभिर्लोकैरजेयो यो महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2060178, "chapter_id": 2287, "verse_number": "८-८-२६", "content_sanskrit": "तं हत्वाऽद्य महाबाहो विजयस्तव फल्गुन।\nउद्धृतश्च भवेच्छल्यो मम द्वादशवार्षिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2060179, "chapter_id": 2287, "verse_number": "८-८-२७", "content_sanskrit": "एवं ज्ञात्वा महाबाहो व्यूहं व्यूह यथेच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2060180, "chapter_id": 2287, "verse_number": "८-८-२८x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2060181, "chapter_id": 2287, "verse_number": "८-८-२८", "content_sanskrit": "भ्रातुरेतद्वचः श्रुत्वा पाण्डवः श्वेतवाहनः।\nअर्धचन्द्रेण व्यूहेन प्रत्यव्यूहत तां चमूम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2060182, "chapter_id": 2287, "verse_number": "८-१-२९", "content_sanskrit": "वामपार्श्वे तु तस्याथ भीमसेनो व्यवस्थितः।\nदक्षिणे च महेष्वासो धृष्टद्युम्नो व्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2060183, "chapter_id": 2287, "verse_number": "८-८-३०", "content_sanskrit": "मध्ये व्यूहस्य राजा तु पाण्डवश्च धनञ्जयः।\nनकुलः सहदेवश्च धर्मराजस्य पृष्ठतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2060184, "chapter_id": 2287, "verse_number": "८-८-३१", "content_sanskrit": "चक्ररक्षौ तु पाञ्चाल्यौ युधामन्यूत्तमौजसौ।\nपार्थं न जहतुर्युद्वे पाल्यमानौ किरीटिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2060185, "chapter_id": 2287, "verse_number": "८-८-३२", "content_sanskrit": "शेषां नृपतयो वीराः स्थिता व्यूहस्य दंशिताः।\nयथाभागं यथोत्साहं यथायत्नं च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2060186, "chapter_id": 2287, "verse_number": "८-८-३३", "content_sanskrit": "एवमेतन्महाव्यूहं व्यूह्य भारत पाण्डवाः।\nतावकाश्च महेष्वासा युद्धायैव मनो दधुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2060187, "chapter_id": 2287, "verse_number": "८-८-३४", "content_sanskrit": "दृष्ट्वा व्यूढां तव चमूं सूतपुत्रेण संयुगे।\nनिहतान्पाण्डवान्मेने धार्तराष्ट्रः सबान्धवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2060188, "chapter_id": 2287, "verse_number": "८-८-३५", "content_sanskrit": "तथैव पाण्डवीं सेनां व्यूढां दृष्ट्वा युधिष्ठिरः।\nधार्तराष्ट्रान्हतान्मेने सकर्णान्वै जनाधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2060189, "chapter_id": 2287, "verse_number": "८-८-३६", "content_sanskrit": "ततः शङ्खाश्च भेर्यश्च पणवानकगोमुखाः।\nडिण्डिमाश्चाप्यहन्यन्त झर्झराश्च समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2060190, "chapter_id": 2287, "verse_number": "८-८-३७", "content_sanskrit": "सेनयोरुभयो राजन्प्रावाद्यन्त महास्वनाः।\nसिंहनादश्च सञ्जज्ञे शूराणां जयगृद्धिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2060191, "chapter_id": 2287, "verse_number": "८-८-३८", "content_sanskrit": "हयहेषितशब्दाश्च वारणानां च बृंहिताः।\nरथनेमिस्वनाश्चोग्राः सम्बभूवुर्जनाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2060192, "chapter_id": 2287, "verse_number": "८-८-३९", "content_sanskrit": "न द्रोणव्यसनं कश्चिज्जानीते तत्र भारत।\nदृष्ट्वा कर्णं महेष्वासं मुखे व्यूहस्य दंशितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2060193, "chapter_id": 2287, "verse_number": "८-८-४०", "content_sanskrit": "उभे सैन्ये महाराज प्रहृष्टनरसङ्कुले।\nयोद्वुकामे स्थिते राजन्हन्तुमन्योन्यमोजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2060194, "chapter_id": 2287, "verse_number": "८-८-४१", "content_sanskrit": "विजये जातसंरम्भे दृष्ट्वाऽन्योन्यं व्यवस्थिते।\nअनीकमध्ये राजेन्द्र चेरतुः कर्णपाण्डवौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2060195, "chapter_id": 2287, "verse_number": "८-८-४२", "content_sanskrit": "नृत्यन्त्याविव ते सेने समेयातां परस्परम्।\nतयोः पक्षप्रपक्षेभ्यो निर्ययुर्युद्वलिप्सवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2060196, "chapter_id": 2287, "verse_number": "८-८-४३", "content_sanskrit": "ततः प्रववृते युद्धं नरवारणवाजिनाम्।\nरथानां च महाराज अन्योन्यमभिनिघ्नताम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2060197, "chapter_id": 2287, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि षोडशदिवसयुद्धारम्भे अष्टमोऽध्यायः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]