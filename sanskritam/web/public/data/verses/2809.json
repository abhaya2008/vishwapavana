[{"id": 2085101, "chapter_id": 2809, "verse_number": "१२-३१४-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2085102, "chapter_id": 2809, "verse_number": "१२-३१४-१", "content_sanskrit": "मृगयां विचरन्कश्चिद्विजने जनकात्मजः।\nवने ददर्श विप्रेन्द्रमृषिं वंशधरं भृगोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2085103, "chapter_id": 2809, "verse_number": "१२-३१४-२", "content_sanskrit": "तमासीनमुपासीनः प्रणम्य शिरसा मुनिम्।\nपश्चादनुमतस्तेन पप्रच्छ वसुमानिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2085104, "chapter_id": 2809, "verse_number": "१२-३१४-३", "content_sanskrit": "भगवन्किमिदं श्रेयः प्रेत्य चापीह वा भवेत्।\nपुरुषस्याध्रुवे देहे कामस्य वशवर्तिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2085105, "chapter_id": 2809, "verse_number": "१२-३१४-४", "content_sanskrit": "सत्कृत्य परिपृष्टः सन्सुमहात्मा महातपाः।\nनिजगाद ततस्तस्मै श्रेयस्करमिदं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2085106, "chapter_id": 2809, "verse_number": "१२-३१४-५x", "content_sanskrit": "ऋषिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2085107, "chapter_id": 2809, "verse_number": "१२-३१४-५", "content_sanskrit": "मनसः प्रतिकूलानि प्रेत्य चेह नचेच्छसि।\nभूतानां प्रतिकूलेभ्यो निवर्तस्य यतेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2085108, "chapter_id": 2809, "verse_number": "१२-३१४-६", "content_sanskrit": "धर्मः सदा हितः पुंसां धर्मश्चैवाश्रयः सताम्।\nधर्माल्लोकास्त्रयस्तात प्रवृत्ताः सचराचराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2085109, "chapter_id": 2809, "verse_number": "१२-३१४-७", "content_sanskrit": "स्वादुकामुक कामानां वैतृष्ण्यं किं न गच्छसि।\nमधु पश्यसि दुर्बुद्धे प्रपातं नानुपश्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2085110, "chapter_id": 2809, "verse_number": "१२-३१४-८", "content_sanskrit": "यथा ज्ञाने परिचयः कर्तव्यस्तत्फलार्थिना।\nतथा धर्मे परिचयः कर्तव्यस्तत्फलार्थिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2085111, "chapter_id": 2809, "verse_number": "१२-३१४-९", "content_sanskrit": "असता धर्मकामेन विशुद्धं कर्म दुष्करम्।\nसता तु धर्मकामेन सुकरं कर्म दुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2085112, "chapter_id": 2809, "verse_number": "१२-३१४-१०", "content_sanskrit": "वने ग्राम्यसुखाचारो यथाग्राम्यस्तथैव सः।\nग्रामे वनसुखाचारो यथा वनचरस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2085113, "chapter_id": 2809, "verse_number": "१२-३१४-११", "content_sanskrit": "मनोवाक्कर्मगे धर्मे कुरु श्रद्धां समाहितः।\nनिवृत्तौ वा प्रवृत्तौ वा संप्रधार्य गुणागुणान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2085114, "chapter_id": 2809, "verse_number": "१२-३१४-१२", "content_sanskrit": "नित्यं च बहु दातव्यं साधुभ्यश्चानसूयता।\nप्रार्थितं ब्राह्मणेभ्यश्च सत्कृतं देशकालयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2085115, "chapter_id": 2809, "verse_number": "१२-३१४-१३", "content_sanskrit": "शुभेन विधिना लब्धमर्हाय प्रतिपादयेत्।\nक्रोधमुत्सृज्य दत्त्वाऽथ नानुतप्येन्न कीर्तयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2085116, "chapter_id": 2809, "verse_number": "१२-३१४-१४", "content_sanskrit": "अनृशंसः शुचिर्दान्तः सत्यवागार्जवे स्थितः।\nयोनिकर्मविशुद्धश्च पात्रं स्याद्वेदविद्द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2085117, "chapter_id": 2809, "verse_number": "१२-३१४-१५", "content_sanskrit": "संस्कृता चैकपत्नी च जात्या योनिरिहेष्यते।\nऋग्यजुःसामगो विद्वान्षट्कर्मा पात्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2085118, "chapter_id": 2809, "verse_number": "१२-३१४-१६", "content_sanskrit": "स एव धर्मः सोऽधर्मस्तं तं प्रति नरं भवेत्।\nपात्राकर्मविशेषेण देशकालाववेक्ष्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2085119, "chapter_id": 2809, "verse_number": "१२-३१४-१७", "content_sanskrit": "लीलयाऽल्पं यथा गात्रात्प्रमृज्यात्तु रजः पुमान्।\nबहुयत्नेन च महत्पापनिर्हरणं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2085120, "chapter_id": 2809, "verse_number": "१२-३१४-१८", "content_sanskrit": "विरिक्तस्य यथा सम्यग्घृतं भवति भेषजम्।\nतथा निर्हृतदोषस्य प्रेत्य धर्मः सुखावहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2085121, "chapter_id": 2809, "verse_number": "१२-३१४-१९", "content_sanskrit": "मानसं सर्वभूतेषु वर्तते वै शुभाशुभम्।\nअशुभेभ्यः समाक्षिप्य शुभेष्वेवावधारय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2085122, "chapter_id": 2809, "verse_number": "१२-३१४-२०", "content_sanskrit": "सर्वं सर्वेणा सर्वत्र क्रियमाणं च पूजय।\nस्वधर्मे यत्र रागस्ते कामं धर्मो विधीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2085123, "chapter_id": 2809, "verse_number": "१२-३१४-२१", "content_sanskrit": "अधृतात्मन्धृतौ तिष्ठ दुर्बद्धे बुद्धिमान्भव।\nअप्रशान्तः प्रशाम्य त्वमप्राज्ञः प्राज्ञवच्चर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2085124, "chapter_id": 2809, "verse_number": "१२-३१४-२२", "content_sanskrit": "तेजसा शक्यते प्राप्तुमुपायः सहचारिणा।\nइह च प्रेत्य च श्रेयस्तस्य मूलं धृतिः परा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2085125, "chapter_id": 2809, "verse_number": "१२-३१४-२३", "content_sanskrit": "राजर्षिरधृतिः स्वर्गात्पतितो हि महाभिषः।\nययातिः क्षीणपुण्योपि धृत्या लोकानवाप्तवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2085126, "chapter_id": 2809, "verse_number": "१२-३१४-२४", "content_sanskrit": "तपस्विनां धर्मवतां विदुषां चोपसेवनात्।\nप्राप्स्यसे विपुलां बुद्धिं तथा श्रेयोऽभिपत्स्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2085127, "chapter_id": 2809, "verse_number": "१२-३१४-२५x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2085128, "chapter_id": 2809, "verse_number": "१२-३१४-२५", "content_sanskrit": "स तु स्वभावसंपन्नस्तच्छ्रुत्वा मुनिभाषितम्।\nविनिवर्त्य मनः कामाद्धर्मे बुद्धिं चकार ह॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2085129, "chapter_id": 2809, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि चतुर्दशाधिकत्रिशततमोऽध्यायः॥ ३१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]