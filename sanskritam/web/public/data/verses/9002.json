[{"id": 5000002000, "chapter_id": 9002, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे द्वितीयः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000002001, "chapter_id": 9002, "verse_number": "१-२-१", "content_sanskrit": "नारदस्य तु तद्वाक्यं श्रुत्वा वाक्यविशारदः ।\nपूजयामास धर्मात्मा सहशिष्यो महामुनिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000002002, "chapter_id": 9002, "verse_number": "१-२-२", "content_sanskrit": "यथावत्पूजितस्तेन देवर्षिर्नारदस्तदा ।\nआपृष्ट्वैवाभ्यनुज्ञातः स जगाम विहायसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000002003, "chapter_id": 9002, "verse_number": "१-२-३", "content_sanskrit": "स मुहूर्तं गते तस्मिन् देवलोकं मुनिस्तदा ।\nजगाम तमसातीरं जाह्नव्यास्त्वविदूरतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000002004, "chapter_id": 9002, "verse_number": "१-२-४", "content_sanskrit": "स तु तीरं समासाद्य तमसाया मुनिस्तदा ।\nशिष्यमाह स्थितं पार्श्वे दृष्ट्वा तीर्थमकर्दमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000002005, "chapter_id": 9002, "verse_number": "१-२-५", "content_sanskrit": "अकर्दममिदं तीर्थं भरद्वाज निशामय ।\nरमणीयं प्रसन्नाम्बु सन्मनुष्यमनो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000002006, "chapter_id": 9002, "verse_number": "१-२-६", "content_sanskrit": "न्यस्यतां कलशस्तात दीयतां वल्कलं मम ।\nइदमेवावगाहिष्ये तमसातीर्थमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000002007, "chapter_id": 9002, "verse_number": "१-२-७", "content_sanskrit": "एवमुक्तो भरद्वाजो वाल्मीकेन महात्मना ।\nप्रायच्छत मुनेस्तस्य वल्कलं नियतो गुरोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000002008, "chapter_id": 9002, "verse_number": "१-२-८", "content_sanskrit": "स शिष्यहस्तादादाय वल्कलं नियतेन्द्रियः ।\nविचचार ह पश्यंस्तत् सर्वतो विपुलं वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000002009, "chapter_id": 9002, "verse_number": "१-२-९", "content_sanskrit": "तस्याभ्याशे तु मिथुनं चरन्तमनपायिनम् ।\nददर्श भगवांस्तत्र क्रौञ्चयोश्चारुनिःस्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000002010, "chapter_id": 9002, "verse_number": "१-२-१०", "content_sanskrit": "तस्मात् तु मिथुनादेकं पुमांसं पापनिश्चयः ।\nजघान वैरनिलयो निषादस्तस्य पश्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000002011, "chapter_id": 9002, "verse_number": "१-२-११", "content_sanskrit": "तं शोणितपरीताङ्गं चेष्टमानं महीतले ।\nभार्या तु निहतं दृष्ट्वा रुराव करुणां गिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000002012, "chapter_id": 9002, "verse_number": "१-२-१२", "content_sanskrit": "वियुक्ता पतिना तेन द्विजेन सहचारिणा ।\nताम्रशीर्षेण मत्तेन पत्त्रिणा सहितेन वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000002013, "chapter_id": 9002, "verse_number": "१-२-१३", "content_sanskrit": "तथाविधं द्विजं दृष्ट्वा निषादेन निपातितम् ।\nऋषेर्धर्मात्मनस्तस्य कारुण्यं समपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000002014, "chapter_id": 9002, "verse_number": "१-२-१४", "content_sanskrit": "ततः करुणवेदित्वादधर्मोऽयमिति द्विजः ।\nनिशाम्य रुदतीं क्रौञ्चीमिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000002015, "chapter_id": 9002, "verse_number": "१-२-१५", "content_sanskrit": "मा निषाद प्रतिष्ठां त्वमगमः शाश्वतीः समाः ।\nयत् क्रौञ्चमिथुनादेकमवधीः काममोहितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000002016, "chapter_id": 9002, "verse_number": "१-२-१६", "content_sanskrit": "तस्यैवं ब्रुवतश्चिन्ता बभूव हृदि वीक्षतः ।\nशोकार्तेनास्य शकुनेः किमिदं व्याहृतं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000002017, "chapter_id": 9002, "verse_number": "१-२-१७", "content_sanskrit": "चिन्तयन् स महाप्राज्ञश्चकार मतिमान्मतिम् ।\nशिष्यं चैवाब्रवीद् वाक्यमिदं स मुनिपुङ्गवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000002018, "chapter_id": 9002, "verse_number": "१-२-१८", "content_sanskrit": "पादबद्धोऽक्षरसमस्तन्त्रीलयसमन्वितः ।\nशोकार्तस्य प्रवृत्तो मे श्लोको भवतु नान्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000002019, "chapter_id": 9002, "verse_number": "१-२-१९", "content_sanskrit": "शिष्यस्तु तस्य ब्रुवतो मुनेर्वाक्यमनुत्तमम् ।\nप्रतिजग्राह संहृष्टस्तस्य तुष्टोऽभवद्गुरुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000002020, "chapter_id": 9002, "verse_number": "१-२-२०", "content_sanskrit": "सोऽभिषेकं ततः कृत्वा तीर्थे तस्मिन् यथाविधि ।\nतमेव चिन्तयन्नर्थमुपावर्तत वै मुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000002021, "chapter_id": 9002, "verse_number": "१-२-२१", "content_sanskrit": "भरद्वाजस्ततः शिष्यो विनीतः श्रुतवान् गुरोः ।\nकलशं पूर्णमादाय पृष्ठतोऽनुजगाम ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000002022, "chapter_id": 9002, "verse_number": "१-२-२२", "content_sanskrit": "स प्रविश्याश्रमपदं शिष्येण सह धर्मवित् ।\nउपविष्टः कथाश्चान्याश्चकार ध्यानमास्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000002023, "chapter_id": 9002, "verse_number": "१-२-२३", "content_sanskrit": "आजगाम ततो ब्रह्मा लोककर्ता स्वयं प्रभुः ।\nचतुर्मुखो महातेजा द्रष्टुं तं मुनिपुङ्गवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000002024, "chapter_id": 9002, "verse_number": "१-२-२४", "content_sanskrit": "वाल्मीकिरथ तं दृष्ट्वा सहसोत्थाय वाग्यतः ।\nप्राञ्जलिः प्रयतो भूत्वा तस्थौ परमविस्मितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000002025, "chapter_id": 9002, "verse_number": "१-२-२५", "content_sanskrit": "पूजयामास तं देवं पाद्यार्घ्यासनवन्दनैः ।\nप्रणम्य विधिवच्चैनं पृष्ट्वा चैव निरामयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000002026, "chapter_id": 9002, "verse_number": "१-२-२६", "content_sanskrit": "अथोपविश्य भगवानासने परमार्चिते ।\nवाल्मीकये च ऋषये संदिदेशासनं ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000002027, "chapter_id": 9002, "verse_number": "१-२-२७", "content_sanskrit": "ब्रह्मणा समनुज्ञातः सोऽप्युपाविशदासने ।\nउपविष्टे तदा तस्मिन् साक्षाल्लोकपितामहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000002028, "chapter_id": 9002, "verse_number": "१-२-२८", "content_sanskrit": "तद्गतेनैव मनसा वाल्मीकिर्ध्यानमास्थितः ।\nपापात्मना कृतं कष्टं वैरग्रहणबुद्धिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000002029, "chapter_id": 9002, "verse_number": "१-२-२९", "content_sanskrit": "यत् तादृशं चारुरवं क्रौञ्चं हन्यादकारणात् ।\nशोचन्नेव पुनः क्रौञ्चीमुपश्लोकमिमं जगौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000002030, "chapter_id": 9002, "verse_number": "१-२-३०", "content_sanskrit": "पुनरन्तर्गतमना भूत्वा शोकपरायणः ।\nतमुवाच ततो ब्रह्मा प्रहसन् मुनिपुङ्गवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000002031, "chapter_id": 9002, "verse_number": "१-२-३१", "content_sanskrit": "श्लोक एवास्त्वयं बद्धो नात्र कार्या विचारणा ।\nमच्छन्दादेव ते ब्रह्मन् प्रवृत्तेयं सरस्वती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000002032, "chapter_id": 9002, "verse_number": "१-२-३२", "content_sanskrit": "रामस्य चरितं कृत्स्नं कुरु त्वमृषिसत्तम ।\nधर्मात्मनो भगवतो लोके रामस्य धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000002033, "chapter_id": 9002, "verse_number": "१-२-३३", "content_sanskrit": "वृत्तं कथय धीरस्य यथा ते नारदाच्छ्रुतम् ।\nरहस्यं च प्रकाशं च यद् वृत्तं तस्य धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000002034, "chapter_id": 9002, "verse_number": "१-२-३४", "content_sanskrit": "रामस्य सहसौमित्रे राक्षसानां च सर्वशः ।\nवैदेह्याश्चैव यद् वृत्तं प्रकाशं यदि वा रहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000002035, "chapter_id": 9002, "verse_number": "१-२-३५", "content_sanskrit": "तच्चाप्यविदितं सर्वं विदितं ते भविष्यति ।\nन ते वागनृता काव्ये काचिदत्र भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000002036, "chapter_id": 9002, "verse_number": "१-२-३६", "content_sanskrit": "कुरु रामकथां पुण्यां श्लोकबद्धां मनोरमाम् ।\nयावत् स्थास्यन्ति गिरयः सरितश्च महीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000002037, "chapter_id": 9002, "verse_number": "१-२-३७", "content_sanskrit": "तावद् रामायणकथा लोकेषु प्रचरिष्यति ।\nयावद् रामस्य च कथा त्वत्कृता प्रचरिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000002038, "chapter_id": 9002, "verse_number": "१-२-३८", "content_sanskrit": "तावदूर्ध्वमधश्च त्वं मल्लोकेषु निवत्स्यसि ।\nइत्युक्त्वा भगवान् ब्रह्मा तत्रैवान्तरधीयत ।\nततः सशिष्यो भगवान् र्मुनिर्विस्मयमाययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000002039, "chapter_id": 9002, "verse_number": "१-२-३९", "content_sanskrit": "तस्य शिष्यास्ततः सर्वे जगुः श्लोकमिमं पुनः ।\nमुहुर्मुहुः प्रीयमाणाः प्राहुश्च भृशविस्मिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000002040, "chapter_id": 9002, "verse_number": "१-२-४०", "content_sanskrit": "समाक्षरैश्चतुर्भिर्यः पादैर्गीतो महर्षिणा ।\nसोऽनुव्याहरणाद् भूयः शोकः श्लोकत्वमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000002041, "chapter_id": 9002, "verse_number": "१-२-४१", "content_sanskrit": "तस्य बुद्धिरियं जाता वाल्मीकेर्भावितात्मनः ।\nकृत्स्नं रामायणं काव्यमीदृशैः करवाण्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000002042, "chapter_id": 9002, "verse_number": "१-२-४२", "content_sanskrit": "उदारवृत्तार्थपदैर्मनोरमै-\n::स्तदास्य रामस्य चकार कीर्तिमान् ।\nसमाक्षरैः श्लोकशतैर्यशस्विनो\n::यशस्करं काव्यमुदारदर्शनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000002043, "chapter_id": 9002, "verse_number": "१-२-४३", "content_sanskrit": "तदुपगतसमाससंधियोगं\n::सममधुरोपनतार्थवाक्यबद्धम् ।\nरघुवरकरितं मुनिप्रणीतं\n::दशशिरसश्क वधं निशामयध्वम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000002044, "chapter_id": 9002, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे द्वितीयः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]