[{"id": 6000124000, "chapter_id": 10124, "verse_number": null, "content_sanskrit": "अथ पञ्चमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000124001, "chapter_id": 10124, "verse_number": null, "content_sanskrit": "बादरायणिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.001.m4a", "display_order": 2}, {"id": 6000124002, "chapter_id": 10124, "verse_number": "६-५-१", "content_sanskrit": "तस्यां स पाञ्चजन्यां वै विष्णुमायोपबृंहितः।\nहर्यश्वसंज्ञान् अयुतं पुत्रानजनयद् विभुः॥ ६/५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.002.m4a", "display_order": 3, "topics": [{"text": "अयुतसंख्याकानां हर्यश्वनाम्नां प्रजासर्ग उद्युक्तानां दक्षपुत्राणां नारदेन वाचःकूटैः वैराग्योत्पादनम्", "range": "१–२१"}]}, {"id": 6000124003, "chapter_id": 10124, "verse_number": "६-५-२", "content_sanskrit": "अपृथग्धर्मशीलास्ते सर्वे दाक्षायणा नृप।\nपित्रा प्रोक्ताः प्रजासर्गे प्रतीचीं प्रययुर्दिशम्॥ ६/५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.003.m4a", "display_order": 4}, {"id": 6000124004, "chapter_id": 10124, "verse_number": "६-५-३", "content_sanskrit": "तत्र नारायणसरस्तीर्थं सिन्धुसमुद्रयोः।\nसङ्गमो यत्र सुमहन्मुनिसिद्धनिषेवितम्॥ ६/५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.004.m4a", "display_order": 5}, {"id": 6000124005, "chapter_id": 10124, "verse_number": "६-५-४", "content_sanskrit": "तदुपस्पर्शनादेव विनिर्धूतमलाशयाः।\nधर्मे पारमहंस्ये च प्रोत्पन्नमतयोऽप्युत॥ ६/५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.005.m4a", "display_order": 6}, {"id": 6000124006, "chapter_id": 10124, "verse_number": "६-५-५", "content_sanskrit": "तेपुस्ते तप एवोग्रं पित्रादेशेन यन्त्रिताः।\nप्रजाविवृद्धये यत्तान् देवर्षिस्तान् ददर्श ह॥ ६/५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.006.m4a", "display_order": 7}, {"id": 6000124007, "chapter_id": 10124, "verse_number": "६-५-६", "content_sanskrit": "उवाच चाथ हर्यश्वाः कथं स्रक्ष्यथ वै प्रजाः।\nअदृष्ट्वाऽन्तं भुवो यूयं बालिशा बत बालकाः॥ ६/५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.007.m4a", "display_order": 8}, {"id": 6000124008, "chapter_id": 10124, "verse_number": "६-५-७", "content_sanskrit": "तथैकपुरुषं राज्यं बिलं चादृष्टनिर्गमम्।\nबहुरूपां स्‍त्रियं चापि पुमांसं पुंश्चलीपतिम्॥ ६/५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.008.m4a", "display_order": 9}, {"id": 6000124009, "chapter_id": 10124, "verse_number": "६-५-८", "content_sanskrit": "नदीमुभयतोवाहां पञ्चपञ्चाद्भुतं गृहम्।\nक्‍वचिद्धंसं चित्रकथं क्षुरान्तं च स्वयं भ्रमिम्॥ ६/५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.009.m4a", "display_order": 10}, {"id": 6000124010, "chapter_id": 10124, "verse_number": "६-५-९", "content_sanskrit": "कथं स्वपितुरादेशमविद्वांसो विपश्चितः।\nअनुरूपमविज्ञाय अहो सर्गं करिष्यथ॥ ६/५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.010.m4a", "display_order": 11}, {"id": 6000124011, "chapter_id": 10124, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.011.m4a", "display_order": 12}, {"id": 6000124012, "chapter_id": 10124, "verse_number": "६-५-१०", "content_sanskrit": "तन्निशम्याथ हर्यश्वा औत्पत्तिकमनीषया।\nवाचः कूटं च देवर्षेः स्वयं विममृशुर्धिया॥ ६/५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.012.m4a", "display_order": 13}, {"id": 6000124013, "chapter_id": 10124, "verse_number": "६-५-११", "content_sanskrit": "भूः क्षेत्रं बीजसंज्ञस्य यदनादिनिबन्धनम्।\nअदृष्ट्वा तस्य निर्वाणं किमसत्कर्मभिर्भवेत्॥ ६/५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.013.m4a", "display_order": 14}, {"id": 6000124014, "chapter_id": 10124, "verse_number": "६-५-१२", "content_sanskrit": "एक एवेश्वरस्तुर्यो भगवान् स्वाश्रयः परः।\nतमदृष्ट्वाऽभवं पुंसः किमसत्कर्मभिर्भवेत्॥ ६/५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.014.m4a", "display_order": 15}, {"id": 6000124015, "chapter_id": 10124, "verse_number": "६-५-१३", "content_sanskrit": "पुमान् नापैति यद् गत्वा बिलं स्वर्गगतो यथा।\nप्रत्यगात्माऽविद इह किमसत्कर्मभिर्भवेत्॥ ६/५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.015.m4a", "display_order": 16}, {"id": 6000124016, "chapter_id": 10124, "verse_number": "६-५-१४", "content_sanskrit": "नानारूपाऽऽत्मनो बुद्धिः स्वैरिणीव गुणान्विता।\nतन्निष्ठामगतस्येह किमसत्कर्मभिर्भवेत्॥ ६/५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.016.m4a", "display_order": 17}, {"id": 6000124017, "chapter_id": 10124, "verse_number": "६-५-१५", "content_sanskrit": "तत्सङ्गभ्रंशितैश्वर्यं संसरन्तं कुभार्यवत्।\nतद्गतीरबुधस्येह किमसत्कर्मभिर्भवेत्॥ ६/५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.017.m4a", "display_order": 18}, {"id": 6000124018, "chapter_id": 10124, "verse_number": "६-५-१६", "content_sanskrit": "सृष्ट्यप्ययकरीं मायां वेलाकूलान्तवेगिनीम्।\nमत्तस्य तदविज्ञानात् किमसत्कर्मभिर्भवेत्॥ ६/५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.018.m4a", "display_order": 19}, {"id": 6000124019, "chapter_id": 10124, "verse_number": "६-५-१७", "content_sanskrit": "पञ्चविंशतितत्त्वानां पुरुषोऽद्भुतदर्शनः।\nअध्यात्ममबुधस्येह किमसत्कर्मभिर्भवेत्॥ ६/५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.019.m4a", "display_order": 20}, {"id": 6000124020, "chapter_id": 10124, "verse_number": "६-५-१८", "content_sanskrit": "ऐश्वरं शास्‍त्रमुत्सृज्य बन्धमोक्षानुदर्शनम्।\nविविक्तपदमज्ञात्वा किमसत्कर्मभिर्भवेत्॥ ६/५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.020.m4a", "display_order": 21}, {"id": 6000124021, "chapter_id": 10124, "verse_number": "६-५-१९", "content_sanskrit": "कालचक्रं भ्रमिं तीक्ष्णं सर्वं निष्कर्षयेज्जगत्।\nस्वतन्त्रमबुधस्येह किमसत्कर्मभिर्भवेत्॥ ६/५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.021.m4a", "display_order": 22}, {"id": 6000124022, "chapter_id": 10124, "verse_number": "६-५-२०", "content_sanskrit": "शास्‍त्रस्य पितुरादेशं यो न वेद निवर्तकम्।\nकथं तदनुरूपाय गुणविश्रम्भ्युपक्रमेत्॥ ६/५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.022.m4a", "display_order": 23}, {"id": 6000124023, "chapter_id": 10124, "verse_number": "६-५-२१", "content_sanskrit": "इति व्यवसिता राजन् हर्यश्वा एकमेधसः।\nप्रययुस्तं परिक्रम्य पन्थानमनिवर्तकम्॥ ६/५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.023.m4a", "display_order": 24}, {"id": 6000124024, "chapter_id": 10124, "verse_number": "६-५-२२", "content_sanskrit": "स्वरब्रह्मणि निर्भाते हृषीकेशपदाम्बुजे।\nअखण्डं चित्तमावेश्य लोकानन्वचरन्मुहुः॥ ६/५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.024.m4a", "display_order": 25, "topics": [{"text": "पुनः शबलाश्वनाम्नां दक्षपुत्राणामपि नारदेन वैराग्योत्पादनम्", "range": "२२–३४"}]}, {"id": 6000124025, "chapter_id": 10124, "verse_number": "६-५-२३", "content_sanskrit": "नाशं निशम्य पुत्राणां नारदाच्छीलशालिनाम्।\nअन्वतप्यत कः शोचन् सुप्रजास्त्वं शुचां पदम्॥ ६/५/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.025.m4a", "display_order": 26}, {"id": 6000124026, "chapter_id": 10124, "verse_number": "६-५-२४", "content_sanskrit": "स भूयः पाञ्चजन्यायामजेन परिसान्त्वितः।\nपुत्रानजनयद् दक्षः शबलाश्वान् सहस्रिणः॥ ६/५/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.026.m4a", "display_order": 27}, {"id": 6000124027, "chapter_id": 10124, "verse_number": "६-५-२५", "content_sanskrit": "तेऽपि पित्रा समादिष्टाः प्रजासर्गे धृतव्रताः।\nनारायणसरो जग्मुर्यत्र सिद्धास्तु पूर्वजाः॥ ६/५/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.027.m4a", "display_order": 28}, {"id": 6000124028, "chapter_id": 10124, "verse_number": "६-५-२६", "content_sanskrit": "तदुपस्पर्शनादेव विनिर्धूतमलाशयाः।\nजपन्तो ब्रह्म परमं तेपुस्तत्र महत् तपः॥ ६/५/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.028.m4a", "display_order": 29}, {"id": 6000124029, "chapter_id": 10124, "verse_number": "६-५-२७", "content_sanskrit": "अब्भक्षाः कतिचिन्मासान् कतिचिद्वायुभोजनाः।\nआराधयन् मन्त्रमिममभ्यसन्त इडस्पतिम्॥ ६/५/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.029.m4a", "display_order": 30}, {"id": 6000124030, "chapter_id": 10124, "verse_number": "६-५-२८", "content_sanskrit": "ओं नमो नारायणाय पुरुषाय महात्मने।\nविशुद्धसत्त्वधिष्ण्याय महाहंसाय धीमहि॥ ६/५/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.030.m4a", "display_order": 31}, {"id": 6000124031, "chapter_id": 10124, "verse_number": "६-५-२९", "content_sanskrit": "इति तानपि राजेन्द्र प्रजासर्गधियो मुनिः।\nउपेत्य नारदः प्राह वचःकूटानि पूर्ववत्॥ ६/५/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.031.m4a", "display_order": 32}, {"id": 6000124032, "chapter_id": 10124, "verse_number": "६-५-३०", "content_sanskrit": "दाक्षायणाः संशृणुत गदतो निगमं मम।\nअन्विच्छतानुपदवीं भ्रातॄणां भ्रातृवत्सलाः॥ ६/५/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.032.m4a", "display_order": 33}, {"id": 6000124033, "chapter_id": 10124, "verse_number": "६-५-३१", "content_sanskrit": "भ्रातॄणां प्रायणं भ्राता योऽनुतिष्ठति धर्मवित्।\nस पुण्यबन्धुः पुरुषो मरुद्भिः सह मोदते॥ ६/५/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.033.m4a", "display_order": 34}, {"id": 6000124034, "chapter_id": 10124, "verse_number": "६-५-३२", "content_sanskrit": "एतावदुक्त्वा प्रययौ नारदोऽमोघदर्शनः।\nतेऽपि चान्वगमन्मार्गं भ्रातॄणामेव मारिष॥ ६/५/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.034.m4a", "display_order": 35}, {"id": 6000124035, "chapter_id": 10124, "verse_number": "६-५-३३", "content_sanskrit": "सध्रीचीनं प्रतीचीनं परस्यानुपथं गताः।\nनाद्यापि ते निवर्तन्ते पश्चिमा यामिनीरिव॥ ६/५/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.035.m4a", "display_order": 36}, {"id": 6000124036, "chapter_id": 10124, "verse_number": "६-५-३४", "content_sanskrit": "एतस्मिन् काल उत्पातान् बहून् पश्यन् प्रजापतिः।\nपूर्ववन्नारदकृतं पुत्रनाशमुपाशृृणोत्॥ ६/५/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.036.m4a", "display_order": 37}, {"id": 6000124037, "chapter_id": 10124, "verse_number": "६-५-३५", "content_sanskrit": "चुक्रोध नारदायासौ पुत्रशोकविमूर्छितः।\nदेवर्षिमुपलक्ष्याह रुषा प्रस्फुरिताधरः॥ ६/५/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.037.m4a", "display_order": 38, "topics": [{"text": "रुष्टेन दक्षेन नारदाय शापदानम्", "range": "३५–४४"}]}, {"id": 6000124038, "chapter_id": 10124, "verse_number": null, "content_sanskrit": "दक्ष उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.038.m4a", "display_order": 39}, {"id": 6000124039, "chapter_id": 10124, "verse_number": "६-५-३६", "content_sanskrit": "अहो असाधो साधूनां साधुलिङ्गेन नस्त्वया।\nअसाध्वकार्यर्भकाणां भिक्षोर्मार्गः प्रदर्शितः॥ ६/५/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.039.m4a", "display_order": 40}, {"id": 6000124040, "chapter_id": 10124, "verse_number": "६-५-३७", "content_sanskrit": "ऋणैस्‍त्रिभिरमुक्तानाम् अमीमांसितकर्मणाम्।\nविघातः श्रेयसः पाप लोकयोरुभयोः कृतः॥ ६/५/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.040.m4a", "display_order": 41}, {"id": 6000124041, "chapter_id": 10124, "verse_number": "६-५-३८", "content_sanskrit": "एवं त्वं निरनुक्रोशो बालानां मतिभिद्धरेः।\nपार्षदमध्ये चरसि यशोहानिरपत्रपः॥ ६/५/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.041.m4a", "display_order": 42}, {"id": 6000124042, "chapter_id": 10124, "verse_number": "६-५-३९", "content_sanskrit": "ननु भागवता नित्यं भूतानुग्रहकातराः।\nऋते त्वां सौहृदघ्नं वै वैरङ्करमवैरिणाम्॥ ६/५/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.042.m4a", "display_order": 43}, {"id": 6000124043, "chapter_id": 10124, "verse_number": "६-५-४०", "content_sanskrit": "नेत्थं पुंसो विरागः स्यात् त्वया केवलिना विना।\nमन्यसे यद्युपशमं स्नेहपाशनिवर्तनम्॥ ६/५/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.043.m4a", "display_order": 44}, {"id": 6000124044, "chapter_id": 10124, "verse_number": "६-५-४१", "content_sanskrit": "नानुभूय न जानाति पुमान् विषयतीक्ष्णताम्।\nनिर्विद्यते स्वयं तस्मान्न तथा भिन्नधीः परैः॥ ६/५/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.044.m4a", "display_order": 45}, {"id": 6000124045, "chapter_id": 10124, "verse_number": "६-५-४२", "content_sanskrit": "यन्नस्त्वं कर्मबन्धानां साधूनां गृहमेधिनाम्।\nकृतवानसि दुर्मर्षं विप्रियं तव मर्षितम्॥ ६/५/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.045.m4a", "display_order": 46}, {"id": 6000124046, "chapter_id": 10124, "verse_number": "६-५-४३", "content_sanskrit": "तन्तुकृत्तनयानां त्वमभद्रमचरः पुनः।\nतस्माल्लोकेषु ते मूढ न भवेद् भ्रमतः पदम्॥ ६/५/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.046.m4a", "display_order": 47}, {"id": 6000124047, "chapter_id": 10124, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.047.m4a", "display_order": 48}, {"id": 6000124048, "chapter_id": 10124, "verse_number": "६-५-४४", "content_sanskrit": "प्रतिजग्राह तद् बाढं नारदः साधुसम्मतः।\nएतावान् साधुवादो हि तितिक्षेतेश्वरः स्वयम्॥ ६/५/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_005/BhP_06.005.048.m4a", "display_order": 49}, {"id": 6000124049, "chapter_id": 10124, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां षष्ठस्कन्धे पञ्चमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]