[{"id": 5000044000, "chapter_id": 9044, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे चतुश्चत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000044001, "chapter_id": 9044, "verse_number": "१-४४-१", "content_sanskrit": "स गत्वा सागरं राजा गङ्गायानुगतस्तदा ।\nप्रविवेश तलं भूमेर्यत्र ते भस्मसात्कृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000044002, "chapter_id": 9044, "verse_number": "१-४४-२", "content_sanskrit": "भस्मन्यथाप्लुते राम गङ्गायाः सलिलेन वै ।\nसर्वलोकप्रभुर्ब्रह्मा राजानमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000044003, "chapter_id": 9044, "verse_number": "१-४४-३", "content_sanskrit": "तारिता नरशार्दूल दिवं याताश्च च देववत् ।\nषष्टिः पुत्रसहस्राणि सगरस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000044004, "chapter_id": 9044, "verse_number": "१-४४-४", "content_sanskrit": "सागरस्य जलं लोके यावत्स्थास्यति पार्थिव ।\nसगरस्यात्मजाः सर्वे दिवि स्थास्यन्ति देववत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000044005, "chapter_id": 9044, "verse_number": "१-४४-५", "content_sanskrit": "इयं च दुहिता ज्येष्ठा तव गङ्गा भविष्यति ।\nत्वत्कृतेन च नाम्नाथ लोके स्थास्यति विश्रुता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000044006, "chapter_id": 9044, "verse_number": "१-४४-६", "content_sanskrit": "गङ्गा त्रिपथगा नाम दिव्या भागीरथीति च ।\nत्रीन् पथो भावयन्तीति तस्मात् त्रिपथगा स्मृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000044007, "chapter_id": 9044, "verse_number": "१-४४-७", "content_sanskrit": "पितामहानां सर्वेषां त्वमत्र मनुजाधिप ।\nकुरुष्व सलिलं राजन् प्रतिज्ञामपवर्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000044008, "chapter_id": 9044, "verse_number": "१-४४-८", "content_sanskrit": "पूर्वकेण हि ते राजंस्तेनातियशसा तदा ।\nधर्मिणां प्रवरेणाथ नैष प्राप्तो मनोरथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000044009, "chapter_id": 9044, "verse_number": "१-४४-९", "content_sanskrit": "तथैवांशुमता तात लोकेऽप्रतिमतेजसा ।\nगङ्गां प्रार्थयता नेतुं प्रतिज्ञा नापवर्जिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000044010, "chapter_id": 9044, "verse_number": "१-४४-१०", "content_sanskrit": "राजर्षिणा गुणवता महर्षिसमतेजसा ।\nमत्तुल्यतपसा चैव क्षत्रधर्मस्थितेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000044011, "chapter_id": 9044, "verse_number": "१-४४-११", "content_sanskrit": "दिलीपेन महाभाग तव पित्रातितेजसा ।\nपुनर्न शकिता नेतुं गङ्गां प्रार्थयतानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000044012, "chapter_id": 9044, "verse_number": "१-४४-१२", "content_sanskrit": "सा त्वया समतिक्रान्ता प्रतिज्ञा पुरुषर्षभ ।\nप्राप्तोऽसि परमं लोके यशः परमसम्मतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000044013, "chapter_id": 9044, "verse_number": "१-४४-१३", "content_sanskrit": "तच्च गङ्गावतरणं त्वया कृतमरिंदम ।\nअनेन च भवान् प्राप्तो धर्मस्यायतनं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000044014, "chapter_id": 9044, "verse_number": "१-४४-१४", "content_sanskrit": "प्लावयस्व त्वमात्मानं नरोत्तम सदोचिते ।\nसलिले पुरुषश्रेष्ठ शुचिः पुण्यफलो भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000044015, "chapter_id": 9044, "verse_number": "१-४४-१५", "content_sanskrit": "पितामहानां सर्वेषां कुरुष्व सलिलक्रियाम् ।\nस्वस्ति तेऽस्तु गमिष्यामि स्वं लोकं गम्यतां नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000044016, "chapter_id": 9044, "verse_number": "१-४४-१६", "content_sanskrit": "इत्येवमुक्त्वा देवेशः सर्वलोकपितामहः\nयथागतं तथागच्चद् देवलोकं महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000044017, "chapter_id": 9044, "verse_number": "१-४४-१७", "content_sanskrit": "भगीरथस्तु राजर्षिः कृत्वा सलिलमुत्तमम्\nयथाक्रमं यथान्यायं सागराणां महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000044018, "chapter_id": 9044, "verse_number": "१-४४-१८", "content_sanskrit": "कृतोदकः शुची राजा स्वपुरं प्रविवेश ह ।\nसमृद्धार्थो नरश्रेष्ठ स्वराज्यं प्रशशास ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000044019, "chapter_id": 9044, "verse_number": "१-४४-१९", "content_sanskrit": "प्रमुमोद च लोकस्तं नृपमासाद्य राघव ।\nनष्टशोकः समृद्धार्थो बभूव विगतज्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000044020, "chapter_id": 9044, "verse_number": "१-४४-२०", "content_sanskrit": "एष ते राम गंगाया विस्तरोऽभिहितो मया ।\nस्वस्ति प्राप्नुहि भद्रं ते संध्याकालोऽतिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000044021, "chapter_id": 9044, "verse_number": "१-४४-२१", "content_sanskrit": "धन्यं यशस्यमायुष्यं पुत्र्यं स्वर्ग्यमथापि च।\nयः श्रावयति विप्रेषु क्षत्रियेष्वितरेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000044022, "chapter_id": 9044, "verse_number": "१-४४-२२", "content_sanskrit": "प्रीयन्ते पितरस्तस्य प्रीयन्ते दैवतानि च ।\nइदमाख्यानमायुष्यं गंगावतरणं शुभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000044023, "chapter_id": 9044, "verse_number": "१-४४-२३", "content_sanskrit": "यः शृणोति च काकुत्स्थ सर्वान् कामानवाप्नुयात् ।\nसर्वे पापाः प्रणश्यन्ति आयुः कीर्तिश्च वर्धते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000044024, "chapter_id": 9044, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे चतुश्चत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]