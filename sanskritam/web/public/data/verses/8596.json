[{"id": 900007825, "chapter_id": 8596, "verse_number": "177.1", "content_sanskrit": "तत्र मोक्षस्वरूपं तु वादिनः प्रतिभाऽऽश्रयात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900007826, "chapter_id": 8596, "verse_number": "177.2", "content_sanskrit": "पुंसां हि मतयो गुणभेदतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900007827, "chapter_id": 8596, "verse_number": "177.3", "content_sanskrit": "गुणातीता विमुक्तानां मतिः शुद्धचितिर्यतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900007828, "chapter_id": 8596, "verse_number": "177.4", "content_sanskrit": "स्पष्टा चैव श्रियो मतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900007829, "chapter_id": 8596, "verse_number": "177.5", "content_sanskrit": "विशेषांस्तद्गतांस्त्यक्त्वा प्रायस्तल्लक्षणा श्रियः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900007830, "chapter_id": 8596, "verse_number": "177.6", "content_sanskrit": "ब्रह्मणस्तु प्रायेणैवं श्रियो यथा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900007831, "chapter_id": 8596, "verse_number": "177.7", "content_sanskrit": "एवंविधेषु ज्ञानेषु तमसा मुष्टदृष्टयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900007832, "chapter_id": 8596, "verse_number": "177.8", "content_sanskrit": "आश्रित्य प्रतिभामाह जिनस्तत्रातितामसीम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900007833, "chapter_id": 8596, "verse_number": "177.9", "content_sanskrit": "गतिरूर्ध्वा च दुःखेता गतित्वाल्लौकिकी यथा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900007834, "chapter_id": 8596, "verse_number": "177.10", "content_sanskrit": "अनूर्ध्वगतिता तत्र यद्युपाधिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900007835, "chapter_id": 8596, "verse_number": "177.11", "content_sanskrit": "प्रतिसाधनरूपस्य नानुमानस्य दूषणम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900007836, "chapter_id": 8596, "verse_number": "177.12", "content_sanskrit": "अथापि सशरीरत्वं चात्रोपाधिर्न वै भवेत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900007837, "chapter_id": 8596, "verse_number": "177.13", "content_sanskrit": "आगमाननुसारित्वे प्रसङ्गोऽयं यतस्ततः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]