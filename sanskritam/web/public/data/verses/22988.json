[{"id": 7002988000, "chapter_id": 22988, "verse_number": "२-३५-१", "content_sanskrit": "नारद उवाच ।\nश्रीकृष्णस्यात्मनश्चैव निर्गुणस्य निराकृतेः ।\nसावित्रीयमसंवादे श्रुतं सुविमलं यशः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002988001, "chapter_id": 22988, "verse_number": "२-३५-२", "content_sanskrit": "तद्गुणोत्कीर्त्तनं सत्यं मंगलानां च मङ्गलम् ।\nअधुना श्रोतुमिच्छामि लक्ष्म्युपाख्यानमीश्वर ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002988002, "chapter_id": 22988, "verse_number": "२-३५-३", "content_sanskrit": "केनादौ पूजिता साऽपि किम्भूता केन वा पुरा ।\nतद्गुणोत्कीर्त्तनं सत्यं वद वेदविदां वर॥ ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002988003, "chapter_id": 22988, "verse_number": "२-३५-४", "content_sanskrit": "नारायण उवाच ।\nसृष्टेरादौ पुरा ब्रह्मन्कृष्णस्य परमात्मनः ।\nदेवी वामांशसंभूता चासीत्सा रासमण्डले ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002988004, "chapter_id": 22988, "verse_number": "२-३५-५", "content_sanskrit": "अतीव सुन्दरी श्यामा न्यग्रोधपरिमण्डला ।\nयथा द्वादशवर्षीया रम्या सुस्थिरयौवना ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002988005, "chapter_id": 22988, "verse_number": "२-३५-६", "content_sanskrit": "श्वेतचम्पकवर्णाभा सुखदृश्या मनोहरा ।\nशरत्पार्वणकोटीन्दुप्रभासंशोभितानना ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002988006, "chapter_id": 22988, "verse_number": "२-३५-७", "content_sanskrit": "शरन्मध्याह्नपद्मानां शोभाशोभितलोचना ।\nसा च देवी द्विधाभूता सहसैवेश्वरेच्छया ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002988007, "chapter_id": 22988, "verse_number": "२-३५-८", "content_sanskrit": "समा रूपेण वर्णेन तेजसा वयसा त्विषा ।\nयशसा वाससा मूर्त्या भूषूणेन गुणेन च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002988008, "chapter_id": 22988, "verse_number": "२-३५-९", "content_sanskrit": "स्मितेन वीक्षणेनैव वचसा गमनेन च ।\nमधुरेण स्वरेणैव नयेनानुनयेन च ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002988009, "chapter_id": 22988, "verse_number": "२-३५-१०", "content_sanskrit": "तद्वामांशा महालक्ष्मीर्दक्षिणांशा च राधिका ।\nराधाऽऽदौ वरयामास द्विभुजं च परात्परम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002988010, "chapter_id": 22988, "verse_number": "२-३५-११", "content_sanskrit": "महालक्ष्मीश्च तत्पश्चाच्चकमे कमनीयकम् ।\nकृष्णस्तद्गौरवेणैव द्विधारूपो बभूव ह ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002988011, "chapter_id": 22988, "verse_number": "२-३५-१२", "content_sanskrit": "दक्षिणांशो वै द्विभुजो वामांशश्च चतुर्भुजः ।\nचतुर्भुजाय द्विभुजो महालक्ष्मीं ददौ पुरा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002988012, "chapter_id": 22988, "verse_number": "२-३५-१३", "content_sanskrit": "लक्ष्यते दृश्यते विश्वं स्निग्धदृष्ट्या ययाऽनिशम् ।\nदेवीषु या च महती महालक्ष्मीश्च सा स्मृता ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002988013, "chapter_id": 22988, "verse_number": "२-३५-१४", "content_sanskrit": "द्विभुजो राधिकाकान्तो लक्ष्मीकान्तश्चतुर्भुजः ।\nगोलोके द्विभुजस्तस्थौ गोपैर्गोपीभिरावृतः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002988014, "chapter_id": 22988, "verse_number": "२-३५-१५", "content_sanskrit": "चतुर्भुजश्च वैकुण्ठं प्रययौ पद्मया सह ।\nसर्वांशेन समौ तौ द्वौ कृष्णनारायणौ परौ ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002988015, "chapter_id": 22988, "verse_number": "२-३५-१६", "content_sanskrit": "महालक्ष्मीश्च योगेन नानारूपा बभूव सा ।\nवैकुण्ठे च महालक्ष्मीः परिपूर्णतमा परा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002988016, "chapter_id": 22988, "verse_number": "२-३५-१७", "content_sanskrit": "शुद्धसत्त्वस्वरूपा च सर्वसौभाग्यसंयुता ।\nप्रेम्णा सा वै प्रधाना च सर्वासु रमणीषु च ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002988017, "chapter_id": 22988, "verse_number": "२-३५-१८", "content_sanskrit": "स्वर्गे च स्वर्गलक्ष्मीश्च शक्रसम्पत्स्वरूपिणी ।\nपातालेषु च मर्त्येषु राजलक्ष्मीश्च राजसु ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002988018, "chapter_id": 22988, "verse_number": "२-३५-१९", "content_sanskrit": "गृहलक्ष्मीर्गृहेष्वेव गृहिणी च कलांशया ।\nसम्पत्स्वरूपा गृहिणां सर्वमङ्गलमंगला ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002988019, "chapter_id": 22988, "verse_number": "२-३५-२०", "content_sanskrit": "गवां प्रसूः सा सुरभिर्दक्षिणा यज्ञकामिनी ।\nक्षीरोदसिन्धु  कन्या सा श्रीरूपा पद्मिनीषु च ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002988020, "chapter_id": 22988, "verse_number": "२-३५-२१", "content_sanskrit": "शोभारूपा च चन्द्रे सा सूर्य्यमण्डलमण्डिता ।\nविभूषणेषु रत्नेषु फलेषु जलजेषु च ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002988021, "chapter_id": 22988, "verse_number": "२-३५-२२", "content_sanskrit": "नृपेषु नृपपत्नीषु दिव्यस्त्रीषु गृहेषु च ।\nसर्वसस्येषु वस्त्रेषु स्थाने सा संस्कृते तथा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002988022, "chapter_id": 22988, "verse_number": "२-३५-२३", "content_sanskrit": "प्रतिमासु च देवानां मङ्गलेषु घटेषु च ।\nमाणिक्येषु च मुक्तासु माल्येषु च मनोहरा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002988023, "chapter_id": 22988, "verse_number": "२-३५-२४", "content_sanskrit": "मणींद्रेषु च हारेषु क्षीरं वै चन्दनेषु च ।\nवृक्षशाखासु रम्यासु नवमेघेषु वस्तुषु ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002988024, "chapter_id": 22988, "verse_number": "२-३५-२५", "content_sanskrit": "वैकुण्ठे पूजिता साऽऽदौ देवी नारायणेन च ।\nद्वितीये ब्रह्मणा भक्त्या तृतीये शङ्करेण च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002988025, "chapter_id": 22988, "verse_number": "२-३५-२६", "content_sanskrit": "विष्णुना पूजिता सा च क्षीरोदे भारते मुने ।\nस्वायम्भुवेन मनुना मानवेन्द्रैश्च सर्वतः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002988026, "chapter_id": 22988, "verse_number": "२-३५-२७", "content_sanskrit": "ऋषीन्द्रैश्च मुनीन्द्रैश्च सद्भिश्च गृहिभिर्भवेत् ।\nगन्धर्वाद्यैश्च नागाद्यैः पातालेषु च पूजिता ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002988027, "chapter_id": 22988, "verse_number": "२-३५-२८", "content_sanskrit": "शुक्लाष्टम्यां भाद्रपदे पूजा वै ब्रह्मणा कृता ।\nभक्त्या च पक्षपर्यन्तं त्रिषु लोकेषु नारद ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002988028, "chapter_id": 22988, "verse_number": "२-३५-२९", "content_sanskrit": "चैत्रे पौषे च भाद्रे च पुण्ये मङ्गलवासरे ।\nविष्णुना निर्मिता पूजा त्रिषु लोकेषु भक्तितः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002988029, "chapter_id": 22988, "verse_number": "२-३५-३०", "content_sanskrit": "वर्षान्ते पौषसंक्रांत्यां मेध्यामावाह्य चाङ्गणे ।\nमनुस्तां पूजयामास सा भूता भुवनत्रये ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002988030, "chapter_id": 22988, "verse_number": "२-३५-३१", "content_sanskrit": "राज्ञा संपूजिता सा वै मङ्गलेनैव मङ्गला ।\nकेदारेणैव नीलेन नलेन सुबलेन च ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002988031, "chapter_id": 22988, "verse_number": "२-३५-३२", "content_sanskrit": "ध्रुवेणौत्तानपादेन शक्रेण बलिना तथा ।\nकश्यपेन च दक्षेण मनुना च विवस्वता ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002988032, "chapter_id": 22988, "verse_number": "२-३५-३३", "content_sanskrit": "प्रियव्रतेन चन्द्रेण कुबेरेणैव वायुना ।\nयमेन वह्निना चैव वरुणेनैव पूजिता ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002988033, "chapter_id": 22988, "verse_number": "२-३५-३४", "content_sanskrit": "एवं सर्वत्र सर्वैश्च वन्दिता पूजिता सदा ।\nसर्वैश्वर्य्याधिदेवी सा सर्वसम्पत्स्वरूपिणी ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]