[{"id": 2023517, "chapter_id": 1503, "verse_number": "३-१४१-०x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2023518, "chapter_id": 1503, "verse_number": "३-१४१-१", "content_sanskrit": "उशीरबीजं मैनाकं गिरिं श्वेतं च भारत।\nसमतीतोऽसि कौन्तेय कालशैलं च पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2023519, "chapter_id": 1503, "verse_number": "३-१४१-२", "content_sanskrit": "एषा गङ्गा सप्तविधा राजते भरतर्षभ।\nस्थानं विरजसं पुण्यं यत्राग्निर्नित्यमिध्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2023520, "chapter_id": 1503, "verse_number": "३-१४१-३", "content_sanskrit": "एतद्वै मानुषेणाद्य न शक्यं द्रष्टुमद्भुतम्।\nसमाधिं कुरुताव्यग्रास्तीर्थान्येतानि द्रक्ष्यथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2023521, "chapter_id": 1503, "verse_number": "३-१४१-४", "content_sanskrit": "एतद्द्रक्ष्यसि देवानामाक्रीडं च रणाङ्कितम्।\nअतिक्रान्तोसि कौन्तेय कालशैलं च पर्वतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2023522, "chapter_id": 1503, "verse_number": "३-१४१-५", "content_sanskrit": "श्वेतं गिरिं प्रवेक्ष्यामो मन्दरं चैव पर्वतम्।\nयत्र माणिवरो यक्षः कुबेरश्चैव यक्षराट् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2023523, "chapter_id": 1503, "verse_number": "३-१४१-६", "content_sanskrit": "अष्टाशीतिसहस्राणि गन्धर्वाः शीघ्रगामिनः।\nतथा किंपुरुषा राजन्यक्षाश्चैव चतुर्गुणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2023524, "chapter_id": 1503, "verse_number": "३-१४१-७", "content_sanskrit": "अनेकरूपसंस्थाना नानाप्रहरणाश्च ते।\nयक्षेन्द्रं मनुजश्रेष्ठ माणिभद्रमुपासते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2023525, "chapter_id": 1503, "verse_number": "३-१४१-८", "content_sanskrit": "तेषामृद्धिरतीवात्र गतौ वायुसमाश्च ते।\nयक्षेन्द्रं मनुजश्रेष्ठ माणिभद्रमुपासते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2023526, "chapter_id": 1503, "verse_number": "३-१४१-९", "content_sanskrit": "तैस्तात बलिभिर्गुप्ता यातुधानैश्च रक्षिताः।\nदुर्गमाः पर्वताः पार्थ समाधिं परमं कुरु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2023527, "chapter_id": 1503, "verse_number": "३-१४१-१०", "content_sanskrit": "कुबेरसचिवाश्चान्ये रौद्रा मैत्राश्च राक्षसाः।\nतैः समेष्याम कौन्तेय यत्तो विक्रमणे भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2023528, "chapter_id": 1503, "verse_number": "३-१४१-११", "content_sanskrit": "कैलासः पर्वतो राजन्पड्योजनशतोच्छ्रितः।\nयत्रदेवाः समायान्ति विशाला यत्र भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2023529, "chapter_id": 1503, "verse_number": "३-१४१-१२", "content_sanskrit": "असङ्ख्येयास्तु कौन्तेय यक्षराक्षसकिन्नराः।\nनागाः सुपर्णा गन्धर्वाः कुबेरसदनं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2023530, "chapter_id": 1503, "verse_number": "३-१४१-१३", "content_sanskrit": "तान्विगाहस्व पार्थाद्य तपसा च दमेन च।\nरक्ष्यमाणो मया राजन्भीमसेनबलेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2023531, "chapter_id": 1503, "verse_number": "३-१४१-१४", "content_sanskrit": "स्वस्ति ते वरुणो राजा यमश्च समितिंजयः।\nगङ्गा च यमुना चैव पर्वताश्च दिशन्तु ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2023532, "chapter_id": 1503, "verse_number": "३-१४१-१५", "content_sanskrit": "मरुतश्च सहाश्विभ्यां सरितश्च सरांसि च।\nस्वस्ति देवासुरेभ्यश्च वसुभ्यश् महाद्युते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2023533, "chapter_id": 1503, "verse_number": "३-१४१-१६", "content_sanskrit": "इन्द्रस्य जाम्बूनदपर्वताद्वै\nशृणोमि घोषं तव देवि गङ्गे।\nगोपाययेमं सुभगे गिरिभ्यः\nसर्वाजमीढापचितं नरेन्द्रम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2023534, "chapter_id": 1503, "verse_number": "३-१४१-१७", "content_sanskrit": "ददस्व शर्म प्रविविक्षतोऽस्य\nशैलानिमाञ्छैलसुते नृपस्य।\n`शिवप्रदा सर्वसरित्प्रधाने\nस भ्रातृकस्येह युधिष्ठिरस्य।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2023535, "chapter_id": 1503, "verse_number": "३-१४१-१८x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2023536, "chapter_id": 1503, "verse_number": "३-१४१-१८", "content_sanskrit": "अपूर्वोऽयं संभ्रमो लोमशस्य\nकृष्णां च सर्वे रक्षत मा प्रमादः।\nदेशो ह्ययं दुर्गतमो मतोऽस्य\nतस्मात्परं शौचमिहाचरध्वम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2023537, "chapter_id": 1503, "verse_number": "३-१४१-१९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2023538, "chapter_id": 1503, "verse_number": "३-१४१-१९", "content_sanskrit": "ततोऽब्रवीद्भीममुदारवीर्यं\nकृष्णां यत्तः पालय भीमसेन।\nशून्येऽर्जुनेऽसन्निहिते च तात\nत्वामेव कृष्णा भजते भयेषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2023539, "chapter_id": 1503, "verse_number": "३-१४१-२०", "content_sanskrit": "ततो महात्मां स यमौ समेत्य\nमूर्धन्युपाघ्राय विमृज्यगात्रे।\nउवाच तौ बाष्पकलं स राजा\nमा बैष्टमागच्छतमप्रमत्तौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2023540, "chapter_id": 1503, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि एकचत्वारिंशदधिकशततमोऽध्यायः ॥ १४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]