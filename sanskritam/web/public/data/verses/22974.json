[{"id": 7002974000, "chapter_id": 22974, "verse_number": "२-२१-१", "content_sanskrit": "नारद उवाच ।\nनारायणश्च भगवान्वीर्य्याधानं चकार ह ।\nतुलस्या केन रूपेण तन्मे व्याख्यातुमर्हसि ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002974001, "chapter_id": 22974, "verse_number": "२-२१-२", "content_sanskrit": "नारायण उवाच ।\nनारायणश्च भगवान्देवानां साधनेन च ।\nशंखचूडस्य रूपेण रेमे तद्रामया सह ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002974002, "chapter_id": 22974, "verse_number": "२-२१-३", "content_sanskrit": "शंखचूडस्य कवचं गृहीत्वा मायया हरिः ।\nपुनर्विधाय तद्रूपं जगाम तुलसीगृहम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002974003, "chapter_id": 22974, "verse_number": "२-२१-४", "content_sanskrit": "दुन्दुभिं वादयामास तुलसीद्वारसन्निधौ ।\nजयशब्दरवद्वारा बोधयामास सुन्दरीम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002974004, "chapter_id": 22974, "verse_number": "२-२१-५", "content_sanskrit": "तच्छ्रुत्वा सा च साध्वी च परमानन्दसंयुता ।\nराजमार्गगवाक्षेण ददर्श परमादरात् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002974005, "chapter_id": 22974, "verse_number": "२-२१-६", "content_sanskrit": "ब्राह्मणेभ्यो धनं दत्त्वा कारयामास मङ्गलम्  ।\nबन्दिभ्यो भिक्षुकेभ्यश्च वाचिकेभ्यो धनं ददौ ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002974006, "chapter_id": 22974, "verse_number": "२-२१-७", "content_sanskrit": "अवरुह्य रथाद्देवो देव्याश्च भवनं ययौ ।\nअमूल्यरत्नसंक्लृप्तं सुन्दरं सुमनोहरम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002974007, "chapter_id": 22974, "verse_number": "२-२१-८", "content_sanskrit": "दृष्ट्वा च पुरतः कान्तं शान्तं कान्ता मुदाऽन्विता ।\nतत्पादं क्षालयामास ननाम च रुरोद च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002974008, "chapter_id": 22974, "verse_number": "२-२१-९", "content_sanskrit": "रत्नसिंहा सने रम्ये वासयामास कामुकी ।\nताम्बूलं च ददौ तस्मै कर्पूरादिसुवासितम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002974009, "chapter_id": 22974, "verse_number": "२-२१-१०", "content_sanskrit": "अद्य मे सफलं जन्म ह्यद्य मे सफलाः क्रियाः ।\nरणागतं च प्राणेशं पश्यन्त्याश्च पुनर्गृहे ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002974010, "chapter_id": 22974, "verse_number": "२-२१-११", "content_sanskrit": "सस्मिता सकटाक्षं च सकामा पुलकाञ्चिता ।\nपप्रच्छ रणवृत्तान्तं कान्तं मधुरया गिरा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002974011, "chapter_id": 22974, "verse_number": "२-२१-१२", "content_sanskrit": "तुलस्युवाच ।\nअसंख्यविश्वसंहर्त्रा सार्द्धमाजौ तव प्रभो ।\nकथं बभूव विजयस्तन्मे ब्रूहि कृपानिधे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002974012, "chapter_id": 22974, "verse_number": "२-२१-१३", "content_sanskrit": "तुलसीवचनं श्रुत्वा प्रहस्य कमलापतिः ।\nशंखचूडस्य रूपेण तामुवाचानृतं वचः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002974013, "chapter_id": 22974, "verse_number": "२-२१-१४", "content_sanskrit": "श्रीहरिरुवाच ।\nआवयोः समरं कान्ते पूर्णमब्दं बभूव ह ।\nनाशो बभूव सर्वेषां दानवानां च कामिनि ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002974014, "chapter_id": 22974, "verse_number": "२-२१-१५", "content_sanskrit": "प्रीतिं च कारयामास ब्रह्मा च स्वयमावयोः ।\nदेवानामधिकारश्च प्रदत्तो ब्रह्मणा पुरा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002974015, "chapter_id": 22974, "verse_number": "२-२१-१६", "content_sanskrit": "मयाऽऽगतं स्वभवनं शिवलोकं शिवो गतः ।\nइत्युक्त्वा जगतां नाथः शयनं च चकार ह ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002974016, "chapter_id": 22974, "verse_number": "२-२१-१७", "content_sanskrit": "रेमे रमापतिस्तत्र रामया सह नारद ।\nसा साध्वी सुखसम्भोगादाकर्षणव्यतिक्रमात् ।\nसर्वं वितर्कयामास कस्त्वमेवेत्युवाच ह ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002974017, "chapter_id": 22974, "verse_number": "२-२१-१८", "content_sanskrit": "तुलस्युवाच ।\nको वा त्वं वद मायेशो भुक्ताऽहं मायया त्वया ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002974018, "chapter_id": 22974, "verse_number": "२-२१-१९", "content_sanskrit": "दूरीकृतं मत्सतीत्वमथवा त्वां शपामहे ।\nतुलसीवचनं श्रुत्वा हरिः शापभयेन च ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002974019, "chapter_id": 22974, "verse_number": "२-२१-२०", "content_sanskrit": "दधार लीलया ब्रह्मन्स्वां मूर्तिं सुमनोहराम् ।\nददर्श पुरतो देवी देवदेवं सनातनम् ।\nनवीननीरद श्यामं शरत्पङ्कजलोचनम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002974020, "chapter_id": 22974, "verse_number": "२-२१-२१", "content_sanskrit": "कोटिकन्दर्पलीलाभं रत्नभूषणभूषितम् ।\nईषद्धास्यं प्रसन्नास्यं शोभितं पीतवाससा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002974021, "chapter_id": 22974, "verse_number": "२-२१-२२", "content_sanskrit": "तं दृष्ट्वा कामिनी कामान्मूर्छां संप्राप लीलया ।\nपुनश्च चेतनां प्राप्य पुनः सा तमुवाच ह ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002974022, "chapter_id": 22974, "verse_number": "२-२१-२३", "content_sanskrit": "हे नाथ ते दया नास्ति पाषाण सदृशस्य च ।\nछलेन धर्मभङ्गेन मम स्वामी त्वया हतः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002974023, "chapter_id": 22974, "verse_number": "२-२१-२४", "content_sanskrit": "पाषाणसदृशस्त्वं च दयाहीनो यतः प्रभो ।\nतस्मात्पाषाणरूप स्त्वं भुवि देव भवाधुना ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002974024, "chapter_id": 22974, "verse_number": "२-२१-२५", "content_sanskrit": "ये वदन्ति दयासिन्धुं त्वां ते भ्रान्ता न संशयः ।\nभक्तो विनाऽपराधेन परार्थे च कथं हतः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002974025, "chapter_id": 22974, "verse_number": "२-२१-२६", "content_sanskrit": "दुर्वृत्तस्त्वं च सर्वज्ञो न जानासि परव्यथाम् ।\nअतस्त्वमेकजनुषि स्वमेव विस्मरिष्यसि ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002974026, "chapter_id": 22974, "verse_number": "२-२१-२७", "content_sanskrit": "इत्युक्त्वा च महासाध्वी निपत्य चरणे हरेः ।\nभृशं रुरोद शोकार्त्ता विललाप मुहुर्मुहुः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002974027, "chapter_id": 22974, "verse_number": "२-२१-२८", "content_sanskrit": "तस्याश्च करुणां दृष्ट्वा करुणामयसागरः ।\nनारायणस्तां बोधयितुमुवाच कमलापतिः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002974028, "chapter_id": 22974, "verse_number": "२-२१-२९", "content_sanskrit": "श्रीभगवानुवाच ।\nतपस्त्वया कृतं साध्वि मदर्थे भारते चिरम् ।\nत्वदर्थे शङ्खचूडश्च चकार सुचिरं तपः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002974029, "chapter_id": 22974, "verse_number": "२-२१-३०", "content_sanskrit": "कृत्वा त्वां कामिनीं कामी विजहार च तत्फलात् ।\nअधुना दातुमुचितं तवैव तपसः फलम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002974030, "chapter_id": 22974, "verse_number": "२-२१-३१", "content_sanskrit": "इदं शरीरं त्यक्त्वा च दिव्यं देहं विधाय च ।\nरासे मे रमया सार्द्धं त्वं रमासदृशी भव ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002974031, "chapter_id": 22974, "verse_number": "२-२१-३२", "content_sanskrit": "इयं तनुर्नदीरूपा गण्डकीति च विश्रुता ।\nपूता सुपुण्यदा नृणां पुण्या भवतु भारते ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002974032, "chapter_id": 22974, "verse_number": "२-२१-३३", "content_sanskrit": "तव केशसमूहाश्च पुण्यवृक्षा भवन्त्विति ।\nतुलसीकेशसम्भूता तुलसीति च विश्रुता ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002974033, "chapter_id": 22974, "verse_number": "२-२१-३४", "content_sanskrit": "त्रिलोकेषु च पुष्पाणां पत्राणां देवपूजने ।\nप्रधानरूपा तुलसी भविष्यति वरानने ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002974034, "chapter_id": 22974, "verse_number": "२-२१-३५", "content_sanskrit": "स्वर्गे मर्त्ये च पाताले वैकुण्ठे मम सन्निधौ ।\nभवन्तु तुलसीवृक्षा वराः पुष्पेषु सुन्दरि ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002974035, "chapter_id": 22974, "verse_number": "२-२१-३६", "content_sanskrit": "गोलोके विरजातीरे रासे वृन्दावने भुवि ।\nभाण्डीरे चम्पकवने रम्ये चन्दनकानने ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002974036, "chapter_id": 22974, "verse_number": "२-२१-३७", "content_sanskrit": "माधवीकेतकीकुन्दमल्लिकामालतीवने ।\nभवन्तु तरवस्तत्र पुष्पस्थानेषु पुण्यदा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002974037, "chapter_id": 22974, "verse_number": "२-२१-३८", "content_sanskrit": "तुलसीतरुमूले च पुण्यदेशे सुपुण्यदे ।\nअधिष्ठानं तु तीर्थानां सर्वेषां च भविष्यति ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002974038, "chapter_id": 22974, "verse_number": "२-२१-३९", "content_sanskrit": "तत्रैव सर्वदेवानां समधिष्ठानमेव च ।\nतुलसीपत्रपतनं प्रायो यत्र वरानने ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002974039, "chapter_id": 22974, "verse_number": "२-२१-४०", "content_sanskrit": "स स्नातः सर्वतीर्थेषु सर्वयज्ञेषु दीक्षितः ।\nतुलसीपत्रतोयेन योऽभिषेकं समाचरेत् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002974040, "chapter_id": 22974, "verse_number": "२-२१-४१", "content_sanskrit": "सुधाघटसहस्रेण सा तुष्टिर्न भवेद्धरेः ।\nया च तुष्टिर्भवेन्नॄणां तुलसीपत्रदानतः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002974041, "chapter_id": 22974, "verse_number": "२-२१-४२", "content_sanskrit": "गवामयुतदानेन यत्फलं लभते नरः ।\nतुलसीपत्रदानेन तत्फलं लभते सति ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002974042, "chapter_id": 22974, "verse_number": "२-२१-४३", "content_sanskrit": "तुलसीपत्रतोयं च मृत्युकाले च यो लभेत् ।\nस मुच्यते सर्वपापाद्विष्णुलोकं स गच्छति ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002974043, "chapter_id": 22974, "verse_number": "२-२१-४४", "content_sanskrit": "नित्यं यस्तुलसी तोयं भुङ्क्ते भक्त्या च यो नरः ।\nस एव जीवन्मुक्तश्च गंगास्नानफलं लभेत् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002974044, "chapter_id": 22974, "verse_number": "२-२१-४५", "content_sanskrit": "नित्यं यस्तुलसीं दत्त्वा पूजयेन्मां च मानवः ।\nलक्षाश्वमेधजं पुण्यं लभते नात्र संशयः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002974045, "chapter_id": 22974, "verse_number": "२-२१-४६", "content_sanskrit": "तुलसीं स्वकरे धृत्वा देहे धृत्वा च मानवः ।\nप्राणांस्त्यजति तीर्थेषु विष्णु लोकं स गच्छति ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002974046, "chapter_id": 22974, "verse_number": "२-२१-४७", "content_sanskrit": "तुलसीकाष्ठनिर्माणमालां गृह्णाति यो नरः ।\nपदे पदेऽश्वमेधस्य लभते निश्चितं फलम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002974047, "chapter_id": 22974, "verse_number": "२-२१-४८", "content_sanskrit": "तुलसीं स्वकरे धृत्वा स्वीकारं यो न रक्षति ।\nस याति कालसूत्रं च यावच्चन्द्रदिवाकरौ ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002974048, "chapter_id": 22974, "verse_number": "२-२१-४९", "content_sanskrit": "करोति मिथ्याशपथं तुलस्या यो हि मानवः ।\nस याति कुम्भीपाकं च यावदिन्द्राश्चतुर्दश ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002974049, "chapter_id": 22974, "verse_number": "२-२१-५०", "content_sanskrit": "तुलसीतोयकणिकां मृत्युकाले च यो लभेत् ।\nरत्नयानं समारुह्य वैकुण्ठं स प्रयाति च ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002974050, "chapter_id": 22974, "verse_number": "२-२१-५१", "content_sanskrit": "पूर्णिमायाममायां च द्वादश्यां रविसंक्रमे ।\nतैलाभ्यंगे चास्नाते च मध्याह्ने निशि सन्ध्ययोः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002974051, "chapter_id": 22974, "verse_number": "२-२१-५२", "content_sanskrit": "आशौचेऽशुचिकाले वा रात्रिवासान्विते नराः ।\nतुलसीं ये च छिन्दन्ति ते छिन्दन्ति हरेः शिरः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002974052, "chapter_id": 22974, "verse_number": "२-२१-५३", "content_sanskrit": "त्रिरात्रं तुलसीपत्रं शुद्धं पर्युषितं सति ।\nश्राद्धे व्रते वा दाने वा प्रतिष्ठायां सुरार्चने ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002974053, "chapter_id": 22974, "verse_number": "२-२१-५४", "content_sanskrit": "भूगतं तोयपतितं यद्दत्तं विष्णवे सति ।\nशुद्धं तु तुल सीपत्रं क्षालनादन्यकर्मणि ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002974054, "chapter_id": 22974, "verse_number": "२-२१-५५", "content_sanskrit": "वृक्षाधिष्ठात्री देवी या गोलोके च निरामये ।\nकृष्णेन सार्द्धं रहसि नित्यं क्रीडां करिष्य ति५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002974055, "chapter_id": 22974, "verse_number": "२-२१-५६", "content_sanskrit": "नद्यधिष्ठातृदेवी या भारते च सुपुण्यदा ।\nलवणोदस्य पत्नी च मदंशस्य भविष्यति ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002974056, "chapter_id": 22974, "verse_number": "२-२१-५७", "content_sanskrit": "त्वं च स्वयं महासाध्वी वैकुण्ठे मम सन्निधौ ।\nरमासमा च रासे च भविष्यसि न संशयः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002974057, "chapter_id": 22974, "verse_number": "२-२१-५८", "content_sanskrit": "अहं च शैलरूपी च गण्डकीतीरसन्निधौ ।\nअधिष्ठानं करि ष्यामि भारते तव शापतः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002974058, "chapter_id": 22974, "verse_number": "२-२१-५९", "content_sanskrit": "वज्रकीटाश्च कृमयो वज्रदंष्ट्राश्च तत्र वै ।\nतच्छिलाकुहरे चक्रं करिष्यन्ति मदीयकम ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002974059, "chapter_id": 22974, "verse_number": "२-२१-६०", "content_sanskrit": "एकद्वारे चतुश्चक्रं वनमालाविभूषितम् ।\nनवीननीरदश्यामं लक्ष्मीनारायणाभिधम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002974060, "chapter_id": 22974, "verse_number": "२-२१-६१", "content_sanskrit": "एकद्वारे चतुश्चक्रं नवीननीरदोपमम् ।\nलक्ष्मीजनार्दनं ज्ञेयं रहितं वनमालया ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002974061, "chapter_id": 22974, "verse_number": "२-२१-६२", "content_sanskrit": "द्वारद्वये चतुश्चक्रं गोष्पदेन समन्वितम् ।\nरघुनाथाभिधं ज्ञेयं रहितं वनमालया॥ ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002974062, "chapter_id": 22974, "verse_number": "२-२१-६३", "content_sanskrit": "अतिक्षुद्रं द्विचक्रं च नवीनजलदप्रभम् ।\nदधिवामनाभिधं ज्ञेयं गृहिणां च सुखप्रदम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002974063, "chapter_id": 22974, "verse_number": "२-२१-६४", "content_sanskrit": "अतिक्षुद्रं द्विचक्रं च वनमा लाविभूषितम् ।\nविज्ञेयं श्रीधरं देवं श्रीप्रदं गृहिणां सदा ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002974064, "chapter_id": 22974, "verse_number": "२-२१-६५", "content_sanskrit": "स्थूलं च वर्तुलाकारं रहितं वनमालया ।\nद्विचकं स्फुटमत्यन्तं ज्ञेयं दामोदराभिधम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002974065, "chapter_id": 22974, "verse_number": "२-२१-६६", "content_sanskrit": "मध्यमं वर्तुलाकारं द्विचक्रं बाणविक्षतम् ।\nरणरामाभिधं ज्ञेयं शरतूणसमन्वितम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7002974066, "chapter_id": 22974, "verse_number": "२-२१-६७", "content_sanskrit": "मध्यमं सप्तचक्रं च छत्रतूणसमन्वितम् ।\nराजराजेश्वरं ज्ञेयं राजसम्पत्प्रदं नृणाम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7002974067, "chapter_id": 22974, "verse_number": "२-२१-६८", "content_sanskrit": "द्विसप्तचक्रं स्थूलं च नवीनजलदप्रभम् ।\nअनन्ताख्यं च विज्ञेयं चतुर्वर्गफलप्रदम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7002974068, "chapter_id": 22974, "verse_number": "२-२१-६९", "content_sanskrit": "चक्राकारं द्विचक्रं च सश्रीकं जलदप्रभम् ।\nसगोष्पदं मध्यमं च विज्ञेयं मधुसूद नम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7002974069, "chapter_id": 22974, "verse_number": "२-२१-७०", "content_sanskrit": "सुदर्शनं चैकचक्रं गुप्तचक्रं गदाधरम् ।\nद्विचक्रं हयवक्त्राभं हयग्रीवं प्रकीर्त्तितम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7002974070, "chapter_id": 22974, "verse_number": "२-२१-७१", "content_sanskrit": "अतीव विस्तृतास्यं च द्विचक्रं विकटं सति ।\nनरसिंहाभिधं ज्ञेयं सद्यो वैराग्यदं नृणाम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7002974071, "chapter_id": 22974, "verse_number": "२-२१-७२", "content_sanskrit": "द्विचक्रं विस्तृतास्यं च वनमालासमन्वितम् ।\nलक्ष्मीनृसिंहं विज्ञेयं गृहिणां सुखदं सदा ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7002974072, "chapter_id": 22974, "verse_number": "२-२१-७३", "content_sanskrit": "द्वारदेशे द्विचक्रं च सश्रीकं च समं स्फुटम् ।\nवासुदेवं च विज्ञेयं सर्वकामफलप्रदम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7002974073, "chapter_id": 22974, "verse_number": "२-२१-७४", "content_sanskrit": "प्रद्युम्नं सूक्ष्मचक्रं च नवीननीरदप्रभम् ।\nसुषिरे च्छिद्रबहुलं गृहिणां च सुखप्रदम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7002974074, "chapter_id": 22974, "verse_number": "२-२१-७५", "content_sanskrit": "द्वे चक्रे चैकलग्ने च पृष्ठे यत्र तु पुष्कलम् ।\nसंकर्षणं तु विज्ञेयं सुखदं गृहिणां सदा ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7002974075, "chapter_id": 22974, "verse_number": "२-२१-७६", "content_sanskrit": "अनिरुद्धं तु पीताभं वर्तुलं चातिशोभनम् ।\nसुखप्रदं गृहस्थानां प्रवदन्ति मनी षिणः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7002974076, "chapter_id": 22974, "verse_number": "२-२१-७७", "content_sanskrit": "शालग्रामशिला यत्र तत्र सन्निहितो हरिः ।\nतत्रैव लक्ष्मीर्वसति सर्वतीर्थसमन्विता ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7002974077, "chapter_id": 22974, "verse_number": "२-२१-७८", "content_sanskrit": "यानि कानि च पापानि ब्रह्महत्यादिकानि च ।\nतानि सर्वाणि नश्यंति शालग्रामशिलार्च्चनात् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7002974078, "chapter_id": 22974, "verse_number": "२-२१-७९", "content_sanskrit": "छत्राकारं भवेद्राज्यं वर्तुले च महाश्रियः ।\nदुःखं च शकटाकारे शूलाग्रे मरणं धुवम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7002974079, "chapter_id": 22974, "verse_number": "२-२१-८०", "content_sanskrit": "विकृतास्ये च दारिद्र्यं पिङ्गले हानिरेव च ।\nलग्नचक्रे भवेद्व्याधिर्विदीर्णे मरणं धुवम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7002974080, "chapter_id": 22974, "verse_number": "२-२१-८१", "content_sanskrit": "व्रतं दानं प्रतिष्ठा च श्राद्धं च देवपूजनम् ।\nशालग्रामशिलायाश्चैवाधिष्ठानात्प्रशस्तकम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7002974081, "chapter_id": 22974, "verse_number": "२-२१-८२", "content_sanskrit": "स स्नातः सर्वतीर्थेषु सर्वयज्ञेषु दीक्षितः ।\nशालग्रामशिलातोयैर्योऽभिषेकं समाचरेत् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7002974082, "chapter_id": 22974, "verse_number": "२-२१-८३", "content_sanskrit": "सर्वदानेषु यत्पुण्यं प्रादक्षिण्ये भुवो यथा ।\nसर्वयज्ञेषु तीर्थेषु व्रतेष्वनशनेषु च ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7002974083, "chapter_id": 22974, "verse_number": "२-२१-८४", "content_sanskrit": "तस्य स्पर्शं च वाञ्छन्ति तीर्थानि निखिलानि च ।\nजीवन्मुक्तो महापूतो भवेदेव न संशयः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7002974084, "chapter_id": 22974, "verse_number": "२-२१-८५", "content_sanskrit": "पाठे चतुर्णां वेदानां तपसां करणे सति ।\nतत्पुण्यं लभते नृनं शालग्रामशिलार्चनात् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7002974085, "chapter_id": 22974, "verse_number": "२-२१-८६", "content_sanskrit": "शालग्रामशिलातोयं नित्यं भुङ्क्ते च यो नरः ।\nसुरेप्सितं प्रसादं च जन्ममृत्युजराहरम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7002974086, "chapter_id": 22974, "verse_number": "२-२१-८७", "content_sanskrit": "तस्य स्पर्शं च वाञ्छन्ति तीर्थानि निखि लानि च ।\nजीवन्मुक्तो महापूतोऽप्यन्ते याति हरेः पदम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7002974087, "chapter_id": 22974, "verse_number": "२-२१-८८", "content_sanskrit": "तत्रैव हरिणा सार्द्धमसंख्यं प्राकृतं लयम् ।\nपश्यत्येव हि दास्ये च निर्मुक्तो दास्यकर्मणि ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7002974088, "chapter_id": 22974, "verse_number": "२-२१-८९", "content_sanskrit": "यानि कानि च पापानि ब्रह्महत्यादिकानि च ।\nतं च दृष्ट्वा भिया यान्ति वैनतेयमिवो रगाः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7002974089, "chapter_id": 22974, "verse_number": "२-२१-९०", "content_sanskrit": "तत्पादपद्मरजसा सद्यः पूता वसुन्धरा ।\nपुंसां लक्षं तत्पितॄणां निस्तारस्तस्य जन्मनः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7002974090, "chapter_id": 22974, "verse_number": "२-२१-९१", "content_sanskrit": "शालग्रामशिला तोयं मृत्युकाल च यो लभेत् ।\nसर्वपापाद्विनिर्मुक्तो विष्णुलोकं स गच्छति ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7002974091, "chapter_id": 22974, "verse_number": "२-२१-९२", "content_sanskrit": "निर्वाणमुक्तिं लभते कर्मभोगाद्विमुच्यते ।\nविष्णुपादे प्रलीनश्च भविष्यति न संशयः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7002974092, "chapter_id": 22974, "verse_number": "२-२१-९३", "content_sanskrit": "शालग्रामशिलां धृत्वा मिथ्यावादं वदेत्तु यः ।\nस याति कूर्मदंष्ट्रं च यावद्वै ब्रह्मणो वयः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7002974093, "chapter_id": 22974, "verse_number": "२-२१-९४", "content_sanskrit": "शालग्रामशिलां स्पृष्ट्वा स्वीकारं यो न पालयेत् ।\nस प्रयात्यसिपत्रं च लक्षमन्वन्तराधिकम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7002974094, "chapter_id": 22974, "verse_number": "२-२१-९५", "content_sanskrit": "तुलसीपत्र विच्छेदं शालग्रामे करोति यः ।\nतस्य जन्मान्तरे काले स्त्रीविच्छेदो भविष्यति ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7002974095, "chapter_id": 22974, "verse_number": "२-२१-९६", "content_sanskrit": "तुलसीपत्रविच्छेदं शंखे यो हि करोति च ।\nभार्य्याहीनो भवेत्सोऽपि रोगी च सप्तजन्मसु ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7002974096, "chapter_id": 22974, "verse_number": "२-२१-९७", "content_sanskrit": "शालग्रामं च तुलसीं शंखमेकत्र एव च ।\nयो रक्षति महाज्ञानी स भवे च्छ्रीहरिप्रियः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7002974097, "chapter_id": 22974, "verse_number": "२-२१-९८", "content_sanskrit": "सकृदेव हि यो यस्यां वीर्य्याधानं करोति यः ।\nतद्विच्छेदे तस्य दुःखं भवेदेव परस्परम् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7002974098, "chapter_id": 22974, "verse_number": "२-२१-९९", "content_sanskrit": "त्वं प्रिया शंखचूडस्य चैकमन्वन्तरावधि ।\nशंखेन सार्द्ध त्वद्भेदः केवलं दुःखदस्तव ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7002974099, "chapter_id": 22974, "verse_number": "२-२१-१००", "content_sanskrit": "इत्युक्त्वा श्रीहरिस्तां च विरराम च सादरम् ।\nस च देहं परित्यज्य दिव्यरूपं दधार ह ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7002974100, "chapter_id": 22974, "verse_number": "२-२१-१०१", "content_sanskrit": "यथा श्रीश्च तथा सा चाप्युवास हरिवक्षसि ।\nप्रजगाम तया सार्द्धं वैकुण्ठं कमला पतिः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7002974101, "chapter_id": 22974, "verse_number": "२-२१-१०२", "content_sanskrit": "लक्ष्मीः सरस्वती गङ्गा तुलसी चापि नारद ।\nहरेः प्रियाश्चतस्रश्च वभूवुरीश्वरस्य च ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7002974102, "chapter_id": 22974, "verse_number": "२-२१-१०३", "content_sanskrit": "सद्यस्तद्देहजाता च बभूव गण्डकी नदी ।\nहरेरंशेन शैलश्च तत्तीरे पुण्यदो नृणाम् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7002974103, "chapter_id": 22974, "verse_number": "२-२१-१०४", "content_sanskrit": "कुर्वन्ति तत्र कीटाश्च शिलां बहुविधां मुने ।\nजले पतन्ति या याश्च जलदाभाश्च निश्चितम् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7002974104, "chapter_id": 22974, "verse_number": "२-२१-१०५", "content_sanskrit": "स्थलस्थाः पिङ्गला ज्ञेयाश्चोपतापाद्धरेरिति ।\nइत्येवं कथितं सर्वं किं भूयः श्रोतुमिच्छसि ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}]