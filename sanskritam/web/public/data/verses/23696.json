[{"id": 7003696000, "chapter_id": 23696, "verse_number": "१-४-४-१", "content_sanskrit": "नंदिकेश्वर उवाच ।\nमुने मनःपरीक्षार्थं तथा त्वं भाषितो मया ।\nतव चेन्नाभिधास्यामि कस्य वान्यस्य कथ्यते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003696001, "chapter_id": 23696, "verse_number": "१-४-४-२", "content_sanskrit": "त्वादृगन्योस्ति किं लोके शिवधर्मपरायणः ।\nयेन स्वल्पायुषाप्येवं नित्येनाभावि भक्तितः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003696002, "chapter_id": 23696, "verse_number": "१-४-४-३", "content_sanskrit": "कस्यान्यस्य कृते देवः स्वस्यैवाज्ञाकरं यमम् ।\nक्रुद्धो नियंत्रयामास चरणांगुष्ठपीडितम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003696003, "chapter_id": 23696, "verse_number": "१-४-४-४", "content_sanskrit": "त्वमेव शांकरान्धर्मान्सर्वान्विद्धि रहस्यतः ।\nयोग्रेऽसि कालवद्भ्रांतः परिपक्वोसि चेतसा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003696004, "chapter_id": 23696, "verse_number": "१-४-४-५", "content_sanskrit": "त्वयैवान्येन केनाहमेवं शुश्रूषितश्चिरम् ।\nत्वयीव कस्मिन्नन्यस्मिन्ममापि प्रीतिरीदृशी ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003696005, "chapter_id": 23696, "verse_number": "१-४-४-६", "content_sanskrit": "उपदेक्ष्यामि ते क्षेत्रं गुप्तं तद्धर्मशासनैः ।\nभक्त्यावधारणीयं यद्भक्तिकैवल्यकांक्षिभिः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003696006, "chapter_id": 23696, "verse_number": "१-४-४-७", "content_sanskrit": "आदरादनुयुंजानं शिष्यं यो देशिकः स्वयम् ।\nउपदेशेन संतुष्टं न करोति स किं गुरुः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003696007, "chapter_id": 23696, "verse_number": "१-४-४-८", "content_sanskrit": "समाहितमना भूत्वा विश्वासं कुरु शाश्वतम् ।\nमयोपदिश्यमानेऽस्मिन्रहस्ये पारमेश्वरे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003696008, "chapter_id": 23696, "verse_number": "१-४-४-९", "content_sanskrit": "स्मर स्मरांतकं देवं वंदस्वाध्याय शांकरीम् ।\nउपांशूच्चारयोंकारं श्रेयस्ते महदागतम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003696009, "chapter_id": 23696, "verse_number": "१-४-४-१०", "content_sanskrit": "अस्ति दक्षिणदिग्भागे द्राविडेषु तपोधन ।\nअरुणाख्यं महाक्षेत्रं तरुणेंदुशिखामणेः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003696010, "chapter_id": 23696, "verse_number": "१-४-४-११", "content_sanskrit": "योजनत्रयविस्तीणमुपास्यं शिवयोगिभिः ।\nतद्भूमेर्हृदयं विद्धि शिवस्य हृदयंगमम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003696011, "chapter_id": 23696, "verse_number": "१-४-४-१२", "content_sanskrit": "तत्र देवः स्वयं शम्भुः पर्वताकारतां गतः ।\nअरुणाचलसंज्ञावानस्ति लोकहितावहः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003696012, "chapter_id": 23696, "verse_number": "१-४-४-१३", "content_sanskrit": "आवासः सर्वसिद्धानां महर्षीणां सुपर्वणाम् ।\nविद्याधराणां यक्षाणां गंधर्वाप्सरसामपि ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003696013, "chapter_id": 23696, "verse_number": "१-४-४-१४", "content_sanskrit": "सुमेरोरपि कैलासादप्यसौ मन्दरादपि ।\nमाननीयो महर्षीणां यः स्वयं परमेश्वरः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003696014, "chapter_id": 23696, "verse_number": "१-४-४-१५", "content_sanskrit": "स्पृहयंति यदीयेभ्यो जंतुभ्योपि दिवौकसः ।\nअयत्नलभ्यमुक्तिभ्यो दिवावासप्रवंचिताः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003696015, "chapter_id": 23696, "verse_number": "१-४-४-१६", "content_sanskrit": "न कल्पवृक्षाः सदृशा यत्रत्यानां महीरुहाम् ।\nपत्रपुष्पफलैर्नित्यं येर्चयंति गिरौ हरम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003696016, "chapter_id": 23696, "verse_number": "१-४-४-१७", "content_sanskrit": "हिंसैकरुचयो व्याधा अपि रूपानुसारतः ।\nअनंता यत्र देवस्य प्रादक्षिण्यफलास्पदम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003696017, "chapter_id": 23696, "verse_number": "१-४-४-१८", "content_sanskrit": "यदुद्देशचरा मेघाः शिखराण्यभिबंधकाः ।\nगंगावतो हिमवतोऽप्यधिकं स्वं विजानते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003696018, "chapter_id": 23696, "verse_number": "१-४-४-१९", "content_sanskrit": "कलारावाः खगा यत्र क्वणंते कीचका अपि ।\nयक्षकिंनरगन्धर्वैलभ्यते दुर्लभं पदम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003696019, "chapter_id": 23696, "verse_number": "१-४-४-२०", "content_sanskrit": "स्मरन्तो यत्र खद्योताः कृष्णपक्षे निशागमे ।\nआरार्तिकप्रदातॄणां देवस्याश्नुवते पदम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003696020, "chapter_id": 23696, "verse_number": "१-४-४-२१", "content_sanskrit": "निष्प्रत्यूहकृताश्लेषा नित्यं यत्तटिनीरुहाः ।\nसौभीग्यगर्वतो देवीमपर्णामवमन्वते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003696021, "chapter_id": 23696, "verse_number": "१-४-४-२२", "content_sanskrit": "यस्योत्तुंगस्य शृंगाग्रसंगमा अपि तारकाः ।\nआत्मनो लब्धसामान्याश्चन्द्रेण बहु मन्वते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003696022, "chapter_id": 23696, "verse_number": "१-४-४-२३", "content_sanskrit": "मृगाः सर्वेपि सततं चरंतो यत्र सानुषु ।\nपाणिप्रणयिनं शम्भोरेणमप्यवजानते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003696023, "chapter_id": 23696, "verse_number": "१-४-४-२४", "content_sanskrit": "यस्य पादांतिकचरैः प्रायेण शबरैरपि ।\nनिकुम्भकुम्भसादृश्यमयत्नादुपलभ्यते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003696024, "chapter_id": 23696, "verse_number": "१-४-४-२५", "content_sanskrit": "किं बहूक्त्याभ्यसूयंते द्वैमातुरकुमारयोः ।\nयदंगरूढास्तरवस्तिर्यंचः शबरा अपि ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003696025, "chapter_id": 23696, "verse_number": "१-४-४-२६", "content_sanskrit": "सिंहव्याघ्रद्विपा यस्मिन्काले त्यक्तकलेवराः ।\nवासप्रदत्वान्मान्यंते ध्रुवं शोणाद्रिशम्भुना ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003696026, "chapter_id": 23696, "verse_number": "१-४-४-२७", "content_sanskrit": "अस्य भास्करनामाद्रिः पूर्वस्यां दिशि दृश्यते ।\nयत्र स्थितः सदा वज्री सेवते शोणपर्वतम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003696027, "chapter_id": 23696, "verse_number": "१-४-४-२८", "content_sanskrit": "प्रतीच्यां दिशि दंडाद्रिरिति कश्चिन्महीधरः ।\nप्राचेतसस्तदगगः सेवतेऽरुणपर्वतम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003696028, "chapter_id": 23696, "verse_number": "१-४-४-२९", "content_sanskrit": "दक्षिणस्यां च शोणाद्रेरद्रिरस्त्यमराचलः ।\nकालः शोणाद्रिसेवार्थमध्यास्ते तदधित्यकाम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003696029, "chapter_id": 23696, "verse_number": "१-४-४-३०", "content_sanskrit": "उत्तरेऽस्मिन्हरिद्भागे सिद्धाध्यासितकन्दरः ।\nविराजते त्रिशूलाद्रिः श्रीदेन परिपालितः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003696030, "chapter_id": 23696, "verse_number": "१-४-४-३१", "content_sanskrit": "तत्पर्यंतप्रभूतानामन्येषामपि भूभृताम् ।\nतटकेष्वपरे चैव दिक्पालाः पर्युपासते ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003696031, "chapter_id": 23696, "verse_number": "१-४-४-३२", "content_sanskrit": "धारिता येन सततं सर्वेपि धरणीरुहाः ।\nआराधनादप्यधिकमधिगच्छंति वैभवम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003696032, "chapter_id": 23696, "verse_number": "१-४-४-३३", "content_sanskrit": "यस्मिन्गिरीशे संदृष्टे मेनातुहिनभूभृतोः ।\nसमानसंबंधतया प्रमोदो वर्द्धतेतराम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003696033, "chapter_id": 23696, "verse_number": "१-४-४-३४", "content_sanskrit": "तरुपल्लवलक्षेण लक्ष्यमाणजटाधरः ।\nस्थावरोयं स्वयं शम्भुरिहेश इव जंगमः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003696034, "chapter_id": 23696, "verse_number": "१-४-४-३५", "content_sanskrit": "ज्योतिष्मत्तोयशृंगस्य द्विपार्श्वस्थेन्दुभास्करः ।\nव्यनक्ति स्वस्य लोकेभ्यस्तेजस्त्रितयनेत्रताम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003696035, "chapter_id": 23696, "verse_number": "१-४-४-३६", "content_sanskrit": "वर्षासु शिखराधस्तादभिनीलबलाहकः ।\nविराजते यः कण्ठेन कालकूटमिवोद्वहन् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003696036, "chapter_id": 23696, "verse_number": "१-४-४-३७", "content_sanskrit": "सहस्रपादः साहस्रशीर्षो यः पर्वतेश्वरः ।\nउक्तो न केवलं श्रुत्या साक्षादप्युपलक्ष्यते ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003696037, "chapter_id": 23696, "verse_number": "१-४-४-३८", "content_sanskrit": "शिरोलीनामरसरित्स्रोताः प्रागिति नाद्भुतम् ।\nगिरीशोऽद्यापि यः शृंगलीनानेकसरिद्गणः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003696038, "chapter_id": 23696, "verse_number": "१-४-४-३९", "content_sanskrit": "आसादितापकटकः शारदैर्यः पयोधरैः ।\nविडंबयति गोश्रेष्ठमारूढवृषपुंगवम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003696039, "chapter_id": 23696, "verse_number": "१-४-४-४०", "content_sanskrit": "यत्र शृङ्गाग्रसंलग्रसंलग्ननीललोहितः ।\nस्थाणुत्वं स्थावरत्वेन गहनत्वेन भीमताम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003696040, "chapter_id": 23696, "verse_number": "१-४-४-४१", "content_sanskrit": "सुदुर्गमत्वादुग्रत्वमपि धत्ते न नामतः ।\nक्षुद्राः सरीसृपा यत्र कटकेषु कृतास्पदाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003696041, "chapter_id": 23696, "verse_number": "१-४-४-४२", "content_sanskrit": "तक्षकानंतसर्पाद्यैः स्पर्धन्ते भुजगेश्वरैः ।\nअष्टाभिर्योऽभितः कोणैराविभूर्तो विभूतिभिः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003696042, "chapter_id": 23696, "verse_number": "१-४-४-४३", "content_sanskrit": "सुस्पष्टं विशिनष्टीव स्वकीयामष्टमूर्तिताम् ।\nयेर्ण्याशक्तितरंगिण्यो इडापिंगलयोः स्वयम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003696043, "chapter_id": 23696, "verse_number": "१-४-४-४४", "content_sanskrit": "शिवस्य शृङ्गतो मध्ये सुषुम्ना कमलापगा ।\nज्योतिःस्तंभस्वरूपस्य मूलाग्रे यस्य वीक्षतुम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003696044, "chapter_id": 23696, "verse_number": "१-४-४-४५", "content_sanskrit": "कोलहंसाकृती नालं ब्रह्मविष्णू बभूवतुः ।\nताभ्यां च प्रार्थितः शम्भुस्तस्मिन्सांनिध्यवानभूत् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003696045, "chapter_id": 23696, "verse_number": "१-४-४-४६", "content_sanskrit": "अरुणाचलनाथाख्यं प्रपन्नः प्रमदैः समम् ।\nगौतमस्तत्र योगींद्रः सहस्रं परिवत्सरान् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003696046, "chapter_id": 23696, "verse_number": "१-४-४-४७", "content_sanskrit": "तप्त्वा तपांसि तीव्राणि साक्षाच्चक्रे सदाशिवम् ।\nप्रालेयशैलकन्यापि तत्र कृत्वा तपः पुरा ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003696047, "chapter_id": 23696, "verse_number": "१-४-४-४८", "content_sanskrit": "अलब्ध वामदेहार्द्धं मन्मथारेः प्रसेदुषः ।\nगौर्या प्रतिष्ठितं तत्र प्रवालाद्रीश्वराभिधम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003696048, "chapter_id": 23696, "verse_number": "१-४-४-४९", "content_sanskrit": "लिंगं भोगप्रदं पुंसां कैवल्याय प्रकल्पते ।\nतत्र गौरीनिदेशेन दुर्गा महिषमर्दिनी ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003696049, "chapter_id": 23696, "verse_number": "१-४-४-५०", "content_sanskrit": "साक्षाद्भूय सतां दत्ते मन्त्रसिद्धिमविघ्नतः ।\nखड्गतीर्थमिति ख्यातं तत्र गौर्याश्रमे नवम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003696050, "chapter_id": 23696, "verse_number": "१-४-४-५१", "content_sanskrit": "सकृन्निमज्जनान्नॄणां पंचपातकनाशनम् ।\nदुर्गया चार्चितं लिंगं पापनाशननामकम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003696051, "chapter_id": 23696, "verse_number": "१-४-४-५२", "content_sanskrit": "सकृत्प्रणाममात्रेण सर्वपापप्रणाशनम् ।\nतत्र वज्रांगदो राजा वित्तसारो व्यतिक्रमात् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003696052, "chapter_id": 23696, "verse_number": "१-४-४-५३", "content_sanskrit": "पुनस्तद्भक्तिमाहात्म्याच्छिवसायुज्यमाप्तवान् ।\nतस्य प्रदक्षिणेनैव कांतिशालिकलाधरौ ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003696053, "chapter_id": 23696, "verse_number": "१-४-४-५४", "content_sanskrit": "विद्याधरेश्वरौ मुक्तौ दुर्वासःशापबन्धनात् ।\nनास्ति शोणाद्रितः क्षेत्रं नास्ति पंचाक्षरान्मनुः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003696054, "chapter_id": 23696, "verse_number": "१-४-४-५५", "content_sanskrit": "नास्ति माहेश्वराद्धर्मो नास्ति देवो महेश्वरात् ।\nनास्ति ज्ञानं शिवज्ञानान्नास्ति श्रीरुद्रतः श्रुतिः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003696055, "chapter_id": 23696, "verse_number": "१-४-४-५६", "content_sanskrit": "नास्ति शैवाग्रणीर्विष्णोर्नास्ति रक्षा विभूतितः ।\nनास्ति भक्तेः सदाचारो नास्ति रक्षाकराद्गुरुः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003696056, "chapter_id": 23696, "verse_number": "१-४-४-५७", "content_sanskrit": "नास्ति रुद्राक्षतो भूषा नास्ति शास्त्रं शिवागमात् ।\nनास्ति बिल्वदलात्पत्रं नास्ति पुष्पं सुवर्णकात् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003696057, "chapter_id": 23696, "verse_number": "१-४-४-५८", "content_sanskrit": "नास्ति वैराग्यतः सौख्यं नास्ति मुक्तेः परं पदम् ।\nनारुणाद्रेः समो मेरुर्न कैलासो न मंदरः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003696058, "chapter_id": 23696, "verse_number": "१-४-४-५९", "content_sanskrit": "ते निवासा गिरिव्याप्ताः सोऽयं तु गिरिशः स्वयम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003696059, "chapter_id": 23696, "verse_number": "१-४-४-६०", "content_sanskrit": "इति वदति शिलादनंदने मुदितमनाः स मृकण्डुनंदनः ।\nपुनरपि बहुशः प्रणम्य तं चकितमना भवतो व्यजिज्ञपत् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003696060, "chapter_id": 23696, "verse_number": "१-४-४-६१", "content_sanskrit": "किं किं नृणां कर्म भवाय जायते कथं नु तत्तन्नरकाय श्रूयते ।\nतेषां च तेषां च कथं प्रतिक्रिया कथं नु तत्तन्मम कथ्यतामिति ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]