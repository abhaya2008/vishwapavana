[{"id": 2174859, "chapter_id": 4710, "verse_number": "", "content_sanskrit": "एकतद्वितत्रितनामकानां विप्राणां कथा ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2174860, "chapter_id": 4710, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2174861, "chapter_id": 4710, "verse_number": "१", "content_sanskrit": "तस्मान्नदीगतं चापि उदपानं महात्मनः ।\nत्रितस्य च महाराज जगामाथ हलायुधः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2174862, "chapter_id": 4710, "verse_number": "२", "content_sanskrit": "तत्र दत्वा बहु द्रव्यं पूजयित्वा च वै द्विजान् ।\nउपस्पृश्य तु तत्रैव प्रहृष्टो मुसलायुधः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2174863, "chapter_id": 4710, "verse_number": "३", "content_sanskrit": "तत्र धर्मपरो ह्यासीत् त्रितस्तु सुमहातपाः ।\nकूपे च वसता तेन सोमः पीतो महात्मना\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2174864, "chapter_id": 4710, "verse_number": "४", "content_sanskrit": "तत्र चैनं समुत्सृज्य भ्रातरौ जग्मतुर्गृहान् ।\nततस्तु तौ शशापाथ त्रितो ब्राह्मणपुङ्गवः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2174865, "chapter_id": 4710, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2174866, "chapter_id": 4710, "verse_number": "५", "content_sanskrit": "उदपानं कथं ब्रह्मन् कथं च सुमहातपाः ।\nपतितः किञ्च सन्त्यक्तो भ्रातृभ्यां द्विजसत्तम\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2174867, "chapter_id": 4710, "verse_number": "६", "content_sanskrit": "कूपे कथं च हित्वैनं जग्मतुर्भ्रातरौ गृहान् ।\nएतदाचक्ष्व मे ब्रह्मन् यदि श्राव्यं हि मन्यसे\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2174868, "chapter_id": 4710, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2174869, "chapter_id": 4710, "verse_number": "७", "content_sanskrit": "आसन् पूर्वयुगे राजन् मुनयो भ्रातरस्त्रयः ।\nएकतश्च द्वितश्चैव त्रितश्चादित्यसन्निभाः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2174870, "chapter_id": 4710, "verse_number": "८", "content_sanskrit": "सर्वे प्रजापतिसमाः प्रजापतय एव च ।\nब्रह्मलोकजिताः सर्वे तपसा ब्रह्मवादिनः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2174871, "chapter_id": 4710, "verse_number": "९", "content_sanskrit": "तेषां तु तपसा प्रीतो नियमेन यमेन च ।\nअभवद् गौतमो नित्यं पिता धर्मरतः सदा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2174872, "chapter_id": 4710, "verse_number": "१०", "content_sanskrit": "स तु दीर्घेण कालेन तेषां प्रीतिमवाप्य च ।\nजगाम भगवन् स्थानमनुरूपमिवात्मनः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2174873, "chapter_id": 4710, "verse_number": "११", "content_sanskrit": "राजानस्तस्य ये चापि याज्या ह्यासन् महात्मनः ।\nते सर्वे स्वर्गते तस्मिन् तस्य पुत्रानपूजयन्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2174874, "chapter_id": 4710, "verse_number": "१२", "content_sanskrit": "तेषां तु कर्मणा राजन् तपसाऽध्ययनेन च ।\nत्रितः श्रेष्ठत्वमापेदे यथा चास्य पिता तथा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2174875, "chapter_id": 4710, "verse_number": "१३", "content_sanskrit": "ते स्म सर्वे महाभागा मुनयः पुण्यलक्षणाः ।\nअपूजयन् महाभागं तथा विद्वांस एव च\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2174876, "chapter_id": 4710, "verse_number": "१४", "content_sanskrit": "कदाचिद्धि ततो राजन् भ्रातरावेकतद्वितौ ।\nयज्ञार्थं चक्रतुश्चिन्तां धनार्थं च विशेषतः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2174877, "chapter_id": 4710, "verse_number": "१५", "content_sanskrit": "तयोश्चिन्ता समभवत् तं प्रगृह्य परन्तप\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2174878, "chapter_id": 4710, "verse_number": "१६", "content_sanskrit": "याज्यान् सर्वानुपादाय परिगृह्य पशूंस्ततः ।\nसोमं पास्यामहे हृष्टाः प्राप्य यज्ञं महाफलम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2174879, "chapter_id": 4710, "verse_number": "१७", "content_sanskrit": "चक्रुश्चैव तदा राजन् भ्रातरस्त्रय एव च\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2174880, "chapter_id": 4710, "verse_number": "१८", "content_sanskrit": "तथा हि ते परिक्रम्य याज्यान् सर्वान् पशून् प्रति ।\nयाजयित्वा ततो याज्याँल्लब्ध्वा च सुबहून् पशून्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2174881, "chapter_id": 4710, "verse_number": "१९", "content_sanskrit": "याज्येन कर्मणा तेन प्रतिगृह्य विधानतः ।\nप्राचीं दिशं महाराज आजग्मुस्ते महर्षयः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2174882, "chapter_id": 4710, "verse_number": "२०", "content_sanskrit": "त्रितस्तेषां महाराज पुरस्ताद् याति हृष्टवत् ।\nएकतश्च द्वितश्चैव पृष्ठतः कालयन् पशून्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2174883, "chapter_id": 4710, "verse_number": "२१", "content_sanskrit": "तयोश्चिन्ता समभवद् एकतस्य द्वितस्य च ।\nकथं नु स्युरिमा गाव आवाभ्यां च त्रितं विना\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2174884, "chapter_id": 4710, "verse_number": "२२", "content_sanskrit": "तावन्योन्यं समाभाष्य एकतश्च द्वितश्च ह ।\nयदूचतुर्मिथः पापौ तन्निबोध जनाधिप\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2174885, "chapter_id": 4710, "verse_number": "", "content_sanskrit": "एकतद्वितौ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2174886, "chapter_id": 4710, "verse_number": "२३", "content_sanskrit": "त्रितो यज्ञेषु कुशलः त्रितो वेदेषु निष्ठितः ।\nअन्यास्त्रितो बहुतरा गावः समुपलप्स्यते\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2174887, "chapter_id": 4710, "verse_number": "२४", "content_sanskrit": "तेनावां सहितौ भूत्वा गाः प्रगृह्य प्रयावहे ।\nत्रितोऽपि गच्छेत् तं कामं भ्रातृभ्यां वै विनाकृतः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2174888, "chapter_id": 4710, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2174889, "chapter_id": 4710, "verse_number": "२५", "content_sanskrit": "तेषामागच्छतां रात्रौ पथि स्थाने वृकोऽभवत् ।\nतथा कूपोऽविदूरोऽभूत् सरस्वत्यास्तटीगतः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2174890, "chapter_id": 4710, "verse_number": "२६", "content_sanskrit": "अथ त्रितो वृकं दृष्ट्वा पथि तिष्ठन्तमग्रतः ।\nतद्भयादपसर्पन् वै तस्मिन् कूपे पपात ह\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2174891, "chapter_id": 4710, "verse_number": "२७", "content_sanskrit": "अगाधे सुमहाघोरे सर्वभूतभयङ्करे\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2174892, "chapter_id": 4710, "verse_number": "२८", "content_sanskrit": "त्रितस्ततो महाभागः कूपस्थो मुनिसत्तमः ।\nआर्तनादं महच्चक्रं ततः शुश्रुवतुर्मुनी\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2174893, "chapter_id": 4710, "verse_number": "२९", "content_sanskrit": "तं ज्ञात्वा पतितं कूपे भ्रातरावेकतद्वितौ ।\nवृकत्रासाच्च लोभाच्च तमुत्सृज्य प्रजग्मतुः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2174894, "chapter_id": 4710, "verse_number": "३०", "content_sanskrit": "भ्रातृभ्यां पशुलुब्धाभ्यामुत्सृष्टः सुमहातपाः ।\nउदपाने तदा राजन् निर्जले पांसुसंवृते\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2174895, "chapter_id": 4710, "verse_number": "३१", "content_sanskrit": "त्रित आत्मानमालक्ष्य वीरुत्पुञ्जतृणावृते ।\nनिमग्नो भरतश्रेष्ठ पापकृन्नरके यथा\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2174896, "chapter_id": 4710, "verse_number": "३२", "content_sanskrit": "स बुद्ध्याऽगणयत् प्राज्ञो मृत्योर्भीतो ह्यसोमपः ।\nसोमः कथं नु पातव्य इहस्थेन मया भवेत्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2174897, "chapter_id": 4710, "verse_number": "३३", "content_sanskrit": "स एवमभिसञ्चिन्त्य तस्मिन् कूपे महातपाः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2174898, "chapter_id": 4710, "verse_number": "३४", "content_sanskrit": "ददर्श वीरुधां जालं लम्बमानं यदृच्छया\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2174899, "chapter_id": 4710, "verse_number": "३५", "content_sanskrit": "पांसुग्रस्ते ततः कूपे न्यखनत् सलिलं मुनिः ।\nअग्निं सङ्कल्पयामास होतॄनात्मानमेव हि\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2174900, "chapter_id": 4710, "verse_number": "३६", "content_sanskrit": "ततस्तां वीरुधं सोमं कल्पयित्वा महातपाः ।\nऋचो यजूंषि सामानि मनसाऽचिन्तयन्मुनिः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2174901, "chapter_id": 4710, "verse_number": "३७", "content_sanskrit": "ग्रावाणः शर्कराः कृत्वा प्रचक्रेऽभिषवं नृप\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2174902, "chapter_id": 4710, "verse_number": "३८", "content_sanskrit": "आज्यं च सलिलं चक्रे भागांश्च त्रिदिवौकसाम् ।\nसोमस्याभिषवस्याग्रे प्रवृद्धस्तुमुलो ध्वनिः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2174903, "chapter_id": 4710, "verse_number": "३९", "content_sanskrit": "स चाविशद् दिवं राजन् स्वरश्चैव त्रितस्य वै ।\nसमवाप च तं यज्ञं यथोक्तं ब्रह्मवादिभिः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2174904, "chapter_id": 4710, "verse_number": "४०", "content_sanskrit": "वर्तमाने तथा यज्ञे त्रितस्य सुमहात्मनः ।\nआविग्नं त्रिदिवं सर्वं कारणं न च बुद्ध्यते\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2174905, "chapter_id": 4710, "verse_number": "४१", "content_sanskrit": "ततस्तु तुमुलं शब्दं शुश्राव स बृहस्पतिः ।\nश्रुत्वैव चाब्रवीद् देवान् सर्वान् देवपुरोहितः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2174906, "chapter_id": 4710, "verse_number": "", "content_sanskrit": "बृहस्पतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2174907, "chapter_id": 4710, "verse_number": "४२", "content_sanskrit": "स तस्य वर्तते यज्ञः तत्र गच्छामहे सुराः ।\nस हि क्रुद्धः सृजेदन्यान् देवानपि महातपाः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2174908, "chapter_id": 4710, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2174909, "chapter_id": 4710, "verse_number": "४३", "content_sanskrit": "तच्छ्रुत्वा वचनं तस्य सहिताः सर्वदेवताः ।\nप्रययुस्तत्र यत्रास्ते त्रितो यज्ञश्च वर्तते\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2174910, "chapter_id": 4710, "verse_number": "४४", "content_sanskrit": "ते तत्र गत्वा विबुधास्तं कूपं यत्र स त्रितः ।\nददृशुस्तं महात्मानं दीक्षितं यज्ञकर्मणि\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2174911, "chapter_id": 4710, "verse_number": "४५", "content_sanskrit": "दृष्ट्वा चैनं महात्मानं श्रिया परमया युतम् ।\nऊचुश्चैनं महाराज प्राप्ता भागार्थिनो वयम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2174912, "chapter_id": 4710, "verse_number": "४६", "content_sanskrit": "अथाब्रवीद् ऋषिर्देवान् पश्यध्वं त्रिदिवौकसः ।\nअस्मिन् प्रतिभये कूपे निमग्नं नष्टचेतसम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2174913, "chapter_id": 4710, "verse_number": "४७", "content_sanskrit": "ततस्त्रितो महाराज भागांस्तेषां यथाविधि ।\nमन्त्रयुक्तान् समाजह्रे तेन प्रीतास्ततोऽभवन्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2174914, "chapter_id": 4710, "verse_number": "४८", "content_sanskrit": "ततो यथाविधि प्राप्तान् भागान् प्राप्य दिवौकसः ।\nप्रीतात्मानो ददुस्तस्मै वरान् यान् मनसेच्छति\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2174915, "chapter_id": 4710, "verse_number": "४९", "content_sanskrit": "स तु वव्रे वरं देवान् त्रातुमर्हथ मामिह ।\nयश्चेहापः स्पृशेत् कूपे स सोमपगतिं लभेत्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2174916, "chapter_id": 4710, "verse_number": "५०", "content_sanskrit": "तत्र चोर्मिमती राजन्नुत्पपात सरस्वती ।\nतयोत्क्षिप्तस्त्रितस्तस्थौ पूजयंस्त्रिदिवौकसः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2174917, "chapter_id": 4710, "verse_number": "५१", "content_sanskrit": "तथेति चोक्त्वा विबुधा जग्मू राजन् यथागतम् ।\nत्रितश्चाप्यगमत् प्रीतः स्वमेव भवनं तदा\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2174918, "chapter_id": 4710, "verse_number": "५२", "content_sanskrit": "क्रुद्धः स तु समासाद्य तावृषी भ्रातरौ तदा ।\nउवाच परुषं वाक्यं शशाप च परन्तप\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2174919, "chapter_id": 4710, "verse_number": "", "content_sanskrit": "त्रितः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2174920, "chapter_id": 4710, "verse_number": "५३", "content_sanskrit": "पशुलुब्धौ युवां यस्मान्मामुत्सृज्य प्रधावितौ ।\nतस्माद् रूपेण तासां वै दंष्ट्रिणामभितश्चरौ\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2174921, "chapter_id": 4710, "verse_number": "५४", "content_sanskrit": "भवितारौ मया शप्तौ प्राप्तेनानेन कर्मणा ।\nपशवश्चैव युवयोर्गोलाङ्गूलर्क्षवानराः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2174922, "chapter_id": 4710, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2174923, "chapter_id": 4710, "verse_number": "५५", "content_sanskrit": "इत्युक्तेऽथ तदा तेन क्षणादेव विशाम्पते ।\nतथाभूतावदृश्येतां वचनात् सत्यवादिनः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2174924, "chapter_id": 4710, "verse_number": "५६", "content_sanskrit": "तत्राप्यमितविक्रान्तः स्पृष्ट्वा तोयं हलायुधः ।\nदत्वा च विविधान् देयान् पूजयित्वा च वै द्विजान्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2174925, "chapter_id": 4710, "verse_number": "५७", "content_sanskrit": "उदपानं च तद् दृष्ट्वा प्रशस्य च पुनः पुनः ।\nनदीगतममेयात्मा प्राप्तो विनशनं तदा\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2174926, "chapter_id": 4710, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां गदापर्वणि बलभद्रस्य तीर्थयात्रावर्णनं नाम अष्टमोऽध्यायः ॥८॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]