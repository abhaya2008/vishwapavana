[{"id": 2198467, "chapter_id": 5221, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2198468, "chapter_id": 5221, "verse_number": "१", "content_sanskrit": "विपुलस्त्वकरोत् तीव्रं तपः कृत्वा गुरोर्वचः ।\nतपोयुक्तमथात्मानममन्यत च वीर्यवान्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2198469, "chapter_id": 5221, "verse_number": "२", "content_sanskrit": "स तेन कर्मणा स्पर्धन् पृथिवीं पृथिवीपते ।\nचचार गतभीः प्रीतो लब्धकीर्तिर्वरो नृषु\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2198470, "chapter_id": 5221, "verse_number": "३", "content_sanskrit": "उभौ लोकौ जितौ चापि तथैवामन्यत प्रभुः ।\nकर्मणा तेन कौरव्य तपसा विपुलेन च\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2198471, "chapter_id": 5221, "verse_number": "४", "content_sanskrit": "अथ काले व्यतिक्रान्ते कस्मिंश्चित्कुरुनन्दन ।\nरुच्या भगिन्या दानं वै बभूव धनधान्यवत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2198472, "chapter_id": 5221, "verse_number": "५", "content_sanskrit": "एतस्मिन्नेव काले तु दिव्या काचिद् वराङ्गना ।\nबिभ्रती परमं रूपं जगामाथ विहायसा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2198473, "chapter_id": 5221, "verse_number": "६", "content_sanskrit": "तस्याः शरीरात् पुष्पाणि पतितानि महीतळे ।\nतस्याश्रमस्याविदूरे दिव्यगन्धानि भारत\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2198474, "chapter_id": 5221, "verse_number": "७", "content_sanskrit": "तान्यगृह्णात् ततो राजन् रुचिर्नळिनलोचना ।\nतदा निमन्त्रकस्तस्या अङ्गेभ्यः क्षिप्रमागमत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2198475, "chapter_id": 5221, "verse_number": "८", "content_sanskrit": "तस्या हि भगिनी तात ज्येष्ठा नाम्ना प्रभावती ।\nभार्या चित्ररथस्याथ बभूवाङ्गेश्वरस्य वै\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2198476, "chapter_id": 5221, "verse_number": "९", "content_sanskrit": "पिनह्य तानि पुष्पाणि केशेषु वरवर्णिनी ।\nआमन्त्रिता ततोऽगच्छद् रुचिरङ्गपतेर्गृहान्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2198477, "chapter_id": 5221, "verse_number": "१०", "content_sanskrit": "पुष्पाणि तानि दृष्ट्वाऽथ तदाऽङ्गेन्द्रवराङ्गना ।\nभगिनीं चोदयामास पुष्पार्थे चारुलोचना\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2198478, "chapter_id": 5221, "verse_number": "११", "content_sanskrit": "सा भर्त्रे सर्वमाचष्ट रुचिः सुरुचिरानना ।\nभगिन्या भाषितं सर्वमृषिस्तच्चाभ्यनन्दत\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2198479, "chapter_id": 5221, "verse_number": "१२", "content_sanskrit": "ततो विपुलमानाय्य देवशर्मा महातपाः ।\nपुष्पार्थे चोदयामास गच्छ गच्छेति भारत\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2198480, "chapter_id": 5221, "verse_number": "१३", "content_sanskrit": "विपुलस्तु गुरोर्वाक्यमविचार्य महातपाः ।\nस तथेत्यब्रवीद् राजंस्तं च देशं जगाम ह\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2198481, "chapter_id": 5221, "verse_number": "१४", "content_sanskrit": "यस्मिन् देशे तु तान्यासन् पतितानि नभस्तळात् ।\nअम्लानान्यपि तत्रासन् कुसुमान्यपराण्यपि\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2198482, "chapter_id": 5221, "verse_number": "१५", "content_sanskrit": "ततः स तानि जग्राह दिव्यानि रुचिराणि च ।\nप्राप्तानि स्वेन तपसा दिव्यगन्धानि भारत\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2198483, "chapter_id": 5221, "verse_number": "१६", "content_sanskrit": "सम्प्राप्य तानि प्रीतात्मा गुरोर्वचनकारकः ।\nततो जगाम तूर्णं च चम्पां चम्पकमालिनीम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2198484, "chapter_id": 5221, "verse_number": "१७", "content_sanskrit": "स वने विजने तात ददर्श मिथुनं नृणाम् ।\nचक्रवत् परिवर्तन्तं गृहीत्वा पाणिना करम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2198485, "chapter_id": 5221, "verse_number": "१८", "content_sanskrit": "तत्रैकस्तूर्णमगमत् तत्पदे परिवर्तयन् ।\nएकस्तु न तथा राजंश्चक्रतुः कलहं ततः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2198486, "chapter_id": 5221, "verse_number": "१९", "content_sanskrit": "त्वं शीघ्रं गच्छसीत्येकोऽब्रवीन्नेति तथापरः ।\nनेति नेति च तौ तात परस्परमथोचतुः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2198487, "chapter_id": 5221, "verse_number": "२०", "content_sanskrit": "तयोर्विस्पर्धतोरेवं शपथोऽयमभूत् तदा ।\nमनसोद्दिश्य विपुलं ततो वाक्यमथोचतुः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2198488, "chapter_id": 5221, "verse_number": "२१", "content_sanskrit": "आवयोरनृतं प्राह यस्तस्याथ द्विजस्य वै ।\nविपुलस्य परे लोके या गतिः सा भवेदिति\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2198489, "chapter_id": 5221, "verse_number": "२२", "content_sanskrit": "एतच्छ्रुत्वा तु विपुलो विषण्णवदनोऽभवत् ।\nएवं तीव्रतपाश्चाहं कष्टश्चायं परिश्रमः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2198490, "chapter_id": 5221, "verse_number": "२३", "content_sanskrit": "मिथुनस्यास्य किं मे स्यात्कृतं पापं यतो गतिः ।\nअनिष्टा सर्वभूतानां कीर्तिताऽनेन मेऽद्य वै\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2198491, "chapter_id": 5221, "verse_number": "२४", "content_sanskrit": "एवं सञ्चिन्तयन्नेव विपुलो राजसत्तम ।\nअवाङ्मुखो न्यस्तशिरा दध्यौ दुष्कृतमात्मनः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2198492, "chapter_id": 5221, "verse_number": "२५", "content_sanskrit": "ततः षडन्यान् पुरुषानक्षैः काञ्चनराजतैः ।\nअपश्यद् दीव्यमानान् वै लोभहर्षान्वितांस्तथा\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2198493, "chapter_id": 5221, "verse_number": "२६", "content_sanskrit": "कुर्वतः शपथं तं वै यः कृतो मिथुनेन वै ।\nविपुलं वै समुद्दिश्य तेऽपि वाक्यमथाब्रुवन्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2198494, "chapter_id": 5221, "verse_number": "२७", "content_sanskrit": "यो लोभमास्थायास्माकं विषमं कर्तुमुत्सहेत् ।\nविपुलस्य परे लोके या गतिस्तामवाप्नुयात्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2198495, "chapter_id": 5221, "verse_number": "२८", "content_sanskrit": "एतच्छ्रुत्वा तु विपुलो नापश्यद् धर्मसङ्करम् ।\nजन्मप्रभृति कौरव्य कृतपूर्वमथात्मनः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2198496, "chapter_id": 5221, "verse_number": "२९", "content_sanskrit": "स प्रदध्यौ तदा राजन्नग्नावग्निरिवाहितः ।\nदह्यमानेन मनसा शापं श्रुत्वा तथाविधम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2198497, "chapter_id": 5221, "verse_number": "३०", "content_sanskrit": "तस्य चिन्तयतस्तात बह्व्यो दिननिशा ययुः ।\nइदमासीन्मनसि च रुच्या रक्षणकारितम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2198498, "chapter_id": 5221, "verse_number": "३१", "content_sanskrit": "लक्षणं लक्षणेनैव वदनं वदनेन च ।\nविधाय न मया चोक्तं सत्यमेतद् गुरोस्तदा\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2198499, "chapter_id": 5221, "verse_number": "३२", "content_sanskrit": "एतदात्मनि कौरव्य दुष्कृतं विपुलस्तदा ।\nअमन्यत महाभाग तथा तच्च न संशयः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2198500, "chapter_id": 5221, "verse_number": "३३", "content_sanskrit": "स चम्पां नगरीमेत्य पुष्पाणि गुरवे ददौ ।\nपूजयामास च गुरुं विधिवत् स गुरुप्रियः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2198501, "chapter_id": 5221, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे विपुळस्य स्वदुष्कृतस्मरणं नाम द्वासप्ततितमोऽध्यायः ॥७२॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]