[{"id": 2207024, "chapter_id": 5413, "verse_number": "", "content_sanskrit": "संवर्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2207025, "chapter_id": 5413, "verse_number": "१", "content_sanskrit": "कथमस्मि त्वया ज्ञातः केन वा कथितोऽस्मि ते ।\nएतदाचक्ष्व मे सत्यं जीवितं चेत् प्रियं तव\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2207026, "chapter_id": 5413, "verse_number": "२", "content_sanskrit": "सत्यं ते ब्रुवतः सर्वे सम्पत्स्यन्ते मनोरथाः ।\nमिथ्या प्रब्रुवतो मूर्धा सप्तधा ते फलिष्यति\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2207027, "chapter_id": 5413, "verse_number": "", "content_sanskrit": "मरुत्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2207028, "chapter_id": 5413, "verse_number": "३", "content_sanskrit": "नारदेन भवान् मह्यमाख्यातो गच्छता पथि ।\nगुरुपुत्रो ममेति त्वं ततो मे प्रीतिरुत्तमा\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2207029, "chapter_id": 5413, "verse_number": "", "content_sanskrit": "संवर्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2207030, "chapter_id": 5413, "verse_number": "४", "content_sanskrit": "सत्यमेतद् भवानाह स मां जानाति सत्तम ।\nकथयस्वैतदेवं मे क्व नु सम्प्रति नारदः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2207031, "chapter_id": 5413, "verse_number": "", "content_sanskrit": "मरुत्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2207032, "chapter_id": 5413, "verse_number": "५", "content_sanskrit": "भवन्तं कथयित्वा तु मम देवर्षिसत्तमः ।\nततो मामभ्यनुज्ञाय प्रविष्टो हव्यवाहनम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2207033, "chapter_id": 5413, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2207034, "chapter_id": 5413, "verse_number": "६", "content_sanskrit": "श्रुत्वा तु पार्थिवस्यैतत् संवर्तः परया मुदा ।\nएतादवहमप्येवं कुर्यामिति तमब्रवीत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2207035, "chapter_id": 5413, "verse_number": "७", "content_sanskrit": "ततः संवर्त उन्मत्तो वाचा निर्भर्त्सयन्निव ।\nरूक्षया ब्राह्मणो राजन् पुनः पुनरथाब्रवीत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2207036, "chapter_id": 5413, "verse_number": "", "content_sanskrit": "संवर्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2207037, "chapter_id": 5413, "verse_number": "८", "content_sanskrit": "मदप्रधानेन मया स्वचित्तवशवर्तिना ।\nएवं विकृतरूपेण कथं याजितुमिच्छसि\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2207038, "chapter_id": 5413, "verse_number": "९", "content_sanskrit": "भ्राता मम समर्थश्च वासवेन च सत्कृतः ।\nवर्तते याजने चैव तेन कर्माणि कारय\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2207039, "chapter_id": 5413, "verse_number": "१०", "content_sanskrit": "गार्हस्थ्यं चैव याज्याश्च सर्वा गृह्याश्च देवताः ।\nपूर्वजेन ममाक्षिप्तं शरीरं वर्जितं त्विदम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2207040, "chapter_id": 5413, "verse_number": "११", "content_sanskrit": "नाहं तेनाननुज्ञातः त्वामाविक्षित कर्हिचित् ।\nयाजयेयं कथञ्चिद् वै स मे पूज्यतमो गुरुः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2207041, "chapter_id": 5413, "verse_number": "१२", "content_sanskrit": "स त्वं बृहस्पतिं गच्छ तमनुज्ञाप्य मां व्रज ।\nततोऽहं याजयिष्ये त्वां यदि यष्टुमिहेच्छसि\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2207042, "chapter_id": 5413, "verse_number": "", "content_sanskrit": "मरुत्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2207043, "chapter_id": 5413, "verse_number": "१३", "content_sanskrit": "बृहस्पतिं गतः पूर्वमहं संवर्त तच्छृणु ।\nन मां कामयते याज्यं मुनिर्वासववारितः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2207044, "chapter_id": 5413, "verse_number": "१४", "content_sanskrit": "अमरं वासवं याज्यं महर्षे मा स्म मानुषम् ।\nयाजयेथा मरुत्तं त्वं मर्त्यधर्माणमित्युत\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2207045, "chapter_id": 5413, "verse_number": "१५", "content_sanskrit": "स्पर्धते हि मया विप्र सदा हि स हि वासवः ।\nएवमस्त्विति चाप्युक्तो भ्रात्रा ते बलवृत्रहा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2207046, "chapter_id": 5413, "verse_number": "१६", "content_sanskrit": "स मामधिगतं प्रेम्णा याज्यत्वे न बुभूषति ।\nदेवराजं समाश्रित्य तद्विद्धि मुनिपुङ्गव\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2207047, "chapter_id": 5413, "verse_number": "१७", "content_sanskrit": "सोऽहमिच्छामि भवता सर्वस्वेनापि याजितुम् ।\nतं कामयेऽतिक्रमितुं वासवं त्वत्कृतैर्गुणैः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2207048, "chapter_id": 5413, "verse_number": "१८", "content_sanskrit": "न हि मे वर्तते बुद्धिर्गन्तुं ब्रह्मन् बृहस्पतिम् ।\nप्रत्याख्यातो हि तेनास्मि तथाऽनपकृते सति\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2207049, "chapter_id": 5413, "verse_number": "", "content_sanskrit": "संवर्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2207050, "chapter_id": 5413, "verse_number": "१९", "content_sanskrit": "चिकीर्षसि यथाकामं सर्वमेतद् त्वयि ध्रुवम् ।\nयदि सर्वानभिप्रायान् कर्तासि मम पार्थिव\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2207051, "chapter_id": 5413, "verse_number": "२०", "content_sanskrit": "याज्यमानं मया हि त्वां बृहस्पतिपुरन्दरौ ।\nद्विषेतां समभिक्रुद्धावेतदेकं समर्थयेः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2207052, "chapter_id": 5413, "verse_number": "२१", "content_sanskrit": "स्थैर्यमत्र कथं मे स्यात् स त्वं निःसंशयं कुरु ।\nकुपितस्त्वां न हीदानीं भस्म कुर्यां सबान्धवम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2207053, "chapter_id": 5413, "verse_number": "", "content_sanskrit": "मरुत्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2207054, "chapter_id": 5413, "verse_number": "२२", "content_sanskrit": "यावत् तपेत् सहस्रांशुः तिष्ठेरंश्चापि पर्वताः ।\nतावल्लोकान्न लभेयं त्यजेयं सङ्गतं यदि\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2207055, "chapter_id": 5413, "verse_number": "२३", "content_sanskrit": "मा वाऽपि शुभबुद्धित्वं लभेयमिह कर्हिचित् ।\nभोगेषु सम्यगज्ञानं त्यजेयं सङ्गतं यदि\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2207056, "chapter_id": 5413, "verse_number": "", "content_sanskrit": "संवर्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2207057, "chapter_id": 5413, "verse_number": "२४", "content_sanskrit": "आविक्षित शुभा बुद्धिः ध्रियतां सर्वकर्मसु ।\nयाजनं हि ममाप्येवं वर्तते त्वयि पार्थिव\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2207058, "chapter_id": 5413, "verse_number": "२५", "content_sanskrit": "संविधास्ये च ते राजन्नक्षयं द्रव्यमुत्तमम् ।\nयेन देवान् सगन्धर्वान् शक्रं चाभिभविष्यसि\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2207059, "chapter_id": 5413, "verse_number": "२६", "content_sanskrit": "न तु मे वर्तते बुद्धिर्धने नान्येषु वा पुनः ।\nविप्रियं तु चिकीर्षामि भ्रातुश्चेन्द्रस्य वाभिभो\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2207060, "chapter_id": 5413, "verse_number": "२७", "content_sanskrit": "गमयिष्यामि चेन्द्रेण समतामपि ते ध्रुवम् ।\nप्रियं च ते करिष्यामि सत्यमेतद् ब्रवीमि ते\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2207061, "chapter_id": 5413, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्याम् आश्वमेधिकपर्वणि संवर्तप्रतिज्ञा नाम सप्तमोऽध्यायः ॥७॥\nअश्वमेधपर्वणि सप्तमोऽध्यायः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]