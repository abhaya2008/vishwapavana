[{"id": 2201096, "chapter_id": 5286, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2201097, "chapter_id": 5286, "verse_number": "१", "content_sanskrit": "अथात्रिप्रमुखा राजन् वने तस्मिन् महर्षयः ।\nव्यचरन् भक्षयन्तो वै मूलानि च फलानि च\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2201098, "chapter_id": 5286, "verse_number": "२", "content_sanskrit": "अथापश्यन् सुपीनांसपाणिपादमुखोदरम् ।\nपरिव्रजन्तं स्थूलाङ्गं परिव्राजं शुनःसखम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2201099, "chapter_id": 5286, "verse_number": "३", "content_sanskrit": "अरुन्धती तु तं दृष्ट्वा सर्वाङ्गोपचितं शुभा ।\nभवितारो भवन्तो वै नैवमित्यब्रवीदृषीन्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2201100, "chapter_id": 5286, "verse_number": "", "content_sanskrit": "वसिष्ठः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2201101, "chapter_id": 5286, "verse_number": "४", "content_sanskrit": "नैतस्येह यथाऽस्माकमग्निहोत्रमनिर्हुतम् ।\nसायं प्रातश्च होतव्यं तेन पीवान् शुनःसखः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2201102, "chapter_id": 5286, "verse_number": "", "content_sanskrit": "अत्रिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2201103, "chapter_id": 5286, "verse_number": "५", "content_sanskrit": "नैतस्येह यथाऽस्माकं क्षुधा वीर्यं समाहतम् ।\nकृच्छ्राधीतं प्रनष्टं च तेन पीवान् शुनःसखः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2201104, "chapter_id": 5286, "verse_number": "", "content_sanskrit": "विश्वामित्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2201105, "chapter_id": 5286, "verse_number": "६", "content_sanskrit": "नैतस्येह यथाऽस्माकं शश्वच्छास्त्रं जरद्गवः ।\nअलसः क्षुत्परो मूर्खस्तेन पीवान् शुनःसखः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2201106, "chapter_id": 5286, "verse_number": "", "content_sanskrit": "जमदग्निः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2201107, "chapter_id": 5286, "verse_number": "७", "content_sanskrit": "नैतस्येह यथाऽस्माकं भक्तमिन्धनमेव च ।\nसञ्चिन्त्यं वार्षिकं किञ्चित् तेन पीवान् शुनःसखः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2201108, "chapter_id": 5286, "verse_number": "", "content_sanskrit": "कश्यपः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2201109, "chapter_id": 5286, "verse_number": "८", "content_sanskrit": "नैतस्येह यथाऽस्माकं चत्वारश्च सहोदराः ।\nदेहिदेहीति भिक्षन्ति तेन पीवान् शुनःसखः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2201110, "chapter_id": 5286, "verse_number": "", "content_sanskrit": "भरद्वाजः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2201111, "chapter_id": 5286, "verse_number": "९", "content_sanskrit": "नैतस्येह यथास्माकं ब्रह्मबन्धोरचेतसः ।\nशोको भार्यापवादेन तेन पीवान् शुनःसखः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2201112, "chapter_id": 5286, "verse_number": "", "content_sanskrit": "गौतमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2201113, "chapter_id": 5286, "verse_number": "१०", "content_sanskrit": "नैतस्येद्य यथाऽस्माकं त्रिकालोह्यं हि राङ्कवम् ।\nएकैकं हि त्रिचर्मीयं तेन पीवान् शुनःसखः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2201114, "chapter_id": 5286, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2201115, "chapter_id": 5286, "verse_number": "११", "content_sanskrit": "अथ दृष्ट्वा परिव्राट् स तान् महर्षीन् शुनःसखः ।\nअभिगम्य यथान्यायं पाणिस्पर्शमथाऽचरत्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2201116, "chapter_id": 5286, "verse_number": "१२", "content_sanskrit": "परिचर्यां वने तां तु क्षुत्प्रतीघातकारिकाम् ।\nअन्योन्येन निवेद्याथ प्रातिष्ठन्त सहैव ते\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2201117, "chapter_id": 5286, "verse_number": "१३", "content_sanskrit": "एकनिश्चयकार्याश्च व्यचरन्त वनानि ते ।\nआददानाः समुद्धृत्य मूलानि च फलानि च\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2201118, "chapter_id": 5286, "verse_number": "१४", "content_sanskrit": "कदाचिद् विचरन्तस्ते वृक्षैरविरलैर्वृताम् ।\nशुचिवारिप्रसन्नोदां ददृशुः पद्मिनीं शुभाम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2201119, "chapter_id": 5286, "verse_number": "१५", "content_sanskrit": "बालादित्यवपुःप्रख्यैः पुष्करैरुपशोभिताम् ।\nवैदूर्यवर्णसदृशैः पद्मपत्रैरथावृताम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2201120, "chapter_id": 5286, "verse_number": "१६", "content_sanskrit": "नानाविधैश्च विहगैर्जलप्रकरसेविभिः ।\nएकद्वारामनादेयां सूपतीर्थामकर्दमाम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2201121, "chapter_id": 5286, "verse_number": "१७", "content_sanskrit": "वृषादर्भिप्रयुक्ता तु कृत्या विकृतदर्शना ।\nयातुधानीति विख्याता पद्मिनीं तामरक्षत\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2201122, "chapter_id": 5286, "verse_number": "१८", "content_sanskrit": "शुनःसखसहायास्तु बिसार्थं ते महर्षयः ।\nपद्मिनीमभिजग्मुस्ते सर्वे कृत्याभिरक्षिताम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2201123, "chapter_id": 5286, "verse_number": "१९", "content_sanskrit": "ततस्ते यातुधानीं तां दृष्ट्वा विकृतदर्शनाम् ।\nस्थितां कमलिनीतीरे कृत्यामूचुर्महर्षयः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2201124, "chapter_id": 5286, "verse_number": "२०", "content_sanskrit": "एका तिष्ठसि का नु त्वं कस्यार्थे किं प्रयोजनम् ।\nपद्मिनीतीरमाश्रित्य ब्रूहि त्वं किं चिकीर्षसि\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2201125, "chapter_id": 5286, "verse_number": "", "content_sanskrit": "यातुधानी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2201126, "chapter_id": 5286, "verse_number": "२१", "content_sanskrit": "याऽस्मि साऽस्म्यनुयोगो मे न कर्तव्यः कथञ्चन ।\nआरक्षिणीं मां पद्मिन्या वित्त सर्वे तपोधनाः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2201127, "chapter_id": 5286, "verse_number": "", "content_sanskrit": "ऋषयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2201128, "chapter_id": 5286, "verse_number": "२२", "content_sanskrit": "सर्व एव क्षुधार्ताः स्म न चान्यत् किञ्चिदस्ति नः ।\nभवत्याः सम्मते सर्वे गृह्णीमहि बिसान्युत\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2201129, "chapter_id": 5286, "verse_number": "", "content_sanskrit": "यातुधानी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2201130, "chapter_id": 5286, "verse_number": "२३", "content_sanskrit": "समयेन बिसानीतो गृह्णीध्वं कामकारतः ।\nएकैको नाम मे प्रोक्त्वा ततो गृह्णीत माचिरम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2201131, "chapter_id": 5286, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2201132, "chapter_id": 5286, "verse_number": "२४", "content_sanskrit": "विज्ञाय यातुधानीं तां कृत्यामृषिवधैषिणीम् ।\nअत्रिः क्षुधापरीतात्मा ततो वचनमब्रवीत्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2201133, "chapter_id": 5286, "verse_number": "२५", "content_sanskrit": "अरात्रिरत्रेः सा रात्रिर्यां नाधीते त्रिरद्य वै ।\nअरात्रिरत्रिरित्येव नाम मे विद्धि शोभने\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2201134, "chapter_id": 5286, "verse_number": "", "content_sanskrit": "यातुधानी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2201135, "chapter_id": 5286, "verse_number": "२६", "content_sanskrit": "यथोदाहृतमेतत् ते मयि नाम महामुने ।\nदुर्धार्यमेतन्मनसा गच्छावतर पद्मिनीम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2201136, "chapter_id": 5286, "verse_number": "", "content_sanskrit": "वसिष्ठः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2201137, "chapter_id": 5286, "verse_number": "२७", "content_sanskrit": "वसिष्ठोऽस्मि वरिष्ठोऽस्मि वसे वासं गृहेष्वपि ।\nवरिष्ठत्वाच्च वासाच्च वसिष्ठ इति विद्धि माम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2201138, "chapter_id": 5286, "verse_number": "", "content_sanskrit": "यातुधानी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2201139, "chapter_id": 5286, "verse_number": "२८", "content_sanskrit": "नामनैरुक्तमेतत् ते दुःखव्याभाषिताक्षरम् ।\nनैतद् धारयितुं शक्यं गच्छावतर पद्मिनीम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2201140, "chapter_id": 5286, "verse_number": "", "content_sanskrit": "कश्यपः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2201141, "chapter_id": 5286, "verse_number": "२९", "content_sanskrit": "कुलात् कुलं च गच्छामि कुपयः कश्यपो द्विजः ।\nकाश्यः काशनिकाशत्वादेतन्मे नाम धारय\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2201142, "chapter_id": 5286, "verse_number": "", "content_sanskrit": "यातुधानी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2201143, "chapter_id": 5286, "verse_number": "३०", "content_sanskrit": "यथोदाहृतमेतत् ते मयि नाम महामुने ।\nदुर्धार्यमेतन्मनसा गच्छावतर पद्मिनीम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2201144, "chapter_id": 5286, "verse_number": "", "content_sanskrit": "भरद्वाजः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2201145, "chapter_id": 5286, "verse_number": "३१", "content_sanskrit": "भरे सुतान् भरे शिष्यान् भरे देवान् भरे द्विजान् ।\nभरे भार्यामनव्याजो भरद्वाजोऽस्मि शोभने\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2201146, "chapter_id": 5286, "verse_number": "", "content_sanskrit": "यातुधानी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2201147, "chapter_id": 5286, "verse_number": "३२", "content_sanskrit": "नामनैरुक्तमेतत् ते दुःखव्याभाषिताक्षरम् ।\nनैतद् धारयितुं शक्यं गच्छावतर पद्मिनीम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2201148, "chapter_id": 5286, "verse_number": "", "content_sanskrit": "गौतमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2201149, "chapter_id": 5286, "verse_number": "३३", "content_sanskrit": "गोदमो दमगोऽधूमोऽदमो दुर्दर्शनश्च ते ।\nविद्धि मां गौतमं कृत्ये यातुधानि निबोध मे\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2201150, "chapter_id": 5286, "verse_number": "", "content_sans