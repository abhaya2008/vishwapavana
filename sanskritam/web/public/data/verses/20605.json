[{"id": 7000605000, "chapter_id": 20605, "verse_number": "५-६४-१", "content_sanskrit": "शेष उवाच ।\nशत्रुघ्नं पतितं वीक्ष्य सुरथः प्रवरो नृपः ।\nप्रययौ मणिना सृष्टे रथे तिष्ठन्महाद्भुते॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000605001, "chapter_id": 20605, "verse_number": "५-६४-२", "content_sanskrit": "पुष्कलस्तु रणे पूर्वं पातितः स विचारयन् ।\nलवं ययौ तदा योद्धुं महावीरबलोन्नतम्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000605002, "chapter_id": 20605, "verse_number": "५-६४-३", "content_sanskrit": "सुरथः कुशमासाद्य बाणान्मुंचन्ननेकधा ।\nव्यथयामास समरे महावीरशिरोमणिः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000605003, "chapter_id": 20605, "verse_number": "५-६४-४", "content_sanskrit": "सुरथं विरथं चक्रे बाणैर्दशभिरुच्छिखैः ।\nधनुश्चिच्छेद तरसा सुदृढं गुणपूरितम्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000605004, "chapter_id": 20605, "verse_number": "५-६४-५", "content_sanskrit": "अस्त्रप्रत्यस्त्रसंहारैः क्षैपणैः प्रतिक्षेपणैः ।\nअभवत्तुमुलं युद्धं वीराणां रोमहर्षणम्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000605005, "chapter_id": 20605, "verse_number": "५-६४-६", "content_sanskrit": "अत्यंतं समरोद्युक्ते सुरथे दुर्जये नृपे ।\nकुशः संचिंतयामास किंकर्तव्यं रणे मया॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000605006, "chapter_id": 20605, "verse_number": "५-६४-७", "content_sanskrit": "विचार्य निशितं घोरं सायकं समुपाददे ।\nहननाय नृपस्यास्य महाबलसमन्वितः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000605007, "chapter_id": 20605, "verse_number": "५-६४-८", "content_sanskrit": "तमागतं शरं दृष्ट्वा कालानलसमप्रभम् ।\nछेत्तुं मतिं चकाराशु तावल्लग्नो महाशरः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000605008, "chapter_id": 20605, "verse_number": "५-६४-९", "content_sanskrit": "मुमूर्च्छ समरे वीरो महावीरबलस्ततः ।\nपपात स्यंदनोपस्थे सारथिस्तमुपाहरत्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000605009, "chapter_id": 20605, "verse_number": "५-६४-१०", "content_sanskrit": "सुरथे पतिते दृष्ट्वा कुशं जयसमन्वितम् ।\nत्रासयंतं वीरगणानियाय पवनात्मजः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000605010, "chapter_id": 20605, "verse_number": "५-६४-११", "content_sanskrit": "समीरसूनुं प्रबलमायांतं वीक्ष्य वानरम् ।\nजहास दर्शयन्दंतान्कोपयन्निव तं क्रुधा॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000605011, "chapter_id": 20605, "verse_number": "५-६४-१२", "content_sanskrit": "उवाच च हनूमंतमेहि त्वं मम संमुखम् ।\nभेत्स्ये बाणसहस्रेण मृतो यास्यसि यामिनीम्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000605012, "chapter_id": 20605, "verse_number": "५-६४-१३", "content_sanskrit": "इत्युक्तो हनुमाञ्ज्ञात्वा रामसूनुं महाबलम् ।\nस्वामिकार्यं प्रकर्तव्यमिति कृत्वा प्रधावितः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000605013, "chapter_id": 20605, "verse_number": "५-६४-१४", "content_sanskrit": "शालमुत्पाट्य तरसा विशालं शतशाखिनम् ।\nकुशं वक्षसि संलक्ष्य ययौ योद्धुं महाबलः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000605014, "chapter_id": 20605, "verse_number": "५-६४-१५", "content_sanskrit": "शालहस्तं समायांतं हनूमंतं महाबलम् ।\nत्रिभिः क्षुरप्रैर्विव्याध हृदि चंद्रोपमैर्बली॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000605015, "chapter_id": 20605, "verse_number": "५-६४-१६", "content_sanskrit": "स बाणविद्धस्तरसा कुशेन बलशालिना ।\nशालेन हृदि संजघ्ने दंतान्निष्पिष्य मारुतिः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000605016, "chapter_id": 20605, "verse_number": "५-६४-१७", "content_sanskrit": "शालाहतस्तदा बालः किंचिन्नाकंपत स्मयात् ।\nतदा वीराः प्रशंसां तु प्रचक्रुस्तस्य बाल्यतः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000605017, "chapter_id": 20605, "verse_number": "५-६४-१८", "content_sanskrit": "स शालेन हतो वीरः संहारास्त्रं समाददे ।\nसंहन्तुं वैरिणं कोपात्कुशः स परमास्त्रवित्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000605018, "chapter_id": 20605, "verse_number": "५-६४-१९", "content_sanskrit": "संहारास्त्रं समालोक्य दुर्जयं कुशमोचितम् ।\nदध्यौ रामं स्वमनसा भक्तविघ्नविनाशकम्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000605019, "chapter_id": 20605, "verse_number": "५-६४-२०", "content_sanskrit": "तदा मुक्तं कुशेनाशु तदस्त्रं हृदि मारुतेः ।\nलग्नं महाव्यथाकारि तेन मूर्च्छामितः पुनः॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000605020, "chapter_id": 20605, "verse_number": "५-६४-२१", "content_sanskrit": "मूर्च्छां प्राप्तं तु तं दृष्ट्वा प्लवंगं बलसंयुतः ।\nविव्याध सायकैस्तीक्ष्णैः सैन्यं तत्सकलं महत्॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000605021, "chapter_id": 20605, "verse_number": "५-६४-२२", "content_sanskrit": "तस्य बाणायुतैर्भग्नं बलं सर्वं रणांगणे ।\nपलायनपरं जातं चतुरंगसमन्वितम्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000605022, "chapter_id": 20605, "verse_number": "५-६४-२३", "content_sanskrit": "तदा कपिपतिः कोपात्सुग्रीवो रक्षको महान् ।\nअभ्यधावन्नगान्नैकानुत्पाट्य कुशमुद्भटम्॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000605023, "chapter_id": 20605, "verse_number": "५-६४-२४", "content_sanskrit": "कुशः सर्वान्प्रचिच्छेद लीलया प्रहसन्नगान् ।\nपुनरप्यागतान्वृक्षांश्चिच्छेद तरसा बली॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000605024, "chapter_id": 20605, "verse_number": "५-६४-२५", "content_sanskrit": "अनेकबाणव्यथितः सुग्रीवः समरांगणे ।\nजग्राह पर्वतं घोरं कुशमस्तकमध्यतः॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000605025, "chapter_id": 20605, "verse_number": "५-६४-२६", "content_sanskrit": "कुशस्तं नगमायांतं वीक्ष्य बाणैरनेकधा ।\nनिष्पिपेष चकाराशु महारुद्रांगयोग्यताम्॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000605026, "chapter_id": 20605, "verse_number": "५-६४-२७", "content_sanskrit": "सुग्रीवस्तन्महत्कर्म दृष्ट्वा बालेन निर्मितम् ।\nजयाशाप्रतिनिर्वृत्तो बभूव समरांगणे॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000605027, "chapter_id": 20605, "verse_number": "५-६४-२८", "content_sanskrit": "रणमध्ये दुराक्रांतं कुशं लांगूलताडकम् ।\nअत्यमर्षीरुषाक्रांतस्तं हंतुं नगमाददे॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000605028, "chapter_id": 20605, "verse_number": "५-६४-२९", "content_sanskrit": "आत्मानं हंतुमुद्युक्तं वीक्ष्य सुग्रीवमादरात् ।\nताडयामास बहुभिः सायकैः शितपर्वभिः॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000605029, "chapter_id": 20605, "verse_number": "५-६४-३०", "content_sanskrit": "स ताडितो बहुविधैः शरैः पीडासमन्वितः ।\nकुशं हंतुं समारब्धो ययौ शालं समाददे॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000605030, "chapter_id": 20605, "verse_number": "५-६४-३१", "content_sanskrit": "तदापि च कुशो वीरो वारुणास्त्रं समाददे ।\nबबंध तं च पाशेन दृढेन स लवाग्रजः॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000605031, "chapter_id": 20605, "verse_number": "५-६४-३२", "content_sanskrit": "स बद्धः पाशकैः स्निग्धैः कुशेन बलशालिना ।\nपपात रणमध्ये वै महावीरैरलंकृते॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000605032, "chapter_id": 20605, "verse_number": "५-६४-३३", "content_sanskrit": "सुग्रीवं पतितं दृष्ट्वा वीराः सर्वत्र दुद्रुवुः ।\nजयमाप लवभ्राता महावीरशिरोमणिः॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000605033, "chapter_id": 20605, "verse_number": "५-६४-३४", "content_sanskrit": "तावल्लवो भटाञ्जित्वा पुष्कलं चांगदं तथा ।\nप्रतापाग्र्यं वीरमणिं तथान्यानपि भूभुजः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000605034, "chapter_id": 20605, "verse_number": "५-६४-३५", "content_sanskrit": "जयं प्राप्य रणे वीरो लवो भ्रातरमागमत् ।\nसंग्रामे जयकर्तारं वैरिकोटिनिपातकम्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000605035, "chapter_id": 20605, "verse_number": "५-६४-३६", "content_sanskrit": "परस्परं प्रहृषितौ परिरंभं प्रकुर्वतः ।\nजयं प्राप्तौ तदा वार्तां मुने चक्रतुरुन्मदौ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000605036, "chapter_id": 20605, "verse_number": "५-६४-३७", "content_sanskrit": "लव उवाच ।\nभ्रातस्तव प्रसादेन निस्तीर्णो रणतोयधिः ।\nइदानीं वीररणकं शोधयावः सुशोभितम्॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000605037, "chapter_id": 20605, "verse_number": "५-६४-३८", "content_sanskrit": "इत्युक्त्वा त्वरितं वीरो जग्मतुस्तौ कुशीलवौ ।\nराज्ञो मौलिमणिं चित्रं जग्राह कनकाचितम्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000605038, "chapter_id": 20605, "verse_number": "५-६४-३९", "content_sanskrit": "पुष्कलस्य लवो वीरो जग्राह मुकुटं शुभम् ।\nअंगदे च महानर्घ्ये शत्रुघ्नस्यापरस्य च॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000605039, "chapter_id": 20605, "verse_number": "५-६४-४०", "content_sanskrit": "गृहीत्वा शस्त्रसंघातं हनूमंतं कपीश्वरम् ।\nसुग्रीवं सविधे गत्वा उभावपि बबंधतुः॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000605040, "chapter_id": 20605, "verse_number": "५-६४-४१", "content_sanskrit": "पुच्छे वायुसुतस्यायं गृहीत्वा तु कुशानुजः ।\nभ्रातरं प्रत्युवाचेदं नेष्यामि स्वकमंदिरम्॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000605041, "chapter_id": 20605, "verse_number": "५-६४-४२", "content_sanskrit": "आवयोर्जननी प्रीत्यै गृहीत्वा पुच्छके त्वहम् ।\nक्रीडार्थमृषिपुत्राणां कौतुकार्थं ममैव च॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000605042, "chapter_id": 20605, "verse_number": "५-६४-४३", "content_sanskrit": "एतच्छ्रुत्वा ततो वाक्यमुवाच च कुशो लवम् ।\nअहमेनं ग्रहीष्यामि वानरं बलिनं दृढम्॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000605043, "chapter_id": 20605, "verse_number": "५-६४-४४", "content_sanskrit": "इत्येवं भाषमाणौ तौ बद्ध्वा तौ बलिनां वरौ ।\nपुच्छयोर्बलिनौ धृत्वा जग्मतुः स्वाश्रमं प्रति॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000605044, "chapter_id": 20605, "verse_number": "५-६४-४५", "content_sanskrit": "स्वाश्रमाय प्रगच्छंतौ वीक्ष्य तौ कपिसत्तमौ ।\nकंपमानौ जगदतुरन्योन्यं भीतया गिरा॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000605045, "chapter_id": 20605, "verse_number": "५-६४-४६", "content_sanskrit": "हनूमान्कपिराजानं प्रत्युवाच भयार्द्रधीः ।\nएतौ रामसुतावस्मान्नेष्यतः स्वाश्रमं प्रति॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000605046, "chapter_id": 20605, "verse_number": "५-६४-४७", "content_sanskrit": "मया पूर्वं कृतं कर्म जानकीं प्रतिगच्छता ।\nतत्र मे जानकी देवी संमुखाभून्मनोहरा॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000605047, "chapter_id": 20605, "verse_number": "५-६४-४८", "content_sanskrit": "सा मां द्रक्ष्यति वैदेही बद्धं पाशेन वैरिणा ।\nतदा हसिष्यति वरा त्रपा मेऽत्र भविष्यति॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000605048, "chapter_id": 20605, "verse_number": "५-६४-४९", "content_sanskrit": "मया किमत्र कर्तव्यं प्राणत्यागो भविष्यति ।\nमहद्दुःखं चापतितं स रामः किं करिष्यति॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000605049, "chapter_id": 20605, "verse_number": "५-६४-५०", "content_sanskrit": "सुग्रीवस्तद्वचः श्रुत्वा ममाप्येवं महाकपे ।\nनेष्यते यदि मामेवं निधनं तु भविष्यति॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000605050, "chapter_id": 20605, "verse_number": "५-६४-५१", "content_sanskrit": "एवं कथयतोरेव ह्यन्योन्यं भयभीतयोः ।\nकुशो लवश्च भवनं मातुः प्रापतुरोजसा॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000605051, "chapter_id": 20605, "verse_number": "५-६४-५२", "content_sanskrit": "तावायातौ समीक्ष्यैव जहर्ष जननी तयोः ।\nअन्योन्यं परमप्रीत्या परिरेभे निजौ सुतौ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000605052, "chapter_id": 20605, "verse_number": "५-६४-५३", "content_sanskrit": "ताभ्यां पुच्छगृहीतौ तौ वानरौ वीक्ष्य जानकी ।\nहनूमंतं च सुग्रीवं सर्ववीरं कपीश्वरम्॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000605053, "chapter_id": 20605, "verse_number": "५-६४-५४", "content_sanskrit": "जहास पाशबद्धौ तौ वीक्षमाणा वरांगना ।\nउवाच च विमोक्षार्थं वदंती वचनं वरम्॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000605054, "chapter_id": 20605, "verse_number": "५-६४-५५", "content_sanskrit": "पुत्रौ प्रमुंचतं कीशौ महावीरौ महाबलौ ।\nईक्षंतौ मां यदि स्फीतौ प्राणत्यागं करिष्यतः॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000605055, "chapter_id": 20605, "verse_number": "५-६४-५६", "content_sanskrit": "अयं वै हनुमान्वीरो यो ददाह दनोः पुरीम् ।\nअयमप्यृक्षराजो हि सर्ववानरभूमिपः॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000605056, "chapter_id": 20605, "verse_number": "५-६४-५७", "content_sanskrit": "किमर्थं विधृतौ कुत्र किं वा कृतमनादरात् ।\nपुच्छे युवाभ्यां विधृतौ स महान्विस्मयोऽस्ति मे॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000605057, "chapter_id": 20605, "verse_number": "५-६४-५८", "content_sanskrit": "इति मातुर्वचः श्लक्ष्णं वीक्ष्यतां पुत्रकौ तदा ।\nऊचतुर्विनयश्रेष्ठौ महाबलसमन्वितौ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000605058, "chapter_id": 20605, "verse_number": "५-६४-५९", "content_sanskrit": "मातः कश्चन भूपालो रामो दाशरथिर्बली ।\nतेन मुक्तो हयः स्वर्णभालपत्रः सुशोभितः॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000605059, "chapter_id": 20605, "verse_number": "५-६४-६०", "content_sanskrit": "तत्रैवं लिखितं मातरेकवीराप्रसूर्मम ।\nये क्षत्रियास्ते गृह्णन्तु नोचेत्पादतलार्चकाः॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000605060, "chapter_id": 20605, "verse_number": "५-६४-६१", "content_sanskrit": "तदा मया विचारो वै कृतः स्वांते पतिव्रते ।\nभवती क्षत्रिया किं न वीरसूः किं न वा भवेत्॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000605061, "chapter_id": 20605, "verse_number": "५-६४-६२", "content_sanskrit": "धार्ष्ट्यं तद्वीक्ष्य भूपस्य गृहीतोऽश्वो मया बलात् ।\nजितं कुशेन वीरेण सैन्यं तत्पातितं रणे॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000605062, "chapter_id": 20605, "verse_number": "५-६४-६३", "content_sanskrit": "मुकुटोऽयं भूमिपतेर्जानीहि पतिदेवते ।\nअयमप्यन्यवीरस्य पुष्कलस्य महात्मनः॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000605063, "chapter_id": 20605, "verse_number": "५-६४-६४", "content_sanskrit": "जानीहि मुकुटं त्वन्यं मणिमुक्ताविराजितम् ।\nअश्वोऽयं मे मनोहारी कामयानो हि भूपतेः॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000605064, "chapter_id": 20605, "verse_number": "५-६४-६५", "content_sanskrit": "आरोहणाय मद्भ्रातुर्जानीहि बलिनो वरे ।\nइमौ कीशौ मया रंतुमानीतौ बलिनां वरौ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000605065, "chapter_id": 20605, "verse_number": "५-६४-६६", "content_sanskrit": "कौतुकार्थं तवैवैतौ संग्रामे युद्धकारकौ ।\nइति वाक्यं समाकर्ण्य जानकी पतिदेवता॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000605066, "chapter_id": 20605, "verse_number": "५-६४-६७", "content_sanskrit": "जगाद पुत्रौ तौ वीरौ मोचयेथां पुनः पुनः ।\nसीतोवाच ।\nयुवाभ्यामनयः सृष्टो हृतो रामहयो महान्॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000605067, "chapter_id": 20605, "verse_number": "५-६४-६८", "content_sanskrit": "अनेके पातिता वीरा इमौ बद्धौ कपीश्वरौ ।\nपितुस्तव हयो वीरो यागार्थं मोचितोऽमुना॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000605068, "chapter_id": 20605, "verse_number": "५-६४-६९", "content_sanskrit": "तस्यापि हृतवंतौ किं वाजिनं मखसत्तमे ।\nमुंचतं प्लवगावेतौ मुंचतं वाजिनां वरम्॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000605069, "chapter_id": 20605, "verse_number": "५-६४-७०", "content_sanskrit": "क्षाम्यतां भूपतेर्भ्राता शत्रुघ्नः परकोपनः ।\nजनन्यास्तद्वचः श्रुत्वा ऊचतुस्तां बलान्वितौ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000605070, "chapter_id": 20605, "verse_number": "५-६४-७१", "content_sanskrit": "क्षात्रधर्मेण तं भूपं जितवंतौ बलान्वितम् ।\nनास्माकमनयोर्भावि क्षात्रधर्मेण युध्यताम्॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000605071, "chapter_id": 20605, "verse_number": "५-६४-७२", "content_sanskrit": "वाल्मीकिना पुरा प्रोक्तमस्माकं पठतां पुरः॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000605072, "chapter_id": 20605, "verse_number": "५-६४-७३", "content_sanskrit": "कण्वस्याश्रमकेवाहं धृत्वा यागक्रियोचितम् ।\nतस्मात्सुतः स्वपित्रापि युध्येद्भ्रात्रापि चानुजः॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000605073, "chapter_id": 20605, "verse_number": "५-६४-७४", "content_sanskrit": "गुरुणा शिष्य एवापि तस्मान्नो पापसंभवः ।\nत्वदाज्ञातो ऽधुना चावां दास्यावो हयमुत्तमम्॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000605074, "chapter_id": 20605, "verse_number": "५-६४-७५", "content_sanskrit": "मोक्ष्यावः कीशावेतौ हि करिष्यावो वचस्तव ।\nइत्युक्त्वा मातरं वीरौ गतौ रणे कपीश्वरौ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000605075, "chapter_id": 20605, "verse_number": "५-६४-७६", "content_sanskrit": "अमुंचतां हयं चापि हयमेधक्रियोचितम् ।\nसीतादेवी स्वपुत्राभ्यां श्रुत्वा सैन्यं निपातितम्॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000605076, "chapter_id": 20605, "verse_number": "५-६४-७७", "content_sanskrit": "श्रीरामं मनसा ध्यात्वा भानुमैक्षत साक्षिणम् ।\nयद्यहं मनसा वाचा कर्मणा रघुनायकम्॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000605077, "chapter_id": 20605, "verse_number": "५-६४-७८", "content_sanskrit": "भजामि नान्यं मनसा तर्हि जीवेदयं नृपः ।\nसैन्यं चापि महत्सर्वं यन्नाशितमिदं बलात्॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000605078, "chapter_id": 20605, "verse_number": "५-६४-७९", "content_sanskrit": "पुत्राभ्यां तत्तु जीवेत मत्सत्याज्जगतांपते ।\nइति यावद्वचो ब्रूते जानकीपतिदेवता॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000605079, "chapter_id": 20605, "verse_number": "५-६४-८०", "content_sanskrit": "तावद्बलं च तत्सर्वं जीवितं रणमूर्द्धनि॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}]