[{"id": 7005745000, "chapter_id": 25745, "verse_number": "२१८-१", "content_sanskrit": "मनुमत्स्यसंवादे राजधर्मवर्णनम् ।\nमनुरुवाच ।\nरक्षोघ्नानि विषघ्नानि यानि धार्याणि भूभुजा ।\nअगदानि समाचक्ष्व तानि धर्मभृताम्वर! ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005745001, "chapter_id": 25745, "verse_number": "२१८-२", "content_sanskrit": "मत्स्य उवाच ।\nविल्वाटकी यवक्षारं पाटलावाह्लिकोषणाः ।\nश्रीपर्णी शल्लकी-युक्तो निक्वाथः प्रोक्षणं परम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005745002, "chapter_id": 25745, "verse_number": "२१८-३", "content_sanskrit": "सविषं प्रोक्षितं तेन सद्यो भवति निर्विषम् ।\nयवसैन्धवपानीय वस्त्रशय्यासनोदकम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005745003, "chapter_id": 25745, "verse_number": "२१८-४", "content_sanskrit": "कवचाभरणं छत्रं बालव्यजनवेश्मनाम् ।\nशेलुः पाठलातिविषा शिग्रुमूर्वा पुनर्नवा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005745004, "chapter_id": 25745, "verse_number": "२१८-५", "content_sanskrit": "समङ्गावृषमूलञ्च कपित्थवृषशोणितम् ।\nमहादन्तशठन्तद्वत् प्रोक्षणं विषनाशनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005745005, "chapter_id": 25745, "verse_number": "२१८-६", "content_sanskrit": "लाक्षाप्रियङ्गु मञ्जिष्ठा सममेला हरेणुका ।\nयष्ट्याह्वा मधुरा चैव बभ्रुपित्तेन कल्पिताः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005745006, "chapter_id": 25745, "verse_number": "२१८-७", "content_sanskrit": "निखनेद् गोविषाणस्थं सप्तरात्रं महीतले ।\nततः कृत्वा मणिं हेम्ना बद्धं हस्तेन धारयेत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005745007, "chapter_id": 25745, "verse_number": "२१८-८", "content_sanskrit": "संसृष्टं सविषन्तेन सद्यो भवति निर्विषम् ।\nमनोह्वया शमीपत्रं तुम्बिका श्वेतसर्षपाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005745008, "chapter_id": 25745, "verse_number": "२१८-९", "content_sanskrit": "कपित्थकुष्ठमञ्जिष्ठाः पित्तेन श्लक्ष्णकल्पिताः ।\nशुनो गोः कपिलाश्च सौम्याक्षिप्तोऽपरोगदः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005745009, "chapter_id": 25745, "verse_number": "२१८-१०", "content_sanskrit": "विषजित् परमं कार्यं मणिरत्नञ्च पूर्ववत् ।\nमूषिका जतुका चापि हस्ते बद्धा विषापहा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005745010, "chapter_id": 25745, "verse_number": "२१८-११", "content_sanskrit": "हरेणु मांसी मञ्जिष्ठा रजनी मधुकामधु ।\nअक्षत्वक् सुरसं लाक्षा श्वपित्तं पूर्ववद् भुवि ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005745011, "chapter_id": 25745, "verse_number": "२१८-१२", "content_sanskrit": "वादित्राणि पताकाश्च पिष्टैरेताः प्रलोपिताः ।\nश्रुत्वा दृष्ट्वा समाघ्राय सद्यो भवति निर्विषः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005745012, "chapter_id": 25745, "verse_number": "२१८-१३", "content_sanskrit": "त्र्युषणं पञ्चलवणं मञ्जिष्ठा रजनीद्वयम् ।\nसूक्ष्मैला त्रिवृतापत्रं विडङ्गानीन्द्रवारुणी ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005745013, "chapter_id": 25745, "verse_number": "२१८-१४", "content_sanskrit": "मधुकं वेतसं क्षौद्रं विषाणे च निधापयेत् ।\nतस्मादुष्णाम्बुना मात्रं प्रागुक्तं योजयेत्ततः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005745014, "chapter_id": 25745, "verse_number": "२१८-१५", "content_sanskrit": "शुक्लं सर्जरसोपेत सर्षपा एलवालुकैः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005745015, "chapter_id": 25745, "verse_number": "२१८-१६", "content_sanskrit": "सुवोगा तस्करसुरौ कुसुमैरर्जुनस्य तु ।\nधूपो वासगृहे हन्ति विषं स्यावरजङ्गमम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005745016, "chapter_id": 25745, "verse_number": "२१८-१७", "content_sanskrit": "न तत्र कीटा न विषन्दर्दुरा न सरीसृपाः ।\nन कृत्या कर्मणाञ्चापि धूपोऽयं यत्र दह्यते ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005745017, "chapter_id": 25745, "verse_number": "२१८-१८", "content_sanskrit": "कल्पितैश्चन्दनक्षीर पलाश द्रुमवल्कलैः ।\nमूर्वैला वालु सरसा नाकुली तण्डुलीयकैः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005745018, "chapter_id": 25745, "verse_number": "२१८-१९", "content_sanskrit": "क्वाथः सर्वोदकार्येषु काकमाचीयुतो हितः ।\nरोचनापत्रनेपाली कुङ्कुमै स्तिलकान् वहन् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005745019, "chapter_id": 25745, "verse_number": "२१८-२०", "content_sanskrit": "विषैर्न बाध्यते स्याच्च नरनारी नृपप्रियः ।\nचूर्णै र्हरिद्रा मञ्जिष्ठा किणिही कणनिम्बजैः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005745020, "chapter_id": 25745, "verse_number": "२१८-२१", "content_sanskrit": "दिग्धं निर्विषतामेति गात्रं सर्वविषार्दितम् ।\nशिरीषस्य फलं पत्रं पुष्पं त्वं मूलमेव च ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005745021, "chapter_id": 25745, "verse_number": "२१८-२२", "content_sanskrit": "गोमूत्रघृष्टो ह्यगदः सर्वकर्मकरः स्मृतः ।\nएकवीर! महौषध्यः श्रृणु चातः परं नृप! ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005745022, "chapter_id": 25745, "verse_number": "२१८-२३", "content_sanskrit": "वन्ध्या कर्कोटकी राजन्! विष्णुक्रान्ता तथोत्कटा ।\nशतमूली सितानन्दा बला मोचा पटोलिका ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005745023, "chapter_id": 25745, "verse_number": "२१८-२४", "content_sanskrit": "सोमा पिण्डा निशा चैव तथा दग्धरुहा च या ।\nस्थले कमलिनी या च विशाली शङ्कमूलिका ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005745024, "chapter_id": 25745, "verse_number": "२१८-२५", "content_sanskrit": "चण्डाली हस्तिमगधा गोऽजापर्णो करम्भिका ।\nरक्ता चैव महारक्ता तथा बर्हिशिखा च या ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005745025, "chapter_id": 25745, "verse_number": "२१८-२६", "content_sanskrit": "कोशातकी नक्तमालं प्रियालञ्च सुलोचनी ।\nवारुणी वसुगन्धा च तथा वै गन्धनाकुली ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005745026, "chapter_id": 25745, "verse_number": "२१८-२७", "content_sanskrit": "ईश्वरी शिवगन्धा च श्यामला वंशनालिका ।\nजतुकाली महाश्वेता श्वेता च मधुयष्टिका ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005745027, "chapter_id": 25745, "verse_number": "२१८-२८", "content_sanskrit": "वज्रकः पारिभद्रश्च तथा वै सिन्धुवारकाः ।\nजीवानन्दा वसुच्छिद्रा नतनागरकण्टका ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005745028, "chapter_id": 25745, "verse_number": "२१८-२९", "content_sanskrit": "नालश्च जाली जाती च तथा च वटपत्रिका ।\nकार्तस्वरं महानीला कुन्दुरुर्हं सपादिका ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005745029, "chapter_id": 25745, "verse_number": "२१८-३०", "content_sanskrit": "मण्डूकपर्णी वारही द्वे तथा तण्डुलीयके ।\nसर्पाक्षी लवली ब्राह्मी विश्वरूपा सुखाकरा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005745030, "chapter_id": 25745, "verse_number": "२१८-३१", "content_sanskrit": "रुजापहो वृद्धिकरी तथा चैव तु शल्यदा ।\nपत्रिका रोहिणी चैव रक्तमाला महौषधी ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005745031, "chapter_id": 25745, "verse_number": "२१८-३२", "content_sanskrit": "तथामलकवन्दाकं श्यामचित्र फला च या ।\nकाकोली क्षीरकाकोली पीलुपर्णी तथैव च ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005745032, "chapter_id": 25745, "verse_number": "२१८-३३", "content_sanskrit": "केशिनी वृश्चिकालीच महानागा शतावरी ।\nगरुडीच तथा वेगा जले कुमुदिनी तथा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005745033, "chapter_id": 25745, "verse_number": "२१८-३४", "content_sanskrit": "स्थले चोत्पलिनी या च महाभूमिलता च या ।\nउन्मादिनी सोमराजी सर्वरत्नानि पार्थिव ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005745034, "chapter_id": 25745, "verse_number": "२१८-३५", "content_sanskrit": "विशेषान्मरकतादीनि कीटपक्षं विशेषतः ।\nजीवजाताश्च मणयः सर्वे धार्याः प्रयत्नतः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005745035, "chapter_id": 25745, "verse_number": "२१८-३६", "content_sanskrit": "रक्षोघ्नाश्च विषघ्नाश्च कृत्या वैतालनाशनाः ।\nविशेषान्नरनागाश्च गोखरोष्ट्रसमुद्भवाः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005745036, "chapter_id": 25745, "verse_number": "२१८-३७", "content_sanskrit": "सर्पतित्तिरगोमायु वस्त्र(क)मण्डकजाश्च ये ।\nसिंहव्याघ्रर्क्षमार्जार द्वीपिवानरसम्भवाः ॥कपिञ्जला गजा वाजिमहिषैण भवाश्च ये ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005745037, "chapter_id": 25745, "verse_number": "२१८-३८", "content_sanskrit": "इत्येवमेतैः सकलैरुपेतन्द्रव्यैश्च सर्वैः स्वपुरं सुरक्षितम् ।\nराजा वसेत्तत्र गृहं सुशुभ्रं गुणान्वितं लक्षण सम्प्रयुक्तम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]