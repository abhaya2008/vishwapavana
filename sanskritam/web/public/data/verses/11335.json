[{"id": 50006210, "chapter_id": 11335, "verse_number": "1", "content_sanskrit": "॥ पूर्वपक्षयुक्तयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50006211, "chapter_id": 11335, "verse_number": "2", "content_sanskrit": "ॐ॥ अतिक्रमोक्तिः कृतिरर्थलाभः परा गतिः पारगतिस्तदोकः। समस्तकार्यं वशिता च विश्वसम्भावना युक्तयस्त्वन्यपक्षे॥ १॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50006212, "chapter_id": 11335, "verse_number": "3", "content_sanskrit": "॥ सिद्धान्तयुक्तयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50006213, "chapter_id": 11335, "verse_number": "4", "content_sanskrit": "सामान्यरूपं प्रतिभानमुक्तिराश्चर्यताऽकृत्रिमताऽस्तदोषः। विशेषकॢप्तिः कृतनिश्चयश्च माहात्म्यमित्येव सुनिर्णयार्थाः॥ २॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}]