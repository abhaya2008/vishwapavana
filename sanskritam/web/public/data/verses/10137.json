[{"id": 6000137000, "chapter_id": 10137, "verse_number": null, "content_sanskrit": "अथ अष्टादशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000137001, "chapter_id": 10137, "verse_number": "६-१८-१", "content_sanskrit": "पृश्निस्तु पत्नी सवितुः सावित्रीं व्याहृतित्रयीम्।\nअग्निहोत्रं पशुं सोमं चातुर्मास्यं महामखान्॥ ६/१८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.001.m4a", "display_order": 2, "topics": [{"text": "पूर्वम् अदितिपुत्राणां विवस्वदादीनां त्वष्ट्रन्तानां चतुर्णां वंशो निरूपितः, तत्प्रसक्ता विश्वरूपवृत्रासुर-कथाश्श्चोक्ताः, अत्र अन्येषाम् आदित्यानां वंशकथनम्", "range": "१–९"}]}, {"id": 6000137002, "chapter_id": 10137, "verse_number": "६-१८-२", "content_sanskrit": "सिद्धिर्भगस्य भार्याऽङ्ग महिमानं विभुं प्रभुम्।\nआशिषं च वरारोहां कन्यां प्रासूत सुव्रताम्॥ ६/१८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.002.m4a", "display_order": 3}, {"id": 6000137003, "chapter_id": 10137, "verse_number": "६-१८-३", "content_sanskrit": "धातुः कुहूः सिनीवाली राका चानुमतिस्तथा।\nसायं दर्शमथ प्रातः पूर्णमासमनुक्रमात्॥ ६/१८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.003.m4a", "display_order": 4}, {"id": 6000137004, "chapter_id": 10137, "verse_number": "६-१८-४", "content_sanskrit": "अग्नीन् पुरीष्यानाधत्त क्रियायां समनन्तरः।\nचर्षणी वरुणस्यासीद् यस्यां जातो भृगुः पुनः॥ ६/१८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.004.m4a", "display_order": 5}, {"id": 6000137005, "chapter_id": 10137, "verse_number": "६-१८-५", "content_sanskrit": "वाल्मीकिश्च महायोगी वल्मीकादभवत् किल।\nअगस्त्यश्च वसिष्ठश्च मित्रावरुणयोर्ऋषी॥ ६/१८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.005.m4a", "display_order": 6}, {"id": 6000137006, "chapter_id": 10137, "verse_number": "६-१८-६", "content_sanskrit": "रेतः सिषिचतुः कुम्भे उर्वश्या सन्निधौ द्रुतम्।\nरेवत्यां मित्र उत्सर्गमरिष्टं पिप्पलं व्यधात्॥ ६/१८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.006.m4a", "display_order": 7}, {"id": 6000137007, "chapter_id": 10137, "verse_number": "६-१८-७", "content_sanskrit": "पौलोम्यामिन्द्र आधत्त त्रीन् पुत्रानिति नः श्रुतम्।\nजयन्तम् ऋषभं तात तृतीयं मीढुषं प्रभुः॥ ६/१८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.007.m4a", "display_order": 8}, {"id": 6000137008, "chapter_id": 10137, "verse_number": "६-१८-८", "content_sanskrit": "उरुक्रमस्य देवस्य मायावामनरूपिणः।\nकीर्तौ पत्न्यां बृहछ्लोकास्तस्यासन् सौभगादयः॥ ६/१८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.008.m4a", "display_order": 9}, {"id": 6000137009, "chapter_id": 10137, "verse_number": "६-१८-९", "content_sanskrit": "तत्कर्मगुणवीर्याणि कश्यपस्य महात्मनः।\nपश्चाद् वक्ष्यामहेऽदित्यां यथैवावततार ह॥ ६/१८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.009.m4a", "display_order": 10}, {"id": 6000137010, "chapter_id": 10137, "verse_number": "६-१८-१०", "content_sanskrit": "अथ कश्यपदायादान् दैतेयान् कीर्तयामि ते।\nयत्र भागवतः श्रीमान् प्रह्नादो बलिरेव च॥ ६/१८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.010.m4a", "display_order": 11, "topics": [{"text": "कश्यपपत्नीषु दितिवंशमनुक्रम्य एकोनपञ्चाशन्मरुदुत्पत्तिकथनम्", "range": "१०–७८"}]}, {"id": 6000137011, "chapter_id": 10137, "verse_number": "६-१८-११", "content_sanskrit": "दितेर्द्वावेव दायादौ दैत्यदानववन्दितौ।\nहिरण्यकशिपुर्नाम हिरण्याक्षश्च कीर्तितौ॥ ६/१८/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.011.m4a", "display_order": 12}, {"id": 6000137012, "chapter_id": 10137, "verse_number": "६-१८-१२", "content_sanskrit": "हिरण्यकशिपोर्भार्या कयाधुर्नाम दानवी।\nजम्भस्य तनया दत्ता सुषुवे चतुरः सुतान्॥ ६/१८/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.012.m4a", "display_order": 13}, {"id": 6000137013, "chapter_id": 10137, "verse_number": "६-१८-१३", "content_sanskrit": "सह्लादं प्रागनुह्लादं प्रह्लादं ह्लादमेव च।\nतत्स्वसा सिंहिका नाम राहुं विप्रचितोऽग्रहीत्॥ ६/१८/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.013.m4a", "display_order": 14}, {"id": 6000137014, "chapter_id": 10137, "verse_number": "६-१८-१४", "content_sanskrit": "शिरोऽहरद् यस्य हरिश्चक्रेण पिबतोऽमृतम्।\nसंह्लादस्य कृतिर्भार्याऽसूत पञ्चजनं ततः॥ ६/१८/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.014.m4a", "display_order": 15}, {"id": 6000137015, "chapter_id": 10137, "verse_number": "६-१८-१५", "content_sanskrit": "ह्लादस्य धमनिर्भार्याऽसूत वातापिमिल्वलम्।\nयोऽगस्त्याया त्वतिथये पेचे वातापिमिल्वलः॥ ६/१८/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.015.m4a", "display_order": 16}, {"id": 6000137016, "chapter_id": 10137, "verse_number": "६-१८-१६", "content_sanskrit": "अनुह्लादस्य सूर्म्यायां बाष्कलो महिषस्तथा।\nविरोचनस्तु प्राह्लादिर्बलिस्तस्याभवत् किल॥ ६/१८/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.016.m4a", "display_order": 17}, {"id": 6000137017, "chapter_id": 10137, "verse_number": "६-१८-१७", "content_sanskrit": "बाणज्येष्ठं पुत्रशतमशनायां ततोऽभवत्।\nतस्यानुभावः सुश्लोक्यः पश्चादेवाभिधास्यते॥ ६/१८/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.017.m4a", "display_order": 18}, {"id": 6000137018, "chapter_id": 10137, "verse_number": "६-१८-१८", "content_sanskrit": "बाणस्त्वाराध्य गिरिशं लेभे तद्गणमुख्यताम्।\nयत्पार्श्वे भगवानास्ते अद्यापि पुरपालकः॥ ६/१८/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.018.m4a", "display_order": 19}, {"id": 6000137019, "chapter_id": 10137, "verse_number": "६-१८-१९", "content_sanskrit": "मरुतश्च दितेः पुत्राश्चत्वारिंशन्नवाधिकाः।\nत आसन्नप्रजाः सर्वे नीता इन्द्रेण सात्मताम्॥ ६/१८/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.019.m4a", "display_order": 20}, {"id": 6000137020, "chapter_id": 10137, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.020.m4a", "display_order": 21}, {"id": 6000137021, "chapter_id": 10137, "verse_number": "६-१८-२०", "content_sanskrit": "कथं त आसुरं भावमपोह्यौत्पत्तिकं गुरो।\nइन्द्रेण प्रापिताः सात्म्यं किं तत् साधु कृतं हि तैः॥ ६/१८/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.021.m4a", "display_order": 22}, {"id": 6000137022, "chapter_id": 10137, "verse_number": "६-१८-२१", "content_sanskrit": "इमे श्रद्दधते विद्वन् ऋषयो हि मया सह।\nपरिज्ञानाय भगवंस्तन्नो व्याख्यातुमर्हसि॥ ६/१८/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.022.m4a", "display_order": 23}, {"id": 6000137023, "chapter_id": 10137, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.023.m4a", "display_order": 24}, {"id": 6000137024, "chapter_id": 10137, "verse_number": "६-१८-२२", "content_sanskrit": "तद् विष्णुरातस्य स बादरायणिर्वचो निशम्यादृतमर्थवन्मुनिः।\nसभाजयंस्तन्निभृतेन चेतसा जगाद सत्रायण सर्वदर्शनः॥ ६/१८/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.024.m4a", "display_order": 25}, {"id": 6000137025, "chapter_id": 10137, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.025.m4a", "display_order": 26}, {"id": 6000137026, "chapter_id": 10137, "verse_number": "६-१८-२३", "content_sanskrit": "हतपुत्रा दितिः शक्रपार्ष्णिग्राहेण विष्णुना।\nमन्युना शोकदीप्तेन ज्वलन्ती पर्यचिन्तयत्॥ ६/१८/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.026.m4a", "display_order": 27}, {"id": 6000137027, "chapter_id": 10137, "verse_number": "६-१८-२४", "content_sanskrit": "कदा नु भ्रातृहन्तारं इन्द्रियाराममुल्बणम्।\nअक्लिन्नहृदयं पापं घातयित्वा स्वपे सुखम्॥ ६/१८/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.027.m4a", "display_order": 28}, {"id": 6000137028, "chapter_id": 10137, "verse_number": "६-१८-२५", "content_sanskrit": "कृमिविड्‌भस्मसंज्ञाऽन्ते यस्येशाभिहितस्य वा।\nभूतध्रुक् तत्कृते स्वार्थं किं वेद निरयो यतः॥ ६/१८/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.028.m4a", "display_order": 29}, {"id": 6000137029, "chapter_id": 10137, "verse_number": "६-१८-२६", "content_sanskrit": "आशासानस्य तस्येदं ध्रुवमुन्नद्धचेतसः।\nमदशोषणमिन्द्रस्य भूयाद् येन सुतो हि मे॥ ६/१८/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.029.m4a", "display_order": 30}, {"id": 6000137030, "chapter_id": 10137, "verse_number": "६-१८-२७", "content_sanskrit": "इति भावेन सा भर्तुराचचारासकृत् प्रियम्।\nशुश्रूषयाऽनुरागेण प्रश्रयेण दमेन च॥ ६/१८/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.030.m4a", "display_order": 31}, {"id": 6000137031, "chapter_id": 10137, "verse_number": "६-१८-२८", "content_sanskrit": "भक्त्या परमया राजन् मनोज्ञैर्वल्गुभाषितैः।\nमनो जग्राह भावज्ञा सुस्मितापाङ्गवीक्षणैः॥ ६/१८/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.031.m4a", "display_order": 32}, {"id": 6000137032, "chapter_id": 10137, "verse_number": "६-१८-२९", "content_sanskrit": "एवं स्‍त्रिया जडीभूतो विद्वानपि विदग्धया।\nबाढमित्याह विवशो नैतच्चित्रं हि योषिति॥ ६/१८/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.032.m4a", "display_order": 33}, {"id": 6000137033, "chapter_id": 10137, "verse_number": "६-१८-३०", "content_sanskrit": "विलोक्यैकान्तभूतानि भूतान्यादौ प्रजापतिः।\nस्‍त्रियं चक्रे स्वदेहार्धां यया पुंसां मतिर्हृता॥ ६/१८/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.033.m4a", "display_order": 34}, {"id": 6000137034, "chapter_id": 10137, "verse_number": "६-१८-३१", "content_sanskrit": "एवं शुश्रूषितस्तात भगवान् कश्यपः स्‍त्रिया।\nप्रहस्य परमप्रीतो दितिमाहाभिनन्द्य च॥ ६/१८/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.034.m4a", "display_order": 35}, {"id": 6000137035, "chapter_id": 10137, "verse_number": null, "content_sanskrit": "कश्यप उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.035.m4a", "display_order": 36}, {"id": 6000137036, "chapter_id": 10137, "verse_number": "६-१८-३२", "content_sanskrit": "वरं वरय वामोरु प्रीतस्तेऽहमनिन्दिते।\nस्‍त्रीणां भर्तरि सुप्रीते कः काम इह चागमः॥ ६/१८/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.036.m4a", "display_order": 37}, {"id": 6000137037, "chapter_id": 10137, "verse_number": "६-१८-३३", "content_sanskrit": "पतिरेव हि नारीणां दैवतं परमं स्मृतम्।\nमानसः सर्वभूतानां वासुदेवः श्रियः पतिः॥ ६/१८/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.037.m4a", "display_order": 38}, {"id": 6000137038, "chapter_id": 10137, "verse_number": "६-१८-३४", "content_sanskrit": "स एव देवतालिङ्गैर्नामरूपविकल्पितैः।\nइज्यते भगवान् पुंभिः स्‍त्रीभिश्च पतिरूपधृक्॥ ६/१८/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.038.m4a", "display_order": 39}, {"id": 6000137039, "chapter_id": 10137, "verse_number": "६-१८-३५", "content_sanskrit": "तस्मात् पतिव्रता नार्यः श्रेयःकामाः सुमध्यमे।\nयजन्तेऽनन्यभावेन पतिमात्मानमीश्वरम्॥ ६/१८/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.039.m4a", "display_order": 40}, {"id": 6000137040, "chapter_id": 10137, "verse_number": "६-१८-३६", "content_sanskrit": "योऽहं त्वयाऽर्चितो भद्रे ईदृग्भावेन भक्तितः।\nकिं ते सम्पादये काममसतीनां सुदुर्लभम्॥ ६/१८/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.040.m4a", "display_order": 41}, {"id": 6000137041, "chapter_id": 10137, "verse_number": null, "content_sanskrit": "दितिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.041.m4a", "display_order": 42}, {"id": 6000137042, "chapter_id": 10137, "verse_number": "६-१८-३७", "content_sanskrit": "वरदोऽसि यदि ब्रह्मन् पुत्रमिन्द्रहणं वृणे।\nअमृत्युं मृतपुत्राऽहं येन मे घातितौ सुतौ॥ ६/१८/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.042.m4a", "display_order": 43}, {"id": 6000137043, "chapter_id": 10137, "verse_number": "६-१८-३८", "content_sanskrit": "निशम्य तद्वचो विप्रो विमनाः पर्यतप्यत।\nअहो अधर्मः सुमहानद्य मे समुपस्थितः॥ ६/१८/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.043.m4a", "display_order": 44}, {"id": 6000137044, "chapter_id": 10137, "verse_number": "६-१८-३९", "content_sanskrit": "अहो अद्येन्द्रियारामो योषिन्मय्येशमायया।\nगृहीतचेताः कृपणः पतिष्ये नरके ध्रुवम्॥ ६/१८/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.044.m4a", "display_order": 45}, {"id": 6000137045, "chapter_id": 10137, "verse_number": "६-१८-४०", "content_sanskrit": "कोऽतिक्रमोऽनुवर्तन्त्याः स्वभावमिह योषितः।\nधिङ् मां बताबुधं स्वार्थे यदहं त्वजितेन्द्रियः॥ ६/१८/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.045.m4a", "display_order": 46}, {"id": 6000137046, "chapter_id": 10137, "verse_number": "६-१८-४१", "content_sanskrit": "शरच्चन्द्रोपमं वक्त्रं वचश्च श्रवणामृतम्।\nहृदयं क्षुरधाराभं स्‍त्रीणां को वेद चेष्टितम्॥ ६/१८/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.046.m4a", "display_order": 47}, {"id": 6000137047, "chapter_id": 10137, "verse_number": "६-१८-४२", "content_sanskrit": "न हि कश्चित् प्रियः स्‍त्रीणाम् अञ्जसा स्वाशिषात्मनाम्।\nपतिं पुत्रं भ्रातरं वा घ्नन्त्यर्थे घातयन्ति हि॥ ६/१८/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.047.m4a", "display_order": 48}, {"id": 6000137048, "chapter_id": 10137, "verse_number": "६-१८-४३", "content_sanskrit": "प्रतिश्रुतं ददामीति वचस्तन्न मृषा भवेत्।\nवधं नार्हति चेन्द्रोऽपि तत्रेदमुपकल्पये॥ ६/१८/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.048.m4a", "display_order": 49}, {"id": 6000137049, "chapter_id": 10137, "verse_number": "६-१८-४४", "content_sanskrit": "इति संचिन्त्य भगवान् मारीचः कुरुनन्दन।\nउवाच किञ्चित् कुपित आत्मानं च विगर्हयन्॥ ६/१८/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.049.m4a", "display_order": 50}, {"id": 6000137050, "chapter_id": 10137, "verse_number": null, "content_sanskrit": "कश्यप उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.050.m4a", "display_order": 51}, {"id": 6000137051, "chapter_id": 10137, "verse_number": "६-१८-४५", "content_sanskrit": "पुत्रस्ते भविता भद्रे इन्द्रहा देवबान्धवः।\nसंवत्सरं व्रतमिदं यद्यञ्जो धारयिष्यसि॥ ६/१८/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.051.m4a", "display_order": 52}, {"id": 6000137052, "chapter_id": 10137, "verse_number": null, "content_sanskrit": "दितिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.052.m4a", "display_order": 53}, {"id": 6000137053, "chapter_id": 10137, "verse_number": "६-१८-४६", "content_sanskrit": "धारयिष्ये व्रतं ब्रह्मन् ब्रूहि कार्याणि यानि मे।\nयानि चेह निषिद्धानि न व्रतं घ्नन्ति यान्युत॥ ६/१८/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.053.m4a", "display_order": 54}, {"id": 6000137054, "chapter_id": 10137, "verse_number": null, "content_sanskrit": "कश्यप उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.054.m4a", "display_order": 55}, {"id": 6000137055, "chapter_id": 10137, "verse_number": "६-१८-४७", "content_sanskrit": "न हिंस्यात् सर्वभूतानि न शपेन्नानृतं वदेत्।\nन छिन्द्यान्नखरोमाणि न स्पृशेद् यदमङ्गलम्॥ ६/१८/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.055.m4a", "display_order": 56}, {"id": 6000137056, "chapter_id": 10137, "verse_number": "६-१८-४८", "content_sanskrit": "नाप्सु स्नायान्न कुप्येत न सम्भाषेत दुर्जनैः।\nन वसीताधौतवासः स्रजं वा विधृतां क्‍वचित्॥ ६/१८/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.056.m4a", "display_order": 57}, {"id": 6000137057, "chapter_id": 10137, "verse_number": "६-१८-४९", "content_sanskrit": "नोच्छिष्टं चण्डिकान्नं च सामिषं वृषलाहृतम्।\nभुञ्जीतोदक्यया दृष्टं पिबेन्नाञ्जलिना त्वपः॥ ६/१८/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.057.m4a", "display_order": 58}, {"id": 6000137058, "chapter_id": 10137, "verse_number": "६-१८-५०", "content_sanskrit": "नोच्छिष्टाऽस्पृष्टसलिला सन्ध्ययोर्मुक्तमूर्धजा।\nअनर्चिताऽसंयतवाक् नासंवीता बहिश्चरेत्॥ ६/१८/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.058.m4a", "display_order": 59}, {"id": 6000137059, "chapter_id": 10137, "verse_number": "६-१८-५१", "content_sanskrit": "नाधौतपादाऽप्रयता नार्द्रपान्नाप्युदक्शिराः।\nशयीत नापराङ् नान्यैर्न नग्ना न च सन्ध्ययोः॥ ६/१८/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.059.m4a", "display_order": 60}, {"id": 6000137060, "chapter_id": 10137, "verse_number": "६-१८-५२", "content_sanskrit": "धौतवासा शुचिर्नित्यं सर्वमङ्गलसंयुता।\nपूजयेत् प्रातराशात् प्राग् गोविप्रान् श्रियमच्युतम्॥ ६/१८/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.060.m4a", "display_order": 61}, {"id": 6000137061, "chapter_id": 10137, "verse_number": "६-१८-५३", "content_sanskrit": "स्‍त्रियो वरवतीश्चार्चेत् स्रग्गन्धबलिमण्डनैः।\nपतिं चार्च्योपतिष्ठेत ध्यायेत् कोष्ठगतं च तम्॥ ६/१८/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.061.m4a", "display_order": 62}, {"id": 6000137062, "chapter_id": 10137, "verse_number": "६-१८-५४", "content_sanskrit": "संवत्सरं पुंसवनं व्रतमेतदविच्युतम्।\nधारयिष्यसि चेत् तुभ्यं शक्रहा भविता सुतः॥ ६/१८/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.062.m4a", "display_order": 63}, {"id": 6000137063, "chapter_id": 10137, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.063.m4a", "display_order": 64}, {"id": 6000137064, "chapter_id": 10137, "verse_number": "६-१८-५५", "content_sanskrit": "बाढमित्यभ्युपेत्याथ दिती राजन् महामनाः।\nकश्यपाद् गर्भमाधत्त व्रतं चाञ्जो दधार सा॥ ६/१८/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.064.m4a", "display_order": 65}, {"id": 6000137065, "chapter_id": 10137, "verse_number": "६-१८-५६", "content_sanskrit": "मातृष्वसुरभिप्रायमिन्द्र आज्ञाय मानद।\nशुश्रूषणेनाश्रमस्थां दितिं पर्यचरत् कविः॥ ६/१८/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.065.m4a", "display_order": 66}, {"id": 6000137066, "chapter_id": 10137, "verse_number": "६-१८-५७", "content_sanskrit": "नित्यं वनात् सुमनसः फलमूलसमित्कुशान्।\nपत्राङ्कुरमृदापश्च काले काल उपाहरत्॥ ६/१८/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.066.m4a", "display_order": 67}, {"id": 6000137067, "chapter_id": 10137, "verse_number": "६-१८-५८", "content_sanskrit": "एवं तस्या व्रतस्थाया व्रतच्छिद्रं हरिर्नृप।\nप्रेप्सुः पर्यचरज्जिह्मो मृगहेव मृगाकृतिः॥ ६/१८/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.067.m4a", "display_order": 68}, {"id": 6000137068, "chapter_id": 10137, "verse_number": "६-१८-५९", "content_sanskrit": "नाध्यगच्छद् व्रतच्छिद्रं तत्परोऽथ महीपते।\nचिन्तां तीव्रां गतः शक्रः केन मे स्याच्छिवं त्विह॥ ६/१८/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.068.m4a", "display_order": 69}, {"id": 6000137069, "chapter_id": 10137, "verse_number": "६-१८-६०", "content_sanskrit": "एकदा सा तु सन्ध्यायामुच्छिष्टा व्रतकर्शिता।\nअस्पृष्टवार्यधौताङ्घ्रिः सुष्वाप विधिमोहिता॥ ६/१८/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.069.m4a", "display_order": 70}, {"id": 6000137070, "chapter_id": 10137, "verse_number": "६-१८-६१", "content_sanskrit": "लब्ध्वा तदन्तरं शक्रो निद्रोपहतचेतसः।\nदितेः प्रविष्ट उदरं योगेशो योगमायया॥ ६/१८/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.070.m4a", "display_order": 71}, {"id": 6000137071, "chapter_id": 10137, "verse_number": "६-१८-६२", "content_sanskrit": "चकर्त सप्तधा गर्भं वज्रेण कनकप्रभम्।\nरुदन्तं सप्तधैकैकं मा रोदीरिति तान् पुनः॥ ६/१८/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.071.m4a", "display_order": 72}, {"id": 6000137072, "chapter_id": 10137, "verse_number": "६-१८-६३", "content_sanskrit": "ते तमूचुः पीड्यमानाः सर्वे प्राञ्जलयो नृप।\nनो जिघांससि किं त्विन्द्र भ्रातरो मरुतस्तव॥ ६/१८/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.072.m4a", "display_order": 73}, {"id": 6000137073, "chapter_id": 10137, "verse_number": "६-१८-६४", "content_sanskrit": "मा भैष्ट भ्रातरो मह्यं यूयमित्याह कौशिकः।\nअनन्यभावान् पार्षदानात्मनो मरुतां गणान्॥ ६/१८/६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.073.m4a", "display_order": 74}, {"id": 6000137074, "chapter_id": 10137, "verse_number": "६-१८-६५", "content_sanskrit": "न ममार दितेर्गर्भः श्रीनिवासानुकम्पया।\nबहुधा कुलिशक्षुण्णो द्रौण्यस्‍त्रेण यथा भवान्॥ ६/१८/६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.074.m4a", "display_order": 75}, {"id": 6000137075, "chapter_id": 10137, "verse_number": "६-१८-६६", "content_sanskrit": "सकृदिष्ट्वाऽऽदिपुरुषं पुरुषो याति सात्मताम्।\nसंवत्सरं किञ्चिदूनं दित्या यद्धरिरर्चितः॥ ६/१८/६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.075.m4a", "display_order": 76}, {"id": 6000137076, "chapter_id": 10137, "verse_number": "६-१८-६७", "content_sanskrit": "सजूरिन्द्रेण पञ्चाशद् देवास्ते मरुतोऽभवन्।\nव्यपोह्य मातृदोषं ते हरिणा सोमपा कृताः॥ ६/१८/६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.076.m4a", "display_order": 77}, {"id": 6000137077, "chapter_id": 10137, "verse_number": "६-१८-६८", "content_sanskrit": "दितिरुत्थाय ददृशे कुमाराननलप्रभान्।\nइन्द्रेण सहितान् देवी पर्यतुष्यदनिन्दिता॥ ६/१८/६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.077.m4a", "display_order": 78}, {"id": 6000137078, "chapter_id": 10137, "verse_number": "६-१८-६९", "content_sanskrit": "अथेन्द्रमाह ताताहम् आदित्यानां भयावहम्।\nअपत्यमिच्छन्त्यचरं व्रतमेतत् सुदुष्करम्॥ ६/१८/६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.078.m4a", "display_order": 79}, {"id": 6000137079, "chapter_id": 10137, "verse_number": "६-१८-७०", "content_sanskrit": "एकः सङ्कल्पितः पुत्रः सप्तसप्ताभवन् कथम्।\nयदि ते विदितं पुत्र सत्यं कथय मा मृषा॥ ६/१८/७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.079.m4a", "display_order": 80}, {"id": 6000137080, "chapter_id": 10137, "verse_number": null, "content_sanskrit": "इन्द्र उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.080.m4a", "display_order": 81}, {"id": 6000137081, "chapter_id": 10137, "verse_number": "६-१८-७१", "content_sanskrit": "अम्ब तेऽहं व्यवसितमुपधार्यागतोऽन्तिकम्।\nलब्धान्तरोऽच्छिदं गर्भमर्थबुद्धिर्न धर्मवित्॥ ६/१८/७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.081.m4a", "display_order": 82}, {"id": 6000137082, "chapter_id": 10137, "verse_number": "६-१८-७२", "content_sanskrit": "कृतो मे सप्तधा गर्भ आसन् सप्त कुमारकाः।\nतेऽपि चैकैकशो वृक्णाः सप्तधा नापि मम्रिरे॥ ६/१८/७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.082.m4a", "display_order": 83}, {"id": 6000137083, "chapter_id": 10137, "verse_number": "६-१८-७३", "content_sanskrit": "ततस्तत् परमाश्चर्यं वीक्ष्याध्यवसितं मया।\nमहापुरुषपूजायाः सिद्धिः कार्यानुषङ्गिणी॥ ६/१८/७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.083.m4a", "display_order": 84}, {"id": 6000137084, "chapter_id": 10137, "verse_number": "६-१८-७४", "content_sanskrit": "आराधनं भगवत ईहमाना निराशिषः।\nये तु नेच्छन्त्यपि परं ते स्वार्थकुशलाः स्मृताः॥ ६/१८/७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.084.m4a", "display_order": 85}, {"id": 6000137085, "chapter_id": 10137, "verse_number": "६-१८-७५", "content_sanskrit": "आराध्यात्मप्रदं देवमात्मानं जगदीश्वरम्।\nको वृणीत गुणस्पर्शं बुधः स्यान्नरकेऽपि यत्॥ ६/१८/७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.085.m4a", "display_order": 86}, {"id": 6000137086, "chapter_id": 10137, "verse_number": "६-१८-७६", "content_sanskrit": "तदिदं मम दौर्जन्यं बालिशस्य महीयसि।\nक्षन्तुमर्हसि मातस्त्वं दिष्ट्या गर्भोऽमृतोत्थितः॥ ६/१८/७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.086.m4a", "display_order": 87}, {"id": 6000137087, "chapter_id": 10137, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.087.m4a", "display_order": 88}, {"id": 6000137088, "chapter_id": 10137, "verse_number": "६-१८-७७", "content_sanskrit": "इन्द्रस्तयाऽभ्यनुज्ञातः शुक्लभावेन तुष्टया।\nमरुद्भिः सह तां नत्वा जगाम त्रिदिवं प्रभुः॥ ६/१८/७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.088.m4a", "display_order": 89}, {"id": 6000137089, "chapter_id": 10137, "verse_number": "६-१८-७८", "content_sanskrit": "एवं ते सर्वमाख्यातं यन्मां त्वं परिपृच्छसि।\nमङ्गलं मरुतां जन्म किं भूयः श्रोतुमिच्छसि॥ ६/१८/७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_018/BhP_06.018.089.m4a", "display_order": 90}, {"id": 6000137090, "chapter_id": 10137, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां षष्ठस्कन्धे अष्टादशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}]