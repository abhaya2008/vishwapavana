[{"id": 40015708, "chapter_id": 9231, "verse_number": "1", "content_sanskrit": "युध्यतांतुततस्तेषांवानराणांमहात्मनाम् । रक्षसांसम्बभूवाथबलकोपस्सुदारुणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40015709, "chapter_id": 9231, "verse_number": "2", "content_sanskrit": "तेहयैःकाञ्चनापीडैर्ध्वश्चाग्निशिखोपमैः । रथैश्चादित्यसङ्काशैःकवचैश्चमनोरमैः ॥ निर्ययूराक्षसव्याघ्रानादयन्तोदिशोदश । राक्षसाभीमकर्माणोरावणस्यजयैषिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40015710, "chapter_id": 9231, "verse_number": "3", "content_sanskrit": "तेहयैःकाञ्चनापीडैर्ध्वश्चाग्निशिखोपमैः । रथैश्चादित्यसङ्काशैःकवचैश्चमनोरमैः ॥ निर्ययूराक्षसव्याघ्रानादयन्तोदिशोदश । राक्षसाभीमकर्माणोरावणस्यजयैषिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40015711, "chapter_id": 9231, "verse_number": "4", "content_sanskrit": "वानराणामपिचमूर्बृहतीजयमिच्छताम् । अभ्यधावततांसेनांरक्षसांकामरूपिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40015712, "chapter_id": 9231, "verse_number": "5", "content_sanskrit": "एतस्मिन्नन्तरेतेषामन्योन्यमभिधावताम् । रक्षसांवानराणांचद्वन्द्वयुद्धमवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40015713, "chapter_id": 9231, "verse_number": "6", "content_sanskrit": "अङ्गदेन्द्रजित्सार्धंवालिपुत्रेणराक्षसः । आयुध्यतमहातेजास्त्ऱ्यम्बकेणयथाऽन्तकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40015714, "chapter_id": 9231, "verse_number": "7", "content_sanskrit": "प्रजङ्घेनचसम्पातिर्नित्यंदुर्मर्षणोरणे । जम्बुमालिनमारब्धोहनुमानपिवानरः ॥", "padaccheda": "", "anvaya": "", "meaning_s