[{"id": 5000231000, "chapter_id": 9231, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे पञ्चत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000231001, "chapter_id": 9231, "verse_number": "३-३५-१", "content_sanskrit": "ततः शूर्पणखावाक्यं तच्छ्रुत्वा रोमहर्षणम्।\nसचिवानभ्यनुज्ञाय कार्यं बुद्‍ध्वा जगाम ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000231002, "chapter_id": 9231, "verse_number": "३-३५-२", "content_sanskrit": "तत् कार्यमनुगम्यान्तर्यथावदुपलभ्य च।\nदोषाणां च गुणानां च सम्प्रधार्य बलाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000231003, "chapter_id": 9231, "verse_number": "३-३५-३", "content_sanskrit": "इति कर्तव्यमित्येव कृत्वा निश्चयमात्मनः।\nस्थिरबुद्धिस्ततो रम्यां यानशालां जगाम ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000231004, "chapter_id": 9231, "verse_number": "३-३५-४", "content_sanskrit": "यानशालां ततो गत्वा प्रच्छन्नं राक्षसाधिपः।\nसूतं संचोदयामास रथः संयुज्यतामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000231005, "chapter_id": 9231, "verse_number": "३-३५-५", "content_sanskrit": "एवमुक्तः क्षणेनैव सारथिर्लघुविक्रमः।\nरथं संयोजयामास तस्याभिमतमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000231006, "chapter_id": 9231, "verse_number": "३-३५-६", "content_sanskrit": "कामगं रथमास्थाय काञ्चनं रत्नभूषितम्।\nपिशाचवदनैर्युक्तं खरैः कनकभूषणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000231007, "chapter_id": 9231, "verse_number": "३-३५-७", "content_sanskrit": "मेघप्रतिमनादेन स तेन धनदानुजः।\nराक्षसाधिपतिः श्रीमान् ययौ नदनदीपतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000231008, "chapter_id": 9231, "verse_number": "३-३५-८", "content_sanskrit": "स श्वेतवालव्यजनः श्वेतच्छत्रो दशाननः।\nस्निग्धवैदूर्यसंकाशस्तप्तकाञ्चनभूषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000231009, "chapter_id": 9231, "verse_number": "३-३५-९", "content_sanskrit": "दशग्रीवो विंशतिभुजो दर्शनीयपरिच्छदः।\nत्रिदशारिर्मुनीन्द्रघ्नो दशशीर्ष इवाद्रिराट् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000231010, "chapter_id": 9231, "verse_number": "३-३५-१०", "content_sanskrit": "कामगं रथमास्थाय शुशुभे राक्षसाधिपः।\nविद्युन्मण्डलवान् मेघः सबलाक इवाम्बरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000231011, "chapter_id": 9231, "verse_number": "३-३५-११", "content_sanskrit": "सशैलसागरानूपं वीर्यवानवलोकयन्।\nनानापुष्पफलैर्वृक्षैरनुकीर्णं सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000231012, "chapter_id": 9231, "verse_number": "३-३५-१२", "content_sanskrit": "शीतमङ्गलतोयाभिः पद्मिनीभिः समन्ततः।\nविशालैराश्रमपदैर्वेदिमद्भिरलंकृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000231013, "chapter_id": 9231, "verse_number": "३-३५-१३", "content_sanskrit": "कदल्यटविसंशोभं नारिकेलोपशोभितम्।\nसालैस्तालैस्तमालैश्च तरुभिश्च सुपुष्पितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000231014, "chapter_id": 9231, "verse_number": "३-३५-१४", "content_sanskrit": "अत्यन्तनियताहारैः शोभितं परमर्षिभिः।\nनागैः सुपर्णैर्गन्धर्वैः किंनरैश्च सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000231015, "chapter_id": 9231, "verse_number": "३-३५-१५", "content_sanskrit": "जितकामैश्च सिद्धैश्च चारणैश्चोपशोभितम्।\nआजैर्वैखानसैर्माषैर्वालखिल्यैर्मरीचिपैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000231016, "chapter_id": 9231, "verse_number": "३-३५-१६", "content_sanskrit": "दिव्याभरणमाल्याभिर्दिव्यरूपाभिरावृतम्।\nक्रीडारतविधिज्ञाभिरप्सरोभिः सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000231017, "chapter_id": 9231, "verse_number": "३-३५-१७", "content_sanskrit": "सेवितं देवपत्नीभिः श्रीमतीभिरुपासितम्।\nदेवदानवसङ्घैश्च चरितं त्वमृताशिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000231018, "chapter_id": 9231, "verse_number": "३-३५-१८", "content_sanskrit": "हंसक्रौञ्चप्लवाकीर्णं सारसैः सम्प्रसादितम्।\nवैदूर्यप्रस्तरं स्निग्धं सान्द्रं सागरतेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000231019, "chapter_id": 9231, "verse_number": "३-३५-१९", "content_sanskrit": "पाण्डुराणि विशालानि दिव्यमाल्ययुतानि च।\nतूर्यगीताभिजुष्टानि विमानानि समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000231020, "chapter_id": 9231, "verse_number": "३-३५-२०", "content_sanskrit": "तपसा जितलोकानां कामगान्यभिसम्पतन्।\nगन्धर्वाप्सरसश्चैव ददर्श धनदानुजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000231021, "chapter_id": 9231, "verse_number": "३-३५-२१", "content_sanskrit": "निर्यासरसमूलानां चन्दनानां सहस्रशः।\nवनानि पश्यन् सौम्यानि घ्राणतृप्तिकराणि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000231022, "chapter_id": 9231, "verse_number": "३-३५-२२", "content_sanskrit": "अगुरूणां च मुख्यानां वनान्युपवनानि च।\nतक्कोलानां च जात्यानां फलिनां च सुगन्धिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000231023, "chapter_id": 9231, "verse_number": "३-३५-२३", "content_sanskrit": "पुष्पाणि च तमालस्य गुल्मानि मरिचस्य च।\nमुक्तानां च समूहानि शुष्यमाणानि तीरतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000231024, "chapter_id": 9231, "verse_number": "३-३५-२४", "content_sanskrit": "शैलानि प्रवरांश्चैव प्रवालनिचयांस्तथा।\nकाञ्चनानि च शृङ्गाणि राजतानि तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000231025, "chapter_id": 9231, "verse_number": "३-३५-२५", "content_sanskrit": "प्रस्रवाणि मनोज्ञानि प्रसन्नान्यद्भुतानि च।\nधनधान्योपपन्नानि स्त्रीरत्नैरावृतानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000231026, "chapter_id": 9231, "verse_number": "३-३५-२६", "content_sanskrit": "हस्त्यश्वरथगाढानि नगराणि विलोकयन्।\nतं समं सर्वतः स्निग्धं मृदुसंस्पर्शमारुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000231027, "chapter_id": 9231, "verse_number": "३-३५-२७", "content_sanskrit": "अनूपे सिन्धुराजस्य ददर्श त्रिदिवोपमम्।\nतत्रापश्यत् स मेघाभं न्यग्रोधं मुनिभिर्वृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000231028, "chapter_id": 9231, "verse_number": "३-३५-२८", "content_sanskrit": "समन्ताद् यस्य ताः शाखाः शतयोजनमायताः।\nयस्य हस्तिनमादाय महाकायं च कच्छपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000231029, "chapter_id": 9231, "verse_number": "३-३५-२९", "content_sanskrit": "भक्षार्थं गरुडः शाखामाजगाम महाबलः।\nतस्य तां सहसा शाखां भारेण पतगोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000231030, "chapter_id": 9231, "verse_number": "३-३५-३०", "content_sanskrit": "सुपर्णः पर्णबहुलां बभञ्जाथ महाबलः।\nतत्र वैखानसा माषा वालखिल्या मरीचिपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000231031, "chapter_id": 9231, "verse_number": "३-३५-३१", "content_sanskrit": "आजा बभूवुर्धूम्राश्च संगताः परमर्षयः।\nतेषां दयार्थं गरुडस्तां शाखां शतयोजनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000231032, "chapter_id": 9231, "verse_number": "३-३५-३२", "content_sanskrit": "भग्नामादाय वेगेन तौ चोभौ गजकच्छपौ।\nएकपादेन धर्मात्मा भक्षयित्वा तदामिषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000231033, "chapter_id": 9231, "verse_number": "३-३५-३३", "content_sanskrit": "निषादविषयं हत्वा शाखया पतगोत्तमः।\nप्रहर्षमतुलं लेभे मोक्षयित्वा महामुनीन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000231034, "chapter_id": 9231, "verse_number": "३-३५-३४", "content_sanskrit": "स तु तेन प्रहर्षेण द्विगुणीकृतविक्रमः।\nअमृतानयनार्थं वै चकार मतिमान् मतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000231035, "chapter_id": 9231, "verse_number": "३-३५-३५", "content_sanskrit": "अयोजालानि निर्मथ्य भित्त्वा रत्नगृहं वरम्।\nमहेन्द्रभवनाद् गुप्तमाजहारामृतं ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000231036, "chapter_id": 9231, "verse_number": "३-३५-३६", "content_sanskrit": "तं महर्षिगणैर्जुष्टं सुपर्णकृतलक्षणम्।\nनाम्ना सुभद्रं न्यग्रोधं ददर्श धनदानुजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000231037, "chapter_id": 9231, "verse_number": "३-३५-३७", "content_sanskrit": "तं तु गत्वा परं पारं समुद्रस्य नदीपतेः।\nददर्शाश्रममेकान्ते पुण्ये रम्ये वनान्तरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000231038, "chapter_id": 9231, "verse_number": "३-३५-३८", "content_sanskrit": "तत्र कृष्णाजिनधरं जटामण्डलधारिणम्।\nददर्श नियताहारं मारीचं नाम राक्षसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000231039, "chapter_id": 9231, "verse_number": "३-३५-३९", "content_sanskrit": "स रावणः समागम्य विधिवत् तेन रक्षसा।\nमारीचेनार्चितो राजा सर्वकामैरमानुषैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000231040, "chapter_id": 9231, "verse_number": "३-३५-४०", "content_sanskrit": "तं स्वयं पूजयित्वा च भोजनेनोदकेन च।\nअर्थोपहितया वाचा मारीचो वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000231041, "chapter_id": 9231, "verse_number": "३-३५-४१", "content_sanskrit": "कच्चित्ते कुशलं राजन् लङ्कायां राक्षसेश्वर।\nकेनार्थेन पुनस्त्वं वै तूर्णमेव इहागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000231042, "chapter_id": 9231, "verse_number": "३-३५-४२", "content_sanskrit": "एवमुक्तो महातेजा मारीचेन स रावणः।\nततः पश्चादिदं वाक्यमब्रवीद् वाक्यकोविदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000231043, "chapter_id": 9231, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे पञ्चत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]