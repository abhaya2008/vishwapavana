_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40015722, "chapter_id": 9231, "verse_number": "15", "content_sanskrit": "धर्मस्यपुत्रोबलवान्सुषेणइतिविश्रुतः । सविद्युन्मालिनासार्धमयुध्यतमहाकपिः ॥ वानराश्चापरेभीमाराक्षसैरपरैस्सह । द्वन्द्वंसमीयुस्सहसायुद्धायबहुभिस्सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40015723, "chapter_id": 9231, "verse_number": "16", "content_sanskrit": "तत्रासीत्सुमहद्युद्धंतुमुलंरोमहर्षणम् । रक्षसांवानराणांचवीराणांजयमिच्छताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40015724, "chapter_id": 9231, "verse_number": "17", "content_sanskrit": "हरिराक्षसदेहेभ्यःप्रभूताःकेशशाद्वलाः । शरीरसङ्घाटावहाःप्रसुस्रुश्शोणितापगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40015725, "chapter_id": 9231, "verse_number": "18", "content_sanskrit": "अजघानेन्द्रजित्क्रुद्धोवज्रेणेवशतक्रतुः । अङ्गदंगदयावीरंशत्रुसैन्यविदारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40015726, "chapter_id": 9231, "verse_number": "19", "content_sanskrit": "तस्यकाञ्चनचित्राङ्गंरथंसाश्वंससारथिम् । जघानसमरेश्रीमानङ्गदोवेगवान्कपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40015727, "chapter_id": 9231, "verse_number": "20", "content_sanskrit": "सम्पातिस्तुत्रिभिर्भाणैःप्रजङ्घेनसमाहतः । निजघानश्वकर्णेनप्रजङ्घंरणमूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40015728, "chapter_id": 9231, "verse_number": "21", "content_sanskrit": "जम्बुमालीरथस्थस्तुरथशक्त्यामहाबलः । बिबेदसमरेक्रुद्धोहनूमन्तंस्तनान्तरे ॥", "padaccheda": "", "an