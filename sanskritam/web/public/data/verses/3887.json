[{"id": 2133794, "chapter_id": 3887, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2133795, "chapter_id": 3887, "verse_number": "१", "content_sanskrit": "श्रुत्वेमां धर्मसंयुक्तां धर्मराजः कथां शुभाम् ।\nपुनः पप्रच्छ तमृषिं मार्कण्डेयमिदं तदा\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2133796, "chapter_id": 3887, "verse_number": "२", "content_sanskrit": "कथमग्निर्वनं यातः कथं चाप्यङ्गिराः पुरा ।\nनष्टेऽग्नौ हव्यमवहदग्निर्भूत्वा महाद्युतिः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2133797, "chapter_id": 3887, "verse_number": "३", "content_sanskrit": "अग्निर्यदा त्वेक एव बहुत्वं चास्य कर्मसु ।\nदृश्यते भगवन्सर्वमेतदिच्छामि वेदितुम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2133798, "chapter_id": 3887, "verse_number": "४", "content_sanskrit": "कुमारश्च यथोत्पन्नो यथा चाग्नेः सुतोऽभवत् ।\nयथा रुद्राच्च सम्भूतो गङ्गायां कृत्तिकासु च \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2133799, "chapter_id": 3887, "verse_number": "५", "content_sanskrit": "एतदिच्छाम्यहं त्वत्तः श्रोतुं भार्गवसत्तम ।\nकौतूहलसमाविष्टो याथातथ्यं महामुने\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2133800, "chapter_id": 3887, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2133801, "chapter_id": 3887, "verse_number": "६", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nयथा क्रुद्धो हुतवहस्तपस्तप्तुं वनं गतः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2133802, "chapter_id": 3887, "verse_number": "७", "content_sanskrit": "यथा च भगवानग्निः स्वयमेवाङ्गिराऽभवत् ।\nसन्तापयंश्च प्रभया नाशयंस्तिमिराणि च \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2133803, "chapter_id": 3887, "verse_number": "८", "content_sanskrit": "पुराङ्गिरा महाबाहो चचार तप उत्तमम् ।\nआश्रमस्थो महाभागो हव्यवाहं विशेषयन् ।\nतथा स भूत्वा तु तदा जगत् सर्वं व्यकाशयत् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2133804, "chapter_id": 3887, "verse_number": "९", "content_sanskrit": "तपश्चरंस्तु हुतभुक् सन्तप्तस्तस्य तेजसा ।\nभृशं ग्लानश्च तेजस्वी न च किञ्चित् प्रजज्ञिवान् ।\nअथ सञ्चिन्तयामास भगवान् हव्यवाहनः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2133805, "chapter_id": 3887, "verse_number": "१०", "content_sanskrit": "अन्योऽग्निरिह लोकानां ब्रह्मणा सम्प्रकल्पितः ।\nअग्नित्वं विप्रणष्टं हि तप्यमानस्य मे तपः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2133806, "chapter_id": 3887, "verse_number": "११", "content_sanskrit": "कथमग्निः पुनरहं भवेयमिति चिन्त्य सः ।\nअपश्यदग्निवल्लोकांस्तापयन्तं महामुनिम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2133807, "chapter_id": 3887, "verse_number": "१२", "content_sanskrit": "सोपासर्पच्छनैर्भीतस्तमुवाच तदाऽङ्गिराः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2133808, "chapter_id": 3887, "verse_number": "१३", "content_sanskrit": "शीघ्रमेव भवस्वाग्निस्त्वं पुनर्लोकभावनः ।\nविज्ञातश्चासि लोकेषु त्रिषु संस्थानचारिषु\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2133809, "chapter_id": 3887, "verse_number": "१४", "content_sanskrit": "त्वमग्निः प्रथमं सृष्टो ब्रह्मणा तिमिरापहः ।\nस्वस्थानं प्रतिपद्यस्व शीघ्रमेव तमोनुद\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2133810, "chapter_id": 3887, "verse_number": "", "content_sanskrit": "अग्निः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2133811, "chapter_id": 3887, "verse_number": "१५", "content_sanskrit": "नष्टकीर्तिरहं लोके भवान् जातो हुताशनः ।\nभवन्तमेव ज्ञास्यन्ति पावकं न तु मां जनाः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2133812, "chapter_id": 3887, "verse_number": "१६", "content_sanskrit": "निक्षिपाम्यहमग्नित्वं त्वमग्निः प्रथमो भव ।\nभविष्यामि द्वितीयोऽहं प्राजापत्यस्तथैकतः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2133813, "chapter_id": 3887, "verse_number": "", "content_sanskrit": "अङ्गिराः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2133814, "chapter_id": 3887, "verse_number": "१७", "content_sanskrit": "कुरु पुण्यं प्रजास्वर्ग्यं भवाग्निस्तिमिरापहः ।\nमां च देव कुरुष्वाग्ने प्रथमं पुत्रमञ्जसा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2133815, "chapter_id": 3887, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2133816, "chapter_id": 3887, "verse_number": "१८", "content_sanskrit": "तच्छ्रुत्वाऽङ्गिरसो वाक्यं जातवेदास्तथाऽकरोत् ।\nराजन् बृहस्पतिर्नाम तस्याप्यङ्गिरसः सुतः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2133817, "chapter_id": 3887, "verse_number": "१९", "content_sanskrit": "ज्ञात्वा प्रथमजं तं तु वह्नेरङ्गिरसं सुतम् ।\nउपेत्य देवाः पप्रच्छुः कारणं तत्र भारत\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2133818, "chapter_id": 3887, "verse_number": "२०", "content_sanskrit": "स तु पृष्टस्तदा देवैस्ततः कारणमब्रवीत् ।\nप्रत्यगृह्णंस्तु देवाश्च तद्वचोऽङिगरसस्तदा\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2133819, "chapter_id": 3887, "verse_number": "२१", "content_sanskrit": "तत्र नानाविधानग्नीन् प्रवक्ष्यामि महाप्रभान् ।\nकर्मभिर्बहुभिः ख्यातान् नानार्थान् ब्राह्मणेष्विह\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2133820, "chapter_id": 3887, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि अष्टाधिकद्विशततमोऽध्यायः ॥२०८॥\n॥ इति मार्कण्डेयसमास्यापर्वणि त्रयस्त्रिंशोऽध्यायः ॥३३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]