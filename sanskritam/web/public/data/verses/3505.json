[{"id": 2116401, "chapter_id": 3505, "verse_number": "", "content_sanskrit": "गन्धर्ववाक्याद् धौम्याश्रमं गत्वा पाण्डवैस्तद्वरणम् ।\nतस्याङ्गीकारः । पाण्डवानां धौम्यस्य च हर्षः । धौम्येन\nसह पाण्डवानां स्वयंवरार्थं पाञ्चालनगरीं प्रति गमनं च ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2116402, "chapter_id": 3505, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2116403, "chapter_id": 3505, "verse_number": "१", "content_sanskrit": "अस्माकमनुरूपं वै यस्तं गन्धर्वसत्तम ।\nपुरोहितं ममाचक्ष्व सर्वं हि विदितं तव \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2116404, "chapter_id": 3505, "verse_number": "", "content_sanskrit": "गन्धर्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2116405, "chapter_id": 3505, "verse_number": "२", "content_sanskrit": "यवीयान् देवलस्यैष वने भ्राता तपस्यति ।\nधौम्य उत्कचके तीर्थे तं वृणीष्व यदीच्छसि \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2116406, "chapter_id": 3505, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2116407, "chapter_id": 3505, "verse_number": "३", "content_sanskrit": "ततोऽर्जुनोऽस्त्रमाग्नेयं प्रददौ तद् यथाविधि ।\nगन्धर्वाय ददौ प्रीतो वचनं चेदमब्रवीत् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2116408, "chapter_id": 3505, "verse_number": "४", "content_sanskrit": "त्वय्येव तावत् तिष्ठन्तु हया गन्धर्वसत्तम ।\nकार्यकाले ग्रहीष्यामि स्वस्ति तेऽस्त्विति चाब्रवीत् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2116409, "chapter_id": 3505, "verse_number": "५", "content_sanskrit": "तेऽन्योन्यमभिसम्पूज्य गन्धर्वः पाण्डवाश्च ह ।\nरम्याद् भागीरथीकच्छाद् यथाकामं प्रतस्थिरे \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2116410, "chapter_id": 3505, "verse_number": "६", "content_sanskrit": "तत उत्कचकं तीर्थं गत्वा धौम्याश्रमान्तिके ।\nतं वव्रुः पाण्डवा धौम्यं पौरोहित्याय पाण्डव \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2116411, "chapter_id": 3505, "verse_number": "७", "content_sanskrit": "तांश्चापि प्रतिजग्राह सर्ववेदविदां वरः ।\nपाद्येन फलमूलेन पौरोहित्येन चैव ह\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2116412, "chapter_id": 3505, "verse_number": "८", "content_sanskrit": "तेन चाशंसिरे लब्धां श्रियं राज्यं च पाण्डवाः ।\nब्राह्मणं तं पुरस्कृत्य पाञ्चाल्याश्च स्वयंवरे \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2116413, "chapter_id": 3505, "verse_number": "९", "content_sanskrit": "मातृषष्ठास्ततस्तेन गुरुणा सह सङ्गताः ।\nनाथवन्तमिवात्मानं मेनिरे भरतर्षभाः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2116414, "chapter_id": 3505, "verse_number": "१०", "content_sanskrit": "स हि वेदार्थतत्वज्ञस्तेषां गुरुरुदारधीः ।\nवेदविच्चैव वाग्मी च धौम्यः श्रीमान् द्विजोत्तमः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2116415, "chapter_id": 3505, "verse_number": "११", "content_sanskrit": "तेजसा चैव बुद्ध्या च रूपेण यशसा श्रिया ।\nमन्त्रैश्च विविधैर्धौम्यस्तुल्य आसीद् बृहस्पतेः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2116416, "chapter_id": 3505, "verse_number": "१२", "content_sanskrit": "स चापि विप्रस्तान् मेने स्वभावाभ्यधिकान् भुवि ।\nतेन धर्मविदा पार्था योज्याः सर्वविदा वृताः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2116417, "chapter_id": 3505, "verse_number": "१३", "content_sanskrit": "मेनिरे सहिता वीराः प्राप्तं राज्यं स्वधर्मतः ।\nबुद्धिवीर्यबलोत्साहैर्युक्ता देवा इवापराः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2116418, "chapter_id": 3505, "verse_number": "१४", "content_sanskrit": "मेनिरे सहिता गन्तुं पाञ्चाल्यास्तं स्वयंवरम् ।\nततस्ते नरशार्दूला भ्रातरः पञ्च पाण्डवाः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2116419, "chapter_id": 3505, "verse_number": "१५", "content_sanskrit": "प्रययुर्द्रौपदीं द्रष्टुं तं च देवमहोत्सवम् ।\nते प्रयाता नरव्याघ्रा मात्रा सह परन्तपाः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2116420, "chapter_id": 3505, "verse_number": "१६", "content_sanskrit": "ब्राह्मणान् ददृशुर्मार्गे गच्छतः सगणान् बहून् ।\nतानूचुर्ब्राह्मणा राजन् पाण्डवान् ब्रह्मचारिणः ।\nक्व भवन्तो गमिष्यन्ति कुतो वाऽऽगच्छतेति ह \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2116421, "chapter_id": 3505, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2116422, "chapter_id": 3505, "verse_number": "१७", "content_sanskrit": "आगतानेकचक्रायाः सोदर्यान् देवदर्शिनः ।\nभवन्तो हि विजानन्तु सहितान् मातृचारिणः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2116423, "chapter_id": 3505, "verse_number": "", "content_sanskrit": "ब्राह्मणाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2116424, "chapter_id": 3505, "verse_number": "१८", "content_sanskrit": "गच्छताद्यैव पाञ्चालान् द्रुपदस्य निवेशनम् ।\nस्वयंवरो महानत्र भविता सुमहोत्सवः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2116425, "chapter_id": 3505, "verse_number": "१९", "content_sanskrit": "एकसार्थं प्रयाताः स्मो वयमप्यत्र गामिनः ।\nतत्र ह्यद्भुतसङ्काशो भविता सुमहोत्सवः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2116426, "chapter_id": 3505, "verse_number": "२०", "content_sanskrit": "यज्ञसेनस्य दुहिता द्रुपदस्य महात्मनः ।\nवेदिमध्यात् समुत्पन्ना पद्मपत्रनिभेक्षणा \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2116427, "chapter_id": 3505, "verse_number": "२१", "content_sanskrit": "दर्शनीयानवद्याङ्गी सुकुमारी मनस्विनी ।\nधृष्टद्युम्नस्य भगिनी द्रोणशत्रोः प्रतापिनः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2116428, "chapter_id": 3505, "verse_number": "२२", "content_sanskrit": "यो जातः कवची खड्गी सशरः सशरासनः ।\nसुसमिद्धे महाबाहुः पावके पावकप्रभः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2116429, "chapter_id": 3505, "verse_number": "२३", "content_sanskrit": "स्वसा तस्यानवद्याङ्गी द्रौपदी तनुमध्यमा ।\nनीलोत्पलसमो गन्धो यस्याः क्रोशात् प्रवायति \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2116430, "chapter_id": 3505, "verse_number": "२४", "content_sanskrit": "तां यज्ञसेनस्य सुतां स्वयंवरकृतक्षणाम् ।\nगच्छामहे वयं द्रष्टुं तं च देवमहोत्सवम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2116431, "chapter_id": 3505, "verse_number": "२५", "content_sanskrit": "राजानो राजपुत्राश्च यज्वानो भूरिदक्षिणाः ।\nस्वाध्यायवन्तः शुचयो महात्मानो महाव्रताः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2116432, "chapter_id": 3505, "verse_number": "२६", "content_sanskrit": "तरुणा दर्शनीयाश्च नानादेशसमागताः ।\nमहारथाः कृतास्त्राश्च समुपैष्यन्ति भूमिपाः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2116433, "chapter_id": 3505, "verse_number": "२७", "content_sanskrit": "ते तत्र विविधान् देयान् विजयार्थं नरेश्वराः ।\nप्रदास्यन्ति धनं गाश्च भक्ष्यं भोज्यं च सर्वशः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2116434, "chapter_id": 3505, "verse_number": "२८", "content_sanskrit": "प्रतिगृह्य च तत् सर्वं दृष्ट्वा चैव स्वयंवरम् ।\nअनुभूयोत्सवं चैव गमिष्यामो यथेप्सितम् \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2116435, "chapter_id": 3505, "verse_number": "२९", "content_sanskrit": "ये च वैतालिकाश्चैव नर्तकाः सूतमागधाः ।\nनियोधकाश्च देशेभ्यः समेष्यन्ति महाबलाः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2116436, "chapter_id": 3505, "verse_number": "३०", "content_sanskrit": "एवं कौतूलहं दृष्ट्वा भुक्त्वा च प्रतिगृह्य च ।\nसहास्माभिर्महात्मानः पुनः प्रतिनिवर्त्स्यथ \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2116437, "chapter_id": 3505, "verse_number": "३१", "content_sanskrit": "दर्शनीयांश्च वः सर्वान् देवरूपानवस्थितान् ।\nसमीक्ष्य कृष्णा वरयेत् सङ्गत्यान्यतमं पतिम् \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2116438, "chapter_id": 3505, "verse_number": "३३", "content_sanskrit": "अयं भ्राता तव श्रीमान् दर्शनीयो महाभुजः ।\nनियुध्यमानो विजयेत् सङ्गत्य द्रविणं बहु \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2116439, "chapter_id": 3505, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2116440, "chapter_id": 3505, "verse_number": "३४", "content_sanskrit": "परमं भो गमिष्यामो द्रष्टुं देवमहोत्सवम् ।\nभवद्भिः सहिताः सर्वे कन्यायास्तं स्वयंवरम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2116441, "chapter_id": 3505, "verse_number": "१", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nचतुरशीत्यदधिकशततमोऽध्यायः ॥ इति स्वयंवरपर्वणि प्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2116442, "chapter_id": 3505, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]