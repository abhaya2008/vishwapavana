[{"id": 2194920, "chapter_id": 5145, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2194921, "chapter_id": 5145, "verse_number": "१", "content_sanskrit": "स पन्नगपतिस्तत्र प्रययौ ब्राह्मणं प्रति ।\nतमेव मनसा ध्यायन्कार्यवत्तां विचारयन्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2194922, "chapter_id": 5145, "verse_number": "२", "content_sanskrit": "तमभिक्रम्य नागेन्द्रो मतिमान् स नरेश्वर ।\nप्रोवाच मधुरं वाक्यं प्रकृत्या धर्मवत्सलः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2194923, "chapter_id": 5145, "verse_number": "३", "content_sanskrit": "भो भो क्षाम्याभिभाषे त्वां न रोषं कर्तुमर्हसि ।\nइह त्वमभिसम्प्राप्तः कस्यार्थे किं प्रयोजनम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2194924, "chapter_id": 5145, "verse_number": "४", "content_sanskrit": "आभिमुख्यादभिक्रम्य स्नेहात् पृच्छामि ते द्विज ।\nविविक्ते गोमतीतीरे किं वा त्वं पर्युपाससे\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2194925, "chapter_id": 5145, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2194926, "chapter_id": 5145, "verse_number": "५", "content_sanskrit": "धर्मारण्यं हि मां विद्धि नागं द्रष्टुमिहागतम् ।\nपद्मनाभं द्विजश्रेष्ठं तत्र मे कार्यमाहितम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2194927, "chapter_id": 5145, "verse_number": "६", "content_sanskrit": "तस्य चाहमसान्निध्यं श्रुतवानस्मि तं गतम् ।\nस्वजनं तं प्रतीक्षामि पर्जन्यमिव कर्षकः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2194928, "chapter_id": 5145, "verse_number": "७", "content_sanskrit": "तस्य चाक्लेशकरणं स्वस्तिकारसमाहितम् ।\nवर्तयाम्ययुतं ब्रह्म योगयुक्तो निरामयः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2194929, "chapter_id": 5145, "verse_number": "", "content_sanskrit": "नागः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2194930, "chapter_id": 5145, "verse_number": "८", "content_sanskrit": "अहो कल्याणवृत्तस्त्वं साधु सज्जनवत्सलः ।\nश्रवाढ्यस्त्वं महाभाग परं स्नेहेन पश्यसि\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2194931, "chapter_id": 5145, "verse_number": "९", "content_sanskrit": "अहं स नागो विप्रर्षे यथा मां विन्दते भवान् ।\nआज्ञापय यथा स्वैरं किं करोमि प्रियं तव\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2194932, "chapter_id": 5145, "verse_number": "१०", "content_sanskrit": "भवन्तं स्वजनादस्मि सम्प्राप्तं श्रुतवानिह ।\nअतस्त्वां स्वयमेवाहं द्रष्टुमभ्यागतो द्विज\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2194933, "chapter_id": 5145, "verse_number": "११", "content_sanskrit": "सम्प्राप्तश्च भवानद्य कृतार्थः प्रतियास्यति ।\nविस्रब्धो मां द्विजश्रेष्ठ विषये योक्तुमर्हसि\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2194934, "chapter_id": 5145, "verse_number": "१२", "content_sanskrit": "वयं हि भवता सर्वे गुणक्रीता विशेषतः ।\nयस्त्वमात्महितं त्यक्त्वा मामेवेहानुरुध्यसे\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2194935, "chapter_id": 5145, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2194936, "chapter_id": 5145, "verse_number": "१३", "content_sanskrit": "आगतोऽहं महाभाग तव दर्शनलालसः ।\nकञ्चिदर्थमनर्थज्ञः प्रष्टुकामो भुजङ्गम\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2194937, "chapter_id": 5145, "verse_number": "१४", "content_sanskrit": "अहमात्मानमात्मस्थो मार्गमाणोऽऽत्मनो हितम् ।\nवासार्थिनं महाप्राज्ञ बलवन्तमुपास्मि ह\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2194938, "chapter_id": 5145, "verse_number": "१५", "content_sanskrit": "प्रकाशितस्त्वं स्वगुणैर्यशोगर्भगभस्तिभिः ।\nशशाङ्ककरसंस्पर्शैर्हृद्यैरात्मप्रकाशितैः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2194939, "chapter_id": 5145, "verse_number": "१६", "content_sanskrit": "तस्य मे प्रश्नमुत्पन्नं छिन्धि त्वमनिलाशन ।\nपश्चात् कार्यं वदिष्यामि श्रोतुमर्हति मे भवान्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2194940, "chapter_id": 5145, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे चतुर्नवत्युत्तरशततमोऽध्यायः ॥१९५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]