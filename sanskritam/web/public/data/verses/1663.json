[{"id": 2030414, "chapter_id": 1663, "verse_number": "३-३०१-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2030415, "chapter_id": 1663, "verse_number": "३-३०१-१", "content_sanskrit": "यत्तत्तदा महद्ब्रह्मँल्लोमशो वाक्यमब्रवीत्।\nइन्द्रस्य वचनादेव पाण्डुपुत्रं युधिष्ठिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2030416, "chapter_id": 1663, "verse_number": "३-३०१-२", "content_sanskrit": "यच्चापि ते भयं तीव्रं न च कीर्तयसे क्वचित्।\nतच्चाप्यपहरिष्यामि धनंजय इतो गते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2030417, "chapter_id": 1663, "verse_number": "३-३०१-३", "content_sanskrit": "किंनु रतज्जपतांश्रेष्ठ कर्णं प्रति महद्भयम्।\nआसीन्न च स धर्मात्मा कथयामास कस्यचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2030418, "chapter_id": 1663, "verse_number": "३-३०१-४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2030419, "chapter_id": 1663, "verse_number": "३-३०१-४", "content_sanskrit": "अहं ते राजशार्दूल कथयामि कथामिमाम्।\nपृच्छतो भरतश्रेष्ठ शुश्रूषस्व गिरं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2030420, "chapter_id": 1663, "verse_number": "३-३०१-५", "content_sanskrit": "द्वादशे समतिक्रान्ते वर्षे प्राप्ते त्रयोदशे।\nपाण्डूनां हितकृच्छक्रः कर्णं भिक्षितुमुद्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2030421, "chapter_id": 1663, "verse_number": "३-३०१-६", "content_sanskrit": "अभिप्रायमथो ज्ञात्वा महेन्द्रस्य विभावसुः।\nकुण्डलार्थे महाराज सूर्यः कर्णमुपागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2030422, "chapter_id": 1663, "verse_number": "३-३०१-७", "content_sanskrit": "महार्हे शयने वीरं स्पर्द्ध्यास्तरणसंवृते।\nशयानमतिविश्वस्तं ब्रह्मण्यं सत्यवादिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2030423, "chapter_id": 1663, "verse_number": "३-३०१-८", "content_sanskrit": "स्वप्नान्ते निशि राजेन्द्र दर्शयामास रश्मिवान्।\nकृपया परयाऽऽविष्टः पुत्रस्नेहाच्च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2030424, "chapter_id": 1663, "verse_number": "३-३०१-९", "content_sanskrit": "ब्राह्मणो वेदविद्भूत्वा सूर्यो योगर्द्धिरूपवान्।\nहितार्थमब्रवीत्कर्णं सान्त्वपूर्वमिदं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2030425, "chapter_id": 1663, "verse_number": "३-३०१-१०", "content_sanskrit": "कर्ण मद्वचनं तात शृणु सत्यभृतांवर।\nब्रुवतोऽद्य महाबाहो सौहृदात्परमं हितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2030426, "chapter_id": 1663, "verse_number": "३-३०१-११", "content_sanskrit": "उपायास्यति शक्रस्त्वां पाण्डवानां हितेप्सया।\nब्राह्मणच्छद्मना कर्ण कुण्डलोपजिहीर्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2030427, "chapter_id": 1663, "verse_number": "३-३०१-१२", "content_sanskrit": "विदितं तेन शीलं ते सर्वस्य जगतस्तथा।\nयथा त्वं भिक्षितः सद्भिर्ददास्येव न याचसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2030428, "chapter_id": 1663, "verse_number": "३-३०१-१३", "content_sanskrit": "त्वं हि तात ददास्येव ब्राह्मणेभ्यः प्रयाचितम्।\nवित्तं यच्चान्यदप्याहुर्न प्रत्याख्यासि कस्यचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2030429, "chapter_id": 1663, "verse_number": "३-३०१-१४", "content_sanskrit": "त्वां तु चैवंविधं ज्ञात्वा स्वयं वै पाकशासनः।\nआगन्ता रकुण्डलार्थाय कवचं चैव भिक्षितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2030430, "chapter_id": 1663, "verse_number": "३-३०१-१५", "content_sanskrit": "तस्मै प्रयाचमानाय न देये कुण्डले त्वया।\nअनुनेयः परं शक्त्या श्रेय एतद्धि ते परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2030431, "chapter_id": 1663, "verse_number": "३-३०१-१६", "content_sanskrit": "कुण्डलार्थेऽब्रुवंस्तात कारणैर्बहुभिस्त्वया।\nअन्यैर्बहुविधैर्वित्तैः सन्निवार्यः पुनःपुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2030432, "chapter_id": 1663, "verse_number": "३-३०१-१७", "content_sanskrit": "रत्नैः स्त्रीभिस्तथा गोभिर्धनैर्बहुविधैरपि।\nनिदर्शनैश्च बहुभिः कुण्डलेप्सुः पुरंदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2030433, "chapter_id": 1663, "verse_number": "३-३०१-१८", "content_sanskrit": "यदि दास्यसि कर्ण त्वं सहजे कुण्डले शुभे।\nआयुषः प्रक्षयं गत्वा मृत्योर्वशमुपैष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2030434, "chapter_id": 1663, "verse_number": "३-३०१-१९", "content_sanskrit": "कवचेन समायुक्तः कुण्डलाभ्यां च मानद।\nअवध्यस्त्वं रणेऽरीणामिति विद्धि वचो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2030435, "chapter_id": 1663, "verse_number": "३-३०१-२०", "content_sanskrit": "अमृतादुत्थितं ह्येतदुभयं रत्नसंमितम्।\nतस्माद्रक्ष्यं त्वया कर्ण जीवितं चेत्प्रियं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2030436, "chapter_id": 1663, "verse_number": "३-३०१-२०x", "content_sanskrit": "कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2030437, "chapter_id": 1663, "verse_number": "३-३०१-२१", "content_sanskrit": "को मामेवं भवान्प्राह दर्शयन्सौहृदं परम्।\nकामया भगवन्ब्रूहि को भवान्द्विजवेषधृक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2030438, "chapter_id": 1663, "verse_number": "३-३०१-२२x", "content_sanskrit": "ब्रह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2030439, "chapter_id": 1663, "verse_number": "३-३०१-२२", "content_sanskrit": "अहं तात सहस्रांशुः सौहृदात्त्वां निदर्शये।\nकुरुष्वैतद्वयो मे त्वमेतच्छ्रेयः परं हि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2030440, "chapter_id": 1663, "verse_number": "३-३०१-२३x", "content_sanskrit": "कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2030441, "chapter_id": 1663, "verse_number": "३-३०१-२३", "content_sanskrit": "श्रेय एव ममात्यन्तं यस्य मे गोपतिः प्रभुः।\nप्रवक्ताऽद्य हितान्वेषी शृणु चेदं वचो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2030442, "chapter_id": 1663, "verse_number": "३-३०१-२४", "content_sanskrit": "प्रसादये त्वां वरदं प्रणयाच्च ब्रवीम्यहम्।\nन निवार्यो व्रतादस्मादहं यद्यस्मि ते प्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2030443, "chapter_id": 1663, "verse_number": "३-३०१-२५", "content_sanskrit": "व्रतं वै मम लोकोऽयं वेत्ति कृत्स्नं विभावसो।\nयथाऽहं द्विजमुख्येभ्यो दद्यां प्राणानपिध्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2030444, "chapter_id": 1663, "verse_number": "३-३०१-२६", "content_sanskrit": "यद्यागच्छति मां शक्रो ब्राह्मणच्छद्मना वृतः।\nहितार्थं पाण्डुपुत्राणां खेचरोत्तम भिक्षितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2030445, "chapter_id": 1663, "verse_number": "३-३०१-२७", "content_sanskrit": "दास्यामि विबुधश्रेष्ठ कुण्डले वर्म चोत्तमम्।\nन मे कीर्तिः प्रणश्येत त्रिषु लोकेषु विश्रुता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2030446, "chapter_id": 1663, "verse_number": "३-३०१-२८", "content_sanskrit": "मद्विधस्यायशस्यं हि न युक्तं प्राणरक्षणम्।\nयुक्तं हि यशसा युक्तं मरणं लोकसंमतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2030447, "chapter_id": 1663, "verse_number": "३-३०१-२९", "content_sanskrit": "सोहमिन्द्राय दास्यामि कुण्डले सह वर्मणा।\nयदि मां बलवृत्रघ्नो भिक्षार्थमुपयास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2030448, "chapter_id": 1663, "verse_number": "३-३०१-३०", "content_sanskrit": "हितार्थं पाण्डुपुत्राणां कुण्डले मे प्रयाचितुम्।\nतन्मे कीर्तिकरं लोके तस्याकीर्तिर्भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2030449, "chapter_id": 1663, "verse_number": "३-३०१-३१", "content_sanskrit": "वृणोमि कीर्तिं लोके हि जीवितेनापि भानुमन्।\nकीर्तिमानश्नुते स्वर्गं हीनकीर्तिस्तु नश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2030450, "chapter_id": 1663, "verse_number": "३-३०१-३२", "content_sanskrit": "कीर्तिर्हि पुरुषं लोके संजीवयति मातृवत्।\nअकीर्तिर्जीवितं हन्ति जीवतोपि शरीरिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2030451, "chapter_id": 1663, "verse_number": "३-३०१-३३", "content_sanskrit": "अयंपुराणः श्लोको हि स्वयं गीतो विभावसो।\nधात्रा लोकेश्वर यथा कीर्तिरायुर्नरस्य ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2030452, "chapter_id": 1663, "verse_number": "३-३०१-३४", "content_sanskrit": "पुरुषस्य परे लोके कीर्तिरेव परायणम्।\nइह लोके विशुद्धा च कीर्तिरायुर्विवर्धनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2030453, "chapter_id": 1663, "verse_number": "३-३०१-३५", "content_sanskrit": "सोहं शरीरजे दत्त्वा कीर्तिं प्राप्स्यामि शाश्वतीम्।\nदत्त्वा च विधिवद्दानं ब्राह्मणेभ्यो यथाविधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2030454, "chapter_id": 1663, "verse_number": "३-३०१-३६", "content_sanskrit": "हुत्वा शरीरं रसंग्रामे कृत्वा कर्म सुदुष्करम्।\nविजित्य च परानाजौ यशः प्राप्स्यामि केवलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2030455, "chapter_id": 1663, "verse_number": "३-३०१-३७", "content_sanskrit": "भीतानामभयं दत्त्वा संग्रामे जीवितार्थिनाम्।\nवृद्धान्वालान्द्विजातींश्च मोक्षयित्वा महाभयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2030456, "chapter_id": 1663, "verse_number": "३-३०१-३८", "content_sanskrit": "प्राप्स्यामि परमं लोके यशः स्वर्ग्यमनुत्तमम्।\nजीवितेनापि मे रक्ष्या कीर्तिस्तद्विद्वि मे व्रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2030457, "chapter_id": 1663, "verse_number": "३-३०१-३९", "content_sanskrit": "सो हं दत्त्वा मघवते भिक्षामेतामनुत्तमाम्।\nब्राह्मणच्छद्मिने देव लोके गन्ता परां गतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2030458, "chapter_id": 1663, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि कुण्डलाहरणपर्वणि एकाधिकत्रिशततमोऽध्यायः ॥ ३०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]