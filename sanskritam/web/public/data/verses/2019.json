[{"id": 2045901, "chapter_id": 2019, "verse_number": "६-६८-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2045902, "chapter_id": 2019, "verse_number": "६-६८-१", "content_sanskrit": "स्तवं वै ब्रह्मसंयुक्तं शृणु कृष्णस्य भारत।\nब्रह्मर्षिभिश्च देवैश्च यः पुरा कथितो भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2045903, "chapter_id": 2019, "verse_number": "६-६८-२", "content_sanskrit": "साध्यानामपि देवानां देवदेवेश्वरः प्रभुः ।\nलोकभावनभावज्ञ इति त्वां नारदोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2045904, "chapter_id": 2019, "verse_number": "६-६८-३", "content_sanskrit": "भूतं भव्यं भविष्यच्च मार्कण्डेयोऽभ्युवाच ह।\nयज्ञं त्वां चैव यज्ञानां तपश्च तपसामपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2045905, "chapter_id": 2019, "verse_number": "६-६८-४", "content_sanskrit": "देवानामपि देवं च त्वामाह भगवान्भृगुः ।\nपुराणां चैव परमं विष्णो रूपं तवेति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2045906, "chapter_id": 2019, "verse_number": "६-६८-५", "content_sanskrit": "वासुदेवो वसूनां त्वं शक्रं स्थापयिता तथा।\nदेवदेवोऽसि देवानामिति द्वैपायनोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2045907, "chapter_id": 2019, "verse_number": "६-६८-६", "content_sanskrit": "पूर्वे प्रजानिसर्गे च दक्षमाहुः प्रजापतिम्।\nस्रष्टारं सर्वभूतानामङ्गिरास्त्वां तथाऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2045908, "chapter_id": 2019, "verse_number": "६-६८-७", "content_sanskrit": "अव्यक्तं ते शरीरोत्थं व्यक्तं ते मनसि स्थितम् ।\nदेवास्त्वत्संभवाश्चैव देवलस्त्वसितोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2045909, "chapter_id": 2019, "verse_number": "६-६८-८", "content_sanskrit": "शिरसा ते दिव्यं व्याप्तं बाहुभ्यां पृथिवी तथा ।\nजठरं ते त्रयो लोकाः पुरुषोऽसि सनातनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2045910, "chapter_id": 2019, "verse_number": "६-६८-९", "content_sanskrit": "एवं त्वामभिजानन्ति तपसा भाविता नराः।\nआत्मदर्शनतृप्तानामृषीणां चासि सत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2045911, "chapter_id": 2019, "verse_number": "६-६८-१०", "content_sanskrit": "राजर्षीणामुदाराणामाहवेष्वनिवर्तिनाम् ।\nसर्वधर्मप्रधानानां त्वं गतिर्मधुसूदन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2045912, "chapter_id": 2019, "verse_number": "६-६८-११", "content_sanskrit": "इति नित्यं योगविर्द्भिर्भगवान्पुरुषोत्तमः।\nसनत्कुमारप्रमुखैः स्तूयतेऽभ्यर्च्यते हरिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2045913, "chapter_id": 2019, "verse_number": "६-६८-१२", "content_sanskrit": "एष ते विस्तरस्तात संक्षेपश्च प्रकीर्तितः ।\nकेशवस्य यथा तत्त्वं सुप्रीतो भज केशवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2045914, "chapter_id": 2019, "verse_number": "६-६८-१३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2045915, "chapter_id": 2019, "verse_number": "६-६८-१३", "content_sanskrit": "पुण्यं श्रुत्वैतदाख्यानं महाराज सुतस्तव।\nकेशवं बहुमेने स पाण्डवांश्च महारथान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2045916, "chapter_id": 2019, "verse_number": "६-६८-१४", "content_sanskrit": "तमब्रवीन्महाराज भीष्मः शान्तनवः पुनः ।\nमाहात्म्यं ते श्रुतं राजन्केशवस्य महात्कमनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2045917, "chapter_id": 2019, "verse_number": "६-६८-१५", "content_sanskrit": "नरस्य च यथातत्त्वं यन्मां त्वं पृच्छसे नृप।\nयदर्थं नृषु संभूतौ नरानारायणावृषी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2045918, "chapter_id": 2019, "verse_number": "६-६८-१६", "content_sanskrit": "अवध्यौ च यथा वीरौ संयुगेष्वपराजितौ ।\nयथा च पाण्डवा राजन्नवध्या युधि कस्यचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2045919, "chapter_id": 2019, "verse_number": "६-६८-१७", "content_sanskrit": "प्रीतिमान्हि दृढं कृष्णः पाण्डवेषु यशस्विषु ।\nतस्माद्ब्रवीमि राजेन्द्र शमो भवतु पाण्डवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2045920, "chapter_id": 2019, "verse_number": "६-६८-१८", "content_sanskrit": "पृथिवीं भुङ्क्ष्व सहितो भ्रातृभिर्बलिभिर्वशी ।\nनरानारायणौ देवाववज्ञाय नशिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2045921, "chapter_id": 2019, "verse_number": "६-६८-१९", "content_sanskrit": "एवमुक्त्वा तव पिता तूष्णीमासीद्विशांपते ।\nव्यसर्जयच्च राजानं शयनं च विवेश ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2045922, "chapter_id": 2019, "verse_number": "६-६८-२०", "content_sanskrit": "राजा च शिबिरं प्रायात्प्रणिपत्य महात्मने ।\nशिश्ये च शयने शुभ्रे रात्रिं तां भरतर्षभ ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2045923, "chapter_id": 2019, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि अष्टषष्टितमोऽध्यायः ॥ ॥ विश्वोपाख्यानं समाप्तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]