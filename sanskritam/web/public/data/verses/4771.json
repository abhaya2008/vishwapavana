[{"id": 2178318, "chapter_id": 4771, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2178319, "chapter_id": 4771, "verse_number": "१", "content_sanskrit": "तच्छ्रुत्वा वचनं तस्या भीमसेनोऽथ भीतवत् ।\nगान्धारीं प्रत्युवाचेदं वचः सानुनयं तदा\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2178320, "chapter_id": 4771, "verse_number": "", "content_sanskrit": "भीमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2178321, "chapter_id": 4771, "verse_number": "२", "content_sanskrit": "अधर्मो यदि वा धर्मः त्रासात् तत्र मया कृतः ।\nआत्मानं त्रातुकामेन तन्मे त्वं क्षन्तुमर्हसि\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2178322, "chapter_id": 4771, "verse_number": "३", "content_sanskrit": "न हि युद्धेन पुत्रस्ते धर्मेण सुमहाबलः ।\nशक्यः केनचिदुद्धर्तुं तस्माद् विषममाचरन्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2178323, "chapter_id": 4771, "verse_number": "४", "content_sanskrit": "अधर्मेण जितः पूर्वं तेनापि च युधिष्ठिरः ।\nनिकृताश्च सदैव स्म ततो विषममाचरम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2178324, "chapter_id": 4771, "verse_number": "५", "content_sanskrit": "सैन्यस्यैकोऽवशिष्टोऽयं गदायुद्धे च वीर्यवान् ।\nन त्यक्ष्यति हृतं राज्यमिति चैव कृतं मया\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2178325, "chapter_id": 4771, "verse_number": "६", "content_sanskrit": "मां हत्वा न हरेद् राज्यमिति चैतत् कृतं मया\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2178326, "chapter_id": 4771, "verse_number": "७", "content_sanskrit": "एकपत्नीं च पाञ्चालीमेकवस्त्रां रजस्वलाम् ।\nभवत्या विदितं सर्वमुक्तवान् यत् सुतस्तव\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2178327, "chapter_id": 4771, "verse_number": "८", "content_sanskrit": "सुयोधनमसंहृत्य न शक्या भूः ससागरा ।\nकेवलं भोक्तुमस्माभिरिति चैतत् कृतं मया\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2178328, "chapter_id": 4771, "verse_number": "९", "content_sanskrit": "तच्चाप्यप्रियमस्माकं पुत्रस्ते समुदाचरत् ।\nद्रौपद्या यत् सभामध्ये सव्यमूरुमदर्शयत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2178329, "chapter_id": 4771, "verse_number": "१०", "content_sanskrit": "तत्रैव वध्यः सोऽस्माकं दुराचारोऽम्ब ते सुतः ।\nधर्मराजाज्ञया त्वेवं स्थिताः स्म समये पुरा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2178330, "chapter_id": 4771, "verse_number": "११", "content_sanskrit": "वैरं सन्धुक्षितं राज्ञि पुत्रेण तव यन्महत् ।\nक्लेशिताश्च वनेऽत्यर्थं तस्मादेतत् कृतं मया\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2178331, "chapter_id": 4771, "verse_number": "१२", "content_sanskrit": "वैरस्यास्मि गतः पारं हत्वा दुर्योधनं रणे ।\nराज्यं युधिष्ठिरे प्राप्ते वयं विगतमन्यवः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2178332, "chapter_id": 4771, "verse_number": "", "content_sanskrit": "गान्धारी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2178333, "chapter_id": 4771, "verse_number": "१३", "content_sanskrit": "न तस्यैवं वधस्तात यं प्रशंससि मे सुतम् ।\nकृतवांश्चापि तत्सर्वं यदिदं भाषसे मयि\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2178334, "chapter_id": 4771, "verse_number": "१४", "content_sanskrit": "हताश्वे नकुले यत् तद् वृषसेनेन भारत ।\nअपिबः शोणितं सङ्खे दुःशासनशरीरजम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2178335, "chapter_id": 4771, "verse_number": "१५", "content_sanskrit": "सद्भिर्विगर्हितं घोरमनार्यजनसेवितम् ।\nक्रूरं कर्माकरोः कस्मात् तदयुक्तं वृकोदर\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2178336, "chapter_id": 4771, "verse_number": "", "content_sanskrit": "भीमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2178337, "chapter_id": 4771, "verse_number": "१६", "content_sanskrit": "अन्यस्यापि न पातव्यं रुधिरं किं पुनः स्वकम् ।\nयथैवात्मा तथा भ्राता न विशेषोऽस्ति कश्चन\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2178338, "chapter_id": 4771, "verse_number": "१७", "content_sanskrit": "हताश्वं नकुलं दृष्ट्वा वृषसेनेन संयुगे ।\nशत्रूणां तु प्रहृष्टानां त्रासः सञ्जनितो मया\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2178339, "chapter_id": 4771, "verse_number": "१८", "content_sanskrit": "स प्रतिज्ञामकरवं पिबाम्यसृगरेरिति ।\nरुधिरं नातिचक्राम दन्तोष्ठान्मेऽम्ब मा शुचः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2178340, "chapter_id": 4771, "verse_number": "१९", "content_sanskrit": "वैवस्वतो हि तद्वेद यथावत् कुलनन्दिनि ।\nमा कृथा हृदि तन्मातः न तत् पीतं मयाऽनघे\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2178341, "chapter_id": 4771, "verse_number": "२०", "content_sanskrit": "केशपक्षपरामर्शे द्रौपद्या द्यूतकारिते ।\nक्रोधाद्यदब्रवं चाहं तच्च मे क्षन्तुमर्हसि\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2178342, "chapter_id": 4771, "verse_number": "२१", "content_sanskrit": "क्षत्रधर्मच्युतो राज्ञि भवेयं शाश्वतीः समाः ।\nप्रतिज्ञां तामनिस्तीर्य ततस्तत् कृतवानहम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2178343, "chapter_id": 4771, "verse_number": "२२", "content_sanskrit": "अनिगृह्य पुरा पुत्रान् अस्मास्वनपकारिषु ।\nन मामर्हसि कल्याणि दोषेण परिशङ्कितुम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2178344, "chapter_id": 4771, "verse_number": "", "content_sanskrit": "गान्धारी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2178345, "chapter_id": 4771, "verse_number": "२३", "content_sanskrit": "वृद्धस्यास्य शतं पुत्रान् निघ्नंस्त्वमपराजितः ।\nकस्मान्न शेषितः कञ्चिद् येनाल्पमपराधितम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2178346, "chapter_id": 4771, "verse_number": "२४", "content_sanskrit": "सन्तानमावयोस्तात वृद्धयोर्हृतराज्ययोः ।\nनाशेषयः कथं यष्टिमेकां वृद्धयुगस्य वै\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2178347, "chapter_id": 4771, "verse_number": "२५", "content_sanskrit": "शेषे ह्यवस्थिते तात पुत्राणामल्पकेऽपि च ।\nन मे दुःखं भवेदद्य यदि त्वं धर्ममाचरेः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2178348, "chapter_id": 4771, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2178349, "chapter_id": 4771, "verse_number": "२६", "content_sanskrit": "तमेवमुक्त्वा गान्धारी युधिष्ठिरमपृच्छत ।\nक्व स राजेति सक्रोधा पुत्रपौत्रवधार्दिता\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2178350, "chapter_id": 4771, "verse_number": "२७", "content_sanskrit": "तामभ्यगच्छत् कौन्तेयो वेपमानः कृताञ्जलिः ।\nयुधिष्ठिरस्तु गान्धारीं मधुरं वाक्यमब्रवीत्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2178351, "chapter_id": 4771, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2178352, "chapter_id": 4771, "verse_number": "२८", "content_sanskrit": "पुत्रहन्ता नृशंसोऽहं तव देवि युधिष्ठिरः ।\nशापार्हः पृथिवीनाशे हेतुभूतः शपस्व माम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2178353, "chapter_id": 4771, "verse_number": "२९", "content_sanskrit": "न हि मे जीवितेनार्थो न राज्येन सुखेन वा ।\nतादृशान् सुहृदो हत्वा सुमूढस्य सुतद्रुहः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2178354, "chapter_id": 4771, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2178355, "chapter_id": 4771, "verse_number": "३०", "content_sanskrit": "तमेवंवादिनं भीतं सन्निकर्षागतं तदा ।\nनोवाच किञ्चिद् गान्धारी निःश्वासपरमा नृप\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2178356, "chapter_id": 4771, "verse_number": "", "content_sanskrit": "तस्यावनतदेहस्य पादयोर्निपतिष्यतः ।\n(युधिष्ठिरस्य नृपतेर्धर्मात्मा धर्मदर्शिनी\t॥३१॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2178357, "chapter_id": 4771, "verse_number": "३२", "content_sanskrit": "अङ्गुल्यग्राणि ददृशे देवी पट्टान्तरेण सा ।\nततः स कुनखीभूतो दर्शनीयनखो नृपः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2178358, "chapter_id": 4771, "verse_number": "३३", "content_sanskrit": "तं दृष्ट्वाऽथार्जुनोऽगच्छद् वासुदेवस्य पृष्ठतः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2178359, "chapter_id": 4771, "verse_number": "३४", "content_sanskrit": "एवं सञ्चेष्टमानांस्तान् इतश्चेतश्च भारत ।\nगान्धारी विगतक्रोधा सान्त्वयामास मातृवत्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2178360, "chapter_id": 4771, "verse_number": "३५", "content_sanskrit": "ते पाण्डवास्त्वनुज्ञाता मातरं वीतमत्सराः ।\nअभ्यगच्छन्त सहिताः पृथां पृथुलवक्षसः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2178361, "chapter_id": 4771, "verse_number": "३६", "content_sanskrit": "चिरस्य दृष्ट्वा पुत्रांस्तान् पुत्राधिभिरभिप्लुता ।\nबाष्पमाहारयामास वस्त्रेणावृत्य वै मुखम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2178362, "chapter_id": 4771, "verse_number": "३७", "content_sanskrit": "ततो बाष्पं समुत्सृज्य सह पुत्रैस्तथा पृथा ।\nअपश्यदेनान् शस्त्रौघैर्बहुधा परिविक्षतान्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2178363, "chapter_id": 4771, "verse_number": "३८", "content_sanskrit": "सा तानेकैकशः पुत्रान् संस्पृशन्ती पुनः पुनः ।\nअन्वशोचत दुःखार्तां द्रौपदीं निहतात्मजाम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2178364, "chapter_id": 4771, "verse_number": "३९", "content_sanskrit": "रुदन्तीमथ पाञ्चालीं ददर्श पतितां भुवि\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2178365, "chapter_id": 4771, "verse_number": "", "content_sanskrit": "पाञ्चाली", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2178366, "chapter_id": 4771, "verse_number": "४०", "content_sanskrit": "आर्ये पौत्रा क्व ते सर्वे सौभद्रसहिता गताः ।\nन त्वां तेऽद्याभिगच्छन्ति चिरदृष्टामनिन्दिते\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2178367, "chapter_id": 4771, "verse_number": "४१", "content_sanskrit": "किं नु राज्येन मे कार्यं विहीनायाः सुतैर्वरैः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2178368, "chapter_id": 4771, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2178369, "chapter_id": 4771, "verse_number": "४२", "content_sanskrit": "तां समाश्वासयामास पृथा पृथुललोचनाम् ।\nउत्थाप्य याज्ञसेनीं तु रुदतीं शोकलालसाम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2178370, "chapter_id": 4771, "verse_number": "४३", "content_sanskrit": "तयैव सहिता तत्र पुत्रैरनुगता पृथा ।\nअभ्यगच्छत गान्धारीमार्तमार्तस्तरा स्वयम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2178371, "chapter_id": 4771, "verse_number": "४४", "content_sanskrit": "तामुवाचाथ गान्धारी सह कुन्त्या यशस्विनीम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2178372, "chapter_id": 4771, "verse_number": "४५", "content_sanskrit": "मैवं पुत्रीति शोकार्ता पश्य मामपि दुःखिताम् ।\nमन्ये लोकविनाशोऽयं कालपर्यायचोदितः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2178373, "chapter_id": 4771, "verse_number": "४६", "content_sanskrit": "अवश्यभावी सम्प्राप्तः स्वभावाद् रोमहर्षणः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2178374, "chapter_id": 4771, "verse_number": "४७", "content_sanskrit": "इदं तु समनुप्राप्तं विदुरस्य वचो महत् ।\nअसिद्धानुनये कृष्णे यदुवाच महाद्युतिः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2178375, "chapter_id": 4771, "verse_number": "४८", "content_sanskrit": "अस्मिन्नपरिहार्येर्ऽथे व्यतीते च विशेषतः ।\nमा शुचो न हि शोच्यास्ते सङ्ग्रामे निधनं गताः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2178376, "chapter_id": 4771, "verse_number": "४९", "content_sanskrit": "यथैव त्वं तथैवाहं को मामाश्वासयिष्यति ।\nममैव चापराधेन कुलमेतद् विनाशितम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2178377, "chapter_id": 4771, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां स्त्रीपर्वणि\nपञ्चदशोऽध्यायः ॥१५॥ जलप्रदानपर्वणि पञ्चदशोऽध्यायः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2178378, "chapter_id": 4771, "verse_number": "", "content_sanskrit": "॥ समाप्तं जलप्रदानपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2178379, "chapter_id": 4771, "verse_number": "", "content_sanskrit": "––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]