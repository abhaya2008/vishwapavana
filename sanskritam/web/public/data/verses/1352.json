[{"id": 2016882, "chapter_id": 1352, "verse_number": "२-९३-१", "content_sanskrit": "वैशम्पायन उवाच॥\nद्रौपद्या वचनं श्रुत्वा चुकोपाथ धनञ्जयः।\nस तदा क्रोधताम्राक्ष इदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2016883, "chapter_id": 1352, "verse_number": "२-९३-२", "content_sanskrit": "अयं तु मां वारयते धर्मराजो युधिष्ठिरः।\nइत्युक्त्वा क्रोधताम्राक्षो धनुरादाय वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2016884, "chapter_id": 1352, "verse_number": "२-९३-३", "content_sanskrit": "सव्यसाची समुत्पत्य ताञ्छत्रून्समुदैक्षत।\nउद्यतं फल्गुनं तत्र ददृशुः सर्वपार्थिवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2016885, "chapter_id": 1352, "verse_number": "२-९३-४", "content_sanskrit": "युगान्ते सर्वलोकांस्तु दहन्तमिव पावकम्।\nवीक्षमाणं धनुष्पामिं हन्तुकामं मुहुर्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2016886, "chapter_id": 1352, "verse_number": "२-९३-५", "content_sanskrit": "हन्तुकामं पशून्क्रुद्धं रुद्रं दक्षक्रतौ यथा।\nतथाभूतं नरं दृष्ट्वा विषेदुस्तत्र मानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2016887, "chapter_id": 1352, "verse_number": "२-९३-६", "content_sanskrit": "धनञ्जयस्यव वीर्यज्ञा निराशा जीविते तदा।\nमृतभूता भवन्सर्वे नेत्रैरनिमिषैरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2016888, "chapter_id": 1352, "verse_number": "२-९३-७", "content_sanskrit": "अर्जुनं धर्मपुत्रं च समुदैक्षन्त पार्थिवाः।\nक्रुद्धं तदाऽर्जुनं दृष्ट्वा पृथिवी च चचाल ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2016889, "chapter_id": 1352, "verse_number": "२-९३-८", "content_sanskrit": "खेचराणि च भूतानि वित्रेसुर्वै भयार्दिताः।\nनादित्यो विरराजाथ नापि वान्ति च मारुताः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2016890, "chapter_id": 1352, "verse_number": "२-९३-९", "content_sanskrit": "न चन्द्रो न च नक्षत्रं द्यौर्दिशोन न विभान्ति ह।\nसर्वमाविद्धमभवज्जगत्स्थावरजङ्गमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2016891, "chapter_id": 1352, "verse_number": "२-९३-१०", "content_sanskrit": "उत्पतन्स वभौ पार्तो दिवाकर इवाम्बरे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2016892, "chapter_id": 1352, "verse_number": "२-९३-११", "content_sanskrit": "पार्थं दृष्ट्वा क्रुद्धं कालान्तकयमोपमम्।\nभीमसेनो मुदा युक्तो युद्धायैव मनो दधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2016893, "chapter_id": 1352, "verse_number": "२-९३-१२", "content_sanskrit": "पाञ्चाली च ददर्शाथ सुसङ्क्रुद्धं धनञ्जयम्।\nहन्तुकामं रिपून्मर्वान्सुपर्णमिव पन्नगान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2016894, "chapter_id": 1352, "verse_number": "२-९३-१३", "content_sanskrit": "दुष्प्रेक्षः सोऽभवत्क्रुद्धो युगान्ताग्निरिव ज्वलन्।\nतं दृष्ट्वा तेजसा युक्तं विव्यधुः पुरवासिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2016895, "chapter_id": 1352, "verse_number": "२-९३-१४", "content_sanskrit": "उत्पतन्तं तु वेगेन ततो दृष्ट्वा धनञ्जयम्।\nजग्राह स तदा राजा पुरुहूतो यथा हरिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2016896, "chapter_id": 1352, "verse_number": "२-९३-१५", "content_sanskrit": "उवाच स घृणी ज्येष्ठो धर्मराजो युधिष्ठिरः।\nमा पार्थ साहसं कार्षीर्मा विनाशं गमेद्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2016897, "chapter_id": 1352, "verse_number": "२-९३-१६", "content_sanskrit": "अहमेतान्पापकृतो द्यूतज्ञान्दग्धुमुत्सहे।\nकन्त्त्वसत्यगतिं दृष्ट्वा क्रोधो नाशमुपैति मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2016898, "chapter_id": 1352, "verse_number": "२-९३-१७", "content_sanskrit": "त्वमिमं जगतोऽर्थे वै कोपं संयच्छ पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2016899, "chapter_id": 1352, "verse_number": "२-९३-१८x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2016900, "chapter_id": 1352, "verse_number": "२-९३-१८", "content_sanskrit": "एवमुक्तस्तदा राज्ञा पाण्डवोऽथ धनञ्जयः।\nक्रोधं संशमयन्पार्थो धार्तराष्ट्रं प्रति स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2016901, "chapter_id": 1352, "verse_number": "२-९३-१९", "content_sanskrit": "तस्मिन्वीरे प्रशान्ते तु पाण्डवे फल्गुने पुनः।\nसुसम्प्रहृष्टमभवज्जगत्स्थावरजङ्गमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2016902, "chapter_id": 1352, "verse_number": "२-९३-२०", "content_sanskrit": "वारितं च तथा दृष्ट्वा भ्रात्रा पार्थं वृकोदरः।\nबभूव विमना राजन्नभून्निश्शब्दमत्र वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2016903, "chapter_id": 1352, "verse_number": "२-९३-२१", "content_sanskrit": "ततो राज्ञो धृतराष्ट्रस्य गेहे\nगोमायुरुच्चैर्व्याहरदग्निहोत्रे।\nतं रासभाः प्रत्यभाषन्त राज-\nन्समन्ततः पक्षिणश्चैव रौद्राः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2016904, "chapter_id": 1352, "verse_number": "२-९३-२२", "content_sanskrit": "तं वै शब्दं विदुरस्तत्त्ववेदी\nशुश्राव घोरं सुबलात्मजा च।\nभीष्मो द्रोणो गौतमश्चापि विद्वान्\nस्वस्तिस्वस्तीत्यपि चैवाहुरुच्चैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2016905, "chapter_id": 1352, "verse_number": "२-९३-२३", "content_sanskrit": "ततो गान्धारी विदुरश्चापि विद्वां-\nस्तमुत्पातं घोरमालक्ष्य राज्ञे।\nनिवेदयामासतुरार्तवत्तदा\nततो राजा वाक्यमिदं बभाषे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2016906, "chapter_id": 1352, "verse_number": "२-९३-२४x", "content_sanskrit": "धृतराष्ट्र उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2016907, "chapter_id": 1352, "verse_number": "२-९३-२४", "content_sanskrit": "हतोऽसि दुर्योधन मन्दबुद्धे\nयस्त्वं सभायां कुरुपुङ्गवानाम्।\nस्त्रियं समाभाषसि दुर्विनीत\nविशेषतो द्रौपदीं धर्मपत्नीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2016908, "chapter_id": 1352, "verse_number": "२-९३-२५x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2016909, "chapter_id": 1352, "verse_number": "२-९३-२५", "content_sanskrit": "एवमुक्त्वा धृतराष्ट्रो मनीषी\nहितान्वेषी बान्धवानामपायात्।\nकृष्णां पाञ्चालीमब्रवीत्सान्त्वपूर्वं", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2016910, "chapter_id": 1352, "verse_number": "२-९३-२६", "content_sanskrit": "विमृश्यैतत्प्रज्ञया तत्त्वबुद्धिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2016911, "chapter_id": 1352, "verse_number": "२-९३-२६x", "content_sanskrit": "धृतराष्ट उवाच॥\nवरं वृणीष्व पाञ्चालि मत्तो यदभिवाञ्छसि।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2016912, "chapter_id": 1352, "verse_number": "२-९३-२७", "content_sanskrit": "वधूनां हि विशिष्टा मे त्वं धर्मपरमा सती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2016913, "chapter_id": 1352, "verse_number": "२-९३-२७x", "content_sanskrit": "द्रौपद्युवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2016914, "chapter_id": 1352, "verse_number": "२-९३-२७", "content_sanskrit": "ददासि चेद्वरं मह्यंवृणोमि भरतर्षभ।\nसर्वधर्मानुगः श्रीमानदासोऽस्तु युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2016915, "chapter_id": 1352, "verse_number": "२-९३-२८", "content_sanskrit": "मनस्विनमजानन्तो मैवं ब्रूयुः कुमारकाः।\nएतं वै दासपुत्रेति प्रतिविन्ध्यं ममात्मजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2016916, "chapter_id": 1352, "verse_number": "२-९३-२९", "content_sanskrit": "राजपुत्रः पुरा भूत्वा यथा नान्यः पुमान्क्वचित्।\nलालितो दासपुत्रत्वं पश्यन्नश्येद्धि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2016917, "chapter_id": 1352, "verse_number": "२-९३-३०x", "content_sanskrit": "धृतराष्ट्र उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2016918, "chapter_id": 1352, "verse_number": "२-९३-३०", "content_sanskrit": "एवं भवतु कल्याणि यथा त्वमभिभाषसे।\nद्वितीयं ते वरं भद्रे ददानि वरयस्व ह।\nमनो हि मे वितरति नैकं त्वं वरमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2016919, "chapter_id": 1352, "verse_number": "२-९३-३१x", "content_sanskrit": "द्रौपद्युवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2016920, "chapter_id": 1352, "verse_number": "२-९३-३१", "content_sanskrit": "सरथौ सघनुष्कौ न भीमसेनधनञ्जयौ।\nयमौ च वरये राजन्नदासान्स्ववशानहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2016921, "chapter_id": 1352, "verse_number": "२-९३-३२x", "content_sanskrit": "धृतराष्ट्र उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2016922, "chapter_id": 1352, "verse_number": "२-९३-३२", "content_sanskrit": "तथाऽस्तु ते महाभागे यथा त्वं नन्दिनीच्छसि।\nतृतीयं वरयास्मत्तो नासि द्वाभ्यां सुसंस्कृता।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2016923, "chapter_id": 1352, "verse_number": "२-९३-३३", "content_sanskrit": "त्वं हि सर्वस्नुषाणां मे श्रेयसी धर्मचारिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2016924, "chapter_id": 1352, "verse_number": "२-९३-३३x", "content_sanskrit": "द्रौपद्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2016925, "chapter_id": 1352, "verse_number": "२-९३-३३", "content_sanskrit": "लोभो धर्मस्य नाशाय भगवन्नाहमुत्सहे।\nअनर्हा वरमादातुं तृतीयं राजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2016926, "chapter_id": 1352, "verse_number": "२-९३-३४", "content_sanskrit": "एकामाहुर्वैश्यवरं द्वौ तु क्षत्रस्त्रियो वरौ।\nत्रयस्तु राज्ञो राजेन्द्र ब्राह्मणस्य शतं वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2016927, "chapter_id": 1352, "verse_number": "२-९३-३५", "content_sanskrit": "पापीयांस इमे भूत्वा सन्तीर्णाः पतयो मम।\nवेत्स्यन्ति चैव भद्राणि राजन्पुण्येन कर्मणा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2016928, "chapter_id": 1352, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि द्यूतपर्वणि त्रिनवतितमोऽध्यायः॥९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]