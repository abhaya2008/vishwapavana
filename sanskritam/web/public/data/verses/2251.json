[{"id": 2057842, "chapter_id": 2251, "verse_number": "७-१७८-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2057843, "chapter_id": 2251, "verse_number": "७-१७८-१", "content_sanskrit": "तमागतमभिप्रेक्ष्य भीमकर्माणमाहवे।\nहर्षमाहारयाञ्चक्रुः कुरवः सर्व एव ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2057844, "chapter_id": 2251, "verse_number": "७-१७८-२", "content_sanskrit": "तथैव तव पुत्रास्ते दुर्योधनपुरोगमाः।\nअप्लुवाः प्लवमासाद्य तर्तुकामा इवार्णवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2057845, "chapter_id": 2251, "verse_number": "७-१७८-३", "content_sanskrit": "पुनर्जातमिवात्मानं मन्वानाः पुरुषर्षभाः।\nअलायुधं राक्षसेन्द्रं स्वागतेनाभ्यपूजयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2057846, "chapter_id": 2251, "verse_number": "७-१७८-४", "content_sanskrit": "तस्मिंस्त्वमानुषे युद्धे वर्तमाने महाभये।\nकर्णराक्षसयोर्नक्तं दारुणप्रतिदर्शने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2057847, "chapter_id": 2251, "verse_number": "७-१७८-५", "content_sanskrit": "`न द्रौणिर्न कृपद्रोणौ न शल्यो न च माधवः।\nएक एव तु तेनासीद्योद्धा कर्णो रणे वृषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2057848, "chapter_id": 2251, "verse_number": "७-१७८-६", "content_sanskrit": "उपप्रैक्षन्त पाञ्चालाः स्मयमानाः सराजकाः।\nव्यभ्रमंस्तावकाश्चापि घूर्णमानास्ततस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2057849, "chapter_id": 2251, "verse_number": "७-१७८-७", "content_sanskrit": "चुक्रुशुर्नेदमस्तीति द्रोणद्रौणिकृपादयः।\nतत्कर्म दृष्ट्वा सम्भ्रान्ता हैडिम्बस्य रणाजिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2057850, "chapter_id": 2251, "verse_number": "७-१७८-८", "content_sanskrit": "सर्वमाविग्नमभवद्धाहाभूतमचेतनम्।\nतव सैन्यं महाराज निराशं कर्णजीविते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2057851, "chapter_id": 2251, "verse_number": "७-१७८-९", "content_sanskrit": "दुर्योधनस्तु सम्प्रेक्ष्य कर्णमार्तिं परां गतम्।\nअलायुधं राक्षसेन्द्रं समाहूयेदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2057852, "chapter_id": 2251, "verse_number": "७-१७८-१०", "content_sanskrit": "एष वैकर्तनः कर्णो हैडिम्बेन समागतः।\nकुरुते कर्म सुमहद्यदस्योपयिकं मृधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2057853, "chapter_id": 2251, "verse_number": "७-१७८-११", "content_sanskrit": "पश्यैतान्पार्थिवाञ्शूरान्निहतान्भैमसेनिना।\nनानाशस्त्रैरभिहतान्पादपानिव दन्तिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2057854, "chapter_id": 2251, "verse_number": "७-१७८-१२", "content_sanskrit": "तवैष भारः समरे ज्ञातिमध्ये मया कृतः।\nतवैवानुमते वीर तं विक्रम्य निबर्हय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2057855, "chapter_id": 2251, "verse_number": "७-१७८-१३", "content_sanskrit": "पुरा वैकर्तनं कर्णमेष पापो घटोत्कचः।\nमायाबलं समाश्रित्य कर्षयत्यरिकर्शन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2057856, "chapter_id": 2251, "verse_number": "७-१७८-१४", "content_sanskrit": "एवमुक्तः स राज्ञा तु राक्षसो भीमविक्रमः।\nतथेत्युक्त्वा महाबाहुर्घटोत्कचमुपाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2057857, "chapter_id": 2251, "verse_number": "७-१७८-१५", "content_sanskrit": "ततः कर्णं समुत्सृज्य भैमसेनिरपि प्रभो।\nप्रत्यमित्रमुपायान्तमर्दयामास मार्गणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2057858, "chapter_id": 2251, "verse_number": "७-१७८-१६", "content_sanskrit": "तयोः समभवद्युद्धं क्रुद्धयो राक्षसेन्द्रयोः।\nमत्तयोर्वासिताहेतोर्दीपयोरिव कानने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2057859, "chapter_id": 2251, "verse_number": "७-१७८-१७", "content_sanskrit": "रक्षसा विप्रमुक्तस्तु कर्णोऽपि रथिनां वरः।\nअभ्यद्रवद्भीमसेनं रथेनादित्यवर्चसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2057860, "chapter_id": 2251, "verse_number": "७-१७८-१८", "content_sanskrit": "तमायान्तमनादृत्य दृष्ट्वा ग्रस्तं घटोत्कचम्।\nअलायुधेन समरे सिंहेनेव गवां पतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2057861, "chapter_id": 2251, "verse_number": "७-१७८-१९", "content_sanskrit": "रथेनादित्यवपुषा भीमः प्रहरतां वरः।\nकिरञ्छरौघान्प्रययावलायुधरथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2057862, "chapter_id": 2251, "verse_number": "७-१७८-२०", "content_sanskrit": "तमायान्तमभिप्रेक्ष्य स तदाऽलायुधः प्रभो।\nघटोत्कचं समुत्सृज्य भीमसेनं समाह्वयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2057863, "chapter_id": 2251, "verse_number": "७-१७८-२१", "content_sanskrit": "तं भीमः सहसाऽभ्येत्य राक्षसान्तकरः प्रभो।\nसगणं राक्षसेन्द्रं तं शरवर्षैरवाकिरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2057864, "chapter_id": 2251, "verse_number": "७-१७८-२२", "content_sanskrit": "तथैवालायुधो राजञ्शिलाधौतैरजिह्मगैः।\nअभ्यवर्षत कौन्तेयं पुनःपुनररिन्दम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2057865, "chapter_id": 2251, "verse_number": "७-१७८-२३", "content_sanskrit": "तथा ते राक्षसाः सर्वे भीमसेनमुपाद्रवन्।\nनानाप्रहरणा भीमास्त्वत्सुतानां जयैषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2057866, "chapter_id": 2251, "verse_number": "७-१७८-२४", "content_sanskrit": "स ताड्यमानो बहुभिर्भीमसेनो महाबलः।\nपञ्चभिः पञ्चभिः सर्वांस्तानविध्यच्छितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2057867, "chapter_id": 2251, "verse_number": "७-१७८-२५", "content_sanskrit": "ते वध्यमाना भीमेन राक्षसाः क्रूरबुद्धयः।\nविनेदुस्तुमुलान्नादान्दुद्रुवुस्ते दिशो दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2057868, "chapter_id": 2251, "verse_number": "७-१७८-२६", "content_sanskrit": "तांस्त्रास्यमानान्भीमेन दृष्ट्वा रक्षो मबहालम्।\nअभिदुद्राव वेगेन शरैश्चैनमवाकिरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2057869, "chapter_id": 2251, "verse_number": "७-१७८-२७", "content_sanskrit": "तं भीमसेनः समरे तीक्ष्णाग्रैरक्षिणोच्छरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2057870, "chapter_id": 2251, "verse_number": "७-१७८-२८", "content_sanskrit": "अलायुधस्तु तानस्तान्भीमेन विशिखान्रणे।\nचिच्छेद कांश्चित्समरे त्वरया कांश्चिदग्रहीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2057871, "chapter_id": 2251, "verse_number": "७-१७८-२९", "content_sanskrit": "स तं दृष्ट्वा राक्षसेन्द्रं भीमो भीमपराक्रमः।\nगदां चिक्षेप वेगेन वज्रपातोपमां तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2057872, "chapter_id": 2251, "verse_number": "७-१७८-३०", "content_sanskrit": "तामापतन्तीं वेगेन गदां ज्वालाकुलां ततः।\nगदया ताडयामास सा गदा भीममाव्रजत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2057873, "chapter_id": 2251, "verse_number": "७-१७८-३१", "content_sanskrit": "स राक्षसेन्द्रं कौन्तेयः शरवर्षैरवाकिरत्।\nतानप्यस्याकरोन्मोघान्राक्षसो निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2057874, "chapter_id": 2251, "verse_number": "७-१७८-३२", "content_sanskrit": "ते चापि राक्षसाः सर्वे रजन्यां भीमरूपिणः।\nशासनाद्राक्षसेन्द्रस्य निजघ्नू रथकुञ्जरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2057875, "chapter_id": 2251, "verse_number": "७-१७८-३३", "content_sanskrit": "पाञ्चालाः सृञ्जयाश्चैव वाजिनः परमद्विपाः।\nन शान्तिं लेभिरे तत्र राक्षसैर्भृशपीडिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2057876, "chapter_id": 2251, "verse_number": "७-१७८-३४", "content_sanskrit": "तं तु दृष्ट्वा महाघोरं वर्तमानं महाहवम्।\nअब्रवीत्पुण्डरीकाक्षो धनञ्जयमिदं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2057877, "chapter_id": 2251, "verse_number": "७-१७८-३५", "content_sanskrit": "पश्य भीमं महाबाहुं राक्षसेन्द्रवशं गतम्।\nपदमस्यानुगच्छ त्वं मा विचारय पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2057878, "chapter_id": 2251, "verse_number": "७-१७८-३६", "content_sanskrit": "धृष्टद्युम्नः शिखण्डी च युधामन्यूत्तमौजसौ।\nसहितौ द्रौपदेयाश्च कर्णं यान्तु महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2057879, "chapter_id": 2251, "verse_number": "७-१७८-३७", "content_sanskrit": "नकुलः सहदेवश्च युयुधानश्च वीर्यवान्।\nइतरान्राक्षसान्घ्नन्तु शासनात्तव पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2057880, "chapter_id": 2251, "verse_number": "७-१७८-३८", "content_sanskrit": "त्वमपीमां महाबाहो चमूं द्रोणपुरस्कृताम्।\nमारयस्व नरव्याघ्र महद्धि भयमागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2057881, "chapter_id": 2251, "verse_number": "७-१७८-३९", "content_sanskrit": "एवमुक्ते तु कृष्णेन यथोद्दिष्टा महारथाः।\nजग्मुर्वैकर्तनं कर्णं राक्षसांश्चैव तान्रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2057882, "chapter_id": 2251, "verse_number": "७-१७८-४०", "content_sanskrit": "अथ पूर्णायतोत्सृष्टैः शरैराशीविषोपमैः।\nधनुश्चिच्छेद भीमस्य राक्षसेन्द्रः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2057883, "chapter_id": 2251, "verse_number": "७-१७८-४१", "content_sanskrit": "हयांश्चास्य शितैर्बाणैः सारथिं च महाबलः।\nजघान मिषतः सङ्ख्ये भीमसेनस्य राक्षसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2057884, "chapter_id": 2251, "verse_number": "७-१७८-४२", "content_sanskrit": "सोऽवतीर्य रथोपस्थाद्धताश्वो हतसारथिः।\nतस्मै गुर्वीं गदां घोरां विनदन्नुत्ससर्ज ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2057885, "chapter_id": 2251, "verse_number": "७-१७८-४३", "content_sanskrit": "ततस्तां भीमनिर्घोषामापतन्तीं महागदाम्।\nगदया राक्षसो घोरो निजघान ननाद च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2057886, "chapter_id": 2251, "verse_number": "७-१७८-४४", "content_sanskrit": "तद्दृष्ट्वा राक्षसेन्द्रस्य घोरं कर्म भयावहम्।\nभीमसेनः प्रहृष्टात्मा गदामाशु परामृशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2057887, "chapter_id": 2251, "verse_number": "७-१७८-४५", "content_sanskrit": "तयोः समभवद्युद्धं तुमुलं नररक्षसोः।\nगदानिपातसंहादैर्भुवं कम्पयतोर्भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2057888, "chapter_id": 2251, "verse_number": "७-१७८-४६", "content_sanskrit": "गदाविमुक्तौ तौ भूयः समासाद्येतरेतरम्।\nमुष्टिभिर्वज्रसंहादैरन्योन्यमभिजघ्नतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2057889, "chapter_id": 2251, "verse_number": "७-१७८-४७", "content_sanskrit": "रथचक्रैर्युगैरक्षैरधिष्ठानैरुपस्करैः।\nयथासन्नमुपादाय निजघ्नतुरमर्षणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2057890, "chapter_id": 2251, "verse_number": "७-१७८-४८", "content_sanskrit": "तौ विक्षरन्तौ रुधिरं समासाद्येतरेतरम्।\nमत्ताविव महानागौ चकृपाते पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2057891, "chapter_id": 2251, "verse_number": "७-१७८-४९", "content_sanskrit": "तावपश्यद्वृषीकेशः पाण्डवानां हिते रतः।\nस भीमसेनरक्षार्थं हैडिम्बिं पर्यचोदयत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2057892, "chapter_id": 2251, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि घटोत्कचवधपर्वणि चतुर्दशरात्रियुद्धे अष्टसप्तत्यधिकशततमोऽध्यायः॥ १७८ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१७८-५ माधवः कृतवर्मा॥ ५-१७८-७ इदमस्मत्सैन्यम्॥ ५-१७८-१७८ अष्टसप्तत्यधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]