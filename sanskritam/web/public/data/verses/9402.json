[{"id": 5000402000, "chapter_id": 9402, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे त्रिषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000402001, "chapter_id": 9402, "verse_number": "५-६३-१", "content_sanskrit": "ततो मूर्ध्ना निपतितं वानरं वानरर्षभः।\nदृष्ट्वैवोद्विग्नहृदयो वाक्यमेतदुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000402002, "chapter_id": 9402, "verse_number": "५-६३-२", "content_sanskrit": "उत्तिष्ठोत्तिष्ठ कस्मात् त्वं पादयोः पतितो मम।\nअभयं ते प्रदास्यामि सत्यमेवाभिधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000402003, "chapter_id": 9402, "verse_number": "५-६३-३", "content_sanskrit": "किं सम्भ्रमाद्धितं कृत्स्नं ब्रूहि यद् वक्तुमर्हसि।\nकच्चिन्मधुवने स्वस्ति श्रोतुमिच्छामि वानर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000402004, "chapter_id": 9402, "verse_number": "५-६३-४", "content_sanskrit": "स समाश्वासितस्तेन सुग्रीवेण महात्मना।\nउत्थाय स महाप्राज्ञो वाक्यं दधिमुखोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000402005, "chapter_id": 9402, "verse_number": "५-६३-५", "content_sanskrit": "नैवर्क्षरजसा राजन् न त्वया न च वालिना।\nवनं निसृष्टपूर्वं ते नाशितं तत्तु वानरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000402006, "chapter_id": 9402, "verse_number": "५-६३-६", "content_sanskrit": "न्यवारयमहं सर्वान् सहैभिर्वनचारिभिः।\nअचिन्तयित्वा मां हृष्टा भक्षयन्ति पिबन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000402007, "chapter_id": 9402, "verse_number": "५-६३-७", "content_sanskrit": "एभिः प्रधर्षणायां च वारितं वनपालकैः।\nमामप्यचिन्तयन् देव भक्षयन्ति वनौकसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000402008, "chapter_id": 9402, "verse_number": "५-६३-८", "content_sanskrit": "शिष्टमत्रापविध्यन्ति भक्षयन्ति तथापरे।\nनिवार्यमाणास्ते सर्वे भ्रुकुटिं दर्शयन्ति हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000402009, "chapter_id": 9402, "verse_number": "५-६३-९", "content_sanskrit": "इमे हि संरब्धतरास्तदा तैः सम्प्रधर्षिताः।\nनिवार्यन्ते वनात् तस्मात् क्रुद्धैर्वानरपुङ्गवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000402010, "chapter_id": 9402, "verse_number": "५-६३-१०", "content_sanskrit": "ततस्तैर्बहुभिर्वीरैर्वानरैर्वानरर्षभाः।\nसंरक्तनयनैः क्रोधाद्धरयः सम्प्रधर्षिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000402011, "chapter_id": 9402, "verse_number": "५-६३-११", "content_sanskrit": "पाणिभिर्निहताः केचित् केचिज्जानुभिराहताः।\nप्रकृष्टाश्च तदा कामं देवमार्गं च दर्शिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000402012, "chapter_id": 9402, "verse_number": "५-६३-१२", "content_sanskrit": "एवमेते हताः शूरास्त्वयि तिष्ठति भर्तरि।\nकृत्स्नं मधुवनं चैव प्रकामं तैश्च भक्ष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000402013, "chapter_id": 9402, "verse_number": "५-६३-१३", "content_sanskrit": "एवं विज्ञाप्यमानं तं सुग्रीवं वानरर्षभम्।\nअपृच्छत् तं महाप्राज्ञो लक्ष्मणः परवीरहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000402014, "chapter_id": 9402, "verse_number": "५-६३-१४", "content_sanskrit": "किमयं वानरो राजन् वनपः प्रत्युपस्थितः।\nकिं चार्थमभिनिर्दिश्य दुःखितो वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000402015, "chapter_id": 9402, "verse_number": "५-६३-१५", "content_sanskrit": "एवमुक्तस्तु सुग्रीवो लक्ष्मणेन महात्मना।\nलक्ष्मणं प्रत्युवाचेदं वाक्यं वाक्यविशारदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000402016, "chapter_id": 9402, "verse_number": "५-६३-१६", "content_sanskrit": "आर्य लक्ष्मण सम्प्राह वीरो दधिमुखः कपिः।\nअङ्गदप्रमुखैर्वीरैर्भक्षितं मधु वानरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000402017, "chapter_id": 9402, "verse_number": "५-६३-१७", "content_sanskrit": "नैषामकृतकार्याणामीदृशः स्याद् व्यतिक्रमः।\nवनं यदभिपन्नास्ते साधितं कर्म तद् ध्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000402018, "chapter_id": 9402, "verse_number": "५-६३-१८", "content_sanskrit": "वारयन्तो भृशं प्राप्ताः पाला जानुभिराहताः।\nतथा न गणितश्चायं कपिर्दधिमुखो बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000402019, "chapter_id": 9402, "verse_number": "५-६३-१९", "content_sanskrit": "पतिर्मम वनस्यायमस्माभिः स्थापितः स्वयम्।\nदृष्टा देवी न संदेहो न चान्येन हनूमता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000402020, "chapter_id": 9402, "verse_number": "५-६३-२०", "content_sanskrit": "न ह्यन्यः साधने हेतुः कर्मणोऽस्य हनूमतः।\nकार्यसिद्धिर्हनुमति मतिश्च हरिपुङ्गवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000402021, "chapter_id": 9402, "verse_number": "५-६३-२१", "content_sanskrit": "व्यवसायश्च वीर्यं च श्रुतं चापि प्रतिष्ठितम्।\nजाम्बवान् यत्र नेता स्यादङ्गदश्च महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000402022, "chapter_id": 9402, "verse_number": "५-६३-२२", "content_sanskrit": "हनूमांश्चाप्यधिष्ठाता न तत्र गतिरन्यथा।\nअङ्गदप्रमुखैर्वीरैर्हतं मधुवनं किल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000402023, "chapter_id": 9402, "verse_number": "५-६३-२३", "content_sanskrit": "विचित्य दक्षिणामाशामागतैर्हरिपुङ्गवैः।\nआगतैश्चाप्रधृष्यं तद्धतं मधुवनं हि तैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000402024, "chapter_id": 9402, "verse_number": "५-६३-२४", "content_sanskrit": "धर्षितं च वनं कृत्स्नमुपयुक्तं तु वानरैः।\nपातिता वनपालास्ते तदा जानुभिराहताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000402025, "chapter_id": 9402, "verse_number": "५-६३-२५", "content_sanskrit": "एतदर्थमयं प्राप्तो वक्तुं मधुरवागिह।\nनाम्ना दधिमुखो नाम हरिः प्रख्यातविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000402026, "chapter_id": 9402, "verse_number": "५-६३-२६", "content_sanskrit": "दृष्टा सीता महाबाहो सौमित्रे पश्य तत्त्वतः।\nअभिगम्य यथा सर्वे पिबन्ति मधु वानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000402027, "chapter_id": 9402, "verse_number": "५-६३-२७", "content_sanskrit": "न चाप्यदृष्ट्वा वैदेहीं विश्रुताः पुरुषर्षभ।\nवनं दत्तवरं दिव्यं धर्षयेयुर्वनौकसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000402028, "chapter_id": 9402, "verse_number": "५-६३-२८", "content_sanskrit": "ततः प्रहृष्टो धर्मात्मा लक्ष्मणः सहराघवः।\nश्रुत्वा कर्णसुखां वाणीं सुग्रीववदनाच्च्युताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000402029, "chapter_id": 9402, "verse_number": "५-६३-२९", "content_sanskrit": "प्राहृष्यत भृशं रामो लक्ष्मणश्च महायशाः।\nश्रुत्वा दधिमुखस्यैवं सुग्रीवस्तु प्रहृष्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000402030, "chapter_id": 9402, "verse_number": "५-६३-३०", "content_sanskrit": "वनपालं पुनर्वाक्यं सुग्रीवः प्रत्यभाषत।\nप्रीतोऽस्मि सोऽहं यद्भुक्तं वनं तैः कृतकर्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000402031, "chapter_id": 9402, "verse_number": "५-६३-३१", "content_sanskrit": "धर्षितं मर्षणीयं च चेष्टितं कृतकर्मणाम्।\nगच्छ शीघ्रं मधुवनं संरक्षस्व त्वमेव हि।\nशीघ्रं प्रेषय सर्वांस्तान् हनूमत्प्रमुखान् कपीन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000402032, "chapter_id": 9402, "verse_number": "५-६३-३२", "content_sanskrit": "इच्छामि शीघ्रं हनुमत्प्रधानान्-\nशाखामृगांस्तान् मृगराजदर्पान्।\nप्रष्टुं कृतार्थान् सह राघवाभ्यां\nश्रोतुं च सीताधिगमे प्रयत्नम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000402033, "chapter_id": 9402, "verse_number": "५-६३-३३", "content_sanskrit": "प्रीतिस्फीताक्षौ सम्प्रहृष्टौ कुमारौ\nदृष्ट्वा सिद्धार्थौ वानराणां च राजा।\nअङ्गैः प्रहृष्टैः कार्यसिद्धिं विदित्वा\nबाह्वोरासन्नामतिमात्रं ननन्द ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000402034, "chapter_id": 9402, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे षट्पञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]