[{"id": 5000476000, "chapter_id": 9476, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे एकोनसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000476001, "chapter_id": 9476, "verse_number": "६-६९-१", "content_sanskrit": "एवं विलपमानस्य रावणस्य दुरात्मनः।\nश्रुत्वा शोकाभिभूतस्य त्रिशिरा वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000476002, "chapter_id": 9476, "verse_number": "६-६९-२", "content_sanskrit": "एवमेव महावीर्यो हतो नस्तातमध्यमः।\nन तु सत्पुरुषा राजन् विलपन्ति यथा भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000476003, "chapter_id": 9476, "verse_number": "६-६९-३", "content_sanskrit": "नूनं त्रिभुवनस्यापि पर्याप्तस्त्वमसि प्रभो।\nस कस्मात् प्राकृत इव शोचस्यात्मानमीदृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000476004, "chapter_id": 9476, "verse_number": "६-६९-४", "content_sanskrit": "ब्रह्मदत्तास्ति ते शक्तिः कवचं सायको धनुः।\nसहस्रखरसंयुक्तो रथो मेघसमस्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000476005, "chapter_id": 9476, "verse_number": "६-६९-५", "content_sanskrit": "त्वयासकृद्धि शस्त्रेण विशस्ता देवदानवाः।\nस सर्वायुधसम्पन्नो राघवं शास्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000476006, "chapter_id": 9476, "verse_number": "६-६९-६", "content_sanskrit": "कामं तिष्ठ महाराज निर्गमिष्याम्यहं रणे।\nउद्धरिष्यामि ते शत्रून् गरुडः पन्नगानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000476007, "chapter_id": 9476, "verse_number": "६-६९-७", "content_sanskrit": "शम्बरो देवराजेन नरको विष्णुना यथा।\nतथाद्य शयिता रामो मया युधि निपातितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000476008, "chapter_id": 9476, "verse_number": "६-६९-८", "content_sanskrit": "श्रुत्वा त्रिशिरसो वाक्यं रावणो राक्षसाधिपः।\nपुनर्जातमिवात्मानं मन्यते कालचोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000476009, "chapter_id": 9476, "verse_number": "६-६९-९", "content_sanskrit": "श्रुत्वा त्रिशिरसो वाक्यं देवान्तकनरान्तकौ।\nअतिकायश्च तेजस्वी बभूवुर्युद्धहर्षिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000476010, "chapter_id": 9476, "verse_number": "६-६९-१०", "content_sanskrit": "ततोऽहमहमित्येवं गर्जन्तो नैर्ऋतर्षभाः।\nरावणस्य सुता वीराः शक्रतुल्यपराक्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000476011, "chapter_id": 9476, "verse_number": "६-६९-११", "content_sanskrit": "अन्तरिक्षगताः सर्वे सर्वे मायाविशारदाः।\nसर्वे त्रिदशदर्पघ्नाः सर्वे समरदुर्मदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000476012, "chapter_id": 9476, "verse_number": "६-६९-१२", "content_sanskrit": "सर्वे सुबलसम्पन्नाः सर्वे विस्तीर्णकीर्तयः।\nसर्वे समरमासाद्य न श्रूयन्ते स्म निर्जिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000476013, "chapter_id": 9476, "verse_number": "६-६९-१३", "content_sanskrit": "देवैरपि सगन्धर्वैः सकिंनरमहोरगैः।\nसर्वेऽस्त्रविदुषो वीराः सर्वे युद्धविशारदाः।\nसर्वे प्रवरविज्ञानाः सर्वे लब्धवरास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000476014, "chapter_id": 9476, "verse_number": "६-६९-१४", "content_sanskrit": "स तैस्तथा भास्करतुल्यवर्चसैः\nसुतैर्वृतः शत्रुबलश्रियार्दनैः।\nरराज राजा मघवान् यथामरै-\nर्वृतो महादानवदर्पनाशनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000476015, "chapter_id": 9476, "verse_number": "६-६९-१५", "content_sanskrit": "स पुत्रान् सम्परिष्वज्य भूषयित्वा च भूषणैः।\nआशीर्भिश्च प्रशस्ताभिः प्रेषयामास वै रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000476016, "chapter_id": 9476, "verse_number": "६-६९-१६", "content_sanskrit": "युद्धोन्मत्तं च मत्तं च भ्रातरौ चापि रावणः।\nरक्षणार्थं कुमाराणां प्रेषयामास संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000476017, "chapter_id": 9476, "verse_number": "६-६९-१७", "content_sanskrit": "तेऽभिवाद्य महात्मानं रावणं लोकरावणम्।\nकृत्वा प्रदक्षिणं चैव महाकायाः प्रतस्थिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000476018, "chapter_id": 9476, "verse_number": "६-६९-१८", "content_sanskrit": "सर्वौषधीभिर्गन्धैश्च समालभ्य महाबलाः।\nनिर्जग्मुर्नैर्ऋतश्रेष्ठाः षडेते युद्धकाङ्क्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000476019, "chapter_id": 9476, "verse_number": "६-६९-१९", "content_sanskrit": "त्रिशिराश्चातिकायश्च देवान्तकनरान्तकौ।\nमहोदरमहापार्श्वौ निर्जग्मुः कालचोदिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000476020, "chapter_id": 9476, "verse_number": "६-६९-२०", "content_sanskrit": "ततः सुदर्शनं नागं नीलजीमूतसंनिभम्।\nऐरावतकुले जातमारुरोह महोदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000476021, "chapter_id": 9476, "verse_number": "६-६९-२१", "content_sanskrit": "सर्वायुधसमायुक्तस्तूणीभिश्चाप्यलंकृतः।\nरराज गजमास्थाय सवितेवास्तमूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000476022, "chapter_id": 9476, "verse_number": "६-६९-२२", "content_sanskrit": "हयोत्तमसमायुक्तं सर्वायुधसमाकुलम्।\nआरुरोह रथश्रेष्ठं त्रिशिरा रावणात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000476023, "chapter_id": 9476, "verse_number": "६-६९-२३", "content_sanskrit": "त्रिशिरा रथमास्थाय विरराज धनुर्धरः।\nसविद्युदुल्कः सज्वालः सेन्द्रचाप इवाम्बुदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000476024, "chapter_id": 9476, "verse_number": "६-६९-२४", "content_sanskrit": "त्रिभिः किरीटैस्त्रिशिराः शुशुभे स रथोत्तमे।\nहिमवानिव शैलेन्द्रस्त्रिभिः काञ्चनपर्वतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000476025, "chapter_id": 9476, "verse_number": "६-६९-२५", "content_sanskrit": "अतिकायोऽतितेजस्वी राक्षसेन्द्रसुतस्तदा।\nआरुरोह रथश्रेष्ठं श्रेष्ठः सर्वधनुष्मताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000476026, "chapter_id": 9476, "verse_number": "६-६९-२६", "content_sanskrit": "सुचक्राक्षं सुसंयुक्तं स्वनुकर्षं सुकूबरम्।\nतूणीबाणासनैर्दीप्तं प्रासासिपरिघाकुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000476027, "chapter_id": 9476, "verse_number": "६-६९-२७", "content_sanskrit": "स काञ्चनविचित्रेण किरीटेन विराजता।\nभूषणैश्च बभौ मेरुः प्रभाभिरिव भासयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000476028, "chapter_id": 9476, "verse_number": "६-६९-२८", "content_sanskrit": "स रराज रथे तस्मिन् राजसूनुर्महाबलः।\nवृतो नैर्ऋतशार्दूलैर्वज्रपाणिरिवामरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000476029, "chapter_id": 9476, "verse_number": "६-६९-२९", "content_sanskrit": "हयमुच्चैःश्रवःप्रख्यं श्वेतं कनकभूषणम्।\nमनोजवं महाकायमारुरोह नरान्तकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000476030, "chapter_id": 9476, "verse_number": "६-६९-३०", "content_sanskrit": "गृहीत्वा प्रासमुल्काभं विरराज नरान्तकः।\nशक्तिमादाय तेजस्वी गुहः शिखिगतो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000476031, "chapter_id": 9476, "verse_number": "६-६९-३१", "content_sanskrit": "देवान्तकः समादाय परिघं हेमभूषणम्।\nपरिगृह्य गिरिं दोर्भ्यां वपुर्विष्णोर्विडम्बयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000476032, "chapter_id": 9476, "verse_number": "६-६९-३२", "content_sanskrit": "महापार्श्वो महातेजा गदामादाय वीर्यवान्।\nविरराज गदापाणिः कुबेर इव संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000476033, "chapter_id": 9476, "verse_number": "६-६९-३३", "content_sanskrit": "ते प्रतस्थुर्महात्मानोऽमरावत्याः सुरा इव।\nतान् गजैश्च तुरङ्गैश्च रथैश्चाम्बुदनिःस्वनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000476034, "chapter_id": 9476, "verse_number": "६-६९-३४", "content_sanskrit": "अनूत्पेतुर्महात्मानो राक्षसाः प्रवरायुधाः।\nते विरेजुर्महात्मानः कुमाराः सूर्यवर्चसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000476035, "chapter_id": 9476, "verse_number": "६-६९-३५", "content_sanskrit": "किरीटिनः श्रिया जुष्टा ग्रहा दीप्ता इवाम्बरे।\nप्रगृहीता बभौ तेषां शस्त्राणामवलिः सिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000476036, "chapter_id": 9476, "verse_number": "६-६९-३६", "content_sanskrit": "शरदभ्रप्रतीकाशा हंसावलिरिवाम्बरे।\nमरणं वापि निश्चित्य शत्रूणां वा पराजयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000476037, "chapter_id": 9476, "verse_number": "६-६९-३७", "content_sanskrit": "इति कृत्वा मतिं वीराः संजग्मुः संयुगार्थिनः।\nजगर्जुश्च प्रणेदुश्च चिक्षिपुश्चापि सायकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000476038, "chapter_id": 9476, "verse_number": "६-६९-३८", "content_sanskrit": "जगृहुश्च महात्मानो निर्यान्तो युद्धदुर्मदाः।\nक्ष्वेडितास्फोटितानां वै संचचालेव मेदिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000476039, "chapter_id": 9476, "verse_number": "६-६९-३९", "content_sanskrit": "रक्षसां सिंहनादैश्च संस्फोटितमिवाम्बरम्।\nतेऽभिनिष्क्रम्य मुदिता राक्षसेन्द्रा महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000476040, "chapter_id": 9476, "verse_number": "६-६९-४०", "content_sanskrit": "ददृशुर्वानरानीकं समुद्यतशिलानगम्।\nहरयोऽपि महात्मानो ददृशू राक्षसं बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000476041, "chapter_id": 9476, "verse_number": "६-६९-४१", "content_sanskrit": "हस्त्यश्वरथसम्बाधं किङ्किणीशतनादितम्।\nनीलजीमूतसंकाशं समुद्यतमहायुधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000476042, "chapter_id": 9476, "verse_number": "६-६९-४२", "content_sanskrit": "दीप्तानलरविप्रख्यैर्नैर्ऋतैः सर्वतो वृतम्।\nतद् दृष्ट्वा बलमायातं लब्धलक्षाः प्लवङ्गमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000476043, "chapter_id": 9476, "verse_number": "६-६९-४३", "content_sanskrit": "समुद्यतमहाशैलाः सम्प्रणेदुर्मुहुर्मुहुः।\nअमृष्यमाणा रक्षांसि प्रतिनर्दन्त वानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000476044, "chapter_id": 9476, "verse_number": "६-६९-४४", "content_sanskrit": "ततः समुत्कृष्टरवं निशम्य\nरक्षोगणा वानरयूथपानाम्।\nअमृष्यमाणाः परहर्षमुग्रं\nमहाबला भीमतरं प्रणेदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000476045, "chapter_id": 9476, "verse_number": "६-६९-४५", "content_sanskrit": "ते राक्षसबलं घोरं प्रविश्य हरियूथपाः।\nविचेरुरुद्यतैः शैलैर्नगाः शिखरिणो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000476046, "chapter_id": 9476, "verse_number": "६-६९-४६", "content_sanskrit": "केचिदाकाशमाविश्य केचिदुर्व्यां प्लवङ्गमाः।\nरक्षःसैन्येषु संक्रुद्धाः केचिद् द्रुमशिलायुधाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000476047, "chapter_id": 9476, "verse_number": "६-६९-४७", "content_sanskrit": "द्रुमांश्च विपुलस्कन्धान् गृह्य वानरपुङ्गवाः।\nतद् युद्धमभवद् घोरं रक्षोवानरसंकुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000476048, "chapter_id": 9476, "verse_number": "६-६९-४८", "content_sanskrit": "ते पादपशिलाशैलैश्चक्रुर्वृष्टिमनूपमाम्।\nबाणौघैर्वार्यमाणाश्च हरयो भीमविक्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000476049, "chapter_id": 9476, "verse_number": "६-६९-४९", "content_sanskrit": "सिंहनादान् विनेदुश्च रणे राक्षसवानराः।\nशिलाभिश्चूर्णयामासुर्यातुधानान् प्लवङ्गमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000476050, "chapter_id": 9476, "verse_number": "६-६९-५०", "content_sanskrit": "निर्जघ्नुः संयुगे क्रुद्धाः कवचाभरणावृतान्।\nकेचिद् रथगतान् वीरान् गजवाजिगतानपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000476051, "chapter_id": 9476, "verse_number": "६-६९-५१", "content_sanskrit": "निर्जघ्नुः सहसाऽऽप्लुत्य यातुधानान् प्लवङ्गमाः।\nशैलशृङ्गान्विताङ्गास्ते मुष्टिभिर्वान्तलोचनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000476052, "chapter_id": 9476, "verse_number": "६-६९-५२", "content_sanskrit": "चेलुः पेतुश्च नेदुश्च तत्र राक्षसपुङ्गवाः।\nराक्षसाश्च शरैस्तीक्ष्णैर्बिभिदुः कपिकुञ्जरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000476053, "chapter_id": 9476, "verse_number": "६-६९-५३", "content_sanskrit": "शूलमुद‍्गरखड्गैश्च जघ्नुः प्रासैश्च शक्तिभिः।\nअन्योन्यं पातयामासुः परस्परजयैषिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000476054, "chapter_id": 9476, "verse_number": "६-६९-५४", "content_sanskrit": "रिपुशोणितदिग्धाङ्गास्तत्र वानरराक्षसाः।\nततः शैलैश्च खड्गैश्च विसृष्टैर्हरिराक्षसैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000476055, "chapter_id": 9476, "verse_number": "६-६९-५५", "content_sanskrit": "मुहूर्तेनावृता भूमिरभवच्छोणितोक्षिता।\nविकीर्णैः पर्वताकारै रक्षोभिरभिमर्दितैः।\nआसीद् वसुमती पूर्णा तदा युद्धमदान्वितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000476056, "chapter_id": 9476, "verse_number": "६-६९-५६", "content_sanskrit": "आक्षिप्ताः क्षिप्यमाणाश्च भग्नशैलाश्च वानराः।\nपुनरङ्गैस्तदा चक्रुरासन्ना युद्धमद्भुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000476057, "chapter_id": 9476, "verse_number": "६-६९-५७", "content_sanskrit": "वानरान् वानरैरेव जघ्नुस्ते नैर्ऋतर्षभाः।\nराक्षसान् राक्षसैरेव जघ्नुस्ते वानरा अपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000476058, "chapter_id": 9476, "verse_number": "६-६९-५८", "content_sanskrit": "आक्षिप्य च शिलाः शैलाञ्जघ्नुस्ते राक्षसास्तदा।\nतेषां चाच्छिद्य शस्त्राणि जघ्नू रक्षांसि वानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000476059, "chapter_id": 9476, "verse_number": "६-६९-५९", "content_sanskrit": "निर्जघ्नुः शैलशृङ्गैश्च बिभिदुश्च परस्परम्।\nसिंहनादान् विनेदुश्च रणे राक्षसवानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000476060, "chapter_id": 9476, "verse_number": "६-६९-६०", "content_sanskrit": "छिन्नवर्मतनुत्राणा राक्षसा वानरैर्हताः।\nरुधिरं प्रसृतास्तत्र रससारमिव द्रुमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000476061, "chapter_id": 9476, "verse_number": "६-६९-६१", "content_sanskrit": "रथेन च रथं चापि वारणेनापि वारणम्।\nहयेन च हयं केचिन्निर्जघ्नुर्वानरा रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000476062, "chapter_id": 9476, "verse_number": "६-६९-६२", "content_sanskrit": "क्षुरप्रैरर्धचन्द्रैश्च भल्लैश्च निशितैः शरैः।\nराक्षसा वानरेन्द्राणां बिभिदुः पादपान् शिलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000476063, "chapter_id": 9476, "verse_number": "६-६९-६३", "content_sanskrit": "विकीर्णाः पर्वतास्तैश्च द्रुमच्छिन्नैश्च संयुगे।\nहतैश्च कपिरक्षोभिर्दुर्गमा वसुधाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000476064, "chapter_id": 9476, "verse_number": "६-६९-६४", "content_sanskrit": "ते वानरा गर्वितहृष्टचेष्टाः\nसंग्राममासाद्य भयं विमुच्य।\nयुद्धं स्म सर्वे सह राक्षसैस्ते\nनानायुधाश्चक्रुरदीनसत्त्वाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000476065, "chapter_id": 9476, "verse_number": "६-६९-६५", "content_sanskrit": "तस्मिन् प्रवृत्ते तुमुले विमर्दे\nप्रहृष्यमाणेषु वलीमुखेषु।\nनिपात्यमानेषु च राक्षसेषु\nमहर्षयो देवगणाश्च नेदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 5000476066, "chapter_id": 9476, "verse_number": "६-६९-६६", "content_sanskrit": "ततो हयं मारुततुल्यवेग-\nमारुह्य शक्तिं निशितां प्रगृह्य।\nनरान्तको वानरसैन्यमुग्रं\nमहार्णवं मीन इवाविवेश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 5000476067, "chapter_id": 9476, "verse_number": "६-६९-६७", "content_sanskrit": "स वानरान् सप्त शतानि वीरः\nप्रासेन दीप्तेन विनिर्बिभेद।\nएकः क्षणेनेन्द्ररिपुर्महात्मा\nजघान सैन्यं हरिपुङ्गवानाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 5000476068, "chapter_id": 9476, "verse_number": "६-६९-६८", "content_sanskrit": "ददृशुश्च महात्मानं हयपृष्ठप्रतिष्ठितम्।\nचरन्तं हरिसैन्येषु विद्याधरमहर्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 5000476069, "chapter_id": 9476, "verse_number": "६-६९-६९", "content_sanskrit": "स तस्य ददृशे मार्गो मांसशोणितकर्दमः।\nपतितैः पर्वताकारैर्वानरैरभिसंवृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 5000476070, "chapter_id": 9476, "verse_number": "६-६९-७०", "content_sanskrit": "यावद् विक्रमितुं बुद्धिं चक्रुः प्लवगपुङ्गवाः।\nतावदेतानतिक्रम्य निर्बिभेद नरान्तकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 5000476071, "chapter_id": 9476, "verse_number": "६-६९-७१", "content_sanskrit": "ज्वलन्तं प्रासमुद्यम्य संग्रामाग्रे नरान्तकः।\nददाह हरिसैन्यानि वनानीव विभावसुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 5000476072, "chapter_id": 9476, "verse_number": "६-६९-७२", "content_sanskrit": "यावदुत्पाटयामासुर्वृक्षान् शैलान् वनौकसः।\nतावत् प्रासहताः पेतुर्वज्रकृत्ता इवाचलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 5000476073, "chapter_id": 9476, "verse_number": "६-६९-७३", "content_sanskrit": "दिक्षु सर्वासु बलवान् विचचार नरान्तकः।\nप्रमृद्नन् सर्वतो युद्धे प्रावृट्काले यथानिलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 5000476074, "chapter_id": 9476, "verse_number": "६-६९-७४", "content_sanskrit": "न शेकुर्धावितुं वीरा न स्थातुं स्पन्दितुं भयात्।\nउत्पतन्तं स्थितं यान्तं सर्वान् विव्याध वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 5000476075, "chapter_id": 9476, "verse_number": "६-६९-७५", "content_sanskrit": "एकेनान्तककल्पेन प्रासेनादित्यतेजसा।\nभग्नानि हरिसैन्यानि निपेतुर्धरणीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 5000476076, "chapter_id": 9476, "verse_number": "६-६९-७६", "content_sanskrit": "वज्रनिष्पेषसदृशं प्रासस्याभिनिपातनम्।\nन शेकुर्वानराः सोढुं ते विनेदुर्महास्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 5000476077, "chapter_id": 9476, "verse_number": "६-६९-७७", "content_sanskrit": "पततां हरिवीराणां रूपाणि प्रचकाशिरे।\nवज्रभिन्नाग्रकूटानां शैलानां पततामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 5000476078, "chapter_id": 9476, "verse_number": "६-६९-७८", "content_sanskrit": "ये तु पूर्वं महात्मानः कुम्भकर्णेन पातिताः।\nते स्वस्था वानरश्रेष्ठाः सुग्रीवमुपतस्थिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 5000476079, "chapter_id": 9476, "verse_number": "६-६९-७९", "content_sanskrit": "प्रेक्षमाणः स सुग्रीवो ददृशे हरिवाहिनीम्।\nनरान्तकभयत्रस्तां विद्रवन्तीं यतस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 5000476080, "chapter_id": 9476, "verse_number": "६-६९-८०", "content_sanskrit": "विद्रुतां वाहिनीं दृष्ट्वा स ददर्श नरान्तकम्।\nगृहीतप्रासमायान्तं हयपृष्ठप्रतिष्ठितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 5000476081, "chapter_id": 9476, "verse_number": "६-६९-८१", "content_sanskrit": "दृष्ट्वोवाच महातेजाः सुग्रीवो वानराधिपः।\nकुमारमङ्गदं वीरं शक्रतुल्यपराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 5000476082, "chapter_id": 9476, "verse_number": "६-६९-८२", "content_sanskrit": "गच्छैनं राक्षसं वीरं योऽसौ तुरगमास्थितः।\nक्षोभयन्तं हरिबलं क्षिप्रं प्राणैर्वियोजय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 5000476083, "chapter_id": 9476, "verse_number": "६-६९-८३", "content_sanskrit": "स भर्तुर्वचनं श्रुत्वा निष्पपाताङ्गदस्तदा।\nअनीकान्मेघसंकाशादंशुमानिव वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 5000476084, "chapter_id": 9476, "verse_number": "६-६९-८४", "content_sanskrit": "शैलसंघातसंकाशो हरीणामुत्तमोऽङ्गदः।\nरराजाङ्गदसंनद्धः सधातुरिव पर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 5000476085, "chapter_id": 9476, "verse_number": "६-६९-८५", "content_sanskrit": "निरायुधो महातेजाः केवलं नखदंष्ट्रवान्।\nनरान्तकमभिक्रम्य वालिपुत्रोऽब्रवीद् वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 5000476086, "chapter_id": 9476, "verse_number": "६-६९-८६", "content_sanskrit": "तिष्ठ किं प्राकृतैरेभिर्हरिभिस्त्वं करिष्यसि।\nअस्मिन् वज्रसमस्पर्शं प्रासं क्षिप्र ममोरसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 5000476087, "chapter_id": 9476, "verse_number": "६-६९-८७", "content_sanskrit": "अङ्गदस्य वचः श्रुत्वा प्रचुक्रोध नरान्तकः।\nसंदश्य दशनैरोष्ठं निःश्वस्य च भुजंगवत्।\nअभिगम्याङ्गदं क्रुद्धो वालिपुत्रं नरान्तकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 5000476088, "chapter_id": 9476, "verse_number": "६-६९-८८", "content_sanskrit": "स प्रासमाविध्य तदाङ्गदाय\nसमुज्ज्वलन्तं सहसोत्ससर्ज।\nस वालिपुत्रोरसि वज्रकल्पे\nबभूव भग्नो न्यपतच्च भूमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 5000476089, "chapter_id": 9476, "verse_number": "६-६९-८९", "content_sanskrit": "तं प्रासमालोक्य तदा विभग्नं\nसुपर्णकृत्तोरगभोगकल्पम्।\nतलं समुद्यम्य स वालिपुत्र-\nस्तुरंगमस्याभिजघान मूर्ध्नि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 5000476090, "chapter_id": 9476, "verse_number": "६-६९-९०", "content_sanskrit": "निमग्नपादः स्फुटिताक्षितारो\nनिष्क्रान्तजिह्वोऽचलसंनिकाशः।\nस तस्य वाजी निपपात भूमौ\nतलप्रहारेण विकीर्णमूर्धा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 5000476091, "chapter_id": 9476, "verse_number": "६-६९-९१", "content_sanskrit": "नरान्तकः क्रोधवशं जगाम\nहतं तुरंगं पतितं समीक्ष्य।\nस मुष्टिमुद्यम्य महाप्रभावो\nजघान शीर्षे युधि वालिपुत्रम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 5000476092, "chapter_id": 9476, "verse_number": "६-६९-९२", "content_sanskrit": "अथाङ्गदो मुष्टिविशीर्णमूर्धा\nसुस्राव तीव्रं रुधिरं भृशोष्णम्।\nमुहुर्विजज्वाल मुमोह चापि\nसंज्ञां समासाद्य विसिस्मिये च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 5000476093, "chapter_id": 9476, "verse_number": "६-६९-९३", "content_sanskrit": "अथाङ्गदो मृत्युसमानवेगं\nसंवर्त्य मुष्टिं गिरिशृङ्गकल्पम्।\nनिपातयामास तदा महात्मा\nनरान्तकस्योरसि वालिपुत्रः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 5000476094, "chapter_id": 9476, "verse_number": "६-६९-९४", "content_sanskrit": "स मुष्टिनिर्भिन्ननिमग्नवक्षा\nज्वाला वमन् शोणितदिग्धगात्रः।\nनरान्तको भूमितले पपात\nयथाचलो वज्रनिपातभग्नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 5000476095, "chapter_id": 9476, "verse_number": "६-६९-९५", "content_sanskrit": "तदान्तरिक्षे त्रिदशोत्तमानां\nवनौकसां चैव महाप्रणादः।\nबभूव तस्मिन् निहतेऽग्र्यवीर्ये\nनरान्तके वालिसुतेन संख्ये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 5000476096, "chapter_id": 9476, "verse_number": "६-६९-९६", "content_sanskrit": "अथाङ्गदो राममनःप्रहर्षणं\nसुदुष्करं तं कृतवान् हि विक्रमम्।\nविसिस्मिये सोऽप्यथ भीमकर्मा\nपुनश्च युद्धे स बभूव हर्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 5000476097, "chapter_id": 9476, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे एकोनसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}]