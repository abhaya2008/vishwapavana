[{"id": 7003711000, "chapter_id": 23711, "verse_number": "१-४-१९-१", "content_sanskrit": "नंदिकेश्वर उवाच ।\nतावत्कुतश्चिदाकर्ण्य तत्रस्थां महिषासुरः ।\nअवज्ञातसुरारातिर्विध्वंसितपुरंदरः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003711001, "chapter_id": 23711, "verse_number": "१-४-१९-२", "content_sanskrit": "सर्वलोकजयी सिद्धविद्याधरभयावहः ।\nदुर्निग्रहो वरादासीच्छस्त्रास्त्रैरखिलैरपि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003711002, "chapter_id": 23711, "verse_number": "१-४-१९-३", "content_sanskrit": "तीक्ष्णानामपि शापानामप्यगोचरतां गतः ।\nदर्पद्भिर्दानवैदैत्यैः कौणपैश्च निषेवितः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003711003, "chapter_id": 23711, "verse_number": "१-४-१९-४", "content_sanskrit": "दूषको मुनिपत्नीनां धर्ममार्गोपघातकः ।\nबलात्पुलोम्नो नमुचेर्वृत्रादपि बलाधिकः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003711004, "chapter_id": 23711, "verse_number": "१-४-१९-५", "content_sanskrit": "हिरण्यकशिपोर्वश्यो हिरण्याक्ष इवापरः ।\nतां विलोभयितुं कांचित्प्राहिणोत्किल दूतिकाम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003711005, "chapter_id": 23711, "verse_number": "१-४-१९-६", "content_sanskrit": "ततः सा तापसीवेषधारिणी गिरिजां प्रति ।\nसखीसमक्ष एवेदमुवाचानुचितं वचः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003711006, "chapter_id": 23711, "verse_number": "१-४-१९-७", "content_sanskrit": "अरारु भीषणे भीरो निवसस्यत्र किं वने ।\nविहर्तुमुचिता रम्येष्ववरोधनवेश्मसु ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003711007, "chapter_id": 23711, "verse_number": "१-४-१९-८", "content_sanskrit": "किमर्थं वाद्य चित्तं ते यौवने भोगनिःस्पृहम् ।\nनिवेशितं तपसि च दैवतैरपि दुष्करे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003711008, "chapter_id": 23711, "verse_number": "१-४-१९-९", "content_sanskrit": "हंसतूलमयीं शय्यां मुक्तामयवितानिकाम् ।\nहित्वा किमिति मृद्वंगि सुप्यते परुषाश्मसु ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003711009, "chapter_id": 23711, "verse_number": "१-४-१९-१०", "content_sanskrit": "तपोजडो मृडो दिष्ट्या प्रागेवास्ति त्वयोज्झितः ।\nतवानुरूपो नैवान्यो विद्यते दिविषत्सु च ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003711010, "chapter_id": 23711, "verse_number": "१-४-१९-११", "content_sanskrit": "किं तु त्रैलोक्यनाथोऽस्ति महिषो दानवेश्वरः ।\nयदि द्रक्ष्यसि तं सुभ्र त्यक्ष्यस्येव क्षणात्तपः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003711011, "chapter_id": 23711, "verse_number": "१-४-१९-१२", "content_sanskrit": "किं निह्नवेन नन्वेष श्रुत्वा सर्वं चिरात्प्रभुः ।\nस प्राहिणोदुपानेतुं दूतिकां मां स्मरातुरः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003711012, "chapter_id": 23711, "verse_number": "१-४-१९-१३", "content_sanskrit": "इत्यत्यंतविरुद्धं तां ब्रुवाणामसमंजसम् ।\nदेव्याश्चित्तस्थितिं ज्ञात्वा विजया निरकासयत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003711013, "chapter_id": 23711, "verse_number": "१-४-१९-१४", "content_sanskrit": "सा चातिरोषेण कृतप्रतिज्ञा दैत्यरूपिका ।\nगत्वा विदितवृत्तांतमकरोन्महिषासुरम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003711014, "chapter_id": 23711, "verse_number": "१-४-१९-१५", "content_sanskrit": "सोऽपि तत्सर्वमाकर्ण्य रुषातीवारुणेक्षणः ।\nदेवीं जिघृक्षुरभ्यागाद्वृतो दैतेयकोटिभिः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003711015, "chapter_id": 23711, "verse_number": "१-४-१९-१६", "content_sanskrit": "स्यन्दनैर्द्विरदैरश्वैः पत्तिभिश्च समंततः ।\nभुवमाच्छादयामास ध्वजैश्च गगनांतरम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003711016, "chapter_id": 23711, "verse_number": "१-४-१९-१७", "content_sanskrit": "क्ष्वेलितैर्वाद्यघोषैश्च नभः स्फुटदिवाभवत् ।\nपादाघातैश्च दैत्यानां विदद्रे वसुधातलम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003711017, "chapter_id": 23711, "verse_number": "१-४-१९-१८", "content_sanskrit": "करालो दुर्द्धरस्तस्य विचष्णुर्विकरालकः ।\nबाष्कलो दुर्मुखश्चंडः प्रचंडश्चामरासुरः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003711018, "chapter_id": 23711, "verse_number": "१-४-१९-१९", "content_sanskrit": "महाहनुर्महामौलिरुग्रास्यो विकटेक्षणः ।\nज्वालास्यो दहनश्चेमे सेनान्योपि प्रतस्थिरे ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003711019, "chapter_id": 23711, "verse_number": "१-४-१९-२०", "content_sanskrit": "कोलाहलमिमं श्रुत्वा देवी नियमविघ्नतः ।\nशंकिता दैत्यसंहृत्यै दुर्गामादिशति स्म सा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003711020, "chapter_id": 23711, "verse_number": "१-४-१९-२१", "content_sanskrit": "सारुणाद्रिरहोद्रोण्यामधिरूढा मृगाधिपम् ।\nदीप्तायुधधरैर्दोर्भिः कालिकेव महीं गता ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003711021, "chapter_id": 23711, "verse_number": "१-४-१९-२२", "content_sanskrit": "घनाघनरवोदग्रं सिंहनादमचीकरत् ।\nस्फुरद्दंतच्छदोपांतं वल्गदंगुलिपल्लवा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003711022, "chapter_id": 23711, "verse_number": "१-४-१९-२३", "content_sanskrit": "स्वांगेभ्यो योगिनीचक्रं मातरोऽप्यसृजन्रुषा ।\nदेव्याः प्रियाय दैतेयसंहारार्हाः सहस्रशः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003711023, "chapter_id": 23711, "verse_number": "१-४-१९-२४", "content_sanskrit": "काश्चित्तत्रारुणच्छाया दंडिन्यो हंसवाहनाः ।\nमुखैश्चतुर्भिराजग्मुः कोपप्रस्फुरिताधरैः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003711024, "chapter_id": 23711, "verse_number": "१-४-१९-२५", "content_sanskrit": "निर्ययुः काश्चन क्रुद्धा ज्वलत्त्रिशिखपाणयः ।\nनिस्वनद्भूषणाः पंसल्ललाटा वृषवाहनाः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003711025, "chapter_id": 23711, "verse_number": "१-४-१९-२६", "content_sanskrit": "निर्जग्मुरपराः सेनासहिताः शिखिवाहनैः ।\nशक्तिदंडाभयकराः शतशः षड्भिराननैः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003711026, "chapter_id": 23711, "verse_number": "१-४-१९-२७", "content_sanskrit": "निश्चक्रमुः परास्तार्क्ष्यमधिरुह्याधिकक्रुधा ।\nशंखचक्रधराः सूर्यचंद्रमोभ्यां दिवो यथा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003711027, "chapter_id": 23711, "verse_number": "१-४-१९-२८", "content_sanskrit": "प्रतिष्ठंते तथा व्याघ्रवाहाः कुवलयत्विषः ।\nपोत्रैः सद्घर्घरारावैर्बिभ्रत्यो मुसलं हलम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003711028, "chapter_id": 23711, "verse_number": "१-४-१९-२९", "content_sanskrit": "रोषारुणसहस्राक्ष्यो वलक्षद्विपवाहनाः ।\nप्रतस्थिरे शातकोटिशतकोटिधराः पराः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003711029, "chapter_id": 23711, "verse_number": "१-४-१९-३०", "content_sanskrit": "अश्वारूढा समापेतुरेकाः सौदामिनीनिभाः ।\nखड्गखेटकधारिण्यः कोपेन कपिलाननाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003711030, "chapter_id": 23711, "verse_number": "१-४-१९-३१", "content_sanskrit": "ताश्च कोटिचतुःषष्टिमसुरानाश्रमाद्बहिः ।\nअरुन्धन्प्रसभं ध्वांतराशीनिव रवेस्त्विषः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003711031, "chapter_id": 23711, "verse_number": "१-४-१९-३२", "content_sanskrit": "ततश्च योगिनीचक्रदानवानीकयोर्मिथः ।\nप्रावर्त्तत रणं घोरं मुष्टामुष्टि कचाकचि ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003711032, "chapter_id": 23711, "verse_number": "१-४-१९-३३", "content_sanskrit": "सायकैर्योगिनीमुक्तैर्दलिता दैत्यमौलयः ।\nआच्छादयन्महीपृष्ठं स्थलजानीव सर्वतः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003711033, "chapter_id": 23711, "verse_number": "१-४-१९-३४", "content_sanskrit": "प्रसस्रू रक्तसरितो लगत्कैशिकशैवलाः ।\nलुठद्विपाठपाठीनाः स्मरैर्देवीमुखांबुजैः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003711034, "chapter_id": 23711, "verse_number": "१-४-१९-३५", "content_sanskrit": "वेतण्डतुण्डान्यारुह्य सौधानिव पिशाचिकाः ।\nप्रचण्ड तांडवाः पीतरक्तमद्याश्चकाशिरे ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003711035, "chapter_id": 23711, "verse_number": "१-४-१९-३६", "content_sanskrit": "कपालैर्दैत्यवीराणामघासुरसृगासवान् ।\nक्रीडड्डमरुकाकारैर्डामरैर्योगिनीगणाः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003711036, "chapter_id": 23711, "verse_number": "१-४-१९-३७", "content_sanskrit": "परिजह्रुस्तथांत्राणि कंकौघाः पाशशंकया ।\nक्षुधिता अपि मांसानि सशल्यान्यजहुः शिवाः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003711037, "chapter_id": 23711, "verse_number": "१-४-१९-३८", "content_sanskrit": "सिद्धविद्याधरोन्मुक्तमंदारप्रसवासवैः ।\nइयाय शांतिं भूरेणुः संग्रामे क्षोभसम्भवः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003711038, "chapter_id": 23711, "verse_number": "१-४-१९-३९", "content_sanskrit": "विरेजुर्योगिनीमुक्तैर्देहलग्नैर्द्विषां हयाः ।\nअमर्षातिशयोत्क्षिप्तैः शल्यैः शल्यमृगा इव ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003711039, "chapter_id": 23711, "verse_number": "१-४-१९-४०", "content_sanskrit": "दंडैः केचित्परे शूलैर्निशितैः केऽपि शक्तिभिः ।\nचक्रैरन्ये हलैरेके कतिचिच्छतकोटिभिः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003711040, "chapter_id": 23711, "verse_number": "१-४-१९-४१", "content_sanskrit": "योगिनीनां परे खड्गैर्दलिता दानवेश्वराः ।\nनिःशेषतामुपाजग्मुर्विना सेनाधिपान्निजान् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003711041, "chapter_id": 23711, "verse_number": "१-४-१९-४२", "content_sanskrit": "ब्राह्मी स्वयमुपागम्य विहितायोधनावधीत् ।\nकरालं विकरालेन दण्डेन ज्वलिता चिरात् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003711042, "chapter_id": 23711, "verse_number": "१-४-१९-४३", "content_sanskrit": "माहेश्वरी त्रिशूलेन सुचिरं कृतसंगरा ।\nचकर्त दुर्द्धरस्याशु मूर्द्धानमतिरोषणा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003711043, "chapter_id": 23711, "verse_number": "१-४-१९-४४", "content_sanskrit": "शक्त्या लुलाव कौमारी चिक्षुरासुरमस्तकम् ।\nचक्रेण चालुनान्मौलिं विकरालस्य वैष्णवी ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003711044, "chapter_id": 23711, "verse_number": "१-४-१९-४५", "content_sanskrit": "बाष्कलस्याशु वाराही मुसलेनालुनाच्छिरः ।\nदुर्मुखं चाशु वज्रेण व्यधादैंद्री गतायुषम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003711045, "chapter_id": 23711, "verse_number": "१-४-१९-४६", "content_sanskrit": "ख्यातं यस्याश्च नामेदं तयोरेव निदूषनात् ।\nचामुण्डा चण्डमुण्डौ च मण्डलाग्रेण चिच्छिदे ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003711046, "chapter_id": 23711, "verse_number": "१-४-१९-४७", "content_sanskrit": "प्रचण्डचामरौ वीरौ महामौलिं महाहनुम् ।\nउग्रास्यविकटाक्षौ च ज्वालास्यदहनावपि ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003711047, "chapter_id": 23711, "verse_number": "१-४-१९-४८", "content_sanskrit": "अनुजग्मुः क्रुधा यान्तं युद्धाय महिषासुरम् ।\nकालनेमिप्रभृतयो विप्रचित्तिमिवासुराः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003711048, "chapter_id": 23711, "verse_number": "१-४-१९-४९", "content_sanskrit": "शिरस्त्रवंतो रथिनः सुनिषंगा धनुर्धराः ।\nउद्भूतकटकाः प्रापुर्युद्धभूमिं चलद्ध्वजाः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003711049, "chapter_id": 23711, "verse_number": "१-४-१९-५०", "content_sanskrit": "समंतात्पूरितदिशः सिंहनादैर्भयंकरैः ।\nपृषत्कवर्षिणो मातृमंडलान्यभिदुद्रुवुः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003711050, "chapter_id": 23711, "verse_number": "१-४-१९-५१", "content_sanskrit": "ताश्च तैर्बलिभिः कृत्वा संग्रामं निस्सहत्वतः ।\nदुर्गां प्रपेदिरे देवीं शरणं सिंहवाहनाम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003711051, "chapter_id": 23711, "verse_number": "१-४-१९-५२", "content_sanskrit": "उक्त्वा मायालुलायस्य दुर्जयत्वं दुरात्मनः ।\nदेवी तां तुष्टुवुर्दुर्गामेवं सप्तापि मातरः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003711052, "chapter_id": 23711, "verse_number": "१-४-१९-५३", "content_sanskrit": "योगनिद्रेति रूपेण विष्णोर्नयनपद्मयोः ।\nत्वया निलीयते देवि मधुकार्येव लीलया ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003711053, "chapter_id": 23711, "verse_number": "१-४-१९-५४", "content_sanskrit": "अमूमुहस्तं न तथा मातश्च मधुकैटभौ ।\nकथं जघान तौ विष्णुस्तयोरेवाभ्यनुज्ञया ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003711054, "chapter_id": 23711, "verse_number": "१-४-१९-५५", "content_sanskrit": "त्वं कौशिकी न चेज्जाता मृत्युः शुंभनिशंभयोः ।\nकथं तु लोकपालानामैश्वर्यं देवि एष्यति ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003711055, "chapter_id": 23711, "verse_number": "१-४-१९-५६", "content_sanskrit": "विंध्यवासिनि विंध्येन किमवंध्यं कृतं तपः ।\nयत्र मैत्री किरातीभिरपि लभ्या त्वया समम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003711056, "chapter_id": 23711, "verse_number": "१-४-१९-५७", "content_sanskrit": "कापिशायनमापीतं धनदोपायनीकृतम् ।\nत्वयांब नीतं दैत्यानां रसैर्नियतमानवैः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003711057, "chapter_id": 23711, "verse_number": "१-४-१९-५८", "content_sanskrit": "ब्रह्मणः सृष्टिशक्तिस्त्वं स्थितिशक्तिर्मधुद्विषः ।\nअंब संहारशक्तिश्च रुद्रस्यापि प्रगल्भसे ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003711058, "chapter_id": 23711, "verse_number": "१-४-१९-५९", "content_sanskrit": "यशोदानंदजाता त्वमेकानंशेति नामतः ।\nकंसाद्यसुरसंहारे हरेः साह्यं करिष्यसि ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003711059, "chapter_id": 23711, "verse_number": "१-४-१९-६०", "content_sanskrit": "त्वं विद्या त्वं महामाया त्वं लक्ष्मीस्त्वं सरस्वती ।\nत्वं देवी पार्वतीशापि दुर्गे किं वा न जायसे ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003711060, "chapter_id": 23711, "verse_number": "१-४-१९-६१", "content_sanskrit": "नन्दिकेश्वर उवाच ।\nस्तोत्रेणानेन मातृभ्यो दुर्गा दत्ताभया स्वयम् ।\nमहिषासुरयुद्धाय संतुष्टा निर्ययौ तदा ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003711061, "chapter_id": 23711, "verse_number": "१-४-१९-६२", "content_sanskrit": "प्रचंडमंडलाग्रेण भिंडिपालेन चामरम् ।\nमहामौलिं क्षुरिकया कर्परेण महाहनुम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003711062, "chapter_id": 23711, "verse_number": "१-४-१९-६३", "content_sanskrit": "उग्रवक्त्रं कुठारेण शक्त्या विकटचक्षुषम् ।\nज्वालामुखं मुद्गरेण दहनं मुसलेन च ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003711063, "chapter_id": 23711, "verse_number": "१-४-१९-६४", "content_sanskrit": "निहत्य महिषस्याग्रे सरोषं युध्यती स्वयम् ।\nसिंहनादं महाघोरं चक्रेण मुदिताशया ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003711064, "chapter_id": 23711, "verse_number": "१-४-१९-६५", "content_sanskrit": "अथात्यमर्षितो दुर्गां विशिखैर्महिषासुरः ।\nविव्याध फालफलके स्तनयोर्गडयोरपि ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003711065, "chapter_id": 23711, "verse_number": "१-४-१९-६६", "content_sanskrit": "ततो दुर्गाथ संरंभात्प्रजहारासुरेश्वरम् ।\nबाह्वोर्वक्षसि वक्त्रे च क्षुरप्रैः प्रज्वलत्फलैः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003711066, "chapter_id": 23711, "verse_number": "१-४-१९-६७", "content_sanskrit": "ततो दैत्यस्त्रिभिर्दुर्गां जघान विशिखैर्मुखे ।\nपंचभिः पंचभिर्बाह्वोर्द्वाभ्यां द्वाभ्यां च नेत्रयोः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003711067, "chapter_id": 23711, "verse_number": "१-४-१९-६८", "content_sanskrit": "एकेन सारथिं रथ्यानष्टभिः कार्मुकं त्रिभिः ।\nचतुर्भिश्च ध्वजं तस्य दुर्गा चिच्छेद सायकैः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003711068, "chapter_id": 23711, "verse_number": "१-४-१९-६९", "content_sanskrit": "पदातिरथ दैत्येंद्रः शतघ्नीं ज्वलदाकृतिम् ।\nकालदंडप्रतीकाशां दुर्गां प्रति विमुक्तवान् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003711069, "chapter_id": 23711, "verse_number": "१-४-१९-७०", "content_sanskrit": "हाहाकुर्वस्तु देवेषु विद्राणे मातृमंडले ।\nतामापतंतीमादाय दुर्गा जग्राह लीलया ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003711070, "chapter_id": 23711, "verse_number": "१-४-१९-७१", "content_sanskrit": "कृपाणमंकुशं पाशं भुशुंडीं करवालिकाम् ।\nशंकुं शक्तिं गदां चक्रं तोमरं फलकं सृणिम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003711071, "chapter_id": 23711, "verse_number": "१-४-१९-७२", "content_sanskrit": "परश्वधं भिंडिपालं पट्टिशं लगुडं च सः ।\nदुर्गां प्रति विचिक्षेप क्षयांभोद इवाशनिम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003711072, "chapter_id": 23711, "verse_number": "१-४-१९-७३", "content_sanskrit": "आपतंत्येव शस्त्राणि क्षिप्तान्यादाय वैरिणाम् ।\nबभंज पाणिभिः स्वैरं करिणीवेक्षुकांडकम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003711073, "chapter_id": 23711, "verse_number": "१-४-१९-७४", "content_sanskrit": "दुर्गोपवाह्यः सिंहोऽपि लांगूलाग्रेण मुद्रितम् ।\nदंष्ट्रया दारयामास प्रहरन्नखपंकजैः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003711074, "chapter_id": 23711, "verse_number": "१-४-१९-७५", "content_sanskrit": "क्षणं सिंहः क्षणं क्रोडः क्षणं व्याघ्रः क्षणं गजः ।\nक्षणं च महिषो भूत्वा दैत्यो दुर्गामयोधयत् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003711075, "chapter_id": 23711, "verse_number": "१-४-१९-७६", "content_sanskrit": "महिषोऽथ विषाणाभ्यां तीक्ष्णाभ्यामत्यमर्षितः ।\nताडयामास सिंहं च देवीमपि मुहुर्मुहुः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003711076, "chapter_id": 23711, "verse_number": "१-४-१९-७७", "content_sanskrit": "क्षणं गगनमध्यस्थः क्षणं प्राप्तो महीतले ।\nक्षणं दिक्षु भ्रमन्प्राप्तः क्षणं चादृश्यतां गतः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003711077, "chapter_id": 23711, "verse_number": "१-४-१९-७८", "content_sanskrit": "प्रार्थिता मातृचक्रेण दुर्गा महिषदानवम् ।\nअमोघेन त्रिशूलेन दारयामास सस्मिता ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003711078, "chapter_id": 23711, "verse_number": "१-४-१९-७९", "content_sanskrit": "मुक्तघर्घरनिर्घोषो यावत्पतति दानवः ।\nतावदस्य हठेनांघ्रिं स्कंधपीठे न्यवेशयत् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003711079, "chapter_id": 23711, "verse_number": "१-४-१९-८०", "content_sanskrit": "कंठपीडनतो यातजीवितस्यामरद्रुहः ।\nछिन्नमूर्द्धानमादाय पाणिनाथ ननर्त्त सा ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003711080, "chapter_id": 23711, "verse_number": "१-४-१९-८१", "content_sanskrit": "इति दुर्गया समिति कासरासुरे दलिते समस्तभुवनैककंटके ।\nननृतुः सुराः प्रजहृषुर्महर्षयो ववृषुश्च दिव्यकुमुमानि वारिदाः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}]