[{"id": 7001222000, "chapter_id": 21222, "verse_number": "२-४-१५-१", "content_sanskrit": "॥ ब्रह्मोवाच  ।\nइत्युक्ता विभुना तेन निश्चयं परमं गताः ।\nसन्नद्धास्तु तदा तत्र जग्मुश्च शिवमन्दिरम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001222001, "chapter_id": 21222, "verse_number": "२-४-१५-२", "content_sanskrit": "गणेशोऽपि तथा दृष्ट्वा ह्यायातान्गणसत्तमान् ।\nयुद्धाऽऽटोपं विधायैव स्थितांश्चैवाब्रवीदिदम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001222002, "chapter_id": 21222, "verse_number": "२-४-१५-३", "content_sanskrit": "गणेश उवाच ।\nआयांतु गणपास्सर्वे शिवाज्ञाप रिपालकाः ।\nअहमेकश्च बालश्च शिवाज्ञापरिपालकः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001222003, "chapter_id": 21222, "verse_number": "२-४-१५-४", "content_sanskrit": "तथापि पश्यतां देवी पार्वती सूनुजं बलम् ।\nशिवश्च स्वगणानां तु बलं पश्यतु वै पुनः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001222004, "chapter_id": 21222, "verse_number": "२-४-१५-५", "content_sanskrit": "बलवद्बालयुद्धं च भवानीशिव पक्षयोः ।\nभवद्भिश्च कृतं युद्धं पूर्वं युद्धविशारदैः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001222005, "chapter_id": 21222, "verse_number": "२-४-१५-६", "content_sanskrit": "मया पूर्वं कृतं नैव बालोस्मि क्रियतेऽधुना ।\nतथापि भवतां लज्जा गिरिजाशिवयोरिह॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001222006, "chapter_id": 21222, "verse_number": "२-४-१५-७", "content_sanskrit": "ममैवं तु भवेन्नैव वैपरीत्यं भविष्यति ।\nममैव भवतां लज्जा गिरिजाशिवयोरिह॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001222007, "chapter_id": 21222, "verse_number": "२-४-१५-८", "content_sanskrit": "एवं ज्ञात्वा च कर्त्तव्यः समरश्च गणेश्वराः ।\nभवद्भिस्स्वामिनं दृष्ट्वा मया च मातरं तदा॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001222008, "chapter_id": 21222, "verse_number": "२-४-१५-९", "content_sanskrit": "क्रियते कीदृशं युद्धं भवितव्यं भवत्विति ।\nतस्य वै वारणे कोऽपि न समर्थस्त्रिलोकके॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001222009, "chapter_id": 21222, "verse_number": "२-४-१५-१०", "content_sanskrit": "ब्रह्मोवाच ।\nइत्येवं भर्त्सितास्ते तु दंडभूषितबाहवः ।\nविविधान्यायुधान्येवं धृत्वा ते च समाययुः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001222010, "chapter_id": 21222, "verse_number": "२-४-१५-११", "content_sanskrit": "घर्षयन्तस्तथा दंतान् हुंकृत्य च पुनःपुनः ।\nपश्य पश्य ब्रुवंतश्च गणास्ते समुपागताः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001222011, "chapter_id": 21222, "verse_number": "२-४-१५-१२", "content_sanskrit": "नंदी प्रथममागत्य धृत्वा पादं व्यकर्षयत् ।\nधावन्भृंगी द्वितीयं च पादं धृत्वा गणस्य च॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001222012, "chapter_id": 21222, "verse_number": "२-४-१५-१३", "content_sanskrit": "यावत्पादे विकर्षन्तौ तावद्धस्तेन वै गणः ।\nआहत्य हस्तयोस्ताभ्यामुत्क्षिप्तौ पादकौ स्वयम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001222013, "chapter_id": 21222, "verse_number": "२-४-१५-१४", "content_sanskrit": "अथ देवीसुतो वीरस्सगृह्य परिघं बृहत् ।\nद्वारस्थितो गणपतिः सर्वानापोथयत्तदा॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001222014, "chapter_id": 21222, "verse_number": "२-४-१५-१५", "content_sanskrit": "केषांचित्पाणयो भिन्नाः केषांचित्पृष्ठ कानि च ।\nकेषांचिच्च शिरांस्येव केषांचिन्मस्तकानि च॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001222015, "chapter_id": 21222, "verse_number": "२-४-१५-१६", "content_sanskrit": "केषांचिजानुनी तत्र केषांचित्स्कंधकास्तथा ।\nसम्मुखे चागता ये वै ते सर्वे हृदये हताः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001222016, "chapter_id": 21222, "verse_number": "२-४-१५-१७", "content_sanskrit": "केचिच्च पतिताभूमौ केचिच्च विदिशो गताः ।\nकेषांचिच्चरणौ छिन्नौ केचिच्छर्वान्तिकं गताः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001222017, "chapter_id": 21222, "verse_number": "२-४-१५-१८", "content_sanskrit": "तेषां मध्ये तु कश्चिद्वै संग्रामे सम्मुखो न हि ।\nसिंहं दृष्ट्वा यथा यांति मृगाश्चैव दिशो दश॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001222018, "chapter_id": 21222, "verse_number": "२-४-१५-१९", "content_sanskrit": "तथा ते च गणास्सर्वे गताश्चैव सहस्रशः ।\nपरावृत्य तथा सोपि सुद्वारि समुपस्थितः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001222019, "chapter_id": 21222, "verse_number": "२-४-१५-२०", "content_sanskrit": "कल्पांतकरणे कालो दृश्यते च भयंकरः ।\nयथा तथैव दृष्टस्स सर्वेषां प्रलयंकरः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001222020, "chapter_id": 21222, "verse_number": "२-४-१५-२१", "content_sanskrit": "एतस्मिन्समये चैव सरमेशसुरेश्वराः ।\nप्रेरिता नारदेनेह देवास्सर्वे समागमन्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001222021, "chapter_id": 21222, "verse_number": "२-४-१५-२२", "content_sanskrit": "समब्रुवंस्तदा सर्वे शिव स्य हितकाम्यया ।\nपुरःस्थित्वा शिवं नत्वा ह्याज्ञां देहि प्रभो इति॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001222022, "chapter_id": 21222, "verse_number": "२-४-१५-२३", "content_sanskrit": "त्वं परब्रह्म सर्वेशस्सर्वे च तव सेवकाः ।\nसृष्टेः कर्ता सदा भर्ता संहर्ता परमेश्वरः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001222023, "chapter_id": 21222, "verse_number": "२-४-१५-२४", "content_sanskrit": "रजस्सत्त्वतमोरूपो लीलया निर्गुणः स्वतः ।\nका लीला रचिता चाद्य तामिदानीं वद प्रभो॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001222024, "chapter_id": 21222, "verse_number": "२-४-१५-२५", "content_sanskrit": "॥ ब्रह्मोवाच  ।\nइत्याकर्ण्य वचस्तेषां मुनिश्रेष्ठ महेश्वरः ।\nगणान् भिन्नांस्तदा दृष्ट्वा तेभ्यस्सर्वं न्यवेदयत्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001222025, "chapter_id": 21222, "verse_number": "२-४-१५-२६", "content_sanskrit": "अथ सर्वेश्वरस्तत्र शंकरो मुनिसत्तम ।\nविहस्य गिरिजानाथो ब्रह्माणं मामुवाच ह॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001222026, "chapter_id": 21222, "verse_number": "२-४-१५-२७", "content_sanskrit": "शिव उवाच ।\nब्रह्मञ्छृणु मम द्वारि बाल एकस्समास्थितः ।\nमहाबलो यष्टिपाणिर्गेहावेशनिवारकः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001222027, "chapter_id": 21222, "verse_number": "२-४-१५-२८", "content_sanskrit": "महाप्रहारकर्ताऽसौ मत्पार्षदविघातकः ।\nपराजयः कृतस्तेन मद्गणानां बलादिह॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001222028, "chapter_id": 21222, "verse_number": "२-४-१५-२९", "content_sanskrit": "ब्रह्मन् त्वयैव गंतव्यं प्रसाद्योऽयं महाबलः ।\nयथा ब्रह्मन्नयः स्याद्वै तथा कार्यं त्वया विधे॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001222029, "chapter_id": 21222, "verse_number": "२-४-१५-३०", "content_sanskrit": "॥ ब्रह्मोवाच  ।\nइत्याकर्ण्य प्रभोर्वाक्यमज्ञात्वाऽज्ञानमोहितः ।\nतदीयनिकटं तात सर्वैरृषिवरैरयाम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001222030, "chapter_id": 21222, "verse_number": "२-४-१५-३१", "content_sanskrit": "समायान्तं च मां दृष्ट्वा स गणेशो महाबली ।\nक्रोधं कृत्वा समभ्येत्य मम श्मश्रूण्यवाकिरत्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001222031, "chapter_id": 21222, "verse_number": "२-४-१५-३२", "content_sanskrit": "क्षम्यतां क्षम्यतां देव न युद्धार्थं समागतः ।\nब्राह्मणोहमनुग्राह्यः शांतिकर्तानुपद्रवः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001222032, "chapter_id": 21222, "verse_number": "२-४-१५-३३", "content_sanskrit": "इत्येवं ब्रुवति ब्रह्मंस्तावत्परिघमाददे ।\nस गणेशो महावीरो बालोऽबालपराक्रमः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001222033, "chapter_id": 21222, "verse_number": "२-४-१५-३४", "content_sanskrit": "गृहीतपरिघं दृष्ट्वा तं गणेशं महाबलम् ।\nपलायनपरो यातस्त्वहं द्रुततरं तदा॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001222034, "chapter_id": 21222, "verse_number": "२-४-१५-३५", "content_sanskrit": "यात यात ब्रुवंतस्ते परिघेन हतास्तदा ।\nस्वयं च पतिताः केचित्केचित्तेन निपातिताः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001222035, "chapter_id": 21222, "verse_number": "२-४-१५-३६", "content_sanskrit": "केचिच्च शिवसामीप्यं गत्वा तत्क्षणमात्रतः ।\nशिवं विज्ञापयांचक्रुस्तद्वृत्तां तमशेषतः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001222036, "chapter_id": 21222, "verse_number": "२-४-१५-३७", "content_sanskrit": "तथाविधांश्च तान् दृष्ट्वा तद्वृत्तांतं निशम्य सः ।\nअपारमादधे कोपं हरो लीलाविशारदः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001222037, "chapter_id": 21222, "verse_number": "२-४-१५-३८", "content_sanskrit": "इंद्रादिकान्देवगणान् षण्मुखप्रवरान् गणान् ।\nभूतप्रेतपिशाचांश्च सर्वानादेशयत्तदा॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001222038, "chapter_id": 21222, "verse_number": "२-४-१५-३९", "content_sanskrit": "ते सर्वे च यथायोग्यं गतास्ते सर्वतो दिशम् ।\nतं गणं हंतुकामा हि शिवाज्ञाता उदायुधाः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001222039, "chapter_id": 21222, "verse_number": "२-४-१५-४०", "content_sanskrit": "यस्य यस्यायुधं यच्च तत्तत्सर्वं विशेषतः ।\nतद्गणेशोपरि बलात्समागत्य विमोचितम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001222040, "chapter_id": 21222, "verse_number": "२-४-१५-४१", "content_sanskrit": "हाहाकारो महानासीत्त्रैलोक्ये सचराचरे ।\nत्रिलोकस्था जनास्सर्वे संशयं परमं गताः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001222041, "chapter_id": 21222, "verse_number": "२-४-१५-४२", "content_sanskrit": "न यातं ब्रह्मणोऽप्यायुर्ब्रह्मांड क्षयमेति हि ।\nअकाले च तथा नूनं शिवेच्छावशतः स्वयम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001222042, "chapter_id": 21222, "verse_number": "२-४-१५-४३", "content_sanskrit": "ते सर्वे चागतास्तत्र षण्मुखाद्याश्च ये पुनः ।\nदेवा व्यर्थायुधा जाता आश्चर्यं परमं गताः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001222043, "chapter_id": 21222, "verse_number": "२-४-१५-४४", "content_sanskrit": "एतस्मिन्नन्तरे देवी जगदम्बा विबोधना ।\nज्ञात्वा तच्चरितं सर्वमपारं क्रोधमादधे॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001222044, "chapter_id": 21222, "verse_number": "२-४-१५-४५", "content_sanskrit": "शक्तिद्वयं तदा तत्र तया देव्या मुनीश्वर ।\nनिर्मितं स्वगणस्यैव सर्वसाहाय्यहेतवे॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001222045, "chapter_id": 21222, "verse_number": "२-४-१५-४६", "content_sanskrit": "एका प्रचंडरूपं च धृत्वातिष्ठन्महामुने ।\nश्यामपर्वतसंकांशं विस्तीर्य मुखगह्वरम्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001222046, "chapter_id": 21222, "verse_number": "२-४-१५-४७", "content_sanskrit": "एका विद्युत्स्वरूपा च बहुहस्तसमन्विता ।\nभयंकरा महादेवी दुष्टदंडविधायिनी॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001222047, "chapter_id": 21222, "verse_number": "२-४-१५-४८", "content_sanskrit": "आयुधानि च सर्वाणि मोचितानि सुरैर्गणैः ।\nगृहीत्वा स्वमुखे तानि ताभ्यां शीघ्रं च चिक्षिपे॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001222048, "chapter_id": 21222, "verse_number": "२-४-१५-४९", "content_sanskrit": "देवायुधं न दृश्येत परिघः परितः पुनः ।\nएवं ताभ्यां कृतं तत्र चरितं परमाद्भुतम्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001222049, "chapter_id": 21222, "verse_number": "२-४-१५-५०", "content_sanskrit": "एको बालोऽखिलं सैन्यं लोडयामास दुस्तरम् ।\nयथा गिरिवरेणैव लोडितस्सागरः पुरा॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001222050, "chapter_id": 21222, "verse_number": "२-४-१५-५१", "content_sanskrit": "एकेन निहतास्सर्वे शक्राद्या निर्जरास्तथा ।\nशंकरस्य गणाश्चैव व्याकुलाः अभवंस्तदा॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001222051, "chapter_id": 21222, "verse_number": "२-४-१५-५२", "content_sanskrit": "अथ सर्वे मिलित्वा ते निश्श्वस्य च मुहुर्मुहुः ।\nपरस्परं समूचुस्ते तत्प्रहारसमाकुलाः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001222052, "chapter_id": 21222, "verse_number": "२-४-१५-५३", "content_sanskrit": "देवगणा ऊचुः ।\nकिं कर्तव्यं क्व गंतव्यं न ज्ञायंते दिशो दश ।\nपरिघं भ्रामयत्येष सव्यापसव्यमेव च॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001222053, "chapter_id": 21222, "verse_number": "२-४-१५-५४", "content_sanskrit": "ब्रह्मोवाच ।\nएतत्कालेऽप्सरश्रेष्ठाः पुष्पचन्दनपाणयः ।\nऋषयश्च त्वदाद्या हि येऽतियुद्धेतिलालसाः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001222054, "chapter_id": 21222, "verse_number": "२-४-१५-५५", "content_sanskrit": "ते सर्वे च समाजग्मुर्युद्धसंदर्शनाय वै ।\nपूरितो व्योम सन्मार्गस्तैस्तदा मुनिसत्तम॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001222055, "chapter_id": 21222, "verse_number": "२-४-१५-५६", "content_sanskrit": "तास्ते दृष्ट्वा रणं तं वै महाविस्मयमागताः ।\nईदृशं परमं युद्धं न दृष्टं चैकदापि हि॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001222056, "chapter_id": 21222, "verse_number": "२-४-१५-५७", "content_sanskrit": "पृथिवी कंपिता तत्र समुद्रसहिता तदा ।\nपर्वताः पतिताश्चैव चक्रुः संग्रामसंभवम्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001222057, "chapter_id": 21222, "verse_number": "२-४-१५-५८", "content_sanskrit": "द्यौर्ग्रहर्क्षगणैर्घूर्ण्णा सर्वे व्याकुलतां गताः ।\nदेवाः पलायितास्सर्वे गणाश्च सकलास्तदा॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001222058, "chapter_id": 21222, "verse_number": "२-४-१५-५९", "content_sanskrit": "केवलं षण्मुखस्तत्र नापलायत विक्रमी ।\nमहावीरस्तदा सर्वानावार्य पुरतः स्थितः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001222059, "chapter_id": 21222, "verse_number": "२-४-१५-६०", "content_sanskrit": "शक्तिद्वयेन तद्युद्धे सर्वे च निष्फलीकृताः ।\nसर्वास्त्राणि निकृत्तानि संक्षिप्तान्यमरैर्गणैः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001222060, "chapter_id": 21222, "verse_number": "२-४-१५-६१", "content_sanskrit": "येऽव स्थिताश्च ते सर्वे शिवस्यांतिकमागताः ।\nदेवाः पलायितास्सर्वे गणाश्च सकलास्तदा॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001222061, "chapter_id": 21222, "verse_number": "२-४-१५-६२", "content_sanskrit": "ते सर्वे मिलिताश्चैव मुहुर्नत्वा शिवं तदा ।\nअब्रुवन्वचनं क्षिप्रं कोऽयं गणवरः प्रभो॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001222062, "chapter_id": 21222, "verse_number": "२-४-१५-६३", "content_sanskrit": "पुरा चैव श्रुतं युद्धमिदानीं बहुधा पुनः ।\nदृश्यते न श्रुतं दृष्टमीदृशं तु कदाचन॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001222063, "chapter_id": 21222, "verse_number": "२-४-१५-६४", "content_sanskrit": "किंचिद्विचार्यतां देव त्वन्यथा न जयो भवेत् ।\nत्वमेव रक्षकस्स्वामिन्ब्रह्मांडस्य न संशयः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001222064, "chapter_id": 21222, "verse_number": "२-४-१५-६५", "content_sanskrit": "ब्रह्मोवाच ।\nइत्येवं तद्वचः श्रुत्वा रुद्रः परमकोपनः ।\nकोपं कृत्वा च तत्रैव जगाम स्वगणैस्सह॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001222065, "chapter_id": 21222, "verse_number": "२-४-१५-६६", "content_sanskrit": "देवसैन्यं च तत्सर्वं विष्णुना चक्रिणा सह ।\nसमुत्सवं महत्कृत्वा शिवस्यानुजगाम ह॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001222066, "chapter_id": 21222, "verse_number": "२-४-१५-६७", "content_sanskrit": "एतस्मिन्नंतरे भक्त्या नमस्कृत्य महेश्वरम् ।\nअब्रवीन्नारद त्वं वै देवदेवं कृतांजलिः॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001222067, "chapter_id": 21222, "verse_number": "२-४-१५-६८", "content_sanskrit": "नारद उवाच ।\nदेवदेव महादेव शृणु मद्वचनं विभो ।\nत्वमेव सर्वगस्स्वामी नानालीलाविशारदः॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001222068, "chapter_id": 21222, "verse_number": "२-४-१५-६९", "content_sanskrit": "त्वया कृत्वा महालीलां गणगर्वोऽपहारितः ।\nअस्मै दत्त्वा बलं भूरि देवगर्वश्च शंकर॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001222069, "chapter_id": 21222, "verse_number": "२-४-१५-७०", "content_sanskrit": "दर्शितं भुवने नाथ स्वमेव बलमद्भुतम् ।\nस्वतंत्रेण त्वया शंभो सर्वगर्वप्रहारिणा॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001222070, "chapter_id": 21222, "verse_number": "२-४-१५-७१", "content_sanskrit": "इदानीं न कुरुष्वेश तां लीलां भक्तवत्सलः ।\nस्वगणानमरांश्चापि सुसन्मान्याभिवर्द्धय॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001222071, "chapter_id": 21222, "verse_number": "२-४-१५-७२", "content_sanskrit": "न खेलयेदानीं जहि ब्रह्मपदप्रद ।\nइत्युक्त्वा नारद त्वं वै ह्यंतर्द्धानं गतस्तदा॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]