[{"id": 7006440000, "chapter_id": 26440, "verse_number": "२-१००-१", "content_sanskrit": "वैशम्पायन उवाच\nततः सम्पूज्य गरुडं वासुदेवोऽनुमान्य च ।\nसखिवच्चोपगृह्यैनमनुजज्ञे गृहं प्रति ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006440001, "chapter_id": 26440, "verse_number": "२-१००-२", "content_sanskrit": "सोऽनुज्ञातो हि सत्कृत्य प्रणम्य च जनार्दनम् ।\nऊर्ध्वमाचक्रमे पक्षी यथेष्टं गगनेचरः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006440002, "chapter_id": 26440, "verse_number": "२-१००-३", "content_sanskrit": "स पक्षवातसंक्षुब्धं समुद्रं मकरालयम् ।\nकृत्वा वेगेन महता ययौ पूर्वमहोदधिम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006440003, "chapter_id": 26440, "verse_number": "२-१००-४", "content_sanskrit": "कृत्यकाले उपस्थास्य इत्युक्त्वा गरुडे गते ।\nकृष्णो ददर्श पितरं वृद्धमानकदुन्दुभिम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006440004, "chapter_id": 26440, "verse_number": "२-१००-५", "content_sanskrit": "उग्रसेनं च राजानं बलदेवं च सात्यकिम् ।\nकाश्यं सान्दीपनिं चैव ब्रह्मगार्ग्यं तथैव च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006440005, "chapter_id": 26440, "verse_number": "२-१००-६", "content_sanskrit": "अन्यांश्च वृद्धान्वृष्णीनां तांश्च भोजान्धकांस्तथा ।\nरत्नप्रवेकैर्दाशार्हान् वीर्यलब्धैस्तथार्चयत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006440006, "chapter_id": 26440, "verse_number": "२-१००-७", "content_sanskrit": "हता ब्रह्मद्विषः सर्वे जयन्त्यन्धकवृष्णयः ।\nरणात् प्रतिनिवृत्तोऽयमक्षतो मधुसूदनः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006440007, "chapter_id": 26440, "verse_number": "२-१००-८", "content_sanskrit": "इति चत्वररथ्यासु द्वारवत्यां सुपूजितः ।\nचाक्रिको घोषयामास पुरुषो मृष्टकुण्डलः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006440008, "chapter_id": 26440, "verse_number": "२-१००-९", "content_sanskrit": "ततः सान्दीपनिं पूर्वमभिगम्य जनार्दनः ।\nववन्दे वृष्णिनृपतिमाहुकं विनयान्वितः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006440009, "chapter_id": 26440, "verse_number": "२-१००-१०", "content_sanskrit": "तथाश्रुपरिपूर्णाक्षमानन्दागतचेतसम् ।\nववन्दे सह रामेण पितरं वासवानुजः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006440010, "chapter_id": 26440, "verse_number": "२-१००-११", "content_sanskrit": "उपगम्य तथा शेषान् सत्कृत्य च यथार्हतः ।\nसर्वेषां नाम जग्राह दाशार्हाणामधोक्षजः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006440011, "chapter_id": 26440, "verse_number": "२-१००-१२", "content_sanskrit": "ततः सर्वाणि दिव्यानि सर्वरत्नमयानि च ।\nआसनाग्र्याणि विविशुरुपेन्द्रप्रमुखास्तदा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006440012, "chapter_id": 26440, "verse_number": "२-१००-१३", "content_sanskrit": "ततस्तद्धनमक्षय्यं किङ्करैर्यत्समाहृतम् ।\nतत्सभामानयामासुः पुरुषाः कृष्णशासनात् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006440013, "chapter_id": 26440, "verse_number": "२-१००-१४", "content_sanskrit": "ततः सम्मानयामास दाशार्हांश्च यदूत्तमः ।\nसर्वान् दुन्दुभिशब्देन पूजयिष्यञ्जनार्दनः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006440014, "chapter_id": 26440, "verse_number": "२-१००-१५", "content_sanskrit": "तामासनवतीं रम्यां मणिविद्रुमतोरणाम् ।\nसभां सर्वदशार्हास्ते विविशुः कृष्णशासनात् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006440015, "chapter_id": 26440, "verse_number": "२-१००-१६", "content_sanskrit": "ततः पुरुषसिंहैर्या यदुभिः सर्वतो वृता ।\nखर्वार्थगुणसम्पन्ना सा सभा भरतर्षभ ।\nशुशुभेऽभ्यधिकं शुभ्रा सिंहैर्गिरिगुहा यथा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006440016, "chapter_id": 26440, "verse_number": "२-१००-१७", "content_sanskrit": "रामेण सह गोविन्दः काञ्चनं महदासनम् ।\nउग्रसेनं पुरस्कृत्य भोजवृष्णिपुरस्कतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006440017, "chapter_id": 26440, "verse_number": "२-१००-१८", "content_sanskrit": "तत्रोपविष्टांस्तान् वीरान् यथाप्रीति यथावयः ।\nसमाभाष्य यदुश्रेष्ठानुवाच पुरुषोत्तमः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]