[{"id": 5000348000, "chapter_id": 9348, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे नवमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000348001, "chapter_id": 9348, "verse_number": "५-९-१", "content_sanskrit": "तस्यालयवरिष्ठस्य मध्ये विमलमायतम्।\nददर्श भवनश्रेष्ठं हनुमान् मारुतात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000348002, "chapter_id": 9348, "verse_number": "५-९-२", "content_sanskrit": "अर्धयोजनविस्तीर्णमायतं योजनं महत्।\nभवनं राक्षसेन्द्रस्य बहुप्रासादसंकुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000348003, "chapter_id": 9348, "verse_number": "५-९-३", "content_sanskrit": "मार्गमाणस्तु वैदेहीं सीतामायतलोचनाम्।\nसर्वतः परिचक्राम हनूमानरिसूदनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000348004, "chapter_id": 9348, "verse_number": "५-९-४", "content_sanskrit": "उत्तमं राक्षसावासं हनुमानवलोकयन्।\nआससादाथ लक्ष्मीवान् राक्षसेन्द्रनिवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000348005, "chapter_id": 9348, "verse_number": "५-९-५", "content_sanskrit": "चतुर्विषाणैर्द्विरदैस्त्रिविषाणैस्तथैव च।\nपरिक्षिप्तमसम्बाधं रक्ष्यमाणमुदायुधैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000348006, "chapter_id": 9348, "verse_number": "५-९-६", "content_sanskrit": "राक्षसीभिश्च पत्नीभी रावणस्य निवेशनम्।\nआहृताभिश्च विक्रम्य राजकन्याभिरावृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000348007, "chapter_id": 9348, "verse_number": "५-९-७", "content_sanskrit": "तन्नक्रमकराकीर्णं तिमिंगिलझषाकुलम्।\nवायुवेगसमाधूतं पन्नगैरिव सागरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000348008, "chapter_id": 9348, "verse_number": "५-९-८", "content_sanskrit": "या हि वैश्रवणे लक्ष्मीर्या चन्द्रे हरिवाहने।\nसा रावणगृहे रम्या नित्यमेवानपायिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000348009, "chapter_id": 9348, "verse_number": "५-९-९", "content_sanskrit": "या च राज्ञः कुबेरस्य यमस्य वरुणस्य च।\nतादृशी तद्विशिष्टा वा ऋद्धी रक्षोगृहेष्विह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000348010, "chapter_id": 9348, "verse_number": "५-९-१०", "content_sanskrit": "तस्य हर्म्यस्य मध्यस्थवेश्म चान्यत् सुनिर्मितम्।\nबहुनिर्यूहसंयुक्तं ददर्श पवनात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000348011, "chapter_id": 9348, "verse_number": "५-९-११", "content_sanskrit": "ब्रह्मणोऽर्थे कृतं दिव्यं दिवि यद् विश्वकर्मणा।\nविमानं पुष्पकं नाम सर्वरत्नविभूषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000348012, "chapter_id": 9348, "verse_number": "५-९-१२", "content_sanskrit": "परेण तपसा लेभे यत् कुबेरः पितामहात्।\nकुबेरमोजसा जित्वा लेभे तद् राक्षसेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000348013, "chapter_id": 9348, "verse_number": "५-९-१३", "content_sanskrit": "ईहामृगसमायुक्तैः कार्तस्वरहिरण्मयैः।\nसुकृतैराचितं स्तम्भैः प्रदीप्तमिव च श्रिया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000348014, "chapter_id": 9348, "verse_number": "५-९-१४", "content_sanskrit": "मेरुमन्दरसंकाशैरुल्लिखद्भिरिवाम्बरम्।\nकूटागारैः शुभागारैः सर्वतः समलंकृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000348015, "chapter_id": 9348, "verse_number": "५-९-१५", "content_sanskrit": "ज्वलनार्कप्रतीकाशैः सुकृतं विश्वकर्मणा।\nहेमसोपानयुक्तं च चारुप्रवरवेदिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000348016, "chapter_id": 9348, "verse_number": "५-९-१६", "content_sanskrit": "जालवातायनैर्युक्तं काञ्चनैः स्फाटिकैरपि।\nइन्द्रनीलमहानीलमणिप्रवरवेदिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000348017, "chapter_id": 9348, "verse_number": "५-९-१७", "content_sanskrit": "विद्रुमेण विचित्रेण मणिभिश्च महाधनैः।\nनिस्तुलाभिश्च मुक्ताभिस्तलेनाभिविराजितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000348018, "chapter_id": 9348, "verse_number": "५-९-१८", "content_sanskrit": "चन्दनेन च रक्तेन तपनीयनिभेन च।\nसुपुण्यगन्धिना युक्तमादित्यतरुणोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000348019, "chapter_id": 9348, "verse_number": "५-९-१९", "content_sanskrit": "कूटागारैर्वराकारैर्विविधैः समलंकृतम्।\nविमानं पुष्पकं दिव्यमारुरोह महाकपिः।\nतत्रस्थः सर्वतो गन्धं पानभक्ष्यान्नसम्भवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000348020, "chapter_id": 9348, "verse_number": "५-९-२०", "content_sanskrit": "दिव्यं सम्मूर्च्छितं जिघ्रन् रूपवन्तमिवानिलम्।\nस गन्धस्तं महासत्त्वं बन्धुर्बन्धुमिवोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000348021, "chapter_id": 9348, "verse_number": "५-९-२१", "content_sanskrit": "इत एहीत्युवाचेव तत्र यत्र स रावणः।\nततस्तां प्रस्थितः शालां ददर्श महतीं शिवाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000348022, "chapter_id": 9348, "verse_number": "५-९-२२", "content_sanskrit": "रावणस्य महाकान्तां कान्तामिव वरस्त्रियम्।\nमणिसोपानविकृतां हेमजालविराजिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000348023, "chapter_id": 9348, "verse_number": "५-९-२३", "content_sanskrit": "स्फाटिकैरावृततलां दन्तान्तरितरूपिकाम्।\nमुक्तावज्रप्रवालैश्च रूप्यचामीकरैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000348024, "chapter_id": 9348, "verse_number": "५-९-२४", "content_sanskrit": "विभूषितां मणिस्तम्भैः सुबहुस्तम्भभूषिताम्।\nसमैर्ऋजुभिरत्युच्चैः समन्तात् सुविभूषितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000348025, "chapter_id": 9348, "verse_number": "५-९-२५", "content_sanskrit": "स्तम्भैः पक्षैरिवात्युच्चैर्दिवं सम्प्रस्थितामिव।\nमहत्या कुथयाऽऽस्तीर्णां पृथिवीलक्षणाङ्कया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000348026, "chapter_id": 9348, "verse_number": "५-९-२६", "content_sanskrit": "पृथिवीमिव विस्तीर्णां सराष्ट्रगृहशालिनीम्।\nनादितां मत्तविहगैर्दिव्यगन्धाधिवासिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000348027, "chapter_id": 9348, "verse_number": "५-९-२७", "content_sanskrit": "परर्घ्यास्तरणोपेतां रक्षोऽधिपनिषेविताम्।\nधूम्रामगुरुधूपेन विमलां हंसपाण्डुराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000348028, "chapter_id": 9348, "verse_number": "५-९-२८", "content_sanskrit": "पत्रपुष्पोपहारेण कल्माषीमिव सुप्रभाम्।\nमनसो मोदजननीं वर्णस्यापि प्रसाधिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000348029, "chapter_id": 9348, "verse_number": "५-९-२९", "content_sanskrit": "तां शोकनाशिनीं दिव्यां श्रियः संजननीमिव।\nइन्द्रियाणीन्द्रियार्थैस्तु पञ्च पञ्चभिरुत्तमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000348030, "chapter_id": 9348, "verse_number": "५-९-३०", "content_sanskrit": "तर्पयामास मातेव तदा रावणपालिता।\nस्वर्गोऽयं देवलोकोऽयमिन्द्रस्यापि पुरी भवेत्।\nसिद्धिर्वेयं परा हि स्यादित्यमन्यत मारुतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000348031, "chapter_id": 9348, "verse_number": "५-९-३१", "content_sanskrit": "प्रध्यायत इवापश्यत् प्रदीपांस्तत्र काञ्चनान्।\nधूर्तानिव महाधूर्तैर्देवनेन पराजितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000348032, "chapter_id": 9348, "verse_number": "५-९-३२", "content_sanskrit": "दीपानां च प्रकाशेन तेजसा रावणस्य च।\nअर्चिर्भिर्भूषणानां च प्रदीप्तेत्यभ्यमन्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000348033, "chapter_id": 9348, "verse_number": "५-९-३३", "content_sanskrit": "ततोऽपश्यत् कुथासीनं नानावर्णाम्बरस्रजम्।\nसहस्रं वरनारीणां नानावेषबिभूषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000348034, "chapter_id": 9348, "verse_number": "५-९-३४", "content_sanskrit": "परिवृत्तेऽर्धरात्रे तु पाननिद्रावशंगतम्।\nक्रीडित्वोपरतं रात्रौ प्रसुप्तं बलवत् तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000348035, "chapter_id": 9348, "verse_number": "५-९-३५", "content_sanskrit": "तत् प्रसुप्तं विरुरुचे निःशब्दान्तरभूषितम्।\nनिःशब्दहंसभ्रमरं यथा पद्मवनं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000348036, "chapter_id": 9348, "verse_number": "५-९-३६", "content_sanskrit": "तासां संवृतदान्तानि मीलिताक्षीणि मारुतिः।\nअपश्यत् पद्मगन्धीनि वदनानि सुयोषिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000348037, "chapter_id": 9348, "verse_number": "५-९-३७", "content_sanskrit": "प्रबुद्धानीव पद्मानि तासां भूत्वा क्षपाक्षये।\nपुनः संवृतपत्राणि रात्राविव बभुस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000348038, "chapter_id": 9348, "verse_number": "५-९-३८", "content_sanskrit": "इमानि मुखपद्मानि नियतं मत्तषट्पदाः।\nअम्बुजानीव फुल्लानि प्रार्थयन्ति पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000348039, "chapter_id": 9348, "verse_number": "५-९-३९", "content_sanskrit": "इति वामन्यत श्रीमानुपपत्त्या महाकपिः।\nमेने हि गुणतस्तानि समानि सलिलोद्भवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000348040, "chapter_id": 9348, "verse_number": "५-९-४०", "content_sanskrit": "सा तस्य शुशुभे शाला ताभिः स्त्रीभिर्विराजिता।\nशरदीव प्रसन्ना द्यौस्ताराभिरभिशोभिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000348041, "chapter_id": 9348, "verse_number": "५-९-४१", "content_sanskrit": "स च ताभिः परिवृतः शुशुभे राक्षसाधिपः।\nयथा ह्युडुपतिः श्रीमांस्ताराभिरिव संवृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000348042, "chapter_id": 9348, "verse_number": "५-९-४२", "content_sanskrit": "याश्च्यवन्तेऽम्बरात् ताराः पुण्यशेषसमावृताः।\nइमास्ताः संगताः कृत्स्ना इति मेने हरिस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000348043, "chapter_id": 9348, "verse_number": "५-९-४३", "content_sanskrit": "ताराणामिव सुव्यक्तं महतीनां शुभार्चिषाम्।\nप्रभावर्णप्रसादाश्च विरेजुस्तत्र योषिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000348044, "chapter_id": 9348, "verse_number": "५-९-४४", "content_sanskrit": "व्यावृत्तकचपीनस्रक्प्रकीर्णवरभूषणाः।\nपानव्यायामकालेषु निद्रोपहतचेतसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000348045, "chapter_id": 9348, "verse_number": "५-९-४५", "content_sanskrit": "व्यावृत्ततिलकाः काश्चित् काश्चिदुदभ्रान्तनूपुराः।\nपार्श्वे गलितहाराश्च काश्चित् परमयोषितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000348046, "chapter_id": 9348, "verse_number": "५-९-४६", "content_sanskrit": "मुक्ताहारवृताश्चान्याः काश्चित् प्रस्रस्तवाससः।\nव्याविद्धरशनादामाः किशोर्य इव वाहिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000348047, "chapter_id": 9348, "verse_number": "५-९-४७", "content_sanskrit": "अकुण्डलधराश्चान्या विच्छिन्नमृदितस्रजः।\nगजेन्द्रमृदिताः फुल्ला लता इव महावने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000348048, "chapter_id": 9348, "verse_number": "५-९-४८", "content_sanskrit": "चन्द्रांशुकिरणाभाश्च हाराः कासांचिदुद‍्गताः।\nहंसा इव बभुः सुप्ताः स्तनमध्येषु योषिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000348049, "chapter_id": 9348, "verse_number": "५-९-४९", "content_sanskrit": "अपरासां च वैदूर्याः कादम्बा इव पक्षिणः।\nहेमसूत्राणि चान्यासां चक्रवाका इवाभवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000348050, "chapter_id": 9348, "verse_number": "५-९-५०", "content_sanskrit": "हंसकारण्डवोपेताश्चक्रवाकोपशोभिताः।\nआपगा इव ता रेजुर्जघनैः पुलिनैरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000348051, "chapter_id": 9348, "verse_number": "५-९-५१", "content_sanskrit": "किङ्किणीजालसंकाशास्ता हेमविपुलाम्बुजाः।\nभावग्राहा यशस्तीराः सुप्ता नद्य इवाबभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000348052, "chapter_id": 9348, "verse_number": "५-९-५२", "content_sanskrit": "मृदुष्वंगेषु कासांचित् कुचाग्रेषु च संस्थिताः।\nबभूवुर्भूषणानीव शुभा भूषणराजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000348053, "chapter_id": 9348, "verse_number": "५-९-५३", "content_sanskrit": "अंशुकान्ताश्च कासांचिन्मुखमारुतकम्पिताः।\nउपर्युपरि वक्त्राणां व्याधूयन्ते पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000348054, "chapter_id": 9348, "verse_number": "५-९-५४", "content_sanskrit": "ताः पताका इवोद्‍धूताः पत्नीनां रुचिरप्रभाः।\nनानावर्णसुवर्णानां वक्त्रमूलेषु रेजिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000348055, "chapter_id": 9348, "verse_number": "५-९-५५", "content_sanskrit": "ववल्गुश्चात्र कासांचित् कुण्डलानि शुभार्चिषाम्।\nमुखमारुतसंकम्पैर्मन्दं मन्दं च योषिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000348056, "chapter_id": 9348, "verse_number": "५-९-५६", "content_sanskrit": "शर्करासवगन्धः स प्रकृत्या सुरभिः सुखः।\nतासां वदननिःश्वासः सिषेवे रावणं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000348057, "chapter_id": 9348, "verse_number": "५-९-५७", "content_sanskrit": "रावणाननशंकाश्च काश्चिद् रावणयोषितः।\nमुखानि च सपत्नीनामुपाजिघ्रन् पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000348058, "chapter_id": 9348, "verse_number": "५-९-५८", "content_sanskrit": "अत्यर्थं सक्तमनसो रावणे ता वरस्त्रियः।\nअस्वतन्त्राः सपत्नीनां प्रियमेवाचरंस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000348059, "chapter_id": 9348, "verse_number": "५-९-५९", "content_sanskrit": "बाहूनुपनिधायान्याः पारिहार्यविभूषितान्।\nअंशुकानि च रम्याणि प्रमदास्तत्र शिश्यिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000348060, "chapter_id": 9348, "verse_number": "५-९-६०", "content_sanskrit": "अन्या वक्षसि चान्यस्यास्तस्याः काचित् पुनर्भुजम्।\nअपरा त्वङ्कमन्यस्यास्तस्याश्चाप्यपरा कुचौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000348061, "chapter_id": 9348, "verse_number": "५-९-६१", "content_sanskrit": "ऊरुपार्श्वकटीपृष्ठमन्योन्यस्य समाश्रिताः।\nपरस्परनिविष्टांग्यो मदस्नेहवशानुगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000348062, "chapter_id": 9348, "verse_number": "५-९-६२", "content_sanskrit": "अन्योन्यस्यांगसंस्पर्शात् प्रीयमाणाः सुमध्यमाः।\nएकीकृतभुजाः सर्वाः सुषुपुस्तत्र योषितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000348063, "chapter_id": 9348, "verse_number": "५-९-६३", "content_sanskrit": "अन्योन्यभुजसूत्रेण स्त्रीमाला ग्रथिता हि सा।\nमालेव ग्रथिता सूत्रे शुशुभे मत्तषट्पदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000348064, "chapter_id": 9348, "verse_number": "५-९-६४", "content_sanskrit": "लतानां माधवे मासि फुल्लानां वायुसेवनात्।\nअन्योन्यमालाग्रथितं संसक्तकुसुमोच्चयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000348065, "chapter_id": 9348, "verse_number": "५-९-६५", "content_sanskrit": "प्रतिवेष्टितसुस्कन्धमन्योन्यभ्रमराकुलम्।\nआसीद् वनमिवोद्‍धूतं स्त्रीवनं रावणस्य तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 5000348066, "chapter_id": 9348, "verse_number": "५-९-६६", "content_sanskrit": "उचितेष्वपि सुव्यक्तं न तासां योषितां तदा।\nविवेकः शक्य आधातुं भूषणांगाम्बरस्रजाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 5000348067, "chapter_id": 9348, "verse_number": "५-९-६७", "content_sanskrit": "रावणे सुखसंविष्टे ताः स्त्रियो विविधप्रभाः।\nज्वलन्तः काञ्चना दीपाः प्रेक्षन्तो निमिषा इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 5000348068, "chapter_id": 9348, "verse_number": "५-९-६८", "content_sanskrit": "राजर्षिविप्रदैत्यानां गन्धर्वाणां च योषितः।\nरक्षसां चाभवन् कन्यास्तस्य कामवशंगताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 5000348069, "chapter_id": 9348, "verse_number": "५-९-६९", "content_sanskrit": "युद्धकामेन ताः सर्वा रावणेन हृताः स्त्रियः।\nसमदा मदनेनैव मोहिताः काश्चिदागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 5000348070, "chapter_id": 9348, "verse_number": "५-९-७०", "content_sanskrit": "न तत्र काश्चित् प्रमदाः प्रसह्य\nवीर्योपपन्नेन गुणेन लब्धाः।\nन चान्यकामापि न चान्यपूर्वा\nविना वरार्हां जनकात्मजां तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 5000348071, "chapter_id": 9348, "verse_number": "५-९-७१", "content_sanskrit": "न चाकुलीना न च हीनरूपा\nनादक्षिणा नानुपचारयुक्ता।\nभार्याभवत् तस्य न हीनसत्त्वा\nन चापि कान्तस्य न कामनीया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 5000348072, "chapter_id": 9348, "verse_number": "५-९-७२", "content_sanskrit": "बभूव बुद्धिस्तु हरीश्वरस्य\nयदीदृशी राघवधर्मपत्नी।\nइमा महाराक्षसराजभार्याः\nसुजातमस्येति हि साधुबुद्धेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 5000348073, "chapter_id": 9348, "verse_number": "५-९-७३", "content_sanskrit": "पुनश्च सोऽचिन्तयदात्तरूपो\nध्रुवं विशिष्टा गुणतो हि सीता।\nअथायमस्यां कृतवान् महात्मा\nलंकेश्वरः कष्टमनार्यकर्म ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 5000348074, "chapter_id": 9348, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे नवमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}]