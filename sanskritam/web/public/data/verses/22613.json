[{"id": 7002613000, "chapter_id": 22613, "verse_number": "४-१८-१", "content_sanskrit": "सूत उवाच ।\nकलौ चैकाहसाध्येन प्रतिष्ठामल्पवित्तवान् ।\nसद्योधिवासमाज्येन प्रकुर्यात्तांत्रिकोत्तमः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002613001, "chapter_id": 22613, "verse_number": "४-१८-२", "content_sanskrit": "उत्तरं तु गते हंसे अतीते चोत्तरायणे ।\nशरत्काले व्यतीते तु वसंते यज्ञमारभेत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002613002, "chapter_id": 22613, "verse_number": "४-१८-३", "content_sanskrit": "नारायणादिमूर्तीनां द्वात्रिंशद्भेद एव तु ।\nप्रतिष्ठां प्रतिमानां च गजास्यादींश्च सत्तमाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002613003, "chapter_id": 22613, "verse_number": "४-१८-४", "content_sanskrit": "नित्यं निर्वर्त्य मतिमान्कुर्यादभ्युदयं ततः ।\nविप्रान्संभोजयेद्वाथ ततो यागगृहं व्रजेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002613004, "chapter_id": 22613, "verse_number": "४-१८-५", "content_sanskrit": "गणेश ग्रहदिक्पालान्प्रतिकुंभेषु पूजयेत् ।\nस्थंडिले पूजयेद्विष्णुं परिवारगणं यजेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002613005, "chapter_id": 22613, "verse_number": "४-१८-६", "content_sanskrit": "स्नापयेत्प्रथमं देवं तोयैः पञ्चविधैरपि ।\nपञ्चामृतैः पञ्चगव्यैः पंचमृत्पिण्डकैरपि ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002613006, "chapter_id": 22613, "verse_number": "४-१८-७", "content_sanskrit": "तिलतैलैश्च स्नेहैश्च कषायैरपि सत्तमाः ।\nपञ्चपुष्पोदकैर्वाथ त्रिपदैरपि सत्तमाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002613007, "chapter_id": 22613, "verse_number": "४-१८-८", "content_sanskrit": "तुलसीकुसुमापुष्पपत्राण्याहुस्त्रिपत्रकम् ।\nपञ्चकाम्रशमीपद्मकरवीरं च पंचकम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002613008, "chapter_id": 22613, "verse_number": "४-१८-९", "content_sanskrit": "मृत्तिका करिदंतस्य तथाश्वखुरमृत्तिका ।\nगोमूत्रं गोमयं क्षीरं दधि सर्पिस्तु पंचमम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002613009, "chapter_id": 22613, "verse_number": "४-१८-१०", "content_sanskrit": "कुर्यात्प्राणप्रतिष्ठां च होमं कुर्याद्यथाविधि ।\nदक्षिणां विधिवद्दद्यात्पूर्णां तु तदनंतरम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]