[{"id": 2042332, "chapter_id": 1944, "verse_number": "५-१८९-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2042333, "chapter_id": 1944, "verse_number": "५-१८९-१", "content_sanskrit": "चकार यत्नं द्रुपदः सुतायाः सर्वकर्मसु।\nततो लेख्यादिषु तथा शिल्पेषु च परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2042334, "chapter_id": 1944, "verse_number": "५-१८९-२", "content_sanskrit": "इष्वस्त्रे चैव राजेन्द्र द्रोणशिष्यो बभूव ह।\nतस्य माता महाराज राजानं वरवर्णिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2042335, "chapter_id": 1944, "verse_number": "५-१८९-३", "content_sanskrit": "चोदयामास भार्यार्थं कन्यायाः पुत्रवत्तदा ।\nततस्तां पार्षतो दृष्ट्वा कन्यां संप्राप्तयौवनाम् ।\nस्त्रियं मत्वा ततश्चिन्तां प्रपेदे सह भार्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2042336, "chapter_id": 1944, "verse_number": "५-१८९-४x", "content_sanskrit": "द्रुपद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2042337, "chapter_id": 1944, "verse_number": "५-१८९-४", "content_sanskrit": "कन्या ममेयं संप्राप्ता यौवनं शोकवर्धिनी ।\nमया प्रच्छादिता चेयं वचनाच्छूलपाणिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2042338, "chapter_id": 1944, "verse_number": "५-१८९-५x", "content_sanskrit": "भार्योवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2042339, "chapter_id": 1944, "verse_number": "५-१८९-५", "content_sanskrit": "न तन्मिथ्या महाराज भविष्यति कथंचन ।\nत्रैलोक्यकर्ता कस्माद्धि वृथा वक्तुमिहार्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2042340, "chapter_id": 1944, "verse_number": "५-१८९-६", "content_sanskrit": "यदि ते रोचते राजन्वक्ष्यामि श्रृणु मे वचः।\nश्रुत्वेदानीं प्रपद्येथाः स्वां मतिं पृषतात्मज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2042341, "chapter_id": 1944, "verse_number": "५-१८९-७", "content_sanskrit": "क्रियतामस्य यत्नेन विधिवद्दारसंग्रहः ।\nभविता तद्वचः सत्यमिति मे निश्चिता मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2042342, "chapter_id": 1944, "verse_number": "५-१८९-८", "content_sanskrit": "ततस्तौ निश्चयं कृत्वा तस्मिन्कार्येऽथ दंपती ।\nवरयाञ्चक्रतुः कन्यां दशार्णाधिपतेः सुताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2042343, "chapter_id": 1944, "verse_number": "५-१८९-९", "content_sanskrit": "ततो राजा द्रुपदो राजसिंहः\nसर्वान्राज्ञः कुलतः सन्निशाम्य।\nदाशार्णकस्य नृपतेस्तनूजां\nशिखण्डिने वरयामास दारान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2042344, "chapter_id": 1944, "verse_number": "५-१८९-१०", "content_sanskrit": "हिरण्यवर्मेति नृपो योऽसौ दाशार्णकः स्मृतः।\nस च प्रादान्महीपालः कन्यां तस्मै शिखण्डिने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2042345, "chapter_id": 1944, "verse_number": "५-१८९-११", "content_sanskrit": "स च राजा दशार्णेषु महानासीत्सुदुर्जयः।\nहिरण्यवर्मा दुर्धर्षो महासेनो महामनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2042346, "chapter_id": 1944, "verse_number": "५-१८९-१२", "content_sanskrit": "कृते विवाहे तु तदा सा कन्या राजसत्तम।\nयौवनं समनुप्राप्ता सा च कन्या शिखण्डिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2042347, "chapter_id": 1944, "verse_number": "५-१८९-१३", "content_sanskrit": "कृतदारः शिखण्डी च काम्पिल्यं पुनरागमत्।\nन च सा वेद तां कन्यां कंचित्कालं स्त्रियं किल।\nयदा त्वेनामजानात्सा स्त्रियमेव नृपात्मजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2042348, "chapter_id": 1944, "verse_number": "५-१८९-१४", "content_sanskrit": "धात्रीणां च सखीनां च व्रीडयाना न्यवेदयत् ।\nकन्यां पाञ्चालराजस्य सुतां तां वै शिखण्डिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2042349, "chapter_id": 1944, "verse_number": "५-१८९-१५", "content_sanskrit": "ततस्ता राजशार्दूल धात्र्यो दाशार्णिकास्तदा।\nजग्मुरार्ति परां प्रेष्याः प्रेषयामासुरेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2042350, "chapter_id": 1944, "verse_number": "५-१८९-१६", "content_sanskrit": "ततो दशार्णाधिपतेः प्रेष्याः सर्वा न्यवेदयन् ।\nविप्रलम्भं यथावृत्तं स च चुक्रोध पार्थिवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2042351, "chapter_id": 1944, "verse_number": "५-१८९-१७", "content_sanskrit": "शिखण्ड्यपि महाराज पुंवद्राजकुले तदा।\nविजहार म्रुदा युक्तः स्त्रीत्वं नैवातिरोचयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2042352, "chapter_id": 1944, "verse_number": "५-१८९-१८", "content_sanskrit": "ततः कतिपयाहस्य तच्छ्रुत्वा भरतर्षभ ।\nहिरण्यवर्मा राजेन्द्र रोषादर्तिं जगाम ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2042353, "chapter_id": 1944, "verse_number": "५-१८९-१९", "content_sanskrit": "ततो दाशार्णको राजा तीव्रकोपसमन्वितः ।\nदूतं प्रस्थापयामास द्रुपदस्य निवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2042354, "chapter_id": 1944, "verse_number": "५-१८९-२०", "content_sanskrit": "ततो द्रुपदमासाद्य दूतः काञ्चनवर्मणः।\nएक एकान्तसुत्सार्य रहो वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2042355, "chapter_id": 1944, "verse_number": "५-१८९-२१", "content_sanskrit": "दाशार्णराजो राजंस्त्वामिदं वचनमब्रवीत् ।\nअभिष्गात्प्रकुपितो विप्रलब्धस्त्वयाऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2042356, "chapter_id": 1944, "verse_number": "५-१८९-२२", "content_sanskrit": "अवमन्यसे मां नृपते नूनं दुर्मन्त्रितं तव।\nयन्मे कन्यां स्वकन्यार्थे मोहाद्याचितवानसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2042357, "chapter_id": 1944, "verse_number": "५-१८९-२३", "content_sanskrit": "तस्याद्य विप्रलम्भस्य फलं प्राप्नुहि दुर्मते ।\nएष त्वं सजनामात्यमुद्धरामि स्थिरो भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2042358, "chapter_id": 1944, "verse_number": "५-१८९-२४", "content_sanskrit": "अवमत्य च वीर्यं मे कुलं चारित्रमेव च ।\nविप्रलम्भस्त्वयापूर्वो मनुष्येषु प्रवर्तितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2042359, "chapter_id": 1944, "verse_number": "५-१८९-२५", "content_sanskrit": "कुरु सर्वाणि कार्याणि भुङ्क्ष्व कभोगाननुत्तमान्।\nअभियास्यामि शीघ्रं त्वां समुद्धर्तुं सबान्धवम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2042360, "chapter_id": 1944, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि अम्बोपाख्यानपर्वणि एकोननवत्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]