[{"id": 2029876, "chapter_id": 1653, "verse_number": "३-२९१-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2029877, "chapter_id": 1653, "verse_number": "३-२९१-१", "content_sanskrit": "ततः क्रुद्धो दशग्रीवः प्रिये पुत्रे निपातिते।\nनिर्ययौ रथमास्थाय हेमरत्नविभूषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2029878, "chapter_id": 1653, "verse_number": "३-२९१-२", "content_sanskrit": "संवृतोराक्षसैर्घेरैर्विविधायुधपाणिभिः।\nअभिदुद्राव रामं स पोथयन्हरियूथपान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2029879, "chapter_id": 1653, "verse_number": "३-२९१-३", "content_sanskrit": "तमाद्रवन्तं संक्रुद्ध मैन्दनीलनलाङ्गदाः।\nहनुमाञ्जाम्बवांश्चैव ससैन्याः पर्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2029880, "chapter_id": 1653, "verse_number": "३-२९१-४", "content_sanskrit": "ते दशग्रीवसैन्यं तदृक्षवानरपुङ्गवाः।\nद्रुमैर्विध्वंसयांचक्रुर्दशग्रीवस्य पश्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2029881, "chapter_id": 1653, "verse_number": "३-२९१-५", "content_sanskrit": "ततः स्वसैन्यमालोक्य वध्यमानमरातिभिः।\nमायावी चासृजन्मायां रावणो राक्षसाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2029882, "chapter_id": 1653, "verse_number": "३-२९१-६", "content_sanskrit": "तस्य देहविनिष्क्रान्ताः शतशोऽथ सहस्रशः।\nराक्षसाः प्रत्यदृश्यन्त शरशक्त्यृष्टिपाणयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2029883, "chapter_id": 1653, "verse_number": "३-२९१-७", "content_sanskrit": "तान्रामो जघ्निवान्सर्वान्दिव्येनास्त्रेण राक्षसान्।\nअथ भूयोपि मायां स व्यदधाद्राक्षसाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2029884, "chapter_id": 1653, "verse_number": "३-२९१-८", "content_sanskrit": "कृत्वा रामस् रूपाणि लक्ष्मणस्य च भारत।\nअभिदुद्राव रामं च लक्ष्मणं च दशाननः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2029885, "chapter_id": 1653, "verse_number": "३-२९१-९", "content_sanskrit": "ततस्ते राममर्च्छन्तो लक्ष्मणं च क्षपाचराः।\nअभिपेतुस्तदा रामं प्रगृहीतशरासनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2029886, "chapter_id": 1653, "verse_number": "३-२९१-१०", "content_sanskrit": "तां दृष्ट्वाराक्षसेन्द्रस् मायामिक्ष्वाकुनन्दनः।\nउवाच रामः सौमित्रिमसंभ्रान्तो बृहद्वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2029887, "chapter_id": 1653, "verse_number": "३-२९१-११", "content_sanskrit": "जहीमान्राक्षसान्पापानात्मनः प्रतिरूपकान्।\nइत्युक्त्वाऽभ्यहनद्रामो लक्ष्मणश्चात्मरूपकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2029888, "chapter_id": 1653, "verse_number": "३-२९१-१२", "content_sanskrit": "ततो हर्यश्वयुक्तेन रथेनादित्यवर्चसा।\nउपतस्थे रणे रामं मातलिः शक्रसारथिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2029889, "chapter_id": 1653, "verse_number": "३-२९१-१३x", "content_sanskrit": "मातलिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2029890, "chapter_id": 1653, "verse_number": "३-२९१-१३", "content_sanskrit": "अयं हर्यश्वयुग्जैत्रो मघोनः स्यन्दनोत्तमः।\n`त्वदर्थमिह संप्राप्तः संदेशाद्वै शतक्रतोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2029891, "chapter_id": 1653, "verse_number": "३-२९१-१४", "content_sanskrit": "अनेन शक्रः काकुत्स्थ समरे दैत्यदानवान्।\nशतशः पुरुषव्याघ्र रथोदारेण जघ्निवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2029892, "chapter_id": 1653, "verse_number": "३-२९१-१५", "content_sanskrit": "तदनन नरव्याघ्र मया यत्तेन संयुगे।\nस्यन्दनेन जहिक्षिप्रं रावणं मा चिरं कृथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2029893, "chapter_id": 1653, "verse_number": "३-२९१-१६", "content_sanskrit": "इत्युक्तो राघवस्तथ्यं वचोऽशङ्कत मातलेः।\nमायैषाराक्षसस्येति तमुवाच विबीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2029894, "chapter_id": 1653, "verse_number": "३-२९१-१७", "content_sanskrit": "नेयं माया नरव्याघ्ररावणस् दुरात्मनः।\nतदातिष्ठ रथंशीघ्रमिमसैन्द्रं महाद्युते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2029895, "chapter_id": 1653, "verse_number": "३-२९१-१८", "content_sanskrit": "ततः प्रहृष्टः काकुत्स्थस्तथेत्युक्त्वा विभीषणम्।\nरथेनाभिपपाताथ दशग्रीवं रुषाऽन्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2029896, "chapter_id": 1653, "verse_number": "३-२९१-१९", "content_sanskrit": "हाहाकुतानि भूतानि रावणे समभिद्रुते।\nसिंहनादाः सपटहादिति दिव्यास्तथाऽनदन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2029897, "chapter_id": 1653, "verse_number": "३-२९१-२०", "content_sanskrit": "[दशकन्धरराजसून्वोस्तथा युद्धमभून्महत्।\nअलब्धोपममन्यत्रतयोरेव तथाऽभवत् ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2029898, "chapter_id": 1653, "verse_number": "३-२९१-२१", "content_sanskrit": "सरामाय महाघोरं विससर्ज निशाचरः।\nशूलमिन्द्राशनिप्रख्यं ब्रह्मदण्डभिवोद्यतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2029899, "chapter_id": 1653, "verse_number": "३-२९१-२२", "content_sanskrit": "तच्छूलं सत्वरं रामश्चच्छेद निशितैः शरैः।\nतद्दृष्ट्वा दुष्करं कर्म रावणं भयमाविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2029900, "chapter_id": 1653, "verse_number": "३-२९१-२३", "content_sanskrit": "ततः क्रुद्धः ससर्जाशु दशग्रीवः शिताञ्छरान्।\nसहस्रायुतशो रामे शस्त्राणि विविधानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2029901, "chapter_id": 1653, "verse_number": "३-२९१-२४", "content_sanskrit": "ततो भुशुण्डीः शूलानि मुसलानि परश्वथान्।\nशक्तीश्च विविधाकाराः शतघ्नीश्च शितान्क्षुरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2029902, "chapter_id": 1653, "verse_number": "३-२९१-२५", "content_sanskrit": "तां मायांविविधां दृष्ट्वा दशग्रीवस्य रक्षसः।\nभयात्प्रदुद्रुवुः सर्वे वानराः सर्वतोदिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2029903, "chapter_id": 1653, "verse_number": "३-२९१-२६", "content_sanskrit": "ततः सुपत्रं सुमुखंहेमपुङ्गं शरोत्तमम्।\nतूणादादाय काकुत्स्थो ब्रह्मास्त्रेण युयोज ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2029904, "chapter_id": 1653, "verse_number": "३-२९१-२७", "content_sanskrit": "तं प्रेक्ष्यबाणं रामेण ब्रह्मास्त्रेणानुमन्त्रितम्।\nजहृषुर्देवगन्धर्वा दृष्ट्वा शक्रपुरोगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2029905, "chapter_id": 1653, "verse_number": "३-२९१-२८", "content_sanskrit": "अल्पावशेषमायुश्च ततोऽमन्यन्त रक्षसः।\nब्रह्मास्त्रोदीरणाच्छत्रोर्देवदानवकिंनराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2029906, "chapter_id": 1653, "verse_number": "३-२९१-२९", "content_sanskrit": "ततः ससर्ज तं रामः शरमप्रतिमौजसम्।\nरावणान्तकरं घोरं ब्रह्मदण्डमिवोद्यतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2029907, "chapter_id": 1653, "verse_number": "३-२९१-३०", "content_sanskrit": "मुक्तमात्रेण रामेण दूराकृष्टेन भारत।\nस तेन राक्षसश्रेष्ठः सरथः साश्वसारथिः।\nप्रजज्वाल महाज्वालेनाग्निनाभिपरिप्लुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2029908, "chapter_id": 1653, "verse_number": "३-२९१-३१", "content_sanskrit": "ततः प्रहृष्टास्त्रिदशाः सहगन्धर्वचारणाः।\nनिहतं रावणं दृष्ट्वा रामेणाक्लिष्टकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2029909, "chapter_id": 1653, "verse_number": "३-२९१-३२", "content_sanskrit": "तत्यजुस्तं महाभागं पञ्चभूतानि रावणम्।\nभ्रंशितः सर्वलोकेषु स हि ब्रह्मास्त्रतेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2029910, "chapter_id": 1653, "verse_number": "३-२९१-३३", "content_sanskrit": "शरीरधातवो ह्यस् मासं रुधिरमेव च।\nनेशुर्ब्रह्मास्त्रनिर्दग्दा न च भस्माप्यदृश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2029911, "chapter_id": 1653, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि रामोपाख्यानपर्वणि एकनवत्यधिकद्विशततमोऽध्यायः ॥ २९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]