[{"id": 2108324, "chapter_id": 3345, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2108325, "chapter_id": 3345, "verse_number": "१", "content_sanskrit": "तस्य कण्ठमनुप्राप्तो ब्राह्मणः सह भार्यया ।\nदहन् दीप्त इवाङ्गारस्तमुवाचान्तरिक्षगः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2108326, "chapter_id": 3345, "verse_number": "२", "content_sanskrit": "द्विजोत्तम विनिर्गच्छ तूर्णमास्यादपावृतात् ।\nन हि मे ब्राह्मणो वध्यः पापेष्वभिरतः सदा \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2108327, "chapter_id": 3345, "verse_number": "३", "content_sanskrit": "ब्रुवाणमेवं गरुडं ब्राह्मणः समभाषत ।\nनिषादी मम भार्येयं निर्गच्छतु मया सह \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2108328, "chapter_id": 3345, "verse_number": "", "content_sanskrit": "गरुडः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2108329, "chapter_id": 3345, "verse_number": "४", "content_sanskrit": "एतामपि निषादीं त्वं प्रतिगृह्याशु निष्पत ।\nतूर्णं सम्भावयात्मानमजीर्णं मम तेजसा \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2108330, "chapter_id": 3345, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2108331, "chapter_id": 3345, "verse_number": "५", "content_sanskrit": "निश्चक्राम ततो विप्रो निषादीसहितस्तदा ।\nवर्धयित्वा च गरुडमिष्टं देशं जगाम ह\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2108332, "chapter_id": 3345, "verse_number": "७", "content_sanskrit": "सभार्येऽभिविनिष्क्रान्ते तस्मिन् विप्रे स पक्षिराट् ।\nवितत्य पक्षावाकाशमुत्पपात मनोजवः\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2108333, "chapter_id": 3345, "verse_number": "८", "content_sanskrit": "ततोऽपश्यत् स पितरं पृष्टश्चाख्यातवान् पितुः ।\nअहं हि सर्पैः प्रहितः सोममाहर्तुमुद्यतः\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2108334, "chapter_id": 3345, "verse_number": "९", "content_sanskrit": "मातुर्दास्यविमोक्षार्थमाहरिष्ये तदद्य वै ।\nमात्रा चास्मि समादिष्टो निषादान् भक्षयेति वै \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2108335, "chapter_id": 3345, "verse_number": "१०", "content_sanskrit": "न च मे तृप्तिरभवद्भक्षयित्वा सहस्रशः।\nतस्माद् भोक्तव्यमपरं भगवन्प्रविधत्स्व मे ।\nयद्भुक्त्वाऽमृतमाहर्तुं समर्थः स्यामहं प्रभो \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2108336, "chapter_id": 3345, "verse_number": "", "content_sanskrit": "काश्यपः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2108337, "chapter_id": 3345, "verse_number": "११", "content_sanskrit": "आसीद् विभावसुर्नाम महर्षिः कोपनो भृशम् ।\nभ्राता तस्यानुजश्चासीत् सुप्रतीको महातपाः\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2108338, "chapter_id": 3345, "verse_number": "१२", "content_sanskrit": "स नेच्छति धनं भ्रात्रा सहैकस्थं महाद्युतिः ।\nविभागं कीर्तयत्येव सुप्रतीकः स नित्यशः\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2108339, "chapter_id": 3345, "verse_number": "१३", "content_sanskrit": "अथाब्रवीत् स तं भ्राता सुप्रतीकं विभावसुः ।\nविभागे बहवो दोषा भविष्यन्ति महातपः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2108340, "chapter_id": 3345, "verse_number": "१४", "content_sanskrit": "विभागं बहवो मोहात् कर्तुमिच्छन्ति नित्यशः ।\nततो विभक्ताश्चान्योन्यं न प्रीयन्तेऽर्थमोहिताः\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2108341, "chapter_id": 3345, "verse_number": "१५", "content_sanskrit": "ततः स्वार्थपरान् मूढान् पृथग्भूतान् स्वकैर्जनैः ।\nविदित्वा भेदयन्त्येनानमित्रा मित्ररूपिणः\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2108342, "chapter_id": 3345, "verse_number": "१६", "content_sanskrit": "विदीर्णाश्चापरे भिन्नानन्तरेषु पतन्त्यथ ।\nभिन्नानामभितो नाशः क्षिप्रमेव प्रवर्तते\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2108343, "chapter_id": 3345, "verse_number": "१७", "content_sanskrit": "तस्माच्चैव विभागं न प्रशंसन्ति पण्डिताः ।\nएवमुक्तः सुप्रतीको भागं कीर्तयतेऽनिशम्\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2108344, "chapter_id": 3345, "verse_number": "१८", "content_sanskrit": "एवं निर्बध्यमानस्तु शशापैनं विभावसुः ।\nगुरुशास्त्रेण बद्धानामन्योन्यमवशङ्किनाम्\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2108345, "chapter_id": 3345, "verse_number": "१९", "content_sanskrit": "तेषां मध्ये त्वमप्येकश्छद्मकृच्च महात्मभिः ।\nनियन्तुं न हि शक्यस्त्वं भेदतो धनमिच्छसि\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2108346, "chapter_id": 3345, "verse_number": "२०", "content_sanskrit": "यस्मात् तस्मात् सुप्रतीक हस्तित्वं समवाप्स्यसि ।\nशप्तस्त्वेवं सुप्रतीको विभावसुमथाब्रवीत् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2108347, "chapter_id": 3345, "verse_number": "२१", "content_sanskrit": "त्वमप्यन्तर्जलचरः कच्छपः सम्भविष्यसि ।\nएवमन्योन्यशापात् तौ सुप्रतीकविभावसू \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2108348, "chapter_id": 3345, "verse_number": "२२", "content_sanskrit": "गजकच्छपतां प्राप्तावर्थार्थौ मूढचेतसौ ।\nरोषरोषानुषङ्गेण तिर्यग्योनिगतावपि \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2108349, "chapter_id": 3345, "verse_number": "२३", "content_sanskrit": "परस्परद्वेषरतौ प्रमाणबलदर्पितौ ।\nसरस्यस्मिन् महाकायौ पूर्ववैरानुसारिणौ \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2108350, "chapter_id": 3345, "verse_number": "२४", "content_sanskrit": "तयोरेकतरः श्रीमान् समुपैति महागजः ।\nतस्य बृंहितशब्देन कूर्मोऽप्यन्तर्जलेचरः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2108351, "chapter_id": 3345, "verse_number": "२५", "content_sanskrit": "उत्थितोऽसौ महाकायः कृत्स्नं सङ्क्षोभयन् सरः ।\nयं दृष्ट्वाऽऽवेष्टितकरः पतत्येष गजो जलम्\t ॥ २५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2108352, "chapter_id": 3345, "verse_number": "२६", "content_sanskrit": "दन्तहस्ताग्रलाङ्गूलपादवेगेन वीर्यवान् ।\nतं विक्षोभयमाणं तु सरो बहुझषाकुलम् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2108353, "chapter_id": 3345, "verse_number": "२७", "content_sanskrit": "स कूर्मोऽप्यभ्युद्यतशिरा युद्धायाभ्येति वीर्यवान् ।\nषडुच्छ्रितो योजनानि गजस्तद्द्विगुणायतः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2108354, "chapter_id": 3345, "verse_number": "२८", "content_sanskrit": "कूर्मस्त्रियोजनोत्सेधो दशयोजनमण्डलः ।\nतावुभौ युद्धसंयुक्तौ परस्परवधेषिणौ ।\nउपयुज्य सुकर्मेदं साधयेप्सितमात्मनः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2108355, "chapter_id": 3345, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2108356, "chapter_id": 3345, "verse_number": "२९", "content_sanskrit": "स तच्छ्रुत्वा पितुर्वाक्यं भीमवेगोऽन्तरिक्षगः ।\nनखेन गजमेकेन कूर्ममेकेन चाक्षिपत् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2108357, "chapter_id": 3345, "verse_number": "३०", "content_sanskrit": "समुत्पपात चाकाशं तत उच्चैर्विहङ्गमः ।\nसोऽलम्भतीर्थमासाद्य देववृक्षानुपागमत्\t ॥ ३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2108358, "chapter_id": 3345, "verse_number": "३१", "content_sanskrit": "ते भीताः समकम्पन्त तस्य पक्षानिलाहताः ।\nन नोऽभाङ्क्षीदिति तदा दिव्याः काननशाखिनः\t ॥ ३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2108359, "chapter_id": 3345, "verse_number": "३२", "content_sanskrit": "प्रचलाङ्गान् स तान् दृष्ट्वा मनोहरफलाङ्कुरान् ।\nअन्यानतुलरूपाङ्गानुपचक्राम खेचरः\t ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2108360, "chapter_id": 3345, "verse_number": "३३", "content_sanskrit": "काञ्चनै राजतैश्चैव फलैर्वैढूर्यशाखिनः ।\nसागराम्बुपरिक्षिप्तान् भ्राजमानान्  महाद्रुमान् \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2108361, "chapter_id": 3345, "verse_number": "३४", "content_sanskrit": "तमुवाच खगश्रेष्ठं तत्र रोहिणपादपः ।\nअतिप्रवृद्धः सुमहान् आपतन्तं मनोजवम् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2108362, "chapter_id": 3345, "verse_number": "", "content_sanskrit": "रोहिणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2108363, "chapter_id": 3345, "verse_number": "३५", "content_sanskrit": "एषा मम महाशाखा शतयोजनमायता ।\nएतामास्थाय शाखां त्वं खादेमौ गजकच्छपौ \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2108364, "chapter_id": 3345, "verse_number": "३७", "content_sanskrit": "ततो द्रुमं पतगसहस्रसेवितं\nमहीधरप्रतिमवपुः प्रकम्पयन्\nखगोत्तमो द्रुतमभिगम्य वेगवान्\nबभञ्ज तामविरलपत्रसंयुताम् \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2108365, "chapter_id": 3345, "verse_number": "१२", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि चतुर्विंशोऽध्यायः ॥२४॥ ॥ इति आस्तीकपर्वणि द्वादशोऽध्यायः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]