[{"id": 2207792, "chapter_id": 5432, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2207793, "chapter_id": 5432, "verse_number": "१", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nचातुर्होत्रविधानस्य विधानमिह यादृशम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2207794, "chapter_id": 5432, "verse_number": "२", "content_sanskrit": "तस्य सर्वस्य विधिवद् विधानमुपदेक्ष्यते ।\nशृणु मे गदतो भद्रे रहस्यमिदमुत्तमम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2207795, "chapter_id": 5432, "verse_number": "३", "content_sanskrit": "करणं कर्म कर्ता च मोक्ष इत्येव भामिनि ।\nचत्वार एते होतारो यैरिदं जगदावृतम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2207796, "chapter_id": 5432, "verse_number": "४", "content_sanskrit": "होतॄणां साधनं चैव शृणु सर्वं समाहितः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2207797, "chapter_id": 5432, "verse_number": "५", "content_sanskrit": "घ्राणं जिह्वा च चक्षुश्च त्वक् श्रोत्रं च पञ्चमम् ।\nमनो बुद्धिश्च सप्तैते ज्ञेयाः करणहेतवः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2207798, "chapter_id": 5432, "verse_number": "६", "content_sanskrit": "गन्धो रसश्च रूपं च स्पर्शः शब्दश्च पञ्चमः ।\nमन्तव्यमवबोद्धव्यं सप्तैते कर्महेतवः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2207799, "chapter_id": 5432, "verse_number": "७", "content_sanskrit": "घ्राता भक्षयिता द्रष्टा स्प्रष्टा श्रोता च पञ्चमः ।\nमन्ता बोद्धा च सप्तैते विज्ञेयाः कर्तृहेतवः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2207800, "chapter_id": 5432, "verse_number": "८", "content_sanskrit": "स्वगुणं भक्षयन्त्येते गुणवन्तः शुभाशुभान् ।\nअहं तु निर्गुणोऽत्रेति सप्तैते मोक्षहेतवः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2207801, "chapter_id": 5432, "verse_number": "९", "content_sanskrit": "विदुषां बुध्यमानानां स्वं स्वं स्थानं यथाविधि ।\nगुणास्ते देवता भूत्वा सततं भुञ्जते हविः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2207802, "chapter_id": 5432, "verse_number": "१०", "content_sanskrit": "अदन् ह्यविद्वानन्नानि ममत्वेनोपहन्यते ।\nआत्मार्थे पाचयन्नित्यं ममत्वेनोपहन्यते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2207803, "chapter_id": 5432, "verse_number": "११", "content_sanskrit": "अभक्ष्यभक्षणं चैव अन्नपानं च हन्ति तम् ।\nस चान्नं हन्ति तच्चान्नं स बुध्वा हन्यते बुधः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2207804, "chapter_id": 5432, "verse_number": "१२", "content_sanskrit": "माद्यमन्नमदन् विद्वान् पुनर्जनयतीश्वरः ।\nस चान्नाज्जायते तस्मिन् सूक्ष्मो नाम व्यतिक्रमः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2207805, "chapter_id": 5432, "verse_number": "१३", "content_sanskrit": "मनसा मन्यते यच्च यच्च बुद्ध्या निरुद्ध्यते ।\nश्रोत्रेण श्रूयते यच्च चक्षुषा यच्च दृश्यते\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2207806, "chapter_id": 5432, "verse_number": "१४", "content_sanskrit": "स्पर्शेन स्पृश्यते यच्च घ्राणेन घ्रायते च यत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2207807, "chapter_id": 5432, "verse_number": "१५", "content_sanskrit": "मनः षष्ठानि संयम्य हवींष्येतानि सर्वशः ।\nगुणवित् पावको मह्यं दीप्यते हव्यवाहनः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2207808, "chapter_id": 5432, "verse_number": "१६", "content_sanskrit": "योगयज्ञः प्रवृत्तो मे ज्ञानब्रह्ममनोभवः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2207809, "chapter_id": 5432, "verse_number": "१७", "content_sanskrit": "प्राणस्तोत्रोऽपानशस्त्रः सर्वत्यागसु दक्षिणः ।\nकर्ताऽनुमन्ता ब्रह्मात्मा कर्ताऽध्वर्युः कृतस्तुतिः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2207810, "chapter_id": 5432, "verse_number": "१८", "content_sanskrit": "कृतः प्रशस्ता तच्छस्त्रमपवर्गोऽस्य दक्षिणा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2207811, "chapter_id": 5432, "verse_number": "१९", "content_sanskrit": "ऋचश्चाप्यत्र शंसन्ति नारायणविदो जनाः ।\nनारायणाय देवाय यदबध्नं पशुं पुरा\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2207812, "chapter_id": 5432, "verse_number": "२०", "content_sanskrit": "तत्र सामानि गायन्ति तानि चाहुर्निदर्शनम् ।\nदेवं नारायणं भीरु सर्वात्मानं निबोध मे\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2207813, "chapter_id": 5432, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nआश्वमेधिकपर्वणि अनुगीतासु\nचतुर्होत्रविधानकथनं नाम षड्विंशोऽध्यायः ॥२६॥\nअनुगीतापर्वणि एकादशोऽध्यायः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]