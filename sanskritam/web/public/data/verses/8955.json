[{"id": 40005699, "chapter_id": 8955, "verse_number": "1", "content_sanskrit": "तां तथा दर्शयित्वा तु मैथिलीं गिरिनिम्नगाम्। निषसाद गिरिप्रस्थे सीतां मांसेन छन्दयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40005700, "chapter_id": 8955, "verse_number": "2", "content_sanskrit": "इदं मेध्यमिदं स्वादु निष्टप्तमिदमग्निना। एवमास्ते स धर्मात्मा सीतया सह राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40005701, "chapter_id": 8955, "verse_number": "3", "content_sanskrit": "तथा तत्राऽसतस्तस्य भरतस्यौपयायिनः। सैन्यरेणुश्च शब्दश्च प्रादुरास्तां नभस्पृशौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40005702, "chapter_id": 8955, "verse_number": "4", "content_sanskrit": "एतस्मिन्नन्तरे त्रस्ता श्शब्देन महता ततः। अर्दिता यूथपा मत्ता स्सयूथा दुद्रुवुर्दिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40005703, "chapter_id": 8955, "verse_number": "5", "content_sanskrit": "स तं सैन्यसमुद्धूतं शब्दं शुश्राव राघवः। तां श्च विप्रद्रुतान्सर्वान्यूथपानन्ववैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40005704, "chapter_id": 8955, "verse_number": "6", "content_sanskrit": "तांश्च विद्रुवतो दृष्ट्वा तं च श्रुत्वा च निस्वनम्। उवाच राम स्सौमित्रिं लक्ष्मणं दीप्ततेजसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40005705, "chapter_id": 8955, "verse_number": "7", "content_sanskrit": "हन्त लक्ष्मण पश्येह सुमित्रासुप्रजास्त्वया। भीमस्तनितगम्भीरस्तुमुलः श्रूयते स्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40005706, "chapter_id": 8955, "verse_number": "8", "content_sanskrit": "गजयूथानि वाऽरण्ये महिषा वा महावने। वित्रासिता मृगा स्सिंहै स्सहसा प्रद्रुता दिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40005707, "chapter_id": 8955, "verse_number": "9", "content_sanskrit": "राजा वा राजपुत्रो वा मृगयामटते वने। अन्यद्वा श्वापदं किञ्चित्सौमित्रे ज्ञातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40005708, "chapter_id": 8955, "verse_number": "10", "content_sanskrit": "सुदुश्चरो गिरिश्चायं पक्षिणामपि लक्ष्मण। सर्वमेतद्यथातत्त्वमचिरात् ज्ञातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40005709, "chapter_id": 8955, "verse_number": "11", "content_sanskrit": "स लक्ष्मण स्सन्त्वरित स्सालमारुह्य पुष्पितम्। प्रेक्षमाणो दिश स्सर्वाः पूर्वां दिशमुदैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40005710, "chapter_id": 8955, "verse_number": "12", "content_sanskrit": "उदङ्मुखः प्रेक्षमाणो ददर्श महतीं चमूम्। रथाश्वगजसम्बाधां यत्तैर्युक्तां पदातिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40005711, "chapter_id": 8955, "verse_number": "13", "content_sanskrit": "तामश्वगजसम्पूर्णां रथध्वजविभूषिताम्। शशंस सेनां रामाय वचनं चेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40005712, "chapter_id": 8955, "verse_number": "14", "content_sanskrit": "अग्निं संशमयत्वार्य स्सीता च भजतां गुहाम्। सज्यं कुरुष्व चापं च शरांश्च कवचं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40005713, "chapter_id": 8955, "verse_number": "15", "content_sanskrit": "तं रामः पुरुषव्याघ्रो लक्ष्मणं प्रत्युवाच ह। अङ्गावेक्षस्व सौमित्रे कस्येमां मन्यसे चमूम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40005714, "chapter_id": 8955, "verse_number": "16", "content_sanskrit": "एवमुक्तस्तु रामेण लक्ष्मणो वाक्यमब्रवीत्। दिधक्षन्निव तां सेनां रुषितः पावको यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40005715, "chapter_id": 8955, "verse_number": "17", "content_sanskrit": "सम्पन्नं राज्यमिच्छंस्तु व्यक्तं प्राप्याभिषेचनम्। आवां हन्तुं समभ्येति कैकेय्या भरतस्सुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40005716, "chapter_id": 8955, "verse_number": "18", "content_sanskrit": "एष वै सुमहाञ्छ्रीमान्विटपी सम्प्रकाशते। विराजत्युद्गतस्कन्धं कोविदारध्वजो रथे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40005717, "chapter_id": 8955, "verse_number": "19", "content_sanskrit": "असौ हि सुमहास्कन्धो विटपी च महाद्रुमः। विराजते महासैन्ये कोविदारध्वजो रथे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40005718, "chapter_id": 8955, "verse_number": "20", "content_sanskrit": "भजन्त्येते यथाकाममश्वानारुह्य शीघ्रगान्। एते भ्राजन्ति संहृष्टा गजानारुह्य सादिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40005719, "chapter_id": 8955, "verse_number": "21", "content_sanskrit": "गृहीतधनुषौ चावां गिरिं वीर श्रयावहै। अथवेहैव तिष्ठाव स्सन्नद्धावुद्यतायुधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40005720, "chapter_id": 8955, "verse_number": "22", "content_sanskrit": "अपि नौ वशमागच्छेत्कोविदारध्वजो रणे। अपि द्रक्ष्यामि भरतं यत्कृते व्यसनं महत् ॥ त्वया राघव सम्प्राप्तं सीतया च मया तथा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40005721, "chapter_id": 8955, "verse_number": "23", "content_sanskrit": "यन्निमित्तं भवान्राज्याच्छ्युतो राघव शाश्वतात् ॥ सम्प्राप्तोऽयमरिर्वीर भरतो वध्य एव मे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40005722, "chapter_id": 8955, "verse_number": "24", "content_sanskrit": "भरतस्य वधे दोषं नाहं पश्यामि राघव। पूर्वापकारिणं हत्वा न ह्यधर्मेण युज्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40005723, "chapter_id": 8955, "verse_number": "25", "content_sanskrit": "पूर्वापकारी भरतस्त्यक्तधर्मश्च राघव। एतस्मिन्निहते कृत्स्नामनुशाधि वसुन्धराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40005724, "chapter_id": 8955, "verse_number": "26", "content_sanskrit": "अद्य पुत्रं हतं संख्ये कैकेयी राज्यकामुका। मया पश्येत्सुदुःखार्ता हस्तिभग्नमिव द्रुमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40005725, "chapter_id": 8955, "verse_number": "27", "content_sanskrit": "कैकेयीं च वधिष्यामि सानुबन्धां सबान्धवाम्। कलुषेणाद्य महता मेदिनी परिमुच्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40005726, "chapter_id": 8955, "verse_number": "28", "content_sanskrit": "अद्येमं संयतं क्रोधमसत्कारं च मानद। मोक्ष्यामि शत्रुसैन्येषु कक्षेष्विव हुताशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40005727, "chapter_id": 8955, "verse_number": "29", "content_sanskrit": "अद्यैतच्छित्रकूटस्य काननं निशितै श्शरैः। छिन्दञ्चत्रुशरीराणि करिष्ये शोणितोक्षितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40005728, "chapter_id": 8955, "verse_number": "30", "content_sanskrit": "शरैर्निर्भिन्नहृदयान्कुञ्जरांस्तुरगांस्तथा। श्वापदाः परिकर्षन्तु नरांश्च निहतान्मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40005729, "chapter_id": 8955, "verse_number": "31", "content_sanskrit": "शराणां धनुषश्चाहमनृणोऽस्मिन्महावने। ससैन्यं भरतं हत्वा भविष्यामि न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]