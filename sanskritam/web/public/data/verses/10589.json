[{"id": 50002431, "chapter_id": 10589, "verse_number": "1", "content_sanskrit": "एषा ब्राह्मी स्थितिः पार्थ नैनां प्राप्य विमुह्यति। स्थित्वाऽस्यामन्तकालेऽपि ब्रह्म निर्बाणमृच्छति॥ २/७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50002432, "chapter_id": 10589, "verse_number": "2", "content_sanskrit": "॥ ओन्तत्सत्॥ इति श्रीमद्भगवद्गीतासूपनिषत्सु ब्रह्मविद्यायां योगशास्त्रे श्रीकृष्णार्जुनसंवादे साङ्ख्ययोगो नाम द्वितीयोऽध्यायः॥ ७२ श्लोकाः॥ आदितः ११९ श्लोकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50002433, "chapter_id": 10589, "verse_number": "3", "content_sanskrit": "॥ कर्मयोगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50002434, "chapter_id": 10589, "verse_number": "4", "content_sanskrit": "॥ अर्जुनस्य प्रश्नद्वयम् - कुतः कर्म कर्तव्यम्, कुतस्तरां च घोरं कर्म ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50002435, "chapter_id": 10589, "verse_number": "5", "content_sanskrit": "अर्जुन उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50002436, "chapter_id": 10589, "verse_number": "6", "content_sanskrit": "ज्यायसी चेत् कर्मणस्ते मता बुद्धिर्जनार्दन। तत् किं कर्मणि घोरे मां नियोजयसि केशव॥ ३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50002437, "chapter_id": 10589, "verse_number": "7", "content_sanskrit": "व्यामिश्रेणेव वाक्येन बुद्धिं मोहयसीव मे। तदेकं वद निश्चित्य येन श्रेयोऽहमाप्नुयाम्॥ ३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50002438, "chapter_id": 10589, "verse_number": "8", "content_sanskrit": "॥ प्रथमप्रश्नपरिहारः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}]