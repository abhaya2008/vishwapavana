[{"id": 2070462, "chapter_id": 2479, "verse_number": "११-११-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2070463, "chapter_id": 2479, "verse_number": "११-११-१", "content_sanskrit": "हतेषु सर्वेसैन्येषु धर्मराजो युधिष्ठिरः।\nशुश्रुवे पितरं वृद्धं निर्यान्तं गजसाह्वयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2070464, "chapter_id": 2479, "verse_number": "११-११-२", "content_sanskrit": "सोऽभ्ययात्पुत्रशोकार्तं पुत्रशोकपरिप्लुतः।\nशोचमानो महाराज भ्रातृभिः सहितस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2070465, "chapter_id": 2479, "verse_number": "११-११-३", "content_sanskrit": "अन्वीयमानो वीरेण दाशार्हेण महात्मना।\nयुयुधानेन च तथा तथैव च युयुत्सुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2070466, "chapter_id": 2479, "verse_number": "११-११-४", "content_sanskrit": "तमन्वगात्सुदुःखार्ता द्रौपदीशोककर्शिता।\nसह पाञ्चालयोषिद्भिर्यास्तत्रासन्समागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2070467, "chapter_id": 2479, "verse_number": "११-११-५", "content_sanskrit": "सङ्ग्राममनु बृन्दानि स्त्रीणां भरतसत्तम्।\nकुररीणामिवार्तानां क्रोशन्तीनां ददर्श ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2070468, "chapter_id": 2479, "verse_number": "११-११-६", "content_sanskrit": "ताभिः परिवृतो राजा क्रोशन्तीभिः सहस्रशः।\nऊर्ध्वबाहुभिरार्ताभी रुदतीभिः प्रियाप्रियैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2070469, "chapter_id": 2479, "verse_number": "११-११-७", "content_sanskrit": "क नु धर्मज्ञता राज्ञः क्व नु साद्यानृशंसता।\nयच्चावधीत्पितॄन्भ्रातॄन्गुरुपुत्रान्सखीनपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2070470, "chapter_id": 2479, "verse_number": "११-११-८", "content_sanskrit": "घातयित्वा कथं द्रोणं भीष्मं चापि पितामहम्।\nमनस्तेऽभून्महाबाहो हत्वा चापि जयद्रथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2070471, "chapter_id": 2479, "verse_number": "११-११-९", "content_sanskrit": "किं नु राज्येन ते कार्यं पितॄन्भ्रातॄनपश्यतः।\nअभिमन्युं च दुर्धर्षं द्रौपदेयांश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2070472, "chapter_id": 2479, "verse_number": "११-११-१०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2070473, "chapter_id": 2479, "verse_number": "११-११-१०", "content_sanskrit": "अतीत्य ता महाबाहुः क्रोशन्तीः कुररीरिव।\nववन्दे पितरं ज्येष्ठं धर्मराजो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2070474, "chapter_id": 2479, "verse_number": "११-११-११", "content_sanskrit": "ततोऽभिवाद्य पितरं क्रमेणामित्रकर्शनाः।\nन्यवेदयन्त नामानि पाण्डवास्तेऽपि सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2070475, "chapter_id": 2479, "verse_number": "११-११-१२", "content_sanskrit": "तमात्मजान्तकरणं पिता पुत्रवधार्दितः।\nअप्रीयमाणः शोकार्तः पाण्डवं परिषस्वजे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2070476, "chapter_id": 2479, "verse_number": "११-११-१३", "content_sanskrit": "धर्मराजं परिष्वज्य सान्त्वयित्वा च भारत।\nदुष्टात्मा भीममन्वैच्छद्दिधक्षुरिव पावकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2070477, "chapter_id": 2479, "verse_number": "११-११-१४", "content_sanskrit": "स कोपपावकस्तस्य शोकवायुसमीरितः।\nभीमसेनमयं दावं दिधक्षुरिव दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2070478, "chapter_id": 2479, "verse_number": "११-११-१५", "content_sanskrit": "तस्य संकल्पमाज्ञाय भीमं प्रत्यशुभं हरिः।\nभीममाक्षिप्य पाणिभ्यां प्रददौ भीममायसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2070479, "chapter_id": 2479, "verse_number": "११-११-१६", "content_sanskrit": "प्रागेव तु महाबुद्धिर्बुद्ध्वा तस्येङ्गितं हरिः।\nसंविधानं महाप्राज्ञस्तत्र चक्रे जनार्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2070480, "chapter_id": 2479, "verse_number": "११-११-१७", "content_sanskrit": "उपगुह्यैव पाणिभ्यां भीमसेनमयस्मयम्।\nबभञ्ज बलवान्राजा मन्यमानो वृकोदरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2070481, "chapter_id": 2479, "verse_number": "११-११-१८", "content_sanskrit": "नागायुतसमप्राणः स राजा भीममायसम्।\nभङ्क्तत्वा विमथितोरस्कः सुस्राव रुधिरं मुखात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2070482, "chapter_id": 2479, "verse_number": "११-११-१९", "content_sanskrit": "ततः पपात मेदिन्यां तथैव रुधिरोक्षितः।\nप्रपुष्पिताग्रशिखरः पारिजात इव द्रुमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2070483, "chapter_id": 2479, "verse_number": "११-११-२०", "content_sanskrit": "प्रत्यगृह्णाच्च तं विद्वान्सूतो गावल्गणिस्तदा।\nमैवमित्यब्रवीच्चैनं शमयन्सान्त्वयन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2070484, "chapter_id": 2479, "verse_number": "११-११-२१", "content_sanskrit": "हतो भीम इति ज्ञात्वा गतमन्युर्महामनाः।\nहाहाभीमेति चुक्रोश नृपः शोकसमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2070485, "chapter_id": 2479, "verse_number": "११-११-२२", "content_sanskrit": "तं विदित्वा गतक्रोधं भीमसेनवधार्दितम्।\nवासुदेवो वरः पुंसामिदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2070486, "chapter_id": 2479, "verse_number": "११-११-२३", "content_sanskrit": "मा शुचो धृतराष्ट्र त्वं नैव भीमस्त्वया हतः।\nआयसी प्रतिमा ह्येषा त्वया निष्पातिता विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2070487, "chapter_id": 2479, "verse_number": "११-११-२४", "content_sanskrit": "त्वां क्रोधवशमापन्नं विदित्वा भरतर्षभ।\nमयाऽपकृष्टः कौन्तेयो मृत्योर्दंष्ट्रान्तरं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2070488, "chapter_id": 2479, "verse_number": "११-११-२५", "content_sanskrit": "न हि ते राजशार्दूल बले तुल्योऽस्ति कश्चन।\nकः सहेत महाबाहो बाह्वोर्विग्रहणं नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2070489, "chapter_id": 2479, "verse_number": "११-११-२६", "content_sanskrit": "यथान्तकमनुप्राप्य जीवन्कश्चिन्न मुच्यते।\nएवं बाह्वन्तरं प्राप्य तव जीवेन्न कश्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2070490, "chapter_id": 2479, "verse_number": "११-११-२७", "content_sanskrit": "तस्मात्पुत्रेण या तेऽसौ प्रतिमा कारिताऽऽयसी।\nभीमस्य सेयं कौरव्य तवैवोपहृता मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2070491, "chapter_id": 2479, "verse_number": "११-११-२८", "content_sanskrit": "पुत्रशोकाभिसन्तप्तं धर्मादपकृतं मनः।\nतव राजेन्द्र तेन त्वं भीमसेनं जिघांससि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2070492, "chapter_id": 2479, "verse_number": "११-११-२९", "content_sanskrit": "न त्वेतत्ते क्षमं राजन्हन्यास्त्वं यद्वृकोदरम्।\nन हि पुत्रा महाराज जीवेयुस्ते कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2070493, "chapter_id": 2479, "verse_number": "११-११-३०", "content_sanskrit": "तस्माद्यत्कृतमस्माभिर्मन्यमानैः शमं प्रति।\nअनुमन्यस्व तत्सर्वं मा च शोके मनः कृथाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2070494, "chapter_id": 2479, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते स्त्रीपर्वणि जलप्रदानिकपर्वणि एकादशोऽध्यायः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]