[{"id": 7000225000, "chapter_id": 20225, "verse_number": "२२५-१", "content_sanskrit": "उमामहेश्वरसंवादे देवलोकप्राप्तिकारणकथनम् उमोवाच किं शीलः किं समाचारः पुरुषः कैश्च कर्मभिः ।\nस्वर्गं समभिपद्येत संप्रदानेन केन वा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000225001, "chapter_id": 20225, "verse_number": "२२५-२", "content_sanskrit": "महेश्वर उवाच दाता ब्राह्मणसत्कर्ता दीनार्तकृपणादिषु ।\nभक्षभोज्यान्नपानानां वाससां च महामतिः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000225002, "chapter_id": 20225, "verse_number": "२२५-३", "content_sanskrit": "प्रतिश्रयान्सभाः कुर्यात्प्रपाः पुष्करिणीस्तथा ।\nनित्यकादीनि कर्माणि करोति प्रयतः शुचिः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000225003, "chapter_id": 20225, "verse_number": "२२५-४", "content_sanskrit": "आसनं शयनं यानं गृहं रत्नं धनं तथा ।\nसस्यजातानि सर्वाणि सक्षेत्राण्यथ योषितः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000225004, "chapter_id": 20225, "verse_number": "२२५-५", "content_sanskrit": "सुप्रशान्तमना नित्यं यः प्रयच्छति मानवः ।\nएवं भूतो नरो देवि देवलोकेऽभिजायते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000225005, "chapter_id": 20225, "verse_number": "२२५-६", "content_sanskrit": "तत्रोष्य सुचिरं कालं भुक्त्वा भोगाननुत्तमान् ।\nसहाप्सरोभिर्मुदितो रमित्वा नन्दनादिषु ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000225006, "chapter_id": 20225, "verse_number": "२२५-७", "content_sanskrit": "तस्माच्चयुतो महेशानि मानुषेषूपजायते ।\nमहाभागकुले देवि धनधान्यसमाचिते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000225007, "chapter_id": 20225, "verse_number": "२२५-८", "content_sanskrit": "तत्र कामगुणैः सर्वैः समुपेतो मुदाऽन्वितः ।\nमहाकार्यो माभागो धनी भवति मानवः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000225008, "chapter_id": 20225, "verse_number": "२२५-९", "content_sanskrit": "?Bएते देवि महाभागाः प्राणिनो दानशालिनः ।\nब्रह्मणा वै पुरा प्रोक्ताः सर्वस्य प्रियदर्शनाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000225009, "chapter_id": 20225, "verse_number": "२२५-१०", "content_sanskrit": "अपरे मानवा देवि प्रदानकृपणा द्विजाः ।\nयोऽन्नानि न प्रयच्छन्ति विद्यमानेऽप्यबुद्धयः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000225010, "chapter_id": 20225, "verse_number": "२२५-११", "content_sanskrit": "दीनान्धकृपणान्दृष्ट्वा भिक्षुकानतिथीनपि ।\nयाच्यमाना निवर्तन्ते जिह्वालोभसमन्विताः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000225011, "chapter_id": 20225, "verse_number": "२२५-१२", "content_sanskrit": "न धनानि न वासांसि न भोगान्न च काञ्चनम् ।\nन गाश्च नान्नविकृतिं प्रयच्छन्ति कदाचन ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000225012, "chapter_id": 20225, "verse_number": "२२५-१३", "content_sanskrit": "अप्रलुब्धाश्च ये लुब्धा नास्तिका दानवर्जिताः ।\nएवं भूता नरा देवी निरयं यान्त्यबुद्धयः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000225013, "chapter_id": 20225, "verse_number": "२२५-१४", "content_sanskrit": "ते वै मनुष्यतां यान्ति यदा कालस्य पर्ययात् ।\nधनरिक्ते कुले जन्म लभन्ते स्वल्पबुद्धयः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000225014, "chapter_id": 20225, "verse_number": "२२५-१५", "content_sanskrit": "क्षुत्पिपासापरीताश्च सर्वलोकबहिष्कृताः ।\nनिराशाः सर्वभागेभ्यो जीवन्त्यधर्मजीविकाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000225015, "chapter_id": 20225, "verse_number": "२२५-१६", "content_sanskrit": "अल्पभोगकुले जाता अल्पभोगरता नराः ।\nअनेन कर्मणा देवि भवन्त्यधनिनो नराः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000225016, "chapter_id": 20225, "verse_number": "२२५-१७", "content_sanskrit": "अपरे दम्भिनो नित्यं मानिनः परतो रताः ।\nआसनार्हस्य ये पीठं न यच्छन्त्यल्पचेतसः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000225017, "chapter_id": 20225, "verse_number": "२२५-१८", "content_sanskrit": "मार्गार्हस्य च ये मार्गं न प्रयच्छन्त्यबुद्धयः ।\nअर्घार्हान्न च संस्कारैरर्चन्ति यथाविधि ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000225018, "chapter_id": 20225, "verse_number": "२२५-१९", "content_sanskrit": "पाद्यमाचमनीयं वा प्रयच्छन्त्यभिबुद्धयः ।\nशुभं चाभिमतं प्रेम्णा गुरुं नाभिवदन्ति ये ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000225019, "chapter_id": 20225, "verse_number": "२२५-२०", "content_sanskrit": "अभिमानप्रवृद्धेन लोभेन सममास्थिताः ।\nसंमान्यांश्चावमन्यन्ते वृद्धान्परिभवन्ति च ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000225020, "chapter_id": 20225, "verse_number": "२२५-२१", "content_sanskrit": "एवंविधा नरा देवि सर्वे निरयगामिनः ।\nते चेद्यदि नरास्तस्मान्निरयादुत्तरन्ति च ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000225021, "chapter_id": 20225, "verse_number": "२२५-२२", "content_sanskrit": "वर्षपूगैस्ततो जन्म लभन्ते कुत्सिते कुले ।\nश्वपाकपुल्कसादीनां कुत्सितानामचेतसाम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000225022, "chapter_id": 20225, "verse_number": "२२५-२३", "content_sanskrit": "कुलेषु तेऽभिजायन्ते गुरुवद्धोपतापिनः ।\nन दम्भी न च मानी यो देवता तिथिपूजकः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000225023, "chapter_id": 20225, "verse_number": "२२५-२४", "content_sanskrit": "लोकपूज्यो नमस्कर्ता प्रसूतो मधुरं वचः ।\nसर्वकर्मप्रियकरः सर्वभूतप्रियः सदा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000225024, "chapter_id": 20225, "verse_number": "२२५-२५", "content_sanskrit": "अद्वेषी सुमुखः श्लक्ष्णः स्निग्धवाणीप्रदः सदा ।\nस्वागतेनैव सर्वेषां भूतानामविहिंसकः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000225025, "chapter_id": 20225, "verse_number": "२२५-२६", "content_sanskrit": "यथार्थं सत्क्रियापूर्वमर्चयन्नवतिष्ठते ।\nमार्गार्हाय ददन्मार्गं गुरुमभ्यर्चयन्सदा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000225026, "chapter_id": 20225, "verse_number": "२२५-२७", "content_sanskrit": "अतिथिप्रग्रहरतस्तथाऽभ्यागतपूजकः ।\nएवंभूतो नरो देवि स्वर्गतिं प्रतिपद्यते ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000225027, "chapter_id": 20225, "verse_number": "२२५-२८", "content_sanskrit": "ततो मानुष्यमासाद्य विशिष्टकुलजो भवेत् ।\nतत्रासौ विपुलैर्भोगैः सर्वरत्नसमायुतः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000225028, "chapter_id": 20225, "verse_number": "२२५-२९", "content_sanskrit": "यर्थार्हादाता चार्हेषु धर्मचर्यापरो भवेत् ।\nसंमतः सर्भूतानां सर्वलोकनमस्कृतः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000225029, "chapter_id": 20225, "verse_number": "२२५-३०", "content_sanskrit": "स्वकर्मफलमाप्नोति स्वयमेव नरः सदा ।\nएष धर्मो मया प्रोक्तो विधात्रा स्वयमीरितः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000225030, "chapter_id": 20225, "verse_number": "२२५-३१", "content_sanskrit": "यस्तु रौद्रसमाचारः सर्वसत्त्वभयंकरः ।\nहस्ताभ्यां यदि वा पद्‌भ्यां रज्ज्वा दण्डेन वा पुनः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000225031, "chapter_id": 20225, "verse_number": "२२५-३२", "content_sanskrit": "लोष्टैः स्तम्भैरुपायैर्वा जन्तून्बाधेन शोभने ।\nहिंसार्थं निष्कटतिप्रज्ञः प्रोद्वेजयति चैव हि ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000225032, "chapter_id": 20225, "verse_number": "२२५-३३", "content_sanskrit": "उपक्रामति जन्तूंश्च उद्वेगजननः सदा ।\nएवं शीलसमाचारो निरयं प्रतिपद्यते ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000225033, "chapter_id": 20225, "verse_number": "२२५-३४", "content_sanskrit": "सचेन्मनुष्यतां गच्छेद्यदि कालस्य पर्ययात् ।\nबह्वाबाधापरिक्लिष्टे कुले जयति सोऽधमे ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000225034, "chapter_id": 20225, "verse_number": "२२५-३५", "content_sanskrit": "लोकद्विष्टोऽधमः पुंसां स्वयं कर्मकृतैः फलैः ।\nएष देवि मनुष्येषु बोद्धव्यो ज्ञातिबन्धुषु ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000225035, "chapter_id": 20225, "verse_number": "२२५-३६", "content_sanskrit": "अपरः सर्वभूतानि दयावाननुपश्यति ।\nमैत्री दृष्टिः पितृसमो निर्वैरो नियतेन्द्रियः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000225036, "chapter_id": 20225, "verse_number": "२२५-३७", "content_sanskrit": "नोद्वेजयति भूतानि न च हन्ति दयापरः ।\nहस्तपादैश्च नियतैर्विश्वास्यः सर्वजन्तुषु ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000225037, "chapter_id": 20225, "verse_number": "२२५-३८", "content_sanskrit": "न रज्ज्वा न च दण्डेन न लोष्टैर्नाऽऽयुधेन च ।\nउद्वेजयति भूतानि शुभकर्मा दयापरः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000225038, "chapter_id": 20225, "verse_number": "२२५-३९", "content_sanskrit": "एवं शीलसमाचारः स्वर्गे समुपजायते ।\nतत्रासौ भवने दिव्ये मुदा वसति देववत् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000225039, "chapter_id": 20225, "verse_number": "२२५-४०", "content_sanskrit": "स चेत्स्वर्गक्षयान्मतर्त्यो मनुष्येषूपजायते ।\nअल्पायासो निरातङ्कः स जातः सुखमेधते ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000225040, "chapter_id": 20225, "verse_number": "२२५-४१", "content_sanskrit": "सुखभागी निरायासो निरुद्वेगः सदा नरः ।\nएष देवि सतां मार्गो बाधा यत्र न विद्यते ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000225041, "chapter_id": 20225, "verse_number": "२२५-४२", "content_sanskrit": "उमोवाच इमे मनुष्य दृश्यन्ते ऊहापोहविशारदाः ।\nज्ञानविज्ञानसंपन्नाः प्रज्ञावन्तोऽर्थकोविदाः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000225042, "chapter_id": 20225, "verse_number": "२२५-४३", "content_sanskrit": "दुष्प्रज्ञाश्चापरे देव ज्ञानविज्ञानवर्जिताः ।\nकेन कर्मविपाकेन प्रज्ञावान्पुरुषो भवेत् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000225043, "chapter_id": 20225, "verse_number": "२२५-४४", "content_sanskrit": "अल्पप्रज्ञो विरूपाक्ष कथं भवति मानवः ।\nएवं त्वं संश्यं छिन्धि सर्वधर्मभृतां वर ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000225044, "chapter_id": 20225, "verse_number": "२२५-४५", "content_sanskrit": "जात्यन्धाश्चापरे देव रोगार्ताश्चापरे तथा ।\nनराः क्लीबाश्च दृश्यन्ते कारणं ब्रूहि तत्र वै ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000225045, "chapter_id": 20225, "verse_number": "२२५-४६", "content_sanskrit": "महेश्वर उवाच ब्राह्मणान्वेदविदुषः सिद्धान्धर्मविदस्तथा ।\nपरिच्छन्त्यरहः कुशलाकुशलं सदा ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000225046, "chapter_id": 20225, "verse_number": "२२५-४७", "content_sanskrit": "वर्जयन्तोऽशुभं कर्म सेवमानाः शुभं तथा ।\nलभन्ते स्वर्गतिं नित्यमिह लोके यथासुखम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000225047, "chapter_id": 20225, "verse_number": "२२५-४८", "content_sanskrit": "स चेन्मनुष्यतां याति मेधावी तत्र जायते ।\nश्रुतं यज्ञानुगं यस्य कल्याणमुपजायते ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000225048, "chapter_id": 20225, "verse_number": "२२५-४९", "content_sanskrit": "परदारेषु ये चापि चक्षुर्दुष्टं प्रयुञ्जते ।\nतेन दुष्टस्वभावेन जात्यन्धास्ते भवन्ति हि ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000225049, "chapter_id": 20225, "verse_number": "२२५-५०", "content_sanskrit": "मनसाऽपि प्रदुष्टेन नग्नां पश्यन्ति ये स्त्रियम् ।\nरोगार्तास्ते भवन्तीह नरा दुष्कृतकारिणः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000225050, "chapter_id": 20225, "verse_number": "२२५-५१", "content_sanskrit": "ये तु मूढा दुराचारा वियोनौ मैथुने रताः ।\nपुरुषेषु सुदुष्प्रज्ञाः क्लीबत्वमुपयान्ति ते ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000225051, "chapter_id": 20225, "verse_number": "२२५-५२", "content_sanskrit": "पशूंश्च ये वै बध्नन्ति चैव गुरुतल्पगाः ।\nप्रीकर्णमैथुना ये च क्लीब, जायन्ति वै नराः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000225052, "chapter_id": 20225, "verse_number": "२२५-५३", "content_sanskrit": "उमोवाच अवद्यं किं तु वै कर्म निरवद्यं तथैव च ।\nश्रेयः कुर्वन्नवाप्नोति मानवो देवसत्तम ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000225053, "chapter_id": 20225, "verse_number": "२२५-५४", "content_sanskrit": "महेश्वर उवाच श्रेयांसं मार्गमन्विच्छन्सदा यः पृच्छति द्विजान् ।\nधर्मान्वेषी गुणाकाङ्क्षी स स्वर्गं समुपाश्नुते ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000225054, "chapter_id": 20225, "verse_number": "२२५-५५", "content_sanskrit": "यदि मानुष्यतां देवि कदाचित्संनियच्छति ।\nमेधावी धारणायुक्तः प्राज्ञस्तत्रापि जायते ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000225055, "chapter_id": 20225, "verse_number": "२२५-५६", "content_sanskrit": "एष देवि सतां धर्मो गन्तव्यो भूतिकारकः ।\nनृणां हितार्थाय सदा मया चैवमुदाहृतः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000225056, "chapter_id": 20225, "verse_number": "२२५-५७", "content_sanskrit": "उमोवाच अपरे स्वल्पविज्ञाना धर्मविद्वेषिणो नराः ।\nब्राह्मणान्वेदविदुषो नेच्छन्ति परिसर्पितुम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000225057, "chapter_id": 20225, "verse_number": "२२५-५८", "content_sanskrit": "व्रतवन्तो नराः केचिच्छ्रद्धादमपरायणाः ।\nअव्रता भ्रष्टनियमास्तथाऽन्ये राक्षसोपमाः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000225058, "chapter_id": 20225, "verse_number": "२२५-५९", "content_sanskrit": "यज्वानश्च तथैवान्ये निर्मोहाश्च तथा परे ।\nकेन कर्मविपाकेन भवन्तीह वदस्व मे ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000225059, "chapter_id": 20225, "verse_number": "२२५-६०", "content_sanskrit": "महेश्वर उवाच आगमालोकधर्माणां मर्यादाः पूर्वनिर्मिताः ।\nप्रमाणेनानुवर्तन्ते दृश्यन्ते ह दृढव्रताः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000225060, "chapter_id": 20225, "verse_number": "२२५-६१", "content_sanskrit": "अधर्मं धर्ममित्याहुर्ये च मोहवशं गताः ।\nअव्रता नष्टमर्यादास्ते नरा ब्रह्मराक्षसाः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000225061, "chapter_id": 20225, "verse_number": "२२५-६२", "content_sanskrit": "ये वै कालकृतोद्योगात्संभवन्तीह मानवाः ।\nनिर्होमा निर्वषट्कारास्ते भवन्ति नराधमाः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000225062, "chapter_id": 20225, "verse_number": "२२५-६३", "content_sanskrit": "एष देवि मया सर्वसंशयच्छेदनाय ते ।\nकुशलाकुशलो नॄणां व्याख्यातो धर्मसागरः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]