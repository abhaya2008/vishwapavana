[{"id": 7005460000, "chapter_id": 25460, "verse_number": "१-३०-१", "content_sanskrit": "व्यास उवाच ।\nतिष्ये मायामसूयां च वधं चैव तपस्विनाम् ।\nसाधयन्ति नरा नित्यं तमसा व्याकुलीकृताः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005460001, "chapter_id": 25460, "verse_number": "१-३०-२", "content_sanskrit": "कलौ प्रमारको रोगः सततं क्षुद् भयं तथा ।\nअनावृष्टिभयं घोरं देशानां च विपर्ययः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005460002, "chapter_id": 25460, "verse_number": "१-३०-३", "content_sanskrit": "अधार्मिका अनाचारा महाकोपाल्पतेजसः ।\nअनृतं ब्रुवते लुब्धास्तिष्ये जाताः सुदुःष्प्रजाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005460003, "chapter_id": 25460, "verse_number": "१-३०-४", "content_sanskrit": "दुरिष्टैर्दुरधीतैश्च दुराचारैर्दुरागमैः ।\nविप्राणां कर्मदोषैश्च प्रजानां जायते भयम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005460004, "chapter_id": 25460, "verse_number": "१-३०-५", "content_sanskrit": "नाधीयते कलौ वेदान् न यजन्ति द्विजातयः ।\nयजन्त्यन्यायतो वेदान् पठन्ते चाल्पबुद्धयः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005460005, "chapter_id": 25460, "verse_number": "१-३०-६", "content_sanskrit": "शूद्राणां मन्त्रयौनैश्च संबन्धो ब्राह्मणैः सह ।\nभविष्यति कलौ तस्मिञ् शयनासनभोजनैः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005460006, "chapter_id": 25460, "verse_number": "१-३०-७", "content_sanskrit": "राजानः शूद्रभूयिष्ठा ब्राह्मणान् बाधयन्ति च ।\nभ्रूणहत्या वीरहत्या प्रजायेत नरेश्वरे ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005460007, "chapter_id": 25460, "verse_number": "१-३०-८", "content_sanskrit": "स्नानं होमं जपं दानं देवतानां तथाऽर्चनम् ।\nअन्यानि चैव कर्माणि न कुर्वन्ति द्विजातयः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005460008, "chapter_id": 25460, "verse_number": "१-३०-९", "content_sanskrit": "विनिन्दन्ति महादेवं ब्राह्मणान् पुरुषोत्तमम् ।\nआम्नायधर्मशास्त्राणि पुराणानि कलौ युगे ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005460009, "chapter_id": 25460, "verse_number": "१-३०-१०", "content_sanskrit": "कुर्वन्त्यवेददृष्टानि कर्माणि विविधानि तु ।\nस्वधर्मेऽभिरुचिर्नैव ब्राह्मणानां प्रजायते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005460010, "chapter_id": 25460, "verse_number": "१-३०-११", "content_sanskrit": "कुशीलचर्याः पाषण्डैर्वृथारूपैः समावृताः ।\nबहुयाचनका लोको भविष्यन्ति परस्परम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005460011, "chapter_id": 25460, "verse_number": "१-३०-१२", "content_sanskrit": "अट्टशूला जनपदाः शिवशूलाश्चतुष्पथाः ।\nप्रमदाः केशशूलिन्यो भविष्यन्ति कलौ युगे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005460012, "chapter_id": 25460, "verse_number": "१-३०-१३", "content_sanskrit": "शुक्लदन्ताजिनाख्याश्च मुण्डाः काषायवाससः ।\nशूद्रा धर्मं चरिष्यन्ति युगान्ते समुपस्थिते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005460013, "chapter_id": 25460, "verse_number": "१-३०-१४", "content_sanskrit": "सस्यचौरा भविष्यन्ति तथा चैलाभिमर्षिनः ।\nचौराश्चौरस्य हर्त्तारो हर्त्तुर्हर्त्ता तथाऽपरः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005460014, "chapter_id": 25460, "verse_number": "१-३०-१५", "content_sanskrit": "दुः खप्रचुरताल्पायुर्देहोत्सादः सरोगता ।\nअधर्माभिनिवेशित्वात् तमोवृत्तं कलौ स्मृतम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005460015, "chapter_id": 25460, "verse_number": "१-३०-१६", "content_sanskrit": "काषायिणोऽथ निर्ग्रन्थास्तथा कापालिकाश्च ये ।\nवेदविक्रयिणश्चान्ये तीर्थविक्रयिणः परे ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005460016, "chapter_id": 25460, "verse_number": "१-३०-१७", "content_sanskrit": "आसनस्थान् द्विजान् दृष्ट्वा चलन्त्यल्पबुद्धयः ।\nताडयन्ति द्विजेन्द्रांश्च शूद्रा राजोपजीविनः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005460017, "chapter_id": 25460, "verse_number": "१-३०-१८", "content_sanskrit": "उच्चासनस्थाः शूद्रास्तु द्विजमध्ये परंतप ।\nज्ञात्वा न हिंसते राजा कलौ कालबलेन तु ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005460018, "chapter_id": 25460, "verse_number": "१-३०-१९", "content_sanskrit": "पुष्पैश्च हसितैश्चैव तथान्यैर्मङ्गलैर्द्विजाः ।\nशूद्रानभ्यर्चयन्त्यल्पश्रुतभाग्यबलान्विताः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005460019, "chapter_id": 25460, "verse_number": "१-३०-२०", "content_sanskrit": "न प्रेक्षन्तेऽर्चितांश्चापि शूद्रा द्विजवरान् नृप ।\nसेवावसरमालोक्य द्वारि तिष्ठन्ति च द्विजाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005460020, "chapter_id": 25460, "verse_number": "१-३०-२१", "content_sanskrit": "वाहनस्थान् समावृत्य शूद्राञ्‌ शूद्रोपजीविनः ।\nसेवन्ते ब्राह्मणास्तांस्तु स्तुवन्ति स्तुतिभिः कलौ ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005460021, "chapter_id": 25460, "verse_number": "१-३०-२२", "content_sanskrit": "अध्यापयन्ति वै वेदाञ् शूद्रान् शूद्रोपजीविनः ।\nपठन्ति वैदिकान् मन्त्रान् नास्तिक्यं घोरमाश्रिताः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005460022, "chapter_id": 25460, "verse_number": "१-३०-२३", "content_sanskrit": "तपोयज्ञफलानां च विक्रेतारो द्विजोत्तमाः ।\nयतयश्च भविष्यन्ति शतशोऽथ सहस्रशः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005460023, "chapter_id": 25460, "verse_number": "१-३०-२४", "content_sanskrit": "नाशयन्ति ह्यधीतानि नाधिगच्छन्ति चानघ ।\nगायन्ति लौकिकैर्गानैर्दैवतानि नराधिप ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005460024, "chapter_id": 25460, "verse_number": "१-३०-२५", "content_sanskrit": "वामपाशुपताचारास्तथा वै पाञ्चरात्रिकाः ।\nभविष्यन्ति कलौ तस्मिन् ब्राह्मणाः क्षत्रियास्तथा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005460025, "chapter_id": 25460, "verse_number": "१-३०-२६", "content_sanskrit": "ज्ञानकर्मण्युपरते लोके निष्क्रियतां गते ।\nकीटमूषकसर्पाश्च धर्षयिष्यन्ति मानवान् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005460026, "chapter_id": 25460, "verse_number": "१-३०-२७", "content_sanskrit": "कुर्वान्ति चावताराणि ब्राह्मणानां कुलेषु वै ।\nदधीचशापनिर्दग्धाः पुरा दक्षाध्वरे द्विजाः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005460027, "chapter_id": 25460, "verse_number": "१-३०-२८", "content_sanskrit": "निन्दन्ति च महादेवं तमसाविष्टचेतसः ।\nवृथा धर्मं चरिष्यन्ति कलौ तस्मिन् युगान्तिके ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005460028, "chapter_id": 25460, "verse_number": "१-३०-२९", "content_sanskrit": "सर्वे वीरा भविष्यन्ति ब्राह्मणाद्याः स्वजातिषु ।\nये चान्ये शापनिर्दग्धा गौतमस्य महात्मनः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005460029, "chapter_id": 25460, "verse_number": "१-३०-३०", "content_sanskrit": "सर्वे ते च भविष्यन्ति ब्राह्मणाद्याः स्वजातिषु ।\nविनिन्दन्ति हृषीकेशं ब्राह्मणाः ब्रह्मवादिनः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005460030, "chapter_id": 25460, "verse_number": "१-३०-३१", "content_sanskrit": "वेदबाह्यव्रताचारा दुराचारा वृथाश्रमाः ।\nमोहयन्ति जनान् सर्वान् दर्शयित्वा फलानि च ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005460031, "chapter_id": 25460, "verse_number": "१-३०-३२", "content_sanskrit": "तमसाविष्टमनसो बैडालव्रतिकाधमाः ।\nकलौ रुद्रो महादेवो लोकानामीश्वरः परः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005460032, "chapter_id": 25460, "verse_number": "१-३०-३३", "content_sanskrit": "न देवता भवेन्नृणां देवतानां च दैवतम् ।\nकरिष्यत्यवताराणि शंकरो नीललोहितः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005460033, "chapter_id": 25460, "verse_number": "१-३०-३४", "content_sanskrit": "श्रौतस्मार्त्तप्रतिष्ठार्थं भक्तानां हितकाम्यया ।\nउपदेक्ष्यति तज्ज्ञानं शिष्याणां ब्रह्मसंज्ञितम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005460034, "chapter_id": 25460, "verse_number": "१-३०-३५", "content_sanskrit": "सर्ववेदान्तसारं हि धर्मान् वेदनिदर्शितान् ।\nसर्ववर्णान् समुद्धिश्य स्वधर्मा ये निदर्शिताः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005460035, "chapter_id": 25460, "verse_number": "१-३०-३६", "content_sanskrit": "ये तं प्रीताः निषेवन्ते येन केनोपचारतः ।\nविजित्यकलिजान् दोषान् यान्ति ते परमं पदम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005460036, "chapter_id": 25460, "verse_number": "१-३०-३७", "content_sanskrit": "अनायासेन सुमहत् पुण्यमाप्नोति मानवः ।\nअनेकदोषदुष्टस्य कलेरेष महान् गुणः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005460037, "chapter_id": 25460, "verse_number": "१-३०-३८", "content_sanskrit": "तस्मात् सर्वप्रयत्नेन प्राप्य माहेश्वरं युगम् ।\nविशेषाद् ब्राह्मणो रुद्रमीशानं शरणं व्रजेत् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005460038, "chapter_id": 25460, "verse_number": "१-३०-३९", "content_sanskrit": "ये नमन्ति विरूपाक्षमीशानं कृत्तिवाससम् ।\nप्रसन्नचेतसो रुद्रं ते यान्ति परमं पदम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005460039, "chapter_id": 25460, "verse_number": "१-३०-४०", "content_sanskrit": "यथा रुद्रनमस्कारः सर्वकर्मफलो ध्रुवः ।\nअन्यदेवनमस्कारान्न तत्फलमवाप्नुयात् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005460040, "chapter_id": 25460, "verse_number": "१-३०-४१", "content_sanskrit": "एवंविधे कलियुगे दोषाणामेवशोधनम् ।\nमहादेवनमस्कारो ध्यानं दानमिति श्रुतिः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005460041, "chapter_id": 25460, "verse_number": "१-३०-४२", "content_sanskrit": "तस्मादनीश्वरानन्यान् त्यक्त्वा देवं महेश्वरम् ।\nसमाश्रयेद् विरूपाक्षं यदीच्छेत् परमं पदम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005460042, "chapter_id": 25460, "verse_number": "१-३०-४३", "content_sanskrit": "नार्चयन्तीह ये रुद्रं शिवं त्रिदशवन्दितम् ।\nतेषां दानं तपो यज्ञो वृथा जीवितमेव च ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005460043, "chapter_id": 25460, "verse_number": "१-३०-४४", "content_sanskrit": "नमो रुद्राय महते देवदेवाय शूलिने ।\nत्र्यम्बकाय त्रिनेत्राय योगिनां गुरवे नमः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005460044, "chapter_id": 25460, "verse_number": "१-३०-४५", "content_sanskrit": "नमोऽस्तु वामदेवाय महादेवाय वेधसे ।\nशंभवे स्थाणवे नित्यं शिवाय परमेष्ठिने ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005460045, "chapter_id": 25460, "verse_number": "१-३०-४६", "content_sanskrit": "नमः सोमाय रुद्राय महाग्रासाय हेतवे ।\nप्रपद्येऽहं विरूपाक्षं शरण्यं ब्रह्मचारिणम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005460046, "chapter_id": 25460, "verse_number": "१-३०-४७", "content_sanskrit": "महादेवं महायोगमीशानं चाम्बिकापतिम् ।\nयोगिनां योगदातारं योगमायासमावृतम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005460047, "chapter_id": 25460, "verse_number": "१-३०-४८", "content_sanskrit": "योगिनां गुरुमाचार्यं योगिगम्यं पिनाकिनम् ।\nसंसारतारणं रुद्रं ब्रह्माणं ब्रह्मणोऽधिपम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005460048, "chapter_id": 25460, "verse_number": "१-३०-४९", "content_sanskrit": "शाश्वतं सर्वगं शान्तं ब्रह्मण्यं ब्राह्मणप्रियम् ।\nकपर्दिनं कालमूर्त्तिममूर्त्ति परमेश्वरम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005460049, "chapter_id": 25460, "verse_number": "१-३०-५०", "content_sanskrit": "एकमूर्त्ति महामूर्त्ति वेदवेद्यं दिवस्पतिम् ।\nनीलकण्ठं विश्वमूर्त्ति व्यापिनं विश्वरेतसम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005460050, "chapter_id": 25460, "verse_number": "१-३०-५१", "content_sanskrit": "कालाग्निं कालदहनं कामदं कामनाशनम् ।\nनमस्ये गिरिशं देवं चन्द्रावयवभूषणम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7005460051, "chapter_id": 25460, "verse_number": "१-३०-५२", "content_sanskrit": "विलोहितं लेलिहानमादित्यं परमेष्ठिनम् ।\nउग्रं पशुपतिं भीमं भास्करं परमं तपः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7005460052, "chapter_id": 25460, "verse_number": "१-३०-५३", "content_sanskrit": "इत्येतल्लक्षणं प्रोक्तं युगानां वै समासतः ।\nअतीतानागतानां वै यावन्मन्वन्तरक्षयः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7005460053, "chapter_id": 25460, "verse_number": "१-३०-५४", "content_sanskrit": "मन्वन्तरेण चैकेन सर्वाण्येवान्तराणि वै ।\nव्याख्यातानि न संदेहः कल्पः कल्पेन चैव हि ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7005460054, "chapter_id": 25460, "verse_number": "१-३०-५५", "content_sanskrit": "मन्वन्तरेषु चैतेषु अतीतानागतेषु वै ।\nतुल्याभिमानिनः सर्वे नामरूपैर्भवन्त्युत ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7005460055, "chapter_id": 25460, "verse_number": "१-३०-५६", "content_sanskrit": "एवमुक्तो भगवता किरीटी श्वेतवाहनः ।\nबभार परमां भक्तिमीशानेऽव्यभिचारिणीम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7005460056, "chapter_id": 25460, "verse_number": "१-३०-५७", "content_sanskrit": "नमश्चकार तमृषिं कृष्णद्वैपायनं प्रभुम् ।\nसर्वज्ञं सर्वकर्त्तारं साक्षाद् विष्णुं व्यवस्थितम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7005460057, "chapter_id": 25460, "verse_number": "१-३०-५८", "content_sanskrit": "तमुवाच पुनर्व्यासः पार्थं परपुरंजयम् ।\nकराभ्यां सुशुभाभ्यां च संस्पृश्य प्रणतं मुनिः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7005460058, "chapter_id": 25460, "verse_number": "१-३०-५९", "content_sanskrit": "धन्योऽस्यनुगृहीतोऽसि त्वादृशोऽन्यो न विद्यते ।\nत्रैलोक्ये शंकरे नूनं भक्तः परपुरंजय ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7005460059, "chapter_id": 25460, "verse_number": "१-३०-६०", "content_sanskrit": "दृष्टवानसि तं देवं विश्वाक्षं विश्वतोमुखम् ।\nप्रत्यक्षमेव सर्वेशं रुद्रं सर्वजगद्‌गुरुम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7005460060, "chapter_id": 25460, "verse_number": "१-३०-६१", "content_sanskrit": "ज्ञानं तदैश्वरं दिव्यं यथावद् विदितं त्वया ।\nस्वयमेव हृषीकेशः प्रीत्योवाच सनातनः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7005460061, "chapter_id": 25460, "verse_number": "१-३०-६२", "content_sanskrit": "गच्छ गच्छ स्वकं स्थानं न शोकं कर्त्तुमर्हसि ।\nव्रजस्व परया भक्त्या शरण्यं शरणं शिवम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7005460062, "chapter_id": 25460, "verse_number": "१-३०-६३", "content_sanskrit": "एवमुक्त्वा स भगवाननुगृह्यार्जुनं प्रभुः ।\nजगाम शंकरपुरीं समाराधयितुं भवम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7005460063, "chapter_id": 25460, "verse_number": "१-३०-६४", "content_sanskrit": "पाण्डवेयोऽपि तद् वाक्यात् संप्राप्य शरणं शिवम् ।\nसंत्यज्य सर्वकर्माणि तद्भक्तिपरमोऽभवत् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7005460064, "chapter_id": 25460, "verse_number": "१-३०-६५", "content_sanskrit": "नार्चनेन समः शंभोर्भक्त्या भूतो भविष्यति ।\nमुक्त्वा सत्यवतीसूनुं कृष्णं वा देवकीसुतम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7005460065, "chapter_id": 25460, "verse_number": "१-३०-६६", "content_sanskrit": "तस्मै भगवते नित्यं नमः सत्याय धीमते ।\nपाराशर्याय मुनये व्यासायामिततेजसे ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7005460066, "chapter_id": 25460, "verse_number": "१-३०-६७", "content_sanskrit": "कृष्णद्वैपायनः साक्षाद् विष्णुरेव सनातनः ।\nको ह्यन्यस्तत्त्वतो रुद्रं वेत्ति तं परमेश्वरम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7005460067, "chapter_id": 25460, "verse_number": "१-३०-६८", "content_sanskrit": "नमः कुरुध्वं तमृषिं कृष्णं सत्यवतीसुतम् ।\nपाराशर्यं महात्मानं योगिनं विष्णुमव्ययम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7005460068, "chapter_id": 25460, "verse_number": "१-३०-६९", "content_sanskrit": "एवमुक्तास्तु मुनयः सर्व एव समीहिताः ।\nप्रेणेमुस्तं महात्मानं व्यासं सत्यवतीसुतम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]