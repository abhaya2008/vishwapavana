[{"id": 2049748, "chapter_id": 2092, "verse_number": "७-१९-०x", "content_sanskrit": "सञ्च उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2049749, "chapter_id": 2092, "verse_number": "७-१९-१", "content_sanskrit": "दृष्टा तु सन्निवृत्तांस्तान्संशप्तकगणान्पुनः।\nवासुदेवं महात्मानमर्जुनः समभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2049750, "chapter_id": 2092, "verse_number": "७-१९-२", "content_sanskrit": "चोदयाश्वान्हृषीकेश संशप्तकगणान्प्रति।\nनैते हास्यन्ति सङ्ग्रामं जीवन्त इति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2049751, "chapter_id": 2092, "verse_number": "७-१९-३", "content_sanskrit": "पश्य मेऽस्त्रबलं घोरं बाह्वोरिष्वसनस्य च।\nअद्यैतान्पातयिष्यामि क्रुद्धो रुद्रः पशूनिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2049752, "chapter_id": 2092, "verse_number": "७-१९-४x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2049753, "chapter_id": 2092, "verse_number": "७-१९-४", "content_sanskrit": "ततः कृष्णः स्मितं कृत्वा प्रतिनन्द्य शिवेन तम्।\nप्रावेशयत दुर्धर्षो यत्रयत्रैच्छदर्जुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2049754, "chapter_id": 2092, "verse_number": "७-१९-५", "content_sanskrit": "स रथो भ्राजतेऽत्यर्थमुह्यमानो रणे तदा।\nउह्यमानमिवाकाशे विमानं पाण्डुरैर्हयैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2049755, "chapter_id": 2092, "verse_number": "७-१९-६", "content_sanskrit": "मण्डलानि ततश्चक्रे गतप्रत्यागतानि चे।\nयथा शक्ररथो राजन्युद्धे देवासुरे पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2049756, "chapter_id": 2092, "verse_number": "७-१९-७", "content_sanskrit": "अथ नारायणाः क्रुद्धा विविधायुधपाणयः।\nछादयन्तः शरव्रातैः परिवव्रुर्धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2049757, "chapter_id": 2092, "verse_number": "७-१९-८", "content_sanskrit": "अदृश्यं च मुहूर्तेन चक्रुस्ते भरतर्षभ।\nकृष्णेन सहितं युद्धे कुन्तीपुत्रं धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2049758, "chapter_id": 2092, "verse_number": "७-१९-९", "content_sanskrit": "क्रुद्धस्तु फल्गुनः सङ्ख्ये द्विगुणीकृतविक्रमः।\nगाण्डीवं धनुरामृज्य तूर्णं जग्राह संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2049759, "chapter_id": 2092, "verse_number": "७-१९-१०", "content_sanskrit": "बद्ध्वा च भ्रुकुटिं वक्त्रे क्रोधस्य प्रतिलक्षणम्।\nदेवदत्तं महाशङ्खं पूरयामास पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2049760, "chapter_id": 2092, "verse_number": "७-१९-११", "content_sanskrit": "अथास्त्रमरिसङ्घघ्नं त्वाष्ट्रमभ्यस्यदर्जुनः।\nततो रूपसहस्राणि प्रादुरासन्पृथक्पृथक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2049761, "chapter_id": 2092, "verse_number": "७-१९-१२", "content_sanskrit": "अर्जुनप्रतिरूपैस्तैर्नानारूपैर्विमोहिताः।\nअन्योन्येनार्जुनं मत्वा स्वमात्मानं च जघ्निरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2049762, "chapter_id": 2092, "verse_number": "७-१९-१३", "content_sanskrit": "अयमर्जुनोऽयं गोविन्द इमौ पाण्डवयादवौ।\nइति ब्रुवाणाः संमूढा जघ्नुरन्योन्यमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2049763, "chapter_id": 2092, "verse_number": "७-१९-१४", "content_sanskrit": "`अन्योन्यं समरे जघ्नुस्तावका भरतर्षभ।\nमोहिताः परमास्त्रेण क्षयं जग्मुः परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2049764, "chapter_id": 2092, "verse_number": "७-१९-१५", "content_sanskrit": "`रुधिरोक्षितगात्रास्ते प्रेक्षमाणः परस्परम्।\nअशोभन्त रणे योधाः पुष्पिता इव किंशुकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2049765, "chapter_id": 2092, "verse_number": "७-१९-१६", "content_sanskrit": "`रुधिरोत्पीडनास्ते तु रुधिरेण समुक्षिताः।\nचन्दनस्य रसेनेव व्यभ्राजन्त रणाजिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2049766, "chapter_id": 2092, "verse_number": "७-१९-१७", "content_sanskrit": "ततः प्रसह्य बीभत्सुर्व्याक्षिपद्गाण्डिवं धनुः।\nन्यहनत्ताञ्छरैस्तीक्ष्णैस्तमः सूर्य इवांशुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2049767, "chapter_id": 2092, "verse_number": "७-१९-१८", "content_sanskrit": "हतावशिष्टास्ते भूयः परिवार्य धनञ्जयम्।\nसाश्वध्वजरथं चक्रुरदृश्यं शरवृष्टिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2049768, "chapter_id": 2092, "verse_number": "७-१९-१९", "content_sanskrit": "ततः शरसहस्राणि तैर्विमुक्तानि भस्मसात्।\nकृत्वा तदस्त्रं तान्वीराननयद्यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2049769, "chapter_id": 2092, "verse_number": "७-१९-२०", "content_sanskrit": "अथ प्रहस्य बीभत्सुर्ललित्थान्मालवानपि।\nमावेल्लकांस्त्रिगर्तांश्च यौधेयांश्चार्दयच्छरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2049770, "chapter_id": 2092, "verse_number": "७-१९-२१", "content_sanskrit": "ते हन्यमाना वीरेण क्षत्रियाः कालचोदिताः।\nव्यसृजञ्छरजालानि पार्थे नानाविधानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2049771, "chapter_id": 2092, "verse_number": "७-१९-२२", "content_sanskrit": "न ध्वजो नार्जुनस्तत्र न रथो न च केशवः।\nप्रत्यदृश्यत घोरेण शरवर्षेण संवृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2049772, "chapter_id": 2092, "verse_number": "७-१९-२३", "content_sanskrit": "ततस्ते लब्धलक्षत्वादन्योन्यमभिचुक्रुशुः।\nहतौ कृष्णाविति प्रीत्या वासांस्यादुधुवुस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2049773, "chapter_id": 2092, "verse_number": "७-१९-२४", "content_sanskrit": "भेरीमृदङ्गशङ्खांश्च दध्मुर्वीराः सहस्रशः।\nसिंहनादरवांश्चोग्रांश्चक्रिरे तत्र मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2049774, "chapter_id": 2092, "verse_number": "७-१९-२५", "content_sanskrit": "ततः प्रसिष्विदे कृष्णः खिन्नश्चार्जुनमब्रवीत्।\nक्वासि पार्थ न पश्यामि कच्चिज्जीवसि शत्रुहन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2049775, "chapter_id": 2092, "verse_number": "७-१९-२६", "content_sanskrit": "तस्य तद्भाषितं श्रुत्वा त्वरमाणो धनञ्जयः।\nवायव्यास्त्रेण तैरस्तां शरवृष्टिमपाहरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2049776, "chapter_id": 2092, "verse_number": "७-१९-२७", "content_sanskrit": "ततः संशप्तकव्रातान्साश्वद्विपरथायुधान्।\nउवाह भगवान्वायुः शुष्कपर्मचयानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2049777, "chapter_id": 2092, "verse_number": "७-१९-२८", "content_sanskrit": "उह्यमानास्तु ते राजन्बह्वशोभन्त वायुना।\nप्रडीनाः पक्षिणः काले वृक्षेभ्य इव मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2049778, "chapter_id": 2092, "verse_number": "७-१९-२९", "content_sanskrit": "तांस्तथा व्याकुलीकृत्य त्वरमाणो धनञ्जयः।\nजघान निशितैर्बाणैः सहस्राणि शतानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2049779, "chapter_id": 2092, "verse_number": "७-१९-३०", "content_sanskrit": "शिरांसि भल्लैरहरद्बाहूनपि च सायुधान्।\nहस्तिहस्तोपमांश्चोरूञ्शरैरुर्व्यामपातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2049780, "chapter_id": 2092, "verse_number": "७-१९-३१", "content_sanskrit": "पृष्ठच्छिन्नान्विचरणान्विमस्तकदृगङ्गुलीन्।\nनानाङ्गावयवैर्हीनांश्चकारारीन्धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2049781, "chapter_id": 2092, "verse_number": "७-१९-३२", "content_sanskrit": "गन्धर्वनगराकारान्विधिवत्कल्पितान्रथान्।\nशरैर्विशकलीकुर्वंश्चक्रे व्यश्वरथद्विपान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2049782, "chapter_id": 2092, "verse_number": "७-१९-३३", "content_sanskrit": "मुण्डतालवनानीव तत्रतत्र चकाशिरे।\nछिन्ना रथध्वजव्राताः केचित्तत्र क्वचित्क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2049783, "chapter_id": 2092, "verse_number": "७-१९-३४", "content_sanskrit": "सोत्तरायुधिनो नागाः सपताकाङ्कुशध्वजाः।\nपेतुः शक्राशनिहता द्रुमवन्त इवाचलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2049784, "chapter_id": 2092, "verse_number": "७-१९-३५", "content_sanskrit": "चामरापीडकवचाः स्रस्तान्त्रनयनास्तथा।\nसारोहास्तुरगाः पेतुः पार्तबाणहताः क्षितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2049785, "chapter_id": 2092, "verse_number": "७-१९-३६", "content_sanskrit": "विप्रविद्धासिनाराचाश्छिन्नवर्मर्ष्टिशक्तयः।\nपत्तयश्चिन्नवर्माणः कृपणाः शेरते हताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2049786, "chapter_id": 2092, "verse_number": "७-१९-३७", "content_sanskrit": "तैर्हतैर्हन्यमानैश्च पतद्भिः पतितैरपि।\nभ्रमद्भिर्निष्टनद्भिश्च क्रूरमायोधनं बभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2049787, "chapter_id": 2092, "verse_number": "७-१९-३८", "content_sanskrit": "रजश्च चाप्यभवद्दुर्गा कबन्धशतसङ्कुला॥\nतद्बभौ रौद्रबीभत्सं बीभत्सोर्यानमाहवे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2049788, "chapter_id": 2092, "verse_number": "७-१९-३९", "content_sanskrit": "आक्रीडमिव रुद्रस्य घ्नतः कालात्यये पशून्॥\nकते वध्यमानाः पार्थेन व्याकुलाश्वरथद्विपाः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2049789, "chapter_id": 2092, "verse_number": "७-१९-४०", "content_sanskrit": "तमेवाभिमुखाः क्षीणाः शक्रस्यातिथितां गताः॥\nसा भूमीर्भरतश्रेष्ठ निहतैस्तैर्महारथैः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2049790, "chapter_id": 2092, "verse_number": "७-१९-४१", "content_sanskrit": "आस्तीर्णा सम्बभौ सर्वा प्रेतीभूतैः समन्ततः॥\nएतस्मिन्नन्तरे चैव प्रमत्ते सव्यसाचिनि।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2049791, "chapter_id": 2092, "verse_number": "७-१९-४२", "content_sanskrit": "व्यूढानीकस्ततो द्रोणो युधिष्ठिरमुपाद्रवत्॥\nतं प्रत्यगृह्णंस्त्वरिता व्यूढानीकाः प्रहारिणः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2049792, "chapter_id": 2092, "verse_number": "७-१९-४३", "content_sanskrit": "युधिष्ठिरं परीप्सन्तस्तदासीत्तुमुलं महत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2049793, "chapter_id": 2092, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि संशप्तकवधपर्वणि द्वादशदिवसयुद्धे एकोनविंशोऽध्यायः॥ १९ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१९-३४ सोत्तरायुधिनः उपरिगतैर्योधैः सहिताः॥ ५-१९-१९ एकोनविंशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]