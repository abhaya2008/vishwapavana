[{"id": 2086226, "chapter_id": 2834, "verse_number": "१२-३३९-०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2086227, "chapter_id": 2834, "verse_number": "१२-३३९-१", "content_sanskrit": "सुखदुःखविपर्यासो यदा समनुपद्यते।\nनैनं प्रज्ञा सुनीतं वा त्रायते नापि पौरुषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2086228, "chapter_id": 2834, "verse_number": "१२-३३९-२", "content_sanskrit": "स्वभावाद्यत्नमातिष्ठेद्यत्नवान्नावसीदति।\nजरामरणरोगेभ्यः प्रियमात्मानमुद्धरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2086229, "chapter_id": 2834, "verse_number": "१२-३३९-३", "content_sanskrit": "रुजन्ति हि शरीराणि रोगाः शारीरमानसाः।\nसायका इव तीक्ष्णाग्राः प्रयुक्ता दृढधन्विभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2086230, "chapter_id": 2834, "verse_number": "१२-३३९-४", "content_sanskrit": "व्यथितस्य विधित्साभिस्त्रस्यतो जीवितैषिणः।\nअवशस्य विनाशाय शरीरमपकृष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2086231, "chapter_id": 2834, "verse_number": "१२-३३९-५", "content_sanskrit": "स्रवन्ति न निवर्तन्ते स्रोतांसि सरितामिव।\nआयुरादाय मर्त्यानां रात्र्यहानि पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2086232, "chapter_id": 2834, "verse_number": "१२-३३९-६", "content_sanskrit": "व्यत्ययो ह्ययमत्यन्तं पक्षयोः शुक्लकृष्णयोः।\nजातान्मर्त्याञ्जरयति निमेषान्नावतिष्ठते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2086233, "chapter_id": 2834, "verse_number": "१२-३३९-७", "content_sanskrit": "सुखदुःखानि भूतानामजरो जरयत्यसौ।\nआदित्यो ह्यस्तमभ्येति पुनः पुनरुदेति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2086234, "chapter_id": 2834, "verse_number": "१२-३३९-८", "content_sanskrit": "अदृष्टपूर्वानादाय भावानपरिशङ्कितान्।\nइष्टानिष्टान्मनुष्याणामस्तं गच्छन्ति रात्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2086235, "chapter_id": 2834, "verse_number": "१२-३३९-९", "content_sanskrit": "योयदिच्छेद्यथाकाममयत्नाच्च तदाप्नुयात्।\nयदि स्यान्न पराधीनं पुरुषस्य क्रियाफलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2086236, "chapter_id": 2834, "verse_number": "१२-३३९-१०", "content_sanskrit": "संयताश्च हि दक्षाश्च मतिमन्तश्च मानवाः।\nदृश्यन्ते निष्फलाः सन्तः प्रहीणाः सर्वकर्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2086237, "chapter_id": 2834, "verse_number": "१२-३३९-११", "content_sanskrit": "अपरे बालिशाः सन्तो निर्गुणाः पुरुषाधमाः।\nअशुभैरपि संयुक्ता दृश्यन्ते सर्वकामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2086238, "chapter_id": 2834, "verse_number": "१२-३३९-१२", "content_sanskrit": "भूतानामपरः कश्चिद्धिंसायां सततोत्थितः।\nवञ्चनायां च लोकस्य स सुखेष्वेव जीर्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2086239, "chapter_id": 2834, "verse_number": "१२-३३९-१३", "content_sanskrit": "अचेष्टमानमासीनं श्रीः कंचिदुपतिष्ठते।\nकश्चित्कर्मानुसृत्यान्यो नाप्राप्यमधिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2086240, "chapter_id": 2834, "verse_number": "१२-३३९-१४", "content_sanskrit": "अपराधं समाचक्ष्व पुरुषस्य स्वभावतः।\nशुक्रमन्यत्र संभूतं पुनरन्यत्र गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2086241, "chapter_id": 2834, "verse_number": "१२-३३९-१५", "content_sanskrit": "तस्य योनौ प्रसक्तस्य गर्भो भवति वा न वा।\nआम्रपुष्पोपमा यस्य निर्वृत्तिरुपलभ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2086242, "chapter_id": 2834, "verse_number": "१२-३३९-१६", "content_sanskrit": "केषांचित्पुत्रकामानामनुसन्तानमिच्छताम्।\nसिद्धौ प्रयतमानानां न चाण्डमुपजायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2086243, "chapter_id": 2834, "verse_number": "१२-३३९-१७", "content_sanskrit": "गर्भाच्चोद्विजमानानां क्रुद्धादाशीविषादिव।\nआयुष्माञ्जायते पुत्रः कथं प्रेतः पितेव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2086244, "chapter_id": 2834, "verse_number": "१२-३३९-१८", "content_sanskrit": "देवानिष्ट्वा तपस्तप्त्वा कृपणैः पुत्रगृद्धिभिः।\nदश मासान्परिधृता जायन्ते कुलपांसनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2086245, "chapter_id": 2834, "verse_number": "१२-३३९-१९", "content_sanskrit": "अपरे धनधान्यानि भोगांश्च पितृसंचितान्।\nविपुलानभिजायन्ते लब्धास्तैरेव मङ्गलैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2086246, "chapter_id": 2834, "verse_number": "१२-३३९-२०", "content_sanskrit": "अन्योन्यं समभिप्रेत्य मैथुनस्य समागमे।\nउपद्रव इवाविष्टो योनिं गर्भः प्रपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2086247, "chapter_id": 2834, "verse_number": "१२-३३९-२१", "content_sanskrit": "शीर्णं परशरीराणि च्छिन्नबीजं शरीरिणम्।\nप्राणिनं प्राणंसरोधे मांसश्लेष्मविचेष्टितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2086248, "chapter_id": 2834, "verse_number": "१२-३३९-२२", "content_sanskrit": "निर्दग्धं परदेहेऽपि परदेहं चलाचलम्।\nविनश्यन्तं विनाशान्ते भावि नावमिवाहितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2086249, "chapter_id": 2834, "verse_number": "१२-३३९-२३", "content_sanskrit": "सङ्गत्या जठरे न्यस्तं रेतोबिन्दुमचेतनम्।\nकेन यत्नेन जीवन्तं गर्भं त्वमिह पश्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2086250, "chapter_id": 2834, "verse_number": "१२-३३९-२४", "content_sanskrit": "अन्नपानानि जीर्यन्ते यत्र भक्षाश्च भक्षिताः।\nतस्मिन्नेवोदरे गर्भः किं नान्नमिव जीर्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2086251, "chapter_id": 2834, "verse_number": "१२-३३९-२५", "content_sanskrit": "गर्भे मूत्रपुरीषाणां स्वभावनियता गतिः।\nधारणे वा विसर्गे वा न कर्ता विद्यतेऽवशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2086252, "chapter_id": 2834, "verse_number": "१२-३३९-२६", "content_sanskrit": "स्रवन्ति ह्युदराद्गर्भा जायमानास्तथा परे।\nआगमेन तथाऽन्येषां विनाश उपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2086253, "chapter_id": 2834, "verse_number": "१२-३३९-२७", "content_sanskrit": "एतस्माद्योनिसंबन्धाद्यो जीवः परिमुच्यते।\nप्रजां च लभते कांचित्पुनर्द्वन्द्वेषु सज्जति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2086254, "chapter_id": 2834, "verse_number": "१२-३३९-२८", "content_sanskrit": "स तस्य सहजातस्य सप्तमीं नवमीं दशाम्।\nप्राप्नुवन्ति ततः पञ्च न भवन्ति शतायुषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2086255, "chapter_id": 2834, "verse_number": "१२-३३९-२९", "content_sanskrit": "नाभ्युत्थाने मनुष्याणां योगाः स्युर्नात्र संशयः॥\nव्याधिभिश्च विमथ्यन्ते व्याधैः क्षुद्रमृगा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2086256, "chapter_id": 2834, "verse_number": "१२-३३९-३०", "content_sanskrit": "व्याधिभिर्भक्ष्यमाणानां त्यजतां विपुलं धनम्।\nवेदनां नापकर्षन्ति यतमानाश्चिकित्सकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2086257, "chapter_id": 2834, "verse_number": "१२-३३९-३१", "content_sanskrit": "ते चापि निपुणा वैद्याः कुशलाः संभृतौषधाः।\nव्याधिभिः परिकृष्यन्ते मृगा व्याधैरिवार्दिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2086258, "chapter_id": 2834, "verse_number": "१२-३३९-३२", "content_sanskrit": "ते पिबन्तः कषायांश्च सर्पीषि विविधानि च।\nदृश्यन्ते जरया भग्ना नगा नागैरिवोत्तमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2086259, "chapter_id": 2834, "verse_number": "१२-३३९-३३", "content_sanskrit": "के वा भुवि चिकित्सन्ते रोगार्तान्मृगपक्षिणः।\nश्वापदानि दरिद्रांश्च प्रायो नार्ता भवन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2086260, "chapter_id": 2834, "verse_number": "१२-३३९-३४", "content_sanskrit": "पौरानपि दुराधर्षान्नृपतीनुग्रतेजसः।\nआक्रम्य खादन्ते रोगाः पशून्पशुपचा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2086261, "chapter_id": 2834, "verse_number": "१२-३३९-३५", "content_sanskrit": "इति लोकमनाक्रन्दं मोहशोकपरिप्लुतम्।\nस्रोतसा सहसा क्षिप्तं ह्रियमाणं बलीयसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2086262, "chapter_id": 2834, "verse_number": "१२-३३९-३६", "content_sanskrit": "न धनेन न राज्येन नोग्रेण तपसा तथा।\nस्वभावमतिवर्तन्ते ये नियुक्ताः शरीरिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2086263, "chapter_id": 2834, "verse_number": "१२-३३९-३७", "content_sanskrit": "न म्रियेरन्न जीर्येरन्सर्वे स्युः सर्वकामिनः।\nनाप्रियं प्रतिपश्येयुरुत्थानस्य फले सति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2086264, "chapter_id": 2834, "verse_number": "१२-३३९-३८", "content_sanskrit": "उपर्युपरि लोकस्य सर्वो भवितुमीहते।\nयतते च यथाशक्ति न च तद्वर्तते तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2086265, "chapter_id": 2834, "verse_number": "१२-३३९-३९", "content_sanskrit": "ऐश्वर्यमदमत्तांश्च मत्तान्मद्यमदेन च।\nअप्रमत्ताश्च शूराश्च विक्रान्ताः पर्युपासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2086266, "chapter_id": 2834, "verse_number": "१२-३३९-४०", "content_sanskrit": "क्लेशाः प्रतिनिवर्तन्ते केषांचिदसमीक्षिताः।\nस्वंस्वं न पुनरन्येषां न किंचिदधिगम्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2086267, "chapter_id": 2834, "verse_number": "१२-३३९-४१", "content_sanskrit": "महच्च फलवैपम्यं दृश्यते कर्मसिद्धिषु।\nवहन्ति शिविकामन्ये यान्त्यन्ये शिविकागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2086268, "chapter_id": 2834, "verse_number": "१२-३३९-४२", "content_sanskrit": "सर्वेषामृद्धिकामानामन्ये रथपुरःसराः।\nमनुजाश्च गतस्त्रीकाः शतशो विविधाः स्त्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2086269, "chapter_id": 2834, "verse_number": "१२-३३९-४३", "content_sanskrit": "द्वन्द्वारामेषु भूतेषु गच्छन्त्येकैकशो नराः।\nइदमन्यत्परं पश्य माऽत्र मोहं करिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2086270, "chapter_id": 2834, "verse_number": "१२-३३९-४४", "content_sanskrit": "त्यज धर्ममधर्मं च उभे सत्यानृते त्यज।\nउभे सत्यानृते त्यक्त्वा येन त्यजसि तं त्यज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2086271, "chapter_id": 2834, "verse_number": "१२-३३९-४५", "content_sanskrit": "एतत्ते परमं गुह्यमाख्यातमृषिसत्तम।\nयेन देवाः परित्यज्य मर्त्यलोकं दिवं गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2086272, "chapter_id": 2834, "verse_number": "१२-३३९-४६", "content_sanskrit": "नारदस्य वचः श्रुत्वा शुकः परमबुद्धिमान्।\nसंचिन्त्य मनसा धीरो निश्चयं नाध्यगच्छत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2086273, "chapter_id": 2834, "verse_number": "१२-३३९-४७", "content_sanskrit": "पुत्रदारैर्महान्क्लेशो विद्याम्नाये महाञ्छ्रमः।\nकिंनु स्याच्छाश्वतं स्थानमल्पक्लेशं महोदयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2086274, "chapter_id": 2834, "verse_number": "१२-३३९-४८", "content_sanskrit": "ततो मुहूर्तं संचिन्त्य निश्चितां गतिमात्मनः।\nपरावरज्ञो धर्मस्य परां नैःश्रेयसीं गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2086275, "chapter_id": 2834, "verse_number": "१२-३३९-४९", "content_sanskrit": "कथं त्वहमसंश्लिष्टो गच्छेयं गतिमुत्तमाम्।\nनावर्तेयं यथा भूयो योनिसंसारसागरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2086276, "chapter_id": 2834, "verse_number": "१२-३३९-५०", "content_sanskrit": "परं भावं हि काङ्क्षामि यत्र नावर्तते पुनः।\nसर्वसङ्गान्परित्यज्य निश्चितो मनसा गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2086277, "chapter_id": 2834, "verse_number": "१२-३३९-५१", "content_sanskrit": "तत्र यास्यामि यत्रात्मा शर्म मेऽधिगमिष्यति।\nअक्षयश्चाव्ययश्चैव यत्र स्थास्यामि शाश्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2086278, "chapter_id": 2834, "verse_number": "१२-३३९-५२", "content_sanskrit": "न तु योगमृते शक्त्या प्राप्नुयां परमां गतिम्।\nअनुबन्धो विमुक्तस्य कर्मभिर्नोपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2086279, "chapter_id": 2834, "verse_number": "१२-३३९-५३", "content_sanskrit": "यस्माद्योगं समास्थाय त्यक्त्वा गृहकलेवरम्।\nवायुभूतः प्रवेक्ष्यामि तेजोराशिं दिवाकरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2086280, "chapter_id": 2834, "verse_number": "१२-३३९-५४", "content_sanskrit": "न ह्येप क्षयतां याति सोमः सुरगणैर्यथा।\nकम्पितः पतते भूमिं पुनश्चैवाधिरोहति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2086281, "chapter_id": 2834, "verse_number": "१२-३३९-५५", "content_sanskrit": "क्षीयते हि सदा सोमः पुनश्चैवाभिपूर्यते।\nनेच्छाम्येवं विदित्वैते ह्रासवृद्धी पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2086282, "chapter_id": 2834, "verse_number": "१२-३३९-५६", "content_sanskrit": "रविस्तु संतापयते लोकान्रश्मिभिरुल्बणैः।\nसर्वतस्तेज आदत्ते नित्यमक्षयमण्डलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2086283, "chapter_id": 2834, "verse_number": "१२-३३९-५७", "content_sanskrit": "अतो मे रोचते गन्तुमादित्यं दीप्ततेजसम्।\nअत्र वत्स्यामि दुर्धर्षो निःसङ्गेनान्तरात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2086284, "chapter_id": 2834, "verse_number": "१२-३३९-५८", "content_sanskrit": "सूर्यस्यर सदने चाहं निक्षिप्येदं कलेवरम्।\nऋषिभिः सह वत्स्यामि सौरं तेजोऽतिदुःसहं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2086285, "chapter_id": 2834, "verse_number": "१२-३३९-५९", "content_sanskrit": "आपृच्छामि नगान्नागान्गिरीनुर्वी दिशो दश।\nदेवदानवगन्धर्वान्पिशाचोरगराक्षसान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2086286, "chapter_id": 2834, "verse_number": "१२-३३९-६०", "content_sanskrit": "लोकेषु सर्वभूतानि प्रवेक्ष्यामि न संशयः।\nपश्यन्तु योगवीर्यं मे सर्वे देवाः सहर्षिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2086287, "chapter_id": 2834, "verse_number": "१२-३३९-६१", "content_sanskrit": "अथानुज्ञाप्य तमृषिं नारदं लोकविश्रुतम्।\nतस्मादनुज्ञां संप्राप्य जगाम पितरं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2086288, "chapter_id": 2834, "verse_number": "१२-३३९-६२", "content_sanskrit": "सोऽभिवाद्य महात्मानं कृष्णद्वैपायनं मुनिम्।\nशुकः प्रदक्षिणं कृत्वा कृष्णमापृष्टवान्मुनिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2086289, "chapter_id": 2834, "verse_number": "१२-३३९-६३", "content_sanskrit": "श्रुत्वा चर्षिस्तद्वचनं शुकस्य\nप्रीतो महात्मा पुनराह चैनम्।\nभोभो पुत्र स्थीयतां तावदद्य\nयावच्चक्षुः प्रीणयामि त्वदर्थे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2086290, "chapter_id": 2834, "verse_number": "१२-३३९-६४", "content_sanskrit": "निरपेक्षः शुको भूत्वा निःस्नेहो मुक्तसंशयः।\nमोक्षमेवानुसंचिन्त्य गमनाय मनो दधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2086291, "chapter_id": 2834, "verse_number": "१२-३३९-६५", "content_sanskrit": "पितरं स परित्यज्य जगाम मुनिसत्तमः।\nकैलासपृष्ठं विपुलं सिद्धसङ्घनिषेवितम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2086292, "chapter_id": 2834, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि एकोनचत्वारिंशदधिकत्रिशततमोऽध्यायः॥ ३३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}]