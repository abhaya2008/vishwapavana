[{"id": 2027185, "chapter_id": 1583, "verse_number": "३-२२१-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2027186, "chapter_id": 1583, "verse_number": "३-२२१-१", "content_sanskrit": "ब्रह्मणो यस्तृतीयस्तु पुत्रः कुरुकुलोद्वह।\nतस्यापि वसुदाभार्या प्रजास्तस्यां च मे शृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2027187, "chapter_id": 1583, "verse_number": "३-२२१-२", "content_sanskrit": "बृहत्कीर्तिर्बृहज्ज्योतिर्बृहद्ब्रह्मा बृहन्मनाः।\nबृहन्मन्त्रो बृहद्भासस्तथा राजन्बृहस्पतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2027188, "chapter_id": 1583, "verse_number": "३-२२१-३", "content_sanskrit": "प्रजासु तासु सर्वासु रूपेणाप्रतिमाऽभवत्।\nदेवी भानुमती नाम प्रथमाऽङ्गिरसः सुता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2027189, "chapter_id": 1583, "verse_number": "३-२२१-४", "content_sanskrit": "भूतानामेव सर्वेषां यस्यां रागस्तदाऽभवत्।\nरागाद्रागेति यामाहुर्द्वितीयाऽङ्गिरसः सुता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2027190, "chapter_id": 1583, "verse_number": "३-२२१-५", "content_sanskrit": "यां कपर्दिसुतामाहुर्दृश्यादृश्येति देहिनः।\nतनुत्वात्सा सिनीवाली तुतीयाऽङ्गिरसः सुता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2027191, "chapter_id": 1583, "verse_number": "३-२२१-६", "content_sanskrit": "यां तु दृष्ट्वा भगवतीं जनः कुहकुहायते।\nएकानकेति यामाहुश्चतुर्थ्यङ्गिरसः सुता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2027192, "chapter_id": 1583, "verse_number": "३-२२१-७", "content_sanskrit": "पञ्चम्यर्चिष्मती नाम्ना हविर्भिश्च हविष्मती।\nषष्ठीम्गिरसः कन्यां पुण्यामाहुर्महिष्मतीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2027193, "chapter_id": 1583, "verse_number": "३-२२१-८", "content_sanskrit": "महामखेष्वाङ्गिरसी दीप्तिमत्सु महीयती।\nमहामतीति विख्याता सप्तमी कथ्यते सुता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2027194, "chapter_id": 1583, "verse_number": "३-२२१-९", "content_sanskrit": "बृहस्पतेश्चान्द्रमसी भार्याऽऽसीद्या यशस्विनी।\nअग्नीन्साऽजनयत्पुण्यान्षडेकां चापि पुत्रिकाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2027195, "chapter_id": 1583, "verse_number": "३-२२१-१०", "content_sanskrit": "आहुतिष्वेव यस्याग्नेर्हविराज्यं विधीयते।\nसोग्निर्बृहस्पतेः पुत्र शंयुर्नाम महाप्रभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2027196, "chapter_id": 1583, "verse_number": "३-२२१-११", "content_sanskrit": "चातुर्मास्येषु यस्येष्टमश्वमेधाग्रभागभूत्।\nदीप्तिज्वालैरनेकाग्रैरग्निष्टोमोऽथ वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2027197, "chapter_id": 1583, "verse_number": "३-२२१-१२", "content_sanskrit": "शंयोरप्रतिमा भार्या सत्या सत्याऽथ धर्मजा।\nअग्नितस्य सुतो दीप्तस्तिस्रः कन्याश्च सुव्रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2027198, "chapter_id": 1583, "verse_number": "३-२२१-१३", "content_sanskrit": "प्रथमेनाज्यभागेन पूज्यते योऽग्निरध्वरे।\nअग्निस्तस्य भरद्वाजः प्रथमः पुत्र उच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2027199, "chapter_id": 1583, "verse_number": "३-२२१-१४", "content_sanskrit": "पौर्णमासेषु सर्वेषु हविराज्यं ध्रुवोद्यतम्।\nभरतो नामतः सोग्निर्द्वितीयः शंयुतः सुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2027200, "chapter_id": 1583, "verse_number": "३-२२१-१५", "content_sanskrit": "तिस्रः कन्या भवन्त्यन्या यासां स भरत पतिः।\nभारतस्तु सुतस्तस्य भारत्येका च पुत्रिका ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2027201, "chapter_id": 1583, "verse_number": "३-२२१-१६", "content_sanskrit": "भारतो भरतस्याग्नेः पावकस्तु प्रजायते।\nमहानत्यर्थमहितस्तथा भरतसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2027202, "chapter_id": 1583, "verse_number": "३-२२१-१७", "content_sanskrit": "भरद्वाजस्य भार्या तु वीरा वीरश्च पिण्डदः।\nप्राहुराज्येन तस्येज्यां सोमस्येव द्विजाः शनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2027203, "chapter_id": 1583, "verse_number": "३-२२१-१८", "content_sanskrit": "हविषा यो द्वितीयेन सोमेन सह युज्यते।\nरथप्रभू रथध्वानः कुम्भरेताः स उच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2027204, "chapter_id": 1583, "verse_number": "३-२२१-१९", "content_sanskrit": "सरय्वां जनयत्सिद्धिं भानुं भाभिः समावृणोत्।\nआग्नेयमनयन्मिथ्यं मिथ्यो नामैव कथ्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2027205, "chapter_id": 1583, "verse_number": "३-२२१-२०", "content_sanskrit": "यस्तु न च्यवते नित्यं शयसा वर्चसा श्रिया।\nअग्निर्निश्च्यवनो नाम पृथिवीं स्तौति केवलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2027206, "chapter_id": 1583, "verse_number": "३-२२१-२१", "content_sanskrit": "विपाप्मा कलुषैर्मुक्तो विशुद्धश्चार्चिषा ज्वलन्।\nविपापोऽग्निः सुतस्तस्य योज्यः समयकर्मसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2027207, "chapter_id": 1583, "verse_number": "३-२२१-२२", "content_sanskrit": "अक्रोशतां हि भूतानां यः करोति हि निष्कृतिम्।\nअग्निः स निष्कृतिर्नाम शोभयत्यभिसेवितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2027208, "chapter_id": 1583, "verse_number": "३-२२१-२३", "content_sanskrit": "अनुकूजन्ति येनेह वेदनार्ताः स्वयं जनाः।\nतस्य पुत्रः स्वनो नाम पावकः सरुजस्करः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2027209, "chapter_id": 1583, "verse_number": "३-२२१-२४", "content_sanskrit": "यस्तु विश्वस् जगतो बुद्धिमाक्रम्य तिष्ठति।\nतं प्राहुरध्यात्मविदो विश्वजिन्नाम पावकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2027210, "chapter_id": 1583, "verse_number": "३-२२१-२५", "content_sanskrit": "अन्तराग्निः स्मृतो यस्तु भुक्तं पचति देहिनाम्।\nस यज्ञे विश्वभुङ्वाम सर्वलोकेषु भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2027211, "chapter_id": 1583, "verse_number": "३-२२१-२६", "content_sanskrit": "ब्रह्मचारी यतात्मा च सततं विपुलप्रभः।\nब्राह्मणाः पूजयन्त्येनं पाकयज्ञेषु पावकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2027212, "chapter_id": 1583, "verse_number": "३-२२१-२७", "content_sanskrit": "प्रथितो गोपतिर्नाम नदी यस्याभवत्प्रिया।\nतस्मिन्कर्माणि सर्वाणि क्रियन्ते धर्मकर्तृभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2027213, "chapter_id": 1583, "verse_number": "३-२२१-२८", "content_sanskrit": "बडबाग्निः पिबत्यम्भो योसौ परमदारुणः।\nऊर्द्वभागूर्ध्वभाङ्नाम कविः प्राणाश्रितस्तु यः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2027214, "chapter_id": 1583, "verse_number": "३-२२१-२९", "content_sanskrit": "उदग्द्वारं हविर्यस्य गृहे नित्यं प्रदीयते।\nततस्तुष्टो भवेद्ब्रह्मा स्विष्टकृत्परमः स्मृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2027215, "chapter_id": 1583, "verse_number": "३-२२१-३०", "content_sanskrit": "यः प्रशान्तेषु भूतेषु आविर्भवति पावकः।\nक्रोधस्य तु रसो जज्ञे मन्यती चाथ पुत्रिका ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2027216, "chapter_id": 1583, "verse_number": "३-२२१-३१", "content_sanskrit": "स्वाहेति दारुणा क्रूरा सर्वभूतेषु तिष्ठति।\nत्रिदिवे यस्य सदृशो नास्ति रूपेण कश्चन।\nअतुलत्वात्कृतो देवैर्नाम्ना कामस्तु पावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2027217, "chapter_id": 1583, "verse_number": "३-२२१-३२", "content_sanskrit": "संहर्षाद्धारयन्क्रोधं धन्वी स्रग्वी रथे स्थितः।\nसमरे नाशयेच्छत्रूनमोघो नाम पावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2027218, "chapter_id": 1583, "verse_number": "३-२२१-३३", "content_sanskrit": "उक्थ्यो नाम महाभाग त्रिभिरुक्थैरभिष्टुतः।\nमहावर्षं त्वजनयत्सकामाश्वं हि यं विदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2027219, "chapter_id": 1583, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि मार्कण्डेयसमास्यापर्वणि एकविंसत्यधिकद्विशततमोऽध्यायः ॥ २२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]