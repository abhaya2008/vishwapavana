[{"id": 5000625000, "chapter_id": 9625, "verse_number": "७-९०-१", "content_sanskrit": "तथोक्तवति रामे तु तस्य जन्म तदद्भुतम् ।\nउवाच लक्ष्मणो भूयो भरतश्च महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000625001, "chapter_id": 9625, "verse_number": "७-९०-२", "content_sanskrit": "इला सा सोमपुत्रस्य संवत्सरमथोषिता ।\nअकरोत्किं नरश्रेष्ठ तत्त्वं शंसितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000625002, "chapter_id": 9625, "verse_number": "७-९०-३", "content_sanskrit": "तयोस्तद्वाक्यमाधुर्यं निशम्य परिपृच्छतोः ।\nरामः पुनरुवाचेमां प्रजापतिसुते कथाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000625003, "chapter_id": 9625, "verse_number": "७-९०-४", "content_sanskrit": "पुरुषत्वं गते शूरे बुधः परमबुद्धिमान् ।\nसंवर्तं परमोदारमाजुहाव महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000625004, "chapter_id": 9625, "verse_number": "७-९०-५", "content_sanskrit": "च्यवनं भृगुपुत्रं च मुनिं चारिष्टनेमिनम् ।\nप्रमोदनं मोदकरं ततो दुर्वाससं मुनिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000625005, "chapter_id": 9625, "verse_number": "७-९०-६", "content_sanskrit": "एतान्सर्वान्समानीय वाक्यज्ञस्तत्त्वदर्शनः ।\nउवाच सर्वान्सुहृदो धैर्येण सुसमाहितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000625006, "chapter_id": 9625, "verse_number": "७-९०-७", "content_sanskrit": "अयं राजा महाबाहुः कर्दमस्य इलः सुतः ।\nजानीतैनं यथाभूतं श्रेयो ह्यत्र विधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000625007, "chapter_id": 9625, "verse_number": "७-९०-८", "content_sanskrit": "तेषां संवदतामेव तमाश्रममुपागमत् ।\nकर्दमस्तु महातेजा द्विजैः सह महात्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000625008, "chapter_id": 9625, "verse_number": "७-९०-९", "content_sanskrit": "पुलस्त्यश्च क्रतुश्चैव वषट्कारस्तथैव च ।\nओङ्कारश्च महातेजास्तमाश्रममुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000625009, "chapter_id": 9625, "verse_number": "७-९०-१०", "content_sanskrit": "ते सर्वे हृष्टमनसः परस्परसमागमे ।\nहितैषिणो बाल्हिपतेः पृथग्वाक्यान्यथाब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000625010, "chapter_id": 9625, "verse_number": "७-९०-११", "content_sanskrit": "कर्दमस्त्वब्रवीद्वाक्यं सुतार्थं परमं हितम् ।\nद्विजाः शृणुत मद्वाक्यं यच्छ्रेयः पार्थिवस्य हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000625011, "chapter_id": 9625, "verse_number": "७-९०-१२", "content_sanskrit": "नान्यं पश्यामि भैषज्यमन्तरा वृषभध्वजम् ।\nनाश्वमेधात्परो यज्ञः प्रियश्चैव महात्मनः ।\nतस्माद्यजामहे सर्वे पार्थिवार्थे दुरासदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000625012, "chapter_id": 9625, "verse_number": "७-९०-१३", "content_sanskrit": "कर्दमेनैवमुक्तास्तु सर्व एव द्विजर्षभाः ।\nरोचयन्ति स्म तं यज्ञं रुद्रस्याराधनं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000625013, "chapter_id": 9625, "verse_number": "७-९०-१४", "content_sanskrit": "संवर्तस्य तु राजर्षेः शिष्यः पुरपुरञ्जयः ।\nमरुत्त इति विख्यातस्तं यज्ञं समुपाहरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000625014, "chapter_id": 9625, "verse_number": "७-९०-१५", "content_sanskrit": "ततो यज्ञो महानासीद्बुधाश्रमसमीपतः ।\nरुद्रश्च परमं तोषमाजगाम महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000625015, "chapter_id": 9625, "verse_number": "७-९०-१६", "content_sanskrit": "अथ यज्ञे समाप्ते तु प्रीतः परमया मुदा ।\nउमापतिर्द्विजान्सर्वानुवाच इलसन्निधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000625016, "chapter_id": 9625, "verse_number": "७-९०-१७", "content_sanskrit": "प्रीतो ऽस्मि हयमेधेन भक्त्या च द्विजसत्तमाः ।\nअस्य बाह्लिपतेश्चैव किं करोमि प्रियं शुभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000625017, "chapter_id": 9625, "verse_number": "७-९०-१८", "content_sanskrit": "तथा वदति देवेशे द्विजास्ते सुसमाहिताः ।\nप्रसादयन्ति देवेशं यथा स्यात्पुरुषस्त्विला ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000625018, "chapter_id": 9625, "verse_number": "७-९०-१९", "content_sanskrit": "ततः प्रीतो महादेवः पुरुषत्वं ददौ पुनः ।\nइलायै सुमहातेजा दत्त्वा चान्तरधीयत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000625019, "chapter_id": 9625, "verse_number": "७-९०-२०", "content_sanskrit": "निवृत्ते हयमेधे च गतश्चादर्शनं हरः ।\nयथागतं द्विजाः सर्वे ह्यगच्छन्दीर्घदर्शिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000625020, "chapter_id": 9625, "verse_number": "७-९०-२१", "content_sanskrit": "राजा तु बाह्लिमुत्सृज्य मध्यदेशे ह्यनुत्तमम् ।\nनिवेशयामास पुरं प्रतिष्ठानं यशस्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000625021, "chapter_id": 9625, "verse_number": "७-९०-२२", "content_sanskrit": "शशबिन्दुश्च राजर्षिर्बाह्लिं पुरपुरञ्जयः ।\nप्रतिष्ठाने इलो राजा प्रजापतिसुतो बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000625022, "chapter_id": 9625, "verse_number": "७-९०-२३", "content_sanskrit": "स काले प्राप्तवाँल्लोकमिलो ब्राह्ममनुत्तमम् ।\nऐलः पुरूरवा राजा प्रतिष्ठानमवाप्तवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000625023, "chapter_id": 9625, "verse_number": "७-९०-२४", "content_sanskrit": "ईदृशो ह्यश्वमेधस्य प्रभावः पुरुषर्षभौ ।\nस्त्रीभूतः पौरुषं लेभे यच्चान्यदपि दुर्लभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000625024, "chapter_id": 9625, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे नवतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]