[{"id": 2175523, "chapter_id": 4720, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2175524, "chapter_id": 4720, "verse_number": "१", "content_sanskrit": "शृणु मातृगणान् राजन् कुमारानुचरानिमान् ।\nकीर्त्यमानान् महावीर्यान् सपत्नगणसूदनान्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2175525, "chapter_id": 4720, "verse_number": "२", "content_sanskrit": "यशस्विनीनां मातॄणां शृणु नामानि भारत ।\nयाभिर्व्याप्तास्त्रयो लोकाः कल्याणीभिश्चराचराः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2175526, "chapter_id": 4720, "verse_number": "३", "content_sanskrit": "प्रभावती विशालाक्षी पालिका गोनसा तथा ।\nश्रीमती बहुला चैव तथैव बहुपुत्रिका\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2175527, "chapter_id": 4720, "verse_number": "४", "content_sanskrit": "अप्सुजाता च गोपाली बृहदम्बालिका तथा ।\nजयावती मालिनिका ध्रुवरत्ना भयङ्करी\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2175528, "chapter_id": 4720, "verse_number": "५", "content_sanskrit": "बहुदामा सुदामा च पिशङ्गी नन्दिनी तथा ।\nएकचूडा महाचूडा चक्रनेमिश्च भारत\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2175529, "chapter_id": 4720, "verse_number": "६", "content_sanskrit": "अतेजस्वी भवत्सेना कमलाक्ष्यथ शोभना ।\nशत्रुञ्जया तथा वाची क्रोधना शलभीमुखा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2175530, "chapter_id": 4720, "verse_number": "७", "content_sanskrit": "माधवी शुभवक्त्रा च तीर्थनेमिश्च भारत ।\nगीतिप्रिया च कल्याणी द्रुममालाऽमितौजसा\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2175531, "chapter_id": 4720, "verse_number": "८", "content_sanskrit": "तेजस्विनी भोगवती सुभ्रूश्च कनकावती ।\nअलाताक्षी वीर्यवती विद्युज्जिह्वा च भारत\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2175532, "chapter_id": 4720, "verse_number": "९", "content_sanskrit": "पद्मावती सुनक्षत्रा कन्दरा बहुलोचना ।\nसन्तानिका च कौरव्य कामा च कमलावती\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2175533, "chapter_id": 4720, "verse_number": "१०", "content_sanskrit": "मालिदा बहुदामा च प्रसूना च यशस्विनी ।\nनृत्यप्रिया च राजेन्द्र तथोलूखलमेखला\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2175534, "chapter_id": 4720, "verse_number": "११", "content_sanskrit": "कुक्कुटिका शङ्खिणिका तथा जर्झरिका नृप ।\nकुण्डलीका कलालीला कुण्डलाऽथ शतोदरी\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2175535, "chapter_id": 4720, "verse_number": "१२", "content_sanskrit": "उक्ताधिका जरेन्द्रादा महावेगा च कङ्कणा ।\nमनोजवा कण्टकिनी प्रघसा पूतनादिनी\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2175536, "chapter_id": 4720, "verse_number": "१३", "content_sanskrit": "ऐषिका पुच्छदा वामा कोपनाऽथ तडित्प्रभा ।\nकुण्डोदरी प्रचण्डा च कोटरा मेघवासिनी\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2175537, "chapter_id": 4720, "verse_number": "१४", "content_sanskrit": "सुतरा तन्त्रिणी लम्बा वासचूडा विकर्तना ।\nऊर्ध्ववेणीधरा चैव पिङ्गाक्षी हेममेखला\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2175538, "chapter_id": 4720, "verse_number": "१५", "content_sanskrit": "आमोदा चैव कौरव्य तथा लम्बपयोधरा ।\nशशोलूकमुखी कृष्णा खरजङ्घा मनोजवा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2175539, "chapter_id": 4720, "verse_number": "१६", "content_sanskrit": "शिंशुमारमुखी श्वेता लोहिताक्षी विभीषणा ।\nजटालिका कामचरी दीर्घजिह्वाऽथ लोभगा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2175540, "chapter_id": 4720, "verse_number": "१७", "content_sanskrit": "कानेलिका वाशतिका कुमुदा चैव भारत ।\nशोणिताक्षी महाकाया गरदा चैव भारत\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2175541, "chapter_id": 4720, "verse_number": "१८", "content_sanskrit": "एकालीका कुङ्कुसुमा कृष्णवर्णा च भारत ।\nक्षुरकर्णी चतुष्कर्णा कर्णप्रावरणा तथा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2175542, "chapter_id": 4720, "verse_number": "१९", "content_sanskrit": "चतुष्पथनिकेता च गोकर्णी महिषानना ।\nखरकर्णी महाकर्णी भेरीस्वनमहास्वने\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2175543, "chapter_id": 4720, "verse_number": "२०", "content_sanskrit": "शङ्खकुम्भस्वरा चैव भवदा च महाबला ।\nगणा च सुगणा चैव तथा काली मदा तथा\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2175544, "chapter_id": 4720, "verse_number": "२१", "content_sanskrit": "चतुष्पथरथा चैव भूतिनी धान्यगोचरा ।\nपशुदा वित्तदा चैव महदा च महायशाः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2175545, "chapter_id": 4720, "verse_number": "२२", "content_sanskrit": "पयोदा गोमहिषदा सुवर्णानी च भारत ।\nप्रतिष्ठा सुप्रतिष्ठा च रोचमाना सुरोचना\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2175546, "chapter_id": 4720, "verse_number": "२३", "content_sanskrit": "नैकर्णी मुखकर्णी च श्वासिका स्थारिका तथा ।\nसुरचक्रा मेघरवा मेघमाला विरोचना\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2175547, "chapter_id": 4720, "verse_number": "२४", "content_sanskrit": "एताश्चान्याश्च बहुला मातरो भरतर्षभ ।\nकार्तिकेयानुयायिन्यो नानारूपाः सहस्रशः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2175548, "chapter_id": 4720, "verse_number": "२५", "content_sanskrit": "दीर्घदन्ता दीर्घनेत्रा दीर्घतुण्डाश्च भारत ।\nसरला मधुराश्चैव यौवनस्थाः स्वलङ्कृताः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2175549, "chapter_id": 4720, "verse_number": "२६", "content_sanskrit": "महत्त्वेन च संयुक्ता कामरूपधरास्तथा\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2175550, "chapter_id": 4720, "verse_number": "२७", "content_sanskrit": "याम्या रौद्रास्तथा सौम्या नानारूपा महाबलाः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2175551, "chapter_id": 4720, "verse_number": "२८", "content_sanskrit": "निर्मांसगात्राः श्वेताश्च तथा काञ्चनसन्निभाः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2175552, "chapter_id": 4720, "verse_number": "२९", "content_sanskrit": "कृष्णमेघनिभाश्चान्या धूम्राश्च भरतर्षभ ।\nअरुणाभा महाभागा दीर्घकेश्यः सिताननाः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2175553, "chapter_id": 4720, "verse_number": "३०", "content_sanskrit": "ऊर्ध्ववेणीधराश्चैव पिङ्गाक्षो लोममेखलाः ।\nलम्बोदरा लम्बकर्णास्तथा लम्बपयोधराः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2175554, "chapter_id": 4720, "verse_number": "३१", "content_sanskrit": "ताम्राक्ष्यस्ताम्रवर्णाश्च हर्यक्षाश्च तथाऽपराः ।\nवरदाः कामचारिण्यो नित्यं प्रमुदितास्तथा\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2175555, "chapter_id": 4720, "verse_number": "३२", "content_sanskrit": "वारुण्योऽप्यथ माहेन्द्र्यस्तथाऽऽग्नेय्यः परन्तप ।\nवायव्याश्चाथ कौबेर्यो ब्राह्म्यश्च भरतर्षभ\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2175556, "chapter_id": 4720, "verse_number": "३३", "content_sanskrit": "रूपेणाप्सरसां तुल्या जवे वायुसमाश्च ताः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2175557, "chapter_id": 4720, "verse_number": "३४", "content_sanskrit": "शक्रवीर्योपमा युद्धे दीप्तवह्निसमप्रभाः ।\nपरपुष्टोपमा वाक्ये धनाढ्या धनदोपमाः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2175558, "chapter_id": 4720, "verse_number": "३५", "content_sanskrit": "वृक्षचत्वरवासिन्यः चतुष्पथनिकेतनाः ।\nशुभ्राः श्मशानवासिन्यः शैलप्रस्रवणालयाः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2175559, "chapter_id": 4720, "verse_number": "३६", "content_sanskrit": "नानाभरणधारिण्यो नानामाल्याम्बरस्रजः ।\nनानाविचित्रवेषाश्च नानाभाषास्तथा पराः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2175560, "chapter_id": 4720, "verse_number": "३७", "content_sanskrit": "एते चान्ये च मातॄणां गणाः शत्रुभयङ्कराः ।\nअनुजग्मुर्महात्मानं त्रिदशेन्द्रस्य सम्मते\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2175561, "chapter_id": 4720, "verse_number": "३८", "content_sanskrit": "ततः शक्त्यस्त्रमददाद् भगवान् पाकशासनः ।\nगुहाय राजशार्दूल विनाशाय सुरद्विषाम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2175562, "chapter_id": 4720, "verse_number": "३९", "content_sanskrit": "महास्वनां महाघण्टां द्योतमानां सितप्रभाम् ।\nतरुणादित्यवर्णां च पताकां भरतर्षभ\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2175563, "chapter_id": 4720, "verse_number": "४०", "content_sanskrit": "ददौ पशुपतिस्तस्मै सर्वभूतमहाचमूम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2175564, "chapter_id": 4720, "verse_number": "४१", "content_sanskrit": "उग्रां नानाप्रहरणां तपोवीर्यबलान्विताम् ।\nविष्णुर्ददौ वैजयन्तीं मालां बलविवर्धि(र्ध)नीम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2175565, "chapter_id": 4720, "verse_number": "४२", "content_sanskrit": "उमा ददावरजसी वाससी चन्द्रसन्निभे ।\nगङ्गा कमण्डलुं दिव्यममृतोद्भवमुत्तमम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2175566, "chapter_id": 4720, "verse_number": "४३", "content_sanskrit": "ददौ प्रीत्या कुमाराय दण्डं चैव बृहस्पतिः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2175567, "chapter_id": 4720, "verse_number": "४४", "content_sanskrit": "गरुडो दयितं पुत्रं मयूरं चित्रबर्हिणम् ।\nअरुणस्ताम्रचूडं च प्रददौ चरणायुधम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2175568, "chapter_id": 4720, "verse_number": "४५", "content_sanskrit": "छागं तु वरुणो देवो बलवीर्यसमन्वितम् ।\nकृष्णाजिनं ददौ ब्रह्मा ब्रह्मण्याय ददौ नृप\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2175569, "chapter_id": 4720, "verse_number": "४६", "content_sanskrit": "समरेषु जयं चैव प्रददौ लोकभावनः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2175570, "chapter_id": 4720, "verse_number": "४७", "content_sanskrit": "सैनापत्यमनुप्राप्य स्कन्दो देवगणस्य ह ।\nशुशुभे ज्वलनार्चिष्मान् द्वितीय इव पावकः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2175571, "chapter_id": 4720, "verse_number": "४८", "content_sanskrit": "ततः पारिषदैश्चैव मातृभिश्च समन्वितः ।\nययौ दैत्यविनाशाय ह्लादयन् सुरपुङ्गवान्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2175572, "chapter_id": 4720, "verse_number": "४९", "content_sanskrit": "सा सेना नैर्ऋती तत्र सघण्टोच्छ्रितकेतना ।\nसभेरीशङ्खमुरजा सायुधा सपताकिनी\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2175573, "chapter_id": 4720, "verse_number": "५०", "content_sanskrit": "शारदी द्यौरिव बभौ ज्योतिर्भिरिव शोभिता\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2175574, "chapter_id": 4720, "verse_number": "५१", "content_sanskrit": "ततो देवनिकायास्ते भूतसेनागणास्तथा ।\nवादयामासुरव्यग्रा भेरीः शङ्खांश्च पुष्कलान्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2175575, "chapter_id": 4720, "verse_number": "५२", "content_sanskrit": "पटहान् झर्झरांश्चैव कङ्कणान् गोविषाणकान् ।\nआडम्बरान् गोमुखांश्च डिण्डिमांश्च महास्वनान्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2175576, "chapter_id": 4720, "verse_number": "५३", "content_sanskrit": "तुष्टुवुस्ते कुमारं च सर्वे देवाः सवासवाः ।\nजगुश्च देवगन्धर्वा ननृतुश्चाप्सरोगणाः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2175577, "chapter_id": 4720, "verse_number": "५४", "content_sanskrit": "ततः प्रीतो महासेनः त्रिदशानां वरं ददौ ।\nरिपून् हन्तास्मि समरे येषां वधचिकीर्षवः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2175578, "chapter_id": 4720, "verse_number": "५५", "content_sanskrit": "प्रतिगृह्य वरं देवाः तस्माद् विबुधसत्तमात् ।\nप्रीतात्मानो महात्मानो मेनिरे निहतान् रिपून्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2175579, "chapter_id": 4720, "verse_number": "५६", "content_sanskrit": "सर्वेषां भूतसङ्घानां हर्षान्नादः समुत्थितः ।\nअपूरयत लोकांस्त्रीन् वरे दत्ते महात्मना\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2175580, "chapter_id": 4720, "verse_number": "५७", "content_sanskrit": "स निर्ययौ महासेनो महत्या सेनया सह ।\nवधाय युधि दैत्यानां रक्षसां भरतर्षभ\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2175581, "chapter_id": 4720, "verse_number": "५८", "content_sanskrit": "व्यवसायो जयो धर्मः सिद्धिर्लक्ष्मीर्धृतिः स्मृतिः ।\nमहासेनस्य सैन्यानामग्रे जग्मुर्नराधिप\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2175582, "chapter_id": 4720, "verse_number": "५९", "content_sanskrit": "स तया भीमया देवः शूलमुद्गरहस्तया ।\nगदामुसलनाराचशक्तितोमरहस्तया\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2175583, "chapter_id": 4720, "verse_number": "६०", "content_sanskrit": "वृतः सिंहनिनादिन्या विनद्य प्रययौ गुहः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2175584, "chapter_id": 4720, "verse_number": "६१", "content_sanskrit": "तं दृष्ट्वा सर्वदैतेया राक्षसा दानवास्तथा ।\nव्यद्रवन्त दिशः सर्वा भयोद्विग्नाः समन्ततः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2175585, "chapter_id": 4720, "verse_number": "६२", "content_sanskrit": "अभ्यद्रवन्त देवाश्च विविधायुधपाणयः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2175586, "chapter_id": 4720, "verse_number": "६३", "content_sanskrit": "दृष्ट्वा चापततः क्रुद्धः स्कन्दस्तेजोबलान्वितः ।\nशक्त्यस्त्रं भगवान् देवः पुनः पुनररिन्दमः\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2175587, "chapter_id": 4720, "verse_number": "६४", "content_sanskrit": "आदधच्चात्मनस्तेजो हविषेव यथाऽनलः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2175588, "chapter_id": 4720, "verse_number": "६५", "content_sanskrit": "अभ्यस्यमाने शक्त्यस्त्रे स्कन्देनामिततेजसा ।\nउल्काजालं महाराज पपात वसुधातळे\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2175589, "chapter_id": 4720, "verse_number": "६६", "content_sanskrit": "संह्रादयन्तः शतशो निर्घाताश्चापतन् क्षितौ ।\nयथाऽन्तकालसमये सुघोराः स्युस्तथा नृप\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2175590, "chapter_id": 4720, "verse_number": "६७", "content_sanskrit": "क्षिप्ता ह्येका यदा शक्तिः सुघोराऽनलसूनुना ।\nतदा कोट्यो विनिष्पेतुः शक्तीनां भरतर्षभ\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2175591, "chapter_id": 4720, "verse_number": "६८", "content_sanskrit": "स शक्त्यस्त्रेण दनुजान् जघान भगवान् प्रभुः\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2175592, "chapter_id": 4720, "verse_number": "६९", "content_sanskrit": "दैत्येन्द्रं तारकं नाम महाबलपराक्रमम् ।\nवृतं दैत्यायुतैर्वीरैर्बलिभिर्दशभिः प्रभुः\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2175593, "chapter_id": 4720, "verse_number": "७०", "content_sanskrit": "महिषं चाष्टभिः पद्मैर्वृतं सङ्खे जघान ह\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2175594, "chapter_id": 4720, "verse_number": "७१", "content_sanskrit": "त्रिपादं चायुतशतैर्जघान दशभिर्वृतम्\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2175595, "chapter_id": 4720, "verse_number": "७२", "content_sanskrit": "ह्रदोदरं निखर्वैश्च वृतं दशभिरीश्वरः ।\nजघानानुचरैः सार्धं विविधायुधपाणिभिः\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2175596, "chapter_id": 4720, "verse_number": "७३", "content_sanskrit": "तत्राकुर्वन्त तुमुलं नादं वध्यत्सु शत्रुषु ।\nकुमारानुचरा राजन् पूरयन्तो दिशो दश\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2175597, "chapter_id": 4720, "verse_number": "७४", "content_sanskrit": "शक्त्यस्त्रस्य तु राजेन्द्र ततोऽर्चिभिर्विशाम्पते ।\nत्रैलोक्यं त्रासितं सर्वं जृम्भमाणाभिरेव च\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2175598, "chapter_id": 4720, "verse_number": "७५", "content_sanskrit": "दग्धाः सहस्रशो दैत्या नादैः स्कन्दस्य चापरे\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2175599, "chapter_id": 4720, "verse_number": "७६", "content_sanskrit": "पताकया चावधूता हताः केचित् सुरद्विषः ।\nकेचिद् घण्टारवत्रस्ता निपेतुर्धरणीतळे\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2175600, "chapter_id": 4720, "verse_number": "७७", "content_sanskrit": "केचित् प्रहरणैश्छिन्ना विनिष्पेतुर्गतासवः\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2175601, "chapter_id": 4720, "verse_number": "७८", "content_sanskrit": "एवं सुरद्विषोऽनेकान् सबलानाततायिनः ।\nजिगाय समरे वीरः कार्तिकेयो जघान ह\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2175602, "chapter_id": 4720, "verse_number": "७९", "content_sanskrit": "बाणो नामाथ दैत्येन्द्रो बलेः पुत्रो महाबलः ।\nक्रौञ्चपर्वतमासाद्य देवसङ्घानबाधत\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2175603, "chapter_id": 4720, "verse_number": "८०", "content_sanskrit": "तमभ्ययान्महासेनः सुरशत्रुमुदारधीः ।\nस कार्तिकेयस्य भयात् क्रौञ्चं शरणमेयिवान्\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2175604, "chapter_id": 4720, "verse_number": "८१", "content_sanskrit": "ततः क्रौञ्चमभिद्रुत्य क्रौञ्चनादविनादितम् ।\nशक्त्या बिभेद भगवान् कार्तिकेयोऽग्निदत्तया\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2175605, "chapter_id": 4720, "verse_number": "८२", "content_sanskrit": "ससालस्कन्धतरलं त्रस्तवानरवारणम् ।\nप्रलीनत्रस्तविहगं विनिष्पतितपन्नगम्\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2175606, "chapter_id": 4720, "verse_number": "८३", "content_sanskrit": "गोलाङ्गूलर्क्षचमरैर्द्रवद्भिरनुनादितम् ।\nकुरङ्गारुतनिर्घोषमुद्भ्रान्तभ्रमराचितम्\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2175607, "chapter_id": 4720, "verse_number": "८४", "content_sanskrit": "विनिष्पतद्भिः शरभैः सिंहैश्च सहसा द्रुतैः ।\nशोच्यामपि दशां प्राप्तो ररासेव स पर्वतः\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2175608, "chapter_id": 4720, "verse_number": "८५", "content_sanskrit": "विद्याधराः समुत्पेतुस्तस्य शृङ्गनिवासिनः ।\nकिन्नराश्च भयोद्विग्नाः शक्तिप्रासरवोद्धृताः\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2175609, "chapter_id": 4720, "verse_number": "८६", "content_sanskrit": "ततो दैत्या विनिष्पेतुः शतशोऽथ सहस्रशः ।\nप्रदीप्तात् पर्वतश्रेष्ठाद् विचित्राभरणस्रजः\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2175610, "chapter_id": 4720, "verse_number": "८७", "content_sanskrit": "तान् निजघ्नुरतिक्रम्य कुमारानुचरा मृधे ।\nबिभेद शक्त्या क्रौञ्चं च पावकिः परवीरहा\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2175611, "chapter_id": 4720, "verse_number": "८८", "content_sanskrit": "बहुधा चैकधा चैव कृत्वाऽऽत्मानं महात्मना ।\nशक्तिः क्षिप्ता रणे तेन पाणिमेति पुनः पुनः\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2175612, "chapter_id": 4720, "verse_number": "८९", "content_sanskrit": "एवम्प्रभावो भगवानतो भूयश्च पावकिः ।\nक्रौञ्चस्तेन विनिर्भिन्नो दैत्याश्च शतशो हताः\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2175613, "chapter_id": 4720, "verse_number": "९०", "content_sanskrit": "ततः स भगवान् क्रौञ्चं निहत्य विबुधद्विषः(म्) ।\nसभाज्यमानो विबुधैः परं हर्षमवाप ह\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2175614, "chapter_id": 4720, "verse_number": "९१", "content_sanskrit": "ततो दुन्दुभयो नेदुर्दिव्याः शङ्खाश्च भारत ।\nमुमुचुर्देवसेनाश्च पुष्पवर्षमनुत्तमम्\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2175615, "chapter_id": 4720, "verse_number": "९२", "content_sanskrit": "योगिनामीश्वरं देवं शतशोऽथ सहस्रशः ।\nदिव्यगन्धमुपादाय ववौ पुण्यश्च मारुतः\t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2175616, "chapter_id": 4720, "verse_number": "९३", "content_sanskrit": "गन्धर्वास्तुष्टुवुश्चैनं यज्वानश्च महर्षयः\t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2175617, "chapter_id": 4720, "verse_number": "९४", "content_sanskrit": "केचिदेनं व्यवस्यन्ति पितामहसुतं विभुम् ।\nसनत्कुमारं सर्वेषां ब्रह्मयोनिं तमग्रजम्\t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2175618, "chapter_id": 4720, "verse_number": "९५", "content_sanskrit": "केचिन्महेश्वरसुतं केचित् पुत्रं विभावसोः ।\nउमायाः कृत्तिकायाश्च गङ्गायाश्च वदन्त्युत\t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2175619, "chapter_id": 4720, "verse_number": "९६", "content_sanskrit": "एकधा च द्विधा चैव चतुर्धा च महाबलम् ।\nयोगिनामीश्वरं देवं शतशोऽथ सहस्रशः\t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2175620, "chapter_id": 4720, "verse_number": "९७", "content_sanskrit": "एतत् ते कथितं राजन् कार्तिकेयाभिषेचनम् ।\nशृणु चेमां सरस्वत्याः तीर्थवंशस्य पुण्यताम्\t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2175621, "chapter_id": 4720, "verse_number": "९८", "content_sanskrit": "बभूव तत्तीर्थवरं हतेषु सुरशत्रुषु ।\nकुमारेण महाराज त्रिविष्टपमिवापरम्\t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2175622, "chapter_id": 4720, "verse_number": "९९", "content_sanskrit": "ऐश्वर्याणि च तत्रस्थो ददावीशः पृथक् पृथक् ।\nतथा नैर्ऋतमुख्येषु त्रैलोक्ये पावकात्मजः\t॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2175623, "chapter_id": 4720, "verse_number": "१००", "content_sanskrit": "एवं स भगवांस्तस्मिन् तीर्थे दैत्यकुलान्तकृत् ।\nअभिषिक्तो महाराज देवसेनापतिः सुरैः\t॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2175624, "chapter_id": 4720, "verse_number": "१०१", "content_sanskrit": "तैजसं नाम तत् तीर्थं यत्र तीर्थे महामतिः ।\nअभिषिक्तः सुरगणैर्वरुणो भरतर्षभ\t॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2175625, "chapter_id": 4720, "verse_number": "१०२", "content_sanskrit": "तस्मिंस्तीर्थवरे स्नात्वा स्कन्दमभ्यर्च्य लाङ्गली ।\nब्राह्मणेभ्यो ददौ वित्तं वासांस्याभरणानि च\t॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2175626, "chapter_id": 4720, "verse_number": "१०३", "content_sanskrit": "उषित्वा रजनीं तां तु माधवः परवीरहा ।\nआद्यं तीर्थवरं तच्च स्पृष्ट्वा तोयं च लाङ्गली\t॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2175627, "chapter_id": 4720, "verse_number": "१०४", "content_sanskrit": "हृष्टः प्रीतमनाश्चैव ह्यभवन्माधवोत्तमः\t॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2175628, "chapter_id": 4720, "verse_number": "१०५", "content_sanskrit": "यत्राऽभिषिक्तो भगवान् स्कन्दो देवैः समागतैः ।\nसेनानीश्च कृतो राजन् बाल एव महारथः\t॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2175629, "chapter_id": 4720, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां गदापर्वणि कुमाराभिषेकप्रकारवर्णनं नाम अष्टादशोऽध्यायः ॥१८॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}]