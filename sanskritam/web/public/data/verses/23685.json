[{"id": 7003685000, "chapter_id": 23685, "verse_number": "१-३-६-१", "content_sanskrit": "गौतम उवाच ।\nपुरा नारायणः कल्पे शयानः सलिलार्णवे ।\nशेषपर्यंकशयने कदाचिन्नैव बुध्यत ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003685001, "chapter_id": 23685, "verse_number": "१-३-६-२", "content_sanskrit": "तमसा पूरितं विश्वमपज्ञातमलक्षणम् ।\nवीक्ष्य कल्पावसानेऽपि विषेदुर्नित्यसूरयः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003685002, "chapter_id": 23685, "verse_number": "१-३-६-३", "content_sanskrit": "अहो कष्टमिदं रूपं तमसा विश्वमोहनम् ।\nयेन कल्पावसानेपि विष्णुर्नाद्यापि बुध्यते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003685003, "chapter_id": 23685, "verse_number": "१-३-६-४", "content_sanskrit": "ज्योतिषः पुरुषं पूर्णमपश्यंतं सुरा अपि ।\nकथं वा तमसः शांतिं लभेरन्परिभाविनः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003685004, "chapter_id": 23685, "verse_number": "१-३-६-५", "content_sanskrit": "इति निश्चित्य मनसा देवदेवमुमापतिम् ।\nचिंतयामासुरात्मस्थं तेजोराशिं निरंजनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003685005, "chapter_id": 23685, "verse_number": "१-३-६-६", "content_sanskrit": "ततः प्रसन्नो भगवांस्तेजोराशिर्महेश्वरः ।\nविश्वावनाय विज्ञप्तः प्रणतैर्नित्यसूरिभिः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003685006, "chapter_id": 23685, "verse_number": "१-३-६-७", "content_sanskrit": "ततस्तेजोमयाच्छंभोः स्फुलिंगांशुसमुद्भवाः ।\nउदस्तंभंत देवानां त्रयस्त्रिंशच्च कोटयः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003685007, "chapter_id": 23685, "verse_number": "१-३-६-८", "content_sanskrit": "बोधितः सकलैर्देवैः समुत्थाय रमापतिः ।\nप्रभातं वीक्ष्य सकलं मनस्येवमचिन्तयत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003685008, "chapter_id": 23685, "verse_number": "१-३-६-९", "content_sanskrit": "मया तमसि उद्रेकादकाले शयनं कृतम् ।\nप्रबोधाय परं ज्योतिः स्वयं दृष्टः सदाशिवः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003685009, "chapter_id": 23685, "verse_number": "१-३-६-१०", "content_sanskrit": "जगदुत्पत्तिकृत्यानि स्वयं कर्तुं व्यवस्यति ।\nकिं मयात्र पुनः कार्यं ब्रह्मणा वा स्वयंभुवा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003685010, "chapter_id": 23685, "verse_number": "१-३-६-११", "content_sanskrit": "धिङ्मां स्थितमनात्मज्ञं निद्रया हृतचेतसम् ।\nअथवा सर्वकर्तारं शरणं यामि शंकरम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003685011, "chapter_id": 23685, "verse_number": "१-३-६-१२", "content_sanskrit": "सर्वदोषप्रशमनं सर्वाभीष्टफलप्रदम् ।\nपवित्रमल्पपुण्यानां दुर्लभं शंभुदर्शनम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003685012, "chapter_id": 23685, "verse_number": "१-३-६-१३", "content_sanskrit": "चिंतयन्नेवमात्मस्थं ज्योतिर्लिंगं सदाशिवम् ।\nप्रणनाम हरिर्भक्त्या देवमष्टांगतो मुहुः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003685013, "chapter_id": 23685, "verse_number": "१-३-६-१४", "content_sanskrit": "विश्वस्रष्टारमीशानं तुष्टाव दुरितच्छिदम् ।\nअथ तेजोमयः शंभुः शरण्यः शरणागतम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003685014, "chapter_id": 23685, "verse_number": "१-३-६-१५", "content_sanskrit": "अनुगृह्य कटाक्षैस्तं समुत्तिष्ठेत्यभाषत ।\nउत्थाय करुणापूर्णं शंभुं चंद्रार्द्धशेखरम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003685015, "chapter_id": 23685, "verse_number": "१-३-६-१६", "content_sanskrit": "नमस्त्रिभुवनेशाय त्रिमूर्तिगुणधारिणे ।\nत्रिदेववपुषे तुभ्यं त्रिदृशे त्रिपुरद्रुहे ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003685016, "chapter_id": 23685, "verse_number": "१-३-६-१७", "content_sanskrit": "त्वमेव जगतामीशो निजांशैर्देवतामयैः ।\nकार्यकारणरूपेण करोषि स्वेच्छया क्रियाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003685017, "chapter_id": 23685, "verse_number": "१-३-६-१८", "content_sanskrit": "मां नियुज्य जगद्गुप्तौ परिमोह्य च मायया ।\nन दोषमुत संकल्पं विहातुमपि नेच्छसि ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003685018, "chapter_id": 23685, "verse_number": "१-३-६-१९", "content_sanskrit": "किं करोमि जगन्मूर्त्तौ न्यस्तभारोऽस्म्यहं त्वयि ।\nन दोषमीहसे नूनमकालशयनेन माम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003685019, "chapter_id": 23685, "verse_number": "१-३-६-२०", "content_sanskrit": "हर शम्भो हरेरार्तिमनुतापं समीक्ष्य सः ।\nआदिदेश हरः श्रीमान्प्रायश्चित्तं हरेरिदम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003685020, "chapter_id": 23685, "verse_number": "१-३-६-२१", "content_sanskrit": "अरुणाचलरूपेण तिष्ठामि वसुधातले ।\nतस्य दर्शनमात्रेण भविता ते तमः क्षयः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003685021, "chapter_id": 23685, "verse_number": "१-३-६-२२", "content_sanskrit": "पूर्वस्मै विष्णवे तत्र वरो दत्तो मया पुरा ।\nतदैव तैजसं लिंगमरुणाचल संज्ञितम् ।\nतेजोमयमिदं रूपं प्रशांतं लोकरक्षणात् ।\nयदग्निमयमव्यक्तमपारगुणवैभवम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003685022, "chapter_id": 23685, "verse_number": "१-३-६-२३", "content_sanskrit": "नदीनां निर्झराणां च मेघमुक्तांभसामपि ।\nअंतर्ज्योतिर्मयत्वेन लयस्तत्रैव दृश्यते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003685023, "chapter_id": 23685, "verse_number": "१-३-६-२४", "content_sanskrit": "अंधानां दृष्टिलाभेन पंगूनां पादसंचरैः ।\nअपुत्राणां च पुत्राप्त्या मूकानां वाक्प्रवृत्तिभिः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003685024, "chapter_id": 23685, "verse_number": "१-३-६-२५", "content_sanskrit": "सर्वसिद्धिप्रदानेन सर्वव्याधिविमोचनैः ।\nसर्वपापप्रशमनैर्यत्सर्ववरदं स्थितम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003685025, "chapter_id": 23685, "verse_number": "१-३-६-२६", "content_sanskrit": "इत्युक्तांतर्दधे शम्भुर्हरिश्चैवारुणाचलम् ।\nआगत्य तप आस्थाय शोणाचलमुपास्त च ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003685026, "chapter_id": 23685, "verse_number": "१-३-६-२७", "content_sanskrit": "तमद्रिं परितो दृष्ट्वा सुरान्काननसंश्रयान् ।\nऋषीणामाश्रमान्पुण्यान्स्थापयामास वै हरिः ।\nवेदान्सांगोपनिषदान्समंतान्मूर्तिधारिणः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003685027, "chapter_id": 23685, "verse_number": "१-३-६-२८", "content_sanskrit": "ससर्ज दिव्यरूपाणां शतमप्सरसां कुलम् ।\nनृत्यैर्गीतैश्च वादित्रैस्सेवध्वमिति चादिशत् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003685028, "chapter_id": 23685, "verse_number": "१-३-६-२९", "content_sanskrit": "स्नात्वा ब्रह्मसरस्यस्मिन्विष्णुः कमललोचनः ।\nप्रदक्षिणं चकारामुमरुणाद्रिं समर्चितम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003685029, "chapter_id": 23685, "verse_number": "१-३-६-३०", "content_sanskrit": "अपापः सर्वलोकानामाधिपत्यं च लब्धवान् ।\nरमया सहितो नित्यमभिरूपसुरूपया ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003685030, "chapter_id": 23685, "verse_number": "१-३-६-३१", "content_sanskrit": "भास्करस्तेजसां राशिरसुरैरपि पीडितः ।\nब्रह्मोपदेशादानर्च भक्त्यारुणगिरीश्वरम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003685031, "chapter_id": 23685, "verse_number": "१-३-६-३२", "content_sanskrit": "निमज्ज्य विमले तीर्थे पावने ब्रह्मनिर्मिते ।\nप्रदक्षिणं चकारैनमरुणार्द्रि स्वयंप्रभुम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003685032, "chapter_id": 23685, "verse_number": "१-३-६-३३", "content_sanskrit": "अशेषदैत्यविजयं लब्ध्वा मेरुप्रदक्षिणम् ।\nलेभे च परमं तेजः परतेजःप्रणाशनम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003685033, "chapter_id": 23685, "verse_number": "१-३-६-३४", "content_sanskrit": "दक्षशापानलाक्रांतस्सोमः शिववचोबलात् ।\nअरुणाचलमभ्यर्च्य लब्धरूपोऽभवत्पुनः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003685034, "chapter_id": 23685, "verse_number": "१-३-६-३५", "content_sanskrit": "अग्निर्ब्रह्मर्षिशापेन यक्ष्मरोगप्रपीडितः ।\nअपूतोऽपि पवित्रोऽभूदरुणाचलसेवया ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003685035, "chapter_id": 23685, "verse_number": "१-३-६-३६", "content_sanskrit": "शक्रो वृत्रं बलं पाकं नमुचिं जृंभमुद्धृतम् ।\nशिवलब्धवरान्दैत्यान्पुरा हत्वा जगत्पतीन् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003685036, "chapter_id": 23685, "verse_number": "१-३-६-३७", "content_sanskrit": "पातकैश्च परिक्षीणस्तथा लोकांतमाश्रितः ।\nशम्भुं प्रसाद्य तपसा शिवेन परिचोदितः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003685037, "chapter_id": 23685, "verse_number": "१-३-६-३८", "content_sanskrit": "अरुणाद्रिं समभ्यर्च्य विपापोऽभूत्सुराधिपः ।\nइष्ट्वा च हयमेधेन प्रीणयामास शंकरम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003685038, "chapter_id": 23685, "verse_number": "१-३-६-३९", "content_sanskrit": "लब्ध्वा चेन्द्रपदं शक्रः शतमप्सरसांकुलम् ।\nसेवार्थमादिशन्छ्रीमान्दिव्यदुंदभिसेवया ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003685039, "chapter_id": 23685, "verse_number": "१-३-६-४०", "content_sanskrit": "पुष्पमेघान्समादिश्य दिव्याभिः पुष्पवृष्टिभिः ।\nसमर्चयति शोणाद्रिं दिवि नित्यं च वंदते ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003685040, "chapter_id": 23685, "verse_number": "१-३-६-४१", "content_sanskrit": "शेषोऽपि शोणशैलेशं समभ्यर्च्य शिवाज्ञया ।\nअभजत्कामरूपत्वं महीमण्डलधारकः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003685041, "chapter_id": 23685, "verse_number": "१-३-६-४२", "content_sanskrit": "अन्ये नागाश्च गन्धर्वाः सिद्धाश्चाप्सरसां गणाः ।\nदिक्पालाश्च तमभ्यर्च्य लेभिरेऽपेक्षितान्वरान् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003685042, "chapter_id": 23685, "verse_number": "१-३-६-४३", "content_sanskrit": "देवैरशेषैर्दैत्यादीञ्जेतुकामैः समुद्यतैः ।\nप्रार्थितः सर्वतोऽभीष्टवरदोऽरुणभूधरः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003685043, "chapter_id": 23685, "verse_number": "१-३-६-४४", "content_sanskrit": "त्वष्ट्रा विरचिताकार आदित्यस्तेजसा तपन् ।\nग्रहनाथस्तु शोणाद्रिं विलंघयितुमुद्यतः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003685044, "chapter_id": 23685, "verse_number": "१-३-६-४५", "content_sanskrit": "रथवाहाः पुनस्तस्य शक्तिहीनाः श्रमं गताः ।\nसोऽपि श्रिया विहीनश्च जातः गोणाद्रितेजसा ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003685045, "chapter_id": 23685, "verse_number": "१-३-६-४६", "content_sanskrit": "नाशक्नोच्च दिवं गन्तुं सर्वगत्यांशुमालिनः ।\nस तु ब्रह्मोपदेशेन समाराध्यारुणाचलम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003685046, "chapter_id": 23685, "verse_number": "१-३-६-४७", "content_sanskrit": "प्रीत्या तस्माद्विभोर्लेभे मार्गं व्योम्नो हयाञ्छुभान् ।\nततः प्रभृति तिग्मांशुः स हि शोणाख्यपर्वतम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003685047, "chapter_id": 23685, "verse_number": "१-३-६-४८", "content_sanskrit": "न लंघयति किं त्वस्य प्रदक्षिणपरिक्रमैः ।\nदक्षयागपरिध्वस्ता हीनांगास्त्रिदशाः पुरा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003685048, "chapter_id": 23685, "verse_number": "१-३-६-४९", "content_sanskrit": "अरुणाचलमाराध्य नवान्यंगानि लेभिरे ।\nपूषा दन्तं शिखी हस्तं भगो नेत्रं त्वखंडितम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003685049, "chapter_id": 23685, "verse_number": "१-३-६-५०", "content_sanskrit": "घ्राणं वाणी च लेभे सा शोणाचलनिषेवणात् ।\nभार्गवः क्षीणनेत्रस्स विष्णुहस्तकुशाग्रतः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003685050, "chapter_id": 23685, "verse_number": "१-३-६-५१", "content_sanskrit": "बलिदत्तावनीदानजलधारानिरोधतः ।\nस तु शोणाचलं गत्वा तपः कृत्वातिदुष्करम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003685051, "chapter_id": 23685, "verse_number": "१-३-६-५२", "content_sanskrit": "लेभे नेत्रं च पूतात्मा भास्कराख्ये गिरौ स्थितः ।\nअरुणाचलनाथस्य सेवया सूर्यसारथिः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003685052, "chapter_id": 23685, "verse_number": "१-३-६-५३", "content_sanskrit": "प्रतर्दनाख्यो नृपतिर्ग्रहीतुं देवकन्यकाम् ।\nअरुणाद्रिपतेर्गानं कुर्वंतीं सादरोऽभवत् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003685053, "chapter_id": 23685, "verse_number": "१-३-६-५४", "content_sanskrit": "क्षणात्कपिमुखो जातो मंत्रिभिश्चोदितो नृपः ।\nप्रत्यर्प्य तां पुनश्चान्याः प्रादादरुणभूभृते ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003685054, "chapter_id": 23685, "verse_number": "१-३-६-५५", "content_sanskrit": "ततश्चारुमुखोजातः प्रसादादरुणेशितुः ।\nसायुज्यमस्मै सकलं दत्तवान्भक्तिभावतः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003685055, "chapter_id": 23685, "verse_number": "१-३-६-५६", "content_sanskrit": "अरुणाचलनाथस्यसंनिधौ ज्ञानदुर्बलः ।\nगंधर्वः पुष्पकाख्यस्तु भक्तिहीनो ह्यगात्पुरा ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003685056, "chapter_id": 23685, "verse_number": "१-३-६-५७", "content_sanskrit": "ततो व्याघ्रमुखं दृष्ट्वा गंधर्वपरिचारकाः ।\nकिमेतदिति साश्चर्यं पप्रछुस्ते परस्परम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003685057, "chapter_id": 23685, "verse_number": "१-३-६-५८", "content_sanskrit": "अथ नारद निर्दिष्टमवज्ञाफलमात्मनः ।\nबुद्ध्वारुणाद्रिं संपूज्य पुनश्च सुमुखोऽभवत् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003685058, "chapter_id": 23685, "verse_number": "१-३-६-५९", "content_sanskrit": "शिवभूमिरियं ख्याता परितो योजनद्वयम् ।\nमुक्तिस्तत्र प्रमीतानां कदापि विलयो न हि ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003685059, "chapter_id": 23685, "verse_number": "१-३-६-६०", "content_sanskrit": "सप्तर्षयः पुरा भूमौ शापदोषसमन्विताः ।\nसिषेविरेरुणाद्रिं वै नाथो ज्ञात्वा विनिश्चयम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003685060, "chapter_id": 23685, "verse_number": "१-३-६-६१", "content_sanskrit": "शापमोक्षं ददौ श्रीमान्सप्तर्षीणां महात्मनाम् ।\nसप्तर्षिभिः कृतं तीर्थं सर्वपापविनाशनम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003685061, "chapter_id": 23685, "verse_number": "१-३-६-६२", "content_sanskrit": "शोणाचलस्य निकटे दृश्यते पावनं शुभम् ।\nपंगुर्मुनिः शोणशैलात्पादौ लब्धुं समागतः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003685062, "chapter_id": 23685, "verse_number": "१-३-६-६३", "content_sanskrit": "अंतर्हितप्रार्थितार्थो दारुहस्तपुटे वहन् ।\nजानुचंक्रमणव्यग्रः शोणनद्यास्तटं गतः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003685063, "chapter_id": 23685, "verse_number": "१-३-६-६४", "content_sanskrit": "दारुहस्तपुटे तीर्थे निचिक्षेप पिपासतः ।\nजानुचंक्रमणे तस्मिन्धूर्तस्तोयं पिपासति ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003685064, "chapter_id": 23685, "verse_number": "१-३-६-६५", "content_sanskrit": "अथ शोणाचलं प्राप्तः कथं वा दारुहस्तकः ।\nकिमेतदिति तं पृच्छन्नाधावत्कलितत्परः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003685065, "chapter_id": 23685, "verse_number": "१-३-६-६६", "content_sanskrit": "लब्धपादश्च सहसा जगाम च निजालयम् ।\nनाद्राक्षीत्पुरुषं तत्र दारुहस्तौ पुरोगमौ ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003685066, "chapter_id": 23685, "verse_number": "१-३-६-६७", "content_sanskrit": "स्वयं गृहीत्वा चालोक्य ववंदेऽरुणपर्वतम् ।\nननंद लब्धचरणो लब्धरूपो महामुनिः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003685067, "chapter_id": 23685, "verse_number": "१-३-६-६८", "content_sanskrit": "विस्मयोत्फुल्लनयनैः शिवभक्तैर्महात्मभिः ।\nपूजितो लब्धपादः सञ्जगाम च यथागतम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003685068, "chapter_id": 23685, "verse_number": "१-३-६-६९", "content_sanskrit": "वाली शक्रसुतः श्रीमाञ्छ्रंगादुदयभूभृतः ।\nअस्ताचलस्य शिखरं प्रतिगन्तुं समुद्यतः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003685069, "chapter_id": 23685, "verse_number": "१-३-६-७०", "content_sanskrit": "आलुलोकेऽरुणगिरिं मध्ये देवनमस्कृतम् ।\nऊर्ध्वं गंतुं समुद्युक्तः क्षीणवीर्योऽपतद्भुवि ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003685070, "chapter_id": 23685, "verse_number": "१-३-६-७१", "content_sanskrit": "पित्रा शक्रेण संगम्य चोदितः शोणपर्वतम् ।\nलिंगं तैजसमभ्यर्च्य लब्धवीर्योऽभवत्पुनः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003685071, "chapter_id": 23685, "verse_number": "१-३-६-७२", "content_sanskrit": "नलः पूर्वं समभ्यर्च्य स्वसृष्टा मानवप्रियाः ।\nपालयामास धर्मात्मा नीतिसारसमन्वितः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003685072, "chapter_id": 23685, "verse_number": "१-३-६-७३", "content_sanskrit": "इलः प्रविश्य सहसा गौरीवनमखंडितम् ।\nस्त्रीभावं समनुप्राप्तः पप्रच्छ स्वं पुरोधसम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003685073, "chapter_id": 23685, "verse_number": "१-३-६-७४", "content_sanskrit": "वशिष्ठेन समादिष्टः शोणाद्रिं समपूजयत् ।\nतपसाराध्य देवेशं पुनः पुंस्त्वमुपागतः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003685074, "chapter_id": 23685, "verse_number": "१-३-६-७५", "content_sanskrit": "सोमोपदेशाद्भक्त्याथ सस्मारारुणपर्वतम् ।\nईशानुग्रहतो लेभे शापमोक्षं तपोधिकः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003685075, "chapter_id": 23685, "verse_number": "१-३-६-७६", "content_sanskrit": "लेभे च परमं स्थानमप्राप्यममरैरपि ।\nभरतो मृगशावस्य स्मरणादायुषोऽत्यये ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003685076, "chapter_id": 23685, "verse_number": "१-३-६-७७", "content_sanskrit": "न मुक्तिं प्राप योगेन मृगजन्मनि संगतः ।\nपत्नीविरहजं दुःखं प्राप्तवानमितं हरिः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003685077, "chapter_id": 23685, "verse_number": "१-३-६-७८", "content_sanskrit": "पुनर्भृगूपदेशेन शोणाद्रिमिममर्चयन् ।\nअवतारेषु सर्वेषु सर्वदुःखान्यपाकरोत् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003685078, "chapter_id": 23685, "verse_number": "१-३-६-७९", "content_sanskrit": "सरस्वती च सावित्री श्रीर्भूमिः सरितस्तथा ।\nअभ्यर्च्य शोणशैलेशमापदो निरतारिषुः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003685079, "chapter_id": 23685, "verse_number": "१-३-६-८०", "content_sanskrit": "भास्करः पूर्वदिग्भागे विश्वामित्रस्तु दक्षिणे ।\nपश्चिमे वरुणो भागे त्रिशूलं चोत्तराश्रयम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003685080, "chapter_id": 23685, "verse_number": "१-३-६-८१", "content_sanskrit": "योजनद्वयपर्यंते सीमाः शैलेषु संस्थिताः ।\nचतस्रो देवतास्त्वेताः सेवंते शोणपर्वतम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003685081, "chapter_id": 23685, "verse_number": "१-३-६-८२", "content_sanskrit": "स्थिताः सीमावसानेषु शोणाद्रीशमवस्थितम् ।\nनमंति देवाश्चत्वारः शिवं शोणाचलाकृतिम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003685082, "chapter_id": 23685, "verse_number": "१-३-६-८३", "content_sanskrit": "अस्योत्तरस्मिञ्छिखरे दृश्यते वटभूरुहः ।\nसिद्धवेषः सदैवास्ते यस्य मूले महेश्वरः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003685083, "chapter_id": 23685, "verse_number": "१-३-६-८४", "content_sanskrit": "यस्य च्छायातिमहती सर्वदा मण्डलाकृतिः ।\nलक्ष्यते विस्मयोपेतैः सर्वदा देवमानवैः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003685084, "chapter_id": 23685, "verse_number": "१-३-६-८५", "content_sanskrit": "अष्टभिः परितो लिंगैरष्टदिक्पालपूजितैः ।\nअष्टासु संस्थितैर्दिक्षु शोभते ह्युपसेवितः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003685085, "chapter_id": 23685, "verse_number": "१-३-६-८६", "content_sanskrit": "नृपाणां शम्भुभक्तानां शंकराज्ञानुपालिनाम् ।\nअत्रैव महदास्थानमादिदेवेन निर्मितम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003685086, "chapter_id": 23685, "verse_number": "१-३-६-८७", "content_sanskrit": "बकुलश्च महांस्तत्र सदार्थितफलप्रदः ।\nआगमार्थविदा मूले वामदेवेन सेव्यते ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003685087, "chapter_id": 23685, "verse_number": "१-३-६-८८", "content_sanskrit": "अगस्त्यश्च वशिष्ठश्च संपूज्यारुणभूधरम् ।\nसंस्थाप्य लिंगे विमले तेपाते तादृशं तपः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003685088, "chapter_id": 23685, "verse_number": "१-३-६-८९", "content_sanskrit": "हिरण्यगर्भतनयः पुरा शोणनदः पुमान् ।\nअत्र तीव्रं तपस्तप्त्वा गंगाभिमुखगोऽभवत ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003685089, "chapter_id": 23685, "verse_number": "१-३-६-९०", "content_sanskrit": "अत्र शोणनदी पुण्या प्रवहत्यमलोदका ।\nवेणा च पुण्यतटिनी परितः सेवतेऽचलम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003685090, "chapter_id": 23685, "verse_number": "१-३-६-९१", "content_sanskrit": "वायव्याश्च दिशो भागे वायुतीर्थं च शोभते ।\nतत्र स्नात्वा मरुत्पूर्वं जगत्प्राणत्वमाप्तवान् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003685091, "chapter_id": 23685, "verse_number": "१-३-६-९२", "content_sanskrit": "उत्तरेऽस्य गिरेस्तीर्थं सुवर्णकमलोज्ज्वलम् ।\nदिव्यसौगंधिकाकीर्णं हंसभृंगमनोहरम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003685092, "chapter_id": 23685, "verse_number": "१-३-६-९३", "content_sanskrit": "कौबेरं तीर्थमेशान्यामैशान्यं तीर्थमुत्तमम् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003685093, "chapter_id": 23685, "verse_number": "१-३-६-९४", "content_sanskrit": "तस्यैव पश्चिमे भागे विष्णुः कमललोचनः ।\nस्नात्वा विष्णुत्वमभजत्कमलालालिताकृतिः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003685094, "chapter_id": 23685, "verse_number": "१-३-६-९५", "content_sanskrit": "नवग्रहाः पुरा तत्र स्नात्वा ग्रहपदं गताः ।\nनवग्रहप्रसादश्च जायते तत्र मज्जताम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003685095, "chapter_id": 23685, "verse_number": "१-३-६-९६", "content_sanskrit": "दुर्गा विनायक स्कन्दो क्षेत्रपालः सरस्वती ।\nरक्षंति परितस्तीर्थं ग्राहयमेतदनन्तरम् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003685096, "chapter_id": 23685, "verse_number": "१-३-६-९७", "content_sanskrit": "गंगा च यमुना चैव गोदावरी सरस्वती ।\nनर्मदासिन्धुकावेर्यः शोणः शोर्णनदी च सा ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003685097, "chapter_id": 23685, "verse_number": "१-३-६-९८", "content_sanskrit": "एता गूढा निषेवंते पूर्वाद्याशासु संततम् ।\nनश्यंत्यः सकलं पापमात्मक्षेत्रसमुद्भवम् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003685098, "chapter_id": 23685, "verse_number": "१-३-६-९९", "content_sanskrit": "अन्याश्च सरितो दिव्याः पार्थिव्यश्च शुभोदकाः ।\nउदजृंभंत सहसा शोणाद्रीशप्रसादतः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003685099, "chapter_id": 23685, "verse_number": "१-३-६-१००", "content_sanskrit": "आगस्त्यं दक्षिणे भागे तीर्थं महदुदाहृतम् ।\nसर्वभाषार्थसंसिद्धिर्जायते तत्र मज्जताम् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003685100, "chapter_id": 23685, "verse_number": "१-३-६-१०१", "content_sanskrit": "अत्रागस्त्यः समागत्य स्नात्वा मुनिगणावृतः ।\nअभ्यर्चयति शोणाद्रिं मासि भाद्रपदे सदा ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003685101, "chapter_id": 23685, "verse_number": "१-३-६-१०२", "content_sanskrit": "वाशिष्ठमुत्तरे भागे तीर्थं दिव्यं शुभोदयम् ।\nसर्ववेदार्थसंसिद्धिर्जायते तत्र मज्जनात् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003685102, "chapter_id": 23685, "verse_number": "१-३-६-१०३", "content_sanskrit": "अत्र मेरोः समागत्य वशिष्ठो भगवानृषिः ।\nकरोत्याश्वयुजे मासि शोणाद्रीशनिषेवणम् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003685103, "chapter_id": 23685, "verse_number": "१-३-६-१०४", "content_sanskrit": "गंगानाम महत्तीर्थं पूर्वोत्तरदिशि स्थितम् ।\nतत्र स्नानाद्भवेन्नृणां सर्वपातकनाशनम् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003685104, "chapter_id": 23685, "verse_number": "१-३-६-१०५", "content_sanskrit": "गंगाद्याः सरितः सर्वाः कार्त्तिके मासि संगताः ।\nअत्रारुणाद्रिनाथस्य सेवां कुर्वंति सादरम् ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003685105, "chapter_id": 23685, "verse_number": "१-३-६-१०६", "content_sanskrit": "ब्राह्म्यं नाम महातीर्थमरुणाद्रीशसन्निधौ ।\nतस्योपसंगमात्सद्यो ब्रह्महत्यादि नश्यति ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003685106, "chapter_id": 23685, "verse_number": "१-३-६-१०७", "content_sanskrit": "मार्गे मासि समागत्य ब्रह्मलोकात्पितामहः ।\nस्नात्वा तत्प्रत्यहं देवमर्चयत्यरुणाचलम् ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003685107, "chapter_id": 23685, "verse_number": "१-३-६-१०८", "content_sanskrit": "पौषे मासि समागत्य स्नात्वा तीर्थे निजैः सुरैः ।\nमहेन्द्रः शोणशैलेशमभ्यर्चयति शंकरम् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003685108, "chapter_id": 23685, "verse_number": "१-३-६-१०९", "content_sanskrit": "शैवंनाम महातीर्थं संनिधौ तत्र वर्तते ।\nरुद्रो ब्रह्मकपालेन सह तत्र न्यमज्जत ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003685109, "chapter_id": 23685, "verse_number": "१-३-६-११०", "content_sanskrit": "अत्र शम्भुर्गणैः सार्द्धं माघे मासि प्रसीदति ।\nप्रायश्चित्तानि सर्वाणि नॄणां सफलयन्भुवि ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003685110, "chapter_id": 23685, "verse_number": "१-३-६-१११", "content_sanskrit": "आग्नेयमग्निदिग्भागे तीर्थं सौभाग्यदायकम् ।\nअग्निरत्र पुरा स्नात्वा स्वाहया संगतः सुखी ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003685111, "chapter_id": 23685, "verse_number": "१-३-६-११२", "content_sanskrit": "अनंगोपि स्मरः स्नात्वा फाल्गुने मासि संगतः ।\nअभ्यर्च्य शोणशैलेशमभूत्सर्वसुखाधिपः ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003685112, "chapter_id": 23685, "verse_number": "१-३-६-११३", "content_sanskrit": "दिशि दक्षिणपूर्वस्यां वैष्णवं तीर्थमद्भुतम् ।\nब्रह्मर्षयः सदा तत्र वसंति कृतकौतुकाः ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003685113, "chapter_id": 23685, "verse_number": "१-३-६-११४", "content_sanskrit": "चैत्रे मासि समागत्य विष्णुस्तत्र रमापतिः ।\nस्नात्वाभ्यर्च्यारुणाद्रीशमभवल्लोकनायकः ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003685114, "chapter_id": 23685, "verse_number": "१-३-६-११५", "content_sanskrit": "सौरंनाम महातीर्थं कौबेरदिशि जृंभितम् ।\nसर्वरोगोपशांतिश्च जायते तत्र मज्जनात् ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003685115, "chapter_id": 23685, "verse_number": "१-३-६-११६", "content_sanskrit": "वैशाखे मासि दिनकृत्स्नात्वात्रेशं निषेवते ।\nवालखिल्यैः समं श्रीमान्वेदैश्च सह संगतः ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7003685116, "chapter_id": 23685, "verse_number": "१-३-६-११७", "content_sanskrit": "आश्विनं पावनं तीर्थमीशब्रह्मोत्तरे स्थितम् ।\nआप्लुतौ भिपजौ दस्रौ पूतावत्र निमज्जनात् ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7003685117, "chapter_id": 23685, "verse_number": "१-३-६-११८", "content_sanskrit": "अत्राश्विनौ समागत्य स्नात्वाभ्यर्च्य च शंकरम् ।\nदक्षिणे शोण शैलस्य निकटे वर्त्तते शुभम् ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7003685118, "chapter_id": 23685, "verse_number": "१-३-६-११९", "content_sanskrit": "कामदं मोक्षदं चैव तीर्थं पांडवसंज्ञितम् ।\nपुरा हि पांडवास्तत्र मजनात्क्षितिनायकाः ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7003685119, "chapter_id": 23685, "verse_number": "१-३-६-१२०", "content_sanskrit": "अत्र धात्री समागत्य सर्वौषधिफलान्विता ।\nज्येष्ठे मासि समं देवैरार्चयच्चारुणाचलम् ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7003685120, "chapter_id": 23685, "verse_number": "१-३-६-१२१", "content_sanskrit": "आषाढे मासि संत्यक्ता विश्वेदेवा महाबलाः ।\nअभ्यर्च्य शोणशैलेशमागच्छन्मखराध्यताम् ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7003685121, "chapter_id": 23685, "verse_number": "१-३-६-१२२", "content_sanskrit": "वैश्वदेवं महातीर्थं सोमसूर्योत्तराश्रयम् ।\nविश्वाधिपत्यमतुलं लभ्यते तत्र मज्जनात् ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7003685122, "chapter_id": 23685, "verse_number": "१-३-६-१२३", "content_sanskrit": "परितो लक्ष्यते तीर्थं पूर्वस्यां दिशि शोभने ।\nअत्र लक्ष्मीः पुरा स्नात्वा लेभे पुरुषमुत्तमम् ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7003685123, "chapter_id": 23685, "verse_number": "१-३-६-१२४", "content_sanskrit": "उत्तरस्यां दिशि पुरा पुण्या स्कंदनदी स्थिता ।\nअत्र स्नात्वा पुरा स्कंदः संप्राप्तो विपुलं बलम् ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7003685124, "chapter_id": 23685, "verse_number": "१-३-६-१२५", "content_sanskrit": "पश्चिमस्यां दिशि ख्याता परा कुंभनदी शुभा ।\nअगस्त्यः कुंभकः कुंभस्तत्र नित्यं व्यवस्थितः ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7003685125, "chapter_id": 23685, "verse_number": "१-३-६-१२६", "content_sanskrit": "गंगा च मूलभागस्था यमुना गगने स्थिता ।\nसोमोद्भवा शिरोभागे सेवंते शोणपर्वतम् ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7003685126, "chapter_id": 23685, "verse_number": "१-३-६-१२७", "content_sanskrit": "बहून्यपि च तीर्थानि संभूतानि समंततः ।\nतेषां भेदान्पुरा वेत्तुं मार्कण्डेयस्तु नाशकत् ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7003685127, "chapter_id": 23685, "verse_number": "१-३-६-१२८", "content_sanskrit": "तपोभिर्बहुभिस्सोयं शोणाद्रीशमतोषयत् ।\nप्रार्थयामास च वरं प्रीतात्तस्मान्मुनीश्वरः ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7003685128, "chapter_id": 23685, "verse_number": "१-३-६-१२९", "content_sanskrit": "मार्कण्डेय उवाच ।\nभगवन्नरुणाद्रीश तीर्थभेदाः सहस्रशः ।\nप्रख्याताश्च प्रकाशंते दुर्बोधास्त्वल्पचेतसाम् ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7003685129, "chapter_id": 23685, "verse_number": "१-३-६-१३०", "content_sanskrit": "कथमेकत्र सांनिध्यं लभेरन्भुवि मानवाः ।\nअपर्याप्तश्च भवति पृथगेषां निषेवणे ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7003685130, "chapter_id": 23685, "verse_number": "१-३-६-१३१", "content_sanskrit": "अंतर्निगूढतेजास्त्वं गत्वा यस्सकलैः सुरैः ।\nआरण्यसे कुरु तथा शोणाद्रिस्पर्शभीरुभिः ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7003685131, "chapter_id": 23685, "verse_number": "१-३-६-१३२", "content_sanskrit": "अहं च शंभुमभ्यर्च्य तपसारुणपर्वतम् ।\nसर्वलोकोपकारार्थं सूक्ष्म लिंगमपूजयम् ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7003685132, "chapter_id": 23685, "verse_number": "१-३-६-१३३", "content_sanskrit": "विश्वकर्मकृतं दिव्यं विमानं विविधोत्सवम् ।\nसंकल्प्य सकलान्भोगान्नित्यानजनयत्पुनः ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7003685133, "chapter_id": 23685, "verse_number": "१-३-६-१३४", "content_sanskrit": "धर्मशास्त्राणि विविधान्यवापुर्मुनिपुंगवाः ।\nशिवकार्याणि सर्वाणि चक्रुभक्तिसमन्विताः ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7003685134, "chapter_id": 23685, "verse_number": "१-३-६-१३५", "content_sanskrit": "मया च शंभुमभ्यर्च्य कृताग्न्याहुतिसंभवाः ।\nसप्त कन्या वरारोहाः पूजार्थं विनियोजिताः ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7003685135, "chapter_id": 23685, "verse_number": "१-३-६-१३६", "content_sanskrit": "हतशत्रुगणैभूपैर्लब्धराज्यैः पुरा नृपैः ।\nप्रत्येकं विविधैर्भोगैः शोणशैलाधिपोर्चितः ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7003685136, "chapter_id": 23685, "verse_number": "१-३-६-१३७", "content_sanskrit": "इदमनुभववैभवं विचित्रं दुरितहरं शिवलिंगमद्रिरूपम् ।\nअमलमनभिगम्यनामधेयं वरमरुणाद्रिनायकं भजस्व ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7003685137, "chapter_id": 23685, "verse_number": "१-३-६-१३८", "content_sanskrit": "अवनतजनरक्षणोचितस्य स्मरणनिराकृतविश्वकल्मषस्य ।\nभजनममितपुण्यराशियोगादरुणगिरेः कृतिनः परं लभस्व ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7003685138, "chapter_id": 23685, "verse_number": "१-३-६-१३९", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां प्रथमे माहेश्वरखण्डेऽरुणाचलमाहात्म्ये पूर्वार्धेऽरुणाचलस्थविविधतीर्थमाहात्म्यवर्णनंनाम षष्ठोऽध्यायः ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}]