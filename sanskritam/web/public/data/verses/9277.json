[{"id": 5000277000, "chapter_id": 9277, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे पञ्चमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000277001, "chapter_id": 9277, "verse_number": "४-५-१", "content_sanskrit": "ऋष्यमूकात् तु हनुमान् गत्वा तं मलयं गिरिम्।\nआचचक्षे तदा वीरौ कपिराजाय राघवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000277002, "chapter_id": 9277, "verse_number": "४-५-२", "content_sanskrit": "अयं रामो महाप्राज्ञ सम्प्राप्तो दृढविक्रमः।\nलक्ष्मणेन सह भ्रात्रा रामोऽयं सत्यविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000277003, "chapter_id": 9277, "verse_number": "४-५-३", "content_sanskrit": "इक्ष्वाकूणां कुले जातो रामो दशरथात्मजः।\nधर्मे निगदितश्चैव पितुर्निर्देशकारकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000277004, "chapter_id": 9277, "verse_number": "४-५-४", "content_sanskrit": "राजसूयाश्वमेधैश्च वह्निर्येनाभितर्पितः।\nदक्षिणाश्च तथोत्सृष्टा गावः शतसहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000277005, "chapter_id": 9277, "verse_number": "४-५-५", "content_sanskrit": "तपसा सत्यवाक्येन वसुधा येन पालिता।\nस्त्रीहेतोस्तस्य पुत्रोऽयं रामोऽरण्यं समागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000277006, "chapter_id": 9277, "verse_number": "४-५-६", "content_sanskrit": "तस्यास्य वसतोऽरण्ये नियतस्य महात्मनः।\nरावणेन हृता भार्या स त्वां शरणमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000277007, "chapter_id": 9277, "verse_number": "४-५-७", "content_sanskrit": "भवता सख्यकामौ तौ भ्रातरौ रामलक्ष्मणौ।\nप्रगृह्य चार्चयस्वैतौ पूजनीयतमावुभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000277008, "chapter_id": 9277, "verse_number": "४-५-८", "content_sanskrit": "श्रुत्वा हनूमतो वाक्यं सुग्रीवो वानराधिपः।\nदर्शनीयतमो भूत्वा प्रीत्योवाच च राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000277009, "chapter_id": 9277, "verse_number": "४-५-९", "content_sanskrit": "भवान् धर्मविनीतश्च सुतपाः सर्ववत्सलः।\nआख्याता वायुपुत्रेण तत्त्वतो मे भवद‍्गुणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000277010, "chapter_id": 9277, "verse_number": "४-५-१०", "content_sanskrit": "तन्ममैवैष सत्कारो लाभश्चैवोत्तमः प्रभो।\nयत्त्वमिच्छसि सौहार्दं वानरेण मया सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000277011, "chapter_id": 9277, "verse_number": "४-५-११", "content_sanskrit": "रोचते यदि मे सख्यं बाहुरेष प्रसारितः।\nगृह्यतां पाणिना पाणिर्मर्यादा बध्यतां ध्रुवा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000277012, "chapter_id": 9277, "verse_number": "४-५-१२", "content_sanskrit": "एतत् तु वचनं श्रुत्वा सुग्रीवस्य सुभाषितम्।\nसम्प्रहृष्टमना हस्तं पीडयामास पाणिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000277013, "chapter_id": 9277, "verse_number": "४-५-१३", "content_sanskrit": "हृष्टः सौहृदमालम्ब्य पर्यष्वजत पीडितम्।\nततो हनूमान् संत्यज्य भिक्षुरूपमरिंदमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000277014, "chapter_id": 9277, "verse_number": "४-५-१४", "content_sanskrit": "काष्ठयोः स्वेन रूपेण जनयामास पावकम्।\nदीप्यमानं ततो वह्निं पुष्पैरभ्यर्च्य सत्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000277015, "chapter_id": 9277, "verse_number": "४-५-१५", "content_sanskrit": "तयोर्मध्ये तु सुप्रीतो निदधौ सुसमाहितः।\nततोऽग्निं दीप्यमानं तौ चक्रतुश्च प्रदक्षिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000277016, "chapter_id": 9277, "verse_number": "४-५-१६", "content_sanskrit": "सुग्रीवो राघवश्चैव वयस्यत्वमुपागतौ।\nततः सुप्रीतमनसौ तावुभौ हरिराघवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000277017, "chapter_id": 9277, "verse_number": "४-५-१७", "content_sanskrit": "अन्योन्यमभिवीक्षन्तौ न तृप्तिमभिजग्मतुः।\nत्वं वयस्योऽसि हृद्यो मे ह्येकं दुःखं सुखं च नौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000277018, "chapter_id": 9277, "verse_number": "४-५-१८", "content_sanskrit": "सुग्रीवो राघवं वाक्यमित्युवाच प्रहृष्टवत्।\nततः सुपर्णबहुलां भङ्‍क्त्वा शाखां सुपुष्पिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000277019, "chapter_id": 9277, "verse_number": "४-५-१९", "content_sanskrit": "सालस्यास्तीर्य सुग्रीवो निषसाद सराघवः।\nलक्ष्मणायाथ संहृष्टो हनुमान् मारुतात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000277020, "chapter_id": 9277, "verse_number": "४-५-२०", "content_sanskrit": "शाखां चन्दनवृक्षस्य ददौ परमपुष्पिताम्।\nततः प्रहृष्टः सुग्रीवः श्लक्ष्णं मधुरया गिरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000277021, "chapter_id": 9277, "verse_number": "४-५-२१", "content_sanskrit": "प्रत्युवाच तदा रामं हर्षव्याकुललोचनः।\nअहं विनिकृतो राम चरामीह भयार्दितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000277022, "chapter_id": 9277, "verse_number": "४-५-२२", "content_sanskrit": "हृतभार्यो वने त्रस्तो दुर्गमेतदुपाश्रितः।\nसोऽहं त्रस्तो वने भीतो वसाम्युद्‍भ्रान्तचेतनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000277023, "chapter_id": 9277, "verse_number": "४-५-२३", "content_sanskrit": "वालिना निकृतो भ्रात्रा कृतवैरश्च राघव।\nवालिनो मे महाभाग भयार्तस्याभयं कुरु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000277024, "chapter_id": 9277, "verse_number": "४-५-२४", "content_sanskrit": "कर्तुमर्हसि काकुत्स्थ भयं मे न भवेद् यथा।\nएवमुक्तस्तु तेजस्वी धर्मज्ञो धर्मवत्सलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000277025, "chapter_id": 9277, "verse_number": "४-५-२५", "content_sanskrit": "प्रत्यभाषत काकुत्स्थः सुग्रीवं प्रहसन्निव।\nउपकारफलं मित्रं विदितं मे महाकपे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000277026, "chapter_id": 9277, "verse_number": "४-५-२६", "content_sanskrit": "वालिनं तं वधिष्यामि तव भार्यापहारिणम्।\nअमोघाः सूर्यसंकाशा ममेमे निशिताः शराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000277027, "chapter_id": 9277, "verse_number": "४-५-२७", "content_sanskrit": "तस्मिन् वालिनि दुर्वृत्ते निपतिष्यन्ति वेगिताः।\nकङ्कपत्रप्रतिच्छन्ना महेन्द्राशनिसंनिभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000277028, "chapter_id": 9277, "verse_number": "४-५-२८", "content_sanskrit": "तीक्ष्णाग्रा ऋजुपर्वाणः सरोषा भुजगा इव।\nतमद्य वालिनं पश्य तीक्ष्णैराशीविषोपमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000277029, "chapter_id": 9277, "verse_number": "४-५-२९", "content_sanskrit": "शरैर्विनिहतं भूमौ प्रकीर्णमिव पर्वतम्।\nस तु तद् वचनं श्रुत्वा राघवस्यात्मनो हितम्।\nसुग्रीवः परमप्रीतः परमं वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000277030, "chapter_id": 9277, "verse_number": "४-५-३०", "content_sanskrit": "तव प्रसादेन नृसिंह वीर\nप्रियां च राज्यं च समाप्नुयामहम्।\nतथा कुरु त्वं नरदेव वैरिणं\nयथा न हिंस्यात् स पुनर्ममाग्रजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000277031, "chapter_id": 9277, "verse_number": "४-५-३१", "content_sanskrit": "सीताकपीन्द्रक्षणदाचराणां\nराजीवहेमज्वलनोपमानि।\nसुग्रीवरामप्रणयप्रसङ्गे\nवामानि नेत्राणि समं स्फुरन्ति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000277032, "chapter_id": 9277, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे पञ्चमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]