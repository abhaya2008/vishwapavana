[{"id": 40018017, "chapter_id": 9277, "verse_number": "1", "content_sanskrit": "ततश्शरान् दाशरथिस्सन्धायामित्रकर्शणः । ससर्जराक्षसेन्द्रायकृद्धस्सर्पइवश्वसन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40018018, "chapter_id": 9277, "verse_number": "2", "content_sanskrit": "तस्यज्यातलनिर्घोषं स श्रुत्वाराक्षसाधिपः । विवर्णवदनोभूत्वालक्ष्मणंसमुदैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40018019, "chapter_id": 9277, "verse_number": "3", "content_sanskrit": "विषण्णवदनंदृष्टवाराक्षसंरावणात्मजे । सौमित्रिंयुद्धसंयुक्तंप्रत्युवाचविभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40018020, "chapter_id": 9277, "verse_number": "4", "content_sanskrit": "निमित्तान्युपपश्यामियान्यस्मिन् रावणात्मजे । त्वरतेनमहाबाहोभग्नएष न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40018021, "chapter_id": 9277, "verse_number": "5", "content_sanskrit": "ततस्सन्धायसौमित्रिश्शरानग्निशिखोपमान् । मुमोचनिशितांस्तस्मिन् सर्पानिवमहाविषान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40018022, "chapter_id": 9277, "verse_number": "6", "content_sanskrit": "शक्राशनिसमस्पर्शैर्लक्ष्मणेनाहतश्शरैः । मुहूर्तमभवन्मूक्षःसर्वसंक्षुभितेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40018023, "chapter_id": 9277, "verse_number": "7", "content_sanskrit": "उपलभ्यमुहूर्तेनसंज्ञांप्रत्यागतेन्द्रियः । ददर्शावस्थितंवीरंवीरोदशरथात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40018024, "chapter_id": 9277, "verse_number": "8", "content_sanskrit": "सोऽभिचक्रामसौमित्रिंरोषात्संरक्तलोचनः । अब्रवीच्चैनमासाद्यपुनस्सपरुषंवचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40018025, "chapter_id": 9277, "verse_number": "9", "content_sanskrit": "किं न स्मरसितद्युद्धेप्रथमेमत्पराक्रमम् । निबद्धस्त्वंसहभ्रात्रायदाभुविविचेष्टसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40018026, "chapter_id": 9277, "verse_number": "10", "content_sanskrit": "युवांखलुमहायुद्धेशक्रानिसमैश्शरैः । शायितौप्रथमंभूमौविसंज्ञौसपुरस्सरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40018027, "chapter_id": 9277, "verse_number": "11", "content_sanskrit": "स्मृतिर्वानास्तितेमन्येव्यक्तंवायमसादनम् । गन्तुमिच्छसियस्मात्त्वमंधर्षयितुमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40018028, "chapter_id": 9277, "verse_number": "12", "content_sanskrit": "यदितेप्रथमेयुद्धे न दृष्टोमत्पराक्रमः । अद्यतेदर्शयिष्यामितिष्ठेदानींव्यवस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40018029, "chapter_id": 9277, "verse_number": "13", "content_sanskrit": "इत्युक्त्वासप्तभिर्भाणैरभिविव्याथलक्ष्मणम् । दशभिस्तुहनूमन्तंतीक्ष्णधाश्शरोत्तमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40018030, "chapter_id": 9277, "verse_number": "14", "content_sanskrit": "ततःशरशतेनैवसुप्रयुक्तेनवीर्यवान् । क्रोथाव्दिगुणसम्रब्धोनिर्बिभेदविभीषणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40018031, "chapter_id": 9277, "verse_number": "15", "content_sanskri