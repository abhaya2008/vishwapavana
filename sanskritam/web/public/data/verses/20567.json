[{"id": 7000567000, "chapter_id": 20567, "verse_number": "५-२६-१", "content_sanskrit": "शेष उवाच ।\nशत्रुघ्नस्तद्बलं दृष्ट्वा भीषणाकृतिमेघवत् ।\nहस्त्यश्वरथपादातैर्बहुभिः परिवारितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000567001, "chapter_id": 20567, "verse_number": "५-२६-२", "content_sanskrit": "सुमतिं प्रत्युवाचेदं वचोगंभीरशब्दयुक् ।\nनानावाक्यविचारज्ञैः पंडितैः परिसेवितः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000567002, "chapter_id": 20567, "verse_number": "५-२६-३", "content_sanskrit": "शत्रुघ्न उवाच ।\nसुमते कस्य नगरं प्राप्तो मे हयसत्तमः ।\nबलमेतन्निरीक्षेहं पयोदधितरंगवत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000567003, "chapter_id": 20567, "verse_number": "५-२६-४", "content_sanskrit": "कस्यैतद्बलमुद्धर्षं चतुरंगसमन्वितम् ।\nपुरतो भाति युद्धाय समुपस्थितमादरात् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000567004, "chapter_id": 20567, "verse_number": "५-२६-५", "content_sanskrit": "एतत्सर्वं समाचक्ष्व यथावत्पृच्छतो मम ।\nयज्ज्ञात्वा युद्धसंस्थायै निर्दिशामि स्वकान्भटान् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000567005, "chapter_id": 20567, "verse_number": "५-२६-६", "content_sanskrit": "इति वाक्यं समाकर्ण्य सुमतिः शुभबुद्धिमान् ।\nउवाच वचनं प्रीतः शत्रुघ्नं वैरितापनम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000567006, "chapter_id": 20567, "verse_number": "५-२६-७", "content_sanskrit": "सुमतिरुवाच ।\nचक्रांका नगरी राजन्वर्तते सविधे शुभा ।\nयस्यां संति नराः पापरहिता विष्णुभक्तितः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000567007, "chapter_id": 20567, "verse_number": "५-२६-८", "content_sanskrit": "तस्याः पुर्याः पतिरयं सुबाहुर्धर्मवित्तमः ।\nतवायं पुरतो भाति पुत्रपौत्रसमावृतः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000567008, "chapter_id": 20567, "verse_number": "५-२६-९", "content_sanskrit": "स्वदारनिरतो नित्यं परदारपराङ्मुखः ।\nविष्णोः कथास्य कर्णस्थाना परार्थप्रकाशिनी ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000567009, "chapter_id": 20567, "verse_number": "५-२६-१०", "content_sanskrit": "परस्वं न समादत्ते षष्ठांशादधिकं नृपः ।\nब्राह्मणा विष्णुभक्त्यैव पूज्यंते तेन धर्मिणा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000567010, "chapter_id": 20567, "verse_number": "५-२६-११", "content_sanskrit": "नित्यं सेवारतो विष्णुपादपद्ममधुव्रतः ।\nएष स्वधर्मनिरतः परधर्मपराङ्मुखः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000567011, "chapter_id": 20567, "verse_number": "५-२६-१२", "content_sanskrit": "एतस्य बलतुल्यं हि न वीराणां बलं क्वचित् ।\nपुत्रस्य पतनं श्रुत्वा रोषशोकसमाकुलः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000567012, "chapter_id": 20567, "verse_number": "५-२६-१३", "content_sanskrit": "चतुरंगसमेतोऽयं युद्धाय समुपस्थितः ।\nतवापि वीरा बहवो लक्ष्मीनिधिमुखा अमून् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000567013, "chapter_id": 20567, "verse_number": "५-२६-१४", "content_sanskrit": "जेष्यंति शस्त्रसंघेन निर्दिशाशु परं हि तान् ।\nशत्रुघ्नस्तद्वचः श्रुत्वा प्रोवाच स्वभटान्वरान् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000567014, "chapter_id": 20567, "verse_number": "५-२६-१५", "content_sanskrit": "रणप्राप्तिभवोद्धर्षपूरपूरितमानसान् ।\nक्रौंचव्यूहोऽद्य रचितः सुबाहुपरिसैनिकैः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000567015, "chapter_id": 20567, "verse_number": "५-२६-१६", "content_sanskrit": "मुखपक्षस्थिता योधास्तान्को भेत्स्यति शस्त्रवित् ।\nयस्य भेदे निजा शक्तिर्यो वीर विजयोद्यतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000567016, "chapter_id": 20567, "verse_number": "५-२६-१७", "content_sanskrit": "स गृह्णातु मदीयाद्धि पाणिपद्माच्च वीटकम् ।\nतदा लक्ष्मीनिधिर्वीरो जग्राह क्रौंचभेदने ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000567017, "chapter_id": 20567, "verse_number": "५-२६-१८", "content_sanskrit": "सर्वशस्त्रास्त्रविद्वीरैर्बहुभिः परिवारितः ।\nउवाच वचनं राजन्यास्येऽहं क्रौंचभेदने ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000567018, "chapter_id": 20567, "verse_number": "५-२६-१९", "content_sanskrit": "भार्गवः पूर्वमेवासीत्क्रौंचभेत्ता तथा ह्यहम् ।\nतथान्यं वीरमावोचत्कोऽस्य सार्धं गमिष्यति ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000567019, "chapter_id": 20567, "verse_number": "५-२६-२०", "content_sanskrit": "पुष्कलः पृष्ठतस्तस्य यातुं चक्रे मतिं ततः ।\nरिपुतापो नीलरत्न उग्राश्वो वीरमर्दनः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000567020, "chapter_id": 20567, "verse_number": "५-२६-२१", "content_sanskrit": "सर्वे शत्रुघ्नसंदेशाद्ययुस्तत्क्रौंचभेदने ।\nशत्रुघ्नोऽपि रथस्थश्च सर्वायुधधरः परः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000567021, "chapter_id": 20567, "verse_number": "५-२६-२२", "content_sanskrit": "पृष्ठतोऽस्य परीयाय बहुभिः सैनिकैर्वृतः ।\nतदा प्रचलितौ दृष्टावन्योन्यबलवारिधी ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000567022, "chapter_id": 20567, "verse_number": "५-२६-२३", "content_sanskrit": "प्रलयं कर्तुमुद्युक्तौ जगतः सुतरंगिणौ ।\nतदा भेर्यः समाजघ्नुरुभयोः सेनयोर्दृढाः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000567023, "chapter_id": 20567, "verse_number": "५-२६-२४", "content_sanskrit": "रणभेर्यः शंखनादाः श्रूयंते तत्र तत्र ह ।\nहेषंते वाजिनस्तत्र गर्जंति द्विरदा भृशम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000567024, "chapter_id": 20567, "verse_number": "५-२६-२५", "content_sanskrit": "हुं हुं कुर्वंति वीराग्र्या नदंति रथनेमयः ।\nतत्र प्रकुपिताः शूराः सुबाहुबलदर्पिताः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000567025, "chapter_id": 20567, "verse_number": "५-२६-२६", "content_sanskrit": "छिंधि भिंधीति भाषंतो दृश्यंते बहवो रणे ।\nएवंभूते रणोद्युक्ते सैन्ये शत्रुघ्नवैरिणोः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000567026, "chapter_id": 20567, "verse_number": "५-२६-२७", "content_sanskrit": "मुखसंस्थं सुकेतुं तं लक्ष्मीनिधिरुवाच ह ।\nलक्ष्मीनिधिरुवाच ।\nजनकस्य सुतं विद्धि लक्ष्मीनिधिरिति स्मृतम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000567027, "chapter_id": 20567, "verse_number": "५-२६-२८", "content_sanskrit": "सर्वशस्त्रास्त्रकुशलं सर्वयुद्धविशारदम् ।\nमुंचाश्वं रामचंद्रस्य सर्वदानवदंशितुः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000567028, "chapter_id": 20567, "verse_number": "५-२६-२९", "content_sanskrit": "नोचेन्मद्बाणनिर्भिन्नो यास्यसे यमसादनम् ।\nइति ब्रुवंतं वीराग्र्यं सुकेतुः सहसा त्वरन् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000567029, "chapter_id": 20567, "verse_number": "५-२६-३०", "content_sanskrit": "सज्यं चापं विधायाशु बाणान्मुंचन्स्थिरोऽभवत् ।\nते बाणाः शितपर्वाणः स्वर्णपुंखाः समंततः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000567030, "chapter_id": 20567, "verse_number": "५-२६-३१", "content_sanskrit": "दृश्यंते व्यापिनस्तत्र रणमध्ये सुदुर्भराः ।\nतद्बाणजालं तरसा निहत्य ।\nलक्ष्मीनिधिश्चापमथा ततज्यम् ।\nविधाय तस्योरसि बाणषट्कं ।\nमुमोच तीक्ष्णं शितपर्वशोभितम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000567031, "chapter_id": 20567, "verse_number": "५-२६-३२", "content_sanskrit": "तद्बाणाः सुभुजभ्रातुर्हृदयं संविदार्य च ।\nगतास्ते भुवि दृश्यंते रुधिराक्ता मलीमसाः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000567032, "chapter_id": 20567, "verse_number": "५-२६-३३", "content_sanskrit": "तद्बाणभिन्नहृदयः सुकेतुः कोपपूरितः ।\nजघानशरविंशत्या तीक्ष्णया नतपर्वया ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000567033, "chapter_id": 20567, "verse_number": "५-२६-३४", "content_sanskrit": "उभौ बाणविभिन्नांगावुभौ क्षतजविप्लुतौ ।\nसैनिकैः परिदृश्यंते किंशुकाविव पुष्पितौ ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000567034, "chapter_id": 20567, "verse_number": "५-२६-३५", "content_sanskrit": "मुंचंतौ बाणकोटीश्च संदधंतौ त्वरा शरान् ।\nन केनापि विलक्ष्येते लघुहस्तौ महाबलौ ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000567035, "chapter_id": 20567, "verse_number": "५-२६-३६", "content_sanskrit": "कुंडलीकृत सच्चापौ वर्षंतौ बाणधारया ।\nनवांबुदाविव दिवि शक्रनिर्देशकारिणौ ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000567036, "chapter_id": 20567, "verse_number": "५-२६-३७", "content_sanskrit": "तयोर्बाणा गजान्वाहान्नराञ्छूरान्विमस्तकान् ।\nकुर्वंतः केवलं दृष्टा न च संधानमोक्षयोः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000567037, "chapter_id": 20567, "verse_number": "५-२६-३८", "content_sanskrit": "पृथिवी सुभटैः पूर्णा सकिरीटैः सकुंडलैः ।\nधनुर्बाणकरै रोषसंदष्टाधरयुग्मकैः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000567038, "chapter_id": 20567, "verse_number": "५-२६-३९", "content_sanskrit": "तयोः प्रयुद्ध्यतोर्दर्पात्सर्वशस्त्रास्त्रवेदिनोः ।\nयुद्धं समभवद्घोरं देवविस्मापनं महत् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000567039, "chapter_id": 20567, "verse_number": "५-२६-४०", "content_sanskrit": "संमर्दोऽभवदत्यंतं वीरकोटिविदारणः ।\nन केनचित्क्वचिद्दृष्टं शरजालांतरेंऽबरम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000567040, "chapter_id": 20567, "verse_number": "५-२६-४१", "content_sanskrit": "तस्मिंस्तु समये लक्ष्मीनिधिर्वीरोऽरिमर्दनः ।\nबाणांश्चापे समाधत्त वसुसंख्यान्दृढाञ्छितान् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000567041, "chapter_id": 20567, "verse_number": "५-२६-४२", "content_sanskrit": "चतुर्भिस्तुरगान्वीरः सुकेतोरनयत्क्षयम् ।\nएकेन ध्वजमत्युग्रं चिच्छेद तरसा हसन् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000567042, "chapter_id": 20567, "verse_number": "५-२६-४३", "content_sanskrit": "एकेन सारथेः कायाच्छिरोभूमावपातयत् ।\nएकेन चापं सगुणमच्छिनद्रोषपूरितः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000567043, "chapter_id": 20567, "verse_number": "५-२६-४४", "content_sanskrit": "एकेन हृदि विव्याध सुकेतोर्वेगवान्नृपः ।\nतत्कर्माद्भुतमुद्वीक्ष्य वीरा विस्मयमाययुः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000567044, "chapter_id": 20567, "verse_number": "५-२६-४५", "content_sanskrit": "सच्छिन्नधन्वा विरथो हताश्वो हतसारथिः ।\nमहतीं स गदां धृत्वा योद्घुकामोऽभ्युपेयिवान् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000567045, "chapter_id": 20567, "verse_number": "५-२६-४६", "content_sanskrit": "तमायांतं समालक्ष्य गदायुद्धविशारदम् ।\nमहत्या गदया युक्तं रथादवततार सः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000567046, "chapter_id": 20567, "verse_number": "५-२६-४७", "content_sanskrit": "गदामादाय महतीं सर्वायसविनिर्मिताम् ।\nजातरूपविचित्रांगीं सर्वशोभापुरस्कृताम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000567047, "chapter_id": 20567, "verse_number": "५-२६-४८", "content_sanskrit": "लक्ष्मीनिधिर्भृशं क्रुद्धः सुकेतोर्वक्षसि त्वरन् ।\nताडयामास हृदये गदां वज्राग्निसन्निभाम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000567048, "chapter_id": 20567, "verse_number": "५-२६-४९", "content_sanskrit": "गदया ताडितो वीरो नाकंपत महामुने ।\nमदोन्मत्तो यथा दंती बालेन स्रग्भिराहतः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000567049, "chapter_id": 20567, "verse_number": "५-२६-५०", "content_sanskrit": "उवाच तं स वीराग्र्यो नृपं लक्ष्मीनिधिं तदा ।\nसहस्वैकं प्रहारं मे यदि शूरः परंतप ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000567050, "chapter_id": 20567, "verse_number": "५-२६-५१", "content_sanskrit": "इत्युक्त्वा ताडयामास ललाटे गदया भृशम् ।\nगदया ताडितो भालेऽसृग्वमन्कुपितो भृशम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000567051, "chapter_id": 20567, "verse_number": "५-२६-५२", "content_sanskrit": "मूर्ध्नि तं ताडयामास गदया कालरूपया ।\nसुकेतुरपि तं स्कंधे ताडयामास धर्मवित् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000567052, "chapter_id": 20567, "verse_number": "५-२६-५३", "content_sanskrit": "एवं भृशं प्रकुपितौ गदायुद्धविशारदौ ।\nगदायुद्धं प्रकुर्वाणौ परस्परजयैषिणौ ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000567053, "chapter_id": 20567, "verse_number": "५-२६-५४", "content_sanskrit": "अन्योन्याघातविमतौ परस्परवधोद्यतौ ।\nन कोपि तत्र हीयेत न को जीयेत संयुगे ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000567054, "chapter_id": 20567, "verse_number": "५-२६-५५", "content_sanskrit": "मूर्ध्नि भाले तथा स्कंधे हृदि गात्रेषु सर्वतः ।\nरुधिरौघ परिक्लिन्नौ महाबलपराक्रमौ ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000567055, "chapter_id": 20567, "verse_number": "५-२६-५६", "content_sanskrit": "तदा लक्ष्मीनिधिः क्रुद्धो गदामुद्यम्य वेगवान् ।\nजगाम प्रबलं हंतुं हृदि राजानुजं बली ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000567056, "chapter_id": 20567, "verse_number": "५-२६-५७", "content_sanskrit": "तमायांतमथालोक्य स्वगदां महतीं दधत् ।\nययौ तं तरसा हंतुं राजभ्राता बलाद्बलम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000567057, "chapter_id": 20567, "verse_number": "५-२६-५८", "content_sanskrit": "गदां तेन विनिक्षिप्तां स्वकरे धृतवानयम् ।\nतयैव गदया तस्य हृदि जघ्ने महाबलः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000567058, "chapter_id": 20567, "verse_number": "५-२६-५९", "content_sanskrit": "स्वगदां तेन वै नीतां दृष्ट्वा लक्ष्मीनिधिर्नृपः ।\nबाहुयुद्धेन तं योद्धुमियेष बलवत्तमम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000567059, "chapter_id": 20567, "verse_number": "५-२६-६०", "content_sanskrit": "तदा राजानुजः क्रुद्धो बाहुभ्यामुपगृह्य तम् ।\nयुयुधे सर्वयुद्धस्य ज्ञातावीरेषु सत्तमः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000567060, "chapter_id": 20567, "verse_number": "५-२६-६१", "content_sanskrit": "तदा लक्ष्मीनिधिस्तस्य हृदि जघ्ने स्वमुष्टिना ।\nतदा सोपि शिरस्येनं मुष्टिमुद्यम्य चाहनत् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000567061, "chapter_id": 20567, "verse_number": "५-२६-६२", "content_sanskrit": "मुष्टिभिर्वज्रसंकाशैस्तलस्फोटैश्च दारुणैः ।\nअन्योन्यं जघ्नतुः क्रुद्धौ संदष्टाधरपल्लवौ ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000567062, "chapter_id": 20567, "verse_number": "५-२६-६३", "content_sanskrit": "मुष्टी मुष्टि दंता दंति कचा कचि नखा नखि ।\nउभयोरभवद्युद्धं तुमुलं रोमहर्षणम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000567063, "chapter_id": 20567, "verse_number": "५-२६-६४", "content_sanskrit": "तदा प्रकुपितो भ्राता नृपतेश्च रणे नृपम् ।\nगृहीत्वा भ्रामयित्वाथ पातयामास भूतले ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000567064, "chapter_id": 20567, "verse_number": "५-२६-६५", "content_sanskrit": "लक्ष्मीनिधिः करे गृह्य तं नृपानुजमुच्चकैः ।\nभ्रामयित्वा शतगुणं गजोपस्थे जघान तम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000567065, "chapter_id": 20567, "verse_number": "५-२६-६६", "content_sanskrit": "स तदा पतितो भूमौ संज्ञां प्राप्य क्षणादनु ।\nतथैव भ्रामयामास व्योम्नि वेगेन विक्रमी ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000567066, "chapter_id": 20567, "verse_number": "५-२६-६७", "content_sanskrit": "एवं प्रयुध्यमानौ तौ बाहुयुद्धं गतौ पुनः ।\nपादे पादं करे पाणिं हृदि हृद्वदने मुखम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000567067, "chapter_id": 20567, "verse_number": "५-२६-६८", "content_sanskrit": "एवं परस्परं श्लिष्टौ परस्परवधैषिणौ ।\nउभावपि पराक्रांतावुभावपि मुमूर्च्छतुः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000567068, "chapter_id": 20567, "verse_number": "५-२६-६९", "content_sanskrit": "तद्दृष्ट्वा विस्मयं प्राप्ताः प्रशशंसुः सहस्रशः ।\nधन्यो लक्ष्मीनिधिर्भूपो धन्यो राजानुजो बली ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]