[{"id": 6000041000, "chapter_id": 10041, "verse_number": null, "content_sanskrit": "अथ एकादशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000041001, "chapter_id": 10041, "verse_number": null, "content_sanskrit": "विदुर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_011/BhP_03.011.001.m4a", "display_order": 2}, {"id": 6000041002, "chapter_id": 10041, "verse_number": "३-११-१", "content_sanskrit": "अन्तर्हिते भगवति ब्रह्मा लोकपितामहः।\nप्रजाः ससर्ज कतिधा दैहिकीर्मानसीर्विभुः॥ ३/११/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_011/BhP_03.011.002.m4a", "display_order": 3, "topics": [{"text": "विरिञ्चेन पुनस्तपश्चरणेन विज्ञानं लब्ध्वा अण्डोदकपानेन स्वाधिष्ठानभूतपद्मेन लोकत्रयसर्जनचिन्तनम्", "range": "१–९"}]}, {"id": 6000041003, "chapter_id": 10041, "verse_number": "३-११-२", "content_sanskrit": "ये च मे भगवन् पृष्टास्त्वय्यर्था बहुवित्तम।\nतान् वदस्वानुपूर्व्येण च्छिन्धि नः सर्वसंशयान्॥ ३/११/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_011/BhP_03.011.003.m4a", "display_order": 4}, {"id": 6000041004, "chapter_id": 10041, "verse_number": null, "content_sanskrit": "शुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_011/BhP_03.011.004.m4a", "display_order": 5}, {"id": 6000041005, "chapter_id": 10041, "verse_number": "३-११-३", "content_sanskrit": "एवं सञ्चोदितस्तेन क्षत्त्रा कौषारवो मुनिः।\nप्रीतः प्रत्याह तान् प्रश्नान् हृदिस्थानथ भार्गव॥ ३/११/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_011/BhP_03.011.005.m4a", "display_order": 6}, {"id": 6000041006, "chapter_id": 10041, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_011/BhP_03.011.006.m4a", "display_order": 7}, {"id": 6000041007, "chapter_id": 10041, "verse_number": "३-११-४", "content_sanskrit": "विरिञ्चोऽपि तथा चक्रे दिव्यं वर्षशतं तपः।\nआत्मन्यात्मानमावेश्य यथाऽऽह भगवानजः॥ ३/११/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_011/BhP_03.011.007.m4a", "display_order": 8}, {"id": 6000041008, "chapter_id": 10041, "verse_number": "३-११-५", "content_sanskrit": "तद् विलोक्याब्जसम्भूतो वायुना यदधिष्ठितम्।\nपद्ममम्भश्च तत्कालकृतवीर्येण कम्पितम्॥ ३/११/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_011/BhP_03.011.008.m4a", "display_order": 9}, {"id": 6000041009, "chapter_id": 10041, "verse_number": "३-११-६", "content_sanskrit": "तपसा ह्येधमानेन विद्यया चात्मसंस्थया।\nविवृद्धविज्ञानबलो न्यपाद् वायुं सहाम्भसा॥ ३/११/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_011/BhP_03.011.009.m4a", "display_order": 10}, {"id": 6000041010, "chapter_id": 10041, "verse_number": "३-११-७", "content_sanskrit": "तद् विलोक्य वियद्व्यापि पुष्करं यदधिष्ठितः।\nअनेन लोकान्प्राग्लीनान्कल्पितास्मीत्यचिन्तयत्॥ ३/११/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_011/BhP_03.011.010.m4a", "display_order": 11}, {"id": 6000041011, "chapter_id": 10041, "verse_number": "३-११-८", "content_sanskrit": "पद्मकोशं तदाविश्य भगवान् कर्मचोदितः।\nएकं व्यभाङ्क्षीदुरुधा त्रिधा भाव्य द्विसप्तधा॥ ३/११/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_011/BhP_03.011.011.m4a", "display_order": 12}, {"id": 6000041012, "chapter_id": 10041, "verse_number": "३-११-९", "content_sanskrit": "एतावान् जीवलोकस्य संस्थाभेदः समासतः।\nधर्मस्य ह्यनिमित्तस्य विपाकः परमेष्ठिनः॥ ३/११/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_011/BhP_03.011.012.m4a", "display_order": 13}, {"id": 6000041013, "chapter_id": 10041, "verse_number": null, "content_sanskrit": "विदुर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_011/BhP_03.011.013.m4a", "display_order": 14}, {"id": 6000041014, "chapter_id": 10041, "verse_number": "३-११-१०", "content_sanskrit": "यदात्थ बहुरूपस्य हरेरद्भुतकर्मणः।\nकालाख्यं लक्षणं ब्रह्मन् यथा वर्णय नः प्रभो॥ ३/११/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_011/BhP_03.011.014.m4a", "display_order": 15, "topics": [{"text": "तत्र ब्रह्माण्डे विरिञ्चेन चराचरात्मकप्राकृतवैकृतात्मना दशविधनानाप्रपञ्चसर्जनम्, कल्पस्य कल्पपूर्वत्व- निरूपणं च", "range": "१०–३१"}]}, {"id": 6000041015, "chapter_id": 10041, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_011/BhP_03.011.015.m4a", "display_order": 16}, {"id": 6000041016, "chapter_id": 10041, "verse_number": "३-११-११", "content_sanskrit": "गुणव्यतिकराकारो निर्विशेषोऽप्रतिष्ठितः।\nपुरुषस्तदुपादानमात्मानं लीलयाऽसृजत्॥ ३/११/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_011/BhP_03.011.016.m4a", "display_order": 17}, {"id": 6000041017, "chapter_id": 10041, "verse_number": "३-११-१२", "content_sanskrit": "विश्वं वै ब्रह्मतन्मात्रं संस्थितं विष्णुमायया।\nईश्वरेण परिच्छिन्नं कालेनाव्यक्तमूर्तिना॥ ३/११/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_011/BhP_03.011.017.m4a", "display_order": 18}, {"id": 6000041018, "chapter_id": 10041, "verse_number": "३-११-१३", "content_sanskrit": "यथेदानीं तथा चाग्रे पश्चादप्येतदीदृशम्।\nसर्गो नवविधस्तस्य प्राकृतो वैकृतश्च यः॥ ३/११/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_011/BhP_03.011.018.m4a", "display_order": 19}, {"id": 6000041019, "chapter_id": 10041, "verse_number": "३-११-१४", "content_sanskrit": "कालद्रव्यगुणैरस्य त्रिविधः प्रतिसङ्क्रमः।\nआद्यस्तु महतः सर्गो गुणवैषम्यमात्मनः॥ ३/११/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_011/BhP_03.011.019.m4a", "display_order": 20}, {"id": 6000041020, "chapter_id": 10041, "verse_number": "३-११-१५", "content_sanskrit": "द्वितीयस्त्वहमस्तत्र द्रव्यज्ञानक्रियादयः।\nभूतसर्गस्तृतीयस्तु तन्मात्राद्रव्यशक्तिमान्॥ ३/११/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_011/BhP_03.011.020.m4a", "display_order": 21}, {"id": 6000041021, "chapter_id": 10041, "verse_number": "३-११-१६", "content_sanskrit": "चतुर्थ ऐन्द्रियः सर्गो यस्तु ज्ञानक्रियात्मकः।\nवैकारिको देवसर्गः पञ्चमो यन्मयं मनः॥ ३/११/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_011/BhP_03.011.021.m4a", "display_order": 22}, {"id": 6000041022, "chapter_id": 10041, "verse_number": "३-११-१७", "content_sanskrit": "षष्ठस्तु तमसः सर्गो यस्त्वबुद्धिकृतः प्रभोः।\nषडिमे प्राकृताः सर्गा वैकृतानपि मे शृृणु॥ ३/११/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_011/BhP_03.011.022.m4a", "display_order": 23}, {"id": 6000041023, "chapter_id": 10041, "verse_number": "३-११-१८", "content_sanskrit": "रजोभाजो भगवतो लीलेयं हरिमेधसः।\nसप्तमो मुख्यसर्गस्तु षड्विधस्तस्थुषां च यः॥ ३/११/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_011/BhP_03.011.023.m4a", "display_order": 24}, {"id": 6000041024, "chapter_id": 10041, "verse_number": "३-११-१९", "content_sanskrit": "वनस्पत्योषधिलतास्त्वक्सारा वीरुधो द्रुमाः।\nउत्स्रोतसस्तमःप्राया अन्तःस्पर्शा विशोषिणः॥ ३/११/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_011/BhP_03.011.024.m4a", "display_order": 25}, {"id": 6000041025, "chapter_id": 10041, "verse_number": "३-११-२०", "content_sanskrit": "तिरश्चामष्टमः सर्गः सोऽष्टाविंशद्विधो मतः।\nअविदो भूरितमसो घ्राणज्ञा हृद्यवेदिनः॥ ३/११/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_011/BhP_03.011.025.m4a", "display_order": 26}, {"id": 6000041026, "chapter_id": 10041, "verse_number": "३-११-२१", "content_sanskrit": "गौरजो महिषः कृष्णः सूकरो गवयो रुरुः।\nद्विशफाः पशवश्चेमे अविरुष्ट्रश्च सत्तम॥ ३/११/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_011/BhP_03.011.026.m4a", "display_order": 27}, {"id": 6000041027, "chapter_id": 10041, "verse_number": "३-११-२२", "content_sanskrit": "खरोऽश्वोऽश्वतरो गौरः शरभश्चमरी तथा।\nएते चैकशफाः क्षत्तः शृणु पञ्चनखान् पशून्॥ ३/११/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_011/BhP_03.011.027.m4a", "display_order": 28}, {"id": 6000041028, "chapter_id": 10041, "verse_number": "३-११-२३", "content_sanskrit": "श्वा सृगालो वृको व्याघ्रो मार्जारः शशशल्यकौ।\nसिंहः कपिर्गजः कूर्मो गोधा च मकरादयः॥ ३/११/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_011/BhP_03.011.028.m4a", "display_order": 29}, {"id": 6000041029, "chapter_id": 10041, "verse_number": "३-११-२४", "content_sanskrit": "कङ्कगृध्रबकश्येना भासवल्लूरबर्हिणः।\nहंससारसचक्राह्वकाकोलूकादयः खगाः॥ ३/११/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_011/BhP_03.011.029.m4a", "display_order": 30}, {"id": 6000041030, "chapter_id": 10041, "verse_number": "३-११-२५", "content_sanskrit": "अर्वाक्स्रोतस्तु नवमः क्षत्तरेकविधो नृणाम्।\nरजोऽधिकाः कर्मपरा दुःखे च सुखमानिनः॥ ३/११/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_011/BhP_03.011.030.m4a", "display_order": 31}, {"id": 6000041031, "chapter_id": 10041, "verse_number": "३-११-२६", "content_sanskrit": "वैकृतास्‍त्रय एवैते देवसर्गश्च सत्तम।\nवैकारिकस्तु यः प्रोक्तः कौमारस्तूभयात्मकः॥ ३/११/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_011/BhP_03.011.031.m4a", "display_order": 32}, {"id": 6000041032, "chapter_id": 10041, "verse_number": "३-११-२७", "content_sanskrit": "देवसर्गश्चाष्टविधो विबुधाः पितरोऽसुराः।\nगन्धर्वाप्सरसः सिद्धा यक्षरक्षांसि चारणाः॥ ३/११/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_011/BhP_03.011.032.m4a", "display_order": 33}, {"id": 6000041033, "chapter_id": 10041, "verse_number": "३-११-२८", "content_sanskrit": "भूतप्रेतपिशाचाश्च विद्याध्राः किन्नरादयः।\nदशैते विदुराख्याताः सर्गास्ते विश्वसृक्कृताः॥ ३/११/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_011/BhP_03.011.033.m4a", "display_order": 34}, {"id": 6000041034, "chapter_id": 10041, "verse_number": "३-११-२९", "content_sanskrit": "अतः परं प्रवक्ष्यामि वंशान् मन्वतराणि च।\nएवं रजःप्लुतः स्रष्टा कल्पादिष्वात्मभूर्हरिः। सृजत्यमोघसङ्कल्प आत्मैवात्मानमात्मना॥ ३/११/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_011/BhP_03.011.034.m4a", "display_order": 35}, {"id": 6000041035, "chapter_id": 10041, "verse_number": "३-११-३०", "content_sanskrit": "गुणव्यत्यय एतस्मिन् मायावत्त्वादधीशितुः।\nन पौर्वापर्यमिच्छन्ति नद्यां भ्राम्यद्भ्रमेरिव॥ ३/११/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_011/BhP_03.011.035.m4a", "display_order": 36}, {"id": 6000041036, "chapter_id": 10041, "verse_number": "३-११-३१", "content_sanskrit": "देवासुरादयः क्षत्तः कल्पेऽस्मिन् ये प्रकीर्तिताः।\nत एव नामरूपाभ्यामासन् मन्वन्तरान्तरे॥ ३/११/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_011/BhP_03.011.036.m4a", "display_order": 37}, {"id": 6000041037, "chapter_id": 10041, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां तृतीयस्कन्धे एकादशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]