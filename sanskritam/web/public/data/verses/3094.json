[{"id": 2097864, "chapter_id": 3094, "verse_number": "१३-२२४-१", "content_sanskrit": "उमोवाच।\nभगवन्देवदेवेश लोकपालनमस्कृत।\nप्रसादात्ते महादेव श्रुता मे कर्मणां गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2097865, "chapter_id": 3094, "verse_number": "१३-२२४-२", "content_sanskrit": "सङ्गृहीतं च तत्सर्वं तत्वतोऽमृतसंनिभम्।\nकर्मणा ग्रथितं सर्वमिति वेद शुभाशुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2097866, "chapter_id": 3094, "verse_number": "१३-२२४-३", "content_sanskrit": "गोवत्सवच्च जननीं निम्नं सलिलवत्तथा।\nकर्तारं स्वकृतं कर्म नित्यं तदनुधावति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2097867, "chapter_id": 3094, "verse_number": "१३-२२४-४", "content_sanskrit": "कृतस्य कर्मणश्चेह नाशो नास्तीति निश्चयः।\nअशुभस्य शुभस्यापि तदप्युपगतं मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2097868, "chapter_id": 3094, "verse_number": "१३-२२४-५", "content_sanskrit": "भूय एव महादेव वरद प्रीतिवर्धन।\nकर्मणां गतिमाश्रित्य संशयान्मोक्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2097869, "chapter_id": 3094, "verse_number": "१३-२२४-६x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2097870, "chapter_id": 3094, "verse_number": "१३-२२४-६", "content_sanskrit": "यत्ते विवक्षितं देवि गुह्यमप्यसितेक्षणे।\nतत्सर्वं निर्विशंका त्वं पृच्छ मां शुभलक्षणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2097871, "chapter_id": 3094, "verse_number": "१३-२२४-७x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2097872, "chapter_id": 3094, "verse_number": "१३-२२४-७", "content_sanskrit": "एवं व्यवस्थिते लोके कर्ममां वृषभध्वज।\nकृत्वा तत्पुरुषः कर्म शुभं वा यदि वेतरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2097873, "chapter_id": 3094, "verse_number": "१३-२२४-८", "content_sanskrit": "कर्मणः सुकृतस्येह कदा भुङ्क्ते फलं पुनः।\nइह वा प्रेत्य वा देव तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2097874, "chapter_id": 3094, "verse_number": "१३-२२४-९x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2097875, "chapter_id": 3094, "verse_number": "१३-२२४-९", "content_sanskrit": "स्थाने संशयितं देवि तद्धि गुह्यतमं नृषु।\nत्वत्प्रियार्थं प्रवक्ष्यामि देवि गुह्यं शुभानने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2097876, "chapter_id": 3094, "verse_number": "१३-२२४-१०", "content_sanskrit": "पूर्वदेहकृतं कर्म भुञ्जते तदिह प्रजाः।\nइहैव यत्कृतं पुंसां तत्परत्र फलिष्यतै।\nएषा व्यवस्थितिर्देवि मानुषेष्वेव दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2097877, "chapter_id": 3094, "verse_number": "१३-२२४-११", "content_sanskrit": "देवानामसुराणां च अमरत्वात्तपोबलात्।\nएकेनैव शरीरेण भुज्यते कर्मणां फलम्।\nमानुषैर्न तथा देवि अन्तरं त्वेतदिष्यते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2097878, "chapter_id": 3094, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि चतुर्विंसत्यधिकद्विशततमोऽध्यायः॥ २२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]