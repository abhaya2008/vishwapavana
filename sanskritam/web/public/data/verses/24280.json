[{"id": 7004280000, "chapter_id": 24280, "verse_number": "५-२-५८-१", "content_sanskrit": "ईश्वर उवाच ।\nप्रयागेश्वरसंज्ञं तु सर्वकामकरं परम् ।\nअष्टाधिकं विजानीहि पंचाशत्तममीश्वरम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004280001, "chapter_id": 24280, "verse_number": "५-२-५८-२", "content_sanskrit": "आसीत्प्रथमकल्पे तु मनुः स्वायंभुवः पुरा ।\nतस्य प्रियव्रतः पुत्रो यज्वा परमधार्मिकः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004280002, "chapter_id": 24280, "verse_number": "५-२-५८-३", "content_sanskrit": "स चेष्ट्वा बहुभिर्यज्ञैः समाप्तवरदक्षिणैः ।\nसप्तद्वीपेषु संप्राप्य भरतादीन्सुतान्प्रिये॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004280003, "chapter_id": 24280, "verse_number": "५-२-५८-४", "content_sanskrit": "स्वयं विशालां बदरीं गत्वा तेपे महत्तपः ।\nकालेन बहुना तत्र नारदः समुपस्थितः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004280004, "chapter_id": 24280, "verse_number": "५-२-५८-५", "content_sanskrit": "पूजितो विष्टरार्घेण राज्ञा प्रियव्रतेन च ।\nस पृष्टः पूजयित्वा तु किमाश्चर्यं वदस्व मे॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004280005, "chapter_id": 24280, "verse_number": "५-२-५८-६", "content_sanskrit": "इत्युक्तः कथयामास नारदो मुनिसत्तमः ।\nश्वेतद्वीपे मया राजन्कन्या दृष्टा सरोवरे॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004280006, "chapter_id": 24280, "verse_number": "५-२-५८-७", "content_sanskrit": "सा च पृष्टा विशालाक्षी कस्माद्वससि निर्जने ।\nकासि भद्रे कथं वासि किंवा कार्यमिह त्वया॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004280007, "chapter_id": 24280, "verse_number": "५-२-५८-८", "content_sanskrit": "कर्त्तव्यं चारुसर्वांगि तन्ममाचक्ष्व शोभने ।\nएवमुक्ता मया सा हि मां दृष्ट्वा मीलितेक्षणम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004280008, "chapter_id": 24280, "verse_number": "५-२-५८-९", "content_sanskrit": "स्मृत्वा तूष्णीं स्थिता यावत्तावन्मे ज्ञानमुत्तमम् ।\nविस्मृताः सर्ववेदाश्च सर्वशास्त्राणि चैव हि॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004280009, "chapter_id": 24280, "verse_number": "५-२-५८-१०", "content_sanskrit": "ततोऽहं विस्मयाविष्टश्चिंतामोहसमन्वितः ।\nतामेव शरणं गत्वा यावत्पश्यामि पार्थिव॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004280010, "chapter_id": 24280, "verse_number": "५-२-५८-११", "content_sanskrit": "तावद्दिव्यः पुमांस्तस्याः शरीरे समदृश्यत ।\nतस्यापि पुंसो ह्रदये द्वितीयस्तस्य चोरसि ।\nतस्यापि हृदये चान्यस्तृतीयस्तु व्यवस्थितः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004280011, "chapter_id": 24280, "verse_number": "५-२-५८-१२", "content_sanskrit": "ततः पृष्टा मया देवी सा कुमारी कथंचन ।\nवेदा नष्टा ममाशेषा भद्रे किं ब्रूहि कारणम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004280012, "chapter_id": 24280, "verse_number": "५-२-५८-१३", "content_sanskrit": "कन्योवाच ।\nमाताहं सर्ववेदानां सावित्रीनाम नामतः ।\nमां न जानासि येन त्वमतो वेदा हृतास्तव॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004280013, "chapter_id": 24280, "verse_number": "५-२-५८-१४", "content_sanskrit": "एवमुक्ते मया पृष्टा विस्मयेन महीपते ।\nवेदानां त्वं तु माता वै कथयस्व ममानघे॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004280014, "chapter_id": 24280, "verse_number": "५-२-५८-१५", "content_sanskrit": "त्वदीय हृदये देवि क एते पुरुषास्त्रयः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004280015, "chapter_id": 24280, "verse_number": "५-२-५८-१६", "content_sanskrit": "कन्योवाच ।\nय एष मच्छरीरस्थः शुभांगश्चारु शोभनः ।\nएष ऋग्वेदनामा तु यजुर्वेदो द्वितीयकः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004280016, "chapter_id": 24280, "verse_number": "५-२-५८-१७", "content_sanskrit": "सामवेदस्तृतीयस्तु त्रयो वेदा मयि स्थिताः ।\nत्रयोऽग्नयस्त्रयो देवा मच्छरीरे स्थिता द्विज॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004280017, "chapter_id": 24280, "verse_number": "५-२-५८-१८", "content_sanskrit": "इत्युक्त्वा सा तदा कन्या पश्यतो मम भूपते ।\nअंतर्द्धानं गता सद्यस्ततोऽहं विस्मितोऽभवम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004280018, "chapter_id": 24280, "verse_number": "५-२-५८-१९", "content_sanskrit": "किं करोमि क्व गच्छामि शरणं यामि कं प्रभुम् ।\nकथमाविर्भविष्यंति वेदाः शास्त्राणि सांप्रतम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004280019, "chapter_id": 24280, "verse_number": "५-२-५८-२०", "content_sanskrit": "कामिकस्तीर्थराजस्तु प्रयागः श्रूयते श्रुतौ ।\nअहं तत्र गमिष्यामि ज्ञानं सम्यग्भविष्यति॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004280020, "chapter_id": 24280, "verse_number": "५-२-५८-२१", "content_sanskrit": "नष्टवेदेन रैभ्येण प्राप्ता सिद्धिरनुत्तमा ।\nसावित्री श्रूयते तत्र अक्षय्यवटसन्निधौ॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004280021, "chapter_id": 24280, "verse_number": "५-२-५८-२२", "content_sanskrit": "एवं मनसि संध्याय गतोऽहं नृपसत्तम ।\nप्रयागं कामिकं तीर्थं सर्वदेवनमस्कृतम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004280022, "chapter_id": 24280, "verse_number": "५-२-५८-२३", "content_sanskrit": "तपस्तीव्रं मया तत्र तप्तं परमदुष्करम् ।\nअथाजगाम राजेंद्र प्रयागो मूर्त्तिमान्स्वयम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004280023, "chapter_id": 24280, "verse_number": "५-२-५८-२४", "content_sanskrit": "उक्तोऽहं प्रणयात्तेन न मां तापय नारद ।\nब्रह्मपुत्र प्रयागोऽहं भीषितस्तपसा तव॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004280024, "chapter_id": 24280, "verse_number": "५-२-५८-२५", "content_sanskrit": "भवतः पार्श्वमायातः प्रणयेन तपोधन ।\nधन्योऽसि सर्वथा ब्रह्मंस्तपसा च विशेषतः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004280025, "chapter_id": 24280, "verse_number": "५-२-५८-२६", "content_sanskrit": "मया सार्धं त्वया ब्रह्मन्गतिः कार्याऽविकल्पतः ।\nमहाकालवने रम्ये तत्र ते ज्ञानमुत्तमम् ।\nभविष्यति न संदेहो मम कीर्तिश्च सुस्थिरा॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004280026, "chapter_id": 24280, "verse_number": "५-२-५८-२७", "content_sanskrit": "एवं हि ब्रुवतस्तस्य प्रयागस्य नृपोत्तम ।\nप्रादुर्बभूव सहसा पीतवासा जनार्द्दनः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004280027, "chapter_id": 24280, "verse_number": "५-२-५८-२८", "content_sanskrit": "शङ्खचक्रगदापाणिर्गरुडस्थो वियद्गतः ।\nउवाच मेघगंभीरं वाक्यं स पुरुषोत्तमः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004280028, "chapter_id": 24280, "verse_number": "५-२-५८-२९", "content_sanskrit": "एहि नारद गच्छामः प्रयागो यत्र यास्यति ।\nकृष्णस्य वचनं श्रुत्वा मया प्रोक्तो जनार्दनः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004280029, "chapter_id": 24280, "verse_number": "५-२-५८-३०", "content_sanskrit": "ज्ञानं मे देहि देवेश कथं यास्यामि तद्वनम् ।\nमहाकालं जगन्नाथ श्रुतज्ञानविवर्जितः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004280030, "chapter_id": 24280, "verse_number": "५-२-५८-३१", "content_sanskrit": "इत्युक्तः श्रीधरेणाहं महाकालवनं नृप ।\nआनीतस्तत्क्षणाच्छीघ्रं प्रयागसहितस्तदा॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004280031, "chapter_id": 24280, "verse_number": "५-२-५८-३२", "content_sanskrit": "घंटेश्वरस्य पूर्वे तु नवनद्यास्तु दक्षिणे ।\nतत्र लिंगमनादि तु ज्योतीरूपं सनातनम्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004280032, "chapter_id": 24280, "verse_number": "५-२-५८-३३", "content_sanskrit": "प्रयागः पूजयामास पश्यतो मम भूपते ।\nलिंगेनोक्तं प्रसन्नेन किमर्थं त्वमिहागतः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004280033, "chapter_id": 24280, "verse_number": "५-२-५८-३४", "content_sanskrit": "प्रयाग प्रयतो भूत्वा प्रसन्नोऽहं सदा तव ।\nदर्शनं च मदीयं तु विफलं न भविष्यति॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004280034, "chapter_id": 24280, "verse_number": "५-२-५८-३५", "content_sanskrit": "इत्युक्तस्तेन लिंगेन मदर्थं प्रार्थितस्तदा ।\nज्ञानं देहि द्विजायास्मै नारदाय महात्मने॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004280035, "chapter_id": 24280, "verse_number": "५-२-५८-३६", "content_sanskrit": "नष्टा वेदाश्च शास्त्राणि सावित्र्या दर्शनात्प्रभो॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004280036, "chapter_id": 24280, "verse_number": "५-२-५८-३७", "content_sanskrit": "ततो लिंगात्समुत्तस्थौ ब्रह्मा वेदैर्वृतस्तदा ।\nषडंगैः सरहस्यैश्च पुराणैः सहितस्तदा॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004280037, "chapter_id": 24280, "verse_number": "५-२-५८-३८", "content_sanskrit": "इत्युक्तोऽहं तदा देव्या सावित्र्या नृपसत्तम ।\nलिंगस्यास्य प्रभावेण प्रयागाभ्यर्थितस्य वै॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004280038, "chapter_id": 24280, "verse_number": "५-२-५८-३९", "content_sanskrit": "प्रतिभास्यंति ते वेदा धर्मशास्त्राणि नारद ।\nइत्युक्ते वचने भूयः प्राप्ता वेदा मया नृप॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004280039, "chapter_id": 24280, "verse_number": "५-२-५८-४०", "content_sanskrit": "ज्ञानं षडंगसहितं शास्त्राणि विविधानि च ।\nलब्धज्ञानेन राजेंद्र मया प्रोक्तं वचस्तदा॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004280040, "chapter_id": 24280, "verse_number": "५-२-५८-४१", "content_sanskrit": "प्रयागेनार्चितो देवो मम ज्ञानस्य कारणात् ।\nप्रयागेश्वरसंज्ञस्तु ख्यातिं लोकेषु यास्यति॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004280041, "chapter_id": 24280, "verse_number": "५-२-५८-४२", "content_sanskrit": "तदाप्रभृति तल्लिंगं तीर्थकोटिशतैर्वृतम् ।\nस्वर्गापवर्गफलदं तत्र त्वं गंतुमर्हसि॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004280042, "chapter_id": 24280, "verse_number": "५-२-५८-४३", "content_sanskrit": "किमनेनाश्वमेधेन इष्टेन नृपसत्तम ।\nअश्वमेधशतफलं जायते तस्य दर्शनात्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004280043, "chapter_id": 24280, "verse_number": "५-२-५८-४४", "content_sanskrit": "तपसा किं सुतप्तेन कायक्लेशकरेण तु ।\nवाञ्छितं लभते सद्यः प्रयागेश्वरदर्शनात्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004280044, "chapter_id": 24280, "verse_number": "५-२-५८-४५", "content_sanskrit": "ईश्वर उवाच ।\nनारदस्य वचः श्रुत्वा स्वायंभुवसुतो नृपः ।\nप्रियव्रतो महादेवि महाकालवनं गतः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004280045, "chapter_id": 24280, "verse_number": "५-२-५८-४६", "content_sanskrit": "ददर्श तत्र तल्लिंगं नवनद्यास्तु दक्षिणे ।\nदर्शनात्तस्य लिंगस्य मत्समीपं समागतः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004280046, "chapter_id": 24280, "verse_number": "५-२-५८-४७", "content_sanskrit": "मया संमानितो देवि गणानामधिपः कृतः ।\nये पश्यंति नरा भक्त्या प्रयागेश्वरमीश्वरम् ।\nते धन्या मानुषे लोके क्लिश्यन्त्यन्ये निरर्थकाः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004280047, "chapter_id": 24280, "verse_number": "५-२-५८-४८", "content_sanskrit": "या गतिर्योगयुक्तस्य सत्त्वस्थस्य मनीषिणः ।\nसा गतिर्जायते सम्यक्प्रयागेश्वरदर्शनात्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004280048, "chapter_id": 24280, "verse_number": "५-२-५८-४९", "content_sanskrit": "माघमासे समेष्यंति प्रयागेश्वरदर्शनम् ।\nकर्त्तुं ये मानुषास्तेषामश्वमेधः पदेपदे॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004280049, "chapter_id": 24280, "verse_number": "५-२-५८-५०", "content_sanskrit": "एष ते कथितो देवि प्रभावः पापनाशनः ।\nप्रयागेश्वरदेवस्य शृणु सिद्धेश्वरं परम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]